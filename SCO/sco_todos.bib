@ARTICLE{Felbel2025780,
	author = {Felbel, Konstantin and Hentschel, Maximilian and Simon, Katharina and Dettmann, André and Chuang, Lewis L. and Bullinger, Angelika C.},
	title = {Predicting lane changes in real-world driving: analysing explicit, implicit and contextual cues on the motorway},
