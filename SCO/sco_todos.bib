	title = {Ecohydrology Approach to Strengthen Public Green Open Space Management towards Comfortable Common Space and Playground in Kalijodo Area – Jakarta Province, Indonesia},
	year = {2023},
	journal = {Ecohydrology and Hydrobiology},
	volume = {23},
