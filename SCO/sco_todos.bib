@ARTICLE{Gomez20201,
	author = {Gomez, José Edgardo Abaya},
	title = {Ex libris ad urbe: Urban portrayals in josé rizal's noli me tangere and el filibusterismo as indicators of past landscapes and affections},
	year = {2020},
	journal = {Humanities Diliman},
	volume = {17},
