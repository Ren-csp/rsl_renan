@ARTICLE{Ma2024,
	author = {Ma, Guoqiang and Zhang, Ziyang and Ma, Zhaocheng and Hu, Shiwen and Luo, Shan},
	title = {Insights from negative reviews in high-ratings, and the associations between park attributes: A case study in Park City, Chengdu},
	year = {2024},
