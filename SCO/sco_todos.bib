	author = {Tomitaka, Mahoro and Takano, Yu and Suzuki, Miho and Sasaki, Takehiro},
	title = {Shifting roles of urban greenspace types in supporting subjective well-being before and during the COVID-19 pandemic},
	year = {2025},
