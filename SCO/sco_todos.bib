	affiliations = {Department of Civil Engineering, Graduate School of Science, Necmettin Erbakan University, Konya, 42090, Turkey; Department of Civil Engineering, Faculty of Engineering, Necmettin Erbakan University, Konya, 42090, Turkey},
	abstract = {Flood risk in semi-urban environments is increasingly exacerbated by climate-driven extreme precipitation and the structural vulnerability of small-scale flood-control reservoirs. This study develops an integrated high-resolution framework for three-dimensional dam-break hazard assessment by combining UAV-based LiDAR terrain mapping with fully three-dimensional Computational Fluid Dynamics (CFD) modeling. The Necmettin Erbakan University Flood Protection Pond (Konya, Türkiye) was selected as a case study. A dense point cloud (~ 4 million points) acquired using a DJI Matrice 350 RTK UAV equipped with a Zenmuse L1 sensor was used to generate a highly accurate digital elevation model, which was directly integrated into FLOW-3D. Hydrological forcing was derived using the Mockus (SCS) rainfall–runoff method, yielding a Q100 peak discharge of 4.047 m<sup>3</sup>/s for the 9.365 km<sup>2</sup> basin. Two scenarios were simulated: (i) instantaneous dam failure and (ii) rainfall-induced overtopping followed by structural collapse. The compound scenario produced substantially more severe hydraulic conditions, with peak velocities increasing from 12 to 18 m/s (+ 50%), maximum depths increasing from 6.7 to 11 m (+ 64%), and severe-hazard duration extending from approximately 6 min to over 30 min. These findings demonstrate that flood hazard is governed by the dynamic and time-dependent interaction among flow depth, velocity, and duration, rather than by single-parameter metrics. This study represents one of the first attempts to integrate UAV-derived LiDAR topography with fully three-dimensional RANS–VOF CFD modeling for compound dam-break scenarios in semi-urban environments. The proposed framework enhances the physical realism of flood hazard assessment and supports risk-informed, climate-resilient flood management strategies. © The Author(s) under exclusive licence to Institute of Geophysics, Polish Academy of Sciences 2026.},
	author_keywords = {Compound flood scenario; Dam-break modelling; Flood risk assessment; Three-dimensional CFD; UAV-LiDAR terrain mapping},
