@ARTICLE{Schwartz2026305,
	author = {Schwartz, Martin H.},
	title = {Trans misery and Jewish danger: Fassbinder’s in einem Jahr mit 13 Monden (in a year of 13 Moons)},
	year = {2026},
	journal = {Studies in European Cinema},
	volume = {23},
	number = {3},
	pages = {305 - 320},
	doi = {10.1080/17411548.2025.2570534},
	url = {https://www.scopus.com/pages/publications/105018848560?origin=resultslist},
	affiliations = {Department of German Studies, Department of Cinema & Media Studies, University of Washington, Seattle, WA, United States},
	abstract = {The diegesis of Rainer Werner Fassbinder’s In einem Jahr mit 13 Monden (In a Year of 13 Moons, 1978) attends closely to the misery of Erwin/Elvira, an orphan who underwent unsatisfactory sexual reassignment surgery in the hope of winning the affection of the unscrupulous, Jewish real estate speculator Anton Saitz. This article maintains that in this film, Fassbinder attacks West German philosemitism–a quasi-official postwar stance of irrational positivity towards Jews and a proscription on public expressions of antisemitism–by means of erotics. Thirteen Moons dramatizes Fassbinder’s thesis, expressed in his films and public remarks, that philosemitic taboos invest the figure of the Jew with a psychosexual power that is damaging and even fatal to the postwar German subject. For Thirteen Moons, the content of the taboo is male Jewishness, and its mechanism is the pathologizing work of ‘injurious’ outside influence, as theorized by Richard von Krafft-Ebing. The film enacts the taboo’s effect, dissolution of the subject, aesthetically, through repeated motifs of failed reflection, corresponding to Erwin/Elvira fatal failure of self-perception, self-knowledge, and ultimately self-determination. © 2025 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {antisemitism; In einem Jahr mit 13 Monden; New German Cinema; philosemitism; Rainer Werner Fassbinder; trans representation},
	correspondence_address = {M.H. Schwartz; Department of German Studies, Department of Cinema & Media Studies, University of Washington, Seattle, 98195-3130, United States; email: mhschwar@uw.edu},
	publisher = {Routledge},
	issn = {17411548},
	language = {English},
	abbrev_source_title = {Stud. Eur. Cinema},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Das2025,
	author = {Das, Shinjita and Sun, Qian Chayn and Both, Alan and Foster, Sarah},
	title = {Greenery from apartments: quantifying and comparing views with residents' perceptions},
	year = {2025},
	journal = {Computational Urban Science},
	volume = {5},
	number = {1},
	pages = {},
	doi = {10.1007/s43762-025-00220-x},
	url = {https://www.scopus.com/pages/publications/105020831553?origin=resultslist},
	affiliations = {Centre for Urban Research, School of Global Urban and Social Studies, RMIT University, Melbourne, Australia; School of Geospatial Science, School of Science, RMIT University, Melbourne, Australia},
	abstract = {With urban densification and the proliferation of high-rise structures, residents’ apartment views are getting obstructed from surrounding nature, especially greenery. Existing approaches often rely on simplified proxies or aggregated building- or floor-level metrics which does not capture individual-level variation. Most of them use coarse spatial data or subjective self-reports, lacking the granularity and precision to quantify the greenery visible to each resident from their own living space. This study introduces a conceptual and methodological framework for objectively modelling green views at the individual apartment level. Our Apartment Greenery View Measure was developed and assessed by (1) geocoding individual observer positions at window-level within apartment buildings, (2) implementing GIS-based three-dimensional viewshed analysis using high-resolution environmental datasets to objectively quantify views, and (3) examining agreement between modelled views and 445 residents’ self-reported perceptions using the green-to-grey ratio. The method was applied to 30 apartment buildings across Melbourne, Australia. Findings reveal variability in green view exposure by building height, floor-level, and apartment orientation. A moderate correlation (r = 0.556, ICC = 0.521) shows the agreement between objective and perceived view measures, with 39.1% participants overestimating and 60.9% underestimating their views. This underscores the need for objective, standardised measures that move beyond perception alone. The workflow supports aggregation at multiple spatial scales, from individual units to floors and buildings, providing a flexible framework for assessing visual green equity citywide. This provides a scalable, low-cost tool for planners, designers, and health researchers seeking to integrate visual greenery into urban housing, policy, and equity-focused interventions. © The Author(s) 2025.},
	author_keywords = {Apartment window views; Green view index; Semantic building model; Subjective environmental perception; Urban environment; Visibility analysis},
	keywords = {Apartment houses; Costs; Geometry; Semantics; Tall buildings; Urban planning; Apartment buildings; Apartment window view; Building model; Environmental perceptions; Floor level; Green view index; Semantic building model; Subjective environmental perception; Urban environments; Visibility analysis; Floors},
	correspondence_address = {S. Das; Centre for Urban Research, School of Global Urban and Social Studies, RMIT University, Melbourne, Australia; email: shinjita.das@rmit.edu.au},
