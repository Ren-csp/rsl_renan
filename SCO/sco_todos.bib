	affiliations = {Shanghai University, School of Mechatronics Engineering and Automation, Shanghai, 200444, China; Shanghai University, Shanghai Key Laboratory of Intelligent Manufacturing and Robotics, Shanghai, 200444, China; Shanghai University, Bionic Intelligent Robot Dreamworks for Special Purpose, Shanghai, 200444, China; China Construction Eighth Engineering Division Bureau Company, Ltd., Shanghai, 200122, China; Southeast University, School of Computer Science and Engineering, Nanjing, 211189, China; Beihang University, Jiangxi Research Institute, Nanchang, 330096, China},
	abstract = {In complex urban environments, traversable spaces beneath bridges and roadside trees are often obscured in UAV aerial imagery. To address this challenge, we propose a novel end-to-end occlusion-informed 3-D terrain mapping (OI-3DTM) framework that enables accurate voxel-level modeling of hidden structures, providing a refined spatial foundation for traversability analysis. Existing methods largely rely on 2-D semantic completion or expensive multiview and LiDAR-based mapping, which either lack sufficient 3-D expressiveness or fail to meet real time and resource constraints. OI-3DTM integrates self-supervised monocular depth estimation with semantic segmentation and 3-D reconstruction to explicitly infer traversable voxel structures in occluded scenes. A unified encoder-decoder network fuses RGB imagery with prior depth features, enhanced by a semantic-partitioned hybrid loss and confidence-ranked depth consistency, thereby improving depth accuracy in textureless or geometrically discontinuous regions. Furthermore, we introduce a geometry prior-informed voxel reasoning module that employs parameterized cavity curves to model the underlying spatial geometry of occluded regions, enabling the reconstruction of invisible structures. We evaluate OI-3DTM on three benchmark datasets for depth estimation and conduct 3-D inference experiments on the UAV-LADIS dataset. Experimental results demonstrate that the proposed method consistently outperforms existing approaches in both depth estimation and 3-D spatial reasoning, achieving a 61% improvement in IoU and reducing the cross-entropy error to 0.116 in occlusion scenarios. These results indicate that OI-3DTM significantly enhances occlusion-aware spatial perception and exhibits strong potential for practical deployment in UAV-based urban navigation applications.  © 2026 IEEE.},
	author_keywords = {3-D voxel map; monocular depth estimation; occlusion-aware 3-D reasoning; UAV imagery},
	keywords = {3D modeling; 3D reconstruction; Aerial photography; Air navigation; Antennas; Depth perception; Geometry; Image segmentation; Mapping; Semantics; Textures; Three dimensional computer graphics; Unmanned aerial vehicles (UAV); Urban planning; 3-d terrains; 3d voxel map; Depth Estimation; Map generation; Monocular depth estimation; Occlusion reasoning; Occlusion-aware 3d reasoning; Terrain mapping; Traversability; UAV imagery; aerial survey; image processing; mapping; modeling; remote sensing; urban area; Image enhancement},
	correspondence_address = {H. Shi; Shanghai University, School of Mechatronics Engineering and Automation, Shanghai, 200444, China; email: hangshi@shu.edu.cn},
