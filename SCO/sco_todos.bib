@ARTICLE{Ranaweera2026,
	author = {Ranaweera, Nishani},
	title = {Fear in constrained spaces: A recursive mathematical model linking urban crime perception and spatial inequality},
	year = {2026},
	journal = {Social Sciences and Humanities Open},
	volume = {13},
	pages = {},
	doi = {10.1016/j.ssaho.2026.102864},
	url = {https://www.scopus.com/pages/publications/105037654452?origin=resultslist},
	affiliations = {School of Global Studies, Thammasat University, Bangkok, Thailand; Department of Criminology and Criminal Justice, Faculty of Humanities and Social Sciences, University of Sri Jayewardenepura, Sri Lanka},
	abstract = {Fear of crime is often more pervasive than crime itself, particularly in rapidly urbanizing cities where identity, space, and media narratives intersect. This article introduces a recursive mathematical model to examine how fear emerges, escalates, and persists in urban environments through a confluence of structural and symbolic factors. Focusing on Colombo, Sri Lanka, the study simulates 100 synthetic individuals stratified by gender, spatial autonomy, media exposure, and vulnerability. The model integrates five dynamic components; victimization, gendered risk, media amplification, spatial autonomy, and recursive feedback, operationalized over 52 simulated weeks. Results reveal that fear trajectories vary significantly by group, with marginalized female agents exhibiting exponential fear growth and autonomy collapse. Media shocks function as accelerators, particularly for individuals with high media consumption and low mobility. Once fear exceeds a critical threshold (fᵢ(t)>0.6), a phase transition is triggered, locking agents into high-fear, low-autonomy states that resist recovery, even when external threats subside. The findings underscore the recursive nature of urban insecurity: fear leads to spatial withdrawal, which fuels further fear. This model advances fear-of-crime literature by framing fear as a structurally mediated, recursively reinforced condition shaped by identity and environment, offering insights relevant to public mental health interventions. This study contributes to fear-of-crime research by integrating recursive dynamics, gendered vulnerability, and spatial autonomy within a unified computational framework, offering a structural modeling approach beyond traditional predictor-based analyses. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Fear of crime; Mathematical modelling; Media amplification; Quality of life; Spatial inequality},
	correspondence_address = {N. Ranaweera; School of Global Studies, Thammasat University, Bangkok, Thailand; email: kranaweera.r@sgs.tu.ac.th},
