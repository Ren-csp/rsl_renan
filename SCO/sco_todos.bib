@ARTICLE{Hao2026,
	author = {Hao, Jufang and Wang, Pu and Xu, Ning},
	title = {Unraveling the mechanism linking urban park landscapes to public sentiment: The mediating role of perceived sensory dimensions revealed by large language models},
	year = {2026},
	journal = {Habitat International},
	volume = {178},
	pages = {},
	doi = {10.1016/j.habitatint.2026.103994},
	url = {https://www.scopus.com/pages/publications/105049566649?origin=resultslist},
	affiliations = {School of Architecture, Southeast University, Jiangsu Province, Nanjing, 210096, China},
	abstract = {As indispensable public health assets in high-density cities, urban parks have been widely demonstrated to promote positive sentiments. However, it remains unclear whether park physical landscapes are directly associated with sentiments, or whether these associations are statistically mediated by individuals’ subjective perceptions that translate environmental stimuli into psychological experiences. To address this gap, this study developed an analytical framework based on large language models, employing aspect-based sentiment analysis to extract multidimensional environmental perceptions from unstructured textual data automatically. Structural equation models were constructed, with park landscape characteristics as exogenous variables, perceived sensory dimensions as mediating variables, and overall sentiment as the outcome variable, to examine the associative pathways linking urban park environments with public sentiments through perceived sensory dimensions. Housing prices were further introduced as a moderating variable to reveal how socioeconomic context shapes this mechanism. The results indicated that perceptions of nature, serene, and social were the most prominent in urban parks. Higher water aggregation and grassland proportion were positively associated with overall sentiment through higher levels of the serene dimension (β = 0.10; β = 0.11), whereas higher vegetation coverage was negatively associated with overall sentiment through lower perceived prospect (β = −0.07). Moreover, socioeconomic context exerted a significant moderating effect. In high housing price areas, serene showed the strongest positive association with overall sentiment (β = 0.48), while overall sentiment showed a declining trend when perceived social exceeded 50%. In contrast, in low housing price areas, social was positively associated with public sentiment (β = 0.08). Overall, this study reveals the key mediating mechanism linking physical landscape characteristics to sentiments in urban parks. It highlights that urban park design and renewal should not follow a uniform paradigm, but rather be optimized in a differentiated manner according to the emotional needs shaped by diverse socioeconomic contexts. The findings provide empirical evidence and practical guidance for enhancing the social well-being benefits of urban parks and optimizing the allocation of public green space resources. © 2026 Elsevier Ltd.},
	author_keywords = {Aspect-based sentiment analysis; Large language models; Mediation effect; Perceived sensory dimensions; Socioeconomic moderation; Urban park},
	keywords = {language; perception; socioeconomic status; urban area; urban development; urban planning},
