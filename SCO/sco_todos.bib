	author = {Zhang, Jiaxin and Yu, Zhilin and Li, Yunqin and Wang, Xueqiang},
	title = {Uncovering Bias in Objective Mapping and Subjective Perception of Urban Building Functionality: A Machine Learning Approach to Urban Spatial Perception},
	year = {2023},
