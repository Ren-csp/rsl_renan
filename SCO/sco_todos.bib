	url = {https://www.scopus.com/pages/publications/105030286363?origin=resultslist},
	affiliations = {School of Architecture, Tianjin University, Tianjin, 300072, China},
	abstract = {Between the 1840s and 1940s, 27 concessions were established by foreign countries in 16 Chinese cities, including Tianjin. Today, these areas face common challenges related to heritage conservation and tourism development, becoming important sites in modern urban life. Focusing on the historic concession areas of Tianjin, this study examines how street-level visual features influence emotional perceptions of urban environments. By utilizing Baidu Street View Image (SVI) and the MIT Place Pulse 2.0 dataset, the study employed deep convolutional neural networks and support vector machines to extract color characteristics and predict perception scores. The analysis included spatial visualization, Pearson correlation, and regression modeling. The findings reveal that visual elements, such as color harmony, complexity, and greenery, significantly affect perceptions of safety, vitality, and beauty. In addition, distinct concession zones exhibited varying perceptual patterns, with factors such as building density and sky visibility shaping feelings of openness or oppression. This study provides valuable insights for heritage-oriented urban planning and offers evidence-based guidance for enhancing both residents' and visitors' emotional experiences in the historic concession areas of Tianjin. © 2026 Elsevier Ltd.},
