@ARTICLE{Fagarazzi2026,
	author = {Fagarazzi, Claudio and Andaloro, Matteo and Cappelli, Giacomo and Marini, Nicola and Olimpi, Federico and Bernetti, Iacopo},
	title = {Perceived Disorder, Fear of Crime, and Safety in Urban Parks: A Structural Equation Modeling Study from a Large Metropolitan Green Area in Florence, Italy},
	year = {2026},
	journal = {Urban Science},
	volume = {10},
	number = {3},
	pages = {},
