	year = {2026},
	journal = {Urban Forestry and Urban Greening},
	volume = {122},
	pages = {},
	doi = {10.1016/j.ufug.2026.129527},
	url = {https://www.scopus.com/pages/publications/105040098395?origin=resultslist},
	affiliations = {Department of Landscape Architecture, School of Architecture, State Key Laboratory of Subtropical Building and Urban Science, South China University of Technology, Guangzhou, 510641, China; Guangzhou Municipal Key Laboratory of Landscape Architecture, South China University of Technology, Guangzhou, 510641, China; College of Forestry and Landscape Architecture, South China Agricultural University, Guangzhou, 510641, China},
	abstract = {Limited evidence has suggested that urban green spaces provide extensive social health benefits. Among these, urban parks play a particularly important role in alleviating loneliness, enhancing social cohesion, and fostering social harmony. This study investigates the mechanisms through which the multidimensional perceptions of urban parks influence users’ social health benefits, clarifies the relative importance of different park environmental features, and examines the mediating effects of recreational activities. Based on theoretical research, we developed a mediation model of “multidimensional perceptions of urban parks –recreation activity types – social health benefits of users.” Correlation analysis was used to identify significant factors, and Partial Least Squares Structural Equation Modeling (PLS-SEM) was applied to test the hypothesized relationships. The results revealed three main findings: (1) while the perceived social health benefits of urban parks—including promoted social contact, provided social support, and enhanced social relationships, notably in trust, friendliness, and encounters—were widely acknowledged, actual participation in organized, voluntary, or in-depth social engagements remained limited; (2) multidimensional perceptions of urban parks directly and indirectly affect social health benefits, with significant influences observed from accessibility, safety, aesthetics, attractiveness, usability, and maintenance; and (3) participation in eight recreational activity types — sightseeing, children’s play, photography, water-based activities, interaction with animals, singing performance, chess and crad games, exhibition, painting and calligraphy, running and walking, dancing, qigong and martial arts, small-ball game, equipment fitness — significantly directly affected social health benefits. Moreover, multidimensional perceptions of urban parks indirectly influenced social health benefits through these activities, some functioning as complementary mediators and others as competitive mediators. The study makes three main contributions: (1) developing a scale to evaluate social health benefits in urban parks; (2) clarifying the environmental and behavioral factors influencing social health benefits; and (3) systematically examining how park recreational activities affect social health benefits and proposing a comprehensive assessment method. By focusing on social health, this study addresses a critical gap in health benefit evaluation, reveals the pathways linking multidimensional perceptions of urban parks and users’ social health benefits, and provides both theoretical foundations and empirical evidence to guide planning, management, and policy-making of urban green spaces. Copyright © 2026. Published by Elsevier GmbH.},
	author_keywords = {Health benefits; Multidimensional perception; Recreational activities; Social health; Urban park},
	keywords = {greenspace; health impact; perception; public attitude; public health; recreational activity; urban planning},
