@ARTICLE{Hu2025,
	author = {Hu, Pengliang and Huang, Jingnan and Fang, Libo and Luo, Chao and Zhang, Ershen and Wang, Guoen},
	title = {How Do Street Landscapes Influence Cycling Preferences? Revealing Nonlinear and Interaction Effects Using Interpretable Machine Learning: A Case Study of Xiamen Island},
	year = {2025},
	journal = {Land},
	volume = {14},
	number = {11},
	pages = {},
	doi = {10.3390/land14112253},
	url = {https://www.scopus.com/pages/publications/105022922899?origin=resultslist},
	affiliations = {School of Urban Design, Wuhan University, Wuhan, 430072, China; Hunan Architectural Design Institute Group Co., Ltd., Changsha, 410000, China; Hunan Provincial Architectural and Municipal Digital Twin Engineering Technology Research Center, Changsha, 410000, China; School of Visual Arts Design, Hubei Institute of Fine Arts, Wuhan, 430060, China},
	abstract = {Building cycling-friendly street environments is crucial for promoting sustainable urban mobility. However, existing studies exploring the influence of the built environment on cycling have paid limited attention to the three-dimensional characteristics of street landscapes and have mostly relied on linear assumptions. To address these gaps, this study employs street view imagery and interpretable machine learning methods to investigate the nonlinear and interaction effects of street landscape elements on residents’ cycling preferences in Xiamen Island, China. The results reveal that the visual indices of buildings, sky, vegetation, and roads are the most influential variables affecting cycling preferences. These factors exhibit pronounced nonlinear relationships with cycling preference. For instance, buildings exhibit a threshold effect, with positive influences on cycling preference when the building index is below 0.12 and negative effects when it exceeds 0.12. A low sky index significantly suppresses cycling preference, whereas higher values offer only limited additional benefits, with an optimal range of 0.1–0.25. Vegetation contributes positively only at relatively high levels, suggesting that its index should ideally exceed 0.3. The road index shows a V-shaped relationship: values between 0.15 and 0.25 reduce cycling preference, whereas values below 0.15 or above 0.25 enhance it. Moreover, clear interaction effects among these variables are observed, suggesting that the combined visual composition of the streetscape plays an important role in shaping cycling preferences. These findings deepen the understanding of how street landscape characteristics influence cycling behavior and provide nuanced, practical insights for designing cycling-friendly streets and promoting sustainable travel in urban environments. © 2025 by the authors.},
	author_keywords = {cycling preference; interaction effects; nonlinearity; streetscape; subjective perception},
	keywords = {China; Fujian; Xiamen; Xiamen Island; cycle transport; machine learning; mobility; nonlinearity; travel behavior; urban transport},
	correspondence_address = {G. Wang; School of Urban Design, Wuhan University, Wuhan, 430072, China; email: 00009894@whu.edu.cn},
