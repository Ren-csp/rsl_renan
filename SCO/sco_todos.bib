@ARTICLE{Taiwo2013103,
	author = {Taiwo, Olalekan John},
	title = {Farmers' choice of wetland agriculture: Checking wetland loss and degradation in Lagos State, Nigeria},
	year = {2013},
	journal = {GeoJournal},
