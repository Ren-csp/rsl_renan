@ARTICLE{Cândido2010222,
	author = {Cândido, C. and de Dear, R.J. and Lamberts, R. and Bittencourt, L.},
	title = {Air movement acceptability limits and thermal comfort in Brazil's hot humid climate zone},
	year = {2010},
	journal = {Building and Environment},
	volume = {45},
