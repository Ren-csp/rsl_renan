	url = {https://www.scopus.com/pages/publications/105019640407?origin=resultslist},
	affiliations = {College of Architecture and Urban Planning, Tongji University, China; Architectural Design and Engineering, Department of the Built Environment, Eindhoven University of Technology, Netherlands},
	abstract = {Biophilic design has gained increasing attention for its potential to foster contact with ‘nature’ and create more sustainable built environments. However, how to conceptualise and implement ‘sustainability’ in architecture remains contested, raising unresolved questions about which sustainability challenges biophilic design can respond to. Additionally, biophilic design encompasses various approaches for integrating ‘nature’ in architecture, yet research on three-dimensional green spaces (e.g. indoor gardens and green balconies) remains limited, particularly concerning their effectiveness and evidence-based designs for sustainability. This study aims to explore three-dimensional green spaces (termed ‘green pockets’ here) to understand their impacts on sustainability, exemplify biophilic design practices, and formulate design guidelines to advance design with ‘nature’. We identify the benefits of green pockets in addressing ten sustainability challenges across three scales (urban environment, building performance, and human perception) and propose an evaluation framework for analysing their performance. Afterwards, we investigate the state-of-the-practice of green pockets through case studies of 20 built examples. Moreover, we distil design guidelines tailored for green pockets from a typology study employing the ‘research by design’ method, combined with SWOT analysis. The findings reveal that green pockets hold potential value in tackling multifaceted sustainability challenges, necessitating thorough consideration of trade-offs and synergistic benefits in implementing biophilic design. Incorporating diverse green pocket types and rich natural elements helps maximise the effectiveness of biophilic design in urban architecture. Overall, this research offers insights into the complexity of ‘sustainability’ and the implications of biophilic design, supporting more effective nature-based designs for sustainable futures. © 2025 Elsevier Ltd},
	author_keywords = {Biophilic design; Design guidelines; Green spaces; Performance evaluation; Sustainability; Sustainable architecture},
	keywords = {Architectural design; Ecodesign; Green buildings; Natural environment; Sustainable building; Urban planning; Biophilic design; Built environment; Design guideline; Evaluation design; Evaluation framework; Green spaces; Integrating nature; Performances evaluation; Sustainable architecture; Three-dimensional greens; architectural design; greenspace; guideline; performance assessment; sustainability; urban design; Economic and social effects; Sustainable development},
