@ARTICLE{Qiu2025,
	author = {Qiu, Yang and Wu, Meiliu and Huang, Qunying and Kang, Yuhao},
	title = {Do You Know Your Neighborhood? Integrating Street View Images and Multi-task Learning for Fine-Grained Multi-Class Neighborhood Wealthiness Perception Prediction},
	year = {2025},
	journal = {Cities},
