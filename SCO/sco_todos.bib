	title = {Lower risk of atrial fibrillation associated with visible greenness within community life circle: Findings from a population-based study},
	year = {2025},
	journal = {Ecotoxicology and Environmental Safety},
	volume = {294},
	pages = {},
	doi = {10.1016/j.ecoenv.2025.118106},
	url = {https://www.scopus.com/pages/publications/105001102181?origin=resultslist},
	affiliations = {Department of Preventive Medicine, Shantou University Medical College, Shantou, 515041, China; Guangdong Cardiovascular Institute, Guangdong Provincial People's Hospital, Guangdong Academy of Medical Science, Guangzhou, 510080, China; Department of Pharmacy, Cancer Hospital of Shantou University Medical College, Shantou, 515041, China; The Second Affiliated Hospital, School of Medicine, The Chinese University of Hong Kong, Shenzhen & Longgang District People's Hospital of Shenzhen, Shenzhen, 518172, China},
	abstract = {Existing studies have found the health implications of greenness on cardiovascular health, but largely focus on greenspace rather than visible greenness. We aimed to investigate the relationship between visible greenness within the community life circle and atrial fibrillation (AF). Our study included 11,539 permanent residents from a large prospective cohort in a megacity of southern China from 2015 to 2017. We generated 15-minute walking isochrone for each study participant as the community life circle and combined it with green view index (GVI) to estimate corresponding exposure to residential greenness. GVI was calculated utilizing street view images and a fully convolutional neural network tailored for evaluating urban environments. We combined logistic regression model and a doubly-robust approach to explore the relationship between GVI and AF. Mediation analyses were used to assess the mediating role of air pollution, body mass index (BMI) and exercise time on the relationship between GVI and AF. We found that each IQR increase in GVI exposure was associated with a 22.6 % (95 % CI: 8.7 %, 34.1 %) reduction in the risk of AF. The mediation effect of PM<sub>1</sub> on the relationship between GVI and AF was also identified. Higher visible greenness exposure within community life circle was associated with reduced risk of AF among urban residents. Visible greenness within urban community areas should be emphasized as a solution to promote cardiovascular health. © 2025 The Authors},
	author_keywords = {Air pollution; Atrial fibrillation; Community life circle; Doubly robust estimation; Residential greenness; Street view},
	keywords = {Adult; Aged; Air Pollution; Atrial Fibrillation; China; Environmental Exposure; Female; Humans; Male; Middle Aged; Prospective Studies; Residence Characteristics; China; artificial neural network; atmospheric pollution; body mass; cardiovascular disease; greenspace; megacity; physical activity; regression analysis; urban pollution; adult; aged; air pollution; Article; atrial fibrillation; body mass; cohort analysis; community; female; human; male; middle aged; obesity; outcome assessment; perception; prevalence; prospective study; risk factor; risk reduction; visibility; walking; China; environmental exposure; epidemiology; residence characteristics},
