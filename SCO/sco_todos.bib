	affiliations = {Department of Architecture and Planning, National Institute of Technology, Kerala, Calicut, 673601, India},
	abstract = {Existing literature has established that incorporating non-spatial factors into accessibility measurements reduces the mismatch between the measured and observed accessibility of urban open spaces. Prevailing accessibility frameworks that consider these aspects assume the availability of urban open spaces and that these spaces are an integral part of citizens’ daily lives. However, the low priority assigned to open-space planning in developing countries has caused disparities in geographical distribution, insufficient quantity, and the absence of varied typologies. The resulting negative perceptions of the availability and accessibility of these spaces have led to their disuse and underutilisation, raising questions regarding their equity and inclusivity. This study attempts to address these challenges faced in urban open space planning in the Global South by incorporating behavioural constructs into an urban open space accessibility framework. Using the case of Kerala, India, a questionnaire was formulated to identify essential behavioural constructs that contribute specifically to perceptions related to the accessibility of urban open spaces. Eight constructs, namely capability, opportunity, perceived control, salience of behaviour, habit, knowledge, personal characteristics, and governing entities, were identified as significant. These constructs were used to expand on the previously formulated accessibility framework. The expanded framework can guide targeted interventions to address social inequalities and promote inclusive and effective use of urban open spaces, catering to the diverse needs of the population. Moreover, by addressing site-specific constraints and opportunities, the expanded framework ensures that urban open space planning is sensitive to context and sustainable. © The Author(s), under exclusive licence to Springer Nature B.V. 2025.},
	author_keywords = {Accessibility; Behavioural constructs; Behavioural theories; Open space planning; Perceptions},
