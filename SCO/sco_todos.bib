	note = {Cited by: 7; All Open Access; Gold Open Access}
}

@ARTICLE{Sacchi2025,
	author = {Sacchi, Simona and Faccenda, Giulio and Ruzzante, Daniela and Sparascio, Chiara and Spaccatini, Federica},
