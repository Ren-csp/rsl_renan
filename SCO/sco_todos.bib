@ARTICLE{Yuan2025,
	author = {Yuan, Xinyue},
	title = {Fluffy Reality: Focalization, Material Affection, and Nonhuman Ethics in the Velveteen Rabbit},
	year = {2025},
	journal = {Children's Literature in Education},
	pages = {},
	doi = {10.1007/s10583-025-09632-z},
	url = {https://www.scopus.com/pages/publications/105014437668?origin=resultslist},
	affiliations = {School of Foreign Languages, Shanghai Jiao Tong University, 800 Dongchuan RD, Minhang District, Shanghai, China},
	abstract = {A century after its publication, Margery Williams’s The Velveteen Rabbit remains a classic tale of childhood and continues to attract scholarly attention. Notably, the plush toy that is conventionally expected to be cute and compliant offers a challenging viewpoint that potentially disarms anthropocentrism. By delving into the toy’s inner perspective, the narrative generates an imaginative scale of perception that defamiliarizes and refreshes the reader’s engagement with everyday reality, embracing possibilities in a more-than-human world. More importantly, the narrative structure, which privileges nonhuman focalization, illuminates the story’s dual tensions: the entanglement of affection and materiality, and the paradox of agency in an immobile subject. The wear and tear the Velveteen Rabbit endures in the process of becoming real does not signify passive suffering. Rather, it affirms the toy’s role as an active agent in shaping the storyworld, revealing the entanglement of humans and nonhumans, affection and materiality. Additionally, the contrast between nonhuman focalization and external third-person omniscient narration highlights the contradiction between the toy’s emotional interiority and its physical immobility. As a common narrative device that allows readers to take pleasure in toy stories, the toy’s immobility not only metaphorically reflects children’s real-life constraints, but also indicates a broader nonhuman ethics. The text represents a generative view of reality, wherein the process of becoming Real is mediated through the toy’s soft, fuzzy material body. In this light, The Velveteen Rabbit reimagines love, vulnerability, agency, and relations across species and forms. © The Author(s), under exclusive licence to Springer Nature B.V. 2025.},
	author_keywords = {Children’s literature; Focalization; Materiality; Nonhuman ethics; The Velveteen Rabbit; Toy narratives},
	correspondence_address = {X. Yuan; School of Foreign Languages, Shanghai Jiao Tong University, Shanghai, 800 Dongchuan RD, Minhang District, China; email: xinyue418@sjtu.edu.cn},
	publisher = {Springer Science and Business Media B.V.},
