@ARTICLE{Duc2025359,
	author = {Duc, Tran Minh},
	title = {The Spread of Forest Protection Awareness: An Anthropological Study on the Influence of Writer Nguyen Ngoc on the Central Highlands Community, Vietnam},
	year = {2025},
	journal = {Journal of People, Plants, and Environment},
	volume = {28},
	number = {3},
	pages = {359 - 373},
	doi = {10.11628/ksppe.2025.28.3.359},
	url = {https://www.scopus.com/pages/publications/105011208053?origin=resultslist},
	affiliations = {Thu Dau Mot University, Faculty of Education Thủ Dầu Một, Viet Nam},
	abstract = {Background and objective: The Central Highlands (Tay Nguyen) is a region endowed with a rich and diverse forest ecosystem, playing a crucial role in maintaining ecological balance and preserving the cultural identity of ethnic minorities in Vietnam. However, this area is currently facing severe environmental degradation due to excessive deforestation, land-use conversion, and the impacts of climate change. In this context, literature is not only of artistic value but also serves as an effective means to raise awareness and promote environmental protection efforts. Among the writers who have significantly influenced forest conservation awareness, Nguyen Ngoc stands out with literary works that deeply reflect the human-nature relationship and serve as a declaration of forest and cultural protection in the Tay Nguyen. This study focuses on analyzing the role of Nguyen Ngoc’s literature in raising awareness and promoting actions to protect Tay Nguyen forests. It explores how literature can contribute to spreading environmental consciousness within communities and supporting sustainable nature conservation policies. Methods: This study employs qualitative methods, combining textual analysis and in-depth interviews. Representative works of Nguyen Ngoc such as Đất nước đứng lên (Nguyen, 1956), Rừng xà nu (Nguyen, 1965), Các bạn tôi ở trên ấy (Nguyen, 2021a), etc., are analyzed to clarify how the author uses natural imagery to convey environmental protection messages. In addition, interviews with literary scholars, environmental activists, and local residents were conducted to evaluate the impact of these works on forest conservation awareness and behavior. Based on the research findings, the study proposes a model for spreading forest conservation awareness through literature consisting of four stages: innovation, communication channels, time, and social systems. Results: The findings show that Nguyen Ngoc's works not only describe the majestic beauty of the Tay Nguyen mountains and forests but also deliver a powerful message of forest preservation. The image of the xa nu tree in Rừng xà nu (Nguyen, 1965) symbolizes both the indomitable spirit of the Tay Nguyen people and the resilient strength of the forest against human destruction. His literature has contributed to changing public perception of the forest's importance, evoking a love for nature and a sense of environmental responsibility. Furthermore, the study highlights the role of literature as an effective tool for environmental education. Nguyen Ngoc's works not only reinforce public awareness of the forest's value but also inspire environmental protection movements. Through diverse communication channels—from books and newspapers to conferences and social media—the forest conservation messages in his works have been widely disseminated, influencing various social groups. Conclusion: Based on the research findings, several recommendations are proposed to leverage literature in environmental education and forest protection policies. First, Nguyen Ngoc's works should be integrated into educational curricula to help students gain deeper insight into the importance of forests in human life. Second, communication about forest conservation through literature should be enhanced, emphasizing the long-term impact of literature on social awareness. Finally, forest protection policies should incorporate cultural elements, recognizing forests not only as natural resources but also as an inseparable part of the spiritual life and cultural identity of local communities. © 2025 by the Society for People, Plants, and Environment.},
	author_keywords = {environmental protection; ethnic minority culture; literary influence; Nguyen Ngoc; Tay Nguyen forests},
	correspondence_address = {T.M. Duc; Thu Dau Mot University, Faculty of Education Thủ Dầu Một, Viet Nam; email: ductm@tdmu.edu.vn},
	publisher = {The Society of People, Plants, and Environment},
	issn = {25087673},
	language = {English},
	abbrev_source_title = {J. People. Plant. Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Utami2025,
	author = {Utami, Ifta Irodatul and Baroto, Wishnu Agung},
	title = {The perception of air purifiers on indoor air quality: effective or human herd behavior?},
	year = {2025},
	journal = {City and Built Environment},
	volume = {3},
	number = {1},
	pages = {},
	doi = {10.1007/s44213-025-00047-6},
	url = {https://www.scopus.com/pages/publications/105046330447?origin=resultslist},
	affiliations = {Directorate of Human Settlements and Housing Development Engineering, Directorate General of Human Settlements, Ministry of Public Works and Housing of the Republic of Indonesia, Jl. Pattimura No.20, Selong, Kebayoran Baru, South Jakarta, Jakarta, 12110, Indonesia; Directorate General of Taxes, Ministry of Finance of the Republic of Indonesia, Jakarta, Indonesia; Graduate Student, School of Environment and Society, Institute of Science Tokyo, Tokyo, Japan},
	abstract = {Indoor air quality (IAQ) draws public concern, particularly in densely populated urban environments. In recent years, air purifiers have gained popularity as a solution to improve indoor air quality. However, the efficacy of air purifiers is contingent on several factors, including the type and effectiveness of the purifier, room size, ventilation, and even human behaviors. In some cases, individuals may perceive air purifiers as a remedy for all indoor air quality issues, leading to a herd behavior effect. This phenomenon can result in indiscriminate purchases of air purifiers without considering the environment’s specific needs, potentially leading to wasteful expenditure. This study examines the public perception and behavioral patterns in air purifier adoption, particularly during health crises and environmental emergencies using Google Trends data from 2018 to 2023 across Indonesia, Malaysia, Singapore, and Japan. The analysis of the trends and related search queries shows regional variations in consumer preferences and motivations. The study reveals that demand for air purifiers surged during the COVID-19 pandemic and air pollution crises, driven by both rational considerations and herd behavior. Japan demonstrated a more analytical approach, focusing on the technical mechanisms of air purifiers, while Indonesian users exhibited high sensitivity to media and social influences, leading to impulsive purchases. Malaysia and Singapore displayed moderate herd behavior, balancing social conformity with informed decision-making. Regional variations in search queries and motivations reflect the influence of cultural norms, socio-economic factors, and media narratives. These findings underscore the role of herd behavior in shaping consumer trends, emphasizing the need for targeted awareness campaigns to dispel misconceptions and encourage rational decision-making. While air purifiers can be practical tools for enhancing indoor air quality, understanding and addressing human herd behavior is essential to harnessing the benefits of air purifiers while minimizing unnecessary possessions. This research provides insights into the complex dynamics of indoor air quality and offers practical recommendations for individuals and policymakers alike. © The Author(s) 2025.},
	author_keywords = {Air purifier; Consumer behavior; Exploratory analysis; Herd behavior; Human perception; Indoor air quality (IAQ)},
	correspondence_address = {I.I. Utami; Directorate of Human Settlements and Housing Development Engineering, Directorate General of Human Settlements, Ministry of Public Works and Housing of the Republic of Indonesia, Jakarta, Jl. Pattimura No.20, Selong, Kebayoran Baru, South Jakarta, 12110, Indonesia; email: iftautami@pu.go.id},
	publisher = {Springer},
	issn = {24357936},
	language = {English},
	abbrev_source_title = {City built environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

