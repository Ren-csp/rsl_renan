}

@ARTICLE{Zhong2025,
	author = {Zhong, Bingzhi and Xie, Hui and Zhang, Zhengkai and Wen, Yan},
	title = {Non-linear effects of ecoacoustic indices on urban soundscape assessments based on gradient boosting decision trees in summer Chongqing, China},
	year = {2025},
	journal = {Building and Environment},
	volume = {278},
