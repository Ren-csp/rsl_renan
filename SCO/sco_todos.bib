@ARTICLE{Chowchong2025,
	author = {Chowchong, Akra},
	title = {Language Variation on Social Media: How Thai Content Creators Teach the Pronunciation of /r/ in German; [การแปรของภาษาในโซเชียลมีเดีย: คอนเทนต์ครีเอเตอร์ชาวไทยสอนออกเสียง /r/ ในภาษาเยอรมันอย่างไร]},
	year = {2025},
