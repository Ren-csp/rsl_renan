}

@ARTICLE{Wu2025577,
	author = {Wu, Chen-Fa and Chiu, Mei-Ying and Chen, Szu-Hung and Trac, Luu Van Thong and Puspitasari, Sylvatera Ayu},
	title = {Investigating public perception towards outdoor thermal comfort: a case study at museum},
	year = {2025},
	journal = {Landscape and Ecological Engineering},
	volume = {21},
	number = {3},
	pages = {577 - 591},
	doi = {10.1007/s11355-025-00660-x},
	url = {https://www.scopus.com/pages/publications/105007735239?origin=resultslist},
	affiliations = {Department of Horticulture, National Chung Hsing University, Taichung, 402, Taiwan; International Master Program in Agriculture, National Chung Hsing University, Taichung, 402, Taiwan; Sebelas Maret University, Surakarta, 57126, Indonesia},
	abstract = {Hot weather can restrict outdoor activities in open fields in subtropical areas, even though it can provide many benefits. Previous research on outdoor thermal comfort in subtropical areas has yet to shed full light on open spaces in museums. Our research aims to provide a comprehensive understanding of people’s perceptions of hot weather and adaptation solutions that can be implemented to maintain thermal comfort in museum outdoor spaces. Our comprehensive study explores the various determinants influencing people’s thermal comfort, especially in the context of the effects of hot weather. The thermal perception and people’s adaptation solutions were also identified. The results suggest that human perception of hot weather through perceived control can influence people’s psychological expectations. Psychological expectations are expectations related to human perceptions based on previous experiences that can influence their psychological condition. Psychological expectations may be a dominant factor in shaping peoples’ perspectives; our findings suggest that their influence is not only through behavioral adaptation but also natural and technological adaptation. Various behavioral, natural, and technological adaptation solutions provide deep insight into maintaining thermal comfort. We realize outdoor weather is difficult to control, so these adaptation solutions are important. In addition, it is necessary to consider the thermal discomfort period so that it is possible to use such adaptation solutions during the summer. Through strategies that reinforce this perspective, there is potential to improve thermal comfort for people, ensuring they remain comfortable when engaging in outdoor activities. © The Author(s) under exclusive licence to International Consortium of Landscape and Ecological Engineering 2025.},
	author_keywords = {Hot weather; Museum; Outdoor; Thermal adaptation; Thermal comfort},
	correspondence_address = {L.V.T. Trac; Department of Horticulture, National Chung Hsing University, Taichung, 402, Taiwan; email: thongtracluuvan@smail.nchu.edu.tw; S.A. Puspitasari; Department of Horticulture, National Chung Hsing University, Taichung, 402, Taiwan; email: sylvatera@staff.uns.ac.id},
	publisher = {Springer},
	issn = {18601871},
	language = {English},
	abbrev_source_title = {Landsc. Ecol. Eng.},
	type = {Article},
