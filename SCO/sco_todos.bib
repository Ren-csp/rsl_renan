}

@ARTICLE{Villegas202501,
	author = {Villegas, Juan Carlos Marin},
	title = {RESIDENTIAL ENVIRONMENT SATISFACTION AND PERCEPTION QUESTIONNAIRE: DESIGN AND VALIDATION IN COLOMBIA AND CHILE; [QUESTIONARIO DE SATISFAGAO E PERCEGCAO DO AMBIENTE RESIDENCIAL: DESENHO E  VALIDAGAO NA COLOMBIA E NO CHILE]},
	year = {2025},
