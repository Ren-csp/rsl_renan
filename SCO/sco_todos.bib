@ARTICLE{Meenar2025,
	author = {Meenar, Mahbubur and Pánek, Jiří and Kitson, Jennifer and York, Ashley},
	title = {Mapping the emotional landscapes of parks in post-industrial communities enduring environmental injustices: Potential implications for biophilic city planning},
	year = {2025},
	journal = {Cities},
	volume = {158},
	pages = {},
	doi = {10.1016/j.cities.2024.105692},
	url = {https://www.scopus.com/pages/publications/85214495280?origin=resultslist},
	affiliations = {Department of Geography, Planning, and Sustainability, School of Earth and Environment, College of Science and Mathematics, Rowan University, Glassboro, NJ, United States; Department of Development and Environmental Studies, Faculty of Science, Palacky University Olomouc, Czech Republic; Department of Art, Ric Edelman College of Communication & Creative Arts, Rowan University, Glassboro, NJ, United States},
	abstract = {The conceptual basis for urban greening often lies in the biophilic urbanism paradigm, which emphasizes the importance of people's innate emotional connections to nature for their well-being. This study aims to analyze and map emotional landscapes within urban parks in post-industrial communities facing environmental injustices, using Camden, New Jersey, USA, as the empirical context. Camden is dealing with past environmental injustices and insufficient greenspace, while also striving to avoid future green gentrification. Based on park user surveys and GIS data and a mixed-methods approach, the study explores users' emotional experiences, the factors influencing these emotions, the mapping of sentiment patterns, and perceptions of park attributes. Four key insights emerge: First, the legacy of environmental injustice affects emotional experiences in Camden parks, potentially limiting biophilic benefits. Second, emotional responses to parks are highly case-specific, challenging the idea that parks are uniformly positive or negative. Third, most larger parks near water bodies receive more investment and positive feedback. Finally, users' locations have a greater influence on emotional responses than race, ethnicity, or income. We highlight the importance of understanding emotional landscapes in urban parks and incorporating public sentiments into park planning and decision-making. © 2025 The Authors},
	author_keywords = {Biophilic urbanism; Emotional mapping; Environmental justice; Greenspaces; Mixed methods; Sentiments},
	keywords = {Camden [New Jersey]; New Jersey; United States; decision making; environmental justice; gentrification; GIS; greenspace; landscape; mapping; park management; urban planning},
	correspondence_address = {M. Meenar; Department of Geography, Planning, and Sustainability, School of Earth and Environment, College of Science and Mathematics, Rowan University, Glassboro, 201 Mullica Hill Rd, 08028, United States; email: meenar@rowan.edu},
	publisher = {Elsevier Ltd},
	issn = {02642751},
	language = {English},
