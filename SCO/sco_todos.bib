@ARTICLE{Sharmin2021417,
	author = {Sharmin, Samia and Haque, Md. Mazharul and Kamruzzaman, Md.},
	title = {Modelling children’s independent territorial range by discretionary and nondiscretionary trips},
	year = {2021},
	journal = {Journal of Transport and Land Use},
	volume = {14},
	number = {1},
	pages = {417 - 439},
