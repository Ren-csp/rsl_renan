	author = {Ti, Suli and Yu, Ting and Wu, Qitao and Zhang, Qing},
	title = {User-Demand-Oriented Design of Restorative Seating in Urban Parks: Using a GT–Kano–AHP–QFD–TOPSIS Hybrid Model},
	year = {2026},
	journal = {BioResources },
	volume = {21},
