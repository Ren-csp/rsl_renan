}

@ARTICLE{Gori2024,
	author = {Gori, Barbara},
	title = {Conversações 昀椀lológico-literárias: a correspondência entre Ernesto Monaci (1844-1918) e Teó昀椀lo Braga (1843-1924)},
	year = {2024},
