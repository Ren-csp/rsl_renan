	author = {Curtis, Jacqueline W. and Shiau, Ellen and Lowery, Bryce and Sloane, David and Hennigan, Karen and Curtis, Andrew},
	title = {The prospects and problems of integrating sketch maps with geographic information systems to understand environmental perception: A case study of mapping youth fear in Los Angeles gang neighborhoods},
	year = {2014},
