@ARTICLE{Shang20238,
	author = {Shang, Zhenyu and Cheng, Kexin and Jian, Yuqing and Wang, Zhifang},
	title = {Comparison and Applicability Study of Analysis Methods for Social Media Text Data: Taking Perception of Urban Parks in Beijing as an Example; [社交媒体文本数据分析方法对比与适用性研究:以北京市城市公园感知为例]},
	year = {2023},
