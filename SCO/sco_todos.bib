	url = {https://www.scopus.com/pages/publications/105044508154?origin=resultslist},
	affiliations = {LSE Cities, London School of Economics and Political Science, 8th Floor, Fawcett House, Clement's Inn, London, WC2A 2AZ, United Kingdom; LSE Data Science Institute, London School of Economics and Political Science, 202 Houghton St, London, WC2A 2AE, United Kingdom; Ordnance Survey, Explorer House, Adanac Drive, Southampton, SO16 0AS, United Kingdom; NHS England, 7 & 8 Wellington Place, Leeds, West Yorkshire, LS1 4AP, United Kingdom},
	abstract = {Understanding the value of urban green spaces for health and wellbeing has traditionally been guided by needs-based and services-based frameworks. However, these approaches have often struggled to capture the subjective experiences that shape how residents perceive and value green spaces, focusing primarily on objective, empirical and spatial dimensions. Drawing on surveys and interviews conducted across three differently sized parks in Haringey, London, this paper proposes a localised, human-centred approach to park valuation. Adapting the sense of place framework developed by Pretty et al. (2003), it examines how place attachment, sense of community and place dependence shape residents’ experience of park value. Key findings highlight the distinction between use, need and value; the gap between resident perception and on-the-ground observation; and the tension between community agency and council provision. The surrounding environment also emerges as a significant factor beyond the park boundary, either enhancing or constraining access and use across diverse social groups. As a pilot study, the paper contributes to academic and policy discussions on green space valuation by highlighting the importance of localised evidence from residents and workers. It identifies park characteristics and contextual interventions that may support placemaking, reduce spatial inequalities, and positively influence health and wellbeing. It also proposes an indicative ranking of park characteristics as a practical starting point for park investment and policy prioritisation in resource-constrained settings. © 2026 The Authors.},
	author_keywords = {Haringey; Health; Park value; Sense of place; Urban parks; Wellbeing},
	correspondence_address = {A. Gomes; LSE Cities, London School of Economics and Political Science, 8th Floor, Fawcett House, Clement's Inn, London, WC2A 2AZ, United Kingdom; email: a.peca-amaral-gomes@lse.ac.uk},
