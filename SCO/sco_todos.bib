@ARTICLE{Zhang2025,
	author = {Zhang, Tianlin and Wang, Lei and Zhang, Longhao and Tang, Fengliang and Zhang, Wenzheng and Liu, Kaixin and Hu, Yike},
	title = {The evolution of restorative perception in urban development: insights from temporal street view images and explanatory machine learning},
	year = {2025},
	journal = {International Journal of Urban Sciences},
	pages = {},
	doi = {10.1080/12265934.2025.2597889},
	url = {https://www.scopus.com/pages/publications/105024891877?origin=resultslist},
	affiliations = {School of Architecture, Tianjin University, Tianjin, China},
	abstract = {Rapid urbanization has exacerbated mental health issues among residents. As the primary setting of residents’ daily lives, the restorative perception of urban environments is crucial for improving mental health and is considered a nature-based solution. This study develops a framework for evaluating restorative perception by utilizing temporal street-view images, combined with volunteer rating data and a random forest algorithm, and conducts a case study in the core area of Shanghai. Subsequently, we apply interpretable machine learning algorithms to explore the complex impact and mechanisms of changes in the built environment on restorative perception. The findings indicate that, from 2013 to 2019, restorative perception in central Shanghai improved overall, but spatial disparities remain. Peripheral and newly developed areas showed significant improvement, while central and older urban areas either remained unchanged or declined. Regression analysis revealed that changes in point of interest (POI) diversity had the most notable contribution to restorative perception, slightly promoting it at lower levels but suppressing its effects at higher levels. Excessive street density may have negative effects, whereas moderate building density contributes to the enhancement of restorative perception. Interaction analysis of different features showed that the interaction between POI diversity and factors such as street centrality and building density strengthened the impact on restorative perception. Our results highlight the importance of a well-balanced urban environment and suggest the need for targeted strategies to address the heterogeneity of restorative perception in different areas, thereby enhancing social well-being in future urban planning. © 2025 The Institute of Urban Sciences.},
	author_keywords = {environmental psychology; high-dense urban area; nature-based solution; urban landscape; Urbanization},
	correspondence_address = {Y. Hu; Yike Hu, School of Architecture, Tianjin University, Tianjin, 300072, China; email: huyike11@tju.edu.cn},
