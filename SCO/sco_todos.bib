	author = {Harayashiki, Juliana Valentim and Menezes, Marluci and Pina, Silvia Mikami},
	title = {The (in)visibility of the river in the perception and representation of landscape in Santa Bárbara d’Oeste (Brazil); [A (in)visibilidade do rio na percepção e representação da paisagem em Santa Bárbara d’Oeste (Brasil)]},
	year = {2026},
