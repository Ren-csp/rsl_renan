@ARTICLE{Duisenbayeva2024137,
	author = {Duisenbayeva, Ainur and Kariyev, Adlet and Baimoldina, Laura and Issayeva, Zhazira},
	title = {Psychological Characteristics of the Body Image of Middle-Aged Women in Organization of Interpersonal Interaction; [Психологічні особливості образу власного тіла жінок середнього віку в організації міжособистісної взаємодії]},
