@ARTICLE{Kruzhkova2026101,
	author = {Kruzhkova, Olga V. and Vorobyeva, Irina V. and Matveeva, Alena I.},
	title = {Students’ subjective assessment of vandalism: security issues; [Субъективная оценка вандализма студентами: вопросы безопасности]},
