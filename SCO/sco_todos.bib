@ARTICLE{Aigbona2026,
	author = {Aigbona, Charles},
	title = {Shaping the balance: The influence of personal values, personality, and generational ideologies on Gen Z pharmacists’ work-life integration in Lagos},
	year = {2026},
	journal = {Journal of Workplace Behavioral Health},
	pages = {},
	doi = {10.1080/15555240.2026.2681083},
	url = {https://www.scopus.com/pages/publications/105040937571?origin=resultslist},
	affiliations = {Pan Atlantic University, Lagos, Nigeria},
	abstract = {This qualitative study explores how Generation Z community pharmacists in Lagos, Nigeria, navigate work-life integration (WLI). Acknowledging a research gap in this demographic and context, we conducted semi-structured interviews with 54 Gen Z community pharmacists. The study utilized thematic analysis, grounded in theories such as Conservation of Resources, Boundary, Generational, and Personality theories. Findings reveal that pharmacists face significant WLI challenges due to demanding work conditions, including long hours, understaffing, and sales pressure, compounded by Lagos’s unique urban environment and economic hardships. A key finding is that individual differences, specifically personal values, personality traits, and Gen Z’s distinct ideologies, profoundly influence their WLI perceptions and coping strategies. These ideologies include a strong emphasis on mental health, a desire for flexibility, and a willingness to seek international opportunities. Their future aspirations are centered on achieving autonomy and a better quality of life through entrepreneurship, career diversification, or migration. This research provides empirical insights into Gen Z’s WLI in a non-Western context, offering theoretical validation and practical recommendations for stakeholders. These recommendations aim to improve working conditions, offer fair pay, and provide flexible work options and robust well-being support to foster sustainable WLI and talent retention within the Nigerian pharmacy sector. © 2026 Taylor & Francis Group, LLC.},
	author_keywords = {generation Z; Nigeria; personality; pharmacists; Work-life integration},
