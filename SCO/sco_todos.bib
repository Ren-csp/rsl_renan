	keywords = {Costs; Environmental impact; Forestry; Land use; Urban growth; Conservation subdivisions; Design impact; Development practices; Experimental auctions; Hedonic price model; Low impacts; Low-impact development; Neighbourhood; Valuation; Willingness to pay; contingent valuation; decision making; design; environmental impact; hedonic analysis; housing market; land use; magnitude; metropolitan area; numerical model; open space; survey; willingness to pay; article; conservation subdivision design; consumer; environmental impact; housing; human; income; low impact development; perception; real estate; tax; urban area; Housing},
