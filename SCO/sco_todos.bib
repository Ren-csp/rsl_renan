@ARTICLE{O'Brien2023321,
	author = {O'Brien, Lisa M. and Ford-Connors, Evelyn and Gatling, Anne and Boyle, Elizabeth and Copelas, Kristina and Langenfeld, Margaret},
	title = {Who Is Doing Science? Using Science Texts to Open Spaces that Expand the Voices and Perspectives in Elementary Classrooms},
	year = {2023},
	journal = {Reading Teacher},
	volume = {77},
	number = {3},
	pages = {321 - 331},
	doi = {10.1002/trtr.2245},
	url = {https://www.scopus.com/pages/publications/85171556685?origin=resultslist},
	affiliations = {Education at Merrimack College, North Andover, MA, United States; Literacy Education, Boston University's Wheelock College of Education & Human Development, Boston, MA, United States; Education, Merrimack College, North Andover, MA, United States; Merrimack College, North Andover, MA, United States},
	abstract = {Science texts tend to privilege the voices, perspectives, and practices of White males (e.g., Ford, 2006), reinforcing widely-held perceptions of scientists as White men. This narrow portrayal of who “does science” discourages BIPOC or female students from building a science identity (Archer et al., 2015), with many such students also viewing science as difficult or undesirable (Brickhouse et al., 2000). We argue that intentional positioning of science text written by or about BIPOC or female figures in science and literacy instruction not only helps all students develop science and literacy skills and knowledge, but leads to more expansive views of who “does science” and fosters students’ science identities. Our purpose in this article is to help teachers identify and incorporate expansive informational texts and position these texts within sound science and literacy instruction. We draw from the Next Generation Science Standards to describe ways to develop students’ science identities and then provide teachers guidance for selecting and intentionally positioning expansive science texts in their instruction, with examples of text sets that teachers can use in their classrooms. © 2023 International Literacy Association.},
	author_keywords = {1-Early childhood; 2-Childhood},
