@ARTICLE{Malvandi2026,
	author = {Malvandi, Hassan and Parsan, Hossein and Gharaei, Ali and Fallahinejad, Samin},
	title = {Integrated Assessment of Heavy Metal Accumulation in Urban Trees and Soils and Associated Non-carcinogenic Health Risks in Sabzevar, Iran},
	year = {2026},
	journal = {Bulletin of Environmental Contamination and Toxicology},
	volume = {117},
	number = {2},
	pages = {},
	doi = {10.1007/s00128-026-04316-w},
	url = {https://www.scopus.com/pages/publications/105046868511?origin=resultslist},
	affiliations = {Department of Environmental Sciences and Engineering, Hakim Sabzevari University, 379 post box, Khorasan Razavi, Sabzevar, 9617916487, Iran; EthnoBiology Core (EBC), Hakim Sabzevari University, Khorasan Razavi, Sabzevar, Iran; Department of Environmental, Khorasan Razavi, Davarzan, Iran; Department of Environmental, Khorasan Razavi, Sabzevar, Iran; Green Space Director, Sabzevar Municipality, Khorasan Razavi, Sabzevar, Iran},
	abstract = {Urban environments are increasingly affected by heavy metal pollution originating from traffic, industrial activities, and other anthropogenic sources, which can have adverse consequences for urban ecosystems and human health. This study investigated the concentrations of heavy metals, including cadmium (Cd), iron (Fe), manganese (Mn), nickel (Ni), lead (Pb), and zinc (Zn), in the leaves of three commonly occurring urban tree species—pine (Pinus sp.), mulberry (Morus sp.), and Chinaberry (Melia azedarach)—as well as in the corresponding surface soils in Sabzevar, Iran. To assess species-specific accumulation patterns, the bioaccumulation factor (BCF) and metal accumulation index (MAI) were calculated, and non-carcinogenic health risks from soil exposure were estimated using the hazard quotient (HQ) and hazard index (HI). The results indicated significant differences in metal concentrations among tree species, with Morus sp. exhibiting the highest accumulation of Fe, Mn, and Ni, whereas Pinus sp. displayed the highest MAI values. Soil analysis revealed considerable spatial heterogeneity, with the highest Pb and Zn concentrations observed in high-traffic urban areas. HQ and HI values for all metals and age groups were below critical thresholds, although children exhibited higher values than adults. These findings underscore the importance of selecting appropriate tree species for biomonitoring and managing heavy metal pollution in semi-arid urban environments. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026.},
	author_keywords = {Bioindicator; Metal accumulation index; Plant; Risk index; Toxic element; Urban environment},
	keywords = {Cities; Environmental Monitoring; Humans; Iran; Metals, Heavy; Risk Assessment; Soil; Soil Pollutants; Trees; Bioaccumulation; Biochemistry; Biohazards; Ecosystems; Forestry; Health hazards; Heavy metals; Plants (botany); Pollution control; Risk assessment; Risk perception; Soil pollution; Soils; Urban planning; heavy metal; Carcinogenics; Heavy metals pollution; Metal accumulation indices; Pinus sp; Plant; Risk indices; Toxic elements; Tree species; Urban environments; Urban trees; chemistry; city; environmental monitoring; human; Iran; risk assessment; soil; soil pollutant; tree; Health risks},
	correspondence_address = {H. Malvandi; Department of Environmental Sciences and Engineering, Hakim Sabzevari University, Sabzevar, 379 post box, Khorasan Razavi, 9617916487, Iran; email: hmalvandi@gmail.com},
