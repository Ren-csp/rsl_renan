@ARTICLE{Kant2023,
	author = {Kant, Pankaj and Machavarapu, Pavan Kumar and Gajjar, Himalaya},
	title = {Assessment of drivers and barriers in the adoption of Mobility as a Service (MaaS): a case study of Noida, India},
	year = {2023},
