	author = {Liu, Yang and Wang, Jianying and Kwan, Mei-Po and Liu, Dong and Song, Liuyi},
	title = {How would travel contexts affect people’s perceptions and evaluations of urban green space?},
	year = {2026},
	journal = {Geography and Sustainability},
