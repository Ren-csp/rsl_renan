	author = {Eyler, Amy A. and O'Connor, Aine and Naghiloo, Fatemeh and Holland, Derek and Tibatemwa, Elisha and Salvo, Deborah},
	title = {Improving equity in access to large metropolitan parks in historically spatially segregated urban areas: A case study of St. Louis, USA},
