	title = {Rethinking soil contamination assessment for urban brownfield management: from total hazard to bioavailability},
	year = {2025},
	journal = {Chemosphere},
	volume = {393},
	pages = {},
	doi = {10.1016/j.chemosphere.2025.144769},
	url = {https://www.scopus.com/pages/publications/105022494290?origin=resultslist},
	affiliations = {Mines Saint-Étienne, Univ Lyon, CNRS, UMR 5307 LGF, Centre SPIN, Saint-Étienne, F - 42023, France; Mines Saint-Étienne, Univ Lyon, CNRS, Univ Jean Monnet, Univ Lumière Lyon 2, Univ Lyon 3 Jean Moulin, ENS Lyon, ENTPE, ENSA Lyon, UMR 5600 EVS, Centre SPIN, Saint-Étienne, F - 42023, France; TESORA, 10 Rue des Cuirassiers, Lyon, F - 69003, France; Université Jean Monnet Saint-Étienne, CNRS, UMR 5600 – Environnement-Ville-Société, Saint-Étienne, F-42023, France},
	abstract = {Hazard identification at contaminated sites usually rely on total concentrations of potentially toxic elements (PTE), but it is largely admitted that only the bioavailable fraction can trigger adverse effects. Assessing total PTE amounts is thus a worst-case scenario, that overestimates environmental risks and often leads to costly remediation actions. This study presents a practical and cost-effective methodology for assessing soil contamination by PTE, taking into account their bioavailability. To address this issue, we performed a three-tiered hazard identification considering: (1) total hazard (total PTE content), (2) environmentally available hazard (CaCl<sub>2</sub> leachable fraction), and (3) environmentally bioavailable hazard (accumulation in plant leaves). Additionally, an Integrated Hazard Excess (IHE) index was computed, for aggregating raw contaminant levels into a single integrated hazard value. The methodology was applied to a former industrial site in Saint-Étienne, France. Soil and plant samples were analyzed for As, Cd, Cr, Cu, Ni, Pb, and Zn. Mapping of IHE values provided a clear and holistic view of contamination across the site. Results showed that while total PTE levels were very high, the mobile and bioavailable fractions were overall within the range of local background observed in urban parks used for recreational activities. This indicated that actual environmental risk was significantly lower than total concentrations suggested. Thus, distinguishing total, available, and phytoavailable PTE amounts provided a more accurate and ecologically meaningful assessment of soil hazard. This approach could help decision-making and support the adoption of less disruptive and more sustainable remediation strategies, avoiding unnecessary excavation and landfill operations. © 2025 The Authors.},
	author_keywords = {Bioavailability; Integrated hazard index; Metals; Risk; Urban pedo-geochemical background},
	keywords = {Biological Availability; Cities; Environmental Monitoring; France; Metals, Heavy; Risk Assessment; Soil; Soil Pollutants; France; Biohazards; Contamination; Cost effectiveness; Environmental remediation; Hazardous materials; Plants (botany); Remediation; Risk assessment; Risk perception; Soil pollution; Soils; Sustainable development; arsenic; cadmium; calcium chloride; chromium; copper; lead; nickel; zinc; heavy metal; Bioavailability; Bioavailable fraction; Contamination assessment; Environmental risks; Geochemical background; Hazard identification; Integrated hazard index; Potentially toxic elements; Soil contamination; Urban pedo-geochemical background; bioavailability; contaminated land; environmental risk; geochemistry; landfill; Article; bioavailability; controlled study; cost effectiveness analysis; decision making; environmental risk; France; hazard; landfill; nonhuman; phytoavailability; plant leaf; recreational park; soil analysis; soil pollution; bioavailability; chemistry; city; environmental monitoring; procedures; risk assessment; soil; soil pollutant; Biochemistry},
