@ARTICLE{Tu2023883,
	author = {Tu, Xueying and Chang, Qing and Van Eetvelde, Veerle and Li, Luyuan},
	title = {How do visitors’ perceptions differ from the supply of cultural ecosystem services in urban parks? A case study from Beijing},
	year = {2023},
	journal = {International Journal of Sustainable Development and World Ecology},
	volume = {30},
	number = {8},
	pages = {883 - 896},
	doi = {10.1080/13504509.2023.2215200},
