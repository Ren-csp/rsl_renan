@ARTICLE{Macchiaroli2025139,
	author = {Macchiaroli, Maria and Dolores, Luigi},
	title = {The influence of urban lack of safety and preventive measures on property values: systematic review and meta-analysis; [L’influenza dell’insicurezza urbana e delle misure di prevenzione sui valori immobiliari: revisione sistematica e meta-analisi]},
	year = {2025},
	journal = {Valori e Valutazioni},
