	doi = {10.1016/j.ecoser.2026.101817},
	url = {https://www.scopus.com/pages/publications/105029231906?origin=resultslist},
	affiliations = {Faculty of Biological and Environmental Sciences, Department of Environmental Sciences, University of Helsinki, Niemenkatu 73, Lahti, 15140, Finland; Built Environment Solutions Unit, Finnish Environment Institute, Latokartanonkaari 11, Helsinki, 00790, Finland; Institute of Environmental Science and Technology, Universitat Autònoma de Barcelona, 08193 Bellaterra (Cerdanyola del Vallès), Spain; Population Health Unit, Finnish Institute for Health and Welfare, Mannerheimintie 166, Helsinki, 00271, Finland; Research Unit of Clinical Medicine, Faculty of Medicine, Aapistie 5a, Oulu, 90220, Finland; Department of Computer Science, Universitat Autònoma de Barcelona, Bellaterra (Cerdanyola del Vallès), 08193, Spain; Department of Geography, Humboldt-Universität zu Berlin, Berlin, 12489, Germany},
	abstract = {Cultural Ecosystem Services are gaining increasing attention as motivators for nature conservation and environmental stewardship. However, most assessments focus on tangible, easily measured aspects such as recreation, while more intangible CES—like inspiration, spirituality, or sense of place—and their underlying drivers remain poorly understood. This study examined an array of biophysical and social factors as determinants for CES along a gradient of tangibility. We used a semi-natural ecosystem—urban forest—as a case to study this question. We surveyed urban forest visitors (n = 241) in the city of Helsinki, Finland to assess CES. We compared the performance of ecosystem features, landscape features, and forest visitors’ demographics, nature-orientation, perception on ecosystem features, and visiting motivation in explaining interlinkages between CES of different tangibility. Visitor perceptions of ecosystem features and nature-orientation emerged as key explanatory factors of intangible CES, while visiting motivations were more strongly associated with tangible CES such as physical health and recreation. These findings underscore the need to integrate individual human-nature relationships—including sensitivities, preferences, and habitual engagements—into CES assessment. Practically, we suggest that activating both short-term demands and long-term affinities towards nature may enhance the diverse benefits urban nature can provide. © 2026 The Author(s)},
	author_keywords = {CES modelling; Motivation; Multiple CES; Perception; Satisfaction; Urban forests},
