@ARTICLE{Herringshaw2010535,
	author = {Herringshaw, Cassie J. and Thompson, Janette R. and Stewart, Timothy W.},
	title = {Learning about restoration of urban ecosystems: A case study integrating public participation, stormwater management, and ecological research},
	year = {2010},
