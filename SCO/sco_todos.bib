	keywords = {Benchmarking; Deep learning; Highway planning; Motion planning; Motor transportation; Public risks; Risk perception; Urban planning; Autonomous Vehicles; Motion-planning; Planning under uncertainty; Reachable set; Real-world; Set embedding; Spatio-temporal; Temporal uncertainty; Uncertainty; Uncertainty quantifications; autonomous underwater vehicle; conceptual framework; future prospect; inverse problem; optimization; scenario analysis; uncertainty analysis; Autonomous vehicles},
