@ARTICLE{Thomas2024,
	author = {Thomas, Alicia and Monsur, Muntazar and Lindquist, Carol S. and Montague, Thayne and Simpson, Catherine R.},
	title = {Impacts of Landscape Types and Flower Colors on the Emotional Perceptions of Military Service Members},
	year = {2024},
	journal = {Land},
	volume = {13},
	number = {12},
	pages = {},
	doi = {10.3390/land13122111},
	url = {https://www.scopus.com/pages/publications/85213220288?origin=resultslist},
	affiliations = {Department of Plant and Soil Science, Texas Tech University, Lubbock, 79409, TX, United States; Department of Landscape Architecture, Texas Tech University, Lubbock, 79409, TX, United States; Department of Sociology, Anthropology and Social Work, Texas Tech University, Lubbock, 79409, TX, United States},
	abstract = {Due to the unique mental and physical health challenges military service members (MSVMs) often face as a result of their service, MSVMs are a key demographic of interest. Interaction with natural environments may play a positive role in MSVMs’ overall health. Although previous research has been conducted on various population preferences and emotional responses to different types of gardens, there is a lack of data focused specifically on the garden preferences and emotional responses of MSVMs. To address this deficiency, an online survey was conducted featuring a series of questions with images related to landscape types and flower colors. The survey was disseminated via social media and military organizations to both civilians and military personnel (N = 366, with a 90.6% completion rate). Emotional responses were measured using a semantic differential scale. Most respondents were male, White, and between 25 and 35 years of age. MSVM respondents were primarily in the army and were either on active duty or honorably discharged. MSVMs and civilians showed similar garden and flower color preferences, each favoring wild landscape types and warm flower colors. However, the semantic differential analysis revealed MSVMs had significantly more negative emotional responses towards landscape types and flower colors compared to civilians. This indicates that the findings offer valuable insights into the unique emotional challenges faced by MSVMs, emphasizing the need for targeted interventions. Among military respondents, tropical landscapes were perceived more negatively. While it is crucial to incorporate preferred landscape elements into a design, understanding the emotional perceptions of these preferences is likely to aid garden designers in the creation of an environment that enhances overall well-being in an urban environment. © 2024 by the authors.},
	author_keywords = {emotional perceptions; landscape design; landscape type; military},
	keywords = {civil-military relationship; color; flower; garden; landscape structure; military land; perception; social media},
	correspondence_address = {C.R. Simpson; Department of Plant and Soil Science, Texas Tech University, Lubbock, 79409, United States; email: catherine.simpson@ttu.edu},
