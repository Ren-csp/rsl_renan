	doi = {10.1016/j.buildenv.2025.112984},
	url = {https://www.scopus.com/pages/publications/105002643155?origin=resultslist},
	affiliations = {College of Landscape Architecture and Art, Northwest A&F University, Yangling, 712199, China; Faculty of Architecture and Urban Planning, Chongqing University, Chongqing, 400044, China; Key Laboratory of New Technology for Construction of Cities in Mountain Area, Ministry of Education, Chongqing University, Chongqing, 400044, China},
	abstract = {Sound can serve as a medium to communicate the quality of the ecological environment and human well-being in urban environments. It is essential to clarify the specific relationships between ecoacoustic indices (EIs) and perceptual soundscape assessments. This study aims to explore the non-linear effects of EIs on soundscape descriptors under the influence of soundscape indicators (SIs). Utilizing the gradient boosted decision trees (GBDT) approach, we analyzed field soundscape survey data collected from seven waterfront spaces in Chongqing during the summer. Our findings indicate that incorporating EIs into SIs can enhance the performance of perceptual soundscape assessments prediction models across eight soundscape descriptors. Although the model demonstrates greater explanatory power for pleasantness and calmness compared to eventfulness and vibrancy, the EIs plays a more significant role in predicting eventful and vibrant soundscapes. Specifically, we found that median amplitude (M), acoustic complexity index (ACI), normalized difference soundscape index (NDSI), temporal entropy (Ht), spectral entropy (Hf), acoustic richness (AR), and bioacoustic index (BIO) had critical impacts on at least one soundscape descriptor. By comparing linear regression (LR) models and partial dependence plots (PDPs), we identified that most relationships between primary EIs and soundscape descriptors were non-linear. Finally, the study revealed that in urban environments, M, Ht, and Hf primarily reflect the influence of anthrophony, whereas AR, ACI, NDSI, and BIO can indicate the impact of biophony on perceptual soundscape assessments within a limited range. © 2025 Elsevier Ltd},
	author_keywords = {Ecoacoustic indices; Gradient boosting decision trees; Non-linear effects; Soundscape assessments},
	keywords = {China; Chongqing; Abiotic; Biotic; Chongqing; Descriptors; Ecoacoustic index; Gradient boosting; Gradient boosting decision tree; Nonlinear effect; Normalized differences; Soundscape assessment; Soundscapes; Urban environments; acoustics; decision support system; nonlinearity; perception; urban area; Anthropogenic},
