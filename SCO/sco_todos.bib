@ARTICLE{Mendl2020,
	author = {Mendl, Sebastián},
	title = {INTERSUBJECTIVITY AND INDIVIDUATION IN HUSSERL AND HABERMAS: OF THE NEED OF A PARADIGM SHIFT TO COMPLEMENTATION; [INTERSUBJETIVIDAD E INDIVIDUACIÓN EN HUSSERL Y HABERMAS: DE LA NECESIDAD DE UN CAMBIO DE PARADIGMA A LA COMPLEMENTACIÓN]},
	year = {2020},
