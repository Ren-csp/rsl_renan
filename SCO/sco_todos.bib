	title = {“The Urban Poor and Vulnerable Are Hit Hardest by the Heat”: A Heat Equity Lens to Understand Community Perceptions of Climate Change, Urban Heat Islands, and Green Infrastructure},
	year = {2023},
	journal = {Land},
	volume = {12},
