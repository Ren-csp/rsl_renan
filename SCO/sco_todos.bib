	title = {Perception based method for measuring the aesthetic quality of the urban environment},
	year = {2017},
	journal = {Open House International},
	volume = {42},
	number = {2},
	pages = {11 - 19},
	url = {https://www.scopus.com/pages/publications/85029094680?origin=resultslist},
	affiliations = {Department of Architecture, Girne american University, Via Mersin 10, North Cyprus, Turkey; Department Of Architecture, Eastern Mediterranean University, Via Mersin 10, North Cyprus, Turkey; Faculty Of Architecture, Near East University, Via Mersin 10, North Cyprus, Turkey},
	abstract = {This study assesses changing aesthetic values and their characteristics in urban environments based on human perception. With this in mind, a model for assessing the aesthetic values of the urban environment based on the three steps of human cognition has been developed to elaborate the user's perception in different urban environments. The results of the survey confirm that by changing urban morphology the aesthetic perception of the environment also changes. The finding of this research opens up a new window for urban planners to assess the aesthetic effects of the elements of urban spatial configuration for future urban development.},
