	title = {The impact of climate change awareness on green space development preferences in Warsaw, Poland; [Wpływ świadomości zmian klimatycznych (CCA) na preferencje dotyczące rozwoju terenów zieleni - wyniki badań przeprowa dzonych w Warszawie]},
	year = {2025},
