	keywords = {Extremadura; Spain; Animalia; Aves; Vertebrata; Animals; Fractal dimension; Planning; Water; Acoustic characteristic; Comfort; Environmental sounds; Fundamental frequencies; Garden; Noise; Psychological health; Urban; acoustics; garden; mental health; perception; psychology; social behavior; urban planning; Behavioral research},
