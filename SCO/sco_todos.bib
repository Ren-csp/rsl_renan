	author = {Wang, Xuefei and Zhu, Baoyao and Chen, Zhiqi and Ma, Dawei and Sun, Chuanhao and Wang, Mo and Jiang, Xing},
	title = {Landscape Perception in Cultural and Creative Industrial Parks: Integrating User-Generated Content (UGC) and Electrodermal Activity Insights},
