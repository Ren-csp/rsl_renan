	url = {https://www.scopus.com/pages/publications/105043021682?origin=resultslist},
	affiliations = {Department of Urban Planning and Design, Faculty of Architecture, Budapest University of Technology and Economics, Műegyetem rkp 3., Budapest, H-1111, Hungary},
	abstract = {Understanding how emotional relationships with the built environment can be measured and transformed is an important challenge for research on wellbeing, heritage, and urban experience. This study investigates whether guided urban walks can influence participants’ sense of place in a post-socialist urban context and proposes a novel mixed-methods approach for tracking emotional responses in an urban context. The research was conducted in Pesterzsébet, a suburban district of Budapest, Hungary, characterized by contested postwar architectural heritage. Thirty architecture students participated in both an individual, non-guided walk and a guided urban walk following the same itinerary. Data collection combined geotagged photography, geotagged self-reporting through selfies, GPS tracking, post-visit questionnaires, and biosensing data derived from heart rate variability (HRV) recorded through wearable devices. Spatial Points of Emotion helped to compare guided and non-guided experiences. Results demonstrate that guided interpretation and storytelling significantly influenced participants’ perceptions of the urban environment. Compared with individual exploration, guided walks generated more positive emotional responses, higher emotional engagement, and increased appreciation of architectural and spatial qualities that were initially overlooked or negatively perceived. The integration of biosensing, spatial tracking, and visual self-reporting provided a richer understanding of how emotional responses vary across urban environments and how heritage narratives shape these responses. The findings suggest that guided urban walks function as experience-based learning activities capable of fostering sense of place and revalorizing contested heritage. Methodologically, the study advances emotion-tracking research by demonstrating the value of combining physiological, spatial, and visual data to investigate human–environment relationships in urban settings. © 2026 The Authors.},
	author_keywords = {Budapest; Emotion tracking; Guided tours; Post-socialist heritage; Proximity tourism; Sense of place},
