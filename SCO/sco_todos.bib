@ARTICLE{Yi2025,
	author = {Yi, Kaiyuan and Shi, Xiaoyan and Wei, Meng and Zhang, Zhe},
	title = {Benefits of Various Urban Green Spaces for Public Health Based on Landscape Elements: A Study of Public Visual Perception},
	year = {2025},
	journal = {Forests},
