@ARTICLE{Gul2026,
	author = {Gul, Hiba and Shafique, Adiba and Das, Bijay Kumar},
	title = {Air pollution and subjective wellbeing: an integrative conceptual review with systematic methods, applied to environmental and psychosocial impact studies},
	year = {2026},
	journal = {Frontiers in Sustainable Cities},
	volume = {8},
