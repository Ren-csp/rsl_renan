@ARTICLE{Samaras2024745,
	author = {Samaras, Nikolaos and Tsola, Evrydiki and Samaras, Christos and Sapounakis, Aris},
	title = {River Restoration and Revitalisation in Urban Areas: Exploring Opportunities for the Elassonitis River in Elassona, Greece},
	year = {2024},
