@ARTICLE{Hasegawa2022,
	author = {Hasegawa, Yoshimi and Lau, Siu-Kit},
	title = {Comprehensive audio-visual environmental effects on residential soundscapes and satisfaction: Partial least square structural equation modeling approach},
	year = {2022},
