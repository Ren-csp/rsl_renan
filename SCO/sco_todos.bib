@ARTICLE{Hou2025,
	author = {Hou, Fei and Hedayati Marzbali, Massoomeh and Maghsoodi Tilaki, Mohammad Javad and Abdullah, Aldrin},
	title = {Rethinking Urban Greening: Implications of Crime Prevention Through Environmental Design for Enhancing Perceived Safety in Baitashan Park, Lanzhou},
	year = {2025},
	journal = {Urban Science},
	volume = {9},
