@ARTICLE{Masterson2018,
	author = {Masterson, Vanessa A. and Mahajan, Shauna L. and Tengö, Maria},
	title = {Photovoice for mobilizing insights on human well-being in complex social-ecological systems: Case studies from Kenya and South Africa},
	year = {2018},
	journal = {Ecology and Society},
	volume = {23},
	number = {3},
	pages = {},
