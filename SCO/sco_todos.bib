	author = {Hussein, Layla and Saleh, Sundus and Khalilia, Ahmad and Atawneh, Bader and Ashqar, Huthaifa I.},
	title = {Voices from the neighborhood: residents perception on local parks},
	year = {2026},
	journal = {Frontiers in Sustainable Cities},
	volume = {8},
	pages = {},
	doi = {10.3389/frsc.2026.1803301},
	url = {https://www.scopus.com/pages/publications/105046695981?origin=resultslist},
	affiliations = {Arab American University, Ramallah, Palestine; Palestine Polytechnic University, Hebron, Palestine; Columbia University, New York, NY, United States},
	abstract = {Introduction – Urban parks in Palestinian cities play a vital role in supporting community wellbeing, yet their success depends heavily on how residents perceive, use, and identify with these spaces. Methods – This study investigates residents’ perceptions of two major public parks in the two neighboring yet different cities, Ramallah and Al-Bireh, Palestine. The study explores the cultural, spatial, and emotional factors that shape their sense of place. Using a qualitative methodology that combines semistructured interviews and direct observation, the research uncovers key themes related to accessibility, safety, municipal policies, cultural practices, and the contrast between global expectations of parks and deeply local forms of attachment. Results and discussion – Findings show that while both parks serve important recreational and social functions, differences in design, management, and cultural compatibility significantly influence how residents connect with them. Al-Bireh’s more flexible policies and familiar spatial practices encourage stronger emotional attachment, while certain design constraints and restrictions in Ramallah reduce users’ sense of belonging. The study concludes that integrating global design standards with local cultural values through improved accessibility, safe design, and socially responsive policies is essential for creating parks that are inclusive, lively, and meaningful to their communities. These insights offer valuable guidance for planners, municipalities, and designers working toward healthier and more resilient urban landscapes in Palestine. Copyright © 2026 Hussein, Saleh, Khalilia, Atawneh and Ashqar.},
	author_keywords = {local community; local parks; open spaces; perception; sense of place},
	correspondence_address = {H.I. Ashqar; Arab American University, Ramallah, Palestine; email: huthaifa.ashqar@aaup.edu},
	publisher = {Frontiers Media SA},
	issn = {26249634},
	language = {English},
	abbrev_source_title = {Front. Sustain. Cities.},
	type = {Article},
