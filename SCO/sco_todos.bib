@ARTICLE{Zinnenlauf20261974,
	author = {Zinnenlauf, Rafael and Michel, Annina H. and Backhaus, Norman and Deplazes-Zemp, Anna},
	title = {Aesthetic values as relational values: Environmental aesthetics in go-along interviews},
