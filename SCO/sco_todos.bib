	pages = {1094 - 1110},
	doi = {10.1016/j.ejor.2021.08.035},
	url = {https://www.scopus.com/pages/publications/85115908769?origin=resultslist},
	affiliations = {State University of New York at Plattsburgh, NY, USA, NY, United States; Systems Optimization and Data Analytics Lab (SODAL), Department of Mechanical and Industrial Engineering, New Jersey Institute of Technology, Newark, NJ, United States; U.S. Department of Agriculture, Forest Service, Northern Research Station, St. Paul, MN, United States},
	abstract = {We derive a nested risk measure for a maximization problem and implement it in a scenario-based formulation of a multi-stage stochastic mixed-integer programming problem. We apply the risk-averse formulation to the surveillance and control of a non-native forest insect, the emerald ash borer (EAB), a wood-boring beetle native to Asia and recently discovered in North America. Spreading across the eastern United States and Canada, EAB has killed millions of ash trees and cost homeowners and local governments billions of dollars. We present a mean-Conditional Value-at-Risk (CVaR), multi-stage, stochastic mixed-integer programming model to optimize a manager's decisions about surveillance and control of EAB. The objective is to maximize the benefits of healthy ash trees in forests and urban environments under a fixed budget. Combining the risk-neutral objective with a risk measure allows for a trade-off between the weighted expected benefits from ash trees and the expected risks associated with experiencing extremely damaging scenarios. We define scenario dominance cuts (sdc) for the maximization problem and under the decision-dependent uncertainty. We then solve the model using the sdc cutting plane algorithm for varying risk parameters. Computational results demonstrate that scenario dominance cuts significantly improve the solution performance relative to that of CPLEX. Our CVaR risk-averse approach also raises the objective value of the least-benefit scenarios compared to the risk-neutral model. Results show a shift in the optimal strategy from applying less expensive insecticide treatment to more costly tree removal as the manager becomes more risk-averse. We also find that risk-averse managers survey more often to reduce the risk of experiencing adverse outcomes. © 2021 Elsevier B.V.},
	author_keywords = {(R) OR in Natural Resources; Conditional Value-at-Risk (CVaR); Mixed Integer Programming; Multi-Stage Stochastic Optimization; Risk-Averse; Scenario Dominance Cuts; Spatial-Temporal Optimization},
	keywords = {Budget control; Economic and social effects; Forestry; Integer programming; Managers; Monitoring; Risk assessment; Risk perception; Stochastic models; Stochastic systems; Value engineering; (R) OR in natural resource; Conditional value-at-risk; Mixed-Integer Programming; Multi-stage stochastic optimization; Multi-stages; Optimisations; OR in natural resources; Risk averse; Scenario dominance cut; Spatial temporals; Spatial-temporal optimization; Stochastic optimizations; Risk analysis},
	correspondence_address = {İ.E. Büyüktahtakın; Systems Optimization and Data Analytics Lab (SODAL), Department of Mechanical and Industrial Engineering, New Jersey Institute of Technology, Newark, United States; email: esratoy@njit.edu},
