	year = {2025},
	journal = {Intelligent Buildings International},
	pages = {},
	doi = {10.1080/17508975.2025.2590845},
	url = {https://www.scopus.com/pages/publications/105023474675?origin=resultslist},
	affiliations = {School of Architecture and Environmental Design, Iran University of Science & Technology (IUST), Tehran, Iran; Landscape Architecture, School of Architecture and Environmental Design, Iran University of Science & Technology (IUST), Tehran, Iran; Architecture, Architecture & Urbanism Faculty, Tabriz Islamic Art University, Tabriz, Iran},
	abstract = {Urban environments influence users' psychological states through a complex interplay of physical, social, and perceptual attributes. In some cases, these conditions give rise to perceived hidden environmental stress, a subtle and cumulative form of stress that gradually erodes comfort and emotional stability. This study investigates the key components contributing to perceived hidden environmental stress within the urbanscape of Tehran. A three-phase mixed-method approach was adopted. First, content analysis of relevant literature identified potential stress-inducing factors. Second, expert assessments were conducted using the Best–Worst Method (BWM) to prioritize these factors. Third, citizens' perceptions were examined through a Choice-Based Conjoint (CBC) experiment using AI generated visual stimuli. The findings categorize the influencing factors into three domains: environmental, human, and perceptual. Experts prioritized built-form and perceptual attributes such as spatial layout and visual coherence, whereas citizens emphasized directly perceivable environmental qualities including greenscape, environmental pollution, and space security and safety. This divergence between professional judgments and lived experience underscores the necessity of integrating both perspectives in urban design and decision-making. The results provide a framework for developing psychologically supportive urban spaces and highlight the importance of subtle environmental cues in shaping user well-being. Highlight Defines perceived hidden environmental stress as a subtle yet measurable urban stressor. Integrates expert BWM and citizen CBC analyses to identify key factors. Shows that citizens value greenscape, pollution control, and safety; experts stress design and perception. Offers urban design insights to reduce hidden environmental stress. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {environmental psychology; environmental stressors; Perceived hidden environmental stress; preferences; Tehran; urbanscape},
	keywords = {Factor analysis; Pollution control; Urban planning; BAD methods; Choice-based conjoint; Environmental psychology; Environmental stress; Environmental stressors; Perceived hidden environmental stress; Perceptual attributes; Preference; Tehran; Urbanscape; Decision making},
	correspondence_address = {M. Khakzand; Landscape Architecture, School of Architecture and Environmental Design, Iran University of Science & Technology (IUST), Tehran, Iran; email: mkhakzand@iust.ac.ir},
