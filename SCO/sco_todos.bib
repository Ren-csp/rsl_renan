	correspondence_address = {A. Sadeghi-Niaraki; Dept. of Computer Science & Engineering and Convergence Engineering for Intelligent Drone, XR Research Center, Sejong University, Seoul, South Korea; email: a.sadeghi@sejong.ac.kr},
