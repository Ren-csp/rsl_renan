@ARTICLE{Yao2026,
	author = {Yao, Peian and Wei, Xiaoxu and Zhu, Shu and Yuan, Yangyang},
	title = {Identifying City Image Through Streetscape Visual Features and Visitor Narratives: A Case Study in Wuhan},
	year = {2026},
