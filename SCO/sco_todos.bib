	doi = {10.1016/j.scs.2026.107694},
	url = {https://www.scopus.com/pages/publications/105045075360?origin=resultslist},
	affiliations = {State Key Laboratory of Regional and Urban Ecology, Institute of Urban Environment, Chinese Academy of Sciences, Xiamen, 361021, China; University of Chinese Academy of Sciences, Beijing, 100049, China; Department of Forestry and Natural Resources, Purdue University, West Lafayette, 47907, IN, United States},
	abstract = {Urban green space (UGS) supports public health, yet ensuing equitable access for residents living in areas with different housing prices remains challenging. Overhead level metrics like UGS area are widely used to assess UGS disparity but inadequately capture equity in visible greenery. Human eye-level metrics offer a visible perception measure of exposure, potentially addressing the limitations of overhead metrics. This study introduces human eye-level metrics and examines whether better UGS visionscape quality and equality associate with higher housing prices from overhead to human eye level. We evaluated overhead and human eye-level visionscape quality using Sentinel-2 remote sensing images processed in Google Earth Engine and street view images analyzed with a DeeplabV3+ semantic segmentation model. Equity in UGS accessibility was then calculated using the Gaussian two-step floating catchment area method alongside the Gini coefficient. We further examined how visionscape quality and accessibility correlate with housing prices by means of generalized additive model. Results show that: (1) high-priced neighbourhoods exhibit significantly higher visionscape quality, with advantages of 19.7% and 58.2% from overhead to human eye level; (2) overhead visionscape quality exceeds eye-level quality by 28%; (3) accessibility equality measured at human eye level outperforms overhead measures; (4) visionscape quality rises with housing prices, while accessibility exhibits complex nonlinear patterns. These findings extend the conventional evaluation of UGS equity and provide more evidence-based insights for visionscape planning, management, and assessment in high-density urban environments. © 2026 Elsevier Ltd},
	author_keywords = {G2SFCA; Green equity; Housing price; Human eye level; Overhead; Visionscape},
