	pages = {},
	doi = {10.1016/j.ecofro.2026.08.003},
	url = {https://www.scopus.com/pages/publications/105047478467?origin=resultslist},
	affiliations = {Department of Ecology, Institute of Biosciences, University of São Paulo, Rua do Matão, Travessa 14, 321, Cidade Universitária, SP, São Paulo, 05508-900, Brazil; Department of Environmental Health, School of Public Health, University of São Paulo, Avenida Dr. Arnaldo, 715, Cerqueira César, SP, São Paulo, 01246-904, Brazil; IUCN, 1630 Connecticut Ave., NW Suite 300, Washington, 20009, DC, United States; Department of Pathology, Faculty of Medicine, University of São Paulo, Avenida Dr. Arnaldo, 455, Cerqueira César, SP, São Paulo, 01246-903, Brazil; School of Biology and Environmental Science, Queensland University of Technology (QUT), 2 George Street, Brisbane, 4000, QLD, Australia; Theoretical Ecology, University of Regensburg, Regensburg, 93053, Germany},
	abstract = {Although the positive effects of urban green areas on mental health are widely recognized, most studies have focused primarily on the amount of greenness. Our research offers a novel perspective by evaluating not only the amount but also the quality and accessibility of green areas, distinguishing between objective and subjective exposure metrics. We performed a meta-analysis to quantitatively evaluate the current level of evidence on how three types of green exposure – amount, access, and quality of green areas - affect both general mental health and mental disorders. Our findings revealed that, while the three types of exposure to green areas positively influence mental health, the ecological quality of green areas (related to species diversity, variety of vegetation types) appears to have a pronounced effect. However, a targeted sensitivity analysis revealed a key limitation: while the benefits of amount and access remain robust across objective metrics, the impact of green space quality relies on subjective perception. The results highlight that quality benefits mental health primarily through perceived biodiversity or habitat structural heterogeneity, shaped by visible structural cues rather than objective biological complexity alone. They also point to a critical shift from just increasing the amount of greenness to enhancing ecological quality and ensuring better access. Finally, our findings underline that the interrelated nature of these exposure characteristics must be addressed in an integrated way to maximize the mental health benefits of urban green areas. By focusing on the quality of existing green areas, urban planners can create effective interventions to enhance residents' mental well-being, even without increasing the size of green areas. Investments in promoting access and enhancing ecological quality can provide significant mental health benefits, complementing the traditional expansion of green areas. © 2026 The Authors.},
	author_keywords = {Ecological quality; Nature exposure; Public health; Sustainable cities; Urbanization},
