@ARTICLE{De Marinis202395,
	author = {De Marinis, Cecilia},
	title = {Intensity as the Perceivable Dimension of Density in the Urban Environment: The Case of Housing Blocks by MBM Arquitectes in Barcelona, Spain},
	year = {2023},
	journal = {Architecture and Culture},
	volume = {11},
	number = {1-2},
	pages = {95 - 116},
	doi = {10.1080/20507828.2023.2187203},
	url = {https://www.scopus.com/pages/publications/105004010793?origin=resultslist},
	affiliations = {BAU, College of Arts & Design, Barcelona, Spain},
	abstract = {The concept of intensity is a concentration of spatial, social, and environmental experiences in the urban environment. It is an extension of density, beyond the quantitative measure of the urban environment toward its qualitative and perceivable aspects. Drawing on urban studies with a human-centered approach by Michael Sorkin, Jane Jacobs, Jan Gehl and William T. Whyte, and proxemics studies by Edward T. Hall, this paper explores the spatial implications of intensity to identify the qualities of the built environment that positively influence the relationship between people and space. With this purpose, case studies were selected from the housing complexes designed, from the 1960s to the 1990s, by the architectural office MBM Arquitectes in Barcelona (Spain). The observational, spatial and visual analysis focused on the public spaces of those housing complexes as well as on the use and appropriation of them by inhabitants. Public spaces are the ground for studying urban intensity: they are the set where urban life can be performed and the main vehicle for promoting intentional relationships between people and space. A series of five spatial qualities were identified as categories of perceived urban intensity and are discussed in detail: Connection, Articulation, Differentiation, Extension and Concentration. Such categories can help orient the analysis and interpretation of the physical and perceptual materials of urban intensity, to better understand the design of our public space, our cities and their futures. © 2023 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {density; inhabitation; perception; public space; Urban intensity},
	correspondence_address = {C. De Marinis; BAU, College of Arts & Design, Barcelona, Spain; email: cecilia.demarinis@bau.cat},
	publisher = {Taylor and Francis Ltd.},
	issn = {20507828},
	language = {English},
	abbrev_source_title = {Archit. Cult.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Hung2022,
	author = {Hung, Shih-Han and Chang, Chun-Yen},
	title = {How do humans value urban nature? Developing the perceived biophilic design scale (PBDs) for preference and emotion},
	year = {2022},
	journal = {Urban Forestry and Urban Greening},
	volume = {76},
	pages = {},
	doi = {10.1016/j.ufug.2022.127730},
	url = {https://www.scopus.com/pages/publications/85138069011?origin=resultslist},
	affiliations = {Department of Landscape Architecture, Tunghai University, Taichung, Taiwan},
	abstract = {With the growth of urbanization and the increasingly hectic pace of life, exposure to urban nature within blue-green infrastructure is greatly impacting human health and well-being. Biophilia, an evolutional concept, conveys the initial connection between humans and nature; biophilic design transfers into design attributes to indicate the relationship between humans and the environment. A significant advantage of experiencing nature is positive restoration; however, only limited research has been conducted on connecting biophilic design and mental health. This study adopted our perceived biophilic design items (PBDi) to examine the relationship between landscape preferences and emotional states in urban green spaces. Online surveys (valid total n = 477) examining these biophilic items, landscape preferences, and emotional states were conducted. Seven aspects—(1) evolved human–nature relationships, (2) place-based relationships, (3) visual aesthetic quality, (4) state of natural change, (5) environmental perception, (6) sense of compatibility in the built environment, and (7) natural form of design method —were confirmed through exploratory factor analysis (EFA), with 64.35 % of the cumulative variance, and confirmatory factor analysis (CFA) demonstrated good convergent validity and discriminant validity. The overall perceived biophilic design scale (PBDs) with 28 items had a Cronbach's α of 0.91. In addition, it was found that PBDs significantly explained landscape preferences and positive emotional states within urban nature. The findings provide an alternative tool for measuring human biophilic perceptions that influence environmental experiences. In addition, each item in the scale could be used as a biophilic guideline for designers and planners to reinterpret nature in cities and to enhance our connection to nature in general. © 2022 Elsevier GmbH},
	author_keywords = {Built environment; Human-nature relationship; Landscape design; Positive and negative affect schedule; Preference},
	keywords = {design method; factor analysis; infrastructure; landscape; urban planning},
	correspondence_address = {C.-Y. Chang; Department of Horticulture and Landscape Architecture, National Taiwan University, Taipei City, No. 138, Section 4, Keelung Rd., 106, Taiwan; email: cycmail@ntu.edu.tw},
	publisher = {Elsevier GmbH},
	issn = {16188667},
	language = {English},
	abbrev_source_title = {Urban For. Urban Greening},
	type = {Article},
	publication_stage = {Final},
