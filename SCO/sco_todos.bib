}

@ARTICLE{xiao2025,
	author = {xiao, Xiaomin and Zhao, Chenhao and Yu, Qiwen and Dong, Xiaobin},
	title = {Exploring tourists' perception of ecosystem services in urban park to promote cost-effectiveness management based multi-source data},
	year = {2025},
	journal = {Environmental and Sustainability Indicators},
	volume = {28},
	pages = {},
	doi = {10.1016/j.indic.2025.100974},
	url = {https://www.scopus.com/pages/publications/105020592075?origin=resultslist},
	affiliations = {State Key Laboratory of Earth Surface Processes and Resource Ecology, Beijing Normal University, Beijing, 100875, China; Faculty of Geographical Science, Beijing Normal University, Beijing, 100875, China},
	abstract = {Understanding the tourists' perception of ecosystem services is an important tool for urban park tourism management. However, traditional questionnaire surveys often fail to capture genuine public feedback, and social media data tends to represent a limited and biased user demographic, leading to a narrow scope in current public perception studies. Transforming comprehensive tourists' perceptions into prioritized and actionable recommendations for urban park tourism management remains a significant challenge in urban park governance. This study has established a framework for assessing ecosystem services with multi-source data (social media texts, photos, and questionnaires), and integrated the priority-setting capacity of the Importance-Performance Analysis (IPA) model to bridge the gap in existing research. With Haizhu National Wetland Park in Guangzhou as the research subject, this study has explored the characteristics of the public's perception of the importance and satisfaction of ecosystem services based on social media text data, and defined the importance evaluation by perception frequency and multiple centralities. The study revealed that the public attaches considerable significance to aesthetic appreciation, recreational and entertainment, social inclusion, and psycho-physical health benefits. Based on social media text and photo data, the degree of correlation between ecosystem services and landscape elements was investigated. The research discovered that aesthetic appreciation services were mainly linked to lakes, flowers, trees, and jungles. Furthermore, lakes participate in the construction of various ecosystem services and were the primary source of perception for these services. Furthermore, based on the data from the questionnaire survey, the perceptual differences of ecosystem services among the elderly group and groups with different educational levels were explored, effectively reconciling the potential demand contradictions. The IPA model revealed the priorities of ecosystem service renewal and the corresponding landscape elements, providing a direct basis for park governance. The findings can inspire urban park managers to formulate more targeted and efficient optimization strategies. At the same time, it can facilitate the comprehensive assessment of user perception and ecosystem services to become a more effective operational tool for tourism management. © 2025 The Authors.},
	author_keywords = {Ecosystem services; Importance-performance analysis (IPA) model; Multi-source data; Tourism management; Tourists' perception; Urban park},
