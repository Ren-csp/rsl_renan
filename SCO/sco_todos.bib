@ARTICLE{Unnithan Kumar20253282,
	author = {Unnithan Kumar, Siddharth and Gaston, Kevin J.},
	title = {Auditory perception and the ecology of human–nature interactions: Effects of hearing loss on listening to birdsong},
	year = {2025},
	journal = {People and Nature},
