@ARTICLE{Granobles Velandia2024289,
	author = {Granobles Velandia, Fabián Andrés and Trilleras Motha, Jenny Maritza and Romero-Duque, Luz Piedad and Quijas, Sandra},
	title = {Understanding the sociocultural valuation of ecosystem services in urban parks: a Colombian study case},
	year = {2024},
	journal = {Urban Ecosystems},
