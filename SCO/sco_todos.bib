@ARTICLE{Merolla2022838,
	author = {Merolla, Andy J. and Hansia, Afsoon and Hall, Jeffrey A. and Zhang, Shuangyue},
	title = {Moments of Connection for the Disconnected: People with Negative Relations with Others Experience Less, but Benefit More from, Positive Everyday Interaction},
	year = {2022},
	journal = {Communication Research},
	volume = {49},
	number = {6},
	pages = {838 - 862},
	doi = {10.1177/00936502211005890},
