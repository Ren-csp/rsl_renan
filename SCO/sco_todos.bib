	affiliations = {Faculty of Social Sciences and Humanities, Ton Duc Thang University, Ho Chi Minh City, 700000, Viet Nam; Centre for Interdisciplinary Social Research, Phenikaa University, Hanoi, 100803, Viet Nam; Faculty of Nursing, Widya Mandala Surabaya Catholic University, East Java, Surabaya, 60265, Indonesia; A.I. for Social Data Lab, AISDL, Hanoi, 100803, Viet Nam; University College, Korea University, Seoul, 02841, South Korea},
	abstract = {Financial support from urban residents represents a potentially important resource for sustaining and expanding public parks, particularly tree-planting initiatives that contribute to biodiversity and human well-being. This study applies the Granular Interaction Thinking Theory (GITT) and Bayesian inference to examine how residents’ perceptions of the consequences of biodiversity loss and their park-visit frequency relate to willingness to donate to tree-planting projects in public parks. Based on survey data from 535 Vietnamese residents, the results indicate that perceived loss of ecological knowledge and more frequent park visitation are associated with higher willingness to donate, whereas perceived health-related losses receive moderate posterior support for a positive association. Perceived reductions in economic growth are positively related to park visitation frequency, which, in turn, is associated with greater willingness to donate. In contrast, perceived losses from nature-based recreation are linked to lower visitation frequency and subsequently weaker willingness to make indirect donations. These findings suggest that communication and engagement strategies that emphasize personally and community-relevant benefits may be associated with stronger financial support intentions for urban tree-planting initiatives. As the study focuses on stated willingness rather than observed financial behavior, the implications pertain to intention-based support rather than realized contributions. © 2026 by the authors.},
	author_keywords = {biodiversity conservation; biodiversity loss perceptions; BMF analytics; financial contribution; Granular Interaction Thinking Theory (GITT); tree planting; urban parks},
	keywords = {biodiversity; conservation status; decision making; economic growth; ecosystem service; greenspace; perception; tree planting; willingness to pay},
