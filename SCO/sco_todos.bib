@ARTICLE{Pereira2016253,
	author = {Pereira, Filipa and Matos, Marlene},
	title = {Cyber-Stalking Victimization: What Predicts Fear Among Portuguese Adolescents?},
	year = {2016},
	journal = {European Journal on Criminal Policy and Research},
	volume = {22},
