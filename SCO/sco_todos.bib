	author = {Marcillia, Syam Rachma and Adiputri, Kemuning Arumingtyas and Fadhillah, Nurul and Almadina, Alif Faricha},
	title = {Landscape Features Restorative Value and Sensory Dimension In Educational Institution's Green Public Spaces},
	year = {2026},
	journal = {International Review for Spatial Planning and Sustainable Development},
	volume = {14},
	number = {1},
	pages = {227 - 245},
