	url = {https://www.scopus.com/pages/publications/105020584039?origin=resultslist},
	affiliations = {Ranbir & Chitra Gupta School of Infrastructure Design and Management, IIT Kharagpur, India; VIT-School of Architecture, Vellore Institute of Technology, Vellore, India},
	abstract = {Neighbourhoods are centres of micro-level anthropogenic activities. The built environment of a neighbourhood can have varying impacts on the lives of children and adults due to the differences in their activity and accessibility patterns. There is a notable variance in the availability and accessibility of diverse infrastructures tailored to children at the local community level. A comprehensive empirical investigation was carried out to gain insights into the perspectives of 813 predominantly middle-income urban residents in Kolkata, India, regarding the infrastructure requirements of children in their respective neighbourhoods. This research investigated the key determinants that influence individuals’ selection of residential locations, as well as the residents’ perceptions regarding traffic-related issues and the levels of neighbourhood cohesion. Furthermore, an evaluation of the quality of existing children-centric infrastructures and the preferred amenities was conducted. The findings indicate that proximity to the school was regarded to be the least significant factor in determining where individuals chose to reside. Local parks and playgrounds were the most popular locations for children to engage in physical, social, and recreational activities, according to the study. The provision of parks, playgrounds, and open spaces was deemed the most essential physical infrastructure, followed by resting benches and surveillance facilities such as CCTV. In addition, the provision of adequate healthcare infrastructure and libraries was viewed as a vital component of social infrastructure. This study is a valuable resource for policymakers, urban planners, and practitioners in promoting child-friendly urban environments and attaining sustainable urban development in the context of the Global South. © 2025 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {built-environment (BE); Child-friendly; infrastructure; mobility; neighbourhood},
