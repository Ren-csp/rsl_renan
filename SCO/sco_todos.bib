@ARTICLE{Vagos2026,
	author = {Vagos, Paula and Miguel, Isabel and Carvalhais, Lénia},
	title = {The Grandchildren’s Received Affection Scale for Adolescents: Evidence for Internal Structure and Construct Validity in Portuguese Adolescents},
	year = {2026},
	journal = {Social Sciences},
