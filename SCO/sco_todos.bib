@ARTICLE{Jiang2018,
	author = {Jiang, Bin and Mak, Cecilia Nga Sze and Zhong, Hua and Larsen, Linda and Webster, Christopher John},
	title = {From broken windows to perceived routine activities: Examining impacts of environmental interventions on perceived safety of urban alleys},
	year = {2018},
	journal = {Frontiers in Psychology},
	volume = {9},
	number = {DEC},
	pages = {},
	doi = {10.3389/fpsyg.2018.02450},
	url = {https://www.scopus.com/pages/publications/85057614752?origin=resultslist},
	affiliations = {Department of Architecture, Division of Landscape Architecture, The University of Hong Kong, Pokfulam, Hong Kong; Virtual Reality Lab of Urban Environments and Human Health, Faculty of Architecture, The University of Hong Kong, Pokfulam, Hong Kong; Department of Sociology, The Chinese University of Hong Kong, Shatin, Hong Kong; Department of Landscape Architecture, University of Illinois, Urbana-Champaign, IL, United States},
	abstract = {In high-density cities around the world, alleys are common but neglected spaces that are perceived as unsafe. While cities have invested resources in environmental interventions to improve safety in urban allies, it is not clear how these interventions impact perceived safety. We review two important criminology theories that discuss the environmental and social factors that lead to crime: the Broken Windows Theory and the Routine Activity Theory. We argue that these theories can also be used to explain safety perceptions of urban environments, and then develop urban alley interventions based on these theories. We test people's perceived safety of these interventions through a photograph survey. Results show that all interventions yielded higher perceived safety than existing alley scenes. Interventions based on the Broken Windows Theory (cleaning or vegetation interventions) yielded only modest improvements in perceived safety, while interventions based on the Routine Activity Theory (urban function interventions) yielded higher ratings. Our findings question the dominant use of the Broken Windows Theory in environmental interventions to promote perceived safety and argue for a more effective approach: urban function interventions inspired by the Routine Activity Theory. © 2018 Jiang, Mak, Zhong, Larsen and Webster.},
	author_keywords = {Broken windows theory; Environmental intervention; High-density city; Perceived safety; Routine activities theory; Urban alley; Urban function; Vegetation},
	correspondence_address = {B. Jiang; Department of Architecture, Division of Landscape Architecture, The University of Hong Kong, Pokfulam, Hong Kong; email: jiangbin@hku.hk},
