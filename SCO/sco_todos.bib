	title = {Perceptions of informal caregivers about daily experience in caring for the dependent elderly; [Percepções de cuidadores informais sobre a experiência quotidiana no cuidado ao idoso dependente]},
	year = {2022},
	journal = {New Trends in Qualitative Research},
