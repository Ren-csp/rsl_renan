	affiliations = {Key Laboratory of Cold Region Urban and Rural Human Settlement Environment Science and Technology, Ministry of Industry and Information Technology, School of Architecture, Harbin Institute of Technology, Harbin, China; UCL Institute for Environmental Design and Engineering, University College London (UCL), London, United Kingdom},
	abstract = {This study investigated the effect of a fragrant tree on the perception of traffic noise, aiming to reveal the interaction between odour and sound in urban environment. Field research investigations including on-site measurement and questionnaire distribution were conducted in two conditions (with and without fragrance) in four streets in Harbin, China, where lilac had been planted. The results showed that fragrance could affect the perception of traffic noise, which was reflected in increased overall comfort of the street, decreased annoyance caused by traffic noise, and improvement in auditory and olfactory satisfaction. The subjective evaluation of a street where double rows of lilac were planted was superior to that of single-row streets, and a decrease in traffic noise annoyance was more evident when the streets had lower traffic noise levels. The study also found that the higher the congruency of the fragrance and the environment, the more comfortable and less annoyed people were. Finally, familiarity, preference, and subjective intensity of fragrance did not correlate with overall comfort or traffic noise annoyance. © 2019 Elsevier Ltd},
