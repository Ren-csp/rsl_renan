}

@ARTICLE{Zhou2025,
	author = {Zhou, Wei and Ong, Ghim Ping and Dai, Fangzhou},
	title = {Understanding the role of perceived and physical environments in older adults’ physical activity: Toward more inclusive and resilient cities},
	year = {2025},
	journal = {Sustainable Cities and Society},
	volume = {134},
	pages = {},
	doi = {10.1016/j.scs.2025.106954},
	url = {https://www.scopus.com/pages/publications/105020853517?origin=resultslist},
	affiliations = {Department of Civil & Environmental Engineering, National University of Singapore, Singapore, 117576, Singapore; NUS Cities, National University of Singapore, Singapore, 117566, Singapore},
	abstract = {As cities worldwide confront rapid population aging and rising public health risks, promoting physical activity among older adults has become a critical priority for fostering inclusive and resilient urban environments. Addressing a key research gap that often separates subjective perceptions from objective environmental assessments, this study integrated self-reported survey data with geospatial datasets to evaluate both perceived and physical built environment (BE) characteristics. We conducted a case study in Singapore and investigated the associations between the environmental factors and older adults’ physical activity frequency under both routine (pre-COVID-19) and disruptive (during COVID-19) conditions, as well as the extent of activity decline between these two periods. Using exploratory factor analysis (EFA), we reduced dimensionality and distilled perceived and physical BE variables into five latent factors each. Ordered generalized additive models (GAMs) were then applied to capture potential nonlinear relationships between these factors and activity levels. The results reveal that both perceived and physical BE factors exhibit distinct nonlinear relationships, including saturation thresholds, convex, and concave patterns. Crucially, features such as access to urban amenities, greenspaces, and pedestrian infrastructure emerged as resilient environmental attributes, mitigating declines in activity during the pandemic. These findings underscore the importance of identifying optimal levels of environmental features for effective, targeted policy interventions. The study provides empirical evidence to inform the development of age-friendly cities and the enhancement of urban resilience in the face of public health emergencies, offering practical implications for designing inclusive and resilient urban environments. © 2025},
	author_keywords = {Built environment; Exploratory factor analysis; Older adults; Ordered generalized additive model; Physical activity; Urban resilience},
	keywords = {Additives; Factor analysis; Health risks; Public health; Public risks; Urban growth; Built environment; Exploratory factor analyze; Factors analysis; Generalized additive model; Non-linear relationships; Older adults; Ordered generalized additive model; Physical activity; Urban environments; Urban resilience; adult; health risk; physical activity; public health; urban area; Multivariant analysis},
	correspondence_address = {G.P. Ong; Department of Civil & Environmental Engineering, National University of Singapore, Singapore, 117576, Singapore; email: ceeongr@nus.edu.sg},
	publisher = {Elsevier Ltd},
	issn = {22106707},
	language = {English},
	abbrev_source_title = {Sustainable Cities Soc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Lyu2025,
	author = {Lyu, Yijie and Tang, Zhongan and Li, Yalun and Liu, Baoju and Deng, Min and Wu, Guohua},
	title = {A Multi-Agent Deep Reinforcement Learning Method with Diversified Policies for Continuous Location of Express Delivery Stations Under Heterogeneous Scenarios},
	year = {2025},
	journal = {ISPRS International Journal of Geo-Information},
	volume = {14},
	number = {12},
	pages = {},
	doi = {10.3390/ijgi14120461},
	url = {https://www.scopus.com/pages/publications/105026785078?origin=resultslist},
	affiliations = {School of Geosciences and Info-Physics, Central South University, Changsha, 410083, China; The Third Surveying and Mapping Institute of Hunan Province, Changsha, 410018, China; Hunan Geospatial Information Engineering and Technology Research Center, Changsha, 410018, China; School of Automation, Central South University, Changsha, 410083, China},
	abstract = {Rational location planning of express delivery stations (EDS) is crucial for enhancing the quality and efficiency of urban logistics. The spatial heterogeneity of logistics demand across urban areas highlights the importance of adopting a scientific approach to EDS location planning. To tackle the issue of strategy misalignment caused by heterogeneous demand scenarios, this study proposes a continuous location method for EDS based on multi-agent deep reinforcement learning. The method formulates the location problem as a continuous maximum coverage model and trains multiple agents with diverse policies to enable adaptive decision-making in complex urban environments. A direction-controlled continuous movement mechanism is introduced to facilitate an efficient search and high-precision location planning. Additionally, a perception system based on local observation is designed to rapidly capture heterogeneous environmental features, while a local–global reward feedback mechanism is established to balance localized optimization with overall system benefits. Case studies conducted in Fuzhou, Fujian Province and Shenzhen, Guangdong Province, China, demonstrate that the proposed method significantly outperforms traditional heuristic methods and the single-agent deep reinforcement learning method in terms of both coverage rate and computational efficiency, achieving an increase in population coverage of 9.63 and 15.99 percentage points, respectively. Furthermore, by analyzing the relationship between the number of stations and coverage effectiveness, this study identifies optimal station configuration thresholds for different urban areas. The findings provide a scientific basis for investment decision-making and location planning in EDS construction. © 2025 by the authors.},
	author_keywords = {continuous location; continuous maximum coverage; express delivery station location; heterogeneous demand scenario; marginal effect analysis; multi-agent deep reinforcement learning; urban logistics},
	correspondence_address = {B. Liu; School of Geosciences and Info-Physics, Central South University, Changsha, 410083, China; email: baojuliu@csu.edu.cn},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {22209964},
	language = {English},
	abbrev_source_title = {ISPRS Int. J. Geo-Inf.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

