@ARTICLE{Orlando201845,
	author = {Orlando, Giovanni},
	title = {Offsetting Risk: Organic Food, Pollution, and the Transgression of Spatial Boundaries},
	year = {2018},
	journal = {Culture, Agriculture, Food and Environment},
	volume = {40},
