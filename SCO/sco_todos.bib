	url = {https://www.scopus.com/pages/publications/105038845902?origin=resultslist},
	affiliations = {Thrust of Urban Governance and Design, The Hong Kong University of Science and Technology (Guangzhou), Guangzhou, China},
	abstract = {From Cullen's ‘serial vision’ to contemporary placemaking, design theories suggest that memorable urban experiences are crafted through visual contrast and sequence. Street View Imagery (SVI) has become a powerful resource for large-scale assessment of urban visual qualities; however, SVI-based studies largely assess cities as isolated snapshots, overlooking that urban perception is formed along continuous trails where transitions between scenes matter as much as the scenes themselves. This study introduces a framework for quantifying visual heterogeneity, defined as the spatial variation of visual characteristics across sequential viewpoints along street corridors, and examines its relationship with human perception. Using 68,946 SVI samples from Guangzhou's central districts, we quantify six visual indicators (greenness, openness, enclosure, walkability, complexity, and color tone) and measure heterogeneity at both neighborhood (500 m) and streetscape (50 m) scales along street networks. Human perceptions are captured from two million geotagged Weibo check-ins, with perception scores extracted through LLM. Machine learning models test predictive power against conventional static indicators. Results reveal two key findings: First, areas with higher visual heterogeneity coincide with attractive destinations such as commercial centers, cultural quarters, and waterfront promenades, while homogeneous environments elicit weaker engagement. Second, heterogeneity measures outperform static indicators in predicting human perception, demonstrating that transitions across urban scenes provide superior explanatory power. By bridging design theories with scalable computational methods, this framework offers an evidence-based tool to diagnose urban environments and enhance qualities that make cities emotionally resonant and socially vibrant. © 2026 Elsevier Ltd.},
	author_keywords = {Computational urban design; Human perception; Sequential urban experience; Street view imagery; Visual heterogeneity},
	keywords = {China; Guangdong; Guangzhou; heterogeneity; image analysis; perception; performance assessment; quantitative analysis; remote sensing; spatial variation; urban area; urban design},
