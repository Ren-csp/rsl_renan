@ARTICLE{Prabhat2020,
	author = {Prabhat, Abhilash and Malik, Indu and Jha, Neelu Anand and Bhardwaj, Sanjay Kumar and Kumar, Vinod},
	title = {Developmental effects of constant light on circadian behaviour and gene expressions in zebra finches: Insights into mechanisms of metabolic adaptation to aperiodic environment in diurnal animals},
	year = {2020},
	journal = {Journal of Photochemistry and Photobiology B: Biology},
	volume = {211},
	pages = {},
	doi = {10.1016/j.jphotobiol.2020.111995},
	url = {https://www.scopus.com/pages/publications/85089695527?origin=resultslist},
