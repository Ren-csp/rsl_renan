@ARTICLE{Mao2026,
	author = {Mao, Yao and Yang, Xiaoxia and He, Bao-Jie and Wei, Guoen},
	title = {Emerging heat resilience demands among tourist destinations for building responsible tourism: An empirical investigation in 291 A-level scenic spots in Chongqing, China},
	year = {2026},
	journal = {Urban Climate},
	volume = {67},
	pages = {},
	doi = {10.1016/j.uclim.2026.102877},
	url = {https://www.scopus.com/pages/publications/105035065899?origin=resultslist},
	affiliations = {School of Geographical Sciences, Southwest University, Chongqing, 400715, China; Centre for Climate–Resilient and Low–Carbon Cities, School of Architecture and Urban Planning, Key Laboratory of New Technology for Construction of Cities in Mountain Area, Ministry of Education, Chongqing University, Chongqing, 400045, China; CMA Key Open Laboratory of Transforming Climate Resources to Economy, Chongqing, 401147, China; School of Architecture, Design and Planning, The University of Queensland, Brisbane, 4072, Australia; School of Resources and Environment, Nanchang University, Nanchang, 330031, China; Leverhulme Centre for Anthropocene Biodiversity, University of York, York, YO10 5DD, United Kingdom},
	abstract = {Extreme heat, a new normal challenge globally, not only poses serious impacts to urban environments and humanity but also exacerbates the needs of tourism industry to build heat-resilient and responsible systems. However, existing explorations on heat resilience are mostly contextualized in cities, while limited studies have been conducted in scenic spot areas. This leads to a lack of understanding of how to build responsible tourism systems, making it impossible to provide accurate and fair recommendations for scenic spots and tourist groups. This study surveyed 291 A-level scenic spots in Chongqing, a typical hot and humid city in China, and utilized 1324 questionnaires to ascertain tourists' risk perceptions, prevention, responsive measures, and associated impacts. First, the results indicate that tourists exhibited a cognitive-behavioral gap at the overall cognitive level. Although tourists demonstrated strong willingness to act in terms of risk response (e.g., heat discomfort medical urgency, mean = 3.75) and prevention (e.g., weather forecast attention, mean = 3.50), their direct heat risk perception (e.g., heat health impact severity, mean = 3.12) was much lower. Prevention and responsive measures deviated due to inaccurate assessments of risk severity and amplified risks. Second, tourist demographic characteristics are key drivers shaping cognitive and behavioral patterns. Tourists with poorer health exhibited higher levels of concerns on risk perception, prevention, and response. However, educational attainment was significantly negatively correlated with risk perception and preventive behaviors; highly educated individuals, overconfident in their knowledge, tended to overlook potential risks. Age was positively correlated with preventive measures, with older tourists being more cautious. Third, from a spatial and demand perspective, heat risks were widespread, with tourists' sensitivity highly concentrated. Tourists in all six types of scenic spots experienced moderate to severe heat-related hazards (average score for all indicators >3.0), making heat a widespread tourism environmental issue. Tourists' sensitivity to governmental (mean = 3.17) and scenic spot demands (mean = 3.09) were significantly higher than adjusting their own behaviors (e.g., travel periods during heat, mean = 3.04, p < 0.001). Compared to physical discomfort, tourists were more easily influenced by psychological and demand-related factors. Overall, this study advances knowledge of heat-resilient TDs under RT framework and provides implications for RT development. © 2026 Elsevier B.V.},
	author_keywords = {Heat resilience; Responsible tourism; Responsive measure; Risk perception; Risk prevention; Tourist destinations},
	correspondence_address = {B.-J. He; Centre for Climate–Resilient and Low–Carbon Cities, School of Architecture and Urban Planning, Key Laboratory of New Technology for Construction of Cities in Mountain Area, Ministry of Education, Chongqing University, Chongqing, 400045, China; email: baojie.he@cqu.edu.cn},
	publisher = {Elsevier B.V.},
