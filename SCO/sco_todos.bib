@ARTICLE{Nogueira202364,
	author = {Nogueira, Caio Vinícius Russo},
	title = {Writing sensations, inscribing affections: notes for a minor literary theory according to Gilles Deleuze; [Escrever sensações, inscrever afectos: notas para uma teoria literária menor segundo Gilles Deleuze]},
	year = {2023},
