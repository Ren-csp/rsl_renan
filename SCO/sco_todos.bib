	year = {2019},
	journal = {Urban Forestry and Urban Greening},
	volume = {41},
	pages = {118 - 126},
	doi = {10.1016/j.ufug.2019.03.015},
	url = {https://www.scopus.com/pages/publications/85063648057?origin=resultslist},
	affiliations = {Center for Urban Resilience, Loyola Marymount University, Research Annex 119, 1 LMU Drive, Los Angeles, 90045, CA, United States; Department of Landscape Architecture and Regional Planning, University of Massachusetts – Amherst, 210 Design Building, 551 North Pleasant Street, Amherst, 01003-2901, MA, United States},
	abstract = {Urban parks are a vital resource. They provide a wealth of benefits that support the health and well-being of the people who use them and the ecosystems in which they reside. In densely populated cities, parks are often the only nearby natural resource for local residents to engage with and learn about the environment. Place attachment—individuals’ psychological and emotional connection to their local parks and natural areas—has been shown to be a precursor to engaging in volunteer stewardship activities. Yet the place attachment research to date has largely focused on non-urban recreation settings, such as national parks, leaving a large gap in understanding place attachment in urban settings and on smaller scales. This paper describes the results of a study conducted in the Baldwin Hills Parklands, a multi-use park system located in densely populated Los Angeles, CA, USA. A survey of 287 visitors revealed high levels of place attachment across the Parklands, and frequency of use was positively associated with level of place attachment. Among the highest rated sentiments were feelings of safety and peacefulness. Unexpectedly, drivers expressed greater attachment than those arriving on foot or other means of transportation. Visitors with higher place attachment were also more likely to be willing to participate in volunteer stewardship. Renters and lower-middle income visitors expressed lower levels of place attachment than homeowners and upper income visitors, while Latinx visitors had higher place attachment than non-Latinx visitors. The paper discusses the findings and their implications for management and future research on place attachment in urban parks. © 2019},
	author_keywords = {Environmental stewardship; Park access; Park equity; Place attachment; Urban green space},
	keywords = {California; Los Angeles [California]; United States; esthetics; greenspace; low income population; perception; public access; public attitude; urban ecosystem},
	correspondence_address = {M. Romolini; Center for Urban Resilience, Loyola Marymount University, Los Angeles, Research Annex 119, 1 LMU Drive, 90045, United States; email: michele.romolini@lmu.edu},
	publisher = {Elsevier GmbH},
