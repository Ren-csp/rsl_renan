	affiliations = {School of Architecture and Urban Planning, Guangdong University of Technology, Guangzhou, China; South China University of Technology, School of Architecture, Guangzhou, China},
	abstract = {In high-density urban environments, school routes are not merely transport corridors but also key everyday spaces where children socialize and perceive the city. To address the scale bias in existing studies that largely rely on driver-view street imagery (GSV), this study develops an evaluation framework that integrates Self-Photographed pedestrian-view images (SPPV) with the Method of Empathy-Based Stories (MEBS). Using semantic segmentation, we extract street-level environmental features, and then combine Random Forest and Elastic Net Regression (ENR) to conduct large-scale measurement of child-friendliness along school routes and to unpack its driving mechanisms. The results show that: (1) child-friendliness along school routes in Guangzhou exhibits pronounced spatial differentiation (new community landscape > old community landscape > urban village landscape), and the distinct morphological characteristics of each landscape typology shape different environmental weaknesses; (2) the analysis of these spatial features indicates that walkways and natural elements are the most critical positive drivers, whereas electric bicycle intrusion and an excessively high degree of spatial enclosure exert significant negative effects on children's perceptions. By highlighting the specific environmental factors that shape children's everyday spatial experiences, this study argues for a shift from a vehicle-based to a pedestrian approach, and from engineering-oriented delivery to people-centered governance. It further proposes that child-friendly school routes should be reshaped through differentiated spatial repair and affordance-based design. © 2026 Elsevier Ltd},
	author_keywords = {Child-friendly city; Machine learning; Method of empathy-based stories; School route; Self-photographed pedestrian view},
