@ARTICLE{Sharova202657,
	author = {Sharova, Veronika L.},
	title = {Remember and Reuse. Spatial Memory and Emotional Value of Post-socialist Public Spaces},
	year = {2026},
	journal = {Journal of Public Space},
	volume = {11},
	number = {1},
	pages = {57 - 74},
	doi = {10.32891/jps.v11i1.1893},
	url = {https://www.scopus.com/pages/publications/105043227488?origin=resultslist},
	affiliations = {Germany},
	abstract = {The legacy of socialist architecture and urban planning in Europe is worthy of attention not only from the point of view of its historical significance but also in the context of modern “culture wars” or “memory wars,” which are a recognizable feature of modern socio-political life. Using the example of a specific location, the Ernst-Thälmann-Park in Berlin, the article examines the problem of perception of this heritage of European urbanism of the 20th century. This location in eastern Berlin remains the subject of residents' emotional experiences and discussions about the memory of the place revolves around both the demolished gas storage buildings, on the site of which a park was created during the socialist era and the central square with its monument. Nowadays, the residential area with the central square is popular among the locals, combining symbolic and practical aspects. It is emphasised that within the framework of socialist urbanism, the creation of public spaces received considerable attention. This was rooted in the ideological foundations of the socialist system: the dominance of the public over the individual and the values of centrally organized social practices. The collapse of the Eastern Bloc resulted in numerous transformations in political institutions, in the economy, in social relations. These transformations also impacted strategies and practices in urban planning, construction and architecture: the planned economy was replaced by free market, and ideological foundations blurred. At the same time, “places and spaces of memory” emotionally linked to the socialist era are being revised, and the discussion on the value of this architecture is going on. The spatial aspects of this debate are particularly evident in urban environments, given the high diversity of urban communities and the specific nature of urban life: politically competitive and agonistic. © 2026, City Space Architecture. All rights reserved.},
