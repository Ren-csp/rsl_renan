@ARTICLE{Pasgaard2025,
	author = {Pasgaard, Maya and Breed, Christina and Engemann, Kristine and Brom, Peta},
	title = {Connecting urban green infrastructure and environmental justice in South Africa: Integrating social access, ecology, and design},
	year = {2025},
