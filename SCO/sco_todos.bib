@ARTICLE{Gebremariam2026,
	author = {Gebremariam, Dmtsu and Gebrehiwet, Ataklti and Grum, Berhane and Asfha, Birhane Araya and Abebe, Bizuneh Asfaw},
	title = {Disability and urban mobility: towards inclusive transport in Mekelle},
	year = {2026},
	journal = {Case Studies on Transport Policy},
	volume = {25},
	pages = {},
	doi = {10.1016/j.cstp.2026.101844},
	url = {https://www.scopus.com/pages/publications/105038931599?origin=resultslist},
	affiliations = {Mekelle University, Faculty of Civil and Environmental Engineering, Ethiopia},
	abstract = {This study examines the accessibility of urban mobility infrastructure and transport services for people with disabilities in Mekelle city, Ethiopia, using a mixed-methods approach that combines perception surveys, on-site accessibility assessments, and review of relevant policy and legal frameworks. Relative Importance Index (RII) was used to evaluate perceived accessibility levels of key mobility infrastructure elements, while the Severity Index (SI) assessed the impacts of accessibility barriers on the daily mobility, livelihood, and participation of people with disabilities. The results show consistently low accessibility ratings across critical components of the urban mobility system, including sidewalks, pedestrian crossings and intersections, public buildings, and public transport vehicles and stops, with RII values below 0.39. SI results indicate significant negative impacts (SI ' 80%) on mobility independence, safety, employment opportunities, and access to essential services. A strong negative correlation (r = -0.87) between RII and SI values further confirms the relationship between low accessibility and increased mobility challenges. Field-based accessibility assessments support these findings, revealing narrow and obstructed sidewalks, inaccessible pedestrian crossings, and limited compliance of public buildings and transport services with accessibility standards. Public transport vehicles present physical and operational barriers for people with disabilities, especially for wheelchair users. Although Ethiopia has adopted policies and legal frameworks supporting accessibility and the rights of people with disabilities, accessibility challenges remain widespread in Mekelle. Strengthening the implementation of existing policies and accessibility standards, improving the accessibility of mobility infrastructure and public transport services are important measures to improve inclusive mobility. Moreover, encouraging the participation of people with disabilities in planning and monitoring mobility systems can help ensure that transport services better respond to their needs. These measures are essential for improving the mobility, independence, and social participation of people with disabilities in urban environments. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Accessibility; Disability; Inclusion; Urban mobility},
	keywords = {Ethiopia; Mekelle; accessibility; disability; pedestrian; perception; public transport; social participation; transportation infrastructure; urban area},
