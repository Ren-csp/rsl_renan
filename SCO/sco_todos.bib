}

@ARTICLE{Devereux2022,
	author = {Devereux, Kim},
	title = {Embracing Uncertainty: How literary writing helps us change our minds},
	year = {2022},
	journal = {Frontiers in Psychology},
	volume = {13},
	pages = {},
	doi = {10.3389/fpsyg.2022.1019987},
	url = {https://www.scopus.com/pages/publications/85140600489?origin=resultslist},
	affiliations = {The Department of English and Creative Writing, University of Exeter, Exeter, United Kingdom},
	abstract = {Creative writing and cognitive neuroscience can jointly illuminate how literary writing can change our minds by enhancing our tolerance for uncertainty. From my perspective as a novelist, I will show how literary writing hijacks the mechanisms of day-to-day perception and orchestrates cognition to facilitate vividness of (imaginary) experience and insight. Drawing on examples from my novel and other research, I will discuss the role of uncertainty and literary devices such as contradiction and paradox in stymieing habitual assumptions while inviting the reader’s sensory imagination and conscious awareness, thereby creating an open space for insight. I hypothesize that literary writing promotes a form of dual cognition that involves both sensory experience and detachment, is therapeutic, and may share some of the benefits of mindfulness. Copyright © 2022 Devereux.},
	author_keywords = {blindness; cognitive dissonance; contradiction; insight; literary novel; mindfulness; paradox; uncertainty},
	correspondence_address = {K. Devereux; The Department of English and Creative Writing, University of Exeter, Exeter, United Kingdom; email: kim@kimdevereux.co.uk},
	publisher = {Frontiers Media S.A.},
