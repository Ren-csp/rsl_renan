@ARTICLE{Silva-Fernández2025,
	author = {Silva-Fernández, Claudia S. and Pabón-Poches, Daysy K. and Barchelot-Aceros, Laura J. and Ramírez-Sierra, Yuly A.},
	title = {Psychosocial factors of premeditated and impulsive aggressive behavior: Explanatory analysis in adolescents from Colombia; [Factores psicosociales de la conducta agresiva premeditada e impulsiva: Análisis explicativo en adolescentes de Colombia]},
	year = {2025},
