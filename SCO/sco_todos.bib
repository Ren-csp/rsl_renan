@ARTICLE{Chen2024,
	author = {Chen, Siting and He, Pingge and Yu, Bingjie and Wei, Dong and Chen, Yang},
	title = {The challenge of noise pollution in high-density urban areas: Relationship between 2D/3D urban morphology and noise perception},
