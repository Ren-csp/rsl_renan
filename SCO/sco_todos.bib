	pages = {},
	doi = {10.1007/s11252-025-01715-5},
	url = {https://www.scopus.com/pages/publications/105003245485?origin=resultslist},
	affiliations = {Facultad de Ciencias Biológicas, Pontificia Universidad Católica de Chile, Santiago, Chile; Center for Sustainable Landscapes Under Global Change (SustainScapes), Department of Biology, Aarhus University, Aarhus, Denmark; Department of Biology, Ecoinformatics and Biodiversity, Aarhus University, Aarhus, Denmark; Facultad de Ciencias Biológicas, Universidad Austral, Valdivia, Chile; Center of Applied Ecology and Sustainability (CAPES), Santiago, Chile; Instituto Milenio en Socio-Ecología Costera SECOS, Santiago, Chile},
	abstract = {Humans rely on nature for their well-being. Urbanization has reduced direct contact with natural biodiversity, replacing it with exposure to urban biodiversity, which may still support a connection with nature. Coastal urban areas, where marine, terrestrial, and human-modified environments meet, are unique interfaces supporting marine and terrestrial bird species, allowing the public to encounter them in unexpected, mixed habitats. While evidence suggests public appreciation for birds, the perceived value of birds in human-modified settings may vary. In this study, we surveyed public perceptions of marine and terrestrial birds in coastal urban environments of central Chile, with locations varying in their levels of human intervention and proximity to the coast. Results indicated that respondents generally valued bird presence in urban coastal settings; however, perceptions differed depending on the bird species and the environment in which they were observed. No bird species consistently achieved high satisfaction levels across all settings; rather, satisfaction was contingent on the specific environment in which a species was encountered. The perceived naturalness of species within certain marine or terrestrial habitats shapes public expectations of where specific species should be observed and influences satisfaction levels. Our findings highlight the central role of perceived naturalness in shaping public satisfaction with bird encounters, emphasizing the importance of public expectations of where specific species should be observed. Satisfaction with bird encounters was influenced by other factors, including species recognition and early-life exposure to nature, highlighting the complex interplay between personal experience and biodiversity perceptions. Integrating public perceptions into conservation planning can help design urban spaces that enhance ecological integrity and human well-being. © The Author(s) 2025.},
	author_keywords = {Coastal birds; Coastal environments; Coastal urbanization; Public perceptions; Public satisfaction},
	correspondence_address = {G. Graells; Facultad de Ciencias Biológicas, Pontificia Universidad Católica de Chile, Santiago, Chile; email: gygraell@uc.cl},
