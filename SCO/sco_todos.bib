	title = {Cemeteries as Sustainable Elements of Urban Green Space: Legal, Ecological, and Spatial Perspectives from Central and Eastern Europe},
	year = {2026},
	journal = {Sustainability (Switzerland)},
	volume = {18},
	number = {1},
