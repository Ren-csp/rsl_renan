	url = {https://www.scopus.com/pages/publications/105033485315?origin=resultslist},
	affiliations = {Department of Architecture, Thailand; Centre of Sustainable Urban Planning & Real Estate, Faculty of Built Environment, UNIVERSITI MALAYA, KUALA LUMPUR, 50603, Malaysia; Institute of Biological Sciences, Faculty of Science, UNIVERSITI MALAYA, KUALA LUMPUR, 50603, Malaysia},
	abstract = {Insufficient outdoor activity leads to physical inactivity, endangering the physical and mental wellbeing of urban residents. This is particularly evident in urban universities within hot-humid climates, where a prevalence of sedentary indoor lifestyles has been linked to increased depression and stress among campus users. Stimulating pleasant sensory experiences can enhance interactive participation in campus green spaces, thereby fostering wellbeing. While the structure of sensory perception plays a crucial role in shaping these outdoor experiences, limited research has explored its multi-sensory dimensions in campus open spaces. This study aims to identify the multi-sensory dimensions of environmental perception in these areas. Using on-site observations and interviews, the research elaborates on the phenomenology of environmental perception. The findings identify key landscape properties and sensory attributes specific to campus open spaces in hot-humid urban universities and establish that these multi-sensory dimensions are positively associated with improved outdoor experiences. However, the tangible manifestation of user engagement stimulated by multi-sensory perception remains uncertain. Further research should, therefore, explore user participation within these environmental settings to facilitate optimal utilisation. © 2025, by MIP.},
	author_keywords = {Campus open space; multi-sensory perception; outdoor experience; urban university; wellbeing},
