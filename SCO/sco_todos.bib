	year = {2026},
	journal = {Urban Forestry and Urban Greening},
	volume = {122},
	pages = {},
	doi = {10.1016/j.ufug.2026.129497},
	url = {https://www.scopus.com/pages/publications/105039253545?origin=resultslist},
	affiliations = {University of Belgrade, Faculty of Forestry, Department of Landscape Architecture and Horticulture, Kneza Višeslava 1, Belgrade, 11030, Serbia},
	abstract = {Gardening is widely recognized as one of the most common and valued leisure activities, associated with numerous health and well-being benefits, particularly in urban settings. However, research findings on its physical, psychological, and social impacts remain mixed. People’s experiences with gardening are often more complex than commonly assumed. This study aims to explore the perceived well-being benefits of urban vegetable gardening—specifically relaxation, physical, social, and psychological aspects—compared to other forms of leisure. It also examines differences in physical activity between urban vegetable gardeners and individuals engaged in other leisure activities, and investigates how gardeners’ perceived benefits vary across socio-demographic profiles. We surveyed 244 participants in urban and suburban areas of Belgrade, Serbia, comparing perceived benefits of leisure activities among vegetable gardeners (N = 134) and participants involved in other leisure activities (N = 110). Unexpectedly, urban vegetable gardeners reported lower perceived benefits in terms of relaxation and social dimensions compared to the control group. However, notable differences emerged between two subgroups of vegetable gardeners: older, experienced suburban home gardeners and younger urban gardeners, often engaged in community gardening. The latter reported higher psychological benefits and greater relaxation levels than traditional peri-urban gardeners. Socio-demographic characteristics were also significantly associated with how urban vegetable gardeners perceived the benefits of their activity. These findings suggest that vegetable gardens can provide meaningful leisure experiences tailored to individual needs and life stages, particularly in urban environments. © 2026 Elsevier GmbH.},
	author_keywords = {Green space; Leisure; Recreation; Restorative; Urban gardening; Vegetable gardens},
	keywords = {Belgrade; Serbia; garden; greenspace; leisure and recreation; local participation; perception; physical activity; vegetable},
	correspondence_address = {S. Čepić; University of Belgrade, Faculty of Forestry, Department of Landscape Architecture and Horticulture, Belgrade, Kneza Višeslava 1, 11030, Serbia; email: slavica.cepic@sfb.bg.ac.rs},
