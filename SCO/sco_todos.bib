@ARTICLE{Muldoon2026,
	author = {Muldoon, Maura C. and Galford, Gillian L. and Gould, Rachelle K.},
	title = {Perception of interconnectedness: a new typology and tools across disciplines},
	year = {2026},
	journal = {Sustainability Science},
