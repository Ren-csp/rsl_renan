	pages = {1 - 17},
	doi = {10.1109/TGRS.2025.3645784},
	url = {https://www.scopus.com/pages/publications/105025402658?origin=resultslist},
	affiliations = {Wuhan University, State Key Laboratory of Information Engineering in Surveying, Mapping and Remote Sensing, Wuhan, 430072, China; Hubei Luojia Laboratory, Wuhan, 430079, China; Massey University, School of Mathematical and Computational Sciences, Auckland, 0632, New Zealand; University of Nottingham Ningbo China, School of Computer Science, Ningbo, 315100, China},
	abstract = {Photogrammetric point clouds have emerged as a cost-effective solution to urban environment perception and scene understanding, significantly advancing recent research in urban-scale 3-D semantic segmentation. In contrast to well-explored indoor and road scenes, urban-scale photogrammetric point clouds exhibit more complex spatial geometries, richer texture details, and pronounced multiscale disparities between background environments and foreground objects. These challenges demand neural networks with enhanced spatial, low-level, and multiscale learning capabilities. To address these issues, we propose the multiscale pyramid network (MSPNet), a conceptually streamlined, end-to-end network for semantic segmentation of urban scenes. The proposed MSPNet comprises three key components: 1) the ellipsoid spherical position embedding (ESPE) module, which leverages learnable ellipsoid queries and spherical harmonics (SHs), rather than using a fixed ball query and a linear combination of spatial coordinates, to explicitly model position embeddings and effectively capture intricate geometric relationships; 2) the top-down information retrospection (TDIR) module, which establishes hierarchical semantic guidance through retrospective pathways, enhancing structural consistency across features at different levels; and 3) the low-rank adaptation (LoRA) fusion module, which applies matrix rank constraints during multiscale feature fusion to decompose high-level semantics into low-rank subspaces, alleviating multiscale semantic confusion. We have conducted extensive experiments on several established urban-scale photogrammetric point cloud segmentation benchmarks, including HRHD-HK, SensatUrban, and UrbanBIS. The experimental results demonstrate that MSPNet achieves significant improvements across these benchmarks, highlighting the superior ability to accurately segment urban scenes and the potential to advance urban environment perception and scene understanding. © 1980-2012 IEEE.},
	author_keywords = {Multiscale fusion; photogrammetry; point cloud; semantic segmentation; urban scene},
	keywords = {Cost effectiveness; Embeddings; Learning to rank; Neural networks; Query processing; Semantic Segmentation; Semantic Web; Semantics; Textures; Urban planning; Environment perceptions; Multi-Scale pyramids; Multi-scales; Multiscale fusion; Point-clouds; Pyramid network; Semantic segmentation; Urban environments; Urban scale; Urban scenes; perception; photogrammetry; segmentation; semantic standardization; spherical harmonics; urban atmosphere; Photogrammetry},
