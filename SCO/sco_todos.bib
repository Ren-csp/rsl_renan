	doi = {10.1016/j.scs.2025.106562},
	url = {https://www.scopus.com/pages/publications/105009238748?origin=resultslist},
	affiliations = {Key Laboratory of Road and Traffic Engineering of the Ministry of Education, Tongji University, Shanghai, 201804, China; Logistics Engineering and Management, Tsinghua University, Beijing, 100084, China; Jinan Rail Transit Group Company Limited, No.5 Jiefang East Road, Lixia District, Shandong, Jinan, 250014, China},
	abstract = {Extreme weather events driven by climate change pose significant threats to human security and result in severe economic and social impacts, with flooding being the most prominent. In response to these challenges, this paper investigates the determinants influencing residents’ evacuation decisions and explores the heterogeneity between utility and regret decision rules in the context of predictable flood hazards. A significant innovation of this work is the development of an enhanced hybrid utility-regret approach applied to flood evacuation decision research. We propose an integrated choice and latent variables (ICLV) model framework based on the multinomial Logit model and the structural equation model (SEM). Furthermore, we conduct an in-depth analysis of willingness-to-pay (WTP) for various evaluation attributes. The SEM results reveal that risk perception is the dominant driver of evacuation intention for the proactive group, while safety awareness governs the decisions of non-evacuees. Utility-driven models demonstrate 2.2 times more influence on decision behavior than regret-driven models for evacuees-keen, with a 30-minute travel reduction increasing evacuation likelihood by 10.5 % (RUM-1) compared to 4.8 % (GRRM-SD). The ICLV model achieves superior goodness-of-fit (Mc-R-squared = 0.077 vs. 0.048–0.053 in benchmark models), confirming its capacity to capture hybrid decision mechanisms and integrate psychological factors. WTP analyses further validate evacuees' preference for low-risk scenarios, prioritizing safer evacuation methods (17.99-minute WTP for a 1 % safety gain) and fewer intermediate stops. These findings illuminate the motivations underlying evacuation decision behavior, aiding in the development of tailored strategies to mitigate the adverse impacts of future flood events and promote sustainable urban development. © 2025},
	author_keywords = {Evacuation decision; Flood hazards; Hybrid utility-regret approach; Integrated choice latent variable (ICLV); Structural equation model (SEM); Urban environment},
	keywords = {Behavioral research; Climate change; Economic and social effects; Emergency traffic control; Flood control; Floods; Hazards; Risk assessment; Risk perception; Sustainable development; Decision rules; Evacuation decision; Flood hazards; Hybrid utility-regret approach; Integrated choice latent variable; Latent variable; Structural equation model; Structural equation models; Urban environments; Willingness to pay; computer simulation; decision making; flood damage; flood forecasting; flooding; hazard assessment; health and safety; heterogeneity; integrated approach; numerical model; research work; socioeconomic impact; urban area; urban population; willingness to pay; Urban growth},
