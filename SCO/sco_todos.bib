	year = {2025},
	journal = {Building and Environment},
	volume = {285},
	pages = {},
	doi = {10.1016/j.buildenv.2025.113544},
	url = {https://www.scopus.com/pages/publications/105013476099?origin=resultslist},
	affiliations = {College of Architecture and Urban Planning, Tongji University, Shanghai, 200092, China; Key Laboratory of Ministry of Education of High Density Human Settlements, Ecology and Energy Conservation, Shanghai, 200092, China; Institute of Future Lighting, Academy for Engineering & Technology, Fudan University, Shanghai, 200092, China},
	abstract = {Image-based display tasks are widely used to replicate real-world spatial stimuli in psychological experiments that investigate human responses to architectural and urban environments. However, inconsistencies in the physical properties of these stimuli may introduce experimental bias and undermine reproducibility. Current standardization methods are predominantly limited to unifying visual luminance, whereas the nonvisual effects of light remain unconsidered. To address this limitation, this study proposes a Spectral-Consistent Cross-Display Image Standardization (SCCD-IS) framework that unifies both visual and non-visual effects through standardized spectral properties of images. The proposed framework operates in two phases: (1) establishing the relationship between display grayscale values and spectral irradiance (SI) through a calibration-based acquisition method and (2) implementing a code-based standardization process for image conversion. To validate its effectiveness, a comprehensive set of evaluation metrics were introduced, quantifying both standardization errors and structural similarity between pre- and post-processed images. Therefore, SCCD-IS achieved a ± 0.5 % SI error and 0.90 mean Structural Similarity Index Measure (SSIM), surpassing histogram matching, which exhibited a − 5–0 % error range and 0.87 SSIM. Thus, SCCD-IS demonstrated superior performance in terms of standardization accuracy and semantic feature preservation. Such spectral-aware standardization holds broad potential for enhancing reproducibility in vision science and display-dependent human-computer interaction studies. © 2025},
	author_keywords = {Color image standardization; Cross-display calibration; Environmental psychology; Gamma correction; Non-visual effects; Spectral irradiance; Visual perception},
	keywords = {Color image processing; Color vision; Errors; Human computer interaction; Luminance; Semantics; Color image standardization; Colour image; Cross-display calibration; Display calibrations; Environmental psychology; Gamma correction; Image standardization; Non visuals; Non-visual effect; Spectral irradiance; Visual effects; Visual perception; accuracy assessment; architectural design; calibration; color; experimental study; irradiance; perception; psychology; standard (reference); visual cue; visualization; Calibration},
