@ARTICLE{Bose2026109,
	author = {Bose, Sukanya and Naskar, Mrinmoyee and Datta, Debajit},
	title = {Soundscape Ecology of a Rapidly Transforming Urban Environment: Insights from Rajarhat-New Town of Kolkata Metropolitan Area, India},
	year = {2026},
	journal = {Papers in Applied Geography},
	volume = {12},
	number = {1},
	pages = {109 - 124},
	doi = {10.1080/23754931.2025.2503206},
	url = {https://www.scopus.com/pages/publications/105005505037?origin=resultslist},
	affiliations = {Landscape Ecology Laboratory, Department of Geography, Jadavpur University, Kolkata, India; Department of Geography, Baruipur College, Baruipur, India},
	abstract = {This research aims to assess the soundscape ecology of the planned smart city of Rajarhat-New Town in India toward attaining sustainability in cityscape management. Average sound intensity patterns during the off-peak and peak traffic hours of a weekday were delineated. Sound-walks were carried out at representative transects across different LULCs to detect the frequency variations and classify those under generic soundscape components. Normalized Difference Soundscape Index (NDSI) values were computed for all LULCs to comprehend the city’s pulsation pattern. Subsequently, residents’ perception on the city’s soundscape dynamics were appraised through a questionnaire survey. Results showed that sound intensity patterns differed significantly (p < 0.001) across LULCs but insignificantly between the time slots. NDSI values were highest in vegetated areas (0.99) and lowest over waterbodies (0.53). Built-ups and barren lands were primarily characterized by geophony (bass: wind’s friction) and anthrophony (treble: car honking). Conversely, vegetated areas were dominated by geophony (bass: wind’s friction) and biophony (treble: animal vocalization). Residents opined that the area is not yet having any typical kind of sound identity but biophonic sources are gradually declining. Being part of a planned city, these losses would not be drastic and may be restored with appropriate landscape level interventions. © 2025 Applied Geography Conferences.},
	author_keywords = {Anthrophony; biophony; geophony; resident’s perception; urban blue-green space},
	correspondence_address = {D. Datta; Landscape Ecology Laboratory, Department of Geography, Jadavpur University, Kolkata, 700032, India; email: debajit.geo@gmail.com},
