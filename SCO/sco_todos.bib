@ARTICLE{Zeng20261,
	author = {Zeng, Ziyin and Chen, Honglin and Zhou, Jian and Li, Bijun and Wang, Ruili},
	title = {MSPNet: A Multiscale Pyramid Network for Semantic Segmentation of Urban-Scale Photogrammetric Point Clouds},
	year = {2026},
