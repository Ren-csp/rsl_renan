	volume = {220},
	pages = {},
	doi = {10.1016/j.landurbplan.2021.104351},
	url = {https://www.scopus.com/pages/publications/85122545082?origin=resultslist},
	affiliations = {Department of Architecture, National University of Singapore, Singapore},
	abstract = {Various auditory and non-auditory factors influence soundscape experiences in urban environments. However, there is little work for revealing their comprehensive impacts as a single systematic phenomenon; thus, the specification of the predominant factors for explaining the residential soundscapes and consequential satisfaction is still unclear. This study explores the overview of the residential pleasantness-eventfulness (PL-EV) soundscape as a single comprehensive phenomenon and determines prioritized factors for the residential soundscapes and satisfaction. A structural equation modeling (SEM) of the residential soundscape was constructed using perceptive status of audio (sound sources), visual (viewing cues), and emotional (mood) factors, adjusted for demographic confounders. The model was further extended to the impact of PL-EV soundscape qualities on the residential satisfaction evaluation. The influence of the neighborhood characteristics on the constructed soundscape SEM model was subsequently examined. The results showed that the audio-visual perceptions of the traffic and natural environments were substantially important indicators on the PL soundscape, whereas none of the audio-visual indicators showed unique importance for the EV soundscape. The PL soundscape was a highly important predictor for the residential satisfaction rather than the EV soundscape. The impact of the PL-EV soundscape qualities on the residential satisfaction differed by the residents’ neighborhood characteristics; thus, the importance and performance of the PL-EV soundscape constructs consequently differed. The results of this study provide insights into the preceding audio-visual factors for the residential soundscapes and consequential satisfaction, which supports the overarching view of the theoretical soundscape models used for diagnosing the reality in the residential environments. © 2021 Elsevier B.V.},
	author_keywords = {Audio-visual indicator; Importance-performance map analysis; Person-related factor; Satisfaction; Soundscape; Structural equation modeling},
	keywords = {environmental effect; least squares method; neighborhood; perception; performance assessment; prioritization; residential satisfaction; urban ecosystem},
