@ARTICLE{Winstead2026,
	author = {Winstead, Vicki and Pickering, Carolyn E and Browning, Wesley R and Bennett, Henrietta},
	title = {The role of reciprocity and gender in dementia caregiving on abusive and neglectful behaviors},
	year = {2026},
	journal = {Journals of Gerontology - Series B Psychological Sciences and Social Sciences},
	volume = {81},
	number = {8},
	pages = {},
	doi = {10.1093/geronb/gbag092},
	url = {https://www.scopus.com/pages/publications/105043786056?origin=resultslist},
	affiliations = {Department of Research Cizik School of Nursing, University of Texas Health Science Center Houston, Houston, TX, United States; Department of Psychology, University of Alabama at Birmingham, Birmingham, AL, United States},
	abstract = {Objectives: Reciprocity, a balanced exchange in interactions, is a crucial element of social exchanges and impacts caregiving outcomes. This paper aims to investigate whether perceived reciprocity plays a protective role against older adult abuse and neglect and to explore gender variations associated with this relationship. Methods: A sample of 453 family caregivers reported daily perceptions of reciprocity in a 21-day micro-longitudinal study. Perceived reciprocity was measured by the participant’s level of satisfaction with the amount of affection/appreciation shown by their relative with dementia in the previous 24 hr. Generalized linear mixed models examined the effect of perceived reciprocity on the odds of the caregiver engaging in psychologically aggressive, physically aggressive, and neglectful behaviors that day. Results: Perceived reciprocity was associated with lowered daily odds of neglect (OR = 0.74, p = 0.003) and psychological abuse (OR = 0.57, p < .001). We calculated an interaction term of the effects of gender and perceived reciprocity on abuse/neglect to assess gender differences. Increased reciprocity reduced the odds of neglect for both males and females, but the reduction was greater for males (p = 0.032). Discussion: Results suggest that receiving attention and affection for caregiving acts as a protective factor, particularly for male caregivers. While female caregivers face socially constructed role expectations, males, often taking on caregiving out of obligation, may benefit from reciprocal interactions that lower the risk of neglecting the care recipient. These insights contribute to a nuanced understanding of gender dynamics in caregiving to inform targeted interventions to prevent older adult abuse and neglect. © The Author(s) 2026. Published by Oxford University Press on behalf of the Gerontological Society of America. All rights reserved. For commercial re-use, please contact reprints@oup.com for reprints and translation