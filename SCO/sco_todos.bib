}

@ARTICLE{Alvim Barateiro2026,
	author = {Alvim Barateiro, Luísa and Silva, José Pedro and de Loyola González-Salgado, Ignacio and Ribeiro, Ana Isabel},
	title = {Gentrification, physical environment and perceived health: a combined visual and textual analysis from a photovoice study conducted in Porto, Portugal},
	year = {2026},
	journal = {Cities and Health},
	pages = {},
	doi = {10.1080/23748834.2025.2605419},
	url = {https://www.scopus.com/pages/publications/105030674577?origin=resultslist},
	affiliations = {EPIUnit ITR, Instituto de Saúde Pública da Universidade do Porto, Universidade do Porto, Porto, Portugal; Faculdade de Medicina da Universidade do Porto, Porto, Portugal; Faculdade de Letras da Universidade do Porto, Instituto de Sociologia da Universidade do Porto, Porto, Portugal; Department of Sociology, Pablo de Olavide University Sevilla, Seville, Spain; Departamento de Geografia, Faculdade de Letras da Universidade do Porto, Centro de Estudos em Geografia e Ordenamento do Território (CEGOT), Porto, Portugal},
	abstract = {Gentrification is transforming urban environments with significant implications for residents’ health. Recent research has highlighted that gentrification affects health through multiple pathways, including displacement and rising housing costs, often exacerbating urban health inequalities. This study assesses the public health impact of physical transformations associated with gentrification by conducting a combined analysis of visual and textual data generated through a photovoice study in Porto, Portugal, capturing residents’ perceptions and lived experiences. We conducted a content analysis of 458 photographs and discussion transcriptions produced during a photovoice study with 16 participants from gentrifying, deprived non-gentrifying, and affluent areas. Quantitative analysis of photographs was qualitatively compared and cross-checked with interview transcripts for each analytical category and subcategory. Most categories revealed both positive and negative transformations in the urban environment, with health impacts ranging from improved access to green spaces and public transportation to increased noise, air pollution, and housing insecurity. Some changes may bring long-term benefits while others result in health harms, illustrating the contradictory nature of gentrification’s health impacts. This research highlights the complex relationship between gentrification, physical environment changes, and public health, emphasizing the need for balanced policies that promote equitable urban regeneration and sustainability. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {gentrification; health inequalities; photovoice; Public health; urban health},
	correspondence_address = {L. Alvim Barateiro; EPIUnit ITR, Instituto de Saúde Pública da Universidade do Porto, Universidade do Porto, Porto, Rua das Taipas, nº 135, 4050-600, Portugal; email: luisabarateiro@gmail.com},
	publisher = {Routledge},
	issn = {23748834},
	language = {English},
	abbrev_source_title = {Cities Health},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Sarkar2026,
	author = {Sarkar, Asesh and Gemmell, Emily and P S, Surya and Anand, Sayna and Bhattacharya, Amit Ashok and Pujara, Tina},
	title = {Perceived quality and access to urban green spaces and loneliness in India},
	year = {2026},
	journal = {Cities and Health},
	pages = {},
	doi = {10.1080/23748834.2026.2686415},
	url = {https://www.scopus.com/pages/publications/105043355253?origin=resultslist},
	affiliations = {BMS College of Architecture, Design and Planning, Bengaluru, India; School of Population and Public Health, University of British Columbia, Vancouver, BC, Canada; Research Group ‘Happiness by Design’, Department of Architecture and Planning, Indian Institute of Technology Roorkee, Roorkee, India; Department of Architecture, TKM College of Engineering Kollam, Kollam, India; Amity School Architecture and Planning, Amity University, Mohali, India; Piloo Mody College of Architecture, Cuttack, India},
	abstract = {Amid rapid urbanisation and growing concerns about social isolation, urban green spaces are increasingly recognised as environments that may support mental well-being. However, existing research has largely focused on the physical availability and proximity of green spaces, with limited attention to how individuals’ perceptions of green space quality influence experiences of loneliness, particularly in rapidly urbanising contexts such as urban India. Addressing this gap, the present study examines how perceptions of accessibility, design quality, safety, and opportunities for social interaction in urban green spaces relate to loneliness. The study draws on a cross-sectional survey of 221 respondents from diverse demographic groups. Loneliness was measured using the UCLA Loneliness Scale, while perceptions of green spaces were assessed through a structured questionnaire. Correlation and regression analyses were conducted to examine associations between perceived green space characteristics and reported loneliness. The findings indicate a significant association between loneliness and negative perceptions of green spaces, particularly among women and younger individuals, suggesting that subjective experiences of urban environments may influence well-being strongly than spatial availability. Design attributes such as shaded seating and recreational opportunities show stronger associations with reduced loneliness than proximity alone, highlighting the importance of user-sensitive green space design in urban planning. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {accessibility; Green spaces; loneliness; perception; urban well-being},
	correspondence_address = {T. Pujara; Research Group ’Happiness by Design’, Department of Architecture and Planning, Indian Institute of Technology Roorkee, Roorkee, Haridwar Highway, Uttarakhand, 247667, India; email: tina.pujara@ar.iitr.ac.in},
	publisher = {Routledge},
	issn = {23748834},
	language = {English},
	abbrev_source_title = {Cities Health},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Yang2026,
	author = {Yang, Qinran and Hu, Xidan and Liu, Yanan and Yang, Linchuan},
	title = {Heterogeneous effects of neighborhood renewal on mental well-being: A capability approach to analyzing complex causal pathways},
	year = {2026},
	journal = {Applied Geography},
	volume = {186},
	pages = {},
	doi = {10.1016/j.apgeog.2025.103847},
	url = {https://www.scopus.com/pages/publications/105023383660?origin=resultslist},
	affiliations = {Department of Urban and Rural Planning, School of Architecture, Southwest Jiaotong University, Chengdu, China},
	abstract = {Neighborhood renewal is considered a strategy for reducing place-based health inequalities. However, evidence suggests that such interventions can produce uneven mental health impacts. Drawing on the capability approach, this study explains how sociodemographic characteristics, neighborhood environmental changes, and individual agency, manifesting as perceptual and behavioral adaptation, interact to create intra-community mental well-being disparities. Through latent class regression analysis on survey data from 1127 residents across 16 neighborhoods in Chengdu, China, the study identifies three subgroups who experience renewal differently: higher-income older female natives, lower-income young male migrants, and the lowest-income young female migrants. First, sociodemographic characteristics establish patterned variations in environmental exposure and perceptions among the three subgroups. Specifically, lower-income young migrants are less exposed to beneficial environmental changes than higher-income local older women. These groups demonstrate distinct environmental perception patterns categorized as affection-oriented, development-oriented, and survival-oriented. Second, environmental changes exert temporally and socially heterogeneous effects on the three groups' mental well-being by altering health-related resource access . With environmental transformations intensifying, the health benefits for the first group continue to grow, while the benefits for the latter two groups initially rise but later decline. Finally, individuals’ strategic environmental perceptions further reshape health disparities. The study contributes to the multiple and interconnected causal pathways through which neighborhood renewal impacts mental well-being inequalities. It unravels the constraints imposed by structural factors on the environment-health and agency-health associations and the pathways and mechanisms through which environmental interventions and individual agency may overcome such constraints, which generates valuable insights for developing equity-oriented renewal policies. © 2025 Elsevier Ltd.},
	author_keywords = {Capability approach; Environmental perception; Health inequalities; Latent class regression; Mental well-being; Neighborhood renewal; Structure-environment-agency interplay},
	keywords = {Chengdu; China; Sichuan; environmental change; mental health; neighborhood; perception},
	correspondence_address = {Y. Liu; Department of Urban and Rural Planning, School of Architecture, Southwest Jiaotong University, Chengdu, China; email: liuynup@swjtu.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {01436228},
	language = {English},
	abbrev_source_title = {Appl. Geogr.},
	type = {Article},
