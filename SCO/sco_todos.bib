@ARTICLE{Hogeweij2025,
	author = {Hogeweij, Maarten and Ploegmakers, Huub and Raaphorst, Kevin and Bongers, Coen and van der Krabben, Erwin},
	title = {It's not easy being cool: Residents’ perceived cooling ability in relation to different types of green infrastructure in their neighbourhood},
