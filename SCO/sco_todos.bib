@ARTICLE{Suo2025,
	author = {Suo, Wanyue and Zhao, Jing},
	title = {Exploring the Streetscape Perceptions from the Perspective of Salient Landscape Element Combination: An Interpretable Machine Learning Approach for Optimizing Visual Quality of Streetscapes},
	year = {2025},
	journal = {Land},
	volume = {14},
