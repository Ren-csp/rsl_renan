	publisher = {Taylor and Francis Ltd.},
	issn = {20565607},
	language = {English},
	abbrev_source_title = {Int. J. Tour. Cities},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Perez2025,
