	source = {Scopus},
	note = {Cited by: 16; All Open Access; Bronze Open Access; Green Open Access}
}

@ARTICLE{Zhang2024,
	author = {Zhang, Qiao and Rui, Jin and Wu, Yufei},
	title = {Encouraging cycling through the improvement of streetscape perception: A bottom-up investigation into the relationship between street greening and bicycling volume},
	year = {2024},
	journal = {Applied Geography},
	volume = {171},
	pages = {},
	doi = {10.1016/j.apgeog.2024.103388},
	url = {https://www.scopus.com/pages/publications/85201917753?origin=resultslist},
	affiliations = {School of Landscape Architecture, Beijing Forestry University, No. 35 Qinghua East Rd., Haidian Dist., Beijing, 100083, China; Department of Spatial Planning, Technical University Dortmund, August-Schmidt-Straße 10, 44227, Germany},
	abstract = {Enhancing neighborhood greenery quality proves to be an effective tactic in encouraging active travel among residents. From a cyclist's perspective, this study quantitatively evaluates street greening quality and its association with cycling behaviors. Utilizing shared bicycle usage data and SegNet-analyzed Baidu Street Views on Xiamen Island, we quantified comprehensive street greening quality. We then employed Spatial Design Network Analysis and a street greening quality rating scale to assess accessibility and aesthetics. Subsequently, models were developed using OLS, spatial autocorrelation, and Moran's I statistical methods, complemented by a spatial heterogeneity analysis of factors influencing shared bicycle riding behaviors through the Geographically Weighted Regression (GWR) model. Our study reveals that in arterial and commercial districts, the appeal and variety of street greening elements are more crucial than their quantity. These quality indicators exhibit a polycentric, continuous spatial distribution, aligning with the overall street layout. Beyond the visual impact of greenery on cycling behavior, factors like richness, openness, and safety of streets, along with diverse facilities, significantly influence cycling route preferences. In contrast, uniform street elements can disrupt or even discourage cycling. This research, by analyzing the relationship between street greening quality and cycling intensity, offers valuable insights for policymakers in prioritizing the transformation of streets into bike-friendly zones. Additionally, we propose a pragmatic, bottom-up approach to developing bicycle-friendly urban environments, indirectly fostering healthier travel habits among urban residents. © 2024 Elsevier Ltd},
	author_keywords = {Cycling behavior; Healthy travel; Semantic segmentation; Streetscape perception; Urban greenery},
	keywords = {China; Fujian; Xiamen; bottom-up approach; cycle transport; greenspace; health status; neighborhood; perception; policy making; travel behavior; urban area; urban planning},
	correspondence_address = {Q. Zhang; School of Landscape Architecture, Beijing Forestry University, Beijing, No. 35 Qinghua East Rd., Haidian Dist., 100083, China; email: zhangqiao@bjfu.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {01436228},
	language = {English},
	abbrev_source_title = {Appl. Geogr.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 27}
}

@ARTICLE{Caizergues2024,
	author = {Caizergues, Aude E. and Santangelo, James S. and Ness, Rob W. and Angeoletto, Fabio and Anstett, Daniel N. and Anstett, Julia and Baena-Diaz, Fernanda and Carlen, Elizabeth J. and Chaves, Jaime A. and Comerford, Mattheau S. and Dyson, Karen and Falahati-Anbaran, Mohsen and Fellowes, Mark D. E. and Hodgins, Kathryn A. and Hood, Glen Ray and Iñiguez-Armijos, Carlos and Kooyers, Nicholas J. and Lázaro-Lobo, Adrián and Moles, Angela T. and Munshi-South, Jason and Paule, Juraj and Porth, Ilga M. and Santiago-Rosario, Luis Y. and Whitney, Kaitlin Stack and Tack, Ayko J. M. and Johnson, Marc T. J.},
	title = {Does urbanisation lead to parallel demographic shifts across the world in a cosmopolitan plant?},
	year = {2024},
	journal = {Molecular Ecology},
	volume = {33},
	number = {7},
	pages = {},
	doi = {10.1111/mec.17311},
	url = {https://www.scopus.com/pages/publications/85187485614?origin=resultslist},
	affiliations = {Centre for Urban Environments, University of Toronto Mississauga, Mississauga, ON, Canada; Department of Biology, University of Toronto Mississauga, Mississauga, ON, Canada; Department of Integrative Biology, University of California Berkeley, Berkeley, CA, United States; Programa de Pós-Graduação em Gestão e Tecnologia Ambiental da Universidade Federal de Rondonópolis, Rondonópolis, Brazil; Department of Plant Biology, Department of Entomology, Plant Resilience Institute, Michigan State University, East Lansing, MI, United States; Genomic Sciences and Technology Program, University of British Columbia, Vancouver, BC, Canada; Department of Microbiology and Immunology, University of British Columbia, Vancouver, BC, Canada; Red de Ecoetología, Instituto de Ecología A.C, Xalapa, Mexico; Living Earth Collaborative, Washington University in St. Louis, St. Louis, MO, United States; Universidad San Francisco de Quito, Quito, Ecuador; San Francisco State University, San Francisco, CA, United States; Department of Biology, University of Massachusetts Boston, Boston, MA, United States; Dendrolytics, Seattle, WA, United States; NTNU University Museum, Norwegian University of Science and Technology, Trondheim, Norway; School of Biological Sciences, University of Reading, Reading, United Kingdom; School of Biological Sciences, Monash University, Melbourne, VIC, Australia; Department of Biological Sciences, Wayne State University, Detroit, MI, United States; Laboratorio de Ecología Tropical y Servicios Ecosistémicos (EcoSs-Lab), Universidad Técnica Particular de Loja, Loja, Ecuador; University of Louisiana, Lafayette, LA, United States; Biodiversity Research Institute (IMIB), CSIC-University of Oviedo-Principality of Asturias, Mieres, Spain; Evolution & Ecology Research Centre, UNSW-University of New South Wales, Sydney, NSW, Australia; Department of Biology and Louis Calder Center, Fordham University, New York, NY, United States; Botanischer Garten und Botanisches Museum Berlin, Freie Universität Berlin, Berlin, Germany; Institut de biologie intégrative et des systèmes, Université Laval, Quebec, QC, Canada; Department of Ecology, Evolution and Behavior, University of Minnesota, St. Paul, MN, United States; Science, Technology & Society Department, Rochester Institute of Technology, Rochester, NY, United States; Department of Ecology, Environment and Plant Sciences, Stockholm University, Stockholm, Sweden},
	abstract = {Urbanisation is occurring globally, leading to dramatic environmental changes that are altering the ecology and evolution of species. In particular, the expansion of human infrastructure and the loss and fragmentation of natural habitats in cities is predicted to increase genetic drift and reduce gene flow by reducing the size and connectivity of populations. Alternatively, the ‘urban facilitation model’ suggests that some species will have greater gene flow into and within cities leading to higher diversity and lower differentiation in urban populations. These alternative hypotheses have not been contrasted across multiple cities. Here, we used the genomic data from the GLobal Urban Evolution project (GLUE), to study the effects of urbanisation on non-adaptive evolutionary processes of white clover (Trifolium repens) at a global scale. We found that white clover populations presented high genetic diversity and no evidence of reduced N<sub>e</sub> linked to urbanisation. On the contrary, we found that urban populations were less likely to experience a recent decrease in effective population size than rural ones. In addition, we found little genetic structure among populations both globally and between urban and rural populations, which showed extensive gene flow between habitats. Interestingly, white clover displayed overall higher gene flow within urban areas than within rural habitats. Our study provides the largest comprehensive test of the demographic effects of urbanisation. Our results contrast with the common perception that heavily altered and fragmented urban environments will reduce the effective population size and genetic diversity of populations and contribute to their isolation. © 2024 The Authors. Molecular Ecology published by John Wiley & Sons Ltd.},
	author_keywords = {effective population size; gene flow; genetic diversity; neutral evolution; urbanisation},
	keywords = {Cities; Demography; Ecosystem; Genetic Drift; Humans; Urbanization; city; demography; ecosystem; genetic drift; human; urbanization},
	correspondence_address = {A.E. Caizergues; Centre for Urban Environments, University of Toronto Mississauga, Mississauga, Canada; email: audeemiliecaizergues@gmail.com},
	publisher = {John Wiley and Sons Inc},
