@ARTICLE{García García2025,
	author = {García García, Alejandro and Agudo Sierra, Elena and López Arquillo, Juan Diego and Aragón de Francisco, Paula and García Carrillo, María Clara and Naya Suárez, Diego and Zubiaurre Arrizabalaga, Telmo},
