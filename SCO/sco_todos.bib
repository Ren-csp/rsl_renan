	title = {Analysing stakeholders’ perceptions of wolf, lynx and fox in a Dutch riverine area},
	year = {2017},
	journal = {Biodiversity and Conservation},
	volume = {26},
	number = {7},
	pages = {1723 - 1743},
	doi = {10.1007/s10531-017-1329-5},
