@article{ WOS:001523451000044,
Author = {Zhao, Guolei and Lyu, Jingwen and Veniaminova, Natalia A. and Zarnowski,
   Robert and Mattos, Eliciane and Johnson, Chad J. and Quintanilla, Derek
   and Hautau, Haley and Hold, LeeAnn A. and Xu, Bin and Anku, Juliet A. E.
