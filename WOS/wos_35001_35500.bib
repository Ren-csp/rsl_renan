@article{ WOS:001022840600001,
Author = {Diaz-Siefer, Pablo and Ramm, Andres F. and Diaz-Forestier, Javiera and
   Leon-Lobos, Pedro and Celis-Diez, Juan L.},
Title = {Biotic homogenization in the availability of ornamental seeds of the
   native flora in Chile},
Journal = {ORNAMENTAL HORTICULTURE-REVISTA BRASILEIRA DE HORTICULTURA ORNAMENTAL},
Year = {2022},
Volume = {29},
Number = {2},
Pages = {181-199},
Month = {APR-JUN},
Abstract = {Biotic homogenization is a global phenomenon, mainly in urban areas
   where exotic species are dominant, contributing to the loss of native
   biodiversity. Gardening native flora to promote local biodiversity is
   becoming a conservation practice in urban settings. Therefore, in this
   study, we analyzed the representation of the Chilean native flora in the
   Chilean and international ornamental flower seed market to know which
   native plant seeds are sold. We found that native seed are absent in the
   local market and that the totality of seed supply in the market
   corresponds to species of exotic origin, mainly from the Palearctic
   region (43\%). However, surprisingly, many Chilean flower seeds are
   traded in the international market (approximately 6\% of the total
   Chilean flora). This lack of availability of native seeds for local
   consumers constitutes a bottleneck for ecological restoration
   initiatives. It is consistent with the greater abundance of exotic
   species in urban green areas and supports the hypothesis of biocultural
   homogenization.},
