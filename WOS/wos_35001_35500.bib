@article{ WOS:001823638200001,
Author = {Gladstone, Fiona and Agrawal, Arun},
Title = {Commoning mobilizations and institutional outcomes in Indian forests
   from colonial to postcolonial periods},
Journal = {ECOLOGICAL ECONOMICS},
Year = {2026},
Volume = {250},
Month = {DEC},
Abstract = {Commoning is the ongoing social practice, grounded in generalized
   reciprocity rather than market exchange or hierarchical authority,
   through which members of a collective mutually create and sustain some
   aspects of their shared material and non-material lives and themselves.
   It is embedded in the creation and sustaining of commons - resources and
   associated social and institutional infrastructures created, used, or
   managed collectively by groups of users. Although scholars of commons
   and common-pool resources have contributed to substantial research on
   how institutional arrangements and characteristics of resources shape
   sustainability outcomes, fewer studies of the commons assess the
   commoning processes that lead to commons governance institutions and
   shared resources. This paper focuses on the historical emergence of
   forest commons in India to show how commoning related social
   mobilizations shape commons institutions. Our comparative examination of
   the nearly hundred-year history of two different commoning processes
   indicates that the evolving dynamics and the lived experiences,
   objectives, and interactions of those engaged in commoning affect both
   the structure and the effects of commons institutions. The empirical
   analysis illuminates the black box of institutional architecture that
   tends to remain the starting point for many analyses of common property
   arrangements. By connecting variations in commoning processes with
   variations in the structure, outcomes, and longevity of the commons, the
   paper develops an explanatory framework through which to understand how
   commoning centrally shapes institutional arrangements, their
   performance, and the human-nature relationships of those engaged in
   commoning. It ends with a call for closer engagement between research
   concerned with the emancipatory politics of commoning as a new frontier
   of work on transformative change and that on the governance of the
   commons and common pool resources.},
