@article{ WOS:000324040700015,
Author = {Gorner, Tomas and Najmanova, Klara and Cihar, Martin},
Title = {Changes in Local People's Perceptions of the Sumava National Park in the
   Czech Republic over a Ten Year Period (1998-2008)},
Journal = {SUSTAINABILITY},
Year = {2012},
