@article{ WOS:001178091600014,
Author = {Koeck, Zoe and Schnelle, Kilian and Persechino, Margherita and Umbach,
   Simon and Schihada, Hannes and Januliene, Dovile and Parey, Kristian and
   Pockes, Steffen and Kolb, Peter and Doetsch, Volker and Moeller, Arne
   and Hilger, Daniel and Bernhard, Frank},
Title = {Cryo-EM structure of cell-free synthesized human histamine 2
   receptor/Gs complex in nanodisc environment},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {FEB 28},
Abstract = {Here we describe the cryo-electron microscopy structure of the human
   histamine 2 receptor (H2R) in an active conformation with bound
   histamine and in complex with G(s) heterotrimeric protein at an overall
   resolution of 3.4 \& Aring;. The complex was generated by
   cotranslational insertion of the receptor into preformed nanodisc
   membranes using cell-free synthesis in E. coli lysates. Structural
   comparison with the inactive conformation of H2R and the inactive and
   G(q)-coupled active state of H1R together with structure-guided
   functional experiments reveal molecular insights into the specificity of
   ligand binding and G protein coupling for this receptor family. We
   demonstrate lipid-modulated folding of cell-free synthesized H2R, its
   agonist-dependent internalization and its interaction with endogenously
   synthesized H1R and H2R in HEK293 cells by applying a recently developed
   nanotransfer technique.},
