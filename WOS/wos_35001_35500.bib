@article{ WOS:000507631300008,
Author = {Yarnashita, Ryohei and Morisawa, Kensaku},
Title = {Consideration of Qualitative Changes in Agricultural Settlements Due to
   Land Consolidation A Case Study Based on the Perceptions of
   Non-Farmers},
