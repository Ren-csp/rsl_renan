@article{ WOS:000659178700014,
Author = {Han, Zhu and Zhang, Weizhi and Ning, Wanshan and Wang, Chenwei and Deng,
   Wankun and Li, Zhidan and Shang, Zehua and Shen, Xiaofei and Liu,
   Xiaohui and Baba, Otto and Morita, Tsuyoshi and Chen, Lu and Xue, Yu and
   Jia, Da},
Title = {Model-based analysis uncovers mutations altering autophagy selectivity
   in human cancer},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {MAY 31},
Abstract = {Autophagy can selectively target protein aggregates, pathogens, and
   dysfunctional organelles for the lysosomal degradation. Aberrant
   regulation of autophagy promotes tumorigenesis, while it is far less
   clear whether and how tumor-specific alterations result in autophagic
   aberrance. To form a link between aberrant autophagy selectivity and
   human cancer, we establish a computational pipeline and prioritize 222
   potential LIR (LC3-interacting region) motif-associated mutations (LAMs)
   in 148 proteins. We validate LAMs in multiple proteins including ATG4B,
   STBD1, EHMT2 and BRAF that impair their interactions with LC3 and
   autophagy activities. Using a combination of transcriptomic, metabolomic
   and additional experimental assays, we show that STBD1, a
   poorly-characterized protein, inhibits tumor growth via modulating
   glycogen autophagy, while a patient-derived W203C mutation on LIR
   abolishes its cancer inhibitory function. This work suggests that
   altered autophagy selectivity is a frequently-used mechanism by cancer
   cells to survive during various stresses, and provides a framework to
   discover additional autophagy-related pathways that influence
   carcinogenesis. Although autophagy has been linked to tumourigenesis, it
   is unclear how genomic alterations affect autophagy selectivity in
   tumours. Here, the authors establish a pipeline that integrates
   computational and experimental approaches to show that altered autophagy
   selectivity is frequent in cancer cells and link glycogen autophagy with
   tumourigenesis.},
