   Chan, Hing Man, Univ Ottawa, Ctr Adv Res Environm Genom, Ottawa, ON K1N 6N5, Canada.},
DOI = {10.1139/as-2017-0033},
EISSN = {2368-7460},
Keywords = {mercury; biomarker; neurochemical; neurotoxicity; Inuit},
