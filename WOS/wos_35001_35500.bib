Author = {Morales Rodriguez, Jose Roberto and Ortega Argueta, Alejandro and Ramos
   Munoz, Dora Elia and Gurri Garcia, Rancisco Delfin},
Title = {Adaptive capacity in the Pantanos de Centla Biosphere Reserve, Mexico},
Journal = {ECONOMIA SOCIEDAD Y TERRITORIO},
Year = {2019},
Volume = {19},
Number = {59},
Pages = {1119-1153},
Month = {JAN-APR},
Abstract = {Protected areas (PA), through management, can be territories that
   facilitate the strengthening of inhabitants' adaptive capacity (AC).
   This work evaluated the influence of a governmental environmental
   program (Procodes) on the AC of community groups into PA. To this end, a
   documentary review (2008-2016) and a perception survey in 2016 were
   conducted that included ecological and social dimensions. According to
   the results, the strengthening of AC is related with legitimacy of
   participation mechanisms, the assignation of subsidies and the planning
   horizon of productive projects.},
