@article{ WOS:001838683900001,
Author = {Regona, Massimo and Yigitcanlar, Tan and Hon, Carol and Teo, Melissa},
Title = {Advancing sustainable construction: A trust-enhanced model of AI
   adoption and realised use},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {The transition towards sustainable built environments increasingly
   depends on the effective integration of AI in construction. While AI can
   support productivity, safety, decision-making and resource efficiency,
   its adoption in construction remains fragmented across organisations,
   projects and professional workflows. This study develops and empirically
   validates a trust-enhanced Technology Acceptance Model (TAM) to explain
   AI adoption and realised use in construction. Survey data from 1,233
   professionals across Australia, the UK and the US were analysed using
   structural equation modelling. The model examines the relationships
   between perceived ease of use, perceived usefulness, trust in AI,
   attitude, behavioural intention and self-reported actual usage. The
   results show that trust significantly shapes perceived ease of use and
   perceived usefulness, while behavioural intention is the strongest
   predictor of self-reported actual AI use. The findings also indicate
   that trust enables professionals to evaluate whether AI tools are
   reliable, manageable and useful within project-based workflows. The
   study contributes to adoption theory by contextualising trust-enhanced
   TAM within construction, where AI outputs may influence cost, safety,
   design decisions, site operations and professional responsibility. By
   modelling realised use rather than behavioural intention alone, the
   study advances understanding of how AI adoption progresses from
   perception and intention to reported professional use. The findings
   provide practical guidance for developing trust-building mechanisms,
   governance processes and implementation strategies that support
   responsible, scalable and sustainability-oriented AI adoption in
   construction.},
