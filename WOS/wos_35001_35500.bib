@article{ WOS:001344705100001,
Author = {Sheng, Andrew},
Title = {Can We Really Control Giant Open Complex Systems?},
Journal = {GLOBAL PERSPECTIVES},
Year = {2024},
Volume = {5},
Number = {1},
Abstract = {Human society and nature interact through complex interconnections and
   interdependencies. Using Chinese scientist Qian Xuesen's concept of
   Giant Open Complex Systems, this paper argues that if human beings are
   themselves such open complex systems, their interaction with other human
   beings and nature create co-relative, co-creative interactions that
   cannot be reduced to simple reductionist principles that enable
   prediction and control. We should therefore have few illusions that we
   can fully control human destinies under current theories and policies.},
