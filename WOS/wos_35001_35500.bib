@article{ WOS:001502640800001,
Author = {da Silva, Camilla Araujo and de Sa, Fernanda Diniz and Alves, Simone
   Bezerra and Falcao e Sa, Dalmare Anderson Bezerra de Oliveira and do
   Nascimento Junior, Leonildo Santos},
Title = {Between freedom and vulnerability: app-based delivery workers'
   perceptions of health and safety conditions},
Journal = {INTERFACE-COMUNICACAO SAUDE EDUCACAO},
Year = {2025},
Volume = {29},
Number = {1},
Abstract = {This study investigated the health and safety conditions of 15 app-based
   delivery workers using semi-structured interviews. The survey responses
   were transcribed and analyzed using thematic content analysis. Most
   respondents reported work-associated health problems and adverse
   environmental conditions. However, the findings reveal a clear link
   between these problems and masculinities forged by patriarchal
   structures that lead workers to ignore risk and resulting problems.
   Traffic accident assistance was regarded to be inadequate due to the
   need to immediately return to work. The findings highlight the complex
   relationship between health, perceived risk and patriarchal patterns of
   behavior. Overcoming these challenges by reviewing strategies in men's
   health policies requires not only improvements in access to health
   services, but also in the understanding of the social structures that
   perpetuate precarious conditions.},
