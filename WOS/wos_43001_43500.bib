@article{ WOS:000585560600001,
Author = {Ouadah, Nihal S. and Blazy, Kelly and Villegier, Anne-Sophie},
Title = {Effect of Radiofrequency Electromagnetic Fields on Thermal Sensitivity
   in the Rat},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
