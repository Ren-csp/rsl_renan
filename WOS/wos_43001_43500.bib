@article{ WOS:001600491900004,
Author = {Koutounidis, Antonios and Dovom, Daniel Barzegar and Paulsen, Mads and
   Papadaskalopoulos, Dimitrios and Pereira, Francisco Camara and Azevedo,
   Carlos Lima},
Title = {Bayesian optimization of electric vehicle charging infrastructure
   location planning: An agent-based simulation approach},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {134},
Month = {NOV 15},
Abstract = {The urgent need for greenhouse gas emission reductions has accelerated
   the adoption of Electric Vehicles (EVs), making the efficient deployment
   of charging infrastructure crucial. We propose a Bayesian Optimization
   (BO) framework for optimal charging infrastructure deployment in urban
   areas, addressing the complex interactions between heterogeneous demand,
   mobility, and charging networks. The framework is integrated with
   Multi-Agent Transport Simulation (MATSim), a high-resolution mobility
   simulator that captures individual travel choices, network effects, and
   charging behaviours. We extend MATSim with a probabilistic charging
   demand model, including plug-in probabilities, an initial State of
   Charge (SoC) distribution, and charging durations constrained by parking
   regulations. We apply our framework to a real-world case study in
   Frederiksberg, Denmark, involving more than 60,000 EV users and nearly
   75,000 daily trips, demonstrating that a high-resolution traffic
   simulator such as MATSim can shed light on network effects, travel and
   charging behaviour shifts when solving the EV charger location planning
   problem. The results underscore the critical role of the public charging
   infrastructure in dense urban areas, which at 10\% EV penetration rate
   accounts for 65.4\% of all charging sessions and delivers 67.7\% of the
   transmitted energy. Finally, BO consistently outperforms existing
   black-box approaches for similar problems, achieving 22.4\% higher
   welfare with only 1/3 of simulation runs, substantially reducing
   computational effort.},
