Title = {Wild canids and felids differ in their reliance on reused travel
   routeways},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2025},
Volume = {122},
