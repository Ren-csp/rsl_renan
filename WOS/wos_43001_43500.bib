@article{ WOS:001818726700001,
Author = {Cigdem, Semsettin and Yildiz, Bulent and Kaya, Semih and Kutahyali,
   Dilber Nilay},
Title = {Bridging Awareness and Intention in Sustainable Mobility: A
   Value-Belief-Norm-Informed Technology Acceptance Analysis of Hydrogen
   Fuel Cell Vehicle Purchase Intention},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {13},
Month = {JUL},
Abstract = {Even though hydrogen fuel cell vehicles are essential for
   decarbonization, getting consumers to accept them remains a tough issue.
   This research combines normative and cognitive theories to find out if
   environmental values actually take precedence over logical risk
   assessments. We analyzed data from 761 consumers in T \& uuml;rkiye,
   using the structural equation model and Hayes' PROCESS Macro. The
   results show that, although environmental concerns strongly increased
   awareness (beta = 0.80) and awareness lowered perceived risk (beta =
   -0.34), perceived risk itself did not significantly predict purchase
   intention (beta = 0.03, p > 0.05). Instead, decisions were motivated by
   a hope-based path: Concern -> Awareness -> Usefulness -> Intention. We
   tentatively interpret this as Green Motivation Dominance, whereby
   environmentally motivated early adopters appear to prioritize
   environmental benefits over technical hazards; notably, perceived
   usefulness significantly predicted intention (beta = 0.29), and the
   serial path Concern -> Awareness -> Usefulness -> Intention was
   significant (effect = 0.25, 95\% CI {[}0.17, 0.35]). This
   interpretation, however, warrants direct testing in future research.
   Thus, the main factor driving adoption is the presence of advantages,
   not the absence of risk. Therefore, policymakers should focus on
   maximizing benefits rather than just trying to reduce risks.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Kaya, S (Corresponding Author), Kastamonu Univ, Inst Social Sci, TR-37210 Kastamonu, Turkiye.
   Cigdem, Semsettin, Gaziantep Univ, Dept Int Trade \& Logist, TR-27310 Gaziantep, Turkiye.
   Yildiz, Bulent, Kastamonu Univ, Dept Business Adm, TR-37210 Kastamonu, Turkiye.
   Kaya, Semih, Kastamonu Univ, Inst Social Sci, TR-37210 Kastamonu, Turkiye.
   Kutahyali, Dilber Nilay, Kastamonu Univ, Kastamonu Vocat Sch, TR-37210 Kastamonu, Turkiye.},
DOI = {10.3390/su18136864},
Article-Number = {6864},
EISSN = {2071-1050},
Keywords = {hydrogen fuel cell vehicles; sustainable consumption; pro-environmental
