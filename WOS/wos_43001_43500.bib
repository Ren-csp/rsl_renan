   Jerry, D. Joseph, Univ Massachusetts, Dept Vet \& Anim Sci, Amherst, MA 01003 USA.
   Kim, Ik-Bum; Phillips, Ronnie L.; Bunz, Uwe H. F., Georgia Inst Technol, Sch Chem \& Biochem, Atlanta, GA 30332 USA.},
DOI = {10.1073/pnas.0900975106},
ISSN = {0027-8424},
EISSN = {1091-6490},
