@article{ WOS:000264880600007,
Author = {Uwasu, Michinori and Yabar, Helmut and Hara, Keishiro and Shimoda,
   Yoshiyuki and Saijo, Tatsuyoshi},
Title = {Educational initiative of Osaka University in sustainability science:
   mobilizing science and technology towards sustainability},
