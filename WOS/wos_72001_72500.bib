@article{ WOS:001198910500001,
Author = {Begum, Zinnat A. and Ripon, Rashedul Islam and Yoshioka, Shoji and
   Hasegawa, Hiroshi and Rahman, Ismail M. M.},
Title = {Dispersant-enhanced migration of radiocesium among soil size fractions:
   A novel strategy for volume reduction of radioactively contaminated soil},
Journal = {ENVIRONMENTAL RESEARCH},
Year = {2024},
Volume = {250},
Month = {JUN 1},
Abstract = {In the aftermath of the Fukushima Daiichi Nuclear Power Plant accident,
   a pioneering large-scale decontamination project was initiated, aiming
   to enable the return of evacuees. This project, the first of its kind in
   human history, involved the transportation of soils collected during
   decontamination to interim storage facilities. Before recycling or
   disposal, these soils undergo processes like volume reduction. However,
   there's a need for innovative methods to reduce volume effectively and
   treat secondary wastes more efficiently. The current study explores the
   impact of a dispersant, sodium hexametaphosphate (SHMP), on the behavior
   of radiocesium (r-Cs: Cs-137) dynamics in different size fractions of
   radioactively contaminated soils from Fukushima. The solid-phase
   speciation analysis of Fukushima soils validated that at least 50\% of
   the Cs-137 or other minerals are associated with difficult-to-extract
   soil phases. Nonetheless, the low Cs-137/Cs-133 ratio in corresponding
   soil phases implies a slower r-Cs fixation mechanism. The wet-sieving of
   r-Cs contaminated soil fraction, < 2 mm, with SHMP, resulted in
   different soil subfractions (2000-212, 212-53, and < 53 mu m). Following
   SHMP treatment, dispersion of > 92\% of Cs-137 associated with < 212 mu
   m soil size fractions was observed. The migration of Cs-137 towards
   smaller soil size fractions can be attributed to either SHMP-induced
   cation exchange or the formation of polyvalent complexes involving SHMP
   and soil minerals. The condensation of Cs-137 in < 212 mu m, as induced
   by SHMP, enabled the subsequent reuse of the larger soil fraction (> 212
   mu m), which was less contaminated. This study provides a new
   perspective on the effects of dispersants and contributes to a better
   understanding of the complex interactions among organic carbon, Cs-137,
   monovalent and polyvalent cations, and soil functional groups concerning
   the volume reduction of soils contaminated with r-Cs.},
