@article{ WOS:001644628400001,
Author = {Gerard, Andrew and Garcia, Maria Alejandra and Lopez, Maria Claudia and
   Bizoza, Alfred and Vuguziga, Bridget},
Title = {Understanding female household heads' barriers to profiting from coffee
   in Southern Rwanda},
Journal = {JOURNAL OF EASTERN AFRICAN STUDIES},
Year = {2025},
Volume = {19},
Number = {3},
Pages = {409-430},
Month = {JUL 3},
Abstract = {Female household heads (HHHs) in Rwanda face greater challenges than
   male-headed households in securing productive resources, including land.
   Yet evidence on women's own perceptions of agricultural constraints,
   profitability, and their proposed solutions is limited, especially for
   cash crops like coffee. This study examines female HHHs who farm coffee
   in Huye District, a major coffee-producing region. We analyse survey
   data on investment decisions and use qualitative data from cooperative
   members and non-members to elicit perceived barriers, causes, and
   solutions via an interactive Problem Tree. Quantitative results indicate
   female HHHs are generally older, live in smaller households, and are
   less likely to use pesticides or make short-term investments compared to
   other farmers. Qualitative findings show women report limited access to
   labour, inputs, and finance as major constraints, attributed to poverty
   and restrictive gender norms. Although some women mentioned threats to
   land tenure, most prioritised immediate needs such as food security.
   Women propose solutions including improved access to agricultural
   inputs, strengthened cooperative support, and action on gender norms.
   This case study portrays women's perspectives on problems and potential
   solutions, which are relevant for programs and policies focused on
   gender norm transformation and poverty reduction in Rwanda.},
