@article{ WOS:000340483300009,
Author = {Tang, Chaoli and Wang, Chunling and Qu, Liguo and Ling, Liuyi},
Title = {MODELING AND SIMULATION OF VIRTUAL COMPLEX COALMINE ENVIRONMENT SYSTEMS
   USING MULTI-AGENT TECHNOLOGY},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
