@article{ WOS:001329962600003,
Author = {Maejima, Yasuhiro and Nah, Jihoon and Aryan, Zahra and Zhai, Peiyong and
   Sung, Eun-Ah and Liu, Tong and Takayama, Koichiro and Moghadami, Siavash
   and Sasano, Tetsuo and Li, Hong and Sadoshima, Junichi},
Title = {Mst1-mediated phosphorylation of FoxO1 and C/EBP-β stimulates
   cell-protective mechanisms in cardiomyocytes},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JUL 25},
Abstract = {The molecular mechanisms by which FoxO transcription factors mediate
   diametrically opposite cellular responses, namely death and survival,
   remain unknown. Here we show that Mst1 phosphorylates FoxO1
   Ser209/Ser215/Ser218/Thr228/Ser232/Ser243, thereby inhibiting
   FoxO1-mediated transcription of proapoptotic genes. On the other hand,
   Mst1 increases FoxO1-C/EBP-beta interaction and activates C/EBP-beta by
   phosphorylating it at Thr299, thereby promoting transcription of
   prosurvival genes. Myocardial ischemia/reperfusion injury is larger in
   cardiac-specific FoxO1 knockout mice than in control mice. However, the
   concurrent presence of a C/EBP-beta T299E phospho-mimetic mutation
   reduces infarct size in cardiac-specific FoxO1 knockout mice. The
   C/EBP-beta phospho-mimetic mutant exhibits greater binding to the
   promoter of prosurvival genes than wild type C/EBP-beta. In conclusion,
   phosphorylation of FoxO1 by Mst1 inhibits binding of FoxO1 to
   pro-apoptotic gene promoters but enhances its binding to C/EBP-beta,
   phosphorylation of C/EBP-beta, and transcription of prosurvival genes,
   which stimulate protective mechanisms in the heart.
   Forkhead box O (FoxO) transcription factors mediate both cell death and
   survival. Here, the authors report that phosphorylation of FoxO1 by
   Mst1, a Hippo kinase, enhances its binding to C/EBP-beta and
   phosphorylation and dimerization of C/EBP-beta, thereby stimulating cell
   survival in the heart. Thus, Mst1 converts FoxO1 from a pro-death to a
   pro-survival factor.},
