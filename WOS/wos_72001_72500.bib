@article{ WOS:001547819900001,
Author = {Morandini, Marcelo Nahuel and Castro, Aime Oyharzabal and Sola, Rodolfo
   Ricardo and Pinciroli, Laura and Urtasun, Maria Manuela and Lamas,
   Carola Yanina and Giamminola, Eugenia Mabel and Sharry, Sandra Elizabeth},
Title = {Communal Land Use in the Yungas of Jujuy and Salta Provinces
   (Argentina): Transhumance and Edible Plants in Valle Colorado},
Journal = {HUMAN ECOLOGY},
Year = {2025},
Volume = {53},
Number = {3},
Pages = {437-451},
Month = {JUN},
Abstract = {Andean communities in the Yungas ecoregion of northern Argentina migrate
   seasonally across different altitude zones. Their transhumant movements
   involve temporarily relocating their homes and are closely connected to
   social, productive, and ecological factors. We aimed to evaluate the
   land used by households in Valle Colorado, Jujuy Province, to identify
   land use patterns, interactions with other Indigenous communities, and
   the consumption of native plants. To do this, we organized workshops,
   surveys, participatory mapping, and route documentation. The maps were
   digitized, and we identified edible plants in each studied ecosystem.
   The transhumant groups cover 30,000 hectares, with an additional 4,000
   hectares shared with families from Santa Ana. Overall, based on cultural
   identity, production practices, and local biodiversity knowledge, we
   identified 181,248 hectares of land managed by the Kolla communities of
   Salta and Jujuy. Among wild species with potential food uses, Andean
   fruit trees such as papaya (Vasconcellea quercifolia), uvilla (Berberis
   commutata), and chilto (Solanum betaceum) stand out. These findings
   contribute to the study of the domestication of Andean fruit species.
   Las comunidades andinas del norte de Argentina, ubicadas en la ecorregi
   \& oacute;n de las Yungas, hacen un uso extensivo de su territorio a
   trav \& eacute;s de movimientos estacionales en diferentes zonas
   altitudinales. Este desplazamiento, denominado trashumancia, implica un
   cambio temporal de residencia y est \& aacute; estrechamente vinculado
   con las condiciones sociales, productivas y ecol \& oacute;gicas. El
   objetivo de este estudio fue evaluar el territorio utilizado durante la
   trashumancia practicada por las unidades dom \& eacute;sticas de Valle
   Colorado (provincia de Jujuy), con el fin de identificar patrones de uso
   territorial, conexiones con otras comunidades ind \& iacute;genas y el
   aprovechamiento de especies vegetales nativas con fines alimentarios.
   Para lograrlo, se llevaron a cabo talleres, encuestas, mapeo
   participativo y documentaci \& oacute;n de rutas. Los mapas fueron
   digitalizados y, en cada uno de los ambientes estudiados, se
   identificaron las principales especies silvestres utilizadas para la
   alimentaci \& oacute;n. La trashumancia practicada en Valle Colorado
   abarca 30,000 hect \& aacute;reas, con 4,000 hect \& aacute;reas
   adicionales compartidas con familias de Santa Ana. En total, se
   identificaron 181,248 hect \& aacute;reas gestionadas por las
   comunidades Kolla de Salta y Jujuy, seg \& uacute;n su identidad
   cultural, pr \& aacute;cticas productivas y conocimiento local de la
   biodiversidad. Entre las especies silvestres con potencial uso
   alimentario, destacan frutales andinos como la papaya (Vasconcellea
   quercifolia), la uvilla (Berberis commutata) y el chilto (Solanum
   betaceum). Este trabajo representa un primer acercamiento al estudio de
   la domesticaci \& oacute;n de especies frutales andinas.},
