@article{ WOS:000959244800016,
Author = {An, Bao Guo and Chua, Kah Heng},
Title = {A Comparative Analysis of Lower Secondary Chemistry Textbook Components:
   A Study Involving the Chinese Communities of China and Malaysia},
Journal = {PERTANIKA JOURNAL OF SOCIAL SCIENCE AND HUMANITIES},
