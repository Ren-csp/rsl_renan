@incollection{ WOS:000400252000118,
Author = {Garcia-Aristizabal, Alexander and Almeida, Miguel and Aubrecht,
   Christoph and Polese, Maria and Ribeiro, Luis Mario and Viegas, Domingos
   and Zuccaro, Giulio},
