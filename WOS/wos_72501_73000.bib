@article{ WOS:001465587400039,
Author = {Martin, Jeff Vance and Dillis, Christopher and Starrs, Genoa and Schell,
   Danielle and Grantham, Theodore E. and Butsic, Van},
Title = {Wildfire impacts and mitigation strategies among California cannabis
   producers},
