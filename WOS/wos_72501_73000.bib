   Fatoric, Sandra, Delft Univ Technol, Fac Architecture \& Built Environm, Julianalaan 134, NL-2628 BL Delft, Netherlands.
   Seekamp, Erin, North Carolina State Univ, Dept Pk Recreat \& Tourism Management, Raleigh, NC 27695 USA.},
DOI = {10.1007/s11852-019-00698-8},
ISSN = {1400-0350},
EISSN = {1874-7841},
