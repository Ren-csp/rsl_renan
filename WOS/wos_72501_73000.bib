@article{ WOS:000864633700012,
Author = {Parzych, Elizabeth M. and Du, Jianqiu and Ali, Ali R. and Schultheis,
   Katherine and Frase, Drew and Smith, Trevor R. F. and Cui, Jiayan and
   Chokkalingam, Neethu and Tursi, Nicholas J. and Andrade, Viviane M. and
   Warner, Bryce M. and Gary, Ebony N. and Li, Yue and Choi, Jihae and
   Eisenhauer, Jillian and Maricic, Igor and Kulkarni, Abhijeet and Chu,
   Jacqueline D. and Villafana, Gabrielle and Rosenthal, Kim and Ren,
   Kuishu and Francica, Joseph R. and Wootton, Sarah K. and Tebas, Pablo
   and Kobasa, Darwyn and Broderick, Kate E. and Boyer, Jean D. and Esser,
   Mark T. and Pallesen, Jesper and Kulp, Dan W. and Patel, Ami and Weiner,
   David B.},
Title = {DNA-delivered antibody cocktail exhibits improved pharmacokinetics and
   confers prophylactic protection against SARS-CoV-2},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {OCT 6},
Abstract = {Here, Parzych et al describe the development of a DNA-delivered
   SARS-CoV-2 mAb cocktail displaying synergistic RBD binding that confers
   broad neutralizing activity against variants of concern and prophylactic
   efficacy in multiple small animal models.
   Monoclonal antibody therapy has played an important role against
   SARS-CoV-2. Strategies to deliver functional, antibody-based
   therapeutics with improved in vivo durability are needed to supplement
   current efforts and reach underserved populations. Here, we compare
   recombinant mAbs COV2-2196 and COV2-2130, which compromise clinical
   cocktail Tixagevimab/Cilgavimab, with optimized nucleic acid-launched
   forms. Functional profiling of in vivo-expressed, DNA-encoded monoclonal
   antibodies (DMAbs) demonstrated similar specificity, broad antiviral
   potency and equivalent protective efficacy in multiple animal challenge
   models of SARS-CoV-2 prophylaxis compared to protein delivery. In PK
   studies, DNA-delivery drove significant serum antibody titers that were
   better maintained compared to protein administration. Furthermore,
   cryo-EM studies performed on serum-derived DMAbs provide the first
   high-resolution visualization of in vivo-launched antibodies, revealing
   new interactions that may promote cooperative binding to trimeric
   antigen and broad activity against VoC including Omicron lineages. These
   data support the further study of DMAb technology in the development and
   delivery of valuable biologics.},
