@article{ WOS:000302873700087,
Author = {Linard, Catherine and Gilbert, Marius and Snow, Robert W. and Noor,
   Abdisalan M. and Tatem, Andrew J.},
Title = {Population Distribution, Settlement Patterns and Accessibility across
   Africa in 2010},
Journal = {PLOS ONE},
Year = {2012},
