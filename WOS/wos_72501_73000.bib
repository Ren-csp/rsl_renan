@article{ WOS:001676999100001,
Author = {Su, Wei-Hao and Kuo, Chia-Chia and Chen, Long-Sheng},
Title = {Mapping the Intellectual and Industrial Evolution of Corporate Social
   Responsibility: A Cross-Sector Scientometric Analysis Using Main Path
   and Cluster Methods},
Journal = {CORPORATE SOCIAL RESPONSIBILITY AND ENVIRONMENTAL MANAGEMENT},
Year = {2026},
Volume = {33},
Number = {4},
Pages = {5321-5346},
Month = {JUL},
Abstract = {Corporate social responsibility (CSR) has undergone continuous expansion
   across industries, yet its intellectual evolution and cross-sectoral
   linkages remain insufficiently understood. This study provides a
   comprehensive, data-driven assessment of CSR's developmental
   trajectories by analyzing 3314 Web of Science articles using key-route
   main path analysis, cluster analysis, keyword mapping, and growth-curve
   modeling. Results reveal four historically dominant industry pathways:
   mining, aviation, tourism, and hospitality, alongside emerging clusters
   in construction, green supply chains, public health, and climate-related
   financial risk. Main path analysis demonstrates that CSR knowledge
   initially consolidated around sustainability reporting and stakeholder
   governance in extractive industries before diffusing toward
   service-oriented sectors emphasizing consumer perception, organizational
   culture, and ESG-driven performance. Cluster analysis further identifies
   six major thematic communities and highlights their structural
   interconnections, indicating that CSR develops as an integrated,
   multi-sectoral knowledge system driven by institutional pressures and
   diffusion carriers, as evidenced by the cross-cluster citation linkages
   and the main-path transition from legitimacy-sensitive extractive
   industries to market-mediated service sectors. This study advances CSR
   scholarship by systematically mapping its intellectual architecture,
   revealing cross-industry diffusion patterns, and identifying emerging
   thematic frontiers. The findings provide theoretical implications for
   understanding CSR as an evolving institutional logic and managerial
   implications for firms seeking to align CSR strategies with
   sector-specific sustainability pressures and stakeholder expectations.},
