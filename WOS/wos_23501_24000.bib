@article{ WOS:001758084100001,
Author = {Soman, Devi Abhishek and Licznerski, Maya and Joseph, Anjali and RIPCHD
   PED Study Grp},
Title = {Exploring pediatric mental and behavioral health patients' and their
   care partners' perceptions of the emergency departments' physical
   environment},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {112},
Month = {JUN},
Abstract = {Aims: This study explores mental and behavioral health (MBH) patients'
   and their care partners' perceptions of the Emergency Department (ED)
   physical environment and how it shaped their care experiences in the ED.
   Background: The number of pediatric MBH-related visits to EDs has
   increased in the past 20 years. Children seeking care in EDs with MBH
   concerns are particularly sensitive to environmental stimuli, and
   overcrowding in the ED can exacerbate their symptoms. A recent
   literature review highlighted how the ED physical environment can
   influence pediatric patients and their care partners' experiences
   through features that affect their perception of control, presence of
   positive distraction, opportunities for social support, and
   considerations for safety and comfort. Method: In this qualitative
   study, we conducted interviews with seven pediatric MBH patients and
   nine care partners to identify key ED physical environment themes that
   addressed aspects of control, positive distraction, social support, and
   safety and comfort, contributing to their overall care experiences in
   the ED. Results: While discussing their ED experience (312 quotes),
   participants shared their overall perceptions of the ED physical
   environment (43) along with their perceptions of control (71), positive
   distraction (43), social support (48), and safety and comfort (139).
   While describing these themes, participants identified more barriers
   (133) than facilitators (116) and suggestions (22). Conclusion:
   Considering and integrating pediatric MBH patients' and their care
   partners' ED perspectives and care needs into the preliminary ED design
   processes can provide a holistically healing environment for these
   children in crisis.},
