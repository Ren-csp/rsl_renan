@article{ WOS:001819653600001,
Author = {Weinberg, Lucas and Trummer, Johanna and Keller, Lars and Kapelari,
   Suzanne},
Title = {Exploring high mountain environments: high school students' perceptions
   from a place-based field trip},
Journal = {FRONTIERS IN EDUCATION},
Year = {2026},
Volume = {11},
Month = {JUL 1},
Abstract = {Introduction In recent years, the consequences of climate change for
   human well-being and ecosystems have become increasingly severe. High
   mountain environments are undergoing changes that not only make the
   effects of climate change visible but generate new environmental risks.
   These highly dynamic environments represent powerful learning sites but
   also pose challenges for education due to their visible responses to
   rising temperatures. Place-based education offers a framework for
   connecting learners to meaningful real world locations, and fostering
   learning through direct engagement with high mountain environments.
   However, there is limited research on which elements of those
   environments support place-based learning.Methods This study aims to (1)
   explore how high school students perceive high mountain environments and
   (2) identify the environmental, social, and emotional elements that
   contribute to their sense of place. Adopting a multi-method approach,
   the high school students (n = 43; aged 14-16 years) expressed their
   perceptions on a field trip to the case study area, the Gaisberg Valley,
   Tyrol, Austria. Data were collected through focus group discussions,
   peer-to-peer interviews, and a photo-hike.Results The results show that
   the high school students hold particular interest in physical features,
   environmental changes related to climate change, and ecological
   elements. Their perceptions also revealed a strong desire to interact
   with the area through different perspectives, as well as emotional
   responses ranging from curiosity and joy to feelings of risk.Discussion
   Overall, the results highlight key elements of high mountain
   environments that can support educators in designing field trips and
   teaching climate change through place-based learning.},
