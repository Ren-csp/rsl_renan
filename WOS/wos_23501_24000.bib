@article{ WOS:001676661300002,
Author = {Al Karim, Rashed and Polas, Mohammad Rashed Hasan and Karim, Ridoan and
   Mehzabeen, Mahmuda and Islam, A. K. M. Sharul and Falahat, Mohammad},
Title = {Employees perceptions and management support driving renewable energy
   adoption in the hospitality industry},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {7},
Number = {1},
Month = {DEC 28},
Abstract = {The purpose of the study is to examine the hotel employees' perceptions
   of adopting renewable energy in Bangladesh's hospitality industry,
   emphasizing the mediating role of management support. The necessity of
   this study stems from the hospitality sector's significant energy
   consumption and its potential to contribute to sustainable development.
   Despite global momentum, renewable energy adoption in Bangladesh remains
   limited, especially in hospitality. This study addresses this gap by
   exploring key psychological and organizational factors influencing
   adoption. Data was collected from 360 hotel employees using a structured
   questionnaire and analyzed via SmartPLS. Findings reveal that
   self-effectiveness perception, environmental concern, and renewable
   energy cost significantly influence the intention to adopt renewable
   energy, while management support plays a crucial mediating role. The
   study offers practical recommendations for policymakers and industry
   stakeholders to enhance sustainable energy practices, contributing to
   both theoretical understanding and practical implementation of renewable
   energy in emerging economies.},
