   Record, M. Thomas; Hoskins, Aaron A., Univ Wisconsin Madison, Dept Chem, Madison, WI USA.},
DOI = {10.1038/s41467-026-76721-y},
EarlyAccessDate = {AUG 2026},
Article-Number = {9683},
