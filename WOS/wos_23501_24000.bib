@article{ WOS:001234941500001,
Author = {Exilien, Romain and Warner, Laura A. and Diepenbrock, Lauren and
   Williams, Danielle and Martini, Xavier},
Title = {Residents' contribution to Asian citrus psyllid and citrus greening
   management in Florida residential habitats},
Journal = {JOURNAL OF INTEGRATED PEST MANAGEMENT},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JAN 1},
Abstract = {The Asian citrus psyllid (ACP), Diaphorina citri Kuwayama (Hemiptera:
   Psyllidae), is the world's most damaging citrus pest that transmits the
   bacteria that cause huanglongbing (HLB). In the fall of 2022, we
   investigated residents' attitudes to ACP and HLB using online surveys
   over a 9-month period. The survey gathered information on citrus grown
   in backyards and on the detection of ACP and HLB, as well as the
   management strategies used (or ready to be implemented) to control them.
   We recorded 529 responses, 218 from areas where HLB is endemic (South
   and Central Florida) and 311 from areas where HLB and ACP are still rare
   (North Florida). In the HLB area, the number of citrus grown was
   significantly reduced, and residents were more active in controlling ACP
   and HLB. Most residents were able to identify an adult psyllid from a
   photo, but only 5\% reported having seen it on their trees, in most
   cases in areas with high HLB incidence. The results also revealed
   residents' interest in managing ACP and HLB, as well as their
   willingness to participate in the search for integrated solutions to
   tackle ACP and HLB in urban habitats. Interestingly, 76\% of responders
   agreed to remove HLB trees from their backyard; this went up to 82\% if
   compensation was offered. This study provides valuable insights for
   improving backyard Extension strategies tailored to the needs and
   willingness of residents to manage ACP and HLB.
   Le psylle asiatique des agrumes (ACP), Diaphorina citri Kuwayama
   (Hemiptera: Psyllidae), est le ravageur des agrumes le plus dommageable
   au monde, servant de vecteur \& agrave; la maladie bact \& eacute;rienne
   des agrumes, huanglongbing (HLB). Durant l'automne 2022 et le printemps
   2023, nous avons \& eacute;tudi \& eacute; l'attitude des r \&
   eacute;sidents de l'\& eacute;tat de Floride face \& agrave; l'ACP et la
   maladie HLB en utilisant une enqu \& ecirc;te en ligne sur une p \&
   eacute;riode de 9 mois. L'enqu \& ecirc;te a recueilli des informations
   sur les agrumes cultiv \& eacute;s dans les arri \& egrave;re-cours des
   zones r \& eacute;sidentielles et sur la d \& eacute;tection de l'ACP et
   de la maladie HLB, ainsi que sur les strat \& eacute;gies de gestion
   utilis \& eacute;es (ou pr \& ecirc;tes \& agrave; \& ecirc;tre mises en
   oe uvre) pour les contr \& ocirc;ler. Au total, nous avons enregistr \&
   eacute; 529 r \& eacute;ponses; 218 provenaient de r \& eacute;gions o
   \& ugrave; la maladie HLB est end \& eacute;mique (sud et centre de la
   Floride) et 311 de r \& eacute;gions o \& ugrave; elle est encore rare
   (nord de la Floride). La pr \& eacute;sence de la maladie a consid \&
   eacute;rablement r \& eacute;duit le nombre d'agrumes cultiv \& eacute;s
   par les r \& eacute;sidents. En g \& eacute;n \& eacute;ral, les r \&
   eacute;sidents des r \& eacute;gions o \& ugrave; la maladie est r \&
   eacute;pandue ont \& eacute;t \& eacute; plus actifs dans la lutte
   contre l'ACP et la maladie HLB en utilisant diff \& eacute;rentes
   tactiques. La plupart des r \& eacute;sidents \& eacute;taient capables
   d'identifier une photo de psylles adultes et de nymphes, mais lorsqu'on
   leur a demand \& eacute; s'ils avaient d \& eacute;tect \& eacute; ce
   ravageur, seuls 5 \% ont d \& eacute;clar \& eacute; l'avoir vu sur
   leurs arbres, la plupart des cas se trouvant dans les zones o \& ugrave;
   la maladie est pr \& eacute;valente. Les r \& eacute;sultats ont \&
   eacute;galement r \& eacute;v \& eacute;l \& eacute; l'int \& eacute;r
   \& ecirc;t des r \& eacute;sidents pour la gestion de l'ACP et de l'HLB,
   ainsi que leur volont \& eacute; de participer \& agrave; la recherche
   de solutions int \& eacute;gr \& eacute;es pour lutter contre l'ACP et
   l'HLB dans les habitats urbains. Il est int \& eacute;ressant de noter
   que 76 \% des r \& eacute;sidents ont accept \& eacute; d'enlever les
   arbres infect \& eacute;s par la bacterie de leur jardin; ce chiffre
   passe \& agrave; 82 \% si une compensation leur est offerte. Cette \&
   eacute;tude fournit des informations utiles pour am \& eacute;liorer les
   strat \& eacute;gies de vulgarisation dans les zones r \&
   eacute;sidentielles, en les adaptant aux besoins des habitants de g \&
   eacute;rer l'ACP et l'HLB.},
