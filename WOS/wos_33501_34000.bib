@article{ WOS:001734878400001,
Author = {Shen, Xiangdong and Huang, Mingli and Chen, Xin and Liu, Zhuo and Sun,
   Yue and Ren, Weiwei},
Title = {Rigidity-elasticity-toughness mechanism for low-carbon utilization of
   environmentally-regulated cultivated land in Jiangsu, China},
Journal = {LAND USE POLICY},
Year = {2026},
Volume = {167},
Month = {AUG},
Abstract = {The use of chemical fertilizers, pesticides, and mulch in traditional
   agricultural production has caused severe environmental pollution on
   cultivated land. The practice has proven different between farmer
   behaviors and perceptions regarding the low-carbon use of cultivated
   land, but research to bridge the gap remains insufficient. This study
   first constructed a ``rigidity-elasticity-toughness{''} mechanism of
   environmental regulation. We then explored the influence of
   environmental regulation on farm households' perceptions of low-carbon
   utilization of cultivated land and behavior on the basis of
   environmental regulation theory and the DPSIR model with a sample of 868
   farm households in Jiangsu, China. The research results show that the
   three dimensions of environmental regulation trigger farmers' positive
   understanding of low-carbon utilization of cultivated land; farmers'
   understanding of low-carbon utilization of cultivated land has a
   significant positive effect on their low-carbon utilization behavior of
   cultivated land; and in regard to the relationship between farmers'
   perceived benefits, the external natural environment and low-carbon
   behavior, there is a threshold for the moderating effect of farmers'
   differentiation type. This study provides insights for agricultural
   policy-makers to formulate relevant guidance strategies from a
   regulatory perspective to promote low-carbon utilization of farmers'
   cultivated land and lowcarbon green development in the agricultural
   sector.},
