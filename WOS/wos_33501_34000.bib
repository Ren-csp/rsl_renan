@article{ WOS:000473750500114,
Author = {Cenido, Joshua F. and Freeman, C. and Bazargan-Hejazi, Shahrzad},
Title = {Environmental Interventions for Physical and Mental Health: Challenges
   and Opportunities for Greater Los Angeles},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
