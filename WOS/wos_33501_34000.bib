@article{ WOS:001667343300001,
Author = {Hasri, Muhammad Naqib and Aziz, Nazli and Sapehee, Nurul Huda and Fuad,
   Nur Qamarina Mohmad and Ahmad, Ahmad Irsyad and Tunku Shahar Tengku
   Abdul Rashid, Tengku Balkis and Udin, Nurashiqin Sallih and Latip, Abdul
   Rahman Abdul},
Title = {The influence of community perceptions and practices on the
   sustainability of Pulau Kapas Marine Park},
Journal = {JOURNAL OF COASTAL CONSERVATION},
Year = {2026},
Volume = {30},
Number = {1},
Month = {JAN 22},
Abstract = {Marine Protected Areas (MPAs) are crucial for safeguarding marine
   ecosystems. Pulau Kapas Marine Park (PKMP) is one such MPA. This study
   investigates local community's knowledge, awareness and involvement in
   conservation activities, as well as examines the relationship between
   community preparedness and the sustainability of the PKMP. Using a
   quantitative approach with 200 survey questionnaires administered to the
   local community, findings revealed that while the community acknowledges
   the environmental and socioeconomic advantages of the marine park, their
   current involvement in conservation efforts remains limited. This study
   also recorded a significant relationship between the community's
   commitment to conservation and the sustainability of PKMP. To enhance
   community engagement and ensure the long-term viability of PKMP, this
   study recommends implementing strategies that prioritise education,
   ecotourism development and effective governance.},
