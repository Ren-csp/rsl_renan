@article{ WOS:001722836500001,
Author = {Kazak, Jan K. and Phelan, Dean and Lubanska, Aleksandra and Chrobak,
   Grzegorz},
Title = {Echoes of inclusion: The soundscape of age-friendly Raheny, Dublin},
Journal = {URBAN STUDIES},
Year = {2026},
Month = {2026 MAR 25},
Abstract = {While age-friendly urban design traditionally prioritises physical
   accessibility, the acoustic environment remains a neglected dimension,
   despite it being an essential consideration in the realisation of
   restorative living conditions for older residents. This article
   investigates the soundscape in Raheny, Dublin, an area with a
   long-standing commitment to age-friendly initiatives. We adopt the ISO
   12913 framework, distinguishing the acoustic environment (physical) from
   the soundscape (perceived) with a novel approach of graph-based network
   analysis using closeness centrality metrics. The study employed seven
   soundwalks during consecutive days along routes encompassing major
   community facilities and diverse land uses. Acoustic conditions were
   systematically evaluated across main roads, residential streets, narrow
   alleyways and parks. The findings provide insight into the auditory
   environment of Raheny and its relation with well-being and social
   participation of older adults, highlighting the importance of
