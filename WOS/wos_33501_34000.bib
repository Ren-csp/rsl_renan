@article{ WOS:001478026300001,
Author = {Martinez-Laiz, Gemma and Leonard, Kaeden and Le, Chi Thai-Uyen and Le
   Hewitt, Chad Roy and Guerra-Garcia, Jose Manuel and Navarro-Barranco,
   Carlos and Garcia-Garrido, Sara and Campbell, Marnie L.},
Title = {Mapping the voices: Spanish boat owners and marina operators on
   non-indigenous marine species-knowledge and key informants},
Journal = {BIOLOGICAL INVASIONS},
Year = {2025},
Volume = {27},
Number = {5},
Month = {APR 27},
Abstract = {The public need to be aware of non-indigenous species (NIS) and how they
   spread to effectively manage this marine biosecurity risk. In most
   countries, the management of biosecurity risks associated with
   recreational boating relies exclusively on vessel owners and marina
   managers engaging in pro-environmental behaviours. To understand if this
   management approach is feasible, stakeholders' perceptions first need to
   be identified. Surveys assessed people's knowledge, awareness about NIS
   and channels involved in risk communication in three countries with
   different management scenarios and marine biosecurity histories: Spain,
   Australia and New Zealand. There was a mismatch between perceived and
   actual knowledge of NIS among respondents, with clear significant
   differences in perceptions between countries and socio-demographic
   profiles. Spanish stakeholders are significantly unaware of this
   biosecurity risk, and inaccurate knowledge was associated with specific
   media channels of the risk communication network. We provide
   recommendations to assist policymakers and science communicators when
   implementing an early risk communication strategy for Spanish
   influencing stakeholder groups.
   La gesti \& oacute;n efectiva de invasiones marinas requiere que los
   agentes implicados entiendan qu \& eacute; son las especies ex \&
   oacute;ticas marinas y c \& oacute;mo se propagan. En la mayor \&
   iacute;a de los pa \& iacute;ses no existe legislaci \& oacute;n vigente
   para limitar la propagaci \& oacute;n de estas especies por
   embarcaciones de recreo. Minimizar el riesgo depende exclusivamente de
   que los due \& ntilde;os de embarcaciones y directores de puertos
   deportivos adopten medidas voluntarias de gesti \& oacute;n. Por ello es
   prioritario examinar y mapear la percepci \& oacute;n social de estos
   grupos poblacionales. Este estudio investiga por primera vez el
   conocimiento, nivel de concienciaci \& oacute;n, y red de canales de
   comunicaci \& oacute;n sobre especies ex \& oacute;ticas marinas en Espa
   \& ntilde;a; y la compara con la de dos referentes mundiales en
   bioseguridad marina - Australia y Nueva Zelanda. Los resultados
   mostraron desajustes entre el conocimiento declarado y real sobre
   especies ex \& oacute;ticas, con claras diferencias entre pa \&
   iacute;ses y perfiles sociodemogr \& aacute;ficos. Los agentes
   implicados espa \& ntilde;oles mostraron una concienciaci \& oacute;n
   significativamente menor de c \& oacute;mo pueden propagarse estas
   especies. Al analizar el mapa de redes de comunicaci \& oacute;n, se
   detectaron varios canales asociados a desinformaci \& oacute;n. En base
   a los resultados se proporcionan recomendaciones dirigidas a gestores
   ambientales, para poder dise \& ntilde;ar intervenciones efectivas y
   respetuosas con la comunidad local en Espa \& ntilde;a.},
