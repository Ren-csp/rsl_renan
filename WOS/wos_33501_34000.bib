@article{ WOS:000563086200007,
Author = {Cerwen, Gunnar},
Title = {Listening to Japanese gardens II: expanding the soundscape action design
   tool},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2020},
Volume = {25},
Number = {5},
Pages = {643-664},
Abstract = {Tools for soundscape design have tended to focus on noise-exposed
   situations like urban parks and squares. Less attention has been given
   to multisensory interaction, movement, and other phenomenological
   aspects. This paper addresses the gap by studying the Japanese garden
   tradition, where such issues have been given high priority. The paper is
   the second of two reporting on autoethnographic field studies carried
   out in 88 Japanese gardens. Ten new Soundscape Actions are introduced
   and discussed in relation to previous research. Conclusively, the paper
   addresses the potential for future applications and developments of the
   tool.},
