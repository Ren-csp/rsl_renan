@article{ WOS:001382337400001,
Author = {Holsgens, Sander},
Title = {``I thought we were useless{''}: K-skateboarding and socio-material
   pollution in Nanjido, Seoul},
Journal = {INTERNATIONAL REVIEW FOR THE SOCIOLOGY OF SPORT},
