@article{ WOS:001228910700001,
Author = {Mandic, Sandra and Bengoechea, Enrique Garcia and Coppell, Kirsten J.
   and Keall, Michael and Smith, Melody and Hopkins, Debbie and Sandretto,
   Susan and Wilson, Gordon and Kidd, Gavin and Flaherty, Charlotte and
   Mindell, Jennifer S. and Stephenson, Janet and King, Kimberley and
   Kentala, Kaisa and Rolleston, Anna and Spence, John C.},
Title = {Travel to school patterns and perceptions of walking to school in New
   Zealand adolescents before versus during the COVID-19 pandemic},
Journal = {JOURNAL OF TRANSPORT \& HEALTH},
Year = {2024},
Volume = {36},
Month = {MAY},
Abstract = {Background: In many countries, adolescents ` active school travel rates
   were declining prior to the onset of the COVID-19 pandemic. Subsequent
   changes in active school travel have not yet been investigated
   systematically. This study compared school travel modes and adolescents
   ` perceptions of walking to school 5 -6 years before (period 1 (P1)) and
   1 -2 years after (period 2 (P2)) the onset of the COVID-19 pandemic.
   Methods: Adolescents from Dunedin, New Zealand, completed an online
   questionnaire about their school travel and perceptions of walking to
   school in 2014 -2015 (P1; n = 1463; 55.2\% female) and 2021-2022 (P2; n
   = 1421; 44.4\% female). Home -to -school distance was calculated using
   Geographic Information Systems. Data analysis included Chi-square tests,
   logistic regression and ordinary least squares regression. Results: The
   odds of adolescents walking to school `all the time' or `most of the
   time' versus `never', `sometimes' or `rarely' were significantly lower
   in P2 compared with P1. The odds following the pandemic onset were only
   0.58 of those pre -pandemic (95\% CI: 0.43-0.79), controlling for
   differences between the two samples. During the same period the
   proportion of adolescents living in households with >= 2 vehicles
   increased from 69\% to 78\%. Adolescents' attitudes towards walking to
   school indicated significantly lower intentions and higher perceived
   barriers to walking to school in P2 versus P1, although differences were
   smaller among those living within walking distance to school.
   Conclusions: These findings highlight the need for renewed and extended
   efforts from crosssectoral actors to support active school transport
   among adolescents during COVID-19 pandemic recovery efforts and in
   future similar events.},
