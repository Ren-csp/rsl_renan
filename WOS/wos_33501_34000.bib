@article{ WOS:001249180400005,
Author = {Curry, Bryony A. and Drane, Aimee L. and Atencia, Rebeca and Feltrer,
   Yedra and Calvi, Thalita and Milnes, Ellie L. and Moittie, Sophie and
   Weigold, Annika and Knauf-Witzens, Tobias and Sawung Kusuma, Arga and
   Howatson, Glyn and Palmer, Christopher and Stembridge, Mike R. and
   Gorzynski, John E. and Eves, Neil D. and Dawkins, Tony G. and Shave, Rob
   E.},
Title = {Left ventricular trabeculation in Hominidae: divergence of the
   human cardiac phenotype},
Journal = {COMMUNICATIONS BIOLOGY},
Year = {2024},
Volume = {7},
Number = {1},
Month = {JUN 14},
Abstract = {Although the gross morphology of the heart is conserved across mammals,
   subtle interspecific variations exist in the cardiac phenotype, which
   may reflect evolutionary divergence among closely-related species. Here,
   we compare the left ventricle (LV) across all extant members of the
   Hominidae taxon, using 2D echocardiography, to gain insight into the
   evolution of the human heart. We present compelling evidence that the
   human LV has diverged away from a more trabeculated phenotype present in
   all other great apes, towards a ventricular wall with proportionally
   greater compact myocardium, which was corroborated by post-mortem
   chimpanzee (Pan troglodytes) hearts. Speckle-tracking echocardiographic
   analyses identified a negative curvilinear relationship between the
   degree of trabeculation and LV systolic twist, revealing lower
   rotational mechanics in the trabeculated non-human great ape LV. This
   divergent evolution of the human heart may have facilitated the
   augmentation of cardiac output to support the metabolic and
   thermoregulatory demands of the human ecological niche.},
