@article{ WOS:001850598900001,
Author = {NeJame, Jessica and Lee, Hyeonsong and Sintov, Nicole},
Title = {Charging ahead without her? Why women in the United States are less
   willing than men to purchase electric vehicles},
Journal = {ENERGY RESEARCH \& SOCIAL SCIENCE},
Year = {2026},
Volume = {139},
Month = {SEP},
Abstract = {Electric vehicles (EVs) can help reduce greenhouse gas emissions from
   private transportation, but adoption rates are low, especially among
   women. Despite engaging in more pro-environmental behavior than men and
   owning roughly half of all vehicles, United States (U.S.) women own only
   33\% of EVs. The current study evaluates psychological mechanisms
   underpinning this gender difference. Data from a pre-registered online
   national survey (N = 1220) confirmed that U.S. men were significantly
   more willing to purchase EVs than women. Using regression-based
   mediation analysis (PROCESS Model 4), this effect was mediated by
   differences in perceived safety, range anxiety, instrumental value, and
   affective value. Specifically, relative to men, women perceive EVs and
   public charging as less safe and rate the instrumental and affective
   value of EVs lower. They also anticipate greater feelings of range
   anxiety. In turn, perceptions of safety, instrumental value, and
   affective value positively predict EV purchase intent, while range
   anxiety negatively predicts purchasing intent. In conclusion, gender
   disparities in EV adoption intentions stem in part from perceptions of
   safety and everyday usability that may be rooted in gendered mobility
   experiences.},
