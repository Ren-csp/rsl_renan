@article{ WOS:001824600000001,
Author = {Mistry, Trishna G. and Dogan, Seden},
Title = {Humanizing service robots: A multidimensional framework of
   anthropomorphism in employee-robot collaboration},
Journal = {INTERNATIONAL JOURNAL OF HOSPITALITY MANAGEMENT},
Year = {2027},
Volume = {140},
Month = {JAN},
Abstract = {Service robots are transforming hospitality, yet research on how their
   human-like traits affect employees is underdeveloped. Moreover, treating
   anthropomorphism as a homogeneous construct limits our understanding of
   how distinct features shape employee outcomes. This study investigates
   the multidimensional nature of service robot anthropomorphism and its
   relationship with hospitality employees' perception of performance
   efficacy, intrinsic motivation, and willingness to collaborate. Using a
   three-study approach grounded in anthropomorphism and uncanny-valley
   theories, it identifies three dimensions of anthropomorphism (physical
   features, cognitive-emotional functions, and vocal and communication
   features) through exploratory factor analysis, confirms their structure
   with structural equation modeling, and tests their effects among US
   hospitality employees using a time-lagged survey. Results indicate that
   cognitive-emotional functions consistently predict all outcomes and
   predict collaboration directly and also operate indirectly through
   efficacy and motivation. Physical features enhance performance efficacy
   and indirectly foster collaboration via efficacy, but do not directly
   drive motivation or collaboration. Vocal/communication features showed
   no significant effects. By modeling the dimensions together, the study
   shows that human-like features are not equally consequential for
   employees, refining anthropomorphism theory and offering practical
   guidance for service robot design in hospitality.},
