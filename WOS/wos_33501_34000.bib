@article{ WOS:000336388100005,
Author = {Miagostovich, Marize Pereira and Guimares, Flavia Ramos and Vieira,
   Carmen Baur and Fumian, Tulio Machado and da Gama, Nilson Porto and
   Victoria, Matias and de Oliveira, Jaqueline Mendes and de Oliveira
