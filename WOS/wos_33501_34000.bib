@article{ WOS:001527899700001,
Author = {Franklin, W. L.},
Title = {Foxes as pets: Case study of the Fuegian Dog and its relationship to
   extinct Indigenous cultures},
Journal = {JOURNAL OF ZOOLOGY},
Year = {2025},
Volume = {327},
Number = {1},
Pages = {5-18},
Month = {SEP},
Abstract = {Y \& aacute;manas (coastal) and Selknams (inland) were among the early
   Holocene Indigenous groups on the Switzerland-sized island of Tierra del
   Fuego at the southern tip of South America. Companion to both cultures
   was the extinct, zoologically mysterious and `domesticated' Fuegian Dog.
   The objective here was to conduct an interdisciplinary-bibliometric
   analysis of widely scattered records by historical explorers, artists
   and scientists from the middle 1700s to early 1900s for a
   characterization of this canid species, its origin and relationship with
   Indigenous peoples. This is a rare glimpse into the historical past,
   especially because both the `dog' and people are extinct. Historical
   references in the 1800s described live Fuegian Dogs as fox-like in
   appearance and behavior. Art renditions of the dog from early visitors
   to the island during James Cook's and FitzRoy-Darwin's expeditions 200
   years ago illustrated fox-like canids. In fact, recent analyses of a
   dog-museum specimen revealed that it was genetically equivalent to the
   wild Culpeo Fox (Lycalopex culpaeus) of South America. Supporting this
   evidence are more than 160 words and phrases related to `dog' in the Y
   \& aacute;mana language, suggesting this animal was long an integral
   part of their culture. Archaeological finds of paleo-pet foxes in
   Europe, North America and South America with human-like diets and/or
   shared burials suggest a close relationship with Indigenous cultures.
   Due to the absence of Domestic Dogs in the archaeological records of
   Tierra del Fuego and extreme southern Patagonia, as well as its tenuous
   relationship with Indigenous groups, its fox-like morphological
   characteristics, half-wild behavior, highly unusual food habits of
   marine shell fish, and driving of fish into trap nets, it is proposed
   that this canid was not a domesticated dog, but a semi-tame companion of
   Indigenous peoples, best described as a Fuegian Pet Fox (Lycalopex
   culpaeus).
   Los Y \& aacute;manas (de la costa) y los Selknams (del interior) fueron
   algunos de los grupos ind \& iacute;genas que habitaron Tierra del
   Fuego, una isla del tama \& ntilde;o de Suiza situada en el extremo
   meridional de Sudam \& eacute;rica. El animal de compa \& ntilde;\&
   iacute;a de ambos grupos era el extinto perro fueguino << domesticado >>
   (Lycalopex culpaeus). El objetivo de este trabajo es integrar los
   registros dispersos de exploradores, artistas y cient \& iacute;ficos
   desde mediados del siglo XVIII hasta principios del siglo XX para
   caracterizar y reconstruir esta misteriosa especie de c \& aacute;nido
   austral, su origen y su relaci \& oacute;n con los pueblos ind \&
   iacute;genas. El desaf \& iacute;o planteado es que tanto el perro como
   los grupos ind \& iacute;genas se han extinguido. Los naturalistas y
   escritores del siglo XIX describ \& iacute;an a los perros fueguinos que
   observaron como zorros, tanto en apariencia como en comportamiento. Las
   representaciones art \& iacute;sticas de este animal realizadas por los
   primeros visitantes de la isla durante las expediciones de James Cook y
   FitzRoy-Darwin, hace 200 a \& ntilde;os, ilustraban c \& aacute;nidos
   parecidos a zorros. De hecho, an \& aacute;lisis recientes de un esp \&
   eacute;cimen de perro fueguino de museo revelaron que era gen \&
   eacute;ticamente equivalente al zorro culpeo salvaje (Lycalopex
   culpaeus) de Sudam \& eacute;rica. Apoyando estas evidencias est \&
   aacute;n las m \& aacute;s de 160 palabras y frases relacionadas con el
   << perro >> en lengua y \& aacute;mana, que sugieren que este animal fue
   durante mucho tiempo parte integrante de su cultura. Los hallazgos
   arqueol \& oacute;gicos de paleo-zorros en Europa, Norteam \&
   eacute;rica y Sudam \& eacute;rica, con dietas similares a las humanas
   y/o enterramientos compartidos, sugieren una relaci \& oacute;n de
   convivencia con los humanos. Debido a la ausencia de perros dom \&
   eacute;sticos en los registros arqueol \& oacute;gicos de Tierra del
   Fuego y el extremo sur de la Patagonia, as \& iacute; como la tenue
   relaci \& oacute;n con los grupos ind \& iacute;genas, su comportamiento
   semisalvaje, sus caracter \& iacute;sticas morfol \& oacute;gicas
   similares a las de un zorro sus h \& aacute;bitos alimentarios altamente
   inusuales que inclu \& iacute;an crust \& aacute;ceos marinos y su
   utilizaci \& oacute;n por parte de los grupos humanos para la conducci
   \& oacute;n de peces hacia las redes trampa, se propone que este c \&
   aacute;nido no era un perro domesticado, sino un compa \& ntilde;ero
   semidom \& eacute;stico de los pueblos ind \& iacute;genas, mejor
   descrito como un zorro fueguino mascotizado.},
