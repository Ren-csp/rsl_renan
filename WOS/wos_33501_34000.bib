@article{ WOS:001765363800001,
Author = {Geer, L. A. and Nurse, C. and Williams, J. and Hollis, M. and Ehlke, D.
   and Valmont, M. and Hoepner, L. A.},
Title = {Evaluating youth preparedness and resilience from heat and climate
   impacts in Brooklyn, NY},
Journal = {ENVIRONMENTAL RESEARCH: HEALTH},
Year = {2026},
Volume = {4},
Number = {2},
Month = {JUN 1},
Abstract = {Extreme heat frequency and duration are increasing due to climate
   change. Effects are exacerbated in inner-city urban communities with
   little access to relief from heat. We piloted an initiative with the
   students from the Arthur Ashe Institute for Urban Health (AAIUH) to (1)
   assess perceptions of climate-related preparedness and vulnerability,
   and (2) evaluate the feasibility of a citizen science approach that
   engages youth in geospatial data collection and environmental monitoring
   of heat exposure. A cross-sectional survey was adapted from the
   `Resilient Schools Consortium Assessment' to investigate awareness and
   perceptions of preparedness for climate-related extreme weather impacts.
   AAIUH's Health Science Academy (HSA) affiliated summer program students
   (n = 58) participated in the survey. We trained a sub-cohort of HSA
   students and alumni (n = 14) in geospatial tools for heat exposure
   assessment and citizen science techniques using temperature/humidity
   monitors to study summertime residential ambient temperature. Students
   resided in neighborhoods classified as attaining environmental justice
   (EJ) or non-EJ using the NYC Taskforce on Racial Inclusion and Equity
   designations. Chi-square analyses examined associations between
   environmental areas, climate hazard experiences, and perceived
   preparedness and vulnerability. Participants were predominantly female
   (81.1\%) and Black/African American (65.5\%), with 89.7\% residing in
   Brooklyn; 23\% lived in EJ areas. Over one-third reported feeling
   unprepared for disruptions to drinking water access or cooling, and
   nearly three-quarters felt vulnerable to heatwaves. Awareness of local
   cooling centers was low (54\% unaware). Participants in non-EJ areas
   reported higher preparedness for power outages and water access compared
   to those in EJ areas. Chi-square analyses revealed significant
   differences in lifetime and neighborhood experience of summer and winter
   storms by EJ area (p < .05). Youth participatory research offers a
   promising approach to addressing environmental inequities and advancing
   urban climate resilience. Initiatives like ours can inform equitable
   adaptation strategies by linking community-generated data with public
   health education and policy engagement.},
