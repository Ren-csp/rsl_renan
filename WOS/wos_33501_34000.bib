@article{ WOS:000541216200001,
Author = {Vogelgesang, Janna R. and Walter, Melanie and Kahl, Olaf and Rubel,
   Franz and Brugger, Katharina},
Title = {Long-term monitoring of the seasonal density of questing ixodid ticks in
   Vienna (Austria): setup and first results},
Journal = {EXPERIMENTAL AND APPLIED ACAROLOGY},
