@article{ WOS:001322875100001,
Author = {Komendantova, Nadejda and Hassani, Hossein and Yeganegi, Mohammad Reza
   and Al Salaymeh, Ahmed and Qoaider, Louy},
Title = {Navigating the Currents: Land Use Challenges Amidst Water and Food
   Security Debates and Social Media Misperceptions},
