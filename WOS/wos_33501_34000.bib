@article{ WOS:001547715200001,
Author = {Marilele, Mkateko Hlongo and Kubanza, Nzalalemba Serge},
Title = {Environmental and social impacts of human settlement development
   projects in the City of Ekurhuleni Municipality, South Africa},
Journal = {LOCAL ENVIRONMENT},
Year = {2026},
Volume = {31},
Number = {7},
Pages = {996-1015},
Month = {JUL 3},
Abstract = {This paper analyses human settlement development projects' environmental
   and social impacts in the City of Ekurhuleni Municipality, South Africa.
   The socio-environmental impacts examined in this paper are noise
   pollution, safety and security, traffic congestion, waste management,
   water pollution, air pollution, ecological degradation, and land-use
   changes. Using qualitative data collected through traditional
   participatory research approaches, the study reveals that the increase
   in population in the Gauteng province, South Africa, has contributed to
   high demand for housing development projects, which further contributed
   to the continued expansion of residential areas in the City of
   Ekurhuleni Municipality. This new urban development has impacted the
   environment and social well-being of Ekurhuleni residents. The results
   revealed that current existing environmental policies are insufficient
   to tackle environmental and social impacts encountered while redressing
   spatial injustice, which contributed to unequal distribution of
   resources and opportunities in urban areas. Of particular concern is the
   absence of monitoring of projects once the construction of houses is
   completed and residents have occupied their homes. The results
   emphasised that without proper housing development plans, people will
   utilise open spaces to establish slums even though they are in a
   sensitive environment. The findings highlight the urgent need to
   understand the complex interplay between the sustainability of human
   settlements and spatial equality. Finally, the study results recommended
   the need to raise awareness among stakeholders to mitigate the
   environmental and social impacts of human settlement development
   projects in the City of Ekurhuleni Municipality.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
