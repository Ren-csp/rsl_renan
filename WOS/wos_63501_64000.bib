@article{ WOS:000418566800011,
Author = {Warren, Christopher and Matsui, Tsutomu and Karp, Jerome M. and Onikubo,
   Takashi and Cahill, Sean and Brenowitz, Michael and Cowburn, David and
   Girvin, Mark and Shechter, David},
Title = {Dynamic intramolecular regulation of the histone chaperone nucleoplasmin
   controls histone binding and release},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {DEC 20},
Abstract = {Nucleoplasmin (Npm) is a highly conserved histone chaperone responsible
   for the maternal storage and zygotic release of histones H2A/H2B. Npm
   contains a pentameric N-terminal core domain and an intrinsically
   disordered C-terminal tail domain. Though intrinsically disordered
   regions are common among histone chaperones, their roles in histone
   binding and chaperoning remain unclear. Using an NMR-based approach,
   here we demonstrate that the Xenopus laevis Npm tail domain controls the
   binding of histones at its largest acidic stretch (A2) via direct
   competition with both the C-terminal basic stretch and basic nuclear
   localization signal. NMR and small-angle X-ray scattering (SAXS)
   structural analyses allowed us to construct models of both the tail
   domain and the pentameric complex. Functional analyses demonstrate that
   these competitive intramolecular interactions negatively regulate Npm
   histone chaperone activity in vitro. Together these data establish a
   potentially generalizable mechanism of histone chaperone regulation via
   dynamic and specific intramolecular shielding of histone interaction
   sites.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Shechter, D (Corresponding Author), Albert Einstein Coll Med, Dept Biochem, 1300 Morris Pk Ave, Bronx, NY 10461 USA.
