@article{ WOS:001180826600015,
Author = {Chavali, Sai Shashank and Chou, Steven Z. and Cao, Wenxiang and Pollard,
   Thomas D. and De La Cruz, Enrique M. and Sindelar, Charles V.},
Title = {Cryo-EM structures reveal how phosphate release from Arp3 weakens actin
   filament branches formed by Arp2/3 complex},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAR 6},
Abstract = {Arp2/3 complex nucleates branched actin filaments for cell and organelle
   movements. Here we report a 2.7 angstrom resolution cryo-EM structure of
   the mature branch junction formed by S. pombe Arp2/3 complex that
   provides details about interactions with both mother and daughter
   filaments. We determine a second structure at 3.2 angstrom resolution
   with the phosphate analog BeFx bound with ADP to Arp3 and ATP bound to
   Arp2. In this ADP-BeFx transition state the outer domain of Arp3 is
   rotated 2 degrees toward the mother filament compared with the ADP state
   and makes slightly broader contacts with actin in both the mother and
   daughter filaments. Thus, dissociation of Pi from the ADP-Pi transition
   state reduces the interactions of Arp2/3 complex with the actin
   filaments and may contribute to the lower mechanical stability of mature
   branch junctions with ADP bound to the Arps. Our structures also reveal
   that the mother filament in contact with Arp2/3 complex is slightly bent
   and twisted, consistent with the preference of Arp2/3 complex binding
   curved actin filaments. The small degree of twisting constrains models
   of actin filament mechanics.
   Arp2/3 complex forms branched actin filaments for cell movements. Here,
   the authors report cryo-EM structures of branch junctions with ADP or
   ADPBeFx (to mimic gamma-phosphate) bound to Arp3 to explain why
   gamma-phosphate dissociation destabilizes branches.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
