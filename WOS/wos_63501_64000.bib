@article{ WOS:000992465700010,
Author = {Duckworth, Alexander T. T. and Ducos, Peter L. L. and McMillan, Sarah D.
   D. and Satyshur, Kenneth A. A. and Blumenthal, Katelien H. H. and
   Deorio, Haley R. R. and Larson, Joseph A. A. and Sandler, Steven J. J.
   and Grant, Timothy and Keck, James L. L.},
Title = {Replication fork binding triggers structural changes in the PriA
   helicase that govern DNA replication restart in E. coli},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {MAY 11},
Abstract = {Bacterial replisomes often dissociate from replication forks before
   chromosomal replication is complete. To avoid the lethal consequences of
   such situations, bacteria have evolved replication restart pathways that
   reload replisomes onto prematurely terminated replication forks. To
   understand how the primary replication restart pathway in E. coli
   (PriA-PriB) selectively acts on replication forks, we determined the
   cryogenic-electron microscopy structure of a PriA/PriB/replication fork
   complex. Replication fork specificity arises from extensive PriA
   interactions with each arm of the branched DNA. These interactions
   reshape the PriA protein to create a pore encircling single-stranded
   lagging-strand DNA while also exposing a surface of PriA onto which PriB
   docks. Together with supporting biochemical and genetic studies, the
   structure reveals a switch-like mechanism for replication restart
   initiation in which restructuring of PriA directly couples replication
   fork recognition to PriA/PriB complex formation to ensure robust and
   high-fidelity replication re-initiation.
   The mechanism of replication restart initiation by the bacterial DNA
   replication restart proteins PriA and PriB is resolved, revealing a
   switch-like restructuring of PriA triggered by replication fork binding
   that mediates PriA/PriB complex assembly.},
