@article{ WOS:000608479800009,
Author = {Sharma, Prashanti and Chettri, Nakul and Uddin, Kabir and Wangchuk,
   Kesang and Joshi, Rajesh and Tandin, Tandin and Pandey, Aseesh and
   Gaira, Kailash Singh and Basnet, Khadga and Wangdi, Sonam and Dorji,
   Tashi and Wangchuk, Namgay and Chitale, Vishwas Sudhir and Uprety, Yadav
   and Sharma, Eklabya},
Title = {Mapping human-wildlife conflict hotspots in a transboundary landscape,
   Eastern Himalaya},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2020},
Volume = {24},
Month = {DEC},
Abstract = {The Kangchenjunga Landscape, an important repository of biodiversity,
   faces several challenges owing to various drivers of change.
   Human-wildlife conflict (HWC) is one of such issue that transcends
   social, economic, environmental, as well as national and international
   borders among the three participating countries Bhutan, India, and Nepal
   making it a complex, transboundary issue. Based on the existing
   literature, earth observation data, and geographic information system,
   we used maximum entropy along with relevant environmental predictor
   variables to model and map HWC hotspots. The results suggested that
   about 19 per cent of the area within the landscape is at high risk of
   humanwildlife conflict, with an anthropogenic factor distance to roads
   as the top predictor. Some protected areas are at higher risk than
   others. The Himalayan subtropical pine forest ecoregion is a high HWC
   zone (similar to 63 per cent), followed by the Terai-Duars savannah and
   grasslands ecoregion (similar to 43 per cent). They also revealed that
   the lowand mid-elevation zones are prone to conflict due to greater
   forest fragmentation; patchy protected areas are disconnected from each
   other, and not big enough for large mammals like elephants and tigers.
   Human-wildlife conflict is observed to vary across different elevation
   and climate region of the landscape and highly correlated with forest
   fragmentation of the midhills. Hence, a holistic approach at the
   landscape level is needed for tackling humanwildlife conflict.
   Connecting good habitats by restoring fragmented inter and intra-country
   areas would be an effective measure to mitigate human-wildlife conflict.
   (C) 2020 The Author(s). Published by Elsevier B.V.},
