@article{ WOS:000326830900062,
Author = {Chan, Joseph Minhow and Carlsson, Gunnar and Rabadan, Raul},
Title = {Topology of viral evolution},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2013},
Volume = {110},
