@article{ WOS:000423431900001,
Author = {Xia, Hongjie and Luo, Huanle and Shan, Chao and Muruato, Antonio E. and
   Nunes, Bruno T. D. and Medeiros, Daniele B. A. and Zou, Jing and Xie,
   Xuping and Giraldo, Maria Isabel and Vasconcelos, Pedro F. C. and
   Weaver, Scott C. and Wang, Tian and Rajsbaum, Ricardo and Shi, Pei-Yong},
Title = {An evolutionary NS1 mutation enhances Zika virus evasion of host
   interferon induction},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {JAN 29},
Abstract = {Virus-host interactions determine an infection outcome. The Asian
   lineage of Zika virus (ZIKV), responsible for the recent epidemics, has
   fixed a mutation in the NS1 gene after 2012 that enhances mosquito
   infection. Here we report that the same mutation confers NS1 to inhibit
   interferon-beta induction. This mutation enables NS1 binding to TBK1 and
   reduces TBK1 phosphorylation. Engineering the mutation into a
   pre-epidemic ZIKV strain debilitates the virus for interferon-beta
   induction; reversing the mutation in an epidemic ZIKV strain invigorates
   the virus for interferon-beta induction; these mutational effects are
   lost in IRF3-knockout cells. Additionally, ZIKV NS2A, NS2B, NS4A, NS4B,
   and NS5 can also suppress interferon-beta production through targeting
   distinct components of the RIG-I pathway; however, for these proteins,
   no antagonistic difference is observed among various ZIKV strains. Our
   results support the mechanism that ZIKV has accumulated mutation(s) that
   increases the ability to evade immune response and potentiates infection
   and epidemics.},
