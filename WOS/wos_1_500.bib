@article{ WOS:001601306000001,
Author = {Xiao, Xiaomin and Zhao, Chenhao and Yu, Qiwen and Dong, Xiaobin},
Title = {Exploring tourists' perception of ecosystem services in urban park to
   promote cost-effectiveness management based multi-source data},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {Understanding the tourists' perception of ecosystem services is an
   important tool for urban park tourism management. However, traditional
   questionnaire surveys often fail to capture genuine public feedback, and
   social media data tends to represent a limited and biased user
   demographic, leading to a narrow scope in current public perception
   studies. Transforming comprehensive tourists' perceptions into
   prioritized and actionable recommendations for urban park tourism
   management remains a significant challenge in urban park governance.
   This study has established a framework for assessing ecosystem services
   with multi-source data (social media texts, photos, and questionnaires),
   and integrated the priority-setting capacity of the
   Importance-Performance Analysis (IPA) model to bridge the gap in
   existing research. With Haizhu National Wetland Park in Guangzhou as the
   research subject, this study has explored the characteristics of the
   public's perception of the importance and satisfaction of ecosystem
   services based on social media text data, and defined the importance
   evaluation by perception frequency and multiple centralities. The study
   revealed that the public attaches considerable significance to aesthetic
   appreciation, recreational and entertainment, social inclusion, and
   psycho-physical health benefits. Based on social media text and photo
   data, the degree of correlation between ecosystem services and landscape
   elements was investigated. The research discovered that aesthetic
   appreciation services were mainly linked to lakes, flowers, trees, and
   jungles. Furthermore, lakes participate in the construction of various
   ecosystem services and were the primary source of perception for these
   services. Furthermore, based on the data from the questionnaire survey,
   the perceptual differences of ecosystem services among the elderly group
   and groups with different educational levels were explored, effectively
   reconciling the potential demand contradictions. The IPA model revealed
   the priorities of ecosystem service renewal and the corresponding
   landscape elements, providing a direct basis for park governance. The
   findings can inspire urban park managers to formulate more targeted and
   efficient optimization strategies. At the same time, it can facilitate
   the comprehensive assessment of user perception and ecosystem services
   to become a more effective operational tool for tourism management.},
