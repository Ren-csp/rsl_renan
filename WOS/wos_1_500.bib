@article{ WOS:001867502600001,
Author = {Wang, Ke and Zhang, Xia and Yang, Hong and Tang, Luliang and Xie, Dong
   and Yuan, Cunyu},
Title = {Experiential factors associated with subjective well-being in urban
   waterfront environments: Evidence from social media data in Wuhan, China},
Journal = {ECOLOGICAL INDICATORS},
Year = {2026},
Volume = {190},
Month = {SEP},
Abstract = {Urban waterfront environments, as important forms of urban blue spaces,
   are increasingly recognized for their contributions to human health and
   subjective well-being (SWB). However, previous studies have mainly
   classified waterfront spaces based on waterbody attributes and examined
   the relationships between objectively measured environmental
   characteristics and health outcomes, while how spatial forms and
   functional attributes are associated with public experiences and how
   these experiential differences relate to SWB remain underexplored. To
   address these gaps, this study utilizes large-scale social media data
   from Wuhan to explore how experiential factors-including perception,
   cognition, and behavior-are associated with SWB in urban waterfront
   environments and examines their temporal dynamics and typological
   disparities. The results reveal pronounced long-term variations and
   seasonal cycles in SWB across waterfront environments that are
   associated with social and climatic conditions. Overall, physical
   activity shows the strongest association with SWB (19.12\%), followed by
   traffic (15.96\%) and crowding (9.89\%). Distinct patterns emerge across
   waterfront typologies: riverfronts, characterized by a balanced mix of
   exercise and leisure, exhibit the highest overall SWB with moderate
   seasonality; waterfront parks, more strongly associated with
   accessibility and natural environmental quality, show slightly lower SWB
   but the greatest year-round stability; and waterfront greenways,
   characterized by physical activity, display the lowest levels of SWB
   with the largest seasonal variability. This study highlights general
   experiential patterns and typology-specific differences associated with
   SWB in waterfront environments. It provides empirical evidence for
   understanding the health-related benefits of urban blue spaces and
   offers practical insights for the design and management of waterfront
   environments to promote public well-being.},
