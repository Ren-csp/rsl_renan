@article{ WOS:001693219600001,
Author = {Laszewicki, Alex and Corbera, Esteve and Anguelovski, Isabelle},
Title = {Urban and peri-urban green space use in two racialized neighborhoods of
   Barcelona, Spain},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {118},
Month = {APR},
Abstract = {Interdisciplinary research on green space use by racialized groups in
   European cities rarely applies an intersectional lens. In response, this
   study examines how race, gender, and age -and their potential
   intersectionsshape the knowledge, access, use and perceptions of urban
   and peri-urban green spaces in two highly racialized neighborhoods of
   Barcelona, Spain. Based on a survey of 230 adults, we find that
   residents born in the Global South visit urban green spaces more
   often-and with extended family-than a peri-urban protected area, and
   they prioritize child-focused improvements. Women from the Global South
   visit the protected area less frequently, citing safety concerns and
   lack of interest. Age does not appear to be a determinant of knowledge
   of or access to the urban green spaces and the protected area, but it
   does affect the type of reported company, being middle-aged respondents
   more likely to visit both types of spaces with children or family, and
   elderly people to do so with pets. Overall, these findings highlight
   distinct patterns of knowledge, access and use, showing that region of
   origin and gender strongly influence opportunities for equitable and
   inclusive leisure. We call for participatory planning and management to
   create green spaces that enhance the recreational and educational value
   of nature for all residents.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Corbera, E (Corresponding Author), Univ Autonoma Barcelona, Inst Environm Sci \& Technol, ICTA ICP Bldg,UAB Campus, Cerdanyola Del Valles 08193, Spain.
