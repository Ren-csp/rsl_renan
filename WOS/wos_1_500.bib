@article{ WOS:001575171000007,
Author = {Leon, Enrique and Yalan, Eduardo and Rivera, Andrea and de Fazio,
   Gianluca},
Title = {AMAZONIAN COMMUNITY DISCOURSES ON THE HUMAN-NATURE RELATIONSHIP},
Journal = {ANDAMIOS},
Year = {2025},
Volume = {22},
Number = {58},
Pages = {137-172},
Month = {MAY-AUG},
Abstract = {In the context of the global ecological crisis, this article analyzes
   the human-nature relationship in Amazonian communities, using the Awaj
   \& uacute;n community of Wawas in the Peruvian Amazon as a case study.
   Employing a qualitative approach, an ethnographic design was developed
   to evaluate the forms of human-nature interaction in the community,
   identifying four categories that distinguish discourses of
   compatibility, separation, incompatibility, and combination. The
   findings highlight the predominance of the discourse of compatibility,
   which frames the human-nature bond from a collective and integrative
   perspective, moving away from traditional dualism. This research
   contributes to the understanding of community-based knowledge and its
   role in sustainability and epistemic resistance to capitalist logics.},
