@article{ WOS:001506697400001,
Author = {Larson, Kelli L. and Pittson, Haden and Corley, Elizabeth A. and
   Lara-Valencia, Francisco and Haight, Jeffrey D.},
Title = {Recognitional and distributive justice in urban park access: The
   importance of subjective views},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2025},
Volume = {112},
Month = {OCT},
Abstract = {While substantial research has analyzed access to parks and open spaces
   (POS) with objective measures such as proximity to parks, far less
   research has analyzed the influence of subjective measures on park
   visitation among ethno-racial minorities. Using a recognitional and
   distributive justice approach to park access, we analyzed survey and
   geographic data from metropolitan Phoenix, Arizona (U.S.A.) to examine
   how residents' objective and subjective measures of accessibility
   interact with sociodemographic attributes to affect visitation of
   different POS: neighborhood parks, nature preserves, and urban and
   exurban water. We also examine how objective and subjective measures of
   park access differ between Latinos and Black residents compared to other
   groups. Regression models revealed that subjective access (i.e.,
   perceptions of local recreational opportunities) best predicted the
   frequency with which residents visited diverse POS, along with life
   stage factors (i.e., age and children at home). While the effects of
   objective park access measures and other sociodemographic factors varied
   across park types, Latinos visited neighborhood parks and nature
   preserves less frequently than non-Latinos, and Black residents visited
   exurban water less frequently than non-Black residents. Additionally,
   statistical comparisons of means for objective and subjective park
   access underscored both lower access to and visitation of nature
   preserves among Latino residents, who perceived significantly fewer
   opportunities for nature exploration as well as physical and social
   activities in their neighborhoods compared to non-Latinos. Black
   residents also had lower access to nature preserves and perceived fewer
   opportunities for physical activity in their neighborhoods. Given uneven
   park access and perceptions of fewer recreational opportunities among
   ethno-racial minorities, urban planners and park advocates should
   incorporate their subjective views and experiences in the local
   provisioning of POS amenities. Broadly, our results amplify the need for
   recognitional justice in park access wherein the distinct identities,
   needs, and preferences of ethno-racial minorities are considered.},
