@article{ WOS:001824875200001,
Author = {Izquierdo, Lucia and Chan, Kai M. A. and Echeverri, Alejandra and
   Ramos-Chernenko, Anna and Ibanez-Alamo, Juan Diego},
Title = {Bird-mediated cultural ecosystem services and disservices depend on
   urban residents' perceptions of birds},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2026},
Volume = {276},
Month = {DEC},
Abstract = {Urbanization influences how people interact with nature, modifying
   perceptions of nature's benefits (ecosystem services) or harms
   (ecosystem disservices or ED). In urban areas, wildlife-mediated
   ecosystem services remain understudied despite their importance for
   human well-being, particularly cultural ecosystem services (CES). The
   provision of species-mediated CES and ED also depends on the composition
   of wildlife communities, which can vary within cities. Urban areas can
   be developed in a gradient that goes from a scattered development
   (lowdensity housing with dispersed green spaces such as gardens) to a
   clumped development (high-density housing with large green spaces such
   as parks). Previous studies suggest that species composition, including
   CES and ED providers, may shift along this gradient. Yet, it remains
   unclear whether variation in these services and disservices is driven by
   differences in human perception (i.e., perception hypothesis) or by
   changes in ecological provision (i.e., species assembly hypothesis). We
   investigated both hypotheses using a multidisciplinary approach
   combining 637 in-person surveys and bird censuses across three
   Mediterranean cities. Our study identified four key CES (identity,
   educational, inspirational and bequest), disservices, and their main
   serviceproviding species. CES and ED varied across the gradient (i.e.
   higher bequest in clumped development while higher disservices in
   scattered development), mainly due to differences in residents'
   perceptions rather than changes in the underlying ecological provision.
   Perceptions were also shaped by socio-demographic factors. This
   information can help create conservation plans to enhance the perception
   of benefits and promoting CESproviding species, while minimizing the
   harms associated with urban birds.},
