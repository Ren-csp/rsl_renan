@article{ WOS:001782996200001,
Author = {Staniewska, Anna and Srodulska-Wielgus, Jadwiga and Wielgus, Krzysztof
   and Maj, Anna},
Title = {Peri-urban parks based on the remnants of the historic fortified and
   agrarian landscapes on the southern periphery of Krakow as witnesses of
   landscape change},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {122},
Month = {AUG},
Abstract = {This research explores the 150-year spatial transformation of Krakow's
   southern periphery, tracing its evolution from an agrarian landscape
   into a 19th-century fortified ``strategic landscape{''} following the
   construction of the Krakow Fortress, where greenery and visual corridors
   were deliberately designed to serve defensive purposes. Historically,
   military building restrictions preserved open fields and visual
   corridors, effectively halting suburban sprawl for decades and
   sustaining agricultural use of the fields. However, the fortress's
   obsolescence after WW II and the shift from central management after the
   collapse of the communist system in 1989, with the subsequent 2003
   abolition of master plans, triggered a phase of uncontrolled urban
   sprawl and fragmented growth. Using a mixed-methods approach-including
   historical cartographic analysis, military archives, and orthophoto
   comparisons (1970-2023) - this study quantifies the resulting
   environmental impact. Quantitative analysis via QGIS reveals a 31\% loss
   of green space in the surveyed area (Sector VIII) between 1990 and 2021,
   with detailed study areas experiencing a 36\% decline. The paper argues
   that remnants of these historical layers are vital for establishing
   peri-urban parks, such as those at Fort 52 ``Borek{''} and Fort 52a
   ``Jugowice{''}. These sites provide essential ecosystem services,
   enhance residents' well-being, and maintain cultural identity within
   high-density residential districts. By identifying universal driving
   forces, such as political shifts, economic pressures, and environmental
   sustainability, the research provides a framework for integrating
   military heritage into sustainable urban planning. This approach
   highlights the potential of post-military landscapes to serve as
   high-quality green infrastructure while safeguarding historical
   continuity against the pressures of modern urbanisation.},
