@article{ WOS:001708515600001,
Author = {Wijaya, Nurrohman and Christianti, Delia},
Title = {Assessing publicness in urban green open spaces: Lessons from Jakarta,
   Indonesia},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {1},
Pages = {360-374},
Month = {MAR},
Abstract = {Urban Green Open Spaces (GOS) are essential for enhancing urban quality
   of life by promoting health, social interaction, cultural engagement,
   and civic participation. A key aspect of their effectiveness is
   publicness, which emphasizes inclusivity and accessibility. However,
   rapid urbanization and increasing privatization have threatened these
   qualities. In Jakarta, Indonesia's capital and economic hub, where
   public GOS are limited, ensuring equitable access remains challenging
   despite government initiatives. This study investigates the level of
   publicness of two major parks in Jakarta, Tebet Eco Park (TEP) and
   Lapangan Banteng Park (LBP). Using a mixedmethods approach, including
   questionnaire distribution, interviews, and field observations, this
   study applied the VIKOR model, a multi-criteria decision-making method,
   to evaluate key publicness indicators. The findings revealed that
   accessibility, activity diversity, security and comfort significantly
   influence the publicness of GOS. Meanwhile, facility availability and
   community involvement variations contributed to differing publicness
   levels between TEP and LBP. The study underscores the importance of
   strategies that enhance accessibility, diversify activities, improve
   security and comfort, upgrade facilities, and strengthen community
   engagement to foster more inclusive public GOS. The integrative approach
   used in this study provides a comprehensive assessment of publicness in
   urban GOS, contributing valuable insights for policymakers and urban
   planners to develop more inclusive and sustainable urban development.},
