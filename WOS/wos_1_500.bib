@article{ WOS:001755182800001,
Author = {Aliyev, Tural and Fischer, Manuel and Bolliger, Janine and Pakizer,
   Katrin and Zinn, Natascha and Schmid, Noah},
Title = {Users' emotional and experiential relations to urban parks and urban
   forests},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {120},
Month = {JUN},
Abstract = {Urban green areas enhance quality of life by providing recreational,
   social, and environmental benefits -yet realizing this potential depends
   on how well spaces are designed to align with users' needs and
   experiences. With urban populations growing and green spaces under
   mounting pressure, planners and policymakers need such insights to
   design socially inclusive and environmentally resilient cities with
   green spaces that effectively support well-being, biodiversity, and
   community cohesion. Yet not all green spaces function identically. This
   study examines urban parks and urban forests in Zurich, asking about
   users' emotions and experiences related to their use of these two types
   of green areas. Using walking interviews and qualitative analysis, the
   research explores differences in emotional attachment-capturing both
   overall satisfaction and specific emotions experienced during park
   visits-and user experiences-including activities, interactions with
   nature, and perceptions of vegetation-associated with these areas.
   Findings indicate that urban parks are primarily valued for social
   interaction, leisure, and accessibility, whereas urban forests are
   appreciated for their natural aesthetics, tranquility, and restorative
   benefits. By identifying these distinctions, the study contributes to
   urban planning and environmental policy, emphasizing the importance of
   designing inclusive and sustainable green spaces that accommodate
   diverse user needs.},
