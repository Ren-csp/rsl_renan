@article{ WOS:001749289600001,
Author = {Gherri, Barbara and Rovetta, Lisa and Matoti, Sara and Petraglia,
   Alessandro},
Title = {Seasonal and Botanical Influences on External Thermal Performance near
   Green Façades: CFD Simulations on a Reference Building Envelope in a
   Humid Temperate Climate},
Journal = {ATMOSPHERE},
Year = {2026},
Volume = {17},
Number = {4},
Month = {MAR 28},
Abstract = {Green fa \& ccedil;ades are acknowledged as passive strategies that
   reduce heat accumulation, enhance biodiversity, improve particulate
   matter absorption and provide psycho-physiological benefits for users.
   However, evaluations of their thermal performance-accounting for
   seasonality, vegetation density, and leaf characteristics-remain
   incomplete. This study addresses this gap by assessing two green fa \&
   ccedil;ade typologies on a sample building located in Northern Italy
   (Cfa climate). ENVI-met microclimate simulations compared a bare wall
   with vegetated fa \& ccedil;ades featuring Hedera helix (evergreen) and
   Parthenocissus tricuspidata (deciduous) across four orientations and
   seasonal conditions, considering the sample building and the immediate
   surrounding outdoor space. Both species reduced wall-surface
   temperatures (T0) and improved outdoor thermal comfort perception (PET),
   influenced by LAI dynamics, foliage persistence, and fa \& ccedil;ade
   orientation. Results indicate that Parthenocissus tricuspidata achieved
   the greatest cooling effect during hot periods due to higher LAI, with
   absolute T0 reductions of up to 22.1 degrees C on southern fa \&
   ccedil;ades and 30.0 degrees C on western fa \& ccedil;ades. In these
   orientations, PET improvements reached up to 3.0 degrees C (south) and
   8.0 degrees C (west). Conversely, Hedera helix ensured stable year-round
   performance and performed better on northern fa \& ccedil;ades during
   colder periods. The results stress the need for integrated design that
   aligns plant choice with orientation and seasonal growth to optimize
   thermal performance, cut cooling demands, and improve outdoor comfort.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Gherri, B (Corresponding Author), Univ Parma, Dept Engn \& Architecture, I-43124 Parma, Italy.
   Gherri, Barbara; Rovetta, Lisa; Matoti, Sara, Univ Parma, Dept Engn \& Architecture, I-43124 Parma, Italy.
   Matoti, Sara, Sapienza Univ Roma IT, Dept Class, I-00185 Rome, Italy.
   Petraglia, Alessandro, Univ Parma, Dept Chem Life Sci \& Environm Sustainabil, I-43124 Parma, Italy.},
DOI = {10.3390/atmos17040342},
EarlyAccessDate = {MAR 2026},
Article-Number = {342},
EISSN = {2073-4433},
Keywords = {green fa \& ccedil;ades; microclimatic assessment; leaf area index; fa
