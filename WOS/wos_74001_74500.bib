Title = {Plant molecular responses to the elevated ambient temperatures expected
   under global climate change},
Journal = {PLANT SIGNALING \& BEHAVIOR},
Year = {2018},
Volume = {13},
Number = {1},
Abstract = {Environmental temperatures affect plant distribution, growth, and
   development. The Intergovernmental Panel on Climate Change (IPCC)
   predicts that global temperatures will rise by at least 1.5 degrees C by
   the end of this century. Global temperature changes have already had a
   discernable impact on agriculture, phenology, and ecosystems. At the
   molecular level, extensive literature exists on the mechanism
   controlling plant responses to high temperature stress. However, few
   studies have focused on the molecular mechanisms behind plant responses
   to mild increases in ambient temperature. Previous research has found
   that moderately higher ambient temperatures can induce hypocotyl
   elongation and early flowering. Recent evidence demonstrates roles for
   the phytohormones auxin and ethylene in adaptive growth of plant roots
   to slightly higher ambient temperatures.},
