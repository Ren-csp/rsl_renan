@article{ WOS:000947992300001,
Author = {Kempa, Daniela and Karrasch, Leena and Schlurmann, Torsten and
   Prominski, Martin and Lojek, Oliver and Schulte-Guestenberg, Evke and
   Visscher, Jan and Zielinski, Oliver and Goseberg, Nils},
Title = {Design and Insights Gained in a Real-World Laboratory for the
   Implementation of New Coastal Protection Strategies},
Journal = {SUSTAINABILITY},
Year = {2023},
Volume = {15},
Number = {5},
Month = {MAR},
Abstract = {Novel strategies in coastal protection are needed to cope with climate
   change-induced sea level rise. They aim at the sustainable development
   of coastal areas in light of intensification and land use changes. A
   promising approach is the design of nature-based solutions (NbS),
   complementing the safety levels of technical infrastructure. However,
   NbS lack a widespread and large-scale implementation. To address this
   deficit, co-design concepts are needed that combine experiences from
   science and practice. This work presents and discusses the approach of a
   coast-specific real-world laboratory (RwL) addressing the inclusive
   design of ecosystem-based coastal protection. Strategies of RwLs are
   applied for the first time in a coastal context along the North Sea
   coastline in Germany. We found the concept of RwLs suitable for coastal
   transdisciplinary research, although adaptions in the spatial reference
   level or flexibility in location and time of experimentation are
   necessary. A profound actor analysis is indispensable to specify
   participatory processes and interaction levels. A criteria-based
   cooperative selection of RwL sites helps to reveal and solve conflicting
   interests to achieve trust between science and practice. Addressing
   site-specific characteristics and practitioners' needs, our coastal RwL
   provides a mutual learning space to develop and test NbS to complement
   technical coastal protection.},
