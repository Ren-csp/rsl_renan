   Aghdam, Ehsan; Zayed, Tarek, Hong Kong Polytech Univ, Fac Construct \& Environm FCE, Dept Bldg \& Real Estate BRE, Hung Hom,Kowloon, Hong Kong, Peoples R China.
   Mohandes, Saeed Reza; Manu, Patrick; Cheung, Clara; Yunusa-Kaltungo, Akilu, Univ Manchester, Sch Engn, Dept Mech Aerosp \& Civil Engn, Manchester M13 9PL, England.},
DOI = {10.1016/j.jclepro.2023.137019},
EarlyAccessDate = {APR 2023},
