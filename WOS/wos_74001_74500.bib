Author = {Hagedorn, Rebecca L. and Olfert, Melissa D. and MacNell, Lillian and
   Houghtaling, Bailey and Hood, Lanae B. and Savoie Roskos, Mateja R. and
   Goetz, Jeannine R. and Kern-Lyons, Valerie and Knol, Linda L. and Mann,
