@article{ WOS:000644120500001,
Author = {Konieczny, Magdalena and Cipora, Elzbieta and Sawicka, Jolanta and Fal,
   Andrzej},
Title = {Patient Satisfaction with Oncological Care during the SARS-CoV-2 Virus
   Pandemic},
