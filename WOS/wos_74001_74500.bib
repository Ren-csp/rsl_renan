@article{ WOS:000494779100040,
Author = {Zhang, Yanzhe and Yu, Xiao},
Title = {Evaluation of Long-Term Care Insurance Policy in Chinese Pilot Cities},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
