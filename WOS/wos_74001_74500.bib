@article{ WOS:000427110100021,
Author = {Madl, Christopher M. and Heilshorn, Sarah C.},
Title = {Bioorthogonal Strategies for Engineering Extracellular Matrices},
Journal = {ADVANCED FUNCTIONAL MATERIALS},
Year = {2018},
