@article{ WOS:000473750500005,
Author = {Ferrara, Pietro and Shantikumar, Saran and Verissimo, Vitor Cabral and
   Ruiz-Montero, Rafael and Masuet-Aumatell, Cristina and Maria
   Ramon-Torrell, Josep and Buckley, Karen and Cabral Verissimo, Vitor Hugo
   and Costa, Daniela and Del Prete, Viola and Ferrara, Pietro and
   Ivankovic, Damir and Freire Duarte Peixoto, Vasco Ricoca and
   Peremiquel-Trillas, Paula and Duque, Mariana Perez and Ruiz-Montero,
