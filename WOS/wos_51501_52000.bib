@article{ WOS:001825328100018,
Author = {Chen, Peng and Meng, Lin and Lan, Lin and Feng, Jifan and Guo, Tingwei
   and Gao, Lu and Hekmat, Hana and Ly, Calista and Zhang, Mingyi and Cha,
   Sa and Ho, Thach-Vu and Chai, Yang},
Title = {TGFβ-mediated dural progenitor cell migration into the coronal suture is
   crucial for preventing craniosynostosis},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 19},
Abstract = {Cranial sutures are essential for skull growth and tissue homeostasis.
   Among them, the coronal suture is most frequently affected in syndromic
   craniosynostosis, yet the mechanisms underlying this preferential
   involvement remain unclear. Here, we show that the coronal suture
   mesenchyme undergoes a postnatal lineage transition from mesodermal to
   cranial neural crest origin, facilitated by dural cell migration into
   the suture. Mechanistically, this migration is regulated by suture TGF
   beta signals to Tgfbr2+ dural cells. Loss of dural Tgfbr2 impairs this
   cell migration into the suture, reduces the Gli1+ suture progenitor
   pool, and causes premature coronal suture fusion. Furthermore, in Twist1
   +/- mice recapitulating human Saethre-Chotzen syndrome, upregulated
   decorin leads to compromised TGF beta signaling, which impairs dural
   cell migration, leading to craniosynostosis. Significantly, restoring
   TGF beta signaling rescues coronal suture patency in Twist1 +/- mice.
   These findings identify the critical role of TGF beta-mediated
   dural-suture interactions, particularly dural cell migration, in
   maintaining coronal suture patency and provide an explanation for the
   preferential coronal fusion in syndromic craniosynostosis.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
