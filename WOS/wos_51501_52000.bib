@article{ WOS:000845964000001,
Author = {Sripho, Sirikorn and Chaiyarat, Rattanawat},
Title = {The Relationship between Population Density and Body Size of the Giant
   Mountain Crab Indochinamon bhumibol (Naiyanetr, 2001), an
   Endangered Species of Freshwater Crab from Northeastern Thailand
   (Potamoidea: Potamidae)},
Journal = {DIVERSITY-BASEL},
Year = {2022},
Volume = {14},
Number = {8},
Month = {AUG},
Abstract = {The giant mountain crab (Indochinamon bhumibol) is endemic to Loei
   Province in north-eastern Thailand. Although, little knowledge is
   available on the factors affecting population dynamics and individual
   fitness. This study aimed to investigate the relationship between the
   population density and body size of the crab. The mark-recapture method
   was conducted in Phu Ruea National Park (PR, small area) and Phu Luang
   Wildlife Sanctuary (PL, large area) between February 2018 and January
   2019. The crabs inhabited mountain streams at 400-1100 m. The average
   water depth and width were 0.6 m and 8.3 m, respectively. In total, 879
   individuals were caught from PL compared to 583 individuals from PR.
   Male were more abundant than female in both areas. Male were also larger
   and heavier, with a mean weight of 145 g, mean carapace width of 76 mm
   and mean carapace length of 75.7 mm. The average number of crabs caught
   was higher in the rainy season (66.3 individuals). The crab population
   was larger in PL (256.7 individuals), which is bigger in size than PR
   and is located farther from urban areas. The average crab density in PL
   and PR were 1.7 and 1.6 crabs/m(2), respectively. Population density was
   significantly correlated with body size parameters: body weight (r(2) =
   0.066, df = 1196, p < 0.001), carapace width (r(2) = 0.053, df = 1196, p
   < 0.001) and carapace length (r(2) = 0.067, df = 1196, p < 0.001). The
   findings of this study suggest that a large area size and high
   population density are important to the conservation of the giant
   mountain crab in mountainous forests.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Chaiyarat, R (Corresponding Author), Mahidol Univ, Fac Environm \& Resource Studies, Wildlife \& Plant Res Ctr, Salaya 73170, Nakhon Pathom, Thailand.
   Sripho, Sirikorn, Loei Rajabhat Univ, Fac Sci \& Technol, Dept Sci, Biol Program, Loei 42000, Thailand.
   Chaiyarat, Rattanawat, Mahidol Univ, Fac Environm \& Resource Studies, Wildlife \& Plant Res Ctr, Salaya 73170, Nakhon Pathom, Thailand.},
DOI = {10.3390/d14080682},
