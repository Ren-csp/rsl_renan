@article{ WOS:000586485700008,
Author = {Koulakiotis, Nikolaos Stavros and Purhonen, Pasi and Gikas, Evangelos
   and Hebert, Hans and Tsarbopoulos, Anthony},
Title = {Crocus-derived compounds alter the aggregation pathway of Alzheimer's
   Disease: associated beta amyloid protein},
Journal = {SCIENTIFIC REPORTS},
Year = {2020},
Volume = {10},
Number = {1},
Month = {OCT 23},
Abstract = {Natural products have played a dominant role in the discovery of lead
   compounds for the development of drugs aimed at the treatment of human
   diseases. This electrospray ionization-ion mobility spectrometry-mass
   spectrometry (ESI-IMS-MS)-based study demonstrates that dietary
   antioxidants, isolated components from the stigmas of saffron (Crocus
   sativus L.) may be effective in inhibiting A beta fibrillogenesis, a
   neuropathological hallmark of Alzheimer's Disease (AD). This study
   reveals a substantial alteration in the monomer/oligomer distribution of
   A beta (1-40,) concomitant with re-direction of fibril formation,
   induced by the natural product interaction. These alterations on the A
   beta (1-40) aggregation pathway are most prominent for trans-crocin-4
   (TC4). Use of ESI-IMS-MS, electron microscopy alongside Thioflavin-T
   kinetics, and the interpretation of 3-dimensional Driftscope plots
   indicate a correlation of these monomer/oligomer distribution changes
   with alterations to A beta (1-40) amyloid formation. The latter could
   prove instrumental in the development of novel aggregation inhibitors
   for the prevention, or treatment of AD.},
Publisher = {NATURE PORTFOLIO},
