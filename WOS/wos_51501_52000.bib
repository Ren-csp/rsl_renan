@article{ WOS:000485041400021,
Author = {Sicard, Anne and Merfa, Marcus V. and Voeltz, Michael and Zeilinger,
   Adam R. and De La Fuente, Leonardo and Almeida, Rodrigo P. P.},
Title = {Discriminating between viable and membrane-damaged cells of the plant
   pathogen Xylella fastidiosa},
Journal = {PLOS ONE},
Year = {2019},
Volume = {14},
Number = {8},
Month = {AUG 23},
Abstract = {Xylella fastidiosa is a plant pathogenic bacterium with devastating
   consequences to several crops of economic importance across the world.
   While this pathogen has been studied for over a century in the United
   States, several aspects of its biology remain to be investigated.
   Determining the physiological state of bacteria is essential to
   understand the effects of its interactions with different biotic and
   abiotic factors on cell viability. Although X. fastidiosa is culturable,
   its slow growing nature makes this technique cumbersome to assess the
   physiological state of cells present in a given environment. PMA-qPCR,
   i.e. the use of quantitative PCR combined with the pre-treatment of
   cells with the dye propidium monoazide, has been successfully used in a
   number of studies on human pathogens to calculate the proportion of
   viable cells, but has less frequently been tested on plant pathogens. We
   found that the use of a version of PMA, PMAxx, facilitated
   distinguishing between viable and non-viable cells based on cell
   membrane integrity in vitro and in planta. Additional experiments
   comparing the number of culturable, viable, and total cells in planta
   would help further confirm our initial results. Enhancers, intended to
   improve the efficacy of PMAxx, were not effective and appeared to be
   slightly toxic to X. fastidiosa.},
