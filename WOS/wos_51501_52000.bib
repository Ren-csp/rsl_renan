@article{ WOS:001574445000001,
Author = {Abate, Menbere and Sekhar, P.},
Title = {Drinking water quality and health implications in Garba Town, West Guji
   Zone, Ethiopia: an integrated analysis of physico-chemical, microbial,
   and social dimensions},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2025},
Volume = {7},
Number = {9},
Month = {SEP 1},
Abstract = {Drinking water pollution and resulting waterborne diseases pose
   significant public health risks in low-income countries like Ethiopia.
   This study aimed to assess the quality of drinking water in Garba Town,
   Bule Hora Woreda, West Guji Zone, focusing on physico-chemical and
   bacteriological parameters while also examining the community's
   knowledge and attitudes towards water quality. A cross-sectional study
   design was employed, incorporating household surveys and water sampling
   from both improved and unimproved sources. Physico-chemical parameters
   such as pH, turbidity, total dissolved solids, and nitrate levels were
   analysed, while bacteriological analysis focused on the presence of
   total and faecal coliforms. Pearson correlation analysis, Chi-square
   tests, and Water Quality Index (WQI) were used to analyse relationships
   and assess water quality. Physico-chemical analysis showed concerning
   conditions across several parameters: pH (6.5-8.2), turbidity (3.2-9.7
   NTU), total dissolved solids (213-728 mg l(-1)), and nitrate levels
   (2.1-29.8 mg l(-1)), all of which adversely affected water quality.
   Significant relationships were found between nitrate and turbidity (r =
   0.78, p < 0.01). Bacteriological analysis revealed widespread
   contamination, with 87.5\% of samples testing positive for coliforms.
   WQI results classified several water sources as polluted, including the
   Catholic Church reservoir (WQI = 91.4), household storage (WQI = 92),
   and Garba Town reservoir (WQI = 109.29), the latter of which was deemed
   unsuitable for drinking. Additionally, 42.9\% of respondents reported
   experiencing water-related health issues, including diarrhoea (54.7\%)
   and skin rashes (22.3\%). The study highlights the urgent need for
   improved water treatment, enhanced public education, and community-based
   solutions to mitigate waterborne diseases and improve public health in
   Garba Town. Education and gender differences were also found to
   influence waterborne disease awareness and preventive practices,
   indicating the potential for targeted interventions based on demographic
   factors.},
