@article{ WOS:001815685200018,
Author = {Magan, Giovana Hurtado},
Title = {Importance of courses in the curriculum of law degrees at Peruvian
   universities: A study based on a sample of nine universities},
Journal = {REVISTA DE PEDAGOGIA UNIVERSITARIA Y DIDACTICA DEL DERECHO},
Year = {2026},
Volume = {13},
Number = {1},
Pages = {343-364},
Abstract = {This study examines the initial training of lawyers in Peru by
   conducting a content analysis of the graduate profiles reported by the
   leading universities in Lima and by surveying the perceptions of 259
   students from nine Peruvian universities regarding the courses they
   consider most relevant to their professional training. The findings
   reveal a market-driven legal education and a high concentration of
   students in the capital. It is noted that certain universities offer
   distinct specializations in Criminal Law, Corporate Law, and
   constitutional issues. The results indicate that Civil Law and Civil
   Procedural Law are the areas most valued by students. In contrast,
   cross-disciplinary subjects such as Environmental Law and foreign
   language proficiency received the lowest levels of perceived relevance.
   Finally, there is evidence of alignment between student expectations and
   institutional orientation.},
