Author = {Yi, Jae-Sung and Park, Jun Sub and Ham, Young-Mi and Nguyen, Nga and
   Lee, Na-Rae and Hong, Jin and Kim, Bong-Woo and Lee, Hyun and Lee,
   Chang-Seok and Jeong, Byung-Cheon and Song, Hyun Kyu and Cho, Hana and
   Kim, Yoon Ki and Lee, Jae-Seon and Park, Kyong Soo and Shin, Haksub and
   Choi, Inho and Lee, Seung Hee and Park, Woo Jin and Park, Shi-Young and
   Choi, Cheol Soo and Lin, Peihui and Karunasiri, Malith and Tan, Tao and
   Duann, Pu and Zhu, Hua and Ma, Jianjie and Ko, Young-Gyu},
Title = {MG53-induced IRS-1 ubiquitination negatively regulates skeletal
   myogenesis and insulin signalling},
Journal = {NATURE COMMUNICATIONS},
Year = {2013},
Volume = {4},
Month = {AUG},
Abstract = {Mitsugumin 53 (MG53) negatively regulates skeletal myogenesis by
   targeting insulin receptor substrate 1 (IRS-1). Here, we show that MG53
   is an ubiquitin E3 ligase that induces IRS-1 ubiquitination with the
   help of an E2-conjugating enzyme, UBE2H. Molecular manipulations that
   disrupt the E3-ligase function of MG53 abolish IRS-1 ubiquitination and
   enhance skeletal myogenesis. Skeletal muscles derived from the MG53(-/-)
   mice show an elevated IRS-1 level with enhanced insulin signalling,
   which protects the MG53(-/-) mice from developing insulin resistance
   when challenged with a high-fat/high-sucrose diet. Muscle samples
   derived from human diabetic patients and mice with insulin resistance
   show normal expression of MG53, indicating that altered MG53 expression
   does not serve as a causative factor for the development of metabolic
   disorders. Thus, therapeutic interventions that target the interaction
   between MG53 and IRS-1 may be a novel approach for the treatment of
   metabolic diseases that are associated with insulin resistance.},
