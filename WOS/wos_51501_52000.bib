@article{ WOS:001565626300001,
Author = {Sagasti, Ana Julia and Burne, Sophie and Wyman, Jeremy and Hetherington,
   Alexander J.},
Title = {Decay stages of Jurassic wood debris from Scotland: evidence for the
   coevolution of fungal rot, arthropods and the nurse log strategy},
Journal = {NEW PHYTOLOGIST},
Year = {2025},
Volume = {248},
Number = {3},
Pages = {1557-1571},
Month = {NOV},
Abstract = {A key feature of extant conifer forests is the high percentage of seeds
   that germinate and establish on dead wood; in some forests, this can
   exceed 90\%. This deadwood can act as an ideal nursery for young tree
   species, leading to this type of seedbed being termed `nurse logs'. It
   is unclear how common this ecological strategy has been throughout the
   evolutionary history of conifers. Here, we describe a c.
   150-million-year-old wood fragment from the Jurassic of Scotland using
   classic palaeobotanical techniques and microscopy. We interpret our new
   finding within the evolution of gymnosperms with a literature review of
   fossil nurse logs, and fungal and arthropod evolution. We interpret the
   timeline of decay processes on this log as consisting of three main
   stages: breakdown of the wood by white pocket rot; two types of
   arthropod boring, likely by beetles and mites; and colonisation by small
   roots. These findings demonstrate the complexity of decay processes
   occurring on a Jurassic forest floor, and the key role that white rot
   and arthropods play in the nurse log ecological strategy. Conifer
   germination on nurse logs facilitated by white rot fungi is a conserved
   ecological strategy of relevance in shaping forest ecosystems over
   geological timescales.
   Los bosques modernos de con \& iacute;feras se caracterizan por el alto
   porcentaje de semillas que se establecen y germinan en fragmentos de
   madera. En algunos bosques, este porcentaje puede exceder el 90\%. Los
   fragmentos de madera constituyen un substrato ideal para el
   establecimiento de \& aacute;rboles j \& oacute;venes en lo que se ha
   denominado `nurse logs'. Sin embargo, no est \& aacute; claro qu \&
   eacute; tan com \& uacute;n ha sido esta estrategia ecol \& oacute;gica
   a lo largo de la historia evolutiva de las con \& iacute;feras. En este
   trabajo describimos un fragmento de madera proveniente del Jur \&
   aacute;sico de Escocia (ca. 150 millones de a \& ntilde;os) utilizando t
   \& eacute;cnicas cl \& aacute;sicas de paleobot \& aacute;nica y
   microscop \& iacute;a. Los resultados de este an \& aacute;lisis son
   interpretados en el contexto de la evoluci \& oacute;n de las
   gimnospermas a trav \& eacute;s de una revisi \& oacute;n bibliogr \&
   aacute;fica enfocada en el registro f \& oacute;sil de los `nurse logs'
   y la evoluci \& oacute;n de hongos y artr \& oacute;podos. Realizamos
   una reconstrucci \& oacute;n del proceso de decaimiento del fragmento de
   madera que consiste de tres etapas principales: desgaste de la madera
   por acci \& oacute;n de pudrici \& oacute;n blanca, excavaci \& oacute;n
   de galer \& iacute;as de artr \& oacute;podos, probablemente escarabajos
   y \& aacute;caros, y por \& uacute;ltimo el establecimiento de ra \&
   iacute;ces peque \& ntilde;as. Nuestro an \& aacute;lisis demuestra la
   complejidad de los procesos de decaimiento que ocurrieron en el suelo de
   un bosque jur \& aacute;sico, y el rol clave que representan la pudrici
   \& oacute;n blanca y la actividad de artr \& oacute;podos en la
   estrategia ecol \& oacute;gica `nurse log'. Nuestros resultados sugieren
   que la germinaci \& oacute;n de semillas de con \& iacute;feras en
   `nurse logs' se ve facilitada por la actividad de podredumbre blanca y
   representa una estrategia ecol \& oacute;gica de relevancia en la
   conformaci \& oacute;n de ecosistemas forestales a lo largo del tiempo
   geol \& oacute;gico.},
Publisher = {WILEY},
