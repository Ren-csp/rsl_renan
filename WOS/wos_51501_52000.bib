@article{ WOS:001787375300014,
Author = {Saucedo-Calzada, Rafael and Almeida-Garcia, Fernando and Cortes-Macias,
   Rafael},
Title = {Urban Overtourism Governance: A Configurational Analysis of Resident
   Stress and Sustainability},
Journal = {PASOS-REVISTA DE TURISMO Y PATRIMONIO CULTURAL},
Year = {2026},
Volume = {24},
Number = {3},
Month = {JUL-SEP},
Abstract = {This study examines how urban overtourism shapes residents' emotional
   stress and perceptions of sustainability. Focusing on M \& aacute;laga,
   Spain, the research highlights the growing importance of psychosocial
   well-being in tourism governance. The objective is to identify how
   governance configurations - particularly participatory and
   sustainability-oriented policies - affect residents' experiences under
   tourism pressure. A multi-analysis design combines covariance-based
   structural equation modelling (CB-SEM) with fuzzy-set causal pathways to
   both high and low stress, showing that environmental benefits alone do
   not mitigate negative impacts when trust and participation are lacking.
   Findings suggest that resilience depends on perceived fairness,
   responsiveness, and visible improvements in urban life. This study
   contributes to theory by integrating urban stress, carrying capacity,
   and regenerative tourism frameworks. It concludes that tourism in
   overtouristed cities.},
