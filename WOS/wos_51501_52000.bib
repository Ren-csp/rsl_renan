@article{ WOS:001831041000003,
Author = {Rodrigues, Daniel A. and Wang, Yu and Goulart Stollmaier, Juana and
   Sullivan, Graeme P. and D'Arcy, Cian and Coughlan, Aisling Y. and Roe,
   Andrew and Biro, Linda and Watson, Paris R. and Osko, Jeremy D. and
   Twamley, Brendan and Wynne, Kieran and Cagney, Gerard and Buglyo, Peter
   and Liu, Yanli and Griffith, Darren M. and Christianson, David W. and
   Chonghaile, Triona Ni},
Title = {Identification of a mechanism-based binding mode for a histone
   deacetylase 6 inhibitor},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUN 5},
Abstract = {Histone deacetylase 6 (HDAC6) is a cytoplasmic enzyme that deacetylates
   non-histone substrates such as alpha-tubulin and cortactin. HDAC6
   contains two catalytic domains, each containing a catalytic zinc ion,
   and a zinc-finger ubiquitin-binding domain. We have discovered BAS-2, a
   selective HDAC6 inhibitor with an isothiouronium core and no obvious
   zinc-binding group. To define its mechanism, we combine X-ray
   crystallography, structure-activity-relationships, molecular modeling
   and mutagenesis. BAS-2 potently inhibits human HDAC6 but it does not
   inhibit zebrafish HDAC6. Computational modeling highlighted Asp567 in
   human HDAC6 as critical for BAS-2 recognition and mutational analyses
   confirmed this. The corresponding zebrafish residue is Asn530 and the
   crystal structure of the N530D variant zHDAC6 revealed binding of a
   BAS-2-derived mercaptoacetamide that engages the catalytic zinc via
   strong thiolate-zinc coordination. Leveraging the orientation of BAS-2
   binding, we designed a BAS-2-based proteolysis targeting chimera that
   induced proteasome-dependent HDAC6 degradation in cells, verified by
   global proteomics. Collectively, these insights clarify species
   selectivity and demonstrate that BAS-2 acts as a selective,
   mechanism-based inhibitor of human HDAC6. These discoveries will aid the
   development of the next generation of selective HDAC6 inhibitors and
   degraders.},
