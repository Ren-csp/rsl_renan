@article{ WOS:000474829600017,
Author = {Fabbri, J. and Elissondo, M. C.},
Title = {Experimental murine model of neurocysticercosis: first report of
   cerebellum as a location for Mesocestoides corti tetrathyridia},
Journal = {JOURNAL OF HELMINTHOLOGY},
