@article{ WOS:A1982PU41500007,
Author = {FOLINSBEE, LJ and GLINER, JA and HORVATH, SM},
Title = {PERCEPTUAL CUES USED IN REPRODUCTION OF INSPIRED VOLUME},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1982},
Volume = {32},
Number = {5},
Pages = {449-453},
Abstract = {Man is capable of reproducing an inspired lung volume (IV) with relative
   precision (.+-. 3-8\%). To investigate the importance of cues which may
   be used to determine IV, 2 experiments were performed. In each, the
   subject inspired a standard breath (from resting end-expired lung
   volume) corresponding to 25, 50 or 75\% of inspiratory capacity (IC) and
   then expired nearly completely. From this expired volume, the subject
   either tried to reproduce the tidal volume (i.e., volume of air
   inspired) of the 1st breath (volume reproduction) or to reproduce the
   previous end-inspired lung volume (position reproduction). The constant
   error indicated that subjects overestimated tidal volume by .apprx. 200
   ml. Despite this overestimation, the variability of reproduction was
   less for volume reproduction than for position reproduction when IV was
   small. The JND {[}SD of individual constant errors .times. 0.6745] for
   volume reproduction increased linearly with increasing IV, while the JND
   for position reproduction was similar at all IV so that the Weber ratio
   decreased. These observations suggest that, in the perception of
   inspired volume, the sensation of end-inspired position was important
   when the inspired volume was large, but that subjects apparently relied
   on some other cue to reproduce small lung volumes accurately.},
Publisher = {PSYCHONOMIC SOC INC},
Address = {1710 FORTVIEW RD, AUSTIN, TX 78704 USA},
