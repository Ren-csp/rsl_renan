@article{ WOS:001264080400001,
Author = {Urteaga, Eguzki},
Title = {INEQUALITIES IN FACE OF UNCERTAINTY},
Journal = {BARATARIA-REVISTA CASTELLANO-MANCHEGA DE CIENCIAS SOCIALES},
Year = {2024},
Number = {35},
Pages = {93-110},
Abstract = {Nowadays, due to several mutations, we are entering a society of
   uncertainty, where it is becoming increasingly diverse and intense, to
   the point of translating into an increase of risks and an exacerbation
   of their social perception, which in turn provokes a growing insecurity
   and a feeling of insecurity, primarily at the social level. This leads
   to a growing inability to foresee future events and major difficulties
   in projecting oneself into the future, which has an impact on the rise
   of contemporary phenomena such as presentism, conspiracy, populism, and
   fundamentalism. However, if the rise of uncertainty concerns all
   contemporary societies, not all actors are exposed to it in the same way
   and in the same proportions, whether it is in relation to environmental
   risks, geopolitical tensions, economic disparities, or social
   inequalities.},
