@article{ WOS:000298438300001,
Author = {Zhang, Chunming and Yang, Xiaofan and Liu, Wanping and Yang, Lu-Xing},
Title = {An Efficient Therapy Strategy under a Novel HIV Model},
Journal = {DISCRETE DYNAMICS IN NATURE AND SOCIETY},
Year = {2011},
Volume = {2011},
Abstract = {By incorporating the chemotherapy into a previous model describing the
   interaction of the immune system with the human immunodeficiency virus
   (HIV), this paper proposes a novel HIV virus spread model with control
   variables. Our goal is to maximize the number of healthy cells and,
   meanwhile, to minimize the cost of chemotherapy. In this context, the
   existence of an optimal control is proved. Experimental results show
   that, under this model, the spread of HIV virus can be controlled
   effectively.},
