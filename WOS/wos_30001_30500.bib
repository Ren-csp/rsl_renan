@article{ WOS:000582681400018,
Author = {Manor, Ohad and Dai, Chengzhen L. and Kornilov, Sergey A. and Smith,
   Brett and Price, Nathan D. and Lovejoy, Jennifer C. and Gibbons, Sean M.
   and Magis, Andrew T.},
Title = {Health and disease markers correlate with gut microbiome composition
   across thousands of people},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {OCT 15},
Abstract = {Variation in the human gut microbiome can reflect host lifestyle and
   behaviors and influence disease biomarker levels in the blood.
   Understanding the relationships between gut microbes and host phenotypes
   are critical for understanding wellness and disease. Here, we examine
   associations between the gut microbiota and similar to 150 host
   phenotypic features across similar to 3,400 individuals. We identify
   major axes of taxonomic variance in the gut and a putative diversity
   maximum along the Firmicutes-to-Bacteroidetes axis. Our analyses reveal
   both known and unknown associations between microbiome composition and
   host clinical markers and lifestyle factors, including host-microbe
   associations that are composition-specific. These results suggest
   potential opportunities for targeted interventions that alter the
   composition of the microbiome to improve host health. By uncovering the
   interrelationships between host diet and lifestyle factors, clinical
   blood markers, and the human gut microbiome at the population-scale, our
   results serve as a roadmap for future studies on host-microbe
   interactions and interventions.},
