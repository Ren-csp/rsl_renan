@article{ WOS:000328895500011,
Author = {Wendling, Zachary A. and Attari, Shahzeen Z. and Carley, Sanya R. and
   Krause, Rachel M. and Warren, David C. and Rupp, John A. and Graham,
   John D.},
Title = {On the Importance of Strengthening Moderate Beliefs in Climate Science
   to Foster Support for Immediate Action},
Journal = {SUSTAINABILITY},
Year = {2013},
Volume = {5},
Number = {12},
Pages = {5153-5170},
Month = {DEC},
Abstract = {Whereas many studies focus on climate skeptics to explain the lack of
   support for immediate action on climate change, this research examines
   the effect of moderate believers in climate science. Using data from a
   representative survey of 832 Indiana residents, we find that agreement
   with basic scientific conclusions about climate change is the strongest
   predictor of support for immediate action, and the strength of that
   agreement is an important characteristic of this association. Responses
   indicate widespread acceptance of climate change, moderate levels of
   risk perception, and limited support for immediate action. Half of the
   respondents (50\%) preferred. more research. over. immediate action.
   (38\%) and. no action. (12\%) as a response to climate change. The
   probability of preferring immediate action is close to zero for those
   who strongly or somewhat disbelieve in climate change, but as belief in
   climate change grows from moderate to strong, the probability of
   preferring immediate action increases substantially; the strongest
   believers have a predicted probability of preferring immediate action of
   71\%. These findings suggest that, instead of simply engaging skeptics,
   increasing public support for immediate action might entail motivating
   those with moderate beliefs in climate change to hold their views with
   greater conviction.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Wendling, ZA (Corresponding Author), Indiana Univ, Sch Publ \& Environm Affairs, 1315 East 10th St, Bloomington, IN 47405 USA.
   Wendling, Zachary A.; Attari, Shahzeen Z.; Carley, Sanya R.; Warren, David C.; Graham, John D., Indiana Univ, Sch Publ \& Environm Affairs, Bloomington, IN 47405 USA.
   Krause, Rachel M., Univ Kansas, Sch Publ Affairs \& Adm, Lawrence, KS 66045 USA.
   Rupp, John A., Indiana Geol Survey, Bloomington, IN 47405 USA.},
