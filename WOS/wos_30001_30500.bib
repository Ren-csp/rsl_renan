@article{ WOS:000532688300009,
Author = {Long Tao and Sun Yingyuan and Hassan, Abdirahman and Qi Xiaofeng and Li
   Xiaochun},
Title = {Structure of nevanimibe-bound tetrameric human ACAT1},
