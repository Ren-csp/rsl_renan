@article{ WOS:001261350800001,
Author = {Balassa, Boglarka Eisinger and Nagy, Nikolett Gyurian and Gyurian,
   Norbert},
Title = {Perception and social acceptance of 5G technology for sustainability
   development},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2024},
Volume = {467},
Month = {AUG 15},
Abstract = {This research was carried out to enable a better understanding of the
   attitudes of Hungarian consumers and future users towards 5G technology.
   The development of 5G technology supports social, economic and
   environmental sustainability together. Among other things, innovative
   communities, economic progress and a reduction of the carbon footprint
   can be positive outcomes of 5G. For example 5G benefits the environment
   in two ways: it helps telecom operators reduce their energy usage, thus
   lowering their environmental impact, and it provides tools that telecom
   companies can use to assist others in reducing their environmental
   footprint. The Partial Least Squares (PLS) regression method was used to
   establish the correlations between the five factor groups. Research
   indicates a prevalent skepticism among Hungarian consumers toward 5G
   technology, characterized by apprehensions regarding health risks and a
   lack of perceived competitive advantages or inherent business benefits
   to adopting 5G. This hesitancy must be countered by transparently
   addressing health concerns, debunking myths, and building a foundational
   trust in 5G technologies through comprehensive educational and
   awareness-raising initiatives, aligning technological advancements with
   consumer confidence and acceptance. 5G must be demystified so that
   consumers will come to trust the technology and embrace its adoption.
   Due to the similar technological conditions and historical backgrounds
   of the Central European Countries (CEC), the results of this research
   will prove useful to policymakers throughout the region.},
