@article{ WOS:000454679900010,
Author = {del-Toro, N. and Duesbury, M. and Koch, M. and Perfetto, L. and
   Shrivastava, A. and Ochoa, D. and Wagih, O. and Pinero, J. and Kotlyar,
   M. and Pastrello, C. and Beltrao, P. and Furlong, L. I. and Jurisica, I.
   and Hermjakob, H. and Orchard, S. and Porras, P. and Khadake, J. and
   Meldal, B. and Panni, S. and Thorneycroft, D. and Van Roey, K. and
   Abbani, S. and Salwinski, L. and Pellegrini, M. and Iannuccelli, M. and
   Licata, L. and Cesareni, G. and Roechert, B. and Bridge, A. and Ammari,
   M. G. and McCarthy, F. and Broackes-Carter, F. and Campbell, N. H. and
   Melidoni, A. N. and Rodriguez-Lopez, M. and Lovering, R. C. and
