@article{ WOS:001739328600001,
Author = {Gerra-Inohosa, Linda and Pentjusa, Liga and Jurmalis, Edgars and
   Libiete, Zane},
Title = {People's perceptions of well-being aspects related to forest roads and
   roadsides in Latvia},
Journal = {ECOSYSTEMS AND PEOPLE},
Year = {2026},
Volume = {22},
Number = {1},
Month = {DEC 31},
Abstract = {The area of ecosystems that are anthropogenically created or heavily
   impacted by anthropogenic activities is increasing globally. A notable
   example is forest roads, which may have positive impacts on the economy
   but potentially adverse effects on biodiversity, for example, changes in
   plant species and animal behaviour. Aiming to assess the benefits and
   potential negative impacts of forest roads, we carried out a
   representative nationwide survey on societal attitudes towards forest
   roads and road verges. The survey included general perception of forest
   roads, their importance in providing non-timber forest products,
   recreation opportunities and amenity services, as well as their role in
   enhancing negative aspects of nature related to health and safety. Our
   research results highlighted the significance of transportation network
   functions of forest roads, especially of wide gravel motor roads with
   managed roadsides. At the same time, smaller roads covered with
   vegetation and without managed verges had higher scenic value. The
   tick-borne diseases were the most important disservices; however, the
   recognized disservices did not affect the stated use of forest roads.
   Our study also revealed gender differences, for example, greater female
   activity in the use of almost all ecosystem services, except hunting.
   Female respondents also assigned greater importance to all ecosystem
   disservices than male respondents. Our study explored the importance of
   forest roads and their verges from the perspective of people's
   lifestyles. By including environmental aspects in the planning and
   management of forest roads, we could enhance their wider societal
   importance in facilitating people's connection with nature and
   increasing their multifunctional use.},
