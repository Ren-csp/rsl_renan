@article{ WOS:001730763000004,
Author = {Deressa, Tolamariam Chimdessa and Chalchissa, Fedhasa Benti and Gemeda,
   Dessalegn Obsi},
Title = {Teff farmers' climate change perception, adaptation strategies and their
   determinants and constraints in Horro Guduru Wallaga Zone, Ethiopia},
Journal = {DISCOVER ENVIRONMENT},
Year = {2026},
Volume = {4},
Number = {1},
Month = {MAR 31},
Abstract = {This study assesses how teff farmers' perception of climate change,
   identifies adaptation strategies, and analyzes factors influencing their
   adoption in the Horro Guduru Wallaga zone, Ethiopia. A survey was
   conducted with 352 respondents selected by a multistage sampling
   technique. The Climate Change Risk Perception Index (CCRPI) and Problem
   Confrontation Index (PCI) were used to assess farmers' perception of
   climate change and constraints of climate change adaptation. The
   determinants of the famers' decision to adopt adaptation strategies were
   analyzed using a multivariate probit model. Increased rainfall onset and
   cessation unpredictability, and extended rainfall cessation were the
   most commonly perceived changes in climate stimuli. Soil and water
   conservation and mass mobilization of household members are the most
   important climate change adaptation strategies. Low availability of
   improved teff varieties and limited access to agricultural
   mechanizations and climate information are the main challenges to
   climate change adaptation in the area. The results reveal that male
   headship and higher education level are the main drivers of adopting
   adjusting sowing date, soil and water conservation, and improved crop
   varieties. However, male headship and a higher education level of the
   household head reduce the decision to use household mobilization. Most
   of the teff producers in the study area perceived climate change, but
   the adoption of different adaptation strategies is highly affected by
   different socioeconomic and institutional factors. To improve farmers'
   adaptation to climate change, gender-responsive adaptation policies like
   improving access to improved teff varieties and agricultural
   mechanizations and promoting adult learning that involves female farmers
   are recommended.},
