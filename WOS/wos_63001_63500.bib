@article{ WOS:001836361000001,
Author = {Agengo, Yvonne and Blackwell, Alexandra and Mwamba, Gad and
   Rakotomalala, Sabine and Cluver, Lucie and Langwenya, Nontokozo},
Title = {Beyond the visible: Centering adolescent voices in conceptualising
   violence in conflict settings},
Journal = {SOCIAL SCIENCE \& MEDICINE},
Year = {2026},
Volume = {406},
Month = {OCT},
Abstract = {Measures of violence against children (VAC) categorise violence as
   physical, emotional, sexual violence and neglect. While used globally,
   these measures may not reflect how conflict-affected adolescents
   conceptualise harm. Drawing on child rights, structural violence, and
   feminist frameworks, this study explores how adolescents living in
   conflict-affected Democratic Republic of Congo (DRC) conceptualise
   violence. Methods: We conducted four same-sex group discussions with 36
   adolescents (20 girls, 16 boys) aged 13-17 years old in the DRC.
   Participants discussed daily experiences in their community: things they
   like, and good and bad things they experience. Inductive and deductive
   thematic analysis were used to identify forms of violence discussed,
   which were then mapped onto measures of VAC to explore how well existing
   tools capture their experiences. Results: Adolescents described
   experiences of violence consistent with physical, emotional and sexual
   violence, child neglect and labour, which are all commonly recognised in
   existing tools. Less commonly recognised forms described included
   economic control, negative social perceptions and ill-labelling, taking
   on parental responsibility, and environmental hazards and safety
   concerns in the community. Gender differences emerged with economic
   maltreatment predominantly described by boys and sexual exploitation
   linked to unmet needs described only by girls. Conclusion: When
   adolescents define harm in their own terms, they reveal forms of
   violence not captured by standard measures. These forms of harm also
   reflect the stage of development and positioning of adolescents in
   society. Research tools for conflict-affected adolescents should be
   co-developed with adolescents to ensure evidence and prevention
   strategies reflect and address the interconnected forms of harm.},
