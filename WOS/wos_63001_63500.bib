@article{ WOS:001871202400001,
Author = {Busch, Sigrid and Annisa, Shaharin and Krause, Michael and Ley, Astrid},
Title = {WISER Perspectives: Multidimensional Drivers of Well-Being in Cape
   Town's Informal Settlements},
Journal = {APPLIED RESEARCH IN QUALITY OF LIFE},
Year = {2026},
Month = {2026 SEP 10},
Abstract = {Research on well-being has predominantly focused on affluent
   populations, often neglecting disadvantaged communities and thereby
   perpetuating their marginalization in both academic and policy
   discussions. Perspectives from informal settlements-prevalent in the
   rapidly urbanizing Global South-offer valuable opportunities to expand
   and challenge prevailing conceptualizations of well-being. Adopting a
   qualitative approach, the research is based on a case study on
   placemaking interventions by the Violence Prevention through Urban
   Upgrading (VPUU) program in Cape Town, South Africa. The program is
   area-based and aims to enhance quality of life in informal settlements
   through community agency, co-production, and inclusive governance. Based
   on focus group discussions, transect walks, and qualitative interviews
   with residents, the study examines how VPUUs interventions influence
   residents' perceptions of life satisfaction and thereby highlights the
   subjective dimensions of well-being. Accordingly, this study explores
   (1) the role of community involvement in co-producing social
   infrastructure; (2) the impact of such involvement on well-being; and
   (3) strategies to support participation and governance. Findings
   indicate that while economic stability is important, social and human
   capital are also significant aspects, underscoring the value of social
   relationships and community support. Based on the VPUU case, the study
   introduces a novel framework identifying five key drivers of quality of
   life: (1) eudaimonic (purpose and belonging); (2) altruistic (community
   support); (3) relational (trust and social capital); (4) formative
   (skills and safety); and (5) material (economic and environmental
   conditions). The research concludes with recommendations for
   context-specific quality-of-life assessments and governance frameworks
   to sustain improvements in well-being and strengthen social cohesion.},
