@article{ WOS:000379722400005,
Author = {Al-Ghadban, Sara and Kaissi, Samira and Homaidan, Fadia R. and Naim,
   Hassan Y. and El-Sabban, Marwan E.},
Title = {Cross-talk between intestinal epithelial cells and immune cells in
   inflammatory bowel disease},
Journal = {SCIENTIFIC REPORTS},
Year = {2016},
Volume = {6},
Month = {JUL 15},
Abstract = {Inflammatory bowel disease (IBD) involves functional impairment of
   intestinal epithelial cells (IECs), concomitant with the infiltration of
   the lamina propria by inflammatory cells. We explored the reciprocal
   paracrine and direct interaction between human IECs and macrophages (MF)
   in a co-culture system that mimics some aspects of IBD. We investigated
   the expression of intercellular junctional proteins in cultured IECs
   under inflammatory conditions and in tissues from IBD patients. IECs
   establish functional gap junctions with IECs and MF, respectively.
   Connexin (Cx26) and Cx43 expression in cultured IECs is augmented under
   inflammatory conditions; while, Cx43-associated junctional complexes
   partners, E-cadherin, ZO-1, and beta-catenin expression is decreased.
   The expression of Cx26 and Cx43 in IBD tissues is redistributed to the
   basal membrane of IEC, which is associated with decrease in junctional
   complex proteins' expression, collagen type IV expression and
   infiltration of MF. These data support the notion that the combination
   of paracrine and hetero-cellular communication between IECs and M phi s
   may regulate epithelial cell function through the establishment of
   junctional complexes between inflammatory cells and IECs, which
   ultimately contribute to the dys-regulation of intestinal epithelial
   barrier.},
