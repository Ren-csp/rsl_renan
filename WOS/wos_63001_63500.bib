@article{ WOS:001816437900001,
Author = {van Zyl, Llewellyn E.},
Title = {Systemic virtues and systemic strengths: Expanding positive psychology
   beyond individual character},
Journal = {JOURNAL OF POSITIVE PSYCHOLOGY},
Year = {2026},
Month = {2026 JUL 11},
Abstract = {Character strengths frameworks conceptualize virtue as an
   individual-level phenomenon, yet global challenges require capacities
   that only exist at the collective level. This paper addresses that
   level-of-analysis gap by developing the theoretical foundations for
   systemic strengths and systemic virtues. We define systemic strengths as
   descriptive emergent capacities by which bounded collectives perform
   functions no individual can accomplish alone, and systemic virtues as
   emergent collectively coordinated, system-shaping capacities that's
   normatively oriented toward the regenerative stewardship of
   social-ecological systems. We develop an eight-category taxonomy for
   systemic virtues ranging from Collective Creativity to Ecological
   Stewardship. We ground each in empirical literature, specify
   subdimensions and indicators, identify links to outcome mechanisms, and
   highlight risks of absence/misuse. We also distinguish both constructs
   from aggregated individual traits, shared perceptions, and institutional
   artifacts. Together, this framework repositions flourishing not as
   something individuals possess, but something collectives sustain through
   relationships, institutions, and stewardship.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
