@article{ WOS:000884098400002,
Author = {Di Fiore, Gianluca and Specht, Kathrin and Rover, Oscar Jose and Zanasi,
   Cesare},
Title = {Stakeholders? social acceptance of a new organic waste management policy
   in the city of Florian?opolis (Brazil)},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2022},
Volume = {379},
Number = {2},
Month = {DEC 15},
Abstract = {Incorrect organic waste management can lead to several environmental and
   health threats. The literature shows that municipalities are adopting
   several strategies to reduce the improper disposal of organic waste. In
   2019, Florian ` opolis, Brazil, became the first Brazilian state capital
   to approve a law on mandatory organic waste separation and composting,
   the Florian ` opolis composting law (FCL). Nevertheless, the successful
   implementation of this new regulation relies on acceptance among urban
   stakeholders and civil society. The role of social acceptance has not
   been investigated when dealing with new waste management regulations. To
   this end, 37 qualitative interviews with local stakeholders were
   conducted to determine the key factors influencing the acceptance of the
   FCL by analyzing stakeholders' perceptions of the relevant risks,
   benefits, hindering and promoting factors. The results show that the law
   could represent an important first step toward a sustainable municipal
   solid waste management system; however, several risks may arise in the
   absence of adequate moni-toring systems. These risks are mainly linked
   to water contamination and health issues due to harmful insect
   proliferation. Furthermore, even though Florian ` opolis society seems
   culturally open, the lack of infrastructure and investments in the city
   could hinder the effectiveness of the law. Strategies for improving the
   law's effec-tiveness should be focused on supporting the existing formal
   and informal composting initiatives that have become widespread in
   recent decades. This could lead to a decentralized organic waste
   management system that empowers local initiatives and reduces the
   initial costs of implementing new composting systems and increases the
   separation rates at the household level.},
