Author = {Garcia-Prieto, Jaime and Villena-Gutierrez, Rocio and Gomez, Monica and
   Bernardo, Esther and Pun-Garcia, Andres and Garcia-Lunar, Ines and
   Crainiciuc, Georgiana and Fernandez-Jimenez, Rodrigo and Sreeramkumar,
