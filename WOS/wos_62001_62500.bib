Title = {Doctor-Patient Communication in Primary Health Care: A Mixed-Method
   Study in Fiji},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
