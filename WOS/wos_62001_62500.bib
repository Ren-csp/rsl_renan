@article{ WOS:000756114200016,
Author = {Feuerer, Nora and Marzi, Julia and Brauchle, Eva M. and Berrio, Daniel
   A. Carvajal and Billing, Florian and Weiss, Martin and Jakobi, Meike and
   Schneiderhan-Marra, Nicole and Shipp, Christopher and Schenke-Layland,
   Katja},
Title = {Lipidome profiling with Raman microspectroscopy identifies macrophage
   response to surface topographies of implant materials},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2021},
Volume = {118},
Number = {52},
Month = {DEC 28},
Abstract = {Biomaterial characteristics such as surface topographies have been shown
   to modulate macrophage phenotypes. The standard methodologies to measure
   macrophage response to biomaterials are marker-based and invasive. Raman
   microspectroscopy (RM) is a marker-independent, noninvasive technology
   that allows the analysis of living cells without the need for staining
   or processing. In the present study, we analyzed human monocyte-derived
   macrophages (MDMs) using RM, revealing that macrophage activation by
   lipopolysaccharides ( LPS), interferons (IFN), or cytokines can be
   identified by lipid composition, which significantly differs in M0
   (resting), M1 (IFN-gamma/LPS), M2a (IL-4/IL-13), and M2c (IL-10) MDMs.
   To identify the impact of a biomaterial on MDM phenotype and
   polarization, we cultured macrophages on titanium disks with varying
   surface topographies and analyzed the adherent MDMs with RM. We detected
   surface topography- induced changes in MDM biochemistry and lipid
   composition that were not shown by less sensitive standard methods such
   as cytokine expression or surface antigen analysis. Our data suggest
   that RM may enable a more precise classification of macrophage
   activation and biomaterial-macrophage interaction.},
Publisher = {NATL ACAD SCIENCES},
Address = {2101 CONSTITUTION AVE NW, WASHINGTON, DC 20418 USA},
