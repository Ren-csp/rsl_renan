   Ulbrich, Tayler C.; Evans, Sarah E., Michigan State Univ, WK Kellogg Biol Stn, Hickory Corners, MI 49060 USA.
   Evans, Sarah E., Michigan State Univ, Dept Integrat Biol, E Lansing, MI USA.
   Marquart-Pyatt, Sandra T., Michigan State Univ, Dept Geog Environm \& Spatial Sci, E Lansing, MI USA.
   Marquart-Pyatt, Sandra T., Michigan State Univ, Dept Polit Sci, E Lansing, MI USA.},
DOI = {10.1080/00224561.2025.2517076},
EarlyAccessDate = {JUN 2025},
ISSN = {0022-4561},
EISSN = {1941-3300},
Keywords = {conservation agriculture; cover crops; farmer beliefs; mental models;
   soil health; soil management},
Keywords-Plus = {KNOWLEDGE; ADOPTION; TRIANGULATION; PERCEPTIONS; MODELS},
Research-Areas = {Environmental Sciences \& Ecology; Agriculture; Water Resources},
Web-of-Science-Categories  = {Ecology; Soil Science; Water Resources},
