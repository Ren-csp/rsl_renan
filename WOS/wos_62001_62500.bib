@article{ WOS:000791654200016,
Author = {Jensen, Maria Therese},
Title = {Are test-based policies in the schools associated with burnout and
   bullying? A study of direct and indirect associations with pupil-teacher
   ratio as a moderator},
Journal = {TEACHING AND TEACHER EDUCATION},
Year = {2022},
Volume = {113},
Month = {MAY},
Abstract = {Research is lacking regarding how teachers' perceptions of a performance
   goal structure, relate to teacher and student outcomes. Thus, the
   present study examined associations among performance goal structure,
   teacher burnout, and bullying among students, and further whether
   pupil-teacher ratio moderated the relation between teacher burnout and
   bullying. 300 class teachers from 150 schools participated in the
   project, and structural equation modeling was applied. Results revealed
   significant associations among performance goal structure, teacher
   burnout, and bullying. However, having an additional teacher in the
   classroom did not moderate the association between burnout and bullying.
   (c) 2022 The Author. Published by Elsevier Ltd. This is an open access
   article under the CC BY license
   (http://creativecommons.org/licenses/by/4.0/).},
