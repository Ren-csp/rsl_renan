@article{ WOS:001704144400002,
Author = {Peschel, Anne O. and Thogersen, John},
Title = {The impact of labelling ``true price{''} on effectiveness and consumer
   acceptance},
Journal = {ECOLOGICAL ECONOMICS},
Year = {2026},
Volume = {244},
Month = {JUN},
Abstract = {Current food systems contribute significantly to environmental
   challenges, such as greenhouse gas emissions or biodiversity loss. To
   accelerate the green transition towards more sustainable food systems
   that can provide nutritious, safe and affordable foods for future
   generations, we need to disrupt current practices. True cost accounting
   (TCA), which aims to internalize externalities that are associated with
   production and consumption, is based on well-established environmental
   economics principles, but rarely implemented in practice. Also, it is
   difficult for consumers to assess the sustainability of products based
   on prices alone, which may make them both less responsive to and
   accepting of TCA. In line with current discussions on sustainability
   labelling in the EU, we therefore propose combining TCA with ``traffic
   light{''} color-coded sustainability labeling to guide consumers under a
   ``true price{''} paradigm. Based on two incentive compatible shopping
   experiments in a university's virtual reality supermarket and an online
   survey with a representative sample, we find that sustainability
   labelling increases shoppers' inclination to choose the most sustainable
   alternative. However, shoppers tend to find the higher true prices less
   fair, with fairness being the most important factor for accepting higher
   true prices. We discuss our findings in the light of current and planned
   legislation and provide actionable insight for decisionmakers.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Peschel, AO (Corresponding Author), Aarhus Univ, MAPP Ctr, Dept Management, Univ Sbyen 61, DK-8000 Aarhus, Denmark.
   Peschel, Anne O.; Thogersen, John, Aarhus Univ, MAPP Ctr, Dept Management, Univ Sbyen 61, DK-8000 Aarhus, Denmark.},
DOI = {10.1016/j.ecolecon.2026.108977},
Article-Number = {108977},
ISSN = {0921-8009},
EISSN = {1873-6106},
Keywords = {True cost accounting; true pricing; virtual reality; label;
   sustainability},
