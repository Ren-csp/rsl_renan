@article{ WOS:000397819400003,
Author = {Woyciechowski, Michal and Kuszewska, Karolina and Pitorak, Jedrzej and
   Kierat, Justyna},
Title = {Honeybee worker larvae perceive queen pheromones in their food},
Journal = {APIDOLOGIE},
Year = {2017},
Volume = {48},
Number = {2},
Pages = {144-149},
Month = {MAR},
Abstract = {Honeybee workers develop from fertilised eggs, but those reared in a
   queenless colony develop into `rebel' workers, which are more queen-like
   than typical workers. Rebels develop after an old queen leaves with a
   swarm and before a new queen hatches. We hypothesised that larval food
   lacking queen mandibular pheromones trigger the rebel phenotype. Larvae
   reared under queenright or queenless conditions were additionally fed
   with water or a drop of macerated queen mandibular glands. After
   following development of the bees and subjecting them to dissection, we
   found that those reared with a queen or fed the macerated glands under
   queenless conditions developed into typical workers. Only those workers
   reared without a queen and without macerated glands added to their food
   developed into rebels; these rebels had more ovarioles, smaller
   hypopharyngeal glands, and larger mandibular and Dufour's glands than
   did typical workers. This is the first evidence that larval perception
   of the presence or absence of queen pheromones causes an alternative
   development strategy.},
