@article{ WOS:000893862700015,
Author = {Khalil, Carine and Berdahl, Carl T. and Simon, Kevin and Uphold,
   Heatherlun and Ghandehari, Sara and Durra, Omar and Glenn, Clarence and
   Kim, Linda and Yumul, Roya and Milam, Adam Jeraldo},
Title = {Experiences and Perspectives on Stressors and Organizational Strategies
   to Bolster Resiliency During the COVID-19 Pandemic A Qualitative Study
   of Health Care Workers at a Tertiary Medical Center},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2022},
Volume = {64},
Number = {12},
Pages = {1013-1017},
Month = {DEC},
Abstract = {Objective:This qualitative study included a sample of health care
   workers (HCWs) at a tertiary care center providing direct care to
   patients with COVID-19 to explore experiences and perceptions regarding
   care delivery during the COVID-19 pandemic as well as factors that
   helped HCWs cope with the challenges of the pandemic. Methods: Grounded
   theory methodology was used to conduct virtual focus groups with a
   semistructured interview guide May to June 2020. Results: We identified
   major themes related to (1) HCWs' emotions during the pandemic, (2) the
   perceived triggers of these feelings, (3) organizational factors that
   made HCWs feel more supported and appreciated, and (4) personal factors
   that helped HCWs cope with the pandemic. Conclusion: Results highlighted
   the stress and challenges associated with exposure to SARS-CoV-2. The
   findings can help inform interventions to support HCWs during pandemics
   and other crises.},
