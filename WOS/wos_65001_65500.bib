@article{ WOS:001606810600001,
Author = {Xue, Zhichao and Yan, Huimin and Liu, Guihuan and Wang, Shaoqiang},
Title = {Effect and issue diagnosis in socio-ecological system of pastoral areas
   from ecology, production, and livelihood dimensions: A case study in
   ecological gradient grasslands of China},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {Understanding the trade-offs among ecological conservation, herder
   livelihoods, and production dynamics is critical for building resilient
   grassland socio-ecological systems, yet, comparative discussions across
   ecological gradient grasslands remain limited. Over the past two
   decades, grassland reservation projects have achieved notable progress,
   while new challenges, such as potential negative impacts on herders'
   livelihoods, are emerging. This research aims to analyze the sustainable
   development of pastoral areas under the pressures of limited natural
   resources, increasing livelihood demands, and restrictions from
   grassland protection policies. Rooted in the harmonious nexus of
   grassland-livestock-herdsman, by integrating the multi-source data from
   remote sensing observation, statistical analysis, and household surveys,
   a Pastoral Ecosystem and Livelihood Sustainability Assessment System
   (PELSA) has been developed with ecology, production and livelihood
   dimensions and applied in Xilin Gol League of China. The results showed
   that: (1) the PELSA provides a comprehensive assessment framework for
   grassland areas with intensive human-environment interactions,
   supporting issue diagnosis and management strategy formulation; (2) in
   ecology dimension, production pressure still threatens local resource
   security, and the replenishment of artificial grassland provides
   effective but limited relief; (3) in production dimension, regions with
   better natural conditions face subtle problems such as lower resource
   utilization efficiency, indicating the need for enhanced site monitoring
   and diversified regulation; and (4) in livelihood dimension, subsidy
   strategy should combine with livestock market regulation, livelihood
   diversification, technical training, and youth engagement to achieve
   sustainability. The PELSA and the case study provide insights and
   transferable experiences for promoting ecosystem resilience and
   livelihood sustainability in pastoral regions.},
