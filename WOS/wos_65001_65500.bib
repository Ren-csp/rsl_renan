@article{ WOS:001589229300028,
Author = {Telila, Zelalem and Amare, Abayineh and Tolera, Teferi},
Title = {Evaluating forest cover change and its impact on ecosystem services in
   Gargeda state forest western Ethiopia},
Journal = {SCIENTIFIC REPORTS},
Year = {2025},
Volume = {15},
Number = {1},
Month = {OCT 6},
Abstract = {Changes in land use and their effects on ecosystem services have become
   a global concern due to their implications for ecological integrity and
   human well-being. This study evaluated the impact of forest cover change
   on ecosystem services in Gargeda State Forest, western Ethiopia, over
   the past 30 years. Satellite imagery data from 1993 to 2023 was analyzed
   with ArcGIS to assess landscape dynamics. Ecosystem service values (ESV)
   are subjected to the benefit transfer approach based on valuation
   coefficients and household survey to support community perceptions. The
   results revealed a substantial loss in forest cover (- 110,214 ha) and
   water bodies (- 2064.87 ha), alongside increases in agroforestry
   (16.85\%), farmland (11.94\%), and settlements (1.76\%). Shrubland and
   grassland exhibited fluctuating trends. Total ecosystem service value
   declined by 44.08\%, from \$414.81 million/ha/year in 1993 to \$231.93
   million/ha/year in 2023. The significant reduction observed between 1993
   and 2003 by \$122.94 million/ha/year). The estimated ecosystem
   functions, supporting services, showed the highest decline, by \$90
   million/ha/year and regulating services fell by \$45.18 million/ha/year.
   Sensitivity analysis yielded coefficients below 1, confirming the
   reliability and robustness of the valuation approach. Local communities
   recognized the importance of remaining forest fragments, noting their
   provision of essential services such as food, raw materials, medicinal
   plants, and water supply. This major decline reflects the far-reaching
   impacts of land use changes over the past thirty years, indicating a
   reduced capacity of ecosystems to deliver vital services. Overall, the
   study highlights that the ongoing conversion of forest land into other
   uses threatens natural forests and contributes to declining
   environmental quality. These findings underline the need to incorporate
   ecosystem service values into land management policies to support
   sustainable development and conservation of forest across the region.},
