@article{ WOS:001826837900001,
Author = {Bousquet, Francois and Quinn, Tara and Guerbois, Chloe and de Campos,
   Ricardo Safra},
Title = {Developing local ties in a mobile world: how mobility processes shape
   sense of place and sustainable management in destination areas},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {3},
Month = {JUL},
Abstract = {Globally, coastal communities are being shaped by the ongoing movement
   of people locally, regionally, and internationally. These communities
   are made up of people with a range of mobility histories, living
   alongside each other and developing relationships with their local
   places. The understanding of the diversity of emotional ties is crucial
   to understand how people prepare themselves to environmental
   disruptions. In this empirical study, a survey conducted in the UK,
   South Africa, and France, we consider how processes of mobility shapes
   peoples' place attachment and place meaning in destination areas and we
   look at how the diversity of place attachment and place meaning relates
   to flood management options. We identify three (im)mobility lifestyles
   (the active neophytes, the connected locals, the pragmatic neighbors)
   that are related to preferences for flood risk management options. Here
   we show that the three groupings of attachment and meanings reflect
   particular orientations in relationship with the local area that can
   have implications for pro-environmental flood risk management options.},
Publisher = {Resilience Alliance},
