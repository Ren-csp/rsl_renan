@article{ WOS:000394498600001,
Author = {Vallejo, Adrian and Perurena, Naiara and Guruceaga, Elisabet and Mazur,
   Pawel K. and Martinez-Canarias, Susana and Zandueta, Carolina and
   Valencia, Karmele and Arricibita, Andrea and Gwinn, Dana and Sayles,
   Leanne C. and Chuang, Chen-Hua and Guembe, Laura and Bailey, Peter and
   Chang, David K. and Biankin, Andrew and Ponz-Sarvise, Mariano and
   Andersen, Jesper B. and Khatri, Purvesh and Bozec, Aline and
   Sweet-Cordero, E. Alejandro and Sage, Julien and Lecanda, Fernando and
   Vicent, Silve},
Title = {An integrative approach unveils FOSL1 as an oncogene vulnerability in
   KRAS-driven lung and pancreatic cancer},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {FEB 21},
Abstract = {KRAS mutated tumours represent a large fraction of human cancers, but
   the vast majority remains refractory to current clinical therapies.
   Thus, a deeper understanding of the molecular mechanisms triggered by
   KRAS oncogene may yield alternative therapeutic strategies. Here we
   report the identification of a common transcriptional signature across
   mutant KRAS cancers of distinct tissue origin that includes the
   transcription factor FOSL1. High FOSL1 expression identifies mutant KRAS
   lung and pancreatic cancer patients with the worst survival outcome.
   Furthermore, FOSL1 genetic inhibition is detrimental to both KRAS-driven
   tumour types. Mechanistically, FOSL1 links the KRAS oncogene to
   components of the mitotic machinery, a pathway previously postulated to
   function orthogonally to oncogenic KRAS. FOSL1 targets include AURKA,
   whose inhibition impairs viability of mutant KRAS cells. Lastly,
   combination of AURKA and MEK inhibitors induces a deleterious effect on
   mutant KRAS cells. Our findings unveil KRAS downstream effectors that
   provide opportunities to treat KRAS-driven cancers.},
