@article{ WOS:001879060400001,
Author = {Sebestyen, Tihamer Tibor and Benedek, Jozsef},
Title = {Changes in energy literacy and local governance in rural bioenergy
   transitions: Evidence from Ghelinta, Romania},
Journal = {CLEANER ENERGY SYSTEMS},
Year = {2026},
Volume = {15},
Month = {DEC},
Abstract = {This study provides rare longitudinal evidence from a rural Romanian
   case study and contributes empirical insight relevant to ongoing
   bioenergy transitions in South-Eastern Europe. Focusing on the commune
   of Ghelinta, Romania-an emerging bioenergy village-the research examines
   how household knowledge, heating practices, and perceptions of renewable
   energy have evolved over the past 7 years. The analysis draws on two
   comparable questionnaire surveys conducted in 2016 (n = 155) and 2023 (n
   = 163), complemented by direct observations of infrastructure
   investments, enabling a quantitative assessment of behavioral shifts and
   community-level change. The results show a marked increase in energy
   literacy, with awareness of biomass technologies rising from 41\% to
   73\%. Heating strategies have diversified: reliance on firewood declined
   from 87\% to 72\%, while biomassbased heating increased from 3\% to
   17\%. Public support for transforming Ghelinta into a bioenergy village
   grew from 53\% to 86\%, reflecting a sharp change in local attitudes.
   Yet the transition remains constrained by financial barriers and
   insufficient policy incentives. A key finding of this study is the
   catalytic role of the local administration: the mayoralty's deployment
   of biomass heating systems in public institutions has visibly
   demonstrated technological feasibility, boosted trust, and accelerated
   community uptake. The study contributes an integrated analytical
   approach combining longitudinal social assessment, institutional
   analysis, techno-economic evaluation, and environmental assessment. By
   integrating quantitative longitudinal analysis with governance insights,
   the study advances understanding of how rural communities can progress
   from traditional heating practices toward sustainable bioenergy systems.
   It highlights the mechanisms through which local authorities can steer
   energy transitions, and it suggests that several elements of the
   Ghelinta experience may offer transferable lessons for rural
   municipalities facing comparable socio-economic and institutional
   conditions in similar socio-economic contexts. The findings suggest that
   visible public-sector demonstration projects served as a mechanism
   through which local governance enhanced energy literacy and
   renewable-energy acceptance.},
