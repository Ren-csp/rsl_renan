@article{ WOS:001398317700027,
Author = {Bastola, Soniya and Pavlyukov, Marat S. and Sharma, Neel and Ghochani,
   Yasmin and Nakano, Mayu A. and Muthukrishnan, Sree Deepthi and Yu, Sang
   Yul and Kim, Min Soo and Sohrabi, Alireza and Biscola, Natalia P. and
   Yamashita, Daisuke and Anufrieva, Ksenia S. and Kovalenko, Tatyana F.
   and Jung, Grace and Ganz, Tomas and O'Brien, Beatrice and Kawaguchi,
   Riki and Qin, Yue and Seidlits, Stephanie K. and Burlingame, Alma L. and
   Oses-Prieto, Juan A. and Havton, Leif A. and Goldman, Steven A. and
   Hjelmeland, Anita B. and Nakano, Ichiro and Kornblum, Harley I.},
Title = {Endothelial-secreted Endocan activates PDGFRA and regulates vascularity
   and spatial phenotype in glioblastoma},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JAN 7},
Abstract = {Extensive neovascularization is a hallmark of glioblastoma (GBM). In
   addition to supplying oxygen and nutrients, vascular endothelial cells
   provide trophic support to GBM cells via paracrine signaling. Here we
   report that Endocan (ESM1), an endothelial-secreted proteoglycan,
   confers enhanced proliferative, migratory, and angiogenic properties to
   GBM cells and regulates their spatial identity. Mechanistically, Endocan
   exerts at least part of its functions via direct binding and activation
   of the PDGFRA receptor. Subsequent downstream signaling enhances
   chromatin accessibility of the Myc promoter and upregulates Myc
   expression inducing stable phenotypic changes in GBM cells. Furthermore,
   Endocan confers radioprotection on GBM cells in vitro and in vivo.
   Inhibition of Endocan-PDGFRA signaling with ponatinib increases survival
   in the Esm1 wild-type but not in the Esm1 knock-out mouse GBM model. Our
   findings identify Endocan and its downstream signaling axis as a
   potential target to subdue GBM recurrence and highlight the importance
