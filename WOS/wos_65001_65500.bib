@article{ WOS:000821046900009,
Author = {Gonzalez-Martinez, Angela and Castro, Sandra and Camino, Fernando and
   Rosado, Belen and Luno-Muniesa, Isabel and Dieguez, Fco J.},
Title = {Epidemiology of behavioural problems in pet rabbits: An owners' survey},
