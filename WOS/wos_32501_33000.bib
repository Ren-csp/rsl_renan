@article{ WOS:001316117700002,
Author = {Hausleitner, Christian and Mueller, Heimo and Holzinger, Andreas and
   Pfeifer, Bastian},
Title = {Collaborative weighting in federated graph neural networks for disease
   classification with the human-in-the-loop},
Journal = {SCIENTIFIC REPORTS},
Year = {2024},
Volume = {14},
Number = {1},
Month = {SEP 19},
Abstract = {The authors introduce a novel framework that integrates federated
   learning with Graph Neural Networks (GNNs) to classify diseases,
   incorporating Human-in-the-Loop methodologies. This advanced framework
   innovatively employs collaborative voting mechanisms on subgraphs within
   a Protein-Protein Interaction (PPI) network, situated in a federated
   ensemble-based deep learning context. This methodological approach marks
   a significant stride in the development of explainable and privacy-aware
   Artificial Intelligence, significantly contributing to the progression
   of personalized digital medicine in a responsible and transparent
   manner.},
