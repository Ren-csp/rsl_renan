@article{ WOS:001878333300001,
Author = {Lee, Yookyung and Han, Seungwoo},
Title = {Spatial scale and the interpretation of nuclear risk: National and local
   media in South Korea},
Journal = {SUSTAINABLE FUTURES},
Year = {2026},
Volume = {12},
Month = {DEC},
Abstract = {Environmental risks are often concentrated in places that differ from
   where their benefits are consumed. While research has extensively
   examined the unequal distribution of environmental burdens, less
   attention has been paid to whether spatial position is associated with
   differences in how those risks are interpreted. This study examines
   national and local newspaper coverage of nuclear energy in Korea between
   2010 and 2025. Drawing on a large corpus of newspaper articles, it
   distinguishes between crisis-based framing, which presents nuclear risk
   as an episodic policy problem, and grievance-based framing, which
   emphasizes cumulative exposure and unequal territorial burdens. Articles
   are classified using a large language model and aggregated into monthly
   framing measures. Monthly fixed-effects models compare national and
   local media under shared temporal conditions. The analysis reveals a
   persistent difference across media scales. Local media consistently
   exhibit higher levels of grievance-based framing, whereas national media
   place greater emphasis on crisis-oriented narratives. These differences
   remain after accounting for common temporal shocks and ideological
   variation within national newspapers. The findings suggest that spatial
   position is associated with how environmental risks become publicly
   understood. By linking media scale to discursive visibility, this study
   shows that spatial inequality is reflected not only in where
   environmental risks are borne, but also in whose experiences become
   incorporated into public interpretations of those risks.},
