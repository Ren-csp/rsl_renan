@article{ WOS:000906957300001,
Author = {Guerreiro, Joao and Loureiro, Sandra Maria Correia and Nascimento, Jorge
   and Duarte, Miguel},
Title = {How to earn a premium price: the effect of green marketing and brand
   coolness},
