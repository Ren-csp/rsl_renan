@article{ WOS:001874128300001,
Author = {McCarthy, Simone and Pitt, Hannah and Thomas, Samantha},
Title = {`Putting profit over people': Australian women's perceptions of the
   economic and commercial systems shaping women's health and social
   inequities},
Journal = {HEALTH PROMOTION INTERNATIONAL},
Year = {2026},
Volume = {41},
Number = {5},
Month = {OCT},
Abstract = {The commercial determinants of health are important drivers of
   population health, although their influence on women's health and social
   inequities remain underexplored. This study explored Australian women's
   perceptions of how economic and commercial factors influence women's
   health and wellbeing and the actions needed to address these influences
   and advance gender equity. An online qualitative survey was completed by
   506 Australian women aged 18 years and over. Data were analysed using a
   reflexive approach to thematic analysis. Women described health and
   social inequities as arising from interconnected economic, commercial,
   political, and gendered systems. Four themes were constructed from the
   data. First, women described financial barriers that limited access to
   essential goods, services, and healthcare. Second, they linked workplace
   practices, including inflexible work, insecure employment, and
   discrimination, to poorer health and wellbeing. Third, they identified a
   range of gendered, social, and environmental harms associated with
   industries they believed prioritized profit over health. Finally,
   participants called for stronger government regulation, greater
   corporate accountability, improved workplace protections, and more
   equitable access to healthcare and essential services. Findings
   highlight the need for public health responses that address the broader
   economic, commercial, and political systems shaping women's health and
   social inequities. Recognizing women as experts in their own lives can
   strengthen research, policy, and advocacy and support approaches that
   prioritize health and wellbeing over commercial interests.},
