@article{ WOS:001728364200001,
Author = {Kailash, Gokul and Chitra, M. Banu},
Title = {A GIS-based methodological framework for identifying and prioritising
   urban residual spaces for nature-based solutions in Chennai},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Significant pressure on green open spaces has been observed in India's
   growing urban population, particularly in dense metropolitan areas like
   Chennai. While the city as a whole does not meet open space standards, a
   severe imbalance is found at the neighbourhood level, where access to
   usable public green areas is almost nonexistent for some communities.
   Urban residual spaces, small, irregular, and often overlooked land
   fragments, are explored in this study as an alternative to meet this
   open space demand. These spaces are typically found along infrastructure
   such as metro corridors, highways, and rail lines, or between planned
   zones where leftover land remains unused. Five key types of residual
   spaces are identified and mapped in Chennai: metro viaduct buffers,
   highway edge zones, railway corridors, in-between pockets, and informal
   green patches. These were located and categorised using GIS tools based
   on physical characteristics, neighbourhood context, and potential for
   reuse. Nature-Based Solutions (NBS) are selected as the primary
   intervention strategy due to their holistic capacity to address
   environmental challenges and their suitability for small, fragmented
   urban fabrics. A strategic prioritisation framework is proposed for
   reclaiming these spaces. The framework advocates a context-specific
   approach, differentiating between smaller, community-embedded parcels
   and larger linear corridors (suitable for biodiversity corridors).
   Ultimately, a practical model is offered for municipal authorities to
   transform these neglected fragments into functional assets.},
