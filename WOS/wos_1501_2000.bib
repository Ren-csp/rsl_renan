@article{ WOS:001654784900007,
Author = {Reynoso-Campos, Jose Javier and Quiroz-Rocha, Georgina Adriana and
   Navarrete-Heredia, Jose Luis and Vasquez-Bolanos, Miguel},
Title = {Checklist of ants (Hymenoptera: Formicidae) in urban areas of Jalisco,
   Mexico},
Journal = {REVISTA CHILENA DE ENTOMOLOGIA},
Year = {2025},
Volume = {51},
Number = {4},
Pages = {759-778},
Month = {OCT-DEC},
Abstract = {Urban expansion is associated with local extinction rates, with the
   consequent elimination of native species. Cities generate a wide variety
   of environments, from highly urbanized areas to green spaces such as
   fragmented forests, parks, and vacant lots. Studies of ants in urban
   environments show a mixture of native and introduced species. To provide
   information on ant species in urban areas of the state of Jalisco,
   collections were made in eight municipalities between 2021 and 2022.
   Collections were made at three sites per municipality: downtown, park,
   and outskirts; three transects per site, and three sampling units were
   marked in each transect. At each site, pitfall traps were used (except
   in the downtown), along with tuna and nut baits, as well as a 15-minute
   direct collection within a 10-meter radius. We collected 16,720
   individuals, corresponding to 140 species, grouped into 44 genera and
   eight subfamilies. The most diverse municipalities were Cihuatl \&
   aacute;n with 57 species and Puerto Vallarta with 45 species, both
   located at the lowest altitude; the least diverse municipalities are
   Tapalpa with 15 species and Ojuelos with 18 species, which have the
   highest altitude. Twenty introduced species were found.},
