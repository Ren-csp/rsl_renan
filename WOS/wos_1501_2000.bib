@article{ WOS:001032006400002,
Author = {Heinisch, Marta R. and Medeiros-Sousa, Antonio R. and Andrade, Pamela S.
   and Urbinatti, Paulo R. and Almeida, Rosa M. M. S. and Lima-Camara,
   Tamara N.},
Title = {FAUNA AND VIROLOGICAL INVESTIGATION OF MOSQUITOES IN URBAN PARKS IN SAO
   PAULO, BRAZIL},
Journal = {JOURNAL OF THE AMERICAN MOSQUITO CONTROL ASSOCIATION},
Year = {2023},
Volume = {39},
Number = {2},
Pages = {75-84},
Month = {JUN},
Abstract = {The mosquito fauna in urban parks in the city of Sa \& SIM;o Paulo,
   Brazil, was investigated and compared for richness and diversity, and
   the abundance of each species was associated with climatic variables.
   Simultaneously, a virological investigation was performed to test the
   presence of Flavivirus and Alphavirus. Aspirations of adult mosquitoes
   were conducted in 3 urban parks for 3 consecutive weeks of each season
   between October 2018 and January 2020. A total of 2,388 mosquitoes were
   identified, with Culex quinquefasciatus, Cx. nigripalpus, and Aedes
   aegypti being the most abundant species. Mosquito assemblages showed
   similar richness and diversity, showing variability in individual
   results. Temperatures and Ae. aegypti abundance correlated significantly
   in one of the parks investigated herein. Urban parks represent areas of
   shelter and refuge for both anthropophilic and opportunistic species,
   such as Cx. quinquefasciatus and Ae. aegypti, as well as species that
   still need moderately preserved environments to develop.},
