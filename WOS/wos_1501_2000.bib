@article{ WOS:001469708600001,
Author = {Bayat, Asef},
Title = {LIBERTOPIA: An Intellectual Stroll in Berlin's Tempelhof Park},
Journal = {INTERNATIONAL JOURNAL OF URBAN AND REGIONAL RESEARCH},
Year = {2025},
Volume = {49},
Number = {5},
Pages = {1230-1238},
Month = {SEP},
Abstract = {Berlin's Tempelhofer Feld, an old airport turned into a public park,
   stands as a unique urban space. What it is about this simple and massive
   open space in the heart of a large city that makes it a near-utopian
   formation? This essay attempts to explore the meaning of this
   sociospatial entity, framing it in terms of a `libertopia', to serve as
   a possible inspiration to envision a more free and just society. To this
   end, it advocates maintaining the park's current unaltered simple form
   against those city officials who wish to `develop' the space.},
