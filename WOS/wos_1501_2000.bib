@article{ WOS:001178701400001,
Author = {Tong, Anqi and Xu, Lihua and Ma, Qiwei and Shi, Yijun and Feng, Mao and
   Lu, Zhangwei and Wu, Yaqi},
Title = {Evaluation of the level of park space service based on the residential
   area demand},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2024},
Volume = {93},
Month = {MAR},
Abstract = {The severe mismatch between the park space supply and resident demand
   significantly constrains the park space service level, consequently
   impacting resident well-being. Accordingly, the exploration of park
   space accessibility among residents in various living environments and
   the enhancement of park space service level have become focal points of
   current research. This study takes Hangzhou, Zhejiang Province, as a
   case study, evaluating the park space service levels and resident
   demands, while analyzing the spatial distribution and balance between
   park space demands and service levels among different residential areas.
   The results show that (1) Suburban and far suburban residential areas
   characterised by low housing prices, high population density, limited
   per capita green space, lower plot ratio, and distant distance from the
   city centre exhibit higher demand for diverse park space, resulting in
   an overall lower level of park space service level. However, the
   supplydemand balance is relatively satisfactory. (2) Residential areas
   with higher housing prices, higher population density, greater per
   capita green space, and closer distances to the city center demonstrate
   significant demand for micro-sized parks, with their park space service
   levels generally at a higher level. But these residential areas
   primarily experience a low-level equilibrium and lagging supply of park
   space. (3) Central city residential areas with high housing prices,
   higher plot ratio, lower population density, and higher per capita green
   space mainly consist of high-end villa districts and older
   neighborhoods. The balance of park space supply-demand varies
   significantly, with a focus on high-level equilibrium and supply lag,
   particularly evident in traditional older residential areas with
   inadequate park space supply. (4) The overall coordination of park space
   service level is poor, with significant imbalance of spatial matching,
   dominated by the over-development type, and most of the spatial matching
   is of low-level equilibrium and lagging supply type. Enhancement
   strategies are proposed for the unbalanced service level of park space
   in Hangzhou, to provide theoretical and technical support for the
   planning of urban park space to meet the needs of residents.},
