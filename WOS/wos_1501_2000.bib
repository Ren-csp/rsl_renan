@article{ WOS:001875095800001,
Author = {Jarekari, Joha and Eilola, Salla and Fagerholm, Nora},
Title = {Eudaimonic well-being in relation to urban nature: pathways to multiple
   nature values},
Journal = {ECOSYSTEMS AND PEOPLE},
Year = {2026},
Volume = {22},
Number = {1},
Month = {DEC 31},
Abstract = {Urban nature is increasingly recognized as essential for mental
   well-being. This study examines eudaimonic well-being - value-based,
   deeper well-being - by exploring how nature supports self-acceptance,
   autonomy, purpose in life, personal growth, good social relations, and
   environmental mastery among users of preventive psychosocial services
   provided by mental health associations. A creative writing method was
   developed to capture personal, well-being-enhancing experiences of
   nature. In-depth qualitative data from mental health association service
   users (n = 15) provides insights that also contribute to the broader
   discussion on eudaimonia within the framework of nature values. Findings
   emphasize nature's significance in fostering environmental mastery and
   social relationships. Feelings of accomplishment and agency were
   frequently described, along with depictions of nature as a setting for
   meaningful interactions with people, animals, and plants. These
   encounters with more-than-human beings and moments of shared presence
   emerged as sources of contentment. Participants also described
   experiences of feeling small yet connected to something bigger, where
   the perceived purposefulness of nature extends to human life. Moreover,
   five pathways were identified linking eudaimonic well-being with the
   instrumental, intrinsic, and relational values of nature. The results
   provide valuable insights for professionals working in urban planning.
   Meaningful places were often located nearby, such as hospital courtyards
   or home gardens, underscoring the importance of accessibility. Providing
   accessible green spaces and fostering encounters with old natural
   elements, such as old trees, can promote human flourishing and good
   life. Overall, the study demonstrates that accessible urban nature
   supports belonging, agency, and social relations, highlighting the
   importance of inclusive, community-oriented urban planning.},
