@article{ WOS:000523751400231,
Author = {Meng, Lingchao and Wen, Kuo-Hsun and Brewin, Richard and Wu, Qiong},
Title = {Knowledge Atlas on the Relationship between Urban Street Space and
   Residents' Health-A Bibliometric Analysis Based on VOSviewer and
   CiteSpace},
Journal = {SUSTAINABILITY},
