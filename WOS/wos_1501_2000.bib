@article{ WOS:001340840100001,
Author = {Gonzalez, Mikel A. and Cevidanes, Aitor and Barandika, Jesus F. and
   Garcia-Perez, Ana L.},
Title = {Culicoides biting midges in urban areas of northern Spain},
Journal = {MEDICAL AND VETERINARY ENTOMOLOGY},
