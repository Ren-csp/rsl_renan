@article{ WOS:001796300800001,
Author = {Khalifi, Negin Bani and Karapas, Konstantinos and Vlachos, Stavros and
   Bartzanas, Thomas and Avgoustaki, Dafni Despoina},
Title = {Winter evidence of green infrastructure co-benefits across an urban
   burden gradient in Athens, Greece: Implications for air-quality policy
   and intervention prioritization},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {31},
Month = {AUG},
Abstract = {Urban air pollution remains a major public-health challenge in
   Mediterranean cities, where traffic intensity, mixed land use,
   green-space fragmentation, and heterogeneous urban form produce spatial
   inequalities in exposure. Although green infrastructure is increasingly
   promoted as a multifunctional urban strategy, winter field evidence
   remains limited, particularly in Southern European metropolitan
   contexts. This study investigated winter air-quality and microclimatic
   variation across four urban sites in Athens, Greece, arranged along an
   urban-context gradient from a traffic-dominated low-green corridor to a
   spatially open urban park. A January 2026 campaign generated 48
   observations of PMQ.5, PM,0, NOQ, O3, VOCs, COQ, air temperature, and
   relative humidity at four daily periods: 08:00, 13:00, 18:00, and 22:00.
   Results showed a consistent spatial burden pattern, with the
   traffic-dominated corridor recording the highest pollutant
   concentrations and the park the lowest. From the traffic site to the
   park, mean concentrations declined by 62\% for PMQ.5, 64\% for PM,0,
   87\% for NOQ, 83\% for VOCs, and 7\% for COQ. Between-site differences
   were statistically significant for all monitored pollutants, with
   significant negative monotonic trends across the ordered gradient.
   Diurnal analysis revealed morning elevation, midday decline, evening
   re-accumulation, and partial nighttime decrease, while burden levels
   remained site-dependent. These findings indicate that greener, more open
   urban contexts were associated with lower winter pollutant burden.
   Because green cover co-varied with traffic exposure, land use, source
   proximity, and urban form, the study is interpreted as evidence of a
   combined urban-context effect rather than a vegetation-only causal
   effect. The results support site-sensitive air-quality policy in compact
   Mediterranean cities.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
