@article{ WOS:001863596500001,
Author = {Zhang, Yaru and Ai, Xin and Liu, Zhe and Mei, Ziyu and Liu, Yang and Ou,
   Xiaoyang and Zheng, Xi},
Title = {Beyond green: Unveiling the drivers of gross ecosystem product in
   high-density urban green spaces - A case study of central Beijing},
Journal = {ECOLOGICAL INDICATORS},
Year = {2026},
Volume = {190},
Month = {SEP},
Abstract = {The continued expansion of urban populations and urbanization place
   growing pressure on the supply of ecosystem services (ESs). In
   high-density cities, sustainable urban renewal depends on effective
   planning and management of urban green spaces (UGSs) amid complex
   land-use constraints. Gross ecosystem product (GEP) offers an
   operational framework for valuing ESs and supporting
   sustainability-oriented policies. Urban buildings and road networks,
   however, frequently divide UGSs into isolated ecological units, while
   existing research focuses largely on macro or administrative scales,
   seldom examining GEP variation among individual patches. The patch scale
   links internal ecological processes with urban spatial configurations
   and is therefore fundamental to more refined and comparable GEP
   accounting. This study established a patch-scale framework for
   evaluating and interpreting the ecological value of UGSs in densely
   developed cities. Multisource semantic data, object-based patch
   delineation, and random forest modeling were integrated to quantify GEP
   and determine the mechanisms associated with different UGS types in
   central Beijing. UGS GEP in 2023 totaled 160.86 billion CNY, averaging
   143.27 CNY/m2; parks recorded the greatest values, followed by
   subsidiary and other green spaces. Both strength and direction of
   associated factors differed by UGS type. Management characteristics were
   the principal predictors of park GEP, while vegetation features were
   more influential in subsidiary and other green spaces. Construction year
   and patch-composition variables also produced opposing marginal
   responses in parks relative to the other two UGS types. These results
   establish the patch as an operational unit for policy implementation and
   spatial regulation and inform UGS optimization and standardized urban ES
   assessment.},
