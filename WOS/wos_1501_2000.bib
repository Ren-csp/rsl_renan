@article{ WOS:000856665300002,
Author = {de Souza Junior, Joao Batista and Fonseca, Ricardo Lopes and Minasi,
   Luis Fernando},
Title = {THE CONSTITUTION OF THE SOCIAL BEING AND THE MAN VS. NATURE
   RELATIONSHIP: FIRST APPROACHES},
Journal = {REVISTA IBERO-AMERICANA DE ESTUDOS EM EDUCACAO},
Year = {2022},
Volume = {17},
Number = {1},
Pages = {614-626},
Month = {MAR},
Abstract = {Human beings have a relationship of dependence with natural resources,
   so, to ensure their existence, there is a need to act on nature. Thus,
   this text aims to synthesize the ontological path of constitution of the
   social being from the chapters ``Work{''} and ``Reproduction{''} of the
   work ``Towards an ontology of social being II{''}, by Gyorgy Lukacs, and
   is structured in three sections: ``the basic spheres: the inorganic
   being and the organic being{''}, ``work as the genesis of the social
   being{''} and ``as a conclusion: the relationship between man and nature
   in the process of formation of the social being{''}. From this, it is
   possible to understand that the constitution of the social being takes
   place from work, establishing a relationship of ontological dependence
   with the basic spheres inorganic and organic, that permeates and
   influences the relationship between man x nature and, consequently, the
   social interactions.},
Publisher = {UNIV ESTADUAL PAULISTA-UNESP, FAC CIENCIAS LETRAS ASSIS},
