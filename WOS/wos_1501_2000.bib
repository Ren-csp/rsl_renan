@article{ WOS:000391196900005,
Author = {Wandl, Alexander and Rooij, Remon and Rocco, Roberto},
Title = {Towards Sustainable Territories-in-Between: A Multidimensional Typology
   of Open Spaces in Europe},
Journal = {PLANNING PRACTICE AND RESEARCH},
Year = {2017},
Volume = {32},
Number = {1, SI},
Pages = {55-84},
Abstract = {To improve the ecosystem service provided by open spaces in dispersed
   urban areas is a key challenge for sustainable spatial development in
   Europe. The typology presented in this article illustrates the different
   potentials that open spaces in territories-in-between have across 10
   cases in Europe. Unlike other typologies, neither function nor form is
   used for the classification, but the potential interaction of open
   spaces with social, technical and ecological networks. Therefore, the
   typology informs regional spatial planning and design about the
   potential ecosystem services in networked urban regions. Thereby the
   importance of territories-in-between, which are often neglected by
   mainstream spatial planning and design, for sustainable development is
   highlighted.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
