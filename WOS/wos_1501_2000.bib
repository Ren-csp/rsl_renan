@article{ WOS:001860392700001,
Author = {Wang, Jieqiong and Cong, Jiaqi and Wang, Min and Chen, Junyan and Zhang,
   He and Jiang, Huiqing},
Title = {Quantifying the Impact of Street Greening During Fallen-Leaf Season on
   Ecological Perception Using Deep Learning: A Case Study of Central
   Shanghai},
Journal = {LAND},
Year = {2026},
Volume = {15},
Number = {8},
Month = {JUL 24},
Abstract = {Street greening plays an important role in shaping human perceptions of
   urban environments. However, previous studies have mainly focused on
   overall greenness or static vegetation indicators, while seasonal
   effects of street greening remain insufficiently explored. This study
   develops a quantitative framework to evaluate the influence of
   fallen-leaf season street greening on ecological perception in central
   Shanghai by integrating Baidu Street View, semantic segmentation,
   questionnaire surveys, and regression modeling. A questionnaire survey
   involving 200 sampling locations was conducted to obtain ecological
   perception scores, and a mixed-variable regression model was constructed
   and validated using five-fold cross-validation (R2 = 0.805; adjusted R2
   = 0.793). Results revealed that: (1) Several seasonal vegetation
   indicators exhibited interval-dependent effects; (2) Compared with the
   low-level category, proportion of deciduous tree (P DT) showed positive
   effects at medium levels but negative effects at high levels; proportion
   of yellow-leaved tree (P YT) showed negative effects at both medium and
   high levels, whereas proportion of colored shrubs and grasses (P CSG)
   showed positive effects only at medium levels. (3) Ecological perception
   showed a spatial gradient, with lower values in the urban core and
   higher values in peripheral areas, and was lower in Puxi than in Pudong.
   These findings highlight the importance of incorporating seasonal
   vegetation characteristics into street greening assessment.},
