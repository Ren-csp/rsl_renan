@article{ WOS:001760580800001,
Author = {Mendita, Jean Isaac and Conway, Tenley M.},
Title = {Exploring the social benefits of green infrastructure identified and
   valued by residents in social housing},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {121},
Month = {JUL},
Abstract = {Although green infrastructure (GI) is often promoted for environmental
   benefits, it can also provide social benefits, specifically supporting
   individual health, cultural identity, and social cohesion. These social
   benefits may be particularly important for marginalized urban
   communities, which face many challenges that stress individual and
   community health. This study adds to the small but growing body of
   literature examining the social benefits of GI for marginalized
   communities by examining perceptions and experiences of social housing
   residents in four ethno-culturally diverse Toronto neighbourhoods. We
   ask: what social benefits does GI provide for communities with high
   ethnocultural diversity but shared experiences of social, economic, and
   physical marginalization? Forty interviews were conducted across the
   four neighbourhoods to identify themes related to GI and individual
   health, cultural identity, and social cohesion. We found that residents'
   perception of GI extends beyond its physical processes, making it a
   vital part of daily life. Community gardens, trees, and open green
   spaces emerged as particularly meaningful for residents, serving as
   avenues for refuge, prayer, remembrance and cultural exchange,
   especially for immigrants. GI also facilitates informal social
   interactions and connections, thereby strengthening social cohesion.
   This research highlights the importance of GI in multicultural,
   lowincome neighbourhoods to support both individual and community
   health, and its particular role in promoting cultural identity and
   cross-cultural sharing.},
