@article{ WOS:001811647000001,
Author = {Fu, Yu and Wang, Gaidi},
Title = {Heterotopic Green Spaces and the Politics of Publicness in Philip
   Larkin's Urban Poetry},
Journal = {OPEN CULTURAL STUDIES},
Year = {2026},
Volume = {10},
Number = {1},
Month = {JAN 23},
Abstract = {This article examines Philip Larkin's reflections on publicness through
   the lens of urban green spaces, focusing on the tension between
   individual needs for belonging and the realities of bourgeois dominance.
   Drawing on Michel Foucault's concept of heterotopia, Larkin's depictions
   of parks and gardens can be read as spaces of deviation, contrasted with
   the simple grass field, which emerges as an intermediate heterotopia
   that temporarily suspends these conflicts and allows subaltern groups to
   reclaim their sense of self. Through close readings of Larkin's poems,
   we argue that Larkin critiques the inadequacy of urban spaces in
   fostering genuine connections for wage workers. We suggest that
   ``grass{''} functions as a space for personal autonomy and
   self-realization. By offering a fresh perspective on Larkin's
   cityscapes, this study seeks to deepen understanding of the poet's
   critique of capitalist culture and the alienation experienced by the
   working class in post-civil society.},
