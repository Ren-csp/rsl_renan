@article{ WOS:000863776800001,
Author = {Triguero-Mas, Margarita and Anguelovski, Isabelle and Connolly, James J.
   T. and Martin, Nick and Matheney, Austin and Cole, Helen V. S. and
   Perez-Del-Pulgar, Carmen and Garcia-Lamarca, Melissa and Shokry, Galia
