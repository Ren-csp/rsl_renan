@article{ WOS:000340495300008,
Author = {Ibrahim, Illyani and Abu Samah, Azizan and Fauzi, Rosmadi},
Title = {Biophysical factors of remote sensing approach in urban green analysis},
Journal = {GEOCARTO INTERNATIONAL},
Year = {2014},
Volume = {29},
Number = {7},
Pages = {807-818},
Abstract = {Greenery in an urban environment is an important consideration when
   studying temperature, and such enquiry can benefit human health. The
   purpose of this paper is to investigate how ambient temperature in urban
   areas is affected by forests and parks. The focus is on biophysical
   parameters related to these green areas, such as impervious surface
   percentages, albedo, areal coverage, elevation, and leaf area index
   (LAI). Geographic information systems and remote sensing were used to
   quantify green spaces using a pixel-based method. It was found that
   coverage area has little correlation with temperature. Factor analysis
   was used to determine the minimum number of independent factors, which
   explained 63\% of the variance of that temperature. Only elevation, LAI
   and albedo were significant biophysical factors. Guidelines for greenery
   programmes should include these significant data-sets to understand the
   influence of green areas on heat reduction.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
