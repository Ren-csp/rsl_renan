Title = {Changing approaches to green infrastructure design: from modernism to
   the future: Warsaw case study},
Journal = {URBAN DESIGN INTERNATIONAL},
Year = {2023},
Volume = {28},
Number = {3},
Pages = {202-219},
Month = {SEP},
Abstract = {International modernism has brought new solutions to urban greenery,
   primarily aimed at improving the living conditions of the inhabitants.
   Currently, much more is expected of green areas, and at the same time,
   various impacts influence their modifications. The article focusses on
   changing approaches to the issue of green wedges design resulting from
   the socio-political transformation and the changes in approaches to city
   planning priorities. We selected Warsaw for detailed research, where the
   evolution of this approach can be clearly observed. The study showed the
   changes in the size, layout and function of one of the most important
   green areas and residents' expectations. The formulated conclusions and
   threads may be helpful in spatial policy, spatial planning and urban
   design in various cities with an open areas structure similar to Warsaw.},
