@article{ WOS:001489036500001,
Author = {Samra, Rasha M. Abou},
Title = {How Urban Green Spaces Shape Unequal Cooling in Rapidly Urbanizing
   Egypt: Insights from Landsat and GEE Analysis},
Journal = {EARTH SYSTEMS AND ENVIRONMENT},
Year = {2025},
Volume = {9},
Number = {2},
Pages = {605-624},
Month = {JUN},
Abstract = {The resilience of cities to climate change is becoming increasingly
   central to urban planning worldwide. In the context of global
   urbanization trends, urban greening serves as an effective method for
   mitigating the urban heat island (UHI) effect and achieving
   environmental sustainability at the urban scale. However, the cooling
   efficiency of urban green spaces (UGSs) in Egyptian cities remains
   unknown, which impedes policymakers from formulating climate adaptation
   strategies. In this study, we assessed urbanization and surface urban
   cooling island (SUCI) trends across 130 Egyptian cities between 2000 and
   2023 using 19,126 Landsat images and the Google Earth Engine (GEE). Land
   Surface Temperature (LST) data were derived from Landsat imagery using
   the radiative transfer equation, while the SUCI effect of UGSs was
   modeled through buffer analysis. Furthermore, the driving factors of
   SUCI intensity were analyzed using the least squares regression model.
   The results revealed that, at the national level, built-settlement
   growth (BSG) and population density (Dp) increased by 52.64\% and
   110.96\%, respectively, from 2000 to 2023. However, the average UGS
   increased by 116.63\% from 2000 to 2019, followed by a decrease of
   7.85\% from 2019 to 2023. Within climatic zones (CZs), the Cairo and
   Delta Zone (CDZ) exhibited the most significant increases in BSG,
   population density, and UGS throughout the study period. The SUCI across
   Egypt was approximately 0.84 degrees C, with the highest SUCI observed
   in the CDZ (1.02 degrees C), megacities (1.14 degrees C), and new cities
   (1.47 degrees C). Nationally, the SUCI trend analysis revealed that 74\%
   of cities experienced an increase in SUCI between 2000 and 2023, while
   26\% exhibited a decline in cooling intensity. UGS size emerged as the
   most significant driving factor across Egyptian cities, followed by BSG
   and air temperature. However, the specific factors influencing SUCI
   varied widely across CZs. Understanding SUCI dynamics enables urban
   planners to better address the challenges of urbanization and climate
   change, thereby enhancing the sustainability of the urban
   environment.Graphical AbstractThis study provides the first
   comprehensive assessment of the cooling capacity of urban green spaces
   across Egyptian cities, offering critical insights for urban planners
   and policymakers to address urban heat island effects and enhance
   climate resilience. By utilizing Landsat imagery and Google Earth
   Engine, we examined urbanization trends and surface urban cooling island
   (SUCI) dynamics across Egypt's various climatic zones and urban scales
   from 2000 to 2023. Using least squares regression modeling, we
   quantified the key drivers influencing SUCI intensity, including urban
   green space area, air temperature, precipitation, built-settlement
   expansion, and population density. Our findings revealed significant
   spatial variability in SUCI intensity and its driving factors across
   different climatic zones and urban scales, underscoring the need for
   specific planning strategies to maximize urban cooling efficiency.
   Additionally, we propose adaptation strategies and policy
   recommendations to improve the cooling performance of urban green
   spaces. This study offers a scientific framework to support sustainable
   urban development and climate adaptation efforts in rapidly urbanizing
   arid regions.},
