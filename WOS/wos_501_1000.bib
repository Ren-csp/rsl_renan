@article{ WOS:001615213100002,
Author = {Mell, Ian and Wang, Ke},
Title = {Future-proofing Urban-Rural Fringe Areas (URFA) in China - a DPSIR
   analysis of the role of public green space as an indicator of
   sustainable urban development},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2025},
Volume = {114},
Month = {DEC},
Abstract = {The centralised approach to planning in China has installed a rigid
   structure of top-down mandates on urban development. Such a framework
   aims to support a continuity of delivery ensuring that all cities are
   liveable, functional and prosperous. Central to this has been the
   promotion of urban expansion delivering critical infrastructure, which
   has led to a growing debate focused how to increase sustainability
   whilst also rethinking environmental resource management. However, the
   application of these mandates at the metropolitan scale varies due to a
   complex interaction of city status, local government priorities, and the
   influence of planning stakeholders on the translation of central
   government policy into localised delivery. The development of Community
   Parks (CPs) in Urban-Rural Fringe Areas (URFAs) of Wuhan is used as a
   case study to debate the alignment of top-down mandates with
   stakeholders approaches to ``greener{''} investment examining the
   application of government policy via an analysis of policy and expert
   commentary drawn from planning and academic advocates. The focus on
   investment in CP is underrepresented in the literature, as is the use of
   the DPSIR (Drivers, Pressures, State, Impact and Response) framework.
   DPSIR is used as it provides an evaluative process to consider the
   constraints placed on investment in built and green infrastructure (GI),
   as well as the pathways to successful alignment in praxis. The paper
   concludes that whilst an adherence to central government policy remains
   visible in Wuhan, local-level stakeholders hold a significant influence
   on the form that CP investment in URFAs take . The factors shaping this
   adaptation are applicable to other cities in China where URFAs as
   political, economic and stakeholder influences remain centre of
   discussions of urban expansion and liveability.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
