@article{ WOS:000956698000001,
Author = {Rozbicka, Katarzyna and Rozbicki, Tomasz},
Title = {Summer weather perception and preferences in Powsin Culture Park
   (Warsaw, Poland)},
Journal = {INTERNATIONAL JOURNAL OF BIOMETEOROLOGY},
