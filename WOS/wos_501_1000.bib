@article{ WOS:001543758900001,
Author = {Lee, Sang Ho and Kim, Heeyoung and Han, Hoon},
Title = {Transforming urban neighborhoods from `bed towns' to eco-friendly smart
   cities in Korea},
Journal = {CITIES},
Year = {2025},
Volume = {166},
Month = {NOV},
Abstract = {Neighborhood transformation is shaped by complex social, economic, and
   environmental factors. Initially, a large scale of housing development,
   including new satellite cities around Seoul in the Republic of Korea,
   generated a new form of neighborhood transformation by an influx of
   newcomers and smart infrastructure. As recent urbanism has progressed
   from modern to green, and from green to smart in Korea, neighborhood
   transformations have rapidly converted commuter towns `bed towns' into
   eco-friendly, greener, and selfsustaining smart cities. However, the
   institutional factors driving these transformations remain unanswered.
   This study develops an analytical framework for urbanism transformation
   through a theoretical literature review. Urban morphological analysis is
   used to examine how Korean neighborhoods models have evolved in response
   to shifting urbanisms, using three case studies. Our findings reveal
   that household formation, building density, and floor area have
   increased, while population, population density, and building coverage
   ratio have decreased. Transportation infrastructure has shifted from an
   automobile-centric form to a public transit-oriented model. Notably,
   local streets and parking spaces have been repurposed into
   pedestrian-friendly and open spaces. Furthermore, Korean neighborhood
   planning has shifted from relying on a mainly quantitative focus toward
   embracing qualitative social and environmental indicators, moving to a
   new era of eco-friendly smart cities.},
