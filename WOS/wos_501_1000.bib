@article{ WOS:000589710800001,
Author = {Kumakoshi, Yusuke and Chan, Sau Yee and Koizumi, Hideki and Li,
   Xiaojiang and Yoshimura, Yuji},
Title = {Standardized Green View Index and Quantification of Different Metrics of
   Urban Green Vegetation},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {18},
Month = {SEP},
Abstract = {Urban greenery is considered an important factor in sustainable
   development and people's quality of life in the city. To account for
   urban green vegetation, Green View Index (GVI), which captures the
   visibility of greenery at street level, has been used. However, as GVI
   is point-based estimation, when aggregated at an area-level by mean or
   median, it is sensitive to the location of sampled sites, overweighing
   the values of densely located sites. To make estimation at area-level
   more robust, this study aims to (1) propose an improved indicator of
   greenery visibility (standardized GVI; sGVI), and (2) quantify the
   relation between sGVI and other green metrics. Experiment on an
   hypothetical setting confirmed that bias from site location can be
   mitigated by sGVI. Furthermore, comparing sGVI and Normalized Difference
   Vegetation Index (NDVI) at the city block level in Yokohama city, Japan,
   we found that sGVI captures the presence of vegetation better in the
   city center, whereas NDVI is better at capturing vegetation in parks and
   forests, principally due to the different viewpoints (eye-level
   perception and top-down eyesight). These tools provide a foundation for
   accessing the effect of vegetation in urban landscapes in a more robust
   matter, enabling comparison on any arbitrary geographical scale.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Kumakoshi, Y (Corresponding Author), Univ Tokyo, Res Ctr Adv Sci \& Technol, Tokyo 1538904, Japan.
   Kumakoshi, Yusuke; Koizumi, Hideki; Yoshimura, Yuji, Univ Tokyo, Res Ctr Adv Sci \& Technol, Tokyo 1538904, Japan.
   Koizumi, Hideki, Univ Tokyo, Dept Urban Engn, Tokyo 1138656, Japan.
   Li, Xiaojiang, Temple Univ, Dept Geog \& Urban Studies, Philadelphia, PA 19122 USA.},
DOI = {10.3390/su12187434},
Article-Number = {7434},
EISSN = {2071-1050},
