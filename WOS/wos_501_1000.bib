@article{ WOS:000435188000171,
Author = {Yu, Bingqin and Che, Shengquan and Xie, Changkun and Tian, Shu},
Title = {Understanding Shanghai Residents' Perception of Leisure Impact and
   Experience Satisfaction of Urban Community Parks: An Integrated and IPA
   Method},
Journal = {SUSTAINABILITY},
Year = {2018},
Volume = {10},
Number = {4},
Month = {APR},
Abstract = {This exploratory study employed an integrated methodological approach to
   examine the relationship among several factors for residents in Shanghai
   when it came to the use of urban park spaces. The study was conducted
   using two sample groups of 1200 residents each, and around three
   community parks that contained a variety of recreation-related impacts.
   Open-ended and closed-ended questionnaires and correspondence analysis
   were used to reflect residents' basic attitudes, recreational
   perception, and satisfaction evaluation by Importance Performance
   Analysis (IPA) method, and mirrored preferences for future development
   of community parks. The results suggest that for residents, high levels
   of satisfaction with landscape and environment were advantages, but
   recreation space and facility were critical for the perception of the
   community parks. In comparison, management was found to be an
   opportunity factor to improve leisure satisfaction. The findings
   emphasized landscape, environment, space, facility, and management as
   elements that enhance recreational perception and avoid passive
   interference.},
