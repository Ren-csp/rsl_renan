@article{ WOS:001830649000001,
Author = {Bizuayehu, Getaneh and Gashu, Kassahun and Debebe, Belete},
Title = {Public perceptions on the role of urban green space development and
   management in Gondar City, Amhara Region, Northwest Ethiopia},
Journal = {SUSTAINABLE FUTURES},
Year = {2026},
Volume = {12},
Month = {DEC},
Abstract = {Urban green spaces (UGS) are essential in urban environments, offering
   economic, social, and environmental benefits to urban residents. This
   study examined public perception of the economic, social, and
   environmental roles of UGS development and management in Gondar City.
   The study used both primary and secondary data sources, convergent
   parallel mixed design, and probability and non-probability sampling
   techniques. Data were collected through household surveys and
   semi-structured questionnaires. Descriptive statistics and chi-square
   test were used for data analysis. Regarding the economic role of UGS,
   most participants strongly agreed with UGS, provides raw materials
   (54.5\%), creates employment (54.5\%), attracts businesses (53.5\%),
   food production (51.8\%), and increases government revenues (51.7\%).
   The social role of UGS, participants strongly agreed with UGS, improves
   healthy urban lifestyles (64.3\%), reduces stress, improves mood,
   enhances cognitive function, and promotes mental health and social
   inclusion (60.1\%), while reducing social tensions (53.3\%). The
   environmental role of UGS, participants strongly agreed with UGS,
   reduces severe climate change and heat waves (89\%), improves urban
   forests (78\%), mitigates urban heat island effect and surface
   temperature (75.3\%), pollution reduction, and ecological balance
   (72.1\%), and improves environmental hygiene, safety, and protection
   (70.2\%). Chi-square test results showed that most demographic,
   socio-economic, and biophysical factors were not significantly
   associated with economic, social, and environmental roles of UGS, while
   only a few factors were significantly associated. The findings indicate
   that policymakers should adopt strategies to enhance the roles of UGS,
   support ongoing development and management initiatives in Gondar city,
   and contribute to a broader regional development strategy in Ethiopia.},
