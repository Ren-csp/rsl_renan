@article{ WOS:001027530200004,
Author = {Kowert, Rachel and Daniel Jr, Emory},
Title = {The one-and-a-half sided parasocial relationship: The curious case of
   live streaming},
Journal = {COMPUTERS IN HUMAN BEHAVIOR REPORTS},
Year = {2021},
Volume = {4},
Month = {AUG-DEC},
Abstract = {Parasocial relationships have traditionally been conceptualized as
   one-sided, non-reciprocal relationships with media figures. However, the
   proliferation of online media ``microcelebrities{''} via live streaming
   has shifted the nature of parasocial relationship away from the classic
   one-sided relationship and towards a ``one-and-a-half{''} sided
   relationship characterized by the potential for reciprocal
   communication, strong community affiliation, fandom cultures, wishful
   identification, high emotional engagement, and increased presence. This
   paper explores the theoretical and practical implications of this shift,
   specifically within the context of live streaming on Twitch.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
