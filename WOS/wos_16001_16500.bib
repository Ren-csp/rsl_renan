   Alberto Romero},
Title = {Socio-Environmental Problems and Conflicts in the Maritorium, Quellón,
   Chile},
Journal = {PERFILES LATINOAMERICANOS},
Year = {2026},
Volume = {34},
Number = {67},
Pages = {195-222},
Abstract = {Quell \& oacute;n, in the Chilo \& eacute; archipelago, Chilean
   Patagonia, presents multiple socio-environmental problems associated
   with extractivism, as well as various vulnerabilities that transform it
   into an area highly exposed to the impacts of environmental crisis. This
   research explores with qualitative methods how different social actors
   in Quell \& oacute;n perceive the maritorium and the socio-environmental
   problems, in a context of climate change, as well as the responses they
   have generated to confront these conflicts. How to move towards a more
   resilient maritorium is discussed.},
