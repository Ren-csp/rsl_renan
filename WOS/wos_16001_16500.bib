@article{ WOS:001692395300001,
Author = {Zhou, Jin and Xu, Feifei and Xu, Fan},
Title = {Research on the spatiotemporal dynamics and the recreation spatial
   equity of China's nature reserves},
Journal = {ECOSPHERE},
Year = {2026},
Volume = {17},
Number = {2},
Month = {FEB 17},
Abstract = {Despite the importance of equitable and adequate supply of natural
   recreation services on human well-being, limited research has
   investigated the spatial foundations and equity of natural recreation
   services. Nature reserves serve as key providers and destinations for
   natural recreation. Their spatial patterns and equity differences inform
   regional high-quality ecotourism development strategies in China. This
   study applied analytic hierarchy process and Entropy weight method
   (AHP-Entropy) to assess the spatial supply levels of nature reserves
   across various types and levels in municipal administrative units in
   China from 1990 to 2022, and visualized their spatiotemporal dynamic
   patterns. Then, using Local Moran's I and the improved two-step floating
   catchment area method (2SFCA), this study revealed the recreation
   spatial equity of China's nature reserves across different travel
   scenarios. The results indicate the following: (1) The overall supply
   level of China's nature reserves improved steadily from 1990 to 2022,
   with increasing disparities among cities. While spatial patterns
   remained largely stable, regional imbalances gradually declined. (2)
   Spatial equity varied significantly across travel scenarios, generally
   improving with longer travel times and distances. Under short-distance
   travel scenarios, spatial inequities are prominent. Under
   middle-distance travel scenarios, spatial equity improves alongside
   emerging spatial agglomeration. Under long-distance travel scenarios,
   the spatial pattern of equity continues to improve, further polarizing
   spatial agglomeration of spatial equity of accessibility. (3) As travel
   time increases, recreation spatial equity exhibits spatial agglomeration
   trends, which are shaped by both geographical context, whereby areas
   sharing similar natural or cultural geographical settings show
   comparable shifts in supply-demand relationships, and policy
   orientation, whereby regions receiving similar levels of infrastructure
   investment experience parallel changes in supply-demand dynamics. The
   results enhance our understanding of the spatial allocation and service
   efficiency of recreational resources in nature reserves, offering
   theoretical insights for high-level conservation and efficient resource
   use in China.},
