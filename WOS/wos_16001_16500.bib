@article{ WOS:000579510600002,
Author = {Lesic, Vedran and Glasgo, Brock and Krishnamurti, Tamar and de Bruin,
   Wandi Bruine and Davis, Matthew and Azevedo, Ines Lima},
Title = {Comparing consumer perceptions of appliances' electricity use to
   appliances' actual direct-metered consumption},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
