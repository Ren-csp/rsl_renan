@article{ WOS:000589341900001,
Author = {Vecchio, Yari and Adinolfi, Felice and Albani, Claudia and Bartoli, Luca
   and De Rosa, Marcello},
Title = {Boosting Sustainable Innovation in Densely Populated Areas: A Milieux
   Innovateurs Approach},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {21},
Month = {NOV},
Abstract = {This paper deals with innovation adoption, with the purpose of analyzing
   the uptake of sustainable innovations among young farms working in urban
   and periurban contexts. Our hypothesis is that innovative milieus (IM)
   play a fundamental role in boosting sustainable innovation. In order to
   analyze the uptake of sustainable innovation, we will make reference to
   the two logics of the IM approach: the logics of interactions and the
   logics of learning. The former is focused on the socio-institutional
   domain, more precisely on relational assets and coordination mechanisms
   activated by the farms. The latter makes reference to the profile of
   innovation adopted and on various impacts innovation have under
   economic, social and environmental points of view. A questionnaire has
   been submitted to young farms participating to the Oscar Green
   Coldiretti Awards. In total, three dimensions of innovation are taken
   into account: economic, social and environmental. Data are processed
   through statistical tools aiming at describing the diversified set of
   interaction-learning mechanisms. Results evidence different innovative
   milieus which pave the way to diversified paths of innovation with
   different degree of sustainability and impacts.},
