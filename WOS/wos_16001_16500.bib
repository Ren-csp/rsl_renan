@article{ WOS:001508266200001,
Author = {Arntzen, Marthe and Scheie, Eldri and Haug, Berit},
Title = {Unveiling perceptions: how science teachers perceive sustainable
   development and their expectations of students' learning outcomes
   through environmental and sustainability education},
Journal = {INTERNATIONAL JOURNAL OF SCIENCE EDUCATION},
Year = {2026},
Volume = {48},
Number = {10},
Pages = {1526-1545},
Month = {JUL 3},
Abstract = {Sustainable development is promoted as an interdisciplinary topic in the
   Norwegian curriculum, reflecting similar priorities in global policy
   documents and educational frameworks. However, its implementation in
   schools partly relies on how teachers interpret the concept of
   sustainable development and what they consider students should learn
   through environmental and sustainability education. This study explores
   how science teachers perceive sustainable development in a school
   context and what they expect students' learning outcomes to be. Ten
   Norwegian science teachers from lower secondary schools were interviewed
   individually, and the data were analysed using an inductive
   phenomenological approach. The results show that even though the
   ecological dimension of sustainable development is highly recognised by
   the science teachers, they perceive sustainable development first and
   foremost as the interconnectedness between its different dimensions.
   Regarding students' learning outcomes, three themes were identified from
   the science teachers<acute accent> statements: knowledge, abilities, and
   mindset. These learning outcomes are discussed in comparison to
   sustainability competencies and connected to the environmental science
   competencies within the PISA 2025 framework, as well as the three
   visions of scientific literacy.},
