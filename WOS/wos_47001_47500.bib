Language = {English},
Affiliation = {Jia, ZH (Corresponding Author), Yangzhou Univ, Sch Hydraul Energy \& Power Engn, Yangzhou 225009, Jiangsu, Peoples R China.
   Tang, Shuangcheng; Xu, Qing; Jia, Zhonghua; Luo, Wan; Shao, Zhengxiao, Yangzhou Univ, Sch Hydraul Energy \& Power Engn, Yangzhou 225009, Jiangsu, Peoples R China.},
