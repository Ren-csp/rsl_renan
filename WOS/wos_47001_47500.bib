@article{ WOS:000801651900001,
Author = {Giannetti, Biagio F. and Agostinho, Feni and Almeida, Cecilia M. V. B.
   and Yang, Zhifeng and Liu, Gengyuan and Hancock, Linda},
Title = {Challenges and Opportunities of Cleaner Production on Sustainable
   Development},
