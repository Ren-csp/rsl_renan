@article{ WOS:000391267800030,
Author = {Samodelov, Sophia L. and Beyer, Hannes M. and Guo, Xiujie and Augustin,
   Maximilian and Jia, Kun-Peng and Baz, Lina and Ebenhoeh, Oliver and
   Beyer, Peter and Weber, Wilfried and Al-Babili, Salim and Zurbriggen,
   Matias D.},
Title = {StrigoQuant: A genetically encoded biosensor for quantifying
   strigolactone activity and specificity},
Journal = {SCIENCE ADVANCES},
Year = {2016},
Volume = {2},
Number = {11},
Month = {NOV},
Abstract = {Strigolactones are key regulators of plant development and interaction
   with symbiotic fungi; however, quantitative tools for strigolactone
   signaling analysis are lacking. We introduce a genetically encoded
   hormone biosensor used to analyze strigolactone-mediated processes,
   including the study of the components involved in the hormone
   perception/signaling complex and the structural specificity and
   sensitivity of natural and synthetic strigolactones in Arabidopsis,
   providing quantitative insights into the stereoselectivity of
   strigolactone perception. Given the high specificity, sensitivity,
   dynamic range of activity, modular construction, ease of implementation,
   and wide applicability, the biosensor StrigoQuant will be useful in
   unraveling multiple levels of strigolactone metabolic and signaling
   networks.},
