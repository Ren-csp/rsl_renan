@article{ WOS:001783582800001,
Author = {Syrou, Dimitra and Liontakis, Angelos and Botetzagias, Iosif and
   Vassilopoulou, Vassiliki},
Title = {Evaluating fisheries' governance effectiveness in supporting
   ecosystem-based management: A Q-methodology assessment of stakeholder
   perspectives in Greek waters},
Journal = {MARINE POLICY},
Year = {2026},
Volume = {192},
Month = {OCT},
Abstract = {This study investigates stakeholder perceptions of fisheries governance
   in the Patraikos Gulf, a key fishing ground in the eastern Ionian Sea,
   with a focus on the management of hake (Merluccius merluccius), a
   species of high commercial importance in one of the region's main
   nursery areas. Using Q methodology, we engaged stakeholders across
   multiple governance levels, including national, regional, and local
   decision-makers, trawl and small-scale fishers, and scientists. The
   analysis identified three distinct stakeholder discourses (Factors A, B,
   and C), alongside areas of consensus, providing insight into governance
   dynamics within this socio-ecological system. Findings reveal both
   divergence and convergence in stakeholder perspectives. While views
   differ on specific management measures, stakeholders share concerns
   regarding limited coordination, low trust between authorities and local
   actors, and insufficient inclusion in decision-making processes.
   Situating the case within the broader Mediterranean policy context,
   where ecosystem-based fisheries management (EBFM) is widely promoted,
   the study examines how stakeholders perceive the capacity of existing
   governance systems to operationalize its principles in practice. The
   results indicate that governance challenges observed in the Patraikos
   Gulf, including fragmented authority, legitimacy deficits, and limited
   participation, reflect broader structural patterns in the region. They
   also suggest that governance approaches perceived as adaptive,
   transparent, and responsive to local socio-ecological conditions may
   help improve alignment between policy frameworks and implementation. In
   this context, fine-grained governance, i.e., governance approaches that
   account for spatial and social heterogeneity by tailoring measures to
   local ecological conditions and stakeholder contexts, is identified as a
   potential direction for strengthening fisheries governance.},
