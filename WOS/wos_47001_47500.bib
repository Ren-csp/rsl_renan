
@article{ WOS:001846640100001,
Author = {Campo-Gomez, Ethan and Rodriguez-Gomez, Guillermo and Trejo, Beatriz and
   Rodriguez-Alvarez, Xose-Pedro and Huguet, Rosa},
Title = {Ecological conditions for one of the earliest human occupations in the
   Sierra de Atapuerca inferred from prey carrying capacity and meat
   availability at Sima del Elefante},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {14},
Month = {JUL 29},
Abstract = {The availability of meat resources and competition with large carnivores
   were important factors in the survival of Early Pleistocene
   hunter-gatherer groups. Estimating these factors makes it possible to
   reconstruct the paleoecosystem in which hominins lived and to evaluate
   their interactions with prey and carnivore communities. The main
   objective of this paper is to estimate prey carrying capacity, total
   available meat biomass, and potential hominin density in the
   large-mammal paleocommunity recorded in Level TE9c of the Sima del
   Elefante (Sierra de Atapuerca, Burgos). To achieve this goal, survival
   and mortality profiles were reconstructed using the Weibull model to
   estimate the biomass of prey potentially available to hominins and
   carnivores. The results indicate that the TE9c paleoecosystem could have
   sustained a hominin population density of approximately 11 individuals
   per 100 km2. This potential density would have been constrained by
   competition with other meat consumers, particularly large carnivores, in
   an ecosystem where small- and medium-sized prey contributed
   substantially to the total available biomass. These results suggest
   that, in terms of meat availability, the TE9c paleoecosystem was
   compatible with low-density hominin groups in the Sierra de Atapuerca
   during the Early Pleistocene.},
