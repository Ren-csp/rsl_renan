Author = {Santika, Truly and Wilson, Kerrie A. and Budiharta, Sugeng and Kusworo,
   Ahmad and Meijaard, Erik and Law, Elizabeth A. and Friedman, Rachel and
   Hutabarat, Joseph A. and Indrawan, Tito P. and St John, Freya A. V. and
