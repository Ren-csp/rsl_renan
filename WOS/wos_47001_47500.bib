@article{ WOS:001596127400001,
Author = {Schulte, Horst Christian and Lucrezi, Serena},
Title = {Is kelp monitoring on kayaks a viable form of marine science tourism?},
Journal = {JOURNAL OF ECOTOURISM},
Year = {2025},
Month = {2025 OCT 16},
Abstract = {Marine science tourism (MST) is an industry with benefits and challenges
   related to the quality of tourists' contributions, tourists' engagement,
   marketing, and stakeholder collaborations. This study tested the
   efficacy of an MST product, generating valid data while engaging
   tourists in simple tasks with minimal time commitment and at a
   reasonable cost. From April to June 2024, 18 volunteers were recruited
   at a marine research organisation in South Africa to test a new protocol
   of kelp bed monitoring from a kayak over a half-day trip. Six kelp beds
   were monitored over 12 trips. The participants were divided into regular
   tourists (n = 12) and interns with a background in environmental
   monitoring (n = 6) to validate the data. All were interviewed to assess
   their perceptions of the experience and attitudes. There were no
   significant differences in the kelp data collected by the two groups.
   The participants were satisfied with the experience, displayed positive
   short-term changes in environmental attitudes and increased learning,
   and were willing to pay for this experience. The results of this study
   confirm the potential of science tourism to be engaging, educational,
   affordable and useful, but only if adequately organised and promoted.},
