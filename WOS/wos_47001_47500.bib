@article{ WOS:001868562500001,
Author = {Tuler, Seth P. and Bearth, Angela and Fjaeran, Lisbet and Gaspar, Rui
   and Gould, Kenneth Pettersen and Ram, Bonnie and Schweizer, Pia-Johanna
   and Webler, Thomas and Goble, Rob},
Title = {The Social Amplification of Risk Framework Revisited: Report From an
   Exst Workshop on Opportunities for Conceptual Advancement},
Journal = {RISK ANALYSIS},
Year = {2026},
Volume = {46},
Number = {9},
Month = {SEP 6},
Abstract = {The Social Amplification of Risk Framework (SARF) is intended to
   facilitate the integration of studies about risk across natural,
   biological, physical, and social sciences. Researchers employing SARF
   have advanced understandings of the complex dynamic responses of social
   systems to hazards, the ways that risks are experienced and perceived,
   and the ways that consequences can ripple across social and governance
   systems, geographies, and economic sectors. In seeking to build on a
   Special Issue of Risk Analysis on SARF organized and edited by
   Kasperson, et al. (2022), an international interdisciplinary group of
   scholars convened an invited expert Workshop on SARF at the Federal
   Institute of Technology in Zurich during April 2024. Here we report on
   the outcomes emerging from the workshop. First, we sought to clarify
   definitions of concepts, such as risk signals, risk amplification, and
   risk attenuation. Second, we sought to overcome the tendency in studies
   using SARF to focus on information processing by the public and neglect
   the ways that other social actors play roles in risk amplification and
   attenuation. Third, we propose a new metaphor, risk resonance, to focus
   attention on why certain risk signals gain traction and others do not,
   which has also been a topic that has to date received minimal attention.
   Fourth, our discussions led us to highlight the importance of better
   integration of context and history into analyses employing SARF. We
   conclude the paper with thoughts about how the framework can achieve its
   yet unmet potential to inform risk research, policy, and management.},
