@article{ WOS:000207242900001,
Author = {Eastwood, Arthur},
Title = {CHEMICO-PHYSICAL STABILITY AND CANCER},
Journal = {JOURNAL OF HYGIENE},
Year = {1929},
Volume = {29},
Number = {2},
Pages = {117-131},
Month = {JUL},
Abstract = {To clarify the relationship of Rous sarcoma to human malignancy, the
   author has offered three simple hypotheses. (1) Living viruses cause
   avian and mammalian disease. (2) Such disease is due to development
   within living cells of an enzyme capable of producing malignancy. (3)
   Mammalian malignancy due to chronic irritation, Rous sarcoma is of
   different nature. The author accepts the 3rd hypothesis. He treats
   subject as part of a general problem in cellular variation, illustrating
   the influence of chemical-physical stabilization in production of
   variance. It is emphasized that in bacteriophage phenomena the agent is
   stable outside the cell. In fowl sarcoma it is stable within and outside
   of the cell. In mammalian cancer it is strictly stable within the cell.
   From this aspect the mysterious ens malignitatis may be replaced by a
   common principle determining cellular variation.},
Publisher = {CAMBRIDGE UNIV PRESS},
