@article{ WOS:A1976CB69300017,
Author = {LOOPER, M},
Title = {EFFECT OF ATTENTION LOADING ON INHIBITION OF CHOICE REACTION-TIME TO
   VISUAL-MOTION BY CONCURRENT ROTARY MOTION},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1976},
Volume = {20},
Number = {1},
Pages = {80-84},
Abstract = {The influence of attention loading on the established intersensory
   effects of passive bodily rotation on choice reaction time (RT) to
   visual motion was investigated. Human subjects sat at the center of
   rotation in an enclosed rotating chamber and observed an oscilloscope on
   which were, in the center, a tracking display and, 10.degree. left of
   center, a RT line. Three tracking tasks and a no-tracking control
   condition were presented to all subjects in combination with the RT
   task, which occurred with and without concurrent cab rotations. Choice
   RT to line motions was inhibited (P < .001) when there was simultaneous
   vestibular stimulation and when there was a tracking task; response
   latencies lengthened progressively with increased similarity between the
   RT and tracking tasks. The attention conditions did not affect the
   intersensory effect; the significance of this for the nature of the
   sensory interaction is discussed.},
