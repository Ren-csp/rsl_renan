@article{ WOS:000663720100007,
Author = {Brown, Carol E. and Schwatka, Natalie and Dexter, Lynn and Dally,
   Miranda and Shore, Erin and Tenney, Liliana and Newman, Lee S.},
Title = {The Importance of Small Business Safety and Health Climates During
   COVID-19},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2021},
Volume = {63},
Number = {2},
Pages = {81-88},
Month = {FEB},
Abstract = {Objective: This study examines employee perceptions of safety and health
   climates for well-being during the COVID-19 pandemic in a sample of
   small businesses. Methods: We evaluated changes to employees' work and
   home life resulting from COVID-19 and perceptions of safety and health
   climates. Cross-sectional relationships were assessed using
   multivariable linear regression models for a sample of 491 employees
   from 30 small businesses in Colorado in May 2020. Results: Employee
   perceptions of safety and health climates were significantly related to
   their self-reported well-being during the first wave of COVID-19, even
   when there were changes to childcare, the ability to work, and limited
   social contacts. Conclusion: Safety and health climates may influence
   employee well-being even when other disruptions occur, suggesting that
   during emergencies, small businesses with strong climates may be better
   prepared to maintain employee well-being.},
