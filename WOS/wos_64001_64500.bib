@article{ WOS:001643476400001,
Author = {Kagami, Asuka and Hashimoto, Nami and Sasaki, Ryoko and Fukushima,
   Yutaro and Devkota, Hari Prasad and Tanaka, Shoya and Wada, Mikiyo and
   Yamanaka, Kunitoshi and Yamakawa, Shiori and Misumi, Shogo and Yokoyama,
   Takeshi and Mizuguchi, Mineyuki and Sato, Takashi and Nakamura, Teruya
   and Kotani, Shunsuke and Suico, Mary Ann and Kai, Hirofumi and Ueda,
   Mitsuharu and Shuto, Tsuyoshi},
Title = {Glycosidic scaffold bearing multiple galloyl moieties from pomegranate
   disrupts transthyretin amyloids},
Journal = {ISCIENCE},
Year = {2026},
Volume = {29},
Number = {1},
Month = {JAN 16},
Abstract = {Transthyretin (TTR) amyloidosis involves TTR misfolding and aggregation,
   causing systemic organ dysfunction. Current therapies stabilize TTR
   tetramers or reduce TTR production but are less effective against
   existing amyloid deposits. Here, we identified
   1,2,3,4,6-penta-O-galloyl-beta-D-glucose (PGG), derived from pomegranate
   (Punica granatum L.) leaf-and-branch extracts (PGL), as a disruptor of
   preformed TTR amyloid fibrils. PGG disaggregated fibrils formed by V30M
   and wild-type (WT) TTR, which are linked to hereditary Transthyretin
   Amyloidosis (ATTR) (ATTRv) and ATTRwt, respectively. Structure-activity
   relationship studies showed galloyl moieties are essential. In
   Caenorhabditis elegans-expressing human TTR81-127, PGG reduced TTR
   aggregation and extended both lifespan and healthspan. PGG selectively
   targeted TTR amyloids without affecting amyloid-beta fibrils, indicating
   specificity. PGG disrupted TTR amyloid fibrils isolated from patient
   cardiac tissue. These findings suggest that PGG shows therapeutic
   potential for TTR amyloidosis by directly targeting and disrupting
   pathogenic amyloid aggregates.},
