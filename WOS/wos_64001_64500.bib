@article{ WOS:001043365600018,
Author = {Maidaniyk, Iryna and Strikhar, Oksana and Rudyy, Roman and
   Shelepnytska-Govorun, Nataliya and Bilova, Nataliia and Yeroshenko,
   Olena},
Title = {Development of Music Education in Postmodern Society},
