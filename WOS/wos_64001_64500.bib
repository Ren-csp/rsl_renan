@article{ WOS:000888181400001,
Author = {Miara, M. D. and Negadi, M. and Tabak, S. and Bendif, H. and Dahmani, W.
   and Hammou, M. Ait and Sahnoun, T. and Snorek, J. and Porcher, V and
   Reyes-Garcia, V and Teixidor-Toneu, I},
Title = {Climate Change Impacts Can Be Differentially Perceived Across Time
   Scales: A Study Among the Tuareg of the Algerian Sahara},
Journal = {GEOHEALTH},
Year = {2022},
Volume = {6},
Number = {11},
Month = {NOV},
Abstract = {As an Indigenous community of Algeria and the broader Sahel, the Tuareg
   hold unique ecological knowledge, which might contribute to broader
   models of place-based climate change impacts. Between January and April
   2019, we carried out semi-structured interviews (N = 23) and focus group
   discussions (N = 3) in five villages of the province of Illizi, Algeria,
   to document the local Tuareg community's timeline and ecological
   calendar, both of which are instruments used to understand place-based
   reports of climate change impacts. The livelihoods of the Tuareg of
   Illizi are finely tuned to climate variability as reflected in changes
   reported in the cadence of events in their ecological calendar (marked
   by cyclical climatic and religious events). Participants reported rain
   and temperature irregularities and severe drought events, which have
   impacted their pastoral and semi-pastoral livelihoods. These reports are
   aligned with scientifically measured climate observations and
   predictions. Paradoxically, although participants recall with detail the
   climatic disasters that happened in the region over the last century,
   the Tuareg do not explicitly report decadal trends in the frequency of
   extreme events. The differential perception of climate change impacts
   across scales can have important implications for undertaking climate
   change adaptation measures.},
