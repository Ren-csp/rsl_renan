@article{ WOS:001829419400001,
Author = {Lore, Madison and Caggiano, Holly and Constantino, Sara},
Title = {Quantifying patterns of news media framing and social acceptance of
   renewable energy},
Journal = {ENVIRONMENTAL RESEARCH LETTERS},
Year = {2026},
Volume = {21},
Number = {14},
Month = {JUL 28},
Abstract = {The energy transition in the U.S. has become politicized such that local
   opposition-often driven by national level media narratives-drives delay
   or cancellation of wind and solar projects. Using a nationally
   representative survey (n = 4 061) and nearly 360 000 Fox News, CNN, and
   MSNBC broadcast transcripts, this study illustrates the relationship
   between partisan differences in national media coverage and local
   perceptions of energy projects. Using natural language processing
   methods, this study reveals the key themes and framing of energy
   coverage in the news on networks that span the political spectrum. We
   then show how the framing of energy transitions on these networks
   relates to individual-level support or opposition to local energy
   projects. This work informs our understanding of the relationship
   between national narratives and support for local energy projects,
   potentially allowing policymakers to counter risk narratives by clearly
   stating the gains and benefits of renewable energy projects.},
