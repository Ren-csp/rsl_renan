@article{ WOS:000583006500001,
Author = {Onyango, Elizabeth Opiyo and Elliott, Susan J.},
Title = {Bleeding Bodies, Untrustworthy Bodies: A Social Constructionist Approach
   to Health and Wellbeing of Young People in Kenya},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {20},
Month = {OCT},
Abstract = {The Sustainable Development Goals provide a global development agenda
   that is meant to be inclusive of all people. However, the development
   needs for vulnerable populations such as youth are not reflected within
   the policy agenda of some developing countries. One of the reasons for
   this is that research that explores health and wellbeing concerns for
   young people are sparse in the region and where they exist, the focus
   has been on marginalized subgroups. To address this gap, this
   cross-sectional study explored the health and wellbeing of youth in
   Kenya. We conducted 10 focus group discussions and 14 in-depth
   interviews with youth ages 15 to 24 years. A thematic analysis of the
   data revealed that structural factors are important influencers of youth
   perceptions and their social constructions of health and wellbeing.
   Kenyan youth are concerned about the health status and healthcare
   services in their communities, as well as issues of community trust of
   youths and perceived risks of political misuse and emotional suffering.
   Our findings suggest that youth transitioning into adulthood in
   resource-constrained areas experience feelings of powerlessness and
   inability to take charge over their own life. This impacts how they
   perceive and socially construct health and wellbeing.},
