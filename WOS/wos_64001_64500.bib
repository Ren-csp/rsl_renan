@article{ WOS:001544589400001,
Author = {O'Donoghue, Rob and Molefe, Leonard},
Title = {Bridging worlds: A critical realist approach to integrating Indigenous
   and scientific knowledge for sustainable education},
Journal = {JOURNAL OF ENVIRONMENTAL EDUCATION},
Year = {2026},
Volume = {57},
Number = {1},
Pages = {55-58},
Month = {JAN 2},
Abstract = {This article explores how critical realism (CR) can serve as a
   philosophical foundation for integrating Indigenous and Western
   scientific knowledge in Education for Sustainable Development (ESD).
   Drawing on Roy Bhaskar's framework, the paper emphasizes the dual
   recognition that reality exists independently of human perception, while
   all knowledge is culturally and historically mediated. In postcolonial
   contexts like Southern Africa, where epistemic hierarchies have
   marginalized Indigenous heritage, CR provides tools for immanent
   critique, epistemic justice, and dialogical learning. The paper argues
   that meaningful curriculum reform requires recognizing both the
   ontological depth of Indigenous practices and the epistemological value
   of diverse worldviews. It advocates for pedagogical models that connect
   abstract scientific concepts with lived experience and heritage
   knowledge, fostering co-produced learning and transformational praxis.
   CR thus offers educators a way to reconcile plural knowledge systems and
   promote sustainability through culturally grounded, critically informed
   education.},
