@article{ WOS:001182978300001,
Author = {Esteban Liranzo-Gomez, Rolando and Torres-Valle, Antonio and Javier
   Jauregui-Haza, Ulises},
Title = {Risk Perception Assessment of Sargassum Blooms in Dominican Republic},
Journal = {SUSTAINABILITY},
Year = {2024},
Volume = {16},
Number = {5},
Month = {MAR},
Abstract = {The Sargassum have become a cyclical phenomenon that generates
   ecological, economic, and social problems in the Caribbean. The
   situation becomes more serious in a context of voluntary acceptance of
   the problem, which generates difficulties regarding the behaviors to
   control it. This research addresses the phenomenon from the perspective
   of risk perception concerning Sargassum invasions in the Dominican
   Republic, using a tool that includes perceptual and behavioral
   questions. The results show an underestimation of the risk of Sargassum
   blooms attributed to its interpretation as a natural and inevitable
   phenomenon, with an insignificant effect. This underestimation does not
   notably affect the health or standard of living of the population
   involved but has not been sufficiently addressed by scientific
   institutions and the Dominican government. The alert about some
   erroneous beliefs regarding the phenomenon, as shown by these
   perceptions, can contribute to designing successful policies for the
   control and management of massive influx of Sargassum. This
   transformation can turn them from an environmental problem into an
   opportunity for sustainable development. Based on the risk analysis,
   actions are suggested to guarantee the sustainable management of
   Sargassum blooms in the Dominican Republic.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Jauregui-Haza, U (Corresponding Author), Inst Tecnol Santo Domingo, Area Basic \& Environm Sci, Ave Los Proceres 49, Santo Domingo 10602, Dominican Rep.
