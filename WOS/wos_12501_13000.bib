@article{ WOS:001400252900001,
Author = {Anees, Shoaib Ahmad and Mehmood, Kaleem and Raza, Syed Imran Haider and
   Pfautsch, Sebastian and Shah, Munawar and Jamjareegulgarn, Punyawi and
   Shahzad, Fahad and Alarfaj, Abdullah A. and Alharbi, Sulaiman Ali and
