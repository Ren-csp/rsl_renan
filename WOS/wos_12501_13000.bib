@article{ WOS:001875940000001,
Author = {Gyamfi, Richard and Andam-Arkoful, Samuel Ato and Amoah-Nuamah, John},
Title = {Urban expansion and thermal transformation in the Greater Kumasi
   Sub-Region, Ashanti Region, Ghana},
Journal = {SCIENTIFIC AFRICAN},
Year = {2026},
Volume = {34},
Month = {DEC},
Abstract = {Rapid urban expansion is reshaping land cover and surface thermal
   conditions across many subSaharan African cities. This study examined
   land-use and land-cover change and land surface temperature dynamics in
   the Greater Kumasi Sub-Region, Ghana, between 2004 and 2024. Landsat
   imagery for 2004, 2014, and 2024 was classified using a Support Vector
   Machine algorithm. LST was retrieved using a single-channel approach
   with NDVI-based surface-emissivity correction. Thermal changes,
   land-surface associations, administrative variations, and population
   exposure were analyzed utilizing spectral indices, Pearson correlation,
   zonal statistics, and WorldPop data. Built-up land increased from 29,855
   ha to 84,152 ha, representing a 181.87\% increase, mainly through the
   conversion of open vegetation and farmland. Mean LST rose from 25.88
   degrees C to 29.23 degrees C, with 3.12 degrees C of the 3.35 degrees C
   increase occurring between 2014 and 2024. Areas with LST >= 27 degrees C
   expanded from 8.93\% of the valid mapped area in 2004 to 92.80\% in
   2024, although the smaller valid raster extent in 2004 requires cautious
   interpretation. In 2024, LST was positively associated with built-up and
   bare surfaces and negatively associated with vegetation and
   water-related surfaces. Approximately 84.02\% of the estimated
   population was located within high or very high LST zones. Densely
   developed districts recorded the highest LST, while several peri-urban
   administrative units experienced the fastest warming. The findings
   support stronger development control, protection of connected green
   infrastructure, and targeted heat-mitigation measures in rapidly warming
   and densely populated districts.},
