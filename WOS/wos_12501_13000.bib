@article{ WOS:001627742400001,
Author = {Chen, Yujie},
Title = {Analysis and evaluation of urban roaming paths based on users'
   perspective--the case of Beijing},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2025},
Volume = {14},
Number = {4},
Pages = {976-989},
Month = {DEC},
Abstract = {With the booming development of tourism and the public's pursuit of
   personalized and in-depth experiences, urban wanderlust has been widely
   welcomed as an emerging form of tourism. Urban roaming paths are crucial
   for shaping city image and enhancing tourists'experiences. This study
   constructs an evaluation system for the design elements of urban roaming
   paths from the user's perspective and identifies the key elements by
   applying the IPA-Kano model for analysis. The results of the study show
   that the seat setup, degree of shading, and Internet-famous site setting
   are the most prioritized elements to be considered in the design. In
   addition, guided signage system, restroom, bicycle parking, the type of
   commercial business, and selectivity of the route are also important
   design elements. The conclusions of this study not only provide
   empirical data and a scientific basis for city managers and designers
   but also provide a lesson and reference for the optimization and
   updating of urban roaming paths, which can help to enhance the
   attractiveness and competitiveness of urban tourism.},
