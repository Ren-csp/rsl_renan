@article{ WOS:001621417200001,
Author = {Ganthaler, Andrea and Barkmann, Friederike and Leitinger, Georg and
   Rudisser, Johannes and Mayr, Stefan},
Title = {Living at the edge: Varying substrate depth on green roofs affects the
   microclimate and plant establishment},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2025},
Volume = {114},
Month = {DEC},
Abstract = {Green roofs are mainly created as extensive green roofs with a few
   centimetres of substrate. This limits their water-holding capacity and
   the number of suitable plant species. Roofs incorporating areas with
   thicker substrate depths and structural heterogeneity may offer a
   promising balance between the low weight and cost of extensive greening
   and improved growing conditions. However, the effects of this design on
   microclimate and vegetation establishment have been little studied. On a
   large extensive green roof in Tyrol, Austria, we found that roof areas
   with increased substrate depth had significantly reduced maximum soil
   and surface temperatures (from 47.7 and 57.1 degrees C with 7 cm
   substrate to 38.7 and 49.6 degrees C with 14 cm substrate,
   respectively). Deeper substrate increased water resources and allowed
   higher cover of vascular species and non-succulent herbs but had no
   effect on mean plant ecological indicator values. Sedums showed more
   stable plant water potentials (maximum-0.6 MPa) compared to
   non-succulent herbs (maximum-2.2 MPa), but the former suffered from leaf
   temperatures above 52 degrees C and associated photosynthetic
   impairment. Deadwood piles on gravel allowed the growth of plant species
   not otherwise found on the roof. Our results demonstrate that even small
   variations in substrate depth can create distinct microclimates on an
   otherwise homogeneous green roof. More favourable temperature and
   moisture conditions in deeper substrate areas can promote the growth and
   diversity of plants. Green roofs with varying substrate depths could
   thus help to avoid uniform sedum-dominated vegetation and contribute to
   reducing the environmental impact of large industrial buildings.},
