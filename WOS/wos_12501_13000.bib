@article{ WOS:001877598100001,
Author = {Arboix-Alio, Alba and Roda, Oriol Ventura},
Title = {Data on the urban implementation of Catholic parish churches in
   Barcelona},
Journal = {DATA IN BRIEF},
Year = {2026},
Volume = {69},
Month = {AUG},
Abstract = {This article describes a dataset on the urban implementation of 132
   Catholic parish churches located within the municipal boundaries of
   Barcelona. The dataset derives from the collection of churches compiled
   for the doctoral thesis ``Esgl \& eacute;sia i ciutat. El paper dels
   temples parroquials en la construcci \& oacute; de Barcelona (= Church
   and City. The role of parish churches in the construction of
   Barcelona){''} and extends its reuse as open material through a
   district-based territorial ordering and a classification of the
   relationship between church and public space. The repository contains
   ten district maps, drawn at the same scale, on which the 132 urban
   enclaves are represented. In these maps, each parish church is
   identified by a Latin-cross symbol indicating its orientation, while the
   public space in the immediate surroundings is highlighted through a
   thickened line. The data are organized into five main
   urban-implementation categories: 1) strict street alignment; 2) setback
   from the street creating a widening or atrium; 3) associated square or
   open space, either single or composed of several concatenated spaces; 4)
   concealed block-interior location; and 5) camouflaged condition, either
   inserted at ground-floor level or using the ordinary built grain of the
   neighbourhood. A chamfer condition is also included as an informative
   subcount, particularly relevant in the Eixample grid. The article
   presents ten district maps and three data tables: a quantitative summary
   by district, an index of parish churches by district and alphanu meric
   code, and a table grouping the churches by district and
   urban-implementation category. Published by Elsevier Inc. This is an
   open access article under the CC BY-NC license
   (http://creativecommons.org/licenses/by-nc/4.0/)},
