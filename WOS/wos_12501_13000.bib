@article{ WOS:001562380800001,
Author = {Morse, Joshua W. and Morse, Cheryl E. and Pratson, Daniel F. and Gould,
   Rachelle K.},
Title = {Stories reveal plural values of human-coyote interactions aft the sample
   and individual scales in Vermont, United States},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {10},
Pages = {2421-2436},
Month = {OCT},
Abstract = {Background. Measuring plural values of nature in ways designed to inform
   policy and practice can advance decision-making that reflects diverse
   worldviews and value systems. Plural valuation is also theorized as a
   promising method for capturing nuance and identifying common ground, but
   this potential is rarely tested. Developing and testing methods for
   plural value elicitation is a priority for the field. Research goal. We
   investigate whether a story-based approach is effective for gathering
   information on instrumental, intrinsic and relational values as well as
   their potential interplay. We further explore whether plural valuation
   can provide new insights into a contentious wildlife management issue:
   living with Eastern coyotes in Vermont, United States. Methods. We
   analyse a community social science sample of 150 stories about
   human-coyote interactions for value statements and attitudes about
   coyotes. Results. We find that instrumental, intrinsic and relational
   values co-occur both in the sample as a whole and in some individual
   interviewees' accounts of their coyote experiences. We also report on
   general attitudes about coyotes and explore the ways that these
   attitudes do and do not align with the values and disvalues evoked in
   specific coyote encounters. Policy and practice implications. We
   conclude with suggestions for how plural valuation data could guide
   decision-makers, both in our study area and more broadly, towards
   identifying new ways to approach and defuse polarized discourses around
   wildlife management and coexistence.Read the free for this article on
   the Journal blog.},
