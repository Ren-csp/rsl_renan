@article{ WOS:001849625000001,
Author = {Li, Ling and Cao, Shisong and Du, Mingyi and Liang, Ying and Chen,
   Jingyi and Liu, Rui and Wang, Nuan},
Title = {Investigating the impact of urban morphology and building change
   trajectories on annual temperature cycle},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {To characterize how urban form and its evolution shape long-term urban
   thermal environments, this study integrated Landsat 8 thermal imagery
   (2014-2017) and high-resolution LiDAR point clouds to analyze the
   impacts of two- and three- dimension urban morphology parameters (UMPs)
   and building change trajectories on the annual temperature cycle (ATC)
   in northern Brooklyn, New York. We employed the XGBoost model to
   quantify two- and three- dimension urban morphology parameters (UMPs) on
   the annual temperature cycle (ATC) nonlinear relationships and
   introduced a bi-threshold model to capture five building change
   trajectories and utilized the Robust Iteratively Reweighted Least
   Squares (RIRLS) model with new indicator thresholds to clearly identify
   the timing of these changes. Results shows that manufacturing and mixed
   zones exhibited highest temperature variability, while water bodies and
   parks demonstrated effective cooling. The XGBoost model achieved
   moderate explanatory power: Amplitude (R2 = 0.50), Tmean (R2 = 0.42),
   Peakday (R2 = 0.40), and Tmax (R2 = 0.43). low BC values provided
   shading benefits, whereas BC exceeding 0.6 markedly intensified thermal
   stress due to extensive impervious surfaces and reduced ventilation.
   Building trajectory analysis revealed that vegetation-to-building
   transitions elevated Tmean by 1.57 degrees C, whereas
   building-to-vegetation conversions reduced Amplitude by up to 8.88
   degrees C. Compared to previous studies that mainly focused on static
   morphology-LST relationships, this study explicitly quantifies how
   spatial morphology and temporal building metabolism jointly drive annual
   temperature cycles. It provides concrete thresholds and transition
   effects that can guide the planning of climate-responsive urban layouts
   and targeted heat mitigation strategies.},
