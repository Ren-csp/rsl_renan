@article{ WOS:001227911900001,
Author = {Pinto, Luis Valenca and Ferreira, Carla Sofia Santos and Pereira, Paulo},
Title = {Temporal and spatial differences in human activities performed in Urban
   Green Spaces of Vilnius (Lithuania)},
Journal = {GEOGRAPHY AND SUSTAINABILITY},
