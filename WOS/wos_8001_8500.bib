Title = {PLANTS AS INDICATORS OF ENVIRONMENTAL CONDITIONS OF URBAN SPACES FROM
   CENTRAL PARKS OF BUCHAREST},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2010},
