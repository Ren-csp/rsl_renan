Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Kjellesvig, H (Corresponding Author), Norwegian Univ Life Sci, LANDSAM, Dept Publ Hlth Sci, As, Norway.
