@article{ WOS:001477884600001,
Author = {Alfirevic, Dorde and Alfirevic, Sanja Simonovic and Nikolic, Sanja},
Title = {Impact of internal openness on the sustainability of residential space},
Journal = {OPEN HOUSE INTERNATIONAL-SUSTAINABLE \& SMART ARCHITECTURE AND URBAN
   STUDIES},
