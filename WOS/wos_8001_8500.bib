@article{ WOS:001747473300001,
Author = {Li, Xiaoming and Zhang, Diyan and Yang, Yang and Li, Wenwen and Nan,
   Xiangyan and Zhao, Tianran and Yan, Fei and Bao, Guanglong},
Title = {Drivers of urban blue-green space loss: a study on the coordination
   between economic growth and land use change},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2026},
Volume = {14},
Month = {APR 10},
Abstract = {Introduction Coordinated development of urban blue-green spaces helps
   mitigate extreme surface temperatures and counteracts the urban heat
   island effect. Studying the driving factors behind the evolution of
   urban blue-green space patterns contributes to enhancing the natural and
   social sustainability of the urban environment. This study takes China's
   most economically dynamic region, the Yangtze River Delta (YRD), as a
   case study to reveal the spatiotemporal dynamics and driving mechanisms
   of blue and green space evolution from 2000 to 2022. This provides a
   basis for achieving harmonious human-land relationships.Methods Using a
   land-use transition matrix, spatiotemporal dynamic maps, and
   spatiotemporal geo-weighted regression (GTWR) models, the study analyzed
   the heterogeneous impacts of 11 socioeconomic and natural environmental
   factors on changes in blue-green spaces.Results The results indicate a
   significant expansion of impervious area in the YRD, with a net increase
   of 214.64 \& times; 104 hm2; 90.47\% of this increase originated from
   cropland. (The calculation method is the area of cropland converted to
   impervious area divided by the total expansion area of impervious area.)
   The loss of cropland exhibits phased characteristics: construction
   encroachment dominated from 2000 to 2015, while ecological restoration
   gained prominence after 2015. This confirms the transition from
   ``squeeze to restoration.{''} Water area utilization exhibited spatial
   differentiation, characterized by ``development in the south and
   restoration in the north,{''} with the reclaiming of water areas for
   cropland being a prominent phenomenon. GTWR model results revealed
   significant spatiotemporal heterogeneity in the driving factors. The
   negative impact of economic factors on cropland decreased over time,
   while the positive effect of agricultural modernization increased. The
   core region was primarily driven by economic factors, while agricultural
   structural transformation had a more significant influence on inland
   provinces.Discussion This study provides robust spatiotemporal evidence
   to support coordinated economic growth and cropland conservation in the
   YRD. It confirms a dynamic shift in regional development philosophy from
   ``economic priority{''} to ``ecological-economic synergy.{''} The study
   also offers scientific support for formulating differentiated land
   management policies.},
