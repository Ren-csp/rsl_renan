@article{ WOS:000422326400071,
Author = {Ajaps, Sandra and McLellan, Ros},
Title = {``We don't know enough{''}: Environmental education and
   pro-environmental behaviour perceptions},
Journal = {COGENT EDUCATION},
Year = {2015},
Volume = {2},
Number = {1},
Abstract = {This study sought to understand environmental knowledge and attitudes
   among young people to explain the relationship between environmental
   education (EE) and reported pro-environmental behaviours (PEB). A
   mixed-methods design was employed: 88 university students in the UK and
   Nigeria were surveyed and 6 were subsequently interviewed. The findings
   indicate that the participants believe humans are abusing the earth and
   are very concerned about the consequences but do not know enough about
   environmental problems, especially global warming. Also, those who had
   more environmental knowledge reported more PEB. Generally, participants
   want more EE content to be taught in schools and in more engaging ways
   such as field trips. These findings offer important insights for both
   theory and practice related to the use of education to develop PEB for a
   healthier environment.},
