@article{ WOS:001777986600001,
Author = {Verkuil, Loes A. and Schulp, Nynke and Torralba, Mario},
Title = {Nature's values, drivers and perceived influence on ecosystem services
   shape agroecological livestock farming in the Netherlands},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2368-2382},
Month = {JUL},
Abstract = {The environmental benefits of agroecological farm management have been
   demonstrated, but its uptake is still lagging. Understanding how
   specific practices relate to drivers and ecosystem services (ES), and
   what values of nature underlie those factors can be useful in
   understanding what type of practices are preferred by farmers under
   which specific conditions. We studied the management strategies of
   agroecological livestock (dairy and beef) farmers on sandy soil in the
   Netherlands. To analyse the relationships between practices, types of
   drivers and perceived effects on ES, we interviewed 17 large-scale
   agroecological farmers and constructed fuzzy cognitive maps (FCMs).
   Graph theory statistics were used to identify key clusters and factors
   in the farm system. We used the IPBES values of nature framework to
   identify underlying values of drivers. The results revealed two major
   clusters: social and economic factors drive practices such as direct
   sale, exchanging knowledge, involvement in organizations and
   diversification. Stewardship of natural resources, resource autonomy,
   and decreasing human and financial capital drive the uptake of agronomic
   practices in the agroecological system. Instrumental and relational
   values were at the basis of the identified drivers, indicating both
   shallow and deep leverage points for transition, respectively. Farmers
   identified ES with direct benefits as a result of their management, such
   as soil quality, animal health and water availability. Broader societal
   ES, like climate change mitigation and water quality, were acknowledged
   less. Practices associated with relational values are more likely to be
   sustained through time. Strengthening farmers' relational connection to
   nature and fostering a sense of stewardship requires greater awareness
   of the broader positive and negative environmental impacts of their
   actions. Additionally, further research into the economic dimensions of
   applying agroecology is recommended, considering the varied influence of
   human and financial capital to address rising production costs and
   declining labour availability in agriculture.Read the free for this
   article on the Journal blog.},
