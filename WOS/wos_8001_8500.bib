@article{ WOS:001344453300001,
Author = {Morpurgo, Joeri and Huurdeman, Margot A. and Oostermeijer, J. Gerard B.
   and Remme, Roy P.},
Title = {Vegetation density is the main driver of insect species richness and
   diversity in small private urban front gardens},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2024},
Volume = {101},
Month = {NOV},
Abstract = {Urbanisation changes natural ecosystems and vegetation to urban green
   spaces, and causes insect communities to experience novel challenges for
   survival. New evidence suggests that urban green spaces, no matter how
   small, can provide meaningful habitats for insects. Information on
   design and management of small gardens (<6 m(2)) in dense urban areas is
   still scarce. In particular, it is hardly known which garden designs
   provide most benefits to insects. We surveyed 65 small urban fa \&
   ccedil;ade gardens (mu=1.7m(2)) in Amsterdam and The Hague in The
   Netherlands and measured various garden attributes that are expected to
   be relevant for general, flower-visiting and herbivorous insect species
   richness and diversity. Plant coverage and richness were the strongest
   predictors of insect biodiversity and species richness. We found no
   support for associations with native plants or garden size. Synthesis
   and applications: To strengthen insect biodiversity in the urban
   environment, we recommend future design of urban green spaces to focus
   on maximising coverage and richness of vegetation. Although there are
   advantages to using native species, we acknowledge that garden owners
   often prefer exotic species. Some of these can also affect insect
   diversity and abundances positively.},
