@article{ WOS:001162646200001,
Author = {Miranda-Cruz, Lorena and Ortega-Reyes, Jorge and Lopez-Medellin, Xavier},
Title = {The importance of socio-environmental perceptions of a bat colony in the
   Mayan ruins of Uxmal to promote environmental awareness and sustainable
   tourism},
Journal = {PERIPLO SUSTENTABLE},
Year = {2024},
Number = {46},
Pages = {201-219},
Month = {JAN-JUN},
Abstract = {The presence of a colony of Nyctinomops laticaudatus inside the Mayan
   Ruins of Uxmal is believed by local authorities to damage the ancient
   structures due to the deposition of feces. It has therefore been
   proposed that the bats should be excluded, despite a lack of knowledge
   of the environmental services they provide. Our objective was to assess
   the socio-environmental perceptions regarding these bats of visitors to
   Uxmal. Surveys were applied to a sample of visitors, and their responses
   were categorized and analyzed using the Ordinary Least Squares Test of
   the Gnu Regression, Econometrics and Time -series Library program.
   Statistical analytical results indicated that perceptions towards
   conservation of bats were influenced by age, knowledge on feeding
   habits, diseases and threats which were the most important features
   mentioned. Socio-environmental perceptions were positive in general, so
   it is feasible that in the future authorities and visitors will accept
   the presence of bats in Uxmal and learn about their ecological role in
   the region, therefore providing attractive features as bats were very
   important for the Maya culture. We propose guidelines to establish an
   environmental education program with informative flyers as well and
   signs throughout the site explaining the importance of these bats for
   the region.},
Publisher = {UNIV AUTONOMA ESTADO MEXICO, FAC TURISMO GASTRONOMIA},
