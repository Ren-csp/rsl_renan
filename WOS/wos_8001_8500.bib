@article{ WOS:000875668200001,
Author = {Wang, Yuwei and Wu, Yidong and Han, Zhijie},
Title = {Extreme weather and residents' pro-environmental behaviors},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2022},
Volume = {10},
Month = {OCT 7},
Abstract = {Raising residents' awareness of environmental protection and encouraging
   their pro-environmental behavior are essential components of promoting
   the development of green economic transformation. Based on the reality
   of frequent extreme weather worldwide, this paper establishes a
   regression model of extreme weather and residents' pro-environmental
   behaviors using CGSS2013 data and weather data. The results show that
   extreme weather has a significant inhibitory effect on residents'
   pro-environmental behaviors. Further analysis revealed that extreme
   weather reduced residents' environmental perceptions and knowledge, thus
   reducing their motivation to engage in pro-environmental behaviors.},
