@article{ WOS:000379373500008,
Author = {Matsui, Tomoko and Nakamura, Tagiru and Utsumi, Akira and Sasaki,
   Akihiro T. and Koike, Takahiko and Yoshida, Yumiko and Harada, Tokiko
