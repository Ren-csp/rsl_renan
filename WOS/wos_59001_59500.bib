@article{ WOS:000555450000001,
Author = {Lee, Yu-Ri and Khan, Kamal and Armfield-Uhas, Kim and Srikanth, Sujata
   and Thompson, Nicola A. and Pardo, Mercedes and Yu, Lu and Norris, Joy
   W. and Peng, Yunhui and Gripp, Karen W. and Aleck, Kirk A. and Li,
   Chumei and Spence, Ed and Choi, Tae-Ik and Kwon, Soo Jeong and Park,
   Hee-Moon and Yu, Daseuli and Heo, Won and Mooney, Marie R. and Baig,
   Shahid M. and Wentzensen, Ingrid M. and Telegrafi, Aida and McWalter,
   Kirsty and Moreland, Trevor and Roadhouse, Chelsea and Ramsey, Keri and
   Lyons, Michael J. and Skinner, Cindy and Alexov, Emil and Katsanis,
   Nicholas and Stevenson, Roger E. and Choudhary, Jyoti S. and Adams,
   David J. and Kim, Cheol-Hee and Davis, Erica E. and Schwartz, Charles E.},
Title = {Mutations in FAM50A suggest that Armfield XLID syndrome is a
   spliceosomopathy},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {JUL 23},
Abstract = {Intellectual disability (ID) is a heterogeneous clinical entity and
   includes an excess of males who harbor variants on the X-chromosome
   (XLID). We report rare FAM50A missense variants in the original Armfield
   XLID syndrome family localized in Xq28 and four additional unrelated
   males with overlapping features. Our fam50a knockout (KO) zebrafish
   model exhibits abnormal neurogenesis and craniofacial patterning, and in
   vivo complementation assays indicate that the patient-derived variants
   are hypomorphic. RNA sequencing analysis from fam50a KO zebrafish show
   dysregulation of the transcriptome, with augmented spliceosome mRNAs and
   depletion of transcripts involved in neurodevelopment. Zebrafish RNA-seq
   datasets show a preponderance of 3' alternative splicing events in
   fam50a KO, suggesting a role in the spliceosome C complex. These data
   are supported with transcriptomic signatures from cell lines derived
   from affected individuals and FAM50A protein-protein interaction data.
   In sum, Armfield XLID syndrome is a spliceosomopathy associated with
   aberrant mRNA processing during development.},
