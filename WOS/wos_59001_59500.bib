@article{ WOS:000350556400004,
Author = {Young, Hillary S. and McCauley, Douglas J. and Dirzo, Rodolfo and
   Goheen, Jacob R. and Agwanda, Bernard and Brook, Cara and
   Otarola-Castillo, Erik and Ferguson, Adam W. and Kinyua, Stephen N. and
