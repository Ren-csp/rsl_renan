@article{ WOS:001009875900001,
Author = {Aguilar-Trigueros, Carlos A. and Krah, Franz-Sebastian and Cornwell,
   William K. and Zanne, Amy E. and Abrego, Nerea and Anderson, Ian C. and
   Andrew, Carrie J. and Baldrian, Petr and Baessler, Claus and Bissett,
   Andrew and Chaudhary, V. Bala and Chen, Baodong and Chen, Yongliang and
   Delgado-Baquerizo, Manuel and Deveautour, Coline and Egidi, Eleonora and
   Flores-Moreno, Habacuc and Golan, Jacob and Heilmann-Clausen, Jacob and
   Hempel, Stefan and Hu, Yajun and Kauserud, Havard and Kivlin, Stephanie
   N. and Kohout, Petr and Lammel, Daniel R. and Maestre, Fernando T. and
   Pringle, Anne and Purhonen, Jenna and Singh, Brajesh K. and Veresoglou,
   Stavros D. and Vetrovsky, Tomas and Zhang, Haiyang and Rillig, Matthias
   C. and Powell, Jeff R.},
Title = {Symbiotic status alters fungal eco-evolutionary offspring trajectories},
Journal = {ECOLOGY LETTERS},
Year = {2023},
Volume = {26},
Number = {9},
Pages = {1523-1534},
Month = {SEP},
Abstract = {Despite host-fungal symbiotic interactions being ubiquitous in all
   ecosystems, understanding how symbiosis has shaped the ecology and
   evolution of fungal spores that are involved in dispersal and
   colonization of their hosts has been ignored in life-history studies. We
   assembled a spore morphology database covering over 26,000 species of
   free-living to symbiotic fungi of plants, insects and humans and found
   more than eight orders of variation in spore size. Evolutionary
   transitions in symbiotic status correlated with shifts in spore size,
   but the strength of this effect varied widely among phyla. Symbiotic
   status explained more variation than climatic variables in the current
   distribution of spore sizes of plant-associated fungi at a global scale
   while the dispersal potential of their spores is more restricted
   compared to free-living fungi. Our work advances life-history theory by
   highlighting how the interaction between symbiosis and offspring
   morphology shapes the reproductive and dispersal strategies among living
   forms.},
