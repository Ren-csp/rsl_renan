@article{ WOS:001862599400001,
Author = {Cai, Fucheng and Peng, Shuangyun and Xiang, Wenguang and Dong, Juexian
   and Lin, Zhiqiang and Zhu, Jiaying and Feng, Xingqiang and Pan, Xianchun
   and Cai, Fapeng and Cui, Biting and Wang, Weihang and Jing, Ruidan},
Title = {Scene-dependent associations between G-C-I corridor morphology and
   mixed-surface aggregated LST within Beijing's fifth ring road},
Journal = {ECOLOGICAL INDICATORS},
Year = {2026},
Volume = {189},
Month = {AUG},
Abstract = {Although the thermal associations of street geometry, vegetation, and
   development intensity have been widely investigated, existing evidence
   remains fragmented across individual indicators, spatial scales, and
   isolated seasonal or diurnal scenes. Consequently, planning-relevant
   corridor-scale frameworks that jointly classify these dimensions,
   examine their scene-dependent associations with mixed-surface aggregated
   land surface temperature (LST), and quantify adjusted thermal
   differences between representative corridor types remain underdeveloped.
   To address these gaps, we used the high-density built-up area within
   Beijing's Fifth Ring Road as a case study and integrated four selected
   ECOSTRESS overpass scenes-summer daytime, summer nighttime, winter
   daytime, and winter nighttime-with multi-source data on
   three-dimensional urban form and vegetation. A Geometry-Cover-Intensity
   (G-C-I) typology was developed to characterize street-adjacent corridor
   units, and CatBoost combined with SHAP was used to identify dominant
   predictors, nonlinear response patterns, and interactions across scenes
   and corridor types. Covariate-adjusted contrasts were then estimated for
   representative type pairs under comparable observed conditions. The
   results showed clear scene dependence in the associations between
   corridor morphology and aggregated LST. The winter scenes were included
   not to propose winter cooling measures, but to examine whether
   morphology-LST associations persisted or reversed under cold-season
   background conditions. Under the selected summer daytime scene,
   vegetation-related variables, especially street fractional vegetation
   cover and canopy-structure metrics, showed the strongest cooling-related
   associations. Under the selected nighttime scenes, building height,
   interface morphology, and development intensity showed greater relative
   importance. Candidate turning ranges varied across corridor types,
   indicating that the thermal associations of a given morphological
   attribute depend on the joint configuration of geometry, cover, and
   intensity. In addition, contrasts between low- and high-greening types
   generally indicated lower aggregated LST for the higher-greening types
   under the selected summer daytime scene, whereas contrasts involving
   higher development intensity were predominantly warming-oriented.
   Overall, this study provides a reproducible workflow for diagnosing
   scene-dependent morphology-LST associations and translating G-C-I type
   differences into differentiated management cues. The findings should be
   interpreted as mixed-surface, corridor-scale aggregated LST patterns
   observed under selected background scenes, rather than as universal
   thresholds, pure road-surface temperature, or direct evidence of
   pedestrian-level thermal exposure.},
