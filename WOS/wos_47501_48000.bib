@article{ WOS:A1986C835000064,
Author = {GREENSPAN, RJ and OBRIEN, MC},
Title = {GENETIC-ANALYSIS OF MUTATIONS AT THE FUSED LOCUS IN THE MOUSE},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1986},
Volume = {83},
Number = {12},
Pages = {4413-4417},
Month = {JUN},
Abstract = {Mutations at the fused (Fu) locus on chromosome 17 of the mouse disrupt
   embryonic development by altering the organization of the neuroectoderm.
   We have examined the interactions among several independent fused
   mutations, including a deletion of the locus, to define the nature of
   the mutant defects. Closely linked restriction fragment length
   polymorphisms made possible the unambiguous identification of genotype
   in all progeny. Tests with the deletion, as well as interactions among
   alleles, indicate that all three spontaneous mutations are ``gain of
   function{''} defects. Comparisons of relative viabilities of the various
   mutant combinations rank them into a series of increasing severity and
   place constraints on possible modes of gene action.},
