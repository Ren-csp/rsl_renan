@article{ WOS:001797154400001,
Author = {Stabile, Giovanni and Narayanaswami, Meenakshi and Reynolds, Jeremy and
   Ciez, Rebecca E.},
Title = {Job and energy preferences of steelworkers and impacts for industrial
   electrification},
Journal = {ENVIRONMENTAL RESEARCH-ENERGY},
Year = {2025},
Volume = {2},
Number = {4},
Month = {DEC 31},
Abstract = {Electrification, especially when paired with low-carbon electricity
   resources, is one pathway for reducing emissions from the industrial
   sector, but it will also require changes to manufacturing processes and
   jobs of workers in the industry. The steel industry is both one of the
   most emitting industrial sectors, and a sector that has already adopted
   some electrified technology for steel recycling. To learn more about
   what job attributes workers value most and thus are most important to
   preserve in a just electrification transition, we conducted a series of
   semi-structured interviews followed by a short survey with workers
   employed in the steel industry. We find that most workers have rotating
   schedules of day and night shifts, most with a few overtime hours built
   into the schedule. Workers cite pay and other rewards, as well as the
   intrinsic characteristics of their work as positive attributes, although
   they are less satisfied with work-life balance and health and safety in
   their jobs. When it comes to sources of energy, solar energy is viewed
   most positively, while coal and wind are viewed most negatively, which
   is consistent with broader community energy preferences. Workers also
   note weather is already influencing production schedules through
   participation in electricity demand response programs and restrictions
   on the use of cooling water from nearby natural resources. Plans for
   further electrification of the steel industry and adoption of
   intermittent renewables should consider how the resulting production
   patterns will affect the ability to recruit and retain workers.},
