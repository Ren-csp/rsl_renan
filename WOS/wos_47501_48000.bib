@article{ WOS:001262414100001,
Author = {Aresti, Lazaros and Alvi, Maria Romana and Cecinato, Francesco and Fan,
   Tao and Halaj, Elzbieta and Li, Zili and Okhay, Olena and Poulsen, Soren
