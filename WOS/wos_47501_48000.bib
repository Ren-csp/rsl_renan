   Spurrett, David, Univ KwaZulu Natal, Philosophy, ZA-4041 Durban, South Africa.
   Brancazio, Nick, Univ Adelaide, Philosophy, Adelaide, Australia.},
DOI = {10.1080/09515089.2023.2263478},
EarlyAccessDate = {OCT 2023},
ISSN = {0951-5089},
EISSN = {1465-394X},
Keywords = {Affordances; clothing; patriarchy},
