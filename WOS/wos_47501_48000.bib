ORCID-Numbers = {Blokland, Rogier/0000-0003-4927-7185
   Vesakoski, Outi/0000-0002-7220-3347},
Funding-Acknowledgement = {Kone Foundation},
Funding-Text = {The first version of the UraLex cognate corpus with initial loanword
   information was compiled by Jyri Lehtinen (BEDLAN project funded by Kone
