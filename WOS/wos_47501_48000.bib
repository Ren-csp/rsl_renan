@article{ WOS:001555536400003,
Author = {Tekulu, Fikre Belay and Islam, Zubairul},
Title = {Post-war solid waste management in Adigrat, Ethiopia},
Journal = {ASIAN JOURNAL OF WATER ENVIRONMENT AND POLLUTION},
Year = {2025},
Volume = {22},
Number = {4},
Pages = {18-27},
Abstract = {Waste is a general term used to describe materials or products
   considered largely worthless. This study assesses the current post-war
   state of solid waste management in the city of Adigrat, Ethiopia. It
   aims to evaluate household waste generation patterns, disposal
   practices, and community perceptions toward municipal waste services,
   identifying gaps and proposing strategies for sustainable recovery. A
   total of 165 households were chosen randomly from the target demographic
   using a mixed-method research strategy that combined quantitative
   surveys and qualitative interviews for comprehensive insight. The study
   found that the average solid waste generation rate among the 165
   randomly selected households was 1.087 kg/household/day. Most
   respondents (81.8\%) disposed of their waste in open areas or drainage
   systems, and 51.2\% expressed dissatisfaction with municipal solid waste
   collection. These practices have significant implications for public
   health, urban hygiene, and environmental sustainability. To rebuild the
   system, governments, non-governmental organizations, and concerned
   citizens should cooperate through coordinated planning and resource
   mobilization.},
Publisher = {Accscience Publishing},
Address = {8 Burn Road\#15-03 Trivex, Singapore, SINGAPORE},
Type = {Article},
Language = {English},
Affiliation = {Tekulu, FB (Corresponding Author), Adigrat Univ, Coll Social Sci \& Humanities, Dept Geog \& Environm Studies, Adigrat, Tigray, Ethiopia.
   Tekulu, Fikre Belay, Adigrat Univ, Coll Social Sci \& Humanities, Dept Geog \& Environm Studies, Adigrat, Tigray, Ethiopia.
   Islam, Zubairul, Univ Abuja, Dept Management Business \& Econ, Abuja, Nigeria.},
DOI = {10.36922/AJWEP025090061},
