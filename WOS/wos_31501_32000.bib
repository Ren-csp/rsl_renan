@article{ WOS:000475469700001,
Author = {Fox, Natalie S. and Haider, Syed and Harris, Adrian L. and Boutros, Paul
   C.},
Title = {Landscape of transcriptomic interactions between breast cancer and its
   microenvironment},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JUL 15},
Abstract = {Solid tumours comprise mixtures of tumour cells (TCs) and
   tumour-adjacent cells (TACs), and the intricate interconnections between
   these diverse populations shape the tumour's microenvironment. Despite
   this complexity, clinical genomic profiling is typically performed from
   bulk samples, without distinguishing TCs from TACs. To better understand
   TC-TAC interactions, we computationally distinguish their transcriptomes
   in 1780 primary breast tumours. We show that TC and TAC mRNA abundances
   are divergently associated with clinical phenotypes, including tumour
   subtypes and patient survival. These differences reflect distinct
   responses of TCs and TACs to specific somatic driver mutations,
   particularly TP53. These data further elucidate how the molecular
   interplay between breast tumours and their microenvironment drives
   aggressive tumour phenotypes.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
Type = {Article},
Language = {English},
