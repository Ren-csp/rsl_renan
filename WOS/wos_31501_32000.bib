@article{ WOS:000085941400079,
Author = {Zilber, MT and Gregory, S and Mallone, R and Deaglio, S and Malavasi, F
   and Charron, D and Gelin, C},
Title = {CD38 expressed on human monocytes: A coaccessory molecule in the
   superantigen-induced proliferation},
