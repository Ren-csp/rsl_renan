@article{ WOS:001619664000001,
Author = {Taylor, Jo},
Title = {Vicki Couzens' Wurrunggi Biik: Learning from Indigenous Art,
   Spirituality and Country},
Journal = {JOURNAL OF INTERCULTURAL STUDIES},
Year = {2025},
Volume = {46},
Number = {4},
Pages = {539-556},
Month = {JUL 4},
Abstract = {First Peoples' arts are increasingly visible and influential in
   so-called Australia. These arts are often deeply connected with nature,
   spirituality and Indigenous knowledges. Focusing on Vicki Couzens'
   public artwork Wurrunggi Biik and her scholarship, this article contends
   that Indigenous social theory reveals much about the relationships of
   art, spirituality and nature which can inform contemporary sociology of
   religion. This article also draws on Bawaka Country et al.'s (2016)
   theorisation of `relational co-becoming', and Burkhart's {[}2019.
   Indigenizing Philosophy through the Land: A Trickster Methodology for
   Decolonizing Environmental Ethics and Indigenous Futures. Michigan:
   Michigan State University Press] Indigenous philosophy to develop an
   understanding of Wurrunggi Biik as a public, spiritual and political
   manifestation of human and more-than-human agency which disrupts the
   physical and symbolic coloniality of the Naarm (Melbourne) cityscape.
   These findings thereby contribute to the decolonisation of the sociology
   of religion, problematising anthropocentric, colonial assumptions of
