@article{ WOS:001779631300001,
Author = {Zhou, Yuhe and Tian, Chenchen and Zou, Dehao and Wu, Yifei and Yang,
   Guangfei and Yu, Lan},
Title = {Perceived Indoor Environmental Quality Is a Double-Edged Sword:
   Configurational Analysis of Work-Related Flow Among Healthcare Staff},
Journal = {INDOOR AIR},
Year = {2026},
Volume = {2026},
Number = {1},
Abstract = {Work-related flow (WOLF) is essential for maintaining the job
   performance and service quality of healthcare staff. Since altering the
   inherently high-stress, high-risk nature of healthcare work is not
   feasible, enhancing WOLF by improving perceived indoor environmental
   quality (IEQ) may be a viable approach. Drawing on environmental stress
   theory, this study examined the impact of perceived IEQ in hospitals on
   the WOLF of healthcare staff. A field investigation involving 200
   healthcare staff members from a tertiary hospital in northeastern China
   was conducted using structural equation modeling (SEM) and fuzzy-set
   qualitative comparative analysis (fsQCA). The results revealed that
   perceived IEQ, occupational stress, and work engagement jointly
   influenced WOLF. Perceived IEQ exhibited a double-edged effect on flow,
   with both promoting (S1) and inhibiting (S2) pathways. Sensitivity to
   thermal sensation and comfort was stronger than to air freshness.
   Occupational stress served as a marginal condition, while work
   engagement emerged as the core condition of WOLF, fully mediating the
   SEM model relationships. Furthermore, significant differences in IEQ
   perception sensitivity to WOLF were found across positions, educational
   backgrounds, and genders. Overall, improving WOLF among healthcare staff
   requires an integrated consideration of workplace environment,
   occupational stress, and individual characteristics. This study provides
   a novel theoretical foundation and research perspective for enhancing
   healthcare staff ` s WOLF by examining the role of perceived IEQ.},
