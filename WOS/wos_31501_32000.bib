@article{ WOS:001819940800014,
Author = {Perez, Isabel A. Gomez and Ballesta-Claver, Julio and Gallardo-Montes,
   Carmen del Pilar and Cid-Gonzalez, Christian},
Title = {Development and promotion of self-concept in childrenaged 5 to 7 with
   functional dyslalia},
Journal = {EDUCACION XX1},
Year = {2026},
Volume = {29},
Number = {2},
Pages = {385-410},
Abstract = {Functional dyslalia in children aged 5 to 7 has a negative impact on
   their behavior, undermining their confidence, ability to overcome
   challenges, and self-concept. In this context, it is essential to design
   proposals that contribute to their improvement. This study aims to
   evaluate the impact of a phonological development intervention program
   on self-concept in this age group. A quasi-experimental pretest-posttest
   design was used with control and experimental groups, applying the
   Perception of Self-Concept in Childhood Scale (PAI) as the measurement
   instrument. A factorial analysis identified four relevant factors:
   family attachment, school and social environment, affective feelings,
   and autonomy. Inferential tests were used to analyze the effects of the
   program and the influence of variables such as gender, educational
   level, and type of school. The results showed that the school and social
   environment was the most influential factor in self-concept, followed by
   family attachment, particularly in elementary education. Autonomy showed
   significant improvements only in girls at this stage, which requires
   further reinforcement. In contrast, the emotional component did show
   some general improvements, but not enough, suggesting the need to
   incorporate affective strategies in future interventions. The type of
   school (rural or urban) had no differential effect. Overall, the program
   led to a significant increase in self-concept in children, especially in
   boys from early childhood education. These findings support the programs
   effectiveness, adaptability, and applicability for strengthening
   children's overall self-concept development.},
