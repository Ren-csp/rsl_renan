@article{ WOS:000273028400009,
Author = {Yang, Xiaohuan and Ma, Hanqing},
Title = {Natural Environment Suitability of China and Its Relationship with
   Population Distributions},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
