@article{ WOS:000258763900003,
Author = {LaPorte, Justin L. and Ren-Patterson, Renee F. and Murphy, Dennis L. and
   Kalueff, Allan V.},
Title = {Refining psychiatric genetics: from `mouse psychiatry' to understanding
   complex human disorders},
Journal = {BEHAVIOURAL PHARMACOLOGY},
