@article{ WOS:A1994NG81400007,
Author = {BAR, ME and OSCHEROV, EB and DAMBORSKY, MP and PORCEL, EA and ALVAREZ,
   BM},
Title = {POPULATION INTERACTIONS BETWEEN TRIATOMA-INFESTANS AND TRIATOMA-SORDIDA},
Journal = {REVISTA DE SAUDE PUBLICA},
