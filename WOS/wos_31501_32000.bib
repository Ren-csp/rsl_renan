Note = {European-Behavioural-Pharmacology-Society Workshop on Behavioural
   Genetics and Neuropsychiatric Disorders, Cork, IRELAND, AUG 25-27, 2008},
Organization = {European Behavioural Pharmacol Soc},
Abstract = {Investigating the pathogenesis of psychiatric disorders is a complicated
   and rigorous task for psychiatric geneticists, as the disorders often
   involve combinations of genetic, behavioral, personality, and
   environmental factors. To nurture further progress in this field, a new
   set of conceptual tools is needed in addition to the currently accepted
   approaches. Concepts that consider cross-species trait genetics and the
   interplay between the domains of disorders, as well as the full spectrum
   of potential symptoms and their place along the pathogenetic continuum,
   are particularly important to address these needs. Here, we outline
   recent concepts and approaches that can help refine the field and enable
   more precise dissection of the genetic mechanisms contributing to
   psychiatric disorders.},
