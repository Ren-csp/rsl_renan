@article{ WOS:001054289700001,
Author = {Quan, Shu and Li, Maojuan and Li, Tianqi and Liu, Haodong and Cui,
   Yaohui and Liu, Miaohan},
Title = {Nonlinear effects of blue-green space variables on urban cold islands in
   Zhengzhou analyzed with random forest regression},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2023},
Volume = {11},
Month = {AUG 11},
Abstract = {Urban cold island effects have become increasingly relevant with
   accelerating climate change. However, the relationship between such
   effects and their causal variables remains unclear. In the present
   study, we analyzed the relationship between blue-green space variables
   and land surface temperature (LST) and park cooling intensity (PCI) in
   central Zhengzhou City using a random forest regression model. Cool
   urban areas corresponded to the location of blue-green spaces. The
   average temperatures of these spaces were 2 degrees C and 1 degrees C
   lower than those of the built-up areas and the full study region,
   respectively. Blue-green spaces also had a maximum temperature that was
   8 degrees C lower than those of the built-up areas and the study region.
   The three primary variables determining LST were blue space proportion
   and area and vegetation cover, whereas the three variables determining
   PCI were blue-green space width, vegetation cover, and patch density. At
   a width of 140 m, blue-green spaces caused a PCI peak, which further
   improved at 310 m. The proportion of blue space had a stepwise effect on
   PCI. A vegetation coverage of 56\% represented the lower threshold of
   LST and the higher threshold of PCI. These results reflect a nonlinear
   relationship between blue-green variables and urban cold islands. In
   conclusion, the study provides data that could inform the efficient use
   of blue-green spaces in urban construction and renewal.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Li, TQ (Corresponding Author), Henan Univ, Coll Geog \& Environm Sci, Kaifeng, Peoples R China.
   Li, TQ (Corresponding Author), Henan Univ, Natl Demonstrat Ctr Environm \& Planning, Kaifeng, Peoples R China.
   Quan, Shu; Li, Tianqi; Liu, Haodong; Liu, Miaohan, Henan Univ, Coll Geog \& Environm Sci, Kaifeng, Peoples R China.
   Li, Maojuan; Cui, Yaohui, Yellow River Conservancy Tech Inst, Dept Geomat Engn, Kaifeng, Peoples R China.
   Li, Tianqi, Henan Univ, Natl Demonstrat Ctr Environm \& Planning, Kaifeng, Peoples R China.},
DOI = {10.3389/fevo.2023.1185249},
