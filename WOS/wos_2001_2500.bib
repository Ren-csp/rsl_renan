@article{ WOS:001875884500001,
Author = {Sharifi, Mohammad Saleh and Alikhani, Arezoo and Moghaddasi, Mahsima},
Title = {Bridging governance and sustainability in the Global South: NGO-led
   urban transition pathways in Mashhad, Iran},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2027},
Volume = {16},
Number = {2},
Month = {APR},
Abstract = {Urban areas in the Global South face growing challenges of centralized
   governance, rapid urbanization and environmental degradation, which
   demand more inclusive and sustainable planning approaches. This article
   investigates how civil society organizations, particularly
   professionally oriented NGOs, can influence urban governance and
   contribute to sustainabilityoriented transitions. The study examines the
   case of CharTabaqeh, a non-governmental organization in Mashhad, Iran,
   that contested the construction of the Southern Beltway and played an
   important role in the policy process that ultimately contributed to the
   project's transformation into the Mountain Park. Drawing on document
   analysis and observation, the research adopts a qualitative case study
   approach. The findings reveal that CharTabaqeh acted as a transition
   intermediary by creating participatory spaces, mobilizing citizens, and
   connecting community concerns with formal decision-making processes. The
   organization also promoted a shift toward more sustainable and resilient
   urban development by advocating for the preservation of ecological
   assets and the development of public green space in place of a
   car-oriented infrastructure project. Moreover, the NGO's strategic use
   of digital platforms during the COVID-19 pandemic facilitated civic
   mobilization, strengthened coalitions and amplified advocacy efforts at
   local and national scales. These results demonstrate that NGOs can act
   as catalysts of sustainable urban transitions by bridging community
   interests with policy processes, reframing development trajectories and
   leveraging digital technologies within centralized governance contexts.},
