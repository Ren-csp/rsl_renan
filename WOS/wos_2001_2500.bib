@article{ WOS:001791988400001,
Author = {Fleming, Whitney and Tenbrink, Thora and van den Hoek, Jamon and
   Biedenweg, Kelly},
Title = {How long-term tree cover decline influences psychological restoration,
   place attachment, and governance perceptions},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {122},
Month = {AUG},
Abstract = {Tree cover is declining in many urban and peri-urban regions, despite
   its critical importance for both human wellbeing and planetary health,
   yet there is limited understanding of how long-term canopy loss
   influences residents' psychological wellbeing, attachment to place, and
   perceptions of environmental governance. Given the accelerating loss of
   urban tree canopy globally, understanding these relationships is
   essential for informing conservation, management, and public engagement
   strategies. This mixed methods study examined these relationships in the
   Puget Sound region of Washington State using two independent samples.
   First, a quantitative survey (n = 1532) of residents linked with change
   over 14 years of high-resolution tree canopy data around respondents'
   homes, and second, qualitative surveys with 50 participants in the same
   region. Geographically weighted regression models showed that greater
   canopy decline was significantly associated with lower levels of
   psychological restoration (p = .004) and weaker place attachment (p <
   .001), after controlling for sociodemographic variables and local
   context. No significant relationship emerged between canopy decline and
   beliefs about environmental governance (p = .433). Qualitative findings
   provided insight into these patterns. Participants described tree loss
   as diminishing the sensory, aesthetic, and ecological qualities that
   support everyday restoration, and disrupting landscape features that
   carry cultural meaning. These emotional responses did not consistently
   influence governance beliefs, which were shaped more by perceptions of
   procedural fairness, development pressure, and understanding of
   management priorities. The findings illuminate how long-term tree canopy
   decline may affect psychological and place-based dimensions of human
   experience, while operating independently from institutional trust. As
   development intensifies across the region, planning approaches that
   prioritize tree retention and long-term canopy management may be
   essential for sustaining community wellbeing, strengthening place
   attachment, and supporting broader environmental goals.},
