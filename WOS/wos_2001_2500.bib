@article{ WOS:001513619900001,
Author = {Lu, Qing and Ding, Zhangjian and Li, Muwei and Gu, Jianping},
Title = {Beyond the horizon: Unveiling the impact of 3D urban landscapes on
   residents' perceptions through machine learning},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {177},
Month = {AUG},
Abstract = {With burgeoning urban populations and mounting land constraints,
   vertical urbanization has become indispensable for sustainable city
   growth. Yet the perceptual implications of three-dimensional (3D) form
   remain underexplored. In this study, we combine ResNet50-based semantic
   segmentation of street-view imagery with an XGBoost regression framework
   interpreted via SHAP values to quantify how 3D landscape morphology
   shapes residents' perceptions of vitality, security, and aesthetics. Our
   model achieves R2 values above 0.85 for all perceptual dimensions,
   substantially outperforming analogous 2D-only approaches. We find that
   urban vibrancy is maximized when total 3D volume (All\_3DArea) falls
   between 1.0 and 3.0 x 10(6) m(3), patch density (PD\_All\_3D) ranges
   from 5.0 x 10(-5) to 2.0 x 10(-4), and vertical relief (RMSofHeight)
   remains under 10 m. Security perception peaks in human-scaled contexts
   (All\_3DArea < 5.0 x 10(5)), at very low or very high fragmentation
   (PD\_All\_3D < 5.0 x 10(-5) or > 2.5 x 10(-4)), and with moderate summit
   clustering (Dsummit ti 0.005-0.01) and gentle curvature (SummitCur <
   1.0). Aesthetic appeal corresponds most strongly to landmark elevations
   (TenptHeight ti 350-400 and near 500), subtle interface complexity
   (S\_dr < 0.05), intermediate fragmentation (PD\_All\_3D ti 1.0-1.2 x
   10(-4)), and summit density (Dsummit ti 0.005-0.008). By uncovering
   these nonlinear ``sweet spots,{''} our findings provide precise,
   human-centered guidelines for 3D urban design-informing form-based
   regulations, mixed-use zoning, and topographic modulation to foster
   cohesive, vibrant, and beautiful cityscapes.},
