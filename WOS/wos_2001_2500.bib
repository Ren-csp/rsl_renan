@article{ WOS:001845755200001,
Author = {Lourenco, Ianic Bigate and de Oliveira, Antonio Krishnamurti Beleno and
   Rezende, Osvaldo Moura and Miguez, Marcelo Gomes},
Title = {The potential interface: Urban open spaces system to support urban flood
   prevention and mitigation},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {Urbanization has significantly transformed natural hydrological cycles,
   leading to more frequent and severe urban floods, which in turn result
   in considerable social, environmental, and economic consequences. These
   effects are closely linked to land-use transformation, soil sealing, and
   inadequate spatial planning, particularly considering the limited
   integration between urban drainage systems and open spaces. In response,
   this study proposes an integrated methodological framework to support
   urban landscape planning by systematically identifying and evaluating
   open spaces with the potential to mitigate flood risk through
   multifunctional uses. The approach combines a quali-quantitative
   assessment of urban open spaces with hydrodynamic flood modeling,
   enabling a cross multi-layered spatial analysis of landscape attributes
   and drainage performance. By vertically integrating these layers, the
   method identifies interface zones where open spaces can operate as
   active components of a flood mitigation strategy. The identification of
   these interface zones supports urban planning and design processes, by
   incorporating the definition of a multifunctional open space system to
   enhance flood mitigation capacity and significantly reduce critical
   flood conditions. Strengthening the role of open and green spaces within
   the proposed system, this approach also improves environmental
   performance and contributes to urban quality of life. The proposed
   framework works as a decision-support tool for urban planning and
   policymaking, offering a transferable and scalable strategy to promote
   more resilient and sustainable urban flood management.},
