@article{ WOS:001794123600001,
Author = {Iniunam, Iniunam Aniefiok and Banda, Joan Fadzai and Tende, Talatu and
   Dami, Danjuma Filibus and Ottosson, Ulf and Chaskda, Adams Adamanyiwa},
Title = {Negative symbolism of wildlife shapes human-nature coexistence: The
   plight of owls in Nigeria},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {8},
Pages = {2734-2747},
Month = {AUG},
Abstract = {1. Human-wildlife coexistence in culturally diverse landscapes requires
   understanding how socio-cultural processes shape perceptions and
   behaviours towards conservation-priority species. This study examines
   perceptions, belief-based uses and conservation attitudes towards owls
   in communities surrounding six Protected Areas in Nigeria, addressing
   key geographical and theoretical gaps in human-nature research in the
   Global South. Drawing on concepts of biophilia and biophobia, extinction
   of experience and cultural ecosystem services, we analyse how
   socio-demographic factors influence negative perceptions and
   belief-driven use, and how these, in turn, affect willingness to coexist
   with and protect owls. 2. Using structural equation modelling and
   logistic regression on data from 1819 respondents, we find that negative
   perceptions, rooted in associations with witchcraft and misfortune, are
   widespread and vary across regions and demographic groups. 3. Negative
   attitudes are strongest in more remote sites and among women (beta =
   -0.15, p < 0.001), individuals with lower levels of formal education
   (beta = 0.079, p = 0.003) and specific livelihood groups. Belief-based
   use persists among traditional healers and hunters, reflecting the
   cultural embedding of owls within systems of meaning and practice.
   Importantly, perception is a strong predictor of conservation support
   (beta = 0.415), with more negative perceptions associated with reduced
   willingness to tolerate (beta = -2.30, p < 0.001) and protect owls (beta
   = -0.95, p < 0.001), while ecological knowledge mediates more positive
   attitudes towards tolerating (beta = 1.61, p < 0.001) and protection of
   owls (beta = 0.58, p = 0.04). 4. Our findings show that reduced direct
   engagement with nature may allow fear-based and symbolic narratives to
   persist, reinforcing negative perceptions and limiting coexistence. In
   doing so, the study advances theory by demonstrating that human-nature
   relationships are not universally biophilic but are relational and
   context-dependent, shaped by the interaction between cultural and
   symbolic meanings, lived experience and socio-economic conditions. 5.
   These results highlight that effective conservation must engage not only
   with ecological knowledge but also with the cultural and emotional
   dimensions that shape how people interpret and respond to wildlife in
   human-dominated tropical landscapes.},
