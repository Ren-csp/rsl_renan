@article{ WOS:001594755100001,
Author = {Khan, Irfan Haider and Munawer, Taiyaba},
Title = {Benefits and barriers of vertical greenery systems in Delhi: Evaluating
   design professionals' perceptions},
Journal = {DISCOVER ENVIRONMENT},
Year = {2025},
Volume = {3},
Number = {1},
Month = {MAY 22},
Abstract = {Vertical greenery systems (VGSs) have emerged as promising nature-based
   solutions to address climate change challenges in urban areas. However,
   their widespread adoption in Indian cities faces apprehensions among key
   stakeholders. This study investigated the perceptions and attitudes of
   design professionals towards VGSs in Delhi through an empirical survey.
   An online questionnaire was administered to 390 professionals, including
   architects, landscape architects, urban planners, and VGS vendors. Using
   exploratory factor analysis, this study identified the key determinants
   influencing professional attitudes toward VGS adoption. While
   professionals broadly recognize their contributions to public health and
   environmental quality, significant reservations persist regarding their
   economic viability and ecological sustainability. Despite acknowledging
   VGSs' capacity to mitigate urban heat islands and reduce building energy
   consumption, industry professionals consistently identified three
   primary barriers to widespread adoption: substantial costs, high
   maintenance, and insufficient regulatory frameworks. A qualitative
   assessment of the participants' responses revealed that client
   reluctance predominantly stems from these challenges, indicating the
   need for targeted interventions. The findings illuminate the complex
   socio-technical dynamics that influence VGS adoption, particularly the
   intersection of technological innovation, stakeholder perspectives, and
   policy frameworks. Recommendations encompass financial incentives,
   educational initiatives, and focused research to facilitate the
   integration of VGSs into sustainable urban development strategies.},
