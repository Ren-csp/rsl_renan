@article{ WOS:001719386300001,
Author = {Caro Vera, Claudia Cecilia and Negrin Marques, Taicia Helena and Arenas
   Yance, Daphne Lisbeth and Romo Herrera, Olga Alexandra},
Title = {Urban ecosystem services and disservices: descriptors analysis using
   photovoice},
Journal = {JOURNAL OF INTEGRATIVE ENVIRONMENTAL SCIENCES},
Year = {2026},
Volume = {23},
Number = {1},
Month = {DEC 31},
Abstract = {Urban ecosystem services (UES) are the benefits that natural or
   semi-natural spaces within cities provide to human well-being, while
   urban ecosystem disservices (UEDS) represent their negative impacts.
   Managing this balance is particularly challenging in Latin America,
   where over 80\% of the population lives in urban areas. However,
   research on UES/UEDS remains unevenly distributed across the region,
   with Peru receiving limited attention. Additionally, a gap persists
   between technical ecosystem terminology and the everyday language
   residents use to describe urban nature, limiting inclusive participation
   in planning processes. This study addresses both gaps by developing a
   repository of colloquial descriptors that links citizens' vernacular
   expressions with formal ecosystem service frameworks. Using an online
   photovoice approach, 140 university students in Lima, Peru, photographed
   and described campus open spaces they ``like{''} (UES) or ``dislike{''}
   (UEDS). After quality control, 98 ``like{''} and 62 ``dislike{''} images
   were analyzed through a three-phase process: data collection, inductive
   extraction of colloquial descriptors, and inferential coding using the
   Common International Classification of Ecosystem Services (CICES)
   framework. The resulting repository includes 33 descriptors associated
   with 18 UES categories and 13 UEDS. Chi-square tests showed no
   significant associations with gender, district of origin, or academic
   year, although academic major influenced UEDS identification (p < 0.05).
   The repository offers a practical translation tool for surveys and
   citizen consultations, provides empirical insight into locally relevant
   UES/UEDS, and demonstrates a replicable methodology for culturally
   responsive urban ecosystem planning.},
