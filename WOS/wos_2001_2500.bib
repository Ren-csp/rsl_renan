@article{ WOS:001781669600001,
Author = {Sheng, Fanke and Jiang, Ruochen},
Title = {New energy demonstration cities and urban ecological outcomes: greening
   gains without broader resilience improvement in Chinese cities},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2026},
Volume = {14},
Month = {MAY 15},
Abstract = {Background Urban ecological resilience is critical for sustainable
   development, yet the effects of energy transition policies on specific
   ecological dimensions remain poorly understood. This study evaluates
   whether China's National New Energy Demonstration City pilot policy,
   implemented in 2014, improves urban ecological outcomes, and if so,
   which dimensions of the ecological system are most responsive.Methods We
   employ a difference-in-differences (DID) framework using an unbalanced
   panel of 298 Chinese prefecture-level cities over 2000-2023. Ecological
   resilience is measured by an entropy-weighted composite index of 14
   environmental indicators. We validate the parallel trends assumption
   through event study analysis and conduct 10 robustness checks including
   PSM-DID, permutation tests, and concurrent policy exclusion.Results The
   policy is associated with an increase in the entropy-weighted composite
   index of 0.003 units, approximately 1.5\% of the sample mean. However,
   sub-dimension decomposition reveals that this aggregate effect is driven
   entirely by urban greening indicators (park green area and green
   coverage), with no significant effects on pollution control, emissions,
   or resource efficiency sub-dimensions. The result is sensitive to
   analytical choices: it disappears in the untrimmed sample, with equal
   weighting, and with province-specific trends. Suggestive channel
   analysis points to three potential pathways, collectively accounting for
   an estimated 33.7\% of the effect. Heterogeneity analysis reveals
   stronger effects in large cities and fiscally constrained
   cities.Conclusion The policy generates measurable improvements in urban
   greening but not in pollution control, emissions, or resource
   efficiency. This dimension-specific pattern suggests that city-level
   energy transition policies may more readily improve visible landscape
   amenities than harder-to-shift environmental performance indicators,
   with implications for how composite indices are used in policy
   evaluation.},
