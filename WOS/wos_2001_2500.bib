@article{ WOS:001858159800001,
Author = {Lai, Wenbo and You, Yongyi and Nie, Chuanlin and Li, Shiwen and Xu, Yang
   and Shu, Ting and Li, Jiang and Nong, Xingzhong and Osada, Yoshiaki},
Title = {The impact and dual-output efficiency of the built environment on
   spatial vitality and perceived safety in metro station areas: A case
   study of Guangzhou},
Journal = {JOURNAL OF URBAN MOBILITY},
Year = {2026},
Volume = {10},
Month = {DEC},
Abstract = {Under the sustainable development paradigm emphasizing quality and
   efficiency, metro station areas driven by transit-oriented development
   (TOD) principles have become critical places for fostering urban
   vitality and perceived safety. To address gaps in existing research
   regarding subjective perception, three-dimensional environmental
   measurement, and spatial efficiency evaluation, this study investigates
   Guangzhou's metro station areas by integrating multi-source data
   including population density heatmaps and street view images. Employing
   deep learning algorithms, a mixed-effects model, and data envelopment
   analysis (DEA), we systematically examine the spatial distribution,
   built environment factors, and dual-output efficiency of objective
   spatial vitality and subjective perceived safety. Results reveal: (1)
   Both vitality and perceived safety exhibit a core-periphery gradient,
   with the latter showing localized high values in peripheral areas; (2)
   Built environment factors exert differential impacts-building density,
   floor area ratio, street stall counts, and betweenness centrality show
   stronger positive associations with vitality, while functional
   diversity, green view index, facade transparency, and physical disorder
   exert more pronounced effects on perceived safety; (3) Pure technical
   efficiency and scale efficiency of the vitality-safety dual output
   demonstrate differentiation, thus identifying four station typologies:
   ``synergistic-enhanced,{''} ``management-deficit,{''}
   ``systemic-deviant,{''} and ``scale-constrained.{''} The findings
   underscore the necessity of balancing environmental optimization with
   scale adaptation through differentiated interventions to advance
   station-city integration.},
