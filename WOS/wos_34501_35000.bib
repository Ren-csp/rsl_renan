@article{ WOS:001709891100001,
Author = {Schmidt, Mario and Maina, Miriam},
Title = {Stressful life in high-rise tenements: gendered experiences of tiredness
   and pressure in Pipeline, Nairobi},
Journal = {CITY},
Year = {2025},
Month = {2025 MAR 19},
Abstract = {This article explores how the dense living conditions in Pipeline, a
   high-rise residential settlement in Nairobi, create gendered forms of
   stress and constraint on tenants' lives and everyday realities,
   affecting their social interactions and relations. The cramped
   residential district comprises dense rows of multistory private rental
   flats predominantly inhabited by young, migrant individuals and
   families. Many of these tenants are unemployed, or employed in low-wage
   industrial work, precarious gig work, or domestic work. Based upon
   fieldwork and qualitative interviews, the article zooms in on physical
   and social spaces occupied by urban residents, such as apartments,
   corridors, balconies, and chamas (economic self-help groups) to explore
   actors' gendered experience of stress and their strategies to reduce
   social, economic, and romantic pressure. Of special pertinence for this
   paper is the question of how the experience of stress intersects with
   gender relations. We argue that understanding the experience of
   `pressure' as a masculine and the experience of `tiredness' as a
   feminine reaction towards adverse living conditions opens new analytical
   perspectives on twenty-first century urban life.},
