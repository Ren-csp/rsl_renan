@article{ WOS:000412421700004,
Author = {Villarruel Fuentes, Manuel and Perez Santiago, Fernando and Chavez
   Morales, Romulo and Hernandez Arano, Ismael},
Title = {PERCEPTIONS OF SCIENCE AND TECHNOLOGY IN TECHNOLOGICAL UPPER LEVEL
   STUDENTS IN VERACRUZ, MEXICO},
Journal = {PERSPECTIVA EDUCACIONAL},
Year = {2017},
Volume = {56},
Number = {1},
Pages = {43-61},
Abstract = {Today's societies do not seem to be aware of the advantages and risks of
   science and technology. The problem increases when there are students
   who demonstrate this condition. For this reason, neither moral values
   nor beliefs that the students possessed in the higher technological
   level of Veracruz, Mexico, in relation to science and technology, were
   estimated. The study was quantitative, descriptive, with results
   analyzed under a qualitative perspective. A Likert-type test was applied
   to 835 students close to graduating. Students showed values and
   ambiguous beliefs around the variables evaluated. The utilitarian and
   functional sense that was awarded to science and technology stands out.
   There was a low level of reflection on its potential risks, as well as a
   separation of the social component from the environmental one.},
