   Jonathan R. and Weiss, Thomas M. and De Yoreo, James J. and Noy,
   Aleksandr and Chen, Chun-Long and Van Buuren, Anthony},
Title = {Early-Stage Aggregation and Crystalline Interactions of Peptoid
   Nanomembranes},
