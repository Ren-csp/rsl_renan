@article{ WOS:000379026600008,
Author = {McDougall, Alice and Milner, Richard N. C. and Driscoll, Don A. and
   Smith, Annabel L.},
Title = {Restoration rocks: integrating abiotic and biotic habitat restoration to
   conserve threatened species and reduce fire fuel load},
Journal = {BIODIVERSITY AND CONSERVATION},
Year = {2016},
Volume = {25},
Number = {8},
Pages = {1529-1542},
Month = {JUL},
Abstract = {With rapid urban expansion, biodiversity conservation and human asset
   protection often require different regimes for managing wildfire risk.
   We conducted a controlled, replicated experiment to optimise habitat
   restoration for the threatened Australian pink-tailed worm-lizard,
   Aprasia parapulchella while reducing fire fuel load in a rapidly
   developing urban area. We used dense addition of natural rock (30 \%
   cover) and native grass revegetation (Themeda triandra and Poa
   sieberiana) to restore critical habitat elements. Combinations of fire
   and herbicide (Glyphosate) were used to reduce fuel load and invasive
   exotic species. Rock restoration combined with herbicide application met
   the widest range of restoration goals: it reduced fire fuel load,
   increased ant occurrence (the primary prey of A. parapulchella) in the
   short-term and increased the growth and survival of native grasses.
   Lizards colonised the restored habitat within a year of treatment. Our
   study documents an innovative way by which conflicts between
   biodiversity conservation and human asset protection can be overcome.},
