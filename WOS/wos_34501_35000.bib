@article{ WOS:000244907800009,
Author = {Liberman, Uri and Puniyani, Amit and Feldman, Marcus W.},
Title = {On the evolution of epistasis II: A generalized Wright-Kimura framework},
Journal = {THEORETICAL POPULATION BIOLOGY},
Year = {2007},
Volume = {71},
Number = {2},
Pages = {230-238},
Month = {MAR},
Abstract = {The evolution of fitness interactions between genes at two major loci is
   studied where the alleles at a third locus modify the epistatic
   interaction between the two major loci. The epistasis is defined by a
   parameter e and a matrix structure that specifies the nature of the
   linteractions. When epsilon = 0 the two major loci have additive
   fitnesses, and when these are symmetric the interaction matrices studied
   here produce symmetric viabilities of the Wright {[}1952. The genetics
   of quantitative variability. In: Reeve, E.C.R., Waddington, C.H. (Eds.),
   Quantitative Inheritance. Her Majesty's Stationary Office,
   London]-Kimura {[}1956. A model of a genetic system which leads to
   closer linkage by natural selection. Evolution 10, 278-281] form. Two
   such interaction matrices are studied, for one of which epistasis as
   measured by Jel always increases, and for the other it increases when
   the linkage between the major loci is tight enough and there is initial
   linkage disequilibrium. Increase of epistasis does not necessarily
   coincide with increase in equilibrium mean fitness. (c) 2006 Elsevier
   Inc. All rights reserved.},
Publisher = {ACADEMIC PRESS INC ELSEVIER SCIENCE},
