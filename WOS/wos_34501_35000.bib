@article{ WOS:001740931400001,
Author = {Palenova, Elena and Botetzagias, Iosif and Kontos, Themistoklis and
   Veraverbeke, Sander and Miller, Katherine and Ebert, Karin},
Title = {Stakeholder perceptions of post-fire management in Greece},
Journal = {FIRE ECOLOGY},
Year = {2026},
Volume = {22},
Number = {1},
Month = {APR 7},
Abstract = {BackgroundThe views of key stakeholders involved in wildfire management
   can reveal existing challenges in post-fire management and help to
   develop effective action plans. The Mediterranean region is prone to
   large, uncontrollable fires due to changing climate conditions. As the
   need to address fire-related damage increases, Greece has a unique
   system of post-fire management with numerous experts and stakeholders
   expressing divergent views on the current situation and the need for
   systemic changes. We conducted semi-structured, in-depth interviews with
   22 participants involved in wildfire management at multiple levels
   spanning 10 affiliations, including government, academia, private
   business, non-governmental organizations, and activism. From these
   interviews, 376 statements were extracted, of which 44 were ultimately
   selected for a Q study. This method combines qualitative and
   quantitative techniques to examine subjectivity. The same interviewees
   were contacted a second time to complete the ranking process.ResultsThe
   study revealed six distinct discourses on existing policies and
   management strategies for post-fire restoration in Greece. We found that
   actors focus on and prioritize different aspects of post-fire
   management, indicating disagreement over a single common view. We
   labeled the factors as Statist, advocating government intervention in
   post-fire restoration; Abstainer, supporting non-interference;
   Beneficiary, emphasizing the need to support vulnerable groups;
   Pragmatist, promoting standardized practices to ensure restoration
   efficiency; Revolutionary, highlighting the necessity of
   self-organization and communities' unity; and Contextualist, proposing
   locally applicable solutions.ConclusionsWe conclude that there are many
   perspectives on how post-fire issues are currently managed,
   necessitating dialog to advance a more comprehensive, holistic post-fire
   management.
   AntecedentesLas percepciones de los grupos de inter \& eacute;s
   implicados en el manejo de fuegos de vegetaci \& oacute;n pueden revelar
   desaf \& iacute;os que existen en el manejo del post fuego y ayudar a
   desarrollar planes de acci \& oacute;n efectivos. La regi \& oacute;n
   del Mediterr \& aacute;neo es proclive a incendios grandes e
   incontrolables debido a las condiciones clim \& aacute;ticas cambiantes.
   A medida que se incrementa la necesidad de determinar los da \&
   ntilde;os causados por los incendios, Grecia tiene un \& uacute;nico
   sistema de manejo del post fuego con numerosos expertos y grupos de
   inter \& eacute;s que expresan miradas divergentes sobre la situaci \&
   oacute;n actual y la necesidad de cambios sist \& eacute;micos.
   Condujimos entrevistas semi-estructuradas y exhaustivas con 22
   participantes implicados en el manejo de fuegos de vegetaci \& oacute;n
   a diferentes niveles y que respond \& iacute;an a diferentes
   afiliaciones, incluyendo personal de gobierno, acad \& eacute;micos,
   empresarios privados, organizaciones no gubernamentales, y activistas.
   De estas entrevistas, fueron extra \& iacute;das 374 afirmaciones, de
   las cuales 44 fueron finalmente seleccionadas para un estudio usando el
   m \& eacute;todo Q. Este M \& eacute;todo combina t \& eacute;cnicas
   cualitativas con cuantitativas para examinar la subjetividad. Los mismos
   entrevistados fueron contactados una segunda vez para completar el
   proceso de ordenamiento.ResultadosEl estudio revel \& oacute; seis
   discursos diferentes sobre las pol \& iacute;ticas existentes y
   estrategias de manejo para la restauraci \& oacute;n post incendio en
   Grecia. Encontramos que los actores se enfocaron y priorizaron
   diferentes aspectos del manejo en el post fuego, indicando un desacuerdo
   sobre una visi \& oacute;n com \& uacute;n. Identificamos los grupos de
   actores como: Estatistas, a aquellos que bregaban por la intervenci \&
   oacute;n del gobierno en la restauraci \& oacute;n post fuego;
   Abstencionistas, a aquellos que apoyaban la no interferencia;
   Beneficiarios, aquellos que enfatizaban la necesidad de apoyar a grupos
   vulnerables; Pragm \& aacute;ticos, a aquellos que promov \& iacute;an
   pr \& aacute;cticas est \& aacute;ndar para asegurar la eficiencia en la
   restauraci \& oacute;n; Revolucionarios, los que subrayaban la la
   necesidad de auto organizaci \& oacute;n y unidad de las comunidades; y
   Contextualizados, los que propon \& iacute;an soluciones aplicables
   localmente.ConclusionesConcluimos que hay muchas perspectivas sobre c \&
   oacute;mo el post fuego es actualmente manejado, lo que necesita del di
   \& aacute;logo para avanzar en un manejo del post fuego que sea m \&
   aacute;s comprensivo y hol \& iacute;stico.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
