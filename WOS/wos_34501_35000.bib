@article{ WOS:000214881900014,
Author = {Ellison, Aaron M.},
Title = {Preserving the Picturesque: Perceptions of Landscape, Landscape Art, and
   Land Protection in the United States and China},
Journal = {LAND},
Year = {2014},
Volume = {3},
Number = {1},
Pages = {260-281},
Month = {MAR},
Abstract = {The predominant environmental consciousness in both the United States
   and China reflects an underlying sense of separation of people from
   nature. Likewise, traditional landscape paintings in the United States
   and China share a common underlying aesthetic-i.e., the
   ``picturesque{''}. Together, these similarities appear to have led to
   the preservation of similar types of landscapes in both countries.
   Because decisions regarding landscape preservation and subsequent
   management of preserved areas in both countries reflect aesthetic
   preferences more than they reflect economic values placed on ecosystem
   services, contemporary artists have an opportunity to help shape future
   societal decisions regarding what natural areas to conserve and protect.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
