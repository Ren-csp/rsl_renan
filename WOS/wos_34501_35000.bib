@article{ WOS:000592028600011,
Author = {Mishra, Vartika and Re, Diane B. and Le Verche, Virginia and Alvarez,
   Mariano J. and Vasciaveo, Alessandro and Jacquier, Arnaud and Doulias,
   Paschalis-Tomas and Greco, Todd M. and Nizzardo, Monica and
   Papadimitriou, Dimitra and Nagata, Tetsuya and Rinchetti, Paola and
   Perez-Torres, Eduardo J. and Politi, Kristin A. and Ikiz, Burcin and
   Clare, Kevin and Than, Manuel E. and Corti, Stefania and Ischiropoulos,
   Harry and Lotti, Francesco and Califano, Andrea and Przedborski, Serge},
Title = {Systematic elucidation of neuron-astrocyte interaction in models of
   amyotrophic lateral sclerosis using multi-modal integrated
   bioinformatics workflow},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {NOV 4},
Abstract = {Cell-to-cell communications are critical determinants of
   pathophysiological phenotypes, but methodologies for their systematic
   elucidation are lacking. Herein, we propose an approach for the
   Systematic Elucidation and Assessment of Regulatory Cell-to-cell
   Interaction Networks (SEARCHIN) to identify ligand-mediated interactions
   between distinct cellular compartments. To test this approach, we
   selected a model of amyotrophic lateral sclerosis (ALS), in which
   astrocytes expressing mutant superoxide dismutase-1 (mutSOD1) kill
   wild-type motor neurons (MNs) by an unknown mechanism. Our integrative
   analysis that combines proteomics and regulatory network analysis infers
   the interaction between astrocyte-released amyloid precursor protein
   (APP) and death receptor-6 (DR6) on MNs as the top predicted
   ligand-receptor pair. The inferred deleterious role of APP and DR6 is
   confirmed in vitro in models of ALS. Moreover, the DR6 knockdown in MNs
   of transgenic mutSOD1 mice attenuates the ALS-like phenotype. Our
   results support the usefulness of integrative, systems biology approach
   to gain insights into complex neurobiological disease processes as in
   ALS and posit that the proposed methodology is not restricted to this
   biological context and could be used in a variety of other
   non-cell-autonomous communication mechanisms. Neuron-astrocyte
   communication plays a key role in pathophysiology, however systematic
   approaches to unveil it are limited. Here, the authors propose SEARCHIN,
   a multi-modal integrated workflow, as a tool to identify
   cross-compartment ligand-receptor interactions, applied to ALS models.},
