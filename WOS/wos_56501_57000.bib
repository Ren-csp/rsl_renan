@article{ WOS:001598928900002,
Author = {Qazi, Ammad Waheed and Ul Haq, Muhammad Zaman and Tariq, Aqil and Shitu,
   Kasye},
Title = {Prioritizing threats to rare and endemic species: Expertise to insights},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {The protection of rare and endemic species is essential in the face of
   increasing dangers posed by climate change, urban development, invasive
   species, and various human activities. This study aims to assess and
   rank the major threats facing rare and endemic plant species in Pakistan
   using a comprehensive methodology. We combined field observations,
   literature analyses, and surveys of expert opinions to identify,
   prioritize, and evaluate the threats confronting these species. A
   Likert-scale questionnaire of 88 conservation experts was utilized to
   group and rank key threats. The findings reveal that climate change
   (85\%) is perceived as the most significant threat, followed by
   urbanization (78\%), invasive species (72\%), and land use changes
   (70\%). Additionally, pollution (65\%) and unsustainable anthropogenic
   activities (60\%) further exacerbate biodiversity loss. Correlation
   analysis indicates strong associations between urban expansion,
   agricultural intensity, and environmental degradation (r > 0.75, p <
   0.01). ANOVA results show no significant differences in expert opinions
   across different specializations (p > 0.05). The study sheds light on
   the inadequacy of existing literature as it often leaves out
   underrepresented areas and species, leading to biases in priorities for
   conservation. This paper presents an overall framework for prioritizing
   conservation efforts, especially in areas where empirical evidence is
   barely available. It fills significant knowledge gaps through the input
   of specialists and helps policymakers reduce biodiversity loss and
   improve sustainable environmental practice. The research finally
   concludes that urgent and targeted approaches are necessary to combat
   the various threats facing endemic plant species. For biodiversity
   conservation, interactions of human activities, climate pressures, and
   invasive species need to be addressed to enhance ecosystem resilience
   and ecological balance.},
