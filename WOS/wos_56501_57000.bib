@article{ WOS:000873524100001,
Author = {Larsen, Rasmus Klocker and Raitio, Kaisa},
Title = {Protected areas and indigenous rights in Sapmi: an agonistic reading of
   conflict and collaboration in land use planning},
Journal = {JOURNAL OF ENVIRONMENTAL POLICY \& PLANNING},
Year = {2023},
Volume = {25},
Number = {3},
Pages = {342-354},
Month = {MAY 4},
Abstract = {The recognition of Indigenous Peoples' rights has sailed up as one of
   the most critical issues in land use planning, globally. In this paper,
   we use a recent planning process for a national park on traditional Sami
   territory in northern Sweden to demonstrate how state officials engaged
   in everyday conservation planning are pivotal in navigating colonial
   legislation and promoting policy change on Indigenous rights. The
   analysis contributes, among other, to scholarly debates about the role
   of conflict in land use planning and the practices of frontline
   bureaucrats in natural resource governance. Our contribution
   demonstrates the value of an agonistic lens that attends to the
   constructive role of conflict in democratic change in pluralistic
   societies. This concerns both how state officials approach disagreement
   as well as the way contestation can create novel spaces to promote
   structural changes towards sustainability and justice. By not assuming
   collaboration but respectfully seeking it, the state officials succeeded
   in re-designing a collapsed process to help actors explore larger
   structural issues around Indigenous rights and government policy. In our
   agnostic reading, then, contestation should be perceived not as
   oppositional to the establishment of collaboration but as a necessary,
   and productive, part of inclusive land use planning.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Larsen, RK (Corresponding Author), Stockholm Environm Inst, Postbox 24218, S-10451 Stockholm, Sweden.
   Larsen, Rasmus Klocker, Stockholm Environm Inst, Postbox 24218, S-10451 Stockholm, Sweden.
   Raitio, Kaisa, Swedish Univ Agr Sci, Dept Urban \& Rural Dev, Unit Environm Commun, Uppsala, Sweden.},
DOI = {10.1080/1523908X.2022.2137483},
