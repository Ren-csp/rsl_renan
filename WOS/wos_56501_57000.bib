@article{ WOS:000341052900015,
Author = {Kim, Jae Hyeong and Shim, Jaegal and Ji, Min-Ju and Jung, Yuna and Bong,
   Seoung Min and Jang, Young-Joo and Yoon, Eun-Kyung and Lee, Sang-Jin and
   Kim, Kwang Gi and Kim, Yon Hui and Lee, Changwoo and Lee, Byung Il and
