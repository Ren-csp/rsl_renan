@article{ WOS:001851639200002,
Author = {Cupa, Petr and Vahalik, Petr},
Title = {Potential of use of remote sensing data as additional management tool in
   Biosphere Reserve networks-a case study of Czech Biosphere Reserves},
Journal = {ECO MONT-JOURNAL ON PROTECTED MOUNTAIN AREAS RESEARCH},
Year = {2026},
Volume = {18},
Number = {2},
Pages = {4-13},
Month = {JUL},
Abstract = {The main goal of UNESCO's Man and the Biosphere Programme (MAB) is to
   improve the relationship between people and the environment using
   biosphere reserves (BR), which can be perceived as comprehensive and
   collaborative tools for the sustainable management of landscapes and
   natural resources. The BRs must comprise natural landscapes and examples
   of the gradation of human environmental impact, allowing for the study
   and proposal of new approaches to sustainable development. To comply
   with this agenda, knowledge of the sites' physical characteristics and
   ecological status is a prerequisite. The availability of public remote
   sensing data and other readily available sources opens a new approach to
   periodic BR assessment, even in sites with limited scientific
   infrastructure. To test and simulate this approach, we spatially joined
   the BR border polygons with various open-access data sources to analyse
   the main physical characteristics of six Czech BRs. In the study, we
   focused on analysing the environmental characteristics of the sites with
   particular emphasis on the Ecological Stability Coefficient (ESC) as an
   indicator of conditions needed to improve the ecological stability of
   the landscapes. The ESC was calculated based on the formula used in the
   Czech Republic, utilizing the CORINE Land Cover (CLC) dataset. The
   results showed that five sites have natural and close-to-nature
   landscapes with a significant predominance of ecologically stable
   structures and low intensity of human use, and one site has a generally
   balanced landscape with preserved natural structures. The results
   suggest that most Czech BRs follow the positive trend in the ESC state,
   offering feedback to BR coordinators. In addition, the study confirmed
   sufficient feasibility of open access data (CLC and similar) for
   temporal assessment of BRs and their ecological stability, which is
   information required for the periodic review process and as an indicator
   for the implementation of BR functions. If adjusted to local conditions,
   the ESC based on the CLC could be considered an additional management
   tool in mountain biosphere reserves and the rest of the World Network of
   Biosphere Reserves.},
