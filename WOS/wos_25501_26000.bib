@article{ WOS:000428119000018,
Author = {Gurdalli, Huriye},
Title = {Spatial co-transformation through socio-cultural resilience strategies
   in post-conflict divided Nicosia},
Journal = {INTERNATIONAL JOURNAL OF ADVANCED AND APPLIED SCIENCES},
