@article{ WOS:000613564300004,
Author = {Kuroda, Masashi and Uwasu, Michinori and Xuan-Thanh Bui and Phuoc-Dan
   Nguyen and Hara, Keishiro},
Title = {Shifting the perception of water environment problems by introducing
   ``imaginary future generations{''}-Evidence from participatory workshop
   in Ho Chi Minh City, Vietnam},
Journal = {FUTURES},
Year = {2021},
Volume = {126},
Month = {FEB},
Abstract = {This study evaluated the influence of introducing the perspective of
   future generations on people's perception of various water issues by
   conducting a workshop in Ho Chi Minh City (HCMC), Vietnam. During the
   workshop, 19 questions related to water challenges in HCMC were given
   and participants prioritized them from the standpoints of the current
   and an imaginary future generations, respectively. Respondents and
   questions were each assigned to six groups by cluster analysis of the
   answers. From the standpoint of the imaginary future generation, three
   groups of respondents placed higher priority on many issues including
   the global-scale environmental issue, demonstrating a clear shift of
   perception depending on the perspective. Their future images of HCMC
   were deplorable, with more severe climate change impacts, leading to
   pessimistic answers to the questions. In contrast, two respondent groups
   that imagined an optimistic HCMC future, where sufficient economic and
   technological development will solve the issues, placed lower priority
   on most of the issues. These results suggest that the shifts of people's
   perception by the introduction of a future generation's perspective are
   likely to be affected by the future that they imagine.},
