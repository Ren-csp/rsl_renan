@article{ WOS:001562629300001,
Author = {Vikene, Odd Lennart and Fretland, Frode and Lundvall, Suzanne and
   Leirhaug, Petter Erik},
Title = {Understandings of the concept of friluftsliv among Norwegian and
   international students in a changing world},
Journal = {JOURNAL OF ADVENTURE EDUCATION AND OUTDOOR LEARNING},
Year = {2025},
Month = {2025 SEP 5},
Abstract = {This study explored how Norwegian and international outdoor education
   students understand friluftsliv. Twenty-five undergraduate students
   participated in focus group interviews conducted at two time points:
   2015 (n=15) and 2024 (n=10). Thematic analysis was applied, using a
   historical perspective as the theoretical framework. The Norwegian
   students associate friluftsliv in a broad context, arguing that some
   activities are more about friluftsliv than others. The international
   students lean towards the more romantic and eco-philosophical approach
   to the term, highlighting simplistic lifestyle, contact with nature and
   the right mindset. Both student groups agreed that the current
   development of friluftsliv is influenced by societal trends and
   increased sportification. A key difference between the cohortswas a
   growing concern in 2024 for local and global environmental issues. A
   concrete implication from the study is that higher education and
   pedagogical work in friluftsliv should emphasise the human relationship
   with nature as being at the core of Friluftsliv.},
