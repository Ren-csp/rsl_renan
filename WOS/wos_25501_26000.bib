@article{ WOS:000361383100017,
Author = {Chapman, Colin A. and van Bavel, Bianca and Boodman, Carl and Ghai, Ria
   R. and Gogarten, Jan F. and Hartter, Joel and Mechak, Lauren E. and
   Omeja, Patrick A. and Poonawala, Sofia and Tuli, Dan and Goldberg, Tony
   L.},
Title = {Providing health care to improve community perceptions of protected
   areas},
Journal = {ORYX},
Year = {2015},
Volume = {49},
Number = {4},
Pages = {636-642},
Month = {OCT},
Abstract = {Impoverished communities often turn to illegal extraction of resources
   from protected areas to alleviate economic pressures or to make monetary
   gains. Such practices can cause ecological damage and threaten animal
   populations. These communities also often face a high disease burden and
   typically do not have access to affordable health care. Here we argue
   that these two seemingly separate challenges may have a common solution.
   In particular, providing health care to communities adjacent to
   protected areas may be an efficient and effective way to reduce the
   disease burden while also improving local perceptions about protected
   areas, potentially reducing illegal extraction. We present a case study
   of a health centre on the edge of Kibale National Park, Uganda. The
   centre has provided care to c. 7,200 people since 2008 and its outreach
   programme extends to c. 4,500 schoolchildren each year. Contrasting the
   provision of health care to other means of improving community
   perceptions of protected areas suggests that health clinics have
   potential as a conservation tool in some situations and should be
   considered in future efforts to manage protected areas.},
