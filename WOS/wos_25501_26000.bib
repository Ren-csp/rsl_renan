@article{ WOS:001769382700006,
Author = {Greder, Kimberly and Zhang, Dong and Peng, Cheng and Oswald, Ramona
   Faith},
Title = {Relationship Between Coparent Communication and Teamwork, Food
   Insecurity, and Depressive Symptoms Among Rural Low-Income Mothers},
Journal = {JOURNAL OF RURAL MENTAL HEALTH},
Year = {2025},
Volume = {49},
Number = {1},
Pages = {52-64},
Month = {JAN},
Abstract = {Rural families with young children disproportionately experience
   poverty, which can threaten coparent cooperation and parent mental
   health. Little is known about the influence of coparent cooperation on
   parent mental health. We examined relationships among food insecurity,
   coparent communication and teamwork, and mental health among rural
   low-income mothers. Using survey data from 444 rural low-income mothers,
   we tested the hypotheses that food insecurity is negatively associated
   with coparent communication and teamwork and mothers' mental health and
   that coparent communication and teamwork would partially mediate the
   relationship between food insecurity and mothers' mental health.
   Structural equation modeling revealed that food insecurity was
   negatively associated with mothers' mental health, and coparent
   communication and teamwork partially mediated this relationship. Greater
   communication and teamwork among mothers and their coparents were
   associated with a weaker relationship between food insecurity and
   mothers' mental health. Thus, coparent communication and teamwork were
   indirectly associated with mothers' mental health. Strengthening
   coparent communication and teamwork among rural low-income mothers and
   their spouses/partners may lessen potential negative influences of food
   insecurity on mothers' mental health. The cross-sectional nature of this
   study greatly limits the findings. Longitudinal research is needed to
   determine the directional associations between the variables.},
