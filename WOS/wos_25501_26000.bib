@article{ WOS:000924057200001,
Author = {Sun, Qiong and Yu, Na and Liu, Zheng and Liao, Bin},
Title = {The impact of air quality on China's inbound tourism based on the
   heterogeneity of tourists' risk perception},
Journal = {ENVIRONMENTAL PROGRESS \& SUSTAINABLE ENERGY},
Year = {2023},
Volume = {42},
Number = {2},
Month = {MAR},
Abstract = {This study employs a panel econometric model to assess and examine the
   relationship between inbound tourism to China and air quality, using
   data on air quality and inbound tourism at the provincial level in China
   from 2013 to 2017. It also considers how travelers perceive risk.
   According to the findings, there has been an increase in foreign
   tourists visiting China since 2013. However, the air quality index's
   representation of domestic air quality is not encouraging. Our studies
   using the fixed effect model demonstrate that domestic air quality has a
   considerable beneficial impact on the number of inbound tourists, which
   is still strong when utilizing the mixed effect and random effect
   models; in comparison to northern China, the impact of air quality in
   southern China is more clear. Our studies demonstrate that the ongoing
   decline in China's inbound tourism scale in recent years is strongly
   correlated with the quality of the country's air, which is influenced by
   each visitor's personal preferences. In order to improve China's
   reputation in the global tourism market, the report concludes by
   outlining solutions to address this impact. These methods include
   maintaining the promotion of environmental governance while also tightly
   integrating tourism marketing.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Liao, B (Corresponding Author), 101 fourth North Rd, Beijing 100101, Peoples R China.
   Sun, Qiong; Yu, Na; Liu, Zheng, Beijing Union Univ, Management Coll, Beijing, Peoples R China.
   Liao, Bin, Beijing Union Univ, Beijing, Peoples R China.
   Liao, Bin, 101 fourth North Rd, Beijing 100101, Peoples R China.},
DOI = {10.1002/ep.14080},
EarlyAccessDate = {FEB 2023},
