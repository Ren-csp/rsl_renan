@article{ WOS:001451717000001,
Author = {Rossiter, Melissa D. and Lamptey, De-Lawrence and Janus, Magdalena and
   Turner, Joan and Mcisaac, Jessie-Lee D.},
Title = {Parents' Perceptions of Children's Emotions, Parenting Experiences and
   Relationships Among Food Secure and Food Insecure Families in Atlantic
   Canada During the COVID-19 Pandemic},
Journal = {JOURNAL OF HUNGER \& ENVIRONMENTAL NUTRITION},
Year = {2025},
Volume = {20},
Number = {5},
Pages = {785-800},
Month = {SEP 3},
Abstract = {This study explored the relationship between food security status and
   parents' perceptions of children's emotions, parents' experiences, and
   family relationships in Atlantic Canada during COVID-19. Parents (n =
   676) of children aged 0-8 years living in the Atlantic provinces of
   Canada completed an online cross-sectional survey. Parents' experiences
   and family relationships were negatively impacted by COVID-19 for
   families, with food insecure families affected more than food secure
   families. More food insecure families reported worry, loneliness, and
   decreased happiness in their children than food secure families. These
   results can inform programs and policies to address food insecurity and
   downstream health impacts during pandemics.},
