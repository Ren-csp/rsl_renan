@article{ WOS:001598947700024,
Author = {Hall, Denisi Holanda and Candido, Luiz Antonio and Portela, Bruno
   Takeshi Tanaka and Fisch, Gilberto and Andreoli, Rita Valeria and Souza,
   Rodrigo Augusto Ferreira and Stapleton, Adam and Guedes, Alacimar Viana
   and de Mendonca, Anne Cristiny Santos and de Souza Farias, Carla and
