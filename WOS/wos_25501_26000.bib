@article{ WOS:001860965900001,
Author = {Ekoh, Susan S.},
Title = {Building back or breaking apart? How perceptions of justice in durable
   solutions shape social cohesion in cyclone-related internal displacement
   in Mozambique},
Journal = {CLIMATE AND DEVELOPMENT},
Year = {2026},
Month = {2026 AUG 25},
Abstract = {Cyclones are driving internal displacement, yet there is limited
   evidence on how affected populations perceive the justice dimensions of
   interventions designed to achieve durable solutions, and how these
   perceptions shape social cohesion. This paper examines perceptions of
   distributive, procedural, participatory, and restorative justice in
   durable solution interventions in cyclone-related displacement settings
   in Sofala province, Mozambique. Specifically, it asks: (1) How do
   populations affected by cyclone-related displacement in Sofala province
   perceive the distributive, procedural, participatory and restorative
   justice dimensions of durable solution interventions? (2) What
   implications do these perceptions have for horizontal and vertical
   social cohesion? The study combines quantitative data from the
   International Organization for Migration (IOM)'s 2023 Displacement
   Tracking Matrix (DTM) with qualitative evidence from interviews and
   focus group discussions. Findings suggest that perceptions of justice
   shape social cohesion, particularly through the distribution of support,
   participation in decision-making, responsiveness to local needs and
   recognition of displacement-related harms. While recovery interventions
   by government, humanitarian and development actors contribute to
   rebuilding lives and strengthening resilience, perceived shortcomings
   can erode trust, weaken cooperation and strain relationships among
   affected populations and between communities and institutions, with
   implications for both horizontal and vertical social cohesion.},
