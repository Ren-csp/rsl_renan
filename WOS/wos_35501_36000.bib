@article{ WOS:001844182300001,
Author = {Kumar, Ashish and Lim, Jeng Shiun and Rathee, Vijay and Mittal, Preeti
   and Kakran, Shubham},
Title = {Consumer perceptions and behavior in driving electric vehicle adoption
   for climate change mitigation in India},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2026},
Volume = {7},
Number = {1},
Month = {JUN 1},
Abstract = {Electric vehicles (EVs) have emerged as a promising solution to reduce
   air pollution and greenhouse gas emissions by limiting reliance on
   fossil fuels. EV (Electric Vehicle) adoption is an important area of
   study in India and offers insight into the factors that influence an
   individual's Intention to purchase an EV. This study uses the PESTEL
   model as the theoretical framework to analyse the factors that influence
   an individual's EV purchase intention, drawing on social comparison
   theory and examining zone-based policies. To measure these factors, a
   stratified random sampling method and an online and offline survey were
   used to collect data from 513 participants. Findings reveal that
   political, technological, environmental, and legal factors have a strong
   influence on the individual's Intention to adopt an EV, while economic
   and social factors have minimal effect. The effects of information and
   personal values strengthen the relationships between the individual
   variables and purchasing intention. The regional analysis indicates that
   northern India has the highest level of consumer satisfaction and
   produces the highest number of EV sales within the Uttar Pradesh region,
   while Karnataka and Tamil Nadu show strong future potential.},
