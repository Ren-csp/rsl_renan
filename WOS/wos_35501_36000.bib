@article{ WOS:001495239400001,
Author = {Caridade, Cristina M. R. and Martins, Jose Alexandre and Pereira,
   Veronica},
Title = {How happy are our students? A case study of three higher education
   Institutions},
Journal = {INTERNATIONAL JOURNAL OF MATHEMATICAL EDUCATION IN SCIENCE AND
   TECHNOLOGY},
Year = {2025},
Volume = {56},
Number = {8, SI},
Pages = {1567-1580},
Month = {AUG 3},
Abstract = {The link between happiness and mathematics learning is complicated but
   fundamental. Good emotions can improve the quality of any learning
   experience and this is especially true for mathematics, as it is often
   seen as complicated and scary. Happiness and mathematics learning are
   linked by the ability of positive emotions to create a healthy learning
   environment, reduce stress, increase motivation, and develop skills.
   Happiness around mathematics not only helps students improve
   academically, but also organises a lasting memory of the syllabus. In
   this study, a questionnaire was developed to measure students'
   perception of happiness in mathematics classes. Its purpose will be to
   find aspects that can be improved, so that students have the possibility
   of becoming happier people while learning mathematics. The questionnaire
   will be a useful tool to collect data that would allow understanding the
   student's emotional situation in mathematics class, observing the points
   of greatest tension and seeing opportunities to make the learning
   process more positive and enjoyable. Based on the responses that have
   been collected and analysed, it is possible for teachers and schools in
   general to choose and change their teaching methods to create happier
   learning experiences for students.},
