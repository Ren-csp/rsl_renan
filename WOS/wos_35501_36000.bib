@article{ WOS:000306565400001,
Author = {Kazemi, Sayed Yahya and Abedirad, Seyed Mohammad},
Title = {Effect of Human and Bovine Serum Albumin on kinetic Chemiluminescence of
   Mn (III)-Tetrakis (4-Sulfonatophenyl) Porphyrin-Luminol-Hydrogen
   Peroxide System},
Journal = {SCIENTIFIC WORLD JOURNAL},
Year = {2012},
Abstract = {The present work deals with an attempt to study the effect of human and
   bovine serum albumin on kinetic parameters of chemiluminescence of
   luminol-hydrogen peroxide system catalyzed by manganese
   tetrasulfonatophenyl porphyrin (MnTSPP). The investigated parameters
   involved pseudo-first-order rise and fall rate constant for the
   chemiluminescence burst, maximum level intensity, time to reach maximum
   intensity, total light yield, and values of the intensity at maximum CL
   which were evaluated by nonlinear least square program KINFIT. Because
   of interaction of metalloporphyrin with proteins, the CL parameters are
   drastically affected. The systems resulted in Stern-Volmer plots with
   k(Q) values of 3.17 x 10(5) and 3.7 x 10(5) M-1 in the quencher
   concentration range of 1.5 x 10(-6) to 1.5 x 10(-5) M for human serum
   albumin (HSA) and bovine serum albumin (BSA), respectively.},
