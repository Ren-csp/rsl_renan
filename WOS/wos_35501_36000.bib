@article{ WOS:001081533500001,
Author = {Culver, David C. and Feller, Daniel J. and Burch, Elizabeth},
Title = {Evidence for metapopulation structure in seep-dwelling amphipods},
Journal = {SUBTERRANEAN BIOLOGY},
Year = {2023},
Volume = {45},
Pages = {157-164},
Month = {MAY 4},
Abstract = {Twelve seepage springs in a 3 km2 area of the Goldmine Tract in the C\&O
   Canal National Historical Park in Montgomery County, Maryland, USA were
   sampled in 1994-1995 and again in 2023 for three amphipod species:
   Stygobromus tenuis potomacus, Stygobromus pizzinii, and Crangonyx
   shoemakeri. During that time interval, there were 11 colonizations and 1
   exinction. Three populations persisted. These results are consistent
   with the proposed metapopulation hypothesis of population structure.},
