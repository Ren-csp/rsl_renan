@article{ WOS:001874805900001,
Author = {Bares, Alanna and Ebisu, Keita and Syed, Amal and Sandhu, Nimrat and
   Cisneros, Ricardo and Padilla, Ana and Flores, Edward and Brown, Paul},
Title = {An evaluation of farmworkers' protection from pesticides, heatwaves, and
   fine particulate matter (PM2.5) in California},
Journal = {ENVIRONMENTAL RESEARCH: HEALTH},
Year = {2026},
Volume = {4},
Number = {3},
Month = {SEP 1},
Abstract = {California employs hundreds of thousands of farmworkers who are
   disproportionately exposed to pesticides, air pollution, and heat.
   Workplace protections for farmworkers can vary across the state by
   differences in how employers implement workplace standards and by level
   of farmworker awareness. This study aims to understand farmworkers' use
   and availability of personal protective equipment (PPE) and heat safety
   precautions, and their perception of air quality in relation to
   environmental exposures. Data from 1454 survey participants from the UC
   Merced Farmworker Health Study were analyzed to understand farmworkers'
   use and access to PPE and safety precautions and their perceptions of
   air pollution exposure. We considered three environmental exposures:
   pesticides, heatwaves, and fine particulate matter (PM2.5), and assigned
   exposure levels based on farmworkers' residential ZIP code. Logistic
   regression was conducted to investigate whether use or lack of PPE, heat
   safety precautions, and air quality perception differed by various
   environmental exposures. The analysis was adjusted for various
   covariates. Our study found that farmworkers were more likely to lack
   most of the essential PPE in high pesticide exposure areas. Farmworkers
   in high heatwave areas were less likely to have heat precautions
   provided by their employers. Farmworkers in high PM2.5 areas were able
   to recognize poor air quality when they were exposed to higher PM2.5
   levels but were also more likely to lack availability to masks and
   respirators. Additionally, farmworkers in heatwave areas were less
   likely to use certain PPE, which may help them avoid heat stress but
   could increase their exposure to concurrent pesticide or PM2.5 exposure.
   It is necessary to continuously ensure that farmworkers can access
   different types of PPE and safety precautions to protect against
   occupational exposure to air pollution, pesticides, and heat. Our study
   underscores the importance of maintaining and strengthening workplace
   monitoring to ensure a safe work environment for farmworkers.},
