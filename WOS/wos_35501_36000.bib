@article{ WOS:001644835800002,
Author = {Li, Maolin and Zhang, Yongxun and He, Lulu and Miao, Changhong and Chen,
   Jiatao},
Title = {Implications from centennial changes in Xin'an traditional cherry
   cultivation system and local traditional ecological knowledge},
Journal = {HUMANITIES \& SOCIAL SCIENCES COMMUNICATIONS},
Year = {2025},
Volume = {12},
Number = {1},
Month = {NOV 22},
Abstract = {Widespread imbalances in human-nature relations arouse humanity learning
   from the agricultural heritage systems (AHSs) and traditional ecological
   knowledge (TEK) of indigenous and local communities (ILCs). As global
   agriculture and the environments have rapidly changed over the last
   hundred years, how have the AHSs and TEK proceeded during the period?
   What are the implications? Focusing on Xin'an Traditional Cherry
   Cultivation System, an over 1000-year-old typical AHS, this study drew
   on dynamic perspectives and examined the logic of centennial changes in
   the AHS and local TEK during 1920-2023. Findings show that the AHS and
   TEK were both well-preserved during 1920-1956, somewhat declined during
   1956-1992, were disregarded during 1992-2010, regained attention during
   2010-2020, and had an incipient revival during 2020-2023. Centennial
   changes in local human-nature relationship underwent an
   integration-loosening-alienation-reintegration process with economic
   system reforms and agro-technological progresses. The results reveal
   that modernisation alienated people from nature, and the connections
   between humans and nature gradually disintegrated, which may be the
   critical cause posing today's global ecological and climate crises. It's
   necessary to restore human-nature integration from current pervasive
   alienation for facilitating the United Nations Sustainable Development
   Goal 15 (Life on Land) more viable worldwide. The route lies in
   revitalising TEK extensively. Based on fully considering the integrity
   and inviolable ``sacredness{''} of TEK, AHSs and ecosystems, it's
   proposed to reintegrate people with rural ecosystems and culture through
   measures like conservation subsidies for ILCs, local self-determination
   empowerment, vernacular culture education and nature education, and
   practice-oriented and intercultural research, thus restoring the unity
   of mind and nature. This study aims to provoke critical reflections on
   pathways for humanity to co-exist harmoniously with nature, thereby
   contributing to a collective response to global environmental challenges
   and crises.},
Publisher = {SPRINGERNATURE},
Address = {CAMPUS, 4 CRINAN ST, LONDON, N1 9XW, ENGLAND},
Type = {Article},
Language = {English},
