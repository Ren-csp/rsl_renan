@article{ WOS:000946052200001,
Author = {Jonsson, Gunvor and Lindmae, Maria and Menet, Joanna and Van Eck, Emil},
Title = {`ALL EYES ON ME': The (In)Formal Barriers to Market Trade in Europe},
Journal = {INTERNATIONAL JOURNAL OF URBAN AND REGIONAL RESEARCH},
Year = {2023},
Volume = {47},
Number = {2},
Pages = {221-236},
Month = {MAR},
Abstract = {Studies of marketplaces in the global North have often conceptualized
   markets as important public spaces of social encounter and conviviality
   where visitors, regardless of race, age, class or gender, feel they have
   an equal right to be. Yet comparatively little has been written about
   how inclusive European marketplaces are for the traders who (want to)
   work there. In this article we argue that the common conception of
   marketplaces as accessible to everyone, and as vehicles of socioeconomic
   mobility, is oversimplistic and romanticized. We draw on empirical data
   from marketplaces in four European countries to focus on the more or
   less informal ways in which markets are regulated by managers and
   traders themselves, and on the exclusionary and inclusionary effects of
   this process that may ultimately determine traders' access to and
   success in these markets. This article not only challenges dominant
   conceptions of marketplaces as accessible and inclusive, but also
   addresses prevalent stereotypes about economic practices in the global
   North and assumptions about the ways in which these differ from
   practices in the global South.},
