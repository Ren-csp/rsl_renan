@article{ WOS:001145038300001,
Author = {Gao, Yun and Farrokhirad, Ensiyeh and Pitts, Adrian},
Title = {The Impact of Orientation on Living Wall Façade Temperature: Manchester
   Case Study},
Journal = {SUSTAINABILITY},
Year = {2023},
Volume = {15},
Number = {14},
Month = {JUL},
Abstract = {Living walls are a nature-based strategy to enhance climate resilience
   in urban areas. There is a need to study the possible influence of
   living walls on the thermal performance of building fa \& ccedil;ades,
   given the rising temperatures in 2022 across the UK. This study aims to
   analyze the impacts of living walls on fa \& ccedil;ade temperature
   based on orientation variation through simulation Envi-met 5.0.3.
   software. The living wall studied is attached to a multistory building
   located in Manchester city center consisting of seven evergreen plants.
   An environmental simulation was carried out linked to the 2022 climate,
   including extremely hot and cold days. Four scenarios of fa \&
   ccedil;ades with and without greening on the northwest and southeast
   orientations in summer and winter were analyzed. The results highlighted
   the living wall's ability to reduce the surface temperatures on both the
   northwest and southeast fa \& ccedil;ades on a hot summer day. There is
   no significant evidence of improvement for the northwest fa \&
   ccedil;ade in the winter climate, but a modestly increased temperature
   is shown in the southeast compared to the bare wall. These findings
   indicate that living walls provide measurable advantages in the building
   envelope, leading to energy saving.},
