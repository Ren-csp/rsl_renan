@article{ WOS:001729577900001,
Author = {Pham, Thai-Ngoc},
Title = {Incentivizing circular economy practices among urban Residents: An
   ecofeminist approach},
Journal = {WASTE MANAGEMENT BULLETIN},
Year = {2026},
Volume = {4},
Number = {2},
Month = {JUN},
Abstract = {The circular economy represents an alternative paradigm for economic
   development that seeks to minimize the depletion of natural resources
   and reduce energy consumption. However, the long term viability of
   circular economy models is critically contingent upon active public
   engagement. This study investigates the influence of incentive-based
   policies on residents' perceptions and behaviors through the lens of
   ecofeminist perspective. Grounded in social exchange theory, the
   research develops a perception-based framework linking incentive
   policies with four key psychological mechanisms: environmental
   responsibility, perceived value, perceived policy effectiveness, and
   collective efficacy. Data were collected through a survey of 417 urban
   Vietnamese women housewives. The relationships were analyzed using
   structural equation modeling (SEM). The results indicate that
   incentive-based policies significantly enhance perceived value,
   environmental responsibility, and perceived policy effectiveness, which
   in turn positively influence intentions to participate in circular
   economy activities. Among these factors, perceived value emerges as the
   strongest predictor of behavioral intention. In addition, collective
   efficacy significantly drives participation intentions but is not
   directly influenced by incentive policies, suggesting that incentives
   primarily operate through individual-level psychological mechanisms.
   These findings contribute to the literature on circular economy
   engagement by integrating ecofeminist insights into environmental policy
   research. The study also provides policy implications for designing
   targeted incentive mechanisms to promote circular economy participation
   in emerging economies such as Vietnam.},
