@article{ WOS:000833400700003,
Author = {Morris, Stephanie and Lawlor, Emma R. and Foley, Louise and Summerbell,
   Carolyn and Panter, Jenna and Adams, Jean and Jago, Russell and Pollard,
   Tessa M.},
Title = {Children's experiences of the journey between home and school: A
   qualitative synthesis using meta-ethnography},
Journal = {HEALTH \& PLACE},
Year = {2022},
Volume = {76},
Month = {JUL},
Abstract = {This paper uses meta-ethnography to synthesise qualitative and
   ethnographic studies of children's (aged 5-13) experiences of
   socio-material environments on their school journey. Most of the 21
   papers (18 studies) identified from the systematic search were from
   high-income countries and used self-report qualitative methods. Our
   synthesis shows children can feel vulnerable, but also negotiate
   journeys and manage risks, enjoy shared and solitary mobility, and
   explore their material environments. School journeys offer children a
   place to learn and develop agency within their socio-material
   environments. Attending to these wider benefits of school journeys,
   alongside supporting children to develop active modes attuned to the
   risks associated with these journeys, could improve the reach and impact
   of active school travel initiatives.},
