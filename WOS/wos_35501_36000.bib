@article{ WOS:001178415200004,
Author = {Liu, Muxing and Wang, Fangfang and He, Bo and Hu, Jiexiong and Dai, Ying
   and Chen, Weizhong and Yi, Mingxi and Zhang, Haifeng and Ye, Yonghao and
   Cui, Zhongli and Zheng, Xiaobo and Wang, Ping and Xing, Weiman and
   Zhang, Zhengguang},
Title = {Targeting Magnaporthe oryzae effector MoErs1 and host papain-like
   protease OsRD21 interaction to combat rice blast},
Journal = {NATURE PLANTS},
Year = {2024},
Volume = {10},
Number = {4},
Month = {APR},
Abstract = {Effector proteins secreted by plant pathogenic fungi are important
   artilleries against host immunity, but there is no precedent of such
   effectors being explored as antifungal targets. Here we demonstrate that
   MoErs1, a species-specific effector protein secreted by the rice blast
   fungus Magnaporthe oryzae, inhibits the function of rice papain-like
   cysteine protease OsRD21 involved in rice immunity. Disrupting
   MoErs1-OsRD21 interaction effectively controls rice blast. In addition,
   we show that FY21001, a structure-function-based designer compound,
   specifically binds to and inhibits MoErs1 function. FY21001
   significantly and effectively controls rice blast in field tests. Our
   study revealed a novel concept of targeting pathogen-specific effector
   proteins to prevent and manage crop diseases.},
