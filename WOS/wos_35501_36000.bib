@article{ WOS:001575592500001,
Author = {Jarmolowicz-Nowikow, Ewa and Karpinski, Maciej},
Title = {Boundaries of gestures: Naive segmentation of the stream of human hand
   movements},
Journal = {LANGUAGE \& COMMUNICATION},
Year = {2025},
Volume = {105},
Month = {NOV},
Abstract = {Na \& iuml;ve observers and researchers alike segment behavior into
   manageable units for analysis; yet, the nature and application of these
   units vary. This study examines differences in gesture segmentation
   between na \& iuml;ve observers and experts, as well as variability
   among na \& iuml;ve observers. We review a range of gesture definitions
   and segmentation cues, emphasizing the distinctions between perceiving
   gestures in interpersonal interactions and identifying them in video
   recordings, whether by trained or untrained annotators. In our empirical
   study, na \& iuml;ve observers annotated gestures and their prominent
   phases under two conditions: video-only ({''}silence{''}) and video with
   audio ({''}speech{''}), using ELAN software. The analyzed material
   consisted of an excerpt from a Member of Parliament's address. The
   results revealed no significant differences between conditions in the
   number of identified gestures, total or mean gesture duration. However,
   we found different levels of inter-annotator agreement in the two
   conditions and identified certain patterns in how participants
   distinguished gestures from the continuous flow of hand movements, which
   differed from expert segmentations. Results showed variability in
   annotation granularity, with na \& iuml;ve observers marking fewer
   gestures than experts. Additionally, prominence marking varied: na \&
   iuml;ve observers differed from experts, especially in the ``silence{''}
   condition. These findings underscore the nonintuitive nature of gestures
   as behavioral units and the influence of theoretical training on
   segmentation practices. (c) 2025 Published by Elsevier Ltd.},
