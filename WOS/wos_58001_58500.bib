   Montgomery, James W., Ohio Univ, Dept Commun Sci \& Disorders, Athens, OH 45701 USA.
   Evans, Julia L., Univ Texas Dallas, Sch Behav \& Brain Sci, Richardson, TX 75083 USA.},
DOI = {10.3389/fpsyg.2021.724356},
Article-Number = {724356},
ISSN = {1664-1078},
Keywords = {developmental language disorder; cognition; memory; attention; language},
Keywords-Plus = {VERBAL WORKING-MEMORY; GENERALIZED SLOWING HYPOTHESIS;
