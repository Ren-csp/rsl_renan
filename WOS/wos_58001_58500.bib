@article{ WOS:001804681500001,
Author = {Dawar, Sunny and Patnaik, Amitabh and Kudal, Pallavi and Dawar, Prince},
Title = {Exploring the relationships among consumer landscape, attention
   restoration, and place attachment in organic agritourism},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2026},
Volume = {7},
Number = {1},
Month = {JUN 12},
Abstract = {This study analyses the complex relationship between organic agriculture
   tourism, consumer landscape (CL), attention restoration (ART), and place
   attachment (PAT). As city life becomes more stressful, people seek
   relaxation in rural places. Organic agriculture tourism (OAT) provides
   health benefits, environmental education, and nature immersion. The
   purposive sample strategy was utilized, focusing on 78 agritourism
   centres in Western India. Data from 517 tourists were gathered using
   structured questionnaires. The data were analysed using PLS-SEM to
   evaluate the correlations among variables and to investigate the
   mediating effects. The high correlation between CL, ART, and PAT
   supported a multidimensional paradigm based on environmental psychology
   and restorative theory. CL affects PAT, and beautiful surroundings
   induce feeling. This supports the tripartite model that environmental
   interactions affect cognitive, emotional, and behavioural place
   attachment. Elegant landscapes boost mental health through light
   concentration and stress relief. The understudied link between CL, ART,
   and PAT helps environmental psychology and tourism research. Although
   nature improves mental and emotional wellness, academics have ignored
   how OAT promotes mental healing and profound place connections. ART
   bridges CL and PAT in this innovative study. Exploring how immersive
   landscape experiences increase tourist loyalty, satisfaction, and
   emotional engagement improves PAT development. The study also discusses
   organic agritourism, a fast-growing but under-theorized sustainable
   tourism subcategory that promotes environmental awareness, education,
   and rural economic growth.},
