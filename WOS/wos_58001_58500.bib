@article{ WOS:001834736900001,
Author = {Liao, Mengqi and Sundar, S. Shyam},
Title = {Chat but verify: Combating misinformation in conversational Generative
   AI with verification affordance},
Journal = {JOURNAL OF COMPUTER-MEDIATED COMMUNICATION},
Year = {2026},
Volume = {31},
Number = {3},
Month = {JUL},
Abstract = {Does the conversationality in Generative AI tools like ChatGPT persuade
   individuals to readily trust the information they provide? If so, it can
   be a problem because these tools are known to hallucinate and even
   generate misinformation. Can the presence of a verification mechanism
   help mitigate this problem? Guided by the HAII TIME model, we addressed
   these questions with a pre-registered 2 (Gen-AI conversationality cues:
   low vs. high) \& times; 4 (verification affordance: absence vs. cue vs.
   forced action vs. voluntary action) between-subjects online experiment
   measuring responses to a Gen-AI assistant that disseminates
   misinformation (N = 477). We found that high conversationality cues
   engender higher trust by inhibiting the activation of the negative
   machine heuristic (the perception that machines are mechanistic,
   incapable of subjective judgments, and cannot detect emotions, compared
   to humans). However, acting on the verification affordance mitigates
   this problem by decreasing the perceived credibility of the generated
   information. Our findings highlight the heuristic value of
   conversationality cues and reveal the underlying psychological
   mechanisms of lay users' trust in generative AI applications that
   generate misinformation. Results underscore the importance of building
   effective verification affordances to reduce users' overreliance on
   cognitive heuristics when making trust decisions. Theoretical and
   practical implications for human-AI interaction and the design of more
   socially responsible technology are discussed.
   Tools like ChatGPT are great at chatting like humans, which can make
   people feel they are chatting with someone they can trust. But these
   tools sometimes make mistakes or spread false information. We want to
   understand whether this highly conversational style causes everyday
   users to trust AI too easily, even when it is wrong. We also tested
   whether adding a fact-checking function could help people think more
   critically about what the AI says. We ran an online experiment with 477
   people, asking them to interact with an AI assistant that delivered
   incorrect information. We varied how conversational the AI was (low vs.
   high) and whether users had a way to verify the information (no
   verification, a simple cue, a required check, or an optional check). We
   found that a more conversational AI seemed less rigid and more capable
   of subjective decision-making, which led people to trust it more-even
   when it was spreading false health information. However, when people
   verified the information, they became more skeptical and were less
   likely to trust the AI, as it appeared less accurate or objective. This
   shows the importance of designing tools that help users verify
   AI-generated content instead of simply trusting it based on its
   ``conversational{''} nature.},
