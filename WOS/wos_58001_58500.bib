@article{ WOS:001847126600001,
Author = {Nguyen, Thanh Nhat Lai},
Title = {Bridging Sustainability and Logistics Service: Antecedents of Green
   Employee Service Behavior in Logistics Enterprises},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {15},
Month = {JUL 30},
Abstract = {This study examines the determinants of green employee service behavior
   (GESB) in maritime logistics by integrating the Theory of Planned
   Behavior and Social Identity Theory. Using survey data from maritime
   logistics employees and structural equation modeling, the findings show
   that environmental knowledge, green organizational climate, green
   organizational identity, green organizational support, perceived
   customer green expectations, and perceived behavioral control all
   significantly influence GESB. Perceived behavioral control emerges as
   the strongest predictor, followed by green organizational climate and
   green organizational support, underscoring the importance of employees'
   perceived capability and enabling organizational conditions.
   Furthermore, green organizational identity and perceived customer green
   expectations partially mediate the effects of organizational factors on
   GESB. By conceptualizing GESB as a customer-facing form of employee
   green behavior embedded in logistics service delivery, this study
   extends existing green behavior research beyond internal workplace
   environmental actions and offers theoretical and managerial insights for
   advancing sustainability in maritime logistics.},
