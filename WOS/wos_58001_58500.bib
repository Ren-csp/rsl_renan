@article{ WOS:001811962800001,
Author = {Madar, Anas and Geelle, Abdirahman and Osman, Samira},
Title = {An assessment of municipal solid waste management practices and
   challenges in Mogadishu, Somalia},
Journal = {FRONTIERS IN SUSTAINABILITY},
Year = {2026},
Volume = {7},
Month = {JUN 22},
Abstract = {The present study aimed to assess municipal solid waste management
   practices and challenges in Mogadishu, Somalia. The specific research
   objectives were to examine the state of municipal solid waste management
   practices, challenges, and strategies for improving practices and
   promoting best practices. Data were collected using a mixed-methods
   cross-sectional design from 273 respondents including waste management
   workers and residents. The findings reveal that current practices are
   largely ineffective, with 49.1\% of respondents rating services as
   ``poor{''}; 46.2\% of households currently resort to roadside dumping
   due to a lack of formal infrastructure. Significant barriers include
   inadequate financial resources, insufficient institutional capacity,
   technological deficiencies, and a lack of skilled personnel (58.3\%).
   Practical recommendations include the implementation of
   ``pay-as-you-throw{''} policies to ensure financial sustainability, the
   establishment of small-scale community recycling hubs to reduce landfill
   pressure, and the formalization of private-sector partnerships through
   rigorous legislative oversight and standardized disposal sites.},
