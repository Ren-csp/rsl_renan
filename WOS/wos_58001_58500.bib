@article{ WOS:000611764100001,
Author = {Jirakiattikul, Sopin and Lan, Tran Thi and Techato, Kuaanan},
Title = {Advancing Households' Sustainable Energy through Gender Attitudes
   towards Rooftop PV Installations: A Case of the Central Highlands,
   Vietnam},
Journal = {SUSTAINABILITY},
Year = {2021},
Volume = {13},
Number = {2},
Month = {JAN},
Abstract = {The report shows that there was no disparity between males and females
   in their attitude to rooftop solar electricity systems (rooftop PV)
   installations. Government motivation is the key factor that affects
   householders' attitudes to rooftop PV. Three other factors-households'
   perception, education and environment mentioning-were also crucial for
   the research model. Meanwhile, six factors had no significant effect on
   the dependent variables-these consisted of age, gender, rooftop
   material, level of electricity consumption, income per family member and
   household innovativeness.},
