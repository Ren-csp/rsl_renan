   Seth J. and O'Malley, Patrick M. and Rutherford, Caroline and
   Schulenberg, John},
Title = {Joint Effects of Age, Period, and Cohort on Conduct Problems Among
   American Adolescents From 1991 Through 2015},
Journal = {AMERICAN JOURNAL OF EPIDEMIOLOGY},
