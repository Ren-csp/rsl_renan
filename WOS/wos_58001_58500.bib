@article{ WOS:000502379800017,
Author = {Ing, Alex and Saemann, Philipp G. and Chu, Congying and Tay, Nicole and
   Biondo, Francesca and Robertl, Gabriel and Jia, Tianye and Wolfers,
   Thomas and Desrivieres, Sylvane and Banaschewski, Tobias and Bokde, Arun
   L. W. and Bromberg, Uli and Buechel, Christian and Conrod, Patricia and
   Fadai, Tahmine and Flor, Herta and Frouin, Vincent and Garavan, Hugh and
   Spechler, Philip A. and Gowlandl, Penny and Grimmer, Yvonne and Heinz,
   Andreas and Ittermann, Bernd and Kappel, Viola and Martinot, Jean-Luc
   and Meyer-Lindenberg, Andreas and Millenets, Sabina and Neess, Frauke
   and van Noort, Betteke and Orfanos, Dimitri Papadopoulos and Martinot,
   Marie-Laure Paillere and Penttilae, Jani and Poustka, Luise and Quinlan,
   Erin Burke and Smolka, Michael N. and Stringaris, Argyris and Struve,
   Maren and Veer, Ilya M. and Walter, Henrik and Whelan, Robert and
   Andreassen, Ole A. and Agartz, Ingrid and Lemaitre, Herve and Barker,
   Edward D. and Ashburner, John and Binder, Elisabeth and Buitelaar, Jan
   and Marquand, Andre and Robbins, Trevor W. and Schumann, Gunter and
   IMAGEN Consortium},
Title = {Identification of neurobehavioural symptom groups based on shared brain
   mechanisms},
Journal = {NATURE HUMAN BEHAVIOUR},
Year = {2019},
Volume = {3},
Number = {12},
Pages = {1306-1318},
Month = {DEC},
Abstract = {Most psychopathological disorders develop in adolescence. The biological
   basis for this development is poorly understood. To enhance diagnostic
   characterization and develop improved targeted interventions, it is
   critical to identify behavioural symptom groups that share neural
   substrates. We ran analyses to find relationships between behavioural
   symptoms and neuroimaging measures of brain structure and function in
   adolescence. We found two symptom groups, consisting of
   anxiety/depression and executive dysfunction symptoms, respectively,
   that correlated with distinct sets of brain regions and inter-regional
   connections, measured by structural and functional neuroimaging
   modalities. We found that the neural correlates of these symptom groups
   were present before behavioural symptoms had developed. These neural
   correlates showed case-control differences in corresponding psychiatric
   disorders, depression and attention deficit hyperactivity disorder in
   independent clinical samples. By characterizing behavioural symptom
   groups based on shared neural mechanisms, our results provide a
   framework for developing a classification system for psychiatric illness
   that is based on quantitative neurobehavioural measures.},
