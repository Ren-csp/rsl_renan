@article{ WOS:001846697300001,
Author = {Alberti, Juan and Bruschetti, Martin and Cardoni, Augusto and Daleo,
   Pedro and Fanjul, Eugenia and Iribarne, Oscar and Montemayor, Diana
   Ireri and Marino, Andrea and Pascual, Jesus and Pazos, Gustavo and
   Rodriguez, Victoria},
Title = {Combined grazing by guanacos and small herbivores stabilizes vegetation
   dynamics in a semiarid Patagonian grassland},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {14},
Month = {JUL 29},
Abstract = {The global decline of large herbivores disrupts ecosystem structure, yet
   the ecological roles of recovering native large herbivores and their
   interactions with smaller herbivores in semiarid environments remain
   poorly understood. In the Patagonian steppe, the recovery of native
   guanacos has sparked human-wildlife conflicts due to concerns over land
   degradation. To disentangle the effects of different-sized vertebrate
   herbivores, we conducted a ten-year exclusion experiment in a Patagonian
   grassland, evaluating the impacts of fully grazed areas, large-herbivore
   exclosures, and total vertebrate exclosures on vegetation structure,
   soil properties, alongside the modulating effects of water stress and
   guanaco density. We found that the combined grazing of large and small
   herbivores exerted the strongest control on the ecosystem. Total
   herbivore exclusion significantly increased plant cover and standing
   dead biomass, while doubling canopy light interception and increasing
   soil organic matter. However, exclusion altered community composition,
   enhanced spatial and temporal heterogeneity, and reduced plant species
   richness. Many of these structural shifts lagged, becoming evident only
   after the fifth experimental year. Furthermore, large-herbivore
   exclusion alone reduced soil inorganic nitrogen and triggered a ten-fold
   increase in European hare dropping density, suggesting competitive
   interactions between large and small herbivores. These findings
   demonstrate that native guanacos act as keystone species that stabilize
   vegetation dynamics and maintain plant diversity without driving
   irreversible degradation. Consequently, the recovery of wild native
   herbivore guilds is ecologically compatible with the conservation and
   stability of semiarid grasslands.},
