@article{ WOS:000505251300133,
Author = {Peng, Y.},
Title = {INFLUENCE OF ENVIRONMENTAL LANDSCAPE STRUCTURE ON THE DISTRIBUTION
   FEATURES OF PLANT COMMUNITIES IN GREEN PARKS},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
