   Angeles; Tree canopy cover; Urban forest},
Keywords-Plus = {CANOPY; HEALTH},
Research-Areas = {Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Ecology; Environmental Sciences; Environmental Studies},
Author-Email = {demian.willette@lmu.edu},
Affiliations = {Loyola Marymount University},
Funding-Acknowledgement = {LMU Biology Department and Seaver College of Science and Engineering},
Funding-Text = {We thank Ashley Lee, Stephanie Flores, Sabriya Seid, Alexa Siglar, and
