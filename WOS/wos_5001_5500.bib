Year = {2022},
Volume = {15},
Month = {AUG 15},
Abstract = {A little over a hundred years after the introduction of the automobile
   in cities, many of its impacts are still unknown. This study aims to
   address the implications of vehicle storage on the intensity of urban
   land use, based on the analysis of a commercial development in a
   high-value downtown area in a Mexican border city and the applicable
   regulations. in urban matters. This seeks to provide data to demonstrate
   the relationship between the space for car parking and the dispersed
   city model based on local regulations of an architectural and urban
   nature.},
