@article{ WOS:001360601600001,
Author = {Barragan-Jason, Gladys and Cauchoix, Maxime and Diaz-Valencia, Paula A.
   and Syssau-Vaccarella, Arielle and Hemet, Solene and Cardozo, Camilo and
   Skevington, Suzanne M. and Heeb, Philipp and Parmesan, Camille},
Title = {Human-nature connectedness and sustainability across lifetimes: A
   comparative cross-sectional study in France and Colombia},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {1},
Pages = {99-111},
Month = {JAN},
Abstract = {To achieve sustainable targets, international panels call for a
   transformative change in human-nature interactions to foster human
   well-being and promote pro-environmental behaviour. The extent to which
   people considered themselves as part of nature-known as human-nature
   connectedness-has been shown to be a key societal trait for achieving
   such a transformative change. Human-nature connectedness is linked to
   improved human welfare and actions for nature conservation and can be
   increased by direct contact with natural environments in adults living
   in the Global North. It has not been shown whether these relations are
   true across lifetimes and in the Global South, making it difficult to
   generalise about the effects of human-nature connectedness globally.
   Here, we conducted a cross-sectional study to examine and compare
   human-nature connectedness across ages in 1858 participants aged 3-87
   years from two countries: France (N = 1059) and Colombia (N = 799). We
   also investigated the links between human-nature connectedness,
   pro-environmental behaviours, well-being and two indicators of
   opportunity to experience nature (i.e. degree of urbanisation and forest
   cover around the participants' municipality of residence). Results show
   that human-nature connectedness is positively related to well-being and
   pro-environmental behaviours in both countries. Analyses revealed an
   age-related pattern of human-nature connectedness with a significant
   decline from childhood to the mid-teens in both countries. Overall,
   Colombian participants have a higher human-nature connectedness than
   French participants and individuals' human-nature connectedness was
   negatively linked to the urbanisation's indices in both countries. Here,
   we show that human-nature connectedness is linked to sustainable
   outcomes in a Global South country, just as it is in the Global North.
   Our study also suggests that increasing contact with nature during
   formative teenage years could mitigate the observed decline in
   human-nature connectedness. Future studies are warranted combining
   qualitative and quantitative measures related to human-nature
   connectedness, nature experiences, values and practices in relation to
   nature, in multiple countries from the global South. Our study indicates
   that enhancing human-nature connectedness could provide an additional
   tool for achieving sustainable targets globally, not just in highly
   developed northern-hemisphere countries.Read the free Plain Language
   Summary for this article on the Journal blog.
   Para lograr un futuro sostenible, los paneles internacionales hacen un
   llamado a un cambio transformador en las interacciones entre humanos y
   la naturaleza, con el fin de fomentar el bienestar humano y promover
   comportamientos proambientales. La medida en que las personas se
   consideran parte de la naturaleza-conocida como Conectividad
   Humano-Naturaleza-se ha demostrado como un rasgo clave de la sociedad
   para alcanzar dicho cambio transformador. La conectividad
   humano-naturaleza est \& aacute; vinculada a una mejora en el bienestar
   humano y a acciones para la conservaci \& oacute;n de la naturaleza, y
   puede incrementarse mediante el contacto directo con entornos naturales
   en adultos que viven en el Norte Global. No se ha demostrado si estas
   relaciones son v \& aacute;lidas a lo largo de la vida y en el Sur
   Global, lo que dificulta generalizar sobre los efectos de la
   conectividad humano-naturaleza a nivel mundial. Aqu \& iacute;,
   realizamos un estudio transversal para examinar y comparar la
   conectividad humano-naturaleza a lo largo de las edades en 1858
   participantes, entre los 3 y 87 a \& ntilde;os, de dos pa \& iacute;ses:
   Francia (N = 1059) y Colombia (N = 799). Tambi \& eacute;n investigamos
   los v \& iacute;nculos entre la conectividad humano-naturaleza, los
   comportamientos proambientales, el bienestar, y dos indicadores de
   oportunidades para experimentar la naturaleza (es decir, el grado de
   urbanizaci \& oacute;n y la cobertura forestal en los alrededores del
   municipio de residencia de los participantes). Los resultados muestran
   que la conectividad humano-naturaleza est \& aacute; positivamente
   relacionada con el bienestar y los comportamientos proambientales en
   ambos pa \& iacute;ses. Los an \& aacute;lisis revelaron un patr \&
   oacute;n relacionado con la edad en cuanto a la conectividad
   humano-naturaleza, con una disminuci \& oacute;n significativa desde la
   infancia hasta la adolescencia media en ambos pa \& iacute;ses. En
   general, los participantes colombianos mostraron una mayor conectividad
   humano-naturaleza que los participantes franceses, y la conectividad
   humano-naturaleza de los individuos se vincul \& oacute; negativamente
   con los \& iacute;ndices de urbanizaci \& oacute;n en ambos pa \&
   iacute;ses. Aqu \& iacute; mostramos que la conectividad
   humano-naturaleza est \& aacute; relacionada con resultados sostenibles
   en un pa \& iacute;s del Sur Global, al igual que en el Norte Global.
   Nuestro estudio tambi \& eacute;n sugiere que aumentar el contacto con
   la naturaleza durante los a \& ntilde;os formativos de la adolescencia
   podr \& iacute;a mitigar la disminuci \& oacute;n observada en la
   conectividad humano-naturaleza. Se justifican estudios futuros que
   combinen medidas cualitativas y cuantitativas relacionadas con la
   conectividad humano-naturaleza, las experiencias con la naturaleza, los
   valores y las pr \& aacute;cticas en relaci \& oacute;n con la
   naturaleza, en m \& uacute;ltiples pa \& iacute;ses del Sur Global.
