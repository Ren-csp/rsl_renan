@article{ WOS:001738307000001,
Author = {Yang, Haopeng and Wang, Yiyang and Gao, Lanxin and Chen, Mingze},
Title = {Mapping spatial patterns of running activity on park using machine
   learning and geotagged social media data},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Urban parks provide critical environmental and health benefits in
   cities, yet the spatial distribution of specific activities such as
   running remains poorly understood. This gap limits planners' ability to
   design parks that effectively support physical activity and equitably
   distribute recreational opportunities. This study integrates machine
   learning with geotagged social media data to map and analyze running
   patterns across Singapore's urban parks. We quantified running intensity
   and volume using crowdsourced GPS tracks from fitness apps and applied
   computer vision to Flickr images to detect organized running events. We
   then employed regression models to examine how park characteristics
   relate to running volume and event occurrence. Results showed that
   running activity was highly uneven: most activity clustered in a few
   large, well-connected parks and green corridors, while many small
   neighborhood parks saw minimal use. Higher running volumes were
   associated with denser trail networks and waterfront or linear parks,
   while a larger number of access points correlated with lower volumes.
   Events were more frequent in parks with multiple entrances, clear
   signage, and transit links, and less frequent in densely populated
   districts. These findings offer detailed evidence to inform data-driven
   urban park planning and point to targeted interventions that can improve
   access and more equitably distribute running opportunities. Overall, the
   study shows that big data analytics effectively capture human activity
   patterns, supporting evidence-based and inclusive urban park planning
   for healthier and more sustainable cities.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
