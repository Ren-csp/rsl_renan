@article{ WOS:000742419100001,
Author = {Shakya, Ranish and Ahiablame, Laurent},
Title = {A Synthesis of Social and Economic Benefits Linked to Green
   Infrastructure},
Journal = {WATER},
Year = {2021},
Volume = {13},
Number = {24},
Month = {DEC},
Abstract = {Green infrastructure (GI) is a land development approach that uses a
   network of natural and built areas and waterways to create healthier
   urban environments. This study presents a synthesis of GI planning and
   adoption in 16 cities selected from around the world; 12 of these cities
   are located in the United States. The study highlights key
   socio-economic benefits associated with GI adoption and documents
   analytical procedures used to quantify the benefits linked to GI
   implementation. The benefits as identified and reported in this study
   are qualitative rather than quantitative.},
