@article{ WOS:001875518300001,
Author = {de Carvalho, Guilhardo Barros Moreira and de Araujo, Virginia Maria
   Dantas},
Title = {Dynamics of urban cooling strategies across distinct climatic contexts:
   A scoping review and evidence analysis},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {150},
Month = {OCT 15},
Abstract = {The paradigm of the contemporary global scenario is characterized by
   accelerated urban expansion. This expansion promotes soil sealing and
   the replacement of vegetation with low-albedo materials, thereby
   intensifying the Urban Heat Island effect, which elevates temperatures
   by 2 degrees C to 12 degrees C. By means of a scoping review structured
   under the PRISMA-ScR protocol and complemented by bibliometric analysis
   (2015-2025), this study systematized 86 articles to map and evaluate the
   performance of urban cooling strategies across different climate
   classifications. The results indicate an exponential growth in
   investigations, although a concentration in subtropical and continental
   climates was detected, with a research prominence from China. It was
   found that the effectiveness of Nature-Based Solutions is not a constant
   attribute, as it is conditioned by urban configuration. An asymmetry in
   efficacy was evidenced: while parks and dense afforestation attenuate
   the Physiological Equivalent Temperature index by up to 18 degrees C,
   green roofs exhibit limited performance at the pedestrian level (0.1
   degrees C to 0.7 degrees C). This discrepancy corroborates that the
   operative effectiveness of these strategies transcends the typology of
   the technology, depending instead on morphological arrangement and
   configuration. The study highlights critical trade-offs, such as the
   increase in Mean Radiant Temperature induced by high-albedo materials in
   compact urban canyons and the physiological limitations of vegetation
   under water stress conditions in arid climates. It is inferred that heat
   mitigation requires multiscale approaches and bioclimatic
   contextualization, rendering the expansion of the knowledge frontier in
   the Global South imperative to ensure urban resilience in the face of
   climate change.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
