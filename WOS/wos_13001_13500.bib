@article{ WOS:001866920900001,
Author = {Bolleter, Julian and Grace, Bill and Barghchi, Maassoumeh and Edwards,
   Nicole and Mojica Gonzalez, Nicolas},
Title = {An evidence base for climate-responsive suburbs},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2026},
Month = {2026 SEP 5},
Abstract = {Climate-Sensitive Urban Design literature largely focuses on urban areas
   and Urban Heat Island effects, with far less attention to suburbia. In
   response, this study models outdoor thermal comfort across six suburbs
   in hot K \& ouml;ppen climate zones in Western Australia using
   Physiological Equivalent Temperature (PET) as a metric.
   Strong-to-extreme heat stress occurs across all precincts on typical
   summer days, indicating limited responsiveness to climatic conditions.
   Thermal discomfort is greatest near clustered built form, and parks
   lacking tree canopy provide minimal cooling. This highlights the need
   for suburban design that improves ventilation and delivers tree
   canopy-based shade networks.},
