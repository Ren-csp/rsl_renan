@article{ WOS:001351997100001,
Author = {Castanon, Ugo N. and Ribeiro, Paulo J. G. and Mendes, Jose F. G.},
Title = {Evaluating Urban Bikeability: A Comprehensive Assessment of Póvoa de
   Varzim's Network},
Journal = {SUSTAINABILITY},
Year = {2024},
