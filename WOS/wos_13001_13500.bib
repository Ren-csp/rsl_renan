@article{ WOS:001738339200004,
Author = {Giraldo-Ospina, Tania and Zuluaga-Giraldo, Lina Maria and
   Vasquez-Varela, Luis Ricardo},
Title = {Challenges and Opportunities in the Management of Public Space:
   indicators and forms of production in the city of Manizales, Colombia},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2026},
Volume = {58},
Number = {227},
Pages = {218-241},
Month = {SPR},
Abstract = {Manizales is an intermediate city in Colombia that presents diverse
   forms of production of public space (PS), standing out at the national
   level for having superior indicators and linking environmental variables
   in its planning. The objective is to identify challenges and
   opportunities through the study of indicators and forms of production. A
   mixed approach is adopted with quantitative and qualitative techniques
   based on documentary analysis, field work and geographic information
   systems. Five categories are identified: reported by the local
   authority, co-managed, self-managed, not inventoried and/or private for
   public use, and non-existent or privately occupied. The recognition of
   alternative forms of management with private and community
   participation, including self-managed, co-managed and private areas for
   public use, contributes to meeting community needs and achieving the
   Sustainable Development Goals.},
