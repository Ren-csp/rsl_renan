@article{ WOS:000571104000012,
Author = {Isaacson, Michal and Barkay, Dov},
Title = {Mobility scooters in urban environments: A research agenda},
Journal = {JOURNAL OF TRANSPORT \& HEALTH},
Year = {2020},
Volume = {18},
Month = {SEP},
Abstract = {Introduction: As our society ages, mobility scooters are a fast-growing
   mode of transportation. The growing prevalence of mobility scooters as a
   mode of transportation has the potential to not only affect the lives of
   older adults who use them but to impact urban environments at large as
   well as have implications for the safety of pedestrians and of other
   vehicle users.
   Goal: The goal of this paper is to explore the gaps in the existing
   literature regarding mobility scooters, laying out key areas for future
   research.
   Results: We propose three areas of research that focus on mobility
   scooter use by older people: (1) research involving users - impacts on
   older people employing mobility scooters; (2) studying the impact on
   urban space-public spaces and passageways used as travel routes, the
   barriers impeding travel and lack of appropriate parking solutions in
   the urban environment; and (3) issues of safety -mobility scooter
   driving and travel regulations and infrastructure design regulations.
   Discussion: Addressing these gaps in knowledge has the potential to
   contribute to the social and physical sustainability of future urban
   environments as well as to the wellbeing of older adults.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Isaacson, M (Corresponding Author), Univ Haifa, Abba Khoushy Ave 199, IL-3498838 Haifa, Israel.
   Isaacson, Michal; Barkay, Dov, Univ Haifa, Abba Khoushy Ave 199, IL-3498838 Haifa, Israel.},
DOI = {10.1016/j.jth.2020.100917},
Article-Number = {100917},
ISSN = {2214-1405},
Keywords = {Aging; Mobility scooters; Mobility; Urban transportation; Autonomy;
   Well-being; Safety; Legislation},
