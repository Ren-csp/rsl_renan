@article{ WOS:001656497100001,
Author = {Gur, Necmettin and Gur, Seyda},
Title = {Strategic Planning for Alternative Irrigation Resources under Climate
   Change in Urban Landscapes: An ARDL-ANP Integrated Approach},
Journal = {CHINESE JOURNAL OF URBAN AND ENVIRONMENTAL STUDIES},
Year = {2025},
Volume = {13},
Number = {04},
Month = {DEC},
Abstract = {Climate change is one of the most critical environmental problems of our
   time, along with rising temperatures, irregular precipitation patterns
   and diminishing water resources. This situation has led to negative
   consequences such as water stress, disruption of ecosystem balance, and
   a decline in quality of life, particularly in densely populated urban
   areas. Urban landscapes play a significant role in mitigating the
   effects of climate change and creating sustainable living spaces. In
   this context, the use of alternative water sources is essential for both
   efficient water management and enhancing ecological resilience. In this
   study, the Autoregressive Distributed Lag (ARDL) method was applied to
   examine the relationship between climatic variables and the need for
   alternative water sources in urban landscapes. The results revealed that
   climatic factors such as temperature and carbon emissions have
   significant effects on water resources. Following the quantitative
   determination of this necessity, the Analytical Network Process (ANP)
   method was used to develop strategic recommendations for alternative
   water use in T \& uuml;rkiye. Based on evaluations supported by expert
   opinions, the ``Green Infrastructure and System Integration{''}
   criterion was determined to have the highest priority. The study
   emphasizes the importance of alternative irrigation strategies in urban
   landscapes within the scope of climate change adaptation and offers
   sustainable solution recommendations to policymakers and practitioners.},
