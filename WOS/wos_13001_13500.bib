@article{ WOS:001476236600001,
Author = {RoohaniQadikolaei, Mohsen and RoohaniQadikolaei, Fatemeh and Soltani,
   Ali and Misaghi, Mahmoud and Zali, Nader},
Title = {Distance matters: Quantifying the influence of urban land use change and
   development proximity on land surface temperature in Sari, Iran},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {174},
Month = {MAY},
Abstract = {The rapid expansion of urban areas has led to significant land use
   changes, affecting local climate systems, particularly through an
   increase in Land Surface Temperature. This study investigates the
   spatio-temporal dynamics of Urban Land Use Changes, and its impact on
   temperature patterns, using Landsat imagry and advanced GIS techniques
   to analyze changes in LST over 10 years in Sari, Iran. The results
   indicate 3 degrees C increase in average LST over 10 years, with maximum
   temperatures rising from 53 degrees C to 56 degrees C. A clear gradient
   in LST was observed, with areas closer to the spots with land use change
   experiencing more temperature increase in the temperature. The further
   distance to transportation infrastructure showed the strongest cooling
   effect, with proximity reducing LST significantly. Conversely, increased
   distance to gardens and green infrastructure were associated with higher
   LST. These findings emphasize the critical role of land use
   transformation in mitigating or worsening urban surface tempreature.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Soltani, A (Corresponding Author), Flinders Univ S Australia, Healthy Communities, FHMRI, Adelaide 5042, Australia.
