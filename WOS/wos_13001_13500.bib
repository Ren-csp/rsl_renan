@article{ WOS:000418492200002,
Author = {Derose, Kathryn P. and Han, Bing and Williamson, Stephanie and Cohen,
   Deborah A.},
Title = {Gender Disparities in Park Use and Physical Activity among Residents of
   High-Poverty Neighborhoods in Los Angeles},
Journal = {WOMENS HEALTH ISSUES},
