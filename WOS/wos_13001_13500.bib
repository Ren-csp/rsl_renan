   Poortinga, Wouter, Cardiff Univ, Welsh Sch Architecture, Cardiff, Wales.
   Poortinga, Wouter, Cardiff Univ, Sch Psychol, Cardiff, Wales.},
DOI = {10.1016/j.landurbplan.2020.103951},
