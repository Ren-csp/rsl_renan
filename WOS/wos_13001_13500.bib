@article{ WOS:001860934400001,
Author = {Czuckermand, Lola and Santonja, M. and Torre, F. and Brasseur, S. and
   Talin, F. and Dupouyet, S. and Gauquelin, T. and Baldy, V.},
Title = {Response of soil mesofauna to an urbanization gradient in a
   Mediterranean climate},
Journal = {URBAN ECOSYSTEMS},
Year = {2026},
Volume = {29},
Number = {5},
Month = {AUG 27},
Abstract = {Urban spread is a global phenomenon that alters ecosystem functioning
   and the services they provide. Soils, and particularly those of Urban
   Green Spaces (UGS), play a key role in supporting biodiversity and
   numerous ecosystem services in cities. Soil mesofauna is widely
   recognized as valuable bioindicators of soil health. To investigate
   changes in soil mesofauna communities along an urbanization gradient, we
   sampled soils in 22 UGS in Marseille (France), a Mediterranean coastal
   city experiencing extreme weather events. These 22 UGS were classified
   into three urbanization degrees: epicentre (high urbanization level),
   urban (medium urbanization level), and periphery (low urbanization
   level). We examined how park size, ground cover type, and soil
   properties, including carbon (C), nitrogen (N), metal and metalloid
   concentrations affect community structure. Our results show that the
   structure of the mesofauna community was affected by increasing
   urbanization degree. Several taxa declined in abundance, while others
   (Pauropoda, Polyxenida and Psocoptera) were completely absent. Soils in
   epicentre exhibited lower C and N and higher As, Pb, and Cu
   concentrations. Mesofauna communities were primarily influenced by C, N,
   C/N ratio and ground cover type rather than by the contaminant levels.
   These findings highlight the importance of local management practices,
   particularly maintaining vegetation cover, in mitigating urbanization
   impact on soil mesofauna and, more broadly, on biodiversity loss in
   urban soils.},
