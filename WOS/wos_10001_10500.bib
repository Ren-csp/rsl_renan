@article{ WOS:001872563800001,
Author = {Best, Myriam and Varvarousis, Angelos},
Title = {Spatialising degrowth in affluent urban areas: Limits and contradictions
   of sustainability policy in Zurich},
Journal = {CITIES},
Year = {2026},
Volume = {179},
Month = {DEC},
Abstract = {Although affluent cities in the Global North are often celebrated as
   urban sustainability frontrunners, their strategies are increasingly
   criticised for perpetuating externalisation, social inequalities, and
   growth-dependent development pathways. We explore these tensions by
   critically analysing Zurich, a hyper-affluent and highly ranked
   ``sustainable{''} cities. Drawing on an analysis of 22 public policy
   documents produced between 2016 and 2025, complemented by situated
   qualitative insights, we examine the policy rationalities, instruments,
   omissions, and contradictions that shape Zurich's urban development and
   sustainability agenda from a degrowth perspective. Building on recent
   advances in degrowth spatial politics, we propose a new, multiscalar
   analytical framework for evaluating urban policies across four
   dimensions: planetary-scale thinking, structural economic dependencies,
   social and ecological well-being, and democratic governance. Applying
   this framework to Zurich reveals deep contradictions between its green
   growth agenda and its stated environmental and social objectives.
   Despite demonstrating strong institutional capacity and policy
   innovation, Zurich's strategies largely remain confined to territorial
   emissions, voluntary measures, and incentive-based instruments, leaving
   consumption-based impacts, growth dependencies and displacement dynamics
   insufficiently addressed. We show how inward densification, net-zero
   strategies, and circular economy initiatives can simultaneously reduce
   local environmental pressures while intensifying social inequalities and
   shifting socio-ecological costs to hinterlands. These outcomes are
   further shaped by multilevel governance constraints and limited
   municipal competences. Unless structural growth dependencies and
   extraterritorial impacts are addressed, urban sustain-ability strategies
   in affluent cities risk perpetuating the very dynamics they seek to
   overcome. Our framework offers a diagnostic tool for critically
   assessing sustainability policies in other affluent urban contexts.},
