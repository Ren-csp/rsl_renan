@article{ WOS:000407648100007,
Author = {De Ruiter, Naomi M. P. and Van der Steen, Steffie and Den Hartigh, Ruud
   J. R. and Van Geert, Paul L. C.},
Title = {Capturing moment-to-moment changes in multivariate human experience},
Journal = {INTERNATIONAL JOURNAL OF BEHAVIORAL DEVELOPMENT},
Year = {2017},
Volume = {41},
Number = {5},
Pages = {611-620},
Month = {SEP},
Abstract = {In this article, we aim to shed light on a technique to study
   intra-individual variability that spans the time frame of seconds and
   minutes, i.e., micro-level development. This form of variability is
   omnipresent in behavioural development and processes of human
   experience, yet is often ignored in empirical studies, given a lack of
   proper analysis tools. The current article illustrates that a clustering
   technique called Kohonen's Self-Organizing Maps (SOM), which is widely
   used in fields outside of psychology, is an accessible technique that
   can be used to capture intra-individual variability of multivariate
   data. We illustrate this technique with a case study involving
   self-experience in the context of a parent-adolescent interaction. We
   show that, with techniques such as SOM, it is possible to reveal how
   multiple components of an intra-individual process (the adolescent's
   self-affect and autonomy) are non-linearly connected across time, and
   how these relationships transition in accordance with a changing
   contextual factor (parental connectedness) during a single interaction.
   We aim to inspire researchers to adopt this technique and explore the
   intra-individual variability of more developmental processes, across a
   variety of domains, as deciphering such micro-level processes is crucial
   for understanding the nature of psychological and behavioural
   development.},
Publisher = {SAGE PUBLICATIONS LTD},
Address = {1 OLIVERS YARD, 55 CITY ROAD, LONDON EC1Y 1SP, ENGLAND},
