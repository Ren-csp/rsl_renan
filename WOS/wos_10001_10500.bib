@article{ WOS:001603316200003,
Author = {Frederickson, Louise B. and Russell, Hugo S. and Sorensen, Martin O. B.
   and Schmidt, Johan A. and Hertel, Ole and Johnson, Matthew S.},
Title = {Hyperlocal air pollution in London: Nitrogen dioxide measured with a
   low-cost sensor network and mobile monitoring},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2025},
Volume = {363},
Month = {DEC 15},
Abstract = {Low-cost sensors (LCS) and mobile monitoring can enhance existing
   regulatory air pollution monitoring programs, to obtain more
   comprehensive spatial and temporal data on air quality. In this study,
   we evaluate rapid and hyperlocal nitrogen dioxide (NO2) pollution
   gradients in London using a network of LCS nodes and mobile monitoring
   through a Mobile Air Pollution Sensing (MAPS) car. Based on both
   stationary and in-transit measurements, the correlations (R2) between
   the MAPS car and the LCS nodes decreased from 0.80 to 0.19 as their
   distance increased from 0-5 m to 16-45 m. Case studies in parks and
   tunnels revealed that NO2 mixing ratios varied significantly over small
   distances and times. For example, the mean mixing ratio of NO2 in the
   urban environment was 21.2 +/- 11.8 ppb, whereas it increased to 61.3
   +/- 25.0 ppb in the Rotherhithe Tunnel, while NO2 increased from a mean
   of 11.4 +/- 3.0 ppb to 22.0 +/- 16.3 ppb, from the center of Regent's
   Park to the roads that surround it. This study shows that pollution
   changes rapidly in urban areas in both space and time and that
   high-density networks and mobile monitoring can significantly increase
   the accuracy of pollution mapping.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
