@article{ WOS:000487059500003,
Author = {Cordeiroa, Adriana Tenorio and Benicio de Mello, Sergio Carvalho and da
   Silva Bastos, Antonio Fagner},
Title = {This is our beach! Appropriation and use of paulista avenue in the
   context of urban development policies},
Journal = {URBE-REVISTA BRASILEIRA DE GESTAO URBANA},
Year = {2019},
Volume = {11},
Abstract = {This article aims to analyze arguments about the experience of
   occupation and use of Paulista Avenue to advance the understanding on
   urban development policies and their effects. We followed and
   archaeological analysis inspired by Michel Foucault, an approach that
   focuses on speeches to understand the present formations from the
   identification of their statements. As for the Open Paulista (Paulista
   Aberta), there is a clear spatial dispute, with hierarchies of power
   being challenged by an emphasis on walking, cycling and leisure.
   However, although there are favorable and unfavorable speeches, such do
   not appear to be antagonistic. This work is a critical starting point
   for the investigation of the relations of power imbricated in the logics
   of social production of this space.},
