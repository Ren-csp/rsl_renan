@article{ WOS:001839495700001,
Author = {Abdi, Mohammad Hamed and Vanoutrive, Thomas},
Title = {Perceiving ``city of proximity{''} beyond spatial closeness: Explaining
   travel and consumption behavior through perceptions and preferences},
Journal = {CITIES},
Year = {2026},
Volume = {179},
Month = {DEC},
Abstract = {Proximity-based planning has gained traction as a powerful concept for
   neighborhood planning and design in response to the mobility
   restrictions imposed by the COVID-19 pandemic-evidenced by the global
   enthusiasm for the 15-Minute City. However, deterministic strategies and
   objective measurements of physical proximity have left little room for
   understanding how people perceive a city of proximity, as well as their
   desires and needs. The present study seeks to uncover the perceptual
   dimensions of the concept by examining how these perceptions influence
   travel and consumption behavior, moving beyond mere consideration of
   objective proximity. To do so, this research employs structural equation
   modeling, based on data from an online survey conducted in the
   Brussels-Capital Region (Belgium), to analyze how public perceptions and
   individual preferences impact perceived proximity and, subsequently,
   self-reported travel and consumption behaviors in a complex
   relationship. The results show that preferences toward urban facilities
   and mobility are stronger contributors to behaviors than perceptions of
   facilities and built environments. Another key finding confirms that the
   perception of proximity is a central mediating factor in understanding
   what influences behavior. This is especially relevant when objective
   factors like physical environments and availability of opportunities
   provide an insufficient explanation. The research also cautions against
   overemphasizing specific thresholds, soft mobility, and neighborhood
   self-sufficiency, as this may negatively impact travel behavior and
   reduce the concept's inclusiveness. These results add to the rapidly
   expanding field of proximity-based planning by enhancing our
   understanding of how perceptual determinants are associated with the
   concept of the city of proximity and behaviors.},
