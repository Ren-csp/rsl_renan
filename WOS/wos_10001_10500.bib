@article{ WOS:000310426300002,
Author = {Tannier, Cecile and Vuidel, Gilles and Houot, Helene and Frankhauser,
   Pierre},
Title = {Spatial accessibility to amenities in fractal and nonfractal urban
   patterns},
Journal = {ENVIRONMENT AND PLANNING B-PLANNING \& DESIGN},
Year = {2012},
Volume = {39},
Number = {5},
Pages = {801-819},
Abstract = {One of the challenges of urban planning and design is to formulate an
   optimal urban form that meets all the environmental, social, and
   economic expectations of sustainable urban development. In this
   perspective, some scholars have taken an interest in fractal urban
   forms. Our objective is to evaluate the benefit of a fractal urban form
   in terms of spatial accessibility to local urban (shops and services)
   and rural (open spaces) amenities. To do this, we propose a multiscale
   fractal simulation system named MUP-City for simulating various
   residential development scenarios based on an existing urban pattern.
   Using MUP-City over a single study area, we generate fifty fractal and
   nonfractal urbanization scenarios and then compare them in terms of
   spatial accessibility to local amenities. Compared with nonfractal
   urbanization scenarios, fractal scenarios involve travelling shorter
   distances to reach various types of open space, but greater distances to
   visit various types of shops and services. Access to shops and services
   in fractal scenarios can be improved by altering the location of shops
   and services, whereas access to open spaces in nonfractal scenarios
   cannot be improved without changing the built form of reference.},
Publisher = {SAGE PUBLICATIONS LTD},
Address = {1 OLIVERS YARD, 55 CITY ROAD, LONDON EC1Y 1SP, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Tannier, C (Corresponding Author), Univ Franche Comte, CNRS, TheMA, 32 Rue Megevand, F-25030 Besancon, France.
   Tannier, Cecile; Vuidel, Gilles; Houot, Helene; Frankhauser, Pierre, Univ Franche Comte, CNRS, TheMA, F-25030 Besancon, France.},
DOI = {10.1068/b37132},
ISSN = {0265-8135},
