@article{ WOS:000566727500008,
Author = {Fuentes Nieto, Catalina and Lopez Velandia, Cristian Camilo},
Title = {Coverage Transformations Analysis of Tibanica Urban Wetland, Locality
   ofBosa, Bogota D. C.},
Journal = {TERRITORIOS},
Year = {2020},
Number = {43},
Abstract = {The present study analyzed the land coverage transformations developed
   in the Tibanica urban wetland, through the identification,
   classification and quantification of land coverage using aerial
   photographs from 1993 to 2015. The results indicate a predominance of
   the coverages associated with human actions such as urban green areas
   and continuous urban fabric, and a decrease in those related to natural
   areas such as water bodies. From statistical analysis, the negative
   association between the population increase and urbanized area, also the
   reduction of the more natural type of coverage was corroborated,
   evidencing that urbanization processes increase in the study area has
   led the coverage reduction, such as lakes, lagoons and swamps, clean
   pastures, channels and secondary vegetation.},
