@article{ WOS:001518914700015,
Author = {Fatemi, Md. Nawrose and Rahman, Tahmina and Shawpnil, S. M. Ehsan Ul
   Haque and Ahmed, Iftekhar Uddin},
Title = {Assessing the restoration criteria for an urban `canal daylighting': the
   context of Begunbari Canal, Dhaka, Bangladesh},
Journal = {BLUE-GREEN SYSTEMS},
Year = {2025},
Volume = {7},
Number = {1},
Pages = {15-29},
Month = {JUN},
Abstract = {Due to the rapid urbanization and expansion of cities, many urban
   waters, such as canals and streams, have disappeared from the surface in
   metropolitan areas like Dhaka. Identifying the potential socioeconomic
   and ecological value of these long-lost urban waters, particularly to
   ensure urban resilience, efforts to restore these streams are being
   emphasized as a prevalent practice in green-blue infrastructure design.
   The Begunbari Canal was strategically interconnected to the eastern
   fringe, central, and western parts of Dhaka and served as a crucial
   outlet for drainage and stormwater, making it geographically and
   environmentally vital for the city. This study intends to restore the
   Begunbari Canal of Central Dhaka by de-culverting it and to assess the
   restoration criteria for this particular `canal daylighting' initiative.
   It has been conducted as a mixed-method research approach through
   historical and contextual analysis, map regression, thematic analysis,
   experts' opinions, transect walks, and photographic documentation to
   explore the criteria and possibilities for resurfacing the Begunbari
   Canal. Findings reveal the possibilities of resurrecting the forgotten
   presence of this buried canal, indicating a set of guidelines for its
   resurfacing. These insights will benefit policymakers, urban planners,
   urban designers, and local citizens to regenerate a green-blue network
   for interconnectivity and communication.},
Publisher = {IWA PUBLISHING},
