Pages = {310-335},
Month = {JUL-DEC},
Abstract = {The Argentinian poet and revolutionary activist Alberto Szpunberg
   (1940-2020) published Su fuego en latibieza in Barcelona in 1981, after
   going into exile in 1977. This book begins a second cycle of his work,
   in which his exile condition will be central to his writing. In this
   paper we wil analyze the way in which affects participate in the
   writer's work, focusing on the poems of degrees Exilio en
   elMasnou{''}.In these texts, the affective dimension offers a reading
   key as long as it configures a scenario in which melancholy and defeat
   coexist with optimism and warmth.},
