Title = {Validity and Reliability of Cultural Mix Coping Inventory for Stressful
   Situations among Healthcare Professionals in Ghana Amidst COVID-19},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
