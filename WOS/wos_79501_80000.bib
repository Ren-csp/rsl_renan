@article{ WOS:001680187400001,
Author = {Gervais, Christine and Pomerleau, Andreanne and Chaut, Jeanne and
   Barette, Flavy and Merry, Lisa and Cote, Isabel},
Title = {``A family is an angel{''}: Immigrant children's representations of
   family},
Journal = {CHILDHOOD-A GLOBAL JOURNAL OF CHILD RESEARCH},
Year = {2026},
Volume = {33},
Number = {3},
Pages = {380-396},
Month = {AUG},
Abstract = {This article explores how children who have recently immigrated to Qu \&
   eacute;bec, Canada, represent the family. Using the child-centered
   approach, this qualitative study is based on semi-structured interviews
   with 43 immigrant children aged 6 to 14 years. The results reveal that
   children represent the family according to the different functions it
   plays in their lives, that is, to provide them with security, protection
   and support, and that their definition of the family is based on the
   affection and love that unites those who make up the family, shared time
   and lasting stable ties.},
