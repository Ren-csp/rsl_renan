@article{ WOS:000864774600001,
Author = {Brady, Patrick and Harnack, Lisa and Widome, Rachel and Berry, Kaitlyn
   M. and Valluri, Sruthi},
Title = {Use of the emergency food system among food insecure, low-income
   households in the United States 2015 to 2020},
Journal = {JOURNAL OF HUNGER \& ENVIRONMENTAL NUTRITION},
Year = {2023},
Volume = {18},
Number = {2},
Pages = {145-163},
Month = {MAR 4},
Abstract = {The emergency food system (EFS) is a critical part of the United States'
   social safety net. Using 2015-2020 Current Population Survey Food
   Security Supplement data, we identified trends in EFS use among food
   insecure, low-income households by estimating the probability of EFS use
   adjusting for demographics using multivariable logistic regression. From
   2015 to 2019, between 31.0\% and 34.4\% of households received emergency
   food, while 42.4\% did in 2020. EFS use did not increase in 2020
   compared to prior years for older adults and non-metropolitan
   households. Targeted outreach should be used to expand the reach of this
   resource to underserved and marginalized populations.{''}},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
