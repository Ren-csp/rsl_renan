@article{ WOS:001782975200001,
Author = {Bo, Elisabeth Bjornsson and Ertesvag, Sigrun K. and Vaaland, Grete S.},
Title = {A study of teachers' regard for adolescent perspectives in Norwegian
   upper secondary classrooms},
Journal = {TEACHING AND TEACHER EDUCATION},
Year = {2026},
Volume = {180},
Month = {OCT},
Abstract = {This study examines teachers' perceived improvement in regard for
   adolescent perspectives (RAP) among students (N = 1341) of teachers (N =
   98) participating in the evaluation of the INTERACT teacher coaching
   intervention. RAP is understood within the Teaching Through Interactions
   framework, and the study investigates its relation to students'
   psychological needs. Using an explanatory sequential mixed methods
   design, we analyzed student reports from 98 classrooms, which informed
   the selection of eight classrooms for a video-based multiplecase
   analysis. The intervention was associated with improved
   student-perceived RAP. Student reports aligned with systematic
   observations: teachers in higher-rated classrooms showed more frequent
   and varied RAP practices than those in lower-rated classrooms. The
   findings suggest that coaching may support the development of
   RAP-related practices and that student perspectives can inform teacher
   education and professional development. The findings also offer insights
   into how equity-related classroom management interactions may shape
   students' opportunities for participation, voice, and support.},
