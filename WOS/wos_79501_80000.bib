@article{ WOS:000926446000032,
Author = {Catunda, Marta Bastos and Fortunato, Ivan},
Title = {EDUCATING WITH THE HEART: A SENTIENT, POSSIBLE PATH OF TEACHING},
Journal = {REVISTA PRAXIS EDUCACIONAL},
Year = {2022},
Volume = {18},
Number = {49},
Abstract = {This unfinished text deals with affectivity, the sensitive, the ways of
   the heart in education. Unfinished in a double sense, both because of
   the incompleteness of the human being that can always develop, and
   because of the sad and too early passage of its first author, making it
   impossible for the fabric of ideas to be carried out. Even unfinished,
   it brings an important reflection on the need to be attentive to
   affections, emotions and human sensitivity before the concrete, rational
   and objective elements of life. In essence, the text discusses the
   importance of teaching, recognizing that the heart is much more human
   than reason.},
