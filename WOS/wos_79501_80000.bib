   Wolfe, Sarah E., Royal Rd Univ, Sch Environm \& Sustainabil, Victoria, BC V9B 5Y2, Canada.},
DOI = {10.3390/su17167511},
Article-Number = {7511},
EISSN = {2071-1050},
Keywords = {emotions; marine conservation; rationality; ocean governance; marine
   protection; human dimensions},
