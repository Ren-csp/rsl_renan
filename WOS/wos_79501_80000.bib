@article{ WOS:000553211100001,
Author = {Fu, Xiaoxiao and Lin, Bingna and Wang, Yao-Chin and Sun, Yanyan},
Title = {Memorable Boat Show Experiences: Examining the Mechanisms of Value and
   Mianzi from the Perspective of High-end Chinese Attendees},
Journal = {JOURNAL OF CHINA TOURISM RESEARCH},
Year = {2021},
Volume = {17},
Number = {3},
Pages = {415-436},
Month = {JUL 3},
Abstract = {This study proposes an integrative framework to describe the
   relationships between memorable boat show experiences, perceived value
   (utilitarian and hedonic), mianzi (desire to gain and fear of losing),
   and loyalty intention. A paper questionnaire administrated at a boat
   show in Xiamen, China. The results of the study indicate that boat shows
   experience dimensions positively affect the mechanisms of value and
   mianzi while physiography only positively influences perceived
   utilitarian value and hedonic value. In addition, quality of service
   negatively affects fear of losing mianzi. This study further reveals
   that exhibition activity contributes to the desire to gain mianzi, and
   then loyalty intention. The findings advance understanding of an
   emerging market and offer managerial implications for boat show
   experience marketing and management.},
