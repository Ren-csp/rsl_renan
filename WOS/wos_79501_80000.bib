DOI = {10.3390/su6074369},
EISSN = {2071-1050},
Keywords = {limiting access to disaster relief funds; reducing vulnerability;
   tropical storms Sandy and Irene},
Keywords-Plus = {CLIMATE-CHANGE; RISK; TRUST; COMMUNICATION; SEPTEMBER-11; PERCEPTIONS},
Research-Areas = {Science \& Technology - Other Topics; Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Green \& Sustainable Science \& Technology; Environmental Sciences;
   Environmental Studies},
Author-Email = {mrg@rci.rutgers.edu
