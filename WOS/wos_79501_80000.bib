@article{ WOS:000870125100001,
Author = {Sthapit, Erose and Bjork, Peter and Coudounaris, Dafnis N. and
   Jimenez-Barreto, Jano},
Title = {Memorable Halal Tourism Experience and Its Effects on Place Attachment},
