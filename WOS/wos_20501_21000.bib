@article{ WOS:001823846900001,
Author = {Francis, Buhle and Shackleton, Charlie M.},
Title = {Impacts of Lantana camara invasion on livelihoods: Household
   perceptions from the Kavango Zambezi Transfrontier Conservation Area,
   Zimbabwe},
Journal = {BIOLOGICAL INVASIONS},
Year = {2026},
Volume = {28},
Number = {8},
Month = {JUL 19},
Abstract = {Invasive alien plants (IAP) affect rural livelihoods in both positive
   and negative ways, yet few studies examine how these impacts are
   distributed across households and contribute to vulnerability. This
   study assessed Impacts of Lantana camara invasion on livelihoods:
   Household perceptions from the Kavango Zambezi Transfrontier
   Conservation Area, Zimbabwe. We conducted 300 household surveys and two
   focus group discussions with elders across four wards invaded by L.
   camara and evaluated household vulnerability using a vulnerability
   score. Elders reported that L. camara first invaded one ward in 1942 and
   spread to the others within 16 years, encroaching on grazing and arable
   lands, reducing livestock forage and crop productivity, and affecting
   livelihoods. While providing ecosystem services such as material for
   live fences, mosquito repellent, fruits, firewood, ornaments, and
   poultry protection, it also imposed losses associated with eradication
   efforts, loss of indigenous plants, forage shortages, and the harbouring
   of rodents and snakes. Households reported mean annual livelihood losses
   of approximately US\$483 and gains of about US\$716. These estimates are
   perception-based and should be interpreted as indicative of
   household-level livelihood trade-offs rather than precise economic
   values. Despite some households reporting substantial gains, these were
   unevenly distributed, with most households (62\%) experiencing net
   negative outcomes. Most households (58\%) were at moderate risk from
   invasion, while a few (2\%) faced extreme risk. These findings highlight
   a complex socio-economic landscape in which some households gain while
   others lose, suggesting that management strategies should account for
   both gains and losses to avoid disadvantaging vulnerable groups.},
