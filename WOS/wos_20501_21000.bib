@article{ WOS:000913323400001,
Author = {Gutting, Alicia},
Title = {What is good drinking water? 41 Years of risk perception on water
   quality in the vicinity of the Nuclear Research Centre Karlsruhe,
   1956-1997},
Journal = {RISK HAZARDS \& CRISIS IN PUBLIC POLICY},
Year = {2023},
Volume = {14},
Number = {4},
Pages = {343-365},
Month = {DEC},
Abstract = {This article traces the historical evolution of risk perception around
   the Nuclear Research Centre Karlsruhe, Germany, from 1956 to 1997. It
   does so by targeting the evolution of water-related risks. Federal hopes
   in the postwar era that the Nuclear Research Centre would bring progress
   and prosperity clashed with local values and local perception of nuclear
   engineering as dangerous to health and the environment. Various
   conflicts arose and opponents made use of their past lived-knowledge to
   foster their arguments against future decision-making, mobilizing
   stories from the past to shape the future. The conflict culminated in
   the 1990s, when the municipality decided to lease the Centre's
   waterworks for future drinking water supply. The main argument of the
   article is that even though the public discourse shifted over the years
   from water pollution toward greater risks such as nuclear meltdowns, the
   local risk perception stayed with the water-related risks. The article
   shows how the locals perceived and narrated their risk perception
   against the decision-making of authorities as well as against the
   reasoning of scientists and experts.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Gutting, A (Corresponding Author), KTH Royal Inst Technol, Div Hist Sci Technol \& Environm, Stockholm, Sweden.
   Gutting, Alicia, KTH Royal Inst Technol, Div Hist Sci Technol \& Environm, Stockholm, Sweden.},
DOI = {10.1002/rhc3.12265},
EarlyAccessDate = {JAN 2023},
