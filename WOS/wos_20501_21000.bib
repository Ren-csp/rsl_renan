@article{ WOS:001185585300004,
Author = {Dunlop, Thomas and Khojasteh, Danial and Cohen-Shacham, Emmanuelle and
   Glamore, William and Haghani, Milad and van den Bosch, Matilda and
   Rizzi, Daniela and Greve, Peter and Felder, Stefan},
Title = {The evolution and future of research on Nature-based Solutions to
   address societal challenges},
Journal = {COMMUNICATIONS EARTH \& ENVIRONMENT},
Year = {2024},
Volume = {5},
Number = {1},
Month = {MAR 15},
Abstract = {Nature-based Solutions are recognised for their potential to address the
   biodiversity and climate crises, and less extensively, other societal
   challenges. However, this nature-society relationship is becoming more
   important as available food and water resources, income, and human
   health, are increasingly impacted by environmental changes. Here, we
   utilise the seven major societal challenges addressed by Nature-based
   Solutions according to the International Union for Conservation of
   Nature, to identify the primary themes of the Nature-based Solutions
   research landscape from 1990-2021. We evaluate how these themes, with
   respect to the societal challenges, evolved over time, and where. Our
   findings highlight the under-representation of four societal challenges
   across the research landscape: economic and social development, human
   health, food security, and water security. We propose six research
   pathways to advance the evidence for Nature-based Solutions in these
   societal challenges, and present opportunities for future research
   programs to prioritise the needs of society, the environment, and the
   economy.
   Research on Nature-based Solutions prioritises topics related to
   biodiversity and climate change, and only to a lesser extent, topics of
   economic and social development, human health, and food and water
   security, according to a systematic analysis of research published in
   the past 30 years.},
