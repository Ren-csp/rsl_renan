@article{ WOS:001573301400001,
Author = {Wang, Guohai and Wang, Yanru and Zhou, Can and Zhang, Huangmin and Wei,
   Lijuan and Nong, Dengpan and Jim, Chi Yung and Zhou, Qihai},
Title = {Interaction Network Between Frugivorous Birds and Plants in Karst
   Habitats},
