@article{ WOS:000863227400006,
Author = {Atkinson, Leigh and Doyle, Rebecca E. and Woodward, Andrew and Jongman,
   Ellen C.},
Title = {Exposure to humans after weaning does not reduce the behavioural
   reactivity of extensively reared Merino lambs},
Journal = {BEHAVIOURAL PROCESSES},
Year = {2022},
Volume = {201},
Month = {SEP},
Abstract = {Human-directed fear in extensively reared sheep is often high due to the
   aversive nature of common husbandry procedures and infrequent
   interactions with humans. This study investigated whether additional
   human expo-sure provided to weaned lambs reduced human-directed fear and
   behavioural reactivity. Ninety Merino lambs were either exposed to low
   or moderately stressful human exposure sessions, or had no additional
   human contact, and their fear responses and behavioural reactivity to
   humans, a startle stimulus and confinement were tested. Overall, the
   imposed interventions did not reduce behavioural reactivity during these
   tests, suggesting fear towards humans had not been altered.},
