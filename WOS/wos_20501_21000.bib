@article{ WOS:001825414500001,
Author = {Sobieraj, Kacper and Majchrzak, Magdalena and Grewling, Lukasz and
   Bogawski, Pawel},
Title = {Tree-level prediction of Platanus pollen release onset using
   field and remote sensing phenology},
Journal = {REMOTE SENSING APPLICATIONS-SOCIETY AND ENVIRONMENT},
Year = {2026},
Volume = {43},
Month = {AUG},
Abstract = {Green spaces provide benefits to city inhabitants; however, when poorly
   designed, they may negatively affect well-being. Plane trees (Platanus
   spp.) are commonly planted in cities and release large amounts of
   allergenic pollen. Their flowering timing is crucial for high-resolution
   pollen concentration forecast. We investigated Platanus flowering
   phenology along an urban-rural gradient in Poznan, Poland, using
   observations of 418 trees at 21 sites (spring 2025) and weekly UAV
   multispectral orthophotomaps from three sites. The earliest flowering
   was observed in the city center (April 15), while the latest occurred in
   rural sites (April 21). Flowering onset was significantly negatively
   correlated with Land Surface Temperature (LST) derived from Landsat
   imagery (p < 0.01, rho = -0.30) and with the Normalized Difference
   Built-up Index (NDBI) from Sentinel-2 data (p <0.01, rho = -0.57). Using
   UAV and PlanetScope imagery, we calculated tree-specific vegetation
   index rise thresholds defined as the increase in vegetation index values
   observed three days before pollination onset relative to each tree's
   seasonal minimum. Time series were smoothed to simulate operational
   conditions with access only to past data. Thresholds were
   cross-validated between sites to evaluate predictive performance. Mean
   absolute error was 7.6 days for the satellite-based Normalized
   Difference Vegetation Index (NDVI) and 5.07 days for two-band Enhanced
   Vegetation Index (EVI2); calibration with NDBI reduced errors to 6.37
   and 4.75 days. Urban trees exhibited higher threshold values, likely due
   to faster leaf development relative to reproductive phenology.
   Higher-resolution UAV data showed potential for improving flowering
   onset detection. This study highlights urban-driven variation in
   Platanus phenology and the potential of remote sensing for predicting
   flowering onset.},
