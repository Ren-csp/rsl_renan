@article{ WOS:001768891700001,
Author = {Abou-Eid, Naglaa Fathy Sayed Ahmed},
Title = {Early Childhood Environmental radiobiology education: Cultivating
   radiation safety habits through the ``Little Guardians{''} program in
   Saudi preschools},
Journal = {JOURNAL OF RADIATION RESEARCH AND APPLIED SCIENCES},
Year = {2026},
Volume = {19},
Number = {2},
Month = {JUN},
Abstract = {Background: Environmental radiobiology increasingly emphasizes how
   everyday routines formed in early childhood shape lifelong exposure
   patterns, yet evidence-based preschool programs that integrate
   environmental responsibility with basic radiation-safety education
   remain scarce, especially in developing countries. Objective: This study
   evaluated the ``Little Guardians: Preschool Environmental \&
   Radiation-Safety Routines{''} program as an educational intervention
   designed to apply environmental radiobiology principles in an
   age-appropriate, behavior-focused context. Methods: A mixed-methods
   randomized controlled trial was conducted with 60 preschool children
   (aged 5-6 years) in Majmaah, Saudi Arabia. The experimental group (n =
   30) received ten interactive ``Little Guardians{''} sessions over five
   weeks, while the control group (n = 30) followed the regular curriculum.
   Outcomes were assessed at pre-test, post-test, and two-month follow-up
   using the Child Environmental and Radiation-Safety Awareness Scale
   (CERSA), the Caregiver Environmental Practice Questionnaire (CEPQ), the
   Teacher Behavioral Observation Log (TBOL), and semi-structured
   interviews with teachers and principals. Results: Compared to controls,
   the experimental group showed statistically significant gains in
   environmental and radiation-safety awareness and eco-safety behaviours
   at post-test, which were maintained at two-month follow-up. Caregiver
   reports confirmed the transfer and retention of routines in home
   settings. Qualitative findings highlighted children's increased
   curiosity and self-regulation, teachers' positive perceptions of
   feasibility, and persistent curricular and resource gaps in
   sustainability and radiation-safety education. Conclusions: Embedding
   age-appropriate environmental and radiation-safety content within
   preschool routines, supported by home-school continuity, can effectively
   foster eco-safety habits in young children and inform curriculum
   development aligned with the sustainability goals of Saudi Vision 2030.},
