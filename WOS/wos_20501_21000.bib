@article{ WOS:000673284100009,
Author = {Contijoch Torres, Marta and Martinez Alguero, Romina and Ruiz, Manuel
   Delgado},
Title = {KLANDOS AND JAKARTAS. RETHINKING ``INFORMALITY{''} AND
   ``PUBLIC SPACE{''} FROM TWO MOBILITY SYSTEMS IN LOWER
   CASAMANCE, SENEGAL},
Journal = {AIBR-REVISTA DE ANTROPOLOGIA IBEROAMERICANA},
Year = {2021},
Volume = {16},
Number = {2},
Pages = {398-418},
Month = {MAY-AUG},
Abstract = {This article presents and analyses a series of social processes by which
   both the unregulated shared taxi system - klandos - and the motorbike
   taxi system - jakartas - operate within the dynamics of movement in the
   historical and natural region of Lower Casamance (Senegal). Focusing on
   Ziguinchor, the principal town, it looks in detail at the rationale
   behind these processes and opens up a critical discussion on the notion
   of ``informality{''} as it is applied to urban African contexts. We
   examine both daily and ambivalent links between an apparently illegal
   public service and the state which tolerates, and even protects it,
