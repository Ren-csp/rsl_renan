@article{ WOS:001744822200001,
Author = {Woodbridge, Bethany and Tremblay, Crystal and Spalding, Pamela and
   Castle, David and Shaffer, Eva},
Title = {``Where would we be without cedar?{''}: Indigenous environmental value
   systems through participatory mapping with T'Sou-ke First Nation},
Journal = {FACETS},
Year = {2026},
Volume = {11},
Month = {APR 15},
Abstract = {Assessment of environmental value frequently overlooks the complex ways
   of viewing, valuing, and interacting with the land held by Indigenous
   ways of knowing. This article describes a participatory mapping case
   study conducted in partnership with T'Sou-ke (SO, EC) First Nation on
   Vancouver Island, British Columbia exploring the values associated with
   the natural environment of T'Sou-ke territory through the lens of cedar
   trees (Western Redcedar-Thuja plicata Donn ex D. Don;
   Yellow-cedar-Callitropsis nootkatensis (D. Don) Oerst. ex D.P. Little).
   Cedar was identified through early engagement as highly culturally
   significant and of immediate interest for T'Sou-ke Nation. Two
   participatory mapping workshops were held with T'Sou-ke leadership,
   administration, and community members, as well as one semi-structured
   interview with a key knowledge holder from T'Sou-ke Nation government.
   All material collected was analyzed through qualitative coding, through
   which eight forms of environmental value associated with cedar trees and
   the ecology of T'Sou-ke territory were identified. These findings
   highlight the diversity of possible environmental benefits which are
   excluded by valuation models based exclusively on Western perceptions of
   environmental value. We argue that centering Indigenous knowledges into
   environmental valuation frameworks is essential for a comprehensive
   understanding of ecological systems and more holistic environmental
   management practices.},
