Author = {Dennis, Sarah and Paz, Alexander and Yigitcanlar, Tan},
Title = {Perceptions and Attitudes Towards the Deployment of Autonomous and
   Connected Vehicles: Insights from Las Vegas, Nevada},
Journal = {JOURNAL OF URBAN TECHNOLOGY},
