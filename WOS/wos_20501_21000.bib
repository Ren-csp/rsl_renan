@article{ WOS:000440951400003,
Author = {Hawkins, Melissa and James, Chris},
Title = {Developing a perspective on schools as complex, evolving, loosely
   linking systems},
Journal = {EDUCATIONAL MANAGEMENT ADMINISTRATION \& LEADERSHIP},
Year = {2018},
Volume = {46},
