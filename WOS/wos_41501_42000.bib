@article{ WOS:001246427100004,
Author = {Buxton, Rachel T. and Hudgins, Emma J. and Lavigne, Eric and Villeneuve,
   Paul J. and Prince, Stephanie A. and Pearson, Amber L. and Halsall,
   Tanya and Robichaud, Courtney and Bennett, Joseph R.},
Title = {Mental health is positively associated with biodiversity in Canadian
   cities},
Journal = {COMMUNICATIONS EARTH \& ENVIRONMENT},
Year = {2024},
Volume = {5},
Number = {1},
Month = {JUN 11},
Abstract = {Cities concentrate problems that affect human well-being and
   biodiversity. Exploring the link between mental health and biodiversity
   can inform more holistic public health and urban planning. Here we
   examined associations between bird and tree species diversity estimates
   from eBird community science datasets and national forest inventories
   with self-rated mental health metrics from the Canadian Community Health
   Survey. We linked data across 36 Canadian Metropolitan Areas from
   2007-2022 at a postal code level. After controlling for covariates, we
   found that bird and tree species diversity were significantly positively
   related to good self-reported mental health. Living in a postal code
   with bird diversity one standard deviation higher than the mean
   increased reporting of good mental health by 6.64\%. Postal codes with
   tree species richness one standard deviation more than the mean
   increased reporting of good mental health by 5.36\%. Our results suggest
   that supporting healthy urban ecosystems may also benefit human
   well-being.
   In neighborhoods with high bird diversity and tree species richness,
   residents report better mental health, according to an analysis
   combining population surveys, mental health indicators, bird species,
   and greenness data across 36 Canadian cities.},
Publisher = {SPRINGERNATURE},
