@article{ WOS:001112407700001,
Author = {Kavana, David J. and Mbije, Nsajigwa and Sirilo, Tecla M. and Bupamba,
   Happiness C.},
Title = {The spatio-temporal influences of habitat heterogeneity on the community
   structure of avian feeding guilds in human-dominated landscapes of the
   East African miombo woodlands},
Journal = {AFRICAN JOURNAL OF ECOLOGY},
Year = {2024},
Volume = {62},
Number = {1},
Month = {JAN},
Abstract = {Habitat heterogeneity plays a vital ecological role in influencing
   community ecology dynamics. We evaluated the relationship between
   habitat heterogeneity and land-use cover with avian community structure
   in the human-dominated landscape of the Katavi-Rukwa ecosystem in
   Tanzania. We used the fixed-radius point count method to record birds in
   different habitats. We calculated the relative abundances and the
   Shannon-Wiener diversity index of bird guilds across habitats as well as
   the Normalised Difference Vegetation Index (NDVI) and estimated land-use
   cover of the study area from Landsat 8 images. We grouped birds into
   five major guilds: Insectivore, Granivore, Omnivore, Carnivore and
   Nectarivore. Among the guilds, Insectivores, Omnivores, Nectarivores and
   Carnivores were positively correlated with an increase in NDVI, while
   Granivores were negatively correlated with an increase in NDVI. Among
   the habitats, woodland had high species diversity whereas riverine had
   low species diversity. Our findings highlight the importance of habitat
   heterogeneity in biodiversity conservation in human-dominated
   landscapes, and we suggest implementing conservation in these
   landscapes.
   L'heterogeneite de l'habitat joue un role ecologique essentiel en
   influencant la dynamique de l'ecologie des communautes. Nous avons
   evalue la relation entre l'heterogeneite de l'habitat et la couverture
   de l'utilisation des terres avec la structure de la communaute aviaire
   dans le paysage domine par l'homme de l'ecosysteme de Katavi-Rukwa en
   Tanzanie. Nous avons utilise la methode de comptage par points a rayon
   fixe pour enregistrer les oiseaux dans differents habitats. Nous avons
   calcule les abondances relatives et l'indice de diversite de
   Shannon-Wiener des guildes d'oiseaux dans les differents habitats, ainsi
   que l'indice de vegetation par difference normalisee (NDVI) et estime la
   couverture de l'utilisation des sols dans la zone d'etude a partir
   d'images Landsat 8. Nous avons regroupe les oiseaux en cinq grandes
   guildes : Insectivore, granivore, omnivore, carnivore et nectarivore.
   Parmi les guildes, les insectivores, les omnivores, les nectarivores et
   les carnivores presentaient une correlation positive avec une
   augmentation du NDVI, tandis que les granivores presentaient une
   correlation negative avec une augmentation du NDVI. Parmi les habitats,
   les zones boisees presentaient une grande diversite d'especes, tandis
   que les zones riveraines presentaient une faible diversite d'especes.
   Nos resultats soulignent l'importance de l'heterogeneite de l'habitat
   pour la conservation de la biodiversite dans les paysages domines par
   l'homme, et nous suggerons la mise en oe uvre la conservation dans ces
   paysages.},
