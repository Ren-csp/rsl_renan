@article{ WOS:001606167900001,
Author = {Lukawiecki, J. and Jeddore, G. and Roth, R. and Moola, F.},
Title = {Practicing ``Netukulimk{''}: Indigenous governance of culturally
   significant species in Ktaqamkuk (Newfoundland, Canada)},
Journal = {FACETS},
Year = {2025},
Volume = {10},
Pages = {1-15},
Month = {OCT 22},
Abstract = {Indigenous-led conservation is as an effective and just alternative to
   state-led approaches, such as parks and protected areas, which can
   displace and dispossess Indigenous Peoples from their traditional lands
   and territories. Unlike institutional structures and processes,
   Indigenous-led conservation typically employs biocultural principles and
   practices that emphasize both biodiversity and human wellbeing outcomes.
   In this study, we worked with Miawpukek First Nation to document the
   biocultural dimensions of Indigenous-led conservation for culturally
   significant species (CSS) in Ktaqamkuk (Newfoundland, Canada). We
   identified a list of CSS in interviews with Elders, harvesters, and
   Indigenous Guardians and a suite of biocultural indicators associated
   with their stewardship under governance principles associated with the
   Mi'kmaq concept of Netukulimk. This study provides insights on how the
   Indigenous governance of CSS strengthens the reciprocal relationships
   that Indigenous Peoples have with wild species, including support for a
   diverse suite of biocultural values and outcomes, such as the
   revitalization of Indigenous Knowledge, languages and customary
   practices linked to nature. By supporting Indigenous systems of
   environmental governance, such as Indigenous Protected and Conserved
   Areas (IPCAs) and Territories of Life, civil-society organizations,
   researchers, and policymakers can support a more holistic approach to
   conservation that is inclusive of both biological and human wellbeing
   objectives.},
