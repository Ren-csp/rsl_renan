@article{ WOS:001320736900001,
Author = {Onencan, Abby Muricho and Bisschop, Lieselot and Hendlin, Yogi},
Title = {Experiences of living within PFAS-polluted environs: a systematic review},
Journal = {CRIME LAW AND SOCIAL CHANGE},
