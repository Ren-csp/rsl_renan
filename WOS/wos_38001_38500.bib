DOI = {10.17645/si.v8i4.3282},
EISSN = {2183-2803},
Keywords = {border work; ethnography; exclusion; phenomenology; radicalization;
   refugee crisis; right-wing activism},
Keywords-Plus = {ANTHROPOLOGY; POLITICS},
Research-Areas = {Social Issues; Social Sciences - Other Topics},
