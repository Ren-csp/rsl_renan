@article{ WOS:000382755000003,
Author = {Andrade, Lucas Goulart and Braga, Debora Cordeiro and Tomazzoni, Edegar
   Luis},
Title = {LEISURE DEMOCRATIC SPOTS AND MANAGEMENT OF COMMUNITY CLUBS (CCs) OF SAO
   PAULO CITY},
