@article{ WOS:001567352600001,
Author = {Arango-Quiroga, Johan and Kuhl, Laura and MacGoy, Devin},
Title = {Energy equity, transitions, and futures: Photovoice insights from Latinx
   community members in Boston},
Journal = {ENERGY RESEARCH \& SOCIAL SCIENCE},
Year = {2025},
Volume = {127},
Month = {SEP},
Abstract = {Energy equity remains a pressing issue in urban areas, particularly for
   marginalized communities like Boston's Latinx population. This study
   examines energy equity and futures through photovoice, a participatory
   method where participants document their lived experiences using
   photography. In collaboration with GreenRoots, a grassroots organization
   dedicated to environmental justice in Chelsea and East Boston,
   participants identified daily inequities, expressing how these
   challenges shape community priorities for energy futures. We found
   distributional inequalities with demonstratable spatial manifestations,
   highlighting how local energy infrastructure contributes to
   environmental burdens and fails to meet participants' needs. Unequal
   access to renewables, disparate light distribution, and
   poorly-maintained infrastructure were key concerns where stark contrasts
   emerged between these neighborhoods, gentrified areas, and Downtown
   Boston. We found that fears about safety, unreliable energy
   infrastructure, and risks like fires shaped participants' visions for
   the future. Participants expressed frustrations over how they felt their
   voices did not matter concerning siting energy infrastructure or issues
   that impact renters. Notably, participants avoided photographing East
   Boston's substation, conveying a strong message of opposition to its
   presence in their neighborhood. Participants identified six themes for a
   more equitable energy future: 1) green spaces, 2) better lighting, 3)
   parity with places enjoying energy-related benefits, 4) reliable energy
   provision, 5) fair pricing through energy efficiency and renewables, and
   6) prioritizing community input. By reporting the energy-related
   experiences of Latinx participants of our study in Greater Boston, these
   findings underscore how photovoice can provide insights and concrete
   recommendations to contribute to ongoing efforts to build energy equity.},
