@article{ WOS:000259712400011,
Author = {Ball, Kylie and Jeffery, Robert W. and Crawford, David A. and Roberts,
   Rebecca J. and Salmon, Jo and Timperio, Anna F.},
Title = {Mismatch between perceived and objective measures of physical activity
   environments},
Journal = {PREVENTIVE MEDICINE},
