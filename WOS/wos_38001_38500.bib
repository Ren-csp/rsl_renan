@article{ WOS:001274453100001,
Author = {Kawasaki, Takayasu and Nagase, Atsushi and Hayakawa, Ken and Teshima,
   Fumitsuna and Tanaka, Kiyohisa and Zen, Heishun and Irizawa, Akinori and
   Sakai, Takeshi and Hayakawa, Yasushi},
Title = {Investigating structural property of human hair by using infrared free
   electron lasers},
Journal = {DISCOVER APPLIED SCIENCES},
Year = {2024},
Volume = {6},
Number = {8},
Month = {JUL 22},
Abstract = {Intense infrared (IR) rays can heat matters and evaporate waters
   thermally. One of the possible applications will be hair dryer, although
   the irradiation effects of IR rays on the hair have not been fully
   explored. In this study, we first examined the interaction of IR rays at
   various wavelengths from 3.0 mu m (near IR) to 90 mu m (far IR) with the
   surface structure of human hair by using IR free electron lasers (FELs).
   IR-FEL is an accelerator-based pico-second pulse laser, and the feature
   is the wavelength-tunability with the high-photon density. When one
   thread of hair was irradiated by the FEL of 6-7 mJ energy at 60 mu m,
   the cleavage occurred, and the morphological destruction was observed on
   scanning-electron microscopy images after the irradiations at 70 mu m
   and 6.1 mu m (amide I). Synchrotron-radiation infrared microspectroscopy
   showed that those FEL irradiations decreased a shoulder band at 1710
   cm-1 that corresponds to carboxyl group in melanin or fatty acids and
   increased absorption intensity at 500-600 cm-1. On the contrary, the FEL
   at 90 mu m little changed either the surface morphology or the infrared
   absorption spectra. Interestingly, near-IR FELs at 3.0-3.5 mu m induced
   bending of a hair, and 2D mapping of protein secondary conformations
   revealed that beta-sheet was more increased than the other conformations
   on the surface of the bending area even at low pulse energy (1-3 mJ). As
   a result, the structural damage of the hair was least at 90 mu m, which
   implies an ideal wavelength for drying hair mildly.
   A unique assessment of hair structure is demonstrated by using
   accelerator-based infrared laser system. A new far-infrared wavelength
   for drying hair softly is discovered by this research.Applicability of
   accelerator-based infrared laser for activities of human life is first
   shown by this research.},
