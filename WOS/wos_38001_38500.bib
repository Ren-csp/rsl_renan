@article{ WOS:001211127200007,
Author = {Hu, Wenxin and Song, Alex and Zheng, Hongjin},
Title = {Substrate binding plasticity revealed by Cryo-EM structures of SLC26A2},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {APR 29},
Abstract = {SLC26A2 is a vital solute carrier responsible for transporting essential
   nutritional ions, including sulfate, within the human body. Pathogenic
   mutations within SLC26A2 give rise to a spectrum of human diseases,
   ranging from lethal to mild symptoms. The molecular details regarding
   the versatile substrate-transporter interactions and the impact of
   pathogenic mutations on SLC26A2 transporter function remain unclear.
   Here, using cryo-electron microscopy, we determine three high-resolution
   structures of SLC26A2 in complexes with different substrates. These
   structures unveil valuable insights, including the distinct features of
   the homodimer assembly, the dynamic nature of substrate binding, and the
   potential ramifications of pathogenic mutations. This
   structural-functional information regarding SLC26A2 will advance our
   understanding of cellular sulfate transport mechanisms and provide
   foundations for future therapeutic development against various human
   diseases.
   SLC26A2 transports crucial ions and mutations in it cause diverse
   diseases. Here, authors present cryo-EM structures of SLC26A2 with
   substrates, revealing details of its homodimer assembly, dynamic
   substrate binding, and effects of mutations.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Zheng, HJ (Corresponding Author), Univ Colorado Anschutz Med Campus, Sch Med, Dept Biochem \& Mol Genet, Aurora, CO 80045 USA.
   Hu, Wenxin; Song, Alex; Zheng, Hongjin, Univ Colorado Anschutz Med Campus, Sch Med, Dept Biochem \& Mol Genet, Aurora, CO 80045 USA.},
DOI = {10.1038/s41467-024-48028-3},
Article-Number = {3616},
EISSN = {2041-1723},
Keywords-Plus = {DYSPLASIA SULFATE TRANSPORTER; GENERAL FORCE-FIELD; ANION TRANSPORTERS;
   CRYSTAL-STRUCTURE; EXPRESSION; MECHANISM; FAMILY; VALIDATION; LIPIDS},
