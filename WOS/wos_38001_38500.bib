@article{ WOS:001551829800015,
Author = {Du, Yuxia and Li, Mingjie},
Title = {Research on the impact of digital infrastructure construction on
   enterprise carbon emissions},
Journal = {SCIENTIFIC REPORTS},
Year = {2025},
Volume = {15},
Number = {1},
Month = {AUG 16},
Abstract = {This paper uses the data of Chinese cities and A-share listed companies
   from 2010 to 2022 and utilizes the implementation of Broadband China as
   a quasi-natural experiment to assess the impact of digital
   infrastructure construction, as exemplified by Broadband China, on
   enterprise carbon emissions. By applying the difference-in-differences
   method, the findings indicate that developing digital infrastructure can
   help reduce carbon emissions in enterprises. This reduction is achieved
   primarily by improving the efficiency of energy utilization in urban
   areas and enhancing corporate green technological innovation.
   Additionally, the impact of digital infrastructure on lowering carbon
   emissions varies by corporation and region.},
