@article{ WOS:001794136400001,
Author = {Iwasaki, Yuichi and Shibata, Yukie and Soga, Masashi},
Title = {How much protection is enough? Public preferences for aquatic life
   protection in water quality standards},
Journal = {INTEGRATED ENVIRONMENTAL ASSESSMENT AND MANAGEMENT},
Year = {2026},
Month = {2026 JUN 16},
Abstract = {Understanding what people value and wish to protect is crucial for
   effective environmental management, including ecological risk management
   for chemicals. However, it remains unclear which levels of biological
   organization the public believes should be protected. We conducted an
   online survey across Japan (n = 1,211), in which participants were asked
   to choose their preferred level of biological protection-ranging from
   the sub-individual (e.g., DNA or cellular damage) to the community
   level-when water quality standards are set for the conservation of
   aquatic life. Rather surprisingly, over half of the respondents selected
   the sub-individual level of protection, suggesting a preference for a
   stricter protection level than those commonly accepted in actual
   management (i.e., the population level or higher). Individuals with
   stronger conservation attitudes, a greater perceived risk of chemicals,
   a stronger connection to nature, a stronger ability to identify species,
   and older age were more likely to prefer stricter protection standards.
   Our findings suggest that regulators and environmental managers should
   recognize and address the gap between public preferences for biological
   protection levels and the protection goals commonly adopted in
   environmental management, particularly in stakeholder engagement
   settings.
   Key points More than half of respondents preferred the strictest
   protection level, aiming to prevent even DNA or cellular damage rather
   than the population- or higher-level protection typically used in
   management.Only a small proportion of respondents selected population-
   or higher-level protection, highlighting a gap between public
   preferences and current regulatory practices.Preferences for stricter
   protection were associated with psychological factors, species
   identification ability, and age.Regulators and environmental managers
   should recognize and address the gap between public preferences for
   biological protection levels and the protection goals commonly adopted
   in environmental management.},
