@article{ WOS:000461419200006,
Author = {Horvath, Gergo and Egyed, Orsolya and Tang, Changguo and Kovacs, Mihaly
   and Micsonai, Andras and Kardos, Jeasef and Toke, Orsolya},
Title = {Ligand entry in human ileal bile acid-binding protein is mediated by
   histidine protonation},
Journal = {SCIENTIFIC REPORTS},
Year = {2019},
Volume = {9},
Month = {MAR 18},
Abstract = {Human ileal bile acid-binding protein (hl-BABP) has a key role in the
   intracellular transport of bile salts. To explore the role of histidine
   protonation in the binding process, the pH-dependence of bile salt
   binding and internal dynamics in hl-BABP was investigated using NMR
   spectroscopy and biophysical tools. Thermodynamic and kinetic
   measurements show an increase in the overall binding affinity and the
   association rate constant of the first binding step below the pK(a) of
   the histidines, suggesting that ligand binding is favoured by the
   protonated state. The overlap between residues exhibiting a high
   sensitivity to pH in their backbone amide chemical shifts and protein
   regions undergoing a global ms conformational exchange indicate a
   connection between the two processes. According to N-15 NMR relaxation
   dispersion analysis, the slow motion is most pronounced at and above the
   pK(a) of the histidines. In agreement with the NMR measurements, MD
   simulations show a stabilization of the protein by histidine
   protonation. Hydrogen-bonding and van der Waals interactions mediating
   the flow of information between the C/D- and G/H-turn regions hosting
   the three histidines, suggest a complex way of pH-governed allosteric
   regulation of ligand entry involving a transition between a closed and a
   more open protein state.},
