@article{ WOS:001761848700001,
Author = {Searle, Bonnie and Sawyer, Harriet and Staton, Sally and Thorpe, Karen},
Title = {Through the eyes of the educator: A `natural experiment' to examine the
   pedagogical, physiological and emotional value of access to nature in
   early education workplace environments},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {112},
Month = {JUN},
Abstract = {Natural environments affect human learning opportunities, health and
   wellbeing. Access to natural environments in Early Childhood Education
   and Care (ECEC) is particularly important as children can spend up to
   10,000 h hours in these settings before school entry - a formative time
   in human development. In ECEC, natural environments provide children
   opportunities for exploration, learning, activity and stress reduction.
   They also affect the pedagogical experiences that educators can provide,
   educator wellbeing and their attendant quality of interactions with
   children. Reduction in natural environment in ECEC likely limits
   learning opportunities and wellbeing of children and educator alike but
   this hypothesis is difficult to test. Taking a unique `natural
   experiment' in which floods necessitated a move from a large
   nature-based service to a smaller new-build site this study examined the
   effects on pedagogical, physiological and emotional experiences of
   educators through analysis of interview data. Educators reported that
   reduction in access to natural environments limited children's learning
   opportunities, their own workplace wellbeing and, notably, sense of
   connection and identity. As population increase in urban areas drives
   building of high density ECEC centres with limited natural outdoor
   space, the human effects warrant consideration in policy (service
   design, regulations and approvals) and practice (ensuring access to
   natural environments). Planning for the inclusion of nature in ECEC
   should be a priority.},
