@article{ WOS:000898604300004,
Author = {Wrotny, Marcin and Bohatkiewicz, Janusz and Bohatkiewicz-Czaicka, Joanna},
Title = {Influence of using low-noise pavements on residents' perception of road
   noise protection},
Journal = {TRANSPORTATION RESEARCH PART D-TRANSPORT AND ENVIRONMENT},
Year = {2022},
Volume = {113},
Month = {DEC},
Abstract = {This paper presents an assessment of the effectiveness of low-noise road
   pavements, as well as impressions of the inhabitants concerning the
   influence of this solution on their comfort of life. Residents were
   surveyed before and after the new pavements were installed to determine
   their subjective opinion of the change in acoustic impact caused by
   traffic. Moreover, a high annoyance index was used to illustrate the
   impact of noise reduction on the health of people living in areas
   adjacent to the analysed road sections. The aim of this study is to
   compare the subjective perception of noise reduction by residents due to
   the use of low-noise pavements with the objective form of assessment,
   which is the analysis of the high annoyance index and the value of road
   noise reduction. The results obtained show a significant improvement in
   the subjective perception of the residents after the implementation of
   the new pavements.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
