@article{ WOS:001539894500002,
Author = {O'Reilly, David and White, Marcus and Langenheim, Nano and Alambeigi,
   Pantea and Huang, Xiaoran and Yang, Tianyi},
Title = {Receiver-centric mapping of pedestrian noise annoyance: a cost-effective
   approach using random forest, psychoacoustic metrics and open-source
   data},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {130},
Month = {JUL 15},
Abstract = {This article presents a method for mapping traffic-induced noise
   annoyance from the pedestrian's perspective using Psychoacoustic {[}PA]
   metrics and open-source data. Prioritising the receiver over the source,
   the approach avoids costly traffic counts and proprietary software by
   extracting PA values from field-recorded audio and applying Random
   Forest {[}RF] modelling to extrapolate these values as a spatial
   performance indicator with robust predictive ability. The results were
   propagated using an exponential decay function, and the output is
   presented as a high-resolution GIS-based noise annoyance map for spatial
   analysis of pedestrian impacts, offering a receiver-centric alternative
   to conventional decibel-based noise mapping. Designed to inform
   walkability planning and public space design, the method reframes
   traffic noise as a pedestrian-centred impact rather than a physical
   emission. The discussion highlights its application for urban health,
   adaptation to other contexts, and the importance of considering
   walk-quality and the amenity impacts of traffic induced noise pollution
   in active transport policy. The findings show that metropolitan-scale
   annoyance mapping is feasible, affordable, and relevant to
   decision-makers seeking to improve walk quality, comfort, and safety.},
