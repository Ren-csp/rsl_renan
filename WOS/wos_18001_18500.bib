@article{ WOS:001872746800001,
Author = {Gorgoglione, Angela and Otegui, Ximena and Goliatt, Leonardo},
Title = {Integrating Machine Learning Into Environmental Engineering Education:
   Design, Implementation, and Outcomes of an Interdisciplinary Course},
Journal = {COMPUTER APPLICATIONS IN ENGINEERING EDUCATION},
Year = {2026},
Volume = {34},
Number = {5},
Month = {SEP 11},
Abstract = {As global environmental challenges intensify, engineering education
   increasingly requires approaches that integrate computational methods
   with interdisciplinary collaboration. This paper presents the design,
   implementation, and outcomes of a 5-day intensive machine learning
   course tailored to civil and environmental engineering students and
   professionals with diverse backgrounds. The course integrated
   foundational machine learning concepts with hands-on applications using
   real-world environmental datasets from Uruguay. It was designed to
   support competencies relevant to interdisciplinary engineering practice,
   including the integration of environmental reasoning with data-driven
   modeling and collaboration across diverse disciplinary backgrounds.
   Using Google Colab notebooks, students explored data preprocessing,
   supervised and unsupervised learning, and data analysis in an
   interactive, collaborative environment. Interdisciplinary teamwork was a
   core feature, enabling diverse perspectives to be brought to bear on
   solving environmental problems. The course outcomes were examined
   through three complementary perspectives: the instructors' assessment of
   how the design functioned in practice, the academic results from the
   final projects, and the students' perceptions gathered through a
   post-course survey. Particular attention was given to how collaborative
   projects and practice-oriented activities supported the integration of
   computational tools into environmental reasoning, while fostering
   interdisciplinary interaction among students with different academic
   backgrounds. These perspectives suggest that carefully designed,
   practice-oriented sessions can help students engage with computational
   thinking, create conditions for meaningful cross-disciplinary
   collaboration, and raise awareness of sustainability challenges. Beyond
   assessing a single course, the analysis identifies key strengths, such
   as improved collaboration and contextualized learning, as well as
   challenges, including disparities in prior knowledge and technical
   preparedness. These findings offer concrete lessons for future
   implementations and provide a replicable framework for embedding machine
   learning in engineering curricula, better preparing students for complex
   environmental challenges.},
