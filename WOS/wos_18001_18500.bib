Journal = {INTERNATIONAL JOURNAL OF CONSERVATION SCIENCE},
Year = {2022},
Volume = {14},
Number = {2},
Pages = {453-468},
Month = {APR-JUN},
Abstract = {This paper ?r???s?s a methodology of the attractive disclosure of the
   historical centers of small towns with highlighting the <<
   objects-performances >> as the main places of attraction and activating
   various types of << urban performance >> based on traditions, as a key
   to their revitalization and improvement of their inhabitants' life
   quality. The historical centers of the small towns of Ukrainian Volyn
