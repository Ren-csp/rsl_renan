@article{ WOS:001588978700001,
Author = {Shi, Tingting and Liu, Yuanping and Zhu, Xia and Jin, Yongtao and Zhao,
   Hongpeng and Zhang, Yu and Zhang, Yunjie},
Title = {Construction and evaluation model of ecological environment carrying
   capacity indicators of Xiong'an new area from the perspective of
   development planning},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {179},
Month = {OCT},
Abstract = {The evaluation of Ecological Environment Carrying Capacity (EECC) is
   essential for balancing urban development and ecological protection,
   particularly in rapidly developing strategic regions such as Xiong'an
   New Area. To address limitations of traditional models that overlook
   management interventions and spatiotemporal variability, this study
   adopts a development planning perspective and establishes a DPSIRM
   (DrivingForces-Pressure-State-Impact-Response-Management) based EECC
   evaluation system. A hybrid VIKORTOPSIS model with dynamic adjustment is
   applied to quantify EECC from 2017 to 2023 using multi-source
   statistical and remote sensing data. The results show that: (1) The EECC
   of Xiong'an New Area increased from 0.416 in 2017 to 0.721 in 2023. Due
   to the temporary interruption of large-scale development and
   construction and epidemic related ecological restoration measures, it
   slightly decreased in 2020 and then steadily increased. (2) The main
   influencing factors include the green coverage rate of built-up areas,
   population density, and natural population growth rate. (3) The research
   findings emphasize that achieving sustainable development requires a
   dynamic balance between ecological pressure, socio-economic benefits,
   and management strategies, providing a scientific basis for planning and
   policy-making in rapidly urbanizing areas. This study contributes to
   balancing development and ecological protection, ultimately promoting a
   modern urbanization model characterized by ``harmonious coexistence
   between humans and nature.{''}},
