@article{ WOS:000919167200005,
Author = {Lee, Sungmin and Lee, Chanam and Xu, Minjie and Li, Wei and Ory, Marcia},
Title = {People living in disadvantaged areas faced greater challenges in staying
   active and using recreational facilities during the COVID-19 pandemic},
Journal = {HEALTH \& PLACE},
Year = {2022},
Volume = {75},
Month = {MAY},
Abstract = {This study aimed to understand the perceived effects of the COVID-19
   pandemic on physical activity, recreation walking, and use of
   recreational facilities; and if the COVID-19 pandemic amplified
   disparities in physical activity, recreational walking, and use of
   recreational facilities related to the levels of neighborhood
   disadvantage. Recreational walking and the use of neighborhood streets
   and green spaces significantly decreased in high deprivation areas but
   not in low deprivation areas during the pandemic. While COVID-19 has
   negatively affected overall recreational activities, the inequitable
   impact on recreational walking and use of outdoor recreational
   facilities has been more evident in disadvantaged neighborhoods with
   greater deprivation.},
