@article{ WOS:000453339200019,
Author = {Kallio, Maarit Helena and Hogarth, Nicholas John and Moeliono, Moira and
   Brockhaus, Maria and Cole, Robert and Bong, Indah Waty and Wong, Grace
   Yee},
Title = {The colour of maize: Visions of green growth and farmers perceptions in
   northern Laos},
Journal = {LAND USE POLICY},
Year = {2019},
Volume = {80},
Pages = {185-194},
Month = {JAN},
Abstract = {The rapid expansion of hybrid maize in the uplands of northern Laos is
   viewed by the government as meeting policy aims related to green
   economic development. Yet, growing evidence of negative consequences of
   maize expansion are emerging. Based on farmers' perceptions, we study:
   (1) farmers' reasons for adopting and abandoning maize, and; (2)
   implications of commercial maize expansion on local livelihood security
   and inclusiveness (food supply, income, risk coping, and ability to join
   maize growing), and environmental sustainability (productivity, and soil
   and forest quality) over time (2013 and 2016). Results show that maize
   has advantages in terms of labour allocation, and it provides
   much-needed cash income. Yet, swidden is the main food provider and an
   essential safety net for unforeseen risks (including maize crop failures
   or price fluctuations). The way that maize was produced did not meet the
   criteria of green economic development due to its negative effects on
   the environment (soil and forest degradation) and socioeconomic
   sustainability (household differentiation, increased economic risks,
   debts, and food insecurity). By providing a local perspective, this
   study encourages a critical reflection of the underlying assumptions and
   conceptualization of the green economy approach in Laos, and argues for
   policies and measures that consider a more holistic perspective of human
   wellbeing and the environment.},
Publisher = {ELSEVIER SCI LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Kallio, MH (Corresponding Author), Univ Helsinki, Fac Agr \& Forestry, Helsinki Inst Sustainabil Sci HELSUS, Viikki Trop Resources Inst VITRI, POB 27,Latokartanonkaari 7, FI-00014 Helsinki, Finland.
   Kallio, Maarit Helena; Hogarth, Nicholas John, Univ Helsinki, Viikki Trop Resources Inst VITRI, Helsinki, Finland.
