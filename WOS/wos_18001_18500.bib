@article{ WOS:000408861800112,
Author = {Wang, Chia-Nan and Han-Khanh Nguyen},
Title = {Enhancing Urban Development Quality Based on the Results of Appraising
   Efficient Performance of Investors-A Case Study in Vietnam},
Journal = {SUSTAINABILITY},
