@article{ WOS:000771614300001,
Author = {Gutierrez-Jara, Juan Pablo and Saracini, Chiara},
Title = {Risk Perception Influence on Vaccination Program on COVID-19 in Chile: A
   Mathematical Model},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {4},
Month = {FEB},
Abstract = {The SARS-CoV-2 virus emergency prompted unprecedented safety measures,
   which were accepted by the population of each country to different
   degrees, for example, with more or less willingness to use personal
   protective elements (PPEs). We have developed a mathematical model of
   the contagion process, based on chilean data, to assess the interaction
   between biological factors (such as the impact of vaccination) and
   behavioral factors (such as the population's perception of risk). The
   model clearly shows that the virus spreads through three waves of
   contagion, the second being the most prominent, regardless of any
   alteration in the variables taken into account, which only affect the
   overall number of people infected. By considering alternative values of
   the risk perception variable and examining the different possible
   scenarios, we have also found that the less reaction to change the
   population has (and the lower the disposition to use PPEs), the higher
   the waves of contagion and the death toll are.},
