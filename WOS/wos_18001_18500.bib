@article{ WOS:001552511800004,
Author = {Lo, Yuan-Hung and Horn, Hudson T. and Huang, Mo-Fan and Yu, Wei-Chieh
   and Young, Chia-Mei and Liu, Qing and Tomaske, Madeline and Towers,
   Martina and Dominguez, Antonia and Bassik, Michael C. and Lee, Dung-Fang
   and Qi, Lei S. and Weissman, Jonathan S. and Chen, Jin and Kuo, Calvin
   J.},
Title = {Large-scale CRISPR screening in primary human 3D gastric organoids
   enables comprehensive dissection of gene-drug interactions},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {AUG 14},
Abstract = {Understanding how genes influence drug responses is critical for
   advancing personalized cancer treatments. However, identifying these
   gene-drug interactions in a physiologically relevant human system
   remains a challenge, as it requires a model that reflects the complexity
   and heterogeneity among individuals. Here we show that large-scale
   CRISPR-based genetic screens, including knockout, interference
   (CRISPRi), activation (CRISPRa), and single-cell approaches, can be
   applied in primary human 3D gastric organoids to systematically identify
   genes that affect sensitivity to cisplatin. Our screens uncover genes
   that modulate cisplatin response. By combining CRISPR perturbations with
   single-cell transcriptomics, we resolve how genetic alterations interact
   with cisplatin at the level of individual cells and uncover an
   unexpected link between fucosylation and cisplatin sensitivity. We
   identify TAF6L as a regulator of cell recovery from cisplatin-induced
   cytotoxicity. These results highlight the utility of human organoid
   models for dissecting gene-drug interactions and offer insights into
   therapeutic vulnerabilities in gastric cancer.},
