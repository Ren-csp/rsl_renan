@article{ WOS:000691021200040,
Author = {Uckele, Kathryn A. and Jahner, Joshua P. and Tepe, Eric J. and Richards,
   Lora A. and Dyer, Lee A. and Ochsenrider, Kaitlin M. and Philbin, Casey
   S. and Kato, Massuo J. and Yamaguchi, Lydia F. and Forister, Matthew L.
   and Smilanich, Angela M. and Dodson, Craig D. and Jeffrey, Christopher
