@article{ WOS:001241999600001,
Author = {Landolt, Selina A. and Impett, Emily A. and Weitkamp, Katharina and
   Roth, Michelle and Bernecker, Katharina and Bodenmann, Guy},
Title = {Extradyadic stress as a barrier to sexual activity in couples? A Dyadic
   Response Surface Analysis},
Journal = {JOURNAL OF SOCIAL AND PERSONAL RELATIONSHIPS},
Year = {2024},
Volume = {41},
Number = {10},
Pages = {2959-2982},
Month = {OCT},
Abstract = {Sexuality is integral to most romantic relationships. Through stress
   spillover, however, factors such as individually experienced stress
   outside of the relationship (i.e., extradyadic stress) can negatively
   impact sexuality. In this study, we explored how a possible
   (mis)matching of both partners' levels of extradyadic stress is related
   to sexual activity and tested for gender differences. Analyzing 316
   mixed-gender couples from Switzerland, we employed Dyadic Response
   Surface Analysis to assess how extradyadic stress is associated with
   sexual activity. Our results showed that extradyadic stress was
   positively linked to sexual activity for women (in general) and men (in
   the case of matching stress levels). As this result was surprising, we
   conducted additional exploratory analyses and split the measure of
   sexual activity into (1) exchange of affection and (2) eroticism
   (petting, oral sex, and intercourse) and controlled for age. Results
   from this second set of analyses showed that for women, matching stress
   levels were associated with higher exchange of affection, whereas men's
   exchange of affection was higher if men reported higher stress levels
   than women. Notably, after accounting for age, the link between stress
   and eroticism dissipated. Our findings suggest that exchange of
   affection may serve as a coping mechanism for stress, with gender
   influencing this dynamic. However, future research investigating stress
   and sexual activity should consider additional factors such as age,
   relationship satisfaction, stressor type, and stress severity.},
