@article{ WOS:001344919200001,
Author = {Bonaparte, Eugenia Bianca and Lima, Cecilia Cuatianquiz and
   Ferreira-Xavier, Hipolito D. and da Hora, Jessica S. and Di Sallo,
   Facundo G. and Lopez, Fernando G. and Cockle, Kristina L. and
   Montellano, Maria Gabriela Nunez},
Title = {Ecology and conservation of cavity-nesting birds in the Neotropics:
   Recent advances, future directions, and contributions to ornithology},
Journal = {ORNITHOLOGICAL APPLICATIONS},
Year = {2024},
Volume = {126},
Number = {4},
Month = {OCT 30},
Abstract = {center dot In the Neotropics, many bird species shelter, roost, or breed
   in tree cavities, a key resource for populations and communities.center
   dot We synthesize recent studies on cavity-nesting in the Neotropics and
   introduce the Special Feature ``Ecology and conservation of cavity
   nesters in the Neotropics,{''} with field studies from Patagonia to
   Mexico.center dot Cavities were sometimes limited and were generally
   produced by wood decay rather than avian excavators (e.g.,
   woodpeckers).center dot Nest-site characteristics depended on local
   context, body size, social system, and excavation ability.center dot
   Local communities and Indigenous Peoples maintain deeply-rooted
   relationships to cavity-nesting birds (e.g., as relatives, signs,
   spirits, and symbols), but ornithologists understand little about these
   relationships or how they influence bird populations, human well-being,
   and collective resistance to cultural assimilation.center dot We
   recommend future field studies rooted in respect for Indigenous and
   local community knowledge and natural history, with attention to arid
   and urban environments and substrates beyond trees.
   Alrededor del 35\% de las especies de aves que anidan en cavidades de \&
   aacute;rboles habitan en el Neotr \& oacute;pico, una regi \& oacute;n
   crucial para comprender su ecolog \& iacute;a reproductiva, su
   conservaci \& oacute;n y su papel en los sistemas socioecol \&
   oacute;gicos. Hace diecis \& eacute;is a \& ntilde;os, revisaron los
   conocimientos publicados e identificaron las prioridades de investigaci
   \& oacute;n para las aves neotropicales que anidan en cavidades. Los
   avances desde 2008 no han sido sintetizados y muchos siguen excluidos de
   la ornitolog \& iacute;a dominante debido a barreras que afectan
   desproporcionadamente a personas e ideas del Sur Global. Aqu \& iacute;
   revisamos los avances recientes en el conocimiento de las aves
   neotropicales que anidan en cavidades, presentamos la colecci \&
   oacute;n especial ``Ecolog \& iacute;a y conservaci \& oacute;n de las
   aves que anidan en cavidades en el Neotr \& oacute;pico{''} y esbozamos
   posibles direcciones para futuras investigaciones. La investigaci \&
   oacute;n en el Neotr \& oacute;pico ha avanzado en el conocimiento de la
   biolog \& iacute;a reproductiva, ha demostrado que los sitios de
   nidificaci \& oacute;n son limitados y que las aves compiten por las
   cavidades (principalmente en bosques h \& uacute;medos), ha identificado
   las cavidades no excavadas (formadas por la descomposici \& oacute;n de
   la madera) como la principal fuente de cavidades y ha demostrado la
   importancia de comprender las relaciones de las comunidades ind \&
   iacute;genas y locales con las aves. Con estudios de campo en todo el
   Neotr \& oacute;pico, la colecci \& oacute;n especial muestra c \&
   oacute;mo el medio ambiente, los imaginarios comunes de las personas, el
   manejo de la vegetaci \& oacute;n y el comportamiento de las aves
   excavadoras pueden interactuar para influir en la disponibilidad de
   cavidades, con consecuencias ecol \& oacute;gicas para muchos organismos
   usuarios de cavidades. En el futuro, los investigadores deber \&
   aacute;n centrarse en el conocimiento etnol \& oacute;gico y la historia
   natural para crear una lista precisa de las aves que anidan en cavidades
   en el Neotr \& oacute;pico, e integrar este conocimiento en los estudios
   de ecolog \& iacute;a de poblaciones y comunidades. Tambi \& eacute;n es
   importante estudiar los factores que influyen en la din \& aacute;mica
   de las cavidades, sobre todo utilizando un marco de sistemas socioecol
   \& oacute;gicos y especialmente en regiones \& aacute;ridas y semi \&
   aacute;ridas. Recomendamos ampliar el concepto de redes de nidos (redes
   ecol \& oacute;gicas de nidificadores en cavidades) para incorporar
   otros sustratos de cavidades (p. ej., termiteros, acantilados),
   alternativas a las cavidades (p. ej., los voluminosos nidos de palos
   cerrados de muchos Furnariidae) y taxones usuarios de cavidades m \&
   aacute;s all \& aacute; de aves y mam \& iacute;feros (p. ej., insectos
   sociales, serpientes), que abundan en el Neotr \& oacute;pico pero no se
   contemplaron en la formulaci \& oacute;n original de las redes de nidos.
   Versiones traducidas de este art \& iacute;culo est \& aacute;n
   disponibles en Material Suplementario 1 (espa \& ntilde;ol) y Material
   Suplementario 2 (portugu \& eacute;s).},
