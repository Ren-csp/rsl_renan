@article{ WOS:001208991400006,
Author = {Xie, Yuyang and Shen, Zehao and Wang, Tao and Malanson, George P. and
   Penuelas, Josep and Wang, Xiaoyi and Chen, Xiangwu and Liang, Eryuan and
   Liu, Hongyan and Yang, Mingzheng and Ying, Lingxiao and Zhao, Fu and
   Piao, Shilong},
Title = {Uppermost global tree elevations are primarily limited by low
   temperature or insufficient moisture},
Journal = {GLOBAL CHANGE BIOLOGY},
Year = {2024},
Volume = {30},
Number = {4},
Month = {APR},
Abstract = {The impact of anthropogenic global warming has induced significant
   upward dispersal of trees to higher elevations at alpine treelines.
   Assessing vertical deviation from current uppermost tree distributions
   to potential treeline positions is crucial for understanding ecosystem
   responses to evolving global climate. However, due to data resolution
   constraints and research scale limitation, comprehending the global
   pattern of alpine treeline elevations and driving factors remains
   challenging. This study constructed a comprehensive quasi-observational
   dataset of uppermost tree distribution across global mountains using
   Google Earth imagery. Validating the isotherm of mean growing-season air
   temperature at 6.6 +/- 0.3 degrees C as the global indicator of thermal
   treeline, we found that around two-thirds of uppermost tree distribution
   records significantly deviated from it. Drought conditions constitute
   the primary driver in 51\% of cases, followed by mountain elevation
   effect which indicates surface heat (27\%). Our analyses underscore the
   multifaceted determinants of global patterns of alpine treeline,
   explaining divergent treeline responses to climate warming. Moisture,
   along with temperature and disturbance, plays the most fundamental roles
   in understanding global variation of alpine treeline elevation and
   forecasting alpine treeline response to ongoing global warming.
   Based on a comprehensive quasi-observational dataset of global uppermost
   tree distribution, this study established the mean growing-season
   temperature at 6.6 +/- 0.3 degrees C as the universal thermal potential
   threshold for global alpine treelines, built an indicator Delta H which
   was elevational deviation of the actual treeline from the potential
   threshold to measure the asynchrony of treeline shifts and global
   warming. This study found that moisture and mountain elevation effect
   predominantly contribute to the Delta H at the global scale. Drought
   conditions constitute the primary driver of Delta H in 51\% of cases at
   regional scale, followed by mountain elevation effect which indicates
   surface heat (27\%).image},
