@article{ WOS:000339558100112,
Author = {Milfont, Taciano L. and Evans, Laurel and Sibley, Chris G. and Ries, Jan
   and Cunningham, Andrew},
Title = {Proximity to Coast Is Linked to Climate Change Belief},
Journal = {PLOS ONE},
Year = {2014},
Volume = {9},
Number = {7},
Month = {JUL 21},
Abstract = {Psychologists have examined the many psychological barriers to both
   climate change belief and concern. One barrier is the belief that
   climate change is too uncertain, and likely to happen in distant places
   and times, to people unlike oneself. Related to this perceived
   psychological distance of climate change, studies have shown that direct
   experience of the effects of climate change increases climate change
   concern. The present study examined the relationship between physical
   proximity to the coastline and climate change belief, as proximity may
   be related to experiencing or anticipating the effects of climate change
   such as sea-level rise. We show, in a national probability sample of
   5,815 New Zealanders, that people living in closer proximity to the
   shoreline expressed greater belief that climate change is real and
   greater support for government regulation of carbon emissions. This
   proximity effect held when adjusting for height above sea level and
   regional poverty. The model also included individual differences in
   respondents' sex, age, education, political orientation, and wealth. The
   results indicate that physical place plays a role in the psychological
   acceptance of climate change, perhaps because the effects of climate
   change become more concrete and local.},
