Author = {Seo, Dayoung and Choi, Yangsean and Jeong, Eunseon and Bang, Sanghwi and
   Lee, Ji-Sung and Jang, In-Hye and Choi, Lynkyung and Kim, Jin Hee and
   Shin, Wangyoung and Seo, Bo-Ra and Kim, Shina and Jung, Hee-Jae and Kim,
