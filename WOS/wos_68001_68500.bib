@article{ WOS:000862415000009,
Author = {Alchahin, Adele M. and Mei, Shenglin and Tsea, Ioanna and Hirz, Taghreed
   and Kfoury, Youmna and Dahl, Douglas and Wu, Chin-Lee and Subtelny,
   Alexander O. and Wu, Shulin and Scadden, David T. and Shin, John H. and
   Saylor, Philip J. and Sykes, David B. and Kharchenko, Peter V. and
   Baryawno, Ninib},
Title = {A transcriptional metastatic signature predicts survival in clear cell
   renal cell carcinoma},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {SEP 30},
Abstract = {Clear cell renal cell carcinoma (ccRCC) is the most common type of
   kidney cancer in adults. When ccRCC is localized to the kidney, surgical
   resection or ablation of the tumor is often curative. However, in the
   metastatic setting, ccRCC remains a highly lethal disease. Here we use
   fresh patient samples that include treatment-naive primary tumor tissue,
   matched adjacent normal kidney tissue, as well as tumor samples
   collected from patients with bone metastases. Single-cell transcriptomic
   analysis of tumor cells from the primary tumors reveals a distinct
   transcriptional signature that is predictive of metastatic potential and
   patient survival. Analysis of supporting stromal cells within the tumor
   environment demonstrates vascular remodeling within the endothelial
   cells. An in silico cell-to-cell interaction analysis highlights the
   CXCL9/CXCL10-CXCR3 axis and the CD70-CD27 axis as potential therapeutic
   targets. Our findings provide biological insights into the interplay
   between tumor cells and the ccRCC microenvironment.},
