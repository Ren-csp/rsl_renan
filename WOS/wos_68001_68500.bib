@article{ WOS:001041604200001,
Author = {Moore, Coco and Unwin, Peter and Evans, Nick and Howie, Frances},
Title = {``Winging It{''}: An Exploration of the Self-Perceived Professional
   Identity of Social Prescribing Link Workers},
Journal = {HEALTH \& SOCIAL CARE IN THE COMMUNITY},
Year = {2023},
Volume = {2023},
Month = {JUL 26},
Abstract = {The practice of social prescribing (SP) has been rapidly expanding
   throughout the UK in recent years. The role of SP link workers (SPLWs)
   currently has no nationally prescribed requirements in terms of
   qualifications, background, or experience. This qualitative study of 13
   SPLWs using semi-structured interviews is believed to be the first
   exploration of perceptions of their professional identity and the agency
   and structure within their roles. SPLWs reported feeling caught between
   biomedical and biopsychosocial models of health. Some identified with
   clinical healthcare teams, whilst others preferred non-medical and
   community-based identities. SPLWs valued professional flexibility and
   freedom, though were concerned this was becoming increasingly
   restricted. They reported filling gaps in the health system and
   absorbing more risk and complexity than they believed was reflected in
   their training or pay. Despite this, SPLWs demonstrated consistent core
   values of person-centredness, holistic practice, and a strength-based
   approach. A more consistent approach to professional identity is
   recommended as a way forward for SP.},
