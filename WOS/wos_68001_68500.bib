@article{ WOS:000373800600043,
Author = {Chelleri, Lorenzo and Kua, Harn Wei and Rodriguez Sanchez, Juan Pablo
   and Nahiduzzaman, Kh Md and Thondhlana, Gladman},
Title = {Are People Responsive to a More Sustainable, Decentralized, and
   User-Driven Management of Urban Metabolism?},
Journal = {SUSTAINABILITY},
