@article{ WOS:000261039600044,
Author = {McAlonan, Kerry and Cavanaugh, James and Wurtz, Robert H.},
Title = {Guarding the gateway to cortex with attention in visual thalamus},
Journal = {NATURE},
Year = {2008},
