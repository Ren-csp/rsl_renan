@article{ WOS:000288444000044,
Author = {Zhang, Haibing and Zhou, Xiaohui and McQuade, Thomas and Li, Jinghe and
   Chan, Francis Ka-Ming and Zhang, Jianke},
Title = {Functional complementation between FADD and RIP1 in embryos and
   lymphocytes},
