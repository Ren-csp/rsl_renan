@article{ WOS:001835742100001,
Author = {Ignatieva, Maria and Dushkova, Diana and Muller, Norbert},
Title = {Evolution of lawns as grasslands: a cross-continental, socio-ecological
   analysis and implications for nature-based alternatives},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2026},
Volume = {14},
Month = {JUL 15},
Abstract = {Conventional short cut lawns are a globally dominant landscape element
   but are increasingly criticised for their low ecological value and high
   maintenance. This research considers the lawn as a unique human-made
   type of grassland that originated from European semi-natural grasslands
   in Medieval Europe and passed through several historical periods,
   becoming an ecological and cultural phenomenon. The study employs an
   integrative, mixed-methods approach that synthesises (a) analyses of
   inter- and transdisciplinary research projects on lawns led by authors
   over the past decades (1980-2025), providing a cross-continental
   perspective, (b) a narrative literature review, and (c) analysis of
   historical artworks. It offers a new conceptual framework that is
   historically informed, ecologically grounded, and socially relevant, and
   supports the development of nature-based alternatives. Consequently, the
   biodiversity of European lawns is higher than in other continents, where
   lawns were introduced between the late 18th and 20th centuries through
   colonial and cultural expansion. Compared to Europe, lawns in other
   continents rely on introduced (non-native) species adapted for lawn use,
   resulting in lower plant species richness and functional diversity. We
   identified two main categories of nature-based solutions for lawns,
   differentiated by composition and structure: wildflower meadows (native
   plant species-rich grasslands) and ornamental plantings
   (non-grass-dominated systems that replace lawns entirely and do not
   create turf). These categories are analysed through implemented examples
   from multiple countries. The development of nature-based alternatives to
   conventional lawns and their implementation in landscape architecture
   practice varies significantly across regions and requires a
   context-specific, ecologically sound, and socially appropriate approach.},
