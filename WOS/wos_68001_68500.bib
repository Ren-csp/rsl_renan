@article{ WOS:001739004500001,
Author = {Odimayomi, Tolulope O. and Pruden, Amy and Edwards, Marc A.},
Title = {Microbial Growth Curve Framework Provides Insights for Controlling
   Opportunistic Pathogens in Building Plumbing},
Journal = {ACS ES\&T WATER},
Year = {2026},
Volume = {6},
Number = {5},
Pages = {2937-2948},
Month = {MAY 8},
Abstract = {The perception that high water retention time (WRT) in buildings
   increases microbial and pathogen growth drives costly flushing
   interventions, which lack a scientific framework to guide effective
   implementation. Here, we evaluate the effect of WRT from 1 to 21 days in
   an at-scale building plumbing rig with influent chloramine residuals of
   <0.2-2.5 mg/L as Cl-2 and water heater set points of 40 and 60 degrees
   C. We found that the classic microbial growth curve consisting of lag,
   exponential growth, stationary, and decay phases provided a robust
   explanation of trends in bulk water total cell counts (TCC) and
   Legionella pneumophila over a wide range of conditions. We extended this
   observation to develop a framework to understand how various controls
   and operating conditions act to stop (e.g., cold temperatures,
   disinfectant) or reset (e.g., pasteurization in water heaters killing
   microbes and recycling nutrients) the growth curve as a function of WRT.
   Bulk water TCC and L. pneumophila reached a consistent peak/plateau at a
   building WRT of similar to 7 days before decaying up to 90\% at higher
   WRT. These findings suggest that recent guidelines recommending weekly
   flushing of buildings may sometimes be counterproductive and that very
   high WRT does not necessarily indicate microbial risk.},
Publisher = {AMER CHEMICAL SOC},
Address = {1155 16TH ST, NW, WASHINGTON, DC 20036 USA},
Type = {Article},
Language = {English},
Affiliation = {Odimayomi, TO (Corresponding Author), Virginia Tech, Via Dept Civil \& Environm Engn, Blacksburg, VA 24061 USA.
   Odimayomi, Tolulope O.; Pruden, Amy; Edwards, Marc A., Virginia Tech, Via Dept Civil \& Environm Engn, Blacksburg, VA 24061 USA.},
DOI = {10.1021/acsestwater.5c01431},
EarlyAccessDate = {APR 2026},
EISSN = {2690-0637},
Keywords = {water age; Legionella pneumophila; growth curve; drinking water;
   building plumbing},
Keywords-Plus = {LEGIONELLA-PNEUMOPHILA; DRINKING-WATER; DISTRIBUTION-SYSTEM; BACTERIAL
   COMMUNITY; TEMPERATURE; CONTAMINATION; CHLORINE; QUALITY; DECAY; RISK},
Research-Areas = {Environmental Sciences \& Ecology; Water Resources},
