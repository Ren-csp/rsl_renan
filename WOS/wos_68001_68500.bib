@article{ WOS:001001683700003,
Author = {Li, Xin and Wang, Sheng and Xie, Ying and Jiang, Hongmei and Guo, Jing
   and Wang, Yixuan and Peng, Ziyi and Hu, Meilin and Wang, Mengqi and
   Wang, Jingya and Li, Qian and Wang, Yafei and Liu, Zhiqiang},
Title = {Deacetylation induced nuclear condensation of HP1γ promotes multiple
   myeloma drug resistance},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {MAR 9},
Abstract = {Acquired chemoresistance to proteasome inhibitors is a major obstacle in
   managing multiple myeloma but key regulators and underlying mechanisms
   still remain to be explored. We find that high level of HP1 gamma is
   associated with low acetylation modification in the bortezomib-resistant
   myeloma cells using SILAC-based acetyl-proteomics assay, and higher HP1
   gamma level is positively correlated with poorer outcomes in the clinic.
   Mechanistically, elevated HDAC1 in the bortezomib-resistant myeloma
   cells deacetylates HP1 gamma at lysine 5 and consequently alleviates the
   ubiquitin-mediated protein degradation, as well as the aberrant DNA
   repair capacity. HP1 gamma interacts with the MDC1 to induce DNA repair,
   and simultaneously the deacetylation modification and the interaction
   with MDC1 enhance the nuclear condensation of HP1 gamma protein and the
   chromatin accessibility of its target genes governing sensitivity to
   proteasome inhibitors, such as CD40, FOS and JUN. Thus, targeting HP1
   gamma stability by using HDAC1 inhibitor re-sensitizes
   bortezomib-resistant myeloma cells to proteasome inhibitors treatment in
   vitro and in vivo. Our findings elucidate a previously unrecognized role
   of HP1 gamma in inducing drug resistance to proteasome inhibitors of
   myeloma cells and suggest that targeting HP1 gamma may be efficacious
   for overcoming drug resistance in refractory or relapsed multiple
   myeloma patients.
   The molecular mechanisms underlying acquired chemoresistance to
   proteasome inhibitors (PIs) in multiple myeloma (MM) remain to be
   explored. Here, the authors highlight the role of heterochromatin
   protein 1 gamma as a potential target for overcoming resistance to PIs
   in MM.},
