@article{ WOS:001771019900001,
Author = {Zambrano, Guillermo and Ramirez, Karen and Vazquez, Jose Luis and
   Montealegre, Felipe and Sanchez, Luis and Bravo, Daniel and Moyano,
   Byron and Ramirez, Laura and Chavez, Eduardo and Santos, Adriana},
Title = {Economic vulnerability of the cacao value chain to the cadmium (Cd)
   regulation in chocolates: a whole-chain analysis in Ecuador, Colombia,
   and Costa Rica},
Journal = {FRONTIERS IN ENVIRONMENTAL ECONOMICS},
Year = {2026},
Volume = {5},
Month = {MAY 7},
Abstract = {The EU regulation on cadmium (Cd) in chocolates has posed significant
   trade challenges for cacao-producing countries in Latin America and the
   Caribbean (LAC). Elevated Cd levels have been reported in various LAC
   countries, threatening the export potential of cacao beans. This study
   analyzed the effects of this regulation on cacao commercialization in
   Ecuador, Colombia, and Costa Rica. The analysis began with the mapping
   of cacao value chains and the collection of stakeholder perceptions
   regarding the impacts of the regulation. Following this, the study
   assessed the volume of cacao exports at risk based on secondary data
   regarding Cd concentrations and export statistics. Finally, the Business
   Model Canvas tool was employed with exporting associations and companies
   in Ecuador to evaluate the impacts on actors involved in specialty cacao
   commercialization. The findings revealed that the most significant
   impacts were absorbed by direct trade, i.e., bean to bar. The analysis
   estimated that without mitigation measures, Ecuador was at risk of
   losing USD 280 million in annual exports, followed by Colombia with USD
   80 million and Costa Rica with USD 2 million. This study identified the
   most affected actors and countries due to the EU regulation and
   emphasized the necessity for innovative strategies to overcome this
   non-tariff barrier for producing countries.},
