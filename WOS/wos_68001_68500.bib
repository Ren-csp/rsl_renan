@article{ WOS:001369778000023,
Author = {Sendker, Franziska L. and Schlotthauer, Tabea and Mais, Christopher-Nils
   and Lo, Yat Kei and Girbig, Mathias and Bohn, Stefan and Heimerl, Thomas
   and Schindler, Daniel and Weinstein, Arielle and Metzger, Brian P. H.
   and Thornton, Joseph W. and Pillai, Arvind and Bange, Gert and Schuller,
   Jan M. and Hochberg, Georg K. A.},
Title = {Frequent transitions in self-assembly across the evolution of a central
   metabolic enzyme},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {DEC 3},
Abstract = {Many enzymes assemble into homomeric protein complexes comprising
   multiple copies of one protein. Because structural form is usually
   assumed to follow function in biochemistry, these assemblies are thought
   to evolve because they provide some functional advantage. In many cases,
   however, no specific advantage is known and, in some cases, quaternary
   structure varies among orthologs. This has led to the proposition that
   self-assembly may instead vary neutrally within protein families. The
   extent of such variation has been difficult to ascertain because
   quaternary structure has until recently been difficult to measure on
   large scales. Here, we employ mass photometry, phylogenetics, and
   structural biology to interrogate the evolution of homo-oligomeric
   assembly across the entire phylogeny of prokaryotic citrate synthases -
   an enzyme with a highly conserved function. We discover a menagerie of
   different assembly types that come and go over the course of evolution,
   including cases of parallel evolution and reversions from complex to
   simple assemblies. Functional experiments in vitro and in vivo indicate
   that evolutionary transitions between different assemblies do not
   strongly influence enzyme catalysis. Our work suggests that enzymes can
   wander relatively freely through a large space of possible assembly
   states and demonstrates the power of characterizing structure-function
   relationships across entire phylogenies.},
