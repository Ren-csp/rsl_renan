@article{ WOS:001662010400002,
Author = {Li, Jialu and Li, Jian and Zhu, Angqi and Dai, Xinli and Liu, Juxiu and
   Liu, Huayi and Xia, Zhili and Dong, Yuefan and Qian, Wenyu and Dai,
   Lunzhi and Guo, Li and Yan, Chuangye and Deng, Dong and Luo, Yunzi and
   Wang, Xiang},
Title = {Structural-guided identification of two modulators of β-1,3-glucan
   synthase FKS1},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {17},
Number = {1},
Month = {DEC 7},
Abstract = {FKS1 is a beta-1,3-glucan synthase critical for fungal cell wall
   formation and a target for antifungal drugs such as echinocandin and
   ibrexafungerp. However, the mechanisms regulating FKS1 activity remain
   largely unknown. Here, we reveal that transfer RNA (tRNA) acts as an
   endogenous inhibitor, whereas GSR1 functions as a stabilizer of FKS1.
   The cryo-EM structure of FKS1 adopts a tRNA-mediated homodimer
   configuration, representing a quiescent state of beta-1,3-glucan
   synthase. Unexpectedly, the copurified endogenous tRNA is identified as
   a potent inhibitor that suppresses FKS1 activity. Moreover,
   high-resolution cryo-EM density analysis enable the identification of
   GSR1 as an additional binding partner of FKS1. Mutagenesis experiments
   confirm the interaction between FKS1 and GSR1. Evolutionarily conserved
   GSR1 is found to increase the stability of FKS1 in beta-1,3-glucan
   biosynthesis. Collectively, our findings identify both tRNA and GSR1 as
   intrinsic modulators of beta-1,3-glucan biosynthesis, thereby providing
   opportunities for the further development of FKS1-targeted antifungal
   drugs.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
