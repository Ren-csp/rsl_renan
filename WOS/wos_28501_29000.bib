@article{ WOS:000270883500006,
Author = {Ileva, Nina Y. and Shibata, Hideaki and Satoh, Fuyuki and Sasa, Kaichiro
   and Ueda, Hiroshi},
Title = {Relationship between the riverine nitrate-nitrogen concentration and the
   land use in the Teshio River watershed, North Japan},
Journal = {SUSTAINABILITY SCIENCE},
Year = {2009},
