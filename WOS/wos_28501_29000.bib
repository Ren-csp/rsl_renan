@article{ WOS:001304177200001,
Author = {Hwang, Sung-Yeon and Kim, Hyewon and Denisko, Danielle and Zhao, Boxun
   and Lee, Dohoon and Jeong, Jiseok and Kim, Jinuk and Park, Kiwon and
   Park, Junhyun and Jeong, Dongjoon and Park, Sehong and Choi, Hee-Jung
