@article{ WOS:001377401400008,
Author = {Liao, Hanpeng and Liu, Chen and Zhou, Shungui and Liu, Chunqin and
   Eldridge, David J. and Ai, Chaofan and Wilhelm, Steven W. and Singh,
   Brajesh K. and Liang, Xiaolong and Radosevich, Mark and Yang, Qiu-e and
   Tang, Xiang and Wei, Zhong and Friman, Ville-Petri and Gillings, Michael
   and Delgado-Baquerizo, Manuel and Zhu, Yong-guan},
Title = {Prophage-encoded antibiotic resistance genes are enriched in
   human-impacted environments},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {SEP 27},
Abstract = {The spread of antibiotic resistance genes (ARGs) poses a substantial
   threat to human health. Phage-mediated transduction could exacerbate ARG
   transmission. While several case studies exist, it is yet unclear to
   what extent phages encode and mobilize ARGs at the global scale and
   whether human impacts play a role in this across different habitats.
   Here, we combine 38,605 bacterial genomes, 1432 metagenomes, and 1186
   metatranscriptomes across 12 contrasting habitats to explore the
   distribution of prophages and their cargo ARGs in natural and
   human-impacted environments. Worldwide, we observe a significant
   increase in the abundance, diversity, and activity of prophage-encoded
   ARGs in human-impacted habitats linked with relatively higher risk of
   past antibiotic exposure. This effect was driven by phage-encoded cargo
   ARGs that could be mobilized to provide increased resistance in
   heterologous E. coli host for a subset of analyzed strains. Our findings
   suggest that human activities have altered bacteria-phage interactions,
   enriching ARGs in prophages and making ARGs more mobile across habitats
   globally.},
