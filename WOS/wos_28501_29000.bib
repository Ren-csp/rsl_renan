@article{ WOS:001609425700001,
Author = {Laroche-Nantel, Raphaelle and Carlucci, Samantha and Phillips, Karen P.
   Isabelle and Giroux, Isabelle},
Title = {Recruits' perception of factors influencing dietary intake during basic
   military training: A qualitative study},
Journal = {JOURNAL OF MILITARY VETERAN AND FAMILY HEALTH},
Year = {2025},
Volume = {11},
Number = {4},
Pages = {23-36},
Abstract = {Introduction: During basic military training (BMT), recruits often have
   elevated energy requirements because of intense training and can have
   difficulties meeting their nutritional needs, potentially resulting in
   decreased performance and increased risk of injury. This study documents
   recruits' perceptions of individual, dietary, and environmental factors
   that influenced their food intake during BMT. Methods: This qualitative
   phenomenological study included semi-structured individual interviews
   with Canadian Armed Forces (CAF) recruits who recently completed BMT.
   Virtual interviews were audio-recorded, transcribed verbatim, and coded
   using a thematic content analysis approach. Results: Between September
   2022 and March 2023, 16 recently graduated recruits participated in the
   study. Six main themes emerged related to the individual (physical
   activity level, hunger level, mood and morale), the environment (food
   environment, social influences), and the diet (food characteristics),
   with multiple theme interactions. No sex or gender differences were
   identified. Aspects of the food environment, including short meal
   duration and reduced food availability and accessibility, limited
   recruits' ability to eat sufficiently to compensate for their increased
   physical activity and contributed to increased hunger levels. Food
   characteristics were adequate for some, but others would have preferred
   more variety and better-quality food. Social influences, mood and
   morale, food environment, and food characteristics were reported as
   facilitators of or barriers to recruits' dietary intake. Discussion:
   Several individual, environmental, and dietary factors were found to
   influence recruits' dietary intake during BMT. These data provide some
   insights on potential avenues for improving recruits' dietary intake;
   however, more research is needed to develop evidence-based strategies.
   Multiple factors can affect food intake among military personnel;
   however, few studies have examined these factors within the Canadian
   Armed Forces (CAF) recruit population. To address this gap, the current
   study documented CAF recruits' perceptions of factors that influenced
   their food intake during basic military training (BMT). Physical
   activity levels, hunger levels, social influences, mood and morale, food
   environment, and food characteristics were reported as facilitators of
   and barriers to recruits' dietary intake. The CAF can use these results
   to inform strategies to optimize recruits' food intake during BMT,
   ultimately enhancing military personnel health and performance.
   Introduction : Durant la qualification militaire de base (QMB), les
   recrues ont souvent des besoins \& eacute;nerg \& eacute;tiques \&
   eacute;lev \& eacute;s en raison d'entrainements intensifs et peuvent
   rencontrer des difficult \& eacute;s \& agrave; r \& eacute;pondre \&
   agrave; leurs besoins nutritionnels, pouvant entrainer une diminution
   des performances et un risque accru de blessures. Cette \& eacute;tude
   vise \& agrave; documenter les perceptions des recrues sur les facteurs
   individuels, environnementaux et alimentaires ayant influenc \& eacute;
   leur alimentation pendant la QMB. M \& eacute;thodologie : Cette \&
   eacute;tude ph \& eacute;nom \& eacute;nologique qualitative comprenait
   des entretiens individuels semi-structur \& eacute;s avec des recrues
   des Forces arm \& eacute;es canadiennes (FAC) ayant r \& eacute;cemment
   termin \& eacute; leur QMB. Les entretiens virtuels furent enregistr \&
   eacute;s, transcrits verbatim et cod \& eacute;s avec une approche
   d'analyse th \& eacute;matique du contenu. R \& eacute;sultats : Entre
   septembre 2022 et mars 2023, 16 recrues particip \& egrave;rent \&
   agrave; l'\& eacute;tude. Six th \& egrave;mes interreli \& eacute;s
   principaux relatifs \& agrave; l'individu, \& agrave; l'environnement et
   \& agrave; l'alimentation \& eacute;merg \& egrave;rent. Aucune diff \&
   eacute;rence entre les sexes ne fut identifi \& eacute;e. La courte dur
   \& eacute;e des repas et la disponibilit \& eacute; r \& eacute;duite
   des aliments limit \& egrave;rent la capacit \& eacute; des recrues \&
   agrave; manger suffisamment pour compenser leur niveau d'activit \&
   eacute; physique \& eacute;lev \& eacute; et contribu \& egrave;rent \&
   agrave; augmenter leur faim. Les caract \& eacute;ristiques des aliments
   furent ad \& eacute;quates pour certains, mais d'autres auraient pr \&
   eacute;f \& eacute;r \& eacute; plus de vari \& eacute;t \& eacute; et
   de qualit \& eacute;. Les influences sociales, le moral, l'environnement
   alimentaire et les caract \& eacute;ristiques des aliments ont facilit
   \& eacute; ou nuit \& agrave; l'apport alimentaire des recrues.
   Discussion : Plusieurs facteurs individuels, environnementaux et
   alimentaires influenc \& egrave;rent l'apport alimentaire des recrues
   pendant la QMB. Ces donn \& eacute;es donnent un aper \& ccedil;u des
   pistes d'am \& eacute;lioration de l'apport alimentaire des recrues;
   cependant, plus de recherches sont n \& eacute;cessaires pour d \&
   eacute;velopper des strat \& eacute;gies fond \& eacute;es sur des donn
   \& eacute;es probantes.},
