@article{ WOS:001422368300002,
Author = {del Corral, David Florido and Mardones, Felipe Campos and Perez, Agustin
   Coca and Vazquez, Jose Antonio Cortes and Reyes, Javier Escalera and
   Fernandez, Ernesto Martinez},
Title = {Conservation policy, governance, and perceptions upon sustainability Los
   Alcornocales Natural Park and El Estrecho Natural Park as a case study
   in Andalusia},
Journal = {REVISTA DE ANTROPOLOGIA SOCIAL},
Year = {2024},
Volume = {33},
Number = {2},
Pages = {159-179},
Abstract = {Natural parks were designed to harmonize conservationist objectives with
   local development and have been defined as laboratories for social
   participation. Using group techniques (focus groups) and participatory
   techniques (workshops), we offer the perceptions of institucional and
   social agents of Los Alcornocales Natural Park and Estrecho Natural Park
   (Andalusia) after decades of conservation policies. We illustrate the
   diversity of social agencies involved in these areas, their discourses
   on social participation, their main demands regarding governance, their
   discourses on conservation and their future perspectives, as well as the
   trade-offs resulting from the designation of both parks. We conclude
   that the natural park as a political instrument has failed to achieve
   its objectives in neither of the two territories, although we have
   identified a common interest among technicians and social agencies in
   implementing mechanisms to improve their governance.},
