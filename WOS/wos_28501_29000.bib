@article{ WOS:001794939100001,
Author = {Merscher, Alma-Sophia and Hildebrandt, Lea K. and Sahraoui, Jasin and
   Gamer, Matthias},
Title = {Unraveling the behavioral and autonomic dynamics of defensive states in
   humans in an unconstrained, immersive virtual world},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2026},
Volume = {184},
Month = {NOV},
Abstract = {Defensive responses to threats are crucial for mental and physical
   health. Animal studies highlight different defense modes related to
   threat proximity, yet human defense dynamics remain underexplored due to
   experimental restrictions and oversimplification of research designs.
   The current multimodal study thus comprehensively characterized defense
   patterns in humans on the behavioral (movement speed, body, head, and
   eye rotations), autonomic (heart rate and skin conductance), and
   subjective level (perceived dread) in an immersive virtual reality
   environment. Ninety-four participants performed a foraging task while
   the context signaled varying levels of threat, that were also reflected
   in individual dread ratings. Upon relatively distal, ambiguous threat,
   (oculo)motor activity decreased, reminiscent of freezing behaviors in
   rodents. While skin conductance levels increased when under attack,
   heart rate remained stable. Positive cross-correlations among movement
   metrics and autonomic measures as well as significant relationships of
   biobehavioral adjustments to successful coping behavior suggest the
   existence of circumscribed, adaptive defensive states that were further
   shaped by individual differences in anxiety and aggression. Overall, the
   current study offers valuable insights into the dynamic and integrated
   nature of defensive states in humans, while also establishing an
   ecologically valid research framework to advance translational research
   on threat processing across species.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
