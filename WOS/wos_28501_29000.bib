@article{ WOS:000262331300011,
Author = {Mota, Jorge and Ribeiro, Jose Carlos and Santos, Maria Paula},
Title = {Obese girls differences in neighbourhood perceptions, screen time and
   socioeconomic status according to level of physical activity},
