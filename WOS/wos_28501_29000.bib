@article{ WOS:000298871400017,
Author = {Reichling, Steven B. and Baker, Christopher and Swatzell, Christina},
Title = {Aggregations of Sphodros rufipes (Araneae: Atypidae) in an urban
   forest},
Journal = {JOURNAL OF ARACHNOLOGY},
Year = {2011},
Volume = {39},
Number = {3},
Pages = {503-505},
Abstract = {A large population of Sphodros rufipes (Latreille 1829) was discovered
   in a municipal park in Memphis, Tennessee. We examined potential stem
   diameter preference, frequency of web attachment to available tree
   species and the spatial distribution patterns of spiders and potential
   attachment structures. A wide range of structure diameters were utilized
   for web attachment. The association of pursewebs to tree taxa was
   independent of the frequency of tree taxa occurrence. The spacing of
   vegetation stems and trunks was approximately random, but spiders
   exhibited a nonrandom, aggregated distribution, which was more
   pronounced in subadults than adults. The factors influencing S. rufipes
   to occur in aggregations cannot be explained by the spatial proximity of
   potential attachment structures in the forest.},
