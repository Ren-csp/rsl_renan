@article{ WOS:001854539600001,
Author = {Ejaz, Waqas and Kubin, Emily and Fletcher, Richard},
Title = {What makes climate change feel distant? Evidence from eight countries in
   the Global North and South},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {114},
Month = {SEP},
Abstract = {Psychological distance - how near or distant people perceive climate
   change to be - shapes whether the issue feels urgent and actionable. Yet
   most evidence comes from the Global North, leaving little understanding
   of how distance is formed in countries most vulnerable to climate
   impacts. Drawing on communication and psychology research, we examine
   predictors of psychological distance across eight countries in the
   Global North and South (Brazil, France, Germany, India, Japan, Pakistan,
   the UK, and the US). This research uses survey data (N = 8,254) and
   ordinary least squares regressions with country fixed effects to test
   the influence of meta-perceptions of ideological groups' concern for
   climate, mainstream and non-mainstream media use, exposure to climate
   misinformation, and trust in institutions. Pooled models show that
   women, more educated respondents, and those with greater climate concern
   perceive climate change as closer, while misinformation exposure
   increases distance. In line with climate communication research, greater
   use of mainstream climate news and higher trust in scientists, climate
   news and environmental activists reduce distance, whereas trust in
   politicians and people respondents know shows no effect. Country-level
   analyses reveal both stability and divergence. Concern for climate
   change is a strong predictor of psychological distance in all countries
   except Pakistan, while other predictors, such as news media use,
   meta-perceptions, and misinformation, vary across contexts. The findings
   advance understanding of psychological distance by identifying both
   universal and context-specific drivers, extending research beyond Global
   North settings, and underscoring the need for communication strategies
   tailored to national environments.},
