@article{ WOS:000350447300007,
Author = {Pfister, Damien Smith},
Title = {``A Short Burst of Inconsequential Information:{''} Networked Rhetorics,
   Avian Consciousness, and Bioegalitarianism},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2015},
Volume = {9},
Number = {1},
Pages = {118-136},
Month = {JAN 2},
Abstract = {This essay uses the concept of ``avian consciousness{''} to reconsider
   assumptions about human communication and theorize networked rhetorics.
   By adopting an ornithomorphic frame, I critically read Don DeLillo's The
   Body Artist as an exploration of overlaps between human and avian
   consciousness. I then argue that avian consciousness provides a richer
   metaphor for understanding networked rhetorics than autistic
   consciousness, which is an increasingly dominant trope for explaining
   interaction with digitally networked media. I explore how Twitter,
   explicitly modeled on avian communication, can be understood as
   circulating information in ways analogous to the contact and assembly
   calls of birds. The essay concludes by noting that seeing avian features
   in human communication diminishes the perceived gap between human and
   nonhuman animal, holding out hope for a more bioegalitarian relationship
   between species.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
