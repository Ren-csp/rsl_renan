@article{ WOS:000524899604029,
Author = {Ampudia-Renuncio, Maria and Guirao, Begona and Molina-Sanchez, Rafael
   and Braganca, Luis},
Title = {Electric Free-Floating Carsharing for Sustainable Cities:
   Characterization of Frequent Trip Profiles Using Acquired Rental Data},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {3},
Month = {FEB},
Abstract = {Free-floating carsharing systems (FFCS) have become a new type of urban
   sustainable mobility, much more flexible than the previous station-based
   carsharing but limited by on-street parking availability and managed by
   municipal administrations. Literature on FFCS until now mostly relies on
   survey-based methodologies and simulations, and little research on FFCS
   has been devoted to the scientific analysis of real flows using revealed
   web-based data. This paper contributes to the existing literature with
   an analysis of FFCS trips using rental data collected directly from
   operators' websites, paying special attention to the most frequent
   trips. The added value of this research is that it provides the first
   analysis of the more FFCS demanding districts in the city of Madrid. The
   results showed that the main origin and destinations points were
   concentrated in low populated and high-income districts that also had
   good parking availability and connectivity to the public transportation
   network.},
