   Alireza and Saboury, Ali Akbar and Hassan, Saeed-Ul and Ahmed, Faran and
   Nawaz, Raheel and Terason, Sid},
Title = {From mega-events hosting to scientific leadership: A seven-decade
   scientometric analysis of pioneer countries},
