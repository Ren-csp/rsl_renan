EISSN = {1873-7994},
Keywords = {Stuttering; Phonetic complexity; Fluency; Accuracy; Reaction time},
Keywords-Plus = {SCHOOL-AGED CHILDREN; SYNTACTIC COMPLEXITY; NONWORD REPETITION;
