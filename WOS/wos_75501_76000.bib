@article{ WOS:000283979900006,
Author = {Li, Xueshu and Parkin, Sean and Duffel, Michael W. and Robertson, Larry
   W. and Lehmler, Hans-Joachim},
Title = {An efficient approach to sulfate metabolites of polychlorinated
   biphenyls},
Journal = {ENVIRONMENT INTERNATIONAL},
Year = {2010},
Volume = {36},
