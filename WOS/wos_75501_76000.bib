@article{ WOS:001391298500001,
Author = {Nuno, Ana and Duncan, Emily M. and Dias, Davide and dos Santos, Yodiney
   and Ramilo-Henry, Maguina and Matilde, Estrela},
Title = {Understanding plastic pollution at a remote tropical island (Principe
   Island Gulf of Guinea): Consumer behaviour and management preferences},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2025},
Volume = {81},
Month = {JAN},
Abstract = {Plastic waste impacts major metropolitan centres and coastal areas of
   the Gulf of Guinea, prompting recent calls for coordinated regional
   efforts to manage and regulate plastic waste pollution. Sao Tome<acute
   accent> and Principe (STP), a Small Island Developing State (SIDS) in
   the Gulf of Guinea, may be particularly vulnerable to the impacts of
   plastics (e.g. due to debris from both local and non-local sources).
   However, small territories are often left out of global and regional
   analyses of plastic use and remain data deficient. Questionnaires were
   used in the island of Principe to characterise consumer behaviour and
   identify potential management recommendations, taking into account local
   perceptions and potential implications for vulnerable groups. Residents
   have experienced changes in the amount of plastic, suggesting that the
   situation has worsened over the last 5 years. Plastic is generally
   perceived as an unsafe, toxic material, with people also mentioning that
   plastic has a detrimental effect on wildlife, particularly sea turtles.
   Overall, waste management and limited product alternatives are perceived
   as main challenges. Across the three potential measures considered (i.e.
   door-to-door plastic collection, fines and legislation banning plastics
   from the island), perceived community support, ease of implementation
   and impact on plastic reduction were consistently identified as key
   variables explaining variation in people's support. Efforts in Principe
   should contribute to decision-making at the regional level, and
   ultimately to coordinated initiatives to manage and regulate plastic
   waste pollution. Vulnerability and potential contributions of SIDS to
   plastic reduction must be robustly considered alongside sustainable
   development and biodiversity conservation.},
