@article{ WOS:000347248300007,
Author = {Meng, Jing and Wang, Tieyu and Wang, Pei and Zhu, Zhaoyun and Li, Qifeng
   and Lu, Yonglong},
Title = {Perfluoroalkyl Substances in Daling River Adjacent to Fluorine
   Industrial Parks: Implication from Industrial Emission},
Journal = {BULLETIN OF ENVIRONMENTAL CONTAMINATION AND TOXICOLOGY},
