@article{ WOS:001788962400008,
Author = {Bell, Antonella Kaiana Suarez},
Title = {English Teachers' Perceptions on Teaching through Playful Activities in
   Primary School},
Journal = {PAGINAS DE EDUCACION},
Year = {2026},
Volume = {19},
Number = {1},
Month = {JAN-JUN},
Abstract = {This article aims to explore the perceptions of English as a foreign
   language teachers working in urban public primary schools in a western
   Uruguayan region regarding the use of playful activities as a teaching
   strategy, as well as to identify predominant pedagogical intentions. A
   descriptive qualitative study was conducted within a hermeneutic
   phenomenological framework. The methodology included semi-structured
   interviews, documentary analysis of lesson plans, photographs, and
   regulatory documents. Data were coded and analyzed using Atlas.ti
   through a priori deductive categories. The results indicate that playful
   activities are primarily used to reinforce content and assess oral
   production. However, several barriers were identified, including limited
   resources, space constraints, and increasing resistance in upper grades
   due to the perception of these activities as infantilizing. It is
   concluded that participation in playful activities depends on the level
   of cognitive complexity involved, and their effectiveness is contingent
   upon an institutional environment that recognizes play as a legitimate
   form of formal learning rather than a peripheral activity.},
