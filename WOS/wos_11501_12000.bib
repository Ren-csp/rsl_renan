@article{ WOS:A1979HW06100001,
Author = {JACOBS, RJ},
Title = {VISUAL RESOLUTION AND CONTOUR INTERACTION IN THE FOVEA AND PERIPHERY},
Journal = {VISION RESEARCH},
Year = {1979},
Volume = {19},
Number = {11},
Pages = {1187-1195},
Abstract = {The nature of contour interaction at the fovea and in the periphery to
   10.degree. eccentricity for human observers with normal vision was
   investigated. Using Landolt ring targets similar to those used by Flom,
   contour interaction effects were greater in peripheral vision. In
   central vision the increase in minimum angle of resolution (MAR)
   occurring with the introduction of bars around the Landolt ring was
   small and much less than the experimental variation. In peripheral
   vision, bars at any of the ring-bar separations tested produced a
   consistent increase in MAR. Relationships between MAR and eccentricity
   were discussed and reasons for the variation between previous studies
   were suggested.},
