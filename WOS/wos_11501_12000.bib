@article{ WOS:001590848900001,
Author = {Knippschild, Robert and Rossler, Stefanie and Braunel, Maximilian and
   Erhardt, Denise and Griesbach, Jacqueline and Gruhler, Karin and
   Jehling, Mathias and Schiller, Georg and Zollter, Constanze},
Title = {What (and how) revitalisation of cities and neighbourhoods can
   contribute to urban sustainability},
Journal = {DISP},
Year = {2025},
Volume = {61},
Number = {2},
Pages = {4-18},
Month = {APR 3},
Abstract = {Increasingly polarised demographic trends pose enormous problems for
   cites. On the one hand side we see overload problems in growing cities,
   mostly in metropolitan regions, and on the other side underutilisation
   problems in shrinking and shrunken cities, mostly in peripheral regions.
   One key aspect in order to solve these problems is the revitalisation of
   cities and neighbourhoods with vacancies. But what contribution can such
   revitalisation make to urban sustainability? We trace in particular the
   ecological consequences of unbalanced spatial development and try to
   assess and visualise the potential of revitalisation with the help of
   illustrative examples from four thematic areas (resource flows, CO2
   emissions, land use and green infrastructure) at various
   spatial-administrative levels and using different methods. The
   interrelations between these areas highlight that an integrated
   perspective is needed to better understand the relationship between
   revitalisation and urban sustainability. From this, we derive the need
   for further research and recommendations for urban development and
   spatial planning policy.},
