@article{ WOS:001647420300001,
Author = {Dushkova, Diana and Ignatieva, Maria},
Title = {Rethinking Urban Lawns: Rewilding and Other Nature-Based Alternatives},
Journal = {DIVERSITY-BASEL},
Year = {2025},
