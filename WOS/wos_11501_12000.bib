@article{ WOS:000470939600033,
Author = {Hu, Xin and Chong, Heap-Yih and Wang, Xiangyu},
Title = {Sustainability perceptions of off-site manufacturing stakeholders in
   Australia},
Journal = {JOURNAL OF CLEANER PRODUCTION},
