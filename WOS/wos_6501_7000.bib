@article{ WOS:001400353700001,
Author = {Brossette, Florian and Bieling, Claudia},
Title = {Connecting resonance theory with social-ecological thinking:
   Conceptualizing self-world relationships in the context of
   sustainability transformations},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {2},
Pages = {516-529},
Month = {FEB},
Abstract = {Relationships and interactions between humans and their environment play
   an important role in sustainability transformations. However, their
   conceptualization remains a big challenge in current social-ecological
   research. We propose resonance theory by the German sociologist Hartmut
   Rosa as a fruitful framework to advance social-ecological thinking.
   Resonance theory investigates the quality of the relationships between
   self and world and scrutinizes their relevance for transformations. To
   illustrate the potentials of resonance theory, we use a vignette
   approach to cases of landscape stewardship initiatives in the Black
   Forest Biosphere Reserve in Germany. In distinguishing between self and
   world and highlighting the role of relationships, resonance theory
   brings ontological and epistemological clarity, while overcoming a
   strict dichotomy between social and ecological. We find that resonance
   theory provides a much needed framework to describe how system-wide
   transformations emerge from interactions and out of relationships at the
   individual level. We argue that resonance theory contributes to
   social-ecological systems thinking by adding the notion of
   uncontrollability in transformations and shifting the debate on agency
   towards relationships. Synthesis and applications: This paper
   demonstrates the meaningfulness of relational paradigms for real-world
   transformations in theory and practice.Read the free Plain Language
   Summary for this article on the Journal blog.
   Die Beziehungen und Interaktionen zwischen den Menschen und ihrer Umwelt
   spielen eine wichtige Rolle bei Nachhaltigkeitstransformationen. Ihre
   Konzeptualisierung bleibt jedoch eine gro ss e Herausforderung in der
   aktuellen sozial-\& ouml;kologischen Forschung. Wir schlagen die
   Resonanztheorie des deutschen Soziologen Hartmut Rosa als einen
   fruchtbaren Rahmen vor, um sozial-\& ouml;kologisches Denken
   voranzubringen. Die Resonanztheorie untersucht die Qualit \& auml;t der
   Beziehungen zwischen Selbst und Welt und beleuchtet deren Bedeutung f \&
   uuml;r Transformationen. Um die M \& ouml;glichkeiten der
   Resonanztheorie zu veranschaulichen, wenden wir einen Vignetten-Ansatz
   auf Initiativen an, die sich f \& uuml;r die Erhaltung und
   Weiterentwicklung der Kulturlandschaft des Biosph \& auml;rengebiets
   Schwarzwald einbringen. Durch die Differenzierung zwischen Selbst und
   Welt und den Fokus auf die Bedeutung von Beziehungen bringt die
   Resonanztheorie ontologische und epistemologische Klarheit und \&
   uuml;berwindet gleichzeitig eine strikte Dichotomie zwischen sozialen
   und \& ouml;kologischen Dimensionen. Wir zeigen auf, dass die
   Resonanztheorie einen dringend ben \& ouml;tigten Rahmen bietet, um zu
   beschreiben, wie systemweite Transformationen aus Interaktionen und
   Beziehungen auf der individuellen Ebene hervorgehen. Wir argumentieren,
   dass die Resonanztheorie zum Denken in sozial-\& ouml;kologischen
   Systemen dadurch beitr \& auml;gt, dass sie die Idee der Unverf \&
   uuml;gbarkeit in Transformationen einbringt und die Debatte \& uuml;ber
   Agency auf Beziehungen verlagert. Synthese und Anwendungen: Dieses
   Papier zeigt die Bedeutung von Beziehungs-Paradigmen f \& uuml;r
   Transformationen in Theorie und Praxis.},
