@article{ WOS:000380049100033,
Author = {Kremer, Peleg and Hamstead, Zoe and Haase, Dagmar and McPhearson, Timon
   and Frantzeskaki, Niki and Andersson, Erik and Kabisch, Nadja and
   Larondelle, Neele and Rall, Emily L. and Voigt, Annette and Baro,
