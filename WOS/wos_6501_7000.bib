@article{ WOS:001742685800001,
Author = {Taillandier, Franck and Bakhou, Daniya and Baille, Claire},
Title = {Arbre Cite: A game to promote reflection on urban nature},
Journal = {CITIES},
Year = {2026},
Volume = {174},
Month = {JUL},
Abstract = {Urban areas are increasingly exposed to climatic and anthropogenic
   hazards, such as floods, heatwaves, droughts, and pollution. Urban
   nature is widely promoted to address these challenges, yet their
   implementation often raises debates and conflicts regarding forms,
   locations, and risks. We present Arbre Cite, a serious board game
   designed to foster awareness and reflection on urban nature. The game
   enables players to plan green spaces within their own neighborhoods,
   using OpenStreetMap data, while considering objectives, hazards, and
   tradeoffs. It was tested through 21 sessions with more than 70 players
   this year, using pre- and postquestionnaires. The game revealed
   significant evolution in players' perceptions: from aesthetic views of
   urban nature to systemic and ecological understandings, including risks
   and co-benefits. Results indicate that Arbre Cite may contribute to
   awareness-raising and offer an engaging approach to urban planning
   education. While results are limited by the sample composition, the
   replayability and adaptability of the game highlight its potential as a
   widely accessible support for nature integration in cities.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
