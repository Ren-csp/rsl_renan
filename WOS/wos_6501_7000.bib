@article{ WOS:001533985100001,
Author = {Lydon, Patrick M.},
Title = {Asking questions of nature: Art as a catalyst for ecological
   consciousness},
Journal = {NATURE-BASED SOLUTIONS},
Year = {2024},
Volume = {6},
Month = {DEC},
Abstract = {The challenge of breaking through preconceived societal norms and
   narratives is a common hurdle in advocating for transformative ideas.
   Cultural conditioning and the expectations placed on individuals and
   institutions are powerful forces, and they often keep new ways of seeing
   - and ideas like Nature-Based Solutions (NBS) - trapped in conventional
   patterns of thought and behavior. This paper suggests alternatives for
   connecting to these alternative ways of seeing through artist-led
   exhibitions and interventions that not only ask questions of nature, but
   also allow nature to ask questions of us. We look at five projects by
   City as Nature studio, including ``Forest is the Artist{''} an
   exhibition which gives agency to a Korean forest, and a concept
   restaurant ``World's Slowest Restaurant{''} where the artist makes
   customers wait for 6-8 weeks for their meal to be grown. Common to all
   of the artworks explored in this paper, is the view of nature as a
   partner. This view allows us to start from an acknowledgment of the
   human disconnect from nature, and proceed to explore the transformative
   potential of mending this disconnect by collaborating directly with
   nature in various ways. To achieve this, we use art as a way of giving
   human beings new stories, new spaces, and new social permissions that
   allow us to question norms and explore our own connection to the natural
   world. The outcomes suggest that the process of seeing ourselves as
   ``ecological beings{''} does not necessarily require complex or
   elaborate interventions, but merely the opportunity to pause, reflect,
   and interact with the world in more profound ways. Through the views,
   examples, and outcomes in this paper, we find simple methods available
   to both scientists and the public alike, that can help us adopt more
   sustainable and meaningful ways of seeing. A valuable perspective for
   NBS professionals, this paper also highlights how the success of NBS is
   tied not only to quantitative results, but also to each individual's
   ability to foster real relationships, a sense of belonging, awe, and
   reverence for and with all of nature. It also suggests that this is
   achievable.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Lydon, PM (Corresponding Author), City Nat, Creat Urban Ecol Lab, Daejeon, South Korea.
   Lydon, Patrick M., City Nat, Creat Urban Ecol Lab, Daejeon, South Korea.},
DOI = {10.1016/j.nbsj.2024.100138},
Article-Number = {100138},
EISSN = {2772-4115},
Keywords = {Nature-based solutions; Ecological art; Interdisciplinary art;
   Art-science collaboration; Transformative experiences; Sustainability
   narratives; Environmental perception},
Research-Areas = {Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Environmental Sciences},
Author-Email = {patrick@cityasnature.org},
Funding-Acknowledgement = {Chishima Foundation for Creative Osaka; Robert Callender International
   Residency for Young Artists},
Funding-Text = {A special note of thanks to the editor Changwoo Ahn, for deeply
   believing in the value of this work, and for continually pushing me to
   see that value, too. Changwoo's insightful reviews, comments and
   suggestions on various early drafts of this manuscript helped drag these
   ideas into a more beautiful and useful place. Also, thank you to Suhee
   and Henri for their suggestions, to David Maddox at The Nature of Cities
   for his constant support and guidance, and to all of the individuals
   involved in the projects themselves. The examples explored in this
   article could not have been accomplished without collaboration and
   support from the communities in which they took place. We would like to
   make known our deep gratitude for those communities and individuals. The
   film, Final Straw: Food, Earth, Happiness was produced on a shoestring
   budget, with support of hundreds of individuals and dozens of
   institutions and community organizations. We would like to recognize the
   extraordinary support of Yoshikazu Kawaguchi and Larry Korn, two of our
   greatest supporters and purveyors of wisdom during the filmmaking
   process, who have both since passed from this world. Thanks also to the
   entire cast, Seong Hyun Choi, Kristyn Leach, Etsuko Kagamiyama, Ryosok
   Hong, Maki Sobajima, Kenji Murakami, Yoshiki Yamamoto, Osamu Kita,
   Kazuaki Okitsu, Dennis Lee, and to Tim Collins, Reiko Goto, Chris
   Fremantle, Ross McLean, and Donald Urquhart at the Art, Space \& Nature
   programme at The University of Edinburgh, Edinburgh College of Art, Isao
   Suizu at Aichi University of Art, co-producer Kaori Tsuji, animator
   Heeyoung Park, and musicians WindSync, Bomnunbyeol Kim, Joyful Island,
   Youji Kohno, and Ben Nakamura. REALtimeFOOD was sponsored in part by
   grants from the Chishima Foundation for Creative Osaka (
   (sic)(sic)(sic)(sic)ji(sic)(R) 0), and the Robert Callender
   International Residency for Young Artists, with administrative support
   from Ikumasa Hayashi, Yasutaka Kaneda, and the MinnaNouen urban
   agriculture association. Forest is the Artist was the product of our
   friendship with Gomsil Forest and the farmer Choi SeongHyun who is the
   farmer and caretaker of the land. We would like to thank the pioneering
   gallery PlaceMAK in Seoul, whose curators accepted the wild idea of
   holding an exhibition of works by and for a forest. A City Designed by
   Trees was commissioned by the Daejeon Museum of Art for the 2022 Daejeon
   Art and Science Biennale as part of the City Project. A special thank
   you to the entire museum staff, to the hundreds of community members in
   Daejeon who contributed their tree stories to the exhibition, and to
   Booyoung Seo of From the Corner gallery for his guidance and support in
   the process. The ``Possible{''} series of illustrated stories is
   entirely reader supported. It continues with the support of the
   individuals and communities that these stories are based on, and the
   generous subscribers around the world. In all of this work, I wish to
   especially thank Suhee Kang, my partner in nature and life, for
   supporting, pushing, devising, and refining the craziest of my ideas in
   ways that ultimately make them achievable. Without her companionship and
   work as a co-conspirator, these projects would not have been possible.},
