@article{ WOS:001707247300001,
Author = {Ataee, Sina and Abdolabadi, Hamid and Aval, Farzaneh Abedian and
   Bhandari, Santosh and Mahjoobi, Emad and Relvas, Helder and Lopes,
   Myriam},
Title = {Risk governance in urban planning: A comprehensive policy analysis in
   the Old Oak and Park Royal Development Corporation Plan, London},
Journal = {LAND USE POLICY},
Year = {2026},
Volume = {165},
Month = {JUN},
Abstract = {Effective risk management is essential for large-scale urban development
   projects to mitigate potential threats and enhance resilience. This
   study examines the risk governance strategies embedded in the Old Oak
   and Park Royal Development Corporation (OPDC) plan in London, England,
   providing a structured analysis of its risk management framework. The
   research categorizes risks into five core areas, identification,
   assessment, mitigation, response, and monitoring, aligning with
   contemporary risk governance models. The OPDC plan demonstrates a strong
   commitment to proactive and adaptive risk strategies by integrating
   sustainability, stakeholder engagement, and contingency planning. Key
   risk factors, including environmental hazards, infrastructure
   vulnerabilities, housing policies, and socio-economic uncertainties, are
   systematically assessed.Findings indicate that the OPDC plan effectively
   incorporates both preventative and responsive risk measures, emphasizing
   sustainable urban design, environmental resilience, and regulatory
   compliance. Additionally, risk response mechanisms such as contingency
   planning and crisis management enhance adaptability to evolving urban
   challenges. However, gaps remain in adaptive governance, particularly in
   real-time risk tracking and cross-sectoral coordination. This study
   highlights the necessity of continuous risk evaluation and dynamic
   policy adjustments to strengthen urban resilience. Insights from this
   research offer valuable lessons for policymakers, urban planners, and
   practitioners seeking to integrate robust risk governance frameworks
   into urban development initiatives. The findings underscore the
   importance of a comprehensive, stakeholder-inclusive, and
   sustainability-driven approach to urban risk management, contributing to
   long-term urban resilience and effective policy implementation.},
