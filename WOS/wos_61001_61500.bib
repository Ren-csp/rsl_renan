@article{ WOS:A1984SG91400003,
Author = {RAKERD, B},
Title = {VOWELS IN CONSONANTAL CONTEXT ARE PERCEIVED MORE LINGUISTICALLY THAN ARE
   ISOLATED VOWELS - EVIDENCE FROM AN INDIVIDUAL-DIFFERENCES SCALING STUDY},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1984},
Volume = {35},
Number = {2},
Pages = {123-136},
Abstract = {This study sought to determine whether the presence of neighboring
   consonants can exert a contextual influence on vowel perception and, if
   so, to characterize the influence. Subjects were asked to judge the
   linguistic similarity relationships that held among a set of American
   English vowels when those vowels occurred either in isolation or in
   /dVd/ consonantal context. In experiment 1, the judgments were made in
   response to recordings of natural speech. In experiment 2, they were
   made for  subjects'' memorial images of vowels as elicited by written
   stimuli. Individual differences scaling of the outcomes of the 2
   experiments provided evidence that supported the following conclusions:
   consonantal context can significantly influence vowel perception; for
   the /dVd/ context at least, the nature of the influence is to evoke more
   linguistic perceptual processing of vowels than occurs when they are
   presented in isolation; the influence is more likely to be explained in
   terms of properties of the stimuli presented to perceivers than in terms
   of any sort of knowledge that perceivers bring to bear in perceptual
   processing; and 3 features of linguistic description for vowels,
   advancement, height, and tenseness have particular import for vowel
   perception and for vowel memory.},
