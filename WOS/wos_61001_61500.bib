@article{ WOS:000727618000012,
Author = {Png, Grace and Barysenka, Andrei and Repetto, Linda and Navarro, Pau and
   Shen, Xia and Pietzner, Maik and Wheeler, Eleanor and Wareham, Nicholas
   J. and Langenberg, Claudia and Tsafantakis, Emmanouil and Karaleftheri,
