@article{ WOS:001116632100001,
Author = {Scalfi, Graziele and Massarani, Luisa and Goncalves, Waneicy and Chagas,
   Adriana Aparecida Andrade and Bizerra, Alessandra},
Title = {Emotional responses from families visiting the zoo: a study at Parque
   das Aves in Foz do Iguaçu},
Journal = {JCOM-JOURNAL OF SCIENCE COMMUNICATION},
Year = {2023},
Volume = {22},
Number = {5},
Abstract = {In this study, we aim to analyse human emotional responses towards
   animals, specifically birds, in the context of a visit to a zoo. The
   study was carried out with seven families in Parque das Aves. The visits
   were recorded using the point-of-view-camera method, and the data was
   analysed using qualitative software to identify emotion descriptors. The
   findings from our study reveal that the physical characteristics of
   birds, such as their patterns and colours, as well as their behaviours
   and abilities, triggered emotional responses that were associated with
   admiration for the species, concern for their well-being and awareness
   of conservation issues, enabling these families to construct meaning.},
Publisher = {SCUOLA INT SUPERIORE STUDI AVANZATI-S I S S A-INT SCH ADVANCED STUDIES},
