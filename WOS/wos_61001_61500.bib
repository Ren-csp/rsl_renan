@article{ WOS:001587317500004,
Author = {Panthee, Keshav Raj and Noppradit, Prakrit},
Title = {RESPONSE TO ENERGY EFFICIENCY PRACTICES BY NEPALESE ENTERPRISES},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
