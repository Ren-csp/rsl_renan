@article{ WOS:001819051400001,
Author = {Deng, Xuefei and Estell, Pamela and Wang, Tawei},
Title = {Understanding worker psychological well-being and perceived support on a
   digital labor platform: The worker perspective},
Journal = {COMPUTERS IN HUMAN BEHAVIOR REPORTS},
Year = {2026},
Volume = {23},
Month = {AUG},
Abstract = {Adopting the job demands-resources model as a theoretical lens, this
   study investigated worker well-being and perceived organizational
   support in the gig work environment through a mixed-methods approach.
   First, we performed quantitative analyses to examine the relationships
   between three types of perceived support and worker psychological
   well-being (PWB), and the moderating effect of worker characteristics.
   The quantitative analysis of survey data collected from 130 registered
   workers on Amazon Mechanical Turk indicated that perceived support from
   platforms and job requesters had a positive, significant effect on
   worker PWB, whereas support from online communities had a nonsignificant
   effect. Moreover, the positive, significant effects of platform and job
   requester support remained the same for master and novice workers, but
   the effect size was slightly larger for novice workers. Furthermore, the
   positive effect of platform support on worker PWB differed between the
   two subsamples characterized by levels of income dependence. To
   substantiate the results of the quantitative study, we conducted a
   supplemental, qualitative study to explore the types of worker-perceived
   support in the gig work environment. Specifically, the insignificant
   result related to peer support in online communities in the quantitative
   study motivated us to further examine workers' engagement in online
   communities. Our qualitative analysis revealed five types of
   work-related support that gig workers seek from online forums,
   indicating the multifaceted nature of the support system that gig
   workers have built through online communities. These findings provide
   insights into the gig worker lived experiences on digital labor
   platforms and can inform future gig work research.},
