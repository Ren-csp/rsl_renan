@article{ WOS:001786056200001,
Author = {Brien, Donna Lee},
Title = {Motorsports, minigolf and ice skating: tracing the histories of some
   lesser-known sports at Bondi beach},
Journal = {SPORT IN SOCIETY},
Year = {2026},
Volume = {29},
Number = {5, SI},
Pages = {901-912},
Month = {MAY 4},
Abstract = {The prominent competitive sport associated with Australia's Bondi Beach
   is the surf carnival, comprising group and individual surf events. Well
   known and long-lived recreational sports include surfboard riding, and
   swimming in the surf and the famous ocean baths. This article focuses
   instead on several sports underrepresented in histories of Bondi Beach
   to expand knowledge about these sports and the part they have played in
   the social and cultural history of the area. As both the underlying
   research and the imagery in this presentation rely heavily on
   representations in popular culture, this study confirms the richness of
   popular culture as a source for writing historical narratives.},
