@article{ WOS:000279366300028,
Author = {Young, Sera L. and Khalfan, Sabra S. and Farag, Tamer H. and Kavle,
   Justine A. and Ali, Said M. and Hajji, Hamad and Rasmussen, Kathleen M.
   and Pelto, Gretel H. and Tielsch, James M. and Stoltzfus, Rebecca J.},
Title = {Association of Pica with Anemia and Gastrointestinal Distress among
   Pregnant Women in Zanzibar, Tanzania},
Journal = {AMERICAN JOURNAL OF TROPICAL MEDICINE AND HYGIENE},
Year = {2010},
Volume = {83},
Number = {1},
Pages = {144-151},
Month = {JUL},
Abstract = {The etiology of pica, the purposive consumption of non-food substances,
   is not understood, despite its ubiquity among gravidae. We examined
   correlates of pica in a representative obstetric population (n = 2,368)
   on Pemba Island, Zanzibar,Tanzania to examine proposed etiologies.
   Cross-sectional data were collected on socioeconomic characteristics,
   food intake, geophagy (earth consumption), amylophagy (raw starch
   consumption), anthropometry, iron status, parasitic burden, and
   gastrointestinal morbidities. Amylophagy was reported by 36.3\%,
   geophagy by 5.2\%, and any pica by 40.1\%. There was a strong additive
   relationship of geophagy and amylophagy with lower hemoglobin (Hb)
   concentration and iron deficiency anemia. By multivariate logistic
   regression, any pica was associated with Hb level (odds ratio {[}OR] =
   0.76, 95\% confidence interval {[}CI] = 0.72-0.81), nausea (OR =
   1.45,95\% CI = 1.20-1.73), and abdominal pain (OR = 1.22,95\% CI =
   11.01-1.48). These striking results indicate that the nature of the
   relationship between pica, pregnancy, gastrointestinal distress, and
   iron deficiency anemia merits further investigation.},
