@article{ WOS:000089486200007,
Author = {Cholewiak, RW and Collins, AA},
Title = {The generation of vibrotactile patterns on a linear array: Influences of
   body site, time, and presentation mode},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
