   Guennoun, F. Z.; Mostakim, L.; Ghamizi, M., Cadi Ayyad Univ, Museum Nat Hist, Res Ctr, Marrakech, Morocco.
   Guennoun, F. Z.; Mostakim, L.; Ghamizi, M., Cadi Ayyad Univ, Lab Water Biodivers \& Climate Change, Fac Sci Semlalia, BP 2390, Marrakech 40000, Morocco.},
DOI = {10.15666/aeer/2103\_19571978},
