@article{ WOS:000662809200015,
Author = {Kim, Cheolmin and Ryu, Dong-Kyun and Lee, Jihun and Kim, Young-Il and
   Seo, Ji-Min and Kim, Yeon-Gil and Jeong, Jae-Hee and Kim, Minsoo and
   Kim, Jong-In and Kim, Pankyeom and Bae, Jin Soo and Shim, Eun Yeong and
   Lee, Min Seob and Kim, Man Su and Noh, Hanmi and Park, Geun-Soo and
   Park, Jae Sang and Son, Dain and An, Yongjin and Lee, Jeong No and Kwon,
   Ki-Sung and Lee, Joo-Yeon and Lee, Hansaem and Yang, Jeong-Sun and Kim,
   Kyung-Chang and Kim, Sung Soon and Woo, Hye-Min and Kim, Jun-Won and
   Park, Man-Seong and Yu, Kwang-Min and Kim, Se-Mi and Kim, Eun-Ha and
   Park, Su-Jin and Jeong, Seong Tae and Yu, Chi Ho and Song, Youngjo and
   Gu, Se Hun and Oh, Hanseul and Koo, Bon-Sang and Hong, Jung Joo and Ryu,
   Choong-Min and Park, Wan Beom and Oh, Myoung-don and Choi, Young Ki and
   Lee, Soo-Young},
Title = {A therapeutic neutralizing antibody targeting receptor binding domain of
   SARS-CoV-2 spike protein},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {JAN 12},
Abstract = {Vaccines and therapeutics are urgently needed for the pandemic caused by
   severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2). Here, we
   screen human monoclonal antibodies (mAb) targeting the receptor binding
   domain (RBD) of the viral spike protein via antibody library constructed
   from peripheral blood mononuclear cells of a convalescent patient. The
   CT-P59 mAb potently neutralizes SARS-CoV-2 isolates including the D614G
   variant without antibody-dependent enhancement effect. Complex crystal
   structure of CT-P59 Fab/RBD shows that CT-P59 blocks interaction regions
   of RBD for angiotensin converting enzyme 2 (ACE2) receptor with an
   orientation that is notably different from previously reported
   RBD-targeting mAbs. Furthermore, therapeutic effects of CT-P59 are
   evaluated in three animal models (ferret, hamster, and rhesus monkey),
   demonstrating a substantial reduction in viral titer along with
   alleviation of clinical symptoms. Therefore, CT-P59 may be a promising
   therapeutic candidate for COVID-19.},
