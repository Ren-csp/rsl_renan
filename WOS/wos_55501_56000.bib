ISSN = {0018-7267},
EISSN = {1741-282X},
Keywords = {conservation of resource theory; in- and extra-role performance;
   self-regulation; subjective vitality; theories about willpower; work
   engagement},
Keywords-Plus = {TRAIT SELF-CONTROL; EGO-DEPLETION; IMPLICIT THEORIES; PSYCHOLOGICAL
