@article{ WOS:001538475100001,
Author = {Konig, Anna Lena and Bossow-Thies, Silvia and Krol, Bianca},
Title = {Female mobility-An empirical analysis of factors influencing women's
   acceptance of Robo-Taxis using PLS-SEM},
Journal = {TRANSPORTATION RESEARCH PART F-TRAFFIC PSYCHOLOGY AND BEHAVIOUR},
Year = {2025},
Volume = {114},
Pages = {933-952},
Month = {OCT},
Abstract = {Robo-taxis, as a form of autonomous on-demand transport service, are
   poised to transform personal transportation by reducing traffic-related
   risks, lowering environmental burdens, and improving accessibility.
   However, the extent to which these technologies are adopted on a broad
   scale is contingent not solely on their technical efficacy but also on a
   comprehensive understanding of the psychological factors that influence
   user acceptance, particularly among demographic groups that are
   historically underrepresented in the context of mobility concept
   development. Given that women comprise approximately 50\% of the
   population and often face unique mobility needs, it is critical to
   investigate their acceptance motivations for inclusive and equitable
   transport design. However, gender-specific adoption behavior in the
   context of robotaxis remains an under-explored area. This study aims to
   address this research gap by examining which value-based factors
   influence women's intention to use robo-taxis. To examine this, we
   extend the Value-based Adoption Model (VAM) to include nine acceptance
   variables and apply structural equation modeling to a sample of 559
   female respondents in Germany. The results of the study indicate that
   perceived compatibility, usefulness, and enjoyment significantly enhance
   the perceived value of robo-taxis, while perceived costs act as a
   barrier. Conversely, it was found that the perception of technical
   safety, concerns about system reliability and data protection have a
   negligible influence. These outcomes underscore the importance of
   perceived lifestyle congruence and intrinsic motivation over
   technological skepticism in shaping attitudes toward autonomous
   transport. The research findings help to achieve wider adoption and
   prevent a gender mobility gap in robo-taxi services.},
