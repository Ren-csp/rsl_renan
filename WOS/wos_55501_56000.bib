@article{ WOS:000678696500013,
Author = {Alumran, Arwa and Almutawa, Hanadi and Alzain, Zainab and Althumairi,
   Arwa and Khalid, Nauman},
Title = {Comparing public and private hospitals' service quality},
Journal = {JOURNAL OF PUBLIC HEALTH-HEIDELBERG},
Year = {2021},
Volume = {29},
Number = {4},
Pages = {839-845},
Month = {AUG},
Abstract = {Background Saudi Arabia's health care system has undergone major changes
   in recent years to enhance the quality of the services it renders to the
   community. This study is designed to measure the quality of health care
   services from the patients' perspective and to compare the service
   quality of public and private hospitals in the eastern region of Saudi
   Arabia. Methods The study has a quantitative cross-sectional design,
   with a questionnaire based on the SERVQUAL dimensional model. It was a
   random sample of 258 inpatients at private and public hospitals in
   Eastern Saudi Arabia. Results Patients at private hospitals perceived a
   higher level of quality of the health care services (t = 3.390, p <
   0.01). Conclusions Further research on the financial and leadership
   dimensions of health care quality will contribute to improved planning
   for health care services.},
