@article{ WOS:001852861000001,
Author = {Raymond, Sage and Montgomery, Juno and Cassady St. Clair, Colleen},
Title = {Denning coyotes (Canis latrans) select fine-scale habitat
   characteristics that promote den stability in a protected area},
Journal = {JOURNAL OF MAMMALOGY},
Year = {2026},
Month = {2026 AUG 19},
Abstract = {Den selection is critical to reproductive success and offspring survival
   in many mammal species, but little is known about den site selection by
   wild coyotes (Canis latrans) outside of urban contexts. We examined the
   third- and fourth-order habitat characteristics of 42 Coyote dens in Elk
   Island National Park, a protected natural area in central Alberta,
   Canada. Using resource selection functions, we evaluated 3 hypotheses:
   that coyotes select dens based on (i) physical den suitability; (ii)
   security from predators, people, or dogs; and (iii) access to food and
   water resources. Coyotes exhibited strong fourth-order selection for
   dens with cohesive, inorganic soils and steep slopes that promote
   structural integrity and drainage. Structural supports such as roots and
   abandoned but persisting Beaver (Castor canadensis) infrastructure were
   common. We found limited evidence of selection for features that
   promoted security, contrasting other studies that found security to be
   an important predictor of den sites. We found no evidence for selection
   based on local resource availability. Our findings indicate that
   fine-scale habitat features related to den stability are the primary
   drivers of den site selection in wild coyotes in this ecosystem and
   suggest that den selection is flexible and context-dependent in response
   to local environmental pressures.
   La selecci \& oacute;n de madrigueras es crucial para el \& eacute;xito
   reproductivo y la supervivencia de las cr \& iacute;as en muchas
   especies de mam \& iacute;feros, pero se sabe poco sobre la selecci \&
   oacute;n de madrigueras por parte de los coyotes salvajes (Canis
   latrans) fuera de los entornos urbanos. Examinamos las caracter \&
   iacute;sticas de h \& aacute;bitat de tercer y cuarto orden de 42
   madrigueras de coyotes en el Parque Nacional Elk Island, un \&
   aacute;rea natural protegida en el centro de Alberta, Canad \& aacute;.
   Mediante funciones de selecci \& oacute;n de recursos, evaluamos tres
   hip \& oacute;tesis: que los coyotes seleccionan madrigueras en funci \&
   oacute;n de (1) la idoneidad f \& iacute;sica de la madriguera, (2) la
   seguridad frente a depredadores, personas o perros, y (3) el acceso a
   recursos alimenticios y h \& iacute;dricos. Los coyotes mostraron una
   fuerte selecci \& oacute;n de cuarto orden por madrigueras con suelos
   cohesivos e inorg \& aacute;nicos y pendientes pronunciadas que
   favorecen la integridad estructural y el drenaje. Los soportes
   estructurales, como ra \& iacute;ces e infraestructura de castores
   (Castor canadensis) abandonada pero persistente, eran comunes.
   Encontramos cierta evidencia de selecci \& oacute;n por caracter \&
   iacute;sticas que promov \& iacute;an la seguridad, en contraste con
   otros estudios que encontraron que la seguridad es un predictor
   importante de la ubicaci \& oacute;n de las madrigueras. No encontramos
   evidencia de selecci \& oacute;n basada en la disponibilidad de recursos
   locales. Nuestros hallazgos indican que las caracter \& iacute;sticas
   del h \& aacute;bitat a peque \& ntilde;a escala relacionadas con la
   estabilidad de las madrigueras son los principales factores que influyen
   en la selecci \& oacute;n del lugar de construcci \& oacute;n de las
   madrigueras en los coyotes salvajes de este ecosistema, y sugieren que
   dicha selecci \& oacute;n es flexible y depende del contexto en
   respuesta a las presiones ambientales locales.},
