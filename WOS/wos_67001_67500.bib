@article{ WOS:001817290100001,
Author = {Weerawansa, S. R. S. D. K. and Hewage, T. u. and Pathirana, H. P. A. S.},
Title = {Branding the city through the tourist gaze: evidence from Jaffna, Sri
   Lanka},
Journal = {FRONTIERS IN SUSTAINABLE TOURISM},
Year = {2026},
Volume = {5},
Month = {JUN 29},
Abstract = {This study examines how tourist gaze theory can contribute to the
   development of effective city branding strategies taking the city of
   Jaffna, Sri Lanka as a case study. By examining how tourists perceive
   and visually engage with the city's landscape, cultural symbols, and
   heritage sites, the study identifies the dominant gazes shaping visitor
   experiences. Then the ways these gazes can effectively be used to create
   a successful branding and promotional campaign to make Jaffna a
   distinctive urban tourism destination are analyzed. The study follows
   qualitative approaches with a cross-sectional design and inductive
   procedures. Primary data collection is based on extracting information
   from tourists, professionals, business leaders, officials, and other
   stakeholders, chosen through ``purposive{''} sampling, connected to the
   industry through in-depth interviews and focus groups. Secondary data is
   collected from numerous journal articles and other accepted material
   that have been published in the past. Case studies are also used to
   highlight the strategies that have been used by a few cities around the
   world. By integrating insights from tourist gaze theory with city
   branding research, this study aims to contribute both to tourism theory
   and to practical destination development strategies. The research
   identifies the dominant forms of tourist gaze shaping visitor
   perceptions of the destination, including cultural, religious,
   environmental, and historical gazes. The findings reveal that tourism in
   Jaffna is structured around multiple and evolving gazes, reflecting the
   city's unique cultural identity, heritage assets, and post-conflict
   transformation. However, significant challenges related to
   infrastructure, accessibility, governance, and market positioning limit
   the city's ability to fully capitalize on these assets. The study argues
   that effective city branding requires aligning branding strategies with
   the elements that attract and sustain the tourist gaze, while ensuring
   that the destination experience matches the projected image. By
   integrating tourist gaze theory with city branding, this research
   contributes to both tourism theory and practice, offering insights for
   developing sustainable and culturally grounded branding strategies in
   emerging tourism destinations.},
