@article{ WOS:000262852200044,
Author = {Roy, Koushik and Hilliard, George M. and Hamilton, David J. and Luo,
   Jiwen and Ostmann, Marguerite M. and Fleckenstein, James M.},
Title = {Enterotoxigenic Escherichia coli EtpA mediates adhesion between
   flagella and host cells},
