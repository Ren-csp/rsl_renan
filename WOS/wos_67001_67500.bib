@article{ WOS:000363020100010,
Author = {Boettcher, Jan P. and Beyer, Marc and Meissner, Felix and Abdullah,
   Zeinab and Sander, Jil and Hoechst, Bastian and Eickhoff, Sarah and
   Rieckmann, Jan C. and Russo, Caroline and Bauer, Tanja and Flecken,
   Tobias and Giesen, Dominik and Engel, Daniel and Jung, Steffen and
   Busch, Dirk H. and Protzer, Ulrike and Thimme, Robert and Mann, Matthias
   and Kurts, Christian and Schultze, Joachim L. and Kastenmueller,
   Wolfgang and Knolle, Percy A.},
Title = {Functional classification of memory CD8+ T cells by
   CX3CR1 expression},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {SEP},
Abstract = {Localization of memory CD8(+) T cells to lymphoid or peripheral tissues
   is believed to correlate with proliferative capacity or effector
   function. Here we demonstrate that the fractalkine-receptor/CX(3)CR1
   distinguishes memory CD8(+) T cells with cytotoxic effector function
   from those with proliferative capacity, independent of tissue-homing
   properties. CX(3)CR1-based transcriptome and proteome-profiling defines
   a core signature of memory CD8(+) T cells with effector function. We
   find CD62L(hi)CX(3)CR1(+) memory T cells that reside within lymph nodes.
   This population shows distinct migration patterns and positioning in
   proximity to pathogen entry sites. Virus-specific CX(3)CR1(+) memory
   CD8(+) T cells are scarce during chronic infection in humans and mice
   but increase when infection is controlled spontaneously or by
   therapeutic intervention. This CX3CR1-based functional classification
