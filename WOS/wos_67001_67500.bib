@article{ WOS:001620530800006,
Author = {Zhou, Hui and Tao, Le and Zhao, Yinhui and He, Haifeng and Shi, Hong and
   Yu, Tengsong and Guo, Yaozheng and He, Yaoxi and Liu, Hong and Wu, Yun
   and Cao, Jiayong and Kuang, Zhenyu and Wu, Shifeng and Lin, Fuchun and
   Yang, Yundong and Xiong, Lifeng and Liu, Yilan and Zhu, Kongyang and Xu,
   Yu and Huang, Shengmin and Yang, Xiaomin and Wang, Rui and Wang, Baitong
   and Wang, Xian and Lu, Wen-Jing and Kutanan, Wibhu and Shoocongdej,
   Rasmi and Su, Bing and Wang, Chuan-Chao and Ji, Xueping and Zhang,
   Xiaoming},
Title = {Exploration of hanging coffin customs and the bo people in China through
   comparative genomics},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {NOV 20},
Abstract = {The Hanging Coffin represents a distinctive mortuary tradition practiced
   across southern China, Southeast Asia (e.g., the Log Coffin), and the
   Pacific approximately 3,000 years. Historical records attribute this
   funerary practice to the Bo people, a group that largely disappeared
   from documented history by the end of the Ming Dynasty (1,368-1,644 AD).
   Here we report eleven ancient genomes from four Hanging Coffin sites in
   China, alongside thirty whole genomes from the extant Bo people in
   Southwest China. We also sequence four ancient genomes from Log Coffin
   sites in northwestern Thailand. Our findings indicate that present-day
   Bo people derive a substantial proportion of their ancestry from
   practitioners of the Hanging Coffin mortuary tradition. Both ancient and
   modern groups exhibit elevated genetic affinity with coastal Neolithic
   populations from southern East Asia, who are ancestral to Tai-Kadai and
   Austronesian speakers. Unexpectedly, we also find evidence of long-range
   interactions and cultural inclusivity between Northeast Asian and Yellow
   River farmers and Hanging Coffin communities over 1,200 years ago.
   Finally, shared genetic components between Hanging (Log) Coffin
   populations in China and Thailand point to a common origin and a broader
   genetic and cultural network underlying this distinctive mortuary
   tradition across southern China and Southeast Asia.},
