@article{ WOS:000311953200030,
Author = {Shev, Aaron and Hsieh, Fushing and Beisner, Brianne and McCowan, Brenda},
Title = {Using Markov chain Monte Carlo (MCMC) to visualize and test the
   linearity assumption of the Bradley-Terry class of models},
Journal = {ANIMAL BEHAVIOUR},
Year = {2012},
