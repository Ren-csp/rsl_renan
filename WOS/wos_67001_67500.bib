@article{ WOS:000261768300038,
Author = {Wang, Yanli and Juranek, Stefan and Li, Haitao and Sheng, Gang and
   Tuschl, Thomas and Patel, Dinshaw J.},
Title = {Structure of an argonaute silencing complex with a seed-containing guide
   DNA and target RNA duplex},
