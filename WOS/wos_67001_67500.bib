   Sehyr, Zed Sevcikova; Emmorey, Karen, San Diego State Univ, Sch Speech Language \& Hearing Sci, San Diego, CA 92182 USA.
   Midgley, Katherine J. J.; Holcomb, Phillip J. J., San Diego State Univ, Dept Psychol, San Diego, CA USA.},
DOI = {10.1162/nol\_a\_00104},
