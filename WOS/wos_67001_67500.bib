@article{ WOS:000285310100002,
Author = {Encinas, Juan M. and Hamani, Clement and Lozano, Andres M. and
   Enikolopov, Grigori},
Title = {Neurogenic Hippocampal Targets of Deep Brain Stimulation},
Journal = {JOURNAL OF COMPARATIVE NEUROLOGY},
