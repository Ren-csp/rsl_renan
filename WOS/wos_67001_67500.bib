@article{ WOS:001248267400007,
Author = {Chan, Yat Ho and Pathmasiri, Koralege C. and Pierre-Jacques, Dominick
   and Hibbard, Maddison C. and Tao, Nannan and Fischer, Joshua L. and
   Yang, Ethan and Cologna, Stephanie M. and Gao, Ruixuan},
Title = {Gel-assisted mass spectrometry imaging enables sub-micrometer spatial
   lipidomics},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JUN 12},
Abstract = {A technique capable of label-free detection, mass spectrometry imaging
   (MSI) is a powerful tool for spatial investigation of native
   biomolecules in intact specimens. However, MSI has often been precluded
   from single-cell applications due to the spatial resolution limit set
   forth by the physical and instrumental constraints of the method. By
   taking advantage of the reversible interaction between the analytes and
   a superabsorbent hydrogel, we have developed a sample preparation and
   imaging workflow named Gel-Assisted Mass Spectrometry Imaging (GAMSI) to
   overcome the spatial resolution limits of modern mass spectrometers.
   With GAMSI, we show that the spatial resolution of MALDI-MSI can be
   enhanced similar to 3-6-fold to the sub-micrometer level without
   changing the existing mass spectrometry hardware or analysis pipeline.
   This approach will vastly enhance the accessibility of MSI-based spatial
   analysis at the cellular scale.},
