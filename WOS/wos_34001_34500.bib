@article{ WOS:001871422900001,
Author = {Noh, Youngre and Park, Chan Young},
Title = {Green infrastructure and housing prices: Heterogeneous effects and
   sensitivity to modeling choices},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {125},
Month = {NOV},
Abstract = {Green infrastructure (GI) is often expected to raise nearby property
   values, a benefit that can displace lowerincome residents through green
   gentrification. This study asks whether that expectation holds once
   nonlinear, machine-learning-based methods replace the linear
   specifications in conventional hedonic and difference-indifferences
   (DID) models, especially in weak-demand legacy cities. Comparing
   traditional OLS-DID against Double Machine Learning (DML) across four GI
   projects in Cleveland, a shrinking, post-industrial city, this study
   finds that where OLS-DID is significant, DML typically agrees in sign
   but at a smaller magnitude. For one project, however, the two estimators
   diverge sharply in direction, showing that functional form can change a
   capitalization estimate's substantive conclusion, not just its size.
   Results differ sharply by project. Lake Link Trail shows the study's one
   significant, positive pooled effect, approximately 25 \%, though a
   pre-existing trend and an unresolved income-specific pattern warrant
   caution. The Lakefront Nature Preserve shows no significant effect in
   either direction, the weakest evidence of the four. Mill Creek Falls
   Park is near-null overall but reveals a significant, localized decline,
   approximately 12 \%, for low-income households. Acacia Reservation
   supplies the study's central finding, a sign flip from a small positive
   OLS-DID estimate, approximately 4 \%, to a significant negative DML
   estimate, approximately 18 \%, in this stable, middle- to upper-income
   suburban setting. GI does not uniformly generate green gentrification.
   Effects vary in direction and magnitude across space and socioeconomic
   context, underscoring the need to monitor each project's distributional
   consequences rather than assume them from the broader literature.},
