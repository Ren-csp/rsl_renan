@article{ WOS:000593214100003,
Author = {Levy, Becca R. and Slade, Martin D. and Pietrzak, Robert H. and
   Ferrucci, Luigi},
Title = {When Culture Influences Genes: Positive Age Beliefs Amplify the
   Cognitive-Aging Benefit of APOE ε2},
Journal = {JOURNALS OF GERONTOLOGY SERIES B-PSYCHOLOGICAL SCIENCES AND SOCIAL
   SCIENCES},
Year = {2020},
Volume = {75},
Number = {8},
Pages = {E198-E203},
Month = {OCT},
Abstract = {Objectives: Most studies of aging cognition have focused on risk factors
   for worse performance and on either genetic or environmental factors. In
   contrast, we examined whether 2 factors known to individually benefit
   aging cognition may interact to produce better cognition:
   environment-based positive age beliefs and the APOE epsilon 2 gene.
   Method: The sample consisted of 3,895 Health and Retirement Study
   participants who were 60 years or older at baseline and completed as
   many as 5 assessments of cognition over 8 years.
   Results: As predicted, positive age beliefs amplified the cognitive
   benefit of APOE epsilon 2. In contrast, negative age beliefs suppressed
   the cognitive benefit of APOE epsilon 2. We also found that positive age
   beliefs contributed nearly 15 times more than APOE epsilon 2 to better
   cognition.
   Discussion: This study provides the first known evidence that
   self-perceptions can influence the impact of a gene on cognition. The
   results underscore the importance of combined psychosocial and
   biological approaches to understanding cognitive function in older
   adults.},
