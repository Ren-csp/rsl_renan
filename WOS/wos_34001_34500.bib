@article{ WOS:001597486100002,
Author = {Ho, Yu-Hsuan and Liu, Zhewei and Lee, Cheng-Chun and Mostafavi, Ali},
Title = {ML4EJ: Decoding the role of urban features in shaping environmental
   injustice using interpretable machine learning},
Journal = {CITIES},
Year = {2026},
Volume = {169},
Month = {FEB},
Abstract = {Understanding the key factors shaping environmental hazard exposures and
   their associated environmental injustice issues is vital for formulating
   equitable policy measures. Traditional perspectives on environmental
   injustice have primarily focused on the socioeconomic dimensions, often
   overlooking the influence of heterogeneous urban characteristics. This
   limited view may obstruct a comprehensive understanding of the complex
   nature of environmental justice and its relationship with urban design
   features. To address this gap, this study introduces two primary
   contributions. First, this study develops an interpretable machine
   learning framework to examine the effects of various urban features,
   including the built environment, land cover, and human mobility, and
   socio-demographic and their non-linear interactions to the exposure
   disparities of three primary hazards: air pollution, urban heat, and
   flooding. The predictability performance of the models is used to
   measure the extent to which variations of urban features shape
   disparities in environmental hazard levels. Second, model
   transferability is used as a novel quantitative method to assess the
   similarity of these relationships across different regions and hazards,
   providing an empirical basis for understanding policy generalizability.
   Models were trained and tested with data from six metropolitan counties
   in the United States using Random Forest and XGBoost. The analysis of
   feature importance reveals features related to sociodemographic
   characteristics as the most prominent urban features that shape
   environmental hazard extent. Features related to transportation
   infrastructures and facility distribution are the relatively important
   urban features for urban heat exposure, and features related to land
   cover are the relatively important urban features for air pollution
   exposure, with significant variation across regions. The models show
   limited transferability across different regions and hazards,
   underscoring that the drivers of environmental injustice are
   context-specific. The insights gleaned from this study offer a fresh,
   data-driven perspective on the relationship among urban features and
   their interplay with environmental hazard exposure disparities,
   informing the development of more integrated urban design policies to
   enhance social equity and environmental injustice issues.},
