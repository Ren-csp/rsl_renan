@article{ WOS:000728417900001,
Author = {Moreira, Sergio and Vanclay, Frank and Esteves, Ana Maria},
Title = {Fallacies about communities that lead to failed community relations},
Journal = {IMPACT ASSESSMENT AND PROJECT APPRAISAL},
Year = {2022},
Volume = {40},
Number = {2},
Pages = {156-167},
Month = {MAR 4},
Abstract = {The assessment and implementation of development projects has been
   disconnected from relevant concepts in social psychology, especially
   those relating to understanding the interactions between projects and
   local communities. This disconnection has given rise to the prevalence
   of several fallacies about human behaviour amongst project staff,
   decision makers and environmental and social impact assessment
   practitioners. The playing-out of these fallacies influences the
   implementation of projects and reduces the likelihood of gaining a
   social licence to operate. Because these fallacies lead to distorted
   perceptions about communities, the existence of these fallacies is
   deleterious to desirable social relations with communities, good impact
   assessment practice, and to effective project decision-making. We
   describe eight of these fallacies: subjectivity; naivete;
   unpredictability; irrationality; greediness; self-serving;
   aggressiveness; and rigidity. We discuss these fallacies by drawing on
   the social psychology constructs of attitudes, risk perception, social
   identity, and social justice. We conclude by considering how these
   fallacies can be addressed in practice and how development projects and
   impact assessment can be improved.},
