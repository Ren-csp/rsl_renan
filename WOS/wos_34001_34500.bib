@article{ WOS:000783121700001,
Author = {Berg, Thomas and Benstoem, Carina and Moza, Ajay K.},
Title = {VAD Patients' Perception of Potential Telemedicine Support},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {7},
Month = {APR},
Abstract = {Technical possibilities for patient support must be user-friendly. This
   includes acceptance on the part of the patients, and safe function that
   must not lead to the user being overtaxed. In a study of Ventricular
   Assist Device (VAD) patients at the Department of Thoracic and
   Cardiovascular Surgery at the University Hospital RWTH Aachen, a
   questionnaire was used to investigate the current situation in dealing
   with the VAD system. This was followed by a query about ideas, wishes,
   and fears regarding the increased use of telemedical applications. An
   adapted Service User Technology Acceptability Questionnaire (SUTAQ) was
   used and the evaluation was carried out with the help of Office-based
   applications. As a result, it can be stated that the patients do not
   want to see personal contacts and care be completely replaced by
   telemedical remote support. If the application is stable and
   functioning, the majority is very much open to such support.},
