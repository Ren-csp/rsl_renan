Journal = {AMBIO},
Year = {2021},
Volume = {50},
Number = {4, SI},
Pages = {870-883},
Month = {APR},
Abstract = {Quantitative assessments have long been used to evaluate the condition
   of the natural environment, providing information for standard setting,
   adaptive management, and monitoring. Similar approaches have been
   developed to measure environmental governance, however, the end result
   (e.g., numeric indicators) belies the subjective and normative judgments
   that are involved in evaluating governance. We demonstrate a framework
   that makes this information transparent, through an application of the
   Freshwater Health Index in three different river basins in Latin
   America. Water Governance is measured on a 0-100 scale, using data
   derived from perception-based surveys administered to stakeholders.
   Results suggest that water governance is a primary area of concern in
   all three places, with low overall scores (Guandu-26, Alto Mayo-38,
   Bogota-43). We conclude that this approach to measuring governance at
   the river basin scale provides valuable information to support
   monitoring and decision making, and we offer suggestions on how it can
   be improved.},
