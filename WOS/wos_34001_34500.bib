@article{ WOS:001343258400001,
Author = {Pohankova, Tereza and Pechanec, Vilem},
Title = {Assessing the Cooling Potential of Vegetation in a Central European
   Rural Landscape: A Local Study},
Journal = {LAND},
Year = {2024},
Volume = {13},
Number = {10},
Month = {OCT},
Abstract = {This study investigates the cooling potential of vegetation in rural
   landscapes of the Czech Republic to mitigate heat-related issues. Using
   remote sensing, the Cooling Capacity Index (CCI) is assessed to measure
   green spaces' ability to lower air temperatures using evapotranspiration
   and shading. Landsat 8/9 and meteorological data are utilised, with CCI
   calculated based on vegetation cover, albedo, and evapotranspiration.
   Our results demonstrate significant variations in cooling capacity
   across different land use types. Forests exhibited the highest cooling
   potential, while urban areas, characterised by heat-absorbing materials,
   displayed the least. We analysed temporal and spatial variations in
   cooling capacity using various visualisation tools and validated the
   results against the InVEST software (v3.14.0). This study highlights the
   effectiveness of remote sensing in quantifying ecosystem functions,
   particularly the cooling services provided by vegetation. Our findings
   emphasise the crucial role of vegetation in mitigating urban heat
   islands and addressing climate change. This research provides valuable
   insights for developing climate change adaptation strategies in rural
   landscapes.},
