@article{ WOS:000302953100003,
Author = {Cleland, Verity J. and Ball, Kylie and King, Abby C. and Crawford, David},
Title = {Do the Individual, Social, and Environmental Correlates of Physical
   Activity Differ Between Urban and Rural Women?},
Journal = {ENVIRONMENT AND BEHAVIOR},
Year = {2012},
Volume = {44},
Number = {3},
Pages = {350-373},
Month = {MAY},
Abstract = {In this article, associations between individual, social, and
   environmental factors and physical activity among 3,669 women (18-45
   years) living in socioeconomically disadvantaged urban and rural areas
   were compared. In 2007-2008, participants reported levels of
   leisure-time physical activity (LTPA) and transport-related physical
   activity (TRPA) as well as five individual, four social, and three
   environmental factors. Physical activity self- efficacy demonstrated
   stronger associations with LTPA among urban relative to rural women;
   child care was associated with LTPA and intentions with TRPA among urban
   women only, and enjoyment was associated with TRPA among rural women
   only. Correlates of physical activity among urban and rural women were
   generally similar, although some tailoring of physical activity
   promotion strategies may be warranted.},
