@article{ WOS:000472004200011,
Author = {Tan, Wenfa and Li, Yuan and Ding, Lei and Wang, Yachao and Li,
   Jiangxiang and Deng, Qinwen and Guo, Feng and Xiao, Xue},
Title = {Characteristics and metal leachability of natural contaminated soil
   under acid rain scenarios},
