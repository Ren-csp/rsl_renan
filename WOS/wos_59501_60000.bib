@article{ WOS:000734976400001,
Author = {Sales, Ibrahim and Bawazeer, Ghada and Tarakji, Ahmad R. and Ben Salha,
   Feriel K. and Al-Deaiji, Nourah H. and Saeed, Marwah and Idris, Rawan S.
