   Dragos, Paul and Baias, Stefan and Marcu, Florin and Onet, Cristian},
Title = {INDOOR AIR QUALITY ISSUES. CASE STUDY: THE MULTIPURPOSE SPORTS HALL OF
   THE UNIVERSITY OF ORADEA},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2018},
Volume = {17},
