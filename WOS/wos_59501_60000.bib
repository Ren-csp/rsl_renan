@article{ WOS:000714754400016,
Author = {Chung, Chih-Yao and Singh, Kritarth and Kotiadis, Vassilios N. and
   Valdebenito, Gabriel E. and Ahn, Jee Hwan and Topley, Emilie and Tan,
   Joycelyn and Andrews, William D. and Bilanges, Benoit and Pitceathly,
   Robert D. S. and Szabadkai, Gyorgy and Yuneva, Mariia and Duchen,
   Michael R.},
Title = {Constitutive activation of the PI3K-Akt-mTORC1 pathway sustains the
   m.3243 A \&gt; G mtDNA mutation},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {NOV 4},
Abstract = {Heteroplasmic mtDNA mutations cause disease in humans. Here, Chung et al
   find the PI3K-Akt-mTORC1 pathway constitutively activated in cells with
   the heteroplasmic m.3243 A > G mutation, and inhibition of the pathway
   cell autonomously reduces mutant mtDNA load and rescues mitochondrial
   bioenergetics.
   Mutations of the mitochondrial genome (mtDNA) cause a range of
   profoundly debilitating clinical conditions for which treatment options
   are very limited. Most mtDNA diseases show heteroplasmy - tissues
   express both wild-type and mutant mtDNA. While the level of heteroplasmy
   broadly correlates with disease severity, the relationships between
   specific mtDNA mutations, heteroplasmy, disease phenotype and severity
   are poorly understood. We have carried out extensive bioenergetic,
   metabolomic and RNAseq studies on heteroplasmic patient-derived cells
   carrying the most prevalent disease related mtDNA mutation, the m.3243 A
   > G. These studies reveal that the mutation promotes changes in
   metabolites which are associated with the upregulation of the
   PI3K-Akt-mTORC1 axis in patient-derived cells and tissues. Remarkably,
   pharmacological inhibition of PI3K, Akt, or mTORC1 reduced mtDNA mutant
   load and partially rescued cellular bioenergetic function. The
   PI3K-Akt-mTORC1 axis thus represents a potential therapeutic target that
   may benefit people suffering from the consequences of the m.3243 A > G
   mutation.},
