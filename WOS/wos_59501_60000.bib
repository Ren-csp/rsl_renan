@article{ WOS:000312185900001,
Author = {Smith, Michael D. and Grov, Christian and Seal, David W. and McCall,
   Peter},
Title = {A Social-Cognitive Analysis of How Young Men Become Involved in Male
   Escorting},
Journal = {JOURNAL OF SEX RESEARCH},
Year = {2013},
Volume = {50},
Number = {1},
Pages = {1-10},
Month = {JAN 1},
Abstract = {This study employed a social-cognitive theoretical perspective to assess
   the interactions of behavioral, cognitive, and situational factors to
   understand better how young male sex workers (MSWs) entered the sex
   trade industry. As part of a larger project examining male escorts
   working for a single agency, MSWs (n = 38) were interviewed about their
   work and personal lives. Interviews were transcribed and analyzed
   thematically. As predicted by a social-cognitive perspective, results
   supported reciprocal influences of behavior and environment, environment
   and cognition, and behavior and cognition. MSWs developed more
   self-efficacy around sex work behaviors and more positive outcome
   expectations with experience; moral conflict and lack of attraction to
   clients limited MSWs self-efficacy. Key variables for sex work appeared
   to be cognitive in naturemostly represented by a decreased commitment to
   normative social/sexual values, the specific nature of which may have
   varied by sexual orientation. Findings support the contention that
   social-cognitive theory can effectively model entry of young men into
   sex work. Social-cognitive theory provides a broad umbrella underneath
   which various explanations for male sex work can be gathered.},
