@article{ WOS:001061881500031,
Author = {Maroto, Irene B. and Costas-Insua, Carlos and Berthoux, Coralie and
   Moreno, Estefania and Ruiz-Calvo, Andrea and Montero-Fernandez, Carlos
   and Macias-Camero, Andrea and Martin, Ricardo and Garcia-Font, Nuria and
   Sanchez-Prieto, Jose and Marsicano, Giovanni and Bellocchio, Luigi and
   Canela, Enric I. and Casado, Vicent and Galve-Roperh, Ismael and Nunez,
   Angel and Fernandez de Sevilla, David and Rodriguez-Crespo, Ignacio and
   Castillo, Pablo E. and Guzman, Manuel},
Title = {Control of a hippocampal recurrent excitatory circuit by cannabinoid
   receptor-interacting protein Gap43},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {APR 21},
Abstract = {The type-1 cannabinoid receptor (CB1R) is widely expressed in excitatory
   and inhibitory nerve terminals, and by suppressing neurotransmitter
   release, its activation modulates neural circuits and brain function.
   While the interaction of CB1R with various intracellular proteins is
   thought to alter receptor signaling, the identity and role of these
   proteins are poorly understood. Using a high-throughput proteomic
   analysis complemented with an array of in vitro and in vivo approaches
   in the mouse brain, we report that the C-terminal, intracellular domain
   of CB1R interacts specifically with growth-associated protein of 43kDa
   (GAP43). The CB1R-GAP43 interaction occurs selectively at mossy cell
   axon boutons, which establish excitatory synapses with dentate granule
   cells in the hippocampus. This interaction impairs CB1R-mediated
   suppression of mossy cell to granule cell transmission, thereby
   inhibiting cannabinoid-mediated anti-convulsant activity in mice. Thus,
   GAP43 acts as a synapse type-specific regulatory partner of CB1R that
   hampers CB1R-mediated effects on hippocampal circuit function.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Guzmán, M (Corresponding Author), Univ Complutense Madrid, Inst Univ Invest Neuroquim IUIN, Dept Biochem \& Mol Biol, Madrid 28040, Spain.
   Guzmán, M (Corresponding Author), Inst Salud Carlos III, Ctr Invest Biomed Red Enfermedades Neurode, Madrid 28029, Spain.
   Guzmán, M (Corresponding Author), Inst Ramon Y Cajal Invest Sanitaria IRYCIS, Madrid 28034, Spain.
