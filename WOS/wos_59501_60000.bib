@article{ WOS:001023370400001,
Author = {Macdonald, Catherine and Turffs, Dylann and McEntee, Kela and Elliot,
   Jessica and Wester, Julia},
Title = {The relationship between tourism and the environment in Florida, USA: A
   media content analysis},
Journal = {ANNALS OF TOURISM RESEARCH EMPIRICAL INSIGHTS},
Year = {2023},
Volume = {4},
Number = {1},
Month = {MAY},
Abstract = {The existence of trade-offs between continued tourism growth and
   environmental protection are apparent in Florida, where
   tourism-dependent economies are reliant on natural resources as key
   attractions. We analyze Florida newspaper articles covering tourism to
   determine how tourism issues are framed in public discourse, including
   discussion of tourism's drivers, effects and outcomes. We examine how
   complex trade-offs are (or are not) acknowledged. The overarching
   discourse frame describes a tourism-based economy reliant on
   environmental quality, which is threatened by other industries. Tourism
   is presented as providing economic incentives for environmental
   protection, with minimal discussion of tourism's potential environmental
   costs. Results reveal a simplistic discourse failing to acknowledge
   management challenges facing the state or meaningfully assess tourism's
   role in environmental protection or degradation.},
