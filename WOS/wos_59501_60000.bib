@article{ WOS:000258398600040,
Author = {Frueh, Dominique P. and Arthanari, Haribabu and Koglin, Alexander and
   Vosburg, David A. and Bennett, Andrew E. and Walsh, Christopher T. and
   Wagner, Gerhard},
Title = {Dynamic thiolation-thioesterase structure of a non-ribosomal peptide
   synthetase},
