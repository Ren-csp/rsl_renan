Author = {Daigle, Katelyn M. and Gang, Catherine H. and Kopping, Mariko F. and
   Gadde, Kishore M.},
Title = {Relationship Between Perceptions of Obesity Causes and Weight Loss
   Expectations Among Adults},
Journal = {JOURNAL OF NUTRITION EDUCATION AND BEHAVIOR},
