   Watanabe, Katsumi, Natl Inst Adv Ind Sci \& Technol, Tsukuba, Ibaraki, Japan.
   Watanabe, Katsumi, Japan Sci \& Technol Agcy, Tokyo, Japan.},
DOI = {10.2117/psysoc.2010.125},
ISSN = {0033-2852},
Keywords = {event perception; synchronization; visual context},
