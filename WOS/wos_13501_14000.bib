@article{ WOS:000362553400034,
Author = {Petrescu, Dacinia Crina and Petrescu-Mag, Ruxandra Malina},
Title = {Organic Food Perception: Fad, or Healthy and Environmentally Friendly? A
   Case on Romanian Consumers},
