@article{ WOS:001720818800001,
Author = {Antonova, Natalia and Gutierrez-Tano, Desiderio and Ruiz-Rosa, Ines},
Title = {Exploring Residents' Perceptions of the Hotel Industry's Impact on Water
   Resources},
Journal = {INTERNATIONAL JOURNAL OF TOURISM RESEARCH},
Year = {2026},
Volume = {28},
Number = {2},
Month = {MAR 19},
Abstract = {Understanding residents' perceptions regarding the environmental impact
   of tourism activities in a destination, including the depletion of water
   resources, is essential when it comes to promoting coexistence between
   tourism development and the local population. This study aims to analyse
   residents' perceptions of hotel-related water consumption to provide key
   information for sustainable tourism development without harming the
   quality of life of the inhabitants. The research involved a survey of
   806 residents of the Canary Islands (Spain), an area with intense
   tourist activity and water scarcity. The findings highlight that
   residents' perceptions of hotel activities as potential competitors for
   water resources with other sectors can significantly influence their
   support for the hotel industry. Additionally, the awareness of the
   behaviour of both tourists and hotels, and the ethical water consumption
   favourably affect the support of the resident population for the hotel
   activities.},
