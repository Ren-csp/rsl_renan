@article{ WOS:000262674400003,
Author = {Li, Yu-Sheng and Chuang, Ying-Chih},
Title = {Neighborhood Effects on an Individual's Health Using Neighborhood
   Measurements Developed by Factor Analysis and Cluster Analysis},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
