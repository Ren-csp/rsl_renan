@article{ WOS:001195352500001,
Author = {Nayak, Digant and Lv, Dongwen and Yuan, Yaxia and Zhang, Peiyi and Hu,
   Wanyi and Nayak, Anindita and Ruben, Eliza A. and Lv, Zongyang and Sung,
   Patrick and Hromas, Robert and Zheng, Guangrong and Zhou, Daohong and
   Olsen, Shaun K.},
Title = {Development and crystal structures of a potent second-generation dual
   degrader of BCL-2 and BCL-xL},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAR 29},
Abstract = {Overexpression of BCL-xL and BCL-2 play key roles in tumorigenesis and
   cancer drug resistance. Advances in PROTAC technology facilitated recent
   development of the first BCL-xL/BCL-2 dual degrader, 753b, a VHL-based
   degrader with improved potency and reduced toxicity compared to previous
   small molecule inhibitors. Here, we determine crystal structures of
   VHL/753b/BCL-xL and VHL/753b/BCL-2 ternary complexes. The two ternary
   complexes exhibit markedly different architectures that are accompanied
   by distinct networks of interactions at the VHL/753b-linker/target
   interfaces. The importance of these interfacial contacts is validated
   via functional analysis and informed subsequent rational and
   structure-guided design focused on the 753b linker and BCL-2/BCL-xL
   warhead. This results in the design of a degrader, WH244, with enhanced
   potency to degrade BCL-xL/BCL-2 in cells. Using biophysical assays
   followed by in cell activities, we are able to explain the enhanced
   target degradation of BCL-xL/BCL-2 in cells. Most PROTACs are
   empirically designed and lack structural studies, making it challenging
   to understand their modes of action and specificity. Our work presents a
   streamlined approach that combines rational design and structure-based
   insights backed with cell-based studies to develop effective
   PROTAC-based cancer therapeutics.
   Here, the authors have determined structures of 753b PROTAC,
   BCL-xL/BCL-2 and VHL E3 ligase ternary complexes which reveal the basis
   for the dual degrader activity of 753b. The structures and subsequent
   functional analyses facilitated design of WH244 PROTAC, with enhanced
   degrader activity in cells.},
