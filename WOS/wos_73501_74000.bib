@article{ WOS:000725085600001,
Author = {Othman, Arsalan Ahmed and Obaid, Ahmed K. and Al-Manmi, Diary Ali
   Mohammed and Pirouei, Mohammad and Salar, Sarkawt Ghazi and Liesenberg,
   Veraldo and Al-Maamar, Ahmed F. and Shihab, Ahmed T. and Al-Saady,
