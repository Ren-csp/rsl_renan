@article{ WOS:001508913800008,
Author = {Gabarain, Victoria Berdion and Nunez-Lillo, Gerardo and Pencik, Ales and
   Sardoy, Mariana Carignani and Angelibeas, Miguel and Salinas-Grenet,
   Hernan and Pacheco, Javier Martinez and Lopez, Leonel and Rossi, Andres
   Hugo and Miglietta, Esteban A. and Guidobono, Juan Santiago and Jia,
   Zhongtao and Novak, Ondrej and Giehl, Ricardo Fabiano Hettwer and von
   Wiren, Nicolaus and Meneses, Claudio and Estevez, Jose Manuel},
Title = {Enhanced auxin signaling promotes root-hair growth at moderately low
   temperature in Arabidopsis thaliana},
