@article{ WOS:000497694100011,
Author = {Park, Hongryeol and Yamamoto, Hiroyuki and Mohn, Lucas and Ambuhl, Lea
   and Kanai, Kenichi and Schmidt, Inga and Kim, Kee-Pyo and Fraccaroli,
   Alessia and Feil, Silke and Junge, Harald J. and Montanez, Eloi and
   Berger, Wolfgang and Adams, Ralf H.},
Title = {Integrin-linked kinase controls retinal angiogenesis and is linked to
   Wnt signaling and exudative vitreoretinopathy},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {NOV 20},
Abstract = {Familial exudative vitreoretinopathy (FEVR) is a human disease
   characterized by defective retinal angiogenesis and associated
   complications that can result in vision loss. Defective Wnt/beta-catenin
   signaling is an established cause of FEVR, whereas other molecular
   alterations contributing to the disease remain insufficiently
   understood. Here, we show that integrin-linked kinase (ILK), a mediator
   of cell-matrix interactions, is indispensable for retinal angiogenesis.
   Inactivation of the murine Ilk gene in postnatal endothelial cells
   results in sprouting defects, reduced endothelial proliferation and
   disruption of the blood-retina barrier, resembling phenotypes seen in
   established mouse models of FEVR. Retinal vascularization defects are
   phenocopied by inducible inactivation of the gene for alpha-parvin
   (Parva), an interactor of ILK. Screening genomic DNA samples from
   exudative vitreoretinopathy patients identifies three distinct mutations
   in human ILK, which compromise the function of the gene product in
   vitro. Together, our data suggest that defective cell-matrix
   interactions are linked to Wnt signaling and FEVR.},
