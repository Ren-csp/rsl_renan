Author = {Vieira, Virginia Tavares and Schlee, Renata Lobato},
Title = {Environmental Education in the composition of life: music and Pampean
   landscape as active force elements},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
