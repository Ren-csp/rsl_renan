@article{ WOS:001045985300001,
Author = {Son, Jung Young and Yang, Jae-Jang and Choi, Sanghyuk and Lee, Yong-Ki},
Title = {Impacts of residential environment on residents' place attachment,
   satisfaction, WOM, and pro-environmental behavior: evidence from the
   Korean housing industry},
Journal = {FRONTIERS IN PSYCHOLOGY},
Year = {2023},
Volume = {14},
Month = {JUL 28},
Abstract = {This study considers seven residential environment elements and examines
   their effect on residents' place attachment (place dependence and place
   identity), satisfaction, word-of-mouth behavior, and pro-environmental
   behavior. The study also examines whether gender moderates the proposed
   relationships. The data were collected from 603 respondents who owned a
   condominium in Seoul, South Korea. We analyzed the data using structural
   equation modeling with SmartPLS 4. The finding shows that all seven
   elements of the residential environment have a significant impact on
   either dimension of place attachment, except for the insignificant
   effect of social environment on place dependence. Both dimensions of
   place attachment have a significant effect on satisfaction, WOM, and
   pro-environmental behavior except for the insignificant effect of place
   dependence on pro-environmental behavior. The interaction effect test of
   gender shows that males consider eco-friendly materials and
   green/recreational areas more than females. On the other hand, females
   are found to weigh and social environments more heavily than males. The
   finding shows that pro-environmental behavior is influenced by place
   identity (not by place dependence) and satisfaction, indicating a key
   role of affective response.},
