@article{ WOS:001521380100001,
Author = {Bennett, Ludmila Lackova and Harisova, Kristina and Formankova, Anezka
   and Joukl, Zdenek},
Title = {From hieroglyphs to emoji: a spiral model for writing systems evolution},
Journal = {SEMIOTICA},
Year = {2025},
Volume = {2025},
Number = {266},
Pages = {75-101},
Month = {SEP 25},
Abstract = {This paper examines the evolution of written communication from ancient
   hieroglyphs to modern digital forms. It explores how social media,
   texting, and other digitally mediated communications have transformed
   traditional modes of human interaction, emphasizing the shift from
   spoken to written vernaculars. The study highlights that digital
   communication, characterized by a visual and multimodal nature, diverges
   significantly from the conventional and linear nature of traditional
   spoken and written languages. From a cognitive perspective, and using
   the framework of conceptual blending theory (CBT) and its embodied
   applications inspired by Jamin Pelkey's work, the paper explores how
   technological advancements are reshaping the ``language organ,{''}
   emphasizing the evolutionary importance of upright posture and free
   hands over articulatory organs in symbolic usage. The Digital Writing
   project at the International Semiotics Institute serves as a focal point
   for this research, analyzing the cognitive implications of various
   writing systems from pictographs to phonological alphabets and digital
   communication. This suggests a continuity in human communication
   systems, advocating for a spiral-evolution model influenced by the
   theories of Terrence Deacon and Vinicius Romanini.},
