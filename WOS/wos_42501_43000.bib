@article{ WOS:000376499500001,
Author = {Sun, Yueting and Xu, Xiaoqing and Xu, Chengliang and Qiao, Yu and Li,
   Yibing},
Title = {Elastomeric Cellular Structure Enhanced by Compressible Liquid Filler},
Journal = {SCIENTIFIC REPORTS},
Year = {2016},
Volume = {6},
Month = {MAY 25},
Abstract = {Elastomeric cellular structures provide a promising solution for energy
   absorption. Their flexible and resilient nature is particularly relevant
   to protection of human bodies. Herein we develop an elastomeric cellular
   structure filled with nanoporous material functionalized (NMF) liquid.
   Due to the nanoscale infiltration in NMF liquid and its interaction with
   cell walls, the cellular structure has a much enhanced mechanical
   performance, in terms of loading capacity and energy absorption density.
   Moreover, it is validated that the structure is highly compressible and
   self-restoring. Its hyper-viscoelastic characteristics are elucidated.},
