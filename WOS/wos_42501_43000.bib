@article{ WOS:000539292100009,
Author = {Freitas, Rui and Monteiro, Catelene and Rodrigues, Isabel and Tavares,
   Alex and Monteiro, Gilda and Lopez, Pedro and Martins, Samir and
   Ferreira, Joao and Lima, Liza and Tavares, Jose Pedro and Palma, Luis},
Title = {Cabo Verde Egyptian VultureNeophron percnopteruson the brink:
   community perceptions, inferences and facts of an extreme population
   crash},
Journal = {BIRD CONSERVATION INTERNATIONAL},
Year = {2020},
Volume = {30},
Number = {2},
Pages = {289-307},
Month = {JUN},
Abstract = {The Egyptian VultureNeophron percnopteruswas once an abundant species in
   the Cabo Verde Islands. Since the 1960s though, and especially during
   the 1980-1990s, it consistently declined to near extinction. Evidence
   collected indicates a remnant population of about a dozen pairs or less,
   scattered through the desert rangelands of only three islands. Extensive
   enquiry work revealed that this likely resulted from the concomitant
   effects of the rise in unnatural mortality due to the formerly
   widespread and long-lasting use of dangerous pesticides and the (still
   on-going) poisoning of stray dogs and other nuisance animals, and a
   decrease in food resources associated with factors linked with
   development, such as urbanisation, rural abandonment and better
   sanitation. Avoiding imminent extinction calls for emergency action
   against current threats to the remaining vultures, such as poisoning and
   electrocution, but also potential causes of impaired fecundity such as
   hazardous pesticides and shortage of food resources.},
