@article{ WOS:001424300300001,
Author = {Boudoug, Jean Christian Mey and Dyio, Stephane Dewang and Fotie, Cedric
   N. S. and Kang, Justin Etah and Ndzana, Isidore and Vouffo, Vianny Rodel
   Nguimdo and Mbolo, Marie Marguerite},
Title = {Preliminary Evidence of Great Apes' Occurrence in Peri-Urban and Highly
   Degraded Forest Reserves in Cameroon},
Journal = {AFRICAN JOURNAL OF ECOLOGY},
Year = {2025},
Volume = {63},
Number = {2},
Month = {FEB 18},
Abstract = {This study investigates the presence of great apes in degraded forests
   in Cameroon. Using camera traps, it reveals the occurrence of
   chimpanzees and gorillas in forest remnants within the highly degraded
   landscape formed by the Mbalmayo and Zamakoe Forest Reserves. Results
   support the persistence and adaptation of both species in
   forest/non-forest mosaics and emphasise the need to conserve
   biodiversity beyond traditional protected areas. Further research is
   required to characterise the conservation status of both species in the
   area, their use of this fragmented landscape, and their relationship
   with neighbouring human communities.},
