@article{ WOS:000545747200049,
Author = {Berl, Richard E. W. and Samarasinghe, Alarna N. and Jordan, Fiona M. and
   Gavin, Michael C.},
Title = {The Position-Reputation-Information (PRI) scale of individual prestige},
Journal = {PLOS ONE},
Year = {2020},
Volume = {15},
Number = {6},
Month = {JUN 25},
Abstract = {Prestige is a key concept across the social and behavioral sciences and
   has been implicated as an important driver in the processes governing
   human learning and behavior and the evolution of culture. However,
   existing scales of prestige fail to account for the full breadth of its
   potential determinants or focus only on collective social institutions
   rather than the individual-level perceptions that underpin everyday
   social interactions. Here, we use open, extensible methods to unite
   diverse theoretical ideas into a common measurement tool for individual
   prestige. Participants evaluated the perceived prestige of regional
   variations in accented speech using a pool of candidate scale items
   generated from free-listing tasks and a review of published scales.
   Through exploratory and confirmatory factor analyses, we find that our
   resulting 7-item scale, composed of dimensions we term position,
   reputation, and information ({''}PRI{''}), exhibits good model fit,
   scale validity, and scale reliability. The PRI scale of individual
   prestige contributes to the integration of existing lines of theory on
   the concept of prestige, and the scale's application in Western samples
   and its extensibility to other cultural contexts serves as a foundation
   for new theoretical and experimental trajectories across the social and
   behavioral sciences.},
Publisher = {PUBLIC LIBRARY SCIENCE},
Address = {1160 BATTERY STREET, STE 100, SAN FRANCISCO, CA 94111 USA},
Type = {Article},
Language = {English},
Affiliation = {Berl, REW (Corresponding Author), Colorado State Univ, Dept Human Dimens Nat Resources, Ft Collins, CO 80523 USA.
   Berl, Richard E. W.; Gavin, Michael C., Colorado State Univ, Dept Human Dimens Nat Resources, Ft Collins, CO 80523 USA.
   Samarasinghe, Alarna N.; Jordan, Fiona M., Univ Bristol, Dept Anthropol \& Archaeol, Bristol, Avon, England.
   Jordan, Fiona M.; Gavin, Michael C., Max Planck Inst Sci Human Hist, Jena, Germany.},
DOI = {10.1371/journal.pone.0234428},
Article-Number = {e0234428},
ISSN = {1932-6203},
Keywords-Plus = {OCCUPATIONAL PRESTIGE; SOCIAL RANK; ATTAINMENT; DYNAMICS; DOMINANCE;
