@article{ WOS:001581976500001,
Author = {Firmansyah, Dedy and Irawan, Muhammad Zudhy and Rizki, Muhamad and
   Amrozi, Mukhammad Rizka Fahmi and Kato, Hironori and Chalermpong,
   Saksith and Thaithatkul, Phathinan and Alvarez, Daniel Del Barrio},
Title = {Exploring the transition to electric motorcycles and its role in
   multimodal travel in the Jakarta metropolitan area},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {SEP 27},
Abstract = {Motorcycles are a dominant mode of commuting in regions such as the
   Jakarta Metropolitan Area, but their widespread use contributes to
   traffic congestion, safety concerns, and environmental degradation. This
   study investigates the preferences of conventional motorcycle (CM) users
   regarding a transition to electric motorcycles (EMs) and their
   integration with public transportation (PT) systems. Using a Mixed Logit
   model, this study analyzes data from 580 commuters in the Bodetabek
   region who travel to Jakarta and express a willingness to adopt EMs.
   Three models are developed: Model 1 includes travel attributes (e.g.,
   time, cost, access, parking); Model 2 incorporates sociodemographic and
   trip characteristics; Model 3 adds latent motivational factors,
   including flexibility, efficiency, and resilience. Elasticity analysis
   further evaluates the sensitivity of commuter preferences to changes in
   key attributes. Results indicate that all travel attributes negatively
   impact mode utility; higher time or cost reduces the likelihood of mode
   choice. The inclusion of demographic and latent variables improves model
   fit and reveals significant behavioral heterogeneity. Older and more
   educated commuters show greater openness to using EMs and integrated
   modes. Commuters with longer travel durations favor integration, while
   high-frequency CM users tend to resist switching. Environmental
   awareness increases the likelihood of choosing EM as a first-mile
   connection to PT. Psychological motivations also influence decisions:
   flexibility promotes EM use; perceived efficiency discourages
   integration; resilience reinforces CM loyalty. Elasticity analysis
   confirms that even slight increases in travel cost or time can shift
   users back to CM. These findings highlight the need for targeted
   policies such as park-and-ride facilities, EM charging stations, and
   integrated fare systems. Incentives and outreach tailored by age,
   education, and environmental concern are essential to promote
   sustainable mode shifts. Ultimately, successful EM adoption and PT
   integration require not only infrastructure and financial incentives but
   also behavioral strategies that address commuter motivations and travel
   habits.},
