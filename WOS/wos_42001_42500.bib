@article{ WOS:000308801100022,
Author = {Viphakone, Nicolas and Hautbergue, Guillaume M. and Walsh, Matthew and
   Chang, Chung-Te and Holland, Arthur and Folco, Eric G. and Reed, Robin
   and Wilson, Stuart A.},
Title = {TREX exposes the RNA-binding domain of Nxf1 to enable mRNA export},
Journal = {NATURE COMMUNICATIONS},
Year = {2012},
Volume = {3},
Month = {AUG},
Abstract = {The metazoan TREX complex is recruited to mRNA during nuclear RNA
   processing and functions in exporting mRNA to the cytoplasm. Nxf1 is an
   mRNA export receptor, which binds processed mRNA and transports it
   through the nuclear pore complex. At present, the relationship between
   TREX and Nxf1 is not understood. Here we show that Nxf1 uses an
   intramolecular interaction to inhibit its own RNA-binding activity. When
   the TREX subunits Aly and Thoc5 make contact with Nxf1, Nxf1 is driven
   into an open conformation, exposing its RNA-binding domain, allowing RNA
   binding. Moreover, the combined knockdown of Aly and Thoc5 markedly
   reduces the amount of Nxf1 bound to mRNA in vivo and also causes a
   severe mRNA export block. Together, our data indicate that TREX provides
   a license for mRNA export by driving Nxf1 into a conformation capable of
   binding mRNA.},
