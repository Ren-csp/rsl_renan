@article{ WOS:001820891200002,
Author = {Apjok, Gabor and Sari, Tobias and Mehi, Orsolya and Asboth, Andras and
   Barna, Lilla and Sala, Dora and Grof, Ilona and Vasarhelyi, Balint Mark
   and Juhasz, Szilvia and Pal, Csaba and Horvath, Peter and Migh, Ede and
   Schneider, Gyorgy and Hill, Colin and Deli, Maria and Shkoporov, Andrey
   and Kintses, Balint},
Title = {Prevalent gut phages encode modular adhesins mediating epithelial
   binding and endoplasmic reticulum trafficking},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUN 4},
Abstract = {Bacteriophages are crucial components of the human microbiome and hold
   promise as therapeutic agents. Yet, their physical interactions with
   mammalian cells remain poorly understood. Here, we developed a
   high-throughput platform to identify phages that adhere to epithelial
   layers and the proteins that mediate this interaction. The identified
   phages encode immunoglobulin (Ig)-like domain-containing proteins that,
   when displayed on a non-adherent phage, confer epithelial binding and
   internalization in vitro, and increased phage retention in the mouse gut
   in vivo. Phages encoding these adhesins are among the most abundant and
   prevalent human gut phages, including crAss-like phages and myoviruses
   closely related to the recently proposed Flandersviridae family. Domain
   sequence variation alters epithelial interaction profiles, and
   internalized phages traffic to the endoplasmic reticulum through the
   Golgi apparatus, suggesting access to non-degradative internalization
   pathways. These findings reveal widespread phage-human interactions in
   the human viral community, with potential impacts on health and
   implications for next-generation phage therapeutics.},
