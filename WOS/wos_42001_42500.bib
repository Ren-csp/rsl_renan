Series = {Urban and Landscape Perspectives},
Year = {2015},
Volume = {18},
Pages = {69-76},
Abstract = {Spatial planning and environmental restoration are essential corollaries
   to the management of protected natural areas; however, without a sound
   awareness of the evolutionary consistency of biocoenoses, the harmonious
   integration between human activities and ecosystem preservation remains
   an unattainable utopia. The theorisation of a balanced welfare, inspired
   by the universal tendency of ecosystems to reach a steady state, has to
   go along with the defection from any economic greed.},
