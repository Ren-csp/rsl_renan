@article{ WOS:001595447600001,
Author = {Monterrubio, Carlos and Wadham, Helen and Dashper, Katherine},
Title = {Everyday Multispecies Resistance: Power Relations in an Equestrian Sport},
Journal = {JOURNAL OF CONTEMPORARY ETHNOGRAPHY},
Year = {2025},
Volume = {54},
Number = {6},
Pages = {848-881},
Month = {DEC},
Abstract = {Interest in human-animal relations in sport has grown, but it often
   remains anthropocentric, overlooking the agency of animals, particularly
   in Global South contexts. This study focuses on the Mexican equestrian
   sport of Charrer \& iacute;a, using multispecies ethnography to explore
   the complex power dynamics between humans, horses, and bulls. Drawing on
   James Scott's concept of ``weapons of the weak,{''} we examine how
   animals resist domination through both subtle tactics (like denial,
   surrender, escape) and overt acts of confrontation that challenge human
   domination within equestrian sports. The concept of everyday
   multispecies resistance is proposed highlighting the everyday nature of
   these forms of resistance and exploring the overlap between individual
   and collective action, as well as the complex entanglements with power.
