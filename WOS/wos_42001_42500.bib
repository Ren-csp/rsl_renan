@article{ WOS:000253913600006,
Author = {Feng, Jiang and Zhou, Yixing and Wu, Fulong},
Title = {New trends of suburbanization in Beijing since 1990: From government-led
   to market-oriented},
Journal = {REGIONAL STUDIES},
Year = {2008},
Volume = {42},
Number = {1},
Pages = {83-99},
Abstract = {Since the 1990s suburbanization has been continuing in China along with
   the deepening of market transition. The process of suburbanization has
   gone beyond purely government-initiated relocation of households and
   polluting industries. Based on the newest population census, this paper
   identifies some major new trends of suburbanization in Beijing. The new
   round of suburbanization has been driven by the construction of suburban
   villas and affordable housing, rising private car ownership, the
   decentralization of industry, and the development of large suburban
   shopping malls and retail parks. Passively relocated households are no
   longer the dominant source of suburbanization. Suburbanization in
   Beijing has evolved into a new stage of more market-oriented development
   in the suburbs.},
