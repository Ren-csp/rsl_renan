@article{ WOS:001868294000001,
Author = {Balint, Barnabas},
Title = {Writing a history of animals during the Holocaust},
Journal = {PATTERNS OF PREJUDICE},
Year = {2026},
Month = {2026 SEP 4},
Abstract = {This article by Balint explores the idea of a history of animals during
   the Holocaust, identifying what such a history looks like, how it can be
   researched and constructed and what it contributes to our understanding
   of the event. It charts where animals can be found in archival material
   and builds an analytical approach for incorporating animals into the
   history of the Holocaust. It argues that animals hold multiple positions
   in the history of the Holocaust: as tools of persecution; elements of
   the human experience; and points of memory. Although animals have not
   been viewed as a category of analysis for the Holocaust before, recent
   trends in Holocaust studies have developed the idea of an environmental
   history, paying close attention to nature and the relationship between
   humans and their environment. Balint's article reveals how animals are
   also a part of this environment. It explores the use of animals and
   their relationship with both perpetrators and victims. As a result, it
   reveals how studying animals enhances our understanding of the human
   experience of the Holocaust.},
