@article{ WOS:001553518900001,
Author = {Machac, Jan and Hekrle, Marek and Brabec, Jan},
Title = {I want my street to be green, but not in just any way: exploring public
   preferences for nature-based solutions in two Czech cities},
Journal = {LOCAL ENVIRONMENT},
Year = {2026},
Volume = {31},
Number = {7},
Pages = {1063-1085},
Month = {JUL 3},
Abstract = {Cities are increasingly adopting nature-based solutions (NBS) to address
   urban challenges and improve residents' quality of life. Despite this
   growing interest, significant barriers remain, including limited public
   support, participation, and challenges in quantifying their economic
   value. This study explored public preferences for 15 types of NBS in two
   Czech cities, focusing on both aesthetic perceptions and economic
   valuation. Data were collected through assisted interviews on-site, with
   respondents in Prague (n = 205) and Litom \& ecaron;\& rcaron;ice (n =
   185). Using an image-assisted questionnaire survey, aesthetic
   preferences were assessed, followed by contingent valuation (CVM) and
   choice experiment (CE) methods to determine willingness to pay (WTP) for
   implementing NBS in urban streets. CVM findings revealed that residents
   were willing to pay an additional <euro>39-52 per month for street
   greenery, equivalent to a 12-17\% rent increase. However, while
   respondents generally appreciated NBS aesthetically and expressed
   positive WTP for greener streets, CE results showed significant
   variation depending on the type of NBS. Specifically, respondents were
   willing to pay only for grass strips and green fa \& ccedil;ades, while
   solutions like green paving, permeable pavers, flower beds, and green
   roofs required compensation. This study underscores the gap between
   aesthetic appreciation and financial commitment to different NBS,
   providing novel insights into public preferences for less commonly
   studied solutions and informing future urban greening strategies.},
