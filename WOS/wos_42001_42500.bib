@article{ WOS:000529374500010,
Author = {Moulishankar, Anguraj and Lakshmanan, Karthikeyan},
Title = {Data on molecular docking of naturally occurring flavonoids with
   biologically important targets},
Journal = {DATA IN BRIEF},
