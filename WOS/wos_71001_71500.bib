Address = {1160 BATTERY STREET, STE 100, SAN FRANCISCO, CA 94111 USA},
Type = {Article},
Language = {English},
Affiliation = {Kang, DW (Corresponding Author), Pusan Natl Univ, Coll Nat Sci, Dept Mol Biol, Pusan, South Korea.
