@article{ WOS:001306738300001,
Author = {Wang, Lie and Sun, Chuanhao and Wang, Mo},
Title = {Optimization Strategies for Waterfront Plant Landscapes in Traditional
   Villages: A Scenic Beauty Estimation-Entropy Weighting Method Analysis},
