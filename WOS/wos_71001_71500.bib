@article{ WOS:001284942100088,
Author = {Tekavec, Eva and Nilsson, Tohr and Dahlin, Lars B. and Huynh, Elizabeth
   and Nordander, Catarina and Riddar, Jakob and Karedal, Monica},
Title = {Serum levels of biomarkers related to severity staging of Raynaud's
   phenomenon, neurosensory manifestations, and vibration exposure in
   patients with hand-arm vibration injury},
Journal = {SCIENTIFIC REPORTS},
Year = {2024},
Volume = {14},
Number = {1},
Month = {AUG 5},
Abstract = {Our aim was to explore possible relationships between serum levels of
   biomarkers in patients with hand-arm vibration injury in relation to the
   severity of the vascular, i.e., Raynaud's phenomenon (RP), and
   neurosensory manifestations, the current exposure level, and the
   duration of exposure. This study was of case series design and involved
   92 patients diagnosed with hand-arm vibration injury. Jonckheere's trend
   test was used to assess any association between serum levels of
   biomarkers and RP as well as neurosensory manifestations, graded by the
   International Consensus Criteria. Generalized linear models with
   adjustment for possible confounders were also used for associations
   between serum levels of biomarkers and; (1) severity of RP recorded as
   the extent of finger blanching calculated with Griffin score, (2)
   vibration perception thresholds, (3) magnitude of current exposure as
   {[}A(8); (m/s2)] value, and (4) the duration of exposure in years. Serum
   levels of thrombomodulin, von Willebrand factor, calcitonin gene related
   peptide (CGRP), heat shock protein 27, and caspase-3 were positively
   associated with severity of RP. Serum levels of CGRP were positively
   associated with the neurosensory component. No associations with
   exposure were shown for these biomarkers. For Intercellular adhesion
   molecule 1 and monocyte chemoattractant protein 1, no associations were
   found with neither severity nor exposure. Levels of serum biomarkers
   associated with endothelial injury or dysfunction, inflammation,
   vasodilation, neuroprotection, and apoptosis were positively associated
   with the severity of hand-arm vibration injury.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Tekavec, E (Corresponding Author), Lund Univ, Dept Lab Med, Div Occupat \& Environm Med, S-22100 Lund, Sweden.
   Tekavec, Eva; Nordander, Catarina; Riddar, Jakob; Karedal, Monica, Lund Univ, Dept Lab Med, Div Occupat \& Environm Med, S-22100 Lund, Sweden.
   Nilsson, Tohr, Umea Univ, Dept Publ Hlth \& Clin Med, Div Sustainable Hlth \& Med, S-90187 Umea, Sweden.
   Dahlin, Lars B., Lund Univ, Dept Translat Med Hand Surg, S-22100 Malmo, Sweden.
   Huynh, Elizabeth; Karedal, Monica, Reg Skane, Dept Occupat \& Environm Med, S-22363 Lund, Sweden.},
DOI = {10.1038/s41598-024-68846-1},
Article-Number = {18128},
ISSN = {2045-2322},
