@article{ WOS:001694665200001,
Author = {Seager, Benjamin A. and Lim, Pailene S. and Xiao, Xiao and Lai, Keng
   Heng and Feufack-Donfack, Lionel Brice and Dass, Sheena and Jung,
   Nicolai C. and Abraham, Anju and Grigg, Matthew J. and Anstey, Nicholas
   M. and William, Timothy and Sattabongkot, Jetsumon and Leis, Andrew and
   Longley, Rhea J. and Duraisingh, Manoj T. and Popovici, Jean and Wilson,
   Danny W. and Cowman, Alan F. and Scally, Stephen W.},
Title = {PTRAMP, CSS and Ripr form a conserved complex required for merozoite
   invasion of Plasmodium species into erythrocytes},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JAN 26},
Abstract = {Invasion of erythrocytes by members of the Plasmodium genus is an
   essential step of the parasite lifecycle, orchestrated by numerous
   host-parasite interactions. In P. falciparum Rh5, with PfCyRPA, PfRipr,
   PfCSS, and PfPTRAMP, forms the essential PCRCR complex which binds
   basigin on the erythrocyte surface. Rh5 is restricted to P. falciparum
   and its close relatives; however, PTRAMP, CSS and Ripr orthologs are
   present across the Plasmodium genus. We investigated PTRAMP, CSS and
   Ripr orthologs from three species to elucidate common features of the
   complex. Like P. falciparum, PTRAMP and CSS form a disulfide-linked
   heterodimer in both P. vivax and P. knowlesi with all three species
   forming a complex with Ripr by binding its C-terminal region, termed the
   PTRAMP-CSS-Ripr (PCR) complex. Cross-reactive antibodies targeting the
   PCR complex differentially inhibit merozoite invasion. The crystal
   structure of a cross-reactive antibody reveals an inhibitory epitope on
   the C-terminal tail of PvRipr. Cryo-EM visualization of the P. knowlesi
   PCR complex confirms predicted models and demonstrates a core invasion
   scaffold in Plasmodium spp. with implications for vaccines targeting
   multiple species of malaria-causing parasites.},
