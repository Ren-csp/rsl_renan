@article{ WOS:000658505600004,
Author = {Sanchez-Samaniego, Giuliana and Tallman, Paula S. and Valdes-Velasquez,
   Armando},
Title = {Metabolic syndrome risk unexpectedly predicted by traditional food
   consumption: shifting food systems and health among the Awajun of the
   Peruvian Amazon},
Journal = {ANNALS OF HUMAN BIOLOGY},
Year = {2021},
Volume = {48},
Number = {2},
Pages = {110-118},
Month = {FEB 17},
Abstract = {Background
   Dietary changes, especially declines in traditional food diversity and
   increases in the consumption of processed foods, have previously been
   shown to increase the risk of developing cardiovascular diseases.
   Aim
   We evaluated the prevalence and risk factors for metabolic syndrome in
   four Awajun communities in the Peruvian Amazon.
   Subjects and methods
   A total of 222 participants answered a socioeconomic questionnaire, a
   24-h food recall, and completed a physical examination for metabolic
   syndrome diagnosis. A Poisson regression with robust variance was used
   in the statistical analysis of risk factors for metabolic syndrome.
   Results
   We found an overall prevalence of 24\% for metabolic syndrome. Being
   female, increased age and body mass index were significant risk factors
   for metabolic syndrome. Surprisingly, risk more than doubled with the
   ratio of traditional foods. However, this study revealed that there are
   fewer traditional foods being consumed in this study compared to prior
   studies among the Awajun.
   Conclusion
   We suggest that the unexpected relationship between traditional food
   consumption and metabolic syndrome may be due to substantial reductions
   in the diversity of traditional foods. Currently available traditional
   foods are primarily high in carbohydrates and are supplemented with
   cheap, non-perishable, and carbohydrate heavy market food items.},
