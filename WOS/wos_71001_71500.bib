@article{ WOS:000085841400003,
Author = {Nishith, P and Mechanic, MB and Resick, PA},
Title = {Prior interpersonal trauma: The contribution to current PTSD symptoms in
   female rape victims},
Journal = {JOURNAL OF ABNORMAL PSYCHOLOGY},
Year = {2000},
Volume = {109},
Number = {1},
Pages = {20-25},
Month = {FEB},
Abstract = {The purpose of the current study was to disentangle the relationship of
   childhood sexual abuse and childhood physical abuse from prior adult
   sexual and physical victimization in predicting current posttraumatic
   stress disorder (PTSD) symptoms in recent rape victims. The participants
   were: a community sample of 117 adult rape victims assessed within I
   month of a recent index rape for a history of child sexual abuse, child
   physical abuse, other adult sexual and physical victimization, and
   current PTSD symptoms. Results from path analyses showed that a history
   of child sexual abuse seems to increase vulnerability for adult sexual
   and physical Victimization and appears to contribute to current PTSD
   symptoms within the cumulative context of other adult trauma.},
