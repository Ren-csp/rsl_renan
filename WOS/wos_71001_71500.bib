   Ho, Shirley S.; Goh, Tong Jee, Nanyang Technol Univ, Wee Kim Wee Sch Commun \& Informat, 31 Nanyang Link, Singapore 637718, Singapore.},
DOI = {10.1016/j.trf.2025.01.016},
EarlyAccessDate = {FEB 2025},
ISSN = {1369-8478},
EISSN = {1873-5517},
Keywords = {Mental models; Comparison; Risks; Benefits; Artificial intelligence;
