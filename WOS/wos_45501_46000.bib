@article{ WOS:001829538900001,
Author = {Mazurkiewicz, Weronika and Andersen, Michael Asgaard},
Title = {Eco-communities as socio-spatial laboratories: Lessons for retrofitting
   low-density housing settlements},
Journal = {JOURNAL OF HOUSING AND THE BUILT ENVIRONMENT},
Year = {2026},
Month = {2026 JUL 24},
Abstract = {Eco-villages have emerged as laboratories of alternative socio-spatial
   organisation, generating practices that may inform the retrofitting of
   mainstream low-density housing settlements. This paper examines how
   principles developed in Danish eco-villages can be translated into
   settlements that share comparable spatial typologies, such as suburban
   areas, peri-urban districts, and small towns characterised by dispersed
   morphology and limited shared infrastructure, but differ in their
   underlying socio-spatial conditions. Based on fieldwork in three
   communities-Andelssamfundet i Hjortsh \& oslash;j, Karise Permatopia,
   and Svanholm-the study draws on semi-structured interviews, spatial
   observations, and GIS-based geo-surveys. Using an analytical framework
   focused on community, built environment, and ecology, it identifies
   strategies linking collective agency with everyday resource stewardship.
   While the three cases share sustainability-oriented values, they differ
   in governance and socio-ecological organisation: Hjortsh \& oslash;j
   emphasises informal collaboration, Permatopia integrates family-oriented
   permaculture routines, and Svanholm represents structured collectivism
   and agricultural production. The paper argues that retrofitting requires
   translation rather than replication. Because social organisation and
   spatial form are mutually constitutive, selective adaptation must extend
   beyond spatial typologies to the governance routines and participation
   infrastructures that sustain collective life. Such translation is
   enabled by sustained institutional support and shared spatial resources,
   but is constrained by self-selection dynamics, unequal access, and
   volunteer dependency.},
