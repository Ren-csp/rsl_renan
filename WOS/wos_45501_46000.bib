@article{ WOS:000797132200008,
Author = {Zhang, Jiangtao and Shi, Yiqiang and Fan, Junping and Chen, Huiwen and
   Xia, Zhanyi and Huang, Bo and Jiang, Juquan and Gong, Jianke and Huang,
   Zhuo and Jiang, Daohua},
Title = {N-type fast inactivation of a eukaryotic voltage-gated sodium channel},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {MAY 17},
Abstract = {Voltage-gated sodium (Na-V) channels initiate action potentials. Fast
   inactivation of Na-V channels, mediated by an Ile-Phe-Met motif, is
   crucial for preventing hyperexcitability and regulating firing
   frequency. Here we present cryo-electron microscopy structure of Na(V)Eh
   from the coccolithophore Emiliania huxleyi, which reveals an unexpected
   molecular gating mechanism for Nay channel fast inactivation independent
   of the Ile-Phe-Met motif. An N-terminal helix of Na(V)Eh plugs into the
   open activation gate and blocks it. The binding pose of the helix is
   stabilized by multiple electrostatic interactions. Deletion of the helix
   or mutations blocking the electrostatic interactions completely
   abolished the fast inactivation. These strong interactions enable rapid
   inactivation, but also delay recovery from fast inactivation, which is
   similar to 160-fold slower than human Na-V channels. Together, our
   results provide mechanistic insights into fast inactivation of Na(V)Eh
   that fundamentally differs from the conventional local allosteric
   inhibition, revealing both surprising structural diversity and
   functional conservation of ion channel inactivation.},
