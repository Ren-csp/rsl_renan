@article{ WOS:001147822500001,
Author = {Halaclar, Kazim and Rummy, Paul and Liu, Jia and Hunt, Adrian P. and Do,
   Truong Van and Minh, Nguyen Trung and Deng, Tao},
Title = {Exceptionally well-preserved crocodilian coprolites from the Late Eocene
   of Northern Vietnam: Ichnology and paleoecological significance},
Journal = {ISCIENCE},
Year = {2023},
Volume = {26},
Number = {9},
Month = {SEP 15},
Abstract = {This study examines 55 coprolites from the Na Duong Basin to reconstruct
   the paleoenvironment. Coproe-cology sheds light on understanding the
   complex prey-predator relationships, trophic dynamics, and ecosystem
   evolution. Through quantitative and multidisciplinary analysis, the
   putative coprolites were attributed to crocodilian producers, leading to
   the establishment of a new ichnogenus and species, Croc-ocopros
   naduongensis igen. et isp. nov., based on distinct characteristics and
   comparisons. The study pro-vides compelling evidence of an ancient river
   or lake-like environment dominated by diverse crocodilian fauna,
   indicating a thriving food chain in the Na Duong Basin. The findings
   also highlight the remarkable richness of ichnofauna, fauna, flora, and
   the presence of a favorable climate, confirming the area as a
   sig-nificant fossil Lagersta center dot tte in Southeast Asia. Overall,
   this study offers a unique snapshot of the past, providing valuable
   insights into the regional ecosystem and significantly contributing to
   our understand-ing of paleoenvironmental conditions and biotic
   interactions.},
