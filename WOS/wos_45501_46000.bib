@article{ WOS:001453837200001,
Author = {Shen, Wei and Cao, Honglu and Zhao, Jiandong},
Title = {Modular Scheduling Optimization of Multi-Scenario Intelligent Connected
   Buses Under Reservation-Based Travel},
Journal = {SUSTAINABILITY},
Year = {2025},
Volume = {17},
Number = {6},
Month = {MAR 17},
Abstract = {In the context of big data and intelligent connectivity, optimizing
   scheduled bus dispatch can enhance urban transit efficiency and
   passenger experience, which is vital for the sustainable development of
   urban transportation. This paper, based on existing fixed bus stops,
   integrates traditional demand-responsive transit and travel booking
   models, considering the spatiotemporal variations in scheduled travel
   demands and passenger flows and addressing the combined scheduling
   issues of fixed-capacity bus models and skip-stop strategies. By
   leveraging intelligent connected technologies, it introduces a dynamic
   grouping method, proposes an intelligent connected bus dispatching
   model, and optimizes bus timetables and dispatch control strategies.
   Firstly, the inherent travel characteristics of potential reservation
   users are analyzed based on actual transit data, subsequently extracting
   demand data from reserved passengers. Secondly, a two-stage optimization
   program is proposed, detailing passenger boarding and alighting at each
   stop and section passenger flow conditions. The first stage introduces a
   precise bus-traveler matching dispatch model within a
   spatial-temporal-state framework, incorporating ride matching to
   minimize parking frequency in scheduled travel scenarios. The second
   stage addresses spatiotemporal variations in passenger demand and
   station congestion by employing a skip-stop and bus operation control
   strategy. This strategy enables the creation of an adaptable bus
   operation optimization model for temporal dynamics and station capacity.
   Finally, a dual-layer optimization model using an adaptive parameter
   grid particle swarm optimization algorithm is proposed. Based on
   Beijing's Route 300 operational data, the simulation-driven study
   implements contrasting scenarios of different bus service patterns. The
   results demonstrate that this networked dispatching system with dynamic
   vehicle grouping reduces operational costs by 29.7\% and decreases
   passenger waiting time by 44.15\% compared to baseline scenarios.},
