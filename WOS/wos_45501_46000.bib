@article{ WOS:001697528700001,
Author = {Schori, Hadas and Barsheshet, Hagit Sandrosi and Gal, Adiv},
Title = {Why climate change education stalls: kindergarten teachers' perspectives
   through a Diffusion of Innovations lens},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2026},
Month = {2026 FEB 10},
Abstract = {This qualitative study examines how kindergarten teachers in northern
   Israel perceive and implement Climate Change Education (CCE) under a
   recent Ministry mandate. Using Diffusion of Innovations (DOI) theory as
   an analytical lens, we conducted 15 semi-structured interviews and two
   focus groups with kindergarten teachers from diverse urban and rural
   settings. Thematic analysis, complemented by a word-frequency
   visualization, revealed four main barriers to CCE adoption: (1)
   teachers' strong emphasis on children's socio-emotional well-being over
   global climate topics, (2) local environmental activities that remain
   disconnected from broader climate frameworks, (3) feelings of detachment
   from Ministry guidance and limited access to CCE-specific training, and
   (4) perceptions that climate change is too complex and developmentally
   inappropriate for young children. The word cloud analysis underscored
   this pattern by showing that terms such as `recycling' and `nature' were
   highly frequent, whereas `climate change' appeared only rarely in
   teachers' discourse. We conclude that narrowing the gap between CCE
   policy and kindergarten practice requires clear, age-appropriate
   curriculum guidance, protected instructional time for climate-related
   learning, and modular, practice-based professional development that
   supports teachers in integrating climate concepts into familiar early
   childhood pedagogies.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
