@article{ WOS:000886221900018,
Author = {Chen, Min and Ouyang, Jingyu and Jian, Aijia and Liu, Jia and Li, Pan
   and Hao, Yixue and Gong, Yuchen and Hu, Jiayu and Zhou, Jing and Wang,
   Rui and Wang, Jiaxi and Hu, Long and Wang, Yuwei and Ouyang, Ju and
