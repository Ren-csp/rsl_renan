@article{ WOS:001268918700001,
Author = {Lugo, Elkyn and de la Puente Pacheco, Mario Alberto and Barrientos, Enoc
   and Navarro, Nelvis and Cardenas, Ingrid},
Title = {Examining educational pathways: mathematics licensure training},
Journal = {COGENT EDUCATION},
Year = {2024},
