@article{ WOS:001625176300001,
Author = {Alexander, Kelly},
Title = {Tasting Red, Hearing Silk: Synesthesia, Sensory Labor, and the Social
   Aesthetics of Chefs},
Journal = {AMERICAN ANTHROPOLOGIST},
Year = {2026},
Volume = {128},
Number = {1},
Pages = {52-62},
Month = {MAR},
Abstract = {This article examines synesthesia as a mode of perception by exploring
   its implications for culinary labor, specifically how chefs navigate
   multisensory experience in the high-pressure environment of professional
   kitchens. Drawing on 30 years of fieldwork and observations of, and
   interviews with, more than 500 chefs, it brings sensory anthropology,
   food studies, and the everyday practices of professional cooking into
   conversation to explore how heightened sensory attunements both shape
   and are shaped by creativity and environmental culture. While
   neurological studies often frame synesthesia as a rare or idiosyncratic
   condition, this article foregrounds its broader social and cultural
   dimensions, positioning it within the social aesthetics of kitchen
   labor. Building on the work of Classen, Howes, Sutton, and others, it
   examines how chefs' perceptions-whether clinically diagnosed as
   synesthetic or not-fuse taste, texture, sound, and memory. The article
   argues that culinary labor reveals the entanglements of sensory
   experience, cultural value, and embodied knowledge, showing how food
   functions as both material and metaphor, and how the senses themselves
   are informed by work. This ethnographic account invites readers to
   consider the kitchen as a site where the senses operate in concert,
   linking inner perception to outer worlds.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Alexander, K (Corresponding Author), Univ North Carolina Chapel Hill, Dept Amer Studies, Chapel Hill, NC 27599 USA.
   Alexander, Kelly, Univ North Carolina Chapel Hill, Dept Amer Studies, Chapel Hill, NC 27599 USA.},
DOI = {10.1111/aman.70040},
EarlyAccessDate = {NOV 2025},
