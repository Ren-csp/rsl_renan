@article{ WOS:000475806800013,
Author = {Elizabeth Levrand, Norma},
Title = {An alternative management of historical centers: La Habana Vieja, Cuba},
Journal = {PASOS-REVISTA DE TURISMO Y PATRIMONIO CULTURAL},
