@article{ WOS:000296416500022,
Author = {Madire, L. G. and Wood, A. R. and Williams, H. E. and Neser, S.},
Title = {Potential agents for the biological control of Tecoma stans (L.)
   Juss ex Kunth var. stans (Bignoniaceae) in South Africa},
