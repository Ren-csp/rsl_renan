@article{ WOS:001830507000001,
Author = {Han-Long, Rui and Wengel, Yana},
Title = {Conservation education and tourism pedagogy: lessons from Hainan
   Tropical Rainforest National Park},
Journal = {FRONTIERS IN SUSTAINABLE TOURISM},
Year = {2026},
Volume = {5},
Month = {JUL 13},
Abstract = {Tourism's dependence on biodiversity makes national parks both sites of
   opportunity and vulnerability in the Anthropocene. This exploratory
   qualitative study contributes to tourism pedagogy by examining how
   conservation education initiatives could enhance biodiversity awareness
   and commitment among younger generations, in the context of Hainan
   Tropical Rainforest National Park (HTRNP), home to the critically
   endangered Hainan gibbon (Nomascus hainanus). Drawing on 18
   semi-structured interviews with university students and a participatory
   Ketso workshop with seven secondary school students, the study explores
   how experiential, interactive and place-based learning shapes knowledge
   of flagship species and their preferences for conservation-oriented
   tourism education. Findings indicate persistent knowledge gaps:
   university students were more familiar with globally iconic species such
   as pandas, whereas local pupils demonstrated stronger awareness of
   Hainan's endemic biodiversity through hands-on, place-based activities.
   Both groups preferred interactive and immersive approaches, such as
   field trips, conservation projects, and digital tools, over
   classroom-based learning. These findings suggest that tourism-related
   educational experiences may help address shifting baseline syndrome by
   reconnecting learners with local ecosystems, species histories and
   conservation challenges. In response, the paper offers an exploratory,
   context-sensitive 10-week curriculum model for tourism and environmental
   education that integrates in-situ and ex-situ learning. Rather than
   claiming broad transferability, the model is presented as a pedagogical
   framework that may inform similar protected-area education contexts,
   while requiring further empirical testing across diverse educational and
   socio-economic settings. By linking biodiversity conservation with
   tourism learning experiences, the study illustrates how conservation
   education can support more experiential, place-based and critically
   engaged approaches to tourism pedagogy.},
