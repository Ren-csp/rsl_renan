@article{ WOS:000620978300001,
Author = {Malik, Ashish and Budhwar, Pawan and Patel, Charmi and Laker, Benjamin},
Title = {Holistic indigenous and atomistic modernity: Analyzing performance
   management in two Indian emerging market multinational corporations},
Journal = {HUMAN RESOURCE MANAGEMENT},
