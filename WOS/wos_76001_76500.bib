@article{ WOS:001780967500001,
Author = {Rahman, Md Mostafizur and Hossain, Sajjad and Ahmed, Imtiaz and Iribe,
   Tsunakiyo and Hossain, Md. Kaium and Arafat, Khondakar Md Ikhtiar Uddin
   and Alam, Edris},
Title = {Psychological consequences of the 2025 Dhaka earthquake: Prevalence and
   determinants of depression, anxiety, and stress among urban residents},
Journal = {PROGRESS IN DISASTER SCIENCE},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {On 21 November 2025, a moderate earthquake struck Dhaka, Bangladesh,
   causing widespread fear and psychological concern in this densely
   populated city. This cross-sectional study assessed the prevalence and
   determinants of depression, anxiety, and stress among urban residents. A
   total of 409 adults from the Dhaka North and South City Corporations
   were surveyed approximately 4 weeks after the event using the validated
   Bengali version of the Depression, Anxiety, and Stress Scales (DASS-21).
   Descriptive statistics and multiple linear regression models using
   backward elimination were performed. Most participants were within
   normal ranges for depression, anxiety, and stress; however, a
   considerable proportion experienced elevated psychological symptoms.
   Anxiety appeared to be the most prominent psychological response, with
   moderate-to-extremely severe anxiety reported more frequently than
   corresponding levels of depression and stress. Younger age was
   significantly associated with higher anxiety and stress scores.
   Residence in DSCC was consistently associated with lower depression,
   anxiety, and stress scores compared with DNCC. Participants with strong
   confidence in protective earthquake actions reported significantly lower
   psychological distress across all three domains. In contrast,
   uncertainty regarding evacuation exits and receiving only informal
   earthquake preparedness information were associated with higher
   psychological distress. Severe self-reported mental health impact
   following the earthquake was strongly associated with increased
   depression, anxiety, and stress scores. Despite limited large-scale
   physical destruction, the earthquake generated psychological impacts
   among urban residents. The findings suggest that post-earthquake mental
   health outcomes were shaped not only by demographic factors but also by
   preparedness knowledge, perceived control, and structural safety
   perceptions. Integrating mental health support with comprehensive
   disaster preparedness strategies targeted to the highest-risk
   populations is essential to strengthening urban resilience.},
