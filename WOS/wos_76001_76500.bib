@article{ WOS:000768407900015,
Author = {Filipenko, Larysa and Kurchatova, Anzhelika and Parshuk, Svitlana and
   Yakimenko, Polina and Trofaila, Nataliia and Bilan, Liudmyla},
Title = {Psychological and Pedagogical Determinants of Personality Bullying in
   the Sociometric Dimension},
