@article{ WOS:000503000600001,
Author = {Yari, Hamed and Jin, Lei and Teng, Liu and Wang, Yufang and Wu, Yongyan
   and Liu, Guang Zhi and Gao, Wei and Liang, Jin and Xi, Yanfeng and Feng,
   Yu Chen and Zhang, Chunming and Zhang, Yuan Yuan and Tabatabaee, Hessam
   and La, Ting and Yang, Rui Hong and Wang, Fu Hua and Yan, Xu Guang and
   Farrelly, Margaret and Scott, Rodney and Liu, Tao and Thorne, Rick F.
   and Guo, Su Tang and Zhang, Xu Dong},
Title = {LncRNA REG1CP promotes tumorigenesis through an enhancer complex to
   recruit FANCJ helicase for REG3A transcription},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {NOV 25},
Abstract = {Protein products of the regenerating islet-derived (REG) gene family are
   important regulators of many cellular processes. Here we functionally
   characterise a non-protein coding product of the family, the long
   noncoding RNA (lncRNA) REG1CP that is transcribed from a DNA fragment at
   the family locus previously thought to be a pseudogene. REG1CP forms an
   RNA-DNA triplex with a homopurine stretch at the distal promoter of the
   REG3A gene, through which the DNA helicase FANCJ is tethered to the core
   promoter of REG3A where it unwinds double stranded DNA and facilitates a
   permissive state for glucocorticoid receptor alpha (GR alpha)-mediated
   REG3A transcription. As such, REG1CP promotes cancer cell proliferation
   and tumorigenicity and its upregulation is associated with poor outcome
   of patients. REG1CP is also transcriptionally inducible by GRa,
   indicative of feedforward regulation. These results reveal the function
   and regulation of REG1CP and suggest that REG1CP may constitute a target
   for cancer treatment.},
