@article{ WOS:001563805300001,
Author = {Roopnarine, Jaipaul L. and Krishnakumar, Ambika},
Title = {Mediating role of partner affection and support and maternal engagement
   in associations between maternal and paternal depression and child
   behavioural difficulties in Guyanese families},
Journal = {EARLY CHILD DEVELOPMENT AND CARE},
Year = {2025},
Volume = {195},
Number = {11},
Pages = {1109-1125},
Month = {AUG 18},
Abstract = {This study examined the mediating role of partner affection and support
   and maternal engagement in the associations between maternal and
   paternal depressive symptoms and children's behaviour problems.
   Participants were 195 Guyanese couples and their preschool-aged
   children. Mothers and fathers completed a sociodemographic
   questionnaire, the CES-D scale, and an affection and support scale, and
   mothers provided assessments of their levels of caring for, playing
   with, and engaging in literacy-based activities, and children's
   internalizing and externalizing behaviour problems. Maternal depressive
   symptoms were positively associated with children's internalizing and
   externalizing behaviour problems, and paternal depressive symptoms were
   positively associated with children's internalizing behaviour problems.
   Association between maternal depressive symptoms and externalizing
   behaviour problems was partially mediated through the mother's
   perception of partner affection and support and her engagement with
   children. Family prevention and intervention programmes should focus
   more on couple relationship and parenting.},
