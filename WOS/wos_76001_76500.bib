@article{ WOS:000320852100010,
Author = {Amato, Katherine R. and Yeoman, Carl J. and Kent, Angela and Righini,
   Nicoletta and Carbonero, Franck and Estrada, Alejandro and Gaskins, H.
   Rex and Stumpf, Rebecca M. and Yildirim, Suleyman and Torralba, Manolito
   and Gillis, Marcus and Wilson, Brenda A. and Nelson, Karen E. and White,
   Bryan A. and Leigh, Steven R.},
Title = {Habitat degradation impacts black howler monkey (Alouatta pigra)
   gastrointestinal microbiomes},
Journal = {ISME JOURNAL},
Year = {2013},
Volume = {7},
Number = {7},
Pages = {1344-1353},
Month = {JUL},
Abstract = {The gastrointestinal (GI) microbiome contributes significantly to host
   nutrition and health. However, relationships involving GI microbes,
   their hosts and host macrohabitats remain to be established. Here, we
   define clear patterns of variation in the GI microbiomes of six groups
   of Mexican black howler monkeys (Alouatta pigra) occupying a gradation
   of habitats including a continuous evergreen rainforest, an evergreen
   rainforest fragment, a continuous semi-deciduous forest and captivity.
   High throughput microbial 16S ribosomal RNA gene sequencing indicated
   that diversity, richness and composition of howler GI microbiomes varied
   with host habitat in relation to diet. Howlers occupying suboptimal
   habitats consumed less diverse diets and correspondingly had less
   diverse gut microbiomes. Quantitative real-time PCR also revealed a
   reduction in the number of genes related to butyrate production and
   hydrogen metabolism in the microbiomes of howlers occupying suboptimal
   habitats, which may impact host health.},
