@article{ WOS:000384644700004,
Author = {Sharma, Ghanashyam and Partap, Uma and Dahal, D. R. and Sharma, Durga P.
   and Sharma, Eklabya},
Title = {Declining Large-Cardamom Production Systems in the Sikkim Himalayas},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
