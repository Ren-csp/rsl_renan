@article{ WOS:001313019800001,
Author = {Moelg, Thomas and Schubert, Jan C. and Debel, Annette and Hoehnle,
   Steffen and Steppe, Kathy and Wehrmann, Sibille and Braeuning, Achim},
Title = {The weather today rocks or sucks for my tree: exploring the
   understanding of climate impacts on forests at high school level through
   tweets},
