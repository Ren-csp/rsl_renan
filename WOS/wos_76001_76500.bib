@article{ WOS:001842210400001,
Author = {Normando, Simona and Canori, Chiara and Borlini, Martina and Zanetti,
   Rossella and Walsh, Elizabeth Ann and Meers, Lieve Lucia and
   Contalbrigo, Laura},
Title = {How questions on dog behavioural problems may shape caretaker answers},
Journal = {APPLIED ANIMAL BEHAVIOUR SCIENCE},
Year = {2026},
Volume = {304},
Month = {NOV},
Abstract = {Reported prevalence of dog behavioural problems (BPs) varies. Reports
   may not depend solely on the question/ answer content, but on how the
   questions/answers are structured. We investigated whether questionnaire
   design (presence/absence of descriptor lists and response scales)
   influenced caretaker answers on possible BPs using a convenience sample
   of 569 online respondents. The respondents' perception of BPs in their
   dogs was asked in three ways (1) ``no/yes, specify{''} with an open
   answer (asked twice); 2) no/yes and 3) on a frequency scale (never to
   always) for each problem on a list. The order these questions were asked
   varied. Consistency across repeated measures and the influence of
   question design, owner and dog characteristics on owner-reported canine
   behaviours were analysed using descriptive statistics, logistic
   regression and generalized linear mixed models (GLMMs). The structure of
   the questionnaire had a strong effect on reported BP prevalence, as only
   32.7\% of caretakers spontaneously reported at least one BP in the
   open-ended format, whereas 99.0\% mentioned at least one BP when
   presented with a closed-descriptor list. The order of the questions also
   affected reporting: respondents completing the open question first,
   reported increased BPs (p < 0.001) and less correspondence between the
   answers to the open questions on BPs in the two mirror sections (p =
   0.031), suggesting that when given a list first, respondents tend to
   limit their answers to items present in the list. The agreement across
   repeated measures depended on the scale design: contextual intensity
   scales based on the C-BARQ showed higher test-retest reliability than
   standard frequency scales, with median kappa values of 0.932 and 0.687,
   respectively. Dog gender/reproductive status and age significantly
   influenced the probability of reporting BPs, although their impact
   varied across categories. Overall, these results highlight that
   caretaker-reported prevalence of dogs' BPs is sensitive to the survey
   design. Closed descriptor lists may increase reported prevalence, while
   question order and response-scale structure might shape what caretakers
   report and how consistently they report it. The structure of the
   questionnaires should, therefore, be treated as a methodological
   variable in companion animal behaviour research.},
