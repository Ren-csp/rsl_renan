@article{ WOS:001449196200001,
Author = {Lopez, Lawrence N. and Warren, Alicie and Rhoades, Stefan and Neely,
   Samuel H. and Melvin, Tiffany and Moreno, Ashley and Cook, David G. and
   Sparks, Steve and Sharp, Paul and Collins, Timothy M.},
Title = {Distribution and densities of the invasive New Guinea flatworm
   (Tricladida: Geoplanidae) in forest conservation areas of the Miami Rock
   Ridge in Southeast Florida},
Journal = {FLORIDA ENTOMOLOGIST},
Year = {2025},
Volume = {108},
Number = {S1},
Month = {JAN 29},
Abstract = {The New Guinea flatworm (Platydemus manokwari de Beauchamp) (Tricladida:
   Geoplanidae), recognized in the Global Invasive Species Database as one
   of the 100 worst invasive species, was first observed in Florida in 2012
   and documented in 2015. Since that time, P. manokwari populations have
   spread into numerous urban and natural environments throughout Florida.
   Here we report on the status of P. manokwari populations in 38 conserved
   native forests (tropical hardwood hammocks) with information on their
   geographic distribution and densities in the Miami Rock Ridge area of
   Southeast Florida. Using night-quadrat surveys, we found P. manokwari
   populations in each of the 38 protected hardwood hammocks sampled,
   having a mean density of 0.39 individuals per 1-m2 (SD 0.39, 95 \% CI
   0.26-0.52). We provide evidence that this invasive flatworm species has
   become established within these hammocks, found on a variety of forest
   substrates and consuming invertebrate prey, including terrestrial and
   arboreal gastropods, annelids, and arthropods. These hammocks then serve
   as foci for further spread of these flatworms. The appearance of P.
   manokwari has been correlated with the decline and local disappearance
   of native communities of tree snails in South Florida, following a trend
   seen in Pacific islands where P. manokwari has contributed to the
   extinction of endemic snail species. Further research is needed to
   determine the best methods for management, control, and eradication of
   the New Guinea flatworm.
   La planaria de Nueva Guinea (Platydemus manokwari de Beauchamp)
   (Tricladida: Geoplanidae), reconocido en la Base de Datos Global de
   Especies Invasoras como una de las 100 peores especies invasoras, fue
   observada por primera vez en Florida en el 2012 y documentada en el
   2015. Desde entonces, las poblaciones de P. manokwari se han extendido a
   numerosos entornos urbanos y naturales por toda Florida. Aqu \& iacute;
   informamos sobre el estado de las poblaciones de P. manokwari en 38
   bosques tropicales nativos protegidos (tropical hardwood hammocks) con
   informaci \& oacute;n sobre su distribuci \& oacute;n geogr \&
   aacute;fica y densidades en el \& aacute;rea de Miami Rock Ridge en el
   sureste de Florida. Utilizando muestreos nocturnos con cuadrantes,
   encontramos poblaciones de P. manokwari en cada una de los 38 bosques
   tropicales protegidos, con una densidad promedio de 0,39 individuos por
   m2 (SD 0,39; IC 95 \% 0,26-0,52). Proporcionamos evidencia de que esta
   planaria invasora se ha establecido dentro de estos bosques, encontr \&
   aacute;ndose en una variedad de sustratos forestales y consumiendo
   presas de invertebrados, como gaster \& oacute;podos, an \& eacute;lidos
   y artr \& oacute;podos terrestres y arb \& oacute;reos. Estos bosques
   sirven como focos para una mayor propagaci \& oacute;n de estas
   planarias. La aparici \& oacute;n de P. manokwari se ha correlacionado
   con la disminuci \& oacute;n y desaparici \& oacute;n local de
   comunidades nativas de caracoles arb \& oacute;reos en el sur de
   Florida, siguiendo una tendencia observada en las islas del Pac \&
   iacute;fico donde P. manokwari ha contribuido a la extinci \& oacute;n
   de especies end \& eacute;micas de caracoles. Se necesitan m \& aacute;s
   investigaciones para determinar los mejores m \& eacute;todos para el
   manejo, control y erradicaci \& oacute;n de la planaria de Nueva Guinea.},
