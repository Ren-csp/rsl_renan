@article{ WOS:000350300300021,
Author = {Berger, Joel and Schaller, George B. and Cheng, Ellen and Kang, Aili and
   Krebs, Michael and Li, Lishu and Hebblewhite, Mark},
Title = {Legacies of Past Exploitation and Climate affect Mammalian Sexes
   Differently on the Roof of theWorld-The Case of Wild Yaks},
Journal = {SCIENTIFIC REPORTS},
Year = {2015},
Volume = {5},
Month = {MAR 2},
Abstract = {In polar environments, a lack of empirical knowledge about biodiversity
   prompts reliance on species distribution models to predict future
   change, yet these ignore the role of biotic interactions including the
   role of long past human exploitation. To explore how mammals of extreme
   elevation respond to glacial recession and past harvest, we combined our
   fieldwork with remote sensing and used analyses of,60 expeditions from
   1850-1925 to represent baseline conditions for wildlife before heavy
   exploitation on the Tibetan Plateau. Focusing on endangered wild yaks
   (Bos mutus), we document female changes in habitat use across time
   whereupon they increasingly relied on steeper post-glacial terrain, and
   currently have a 20x greater dependence on winter snow patches than
   males. Our twin findings-that the sexes of a cold-adapted species
   respond differently to modern climate forcing and long-past
   exploitation-indicate that effective conservation planning will require
   knowledge of the interplay between past and future if we will assure
   persistence of the region's biodiversity.},
