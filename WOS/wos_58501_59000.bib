@article{ WOS:001827015600001,
Author = {El Achkar, Jean H. and AlAli, Mohammad and Afif, Marie-Jose},
Title = {Exploring sociocultural barriers and behavioural insights to food waste
   management in Kuwait: A survey-based roadmap for sustainability},
Journal = {WASTE MANAGEMENT \& RESEARCH},
Year = {2026},
Month = {2026 JUL 21},
Abstract = {Kuwait faces a significant challenge in managing food waste, with over
   90\% of municipal solid waste being disposed of in landfills, which
   contributes to environmental degradation and public health risks. This
   study investigates the sociocultural and psychological barriers to
   implementing sustainable food waste management in Kuwait and proposes
   targeted policy recommendations. A comprehensive national survey of 5000
   participants was conducted to assess public perceptions of food waste
   management and the influence of gender, age, and occupational
   background. Among its findings, the survey revealed that 70.3\% of
   respondents were willing to apply waste sorting methods at home.
   However, 38.2\% remained unaware of the health impacts of food waste,
   and 35.4\% were pessimistic about progress by 2035. Key barriers
   identified include a lack of public awareness (28\%), insufficient
   infrastructure (23\%), and sociocultural norms that shape gendered
   patterns in food waste management. Younger individuals and professionals
   in the education and medical sectors were found to be more
   environmentally conscious, offering a demographic entry point for
   intervention. The study proposes a three-tiered policy framework:
   short-term awareness campaigns and benchmarking, medium-term economic
   incentives and stakeholder engagement, and long-term legislative reform,
   infrastructure development, and waste-to-energy initiatives aligned with
   Kuwait Vision 2035.},
