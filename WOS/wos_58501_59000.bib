@article{ WOS:000313757100033,
Author = {Tran Thi Thu Ha and Bush, Simon R. and Mol, Arthur P. J. and van Dijk,
   Han},
Title = {Organic coasts? Regulatory challenges of certifying integrated
   shrimp-mangrove production systems in Vietnam},
Journal = {JOURNAL OF RURAL STUDIES},
Year = {2012},
Volume = {28},
Number = {4},
Pages = {631-639},
Month = {OCT},
Abstract = {The Vietnamese government aims to expand the scale of Naturland
   certified organic production in integrated shrimp mangrove farming
   systems across the coast of Ca Mau province by 2015. In doing so the
   division between public and private regulation has become blurred. We
   analyze the government's goal by examining the regulatory challenges of
   using organic certification as a means of linking farm-level management
   to the sustainability of coastal (mangrove) landscapes. The results show
   the importance of farmer perceptions of sustainable farm and landscape
   management, fair benefit sharing mechanisms in the certified value
   chain, and legitimate private sector-led auditing. We conclude that in
   order to overcome conflicts of interest and legitimate representation in
   organic certification, the social and economic conditions of production
   require regulatory intervention from provincial and local level
   government. To achieve benefits beyond the scale of the farm, the role
   of shrimp producers should be redefined as partners in rather than
   targets of regulation. (C) 2012 Elsevier Ltd. All rights reserved.},
