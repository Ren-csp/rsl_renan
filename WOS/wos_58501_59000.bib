@article{ WOS:001647282000001,
Author = {Wunnoo, Suttiwan and Jakkawanpitak, Chanawee and Rajagopal, Rajeev
   Shankar and Amnuaikit, Thanaporn},
Title = {Effects of a Ready-to-Drink Hydrolyzed Collagen from Sea Bass Skin on
   Skin Health: A 30-Day Clinical Trial},
Journal = {SCI},
Year = {2025},
Volume = {7},
Number = {4},
Month = {OCT 1},
Abstract = {Food waste from fish processing contributes significantly to
   environmental pollution, and fish skin is often discarded despite being
   a rich collagen source. This study evaluated the efficacy and consumer
   satisfaction of a ready-to-drink collagen supplement made from
   hydrolyzed collagen derived from seabass skin. The compositional
   analysis of this study revealed alpha-amino groups, hydroxyproline, and
   amino acids essential for skin elasticity, hydration, and tissue repair.
   A 30-day clinical trial was conducted in 36 Thai volunteers who were
   aged between 20 to 70 years, and their skin condition was assessed using
   a facial skin analyzer and a moisture analyzer on days 0, 15, and 30.
   Participants also completed self-perception and sensory satisfaction
   questionnaires. The results showed improved skin moisture, reduced pore
   size, and smoother skin texture. Participants reported high
   satisfaction, especially regarding increased moisture and skin
   smoothness. Sensory score evaluation showed favorable scores for color
   and taste; however, odor was the least preferred attribute with the
   lowest score. Notably, no adverse effects were reported throughout this
   study. The findings suggest that fish skin-derived collagen supplements
   can enhance skin appearance while offering a sustainable approach that
   converts fish by-products into functional skincare solutions aligned
   with global sustainability goals.},
