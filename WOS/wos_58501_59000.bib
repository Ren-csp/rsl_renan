@article{ WOS:000359342300067,
Author = {Wilbur, Rachel E. and Stein, Anna H. and Pinzon, Elena M. and Ahmed,
   Osub S. and McNair, Obie S. and Ribisl, Kurt M.},
Title = {Smoke-Free Multiunit Housing Policy: Caretakers' Perspectives on
   Economic and Personal Impacts},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2015},
Volume = {12},
Number = {7},
