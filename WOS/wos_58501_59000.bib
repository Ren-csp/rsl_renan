@article{ WOS:001435592900030,
Author = {Reyes, Lauren and Naser, Lena and Weiner, Warren S. and Thifault, Darren
   and Stahl, Erik and Mccreary, Liam and Nott, Rohini and Quick, Colton
   and Buchberger, Alex and Alvarado, Carlos and Rivera, Andrew and Miller,
   Joseph A. and Khatiwala, Ruchi and Cherry, Brian R. and Nelson, Ronald
   and Martin-Garcia, Jose M. and Stephanopoulos, Nicholas and Fromme,
   Raimund and Fromme, Petra and Cance, William and Marlowe, Timothy},
Title = {Structure-based discovery of hydrocarbon-stapled paxillin peptides that
   block FAK scaffolding in cancer},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {FEB 28},
Abstract = {The focal adhesion kinase (FAK) scaffold provides FAK-targeted cancer
   therapeutics with greater efficacy and specificity than traditional
   kinase inhibitors. The FAK scaffold function largely involves the
   interaction between FAK's focal adhesion targeting (FAT) domain and
   paxillin, ultimately regulating many hallmarks of cancer. We report the
   design of paxillin LD-motif mimetics that successfully inhibit the
   FAT-paxillin interaction. Chemical and biochemical screening identifies
   stapled peptide 1907, a high affinity binder of the FAT four-helix
   bundle with similar to 100-fold greater binding affinity than the native
   LD2-sequence. The X-ray co-crystal structure of the FAT-1907 complex is
   solved. Myristoylated 1907-analog, peptide 2012, delocalizes FAK from
   focal adhesions, induces cancer cell apoptosis, reduces in vitro
   viability and invasion, and decreases tumor burden in B16F10 melanoma
   female mice. Enzymatic FAK inhibition produces no comparable effects.
   Herein, we describe a biologically potent therapeutic strategy to target
   the FAK-paxillin complex, a previously deemed undruggable
   protein-protein interaction.},
