Author = {de Schipper, Matthieu A. and Ludka, Bonnie C. and Raubenheimer, Britt
   and Luijendijk, Arjen P. and Schlacher, Thomas. A.},
Title = {Beach nourishment has complex implications for the future of sandy
   shores},
