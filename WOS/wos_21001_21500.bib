@article{ WOS:001475610200001,
Author = {Xi, Yueting and Liu, Taili and Wang, Yan and Ying, Fei J. and Han, Yuru
   and Luo, Sha and Zhang, Pei},
Title = {Developing a Framework for Sustainable Management of Archaeological Site
   Parks: Cross-Case Analysis Based on Public Perception},
