@article{ WOS:000704477800014,
Author = {Jedyn, Adrian and Azzulin, Mayara Bormann and Antunes Hardt, Leticia
   Peret and Fernandes, Valdir},
Title = {Nature conservation under the perspective of community management},
Journal = {REVISTA TECNOLOGIA E SOCIEDADE},
Year = {2021},
Volume = {17},
Number = {49},
Pages = {201-218},
Month = {OCT-DEC},
Abstract = {Human societies demand ecosystem services and directly impact the
   environment, making necessary the nature conservation for the sustenance
   of life. Based on this assumption, the objective of the research is to
   analyse the main approaches on the protection of natural resources
   through community management processes, based on an integrative review
   of contemporary texts. With different academic and locational origins,
   the selected articles indicate, as central concerns, the importance of
   both the plural interaction of the actors in conservationist practices
   and the shared management of common goods. In parallel, they highlight
   the influence of local elites and the presence of external agents as
   disruptive of collective relations. Thus, it is highlighted the
   relevance of horizontal integration, as opposed to centralized and
   verticalized power politics, which negatively affect the social groups'
   sense of belonging to the environments involved.},
