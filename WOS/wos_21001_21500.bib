@article{ WOS:001626030900001,
Author = {Villamor, Grace B. and Wang, Thea (xiwen) and Fahmy, Muthasim and Jones,
   Alan and Bennett, Paul},
Title = {Landowners' perception of short-rotation forestry for biofuel in New
   Zealand: awareness, familiarity, and barriers to integrate in their
   farmlands},
Journal = {ENERGY POLICY},
Year = {2026},
Volume = {209},
Number = {A},
Month = {FEB},
Abstract = {Short-rotation forestry (SRF) is an emerging concept in New Zealand with
   the potential for sustainable biofuel production. This study
   investigates landowners' perceptions of short-rotation forestry (SRF) as
   a biofuel production strategy in New Zealand, emphasising their
   awareness, familiarity, and perceived barriers to its implementation on
   their farmlands. As New Zealand aims for enhanced energy security and
   reduced greenhouse gas emissions, SRF presents a viable option for
   sustainable biomass production. Through a survey of 800 landowners
   across six regions representing diverse farm types and demographics, the
   research explores landowners' attitudes and decision-making processes
   regarding the adoption of SRF in light of government policies promoting
   bioenergy. The findings reveal limited awareness and familiarity with
   SRF practices among landowners and significant concerns regarding
   economic viability, land management, and environmental impacts.
   Familiarity with SRF was seen to correlate negatively with adoption
   likelihood, indicating that perceived risks outweigh potential benefits
   for many landowners. Drawing on international SRF experiences, this
   study recommends pilot programmes, financial incentives, and targeted
   outreach to address barriers. These findings provide a foundation for
   future policy and planning to introduce SRF as a viable pathway for New
   Zealand's bioenergy strategy.},
