@article{ WOS:001737335800001,
Author = {Jiang, Shan and Zheng, Jianyi},
Title = {Research on the justice of public space in Macao's social housing based
   on grounded theory},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Based on grounded theory and spatial justice theory, this study
   addresses the understudied problem of spatial justice in public spaces
   within Macao's social housing communities, which are critical yet often
   neglected sites of urban inequality. The aim is to identify the key
   factors influencing perceptions and experiences of justice in these
   spaces and to construct a comprehensive theoretical model that explains
   their interplay. The study proposes three core dimensions-Spatial
   Publicness, Spatial Equality, and Spatial Diversity-that together shape
   the spatial justice in high-density social housing environments, which
   reveals how is spatial justice manifested and experienced in the public
   spaces of Macao's social housing, and what factors determine its
   perception. Methodologically, the research employs semi-structured
   interviews with residents based on Grounded Theory and utilizes a
   rigorous three-level coding process to analyse qualitative data. The
   findings reveal intrinsic tensions between accessibility and safety
   management, uncover micro-level environmental inequality despite
   macro-level equality, and discuss how spatial diversity would promote
   inclusivity while countering disciplinary management. The study
   concludes with practical policy recommendations aimed at optimizing
   spatial justice and contributes a transferable framework for global
   social housing policy, particularly in high-density urban contexts,
   advocating for people-oriented approaches that enhance equity and
   dignity.},
