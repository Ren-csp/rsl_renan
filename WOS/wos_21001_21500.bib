Author = {Asadollahi, Abdolrahim and Firozjaee, Somayeh Fathtabar and
   Januchta-Szostak, Anna and Musavi, Vafa and Rakhshani, Tayebeh and
   Hosseini, Seyedeh Najmeh and Keyhanmehr, Shaghayegh},
Title = {Evaluation of indicators of aging-friendly urban indicators in 8
   districts of Ahwaz metropolitan, southwest Iran},
Journal = {DISCOVER APPLIED SCIENCES},
Year = {2025},
Volume = {7},
Number = {9},
Month = {AUG 25},
Abstract = {ObjectivesThis study evaluated aging-friendly urban indicators in
   southwestern Iran during the second half of 2023.Materials \& methodsA
   descriptive-analytical approach was employed, surveying 894 older adults
   through stratified random sampling. Spatial patterns were analyzed using
   GIS, and statistical analysis was performed with SPSS
   (v28).ResultsSpatial autocorrelation and cluster patterns were observed
   across all eight districts in key aging-friendly city components,
   including urban open spaces, transportation systems, public/religious
   buildings, traffic safety, social participation, social respect,
   culture-recreation, and healthcare accessibility.ConclusionFindings
   indicate significant gaps in aging-friendly infrastructure in Ahvaz
   Metropolitan, highlighting the need for targeted urban policies and
   planning interventions to improve livability for older adults. Targeted
   interventions, such as improving transportation safety and healthcare
   access, are recommended to address these gaps.},
