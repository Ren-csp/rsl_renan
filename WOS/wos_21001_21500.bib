@article{ WOS:000730799800002,
Author = {Olafsdottir, Rannveig and Saeporsdottir, Anna Dora and Tverijonaite,
   Edita},
Title = {Running Wild: Environmental Attitudes of LongDistance Runners in the
   Icelandic Highlands},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
