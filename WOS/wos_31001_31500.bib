@article{ WOS:000629597700002,
Author = {Bertoglio, Federico and Meier, Doris and Langreder, Nora and Steinke,
   Stephan and Rand, Ulfert and Simonelli, Luca and Heine, Philip Alexander
   and Ballmann, Rico and Schneider, Kai-Thomas and Roth, Kristian Daniel
   Ralph and Ruschig, Maximilian and Riese, Peggy and Eschke, Kathrin and
   Kim, Yeonsu and Schaeckermann, Dorina and Pedotti, Mattia and Kuhn,
   Philipp and Zock-Emmenthal, Susanne and Woehrle, Johannes and Kilb,
   Normann and Herz, Tobias and Becker, Marlies and Grasshoff, Martina and
   Wenzel, Esther Veronika and Russo, Giulio and Kroeger, Andrea and
   Brunotte, Linda and Ludwig, Stephan and Fuehner, Viola and Kraemer,
   Stefan Daniel and Duebel, Stefan and Varani, Luca and Roth, Gunter and
   Cicin-Sain, Luka and Schubert, Maren and Hust, Michael},
Title = {SARS-CoV-2 neutralizing human recombinant antibodies selected from
   pre-pandemic healthy donors binding at RBD-ACE2 interface},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {MAR 11},
Abstract = {COVID-19 is a severe acute respiratory disease caused by SARS-CoV-2, a
   new recently emerged sarbecovirus. This virus uses the human ACE2 enzyme
   as receptor for cell entry, recognizing it with the receptor binding
   domain (RBD) of the S1 subunit of the viral spike protein. We present
   the use of phage display to select anti-SARS-CoV-2 spike antibodies from
   the human naive antibody gene libraries HAL9/10 and subsequent
   identification of 309 unique fully human antibodies against S1. 17
   antibodies are binding to the RBD, showing inhibition of spike binding
   to cells expressing ACE2 as scFv-Fc and neutralize active SARS-CoV-2
   virus infection of VeroE6 cells. The antibody STE73-2E9 is showing
   neutralization of active SARS-CoV-2 as IgG and is binding to the
   ACE2-RBD interface. Thus, universal libraries from healthy human donors
   offer the advantage that antibodies can be generated quickly and
   independent from the availability of material from recovering patients
   in a pandemic situation. Antibodies targeting the spike protein of
   coronaviruses are potential candidates for therapeutic development.
   Here, Bertoglio et al. use phage display to select anti-SARS-CoV-2 spike
   antibodies from the human naive universal antibody gene libraries
   HAL9/10 that block interaction with ACE2 receptor to inhibit infection.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Schubert, M; Hust, M (Corresponding Author), Tech Univ Carolo Wilhelmina Braunschweig, Inst Biochem Biotechnol \& Bioinformat, Abt Biotechnol, Braunschweig, Germany.
