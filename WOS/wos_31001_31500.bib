@article{ WOS:001702385700001,
Author = {Shi, Yixing and Huang, Yinghao and Ding, Chentao and Lin, Hao and Lin,
   Jiachen and Wang, Shaowei and Ge, Ren-shan and Shangguan, Wangning},
Title = {Structural and mechanistic insights into industrial phenolic compounds
   as potent inhibitors of human and rat 5α-reductase 1},
Journal = {ECOTOXICOLOGY AND ENVIRONMENTAL SAFETY},
Year = {2026},
Volume = {312},
Month = {MAR 1},
Abstract = {This study identifies environmental chemicals 4-nonylphenol,
   4-dodecylphenol, pentabromophenol, and popular anesthetics drug propofol
   as moderate to potent inhibitors of human and rat 5 alpha-reductase type
   1 (5 alpha-R1), revealing novel endocrine-disrupting mechanisms in human
   brain cell and rat brain microsomes. Pentabromophenol exhibited the
   highest potency (IC50 = 1.71 \& micro;M for human 5 alpha-R1) with
   mixed/noncompetitive inhibition, supported by Surface Plasmon Resonance
   binding (KD = 1.22 \& micro;M). A 3D-QSAR pharmacophore model (Hypo1)
   highlighted critical structural features, including a hydrogen-bond
   acceptor and hydrophobic interactions, explaining pentabromophenol
   efficacy. Species differences emerged, with human 5 alpha-R1 showing
   high pentabromophenol binding affinity (-6.80 kcal/mol via halogen bonds
   with Arg176). Inhibition may reduce neurosteroids (e.g.,
   allopregnanolone) and androgens (e.g., dihydrotestosterone). These
   findings underscore industrial phenolic compound capacity to dysregulate
   neurosteroid homeostasis in a structure- and species-dependent manner,
   highlighting their endocrine-disrupting risks.},
Publisher = {ACADEMIC PRESS INC ELSEVIER SCIENCE},
Address = {525 B ST, STE 1900, SAN DIEGO, CA 92101-4495 USA},
Type = {Article},
Language = {English},
Affiliation = {Ge, RS; Shangguan, WN (Corresponding Author), Wenzhou Med Univ, Yuying Childrens Hosp, Wenzhou 325027, Zhejiang, Peoples R China.
