@article{ WOS:001676692200013,
Author = {Tripon, Cristina},
Title = {From lab to table: engaging STEM students in sustainable and healthy
   food choices through service-learning approach},
Journal = {JOURNAL OF EDUCATIONAL SCIENCES \& PSYCHOLOGY},
Year = {2025},
Volume = {15},
Number = {2},
Pages = {144-160},
Abstract = {The global landscape is witnessing an increasing awareness of the
   interplay between dietary choices, environmental sustainability, and
   individual well-being. In the context of higher education, particularly
   among Science, Technology, Engineering, and Mathematics (STEM) students,
   the intersection of sustainable and healthy eating habits presents a
   unique avenue for investigation. This study explores the attitudes,
   challenges, and influencing factors related to sustainable and healthy
   food choices among STEM students engaged in service-learning activities
   in public schools. The primary aim is to examine students' beliefs,
   values, and perceptions toward adopting sustainable and health-conscious
   eating practices. Additionally, the study seeks to identify the key
   barriers that hinder students from making such choices while
   participating in community-based educational initiatives. Complementing
   these aims, the research investigates the cultural, social, economic,
   and environmental factors that shape students' food-related decisions.
   It also assesses their level of awareness and understanding regarding
   the impact of food choices on personal well-being and environmental
   sustainability. Overall, the findings are expected to provide insights
   that can inform the design of targeted interventions and educational
   strategies that promote sustainable and healthy food behaviors among
   STEM learners within service-learning contexts.},
