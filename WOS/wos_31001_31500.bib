@article{ WOS:001247684900001,
Author = {Narbarte, Josu and Iriarte, Eneko},
Title = {Human Agency and Coastal Landscape Transformation in Early Modern
   Atlantic Europe: An Interdisciplinary Research Approach in the Urola
   Estuary (Basque Coast)},
Journal = {ENVIRONMENTAL ARCHAEOLOGY},
