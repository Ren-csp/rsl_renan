@article{ WOS:001803889000001,
Author = {Li, Chenyang and Liu, Zhiheng and Zhou, Suiping},
Title = {A Target Tracking Method Based on Frequency and Spatial Information
   Perception in UAV Vision},
Journal = {REMOTE SENSING},
Year = {2026},
Volume = {18},
Number = {12},
Month = {JUN 18},
Abstract = {Highlights What are the main findings? We proposed a Transformer-based
   UAV target tracking framework (FSTrack) that jointly exploits
   frequency-domain and spatio-temporal information to improve target
   representation and localization under challenging conditions such as
   illumination variation, occlusion, and background interference. A
   frequency-spatial enhancement module and a spatio-temporal feature
   fusion module are introduced to capture complementary target
   characteristics across frames, resulting in improved tracking robustness
   and accuracy within a fully end-to-end architecture. What are the
   implications of the main findings? The findings demonstrate that
   integrating frequency-domain cues with spatial and temporal
   representations provides a more discriminative and robust tracking
   strategy for UAV vision in complex real-world environments. The proposed
   end-to-end design reduces reliance on post-processing and simplifies the
   conventional tracking pipeline, making FSTrack more suitable for
   practical real-time UAV tracking applications.Highlights What are the
   main findings? We proposed a Transformer-based UAV target tracking
   framework (FSTrack) that jointly exploits frequency-domain and
   spatio-temporal information to improve target representation and
   localization under challenging conditions such as illumination
   variation, occlusion, and background interference. A frequency-spatial
   enhancement module and a spatio-temporal feature fusion module are
   introduced to capture complementary target characteristics across
   frames, resulting in improved tracking robustness and accuracy within a
   fully end-to-end architecture. What are the implications of the main
   findings? The findings demonstrate that integrating frequency-domain
   cues with spatial and temporal representations provides a more
   discriminative and robust tracking strategy for UAV vision in complex
   real-world environments. The proposed end-to-end design reduces reliance
   on post-processing and simplifies the conventional tracking pipeline,
   making FSTrack more suitable for practical real-time UAV tracking
   applications.Abstract Target tracking for Unmanned Aerial Vehicles
   (UAVs) can be significantly impacted by environmental factors such as
   lighting variations, background clutter, and target occlusion. To
   address these challenges, we developed a target tracking method that
   integrates both frequency-domain and spatial perception capabilities in
   UAV vision (FSTrack). Specifically: (1) we utilized the Swin Transformer
   as the core network to extract features from both the template and
   search images; (2) we introduced a Transformer-based module to enhance
   both frequency and spatial information, improving tracking accuracy
   under varying illumination conditions; (3) we designed a spatio-temporal
   feature fusion module with multiple multi-head self-attention mechanisms
   to precisely model the tracking state, thus increasing reliability in
   cluttered and occluded environments; and (4) we created a hybrid loss
   function to boost accuracy in both classification and regression tasks.
   Our experimental results on the UAV123, DTB70, and UAVDT datasets show
   that our approach not only surpasses current state-of-the-art methods in
   success rates and precision but also operates more swiftly.},
