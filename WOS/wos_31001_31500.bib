@article{ WOS:001480834000022,
Author = {Roy, Megha and Sanchez, Aurore and Guerois, Raphael and Senoussi, Issam
   and Cerana, Arianna and Sgrignani, Jacopo and Cavalli, Andrea and
   Rinaldi, Andrea and Cejka, Petr},
Title = {EXO1 promotes the meiotic MLH1-MLH3 endonuclease through conserved
   interactions with MLH1, MSH4 and DNA},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {MAY 3},
Abstract = {The endonuclease activity of MLH1-MLH3 (MutL gamma) is stimulated by
   MSH4-MSH5 (MutS gamma), EXO1, and RFC-PCNA to resolve meiotic
   recombination intermediates such as double Holliday junctions (HJs) into
   crossovers. We show that EXO1 directly interacts with MLH1 via the EXO1
   MIP motif and a patch centered around EXO1-I403. Disrupting this
   interaction unexpectedly only partially inhibited MutL gamma. We found
   that EXO1 also directly interacts with MutS gamma. Crucially, a single
   point mutation in EXO1 (W371E) impairs its interaction with MSH4 and
   completely abolished its ability to activate DNA nicking by MutL gamma
   without affecting its intrinsic nuclease function. Finally, disrupting
   magnesium coordinating residues in the nuclease domain of EXO1 has no
   impact on MutS gamma-MutL gamma activity, while the integrity of EXO1
   residues mediating interactions with double-stranded DNA (dsDNA) is
   important. Our findings suggest EXO1 is an integral structural component
   of the meiotic resolvase complex, supported by conserved interactions
   with MutS gamma, MutL gamma and dsDNA. We propose that EXO1 helps tether
   MutS gamma-MutL gamma to dsDNA downstream of HJ recognition to promote
   DNA cleavage.},
