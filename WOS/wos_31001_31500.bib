@article{ WOS:000367579500001,
Author = {Suweis, Samir and Grilli, Jacopo and Banavar, Jayanth R. and Allesina,
   Stefano and Maritan, Amos},
Title = {Effect of localization on the stability of mutualistic ecological
   networks},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {DEC},
Abstract = {The relationships between the core-periphery architecture of the species
   interaction network and the mechanisms ensuring the stability in
   mutualistic ecological communities are still unclear. In particular,
   most studies have focused their attention on asymptotic resilience or
   persistence, neglecting how perturbations propagate through the system.
   Here we develop a theoretical framework to evaluate the relationship
   between the architecture of the interaction networks and the impact of
   perturbations by studying localization, a measure describing the ability
   of the perturbation to propagate through the network. We show that
   mutualistic ecological communities are localized, and localization
   reduces perturbation propagation and attenuates its impact on species
   abundance. Localization depends on the topology of the interaction
   networks, and it positively correlates with the variance of the weighted
   degree distribution, a signature of the network topological
   heterogeneity. Our results provide a different perspective on the
   interplay between the architecture of interaction networks in
   mutualistic communities and their stability.},
Publisher = {NATURE PUBLISHING GROUP},
