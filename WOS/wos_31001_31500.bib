@article{ WOS:000079507900012,
Author = {Kastner, M},
Title = {Oceanic minerals: Their origin, nature of their environment and
   significance},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1999},
Volume = {96},
Number = {7},
Pages = {3380-3387},
Month = {MAR 30},
Note = {National-Academy-of-Sciences Colloquium on Geology, Mineralogy, and
   Human Welfare, ARNOLD \& MABEL BECKMAN CTR, IRVINE, CA, NOV 08-09, 1998},
Organization = {Natl Acad Sci},
Abstract = {The chemical and isotopic compositions of oceanic biogenic and
   authigenic minerals contain invaluable information on the evolution of
   seawater, hence on the history of interaction between tectonics,
   climate, ocean circulation, and the evolution of life. Important
   advances and greater understanding of (a) key minor and trace element
   cycles with various residence times, (b) isotopic sources and sinks and
   fractionation behaviors, and (c) potential diagenetic problems, as well
   as developments in high-precision instrumentation, recently have been
   achieved. These advances provided new compelling evidence that neither
   gradualism nor uniformitarianism can explain many of the new important
   discoveries obtained from the chemistry and isotopic compositions of
   oceanic minerals. Presently, the best-developed geochemical proxies in
   biogenic carbonates are O-18/O-16 and Sr/Ca ratios (possibly Mg/Ca) for
   temperature; Sr-87/Sr-86 for input sources, Cd/Ca and Ba/Ca ratios for
   phosphate and alkalinity concentrations, respectively, thus also for
   ocean circulation; C-13/C-12 for ocean productivity; B isotopes for
   seawater pH;, U, Th isotopes, and C-14 for dating; and Sr and Mn
   concentrations for diagenesis, The oceanic authigenic minerals most
   widely used for chemical paleoceanography are barite, evaporite
   sulfates, and hydrogenous ferromanganese nodules, Marine barite is an
   effective alternative monitor of seawater Sr-87/Sr-86, especially where
   carbonates are diagenetically altered or absent. It also provides a
   high-resolution record of seawater sulfate S isotopes, (evaporite
   sulfates only carry an episodic record), with new insights on factors
   affecting the S and C cycles and atmospheric oxygen. High-resolution
   studies of Sr, Nd, and Pb isotopes of well-dated ferromanganese nodules
   contain invaluable records on climate driven changes in oceanic
   circulation.},
Publisher = {NATL ACAD SCIENCES},
Address = {2101 CONSTITUTION AVE NW, WASHINGTON, DC 20418 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Kastner, M (Corresponding Author), Univ Calif San Diego, Scripps Inst Oceanog, La Jolla, CA 92093 USA.
   Univ Calif San Diego, Scripps Inst Oceanog, La Jolla, CA 92093 USA.},
