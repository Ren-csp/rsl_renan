@article{ WOS:001876212800001,
Author = {Xiao, Yunxia and Zou, Zhijie and Sun, Gengxin},
Title = {Gamification and sustainable mobility: Determinants of green travel app
   adoption},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {576},
Month = {SEP 20},
Abstract = {While sustainable transport is increasingly called for in urban
   environments to address congestion and pollution, the uptake of
   environmentally friendly modes of transport is still low because of
   implementation challenges and low incentives. Gamified green travel
   applications address this gap by integrating points, badges, challenges,
   and rewards into travel planning. In this study, the authors integrate
   the Theory of Planned Behavior (TPB) and the Technology Acceptance Model
   (TAM) and examine the intention of the passengers to use such apps. The
   study uses a survey data collected from urban residents to examine
   relationships between perceived usefulness, perceived ease of use,
   attitude, subjective norms, perceived behavioral control, enjoyment,
   incentives, and adoption intention, using structural equation modelling.
   The results indicate that perceived usefulness and ease of use improve
   attitudes and enjoyment and incentives improve perceptions. Gamification
   indirectly benefits adoption through usefulness and enjoyment, and
   social norms and behavioral control play a pivotal role in explaining
   adoption, which is in line with the integrated TAM-TPB framework.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
