@article{ WOS:001520523200008,
Author = {Zhao, Xiangdong and Xue, Naihua and Yang, Hu and Zheng, Daran and Peng,
   Jungang and Frieling, Joost and De Vleeschouwer, David and Fu, Xuewu and
   Jia, Wanglu and Fang, Yanan and Li, Sha and Wang, Meng and Zhao, Xianye
   and Wang, Qiang and Zhang, Haichun and Sha, Jingeng and Jenkyns, Hugh C.
   and Claeys, Philippe and Wang, Bo},
Title = {Climate-carbon-cycle interactions and spatial heterogeneity of the late
   Triassic Carnian pluvial episode},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUN 30},
Abstract = {The Carnian Pluvial Episode (CPE; 234-232 million years ago) is an
   iconic but poorly understood hyperthermal event. Here, we present an
   integrated high-resolution (similar to 2-10 kyr) multi-proxy record from
   a Carnian lacustrine succession of the Junggar Basin of northwestern
   China. We find that the rapid CPE onset (similar to 15.8 kyr) could have
   been the result of volcanism and subsequent surface carbon-cycle
   feedbacks. The CPE terrestrial carbon cycling, at a scale of +/- 1 parts
   per thousand (delta C-13(org)), displays an in-phase relationship with
   the 405-kyr-long-eccentricity parameter, paralleling the warmhouse
   climate-carbon-cycle interactions throughout the Oligo-Miocene. The CPE
   hydrological cycle was typified by increased aridification in
   continental interiors and multiple precipitation centres at low-latitude
   eastern regions of Pangea and at the poles. The carbon and hydrological
   cycle changes of the CPE include features reminiscent of other warm
   events, suggesting they may share key characteristics and hold important
   clues to Earth system functioning.},
