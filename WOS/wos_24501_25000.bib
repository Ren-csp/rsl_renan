@article{ WOS:001124770600005,
Author = {Amaral, Paulo and Carbonell-Sala, Silvia and De La Vega, Francisco M.
   and Faial, Tiago and Frankish, Adam and Gingeras, Thomas and Guigo,
   Roderic and Harrow, Jennifer L. and Hatzigeorgiou, Artemis G. and
   Johnson, Rory and Murphy, Terence D. and Pertea, Mihaela and Pruitt, Kim
   D. and Pujar, Shashikant and Takahashi, Hazuki and Ulitsky, Igor and
   Varabyou, Ales and Wells, Christine A. and Yandell, Mark and Carninci,
   Piero and Salzberg, Steven L.},
Title = {The status of the human gene catalogue},
Journal = {NATURE},
Year = {2023},
Volume = {622},
Number = {7981},
Pages = {41-47},
Month = {OCT 5},
Abstract = {Scientists have been trying to identify every gene in the human genome
   since the initial draft was published in 2001. In the years since, much
   progress has been made in identifying protein-coding genes, currently
   estimated to number fewer than 20,000, with an ever-expanding number of
   distinct protein-coding isoforms. Here we review the status of the human
   gene catalogue and the efforts to complete it in recent years. Beside
   the ongoing annotation of protein-coding genes, their isoforms and
   pseudogenes, the invention of high-throughput RNA sequencing and other
   technological breakthroughs have led to a rapid growth in the number of
   reported non-coding RNA genes. For most of these non-coding RNAs, the
   functional relevance is currently unclear; we look at recent advances
   that offer paths forward to identifying their functions and towards
   eventually completing the human gene catalogue. Finally, we examine the
   need for a universal annotation standard that includes all medically
   significant genes and maintains their relationships with different
   reference genomes for the use of the human gene catalogue in clinical
   settings. Although the catalogue of human protein-coding genes is
   nearing completion, the number of non-coding RNA genes remains highly
   uncertain, and for all genes much work remains to be done to understand
   their functions.},
