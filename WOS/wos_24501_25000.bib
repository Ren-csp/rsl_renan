@article{ WOS:000403523900003,
Author = {Santoro, Calogero M. and Capriles, Jose M. and Gayo, Eugenia M. and
   Eugenia de Porras, Maria and Maldonado, Antonio and Standen, Vivien G.
   and Latorre, Claudio and Castro, Victoria and Angelo, Dante and
   McRostie, Virginia and Uribe, Mauricio and Valenzuela, Daniela and
   Ugalde, Paula C. and Marquet, Pablo A.},
Title = {Continuities and discontinuities in the socio-environmental systems of
   the Atacama Desert during the last 13,000 years},
Journal = {JOURNAL OF ANTHROPOLOGICAL ARCHAEOLOGY},
Year = {2017},
Volume = {46},
Pages = {28-39},
Month = {JUN},
Abstract = {Understanding how human societies interacted with environmental changes
   is a major goal of archaeology and other socio-natural sciences. In this
   paper, we assess the human-environment interactions in the Pampa del
   Tamarugal (PDT) basin of the Atacama Desert over the last 13,000 years.
   By relying on a socioenvironmental model that integrates ecosystem
   services with adaptive strategies, we review past climate changes,
   shifting environmental conditions, and the continuities and
   discontinuities in the nature and intensity of the human occupation of
   the PDT. As a result we highlight the importance of certain key
   resources such as water, an essential factor in the long-term trajectory
   of eco-historical change. Without water the outcome of human societies
   becomes hazardous. (C) 2016 Elsevier Inc. All rights reserved.},
