@article{ WOS:001864205100005,
Author = {Ta, Nga Tuyet and Nishikawa, Kanto and Kojima, Yosuke and Tran, Dung Van
   and Dao, Tuan Anh and Numata, Shinya},
Title = {Spatial and Seasonal Dynamics of Amphibian and Reptile Roadkill in Ba Vi
   National Park, Northern Vietnam},
Journal = {CURRENT HERPETOLOGY},
Year = {2026},
Volume = {45},
Number = {2},
Pages = {189-206},
Month = {AUG},
Abstract = {Roads within protected areas can cause substantial mortality of
   amphibians and reptiles, yet quantitative roadkill data from tropical
   protected areas in Vietnam remain limited. We assessed amphibian and
   reptile road mortality in Ba Vi National Park, northern Vietnam, using
   systematic road surveys conducted during three periods between March
   2024 and February 2025. Amphibians accounted for about half of all
   records but included fewer species, whereas reptile roadkills were more
   species-rich. Kernel Density Estimation outputs suggested that amphibian
   hotspots were relatively localized, whereas reptile hotspots were more
   extensive and dispersed. Seasonal patterns also differed between taxa. A
   significant interaction between taxon and seasonal phase was supported,
   with predicted amphibian roadkill counts highest during the sampled
   hot-rainy months (May and September) and reptile roadkill highest during
   the transitional months (April, October, and November). This study
   provides rare evidence from Vietnam and highlights the need for
   mitigation strategies targeted by taxonomic groups, road segments, and
   seasons, especially as protected-area infrastructure continues to
   support tourism and management.},
