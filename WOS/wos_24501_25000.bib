@article{ WOS:001083904400001,
Author = {Suffo, M. and Brey, M. and Orellana, J. P. and Garcia-Morales, J. L.},
Title = {Feasibility of utilization of recycled HDPE in manhole covers for urban
   traffic areas and industrial zones},
