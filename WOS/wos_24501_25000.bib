@article{ WOS:000524946500005,
Author = {Uribe, Mauricio and Angelo, Dante and Capriles, Jose and Castro,
   Victoria and Eugenia de Porras, Maria and Garcia, Magdalena and Gayo,
   Eugenia and Gonzalez, Josefina and Jose Herrera, Maria and Izaurieta,
   Roberto and Maldonado, Antonio and Mandakovic, Valentina and Mcrostie,
   Virginia and Razeto, Jorge and Santana, Francisca and Santoro, Calogero
   and Valenzuela, Jimena and Vidal, Alejandra},
Title = {Formative Period in Tarapaca (3000-1000 BP): Archeology, nature and
   culture in the Pampa del Tamarugal, Atacama Desert, northern Chile},
Journal = {LATIN AMERICAN ANTIQUITY},
Year = {2020},
Volume = {31},
Number = {1},
Pages = {81-102},
Month = {MAR},
Abstract = {In this article, we illustrate the relationships that human societies
   established with their environment during the Formative period in the
   Pampa del Tamarugal (3000-1000 BP), Atacama Desert, Chile. We employed a
   theoretical-methodological perspective that emphasizes the explanatory
   potential of ecofacts. By mediating between humans and environment, this
   perspective provides a better understanding of how these societies
   constructed nature and culture. The purpose is to show that this process
   was part of a long history of rationalization of the desert, its
   resources, and the lived experience of the Formative communities that
   occupied that landscape. Therefore, we propose that this human
   intervention in Pampa del Tamarugal can be understood not only as an
   ecological and economic change but also a ``cosmological{''} one.},
