@article{ WOS:000455808000009,
Author = {Maurer, Michaela and Bogner, Franz Xaver},
Title = {How freshmen perceive Environmental Education (EE) and Education for
   Sustainable Development (ESD)},
Journal = {PLOS ONE},
Year = {2019},
Volume = {14},
Number = {1},
Month = {JAN 14},
Abstract = {Concepts of 464 university freshmen towards Environmental Education (EE)
   and Education for Sustainable Development (ESD) were analyzed. Responses
   were classified into seven main categories: `ecological aspects',
   `ecological problems', `economical aspects', `social aspects',
