@article{ WOS:001869112500001,
Author = {Qian, Cheng and Fu, Bin},
Title = {A Multi-UAV Cooperative Environmental Awareness Method via Distributed
   Information Fusion},
Journal = {COMPLEXITY},
Year = {2026},
Volume = {2026},
Number = {1},
Abstract = {This paper proposes a distributed information-fusion framework for
   cooperative environmental awareness in multi-UAV systems. The framework
   addresses limited individual sensing coverage and incomplete, spatially
   discontinuous observations in cluttered or communication-constrained
   scenarios by integrating a UAV control model, a directional perception
   model, and a feature-level fusion architecture. Salient features from
   multiple platforms are extracted, normalized for translation, rotation,
   and scale, and matched to generate a consistent global map. Simulation
   results show that the proposed method improves situational consistency,
   reduces redundant data transmission, and enhances flight safety in
   unknown environments. These results support multi-UAV applications in
   emergency response, environmental monitoring, and large-area
   exploration.},
