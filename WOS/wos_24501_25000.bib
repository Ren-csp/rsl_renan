@article{ WOS:001716025400002,
Author = {Noori, Sajad and Hughes, Alice C. and Vasconcelos, Thais N. C. and
   Ascher, John S. and Miller, Jared T. and Gaugel, Sarah M. and Ostwald,
   Madeleine M. and Dorey, James B. and Gonzalez, Victor H. and Martins,
   Aline C. and Orr, Michael C. and Seltmann, Katja C.},
Title = {A curated and integrated dataset for exploring global bee-plant
   interactions},
Journal = {SCIENTIFIC DATA},
Year = {2026},
Volume = {13},
Number = {1},
Month = {MAR 7},
Abstract = {Bees are one of the most important pollinators in terrestrial
   ecosystems, supporting biodiversity and food production. However, global
   knowledge of their interactions with host plants remains limited. To
   address this, we describe and refine a subset of the Global Biotic
   Interactions (GloBI) database focused on bee-plant interactions. We
   updated taxonomy using current checklists and enhanced the dataset with
   metadata on geography, endemism, and human uses of plants. The resulting
   dataset includes 981,982 unique interaction records between 5,537 bee
   species and 12,699 plant taxa. Despite its scale, the dataset is
   affected by strong taxonomic and geographic biases. It covers only 26\%
   of described bee species and 4\% of flowering plant taxa-primarily those
   used by humans-and is heavily skewed toward North America and Western
   Europe. Nevertheless, GloBI represents a valuable resource for
   incorporating bee-plant interactions into biodiversity and
   conservation-oriented research and represents a considerable advance in
   our current knowledge.},
