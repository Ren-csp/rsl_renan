@article{ WOS:001777073000001,
Author = {Yang, Weixiong and Guo, Yuhan and Han, Mingguang and Feng, Bin and Ma,
   Yuan and Xu, Bingang and Liu, Fu and Wang, Dan and Hao, Pingping and
   Ding, Xilun and Luo, Sida},
Title = {A Folded, Structure-Integrated Bimodal Sensor Enabling Non-Contact and
   Tactile Perception for Intelligent Robots},
Journal = {ADVANCED SCIENCE},
Year = {2026},
Volume = {13},
Number = {47},
Month = {AUG},
Abstract = {The rapid advancement of embodied intelligent robots demands accurate
   perception and integration of diverse environmental cues. However,
   current multimodal sensing systems are hindered by complex architectures
   and heterogeneous integration, which compromise rapid fabrication,
   seamless deployment, robustness, and multi-source signal perception.
   Here, we address this challenge through an elegant substrate-folding
   design strategy that enables bimodal sensing within a single monolithic
   laser-induced graphene (LIG) film, drastically simplifying device
   architecture and fabrication while paving the way for scalable,
   robot-ready multimodal perception modules. The folded bimodal sensor
   (F-BS), which features a one-step fabrication and assembly process,
   enables real-time detection of both non-contact proximity signals and
   contact tactile signals with mode differentiation by leveraging the
   triboelectric nanogenerator (TENG) effect and the piezoresistive
   property of graphene. After fluorination, it exhibits a non-contact
   sensing distance of 110 mm, a maximum pressure sensitivity of 11.2
   kPa-1, and a response time of 10 ms. The integration of
   proximity-tactile information enables an intelligent robotic system
   capable of accurately characterizing objects based on their physical
   properties, such as orientation, material, and hardness, with a
   recognition accuracy of up to 99\% regardless of ambient lighting. This
   work provides a hardware foundation and expanded possibilities for
   human-robot interface systems with intelligent interaction capabilities.},
Publisher = {WILEY-V C H VERLAG GMBH},
Address = {POSTFACH 101161, 69451 WEINHEIM, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Ding, XL; Luo, SD (Corresponding Author), Beihang Univ, Sch Mech Engn \& Automation, Beijing, Peoples R China.
   Yang, Weixiong; Guo, Yuhan; Han, Mingguang; Feng, Bin; Wang, Dan; Hao, Pingping; Ding, Xilun; Luo, Sida, Beihang Univ, Sch Mech Engn \& Automation, Beijing, Peoples R China.
   Ma, Yuan, Hong Kong Polytech Univ, Dept Mech Engn, Hong Kong, Peoples R China.
   Xu, Bingang, Hong Kong Polytech Univ, Nanotechnol Ctr, Sch Fash \& Text, Hong Kong, Peoples R China.
   Liu, Fu, North Univ China, Sch Aerosp Engn, Taiyuan, Peoples R China.},
DOI = {10.1002/advs.75868},
