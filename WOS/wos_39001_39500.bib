@article{ WOS:001686674400001,
Author = {Cunha, Jacinto and Cabecinha, Edna and Villasante, Sebastian and Balbi,
   Stefano and Elliott, Michael and Ramos, Sandra},
Title = {Synergizing scientific and local knowledge for ecosystem services
   assessments: A case study in northern Portugal},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {3},
Pages = {633-649},
Month = {MAR},
Abstract = {Integrating scientific and local ecological knowledge on ecosystem
   services (ES) is essential for effective and inclusive environmental
   management. Such an integration strengthens societal engagement,
   supports policy implementation and helps reduce sectoral conflicts
   across marine sectors. This study explored this synergy by assessing
   stakeholder perceptions of local ES and comparing them with existing
   scientific assessments in the NW coastal area of Portugal. Stakeholders
   representing four societal sectors (Quadruple Helix framework)
   prioritized regulation and maintenance ES (RMES), identified RMES supply
   areas and pressures, and outlined a 20-year vision for the region.
   Stakeholders classified 16 of the 20 RMES as `Very Important',
   particularly erosion control, buffering mass movements, coastal
   protection, or climate regulation. Estuaries and northern coastal areas
   were identified as RMES supply hotspots. Ten major activities were
   identified, as well as conflict areas in coastal and estuarine regions,
   and some marine areas, particularly where fishing, tourism and potential
   future offshore wind farms overlapped. The stakeholder 20-year vision
   aligned with environmental policies, advocating an increase in
   ecosystem-based management (EBM) approaches and effective management of
   human activities to ensure the maintenance of natural capital.
   Comparisons between stakeholder and scientific-based maps revealed broad
   agreement in nearshore areas but discrepancies offshore. While for
   nearshore regions stakeholders were able to complement the information
   of the scientific-based maps for ES supply and pressures, less knowledge
   of offshore regions was observed from the stakeholders. This study
   highlighted the value of integrating scientific and local stakeholder
   knowledge to support informed decision-making, filling knowledge gaps
   and establishing stakeholder priorities for ecosystem management in
   marine regions that can support more complete, equitable and effective
   marine planning.Read the free for this article on the Journal blog.
   A integra \& ccedil;\& atilde;o do conhecimento cient \& iacute;fico e
   do conhecimento ecol \& oacute;gico local sobre os servi \& ccedil;os
   dos ecossistemas \& eacute; essencial para uma gest \& atilde;o
   ambiental eficaz e inclusiva. Esta integra \& ccedil;\& atilde;o refor
   \& ccedil;a o envolvimento da sociedade, apoia a implementa \& ccedil;\&
   atilde;o de pol \& iacute;ticas e contribui para a redu \& ccedil;\&
   atilde;o de conflitos setoriais entre os diferentes usos e atividades
   marinhas. Este estudo explorou essa sinergia ao avaliar as perce \&
   ccedil;\& otilde;es dos stakeholders sobre os servi \& ccedil;os de
   ecossistema e ao compar \& aacute;-las com avalia \& ccedil;\& otilde;es
   cient \& iacute;ficas existentes na \& aacute;rea costeira do Noroeste
   de Portugal. Stakeholders representativos de quatro setores da sociedade
   (modelo da H \& eacute;lice Qu \& aacute;drupla) priorizaram servi \&
   ccedil;os de ecossistemas de regula \& ccedil;\& atilde;o e manuten \&
   ccedil;\& atilde;o (RMES), identificaram \& aacute;reas de fornecimento
   de RMES, press \& otilde;es associadas e delinearam uma vis \& atilde;o
   a 20 anos para a regi \& atilde;o. Os stakeholders classificaram 16 dos
   20 RMES como << Muito Importantes >>, destacando-se o controlo da eros
   \& atilde;o, a atenua \& ccedil;\& atilde;o de movimentos de massa, a
   prote \& ccedil;\& atilde;o costeira e a regula \& ccedil;\& atilde;o
   clim \& aacute;tica. Os estu \& aacute;rios e as zonas costeiras do
   norte foram identificados como hotspots de fornecimento de RMES. Foram
   identificadas dez press \& otilde;es principais, bem como \& aacute;reas
   de conflito em regi \& otilde;es costeiras e estuarinas e em algumas \&
   aacute;reas marinhas, sobretudo onde se sobrep \& otilde;em a pesca, o
   turismo e potenciais futuros parques e \& oacute;licos offshore. A vis
   \& atilde;o a 20 anos apresentada pelos stakeholders mostrou-se alinhada
   com as pol \& iacute;ticas ambientais, defendendo o refor \& ccedil;o de
   abordagens de gest \& atilde;o baseada nos ecossistemas (EBM) e uma gest
   \& atilde;o eficaz das atividades humanas, de modo a assegurar a manuten
   \& ccedil;\& atilde;o do capital natural. As compara \& ccedil;\&
   otilde;es entre os mapas produzidos pelos stakeholders e avalia \&
   ccedil;\& otilde;es cient \& iacute;ficas revelaram uma concord \&
   acirc;ncia generalizada nas zonas costeiras pr \& oacute;ximas, mas
   discrep \& acirc;ncias em \& aacute;reas offshore. Enquanto nas regi \&
   otilde;es costeiras, os stakeholders conseguiram complementar a informa
   \& ccedil;\& atilde;o dos mapas cient \& iacute;ficos de fornecimento de
   ES e press \& otilde;es, observou-se um menor conhecimento das \&
   aacute;reas offshore por parte dos participantes. Este estudo evidenciou
   o valor da integra \& ccedil;\& atilde;o do conhecimento cient \&
   iacute;fico e do conhecimento local dos stakeholders para apoiar
   processos de tomada de decis \& atilde;o informados, colmatar lacunas de
   conhecimento e estabelecer prioridades para a gest \& atilde;o dos
   ecossistemas em regi \& otilde;es marinhas, contribuindo para um
   planeamento marinho mais completo, equitativo e eficaz.},
