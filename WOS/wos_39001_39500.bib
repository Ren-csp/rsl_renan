Author = {Jiang, Jing and Zheng, Lifen and Lu, Chunming},
Title = {A hierarchical model for interpersonal verbal communication},
Journal = {SOCIAL COGNITIVE AND AFFECTIVE NEUROSCIENCE},
Year = {2021},
