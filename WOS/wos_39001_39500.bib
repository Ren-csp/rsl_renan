@article{ WOS:000408861800178,
Author = {von Haartman, Robin and Sammalisto, Kaisu and Lozano, Rodrigo and
   Blomqvist, Per},
Title = {A Longitudinal Comparison of Sustainability Learning between Men and
   Women in Engineering and Nursing Programmes},
Journal = {SUSTAINABILITY},
Year = {2017},
Volume = {9},
Number = {8},
Month = {AUG},
Abstract = {For many years, Higher education institutions have been engaging with
   sustainability, many focussing on environmental ones. In this context,
   two phenomena have arisen that have, usually, been studied separately:
   (1) engineering schools have been at the forefront of sustainability
   efforts; and (2) women have tended to be more concerned about of
   environmental sustainability than men are. This paper is aimed at
   analysing the differences in perception between engineering students and
   nursing students at the University of Gavle, Sweden. Engineering and
   nursing programmes are practice-oriented with different foci on
   sustainability and usually being dominated by male and female students,
   respectively. The data for this article were based on two surveys
   carried out during 2010 and 2013, in which the same students answered
   the same questions at the beginning and at the end of their studies.
   Principal component analysis and regressions were carried out to analyse
   the survey answers. The results show that engineering programmes and
   gender affect actions positively. The results also show that engineering
   students increased their sustainability performance significantly more
   than nursing students. To improve environmental sustainability, it is
   important to promote the presence of women in engineering schools, and
   at the same time, social science oriented programmes (such as nursing)
   could learn from the efforts and action taken by engineering schools, so
   that sustainability is taught and learnt in a more holistic way.},
