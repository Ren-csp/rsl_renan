@article{ WOS:000756497100001,
Author = {Ricoy, Maria-Carmen and Sanchez-Martinez, Cristina},
Title = {Raising Ecological Awareness and Digital Literacy in Primary School
   Children through Gamification},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {3},
Month = {FEB},
Abstract = {Environmental education, at least in northwest Spain, is often
   overlooked in the education system from infant schooling onwards and
   interventions are needed to raise the profile of this subject. The aim
   of this study was to examine the impact of a learning program designed
   for primary school students to broaden their ecological awareness and
   improve digital literacy using gamification tools. The research was
   developed using a qualitative approach, with data obtained from 156
   subjects, including teachers, students and families. The results show
   that the children assimilated new habits on the better usage of water
   and electricity and recycling paper and plastic. Moreover, they acquired
   more efficient strategies for finding information online, by using apps
   and developing content with digital tools. Gaming dynamics and resources
   were the key to students' learning, with the tablet proving an essential
   tool for boosting motivation, interaction and problem solving.},
