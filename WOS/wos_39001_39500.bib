@article{ WOS:000936543500004,
Author = {Swacha, Piotr and Karaczun, Zbigniew M. and Murawska, Daria},
Title = {THE EUROPEANIZATION OF POLISH CLIMATE POLICY},
Journal = {EKONOMIA I SRODOWISKO-ECONOMICS AND ENVIRONMENT},
Year = {2022},
Volume = {83},
Number = {4},
Pages = {62-75},
Abstract = {The goal of the work was to analyse the positions of the selected Polish
   political parties about the European Union climate policy and to assess
   whether and to what extent the process of Europeanization is taking
   place in Poland. Climate change negatively influences economic growth:
   it affects food security and limits industrial output and economic
   development. It reduces labour pro-ductivity and influences
   international trade. The scope of this impact will depend on political
   decisions and the effectiveness of climate protection measures taken by
   individual governments. The negative attitude of political parties to
   climate policy may make it challenging to undertake the necessary
   adap-tation and mitigation measures, even despite changes in social
   perception in this regard.},
Publisher = {FUNDACJA EKONOMISTOW SRODOWISKA \& ZASOBOW NATURALNYCH},
