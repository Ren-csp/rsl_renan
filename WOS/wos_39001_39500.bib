@article{ WOS:000256023700048,
Author = {Schreiner, Patrick and Chen, Xiang and Husnjak, Koraljka and Randles,
   Leah and Zhang, Naixia and Elsasser, Suzanne and Finley, Daniel and
   Dikic, Ivan and Walters, Kylie J. and Groll, Michael},
Title = {Ubiquitin docking at the proteasome through a novel pleckstrin-homology
   domain interaction},
