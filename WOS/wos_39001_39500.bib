@article{ WOS:001539746000002,
Author = {Charkazi, Abdurrahman and Cheperli, Abdurraouf and Zarghami, Fatemeh and
   Shahryari, Ali and Rajabi, Abdolhalim},
Title = {Perceived risk of cardiovascular disease among Hookah users in Iran},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2025},
Volume = {22},
Number = {1},
Month = {JUL 29},
Abstract = {BackgroundHookah consumption is associated with severe health
   complications and an elevated risk of developing cardiovascular
   diseases. Paradoxically, research has indicated that hookah users often
   underestimate the true dangers and health complications associated with
   its consumption. After conducting a comprehensive literature review, the
   research gap was identified as the lack of research on the perceived
   risk of non-communicable diseases (including cardiovascular diseases)
   amongIranian hookah users. Therefore, this study was designed to assess
   the perceived risk of Myocardial Infarction (MI), stroke, and
   hypertension diseases among hookah users.MethodsThis cross-sectional
   study recruited 340 current and former hookah users in Golestan
   province, northern Iran, using available and network sampling methods.
   Participants completed questionnaires on their perceptions of the risks
   associated with hookah consumption. Multiple linear regression analysis
   was employed to explore the factors associated with the perceived risk
   of cardiovascular diseases among hookah users. Data analysis was carried
   out using Stata software version 16, with a significance level of less
   than 0.05.ResultsThe results revealed that the mean perceived risk of
   cardiovascular diseases among the study participants was 7.75 +/- 5.13
   out of a total score of 20. Individuals who used other forms of tobacco
   in addition to hookah (such as cigarettes and nass), those with
   intentions to quit hookah consumption in the next 6 months, and also
   those with a more negative attitude towards hookah exhibited a
   significantly higher perceived risk of cardiovascular
   diseases.Unemployed people had the lowest risk perception than other job
   groups.ConclusionThe perceived risk of cardiovascular diseases among the
   study participants was generally low. Moreover, the perceived risk was
   lower among individuals who solely used hookah, those with a positive
   attitude towards hookah, and thosewith no plans to quit hookah usesoon.
   Therefore, public health interventionsshould be designed targeting these
   groups to increase their awareness of the associated risks of hookah
   use. Further interventions could be developed to assist these groups in
   quitting hookah consumption.},
