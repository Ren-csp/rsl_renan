@article{ WOS:001825935800001,
Author = {Gallant, Karen and Lauckner, Heidi and Stevens, Ashlyn and Bhatnagar,
   Brittany and Hutchinson, Susan and Wojciechowski, Jacqueline and Mason,
   Stephanie and Alexander Moran, R.},
Title = {Making meaning of the smallest units of leisure: a phenomenological
   exploration of everyday moments of leisure},
Journal = {LEISURE STUDIES},
Year = {2026},
Month = {2026 JUL 22},
Abstract = {Building on earlier work conceptualising everyday moments of leisure
   (EML) as momentary forms of leisure experienced amidst ordinary spaces
   and activities, this phenomenological research sought to understand how
   momentary leisure experiences come to occur in people's lives, the
   characteristics of such experiences and the meanings attributed to them.
   Data collection involved interviews with 20 individuals who engaged in
   up to three interviews about their experiences of EML, including
   discussion of their documented examples of EML and participation in
   on-site go-along interviews. We analysed the data collaboratively using
   interpretive phenomenological analysis. Two themes with subthemes
   describe the data. The first theme is EML are enjoyable brief
   experiences, with subthemes of (1) sensory/embodied experiences, (2)
   meaning-making, (3) shift in perspective and (4) personal beliefs and
   awareness of EML. The second theme is EML are noticed in context.
   Overall, findings suggest that EML are often intentionally cultivated
   and present meaningful opportunities for enjoyable moments that provide
   welcome contrast and reprieve from daily obligations and pressures.
   Complementing the current focus on the benefits of momentary engagement
   with nature or beauty, drawing attention to EML opens the possibility of
   increasing wellbeing through momentary engagement across a whole
   spectrum of activities subjectively experienced as leisure.},
