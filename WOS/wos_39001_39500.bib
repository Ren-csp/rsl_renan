@article{ WOS:001827652900002,
Author = {Biro, Anna and Chauveau, Claire A. and Collard, Olivier and Delic, Teo
   and Flot, Jean-Francois and Haidau, Catalina and Herczeg, Gabor and
   Iepure, Sanda and Kos, Anja and Lunghi, Enrico and Moldovan, Oana
   Teodora and Sambor, Orest and Weigand, Alexander and Zaksek, Valerija
   and Balazs, Gergely and Zagmajster, Maja},
Title = {Exploring stakeholders' apprehensions and perceptions of subterranean
   biodiversity monitoring in Europe},
Journal = {BIODIVERSITY AND CONSERVATION},
Year = {2026},
Volume = {35},
Number = {9},
Month = {JUL 23},
Abstract = {In an era of biodiversity crisis, monitoring habitats and species is
   essential to track their changes, understand conservation priorities,
   and guide management decisions. In the European Union, the Habitats
   Directive mandates the monitoring of different habitat types. However,
   the quality and frequency of monitoring and conservation efforts vary
   across habitats. One neglected habitat group is subterranean habitats
   including caves. Using a questionnaire distributed across all relevant
   stakeholder groups, complemented by experts' opinions, we aimed to (i)
   identify the current status and future vision of subterranean habitat
   monitoring, and (ii) understand general knowledge of, and the
   possibilities and impediments to develop a standardised protocol. We
   received 78 responses from all targeted stakeholder groups. The results
   revealed that, generally, there is a good level of understanding of the
   Habitats Directive's obligations and of the general concepts of
   biodiversity monitoring, while knowledge on
   subterranean-habitat-specific topics is substantially lower. The answers
   also revealed considerable differences in institutional background and
   used methodology across countries and, at times, within countries. Our
   research highlights the importance of educating stakeholders and creates
   a roadmap for the priorities and pitfalls in developing a standardised
   protocol that can be adjusted to meet specific needs and country
   specific administrative and management structure.},
