@article{ WOS:001840667900001,
Author = {Morakinyo, Tobi Eniolu and Fatunmbi, Iyanuoluwa and Mngumi, Lazaro
   Eliyah and Mbuya, Elinorata and Pilla, Francesco and Obe, Oluwafemi
   Benjamin and Bassey, David and Baruti, Modest},
Title = {Indoor-outdoor heat stress, housing characteristics, and health outcomes
   in an informal settlement: a mixed-methods study from Dar es Salaam,
   Tanzania},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {Informal settlement residents in the Global South are often at high risk
   of extreme heat, not only because of elevated exposure but also due to
   their low adaptive capacity and socio-environmental vulnerability,
   including substandard housing and limited access to cooling. However,
   measured evidence on how indoor-outdoor heat exposure, housing
   conditions, thermal perception, and self-reported health outcomes are
   related remains limited. This study examined these relationships in an
   informal settlement in Dar es Salaam, Tanzania, using a mixedmethods
   approach that combined indoor and outdoor microclimate monitoring,
   household surveys, housing characterization, and regression analysis.
   Outdoor daytime temperatures frequently exceeded 35 degrees C, with Heat
   Index values often reaching ``danger{''} levels; 70\% of monitored days
   included conditions within the ``danger{''} category. Nighttime heat
   exposure also remained elevated, particularly in February and March. At
   the community level, survey responses provided contextual support for
   the monitored indoor heat patterns, although the survey responses and
   Heat Index observations were not spatially or temporally paired. Over
   75\% and 65\% of respondents reported feeling ``hot{''} indoors during
   the day and at night, respectively, and nearly all described these
   conditions as ``uncomfortable{''} or ``very uncomfortable.{''} Indoor
   Heat Index values frequently exceeded outdoor values at night across
   monitored housing typologies, suggesting limited nighttime thermal
   relief inside dwellings. Descriptive patterns indicated that indoor heat
   exposure varied across housing and microenvironmental features such as
   window size, roof colour, ceiling presence, and nearby vegetation;
   however, adjusted models did not identify statistically significant
   housing predictors of indoor Heat Index. Similarly, adjusted logistic
   regression models did not provide consistent evidence that physical
   housing characteristics independently predicted heat-related symptoms.
   Overall, the findings provide local evidence to inform heathealth
   monitoring, settlement-scale adaptation planning, and future
   intervention studies.},
