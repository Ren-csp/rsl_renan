@article{ WOS:000609729100001,
Author = {Nash, Sue P. and Sevareid, Eric E. and Longmore, Monica A. and Manning,
   Wendy D. and Giordano, Peggy C.},
Title = {The Stress of Motherhood and Intimate Partner Violence During Emerging
   Adulthood},
Journal = {EMERGING ADULTHOOD},
Year = {2022},
Volume = {10},
Number = {5},
Pages = {1204-1215},
Month = {OCT},
Abstract = {Intimate partner violence is a serious social and public health problem
   for women. Researchers have shown the context in which intimate partner
   violence occurs matters, yet, prior work has not examined specifically
   whether motherhood, and the relationship context of motherhood, are
   associated with physical violence. Drawing on the Toledo Adolescent
   Relationships Study (TARS) (n = 492), and the stress process framework,
   we compared emerging adult mothers' (mothers with one child and mothers
   with multiple children) and non-mothers' reports of physical violence.
   Using negative binomial regression models, we found that mothers with
   multiple children compared with nonmothers reported more instances of
   relationship violence. We also found women in dating relationships with
   one child compared to non-mothers reported substantially more physical
   violence. These findings underscore the nature of stress and motherhood
   during emerging adulthood and the need for intervention strategies that
   target new mothers.},
