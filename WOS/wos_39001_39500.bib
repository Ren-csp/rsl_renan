Author = {Tybjerg, Jonas Kackus and Wendt-Lucas, Nicola and Lundberg, Tove and
   Cavicchia, Rebecca and Salonen, Hilma and Brynteson, Maja and
   Gisladottir, Saeunn and Johannesson, Hjalti and Lofving, Linnea},
Title = {Piloting Nordic connectivity: Examining perspectives on the potential of
   electric aviation to enhance accessibility and socio-economic
   development in Nordic remote rural regions},
Journal = {JOURNAL OF RURAL STUDIES},
Year = {2026},
Volume = {127},
Month = {SEP},
Abstract = {Lack of accessibility is both a defining characteristic and a key
   obstacle for the development of remote rural areas. In the Nordic
   context, challenging travel conditions have reinforced the need for new,
   sustainable transport solutions. This article explores the perceived
   potential of electric aviation as an environmentally low-impact and
   innovative way to improve accessibility and thereby strengthen the
   socio-economic development of remote regions. The study applies an
   analytical framework on accessibility components to explore how electric
   aviation could strengthen remote rural areas in the Nordic countries.
   The study adopts a qualitative approach exploring five case studies,
   selected through a pre-study to identify which routes in the Nordic
   region would benefit the most from the introduction of electric
   aviation. These case studies draw on focus group discussions with local
   stakeholders and aviation experts from Denmark, Finland, Iceland,
   Norway, and Sweden. The study offers an analytical contribution by
   suggesting an additional dimension to Geurs and van Wee's accessibility
   component model highlighting the importance of energy infrastructure to
   better understand and support the green shift in the transport sector.
   Stakeholders perceived electric aviation as a possible contributor to
   regional development, but only under restrictive conditions relating to
   affordability, service frequency, integration with local transport,
   public trust, and energy infrastructure. The study highlights both the
   promises and challenges of electric aviation and its perceived potential
   impact on regional development trajectories in sectors including tourism
   and healthcare as well as the design of sustainable and
   context-sensitive transport policies.},
