Title = {Research-based learning (RBL): Added-value in tourism education},
Journal = {JOURNAL OF HOSPITALITY LEISURE SPORT \& TOURISM EDUCATION},
Year = {2021},
Volume = {28},
Month = {JUN},
Abstract = {The purpose of this research was to explore perceptions of the
   research-based learning (RBL) approach as an added value in tourism
   education. This research used a qualitative approach with an exploratory
   scope through three focus groups of eight tourism students who are part
   of the project: ``Fostering a platform for research-based education to
   support sustainable development through Tourism in the Cajas Massif
   Biosphere Area (CMBA){''}, in Southern Ecuador. The study shows that a
   research-based learning approach can be more successful than traditional
   approaches to link theory and practice, using real study cases and
   problems in the territory.},
