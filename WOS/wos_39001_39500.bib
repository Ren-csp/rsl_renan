@article{ WOS:000302750000003,
Author = {Goldstone, Heather M. H. and Tokunaga, Saimi and Schlezinger, Jennifer
   J. and Goldstone, Jared V. and Stegeman, John J.},
Title = {EZR1: A Novel Family of Highly Expressed Retroelements Induced by TCDD
   and Regulated by a NF-κB-Like Factor in Embryos of Zebrafish (Danio
   rerio)},
Journal = {ZEBRAFISH},
Year = {2012},
Volume = {9},
Number = {1},
Pages = {15-25},
Month = {MAR},
Abstract = {Transcript profiling using a zebrafish heart cDNA library previously
   revealed abundant expressed sequence tags (ESTs) upregulated in
   zebrafish embryos treated with the aryl hydrocarbon receptor(AHR)
   agonist 2,3,7,8-tetrachlorodibenzo-p-dioxin (TCDD). Here, we identify
   those ESTs as LTR-containing retroelements termed EZR1
   (Expressed-Zebrafish-Retroelement group 1). EZR1 is highly redundant in
   the genome and includes canonical long terminal repeats (LTRs) flanking
   an integrase-like open reading frame and a region similar to retroviral
   envelope protein genes. EZR1 sequences lack reverse transcriptase, RNase
   H, or protease, indicating retrotransposition would be nonautonomous. No
   AHR binding motifs were found in the EZR1 promoter region. A putative
   NF-kappa B-binding site was found, and TCDD-treated zebrafish embryos
   had significantly increased levels of nuclear protein(s) binding to this
   sequence. Protein EZR1 DNA complex formation was partially competed by a
   mammalian consensus kappa B sequence, consistent with NF-kappa B-like
   activation contributing to increased protein binding to this site.
   Mobility of the TCDD-induced protein-EZR1 complex differed from that of
   authentic NF-kappa B protein bound to the consensus kappa B site. The
   results suggest that EZR1 is regulated by interaction with NF-kappa B or
   NF-kappa B protein(s) different from the NF-kappa B protein binding to
   the consensus kappa B site. The nature of the NF-kappa B-like protein
   and the relationship between EZR1 induction and cardiovascular toxicity
   caused by TCDD warrant further investigation.},
