@article{ WOS:000075562300007,
Author = {Dienes, Z and Fahey, R},
Title = {The role of implicit memory in controlling a dynamic system},
Journal = {QUARTERLY JOURNAL OF EXPERIMENTAL PSYCHOLOGY SECTION A-HUMAN
   EXPERIMENTAL PSYCHOLOGY},
Year = {1998},
Volume = {51},
Number = {3},
Pages = {593-614},
Month = {AUG},
Abstract = {The relationship between implicit memory and implicit learning is
   explored. Dienes and Fahey (1995) showed that learning to control a
   dynamic system was mediated by a look-up table consisting of previously
   successful responses to specific situations. The experiment reported in
   this paper showed that facilitated performance on old situations was
   independent of the subjects' ability to recognize those situations as
   old, suggesting that memory was implicit. Further analyses of the Dienes
   and Fahey data replicated this independence of control performance on
   recognition. However, unlike the implicit memory revealed on fragment
   completion tasks, successful performance on the dynamic control tasks
   was remarkably resilient to modality shifts. The results are discussed
   in terms of models of implicit learning and the nature of implicit
   memory.},
Publisher = {PSYCHOLOGY PRESS},
