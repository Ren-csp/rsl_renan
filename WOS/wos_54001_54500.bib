@article{ WOS:000401797800056,
Author = {Mizuguchi, Takeshi and Taneja, Nitika and Matsuda, Emiko and Belton,
   Jon-Matthew and FitzGerald, Peter and Dekker, Job and Grewal, Shiv I. S.},
Title = {Shelterin components mediate genome reorganization in response to
   replication stress},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2017},
