@article{ WOS:000433889400003,
Author = {Elsharkawy, Sherif and Al-Jawad, Maisoon and Pantano, Maria F. and
   Tejeda-Montes, Esther and Mehta, Khushbu and Jamal, Hasan and Agarwal,
   Shweta and Shuturminska, Kseniya and Rice, Alistair and Tarakina, V,
   Nadezda and Wilson, Rory M. and Bushby, Andy J. and Alonso, Matilde and
   Rodriguez-Cabello, Jose C. and Barbieft, Ettore and Hernandez, Armando
   del Rio and Stevens, Molly M. and Pugno, Nicola M. and Anderson, Paul
   and Mata, Alvaro},
Title = {Protein disorder-order interplay to guide the growth of hierarchical
   mineralized structures},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {JUN 1},
Abstract = {A major goal in materials science is to develop bioinspired functional
   materials based on the precise control of molecular building blocks
   across length scales. Here we report a protein-mediated mineralization
   process that takes advantage of disorder-order interplay using
   elastin-like recombinamers to program organic-inorganic interactions
   into hierarchically ordered mineralized structures. The materials
   comprise elongated apatite nanocrystals that are aligned and organized
   into microscopic prisms, which grow together into spherulite-like
   structures hundreds of micrometers in diameter that come together to
   fill macroscopic areas. The structures can be grown over large uneven
   surfaces and native tissues as acid-resistant membranes or coatings with
   tuneable hierarchy, stiffness, and hardness. Our study represents a
   potential strategy for complex materials design that may open
   opportunities for hard tissue repair and provide insights into the role
   of molecular disorder in human physiology and pathology.},
