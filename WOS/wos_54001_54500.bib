@article{ WOS:001455352500012,
Author = {Windisch, Michael G. and Humpenoeder, Florian and Merfort, Leon and
   Bauer, Nico and Luderer, Gunnar and Dietrich, Jan Philipp and Heinke,
   Jens and Mueller, Christoph and Abrahao, Gabriel and Lotze-Campen,
   Hermann and Popp, Alexander},
Title = {Hedging our bet on forest permanence for the economic viability of
   climate targets},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {MAR 27},
Abstract = {Achieving the Paris Agreement's CO2 emission reduction goals heavily
   relies on enhancing carbon storage and sequestration in forests
   globally. Yet, the increasing vulnerability of carbon stored in forests
   to both climate change and human intervention is often neglected in
   current mitigation strategies. Our study explores modelled interactions
   between key emission sectors, indicating that accelerated
   decarbonization could meet climate objectives despite forest carbon
   losses due to disturbances. However, delaying action on forest carbon
   loss by just five years consistently doubles the additional mitigation
   costs and efforts across key sectors, regardless of the assessed forest
   disturbance rates. Moreover, these myopic responses to forest carbon
   loss are as stringent, or even more demanding, than immediate responses
   to twice the forest disturbance rate. Our results underline the urgent
   need to monitor and safeguard forests for the economic feasibility of
   the Paris Agreement's climate goals.},
