@article{ WOS:001807756800009,
Author = {Trifu, Aura and Lozano Estivalis, Maria},
Title = {BETWEEN SUSTAINABILITY AND CARE: EDUCATION FOR SUSTAINABLE CONSUMPTION},
Journal = {TEORIA DE LA EDUCACION},
Year = {2026},
Volume = {38},
Number = {2},
Pages = {173-192},
Month = {JUL-DEC},
Abstract = {The enormous challenges posed by democratic regression, social
   polarisation and climate change in our educational environments make it
   necessary to collectively transform pedagogical practices based on
   parameters of justice, equity and sustainability. We propose an ethical,
   philosophical and pedagogical reflection on the evolution of this latter
   concept, from expansionist and reductive mechanistic models to holistic
   and integrative perspectives. Drawing on Aarne Ness's deep ecology and
   Stephen Sterling's thinking on complete systems, we focus on the
   regenerative approach to sustain-ability and criticisms of the reactive
   approach that predominates in public discourse. Education for
   sustainable consumption, situated at the nexus between education for
   peace and education for sustainable development, is presented as a
   fundamental axis for discussion on these issues. The challenge of
   sustainable consumption is to reduce direct, structural and cultural
   violence related to consumption, and to foster peaceful relationships
   that respect the authentic needs and fundamental rights of human beings
   and Nature. The imperative of inclusive and equitable education for
   social justice requires incorporating critical training for a global
   citizenship that is aware of the impact of consumption on the present
   and future of humanity and the planet. This involves creating democratic
   spaces for situated learning, linked to their environment and aligned
   with an ecological educational model that focuses on care, shared
   responsibility and awareness of interdependence.},
