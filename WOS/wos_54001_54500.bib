@article{ WOS:000448109000009,
Author = {Bieler, Malte and Xu, Xiaxia and Marquardt, Annette and Hanganu-Opatz,
   Ileana L.},
Title = {Multisensory integration in rodent tactile but not visual thalamus},
Journal = {SCIENTIFIC REPORTS},
Year = {2018},
Volume = {8},
Month = {OCT 24},
Abstract = {Behavioural performance requires a coherent perception of environmental
   features that address multiple senses. These diverse sensory inputs are
   integrated in primary sensory cortices, yet it is still largely unknown
   whether their convergence occurs even earlier along the sensory tract.
   Here we investigate the role of putatively modality-specific first-order
   (FO) thalamic nuclei (ventral posteromedial nucleus (VPM), dorsal
   lateral geniculate nucleus (dLGN)) and their interactions with primary
   sensory cortices (S1, V1) for multisensory integration in pigmented rats
   in vivo. We show that bimodal stimulation (i.e. simultaneous light flash
   and whisker deflection) enhances sensory evoked activity in VPM, but not
   dLGN. Moreover, cross-modal stimuli reset the phase of thalamic network
   oscillations and strengthen the coupling efficiency between VPM and S1,
   but not between dLGN and V1. Finally, the information flow from VPM to
   S1 is enhanced. Thus, FO tactile, but not visual, thalamus processes and
   relays sensory inputs from multiple senses, revealing a functional
   difference between sensory thalamic nuclei during multisensory
   integration.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Bieler, M; Hanganu-Opatz, IL (Corresponding Author), Univ Med Ctr Hamburg Eppendorf, Inst Neuroanat, Dev Neurophysiol, D-20251 Hamburg, Germany.
   Bieler, M (Corresponding Author), Univ Oslo, Dept Physiol, Lab Neural Computat, N-0372 Oslo, Norway.
   Bieler, Malte; Xu, Xiaxia; Marquardt, Annette; Hanganu-Opatz, Ileana L., Univ Med Ctr Hamburg Eppendorf, Inst Neuroanat, Dev Neurophysiol, D-20251 Hamburg, Germany.
   Bieler, Malte, Univ Oslo, Dept Physiol, Lab Neural Computat, N-0372 Oslo, Norway.},
