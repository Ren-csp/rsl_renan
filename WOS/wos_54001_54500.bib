@article{ WOS:001459626500001,
Author = {Annala, Mari J. and Lehtoranta, Virpi and Hilli, Anu and Hokajarvi,
   Raili and Kuoppala, Minna and Mykra, Heikki and Piirainen, Sirpa},
Title = {Family forest owner's perspectives on headwater streams in boreal
   forests: Motivations, values, and conservation actions},
Journal = {AMBIO},
Year = {2025},
Volume = {54},
Number = {9},
Pages = {1514-1529},
Month = {SEP},
Abstract = {Boreal headwater streams are vital for forest biodiversity and larger
   water bodies but face challenges from forest management. Understanding
   forest owner's views is key for effective water management. Our research
   surveys family forest owners to explore: (1) their perception of stream
   value, (2) factors driving their willingness to protect streams, and (3)
   if motivations for forest ownership vary by residence. Most owners are
   motivated by recreation. Those living far from their forests prioritize
   landscape, heritage, and biodiversity more than nearby residents. While
   owners recognize the importance of biodiversity and water protection,
   this does not always influence their management choices. Owners who are
   familiar with the link between forest management and stream health are
   more willing to protect streams from logging impacts. These findings
   highlight the need for better advice and policies for forest owners on
   managing water quality and biodiversity.},
