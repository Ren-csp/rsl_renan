Language = {English},
Affiliation = {Ryu, CM (Corresponding Author), KRIBB, Infect Dis Res Ctr, Mol Phytobacteriol Lab, Daejeon 34141, South Korea.
   Sharifi, Rouhallah, Razi Univ, Dept Plant Protect, Coll Agr \& Nat Resources, Kermanshah, Iran.
   Ryu, Choong-Min, KRIBB, Infect Dis Res Ctr, Mol Phytobacteriol Lab, Daejeon 34141, South Korea.
