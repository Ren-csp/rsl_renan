@article{ WOS:000708801100013,
Author = {Peters, Benjamin and Kaiser, Jochen and Rahm, Benjamin and Bledowski,
   Christoph},
Title = {Object-Based Attention Prioritizes Working Memory Contents at a Theta
   Rhythm},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-GENERAL},
