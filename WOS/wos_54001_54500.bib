@article{ WOS:000763700400001,
Author = {Maturkanic, Patrik and Cergetova, Ivana Tomanova and Kralik, Roman and
   Hlad, Lubomr and Roubalova, Marie and Martin, Jose Garcia and Judak,
   Viliam and Akimjak, Amantius and Petrikovicova, Lucia},
Title = {The Phenomenon of Social and Pastoral Service in Eastern Slovakia and
   Northwestern Czech Republic during the COVID-19 Pandemic: Comparison of
   Two Selected Units of Former Czechoslovakia in the Context of the
   Perspective of Positive Solutions},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {4},
Month = {FEB},
Abstract = {This study seeks to explain the differences in the perception of social
   and pastoral service after the first and second wave pandemic in 2020
   among the inhabitants of two neighbouring states, both parts of the
   former unified Czechoslovakia. Our research study compares subjective
   perception, needs, and participation among inhabitants of eastern
   Slovakia and north-western Czech Republic in social and pastoral service
   during the COVID-19 pandemic. The research sample consisted of a healthy
   population from the Czech Republic (n = 496) and Slovakia (n = 484) over
   16 years of age, of which 63\% (n = 617) were women and 37\% (n = 363)
   men. The level of education ranged from primary to postgraduate. The
   research sample consisted of 623 (63.6\%) participants with religious
