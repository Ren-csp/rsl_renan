@article{ WOS:001809052100001,
Author = {Khorsand, Darya Badiei and Benstead, Amy and Stephens, Victoria and
   Dixon, Janine and Vignali, Gianpaolo and Ryding, Daniella},
Title = {Risky purchases - A study of consumers' risk perceptions of plant-based
   leather alternatives},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {571},
Month = {JUL 8},
Abstract = {Luxury fashion brands are increasingly using plant-based leather
   alternatives to reduce their environmental impact. However, consumers
   tend to perceive significant risk with unfamiliar stimuli, such as
   products made from these materials, which can negatively influence their
   purchase intentions. Hence, understanding consumers' perceived risk of
   luxury fashion products made from plant-based leather alternatives is
   key to encouraging their consumption. However, as new materials, there
   is a gap in the literature on them, which is crucial to address, given
   their projected growth. Through 24 semi-structured interviews, we
   addressed this gap and explored consumers' perceived risk of luxury
   fashion products made from plant-based leather alternatives and their
   influence on their purchase intentions. Our findings suggest that
   financial and functional risks are significant concerns, particularly
   due to the waste and plastic content of plant-based leather
   alternatives. Social and sanitary risks also play a notable role in
   influencing consumers' purchase behaviour, while perceived aesthetic
   risk was low and psychological risk was not evident. Moreover, we found
   that perceived risk influences purchase intentions differently across
   product categories. This research provides original theoretical
   contributions by extending the concept of perceived risk within
   environmentally sustainable luxury consumption and uncovering entirely
   new risk dimensions and subthemes not previously explored in literature.
   It offers practical implications for luxury fashion brands and
   plant-based leather alternative manufacturers to improve their marketing
   and product development strategies.},
