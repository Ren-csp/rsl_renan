Title = {Exploring Adolescents' Perceptions of the School Food Environment to
   Inform a Fruit-Based Program},
Journal = {JOURNAL OF NUTRITION EDUCATION AND BEHAVIOR},
Year = {2026},
Volume = {58},
Number = {8},
Pages = {785-791},
Month = {AUG},
Abstract = {Objective: To explore rural adolescents' perceptions of the school food
   environment, identify preferred fruit promotion strategies, and compare
   findings with nutrition directors' self-reported practices to inform a
   fruit-based program. Methods: Mixed-methods study using focus groups,
   student voting activity, and nutrition director-completed environmental
   checklists across 8 rural schools. Participants included adolescents
   (focus groups, n = 41; voting activity, n = 432) and nutrition directors
   (n = 8). Qualitative data were analyzed thematically. Quantitative data
   were analyzed descriptively. Results: More than half the students
   reported barriers to fruit consumption (e.g., unappetizing/limited
   options, concerns about cleanliness/freshness) despite nutrition
   directors reporting supportive fruit promotion practices. Across
   schools, a smoothie bar was the most preferred fruit promotion strategy
   (370 {[}86\%]), followed by fruit taste tests (44 {[}10\%]) and
   fruit-based murals (18 {[}4\%]). Conclusion and Implications:
   Discrepancies between student experiences and self-reported practices
   highlight the importance of incorporating student voices. Findings
   inform a student-driven, fruit-based program in rural schools.},
