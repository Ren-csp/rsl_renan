@article{ WOS:001812849200001,
Author = {Moshaver, Sam and Ozarisoy, Bertug and Behnam-Asl, Sana and Ghannad,
   Atousa},
Title = {Investigating lighting uniformity as perceptual continuity: Fear of
   crime in night-time transit-adjacent spaces},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {31},
Month = {AUG},
Abstract = {Fear of crime in poorly lit night-time transit-adjacent spaces can
   discourage public transport use and undermine the safety, inclusiveness,
   and sustainability of urban mobility systems. This study aimed to
   examine how lighting stability, expressed through illuminance level and
   spatial uniformity, influences perceived safety, uncertainty, negative
   affect, and avoidance intention, and to identify the perceptual
   mechanisms underlying these responses. A mixed-methods within-subjects
   immersive virtual-reality experiment exposed 42 adults to three
   simulated pedestrian-route conditions; stable full lighting, stable low
   lighting, and unstable alternating bright-dark lighting. Participants
   completed Likert-scale ratings and provided concurrent verbal protocols,
   which were analysed through reflexive thematic analysis informed by
   Killias's vulnerability model. Repeated-measures analysis demonstrated a
   clear graded effect across all outcomes: perceived unsafety increased
   from 2.10 under full lighting to 3.14 under low lighting and 5.38 under
   alternating lighting, while night-time avoidance increased from 2.93 to
   4.07 and 5.64, respectively. Friedman tests were significant for all
   outcomes, with large effects (Kendall's W = 0.709-0.895; all p < 0.001).
   The findings support urban lighting policies that move beyond minimum
   illuminance thresholds by prioritising continuous coverage,
   minimum-uniformity standards, durable low-energy luminaires, and
   maintenance cycles that prevent dark gaps along transit routes. The
   study contributes a stability-first framework linking perceived safety
   with sustainable urban infrastructure, energy efficiency, and reduced
   light pollution. Future research should validate these findings through
   field-based studies across diverse transit settings and assess their
   implications for maintenance performance, energy demand, and night-time
   ridership.},
