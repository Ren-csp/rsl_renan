@article{ WOS:001853105400001,
Author = {Lepeut, Alysson and Ferrara, Lindsay},
Title = {Backchannels as multimodal displays of joint understanding in signed
   language interaction: A cross-linguistic analysis of Norwegian Sign
   Language and French Belgian Sign Language conversations},
Journal = {JOURNAL OF PRAGMATICS},
Year = {2026},
Volume = {264},
Pages = {96-112},
Month = {OCT},
Abstract = {This study investigates how deaf signers from two historically unrelated
   signed languages (SLs), Norwegian Sign Language and French Belgian Sign
   Language (LSFB), signal understanding through backchannels (BCs). BCs
   are short utterances composed of spoken/ signed production (e.g., words
   such as `okay', vocal cues such as `mm mm' or signs such as YES) and/or
   other visual cues (e.g., nodding, facial expressions). Research on BCs
   in both spoken and signed interaction has revealed their ubiquitous and
   multimodal nature. The current study moves this research forward by
   conducting a study of BCs in two additional signed languages to
   accumulate evidence for cross-linguistic similarities and differences.
   ELAN was used to annotate 4,325 tokens of BCs observed in 4 h of
   face-to-face dyadic conversational data. Annotations were subjected to
   statistical analysis in R. Findings reveal that BCs across both
   languages were primarily performed nonmanually, showing limited
   variation in the range of articulators used. Head nods stood out as the
   most robust form in both SLs. However, individual variation in BC styles
   was also observed. In light of the findings, we explore the idea that
   backchanneling systems are similar across language ecologies and that
   they exemplify how interactional phenomena are the heart of human
   languaging. (c) 2026 The Author(s). Published by Elsevier B.V. This is
   an open access article under the CC BY-NC license
   (http://creativecommons.org/licenses/by-nc/4.0/).},
