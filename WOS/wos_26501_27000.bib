@article{ WOS:001518087700001,
Author = {Giubilini, A.},
Title = {It Is Not About AI, It's About Humans. Responsibility Gaps and Medical
   AI},
Journal = {JOURNAL OF BIOETHICAL INQUIRY},
Year = {2025},
Volume = {22},
Number = {3, SI},
Pages = {527-537},
Month = {SEP},
Abstract = {A lot of the language we use to refer to AI, including in healthcare,
   uses terminology that originally and literally applies to humans and
   human relationships. Such terminology includes both non-evaluative
   terms, like ``learning,{''} ``memory,{''} or ``intelligence,{''} and
   evaluative terms, like ``trust{''} or ``responsibility.{''} In this
   article I focus on the latter type and the way it is applied
   specifically to the case of medical AI. Focusing on the discussion of
   ``responsibility gaps{''} that, according to some, AI generates, I will
   suggest that such terminology is revealing of the nature of healthcare
   professional obligations and responsibility prior to and independently
   of the assessment of the use of AI tools in healthcare. The point I make
   is generalizable to AI as used and discussed more broadly: the language
   used to refer to AI often tells more about humans and human
   relationships than about AI itself and our relationship with it. In
   healthcare, whatever else AI will allow us to do, it can prompt us to
   reflect more thoroughly on professional responsibility and professional
   obligations.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
