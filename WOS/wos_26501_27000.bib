@article{ WOS:001726970900001,
Author = {Tetteh, Aaron Tettey and Yevugah, Lily Lisa and Moomen, Abdul-Wadood},
Title = {Stakeholders' perceptions of land degradation and rehabilitation efforts
   in mining communities: A case study of the Birim North mining district,
   Ghana},
Journal = {NATURE-BASED SOLUTIONS},
Year = {2026},
Volume = {9},
Month = {JUN},
Abstract = {Land degradation in Ghana's mining communities threatens agricultural
   productivity, ecosystem services, and livelihoods. This study examines
   stakeholder perceptions of land degradation and rehabilitation efforts
   in the Birim North District, a hotspot for artisanal and small-scale
   mining (ASM) and large-scale gold mining. A questionnaire survey was
   conducted with 100 randomly selected respondents from twelve
   communities, representing diverse occupations and at least five years of
   local residence to assess the perceived causes, effectiveness of
   rehabilitation efforts, barriers, and potential measures to achieve Land
   Degradation Neutrality (LDN). Statistical analysis using a three-way
   Analysis of Variance (ANOVA) showed uniform perceptions of land
   degradation across demographic groups, suggesting that the problem is
   widely recognized within the community. Findings reveal that mining,
   particularly ASM, is widely viewed as the dominant cause of land
   degradation. This has led to deforestation, water pollution, and reduced
   agricultural yields. Although rehabilitation laws exist in principle,
   their implementation is weak, with most efforts limited to partial pit
   refilling or natural regeneration. These findings were validated through
   field surveys, which revealed extensive land degradation at ASM sites,
   with natural regeneration being the only observed form of
   rehabilitation. Major hindrances include corruption, weak enforcement of
   environmental laws, and limited technical expertise. However,
   stakeholders expressed strong willingness to participate in training,
   public sensitization, and collaborative rehabilitation The study points
   to the importance of participatory assessment of rehabilitation measures
   in achieving Ghana's LDN targets.},
