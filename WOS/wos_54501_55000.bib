@article{ WOS:001537361300001,
Author = {Bernardino, Ricardo and Baptista, Patricia and Neves, Diana},
Title = {Unveiling cross-sector energy demand dynamics in Portugal: a
   municipal-level machine learning approach},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {130},
Month = {JUL 15},
Abstract = {In the context of increasing global awareness regarding sustainable
   development, there is a growing need to understand and optimize energy
   demand trends at regional scales across different sectors. This work
   investigates cross-sector energy demand dynamics at the municipal level,
   focusing on revealing the relation between social, economic, energy,
   mobility, and emissions indicators using machine learning techniques.
   The methodology is divided into two stages: data analysis of historical
   data and developing a predictive model. The analysis is designed for the
   case study of Portugal. For the data analysis, a cluster analysis of the
   municipalities was performed using seven indicators from various sectors
   employing two methods, K-means and Gaussian Mixture Model. Then, a
   predictive modelling analysis for the identified clusters, regarding
   Primary Energy CO2 Emissions and Final Energy Demand, was implemented,
   using two different methods: Multiple Linear Regression and Artificial
   Neural Networks. The clustering results highlighted five distinct
   socio-economic and sustainability municipalities' profiles, ranging from
   urban centers with high domestic energy intensity, rural areas with low
   active population, high industrial municipalities with substantial
   economic activity and insular regions with high CO2 emission factors.
   Regarding the predictive modelling, using Final Energy Demand presented
   better results, showing lower error rates and higher correlation values,
   particularly in urbanized and balanced regions, in contrast with
   municipalities with high industrial or insular characteristics.},
