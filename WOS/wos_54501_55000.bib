@article{ WOS:001196127800001,
Author = {Khan, Nichola},
Title = {Colonial trauma: Terrains of disappearance, traumatic reflexivity, and
   historicizing countertransference},
Journal = {ETHOS},
Year = {2024},
Volume = {52},
Number = {3},
Pages = {384-400},
Month = {SEP},
Abstract = {This article analyzes trauma as an interplay of mass violence connecting
   imperial occupation in British Hong Kong, and an Anglo-Chinese family in
   England. It takes Devereux's concept of countertransference to
   interrogate how killings in the author's family reverberate as traumatic
   transferences in fieldwork engaging the transgenerational violence of
   Partition in postcolonial Pakistan. Routing through transferences, it
   advances a comparative analysis of colonial trauma; moving from the
   individual to universal through layerings of traumatic silence,
   existential struggles, and the unconscious. It asks: what kinds of
   reflexivity are entailed by the double-nature of the traumatized subject
   writing about trauma? Can colonial trauma retain specificity, while
   speaking to the discordant temporal settlement and relational formation
   of broader interconnected histories, geographical partitions, and
   generational loss? Psychological anthropology offers a mode for filling
   in blanks; privileging the subjectivity of inheritors of colonial trauma
   for ethnographic theorizations into ways anthropologists might reckon
   with the psychic violence of colonial pasts.
   Cet article analyse le traumatisme comme une interaction de la violence
   de masse reliant l'occupation imperiale dans le Hong Kong Britannique et
   une famille Anglo-Chinoise en Angleterre. Il utilise le concept de
   contre-transfert de Devereux pour interroger comment les meurtres dans
   la famille de l'auteur resonnent en tant que transferts traumatiques
   dans un travail de terrain portant sur la violence transgenerationnelle
   au Pakistan postcolonial. En explorant les transferts, il avance une
   analyse comparative du traumatisme colonial, passant de l'individuel a
   l'universel a travers des couches de silence traumatique, des luttes
   existentielles, et de l'inconscient. Quels types de reflexivite sont
   impliques par la double-nature du sujet traumatise qui ecrit sur le
   traumatisme? Le traumatisme colonial peut-il conserver sa specificite
   tout en s'adressant a l'etablissement temporel discordant et la
   formation relationnelle d'histoires interconnectees, de partitions
   geographiques, et de pertes generationnelles? L'anthropologie
   psychologique offre un mode de remplissage des lacunes qui privilegie la
   subjectivite des heritiers des traumatismes coloniaux.},
