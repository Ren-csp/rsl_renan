@article{ WOS:001589379300023,
Author = {Kim, Jeong Seon and Chen, Zhenhang and Espinosa Garcia, Sara Andrea and
   Buhlheller, Christoph and Zhang, Botao and Richards, Stephen J. and
   Chen, Tingfei and Wu, Jingjing and Bruntz, Ronald C. and Gilliam, Marisa
   E. and Yamauchi, Mitsuo and Liang, Bo and Guo, Houfu},
Title = {Structural basis of collagen glucosyltransferase function and its
   serendipitous role in kojibiose synthesis},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUL 21},
Abstract = {Collagen glucosyltransferases catalyze collagen glucosylation critical
   for biology and diseases, yet their structural regulation remains
   unclear. Here, we report crystal structures of a mimiviral collagen
   glucosyltransferase in its apo form and in complexes with uridine
   diphosphate (UDP) and the disaccharide product. We reveal that the
   enzyme forms a homodimer, stabilized by a loop from one subunit locking
   into a cleft on the other, enabling UDP-glucose binding cooperativity
   and enzymatic activity, a property conserved in the human homolog. The
   structures support an induced fit model for UDP interaction. The
   dimerization also forms an extended cleft flanked by two active sites,
   likely facilitating collagen recognition. Unexpectedly, the mimiviral
   enzyme also synthesizes a prebiotic disaccharide kojibiose. An elongated
   pocket near the active site allows the enzyme to use UDP-glucose and
   glucose for kojibiose production. We confirm the enzyme's kojibiose
   synthesis activity in vitro and in vivo. These insights inform
   glucosyltransferase function and open new avenues for inhibitor
   development and kojibiose biosynthesis.
   Researchers show how a viral collagen glucosyltransferase works by
   solving its 3D structure, revealing dimerization-driven activity and its
   surprising ability to make the prebiotic sugar kojibiose, offering clues
   for drug and prebiotic development.},
