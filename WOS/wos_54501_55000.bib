@article{ WOS:000368093600001,
Author = {Crouse, Dan L. and Philip, Sajeev and van Donkelaar, Aaron and Martin,
   Randall V. and Jessiman, Barry and Peters, Paul A. and Weichenthal,
   Scott and Brook, Jeffrey R. and Hubbell, Bryan and Burnett, Richard T.},
Title = {A New Method to Jointly Estimate the Mortality Risk of Long-Term
   Exposure to Fine Particulate Matter and its Components},
