@article{ WOS:001545546500015,
Author = {Gomez-Carreto, Tlillalcapatl and Alvarez, Pamela Macias and Michel, Juan
   Pedro Ibarra},
Title = {Sustainable destination: the challenge of competitiveness and
   satisfaction in San Cristóbal de las Casas from a structural approach},
Journal = {INVESTIGACIONES TURISTICAS},
Year = {2025},
Number = {30},
Pages = {339-364},
Month = {JUL-DEC},
Abstract = {Sustainability has become a key reference for tourist destinations that
   aspire to be competitive in an increasingly diverse market that is more
   aware of the impacts of this activity. Competitiveness in tourism is
   linked to meeting visitors' expectations through quality products or
   services, as well as achieving high levels of satisfaction. This study
   argues that there is a close relationship between sustainability,
   competitiveness, and tourist satisfaction. In Mexico, the Pueblos M \&
   aacute;gicos program seeks to preserve the cultural heritage of
   destinations and promote sustainable local development through tourism.
   In this context, the case of San Crist \& oacute;bal de las Casas is
   analyzed using a mixed methodology that combines qualitative interviews
   and a structural equation model (SEM) with confirmatory factor analysis
   (CFA), based on surveys conducted with both national and international
   tourists. The results show that the quality and safety of the
   destination are the main factors associated with satisfaction, followed
   by the diversity of the tourism offer. In turn, satisfaction
   significantly influences the perception of sustainability. The
   interviews reveal shortcomings in heritage preservation, environmental
   management, and sustainability education, although a positive
   socioeconomic impact is also acknowledged. In conclusion, although San
   Crist \& oacute;bal de las Casas has a rich cultural heritage, its
   sustainable tourism development is still incipient. It is essential to
   implement comprehensive strategies that prioritize both community
   well-being and environmental conservation, which has direct practical
   implications for the management of sustainable tourist destinations in
   similar contexts.},
