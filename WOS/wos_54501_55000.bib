@article{ WOS:000222886500006,
Author = {Diamond, J and Browning, M and Williams, A and Middleton, J},
Title = {Lack of evidence for impact of the European White Birch, Betula
   pendula, on the hydrology of Wainfleet Bog, Ontario},
Journal = {CANADIAN FIELD-NATURALIST},
Year = {2003},
Volume = {117},
Number = {3},
Pages = {393-398},
Month = {JUL-SEP},
Abstract = {Over time peat harvesting and human encroachment have devastated the
   hydrology of Wainfleet Bog. Disturbances caused by human activities have
   rendered the bog ecosystem vulnerable to an influx of invasive species.
   The European White Birch (Betula pendula) has contributed to the
   degradation of the Wainfleet Bog. The disrupted hydrology has allowed
   for the development of dry conditions that have enabled B. pendula to
   take over habitats that were once dominated by native flora. To
   determine whether B. pendula was depressing the water table through
   evapotranspiration, we examined water table levels (March 1998 to July
   1999) and vegetative data from 15 well stations. Analysis of results
   using a Repeated Measures Statistic Design failed to demonstrate a
   significant relationship between the presence of B. pendula and water
   table levels at Wainfleet Bog.},
