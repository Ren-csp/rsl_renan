@article{ WOS:001592256000001,
Author = {Zoderer, Brenda Maria},
Title = {Reconnecting people and wild nature in cities: Experienced barriers to
   using urban wild spaces among non-users},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {11},
Pages = {3088-3103},
Month = {NOV},
Abstract = {1. Wild spaces in cities have the potential to reconnect people with
   nature, offering urban residents opportunities to engage with natural
   environments in close proximity. However, little is known about who uses
   urban wild spaces and what barriers prevent people from visiting them.
   2. This study explores the prevalence of nonusers and their experienced
   barriers across three types of urban wild spaces: urban forests, urban
   wastelands and urban wildflower meadows. Based on a questionnaire survey
   of 800 residents of Vienna (Austria) and a multi-level barrier
   framework, this study investigates the relative importance of
   experienced barriers related to the availability, accessibility and
   attractiveness of these greenspaces. 3. The findings indicate that
   nonusers of urban wild spaces account for 12\% to 36\% of the urban
   population. Urban wastelands and urban wildflower meadows are used less
   frequently than urban forests. The socio-demographic profiles of
   nonusers significantly differ from those of users with regard to gender,
   age, education and parental status. 4. The perceived lack of urban wild
   spaces at the neighbourhood level represents the most significant
   barrier, with low levels of ecological knowledge also identified as a
   key issue. These barriers are relevant across all three types of urban
   wild spaces. Additional barriers related to accessibility and
   attractiveness are experienced for urban wastelands and urban forests.
   Women are less able to access the two wild spaces, while older people,
   residents with limited financial means, and those who perceive these
   spaces as unattractive are less likely to visit urban wastelands. 5.
   Synthesis and applications. The analysis suggests that establishing
   urban wild spaces near residential areas, combined with educational
   programmes that promote ecological knowledge, can facilitate contact
   with (wild) nature. Additionally, recognising the specific needs of
   women, the elderly and low-income groups in the planning, design and
   management of wild spaces will be essential to ensure equitable access
   to urban wild nature and its associated benefits.},
