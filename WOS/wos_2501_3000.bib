@article{ WOS:001279518300002,
Author = {Palacios-Pacheco, Sofia and Martin-Lopez, Berta and Exposito-Granados,
   Monica and Requena-Mullor, Juan M. and Lozano, Jorge and Sanchez-Zapata,
   Jose Antonio and Morales-Reyes, Zebensui and Castro, Antonio J.},
Title = {Carnivores' contributions to people in Europe},
Journal = {ECOLOGY AND SOCIETY},
Year = {2024},
Volume = {29},
Number = {3},
Month = {JUL},
Abstract = {Human-carnivore relations in Europe have varied throughout history.
   Because of recent conservation efforts and passive rewilding, carnivore
   populations are recovering, which translates into more interactions with
   humans. Thus, unraveling these interactions as well as the multiple
   contributions carnivores provide to people is crucial to their
   conservation. We examined the literature conducted in Europe since 2000
   and used the nature's contributions to people (NCP) framework to
   identify factors that have shaped human-carnivore relations. To do so,
   we examined the state of scientific knowledge and relationships among
   types of NCP from carnivores, countries, and carnivore species; and
   between NCP, actors, and management actions. Results indicated that
   research has been oriented toward large carnivore species and their
   detrimental contributions to people. Further, the effectiveness of
   carnivore management strategies has only been evaluated and monitored in
   a limited set of all the research. To balance any negative views on
   carnivores, we suggest that the recognition of the duality of
   carnivores, as providers of both beneficial and detrimental
   contributions, should be included in EU conservation policies.},
