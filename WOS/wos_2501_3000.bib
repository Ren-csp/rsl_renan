@article{ WOS:001633932500001,
Author = {Arbabi, Roya and Bahramjerdi, Somayeh Fadaei Nezhad and Taleghani,
   Mohammad},
Title = {Pedestrians' perceptions of different heat mitigation strategies for an
   urban river valley in Iran: Coupling a questionnaire survey with
   microclimate modeling},
Journal = {ENVIRONMENTAL PROGRESS \& SUSTAINABLE ENERGY},
Year = {2026},
Volume = {45},
Number = {2},
Month = {MAR},
Abstract = {This study examines the effectiveness of various heat mitigation
   strategies in Tehran, Iran, by integrating pedestrian perception surveys
   with ENVI-met microclimate modeling. Strategies assessed include
   additional vegetation, water bodies, shade, and cool pavements, aiming
   to bridge the gap between expert knowledge and public preferences.
   Simulations showed that increasing vegetation reduced mean radiant
   temperature (T mrt) by up to 14 degrees C and Physiological Equivalent
   Temperature (PET) by 5 degrees C. Enhancing pavement albedo reduced
   surface temperature by 6.9 degrees C and air temperature by 2 degrees C.
   Survey responses revealed strong preferences for vegetation and shade,
   aligning with modeled outcomes. These findings highlight the importance
   of combining subjective perceptions with objective data in designing
   thermally comfortable urban environments. While limited by sample size
   and site-specific conditions, this study provides a basis for future
   research on broader climatic contexts and urban forms.},
