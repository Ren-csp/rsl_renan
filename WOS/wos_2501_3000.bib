@article{ WOS:001571944900001,
Author = {Rynio, Dorota and Adamiczka, Hanna and Adamiczka, Bartosz and Broma,
   Tomasz},
Title = {ASSESSMENT OF THE RECREATIONAL USABILITY OF STORMWATER MANAGEMENT
   SYSTEMS IN URBAN AREAS-A CASE STUDY OF WROCŁAW},
Journal = {ECONOMICS AND ENVIRONMENT},
Year = {2025},
Volume = {93},
Number = {2},
Pages = {17},
Abstract = {The article presents the potential of building an effective system for
   sustainable stormwater management in urban areas that fulfils
   recreational functions, using the Nowe \& Zdot;erniki estate in WrocTaw
   (Poland) as a case study. The method-ology includes desk research,
   cartographical analysis of the studied areas, case study, indicator
   analysis, and an individual in-depth interview. The study identifies a
   lack of a holistic approach to retention systems that integrate
   recreational use, leading to underutilized urban spaces. The limitations
   involve the complexity of assessing individual system components, which
   was addressed through simplified indices-RUI-E (Recreational usability
   index of the element) and RUI-S (Recreational usability index of the
   system). This simplification allows for intuitive use but opens
   possibilities for further development, including inte-grating more
   detailed parameters. Originality/Value lies in the ability to assess the
   attractiveness of an area using the proposed procedure for determining
   the recreational usability of stormwater management systems in urban
   areas. At the same time, it can serve as a tool to support urban design,
   making it applicable to designers and researchers in both new and
   existing urban developments. The Nowe \& Zdot;erniki system's
   recreational usability was moderate, with improvement potential.},
