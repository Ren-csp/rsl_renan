@article{ WOS:001823448200001,
Author = {Oro-Aran, Ferran and Lagonigro, Raymond and Martori, Joan Carles and
   Iglesias-Pascual, Ricardo},
Title = {Mapping urban environmental stress in Barcelona: a multivariate approach
   using GWPCA},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {148},
Month = {SEP 15},
Abstract = {This study develops a spatially explicit Environmental Stress Index
   (ESI) for Barcelona, integrating six key environmental dimensions (air
   pollution, noise, thermal stress, population density, park
   accessibility, and green cover) across 1,068 census tracts. Using
   Geographically Weighted Principal Component Analysis, the analysis
   captures local spatial heterogeneity in environmental stress and derives
   location-specific weights to construct a multidimensional composite
   indicator. The ESI synthesises multivariate data into a spatially
   explicit diagnostic tool, identifying intraurban disparities and
   dominant stressors at the local level. Results reveal that 45\% of the
   population is exposed to above-average environmental stress,
   particularly in central, eastern, and northern areas, despite these
   zones covering only 25\% of the city's area. By using a localised
   multivariate analysis, the framework offers a policy relevant diagnostic
   tool that enables the detection of high-stress areas driven by
   environmental inequalities, supporting the effective targeting of
   interventions at the intraurban scale. Its scalability and adaptability
   make it suitable for application in other urban contexts, supporting
   data-driven strategies for urban sustainability, climate adaptation, and
   environmental justice.},
