@article{ WOS:001754007300001,
Author = {Fleckney, Paul},
Title = {Planning parks for adolescent mental health and wellbeing in Melbourne,
   Australia: bridging the gap between intent and practice},
Journal = {CITIES \& HEALTH},
Year = {2026},
Month = {2026 APR 24},
Abstract = {Urban parks can support mental health and wellbeing by promoting stress
   recovery, social interaction and connection to nature. The youth mental
   health crisis presents a timely opportunity to understand if and how
   park planners prioritise adolescent mental health and wellbeing
   outcomes. The author surveyed open space planners working in local
   government in Melbourne, Australia (n = 49). Respondents rated the
   extent to which they thought parks catered for the wellbeing needs of
   older adolescents (16-19 years), and whether they planned these spaces
   to meet these needs. The author also conducted interviews with planners
   (n = 14), analysed 31 open space strategies and made field observations
   (n = 45). According to planners, Melbourne parks do not cater well to
   older adolescents' mental health and wellbeing needs, especially those
   of girls and young women. Reasons stated include a history of
   privileging male sport, restrictive standards and policies, and
   conflicts with operational and financial drivers of park design.
   Planners reported an increased awareness of adolescents' mental
   wellbeing needs but they work in complex and challenging environments
   that inhibit their capacity to match intent with practice. To ensure
   parks are equitable health resources, planners must challenge existing
   practices and discourses and use targeted engagement approaches to
   empower adolescents to participate.},
