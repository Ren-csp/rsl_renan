@article{ WOS:001770205000001,
Author = {Stoia, Nicoleta-Larissa and Nita, Mihai Razvan and Gradinaru, Simona R.
   and Zwierzchowska, Iwona and Ioja, Cristian I.},
Title = {The distribution and uses of private gardens in Romanian small towns},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {122},
Month = {AUG},
Abstract = {Urban green infrastructure has emerged as a central element of planning
   strategies to enhance environmental quality, support climate change
   adaptation, improve public health, and enhance urban resilience. While
   approaches to the development of urban green infrastructures have
   generally focused on large parks and public green areas, recent
   discourse increasingly acknowledges the importance of small-scale,
   decentralized spaces-among which private gardens hold significant
   potential. Often overlooked in urban planning and green infrastructure
   assessments, private gardens can constitute a considerable share of
   urban green space, particularly in small towns, where land availability
   and residential typologies favor their maintenance, management, and
   development. This study examines the structure and functionality of
   private gardens as components of urban green infrastructure in Romanian
   small towns, building on the detailed analysis of three municipalities
   with populations between 8800 and 22,000 inhabitants (i.e., Carei, Ineu,
   Cisnadie). Using aerial images, we spatially mapped information on the
   surface, configuration, and distribution of private gardens within the
   public-private property structure of the three small towns. In addition,
   we surveyed 199 garden-owning urban residents about the internal layout
   and location of gardens within households, management practices, and the
   perceived social and environmental benefits. Findings show that private
   gardens account for between 12.98\% and 45.35\% of the total city area,
   far more than public green spaces, which range from 0.01\% to 0.77\%.
   Respondents emphasized the importance of aesthetics (58.8\%), food
   production (50.8\%), and the creation of personal or family-oriented
   recreational spaces (30.7\%). Gardening and leisure time are closely
   intertwined and often centered around these private green areas. The
   results underscore the potential of private gardens to gradually assume
   more structured roles in supporting urban ecological functions, offering
   valuable insights for urban planners and policymakers seeking to enhance
   green infrastructure in small towns.},
