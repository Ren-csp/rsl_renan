@article{ WOS:001704319100001,
Author = {Richardson, Miles and Rocha, Nara Maria Forte Diogo and Lengieza,
   Michael L.},
Title = {How can global differences in nature connection inform new relationships
   with nature?},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2026},
Volume = {316},
Month = {APR},
Abstract = {The deteriorating human-nature relationship is increasingly recognized
   as a root cause of climate change and biodiversity loss. Understanding
   similarity and differences at scale is critical when considering policy
   and this study investigates global differences in nature connectedness
   between the ``Global North{''} and ``Global South{''}, using data from
   61 countries and a range of socio-economic and cultural indicators.
   Results show that nature connectedness is significantly higher in the
   Global South. While economic development has often been linked to
   environmental degradation, our findings suggest that cultural and
   spiritual values play a more substantial role in shaping the
   human-nature relationship. Specifically, indicators related to
   spirituality and the balance between science and faith were strongly
   associated with nature connectedness, whereas objective environmental
   and economic factors explained less variance. These results have
   implications for environmental policy as they highlight the importance
   of cultural worldviews in fostering nature connectedness and suggest
   that efforts to repair the human-nature relationship, particularly in
   the Global North, may benefit from integrating spiritual and relational
   perspectives. The study concludes that nature connectedness is embedded
   more deeply in cultural and value-driven contexts than in economic or
   environmental conditions. Recognising and learning from the cultural
   strengths of the Global South may inform transformative approaches to
   sustainability and resilience, including policy shifts that embrace
   nature-based spirituality and relational worldviews.},
