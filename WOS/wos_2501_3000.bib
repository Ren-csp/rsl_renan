@article{ WOS:001856674700001,
Author = {Barreiros, Ana Maria and Pinto, Iola and Rodrigues, Alexandra and Gomes,
   Maria Idalia},
Title = {A living lab approach to urban water reuse: Coupling plant growth
   monitoring and social acceptance in university buildings},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {575},
Month = {SEP 5},
Abstract = {This study presents a socio-technical assessment of treated wastewater
   (TWW) reuse for indoor irrigation, integrating plant growth monitoring
   based on projected leaf area with user acceptance analysis in a
   real-world educational environment. Unlike prior studies relying on
   hypothetical exposure, this living lab links continuous system
   performance with user perception under real operational conditions,
   addressing a key gap in the literature. Plant growth was monitored over
   one year using non-invasive image-based analysis, while social
   acceptance was assessed among 186 students through the Perception and
   Acceptance of Water Reuse (PAWR) index (Cronbach's alpha = 0.878). Four
   classroom environments were considered: a green classroom (GR)
   incorporating a nature-based solution with living plants irrigated with
   either TWW or drinking water (DW); a biophilic design classroom (BDR)
   featuring visual nature imagery; and two neutral classrooms (NR) without
   biophilic elements, serving as controls. TWW supported plant growth at
   levels comparable to DW across most species, with no adverse effects
   observed; only one species (Scindapsus aureus) showed significantly
   greater growth under TWW (p = 0.006). The overall PAWR index (3.9 +/-
   0.5) indicated generally high acceptance of water reuse, particularly
   among students with water-related academic backgrounds, while the
   physical classroom environment showed limited overall influence, though
   responses were more favourable in the GR for specific reuse
   applications. By integrating plant growth monitoring and behavioural
   analysis within a living lab setting, this study provides a transferable
   socio-technical framework for evaluating water reuse systems in
   institutional buildings, supporting freshwater conservation and
   evidence-based circular water strategies in higher education
   institutions.},
