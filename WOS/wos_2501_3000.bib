@article{ WOS:001747164400001,
Author = {Yu, Chunlin and Gao, Jiayang and Peng, Xinqiang and Chai, Ji},
Title = {Revealing the nonlinear impact of Beijing's blue-green space pattern on
   the cool island effect under local climate zone perspective},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {143},
Month = {JUN 1},
Abstract = {Urban blue-green spaces (BGS) play a key role in mitigating urban heat
   islands via their cool island effect (CIE). From the perspective of
   Local Climate Zones (LCZ) identified by WUDAPT, this study quantified
   BGS patterns and their CIE in Beijing during 2005-2023. Fragstats and
   InVEST models were used to measure BGS spatial patterns and CIE
   intensity, respectively, while XGBoost and SHAP methods explored the
   nonlinear relationship between BGS patterns and cooling benefits. The
   findings are as follows: (1) Beijing's LCZ distribution follows
   ``southeastdominated buildings and northwest-dominated natural
   areas,{''} with LCZ9 (Sparsely built) and LCZA (Dense trees) increasing
   by 15.39 and 12.87 percentage points over 18 years. (2) Water bodies and
   dense forests exhibit the strongest cooling effects, with high-value
   areas concentrated in the northwest ecological conservation zone. (3)
   Area proportion dominates cooling in blue-green integrated spaces
   (BGIS), with blue and green elements showing strong synergistic cooling
   impacts. (4) BGS cooling is shaped by scale, connectivity, and
   configuration; optimized patterns overcome area limitations, benefiting
   compact and natural LCZs, while BGS expansion enhances cooling in open
   low-rise LCZs. This study provides scientific support for optimizing BGS
   patterns to strengthen CIE in high-density cities and offers a climate
   zone-based perspective for heat island mitigation.},
