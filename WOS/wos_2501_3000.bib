@article{ WOS:001856439900001,
Author = {Reuss, Konrad and Huth, Christopher},
Title = {What's it worth? Willingness-to-pay for urban green spaces for urban
   year-round green exercise},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {125},
Month = {NOV},
Abstract = {Introduction: Urban green spaces play a crucial role in promoting
   physical activity and public health, particularly through year-round
   green exercise. However, existing research has largely focused on
   fair-weather conditions and provides limited insight into how urban
   green spaces should be designed to support physical activity under
   varying environmental conditions. This study aims to assess user
   preferences and willingness to pay for urban green spaces features that
   facilitate urban year-round green exercise. Methods: A cross-sectional
   online survey (N = 302) was conducted, incorporating forced-choice
   tasks, ranking measures, and contingent valuation. Preferences for
   natural and infrastructural urban green space features were analyzed
   using binomial tests and Friedman tests, while willingness-to-pay was
   examined descriptively and through regression analyses. Results: The
   results revealed a strong and consistent preference for forested areas,
   which were ranked as the most important feature across measurement
   formats. In contrast, infrastructural elements showed greater
   variability and were influenced by individual characteristics such as
   sport type and usage frequency. Ranking analyses indicated a structured
   prioritization pattern, although effect sizes were small. Approximately
   70\% of participants expressed a willingness to pay for improved urban
   green spaces, although the absolute monetary amounts were relatively
   low. Discussion: The findings suggest that urban green spaces actively
   structure behavior by providing or constraining opportunities for
   physical activity. From a theoretical perspective, engagement in urbane
   year-round green exercise appears to be shaped by both
   person-environment fit and perceived behavioral control. These results
   highlight the importance of integrating universally valued natural
   elements with adaptable infrastructure in urban green space design.
   Overall, the study contributes to a more comprehensive understanding of
   how urban green spaces can be optimized to support physical activity
   year-round and provides relevant insights for urban planning and public
   health policy.},
