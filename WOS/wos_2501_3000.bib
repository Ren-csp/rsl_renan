@article{ WOS:001764425700001,
Author = {Grundstrom, Karin and Grander, Martin and Rosengren, Mathilda},
Title = {Stråk: towards designing green, place-bound connectivity in
   Scania, Sweden?},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2026},
Month = {2026 MAY 14},
Abstract = {Str \& aring;k is a Swedish urban design concept defined as an
   inter-scalar urban corridor, developed over the past two decades to
   support inter-urban and urban-rural connections. Based on interviews
   with twenty planners in three southern Swedish municipalities, their
   drawings of str \& aring;k, and QGIS income analysis, the article shows
   that few str \& aring;k cross the urban-rural divide; instead,
   boundaries form at urban fringes while str \& aring;k contributed to
   porous borders within cities. The str \& aring;k concept has shifted
   towards greener designs, with trees and green spaces replacing parks and
   urban nature. Overall, planning increasingly embraces green, place-based
   connectivity through str \& aring;k.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
