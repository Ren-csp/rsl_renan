@article{ WOS:001836027200001,
Author = {Bai, Tingting and Xu, Dong and Gao, Feng and Liu, Jiawei and Song,
   Yongze},
Title = {Deep learning reveals cross-platform consistency in street view imagery
   for urban perception mapping},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2026},
Volume = {130},
Month = {DEC},
Abstract = {Street view imagery (SVI) is now widely used to assess urban living
   environments, yet cross-platform differences in sensors, viewing
   geometry, and image quality continue to limit data integration. Using
   paired Baidu Street View (BSV) and Google Street View (GSV) images from
   Hong Kong, we propose a dual-scale framework to test whether physical
   streetscape structure and model-derived perception remain comparable
   across platforms. The framework combines stacking ensemble learning,
   SHAP-based interpretation, and Mantel correlation analysis at both
   sampling-point and pixel scales. At the sampling-point scale,
   vegetation, buildings, and sky show strong BSV-GSV agreement, with
   correlations of 0.753, 0.756, and 0.720, respectively. Perceptual
   dimensions also show moderate-to-high consistency, ranging from 0.591
   for ``Depressing{''} to 0.672 for ``Safe.{''} At the pixel scale,
   simulated vegetation distributions are highly consistent, with an
   average correlation of 0.84 and more than 98\% of the study area
   significant at p < 0.001; ``Beauty{''} also maintains a positive
   correlation of 0.645. Further structural and causal analyses suggest
   that natural elements tend to enhance perceived beauty, whereas
   artificial and traffic-related features are generally linked to negative
   perceptual effects. Robustness tests using SegFormer and DeepLabv3+
   under ADE20K and Cityscapes, together with perception-backbone tests
   using ResNet50 and CLIP, indicate that the main structural consistency
   findings are stable across segmentation pipelines, while perceptual
   consistency remains more sensitive to the selected backbone. Overall,
   this study offers a robust methodological foundation for urban design
   and sustainable city assessment by improving spatial prediction accuracy
   and interpretability.},
