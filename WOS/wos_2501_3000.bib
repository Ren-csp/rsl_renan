@article{ WOS:001785300100001,
Author = {Senosiain, Angela Laurenz and Zaballos, Itxaro Latasa and Isasi, Xabat
   Oregi},
Title = {Greening in compact cities: A multicriteria approach to optimise small
   green space connectivity},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {122},
Month = {AUG},
Abstract = {In the face of growing environmental challenges stemming from
   urbanisation and densification, small urban green spaces (SUGS) and
   their connectivity represent a crucial source of ecosystem services (ES)
   for residents of compact areas where large-scale interventions are
   unfeasible. This research presents a methodological proposal for
   designing a green corridor in a dense, low environmental quality
   neighbourhood in Pamplona (Spain). Based on a literature review and a
   morphological analysis of the study area-which reveals the functions,
   limitations, and opportunities for Green Infrastructure (GI) in this
   context-a set of specific criteria are derived to plan an integrated
   SUGS network that enhances ecological and social connectivity. The
   methodology combines GIS with a multicriteria decision-making process,
   weighting key parameters-SUGS concentration, urban centrality,
   preexisting linear elements, street width, and city-scale
   connectivity-to determine the optimal axes for a green corridor that
   links the neighbourhood's internal spaces with the city-wide system. The
   results reveal a corridor layout that differs significantly from the
   municipal Green Infrastructure Plan-which is based on visual criteria-by
   prioritising areas with high SUGS density and strategic centrality. This
   demonstrates that functional connectivity requires a data-driven
   approach contextualised by morphology, offering a replicable model for
   green infrastructure planning in compact urban fabrics.},
