@article{ WOS:000768311900001,
Author = {Damm, Anna Piil and von Essen, Emma and Jensen, Astrid Jaeger and
   Kerrn-Jespersen, Freja and van Mastrigt, Sarah},
Title = {Duration of Mentoring Relationship Predicts Child Well-Being: Evidence
   from a Danish Community-Based Mentoring Program},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {5},
Month = {MAR},
Abstract = {While a substantial body of literature suggests that lasting community
   mentoring relationships can have a range of positive effects on youths,
   little is known about these effects in the Nordic welfare context, where
   community mentees may have lower risk profiles compared to many previous
   samples. This study explores how the duration (length) of child
   mentoring relationships predicts parental perceptions of child
   well-being among 197 children served by Denmark's most extensive
   community-based youth mentoring program. We find that children who have
   had a mentor for at least one year are perceived to have significantly
   higher well-being. In contrast, we find no significant differences in
   well-being between children who had mentors for less than one year and
   children on a waiting list. Previous research, conducted in primarily
   North American contexts, finds that longer mentoring relationships
   substantially improve school behavior and reduce risk taking. Our
   results add to the literature by indicating that a minimum mentoring
   relationship duration of one year appears to be similarly important in
   promoting well-being for youths involved in community-based mentoring
   programs in a Nordic welfare context.},
