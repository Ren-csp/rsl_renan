@article{ WOS:001523451500034,
Author = {Ouyang, Xingyu and Ran, Xinchun and Xu, Han and Al-Abssi, Runeem and
   Zhao, Yi-Lei and Link, A. James and Yang, Zhongyue J.},
Title = {LassoPred: a tool to predict the 3D structure of lasso peptides},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUL 1},
Abstract = {Lasso peptides (LaPs), characterized by their entangled slipknot-like
   structures, are a large class of ribosomally synthesized and
   post-translationally modified peptides (RiPPs), with examples
   functioning as antibiotics, enzyme inhibitors, and molecular switches.
   Despite thousands of LaP sequences predicted by bioinformatics, only
   around 50 distinct LaPs have been structurally characterized in the past
   30 years. Existing computational tools, such as AlphaFold2, AlphaFold3
   and ESMfold, fail to accurately predict LaP structures due to their
   irregular scaffold featuring a lariat knot-like fold and the presence of
   an isopeptide bond. To address this challenge, we developed LassoPred,
   designed with a classifier to annotate the ring, loop, and tail of an
   LaP sequence and a constructor to build a 3D structure. Leveraging
   LassoPred, we predict the 3D structures for 4749 unique LaP core
   sequences, creating the largest in silico-predicted lasso peptide
   structure database to date. LassoPred is publicly available through a
   web interface (https://lassopred.accre.vanderbilt.edu/) and a
   command-line tool, supporting future structure-function relationship
   studies and aiding in the discovery of functional lasso peptides for
   chemical and biomedical applications.},
