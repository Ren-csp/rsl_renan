@article{ WOS:001161546900018,
Author = {Li, Weimin and Li, Angdi and Yu, Bing and Zhang, Xiaoxiao and Liu,
   Xiaoyan and White, Kate L. and Stevens, Raymond C. and Baumeister,
   Wolfgang and Sali, Andrej and Jasnin, Marion and Sun, Liping},
Title = {In situ structure of actin remodeling during glucose-stimulated insulin
   secretion using cryo-electron tomography},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {FEB 12},
Abstract = {Actin mediates insulin secretion in pancreatic beta-cells through
   remodeling. Hampered by limited resolution, previous studies have
   offered an ambiguous depiction as depolymerization and repolymerization.
   We report the in situ structure of actin remodeling in INS-1E beta-cells
   during glucose-stimulated insulin secretion at nanoscale resolution.
   After remodeling, the actin filament network at the cell periphery
   exhibits three marked differences: 12\% of actin filaments reorient
   quasi-orthogonally to the ventral membrane; the filament network mainly
   remains as cell-stabilizing bundles but partially reconfigures into a
   less compact arrangement; actin filaments anchored to the ventral
   membrane reorganize from a ``netlike{''} to a ``blooming{''}
   architecture. Furthermore, the density of actin filaments and
   microtubules around insulin secretory granules decreases, while actin
   filaments and microtubules become more densely packed. The actin
   filament network after remodeling potentially precedes the transport and
   release of insulin secretory granules. These findings advance our
   understanding of actin remodeling and its role in glucose-stimulated
   insulin secretion.
   Actin mediates insulin secretion in pancreatic beta-cells through
   remodeling. Here, authors report the in situ structure of actin
   remodeling and quantify changes in architecture, alignment, and
   interactions during glucose-stimulated insulin secretion.},
