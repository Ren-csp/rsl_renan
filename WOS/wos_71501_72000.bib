@article{ WOS:001142518400013,
Author = {Sauer, Carolin M. and Hall, James A. and Couturier, Dominique-Laurent
   and Bradley, Thomas and Piskorz, Anna M. and Griffiths, Jacob and Sawle,
   Ashley and Eldridge, Matthew D. and Smith, Philip and Hosking, Karen and
   Reinius, Marika A. V. and Morrill Gavarro, Lena and Mes-Masson,
   Anne-Marie and Ennis, Darren and Millan, David and Hoyle, Aoisha and
   Mcneish, Iain A. and Jimenez-Linan, Mercedes and Martins, Filipe Correia
   and Tischer, Julia and Vias, Maria and Brenton, James D.},
Title = {Molecular landscape and functional characterization of centrosome
   amplification in ovarian cancer},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {OCT 16},
Abstract = {High-grade serous ovarian carcinoma (HGSOC) is characterised by poor
   outcome and extreme chromosome instability (CIN). Therapies targeting
   centrosome amplification (CA), a key mediator of chromosome
   missegregation, may have significant clinical utility in HGSOC. However,
   the prevalence of CA in HGSOC, its relationship to genomic biomarkers of
   CIN and its potential impact on therapeutic response have not been
   defined. Using high-throughput multi-regional microscopy on 287 clinical
   HGSOC tissues and 73 cell lines models, here we show that CA through
   centriole overduplication is a highly recurrent and heterogeneous
   feature of HGSOC and strongly associated with CIN and genome
   subclonality. Cell-based studies showed that high-prevalence CA is
   phenocopied in ovarian cancer cell lines, and that high CA is associated
   with increased multi-treatment resistance; most notably to paclitaxel,
   the commonest treatment used in HGSOC. CA in HGSOC may therefore present
   a potential driver of tumour evolution and a powerful biomarker for
   response to standard-of-care treatment.
   The prevalence of centrosome amplification (CA) and the genomic
   landscape of chromosomal instability in high-grade serous ovarian
   carcinoma (HGSOC) remain to be explored. Here the authors suggest CA as
   a potential driver of tumour evolution and a biomarker for treatment
   response in HGSOC.},
