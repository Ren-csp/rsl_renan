@article{ WOS:000346797100003,
Author = {Cavalcanti, Alessandro Leite and Araujo Rodrigues, Iris Sant' Anna and
   de Melo Silveira, Ingrid Thays and Sarmento de Oliveira, Thaliny Batista
   and de Almeida Pinto, Magaly Suenya and Cabral Xavier, Alidianne Fabia
