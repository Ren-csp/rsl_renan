@article{ WOS:000504858100004,
Author = {Bastian, Brock and Vauclair, Christin-Melanie and Loughnan, Steve and
   Bain, Paul and Ashokkumar, Ashwini and Becker, Maja and Bilewicz, Michal
   and Collier-Baker, Emma and Crespo, Carla and Eastwick, Paul W. and
   Fischer, Ronald and Friese, Malte and Gomez, Angel and Guerra, Valeschka
   M. and Castellanos Guevara, Jose Luis and Hanke, Katja and Hooper, Nic
