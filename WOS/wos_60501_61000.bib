@article{ WOS:001453490100001,
Author = {Liu, Jie and Yang, Yuping and Zhou, Jian and Feng, Xintong and Li, Yuan
   and Li, Yuze and Zi, Junlin and Wang, Chunru and Wang, Enli and Jia,
   Yuehui},
Title = {Evaluation of Soil Aggregate Sieving: The Impact of Field Moisture
   Content on Size Distribution and Stability},
Journal = {AGRONOMY-BASEL},
Year = {2025},
Volume = {15},
Number = {3},
Month = {FEB 25},
Abstract = {Soil aggregation, a critical component of soil structure, is
   significantly influenced by soil moisture content, which can vary
   substantially across different field conditions. The objective of this
   study was to evaluate the impact of soil relative water content (SRWC)
   on the performance and sensitivity of soil aggregate size distribution
   (DOSA) assessments. We conducted a comprehensive analysis across a range
   of SRWC levels and observed a consistently high recovery rate of sieving
   (exceeding 99.22\%), indicating a robust methodology. The relative
   standard deviation (RSD) of DOSA was minimal, highlighting the high
   precision of sieving outcomes, particularly up to an SRWC of 40\%.
   Cluster analysis, based on soil properties, identified six distinct soil
   groups, each demonstrating a significant correlation between the
   characteristic values of DOSA and SRWC, with determination coefficients
   (R2) above 0.717. This finding underscores the sensitivity of aggregate
   distribution to variations in moisture levels. However, the fitting
   curves varied among clusters at the same site, with the exception of
   clusters 5 and 6 at the Jinliuhuan Agricultural Sci-Tech Park (JLH),
   reflecting the intricate nature of soil-moisture interactions. Our
   results emphasize the necessity of sieving soil aggregates under
   controlled field moisture conditions to ensure reliable DOSA
   measurements. This research provides valuable insights into the dynamics
   of soil aggregation and its response to different moisture regimes,
   offering practical implications for enhancing sustainable agricultural
   practices. This study provides a comprehensive analysis of the impact of
   soil relative water content (SRWC) on soil aggregate size distribution
   (DOSA), revealing the high recovery rate and precision of sieving under
   various moisture conditions. The significant correlation between DOSA
   and SRWC, along with the varied responses across soil clusters,
   highlights the complex interplay between soil moisture and aggregate
   stability. These findings are crucial for optimizing soil aggregate
   assessments and sustainable agricultural practices.},
