@article{ WOS:001103080000024,
Author = {Chen, Hung-Chih and Liu, Yen-Wen and Chang, Kuan-Cheng and Wu, Yen-Wen
   and Chen, Yi-Ming and Chao, Yu-Kai and You, Min-Yi and Lundy, David J.
