@article{ WOS:000216463000007,
Author = {Pampaka, Maria and Hutcheson, Graeme and Williams, Julian},
Title = {Quality of Learning Support for Mathematics in Transition to University.},
Journal = {REDU-REVISTA DE DOCENCIA UNIVERSITARIA},
Year = {2014},
Volume = {12},
Number = {2},
Pages = {97-118},
Month = {MAY-AUG},
Abstract = {We report on the development and validation of an instrument that
   measures students' perceptions of ` the quality and effectiveness of the
   learning support' (for mathematics) during their transition to
   university. This is achieved through quantitative analyses of students'
   survey data - including some predictive modelling with the measure -
   complemented with insights from interview data. The construct validation
   of the measure was performed using the Rasch Rating Scale Model (RSM).
   Results include fit and category statistics and the construct hierarchy
   which is presented with some extracts from interview data. The paper
   concludes with some educational implications and examples of how this
   measure can be used to give substantial practical results.},
