@article{ WOS:001302085700003,
Author = {Yang, Qian and Yan, Mengru and Lin, Juan and Lu, Yongkang and Lin,
   Shuang and Li, Zhong and Wang, He and Yang, Juhua and Zhang, Nanwen and
   Chen, Xiaole},
Title = {Screening and affinity fi nity optimization of single domain antibody
   targeting the SARS-CoV-2 nucleocapsid protein},
Journal = {PEERJ},
Year = {2024},
Volume = {12},
Month = {AUG 30},
Abstract = {The coronavirus disease 2019 (COVID-19) pandemic, which caused by severe
   acute respiratory syndrome coronavirus 2 (SARS-CoV-2), lead to a crisis
   with devastating disasters to global public economy and health. Several
   studies suggest that the SARSCoV-2 nucleocapsid protein (N protein) is
   one of uppermost structural constituents of SARS-CoV-2 and is relatively
   conserved which could become a specific diagnostic marker. In this
   study, eight single domain antibodies recognized the N protein
   specifically which were named pN01-pN08 were screened using human phage
   display library. According to multiple sequence alignment and molecular
   docking analyses, the interaction mechanism between antibody and N
   protein was predicted. ELISA results indicated pN01-pN08 with high
   affinity to protein N. To improve their efficacy, two fusion proteins
   were prepared and their affinity was tested. These finding showed that
   fusion proteins had higher affinity than single domain antibodies and
   will be used as diagnosis for the pandemic of SARS-CoV-2.},
