@article{ WOS:001556574900001,
Author = {Gao, Yufang and Yu, Yue},
Title = {Justice in coexistence: Pastoralism and large carnivores on the
   Qinghai-Tibet Plateau},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2186-2199},
Month = {JUL},
Abstract = {The conflict between livestock husbandry and large carnivore
   conservation presents significant challenges in grassland ecosystems
   worldwide. Achieving sustainable coexistence among herders, livestock
   and large carnivores requires reconciling diverse perspectives and
   interests through equitable, inclusive and fair processes that address
   both human-wildlife and human-human relationships. Despite its
   importance, the role of local pastoral practices in shaping
   environmental justice within coexistence dynamics remains underexplored.
   We examined fine-scale coexistence within a 65 km2 valley on the eastern
   Qinghai-Tibet Plateau in China, home to 14 households, over 1500
   livestock and predators such as snow leopards and grey wolves. Using
   participatory mapping, we delineated the boundaries of seasonal pastures
   for valley households. Ethnographic fieldwork, including participant
   observation and interviews, provided insights into historical and
   contemporary grassland use and livestock herding practices. In addition,
   we documented livestock depredation incidents and used MaxEnt modelling
   to map the spatiotemporal patterns of depredation risk zones. Between
   2019 and 2021, we recorded 165 livestock depredation incidents, with a
   higher frequency observed during the cold season. Depredation risk
   varied by season and group: During the warm season, group A grazed at
   lower elevations near the valley entrance and experienced higher
   depredation risk, while during the cold season, group B occupied more
   accessible pastures but faced higher depredation risk. Synthesis and
   applications. Local pastoral practices contribute to distributive
   justice by fostering equitable sharing of depredation risks among
   herding groups. These practices are characterised by the fair allocation
   of pastures through local decision-making processes that carefully weigh
   the advantages and disadvantages of different grazing areas, as well as
   by the spatiotemporal mobility of seasonal livestock grazing across
   heterogeneous landscapes. A justice-focused approach to coexistence
   underscores the need to consider how socioecological structures interact
   with the agency of humans and nonhumans to shape coexistence.
   Integrating environmental justice into conservation efforts offers a
   pathway toward more ethical and sustainable coexistence.
