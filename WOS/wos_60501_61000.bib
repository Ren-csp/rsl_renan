@article{ WOS:000475360700006,
Author = {Bessant, Sophie E. F. and Robinson, Zoe P.},
Title = {Rating and rewarding higher education for sustainable development
   research within the marketised higher education context: experiences
   from English universities},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
