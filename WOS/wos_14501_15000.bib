@article{ WOS:001781078400002,
Author = {Wang, Mingxue and Li, Kaiyun and Li, Wenjing and Lin, Yimiao and Zhang,
   Xu and Jia, Fanlu and Chen, Gongxiang},
Title = {Monkey See, Monkey Do! Environmental Orderliness Affects Conformity},
Journal = {ADVANCES IN COGNITIVE PSYCHOLOGY},
Year = {2026},
Volume = {22},
Number = {2},
Pages = {135-147},
Month = {APR 8},
Abstract = {Physical environmental order has a profound impact on human
   psychological behavior; however, how ordered and disordered perception
   impacts conformity behavior remains unclear. By adopting the
   judge-advisor system (JAS) paradigm and event-related potentials (EPRs)
   method, three experiments systematically investigated the influence of
   physical environmental order on conformity behavior. In Study 1,
   compared to the ordered environmental pictures priming group, conformity
   rating in facial attractiveness decreased significantly in the
   disordered environmental pictures priming group. Study 2 revealed
   amplitudes of feedback-related negativity (FRN), P300, and late positive
   potential (LPP) components of the valuation judgment processing. Study 3
   further demonstrated that individuals with low trait self-control
   exhibited a more pronounced reduction in conformity rating in the
   disordered environmental pictures priming condition compared to those
   with high trait self-control individuals. Physical environmental order
   perception could influence conformity, in which compared to the
   disordered priming, the ordered priming could make low self-control
   trait individuals more conformity.},
Publisher = {VIZJA Univ},
Address = {Ul Okopowa 59, Warszawa, POLAND},
Type = {Article},
Language = {English},
Affiliation = {Chen, GX (Corresponding Author), Univ Jinan, Sch Educ \& Psychol, Jinan 250022, Peoples R China.
   Wang, Mingxue; Li, Kaiyun; Li, Wenjing; Lin, Yimiao; Zhang, Xu; Jia, Fanlu; Chen, Gongxiang, Univ Jinan, Jinan, Peoples R China.},
DOI = {10.5709/acp-0493-2},
ISSN = {1895-1171},
Keywords = {conformity; physical environmental order; self-control; event-related
   potentials (EPRs)},
Keywords-Plus = {DECISION-MAKING; SOCIAL-INFLUENCE; SELF-REGULATION; DISORDER; OPINIONS;
