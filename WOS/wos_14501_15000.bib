@article{ WOS:001751452700001,
Author = {Terada, Mitsunari and Ermilova, Mariia and Shikano, Akiko and Noi,
   Shingo},
Title = {Adapting Tokyo's schoolyards to extreme heat and enrolment pressure:
   Perspectives from the frontline},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {120},
Month = {JUN},
Abstract = {As climate change intensifies the urban heat island effect, outdoor
   school environments become critical to protecting children's health and
   well-being. Our study investigates how Tokyo's public elementary schools
   adapt schoolyards to extreme summer heat amid spatial constraints of
   rising enrolment. We surveyed 434 schools across Tokyo's 23 urban wards
   and the Tama/Island Regions, and applied an environmental justice
   framework. Findings reveal that extreme heat is already disrupting
   educational activities and altering children's behaviour across both
   regions, alongside clear regional disparities driven by administrative
   geography and urban density. While 39.7\% of urban schoolyards utilize
   heat-retaining artificial surfaces, all Tama schools retain natural
   surfaces. Outdoor schoolyard space in the 23 wards (18.7 m2) is nearly
   half that of the Tama/Island Regions (34.5 m2). Tokyo's wealthier urban
   districts have less green schoolyard space than suburban areas, as
   extreme land scarcity overrides socioeconomic advantage. Urban schools
   face greater enrolment pressure, with 53.8\% restricting schoolyard
   access due to overcrowding, compared to 29.6\% in the Tama/Island
   Regions. Consequently, many schools remain reliant on reactive coping
   strategies rather than transformative adaptation. Barriers include
   maintenance burdens, fiscal constraints, governance gaps, and lack of
   technical guidance. We recommend integrated approaches combining green
   infrastructure, surface adaptation, and child-centred spatial planning,
   supported by cross-sector coordination. Schoolyards must be considered
   vital components of citywide climate adaptation strategies, with
   implications for environmental justice, child well-being, and climate
   equity.},
