@article{ WOS:000454054900006,
Author = {Vorpagel, Fernanda Seidel and Matos Uhmann, Rosangela Ines},
Title = {Practices and Conceptions of Environmental Education and Environment in
   non formal context},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
Year = {2018},
Number = {1},
Pages = {63-74},
Abstract = {Environmental Education (EE) is a subject that is sometimes discussed in
   several formal and non-formal contexts. This work is presented in the
   field of non-formal education and is based on the objective of knowing
   which practices are performed, how and what is the conception and
   perception of the environment. This led us to make a bibliographic
   review in the Electronic Journal of Master's Degree in Environmental
   Education (REMEA), period between 2010 and 2012 focusing on practices
   developed in a non-formal context. The path traced pointed indications
   to environmental practices that overcome the issues rooted, for example,
   from the naturalistic perception to advance in the conception and
   perception of the environment towards the globalizing conception,
   understanding that we human beings are the environment and not part of
   it.},
