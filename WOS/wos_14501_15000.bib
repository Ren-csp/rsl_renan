@article{ WOS:001473233900001,
Author = {Cao, Hui and Li, Pingxing and Chen, Jianglong and Chen, Cheng},
Title = {Are We Living in Harmony with Nature? Assessing the Ecological-Economic
   Relationship in China: A Symbiotic Perspective},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2025},
Volume = {11},
Month = {APR 24},
Abstract = {Exploring the relationship between the economy and the ecosystems in
   China could not only be beneficial for achieving the harmonious
   coexistence between humans and nature but also offer scientific
   references for the international society. This study aimed to elucidate
   the long-term ecological-economic relationship in China from the
   symbiotic perspective of ecosystem services value (ESV) and gross
   domestic product (GDP). On the basis of multiple datasets, yearly ESV
   maps from 1990 to 2020 were first produced using unit value method.
   Employing the Lotka-Volterra (L-V) symbiosis model and Bivariate Local
   Moran's I, the coordination and proximity relationships between GDP and
   ESV at the provincial level were then investigated. The results revealed
   that the overall ecological-economic relationship for the study area is
   predator-prey (ESV-GDP), indicating that ecological conservation and
   restoration have been prioritized over economic development in China,
   while, at the provincial level, 3 provinces follow a traditional
   economic development path that sacrifices ecosystem health. The research
   findings revealed the hotspots for ecological security in China. The
   implications for the international society were further discussed,
   including the potential application of the L-V symbiosis model in
   government performance evaluation, inclusive policies on ecological
   conservation and economic development in the developing countries, as
   well as a long-term dynamic perspective on ecological-economic
   relationship.},
