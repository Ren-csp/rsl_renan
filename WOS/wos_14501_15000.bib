@incollection{ WOS:001664919300017,
Author = {Rastrick, Olafur},
Editor = {Guomundsdottir, G and Savolainen, U},
Title = {Emplaced Memories in the Urban Landscape},
Booktitle = {MEMORY STUDIES IN THE NORDIC COUNTRIES: A Handbook},
Series = {Handbook Series in Memory Studies},
Year = {2026},
Volume = {1},
Pages = {405-428},
Abstract = {This chapter examines the application of sensory ethnographic methods to
   explore the interplay between place and memory in everyday urban
   settings. It is part of a larger project focused on how residents of
   Reykjavik, Iceland, ascribe meaning and value to the historic landscape
   of the city center. This research expands beyond studies of designated
   heritage sites by encompassing any aspect of the urban environment with
   personal significance. The focus is on how sensory experiences and
   emotional engagements with the city's materiality shape individuals'
   understanding of the urban terrain. The ethnographic methods employed
   include solitary self-led walks with audiovisual recording glasses,
   walk-alongs, and photo-assisted group sessions, all used in seeking
   access to the nuanced interactions between individuals and their
   everyday environment. The chapter details the application of these
   methods and the insights they facilitate. It then presents findings that
   demonstrate how the self-identified locals who participated in the study
   engaged with various everyday places in the city center through acts of
   place-specific reminiscence. The interplay between memory, materiality,
   and sensory experience in shaping people's perceptions of the urban
   environment is highlighted, suggesting that acts of remembering are
   significant in fostering a sense of place attachment and belonging in
   the city.},
