@article{ WOS:001814620700002,
Author = {Valdes-Rodriguez, Lany and Rau, Jaime R. and Medianero, Enrique and
   Barahona-Segovia, Rodrigo M.},
Title = {Alpha, Beta and Gamma diversities of the diurnal butterfly species
   assemblage in periurban parks of Panama City, Panama},
Journal = {REVISTA CHILENA DE ENTOMOLOGIA},
Year = {2026},
Volume = {52},
Number = {2},
Pages = {79-93},
Month = {APR-JUN},
Abstract = {Butterflies are widely recognized as sensitive bioindicators of habitat
   transformation, particularly in fragmented urban landscapes. In this
   study, we assessed alpha, beta, and gamma diversity of butterfly
   assemblages across four peri-urban parks in Panama City, while
   accounting for sampling completeness and testing the effect of park area
   on species richness. Sample-based rarefaction and extrapolation analyses
   were used to standardize sampling effort, complemented by non-parametric
   richness estimators (Chao2, Jackknife, and Clench). Compositional
   similarity among sites was evaluated using Jaccard and S \&
   oslash;rensen indices. A total of 142 species were recorded at the
   regional scale (gamma diversity), with consistent differences in alpha
   diversity among sites. Species accumulation curves approached asymptotic
   levels, indicating high sampling completeness. Rarefaction analyses
   confirmed that differences in species richness were not driven by
   sampling effort. Compositional similarity was moderate, revealing
   substantial species turnover among parks. The relationship between
   species richness and park area was positive but weak, suggesting that
   park size alone does not explain observed patterns. These findings
   highlight the importance of habitat heterogeneity and species turnover
   in shaping butterfly diversity in urban landscapes.},
