@article{ WOS:001864948000012,
Author = {Cisneros, Edison Fernando Chiriboga and Zulueta, Monica Angelina Perez
   and Mendez, Franklin Marcelo Mora and Placeres, Ismel Bravo},
Title = {Tourism and local development: residents' perceptions in a rural
   Ecuadorian community},
Journal = {REVISTA SAN GREGORIO},
Year = {2026},
Number = {SI},
Pages = {103-112},
Month = {AUG},
Abstract = {Tourism is recognized as a key strategy for generating foreign exchange
   and promoting economic development and has therefore been incorporated
   into the Sustainable Development Goals. This study aims to assess
   residents' perceptions of tourism as a tool for local development in El
   Laurel Parish, Guayaquil, Ecuador. A quantitative approach was adopted,
   using a descriptive-correlational design and non-probability convenience
   sampling, with a sample of 95 residents. Data were collected through a
   structured survey comprising sociodemographic variables and six
   dimensions of analysis-economic, sociocultural, environmental,
   technological, political, and tourism-related-distributed across 25
   items. The analysis, conducted using SPSS version 25, demonstrated
   adequate internal consistency of the instrument (alpha > 0.79). The
   results indicate a favorable perception of tourism development,
   particularly regarding the existence of local attractions and residents'
   acceptance of tourism projects. Correlational analysis identified
   significant relationships between the overall perception of tourism and
   the technological, political, and economic dimensions. The multiple
   linear regression model was statistically significant (R-2 = 0.663),
   explaining 66.3\% of the variance in the overall perception of tourism.
   The technological and political dimensions emerged as the most relevant
   predictors, highlighting their role in shaping the assessment of tourism
   as a strategy for local development.},
