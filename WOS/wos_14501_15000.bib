   Przemyslaw},
Title = {Population increase and synurbization of the yellow-necked
   mouseApodemus flavicollisin some wooded areas of Warsaw
   agglomeration, Poland, in the years 1983-2018},
Journal = {URBAN ECOSYSTEMS},
Year = {2021},
Volume = {24},
Number = {3},
Pages = {481-489},
Month = {JUN},
Abstract = {Studies on the contribution of the yellow-necked mouseApodemus
   flavicollisand of other vertebrates to the diet of the tawny owlStrix
   alucowere carried out in Warsaw (central Poland) in the years 1983-2018.
   The frequency of the yellow-necked mouse in owl pellets increased at the
   break of the 20th and 21st centuries, particularly in some woodlands in
   the peri-urban area of the agglomeration. In the second half of the
   first decade of the twenty-first century, this mouse species colonised a
   park in the city centre. The yellow-necked mouse may become an important
   competitor for the synurbic population of the striped field
   mouseApodemus agrarius.},
