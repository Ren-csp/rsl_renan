@article{ WOS:000955474400001,
Author = {Luetkemeier, Robert and Kraus, Ronja and Mbidzo, Meed and Hauptfleisch,
   Morgan and Liehr, Stefan and Blaum, Niels},
Title = {A Qualitative Exploration of Conflicts in Human-Wildlife Interactions in
   Namibia's Kunene Region},
Journal = {DIVERSITY-BASEL},
Year = {2023},
Volume = {15},
Number = {3},
Month = {MAR},
Abstract = {Wildlife numbers are declining globally due to anthropogenic pressures.
   In Namibia, however, wildlife populations increased with policy
   instruments that allow private ownership and incentivize their
   sustainable use. Antithetically, this resulted in increased resource
   competition between humans and wildlife and triggered conflicts among
   various stakeholder groups. This paper summarizes the results of a
   qualitative exploration of conflicts in wildlife management in Namibia's
   Kunene Region, adjacent to Etosha National Park. We conducted a workshop
   and expert interviews with stakeholders from relevant sectors. Our
   qualitative research sheds light on societal conflicts over wildlife
   that originate from diverging interests, livelihood strategies, moral
   values, knowledge holders, personal relations and views on institutional
   procedures. We frame our insights into conflicting human-wildlife
   interactions with theoretical concepts of social-ecological systems,
   ecosystem services and ecosystem disservices and open the floor for
   quantitative assessments. Overall, our results may present a suitable
   way of understanding biodiversity conflicts in a theoretical way.},
