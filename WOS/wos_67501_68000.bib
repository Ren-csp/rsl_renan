@article{ WOS:000863858500001,
Author = {Wesemann, Dalton G. and Wilson, Anna C. and Riley, Andrew R.},
Title = {Parental Cannabis Use, Negative Parenting, and Behavior Problems of
   Young Children},
Journal = {SUBSTANCE USE \& MISUSE},
Year = {2022},
