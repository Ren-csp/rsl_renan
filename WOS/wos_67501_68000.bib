@article{ WOS:001877279700001,
Author = {Zheng, Shuangshuang and Sigler, Thomas and Curry, Matthew and Loginova,
   Julia},
Title = {Class, property ownership, and migration: understanding Chinese property
   ownership in a transnational context},
Journal = {JOURNAL OF ETHNIC AND MIGRATION STUDIES},
Year = {2026},
Month = {2026 SEP 16},
Abstract = {This paper conceptualises property ownership among Chinese migrants in
   Australia as a class-making practice within transnational social space.
   This study draws primarily on 32 in-depth interviews conducted in
   Brisbane, supplemented by evidence from Sydney, Melbourne, and the Gold
   Coast. It applies a Bourdieusian framework to examine housing as a key
   site for accumulating and converting economic, social, cultural, and
   symbolic capital. The findings reveal differentiated yet interconnected
   capital logics between owner-occupiers and investors. Locational choices
   are shaped by socially constructed perceptions of place, mediated
   through ethnic networks that can reinforce spatial clustering. Access to
   property among migrants is mediated through uneven capacities for
   capital conversion across buyer groups and along the migrant life
   course. First-home buyers rely more on transnational capital flows,
   family support, and co-ethnic networks to convert economic, social, and
   cultural capital into market access. In contrast, more experienced
   investors show greater autonomy, drawing on accumulated embodied
   cultural capital and engaging directly with formal financial mechanisms.
   By foregrounding housing as a site of capital accumulation and
   conversion, the paper advances a relational understanding of class
   formation and differentiation among Chinese migrants in transnational
   contexts.},
