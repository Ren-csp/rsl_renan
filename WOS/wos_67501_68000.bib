@article{ WOS:001778074500001,
Author = {Samaan, Larissa and Tawil, Nour and Lustig, Mark and Rupp, Sophie and
   Kuhn, Simone and Ascone, Leonie},
Title = {Towards a multi-theory understanding of the salutogenic potential of
   landscapes},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {112},
Month = {JUN},
Abstract = {Background: Numerous theories have been proposed to explain positive
   psychological responses to landscapes, yet they are typically examined
   in isolation, and many have not been operationalized in a standardized
   rating format. Existing questionnaires also often mix descriptive,
   cognitive/attentional, and affective content levels, which makes it
   difficult to empirically distinguish landscape properties from the
   psychological effects they may evoke. Method: We used a unified rating
   format that integrates items from established landscape questionnaires
   with newly developed items based on theoretical accounts that have
   rarely been assessed in self-report tools (affordances, prospect-refuge,
   information processing, perceptual fluency). Affective response items
   were included to evaluate their empirical separability from landscape
   assessments on a self-report level. N = 300 lay participants rated 20
   landscape images on all items. Multilevel exploratory factor analysis
   was performed to (1) examine whether items derived from different
   theories cluster into empirically distinct latent dimensions, and (2)
   test whether landscape rating items and self-reported affective
   responses represent separate constructs. We then applied multilevel
   regression analyses to investigate how the derived landscape dimensions
   predict affective responses to the images. Results: In addition to
   replicating the factor structures of the established questionnaires, we
   found two new distinctive factors that reflected the theoretical
   dimensions `evolutionary accounts' and `visual qualities'. Affective
   response items loaded on different factors than the landscape rating
   items. All established as well as new scales were significant predictors
   of affective response ratings. Conclusion: Our findings provide an
   empirical basis for identifying underlying theoretical dimensions of
   visual landscape perception and clarify the distinction between ratings
   of landscape properties and of affective responses to landscapes. The
   newly identified dimensions may offer valuable perspectives for future
   research on psychological responses to landscapes and support more
   differentiated assessments of visually driven landscape effects.},
