@article{ WOS:000313871400043,
Author = {Yamanaka, Soichiro and Mehta, Sameet and Reyes-Turcu, Francisca E. and
   Zhuang, Fanglei and Fuchs, Ryan T. and Rong, Yikang and Robb, Gregory B.
   and Grewal, Shiv I. S.},
Title = {RNAi triggered by specialized machinery silences developmental genes and
   retrotransposons},
Journal = {NATURE},
Year = {2013},
Volume = {493},
