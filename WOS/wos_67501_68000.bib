@article{ WOS:000438684200009,
Author = {Cho, Sunglim and Lee, Hyang-Mi and Yu, I-Shing and Choi, Youn Soo and
   Huang, Hsi-Yuan and Hashemifar, Somaye Sadat and Lin, Ling-Li and Chen,
   Mei-Chi and Afanasiev, Nikita D. and Khan, Aly Azeem and Lin, Shu-Wha
   and Rudensky, Alexander Y. and Crotty, Shane and Lu, Li-Fan},
Title = {Differential cell-intrinsic regulations of germinal center B and T cells
   by miR-146a and miR-146b},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {JUL 16},
Abstract = {Reciprocal interactions between B and follicular T helper (Tfh) cells
   orchestrate the germinal center (GC) reaction, a hallmark of humoral
   immunity. Abnormal GC responses could lead to the production of
   pathogenic autoantibodies and the development of autoimmunity. Here we
   show that miR-146a controls GC responses by targeting multiple CD40
   signaling pathway components in B cells; by contrast, loss of miR-146a
   in T cells does not alter humoral responses. However, specific deletion
   of both miR-146a and its paralog, miR-146b, in T cells increases Tfh
   cell numbers and enhanced GC reactions. Thus, our data reveal
   differential cell-intrinsic regulations of GC B and Tfh cells by
   miR-146a and miR-146b. Together, members of the miR-146 family serve as
   crucial molecular brakes to coordinately control GC reactions to
   generate protective humoral responses without eliciting unwanted
   autoimmunity.},
