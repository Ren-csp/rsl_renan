@article{ WOS:001840443300001,
Author = {Kang, Daein and Kim, John D. and Thu, Moe Kyaw and An, Brian Y.},
Title = {How national nuclear energy plans frame small modular reactors (SMRs):
   evidence from natural language processing of global policy documents},
Journal = {ENVIRONMENTAL RESEARCH LETTERS},
Year = {2026},
Volume = {21},
Number = {15},
Month = {AUG 14},
Abstract = {Conventional nuclear power plants continue to face persistent challenges
   related to public safety perceptions, siting constraints, and water
   requirements, particularly in or near urban areas. In this context,
   small modular reactors (SMRs)-characterized by their smaller scale,
   modular construction, and enhanced passive safety features-have emerged
   as a promising alternative. This study examines how SMRs are framed in
   national energy policy documents by analyzing the discursive contexts
   surrounding SMR-related keywords. Specifically, we extract and analyze
   300-word windows before and after each keyword occurrence, yielding
   approximately 800 000 words of policy text from 66 national and
   international energy plans spanning eight countries. Using natural
   language processing techniques, we find that policy discourse is
   dominated by discussions of reactor design, regulation, licensing, and
   safety, while broader techno-socioeconomic dimensions receive
   comparatively limited attention. Themes such as urban-rural equity,
   energy portfolio diversification, cogeneration, and climate resilience
   appear only sporadically and rarely shape the dominant policy narrative.
   These findings suggest that SMRs are framed primarily as technological
   innovations rather than as integral components of broader urban energy
   transitions. Our analysis implies that broadening national policy
   discourse to more fully incorporate social, spatial, and governance
   considerations will be essential for evaluating the potential
   contributions of SMRs to future urban energy systems.},
