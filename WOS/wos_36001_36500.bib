@article{ WOS:001712819300001,
Author = {Gole, Nigussie Boko and Kuris, Birhanu Kebede and Gemeda, Dessalegn Obsi},
Title = {Pastoral and agropastoral community perception of climate change,
   adaptation strategies and determinant of the choice of adaptation
   strategies in Guji zone, southern Ethiopia},
Journal = {PROGRESS IN DISASTER SCIENCE},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Climate change significantly threatens the livelihoods of pastoral and
   agropastoral communities. Therefore, it is crucial to assess the extent
   of community perception of climate change and factors that influence
   communities to choice adaptation strategies in pastoral and agropastoral
   areas. A sample of 328 households were interviewed using a
   cross-sectional design. Additionally, four focused group discussions
   (FGDs) and ten key informant interviews (KIIs) were conducted to
   validate the results of household surveys. Multivariate probit (MVP)
   model was employed to identify factors that influence pastoral and
   agropastoral community to choice climate change adaptation strategies.
   Results show that experiences of drought and water scarcity
   significantly determined climate change adaptation strategies. Results
   revealed that climate change contributes to grazing land quality
   deterioration or decline (91\%), reduced crop yields (65\%), livestock
   mortality (77.8\%), water scarcity (72\%), and forced migration
   (40.7\%). These problems aggravated by unpredictable rainfall, rising
   temperatures, and climate extremes mainly droughts. The study shows that
   mobility, use of water pumps, herd diversification, and splitting
   herds/enclosures were the major climate change adaptation options. There
   is an urgent need for policy intervention to develop early warning
   systems for pastoral and agropastoral communities.},
