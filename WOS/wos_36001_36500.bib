@article{ WOS:000284384900017,
Author = {Singh, Anita and Agrawal, Madhoolika and Marshall, Fiona M.},
Title = {The role of organic vs. inorganic fertilizers in reducing
   phytoavailability of heavy metals in a wastewater-irrigated area},
Journal = {ECOLOGICAL ENGINEERING},
Year = {2010},
