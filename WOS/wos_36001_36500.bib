@article{ WOS:000351351000023,
Author = {Kim, Kyung Won},
Title = {Optical Properties of Size-Resolved Aerosol Chemistry and Visibility
   Variation Observed in the Urban Site of Seoul, Korea},
Journal = {AEROSOL AND AIR QUALITY RESEARCH},
