Title = {The perception of family farmers of Programa de
   Aquisicao de Alimentos (PAA) on the meaning of
   being part of PAA and their understanding of concepts related to food,
   nutrition and health},
Journal = {SAUDE E SOCIEDADE},
Year = {2016},
