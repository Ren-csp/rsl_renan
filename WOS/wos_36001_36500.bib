@article{ WOS:001594764300001,
Author = {Osman, Fatma O. and Ibrahim, Yasser and Mahmoud, Ehab H. and Mahdy,
   Mohamed M.},
Title = {Investigating the socio-environmental aspects of decarbonization and
   energy efficiency in Egypt},
Journal = {DISCOVER ENVIRONMENT},
Year = {2025},
Volume = {3},
Number = {1},
Month = {SEP 11},
Abstract = {Global ambitions to mitigate climate change are dependent on the
   decarbonization of our built environments. Despite the commitment to
   adopt mitigation measures, Egypt's global CO2 emissions signify an
   inadequacy of stringent climate policies and actions. This paper aims to
   examine the efficacy of decarbonization policies and/or endeavors in
   Egypt, with a special emphasis on public awareness, air quality
   perception, individual and organizational behaviors. It also aims to
   shed light on the barriers/shortfalls that prevent low-carbon and
   energy-efficient practices from being implemented, and the actions
   needed in Egypt. The empirical study is conducted via a survey
   questionnaire of 94 participants, where the software package SPSS is
   used for statistical analysis. The inferred statistics reveal
   differences in the level of awareness according to age, education level
   and specialization. Also, significant differences in ratings of indoor
   and outdoor air quality with regards to participants' location and type
   of residence are highlighted. Ratings of outdoor air quality in recently
   constructed cities, particularly those residing villas, are shown higher
   than in more dense regions, for all other apartment types. Ratings of
   indoor air quality are shown higher in private than in public
   institutions, being outdoor air quality in both shown unhealthy.
   financial constraints are shown at top of the barriers that prevent
   achieving decarbonization in Egypt, urging for economic development.},
