@article{ WOS:001155230500004,
Author = {Rindel, Diego D. and Cobos, Virginia A. and Gordon, Florencia},
Title = {An ecological-evolutionary perspective of the physiological adaptation
   of inland Patagonian human populations: body size and energy
   requirements},
Journal = {INTERSECCIONES EN ANTROPOLOGIA},
Year = {2023},
Volume = {24},
Number = {1},
Pages = {41+},
Month = {JAN-JUN},
Abstract = {The processes of energy capture and expenditure have implications for
   individuals' life histories, demographic patterns, and settlement
   systems. Body size is impacted by energetic factors that influence
   everything, from physiological processes to ecological relationships,
   and is related to trophic strategies, ranges of action, and types of
   resources consumed. The objectives of this paper are to explore
   Patagonian human populations from a physiological and ecological
   perspective, linking the demands and limits imposed by metabolism to the
   available resources. Based on published data on height and body mass of
   Patagonian populations, maintenance costs were estimated from the
   calculation of basal metabolic rate, levels of physical activity, and
   environmental variables (i.e., latitude, altitude, rainfall, and
   temperature). Subsequently, these estimates were compared with the
   nutritional yield of various prey. The results indicate that Patagonian
   hunter-gatherers had a larger body size compared to other human groups.
   Likewise, people from southern Patagonia were heavier and taller than
   those from the north of the region. In southern Patagonia caloric
   requirements were higher but the availability of resources was lower,
   resulting in smaller populations.},
