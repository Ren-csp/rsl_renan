@article{ WOS:000330520500024,
Author = {Heikkila, Jaakko and Pouta, Eija and Forsman-Hugg, Sari and Makela,
   Johanna},
Title = {Heterogeneous Risk Perceptions: The Case of Poultry Meat Purchase
   Intentions in Finland},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2013},
Volume = {10},
Number = {10},
Pages = {4925-4943},
Month = {OCT},
Abstract = {This study focused on the heterogeneity of consumer reactions, measured
   through poultry meat purchase intentions, when facing three cases of
   risk. The heterogeneity was analysed by latent class logistic regression
   that included all three risk cases. Approximately 60\% of the
   respondents belonged to the group of production risk avoiders, in which
   the intention to purchase risk food was significantly lower than in the
   second group of risk neutrals. In addition to socio-demographic
   variables, the purchase intentions were statistically associated with
   several attitude-based variables. We highlighted some policy
   implications of the heterogeneity. Overall, the study demonstrated that
   risk matters to consumers, not all risk is equal, and consumer types
   react somewhat differently to different types of risk.},
Publisher = {MDPI AG},
Address = {POSTFACH, CH-4005 BASEL, SWITZERLAND},
