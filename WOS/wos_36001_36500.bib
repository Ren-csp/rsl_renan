@article{ WOS:001708514600001,
Author = {Jiang, Runzhou and Feng, Wei and Ning, Jiajun},
Title = {Do institutional factors influence the opportunities for social
   organizations to participate in community governance? An empirical study
   based on Guangdong, Hunan and Qinghai provinces},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {1},
Pages = {234-250},
Month = {MAR},
Abstract = {The modernization of community governance is a vital component of the
   broader evolution of national governance. The engagement of social
   organizations in urban community governance not only embodies the
   principles of co-governance and collaborative social governance but also
   serves as a fundamental requirement and essential foundation for the
   modernization of national and social governance. Scholars have analyzed
   the challenges faced by social organizations from various theoretical
   perspectives. The ``state-society{''} relationship emphasizes the
   macro-structural environment and the delineation of power between
   governments and social organizations. The ``activist{''} perspective
   investigates the strategies employed by social organizations to secure
   developmental space, while the individualistic perspective examines how
   internal capacity and external communication influence participation in
   governance. Utilizing survey data from Guangdong, Hunan, and Qinghai
   provinces, this study reveals that both formal factors, such as legal
   frameworks, regulatory systems, and supportive structures, as well as
   informal factors, such as community awareness and the recognition of
   social organizations by both government and residents, positively and
   significantly impact opportunities for participation. The findings
   indicate that the current level of participation opportunities for
   social organizations is relatively basic, underscoring the necessity to
   further enhance the institutional environment to improve their
   engagement in community governance. To bolster participation, formal
   systems should be reinforced through expedited legislation, optimization
   of regulatory frameworks, and the promotion of the healthy functioning
   of social organizations. Concurrently, informal systems should be
   enhanced by cultivating community awareness, increasing government
   recognition, and reshaping residents' perceptions of social
   organizations.},
