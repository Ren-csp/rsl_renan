Author = {Papamichael, Iliana and Chatziparaskeva, Georgia and Voukkali, Irene and
   Pedreno, Jose Navarro and Jeguirim, Mejdi and Zorpas, Antonis A.},
Title = {The perception of circular economy in the framework of fashion industry},
