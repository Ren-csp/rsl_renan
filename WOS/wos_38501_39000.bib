@article{ WOS:001812427600001,
Author = {Lenk-Ostendorf, Ben and Thaller, Annina and Brudermann, Thomas and
   Krusche, Stephan},
Title = {Decoding climate policy acceptance: contrasting the influence of
   simulation and text-based information},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {8},
Number = {7},
Month = {JUL 1},
Abstract = {The effective implementation of necessary climate policies depends on
   how well they are accepted by the public. While it is known that
   acceptance rates of ambitious policies are influenced by their perceived
   effectiveness, it remains unclear if and how different communication
   strategies influence public acceptance. This study examined the extent
   to which participants' acceptance of an effective climate policy can be
   increased, which variables moderate this increase, and which
   communication strategies most effectively promote it. We conducted a
   pre-registered randomized controlled trial with 462 participants
   comparing plain text information with an interactive simulator
   (En-ROADS). Participants' (i) knowledge of policy effectiveness, (ii)
   perception of policy effectiveness, and (iii) policy acceptance were
   assessed before and after the interventions. The trial focused on
   policies for improving the CO2 certificate system and for decreasing
   methane emissions (e.g. by reducing animal farming). Both communication
   strategies increased participants' knowledge of policy effectiveness,
   which in turn enhanced their perception of policy effectiveness and
   policy acceptance. However, the En-ROADS simulation did not outperform
   plain text in increasing knowledge or acceptance, suggesting that
   simple, text-based communication can be as effective as more complex
   simulation tools. Future research should explore how to foster people's
   knowledge of policy effectiveness in time-constrained learning
   environments.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
