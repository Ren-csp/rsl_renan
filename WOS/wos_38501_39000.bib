@article{ WOS:001676722700003,
Author = {Torello-Viera, Natalia Ferreira and Banci, Karina Rodrigues da Silva and
   Garey, Michel Varajao},
Title = {Herpetological Rediscovering a caecilian in the largest megalopolis of
   South America: an unexpectedly abundant population of Luetkenotyphlus
   brasiliensis},
Journal = {HERPETOLOGICAL JOURNAL},
Year = {2026},
Volume = {36},
Number = {1},
Pages = {18-26},
Month = {JAN},
Abstract = {Living caecilian are apodal amphibians that present mainly fossorial and
   secretive habits, making the usual sampling methods ineffective.
   Therefore, data on the species and their ecology are scarce. In the
   Atlantic Forest, there are only 13 species, and anecdotal information is
   available for just three. The Metropolitan Region of S \& atilde;o Paulo
   is highly fragmented, resulting in local extinction of several species.
   The first record of caecilians on S \& atilde;o Paulo, the largest
   megalopolis in South America, was in 1905, whereas the last record dates
   back to 1960. Herein, we report the discovery a Luetkenotyphlus
   brasiliensis population at Parque da Previd \& ecirc;ncia, a small urban
   park in S \& atilde;o Paulo, with vegetation in the primary stage of
   succession. This park is the smallest Atlantic Forest remnant housing
   caecilians, and surprisingly, it shows the third largest relative
   abundance of individuals ever registered in this forest fragments for
   species conservation.},
