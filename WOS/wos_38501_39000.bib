@article{ WOS:000450127300014,
Author = {Saraiva Piekas, Andrezza Aparecida and Bernardy, Regis Juarez and
   Sehnem, Simone and Fabris, Juliana},
Title = {Legal aspects and perceptions on strategies for smart and creative
   cities: study of the municipality of Chapeco (SC)},
Journal = {URBE-REVISTA BRASILEIRA DE GESTAO URBANA},
Year = {2018},
Volume = {10},
Number = {1},
Pages = {197-211},
Month = {NOV},
Abstract = {The Brazilian cities have undergone an economic development boost from
   the intensification of the globalization process that contributed to
   pulverization of economic activities beyond the large urban centers. The
   municipality of Chapeco, Santa Catarina state, a regional hub that has
   an urban network centered on small municipalities, is included in this
   context Under the perspective of dynamization of economic activities,
   the objective of this study was to verify the legal aspects and the
   point of view of leaderships on the perspective of formation of a smart
   and creative city. The contributions of the present study are associated
   with analysis of the formation process of Chapeca as a smart and
   creative city. This qualitative case study included analysis of
   municipal legal documents combined with content analysis of interviews
   with community leaders and of local entities. The results showed that
   Chapeco presents guidelines for creating a smart and creative city;
   however, the transition to this type of city is embryonic, and
   structural, cultural, social, economic, institutional and environmental
   demands still need to be met.},
