@article{ WOS:000844022700001,
Author = {Rubin, Nina Berlin and Wong-Parodi, Gabrielle},
Title = {As California burns: the psychology of wildfire- and wildfire
   smoke-related migration intentions},
Journal = {POPULATION AND ENVIRONMENT},
