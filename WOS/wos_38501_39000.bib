@article{ WOS:001847246600001,
Author = {Song, Wei},
Title = {Analysis on the Application of Sanda Practical Teaching in Special
   Environments},
Journal = {INTERNATIONAL JOURNAL OF MOBILE AND BLENDED LEARNING},
Year = {2026},
Volume = {18},
Number = {1},
Abstract = {In this study, aiming at the problems of simulation difficulty and
   feedback lag of Sanda training in special environment, an intelligent
   teaching mode integrating VR simulation and intelligent perception is
   constructed. Sixty Sanda students were randomly divided into
   experimental group and control group and received eight weeks of
   intelligent intervention (including Unity 3D VR environment and IMU/PPG
   data-driven ``personal ability portrait{''}) or traditional training.
   The results showed that the comprehensive actual combat evaluation value
   of the experimental group was significantly higher (0.85 vs. 0.75, p <
   0.001), and the application of technology, psychological adjustment, and
   environmental adaptability were improved by more than 20\%; Punch speed
   up arrow 15.3\%, decision delay down arrow 27.1\%, PLI down arrow
   25.8\%, VR-reality behavior consistency r = 0.83. The coach reported
   that the individual guidance time was saved by 38.9\%, and 73\% of the
   students took the initiative to consult the data. This model effectively
   improves actual combat ability and teaching efficiency.},
