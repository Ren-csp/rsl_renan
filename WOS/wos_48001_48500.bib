@article{ WOS:000438442700008,
Author = {Albright, Elizabeth A. and Crow, Deserai A.},
Title = {Learning processes, public and stakeholder engagement: Analyzing
   responses to Colorado's extreme flood events of 2013},
Journal = {URBAN CLIMATE},
Year = {2015},
Volume = {14},
Number = {1, SI},
Pages = {79-93},
Month = {DEC},
Abstract = {In early fall of 2013 in the Front Range of Colorado, several
   communities experienced intense rainfall over a three-day period,
   exceeding annual average precipitation rates. Extensive damage occurred
   to roads, infrastructure, parks, river corridors, homes and business
   throughout the region. Across the U.S. and in other nations, as
   population increases in flood-prone areas, flood risks and vulnerability
   are increasing as well. Successful response to extreme events may be due
   to policy learning-changes of beliefs, attitudes, behaviors, and goals -
   in response to new information and experiences. This learning can at
   times lead to adaptation of local policies to increase the resilience of
   communities faced with risk from extreme events. The extent of policy
   learning may depend on how communities engage with stakeholders and the
   public in post-disaster recovery. Using a comparative in-depth case
   study approach of seven Colorado communities, this study examines how
   communities actively engage stakeholders and the public in decision
   processes after an extreme event. (C) 2015 Elsevier B.V. All rights
   reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Albright, EA (Corresponding Author), Duke Univ, Nicholas Sch Environm, 9 Circuit Dr,Box 90328, Durham, NC 27708 USA.
   Albright, Elizabeth A., Duke Univ, Durham, NC 27708 USA.
   Crow, Deserai A., Univ Colorado Boulder, Boulder, CO USA.},
DOI = {10.1016/j.uclim.2015.06.008},
ISSN = {2212-0955},
Keywords = {Extreme events; Extreme flooding; Policy learning; Public engagement;
