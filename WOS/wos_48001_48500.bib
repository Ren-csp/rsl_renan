@article{ WOS:001146310900002,
Author = {Vera, Andrea and Ruiz, Cristina and Martin, Ana M.},
Title = {REACTIONS AGAINST FARM ANIMAL ABUSE: THE ROLE OF ANIMAL ATTITUDE AND
   SPECIESISM},
