@article{ WOS:001031418400001,
Author = {Soldal, Hanna and Murcia, Carles and Ouhammou, Ahmed and Hawkins, Julie
   A. and Martin, Gary J. and Puri, Rajindra K. and Teixidor-Toneu, Irene},
Title = {Plant Names Encode Taslhit Knowledge of Morocco's High Atlas Landscapes},
