@article{ WOS:000340192400005,
Author = {Forsyth, Ann and Oakes, J. Michael},
Title = {Cycling, the Built Environment, and Health: Results of a Midwestern
   Study},
Journal = {INTERNATIONAL JOURNAL OF SUSTAINABLE TRANSPORTATION},
Year = {2015},
Volume = {9},
Number = {1},
Pages = {49-58},
Month = {JAN-FEB},
Abstract = {Are cyclists different from those who do not cycle in terms of
   individual and neighborhood characteristics? This article draws on a
   study of over 700 adults in three groups: those who had cycled in the
   past week, in the past 2 years, and non-cyclists. It examines their body
   mass index (BMI), physical activity, sociodemographics, environmental
   perceptions, and geographic information system (GIS)-measured
   neighborhood features. Those who cycled occasionally lived in similar
   environments to frequent cyclists but perceived some aspects
   differently. Those who cycled more demonstrated characteristics
   generally thought to indicate good health, but they did not perceive
   themselves as healthier.},
