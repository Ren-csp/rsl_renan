@article{ WOS:A1995QB23800011,
Author = {EISNER, T and MEINWALD, J},
Title = {DEFENSE-MECHANISMS OF ARTHROPODS .129. THE CHEMISTRY OF SEXUAL SELECTION},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1995},
Volume = {92},
