@article{ WOS:000089878800007,
Author = {Pickworth, E},
Title = {Should local research ethics committees monitor research they have
   approved?},
Journal = {JOURNAL OF MEDICAL ETHICS},
Year = {2000},
Volume = {26},
Number = {5},
Pages = {330-333},
Month = {OCT},
Abstract = {The function of local research ethics committees is to consider the
   ethics of research proposals using human participants. After approval
   has been given, there is no comprehensive system in place to monitor
   research and ensure that recommendations are carried out. Some suggest
   that research ethics committees are ideally placed to fulfil this
   function by carrying our random monitoring of research they have
   reviewed. The health service guideline creating local research ethics
   committees is under review.(1) This paper suggests that increasing the
   monitoring role of ethics committees in the present climate would be
   inappropriate. This is due to the large workload of the committees,
   their voluntary nature and the change a monitoring rot might cause to
   the relationship between researcher and ethics committee which, might
   herald an increasing recourse to judicial review. A radical overhaul of
   the system would be necessary in order for ethics committees adequately
   to fulfil a monitoring function.},
Publisher = {BMJ PUBLISHING GROUP},
