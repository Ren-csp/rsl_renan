@article{ WOS:001816919000006,
Author = {Jessulat, Matthew and Phanse, Sadhna and Aoki, Hiroyuki and Broderick,
   Kirsten and Zhang, Qingzhou and Castro, Ines Gomes and Novales, Noelle
   Alexa and Hossain, Sakib Abrar and Saccon, Tatiana and Moutaoufik,
   Mohamed Taha and Joseph, Thomson Patrick and Amin, Shahreen and Hoell,
   Larrisa and Minic, Zoran and Bykov, Yury and Preminger, Noga and Crespo,
   Sahily Gonzalez and Snider, Jamie and Golshani, Ashkan and Stagljar,
   Igor and Rodriguez-Medina, Jose R. and Clarke, Catherine F. and
   Schuldiner, Maya and Babu, Mohan},
Title = {Global mitochondrial connectivity map reveals the landscape of yeast
   functional assemblies and conserved protein communities},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 5},
Abstract = {Mitochondria are essential organelles whose functions depend on
   coordinated multiprotein complexes, yet their composition and
   organization remain incomplete. Here, we present a large-scale map of
   mitochondrial protein complexes by integrating affinity purification of
   740 endogenously GFP-tagged mitochondrial proteins with biochemical
   co-fractionation of mitochondrial extracts from yeast (Saccharomyces
   cerevisiae) grown under respiratory conditions. Mass spectrometry
   identifies 13,716 high-confidence protein associations and defines 556
   heteromeric complexes, many previously unknown. These assemblies reveal
   factors involved in coenzyme Q6 biosynthesis, membrane contact sites,
   phospholipid transport, and coordination with the MICOS complex during
   respiration. We further link 538 assemblies to 294 candidate human
   disease genes and construct a conservation map of 852,146 predicted
   mitochondrial interactions across 271 genomes, and validate key
   predictions in human cell lines and mouse brain tissue. Together, this
   work provides a comprehensive mitochondrial interactome, assigning
   functions to poorly characterized proteins, and offering insights into
   mitochondrial biology and disease-associated assemblies.},
