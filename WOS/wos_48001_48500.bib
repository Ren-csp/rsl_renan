@article{ WOS:000384173600001,
Author = {Moreira, Fernanda de Lima and Habenschus, Maisa D. and Barth, Thiago and
   Marques, Lucas M. M. and Pilon, Alan Cesar and Bolzani, Vanderlan da
   Silva and Vessecchi, Ricardo and Lopes, Norberto P. and de Oliveira,
   Anderson R. M.},
Title = {Metabolic profile and safety of piperlongumine},
Journal = {SCIENTIFIC REPORTS},
Year = {2016},
Volume = {6},
Month = {SEP 29},
Abstract = {Piperlongumine (PPL), a natural plant product, has been extensively
   studied in cancer treatment going up on clinical trials. Since the first
   report related to its use on cancer research (in 2011) around 80 papers
   have been published in less than 10 years, but a gap still remaining.
   There are no metabolism studies of PPL in human organism. For the lack
   of a better view, here, the CYP450 in vitro oxidation of PPL was
   described for the first time. In addition, the enzymatic kinetic data,
   the predicted in vivo parameters, the produced metabolites, the
   phenotyping study and possible piperlongumine-drug interactions in vivo
   is presented.},
Publisher = {NATURE PORTFOLIO},
