@article{ WOS:000354739600001,
Author = {Yang, Chih-Yun},
Title = {STUDY ON THE INTERACTION BETWEEN THE FOOD AND BEVERAGE SERVICESCAPE AND
   CUSTOMER WAITING EXPERIENCE},
Journal = {REVISTA INTERNACIONAL DE SOCIOLOGIA},
Year = {2014},
Volume = {72},
Number = {2},
Pages = {9-22},
Month = {NOV},
Abstract = {Past research on the customer waiting experience tended to focus on two
   primary areas, namely managing the wait and managing the perception of
   the wait. Very few studies conducted in-depth analysis and discussion of
   how external environmental factors affect the experience of customer
   waiting, which it was also viewed as a negative factor that decreases
   customer satisfaction toward service. However, in reality, the waiting
   experience can be positive as a result of certain environmental factors,
   and subsequently increases customer satisfaction toward the service.
   This study aimed to further examine the potential influencing factors
   arising from the servicescape during the customer waiting process, and
   the interaction between the servicescape and customers during their wait
   time. This paper is based on the causal feedback loop. A system dynamics
   perspective was applied to construct a conceptual systems model showing
   the interaction between the servicescape and the customer waiting
   experience.},
