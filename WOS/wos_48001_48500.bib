@article{ WOS:000390702700003,
Author = {Gugganig, Mascha},
Title = {The Ethics of Patenting and Genetically Engineering the Relative Hloa},
Journal = {ETHNOS},
Year = {2017},
Volume = {82},
Number = {1},
Pages = {44-67},
Month = {FEB},
Abstract = {This article investigates the patenting and genetic engineering of the
   plant taro (Colocasia esculenta), which Native Hawaiians consider their
   elder brother and ancestor Hloa. It explores how molecular scientists at
   the University of Hawaii through their research activities inadvertently
   disrupted this relationship and concurrently provoked a resurgence of
   Native Hawaiians' interest in their creation story Kumulipo and
   connection to their kin Hloa. The juxtaposition of purportedly
   value-free scientific practices with a value-laden indigenous
   epistemology exposes the former's debatable characterisation as
   objective'. Scientific practices such as patenting or genetically
   engineering taro are discussed as hybrids that are composed of molecular
   scientists with real intentions; a plant as kin, ancestor and embodied
   god Kne; and an indigenous people with real kinship to a non-human
   being. In consequence, the described case exemplifies how scientific
   practices are as malleable and situated as the concept of nature, while
   both concurrently shape each other.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
