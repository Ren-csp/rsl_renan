@article{ WOS:001736113200001,
Author = {Santoianni, Lucia Antonietta and Barni, Elena and Bouvet, Daniela and
   Carranza, Maria Laura and Celesti-Grapow, Laura and Citterio, Sandra and
   Cogoni, Annalena and Finizio, Michele and Gentili, Rodolfo and Lozano,
