@article{ WOS:001589117700001,
Author = {Santhi, Syamili Manoj and Takala, Tuomo and Korrensalo, Aino and Lovric,
   Natasa and Tikkanen, Jukka and Tuittila, Eeva-Stiina},
Title = {Influence of human-forest relationships on perceived happiness in
   Finland},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {11},
Pages = {3017-3035},
Month = {NOV},
Abstract = {The social functions of forest resources must be acknowledged for
   effective forest management, given the environmental challenges facing
   humanity. The current study assessed the dimensions of human-forest
   relationships that influence perceived happiness of people. We focused
   on Finland, where an industrialised forest-based market economy coexists
   with a widespread cultural appreciation of forests. We conducted a
   web-based national questionnaire survey to collect data on human-forest
   relationships that influence perceived happiness in Finland. We explore
   the contribution of forest exposure, engagement, characteristic of
   human-forest bond such as biophilic values, and cultural ecosystem
   services to forest happiness in Finland. Finnish forest happiness
   appeared to have three main dimensions: (i) the bond to natural-like
   forests through values raised from the experienced connection with
   nature (i.e. biophilic values), (ii) utilitarian forest engagements and
   (iii) forest exposure. Although both forest bond and forest engagements
   contributed to eudaimonic happiness, only utilitarian engagements and
   managed forest environment contributed to hedonic happiness. Eco-anxiety
   has formed an elemental part of the bond to natural-like forests,
   indicating that this dimension of Finnish forest happiness can also
   reduce perceived happiness. Among the respondents, the happiness of
   hunters and men was correlated with utilitarian engagements and managed
   forests, and the happiness of women was more strongly associated with
   the bond to natural-like forest. The happiness of those adults who now
   or in their childhood lived in the countryside was related to
   utilitarian forest engagements and managed forest environments. The
   lived forest experiences and cultural background shape how people
   perceive forests and which aspects contribute most to their forest
   happiness. Our finding on the importance of cultural contexts and
   personal values in shaping the human-forest relationship emphasises the
   integration of cultural perspectives in forest management and
   conservation efforts, in addition to economic and ecological aspects. As
   people appeared to exist on a spectrum between anthropocentric and
   ecocentric views, forest policies should provide opportunities for all
   kinds of forest relationships and forest happiness in their living
   environment.Read the free for this article on the Journal blog.
   Metsien sosiaalisten toimintojen huomioiminen on oleellista, kun
   pohditaan metsien roolia ihmiskunnan kohtaamissa ymp \& auml;rist \&
   ouml;haasteissa. T \& auml;ss \& auml; ty \& ouml;ss \& auml; tutkimme
   niit \& auml; ihmisen ja mets \& auml;n v \& auml;listen suhteiden
   ulottuvuuksia, jotka vaikuttavat ihmisten koettuun onnellisuuteen.
   Keskityimme Suomeen, jossa teollistunut markkinatalous el \& auml;\&
   auml; rinnakkain metsien laajan kulttuurisen arvostuksen kanssa.
   Toteutimme kansallisen verkkokyselyn ihmisen ja mets \& auml;n suhteista
   Suomessa. Kysyimme, miten mets \& auml;altistus, toiminta mets \&
   auml;ss \& auml; sek \& auml; erilaiset ihmisen luontosuhteen piirteet,
   kuten metsiin liittyv \& auml;t arvot ja metsien tarjoamat kulttuuriset
   ekosysteemipalvelut vaikuttavat koettuun mets \& auml;onnellisuuteen.
   Suomalaisella mets \& auml;onnellisuudella n \& auml;ytti olevan kolme p
   \& auml;\& auml;ulottuvuutta: (i) ihmisen ja mets \& auml;n v \&
   auml;linen side, joka syntyy luontoyhteyden kokemiseen liittyvist \&
   auml; (biofiilisist \& auml;) arvoista, (ii) toiminta hoidetuissa mets
   \& auml;ymp \& auml;rist \& ouml;iss \& auml; ja (iii) mets \&
   auml;altistuksen m \& auml;\& auml;r \& auml;. Sek \& auml; biofiilinen
   side ett \& auml; toiminta hoidetuissa mets \& auml;ymp \& auml;rist \&
   ouml;iss \& auml; vaikuttivat koettuun eudaimoniseen onnellisuuteen,
   mutta vain j \& auml;lkimm \& auml;inen vaikutti koettuun hedonistiseen
   onnellisuuteen. Vastaajista mets \& auml;styst \& auml; harrastavien ja
   miesten onnellisuus korreloi positiivisesti hoidetuissa mets \& auml;ymp
   \& auml;rist \& ouml;iss \& auml; toimimisen kanssa. Naisten onnellisuus
   oli vahvemmin yhteydess \& auml; biofiilisiin arvoihin. Joko
   vastaamisehetkell \& auml; tai lapsuudessa maaseudulla tai kyl \&
   auml;keskuksissa asuneiden aikuisten onnellisuus liittyi yleisimmin
   toimintaan hoidetuissa mets \& auml;ymp \& auml;rist \& ouml;iss \&
   auml;. Kulttuuritaustoihin liittyv \& auml;t arvot muokkasivat siis
