@article{ WOS:000398524100054,
Author = {Addison, Clifton and Jenkins, Brenda W. Campbell and White, Monique and
   Henderson, Frances and McGill, Dorothy J. and Antoine-La Vigne, Donna
   and Payton, Marinelle},
Title = {Perception of Policy and Environmental Action to Promote Healthy
   Behaviors in African American Communities},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2017},
Volume = {14},
