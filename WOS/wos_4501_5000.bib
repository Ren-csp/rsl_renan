@article{ WOS:001780906700001,
Author = {Qiu, C. H.},
Title = {VEGETATION STRUCTURE AND PERCEIVED RESPONSES IN URBAN PARKS: A
   QUAANTITATIVE STUDY OF BEIJING},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {5407-5425},
Abstract = {Vegetation in urban parks provides key ecological functions, including
   improving air quality, regulating the microclimate, and mitigating the
   urban heat island effect. Through seasonal changes and community
   stratification, it also influences visitors' landscape experience and
   their evaluations of park use. Using Beijing, China as a case study, we
   integrate 574,459 social media reviews and remote sensing data from 114
   parks collected between 2014 and 2025. Using these data, we construct
   seven vegetation feature variables that describe quantity, proportion,
   and coverage. Ridge regression is employed to identify the importance of
   these vegetation features. The regression coefficients are then used to
   construct the Vegetation Ecological Structure Index (VESI), which
   quantifies the structural characteristics of vegetation in urban parks.
   The results indicate that trees and overall vegetation coverage are the
   primary contributors to ecological functions. In contrast, shrubs and
   groundcovers play a supportive role by enriching community structure and
   improving environmental quality at the neighborhood scale. Time series
   analysis indicates that the spring flowering season and the autumn
   foliage season are key periods when vegetation shapes public
   perceptions. These seasonal fluctuations not only structure the temporal
   rhythm of the landscape but also heighten the public's sensitivity to
   natural changes. The results reveal that the multidimensional
   characteristics of urban vegetation not only determine its ecological
   service capacity but also profoundly shape public affective perceptions.},
