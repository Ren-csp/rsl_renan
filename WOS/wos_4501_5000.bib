@article{ WOS:001785757700001,
Author = {Rivera, Elise and Deforche, Benedicte and Biggs, Nicole and Timperio,
   Anna and Veitch, Jenny},
Title = {Preferred park features for maximising park visitation, physical
   activity and social interaction among adults: A conjoint analysis},
Journal = {CITIES},
Year = {2026},
Volume = {176},
Month = {SEP},
Abstract = {Parks are underutilised by adults. Greater insights regarding the park
   features that are most likely to entice adults to visit parks and engage
   in physical activity and socialise are needed. This study identified
   what park features are most influential on adults' choice of park to
   visit, be active, and socially interact. Participants (n = 260, 44.8 +/-
   12.8 years, 50\% female) in Sydney and Melbourne, Australia completed a
   digital survey with Choice-Based Conjoint activities to identify the
   relative importance scores of park characteristics for influencing
   adults' choice of park to visit, be active and socially interact. The
   most preferred park feature for all outcomes was a feeling of safety
   from undesirable people. Good maintenance was the second most valued
   feature for visitation (16.0\%; 95\%CI = 14.5, 17.4) and socialising
   (14.5\%; 95\%CI = 12.4, 16.6). The second and third most valued features
   for encouraging park-based physical activity were paths for cycling or
   walking (15.5\%; 95\%CI = 13.8, 17.3) and toilets (13.7\%, 95\%CI =
   11.6, 15.9). For visitation, the third most preferred characteristic was
   a peaceful atmosphere (14.8\%; 95\%CI = 13.6, 15.9). Barbecue areas
   (13.6\%; 95\%CI = 11.7, 15.6) were the third most likely feature to
   encourage socialising. Part-worth utilities for the features indicated
   that the presence of park characteristics was favoured over their
   absence, and higher order feature levels were preferred (e.g., many
   shady trees were preferred over the absence of shady trees). Park
   planners should prioritise these most preferred features to ensure that
   parks cater to adults' preferences and encourage them to visit and
   engage in physical activity and social interaction.},
