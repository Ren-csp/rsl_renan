@article{ WOS:001759685500001,
Author = {Beckers, Caroline and Hook, Hannah and Cardon, Greet and Cheng, Long and
   Witlox, Frank},
Title = {Evaluating Ghent's built and social environment for age-friendly
   initiatives in activity-travel contexts},
Journal = {JOURNAL OF URBAN MOBILITY},
Year = {2026},
Volume = {9},
Month = {JUN},
Abstract = {Population ageing and increasing urbanisation challenge cities to
   develop age-friendly urban environments that support older adults'
   mobility, participation, and ability to age in place. Age-friendly urban
   planning strategies are guided by established policy frameworks, yet
   empirical insight into how older adults themselves prioritise
   neighbourhood interventions across different urban contexts remains
   limited. This study investigates older adults' perceptions of their
   living environment to inform more context-sensitive, age-friendly urban
   planning. Using survey data from older residents of Ghent, Belgium, this
   study analyses 1318 responses to the open-ended question: `What would
   you change in your living environment to better suit your needs?'. A
   mixed-methods approach was employed, combining Biterm Topic Modelling
   (BTM) and inductive thematic analysis. BTM was used to systematically
   identify overarching patterns in short textual responses, while thematic
   analysis enabled a deeper interpretation of meanings and contextual
   nuances. The topic model identified four interrelated domains: urban
   traffic dynamics (33.44 \%), public transport accessibility (27.41 \%),
   public space and maintenance (20.22 \%), and neighbourhood and social
   dynamics (18.92 \%). Thematic analysis further revealed 44 themes within
   these areas, with public space and maintenance, especially sidewalk
   conditions, emerging as a major concern. The findings highlight the
   importance of accessible transport, high-quality infrastructure, and
   active participation of older adults in urban planning. The study
   demonstrates how mobility operates across policy domains within
   agefriendly urban environments. Methodologically, it demonstrates the
   value of integrating computational and interpretive approaches to
   capture both scale and lived experience in research on ageing and urban
   mobility.},
