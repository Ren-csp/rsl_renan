@article{ WOS:001857641100001,
Author = {Ladreyt, Helena and Boiteux, Manon and Colinas, Juliette and Bouchard,
   Catherine and Braiden, Heather and Brodeur, Jacques and Bussiere,
   Frederic and Leclerc, Martin and Leighton, Patrick and Richard, Lucie
   and Rivard, Nathalie and Rocheleau, Jean-Philippe and Tej, Gabriel and
   Tremblay, Jean-Pierre and Turgeon, Katrine and Zinzser, Kate and
   Teitelbaum, Sara and Aenishaenslin, Cecile},
Title = {Acceptability of Wildlife Interventions to Protect Biodiversity and
   Human and Animal Health in Peri-Urban Nature Parks},
Journal = {ECOHEALTH},
Year = {2026},
Month = {2026 AUG 25},
Abstract = {Anthropogenic disturbances such as habitat fragmentation and climate
   change increasingly affect nature park ecosystems. In several Canadian
   peri-urban nature parks, these pressures contribute to ecological
   imbalances, including overabundant white-tailed deer populations and
   emerging tick-borne diseases. Wildlife management interventions can have
   different purposes such as biodiversity conservation and protection of
   animal health or human health, but the acceptability of some of them,
   like culling, can be controversial. This qualitative study explored
   factors influencing the acceptability of such interventions. Seven focus
   groups were conducted, involving 22 park users from six peri-urban
   nature parks in southeastern Qu \& eacute;bec, Canada. Discussions
   explored perceptions of current and potential wildlife interventions.
   Findings revealed that emotional connections to the park and its
   wildlife, concern for animal welfare, awareness of links between
   biodiversity, health and human behaviors, trust in science and
   management authorities, and transparent communication all influence
   acceptability. Participants showed a strong understanding of ecological
   issues and their connections to emerging health risks. Fostering
   understanding among the public and decision-makers, particularly
   regarding links between ecosystem imbalances and health, is crucial to
   improving the acceptability of wildlife interventions in peri-urban
   nature parks. Building on existing public awareness through transparent
   communication and proactive engagement by managers and scientists
   remains essential to building trust and supporting effective wildlife
   management to protect biodiversity and human and animal health.},
