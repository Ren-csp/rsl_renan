@article{ WOS:001630746800001,
Author = {Hao, Xiaofei and Wu, Mengchun and Zhang, Linghan},
Title = {Utopia on your doorstep? Proximity tourism and therapeutic landscape in
   urban park camping},
Journal = {TOURISM GEOGRAPHIES},
Year = {2026},
Volume = {28},
Number = {4},
Pages = {949-972},
Month = {MAY 19},
Abstract = {The rapid pace of urbanization has amplified environmental and social
   challenges, spurring urban residents to seek outdoor recreational
   activities for physical and mental well-being. This study explores how
   urban park camping in China, an increasingly popular form of proximity
   tourism, restores physical and mental health through these activities
   from the perspective of therapeutic landscapes. The findings reveal that
   urban park camping serves as a powerful and holistic therapeutic
   activity, addressing physical, spatial, social, and psychological needs.
   This research introduces the concept of proximate therapeutic
   landscapes, challenging the idea that restorative spaces must be
   distant. It identifies key place-making strategies, including functional
   anchoring, spatial personalization, and community embedding, that urban
   campers use to create meaningful, temporary environments. The study
   shows these short-term benefits are sustained long-term through repeat
   ritualization and social validation. The findings offer practical
   guidance for urban planners for enhancing parks, affirming their vital
   role in urban residents' well-being.},
