@article{ WOS:001871216100001,
Author = {Huang, Liwei and Kang, Ning and Wu, Zhengwang},
Title = {Assessing the spatial distribution pattern of urban green space and its
   association with the hypertension prevalence rate in Beijing: A study in
   perspective of health benefits},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {Urban green space (UGS) is an important component of urban landscape,
   the core of sustainable, ecological, livable and safe urban environment,
   and a key infrastructure supporting human health and well-being.
   Although its health benefits have been widely recognized, little is
   known about the relationship between the spatial distribution pattern of
   green spaces and health, especially in densely populated central urban
   areas. This study focuses on the central urban area of Beijing, relying
   on large health sample data, combined with green space information
   obtained from the GEE cloud platform, as well as data on air quality and
   socio-economic dynamics. Through statistical analysis, it reveals how
   the urban greenspace spatial pattern (UGSP) affects the hypertension
   prevalence rate (HPR). Research has shown that the morphology, spatial
   relationships, and spatial configurations of UGS exhibit significant
   imbalances, and there is a significant correlation and spatial
   correspondence between UGSP, HPR, and air quality. UGSP mainly
   indirectly affects residents' health through the mediating effect of air
   quality (CO), among which PLAND, AI, MPS, LPI, COHESION, and MSI play
   important roles. After integrating the above indicators, there are
   significant differences in HPR between sub-districts of different green
   space pattern categories. Therefore, based on the principle of equitable
   distribution, priority should be given to optimizing key pattern
   indicators in areas with weak green resource foundations. These findings
   and conclusions contribute to an understanding of the fairness of UGSP
   and will also guide future design and planning of UGS based on
   environmental health benefits.},
