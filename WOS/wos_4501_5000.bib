@article{ WOS:001825342200001,
Author = {Gomes, Alexandra and Luxmoore, Sara and Morley, Jeremy and Shaw, Robert
   and Goodwin, Iain},
Title = {More than green: Lessons for valuing green spaces for health and
   wellbeing},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {11},
Month = {DEC},
Abstract = {Understanding the value of urban green spaces for health and wellbeing
   has traditionally been guided by needs-based and services-based
   frameworks. However, these approaches have often struggled to capture
   the subjective experiences that shape how residents perceive and value
   green spaces, focusing primarily on objective, empirical and spatial
   dimensions. Drawing on surveys and interviews conducted across three
   differently sized parks in Haringey, London, this paper proposes a
   localised, human-centred approach to park valuation. Adapting the sense
   of place framework developed by Pretty et al. (2003), it examines how
   place attachment, sense of community and place dependence shape
   residents' experience of park value. Key findings highlight the
   distinction between use, need and value; the gap between resident
   perception and on-the-ground observation; and the tension between
   community agency and council provision. The surrounding environment also
   emerges as a significant factor beyond the park boundary, either
   enhancing or constraining access and use across diverse social groups.
   As a pilot study, the paper contributes to academic and policy
   discussions on green space valuation by highlighting the importance of
   localised evidence from residents and workers. It identifies park
   characteristics and contextual interventions that may support
   placemaking, reduce spatial inequalities, and positively influence
   health and wellbeing. It also proposes an indicative ranking of park
   characteristics as a practical starting point for park investment and
   policy prioritisation in resource-constrained settings.},
