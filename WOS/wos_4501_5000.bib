@article{ WOS:000652413400019,
Author = {Jimenez Caldera, Juan Eduardo and Durango Severiche, Gren Yohana},
Title = {Diagnosis and planning of urban public space. Participation of citizen
   users},
Journal = {BITACORA URBANO TERRITORIAL},
Year = {2021},
Volume = {31},
Number = {2},
Pages = {257-281},
Month = {MAY-AUG},
Abstract = {This article exposes the development of a spatial analysis focused on
   the diagnosis and planning of the public articulating, exchange and
   citizen meeting space existing in the Commune 2 of the city of Monteria.
   The data used comes from the voluntary participation of citizen users of
   spaces, through a web geoform implemented as a pilot test. Procedures
   and techniques were applied based on key analysis elements, which led to
   the conclusion that in this sector of the city there are no ideal
   conditions for the public space to be fully functional for the benefit
   of citizens. The results highlight the important role of the community
   as an active collaborator in urban planning processes, being a reliable
   and inexhaustible source of input data that support decision making.},
