@article{ WOS:001499626700002,
Author = {Suarez, Maria Jose Andrade and Garcia, Manuel Docampo and Leiras, Ana},
Title = {Sociological perspectives on urban green infrastructure: Identifying
   research gaps and advancing future directions},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2025},
Volume = {111},
Month = {SEP},
Abstract = {Sociology provides essential insights into the complex interactions
   between urban green infrastructures (UGIs) and society. However, despite
   increasing recognition of their social impacts, UGIs still lack a
   systematic sociological framework to uncover key trends and critical
   research gaps. This paper seeks to fill this gap by analyzing
   influential scientific sources at the intersection of sociology and
   UGIs. The methodology consists of a systematic literature review and
   bibliometric analysis of 436 scientific articles published in academic
   journals between 2001 and 2024. Data were extracted from Scopus and
   examined using ASReview, a machine-learning Python-based tool, and
   Bibliometrix, an RStudio-based software. The results reveal that while
   existing studies have extensively examined governance, policy, and
   equity-related aspects of UGIs, other areas remain underexplored. These
   include the religious, spiritual, and cultural uses of UGIs (e.g.,
   festivals, traditional events), their role in specific sectors such as
   tourism, and the projected and perceived image of UGIs, among others.
   The findings constitute a fundamental sociological guide for all UGIs'
   stakeholders.},
