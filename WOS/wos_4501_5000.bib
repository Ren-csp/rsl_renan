@article{ WOS:001561931000001,
Author = {Sittipong, Yuppared and Shibata, Shozo and Imanishi, Junichi},
Title = {The influence of policies on changing landscape hydro-ecological
   infrastructure in an urban area: a case study of Chiang Mai City,
   Thailand},
Journal = {LANDSCAPE AND ECOLOGICAL ENGINEERING},
Year = {2025},
Volume = {21},
Number = {4},
Pages = {895-919},
Month = {OCT},
Abstract = {The landscape and inhabitants of Chiang Mai have co-evolved through
   agricultural practices, particularly rice cultivation. The hydrological
   and topographic characteristics of the region have profoundly influenced
   the water-based culture of this area. However, urbanization is changing
   natural landscape structures and their functions, transforming suburban
   cultivated areas into residential areas. This shift has led to the
   degradation of the hydroecological infrastructure, natural waterway
   systems, and the relationship between water and people in the city. The
   conventional centralized approach to urban development plans has led to
   a lack of understanding of each location's unique natural
   characteristics and a disregard for the local landscape. This study
   examined land use and land cover (LULC) changes in the Chiang Mai urban
   area over the past three decades (1991-2022) based on satellite imagery,
   focusing on the crucial impact of land cover changes on flood risk
   management, and revealing the relationship between LULC changes and
   public policies related to the natural waterway system in urban areas by
   conducting a basic hydrological analysis. Our findings underscore the
   importance of preserving natural hydroecological networks as critical
   components of urban landscape infrastructure. This should be implemented
   in planning policies for each unique local context as well as part of
   the entire picture to effectively address urban hydrological issues such
   as urban flood risk. Restoring human-nature relations is crucial for
   local landscape planning and management.},
Publisher = {SPRINGER JAPAN KK},
Address = {SHIROYAMA TRUST TOWER 5F, 4-3-1 TORANOMON, MINATO-KU, TOKYO, 105-6005,
