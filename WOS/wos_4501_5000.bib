@article{ WOS:001841986000001,
Author = {Li, Zhiheng and Li, Jiajia and Liu, Yile and Zhang, Zhe and Kong,
   Xiangqi},
Title = {Spatiotemporal dynamics of urban park accessibility and
   demand-accessibility relationships in central Kunming: perspectives from
   multiple travel modes and dual-scale analysis},
Journal = {FRONTIERS IN FORESTS AND GLOBAL CHANGE},
Year = {2026},
Volume = {9},
Month = {JUL 24},
Abstract = {Introduction Under rapid urbanization, the misalignment between urban
   park accessibility and population demand has intensified concerns about
   environmental equity. However, few studies have examined the long-term
   spatiotemporal dynamics of urban park accessibility and population
   demand while accounting for multiple travel modes and spatial
   scales.Methods Taking central Kunming as a case study, this research
   integrated multi-source spatiotemporal data from 2010 to 2025.
   Dual-scale spatial analysis was conducted at both grid and subdistrict
   levels, and the three-step floating catchment area (3SFCA) method was
   applied to assess urban park accessibility under different travel modes.
   Based on these results, the study further examined accessibility
   inequality, spatial associations between population and accessibility,
   direct mismatch patterns, and the coupling trajectories between
   accessibility growth and population growth over time.Results The number
   of urban parks increased from 79 in 2010 to 254 in 2025, representing an
   increase of 221.5\%, while the total park area expanded from 2,501 ha to
   4,467 ha. Over the 15-year period, accessibility growth outpaced
   population growth in 58.49, 60.38, and 56.60\% of all subdistricts under
   walking, e-biking, and driving modes, respectively, although localized
   accessibility-deficit areas shifted geographically over time. In older
   urban areas such as Wuhua and Panlong, overall accessibility remained
   relatively low, but its distribution exhibited greater equity, partly
   due to the high density of pocket parks. By contrast, Guandu District
   and the surrounding urban-rural transition zones emerged as persistent
   areas of high population demand and localized accessibility deficits.
   Travel mode substantially influenced accessibility and equity patterns.
   Driving provided the broadest accessibility coverage, but higher
   mobility did not consistently correspond to fewer
   high-demand-low-accessibility areas. E-biking showed clear advantages in
   reducing such spatial mismatches in densely populated areas.Conclusion
   This study supports more refined and equitable urban park planning by
   integrating multimodal accessibility assessment with dual-scale
   analysis. It helps identify priority areas and guide targeted spatial
   interventions. Future urban park planning should move beyond aggregate
   expansion toward demand-responsive allocation that prioritizes
   accessibility-deficit areas based on actual population distribution and
   travel-mode conditions.},
