@article{ WOS:001232636300001,
Author = {Zhang, Zhongjun and Wang, Yaqian and Zhu, Dangwei},
Title = {Overheating in the Tree Shade of Urban Parks: A Field Study of Thermal
   Adaption in China},
Journal = {ATMOSPHERE},
Year = {2024},
Volume = {15},
Number = {5},
Month = {MAY},
Abstract = {With increased atmospheric temperature, temperatures in the shade of
   trees in parks also increase, and people are faced with high temperature
   challenges. In this study, thermal comfort in the shade of the trees of
   an urban park during summer in China was assessed. The subjective
   responses of the respondents were recorded via questionnaires, and
   environment parameters were measured. The results show that the air
   temperature in the shade was 31.1 +/- 3.0 degrees C during the day, and
   that it peaked at 36.9 degrees C; the globe temperature was 31.3 +/- 3.1
   degrees C, and it peaked at 40.1 degree celsius. Respondents' clothing
   insulation was 0.31 +/- 0.08 clo, and the effect of clothing adjustment
   on thermal adaptation was limited. Thermal sensation is linearly related
   to standard effective temperature (SET), and the upper limit of 80\%
   acceptable SET was 32.1 degrees C. At different temperature values, the
   proportion of expected airflow enhancement exceeded 50\%. The
   respondents preferred a neutral-warm sensation. Moreover, there was an
   obvious thermal adaptation, with thermal history and psychological
   adaptation being the main factors affecting thermal comfort. This study
   confirmed the value of shade and provided us with guidance for park
   planning and design.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Zhang, ZJ (Corresponding Author), Anyang Inst Technol, Sch Civil \& Architectural Engn, Anyang 455000, Peoples R China.
   Zhang, Zhongjun; Wang, Yaqian; Zhu, Dangwei, Anyang Inst Technol, Sch Civil \& Architectural Engn, Anyang 455000, Peoples R China.
   Wang, Yaqian, Univ Sains Malaysia, Sch Housing Bldg \& Planning, George Town 11800, Penang, Malaysia.},
DOI = {10.3390/atmos15050575},
Article-Number = {575},
