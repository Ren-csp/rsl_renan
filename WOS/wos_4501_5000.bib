@article{ WOS:001785008600001,
Author = {Jaworek-Jakubska, Justyna and Tymkow, Przemyslaw and Sobolewski, Robert
   Krzysztof and Krolik, Piotr},
Title = {Toward a Renewed Dialogue Between Heritage and Nature: Integrated
   Assessment of Visual Structures in the Książ Protected Landscape, Poland},
Journal = {HUMAN ECOLOGY},
Year = {2026},
Volume = {54},
Number = {3},
Month = {JUN 4},
Abstract = {We present the results of a four-year collaborative project involving
   researchers and agencies that manage the Pe \& lstrok;cznica Valley near
   Ksi \& aogon;\& zdot; Castle in southwestern Poland. The findings show
   that long-term historical inquiry clarifies the consequences of past
   land-use practices and the limits of passive conservation, while
   protecting scenic value can serve as common ground between heritage and
   nature conservation. We highlight the dynamic, context-dependent nature
   of visual relationships and underscore the need for flexible management,
   continuous monitoring, and durable cross-sector cooperation in protected
   landscapes. Integrating interdisciplinary knowledge, GIS-based analysis,
   and sustained stakeholder engagement strengthened collective
   interpretation and supported collaborative landscape learning. The
   combination of scientific, historical, and local expertise enabled the
   development of realistic strategies for restoring historic views while
   accounting for current formal, technical, and ecological constraints.},
