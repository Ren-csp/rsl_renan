@article{ WOS:001850645600001,
Author = {Ingi, Dmitrii and Pinho, Paulo and Bhusal, Pramod and Kytta, Marketta},
Title = {Examining public participation GIS (PPGIS) as a tool for collecting
   perceptions of outdoor lighting},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {4},
Pages = {1744-1756},
Month = {DEC},
Abstract = {Balancing the adverse effects of artificial light at night (ALAN) with
   its benefits remains a critical challenge. As strategies for managing
   ALAN evolve, it is essential to consider the experiences of the people
   who are the primary beneficiaries of artificial lighting in
   decision-making and management processes. Participatory methods such as
   Public Participation Geographic Information Systems (PPGIS) are widely
   used in urban and environmental research and practice to capture
   place-based perceptions. However, the application of PPGIS to after-dark
   environments and lighting-specific experiences is still limited, and
   little is known about its capacity to capture public perceptions of
   lighting attributes such as spatial brightness and overall lighting
   quality. In this study, we examine the capacity of the PPGIS methodology
   to assess and spatially represent residents' location-specific
   perceptions of outdoor lighting. Using data collected on a university
   campus, we compare survey responses about the perceived overall quality
   of street lighting (POQ) and spatial brightness with actual lighting
   conditions. POQ responses were verified through on-site visual
   investigation, while brightness ratings were compared to relative
   luminance (Y) values extracted from nighttime aerial imagery. Results
   show observable differences in lighting conditions between areas rated
   high and low in POQ and a statistically significant but moderate
   relationship between perceived spatial brightness and relative luminance
   (Y). These findings provide partial support for the ability of digitally
   literate participants to meaningfully describe luminous environments
   using digital mapping, particularly in familiar and frequently visited
   spaces. The approach can be considered a promising method for
   exploratory and large-scale assessments of after-dark environments and
   offers potential for incorporating public perspectives into lighting
   research and practice.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Ingi, D (Corresponding Author), Aalto Univ, Dept Elect Engn, Maarintie 8, Espoo 02150, Finland.
   Ingi, Dmitrii; Pinho, Paulo; Bhusal, Pramod, Aalto Univ, Dept Elect Engn \& Automat, Espoo, Finland.
   Kytta, Marketta, Aalto Univ, Dept Built Environm, Espoo, Finland.},
DOI = {10.1016/j.jum.2026.04.002},
