   Lambarki, Rachid; Elmostafa, Achbab; Maanan, Mehdi; Rhinane, Hassan, Univ Hassan 2, Fac Sci Ain Chock, Earth Sci Dept, Casablanca, Morocco.},
DOI = {10.1016/j.grets.2025.100171},
