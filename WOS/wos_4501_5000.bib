@article{ WOS:001590701100001,
Author = {Vallance, Suzanne and Carlton, Sally and Hoddinott, Wendy},
Title = {Urban governance: Public space management and `what's in common'},
Journal = {URBAN DESIGN INTERNATIONAL},
Year = {2025},
Volume = {30},
Number = {4},
Pages = {313-326},
Month = {DEC},
Abstract = {The move towards more participatory forms of governance has demanded new
   public space management tools, techniques, practices, and processes,
   including increased opportunities and avenues for consultation. Somewhat
   problematically, these formal processes of governance and management do
   not always help resolve tensions among diverse (potential and active)
   users, particularly in areas where relationships between inhabitants and
   urban authorities are strained or non-existent. In such cases,
   `commoning' is a useful concept for exploring how negotiations of active
   use may interact with formal urban planning processes. We draw on the
   results of an ethnographic study of the Inner City East of Christchurch,
   Aotearoa/New Zealand (AoNZ) to identify ``common-deering{''} (the
   co-option of public space), ``commons-management{''} (co-management),
   ``activation{''} and ``decommoning{''} as four commoning processes that
   enable us to knit analyses of participatory governance with nuanced
   microspatial practices.},
