@article{ WOS:001723743900001,
Author = {Saldivia, Merlina and Gonzalez, Cristhian and Ampuero, Cristian},
Title = {Sexual diversity in the public and private space of Rio Gallegos.
   Analysis of the Supervaga Project proposal},
Journal = {INFORMES CIENTIFICOS Y TECNICOS},
Year = {2025},
Volume = {17},
Number = {2},
Pages = {125-143},
Abstract = {This work is oriented towards the production of knowledge around the
   experiences of an individual and collective project: Supervaga, the
   first trends laboratory in Southern Patagonia. During the last two
   years, it held three events in different spaces in the city of Rio
   Gallegos: Jarvis Style, Russia Bar and the Eduardo Minnicelli Art
   Museum. The aforementioned proposal combines various aspects that
   require attention: it is individual as it is supported by the will of an
   active member of the sexual diversities movement and, at the same time,
   collective, because it opens the doors to participation from the
   singularity to contribute to the exhibitions. called fashion shows,
   carried out in public and private spaces. On the other hand, it is a
   proposal that in the spatial dimension of its practices combines aspects
   of feminism, transfeminism and environmentalism. The study is framed in
   Queer Geography and is approached from a qualitative approach. An
   interview was carried out with Gabe Macece, a reference for the project,
   and a review of secondary sources such as journalistic articles and/or
   opinion pieces. Supervaga as an individual and collective effort,
   contributes to the territorialization of queer theory in the city of Rio
   Gallegos.},
