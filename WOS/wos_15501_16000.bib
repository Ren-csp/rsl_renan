@article{ WOS:001288207400001,
Author = {Yang, Jianxun and He, Wei and Xia, Ziqian and Wu, Kehan and Fang, Wen
   and Ma, Zongwei and Liu, Miaomiao and Bi, Jun},
Title = {Measuring climate change perception in China using mental images: A
   nationwide open-ended survey},
