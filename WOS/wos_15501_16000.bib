@article{ WOS:001742669800001,
Author = {Zhang, Liping and Lan, Feng and Guo, Mengdan and Zhao, Xiaonan},
Title = {Exploring socio-spatial mechanisms underlying urban activity patterns: A
   data-driven study of Chinese megacities},
Journal = {CITIES},
Year = {2026},
Volume = {174},
Month = {JUL},
Abstract = {Urban activity intensity offers a lens for understanding how
   socio-spatial structure organizes everyday behavior, yet existing
   evidence remains fragmented and often relies on linear and additive
   assumptions. Using 16,880,795 geotagged Weibo check-ins from 2023, this
   study examines the spatiotemporal organization and underlying mechanisms
   of urban activity intensity across seven Chinese megacities. A
   standardized activity metric, termed standardized Weibo check-in
   intensity (SWCI), is constructed at the 2 km2 hexagonal grid level and
   computed separately for each city and day type. Local conditions are
   captured by key built-environment attributes, particularly density,
   functional diversity, and accessibility, alongside socioeconomic
   context. Spatial autocorrelation diagnostics and an explainable random
   forest framework reveal dominant drivers, nonlinear responses, and
   configuration-dependent interaction structures. Results show that urban
   activity remains persistently anchored to established urban cores, while
   leisure-oriented periods exhibit broader spatial dispersion and stronger
   secondary activation. Built-environment attributes consistently dominate
   activity intensity, but their effects are strongly nonlinear, featuring
   threshold activation and diminishing returns that vary across temporal
   contexts. Interaction structures further differentiate urban
   morphologies: polycentric megacities display more elastic
   diversity-accessibility coupling and a greater capacity to redistribute
   activity beyond core areas, whereas compact monocentric systems retain
   concentrated but less adaptive activity configurations. These findings
   conceptualize urban activity as a condition-dependent socio-spatial
   system and highlight the need for adaptive planning strategies that
   target effective ranges and coordinated spatial configurations, rather
   than single-factor intensification, in high-density urban contexts.},
