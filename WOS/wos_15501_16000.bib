@article{ WOS:001419356800001,
Author = {Vizuete, Beatriz and Gross, Milena and Garcia-Llorente, Marina and
   Oteros-Rozas, Elisa and Martin-Lopez, Berta},
Title = {More than food production: Assemblages of values underpinning women-led
   agroecological initiatives},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {3},
Pages = {684-699},
Month = {MAR},
Abstract = {Agroecology advocates the transformation to sustainable agri-food
   systems by renouncing production maximization and holistically
   integrating ecological and social aspects. The new peasantry fosters
   such sustainable agri-food systems based on agroecological principles,
   driven by values of care for nature and people. In fact, values ascribed
   to nature can be pivotal in promoting sustainable agri-food systems.
   Exploring which values, that is intrinsic, instrumental, and relational
   values, underpin agroecological initiatives and how they are assembled
   in farming practices could hold promise for moving towards
   agroecological transitions. We performed semi-structured interviews with
   15 new peasantry women who were active managers of agroecological
   initiatives in rural areas of the Madrid region, Spain. We found that
   new peasantry women expressed plural values of nature and frequently
   mentioned the relational values of meaningful occupation, care of nature
   and stewardship, and social relations. Values were articulated in three
   assemblages in which the (in-)dependency of the values differed:
   co-occurrence, bundling and blending. In co-occurrence, the values
   coexisted without relating to each other. In bundling, the values were
   linked creating a narrative but their existence does not depend on each
   other. In blending, the values were mutually dependent. We found that
   instrumental and relational values often blended. We conclude that the
   plural and assembled appearance of values align with agroecological
   principles, being key to achieving bottom-up agroecological transitions
   that care and have a sense of duty for biodiversity and fellow
   humans.Read the free Plain Language Summary for this article on the
   Journal blog.
   La agroecolog \& iacute;a defiende la transformaci \& oacute;n hacia
   sistemas agroalimentarios sostenibles renunciando a la maximizaci \&
   oacute;n de la producci \& oacute;n e integrando de forma hol \&
   iacute;stica aspectos ecol \& oacute;gicos y sociales. El nuevo
   campesinado fomenta estos sistemas agroalimentarios sostenibles basados
   en principios agroecol \& oacute;gicos, impulsados por valores de
   cuidado de la naturaleza y de las personas. De hecho, los valores
   atribuidos a la naturaleza pueden ser fundamentales para promover
   sistemas agroalimentarios sostenibles. Explorar qu \& eacute; tipo de
   valores, es decir, intr \& iacute;nsecos, instrumentales y relacionales,
   sustentan las iniciativas agroecol \& oacute;gicas y c \& oacute;mo se
   ensamblan en las pr \& aacute;cticas agr \& iacute;colas podr \&
   iacute;a ser prometedor para avanzar hacia transiciones agroecol \&
   oacute;gicas. Realizamos entrevistas semiestructuradas a 15 mujeres del
   nuevo campesinado que son gestoras activas de iniciativas agroecol \&
   oacute;gicas en zonas rurales de la Comunidad de Madrid, Espa \&
   ntilde;a. Encontramos que las mujeres del nuevo campesinado expresaron
   valores plurales de la naturaleza y mencionaron con frecuencia los
   valores relacionales de ocupaci \& oacute;n con sentido, el cuidado de
   la naturaleza, y las relaciones sociales. Los valores se articularon en
   tres tipos de ensamblajes seg \& uacute;n la (in-)dependencia entre
   ellos: co-ocurrencia, agrupaci \& oacute;n y mezcla. En la
   co-ocurrencia, los valores coexisten sin relacionarse entre s \&
   iacute;. Mientras que en la agrupaci \& oacute;n, los valores se
   vinculan creando una narrativa, pero su existencia no depend \& iacute;a
   de los dem \& aacute;s. Y en la mezcla, los valores dependen unos de
   otros. Los valores instrumentales y relacionales se mezclaron con
   frecuencia en las narrativas de las mujeres del nuevo campesinado.
   Concluimos que la aparici \& oacute;n plural y ensamblada de valores se
   alinea con los principios agroecol \& oacute;gicos, siendo clave para
   lograr transiciones agroecol \& oacute;gicas de abajo arriba que cuiden
   y sean sostenibles con la biodiversidad y los seres humanos.},
