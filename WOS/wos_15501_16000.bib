Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Wang, X (Corresponding Author), Chinese Acad Sci, Inst Geog Sci \& Nat Resources Res, Key Lab Land Surface Pattern \& Simulat, Beijing 100101, Peoples R China.
