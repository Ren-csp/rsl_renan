@article{ WOS:001589983000001,
Author = {Nunez-Rosas, Laura E. and Marquez-Luna, Ubaldo and Lopez-Segoviano,
   Gabriel and Arizmendi, Maria del Coro},
Title = {Urban gardens increase taxonomic, functional, and phylogenetic
   hummingbird diversity in Mexico City},
Journal = {JOURNAL OF URBAN ECOLOGY},
Year = {2025},
Volume = {11},
Number = {1},
Abstract = {In recent times urbanization has significantly expanded, and along with
   factors such as agriculture, deforestation, climate change, and the
   introduction of exotic species, has severely impacted biodiversity.
   However, biodiversity is essential for maintaining ecosystem stability
   and providing crucial ecosystem services, including water purification,
   climate regulation, air filtration, pollination, and recreational and
   cultural benefits. Urban gardens have emerged as effective
   rehabilitation proposals for urban green spaces. These urban green
   spaces provide habitat for various species, contribute to climate
   regulation, and offer recreational spaces for residents. Monitoring the
   impact of these urban green spaces rehabilitation efforts is essential,
   with several species serving as bioindicators of environmental quality.
   This study focuses on the pollinator garden established by the Mexico
   City government called Parque Lineal Canal Nacional (PCN), which uses
   native plants to attract animal visitors. Data from eBird (2015-2024)
   showed a significant increase in hummingbird diversity (taxonomic,
   functional and phylogenetic) following the garden's establishment, from
   three species before intervention to 13 species after. This increase
   highlights the effectiveness of urban gardens in supporting urban
   biodiversity. Pollinator gardens, specifically, have proven
   effectiveness in enhancing biodiversity by providing nectar and pollen,
   which attract higher populations of pollinators. Hummingbirds, as
   nectarivorous birds, are particularly responsive to the presence of
   flowering plants in these gardens, leading to increased diversity and
   abundance. Future studies are necessary and collaboration between urban
   planners, ecologists and local communities is vital to create
   sustainable and biodiverse spaces.},
