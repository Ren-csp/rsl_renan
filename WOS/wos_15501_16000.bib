@article{ WOS:001642937000001,
Author = {Al Sayyed, Heba and Otoom, Rogayah and Al Kurdi, Nabeel},
Title = {Investigating the importance of public participation in urban planning
   to improve the economic status of commercial streets: Abdullah Al-Lawzi
   Street as a case study, Amman, Jordan},
Journal = {URBAN, PLANNING AND TRANSPORT RESEARCH},
Year = {2025},
Volume = {13},
Number = {1},
Month = {DEC 31},
Abstract = {Urban streets play a central role in shaping daily economic activity,
   yet limited research has examined how public participation and
   institutional practices influence the performance of commercial streets
   in Middle Eastern cities. This study investigates the relationship
   between public participation, urban design quality, and economic
   vitality on Abdullah Al-Lawzi Street in Amman, Jordan. Using a
   mixed-methods approach that combines field observation, a structured
   questionnaire, and an institutional interview, the analysis integrates
   quantitative patterns with qualitative insights interpreted through the
   Gioia methodology. The findings show that weak public
   participation-characterized by limited communication channels and
   minimal stakeholder involvement-contributes to design decisions that
   fail to meet the needs of shop owners and street users. These
   participation gaps, coupled with poor walkability, unsafe crossings,
   restricted parking, and a lack of urban amenities, reduce customer
   access and negatively affect commercial performance. The study
   demonstrates that physical interventions alone cannot revitalize
   commercial streets unless they are informed by meaningful engagement
   with local stakeholders.Strengthening participatory governance,
   enhancing pedestrian infrastructure, and improving the public realm are
   essential for achieving sustainable economic improvement. These insights
   offer a practical framework for planners in Amman and other cities with
   similar urban and institutional conditions.},
