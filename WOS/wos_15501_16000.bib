@article{ WOS:001762437900001,
Author = {Dudu, Violet Patricia and Siyaya, Donaldson and Ilunga, Masengo and
   Chabalala, Dunisani Thomas},
Title = {Knowledge, perceptions and practice of pharmaceutical waste disposal
   among health institutions and residents in Mhangura, Zimbabwe},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {8},
Number = {5},
Month = {MAY 1},
Abstract = {Objective. The study aimed to assess the knowledge, perceptions, and
   practices of healthcare workers and residents in Mhangura regarding
   pharmaceutical waste disposal, in response to growing environmental
   concerns over indiscriminate disposal. Methods. A mixed-method
   cross-sectional design was employed. Data collection involved
   pre-validated questionnaires administered to 274 randomly selected
   residents, in-depth interviews with 82 purposively selected healthcare
   workers, and direct observations of pharmaceutical waste disposal
   practices at healthcare facilities. Quantitative data were analysed
   using SPSS, while qualitative data were coded thematically to explore
   relationships across categories. Results. Findings revealed a concerning
   gap in knowledge, with only 41\% of residents demonstrating awareness of
   proper pharmaceutical waste disposal. While 70\% of healthcare workers
   demonstrated basic knowledge, 40\% did not receive formal training since
   employed. Despite this, actual disposal practices were poor across both
   groups, with only 6\% of residents and 40\% of the healthcare facilities
   reported segregating pharmaceutical waste. Improper disposal such as
   discarding unused or expired medications in household trash or flushing
   them was prevalent. Statistical analysis using Chi-square tests
   indicated a significant correlation (p < 0.05) between education level
   and respondents' knowledge, perceptions, and practices. Conclusion. The
   study highlights the urgent need for comprehensive interventions to
   mitigate pharmaceutical waste hazards. Key recommendations include
   implementing public awareness campaigns, training healthcare workers and
   residents, establishing designated pharmaceutical waste collection and
   disposal sites, and enforcing existing regulations. Enhancing the role
   of healthcare providers in educating patients about safe disposal
   practices is also emphasized. These measures are essential to promote
   responsible pharmaceutical waste management in Mhangura and similar
   communities, thereby safeguarding environmental and public health.},
