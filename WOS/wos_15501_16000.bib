@article{ WOS:001855663900001,
Author = {Gemmecke, Corinna and Kuhner, Clara and Schapers, Philipp and Huffmeier,
   Joachim},
Title = {How small business owners evaluate environmental action: A taxonomy of
   environmental measures and their perceived impact},
Journal = {APPLIED PSYCHOLOGY-AN INTERNATIONAL REVIEW-PSYCHOLOGIE APPLIQUEE-REVUE
   INTERNATIONALE},
Year = {2026},
Volume = {75},
Number = {4},
Month = {AUG 23},
Abstract = {Given the environmental impact of economic activities, companies are key
   agents in advancing environmental sustainability. Whereas larger
   businesses often have established environmental strategies, small
   businesses must develop such strategies from scratch, largely depending
   on small business owners' (SBOs) environmental perceptions. However,
   little is known about how SBOs perceive different environmental
   measures. To study which measures SBOs perceive as high and low impact
   and which drivers and barriers they perceive during their
   implementation, we conducted two studies using a mixed-methods approach
   (N 1.1 = 800; N 1.2 = 102; N 2.1 = 1007; N 2.2 = 216 participants). In
   Study 1, using the Gioia method, we developed a bottom-up taxonomy of
   environmental measures along with their perceived drivers and barriers.
   In Study 2, we validated the taxonomy in another sample and quantified
   the measures' perceived high and low environmental impact and the
   self-reported implementation rates. In both studies, transition to
   renewable energy and using sustainable, long-lasting materials were
   perceived as most impactful. We further found that the implementation of
   environmental measures can be promoted or prevented through
   governmental, society, and market, as well as company factors. The
   association between environmental measures' perceived impact and their
   self-reported implementation was weak.},
