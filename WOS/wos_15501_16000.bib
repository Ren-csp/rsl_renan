   Oyewole, Matthew Oluwole, Obafemi Awolowo Univ, Dept Estate Management, Ife, Nigeria.},
DOI = {10.11113/ijbes.v5.n3.298},
ISSN = {1511-1369},
EISSN = {2289-8948},
