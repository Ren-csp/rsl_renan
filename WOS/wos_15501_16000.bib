@article{ WOS:000872795800001,
Author = {Sponselee, Hanne C. S. and ter Beek, Lies and Renders, Carry M. and
   Robroek, Suzan J. W. and Steenhuis, Ingrid H. M. and Kroeze, Willemieke},
Title = {Stakeholders' Perceptions Regarding Adaptation and Implementation of
   Existing Individual and Environmental Workplace Health Promotion
   Interventions in Blue-Collar Work Settings},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {20},
Month = {OCT},
Abstract = {Blue-collar workers often have disadvantageous health statuses and might
   therefore benefit from a combination of individual and environmental
   workplace health promotion interventions. Exploring stakeholders'
   perceived facilitators and barriers regarding the combined
   implementation of these interventions in blue-collar work settings is
   important for effective implementation. A qualitative study consisting
   of 20 stakeholder interviews within six types of organisations in The
   Netherlands was conducted. The potential implementation of the
   evidence-based individual intervention SMARTsize and the environmental
   intervention company cafeteria 2.0 was discussed. Data were analysed
   using thematic analysis with a deductive approach. Five main themes
   emerged: (1) the availability of resources, (2) professional obligation,
   (3) expected employee cooperation, (4) the compatibility of the proposed
   health interventions, and (5) the content of implementation tools and
   procedures. Generally, stakeholders expressed a sense of professional
   obligation toward workplace health promotion, mentioning that the
   current societal focus on health and lifestyle provided the perfect
   opportunity to implement interventions to promote healthy eating and
   physical activity. However, they often perceived the high doses of
   employees' occupational physical activity as a barrier. We recommend
   co-creating interventions, implementation tools, and processes by
   involving stakeholders with different professional backgrounds and by
   adapting communication strategies at diverse organisational levels.},
