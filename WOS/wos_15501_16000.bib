@article{ WOS:000269203100007,
Author = {Moyano, Eduardo and Paniagua, Angel and Lafuente, Regina},
Title = {ENVIRONMENTAL POLICY, CLIMATE CHANGE AND PUBLIC OPINION THE CASE OF
   ANDALUSIA},
