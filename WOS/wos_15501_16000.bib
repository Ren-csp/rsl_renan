@article{ WOS:000795593600001,
Author = {Liu, Hehe},
Title = {How to Improve Environment Performance? The Comparison of Stakeholder
   Perceptions on How to Improve Air Quality in China},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2022},
Volume = {10},
Month = {APR 25},
Abstract = {The air quality and carbon neutrality strategies in China has attracted
   the growing concern of multiple stakeholders. Through face-to-face
   surveys conducted in five major cities in North China, we compared the
   stakeholders' perceptions. Our research reveals conflicting perceptions
   among stakeholders. On the one hand, local authorities and academics
   prefer to focus on market-based regulation to prevent air pollution.
   Enterprise managers, however, do not want to be regulated. On the other
   hand, social groups expect more information about air pollution to be
   released, but local authorities do not see releasing that information as
   a top priority. These differences of perceptions can actually be useful
   in terms of policymaking.},
