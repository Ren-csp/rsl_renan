@article{ WOS:001591938800008,
Author = {Guerrero Gomez, Natali and Tejedor, Santiago and Romero-Rodriguez, Luis
   M.},
Title = {Systematic Analysis of Open Access Scientific Production on
   Environmental},
Journal = {ADCOMUNICA-REVISTA CIENTIFICA DE ESTRATEGIAS TENDENCIAS E INNOVACION EN
   COMMUNICACION},
Year = {2025},
Number = {30},
Pages = {167-195},
Month = {JUL},
Abstract = {This study analyzes contributions on environmental communication
   published between 2019 and 2023 through a systematic review of 147
   articles extracted from Web of Science (WoS) and Scopus, following the
   PRISMA 2020 protocol. The results reflect a growing interest in
   environmental narratives, the role of the media, and the impact of
   social media on public perception of environmental issues. A trend
   towards the combined use of qualitative and quantitative approaches is
   observed, providing a more comprehensive view of the phenomena. However,
   a gap is identified in studies focused on adapting environmental content
   to different platforms, which represents an opportunity for future
   research. Adapting messages to the specific characteristics of each
   medium could improve their effectiveness in raising awareness and
   encouraging action. The study highlights the need to continue exploring
   communication strategies that promote greater public understanding of
   environmental issues and sustainability.},
