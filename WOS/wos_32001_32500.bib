@article{ WOS:001604765600001,
Author = {Lao, Lorraine S. and Cando, Evaristo Nino T. and Buladaco, Marcial S.
   and Labios, Jocelyn D.},
Title = {Perceptions, adaptations, and innovation barriers among rice farmers
   facing sea level rise: Insights from Bohol, Philippines},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {Rising sea levels are leading to increased flooding and salinization of
   coastal soils, making it more difficult to continue rice production in
   low-lying coastal areas. This presents a complex risk management
   challenge situated within the nexus of farmer well-being, soil
   degradation, and local development, and for which community-based
   solutions offer a promising approach. This study aimed to identify such
   solutions by assessing the knowledge and perceptions of farmers in a
   selected salt-affected rice area in Bohol, Philippines. Key informant
   interviews and a focus group discussion were conducted to collect data
   on the farmers' general farming practices, knowledge of soil salinity
   and adaptation, and attitudes toward participatory management. The
   responses were analyzed using thematic analysis and Ostrom's
   Institutional Analysis and Development framework. The results revealed
   that the respondents had accurate knowledge of salinization in their
   fields, the ability to propose innovative solutions, and the willingness
   to engage in active participatory management. However, this was
   contrasted by the lack of effective adaptation strategies currently
   implemented in the area. Several factors contributing to this
   discrepancy were identified, including internal community attributes,
   limited interaction both among community members and with external
   stakeholders, and the slow-onset nature of the hazard. Although rice
   production in the study site continues through existing support
   mechanisms and reliance on the chance of rain, alternative arrangements
   are imperative to foster long-term viability. Context-specific and
   appropriate strategies were identified, including collaborative
   learning, open feedback channels, and technical measures such as
   alternative rice varieties and improved irrigation infrastructure.},
