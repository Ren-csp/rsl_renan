@article{ WOS:001400571200001,
Author = {Olari, Lia-Raluca and Liu, Sichen and Arnold, Franziska and Kuehlwein,
   Julia and Miro, Marta Gil and Updahaya, Ajeet Rijal and Stuerzel,
   Christina and Thal, Dietmar Rudolf and Walther, Paul and Sparrer,
   Konstantin M. J. and Danzer, Karin M. and Muench, Jan and Kirchhoff,
   Frank},
Title = {α-Synuclein fibrils enhance HIV-1 infection of human T cells,
   macrophages and microglia},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JAN 18},
Abstract = {HIV-associated neurocognitive disorders (HAND) and viral reservoirs in
   the brain remain a significant challenge. Despite their importance, the
   mechanisms allowing HIV-1 entry and replication in the central nervous
   system (CNS) are poorly understood. Here, we show that alpha-synuclein
   and (to a lesser extent) A beta fibrils associated with neurological
   diseases enhance HIV-1 entry and replication in human T cells,
   macrophages, and microglia. Additionally, an HIV-1 Env-derived
   amyloidogenic peptide accelerated amyloid formation by alpha-synuclein
   and A beta peptides. Mechanistic studies show that alpha-synuclein and A
   beta fibrils interact with HIV-1 particles and promote virion attachment
   and fusion with target cells. Despite an overall negative surface
   charge, these fibrils facilitate interactions between viral and cellular
   membranes. The enhancing effects of human brain extracts on HIV-1
   infection correlated with their binding to Thioflavin T, a dye commonly
   used to stain amyloids. Our results suggest a detrimental interplay
   between HIV-1 and brain amyloids that may contribute to the development
   of neurodegenerative diseases.},
