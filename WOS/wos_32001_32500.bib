@article{ WOS:000714972500021,
Author = {Ding, Ke and Huang, Xin and Ding, Aijun and Wang, Minghuai and Su, Hang
   and Kerminen, Veli-Matti and Petaja, Tuukka and Tan, Zhemin and Wang,
   Zilin and Zhou, Derong and Sun, Jianning and Liao, Hong and Wang, Huijun
   and Carslaw, Ken and Wood, Robert and Zuidema, Paquita and Rosenfeld,
   Daniel and Kulmala, Markku and Fu, Congbin and Poschl, Ulrich and Cheng,
   Yafang and Andreae, Meinrat O.},
Title = {Aerosol-boundary-layer-monsoon interactions amplify semi-direct effect
   of biomass smoke on low cloud formation in Southeast Asia},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {NOV 5},
Abstract = {Low clouds play a key role in the Earth-atmosphere energy balance and
   influence agricultural production and solar-power generation. Smoke
   aloft has been found to enhance marine stratocumulus through
   aerosol-cloud interactions, but its role in regions with strong human
   activities and complex monsoon circulation remains unclear. Here we show
   that biomass burning aerosols aloft strongly increase the low cloud
   coverage over both land and ocean in subtropical southeastern Asia. The
   degree of this enhancement and its spatial extent are comparable to that
   in the Southeast Atlantic, even though the total biomass burning
   emissions in Southeast Asia are only one-fifth of those in Southern
   Africa. We find that a synergetic effect of aerosol-cloud-boundary layer
   interaction with the monsoon is the main reason for the strong
   semi-direct effect and enhanced low cloud formation in southeastern
   Asia.
   Biomass burning emissions have been shown to influence clouds in the
   Atlantic, but its influence in other regions is not well known. Here,
   the authors show that biomass burning aerosols increase the low-cloud
   cover over subtropical southeastern Asia by a similar magnitude than
   over the Atlantic.},
