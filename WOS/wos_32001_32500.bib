@article{ WOS:000498805600065,
Author = {Navarro, Virginia and Martinez, Olaia and Miranda, Jonatan and Rada,
   Diego and Angeles Bustamante, Maria and Etaio, Inaki and Lasa, Arrate
   and Simon, Edurne and Churruca, Itziar},
Title = {Including aspects of sustainability in the degree in Human Nutrition and
   Dietetics: An evaluation based on student perceptions},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2020},
Volume = {243},
Month = {JAN 10},
Abstract = {Education is progressing towards having a more sustainable outlook.
   Numerous approaches to sustainability teaching have been conducted at
   different educational stages, but few studies have used quantitative
   methods to measure its impact.
   The aim of this quasi-experimental intervention was to integrate
   competences in ``Sustainable Development{''} (SustD) into the teaching
   syllabus of a degree in Human Nutrition and Dietetics through active
   methodologies. Seven courses were selected to implement ten activities,
   across four academic levels of this degree. Students completed a
   questionnaire both before and after the intervention in order to measure
   their perception of knowledge of SustD and to assess their sustainable
   intentional behaviour (SIB). According to the results, their SustD
   related knowledge increased after the intervention, although this was
   not clearly reflected in their SIB. This study aims to identify good
   practices and the best conditions for future longitudinal interventions.
