@article{ WOS:000345913000018,
Author = {Fang, Qingming and Inanc, Burcu and Schamus, Sandy and Wang, Xiao-hong
   and Wei, Leizhen and Brown, Ashley R. and Svilar, David and Sugrue,
   Kelsey F. and Goellner, Eva M. and Zeng, Xuemei and Yates, Nathan A. and
   Lan, Li and Vens, Conchita and Sobol, Robert W.},
Title = {HSP90 regulates DNA repair via the interaction between XRCC1 and DNA
   polymerase β},
Journal = {NATURE COMMUNICATIONS},
Year = {2014},
Volume = {5},
Month = {NOV},
Abstract = {Cellular DNA repair processes are crucial to maintain genome stability
   and integrity. In DNA base excision repair, a tight heterodimer complex
   formed by DNA polymerase beta (Pol beta) and XRCC1 is thought to
   facilitate repair by recruiting Pol beta to DNA damage sites. Here we
   show that disruption of the complex does not impact DNA damage response
   or DNA repair. Instead, the heterodimer formation is required to prevent
   ubiquitylation and degradation of Pol beta. In contrast, the stability
   of the XRCC1 monomer is protected from CHIP-mediated ubiquitylation by
   interaction with the binding partner HSP90. In response to cellular
   proliferation and DNA damage, proteasome and HSP90-mediated regulation
   of Pol beta and XRCC1 alters the DNA repair complex architecture. We
   propose that protein stability, mediated by DNA repair protein complex
   formation, functions as a regulatory mechanism for DNA repair pathway
   choice in the context of cell cycle progression and genome surveillance.},
