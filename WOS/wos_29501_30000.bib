@article{ WOS:000307268200001,
Author = {Sovacool, Benjamin K.},
Title = {Perceptions of climate change risks and resilient island planning in the
   Maldives},
Journal = {MITIGATION AND ADAPTATION STRATEGIES FOR GLOBAL CHANGE},
