@article{ WOS:001872607500001,
Author = {Poudel, Sangam and Timilsina, Binita and Poudel, Saugat and Bhattarai,
   Suman},
Title = {Local perceptions of Asiatic black bear conservation in a subsistence
   agriculture community of Mustang, Nepal},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2026},
Month = {2026 SEP 11},
Abstract = {Human-wildlife interactions involving the Asiatic black bear (Ursus
   thibetanus) present significant challenges for coexistence in Nepal.
   Despite the vulnerable status, this species remains understudied in
   Nepal, particularly concerning the threats it encounters and the
   perspectives of local people toward its conservation. Accordingly, this
   study aimed to assess perceived threats to Asiatic black bears, analyze
   crop use patterns, and understand local people's perceptions influencing
   conservation efforts for this species in Mustang district. Data
   collection methods included preliminary surveys, key informant
   interviews, focus group discussions, and household surveys. The
   nonparametric chi-square test was used for perception analysis,
   regression and ANOVA tests for crop loss estimation, and the Friedman
   test for threat analysis. Forest fires were identified as the most
   perceived threat to bears. Maize and buckwheat were reported as the most
   frequently foraged crops, likely reflecting both their availability and
   seasonal attractiveness to bears. Crop foraging showed significant
   correlations with locals' conservation attitudes and croplands'
   proximity to forests. The majority of respondents held negative
   perceptions toward bear conservation, which might be due to their
   personal experience in interactions with bears and the lack of adequate
   response of authority in addressing their loss. Because this study
   primarily relies on self-reported perspectives from local communities,
   it captures important experiential and perceptual dimensions of
   human-wildlife interactions. Complementing this approach with additional
   socioecological data would further strengthen the basis for developing
   effective conflict-resolution strategies.},
