Author = {Fasching, M. and Schubatzky, T. and Hopf, M.},
Title = {`Low pressure', `high commitment', and `low control' - latent profile
   analysis of teachers' perceptions regarding teaching climate action as a
   socio-scientific issue},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2025},
Month = {2025 OCT 13},
Abstract = {Teaching the socio-scientific issue of climate action is a crucial
   component of climate change education. In this study, we investigate
   teachers' perceptions of teaching this topic in order to identify latent
   profiles and ascertain differences and similarities across educators.
   Furthermore, we examine the relationships of the latent profiles to the
   educators' professional background, intention, and willingness to teach
   climate action. Based on the Theory of Planned Behavior, we surveyed 206
   Austrian physics teachers' perceptions of ease, necessity, social norms,
   self-efficacy, and autonomy regarding teaching the topic. Latent profile
   analysis revealed educators (a) with low perceptions of pressure, (b)
   with high commitment, and (c) with low sense of control for teaching
   climate action. Profile membership is significantly related to teachers'
   experience in teaching the topic, scientific consensus belief, and
   teaching willingness. We suggest the development of tailored programs
   that address these diverse educator profiles, aiming to ensure effective
   preparation for teaching climate action.},
