@article{ WOS:000373027400031,
Author = {Louder, Robert K. and He, Yuan and Ramon Lopez-Blance, Jose and Fang,
   Jie and Chacon, Pablo and Nogales, Eva},
Title = {Structure of promoter-bound TFIID and model of human pre-initiation
   complex assembly},
Journal = {NATURE},
