@article{ WOS:000291397800054,
Author = {Jirawatnotai, Siwanon and Hu, Yiduo and Michowski, Wojciech and Elias,
   Joshua E. and Becks, Lisa and Bienvenu, Frederic and Zagozdzon,
   Agnieszka and Goswami, Tapasree and Wang, Yaoyu E. and Clark, Alan B.
   and Kunkel, Thomas A. and van Harn, Tanja and Xia, Bing and Correll,
   Mick and Quackenbush, John and Livingston, David M. and Gygi, Steven P.
