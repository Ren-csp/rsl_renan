@article{ WOS:001480409700001,
Author = {Coutant, Opale and Davy, Damien and Jahn-Oyac, Arnaud and Quartarollo,
   Gregory and Valentini, Alice and Dejean, Tony and Brosse, Sebastien and
   Murienne, Jerome},
Title = {Confronting forest-dweller local ecological knowledge and environmental
   DNA measurements of biodiversity},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {6, SI},
Pages = {1382-1395},
Month = {JUN},
Abstract = {In the face of global changes and the biodiversity crisis, Local
   Ecological Knowledge of Indigenous communities is increasingly valued
   for aligning conservation policies with the needs of local communities
   and enriching conservation strategies through the synergy of diverse
   knowledge systems. To assess whether conservation policies relying on
   biodiversity metrics integrate the interconnectedness between nature and
   Indigenous communities, we evaluated the congruence between standardised
   biodiversity measurements obtained through environmental DNA (eDNA) and
   Indigenous Local Ecological Knowledge (LEK). We selected 19 sampling
   sites along the upper Oyapock River in French Guiana. We collected eDNA
   from the water to inventory fish and game species, and we conducted
   biodiversity perception surveys with anglers and hunters from the Way \&
   atilde;pi Indigenous group to collect LEK associated with each site.
   Across the studied area, Way \& atilde;pi LEK presented different
   pictures of biodiversity compared to standardised biodiversity
   assessments. This comparative analysis demonstrates that Way \&
   atilde;pi LEK not only reflects species distribution but also
   encompasses diverse place-based obligations and relationships. This
   underscores the need to integrate LEK into conservation policies to
   promote equitable and sustainable environmental decision-making. This
   can be achieved by encouraging participatory processes that incorporate
   diverse knowledge systems, enabling the identification of local
   conservation challenges and the determination of the most suitable
   compromises.Read the free Plain Language Summary for this article on the
   Journal blog.
   Dans un contexte de changements globaux et de crise de la biodiversit \&
   eacute;, les savoirs naturalistes locaux des communaut \& eacute;s
   autochtones sont de plus en plus reconnus pour leur capacit \& eacute;
   \& agrave; aligner les politiques de conservation sur les besoins des
   populations locales et \& agrave; enrichir les strat \& eacute;gies de
   conservation gr \& acirc;ce la synergie de diff \& eacute;rents syst \&
   egrave;mes de connaissances. Pour d \& eacute;terminer si les politiques
   de conservation bas \& eacute;es sur des indicateurs de biodiversit \&
   eacute; int \& egrave;grent les diverses relations entre la nature et
   les communaut \& eacute;s autochtones, nous avons analys \& eacute; la
   congruence entre des mesures de biodiversit \& eacute; standardis \&
   eacute;es obtenues par ADN environnemental (ADNe) et les savoirs
   naturalistes locaux. Nous avons s \& eacute;lectionn \& eacute; 19 sites
   d'\& eacute;chantillonnage le long de la rivi \& egrave;re Oyapock en
   Guyane fran \& ccedil;aise. Nous avons pr \& eacute;lev \& eacute; de
   l'ADNe dans l'eau pour inventorier les esp \& egrave;ces de poissons et
   de gibier. Parall \& egrave;lement, nous avons r \& eacute;alis \&
   eacute; des enqu \& ecirc;tes sur la perception de la biodiversit \&
   eacute; aupr \& egrave;s des p \& ecirc;cheurs et des chasseurs de la
   communaut \& eacute; autochtone Way \& atilde;pi afin de recueillir les
   savoirs naturalistes locaux associ \& eacute;s \& agrave; chaque site.
   Dans la zone \& eacute;tudi \& eacute;e, les savoirs naturalistes locaux
   des Way \& atilde;pi pr \& eacute;sentent une vision de la biodiversit
   \& eacute; qui diff \& egrave;re des \& eacute;valuations standardis \&
   eacute;es de la biodiversit \& eacute;. Cette analyse comparative montre
   que les savoirs naturalistes locaux des Way \& atilde;pi refl \&
   egrave;tent la r \& eacute;partition des esp \& egrave;ces, mais
   englobent \& eacute;galement des obligations et des relations sp \&
   eacute;cifiques au territoire et aux sites. Cette \& eacute;tude met en
   \& eacute;vidence la n \& eacute;cessit \& eacute; d'int \& eacute;grer
   les savoirs naturalistes locaux des communaut \& eacute;s autochtones
   dans les efforts de conservation afin de favoriser des politiques
   environnementales inclusives pour tous les acteurs de la nature. Cela
   pourrait \& ecirc;tre accompli en encourageant des processus
   participatifs s'appuyant sur des cadres qui valorisent la diversit \&
   eacute; des syst \& egrave;mes de connaissances et permettant
   d'identifier les d \& eacute;fis locaux en mati \& egrave;re de
   conservation.},
