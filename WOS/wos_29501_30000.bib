@article{ WOS:001629000200001,
Author = {Demir, M. A. and Yuksel, A. and Isik, M.},
Title = {Public attitudes toward tap water and bottled water use: a case study
   from Aksaray, Türkiye},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL SCIENCE AND TECHNOLOGY},
Year = {2025},
Volume = {23},
Number = {1},
Month = {DEC 1},
Abstract = {In today's world, where the effects of global climate change on water
   resources are increasingly evident, the sustainable management of these
   resources has become critically important. In addition to its economic
   cost, bottled water consumption also poses environmental and public
   health concerns. This study investigated water consumption behaviours of
   residents in Aksaray Province, T \& uuml;rkiye, and explored the reasons
   behind the declining use of tap water. A face-to-face survey was
   conducted with 600 participants representing different genders, age
   groups, education, and income levels. Statistical analyses revealed that
   only 12.2\% of residents drink tap water directly, whereas 32.7\% prefer
   bottled water, 14.7\% use household purifiers, and 40.5\% obtain water
   from public fountains. The main barriers were unpleasant taste and odour
   caused by seasonal eutrophication in the Mamas \& imath;n Dam and
   lingering distrust stemming from past arsenic contamination and
   waterborne disease outbreaks. A significant finding of the study was the
   relationship between socio-economic status and bottled water preference:
   individuals with lower income levels showed a higher tendency to consume
   bottled water, mainly due to their greater perceived health risk
   associated with tap water safety. To mitigate the negative environmental
   and economic impacts of bottled water consumption, municipalities should
   improve taste- and odour-related parameters, ensure transparent sharing
   of water quality data, and strengthen public communication to rebuild
   trust in tap water.},
