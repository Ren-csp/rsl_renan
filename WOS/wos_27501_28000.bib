Author = {Galesic, Mirta and Kause, Astrid and Gaissmaier, Wolfgang},
Title = {A Sampling Framework for Uncertainty in Individual Environmental
   Decisions},
Journal = {TOPICS IN COGNITIVE SCIENCE},
Year = {2016},
Volume = {8},
Number = {1},
Pages = {242-258},
Month = {JAN},
Note = {17th International Conference on Cognitive Modeling, Barcelona, SPAIN,
   AUG 17-18, 2015},
Abstract = {Decisions in the environmental and in particular the climate domain are
   burdened with uncertainty. Here, we focus on uncertainties faced by
   individuals when making decisions about environmental behavior, and we
   use the statistical sampling framework to develop a classification of
   different sources of uncertainty they encounter. We then map these
   sources to different public policy strategies aiming to help individuals
   cope with uncertainty when making environmental decisions.},
