@article{ WOS:000685386200001,
Author = {Soto-Navarro, C. A. and Harfoot, M. and Hill, S. L. L. and Campbell, J.
   and Mora, F. and Campos, C. and Pretorius, C. and Pascual, U. and Kapos,
   V. and Allison, H. and Burgess, N. D.},
Title = {Towards a multidimensional biodiversity index for national application},
Journal = {NATURE SUSTAINABILITY},
Year = {2021},
Volume = {4},
Number = {11},
Pages = {933-942},
Month = {NOV},
Abstract = {The lack of urgent action to reverse biodiversity loss is partly due to
   the complex nature of biodiversity as a feature of our planet.
   Subsequently, policymakers receive an often-confusing variety of
   narratives on why biodiversity matters, which makes it difficult to link
   biodiversity loss and risks to the attainment of sustainable
   development. Making this link clearer calls for a multidimensional
   perspective on biodiversity to reassess what we value, facilitate
   mainstreaming and support national decision-making. We propose a
   co-produced Multidimensional Biodiversity Index to connect biodiversity
   science to the political agenda that accounts for the diversity of
   values underpinning nature-human relationships.
