@article{ WOS:001804479100001,
Author = {De Witt, Annick},
Title = {Designing an education of the future: A human democratic capabilities
   meta-map for a planetary era},
Journal = {FUTURES},
Year = {2026},
Volume = {182},
Month = {SEP},
Abstract = {Education and learning are at the heart of our efforts both to adapt to
   change and to transform our troubled world. In a context of planetary
   crisis, democratic decay, and disruptive technologies, a vital question
   concerns what capabilities people need to thrive in - and help shape -
   the future. While much schooling still reflects a modernist, objectivist
   paradigm, a widening literature urges broader orientations: recognizing
   humanity's embeddedness in nature, cultivating multiple dimensions of
   human development, honoring plural worldviews, and fostering capacities
   for transformation. Yet beneath this emerging consensus lie deep
   paradigmatic tensions - most fundamentally, how to theorize
   developmental growth without sacrificing human dignity. This conceptual
   article addresses that challenge. Through an integrative review informed
   by critical interpretive synthesis, I examine three paradigmatic
   educational approaches - reformist/adaptive (e.g., 21st Century Skills),
   critical/relational (e.g., Wild Pedagogies), and
   transformative/integrative (e.g., Inner Development Goals). Using a
   worldview lens, I surface each paradigm's strengths and limitations,
   showing where tensions may indicate complementarities ripe for
   synthesis. I then propose a minimal, fourfold meta-map of Human
   Democratic Capabilities (HDC), organized around four fundamental
   relationships - to Self, Others, Whole, and Future - each scaffolding
   toward an evolved capstone: Self-leadership, Collaboration, Moral
   compass, and Purpose. The framework's contributions include: resolving
   the development/dignity tension by reframing development from a
   modernist to a eudaimonic conception, distinguishing capability growth
   (intrinsic and instrumental value) from foundational value; offering
   developmental pathways where foundational capabilities deepen into
   evolved ones, with growth expanding outward from Self to Others to Whole
   to Future; and providing normative direction while respecting pluralism
   and attending to structural conditions that enable or constrain
   capability development. The meta-map offers a visionary guidepost for
   researchers, policymakers, and practitioners reimagining education for a
   planetary era.},
