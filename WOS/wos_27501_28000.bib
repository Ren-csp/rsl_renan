@article{ WOS:001791567900001,
Author = {Park, Jinwoo and Lyu, Fangzheng and Michels, Alexander and Zhang, Ian
   and Wang, Shaowen},
Title = {Customized decision-making support per location's characteristics of
   spatial accessibility: A case study of emergency healthcare in New York
   City},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2026},
Volume = {128},
Month = {SEP},
Abstract = {Dynamic spatial accessibility, incorporating temporal dimension into
   spatial accessibility measurements, is in the spotlight because of
   significant temporal variations in urban phenomena (e.g., traffic
   congestion or floating population). Despite its importance, there are
   two significant gaps, particularly in existing healthcare access
   literature: 1) limited consideration of the dynamic nature in healthcare
   accessibility, and 2) limited support of dynamic spatial accessibility
   for practical policymaking. Our study aims to improve spatial
   accessibility measurement using time-dependent data and to summarize
   temporal sequences to support effective decision-making. Specifically,
   we measure hourly changes in spatial accessibility to emergency
   healthcare resources in New York City with a Gaussian two-step floating
   catchment area (G2SFCA) method. We then employ sequence analysis to
   detect and cluster unique temporal changes in accessibility measures.
   Our results reveal that each location provides distinct temporal changes
   in its healthcare accessibility owing to the dynamic urban phenomena. In
   addition, we find that census tracts can be grouped into 14 clusters
   based on combinations of temporal changes (i.e., stationary versus
   non-stationary) and accessibility levels (i.e., high, moderate, or low).
   Therefore, our findings can inform flexible policy responses to the
   diverse needs of locations. For example, to improve accessibility,
   certain areas could extend the operating hours of existing healthcare
   resources, or additional hospitals could be established in other
   locations. Given that decision-making is often constrained by limited
   resources, our study sheds light on how to make optimal allocations of
   healthcare resources to effectively reduce inequality in access.},
