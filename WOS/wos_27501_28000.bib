@article{ WOS:A1991FZ34400016,
Author = {HOPFIELD, JJ},
Title = {OLFACTORY COMPUTATION AND OBJECT PERCEPTION},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1991},
Volume = {88},
