@article{ WOS:000488232600013,
Author = {Ge, Jin and Wang, Xu and Drack, Michael and Volkov, Oleksii and Liang,
   Mo and Bermudez, Gilbert Santiago Canon and Illing, Rico and Wang,
   Changan and Zhou, Shengqiang and Fassbender, Juergen and Kaltenbrunner,
   Martin and Makarov, Denys},
Title = {A bimodal soft electronic skin for tactile and touchless interaction in
   real time},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {SEP 27},
Abstract = {The emergence of smart electronics, human friendly robotics and
   supplemented or virtual reality demands electronic skins with both
   tactile and touchless perceptions for the manipulation of real and
   virtual objects. Here, we realize bifunctional electronic skins equipped
   with a compliant magnetic microelectromechanical system able to
   transduce both tactile-via mechanical pressure-and touchless-via
   magnetic fields-stimulations simultaneously. The magnetic
   microelectromechanical system separates electric signals from tactile
   and touchless interactions into two different regions, allowing the
   electronic skins to unambiguously distinguish the two modes in real
   time. Besides, its inherent magnetic specificity overcomes the
   interference from non-relevant objects and enables signal-programmable
   interactions. Ultimately, the magnetic microelectromechanical system
   enables complex interplay with physical objects enhanced with virtual
   content data in augmented reality, robotics, and medical applications.},
