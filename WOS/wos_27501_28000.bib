@article{ WOS:001410638900006,
Author = {Rivier, Cyprien A. and Szejko, Natalia and Renedo, Daniela and
   Clocchiatti-Tuozzo, Santiago and Huo, Shufan and de Havenon, Adam and
   Zhao, Hongyu and Gill, Thomas M. and Sheth, Kevin N. and Falcone, Guido
   J.},
Title = {Bidirectional relationship between epigenetic age and stroke, dementia,
   and late-life depression},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {FEB 1},
Abstract = {Chronological age is an imperfect estimate of molecular aging.
   Epigenetic age, derived from DNA methylation data, provides a more
   nuanced representation of aging-related biological processes. We examine
   the bidirectional relationship between epigenetic age and brain health
   events (stroke, dementia, late-life depression) using data from 4,018
   participants. Participants with a prior brain health event are 4\%
   epigenetically older (beta = 0.04, SE = 0.01), indicating these
   conditions are associated with accelerated aging beyond that captured by
   chronological age. Additionally, a one standard deviation increase in
   epigenetic age is associated with 70\% higher odds of experiencing a
   brain health event in the next four years (OR = 1.70, 95\% CI =
   1.16-2.50), suggesting epigenetic age acceleration is not just a
   consequence but also a predictor of poor brain health. Mendelian
   Randomization analyses replicate these findings, supporting their causal
   nature. Our results support using epigenetic age as a biomarker to
   evaluate interventions aimed at preventing and promoting recovery after
   brain health events.},
