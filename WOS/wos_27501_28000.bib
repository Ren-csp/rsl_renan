@article{ WOS:001650643200001,
Author = {Dewaelheyns, Valerie and Raymaekers, Pieter and Lange, Florian and
   Wittemans, Kelly and Teerlinck, Janne and Somers, Ben and Steen, Trui},
Title = {Understanding climate-friendly gardening behaviour and its climate
   impact},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {116},
Month = {FEB},
Abstract = {How can gardeners be mobilized in climate policies? While private
   domestic gardens cover substantial shares of urban areas worldwide,
   their contribution to climate change adaptation and mitigation depends
   on whether gardening behaviours can become more climate-friendly. This
   exploratory study aims to understand the behavioural potential for
   climate-friendly gardening. Our interdisciplinary multi-method approach
   measured climate-friendly gardening in two ways. Self-reported behaviour
   was measured by questioning gardeners' self-reported investment in
   climate-friendly gardening, while their gardens' climate impact was
   objectively measured via the Biotope Area Factor using remote sensing
   data. Ordinary Least Squares Regression modelling on data from Belgian
   private garden owners (n = 830) demonstrated to what extent both
   measures relate to psychological, socio-demographic, and spatial
   characteristics. Notably, self-reported investment in climate-friendly
   gardening did not relate to objective climate impact. Furthermore,
   self-reported investment primarily related to psychological correlates,
   whereas the objectively measured impact associated with a combination of
   psychological, socio-demographic, and spatial characteristics.
   Interestingly, subjective knowledge about gardening in general, impact
   awareness, and personal norms were three psychological characteristics
   that related to both behaviour and impact. Finally, psychological
   correlates of both climate-friendly gardening investment and impact
   varied in function of the spatial context. To empower people to engage
   in impactful climate-friendly gardening, it is important to focus on
   enhancing general gardening knowledge; raising awareness of gardens'
   broader environmental impact, especially among residents of terraced
   housing; and fostering a shift in personal norms, particularly on tidy
   gardens in suburban areas. Our findings highlight the importance of
   tailoring behavioural interventions to specific spatial contexts.},
