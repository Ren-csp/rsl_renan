@article{ WOS:000809160300001,
Author = {Yu, Jiayan and Meng, Lingshuo and Chen, Yang and Zhang, Huifang and Liu,
   Jianguo},
Title = {Ozone Profiles, Precursors, and Vertical Distribution in Urban Lhasa,
   Tibetan Plateau},
Journal = {REMOTE SENSING},
