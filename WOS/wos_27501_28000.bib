@article{ WOS:001431070200001,
Author = {Alcindor, Monica and Mullauer-Seichter, Waltraud and Hurtado, Sonia De
   Gregorio and Medeiros, Leonor and Loda, Mirella and Jackson, Delton},
Title = {Approaches to Collective Cognition in the Historic Centre of Madrid: An
   Erasmus Interdisciplinary Experience},
