@article{ WOS:000278105200030,
Author = {de Vries, Sanne I. and Hopman-Rock, Marijke and Bakker, Ingrid and
   Hirasing, Remy A. and van Mechelen, Willem},
Title = {Built Environmental Correlates of Walking and Cycling in Dutch Urban
   Children: Results from the SPACE Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2010},
