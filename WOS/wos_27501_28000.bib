Author = {Wang, Xueyan and Wang, Yanlin and Qu, Xiaohan and Huang, Bing and Li,
   Zeming and Sun, Junjiao and Wei, Xiaoqing and Yang, Xiuying},
Title = {Urban trees in university campus: structure, function, and ecological
   values},
