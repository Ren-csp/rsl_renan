@article{ WOS:001876261800001,
Author = {Rickard, Laura N. and Yang, Janet Z. and Emerson, Carter and
   Brennan-Buyukaydin, Gulsen},
Title = {Can Knowledge Counteract Conflict? A Partial Replication Study of PFAS
   Science Communication},
Journal = {RISK ANALYSIS},
Year = {2026},
Volume = {46},
Number = {10},
Month = {SEP 16},
Abstract = {On the basis of two surveys embedded with a 3 \& times; 2 full-factorial
   experiment, we examine whether exposing participants to a message about
   the process of scientific inquiry prepares them to deal with conflicting
   risk information more effectively. Study 1 suggests initial evidence
   that, as compared to a testimonial, analogical and inoculation appeals
   increased trust in science when followed by consistent information.
   Conflicting information, conversely, was detrimental to risk perception,
   especially when paired with an inoculation appeal. These findings were
   not replicated in Study 2. Nevertheless, across both studies, trust in
   science, message credibility, risk perception, and self-efficacy were
   related to policy support and behavioral intention, whereas fatalism
   exercised an indirect effect through risk perception and self-efficacy.
   Findings highlight the importance of consistent messaging when
   communicating an emergent environmental health risk-here, per- and
   polyfluoroalkyl substances (PFAS)-while suggesting challenges in
   fostering a scientific mindset.},
