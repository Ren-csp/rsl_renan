@article{ WOS:000268080300027,
Author = {Kristjansdottir, Asa Gudrun and De Bourdeaudhuij, Ilse and Klepp,
   Knut-Inge and Thorsdottir, Inga},
Title = {Children's and parents' perceptions of the determinants of children's
   fruit and vegetable intake in a low-intake population},
Journal = {PUBLIC HEALTH NUTRITION},
