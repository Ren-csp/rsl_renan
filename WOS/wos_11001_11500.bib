@article{ WOS:001439419200001,
Author = {Latif, Das'ad and Muhammad, Sawedi and Arifin, Suryanto and Nurlela,
   Andi and Rahim, Hariashari and Tenriliweng, Andi Ahmad Hasan and
   Hasanuddin, Bama Andika and Putra, Bama Andika},
Title = {A sense of security in urban environments: discrimination, diversity and
   prospects for communication strategies},
Journal = {COGENT SOCIAL SCIENCES},
Year = {2025},
Volume = {11},
Number = {1},
Month = {DEC 31},
Abstract = {This study explores the public's perception of how power dynamics in
   communication contribute to the distribution of values and response to
   diversity in a demography of a dominant religious presence with
   impactful tribal and cultural customs. Surveys were conducted using a
   random sample withdrawal method involving 400 respondents from 15
   sub-districts in Makassar, Indonesia. The results show that most
   instances of discrimination did not occur on the basis of type, gender,
   ethnicity, religion, physical appearance, or area of origin. However,
   discrimination was evident in the social and economic status categories.
   The level of acceptance of diversity in ethnicity and religion is also
   high, although some small respondents indicated indifference or dislike
   to diversity. The study is significant as Indonesia is a
   densely-populated nation anchored to values of unity in diversity.
   Meanwhile, Indonesia's largest city in Eastern Indonesia, Makassar, is a
   thriving metropolitan city highly urbanized and hosts different
   demographic backgrounds. This study allows for a solid empirical
   contribution to discourses of communication in an inclusively public
   setting, means of promoting cohesion, responses to prejudice, and the
   role of public discourse in public perceptions concerning discrimination
   and diversity.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
Type = {Article},
