@article{ WOS:001586605500001,
Author = {Hernandez-Garcia, Benjamin and Mesa-Jurado, M. Azahara and Novo, Paula
   and Espinoza-Tenorio, Alejandro},
Title = {Shifting tides: the oil industry's influence on the values of nature in
   artisanal fishing communities in the Gulf of Mexico},
Journal = {ECOSYSTEMS AND PEOPLE},
Year = {2025},
Volume = {21},
Number = {1},
Month = {DEC 31},
Abstract = {Values of nature provide insights into how people perceive, experience,
   and manage social-ecological systems. Abrupt environmental and social
   changes, such as those driven by extractives industries, can reshape,
   erode, or generate new values, yet these dynamics remain understudied.
   This research explores how oil industry expansion has influenced the
   plurality of nature values in artisanal fishing communities along the
   Gulf of Mexico in Tabasco, Mexico. Drawing on in-depth interviews and
   focus groups with diverse members of fishing communities, we documented
   how participant perceive shift in their instrumental, relational, and
   intrinsic values over time. Their narratives reveal that oil-related
   impacts, such as territorial exclusion, declining marine species, and
   pollution, have disrupted long-standing human-nature relationships.
   Participants described losses in livelihood security, stewardship
   practices, social cohesion, and cultural identity. These changes
   manifest as reduced environmental care, weakening of traditional
   knowledge, diminished intergenerational transmission, loss of agency and
   fewer opportunities for aesthetic, spiritual, and emotionally meaningful
   experiences in nature. We argue that these perceived shifts signal a
   broader transformation in the fishing communities' relationship with
   nature, which poses serious risks to the continuity of artisanal fishing
   as both a livelihood and a cultural practice. Our findings underscore
   the importance of integrating local values into coastal and fisheries
   management strategies to support more inclusive, resilient, and
   equitable governance.},
