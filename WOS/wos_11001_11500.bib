@article{ WOS:001799712400001,
Author = {Scalabrini, Elaine and Vaz, Marcia and Teixeira, Joao Paulo and
   Fernandes, Paula Odete},
Title = {Residents' perceptions in cross-border tourism regions},
Journal = {ANATOLIA-INTERNATIONAL JOURNAL OF TOURISM AND HOSPITALITY RESEARCH},
Year = {2026},
Volume = {37},
Number = {3},
Pages = {770-787},
Month = {JUL 3},
Abstract = {This study analyses residents' perceptions towards the effects of
   tourism in a low-density cross-border region between northern Portugal
   and Spain. Based on Social Exchange Theory, it examines how tourism
   dependence, gender, and length of residence shape perceptions of the
   economic, sociocultural, and environmental effects. Quantitative survey
   was conducted with 622 residents from 10 municipalities on both sides of
   the border, and statistical tests were applied. Results indicate
   favourable attitudes towards tourism, driven by perceived economic
   benefits, while concerns remain moderate. Tourism dependence
   significantly influences positive and negative perceptions, whereas
   gender and length of residence do not. The findings suggest that, in
   early-stage and low-intensity cross-border destinations, traditional
   predictors of residents' attitudes operate differently from those
   observed in saturated tourism contexts.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
