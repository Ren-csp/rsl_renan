@article{ WOS:000366814000003,
Author = {de Almeida, Alexandre Nascimento and Sertao, Alexandre Coutinho and
   Casemiro Soares, Philipe Ricardo and Angelo, Humberto},
Title = {WEAK SPOTS IN THE ENVIRONMENTAL DIAGNOSTIC OF THE ENVIRONMENTAL IMPACT
   STATEMENT-EISs},
