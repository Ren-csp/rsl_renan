@article{ WOS:000425082600069,
Author = {Demirovic, Dunja and Radovanovic, Milan and Petrovic, Marko D. and
   Cimbaljevic, Marija and Vuksanovic, Nikola and Vukovic, Darko B.},
Title = {Environmental and Community Stability of a Mountain Destination: An
   Analysis of Residents′ Perception},
