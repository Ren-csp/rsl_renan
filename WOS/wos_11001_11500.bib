@article{ WOS:001590848600001,
Author = {Gstach, Doris and Werner, Stefanie},
Title = {Handlungsansätze und Instrumente zur Grünraumentwicklung in Zeiten
   baulicher Verdichtung},
Journal = {DISP},
Year = {2025},
Volume = {61},
Number = {2},
Pages = {19-33},
Month = {APR 3},
Abstract = {The recent planning paradigm to concentrate urban development to
   built-up parts of the city leads to densification. It seems unclear,
   however how urban green space should be dealt with in the course of
   densification. This article examines the discussion and practical
   experiences with corresponding approaches and planning instruments. The
   study is based on literature research, the analysis of selected planning
   instruments and expert interviews conducted by the authors in urban
   planning and greenspace departments in ten German cities. Approaches to
   green space development in the course of densification currently focus
   in particular on securing and improving existing green spaces and
   strengthening their connectivity. In addition to traditional public
   green spaces, rooftop sites and street spaces are increasingly being
   considered as potential new green spaces. Informal instruments such as
   greening concepts provide valuable groundwork for decision making
   processes. Ultimately, however, legally binding regulations are crucial.
   Clear frameworks are becoming more urgent for urban greenery as a
   voluntary municipal task, especially in times of densification. Land use
   plans are the decisive binding instrument for determining urban green
   space concerns. In recent years, new municipal regulations such as open
   space design by-laws and frameworks for new building areas are
   increasingly used to support these concerns. The study shows the
   potential and limits of these planning instruments and concludes with
   considerations for further steps.English title: Approaches and
   instruments for green space development in times of urban densification},
