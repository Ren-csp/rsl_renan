@article{ WOS:001778077600001,
Author = {Richardson, Miles},
Title = {Nature, economy and mental health: Predictive insights from historical
   language patterns},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {112},
Month = {JUN},
Abstract = {This study models long-term cultural trends in mental health discourse
   using Google nGram historical word frequency data from 1800 to 2020,
   treating language as a proxy for societal stress. Eight socio-cultural
   determinants, including economic environment, urbanisation, technology,
   education, social equity, environmental stressors, human-centred values,
   and the human-nature relationship, were modelled using a hybrid
   optimisation approach combining grid search and gradient descent.
   Linguistic proxy validation demonstrated strong measurement equivalence
   with historical indicators of mental health burden (r = 0.88 and RMSE
   0.175 for care episodes; r = 0.99 and RMSE = 0.062 for hospitalisation
   and mental health disability social security claims), supported by
   Bland-Altman agreement analysis error metrics. The socio-cultural factor
   model achieved excellent fit to target mental health trends (RMSE =
   0.025) and ablation testing confirmed the importance of including
   human-centred values, and the human-nature relationship beyond more
   established determinants. Rolling crossvalidation confirmed the model's
   temporal robustness (RMSE = 0.029). External validation demonstrated
   strong generalisation beyond linguistic data, accurately predicting
   historical US mental health social security trends (r = 0.974, RMSE =
   0.115), reinforcing the explanatory power of socio-cultural
   determinants. Scenario forecasting suggests that restoring the
   human-nature relationship could substantially reduce mental health
   related discourse. The findings suggest that the structural foundations
   of mental health appear to centre on getting economic conditions right
   for both individuals and nature to thrive, offering a systems-based
   perspective for upstream policy interventions.},
