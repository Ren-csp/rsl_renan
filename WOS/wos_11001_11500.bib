@article{ WOS:001460453600012,
Author = {Nedeljko, Mihael and Perovic, Barbara Toplak and Flatt, Jason D. and
   Kaucic, Boris Miha},
Title = {Examining the variances in well-being among LGBTQ+ older adults across
   diverse living environments in Slovenia},
Journal = {KONTAKT-JOURNAL OF NURSING AND SOCIAL SCIENCES RELATED TO HEALTH AND
   ILLNESS},
Year = {2025},
Volume = {27},
Number = {1},
Pages = {68-73},
Abstract = {Background: Lesbian, gay, bisexual, transgender, and queer (LGBTQ+)
   older adults experience long-term minority stress due to societal norms
   that lead to discrimination and stigma. The purpose of the research was
   to compare the differences in subjective psychological well-being among
   LGBTQ+ older adults according to their living environment. Methods: A
   purposive sample comprising 318 LGBTQ+ older adults was recruited for
   the quantitative survey. In the initial stage, exploratory factor
   analysis (EFA) was conducted. To examine the aim of the study, a one-way
   analysis of variance (ANOVA) was employed, followed by a post hoc
   analysis to identify any variations in the perception of well-being
   based on the living environment. Results: Significant differences in
   well-being among LGBTQ+ older adults across living environments were
   observed for three items (p < 0.05): WB1 - ... I feel cheerful and in
   good spirits, WB2 - ... I feel calm and relaxed and WB4 - ... I wake up
   feeling fresh and rested. With post hoc analysis, we showed
   statistically significant differences in the perception of subjective
   psychological well-being according to the three living environments.
   Conclusion: Our findings indicate significant variations in subjective
   psychological well-being among LGBTQ+ older adults across different
   residential settings in Slovenia. While these findings may not
   generalise to other settings, further research using larger samples and
   in other EU countries should explore the role of living environments on
   LGBTQ+ older adults' subjective psychological well-being.},
