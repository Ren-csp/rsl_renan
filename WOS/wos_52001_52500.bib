@article{ WOS:001872023900001,
Author = {Garcia Cruz, Jhon Manuel and Huanca Mozombite, Jesus Alberto and
   Zavaleta Rioja, Jasser Jose and Zapata Antesana, Astrid Cesia},
Title = {Airport-driven urban transformation and emergent collective dynamics in
   Amazonian intermediate cities: evidence from Tarapoto, Peru},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {AUG 28},
Abstract = {Introduction Airport infrastructure can act as a driver of urban
   transformation, particularly in intermediate cities where urban growth
   may outpace planning capacity. This study examines the influence of
   airport infrastructure on the transformation of the urban landscape of
   Tarapoto, an Amazonian intermediate city in northern Peru.Methods A
   mixed and exploratory case-study approach was adopted, combining
   documentary analysis, cartographic analysis, structured direct
   observation, spatial interpretation, and semi-structured interviews. The
   historical evolution of the urban landscape was analyzed from 1865 to
   2025, with particular emphasis on the period 2009-2025. Twelve
   participants, including residents, urban professionals, and local
   authorities, were interviewed using snowball sampling. Satellite
   imagery, urban planning documents, zoning information, and aerial
   photographs obtained with a drone were also analyzed.Results The
   findings indicate that the Guillermo del Castillo Paredes Airport has
   progressively become a structuring axis of urban expansion. Its
   surroundings experienced increased residential and commercial
   densification, changes in land use, reduction and fragmentation of green
   spaces, and increased pressure on mobility and public space. The
   analysis also identified differentiated perceptions among local
   stakeholders, with economic opportunities and improved connectivity
   coexisting with concerns regarding noise, traffic, environmental
   degradation, and urban disorder.Discussion The case of Tarapoto
   demonstrates that airport infrastructure can improve connectivity and
   stimulate economic activity while simultaneously generating
   environmental and socio-spatial pressures when urban growth is not
   accompanied by coordinated land-use planning. The findings highlight the
   need to integrate airport infrastructure, urban development,
   environmental conservation, and social inclusion within comprehensive
   territorial planning strategies.},
