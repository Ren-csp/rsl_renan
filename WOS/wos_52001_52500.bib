@article{ WOS:001275433700001,
Author = {Robinson, Mark and Hampson, Jamie and Osborn, Jo and Aceituno, Francisco
   Javier and Morcote-Rios, Gaspar and Ziegler, Michael J. and Iriarte,
   Jose},
Title = {Animals of the Serrania de la Lindosa: Exploring representation and
   categorisation in the rock art and zooarchaeological remains of the
   Colombian Amazon},
Journal = {JOURNAL OF ANTHROPOLOGICAL ARCHAEOLOGY},
Year = {2024},
Volume = {75},
Month = {SEP},
Abstract = {The Serrania de la Lindosa in the Colombian Amazon hosts one of the most
   spectacular global rock art traditions. Painted in vibrant ochre
   pigments, the artwork depicts abstract and figurative designs -
   including a high diversity of animal motifs - and holds key information
   for understanding how Amazonians made sense of their world. We compare a
   zooarchaeological assemblage with painted depictions of animals at the
   Cerro Azul site, and utilise relevant ethnographies and ethnohistories.
   A lack of direct proportional relationships between the animal
   representation in the art and zooarchaeological remains alludes to the
   complex socio-cultural interconnection between Amazonian communities and
   their ritualised environments. We discuss the benefits and limitations
   of quantitative categorisation and explore Indigenous ontologies,
   highlighting Amazonian perspectives on human-animal relationships.},
