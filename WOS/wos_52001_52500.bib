@article{ WOS:000761303400002,
Author = {Song Kefeng and Shi Yaqin and Liu Kun and Su Luochuan and Li Bo and Liu
   Wei and Wang Penglai and Yi Chenhong and Zhang Yajun and Ma Qingpeng and
   Hu Haibo and Liu Wenjie},
Title = {Study of silver aerosol source term at different specific internal
   energy input from HE detonation devices},
Journal = {SCIENTIFIC REPORTS},
Year = {2022},
Volume = {12},
Number = {1},
Month = {FEB 24},
Abstract = {Radioactive aerosols harmful to humans are often produced in nuclear
   accidents, and their source term characteristics (total volume and
   particle size distribution) and dispersion patterns have important
   implications for accident response and hazard assessment. However,
   experimental studies of radioactive aerosols cannot be directly
   conducted in open space due to the hazardous nature of radioactive
   aerosols. In this study, silver was used instead of plutonium to study
   the aerosol source term under different specific internal energy inputs
   (SIEI) to simulate a low order explosion in an accident. Results show
   that aerosol release fraction (ARF) and respirable release fraction
   (RRF) of silver increase linearly with SIEI first, then varies in a
   range of 8\%similar to 19\%, with a turning point at SIEI of 1.4 MJ/kg.
   Analysis suggests an increase of difference between ARF and RRF with
   respect to SIEI. The size distribution of silver aerosol around 10 mu m
   is influenced by SIEI significantly, which could be possibly attributed
   to the interactions between silver aerosol and ambient aerosol (solid HE
   products or rust). Comparison between the source term of silver and
   plutonium suggests that silver is a good surrogate of plutonium in
   studying aerosol for SIEI of MJ/kg level.},
