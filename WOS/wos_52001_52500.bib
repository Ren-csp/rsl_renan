@article{ WOS:000398195200007,
Author = {Wu, Wenjie and Dong, Guanpeng and Zhang, Wenzhong},
Title = {The puzzling heterogeneity of amenity capitalization effects on land
   markets},
Journal = {PAPERS IN REGIONAL SCIENCE},
Year = {2017},
Volume = {96},
Number = {1},
Pages = {S135-S154},
Month = {MAR},
Abstract = {Government-funded urban amenities provide significant values to land
   markets. This paper uses spatial econometric techniques to recover the
   puzzling heterogeneity in capitalized values of local amenities such as
   higher education facilities, transport and environmental amenities. On
   top of its policy implications, this paper differentiates between
   non-spatial models and spatial models to allow spatially varying
   marginal-price estimates and reflect the subtle ways that land markets
   capitalize local amenities. Our results provide heterogeneous estimates
   of capitalized amenity values that would affect land development,
   illustrating the linkage between government-funded amenities and the
   intensity of land development.
   Resumen Los servicios urbanos financiados por el gobierno proporcionan
   un valor significativo a los mercados del suelo. Este articulo utiliza
   tecnicas de econometria espacial para capturar la desconcertante
   heterogeneidad de los valores capitalizados de los servicios locales,
   tales como instituciones de educacion superior, transporte y servicios
   ambientales. Ademas de sus implicaciones politicas, este documento
   distingue entre los modelos no espaciales y los espaciales, para
   permitir estimaciones de precios marginales con variacion espacial y
   reflejar la sutileza con la que los mercados inmobiliarios del suelo se
   aprovechan de los servicios locales. Los resultados ofrecen estimaciones
   heterogeneas de los valores recreativos capitalizados que afectarian al
   desarrollo inmobiliario, lo que ilustra la relacion entre los servicios
   financiados por el gobierno y la intensidad del desarrollo inmobiliario
   en cuanto al suelo.
