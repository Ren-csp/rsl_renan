@article{ WOS:000357173500001,
Author = {Ahmed, Zamal and Timsah, Zahra and Suen, Kin M. and Cook, Nathan P. and
   Lee, Gilbert R. and Lin, Chi-Chuan and Gagea, Mihai and Marti, Angel A.
   and Ladbury, John E.},
Title = {Grb2 monomer-dimer equilibrium determines normal versus oncogenic
   function},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {JUN},
Abstract = {The adaptor protein growth factor receptor-bound protein 2 (Grb2) is
   ubiquitously expressed in eukaryotic cells and involved in a multitude
   of intracellular protein interactions. Grb2 plays a pivotal role in
   tyrosine kinase-mediated signal transduction including linking receptor
   tyrosine kinases to the Ras/mitogen-activated protein (MAP) kinase
   pathway, which is implicated in oncogenic outcome. Grb2 exists in a
   constitutive equilibrium between monomeric and dimeric states. Here we
   show that only monomeric Grb2 is capable of binding to SOS and
   upregulating MAP kinase signalling and that the dimeric state is
   inhibitory to this process. Phosphorylation of tyrosine 160 (Y160) on
   Grb2, or binding of a tyrosylphosphate-containing ligand to the SH2
   domain of Grb2, results in dimer dissociation. Phosphorylation of Y160
   on Grb2 is readily detectable in the malignant forms of human prostate,
   colon and breast cancers. The self-association/dissociation of Grb2
   represents a switch that regulates MAP kinase activity and hence
   controls cancer progression.},
