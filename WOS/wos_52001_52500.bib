@article{ WOS:000662812500005,
Author = {Yang, Huirong and Yu, Zishuo and Chen, Xizi and Li, Jiabei and Li,
   Ningning and Cheng, Jiaxuan and Gao, Ning and Yuan, Hai-Xin and Ye, Dan
   and Guan, Kun-Liang and Xu, Yanhui},
Title = {Structural insights into TSC complex assembly and GAP activity on Rheb},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {JAN 12},
Abstract = {Tuberous sclerosis complex (TSC) integrates upstream stimuli and
   regulates cell growth by controlling the activity of mTORC1. TSC complex
   functions as a GTPase-activating protein (GAP) towards small GTPase Rheb
   and inhibits Rheb-mediated activation of mTORC1. Mutations in TSC genes
   cause tuberous sclerosis. In this study, the near-atomic resolution
   structure of human TSC complex reveals an arch-shaped architecture, with
   a 2:2:1 stoichiometry of TSC1, TSC2, and TBC1D7. This asymmetric complex
   consists of two interweaved TSC1 coiled-coil and one TBC1D7 that spans
   over the tail-to-tail TSC2 dimer. The two TSC2 GAP domains are
   symmetrically cradled within the core module formed by TSC2 dimerization
   domain and central coiled-coil of TSC1. Structural and biochemical
   analyses reveal TSC2 GAP-Rheb complimentary interactions and suggest a
   catalytic mechanism, by which an asparagine thumb (N1643)
   stabilizes.-phosphate of GTP and accelerate GTP hydrolysis of Rheb. Our
   study reveals mechanisms of TSC complex assembly and GAP activity.},
