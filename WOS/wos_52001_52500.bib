@article{ WOS:001848945800012,
Author = {Huang, K. and Miao, T. and Chen, Y. and Dantas, E. and Sanford, J. and
   Asara, John M. and Moon, S. J. and Hu, Y. and Wang, K. and Han, M. and
   Goncalves, M. and Perrimon, N.},
Title = {Lipid metabolism of hepatocyte-like cells supports intestinal tumor
   growth in Drosophila},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUL 3},
Abstract = {Tumors reprogram lipid metabolism in distant tissues to support their
   growth. In adult Drosophila, gut tumors secrete the PDGF/VEGF-like
   factor Pvf1, which activates the TORC1-Hnf4 pathway in hepatocyte-like
   oenocytes. This drives production of very long-chain fatty acids and wax
   esters essential for tracheal growth around the tumor. Blocking Hnf4 or
   the elongase mElo in oenocytes strongly suppresses tracheogenesis, tumor
   progression, and cachexia-like organ wasting, while extending host
   lifespan. The same pathway also controls tracheal development in healthy
   flies. Lipoprotein receptor LpR2 depletion in oenocytes rescues the
   observed tumor induced tracheal tracheal remodeling. This tumor-host
   interaction is conserved: VEGF-A induces lipid metabolism genes in human
   hepatocytes, and lung tumor-bearing mice show elevated hepatic Hnf4 and
   Elovl7. Altogether, this study reveals a non-autonomous role of the
   TORC1-Hnf4 axis in lipid-mediated tumor progression and identifies
   potential therapeutic targets for cancer-associated metabolic
   dysfunction.},
