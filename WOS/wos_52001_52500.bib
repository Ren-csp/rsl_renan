@article{ WOS:001373183000001,
Author = {Smith, William J. and Portugal, Steven J. and Jezierski, Michal T.},
Title = {Use of anthropogenic landscapes in a wild Columba livia (Rock Dove)
   population},
Journal = {ORNITHOLOGY},
Year = {2024},
Volume = {142},
Number = {1},
Month = {DEC 5},
Abstract = {Despite the role of many domestic animals as model organisms, our
   understanding of their undomesticated conspecifics is comparatively
   poor. This limits our ability to infer the eco-evolutionary context of
   phenomena studied in the laboratory and to explore domestication. The
   domestic pigeon's wild form is the Rock Dove (Columba livia). By
   studying 5 global positioning system-tagged wild Rock Doves in
   Scotland's Outer Hebrides, we present the first individual-level
   assessment of undomesticated Rock Dove movements, revealing extensive
   use of anthropogenic habitats in both a roosting and foraging context.
   This association with humans provides tantalizing opportunities for
   research into the pre-domestication human-pigeon relationship. More
   generally, this work highlights the value of researching laboratory
   model species in nature.
   center dot Despite the importance of laboratory model organisms, our
   understanding of their wild forms is comparatively poor.center dot
   Researching the wild forms of model organisms could enhance our
   understanding of the ecological and evolutionary context of phenomena
   studied in captivity.center dot Here we describe individual-level
   movements of Rock Doves (Columba livia), the wild form of domestic
   pigeons (a model organism in behavioral research).center dot We outline
   the movements of 5 global positioning system-tagged birds from
   Scotland's Outer Hebrides, where Rock Doves rarely interbreed with
   domestic pigeons.center dot We show that all individuals were closely
   associated with humans in both a roosting and foraging context,
   providing insights into this species' pathway into domestication.
   Malgr \& eacute; le r \& ocirc;le de plusieurs animaux domestiques comme
   organismes mod \& egrave;les, notre compr \& eacute;hension de leurs
   cong \& eacute;n \& egrave;res non domestiqu \& eacute;s est assez limit
   \& eacute;e. Cela limite notre capacit \& eacute; \& agrave; d \&
   eacute;duire le contexte \& eacute;co-\& eacute;volutif des ph \&
   eacute;nom \& egrave;nes \& eacute;tudi \& eacute;s au laboratoire et \&
   agrave; explorer la domestication. La forme sauvage du pigeon domestique
   est le pigeon biset (Columba livia). En \& eacute;tudiant 5 individus
   sauvages de C. livia marqu \& eacute;s par GPS dans les H \&
   eacute;brides ext \& eacute;rieures \& eacute;cossaises, nous pr \&
   eacute;sentons la premi \& egrave;re \& eacute;valuation au niveau
   individuel des mouvements de C. livia non domestiqu \& eacute;, r \&
   eacute;v \& eacute;lant une utilisation extensive d'habitats
   anthropiques dans des contextes de repos et de recherche alimentaire.
   Cette association avec les humains offre des opportunit \& eacute;s int
   \& eacute;ressantes pour la recherche sur la relation homme-pigeon avant
   la domestication. Plus g \& eacute;n \& eacute;ralement, ce travail met
   en \& eacute;vidence la valeur de la recherche sur les esp \& egrave;ces
   mod \& egrave;les de laboratoire dans la nature.},
