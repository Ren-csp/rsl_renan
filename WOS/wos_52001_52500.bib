@article{ WOS:001432925500001,
Author = {Ferreira, Antonio},
Title = {The predicaments of craftsmanship in the knowledge economy: the rise and
   fall of Caminha's boatyards in Caminha, Portugal},
Journal = {CULTURAL STUDIES},
Year = {2025},
Volume = {39},
Number = {5, SI},
Pages = {694-716},
Month = {SEP 3},
Abstract = {Adopting a blue cultural studies perspective, this article examines the
   local impact of the forced introduction of a knowledge-based and
   technology-driven economy in Europe to analyse its controversial effects
   on human well-being and environmental sustainability. Using the example
   of the boatyards of Caminha in the extreme northwest of Portugal, the
   article documents the rise, decline and abandonment of these yards
   following the death of one individual master shipwright, Jos \& eacute;
   Lopes, in 2015, as well as the steady disappearance of the traditional
   fishing boats, the `gamelas', that Master Lopes used to build. The
   article links the trajectories of Master Lopes and the boatyards to an
   analysis of current cultural and policy trends to highlight the
   antagonistic measures imposed by the Portuguese state on craftmanship in
   general and the fishing profession in particular. Despite the economic
   and ecological viability of traditional fishing practices, excessive
   taxes and restrictive measures exacerbate the resentment of local
   fishers against the state and contribute to the public perception of
   their profession as an ecologically destructive and discredited remnant
   of an undesirable past. This happens in a context where younger
   generations find it increasingly difficult to secure meaningful jobs in
   the state-endorsed knowledge-based, pro-growth, and competition-driven
   neoliberal economy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
