@article{ WOS:000452566100002,
Author = {de Sousa, Kaue and Casanoves, Fernando and Sellare, Jorge and Ospina,
   Alejandra and Suchini, Jose Gabriel and Aguilar, Amilcar and Mercado,
   Leida},
Title = {How climate awareness influences farmers' adaptation decisions in
   Central America?},
Journal = {JOURNAL OF RURAL STUDIES},
Year = {2018},
Volume = {64},
Pages = {11-19},
Month = {NOV},
Abstract = {Central America is one of the regions with the highest vulnerability to
   climate change, with negative effects projected to affect its economy
   and food security. To address this issue, an integrative farm management
   approach such as Climate-Smart Agriculture can help reorient
   agricultural practices towards climate adaptation and food security.
   Past studies have shown that several factors can either hinder or
   encourage the adoptions of Climate-Smart practices, including subjective
   expectations and perceptions. Building on this literature, we analyze
   farmers' climate awareness and their perceptions regarding the change in
   climate patterns as well as their choices of fanning practices to adapt
   to these changes. We show that reforestation was the preferred
   adaptation strategy among interviewed farmers and that educational
   profiles and the size of landholdings drive the adoption of this and
   other practices. Soil management and introduction of new crops are
   preferred by literate farms with large farmlands, whereas illiterate
   farmers with smaller farmland tend to move towards farm intensification
   with an increase in the utilization of external inputs. Our findings
   provide evidence to support the design of capacity development
   interventions targeting specific groups of farmers according to their
   main crop and education profile.},
