Author = {Zhan, Jingyu and Hsieh, Chao-Ming and Esser, Lothar and Lang, Zabrina C.
   and Morton, Abraham J. and Robey, Robert and Zhou, Fei and Ambudkar,
   Suresh V. and Huang, Rick K. and Gottesman, Michael M. and Xia, Di},
Title = {Functional implications of the conformational landscape of a multidrug
   transporter revealed by Zebrafish Abcb4 structures},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 30},
Abstract = {The hallmark of multidrug resistance conferred by the human ABC
   transporter ABCB1 (hP-gp) is the recognition and efflux of a diverse
   range of drugs, though the precise mechanism of polyspecificity remains
   unresolved. In aquatic animals such as zebrafish, Abcb4, a functional
   homolog of hP-gp, plays a vital role in surviving environmental
   toxicants. Here, we show that DrAbcb4 exhibits comparable basal and
   drug-stimulated ATPase activity to hP-gp. Using cryo-EM, we capture five
   inward-facing DrAbcb4 conformations with varying separations between its
   two lobes, illustrating its open-and-close motion. The range of
   separation exceeds that seen in published P-gp structures that appear to
   be conformationally restricted. This global open-and-close motion is
   coupled with individual helix movement, resulting in a highly fluid
   substrate-binding pocket. These dynamic changes, likely underlying the
   polyspecificity of substrate recognition, predict unconventional
   protein-ligand interactions that are supported by structures of DrAbcb4
   bound to the P-gp inhibitors tariquidar and elacridar, and the substrate
   vincristine.},
