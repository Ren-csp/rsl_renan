@article{ WOS:001371018600006,
Author = {Fenwick, Michael K. and Pierce, Phillip G. and Abendroth, Jan and
   Barrett, Kayleigh F. and Barrett, Lynn K. and Bowatte, Kalinga and Choi,
   Ryan and Chun, Ian and Conrady, Deborah G. and Craig, Justin K. and
   Dranow, David M. and Hammerson, Bradley and Higgins, Tate and Lorimer,
   Donald D. and Lukat, Peer and Mayclin, Stephen J. and Hewitt, Stephen
   Nakazawa and Peng, Ying Po and Shanbhogue, Ashwini and Smutney, Hayden
   and Stigliano, Matthew Z. Z. and Tillery, Logan M. and Udell, Hannah S.
   and Wallace, Ellen G. and Derocher, Amy E. and Phan, Isabelle Q. and
   Staker, Bart L. and Subramanian, Sandhya and Van Voorhis, Wesley C. and
   Blankenfeldt, Wulf and Mueller, Rolf and Edwards, Thomas E. and Myler,
   Peter J.},
Title = {Exquisite selectivity of griselimycin extends to beta subunit of DNA
   polymerases from Gram-negative bacterial pathogens},
Journal = {COMMUNICATIONS BIOLOGY},
Year = {2024},
Volume = {7},
Number = {1},
Month = {DEC 5},
Abstract = {Griselimycin, a cyclic depsidecapeptide produced by Streptomyces
   griseus, is a promising lead inhibitor of the sliding clamp component of
   bacterial DNA polymerases (beta-subunit of Escherichia coli DNA pol
   III). It was previously shown to inhibit the Mycobacterium tuberculosis
   beta-clamp with remarkably high affinity and selectivity - the peptide
   lacks any interaction with the human sliding clamp. Here, we used a
   structural genomics approach to address the prospect of broader-spectrum
   inhibition, in particular of beta-clamps from Gram-negative bacterial
   targets. Fifteen crystal structures of beta-clamp orthologs were solved,
   most from Gram-negative bacteria, including eight cocrystal structures
   with griselimycin. The ensemble of structures samples widely diverse
   beta-clamp architectures and reveals unique protein-ligand interactions
   with varying degrees of complementarity. Although griselimycin clearly
   co-evolved with Gram-positive beta-clamps, binding affinity measurements
   demonstrate that the high selectivity observed previously extends to the
   Gram-negative orthologs, with KD values ranging from 7 to 496 nM for the
   wild-type orthologs considered. The collective results should aid future
   structure-guided development of peptide antibiotics against beta-clamp
   proteins of a wide variety of bacterial targets.},
