@article{ WOS:001789860600001,
Author = {Parsons, Meg and Nalau, Johanna and May, Grace},
Title = {The public mandate for equitable climate adaptation: Evidence from
   Aotearoa New Zealand},
Journal = {ENVIRONMENTAL SCIENCE \& POLICY},
Year = {2026},
Volume = {180},
Month = {JUN},
Abstract = {Climate change adaptation raises questions of justice, yet public
   perspectives on adaptation justice remain under-examined. We surveyed
   548 New Zealand residents in late 2021, complemented by 54 follow-up
   interviews, to assess attitudes toward climate adaptation through a
   justice lens. The survey covered distributive (fair outcomes),
   procedural (inclusive decision-making), recognitional (Indigenous and
   identity-based equity), and corrective (addressing historical or global
   harms) dimensions. Our findings show that respondents in our weighted
   sample broadly support climate justice principles in adaptation. Most
   respondents agreed that climate impacts are uneven and endorsed
   prioritising vulnerable communities in adaptation policies. A large
   majority assign primary responsibility for leading adaptation to the
   central government, with strong public backing for government
   interventions (e.g. funding, regulation) to ensure fair and effective
   adaptation. However, only a small minority felt able to influence
   climate policy, indicating a notable procedural justice gap. Attitudes
   also diverged on certain issues: support for Indigenous-led and Ma \&
   strns;ori-inclusive adaptation initiatives was moderate but polarised by
   political orientation and ethnicity, and many respondents hesitated
   about providing climate aid abroad (a corrective justice issue), with
   partisan divides evident. Women consistently showed higher support for
   climate justice measures than men. Climate justice concepts resonated
   across our weighted sample, but interpretations were split along
   ideological and demographic lines. These insights can inform
   policymakers seeking to design adaptation strategies that are both
   equitable and publicly supported.},
