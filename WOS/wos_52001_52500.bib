@article{ WOS:001870439500001,
Author = {Hillyer, Matthew and Martindale, Russell and Young, Steven and Sproule,
   John and Collins, Dave},
Title = {Examining the experience of psychological safety in football academies:
   Players' perspective},
Journal = {SPORTS COACHING REVIEW},
Year = {2026},
Month = {2026 SEP 10},
Abstract = {This study explored perceptions of psychological safety (PS) in Category
   3 football academies operating under the Elite Player Performance Plan
   (EPPP) in England. Four focus groups with 14 Professional Development
   Phase players were conducted through three areas: understanding PS,
   environmental features, and its applicability in academy football.
   Results identified ten sub-themes including the need to unpack the
   concept, managing new arrivals and academy transitions, supportive
   interpersonal environments, reciprocal voice, learning from mistakes,
   embracing risk-taking, coach-athlete hierarchy, authority-figure
   behaviour, results shaping safety, and thresholds within academy
   football. PS appeared embedded yet rarely named, emerging through
   behaviours and team interactions rather than formal structures. Its
   presence was conditional during transition, poor results, or heightened
   emotional demands. These findings challenge assumptions that PS is
   universally beneficial, advocating a nuanced, developmentally
   appropriate approach that balances competitive pressure with authentic
   and open interaction.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
