@article{ WOS:001573314100001,
Author = {Robilliard-Witt, Gabrielle},
Title = {The great leap outwards: Intoxicant consumption, space and the expansion
   of `urbanity' in eighteenth-century Hamburg},
Journal = {JOURNAL OF HISTORICAL GEOGRAPHY},
Year = {2025},
Volume = {90},
Pages = {27-39},
Month = {DEC},
Abstract = {This paper explores a shift in the relationship between urbanity and
   rurality in mid-eighteenth-century northern Europe. It uses the lens of
   intoxicants to examine the intersection of human everyday movement,
   consumption, leisure and sociability, and the physical natural and built
   environment as both a physical space (infrastructure) and as an
   imaginary in the city of Hamburg. Using spatial mobility analysis and
   microhistory as methods, it maps the itinerary of movement together with
   social constellations and intoxicants consumed as recorded in the
   memoirs of Johann Christian M \& uuml;ller for a threemonth-period in
   1744. It contends that by examining individual mobility (itineraries),
   it is possible to detect the expansion of urbanity into appropriated
   rural spaces as well as bucolic imaginaries. This shift in the
   conceptual and practical repertoire of urban life led, in turn, to a
   refashioning and redeployment of urban spaces, now fixated on gazing
   outwards and the visual and visceral experience of nature. It argues
   that the psychoactive revolution and new forms of leisure sociability
   situated in idealized rural idylls thus had a profound effect on how
   space was used, constructed and represented in the eighteenth century.
   (c) 2025 The Author. Published by Elsevier Ltd. This is an open access
   article under the CC BY license
   (http://creativecommons.org/licenses/by/4.0/).},
