@article{ WOS:000392280100026,
Author = {Marie, Cecile and Lemery, Didier and Vendittelli, Francoise and
   Sauvant-Rochat, Marie-Pierre},
Title = {Perception of Environmental Risks and Health Promotion Attitudes of
   French Perinatal Health Professionals},
