Title = {Integrating remote sensing and machine learning to assess
   multi-dimensional ecosystem service value of urban parks},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {97},
Month = {AUG},
Abstract = {Urban parks support sustainable cities by mitigating heat islands,
   sequestering carbon, retaining stormwater, and improving air quality.
   However, most studies evaluate these services in isolation, limiting
   their usefulness for planning and policy. We integrated remote sensing,
   field surveys, i-Tree Eco, and random forest regression with SHAP-based
   interpretation to assess the multidimensional ecosystem service value
   density of 81 parks in Xinyang, China. The estimated annual ecosystem
   service value was USD 1.87 million, of which cooling services accounted
   for 73.9\%. Across parks, the leading drivers were the proportion of
   woody plants (Pm), crown width (C), and park-shape complexity
   (SHAPE\_MN). Response patterns indicated nonlinear associations and
   servicespecific interaction effects, including an apparent optimum
   water-body proportion near 28\%. Landscape configuration and vegetation
   structure showed greater relative importance than socioeconomic or
   climatic variables. These results provide spatial, cross-sectional
   evidence for service-specific urban park management and support more
   targeted green space allocation under climate-adaptive planning.},
