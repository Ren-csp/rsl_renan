@article{ WOS:001708523100001,
Author = {Abdelfattah, Dalia and Nasreldin, Rania},
Title = {Towards inclusive public open space in CBD case study of King Abdallah
   financial district},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {1},
Pages = {486-504},
Month = {MAR},
Abstract = {The heart of a city, the central business district (CBD), is a bustling
   hub where the main commercial streets and important public buildings are
   concentrated. Over time, the CBD has transformed, going through various
   phases of development that included industrial zones, residential areas,
   commercial centers, government buildings, and entertainment districts.
   This paper aims to measure the inclusiveness of open public spaces in
   KAFD as one of the latest CBD in Riyadh city using inclusive urban
   design indicators as a measuring indicator. To achieve this aim, the
   research approved a multifaceted method. First, the research started by
   reviewing the literature about inclusive urban design and CBD concept to
   conclude that indicators used to measure inclusiveness. Second,
   different scientific methods are identified to measure inclusiveness
   such as meticulous observations, documentation, photography, mapping ...
   and lastly, hybrid questionnaire was administered to gather
   comprehensive data about user experience. The results are analyzed to
   identify key patterns and assess user perceptions of inclusion in the
   open spaces of King Abdullah Financial District (KAFD). The paper
   highlights the most significant indicators that influence the
   inclusivity of open spaces, such as sense of place and the diversity of
   physical activities.},
