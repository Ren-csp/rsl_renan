@article{ WOS:001171470400006,
Author = {Samet, Lauren and Vaterlaws-Whiteside, Helen and Upjohn, Melissa and
   Casey, Rachel},
Title = {Status of Instrument Development in the Field of Human-Animal
   Interactions \& Bonds: Ten Years On},
Journal = {SOCIETY \& ANIMALS},
Year = {2024},
Volume = {32},
Number = {1},
Pages = {74-94},
Month = {FEB},
Abstract = {The multidisciplinary nature of human -(nonhuman) animal interactions
   (HAI), and global interest in HAI development, has led to an explosion
   of research in recent years justifying the need to update previous
   reviews in the subject area. This paper reports the results of a
   systematic literature review focusing on measures of HAI created in the
   ten-year period since previous reviews ended (2008). Thirty new HAI
   questionnaires were identified using two sets of search terms. Results
   indicated that reliability and validity testing were still not standard
   within tool creation. Companion animal HAI remained dominant in the
   instrument field; however, there was continued research into exotic
   animal HAI and the initiation of research into therapy and assistance
   animal HAI. Refinement of terminology and consistent use of definitions
   could facilitate researchers from various disciplines being able to
   locate relevant research in future. Similar review updates are
   recommended for attitudes to animal tools.},
