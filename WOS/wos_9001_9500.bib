@article{ WOS:001425039900001,
Author = {Genevier, E. E. Z. and Price, C. and Evans, N. and Streicher, J. P. and
   Downs, C. T.},
Title = {Population dynamics and morphometrics of Nile monitors along a gradient
   of urbanization in KwaZulu-Natal, South Africa},
Journal = {JOURNAL OF ZOOLOGY},
Year = {2025},
Volume = {326},
Number = {1},
Pages = {23-36},
Month = {MAY},
Abstract = {Globally, with the continuous increase in human populations, land use is
   changing at an unprecedented rate. Little is known about how African
   reptiles respond to urbanization. We used mark-resight and baited camera
   traps to compare population density and demographics of Nile monitors
   (Varanus niloticus) on a gradient of land use, namely a golf course, a
   farm and a nature reserve in KwaZulu-Natal, South Africa, during
   2022-2023. We also collected detailed morphometrics on 112 Nile monitors
   throughout KwaZulu-Natal. We compared morphometric data on limbs, head,
   body and mass to establish whether the different ecological factors in
   urban and rural environments and associated behavioural shifts have
   resulted in unique phenotypes. No significant morphometric differences
   were found, but urban individuals were generally smaller and lighter
   than their rural counterparts. Population size estimates varied between
   sites. Overall, population size estimates increased with anthropogenic
   disturbance between our three focal sites, while the mean estimated
   snout-vent length decreased. The na \& iuml;ve presence of competing
   diurnal mammals did not follow a specific pattern. The overall
   insignificant variations in morphometrics in urban and rural areas of
   KwaZulu-Natal suggest that Nile monitors have adapted to urban mosaic
   landscapes with natural and managed (e.g. gardens, parks, golf courses,
   etc.) green spaces but are not as successful as some urban-exploiting
   varanids globally. Future research should investigate Nile monitor
   interactions with people and pets as well as conflict mitigation
   strategies.
   \& Agrave; l'\& eacute;chelle mondiale, avec l'augmentation continue des
   populations humaines, l'occupation des sols \& eacute;volue \& agrave;
   un rythme sans pr \& eacute;c \& eacute;dent. Il existe peu de donn \&
   eacute;es sur la fa \& ccedil;on dont les reptiles r \& eacute;agissent
   \& agrave; l'urbanisation en Afrique. Nous avons utilis \& eacute; des
   pi \& egrave;ges photographiques app \& acirc;t \& eacute;s et la m \&
   eacute;thode de marquage-r \& eacute;observation pour estimer et
   comparer les densit \& eacute;s de population et la d \&
   eacute;mographie des varans du Nil (Varanus niloticus) sur un gradient
   d'occupation du sol: un terrain de golf, une ferme et une r \&
   eacute;serve naturelle en KwaZulu-Natal, Afrique du Sud, en 2022-2023.
   Nous avons \& eacute;galement relev \& eacute; des donn \& eacute;es
   morphom \& eacute;triques d \& eacute;taill \& eacute;es sur 112 varans
   du Nil \& agrave; travers KwaZulu-Natal. Nous avons compar \& eacute;
   les donn \& eacute;es morphom \& eacute;triques sur les membres, la t \&
   ecirc;te, le corps et la masse pour \& eacute;tablir si les diff \&
   eacute;rents facteurs \& eacute;cologiques dans les environnements
   urbains et ruraux, et les changements de comportement associ \&
   eacute;s, ont conduit \& agrave; des ph \& eacute;notypes uniques.
   Aucune diff \& eacute;rence morphom \& eacute;trique significative n'a
   \& eacute;t \& eacute; constat \& eacute;e, mais les individus urbains
   \& eacute;taient g \& eacute;n \& eacute;ralement plus petits et plus l
   \& eacute;gers que leurs homologues ruraux. Nos estimations de densit \&
   eacute; de population variaient entre nos sites. Dans l'ensemble, les
   estimations de densit \& eacute; de population ont augment \& eacute;
   avec les niveaux de perturbations anthropiques de nos trois sites
   focaux, tandis que la longueur moyenne estim \& eacute;e du museau au
   cloaque a diminu \& eacute;. La pr \& eacute;sence na \& iuml;ve de
   mammif \& egrave;res diurnes concurrents ne suit pas de sch \& eacute;ma
   sp \& eacute;cifique. L'absence de variation morphom \& eacute;trique
   significative entre les zones urbaines et rurales du KwaZulu-Natal sugg
   \& egrave;re que les varans du Nil se sont adapt \& eacute;s aux milieux
   urbains comprenant des espaces verts naturels et am \& eacute;nag \&
   eacute;s (par ex. jardins, parcs, terrains de golf), mais ils persistent
   avec moins de succ \& egrave;s que d'autres varanid \& eacute;s
   exploitant les milieux urbains \& agrave; l'\& eacute;chelle mondiale.
   De futures recherches devraient explorer les interactions des varans du
   Nil avec les humains et les animaux domestiques ainsi que les strat \&
   eacute;gies de mitigation des conflits.},
