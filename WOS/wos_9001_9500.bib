@article{ WOS:001826681400001,
Author = {Salifu, Adam and Wa Lwalaba, Jonas Lwalaba and Balasha, Arsene
   Mushagalusa},
Title = {Perceptions of environmental pollution and hygienic practices among
   vegetable vendors in the mining city of Lubumbashi, Democratic Republic
   of Congo},
Journal = {ENVIRONMENTAL RESEARCH: FOOD SYSTEMS},
Year = {2026},
Volume = {3},
Number = {3},
Month = {SEP 1},
Abstract = {In developing countries, women play a crucial role in food distribution,
   yet their knowledge of food safety and awareness of environmental risks
   remain underexplored. This study examines the perceptions of
   environmental pollution and hygienic practices among 215 women vegetable
   vendors operating in major open markets in Lubumbashi, Democratic
   Republic of the Congo. Data were collected using structured
   questionnaire administered via face-to-face interviews, complemented by
   direct field observations. Findings show that vendors are aware of
   contamination risks from mining activities but underestimate hazards
   from vehicle emissions when selling vegetables by the roadside. Most
   respondents (85\%) reported the availability of portable water at the
   market, while 84\% washed vegetables before displaying them for sale;
   however, the observed hygiene practices and water handling conditions
   may compromise food safety. We observed that all vendors (99\%) reused
   the same water multiple times and applied palm oil when displaying
   tomatoes (Solanum lycopersicum)-a common practice believed to preserve
   freshness, but one that may increase the risk of microbial and
   contaminant buildup during handling and exposure. Chi-square analysis
   indicates a significant association between vendors' socio-demographic
   characteristics and their awareness of environmental pollution and
   hygiene practices (p < 0.05). These results highlight gaps in knowledge
   and practices that may exacerbate food contamination risks in a city
   heavily impacted by mining pollution. This study provides baseline data
   to inform policy and public health interventions aimed at strengthening
   vendor awareness, improving hygiene practices, and promoting safer
   vegetable supply chains.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
