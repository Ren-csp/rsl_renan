@article{ WOS:001818169500006,
Author = {Lopez, Micaela and Gentili, Jorge Osvaldo},
Title = {Hydrological Regulation and Cultural Ecosystem Services: Multifunctional
   Planning of Urban Riverfronts (Neuquen, Argentina)},
Journal = {REVISTA DE URBANISMO},
Year = {2026},
Volume = {54},
Month = {JUN},
Abstract = {Riverfronts have been consolidated as urban centralities associated with
   recreation. Their regeneration, while contributing social value, may
   compromise their multifunctionality. The aim of this study was to
   analyze the capacity of coastal public green spaces (PGS) to integrate
   hydrological regulation functions and the provision of cultural
   ecosystem services, through case studies of the Limay riverfront in the
   Neuquen Metropolitan Area (Argentina). The methodology combined
   cartographic analysis of the location of PGS in relation to flood-prone
   areas, regulations, an assessment of hydrological trends, a review of
   historical flood events, and field surveys conducted during recent
   episodes of ordinary floods induced by hydroelectric power generation
   discharges. Three typologies of coastal PGS were defined: (1)
   multifunctional; (2) non-multifunctional, non-floodable; and (3)
   non-multifunctional, floodable. However, the observed multifunctionality
   was linked mainly to morpho-topographic attributes rather than to design
   decisions. Despite the declining trend in mean river stages, the
   recurrence of induced floods affects accessibility and recreational
   uses, underscoring the need to integrate hydrological dynamics into
   planning. The use of reference flows constitutes a key tool to guide
   more flexible and adaptive urban designs.},
