@article{ WOS:000406289700003,
Author = {Soulignac, Frederic and Vincon-Leite, Brigitte and Lemaire, Bruno J. and
   Scarati Martins, Jose R. and Bonhomme, Celine and Dubois, Philippe and
   Mezemate, Yacine and Tchiguirinskaia, Ioulia and Schertzer, Daniel and
   Tassin, Bruno},
Title = {Performance Assessment of a 3D Hydrodynamic Model Using High Temporal
   Resolution Measurements in a Shallow Urban Lake},
Journal = {ENVIRONMENTAL MODELING \& ASSESSMENT},
Year = {2017},
Volume = {22},
Number = {4},
Pages = {309-322},
Month = {AUG},
Abstract = {Urban lakes provide many ecosystem services, e.g., flood control, nature
   protection, coolness island, recreation. Hydrodynamic models will
   increasingly be used to enhance these benefits. We present the first
   validation of a three-dimensional (3D) hydrodynamic model on a small
   shallow lake with high resolution and high frequency measurements. Lake
   Cr,teil, France (area 0.4 km(2), mean depth 4.5 m, and catchment area 1
   km(2)) is a former gravel pit and now part of a regional park. The model
   Delft3D-FLOW was calibrated on a one-month period, with continuous
   measurements of temperature at five depths at the center of the lake and
   at three depths at two other stations, and with current speed profiles
   at the centre of the lake. The model was then verified on 18 1-month
   periods with similar temperature measurements. The model reproduced very
   well the temperature dynamics, including the alternation between mixing
   and stratification periods and internal wave patterns. The mean absolute
   errors over the five depths at the central point remained below 0.55
   degrees C in spring and summer, the most favorable seasons for
   phytoplankton growth. Horizontal temperature differences, which rose up
   to 3 degrees C at the beginning of stratification periods, were also
   well reproduced, as well as current speeds. These results are very
   promising for assessing nutrient and pollutant diffusion, settling and
   resuspension, as well as for understanding how phytoplankton blooms
   start in small shallow lakes.},
Publisher = {SPRINGER},
