@article{ WOS:000333720300015,
Author = {Aklin, Michael and Urpelainen, Johannes},
Title = {Perceptions of scientific dissent undermine public support for
   environmental policy},
Journal = {ENVIRONMENTAL SCIENCE \& POLICY},
Year = {2014},
Volume = {38},
Pages = {173-177},
Month = {APR},
Abstract = {This article shows that even modest amounts of scientific dissent reduce
   public support for environmental policy. A survey experiment with 1000
   Americans demonstrates that small skeptical scientific minorities can
   cast significant doubt among the general public on the existence of an
   environmental problem and reduce support for addressing it. Public
   support for environmental policy is maximized when the subjects receive
   no information about the scientific debate, indicating that the general
   public's default assumption is a very high degree of scientific
   consensus. Accordingly, a stronger scientific consensus will not
   generate public support for environmental policy, unless skeptical
   voices become almost silent. (C) 2013 Elsevier Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
