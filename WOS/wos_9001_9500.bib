@article{ WOS:001761877500001,
Author = {Zhang, Wenjie and Xiao, Xirui and Wang, Xueyi and Kuang, Wei and Wu,
   Danzi},
Title = {Fine-Scale Identification of Ecological Sources and Corridors in Highly
   Urbanized Areas},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2026},
Volume = {12},
Month = {MAY 11},
Abstract = {Rapid urbanization has led to the fragmentation of ecological spaces
   within built-up areas, where remaining green patches are increasingly
   isolated by transportation networks and construction projects. This has
   compromised ecosystem integrity and connectivity. Conventional
   approaches for identifying ecological sources and corridors-often
   developed for large-scale regions-prove inadequate in addressing the
   fine-grained complexity and persistent disturbances characteristic of
   highly urbanized landscapes. To bridge this gap, this study develops a
   refined methodology tailored for ecological source and corridor
   identification in dense urban settings, using Beijing's built-up area as
   a case study. The approach integrates multisource remote sensing
   classification with optimized morphological spatial pattern analysis and
   systematic park registry corrections, improving the accuracy and
   applicability of ecological source mapping. Application of this method
   identified 353.29 km(2) of ecological sources, accounting for 18.38\% of
   the study area, and delineated 1,705 effective ecological patches larger
   than 0.03 km(2). A composite resistance surface was constructed
   incorporating habitat structure, transportation networks, population
   density, and building intensity, weighted via the analytic hierarchy
   process. This surface revealed a ``high-resistance core, low-resistance
   periphery{''} pattern, with resistance values diffusing radially along
   major transport corridors. By integrating circuit theory with
   graph-based network analysis, 282 ecological corridors were identified
   and evaluated, forming a 2-tier ``path-network{''} structure that
   clarifies the functional hierarchy of corridors within the urban
   ecological network. The findings offer insights for green infrastructure
   planning, optimization of urban ecological security patterns, and
   targeted policymaking in densely built areas, while providing a
   transferable framework for sustainable ecological management in cities
   worldwide.},
