@article{ WOS:001815633900001,
Author = {Yang, Fei and Wang, Lei and Lin, Youhui and Zhang, Tianlin and Wang,
   Hongcheng and Li, Jiaying},
Title = {Are there seasonal differences in supply and demand for blue-green space
   cooling in cities with hot summers and cold winters? - A case study from
   Tianjin, China},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {148},
Month = {SEP 15},
Abstract = {Urban blue-green spaces can mitigate surface temperatures within their
   spatial extent, thereby alleviating heatrelated health risks and
   reducing exposure to extreme heat under intensified urban heat island
   conditions. Previous studies have evaluated the cooling efficiency of
   blue-green spaces by quantifying cooling supply and demand during hot
   summers. However, these investigations have largely focused on summer,
   leaving seasonal dynamics of cooling supply-demand relationships
   insufficiently explored. This study develops a dynamic indicator
   framework to capture seasonal variations in cooling supply and demand,
   using the central districts of Tianjin, a high-density northern Chinese
   city with a distinct four-season climate, as a case study. Results show
   that (1) cooling supply and demand are primarily determined by urban
   heat/cold island characteristics, blue-green infrastructure and
   population aggregation, and building HVAC attributes; (2) cooling
   supply-demand levels remain below basic coordination across all seasons,
   with spatial configurations in spring, summer, and autumn differing
   markedly from winter; and (3) dynamic optimization can be achieved by
   differentiating between seasonally stable and seasonally fluctuating
   supply-demand areas. These findings provide a basis for developing
   seasonally adaptive strategies to enhance the cooling efficiency of
   urban blue-green spaces.},
