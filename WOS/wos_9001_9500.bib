@article{ WOS:001812798100001,
Author = {Zukerman, Yuval and Bird, Tania and Berger-Tal, Oded},
Title = {The impacts of different visitor management strategies on wildlife
   activity in a popular desert nature reserve},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2026},
Volume = {8},
Number = {8},
Month = {AUG},
Abstract = {Water sources in desert ecosystems are critical for wildlife survival,
   but they may also attract thousands of visitors, creating potential
   conflicts between humans and wildlife. Effective management strategies
   are essential to support human-wildlife coexistence in these fragile
   arid environments, allowing for sustainable tourism while minimizing
   human impact. However, data on wildlife responses to visitors and on the
   effectiveness of management strategies remain limited. In this study, we
   evaluated two management approaches: limiting visitor numbers and
   establishing visitor-free zones. We placed six camera traps around water
   pools in a highly visited nature reserve in a hyper-arid region. Cameras
   were set in both accessible and restricted areas during the summer of
   2023. A temporary closure of the reserve following a tragic rockfall
   provided a unique opportunity to assess the effects of reduced
   visitation. Our findings revealed species-specific responses to visitor
   presence. Nubian ibex (Capra nubiana) reduced activity when more
   visitors were present, but only in accessible zones. Red foxes (Vulpes
   vulpes) increased activity in high-visitor areas. Rock hyraxes (Procavia
   capensis) preferred restricted zones regardless of visitor numbers,
   while Blanford's foxes (Vulpes cana) reduced activity with increased
   human presence regardless of the location. Arabian wolves (Canis lupus
   arabs) and Indian crested porcupines (Hystrix indica) showed little or
   no response. Despite these varied patterns, most species preferred
   drinking in areas with fewer visitors. These results highlight the
   importance of combining management strategies to protect a broad range
   of species. At the same time, they emphasize the need to clearly define
   conservation targets in nature reserves to guide and prioritize
   effective management actions accordingly.},
