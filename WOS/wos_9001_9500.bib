   Moradi, Lily, Univ Technol Sydney, Sydney, Australia.
   Biloria, Nimish, Univ Technol Sydney, Fac Design Architecture Bldg, Sydney, Australia.},
DOI = {10.1080/10630732.2025.2468142},
EarlyAccessDate = {MAY 2025},
ISSN = {1063-0732},
