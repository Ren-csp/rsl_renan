Author = {Kempker, Jordan A. and Magee, Matthew J. and Cegielski, J. Peter and
   Martin, Greg S.},
Title = {Associations Between Vitamin D Level and Hospitalizations With and
   Without an Infection in a National Cohort of Medicare Beneficiaries},
Journal = {AMERICAN JOURNAL OF EPIDEMIOLOGY},
