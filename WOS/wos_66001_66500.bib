@article{ WOS:000382452900029,
Author = {Yao, Jian and Chow, David Hou Chi and Chi, Yu-Wei},
Title = {Impact of Manually Controlled Solar Shades on Indoor Visual Comfort},
Journal = {SUSTAINABILITY},
