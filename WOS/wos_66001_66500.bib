@article{ WOS:001552223400001,
Author = {Gallagher, Rachel and Sigler, Thomas and Wyeth, Stephanie and Liu, Yan},
Title = {Do housing preferences reduce feasibility of densification? Perspectives
   of planning and development experts and residents},
Journal = {AUSTRALIAN PLANNER},
Year = {2025},
Volume = {61},
Number = {2},
Pages = {62-76},
Month = {APR 3},
Abstract = {In suburban nations, a tendency toward detached, single-family houses
   means that limited alternatives exist, despite upzoning efforts aimed at
   densifying existing communities. In this paper, we test the relative
   importance of location and dwelling type in the Australian context.
   Specifically, we focus on how the general public and city shapers, such
   as professional planners, developers, and politicians, perceive location
   and dwelling characteristics when choosing where to live, and how these
   perceptions align with their actual living arrangements, and strategic
   planning goals. A survey of 705 respondents showed a clear preference
   for location over dwelling type. While our findings suggest that a
   strong attachment to detached houses can be softened by well-designed,
   larger apartments and rowhouses in established suburbs, even the most
   ardent supporters of densification continued to reside in large,
   detached houses. This suggests a disconnect between stated planning
   values and personal housing choices, where support for densification
   stems from a position of privilege that shifts responsibility for change
   onto others.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
