@article{ WOS:000248118300051,
Author = {Frederick, Kendra King and Marlow, Michael S. and Valentine, Kathleen G.
   and Wand, A. Joshua},
Title = {Conformational entropy in molecular recognition by proteins},
Journal = {NATURE},
Year = {2007},
Volume = {448},
Number = {7151},
Pages = {325-U3},
Month = {JUL 19},
Abstract = {Molecular recognition by proteins is fundamental to almost every
   biological process, particularly the protein associations underlying
   cellular signal transduction. Understanding the basis for
   protein-protein interactions requires the full characterization of the
   thermodynamics of their association. Historically it has been virtually
   impossible to experimentally estimate changes in protein conformational
   entropy, a potentially important component of the free energy of protein
   association. However, nuclear magnetic resonance spectroscopy has
   emerged as a powerful tool for characterizing the dynamics of proteins.
   Here we employ changes in conformational dynamics as a proxy for
   corresponding changes in conformational entropy. We find that the change
   in internal dynamics of the protein calmodulin varies significantly on
   binding a variety of target domains. Surprisingly, the apparent change
   in the corresponding conformational entropy is linearly related to the
   change in the overall binding entropy. This indicates that changes in
   protein conformational entropy can contribute significantly to the free
   energy of protein-ligand association.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
