@article{ WOS:001836289600001,
Author = {Pham-Truffert, Myriam and Angst, Mario},
Title = {Core-periphery divide: perceived obstacles to modal shift in Swiss urban
   transport systems along the urban gradient},
Journal = {ENVIRONMENTAL RESEARCH: INFRASTRUCTURE AND SUSTAINABILITY},
Year = {2026},
Volume = {6},
Number = {3},
Month = {SEP 30},
Abstract = {Transforming urban transport has the potential to drive decarbonisation
   to mitigate climate change globally while still meeting people's local
   needs. A key component of urban transport transformations is encouraging
   modal shifts from motorised individual traffic to public transport or
   active mobility. Recent discussions have stressed that effective urban
   sustainability policy should be more receptive to differences between
   urban cores and their peripheries, from a spatial justice angle. We thus
   ask: How does a citizen's position on the urban gradient influence their
   perceived advantages and disadvantages of cycling, public transport, and
   car use? This study combines computer-assisted qualitative topic
   identification and multilevel multinomial multivariate Bayesian
   regression models to analyse survey data (n) = 822 on public perceptions
   of cycling, public transport, and car use in five major Swiss cities.
   After adjusting for the main confounding effects (e.g. income or age
   distributions), we find some, but likely only small effects of the urban
   gradient on most perceived (dis)advantages. Our results reveal only five
   likely total effects of the urban gradient on the occurrence of modal
   (dis)advantage topics. Specifically, moving outward from the city,
   public transit is perceived as more relaxing but less practical.
   Meanwhile, the convenience of using a car to transport people or goods
   is valued more highly by those living in the urban core. In terms of
   modal disadvantages, car-related costs and travel time or distance by
   bike are more likely perceived as disadvantages in the periphery. Our
   results highlight the importance of context-sensitive interventions in
   built transport infrastructure and targeted appeals to social norms
   (e.g. climate concerns). Ultimately, policy interventions to encourage
   modal shifts should be sensitive to both varying socio-demographic
   profiles and infrastructural differences along the urban gradient.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
