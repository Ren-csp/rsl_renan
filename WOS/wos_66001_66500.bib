@article{ WOS:001767894200001,
Author = {Dou, Baozhu and Li, Kexin and Tan, Xiaoshan and Han, Zhe and Huang,
   Yuxing and Wang, Xiao and Zhang, Junjie and Peng, Zhao and Hu, Ying},
Title = {Synergistic control of maize stalk rot using Allomyrina
   dichotoma gut-derived biocontrol bacteria with reduced fungicide
   application},
Journal = {BIOLOGICAL CONTROL},
Year = {2026},
Volume = {217},
Month = {JUN},
Abstract = {Maize stalk rot caused by Fusarium spp. significantly reduces maize
   yield and quality. Although chemical fungicides are widely used for
   disease control, their overuse raises concerns regarding environmental
   contamination, risks to human and animal health, and the emergence of
   fungicide resistance. Thus, integrating biological control agents with
   reduced fungicide inputs may provide a more sustainable management
   strategy. In this study, three gut-derived bacterial strains (RH2, TH2,
   and TM1) isolated from Allomyrina dichotoma showed strong antagonistic
   activity against Fusarium graminearum. Based on rpoB gene sequence
   analysis, all three strains were identified as Bacillus velezensis. The
   strains also promoted maize growth through indole-3-acetic acid
   production and inhibited F. graminearum spore germination and hyphal
   development. To select a fungicide suitable for combined application
   with these biocontrol strains, nine fungicides were screened in vitro
   against F. graminearum. Fludioxonil was identified as the most suitable
   candidate because it showed the highest anti-fungal activity (EC50 =
   0.056 mg/L) without inhibiting the growth of the three Bacillus strains
   at the effective concentration. Combination treatments consisting of
   reduced doses of fludioxonil and each bacterial strain significantly
   suppressed fungal mycelial growth in vitro. In greenhouse experiments,
   these integrated treatments provided better control of maize stalk rot
   than either treatment alone. Notably, strain TH2 showed the strongest
   performance in combination with fludioxonil, and a 50\% reduced dose of
   fludioxonil combined with TH2 was more effective than fludioxonil alone
   applied at a 75\% reduced dose. Overall, these results demonstrate a
   synergistic interaction between fludioxonil and B. velezensis,
   especially TH2, and support their use as an effective approach for
   controlling maize stalk rot while reducing fungicide input.},
