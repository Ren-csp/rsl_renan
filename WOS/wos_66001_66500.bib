@article{ WOS:000381496900006,
Author = {Schymanski, Stanislaus J. and Or, Dani},
Title = {Wind increases leaf water use efficiency},
Journal = {PLANT CELL AND ENVIRONMENT},
Year = {2016},
Volume = {39},
