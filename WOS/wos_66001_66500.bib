@incollection{ WOS:000538689200010,
Author = {Menezes, Marluci and Arvanitidis, Paschalis and Costa, Carlos Smaniotto
   and Weinstein, Zvi},
Editor = {Costa, CS and Erjavec, IS and Kenna, T and DeLange, M and Ioannidis, K and Maksymiuk, G and DeWaal, M},
Title = {Teenagers' Perception of Public Spaces and Their Practices in ICTs Uses},
Booktitle = {CYBERPARKS - THE INTERFACE BETWEEN PEOPLE, PLACES AND TECHNOLOGY: NEW
   APPROACHES AND PERSPECTIVES},
