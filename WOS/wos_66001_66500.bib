@article{ WOS:001131806800001,
Author = {Bilfinger, Laura and Brummernhenrich, Benjamin and Jucks, Regina},
Title = {Is it Up to Me or Them? Insights from an Experimental Study on
   Psychological Reactance Towards Climate Change Mitigation Appeals},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2024},
Volume = {18},
Number = {4},
Pages = {418-434},
Month = {MAY 18},
Abstract = {This study posits the hypothesis that the lack of an individual's
   engagement in mitigating climate change might be due to reactance, a
   motivational psychological state that occurs when one's perceived
   freedom to think or act is being threatened. In a 2 x 2 between-subjects
   experimental design (N = 623), we varied how mitigation recommendations
   for transportation were communicated (individual vs. policy appeal) in
   an online article. Additionally, we manipulated how directly the need to
   act was stressed (high- vs. low-controlling language). Outcome measures
   to capture reactance were perceived threat to freedom, counterarguing,
   and support for recommended mitigation efforts. Participants in the
