@article{ WOS:000658724200013,
Author = {Jia, Yicong and Jin, Shan and Hu, Kunkun and Geng, Lei and Han, Caihong
   and Kang, Ruxue and Pang, Yuxin and Ling, Erjun and Tan, Eng King and
   Pan, Yufeng and Liu, Wei},
Title = {Gut microbiome modulates Drosophila aggression through octopamine
   signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {MAY 11},
Abstract = {Gut microbiome profoundly affects many aspects of host physiology and
   behaviors. Here we report that gut microbiome modulates aggressive
   behaviors in Drosophila. We found that germ-free males showed
   substantial decrease in inter-male aggression, which could be rescued by
   microbial re-colonization. These germ-free males are not as competitive
   as wild-type males for mating with females, although they displayed
   regular levels of locomotor and courtship behaviors. We further found
   that Drosophila microbiome interacted with diet during a critical
   developmental period for the proper expression of octopamine and
   manifestation of aggression in adult males. These findings provide
   insights into how gut microbiome modulates specific host behaviors
   through interaction with diet during development. The gut microbiome
   regulates behaviour in a number of species. Here the authors show that
   depletion of the gut microbiome in Drosophila reduced aggressive
   behaviour, in an octopamine-dependent manner.},
