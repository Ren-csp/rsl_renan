@article{ WOS:000623573800001,
Author = {Tartaglia, Jennifer and McIntosh, Michelle and Jancey, Jonine and Scott,
   Jane and Begley, Andrea},
Title = {Exploring Feeding Practices and Food Literacy in Parents with Young
   Children from Disadvantaged Areas},
