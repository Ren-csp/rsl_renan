@article{ WOS:001619040200001,
Author = {Liang, Qingqing and Wu, Haozhen and Miao, Jing},
Title = {Understanding university students' engagement with WeChat official
   accounts: a uses and gratifications perspective},
Journal = {COGENT EDUCATION},
Year = {2025},
Volume = {12},
Number = {1},
Month = {DEC 31},
Abstract = {As the `primary new media' on campuses, WeChat Official Accounts (WOAs)
   play a crucial role in shaping user engagement dynamics, which can guide
   their optimization and enhance the reach and impact of ideological and
   political education. Based on Uses and Gratifications Theory, a
   theoretical model of user engagement with university WOAs was developed
   and tested using quantitative methods. The target group for the
   questionnaire survey comprised university students, and a total of 389
   valid questionnaires were collected. Utilitarian gratification,
   affection gratification, social gratification, and personal integration
   gratification all significantly influence user engagement with
   university WOAs. Specifically, information seeking, hedonic
   gratification, emotional fulfillment, social interaction, social
   influence, disclosure, and peer recognition emerged as key drivers of
   user engagement. These findings suggest that universities should
   prioritize content practicality and its capacity to fulfill students'
   personal integration needs when managing WOAs. Additionally,
   incorporating more interactive content can strengthen the platform's
   social attributes.},
