@article{ WOS:001820915100022,
Author = {Fang, Yuan and Wang, Zhaoyun and Li, Wenjing and Wu, Ji and Chen, Jing
   and Xu, Qiutao and Hsiang, Tom and Chen, Xiaoyang},
Title = {A fungal subtilase-like protease SBT1 blocks rice immunity by erasing
   the MAPKKKα signaling node},
Journal = {SCIENCE ADVANCES},
Year = {2026},
Volume = {12},
Number = {29},
Month = {JUL 15},
Abstract = {Rice (Oryza sativa) is highly susceptible to a variety of devastating
   fungal diseases. However, whether these phylogenetically distinct fungal
   pathogens employ conserved effectors to disrupt common immune hubs
   remains unclear. Here, we identify a conserved virulence strategy in
   which multiple rice-infecting fungal pathogens employ a subtilisin-like
   protease effector, SBT1, to suppress host immunity. Upon secretion into
   plant cells, SBT1 directly targets the key immune signaling component
   OsMAPKKK alpha and mediates its degradation in a proteolytic
   activity-dependent manner. OsMAPKKK alpha acts in a linear signaling
   cascade: it is phosphorylated and stabilized by OsRLCK185 at Thr493, and
   subsequently phosphorylates OsMKK4 to activate downstream MAPK
   signaling. By degrading OsMAPKKK alpha, SBT1 disrupts the
   chitin-triggered immune signaling transduced through the
   OsCERK1-OsRLCK185-OsMAPKKK alpha-OsMKK4 module. Importantly,
   host-induced gene silencing (HIGS) targeting SBT1 confers broad-spectrum
   resistance against multiple fungal pathogens. Our study unveils a
   previously unexplored pathogen strategy wherein a secreted effector
   protease dismantles a central signaling node, and identifies OsMAPKKK
   alpha as a promising target for engineering disease-resistant crops.},
