@article{ WOS:000626150900008,
Author = {Millan, Margara},
Title = {Intersectionality, Decolonization and Anti-systemic Trans-critique: The
   Political Subject of Feminisms and ``the Women who Fight{''}},
Journal = {REVISTA MEXICANA DE CIENCIAS POLITICAS Y SOCIALES},
Year = {2020},
Volume = {65},
Number = {240},
Pages = {207-232},
Month = {SEP-DEC},
Abstract = {This essay seeks to provide an account of the emergence of recent
   women's movements, the centrality of ``feminisms{''} brought forth by
   these movements and the communicating vessels and displacements that
   constitute what I call a theoretical-practical arc of feminist critical
   thought. In the first part, I describe the mark of women protesting
   worldwide as a moment that synthesizes various local processes into a
   characterization of the world we live in. The second part delves deeper
   into feminist critical thought based on the concept of ``gender{''}.
   Lastly, back to the latest mobilizations of women and their written
   production and forms of communication, I outline the contents of a
   polymorphous and prolific political subject, whose enunciations display
   an intersectional and intersected praxis that at times achieves a common
   language and a singular political form developed from the experience,
   the pain, the empathy, the affection and the outrage within the current
   context of civilizational crisis.},
Publisher = {UNAM, FAC CIENCIAS POLITICAS \& SOCIALES},
Address = {CIUDAD UNIV, DIV ESTUDIOS POSGRADO, CIRCUITO MARIO DE LA CUEVA, MEXICO
   CITY DF, CP 04510, MEXICO},
Type = {Article},
Language = {Spanish},
Affiliation = {Millán, M (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias Polit \& Sociales, Ctr Estudios Latinoamer, Mexico City, DF, Mexico.
   Millan, Margara, Univ Nacl Autonoma Mexico, Fac Ciencias Polit \& Sociales, Ctr Estudios Latinoamer, Mexico City, DF, Mexico.},
DOI = {10.22201/fcpys.2448492xe.2020.240.76628},
ISSN = {0185-1918},
Keywords = {feminism; political subject; intersectionality; social transformation},
