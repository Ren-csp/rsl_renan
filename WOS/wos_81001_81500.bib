@article{ WOS:000441465600006,
Author = {Ozorio, Lucia},
Title = {MIGRATION, BIOGRAPHIC RESEARCH AND COMMUNIZATION OF LIFE
   EXPERIENCES},
Journal = {POLEM!CA},
Year = {2018},
Volume = {18},
Number = {1},
Pages = {84-93},
Abstract = {We reflect on the community issues and the migration process, that is,
   on the alliances of this process with the construction of a common in
   the world. The experience of mobility needs to be understood from life
   experiences, a perspective that gives importance to the dialogical
   encounter with the actors of this process. The oral life stories in
   common as a research device, of resistance, allows to deepen this
   perspective. As a device of biopolitics, it has as a golden key the
   production of subjectivities that seeks to respond to the urgencies of a
   common in the present. We seek to bet on the revolutionary potential of
   memory in its connections with the common, reservoir of heterogenesis,
   seeking to intervene in a kidnapped and overcoded memory that wants to
   silence the differences. Work with the immanent field of memory
   permeated by the common allows the emergence of the revolutionary powers
   of immemorial affections that call for liberation experiences,
   contributing to the reconstruction of oneself and of a common in the
   world, producing subjectivities.},
