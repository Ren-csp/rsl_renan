@article{ WOS:000654932800001,
Author = {Wei, Lu and Lee, Tien-Tsung},
Title = {Who Can I Trust in a Scary World? An Examination of the Objects of
   Trust, Information Sources and Social Distancing Intention Amid COVID-19},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {10},
Month = {MAY},
Abstract = {Trust is a central construct of social research. While numerous studies
   have investigated trust as either a dependent or independent variable,
   little attention has been paid to its relationship with health-related
   behaviors in the context of a public health crisis. How trust in
   different entities influences people's social distancing intention is
   therefore an important question that merits academic scrutiny. Moreover,
   the relationship between trust and social distancing intention cannot be
   well understood without an account of the information environment. As
   previous studies have reached a consensus about the limited effects of
   information exposure on individual outcomes, this research focuses on
   possible moderating effects. Results show that information exposure, no
   matter via interpersonal or media sources, has no direct effects on
   behavioral intention. Rather, risk communication serves as a moderator
   of the relationship between trust and social distancing intention.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Lee, TT (Corresponding Author), Univ Macau, Fac Social Sci, Dept Commun, Taipa, Macao, Peoples R China.
