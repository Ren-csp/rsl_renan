@article{ WOS:000383785400009,
Author = {Guedes de Oliveira, Rebeca Nunes and Gessner, Rafaela and de Souza,
   Vaaia and Godoy Serpa da Fonseca, Rosa Maria},
Title = {Limits and possibilities of an online game for building adolescents'
   knowledge of sexuality},
Journal = {CIENCIA \& SAUDE COLETIVA},
Year = {2016},
Volume = {21},
Number = {8},
Pages = {2383-2392},
Month = {AUG},
Abstract = {This study looks at the limits and possibilities of an online game
   designed to build knowledge and awareness in adolescents in the field of
   affections, sexuality and reproduction. It evaluates the experience of a
   group of teenagers with a game called Papo Reto ('Straight Talk'), over
   a period of three months. A total of 23 teenagers aged 15 to 18 took
   part in the study. The data were collected in two workshops held at a
   secondary school in the city of Sao Paulo (Sao Paulo State), Brazil. The
   dialogs were recorded and transcribed, and their content analyzed. The
   results showed a variety of possibilities of the Straight Talk online
   game for reconstruction of knowledge in the field of sexuality, and for
   helping the subject perceive and analyze the complexity of reality from
   a gender point of view. The subjects covered in the game were assessed,
   as motivating factors for the game and for the interaction. Adjustments
   were suggested for inclusion of elements to create a more ludic quality,
   more interaction, in the game.},
