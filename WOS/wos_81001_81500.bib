@article{ WOS:001440955500007,
Author = {Leon-Carrascosa, Victor and Bone, Ana Carmen Munoz and Guillen,
   Esmeralda},
Title = {Educational and family guidance: importance, satisfaction and functions
   of the family},
Journal = {COMUNICACION Y HOMBRE},
Year = {2024},
Number = {21},
Pages = {197-211},
Abstract = {Family is considered one of the most important institution of society.
   In spite of the constant historical, cultural, economic and social
   changes, family always remains. The main goal of this research is to
   discover the belief of 2464 people about the importance, the level of
   satisfaction and the most important functions of the Spanish family with
   the intention of establishing training strategies aimed at a better
   development of educational and family guidance in schools, according to
   the surveys developed by the Sociological Research Center (Research
   number 3032). The results obtained considered the family to be very
   important, in addition to giving it a high degree of satisfaction.
   Regarding the main functions most valued by those surveyed are related
   with the affection and the relationship between family members and the
   nurturing and educating the children. Given the characteristics of this
   study, it is considered as a first approximation to be able to begin to
   design interventions in education on the real needs and characteristics
   of families that reinforce even more this permanent, essential social
   institution.},
