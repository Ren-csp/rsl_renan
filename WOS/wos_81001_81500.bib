   Epstein, Richard A., New York Univ, Sch Law, New York, NY 10012 USA.},
DOI = {10.1017/bpp.2024.54},
EarlyAccessDate = {MAY 2025},
ISSN = {2398-063X},
EISSN = {2398-0648},
Keywords = {disabilities; firm structure; inclusive fitness; incompetence; nudges;
   preferences; variations},
