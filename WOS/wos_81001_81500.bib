@article{ WOS:001878585800001,
Author = {Mellal, Mohammed Khalil and Chelli, Abdelmadjid and Boutekrabt, Rabah
   and Turner, Sarah E. and Weladji, Robert B. and Khelifa, Rassim},
Title = {Conflict between farmers and Barbary macaques (Macaca sylvanus)
   in Northern Algeria: threats and conservation implications},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {SEP 16},
Abstract = {Human-wildlife conflict is a major challenge in conservation biology
   with ecological and socioeconomic consequences. The problem is
   particularly delicate when the animals involved are threatened with
   extinction and experiencing rapid habitat loss due to climate change and
   anthropogenic actions. Here, we examined crop-foraging on farms in
   Central North Algeria by the Endangered Barbary macaques (Macaca
   sylvanus) to understand the conflict severity. We surveyed 94 farmers to
   assess the seasonal pattern, occurrence, altitudinal pattern, and
   consequences of crop-foraging by the Barbary macaques. We found that the
   Barbary macaque was widely perceived by farmers as a ``nuisance{''}, and
   one third of farms were abandoned due to severe crop loss. More than
   50\% of farms had their crops damaged between June and September. The
   probability of frequent crop-foraging was driven primarily by farm-scale
   characteristics and landscape context: Larger cultivated area were
   associated with greater crop-foraging frequency, while altitude and
   proximity to settlements showed weaker positive associations. Our
   results highlight the need for sustainable solutions to enhance the
   coexistence between humans and Barbary macaques in the region.},
