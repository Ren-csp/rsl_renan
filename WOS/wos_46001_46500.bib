@article{ WOS:001867669500001,
Author = {Jatileni, Malakia and Havu-Nuutinen, Sari and Waltzer, Katariina},
Title = {Teacher-perceived multi-level influences on preparedness for inclusive
   vocational education in Namibia: basic prevocational skills course
   implementation},
Journal = {COGENT EDUCATION},
Year = {2026},
Volume = {13},
Number = {1},
Month = {DEC 31},
Abstract = {Inclusive vocational education remains challenging in Namibia, where
   learners with diverse needs continue to experience unequal access to
   vocational learning opportunities. The Basic Prevocational Skills Course
   (BPVSC) was introduced to develop practical and foundational skills
   supporting employability, independent living and progression to further
   training. Although teachers are central to implementation, limited
   research has examined how they perceive preparedness for inclusive
   vocational teaching. This study examines teacher-perceived multi-level
   influences on preparedness for BPVSC implementation. Using qualitative,
   theory-informed content analysis, it analyses open-ended survey
   responses from 29 teachers across four regions in Namibia. The analysis
   focuses on perceived psychological, institutional and systemic
   influences, with institutional and policy processes interpreted through
   teachers' written responses. The findings suggest strong normative
   commitment to inclusion, alongside variation in confidence and perceived
   capability. Participants described tensions between inclusive intentions
   and classroom practice, linked to limited self-efficacy, resource
   constraints and uncertainty about adapting practical vocational tasks.
   Leadership practices, collegial relationships and institutional routines
   were described as enabling or constraining professional agency, while
   policy misalignment, uneven resource distribution and deficit-oriented
   perceptions of vocational education were perceived as shaping
   implementation. The study identifies sustained professional learning,
   supportive school conditions, coordinated implementation and
   policy-resource alignment as necessary for strengthening inclusive
   vocational education.},
Publisher = {TAYLOR \& FRANCIS LTD},
