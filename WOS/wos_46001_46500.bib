@article{ WOS:001790843700001,
Author = {Dilkes-Hoffman, Leela and Laycock, Bronwyn and Pratt, Steven and Ross,
   Helen and Lant, Paul},
Title = {An investigation of attitudes toward plastics in four countries-The
   public is concerned and wants solutions},
Journal = {CELL REPORTS SUSTAINABILITY},
Year = {2026},
Volume = {3},
Number = {5},
Month = {MAY 22},
Abstract = {Plastics are indispensable modern materials; however, their growing use
   imposes environmental costs. The public is a key stakeholder in
   addressing these sustainability challenges, but public attitudes and
   perceptions toward plastics remain inadequately understood. This study
   surveys over 4,000 respondents (more than 1,000 per country) in the
   Netherlands, Australia, India, and the Philippines to investigate public
   attitudes toward plastics and potential acceptance of mitigation and
   management strategies. Results show that across all four countries,
   respondents express concern about the environmental and health impacts
   of plastics and a desire for effective solutions. In a nine-item
   assessment of environmental issues, items related to plastics receive
   the highest mean seriousness scores on average. This consensus is unique
   to plastics. While there is broad support for a range of solutions,
   transformative solutions (such as selling products without any
   packaging) receive less support than recycling and material
   substitution.},
