@article{ WOS:001090433600001,
Author = {Negash, Asfaw and Hustings, Jeroen and Robert, Allyson and Genene,
   Zewdneh and Yilma, Desalegn and Schreurs, Dieter and Mathijs, Michiel
   and Liesenborgs, Jori and Van Reeth, Frank and Vandewal, Koen and Mammo,
   Wendimagen and Admassie, Shimelis and Maes, Wouter and Manca, Jean V.},
Title = {Exploring the High-Temperature Window of Operation for Organic
   Photovoltaics: A Combined Experimental and Simulations Study},
Journal = {ADVANCED FUNCTIONAL MATERIALS},
Year = {2024},
Volume = {34},
Number = {6},
Month = {FEB},
Abstract = {The global climate change negatively affects the photovoltaic
   performance of traditional solar cell technologies. This article
   investigates the potential of organic photovoltaics (OPV) for
   high-temperature environments, ranging from urban hot summers (30-40
   degrees C) and desert regions (65 degrees C) up to (aero) space
   conditions (130 degrees C), the thermal window in which OPV can operate.
   The approach is based on a combination of experiments and simulations up
   to 180 degrees C, moving significantly beyond the conventional
   temperature ranges reported in the literature. New
   2H-benzo{[}d]{[}1,2,3]triazole-5,6-dicarboxylic imide-based copolymers
   with decomposition onset temperatures above 340 degrees C are used for
   this study, in combination with non-fullerene acceptors. Contrary to
   their inorganic counterparts, OPV devices show a positive temperature
   coefficient up to approximate to 90 degrees C. At temperatures of 150
   degrees C, they are still operational, retaining their room temperature
   efficiency. Complementary simulations are performed using an in-house
   developed software package that numerically solves the drift-diffusion
   equations to understand the general trends in the obtained
   current-voltage characteristics and the materials' intrinsic behavior as
   a function of temperature. The presented methodology of combined
   high-temperature experiments and simulations can be further applied to
   investigate the thermal window of operation for other OPV material
   systems, opening novel high-temperature application routes.
   The potential of organic photovoltaics (OPV) for extremely
   high-temperature applications on Earth and in space is explored through
   a combined experimental and simulations study up to 180 degrees C.
   Contrary to their inorganic counterparts, the investigated OPV shows a
   positive temperature coefficient up to approximate to 90 degrees C. At
   temperatures of 150 degrees C, they are still operational, retaining
   their room temperature efficiency.image},
