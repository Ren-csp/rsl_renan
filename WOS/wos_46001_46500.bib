@article{ WOS:001877352000001,
Author = {Knutsson, Susanne and Bergh, Johan and Horberg, Ulrica},
Title = {The forest as a health-promoting place-the meaning for seniors of
   playing padel in the forest: a qualitative study},
Journal = {INTERNATIONAL JOURNAL OF QUALITATIVE STUDIES ON HEALTH AND WELL-BEING},
Year = {2026},
Volume = {21},
Number = {1},
Month = {DEC 31},
Abstract = {Purpose There is evidence of a clear connection between health and
   exposure to nature; however, many older people today miss out on the
   opportunities offered by the forest. The purpose of this study is
   therefore to describe and understand the meaning for seniors (aged 65
   years or older) of playing padel at a court located in the forest.Method
   Interviews with eight seniors who had played padel in the forest. The
   methodological and interpretation framework was based on Gadamer's
   hermeneutic philosophy.Results The seniors described that they
   experienced joy, calmness, connection with nature, meaningful social
   interaction, and enhanced wellbeing when playing padel in the forest.
   Four themes with subthemes were identified: Playing padel in the forest
   brings out the ability to see and feel the underlying beauty in hitting
   a ball; brings out the ability to actually see and appreciate the
   existence of the forest; gives a sense of an existing concealed natural
   healing power in the forest; and gives a sense of belonging.Discussion
   There is a mutual dependence between activity and place, and playing
   padel in the forest reveals an awareness of one's own basic values, the
   values that give meaning to life, which can constitute motives for one's
   own, others and the forest's health and wellbeing, as nature and humans
   are seen as a wholeness. These values and motives form one's energy
   source for health-promoting actions.},
