Title = {Shotgun transcriptome, spatial omics, and isothermal profiling of
   SARS-CoV-2 infection reveals unique host responses, viral
   diversification, and drug interactions},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
