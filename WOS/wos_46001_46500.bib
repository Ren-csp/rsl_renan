@article{ WOS:001875717000001,
Author = {Arameshiyan, Shahla and Yunesian, Masud and Oliyaimanesh, Alireza and
   Amini, Najmeh Almolouk and Ashoorkhani, Mahnaz},
Title = {Socioeconomic Determinants Associated With Overweight and Obesity in
   Adults in Southern Tehran: A Cross-Sectional Study},
Journal = {HEALTH SCIENCE REPORTS},
Year = {2026},
Volume = {9},
Number = {9},
Month = {SEP 15},
Abstract = {Background and Aims Overweight and obesity represent major public health
   challenges shaped by social, economic, behavioral, and environmental
   determinants. This study aimed to identify socioeconomic factors
   associated with overweight and obesity among adults living in southern
   Tehran in order to inform targeted, context-specific prevention
   strategies.Methods This cross-sectional study included 800 adults aged
   18-64 years selected through stratified random sampling from 28
   comprehensive health service centers affiliated with Tehran University
   of Medical Sciences. Data were collected via structured telephone
   interviews using a validated questionnaire. Anthropometric measures were
   self-reported. Statistical analyses included chi 2 tests and binary
   multiple logistic regression. Odds ratios (ORs) with 95\% confidence
   intervals (CIs) were estimated, using a two-sided significance level of
   0.05.Results Overweight and obesity were significantly associated with
   age, gender, marital status, educational attainment, employment status,
   economic status, place of residence, physical activity, and active
   transportation. Higher economic status was associated with increased
   odds of overweight/obesity (high: AOR = 2.04; moderate: AOR = 1.52). In
   contrast, higher levels of physical activity and active transportation
   showed inverse association with overweight and obesity. No significant
   associations were observed with private vehicle ownership, access to
   parks and green spaces, housing conditions, or access to physician and
   nutritionist services.Conclusion Socioeconomic determinants play a
   pivotal role in shaping overweight and obesity among adults in southern
   Tehran. Modifiable factors, particularly physical activity and active
   transportation, should be prioritized in obesity prevention strategies.
   Public health policies aimed at enhancing neighborhood safety, improving
   walking and cycling infrastructure, and increasing awareness of
   lifestyle-related risks may contribute to reducing obesity prevalence in
   socioeconomically diverse urban settings. Importantly, effective and
   sustainable implementation of these measures requires strong political
   commitment and intersectoral collaboration across health,
   transportation, urban planning, and community development sectors.},
