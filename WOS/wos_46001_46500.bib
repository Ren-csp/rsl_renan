@article{ WOS:001274152000001,
Author = {Feliu, Ariadna and Barrera, Bibiana and Drury, Amanda and Hancean,
   Marian-Gabriel and Geanta, Marius and Koczkodaj, Pawel and Pinto,
   Patricia and Pla, Marga and Tchalakov, Ivan and Vuckovic, Helena and
