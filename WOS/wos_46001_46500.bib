@article{ WOS:001878569200001,
Author = {Widmer, Lena Ursina and Eriksen, Christine},
Title = {Experiencing wildfire, understanding risk in mountain regions of
   Switzerland: a case study of the 2023 Riederhorn wildfire},
Journal = {FIRE ECOLOGY},
Year = {2026},
Volume = {22},
Number = {1},
Month = {JUL 23},
Abstract = {Wildfire risk in Switzerland is expected to increase in the future due
   to a hotter and drier climate and more extreme weather events. This
   makes community-level preparedness and coping capacity increasingly
   important. This article focuses on the 2023 wildfire on the Riederhorn
   mountain in Canton Valais as a case study of a Swiss mountain community
   directly impacted by wildfire. Through narrative analysis of
   semi-structured interviews conducted with local residents and
   professionals managing the event (n = 12), the article explores peoples'
   experiences of the wildfire and how these experiences influence
   understandings of risk. The results show that peoples' perceptions are
   shaped by sensory impressions, emotional responses, and embodied
   memories, which are often linked to community cohesion and sense of
   agency. Experiencing the Riederhorn wildfire increased local awareness
   of risk in the short-term, but its long-term effects arguably depend on
   collective narratives and institutional practices. The article concludes
   by highlighting the benefits of strengthening community agency and
   integrating emotional dimensions and volunteerism into Swiss wildfire
   governance and hazards management.
   Se espera que el riesgo de incendios de vegetaci \& oacute;n se
   incremente en Suiza debido a condiciones clim \& aacute;ticas m \&
   aacute;s c \& aacute;lidas y secas, y a eventos meteorol \& oacute;gicos
   m \& aacute;s extremos. Esto hace que la preparaci \& oacute;n para
   afrontar estos eventos y la capacidad de adaptarse a esas condiciones a
   nivel de las comunidades humanas sean incrementalmente cada vez m \&
   aacute;s importantes. Este art \& iacute;culo se enfoca en el incendio
   de las monta \& ntilde;as de Riederhorn en el cant \& oacute;n de
   Valais, como un estudio de caso en una comunidad monta \& ntilde;esa
   Suiza directamente impactada por un incendio de vegetaci \& oacute;n. A
   trav \& eacute;s de un an \& aacute;lisis narrativo basado en
   entrevistas semi-estructuradas realizadas a residentes locales y
   profesionales que manejaron ese evento (n = 12), este art \& iacute;culo
   explora las experiencias de las personas en cuanto al incendio, y sobre
   c \& oacute;mo esas experiencias influencian la percepci \& oacute;n del
   riesgo. Los resultados muestran que las percepciones de las personas est
   \& aacute;n moldeadas por impresiones sensoriales, respuestas
   emocionales y encarnadas en los recuerdos, que est \& aacute;n
   frecuentemente ligadas a la cohesi \& oacute;n de la comunidad y su
   sentido o sensaci \& oacute;n de control. El haber experimentado el
   incendio de Riederhorn increment \& oacute; la concientizaci \& oacute;n
   de la comunidad local sobre el riesgo en el corto plazo, aunque los
   efectos a largo plazo dependen presuntamente de narrativas colectivas y
   de pr \& aacute;cticas institucionales. El art \& iacute;culo concluye
   subrayando los beneficios de fortalecer el sentido del control
   colectivo, e integrar las dimensiones emocionales y el voluntarismo en
   la gobernanza y el manejo de riesgos por parte de las autoridades
   suizas.},
