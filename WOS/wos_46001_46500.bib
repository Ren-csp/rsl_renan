Author = {Rela, Iskandar Zainuddin and Awang, Abd Hair and Ramli, Zaimah and Ali,
   Mohd Nor Shahizan and Manaf, Azima Abdul},
Title = {Corporate social responsibility practice and its effects on community
   well-being in Southeast Sulawesi, Indonesia},
