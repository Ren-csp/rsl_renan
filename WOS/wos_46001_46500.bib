@article{ WOS:000831685000001,
Author = {Kim, Siyeon and Lee, Meesung and Yu, Ilhan and Son, JeongWook},
Title = {Key Initiatives for Digital Transformation, Green New Deal and Recovery
   after COVID-19 within the Construction Industry in Korea},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {14},
Month = {JUL},
Abstract = {The low productivity of the construction industry has been identified as
   a chronic problem, and this has been exacerbated by recent environmental
   factors, including COVID-19 and climate change. As a response to these
   environmental changes, policies related to recovery after COVID-19,
   digital transformation, and the Green New Deal have been established
   worldwide, and related projects have been launched. These three issues
   may seem to have different goals but they are interrelated, and
   guidelines for the direction of the construction industry should be
   outlined. In this study, key initiatives that need to be prioritized to
   successfully achieve the goals of the three issues are identified. Based
   on these, strategic directions and mid- to long-term measures to address
   environmental changes are suggested. This study surveys the perceptions
   of construction experts to establish the key initiatives via the
   analytic hierarchy process method, and their expected utility was
   evaluated. This study is significant in that it analyzes how
   construction experts perceive environmental changes and contributes to
   the development of the construction industry by identifying key
   initiatives that should be undertaken.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Son, J (Corresponding Author), Ewha Womans Univ, Dept Architectural \& Urban Syst Engn, 52 Ewhayeodae Gil, Seoul 03760, South Korea.
   Kim, Siyeon; Lee, Meesung; Son, JeongWook, Ewha Womans Univ, Dept Architectural \& Urban Syst Engn, 52 Ewhayeodae Gil, Seoul 03760, South Korea.
   Yu, Ilhan, Korea Res Inst Construct Policy, 15 Boramae Ro 5 Gil, Seoul 07071, South Korea.},
DOI = {10.3390/su14148726},
Article-Number = {8726},
