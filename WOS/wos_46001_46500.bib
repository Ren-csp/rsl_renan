@article{ WOS:001844593500001,
Author = {Kato, Takumi and Chiba, Yuki and Hattori, Ami and Ikeda, Ryosuke and
   Koizumi, Masaki},
Title = {Preserving the vitality and atmosphere of a city: how the silent
   majority rates the attractiveness of children's voices and temple bell
   sounds},
Journal = {SOCIAL INFLUENCE},
Year = {2026},
Volume = {21},
Number = {1},
Month = {DEC 31},
Abstract = {While temple bell sounds and children's voices add atmosphere and
   vitality to cities, complaints about these sounds are increasing. This
   study examines the psychological mechanisms underlying complaints about
   noise pollution near parks and temples. Two randomised control trials,
   each with a unique sample of 2,000 Japanese participants, were
   conducted. The results demonstrate that the spread of social media has
   upended the spiral of silence theory, resulting in disregard for the
   silent majority's opinions. Utilizing cognitive dissonance theory
   insights, the negative impact of women's trade-off between careers and
   pregnancy is extended to complaints about children's voices. The study
   finds that women who gave up pregnancy for their careers have difficulty
   accepting children's voices.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
