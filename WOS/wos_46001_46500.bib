@article{ WOS:000443797400009,
Author = {Xu, Xiaohong Ruby and Wang, Yiming and Adili, Reheman and Ju, Lining and
   Spring, Christopher M. and Jin, Joseph Wuxun and Yang, Hong and Neves,
   Miguel A. D. and Chen, Pingguo and Yang, Yan and Lei, Xi and Chen,
   Yunfeng and Gallant, Reid C. and Xu, Miao and Zhang, Hailong and Song,
   Jina and Ke, Peifeng and Zhang, Dan and Carrim, Naadiya and Yu, Si-Yang
   and Zhu, Guangheng and She, Yi-Min and Cyr, Terry and Fu, Wenbin and
   Liu, Guoqing and Connelly, Philip W. and Rand, Margaret L. and Adeli,
   Khosrow and Freedman, John and Lee, Jeffrey E. and Tso, Patrick and
   Marchese, Patrizia and Davidson, W. Sean and Jackson, Shaun P. and Zhu,
   Cheng and Ruggeri, Zaverio M. and Ni, Heyu},
Title = {Apolipoprotein A-IV binds αIIbβ3 integrin and inhibits thrombosis},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {SEP 6},
Abstract = {Platelet alpha IIb beta 3 integrin and its ligands are essential for
   thrombosis and hemostasis, and play key roles in myocardial infarction
   and stroke. Here we show that apolipoprotein A-IV (apoA-IV) can be
   isolated from human blood plasma using platelet beta 3 integrin-coated
   beads. Binding of apoA-IV to platelets requires activation of alpha IIb
   beta 3 integrin, and the direct apoA-IV-alpha IIb beta 3 interaction can
   be detected using a single-molecule Biomembrane Force Probe. We identify
   that aspartic acids 5 and 13 at the N-terminus of apoA-IV are required
   for binding to alpha IIb beta 3 integrin, which is additionally
   modulated by apoA-IV C-terminus via intra-molecular interactions.
   ApoA-IV inhibits platelet aggregation and postprandial platelet
   hyperactivity. Human apoA-IV plasma levels show a circadian rhythm that
   negatively correlates with platelet aggregation and cardiovascular
   events. Thus, we identify apoA-IV as a novel ligand of alpha IIb beta 3
   integrin and an endogenous inhibitor of thrombosis, establishing a link
   between lipoprotein metabolism and cardiovascular diseases.},
