@article{ WOS:000596932600001,
Author = {Gade, Christian B. N.},
Title = {Is restorative justice punishment?},
Journal = {CONFLICT RESOLUTION QUARTERLY},
Year = {2021},
Volume = {38},
Number = {3},
Pages = {127-155},
Month = {MAR},
Abstract = {This article has two objectives, both of which are new. First, it
   presents a new framework of punishment in nine dimensions, which makes
   it possible to distinguish systematically between different
   conceptualizations of the nature of punishment. Second, using the
   framework, it discusses the relationship between restorative justice and
   punishment, showing that some cases of restorative justice constitute
   punishment from the perspectives of some of the punishment positions in
   the framework but not for others. Thus, according to some positions,
   restorative justice (mediation, conferences, circles, etc.) is
   punishment.},
