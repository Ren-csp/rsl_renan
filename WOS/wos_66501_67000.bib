@article{ WOS:000385250300003,
Author = {Bowie, Rauri C. K. and Fjeldsa, Jon and Kiure, Jacob and Kristensen, Jan
   Bolding},
Title = {A new member of the greater double-collared sunbird complex
   (Passeriformes: Nectariniidae) from the Eastern Arc Mountains of Africa},
