@article{ WOS:000973217500001,
Author = {Berg, Stephanie M. and Wammer, Kristine H. and Remucal, Christina K.},
Title = {Dissolved Organic Matter Photoreactivity Is Determined by Its Optical
   Properties, Redox Activity, and Molecular Composition},
Journal = {ENVIRONMENTAL SCIENCE \& TECHNOLOGY},
