@article{ WOS:001667781300003,
Author = {Bersier, Ludivine and Lorenzo-Martin, L. Francisco and Chiang, Yi-Hsuan
   and Durot, Stephan and Czauderna, Aleksander and Yarahmadov, Tural and
   Wyss Lozano, Tania and Roci, Irena and Kim, Jaeryung and Zamboni, Nicola
   and Vannini, Nicola and Pot, Caroline and Collet, Tinh-Hai and Stroka,
   Deborah and Bernier-Latmani, Jeremiah and Lutolf, Matthias P. and
   Becattini, Simone and Koessler, Thibaud and Petrova, Tatiana V.},
Title = {Chemotherapy-driven intestinal dysbiosis and indole-3-propionic acid
   rewire myelopoiesis to promote a metastasis-refractory state},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {17},
Number = {1},
Month = {DEC 15},
Abstract = {The contribution of chemotherapy-induced tissue injury to individual
   susceptibility to metastasis remains largely unexplored. We report that
   chemotherapy indirectly prevents colorectal cancer (CRC) liver
   metastases by inducing a lasting systemic ``chemomemory{''}.
   Chemotherapy-induced intestinal mucositis alters nutrient availability,
   promoting the expansion of tryptophan-metabolizing bacteria and
   production of the microbial metabolite indole-3-propionic acid (IPA).
   IPA reprograms bone marrow myelopoiesis by redirecting common myeloid
   progenitor fate toward the macrophage lineage, limiting generation of
   immunosuppressive Ly6ChighCCR2+ monocytes. This shift enhances CD4+ T
   cell antitumor function by promoting Th1 differentiation and spatially
   reorganizing CD8+ and CD4+ T cell interactions within the metastatic
   microenvironment. In a subset of CRC patients, circulating IPA levels
   increase after chemotherapy and inversely correlate with monocyte
   abundance, while high monocyte levels were associated with reduced
   survival. Our findings reveal that chemotherapy-induced intestinal
   injury normalizes pathological myelopoiesis through a microbiota-derived
   metabolite and identify IPA as a potential adjuvant to counteract
   monocyte-driven immunosuppression and metastasis.},
