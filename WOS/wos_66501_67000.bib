@article{ WOS:001433642300001,
Author = {Petraroli, Irene and Nagahama, Akiha and Baars, Roger C. and Terumoto,
   Kiyomine},
Title = {Ready for the worst: awaiting disaster in ageing rural Japan},
Journal = {DISASTERS},
Year = {2025},
Volume = {49},
Number = {2},
Month = {FEB 27},
Abstract = {Inami, a small seaside town in Wakayama Prefecture, Japan, is getting
   ready for the next Nankai Trough earthquake, which is expected to
   involve multiple events of magnitude 7.0+ on the maximum seismic
   intensity scale, causing landslides and tsunamis. This paper is
   concerned with the capabilities and challenges of an elderly community
   in this highly prepared rural town. The results show that the continued
   mainstreaming of disaster preparedness practices has led to widespread
   awareness of evacuation sites and basic knowledge of disaster evacuation
   needs. Arguably, however, insufficient support is provided to the
   elderly as current procedures often do not consider how their reduced
   mobility, physical strength, and psychological discomfort might impact
   on evacuation itself and life at the shelters. This paper contributes to
   the literature on disaster and vulnerability by critically assessing and
   expanding on perceptions of ageing and disasters in rural areas vis-\&
   agrave;-vis the traditional depiction of the elderly as `vulnerable and
   helpless'.},
