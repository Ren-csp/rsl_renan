@article{ WOS:000275366100037,
Author = {Hare, Stephen and Gupta, Saumya Shree and Valkov, Eugene and Engelman,
   Alan and Cherepanov, Peter},
Title = {Retroviral intasome assembly and inhibition of DNA strand transfer},
