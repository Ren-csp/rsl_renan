@article{ WOS:001222316200008,
Author = {Ruhland, Eric and Siemers, Malte and Gerst, Ruman and Spaeth, Felix and
   Vogt, Laura Nicole and Figge, Marc Thilo and Papenfort, Kai and
   Froehlich, Kathrin Sophie},
Title = {The global RNA-RNA interactome of Klebsiella pneumoniae unveils a
   small RNA regulator of cell division},
