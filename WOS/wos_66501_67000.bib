@article{ WOS:001758834300001,
Author = {Jones, Max Dolton and Smith, Samantha Nicole and Averill-Murray, Roy C.
   and Goode, Matt},
Title = {Living on the edge: How do tiger rattlesnakes (Crotalus tigris) navigate
   a residential golf course development?},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2026},
Volume = {8},
Number = {6},
Month = {JUN},
Abstract = {Outdoor recreation and the infrastructure that supports it can impose a
   wide range of effects on wildlife, and impacts can vary in their
   severity based on taxa, the surrounding landscape matrix, and the manner
   in which recreational spaces are managed. Previous research has
   suggested that golf courses can provide important resources for wildlife
   while also contributing to negative human-wildlife interactions,
   creating an interesting ecological paradox. We set out to investigate
   how tiger rattlesnakes (Crotalus tigris) respond to landscape changes
   due to increasing infrastructure around a golf course in an arid system.
   Using a long-term telemetry dataset on 67 individuals, we used dynamic
   Brownian Bridge Movement Models (dBBMMs) and resource selection
   functions to identify changes in space-use and habitat association in
   relation to anthropogenic pressures (i.e., golf courses, roads, and
   houses). Our results were mixed, but we found that tiger rattlesnakes
   selected for areas near to golf courses and natural areas across all
   development stages at the population level. In addition, the dBBMMs
   indicated apparent trajectories that circumnavigated golf courses
   throughout the landscape, further supporting the paradoxical impact of
   golf courses. These results suggest that tiger rattlesnakes in a largely
   modified area are able to persist by restricting their movements and
   space-use and selecting edge areas adjacent to golf courses (i.e., rough
   areas) that may provide resources such as prey, shelter, and water. Our
   study may prove useful to landscape managers by identifying where
   conservation-based measures could be targeted.},
