@article{ WOS:000426049100002,
Author = {Kapadia, Bandish and Nanaji, Nahid M. and Bhalla, Kavita and Bhandary,
   Binny and Lapidus, Rena and Beheshti, Afshin and Evens, Andrew M. and
   Gartenhaus, Ronald B.},
Title = {Fatty Acid Synthase induced S6Kinase facilitates USP11-eIF4B complex
   formation for sustained oncogenic translation in DLBCL},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {FEB 26},
Abstract = {Altered lipid metabolism and aberrant protein translation are strongly
   associated with cancerous outgrowth; however, the inter-regulation of
   these key processes is still underexplored in diffuse large B-cell
   lymphoma (DLBCL). Although fatty acid synthase (FASN) activity is
   reported to positively correlate with PI3K-Akt-mTOR pathway that can
   modulate protein synthesis, the precise impact of FASN inhibition on
   this process is still unknown. Herein, we demonstrate that attenuating
   FASN expression or its activity significantly reduces eIF4B (eukaryotic
   initiation factor 4B) levels and consequently overall protein
   translation. Through biochemical studies, we identified eIF4B as a
   bonafide substrate of USP11, which stabilizes and enhances eIF4B
   activity. Employing both pharmacological and genetic approaches, we
   establish that FASN-induced PI3K-S6Kinase signaling phosphorylates USP11
   enhancing its interaction with eIF4B and thereby promoting oncogenic
   translation.},
