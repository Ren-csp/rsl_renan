@article{ WOS:001214996000001,
Author = {Holden, Petra and Anderson, Molly and Eckardt, Frank and Ziervogel, Gina
   and Jack, Samuel L. and New, Mark G. and Smit, Julian and Visser,
   Martine and Hoffman, M. Timm},
Title = {Importance of methodological pluralism in deriving counterfactuals for
   evidence-based conservation},
Journal = {CONSERVATION BIOLOGY},
Year = {2024},
Volume = {38},
Number = {3},
Month = {JUN},
Abstract = {Most protected area impact research that uses counterfactuals draws
   heavily on quantitative methods, data, and knowledge types, making it
   valuable in producing generalizations but limited in temporal scope,
   historical detail, and habitat diversity and coverage of ecosystem
   services. We devised a methodological pluralistic approach, which
   supports social science qualitative methods, narratives, mixed methods,
   and interdisciplinarity, to fully unlock the potential of
   counterfactuals in ensuring a place-based and detailed understanding of
   the socioecological context and impacts of protected areas. We applied
   this approach to derive possible counterfactual conditions for the
   impact of a montane protected area on 40 years of vegetation change in
   the Cape Floristic Region-a global biodiversity hotspot and UNESCO World
   Heritage Site in South Africa. We incorporated diverse methods,
   knowledge, and information sources, drawing on before-after protected
   area comparisons for inside and outside the protected area. A
   significant increase in shrubland vegetation (17-30\%) was observed and
   attributed primarily to a decline in frequent burning for grazing. This
   also occurred outside the protected area and was driven by socioeconomic
   drivers and not by concerns over biodiversity conservation or land
   degradation. Had the protected area not been established the area would
   have seen intensification of cultivation and increased road networks,
   buildings, and water storage in dams. Our approach increased historical
   temporal coverage of socioecological change and contextualized
   assumptions around causality. Protected area impact evaluation should
   reengage in place-based research that fully incorporates pluralism in
   methodologies for constructing counterfactuals in a way that builds
   regional and global understanding from the local level upward. We
   devised 10 key principles for deriving counterfactuals grounded in
   methodological pluralism, covering aspects of collaboration, cocreation,
   inter- and transdisciplinarity, diverse values and lived experiences,
   multiple knowledge types, multiple possible causal mechanisms, social
   science qualitative methods, perceptions, perspectives, and narratives.
   Importancia del pluralismo metodol \& oacute;gico en la derivaci \&
   oacute;n de situaciones contrafactuales para la conservaci \& oacute;n
   basada en evidencias La mayor \& iacute;a de las investigaciones sobre
   el impacto de las \& aacute;reas protegidas que usan situaciones
   contrafactuales se basan en gran medida en m \& eacute;todos
   cuantitativos, datos y tipos de conocimiento, por lo que son muy
   valiosas para producir generalizaciones, pero limitadas en el enfoque
   temporal, el detalle hist \& oacute;rico y la diversidad de h \&
   aacute;bitats y cobertura de los servicios ambientales. Dise \&
   ntilde;amos una estrategia metodol \& oacute;gica pluralista, la cual
   apoya los m \& eacute;todos cualitativos de las ciencias sociales,
   narrativas, m \& eacute;todos mixtos e interdisciplinarios para utilizar
   por completo el potencial de las situaciones contrafactuales para
   asegurar un conocimiento detallado y basado en el lugar del contexto
   socio ecol \& oacute;gico y el impacto de las \& aacute;reas protegidas.
   Aplicamos esta estrategia para derivar las posibles condiciones
   contrafactuales del impacto de un \& aacute;rea protegida monta \&
   ntilde;osa sobre 40 a \& ntilde;os de cambio de vegetaci \& oacute;n en
   el reino flor \& iacute;stico del Cabo - un punto caliente de
   biodiversidad y Sitio de Patrimonio Mundial de la UNESCO en Sud \&
   aacute;frica. Incorporamos varios m \& eacute;todos, conocimientos y
   fuentes de informaci \& oacute;n a partir de las comparaciones
   antes-despu \& eacute;s dentro y fuera del \& aacute;rea protegida.
   Observamos un incremento significativo en la vegetaci \& oacute;n del
   matorral (17-30\%), el cual atribuimos principalmente en la disminuci \&
   oacute;n de la quema frecuente para el pastoreo. Esto tambi \& eacute;n
   ocurri \& oacute; fuera del \& aacute;rea protegida y fue causado por
   factores socioecon \& oacute;micos y no por preocupaci \& oacute;n por
   la conservaci \& oacute;n de la biodiversidad o por la degradaci \&
   oacute;n del suelo. De no haberse establecido el \& aacute;rea
   protegida, la zona habr \& iacute;a sufrido una intensificaci \&
   oacute;n de cultivos y un incremento de carreteras, edificios y
   almacenamiento de agua en presas. Nuestra estrategia increment \&
   oacute; la cobertura hist \& oacute;rica temporal del cambio socio-ecol
   \& oacute;gico y contextualiz \& oacute; las suposiciones sobre la
   causalidad. La evaluaci \& oacute;n del impacto del \& aacute;rea
   protegida debe volver a la investigaci \& oacute;n basada en el lugar
   que incorpora de lleno el pluralismo en la metodolog \& iacute;a para
   construir situaciones contrafactuales de una forma que genere
   conocimiento regional y global a partir del nivel local y hacia arriba.
   Dise \& ntilde;amos diez principios clave para derivar las situaciones
   contrafactuales basados en el pluralismo metodol \& oacute;gico, la
   cobertura de los aspectos de colaboraci \& oacute;n, creaci \& oacute;n
   conjunta, inter- y transdisciplinariedad, valores diversos y
   experiencias vividas, varios tipos de conocimiento, diferentes
   mecanismos causales posibles, m \& eacute;todos cualitativos de las
   ciencias sociales, percepciones, perspectivas, historias y narrativas.
