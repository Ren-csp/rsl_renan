@article{ WOS:000819837700002,
Author = {Martinez, Diego Stefani T. and Ellis, Laura-Jayne A. and Da Silva,
   Gabriela H. and Petry, Romana and Medeiros, Aline M. Z. and Davoudi,
   Hossein Hayat and Papadiamantis, Anastasios G. and Fazzio, Adalberto and
