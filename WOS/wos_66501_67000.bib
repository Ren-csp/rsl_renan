@article{ WOS:000957425700001,
Author = {Xie, Weizhen and Zhang, Weiwei},
Title = {Effortfulness of Visual Working Memory: Gauged by Physical Exertion},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-GENERAL},
Year = {2023},
