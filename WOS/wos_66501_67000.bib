@article{ WOS:001509069900001,
Author = {Velez, Michelle and Roedel, Mark-Oliver and Carvajal, Vladimir and
   Donoso, David A. and Guerra, Monica A.},
Title = {First report of flesh-fly (Diptera: Sarcophagidae) myiasis in
   little-devil poison frog (Anura: Dendrobatidae) from Ecuador},
Journal = {INTERNATIONAL JOURNAL FOR PARASITOLOGY-PARASITES AND WILDLIFE},
Year = {2025},
Volume = {27},
Month = {AUG},
Abstract = {We report a case of myiasis in the poison frog Oophaga sylvatica from
   the Canande<acute accent> Reserve located in the Choco<acute accent>
   region of northwestern Ecuador. We identified the causal agents as
   larvae of flesh flies, Sarcophagidae, by means of DNA barcoding and
   morphological features. This represents the first record of myiasis in
   an anuran in Ecuador and the second record for Dendrobatidae in the
   Neotropics. This observation may constitute a case of facultative
   parasitism where larvae are deposited in the frog's wounds, but further
   research is needed to understand the biological mechanisms underlying
   this interaction.},
