@article{ WOS:001257271900001,
Author = {Thimm, Viola},
Title = {Reconfiguring gender, kinship, and spirituality: space- and place-making
   in Muslim Malaysia},
Journal = {JOURNAL OF THE ROYAL ANTHROPOLOGICAL INSTITUTE},
Year = {2025},
Volume = {31},
Number = {1},
Pages = {82-99},
Month = {MAR},
Abstract = {In the public and private spaces of Malaysia's capitalist cities, Malay
   women abide by a stricter Islamic dress code than they do in rural
   areas. Hence, in this local context, spatial public/private and
   `placial' rural/urban order are of importance for gender identifications
   and practices. These orders imply influences on gendered forms of
   embodiment in the form of dress codes. This research examines the
   sociocultural constitutions of space and place in Malaysia regarding
   their relatedness to one another. The central argument states (1) that
   public space in Muslim contexts is defined as a social space in which
   men and women who are eligible to marry (non-mahram) encounter each
   other; and (2) that these relations are perceived and practised
   differently in urban and rural public and private spaces. This implies
   that the public-private divide is based significantly on gendered
   kinship relations: that is, concepts of family.
   Reconfigurer le genre, la parent \& eacute; et la spiritualit \& eacute;
   : cr \& eacute;ation d'espaces et de lieux en Malaisie musulmaneR \&
   eacute;sum \& eacute;Dans les espaces publics et priv \& eacute;s des
   grandes villes capitalistes de Malaisie, les femmes se plient \& agrave;
   un code vestimentaire islamique plus strict que dans les r \&
   eacute;gions rurales. Dans ce contexte local, l'ordre public/priv \&
   eacute; de l'espace et l'ordre rural/urbain du lieu sont importants pour
   l'identification et les pratiques genr \& eacute;es et influent sur les
   formes genr \& eacute;es d'incorporation, en l'occurrence les codes
   vestimentaires. L'autrice examine la constitution socioculturelle de
   l'espace et du lieu en Malaisie et les liens entre l'un et l'autre. Ses
   arguments principaux sont (1) que l'espace public dans les contextes
   islamiques se d \& eacute;finit comme un espace social, dans lequel se
   rencontrent des hommes et des femmes \& agrave; marier (non-mahram), et
   (2) que ces relations sont per \& ccedil;ues et mises en pratique diff
   \& eacute;remment dans les espaces urbains et ruraux, qu'ils soient
   publics ou priv \& eacute;s. Il en d \& eacute;coule que la division
   entre public et priv \& eacute; se fonde, de fa \& ccedil;on
   significative, sur des liens de parent \& eacute; genr \& eacute;e,
   autrement dit sur des concepts de famille.},
