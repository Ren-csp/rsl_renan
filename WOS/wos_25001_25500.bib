@article{ WOS:000412602500005,
Author = {Cristaldi, Maximiliano A. and Giraudo, Alejandro R. and Arzamendia,
   Vanesa and Bellini, Gisela P. and Claus, Juan},
Title = {Urbanization impacts on the trophic guild composition of bird
   communities},
Journal = {JOURNAL OF NATURAL HISTORY},
Year = {2017},
Volume = {51},
Number = {39-40},
Pages = {2385-2404},
Abstract = {Urbanization transforms the landscape and generates loss of pristine
   habitats. We investigated the urbanization effect on bird communities in
   a growing South American city (Santa Fe, Argentina) and hypothesized
   that if habitat structure and human disturbance change along an urban
   gradient, the richness and abundance of trophic guilds should also vary
   accordingly. We placed 50 transects 100 m long x 50 m wide in five
   districts with different levels of urbanization, determined by habitat
   structure variables. We recorded the number and abundance of species and
