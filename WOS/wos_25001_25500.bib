@article{ WOS:001294442100065,
Author = {Katsavounidou, Garyfallia},
Title = {Distance Teaching Urban Design and Planning Studio Courses during the
   Pandemic: Challenges and Lessons Learnt},
Journal = {JOURNAL OF PLANNING EDUCATION AND RESEARCH},
Year = {2024},
Volume = {44},
Number = {3},
Pages = {1109-1121},
Month = {SEP},
Abstract = {Urban design and planning studios presented considerable challenges to
   teach remotely following the outbreak of COVID-19 pandemic. Planning is
   space-based and requires real-life experience, and existing virtual
   teaching platforms can hardly re-create the studio atmosphere. This
   paper presents an empirical study, via surveys and interviews, on how
   instructors in Greek universities, where online teaching carried on for
   three semesters, adjusted studio courses to remote teaching. Findings
   are organized into three rubrics: Resilience, Interaction, and
   Surprises. Results show that planning pedagogy needs to maintain
   problem-based methodologies, that existing platforms should be designed
   to better emulate the studio atmosphere, and that inviting guest
   speakers online is a practice that will remain post-pandemic.
   Los estudios de dise \& ntilde;o y planificaci \& oacute;n urbana
   presentaron desaf \& iacute;os considerables para ense \& ntilde;ar de
   forma remota despu \& eacute;s del brote de la pandemia de COVID-19. La
   planificaci \& oacute;n se basa en el espacio y requiere experiencia de
   la vida real, y las plataformas de ense \& ntilde;anza virtual
   existentes dif \& iacute;cilmente pueden recrear la atm \& oacute;sfera
   del estudio. Este art \& iacute;culo presenta un estudio emp \&
   iacute;rico, a trav \& eacute;s de encuestas y entrevistas, sobre c \&
   oacute;mo los instructores en las universidades griegas, donde la ense
   \& ntilde;anza en l \& iacute;nea se llev \& oacute; a cabo durante tres
   semestres, ajustaron los cursos de estudio a la ense \& ntilde;anza
   remota. Los hallazgos se organizan en tres r \& uacute;bricas:
   Resiliencia, Interacci \& oacute;n y Sorpresas. Los resultados muestran
   que la pedagog \& iacute;a de la planificaci \& oacute;n debe mantener
   metodolog \& iacute;as basadas en problemas, que las plataformas
   existentes deben dise \& ntilde;arse para emular mejor la atm \&
   oacute;sfera del estudio y que invitar a oradores invitados en l \&
   iacute;nea es una pr \& aacute;ctica que permanecer \& aacute; despu \&
   eacute;s de la pandemia.
