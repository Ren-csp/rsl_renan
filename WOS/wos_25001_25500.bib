Number = {2, SI},
Pages = {281-292},
Month = {FEB 1},
Abstract = {This text delves into the impacts and challenges associated with street
   skateboarding in S \& atilde;o Paulo city's (Brazil) emerging financial
   centers. Adopting an ethnographic perspective, it uncovers how
   skateboarders contest the established norms of private spaces, typically
   defined by uniformity and stability, through their techniques,
   perceptions, approaches, and experiences. In doing so, they play a
   pivotal role in reimagining these spaces as practiced places,
   introducing novel interpretations and symbolic meanings.},
