@article{ WOS:000572347100010,
Author = {Mony, Laetitia and Stroebel, David and Isacoff, Ehud Y.},
Title = {Dimer interaction in the Hv1 proton channel},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2020},
Volume = {117},
Number = {34},
