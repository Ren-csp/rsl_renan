@article{ WOS:001085098600001,
Author = {Richard, Theodoor A. M. and Pai, Hui-Chuan},
Title = {Catching the Urban Atmosphere of Taichung, Taiwan},
Journal = {VISUAL ANTHROPOLOGY REVIEW},
