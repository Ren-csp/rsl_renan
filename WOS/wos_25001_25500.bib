   Garcias, Paulo Mello},
Title = {CHANGES IN THE FOREST CODE: AN INSTITUTIONAL ANALYSIS OF THE PERCEPTION
   OF AGRICULTURAL PRODUCERS IN A CITY IN THE STATE OF PARANA},
Journal = {REVISTA DE GESTAO AMBIENTAL E SUSTENTABILIDADE-GEAS},
