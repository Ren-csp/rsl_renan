Title = {Sellers of unpasteurized animal milk in unregulated markets: a key
   factor for human brucellosis control in El-Oued province, Algeria},
Journal = {PAN AFRICAN MEDICAL JOURNAL},
Year = {2025},
Volume = {51},
Month = {AUG 19},
Abstract = {Brucellosis is one of the most important worldwide zoonoses affecting
   both livestock and humans. This letter focuses on the phenomenon of
   selling raw milk in popular markets as a risk factor for brucellosis
   outbreaks in a country in northern Africa. Fighting unpasteurized milk
   sellers is an urgent necessity and a key factor for human brucellosis
   control and protecting public health. This is especially relevant for
   low-income (LI) countries. All of this is in line with the one health
   approach, which emphasizes the interaction between human health, animal
   health and environmental health.},
