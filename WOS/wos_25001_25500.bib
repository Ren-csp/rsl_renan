@article{ WOS:001744440500001,
Author = {Bianchi, Daniel and Cabrera, Leopoldo},
Title = {The academic performance of fourth-grade students from rural and urban
   backgrounds in Spain: the role of the digital divide and socioeconomic
   inequality},
Journal = {BORDON-REVISTA DE PEDAGOGIA},
Year = {2026},
Volume = {78},
Number = {1},
Pages = {71-89},
Abstract = {INTRODUCTION. Rural schools face multiple challenges that condition
   students'access to education with equal opportunities. Two of these
   obstacles are the lack of digital devices and the economic
   marginalisation of rural environments. This paper aims to analyse the
   extent to which the digital divide and socioeconomic inequality mediate
   the rural-urban achievement gap. METHOD. We use PIRLS-2021 data, with a
   sample of 8,505 4th grade primary school students in Spain (16.7\%
   schooled in rural areas, 83.3\% in urban areas). A structural equation
   model (SEM) is estimated (fit indices: CFI=0.992, TLI=0.989,
   RMSEA=0.042, SRMR=0.023) to identify direct and indirect effects of
   rural schooling on educational performance. RESULTS. We found that rural
   schools withstood the drop in learning following the school closure
   caused by the COVID-19 health crisis. However, we still observe
   significantly lower reading performance in rural settings (effect size:
   d=0.18). Rural students have lower household socioeconomic status
   (d=0.36) and lower availability of digital devices in their schools
   (d=0.51). The mediation analysis confirms the existence of significant
   indirect effects of socioeconomic inequality among students' households,
   which explains 66.2\% of the rural-urban gap in performance, and of the
   unequal availability of digital devices in schools, which explains
   11.1\% of the differences in reading performance between rural and urban
   environments. DISCUSSION. Although the digital divide is generally
   highlighted as a priority barrier to ensuring the quality of education
   in rural schools, our results point to another, often under-emphasised,
   problem: the economic marginalisation that rural environments still
   suffer to a greater extent and which compromises equality of educational
   opportunities between rural and urban settings.},
