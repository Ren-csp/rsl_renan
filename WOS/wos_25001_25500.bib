@article{ WOS:001621839100001,
Author = {Khirfan, Luna},
Title = {Is climate change relevant? Mainstreaming the dialogue on ecosystems and
   their services for adaptation and mitigation in Amman, Jordan: a survey
   of a societal segment},
Journal = {ENVIRONMENTAL RESEARCH-CLIMATE},
Year = {2025},
Volume = {4},
Number = {4},
Month = {DEC 31},
Abstract = {In cities across the Middle East, meaningful dialogue on climate change
   between planning experts and citizens remains largely absent. This
   disconnect hinders mutual learning between experts and communities,
   excludes community knowledge from planning processes, and perpetuates
   both epistemic and climate injustices. This study addresses this gap by
   asking: (1) how do urban residents in Amman, Jordan value urban
   ecosystems and their services? (2) How do they perceive climate change
   and its local impacts? (3) What gaps exist between expert-driven climate
   planning and public understanding, and how might these be bridged? An
   online survey was conducted with 228 respondents representing a societal
   segment of Amman's population. The 30-question instrument covered six
   thematic areas: perceptions of urban ecosystems; the loss of an urban
   stream and park; climate change and its impacts on Amman; adaptation and
   mitigation actions; current and preferred future climate actions;
   exposure to climate change information; and, prioritization of
   challenges relative to climate change. Findings reveal ambivalences,
   disjuncts, and contradictions in public perceptions. While urban
   ecosystems are broadly valued, respondents expressed relative
   indifference toward the loss of two major urban ecological assets.
   Climate change is generally understood as an abstract concept, yet
   respondents struggled to connect this understanding to the tangible
   impacts experienced locally. Moreover, despite limited awareness of the
   Greater Amman Municipality's climate plans and scepticism about its
   capacity, the Municipality is still perceived as the primary actor in
   climate action. These inconsistencies suggest a critical absence of
   authentic dialogue. I argue that effective climate action requires more
   than top-down strategies, it demands genuine dialogue that fosters
   shared responsibility and builds time-binding relationships between
   planning institutions and communities. Only through such inclusive
   engagement can cities in the Middle East advance equitable and
   context-sensitive climate resilience.},
