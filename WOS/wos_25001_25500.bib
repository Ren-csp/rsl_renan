   Godoy Ossandon, Andres, Univ Alberto Hurtado, Santiago, Chile.},
DOI = {10.5354/0717-5051.2018.51938},
ISSN = {0717-5051},
Keywords = {appropriation; housing policy participation; satisfaction; maintenance},
Research-Areas = {Urban Studies},
