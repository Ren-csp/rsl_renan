Author = {Shivakumar, Shweta and Athreya, Vidya and Yardi, Nikita and Odden,
   Morten and Dhiman, Sat Pal and Karanth, Krithi K.},
Title = {Charting risk pathways of leopard attacks on people: A decision tree
   approach},
Journal = {HUMAN DIMENSIONS OF WILDLIFE},
