@article{ WOS:001650099800003,
Author = {Painuli, Ritu and Kumar, Dinesh and Prasad, Surendra},
Title = {Synthesis of Ephedra sinica capped silver nanoparticles as colorimetric
   sensor for Al(III) ion and its bactericidal activity in environmental
   water},
Journal = {NEXT NANOTECHNOLOGY},
Year = {2025},
Volume = {8},
Abstract = {Colorimetric detection of noxious metal ions based on the plasmonic
   nanoparticles (NPs) has gained widespread attention due to its inherent
   advantages, such as cost-effectiveness, no sophisticated
   instrumentation, simplicity, and rapidity. Thus, the present paper
   investigated the sensing application and bactericidal activity of
   Ephedra sinicastem extract (ESE) decorated silver NPs (E - AgNPs). The
   green stabilized E - AgNPs and their interaction with Al(III) ions were
   investigated using Ultraviolet-visible (UV-vis) spectrophotometry,
   Fourier-transform infrared (FTIR) spectroscopy, High-resolution
   transmission electron microscopy (HRTEM), Surface-enhanced Raman
   spectroscopy (SERS), and dynamic light scattering (DLS) techniques. The
   E - AgNPs synthesized using multifunctional capping agent ESE performed
   as an excellent nanosensor for the detection and determination of
   Al(III) ions in the concentration range from 0.001 to 8 mu g/mL, with a
   regression coefficient (R2) of 0.9936. The E - AgNPs also showed an
   excellent antibacterial activity at a concentration of 35 mu g/mL (IC50)
   for the Gram-negative bacteria (E. coli) and 30 mu g/mL (IC50) for the
   Gram-positive bacteria (S. aureus). The detection limit of 0.001 mu g/mL
   Al(III) ions by E - AgNPs nanosensor was easily observed with the naked
   eye and through a UV-vis spectrophotometer. The application of the
   proposed nanosensor was evaluated for the detection of Al(III) ions in
   tap and pond water samples.},
