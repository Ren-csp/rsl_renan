Title = {WHY DO SPANISH FIRMS ENGAGE IN THE GLOBAL COMPACT INITIATIVE? AN
   EXPLANATION FROM INSTITUTIONAL AND SOCIAL IDENTITY THEORIES},
Booktitle = {UN GLOBAL COMPACT: FAIR COMPETITION AND ENVIRONMENTAL AND LABOUR JUSTICE
   IN INTERNATIONAL MARKETS},
