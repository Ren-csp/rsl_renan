@article{ WOS:001672486000001,
Author = {Perez-Canamas, Azucena and Chen, Mingming and Almandoz-Gil, Leire and
   Khan, Nabab and Tang, Si Jie and Ho, Allyson and Gunther, Erik C. and
   Strittmatter, Stephen M.},
Title = {mGluR4-NPDC1 complex mediates α-synuclein fibril-induced
   neurodegeneration},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {17},
Number = {1},
Month = {DEC 25},
Abstract = {alpha-Synuclein (alpha-syn) fibrils accumulate in Parkinson's disease,
   spreading between cells to template misfolding and drive
   neurodegeneration. alpha-Syn fibril entry into healthy neurons is a key
   step. Here, we comprehensively assessed the membrane proteome for
   alpha-syn fibril binding. We identified mGluR4 and NPDC1 as nigral
   surface proteins binding and internalizing alpha-syn fibrils. While
   striatal alpha-syn fibril injection led to nigral dopamine neuron loss
   in wild type mice, deletion of either Grm4 or Npdc1 provided protection
   of dopamine neurons. We observed mGluR4 and Npdc1 to form a complex
   regulating mGluR4 function. Cultured neurons lacking both Grm4 and Npdc1
   fail to bind alpha-syn fibrils, to accumulate phosphorylated alpha-syn
   and to lose synapses. Transheterozygous Grm4, Npdc1 mice showed
   protection of nigral neurons from alpha-syn fibrils, demonstrating
   genetic interaction. For transgenic alpha-syn A53T mice, double Grm4,
   Npdc1 heterozygosity increased mouse survival, motor function and spinal
   motoneuron number. Thus, a cell surface mGluR4-NPDC1 complex
   participates in alpha-syn neurodegeneration.},
