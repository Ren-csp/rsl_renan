@article{ WOS:000428165400018,
Author = {Domenyuk, Valeriy and Gatalica, Zoran and Santhanam, Radhika and Wei,
   Xixi and Stark, Adam and Kennedy, Patrick and Toussaint, Brandon and
   Levenberg, Symon and Wang, Jie and Xiao, Nianqing and Greil, Richard and
   Rinnerthaler, Gabriel and Gampenrieder, Simon P. and Heimberger, Amy B.
   and Berry, Donald A. and Barker, Anna and Quackenbush, John and
   Marshall, John L. and Poste, George and Vacirca, Jeffrey L. and Vidal,
   Gregory A. and Schwartzberg, Lee S. and Halbert, David D. and Voss,
   Andreas and Magee, Daniel and Miglarese, Mark R. and Famulok, Michael
   and Mayer, Guenter and Spetzler, David},
Title = {Poly-ligand profiling differentiates trastuzumab-treated breast cancer
   patients according to their outcomes},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {MAR 23},
Abstract = {Assessing the phenotypic diversity underlying tumour progression
   requires the identification of variations in the respective molecular
   interaction networks. Here we report proof-ofconcept for a platform
   called poly-ligand profiling (PLP) that surveys these system states and
   distinguishes breast cancer patients who did or did not derive benefit
   from trastuzumab. We perform tissue-SELEX on breast cancer specimens to
   enrich single-stranded DNA (ssDNA) libraries that preferentially
   interact with molecular components associated with the two clinical
   phenotypes. Testing of independent sample sets verifies the ability of
   PLP to classify trastuzumab-treated patients according to their clinical
   outcomes with ROC-AUC of 0.78. Standard HER2 testing of the same
   patients gives a ROC-AUC of 0.47. Kaplan-Meier analysis reveals a median
   increase in benefit from trastuzumab-containing treatments of 300 days
   for PLP-positive compared to PLP-negative patients. If prospectively
   validated, PLP may increase success rates in precision oncology and
   clinical trials, thus improving both patient care and drug development.},
