@article{ WOS:001793041900001,
Author = {Sandin, Gunnar},
Title = {Modes of affordance: action possibilities in the time and place of aging},
Journal = {SEMIOTICA},
Year = {2026},
Volume = {2026},
Number = {271},
Pages = {37-51},
Month = {JUL 24},
Abstract = {Ever since the introduction of the concept of affordance, a debate has
   continued about how this concept captures the diversity of action
   possibilities triggered by our environment. One facet of this debate
   concerns the individual specificity, hence societal diversity, regarding
   how affordance changes as life changes, such as when we get older.
   Affordance, or action possibility actualized in the moment someone
   perceives it, is a dynamic relation between perceiver and environment,
   and as we grow older changes appear with regard to mobility, strength,
   and perception. In a routine fashion, we tend to regard such an
   ``age-shift{''} as bringing decline of the range of action possibilities
   for the individual - this, even though affordance also can be seen as a
   repertoire that can be altered, as corporeal adjustment to the demands
   of spaces and objects in modernization of everyday life. The dynamics of
   affordances in general show a modal range of possibilities and
   necessities, and a semiotic view on affordance is presented here that
   acknowledges this range of possibilities and relates it to existential
   perspectives. Such a modalized view of affordance contributes not only
   to affordance theory as such, to the semiotics of agency, and to studies
   of aging as a societally urgent project but becomes also a way to
   approach design of lived environments that more sufficiently meet the
   ever-changing existential needs.},
