@article{ WOS:001467547400001,
Author = {Shin, Minsun},
Title = {Giant tree versus iPad kids: Reflecting on childhood outdoor play, then
   and now},
Journal = {JOURNAL OF OUTDOOR AND ENVIRONMENTAL EDUCATION},
Year = {2026},
Volume = {29},
Number = {2},
Pages = {463-479},
Month = {JUN},
Abstract = {Childhood play experiences, particularly outdoor play, positively affect
   children's holistic development and well-being. This qualitative study
   examined teacher education students' perceptions through retrospective
   reflection on their own childhood play experiences in the past (then)
   compared to contemporary children's play at present (now) to recognize
   the value of childhood play. Ten student teachers enrolled in various
   teacher education programs at one university participated in this study.
   Analyzing a drawing task and interviews revealed that participants
   recalled outdoor play as their favorite childhood play experiences,
   engaging in unstructured and child-initiated activities, taking risks,
   and creating their own rules. These outdoor experiences not only
   fostered social interactions but also nurtured a special emotional bond
   with the natural environment where they grew up and played. Furthermore,
   participants reported that children's play has changed in recent times,
   with a decline in outdoor play due to increased parental safety concerns
   and the prevalence of technological devices. The teaching implications
   regarding prioritizing outdoor play, as well as the intersection of
   outdoor play and digital technology, are discussed.},
