@article{ WOS:001695884400001,
Author = {Schimmer, Stephanie and Kania, Alan and Lefevre, Arthur and Afordakos,
   Konstantinos and Wang, Kai-Yi and Lebedeva, Julia and Rozov, Andrei and
   Raftogianni, Androniki and Tiwari, Rishika and Netser, Shai and Zovko,
   Ana and Shaheen, Huma and Schimmer, Jonas and Patwell, Ryan and Denis,
   Clemence and Grelot, Valentin and Petitjean, Hugues and Geng, Lan and
   Hefter, Dimitri and Boender, Arjen and Podpecan, Yuval and Schommer,
   Franziska and Schubert, Tim and Sanetra, Anna and Trenk, Aleksandra and
   Gugula, Anna and Hurlemann, Rene and Wagner, Shlomo and Li, Yulong and
   Althammer, Ferdinand and Blasiak, Anna and Melzer, Sarah and Monyer,
   Hannah and Charlet, Alexandre and Eliava, Marina and Grinevich, Valery},
Title = {Oxytocin facilitates social behavior of female rats via selective
   modulation of interneurons in the medial prefrontal cortex},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {FEB 20},
Abstract = {The hypothalamic neuropeptide oxytocin is best known for its prosocial
   behavioral effects. However, the precise anatomical and cellular targets
   for oxytocin in the cortex during social behavior remain elusive. Here
   we show that oxytocin neurons project directly to the medial prefrontal
   cortex where evoked axonal oxytocin release facilitates social behaviors
   in adult female rats. In conjunction, we report that local oxytocin
   receptor-expressing (OTR+) cells are predominantly interneurons, whose
   activation promotes social interaction. Notably, this prosocial effect
   persists even under physiological challenge (hunger), pointing to a
   dedicated prosocial circuit capable of overriding primary survival
   drives. We further demonstrate that activation of these OTR+
   interneurons inhibits principal cells specifically projecting to the
   basolateral amygdala, thus providing a putative mechanism of selective
   oxytocin action in this sociability-promoting cortical network.},
