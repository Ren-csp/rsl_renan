@article{ WOS:001820894700031,
Author = {Lee, YouJin and Ouyang, Qing and Ma, Li and Fleishman, Morgan and Riaz,
   Hasib Aamir and Schmidt, Michael and Dupree, Jeffrey L. and Mondal,
   Anupam and Mohanty, Priyesh and Mittal, Jeetain and Beckstein, Oliver
