@article{ WOS:001800223200001,
Author = {Karimi, Hamid and Ataei, Pouria},
Title = {The characteristics distinguishing CSA adoption in Iran: The case of
   Sistan and Baluchistan province},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {Climate change in developing countries has prompted policymakers to
   develop approaches compatible with changing climatic conditions, such as
   Climate-Smart Agriculture (CSA). However, despite the promotion of CSA
   practices by agricultural institutions, many farmers do not adopt them.
   This research aimed to identify the characteristics distinguishing CSA
   adopters from non-adopters among farmers in the Sistan Plain, Sistan and
   Baluchestan province, Iran. A survey method was employed, using a
   structured questionnaire based on six categories of variables:
   socio-demographic factors, psychological factors, farm characteristics,
   policy factors, systemic factors, and technology/practice features. The
   target population consisted of 6000 farmers. A multistage cluster
   sampling technique was used, and 322 valid questionnaires were
   collected. The results of discriminant analysis showed that legal
   framework, trust, ease of use, marketing and communications, trust in
   verified impact, infrastructure availability, financial support, and
   extension and advisory services had the most significant effects in
   distinguishing adopters from non-adopters. The discriminant model
   correctly classified 81.4\% of the farmers into the two groups.
   Furthermore, non-adopters had lower levels of trust, infrastructure
   availability, extension services, financial support, and perception of
   the legal framework compared to adopters.},
