@incollection{ WOS:000376775800010,
Author = {Ndjeunga, Jupiter and Zarafi, Marou A. and Nikiema, Albert and Traore,
   P. S. and Amani, Abdou and Mahamane, Sabiou and Ibro, A. M. and Amadou,
   Souleymane and Nkonya, Ephraim},
