@article{ WOS:001376827800032,
Author = {Piao, Wenji and Wu, Long and Xiong, Yanbao and Zapas, Gregory C. and
   Paluskievicz, Christina M. and Oakes, Robert S. and Pettit, Sarah M. and
   Sleeth, Margaret L. and Hippen, Keli L. and Schmitz, Jessica and Ivanyi,
   Philipp and Shetty, Amol C. and Song, Yang and Kong, Dejun and Lee,
   Young and Li, Lushen and Shirkey, Marina W. and Kensiski, Allison and
   Alvi, Aamna and Ho, Kevin and Saxena, Vikas and Braesen, Jan H. and
   Jewell, Christopher M. and Blazar, Bruce R. and Abdi, Reza and Bromberg,
   Jonathan S.},
Title = {Regulatory T cells crosstalk with tumor cells and endothelium through
   lymphotoxin signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {DEC 2},
Abstract = {Regulatory T cells (Tregs) with multifaceted functions suppress
   anti-tumor immunity by signaling surrounding cells. Here we report Tregs
   use the surface lymphotoxin (LT)alpha 1 beta 2 to preferentially
   stimulate LT beta receptor (LT beta R) nonclassical NF kappa B signaling
   on both tumor cells and lymphatic endothelial cells (LECs) to accelerate
   tumor growth and metastasis. Selectively targeting LT beta R
   nonclassical NF kappa B pathway inhibits tumor growth and migration in
   vitro. Leveraging in vivo Treg LT alpha 1 beta 2 interactions with LT
   beta R on tumor cells and LECs, transfer of wild type but not LT
   alpha-/- Tregs promotes B16F10 melanoma growth and tumor cell-derived
   chemokines in LT beta R-/- mice; and increases SOX18 and FLRT2 in
   lymphatic vessels of LT beta R-/- melanoma. Blocking the nonclassical
   pathway suppresses tumor growth and lymphatic metastasis by reducing
   chemokine production, restricting Treg recruitment to tumors, and
   retaining intratumoral IFN gamma+ CD8 T cells. Our data reveals that
   Treg LT alpha 1 beta 2 promotes LT beta R nonclassical NF kappa B
   signaling in tumor cells and LECs providing a rational strategy to
   prevent Treg promoted tumor growth and metastasis.},
