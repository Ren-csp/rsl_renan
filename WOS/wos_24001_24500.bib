@article{ WOS:001865628600001,
Author = {Dutta, Sourovee and Sharma, Rajni and Kumar, Ashwani},
Title = {Quality of Life (QOL) at Rurban Clusters of Jammu \& Kashmir Region,
   India Establishing Parameters, Validating the Scale and Assessing
   QOL},
Journal = {INTERNATIONAL REVIEW FOR SPATIAL PLANNING AND SUSTAINABLE DEVELOPMENT},
Year = {2026},
Volume = {14},
Number = {3},
Pages = {283-305},
Abstract = {The rurban clusters are the organically developed settlements located in
   the city periphery. These settlements are in transition between rural
   and urban and are undergoing continuous transformation. There is a need
   to assess the Quality of Life (QOL) at these clusters. This article aims
   to establish various parameters to assess QOL at the rurban clusters,
   construct the scale for its assessment and validate the same through
   scientific method. It identifies the parameters (key aspects and
   criteria), translate the English version of questionnaire into two
   native languages, analyse psychometric properties of the scales and
   establish its validity using statistical tests. A pilot survey was
   conducted among the dwellers of two selected rurban settlements of
   India, Gole Gujral and Khumriyal, using simple random sampling
   technique. Psychometric properties include Intraclass correlation (ICC),
   Cronbach's alpha, test-retest reliability etc. were evaluated. The
   results suggest excellent compatibility between English and native
   versions of the questionnaire. After validating the QOL scale from the
   pilot survey, the existing status of QOL at the selected study areas
   were assessed taking a larger sample. The significance of all the
   parameters contributing towards QOL was also tested using Pearson
   correlation. The research finds that (1) all the identified key aspects
   and criteria significantly contribute towards QOL (correlated
   significantly at 0.05 level), (2) the existing quality of life at
   Khumriyal is poor in comparison with Gole Gujral, (3) Gole Gujral needs
   improvement in aspects like: Agriculture related industries and
   associated employment, waste management, underground drainage system,
   accessible and well-maintained green open spaces, presence of rural
   environment etc. where the mean QOL score is comparatively low (ranging
   from 2.11-3.26) and (4) Khumriyal needs much improvement in aspects
   like: vocational and skill development activities, digital literacy,
   sanitation scenario and toilet at household level, waste management,
   underground drainage system, hospitals and health centres etc. where the
   mean QOL score is low (ranging from 2.4-2.96). It is concluded that the
   identified parameters, the QOL scale developed is valid to assess
   Quality of Life in the rurban settlements and will be useful to generate
   more accurate data from the rural settings.},
