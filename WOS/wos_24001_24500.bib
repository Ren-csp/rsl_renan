@article{ WOS:001695047000005,
Author = {Ramello, Riccardo and Mugnano, Silvia and Gaspani, Fabio},
Title = {University students and urban independent living: Neighbourhood
   priorities and residential profiles},
Journal = {CITIES},
Year = {2026},
Volume = {172},
Month = {MAY},
Abstract = {This article investigates which neighbourhood attributes are most valued
   by university students living independently in Milan, Italy. It
   identifies three distinct priority-based profiles and examines how
   socio-demographic factors and economic resources influence residential
   priorities. Two groups prioritise services and safety, and environmental
   quality respectively, while a third segment shows limited concern for
   specific neighbourhood attributes. These findings recognise the
   heterogeneity of students' residential priorities and highlight the need
   for differentiated approaches to urban policy and university housing
   services. Tailored strategies that address the diverse priorities and
   needs of university students can support more equitable access to
   quality living environments in urban contexts.},
