@article{ WOS:001829317100009,
Author = {Moyle, Matthew},
Title = {``Je suis là pour regarder{''}: exhaustive readings of contemporary
   Parisian spaces},
Journal = {CONTEMPORARY FRENCH CIVILIZATION},
Year = {2026},
Volume = {51},
Number = {1-2},
Pages = {71-80},
Month = {APR 1},
Abstract = {In this essay, I examine Joy Sorman's Paris Gare du Nord and the two
   volumes of Thomas Clerc's Paris, mus \& eacute;e du XXIe si \&
   egrave;cle; recent texts that seem to share Georges Perec's desire to
   thoroughly observe and catalog specific urban spaces. Their exhaustive
   readings of these specific places carry out a different kind of spatial
   mediation, one that has the potential to overcome reductive urban
   discourses and reveal the city's human dimension. I argue, however, that
   Clerc and Sorman perform their acts of reading from different narrative
   postures, and that Sorman's observational position leads to a more
   nuanced understanding of the humans of Paris.This article was published
   open access under a CC BY-NC-ND licence:
   https://creativecommons.org/licenses/by-nc-nd/4.0/.
   Dans cet essai, j'examine Paris Gare du Nord de Joy Sorman et les deux
   tomes de Paris, mus \& eacute;e du XXIe si \& egrave;cle de Thomas
   Clerc, des ouvrages contemporains qui semblent partager le d \&
   eacute;sir qu'a eu Georges Perec d'observer et de cataloguer
   minutieusement l'espace urbain. Les lectures exhaustives des lieux pr \&
   eacute;cis par ces deux auteur.es op \& egrave;rent une m \&
   eacute;diation spatiale susceptible de surmonter les discours urbains r
   \& eacute;ducteurs pour r \& eacute;v \& eacute;ler une dimension
   humaine de la ville. Je soutiens toutefois qu'ils r \& eacute;alisent
   leurs actes de lecture \& agrave; partir de postures narratives
   distinctes et que celle, plus fond \& eacute;e sur l'observation, de Joy
   Sorman, m \& egrave;ne \& agrave; une compr \& eacute;hension plus nuanc
   \& eacute;e des Parisien.nes et leurs vies.},
