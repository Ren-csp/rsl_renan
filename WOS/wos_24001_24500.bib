@article{ WOS:001778619200001,
Author = {Penmetsa, Divya Vyshnavi and Jagadisan, Sharmila},
Title = {Evaluating the adaptive reuse of Moazzam Jahi Market as a public plaza},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {MAY 13},
Abstract = {Adaptive reuse is increasingly recognized as a viable urban development
   and cultural preservation strategy. The 1935 Indo-Saracenic Moazzam Jahi
   Market (MJM) in Hyderabad, which was renovated as an open space in 2020,
   is analysed in this research for adaptive reuse. Notwithstanding the
   restoration, MJM is still underutilized with poor daytime activity and a
   restrictive emphasis on nighttime food-themed activities. The research
   examines MJM via a mixed-methods approach, integrating stakeholder
   questionnaires, site observation, archival research, and literature
   benchmarking. Assessment is based on six indicators of successful public
   markets: accessibility, diversity of use, inclusiveness, cultural
   identity, comfort, and economic vitality. Results show that the
   architectural conservation objectives have mostly been met, while
   functional performance is still incomplete. Daytime activity is poor,
   pedestrian comfort is affected by shop over-spill and vehicle intrusion,
   and programming is youth-oriented food culture-biased. Absence of mixed
   uses and civic-based activities further reduces inclusivity and daily
   relevance. Comparative study with international and Indian adaptive
   reuse examples identifies that effective reuse is possible through
   combined spatial, programmatic, and governance responses instead of
   architectural conservation. The research concludes that MJM's adaptive
   reuse is an ``asymmetrical success{''} in adaptive reuse, where
   architectural conservation is achieved more effectively than social
   activation and functional activation. To overcome post-renovation
   underutilization, it proposes interventions like stakeholder
   co-management, greater pedestrian connectivity with adjacent bazaars,
   and cultural programming that can animate the plaza during the day.
   These interventions have the potential to balance heritage conservation
   with socio-economic vibrancy, ensuring the market's continued
   functionality in Hyderabad's urban life.},
