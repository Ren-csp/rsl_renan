@article{ WOS:001476601900002,
Author = {Rayner, Matt J. and Galbraith, Josie A.},
Title = {Changes in the bird community of Auckland Domain's urban forest between
   1987 and 2020},
Journal = {NOTORNIS},
Year = {2025},
