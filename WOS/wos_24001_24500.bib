@article{ WOS:000592571300001,
Author = {Shashkov, Maxim and Alexeev, Sergei and Ivanova, Natalya},
Title = {Communities of ground beetles (Carabidae, Coleoptera) in broad-leaved
   forests of protected and urban areas of the Kaluga Oblast (European
   Russia)},
Journal = {BIODIVERSITY DATA JOURNAL},
Year = {2020},
Volume = {8},
Month = {NOV 26},
Abstract = {Background
   This sampling-event dataset provides primary data about species
   diversity, population and seasonal activity of ground beetles
   (Carabidae, Coleoptera). The study was carried out in broad-leaved
   forests of protected ({''}Kaluzhskiye Zaseki{''} Nature Reserve and Ugra
   National Park) and urban areas (the Kaluga City) of the Kaluga Oblast.
   Carabids were collected from April to October during 1995-1998 by
   pitfall traps. In total, 108,000 adult individuals of the Carabidae
   family were sampled; 105 species from 38 genera were counted.
   New information
   This dataset is the first sampling-event dataset about the Carabidae
   family for the European part of Russia. It provides biodiversity data
   for new territory (Kaluga Oblast) and contributes to filling gaps in the
   global biodiversity distribution of the Carabidae family. Part of the
   data was collected from unique old-growth broad-leaved forests.},
