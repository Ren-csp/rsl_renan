@article{ WOS:001637309700001,
Author = {Areia, Neide P. and Tavares, Alexandre O.},
Title = {Drivers and barriers of public support for environmental policy:
   Insights into climate policy feasibility and efficiency},
Journal = {ENERGY RESEARCH \& SOCIAL SCIENCE},
Year = {2026},
Volume = {131},
Month = {JAN},
Abstract = {In response to the escalating climate crisis, governments worldwide face
   challenges in implementing effective environmental policies. Strong
   public support is essential for ambitious climate policies to be
   successfully adopted and sustained. However, research indicates that
   public backing remains limited, potentially hindering climate action.
   This study explores the psychosocial factors shaping citizens' responses
   to climate policies to inform the design of more widely accepted policy
   instruments. Specifically, it examines whether value orientations,
   climate change perceptions, social norms, and emotions predict support
   for low-cost and high-cost climate policies. A survey of over 1120
   individuals measured key psychological variables. Structural equation
   modelling and regression analyses revealed a preference for low-cost
   policies. Biospheric values, social norms, climate perceptions, and
   emotions influenced policy support, with risk perception and worry as
   key drivers. Political orientation emerged as a barrier. Findings offer
   valuable insights for climate policy design and communication
   strategies.},
