@article{ WOS:000080850000005,
Author = {Lima, RC and Victora, CG and Dall'Agnol, MM and Anaclaudia, LAF and
   Fassa, G},
Title = {Workers' perception of exposure to occupational hazards and the risk of
   accidents in a Southern Brazilian city},
Journal = {REVISTA DE SAUDE PUBLICA},
Year = {1999},
Volume = {33},
Number = {2},
Pages = {137-146},
Month = {APR},
Abstract = {Objetive The study of the association between workers' perceptions of
   occupational hazards and the risk of occupational accidents.
   Design Case central study.
   Population The cases were 264 workers who presented a ``typical{''}
   occupational accident, registered at the National Institute of Social
   Security in the city of Pelotas, between January and July, 1996. Fatal
   accidents (hco) were excluded, as were those lending to an absence of
   less than seven days from work. The cases were interviewed in their
   homes with a standard questionnaire. For each case, three controls were
   chosen: a fellow-work, a neighbor and a population control. Controls
   were matched to the cases by age (+/- 5 years) md sex; workers who had
   suffered an occupational accident in the preceding month were excluded
   from the control group. All cases and controls,were formally employed
   and lived in the urban area. The data were analyzed using conditional
   logistic regression.
   Results and Conclusions The risk of occupational accidents was found to
   double among,workers,who reported having faced emergency situations at
   work,,corking in high places, facing constant danger or noisy
   environments. Working in uncomfortable positions or intense physical
   activities were associated with a 50\% increase in risk. The remaining
   occupational hazards under study were not significantly associated with
   the risk of accidents. All of the above results were adjusted for
   confounding factors.},
