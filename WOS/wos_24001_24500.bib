@article{ WOS:000442927800025,
Author = {Sotto, Debora},
Title = {PARQUE MINHOCAO, SAO PAULO - BRASIL: UM ESTUDO DE CASO SOBRE
   REQUALIFICACAO URBANA, PLACE-MAKING E GENTRIFICACAO},
Journal = {REVISTA DE DIREITO DA CIDADE-CITY LAW},
Year = {2018},
Volume = {10},
Number = {3},
Pages = {1895-1910},
Abstract = {This paper consists of a case study on ``Parque Minhocao{''}, an urban
   rehabilitation project currently in the making in the city of Sao Paulo,
   Brazil. The ``Minhocao{''} is a high track built in the 1970s to connect
   the west to the east districts through the city center. It has generated
   an extensive urban fracture as it degraded the neighborly quarters.
   Projects aimed at its demolition have been discussed since its
   inauguration but were never implemented; according to the city's 2014
   Master Plan, a municipal law must determine the high track's final
   destination. As the population has been authorized to access the high
   track as a leisure site on weekends and holidays, public opinion has
   been divided between demolishing the structure or transforming it into a
   park. Urban social movements have been organized in favor of the
   demolition and the implementation of the park. In this context, our
   investigation aims to demonstrate how urban rehabilitation projects,
   apparently focused on place-making proposals, may result in
   gentrification, displacement and spatial injustice. To do so, we will
   examine, under a multidisciplinary perspective, not only the city's
