@article{ WOS:001788061700001,
Author = {Olarotimi, Salawu Jibril and Okhimamhe, Appollonia A. and Oluwafemi,
   Adewuyi Taiye},
Title = {Health risks of carbon monoxide and mitigation strategies in Abuja
   municipal area council, Nigeria},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {MAR 11},
Abstract = {Carbon monoxide (CO) pollution from rapid urbanization and increasing
   vehicle emissions poses a significant public health and environmental
   threat in the Abuja Municipal Area Council (AMAC), Nigeria. This study
   addresses a critical gap by conducting an integrated assessment linking
   CO levels to vegetation health and community impacts to inform localized
   policies. We analysed CO concentrations and Enhanced Vegetation Index
   (EVI) values from 2018 to 2024 using satellite data from Google Earth
   Engine, assessing their relationship with advanced regression models. A
   concurrent survey of 84 residents, health workers, and policymakers
   evaluated health impacts and awareness. Results revealed higher CO
   levels in high-traffic zones and during the dry season, with a complex,
   non-linear relationship to EVI. The survey showed a strong correlation
   between CO exposure and respiratory/cardiovascular issues, with most
   respondents facing financial burdens from related illnesses. Despite
   high awareness (80\%), a significant gap existed in adopting protective
   measures. The findings underscore the urgent need for integrated
   strategies in AMAC, including stricter vehicle emission standards,
   low-emission zones, and expanded green spaces to reduce CO pollution,
   protect public health, and promote sustainable urban development.},
Publisher = {NATURE PORTFOLIO},
