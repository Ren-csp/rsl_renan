@article{ WOS:001817997600001,
Author = {Zhang, Aizhu and Cheng, Jiahao and Su, Xinyuan and Zhu, Wenhai and Sun,
   Genyun},
Title = {Multi-Level Classification of Urban Green Space Using Multi-Source
   Remote Sensing and Geospatial Data},
Journal = {REMOTE SENSING},
Year = {2026},
