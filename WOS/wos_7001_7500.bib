@article{ WOS:001543331900001,
Author = {Wefwafwa, Job Allan},
Title = {TV Portrayal and People's Perceptions on Indigenous Environmental
   Conservation in Kenya},
Journal = {AFRICAN JOURNALISM STUDIES},
Year = {2025},
Volume = {46},
Number = {3},
Pages = {239-257},
Month = {JUL 3},
Abstract = {Drawing on qualitative interviews with indigenous African cultural
   leaders, I explore the effectiveness of indigenous methods of
   environmental conservation in Kenya. I argue that neo/colonization
   de-emphasizes indigenous environmental conservation methods even as
   communities integrally conserve the environment. I use the case of Kenya
   Television Network (KTN) TV programme dubbed Culture Quest to analyse
   how indigenous environmental conservation technologies are portrayed on
   TV and how the people perceive them. The indigenous African cultural
   elders argue that TV misrepresents and overlooks their integral
   indigenous environmental conservation technologies. They narrate how
   politically and commercially influential actors shape the portrayal of
   indigenous environmental conservation technologies on TV, and how this
   affects environmental conservation efforts in Kenya. I draw from
   political theory of the media to analyse how influential actors shape TV
   portrayal of indigenous environmental conservation technologies as
   unauthoritative and inferior, deterring indigenous conservation efforts.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
