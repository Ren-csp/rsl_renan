@article{ WOS:001482083100009,
Author = {Smith, Ryan McNeilly and Tavares, Silvia and Stevens, Nicholas},
Title = {Urban design and planning for extreme heat: an empirical study of built
   environment professionals' perceptions in South East Queensland,
   Australia},
Journal = {CITIES \& HEALTH},
Year = {2024},
Volume = {8},
Number = {4, SI},
Pages = {653-665},
Month = {JUL 3},
Abstract = {Extreme heat is currently Australia's deadliest natural hazard. The
   intensity of heat events is increasing due to climate change, and
   further exacerbated by urban heat islands. Urban design and planning
   solutions can assist in reducing heat-health risks, but they are rarely
   implemented. Through semi-structured interviews and an online survey, we
   investigated the role of such solutions in planning and urban design
   practice in South-East Queensland, Australia. The results showed
   planning professionals had lower awareness of the role urban design and
   planning played in heat mitigation and adaptation strategies compared to
   urban designers and architects. Continued professional development and a
   greater inclusion of heat mitigation design provisions in Queensland's
   planning system and Australian planning education are outlined as future
   requirements.},
