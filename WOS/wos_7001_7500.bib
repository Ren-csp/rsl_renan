@article{ WOS:001639502000001,
Author = {Rye, Tom and Tonnesen, Anders and Hansson, Lisa},
Title = {A social justice perspective on protests against urban transport
   measures},
Journal = {URBAN, PLANNING AND TRANSPORT RESEARCH},
Year = {2025},
Volume = {13},
Number = {1},
Month = {DEC 31},
Abstract = {This paper examines one category of contentious transport measure: that
   which reallocates parking space from cars to other modes of transport.
   Such restrictive measures are regarded as essential within the broader
   mix of policies needed to create more climate-friendly cities. The study
   analyses three Norwegian cases: two involving the removal of curb-side
   parking to make way for cycle lanes on urban streets, and one involving
   the removal of parking to pedestrianise three central-city squares.
   Using a social-justice framework, the analysis reveals three key
   findings. Firstly, although all three cases involve the removal of
   parking, the extent and nature of public resistance varied depending on
   the overall parking policy in place, with this broader policy context
   helping to explain the different levels and forms of protest. Secondly,
   the paper highlights the value of a social mobility justice approach in
   analysing transport system changes, showing that protests stem not just
   from the distribution of benefits and burdens but also from local values
   and perceived public-space qualities. Thirdly, diluting a road-space
   reallocation scheme to reduce opposition - for example, by providing
   extensive replacement parking - can risk weakening its impact on
   promoting sustainable transport. This underscores the challenge of
   balancing opposition management with policy effectiveness.},
