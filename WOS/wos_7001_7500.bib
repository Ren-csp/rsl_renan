@article{ WOS:A1995QX78700004,
Author = {LOCKWOOD, M and TRACY, K},
Title = {NONMARKET ECONOMIC VALUATION OF AN URBAN RECREATION PARK},
Journal = {JOURNAL OF LEISURE RESEARCH},
Year = {1995},
Volume = {27},
Number = {2},
Pages = {155-167},
Abstract = {We briefly discuss the problem of valuing time in recreation demand
   studies, and report on a recent case study which assessed the nonmarket
   economic value of Centennial Park, Sydney, using both the Travel Cost
   and Contingent Valuation methods. Modal choice analysis was used to
   estimate the value of travel time for inclusion in a Travel Cost model.
   The nonmarket economic value of the park was estimated to be between
   \$23 and \$33 million per year, with at least \$2.6 million due to
   nonuse value.(1) This compared favourably with annual management and
   maintenance costs of under \$6 million.},
