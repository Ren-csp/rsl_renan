@article{ WOS:001835976200001,
Author = {da Silva, Neuder Wesley Franca and Braga, Carlos Elias de Souza and
   Gutjahr, Ana Lucia Nunes},
Title = {Sociodemographic profile, ecoepidemiological aspects, and environmental
   perception of the residents of the environmental protection area of
   Combu Island regarding the chiropteran fauna, Belém, Pará, Brazil},
Journal = {REVISTA BRASILEIRA DE CIENCIAS AMBIENTAIS},
Year = {2026},
Volume = {61},
Abstract = {Bats, the only flying mammals, exhibit remarkable species diversity,
   ecological functions, and public health relevance. However, throughout
   the history of many cultures, they have faced numerous, often unfair
   stereotypes, generating negative perceptions that impact their
   conservation and local coexistence. This study established the
   socioeconomic, ecoepidemiological, and perception profile of residents
   in the Combu Island Environmental Protection Area, in Par \& aacute;,
   regarding bats. The descriptive quali-quantitative study involved
   semi-structured interviews with 120 riverine residents. Quantitative
   data were analyzed using the chi(2) Test (p<0.05) in BioEstat 5.3, and
   qualitative data were examined through Content Analysis. Most residents
   had observed bats, and many feared diseases and aggression, despite
   recognizing their ecological importance. Results revealed cultural
   diversity, a predominance of adults, followed by children, in family
   units, and significant plant extractivism in the local economy, with few
   reports of the folklore surrounding bats. Residents often recognized the
   importance of bats in seed dispersal, but many were unaware of their
   role in insect control. Environmental education is essential to correct
   misinformation and foster a balanced understanding of bats. Perceptions
   varied with personal and cultural experiences, reflecting the complexity
   of human-bat interactions. It was concluded that awareness regarding the
   ecological relevance of bats is essential for understanding the island's
   biodiversity. However, the implementation of educational programs
   integrated into the school curriculum as well as awareness campaigns is
   recommended to foster a harmonious coexistence between residents and the
   local fauna, reinforcing the importance of bats in maintaining
   ecological balance.},
