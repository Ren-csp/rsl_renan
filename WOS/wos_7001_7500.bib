@article{ WOS:001427068900001,
Author = {Lee, Yookyung and Han, Seungwoo},
Title = {From greenery to community: exploring the mediating role of loneliness
   in social cohesion},
Journal = {NPJ URBAN SUSTAINABILITY},
Year = {2025},
Volume = {5},
Number = {1},
Month = {FEB 20},
Abstract = {This study examines how vegetation conditions influence perceptions of
   societal fragmentation, with loneliness serving as a key mediating
   factor. Using a multi-level analytical framework, the research
   integrates district-level vegetation indices derived from remote sensing
   data with individual-level survey responses collected during the
   COVID-19 pandemic in South Korea. The analysis investigates how
   environmental contexts shape social cohesion through
   social-psychological processes. The findings reveal that districts with
   higher vegetation levels experience reduced loneliness, which in turn
   decreases distrust, perceived exploitation, and social indifference,
   indicating stronger community bonds. Conversely, areas with lower
   vegetation levels report higher loneliness, exacerbating perceptions of
   societal disintegration and social vulnerability. By demonstrating the
   critical mediating role of loneliness, this study highlights the broader
   social significance of environmental conditions. It advocates for urban
   greening initiatives as an effective policy strategy to strengthen
   social cohesion and enhance community well-being, particularly during
   social emergencies such as the COVID-19 pandemic.},
Publisher = {SPRINGERNATURE},
