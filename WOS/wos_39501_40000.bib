@article{ WOS:001669657400001,
Author = {Jung, Hun Bok},
Title = {General Education Classroom Activity To Monitor Copper in Drinking
   Water: Civic Engagement in Environmental Justice Issues},
Journal = {JOURNAL OF CHEMICAL EDUCATION},
