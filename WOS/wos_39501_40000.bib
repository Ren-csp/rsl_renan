@article{ WOS:001751529200001,
Author = {Merk, Marion and Werthmann, Christian},
Title = {A characterization of interventions in european landscape architecture:
   An approach from different perspectives},
Journal = {DISP},
Year = {2026},
Volume = {62},
Number = {2},
Pages = {44-63},
Month = {APR 3},
Abstract = {Interventions in European landscape architecture have gained in
   importance in recent decades as a method for open space development in
   cities. However, it is difficult to draw a precise distinction between
   the term Intervention, related temporary approaches and classical
   planning methods in landscape architecture. In a first step, definitions
   of terms and the roots of today's landscape architectural interventions
   are examined. These can be found in art, architecture, urban planning,
   sociology and landscape architecture in Europe from the middle of the
   last century onwards. In a second step, the diversity of contemporary
   landscape architectural interventions is defined and categorized. By
   overlaying past and present interventions, seven characteristic features
   of landscape architectural interventions are proposed: spatial,
   temporary, open-ended, curated, interactive, improvised and provocative.
   The article aims to sharpen the concept of Intervention as a planning
   instrument and to anchor it more precisely in the discipline as a
   landscape architectural method.},
