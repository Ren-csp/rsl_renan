@article{ WOS:000352111400007,
Author = {Maguire, G. S. and Rimmer, J. M. and Weston, M. A.},
Title = {Stakeholder knowledge of threatened coastal species; the case of
   beach-goers and the Hooded Plover Thinornis rubricollis},
Journal = {JOURNAL OF COASTAL CONSERVATION},
Year = {2015},
Volume = {19},
Number = {1},
Pages = {73-77},
Month = {FEB},
Abstract = {One way of measuring pre-existing knowledge of a threatened species and
   its circumstances is to measure the degree of surprise expressed by
   stakeholders in relation to factual statements regarding the species.
   Beach-goers (n=684) were surveyed in regard to their knowledge of the
   beach-dwelling, threatened, Hooded Plover Thinornis rubricollis, a
   coastal obligate in south eastern Australia. Principle components
   analysis revealed that respondents' degree of knowledge could be
   categorized as involving `chick (flightless young) ecology' and `human
   impacts' (threatening processes). Respondents were more surprised by
   aspects of chick ecology than by threatening processes (F-1,F-514=
   460.446, p<0.001). Prior knowledge of the species was associated with
   less surprise at factual statements. Therefore, priorities for further
   education should focus on linking threats with chick ecology,
   particularly because an understanding that chicks are not stationary
   within fenced areas is critical to the interpretation and effectiveness
   of current signage used to mitigate human impacts.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Weston, MA (Corresponding Author), Deakin Univ, Fac Sci Engn \& Built Environm, Sch Life \& Environm Sci, Deakin Ctr Integrat Ecol, 221 Burwood Hwy, Melbourne, Vic 3125, Australia.
