@article{ WOS:001866883400001,
Author = {Bogert, J. M. and Balgopal, M. M.},
Title = {How Accountability for Climate Change is Framed in Popular Magazines},
Journal = {SOCIETY \& NATURAL RESOURCES},
Year = {2026},
Month = {2026 SEP 2},
Abstract = {This content analysis examines climate change coverage in National
   Geographic, Time Magazine, and Discovery Magazine over a 2-year period
   (2020-2022), analyzing textual and visual content. Focusing on
   accountability and human-nature relationships, informed by frame theory
   and agency theory, we identify ten accountable actor frames and three
   human-nature relationship frames. In the articles' texts, government and
   industry were most frequently described as responsible for climate
   change. However, analysis of the accompanying images revealed that
   ordinary people in everyday situations were depicted more often than
   other actors. This highlights a misalignment between visual and textual
   representations of accountability. Furthermore, images focused more on
   the impacts of climate change than on its causes, limiting the clarity
   of responsibility and agency. We argue that more explicit and consistent
   messaging in magazine articles is needed to better communicate who is
   accountable for climate change and how action can be taken toward a
   sustainable future.},
