@article{ WOS:001816129000001,
Author = {Beckers, Caroline and Ermagun, Alireza and Cardon, Greet and Witlox,
   Frank},
Title = {Moving well, ageing well: How built and social environments shape
   mobility and well-being in later life},
Journal = {JOURNAL OF URBAN MOBILITY},
Year = {2026},
Volume = {10},
Month = {DEC},
Abstract = {This study examines the interrelations between environmental
   characteristics, travel behaviour, and well-being among older residents
   in Ghent, Belgium. It is motivated by the global challenges of
   population ageing and growing evidence that the living environment
   shapes daily travel and health outcomes. Using self-collected survey
   data in 1115 older adults aged 65 to 93, the analysis applies structural
   equation modelling to understand how built and social environmental
   features are associated with well-being, both directly and indirectly
   through travel behaviour across walking, cycling, car use, and public
   transport. The findings show that built and social environments are
   associated with well-being through both direct pathways and indirect
   pathways mediated by travel behaviour, with the built environment
   exerting the stronger and more consistent effect. Frequent travel,
   regardless of mode, is positively associated with well-being,
   underscoring the value of enabling older adults to maintain trip-making
   ability. Environments that provide positive walking and cycling
   experiences, high-quality public transport, supportive neighbourhood
   relationships, and community events encourage more active and
   sustainable travel. Parking provision facilitates car use, which may
   remain essential for individuals with limited mobility. These results
   highlight the need for integrated urban policies that address both
   infrastructure and the social dynamics of neighbourhoods to create
   environments that support mobility and wellbeing in later life.},
