   Meireles, Antonio Jeovah},
Title = {Oil spill on the Brazilian coast: (in)visibility of knowledges and
   disregard for the life of shellfisherwomen},
Journal = {CIENCIA \& SAUDE COLETIVA},
Year = {2021},
Volume = {26},
Number = {12},
