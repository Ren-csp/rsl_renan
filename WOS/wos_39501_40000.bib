Author = {Stergachis, Andrew B. and Neph, Shane and Sandstrom, Richard and Haugen,
   Eric and Reynolds, Alex P. and Zhang, Miaohua and Byron, Rachel and
   Canfield, Theresa and Stelhing-Sun, Sandra and Lee, Kristen and Thurman,
   Robert E. and Vong, Shinny and Bates, Daniel and Neri, Fidencio and
   Diegel, Morgan and Giste, Erika and Dunn, Douglas and Vierstra, Jeff and
