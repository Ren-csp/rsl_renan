@article{ WOS:001797035900001,
Author = {Melo, Felipe and Lohbeck, Madelon and Ferdous, Raihana and Di Bonito,
   Marcello and Gacheri, Purity and Mwangi, Lukelysia and Magaju, Christine
   and Nankaya, Jedidah and Siddique, Ilyas and Carmo, Rodrigo and Nabaala,
   Harrison Leshao and Nderi, Alex Nduah and Thompson, Stewart and Uzal,
   Antonio},
Title = {On the need for biocultural approaches to restoration},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {8},
Pages = {2598-2609},
Month = {AUG},
Abstract = {Ecological restoration is gaining global momentum for climate
   mitigation, yet its prevailing approach, often rooted in Western
   technical science, frequently appears neutral while inadvertently
   reinforcing power imbalances and sidelining local knowledge. We argue
   for biocultural restoration approaches that go beyond community
   participation by explicitly integrating cultural meanings, knowledge
   systems, and power relations into restoration planning and governance.
   We frame restoration as an inherently socio-political act, rather than a
   neutral fix to a broken nature. The approach integrates three core
   principles and tools: political ecology, which acknowledges and
   addresses unequal power dynamics influencing restoration; landscape
   biographies, offering a comprehensive historical understanding of
   human-nature interactions to inform restoration goals and prevent the
   perpetuation of injustices; and traditional ecological knowledge (TEK),
   which provides invaluable local insights on ecosystem functioning and
   contributes to decolonising restoration practices while empowering local
   communities. Restoration researchers and practitioners must ensure that
   restoration efforts truly serve the diverse values and needs of local
   populations.Read the free for this article on the Journal blog.},
