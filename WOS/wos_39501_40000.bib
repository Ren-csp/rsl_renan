@article{ WOS:001607694700005,
Author = {Daramola, Oluwole Philip and Olugbamila, Omotayo Ben and Agbabiaka,
   Hafeez Idowu and Alonge, Zachariah Oloyede},
Title = {Awareness and evaluation of physical planning administration by
   residents of fragmented communities in Akure, Nigeria},
Journal = {TOWN PLANNING REVIEW},
Year = {2025},
Volume = {96},
Number = {6},
Pages = {647-670},
Month = {NOV 1},
Abstract = {This study evaluates the effectiveness of physical planning agencies in
   Akure, Nigeria. It fragments the study area into the core, the
   transition, the peripheral and the housing estate. A systematic random
   technique was used to select one out of every 20 residential buildings
   (5 per cent sample), comprising 108, 52, 66 and 53 buildings from each
   fragment, respectively, where 279 homeowners with five years of living
   experience in the communities were selected for a questionnaire. The
   study indicates that residents have negative evaluations of the physical
   planning practices of the regulation agencies in terms of granting plan
   approvals, monitoring of development, and supervising construction
   projects, and also in other practices such as creating planning
   regulation awareness, preparation and approval of residential layout,
   and design of open spaces. Hence the appropriate policies, some of which
   form the recommendations of this study, should be instituted to enhance
   the practices of the physical planning agency.This article was published
   open access under a CC BY-ND licence:
   https://creativecommons.org/licenses/by-nd/4.0/.},
