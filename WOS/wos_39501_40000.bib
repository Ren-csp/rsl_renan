@article{ WOS:001781332400001,
Author = {Milfont, Taciano L. and Klebl, Christoph},
Title = {Climate change judged more harmful for future generations than for
   oneself: Cross-cultural evidence from 110 countries and regions},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {112},
Month = {JUN},
Abstract = {Although people often view the future with optimism, perceptions of
   environmental risks may follow a different pattern. In this
   pre-registered brief empirical note, we examine how people compare the
   future harm of climate change for themselves and for others. Using a
   large cross-cultural sample (k = 110, N = 108,946), we found that people
   consistently judge climate change as posing greater harm to future
   generations than to themselves, revealing a systematic self-other
   asymmetry in perceived future climate harm. While this pattern was
   consistent across countries and remained robust after controlling for
   demographics and multiple comparisons, there was also systematic
   variation across individuals and national contexts. Exploratory analyses
   indicated that this asymmetry in perceived future climate harm was
   smaller among individuals with higher levels of climate worry and in
   nations with higher income inequality, while larger in nations with
   higher GDP per capita, stronger environmental performance, and greater
   human development. We discuss possible interpretations of these
   findings, including the possibility that they may simply reflect
   accurate expectations about the worsening trajectory of climate change
   as well as psychological and contextual processes involved in
   comparative judgements about environmental risks.},
