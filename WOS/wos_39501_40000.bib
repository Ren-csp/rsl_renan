@article{ WOS:001528587900011,
Author = {Maki-Asiala, Minna and Tuomela, Anne and Hentila, Helka-Liisa and Rossi,
   Pekka Matias},
Title = {Steering stormwater management through land-use planning in Finnish
   municipalities},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2025},
Volume = {391},
Month = {SEP},
Abstract = {The increasing urbanisation of populated areas has resulted in a
   corresponding growth in the proportion of impermeable surfaces. In
   parallel, the intensity of precipitation is increasing in Finland due to
   climate change. Urban environments are therefore becoming increasingly
   susceptible to stormwater runoff, potentially resulting in urban
   flooding. The necessity for the implementation of effective stormwater
   management controls is increasingly apparent, along with a comprehensive
   understanding of their operational mechanisms. The objective of this
   study was to investigate the regulations pertaining to urban land-use
   planning in Finland with regards to stormwater management. A
   comprehensive questionnaire was sent to 96 Finnish municipalities to
   evaluate the efficacy of regulatory instruments with the responses being
   subjected to both qualitative and quantitative analysis. Twelve of these
   municipalities were sent an additional mandatory information request
   about the local detailed plan provisions related to stormwater. A key
   finding of this study was the importance of dialogue between different
   local government officers, which can lead to adaptable solutions for
   managing stormwater. The survey also revealed inconsistencies between
   the plan provisions and the survey responses. For example, participants
   felt that the local detailed plan provisions properly take climate
   change into account, although this was not reflected in the researched
   plan provisions. To ensure the effectiveness of the current approach to
   stormwater management, it would be necessary to introduce more
   evidence-based knowledge into the planning process.},
