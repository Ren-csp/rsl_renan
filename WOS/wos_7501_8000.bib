@article{ WOS:001740659400001,
Author = {Gaston, V, Millicent and Mitchell, Greg W. and Smith, Paul A. and
   Bennett, Joseph R. and Buxton, Rachel T.},
Title = {Temporarily closing roads to motorized vehicles may benefit some
   sensitive bird species in a peri-urban park},
Journal = {ORNITHOLOGICAL APPLICATIONS},
Year = {2026},
Volume = {128},
Number = {3},
Pages = {14},
Month = {AUG},
Abstract = {Roads and motorized vehicle traffic pose a significant threat to
   wildlife, contributing to population declines and global biodiversity
   loss. Temporary road closures are a potential tool that can mitigate
   traffic noise and road mortality, yet there is limited understanding of
   their effectiveness, especially for birds. In this study, we aimed to
   assess the outcomes of temporary road closures on community- and
   species-level bird diversity in Gatineau Park, Qu \& eacute;bec, Canada,
   using 30 autonomous recording units deployed throughout the 2023 and
   2024 breeding seasons. We measured species richness, Shannon diversity,
   community composition, detection rates of traffic-sensitive indicator
   species, and occurrence of species at risk in forested habitat at
   varying distances to temporarily closed roads (closed 4 days a week), a
   permanently closed road, and roads with no traffic restrictions. We
   found significant effects of distance to roads and road closures on
   various indicator species, including 2 species of conservation concern,
   Contopus virens (Eastern Wood-Pewee) and Hylocichla mustelina (Wood
   Thrush). Notably, H. mustelina occurrence was highest in areas with
   permanently and temporarily closed roads, regardless of distance to
   roads, with significantly lower occurrence closer to roads with no
   traffic restrictions. Contrary to our predictions, we found a lack of
   significant effects of roads and traffic on community-level species
   diversity and weak evidence for an effect on species composition.
   Temporary road closures likely support the use of surrounding habitat by
   traffic-sensitive species, providing an adaptable strategy for
   species-specific conservation. We recommend (1) implementing road
   closures where and when species are vulnerable, such as species at risk
   habitat during the breeding season; (2) increasing public transportation
   in parks to reduce traffic while supporting accessibility; and (3)
   increasing monitoring efforts to measure the efficacy of conservation
   interventions.
   Roads and traffic threaten wildlife populations by reducing landscape
   connectivity, reducing habitat quality, and increasing mortality.
   Temporarily closing roads is a potential conservation tool to mitigate
   these effects, especially for birds. We deployed 30 recorders at varying
   distances to roads across temporarily closed, permanently closed, and
   permanently open roads in Gatineau Park, Qu \& eacute;bec, Canada, to
   measure species richness, diversity, community composition, species
   detection rates, and occurrence of species at risk of extinction. We
   found no strong effects of roads or traffic on community diversity;
   however, we demonstrate more detections (proxy for relative abundance)
   further from roads and in areas with permanently and temporarily closed
   roads for sensitive species and species at risk, including Hylocichla
   mustelina (Wood Thrush). Closing roads temporarily can benefit wildlife
   in urban and peri-urban parks. We recommend closing roads in areas where
   species at risk occur throughout the breeding season and dawn chorus.},
