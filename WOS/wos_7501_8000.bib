@article{ WOS:000535598700168,
Author = {Vieira, Thiago Almeida and Panagopoulos, Thomas},
Title = {Urban Forestry in Brazilian Amazonia},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {8},
Month = {APR},
Abstract = {Urban forests provide multiple benefits in improving people's lives and
   can be an important tool for achieving the goal of carbon neutral
   cities. In this study, we analyzed the diversity of plant species from
   urban forests in cities in the Brazilian Amazonia, based on data from
   scientific articles, through a systematic literature review. Our
   analysis revealed that 530 taxa, of which 479 were identified at the
   species level and 51 at the genus level, covering 38,882 individuals
   were distributed in 29 cities. The three most frequent species were
   Ficus benjamina, Mangifera indica, and Licania tomentosa. Exotic species
   were more frequent than native. The three most frequent species had
   almost 42\% of the inventoried individuals. The choice of species has
   been made mainly by the local population, without monitoring by the
   public authorities. Recommendations for sustainable management of urban
   forests in Amazonia include investing in training of management bodies,
   periodic inventories, and awareness actions about the benefits of urban
   green infrastructure and on the advantages of native species. Policies
   for the sustainable management of urban green areas are necessary. The
   municipal governments must continuously monitor indicators of urban
   ecosystem services and provide financial resources for maintaining and
   increasing those area rates per person.},
