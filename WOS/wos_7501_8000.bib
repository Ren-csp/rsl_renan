@article{ WOS:001836788500001,
Author = {Wilbraham, Susan J. and Christie, Mark},
Title = {'It's freedom from pain, freedom from others' expectations, freedom
   from disability, freedom just to be me.' Disabled people's
   perspectives on open water swimming},
Journal = {SPORT IN SOCIETY},
Year = {2026},
Month = {2026 JUL 22},
Abstract = {Open water swimming (OWS) participation has grown in popularity, yet
   little research explores the experiences of disabled swimmers. Online
   semi-structured interviews were conducted with 15 swimmers
   self-identifying as having disabilities, health conditions, cognitive
   differences, or impairments (13 female, 2 male; mean age 52.6yrs). Four
   core themes and nine subthemes were identified: 1) Sensory experience
   and shifting attention (Somatic experience; Multisensory blue spaces);
   2) Outwitting impairments and escaping confines (Creativity and
   outmanoeuvring; Barriers and accessibility; Liberation); 3) Awareness of
   nature (Environmental quality and nature connection; Caution and
   vigilance); 4) Understanding and expression of self (Self-concept;
   Autonomy and independence). Findings emphasise the importance of
   biodiversity and clean water in promoting physical and psychological
   benefits through multisensory stimulation. Swimmers highlight barriers
   and enablers to participation, including logistical, financial and
   social factors, alongside a personal responsibility to assess
   environmental risks. Findings offer insights to better support inclusive
   participation and improve accessibility for disabled swimmers.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
