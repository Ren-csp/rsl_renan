@article{ WOS:001875145800001,
Author = {Braun, Luca},
Title = {Beyond the ladder of participation: a multidimensional reflection on
   participatory processes in urban green space development in graz},
Journal = {OSTERREICHISCHE ZEITSCHRIFT FUER SOZIOLOGIE},
Year = {2026},
Volume = {51},
Number = {1},
Month = {SEP 14},
Abstract = {As a response to climate change, cities are increasingly implementing
   strategies focused on the development of green spaces. While urban green
   has well-documented positive effects on urban climate, biodiversity, and
   as recreational spaces, it can also reinforce social disparities.
   Participatory planning is considered a key instrument for fostering just
   urban development, provided it is implemented seriously and embedded
   structurally. This article applies the ``9DF: a Nine-Dimensional
   Framework for Community Engagement{''} by Natarajan and Hassan () to a
   case study in Graz, Austria. The framework goes beyond traditional
   ladder models of participation and critically analyzes the involvement
   of local communities across nine dimensions. A multidimensional
   reflection of interview material with representatives of local
   organizations offers insights into learning experiences, networks, and
   relationships that empower participants to collaborate and engage in
   planning processes over the long term. In the Graz case, the
   participatory planning process was limited, leading to local actors
   taking initiative and empowering themselves to influence the development
   of public (green) spaces. The findings suggest that effective
   participation cannot be realized through isolated or symbolic actions.
   Instead, it requires long-term structures and relationships between
   civil society and municipal planning departments. Ultimately, the
   article argues that permanent engagement and mutual trust between those
   actors can contribute to a more just, future-proof, and
   climate-resilient urban development.},
Publisher = {SPRINGER VIEWEG-SPRINGER FACHMEDIEN WIESBADEN GMBH},
