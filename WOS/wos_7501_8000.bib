@article{ WOS:000793690300001,
Author = {Nwanaji-Enwerem, Jamaji C. and Boileau, Philippe and Galazka, Jonathan
   M. and Cardenas, Andres},
Title = {In vitro relationships of galactic cosmic radiation and epigenetic
   clocks in human bronchial epithelial cells},
Journal = {ENVIRONMENTAL AND MOLECULAR MUTAGENESIS},
