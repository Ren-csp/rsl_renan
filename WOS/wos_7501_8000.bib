@article{ WOS:001129632800002,
Author = {Montoya-Lerma, James and Rodriguez, Jonathan and Castano-Quintana, Karen},
Title = {Atta cephalotes (Hymenoptera: Myrmicinae) is colonizing urban
   areas in Cali, Colombia},
Journal = {URBAN ECOSYSTEMS},
Year = {2024},
