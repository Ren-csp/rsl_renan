@article{ WOS:001723827200001,
Author = {Giusti, Mariana and Prados, Maria Jose},
Title = {Open spaces in medium-sized cities in Buenos Aires province: challenges
   and opportunities for blue green infrastructure. The case of Chascomús,
   Argentina},
Journal = {CUADERNOS DE TURISMO},
Year = {2025},
Number = {55},
Pages = {187-213},
Month = {JAN-JUN},
Abstract = {The article analyzes the strategic role of public open spaces in the
   urban sustainability of Chascom \& uacute;s, a medium-sized city in the
   province of Buenos Aires (Argentina), under pressure from urban
   expansion and the consolidation of tourism as an economic activity. From
   an urban ecology and geography perspective, and within the framework of
   Blue-Green Infrastructure, it evaluates their distribution,
   functionality, and level of consolidation. The study identifies
   territorial inequalities, planning deficits, and opportunities for
   integrating these spaces as key infrastructure within a network that
   links climate mitigation, social cohesion, and sustainable tourism.},
