@article{ WOS:000970128000001,
Author = {Du, Xiao-Juan and Lin, Hsiao-Hsien and Hsu, I-Cheng and Ling, Ying and
   Zhang, Su-Fang and Li, Qi-Yuan},
Title = {River Green Land and Its Influence on Urban Economy, Leisure
   Development, Ecological Protection, and the Well-Being of the Elderly},
