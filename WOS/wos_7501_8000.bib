@article{ WOS:001825994400001,
Author = {El Ghafraoui, Youssra and Garcia-Llorente, Marina and Alba-Patino,
   Daniela and Salazar-Galvez, Beatriz and Quintas-Soriano, Cristina},
Title = {Nature through cultural lens: understanding cultural values toward
   nature in a rural case study},
Journal = {ECOSYSTEMS AND PEOPLE},
Year = {2026},
Volume = {22},
Number = {1},
Month = {DEC 31},
Abstract = {Traditional agricultural systems in rural regions are emblematic
   multifunctional landscapes with high ecological and cultural value.
   However, they are undergoing rapid transformation due to land
   abandonment, agricultural intensification, and shifting societal values.
   Understanding how local communities relate to nature is essential for
   developing inclusive conservation strategies and safeguarding
   biocultural diversity. This study explores local ecological knowledge
   (LEK), nature's values, and perceived contributions of nature to a good
   quality of life in a rural region of southeastern Spain. Twenty-five
   in-depth interviews were qualitatively coded to examine perceptions of
   nature change, its drivers, and the cultural importance of nature. Most
   participants perceived a negative trend in nature, mainly attributed to
   climate change, habitat degradation, and agricultural intensification.
   Nature was primarily valued for its contributions to physical
   well-being, cultural identity, place attachment, and social cohesion,
   highlighting the interdependence of biological and cultural dimensions
   in rural landscapes. Despite concerns about land abandonment and rural
   depopulation, some participants also identified positive trends,
   including habitat restoration and more sustainable agricultural
   practices. The results revealed strong biocultural interconnections
   between ecological and cultural dimensions, with LEK acting as a key
   conduit linking people and plants through knowledge transmission. Plants
   and landscapes emerged as the most salient ecological elements,
   associated with agricultural traditions, festivals, domestic practices,
   and symbolic, spiritual, and identity-related values. Overall, these
   findings highlight the importance of examining biocultural diversity
   through LEK to improve understanding of human-nature relationships and
   to inform conservation policies that integrate local values while
   promoting ecosystem integrity and human well-being.},
