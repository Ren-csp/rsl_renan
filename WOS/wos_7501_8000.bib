@article{ WOS:001778269800001,
Author = {Bolleter, Julian and Barghchi, Maassoumeh},
Title = {Modelling the cooling effects of blue-green drainage infrastructure in a
   Mediterranean climate},
Journal = {PLANNING PRACTICE AND RESEARCH},
Year = {2026},
Month = {2026 MAY 28},
Abstract = {This paper models blue-green infrastructure case studies (n = 3) in a
   Mediterranean climate that experiences hot, dry summers, to understand
   the degree to which they yield cooling `lake effects.' These diverse
   case studies include varying configurations of drainage infrastructure
   (e.g. open drains and compensation basins) and public open space. This
   paper finds that comparatively large and deep compensation basins (0.65
   Ha) can significantly improve thermal comfort in their immediate
   vicinity through latent cooling from evaporation and the high thermal
   inertia of water. However, constrained, shallower open drains and
   compensation basins appear to have a negligible impact.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
