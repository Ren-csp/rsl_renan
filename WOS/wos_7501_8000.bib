@article{ WOS:001806377800001,
Author = {Sahoo, Krushna Chandra and Trushna, Tanwi and Sharma, Hunny and Raut,
   Jyoti and Yadav, Manju and Adaniya, Mudita Atul and Sultana, Najmin and
   Quaisar, Yushra Y. and Singh, Surya and Tiwari, R. R. and Pati,
   Sanghamitra and Diwan, Vishal},
Title = {Exploring social dynamics of infectious diseases of poverty in urban
   India: A qualitative grounded theory study},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {11},
Month = {DEC},
Abstract = {Poverty-related infectious diseases, such as tuberculosis, malaria, and
   neglected tropical diseases, disproportionately affect vulnerable
   populations in urban areas worldwide. Understanding the complex
   interactions between socioeconomic factors and health-seeking behaviour
   is crucial for addressing these public health concerns. Unplanned
   urbanization, poor built-environment characteristics, and social
   determinants increase susceptibility to health risks, including
   infectious diseases. However, there is comparatively limited
   understanding of how affected communities perceive and navigate these
   determinants in everyday life. This qualitative grounded theory study
   explored the social dynamics shaping perceptions of infectious diseases
   and health-seeking behaviours among urban slum dwellers across seven
   Indian states. Data was collected through seven focused group
   discussions and four in-depth interviews. Using grounded theory
   analysis, the study developed a conceptual system map of infectious
   disease-related health-seeking pathways and identified three
   interrelated domains shaping health behaviour: perceptions of the built
   environment, community understandings of infectious disease, and
   healthcare decision-making processes. Participants demonstrated
   awareness of environmental and sanitation-related disease risks but
   described persistent structural barriers, including inadequate
   infrastructure, financial constraints, mistrust in healthcare systems,
   and reliance on self-medication and informal care pathways.
   Comprehensive, community-centred strategies that involve residents in
   planning and implementation processes are critical for reducing the
   impact of poverty-related infectious diseases in urban India, alongside
   interventions addressing infrastructural deficiencies, healthcare
   affordability, and trust in public health services.},
