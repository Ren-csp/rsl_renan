@article{ WOS:000616375100011,
Author = {Lampinen, Jussi and Tuomi, Maria and Fischer, Leonie K. and Neuenkamp,
   Lena and Alday, Josu G. and Bucharova, Anna and Cancellieri, Laura and
   Casado-Arzuaga, Izaskun and Ceplova, Natalie and Cervero, Lluisa and
   Deak, Balazs and Eriksson, Ove and Fellowes, Mark D. E. and Manuel,
   Beatriz Fernandez de and Filibeck, Goffredo and Gonzalez-Guzman, Adrian
   and Hinojosa, M. Belen and Kowarik, Ingo and Lumbierres, Belen and
   Miguel, Ana and Pardo, Rosa and Pons, Xavier and Rodriguez-Garcia,
   Encarna and Schroder, Roland and Sperandii, Marta Gaia and Unterweger,
   Philipp and Valko, Orsolya and Vazquez, Victor and Klaus, Valentin H.},
Title = {Acceptance of near-natural greenspace management relates to ecological
   and socio-cultural assigned values among European urbanites},
Journal = {BASIC AND APPLIED ECOLOGY},
Year = {2021},
Volume = {50},
Pages = {119-131},
Month = {FEB},
Abstract = {Grasslands are widespread elements of urban greenspace providing
   recreational, psychological and aesthetic benefits to city residents.
   Two urban grassland types of contrasting management dominate urban
   greenspaces: frequently mown, species-poor short-cut lawns and less
   intensively managed, near-natural tall-grass meadows. The higher
   conservation value of tall-grass meadows makes management interventions
   such as converting short-cut lawns into tall-grass meadows a promising
   tool for urban biodiversity conservation. The societal success of such
   interventions, however, depends on identifying the values urban
   residents assign to different types of urban grasslands, and how these
   values translate to attitudes towards greenspace management. Using 2027
   questionnaires across 19 European cities, we identify the assigned
   values that correlate with people's personal greenspace use and their
   preferences for different types of urban grasslands to determine how
   these values relate to the agreement with a scenario of converting 50\%
   of their cities' short-cut lawns into tall-grass meadows. We found that
   most people assigned nature-related values, such as wildness, to
   tall-grass meadows and utility-related values, such as recreation, to
   short-cut lawns. Positive value associations of wildness and species
   richness with tall-grass meadows, and social and nature related
   greenspace activities, positively correlated with agreeing to convert
   short-cut lawns into tall-grass meadows. Conversely, disapproval of lawn
   conversion correlated with positive value associations of cleanliness
   and recreation potential with short-cut lawns. Here, people using
   greenspaces for nature-related activities were outstandingly positive
   about lawn conversion. The results show that the plurality of values
   assigned to different types of urban grasslands should be considered in
   urban greenspace planning. For example, tall-grass meadows could be
   managed to also accommodate the values associated with short-cut lawns,
   such as tidiness and recreation potential, to support their societal
   acceptance. (c) 2020 The Author(s). Published by Elsevier GmbH on behalf
   of Gesellschaft fir okologie. This is an open access article under the
   CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/)},
