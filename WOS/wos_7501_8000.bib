Title = {Challenging Methods and Results Obtained from User-Generated Content in
   Barcelona's Public Open Spaces},
Booktitle = {CYBERPARKS - THE INTERFACE BETWEEN PEOPLE, PLACES AND TECHNOLOGY: NEW
   APPROACHES AND PERSPECTIVES},
