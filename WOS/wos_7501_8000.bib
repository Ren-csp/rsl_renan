@article{ WOS:001547743300005,
Author = {Ye, Jiayun and Chen, Zhuo and Dong, Jianquan},
Title = {Beyond quantity: Image segmentation-based assessment on quality of urban
   green spaces in China's 20 major cities},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {178},
Month = {SEP},
Abstract = {Urban green spaces are crucial for promoting ecological sustainability
   and human well-being. While the quantity of green spaces can be
   evaluated using simple indicators, the quality of green spaces better
   reflects the services that vegetation provides to humans. However, the
   evaluation differences in the quantity and quality of green spaces
   across multiple cities and blocks within cities have received little
   attention. Based on remote sensing and street-view data from 20 major
   cities in China, we applied image segmentation to compare dual-scale
   differences in the quantity and quality of green spaces, and analyzed
   the effect of social and natural drivers. Widespread mismatches between
   the quantity and quality of green spaces were revealed. Southern cities,
   such as Guangzhou, achieved the highest availability score despite
   having a low quantity, whereas northeastern cities, like Harbin, had a
   high quantity but limited diversity and facility scores. At the block
   scale, 85 \% of cities with high coverage of green spaces in their
   blocks exhibited poor facility provisioning (scores less than 0.20). In
   comparison, blocks with a good quantity in 75 \% of cities tend to
   exhibit relatively strong diversity (scores more than 0.5).
   Socioeconomic factors dominate in highly urbanized areas, whereas
   natural factors shape green space in some cities with development
   potential. Our findings demonstrate the differences in evaluating green
   spaces across quantity and quality dimensions, as well as the key
   improvement focus for different types of cities. The dual-scale
   framework provides a scientific basis for advancing inclusive planning
   of urban ecological spaces.},
