@article{ WOS:001589980200001,
Author = {Singh, Harmeek and Saroha, Arjun and Chauhan, Aditya Singh and Singh,
   Mohan and Singh, Ashwini Kumar and Khurana, Ekta and Babu, Cherukuri
   Raghavendra},
Title = {Biodiversity Park approach as a model for watershed management: a case
   study of Northern Ridge},
Journal = {JOURNAL OF URBAN ECOLOGY},
Year = {2025},
Volume = {11},
Number = {1},
Abstract = {The urban wetlands play a vital role in enhancing the city's quality of
   life. They offer multiple benefits such as improvement in water quality,
   recharge of ground water, carbon sequestration, mitigation of urban heat
   islands besides supporting wildlife habitats and provision of
   recreational spaces. Due to urbanization, land use change, and
   population pressure, urban wetlands face immense challenges, such as
   altered hydrological functions, degraded catchment areas, fragmented
   natural drainage, and biodiversity decline due to invasion and habitat
   loss. Northern Ridge of Delhi faced similar challenges, the consequences
   of which are the drying up of wetlands, loss of moisture regime and
   degradation of habitat. Efforts have been made to restore the natural
   functions of a pristine wetland within the Northern Ridge. The primary
   focus for restoration is to tailor the physical, chemical, and
   biological characteristics of the degraded wetland and watershed while
   concurrently restoring the hydrology and sustaining the ecological
   balance of the ridge ecosystem. A novel ``Biodiversity Park{''} approach
   was devised that encompassed the restoration of entire interconnected
   watershed and landscape to achieve long-term ecological resilience and
   functional recovery. The restored watershed of Northern Ridge serves as
   a critical component in enhancing groundwater recharge, improving
   nutrient cycling, biodiversity conservation, and rewilding. This
   successful outcome validates that Northern Ridge is a powerful rainwater
   harvester where rocky substrates facilitate the rapid infiltration of
   precipitation through joints and cracks. Consequently, this water
   eventually enters groundwater aquifers, serving as a vital source for
   parts of Delhi.},
