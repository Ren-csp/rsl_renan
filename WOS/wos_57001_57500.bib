@article{ WOS:000251406500024,
Author = {Miranda, Regina and Nolen-Hoeksema, Susan},
Title = {Brooding and reflection: Rumination predicts suicidal ideation at 1-year
   follow-up in a community sample},
Journal = {BEHAVIOUR RESEARCH AND THERAPY},
Year = {2007},
Volume = {45},
Number = {12},
Pages = {3088-3095},
Month = {DEC},
Abstract = {The cognitive processes underlying suicidal thinking and behavior are
   not well understood. The present study examined brooding and reflection,
   two dimensions of rumination, as predictors of suicidal ideation among a
   community sample of 1134 adults. Participants completed self-report
   measures of rumination and depression, and a semi-structured clinical
   interview that included an assessment of suicidal ideation, at baseline
   and 1-year follow-up. Brooding was more strongly related to degree of
   ideation at baseline than was reflection. However, both brooding and
   reflection predicted whether an individual thought about suicide at
   1-year follow-up, even after adjusting for baseline suicidal ideation.
   Symptoms of depression mediated the relationship between brooding and
   ideation but not that between reflection and ideation. Implications for
   the nature of thought processes that result in suicidal thinking are
   discussed. (C) 2007 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
