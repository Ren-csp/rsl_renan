@article{ WOS:001463114400001,
Author = {Yu, Xinrui and Duan, Ping and Chang, Jun and Li, Jia and Nie, Qi and
   Zhou, Qingquan},
Title = {Analysis of the spatial and temporal evolution and driving factors of
   landscape ecological risk in Xiaojiang River Basin, Yunnan, China},
Journal = {GEOCARTO INTERNATIONAL},
Year = {2025},
Volume = {40},
Number = {1},
Month = {DEC 31},
Abstract = {Assessing the spatiotemporal evolution of landscape ecological risk
   (LER) in watersheds and its driving factors is crucial for ecosystem
   maintenance. This study utilized land use/land cover (LULC) data to
   establish an LER evaluation model. A transfer matrix, along with global
   and local Moran's indices, analyzed LER evolution, while a geographic
   detector model quantified the driving factors of LER spatial
   heterogeneity in the Xiaojiang River Basin. Results indicate that LER
   was higher in central/northern areas and lower in southern areas, with
   low/sub-low risk areas expanding by 483.27 km2 and medium/high-risk
   areas decreasing by 684.08 km2, reflecting overall risk reduction. The
   LER exhibited evident spatial clustering, with ``High-High{''} clusters
   in middle-lower areas (water body/construction land) and ``Low-Low{''}
   clusters in southern areas (forest/grass land). The dominant driving
   factor was the interaction between net primary productivity of
   vegetation (NPP) and human disturbance (HD). This study provides
   insights for ecological restoration and ecosystem service enhancement.},
