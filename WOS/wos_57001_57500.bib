@article{ WOS:001639443600001,
Author = {Bwire, Hannibal and Ntamwiza, Jean Marie Vianney},
Title = {Comparative assessment of accessibility to mandatory and discretionary
   activities: the case study of informal settlements in Dar es Salaam},
Journal = {URBAN, PLANNING AND TRANSPORT RESEARCH},
Year = {2025},
Volume = {13},
Number = {1},
Month = {DEC 31},
Abstract = {In rapidly growing cities in sub-Saharan Africa, informal settlements
   face barriers to services due to poor transportation infrastructure,
   high costs, and unreliable mobility. This study examines accessibility
   to mandatory destinations - workplaces, schools, and healthcare
   facilities - and discretionary ones - markets, places of worship, and
   social visits, in Dar es Salaam, Tanzania. A mixed-methods approach
   combines survey data with structural equation modelling (SEM) to assess
   the influence of travel time, cost, transport mode, safety, and
   socio-demographic characteristics on access. Results show that long
   walking distances, extended travel time, and high costs significantly
   limit workplace access, while motorcycles and private vehicles improve
   it. Discretionary trips are more strongly influenced by perceptions of
   safety, comfort, and reliability. Walking, though common, is associated
   with lower accessibility for both trip types due to poor infrastructure
   and safety issues. Findings also reveal gendered and income-based
   disparities, with women and low-income groups facing greater challenges.
   Framed within the 15-minute city concept and environmental constraints
   such as thermal comfort, the study underscores the urgency of affordable
   mobility, safe pedestrian networks, and context-sensitive services to
   foster equitable accessibility in informal settlements.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
