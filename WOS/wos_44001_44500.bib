@article{ WOS:001794180000001,
Author = {Madhu, K. A. and Rajakumara, H. N. and Kanimozhee, S.},
Title = {Determinants of public transport use in Bengaluru: an empirical analysis
   of commuter behaviour},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {JUN 2},
Abstract = {The utilisation of integrated public transportation plays an important
   role in meeting daily travel needs and ensuring consistent urban
   mobility. Recent studies have primarily sought to determine the
   characteristics that influence the utilisation of public transportation.
   These factors include age, personal vehicle ownership, trip distance,
   parking availability and income. This study provides more information
   regarding the impact of 13 specific factors on the usage of public
   transportation. The data were examined using ordered logistic regression
   based on 646 responses collected from nodal points in Bengaluru,
   spanning from the north to the central region. The findings indicate
   that the decision to use public transportation for daily commuting is
   greatly impacted by factors such as the number of personal vehicles
   owned per household, the duration of travel on public transport, the
   availability of parking at bus stops or metro stations, and the distance
   an individual needs to walk to switch between modes of transportation.
   Travel time between 15 and 30 min increases the likelihood of higher IPT
   usage by 13.88 times, while 200-400 meters to the nearest metro station
   increases the odds by 13.58 times. Furthermore, the findings suggest
   that individuals with a lower income are more inclined to utilise public
   transportation, particularly those earning Indian Rupee10,001-Indian
   Rupee25,000 per month, who are 9.85 times more likely to choose higher
   IPT usage. However, issues such as inconsistent bus schedules and
   inconveniently long distances can significantly hinder the use of public
   transportation, as travel time exceeding 90 min reduces the odds by
   79.9\%, and walking distances of 1-2 km reduce the likelihood by 99.2\%.
   The results suggest implementing regional and local policy measures to
   promote the adoption of public transit.},
