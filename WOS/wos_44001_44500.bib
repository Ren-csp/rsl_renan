@article{ WOS:000631825100005,
Author = {Casini, Leonardo and Boncinelli, Fabio and Gerini, Francesca and Romano,
   Caterina and Scozzafava, Gabriele and Contini, Caterina},
Title = {Evaluating rural viability and well-being: Evidence from marginal areas
   in Tuscany},
Journal = {JOURNAL OF RURAL STUDIES},
Year = {2021},
Volume = {82},
Pages = {64-75},
Month = {FEB},
Abstract = {Promoting the viability of rural areas is a major objective of the
   European development and agricultural policies. One of the key aspects
   for the success of these policies is represented by the possibility to
   monitor the quality of life in all of its dimensions: social, economic,
   and environmental. The implementation of tools capable of pointing out
   the principal criticalities of human satisfaction is complex whether we
   are referring to the very definition of the concept of well-being or to
   the operative aspects in evaluating its components. We propose an
   approach to evaluate community well-being in which the fundamental
   components are defined referencing Sen's Theory of Capabilities and
   measured via questionnaires whose purpose is to subjectively evaluate
   each component on the level of territory of residence. This methodology
   has been applied to the case of rural areas in Tuscany (Italy). The
   results show that the main determinants of well-being are the individual
   perceptions con-cerning economic condition, security, environmental
   quality, and educational opportunities.},
