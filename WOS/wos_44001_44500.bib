@article{ WOS:000465302700001,
Author = {Mostafanezhad, Mary and Norum, Roger},
Title = {The anthropocenic imaginary: political ecologies of tourism in a
   geological epoch},
Journal = {JOURNAL OF SUSTAINABLE TOURISM},
Year = {2019},
Volume = {27},
Number = {4, SI},
Pages = {421-435},
Month = {APR 3},
Abstract = {The Anthropocene is fundamentally a social imaginary that is both shaped
   by and is reshaping tourism practice. In this article, we enroll the
   concept of the anthropocenic imaginary to describe how the Anthropocene
   is symbolically and materially produced as well as the ways in which it
   draws on the historical separation of Humanity and Nature. As the
   structural roots from which the anthropocenic imaginary has grown, this
   binary co-produces new and old forms of political and ecological
   inclusion and exclusion. We demonstrate how core themes in tourism
   studies have fertilized the seeds from which the theoretical branches of
   post-humanist, capitalist and ecological imaginaries in tourism have
   taken shape. These anthropocenic imaginaries, we argue, are appropriated
   in market-based solutions to environmental degradation that emanate from
   neoliberal contexts internal to the problem. Thus, we question the
   reconciliation of capitalist accumulation and environmental limits in
   sustainable tourism. This article and the papers in this issue push
   forward emerging approaches in the political ecology of tourism that
   recognize the Anthropocene as both a geological epoch and conceptual
   regime. In doing so, the issue contributes to emerging conversations on
   the relationship between politics, ecology and tourism in the so-called
   recent age of man.},
