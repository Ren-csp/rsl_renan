@article{ WOS:000404056900005,
Author = {Caldas, Marcellus M. and Bergtold, Jason S. and Peterson, Jeffrey M. and
   Earnhart, Dietrich H.},
Title = {Land-use choices: the case of conservation reserve program (CRP)
   re-enrollment in Kansas, USA},
Journal = {JOURNAL OF LAND USE SCIENCE},
Year = {2016},
Volume = {11},
Number = {5, SI},
Pages = {579-594},
Abstract = {Among the important alternatives for land conservation is the US
   Conservation Reserve Program (CRP) that celebrated its 30th anniversary
   in 2015. This paper explores how landowners decide on alternative
   land-use choices made available by the expiration of CRP contracts in
   Kansas. The study uses survey data and multinomial Logit models to
   predict land-use choices. Two models were tested. The first model does
   not incorporate variables concerning farmer perceptions and attitudes
   about land-use choices, while the second model does. The results show
   that CRP re-enrollment depends on factors, such as years of experience
   in cropping and percent of cropland irrigated. However, when perception
   variables are added, the models become more robust in explaining other
   land choice alternatives. The results suggest that as the perception of
   unfairness of more inflexible environmental policy rises, these farmers
   may be more likely to re-enroll their marginal land in the CRP program.},
