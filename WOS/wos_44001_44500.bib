@article{ WOS:001049271700002,
Author = {Morales, Marcelo Ignacio Navarro},
Title = {Deploy tact, cultivate memory. lhe animal and vegetable metaphors in El
   sistema del tacto by Alejandra Costamagna},
Journal = {ESTUDIOS FILOLOGICOS},
Year = {2023},
Number = {71},
Pages = {25-42},
Month = {JUN},
Abstract = {lhe autofictional narrator of El sistema del tacto by Alejandra
   Costamagna works on her family memory according to a vitalistic, ethical
   and aesthetic concern for her own existence, through which she invites
   us to think about the process of individual and collective
   subjectivation outside of the pastoral treatment of subjectivities. lhe
   animal and plant kingdom provides the narrator with a reservoir of
   images that allow her to conceive and carry out a horticultural
   treatment of her memory, that is, an indirect and negative work on its
   content, by virtue of the purpose of problematizing the pastoral
   relationship between parents and children, teachers and students, but
   also between human beings and nature.},
