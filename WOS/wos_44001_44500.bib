@article{ WOS:A1980KR29500002,
Author = {MCGEE, R},
Title = {IMAGERY AND RECOGNITION MEMORY - THE EFFECTS OF RELATIONAL ORGANIZATION},
Journal = {MEMORY \& COGNITION},
Year = {1980},
Volume = {8},
Number = {5},
Pages = {394-399},
Abstract = {Begg, among others, has recently argued that {[}human] recognition
   performance is independent of the size and number of units stored in
   memory, i.e., the degree of interitem organization. In 4 experiments,
   interactive imagery was contrasted with separation imagery on
   recognition memory. In the 1st 2 studies, the recognition of single
   words was better under separation instructions; in the final studies, in
   which recognition of pairs of words was required, performance was better
   following interactive imagery. Rather than being independent of the size
   of memory units, recognition depends upon the relationship between the
   size of the units encoded at learning, and the nature of the test items
   themselves.},
