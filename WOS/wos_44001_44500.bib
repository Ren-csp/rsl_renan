@article{ WOS:001874573300001,
Author = {Yan, Bing and Zhang, Liankui},
Title = {Indoor Air Protection Under Extreme Air Pollution Risk: Evidence From a
   Sandstorm in China},
Journal = {INDOOR AIR},
Year = {2026},
Volume = {2026},
Number = {1},
Abstract = {In the face of increasing climate-related extreme events, understanding
   how individuals adapt to environmental shocks is critical for fostering
   climate-resilient development and protecting population health. This
   study investigates adaptive behavioral responses to extreme air
   pollution risk triggered by a severe sandstorm event in early 2021-China
   ` s most intense sandstorm in a decade-which serves as an exogenous
   environmental hazard to examine indoor exposure avoidance and indoor air
   quality (IAQ) protection behaviors under climate-linked stress.
   Leveraging Baidu search data as a proxy for public demand for indoor air
   cleaning and IAQ-related information and a quasiexperimental
   difference-in-differences (DID) design, we identify a significant
   increase in public interest in indoor air protection via portable air
   cleaners (air purifiers) in affected regions, with search intensity
   rising by approximately 18\% relative to unaffected areas. Further
   heterogeneity analysis reveals that areas with historically cleaner
   environments and lower baseline air purifier sales experienced even more
   substantial increases (around 33\% and 200\%, respectively), suggesting
   systematic disparities in readiness for IAQ protection and adaptive
   capacity across regions. Our findings highlight how individuals engage
   in private indoor air protection actions in response to elevated
   outdoor-origin pollution episodes, often incurring additional economic
   costs. By combining high-frequency behavioral data with quasicausal
   evidence, this study provides new empirical insights into
   population-level IAQ risk response and indoor protection demand during
   extreme environmental hazards. It underscores the importance of timely
   IAQ risk communication and targeted support for indoor air protection,
   particularly in regions facing recurrent episodes of severe air
   pollution.},
