Title = {Natural mycobacterium tuberculosis complex infection in a brown
   howler monkey (Alouatta guariba clamitans) in Brazil},
Journal = {JOURNAL OF MEDICAL PRIMATOLOGY},
Year = {2024},
Volume = {53},
Number = {3},
Month = {JUN 3},
Abstract = {Neotropical primates rarely exhibit active tuberculosis. A brown howler
   monkey was found injured in an urban area. Histopathology revealed
   granulomatous inflammation in the lungs, lymph nodes, and liver.
   Immunohistochemistry and molecular analysis confirmed the presence of
   Mycobacterium tuberculosis complex. The findings highlight the
   importance of TB surveillance in nonhuman primates.},
