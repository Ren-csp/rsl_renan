@article{ WOS:001032761800006,
Author = {Chen, Xiao and Li, Yinglu and Zhu, Fang and Xu, Xinjing and Estrella,
   Brian and Pazos II, Manuel A. and McGuire, John T. and Karagiannis,
   Dimitris and Sahu, Varun and Mustafokulov, Mustafo and Scuoppo, Claudio
   and Sanchez-Rivera, Francisco J. and Soto-Feliciano, Yadira M. and
   Pasqualucci, Laura and Ciccia, Alberto and Amengual, Jennifer E. and Lu,
   Chao},
Title = {Context-defined cancer co-dependency mapping identifies a functional
   interplay between PRC2 and MLL-MEN1 complex in lymphoma},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {JUL 17},
Abstract = {Co-dependency mapping assays have revealed genetic dependencies in
   cancer and could shed light on chromatin crosstalk mechanisms. Here, the
   authors establish a pipeline to integrate co-dependency mapping screens
   with molecular information in pan-cancer cell lines in order to reveal
   chromatin complexes and potential drug targets.
   Interplay between chromatin-associated complexes and modifications
   critically contribute to the partitioning of epigenome into stable and
   functionally distinct domains. Yet there is a lack of systematic
   identification of chromatin crosstalk mechanisms, limiting our
   understanding of the dynamic transition between chromatin states during
   development and disease. Here we perform co-dependency mapping of genes
   using CRISPR-Cas9-mediated fitness screens in pan-cancer cell lines to
   quantify gene-gene functional relationships. We identify 145
   co-dependency modules and further define the molecular context
   underlying the essentiality of these modules by incorporating
   mutational, epigenome, gene expression and drug sensitivity profiles of
   cell lines. These analyses assign new protein complex composition and
   function, and predict new functional interactions, including an
   unexpected co-dependency between two transcriptionally counteracting
   chromatin complexes - polycomb repressive complex 2 (PRC2) and MLL-MEN1
   complex. We show that PRC2-mediated H3K27 tri-methylation regulates the
   genome-wide distribution of MLL1 and MEN1. In lymphoma cells with EZH2
   gain-of-function mutations, the re-localization of MLL-MEN1 complex
   drives oncogenic gene expression and results in a hypersensitivity to
   pharmacologic inhibition of MEN1. Together, our findings provide a
   resource for discovery of trans-regulatory interactions as mechanisms of
   chromatin regulation and potential targets of synthetic lethality.},
