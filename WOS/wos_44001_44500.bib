@article{ WOS:001368538300016,
Author = {De Medeiros Neta, Olivia Morais},
Title = {EDUCATION AND WORK IN THE PEDAGOGICAL IDEAS OF ROUSSEAU, PESTALOZZI AND
   MONTESSORI},
Journal = {HOLOS},
Year = {2024},
Volume = {40},
Number = {4},
Abstract = {This research aims to analyze the relationship between education and
   work in the pedagogical ideas of Rousseau, Pestalozzi and Montessori.
   Methodologically, the research focuses on the hermeneutic analysis of
   the writings of Rousseau, Pestalozzi and Montessori and of the
   commentators and researchers of their educational thought. These three
   thinkers collectively shaped modern educational practices, highlighting
   the importance of nature, experiential learning and child-centered
   approaches to promote development and integral formation, where the
   school would no longer be limited to intellectual dimensions, but would
   deal with the totality of the aspects of the human being and work would
   assume the function of activity in this formation.},
