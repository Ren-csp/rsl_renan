@article{ WOS:001798119800001,
Author = {Nayeri, Danial and Kyle, Gerard and Sardari, Pourya and Ghasemi,
   Benjamin},
Title = {The paradox of domination: Psychological predictors of mountain lion
   management support in Texas},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2026},
Volume = {321},
Month = {SEP},
Abstract = {Although classified as a species of ``least concern{''} globally,
   mountain lions are considered a species of ``greatest conservation
   need{''} in Texas. Currently, the state considers mountain lions to be a
   ``non-game{''} species and, as such, has little in place to track their
   abundance and distribution. If the state were to consider more active
   management for mountain lions, gaining insight into Texans' management
   preferences would help inform decisions and foster the possibility of
   coexistence. Using a statewide online survey of Texans (n = 1069)
   recruited through panels and email lists, we examined psychological
   drivers of eleven potential management alternatives among three
   stakeholder groups: residents without livestock; cattle producers, and
   sheep and goat producers. We tested a path model where wildlife value
   orientations (mutualism/domination), trust, perceived risk, and
   willingness to coexist influenced respondents' preferences for managing
   mountain lion interactions. Contrary to prior studies, domination and
   perceived risk were positively associated with coexistence alongside
   mutualism and trust. Consistent with past work, a greater willingness to
   coexist with mountain lions was associated with less aggressive and
   non-lethal management preferences. Wildlife value orientations, trust,
   and perceived risk had similar effects on respondents' willingness to
   coexist with mountain lions. Mountain lion management in Texas is
   complex, controversial, and troubled by the state's size and the fact
   that mountain lions' range predominantly lies on private lands. While
   the state is making progress toward developing a more formal mountain
   lion management policy, these data suggest that building trust among
   landowners/managers should remain central to advancing coexistence.},
