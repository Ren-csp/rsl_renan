@article{ WOS:001565636400001,
Author = {Ma, Wenyong and Zhao, Chunli and Zhou, Na},
Title = {Identifying the Factors Driving Vegetation Dynamics in Arid, Semiarid,
   and Semihumid Regions of the Mongolian Plateau},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2025},
Volume = {11},
Month = {SEP 3},
Abstract = {The Mongolian Plateau (MP), a crucial component of East Asian dryland
   ecosystems, extends across Mongolia and China's Nei Mongol Zizhiqu. This
   region has experienced substantial shifts in vegetation greenness and
   types, transitioning from arid to humid zones due to human-nature
   interactions. In this study, we divide the MP into arid, semiarid, and
   semihumid subregions to analyze vegetation dynamics. Using the residual
   analysis method, we identify the principal factors driving these
   changes. Additionally, we discuss any potential errors associated with
   our approach. The results indicate that vegetation rehabilitation
   surpasses degradation across all subregions, reflecting a general trend
   toward greening and a reversal of previous degradation patterns. Climate
   change emerges as the primary driver of vegetation restoration, while
   human activities predominantly lead to vegetation degradation. Notably,
   the influence of climate change on vegetation dynamics follows the
   order: semiarid > semihumid > arid, whereas human impact exhibits the
   pattern: semiarid > arid > semihumid. These insights underscore the
   necessity for tailored ecological management strategies to sustain and
   enhance vegetation recovery, particularly in the semiarid region.},
