@article{ WOS:001751297300001,
Author = {Ullrich, Susann and Otto, Antje and Heidenreich, Anna and Thieken,
   Annegret H.},
Title = {Caring for coping? An explorative study of the effects of risk
   perception and tailored warning messages on heat adaptation among
   childcare workers and physicians in three German cities},
Journal = {ENVIRONMENTAL RESEARCH: HEALTH},
Year = {2026},
Volume = {4},
Number = {2},
Month = {JUN 1},
Abstract = {Extreme heat is a widely underestimated health risk, which poses a
   threat especially to vulnerable groups such as the elderly, people with
   pre-existing medical conditions, and young children. Hence, physicians
   but also childcare workers carry a special responsibility during heat
   waves. To date, little is known about how well these professional groups
   are educated about adaptive behaviors during a heat wave, and whether
   heat warnings with specific adaptation instructions would improve their
   readiness. Based on a survey of 51 childcare workers and 29 physicians
   from three German cities in October/November 2019, we assessed the
   effectiveness of providing action recommendations in heat warnings: We
   embedded a quasi-experimental setup in the questionnaire, in which half
   of the participants received a heat warning with action recommendations,
   while the other half received the warning without further information.
   Being asked how well they knew what to do upon that warning, the
   physicians showed a high situational protective knowledge in both
   warning conditions, whereas the childcare workers showed a higher
   situational protective knowledge when provided with action
   recommendations than without, which implies that heat warnings should be
   equipped with adaptation recommendations. However, further explorations
   of this effect show that the general protective knowledge of the
   childcare workers about adaptive behavior during heat waves has a more
   pronounced influence on the reported situational protective knowledge
   upon receiving the heat warning than the availability of action
   recommendations alone. Hence, the combination of both matters: regularly
   receiving and reflecting on information about heat-adaptive behavior
   represents the best preparation for personnel of childcare facilities
   and can be supported by action recommendations in acute heat warnings.
   These findings emphasize the need for policy initiatives that promote
   sustained educational efforts and tailored crisis communications as
   integral components of heat adaptation strategies in medical and
   childcare sectors.},
