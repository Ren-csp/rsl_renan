@article{ WOS:001820954300001,
Author = {Sims, Ella and McKerchar, Christina and Curl, Angela and Bidwell, Susan
   and Martin, Gemma and Russell, Els and Crossin, Rose},
Title = {``It's such a luxury, we may as well get something we really want{''}: a
   qualitative exploration of public perceptions of health and public
   health implications of on-demand delivery},
Journal = {SOCIAL SCIENCE \& MEDICINE},
Year = {2026},
Volume = {405},
Month = {SEP},
Abstract = {On-demand delivery of commodities like food and alcohol for immediate
   consumption has rapidly increased. This shift has significant public
   health implications, yet consumers understanding of these implications
   and how they influence consumer decision-making remain underexplored.
   This study used a qualitative methodology informed by a critical
   theoretical framework. This lens is aligned with a public health
   analysis of technologies that shape environments that influence people's
   consumption. Six diverse focus groups were undertaken in New Zealand, of
   people who use on-demand delivery services. Transcripts were analysed
   using thematic analysis, with both inductive and deductive coding used
   to generate initial themes and sub-themes. Participants expressed strong
   individual responsibility narratives and emphasised that convenience
   underpins use. There was limited awareness or consideration of public
   health implications, or the role of industry behaviour (e.g. algorithms)
   in shaping use and creating habitual consumption patterns. This study
   emphasises the tensions between notions of personal choice and public
   health impacts that may be difficult for consumers to see, such as
   workers' rights or environmental impacts. This tension can make public
   health interventions challenging, particularly given that these
   industries reinforce framing of individual responsibility. This could be
   countered by drawing attention to how current contexts of cost,
   promotions, and geographical location restrict consumers choice, make
   their use easy and convenient, and highlight how interventions might
   promote autonomy by increasing access to healthier options and
   regulating commercial determinants of health.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
