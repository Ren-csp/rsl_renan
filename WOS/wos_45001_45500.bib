@article{ WOS:000364270700052,
Author = {Dou, Zhixun and Xu, Caiyue and Donahue, Greg and Shimi, Takeshi and Pan,
   Ji-An and Zhu, Jiajun and Ivanov, Andrejs and Capelll, Brian C. and
   Drake, Adam M. and Shah, Parisha P. and Catanzaro, Joseph M. and
