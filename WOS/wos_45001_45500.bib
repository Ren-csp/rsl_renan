@article{ WOS:001350484100007,
Author = {Lee, Hyunyoung and Sakamoto, Yuka and Yoshizawa, Yasuyo},
Title = {Analysis of information to promote participation in waste separate
   collection: Used cooking oil in Japan},
Journal = {CLEANER WASTE SYSTEMS},
Year = {2023},
Volume = {6},
Month = {DEC},
Abstract = {Separate collection and recycling of used cooking oil (UCO) to generate
   biodiesel fuel for use as an alternative to fossil fuels can reduce
   environmental burden. Therefore, establishment of a system to recycle
   UCO from households is urgently needed. For this, it is critical to
   analyze the information needed to increase participation of individuals
   in this endeavor. An online survey was conducted throughout Japan to
   determine effective information, based on the theory of planned
   behavior. The future intentions of 2380 individuals who did not
   participate in the separate UCO collection, with different usual
   pro-environmental behavior and environmental risk perception were
   analyzed. The policy implications of this study for accelerating the
   separate collection of UCO are as follows. First, the intention to
   participate in future separate collections of UCO was most effectively
   improved by providing information on the environmental benefits of
   separate UCO collection as well as on how to separate UCO. Second,
   information provision was more effective for those who ``highly
   perceived the environmental risk{''} and ``engaged in pro-environmental
   behavior{''} in their daily lives.},
