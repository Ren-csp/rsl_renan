@article{ WOS:000908958700001,
Author = {Song, Guangwen and Li, Jiaqi and Zhang, Chunxia and Gu, Jie},
Title = {Residents' Location-Based Fear of Theft and Their Impact Factors in
   Guangzhou, China},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2023},
Volume = {20},
Number = {1},
Month = {JAN},
Abstract = {While the fear of theft is common and is known to lead to lower
   satisfaction with life and subjective well-being, current literature
   regards the fear of theft as a stable psychological state and ignores
   discrepancies based on location and their influencing factors. To fill
   these gaps, we selected 74 typical communities and collected 1568
   questionnaires throughout Guangzhou. The results show that: (1) the
   respondents demonstrated significant location-based differences in their
   fear of theft. Locations including a coach station, a railway station, a
   bus station, a subway station and a wholesale market had the highest
   associated levels of fear, whereas locations dedicated to leisure
   activities, especially those in high-end places, had a lower level of
   respondents' fear of theft. (2) Vulnerability model, victimization
   model, community security and built environment can be applied to the
   analysis of fear of theft around different places, but interpretations
   of fear do vary widely from place to place.},
