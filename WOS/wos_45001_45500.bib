@article{ WOS:000412871900001,
Author = {Fodil, Nassima and Moradin, Neda and Leung, Vicki and Olivier,
   Jean-Frederic and Radovanovic, Irena and Jeyakumar, Thiviya and Molina,
   Manuel Flores and McFarquhar, Ashley and Cayrol, Romain and Bozec,
   Dominique and Shoukry, Naglaa H. and Kubo, Michiaki and Dimitrieva,
   Julia and Louis, Edouard and Theatre, Emilie and Dahan, Stephanie and
   Momozawa, Yukihide and Georges, Michel and Yeretssian, Garabet and Gros,
   Philippe},
Title = {CCDC88B is required for pathogenesis of inflammatory bowel disease},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {OCT 13},
Abstract = {Inflammatory bowel disease (IBD) involves interaction between host
   genetic factors and environmental triggers. CCDC88B maps within one IBD
   risk locus on human chromosome 11q13. Here we show that CCDC88B protein
   increases in the colon during intestinal injury, concomitant with an
   influx of CCDC88B(+) lymphoid and myeloid cells. Loss of Ccdc88b
   protects against DSS-induced colitis, with fewer pathological lesions
   and reduced intestinal inflammation in Ccdc88b-deficient mice. In a T
   cell transfer model of colitis, Ccdc88b mutant CD4(+) T cells do not
   induce colitis in immunocompromised hosts. Expression of human CCDC88B
   RNA and protein is higher in IBD patient colons than in control colon
   tissue. In human CD14(+) myeloid cells, CCDC88B is regulated by
   cis-acting variants. In a cohort of patients with Crohn's disease,
   CCDC88B expression correlates positively with disease risk. These
   findings suggest that CCDC88B has a critical function in colon
   inflammation and the pathogenesis of IBD.},
