Keywords-Plus = {MULTIELEMENT SOIL ANALYSIS; AID},
Research-Areas = {Anthropology; Archaeology},
Web-of-Science-Categories  = {Anthropology; Archaeology},
Author-Email = {maciej.wyzgol@uw.edu.pl},
Affiliations = {University of Warsaw},
ResearcherID-Numbers = {Wyżgoł, Maciej/IUP-3768-2023},
ORCID-Numbers = {Wyżgoł, Maciej/0000-0003-4693-5701},
Funding-Acknowledgement = {National Science Centre, Poland {[}2020/37/N/HS3/01400]; European
   Research Council (ERC) under the European Union {[}759926]; European
   Research Council (ERC) {[}759926] Funding Source: European Research
   Council (ERC)},
Funding-Text = {<OL><LI>This research was funded by the National Science Centre, Poland,
   under the grant Preludium 19, project titled ``Histories Imprinted on
   Floors: Functioning of Households in Old Dongola after the Fall of
   Makuria in the Light of the Multielemental Analysis of Occupational
