@article{ WOS:001759522700001,
Author = {Jaramillo-Urrego, Linda Mishell and Restrepo-Baena, Oscar Jaime and
   Smith, Jessica and Meza-Ortiz, Juan Jose and Phelan, Thomas and Chang,
   Stella and Smits, Kathleen M.},
Title = {Perspectives on plant-based mercury-free gold recovery in Colombian
   artisanal and small-scale gold mining},
Journal = {EXTRACTIVE INDUSTRIES AND SOCIETY},
Year = {2026},
Volume = {27},
Month = {SEP},
Abstract = {Artisanal and small-scale gold mining (ASGM) communities face challenges
   in adopting mercury-free processing techniques due to limitations in
   design, awareness, and engagement. Oftentimes, cleaner/safer processing
   alternatives require significant resources, training, and development,
   further limiting adoption. This study examines an ancestral mercury-free
   gold recovery method using plant-based extracts (mucilage) employed by
   miners in Antioquia, Choco, and Cauca, in Colombia. Through field
   visits, participatory mapping, participant observation, and
   semi-structured interviews with miners and academic professionals, we
   analyze sociotechnical perceptions of plant-gold processing to
   characterize how this method is understood and enacted by the mining
   communities. Findings reveal that community-led practices, transferred
   over generations, are perceived as a potentially sustainable and safer
   alternative to mercury-based processing. Participants generally view the
   method as environmentally friendly, although perceptions of efficiency
   vary by gender and region. All participating women reported willingness
   to implement plant-gold processing, whereas approximately half of the
   men expressed a preference for mercury, despite known health and legal
   risks. These gendered divergences in stated preferences indicate that
   deeper contextual factors influence technology choice. Our work shows
   that plant-gold processing is not just a set of tools and resources, but
   is interconnected with ecological, political, economic, and social
   contexts and knowledge systems. Its potential broader adoption through
   collaborative networks could support addressing socio-environmental
   challenges in ASGM sectors globally by integrating sustainable local
   practices.},
