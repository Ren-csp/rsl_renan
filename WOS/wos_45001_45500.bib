   and Fournier, Didier and Sussman, Joel L. and Silman, Israel and Weik,
   Martin},
Title = {Shoot-and-Trap: Use of specific x-ray damage to study structural protein
   dynamics by temperature-control led cryo-crystallography},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2008},
Volume = {105},
