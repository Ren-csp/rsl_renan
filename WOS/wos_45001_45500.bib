@article{ WOS:000700859900009,
Author = {Wiley, James C.},
Title = {Moral orientations in psychology: contrasting theoretical perspectives},
Journal = {BMC PSYCHOLOGY},
Year = {2019},
Volume = {7},
Number = {1},
Abstract = {Background: The relational development systems (RDS) metamodel embodies
   a newly recognized scientific paradigm that stands in contrast to the
   nature-nurture split. It suggests that the bidirectional relationship
   between an organism and its environment must be the central focus of
   scientific inquiry.
   Main body: RDS theorists suggest scientists have a moral obligation to
   benefit human kind. However, the potential for interventions that appear
   efficacious to simultaneously instigate an undesirable outcome suggests
   that moral clarity might not always exist in scientific practice.
   Contrasting RDS perspectives with life history theory highlights a
   pertaining disparity in approaches.
   Conclusion: While the RDS metamodel posits many premises necessary to
   contemporary research, it may not yet be pragmatic to impose moral
   obligation on the sciences.},
