@article{ WOS:001766876800001,
Author = {Hammack, Phillip L. and Barsigian, Logan L. and Hopkins, Bennett},
Title = {Narrating the experience of minoritised sexual identity development in
   context: a study of three generations},
Journal = {PSYCHOLOGY \& SEXUALITY},
Year = {2026},
Month = {2026 MAY 16},
Abstract = {How have shifts in cultural attitudes and understandings of sexual and
   gender diversity impacted experiences of sexual identity development
   across generations? This study examined narratives of the experience of
   sexual identity development and its context across three generations in
   the U.S.A.: Baby Boomers (born 1946-1964, n=46), Generation X (born
   1965-1980, n=69), and Millennials (born 1981-1996, n=76). Reflexive
   thematic analysis of interviews from participants in metropolitan areas
   in diverse regions of the U.S.A. yielded four primary themes: (1) across
   generations, narratives were characterised by experiences of minority
   stress, including prejudice, victimisation, and internalised stigma; (2)
   across generations, organised religion was narrated as a contaminating
   influence, serving as an institutional source of stigma; (3) generations
   differed in their engagement with language about sexuality and gender
   and the navigation of binary thinking, with Millennials encountering a
   more expansive language at earlier points in their development; (4) all
   generations narrated benefits of digital social technologies to explore
   identities and find support and relationships unbounded by geographic
   proximity but differed in the timing and nature of engagement with those
   technologies, with Millennials benefitting from access earlier in their
   development. Intersectional patterning emerged in themes 1 and 2, with
   participants of colour narrating challenges with community connection in
   White-dominated LGBTQ+ spaces, and Black participants narrating
   particular challenges with hostility from organised religion. These
   findings illustrate the value of narrative and life course perspectives
   on sexual identity development, which are sensitive to shifting social
   and historical contexts and the role of generation-cohort in human
   development.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
