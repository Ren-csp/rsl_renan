@article{ WOS:000593980500005,
Author = {Guo, Hongchen and Tan, Yu Jun and Chen, Ge and Wang, Zifeng and Susanto,
   Glenys Jocelin and See, Hian Hian and Yang, Zijie and Lim, Zi Wei and
   Yang, Le and Tee, Benjamin C. K.},
Title = {Artificially innervated self-healing foams as synthetic piezo-impedance
   sensor skins},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {NOV 12},
Abstract = {Human skin is a self-healing mechanosensory system that detects various
   mechanical contact forces efficiently through three-dimensional
   innervations. Here, we propose a biomimetic artificially innervated foam
   by embedding three-dimensional electrodes within a new low-modulus
   self-healing foam material. The foam material is synthesized from a
   one-step self-foaming process. By tuning the concentration of conductive
   metal particles in the foam at near-percolation, we demonstrate that it
   can operate as a piezo-impedance sensor in both piezoresistive and
   piezocapacitive sensing modes without the need for an encapsulation
   layer. The sensor is sensitive to an object's contact force directions
   as well as to human proximity. Moreover, the foam material self-heals
   autonomously with immediate function restoration despite mechanical
   damage. It further recovers from mechanical bifurcations with gentle
   heating (70 degrees C). We anticipate that this material will be useful
   as damage robust human-machine interfaces. Designing mechanosensory
   system that detects mechanical contact forces like human skin remains a
   challenge. Here, the authors present artificially innervated
   self-healing foams by embedding 3D electrodes for piezo-impedance
   sensors that can operate in both piezoresistive and piezocapacitive
   sensing modes to address various proximity and mechanical interactions
   efficiently.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Tee, BCK (Corresponding Author), Natl Univ Singapore, NUS Grad Sch Integrat Sci \& Engn NGS, Singapore, Singapore.
   Tee, BCK (Corresponding Author), Natl Univ Singapore, Dept Mat Sci \& Engn MSE, Singapore, Singapore.
   Tee, BCK (Corresponding Author), Natl Univ Singapore, Inst Innovat Hlth Technol iHealthtech, Singapore, Singapore.
   Tee, BCK (Corresponding Author), Agcy Sci Technol \& Res, Inst Mat Res \& Engn, Singapore, Singapore.
