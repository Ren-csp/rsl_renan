@article{ WOS:001858517000001,
Author = {Debkowski, Daniel and Gladyszewska-Fiedoruk, Katarzyna and Krukowski,
   Marcin and Koziol, Adam and Teleszewski, Tomasz},
Title = {Air Quality Monitoring in Secondary School Classes in
   Warsaw-Measurements and Correlation},
Journal = {ATMOSPHERE},
