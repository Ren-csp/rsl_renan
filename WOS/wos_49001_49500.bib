   Ishido, Hikari, Chiba Univ, Grad Sch Global \& Transdisciplinary Studies, Chiba 2638522, Japan.
   Ishikawa, Hirotaka, Chiba Univ, Grad Sch Humanities \& Studies Publ Affairs, Chiba 2638522, Japan.},
DOI = {10.3390/ijerph192416437},
