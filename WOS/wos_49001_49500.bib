@article{ WOS:A1997WJ72900002,
Author = {Eatough, DJ and Du, A and Joseph, JM and Caka, FM and Sun, BJ and Lewis,
   L and Mangelson, NF and Eatough, M and Rees, LB and Eatough, NL and
   Farber, RJ and Watson, JG},
Title = {Regional source profiles of sources of SOx at the Grand Canyon during
   project MOHAVE},
Journal = {JOURNAL OF THE AIR \& WASTE MANAGEMENT ASSOCIATION},
Year = {1997},
Volume = {47},
Number = {2},
Pages = {101-118},
Month = {FEB},
Note = {Aerosols and Atmospheric Optics: Radiative Balance and Visual Air
   Quality Conference, SNOWBIRD, UT, SEP 26-30, 1994},
Organization = {Air \& Waste Management Assoc; Amer Geophys Union},
Abstract = {Total fluoride (gas plus fine particle), spherical aluminosilicate
   particles, particulate selenium, arsenic, lead, bromine, and absorption
   of light by fine particles have been used to characterize chemical
   profiles for sources of sulfur oxides impacting the Grand Canyon
   National Park Class I Visibility Region. During the Project MOHAVE
   (Measurement of Haze and Visual Effects) winter and summer intensive
   studies in 1992, these various species were determined at seven sampling
   sites in and around the Grand Canyon. Extensive upper air and
   surface-based meteorological measurements were examined to determine
   probable geographical origins of the air mass present during a given
   sampling period for each sampling site. Samples corresponding to air
   masses dominated by transport from a single major source region were
   used to determine a source profile for each region. Source regions which
   have been characterized by this analysis include the San Joaquin Valley
   area, the southern California coastal urban area, the Baja,
   California-Imperial Valley area, the Arizona and Mexico area (including
   major smelters) south of the Grand Canyon, the area southeast of the
   Grand Canyon, the Colorado Plateau area, the Wasatch Front in Utah, and
   the area in Nevada to the west and northwest of the Grand Canyon. Source
   profiles giving the ratio of each endemic marker to SOx for each
   identified regional source in these areas have been determined. The
   source profiles for the various regional sources are all statistically
   different and distinguishable from those for other geographically
   adjoining sources.},
Publisher = {AIR \& WASTE MANAGEMENT ASSOC},
Address = {ONE GATEWAY CENTER, THIRD FL, PITTSBURGH, PA 15222},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Eatough, DJ (Corresponding Author), BRIGHAM YOUNG UNIV,DEPT CHEM \& BIOCHEM,E114 BENSON BLDG,POB 25700,PROVO,UT 84602, USA.
   BRIGHAM YOUNG UNIV,DEPT PHYS,PROVO,UT 84602.
