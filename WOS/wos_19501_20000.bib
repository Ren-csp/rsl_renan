@article{ WOS:001472935000018,
Author = {De-Santiago-Rodriguez, Eduardo},
Title = {Tivoli Greencity: innovative urban actions and a new econeighbourhood in
   Brussels},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2025},
Volume = {57},
Number = {223},
Pages = {375-394},
Month = {SPR},
Abstract = {Tivoli Greencity is a small residential development for 397 dwellings in
   Brussels, conceived as the city's first eco-neighborhood. Despite its
   small size, it includes very interesting solutions and proposals that
   cover various urban aspects: social cohesion and a rich and varied
   affordable housing program; bioclimatic urbanism and the promotion of
   energy efficiency; mobility and streets' design; the promotion of
   biodiversity and the design of green areas such as the Jardin des
   Justes; water and waste management; and, finally, the architecture of
   the buildings and the inner common patios.},
