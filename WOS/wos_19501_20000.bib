@article{ WOS:001640221100001,
Author = {Montalban, Karl and Moszkowicz, Thierry and St-Denis, Annick and
   Messier, Christian and Beland, Martin},
Title = {Exploring the impact of ice storm on urban forests and branch fall using
   mobile LiDAR},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {116},
Month = {FEB},
Abstract = {Ice storms are a major threat to urban trees, often causing severe
   structural damage and increasing risks to public safety, power lines and
   property. However, large-scale and quantitative analysis of branch-level
   failure factors is lacking. This study aims to bridge this gap by
   proposing a novel methodology to automatically identify and analyze
   broken branches following a major ice storm. We utilized Mobile Laser
   Scanning (MLS) data acquired before and after the April 2023 ice storm
   in the Town of Mount Royal, on the island of Montr \& eacute;al, Qu \&
   eacute;bec. Our proposed voxel-based change detection method identified
   branches present before the storm but absent after. We then generated
   over 1200 individual tree 3D structural reconstructions using
   Quantitative Structure Models (QSMs) to extract detailed metrics
   (including cumulated length, total surface area, angle, attachment
   radius and distance from attachment to center-of-mass) for both intact
   and fallen branches. The proposed methodology showcase that fallen
   branches exhibit significantly greater cumulative length and total
   surface area than intact branches (high ratio of mean values and p-value
   < 10(-5)), while other metrics do not show sstatistical separation. The
   proposed MLS-QSM workflow demonstrates promising results for
   large-scale, automated urban tree risk assessment, building on initial
   insights into storm-related failure factors. However, further validation
   is required to refine predictive capabilities. This study lays the
   groundwork for future research aimed at improving preventive pruning
   strategies and mitigating storm-related hazards in urban forests.},
