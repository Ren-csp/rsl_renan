@article{ WOS:001329197900001,
Author = {Altanlar, Asli and Aktan, Esin Ozlem Aktuglu and Eren, Ibrahim},
Title = {Development, Reliability, and Validity of the Influences of Digital
   Technologies on Human Behavior in Public Space Scale Tested by Spatial
   Design Experts},
Journal = {SAGE OPEN},
Year = {2024},
Volume = {14},
Number = {3},
Month = {JUL},
Abstract = {The widespread use of digital technologies and online social networks
   causes a shift that has a pronounced impact on public space, public
   life, and public space design. However, research into this
   transformation is quite constrained. This study aims to illuminate how
   digital technologies influence individuals and their behavior in public
   spaces. A comprehensive conceptual scale was developed in the study to
   assess the impact of digital technology use on human behavior in public
   spaces. A structural equation model (SEM) was proposed after testing the
   scale's construct validity. According to the findings, the factors
   influencing the scale were social isolation (F1), media influence (F2),
   placelessness and/or homogeneity (F3), techno-stress-related social
   anxiety (F4), and digital addiction (F5). The SEM (Structural Equation
   Modeling) results demonstrated strong relationships among these factors,
   with digital addiction significantly predicting social isolation (beta =
   .90; p < .01) and placelessness (beta = .74; p < .01). The media
   influence factor had the most substantial effect on
   techno-stress-related social anxiety. This study contributes
   significantly to the literature by understanding the influences of
   digital technologies on public life and adapting public space design to
   this new reality. The findings also guide prospective studies into the
   effects of digital technologies in public spaces, offering valuable
   insights for urban planning, social psychology, architecture, and social
   sciences research.},
