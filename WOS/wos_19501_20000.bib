Year = {2015},
Volume = {12},
Number = {2},
Pages = {362-374},
Month = {APR},
Abstract = {This research aimed to study the non-formal learning of an aquarium
   visitors on issues related to environmental care and conservation.
   Information for this study was collected using the Personal Meaning
   Mapping tool from 40 participants who first visited an aquarium. The
   results show that before the aquarium tour, visitors had very general
   ideas regarding environmental care and conservation. The visit to the
   aquarium helped participants to elaborate, expand and refine their
   ideas.},
