@article{ WOS:001739879000001,
Author = {Varga, Attila and Buvar, Agnes and Scherer, Gabor Sebastian and Szabo,
   Abel Zoltan and Toth, Csenge and Dull, Andrea and Agoston, Csilla},
Title = {The ambivalent role of ``Dragons of inaction{''} in the forming of
   pro-environmental behaviours},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {555},
Month = {APR 14},
Abstract = {Understanding the psychological barriers that inhibit pro-environmental
   behaviours is essential for designing effective interventions to promote
   environmental action. Although the Dragons of Inaction Psychological
   Barriers scale is widely used for this purpose, empirical evidence
   linking it to actual and intended behaviour remains limited,
   particularly across different cultural contexts. This study validated
   the Hungarian version of the scale using a nationally representative
   sample of 1000 adults and examined the relationships between different
   factors of the psychological barrier, current pro-environmental
   behaviours, future behavioural intentions, and ecoemotions through path
   analyses. The results confirmed an excellent fit of the original
   five-factor structure of the scale in the Hungarian context. Two
   barriers-Change UnnecessaryandConflicting Goals and Aspirations-were
   consistently and negatively associated with both current
   pro-environmental behaviours and future behavioural intentions. These
   effects occurred either directly or indirectly through the mediation of
   eco-emotions. In contrast, Interpersonal Relations,Lack of Knowledge,
   andTokenismexhibited more complex patterns, showing potential positive
   associations with pro-environmental behaviours and behavioural
   intentions. These relationships were also mediated by negative
   eco-emotions, suggesting that some perceived barriers may simultaneously
   motivate engagement when accompanied by emotionalactivation. Overall,
   the findings support the cross-cultural validity of the Dragons of
   Inaction scale and highlight the role of specific psychological barriers
   and eco-emotions in shaping environmental behaviour. Interventions
   aiming to increase pro-environmental behaviours should prioritise
   addressing perceptions that change is unnecessary and that environmental
   action conflicts with personal goals, while also strategically engaging
   emotional processes to foster behavioural engagement.},
