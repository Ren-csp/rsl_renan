@article{ WOS:001409410300001,
Author = {Behn, Oliver and Wichmann, Johannes and Leyer, Michael and Schilling,
   Angelina},
Title = {Spillover effects in environmental behaviors: a scoping review about its
   antecedents, behaviors, and consequences},
Journal = {CURRENT PSYCHOLOGY},
Year = {2025},
Volume = {44},
Number = {5},
Pages = {3665-3689},
Month = {MAR},
Abstract = {Research on environmental spillover, the phenomenon where engaging in
   one environmental behavior (EB) influences the likelihood of engaging in
   another EB, has expanded, introducing various theories and predictors to
   explain it. This study provides an overview and synthesis of the
   examined antecedents, behaviors, and consequences in environmental
   spillover research, while also identifying key gaps and shortcomings in
   the literature. Additionally, we propose a conceptual framework to guide
   future studies in this domain. We conducted a scoping review using
   Google Scholar, EBSCOhost, and Web of Science databases with keywords
   related to ``pro-environmental behavior{''} and ``spillover{''}. From
   610 identified records, 81 studies were included in the final analysis.
   Environmental spillovers are predominantly studied in consumerism (e.g.,
   buying reusable bags) and domestic behaviors (e.g., conserving energy at
   home). Behavioral spillovers (n = 68) are more frequently examined than
   temporal (n = 10) and contextual spillovers (n = 10). Research on
   consequences has mainly focused on promoting (n = 67) or permitting (n =
   27) spillovers, with purging (n = 6) and precipitating (n = 3)
   spillovers being less explored. Concerning antecedents, we identified
   nine categories of internal factors ({''}efficacy beliefs{''},
   ``normative beliefs{''}, ``moral values{''}, ``environmental
   self-identity{''}, ``environmental consciousness{''}, ``personality and
   lifestyle{''}, ``self-focused emotions{''}, ``moral licensing
   thoughts{''}, ``workplace perception{''}) and two categories of external
   factors ({''}characteristics of EB{''}, ``intervention
   characteristics{''}) in the literature. Our review highlights not only
   research gaps but also methodological shortcomings, particularly the
   over-reliance on everyday EB, and the use of homogeneous samples.
   Significant gaps remain in the study of (I) high-cost behaviors, (II)
   long-term spillover effects, (III) organizational behavior settings, and
   (IV) spillovers from anti-environmental behaviors.},
