@article{ WOS:001001535400001,
Author = {Gallent, Nick and Stirling, Phoebe and Hamiduddin, Iqbal},
Title = {Pandemic mobility, second homes and housing market change in a rural
   amenity area during COVID-19-The Brecon Beacons National Park, Wales},
Journal = {PROGRESS IN PLANNING},
Year = {2023},
Volume = {172},
Number = {SI},
Month = {JUN},
Abstract = {The Covid-19 pandemic has been presented as a critical change driver for
   rural amenity areas, precipitating urban flight and a decentralisation
   of housing choice and investment. House prices in both near-urban and
   more distant rural markets saw considerable growth in 2020 and 2021,
   linked to a mix of second home investment, expanded demand for holiday
   letting, migration to exploit flexible-working opportunities, and
   homebuying for early retirement. These demand-side pressures, apparently
   accentuated by the pandemic, combine with supplyside constraints on
   development in rural areas (which can accommodate a limited amount of
   additional housing) to produce significant housing stress. However,
   processes affecting some areas, in different parts of the world, have
   arguably been generalised to all areas, and localised processes remain
   under-investigated. This monograph explores the experience of the Brecon
   Beacons National Park in Wales, UK - an amenity area with good
   connectivity to a number of major urban centres and therefore sources of
   extra-local housing demand. Focusing on second home buying, as a leading
   element of extra-local pressure in amenity areas, the monograph
   considers the particular circumstances of this area. It shows that a
   combination of amplified demand-side factors, linked to the pandemic,
   and heightened supply-side constraints, due to a phosphate crisis
   affecting the National Park's major river catchments, requires a
   programme of actions that extends beyond the housing domain in order to
   resolve escalating housing market challenges and associated community
   and economic risks.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
