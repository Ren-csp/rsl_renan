@article{ WOS:001728492200001,
Author = {Lovibond, Sabina},
Title = {Critical Naturalism and the Crisis of Nature},
Journal = {CRITICAL HORIZONS},
Year = {2025},
Volume = {26},
Number = {4, SI},
Pages = {345-360},
Month = {OCT 2},
Abstract = {This paper offers exposition, development and (occasional) constructive
   criticism of themes from the critical naturalism Manifesto (Gregoratto
   and others, 2022). The idea of a naturalist rethinking of normative
   philosophical disciplines, notably ethics and epistemology, is brought
   into connection with the Manifesto's emphasis on the somewhat
   disorderly, precarious and vulnerable aspects of our embodied life: the
   ``naturalism of second nature{''}, it is suggested, can be understood as
   hospitable to these. Equally central to the discussion, however, is the
   need for a philosophical response to the intensifying crisis of our
   relationship to ``nature{''} in the material (ecological) sense. Whereas
   traditional conceptions of critique have generally given precedence to
   human powers of reinvention, or reordering of the social order, the
   Manifesto seeks to balance this (indispensable) libertarian tendency by
   calling for a reconciliation with both ``inner{''} and ``outer{''}
   nature. The present paper applauds this move but remarks on a possible
   tension between the naturalist ideal of ``care for self{''} and the
   imminent culture shock of having to make radical changes to our way of
   life to secure our collective survival. In this context, a critical
   perspective on existing notions of hedonism and of the (subjectively)
   good life is commended as our most hopeful resource.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
