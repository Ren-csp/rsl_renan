@article{ WOS:001214899100001,
Author = {Djontu, Bruno Legrand and Charbonneau, Etienne},
Title = {Should the Canadian Public Service Worry about the Polarization in the
   Perceptions of Social Problems?},
Journal = {CANADIAN PUBLIC ADMINISTRATION-ADMINISTRATION PUBLIQUE DU CANADA},
Year = {2024},
Volume = {67},
Number = {2},
Pages = {266-281},
Month = {JUN},
Abstract = {This study analyzes the polarization of perceptions of social problems
   in Canada to assess if social issues polarization was an element of the
   environment (Hodgetts, 1964). We analyzed data from the Canadian
   Election Study collected between 1993 and 2021. We compare urban
   university-educated and rural non-university-educated Canadians'
   opinions regarding their perceptions of certain social problems in
   Canada. Our results show that there are some disagreements between the
   two groups. However, the data and methods used do not allow us to
   confirm a trend towards polarization. Polarization over social problems
   is not yet shaping Canadian public administrations.
   Cette \& eacute;tude analyse la polarisation des perceptions des probl
   \& egrave;mes sociaux au Canada afin d'\& eacute;valuer si la
   polarisation des probl \& egrave;mes sociaux est un \& eacute;l \&
   eacute;ment environnemental (Hodgetts, 1964). Nous avons analys \&
   eacute; les donn \& eacute;es de l'\& Eacute;tude \& Eacute;lectorale
   Canadienne collig \& eacute;es entre 1993 et 2021. Nous comparons les
   opinions des citoyens dipl \& ocirc;m \& eacute;s universitaires urbains
   et des citoyens ruraux sans dipl \& ocirc;mes universitaires concernant
   leurs perceptions de certains probl \& egrave;mes sociaux au Canada. Nos
   r \& eacute;sultats indiquent l'existence de d \& eacute;saccords entre
   les deux groupes. Toutefois, les donn \& eacute;es et les m \&
   eacute;thodes utilis \& eacute;es ne permettent pas de confirmer une
   tendance accrue \& agrave; la polarisation. La polarisation sur les
   probl \& egrave;mes sociaux ne fa \& ccedil;onne pas encore les
   administrations publiques canadiennes.},
