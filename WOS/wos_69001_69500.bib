@article{ WOS:001301709800021,
Author = {Ling, Xin and Sun, Qifa and Liu, Tao and Guo, Lin and Hu, Chen and Li,
   Chang},
Title = {Research and Risk Assessment on Heavy Metal Pollution in Soil of Wutai
   Region, China},
