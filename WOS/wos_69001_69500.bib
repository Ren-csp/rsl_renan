@article{ WOS:000255302300020,
Author = {Topa Cantisano, Gabriela and Dominguez, J. R. Morales and Depolo, Marco},
Title = {Perceived sexual harassment at work:: Meta-analysis and structural model
   of antecedents and consequences},
Journal = {SPANISH JOURNAL OF PSYCHOLOGY},
Year = {2008},
Volume = {11},
Number = {1},
Pages = {207-218},
Month = {MAY},
Abstract = {Although sexual harassment has been extensively studied, empirical
   research has not led to firm conclusions about its antecedents and
   consequences, both at the personal and organizational level. An
   extensive literature search yielded 42 empirical studies with 60
   samples. The matrix correlation obtained through meta-analytic
   techniques was used to test a structural equation model. Results
