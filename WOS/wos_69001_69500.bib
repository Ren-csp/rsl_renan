@article{ WOS:000568493800001,
Author = {Higham, J. E. and Ramirez, C. Acosta and Green, M. A. and Morse, A. P.},
Title = {UK COVID-19 lockdown: 100 days of air pollution reduction?},
Journal = {AIR QUALITY ATMOSPHERE AND HEALTH},
Year = {2021},
Volume = {14},
Number = {3},
Pages = {325-332},
Month = {MAR},
Abstract = {On the 23 March 2020, a country-wide COVID-19 lockdown was imposed on
   the UK. The following 100 days saw anthropogenic movements quickly halt,
   before slowly easing back to a ``new{''} normality. In this short
   communication, we use data from official UK air-quality sensors (DEFRA
   AURN) and the UK Met Office stations to show how lockdown measures
   affected air quality in the UK. We compare the 100 days post-lockdown
   (23 March to 30 June 2020) with the same period from the previous 7
   years. We find, as shown in numerous studies of other countries, the
   nitrogen oxides levels across the country dropped substantially (similar
   to 50\%). However, we also find the ozone levels increased (similar to
   10\%), and the levels of sulphur dioxide more than doubled across the
   country. These changes, driven by a complex balance in the air chemistry
   near the surface, may reflect the influence of low humidity as suggested
   by Met Office data, and potentially, the reduction of nitrogen oxides
   and their interactions with multiple pollutants.},
Publisher = {SPRINGER},
Address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Higham, JE (Corresponding Author), Univ Liverpool, Sch Environm Sci, Roxby Bldg, Liverpool, Merseyside, England.
   Higham, J. E.; Ramirez, C. Acosta; Green, M. A.; Morse, A. P., Univ Liverpool, Sch Environm Sci, Roxby Bldg, Liverpool, Merseyside, England.},
DOI = {10.1007/s11869-020-00937-0},
EarlyAccessDate = {SEP 2020},
ISSN = {1873-9318},
EISSN = {1873-9326},
Keywords = {COVID-19; Air quality; Monitoring; Public health},
