@article{ WOS:001040688400001,
Author = {Rodriguez de la Rosa, Ana Lucia and Stephens, Dionne and Montes, Felipe
   and Sarmiento, Olga L. and de la Vega-taboada, Eduardo L. and Eaton,
   Asia and Schreiber Compo, Nadja and Madhivanan, Purnima},
Title = {Adolescent Social Networks and Physical Intimate Partner Violence Among
   Colombian Rural Adolescents},
Journal = {JOURNAL OF AGGRESSION MALTREATMENT \& TRAUMA},
Year = {2024},
Volume = {33},
Number = {3},
Pages = {311-333},
Month = {MAR 3},
Abstract = {The current study analyzes individual and social network correlates of
   adolescent engagement in physical intimate partner violence (IPV)
   utilizing socio-centric data from a high-school population of 242
   adolescents from rural Colombia. We studied self-reported victimization
   and perpetration for boys and girls. First, we used logistic regression
   to explore the relationship between adolescents' IPV engagement and
   school peers' IPV engagement, school violence victimization, and social
   network position, controlling for gender and age (N = 111). Second, we
   used social network statistical methods to investigate if there were
   more friendships of similar IPV status to the adolescent than expected
   by chance in their social networks. Our results show that the proportion
   of friends perpetrating physical IPV increased the probability of
   adolescents' IPV perpetration. Contrarywise, the proportion of friends
   experiencing IPV victimization decreased with the adolescent's own
   victimization. Being a victim (a status significantly more common among
   boys) was also associated with reporting perpetration for both genders.
   Furthermore, our results contradicted the social network literature, as
   we found no preferential ties among perpetrators/victims (e.g.
   adolescents do not seem to befriend each other by IPV engagement). Our
   study is unique to the global adolescent IPV literature given the
   scarcity of research examining physical IPV among adolescents in the
   context of both girls and boys in the context of their school networks.
   We also add to the understanding of IPV in the case of the global
   majority of adolescents with the highest rates of IPV victimization
   (living in low and middle-income countries).},
