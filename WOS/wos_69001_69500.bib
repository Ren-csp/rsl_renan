@article{ WOS:001817660600008,
Author = {Rivas, Edgardo J. Sanchez and Sadler, Fredrik and Safdari, Mohammadamin
   and Patel, Nishaben M. and Ritt, Michael and Ma, Ning and Branciamore,
   Sergio and Vaidehi, Nagarajan and Sivaramakrishnan, Sivaraj},
Title = {Selective positive allosteric modulation of βAR using antibody fragments
   targeting the third intracellular loop},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 6},
Abstract = {GPCR therapeutics primarily target structured cavities formed by the
   seven transmembrane alpha-helices. However, amino acid sequence
   conservation in structured regions, especially among receptor subtypes,
   limits target selectivity. Here, we leverage the sequence divergence of
   the third intracellular loop (ICL3) of the receptor fold to derive a
   selective positive allosteric modulator for the beta 2 adrenergic
   receptor (beta 2AR). We repurpose the variable regions of a previously
   reported monoclonal antibody (Mab5) as single-chain (ScFv5) and
   single-domain (VhhL5) antibody fragments that enhance the maximal second
   messenger cyclic AMP signaling response downstream of the receptor.
   Despite ScFv5 binding a segment of ICL3 distinct to beta 2AR, it also
   non-selectively binds and modulates cAMP signaling downstream of beta
   1AR and beta 3AR. We find that this lack of specificity stems from
   multiple redundant interactions that facilitate ScFv5-ICL3 binding. In
   contrast, VhhL5, derived from the Mab5 light chain, selectively
   modulates beta 2AR signaling over the beta 1/beta 3 subtypes.
   Mechanistically, VhhL5 enhances agonist-stimulated beta 2AR-G protein
   coupling through releasing autoinhibitory ICL3 conformational states. In
   parallel, VhhL5 decreases beta 2AR internalization promoting greater
   ligand-induced accumulation of cAMP. Our study demonstrates
   proof-of-concept for selective allosteric modulation of a GPCR by
   targeting a sequence divergent loop region within the receptor fold.},
