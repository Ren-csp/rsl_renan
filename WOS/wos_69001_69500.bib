@article{ WOS:000887234000001,
Author = {Kowalski, Grzegorz and Slebarska, Katarzyna},
Title = {Remote Working and Work Effectiveness: A Leader Perspective},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {22},
Month = {NOV},
Abstract = {Currently, job duties are massively transferred from in-person to remote
   working. Existing knowledge on remote working is mainly based on
   employees' assessment. However, the manager's perspective is crucial in
   organizations that turned into remote work for the first time facing
   sudden circumstances, i.e., SARS-CoV-2 pandemic. The main aim of our
   study was to analyze remote work effectiveness perceived by managers (N
   = 141) referring to three crucial aspects, i.e., manager, team, and
   external cooperation. We assumed the perceived benefits, limitations,
   and online working frequency as predictors of remote work effectiveness.
   Further, we analyzed the possible differences in remote work perception
   referring to different management levels (i.e., middle-level and
   lower-level). Our findings revealed a significant relationship between
   the benefits and effectiveness of managers and external cooperation,
   specifically among lower-level managers. Limitations, particularly
   technical and communication issues, predicted team and external
   cooperation effectiveness. The results showed remote work assessment as
   being socially diverse at the management level.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Slebarska, K (Corresponding Author), Univ Silesia Katowice, Inst Psychol, PL-40007 Katowice, Poland.
   Kowalski, Grzegorz; Slebarska, Katarzyna, Univ Silesia Katowice, Inst Psychol, PL-40007 Katowice, Poland.},
DOI = {10.3390/ijerph192215326},
Article-Number = {15326},
EISSN = {1660-4601},
