@article{ WOS:000720301500001,
Author = {Long, Lingyun and Wei, Jun and Lim, Seon Ah and Raynor, Jana L. and Shi,
   Hao and Connelly, Jon P. and Wang, Hong and Guy, Cliff and Xie, Boer and
   Chapman, Nicole M. and Fu, Guotong and Wang, Yanyan and Huang, Hongling
   and Su, Wei and Saravia, Jordy and Risch, Isabel and Wang, Yong-Dong and
   Li, Yuxin and Niu, Mingming and Dhungana, Yogesh and Anil, K. C. and
   Zhou, Peipei and Vogel, Peter and Yu, Jiyang and Pruett-Miller, Shondra
   M. and Peng, Junmin and Chi, Hongbo},
Title = {CRISPR screens unveil signal hubs for nutrient licensing of T cell
   immunity},
Journal = {NATURE},
Year = {2021},
Volume = {600},
Number = {7888},
Pages = {308+},
Month = {DEC 9},
Abstract = {Nutrients are emerging regulators of adaptive immunity(1). Selective
   nutrients interplay with immunological signals to activate mechanistic
   target of rapamycin complex 1 (mTORC1), a key driver of cell
   metabolism(2-4), but how these environmental signals are integrated for
   immune regulation remains unclear. Here we use genome-wide CRISPR
   screening combined with protein-protein interaction networks to identify
   regulatory modules that mediate immune receptor- and nutrient-dependent
   signalling to mTORC1 in mouse regulatory T (T-reg) cells. SEC31A is
   identified to promote mTORC1 activation by interacting with the GATOR2
   component SEC13 to protect it from SKP1-dependent proteasomal
   degradation. Accordingly, loss of SEC31A impairs T cell priming and
   T-reg suppressive function in mice. In addition, the SWI/SNF complex
   restricts expression of the amino acid sensor CASTOR1, thereby enhancing
   mTORC1 activation. Moreover, we reveal that the CCDC101-associated SAGA
   complex is a potent inhibitor of mTORC1, which limits the expression of
   glucose and amino acid transporters and maintains T cell quiescence in
   vivo. Specific deletion of Ccdc101 in mouse T-reg cells results in
   uncontrolled inflammation but improved antitumour immunity.
   Collectively, our results establish epigenetic and post-translational
   mechanisms that underpin how nutrient transporters, sensors and
   transducers interplay with immune signals for three-tiered regulation of
   mTORC1 activity and identify their pivotal roles in licensing T cell
   immunity and immune tolerance.},
