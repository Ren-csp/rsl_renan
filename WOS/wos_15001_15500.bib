@article{ WOS:001741914400001,
Author = {Korah, Andrews and Wimberly, Michael C.},
Title = {Expansion of cities drives tree cover loss in rapidly urbanizing regions
   of West Africa},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {120},
Month = {JUN},
Abstract = {Urbanization and forest loss are both major elements of global
   environmental change, yet their connections are understudied in tropical
   West Africa, a hotspot for rapid urban sprawl and deforestation. We
   explored tree cover trends and drivers related to urban growth in the
   moist forest ecoregions of Ghana and Nigeria, extending methods from a
   previous regional study of urban expansion to generate comparable tree
   cover data. Landsat data from 2001 to 2020 were processed using machine
   learning and time series approaches to classify tree cover (> 30\%
   canopy cover) with a producer accuracy of 82\% and a user accuracy of
   83\%. Across the study area, tree cover decreased by 4.7\%, from 162,466
   km \& sup2; in 2001 to 154,758 km \& sup2; in 2020. City boundaries
   encompassing urban and peri-urban areas accounted for 42\% of this
   change area despite occupying only 7.4\% of the study area. Over this
   period, the average annual tree cover change rate in cities was -4.68\%
   and was highest in medium-sized cities. We analyzed how urban expansion
   influenced tree cover change at multiple scales. Urban expansion rates
   were associated with high rates of tree cover loss within city
   boundaries, reflecting direct effects of development, and in adjacent
   buffers, reflecting spillover effects from land use displacement. Forest
   loss within city boundaries and buffers was also associated urban
   expansion in neighboring cities, reflecting broader regional
   telecoupling within the urban network. In West Africa, recognition of
   urbanization as an important regional driver of tree cover loss should
   catalyze more forest conservation and urban greening initiatives.},
