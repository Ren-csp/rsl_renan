   Lopez, Alfonso Jesus Gil and Mousavi, Hooman},
Title = {DO ENGINEERING STUDENTS AND ACTIVE ENGINEERS RECEIVE BENEFITS IF THEY
   PUT ENVIRONMENTAL EDUCATION INTO PRACTICE?},
Journal = {PERSPECTIVA EDUCACIONAL},
Year = {2024},
Volume = {63},
Number = {3},
Pages = {257-284},
Month = {DEC},
Abstract = {This study analyzes the social, economic, and environmental benefits of
   environmental education (EE) programs in educational institutions in
   Mexico, focusing on the relationships between environmental benefits
   (ENB), economic benefits (ECB), and social benefits (SOB) through a
   structural equation model validated with information from 573 responses
   to a questionnaire and using the partial least squares technique. The
   results mean that SOB has a direct and positive effect on ECB. In
   addition, it offers recommendations to effectively integrate EE into the
   planning, design, construction, and engineering-related project
   processes to maximize the realization and perception of benefits (ECB,
   ENB, and SOB).},
