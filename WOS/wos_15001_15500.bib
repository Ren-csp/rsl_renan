@article{ WOS:000369328600020,
Author = {Cheng, Jen-Hsuan and Hsieh, Ming-Jui and Chen, Kang-Shin},
Title = {Characteristics and Source Apportionment of Ambient Volatile Organic
   Compounds in a Science Park in Central Taiwan},
Journal = {AEROSOL AND AIR QUALITY RESEARCH},
