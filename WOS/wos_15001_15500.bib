@article{ WOS:001741249600001,
Author = {Kollmann, Josianne and Reckels, Sophie Charlotte and Contzen, Nadja},
Title = {Public perception of microplastics pollution in Switzerland:
   Psychological distance, concern, and willingness to engage in mitigation
   activities},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {111},
Month = {MAY},
Abstract = {Microplastics contaminate water, soil, and air, and have also been
   detected in the human body. However, current evidence - though it is
   limited and marked by considerable uncertainty - indicates risks to
   aquatic ecosystems at high concentrations, while no present threat to
   human health has been established. Given the high level of scientific
   uncertainty and the anticipated delay before negative consequences
   emerge with increasing pollution, microplastics pollution may be
   perceived as psychologically distant, particularly on the hypothetical
   and temporal dimensions. Moreover, an additional dimension - perceived
   biological distance - may be relevant, as scientific evidence indicates
   a danger to aquatic ecosystems but is inconclusive regarding health
   impacts on humans. This study therefore investigated the perceived
   psychological distance of microplastics pollution on the four
   established distance dimensions (spatial, social, temporal, hypothetical
   distance) and on the proposed biological dimension. Additionally, the
   study investigated whether psychological distance can explain public
   concern about microplastics pollution for oneself, for others, and for
   nature, and whether psychological distance can, either directly or
   mediated by concern, explain people's willingness to engage in
   mitigation activities, specifically their behavioural intentions to
   reduce pollution and willingness to pay for mitigation policies. This
   was analysed in an online sample of the German-speaking Swiss population
   (N = 707) using Structural Equation Modelling. The results showed that,
   on average, a low distance towards microplastics pollution was
   perceived, particularly on the biological and hypothetical dimensions,
   contrasting the current scientific evidence. Further, lower
   psychological distance was associated with greater concern for oneself,
   for others, and for nature, as well as with higher behavioural intention
   to reduce pollution, both directly and mediated by concern for nature.
   Higher willingness to pay, however, was only explained by lower
   psychological distance but not by higher concern. Overall, the findings
   show that low perceived psychological distance can explain public
   concern regarding microplastics pollution and may motivate people to
   engage in mitigation activities, even when they are not concerned about
   themselves or humans in general. At the same time, the results suggest
   that concern does not fully account for the relationship between
   psychological distance and mitigation activities, indicating that
   additional mechanisms may also contribute.},
