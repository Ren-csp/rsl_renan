@article{ WOS:000385914900009,
Author = {Parks, Kathleen A. and Levonyan-Radloff, Kristine and Dearing, Ronda L.
   and Hequembourg, Amy and Testa, Maria},
Title = {Development and Validation of a Video Measure for Assessing Women's Risk
   Perception for Alcohol-Related Sexual Assault},
