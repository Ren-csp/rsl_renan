@article{ WOS:001870152400001,
Author = {Bakis, Yasin},
Title = {The ecological abstraction-ecological association continuum: reframing
   biodiversity information infrastructures for human-nature reconnection},
Journal = {FRONTIERS IN CONSERVATION SCIENCE},
Year = {2026},
Volume = {7},
Month = {AUG 26},
Abstract = {Human societies are increasingly disconnected from the ecological
   systems upon which they depend, even as access to biodiversity
   information continues to expand. Biodiversity digitization, natural
   history collections, biodiversity informatics, and artificial
   intelligence have transformed how organisms and ecosystems are
   documented, analyzed, and communicated. While these developments have
   created unprecedented opportunities for scientific discovery and
   conservation, they have also contributed to forms of ecological
   abstraction in which biodiversity is encountered primarily as data,
   records, images, and computational resources rather than as living
   ecological relationships. This paper develops the Ecological
   Abstraction-Ecological Association Continuum, a conceptual framework
   describing how biodiversity information infrastructures shape ecological
   understanding and ecological re-identification by positioning
   biodiversity representations along a spectrum from decontextualized
   information toward context-rich ecological relationships. Ecological
   abstraction occurs when organisms and ecosystems become detached from
   the ecological, historical, cultural, and place-based relationships that
   give them meaning. Ecological association, by contrast, preserves and
   communicates those relationships, enabling biodiversity information to
   remain connected to organisms, places, communities, environmental
   histories, and systems of stewardship. Drawing upon literature from
   biodiversity informatics, museum studies, environmental humanities,
   ecological literacy, provenance research, and community science, we
   argue that such infrastructures are not merely technical systems but
   also systems of representation that shape how biodiversity is perceived,
   understood, and valued. We develop this framework by examining museum
   collections as ecocultural memory systems, provenance as a mechanism for
   preserving relational continuity, participatory biodiversity information
   infrastructures as pathways for ecological engagement, and artificial
   intelligence as both an opportunity and a potential driver of ecological
   abstraction. We propose that the Ecological Abstraction-Ecological
   Association Continuum provides a conceptual basis for understanding how
   biodiversity information infrastructures can either inhibit or support
   ecological re-identification. We hypothesize that infrastructures
   positioned closer to ecological association create conditions that
   enable people to recognize themselves as participants within ecological
   systems by preserving ecological context, provenance, place-based
   relationships, participation, and relational meaning. In turn,
   ecological re-identification is expected to strengthen stewardship and
   enduring human-nature relationships.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
