   Barbara, Zajdel; Jakub, Gabka, Warsaw Univ Life Sci SGGW, Inst Anim Sci, Apiculture Div, Warsaw, Poland.
   Lukasz, Dylewski; Banaszak-Cibicka, Weronika, Poznan Univ Life Sci, Inst Zool, Poznan, Poland.
   Agata, Jojczyk, Warsaw Univ Life Sci SGGW, Inst Environm Engn, Dept Landscape Art, Warsaw, Poland.
   Kornelia, Kucharska, Warsaw Univ Life Sci SGGW, Inst Anim Sci, Dept Anim Environm Biol, Warsaw, Poland.
   Mikolaj, Boranski, Res Inst Hort, Dept Plant Pollinat, Apicultural Div Pulawy, Pulawy, Poland.},
DOI = {10.1111/een.13396},
EarlyAccessDate = {NOV 2024},
ISSN = {0307-6946},
EISSN = {1365-2311},
