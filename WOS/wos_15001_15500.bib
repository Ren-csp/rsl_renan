@article{ WOS:001818932200001,
Author = {Wei, Hubin and Shi, Qiujie and Qi, Wei and Liu, Shenghe and Tang, Ling
   and You, Shiqing},
Title = {Toward greener cities: Navigating the demolition and land use transition
   of urban villages in Beijing, China},
Journal = {CITIES},
Year = {2026},
Volume = {178},
Month = {NOV},
Abstract = {As a type of informal settlement that emerged under China's urban-rural
   dual system, urban villages serve as a key entry point for studying
   China's unique urbanization process and achieving the SDGs. Beijing, the
   capital of China, began to relocate non-capital functions in 2017 under
   the guidance of the Beijing General Plan. Subsequently, the
   disappearance of half of Beijing's informal settlements over the past
   decade has attracted international attention. This study uses a novel
   technical framework that combines remote sensing imagery and social
   media big data. The results show that: a. The land use transitions in
   Beijing's informal settlements during 2016-2020 and 2020-2025
   demonstrate distinct characteristics. Commercial housing and
   construction land did not occupy a dominant position, and their
   prominence continued to decline. b. Instead, ecologically oriented parks
   and green spaces emerged as a significant direction in urban village
   renewal, which is in line with the ecological turn requirements
   nationally. c. However, behind the seemingly vast ecological turn lies
   the filling of functionally-limited greenery rather than
   fully-functional ecological land. By 2025, the grasslands, as ecological
   land with transitional characteristics, had become the largest single
   type of land flow out of urban villages. This greening shortcut has
   merely satisfied the performance requirements of the policy without
   delivering the social or ecological benefits. Herein lies the critical
   point that future planning and policy need to focus and intervene. This
   study aims to unpack Beijing's unique post-demolition greening process
   and draws lessons for the ecological turn in the Global South.},
