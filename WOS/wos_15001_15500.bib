@article{ WOS:001803840800001,
Author = {Li, Bin and Lu, Shaowei and Wang, Man and Yang, Xinbing and Duan,
   Yingrui and Liu, Xu and Zhao, Na and Xu, Xiaotian and Li, Shaoning},
Title = {Urban Green Space Canopy Height Retrieval in Beijing Using GF-7 Stereo
   Pairs: A Multi-Source Feature Fusion Theoretical Framework and Its
   Application to Urban Ecological Assessment},
Journal = {REMOTE SENSING},
Year = {2026},
Volume = {18},
Number = {12},
Month = {JUN 16},
Abstract = {Highlights What are the main findings? Establish a full-process
   framework for GF-7 canopy height retrieval that is standardized,
   replicable, and directly transferable to other megacities. GF-7
   high-resolution stereo pairs overcome the resolution limits of
   spaceborne LiDAR in fragmented urban green spaces, enabling fine
   characterization and resolving the ``large scale but low precision{''}
   contradiction. What are the implications of the main findings? The
   dual-feature selection method (Boruta + RF-RFE) improves model
   robustness and reduces bias, offering a reliable framework for canopy
   height estimation in other fragmented urban landscapes. This study
   validates the feasibility of China's domestic sub-meter stereo satellite
   (GF-7) for monitoring vegetation in small urban patches, promoting its
   large-scale application in urban ecology.Highlights What are the main
   findings? Establish a full-process framework for GF-7 canopy height
   retrieval that is standardized, replicable, and directly transferable to
   other megacities. GF-7 high-resolution stereo pairs overcome the
   resolution limits of spaceborne LiDAR in fragmented urban green spaces,
   enabling fine characterization and resolving the ``large scale but low
   precision{''} contradiction. What are the implications of the main
   findings? The dual-feature selection method (Boruta + RF-RFE) improves
   model robustness and reduces bias, offering a reliable framework for
   canopy height estimation in other fragmented urban landscapes. This
   study validates the feasibility of China's domestic sub-meter stereo
   satellite (GF-7) for monitoring vegetation in small urban patches,
   promoting its large-scale application in urban ecology.Abstract Urban
   canopy height is an essential indicator for characterizing vegetation
   structure and carbon sequestration, yet satellite LiDAR often lacks
   sufficient spatial resolution, airborne LiDAR is costly, and SAR has
   limited sensitivity to vegetation structure. This study proposes a
   canopy height inversion framework using high-resolution stereo pairs
   from the Gaofen-7 (GF-7) satellite. A 0.65 m Digital Surface Model (DSM)
   was generated from GF-7 data, and a relative surface height was derived
   by differencing the GF-7 DSM from a coarse 30 m DSM reference. Key
   features were selected via Boruta and Random Forest Recursive Feature
   Elimination (RF-RFE), and six models-linear, polynomial, support vector
   machine, backpropagation neural network, XGBoost, and RF-were compared.
   The results showed that the Boruta feature set improved average R2 by
   8.2\%. Among all models, RF performed best (test set R2 = 0.71, RMSE =
   1.70 m) and exhibited the strongest resistance to overfitting. Canopy
   heights within Beijing's Fifth Ring Road showed an ``outer-high,
   inner-low{''} pattern: large parks exceeded 30 m, while the Central
   Business District remained below 3 m. GF-7 stereo pairs enable efficient
   and cost-effective retrieval of canopy height in fragmented urban green
   spaces, supporting ecological parameter quantification and urban
   green-space management.},
