@article{ WOS:A1982QA09500001,
Author = {SIKORSKI, MD},
Title = {NON-METRICAL DIVERGENCE OF ISOLATED POPULATIONS OF APODEMUS AGRARIUS IN
   URBAN AREAS},
Journal = {ACTA THERIOLOGICA},
Year = {1982},
Volume = {27},
Number = {13-2},
Pages = {169-180},
Abstract = {Using the frequency of 26 non-metrical skull variants as a basis, a
   comparative analysis was made of genetic differences in 4 populations of
   A. agrarius (Pallas, 1771) inhabiting green spaces in Warsaw {[}Poland].
   Out of 325 calculated coefficients of correlation between variants, 29
   (8.9\%) significantly differed from zero. No significant correlations
   were found between frequency of occurrence of variants and body length.
   Tests were made of the homogeneity of occurrence of variants depending
   on the trapping area, age, sex and relevant seasonal generations. Lack
   of homogeneity of occurrence was found for 7 variants, which were
   omitted from further analysis, as was also 1 variant which failed to
   exhibit frequency differences in different populations. The mean measure
   of divergence was calculated for all pairs of compared populations from
   the frequency of occurrence of the remaining 18 variants, statistically
   significant differences being obtained in all cases. Genetic
   differentiation in the study populations of field mice is indicated.},
