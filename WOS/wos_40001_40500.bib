@article{ WOS:001827905500003,
Author = {Menezes, Nilton Cezar Rodrigues and da Silva, Guilherme Santos and
   Barreto, Laura Amelia Fernandes and do Nascimento, Tatiane Conceicao and
   de Marque Junior, Antonio Carlos},
Title = {Social inequalities and socio-spatial segregation: contributions from
   the work O Cortico to the debate on social exclusion and housing},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {115},
Month = {JUL},
Abstract = {The objective of this study was to analyze the contributions of Alu \&
   iacute;sio Azevedo's novel {*}O Cortico{*} to the debate on social
   inequalities, socio-spatial segregation, social exclusion, and housing,
   considering its parallels with the Brazilian reality and with
   contemporary discussions on urban space and the right to housing. This
   is an integrative literature review with a qualitative approach,
   conducted in accordance with the PRISMA guidelines and based on the PICO
   strategy adapted to the context of the study. The search for studies was
   conducted in the Scientific Electronic Library Online (SciELO), Scopus,
   Directory of Open Access Journals (DOAJ), and Google Scholar databases,
   using search terms related to the work {*}O Cortico{*} by Alu \&
   iacute;sio Azevedo, social inequalities, socio-spatial segregation,
   social exclusion, and housing. We included scientific articles published
   in Portuguese by Brazilian researchers, available in full text, and
   published between 2015 and 2024; five studies were selected for
   analysis. The results showed that the work remains relevant today as a
   tool for understanding the structural inequalities of Brazilian society,
   especially with regard to precarious housing conditions, economic
   exploitation, social marginalization, and the unequal production of
   urban space. It has been identified that the tenement serves as a
   symbolic representation of sociospatial segregation, revealing power
   dynamics, exclusion, and vulnerability that extend beyond the historical
   context of the 19th century. Furthermore, the studies have demonstrated
   that the narrative addresses multiple dimensions of inequality-including
   social class, race, gender, and sexuality- contributing to contemporary
   reflections on the right to the city, social inclusion, and urban
   justice. It is concluded that {*}O Cortico{*} constitutes an important
   interdisciplinary source for understanding historical processes of
   exclusion and the challenges that still exist in building more
   egalitarian and socially just cities.},
Publisher = {APOSTA},
Address = {APOSTA, MADRID, 00000, SPAIN},
