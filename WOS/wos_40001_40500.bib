Pages = {97-108},
Month = {MAR},
Abstract = {Badumna longin qua, the grey house spider (Araneae: Desidae), is native
   to Australia and widely introduced into numerous other countries.
   Recently, this spider was newly discovered from several southern marine
   regions of South Korea, viz, Busan, Geoje, Goheung, Sacheon, Tongyeong,
   Ulsan, Yeosu, and Jeju Island. This species seems to be successfully
   established at least in coastal habitats in the collected regions, since
   numerous individuals and their webs were prevalently found in breakwater
   railings, garden shrubs, inside and outside buildings, and artificial
   structures in harbors and urban parks. A brief description and
   photographs of the species are provided to give basic information for
   monitoring its further spread in South Korea.},
