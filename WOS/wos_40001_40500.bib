@article{ WOS:000363948000025,
Author = {Petit-Boix, Anna and Sevigne-Itoiz, Eva and Avelina Rojas-Gutierrez,
   Lorena and Barbassa, Ademir Paceli and Josa, Alejandro and Rieradevall,
   Joan and Gabarrell, Xavier},
Title = {Environmental and economic assessment of a pilot stormwater infiltration
   system for flood prevention in Brazil},
Journal = {ECOLOGICAL ENGINEERING},
Year = {2015},
Volume = {84},
Pages = {194-201},
Month = {NOV},
Abstract = {Green and grey stormwater management infrastructures, such as the
   filter, swale and infiltration trench (FST), can be used to prevent
   flooding events. The aim of this paper was to determine the
   environmental and economic impacts of a pilot FST that was built in Sao
   Carlos (Brazil) using Life Cycle Assessment (LCA) and Life Cycle Costing
   (LCC). As a result, the components with the greatest contributions to
   the total impacts of the FST were the infiltration trench and the grass
   cover. The system has a carbon footprint of 0.13 kg CO2 eq./m(3) of
   infiltrated stormwater and an eco-efficiency ratio of 0.35 kg CO2
   eq./USD. Moreover, the FST prevented up to 95\% of the runoff in the
   area. Compared to a grey infrastructure, this system is a good solution
   with respect to PVC stormwater pipes, which require a long pipe length
   (1070 m) and have a shorter lifespan. In contrast, concrete pipes are a
   better solution, and their impacts are similar to those of the FST.
   Finally, a sensitivity analysis was conducted to assess the changes in
   the impacts with the varying lifespan of the system components. Thus,
   the proper management of the FST can reduce the economic and
   environmental impacts of the system by increasing its durability. (C)
   2015 Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Petit-Boix, A (Corresponding Author), Univ Autonoma Barcelona, Inst Environm Sci \& Technol ICTA, Sostenipra ICTA IRTA Inedit SGR 1412 2014, Edifici ICTA ICP, E-08193 Barcelona, Spain.
   Petit-Boix, Anna; Sevigne-Itoiz, Eva; Rieradevall, Joan; Gabarrell, Xavier, Univ Autonoma Barcelona, Inst Environm Sci \& Technol ICTA, Sostenipra ICTA IRTA Inedit SGR 1412 2014, E-08193 Barcelona, Spain.
