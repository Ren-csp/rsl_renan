@article{ WOS:001876736800001,
Author = {Llompart, Facundo Manuel and Rojo, Javier Hernan and Romano, Silvina
   Alejandra and Chalde, Tomas},
Title = {Social attitude toward exotic salmonids aquaculture in the Beagle
   Channel, Argentina: Productive opportunity and/or conservation concerns?},
Journal = {CAMBRIDGE PRISMS-COASTAL FUTURES},
Year = {2026},
Volume = {4},
Month = {SEP 9},
Abstract = {The expansion of aquaculture often faces challenges related to
   environmental impacts and social acceptance, particularly when involving
   exotic species. In Argentina, where marine aquaculture remains marginal,
   recent proposals for salmonid farming in Tierra del Fuego province (TDF)
   have sparked public debate, balancing economic development against
   environmental concerns. In response, the local government enacted Law
   1135/2021, banning salmonid farming in the province. This study explores
   public attitudes toward exotic salmonid aquaculture in TDF using a
   mixed-methods approach, combining press discourse analysis with an
   extensive online survey. Results indicate strong public resistance to
   net-pen salmonid farming in the Beagle Channel, especially among TDF
   residents and individuals linked to environmental sciences. In contrast,
   land-based aquaculture and farming of native species receive more
   support. Most respondents doubt the economic benefits of salmonid
   farming, and nearly 80\% of TDF residents support the ban. Notably,
   while there is strong opposition to new exotic introductions, most
   respondents do not support eradication of established salmonid
   populations, which are widely accepted due to their long-standing
   presence and importance for recreational fishing. These findings reflect
   the nuanced views of the local community and emphasize the need for
   socially informed and transparent regulatory frameworks for aquaculture
   development in ecologically sensitive regions.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
