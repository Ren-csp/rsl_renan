@article{ WOS:000484979500029,
Author = {Yen, Hsin-Yen and Li, Ching},
Title = {Determinants of physical activity: A path model based on an ecological
   model of active living},
Journal = {PLOS ONE},
Year = {2019},
Volume = {14},
Number = {7},
Month = {JUL 26},
Abstract = {Maintaining physical activity is necessary to promote health in our
   daily lives. The Ecological Model of Active Living was proposed to
   examine whether individuals participate in active living. The purpose of
   this study was to understand the determinants of physical activity and
   create a predictive path model of the intrapersonal, perceived
   environment, behavior settings, and policy environment domains. Data
   were obtained from open government data and questionnaires, including
   the International Physical Activity Questionnaire, Health Belief Model
   Inventory, Physical Activity Neighborhood Environment Survey, and
   Accessibility of Open Spaces. Participants comprised 1085 healthy adults
   who completed a self-reported internet survey. An analysis of the
   intrapersonal domain revealed that the variables of female, an older
   age, and a low educational level, and individuals with obesity or
   cardiometabolic diseases presented lower odds ratios for active living.
   We found significant statistical support for our path model (The
   Ecological Model of Active Living), with a predictive power of 23.1\%.
