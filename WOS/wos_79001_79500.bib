@article{ WOS:000323770600007,
Author = {Booth, David A.},
Title = {Configuring of Extero- and Interoceptive Senses in Actions on Food},
Journal = {MULTISENSORY RESEARCH},
Year = {2013},
Volume = {26},
Number = {1-2},
Pages = {123-142},
Abstract = {This paper reviews all the published evidence on the theory that the act
   of selecting a piece of food or drink structurally coordinates
   quantitative information across several sensory modalities. The existing
   data show that the momentary disposition to consume the item is
   strengthened or weakened by learnt configurations of stimuli perceived
   through both exteroceptive and interoceptive senses. The observed
   configural structure of performance shows that the multimodal stimuli
   are interacting perceptually, rather than merely combining quantities of
   information from the senses into the observed response.},
