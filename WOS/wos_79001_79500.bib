@article{ WOS:000387823300014,
Author = {Higuchi, Yoko and Ueda, Yoshiyuki and Ogawa, Hirokazu and Saiki, Jun},
Title = {Task-relevant information is prioritized in spatiotemporal contextual
   cueing},
