@article{ WOS:001862035200004,
Author = {Naaf, Tobias and Kernecker, Maria},
Title = {Nature relatedness, rather than species knowledge, facilitates
   biodiversity-friendly food choices},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {3},
Month = {AUG},
Abstract = {. Global food supply chains have decoupled people from food and from
   place. Such fragmentation thereby reinforces ongoing biodiversity
   decline through industrial agricultural land use and food production.
   Transforming the food system requires a reconnection between people and
   nature through food, which could contribute to biodiversity
   conservation. However, given the increasing disconnection of people from
   nature, it is unclear in how far people are aware of their local
   biodiversity and how that is related to their responsibility for
   conservation and their food choice. We used structural equation
   modelling to test a proposed pathway from human-nature connection
   (cognitive and emotional) to felt responsibility and to food choice
   among 463 citizens from two small towns located in a German agricultural
   landscape. Based on freelisting exercises, citizens' biodiversity
   knowledge was limited, but they still felt emotionally related to nature
   based on the nature-relatedness (NR-6) scale. Structural equation models
   revealed that, rather than knowledge of local plant and bird species,
   emotional relatedness determined felt responsibility, which in turn
   positively affected the preference for local and organic food. Our study
   shows that fostering nature relatedness, particularly in young people,
   could promote biodiversity-friendly food choices.},
Publisher = {Resilience Alliance},
Address = {231 Bussey St., Beckwith and Brown, Dedham, Massachusetts, UNITED STATES},
