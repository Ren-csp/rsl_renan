@article{ WOS:000712141700001,
Author = {Amaro, Ines and Saraiva, Jose and Gomes, Ana Catarina and Araujo, Ana
   and Marto, Carlos Miguel and Coelho, Ana and Ferreira, Manuel Marques
   and Paula, Anabela and Carrilho, Eunice},
Title = {Direct Restorations for Anterior Esthetic Rehabilitation and Smile
   Symmetry Recovery: Two Case Reports},
Journal = {SYMMETRY-BASEL},
Year = {2021},
Volume = {13},
Number = {10},
Month = {OCT},
Abstract = {Esthetics is an increasing concern for patients, particularly in
   anterior teeth. The current approaches to manage the esthetic demands
   include options such as prosthodontic rehabilitation, orthodontic
   treatment, and direct restorations. Direct restorative procedures for
   anterior teeth have become a reliable alternative, since current
   composite materials can mimic teeth's esthetics and function perfectly.
   This article describes two clinical cases of anterior esthetic
   rehabilitations where the direct reshaping of the four maxillary
   incisors was performed using the buccolingual layering technique with
   the help of a silicone index. In Case 1, a diastema closure was also
   performed, whereas in Case 2, the replacement of old restorations was
   also carried out. It was possible to achieve excellent final esthetic
   results in both cases, recovering the smile symmetry, and both patients
   were satisfied. The literature supports the use of direct restorations
   in the anterior region with very good long-term prognosis. It is a
   minimally invasive approach that is reversible, repairable,
   cost-effective, and when combined with layering techniques and adequate
   restorative materials, it is possible to achieve good esthetic and
   functional outcomes. However, regular maintenance appointments are
   mandatory, and all cases should be carefully planned to ensure
   predictable and long-lasting results.</p>},
