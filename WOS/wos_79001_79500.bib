@article{ WOS:001707406900011,
Author = {Selvaggi, Roberta and Yagi, Kohei and Pappalardo, Gioacchino and Nayga,
   Rodolfo M.},
Title = {Public acceptance for genetic engineering techniques: the role of food
   values-based information},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {FEB 3},
Abstract = {Genetic engineering techniques are emerging as crucial tools for
   addressing global food challenges. Consumer resistance however remains a
   major barrier to their adoption. This study explores whether framing
   genetical engineered foods around specific food values can increase
   consumers' acceptance and willingness to pay. Using a random effects
   interval regression model to analyze data from 1,000 Italian consumers
   across five staple foods, we find that food value-based messaging
   significantly influences attitudes and willingness to pay. This study
   presents an innovative approach to reducing resistance to genetic
   engineering techniques, highlighting the strategic role of food values
   in science communication and policy-making.},
