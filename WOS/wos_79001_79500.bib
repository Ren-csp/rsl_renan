@article{ WOS:000399674600010,
Author = {Castro-Serrano, Borja and Gutierrez Olivares, Claudia},
Title = {SOCIAL INTERVENTION AND OTHERNESS: A PHILOSOPHICAL APPROACH FROM LEVINAS},
Journal = {ANDAMIOS},
Year = {2017},
Volume = {14},
Number = {33},
Pages = {217-239},
Month = {JAN-APR},
Abstract = {This paper aims to broaden the concept of social intervention in
   contexts of poverty beyond its traditional focus. Thus, the discussion
   will be nourished from Levinas' ``philosophy of meeting{''}, as a
   paradigm that can transform the manner in which we examine
   intersubjective relations. We will think to analyze social intervention
   emphasizing people living the reality of poverty, understanding the
   subjectivity as a world of possibilities and not an intervention that is
   imposed as totalizing knowledge, which reduces the subjective becoming
   and categorizes the individual as lacking.},
