@article{ WOS:000436413600020,
Author = {Parks, Ashley N. and Cantwell, Mark G. and Katz, David R. and Cashman,
   Michaela A. and Luxton, Todd P. and Clar, Justin G. and Perron, Monique
   M. and Portis, Lisa and Ho, Kay T. and Burgess, Robert M.},
Title = {Assessing the release of copper from nanocopper-treated and conventional
   copper-treated lumber into marine waters II: Forms and bioavailability},
Journal = {ENVIRONMENTAL TOXICOLOGY AND CHEMISTRY},
Year = {2018},
Volume = {37},
Number = {7},
Pages = {1969-1979},
Month = {JUL},
Abstract = {One application of nanocopper is as a wood-preserving pesticide in
   pressure-treated lumber. Recent research has shown that pressure-treated
   lumber amended with micronized copper azole (MCA), which contains
   nanosized copper, releases copper under estuarine and marine conditions.
   The form of copper released (i.e., ionic, nanocopper {[}1-100nm in
   size]) is not fully understood but will affect the bioavailability and
   toxicity of the metal. In the present study, multiple lines of evidence,
   including size fractionation, ion-selective electrode electrochemistry,
   comparative toxicity, and copper speciation were used to determine the
   form of copper released from lumber blocks and sawdust. The results of
   all lines of evidence supported the hypothesis that ionic copper was
   released from MCA lumber and sawdust, with little evidence that
   nanocopper was released. For example, copper concentrations in size
   fractionations of lumber block aqueous leachates including unfiltered,
   0.1m, and 3kDa were not significantly different, suggesting that the
   form of copper released was in the size range operationally defined as
   dissolved. These results correlated with the ion-selective electrode
   data which detects only ionic copper. In addition, comparative toxicity
   testing resulted in a narrow range of median lethal concentrations
   (221-257g/L) for MCA lumber blocks and CuSO4. We conclude that ionic
   copper was released from the nanocopper pressure-treated lumber under
   estuarine and marine conditions. Environ Toxicol Chem 2018;37:1969-1979.
   Published 2018 Wiley Periodicals Inc. on behalf of SETAC. This article
   is a US government work and, as such, is in the public domain in the
   United States of America.},
Publisher = {OXFORD UNIV PRESS},
