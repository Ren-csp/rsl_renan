@article{ WOS:001861843700001,
Author = {Singh, Franca and Metag, Julia},
Title = {In Sickness and in Heat - A Content Analysis of German Media Coverage of
   Chronic Diseases and Climate-Related Weather Events},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2026},
Month = {2026 AUG 27},
Abstract = {This study examines how German media frame the link between chronic
   diseases and climate events, an essential yet understudied aspect of
   climate-change communication. A quantitative content analysis of N = 429
   media articles (2010 to mid-2025) investigates framing patterns,
   evidence use, and representations of scientific ambiguity across media
   types. Results indicate that coverage intensity peaks during years
   characterized by particularly severe weather events such as heatwaves,
   suggesting that acute climatic episodes amplify media attention to the
   climate-health nexus even within this event-focused domain. Reports
   predominantly employ Health Severity and Consequence frames, emphasizing
   medical risks and vulnerability while largely neglecting adaptation,
   political responsibility, or action-oriented perspectives. About 70\% of
   articles cite scientific evidence, mainly individual studies and expert
   opinions, yet only one-third address uncertainty, usually in connection
   with preliminary findings or data limits. Overall, German media depict
   the climate-health nexus through a narrow, risk-focused lens that
   informs but rarely empowers. Stronger emphasis on solutions, transparent
   uncertainty communication, and socio-political framing is recommended.},
