@article{ WOS:001512916600001,
Author = {Olapeju, Olasunkanmi and Babalola, Adewara and Fabi, Jonathan and
   Agunbiade, Muyiwa and Babalogbon-Adesina, Oluwafunmilayo and
   Nnebue-Adewoye, Marvelous and Akinde, Mukail and Adedokun, Adebayo},
Title = {Modelling of the vulnerability indicators in flood-prone areas of
   Abeokuta, Ogun State, Nigeria},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {27},
Month = {SEP},
Abstract = {This study adopted the Structural Equation Modelling to validate the
   four constructs hypothesized in UNESCO-IHE's framework not previously
   considered in previous modelling endeavours within the context of the
   flood-prone communities in Abeokuta, Nigeria. Relying on expert
   opinions, the study developed, screened and scoped the constructs,
   sub-constructs, and relevant indicators adopted during the field
   observation and survey. Questionnaire was used to collect relevant data
   from 380 households in 20 purposively selected communities. The
   structural model established that physical factor (beta = 1.222, p <
   0.05) and environmental factor (beta = 0.896, p < 0.05) are pivotal
   constructs influencing flood vulnerability. Notably, with respect to the
   physical construct, topography, river discharge, and rainfall emerge as
   key exposure indicators (beta = 0.505, p < 0.05), while dams and storage
   capacity, and evacuation routes are the crucial resilience indicators
   (beta = 0.993, p < 0.05). Similarly, for the environmental construct,
   natural reservations and presence of green areas emerge as veritable
   susceptibility indicators (beta = 0.754, p < 0.05), while access to
   meteorological data and environmental recovery turned out being the
   significant resilience indicators (beta = 0.953, p < 0.05). The results
   of the modelling afford cost-effective prioritisation of specific
   measures that address the significant vulnerability factors as
   adaptation strategies that culminate in sustainable development.},
