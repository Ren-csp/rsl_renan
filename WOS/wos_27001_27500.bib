Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Maillard, O (Corresponding Author), Fdn Conservac Bosque Chiquitano FCBC, Santa Cruz, Bolivia.
   Maillard, Oswaldo; Mielich, Nicolas, Fdn Conservac Bosque Chiquitano FCBC, Santa Cruz, Bolivia.
