@article{ WOS:001773782500001,
Author = {Johnson, Urban and Linner, Lukas and Jonsson, Linus},
Title = {Student perceptions across four decades: ethical, professional, and
   technological shifts in Swedish sport and exercise psychology education},
Journal = {SPORT EDUCATION AND SOCIETY},
Year = {2026},
Month = {2026 MAY 26},
Abstract = {Over the past decades, Sport and Exercise Psychology (SEP) has evolved
   globally, emphasizing interdisciplinarity, professionalization, and
   applied practice. In Sweden, these developments mirror international
   trends while reflecting local educational and cultural contexts. This
   study investigates how 2025 undergraduate students at a Swedish
   university perceive SEP and explores their emerging professional
   identities. It also situates these perspectives historically by
   comparing them with cohorts from 1995, 2005, and 2015, offering
   implications for the development of SEP toward 2035. Data were collected
   through reflective essays from the 2025 cohort (n = 25) and analyzed
   using reflexive thematic analysis to identify current perceptions,
   challenges, and future aspirations. To contextualize the findings
   historically, a recurrent cross-sectional profiling approach was applied
   across all cohorts, enabling systematic comparison while preserving the
   original analyses. Results indicate that contemporary students emphasize
   mental health advocacy, inclusivity, relational practice, and
   interdisciplinary collaboration, positioning SEP as increasingly
   relevant in youth sport, education, and community well-being. Persisting
   challenges include stigma, uneven access, unclear career pathways, and
   ethical dilemmas associated with emerging technologies, such as
   artificial intelligence. Historical comparisons reveal a shift from
   early cohorts' focus on elite performance toward later cohorts' broader
   concerns with well-being, social responsibility, and ethical engagement.
   Across cohorts, students expressed cautious optimism regarding SEP's
   professionalization and societal impact, tempered by concerns about
   commercialization, institutional activity, and the ethics of technology.
   Students emphasized the importance of reflective and supportive learning
   environments for developing ethically grounded professional identities.
   Practically, the findings underscore the importance of reflective
   supervision, interdisciplinary collaboration, and culturally competent,
   value-informed curricula in fostering sustainable professional
   development in SEP. Future research may investigate how digitalization,
   cultural diversity, and institutional structures influence the formation
   of professional identity and ethical engagement, ensuring that SEP
   education remains relevant, inclusive, and future-oriented.},
