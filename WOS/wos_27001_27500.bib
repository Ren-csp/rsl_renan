@article{ WOS:001689459900001,
Author = {Perez-Sindin, Xaquin S.},
Title = {Ideology, environmental attitudes, and perceived pace of transition:
   explaining public acceptance of fossil fuel phase-out in Spain},
Journal = {ENVIRONMENTAL SOCIOLOGY},
Year = {2026},
Month = {2026 FEB 15},
Abstract = {This article investigates acceptance of fossil fuel phase-out policies
   across national, regional, and local contexts in Spain. Drawing on data
   from a multi-scalar survey - including a nationally representative
   sample, a regional coal-mining subsample, and a locality embedded in
   coal production (As Pontes) - the study examines how demographics,
   political orientation, climate skepticism, perceptions of fairness, and
   perceived transition tempo shape public attitudes toward coal plant
   closures. The findings reveal a territorial gradient in support: highest
   at the national level, lower in coal municipalities, and lowest in As
   Pontes. While political orientation strongly predicts support
   nationally, this effect weakens in highly affected areas, where climate
   skepticism becomes the primary predictor - even among left-leaning
   respondents. The study introduces perceived transition tempo as a novel
   explanatory factor, suggesting that perceptions of rapid, top-down
   change can erode legitimacy. Resistance in As Pontes reflects not only
   material or ideological concerns but also emotional and symbolic
   dimensions, such as place attachment and perceived cultural
   displacement. The findings challenge fixed assumptions about ideological
   resistance and highlight the importance of temporal and territorial
   justice in shaping transition legitimacy. The article contributes to
   debates in environmental sociology by integrating spatial, symbolic, and
   temporal perspectives on public responses to decarbonization.},
