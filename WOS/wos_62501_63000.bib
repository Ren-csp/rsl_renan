@article{ WOS:000366330500018,
Author = {Fischer, Joern and Gardner, Toby A. and Bennett, Elena M. and Balvanera,
   Patricia and Biggs, Reinette and Carpenter, Stephen and Daw, Tim and
   Folke, Carl and Hill, Rosemary and Hughes, Terry P. and Luthe, Tobias
   and Maass, Manuel and Meacham, Megan and Norstrom, Albert V. and
   Peterson, Garry and Queiroz, Cibele and Seppelt, Ralf and Spierenburg,
   Marja and Tenhunen, John},
Title = {Advancing sustainability through mainstreaming a social-ecological
   systems perspective},
Journal = {CURRENT OPINION IN ENVIRONMENTAL SUSTAINABILITY},
Year = {2015},
Volume = {14},
Pages = {144-149},
Month = {JUN},
Abstract = {The concept of social-ecological systems is useful for understanding the
   interlinked dynamics of environmental and societal change. The concept
   has helped facilitate: (1) increased recognition of the dependence of
   humanity on ecosystems; (2) improved collaboration across disciplines,
   and between science and society; (3) increased methodological pluralism
   leading to improved systems understanding; and (4) major policy
   frameworks considering social-ecological interactions. Despite these
   advances, the potential of a social-ecological systems perspective to
   improve sustainability outcomes has not been fully realized. Key
   priorities are to: (1) better understand and govern social-ecological
   interactions between regions; (2) pay greater attention to long-term
   drivers; (3) better understand the interactions among power relations,
   justice, and ecosystem stewardship; and (4) develop a stronger
   science-society interface.},
