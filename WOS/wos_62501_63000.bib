@article{ WOS:000430522800013,
Author = {Kwon, Elizabeth and Seo, Dong-Chul and Lin, Hsien-Chang and Chen,
   Zhongxue},
Title = {Predictors of youth e-cigarette use susceptibility in a US nationally
   representative sample},
Journal = {ADDICTIVE BEHAVIORS},
