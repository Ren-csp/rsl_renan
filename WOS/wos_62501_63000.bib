@article{ WOS:000565659200001,
Author = {Teques, Pedro and Silva, Carlos and Rosado, Antonio and Calmeiro, Luis
   and Serpa, Sidonio},
Title = {Refining the Short Version of the Leadership Scale for Sports: Factorial
   Validation and Measurement Invariance},
Journal = {PSYCHOLOGICAL REPORTS},
