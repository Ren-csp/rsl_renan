   Belton, Valerie, Univ Strathclyde, Sch Business, Dept Management Sci, Glasgow, Lanark, Scotland.
   Chalabi, Zaid, London Sch Hyg \& Trop Med, Dept Social \& Environm Hlth Res, Fac Publ Hlth \& Policy, London WC1, England.
   Mechler, Reinhard, Vienna Univ Econ \& Business, Inst Reg Dev \& Environm, Vienna, Austria.
   Puig, Daniel, Tech Univ Denmark, UNEP Riso Ctr, DTU Management Engn, Roskilde, Denmark.},
DOI = {10.1007/s11027-013-9538-z},
ISSN = {1381-2386},
