@article{ WOS:000363620900002,
Author = {Thammaporn, Ratsupa and Yagi-Utsumi, Maho and Yamaguchi, Takumi and
   Boonsri, Pornthip and Saparpakorn, Patchreenart and Choowongkomon,
   Kiattawee and Techasakul, Supanna and Kato, Koichi and Hannongbua, Supa},
Title = {NMR characterization of HIV-1 reverse transcriptase binding to various
   non-nucleoside reverse transcriptase inhibitors with different
   activities},
Journal = {SCIENTIFIC REPORTS},
Year = {2015},
Volume = {5},
Month = {OCT 29},
Abstract = {Human immunodeficiency virus type 1 reverse transcriptase (HIV-1 RT) is
   an important target for antiviral therapy against acquired
   immunodeficiency syndrome. However, the efficiency of available drugs is
   impaired most typically by drug-resistance mutations in this enzyme. In
   this study, we applied a nuclear magnetic resonance (NMR) spectroscopic
   technique to the characterization of the binding of HIV-1 RT to various
   non-nucleoside reverse transcriptase inhibitors (NNRTIs) with different
   activities, i.e., nevirapine, delavirdine, efavirenz, dapivirine,
   etravirine, and rilpivirine. H-1-C-13 heteronuclear single-quantum
   coherence (HSQC) spectral data of HIV-1 RT, in which the methionine
   methyl groups of the p66 subunit were selectively labeled with C-13,
   were collected in the presence and absence of these NNRTIs. We found
   that the methyl C-13 chemical shifts of the M230 resonance of HIV-1 RT
   bound to these drugs exhibited a high correlation with their anti-HIV-1
   RT activities. This methionine residue is located in proximity to the
   NNRTI-binding pocket but not directly involved in drug interactions and
   serves as a conformational probe, indicating that the open conformation
   of HIV-1 RT was more populated with NNRTIs with higher inhibitory
   activities. Thus, the NMR approach offers a useful tool to screen for
   novel NNRTIs in developing anti-HIV drugs.},
