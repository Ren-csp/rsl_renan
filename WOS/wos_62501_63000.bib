@article{ WOS:000588318500001,
Author = {Wilson, Robert J. and Fox, Richard},
Title = {Insect responses to global change offer signposts for biodiversity and
   conservation},
Journal = {ECOLOGICAL ENTOMOLOGY},
Year = {2021},
