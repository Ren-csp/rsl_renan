Title = {Evaporative cooling over the Tibetan Plateau induced by vegetation
   growth},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2015},
Volume = {112},
