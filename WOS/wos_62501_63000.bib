   Trona, Federica; Anfora, Gianfranco, Fdn E Mach, IASMA Res \& Innovat Ctr, I-38010 S Michele A A, TN, Italy.
   Trona, Federica; Bengtsson, Marie; Witzgall, Peter; Ignell, Rickard, SLU, Chem Ecol Grp, S-23053 Alnarp, Sweden.},
DOI = {10.1242/jeb.047365},
ISSN = {0022-0949},
EISSN = {1477-9145},
Keywords = {Lepidoptera; olfaction; intracellular recording; glomeruli; blend
   interaction; synergism},
