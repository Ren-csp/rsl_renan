@article{ WOS:001842596400001,
Author = {Lemence, Allen Lemuel G. and Cravioto, Jordi C. and McLellan, Benjamin
   C.},
Title = {Embedding social sustainability into practice: Institutional insights
   for off-grid rural electrification in the Philippines},
Journal = {ENERGY RESEARCH \& SOCIAL SCIENCE},
Year = {2026},
Volume = {139},
Month = {SEP},
Abstract = {Expanding electricity access remains a pressing challenge for many
   developing countries. Off-grid electrification systems are fundamental
   solutions, but their long-term sustainability depends not only on
   technical, environmental, and economic factors, but also on social
   sustainability considerations. While the social benefits of
   electrification are widely acknowledged, there is limited empirical
   evidence on how national-level stakeholders perceive and prioritize
   social aspects within energy access initiatives. Using document
   analysis, semi-structured interviews, and a follow-up questionnaire with
   representatives from key government agencies, this research investigates
   how national-level institutions understand, prioritize, and seek to
   integrate social sustainability within current off-grid rural
   electrification processes in the Philippines. Supplementary insights
   were also gathered from non-government stakeholders. Findings, which
   reflect institutional perceptions, reveal that challenges in integration
   stem from unclear mandates, possible misalignments in institutional
   responsibilities, and limited awareness. Stakeholders identified
   affordable energy access, local economic growth, education, health, and
   safety as priority social considerations. The study proposes operational
   social sustainability aspects and illustrative indicators for potential
   integration into policy and practice. The indicators, which account for
   improvements in livelihood conditions, educational outcomes, and health
   and safety, are introduced to the three key stages of the
   electrification process: identification of off-grid areas, evaluation of
   electrification solutions, and post-implementation monitoring and
   evaluation. By providing policy-relevant empirical insights, the study
   contributes to the development of context-specific approaches to
   integrating social sustainability in off-grid electrification, while
   also offering a foundation for future assessment frameworks and broader
   comparative studies.},
