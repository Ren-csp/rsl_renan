@article{ WOS:001711048800001,
Author = {Booth, Pamela L. and Kaine, Geoff and Stahlmann-Brown, Philip},
Title = {The role of trust in obtaining and following advice in farming},
Journal = {JOURNAL OF RURAL STUDIES},
Year = {2026},
Volume = {124},
Month = {MAY},
Abstract = {Globally, the agricultural sector faces a complex array of familiar and
   emerging challenges that affect the profitability, environmental
   sustainability and suitability of farming activities. To respond and
   adapt to these challenges, a farmer can either rely on their current
   stock of knowledge or seek new advice from external sources to underpin
   new production changes. An extensive body of literature suggests trust
   is pivotal to a farmer's decision on curation and adoption of advice.
   Yet, empirical exploration of trust production and the influence of
   trust on advice-seeking and advice-following behaviours of farmers
   remains limited. Using a large-scale survey from New Zealand, we connect
   types of trust production to the influence of trust on advice-seeking
   and advicefollowing behaviours. We find that the degree of trust in a
   source has a greater impact on the likelihood of obtaining and following
   advice than farmers' risk preferences, demographics, or years of
   experience. Believing in a shared value system has a positive effect on
   the level of perceived trustworthiness in all sources apart from
   institutions. We also find that aversion to experimenting with new ideas
   somewhat mitigates the likelihood of obtaining advice but has no impact
   on likelihood of following that advice. By exploring the mechanisms of
   trust development in advice adoption, agricultural advisors can better
   target efforts to enhance farmers' perceptions of advisor
   trustworthiness and thereby improve the likelihood of farmers
   considering and adopting the advisors' advice.},
