@article{ WOS:000632466600001,
Author = {Rohwer, Yasha and Marris, Emma},
Title = {Ecosystem integrity is neither real nor valuable},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2021},
Volume = {3},
Number = {4, SI},
Month = {APR},
Abstract = {We argue that ``ecological integrity{''} is a bad fit as a value for
   conservation biology and restoration ecology. Both fields are organized
   around shared values, but it is important to be clear about the specific
   values and reasons motivating protection of or interventions in specific
   ecosystems. In practice, appeals to ecological integrity often fail to
   account for losses in value when ecosystems change. Ultimately, we do
   not believe ecosystems are the kinds of things that have integrity.
   Ecosystems are simply too dynamic in space and time, their complex
   interconnections, including coevolved relationships, ultimately fleeting
   at the geological scale. Any impression of ``wholeness{''} is an
   artifact of the brevity of human lives and the shallowness of our
   historical records. We believe ``ecological integrity{''} as it is
   currently used is typically a proxy for the values of diversity,
   complexity, and cultural connections with beloved ecosystem states. We
   should simply say what we mean and retire the concept of ``ecological
   integrity.{''}},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Rohwer, Y (Corresponding Author), Oregon Inst Technol, Dept Humanities \& Social Sci, Klamath Falls, OR 97601 USA.
   Rohwer, Yasha, Oregon Inst Technol, Dept Humanities \& Social Sci, Klamath Falls, OR 97601 USA.},
DOI = {10.1111/csp2.411},
