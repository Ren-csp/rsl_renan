@article{ WOS:000360813200014,
Author = {Laird, Lance D. and Barnes, Linda L. and Hunter-Adams, Jo and Cochran,
   Jennifer and Geltman, Paul L.},
Title = {Looking Islam in the Teeth: The Social Life of a Somali Toothbrush},
Journal = {MEDICAL ANTHROPOLOGY QUARTERLY},
Year = {2015},
Volume = {29},
Number = {3},
Pages = {334-356},
Month = {SEP},
Abstract = {The Arabic miswak (Somali, adayge) is a tooth-cleaning stick from the
   Salvadora persica plant. In this article, we trace the social life of a
   thing, examining meanings inscribed in the stick brush, drawing on
   interviews with 82 Somali refugees in Massachusetts and an analysis of
   local and transnational science and marketing. The miswak toothbrush
   symbolizes relationships to nature, homeland culture, global Islam,
   globalizing dental medicine, and the divine as it intersects with the
   lives of producers, marketers, distributors, and users, creating hybrid
   cultural forms in new contexts.},
