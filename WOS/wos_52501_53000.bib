@article{ WOS:001569371600001,
Author = {Ekse, Ellen Bjorge and Giskeodegard, Marte Fannelob and Sellberg,
   Charlott and Wahl, Aud Marit},
Title = {Zooming in and out: multidimensional coordination work through
   simulation-based training},
Journal = {STUDIES IN CONTINUING EDUCATION},
Year = {2025},
Month = {2025 SEP 2},
Abstract = {In every professional domain, newcomers must master a blend of technical
   and social skills to perform tasks effectively, gain acceptance, and
   develop the competence expected within their field. To cultivate
   students into professionals, simulation-based training has emerged as a
   vital pedagogical approach in professional education, offering
   deliberately context-sensitive instruction within relevant technical and
   social scenarios. This article explores coordination work in
   interactional detail by examining how students assume future
   professional roles and establish role relationships with relevant human
   and nonhuman participants. We ask: How does the social and material
   organisation of simulation-based exercises contribute to training
   multiple dimensions of coordination with relevant others during complex
   operations? To address this question, we collected video recordings from
   complex, real-time maritime simulation training in three bachelor's
   programmes at universities in Norway and Sweden. To analyse our data, we
   used practice-based, sociomaterial theories and Nicolini's metaphor of
   zooming in and out of practice to shed light on the intricate and
   relational interplay that unfolds during training scenarios, emphasising
   coordination work as multidimensional in nature. These insights
   contribute to understanding how students learn the relational aspects of
   coordination through simulation-based training by engaging in the
   meaningful production and reproduction of professional practices.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
