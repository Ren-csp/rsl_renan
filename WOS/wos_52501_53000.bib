@article{ WOS:000772173000008,
Author = {Wang, Guosong and Zha, Zhenghui and Huang, Pengfei and Sun, Hui and
   Huang, Yang and He, Maozhou and Chen, Tian and Lin, Lina and Chen,
   Zhenqin and Kong, Zhibo and Que, Yuqiong and Li, Tingting and Gu, Ying
   and Yu, Hai and Zhang, Jun and Zheng, Qingbing and Chen, Yixin and Li,
   Shaowei and Xia, Ningshao},
Title = {Structures of pseudorabies virus capsids},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {MAR 22},
Abstract = {Pseudorabies virus (PRV) is a major etiological agent of swine
   infectious diseases responsible for significant economic losses in the
   swine industry. The authors report the structures of the PRV A-capsid
   and C-capsid, shedding light on PRV's assembly mechanism.
   Pseudorabies virus (PRV) is a major etiological agent of swine
   infectious diseases and is responsible for significant economic losses
   in the swine industry. Recent data points to human viral encephalitis
   caused by PRV infection, suggesting that PRV may be able to overcome the
   species barrier to infect humans. To date, there is no available
   therapeutic for PRV infection. Here, we report the near-atomic
   structures of the PRV A-capsid and C-capsid, and illustrate the
   interaction that occurs between these subunits. We show that the
   C-capsid portal complex is decorated with capsid-associated tegument
   complexes. The PRV capsid structure is highly reminiscent of other
   alpha-herpesviruses, with some additional structural features of beta-
   and gamma-herpesviruses. These results illustrate the structure of the
   PRV capsid and elucidate the underlying assembly mechanism at the
   molecular level. This knowledge may be useful for the development of
   oncolytic agents or specific therapeutics against this arm of the
   herpesvirus family.},
