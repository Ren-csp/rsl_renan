@article{ WOS:000272643700003,
Author = {Holmes, Ann M. and Lindsey, Greg and Qiu, Chenchen},
Title = {Ambient Air Conditions and Variation in Urban Trail Use},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
Year = {2009},
Volume = {86},
Number = {6},
Pages = {839-849},
Month = {NOV},
Abstract = {This study examines the effect of air quality and administrative
   policies on use of urban trails in Indianapolis, IN. Attention is
   focused on two policy variables: (1) issuance of air pollution
   advisories and (2) the adoption of Daylight Savings Time. Results
   suggest that while trail use varies with air quality, current public
   advisories regarding air pollution may be of limited effectiveness in
   reducing trail users' exposures to hazardous pollutants. In contrast,
   the adoption of Daylight Savings Time was associated with a
   statistically significant increase in traffic levels.},
