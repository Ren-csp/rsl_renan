@article{ WOS:001812469300001,
Author = {Yubero-Martinez, Miguel and Fesharaki, Omid},
Title = {Analysis of pre-service teachers' perception of the zoo as an
   educational space},
Journal = {REVISTA EUREKA SOBRE ENSENANZA Y DIVULGACION DE LAS CIENCIAS},
Year = {2026},
Volume = {23},
Number = {2},
Month = {JUN},
Abstract = {This paper analyzes preservice teachers' perceptions of the zoo as an
   educational space, evaluating the impact of three conditions: a visit to
   the Zoo Aquarium of Madrid, a replica of this visit at the Faculty of
   Education of the Complutense University of Madrid with the same zoo
   educator, and a control group without intervention. A quasi-experimental
   design was applied with pretest and posttest measures, independent
   groups, and purposive sampling, using a Likert-type scale validated by
   experts (alpha = 0.946), which covered four dimensions: content,
   competencies, attitudes, and a miscellany of items. The results show
   that both the visit to the zoo and its replica at the faculty
   significantly improved preservice teachers' perceptions, especially
   regarding the learning of wildlife content and environmental
   competencies. The zoo group also improved in conservationist attitudes,
   although, unlike the faculty group, the only attitude of reluctance to
   go with the student persisted, despite the improvement in their overall
   perception. Compared to the control group, both experimental groups
   showed significantly more positive perceptions about the learning of
   content and attitudes related to wildlife. There were no significant
   differences based on the teacher's high school diploma. It is concluded
   that participating in educational activities at the zoo can improve
   teachers' perceptions of the zoo. The willingness to go with students to
   the zoo was always positive, with 94\% (faculty), 87.5\% (zoo) and 56\%
   (control), respectively.},
