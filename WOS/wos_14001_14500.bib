@article{ WOS:001796281700002,
Author = {Rachmawati, Rini and Haryono, Eko and Lovett, Jon C. and Boquet, Yves
   and Sekaranom, Andung Bayu and Rohmah, Amandita Ainur and Haris, Nurina
   Aulia and Wibisono, Hafidz and Sari, Vanisa Anggreta and Hidayat, Fauzan
