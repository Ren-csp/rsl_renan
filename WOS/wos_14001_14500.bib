@article{ WOS:001587896100001,
Author = {Wen, Liping and Li, Xianmei and Liu, Guoyong and Song, Yulan},
Title = {Impact Mechanism of Environmental Regulations on Farmers' Waste Farm
   Polyethylene Film Recycling Behavior},
