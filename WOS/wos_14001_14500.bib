@article{ WOS:000588733400005,
Author = {Taroppio, Daniel},
Title = {PRIMORDIAL PSYCHOTHERAPY AN INTEGRAL APPROACH TO THE INDIVIDUAL AND
   GROUP THERAPEUTIC PROCESS},
Journal = {REVISTA DE PSICOTERAPIA},
Year = {2020},
Volume = {31},
Number = {117},
Pages = {85-103},
Month = {NOV},
Abstract = {Primordial Psychotherapy is the practical application of the Primordial
   Interactions Model, a humanistic-existential-integral view of human
   nature, focused on the relevance of interpersonal relationships in the
   health and full development of each individual and groups of people.
   This article seeks to show the importance of an integral approach and of
   basic anthropology in the design and application of therapeutic
   methodologies suitable for both individual and group processes.
   It provides a model which systematically integrates body, energetic and
   linguistic-cognitive work together with a meditation method free from
   religious content.},
