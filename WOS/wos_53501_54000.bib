@article{ WOS:001068217000020,
Author = {Huang, Yuying and Zhu, Lin and Cheng, Shipeng and Dai, Ranran and Huang,
   Chunrong and Song, Yanyan and Peng, Bo and Li, Xuezhen and Wen, Jing and
   Gong, Yi and Hu, Yunqian and Qian, Ling and Zhu, Linyun and Zhang,
   Fengying and Yu, Li and Yi, Chunyan and Gu, Wangpeng and Ling, Zhiyang
