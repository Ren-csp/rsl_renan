@article{ WOS:000739283800004,
Author = {Castellucci, Gregg A. and Kovach, Christopher K. and Howard, III,
   Matthew A. and Greenlee, Jeremy D. W. and Long, Michael A.},
Title = {A speech planning network for interactive language use},
Journal = {NATURE},
Year = {2022},
