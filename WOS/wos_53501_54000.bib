   Shirani, Zahra; Carrasco-Navarro, Victor; Sorvari, Jouni, Univ Eastern Finland, Dept Environm \& Biol Sci, POB 1627, FI-70211 Kuopio, Finland.
   Sorvari, Jouni, Nat Resources Inst Finland Luke, Latokartanonkaari 9, FI-00790 Helsinki, Finland.},
DOI = {10.1007/s11270-025-08526-6},
Article-Number = {872},
ISSN = {0049-6979},
EISSN = {1573-2932},
Keywords = {Biochar modification; Water treatment; Ciprofloxacin; Tetracycline;
