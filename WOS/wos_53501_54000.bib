@article{ WOS:001822500100014,
Author = {Oliveira, Angelita Antonia Santos and Pereira, Leila Aparecida de Melo
   and Lima, Erika Rossana Passos de Oliveira and Ribeiro, Aline Saraiva},
Title = {Teaching and learning from the perspectives of Piaget, Vygotsky, and
   Paulo Freire},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {115},
Month = {JUL},
Abstract = {This study aims to analyze the contributions of the theories of Jean
   Piaget, Lev Vygotsky, and Paulo Freire to the understanding of teaching
   and learning processes, highlighting their implications for contemporary
   pedagogical practices. It is an integrative literature review with a
   qualitative approach and descriptive nature, developed through the
   search and analysis of scientific articles published between 2020 and
   2024 in the Scientific Electronic Library Online (SciELO), Scopus,
   Directory of Open Access Journals (DOAJ), and Google Scholar databases.
   The PICO strategy was used to assist in formulating the research's
   guiding question, employing descriptors related to teaching, learning,
   Piaget, Vygotsky, and Paulo Freire, combined using Boolean operators.
   The selected studies underwent qualitative analysis, considering their
   objectives, methods, and main contributions to the educational field.
   The results showed that Piaget contributes to understanding learning as
   an active process of knowledge construction; Vygotsky highlights the
   importance of social interaction, language, and mediation in human
   development; and Paulo Freire emphasizes dialogue, autonomy, and the
   critical development of individuals. It was found that integrating these
   theoretical perspectives fosters the creation of more participatory,
   inclusive, and contextualized pedagogical practices, in which the
   student takes a leading role in the educational process. The study
   concludes that the contributions of these authors remain relevant to
   contemporary education, offering theoretical foundations for developing
   teaching methodologies aimed at meaningful learning and the holistic
   development of students.},
