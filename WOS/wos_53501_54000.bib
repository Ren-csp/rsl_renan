   Ruckelshaus, Mary and Wang, Lijuan and Xiao, Yi and Gao, Xiaolong and
   Li, Cong and Daily, Gretchen C.},
Title = {Gross ecosystem product (GEP): Quantifying nature for environmental and
   economic policy innovation},
Journal = {AMBIO},
Year = {2023},
