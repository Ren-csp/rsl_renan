@article{ WOS:001714886700001,
Author = {Gibney, Alex and Sidarta, Margareth and Delahunt, Eva and Mesdom, Pierre
   and Arrue, Lily and Sriram, K. K. and Aning, Obed Akwasi and Hjerpe,
   Hedvig and Figueiredo, Francisca and Cariou, Kevin and McKee, Vickie and
   Johansson, Pegah and Bhattacharya, Shayon and Thompson, Damien and
   Wenzel, Michaela and Gasser, Gilles and Westerlund, Fredrik and Kellett,
   Andrew},
Title = {Expanding the DNA damaging potential of artificial metallo-nucleases
   with click chemistry},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {FEB 3},
Abstract = {Recently, copper(I)-catalysed azide-alkyne cycloaddition (CuAAC) click
   chemistry has emerged as a promising approach for designing new
   artificial metallo-nucleases (AMNs) with DNA-damaging properties. By
   functionalising a central organic azide with three alkyne donors,
   Tri-Click (TC) ligands capable of chelating three copper ions through
   the donor group and triazole linker can be generated. However, the
   versatility of this approach along with the influence of specific donors
   on metal binding, DNA recognition, and cellular DNA damage in an
   anticancer context remains poorly understood. Here, we prepare a series
   of Tri-Click ligands incorporating systematic cyclic and acyclic N-, O-,
   and S-donors and evaluate their AMN activities. Screening experiments
   pinpoint planar N-donor ligands as high value agents. Among these, the
   copper complex of Tri-Click-Pyridine (Cu3-TC-Py) displays significant
   potential. We characterise its activity using single-molecule imaging,
   microscale thermophoresis, FRET-based binding assays, molecular
   dynamics, and intracellular DNA interaction studies in human and
   functional bacterial cells. We report the emergence of Cu3-TC-Py as a
   lead AMN with high reactivity for DNA damage applications central to
   anticancer therapy.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Kellett, A (Corresponding Author), Dublin City Univ, Res Ireland Ctr Pharmaceut, Sch Chem Sci, Dublin, Ireland.
