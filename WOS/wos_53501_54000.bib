@article{ WOS:001868310100002,
Author = {Henrykowska, Gabriela and Zielinski, Ewa and Siermontowski, Piotr and
   Keczkowska, Justyna},
Title = {The Impact of Selected Adapted Sports on the Quality of Life of People
   with Physical Disabilities: A Comparative Analysis of Diving and
   Wheelchair Rugby},
Journal = {POLISH HYPERBARIC RESEARCH},
Year = {2025},
Volume = {91},
Number = {2},
Pages = {33-44},
Month = {JUN 1},
Abstract = {Adaptive sport is a recognized tool for improving the quality of life
   (QoL) of people with physical disabilities. However, the existing
   literature rarely delves into diverse impact of specific disciplines.
   The purpose of this study was to conduct a quantitative comparative
   assessment of quality of life of four groups of people with physical
   disabilities: scuba divers (G1), wheelchair rugby players (G2), those
   active in other sports (G3), and a physically inactive group (G4). The
   cross-sectional study involved 134 wheelchair users. The WHOQOL-BREF
   questionnaire was used to assess the quality of life. Statistically
   significant differences were found between the groups in the domains
   such as social relationships (p=0.012), environmental (p=0.009) and
   physical health (p=0.048). The scuba diving group (G1) scored highest in
   all domains, rating their quality of life in the environmental domain
   significantly higher than group G3 (p=0.005). Group G3 ({''}other
   sports{''}) rated the domain of social relationships significantly
   higher than wheelchair rugby players (G2) (p=0.007). The type of sport
   practiced is a significant factor that differentiates the impact in
   various aspects of the quality of life. Scuba diving, due to the unique
   properties of the aquatic environment, may offer exceptional
   psychophysiological benefits. In contrast, the confrontational nature of
   rugby, despite the advantages of teamwork, may influence the perception
   of social relationships differently.},
Publisher = {Paradigm Publishing Services-De Gruyter Brill Sp Zoo},
Address = {ul Nowogrodzka 4/3, Warsaw, POLAND},
