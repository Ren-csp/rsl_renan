@article{ WOS:001187299700005,
Author = {Wu, Yige and Terekhanova, Nadezhda V. and Caravan, Wagma and Al Deen,
   Nataly Naser and Lal, Preet and Chen, Siqi and Mo, Chia-Kuei and Cao,
   Song and Li, Yize and Karpova, Alla and Liu, Ruiyang and Zhao, Yanyan
   and Shinkle, Andrew and Strunilin, Ilya and Weimholt, Cody and Sato,
   Kazuhito and Yao, Lijun and Serasanambati, Mamatha and Yang, Xiaolu and
   Wyczalkowski, Matthew and Zhu, Houxiang and Zhou, Daniel Cui and
   Jayasinghe, Reyka G. and Mendez, Daniel and Wendl, Michael C. and Clark,
   David and Newton, Chelsea and Ruan, Yijun and Reimers, Melissa A. and
   Pachynski, Russell K. and Kinsinger, Chris and Jewell, Scott and Chan,
   Daniel W. and Zhang, Hui and Chaudhuri, Aadel A. and Chheda, Milan G.
   and Humphreys, Benjamin D. and Mesri, Mehdi and Rodriguez, Henry and
   Hsieh, James J. and Ding, Li and Chen, Feng},
Title = {Epigenetic and transcriptomic characterization reveals progression
   markers and essential pathways in clear cell renal cell carcinoma},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {MAR 27},
Abstract = {Identifying tumor-cell-specific markers and elucidating their epigenetic
   regulation and spatial heterogeneity provides mechanistic insights into
   cancer etiology. Here, we perform snRNA-seq and snATAC-seq in 34 and 28
   human clear cell renal cell carcinoma (ccRCC) specimens, respectively,
   with matched bulk proteogenomics data. By identifying 20
   tumor-specificmarkers througha multi-omics tiered approach, we reveal an
   association between higher ceruloplasmin (CP) expression and reduced
   survival. CP knockdown, combined with spatial transcriptomics, suggests
   a role for CP in regulating hyalinized stroma and tumor-stroma
   interactions in ccRCC. Intratumoral heterogeneity analysis portrays
   tumor cell-intrinsic inflammation and epithelialmesenchymal transition
   (EMT) as two distinguishing features of tumor subpopulations. Finally,
   BAP1 mutations are associated with widespread reduction of chromatin
   accessibility, while PBRM1 mutations generally increase accessibility,
   with the former affecting five times more accessible peaks than the
   latter. These integrated analyses reveal the cellular architecture of
   ccRCC, providing insights into key markers and pathways in ccRCC
   tumorigenesis.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Ding, L; Chen, F (Corresponding Author), Washington Univ, Div Oncol, Dept Med, St Louis, MO 63110 USA.
   Ding, L; Chen, F (Corresponding Author), Washington Univ, McDonnell Genome Inst, St Louis, MO 63108 USA.
