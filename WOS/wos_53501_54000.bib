@article{ WOS:000342316500004,
Author = {Demeritt, David and Nobert, Sebastien},
Title = {Models of best practice in flood risk communication and management},
Journal = {ENVIRONMENTAL HAZARDS-HUMAN AND POLICY DIMENSIONS},
Year = {2014},
Volume = {13},
Number = {4},
Pages = {313-328},
Abstract = {Risk communication plays an increasingly central role in flood risk
   management, but there is a variety of conflicting advice about what does
   - and should - get transmitted, why, how, and to whom. The aim of this
   paper is to elucidate the underlying normative and conceptual models on
   which those competing assessments of `good' risk communication depend.
   To that end, the paper identifies four broad models, or approaches, to
   risk communication: a risk message model of information transfer; a risk
   instrument model of behavioural change; a risk dialogue model of
   participatory deliberation; and a risk government model of
   self-regulation and normalization. These models differ in their
   theoretical and disciplinary origins and associated philosophical and
   political commitments, and consequently they define the basic purpose,
   practice, and future prospects of flood risk communication in quite
   different ways. Unless these different models of `good' risk
   communication are acknowledged and understood, efforts to identify best
   practice for flood risk management are likely to produce inconsistent,
   if not contradictory, recommendations.},
