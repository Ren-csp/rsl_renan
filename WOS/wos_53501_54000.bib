@article{ WOS:001369778000010,
Author = {Lin, Hsin-Hsien and Yu, I-Shing and Cheng, Ming-Shan and Chang,
   Tien-Jyun and Lin, Hsin-Ying and Chang, Yi-Cheng and Ko, Chun-Jung and
