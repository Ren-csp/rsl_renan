@article{ WOS:000415246500001,
Author = {Driscu, Mihai Corneliu and Tudora, Gabriel and Tudora, Ana Cristina},
Title = {Challenging Architecture as We Grow Older},
Journal = {POSTMODERN OPENINGS},
Year = {2017},
