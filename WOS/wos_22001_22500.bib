@article{ WOS:000743420600001,
Author = {D'Ascenzo, Fabrizio and Rocchi, Andrea and Cerioni, Stefano and
   Zarlenga, Gaetano and Passeri, Nicolo and Piacentini, Francesco and Lo
   Fazio, Cristina and Gerardis, Cristina and Cicatiello, Clara},
Title = {Conveying environmental information to fishers: a smartphone application
   on marine protected areas},
