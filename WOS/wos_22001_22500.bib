@article{ WOS:000854793300001,
Author = {Lou, Loretta Ieng Tak},
Title = {The art of unnoticing Risk perception and contrived ignorance in China},
Journal = {AMERICAN ETHNOLOGIST},
Year = {2022},
Volume = {49},
Number = {4},
Pages = {580-594},
Month = {NOV},
Abstract = {In China many petrochemical plants are adjacent to residential areas.
   Despite this, the people who live in these areas appear indifferent to
   the threat of toxic pollution and chemical explosions, even though they
   are aware of the danger. Building on historical and social studies of
   ignorance, I show how residents in a southern Chinese city live with the
   threat of petrochemicals by practicing what I call the ``art of
   unnoticing,{''} a contrived form of ignorance that enables them to live
   with the reality of pollution and reclaim their agency in face of the
   unavoidable. In light of this, I reflect on the limit and complexity of
   the global environmental justice when willful ignorance is at work. The
   next step forward is to understand what it is that people are
   unnoticing, as well as what unnoticing can do to people's lifeworlds.
   {[}ignorance, toxicity, chemicals, risk perception, industrial
   pollution, fenceline communities, environmental justice, fatalism,
   China]},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
