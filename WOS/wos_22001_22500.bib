@article{ WOS:001469882600001,
Author = {Gajdek, Agata and Ortyl, Bernadetta and Martyka, Anna and Kasprzyk,
   Idalia},
Title = {Why don't children study outside? Limitation of Polish schools to use
   green spaces in the educational process before and during COVID-19},
Journal = {CITIES},
Year = {2025},
Volume = {162},
Month = {JUL},
Abstract = {This study evaluates the accessibility and utilisation of green spaces
   in Polish primary schools, focusing on the impact of the COVID-19
   pandemic. Using online surveys and GIS spatial analysis, we investigated
   access to natural environments for schoolchildren and the quality of
   these green spaces. We used a vegetation index and topographic databases
   to assess the green areas around schools. Results show that above 91 \%
   of surveyed schools provide access to natural spaces, but the frequency
   and quality of children's interaction with these areas is insufficient.
   The study identifies physical, personal, and institutional barriers
   limiting the effective use of these spaces in school activities. The
   pandemic increased the use of school greenery but did not significantly
   change the use of greenery within a 0.8 km radius of the school plot. A
   case study in Rzeszo<acute accent>w highlights disparities in land
   availability and utilisation between urban and rural schools, revealing
   educational environment contrasts. Our findings emphasise the need for a
   spatial policy that integrates accessible and attractive green spaces in
   and around school plots, essential for fostering children's interaction
   with nature. Although focused on Polish schools, the findings have
   global relevance, offering practical tools for managing school green
   spaces and guiding future research.},
