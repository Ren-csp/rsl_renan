@article{ WOS:001502807200001,
Author = {Dalla Fontana, Michele},
Title = {Unpacking opposition to planned relocation: insight from Pedrinhas and
   Cedovém, Portugal},
Journal = {REGIONAL ENVIRONMENTAL CHANGE},
Year = {2025},
Volume = {25},
Number = {3},
Month = {JUN 5},
Abstract = {Planned relocation as a climate adaptation strategy can encounter
   resistance from affected communities, even when environmental risks are
   evident. This study examines the case of Pedrinhas and Cedov \&
   eacute;m, two coastal settlements in Portugal affected by severe coastal
   erosion and subject to a relocation plan proposed by governmental
   authorities. In this article, I apply qualitative methods to explore the
   underlying factors shaping opposition to relocation. Findings reveal
   that resistance does not emerge from a single factor but from a complex
   interplay of emotional, social, and structural elements. While place
   attachment plays a crucial role, diverging risk perceptions further
   compound disagreement. Local knowledge and lived experiences lead
   residents to downplay the severity of coastal erosion compared to
   official assessments. Trust in government institutions also proves
   pivotal, with historical inequities, prolonged uncertainty, and
   perceived unfairness fueling skepticism toward relocation initiatives.
   Additionally, demographic factors, particularly the aging population,
   contribute to reluctance, as older residents prioritize social ties and
   familiarity over perceived long-term risks. These findings highlight the
   need for more inclusive and transparent decision-making processes that
   acknowledge community-specific vulnerabilities and perspectives. This
   study contributes to a more nuanced understanding of resistance to
   planned relocation and offers insights for designing more equitable and
   effective planned relocation strategies.},
