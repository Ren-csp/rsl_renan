Author-Email = {sandholz@ehs.unu.edu},
ResearcherID-Numbers = {/AFL-4819-2022
   },
ORCID-Numbers = {Urrutia, Manuel/0000-0001-6455-5935},
Funding-Acknowledgement = {International Climate Initiative (IKI)},
Funding-Text = {We sincerely thank our colleagues from the communications team, in
   particular Arianna Flores Corral and Austin Gonzales who which were
   decisive in design and implementation of the photo competition and
