@article{ WOS:000554647900001,
Author = {Dominguez-Munoz, Francisco Javier and Hernandez-Mocholi, Miguel Angel
   and Villafaina, Santos and Garcia-Gordillo, Miguel Angel and
   Collado-Mateo, Daniel and Gusi, Narcis and Adsuar, Jose Carmelo},
Title = {Acute Effects of a Whole Body Vibration Session on the Vibration
   Perception Threshold in Patients with Type 2 Diabetes Mellitus},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {12},
Month = {JUN},
Abstract = {Background: Type 2 Diabetes Mellitus (T2DM) is a chronic disease that
   affects millions of people, and according to the International Diabetes
   Federation, 46.5\% of people have undiagnosed diabetes. One of the most
   common complications of diabetes mellitus is loss of peripheral
   sensation. Whole Body Vibration (WBV) is a therapy, and it would be
   interesting to know if it can be considered as a training method to
   improve the Vibration Perception Threshold (VPT). The aim of the study
   is to verify whether there are really acute effects on the VPT after a
   WBV training session in people with T2DM. Methods: Ninety people with
   T2DM (56 men and 34 women) were randomly allocated to two groups: the
   WBV group and the placebo group. The ninety subjects went through a VPT
   training test before receiving the assigned intervention, and they
   performed the VPT test using the Vibratron II device. Results: After one
   session of WBV, an increase of the VPT in the WBV group was found, with
   respect to the placebo group. Conclusions: Vibration perception
   threshold is increased after a WBV training session in people with T2DM,
   compared to a placebo group.},
