Title = {Factors Associated with the Perception of Risk and Knowledge of
   Contracting the SARS-Cov-2 among Adults in Bangladesh: Analysis of
   Online Surveys},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
