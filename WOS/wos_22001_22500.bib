@article{ WOS:000694220100001,
Author = {Wang, Xin and Lai, Ivan Ka Wai and Zhou, Quan and Pang, Yu He},
Title = {Regional Travel as an Alternative Form of Tourism during the COVID-19
   Pandemic: Impacts of a Low-Risk Perception and Perceived Benefits},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {17},
Month = {SEP},
Abstract = {Previous COVID-19 tourism research has not considered the positive
   impact of a low-risk perception and a perception of the benefits of
   regional travel on taking alternative tourism. This study attempts to
   fill the research gap and examine the positive effect of these
   perceptions on tourists' attitudes to regional travel and intentions to
   undertake regional travel during the COVID-19 pandemic. A survey of 278
   respondents confirmed that the perceived benefit positively influences
   tourists' attitudes and travel intentions, but that a low-risk
   perception only positively affects their attitudes. This study
   contributes to tourism risk management research by introducing the
   concept of a low-risk perception as a positive factor. For tourism
   recovery, it finds that relaxation, value, and convenience are benefits
   to drive people to travel.},
