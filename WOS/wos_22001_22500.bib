@article{ WOS:001540284600001,
Author = {Gao, Xiang and Hu, Yue and Zhang, Zixuan and Jiao, Youquan and Ji, Wenxu
   and Qian, Yue and He, Ye and Pei, Ling and Yin, Yuwen and Hu, Yujing and
   Shi, Xuerui},
Title = {Analysis of the spatiotemporal evolution of cultivated land in the
   Chaohu Basin based on the PLUS model and multi-scenario simulation},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {The research examined the spatiotemporal dynamic evolution characters
   and driving factors of cultivated land in the Chaohu Lake Basin, China,
   and predicted its future change status to support the management and use
   of cultivated land resources and to promote dynamic equilibrium. The
   study utilised land use statistical data from the Chaohu Lake Basin from
   2000 to 2020. The spatiotemporal dynamic changes and driving factors of
   cultivated land in the Chaohu Lake Basin were analysed using landscape
   pattern analysis and land use conversion matrix, and the PLUS model was
   used to predict the different scenarios of cultivated land changes. The
   study found that from 2000 to 2020, the cultivated land area in the
   Chaohu Lake Basin decreased by 683.95 km2, with a proportion decrease of
   4.9 \%, and construction land area increased by 520.85 km2. Cultivated
   land fragmentation intensified between 2010 and 2020, primarily
   influenced by human activities, including population, roads, water
   bodies, temperature, and precipitation. By 2030, projected arable land
   changes exhibited significant variation across scenarios. Relative to
   the 2020 baseline, the Natural Development Scenario demonstrated a
   reduction in cultivated land area from 8784.22 km2 to 8540.68 km2, with
   primary conversions occurring to urban construction zones and green
   spaces. The Urban Development Scenario showed substantial replacement of
   cultivated land by construction areas, recording a net decrease of 343
   km2 in agricultural land accompanied by a 309 km2 expansion of built-up
   areas. In contrast, the Cultivated Land Protection Scenario yielded a
   322 km2 increase in arable land area, confirming the effectiveness of
   implemented protection measures. As urbanization increases, the
   cultivated land area will decrease, and conflict between humans and land
   use will intensify. To ensure the sustained utilisation of cultivated
   land for development, the government needs to strictly control the
   increment of construction land and rationally utilize and protect
   cultivated land resources.},
