@article{ WOS:001835256800001,
Author = {Fernandez-Gomez, Eva and Vila, Miguel Gamon and Blancato, Giuliano and
   Roca-Perez, Luis and Andreu, Oscar and Rodriguez-Martin, Jose Antonio
   and Boluda, Rafael},
Title = {Source patterns and contamination level of PCBs and PAHs in soils and
   plants of agricultural, urban and industrial areas in the region of
   Valencia (Eastern Spain)},
Journal = {JOURNAL OF HAZARDOUS MATERIALS ADVANCES},
Year = {2026},
Volume = {23},
Month = {AUG},
Abstract = {Soil and plant pollution from polychlorinated biphenyls (PCBs) and
   polycyclic aromatic hydrocarbons (PAHs) is a pressing environmental
   issue. A groundbreaking study in Valencia, Eastern Spain, investigated
   this problem by analyzing 59 topsoil (0-20 cm) and 77 plant samples from
   agricultural, urban, and industrial areas. Sampling sites were chosen
   based on population density and urban-industrial activity. The QuEChERS
   extraction method and GC-MS/MS were used for analysis. PCBs were nearly
   undetectable, with only one industrial soil sample showing traces.
   However, PAHs were widespread, with total concentrations (Sigma 13PAHs)
   in soils ranging from 5.1 to 506.3 mu g kg-1. Urban parks had the
   highest levels, dominated by high-molecular-weight compounds,
   particularly 4-ring PAHs. Isomer ratio analysis, principal component
   analysis and cross-plot, pointed to pyrogenic sources, such as vehicle
   emissions and biomass burning. The spatial analysis based on kriging
   map, and the correlation obtained between Sigma 13PAHs, population
   density and vehicle density, showed four distribution areas according to
   the PAH concentration, indicating that densely populated areas had the
   highest PAH concentrations. In plants, low-molecular-weight PAHs were
   more common, with Sigma 13PAHs ranging from 20.0 to 151.5 mu g kg-1.
   Pinus halepensis in an industrial park showed the highest levels, while
   anthracene was detected on leaves in urban parks. Some agricultural
   soils exceeded Spain's regulatory limit of 20 mu g kg-1 for
   benzo(a)pyrene. The study highlights urban and industrial areas as
   pollution hotspots and emphasizes the ongoing threat of pyrogenic PAHs.
   This research provides valuable insights for addressing PAH
   contamination and protecting environmental health.},
