   Lou, Loretta Ieng Tak, Univ Durham, Dept Anthropol, Durham, England.},
DOI = {10.1111/amet.13099},
EarlyAccessDate = {SEP 2022},
ISSN = {0094-0496},
EISSN = {1548-1425},
Keywords-Plus = {INDUSTRIAL-POLLUTION; POLITICS; ETHNOGRAPHY; HEALTH},
