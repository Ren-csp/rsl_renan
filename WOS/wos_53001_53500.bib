@article{ WOS:001827026600001,
Author = {Lim, Heejoo and Kim, Hyeonjeong},
Title = {Psychological pathways to digital safety: A sequential model of
   attitudinal endorsement, environment cognition, and WTP for malicious
   comment prevention},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2027},
Volume = {186},
Month = {JAN},
Abstract = {Malicious comments (MCs) are a pervasive digital threat that is
   associated with substantial emotional costs for users. However,
   empirical research on how these affective burdens translate into
   protective economic behavior remains limited. This study addresses this
   gap by drawing on the complementary roles of the I-PACE model, the
   General Process Model (GPM), and Protection Motivation Theory (PMT) to
   investigate the sequential psychological pathways from MC exposure to
   willingness to pay (WTP). Using a nationwide survey of 1000 adults in
   South Korea, we adopt a two-stage analytical design combining Partial
   Least Squares Structural Equation Modeling (PLS-SEM) and a Contingent
   Valuation Method (CVM)-based Spike Model. Methodologically, we first
   estimate WTP using a CVM-based Spike Model and then incorporate the
   resulting individual-level WTP estimates as the behavioral-economic
   outcome in the SEM stage, without imposing cross-model estimation
   dependency. The findings suggest an emotion-first structure with dual
   affective pathways exerting opposing influences on threat appraisal.
   Emotional discomfort amplifies the perception of environmental toxicity,
   while attitudinal endorsement of MCs, including resonance with
   aggressors, systematically attenuates risk perception and protective
   commitment. This dual mechanism illustrates competing forces where
   visceral distress promotes protection, yet resonance with perpetrators
   leads users to legitimize digital violence, counteracting protective
   motivation even in toxic environments. The monthly economic value of
   digital safety is quantified at approximately 1,529 KRW, serving as a
   behavioral-economic indicator of perceived utility loss in toxic digital
   environments. These results advocate for safety by design and shared
   responsibility frameworks, urging platforms to integrate prevention
   services as core features.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
