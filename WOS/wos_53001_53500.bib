@article{ WOS:000480234600007,
Author = {Chen, Huimei and Moreno-Moral, Aida and Pesce, Francesco and
   Devapragash, Nithya and Mancini, Massimilano and Heng, Ee Ling and
   Rotival, Maxime and Srivastava, Prashant K. and Harmston, Nathan and
   Shkura, Kirill and Rackham, Owen J. L. and Yu, Wei-Ping and Sun, Xi-Ming
   and Tee, Nicole Gui Zhen and Tan, Elisabeth Li Sa and Barton, Paul J. R.
   and Felkin, Leanne E. and Lara-Pezzi, Enrique and Angelini, Gianni and
   Beltrami, Cristina and Pravenec, Michal and Schafer, Sebastian and
   Bottolo, Leonardo and Hubner, Norbert and Emanueli, Costanza and Cook,
   Stuart A. and Petretto, Enrico},
Title = {WWP2 regulates pathological cardiac fibrosis by modulating SMAD2
   signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {AUG 9},
Abstract = {Cardiac fibrosis is a final common pathology in inherited and acquired
   heart diseases that causes cardiac electrical and pump failure. Here, we
   use systems genetics to identify a pro-fibrotic gene network in the
   diseased heart and show that this network is regulated by the E3
   ubiquitin ligase WWP2, specifically by the WWP2-N terminal isoform.
   Importantly, the WWP2-regulated pro-fibrotic gene network is conserved
   across different cardiac diseases characterized by fibrosis: human and
   murine dilated cardiomyopathy and repaired tetralogy of Fallot.
   Transgenic mice lacking the N-terminal region of the WWP2 protein show
   improved cardiac function and reduced myocardial fibrosis in response to
   pressure overload or myocardial infarction. In primary cardiac
   fibroblasts, WWP2 positively regulates the expression of pro-fibrotic
   markers and extracellular matrix genes. TGF beta 1 stimulation promotes
   nuclear translocation of the WWP2 isoforms containing the N-terminal
   region and their interaction with SMAD2. WWP2 mediates the TGF beta
   1-induced nucleocytoplasmic shuttling and transcriptional activity of
   SMAD2.},
