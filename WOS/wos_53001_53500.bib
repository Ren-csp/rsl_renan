@article{ WOS:001784955700001,
Author = {Maleki, Zahra and Ranjbar, Saeedeh and Amoushahi, Solmaz and Saleh,
   Sajjad Karbalaei and Ferreira, Carla Sofia Santos and Malamiri, Hamid
   Reza Ghafarian},
Title = {Land surface dynamics and environmental impacts of anthropogenic
   activities in coastal protected ecosystems: a case study in northern
   Iran},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2026},
Volume = {93},
Month = {SEP},
Abstract = {Coastal ecosystems are increasingly threatened by anthropogenic
   pressures and climate change, resulting in significant environmental
   degradation worldwide. This study investigates the environmental impacts
   associated with land use and land cover changes in the Miankaleh coastal
   region of northern Iran, encompassing the protected Miankaleh wetland
   (1770.71 km2), and evaluates the role of key environmental drivers.
   Using Landsat imagery from 2013 to 2024, we applied the Improved Remote
   Sensing Ecological Index (IRSEI) to quantify spatial and temporal
   variations in eco-environmental quality. The IRSEI integrates Kernel
   Normalized Difference Vegetation Index (KNDVI), Land Surface Moisture
   (LSM), Normalized Differential Bare Soil Index (NDBSI), Land Surface
   Temperature (LST), and Normalized Difference Salinity Index (NDSI). To
   further explore the determinants of eco-environmental quality, the
   GeoDetector model was employed to assess the influence of Elevation,
   Precipitation, Relief, Slope, Air temperature and Wind speed. The
   results reveal a marked decline in eco-environmental quality across the
   study area, primarily driven by intensified human activities,
   particularly the expansion of built-up land. Among the the contributing
   indices, LST exerted the strongest influence, followed by NDBSI, NDSI,
   KNDVI, and LSM. Rising surface temperatures and reduced vegetation
   density indicate substantial loss of natural landscapes, while the
   contribution of NDBSI underscored the adverse effects of urbanization.
   Environmental factor analysis indicates that Elevation is the dominant
   driver, followed by Relief, Slope, Air temperature, Wind Speed and
   Precipitation. The prominence of elevation reflects reduced
   anthropogenic disturbance in high-altitude areas. Regions characterized
   by dense human activities consistently exhibit lower eco-environmental
   quality, underscoring the urgent need for targeted conservation
   measures. The persistence of strong relationships among IRSEI components
   over time suggests potential predictability of future environmental
   trends, offering valuable support for sustainable management strategies.
   Additionally, a strong correlation between the Miankaleh wetland extent
   and Caspian Sea level highlights the critical importance of sea-level
   dynamics in the conservation and restoration of this sensitive coastal
   ecosystem.},
