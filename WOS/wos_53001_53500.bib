@article{ WOS:000348742700014,
Author = {Takahashi, Hidehisa and Takigawa, Ichigaku and Watanabe, Masashi and
   Anwar, Delnur and Shibata, Mio and Tomomori-Sato, Chieri and Sato,
   Shigeo and Ranjan, Amol and Seidel, Chris W. and Tsukiyama, Tadasuke and
   Mizushima, Wataru and Hayashi, Masayasu and Ohkawa, Yasuyuki and
   Conaway, Joan W. and Conaway, Ronald C. and Hatakeyama, Shigetsugu},
Title = {MED26 regulates the transcription of snRNA genes through the recruitment
   of little elongation complex},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {JAN},
Abstract = {Regulation of transcription elongation by RNA polymerase II (Pol II) is
   a key regulatory step in gene transcription. Recently, the little
   elongation complex (LEC)-which contains the transcription elongation
   factor ELL/EAF-was found to be required for the transcription of Pol
   II-dependent small nuclear RNA (snRNA) genes. Here we show that the
   human Mediator subunit MED26 plays a role in the recruitment of LEC to a
   subset of snRNA genes through direct interaction of EAF and the
   N-terminal domain (NTD) of MED26. Loss of MED26 in cells decreases the
   occupancy of LEC at a subset of snRNA genes and results in a reduction
   in their transcription. Our results suggest that the MED26-NTD functions
   as a molecular switch in the exchange of TBP-associated factor 7 (TAF7)
   for LEC to facilitate the transition from initiation to elongation
   during transcription of a subset of snRNA genes.},
