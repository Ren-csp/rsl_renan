@article{ WOS:001523450300005,
Author = {Antfolk, Daniel and Ming, Qianqian and Manturova, Anna and Goebel, Erich
   J. and Thompson, Thomas B. and Luca, Vincent C.},
Title = {Molecular mechanism of Activin receptor inhibition by DLK1},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUL 1},
Abstract = {Delta-like non-canonical Notch ligand 1 (DLK1) influences myogenesis,
   adipogenesis, and other aspects of human development through a process
   that is largely attributed to the downregulation of Notch signaling.
   Here, we show that DLK1 does not bind to Notch receptors or affect
   ligand-mediated Notch activation, but instead engages the TGF-beta
   superfamily member Activin receptor type 2B (ACVR2B). The crystal
   structure of the DLK1-ACVR2B complex reveals that DLK1 mimics the
   binding mode of canonical TGF-beta ligands to compete for access to
   ACVR2B. In functional assays, DLK1 antagonizes Myostatin-ACVR2B
   signaling to promote myoblast differentiation, rationalizing a mechanism
   for the role of DLK1 in muscle development and regeneration. Crosstalk
   between Notch and TGF-beta is mediated by interactions between the
   transcriptional regulators SMAD2/3 and the Notch intracellular domain
   (NICD), and DLK1 inhibits SMAD2/3-NICD colocalization. These findings
   indicate that DLK1 acts directly on ACVR2B to inhibit signaling, whereas
   the observed effects on Notch may be an indirect result of DLK1
   interference with NICD-SMAD complex formation.},
