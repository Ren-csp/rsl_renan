@article{ WOS:001208035300009,
Author = {Mastrocinque, Francesco and Bullard, George and Alatis, James A. and
   Albro, Joseph A. and Nayak, Animesh and Williams, Nicholas X. and
   Kumbhar, Amar and Meikle, Hope and Widel, Zachary X. W. and Bai, Yusong
   and Harvey, Alexis K. and Atkin, Joanna M. and Waldeck, David H. and
   Franklin, Aaron D. and Therien, Michael J. and Rossky, Peter J.},
Title = {Band gap opening of metallic single- walled carbon nanotubes via
   noncovalent symmetry breaking},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2024},
Volume = {121},
Number = {12},
Month = {MAR 19},
Abstract = {Covalent bonding interactions determine the energy-momentum (E-k)
   dispersion (band structure) of solid - state materials. Here, we show
   that noncovalent interactions can modulate the E-k dispersion near the
   Fermi level of a low- dimensional nanoscale conductor. We demonstrate
   that low energy band gaps may be opened in metallic carbon nanotubes
   through polymer wrapping of the nanotube surface at fixed helical
   periodicity. Electronic spectral, chiro- optic, potentiometric,
   electronic device, and work function data corroborate that the magnitude
   of band gap opening depends on the nature of the polymer electronic
   structure. Polymer dewrapping reverses the conducting - to-
   semiconducting phase transition, restoring the native metallic carbon
   nanotube electronic structure. These results address a long- standing
   challenge to develop carbon nanotube electronic structures that are not
   realized through disruption of pi conjugation, and establish a roadmap
   for designing and tuning specialized semiconductors that feature band
   gaps on the order of a few hundred meV.},
