@article{ WOS:000219627100008,
Author = {Lopes, D. P. and Livio, A. E. and Sousa, M. R. and Silva, F. M.},
Title = {STATISTICAL BEHAVIOUR OF LEVEL OF ACID RAIN IN THE CITY OF NATAL/RN BY
   GAUSSIAN DISTRIBUTION},
Journal = {HOLOS},
Year = {2014},
Volume = {30},
Number = {6},
Pages = {83-89},
Abstract = {The knowledge of the behavior of the degree of acidity of rainfall
   becomes relevant to the sciences of environmental nature, especially to
   Geography, which seeks to understand phenomena from human-Catmosphere
   interaction. Thus, the article objective analyze the statistical
   behavior of the degree of acidity of rainfall in Natal/RN. Thus, the
   paper objective analyze the statistical behavior of the degree of
   acidity of rainfall in Natal/RN. For this, we used rainfall data
   collected in the Climatological Station of the Federal University of Rio
   Grande do Norte/UFRN the period 14/12/2005 to 25/08/2006 For both,
   having as geographical coordinates: latitude 05 degrees 55' South and
   longitude 35 degrees 12' West, at an altitude of 48.62 meters. At the
   end of each rainfall event, the measurement of pH was carried out using
   a portable WTW phgametro model 330i brand with resolution of +/- 0, 003,
   calibrated before each measurement. As a method of analysis was done
   using descriptive statistics (central tendency and dispersion) and
   probabilistic statistical (Gaussian distribution). The results showed
   that the concentration of the pH of rainfall in Natal/RN. has an average
   of 5,914, with a coefficient of variation of 8\%, is at worrying levels,
   therefore, the concentration ratio is below the limits according to
   CONAMA Resolution 357/2005.},
