@article{ WOS:001757830500011,
Author = {Gracie, Raphaela and Wiedenmann, Jorg and Lam, Phyllis and Sweet,
   Michael and D'Angelo, Cecilia},
Title = {Breakdown of microbial networks links nutrient stress and reef coral
   disease},
Journal = {NATURE COMMUNICATIONS},
