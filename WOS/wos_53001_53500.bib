@article{ WOS:001449494800001,
Author = {Pop, Ana-Maria and Hognogi, Gheorghe-Gavrila and Batinas, Razvan-Horatiu},
Title = {Who's voice counts? Managing conservation and sustainable valorisation
   of peatlands},
