@article{ WOS:001128053000001,
Author = {Odenigbo, Chuk and Wesche, Sonia and Mkandawire, Paul and Crighton, Eric},
Title = {``We are adapting to it because it is within us{''}: The co-becoming of
   COVID-19 in Malawi},
Journal = {WORLD MEDICAL \& HEALTH POLICY},
Year = {2024},
Volume = {16},
Number = {3},
Pages = {295-315},
Month = {SEP},
Abstract = {Using a case study design, this research explores the Coronavirus 2019
   disease (COVID-19) pandemic from the perspectives and worldviews of
   Malawians (Black/African knowledge) through the Bawaka Yolnu ontology of
   co-becoming (Black/Indigenous knowledge). This study seeks to examine
   the ways in which COVID-19 has influenced perceptions of place and the
   places themselves, thereby contributing to the development of policies
   and strategies for effectively navigating and living with the ongoing
   COVID-19 pandemic. The study involved forty-one in-depth semi-structured
   interviews and two unstructured interviews, enabling a nuanced
   exploration of COVID-19's impact through the diverse perspectives of
   Malawian knowledge holders including religious leaders, health-care
   workers, farmers, and community leaders. The findings reveal a
   multifaceted transformation in the relationship of Malawians with
   nature, place, and one another. Nature, once a source of sustenance, has
   become a realm of danger due to its association with airborne
   transmission. Place, typically a communal space, has shifted towards
   individualized safety, necessitating changes in how homes are adapted
   and perceived. The communal fabric of Malawian society, deeply ingrained
   in communal practices, has been strained, altering traditional
   gatherings and societal interactions. This research adds depth to our
   understanding of COVID-19's complex impacts, emphasizing the importance
   of cultural and environmental contexts in shaping responses to the
   pandemic. The insights gained hold significance for tailored policy
   interventions and community-focused strategies to navigate and adapt to
   the evolving challenges presented by COVID-19.},
