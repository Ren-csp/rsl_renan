@article{ WOS:000285541800007,
Author = {Ratcliffe, John M. and Fullard, James H. and Arthur, Benjamin J. and
   Hoy, Ronald R.},
Title = {Adaptive auditory risk assessment in the dogbane tiger moth when pursued
   by bats},
Journal = {PROCEEDINGS OF THE ROYAL SOCIETY B-BIOLOGICAL SCIENCES},
