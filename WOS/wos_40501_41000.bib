@article{ WOS:001151667900003,
Author = {Zhang, Weiqi and Ding, Dian and Lu, Yishuo and Chen, Hongyi and Jiang,
   Peijun and Zuo, Peng and Wang, Guangxi and Luo, Juan and Yin, Yue and
   Luo, Jianyuan and Yin, Yuxin},
Title = {Structural and functional insights into the lipid regulation of human
   anion exchanger 2},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JAN 26},
Abstract = {Anion exchanger 2 (AE2) is an electroneutral Na+-independent Cl-/HCO3-
   exchanger belongs to the SLC4 transporter family. The widely expressed
   AE2 participates in a variety of physiological processes, including
   transepithelial acid-base secretion and osteoclastogenesis. Both the
   transmembrane domains (TMDs) and the N-terminal cytoplasmic domain (NTD)
   are involved in regulation of AE2 activity. However, the regulatory
   mechanism remains unclear. Here, we report a 3.2 angstrom cryo-EM
   structure of the AE2 TMDs in complex with PIP2 and a 3.3 angstrom
   full-length mutant AE2 structure in the resting state without PIP2. We
   demonstrate that PIP2 at the TMD dimer interface is involved in the
   substrate exchange process. Mutation in the PIP2 binding site leads to
   the displacement of TM7 and further stabilizes the interaction between
   the TMD and the NTD. Reduced substrate transport activity and
   conformation similar to AE2 in acidic pH indicating the central
   contribution of PIP2 to the function of AE2.
   Anion exchanger 2 (AE2), a widely expressed Cl- /HCO3 - exchanger,
   participates in the regulation of intracellular pH. Here, the authors
   present the structures of AE2 and uncover the regulatory mechanism of
   PIP2.},
