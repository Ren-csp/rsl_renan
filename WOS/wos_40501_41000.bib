@article{ WOS:001806822600012,
Author = {Srinivasan, Deepa and Agrawal, Twinkle and Fathima, Farah Naaz},
Title = {Environmental profiling of determinants of cardiovascular disease using
   a Geographic Information System in rural villages of Karnataka, India},
Journal = {INTERNATIONAL JOURNAL OF NONCOMMUNICABLE DISEASES},
Year = {2026},
Volume = {11},
Number = {3},
Pages = {264-270},
Month = {JUL-SEP},
Abstract = {Background:Environmental factors play a critical role in cardiovascular
   diseases (CVD) and are often not studied. This study aimed to assess the
   environmental risk factors for CVD using a Geographic Information System
   (GIS).Materials and Methods:A cross-sectional descriptive study was
   conducted among 25 villages in Karnataka, India, using a validated
   structured questionnaire, Environmental Profile Of Community Health
   (EPOCH). A photographic assessment tool, the EPOCH Photo Neighborhood
   Evaluation Tool (EP-NET), was used to assess urban planning, aesthetics,
   community appeal, community disorder, pedestrian safety, bike lanes, and
   their quality.Results:All the villages had at least four environmental
   risk factors, with a mean of 5.5 +/- 0.9 risk factors (maximum: 7). None
   of the villages had sidewalks, traffic lights, crosswalks, or
   restaurants with healthy foods. Most villages (88\%) had at least one
   tobacco outlet, and only three villages had a pharmacy in their village.
   The mean EP-NET score was 9.7 +/- 2.6 (maximum: 59).Conclusion:None of
   the villages studied were CVD-friendly. Adequate planning, including the
   establishment of parks and pedestrian-friendly roads for physical
   activity, strict monitoring of the prevalent tobacco control
   legislations, and easy availability of healthy foods and medications,
   will help adopt healthy lifestyles and will eventually reduce the chance
   of CVD.},
