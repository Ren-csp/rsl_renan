@article{ WOS:001806024400001,
Author = {Taute, Nona and Morgan, Te Kipa Kepa Brian and Ingham, Jason and Archer,
   Rosalind and Fa'aui, Tumanako},
Title = {Indigenous values in geothermal decision-making: A comparative analysis
   of governance constraints in Aotearoa New Zealand and Hawai'i},
Journal = {ENVIRONMENTAL IMPACT ASSESSMENT REVIEW},
Year = {2026},
Volume = {121},
Month = {SEP},
Abstract = {As geothermal development expands globally as part of low-carbon energy
   transitions, projects increasingly intersect with Indigenous cultural
   landscapes and governance rights. In Aotearoa New Zealand and Hawai'i,
   geothermal resources are both materially valuable and culturally
   significant, yet the regulatory systems governing their use differ in
   how they recognise Indigenous interests. This paper presents a
   comparative analysis of Ma \& strns;ori and Kanaka Maoli perceptions of
   geothermal utility to examine how governance structures shape the
   conditions under which geothermal development becomes culturally
   legitimate or contested. The analysis draws on qualitative engagement
   with Kanaka Maoli informants alongside synthesis of prior research
   relating to Ma \& strns;ori geothermal governance and cultural
   perspectives in Aotearoa New Zealand. The analysis shows that Indigenous
   positions on geothermal development are not reducible to simple binaries
   of acceptance or resistance. Rather, they emerge from the interaction of
   local geothermal characteristics, spiritual relationships with
   geothermal landscapes, and the degree to which regulatory systems
   provide pathways for Indigenous authority, benefit-sharing, and consent.
   In Aotearoa, statutory recognition of Ma \& strns;ori relationships with
   geothermal resources enables negotiated forms of development, including
   Indigenous-led initiatives. In contrast, Hawai'i's regulatory framework
   provides limited mechanisms for incorporating Kanaka Maoli authority.
   This structural difference helps explain divergent Indigenous
   perceptions of geothermal utility despite shared spiritual values. The
   findings suggest that culturally acceptable energy pathways depend less
   on cultural attitudes toward technology itself, and more on whether
   governance systems enable meaningful Indigenous participation. For
   impact assessment practice, the study highlights the importance of
   moving beyond procedural consultation toward regulatory arrangements
   that recognise Indigenous authority as a determinant of project
   legitimacy.},
