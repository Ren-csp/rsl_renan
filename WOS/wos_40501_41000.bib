Language = {English},
Affiliation = {Wu, MH (Corresponding Author), Northwest Normal Univ, Coll Geog \& Environm Sci, Lanzhou 730070, Peoples R China.
   Wu, MH (Corresponding Author), Key Lab Resource Environm \& Sustainable Dev Oasis, Lanzhou 730070, Peoples R China.
