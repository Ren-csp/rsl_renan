@article{ WOS:001862981100009,
Author = {Chun, Jihwan and Tripathi, Prabhanshu and Flores-Garcia, Yevel and
   Madan, Bharat and Lee, Gene A. and Fahad, Ahmed S. and Lei, Haotian and
   Teng, I-Ting and Hurlburt, Nicholas K. and Flynn, Barbara J. and
   Pancera, Marie and Miura, Kazutoyo and Zhou, Tongqing and Idris, Azza H.
   and Zavala, Fidel and Seder, Robert A. and Kwong, Peter D. and DeKosky,
   Brandon J.},
Title = {Anti-malaria antibody engineering broadens recognition motifs and
   reveals new homotypic interactions that enhance protective breadth},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUL 28},
Abstract = {The monoclonal antibody L9 mediates high-level protection against
   malaria in children for up to 6 months in Africa. L9 preferentially
   binds with high affinity to a triplicate of NVDP-minor repeats on the P.
   falciparum circumsporozoite protein (PfCSP). Here, we sought to improve
   the affinity of L9 to enhance protection against rare strains with two
   spatially separated minor repeats or a single minor repeat. Site
   saturation mutagenesis and yeast display-screening identified a panel of
   affinity-improved variants. In vivo challenge showed one variant,
   L9\_yd19, to be modestly more potent against a transgenic Plasmodium
   encoding chimeric CSP with two widely spaced minor repeats from a Kenyan
   parasite strain, with no loss in potency against the benchmark 3D7
   strain with its standard complement of minor repeats. L9\_yd19 also had
   high affinity against NANP-major repeats and was protective against
   transgenic Plasmodium expressing CSP with a NANP12 knock-in lacking
   NVDP. Cryo-EM studies revealed L9\_yd19 to recognize PfCSP with two
