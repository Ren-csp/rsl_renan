   Zhao, Haili; Wu, Minghui; Du, Yuhan; Zhang, Fang; Li, Jialiang, Key Lab Resource Environm \& Sustainable Dev Oasis, Lanzhou 730070, Peoples R China.},
DOI = {10.3390/ijerph20010743},
Article-Number = {743},
