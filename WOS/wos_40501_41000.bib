@article{ WOS:000690135700001,
Author = {Bianco, Giovanni and Bonvini, Barbara and Bracco, Stefano and Delfino,
   Federico and Laiolo, Paola and Piazza, Giorgio},
Title = {Key Performance Indicators for an Energy Community Based on Sustainable
   Technologies},
Journal = {SUSTAINABILITY},
Year = {2021},
Volume = {13},
Number = {16},
Month = {AUG},
Abstract = {As reported in the ``Clean energy for all Europeans package{''} set by
   the EU, a sustainable transition from fossil fuels towards cleaner
   energy is necessary to improve the quality of life of citizens and the
   livability in cities. The exploitation of renewable sources, the
   improvement of energy performance in buildings and the need for
   cutting-edge national energy and climate plans represent important and
   urgent topics to be faced in order to implement the sustainability
   concept in urban areas. In addition, the spread of polygeneration
   microgrids and the recent development of energy communities enable a
   massive installation of renewable power plants, high-performance
   small-size cogeneration units, and electrical storage systems; moreover,
   properly designed local energy production systems make it possible to
   optimize the exploitation of green energy sources and reduce both energy
   supply costs and emissions. In the present paper, a set of key
   performance indicators is introduced in order to evaluate and compare
   different energy communities both from a technical and environmental
   point of view. The proposed methodology was used in order to assess and
   compare two sites characterized by the presence of sustainable energy
   infrastructures: the Savona Campus of the University of Genoa in Italy,
   where a polygeneration microgrid has been in operation since 2014 and
   new technologies will be installed in the near future, and the SPEED2030
   District, an urban area near the Campus where renewable energy power
   plants (solar and wind), cogeneration units fed by hydrogen and storage
   systems are planned to be installed.},
