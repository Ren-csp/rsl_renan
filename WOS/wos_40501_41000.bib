@article{ WOS:000361889100093,
Author = {Lien, Laura L. and Steggell, Carmen D. and Iwarsson, Susanne},
Title = {Adaptive Strategies and Person-Environment Fit among Functionally
   Limited Older Adults Aging in Place: A Mixed Methods Approach},
