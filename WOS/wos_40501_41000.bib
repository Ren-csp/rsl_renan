@article{ WOS:001416769200001,
Author = {Wibowo, Razan and Weinmann, Tobias and Nowak, Dennis and Prabandari,
   Yayi Suryo},
Title = {Exploring E-Cigarette Use Among Indonesian Youth: Prevalence,
   Determinants and Policy Implications},
Journal = {JOURNAL OF COMMUNITY HEALTH},
