@article{ WOS:001065640300001,
Author = {Bassols i Gardella, Narcis},
Title = {Guided tours and tourist attractions in the postpandemic world: thematic
   evolutions and spatial changes},
Journal = {INTERNATIONAL JOURNAL OF TOURISM CITIES},
Year = {2023},
Volume = {9},
Number = {4},
Pages = {960-973},
Month = {NOV 22},
Abstract = {PurposeThe purpose of this paper is to widen the understanding of the
   shifts the tourism industry experienced as it went though the Covid-19
   pandemic. To contribute to this question, an empirical comparison is
   made between the supply of guided tours and sights at an urban
   destination in the pre- and postpandemic eras, thus gauging the changes
   in the guiding tours industry after the
   pandemic.Design/methodology/approachBy conducting a convenience data
   gathering and a double-level analysis (tours analysis and sights
   analysis) on the tours and attractions supply at an urban destination,
   underlying trends come to light, related to the changes in the
   postpandemic era. This empirical comparison (2019 vs 2022) allows the
   authors to assess what has and has not changed in the postpandemic
   context.FindingsGuided tours and attractions supply are evolving in the
   researched destination, but at a slow pace. Therefore, we conclude that
   long-term processes in destinations prevail over short-term disruptions,
   no matter how strong these disturbances are.Practical implicationsThe
   results are of interest to practitioners as they facilitate a better
   assessment of the impacts of a crisis and greater awareness of the
   evolution of attractions in urban tourism. While the ``staple tours{''}
   in a destination are always there, practitioners should keep an eye on
   new spaces in the city which the sector is opening up and also new
   touring trends.Originality/valueThis study is one of the few to
   empirically compare a pre- and postpandemic situation, as far as
   city-guided tours are concerned. It helps practitioners and authorities
   in urban destinations to assess the new trends that have emerged in the
   postpandemic era, and offers a two-level tool for tour analysis that
   could be applied to any urban destination.},
