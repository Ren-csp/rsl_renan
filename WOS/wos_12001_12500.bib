@article{ WOS:001822902000001,
Author = {Gu, Xinyue and Xie, Yuanyi and Li, Mingkai and Liang, Zifeng and Qi,
   Dongjin},
Title = {Revealing the Conflicts Over the Use of Public Space in Urban
   Policy-Backed Mixed Residential Communities: Taking Guangzhou
   Communities as Case Studies},
Journal = {SAGE OPEN},
Year = {2026},
Volume = {16},
Number = {3},
Month = {JUL},
Abstract = {The use of commercial residential land to construct policy housing to
   assure housing for people on low and middle incomes, also known as
   policy-backed mixed residential communities (PMRCs), has gradually
   become a common form of urban settlement with the strengthening of the
   local government's public housing policy in China. Conflicts over the
   use of public space in policy mixed communities are also common. This
   study conducted a preliminary survey on 116 housing projects in
   Guangzhou. Based on theoretical sampling principles, combining local
   media reports and relevant website evaluations, three representative
   policy-backed mixed communities with low, medium, and strong conflict in
   the use of public space was selected as case studies. A combination of
   field observations, on-site interviews and questionnaires were also used
   to collect data. Semantic analysis is first used to preliminarily
   identify conflicts in the use of public space, then the social
   integration measure is used to quantitatively examine the degree of
   community integration. Finally, the conflict dimensions and conflict
   factors were determined using the importance-satisfaction IPA analysis.
   The study shows that there are significant differences between the three
   cases in terms of community integration, while community governance is
   the most important factor influencing conflicts over the use of public
   space. As one of the global empirical researches on conflict in PMRCs,
   this study has both theoretical and practical implications for the
   construction of sustainable community governance. Therefore, community
   governance, as the final link of policy-backed mixed communities, needs
   to be further improved and optimized in community planning.},
