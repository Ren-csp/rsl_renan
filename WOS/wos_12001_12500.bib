@article{ WOS:001616076800001,
Author = {Rezende, Jozrael Henriques and Fabricio, Giovani Mineti},
Title = {Roadside urban forests in Jaú, São Paulo: composition, diversity, and
   management practices},
Journal = {CIENCIA FLORESTAL},
Year = {2025},
Volume = {35},
Pages = {1-16},
Abstract = {Promoting sustainable development and enhancing urban resilience to
   climate change are urgent global priorities. Among the strategies to
   achieve these goals, expanding and improving urban green spaces and tree
   cover play a critical role. Assessing the current state of urban tree
   cover is therefore essential to guide actions that optimize the
   ecosystem services provided by urban vegetation. This study aimed to
   quantify and characterize tree cover along public sidewalks in the
   central region of Ja \& uacute;, S \& atilde;o Paulo. A comprehensive
   tree census was conducted, evaluating indicators such as total number of
   trees, tree density, floristic composition and diversity, species
   origin, tree and trunk height, and tree pit dimensions. The findings
   were unsatisfactory across all indicators: the number of sidewalk trees
   was insufficient, density and diversity were low, exotic species
   predominated, pruning was excessive, and most tree pits had permeable
   areas smaller than the recommended minimum. These results underscore the
   pressing need for a municipal policy on urban forestry to regulate
   species selection, planting practices, and tree management, thereby
   fostering a more resilient and sustainable urban environment.},
Publisher = {UNIV FEDERAL SANTA MARIA},
Address = {CIDADE UNIV, BAIRRO CAMOBI, SANTA MARIA, RS 97105-900, BRAZIL},
Type = {Article},
