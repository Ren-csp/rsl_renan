@article{ WOS:000894786900001,
Author = {Weisser, Wolfgang W. and Hensel, Michael and Barath, Shany and Culshaw,
   Victoria and Grobman, Yasha J. and Hauck, Thomas E. and Joschinski, Jens
   and Ludwig, Ferdinand and Mimet, Anne and Perini, Katia and Roccotiello,
