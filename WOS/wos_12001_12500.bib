   Guo, Miao, Kunming Univ Sci \& Technol, Fac Transportat Engn, Kunming 650550, Peoples R China.
   Sun, Haodong, Beijing Municipal Inst City Planning \& Design, Beijing 100045, Peoples R China.},
DOI = {10.3390/urbansci10010001},
Article-Number = {1},
EISSN = {2413-8851},
Keywords = {urban rail transit; land-use; regional function; transit-oriented
