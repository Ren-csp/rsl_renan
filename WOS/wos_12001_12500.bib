@article{ WOS:000439971400003,
Author = {Tycko, Josh and Barrera, Luis A. and Huston, Nicholas C. and Friedland,
   Ari E. and Wu, Xuebing and Gootenberg, Jonathan S. and Abudayyeh, Omar
   O. and Myer, Vic E. and Wilson, Christopher J. and Hsu, Patrick D.},
Title = {Pairwise library screen systematically interrogates Staphylococcus
   aureus Cas9 specificity in human cells},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {JUL 27},
Abstract = {Therapeutic genome editing with Staphylococcus aureus Cas9 (SaCas9)
   requires a rigorous understanding of its potential off-target activity
   in the human genome. Here we report a high-throughput screening approach
   to measure SaCas9 genome editing variation in human cells across a large
   repertoire of 88,692 single guide RNAs (sgRNAs) paired with matched or
   mismatched target sites in a synthetic cassette. We incorporate
   randomized barcodes that enable whitelisting of correctly synthesized
   molecules for further downstream analysis, in order to circumvent the
   limitation of oligonucleotide synthesis errors. We find SaCas9 sgRNAs
   with 21-mer or 22-mer spacer sequences are generally more active,
   although high efficiency 20-mer spacers are markedly less tolerant of
   mismatches. Using this dataset, we developed an SaCas9 specificity model
   that performs robustly in ranking off-target sites. The barcoded
   pairwise library screen enabled high-fidelity recovery of guide-target
   relationships, providing a scalable framework for the investigation of
   CRISPR enzyme properties and general nucleic acid interactions.},
