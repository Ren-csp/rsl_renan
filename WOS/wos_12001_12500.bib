@article{ WOS:001475772200001,
Author = {Yang, Yue and Liu, Yidi and Chen, Qiujie and Du, Shaoshan},
Title = {The Influence of ``Industry-City-Innovation{''} Functional Mixing on the
   Innovative Development of Sci-Tech Parks Under the Background of
   Urbanization},
Journal = {SUSTAINABILITY},
Year = {2025},
Volume = {17},
Number = {8},
Month = {APR 20},
Abstract = {The development of sci-tech parks (STPs), as the spatial carrier of
   urbanization and the growth pole of the innovation economy, cannot be
   separated from the integration of the three key elements of
   ``industry{''}, ``city{''}, and ``innovation{''}. This study selects the
   Hangzhou West Hi-Tech Corridor, which represents the forefront of
   development practice of China's STPs and which is a high-quality model
   with highly integrated ``industry-city-innovation{''} functions, as a
   case. By using multi-source data, such as geographic information and the
   point of interest (POI), and research methods, such as the Shannon
   entropy index and quadratic curve regression, this study examines the
   influence of ``industry-city-innovation{''} functional mixing on the
   innovative development of STPs, and explores the optimal mixing degree
   interval. The results show that the mixing of
   ``industry-city-innovation{''} functions can promote the STPs'
   innovative development, to a certain extent, in the spatial design of
   urban planning. However, higher mixing is not always better, and
   excessively high mixing may inhibit innovative development. The optimal
   functional mixing degree conducive to the STPs' innovative development
   is in the range of 0.14 to 0.16. This study is an effective application
   of the ``industry<not sign>-city-innovation{''} integration theory,
   provides a constant source of power for urban innovative development,
   and acts as a reference for future new cities and STPs.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Yang, Y (Corresponding Author), Anhui Jianzhu Univ, Sch Architecture \& Urban Planning, Hefei 230601, Peoples R China.
   Yang, Yue; Liu, Yidi; Chen, Qiujie; Du, Shaoshan, Anhui Jianzhu Univ, Sch Architecture \& Urban Planning, Hefei 230601, Peoples R China.},
DOI = {10.3390/su17083715},
Article-Number = {3715},
EISSN = {2071-1050},
