@article{ WOS:001863425500001,
Author = {Odoi-Yorke, Flavio and Oppon, James Anthony and Bamfo-Agyei, Emmanuel
   and Turkson, Aaron Tony and Awere, Eric and Mahu, Seth Agbeve and
   Okpoti, Felix Koney and Darko, Ransford Opoku},
Title = {Green building in Sub-Saharan Africa: Exploring research trends,
   insights, and future directions (2005-2025)},
Journal = {SUSTAINABLE FUTURES},
Year = {2026},
Volume = {12},
Month = {DEC},
Abstract = {This study examined the evolution of green building research in
   Sub-Saharan Africa (SSA), addressing the persistent challenges of rapid
   urbanisation, climate vulnerability, and slow uptake of sustainable
   construction practices across the region. Despite global attention to
   green buildings, the SSA region remains overlooked, with a limited
   understanding of regional thematic priorities. The objective of this
   study is to analyse publication trends, geographical distribution,
   collaboration networks, thematic structures, and conceptual developments
   within SSA's green building research domain. Using the Scopus database,
   733 documents published between 2005 and 2025 were retrieved.
   Thereafter, bibliometric analysis was conducted using Bibliometrix
   (RStudio) and VOSviewer. The findings show that South Africa, Nigeria,
   and Ghana are the leading contributors, while several SSA countries have
   limited or no research output. Thematic analyses identified four
   dominant clusters: urban environmental planning and nature-based
   solutions; adoption and implementation of green buildings; indoor
   environmental quality and environmental performance; and sustainable
   materials and construction techniques. Key barriers to green buildings
   in the SSA region include high upfront costs, limited expertise, weak
   policy frameworks, and inadequate incentives. At the same time, drivers
   are also concerned with energy efficiency, health benefits,
   environmental protection, and emerging economic opportunities. The study
   proposed critical areas that require further study. The results provide
   region-specific insights that can guide policymakers, construction
