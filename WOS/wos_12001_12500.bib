@article{ WOS:000873792800001,
Author = {Teichmann, Florian and Horvath, Andras and Luisser, Markus and Korjenic,
   Azra},
Title = {The Impact of Small-Scale Greening on the Local Microclimate-A Case
   Study at Two School Buildings in Vienna},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {20},
Month = {OCT},
Abstract = {Strategies to mitigate urban heat islands are a recent issue in the
   Austrian capital, Vienna. In this study, the uhiSolver-v2106-0.21
   software was used to evaluate the summer cooling effects and humidity
   production of small-scale facade greening and a green pergola located in
   two schools within the city. Based on on-site measurement data, the
   study revealed that small-scale greening measures are not able to
   substantially reduce ambient air temperature. On a hot summer day, at 3
   p.m. local time (CEST), the maximum decrease amounted to 0.3 degrees C
   at 0.1 m from the facade greening as well as inside the green pergola.
   As for the apparent (perceived) temperature, a reduction of up to 4
   degrees C was observed under the green pergola compared to the unshaded
   roof terrace. Hence, the simulation results show that, within urban
   areas, a significant improvement of thermal comfort in summer can only
   be achieved through large-scale greenery that provides shade for
   pedestrians.},
