@article{ WOS:001581267400001,
Author = {Andrei, Nistor and Scarlat, Cezar},
Title = {AI-Driven Urban Mobility Solutions: Shaping Bucharest as a Smart City},
Journal = {URBAN SCIENCE},
Year = {2025},
