@article{ WOS:001708522500001,
Author = {Behmanesh, Hossein and Brown, Andre},
Title = {Improving the design and management of temporary events in public spaces
   by applying urban design criteria},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {1},
Pages = {251-265},
Month = {MAR},
Abstract = {Urban public spaces such as parks, plazas, and waterfronts play a
   significant role in contributing to the character, economy and success
   of cities. Planned events such as festivals and markets have been
   increasingly staged in urban public spaces. These activities not only
   make urban public spaces lively and vibrant, they also have critical
   positive impacts on their venues. They help generate revenue, create a
   sense of place, and contribute to building an enriched community.
   However, our research revealed that in the case of all the major cities
   that we investigated, the planners and implementers of such events did
   not have professional urban or spatial design capabilities. In addition,
   the review of event planning guides and protocols reveals that in most
   documented processes for major cities, appropriate fundamental urban
   design criteria are neglected or poorly considered. Consequently, our
   research has aimed to develop the pertinent principles that can best
   prescribe a design aid or tool for these non-design professionals to use
   to support the improved design and, hence, effectiveness, of temporary
   event implementation in urban public spaces.},
