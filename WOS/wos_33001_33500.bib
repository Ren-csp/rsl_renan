@article{ WOS:001687149600004,
Author = {Wang, Shengbo and Zhao, Jingwen and Pu, Tongming and Zhao, Liangbing and
   Guo, Xiaoyu and Cheng, Yue and Li, Cong and Ma, Weihao and Tang, Chenyu
   and Xu, Zhenyu and Wang, Ningli and Occhipinti, Luigi G. and Nathan,
   Arokia and Dahiya, Ravinder and Wu, Huaqiang and Tao, Li and Gao, Shuo},
Title = {Ultrafast visual perception beyond human capabilities enabled by motion
   analysis using synaptic transistors},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {FEB 10},
Abstract = {Optical flow, inspired by biological visual systems, calculates spatial
   motion vectors aiming to enable robotics to excel in dynamic
   environments. However, current algorithms, despite human-competitive
   task performance on benchmark datasets, suffer from significant time
   delays, limiting practical deployment. Here, we introduce a neuromorphic
   temporal-attention hardware that emulates the interaction between the
   retina and the lateral geniculate nucleus (LGN) to extract temporal
   motion cues directly in hardware. Using a two-dimensional synaptic
   transistor array, the system encodes brightness changes and accumulates
   them in analog, non-volatile states, generating compact regions of
   interest (ROIs). These ROIs then act as inputs to conventional
   downstream optical flow and vision algorithms, enabling ultrafast motion
   analysis. At the hardware level, the synaptic transistor offers
   high-frequency response (similar to 100 mu s), non-volatility (>10,000
   s), and endurance (>8,000 cycles). Compared to state-of-the-art
   algorithms, our approach demonstrates a 400\% speedup, surpassing
   human-level performance while maintaining or improving accuracy through
   temporal priors.},
