@article{ WOS:001736100800001,
Author = {Vande Velde, Fiona and Abessa, Teklu Gemechu and Mekonnen, Zeleke and
   Gari, Taye and Alemu, Tibebu and Getachew, Hanna and Kumsa, Bersissa and
   Mideksa, Bizunesh and Eba, Kasahun and Waktole, Hika and Teshome, Yonas
   and Lachat, Carl and Gabriel, Sarah and Embo, Mieke and Gevaert, Rudy
   and Verheylezoon, Annick and Tushune, Kora and Levecke, Bruno},
Title = {Exploring students' perceptions of external and internal factors
   associated with PhD progress in Ethiopia: Insights from a
   cross-sectional survey},
Journal = {INTERNATIONAL JOURNAL OF EDUCATIONAL RESEARCH},
Year = {2026},
Volume = {138},
Abstract = {PhD programs in sub-Saharan Africa face persistent challenges, yet the
   extent to which these challenges relate to students' perceived PhD
   progress remain underexplored. We investigated the interplay of external
   factors (e.g. supervision, institutional responsibilities, available
   resources, and financial support) and internal factors (e.g.
   self-efficacy, outcome expectations and selfregulation) on perceived PhD
   progress. The conceptual framework is grounded in the Social Cognitive
   Career Theory and Self-regulation Theory. A cross-sectional survey was
   sent to 1464 PhD students from four public universities, i.e. Addis
   Ababa, Ambo, Hawassa and Jimma University. Responses from 649 PhD
   students (44\% response rate), were collected and analysed using
   structural equation modelling. The findings identified three roles of
   the main advisor in relation to perceived PhD progress: serving as an
   expert, acting as a motivational coach by fostering outcome
   expectations, and fulfilling managerial responsibilities. Moreover, team
   supervision shows a stronger association with the development of PhD
   students' research self-efficacy than individual supervision. Greater
   dissatisfaction with research facilities was associated with higher
   research self-efficacy. This association may be interpreted in relation
   to a mismatch between infrastructure and students' perceived capacity to
   use it, indicating a relationship between facilities and training. There
   is a need for tailored institutional support and training programs that
   not only provide adequate resources but also foster students'
   self-efficacy and research skills in diverse learning environments.},
