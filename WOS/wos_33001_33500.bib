@article{ WOS:001873914400001,
Author = {Ma, Yujie and Williams, Dylan P. and Schnepp, Zoe},
Title = {Time Capsules of Plastic: An Inquiry-Based Outreach Activity},
Journal = {JOURNAL OF CHEMICAL EDUCATION},
Year = {2026},
Month = {2026 SEP 11},
Abstract = {Declining interest in science among young learners presents a persistent
   challenge for science education and chemical literacy. This study
   reports on a 14-month, inquiry-based outreach program implemented with
   children aged 7-9 in a UK school, centered on the environmental
   chemistry of plastic degradation. Through hands-on investigation and
   guided inquiry, pupils explored the breakdown of materials in
   environmental contexts, linking chemical concepts to real-world
   sustainability issues. Evaluation of the program indicates that
   participation increased pupils' interest in science and enhanced their
   understanding of environmental processes. Additionally, the activity
   broadened pupils' perceptions of scientists and the nature of scientific
   work. These findings demonstrate the effectiveness of early,
   context-driven inquiry-based approaches in fostering engagement with
   chemistry and promoting more informed and positive attitudes toward
   science.},
