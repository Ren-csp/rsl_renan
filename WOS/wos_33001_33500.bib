@article{ WOS:001533579500003,
Author = {Vieira, Bruno Rodrigues and Santos, Caroline Queiroz},
Title = {DIGITAL GAME-BASED LEARNING IN ENGINEERING: A PROPOSAL FOR TEACHING
   ENVIRONMENTAL ISSUES AND SOCIAL DIVERSITY},
Journal = {ETD EDUCACAO TEMATICA DIGITAL},
Year = {2025},
Volume = {27},
Abstract = {The need to improve pedagogical proposals in engineering education in
   Brazil is imperative and has been a prominent issue in research for
   decades. The obsolescence of the traditional transmission-reception
   model highlights the necessity for innovative pedagogical methodologies
   that align with the demands of an increasingly critical global scenario.
   As a result, more dynamic practices, such as game-based learning, have
   emerged. This innovative approach has demonstrated significant potential
   in enhancing both teaching and learning. This study aims to create a
   narrative-driven digital educational game to foster learning and raise
   awareness of environmental issues and social diversity among engineering
   students. In addition to exploring the educational game design process,
   the study seeks to identify and evaluate the playful and pedagogical
   elements in promoting an engaging learning experience. The adopted
   methodology is divided into two main stages: the development of the game
   ``Atlantica{''} and its application in an engineering educational
   context. Through surveys, the study analyzes perceptions of the game,
   identifying challenges, facilitators, and contributions to learning. The
   results showed that game-based learning is promising in sparking
   students' interest in the addressed themes, as well as suggesting an
   advantageous proposal to stimulate discussions within the context of
   engineering education in a critical way. Furthermore, the study serves
   as a model basis for future investigations and projects in this segment
   and shall be used as empirical evidence by developers of similar digital
   educational games.},
