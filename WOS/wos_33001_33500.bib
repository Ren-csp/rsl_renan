@article{ WOS:000253653200007,
Author = {Pedersen, Eja and PerssonWaye, Kerstin},
Title = {Wind turbines - low level noise sources interfering with restoration?},
Journal = {ENVIRONMENTAL RESEARCH LETTERS},
Year = {2008},
Volume = {3},
Number = {1},
Month = {JAN-MAR},
Abstract = {Wind turbines generate a low level noise and would thus not be expected
   to cause annoyance and disturb rest. In a society where people are being
   exposed to an increasing noise load, moderate and low level noise
   sources may also be perceived as annoying and hence inhibit restoration.
   This article presents an analysis of two socio-acoustic studies of wind
   turbine noise with the emphasis on perception, annoyance and
   consequences for restoration. It is hypothesized that low and moderate
   stressors such as wind turbine noise could have an impact on health. The
   risk seems to be higher if restoration is, or is perceived to be,
   impaired and also for certain groups of individuals. The observations
   warrant further studies.},
