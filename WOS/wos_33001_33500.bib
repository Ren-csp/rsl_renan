@article{ WOS:001849235100003,
Author = {Moreira, Felipe Jovani Tavares and Bissonnette, Jean-Francois and
   Munson, Alison D. and Raymond, Patricia},
Title = {Exploring forest futures: ethics and governance of assisted migration as
   a climate adaptation strategy},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {3},
Month = {AUG},
Abstract = {. As climate change accelerates shifts in forest ecosystems, forest
   assisted migration (hereafter ``assisted migration{''}) has gained
   attention as a climate adaptation strategy. In forest contexts, assisted
   migration encompasses a gradient of interventions-from assisted gene
   flow through non-local seed sourcing to species-level relocation-each
   raising distinct ethical and governance challenges. Yet the deliberate
   movement of tree populations remains contentious. Beyond its ecological
   and silvicultural dimensions, assisted migration raises normative
   questions about legitimacy, responsibility, and justice. This article
   offers a thematically oriented qualitative synthesis of 20 studies
   published between 2009 and 2024, examining how ethical, political, and
   social debates structure forest assisted migration governance. Three
   clusters of normative tensions emerge. First, ethical dilemmas revolve
   around precaution, intergenerational responsibility, and moral pluralism
   under conditions of ecological uncertainty. Second, governance
   challenges involve institutional fragmentation, regulatory ambiguity,
   and epistemic marginalization, particularly regarding the inclusion of
   diverse knowledge systems and authorities. Third, social perceptions are
   shaped by trust, cultural worldviews, and risk framing, underscoring the
   central role of social acceptability in determining whether assisted
   migration initiatives are regarded as legitimate. Drawing on ecological
   pragmatism-and informed by thinkers such as John Dewey, Bruno Latour,
   and Mark Usher-the analysis conceptualizes forest assisted migration not
   as a fixed technical solution but as an evolving socio-technical
   experiment embedded in institutional histories and public contestation.
   Rather than resolving ongoing debates, the synthesis highlights the
   importance of normative clarity, participatory governance, and adaptive
   learning in the development of assisted migration policies. By situating
   forest assisted migration within broader discussions of legitimacy and
   adaptive governance, the study argues that its long-term feasibility
   depends not only on scientific evidence but also on society's collective
   capacity to navigate ethical uncertainty, institutional complexity, and
   cultural diversity in forest management.},
