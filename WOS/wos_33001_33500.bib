@article{ WOS:001746332300001,
Author = {Zhai, Xiaoxuan and Zhu, Cherrie Jiuhua and Zhang, Mingqiong Mike},
Title = {Looking Back and Looking Forward: Thirty Years of Evidence on Strategic
   HRM Systems and Performance (1995-2025)},
