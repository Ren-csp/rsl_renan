@article{ WOS:000320648900014,
Author = {Stock, Paul V. and Brickell, Chris},
Title = {Nature's good for you: Sir Truby King, Seacliff Asylum, and the greening
   of health care in New Zealand, 1889-1922},
Journal = {HEALTH \& PLACE},
Year = {2013},
Volume = {22},
Pages = {107-114},
Month = {JUL},
Abstract = {Sir Frederic Truby Kings work at Seacliff Asylum in New Zealand, between
   1889 and 1922, illustrates a prominent role of agriculture in
   relationship to human health and the environment. King utilized farming
   practices, a rural setting, occupational therapy, dietary changes and
   moves towards self-sufficiency as examples of asylum management
   practices, but these also ensured patient health and well-being. In this
   article, we analyze Kings practices at Seacliff as a genealogical
   precursor to today's green care and care farming movements. (C) 2013
   Elsevier Ltd. All rights reserved.},
