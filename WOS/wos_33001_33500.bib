@article{ WOS:001605116000001,
Author = {Boothby, Claire and Worledge, Lisa and Boughey, Katherine L. and
   Langton, Steve D. and Gilmour, Lia R. V.},
Title = {Understanding bats in English churches: A citizen science approach},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {12},
Pages = {3154-3167},
Month = {DEC},
Abstract = {As the global human population expands, human-wildlife interactions are
   increasingly common. Some bat species use churches as roosting sites,
   and conservation conflicts are common, often due to the increased
   cleaning burden and damage caused by bat excreta. Understanding the
   extent of the use of churches by bats and the perceptions of people
   encountering bats in churches is therefore important for the future
   conservation of bat species, as well as the historical buildings they
   rely on. A citizen science survey of bat use of churches and human
   perspectives was carried out in 753 churches across England, June-August
   2019-2022, as part of the Bats in Churches Project. Around half (50.2\%,
   95\% CI {[}44, 55]) of churches surveyed housed bats, increasing to
   78.4\% (95\% CI {[}73, 84]) in older churches, equating to more than
   8000 churches nationally. A range of factors affected bat species'
   presence in churches. Pipistrellus pipistrellus, Pipistrellus pygmaeus,
   Plecotus auritus and Eptesicus serotinus were more often present in
   churches surrounded by more arable land, indicating the importance of
   churches as roosts in agricultural landscapes. For the same species
   (apart from E. serotinus), we found a negative effect of external
   lighting on the west side of the church. Most church representatives
   felt positively or indifferent about bats (only 10\% recorded negative
   responses when bats were present). However, the extent of perceived
   damage and disruption by bats was associated with a more negative
   opinion. Opinions were influenced by extremes of bat presence, being
   more negative in churches when there were hundreds of droppings or, more
   notably, where there was no evidence of bats. We recommend (i) further
   research on (a) the importance of landscape context for rural churches,
   (b) the impact of church features on roosting bats and (c) why lighting
   to the west is particularly detrimental to bats' use of churches; (ii)
   additional roosting opportunities are provided away from churches for
   bats in arable landscapes; and (iii) resources aimed at churches with
   bats are widely promoted to support the communities looking after
   churches and their vital conservation.Read the free for this article on
   the Journal blog.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Gilmour, LRV (Corresponding Author), Bat Conservat Trust, London, England.
   Boothby, Claire; Worledge, Lisa; Boughey, Katherine L.; Gilmour, Lia R. V., Bat Conservat Trust, London, England.
   Langton, Steve D., Hallgarth, Malton, No Yorkshire, England.},
DOI = {10.1002/pan3.70156},
EarlyAccessDate = {OCT 2025},
EISSN = {2575-8314},
Keywords = {bat excreta; bat roost; Chiroptera; conservation; conservation conflict;
   heritage; historical buildings; human-wildlife interactions},
Keywords-Plus = {EPTESICUS-SEROTINUS},
Research-Areas = {Biodiversity \& Conservation; Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Biodiversity Conservation; Ecology},
Author-Email = {lgilmour@bats.org.uk},
ResearcherID-Numbers = {Gilmour, Lia/HGC-3831-2022
   /AAK-4225-2020},
Funding-Acknowledgement = {National Lottery Heritage Fund},
Funding-Text = {Claire Boothby, the lead author of this paper, sadly passed away before
   its publication. Claire was a dedicated conservationist, influencing
   others across the UK and beyond. She is greatly missed, but her work and
   approach to life continues to inspire her fellow authors and former
   colleagues. We would like to thank all the volunteers and church
   representatives who gave their time and made this research possible. We
   would also like to thank players of the National Lottery as this
