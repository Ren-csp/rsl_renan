@article{ WOS:000286835800002,
Author = {Morimoto, Yukihiro},
Title = {Biodiversity and ecosystem services in urban areas for smart adaptation
   to climate change: ``Do you Kyoto{''}?},
Journal = {LANDSCAPE AND ECOLOGICAL ENGINEERING},
