@article{ WOS:000416098300002,
Author = {Vierikko, Kati and Elands, Birgit and Niemela, Jari and Andersson, Erik
   and Buijs, Arjen and Fischer, Leonie Katharina and Haase, Dagmar and
   Kabisch, Nadja and Kowarik, Ingo and Luz, Ana Catarina and Stahl, Anton
   Olafsson and Szaraz, Luca and Van der Jagt, Alexander and van den Bosch,
   Cecil Konijnendijk},
Title = {Considering the ways biocultural diversity helps enforce the urban green
   infrastructure in times of urban transformation},
Journal = {CURRENT OPINION IN ENVIRONMENTAL SUSTAINABILITY},
Year = {2016},
Volume = {22},
Pages = {7-12},
Month = {OCT},
Abstract = {Traditionally, biocultural diversity (BCD) has been researched in
   non-western and indigenous societies. Recently, it has also been applied
   in urbanized and industrialized societies, in particular for the
   planning and management of urban green infrastructure (UGI). Diversity
   in human and biological systems is considered to support cities'
   adaptation capacity. However, diversity might also increase the risk of
   conflicts. In this paper, we discuss not only how the BCD approach could
   strengthen studies on human-nature interactions in an urban context, but
   also the potential pitfalls of applying BCD. By means of two examples of
   BCD research, that is people in-places and people-making UGI in cities,
   we argue that BCD as a reflexive concept can strengthen UGI planning and
   management.},
