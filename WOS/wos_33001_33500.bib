@article{ WOS:001824751700001,
Author = {Askari, Esmaiel and Savari, Moslem and Rezaei, Marzieh},
Title = {Psychological and experiential determinants of pre-flood protective
   behaviors in rural Iran},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {Preventive protective measures play an important role in reducing the
   vulnerability of communities to floods. This study aimed to investigate
   the effects of risk perception and flood experience on the adoption of
   preventive protective measures among rural households in Iran. Data were
   collected using a questionnaire and analyzed through structural equation
   modeling. The study population consisted of rural households in Shushtar
   County, Khuzestan Province, in southwestern Iran, one of the regions at
   risk of flooding. The results showed that the dimensions of risk
   perception, including concern, preparedness, and awareness, as well as
   flood experience, had positive and significant effects on preventive
   protective measures. The research variables explained 73.3\% of the
   variance in protective measures, indicating the high explanatory power
   of the study's theoretical model. Furthermore, flood experience was
   identified as the strongest predictor of protective behaviors. The
   findings suggest that strengthening awareness programs, providing flood
   preparedness training, and promoting experience-based learning can play
   an effective role in enhancing protective behaviors and increasing the
   resilience of rural communities to flood hazards.},
