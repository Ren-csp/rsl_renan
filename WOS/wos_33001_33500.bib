@article{ WOS:001266702400023,
Author = {Brazovskaja, Agnieska and Gomes, Tomas and Holtackers, Rene and Wahle,
   Philipp and Koerner, Christiane and He, Zhisong and Schaffer, Theresa
   and Eckel, Julian Connor and Haensel, Rene and Santel, Malgorzata and
   Seimiya, Makiko and Denecke, Timm and Dannemann, Michael and Brosch,
   Mario and Hampe, Jochen and Seehofer, Daniel and Damm, Georg and Camp,
   J. Gray and Treutlein, Barbara},
Title = {Cell atlas of the regenerating human liver after portal vein
   embolization},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JUL 11},
Abstract = {The liver has the remarkable capacity to regenerate. In the clinic,
   regeneration is induced by portal vein embolization, which redirects
   portal blood flow, resulting in liver hypertrophy in locations with
   increased blood supply, and atrophy of embolized segments. Here, we
   apply single-cell and single-nucleus transcriptomics on healthy,
   hypertrophied, and atrophied patient-derived liver samples to explore
   cell states in the regenerating liver. Our data unveils pervasive
   upregulation of genes associated with developmental processes, cellular
   adhesion, and inflammation in post-portal vein embolization liver,
   disrupted portal-central hepatocyte zonation, and altered cell subtype
   composition of endothelial and immune cells. Interlineage crosstalk
   analysis reveals mesenchymal cells as an interaction hub between immune
   and endothelial cells, and highlights the importance of extracellular
   matrix proteins in liver regeneration. Moreover, we establish
   tissue-scale iterative indirect immunofluorescence imaging for
   high-dimensional spatial analysis of perivascular microenvironments,
   uncovering changes to tissue architecture in regenerating liver lobules.
   Altogether, our data is a rich resource revealing cellular and
   histological changes in human liver regeneration.
   The liver has the remarkable ability to regenerate. Applying single-cell
   transcriptomics and iterative immunofluorescence imaging on
   patient-derived samples, this study revealed cellular gene expression
   changes linked to altered tissue architecture.},
