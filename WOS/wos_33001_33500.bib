@article{ WOS:001835503600001,
Author = {Olivares Esquivel, Elisa and Farris, Simone and Higham, Catherine},
Title = {Curating landscapes to encourage care for biodiversity through arts and
   citizen science},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {9},
Pages = {3110-3121},
Month = {SEP},
Abstract = {This study investigates how combining Citizen Science and Art workshops
   within curated wildflower meadows can generate repeated, positive
   experiences with nature, and foster a sense of care for it. The project
   aimed to increase awareness, encourage responsibility, and develop
   competencies related to urban nature. We conducted 16 free-entry
   workshops in four diverse urban parks in Sheffield, UK, engaging 73
   community members and local volunteers. Activities included pollinator
   surveys and art methods such as cyanotype printing, microscope drawing,
   and weaving, all focused on the newly installed meadows. Participants
   reported significant positive emotions, describing the sessions as
   `informative, creative, therapeutic, relaxing.' The activities
   encouraged the acquisition of new knowledge (e.g., distinguishing
   between pollinator species) and helped participants appreciate the
   microscopic scale of urban nature. The workshops incentivised care for
   nature by fostering community connections and inspired participants to
   launch their own nature initiatives. However, several barriers to
   developing a sense of care were identified, including a lack of free
   time, community resources, and funding. This research shows that
   positive and intentional interactions with urban nature such as curated
   landscapes can trigger the care for nature process within individuals
   and communities when four elements are considered: the environment and
   the natural typology, provision of knowledge and skills, encouragement
   of curiosity and wonder, and community engagement. Further research on
   encouraging action is needed.Read the free for this article on the
   Journal blog.
   Este estudio investiga c \& oacute;mo la combinaci \& oacute;n de
   ciencia ciudadana y talleres de arte a trav \& eacute;s de la curadur \&
   iacute;a de praderas silvestres puede generar experiencias positivas
   repetidas con la naturaleza y fomentar su cuidado. El objetivo principal
   de este proyecto fue el de aumentar la concienciaci \& oacute;n,
   fomentar la responsabilidad y desarrollar competencias relacionadas con
   la naturaleza urbana. Realizamos 16 talleres gratis, en cuatro parques
   urbanos en Sheffield en el Reino Unido, involucrando a 73 miembros de la
   comunidad y voluntarios locales. Los talleres incluyeron monitoreo de
   polinizadores y actividades art \& iacute;sticas como impresi \&
   oacute;n cianot \& iacute;pica, dibujo de microscopio, e hilado. Todos
   enfocados en las nuevas praderas instaladas. Los participantes
   reportaron emociones positivas significativas y describieron las
   sesiones como `informativas, terap \& eacute;uticas y relajantes'. Las
   actividades impulsaron la adquisici \& oacute;n de nuevos conocimientos
   (por ejemplo, la distinci \& oacute;n entre especies de polinizadores) y
   ayudaron a los participantes a apreciar la escala microsc \& oacute;pica
   de la naturaleza urbana. Los talleres incitaron al cuidado de la
   naturaleza al fomentar las conexiones entre la comunidad, y al inspirar
   a los participantes a generar sus propias iniciativas con la naturaleza.
   Sin embargo, se identificaron varias barreras para promover un sentido
   de cuidado, incluyendo la falta de tiempo libre, la falta de recursos
   comunitarios y la falta de recursos econ \& oacute;micos. Esta
   investigaci \& oacute;n muestra que las interacciones positivas e
   intencionales con la naturaleza urbana, a trav \& eacute;s de la curadur
   \& iacute;a del paisaje, pueden detonar el cuidado por los procesos
   naturales dentro de los individuos y las comunidades cuando cuatro
   elementos son considerados: el medio ambiente y la tipolog \& iacute;a
   natural, la provisi \& oacute;n de conocimiento y de nuevas habilidades,
   el fomento a la curiosidad y al asombro, y la participaci \& oacute;n
   comunitaria.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
