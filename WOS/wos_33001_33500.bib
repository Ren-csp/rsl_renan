@article{ WOS:001660350000001,
Author = {Agnarelli, Alessandro and Buckley-Benbow, Lauryn and Ozgencil, Meryem
   and Lad, Melanie and Ampah, Khamal Kwesi and Kalinka, Alex and Belan,
   Ondrej and Maslen, Sarah and Skehel, Mark J. and Walter, David and Day,
   Matthew and Bellelli, Roberto},
Title = {The genetic and biochemical basis of human leading strand synthesis},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {17},
Number = {1},
Month = {DEC 4},
Abstract = {The maintenance of genome stability requires efficient leading strand
   synthesis by DNA Polymerase Epsilon (Pol epsilon). By performing CRISPR
   genetic screens in cells lacking the POLE4 subunit of Pol epsilon we
   define a genetic map of the factors required to support Pol epsilon
   function in the absence of its accessory subunits. A set of genes
   involved in iron metabolism emerge as required to sustain Iron Sulphur
   Cluster (ISC)-dependent Pol epsilon activity. We then dissect a
   synthetic lethal interaction between POLE3-POLE4 and the CHTF18-RFC2/5
   complex. By combining cell biology, structural modelling and
   biochemistry, we define the existence of two tiers of regulation of Pol
   epsilon processivity: leading strand-specific loading of PCNA by
   CHTF18-RFC2/5 and ``gripping{''} of newly synthesised dsDNA by
   POLE3-POLE4. The combined loss of these functions is incompatible with
   leading strand synthesis and viability. In summary, we describe the
   biochemical basis of human leading strand synthesis and the consequence
   of its dysfunction in genome stability.},
