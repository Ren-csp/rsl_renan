@article{ WOS:001782028400001,
Author = {Alrawadieh, Zaid and Xu, Jing (Bill) and Asan, Kubra and Lau, Yui-Yip},
Title = {Can Children Drive Parents' Sustainable Behaviour When Travelling? An
   Intergenerational Norm Activation Perspective},
Journal = {TOURISM PLANNING \& DEVELOPMENT},
Year = {2026},
Month = {2026 MAY 26},
Abstract = {Pro-environmental behaviour is typically explained through individual
   moral norms; however, little is known about whether-and through which
   mechanisms-children can shape parents' sustainable behaviour while
   travelling. This study proposes and tests a conceptual model that
   explores how parent model identity salience and perceived child judgment
   influence parents' moral obligation, pro-environmental behaviour, and
   willingness to sacrifice while travelling. Drawing on norm activation
   theory, the study investigates the psychological mechanisms through
   which parental roles and intergenerational perceptions shape sustainable
   actions. Survey data collected from 238 Turkish parents travelling with
   their children were analyzed using PLS-SEM. The results indicate that
   parent model identity salience has a significantly positive effect on
   both moral obligation and pro-environmental behaviour. Moral obligation
   positively predicts pro-environmental behaviour but does not
   significantly affect willingness to sacrifice. Contrary to expectations,
   perceived child judgment does not influence moral obligation or
   pro-environmental behaviour, yet it significantly drives willingness to
   sacrifice.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
