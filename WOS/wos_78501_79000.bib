@article{ WOS:001839530400001,
Author = {Pang, Zan and Hashim Lim, Noor Hashimah and Tedong, Peter Aning},
Title = {Measuring residents' cognition of residential energy retrofits: scale
   development and validation},
Journal = {JOURNAL OF HOUSING AND THE BUILT ENVIRONMENT},
Year = {2026},
Month = {2026 AUG 4},
Abstract = {Residential building energy retrofits (RBER) are a key pathway to
   improving dwelling energy performance; yet, residents' appraisals of
   retrofit remain under-measured. This study develops and validates the
   Residential Building Energy Retrofit Cognition Scale (RBERCS), a
   multidimensional instrument that captures residents' cognition:
   integrated reflections and judgements about RBER. Guided by
   content-criteria mapping and Diffusion of Innovation (DoI) evaluative
   lenses, we generated items, revised them through expert review and
   cognitive pretesting, and purified the pool via exploratory factor
   analysis. The final scale comprises 18 items across five content
   domains: Resident Personal Status, Pre-retrofit Building Status,
   Retrofit Measure Performance, Retrofit Social Norms, and Retrofit
   Governance Mechanisms. Confirmatory factor analysis supports the
   proposed five-factor structure; reliability and construct validity are
   evidenced by satisfactory internal consistency, composite reliability,
   average variance extracted, and Fornell-Larcker discriminant tests.
   Nomological validity is supported by positive associations between the
   five cognition domains and attitudes toward RBER. The RBERCS offers a
   concise, psychometrically supported tool for profiling retrofit-related
   cognition among homeowners and other residential decision-makers who can
   provide appraisals based on available knowledge, experience, or
   information, informing market segmentation, programme design, and policy
   evaluation, and supporting research on cognition-attitude-behaviour
   pathways. Directions for cross-cultural revalidation, longitudinal
   testing, and scale refinement are outlined.},
