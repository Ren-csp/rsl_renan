@article{ WOS:000362913100019,
Author = {Barnett, Jon and Evans, Louisa S. and Gross, Catherine and Kiem, Anthony
   S. and Kingsford, Richard T. and Palutikof, Jean P. and Pickering,
   Catherine M. and Smithers, Scott G.},
Title = {From barriers to limits to climate change adaptation: path dependency
   and the speed of change},
Journal = {ECOLOGY AND SOCIETY},
Year = {2015},
Volume = {20},
Number = {3},
Abstract = {Research on the barriers and limits to climate change adaptation
   identifies many factors, but describes few processes whereby adaptation
   is constrained or may indeed fail to avoid catastrophic losses. It often
   assumes that barriers are by and large distinct from limits to
   adaptation. We respond to recent calls for comparative studies that are
   able to further knowledge about the underlying drivers of barriers and
   limits to adaptation. We compare six cases from across Australia,
   including those in alpine areas, rivers, reefs, wetlands, small inland
   communities, and islands, with the aim of identifying common underlying
   drivers of barriers and limits to adaptation. We find that the
   path-dependent nature of the institutions that govern natural resources
   and public goods is a deep driver of barriers and limits to adaptation.
   Path-dependent institutions are resistant to change. When this
   resistance causes the changes necessary for adaptation to be slower than
   changes in climate, then it becomes a limit to adaptation.},
Publisher = {RESILIENCE ALLIANCE},
Address = {ACADIA UNIV, BIOLOGY DEPT, WOLFVILLE, NS B0P 1X0, CANADA},
Type = {Article},
Language = {English},
Affiliation = {Barnett, J (Corresponding Author), Univ Melbourne, Sch Geog, Melbourne, Vic 3010, Australia.
   Barnett, Jon, Univ Melbourne, Sch Geog, Melbourne, Vic 3010, Australia.
