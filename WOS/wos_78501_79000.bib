@article{ WOS:001878771900001,
Author = {Yenel Guler, Gizem and Koch, Daniel and Bodin Danielsson, Christina},
Title = {Vision shapes workstation choice: examining the relationship between
   visual distractions and employee desk preferences},
Journal = {ERGONOMICS},
Year = {2026},
Month = {2026 SEP 17},
Abstract = {Activity-based flex-offices (AFOs) allow employees to choose their desks
   according to task requirements. While previous studies have examined
   desk choice in AFOs, the role of visual distractions in shaping these
   preferences remains underexplored. This study investigates how visual
   distractions influence employees' desk preferences and identifies
   spatial characteristics associated with preferred desks. Conducted in an
   AFO in Stockholm, Sweden, the study is based on 10 observation sessions,
   14 semi-structured interviews, and spatial analyses using the
   Isovist\_App, a visual analysis tool based on the volume of space
   visible from a point. The findings show that employees consistently
   prefer desks with lower visual distraction: corner desks were associated
   with broader visual access, desks away from aisles with reduced exposure
   to surrounding activity, and desks positioned with their backs to a wall
   with greater visual control. Overall, this study indicates that
   employees' desk preferences in AFOs are associated with their need to
   minimise distractions.},
Publisher = {TAYLOR \& FRANCIS LTD},
