@article{ WOS:001802948000013,
Author = {Utong, Jackson and Othman, Mohd Sham and Victor, Carolina Anak and
   Empati, Favian Anak and Dang, Lim Ban and Aho, Dominic Anak},
Title = {A comparative public health policy analysis of tobacco and vaping
   regulations in Malaysia, Australia, Singapore, and Thailand using the
   WHO MPOWER framework: insights for implementation and legal mapping},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {114},
Month = {JUN},
Abstract = {Introduction: Malaysia's Control of Smoking Products for Public Health
   Act 2024 (Act 852) represents a significant step in addressing rising
   smoking and vaping rates, but its regulatory framework relative to
   international standards remains undocumented. This study systematically
   compares Malaysia's tobacco and vaping regulations with three
   high-performing Asia-Pacific models:Australia, Singapore, and Thailand,
   assessing compliance with WHO Framework Convention on Tobacco Control
   (FCTC) guidelines and identifying variations in policy implementation.
   Methods: A cross-sectional mixed-methods comparative policy analysis was
   conducted. Quantitative assessment applied the WHO MPOWER scoring system
   across six domains (Monitoring, Protection, Offer, Warning, Advertising,
   and Taxation) using a pre-validated checklist and the 2022 WHO MPOWER
   database. The qualitative component involved systematic legal mapping of
   vaping regulations across sales restrictions, core policy approaches,
   and regulatory frameworks, derived from the Tobacco Control Laws
   database and primary national legislation. Results: Malaysia achieved
   full MPOWER compliance with a composite score of 30/37, matching
   Singapore (30/37), but trailing Australia (34/37) and Thailand (32/37).
   Differences were most pronounced in vaping regulations, where Malaysia
   permits sales to adults >= 18 years, contrasting with Australia's
   prescription-only model and outright bans in Singapore and Thailand.
   Differences were also evident in taxation (51.6\% of retail price),
   graphic health warnings (55\% coverage), and cessation support. These
   patterns corresponded with Malaysia's lowest illicit trade control index
   score (50.7/100) and higher age-standardized tobacco use prevalence
   (20.4\%) versus Australia (13.1\%) and Singapore (16.5\%). Conclusion:
   This analysis reveals variations in MPOWER implementation and vaping
   regulatory approaches, highlighting associations between stronger
   taxation and health warnings, and lower prevalence of smoking in
   comparator jurisdictions.},
