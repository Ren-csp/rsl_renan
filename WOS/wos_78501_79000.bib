@article{ WOS:001648051800001,
Author = {Carroza-Pacheco, Ana Maria and Bringas-Molleda, Carolina and
   Leon-del-Barco, Benito},
Title = {Parenting Styles and Key Aspects of Resilience in Secondary Education
   Students},
Journal = {ADOLESCENTS},
