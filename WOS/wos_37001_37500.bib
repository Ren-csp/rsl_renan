@article{ WOS:001788824800001,
Author = {Rojas-Sanchez, J. Vladimir and Coates, Rosamond Ione and Ramirez-Ibanez,
   Marcelino and Lavariega, Mario C. and Luna-Olivera, Beatriz Carely and
   Sanchez-Cordero, Victor and Flores-Martinez, Jose Juan},
Title = {Activity patterns and spatiotemporal dynamics of arboreal mammals in Los
   Tuxtlas, Veracruz, Mexico},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2026},
Volume = {93},
Month = {SEP},
Abstract = {Mammal species show activity patterns related to resting, mating,
   searching and consuming food resources, and establishing intra and
   interspecific behavioral interactions that respond to environmental and
   biotic changes. In particular, spatiotemporal activity patterns have
   been extensively studied in ground-dwelling mammals, but information on
   species of arboreal mammals (SAM) is limited. We used arboreal camera
   trapping to characterize spatiotemporal activity patterns of SAM within
   a large rainforest fragment subject to distinct anthropogenic
   disturbance in Los Tuxtlas Tropical Biology Station. Activity patterns
   and overlap coefficients were assessed using kernel density estimations.
   We performed spatial and temporal partitioning of data to evaluate the
   influence of site-specific environmental characteristics, and
   seasonality. A bootstrap-based network analysis was employed to
   determine the significance of species interactions and to ensure
   non-randomness of the spatiotemporal patterns. Fourteen SAM species were
   recorded exhibiting non-random activity patterns across diurnal and
   nocturnal domains. Spatially, Z1 -subjected to human disturbance-
   emerged as a hotspot of spatiotemporal co-occurrence, where topographic
   and proximity to agricultural matrices compresses the available niche
   dimension. Same-day co-occurrence were more frequent during the rainy
   season suggesting greater interspecific tolerance under higher resource
   availability. Diurnal species shifted toward crepuscular intervals
   during the dry season, consistent with thermal avoidance and energetic
   conservation strategies. These findings provide empirical support for
   the human-induced compression hypothesis and highlight how anthropogenic
   reshapes not only species composition but also the structure of
   interspecific interactions in Neotropical rainforests.},
