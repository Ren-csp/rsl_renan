@article{ WOS:001524470500009,
Author = {Haddad, Richard and Ady, Laszlo and Zhang, Peng},
Title = {THE EFFECT OF WEATHER-DEPENDENT RENEWABLE ENERGY SOURCES ON THE
   OPERATIONAL SAFETY OF CRITICAL OF AN ANTIFRAGILE ENERGY SYSTEM},
