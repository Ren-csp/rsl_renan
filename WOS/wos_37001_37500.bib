@article{ WOS:000521958700001,
Author = {Santiago, Luis and Flores, David and Hong, Chang-Yu},
Title = {The impact of extreme weather events on community risk planning and
   management: the case of San Juan, Puerto Rico after hurricane Maria},
Journal = {URBE-REVISTA BRASILEIRA DE GESTAO URBANA},
Year = {2020},
Volume = {12},
Abstract = {Top-down technical or engineered solutions to deal with flood control
   such as channelization are increasingly unaffordable. We explored how
   community leaders' frame the concept of risk, particularly due to
   flooding, and documented bottom-up rather than top-down solutions within
   the context of Hurricane Maria and the current financial crisis. This
   research aimed to interview environmental conservation organizational
   leaders to assess the broader question of what makes San Juan livable,
   and the role that flooding risk management plays in defining livability.
   Their perception of bottom-up approaches for flood control, including
   the role of green infrastructure, is of particular interest given the
   infeasibility of current engineered measures and their history of short
   term local coping strategies. Our research team frames the research
   using structural versus non-structural solutions to explore to what
   extent community leaders draw upon green visions of the city or
   emphasize transitioning towards strategies more closely aligned with
   ecological processes and functions. The research results help to inform
   current efforts of local community engagement about alternative
   solutions to channelization and other urban flood management measures.},
Publisher = {PONTIFICIA UNIV CATOLICA PARANA-PUCPR},
Address = {RUA IMACULADA CONCEICAO, 1155 PREDIO ADMINISTRACAO 6 ANDAR, CURITIBA,
   80215-901 PR, BRAZIL},
Type = {Article},
Language = {English},
Affiliation = {Santiago, L (Corresponding Author), Univ Cent Florida, Sch Publ Adm, Orlando, FL 32816 USA.
   Santiago, Luis, Univ Cent Florida, Sch Publ Adm, Orlando, FL 32816 USA.
   Flores, David, USDA Forest Serv, Ft Collins, CO USA.
   Hong, Chang-Yu, Jeju Res Inst, Jeju Do, South Korea.},
DOI = {10.1590/2175-3369.012.e20190062},
Article-Number = {e20190062},
ISSN = {2175-3369},
