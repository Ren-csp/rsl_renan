@article{ WOS:001047745300024,
Author = {Jeevan, Kavya and Bonny, Binoo P. and Gopakumar, S.},
Title = {Climate change perspectives and conservation of sacred groves: Case of
   Sharngakavu, Kerala},
Journal = {INDIAN JOURNAL OF TRADITIONAL KNOWLEDGE},
