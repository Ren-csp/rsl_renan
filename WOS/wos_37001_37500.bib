@article{ WOS:001677542000001,
Author = {O'Regan, Margo and McBride, David and Rodda, Simone and Shepherd, Daniel},
Title = {New Zealand military Veterans' perceptions on health and well-being: A
   qualitative study},
Journal = {JOURNAL OF MILITARY VETERAN AND FAMILY HEALTH},
Year = {2026},
Volume = {12},
Number = {2},
Pages = {57-66},
Month = {MAR 1},
Abstract = {Introduction: The study ``The psychological and physical health and
   well-being of New Zealand contemporary Veterans{''} represents one of
   the few large population studies conducted on contemporary Veterans in
   New Zealand. Included in this survey was an open-ended question allowing
   respondents to articulate their thoughts, opinions, or feedback on the
   Veteran experience. Methods: Responses were analyzed using qualitative
   content analysis framework informed by Mayring's (2022) eight-step
   content analysis process. A hybrid deductive-inductive approach was used
   to generate sub-themes from participants' responses, which were
   categorized under the World Health Organization's four domains of
   well-being (psychological, social, environmental, and physical).
   Results: In this study, responses from 1,037 Veterans were analyzed and
   put into 22 sub-themes and four overarching themes. While many
   participants expressed positive gains due to their military service,
   challenges in psychological, social, environmental, and physical
   well-being were evident. Positive outcomes included gaining educational
   achievements, career skills, and personal growth and development.
   Challenges included issues such as posttraumatic stress disorder,
   depression, anxiety, moral injury, identity confusion, internalized
   stigma, stereotyping, the strain of demanding work on family life,
   hearing loss, musculoskeletal problems, and concerns regarding toxic
   chemical exposure. Discussion: Veterans face challenges in all four
   domains of well-being. Despite encountering difficulties, there is a
   reluctance or social stigma associated with Veterans seeking help for
   their well-being concerns, compounding the challenges they face.
   Additionally, Veterans perceive a need for more accessible and effective
   support services.
   Transitioning from military to civilian life presents practical and
   emotional challenges that often impact Veterans' sense of identity,
   health, family relationships, and social acceptance. Many Veterans
   struggle to reintegrate with their families and face difficulties
   accessing civilian support services that may not fully understand their
   unique needs. For this reason, collecting direct feedback from Veterans
   effectively captures both the barriers and supports for a successful
   transition. In this study, 1,037 New Zealand Veterans shared their
   experiences - both the positive outcomes, like gaining new skills,
   education, and personal growth, and the challenges. Veterans reported
   issues such as mental health struggles, identity conflicts, family
   strain, hearing loss, and concerns about exposure to harmful chemicals.
   Despite these well-being challenges across all areas of life, many
   Veterans hesitate to seek help due to social stigma or personal
   reluctance. Veterans strongly expressed the need for better, more
   accessible support services to ease the transition process.
   Introduction : L'\& eacute;tude intitul \& eacute;e The psychological
   and physical health and well-being of New Zealand contemporary Veterans
   repr \& eacute;sente l'une des quelques grandes enqu \& ecirc;tes en
   population r \& eacute;alis \& eacute;es aupr \& egrave;s des v \&
   eacute;t \& eacute;ran.e.s contemporain.e.s de la Nouvelle-Z \&
   eacute;lande. Une question ouverte en faisait partie, afin que les r \&
   eacute;pondant.e.s puissent exprimer leurs r \& eacute;flexions, leurs
   opinions ou leurs commentaires sur l'exp \& eacute;rience des v \&
   eacute;t \& eacute;ran.e.s. M \& eacute;thodologie : Les r \&
   eacute;ponses ont \& eacute;t \& eacute; \& eacute;valu \& eacute;es
   d'apr \& egrave;s un cadre d'analyse de contenu qualitatif \&
   eacute;clair \& eacute; par le processus d'analyse de contenu en huit \&
   eacute;tapes de Mayring (2022). Une approche d \&
   eacute;ductive-inductive hybride a permis de produire des sous-th \&
   egrave;mes \& agrave; partir des r \& eacute;ponses des participant.e.s,
   class \& eacute;es en vertu des quatre domaines de bien-\& ecirc;tre
   (psychologique, social, environnemental et physique) de l'Organisation
   mondiale de la Sant \& eacute;. R \& eacute;sultats : Dans cette \&
   eacute;tude, les r \& eacute;ponses de 1 037 v \& eacute;t \&
   eacute;ran.e.s ont \& eacute;t \& eacute; analys \& eacute;es et r \&
   eacute;parties en 22 sous-th \& egrave;mes et quatre th \& egrave;mes
   principaux. De nombreux participants ont exprim \& eacute; avoir acquis
   des gains gr \& acirc;ce \& agrave; leur service militaire, mais \&
   eacute;prouvaient des difficult \& eacute;s \& eacute;videntes en mati
   \& egrave;re de bien-\& ecirc;tre psychologique, social, environnemental
   et physique. Les r \& eacute;sultats positifs incluaient le niveau
   d'instruction, les comp \& eacute;tences professionnelles ainsi que la
   croissance et le d \& eacute;veloppement personnels. Les difficult \&
   eacute;s incluaient des probl \& egrave;mes comme le trouble de stress
   post-traumatique, la d \& eacute;pression, l'anxi \& eacute;t \&
   eacute;, les blessures morales, la confusion d'identit \& eacute;, la
   stigmatisation internalis \& eacute;e, le st \& eacute;r \&
   eacute;otypage, le fardeau d'un travail exigeant sur la vie familiale,
   la perte auditive, les probl \& egrave;mes musculosquelettiques et les
   pr \& eacute;occupations d \& eacute;coulant de l'exposition \& agrave;
   des produits chimiques toxiques. Discussion : Les v \& eacute;t \&
   eacute;ran.e.s font face \& agrave; des d \& eacute;fis dans les quatre
   domaines du bien-\& ecirc;tre. Pourtant, une r \& eacute;ticence ou une
   stigmatisation sociale est associ \& eacute;e aux v \& eacute;t \&
   eacute;ran.e.s qui r \& eacute;clament de l'aide pour leur mal-\&
   ecirc;tre, laquelle s'ajoute \& agrave; leurs difficult \& eacute;s. De
   plus, les v \& eacute;t \& eacute;ran.e.s affirment avoir besoin de
   services de soutien plus efficaces et plus accessibles.},
