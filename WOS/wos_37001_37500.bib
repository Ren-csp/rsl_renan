@article{ WOS:000361421200022,
Author = {Pate, Russell R. and McIver, Kerry L. and Colabianchi, Natalie and
   Troiano, Richard P. and Reis, Jared P. and Carroll, Dianna D. and
   Fulton, Janet E.},
Title = {Physical Activity Measures in the Healthy Communities Study},
Journal = {AMERICAN JOURNAL OF PREVENTIVE MEDICINE},
