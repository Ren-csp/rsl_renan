Title = {Wellness Tour for Tribal Communities During the COVID-19 Pandemic:
   Uniting Sacred Space with Western Medicine to Prevent Substance Use},
Journal = {JOURNAL OF COMMUNITY HEALTH},
Year = {2024},
Volume = {49},
