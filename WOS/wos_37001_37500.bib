Language = {English},
Affiliation = {CORNELL UNIV, DEPT PSYCHOL, ITHACA, NY 14853 USA.
   UNIV MICHIGAN, ANN ARBOR, MI 48109 USA.},
DOI = {10.3758/BF03205895},
ISSN = {0031-5117},
Research-Areas = {Psychology},
Web-of-Science-Categories  = {Psychology; Psychology, Experimental},
Affiliations = {Cornell University; University of Michigan System; University of
   Michigan},
ResearcherID-Numbers = {/R-5652-2019
   /A-7488-2009
