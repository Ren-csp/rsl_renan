@article{ WOS:000368704700005,
Author = {Almeida, Antonio and Vasconcelos, Clara},
Title = {Geoethics: Master's Students Knowledge and Perception of Its Importance},
Journal = {RESEARCH IN SCIENCE EDUCATION},
