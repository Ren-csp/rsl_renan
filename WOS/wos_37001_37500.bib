@article{ WOS:001008228100001,
Author = {Wang, An and Weichenthal, Scott and Lloyd, Marshall and Hong, Kris and
   Saxe, Shoshanna and Hatzopoulou, Marianne},
Title = {Personal Mobility Choices and Disparities in Carbon Emissions},
