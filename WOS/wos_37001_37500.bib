@article{ WOS:000707780100001,
Author = {Garrido Corredor, Ana Maria and Cottyn, Hanne and Martinez-Medina,
   Santiago and Wheatley, Christopher J. and Sanchez, Adriana and Kirshner,
   Joshua and Cowie, Helen and Touza-Montero, Julia and White, Piran C. L.},
Title = {Oso, Osito A Que Venis? Andean Bear Conflict, Conservation, and
   Campesinos in the Colombian Paramos},
Journal = {SUSTAINABILITY},
Year = {2021},
Volume = {13},
Number = {19},
Month = {OCT},
Abstract = {This article proposes a historical, multispecies, and ontological
   approach to human-wildlife conflict (HWC) in the Colombian paramos.
   Focusing on the paramos surrounding the capital city of Bogota, we
   reconstruct the historically changing relationship between
   cattle-farming campesino communities and the Andean bear, Tremarctos
   ornatus. Using ethnographic and historical research methods, we
   conceptualise this relationship as embedded in localised landscapes and
   multispecies assemblages, in which scientists, conservation
   practitioners, water infrastructures, public environmental agencies, and
   cows participate as well. This article demonstrates that insufficient
   attention to the practices and relationships of historically
   marginalised humans and non-humans in the management of HWCs contributes
   to new dynamics of exclusion and friction, and can reduce the
   effectiveness of conservation programmes. We conclude that opening up
   conservation to the interests and knowledges of local communities is
   imperative in moving towards more historically informed, pluralistic and
   effective conservation strategies.</p>},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Corredor, AMG (Corresponding Author), Inst Invest Recursos Biol Alexander von Humboldt, Programa Ciencias Sociale \& Saberes Biodiversidad, Bogota 110321, Colombia.
   Garrido Corredor, Ana Maria; Martinez-Medina, Santiago, Inst Invest Recursos Biol Alexander von Humboldt, Programa Ciencias Sociale \& Saberes Biodiversidad, Bogota 110321, Colombia.
