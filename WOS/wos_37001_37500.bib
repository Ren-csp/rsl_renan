@article{ WOS:001760445800001,
Author = {Buttazzoni, Adrian and Smith, Lindsey and Minaker, Leia},
Title = {``Negative energy is released with the help of sports and
   activities{''}: Exploring adolescents' `health capital' in high-density
   areas},
Journal = {SSM-QUALITATIVE RESEARCH IN HEALTH},
Year = {2026},
Volume = {9},
Month = {JUN},
Abstract = {Despite growing interest in urbanization and health, little is known
   about how high-rise and high-density neighbourhoods affect adolescent
   health. To conduct a novel, in-depth investigation, we applied the
   concept of `health capital' (i.e., resources individuals can use that
   impact their health) to explore this relationship. Six focus groups and
   participatory geomapping activities with adolescents (n = 19) in two
   Canadian cities (Kitchener-Waterloo, Toronto) explored adolescent health
   capital, by way of several real-world expressions and cases, in relation
   to their high-rise residences and high-density urban neighbourhoods. Our
   findings delineate specific health processes related to distinct skills
   (e.g., `aptitude for place maximization') and competencies (e.g.,
   `environmental stress dysregulation') as contributing to the
   actualization and nonfulfillment of desired health outcomes. Social
   relationships and status (e.g., `play, cohesive milieu') and financial
   means (e.g., `building expenses, lack of investment') were likewise
   expressed as contributing to health-generating and -degrading
   opportunities and experiences for adolescents in high-density contexts.
   The development and application of these health capital components can
   inform adolescent perspectives and usage patterns of high-rise designs
   (e.g., lobbies, corridors) and surrounding high-density spaces (e.g.,
   community centers, parks), as well as suggest possible healthy community
   design for adolescent life course development (e.g., local places that
   encourage independence, public designs that reduce adolescent
   disharmony). Future research should quantify associations between
   high-rise designs and spaces and the concept of health capital to
   clarify these relationships.},
