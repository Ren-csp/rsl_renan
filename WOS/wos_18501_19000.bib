@article{ WOS:000592173500004,
Author = {Chen, Chi and Li, Dan and Li, Yue and Piao, Shilong and Wang, Xuhui and
   Huang, Maoyi and Gentine, Pierre and Nemani, Ramakrishna R. and Myneni,
   Ranga B.},
Title = {Biophysical impacts of Earth greening largely controlled by aerodynamic
   resistance},
Journal = {SCIENCE ADVANCES},
Year = {2020},
Volume = {6},
Number = {47},
Month = {NOV},
Abstract = {Satellite observations show widespread increasing trends of leaf area
   index (LAI), known as the Earth However, the biophysical impacts of this
   greening on land surface temperature (LST) remain unclear. Here,
   quantify the biophysical impacts of Earth greening on LST from 2000 to
   2014 and disentangle the contributions of different factors using a
   physically based attribution model. We find that 93\% of the global
   vegetated area shows negative sensitivity of LST to LAI increase at the
   annual scale, especially for semiarid woody vegetation. Further
   considering the LAI trends (P <= 0.1), 30\% of the global vegetated area
   is cooled by these trends and 5\% is warmed. Aerodynamic resistance is
   the dominant factor in controlling Earth greening's biophysical impacts:
   The increase in LAI produces a decrease in aerodynamic resistance,
   thereby favoring increased turbulent heat transfer between the land and
   the atmosphere, especially latent heat flux.},
