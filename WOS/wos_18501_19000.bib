@article{ WOS:001767109700003,
Author = {Begnini, Flavia and Wolff, Luciano Lazzarini and Lopes, Taise Miranda
   and Teixeira-de-Mello, Franco and Delariva, Rosilene Luciana},
Title = {Immediate effects of channelization on fish assemblages in two urban
   tropical streams},
Journal = {NEOTROPICAL ICHTHYOLOGY},
Year = {2025},
Volume = {23},
Number = {4},
Abstract = {Stream channelization is a common practice in urban areas. However, this
   intervention can strongly alter environmental conditions and aquatic
   communities. This study evaluated the immediate effects of
   channelization on fish assemblages by semi-experimentally assessing two
   Neotropical urban streams. We hypothesized that habitat modifications,
   such as riparian vegetation removal, channel impermeabilization, and
   straightening, would reduce species richness, abundance, and biomass.
   Sampling was conducted before, during, and after channelization. At each
   site, hydrological, physical, and chemical variables, along with habitat
   features, were measured. Fish assemblages were sampled by electrofishing
   along 60-m stretches. Species rarefaction curves, the ABC index, db-RDA,
   and linear models were applied to detect changes in richness, dominance,
   and abundance relative to environmental variables. Results showed that
   channelized sites exhibited higher water temperature, lower dissolved
   oxygen, reduced depth, and increased channel width and flow. Biotic
   responses revealed immediate effects, with decreased richness and
   biomass of sensitive species and greater abundance of small, and
   tolerant species. Even six months after completion of the works, species
   richness had not recovered to prechannelization levels. Negative effects
   were consistent across both streams. Our findings confirm that
   channelization significantly alters habitat conditions and immediately
   impacts fish assemblages, reducing diversity and favoring tolerant taxa.
   These results highlight the ecological costs of channelization and
   reinforce the need for conservation and management strategies that
   mitigate its effects on urban freshwater ecosystems.},
