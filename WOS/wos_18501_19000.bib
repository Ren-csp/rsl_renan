@article{ WOS:000450726000002,
Author = {Covino, Tim and Golden, Heather E. and Li, Hong-Yi and Tang, Jinyun},
Title = {Aquatic Carbon-Nutrient Dynamics as Emergent Properties of Hydrological,
   Biogeochemical, and Ecological Interactions: Scientific Advances},
Journal = {WATER RESOURCES RESEARCH},
