@article{ WOS:000510746200015,
Author = {Vidovic, Petra and Rupcic, Stjepko},
Title = {Mandala Patterns in Nature Incentives for Artistic Expression and
   Possible Development of the Intuitive Nature of Awareness in a Preschool
   Child},
Journal = {CROATIAN JOURNAL OF EDUCATION-HRVATSKI CASOPIS ZA ODGOJ I OBRAZOVANJE},
