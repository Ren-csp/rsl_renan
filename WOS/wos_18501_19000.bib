   Lee, Kyoung-Min, Seoul Natl Univ, Interdisciplinary Program Cognit Sci, Seoul 110744, South Korea.
   Lee, Kyoung-Min, Seoul Natl Univ, Dept Neurol, Seoul 110744, South Korea.},
DOI = {10.3389/fnhum.2013.00540},
