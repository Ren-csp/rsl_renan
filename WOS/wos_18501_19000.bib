@article{ WOS:001544165800001,
Author = {Sjoholm, Jennie},
Title = {Kiruna: The Arctic town that forgot about winter},
Journal = {URBAN DESIGN INTERNATIONAL},
Year = {2026},
Volume = {31},
Number = {2, SI},
Pages = {58-70},
Month = {JUN},
Abstract = {Northern Sweden is currently undergoing extensive urban development,
   driven by industrialisation, climate change, and the European Union's
   Green Deal. A crucial factor for success in these developments is
   creating attractive cities that can retain existing populations and
   attract new residents, supporting industries that depend on recruiting
   workers through high-quality urban environments. This article examines
   how the mining town Kiruna draws upon its historical identity as a
   `winter city' to address microclimatic challenges within its ongoing
   urban transformation. Historically, Kiruna's original town plan was
   strategically designed to provide shelter from wind and create
   comfortable outdoor spaces. Additionally, Ralph Erskine's projects from
   the 1960s were notably climate-responsive. In contrast, the newly
   relocated town centre is situated in a colder, less sheltered area, and
   its higher-density layout has reduced solar access. Despite these
   limitations, certain design elements still reflect traditional winter
   city principles.},
