@article{ WOS:001097575400001,
Author = {Wang, Yaohua and Xia, Peng and Liu, Jun},
Title = {Research on Green and Low-Carbon Development Path of the Electric Power
   Industry},
Journal = {CHINESE JOURNAL OF URBAN AND ENVIRONMENTAL STUDIES},
Year = {2023},
Volume = {11},
Number = {02},
Month = {JUN},
Abstract = {In the analogy where achieving the ``carbon peaking and carbon
   neutrality{''} goals (the ``dual carbon{''} goals) is compared to a
   battle, energy is the main battlefield, and electric power the main
   force. The low-carbon transformation path of the electric power industry
   exerts fundamental impact on progress towards carbon peaking and carbon
   neutrality of the whole society. Therefore, this paper first analyzes
   challenges and opportunities faced by the electric power industry to
   achieve the ``dual carbon{''} goals; secondly, on the basis of deep
   low-carbon, zero-carbon and negative-carbon scenarios of the electric
   power industry, this paper quantifies and delves into the consumption
   structure of primary energy and final energy, as well as the future
   development positioning and trend of different categories of energy.
   Based on the research results, this paper proposes low-carbon
   transformation path of the electric power system at the stages of carbon
   peaking, deep low-carbon and carbon neutrality, and analyzes the trend
   of power supply cost changes in different scenarios. On this basis, a
   series of implementation key points and measures are proposed to adapt
   to green and low-carbon transformation of the electric power industry,
   covering areas such as coal-fired electric power development
   positioning, new energy development and utilization, diversified supply
   and demand, new energy industry chain, and power supply costs, and so
   forth.},
