@article{ WOS:001860545400001,
Author = {Purcahyono, Joko and Tuwo, Ambo and Akil, Arifuddin and Bulkis, Sitti
   and Busthanul, Nurbaya and Demmallino, Eymal Bahsar},
Title = {Spatial and multi-criteria assessment of green infrastructure
   development for sustainable tourism around Sentani Lake},
Journal = {FRONTIERS IN SUSTAINABLE TOURISM},
Year = {2026},
Volume = {5},
Month = {AUG 13},
Abstract = {Sentani Lake in Papua Province is a unique ecological and socio-cultural
   landscape facing increasing pressures from land-use change,
   sedimentation, and unplanned tourism. This study develops a sustainable
   tourism framework by integrating spatial analysis, green infrastructure,
   and community-based approaches. A mixed-methods design combined
   GIS-based analysis with SWOT and the Analytical Hierarchy Process (AHP),
   using Sentinel-2 imagery, digital elevation models, environmental
   datasets, field surveys, and stakeholder interviews across a 1,355.9 km2
   study area. The GIS results reveal contrasting spatial conditions,
   ranging from high-value conservation and cultural tourism zones to
   degraded and vulnerable areas requiring ecological restoration. The
   Internal-External matrix produced an IFE score of 3.49 and an EFE score
   of 2.75, placing Sentani Lake in Quadrant II, or the ``Hold and
   Maintain{''} position. This indicates strong internal ecological and
   socio-cultural potential but moderate external capacity due to
   institutional, environmental, and infrastructure constraints. AHP
   prioritization identified renewable energy investment as the
   highest-ranked strategy (S-T-1 = 0.0867), followed by green building
   adoption (S-O-1 = 0.0832) and digital infrastructure strengthening
   through partnerships (W-O-4 = 0.0818). These findings indicate that
   sustainable tourism development in Sentani Lake should prioritize
   ecological resilience, institutional strengthening, low-impact
   infrastructure, and indigenous community collaboration. Integrating
   spatial planning, environmental restoration, digital monitoring, and
   local cultural governance is essential for building resilient and
   inclusive lake-based tourism development.},
