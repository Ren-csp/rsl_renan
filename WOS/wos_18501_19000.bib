@article{ WOS:001766150900001,
Author = {Miranda, Temi Indriati and Listiani, Nurlia and Purwono, Nugroho and
   Kusumaningrum, Dwiyanti and Yossa, Nirma and Suhodo, Diah Setiari},
Title = {Informality and social innovation: The survival strategy of neglected
   communities in Jakarta's East Flood Canal},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {2},
Pages = {629-640},
Month = {JUN},
Abstract = {Urban informality in the Global South plays a crucial role in
   facilitating economic survival and community resilience. However,
   informal actors often operate in regulatory grey areas, lacking
   governmental recognition. This study examines how such actors along
   Jakarta's East Flood Canal (KBT), Indonesia, perceive and adapt to
   unclear governance conditions, providing perspectives that challenge
   traditional urban planning, which prioritizes formal development. Based
   on two months of ethnographic fieldwork, including 15 semi-structured
   interviews and field observations, the findings demonstrate that
   informal practices such as street vending and urban farming are crucial
   for enhancing their livelihoods and the urban ecosystem in KBT areas.
   These informal practices create green spaces, support food security, and
   strengthen the local identity of urban informality actors. However,
   despite their contributions, they face constant challenges, including
   eviction threats and exclusion from the government's support and
   protection, due to inconsistency in law enforcement. Despite this, they
   exhibit resilience through adaptive strategies and social innovation by
   optimizing the spatial landscape and creating community networks to
   maintain legitimacy. The study advocates for more inclusive urban
   governance planning that legally recognizes informal systems, integrates
   them spatially, and involves communities in participatory planning
   processes.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
