@article{ WOS:001842681100002,
Author = {Vitorino, Breno Dias and da Frota, Angelica Vilas Boas and Arruda, Maria
   Antonia do Nascimento and Vacchiano, Marcelo Caetano and Nunes, Josue
   Ribeiro da Silva and da Silva, Carolina Joana},
Title = {Effects of climate change: an overview of perceptions, vulnerabilities
   and adaptations in the northern Pantanal wetland integrated with
   long-term climate data},
Journal = {CLIMATIC CHANGE},
Year = {2026},
Volume = {179},
Number = {8},
Month = {AUG 6},
Abstract = {Climate change poses significant socio-environmental challenges,
   particularly in sensitive ecosystems such as wetlands. In this context,
   this study assesses the perceptions, impacts, and adaptive strategies of
   local communities in response to climate change in the Pantanal wetland,
   Brazil. We conducted semi-structured interviews in two sampling cycles,
   12 years apart (2012 and 2024), to analyze temporal changes in
   socio-environmental vulnerability. In addition, we examined historical
   temperature and precipitation data from the past 50 years to compare
   climate trends with local perceptions. Our findings indicate reduced
   rainfall, increased prolonged droughts, and associated impacts that
   directly and indirectly compromise residents' quality of life.
   Perceptions of climate change have intensified, with 100\% of
   respondents in 2024 reporting worsening conditions, particularly rising
   temperatures and increased precipitation unpredictability. The most
   affected sectors were health, fisheries, and agriculture, with notable
   declines in outdoor activities. Adaptive responses increased from 70\%
   to 90\% of respondents, emphasizing adjustments in planting periods,
   working hours, and selection/reduction of cultivated species. Historical
   climate data has confirmed a significant increase in temperature and a
   decrease in precipitation over the past 50 years, with 2023 being the
   warmest year on record. Despite the adaptive dynamism of local
   communities, current strategies may be insufficient to deal with
   worsening climate conditions. Increasing socio-environmental
   vulnerability highlights the urgent need for inclusive public policies
   that integrate scientific knowledge and traditional practices to
   increase resilience. Strengthening climate governance through technical
   support and sustainable economic initiatives is essential to safeguard
   livelihoods and ensure socio-ecological sustainability and quality of
   life for Pantanal peoples.},
