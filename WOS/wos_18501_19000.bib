@article{ WOS:001145336600001,
Author = {Gonzalez, Carlos Alejandro Custodio and Salazar, Tania Ortiz and Perez,
   Patricia Medina},
Title = {Socio-spatial segregation of socio-environmental assets of public green
   spaces in the city of Durango, Mexico},
Journal = {NOESIS-REVISTA DE CIENCIAS SOCIALES Y HUMANIDADES},
Year = {2024},
Volume = {33},
Number = {65},
Pages = {4-21},
Month = {JAN-JUN},
Abstract = {The current development model's accumulation logic has resulted in the
   emergence and con-solidation of social processes like segregation,
   leading to differentiated access and availability of urban goods and
   services among social groups based on socioeconomic, ethnic, or societal
   standing. The current development model's accumulation logic has
   resulted in the emergence and consolidation of social processes like
   segregation, leading to differentiated access and availability of urban
   goods and services among social groups based on socioeconomic, eth-nic,
   or societal standing. This disparity impacts employment levels,
   educational performance, urban decay, and environmental degradation. In
   this context, the article aims to examine the socio-spatial segregation
   in the access to socio-environmental amenities provided by public green
   spaces (EVP) in a medium-sized city, specifically Durango, Mexico. The
   analysis utilizes spatial analysis and statistical methods that involve
   five variables associated with EVPs: surfa-ce area, percentage, number,
   density, and the socioeconomic level of the population. A spatial
   pattern of segregation was identified through these variables, resulting
   in four clusters that impact how the city of Durango is inhabited,
   produced, reproduced, lived, and constructed.},
