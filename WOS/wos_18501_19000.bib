@article{ WOS:001719484200001,
Author = {Ye, Long and Long, Tengfei and Jiao, Weili and Adam, Elhadi and Chu,
   Lixia and He, Guojin and Zhang, Zhaoming and Wang, Guizhou},
Title = {Fairly assessing nighttime urban cooling performance with a novel
   satellite-based index},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {141},
Month = {MAY 1},
Abstract = {With accelerating urbanization, the conventional methods for assessing
   the Urban Heat Island (UHI) effect struggle to fairly compare cooling
   benefits across areas with vastly different development intensities.
   This study addresses this challenge by introducing a novel Cooling
   Benefit Index (CBI) based on synchronous thermal infrared (TIR) and
   nighttime light (NTL) data from the SDGSAT-1 satellite. Focusing on five
   major Chinese cities, we developed a baseline nighttime Land Surface
   Temperature (LST) model using only NTL and elevation data (DEM) to
   represent a theoretical thermal environment driven solely by human
   activity and topography. The CBI, calculated as the residual between
   this predicted and the actual LST, effectively isolates and quantifies
   the nighttime cooling performance of landscape features. Our findings
   reveal a non-linear cooling response in the summer urban cores (high
   NTL): NDVI exhibits a characteristic threshold of approximately 0.40,
   above which the marginal cooling efficiency increases markedly.
   Furthermore, the regulatory role of vegetation spatial heterogeneity on
   cooling benefits shows significant seasonal dependency, exhibiting a
   synergistic enhancement with vegetation coverage in summer, which
   contrasts with a potential weakening effect in winter. By standardizing
   cooling assessments against an anthropogenic baseline, the proposed CBI
   offers an equitable tool for urban planners to optimize UHI mitigation
   strategies, providing robust scientific support for Sustainable
   Development Goal 11 (SDG11).},
