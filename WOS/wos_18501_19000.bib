@article{ WOS:001821342700001,
Author = {Fitri, Husnul and Utaberta, Nangkula},
Title = {What matters most in inclusive smart green spaces: Accessibility and
   smart technology needs of people with disabilities in
   technology-enhanced urban green spaces},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {31},
Month = {AUG},
Abstract = {Access to urban green spaces is a key factor influencing public health,
   well-being, and social inclusion. However, people with disabilities
   continue to face significant barriers when engaging with outdoor public
   environments. While existing research has predominantly focused on
   physical accessibility, limited attention has been given to the role of
   smart and technology-enhanced features in promoting independent and
   equitable access for disabled users. This study addresses this gap by
   exploring which accessibility and smart technology features in urban
   green spaces people with disabilities consider most important.
   Quantitative importance ratings were gathered from 84 respondents with
   physical and sensory disabilities who were surveyed to evaluate priority
   needs across the dimensions of the Disability-Inclusive Index for
   Technology-Enhanced Urban Green Spaces (DII-TEUGS). These include four
   dimensions: Physical Facility \& Mobility (PFM), Multisensory Wayfinding
   (MSW), Safety and Smart ICT (SSI), and Digital Inclusivity (DI). All
   dimensions are rated as essential for enabling independent, safe, and
   meaningful participation in public green environments, though there are
   small differences between physical and sensory disabilities. By
   emphasizing disability perspectives, this research highlights the
   importance of integrating universal and inclusive design principles with
   smart and ICT-based innovations in urban green space planning to
   maximize benefits for everyone. The findings contribute to the
   development of smart urban green spaces and provide an evidence-based
   foundation for adopting urban technologies in green space design.},
