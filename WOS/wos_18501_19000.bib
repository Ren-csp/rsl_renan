@article{ WOS:001845774200001,
Author = {Kwakye, Isaac Nyarko and Oware, Ebenezer Owiredu and Adom-Fynn, Daniel
   and Roberts, Charity Odumale and Antwi, Adwoa Oforiwa and Agyei, Samuel
   Dwamena and Vondee, Shadrach Edemor and Opoku-Mensah, Kwabena and
   Kugbey, Nuworza},
Title = {The perception of sexual enhancers and sex toys among university
   students in Ghana},
Journal = {DISCOVER SOCIAL SCIENCE AND HEALTH},
Year = {2026},
Volume = {6},
Number = {1},
Month = {JUN 7},
Abstract = {Background This study explored the perceptions of sexual enhancers and
   sex toys among university students in Ghana, with the aim of
   understanding their awareness, perceived effects, influencing factors,
   and educational needs.Methods Guided by a qualitative exploratory
   approach, convenience sampling was used to select 45 students from three
   universities in Ghana. Data were collected through semi-structured,
   one-on-one interviews and were thematically analyzed in line with Braun
   and Clarke (2006) approach.Results Four main themes emerged from the
   findings: Awareness and knowledge continuum, where participants ranged
   from surface-level awareness to more developed, functionally grounded
   knowledge, with a notable progression from mere recognition to nuanced
   understanding among those with personal or close-peer experience. The
   perceived effects theme highlighted both perceived benefits, such as
   improved intimacy, confidence, relationship support, and risks,
   including potential infections, dependency, and unrealistic
   expectations. The socio-cultural and psychological determinants theme
   emphasized the influence of peer and relationship pressure, cultural
   stigma, curiosity, self-esteem, and limited access to credible
   information, with many participants relying on social media and peer
   discussions. Finally, the recommended educational strategies theme
   emphasized the need for open, non-judgmental dialogue through workshops,
   seminars, and curriculum integration to promote accurate knowledge and
   responsible attitudes.Conclusion Participants' perceptions of sexual
   enhancers and sex toys were shaped by a complex interplay of personal
   curiosity, socio-cultural norms, and inadequate education. The study
   calls for culturally sensitive, evidence-based sexual health education
   programmes within university settings to enhance awareness, dispel
   misconceptions, and foster healthy, informed decision-making among
   students.},
