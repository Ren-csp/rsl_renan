@article{ WOS:001678701400001,
Author = {Yang, Zi and Zhou, Ren and Zhao, Xinzhe and Siu, Kin Wai Michael},
Title = {Unpacking the `child-centred' myth: creating truly inclusive playgrounds
   in urban spaces},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2026},
Month = {2026 FEB 4},
Abstract = {This study examines how entrenched design habits constrain inclusivity
   in urban playgrounds in high-density cities like Hong Kong. Using the
   Tuen Mun Park Inclusive Playground as a case, it proposes a dual-path
   framework that links stakeholder engagement with GIS-based SOPARC
   behavioural observation (implemented using QGIS 3.38, Grenoble) to
   diagnose behaviour-space mismatches. Findings reveal under-supported
   needs among caregivers and other peripheral users, alongside uneven
   activation of designated supportive zones. A case-based
   Behaviour-Space-Design (BSD) mapping matrix translates these patterns
   into actionable spatial strategies. The dual-path framework offers a
   recursive, transferable approach for evaluating and optimizing inclusive
   public play spaces.},
