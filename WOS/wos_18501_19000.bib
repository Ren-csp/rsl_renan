@article{ WOS:001856718800001,
Author = {Moon, Junghyun and Lee, Taeyoung},
Title = {Dual illusion of informational self-sufficiency and its implications for
   verification and truth recognition: The interplay of news-finds-me and
   third-person perceptions},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2027},
Volume = {186},
Month = {JAN},
Abstract = {This study investigates whether third-person perception (TPP) and
   news-finds-me perception (NFMP) jointly constitute a ``dual illusion of
   informational self-sufficiency.{''} Distinguishing between perceived
   difference and perceptual bias as forms of TPP, we define the former as
   self-other gaps mixing real competence with self-serving bias, and the
   latter as unjustified overconfidence in detecting misinformation. Using
   two-wave panel data (N = 896), we examine their independent and
   interactive associations with verification and truth recognition.
   Results partially support the proposed synergy: NFMP alone does not
   deter verification, but combined with perceptual bias, it predicts lower
   verification.},
