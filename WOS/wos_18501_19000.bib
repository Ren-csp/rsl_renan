@article{ WOS:001593235700001,
Author = {Wallinder, Ylva},
Title = {Commodification of urban sustainability projects: urban gardening in
   Gothenburg as a collaborative practice or a risky and individualised
   career opportunity},
Journal = {LOCAL ENVIRONMENT},
Year = {2026},
Volume = {31},
Number = {9},
Pages = {1559-1575},
Month = {SEP 2},
Abstract = {The United Nations Agenda for Sustainable Development 2030 aims for
   inclusion, safety, resilience and sustainability in urban residential
   areas. The Gothenburg City Council has pursued these goals over the past
   decade, focusing on urban gardening. Urban gardens have been described
   as potential spaces for improved urban social well-being and socially
   inclusive green growth, thus enabling the combination of the social and
   commercial aspects of sustainability practices. Over the past decade,
   the municipal focus has shifted from associational urban gardening to
   entrepreneurial gardening, emphasising individual farming on municipal
   land. This focus was described as a new opportunity for residents to
   support themselves financially, as city gardening can provide an income.
   As a result, entrepreneurial gardeners have grown in numbers. In this
   study, I focus on the consequences of a commodification of urban
   sustainability projects, including food production and residents'
   labour. Furthermore, I analyse how socio-economic resources and social
   relations limit - or strengthen - the entrepreneurial gardening
   practices and the life quality of participants. In the analysis, I
   discuss how the municipalities' new scheme, ``from garden box to
   hectare,{''} have encouraged local citizen to participate in
   entrepreneurial training activities (e.g. how to think like an
   entrepreneur) while participating in municipal gardening classes.
   Furthermore, I show that due to the perceived competition among
   gardeners, urban gardening is turned into a very lonely, precarious, and
   individualised activity compared with the formalised associational
   gardening activities previously promoted by the municipality. This
   highlights a mismatch between the local government's sustainability
   visions and the gardener's reality.},
