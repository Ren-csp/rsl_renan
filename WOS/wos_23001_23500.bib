@article{ WOS:000714900700001,
Author = {Turkoglu, Ayse Yenilmez and Aydin, Fatih and Es, Huseyin},
Title = {Science teacher's perceptions of the nature of technology: a
   Q-methodology study},
Journal = {INTERNATIONAL JOURNAL OF TECHNOLOGY AND DESIGN EDUCATION},
