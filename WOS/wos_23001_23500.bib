@article{ WOS:000424825900016,
Author = {Kross, Sara M. and Ingram, Katherine P. and Long, Rachael F. and Niles,
   Meredith T.},
Title = {Farmer Perceptions and Behaviors Related to Wildlife and On-Farm
   Conservation Actions},
Journal = {CONSERVATION LETTERS},
Year = {2018},
Volume = {11},
Number = {1},
Month = {JAN-FEB},
Abstract = {Policy makers are increasingly encouraging farmers to protect or enhance
   habitat on their farms for wildlife conservation. However, a lack of
   knowledge of farmers' opinions toward wildlife can lead to poor
   integration of conservation measures. We surveyed farmers to assess
   their perceptions of ecosystem services and disservices from perching
   birds, raptors, and batsthree taxa commonly targeted by conservation
   measures. The majority of farmers thought that perching birds and bats
   were beneficial for insect pest control and that raptors were beneficial
   for vertebrate pest control; however, fruit farmers viewed perching
   birds more negatively than did farmers growing other crops. Farmers
   using organic methods viewed all three wildlife groups more positively
   than conventional farmers. Farmer perception toward each wildlife group
   predicted their action to either attract or deter those taxa, suggesting
   the need to focus research and outreach on the effects of wildlife on
   farms for conservation programs to positively influence farmer
   perceptions.},
