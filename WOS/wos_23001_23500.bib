@article{ WOS:000362491200015,
Author = {Peprah, Dorothy and Baker, Kelly K. and Moe, Christine and Robb,
   Katharine and Wellington, Nii and Yakubu, Habib and Null, Clair},
Title = {Public toilets and their customers in low-income Accra, Ghana},
Journal = {ENVIRONMENT AND URBANIZATION},
