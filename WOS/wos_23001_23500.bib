Author = {Bele, Bolette and Nielsen, Veronique Karine Simon and Fairclough, Graham
   and Herring, Peter},
Title = {A Heritage Without Boundaries: Nature-Culture Synergies in and around
   Norwegian Protected Landscapes},
Journal = {HUMAN ECOLOGY},
Year = {2024},
Volume = {52},
Number = {1},
Pages = {155-172},
Month = {FEB},
Abstract = {We address the question of nature-culture synergies in protected
   mountain landscapes with a specific focus on the Norwegian National Park
   of Hardangervidda. Fragile and complex ecosystems developed from
   long-lasting socio-ecological grazing processes that started
   approximately 4000 years ago in Scandinavia are facing manifold
   environmental challenges and societal issues that endanger both natural
   and cultural heritages. Our goals are to clarify the nature-culture
   synergies and relationships and investigate holistic management and
   preservation of natural and cultural values. Our results highlight an
   urgent need to develop holistic conservation frameworks and
   methodologies for protected landscapes that integrate cultural and
   natural heritages and enhance the potential of local communities to
   protect threatened semi-natural environments and experienced-based
   knowledge for the future.},
