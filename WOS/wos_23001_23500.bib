@article{ WOS:000621215400002,
Author = {Giurfa, Martin},
Title = {Learning of sameness/difference relationships by honey bees:
   performance, strategies and ecological context},
Journal = {CURRENT OPINION IN BEHAVIORAL SCIENCES},
Year = {2021},
Volume = {37},
Number = {SI},
Pages = {1-6},
Month = {FEB},
Abstract = {Humans and non-human primates learn conceptual relationships such as
   `same' and `different, which have to be encoded independently of the
   physical nature of objects linked by the relation. Consequently,
   concepts are associated with high-level cognition and are not expected
   in an insect brain. Yet, various works have shown that the miniature
   brain of honey bees also learns the conceptual relationships of sameness
   and difference and transfers these relationships to novel stimuli. We
   review evidence about sameness/difference learning in bees and analyze
   its adaptive value within an ecological context. The experiments
   reviewed cannot be accounted for by low-level strategies and challenge,
   therefore, the traditional view attributing supremacy to larger brains
   when it comes to the elaboration of concepts.},
