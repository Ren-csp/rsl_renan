   Wyss, Annika M.; Knoch, Daria, Univ Bern, Dept Social Neurosci \& Social Psychol, Bern, Switzerland.
   Berger, Sebastian, Univ Bern, Dept Sociol, Bern, Switzerland.},
DOI = {10.1016/j.jenvp.2023.102160},
EarlyAccessDate = {OCT 2023},
Article-Number = {102160},
ISSN = {0272-4944},
EISSN = {1522-9610},
Keywords-Plus = {PLURALISTIC IGNORANCE; CLIMATE-CHANGE; PSYCHOLOGY; ONLINE},
Research-Areas = {Environmental Sciences \& Ecology; Psychology},
