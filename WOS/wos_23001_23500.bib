@article{ WOS:001759137900001,
Author = {Chai, Q. G. and Zhao, Y. X. and Yu, H. X. and Zhang, Y. X.},
Title = {LINKING HUMAN DISTURBANCE TO BENTHIC MACROINVERTEBRATE COMMUNITY CHANGES
   IN COLD REGIONS: A BASIS FOR TARGETED RIVER ECOLOGICAL MANAGEMENT},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {3931-3949},
Abstract = {The impact of human activities on freshwater ecosystems is a critical
   issue in contemporary freshwater ecology. Benthic macroinvertebrates,
   including aquatic insects, are particularly sensitive to such
   disturbances. This study aimed to uncover differences in the response
   mechanisms of benthic communities to environmental factors like
   nutrients under varying levels of disturbance in cold regions. We
   established 57 monitoring stations to collect water quality and benthic
   fauna samples and employed Spearman correlation analysis, Redundancy
   Analysis (RDA), and Generalized Additive Model (GAM) to explore the
   relationships between community diversity characteristics and
   environmental factors. Our findings confirmed the hypothesis that
   benthic communities in rivers across cold regions exhibit distinct
   nutrientdriven mechanisms under different levels of human disturbance.
   The main conclusions indicate that both the Shannon-Wiener index and
   Margalef richness index showed negative correlations with Total Nitrogen
   (TN) across all areas, although the strength of these correlations
   varied significantly. Additionally, the correlations between the
   Shannon-Wiener and Margalef indices and Total Phosphorus (TP) reversed
   in both types of regions, but the concentration at which this reversal
   occurred and the strength of the correlations differed. These findings
   underscore the complex and context-dependent nature of ecological
   responses to nutrient inputs in freshwater ecosystems, particularly
   among aquatic insects, and highlight the need for tailored management
   strategies to mitigate the impact of human activities on these vital
   communities.},
