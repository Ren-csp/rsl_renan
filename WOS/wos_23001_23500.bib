@article{ WOS:000254831800018,
Author = {Mihai, Mihaela and Lacatusu, Ioana and Murariu, Alina and Meghea,
   Aurelia and Stanescu, Aurelian},
Title = {Quantification of lead pollution in Bucharest area and potential risks
   for human health},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2007},
Volume = {6},
Number = {5},
Pages = {473-478},
Month = {SEP-OCT},
Note = {4th International Conference on Environmental Engineering and
   Management, Tech Univ Iasi, Iasi, ROMANIA, SEP 12-15, 2007},
Abstract = {Lead is unique among the toxic air contaminants that the World Health
   Organization (WHO) has identified it in several ways. Lead concentration
   is increasing rapidly in the environment due to increased use in
   anthropic activity. Lead is released into the atmosphere from metallurgy
   and siderurgy industry, during coal burning, oil or wastes, from power
   plants which use solid fuel, from traffic and the building sites.
   Regardless the exposure mode, the presence of lead in urban air, even in
   relatively low concentrations, causes harmful health effects. Firstly,
   children are particularly susceptible to levels of lead in their blood
   due to exposure to lead. Secondly, the chronic non-cancer effects are
   related to blood lead levels as opposed to ambient air concentrations.
   In order to investigate the lead pollution in the Bucharest's
   atmosphere, this paper presents a case study regarding to lead
   concentration measured in Bucharest and near by area. Lead
   concentrations in suspended particulate matter were monitored from March
   2004 up to December 2006, in two urban areas (city centre of Bucharest)
   and two surrounding regions, in North and South-West parts of Bucharest
   (Balotesti and Magurele) have been chosen. The results confirmed that
   during the entire period analysed, North part of the city exhibits lower
   lead exposure, below maximum concentration level. An explanation is the
   existence of green space and forests. In the South-West parts of the
   city there were exceeding of maximum concentration level, probably due
   to intensive industrial activities. Higher values were always detected
   near the city centre. The results indicated that the highest
   concentrations of lead are ranging between 1 - 23 mu g/m(3). A variation
   of lead concentration during the spring - winter seasons was clearly
   observed.},
Publisher = {GH ASACHI TECHNICAL UNIV IASI},
Address = {71 MANGERON BLVD, IASI, 700050, ROMANIA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Mihai, M (Corresponding Author), Univ Politechn Bucharest, Fac Appl Chem \& Mat Sci, 1 Polizu St,1st Dist, Bucharest 011061, Romania.
   Mihai, Mihaela; Lacatusu, Ioana; Murariu, Alina; Meghea, Aurelia, Univ Politechn Bucharest, Fac Appl Chem \& Mat Sci, Bucharest 011061, Romania.
   Stanescu, Aurelian, FAc Automat Control \& Comp, Bucharest 060042, Romania.},
DOI = {10.30638/eemj.2007.057},
ISSN = {1582-9596},
