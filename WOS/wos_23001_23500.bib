   Thomsen, Morten, Univ Southern Denmark, Ctr Journalism, Odense, Denmark.},
DOI = {10.1111/risa.17689},
EarlyAccessDate = {DEC 2024},
ISSN = {0272-4332},
EISSN = {1539-6924},
Keywords = {construal level theory; pesticides; psychological distance},
