@article{ WOS:000341968000005,
Author = {MacTiernan, Anna and Fritschi, Lin and Slevin, Terry and Jalleh,
   Geoffrey and Donovan, Rob and Heyworth, Jane},
Title = {Public perceptions of cancer risk factors: a Western Australian study},
