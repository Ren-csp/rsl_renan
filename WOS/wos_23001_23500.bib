@article{ WOS:000415260400032,
Author = {Chen, Iris and Kelkar, Yogeshwar D. and Gu, Yu and Zhou, Jie and Qiu,
   Xing and Wu, Hulin},
Title = {High-dimensional linear state space models for dynamic microbial
   interaction networks},
Journal = {PLOS ONE},
Year = {2017},
