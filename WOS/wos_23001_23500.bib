@article{ WOS:001411456200004,
Author = {Dai, Yingjie and Ren, Guoling and Ling, Lei and Yin, Yajie and Yue, Hua
   and Xu, Jingxue and Zhang, Naixin and Pan, Chenou},
Title = {SUSTAINABLE DEVELOPMENT AND THE OLYMPIC GAMES: CASE STUDIES,
   ENVIRONMENTAL IMPACTS AND MITIGATION MEASURES},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2024},
Volume = {23},
Number = {11},
Month = {NOV},
Abstract = {Harmonious coexistence between human beings and natural resources and
   ecosystems is a goal that requires sustained efforts. The Olympic Games,
   as a worldwide sports event, has raised concerns about the environmental
   problems it has caused. Since the organization of the Olympic Games will
   bring about environmental problems such as air pollution, water
   treatment, solid waste recycling, noise pollution, ecological damage,
   and to a certain extent, it can also affect human health, so how to
   incorporate the concept of environmental protection into the Olympic
   Games has become an important issue. This paper reviews the development
   history of the relationship between the Olympic Games and the
   environment, and lists the various harms to the environment caused by
   previous Olympic Games. By summarizing the successful experiences of the
   host countries of previous Olympic Games, it provides a more accurate
   reference for future Olympic organizers on how to reduce the impact of
   the Olympic Games on the environment. It is hoped that this paper can
   provide the certain historical basis and theoretical foundation for
   future researchers or host cities, and then enhance human awareness of
   environmental protection, and ultimately realize the harmonious
   development of ``nature-humanity-sports{''}.},
