@article{ WOS:001586244800001,
Author = {Fleck-Baustian, Maja Charlotte and Jaganjac, Berina and Hunnes, John A.},
Title = {The Role of Corporate Sustainability Managers in Implementing Proactive
   Environmental Strategies},
Journal = {JOURNAL OF BUSINESS ETHICS},
Year = {2026},
Volume = {206},
Number = {1},
Pages = {93-115},
Month = {JUN},
Abstract = {Corporate Sustainability Managers (CSMs) have emerged as pivotal change
   agents in advancing organizational sustainability. In particular, they
   play a critical role in the implementation of Proactive Environmental
   Strategies (PES). However, despite their growing importance, little is
   known about how CSMs interpret and enact their roles in driving PES
   within organizations. To address this gap, this study draws upon and
   integrates insights from the Natural-Resource-Based-View (NRBV), PES,
   Upper Echelons Theory (UET), and the Attention-Based View (ABV) to
   explore how CSMs' individual characteristics and role perceptions shape
   organizational PES implementation. Fifteen semi-structured interviews
   were conducted with CSMs from diverse industries. The findings were
   content analyzed to reveal four overarching dimensions describing who
   CSMs are and how they implement PES: (a) CSM characteristics; (b)
   Organizational structure; (c) PES formulation and implementation; and
   (d) Barriers and enablers shaping their work. This study contributes to
   the sustainability and business ethics literature both theoretically and
   practically. Theoretically, it proposes a conceptual framework
   clarifying how structural and motivational dynamics shape CSMs' agency
   and effectiveness. The conceptual framework further leverages NRBV and
   PES to outline organizational expectations, while UET and ABV illustrate
   individual and top management dynamics influencing CSM capabilities.
   Practically, this study highlights three defining dynamics-departmental
   placement, recruitment background, and professional purpose-that shape
   CSMs' agency. Additionally, six actionable propositions are developed to
   support CSMs in translating sustainability ambitions into practice.
   These recommendations include building professional networks, promoting
   cross-functional collaboration, and developing clear communication
   strategies. Simultaneously, organizations are urged to embed PES in
   corporate strategies, grant CSMs access to senior leadership, and
   prioritize comprehensive sustainability training. This study underscores
   the importance of an ``all-hands-on-deck{''} approach to addressing
   environmental challenges.},
