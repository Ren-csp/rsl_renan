@article{ WOS:000341814900053,
Author = {Chang, Leifu and Zhang, Ziguo and Yang, Jing and McLaughlin, Stephen H.
   and Barford, David},
Title = {Molecular architecture and mechanism of the anaphase-promoting complex},
