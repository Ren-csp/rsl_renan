@article{ WOS:001820149700001,
Author = {Gomez-Recio, Marta and Bastir, Markus and Deboeck, Gael and LoMauro,
   Antonella and Aliverti, Andrea and Feipel, Veronique and Fischer,
   Barbara and Mitteroecker, Philipp and Beyer, Benoit},
Title = {A 4D geometric morphometrics workflow to quantify complex biological
   motion},
Journal = {METHODS IN ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {17},
Number = {9, SI},
Pages = {2616-2628},
Month = {SEP},
Abstract = {Quantifying biological motion is fundamentally tied to quantifying the
   biological structures that produce that motion. Yet, this dependence
   makes it essential to decouple motion from static morphology to enable
   general, comparable analyses across individuals and conditions. In this
   work, we present a methodological pipeline to study biological motion
   data obtained from experimental motion capture of human breathing
   kinematics before and after maximal exercise (gold-standard
   optoelectronic plethysmography markers). We used four-dimensional
   geometric morphometrics (4DGM; 3D shape through time) to characterize
   breathing patterns while standardizing torso shape and expiratory and
   inspiratory times. Results showed not only differences in breathing
   pattern before and after maximal exercise, but also differences in
   motion pattern associated with BMI and torso shape. Specifically, we
   found higher thoracoabdominal asynchrony in low-BMI subjects compared
   with high-BMI subjects. We also found a strong covariation between torso
   shape and the 3D trajectory of motion, demonstrating the power of the
   method to detect a shape-to-function signal even with a small sample
   size. This method is proposed as a flexible tool to separate biological
   motion from its underlying structure, which is particularly useful for
   studying complex systems. In the case of breathing pattern, it is
   proposed to investigate possible applications in clinical settings to
   test whether it detects differences between healthy and pathological
   kinematics, in sport sciences to attempt to link respiratory function to
   performance, and in evolutionary studies as a possible tool for
   inferring respiratory function in extinct morphologies.
   La cuantificaci \& oacute;n del movimiento biol \& oacute;gico est \&
   aacute; directamente ligada a la cuantificaci \& oacute;n de las
   estructuras biol \& oacute;gicas que lo producen. Sin embargo, esta
   dependencia hace esencial desacoplar la morfolog \& iacute;a ``est \&
   aacute;tica{''} de su movimiento para permitir an \& aacute;lisis
   comparables entre individuos y condiciones. En este trabajo se presenta
   una metodolog \& iacute;a para estudiar datos de movimiento biol \&
   oacute;gico obtenidos de captura de movimiento experimental de la cinem
   \& aacute;tica respiratoria humana antes y despu \& eacute;s de un
   ejercicio de m \& aacute;xima intensidad (est \& aacute;ndar de oro de
   marcadores de pletismograf \& iacute;a optoelectr \& oacute;nica). Se
   utiliz \& oacute; morfometr \& iacute;a geom \& eacute;trica en cuatro
   dimensiones (4DGM; forma 3D a lo largo del tiempo) para caracterizar los
   patrones respiratorios, estandarizando por forma del torso y por tiempo
   espiratorio e inspiratorio Los resultados no solo mostraron diferencias
   en patr \& oacute;n respiratorio antes y despu \& eacute;s del
   ejercicio, sino tambi \& eacute;n en el patr \& oacute;n de movimiento
   asociado al IMC y a la forma del torso. Espec \& iacute;ficamente, se
   encontr \& oacute; una mayor asincron \& iacute;a toracoabdominal en
   sujetos con bajo IMC, en comparaci \& oacute;n con sujetos de alto IMC.
   Tambi \& eacute;n se encontr \& oacute; una fuerte covariaci \& oacute;n
   entre la forma del torso y la trayectoria tridimensional del movimiento,
   demostrando el poder del m \& eacute;todo para detectar una se \&
   ntilde;al forma-funci \& oacute;n incluso a trav \& eacute;s de un bajo
   n \& uacute;mero muestral. Este m \& eacute;todo se propone como una
   herramienta flexible para separar el movimiento biol \& oacute;gico de
   su estructura subyacente, lo cual es particularmente \& uacute;til para
   estudiar sistemas complejos. En el caso del patr \& oacute;n
   respiratorio, se propone investigar posibles aplicaciones en cl \&
   iacute;nica para probar si detecta diferencias entre cinem \&
   aacute;ticas sanas y patol \& oacute;gicas, en ciencias de los deportes
   para tratar de vincular la funci \& oacute;n respiratoria al rendimiento
   y en estudios evolutivos como una posible herramienta de inferencia de
   funci \& oacute;n respiratoria en morfolog \& iacute;as extintas.},
