@article{ WOS:001526364400001,
Author = {Jahanzab, Ahmad and Fu, Zihao and Zhao, Hui and Chen, Jingwen and Xie,
   Hong-Bin},
Title = {Oxidation Mechanism and Kinetics of γ-Terpinene in the Indoor Atmosphere},
Journal = {ENVIRONMENT \& HEALTH},
Year = {2025},
Volume = {3},
Number = {10},
Pages = {1231-1244},
Month = {OCT 17},
Abstract = {gamma-terpinene is widely used in personal care and household cleaning
   products. The gas-phase oxidation mechanism of gamma-terpinene is
   essential for understanding its influence on atmospheric chemistry and
   its implications for human health. Utilizing quantum chemical
   calculations and computational toxicology simulations, we examined the
   center dot OH-mediated atmospheric transformation and toxicological
   progression of gamma-terpinene in the indoor environment. The results
   indicate that center dot OH additions are the dominant pathways for the
   reaction of center dot OH + gamma-terpinene. The most favorable reactive
   intermediates formed from the center dot OH-addition reactions
   subsequently react with O2 to form hydroxy gamma-terpinene peroxy
   radicals (OH-gamma-terp-RO2 center dot). The formed OH-gamma-terp-RO2
   center dot follows concerted peroxy radical (RO2 center dot) and alkoxy
   radical (RO center dot) modulated autoxidation, providing a new case for
   such a mechanism beyond the well-known only RO2-driven autoxidation
   mechanism. Our findings also reveal that the transformation of
   OH-gamma-terp-RO2 center dot demonstrates the competitive nature of the
   cyclization pathway indoors, with dicarbonyl formation, a rarely
   observed process in hydroxy terpene RO2 reaction systems. Toxicological
   evaluations further indicate that a significant proportion of
   transformation products (TPs) display higher mutagenicity,
   carcinogenicity, skin sensitization, and irritation to eyes compared to
   gamma-terpinene. The detailed mechanism for center dot OH-initiated
   gamma-terpinene advances our understanding of RO2 center dot and RO
   center dot chemistry while also emphasizing the potential adverse
   effects that arise from the interaction of these chemicals in indoor
   environments.},
