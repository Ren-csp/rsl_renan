Author = {Xu, Jie and Song, Fan and Lyu, Huijue and Kobayashi, Mikoto and Zhang,
   Baozhen and Zhao, Ziyu and Hou, Ye and Wang, Xiaotao and Luan, Yu and
   Jia, Bei and Stasiak, Lena and Wong, Josiah Hiu-yuen and Wang, Qixuan
