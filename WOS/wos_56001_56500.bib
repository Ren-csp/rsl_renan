@article{ WOS:001565151800001,
Author = {Boehne, Shane D. and Boley, Bertram Bynum and Van Buskirk, Amanda N. and
   Goode, Kaitlin O. and Killmaster, Charlie H. and Johannsen, Kristina L.
   and D'Angelo, Gino J.},
Title = {Identifying Acceptable Wildlife Management Techniques Using
   Support-Effectiveness Analysis: A Comparison of Suburban and Semi-Rural
   Communities' Preferences for Urban Deer Management Techniques},
Journal = {SOCIETY \& NATURAL RESOURCES},
Year = {2026},
Volume = {39},
Number = {3},
Pages = {387-406},
Month = {MAR 4},
Abstract = {With urban development pushing further into rural areas, negative
   human-wildlife interactions have increased along the urban-rural
   gradient. To help managers reduce these conflicts, researchers have
   explored various tools to identify acceptable wildlife management
   strategies, such as the Potential for Conflict Index. However, these
   tools do not simultaneously consider resident perspectives on the
   effectiveness of the technique and whether they support it. Our research
   introduces a new tool called Support-Effectiveness Analysis (SEA) and
   demonstrates how it can help managers wade through an arsenal of
   wildlife management techniques to see which techniques are acceptable,
   unproductive, non-viable, or controversial to residents. Our case study
   applies SEA to one suburban and one semi-rural community in Georgia, USA
   experiencing problems with white-tailed deer. SEA is presented as a tool
   managers can use to garner residents' input on various wildlife
   management techniques and identify which techniques they accept, oppose,
   and need to learn more about.},
