@article{ WOS:001612331800006,
Author = {Kwakye, Isaac Nyarko},
Title = {Awareness of adolescent mental health for sustainable development in the
   Eastern Region of Ghana},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2025},
Volume = {22},
Number = {1},
Month = {NOV 10},
Abstract = {BackgroundAdolescent mental health (MH) is increasingly recognized as a
   critical component of sustainable development (SD); however, awareness
   and utilization of MH services among adolescents remain limited in many
   communities. This study aims to examine adolescents' awareness of mental
   health issues and their perceptions of its role in sustainable
   development.MethodsA cross-sectional survey design was employed to
   collect data from adolescents in six senior high schools located in the
   Eastern Region of Ghana. A total of 424 adolescents were sampled using
   both stratified and simple random sampling techniques. A self-developed
   questionnaire was utilized, and data were analyzed using IBM SPSS
   version 24.ResultsAdolescents reported high recognition of common MH
   issues (approximate to 90\% for depression/anxiety/stress) but lower
   recognition of schizophrenia (74\%) and bipolar disorder (78\%). A
   majority were unaware of adolescent-specific MH services (69\%). No
   significant gender difference was observed in MH-SD perceptions after
   accounting for unequal variances (p = 0.10).ConclusionThere is a need
   for targeted mental health education and policy interventions to enhance
   awareness, improve accessibility, and integrate mental health services
   within sustainable development frameworks and educational curricula.
   Addressing these gaps is essential for advancing adolescent well-being
   and promoting long-term social and economic progress.},
