Author = {Sahasrabuddhe, Aniruddha and Hsia, Yang and Busch, Florian and Sheffler,
   William and King, Neil P. and Baker, David and Wysocki, Vicki H.},
Title = {Confirmation of intersubunit connectivity and topology of designed
   protein complexes by native MS},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2018},
Volume = {115},
