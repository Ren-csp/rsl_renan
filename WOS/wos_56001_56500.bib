@article{ WOS:001818943900007,
Author = {Blanco-Varela, Bruno and Lema, Yago Atrio},
Title = {Beyond the average: exploring the heterogeneous returns to education of
   employees through quantile regression in Spain},
Journal = {REVISTA DE EDUCACION},
Year = {2026},
Number = {413},
Pages = {161-186},
Month = {JUL-SEP},
Abstract = {Investment in education is expected to provide significant returns,
   reflected in higher wages and better employment prospects. However, the
   returns to education are the result of interactions with the
   socio-economic context, the productive structure and competition with
   other human capital. This paper aims to identify the hourly wage
   differentials of the employees in the Spanish labor market, considering
   the time evolution and the educational expansion. To measure these
   differentials, we have resorted to the use of the classical Mincerian
   equation, using quantile regression as the estimation technique, which
   allows us to discriminate according to the probability distribution of
   the hourly wage as our variable to be explained. The datasets used for
   the estimation come from the Wage Structure Survey conducted by INE
   every 4 years, including the waves from 2002 to 2018. Our results show a
   positive and significant correlation between educational attainment and
   wages in Spain over the period 2002-2018, highlighting the growing
   importance of education in determining income. Returns to education for
   wage employees through higher wage/hour have increased for each of the
   levels of study, in the context of educational expansion. This study
   contributes to the literature on the impact of education by providing
   evidence on its effect on wage inequality in Spain, which is more
   specific than other studies that focus on income in general. In
   addition, this paper investigates the dynamic and uneven nature of the
   returns to education influenced by economic conditions and the behavior
   of the cycle, which has important implications for the design of
   policies aimed at reducing wage inequality.},
