@article{ WOS:000788852000030,
Author = {Brooks-Warburton, Johanne and Modos, Dezso and Sudhakar, Padhmanand and
   Madgwick, Matthew and Thomas, John P. and Bohar, Balazs and Fazekas,
   David and Zoufir, Azedine and Kapuy, Orsolya and Szalay-Beko, Mate and
   Verstockt, Bram and Hall, Lindsay J. and Watson, Alastair and
   Tremelling, Mark and Parkes, Miles and Vermeire, Severine and Bender,
   Andreas and Carding, Simon R. and Korcsmaros, Tamas},
Title = {A systems genomics approach to uncover patient-specific pathogenic
   pathways and proteins in ulcerative colitis},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {APR 28},
Abstract = {We describe a precision medicine workflow, the integrated single
   nucleotide polymorphism network platform (iSNP), designed to determine
   the mechanisms by which SNPs affect cellular regulatory networks, and
   how SNP co-occurrences contribute to disease pathogenesis in ulcerative
   colitis (UC). Using SNP profiles of 378 UC patients we map the
   regulatory effects of the SNPs to a human signalling network containing
   protein-protein, miRNA-mRNA and transcription factor binding
   interactions. With unsupervised clustering algorithms we group these
   patient-specific networks into four distinct clusters driven by PRKCB,
   HLA, SNAI1/CEBPB/PTPN1 and VEGFA/XPO5/POLH hubs. The pathway analysis
   identifies calcium homeostasis, wound healing and cell motility as key
   processes in UC pathogenesis. Using transcriptomic data from an
   independent patient cohort, with three complementary validation
   approaches focusing on the SNP-affected genes, the patient specific
   modules and affected functions, we confirm the regulatory impact of
   non-coding SNPs. iSNP identified regulatory effects for
   disease-associated non-coding SNPs, and by predicting the
   patient-specific pathogenic processes, we propose a systems-level way to
   stratify patients.
   Single Nucleotide Polymorphisms (SNPs) affect cellular regulatory
   networks, and SNP co-occurrences contribute to disease pathogenesis in
   ulcerative colitis (UC). Here the authors introduce iSNP, a precision
   medicine pipeline that combines genomics and network biology approaches
   to uncover patient specific pathways affected in complex diseases.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Korcsmaros, T (Corresponding Author), Earlham Inst, Norwich Res Pk, Norwich, Norfolk, England.
   Carding, SR; Korcsmaros, T (Corresponding Author), Quadram Inst Biosci, Gut Microbes \& Hlth Programme, Norwich Res Pk, Norwich, Norfolk, England.
   Carding, SR (Corresponding Author), Univ East Anglia, Norwich Med Sch, Norwich, Norfolk, England.
   Brooks-Warburton, Johanne; Modos, Dezso; Sudhakar, Padhmanand; Madgwick, Matthew; Thomas, John P.; Bohar, Balazs; Fazekas, David; Szalay-Beko, Mate; Korcsmaros, Tamas, Earlham Inst, Norwich Res Pk, Norwich, Norfolk, England.
   Brooks-Warburton, Johanne; Modos, Dezso; Sudhakar, Padhmanand; Madgwick, Matthew; Thomas, John P.; Hall, Lindsay J.; Carding, Simon R.; Korcsmaros, Tamas, Quadram Inst Biosci, Gut Microbes \& Hlth Programme, Norwich Res Pk, Norwich, Norfolk, England.
