@article{ WOS:001571854400001,
Author = {Neagu, Andra C. and Rozylowicz, Laurentiu},
Title = {Insufficient scientific evidence hinders large carnivore management in
   Romania},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2025},
Volume = {62},
Month = {OCT},
Abstract = {Human-wildlife conflicts are escalating due to growing competition for
   territory and resources. Romania hosts Europe's largest population of
   European brown bears (Ursus arctos arctos) and gray wolves (Canis
   lupus), both protected under the European Habitats Directive. However,
   expanding human development has intensified human-large carnivore
   interactions, making evidence-based conservation strategies essential
   for preventing conflicts and achieving coexistence. This research aims
   to enhance the effectiveness of large carnivore management effectiveness
   in Romania by (1) assessing the extent to which conservation actions
   enforced by the management plans of Romanian protected areas align with
   evidence-based conservation practices; (2) analyzing local communities'
   perceptions of national management actions targeting the European brown
   bear and gray wolf as outlined in the national action plans; and (3)
   exploring how interactions with large carnivores influence local
   communities' perceptions of the management actions implemented at the
   national level. Through analysis of management plans enforced in
   Romania, we found that most conservation strategies in protected area
   management plans do not align with national action plans for brown bear
   and wolf conservation, lack effectiveness testing, and have uncertain
   outcomes, thereby limiting coexistence efforts. Furthermore, a
   non-probabilistic survey of stakeholders revealed low tolerance levels
   toward large carnivores, particularly brown bears, and limited trust in
   authorities, especially among people living in areas with high large
   carnivore densities. Results indicate that evidence-based conservation
   actions, educational programs, and community engagement could reduce
   reliance on lethal control measures and foster coexistence. This study
   provides guidance for protected area administrators to prioritize
   effective actions while addressing local community needs.},
