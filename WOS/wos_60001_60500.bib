@article{ WOS:001624438000042,
Author = {Rahimov, Fedik and Ghosh, Sujana and Petiwala, Sakina and Schmidt, Mary
   and Nyamugenda, Eugene and Shi, Manman and Tam, Jason and Verduzco,
   Daniel and Singh, Sanjana and Avram, Victor and Modi, Apexa and
   Espinoza, Celso A. and Lu, Charles and Wang, Jing and Keller, Ashleigh
   and Macoritto, Michael and Al Mahi, Naim and Anton, Tifani and Chung,
   Namjin and Flister, Michael J. and Katlinski, Kanstantsin V. and Biswas,
   Amlan and den Hollander, Anneke I. and Waring, Jeffrey F. and Stender,
   Joshua D.},
Title = {A genome-wide CRISPR screen identifies the TNRC18 gene locus as a
   regulator of inflammatory signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {NOV 24},
Abstract = {Interleukin-1 beta (IL-1 beta) is dysregulated in chronic inflammatory
   diseases, yet the genetic factors influencing IL-1 beta production
   remain largely unknown. Myeloid-derived cells are the primary producers
   of IL-1 beta, which prompted a genome-wide CRISPR knockout screen in the
   human myeloid-derived U937 cells treated with lipopolysaccharide (LPS)
   to mimic inflammatory conditions and sorted for high and low
   intracellular IL-1 beta levels. A total of 295 genes are identified as
   regulators of IL-1 beta production, with 57 overlapping loci associated
   with inflammatory diseases, including the TNRC18 gene locus associated
   with multiple diseases in the Finnish population. U937 cells engineered
   with the Finnish-enriched rs748670681 risk allele demonstrate decreased
   expression of TNRC18 and an adjacent gene WIPI2, reduction in
   LPS-dependent gene activation and cytokine production, but elevation of
   interferon-responsive gene programs. Transcriptomic profiles for
   individual knockouts of TNRC18 and WIPI2 attribute the loss of
   LPS-dependent signaling primarily to TNRC18, which occurs through the
   modulation of H3K27 acetylation around inflammatory regulatory regions
   via TNRC18 and its protein interaction network. In contrast, the loss of
   WIPI2 is characterized by an exacerbation of interferon signaling. These
   findings delineate the global regulatory mechanisms of IL-1 beta
   production and provide molecular insights to the role of the rs748670681
   variant in inflammatory diseases.},
