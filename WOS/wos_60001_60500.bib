Funding-Acknowledgement = {German Federal Ministry of Education and Research (BMBF) {[}01LR2102I]},
Funding-Text = {Parts of this study-particularly, the data collection-were conducted as
   part of the BMBF project KAHR (Climate Adaptation, Flooding, and
   Resilience) for Rhineland-Palatinate and North Rhine-Westphalia
