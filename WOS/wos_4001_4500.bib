@article{ WOS:A1981MS68700003,
Author = {BABINSKAWERKA, J and GARBARCZYK, H},
Title = {ANIMAL COMPONENTS OF THE DIET OF THE STRIPED FIELD-MOUSE UNDER URBAN
   CONDITIONS},
Journal = {ACTA THERIOLOGICA},
Year = {1981},
Volume = {26},
Number = {16-2},
Pages = {301-318},
Abstract = {The animal components of the diet of the striped field mouse, A.
   agrarius (Pallus, 1771), living under suburban conditions (Bialoleka
   Dworska) and in urban green areas of Warsaw (Orthodox Cemetery and
   Lazienki Park) {[}Poland] were studied. The frequency of consumption of
   animal components is higher but its volume in the stomachs is lower in
   urban mice than in suburban ones. Field mice consumed chiefly
   invertebrates, among which Insecta predominated, and to a lesser degree
   Aranea and Chilopoda. Invertebrates belonging to single taxonomic groups
   predominated in the diet of urban mice (in the Orthodox Cemetery -
   Diptera larvae, in Lazienki Park - larvae of Hymenoptera, Symphyta and
   Lepidoptera).},
