@article{ WOS:001347059200001,
Author = {Xu, Yuhan and Ma, Xiaosu},
Title = {Assessing Urban Street Vitality Through Visual and Auditory Perception:
   A case study of historic urban area in Guangzhou, China},
Journal = {INTERNATIONAL REVIEW FOR SPATIAL PLANNING AND SUSTAINABLE DEVELOPMENT},
Year = {2024},
Volume = {12},
Number = {4},
Pages = {57-76},
Abstract = {Urban streets serve as both transportation networks and public spaces,
   accommodating activity and travel demand. Evaluating street vitality is
   essential in assessing urban vitality. Existing studies usually employed
   indicators like population density through mobile phone signalling or
   app check-ins data to evaluate vitality intensity, but few have
   considered vitality quality from pedestrians' perspectives. Our study
   puts forward an approach to evaluate the vitality quality of urban
   streets based on the visual and auditory perception of pedestrians,
   using the historic urban area of Guangzhou, China, as a case. We
   collected multi-dimensional data, including street view images, videos,
   sound recordings, and user preference questionnaires. Streets were
   classified into nine types based on varying levels of vitality quality
   and intensity. Our primary finding revealed a spatial mismatch: areas
   with better street quality often have lower activity vitality, and vice
   versa. This suggests urban renewal should focus on improving both
   aspects. Different street types require targeted improvements, such as
   enhancing commercial atmosphere in tree-lined streets, increasing
   greenness in arcade streets, and managing noise levels on high-level
   motorized roads. These insights can provide valuable insights for the
   local government and urban planners to enhance urban street vitality.},
Publisher = {INT COMMUNITY SPATIAL PLANNING \& SUSTAINABLE DEVELOPMENT},
Address = {INT COMMUNITY SPATIAL PLANNING \& SUSTAINABLE DEVELOPMENT, KANAZAWA,
   00000, JAPAN},
Type = {Article},
Language = {English},
Affiliation = {Ma, XS (Corresponding Author), Southeast Univ, Sch Architecture, Nanjing, Peoples R China.
