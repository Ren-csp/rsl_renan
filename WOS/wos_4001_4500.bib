@article{ WOS:001453928100001,
Author = {Lu, Wenchang and De Maeseneer, Martine},
Title = {Evaluation of and Reconnection to Open Space: The Chicago Strip},
Journal = {SUSTAINABILITY},
Year = {2025},
Volume = {17},
Number = {6},
Month = {MAR 11},
Abstract = {Urban open space evaluation is crucial for enhancing human well-being
   and ecological sustainability, yet existing frameworks often overlook
   visual connectivity. This study integrates vision as a primary factor in
   accessibility assessment, combining the Analytic Hierarchy Process
   (AHP), user experience, and sustainable development frameworks. Focusing
   on the Chicago River corridor, we employed open data, spatial syntax,
   and Visibility Graph Analysis (VGA) using DepthmapX software to quantify
   visual parameters such as clustering coefficient, control, entropy, and
   integration. Results revealed fragmented visual connectivity, with
   obstructed zones and highly integrated nodes. Inspired by the Las Vegas
   Strip's linear connectivity, design interventions prioritized vision-led
   strategies: removing visual barriers, establishing viewing platforms,
   and enhancing waterborne transportation hubs. These interventions
   demonstrated that visual optimization significantly improves spatial
   continuity and user engagement. The findings underscore the necessity of
   incorporating visual metrics into open space evaluation systems,
   offering planners a replicable methodology to address fragmentation and
   foster cohesive urban environments.},
