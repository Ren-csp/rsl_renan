@article{ WOS:001682529600009,
Author = {Kasikam, Nichaphan and Yarnvudhi, Arerut and Leksungnoen, Nisa and
   Nasholm, Torgny and Tor-ngern, Pantana},
Title = {Effects of long term canopy change on regulating ecosystem services in a
   tropical urban park},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {JAN 12},
Abstract = {Long-term management of urban parks is critical to maintaining urban
   sustainability. Regular examination of tree attributes is essential to
   maintain healthy tree growth, enabling them to deliver regulating
   ecosystem services (RES). Here, we examined the five-year changes, from
   2019 to 2024, in RES and the monetary values provided by urban trees in
   Chulalongkorn University Centenary Park in Bangkok, Thailand. Using the
   i-Tree Eco model, we evaluated changes in canopy attributes and three
   RES: carbon sequestration, air purification, and stormwater runoff
   reduction. While the total monetary value of RES increased by 126\% to
   3,491 USD y- 1 in 2024, 37\% of the original trees were lost due to
   mortality and management practices, resulting in an annual monetary loss
   of 886 USD y- 1. Evergreen trees showed greater increases in canopy
   attributes and RES compared to deciduous trees. The study revealed that
   the mortality rate was more than double the default rate assumed in
   common forecasting models, primarily due to human management rather than
   natural causes. The findings point out the need to consider human
   intervention in urban forest management and emphasize that while urban
   parks have substantial potential for providing ecosystem services,
   improper management can significantly impair their long-term ecological
   and economic benefits.},
