@article{ WOS:000300918600011,
Author = {Olvera, Norma and Smith, Dennis W. and Lee, Chanam and Liu, Jian and
   Lee, Jay and Kellam, Stephanie and Kim, Jun-Hyun},
Title = {Hispanic maternal and children's perceptions of neighborhood safety
   related to walking and cycling},
Journal = {HEALTH \& PLACE},
Year = {2012},
Volume = {18},
Number = {1, SI},
Pages = {71-75},
Month = {JAN},
Abstract = {This study examined neighborhood safety as perceived by children (mean
   age=10 years) and their mothers, and its association with children's
   physical activity. For all eight safety items examined, children
   perceived their environment as less dangerous than mothers (p<0.05).
   None of the multiple regression models predicting children's physical
   activity by safety perceptions were significant (p>0.10). The maternal
   perception model explained the highest percentage of variance
   (R-2=0.26), compared to the children's perception model (R-2=0.22).
   Findings suggest that future studies should explore relations between
   self-reported and objectively measured safety barriers to Hispanic youth
   walking and cycling. (C) 2011 Elsevier Ltd. All rights reserved.},
