@article{ WOS:001835974200001,
Author = {Ko, Hajung and Jun, Sunmin and Park, Haekyung},
Title = {Urban park use patterns across gender and age in Seoul: Multivariate and
   long-term time series analysis based on mobile communication data
   (2017-2024)},
Journal = {CITIES},
Year = {2026},
Volume = {179},
Month = {DEC},
Abstract = {Urban parks are critical socio-ecological systems, yet equitable park
   use across demographic groups remains insufficiently understood in
   rapidly ageing East Asian megacities, where Korean evidence has been
   confined to short observation periods and single-park designs. This
   study makes three contributions. First, it assembles the longest
   longitudinal multi-park record of demographic park use yet compiled in
   Korea - eight years (2017-2024) of mobile communication data from 65
   Seoul parks, over 200,000 observations across eight gender-age groups.
   Second, it establishes that gender and age structure park use as
   intersecting, non-additive rather than independent determinants, and
   that park scale conditions these disparities. Third, it applies a
   six-phase, policy-aligned segmentation of the pandemic period to
   distinguish durable structural reconfiguration from transient
   disturbance. Using K-means clustering and time-series decomposition, we
   find that the gender gap amplified progressively with age, culminating
   in a 1.59-fold higher usage rate among older women than older men
   (Cohen's d =-1.134). Hour-of-day accounted for more than 96\% of total
   usage variance (99.41\% among older adults), establishing temporal
   accessibility as the primary organizer of park participation. Park scale
   conditioned the magnitude and direction of gender disparities and peak
   usage timing, showing that pooling heterogeneous parks obscures
   variation. Across the six phases, the Demographic Diversity Index
   declined stepwise from 1.25 (pre-pandemic) to 1.15 (post-policy) without
   recovery, reflecting genuine behavioral withdrawal against a rising
   older-adult population share in Seoul (11.8\% to 19.1\%, 2017-2024). The
   study provides an empirical baseline for Korean urban park research and
   guidance for inclusive park management in ageing megacities.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Park, H (Corresponding Author), Univ Seoul, Inst Urban Sci, Seoul, South Korea.
