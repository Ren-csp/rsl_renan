@article{ WOS:000583074800001,
Author = {Mei, Zhenyu and Kong, Liang and Zheng, Wenchao},
Title = {TOD Parking Demand Models for New Urban Areas in China},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {20},
Month = {OCT},
Abstract = {At present, many new urban areas adopt the transit-oriented development
   (TOD) exploitation concept to achieve sustainable urban development,
   accurately predict parking demand under TOD exploitation, determine
   factors that influence demand, and establish demand models that are
   essential to the formation of a reasonable traffic structure in the new
   urban area. The present study aims to establish a scientific and
   reasonable parking demand model for TOD exploitation in new urban areas.
   Influencing factors of parking demand in new urban areas under the
   concept of TOD are determined, and a framework for a parking demand
   model is constructed. A travel cost measurement model for travel
   structures at different travel distances is established, considering
   travel cost as the core element, given that it affects the travel
   structure at different distances. Finally, taking the Hangzhou Bay New
   District as an example, the costs of various travel structures under TOD
   exploitation are calculated, and the reasonable parking demand is
   calculated. From the perspective of parking management, the concept of
   TOD is effectively supported.},
