@article{ WOS:001776174000001,
Author = {Thobejane, Kagiso and Kubanza, Nzalalemba Serge},
Title = {Assessing the effectiveness of green infrastructure in urban areas, for
   mitigation of climate change-induced extreme events in South Africa: a
   case study of Johannesburg},
Journal = {LOCAL ENVIRONMENT},
Year = {2026},
Month = {2026 MAY 23},
Abstract = {This study examines the critical impacts of climate change on the
   sustainability and resilience of urban areas, focusing particularly on
   Johannesburg's central business district. It advocates for the
   implementation of green infrastructure to mitigate the urban heat island
   effect and flooding. The sinfluencesers data from municipal authorities,
   private sector experts, and members of the local community to understand
   the local context and institutional processes that influence the
   adoption of green infrastructure. It highlights that the urban heat
   island effect and flooding pose major threats to Johannesburg's urban
   environment, and that vulnerable populations are disproportionately
   affected. The study concludes with recommendations for integrated policy
   strategies, clearly defined management, and community engagement to
   develop a climate-resilient urban environment. These recommendations
   will guide future research and broader discussions on urban resilience
   and climate change adaptation in developing countries.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
