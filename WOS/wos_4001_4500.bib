@article{ WOS:000333859400003,
Author = {van Ommeren, Jos and de Groote, Jesper and Mingardo, Giuliano},
Title = {Residential parking permits and parking supply},
Journal = {REGIONAL SCIENCE AND URBAN ECONOMICS},
Year = {2014},
Volume = {45},
Pages = {33-44},
Month = {MAR},
Abstract = {We estimate welfare losses of policies that provide on-street parking
   permits to residents almost free of charge in Dutch shopping districts
   that are predominantly downtown. Our empirical results indicate that
   parking supply is far from perfectly price elastic, implying that there
   are substantial welfare losses related to underpriced parking permits.
   Our results suggest that the provision of residential parking permits in
   downtown shopping districts induces a yearly welfare loss of about
   (sic)275 per permit, which is about 15\% of the supply cost of a parking
   place. (C) 2013 Elsevier B.V. All rights reserved.},
