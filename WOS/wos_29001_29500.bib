   Stokes, Robert J., Drexel Univ, Dept Culture \& Commun, Philadelphia, PA 19104 USA.
   Cohen, Deborah A.; Kofner, Aaron; Ridgeway, Greg K., RAND Corp, Los Angeles, CA USA.},
DOI = {10.1016/j.amepre.2010.03.016},
ISSN = {0749-3797},
