@article{ WOS:000629737900009,
Author = {Marino, Cintia and Guerra, Abilio},
Title = {Playful City, Struggling City: The Case of Parque Augusta in Sao Paulo},
Journal = {TERRITORIOS},
Year = {2021},
Number = {44},
Abstract = {This article aims to provide an overview of urban dispute dynamics and
   collective experiences, based on a reflection on the case of Parque
   Augusta, in Sao Paulo. A private plot of land in downtown Sao Paulo has
   unified the agenda of social movements with diverse ideology, in order
   to transform it into a public park. After several years of spontaneous
   appropriation by neighbours, from 2013 on activists have intensified
   direct actions, organizing art and culture events and activities. Using
   the concepts of ``right to the city{''} and ``urban commons{''}, the
   case analysis describes the trajectories of the groups and identifies
   some contradictions generated throughout the process. In methodological
   terms, the investigation is conducted through narratives, spatial scale,
   time frame, questions and concepts. The observed collective experience
   seems to require a new process to produce democratic public space.},
