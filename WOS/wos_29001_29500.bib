@article{ WOS:000282193400017,
Author = {Hand, Christopher J. and Miellet, Sebastien and O'Donnell, Patrick J.
   and Sereno, Sara C.},
Title = {The Frequency-Predictability Interaction in Reading: It Depends Where
   You're Coming From},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2010},
Volume = {36},
Number = {5},
Pages = {1294-1313},
Month = {OCT},
Abstract = {A word's frequency of occurrence and its predictability from a prior
   context are key factors determining how long the eyes remain on that
   word in normal reading. Past reaction-time and eye movement research can
   be distinguished by whether these variables, when combined, produce
   interactive or additive results. respectively. Our study addressed
   possible methodological limitations of prior experiments. Initial
   results showed additive effects of frequency and predictability.
   However, we additionally examined launch site (the distance from the
   pretarget fixation to the target) to index the extent of parafoveal
   target processing. Analyses revealed both additive and interactive
   effects on target fixations, with the nature of the interaction
   depending on the quality of the parafoveal preview. Target landing
   position and pretarget fixation time were also considered. Results were
   interpreted in terms of models of language processing and eye movement
   control. Our findings with respect to parafoveal preview and fixation
   time constraints aim to help parameterize eye movement behavior.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article},
Language = {English},
Affiliation = {Sereno, SC (Corresponding Author), Univ Glasgow, Inst Neurosci \& Psychol, 58 Hillhead St, Glasgow G12 8QB, Lanark, Scotland.
   Miellet, Sebastien; Sereno, Sara C., Univ Glasgow, Inst Neurosci \& Psychol, Glasgow G12 8QB, Lanark, Scotland.
   O'Donnell, Patrick J.; Sereno, Sara C., Univ Glasgow, Sch Psychol, Glasgow G12 8QB, Lanark, Scotland.
   Hand, Christopher J., Univ Bedfordshire, Dept Psychol, Bedford, England.},
DOI = {10.1037/a0020363},
ISSN = {0096-1523},
EISSN = {1939-1277},
Keywords = {reading; eye movements; word frequency; contextual predictability;
