@article{ WOS:001200876900001,
Author = {Busciantella-Ricci, Daniele and Macchi, Alessia and Viviani, Sara and
   Rinaldi, Alessandra},
Title = {Healthy and Inclusive Neighbourhoods: A Design Research Toolkit for the
   Promotion of Healthy Behaviours},
Journal = {SUSTAINABILITY},
