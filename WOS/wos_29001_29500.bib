@article{ WOS:001483332800001,
Author = {Rahman, Md Mostafizur and Quader, Masrur Abdul and Chisty, Musabber Ali
   and Alam, Edris and Islam, Md Kamrul and Islam, Abu Reza Md. Towfiqul},
Title = {Perception and health implications of road-traffic noise pollution in
   Bangladesh},
Journal = {LOCAL ENVIRONMENT},
Year = {2026},
Volume = {31},
Number = {3},
Pages = {258-275},
Month = {MAR 4},
Abstract = {Road-traffic noise pollution is a critical yet underexplored public
   health issue in Bangladesh. This study investigates the relationship
   between perceived road-traffic noise exposure and self-reported health
   impacts among adults. A cross-sectional online survey was conducted with
   526 participants who had lived in their current location for over five
   years and identified road-traffic as the primary source of noise
   pollution. Linear regression analysis examined the association between
   sociodemographic factors, noise exposure, and health outcomes. Results
   indicate that 45\% of respondents experienced noise exposure during
   school and workplace hours, with individuals aged 26-35 years being
   significantly affected (Beta = 0.92, 95\% CI: 0.33;1.52). Residents of
   mixed-use buildings exhibited increased susceptibility to noise-related
   health issues (Beta = 1.94). The study reveals insufficient
   noise-mitigation efforts, emphasising the need for policy reforms, urban
   planning interventions, and public health awareness campaigns. These
   findings contribute to the broader discourse on noise pollution
   management, offering insights for researchers, policymakers, and urban
   planners.},
