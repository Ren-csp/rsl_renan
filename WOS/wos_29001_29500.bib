@article{ WOS:000332046700022,
Author = {Gillespie, Duncan O. S. and Trotter, Meredith V. and Krishna-Kumar,
   Siddharth and Tuljapurkar, Shripad D.},
Title = {BIRTH-ORDER DIFFERENCES CAN DRIVE NATURAL SELECTION ON AGING},
Journal = {EVOLUTION},
