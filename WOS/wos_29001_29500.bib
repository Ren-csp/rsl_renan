@article{ WOS:001761501100001,
Author = {Vizuete, Danny Castillo and Santamaria, Gabriela Roman and Montoya, Alex
   Gavilanes and Lliquin, Jorge Cordova and Borz, Stelian Alexandru and
   Woosnam, Kyle Maurice},
Title = {A design of ecotourist routes using GIS storymaps in Riobamba, Ecuador:
   connecting the urban to the rural},
Journal = {JOURNAL OF ECOTOURISM},
Year = {2026},
Month = {2026 MAY 12},
Abstract = {Designing tourist routes is a key strategy for managing and planning for
   emergent tourism. This study proposes tourist routes connecting the city
   of Riobamba (Ecuador) with rural area of the canton using the ArcGIS
   StoryMaps (R) platform and an analysis of tourism supply and demand. The
   former was identified through primary and secondary data, while the
   latter was assessed via surveys of domestic and international tourists.
   Route planning involved using ArcGIS Pro, generating 3D models of major
   urban attractions with photogrammetry (via Small Unmanned Aerial
   Vehicles or sUAV and Agisoft Metashape Professional), and creating an
   interactive StoryMap. Results show 36 urban and 98 rural ecotourist
   attractions in the canton. Although only 13\% of respondents expressed
   interest in vacationing in Riobamba, three routes were developed: an
   urban route, Historical Heritage of Riobamba (18 cultural sites), and
   two rural routes, Chimborazo Andean Landscape and El Altar Glacial
   Sanctuary, highlighting natural landmarks such as Chimborazo volcano and
   El Altar. The routes are presented in an interactive StoryMap organized
   into thematic sections, incorporating 55 shapefiles for a dynamic user
   experience. These routes serve as a strategic tool to promote tourism in
   Riobamba, enhancing its visibility and contributing to local economic
   development.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
