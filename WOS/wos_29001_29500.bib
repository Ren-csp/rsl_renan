@article{ WOS:001797501500028,
Author = {Pradhan, Jyoti and Pal, Anjali and Shukla, Arvind Kumar},
Title = {A Study of Cardiovascular Risk Assessment Using the World Health
   Organization-International Society of Hypertension Risk Chart in an
   Urban Area of Raipur: A Community-based Analytical Cross-sectional Study},
Journal = {INDIAN JOURNAL OF PUBLIC HEALTH},
Year = {2026},
Volume = {70},
Number = {2},
Pages = {247-250},
Month = {APR-JUN},
Abstract = {Cardiovascular diseases (CVDs) are associated with high morbidity,
   disability adjusted life years, and mortality. This community-based
   cross-sectional study assessed cardiovascular risk in 408 participants
   using the World Health Organization-International Society of
   Hypertension nonlaboratory chart which is useful in low-resource
   settings. The majority, 202 (49.5\%), were in the Green Zone (<5\% risk
   in 10 years). Mild risk (5\%-10\%) was found in 118 (28.9\%), moderate
   risk in 81 (19.9\%), and severe/very severe in 6 (1.5\%) and 1 (0.2\%),
   respectively. Ordinal logistic regression (P < 0.05) revealed that
   living in extended families, alcohol consumption, sedentary hours, and
   increased waist-hip ratio significantly increased CVD risk. Being
   married showed a protective effect.},
