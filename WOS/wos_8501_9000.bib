@article{ WOS:000365583500007,
Author = {Cleveland, David A. and Copeland, Lauren and Glasgow, Garrett and
   McGinnis, Michael Vincent and Smith, Eric R. A. N.},
Title = {The Influence of Environmentalism on Attitudes Toward Local Agriculture
   and Urban Expansion},
Journal = {SOCIETY \& NATURAL RESOURCES},
Year = {2016},
Volume = {29},
Number = {1},
Pages = {88-103},
Month = {JAN 2},
Abstract = {This article uses the New Ecological Paradigm (NEP) to examine attitudes
   toward local agriculture and land use issues in Santa Barbara County
   (SBC), California. To do so, we use data collected for the Central Coast
   Survey in 2010. Although our study has a narrow geographic scope, it has
   broad implications. Our results suggest that people with stronger
   pro-environment views support agriculture, and prefer it over urban
   expansion, but are also critical of agriculture's negative environmental
   effects. In addition, we find no significant differences between the
   traditionally pro-agriculture north and the traditionally
   pro-environment south SBC residents on key policy issues, which suggests
   that broad political divisions do not dictate attitudes toward
   rural-environment conflicts.},
