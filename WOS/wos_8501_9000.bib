@article{ WOS:001524576300001,
Author = {Vallance, Suzanne and Robson-Williams, Melissa and van Noppen, Flo and
   Duncan, Ronlyn},
Title = {Enabling nature's participation in research: an experiment in empathy},
Journal = {SUSTAINABILITY SCIENCE},
Year = {2025},
Volume = {20},
Number = {6},
Pages = {2097-2110},
Month = {NOV},
Abstract = {The sustainable development construct has failed to arrest environmental
   decline, mitigate species extinction, slow climate change and reduce
   enormous global waste streams. Many argue this is because sustainable
   development retains and reinforces society-nature binaries and
   configures that relationship primarily for our human benefit. A good
   partner in a reciprocal, respectful and empathetic relationship would
   act very differently. The research we present here explores whether it
   is possible to promote different relationships with Nature within a
   constrained budget and limited timeframe. Our ``experiment in empathy
   (as Nature){''} was conducted to test the hypothesis that ``If Nature
   set our research strategy, we would do different research and/or do
   research for different reasons{''}. We invited selected participants to
   a retreat to re-write a research strategy as elements of Nature. A
   comparison of the before and after strategy developed by air, water,
   soil, landscape, plants and birds shows it is possible to promote more
   empathetic relationships with the natural environment and that giving
   Nature a say over our research may result in some intriguing changes to
   research practice.},
