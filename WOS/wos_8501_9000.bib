@article{ WOS:000727798900001,
Author = {Bosch, Marti and Locatelli, Maxence and Hamel, Perrine and Remme, Roy P.
   and Jaligot, Remi and Chenal, Jerome and Joost, Stephane},
Title = {Evaluating urban greening scenarios for urban heat mitigation: a
   spatially explicit approach},
Journal = {ROYAL SOCIETY OPEN SCIENCE},
Year = {2021},
