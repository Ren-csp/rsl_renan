@article{ WOS:001125752900001,
Author = {Li, Wen and Liu, Peng},
Title = {Evoking Nostalgia: Graffiti as Medium in Urban Space},
Journal = {SAGE OPEN},
Year = {2023},
Volume = {13},
Number = {4},
Month = {OCT},
Abstract = {This study examines the role of graffiti as a medium in urban spaces,
   particularly in the context of Macau. Graffiti, seen as a form of
   artistic expression, has the potential to invigorate and enliven public
   spaces. Utilizing visual ethnography methods and analyzing cultural
   policies, the paper aims to examine the presence of graffiti in various
   neighborhoods within Macau. The concept of nostalgia also serves as a
   theoretical framework to understand how graffiti can evoke memories and
   create an emotional connection to the past. By investigating hotspots
   like Largo do Estaleiro, Rua de S. Tiago da Barra, and the vicinity
   surrounding Ruins of St. Paul's through interviews with residents and an
   examination of distribution patterns, we aim to comprehend how these
   graffiti sites can establish a link to history and contribute to a
   shared memory and sense of locality. The findings of this research have
   important implications for urban planning and cultural policy in Macau,
   as they highlight the significance of incorporating graffiti as a
   legitimate form of public art that can contribute to the cultural
   identity and sense of nostalgia in urban spaces.
