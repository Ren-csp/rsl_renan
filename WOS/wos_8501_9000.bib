   GLMM; human-wildlife coexistence; Qinghai-Tibet Plateau; Tibetan
   Buddhist monasteries},
Keywords-Plus = {SACRED GROVES; BIODIVERSITY CONSERVATION; SPECIES-DIVERSITY; LARGE
   CARNIVORES; BIRD DIVERSITY; JAINTIA HILLS; CONFLICTS; IMPACTS; TRAITS},
Research-Areas = {Biodiversity \& Conservation; Environmental Sciences \& Ecology},
