Author = {Maria Nascimento, Elisangela Castedo and Zanon, Angela Maria},
Title = {Environmental perception of Terena indigenous teachers from
   environmental drawings},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
