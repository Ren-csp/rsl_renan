@article{ WOS:001790686100001,
Author = {Abdulmaksoud, Sara and Alherimi, Nadin and Samara, Fatin},
Title = {Evaluating urban livability dimensions and their influence on residents'
   quality of life: evidence from residential communities in the United
   Arab Emirates},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {MAY 29},
Abstract = {Introduction Urban livability has become a central component of
   sustainable development and quality-of-life (QoL) planning in rapidly
   growing cities. This study investigates the key urban livability
   dimensions influencing residents' perceived QoL in residential
   communities within the rapidly urbanizing United Arab Emirates
   (UAE).Methods Employing a mixed-methods approach that integrates Fuzzy
   Delphi expert consensus and Structural Equation Modeling (SEM) of
   resident survey data, the research examines the influence of
   environmental quality, green infrastructure and ecosystems, transport
   and mobility, social and community services, living conditions of the
   built environment, and sustainability and resource management.Results
   The findings reveal that green infrastructure and ecosystems, transport
   and mobility, and the living conditions of the built environment
   significantly enhance perceived QoL. Environmental quality also exerts a
   substantial effect, as poor air quality, excessive noise, and visual
   pollution negatively impact residents' wellbeing. In contrast, social
   and community services and sustainability and resource management do not
   emerge as significant direct predictors in this context.Discussion These
   findings highlight the primacy of physical-environment and mobility
   factors in shaping livability perceptions within the UAE and underscore
   the need for resident-centered, evidence-based urban planning. Given
   that the analysis is grounded in a single-community sample, the findings
   are interpreted analytically and are intended to provide
   context-specific, exploratory insights for policymakers seeking to
   design sustainable and livable urban environments in the Gulf region and
   comparable rapidly urbanizing contexts, while signaling the need for
   larger, multi-community studies to confirm and extend these results.},
