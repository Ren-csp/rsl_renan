Volume = {35},
Number = {1},
Pages = {229-241},
Month = {JAN-APR},
Abstract = {This work had the objective of verifying the concept of the environment
   of the indigenous teachers of the Early Years of Elementary School of
   the ``Marcolino Lili{''} Indigenous Municipal School of the Municipality
   of Aquidauana / MS. A case study with exploratory, descriptive and
   qualitative critical analysis was carried out. The research was divided
   in stages: analysis of the planning and observation of the classes to
   verify the frequency in which the EA appears; Preparation,
   interpretation and analysis of environmental drawings. The subjects of
   the research were the indigenous teachers and the object of study the
   vision of the environment of these teachers by means of drawings.. In
   the analysis of the drawings of environment made by indigenous teachers,
   a naturalistic view was identified that separates man from nature.},
