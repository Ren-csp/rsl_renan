@article{ WOS:000435163700005,
Author = {Mejias Moreno, Ana Isabel},
Title = {Contribution of urban vegetable gardens to health},
Journal = {HABITAT Y SOCIEDAD},
Year = {2013},
Number = {6},
Pages = {85-103},
Month = {NOV},
Abstract = {The inclusion of urban agriculture in cities is presented as a potential
   tool to for the promotion of healthy and sustainable urban environments
   which can be especially beneficial for vulnerable groups. The aim of
   this study is to analyze the health effects experienced by people over
   65 years engaged in a network of gardens already established in
   Barcelona.
   An exploratory descriptive design was conducted, by semi-structured
   interviews with six gardeners from Barcelona to discuss their
   perceptions regarding how their participation in the urban gardens
   influenced their health.
   Gardeners said they had perceived an increase in physical activity,
   quality (but not quantity) of the vegetables they consume and in social
   relationships, and benefits to their psychological well-being.
   The inclusion of vegetable gardens in cities seems to provide numerous
   benefits, such us promoting healthy environments and lifestyles and
   increasing urban sustainability, so it is proposed as a possible
   strategy to address multiple problems in a cross-cutting manner.},
Publisher = {UNIV SEVILLA, EDITORIAL},
Address = {SECRETARIADO PUBLICACIONES, C/ PORVENIR, NO 27, SEVILLE, 41013, SPAIN},
Type = {Article},
Language = {Spanish},
Affiliation = {Moreno, AIM (Corresponding Author), Hosp Igualada, Barcelona, Spain.
   Mejias Moreno, Ana Isabel, Hosp Igualada, Barcelona, Spain.},
DOI = {10.12795/HabitatySociedad.2013.i6.05},
ISSN = {2173-125X},
Keywords = {Urban agriculture; Urban gardens; Health; Urban sustainability;
   Lifestyles},
