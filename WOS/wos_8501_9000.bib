@article{ WOS:000506638100009,
Author = {Braun, Valerie},
Title = {The Nature Park movement in Austria - from recreational areas to(wards)
   model regions for sustainable development},
Journal = {ECO MONT-JOURNAL ON PROTECTED MOUNTAIN AREAS RESEARCH},
Year = {2020},
Volume = {12},
Number = {1},
Pages = {64-69},
Month = {JAN},
Abstract = {In Austria, Nature Parks (NaP) are the oldest large protected areas. The
   first NaPs were created both as recreational areas for the urban
   population of Vienna, and to encourage economic growth in rural cultural
   landscapes. Twenty years after the first characteristic landscapes were
   designated to protect their uniqueness without preventing their economic
   development, working groups were established to concentrate on the
   further development and establishment of NaPs. With the foundation of
   the Association of Austrian NaPs, an umbrella organization, a common
   strategy for all Austrian NaPs was developed and implemented. Today, the
   strategy of NaPs is to simultaneously protect natural and cultural
   landscapes and to become model regions for sustainable development. This
   article highlights the development of NaPs in Austria from recreational
   parks for the urban population to model regions for sustainable
   development.},
