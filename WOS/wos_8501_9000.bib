
@article{ WOS:001873295300001,
Author = {Sebastian, Micah and Pensini, Pamela},
Title = {Zero-Sum Beliefs Predict Reduced Pro-Environmental Behaviour by
   Predicting Reduced Empathy for Both Humans and Nature},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {17},
Month = {SEP 2},
Abstract = {Zero-sum beliefs about the nature-human relationship (ZSB-NH)
   conceptualise environmental protection and human wellbeing as inherently
   conflicting and have been shown to reduce pro-environmental behaviour
   (PEB). However, the psychological mechanisms underlying this
   relationship remain poorly understood. The present study examined
   whether empathy for humans and empathy for nature mediate the
   relationship between ZSB-NH and PEB. Australian adults (N = 943)
   completed measures of ZSB-NH, human-directed empathy, nature-directed
   empathy, and PEB. Parallel mediation analyses showed that ZSB-NH
   negatively predicted both empathy for humans and empathy for nature,
   which, in turn, positively predicted PEB. Both forms of empathy
   significantly and partially mediated the relationship between ZSB-NH and
   PEB, with neither indirect effect differing significantly in magnitude.
   When empathy was examined at the facet level, ZSB-NH negatively
   predicted all dimensions of human and nature empathy; however, only
   taking a human perspective uniquely mediated the relationship with PEB,
   possibly due to multicollinearity present between the nature empathy
   subscales. The direct effect of ZSB-NH remained significant, indicating
   partial mediation. These findings suggest that zero-sum beliefs may
   inhibit pro-environmental behaviour partly by reducing empathy,
   particularly cognitive perspective taking, while also highlighting that
   additional mechanisms contribute to this relationship. Interventions
   that foster perspective taking and directly challenge zero-sum beliefs
   may therefore promote greater engagement in pro-environmental behaviour.},
