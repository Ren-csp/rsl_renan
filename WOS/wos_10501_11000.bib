@article{ WOS:000601044000001,
Author = {Griera, Mar and Burchardt, Marian},
Title = {Urban regimes and the interaction order of religious minority rituals},
Journal = {ETHNIC AND RACIAL STUDIES},
Year = {2021},
Volume = {44},
Number = {10, SI},
Pages = {1712-1733},
Month = {AUG 9},
Abstract = {This article develops a multidimensional concept of urban regimes that
   allows for explaining racialized asymmetries of access to public space
   among different religious minority groups. Departing from an empirical
   study of collective religious rituals in the streets, parks and squares
   of Barcelona, we compare Buddhist, Sikh and Islamic events in public
   space. Although all religious events are in theory subjected to the same
   regulatory regime, we find significant differences in the ways that
   these regulations are enacted. Making sense of these differences
   requires a multidimensional concept of urban regimes involving (a) the
   bureaucratic regulations, (b) the interaction order of the city and the
   attached emotional registers, and (c) imaginations of public space. The
   conjunction of all three domains allows for a deeper understanding of
   how conceptions of ideal public space, urban visibility and public
   emotional registers are configured in the governance of religious events
   and partly intersect with institutional racism.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Griera, M (Corresponding Author), Univ Autonoma Barcelona, Sociol Dept, Barcelona, Spain.
   Burchardt, M (Corresponding Author), Univ Leipzig, Inst Sociol, Leipzig, Germany.
   Griera, Mar, Univ Autonoma Barcelona, Sociol Dept, Barcelona, Spain.
   Burchardt, Marian, Univ Leipzig, Inst Sociol, Leipzig, Germany.},
DOI = {10.1080/01419870.2020.1849754},
EarlyAccessDate = {DEC 2020},
