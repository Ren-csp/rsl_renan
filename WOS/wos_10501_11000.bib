@article{ WOS:001490777600014,
Author = {Teixidor-Toneu, Irene and Fernandez-Llamazares, Alvaro and Abel, Ricardo
   Alvarez and Batdelger, Gantuya and Bell, Elicia and Caillon, Sophie and
   Cantor, Mauricio and Correia, Joel E. and Diaz, Sandra and Fisk,
   Jonathan and Greene, Alexander and Greening, Spencer and Hoyte, Simon
   and Kalle, Raivo and Loayza, Gabriela and Mattalia, Giulia and Montufar,
   Rommel and Ojeda, Jaime and Phatthanaphraiwan, Suwichan and Vaccaro,
   Ismael and Ban, Natalie C.},
Title = {Human-nature relationships through the lens of reciprocity: Insights
   from Indigenous and local knowledge systems},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {5, SI},
Pages = {922-933},
Month = {MAY},
Abstract = {In the context of climate change, biodiversity decline and social
   injustice, reciprocity emerges as a way of living and being in this
   world that holds transformative potential. Concepts of reciprocity vary
   and are enacted in specific cultural practices grounded in Indigenous
   and local knowledge systems. This editorial synthesises first-hand
   evidence of how practising reciprocity can result in positive reciprocal
   contributions between people and nature. It also offers a theoretical
   justification of why considering reciprocity can lead to more equitable,
   inclusive and effective conservation and sustainability policy and
   practices, contributing to curving the colonial baggage of academic
   inquiry and development action. Nurturing reciprocal relations between
   people, especially between academics and Indigenous Peoples and local
   communities, is a necessary first step to identifying pathways whereby
   living in harmony with nature can be achieved.
   En el contexto actual de cambio clim \& aacute;tico, declive de la
   biodiversidad e injusticias sociales, la reciprocidad emerge como una
   forma de vivir y ser en este mundo con potencial transformador. Los
   conceptos de reciprocidad son diversos y se materializan en pr \&
   aacute;cticas culturales espec \& iacute;ficas basadas en sistemas de
   conocimiento Ind \& iacute;genas y locales. Este art \& iacute;culo
   editorial sintetiza evidencia de c \& oacute;mo las pr \& aacute;cticas
   de reciprocidad pueden dar lugar a contribuciones rec \& iacute;procas
   positivas entre las personas y la naturaleza. El art \& iacute;culo
   tambi \& eacute;n ofrece una justificaci \& oacute;n te \& oacute;rica
   de por qu \& eacute; la consideraci \& oacute;n de la reciprocidad puede
   conducir a pol \& iacute;ticas y pr \& aacute;cticas de conservaci \&
   oacute;n y sostenibilidad m \& aacute;s equitativas, inclusivas y
   eficaces, contribuyendo a reducir el bagaje colonial de la investigaci
   \& oacute;n acad \& eacute;mica y las estrategias de desarrollo
   sostenible. Fomentar las relaciones rec \& iacute;procas entre personas,
