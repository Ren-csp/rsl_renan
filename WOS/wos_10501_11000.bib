@article{ WOS:000696134400001,
Author = {Azevedo, Vanessa and Caridade, Sonia and Dinis, Maria Alzira Pimenta and
   Nunes, Laura M. and Sani, Ana},
Title = {School climate and students' disruptive behavior: Perceptions of school
   professionals},
