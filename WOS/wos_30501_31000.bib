@article{ WOS:A1991FK18400045,
Author = {MOAZED, D and NOLLER, HF},
Title = {SITES OF INTERACTION OF THE CCA END OF PEPTIDYL-TRANSFER RNA WITH 23S
   RIBOSOMAL-RNA},
