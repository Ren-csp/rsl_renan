@article{ WOS:001843577600001,
Author = {Stoessel, Marianne and Wikinger, Felicia and Lindborg, Regina},
Title = {Balancing forage and fear: How people, environment and predators shape
   reindeer grazing in the Fennoscandian tundra},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {9},
Pages = {3182-3200},
Month = {SEP},
Abstract = {The long history of reindeer herding in Fennoscandia has shaped the
   mountain tundra by influencing its productivity, nutrient and carbon
   cycling and vegetation structure. By partly limiting shrub expansion,
   extensive reindeer grazing contributes to ecosystem resilience and helps
   mitigate climate change effects. Yet, outdoor tourism is discussed as a
   major pressure that can alter reindeer grazing patterns, with likely
   consequences cascading onto the tundra plant communities and vegetation
   structure. To study this, we tagged reindeer with GPS and accelerometers
   in three Swedish reindeer herding districts experiencing different
   levels of tourism pressure, and analysed their occurrence and grazing
   activity in relation to human infrastructures, habitat and predators. In
   the district with the highest tourism pressure, reindeer avoided large
   buildings but tolerated hiking trails. Responses were more mixed in the
   two other districts where large national hiking trails were avoided, but
   small cabins were not. Interestingly, the reindeer grazing patterns
   measured with accelerometers showed a different response to that
   inferred from reindeer occurrence alone, revealing that even where
   reindeer did not avoid human infrastructures, their grazing activity was
   still decreased. In all districts, we detected interactive effects
   between predators and human infrastructures, suggesting a `human-shield'
   effect at play, that is reindeer used the proximity to specific types of
   human infrastructure as a refuge from predation. This context-dependent
   tolerance of reindeer towards humans according to predator presence
   reveals that even non-lethal human presence in the mountains, in the
   form of tourism, can influence predator-prey interactions in the tundra.
   By decoupling spatially explicit grazing activities from presence-only
   habitat selection, this study highlights that, even if reindeer might
   appear tolerant to human presence in the mountains, outdoor tourism can
   still disturb them by disrupting their grazing. As this study was
   conducted in a region experiencing substantial land use changes, our
   findings stress the need to better recognise the effects of human
   interactions with the tundra wildlife, particularly herbivores such as
   reindeer, as these can cascade onto other trophic levels and therefore
   affect broader ecosystem processes under climate change.Read the free
   for this article on the Journal blog.
   Fennoskandias l \& aring;nga historien av rensk \& ouml;tsel har format
   fj \& auml;llandskapet genom att p \& aring;verka produktivitet, n \&
   auml;rings- och kolcykler samt vegetationsstruktur. Genom att delvis
   begr \& auml;nsa utbredning av buskar bidrar den extensiva renbetningen
   till ekosystemets motst \& aring;ndskraft samt att mildra klimatf \&
   ouml;r \& auml;ndringens effekter. Samtidigt anses friluftsturismen
   kunna ha en p \& aring;verkan p \& aring; renarnas betesm \& ouml;nster,
   vilket kan ge negativa effekter p \& aring; fj \& auml;llens v \&
   auml;xtsamh \& auml;llen och vegetationsstruktur. F \& ouml;r att unders
   \& ouml;ka detta, m \& auml;rkte vi renar med GPS och accelerometrar i
   tre svenska samebyar med olika niv \& aring;er av turism, och
   analyserade renarnas f \& ouml;rekomst och betesaktivitet i relation
   till m \& auml;nsklig infrastruktur, livsmilj \& ouml; och rovdjur. I
   samebyn med den st \& ouml;rsta turismen undvek renarna stora byggnader,
   men tolererade vandringsleder. Effekterna varierade mer i de tv \&
   aring; \& ouml;vriga samebyar, d \& auml;r stora nationella
   vandringsleder undveks, medan sm \& aring; stugor tolererades.
   Intressant nog visade accelerometrarna, som till skillnad mot
   GPS-punkterna visar renarnas betesm \& ouml;nster, att deras
   betesaktivitet \& auml;nd \& aring; minskade kring m \& auml;nskliga
   infrastruktur som inte undveks. I alla samebyar kunde vi konstatera
   interaktiva effekter mellan rovdjur och m \& auml;nsklig infrastruktur,
   vilket tyder p \& aring; att en ``m \& auml;nsklig skyddseffekt{''}, det
   vill s \& auml;ga att renarna nyttjade n \& auml;rheten till viss m \&
   auml;nskliga infrastruktur som skydd mot rovdjur. Denna kontextberoende
   tolerans hos renarna gentemot m \& auml;nniskor, beroende p \& aring;
   rovdjurens n \& auml;rvaro, visar att m \& auml;nsklig n \& auml;rvaro i
   fj \& auml;llen, i form av turism, kan p \& aring;verka interaktionerna
   mellan rovdjur och bytesdjur i fj \& auml;llen. Genom att skilja
   betesaktiviteter fr \& aring;n generella val av livsmilj \& ouml;
   belyser denna studie att \& auml;ven om renar kan verka toleranta mot m
   \& auml;nniskors n \& auml;rvaro i fj \& auml;llen, kan friluftsturismen
   \& auml;nd \& aring; st \& ouml;ra dem genom att avbryta deras betning.
   Eftersom studien genomf \& ouml;rdes i en region som genomg \& aring;r
   betydande f \& ouml;r \& auml;ndringar i markanv \& auml;ndningen,
   understryker v \& aring;ra resultatbehovet av att b \& auml;ttre beakta
   effekterna av m \& auml;nniskans interaktioner med fj \& auml;llfaunan,
   s \& auml;rskilt v \& auml;xt \& auml;tare som renar, eftersom de kan ge
