@article{ WOS:001244393300003,
Author = {Jazdzewska, Iwona and Zerek, Karolina},
Title = {A spatial analysis of one of the regional logistics clusters in central
   Poland using GIS},
Journal = {ENVIRONMENTAL \& SOCIO-ECONOMIC STUDIES},
Year = {2024},
Volume = {12},
Number = {2},
Pages = {48-61},
Month = {JUN 1},
Abstract = {Logistics services are a consequence of increasingly rapid economic
   development and globalisation. More and more facilities with adequate
   transport accessibility are being created for the storage of goods,
   which form logistics clusters. They emerged later in Central and Eastern
   Europe than in the United States and Western Europe. Investment in
   Poland's first logistics parks can be linked to the political and
   economic transformation in 1989, Poland's accession to the European
   Union in 2004, the development of motorways, and Poland's integration
   into the global economy. In the second decade of the 21st century, there
   are more than a dozen places in Poland that can be called logistics
   clusters. The purpose of this research was to geographically analyse a
   selected regional cluster located in Lodz voivodeship, as well as its
   links to the transport network of Poland and Europe. Geostatistical and
   GIS methods were used for spatial analysis. It was shown that its
   spatial distribution is strongly related to the A1 highway, the
   intersection of the A1 and A2 highways and the voivodeship city of Lodz.
   The characteristics of the geographic environment give reason to suggest
   that it has great development potential and is worthy of further
   observation and comparative studies.},
