   Wensing, Joana; Carraresi, Laura; Broering, Stefanie, Univ Bonn Germany, Chair Technol \& Innovat Management Agribusiness, Inst Food \& Resource Econ, Meckenheimer Allee 174, D-53115 Bonn, Germany.},
DOI = {10.1016/j.jenvman.2018.11.114},
ISSN = {0301-4797},
EISSN = {1095-8630},
Keywords = {Fanners; Bioeconomy; Horticultural by-products; Adoption decision;
   VBN-theory; Structural equation model},
Keywords-Plus = {FACTORS INFLUENCING ADOPTION; AGRICULTURAL PRACTICES; CLIMATE-CHANGE;
