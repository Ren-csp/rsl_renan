ISSN = {0179-1613},
EISSN = {1439-0310},
Keywords = {anthropogenic disturbance; behavior and ecosystem services; feeding
   associations; human ecology; temporal interactions; urban ecology},
Keywords-Plus = {FLIGHT INITIATION DISTANCE; PREDATION RISK; FEAR; LANDSCAPE; PREY;
