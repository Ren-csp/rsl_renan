@article{ WOS:001869390800001,
Author = {Munoz-Garcia, Claudia I. and Tamayo-Aguilar, Martha L. and
   Rendon-Franco, Emilio and Ocampo Cervantes, Jose A. and Angulo-Lira,
   Juan P. and Sanchez-Aguillon, Fabiola and Zarate-Segura, Paola and
   Romero-Valdovinos, Mirza and Maravilla, Pablo and Martinez-Hernandez,
   Fernando and Villalobos, Guiehdani},
Title = {Presence of human adenovirus 36 in an urban rodent population},
Journal = {ROYAL SOCIETY OPEN SCIENCE},
Year = {2026},
Volume = {13},
Number = {8},
Month = {AUG 26},
Abstract = {Adenovirus 36 (AdV36) is a virus associated with respiratory and
   gastrointestinal infections in humans; interestingly, it also exhibits
   adipogenic potential, as demonstrated in experimental rodent infections
   and in human adipose tissue. To detect AdV36 in faecal samples from
   synanthropic rodents captured in Mexico City, a total of 55 wild rodents
   (15 Mus musculus and 40 Rattus norvegicus) were trapped in the public
   park `Canal Nacional' in the southeast of Mexico City. Animals were
   euthanized, and faecal samples were collected by necropsy.
   Epidemiological data were also recorded. Polymerase chain reaction (PCR)
   sequencing, phylogenetic, haplotype network and genetic variability
   analyses of the E1a and E3 AdV36 genes were performed. The proportion of
   faecal samples positive for the AdV36 E1a gene was 6.7\% in M. musculus
   and 35\% in R. norvegicus. Comparisons by body weight revealed
   significant differences among R. norvegicus-positive rats. Phylogenetic
   and haplotype analyses grouped these sequences within the AdV36 cluster
   and showed shared viral haplotypes with human AdV36 sequences. Our
   findings show that AdV36 can be detected in the faeces of synanthropic
   rodents and shares haplotypes with those found in humans, suggesting a
