@article{ WOS:000542629600381,
Author = {Mamera, Matthew and van Tol, Johan J. and Aghoghovwia, Makhosazana P.
   and Mapetere, Gabriel T.},
Title = {Community Faecal Management Strategies and Perceptions on Sludge Use in
   Agriculture},
