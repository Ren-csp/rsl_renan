@article{ WOS:001215774800040,
Author = {Xun, Guanhua and Zhu, Zhixin and Singh, Nilmani and Lu, Jingxia and
   Jain, Piyush K. and Zhao, Huimin},
Title = {Harnessing noncanonical crRNA for highly efficient genome editing},
Journal = {NATURE COMMUNICATIONS},
