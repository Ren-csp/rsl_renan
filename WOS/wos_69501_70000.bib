@article{ WOS:001876455300001,
Author = {Foggitt, Ella and Hoolohan, Claire and Browne, Alison},
Title = {Social perspectives on alternative water systems for new housing: a Q
   methodology study},
Journal = {SUSTAINABILITY-SCIENCE PRACTICE AND POLICY},
Year = {2026},
Volume = {22},
Number = {1},
Month = {DEC 31},
Abstract = {The multidimensional challenges facing water systems require fundamental
   changes in water management. Countries with centralized water
   infrastructures are exploring sustainable drainage systems, advanced
   water-efficiency measures, and water recycling. However, research is
   needed to better understand how public support and resistance may emerge
   as these options become more commonplace. This article reports on the
   findings of a mixed-methods study that explored people's priorities for
   future water and housing in England and Wales. The study examined the
   relative importance of water issues and other social and environmental
   challenges to understand implications for developing housing that
   incorporates alternative water systems. The findings show that no single
   public perspective exists on the future of water and housing. While we
   found broad support for alternative water infrastructures, this is
   accompanied by concerns about water governance and how new housing
   developments will address wider social (e.g., loneliness) and
   environmental problems (e.g., biodiversity loss). Trust in both
   technology and institutions is vital, and we analyze how trust
   intersects with proposals for fundamental changes in water management.
   Scientific, professional, and policy communities increasingly advocate
   for systemic changes to water infrastructures and related community and
   professional practices. This article demonstrates the need to recognize
   these different perspectives on water futures and develop solutions that
   acknowledge not only the diversity of physical environments, but also
   public perspectives and practices.},
