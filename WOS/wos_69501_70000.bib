@article{ WOS:001721287300007,
Author = {Ball, Jacob J. and Beauchamp, A. J. (Tony) and Brunton, Dianne H.},
Title = {Adult New Zealand fairy tern/tara iti (Sternula nereis
   davisae) foraging trips to estuarine feeding territories during
   chick provisioning},
Journal = {NOTORNIS},
Year = {2025},
Volume = {72},
Number = {1},
Pages = {61-72},
Abstract = {The New Zealand fairy tern/tara iti (Sternula nereis davisae)
   (hereafter; tara iti) is Aotearoa's rarest indigenous breeding bird.
   Knowledge of tara iti foraging behaviour is limited. We used coordinated
   observations of adult movements between nesting sites and foraging
   territories to quantify foraging trips during chick provisioning at
   Mangawhai, Northland, in the 2021/22 breeding season. Complete foraging
   trips (n = 88) of five females and four males were observed. Males (n =
   60 trips) undertook more foraging trips than females (n = 28 trips).
   Overall, foraging trip durations were 17.0 +/- 1.0 mins (x +/- se) and
   adults foraged for 98.7\% of the time they were observed on territory.
   No differences in either foraging duration or time spent foraging were
   detected between sexes or with foraging territory distance from nests.
   However, the pair on the territory closest to the nesting area had the
   longest trip durations; this estuarine area also had the highest human
   use. Foraging trips were significantly shorter for adults feeding older
   chicks and longer on weekend days. Foraging durations remained stable
   across the 2021/2022 breeding season and showed no relationship with
   abiotic conditions. Finally, we used estimates of flight speeds and trip
   durations to approximate a foraging range of 10.6 +/- 5.7 km (x +/- se)
   for nesting tara iti. Our results support the conclusion that tara iti
   rely on a broader foraging range than previously thought, utilising both
   estuarine and coastal marine habitats during chick provisioning. This
   reinforces the critical need for further investigation using tools such
   as GPS tracking. The availability of prey within the Mangawhai estuary
   was outside of the scope of our research but should be a priority for
   future research.},
