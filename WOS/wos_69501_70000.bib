@article{ WOS:000376617000001,
Author = {Yue, Jiping and Zhang, Yao and Liang, Wenguang G. and Gou, Xuewen and
   Lee, Philbert and Liu, Han and Lyu, Wanqing and Tang, Wei-Jen and Chen,
   Shao-Yu and Yang, Feng and Liang, Hong and Wu, Xiaoyang},
Title = {In vivo epidermal migration requires focal adhesion targeting of
   ACF7},
Journal = {NATURE COMMUNICATIONS},
Year = {2016},
Volume = {7},
Month = {MAY},
Abstract = {Turnover of focal adhesions allows cell retraction, which is essential
   for cell migration. The mammalian spectraplakin protein, ACF7
   (Actin-Crosslinking Factor 7), promotes focal adhesion dynamics by
   targeting of microtubule plus ends towards focal adhesions. However, it
   remains unclear how the activity of ACF7 is regulated spatiotemporally
   to achieve focal adhesion-specific guidance of microtubule. To explore
   the potential mechanisms, we resolve the crystal structure of ACF7's NT
   (amino-terminal) domain, which mediates F-actin interactions. Structural
   analysis leads to identification of a key tyrosine residue at the
   calponin homology (CH) domain of ACF7, whose phosphorylation by Src/FAK
   (focal adhesion kinase) complex is essential for F-actin binding of
   ACF7. Using skin epidermis as a model system, we further demonstrate
   that the phosphorylation of ACF7 plays an indispensable role in focal
   adhesion dynamics and epidermal migration in vitro and in vivo.
   Together, our findings provide critical insights into the molecular
   mechanisms underlying coordinated cytoskeletal dynamics during cell
   movement.},
