@article{ WOS:001783889900001,
Author = {Genceli, Demet and Akay, Ecem},
Title = {Green scandals behind the curtain: a qualitative study of misleading
   sustainability practices in tourism},
Journal = {FRONTIERS IN SUSTAINABILITY},
Year = {2026},
Volume = {7},
Month = {MAY 21},
Abstract = {In recent years, sustainability has become central to marketing in
   tourism as well as in the food and beverage sectors. However, many
   companies wield this narrative as a promotional tool rather than as a
   reflection of actual practices, raising concerns about greenwashing.
   This study critically examines the gap between sustainability claims and
   actual practices in the tourism and hospitality industries (including
   food and beverage services) through qualitative analysis of 23
   real-world greenwashing cases. Secondary data from news media, corporate
   reports, and academic literature were analyzed using thematic content
   analysis and multiple case study revealing five major forms of
   misleading conduct: questionable eco-certification use, inadequate waste
   management, misleading carbon offsetting claims, unsustainable resource
   use at destinations, and masking of socio-environmental harm under the
   label of ``green{''} development. The findings highlight a significant
   disparity between promised and actual sustainability efforts, often
   eroding consumer trust, harming local communities, and undermining
   ecological integrity. Based on these insights, the study suggests
   practical measures such as stricter auditing of environmental claims,
   improved traceability of sustainability initiatives, and more inclusive
   governance to enhance transparency and accountability. The concept of
   green scandals is introduced to expand theoretical understanding of
   corporate sustainability communication beyond conventional greenwashing.
   This research contributes to theory by illuminating how sustainability
   narratives are manipulated in practice, and to practice by offering
   actionable recommendations for policymakers and industry practitioners
   to curb greenwashing and promote genuine sustainable practices.},
