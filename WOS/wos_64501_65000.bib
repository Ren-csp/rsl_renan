@article{ WOS:001174748200001,
Author = {Xu, Wanyun and Xu, Lingxia and Cao, Yuqi and Zheng, Jiaoyang and Wang,
   Yaling and Cheng, Kun and Lee, Chun-Hung and Dai, Huxuan and Mei,
   Sonamtso and Zong, Cheng},
Title = {Community perspectives of flagship species: can conservation motivators
   mitigate human-wildlife conflict?},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2024},
Volume = {12},
Month = {FEB 19},
Abstract = {Public perception of endangered species is crucial for successful
   management of community-based conservation and sustainability of
   national parks. By the method of choice experiment, our study evaluated
   conservation preferences and willingness to donate money for flagship
   and non-flagship species using a choice experiment with 409 residents
   living near the Lanstang river source of Sanjiangyuan National Park,
   China. We found that flagship species such as the Snow leopard (Pristine
   plateau) and White-lipped deer (Przewalskium albirostris) generated more
   conservation funds than non-flagship species. However, not all flagship
   species were accepted. Respondents disliked Tibetan brown bears (Ursus
   arctos pruinosus) due to direct human-wildlife conflicts such as bodily
   injury and property damage. Heterogeneity of preference was influenced
   by household income, religious beliefs, ethnicity, culture, and
   conservation awareness. Results can be used to establish a local
   community-participative framework by combining conservation motivations
   that alleviate human-wildlife conflict.},
