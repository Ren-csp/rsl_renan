@article{ WOS:001758347600001,
Author = {Yu, Jie and Chen, Xin and Lin, Yi and Zhang, Tinghui and Gao, Chen and
   Li, Lang and Yang, Yuxuan},
Title = {Mapping Economic Sustainability Dynamics in China over the Last 20 Years},
Journal = {JOURNAL OF REMOTE SENSING},
Year = {2026},
Volume = {6},
Month = {MAY 7},
Abstract = {Economic development is a cornerstone of national development, and
   sustainable economic development is a key focus for achieving broader
   sustainable development goals. Existing economic studies based on
   nighttime light remote sensing often center on gross domestic product
   (GDP) as the primary parameter. This study introduces a comprehensive
   framework based on the economics' ``growth, poverty, and inequality{''}
   (GPI) trilemma to generate the first long-term, high-resolution maps of
   China's economic sustainability. Then, the spatiotemporal evolution
   pattern of China's economic sustainability was deeply explored at
   multiple scales. The results reveal that China has made substantial
   strides in economic sustainability since 2001, with over 317 million
   people transitioning out of low-sustainability areas. However, marked
   spatial variations existed across China. The eastern regions have
   experienced the largest increase, while the central regions showed the
   highest growth potential. The western regions have been steadily
   developing, whereas the northeast faces challenges with negative growth
   in some areas. Uneven population distribution across various
   sustainability levels was found. The highest population density is
   concentrated in medium-high sustainability level, with more than 41.7\%
   population inhabiting only 4.1\% of the country's area in 2021. While
   unbalanced development persisted, there are signs of alleviation, as
   evidenced by stronger linkage between provinces and less directional
   expansion within each regional zone. The generated long-term,
   high-resolution economic sustainability maps and multiscaled
   spatiotemporal analysis provide valuable insights into the realization
   of China's economic development and sustainability goals. These findings
   can assist the government in making decisions on economic policies.},
