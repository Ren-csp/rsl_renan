@article{ WOS:001631650800001,
Author = {Ha, Nguyen Thi Vinh and Chinh, Tran Cong and Thuc, Nguyen Hong and Tran,
   Thuc Han and Le, Hai Dinh},
Title = {Valuation of the Trang An karst system using contingent valuation method
   and choice experiment},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {DEC 7},
Abstract = {Trang An Landscape Complex is a World Cultural and Natural Heritage with
   outstanding universal value owing to its remarkable scenery and rich
   traditional culture. This study contributes to UNESCO-listed heritage
   evaluation methodology by combining Contingent Valuation Method (CVM)
   and Choice Experiment (CE) to consider the current and potential for
   conservation scenarios. The research results indicate the worth of the
   Trang An complex's karst system is between 125 and 133 million USD per
   year and it will be five times larger in improvement scenarios. The
   perception of the threats to the karst landscape is an important factor
   to the karst value. The research findings demonstrate the importance of
   preserving this system. The conservation concept entails incorporating
   sustainable development principles into urban planning, prioritizing
   green, environmentally friendly solutions, and using smart planning
   models based on big data to foresee and mitigate the impact of
   urbanization.},
