@article{ WOS:001003115900020,
Author = {Peris, David and Ubbelohde, Emily J. and Kuang, Meihua Christina and
   Kominek, Jacek and Langdon, Quinn K. and Adams, Marie and Koshalek,
   Justin A. and Hulfachor, Amanda Beth and Opulente, Dana A. and Hall,
   David J. and Hyma, Katie and Fay, Justin C. and Leducq, Jean-Baptiste
   and Charron, Guillaume and Landry, Christian R. and Libkind, Diego and
   Goncalves, Carla and Goncalves, Paula and Sampaio, Jose Paulo and Wang,
