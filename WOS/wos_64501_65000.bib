@article{ WOS:001772249100001,
Author = {Hollerbach, Brittany S. and Ridenour, Susan and Sutherland, Carrie and
   Koeppel, Maria D. H. and Jitnarin, Nattinee and Valenti, Michelle and
   Edwards, Derrick L. and Jack, Kepra and Burgess, Jefferey L. and Jahnke,
   Sara A.},
Title = {``Left Out at the Kitchen Table{''}: Exploring Peer Support Needs Among
   Women Firefighters},
Journal = {AMERICAN JOURNAL OF INDUSTRIAL MEDICINE},
Year = {2026},
Volume = {69},
Number = {8},
Pages = {622-630},
Month = {AUG},
Abstract = {Introduction Firefighting is a high-stress, high-risk occupation with
   well-documented physical, mental, and behavioral health challenges.
   While women firefighters report behavioral health outcomes similar to
   men when working in supportive environments, rates of depression,
   anxiety, and PTSD increase significantly in the context of workplace
   discrimination and exclusion. These challenges, often dismissed as human
   resources issues, emerge as critical health and safety concerns. Despite
   the growing adoption of peer support programs in the fire service,
   little is known about how these resources can be tailored to the needs
   of women firefighters.Methods This qualitative study used an inductive
   thematic analysis approach to explore women firefighters' perceptions
   and experiences with peer support in the fire service. Researchers
   conducted semi-structured interviews with 35 women firefighters and key
   fire service stakeholders across the United States. Interviews explored
   perceptions of peer support, barriers to engagement, trust and comfort
   within peer support networks, and preferred communication and messaging
   strategies.Results Participants described widespread concerns related to
   stigma, confidentiality, and access to culturally competent care.
   Thematic analysis revealed seven key domains: barriers to support,
   effective messaging, the role of peer support, gendered workplace
   dynamics, resource needs, leadership influence, and stress relief
   strategies. Many participants emphasized the importance of inclusive,
   integrated support programs that acknowledge but do not isolate women in
   the fire service.Discussion Findings highlight the need for proactive,
   inclusive peer support strategies that reflect the lived experiences of
   women firefighters. Insights from these interviews provide critical
   guidance for the development of peer support resources that foster
   connection, trust, and psychological safety.},
