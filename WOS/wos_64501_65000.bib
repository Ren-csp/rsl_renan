Author = {Moreno, Liliana Ramirez and Kieffer, Maxime and Guerrero, Andres Camou},
Title = {Factors influencing the development of community-based alternative
   tourism experiences: the case of the Arocutín volcanic stone area
   (Itzira Ahuacuti)},
Journal = {PERIPLO SUSTENTABLE},
Year = {2026},
Number = {50},
Pages = {208-230},
Month = {JAN-JUN},
Abstract = {The objective of this research was to analyze, ex ante, the factors that
   favor orhinderthe construction of a community-based alternative tourism
   experience (CBATE) for the sustainable use of the Arocut \& iacute;n
   volcanic stone area in Michoac \& aacute;n, Mexico, by combining two
   types of factors: those that influence the construction and management
   of CBATEs and those that affect the collective organization for the
   sustainable use of common-pool resources. Information was obtained
   through semi-structured interviews with local authorities. The results
   showed that all the factors analyzed contained elements that both
   facilitate and limit the construction of a CBATE. Among the facilitating
   elements were the presence of local resources, collective ownership and
   management, autonomy in decision-making, and the intrinsic and use value
   of the volcanic stone area. The limiting elements were the lack of
   reciprocal and trusting relationships that allow monitoring and
   enforcement of the rules for use of the volcanic stone area, the
   perception that this resource is inexhaustible, and the lack of
   knowledge about tourism. It is concluded that for the construction of a
   CBATE in the volcanic stone area, it is necessary to address the
   identify limitations. Furthermore, this research provides useful
   information for future decision-making, contributing to the research on
   tourism planning in rural community contexts.},
Publisher = {UNIV AUTONOMA ESTADO MEXICO, FAC TURISMO GASTRONOMIA},
