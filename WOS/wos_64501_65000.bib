@article{ WOS:001347950800001,
Author = {Shi, L. and Yang, L. Y. and Hua, D. W. and Sun, Z. H. and He, L. R.},
Title = {MAPPING ECOLOGICAL TRENDS BY KEYWORDS IN THE LAST 30 YEARS},
