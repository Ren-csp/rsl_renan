@article{ WOS:000727788300009,
Author = {Espinal Ruiz, Dario Jose and Rojas Nunez, Claudia Fernanda and Reyes
   Velasco, Miguel Fernando and Cruz Gonzalez, Natali and Velez Sanchez,
   Lina Marcela},
Title = {Influence of urban development on the sustainable legacy of
   international sports events},
Journal = {CULTURA CIENCIA Y DEPORTE},
Year = {2021},
Volume = {16},
Number = {50},
Pages = {631-642},
Month = {DEC},
Abstract = {The purpose of this study is to identify the effects of the urban
   development legacy on the sustainable legacy (economic, sociocultural,
   environmental and sports) of international sports events. 292 surveys
   were applied to the direct stakeholders of the sporting events in
   Santiago de Cali-Colombia, using a questionnaire structured in five
   constructs and 28 items. Goodness of fit, composite reliability,
   discriminant validity and the proposed structural model were examined
   using the partial least squares (PLS-SEM) path modeling method in ADANCO
   software. The results indicate that the legacy of urban development has
   a significant influence on the economic (p=<.001), sociocultural
   (p=<.001), environmental (p=<.001) and sports (p=<.001) legacies. This
   article contributes to the existing literature providing knowledge from
   a quantitative approach on the factors that influence the sustainable
   legacy of international sports events.},
