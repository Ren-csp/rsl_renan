@article{ WOS:001454779400001,
Author = {Tillermuir, Hannah and Carboni, Lara and Hotchin, Cody and Lal, Harrison
   and Morrison, Rosie},
Title = {A holistic framework to improve urban flood management in cities with
   informal settlements},
Journal = {ENVIRONMENTAL RESEARCH: INFRASTRUCTURE AND SUSTAINABILITY},
Year = {2025},
Volume = {5},
Number = {1},
Month = {MAR 31},
Abstract = {Urban flooding is being exacerbated by climate change and rapid
   urbanisation. Informal settlements often disproportionately experience
   the negative impacts of flooding due to their location, perceived
   transience, and socio-economic vulnerabilities. This study sought to
   develop a novel and holistic framework which policy makers, engineers
   and other stakeholders can use to design and implement more inclusive
   urban flood management (UFM) in informal settlements. A systematic
   review was conducted and five key themes relevant to UFM in informal
   settlements were identified: governance, community capacity, resilience,
   perception of floods, and future thinking. These themes were then
   transformed into a framework that captures their interconnectedness. A
   discussion then highlights the challenges that may occur when applying
   this framework to informal settlements, emphasizing the need for
   pragmatism.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
