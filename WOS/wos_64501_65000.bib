@article{ WOS:000477233400001,
Author = {Albert, Jeffrey M. and Li, Youjun and Su, Jiayang and Woyczynski, Wojbor
   A. and Nelson, Suchitra},
Title = {Continuous-time causal mediation analysis},
Journal = {STATISTICS IN MEDICINE},
Year = {2019},
Volume = {38},
