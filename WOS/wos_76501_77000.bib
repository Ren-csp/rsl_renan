@article{ WOS:000302969500022,
Author = {Arcury, Thomas A. and O'Hara, Heather and Grzywacz, Joseph G. and Isom,
   Scott and Chen, Haiying and Quandt, Sara A.},
Title = {Work Safety Climate, Musculoskeletal Discomfort, Working While Injured,
   and Depression Among Migrant Farmworkers in North Carolina},
