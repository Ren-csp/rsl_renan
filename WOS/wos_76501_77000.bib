@article{ WOS:000479242800004,
Author = {Ullah, Wahid and Nafees, Muhammad and Khurshid, Muhammad and Nihei,
   Takaaki},
Title = {Assessing farmers' perspectives on climate change for effective
   farm-level adaptation measures in Khyber Pakhtunkhwa, Pakistan},
