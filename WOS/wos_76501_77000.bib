@article{ WOS:000469410200021,
Author = {Schwikkard, Sianne and Whitmore, Hannah and Sishtla, Kamakshi and
   Sulaiman, Rania S. and Shetty, Trupti and Basavarajappa, Halesha D. and
   Waller, Catherine and Alqahtani, Alaa and Frankemoelle, Lennart and
   Chapman, Andy and Crouch, Neil and Wetschnig, Wolfgang and Knirsch,
   Walter and Andriantiana, Jacky and Mas-Claret, Eduard and Langat, Moses
   K. and Mulholland, Dulcie and Corson, Timothy W.},
Title = {The Antiangiogenic Activity of Naturally Occurring and Synthetic
   Homoisoflavonoids from the Hyacinthaceae (sensu APGII)},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2019},
Volume = {82},
Number = {5},
Pages = {1227-1239},
Month = {MAY},
Abstract = {Excessive blood vessel formation in the eye is implicated in wet
   age-related macular degeneration, proliferative diabetic retinopathy,
   neovascular glaucoma, and retinopathy of prematurity, which are major
   causes of blindness. Small molecule antiangiogenic drugs are strongly
   needed to supplement existing biologics. Homoisoflavonoids have been
   previously shown to have potent antiproliferative activities in
   endothelial cells over other cell types. Moreover, they demonstrated a
   strong antiangiogenic potential in vitro and in vivo in animal models of
   ocular neovascularization. Here, we tested the antiangiogenic activity
   of a group of naturally occurring homoisoflavonoids isolated from the
   family Hyacinthaceae and related synthetic compounds, chosen for
   synthesis based on structure-activity relationship observations. Several
   compounds showed interesting antiproliferative and antiangiogenic
   activities in vitro on retinal microvascular endothelial cells, a
   disease-relevant cell type, with the synthetic chromane, 46, showing the
   best activity (GI(50) of 2.3 x 10(-4) mu M).},
Publisher = {AMER CHEMICAL SOC},
Address = {1155 16TH ST, NW, WASHINGTON, DC 20036 USA},
Type = {Article},
