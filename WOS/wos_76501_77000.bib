@article{ WOS:000430645500013,
Author = {Barbieri, Fabio Augusto and Polastri, Paula Favaro and Bucken Gobbi,
   Lilian Teresa and Simieli, Lucas and Alota Pereir, Vinicius Ignacio and
   Baptist, Andre Macari and Moretto, Gabriel Felipe and Fiorelli, Carolina
