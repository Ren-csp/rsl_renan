@article{ WOS:000358930600010,
Author = {Ito, Takuhiro and Masuda, Isao and Yoshida, Ken-ichi and Goto-Ito,
   Sakurako and Sekinea, Shun-ichi and Suh, Se Won and Houd, Ya-Ming and
   Yokoyama, Shigeyuki},
Title = {Structural basis for methyl-donor-dependent and sequence-specific
   binding to tRNA substrates by knotted methyltransferase TrmD},
