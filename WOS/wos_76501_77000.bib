@article{ WOS:000255868400057,
Author = {Yu, Xuekui and Jin, Lei and Zhou, Z. Hong},
Title = {3.88 Å structure of cytoplasmic polyhedrosis virus by cryo-electron
   microscopy},
Journal = {NATURE},
Year = {2008},
