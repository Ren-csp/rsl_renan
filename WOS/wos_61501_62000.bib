@article{ WOS:A1996UR52400007,
Author = {Sellal, F and Fontaine, SF and VanDerLinden, M and Rainville, C and
   Labrecque, R},
Title = {To be or not to be at, home? A neuropsychological approach to delusion
   for place},
Journal = {JOURNAL OF CLINICAL AND EXPERIMENTAL NEUROPSYCHOLOGY},
Year = {1996},
Volume = {18},
Number = {2},
Pages = {234-248},
Month = {APR},
Abstract = {A woman, LB, while in recovery from a viral encephalitis, exhibited a
   delusion for place, which led her to insist that she was at home, in
   spite of compelling evidence to the contrary. Later, she developed a
   Capgras syndrome, that is, another misidentification syndrome. The
   patient was given a detailed neuropsychological evaluation to shed some
   light on the mechanisms underlying her delusional misbelief. Two main
   deficits were in evidence: (1) a severe visual-spatial impairment,
   giving the patient a distorted perception of her surroundings; and (2)
   frontal lobe dysfunction, which played a critical role in her impulsive
   responses and lack of self-awareness. The pathogenesis of delusion for
   place and persons is discussed in light of these observations.},
