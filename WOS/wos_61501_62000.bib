Author = {Prompetchara, Eakachai and Ketloy, Chutitorn and Alameh, Mohamad-Gabriel
   and Tharakhet, Kittipan and Kaewpang, Papatsara and Yostrerat,
   Nongnaphat and Pitakpolrat, Patrawadee and Buranapraditkun, Supranee and
