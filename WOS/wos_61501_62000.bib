@article{ WOS:001870209500001,
Author = {Costa, Daiane de Oliveira and Rodrigues, Vasco Sanchez and Nascimento,
   Francisco Ramon Alves do and Ruiz-Benitez, Rocio and Freires, Francisco
   Gaudencio Mendonca},
Title = {Taxonomy of circular economy practices aimed at preventing and reducing
   food waste in retail},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {576},
Month = {SEP 20},
Abstract = {Food loss and waste (FLW) in food retail poses critical challenges at
   the intersection of environmental sustainability and circular economy
   (CE) transitions. Despite growing scholarly attention, approaches to
   preventing and reducing FLW remain fragmented, with uneven adoption
   across institutional contexts. This study develops a systematic taxonomy
   of CE practices and applies it in a comparative analysis of Brazil and
   Spain, two countries with contrasting institutional contexts for
   circular economy implementation. A systematic literature review
   identified 233 practices, which were consolidated into a taxonomy of 33
   CE practices organized into five hierarchical categories based on value
   preservation: food surplus prevention, avoidable waste prevention,
   reuse, recycling, and recovery. An Importance-Performance Analysis (IPA)
   assessed specialists' perceptions of the strategic importance and
   implementation of each practice. The findings indicate that, although CE
   practices were consistently perceived as highly important in both
   countries, their implementation differed substantially. Higher
   implementation levels in Spain were associated with a more consolidated
   regulatory environment, technological infrastructure, and coordinated
   governance, whereas wider implementation gaps in Brazil were linked to
   technological limitations and institutional fragmentation. This study
   contributes by systematizing retail-oriented CE practices into an
   integrated taxonomy, operationalizing the distinction between food
   surplus prevention and avoidable waste prevention, and showing how
   institutional conditions shape the adoption of CE practices. The
   findings provide practical guidance for retailers in prioritizing
   circular interventions and inform policymakers on institutional actions
   needed to accelerate food waste prevention and support progress toward
   Sustainable Development Goal (SDG) 12.3.},
