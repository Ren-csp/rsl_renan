@article{ WOS:001866040200001,
Author = {Sinclair, Ian and Maheshwari, Basant and Reynolds, Jason K.},
Title = {Feeding Cities at the Fringe: The Role and Value of Peri-Urban
   Agriculture in Western Sydney, Australia},
Journal = {JOURNAL OF SUSTAINABLE AGRICULTURE AND ENVIRONMENT},
Year = {2026},
Volume = {5},
Number = {3},
Month = {SEP 2},
Abstract = {Producing food in the face of global population growth and urbanisation
   has become a critical challenge. Peri-urban areas, the transitional
   spaces on the outskirts of cities, play a crucial role in agricultural
   food production, yet they are subject to rapid changes due to urban
   encroachment. This article examines the peri-urban conflict in Western
   Sydney, Australia, where agricultural lands are consumed by urban and
   rural residential development. Using data from the Australian Bureau of
   Statistics (ABS), the study analyses the contribution of peri-urban
   areas to vegetable production. The results reveal that the Sydney
   Peri-Urban Area is the primary region for perishable vegetable
   production in New South Wales, contributing 46\% of the total production
   value. This study is the first to combine detailed ABS data sets to
   demonstrate both the scale and value of peri-urban food production in
   Sydney. It highlights the significance of peri-urban areas in supplying
   fresh produce close to the market and population centres. It emphasises
   the need to preserve agricultural land to ensure food security. The
   changing food production scenarios in peri-urban areas demand continuous
   spatial reconfiguration, making the protection of these lands a complex
   challenge. Effective preservation strategies require addressing land use
   conflicts, negative public perceptions, economic factors and
   environmental concerns. This research highlights the significance of
   peri-urban agriculture in maintaining food supply and advocates for
   informed urban planning policies that protect agricultural lands during
   urban expansion.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
