@article{ WOS:000316377400043,
Author = {Minnihan, Ellen C. and Ando, Nozomi and Brignole, Edward J. and
   Olshansky, Lisa and Chittuluru, Johnathan and Asturias, Francisco J. and
   Drennan, Catherine L. and Nocera, Daniel G. and Stubbe, JoAnne},
Title = {Generation of a stable, aminotyrosyl radical-induced α2β2 complex of
   Escherichia coli class Ia ribonucleotide reductase},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2013},
Volume = {110},
Number = {10},
Pages = {3835-3840},
Month = {MAR 5},
Abstract = {Ribonucleotide reductase (RNR) catalyzes the conversion of nucleoside
   diphosphates to deoxynucleoside diphosphates (dNDPs). The Escherichia
   coli class Ia RNR uses a mechanism of radical propagation by which a
   cysteine in the active site of the RNR large (alpha 2) subunit is
   transiently oxidized by a stable tyrosyl radical (Y circle) in the RNR
   small (beta 2) subunit over a 35-angstrom pathway of redox-active amino
   acids: Y-122 circle <-> {[}W-48?] <-> Y-356 in beta 2 to Y-731 <-> Y-730
   <-> C-439 in alpha 2. When 3-aminotyrosine (NH2Y) is incorporated in
   place of Y-730, a long-lived NH2Y730 circle is generated in alpha 2 in
   the presence of wild-type (wt)-beta 2, substrate, and effector. This
   radical intermediate is chemically and kinetically competent to generate
   dNDPs. Herein, evidence is presented that NH2Y730 circle induces
   formation of a kinetically stable alpha 2 beta 2 complex. Under
   conditions that generate NH2Y730 circle binding between Y730NH2Y-alpha 2
   and wt-beta 2 is 25-fold tighter (K-d = 7 nM) than for wt-alpha 2
   vertical bar wt-beta 2 and is cooperative. Stopped-flow fluorescence
   experiments establish that the dissociation rate constant for the
   Y730NH2Y-alpha 2 vertical bar wt-beta 2 interaction is similar to
   10(4)-fold slower than for the wt subunits (similar to 60 s(-1)). EM and
   small-angle X-ray scattering studies indicate that the stabilized
   species is a compact globular alpha 2 beta 2, consistent with the
   structure predicted by Uhlin and Eklund's docking model {[} Uhlin U,
   Eklund H (1994) Nature 370(6490):533-539]. These results present a
   structural and biochemical characterization of the active RNR complex
   ``trapped{''} during turnover, and suggest that stabilization of the
   alpha 2 beta 2 state may be a regulatory mechanism for protecting the
   catalytic radical and ensuring the fidelity of its reactivity.},
