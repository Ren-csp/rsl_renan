@article{ WOS:001825808800001,
Author = {van Gils, M. and Weeland, J. and Slingerland, G. and Wehrmann, C. and
   Trienekens, O. and van Dorst, M. J.},
Title = {Neighbourhood ties: a social and spatial capital approach},
Journal = {PLANNING PRACTICE AND RESEARCH},
Year = {2026},
Month = {2026 JUL 20},
Abstract = {This study explores how residents use and experience their living
   environment, focusing on the social affordances of neighbourhood places.
   Through narrative mapping in group sessions in a case study
   neighbourhood in Rotterdam, nineteen residents, including less-heard
   groups, mapped their living environments and reflected on their
   experiences. While residents primarily engage within their
   neighbourhood, perceptions of safety and territorial claims shape how
   places are used, particularly in parks and community hubs. By
   foregrounding lived experience, the study shows how social affordances
   take shape in neighbourhood places and give rise to uneven potentials
   for social and spatial capital formation.},
