@article{ WOS:001764655300001,
Author = {Beattie, Graham and Meyer, Andrew},
Title = {Does the media respond to political messaging? Evidence from local
   newspaper coverage of climate change},
Journal = {JOURNAL OF ENVIRONMENTAL ECONOMICS AND MANAGEMENT},
Year = {2026},
Volume = {138},
Month = {JUN},
Abstract = {Despite the scientific consensus around climate change, skepticism among
   the general public remains an obstacle for policy. Because the media is
   the primary channel for information dissem ination, media coverage of
   climate change plays a crucial role in public perceptions. We identify
   an important factor shaping this coverage-influence of political
   leaders. Using a regression dis continuity analysis around narrow
   election victories, we find that a Republican governor causes local
   newspapers in their state to use a more skeptical tone when discussing
   climate change.},
