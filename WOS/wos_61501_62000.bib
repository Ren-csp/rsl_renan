@article{ WOS:001835106500001,
Author = {Viana, Joao Garibaldi Almeida and da Silva, Fernanda Novo and Vargas,
   Leticia Paludo and Valle, Carine Dalla and Cordeiro, Marcio Pereira and
   Silveira, Vicente Celestino Pires},
Title = {Ecosystem service trade-offs in extensive and integrated live-stock
   systems of the Brazilian Pampa biome},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {Land-use transformations are reshaping the Brazilian Pampa biome, where
   crops, particularly soybeans, are increasingly replacing native
   grasslands. Despite growing attention to ecosystem services in livestock
   systems, comparative evidence on how different production arrangements
   shape trade-offs among provisioning, regulating, and cultural services
   in grassland biomes remains limited. This study assesses and compares
   the ecosystem services provided by extensive livestock systems (ELS) and
   integrated livestock systems (ILS) in the Brazilian Pampa biome, with
   emphasis on trade-offs among provisioning, regulating, and cultural
   services. Data were collected from 121 farms in the Ibirapuita River
   Basin through a structured survey and georeferenced sampling. Thirty
   ecosystem service indicators were derived from the MESMIS framework and
   grouped into three categories-Provisioning, Regulating, and
   Cultural-following the CICES classification. A linear mixed-effects
   model, with farm as a random intercept, tested the effects of production
   system, service category, and their interaction. Estimated marginal
   means and pairwise contrasts were calculated, with p-values adjusted
   using the false discovery rate. Results indicate that ELS deliver higher
   levels of provisioning services, reflecting the ecological role of
   native grasslands. In contrast, ILS achieve significantly higher
   cultural service scores, associated with social participation,
   succession, and community integration. The indicators of management and
   perception related to regulating services did not differ significantly
   between systems. Effect sizes reveal moderate trade-offs between
   provisioning and cultural dimensions, with a small, non-significant
   difference for regulating services. As the regulating indicators capture
   management and perception proxies rather than direct biophysical fluxes,
   these results should not be interpreted as evidence of ecological
   equivalence in the underlying regulating processes.},
