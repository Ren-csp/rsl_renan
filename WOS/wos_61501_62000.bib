@article{ WOS:000597547100001,
Author = {Mustafa, Ruba M. and Alshali, Ruwaida Z. and Bukhary, Dalea M.},
Title = {Dentists' Knowledge, Attitudes, and Awareness of Infection Control
   Measures during COVID-19 Outbreak: A Cross-Sectional Study in Saudi
   Arabia},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {23},
Month = {DEC},
Abstract = {As antiviral vaccines are still pending for the COVID-19 disease,
   improving dentists' knowledge and prevention measures is important. This
   study aimed to assess dentists' knowledge, attitude, and perception of
   COVID-19 in Saudi Arabia during the early outbreak period. In addition,
   infection control measures for dental setting were also assessed. Online
   questionnaire was distributed to dentists in different regions of Saudi
   Arabia when COVID-19 outbreak in Saudi Arabia was at its beginning. The
   questionnaire was assessing demographic variables, knowledge, attitude,
   risk perception, and preparedness towards COVID-19. Questions regarding
   infection control measures were also included. The correct incubation
   period of the virus was recognized by 43\% of participants. Fever,
   cough, and shortness of breath were the mostly recognized symptoms for
   COVID-19 (98.9\%, 95.5\%, and 93.3\% respectively). Participants in age
   groups >= 60, 50-59, and 20-29 years old were more likely to perceive
   COVID-19 as a very dangerous disease compared to 30-39 and 40-49 age
   groups. Dentists in Saudi Arabia showed satisfactory knowledge and
   positive attitude towards COVID-19. Improving dentists' level of
   knowledge could be achieved through increasing their accessibility to
   materials provided by dental health care authorities, which specifies
   the best and safest approaches for dealing with patients during and
   after the outbreak.},
