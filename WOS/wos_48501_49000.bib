@article{ WOS:000261225600032,
Author = {Russell, Rupert J. and Kerry, Philip S. and Stevens, David J. and
   Steinhauer, David A. and Martin, Stephen R. and Gamblin, Steven J. and
   Skehel, John J.},
Title = {Structure of influenza hemagglutinin in complex with an inhibitor of
   membrane fusion},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2008},
Volume = {105},
Number = {46},
Pages = {17736-17741},
Month = {NOV 18},
Abstract = {The influenza surface glycoprotein hemagglutinin (HA) is a potential
   target for antiviral drugs because of its key roles in the initial
   stages of infection: receptor binding and the fusion of virus and cell
   membranes. The structure of HA in complex with a known inhibitor of
   membrane fusion and virus infectivity, tert-butyl hydroquinone (TBHQ),
   shows that the inhibitor binds in a hydrophobic pocket formed at an
   interface between HA monomers. Occupation of this site by TBHQ
   stabilizes the neutral pH structure through intersubunit and
   intrasubunit interactions that presumably inhibit the conformational
   rearrangements required for membrane fusion. The nature of the binding
   site suggests routes for the chemical modification of TBHQ that could
   lead to the development of more potent inhibitors of membrane fusion and
   potential anti-influenza drugs.},
