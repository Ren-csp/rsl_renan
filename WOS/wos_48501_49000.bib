@article{ WOS:001271445000038,
Author = {Cai, Huiqiang and Zhang, Bin and Ahrenfeldt, Johanne and Joseph, Justin
   V. and Riedel, Maria and Gao, Zongliang and Thomsen, Sofie K. and
   Christensen, Ditte S. and Bak, Rasmus O. and Hager, Henrik and Vendelbo,
   Mikkel H. and Gao, Xin and Birkbak, Nicolai and Thomsen, Martin K.},
Title = {CRISPR/Cas9 model of prostate cancer identifies Kmt2c deficiency as a
   metastatic driver by Odam/Cabs1 gene cluster expression},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAR 7},
Abstract = {Metastatic prostate cancer (PCa) poses a significant therapeutic
   challenge with high mortality rates. Utilizing CRISPR-Cas9 in vivo, we
   target five potential tumor suppressor genes (Pten, Trp53, Rb1, Stk11,
   and RnaseL) in the mouse prostate, reaching humane endpoint after eight
   weeks without metastasis. By further depleting three epigenetic factors
   (Kmt2c, Kmt2d, and Zbtb16), lung metastases are present in all mice.
   While whole genome sequencing reveals few mutations in coding sequence,
   RNA sequencing shows significant dysregulation, especially in a
   conserved genomic region at chr5qE1 regulated by KMT2C. Depleting Odam
   and Cabs1 in this region prevents metastasis. Notably, the gene
   expression signatures, resulting from our study, predict
   progression-free and overall survival and distinguish primary and
   metastatic human prostate cancer. This study emphasizes positive genetic
   interactions between classical tumor suppressor genes and epigenetic
   modulators in metastatic PCa progression, offering insights into
   potential treatments.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Thomsen, MK (Corresponding Author), Aarhus Univ, Dept Biomed, Aarhus, Denmark.
   Thomsen, MK (Corresponding Author), Aarhus Univ, Aarhus Inst Adv Studies AIAS, Aarhus, Denmark.
   Cai, Huiqiang; Joseph, Justin V.; Riedel, Maria; Gao, Zongliang; Thomsen, Sofie K.; Bak, Rasmus O.; Thomsen, Martin K., Aarhus Univ, Dept Biomed, Aarhus, Denmark.
