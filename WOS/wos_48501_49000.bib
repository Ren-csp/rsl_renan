Author = {Trabanelli, Sara and Chevalier, Mathieu F. and Martinez-Usatorre, Amaia
   and Gomez-Cadena, Alejandra and Salome, Berengere and Lecciso,
   Mariangela and Salvestrini, Valentina and Verdeil, Gregory and Racle,
