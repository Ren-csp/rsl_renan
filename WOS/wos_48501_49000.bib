@article{ WOS:000531558100360,
Author = {Petrauskiene, Kamile and Dvarioniene, Jolanta and Kaveckis, Giedrius and
   Kliaugaite, Daina and Chenadec, Julie and Hehn, Leonie and Perez, Berta
   and Bordi, Claudio and Scavino, Giorgio and Vignoli, Andrea and Erman,
   Michael},
Title = {Situation Analysis of Policies for Electric Mobility Development:
   Experience from Five European Regions},
