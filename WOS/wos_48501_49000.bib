@article{ WOS:000366296300009,
Author = {Moore, Michael J. and Scheel, Troels K. H. and Luna, Joseph M. and Park,
   Christopher Y. and Fak, John J. and Nishiuchi, Eiko and Rice, Charles M.
   and Darnell, Robert B.},
Title = {miRNA-target chimeras reveal miRNA 3′-end pairing as a major determinant
   of Argonaute target specificity},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {NOV},
Abstract = {microRNAs (miRNAs) act as sequence-specific guides for Argonaute (AGO)
   proteins, which mediate posttranscriptional silencing of target
   messenger RNAs. Despite their importance in many biological processes,
   rules governing AGO-miRNA targeting are only partially understood. Here
   we report a modified AGO HITS-CLIP strategy termed CLEAR (covalent
   ligation of endogenous Argonaute-bound RNAs)-CLIP, which enriches miRNAs
   ligated to their endogenous mRNA targets. CLEAR-CLIP mapped similar to
   130,000 endogenous miRNA-target interactions in mouse brain and similar
   to 40,000 in human hepatoma cells. Motif and structural analysis define
   expanded pairing rules for over 200 mammalian miRNAs. Most interactions
   combine seed-based pairing with distinct, miRNA-specific patterns of
   auxiliary pairing. At some regulatory sites, this specificity confers
   distinct silencing functions to miRNA family members with shared seed
   sequences but divergent 3'-ends. This work provides a means for explicit
   biochemical identification of miRNA sites in vivo, leading to the
   discovery that miRNA 3'-end pairing is a general determinant of AGO
   binding specificity.},
