@article{ WOS:000453554900005,
Author = {Matovu, Schola and Wallhagen, Margaret},
Title = {Loss as Experienced by Ugandan Grandparent-Caregivers of Children
   Affected by HIV/AIDS},
Journal = {JOURNAL OF LOSS \& TRAUMA},
Year = {2018},
Volume = {23},
Number = {6},
Pages = {502-515},
Abstract = {Despite increasing numbers of studies investigating
   grandparent-caregivers of children orphaned by HIV/AIDS in sub-Saharan
   Africa, research on their mental and physical health remains inadequate.
   We provide a qualitative account of the nature, extent, and
   relationships among multiple variations of loss emerging from 32
   interviews with Ugandan grandparent-caregivers of grandchildren affected
   by HIV/AIDS. Regardless the type or nature of the loss, participants
   expressed physical, emotional, and financial distress as a result. This
   cumulative loss and subsequent grief could potentially be associated
   with mental and physical health problems. Research to further explore
   the concept of loss among this vulnerable population is recommended.},
