@article{ WOS:001224658000001,
Author = {Huang, Jialing and Yang, Janet Z. and Zhang, Shujiao},
Title = {One Day When We Were Young: Nostalgia Brings Climate Change Temporally
   Closer},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2024},
Volume = {18},
Number = {8},
Pages = {1147-1167},
Month = {NOV 16},
Abstract = {The perceived temporal distance of climate change impacts has been
   considered a long-standing barrier to climate engagement. Because
   nostalgia has distinct cognitive properties related to temporal
   thinking, three experimental studies are conducted to investigate
   nostalgia's potential for shortening temporal distance. Study 1 shows
   that nostalgia increases climate engagement by reducing temporal
   distance. Study 2 further identifies vivid imagery as a mechanism for
   the nostalgia effects across US and Chinese samples. Study 3 shows that
   nostalgic public service announcements increase climate engagement more
   than non-nostalgic ones. This study provides strong evidence that
   evoking nostalgia can be a useful climate change communication strategy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
