@article{ WOS:001036000300003,
Author = {Mas, Aina Maria and Goni, Enrique and de los Mozos, Igor Ruiz and Arcas,
   Aida and Statello, Luisa and Gonzalez, Jovanna and Blazquez, Lorea and
   Lee, Wei Ting Chelsea and Gupta, Dipika and Sejas, Alvaro and Hoshina,
   Shoko and Armaos, Alexandros and Tartaglia, Gian Gaetano and Waga, Shou
   and Ule, Jernej and Rothenberg, Eli and Gomez, Maria and Huarte, Maite},
Title = {ORC1 binds to cis-transcribed RNAs for efficient activation of
   replication origins},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {JUL 24},
Abstract = {Here the authors describe that the human origin recognition complex
   subunit 1 (ORC1) binds to RNAs transcribed from genes with origins of
   replication at their TSS impacting origin activation.
   Cells must coordinate the activation of thousands of replication origins
   dispersed throughout their genome. Active transcription is known to
   favor the formation of mammalian origins, although the role that RNA
   plays in this process remains unclear. We show that the ORC1 subunit of
   the human Origin Recognition Complex interacts with RNAs transcribed
   from genes with origins in their transcription start sites (TSSs),
   displaying a positive correlation between RNA binding and origin
   activity. RNA depletion, or the use of ORC1 RNA-binding mutant, result
   in inefficient activation of proximal origins, linked to impaired ORC1
   chromatin release. ORC1 RNA binding activity resides in its
   intrinsically disordered region, involved in intra- and inter-molecular
   interactions, regulation by phosphorylation, and phase-separation. We
   show that RNA binding favors ORC1 chromatin release, by regulating its
   phosphorylation and subsequent degradation. Our results unveil a
   non-coding function of RNA as a dynamic component of the chromatin,
   orchestrating the activation of replication origins.},
