@article{ WOS:A1978EY75700005,
Author = {BERGLUND, B and BERGLUND, U and LINDVALL, T},
Title = {SEPARATE AND JOINT SCALING OF PERCEIVED ODOR INTENSITY OF NORMAL-BUTANOL
   AND HYDROGEN-SULFIDE},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1978},
Volume = {23},
Number = {4},
Pages = {313-320},
Abstract = {To determine which combination of scaling method and experimental
   procedure is optimal for measuring perceived odor intensity, the
   intensity perception of 1 odorous substance was scaled both separately
   and together with a 2nd odorous substance in the same session. The
   methods used were magnitude estimation with and without a standard
   reference and cross-modal matching with finger span. The results show
   that separate and joint scalings of n-butanol and H2S give identical
   scales, regardless of scaling method. Different results are obtained in
   magnitude estimations with a homoquality, a heteroquality and no
   standard. From these results, one would not expect to find a single true
   power function independent of method. Cross-modal matching with finger
   span may be the best choice for odor intensity scaling since it results
   in the widest response range, thereby giving the best resolution.},
