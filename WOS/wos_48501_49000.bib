@article{ WOS:001531151300001,
Author = {Montoliu, Bibiana Monsivais and Saenz, Itzkuauhtli Benedicto Zamora},
Title = {Contributions of biocultural approaches to the sustainable planning of
   peri-urban water landscapes: a case study of Mexico City, Mexico},
Journal = {LANDSCAPE ECOLOGY},
Year = {2025},
Volume = {40},
Number = {8},
Month = {JUL 18},
Abstract = {ContextRapid urbanization and land-use changes during the twentieth
   century led to policies aimed at integrating ecological and
   socio-cultural aspects into landscape management, particularly for water
   landscapes. However, in Latin America, these policies have had limited
   impact. Given the region's biological and cultural diversity, there is a
   need for approaches that consider historical culture-nature
   relationships and promote comprehensive management of peri-urban
   watersheds.ObjectivesThis study identifies the contributions of
   biocultural approaches to sustainable management of peri-urban water
   landscapes. Grounded in understanding practical, cognitive, symbolic and
   ethico-political relationships between humans and their environment,
   these approaches offer a holistic framework to address the complexities
   of water landscapes and the power relationships historically
   rooted.MethodsThe methodology involved a theoretical review of
   biocultural approaches to characterize a peri-urban water landscape in
   Mexico City, Mexico. Based on an analysis of existing studies, data
   collected through field visits, and preliminary findings from a
   participatory mapping experience conducted in the Magdalena River
   watershed. In addition, territorial, environmental, and heritage
   policies at federal, state, and local levels were reviewed to assess
   their effectiveness in protecting water landscapes.ResultsWe identified
   elements of bioculturality and found that current policies do not
   comprehensively address both biological and socio-cultural diversity in
   Mexico City water landscapes. Moreover, existing policies have neglected
   territorialities, resulting in socio-environmental
   injustices.ConclusionsThis study proposes that recognizing diverse
   territorialities and exposing socio-environmental injustices emphasized
   by biocultural approaches can inform water landscape management policies
   in peri-urban watersheds in Mexico City.},
