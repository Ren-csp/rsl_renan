@article{ WOS:000333530200003,
Author = {Antoine, Thessicar Evadney and Jones, Kevin S. and Dale, Rodney M. and
   Shukla, Deepak and Tiwari, Vaibhav},
Title = {Zebrafish: Modeling for Herpes Simplex Virus Infections},
