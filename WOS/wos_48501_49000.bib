@article{ WOS:001620566800001,
Author = {Schmidt, Karolin},
Title = {Moving from description to explanation - explaining consumers'
   preference for bio-based plastics like PEF by an extended theory of
   planned behavior},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {Global plastic production relies heavily on fossil feedstocks,
   contributing significantly to CO2 emissions. Biobased plastics such as
   PEF offer a promising alternative that could help mitigate this
   environmental impact. For bio-based plastics to achieve widespread
   adoption, however, they must be accepted and purchased - i.e., preferred
   - by consumers. Although previous research has provided integrative
   frameworks summarizing empirical evidence on various determinants of
   consumer preferences for bio-based plastics, these frameworks have not
   yet been empirically validated as structured models. Against this
   background, the present study aimed to take a first step toward
   developing and empirically validating a structured psychological model
   to explain consumers' preferences for bio-based plastics like PEF. In
   March 2025, an online-survey was conducted with a sample of German
   consumers (N = 566). Structural equation modeling (SEM) showed that a
   theoretically and empirically grounded extended Theory of Planned
   Behavior (TPB) corresponded well with the data. In addition to several
   PEF-related beliefs, which significantly enhanced participants' positive
   attitudes toward PEF, both this attitude and participants' personal
   norms for sustainable consumption were identified as significant
   determinants of their (hypothetical) PEF-purchase decisions. Taken
   together, the findings of this study provide important implications for
   both practical interventions and future research aimed at advancing the
   understanding of consumer preferences for bio-based plastics such as
   PEF.},
