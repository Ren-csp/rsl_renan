@article{ WOS:A1983QC22400006,
Author = {TURIEL, I and HOLLOWELL, CD and MIKSCH, RR and RUDY, JV and YOUNG, RA
   and COYE, MJ},
Title = {THE EFFECTS OF REDUCED VENTILATION ON INDOOR AIR-QUALITY IN AN OFFICE
   BUILDING},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1983},
Volume = {17},
Number = {1},
Pages = {51-64},
Abstract = {Indoor air quality was monitored at an office building in San Francisco,
   California {[}USA] where occupants had registered eye, nose and throat
   irritation complaints. Portable air pollution monitoring equipment was
   placed on site to monitor air outdoors and at 3 indoor sites (a waiting
   room, an interview room and an office room), and data were taken under 2
   differnt ventilation rates. The parameters were outside air flow rates,
   temperature, relative humidity, odor perception, microbial burden,
   particulate mass, formaldehyde and other organics, CO2, CO and NO2. CO2
   concentrations increased as the ventilation rate decreased, odor
   perceptibility increased slightly at the lowest ventilation rate and
   other pollutants generally showed low concentrations, which increased
   when ventilation was reduced. Levels did not exceed current health
   standards for outdoor air and no one contaminant was responsible for the
   medical symptoms reported by occupants. A synergistic effect of the
   various contaminants and environmental conditions may have accounted for
   the discomfort of occupants.},
