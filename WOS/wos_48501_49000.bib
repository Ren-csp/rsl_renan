@article{ WOS:000214597700059,
Author = {Corseuil, Marui Weber and Hallal, Pedro Curi and Corseuil, Herton Xavier
   and Ceola Schneider, Ione Jayce and d'Orsi, Eleonora},
Title = {Safety from Crime and Physical Activity among Older Adults: A
   Population-Based Study in Brazil},
Journal = {JOURNAL OF ENVIRONMENTAL AND PUBLIC HEALTH},
Year = {2012},
Volume = {2012},
Abstract = {Objective. To evaluate the association between safety from crime and
   physical activity among older adults. Methods. A population-based survey
   including 1,656 older adults (60+ years) took place in Florianopolis,
   Brazil, in 2009-2010. Commuting and leisure time physical activity were
   assessed through the long version of the International Physical Activity
   Questionnaire. Perception of safety from crime was assessed using the
   Neighbourhood Environment Walkability Scale. Results. Perceiving the
   neighbourhood as safe during the day was related to a 25\% increased
   likelihood of being active in leisure time (95\% CI 1.02-1.53); general
   perception of safety was also associated with a 25\% increase in the
   likelihood of being active in leisure time (95\% CI 1.01-1.54). Street
   lighting was related to higher levels of commuting physical activity
   (prevalence ratio: 1.89; 95\% CI 1.28-2.80). Conclusions. Safety
   investments are essential for promoting physical activity among older
   adults in Brazil.},
