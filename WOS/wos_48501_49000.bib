@article{ WOS:000074240600015,
Author = {Tanaka-Ueno, T and Matsui, M and Sato, T and Takenaka, S and Takenaka, O},
Title = {Phylogenetic relationships of brown frogs with 24 chromosomes from Far
   East Russia and Hokkaido assessed by mitochondrial cytochrome b
   gene sequences (Rana: Ranidae)},
Journal = {ZOOLOGICAL SCIENCE},
Year = {1998},
Volume = {15},
Number = {2},
Pages = {289-294},
Month = {APR},
Abstract = {Comparisons of nucleotide sequences of mitochondrial cytochrome b gene
   revealed that the brown frog from Sakhalin has genetically little
   differentiated from Rana pirica from Hokkaido. Although they show some
   differences in adult morphology, they are considered to be conspecific.
   These frogs have sequences substantially different from R. dybowskii
   from the Maritime territory of Russia, and the current taxonomic idea to
   specifically separate them is genetically supported. On the other hand,
   R. dybowskii from the Maritime territory is genetically well
   differentiated from a conspecific population from Tsushima.},
