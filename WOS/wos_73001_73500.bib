@article{ WOS:001594411000001,
Author = {Jessen Williamson, Karla and Bagelman, Jen and Wiebe, Sarah and
   Gauthier, Maeva and Drescher, Dwayne `Atjgaliaq'},
Title = {Nuna Aliannaittuk Auttuq-Thawing of the Beautiful Lands of
   Inuvialuit: Lessons for Sensing Policy},
Journal = {CANADIAN PUBLIC ADMINISTRATION-ADMINISTRATION PUBLIQUE DU CANADA},
Year = {2025},
Volume = {68},
Number = {3, SI},
Pages = {519-537},
Month = {SEP},
Abstract = {This article, co-led by an Inuk scholar, Inuvialuit graduate student,
   and non-Indigenous academic co-investigators, explores the implications
   of climate displacement research for public administration, policy, and
   governance, with a specific emphasis on sensing in relation to policy.
   Drawing on diverse forms of evidence, we highlight the role of
   storytelling and sensory experience in shaping climate policy. We
   reflect on the outcomes of a unique gathering, ``Changing Climate
   Conversations,{''} where Inuvialuit climate change leaders engaged with
   Environment Canada officials. Through unipkait (Inuit forms of
   storytelling) we used murals, music videos, and film, to evoke
   Inuvialuit youth knowledge on climate change in Tuktoyaktuk, Northwest
   Territories, Canada. The youth deliberations challenged conventional
   climate discourse, emphasizing the importance of Indigenous knowledge
   and perspectives in policymaking. Our findings underscore the need for
   justice-oriented policies that honour diverse voices and promote
   ecological and social justice, enacting inclusive policy futures that
   center Indigenous sovereignty in environmental governance.
   Cet article, co-dirig \& eacute; par un chercheur inuk, un \&
   eacute;tudiant dipl \& ocirc;m \& eacute; inuvialuit et des
   co-chercheurs universitaires non autochtones, explore les implications
   de la recherche sur les d \& eacute;placements climatiques pour
   l'administration publique, les politiques et la gouvernance, en mettant
   particuli \& egrave;rement l'accent sur la perception en relation avec
   les politiques. En nous appuyant sur diverses formes de donn \&
   eacute;es probantes, nous soulignons le r \& ocirc;le de la narration et
   de l'exp \& eacute;rience sensorielle dans l'\& eacute;laboration des
   politiques climatiques. Nous r \& eacute;fl \& eacute;chissons aux r \&
   eacute;sultats d'une rencontre unique, << Changing Climate Conversations
   >>, au cours de laquelle des leaders inuvialuits engag \& eacute;s dans
   la lutte contre le changement climatique ont dialogu \& eacute; avec des
   repr \& eacute;sentants d'Environnement Canada. \& Agrave; travers
   l'unipkait (forme de narration inuite), nous avons utilis \& eacute; des
   peintures murales, des clips musicaux et des films pour \& eacute;voquer
   les connaissances des jeunes Inuvialuits sur le changement climatique \&
   agrave; Tuktoyaktuk, dans les Territoires du Nord-Ouest, au Canada. Les
   d \& eacute;lib \& eacute;rations des jeunes ont remis en question le
   discours conventionnel sur le climat, soulignant l'importance des
   connaissances et des perspectives autochtones dans l'\&
   eacute;laboration des politiques. Nos conclusions soulignent la n \&
   eacute;cessit \& eacute; de politiques ax \& eacute;es sur la justice
   qui respectent la diversit \& eacute; des opinions et favorisent la
   justice \& eacute;cologique et sociale, en mettant en place des
   politiques inclusives qui placent la souverainet \& eacute; autochtone
   au centre de la gouvernance environnementale.},
