Title = {Trees, forests and water: Cool insights for a hot world},
Journal = {GLOBAL ENVIRONMENTAL CHANGE-HUMAN AND POLICY DIMENSIONS},
Year = {2017},
Volume = {43},
Pages = {51-61},
