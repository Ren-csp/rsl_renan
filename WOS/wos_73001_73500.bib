@article{ WOS:000374915800069,
Author = {Lavey, Nathan P. and Coker, Jesse A. and Ruben, Eliza A. and Duerfeldt,
   Adam S.},
Title = {Sclerotiamide: The First Non-Peptide-Based Natural Product Activator of
   Bacterial Caseinolytic Protease P},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2016},
Volume = {79},
Number = {4},
Pages = {1193-1197},
Month = {APR},
Abstract = {Caseinolytic protease P (ClpP) maintains essential roles in bacterial
   homeostasis. As such, both the inhibition and activation of this enzyme
   result in bactericidal activity, making ClpP a promising target for
   antibacterial drug development. Herein, we report the results of a
   fluorescence-based screen of similar to 450 structurally diverse fungal
   and bacterial secondary metabolites. Sclerotiamide (1), a
   paraherquamide-related indolinone, was identified as the first
   non-peptide-based natural product activator of ClpP. Structure-activity
   relationships arising from the initial screen, preliminary biochemical
   evaluation of 1, and rationale for the exploitation of this chemotype to
   develop novel ClpP activators are presented.},
Publisher = {AMER CHEMICAL SOC},
