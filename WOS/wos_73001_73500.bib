Keywords-Plus = {INDUCED TREE MORTALITY; DROUGHT-INDUCED TREE; HAWAIIAN RAIN-FOREST;
   NORTH-ISLAND; EL-NINO; VEGETATION CHANGES; RESEARCH FRONTIERS; WATER
