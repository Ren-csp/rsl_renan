@article{ WOS:000471657600072,
Author = {Hoffman, Abigail S. and Albeke, Shannon E. and McMurray, Jill A. and
   Evans, R. David and Williams, David G.},
Title = {Nitrogen deposition sources and patterns in the Greater Yellowstone
   Ecosystem determined from ion exchange resin collectors, lichens, and
   isotopes},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {2019},
Volume = {683},
Pages = {709-718},
Month = {SEP 15},
Abstract = {Over the past century, atmospheric nitrogen deposition (N-dep) has
   increased across the western United States due to agricultural and urban
   development, resulting in degraded ecosystem quality. Regional patterns
   of N-dep are often estimated by coupling direct measurements from
   large-scale monitoring networks and atmospheric chemistry models, but
   such efforts can be problematic in the western US because of complex
   terrain and sparse sampling. This study aimed not only to understand
   N-dep patterns in mountainous ecosystems but also to investigate whether
   isotope values of lichens and throughfall deposition can be used to
   determine N-dep sources, and serve as an additional tool in ecosystem
   health assessments. We measured N-dep amounts and delta N-15 in montane
   conifer forests of the Greater Yellowstone Ecosystem using canopy
   throughfall and bulk monitors and lichens. In addition, we examined
   patterns of C:N ratios in lichens as a possible indicator of lichen
   physiological condition. The isotopic signature of delta N-15 of N-dep
   helps to discern emission sources, because delta N-15 of NOx from
   combustion tends to be high (-5 to + 25 parts per thousand) while NHx
   from agricultural sources tends to be comparatively low (-40 to -10
   parts per thousand). Summertime N-dep increased with elevation and
   ranged from 0.26 to 1.66 kg ha(-1). N-dep was higher than expected in
   remote areas. The delta N-15 values of lichens were typically -15.3 to
   -10\% suggesting agriculture as a primary emission source of deposition.
   Lichen \% N, delta N-15 and C:N ratios can provide important information
   about N-dep sources and patterns over small spatial scales in complex
   terrain. (C) 2019 Elsevier B.V. All rights reserved.},
