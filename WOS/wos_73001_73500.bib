@article{ WOS:001648774700003,
Author = {Akodwaa-Boadi, Kofi and Tobil, Charlotte Bismark and Musah, Ibrahim
   Mohammed Nweinyimbu and Nti, Maxwell and Amponsah, Josephine},
Title = {Occupational health, safety risks and challenges of sanitation workers
   in healthcare facilities in peri-urban Ghana},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2025},
Volume = {22},
Number = {1},
Month = {DEC 25},
Abstract = {Background Despite increased attention to the risks faced by sanitation
   workers, those in healthcare facilities remain understudied. This study
   assesses the occupational health and safety risks faced by sanitation
   workers at Asante Mampong Government Hospital and SDA Government
   Hospital Agona-Asamang in peri-urban Ghana, providing empirical evidence
   to inform policies and interventions. Methodology A census approach was
   used for the study, targeting all ninety-eight (98) sanitary workers
   employed at the selected hospitals. Primary data was collected using a
   structured questionnaire. All variables were measured using closed-ended
   items on a five-point Likert scale (1 = strongly disagree to 5 =
   strongly agree), with additional categorical and open-ended items where
   appropriate. The questionnaire was designed to ensure consistency in
   measurement across all respondents. Reliability was conducted, yielding
   a Cronbach's alpha coefficient of 0.79, indicating acceptable
   reliability of the data sets. Data was analysed using SPSS Version 22.
   Results The workforce was mostly male, making up 59.2\%. Most workers
   were aged 45 to 54, accounting for 48\%, and they were typically
   employed full-time with 4 to 6 years of experience. Approximately 90\%
   of the sanitation workers earned between \$32.85 and \$65.57 per month.
   Workers displayed strong hazard awareness, and gender significantly
   influenced their perception of risks (p < 0.05). While 49\% reported a
   decrease in ergonomic risks, 34.7\% felt overwhelmed. Vaccination
   coverage was lacking, as 40.8\% strongly disagreed that they felt
   protected. Overall, 77.6\% posited unfair compensation. Conclusion The
   findings call for urgent policy action to strengthen immunization
   programs tailored to high-risk occupational groups, while reinforcing
   wage policy reforms and social protection measures that recognize the
   essential contributions of sanitation workers. The study provides
   evidence for policymakers to enhance health protocols, establish fair
   compensation, and promote a culture of dignity for sanitation workers in
   healthcare facilities.},
