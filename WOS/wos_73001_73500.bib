@article{ WOS:001594741400002,
Author = {Munyaneza, Justin and Sebaziga, Ndakize Joseph and Mugabo, William and
   Niyigena, Bernard and Mupenzi, Christophe and Musafiri, Godfrey and
   Jonah, Kazora and Manirakiza, Benjamin and Ukwishaka, David},
Title = {Assessing the link between climatic information and farmers' local
   knowledge on climate variability in Ngoma District, Rwanda},
Journal = {DISCOVER ENVIRONMENT},
Year = {2025},
Volume = {3},
Number = {1},
Month = {SEP 15},
Abstract = {This study assessed farmers' local knowledge of climate variability and
   its link to climatic data in Ngoma District using rainfall and
   temperature data for the 1983-2021 period obtained from the Rwanda
   Meteorology Agency, with survey responses gathered from 400 farmers.
   Trend analysis at alpha = 95\% was computed using the Modified
   Mann-Kendall (MMK) test and Sen's slope estimator. The Results indicated
   a statistically significant decrease in the diurnal temperature range
   (DTR) at rates of - 0.0345 degrees C/year during MAM and - 0.02657
   degrees C/year during SOND. For both MAM and SOND seasons, mean
   temperature (T) and minimum temperature (Tn) increased by 0.0115 degrees
   C/year and 0.014 degrees C/year (T) and by 0.023 degrees C/year and
   0.021 degrees C/year (Tn), respectively. Conversely, maximum temperature
   (Tx) exhibited decreasing trends of -0.0114 degrees C/year (MAM) and -
   0.007 degrees C/year (SOND). The onset date (OD) ranges between February
   9 and April 9 for MAM, and between September 7 and November 26 for SOND.
   The cessation date (CD) ranges from June 2 to 12 during MAM and from
   December 29 to January 12 during SOND. There are both similarities and
   differences between local knowledge and climate data. Most respondents
   (63\% for MAM and 84\% for SOND) are unaware of the onset of the
   seasons. The Majority of farmers (99\%) indicate that SOND last longer
   than usual while 83\% indicate that MAM starts later than usual.
   Furthermore, nearly all (97\%) are aware of the information disseminated
   by Meteo-Rwanda. The data confirmed significant farmer perceptions,
   including increased rainfall intensity, irregular seasonal patterns, and
   shifts in precipitation dynamics. Enhancing farmers' knowledge and
   accessibility to diverse climate information would support agricultural
   management and planning, thereby boosting agricultural productivity.},
