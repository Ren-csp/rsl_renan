@article{ WOS:000330230500003,
Author = {Buja, Alessandra and Zampieron, Alessandra and Mastrangelo, Giuseppe and
   Petean, Marco and Vinelli, Angela and Cerne, Diana and Baldo, Vincenzo},
Title = {STRAIN AND HEALTH IMPLICATIONS OF NURSES' SHIFT WORK},
