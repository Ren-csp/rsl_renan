@article{ WOS:001512188500005,
Author = {Loesslein, Lena and Linnerbauer, Mathias and Zuber, Finnja and
   Tsaktanis, Thanos and Vandrey, Oliver and Peter, Anne and Panier,
   Franziska and Zissler, Julia and Riekher, Vivienne and Baeuerle, Tobias
   and Hanspach, Jannis and Laun, Frederik B. and Nagel, Lisa and Meszaros,
   Lisa and Zunke, Friederike and Winkler, Juergen and Naumann, Ulrike J.
   and Schwingen, Nora and Neumaier, Emely and Liesz, Arthur and Quintana,
   Francisco and Rothhammer, Veit},
Title = {TGFα controls checkpoints in CNS resident and infiltrating immune cells
   to promote resolution of inflammation},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUN 19},
Abstract = {After acute lesions in the central nervous system (CNS), the interaction
   of microglia, astrocytes, and infiltrating immune cells decides over
   their resolution or chronification. However, this CNS-intrinsic
   cross-talk is poorly characterized. Analyzing cerebrospinal fluid (CSF)
   samples of Multiple Sclerosis (MS) patients as well as CNS samples of
   female mice with experimental autoimmune encephalomyelitis (EAE), the
   animal model of MS, we identify microglia-derived TGF alpha as key
   factor driving recovery. Through mechanistic in vitro studies, in vivo
   treatment paradigms, scRNA sequencing, CRISPR-Cas9 genetic perturbation
   models and MRI in the EAE model, we show that together with other glial
   and non-glial cells, microglia secrete TGF alpha in a highly regulated
   temporospatial manner in EAE. Here, TGF alpha contributes to recovery by
   decreasing infiltrating T cells, pro-inflammatory myeloid cells,
   oligodendrocyte loss, demyelination, axonal damage and neuron loss even
   at late disease stages. In a therapeutic approach in EAE, blood-brain
   barrier penetrating intranasal application of TGF alpha attenuates
   pro-inflammatory signaling in astrocytes and CNS infiltrating immune
   cells while promoting neuronal survival and lesion resolution. Together,
   microglia-derived TGF alpha is an important mediator of glial-immune
   crosstalk, highlighting its therapeutic potential in resolving acute CNS
   inflammation.},
