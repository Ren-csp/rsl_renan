@article{ WOS:001856881600001,
Author = {Mugambe, Richard K. and Nuwematsiko, Rebecca and Wafula, Solomon T. and
   Igo, Gideon and Ssekamatte, Tonny and Isunju, John Bosco and Manga, Musa
   and van Vliet, Bas and Atuyambe, Lynn and Buregyeya, Esther},
Title = {Factors associated with solid waste segregation and recycling among slum
   dwellers in Kampala City, Uganda},
Journal = {NEXT SUSTAINABILITY},
Year = {2026},
Volume = {8},
Month = {DEC},
Abstract = {Waste management remains a major challenge in urban settings in
   developing countries. Open dumping and landfilling are still the
   mainstay for waste management despite the associated negative impacts.
   Approaches such as segregation for recycling and reuse are not popular.
   Using a cross-sectional approach, we assessed factors associated with
   solid waste segregation and recycling practice among urban dwellers in
   Kampala, Uganda, following a behavior-centered educational intervention.
   Quantitative data was collected among 299 adults in three urban wards in
   Kampala between May and June 2021. Data was collected on knowledge,
   perceptions of proper solid waste management and uptake of segregation
   and recycling. Modified Poisson regression was used to assess the
   factors associated with engaging in segregation and recycling. Analysis
   was performed in Stata 16 software. Most participants, 81.3\% (250/299)
   had high knowledge and 89.3\% (267/299) had positive percep-tions of
   proper solid waste management. More than half, 54.5\% (163/299) of the
   participants started segregating and 15.7\% (47/299) started recycling
   their solid waste for the first time. High-income earners (< USD 85 Vs
   >= USD 85) (Prevalence ratio (PR) = 1.24, 95\% Confidence interval (CI)
   1.02 - 1.50) and those who had ever segregated waste (PR = 17.60, 95\%CI
   4.52 - 68.69) were more likely to adopt segregation. Participants who
   reported participation in recycling before the intervention launch (PR =
   8.75, 95\%CI 4.32 - 17.75) and the unskilled workers compared to
   businesspeople (PR = 1.91, 95\%CI 1.01 - 3.60) were more likely to adopt
   recycling. Participants who had ever segregated or recycled solid waste
   were more likely to take up segregation and recycling respectively},
