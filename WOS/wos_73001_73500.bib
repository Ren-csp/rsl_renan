@article{ WOS:000884843700017,
Author = {de Thonel, Aurelie and Ahlskog, Johanna K. and Daupin, Kevin and
   Dubreuil, Veronique and Berthelet, Jeremy and Chaput, Carole and Pires,
   Geoffrey and Leonetti, Camille and Abane, Ryma and Barris, Lluis Cordon
   and Leray, Isabelle and Aalto, Anna L. and Naceri, Sarah and Cordonnier,
   Marine and Benasolo, Carene and Sanial, Matthieu and Duchateau, Agathe
   and Vihervaara, Anniina and Puustinen, Mikael C. and Miozzo, Federico
   and Fergelot, Patricia and Lebigot, Elise and Verloes, Alain and
   Gressens, Pierre and Lacombe, Didier and Gobbo, Jessica and Garrido,
   Carmen and Westerheide, Sandy D. and David, Laurent and Petitjean,
   Michel and Taboureau, Olivier and Rodrigues-Lima, Fernando and
   Passemard, Sandrine and Saberan-Djoneidi, Delara and Nguyen, Laurent and
   Lancaster, Madeline and Sistonen, Lea and Mezger, Valerie},
Title = {CBP-HSF2 structural and functional interplay in Rubinstein-Taybi
   neurodevelopmental disorder},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {NOV 16},
Abstract = {Rubinstein-Taybi syndrome (RSTS) is a neurodevelopmental disorder with
   unclear underlying mechanisms. Here, the authors unravel the
   contribution of a stress-responsive pathway to RSTS where impaired HSF2
   acetylation, due to RSTS-associated CBP/EP300 mutations, alters the
   expression of neurodevelopmental players, in keeping with hallmarks of
   cell-cell adhesion defects.
   Patients carrying autosomal dominant mutations in the histone/lysine
   acetyl transferases CBP or EP300 develop a neurodevelopmental disorder:
   Rubinstein-Taybi syndrome (RSTS). The biological pathways underlying
   these neurodevelopmental defects remain elusive. Here, we unravel the
   contribution of a stress-responsive pathway to RSTS. We characterize the
   structural and functional interaction between CBP/EP300 and heat-shock
   factor 2 (HSF2), a tuner of brain cortical development and major player
   in prenatal stress responses in the neocortex: CBP/EP300 acetylates
   HSF2, leading to the stabilization of the HSF2 protein. Consequently,
   RSTS patient-derived primary cells show decreased levels of HSF2 and
   HSF2-dependent alteration in their repertoire of molecular chaperones
   and stress response. Moreover, we unravel a CBP/EP300-HSF2-N-cadherin
   cascade that is also active in neurodevelopmental contexts, and show
   that its deregulation disturbs neuroepithelial integrity in 2D and 3D
   organoid models of cerebral development, generated from RSTS
   patient-derived iPSC cells, providing a molecular reading key for this
   complex pathology.},
