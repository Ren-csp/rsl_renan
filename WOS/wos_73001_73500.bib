@article{ WOS:001524743000014,
Author = {Apay, Serap Ejder and Nagorska, Malgorzata and Erdogan, Elif and Sidor,
   Adam and Zych, Barbara},
Title = {Women's awareness about gynaecological cancers in Poland and Turkey - a
   comparative study},
