@article{ WOS:001078278600001,
Author = {Tiitu, Maija and Nyberg, Elina and Halonen, Jaana I. and Pasanen, Tytti
   P. and Viinikka, Arto and Lehtimaki, Jenni and Lanki, Timo and Vierikko,
   Kati},
Title = {Comparing city practitioners' and residents' perceptions of a liveable
