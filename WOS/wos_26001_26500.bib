@article{ WOS:001341260400009,
Author = {Mol Bessa, Altamiro Sergio},
Title = {The linguistic landscape in Architecture and Urbanism: a case study
   applied to teaching},
Journal = {REVISTA IBEROAMERICANA DE EDUCACION},
