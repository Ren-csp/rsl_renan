@article{ WOS:001769743400001,
Author = {Khan, Fariha Rubaiyat},
Title = {Who are the children that environmental education targets? Mapping
   geographic and conceptual boundaries in more-than-human environmental
   education research},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2026},
Month = {2026 MAY 11},
Abstract = {How is childhood conceptualised in more-than-human environmental
   education research, and which children become visible within these
   conceptualisations? This paper presents findings from a systematic
   review of 113 peer-reviewed articles (2009-2025) examining
   representations of childhood and multispecies in environmental education
   literature. Drawing on feminist research traditions of situated
   knowledges and critical mapping approaches, this review extends beyond
   conventional systematic review methodology to interrogate not only what
   research exists but the structural conditions shaping knowledge
   production itself. The analysis maps patterns across two distinct
   dimensions: geographic barriers reflecting structural conditions of
   research access, and methodological and conceptual choices shaping how
   children's multispecies relationships are studied and theorised.
   Research is concentrated predominantly in the Global North, particularly
   Australia, Canada, Europe, and the United States, while Global South
   contexts remain underrepresented. Methodologically, studies
   predominantly feature curated, adult-mediated nature encounters.
   Children living in ongoing multispecies relationships appear less
   frequently. Where Indigenous children appear, they are predominantly
   from Australian and North American contexts, while Indigenous
   communities elsewhere remain underrepresented. Similarly, urban children
   in the literature are typically from affluent Northern settings, while
   underprivileged/working children in Global South contexts are mostly
   absent. The review examines how current research boundaries shape whose
   experiences are heard and made visible in scholarly knowledge and
   identifies opportunities for geographically and methodologically diverse
   scholarship that recognises ways of being a child in relation to
   more-than human worlds. These research boundaries and their implications
   are revisited throughout the analysis to anchor the study's critical
   examination of knowledge production patterns.},
