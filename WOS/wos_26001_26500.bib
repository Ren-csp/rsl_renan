@article{ WOS:001789120100001,
Author = {Drews, Stefan and Konc, Theo},
Title = {Perceptions of carbon inequality and attitudes to policy responses:
   Evidence from Spain},
Journal = {ENERGY RESEARCH \& SOCIAL SCIENCE},
Year = {2026},
Volume = {137},
Month = {JUL},
Abstract = {Carbon inequality refers mainly to the unequal distribution of carbon
   emissions among individuals, influenced by differences in income,
   wealth, and access to energy-intensive lifestyles. Little is known about
   how citizens perceive carbon inequality, how these perceptions vary
   across social groups, and whether they are consequential for attitudes
   toward climate mitigation policies. In this paper, we study the link
   between carbon-inequality perceptions and policy attitudes using an
   online survey of younger (aged 16-32) and older (aged 50-65) in Spain (n
   = 3009). While most respondents qualitatively perceive moderate to large
   differences in carbon footprints, quantitative estimates are more
   dispersed and show a slight tendency to overestimate emissions of the
   top 1\% relative to academic benchmark data. Most respondents recognize
   income as a key driver of carbon footprint differences, whereas
   perceptions of age-related differences are weaker and less consensual.
   Crucially, normative beliefs that high-carbon individuals should
   contribute more to mitigation are a stronger predictor of climate policy
   support than the accuracy of perceived carbon inequality. Providing
   factual information about emission disparities had limited average
   effects on policy attitudes, but increased support for a carbon-based
   wealth tax among respondents who initially underestimated emissions of
   the top 1\%. Overall, the study indicates public support for selected
   measures to reduce carbon inequality and highlights the central role of
   fairness-based considerations for climate-policy design and
   communication.},
