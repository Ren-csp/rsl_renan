@article{ WOS:000289754000011,
Author = {de Souza Schneider, Rosana de Cassia and dos Santos, Eder and Krise,
   Dione Jose and Lipke, Regis Jacsiano},
Title = {Residual fatty and oil production in Arroio do Tigre town, Rio Grande do
   Sul State, aiming biodiesel production},
