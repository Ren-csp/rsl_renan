@article{ WOS:001862675200001,
Author = {Gaio, Alexander and Cugurullo, Federico},
Title = {A hierarchy of psychological and behavioural needs for urban bicycle
   users in the age of autonomous vehicles},
Journal = {TRANSPORTATION RESEARCH PART F-TRAFFIC PSYCHOLOGY AND BEHAVIOUR},
Year = {2026},
Volume = {122},
Month = {AUG},
Abstract = {The rise of autonomous vehicles (AVs) risks marginalising vulnerable
   road users such as bicycle users. This study addresses an identified
   research gap by providing rare empirical evidence from real-world AV
   shuttle environments and translating bicycle users' reported comfort,
   trust, acceptability, perceived safety, and behavioural needs into a
   practical planning framework. Using Likert-scale questionnaires based on
   the Theory of Planned Behaviour, Levels of Traffic Stress, and Bicycle
   User Classifications, associations between AV exposure, bicycle trips,
   and comfort were analysed. While data suggest comfort increased slightly
   with repeated AV exposure (Md = 4.00 to Md = 5.00), trust levels
   remained unchanged, suggesting limitations in communication. Site-level
   differences in perceived acceptability were consistent with differences
   in infrastructure and urban form, particularly for less confident
   ``interested but concerned{''} bicycle users. A five-tiered hierarchy of
   bicycle user needs is proposed to guide regulators and planners: (1)
   Infrastructure \& Urban Form, (2) Communication \& Trust, (3) Safety \&
   Comfort, (4) Modal Integration, and (5) Transition Management. This
   framework ensures fundamental bicycle user needs are met and prevents
   mode subordination in AI-mediated transport systems.},
