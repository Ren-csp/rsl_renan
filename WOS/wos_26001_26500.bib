@article{ WOS:000618543600004,
Author = {Cho, Wonjun and Kwon, Youngsang},
Title = {The era of Seoul's rapid growth (1960s-1970s): The role of ex-military
   elite mayors},
Journal = {CITIES},
Year = {2021},
Volume = {110},
Month = {MAR},
Abstract = {This study aims to analyze the role of ex-military mayors in the
   development of Seoul after the Korean war (1950-1953). The six mayors of
   Seoul who took office under President Park (1961-1979) and the rapid
   development of South Korea, demonstrated excessive loyalty and drive to
