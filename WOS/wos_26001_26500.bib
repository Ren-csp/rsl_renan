@article{ WOS:001447479700001,
Author = {Berke, Timothy and Larsen, Larissa},
Title = {The importance of city services to internally displaced persons,
   returnees, and host residents in Juba, South Sudan},
Journal = {JOURNAL OF URBAN AFFAIRS},
Year = {2026},
Volume = {48},
Number = {4},
Pages = {1153-1174},
Month = {APR 21},
Abstract = {Increasing numbers of people are displaced worldwide (108 million), and
   well over half of displaced persons move to urban areas in lower-income
   countries. While some research has focused on how displaced persons fare
   in camps, little research focuses on displaced persons, returnees, and
   host residents living together in urban areas. This research uses a
   mixed-methods approach for data collection, including 60 randomly
   selected households in three residential areas (n = 180) in Juba, South
   Sudan. Household surveys compared how displaced persons valued basic
   city services (water, latrine/wastewater, electricity, and security),
   transportation, and shared facilities (hospitals, schools, parks, and
   markets) relative to host residents and returnees. Using linear
   regression modeling, our research found that the perceived value of city
   services amongst hosts, IDPs, and returning refugees varied
   significantly when controlling for residential areas and household
   characteristics. However, many common patterns existed among the three
   groups. Host residents and IDPs rated cheaper transportation as their
   greatest need. All three groups highly rated the need for security, and
   IDPs and returnees highly rated the need for parks. When designing and
   implementing development projects, we recommend that humanitarian
   agencies collaborate with city officials to engage with existing IDP and
   returnee networks.},
