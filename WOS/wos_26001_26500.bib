@article{ WOS:000409913000006,
Author = {Huff, Jonathan and Wilburn, Victor R. and Belay, Getinet},
Title = {Educator Perceptions of Conflict Interactions Among Young Children in
   Inner-city Elementary and Middle Schools},
Journal = {JOURNAL OF YOUTH DEVELOPMENT},
Year = {2009},
Volume = {4},
Number = {3},
Pages = {84-99},
Month = {FAL},
Abstract = {A study that investigated the perceptions of educational professionals
   regarding the rising issue of aggressive and disruptive behaviors among
   young children in inner-city schools is discussed in this article. A
   convenient sample of 14 professionals were selected and interviewed from
   educators in an inner-city located in the northeast region of Ohio.
   Evidence of this investigation suggests that young children's aggressive
   behaviors are increasing in both occurrence and complexity. While these
   behaviors are perceived to be a function of certain environmental
   exposures, a case can be made for the effectiveness in conflict
   management and life skill application in young children as many children
   seem to display more problems in collective and social settings.},
