@article{ WOS:000175776100011,
Author = {Bennett, DJ and Warren, W},
Title = {Size scaling: Retinal or environmental frame of reference?},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2002},
Volume = {64},
Number = {3},
Pages = {462-477},
Month = {APR},
