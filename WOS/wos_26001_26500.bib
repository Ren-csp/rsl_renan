@article{ WOS:001676786900001,
Author = {Fian, Leonie and Vaupotic, Nina and Richter, Isabel and Koelmans, Albert
   A. and Pahl, Sabine},
Title = {Communicating scientific uncertainties: Effects of message and audience
   characteristics in the context of microplastic health risks},
Journal = {PUBLIC UNDERSTANDING OF SCIENCE},
Year = {2026},
Volume = {35},
Number = {4},
Pages = {470-489},
Month = {MAY},
Abstract = {Communicating uncertainties is central to science communication, yet
   evidence on its effects is inconclusive. In an online experiment with a
   quasi-representative sample in Austria (N = 1126), we investigated the
   effects of message (uncertainty type) and audience characteristics
   (science-specific attitudes/beliefs) as potential moderating factors on
   risk perception and policy support in the context of microplastic health
   effects. Uncertainty communication, specifically communicated lack of
   scientific consensus (consensus uncertainty), triggered lower risk
   perception (small effect), and indirectly decreased policy support
   through message credibility and risk perception. These negative effects
   were lower (and not statistically significant) when communicating the
   remaining knowledge gaps (deficient uncertainty). Beliefs about science
   as a debate were positively associated with risk perception, trust in
   scientists with policy support and preference for information about
   uncertain science with both. However, these audience characteristics did
   not moderate the effects of uncertainty communication. The results
   highlight the importance of considering uncertainty types in
   environmental and health risk communication.},
