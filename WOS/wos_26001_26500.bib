@article{ WOS:001493809200002,
Author = {Stefan, Fruzsina and Ciesielski, Mariusz and Weber, Andreas and
   Choromanski, Kamil and Gotlib, Dariusz and Taczanowska, Karolina},
Title = {Understanding generational differences in digital skills and
   recreational behaviour for effective visitor management in forest
   destinations},
Journal = {SCIENTIFIC REPORTS},
