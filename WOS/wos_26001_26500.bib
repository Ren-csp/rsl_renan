@article{ WOS:000232748400021,
Author = {Dal Cin, V and Danesin, M and Boschetti, A and Dorigoni, A and Ramina, A},
Title = {Ethylene biosynthesis and perception in apple fruitlet abscission
   (Malus domestica L. Borck)},
