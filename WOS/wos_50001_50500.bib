@article{ WOS:001390102400005,
Author = {Escher, Beate I. and Ahlheim, Joerg and Boehme, Alexander and Borchardt,
   Dietrich and Brack, Werner and Braun, Georg and Colbourne, John K. and
   Dann, Janek Paul and Gessner, Joern and Jahnke, Annika and Koenig, Maria
   and Kluever, Nils and Krauss, Martin and Lee, Jungeun and Li, Xiaojing
   and Lips, Stefan and Orsini, Luisa and Rinke, Karsten and
   Schmitt-Jansen, Mechthild and Scholz, Stefan and Schulze, Tobias and
   Spahr, Stephanie and Ulrich, Nadin and Weitere, Markus and Varga,
   Elisabeth},
Title = {Mixtures of organic micropollutants exacerbated in vitro neurotoxicity
   of prymnesins and contributed to aquatic toxicity during a toxic algal
   bloom},
Journal = {NATURE WATER},
Year = {2024},
Volume = {2},
Number = {9},
Pages = {889-898},
Month = {SEP},
Abstract = {Prymnesins produced by an algal bloom of Prymnesium parvum led to the
   death of several hundred tons of freshwater fish in the Oder River in
   summer 2022. We investigated effects on aquatic life and human cell
   lines from exposure to extracts of contaminated water collected during
   the fish kill. We detected B-type prymnesins and >120 organic
   micropollutants. The micropollutants occurred at concentrations that
   would cause the predicted mixture risk quotient for aquatic life to
   exceed the acceptable threshold. Extracts of water and filters (biomass
   and particulates) induced moderate effects in vivo in algae, daphnids
   and zebrafish embryos but caused high effects in a human neuronal cell
   line indicating the presence of neurotoxicants. Mixture toxicity
   modelling demonstrated that the in vitro neurotoxic effects were mainly
   caused by the detected B-type prymnesins with minor contributions by
   organic micropollutants. Complex interactions between natural and
   anthropogenic toxicants may underestimate threats to aquatic ecosystems.},
