@article{ WOS:000239093800008,
Author = {Kuo, Trudy Y. and Van Petten, Cyma},
Title = {Prefrontal engagement during source memory retrieval depends on the
   prior encoding task},
Journal = {JOURNAL OF COGNITIVE NEUROSCIENCE},
Year = {2006},
Volume = {18},
Number = {7},
Pages = {1133-1146},
Month = {JUL},
Abstract = {The prefrontal cortex is strongly engaged by some, but {[}lot all;
   episodic memory tests. Prior work has shown that Source recognition
   tests-those that require memory for conjunctions of studied
   attributes-yield deficient performance in patients with prefrontal
   damage and greater prefrontal activity in healthy subjects, as compared
   to simple recognition test. Here, we tested the hypothesis that there is
   no intrinsic relationship between the prefrontal cortex and source
   memory, but that the prefrontal cortex is engaged by the demand to
   retrieve weakly encoded relationships. Subjects attempted to remember
   object color conjunctions after an encoding task that focused oil object
   identity alone, and an integrative encoding task that encouraged
   attention to object color relationship. After the integrative encoding
   task. the late prefrontal brain electrical activity that typically
   occurs in Source memory tests wits eliminated. Earlier brain electrical
   activity related to Successful recognition of the objects was unaffected
   by the nature of prior encoding.},
