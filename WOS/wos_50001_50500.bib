@article{ WOS:000183267400008,
Author = {Sage, JR and Anagnostaras, SG and Mitchell, S and Bronstein, JM and De
   Salles, A and Masterman, D and Knowlton, BJ},
Title = {Analysis of probabilistic classification learning in patients with
   Parkinson's disease before and after pallidotomy surgery},
Journal = {LEARNING \& MEMORY},
Year = {2003},
Volume = {10},
Number = {3},
Pages = {226-236},
Month = {MAY-JUN},
Abstract = {This study examined the characteristics of probabilistic classification
   teaming, a form of implicit learning previously shown to be impaired in
   patients with basal ganglia dysfunction (e.g., Parkinson's disease). In
   this task, subjects learn to predict the weather using associations that
   are formed gradually across many trials, because of the probabilistic
   nature of the cue-outcome relationships. Patients with Parkinson's
   disease, both before and after pallidotomy, and age-matched control
   subjects, exhibited evidence of probabilistic classification learning
   across 100 training trials. However, pallidotomy appears to hinder the
   learning of associations most implicit in nature (i.e., weakly
   associated cues). Although subjects were most sensitive to single-cue
   associations when learning the task, there is evidence that cue
   combinations contribute significantly to probability teaming. The
   utility of multiple dependent measures is discussed.},
