@article{ WOS:000320990500010,
Author = {Jowers, Michael J. and Caut, Stephane and Luis Garcia-Mudarra, Juan and
   Alasaad, Samer and Ineich, Ivan},
Title = {MOLECULAR PHYLOGENETICS OF THE POSSIBLY EXTINCT MARTINIQUE GROUND SNAKE},
Journal = {HERPETOLOGICA},
