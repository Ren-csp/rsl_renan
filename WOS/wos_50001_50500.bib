@article{ WOS:000522470900289,
Author = {Kajima, Shuichiro and Uchiyama, Yuta and Kohsaka, Ryo},
Title = {Intellectual Property Strategies for Timber and Forest Products: The
   Case of Regional Collective Trademark Applications by Japanese Forestry
   Associations},
Journal = {SUSTAINABILITY},
