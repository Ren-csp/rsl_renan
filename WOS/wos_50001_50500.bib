@article{ WOS:001654456100007,
Author = {Angelini, Alessandro M. and Jones, Gareth A.},
Title = {MY NEIGHBOR THE GRINGO: Commercialized Intimacies and Newcomer
   Hospitality in a Rio de Janeiro Favela},
Journal = {CULTURAL ANTHROPOLOGY},
Year = {2025},
Volume = {40},
Number = {4},
Pages = {726-752},
Month = {NOV},
Abstract = {During the past two decades, foreigners have acquired housing stock in
   many of Rio de Janeiro's oldest and most iconic favelas, or self-built
   neighborhoods, and invested in capital improvements, with an eye toward
   turning private residences into lodging accommodations. These new
   arrivals, mainly from the Global North, have altered social milieus and
   property values. The proliferation of favela hostels has signaled a
   market-led displacement of residents and a reproduction of the urban
   periphery. The present essay asks what an anthropology of hospitality
   looks like amid these emergent spaces of commodified culture and
   transnational mobilities. This curious social arrangement wherein
   newcomers play the role of hosts inflects debates over favelas' economic
   trajectories and shifting status in the cultural imaginary. Newcomer
   hosts both aestheticize and monetize a presumed generosity, vitality,
   and promiscuity of working-class residents. Hospitality as cultural rule
   meets the favela as unruly culture. The essay explores ethnographically
   how the concept of conviv \& ecirc;ncia, or living together, comes to
   describe an aspiration to rework urban change amid class and racial
   anxieties about place-belonging and identity. The emergence of
   foreigner-owned accommodations in Rio's favelas reveals a confluence of
   global slum imaginaries and global real estate interests, and how
   resident hosts and traveler guests experience the attendant
   contradictions in the everyday.
   Nas \& uacute;ltimas duas d \& eacute;cadas, estrangeiros t \& ecirc;m
   adquirido im \& oacute;veis em muitas das favelas mais antigas e emblem
   \& aacute;ticas do Rio de Janeiro, e investiram em melhorias de capital,
   visando transformar resid \& ecirc;ncias particulares em hospedagens.
   Esses rec \& eacute;m-chegados, principalmente do Norte Global, t \&
   ecirc;m alterado os meios sociais e os valores imobili \& aacute;rios. A
   prolifera \& ccedil;\& atilde;o de albergues em favelas tem sinalizado
   um deslocamento de moradores impulsionado pelo mercado e uma reprodu \&
   ccedil;\& atilde;o da periferia urbana. O presente artigo investiga como
   se configura uma antropologia da hospitalidade em meio a esses espa \&
   ccedil;os emergentes de cultura mercantilizada e mobilidades
   transnacionais. Esse curioso arranjo social, em que os rec \&
   eacute;m-chegados desempenham o papel de anfitri \& otilde;es,
   influencia os debates sobre as trajet \& oacute;rias econ \& ocirc;micas
   das favelas e sua mudan \& ccedil;a de status no imagin \& aacute;rio
   cultural. Os anfitri \& otilde;es rec \& eacute;m-chegados tanto
   estetizam quanto monetizam uma suposta generosidade, vitalidade e
   promiscuidade dos moradores da classe trabalhadora. A hospitalidade como
   regra cultural encontra a favela como cultura insubmisso. O artigo
   explora etnograficamente como o conceito de conviv \& ecirc;ncia, ou
   viver junto, descreve uma aspira \& ccedil;\& atilde;o por compreender
   as transforma \& ccedil;\& otilde;es urbanas entre ansiedades de classe
   e ra \& ccedil;a sobre o pertencimento e a identidade. O surgimento de
   hospedagens de propriedade de estrangeiros nas periferia urbana do Rio
   revela uma conflu \& ecirc;ncia de imagin \& aacute;rios globais da
   favela e interesses imobili \& aacute;rios globais, e como anfitri \&
   otilde;es residentes e h \& oacute;spedes viajantes vivenciam as
   contradi \& ccedil;\& otilde;es inerentes no cotidiano.},
