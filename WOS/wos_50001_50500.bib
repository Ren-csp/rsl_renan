@article{ WOS:000944623700001,
Author = {Roberts, Patrick and Kaplan, Jed O. O. and Findley, David Max and
   Hamilton, Rebecca and Caetano-Andrade, Victor Lery and Amano, Noel and
   Kay, Andrea U. U. and Renn, Juergen and Winkelmann, Ricarda},
Title = {Mapping our reliance on the tropics can reveal the roots of the
   Anthropocene},
Journal = {NATURE ECOLOGY \& EVOLUTION},
Year = {2023},
Volume = {7},
Number = {5},
Pages = {632-636},
Month = {MAY},
Abstract = {Projecting and managing the feedback between tropical deforestation and
   global Earth system dynamics, and identifying potential critical
   thresholds or tipping points, will be key to our species' future on this
   planet. By understanding the major historical processes that underpin
   the origins of this interaction, and bringing natural and social systems
   together in interdisciplinary models, we can evaluate the degree to
   which past human impacts on tropical forests resulted in observable
   planetary ramifications that have left legacies for the twenty-first
   century and beyond.},
