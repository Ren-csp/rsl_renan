@article{ WOS:000389711400006,
Author = {Garzon Zuniga, Marco Antonio and Gonzalez Zurita, Jazmin and Garcia
   Barrios, Raul},
Title = {Evaluation of a domestic treatment system to reuse wastewater},
Journal = {REVISTA INTERNACIONAL DE CONTAMINACION AMBIENTAL},
Year = {2016},
Volume = {32},
