@article{ WOS:001577534600001,
Author = {Thran, Daniela and Borchers, Malgorzata and Jordan, Matthias and Lenz,
   Volker and Markus, Till and Matzner, Nils and Oehmichen, Katja and Otto,
   Danny and Radtke, Kai Sven and Reshef, Nir and Sadr, Mohammad and
   Siedschlag, Daniela and Wollnik, Ronja},
Title = {The role of BECCS in Germany: a key to sustainable and permanent
   CO2 removal?},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2025},
Volume = {7},
Number = {9},
Month = {SEP 1},
Abstract = {BECCS (bioenergy with CO2 capture and storage) combines CO2 capture and
   storage with the use of bioenergy. This is a promising carbon dioxide
   removal method that can contribute to reaching national net-zero climate
   targets. In this study, we analyzed the current German bioenergy system
   and the related CO2 flows to identify suitable BECCS routes based on
   biogenic waste and residues. Based on those findings, we calculated
   Germany's total BECCS potential from today's bioenergy use and concluded
   recommendations for implementation. In Germany, the existing bioenergy
   system already contributes to renewable energy supply, but is not yet
   geared towards BECCS. With the use of biogenic waste and residues, more
   than 25 million tons of CO2/year in the form of CO2 and biochar could be
   made available for capture with the current bioenergy plant stock. To
   this end, existing bioenergy plants with high CO2 capture potential
   (e.g., waste incineration plants and biomass cogeneration plants) can be
   expanded for BECCS. The successful establishment of BECCS depends on
   technology requirements, costs, environmental impact, and the societal
   and legal environment. It requires testing various BECCS methods and a
   secure investment environment for the development of business models and
   monitoring systems. Inclusive participation strategies are necessary for
   the successful implementation of BECCS to achieve a broad social
   acceptance. The combination of BECCS with nature-based measures for CO2
   removal (e.g., rewetting of peatlands), cascade use of biomass, and
   targeted provision of bioenergy in sectors that are difficult to
   defossilize is of crucial importance for environmental compatibility. In
   addition, BECCS must be integrated into the existing legal framework in
   order to minimize environmental risks and create the necessary
   infrastructure for CO2 transport and storage.},
Publisher = {IOP Publishing Ltd},
Address = {TEMPLE CIRCUS, TEMPLE WAY, BRISTOL BS1 6BE, ENGLAND},
