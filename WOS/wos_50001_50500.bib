@article{ WOS:000686713800009,
Author = {Li, Zhong-Jie and Zhang, Hai-Yang and Ren, Li-Li and Lu, Qing-Bin and
   Ren, Xiang and Zhang, Cui-Hong and Wang, Yi-Fei and Lin, Sheng-Hong and
   Zhang, Xiao-Ai and Li, Jun and Zhao, Shi-Wen and Yi, Zhi-Gang and Chen,
