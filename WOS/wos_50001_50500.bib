@article{ WOS:001790592200001,
Author = {Arntzen, Marthe},
Title = {Interdisciplinary approaches to sustainable development in lower
   secondary schools: comparison of science teachers' and students'
   perspectives},
Journal = {SCANDINAVIAN JOURNAL OF EDUCATIONAL RESEARCH},
Year = {2026},
Month = {2026 JUN 11},
Abstract = {Interdisciplinary approaches in education are increasingly recognized as
   essential for addressing complex challenges, like sustainable
   development (SD). Policy documents emphasize integrating SD into
   curricula and recommend interdisciplinary pedagogies to foster
   comprehensive understanding. In response, authorities in several
   counties have promoted interdisciplinary approaches within national
   curricula. This study explores how interdisciplinary work is experienced
   by science teachers and students, using SD as educational context. A
   central aim was to compare teachers' and students' perspectives to gain
   nuanced understanding of its practical application. Data were collected
   through interviews with three science teachers and seven focus groups
   with their students. Template analysis revealed that teachers interpret
   interdisciplinary topics differently, and students' perceptions
   sometimes diverge from those of their science teacher regarding
   interdisciplinary work with SD. Findings highlight the critical role of
   collaborative planning and incorporating students' voices in creating
   coherent and engaging learning experiences, emphasizing the need for
   strategies that strengthen interdisciplinary teaching.},
