@article{ WOS:000817023100001,
Author = {Goldenberg, Amit and Schone, Jonas and Huang, Zi and Sweeny, Timothy D.
   and Ong, Desmond C. and Brady, Timothy F. and Robinson, Maria M. and
   Levari, David and Zaki, Jamil and Gross, James J.},
Title = {Amplification in the evaluation of multiple emotional expressions over
   time},
Journal = {NATURE HUMAN BEHAVIOUR},
Year = {2022},
Volume = {6},
Number = {10},
Pages = {1408+},
Month = {OCT},
Abstract = {Social interactions are dynamic and unfold over time. To make sense of
   social interactions, people must aggregate sequential information into
   summary, global evaluations. But how do people do this? Here, to address
   this question, we conducted nine studies (N = 1,583) using a diverse set
   of stimuli. Our focus was a central aspect of social interaction-namely,
   the evaluation of others' emotional responses. The results suggest that
   when aggregating sequences of images and videos expressing varying
   degrees of emotion, perceivers overestimate the sequence's average
   emotional intensity. This tendency for overestimation is driven by
   stronger memory of more emotional expressions. A computational model
   supports this account and shows that amplification cannot be explained
   only by nonlinear perception of individual exemplars. Our results
   demonstrate an amplification effect in the perception of sequential
   emotional information, which may have implications for the many types of
   social interactions that involve repeated emotion estimation.
   Goldenberg et al. show that we tend to overestimate the average
   intensity of a sequence of emotional expressions and that this is caused
   by increased memory for stronger expressions.},
