@article{ WOS:001606605500001,
Author = {Xu, Yao and Huang, Jing and Yao, Tianning and Wang, Guohua},
Title = {Spatial Heterogeneity of Carbon Emissions and Low-Carbon Optimization
   for Small Towns Based on the Geographically Weighted Regression Model},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2025},
Volume = {11},
Month = {NOV 4},
Abstract = {The substantial greenhouse gas emissions are exacerbating global
   warming, while urbanization, an unavoidable aspect of social and
   economic advancement, importantly contributes to the increase in carbon
   emissions. Small towns in Southern Jiangsu, referred to as the
   ``Southern Jiangsu Model{''}, have experienced a swift increase in
   carbon emissions due to the expansion of industrial businesses. This
   study focuses on small towns in Southern Jiangsu, utilizing carbon
   emission inventories from 2014 to 2023, along with corrected National
   Polar-orbiting Partnership/Visible Infrared Imaging Radiometer Suite
   nighttime light data. A linear regression model without an intercept is
   constructed to estimate grid-scale carbon emissions. Subsequently,
   geographically weighted regression models are employed to analyze the
   spatial heterogeneity of driving factors, including population scale,
   population density, urbanization rate, regional gross domestic product,
   carbon emission intensity, and industrial structure, thereby delineating
   low-carbon development zones. Research indicates that (a) population
   scale, regional gross domestic product, and carbon emission intensity
   exert a sustained positive influence on carbon emissions, while
   population density, urbanization rate, and industrial structure
   demonstrate regional variations in their effects; (b) small towns in
   Southern Jiangsu can be classified into coordinated development zones,
   green development zones, key governance zones, and innovation
   demonstration zones; and (c) the carbon emission intensity in the key
   governance zone is 23.4\% higher than the regional average, highlighting
   it as a priority area for emission reduction. Accordingly, targeted
   strategies such as optimizing the industrial structure, enhancing energy
   efficiency, introducing low-carbon technologies, and promoting green
   infrastructure development are proposed to achieve decoupling between
   regional economic growth and carbon emissions, thereby supporting the
   implementation of ``dual-carbon{''} goals.},
