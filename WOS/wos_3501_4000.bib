@article{ WOS:001333788700001,
Author = {Sumaryana, Hendra and Buchori, Imam and Sejati, Anang Wahyu},
Title = {Rowali model for Sustainable Urban Green Infrastructure Governance A
   case study of Temanggung urban area},
