@article{ WOS:000554520500010,
Author = {Bauer, S. and Linke, H. J. and Wagner, M.},
Title = {Optimizing water-reuse and increasing water-saving potentials by linking
   treated industrial and municipal wastewater for a sustainable urban
   development},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2020},
Volume = {81},
Number = {9},
Pages = {1927-1940},
Month = {MAY 1},
Abstract = {New industrial and urban developments in water-scarce regions are often
   inhibited by their high demand for water from natural resources. In
   addition, there often is a lack of water for purposes that contribute to
   an improved quality of life, such as urban green spaces. Therefore, the
   integrated industrial-urban water-reuse concept presents a strategy by
   linking and reusing treated industrial and municipal wastewater flows to
   increase urban water-reuse potentials. The concept of combining
   different reuse water flows, from wastewater treatment plants from
   industrial parks, aims at significantly increasing the water-saving
   potentials compared to a separate consideration of the industrial
   wastewater flows.},
