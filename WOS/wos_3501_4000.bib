@article{ WOS:001722428900001,
Author = {Lutz, Paul K. and Wadlow, Madeline E. A. and Zelenski, John M. and
   Desrochers, Jessica E. and Nisbet, Elizabeth K.},
Title = {Does size matter in the human-nature relationship?},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
Year = {2026},
Volume = {257},
Month = {JUL},
Abstract = {Nature-self size, or the extent to which one perceives nature as
   relatively larger than the self, may inform a larger literature on
   subjective views of the human-nature relationship, complementing the
   field's current emphasis on nature connectedness. Across four studies
   (Total N = 1494 Canadian undergraduates), we examined associations
   between a pictorial measure of nature-self size and both pictorial and
   verbal measures of nature connectedness. We also situated nature-self
   size within a broader nomological network spanning pro-environmental,
   mental health, prosocial, and personality domains. Nature-self size
   showed moderate positive correlations with measures of nature
   connectedness and was linked to outcomes across all criterion domains.
   By contrast, measures of nature connectedness typically showed more
   and/or stronger criterion associations. In regression models,
   nature-self size and its nature size component (an independent rating of
   perceived nature size) tended to account for little unique variance
   beyond what nature connectedness explained, especially for
   pro-environmental outcomes. The self size component (an independent
   rating of perceived self size) was a notable predictor of mental health
   and personality outcomes and appeared to drive nature-self size's
   relationships with most of these variables. Together, these findings
   help clarify the role of size in understanding subjective views of the
   human-nature relationship.},
