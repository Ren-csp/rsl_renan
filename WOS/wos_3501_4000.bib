@article{ WOS:001860475100001,
Author = {Guo, Chuyi and Yang, Yuchi and Yang, Wei},
Title = {Space-nature-human associations with land surface temperature across
   nested planning-spatial units: Evidence from Karst Mountainous Guizhou},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {Understanding how urban-spatial, natural, and human-social factors
   jointly relate to land surface temperature (LST) across nested planning
   contexts is important for climate-adaptive planning in mountainous
   cities. Integrated comparisons across planning units that are spatially
   nested but differ in function, environmental background, and development
   conditions remain limited. In mountainous karst Guizhou, Southwest
   China, this study examines the Qianzhong Urban Agglomeration, Guiyang
   Metropolitan Area, and Gui'an New Area. Hot-cold spot analysis,
   XGBoost-SHAP, and MGWR are integrated within a space-nature-human
   (S-N-H) framework to compare LST patterns, model-based variable
   contributions, nonlinear pairwise interactions, and variable-specific
   spatial associations under four seasonal-diurnal scenarios. Summer
   daytime hot spots mainly coincide with builtup areas and development
   corridors, whereas winter hot spots shift toward western and southern
   slopes and karst areas; forested mountains and large water bodies remain
   relatively stable cold spots. Natural-background associations are most
   prominent in the urban agglomeration, regional gradients coexist with
   localized built-form and human-activity associations in the metropolitan
   area, and selected associations become more localized and patchy in the
   new area, although some remain near-global. S-H, S-N, and N-H
   interactions vary in direction, magnitude, and response range across
   planning-spatial and seasonal-diurnal contexts rather than following a
   uniform cross-level progression. Sensitivity analyses support the
   principal interpretations across alternative grid resolutions and
   variable specifications. By linking relative contributions, interaction
   configurations, and spatial ranges, the framework shifts
   thermal-environment analysis from isolated factors to context-specific
   relationships and supports differentiated climate-adaptive planning
   across nested mountainous planning units.},
