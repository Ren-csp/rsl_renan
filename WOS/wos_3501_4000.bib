@article{ WOS:001532897400001,
Author = {Fan, Guoqing and Wang, Yu and Zhao, Shengnan and Qiao, Xuning and Yang,
   Guanwei and Lin, Zhongyun},
Title = {Optimization of social values for ecosystem services assessment based on
   the analytic hierarchy process: A case study of the core district parks
   in Zhengzhou},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {27},
Month = {SEP},
Abstract = {As urban landscape fragmentation intensifies and demand for cultural
   services grows, assessing the social value of urban parks becomes
   increasingly important. This study focuses on 103 parks in Zhengzhou's
   core area, combining the Analytic Hierarchy Process (AHP) with the
   Social Values for Ecosystem Services (SolVES) model. It integrates
   multi-source spatial data (fractional vegetation cover (FVC), population
   density, night-light, etc.) to optimize model environmental layers. Key
   findings include: (1) Park social values show a clear hierarchy:
   aesthetic (2.39) > recreational (2.16) > biodiversity (1.89) >
   educational (1.70). High-value parks are mainly in urban fringe areas,
   closely related to water bodies, high FVC, and population density, with
   FVC contributing the most (39.95 \% on average). (2) AHP addresses the
   key flaw of SolVES in multi-area assessment by creating a differentiated
   indicator weight system (e.g., total park area has the highest weight of
   0.236), enhancing result differentiation and accuracy. (3) The study
   highlights the importance of optimizing park spatial structures in
   densely populated urban areas, proposing park classification and
   regulation strategies based on value differences (ecological,
   recreational, and comprehensive types). These strategies offer
   methodological and empirical support for precise allocation and
   differentiated management of urban green resources.},
