@article{ WOS:001838687600001,
Author = {Tiwari, Prabhat and Patle, Hariom and Baskar, V. David Chella and
   Vadthyavath, Avinash and Srivastav, Manish and Shukla, Saurabh and
   Behera, Subhaprada and Tiwari, Akanksha},
Title = {Assessing the socio-economic and environmental impacts of recreational
   sites in Jhansi, Central India: perceptions of visitors and local
   stakeholders},
Journal = {FRONTIERS IN FORESTS AND GLOBAL CHANGE},
Year = {2026},
Volume = {9},
Month = {JUL 21},
Abstract = {Recreational destinations have been found to be effective in improving
   socio-economic development, environmental conditions, and recreation
   possibilities in urban and semi-urban zones. This study examined the
   socio-economic and environmental effects of various recreational
   locations in the city of Jhansi, Central India. The following
   recreational sites are analysed in this research - Atal Ekta Park,
   Lakshmi Bai Park, Panchtantra Park, and Jhansi Fort. Systematic random
   sampling was conducted on 200 participants for determining the visitor
   preferences, socio-economic contributions, environmental issues, and WTP
   for managing and conserving these places in 2025. Binary logistic
   regression analysis was applied for determining the influence of various
   parameters on visitors' willingness to pay. Meanwhile, the Henry Garrett
   Ranking methodology was used to rank various visitors' preferences. It
   is found out that most respondents showed their willingness to pay some
   minimal amount for conservation. Most visitors preferred paying less
   than (sic)20 as an entrance fee for such activities. Income level has a
   positive impact on willingness to pay, whereas the status of occupation
   and expenditure at the sites have negative effects. The regression model
   shows high explanatory ability (Nagelkerke R-2 = 0.792) and decent model
   fit (Hosmer-Lemeshow test, p > 0.05). In addition, pollution (noise and
   air pollution), overcrowding, littering, and poor cleanliness were found
   to be major environmental issues in recreation areas. It was evident
   that cleanliness, seating, and proper waste disposal are among the major
   needs of visitors. These results emphasize the significance of proper
   environmental management, provision of proper visitor facilities, and
   use of diverse financial models for the proper management of
   recreational areas.},
