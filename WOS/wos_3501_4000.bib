@article{ WOS:001865990700001,
Author = {Kiss, Bethany M. and Bekessy, Sarah A. and Mak, Brandon and Sweet, Fabio
   and Garrard, Georgia E. and Weisser, Wolfgang W. and Visintin, Casey},
Title = {Buildings as accidental habitat: Where animals nest, sleep and forage},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Month = {2026 SEP 2},
Abstract = {Animals have long inhabited human buildings alongside us, but our
   understanding comes from isolated studies, such as reports of a possum
   in the roof or a bat in our walls. What we lack is the building's
   perspective: which building features actually serve as habitat and for
   whom? We first conducted a literature review to identify building
   features used by wildlife and to develop a classification of
   architectural elements relevant to habitat use. We then analysed over a
   decade of wildlife rescue records from Victoria, Australia (2013-2022).
   Using automated content analysis and manual validation, to identify
   wildlife behaviours and building features involved in human-wildlife
   encounters. In total, 2399 wildlife-building interactions were found,
   including nesting, sleeping and foraging behaviours, by 36 native
   species that used 27 different building features. Mammals (78\%), for
   example brushtail \& ringtail possums (26\%, 24\%), microbats (15\%) and
   bare-nosed wombats (10\%), dominated the records, followed by birds
   (18\%) and reptiles (2\%). Building cavities were the most frequently
   used locations (40\% of records), followed by shelters and garages
   (19\%), external surfaces (16\%), interior rooms (10\%), under houses
   (9\%) and utility services (6\%). Building cavities were primarily used
   for sleeping (41\%) and nesting (39\%), while foraging activities were
   more evenly distributed across external surfaces (26\%), decorative
   features (23\%) and cavities (22\%). These patterns demonstrate that
   wildlife use building locations corresponding to their natural habitat,
   with arboreal mammals preferring upper cavities and ground-dwelling
   wildlife using foundation spaces. Our findings represent a critical step
   toward a social-ecological transition from reactive wildlife management
   to evidence-based design. While this study documents how wildlife
   currently use buildings, the broader ambition of intentional design for
   human-wildlife coexistence remains an emerging field requiring further
   research.Read the free for this article on the Journal blog.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article; Early Access},
Language = {English},
