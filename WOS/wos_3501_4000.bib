@article{ WOS:001741930600001,
Author = {Warchalska-Troll, Agata and Pistelok, Pawel and Zielonka, Anna},
Title = {Striking the perfect balance: Integrating greenery and social
   infrastructure in downtown public spaces},
Journal = {CITIES},
Year = {2026},
Volume = {174},
Month = {JUL},
Abstract = {Urban downtowns are characterized by public spaces designed to foster
   social interactions, host large-scale events, and accommodate public
   gatherings. Green spaces enhance these functions by providing areas for
   social engagement and improving the overall outdoor experience. This
   study investigates the extent to which such coexistence has evolved into
   complementary systems of greenery and artificial infrastructure at both
   micro and medium scales. The research focuses on the multifunctionality
   and interchangeability of functions in downtown public spaces, including
   squares, green squares, and parks. The analysis was conducted across
   four selected Polish cities: Chorzow, Kutno, \& Lstrok;\& eogon;czna,
   and W \& lstrok;oc \& lstrok;awek. The Socio-Environmental Quality Index
   for Public Spaces (SEQIPS) was proposed as a framework for rapid
   evaluation of healthy greenery (assessed through remote sensing
   analysis) and the condition of social amenities in various types of
   spaces, using field observations and mapping. The results indicate that
   half of the spaces studied had more than 50\% of greenery in good
   condition, while one-third had less than 10\% impervious surfaces. The
   overall imperviousness averaged 39.4\%. This suggests that these areas
   are relatively green, though land cover patterns varied, particularly
   among green squares: some of these lacked sufficient urban furniture,
   while the other successfully integrated greenery with social
   functionality, facilitating local interactions. The concept of green
   squares acting as `satellites' to larger multifunctional squares is
   proposed to improve urban quality, enhance recreation, and ensure
   equitable access to urban greenery. This approach could also promote
   urban compactness by reducing the need for large parks in central
   districts.},
