@article{ WOS:000478093200011,
Author = {Mata, Luis and Garrard, Georgia E. and Fidler, Fiona and Ives,
   Christopher D. and Maller, Cecily and Wilson, Joab and Thomas, Freya and
   Bekessy, Sarah A.},
Title = {Punching above their weight: the ecological and social benefits of
   pop-up parks},
Journal = {FRONTIERS IN ECOLOGY AND THE ENVIRONMENT},
Year = {2019},
Volume = {17},
Number = {6},
Pages = {341-347},
Month = {AUG},
Abstract = {Current global enthusiasm for urban greening and bringing nature back
   into cities is unprecedented. Evidence of the socioecological benefits
   of large, permanent greenspaces is mounting, but the collective
   potential for pop-up parks (PUPs) - small, temporary greenspaces - to
   augment urban ecosystem services is unknown. To showcase the potential
   of PUPs, we first highlight a case study demonstrating how PUPs may
   enhance biodiversity in a densely urbanized area; we then review
   evidence linking the design of small greenspaces with positive social
   outcomes, including benefits to human well-being. Finally, we emphasize
   how PUPs can function as socioecological laboratories to help inform
   urban design, and then propose a research agenda to better understand
   how PUPs may be optimally designed to provide benefits to humans and
   other species.},
