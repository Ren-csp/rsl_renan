@article{ WOS:001060728900003,
Author = {Lombard, Amanda T. and Clifford-Holmes, Jai and Goodall, Victoria and
   Snow, Bernadette and Truter, Hannah and Vrancken, Patrick and Jones,
   Peter J. S. and Cochrane, Kevern and Flannery, Wesley and Hicks,
   Christina and Gipperth, Lena and Allison, Edward H. and Diz, Daniela and
   Peters, Kimberley and Erinosho, Bolanle and Levin, Phillip and Holthus,
   Paul and Szephegyi, Maria Nube and Awad, Adnan and Golo, Harrison and
   Morgera, Elisa},
Title = {Principles for transformative ocean governance},
Journal = {NATURE SUSTAINABILITY},
Year = {2023},
Volume = {6},
Number = {12},
Pages = {1587-1599},
Month = {DEC},
Abstract = {With a focus on oceans, we collaborated across ecological, social and
   legal disciplines to respond to the United Nations call for
   transformation in the `2030 Agenda for Sustainable Development'. We
   developed a set of 13 principles that strategically and critically
   connect transformative ocean research to transformative ocean governance
   (complementing the UN Decade for Ocean Science). We used a rigorous,
   iterative and transparent consensus-building approach to define the
   principles, which can interact in supporting, neutral or sometimes
   conflicting ways. We recommend that the principles could be applied as a
   comprehensive set and discuss how to learn from their interactions,
   particularly those that reveal hidden tensions. The principles can bring
   and keep together partnerships for innovative ocean action. This action
   must respond to the many calls to reform current ocean-use practices
   which are based on economic growth models that have perpetuated
   inequities and fuelled conflict and environmental decline.
   The UN 2030 Agenda for Sustainable Development recognizes the need to
   transform governance for the world to develop sustainably. Using a mixed
   method approach, this study presents 13 principles for transformative
   ocean governance that can help turn ocean-use practices into more
   sustainable ones.},
