@article{ WOS:000462613400008,
Author = {Wang, Wei and Li, Chun and Wu, Xiao-Chun},
Title = {An adult specimen of Sinocyamodus xinpuensis (Sauropterygia:
   Placodontia) from Guanling, Guizhou, China},
