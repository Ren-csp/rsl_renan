@article{ WOS:000818630800001,
Author = {Richmond, Sakyi and Cornelius, Tengan},
Title = {Dimensions of Destination Attractiveness in Cape Coast},
Journal = {EUROPEAN JOURNAL OF TOURISM HOSPITALITY AND RECREATION},
