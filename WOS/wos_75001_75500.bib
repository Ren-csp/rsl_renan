@incollection{ WOS:000879690200025,
Author = {Shackleton, Ross T. and Novoa, Ana and Shackleton, Charlie M. and Kull,
   Christian A.},
Editor = {vanWilgen, BW and Measey, J and Richardson, DM and Wilson, JR and Zengeya, TA},
Title = {The Social Dimensions of Biological Invasions in South Africa},
