@article{ WOS:001356227300002,
Author = {Jofre, Daniel and Cabrera, Jose},
Title = {Social memory, youth, and intergenerational transits: affections,
   symbols and images},
Journal = {LIMITE-REVISTA DE FILOSOFIA Y PSICOLOGIA},
Year = {2024},
Volume = {19},
Abstract = {This article reflects on intergenerational transits in scenarios of
   political and social transformation. The research is based on critical
   studies in social philosophy and collective memory and takes
   investigations that develop comprehensive hypotheses on the identity and
   generational logic of Chilean youth as an object of inquiry. This
   perspective is complemented by Georges Didi-Huberman's elaborations
   regarding the transits of affections as subversive potential compared to
   the affections-power present in societies. It concludes on the
   importance of recognizing the continuity of transits between the
   generations of slogans, images, and affections present among young
   Chileans, which allows us to account for a wide time period where they
   anchor their subjective positioning.},
