@article{ WOS:000241620200009,
Author = {Sullivan, Regina and Wilson, Donald A. and Feldon, Joram and Yee,
   Benjamin K. and Meyer, Urs and Richter-Levin, Gal and Avi, Avital and
   Michael, Tsoory and Gruss, Michael and Rock, Joerg and Helmeke, Carina
   and Braun, Katharina},
Title = {The international society for developmental psychobiology annual meeting
   symposium: Impact of early life experiences on brain and behavioral
   development},
Journal = {DEVELOPMENTAL PSYCHOBIOLOGY},
Year = {2006},
Volume = {48},
Number = {7},
