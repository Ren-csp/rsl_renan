@article{ WOS:000631639200001,
Author = {Bosniuk, Valerii and Ostopolets, Iryna and Svitlychna, Nataliia and
   Miroshnichenko, Oksana and Tsipan, Tetiana and Kubitskyi, Serhii},
Title = {Social Content of Psychological Specialists' Professional Activity},
