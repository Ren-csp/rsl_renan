@article{ WOS:001748671700001,
Author = {Bonifacio, Luke R. and Farquhar, Jules E. and Chapple, David G. and
   Walsh, Jessica C.},
Title = {Raising practitioner awareness to improve conservation of Data Deficient
   species: Evidence from before-and-after interviews},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2026},
Volume = {318},
Month = {JUN},
Abstract = {The IUCN Red List recommends that Data Deficient (DD) species are
   afforded the same conservation attention as threatened taxa; yet, this
   is rarely followed in funding schemes and policy. We tested whether this
   advice is being applied on-ground, and if awareness and conservation
   management of DD species could be enhanced, with a seldom-used
   dual-interview method: 1) preliminary interviews with 25 conservation
   practitioners, to determine if they manage specifically for DD
   Australian skinks, and what challenges they face in managing these
   species; 2) follow-up interviews with the same practitioners, to
   investigate whether their perceptions and behaviours towards managing DD
   species changed after receiving new scientific data on them.
   Concerningly, before receiving the new scientific data, no practitioners
   were managing specifically for their region's DD skinks. In fact, 57\%
   of the time, participants had not even heard of the DD skink species
   within their management region. Insufficient data and knowledge on these
   species, difficulty managing their threats, funding issues, and the lack
   of a `threatened' status were practitioners' main reasons for not
   managing for these taxa. Optimistically though, 64\% of practitioners
   were `much more likely' or `more likely' to manage for these taxa after
   receiving the new data; indeed, four practitioners had already begun
   doing so. Our findings provide the first quantified evidence of DD
   species being overlooked in on-ground conservation, but suggest that
   raising practitioner awareness with new data can help alleviate this
   issue. With most DD species globally likely being threatened, our
   findings reinforce how they warrant increased conservation attention.},
