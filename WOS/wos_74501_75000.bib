@article{ WOS:000726940100001,
Author = {Tessier, Marine and Lamothe, Josianne and Geoffrion, Steve},
Title = {Adherence to Psychological First Aid after Exposure to a Traumatic Event
   at Work among EMS Workers: A Qualitative Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
