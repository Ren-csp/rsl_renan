@article{ WOS:000444262900002,
Author = {Audzijonyte, Asta and Richards, Shane A.},
Title = {The Energetic Cost of Reproduction and Its Effect on Optimal
   Life-History Strategies},
Journal = {AMERICAN NATURALIST},
