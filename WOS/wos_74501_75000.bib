@article{ WOS:000995682600001,
Author = {Lee, Byung-Mu and Bearth, Angela and Tighe, Robert M. and Kim, Manho and
   Tan, Simon and Kwon, Seok},
Title = {Biocidal products: Opportunities in risk assessment, management, and
   communication},
