@article{ WOS:000752731800001,
Author = {Hanley, Carol D. and Hudson, Lauren and Prichard, Chris and Vanderford,
   Nathan L.},
Title = {Impact of the Appalachian Career Training in Oncology (ACTION) Program
   on Undergraduate Participants},
Journal = {JOURNAL OF CANCER EDUCATION},
