@article{ WOS:001870562200001,
Author = {Svenfelt, Asa and Gustafsson, Sara and Hermelin, Brita},
Title = {Emerging planning practices for enabling citizens' sustainable food
   consumption},
Journal = {FRONTIERS IN SUSTAINABILITY},
Year = {2026},
Volume = {7},
Month = {AUG 26},
Abstract = {Previous research has shown that Swedish municipalities have several
   policies related to sustainable food consumption in place. For example,
   there are successful examples of how municipalities work with
   sustainable meals, food procurement policies, and food waste
   minimization in schools and nursing homes. However, most examples focus
   on the municipalities' own operations, with fewer municipalities
   including citizens and other actors in their initiatives. This paper
   aims to understand emerging practices by which local governments can
   enable sustainable food consumption among residents and visitors,
   through tapping in on the perspectives of civil servants and their
   perceptions of processes and potentials. The paper qualitatively
   explores the targets, organization, planning practices and worldviews
   related to sustainable food consumption in the municipalities', to draw
   conclusions on how emerging practices could enable sustainable food
   consumption in society. We conducted interviews with civil servants in
   six Swedish municipalities. The selection was based on a scan of
   keywords related to sustainable food consumption on the websites of all
   290 local governments in Sweden. The results from the study are in line
   with previous research showing that consumption-related policies and
   strategies of Swedish local governments primarily target internal
   processes and activities within their own organizational boundaries. But
   there are also several examples of local governments that have engaged
   in enabling sustainable food consumption among their citizens. Several
   of these municipalities have adopted consumption-based local climate
   targets. The study shows that municipalities are emerging as key actors
   in shaping sustainable food consumption, despite limited national
   guidance and political sensitivities. Their approaches range from modest
   isolated projects and interventions to systemic strategies involving
   partnerships, land-use planning, and citizen co-creation. They adopt
   varied outreach approaches, focusing on direct public engagement or
   policy initiatives targeting civil society and the private sector. The
   diversity of planning practices reflects both contextual constraints and
   opportunities for innovation. The results indicate that local
   governments can play diverse roles in promoting sustainable food
   consumption, but that there are diverging and sometimes conflicting
   views about whether municipalities have, or should have, the authority
   and agency to influence food consumption in local society.},
