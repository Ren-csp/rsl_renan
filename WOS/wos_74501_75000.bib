@article{ WOS:000494041100002,
Author = {Taecharungroj, Viriya and Muthuta, Morakot and Boonchaiyapruek,
   Pheereeya},
Title = {Sustainability as a place brand position: a resident-centric analysis of
   the ten towns in the vicinity of Bangkok},
Journal = {PLACE BRANDING AND PUBLIC DIPLOMACY},
Year = {2019},
Volume = {15},
Number = {4, SI},
Pages = {210-228},
Month = {DEC},
Abstract = {A number of cities and towns have used sustainability as a brand
   position, but most appear to have focused on the environmental aspect of
   sustainability, while the adoption of other dimensions of
   sustainability, including social and economic, has been limited. The
   objective of this study is to create a branding tool that can help towns
   develop a brand position that is credible, drives growth, involves
   residents and fosters sustainability. This sustainable place branding
   analysis was adapted from the importance-performance analysis widely
   used in business and in the tourism industry. The data were collected
   from the residents of ten towns in the vicinity of Bangkok, Thailand.
   The tool provides mayors with a holistic analysis of sustainability,
   suggests dimensions to be considered in the brand position and guides
   strategic actions to sustainably develop places. From the findings, the
   authors suggest five types of sustainable towns that the mayors of the
   ten towns can adopt as a brand position: elegant, compassionate, lively,
   peaceful and green.},
