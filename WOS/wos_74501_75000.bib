@article{ WOS:000433564900006,
Author = {Adamescu, Gabriela S. and Plumptre, Andrew J. and Abernethy, Katharine
   A. and Polansky, Leo and Bush, Emma R. and Chapman, Colin A. and Shoo,
   Luke P. and Fayolle, Adeline and Janmaat, Karline R. L. and Robbins,
   Martha M. and Ndangalasi, Henry J. and Cordeiro, Norbert J. and Gilby,
   Ian C. and Wittig, Roman M. and Breuer, Thomas and Hockemba, Mireille
   Breuer-Ndoundou and Sanz, Crickette M. and Morgan, David B. and Pusey,
