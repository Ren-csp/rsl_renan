@article{ WOS:000809134900001,
Author = {Zagaja, Anna and Bogusz, Renata and Sak, Jaroslaw and Wiechetek, Michal
   and Pawlikowski, Jakub},
Title = {Quality of Informed Consent in Mammography Screening-The Polish
   Experience},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
