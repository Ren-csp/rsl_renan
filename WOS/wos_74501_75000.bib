@article{ WOS:001478439700001,
Author = {Louppe, Vivien and Le Verger, Kevin and Clavel, Julien and Ferreira,
   Gabriel S. and Kyriakouli, Christina and Stanley, Edward L. and Watt,
   Emily C. and Bardua, Carla and Perez-Ben, Celeste and Froebisch, Nadia
   B. and Bothe, Vivien and Boistel, Renaud and Daghfous, Gheylen and
   Goswami, Anjali and Fabre, Anne-Claire},
Title = {Complete metamorphosis promotes morphological and functional diversity
   in Caudata},
Journal = {FUNCTIONAL ECOLOGY},
Year = {2025},
Volume = {39},
Number = {7},
Pages = {1732-1747},
Month = {JUL},
Abstract = {Metamorphosis, a common and spectacular developmental process, involves
   major phenotypic changes often linked to environmental transitions.
   Understanding how these changes affect morphological evolution is
   crucial for examining metamorphosis's evolutionary impacts. In this
   study, we analysed the role of metamorphosis and life cycle variation on
   the morphological evolution of the mandible in Caudata (salamanders and
   newts), a clade that exhibits a great diversity of life cycles and
   ecologies. We focused on the mandible, a key component of the
   masticatory apparatus, to investigate how life cycle variation may
   influence the diversification of feeding modes. Using 3D geometric
   morphometrics on 317 extant species of Caudata, we found that both life
   cycle and size influence mandible shape, with complex interactions
   between these factors. The morphology of the mandibular bones evolved
   more independently in species undergoing complete metamorphosis compared
   to those with partial metamorphosis, likely facilitating feeding
   diversification in terrestrial adults. On the other hand, high
   morphological integration in species undergoing partial metamorphosis
   could promote the rapid evolution of traits, resulting in the
   differentiation of more disparate morphologies, potentially aiding
   paedomorphic species in adapting to challenging environments. This study
   highlights the interplay between metamorphosis and the environment in
   shaping morphological evolution among species and provides new insights
   into the role of heterochrony in the morphological diversification of
   organisms.Read the free Plain Language Summary for this article on the
   Journal blog.
   La m \& eacute;tamorphose, un processus de d \& eacute;veloppement aussi
   commun que spectaculaire, implique des changements ph \&
   eacute;notypiques majeurs souvent associ \& eacute;s \& agrave; des
   transitions environnementales entre stades d \& eacute;veloppementaux.
   Comprendre comment ces changements influencent l'\& eacute;volution
   morphologique est essentiel pour appr \& eacute;hender les impacts \&
   eacute;volutifs de la m \& eacute;tamorphose. Dans cette \& eacute;tude,
   nous avons analys \& eacute; le r \& ocirc;le de la m \&
   eacute;tamorphose et des variations du cycle de vie sur l'\&
   eacute;volution morphologique de la mandibule chez les Caudata
   (salamandres et tritons), un clade qui pr \& eacute;sente une grande
   diversit \& eacute; de cycles de vie et d'\& eacute;cologies. Nous nous
   sommes concentr \& eacute;s sur la mandibule, une structure cl \&
   eacute; de l'appareil masticatoire, afin d'explorer comment les
   variations du cycle de vie ont pu influencer la diversification des
   modes d'alimentation. En appliquant des techniques de morphom \&
   eacute;trie g \& eacute;om \& eacute;trique 3D sur 317 esp \& egrave;ces
   actuelles de Caudata, nous avons constat \& eacute; que le cycle de vie
   et la taille interagissent de mani \& egrave;re complexe sur la diversit
   \& eacute; de formes des mandibules. La morphologie des os mandibulaires
   a \& eacute;volu \& eacute; de mani \& egrave;re plus ind \&
   eacute;pendante chez les esp \& egrave;ces subissant une m \&
   eacute;tamorphose compl \& egrave;te que chez les esp \& egrave;ces
   ayant une m \& eacute;tamorphose partielle, ayant probablement facilit
   \& eacute; la diversification alimentaire chez les adultes terrestres.
   En revanche, une int \& eacute;gration morphologique \& eacute;lev \&
   eacute;e chez les esp \& egrave;ces ayant une m \& eacute;tamorphose
   partielle pourrait avoir favoris \& eacute; l'\& eacute;volution rapide
   des traits et conduit \& agrave; des morphologies plus disparates. Ces r
   \& eacute;sultats sugg \& egrave;rent que l'int \& eacute;gration ph \&
   eacute;notypique a pu jouer un r \& ocirc;le dans la capacit \& eacute;
   des esp \& egrave;ces p \& eacute;domorphiques \& agrave; s'adapter \&
   agrave; des environnements complexes. Cette \& eacute;tude met en lumi
   \& egrave;re les interactions entre m \& eacute;tamorphose et
   environnement intervenant dans l'\& eacute;volution morphologique entre
   esp \& egrave;ces et fournit de nouvelles perspectives sur le r \&
   ocirc;le de l'h \& eacute;t \& eacute;rochronie dans la diversification
   morphologique des organismes.},
