@article{ WOS:000455354800009,
Author = {Zhu, Gui-fang and Xu, Yang-wei and Li, Jian and Niu, Hui-lin and Ma,
   Wen-xia and Xu, Jia and Zhou, Pei-rong and Liu, Xia and Ye, Dan-li and
   Liu, Xiao-rong and Yan, Tao and Zhai, Wei-ke and Xu, Zhi-jun and Liu,
   Chun and Wang, Lei and Wang, Hao and Luo, Jia-mao and Liu, Li and Li,
   Xuan-qi and Guo, Suiqun and Jiang, Hui-ping and Shen, Peng and Lin,
   Hui-kuan and Yu, Di-hua and Ding, Yan-qing and Zhang, Qing-ling},
Title = {RETRACTED: Mir20a/106a-WTX axis regulates RhoGDla/CDC42 signaling and
   colon cancer progression (Retracted Article)},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JAN 10},
Abstract = {Wilms tumor gene on the X chromosome (WTX) is a putative tumor
   suppressor gene in Wilms tumor, but its expression and functions in
   other tumors are unclear. Colorectal cancer (CRC) is the third leading
   cause of cancer-related deaths in women and the second leading cause in
   men in the United States. We demonstrated that WTX frequently lost in
   CRC which was highly correlated with cell proliferation, tumor invasion
   and metastasis. Mechanistically, WTX loss disrupts the interaction
   between RhoGDI alpha and CDC42 by losing of the binding with RhoGDI
   alpha and triggers the activation of CDC42 and its downstream cascades,
   which promotes CRC development and liver metastasis. The aberrant
   upregulation of miR-20a/ miR-106a were identified as the reason of WTX
   loss in CRC both in vivo and in vitro. These study defined the mechanism
   how miR-20a/miR-106a-mediated WTX loss regulates CRC progression and
   metastasis, and provided a potential therapeutic target for preventing
   CRC progression.},
