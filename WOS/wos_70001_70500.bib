@article{ WOS:000687325100022,
Author = {Hasni, Sarfaraz A. and Gupta, Sarthak and Davis, Michael and Poncio,
   Elaine and Temesgen-Oyelakin, Yenealem and Carlucci, Philip M. and Wang,
   Xinghao and Naqi, Mohammad and Playford, Martin P. and Goel, Rishi R.
   and Li, Xiaobai and Biehl, Ann J. and Ochoa-Navas, Isabel and Manna,
   Zerai and Shi, Yinghui and Thomas, Donald and Chen, Jinguo and
   Biancotto, Angelique and Apps, Richard and Cheung, Foo and Kotliarov,
   Yuri and Babyak, Ashley L. and Zhou, Huizhi and Shi, Rongye and
   Stagliano, Katie and Tsai, Wanxia Li and Vian, Laura and Gazaniga,
   Nathalia and Giudice, Valentina and Lu, Shajia and Brooks, Stephen R.
   and MacKay, Meggan and Gregersen, Peter and Mehta, Nehal N. and Remaley,
   Alan T. and Diamond, Betty and O'Shea, John J. and Gadina, Massimo and
   Kaplan, Mariana J.},
Title = {Phase 1 double-blind randomized safety trial of the Janus kinase
   inhibitor tofacitinib in systemic lupus erythematosus},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {JUN 7},
Abstract = {Increased risk of premature cardiovascular disease (CVD) is well
   recognized in systemic lupus erythematosus (SLE). Aberrant type
   I-Interferon (IFN)-neutrophil interactions contribute to this enhanced
   CVD risk. In lupus animal models, the Janus kinase (JAK) inhibitor
   tofacitinib improves clinical features, immune dysregulation and
   vascular dysfunction. We conducted a randomized, double-blind,
   placebo-controlled clinical trial of tofacitinib in SLE subjects
   (ClinicalTrials.gov NCT02535689). In this study, 30 subjects are
   randomized to tofacitinib (5 mg twice daily) or placebo in 2:1 block.
   The primary outcome of this study is safety and tolerability of
   tofacitinib. The secondary outcomes include clinical response and
   mechanistic studies. The tofacitinib is found to be safe in SLE meeting
   study's primary endpoint. We also show that tofacitinib improves
   cardiometabolic and immunologic parameters associated with the premature
   atherosclerosis in SLE. Tofacitinib improves high-density lipoprotein
   cholesterol levels (p = 0.0006, CI 95\%: 4.12, 13.32) and particle
   number (p = 0.0008, CI 95\%: 1.58, 5.33); lecithin: cholesterol
   acyltransferase concentration (p = 0.024, CI 95\%: 1.1, -26.5),
   cholesterol efflux capacity (p = 0.08, CI 95\%: -0.01, 0.24),
   improvements in arterial stiffness and endothelium-dependent
   vasorelaxation and decrease in type I IFN gene signature, low-density
   granulocytes and circulating NETs. Some of these improvements are more
   robust in subjects with STAT4 risk allele.
   Increased risk of premature cardiovascular disease in systemic lupus
   erythematosus (SLE) is not well understood, but in animal models, the
   Janus kinase inhibitor tofacitinib improves related phenotypes. Here the
   authors report a Phase 1 double-blind randomized trial that shows
   tofacitinib is safe and well tolerated in in patients with SLE.},
