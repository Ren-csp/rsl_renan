@article{ WOS:000256419600008,
Author = {Fu Xiaoyang and Dale, P. E. R. and Zhang Shuqing},
Title = {Evolving neural network using variable string genetic algorithm for
   color infrared aerial image classification},
Journal = {CHINESE GEOGRAPHICAL SCIENCE},
Year = {2008},
Volume = {18},
