@article{ WOS:001521538800001,
Author = {Tregerman, Maya Mazor},
Title = {Policy coherence and annual school field trips in Israel},
Journal = {JOURNAL OF OUTDOOR AND ENVIRONMENTAL EDUCATION},
Year = {2026},
Volume = {29},
Number = {2},
Pages = {783-802},
Month = {JUN},
Abstract = {The research explores policy coherence regarding the itinerary planning
   of annual school fieldtrips in Israel's state education system. It
   explores the policy guidelines regarding itinerary planning, the
   considerations that are emphasized, and the policy's dissemination
   process. The research also considers the perception of the policy's
   coherence by policymakers, principals, and teachers. A qualitative
   thematic analysis was used to analyze the data: policy documents and
   transcriptions of 12 in-depth, semi-structured interviews with school
   principals, teachers, and senior policymakers in the Ministry of
   Education. Geographic information systems analysis (GIS) was used to
   spatially analyze information presented on two online media channels
   used for planning fieldtrip itineraries. The findings reveal that all
   stakeholders view policy related to safety and security as coherent,
   while policy regarding pedagogical issues is perceived as incoherent.
   The research suggests that improving media channels, including online
   media, could contribute to policy coherence by improving the process of
   itinerary planning. Increasing access to policy documents is thought to
   increase the acceptance, adoption, and adaptation of these generally
   laid guidelines by the field through the formation of shared local
   meanings of these guidelines.},
