@article{ WOS:000529342300195,
Author = {Walsh, Daniel and Foster, Juliet},
Title = {A Contagious Other? Exploring the Public's Appraisals of Contact with
   `Mental Illness'},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {6},
Month = {MAR 2},
Abstract = {Mental illness has recurrently been found to be Othered by the lay
   public, although few researchers have examined the affective and
   implicit processes involved. To explore this, we triangulated facial
   electromyography (EMG), self-reports, and individual interview data,
   finding participants to Other mental illness, a process that involved
   disgust, fear and pity. Furthermore, mental illness was considered to
   have the potential to permeate, posing a contagious threat. This
   research highlights the need to fully explore the forms of
   understanding, which maintain mental-health related stigma, including
   beliefs about contamination, and the implications this may have for the
   design of anti-stigma campaigns.},
