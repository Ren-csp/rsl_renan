@article{ WOS:000430092100019,
Author = {Robert, German and Munoz, Nacira and Alvarado-Affantranger, Xochitl and
   Saavedra, Laura and Davidenco, Vanina and Rodriguez-Kessler, Margarita
   and Estrada-Navarrete, Georgina and Sanchez, Federico and Lascano,
   Ramiro},
Title = {Phosphatidylinositol 3-kinase function at very early symbiont
   perception: a local nodulation control under stress conditions?},
Journal = {JOURNAL OF EXPERIMENTAL BOTANY},
Year = {2018},
Volume = {69},
Number = {8},
Pages = {2037-2048},
Month = {APR 3},
Abstract = {Root hair curling is an early and essential morphological change
   required for the success of the symbiotic interaction between legumes
   and rhizobia. At this stage rhizobia grow as an infection thread within
   root hairs and are internalized into the plant cells by endocytosis,
   where the PI3K enzyme plays important roles. Previous observations show
   that stress conditions affect early stages of the symbiotic interaction,
   from 2 to 30 min post-inoculation, which we term as very early host
   responses, and affect symbiosis establishment. Herein, we demonstrated
   the relevance of the very early host responses for the symbiotic
   interaction. PI3K and the NADPH oxidase complex are found to have key
   roles in the microsymbiont recognition response, modulating the
   apoplastic and intracellular/endosomal ROS induction in root hairs.
   Interestingly, compared with soybean mutant plants that do not perceive
   the symbiont, we demonstrated that the very early symbiont perception
   under sublethal saline stress conditions induced root hair death.
   Together, these results highlight not only the importance of the very
   early host-responses on later stages of the symbiont interaction, but
   also suggest that they act as a mechanism for local control of
   nodulation capacity, prior to the abortion of the infection thread,
   preventing the allocation of resources/energy for nodule formation under
   unfavorable environmental conditions.},
