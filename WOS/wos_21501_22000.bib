@article{ WOS:001777076500001,
Author = {Salvatori, Valeria and Balian, Estelle and Marsden, Katrina and Young,
   Juliette C.},
Title = {Pastoralist views and positions on coexistence with large carnivores. An
   overview from conflict areas across Europe},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2200-2211},
Month = {JUL},
Abstract = {While large carnivore expansion is a conservation success, it
   increasingly challenges pastoralism. Beyond economic value, pastoralism
   provides critical biodiversity and sociocultural benefits, recognized by
   the UN and the EU's `High Nature Value farming' designation. However,
   carnivore impacts threaten the motivation of pastoralists to continue,
   risking these multidimensional benefits. We interviewed 27 pastoralists
   across seven European high-conflict areas (Spain, Italy, Romania,
   France, Sweden and Finland) to assess their experiences, stakeholder
   relationships and future outlooks. Most interviewees reported increased
   attacks over the last 5 years, attributed to population growth driven by
   reintroductions, natural recolonization under protection or insufficient
   management (e.g. lack of hunting). Although aware of prevention
   measures, perceptions of efficacy vary: fences are preferred in Spain
   and Italy, while livestock guarding dogs are primary in France.
   Institutional support for these tools is consistently deemed
   insufficient. Two thirds of respondents demand urgent action, reporting
   psychological distress and abandonment. Over half-particularly in
   Southern Europe-threaten to cease activities without management reforms.
   Proposed solutions include population reduction and relaxed protection
   status. Increasing carnivore populations threaten the economic and
   cultural viability of pastoralism. This pressure is most acute in
   Southern Europe, compounded by market and climate shifts. This study
   highlights the urgency of integrating traditional land use with modern
   conservation, calling for greater recognition of predator-human impacts
   and collaborative, institutionally supported solution spaces.Read the
   free for this article on the Journal blog.},
