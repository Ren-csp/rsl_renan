Affiliation = {Hitchings, R (Corresponding Author), UCL, Dept Geog, Gower St, London WC1E 6BT, England.
   Hodgson, Antonia; Hitchings, Russell, UCL, Dept Geog, Gower St, London WC1E 6BT, England.},
