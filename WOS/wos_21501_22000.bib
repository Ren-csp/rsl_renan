@article{ WOS:000212543000003,
Author = {McDowall, Siriporn and Choi, Youngsoo},
Title = {A Comparative Analysis of Thailand Residents' Perception of Tourism's
   Impacts},
Journal = {JOURNAL OF QUALITY ASSURANCE IN HOSPITALITY \& TOURISM},
Year = {2010},
Volume = {11},
Number = {1},
Pages = {36-55},
Abstract = {This study examines Thai residents' perception of tourism's impacts on
   their communities. Two destination groups in Southern Thailand
   representing domestic and international tourist destinations were chosen
   to explore the similarities and differences in their residents'
   perception of tourism and its development. The results revealed that the
   majority of respondents were female, 18 to 34 years of age, single, and
   born in the surveyed area. Thai respondents perceived preservation and
   encouragement of local culture, an increase in investment, and an
   increase in local government's revenues as the top three impacts of
   tourism. Residents who resided in domestic tourist destinations differed
   from those who lived in international tourist destinations in regard to
   environmental, economic, and social factors.},
