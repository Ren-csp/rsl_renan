@article{ WOS:001564218100012,
Author = {Tong, Xin and Li, Ke},
Title = {The measurement, spatial-temporal evolution and influencing factors of
   urban green and low-carbon development level},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {The Urban Green and Low-carbon Development level are of great
   significance for realizing the goal of Carbon reduction. This paper
   estimates 273 cities Urban Green and Low-carbon Development level and
   reveals the spatial non-equilibrium of UGLD level via the dagum Gini
   coefficient, kernel density estimation, and exploratory spatial data
   analysis. Finally, geographically time weighted regression model is
   applied to investigate the spatial heterogeneity of influencing factors
   from the perspective of time and space. The study confirms the Urban
   Green and Low-carbon Development level display an overall fluctuating
   upward trend, with pronounced regional disparities that narrow over
   time. The Urban Green and Low-carbon Development level of non-resource
   cities is on the rise steadily from the perspective of resource
   endowment while that of resource cities is on the decline. Economic
   development level, opening up, R\&D investment, informatization degree,
   and government support have significant spatial heterogeneity on urban
   green and low-carbon development, among these only government support
   has a positive effect across all sampled cities.},
