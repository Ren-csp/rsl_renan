@article{ WOS:001813135300001,
Author = {Qian, Weiwei and Gui, Feng and Cai, Huiwen and Zhao, Sheng},
Title = {Exploring citizens' perceptions of avian ecosystem services and
   disservices and their influencing factors in Zhoushan: a structural
   equation modeling approach},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {14},
Month = {JUN 23},
Abstract = {Urban birds play a dual role by providing ecosystem services and causing
   potential disservices, both of which influence environmental quality and
   human well-being. However, how urban residents perceive these functions
   and what drives such perceptions remain insufficiently understood. This
   study investigates the influencing factors behind citizens' perceptions
   of avian ecosystem services and disservices in the context of
   sustainable urban biodiversity management. A structured questionnaire
   survey was conducted with 1500 residents in Zhoushan, China-an island
   city experiencing rapid urbanization. Using structural equation
   modeling, we examined the pathways linking sociodemographic
   characteristics, nature-related experiences, bird visibility, bird
   species knowledge, and nature relatedness to perceptions of cultural
   ecosystem services (CES), regulation and maintenance services (RES), and
   ecological disservices. Results show that although respondents had low
   bird visibility and species knowledge, their attitudes toward birds were
   positive. Crucially, nature relatedness not only enhanced recognition of
   CES and RES but also mitigated disservice concerns-outpacing the effects
   of both knowledge and visibility. This underscores the pivotal role of
   nature relatedness in shaping balanced perceptions. These findings
   highlight the importance of integrating public perceptions into
   biodiversity policies. Targeted environmental education and outreach
   that improve ecological knowledge and foster emotional connections to
   nature can promote more bird-friendly attitudes and contribute to
   sustainable urban management.},
