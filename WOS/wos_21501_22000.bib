@article{ WOS:001411789200001,
Author = {Hoegh-Krohn, Solveig Kristine Bortne and Haarstad, Havard and Ytre-Arne,
   Brita},
Title = {Climate Change Is an Intangible News Topic: A Qualitative Analysis of
   Audience Perceptions},
Journal = {ENVIRONMENTAL COMMUNICATION-A JOURNAL OF NATURE AND CULTURE},
Year = {2025},
Volume = {19},
Number = {4},
Pages = {819-832},
Month = {MAY 19},
Abstract = {In this article we examine how news audiences perceive the issue of
   climate change, arguing that it appears intangible compared to other
   major news topics people routinely encounter in everyday media use. Our
   study contributes to existing research on climate journalism by
   prioritizing an audience perspective, combining scholarship on
   temporalities in climate journalism with environmental social science
   perspectives on climate as a difficult issue to grasp. We analyze
   qualitative in-depth interviews conducted in Norway, against the
   backdrop of the war in Ukraine, energy shortages and rising costs of
   living, asking how people relate to climate change as compared to other
   societal crises covered in the news. Our findings highlight three ways
   in which climate change appears intangible to audiences: the topic is
   less integrated into everyday news media habits, appears less clearly
   demarcated, and lacks spatiotemporal grounding. As an implication of
   these findings, we underline intangibility as a relevant explanation for
   noted problems in climate journalism, and discuss how to engage
   audiences on an important issue that is ill suited to key formats and
   conventions of news.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
