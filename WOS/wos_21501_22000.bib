@article{ WOS:001866851400001,
Author = {Garbe, Sebastian},
Title = {Caring with forests: Human and more-than-human care in forest
   occupations in Germany},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Month = {2026 SEP 3},
Abstract = {Drawing on ongoing ethnographic and participatory action research within
   forest occupations in Germany, this paper develops the concept of
   `caring with forests' to theorise the mutual, multidimensional
   relationships of care that emerge between humans and more-than-human
   beings in environmental protest settings. Departing from a personal
   encounter during fieldwork at a forest occupation resisting sand and
   gravel extractivism, the article argues that forest occupations
   constitute sites and conditions that enable ontologically relational,
   non-anthropocentric practices of caring for and with the forest:
   squatters take care of the forest by resisting its destruction, while
   the forest, in turn, sustains its human inhabitants. Theoretically, the
   paper bridges feminist and materialist perspectives on care (Federici,
   Tronto), relational-ontological and posthumanist approaches (Kohn, Puig
   de la Bellacasa, Haraway) and indigenous cosmologies and
   cuerpo-territorio frameworks, extending Tronto's notion of `caring with'
   beyond human relations to more-than-human worlds. Empirically, the study
   draws on eleven interviews with forest squatters and `forest people',
   three interviews with local forest rangers, participatory action
   research with a photographer and filmmakers, informal conversations and
   social media material collected since 2024, analysed through qualitative
   content analysis. The empirical discussion is organised around four
   dimensions: (1) un/caring relations with forests produced by extractive
   industries and failed renaturation; (2) forest occupations as
   care-giving environmental protests; (3) mutual care-giving amongst
   humans in the everyday life of occupations; and (4) mutual,
   ontologically relational care between humans and more-than-humans. These
   findings support two broader contributions: conceptualising forest
   occupations as sites of protest that foster caring relationships with
   their more-than-human surroundings and advancing the search for
   sustainable, ethical ways of relating to more-than-human worlds against
   the disruptions caused by environmental destruction. The paper thereby
   contributes to debates at the intersection of care ethics, social
   movement studies and more-than-human/relational ontologies, situating
   everyday, intimate and often-overlooked caring practices at the heart of
   environmental resistance.Read the free for this article on the Journal
   blog.
   Im Rahmen einer laufenden ethnografischen und partizipativen
   Aktionsforschung in Waldbesetzungen in Deutschland entwickelt dieser
   Beitrag das Konzept des \& bdquo;Sorgens mit dem Wald{''} (caring with
   forests), um die wechselseitigen, mehrdimensionalen Sorgebeziehungen zu
   theoretisieren, die zwischen Menschen und mehr-als-menschlichen Wesen in
   Kontexten von Umweltprotesten entstehen. Ausgehend von einer pers \&
   ouml;nlichen Begegnung w \& auml;hrend der Feldforschung in einer
   Waldbesetzung, die sich gegen Sand- und Kiesextraktivismus richtet,
   argumentiert der Artikel, dass Waldbesetzungen Orte und Bedingungen
   herstellen, die ontologisch-relationale, nicht-anthropozentrische
   Praktiken der Sorge f \& uuml;r und mit dem Wald erm \& ouml;glichen:
   Besetzer{*}innen sorgen f \& uuml;r den Wald, indem sie sich seiner
   Zerst \& ouml;rung widersetzen, w \& auml;hrend der Wald sich wiederum
   um seine menschlichen Bewohner{*}innen k \& uuml;mmert. Theoretisch
   verbindet der Beitrag feministische und materialistische Perspektiven
   auf Sorgearbeit (Federici, Tronto), relational-ontologische und
   posthumanistische Ans \& auml;tze (Kohn, Puig de la Bellacasa, Haraway)
   sowie indigene Kosmologien und cuerpo-territorio Ans \& auml;tze. Dabei
   erweitert er Trontos Begriff des \& bdquo;caring with{''} auf
   mehr-als-menschliche Welten. Empirisch st \& uuml;tzt sich die Studie
   auf elf Interviews mit Waldbesetzer{*}innen und sogenannte \&
   bdquo;Waldmenschen{''}, drei Interviews mit lokalen F \&
   ouml;rster{*}innen, partizipative Aktionsforschung mit Fotografen und
   Filmemachenden, informelle Gespr \& auml;che sowie seit 2024 gesammeltes
   Social-Media-Material, die mittels qualitativer Inhaltsanalyse
   ausgewertet wurden. Die empirische Diskussion gliedert sich entlang von
   vier Dimensionen: (1) (nicht) sorgende Beziehungen zum Wald,
   hervorgebracht durch extraktive Industrien und gescheiterte
   Renaturierung; (2) Waldbesetzungen als sorgender Umweltprotest; (3)
   wechselseitige F \& uuml;rsorge unter Menschen im Alltag der
   Besetzungen; sowie (4) wechselseitige, ontologisch-relationale Sorge
   zwischen Menschen und Mehr-als-Menschlichem. Diese Befunde st \&
   uuml;tzen zwei \& uuml;bergreifende Argumente: die Konzeptualisierung
   von Waldbesetzungen als Orte des Protests, die sorgende Beziehungen zu
   ihrer mehr-als-menschlichen Umgebung f \& ouml;rdern, sowie die
   Weiterentwicklung der Suche nach nachhaltigen, ethischen
   Beziehungsweisen mit mehr-als-menschlichen Welten im Zuge von
   Umweltzerst \& ouml;rung und Klimakrise. Der vorliegende Artikel leistet
   damit einen Beitrag zu Debatten an der Schnittstelle von Care-Ethik,
   Sozialer Bewegungsforschung und mehr-als-menschlichen/relationalen
   Ontologien und r \& uuml;ckt allt \& auml;gliche, intime und h \&
   auml;ufig \& uuml;bersehene Sorgepraktiken ins Zentrum des \&
   ouml;kologischen Widerstands.},
