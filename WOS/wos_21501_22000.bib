@article{ WOS:000576957300002,
Author = {Pyhal, Aili and Eklund, Johanna and McBride, Marissa F. and
   Rakotoarijaona, Mamy A. and Cabeza, Mar},
Title = {Managers' perceptions of protected area outcomes in Madagascar highlight
   the need for species monitoring and knowledge transfer},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2019},
Volume = {1},
Number = {2},
Month = {FEB},
Abstract = {Considerable effort has gone into assessing the effectiveness of
   protected areas (PAs) in preventing biodiversity loss, and PA impacts on
   local communities. However, little is known about how pressures are
   being perceived and dealt with by local PA managers and what perceptions
   managers have of biodiversity trends and human-induced pressures in the
   PAs they manage. We surveyed and convened a workshop with PA managers in
   Madagascar asking about the impacts of PA establishment. The managers
   reported that PAs have been successful in reducing threats. However,
   managers lacked specific knowledge of trends in species abundance,
   reporting the need for more species monitoring and knowledge transfer
   from scientific researchers. We argue that greater collaboration and
   exchange of knowledge between researchers, managers, and local
   communities is necessary to ensure that PA effectiveness research is of
   practical value and contributes to improved PA outcomes.},
