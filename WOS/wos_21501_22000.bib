@article{ WOS:000720842000006,
Author = {Samson, Arockianathan and Ramakrishnan, Balasundaram},
Title = {Conservation of House Sparrow (Passer domesticus): People
   Perception in Upper Nilgiris, Tamil Nadu, India},
Journal = {AMBIENT SCIENCE},
Year = {2020},
Volume = {7},
Number = {2},
Pages = {22-25},
Abstract = {House sparrows Passer domesticus is the commonest and widest distributed
   bird species in nature. It is primarily associated with human habitation
   e.g., agricultural land, village, and urban areas. The study was
   conducted in selected areas of Rural, Suburban, and Urban areas in the
   Nilgiris. Two sets of questionnaires were developed for this study.
   Namely ``Precise and Closed{''} and the other one was ``Broad and
   Open-ended. A total of 452 peoples were interviewed most of the
   respondents were interviewed in the Urban area. a total of 93\% of
   people were knowing about House sparrow. Most of the respondents replied
   that House sparrows are not harming humans and also accepted that House
   sparrows are playing a vital role in pest control in the agricultural
   fields. Peoples opined that House sparrows are Aesthetic values
   according to rituals and were also opined that House sparrows
   populations are decreasing nowadays. Finally, 86\% of respondents were
   opined that House sparrow conservation is needed for the environment and
   interesting to note that respondents were opined that artificial nest
