@article{ WOS:001597733000009,
Author = {Bolanez, Claudia Yesica Fonzo and Herrera, Andrea Geanina Gomez and
   Villalba, Ana Eliza},
Title = {Communal re-existences in response to territorial inequalities in
   Santiago del Estero, Argentina},
Journal = {MUNDO AGRARIO},
Year = {2025},
Volume = {26},
Number = {62},
Month = {AUG-NOV},
Abstract = {This article analyses the communal peasant re-existences in the context
   of agrarian conflicts in Santiago del Estero (Argentina) through a
   comparative study of community livestock enclosures. Employing a
   qualitative approach and techniques such as interviews and participant
   observation, we analize three cases located in the departments of
   Figueroa and Moreno of the province. We focus on their transformative
   nature: emphasizing political subjectivation processes around communal
   land relationships and the reinvention of livelihood strategies through
   practices of labor organization and agroecosystem management. These
   experiences entail a reaffirmation of peasant land rights and
   reciprocity with nature in the face of deepening territorial
   inequalities and the commodification of common goods.},
Publisher = {UNIV NACL LA PLATA, FAC HUMANIDADES \& CIENCIAS EDUCACION},
