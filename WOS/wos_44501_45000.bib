@article{ WOS:000427940500004,
Author = {Hawks, Zoe W. and Strube, Michael J. and Johnson, Neco X. and Grange,
   Dorothy K. and White, Desiree A.},
Title = {Developmental Trajectories of Executive and Verbal Processes in Children
   with Phenylketonuria},
Journal = {DEVELOPMENTAL NEUROPSYCHOLOGY},
Year = {2018},
Volume = {43},
Number = {3},
Pages = {207-218},
Abstract = {Phenylketonuria (PKU) is a hereditary disorder characterized by
   disrupted phenylalanine metabolism and cognitive impairment. However,
   the precise nature and developmental trajectory of this cognitive
   impairment remains unclear. The present study used a verbal fluency task
   to dissociate executive and verbal processes in children with PKU (n=23;
   7-18years) and controls (n=44; 7-19years). Data were collected at three
   longitudinal timepoints over a three-year period, and the contributions
   of age, group, and their interaction to fluency performance were
   evaluated. Results indicated impairments in executive processes in
   children with PKU, which were exacerbated by declining metabolic
   control.},
