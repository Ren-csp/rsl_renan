@article{ WOS:000506470000007,
Author = {Wrenn, Douglas H. and Klaiber, H. Allen and Newburn, David A.},
Title = {Price based policies for managing residential development: Impacts on
   water quality},
Journal = {RESOURCE AND ENERGY ECONOMICS},
Year = {2019},
Volume = {58},
Month = {NOV},
Abstract = {Land plays a critical role in determining the health of an urban
   ecosystem. One of its key roles is regulation of nutrient delivery. In
   this paper, we combine results from an instrumental variable duration
   model with a water quality model in a series of land use simulations to
   examine the impact that several hypothetical land use policies have in
   limiting nutrient delivery in an urban setting. Our results reveal
   tradeoffs between objectives for managing urban growth and those for
   managing water quality. A uniform tax on development reduces developed
   acreage but increases nutrient delivery. An environmental policy
   designed to retain forest cover is the most effective at mitigating
   water quality impacts, albeit with the lowest reduction of acreage
   developed. (C) 2019 Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
