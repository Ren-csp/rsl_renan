@article{ WOS:000803252300001,
Author = {de Barros, Gilmar Manoel and Diehl, Alessandra and de Moura, Adaene
   Alves Machado and Miasso, Adriana Inocenti and Laranjeira, Ronaldo and
   da Silva, Claudio Jeronimo and Pillon, Sandra Cristina and Wagstaff,
   Christopher and de Moraes Horta, Ana Lucia},
Title = {The Perceptions of Domestic Violence by a Family Member Who Uses Crack
   or Cocaine: A Secondary Retrospective Cross-Sectional Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {10},
Month = {MAY},
Abstract = {Objective: To evaluate the relationship between crack/cocaine use and
   domestic violence perpetration from the perspective of substance users'
   families. A secondary retrospective cross-sectional study, with 3162
   family members of crack/cocaine users seeking treatment in the Recomeco
   Familia Programme in Sao Paulo/Brazil was undertaken. Family members of
   crack/cocaine users reported that their relatives were more involved in
   domestic violence such as stealing (money and objects) at home {[}Odds
   Ratio Adjusted ORA = 2.17 (CI 95\% 1.87; 2.53)], the family gave money
   to the user to buy drugs {[}ORA = 1.27 (1.08; 1.48)], and having
   problems with the judiciary {[}ORA = 1.48 (CI 95\% 1.28; 1.71)].
   Relatives of snorted cocaine users reported that there was physical and
   interpersonal violence, such as fathers being assaulted {[}ORA = 2.50
   (CI 95\% 1.08; 5.82)], assaulted someone else {[}ORA = 1.86 (CI 95\%
   1.32; 2.60)], threats of violence fights, arguments when the family talk
   about problematic drug use {[}ORA = 1.50 (CI 95\% 1.13; 1.96)] and
   threatened some family members {[}ORA = 1.52 (CI 95\% 1.14; 2.04)]. In
   this sample, there was a connection between crack/cocaine use and the
   perpetuation of domestic violence, corroborating with important
   implications for public policies, substance use treatment and prevention
   of domestic violence interventions.},
