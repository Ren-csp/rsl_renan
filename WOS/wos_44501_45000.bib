@article{ WOS:001849669600001,
Author = {Freeman, Jodie and Henn, Rosa Emilia and Frahsa, Annika},
Title = {Everyday cues of belonging: How subtle signals in public space shape
   healthy, inclusive neighbourhoods},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {11},
Month = {DEC},
Abstract = {This study examines how everyday interactions in public spaces shape
   belonging, social cohesion, and health equity in Holligen, a culturally
   diverse neighbourhood in Bern, Switzerland. Drawing on focused
   ethnographic observation and brief in-situ interviews, we identify
   subtle indicators of inclusion and exclusion: small visual, behavioural,
   spatial, and affective cues through which residents come to feel
   recognised, entitled to participate, or marginalised. The findings show
   that social cohesion is asymmetrical. While parks, playgrounds, food
   events, and community spaces enabled co-presence and everyday
   cross-cultural recognition, interaction often remained clustered by
   language, generation, and familiarity. Exclusion was produced not only
   through physical barriers, but also through cultural meanings attached
   to place, linguistic norms, and informal gatekeeping within community
   networks. We argue that health equity depends not only on access to
   public space, but also on whether spaces are emotionally legible,
   symbolically welcoming, and socially navigable. Methodologically, the
   study demonstrates the value of ethnography for making visible the
   everyday cues of belonging that are often missed by access-based urban
   health metrics.},
