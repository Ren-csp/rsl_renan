@article{ WOS:001597792200001,
Author = {Li, Xiaojing and Wang, Yaru and Cai, Yinfei and Hu, Haifeng and Xiao, Wu},
Title = {Spatiotemporal heterogeneity of ecosystem services in the context of
   policy intervention in Shanxi Province},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {Despite advances in ecosystem service assessment, the spatiotemporal
   interactions and policy-driven synergies among multiple regional drivers
   remain insufficiently understood. This study examines the dynamics of
   Comprehensive Ecosystem Services (CES) in resource-dependent provinces
   under policy intervention, with Shanxi Province serving as a
   representative case from 2000 to 2023. Time-series clustering is applied
   to identify CES trajectories, while emerging hotspot analysis determines
   the optimal scale of regional spatiotemporal heterogeneity. The combined
   application of GeoDetector (GD) and geographically weighted regression
   (GWR) allows for identification of CES drivers across global and local
   scales. CES-related policies are systematically compiled and, together
   with the spatial evolution of associated drivers, are used to
   qualitatively assess regulatory pathways and the intensity of policy
   impacts on CES. The results reveal that vegetation-based restoration
   strategies are inadequate for addressing ecological complexity in
   resource-dependent regions. Instead, emphasis should shift from
   increasing the Normalized Difference Vegetation Index (NDVI) to
   enhancing ecosystem integrity. Incorporating ecological costs into
   national economic planning is essential to achieving synergistic gains
   in both Gross Domestic Product (GDP) and CES. Strengthened management of
   ecological function zones and fragile areas, along with more effective
   urban green space planning, will be key to fostering sustainable
   coordination between human development and ecological resilience.},
