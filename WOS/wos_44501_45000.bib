@article{ WOS:000458271700021,
Author = {Robert, Samuel and Fox, Dennis and Boulay, Guilhem and Grandclement,
   Antoine and Garrido, Marie and Pasqualini, Vanina and Prevost, Aurelie
   and Schleyer-Lindenmann, Alexandra and Tremelo, Marie-Laure},
Title = {A framework to analyse urban sprawl in the French Mediterranean coastal
   zone},
Journal = {REGIONAL ENVIRONMENTAL CHANGE},
Year = {2019},
Volume = {19},
Number = {2, SI},
Pages = {559-572},
Month = {FEB},
Abstract = {As in many other European countries, urbanisation and urban sprawl along
   the French Mediterranean coast are a major concern. Understanding this
   phenomenon requires both multi-level and multi-disciplinary approaches.
   In this perspective, this article presents a framework for the
   observation and analysis of urban sprawl in the French Mediterranean
   coastal zone. Developed in the context of a scientific coastal
   observatory with four contrasting study sites, the framework was
   designed to structure the observation and analysis of urban sprawl
   dynamics and their driver variables. Although urban expansion is
   currently slowing in coastal zones, local exceptions can be found and
   accounted for by historical urban planning and environmental protection
   measures, local residential tax policies and contradictory perceptions
   of coastal zones by residents. Our multi-disciplinary initiative is
   capable of integrating different temporal and spatial scales and has
   proven relevant in analysing urban sprawl in coastal areas. It shows the
   need to study coastal areas at finer scales to identify specific
   dynamics in their local contexts, since these represent the scale at
   which administrative decisions are made.},
