@article{ WOS:001543553400001,
Author = {Heindel, Ruth and Scott, Sean and Grider, Ansley and Richards, Sadie},
Title = {Land use determines dust geochemistry in central Ohio, US},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2025},
Volume = {360},
Month = {NOV 1},
Abstract = {Anthropogenic dust is often enriched in heavy metals and limiting
   nutrients, exacerbating the consequences of dust deposition and human
   exposure to dust. Dust composition varies depending on the anthropogenic
   source activity, but questions remain about the seasonal and spatial
   variability of anthropogenic dust. At four sites along an urban-rural
   transect in central Ohio, US, we collected weekly dust samples and
   analyzed their geochemical composition and stable Pb isotopes. We
   focused our seasonal analysis on the rural site, and found that dust
   deposited in the summer and fall had the highest concentrations of metal
   pollutants. Our results across the landuse transect indicated a clear
   distinction in the geochemical and isotopic signatures of urban,
   suburban, and rural dust. Urban dust contained more Ca, Mg, Pb, and Sb,
   and had low 208Pb/206Pb and 207Pb/206Pb values, while rural dust
   contained more P, K, Zn, and Sn, and had high 208Pb/206Pb and
   207Pb/206Pb values. Suburban dust had lower concentrations of crustal
   elements compared to dust collected at the urban and rural sites, where
   activities such as construction and agriculture likely enhanced the
   mineral dust fraction. Back-trajectory analyses supported the
   geochemical results, showing that dust sourced from developed land uses
   had an urban geochemical signature. Back-trajectories revealed that
   urban dust was more likely to be deposited at the rural sites when air
   masses traveled across the city. This study demonstrates the tight
   connection between land use and anthropogenic dust composition in a
   region like many around the globe where development is rapidly
   encroaching into farmland.},
