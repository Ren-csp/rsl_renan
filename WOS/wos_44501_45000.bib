@article{ WOS:001764857800001,
Author = {Giatti, Leandro Luiz and Musumeci, Leonardo Rafael and Bizzotto, Luciana
   Maciel and Paredes-Marquez, Yorman and Penteado, Beatriz Damasio and
   Gambhir, Ajay and Hendel-Blackford, Sarah and Kovacic, Zora},
Title = {New crises, new meanings and actions: Linking technical-scientific
   discourse to local knowledge and adaptation in a Brazilian urban
   periphery through participatory research},
Journal = {ENVIRONMENTAL DEVELOPMENT},
Year = {2026},
Volume = {59},
Month = {JUN},
Abstract = {Research on the complexity of multiple and interdependent crises, often
   conducted by external experts, frequently fails to capture a deep
   understanding of local dynamics and capacities. This paper analyses the
   applicability of a systemic risk assessment method grounded in the local
   knowledge and agency of young people from a Brazilian favela. It is
   driven by the goal of generating hybrid discourses and collaborative
   knowledge, as well as identifying the relevance of local actions in
   addressing systemic crises. An innovative systemic risk assessment
   framework was applied through participatory research that focused on the
   intertwined polycrises of climate change, COVID-19 pandemic, and food
   insecurity. We conducted eleven participatory workshops with young
   researchers from the Heliopolis community, Sao Paulo, Brazil, to collect
   narratives and identify adaptive actions with cross-cutting potential
   for addressing the compounding consequences of the focal crises. The
   results demonstrate the importance of reframing technicalscientific
   discourses to align with local views and perceptions of risks and their
   intersections. We identified (i) risks that are often invisible to
   external observers, such as violence and fire hazards, which are
   inherent to local conditions; and (ii) response capacities and local
   resources, such as knowledge production from inside the community, that
   are deeply understood by peripheral residents. When expert frameworks
   support youth participation, systemic risk assessment can become
   socially robust. Thus, the methodological process demonstrates the
   possibility of hybridizing resources and different forms of knowledge,
   highlighting the potential for complementarity and the enhancement of
   local adaptive capacities to face systemic and multiple crises.},
