@article{ WOS:000478863900002,
Author = {Miernyk, Karen M. and Bruden, Dana and Parkinson, Alan J. and Hurlburt,
   Debby and Klejka, Joseph and Berner, James and Stoddard, Robyn A. and
   Handali, Sukwan and Wilkins, Patricia P. and Kersh, Gilbert J. and
