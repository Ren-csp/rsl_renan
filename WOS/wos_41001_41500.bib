@article{ WOS:000866792000001,
Author = {Brata, Anca Monica and Chereji, Aurelia Ioana and Brata, Vlad Dumitru
   and Morna, Anamaria Aurelia and Tirpe, Olivia Paula and Popa, Anca and
   Arion, Felix H. and Banszki, Loredana Ioana and Chereji, Ioan and Popa,
   Dorin and Muresan, Iulia C.},
Title = {Consumers' Perception towards Organic Products before and after the
   COVID-19 Pandemic: A Case Study in Bihor County, Romania},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {19},
Month = {OCT},
Abstract = {Organic products have grown ever more popular in recent years due to
   increased concerns regarding one's health, the environment, and
   sustainability. The COVID-19 pandemic has only accelerated this growth,
   prompting producers to adapt to a rapidly growing market while
   maintaining the same standard of quality. We have conducted a
   questionnaire-based pilot study on 190 organic food consumers from Bihor
   county, Romania, in order to analyze the main factors influencing
   customers' beliefs regarding organic food consumption, as well as assess
   the extent to which their consumption frequency changed after the
   pandemic. A principal component analysis was performed, dividing the
   factors into two categories referring to intrinsic and extrinsic
   characteristics of the products, respectively. It was noticed that the
   most important cues were ranked the same by our 190 respondents,
   regardless of their socio-demographical background. At the same time,
   people who consumed organic products more frequently before the pandemic
   have either maintained or increased their consumption, while more
   indifferent consumers maintained or decreased the proportion of organic
   foods in their diet.},
