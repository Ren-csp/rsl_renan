@article{ WOS:001708759200001,
Author = {Chen, Yuzhu and Gao, Ming and Wang, Jingyu},
Title = {The synergy benefits and drivers of pollution and carbon reductions from
   solid waste resource utilization in China},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2026},
Volume = {402},
Month = {MAR 15},
Abstract = {Solid waste management is a key issue in global efforts to address
   climate change and pollution. China is exploring ways to improve the
   management of various types of solid waste to reduce both pollution and
   carbon. This study aims to develop a method to measure the synergy of
   solid waste utilization and identify its influence factors. A model was
   created to assess the synergy of resource utilization for industrial
   waste, construction waste, and municipal waste. The least absolute
   shrinkage and selection operator (LASSO) model was used to identify key
   factors, and a geographically and temporally weighted regression (GTWR)
   model evaluated how these factors differ over time and space. The
   results show significant benefits in pollution and carbon reduction from
   urban solid waste resource utilization. The average synergy index
   increases from 1.0326 in 2013 to 1.1202 in 2022, showing the
   strengthened COPCR from SWRU. Pronounced spatiotemporal heterogeneity is
   observed, including a northeast-southwest spatial orientation, and an
   expansion of hot-spot areas over time. Key drivers include green
   technology innovation, common prosperity, industrial structure,
   solid-waste governance investment, energy-structure transition, and
   information infrastructure, while their effects vary across regions. The
   impact of industrial structure, information infrastructure, and common
   prosperity are most notable and important for future optimization. This
   study provides data to support policymakers in promoting and optimizing
   ``Zero Waste City{''} initiatives in China.},
