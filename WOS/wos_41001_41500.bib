@article{ WOS:001289136100018,
Author = {Wieme, Rachel and Carpenter-Boggs, Lynne},
Title = {Perceived Benefits and Barriers to Livestock Mortality Composting},
Journal = {JOURNAL OF EXTENSION},
Year = {2023},
Volume = {61},
Number = {4},
Abstract = {We conducted webinars in 2020 about livestock mortality composting
   (LMC). Forty-five attendees completed a survey to evaluate the webinar
   and help define future educational needs. Major barriers to LMC were
   lack of experience, public and neighbor perceptions, and environmental
   management. Most respondents indicated convenience, cost, biosafety, use
   of product, and environmental management as benefits. An unexpected
   emotional theme indicated that LMC also supports the ``circle of
   life{''} and ``respect for the animal.{''} We propose that this theme
   may be a uniting message to improve public and producer perception of
   LMC, increase use of LMC, and improve public-producer relationships
   overall.},
