@article{ WOS:001634248800001,
Author = {Michels, Marius and Musshoff, Oliver},
Title = {Exploring barriers to map-based variable-rate nitrogen fertilization
   adoption: a COM-B framework analysis of German farmers},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2025},
Volume = {7},
Number = {12},
Month = {DEC 1},
Abstract = {Agricultural nitrogen pollution presents a critical environmental
   challenge, with variable-rate nitrogen fertilization (VRNF) technology
   offering potential mitigation. Despite demonstrated benefits, VRNF
   adoption remains low. We applied the Capability, Opportunity,
   Motivation-Behavior (COM-B) framework to identify map-based VRNF
   adoption barriers through a survey of German farmers collected from
   December 2024 to January 2025. Statistical analysis revealed
   statistically significant differences in technology access, technical
   skills, and perceptions of economic profitability between adopter and
   non-adopter groups. Notably, both groups equally recognized map-based
   VRNF's environmental benefits, indicating environmental awareness alone
   fails to drive adoption. By structuring adoption barriers within COM-B,
   our findings suggest that capability-focused education and training,
   opportunity-focused infrastructure and service provision, and
   motivation-focused profitability-based persuasion strategies merit
   investigation as potential pathways for fostering adoption.},
