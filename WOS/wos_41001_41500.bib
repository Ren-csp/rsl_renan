@article{ WOS:001095517800001,
Author = {Kosanic, Aleksandra and Petzold, Jan and Martin-Lopez, Berta},
Title = {Pathways towards sustainable and just futures with and for disabled
   populations: a leverage points perspective},
Journal = {ECOSYSTEMS AND PEOPLE},
Year = {2023},
Volume = {19},
Number = {1},
Month = {DEC 31},
Abstract = {Disabled populations are disproportionally affected by the current
   climate and environmental crises. However, they are hardly included and
   their knowledge is neglected in processes addressing these challenges.
   To achieve the UN Agenda 2030, societies should actively engage with the
   values, experiences and knowledge held by people with disabilities in
   science and policy contexts. In this paper, we suggest that addressing
   `deep' leverage points by 1) recognising diverse valuations of and
   connections to nature by different social groups (i.e. re-connecting to
   nature), 2) including disabled populations in decision-making and
   knowledge creation (i.e. re-structuring institutions), and 3) promoting
   inclusive education and knowledge generation (i.e. re-thinking knowledge
   production) can facilitate the development of inclusive transformation
   pathways and foster sustainable human-nature relationships.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Petzold, J (Corresponding Author), Ludwig Maximilians Univ Munchen, Dept Geog, Munich, Germany.
   Kosanic, Aleksandra, Liverpool John Moores Univ, Sch Biol \& Environm Sci, Liverpool, England.
   Petzold, Jan, Ludwig Maximilians Univ Munchen, Dept Geog, Munich, Germany.
   Martin-Lopez, Berta, Leuphana Univ, Social Ecol Syst Inst, Fac Sustainabil, Luneburg, Germany.},
