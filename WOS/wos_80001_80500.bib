@article{ WOS:000815653400001,
Author = {Arnold, Gwen and Klasic, Meghan and Schomburg, Madline and York, Abigail
   and Baum, Melissa and Cherin, Maia and Cliff, Sydney and Kavousi, Parisa
   and Miller, Alexandria Tillett and Shajari, Diana and Wang, Yuer and
   Zialcita, Luigi},
Title = {Boom, bust, action! How communities can cope with boom-bust cycles in
   unconventional oil and gas development},
Journal = {REVIEW OF POLICY RESEARCH},
Year = {2022},
Volume = {39},
Number = {5},
Pages = {541-569},
Month = {SEP},
Abstract = {Scholarship on boom-busts cycles in resource extraction often assumes
   that affected resource-rich communities are at best reactive, at worst
   helpless, in the face of the large, exogenous shocks this cycle visits
   upon them. Researchers infrequently examine what communities themselves
   can do to improve their economic prospects and residents' quality of
   life amidst booms and busts. In this review paper, we identify and
   synthesize work scattered across disparate academic and gray
   literature-in planning, law, community economic development, rural
   sociology, economics, and political science, among others-to
   holistically assess what we know about how communities can use local
   policymaking to manage impacts of booms and busts associated with
   unconventional oil and gas drilling (UOGD), often called ``fracking.{''}
   We highlight examples of communities tackling this task using vertical
   and horizontal governance strategies and distill expert recommendations
   for how communities can build boom-bust resiliency generally and in key
   areas impacted by UOGD.},
