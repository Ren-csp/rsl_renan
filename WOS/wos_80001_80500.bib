Pages = {25-36},
Month = {NOV 1},
Abstract = {Understanding public attitudes toward China's carbon neutrality goal is
   important to inform policy-making and mobilize climate actions. This
   article investigates public awareness, policy support, and confidence
   regarding the carbon neutrality goal based on a 2022 survey of 4,162
   people across China. We find high awareness, support, and confidence in
   achieving the goal while analyzing differences in responses by gender,
   age, location, education, income, occupation, and health.},
