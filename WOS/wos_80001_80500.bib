@article{ WOS:000419953200024,
Author = {Correia, Elder Silva and Zoboli, Fabio and da Silva, Renato Izidoro},
Title = {``WHAT CAN A BODY DO?{''}: ATHLETES' BECOMING AND THE POTENTIAL OF
   PHENOMENA},
Journal = {MOVIMENTO},
Year = {2017},
Volume = {23},
Number = {4},
Pages = {1459-1470},
Month = {OCT-DEC},
Abstract = {In the sporting context, athletes' bodies are usually associated with
   other types of elements: animals, machine, supernatural phenomena, among
   others. This essay reads those analogies under Deleuze and Guattari's
   understanding of Spinoza's philosophy of affection, more precisely using
   concepts of power, becoming, and affectos. Under these concepts we
   consider that creating heteronyms for athletes expresses three points
   about bodies' composite relation to sport: i) this comparison between
   athletes and other phenomena are not simple associations or metaphors;
   they are becomings; ii) these becomings express new potentials and
   render them perceptible as well as bodies' strange potentials regarding
   sport; iii) paradoxically, besides being a disciplinary and body
   technification device, sports territory also allows amplifying bodies'
   becoming as discoveries of becoming.},
Publisher = {UNIV FED RIO GRANDE DO SUL, ESCOLA EDUC FISICA},
