@article{ WOS:000449665800013,
Author = {Silva dos Santos, Odair Jose and de Moraes Feltes, Heloisa Pedroso},
Title = {Spatiality and metonymic processes in the song ``Querencia amada{''}},
Journal = {GRAGOATA-UFF},
Year = {2018},
Volume = {23},
Number = {46},
Pages = {609-631},
Month = {MAY-AUG},
Abstract = {The gauchesca culture has close links with the geographic formation of
   the State of Rio Grande do Sul (RS) and this is represented, for
   example, in lyrics of Gaucho style of music, when the geotopological
   forms (relief, vegetation and hydrography) are mentioned to refer to
   spatiality. Based on this, this article has the objective of analyzing
   the words that designate spatiality of the letter ``Querencia amada{''},
   an icon of success song in the traditionalism of the state of Rio Grande
   do Sul and that presents as theme the traces of space that can mean
   affection and sense of belonging, emphasizing the role of processes of
   metonymization, based on frames of historical and sociocultural nature,
   in the spatial references to and from Rio Grande do Sul.},
Publisher = {UNIV FEDERAL FLUMINENSE},
Address = {CAMPUS DE PRAIA VERMELHA, AVE MILTON TAVARES SOUZA S-N, RIO DE JANEIRO,
   24210-340, BRAZIL},
Type = {Article},
Language = {Portuguese},
