@article{ WOS:001221962900001,
Author = {Aranda, Gabriela Isabel Perez and Carmona, Sinuhe Estrada},
Title = {Maintenance, Dependency, and Violence in Couples in Southeastern Mexico},
Journal = {LIBERABIT-REVISTA DE PSICOLOGIA},
Year = {2024},
Volume = {30},
Number = {1},
Month = {JAN-JUN},
Abstract = {Background : The relationship offers the possibility of obtaining
   security, affection, attachment and development; however, it can
   sometimes become a source of dissatisfaction and discomfort that affects
   well-being (Urbano et al., 2021). The couple is a space where violence
   is often exercised or received, but it is also a space to reproduce
   relationship maintenance behaviors that tend to be positive for the
