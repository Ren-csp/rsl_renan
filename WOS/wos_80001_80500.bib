@article{ WOS:001821408600001,
Author = {Chen, Jiabin and Ye, Xianbao and Zhou, Qianqian and Xia, Bo and
   Skitmore, Martin and Liu, Yong},
Title = {Measuring public acceptance resilience toward waste-to-energy
   incineration facilities in China: Scale development and validation based
   on the 4R resilience framework},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {572},
Month = {JUL 19},
Abstract = {Cleaner production infrastructures, such as waste-to-energy (WTE)
   incineration facilities, face persistent social sustainability
   challenges arising from volatility in public acceptance, which can
   disrupt construction progress, operational stability, and long-term
   system performance. Research largely treats public acceptance as a
   static attitudinal outcome, providing limited insight into how
   acceptance responds to disturbances and recovers over time. From a
   cleaner production and sustainability governance perspective,
   understanding the resilience of public acceptance is therefore critical
   for maintaining the reliable operation of environmentally beneficial but
   socially contested infrastructure systems. This study introduces the
   concept of public acceptance resilience, defined as the public's
   capacity to maintain or restore acceptance attitudes in the face of
   external disturbances. Drawing on the 4R resilience framework, a
   measurement scale is developed and validated through a four-stage
   empirical design. Study 1 generated an initial item pool through a
   systematic literature review and a modified Delphi process involving
   interdisciplinary experts. Studies 2 (n = 237) and 3 (n = 245) used
   exploratory and confirmatory factor analyses to establish a robust
   12-item scale comprising two dimensions: stability and recoverability.
   Study 4 (n = 231) further confirmed the scale's nomological validity by
   examining its theoretical relationships with perceived risk and public
   trust. The resulting scale provides a reliable and operational tool for
   assessing the social resilience of cleaner production facilities. By
   enabling early detection of vulnerability and recovery capacity in
   public acceptance, the scale supports a shift from reactive conflict
   management to proactive social risk governance, contributing to the
   sustained operation of cleaner production and sustainable infrastructure
   systems.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
