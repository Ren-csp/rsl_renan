@article{ WOS:001142779600001,
Author = {D'Urso, Giulio and Bruffa, Virginia and Fasolo, Mirco and Petruccelli,
   Irene},
Title = {Experiences of children waiting to be adopted: a qualitative study},
Journal = {PSYCHIATRY PSYCHOLOGY AND LAW},
Year = {2025},
Volume = {32},
Number = {1},
Pages = {133-147},
Month = {JAN 2},
Abstract = {This qualitative study explores the emotional and social experiences of
   10 children, aged 6-11, residing in foster care before adoption for
   almost three years. Through semi-structured interviews, the study
   underlined the needs and expectations of these children, highlighting
   the necessity for a deeper reflection on the role of foster homes as
   nurturing and educational communities. The study emphasizes the
   significance of foster homes in meeting children's autonomy and
   affection needs, both crucial for overall development. The study reveals
   that fostering independence and self-determination is essential for
   children's growth, while emotional support and expressions of love
   create a warm and caring environment where children feel secure and
   cherished.},
