@article{ WOS:001476761400001,
Author = {Dauder, Dau Garcia and Gomez, Silvestre Barragan and Martinez, Grecia
   Guzman},
Title = {A Critical Review to Trans Mental Health Approaches},
Journal = {CONVERGENCIA-REVISTA DE CIENCIAS SOCIALES},
Year = {2025},
Volume = {32},
Month = {APR 10},
Abstract = {In this article we present a critical review of the psychological and
   psychiatric perspectives that address trans mental health. We highlight
   how their expansion, in the form of diagnostic and therapeutic culture,
   has impacted everyday language and social movements, sometimes to the
   detriment of political action and reflection. We draw on genealogies of
   feminist, queer, racialized and mad collective resistances to rethink
   the frameworks of meaning and response surrounding distress and madness.
   From this perspective, we propose trans-mad alliances as urgent and
   necessary, viewing them as depathologizing and anti-oppressive
   strategies that can expand these frameworks and translate them into
   social justice, transcending individualization through collectivity. We
   seek to reclaim the communities of affection, care and support that have
   historically characterized the trans collective in the face of various
   forms of violence and exile of cisheterosexist, racist and sanist
   societies.},
