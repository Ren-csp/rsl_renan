@article{ WOS:001710251400001,
Author = {Naseri, Hamed and Laviolette, Jerome and Waygood, E. Owen D. and
   Manaugh, Kevin},
Title = {Unveiling barriers and motivations to cycling across different stages of
   change},
Journal = {TRANSPORTATION RESEARCH PART F-TRAFFIC PSYCHOLOGY AND BEHAVIOUR},
Year = {2026},
Volume = {119},
Month = {APR},
Abstract = {Despite its many benefits, cycling remains a relatively minor mode of
   transport in many North American cities. Hence, it is vital to
   investigate which perceived barriers prevent people from cycling and
   which aspects motivate them to cycle for transport. This study used a
   ``stages of change{''} framework to identify individuals' cycling stages
   of change regarding their cycling behavior and future intention to cycle
   for transport. Then, the barriers and motivators for people at different
   stages were investigated. A survey of 1200 respondents was designed and
   administered in two Canadian cities. An interpretable ensemble learning
   approach, which combines multiple models to improve predictive
   performance, was used for modeling. The results suggest that traffic
   danger and the ease of getting around by other modes are the two main
   perceived barriers to cycling. Improving health and fitness, avoiding
   the hassle of parking cars, and helping to reduce carbon emissions were
   the top motivators for the population interested in cycling. Different
   barriers and motivators have different influences on people based on
   their cycling stage of change. For example, those not considering
   cycling (pre-decisional denial) do not mention traffic danger as a
   problem, but for those who want to cycle but feel that it is impossible
   (predecisional inhibition), traffic danger is the key problem preventing
   them. For the majority of those keen to start cycling (pre-actional), no
   problem is seen as preventing them. The results give nuance to problems
   and what prevents people, along with motivations, at the different
   stages of behavior change towards cycling.},
