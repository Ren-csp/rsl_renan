@article{ WOS:000621404500001,
Author = {Duarte, Luiz Gustavo and Araujo, Flavia Maria and Sakay Bortoletto,
   Maira Sayuri and Melchior, Regina and Gonzalez, Alberto Duran},
Title = {From pregnancy to sterilization: a cartography of an orphan mother
   experienced in a Clinic at the Street},
Journal = {INTERFACE-COMUNICACAO SAUDE EDUCACAO},
Year = {2021},
Volume = {25},
Abstract = {This article aimed to map the affections in scenes that occurred in an
   experience in a Clinic at the Street (CnaR) through the realization of a
   cartography. Mapped territories, with the intercession of Neil Gaiman's
   Sandman used as a cognitive device for the discussion of
   reality-fantasy, have highlighted ways of life that challenge
   traditional methods of care production, while making visible
   micropolitical captures that led to production of control and framing.
   Therefore, it was noticeable in the CnaR a potency of production of new
   ways of care, but at the same time, there are micropolitical captures
   for the control of street dwellers, conspiring aggressively to produce
   needs of sterilization and de-motherhood as well as the kidnapping of
   babies by the State.},
