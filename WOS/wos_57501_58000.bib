@article{ WOS:000594647500001,
Author = {Schneeberger, Eva-Maria and Halper, Matthias and Palasser, Michael and
   Heel, Sarah Viola and Vusurovic, Jovana and Plangger, Raphael and Juen,
   Michael and Kreutz, Christoph and Breuker, Kathrin},
Title = {Native mass spectrometry reveals the initial binding events of HIV-1 rev
   to RRE stem II RNA},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {NOV 13},
Abstract = {Nuclear export complexes composed of rev response element (RRE)
   ribonucleic acid (RNA) and multiple molecules of rev protein are
   promising targets for the development of therapeutic strategies against
   human immunodeficiency virus type 1 (HIV-1), but their assembly remains
   poorly understood. Using native mass spectrometry, we show here that rev
   initially binds to the upper stem of RRE IIB, from where it is relayed
   to binding sites that allow for rev dimerization. The newly discovered
   binding region implies initial rev recognition by nucleotides that are
   not part of the internal loop of RRE stem IIB RNA, which was previously
   identified as the preferred binding region. Our study highlights the
   unique capability of native mass spectrometry to separately study the
   binding interfaces of RNA/protein complexes of different stoichiometry,
   and provides a detailed understanding of the mechanism of RRE/rev
   association with implications for the rational design of potential drugs
   against HIV-1 infection. The HIV-1 RNA-binding protein rev facilitates
   nuclear export of viral RNA. Here, the authors use native mass
   spectrometry to study the interactions between rev-derived peptides and
   rev response elements of HIV-1 RNA, providing mechanistic insights into
   rev recognition and recruitment.},
