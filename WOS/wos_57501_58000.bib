@article{ WOS:001443899000007,
Author = {Gao, Qi and Hofer, Florian W. and Filbeck, Sebastian and Vermeulen, Bram
   J. A. and Wuertz, Martin and Neuner, Annett and Kaplan, Charlotte and
   Zezlina, Maja and Sala, Cornelia and Shin, Hyesu and Gruss, Oliver J.
   and Schiebel, Elmar and Pfeffer, Stefan},
Title = {Structural mechanisms for centrosomal recruitment and organization of
   the microtubule nucleator γ-TuRC},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {MAR 12},
Abstract = {The gamma-tubulin ring complex (gamma-TuRC) acts as a structural
   template for microtubule formation at centrosomes, associating with two
   main compartments: the pericentriolar material and the centriole lumen.
   In the pericentriolar material, the gamma-TuRC is involved in
   microtubule organization, while the function of the centriole lumenal
   pool remains unclear. The conformational landscape of the gamma-TuRC,
   which is crucial for its activity, and its centrosomal anchoring
   mechanisms, which determine gamma-TuRC activity and turnover, are not
   understood. Using cryo-electron tomography, we analyze gamma-TuRCs in
   human cells and purified centrosomes. Pericentriolar gamma-TuRCs
   simultaneously associate with the essential adapter NEDD1 and the
   microcephaly protein CDK5RAP2. NEDD1 forms a tetrameric structure at the
   gamma-TuRC base through interactions with four GCP3/MZT1 modules and
   GCP5/6-specific extensions, while multiple copies of CDK5RAP2 engage the
   gamma-TuRC in two distinct binding patterns to promote gamma-TuRC
   closure and activation. In the centriole lumen, the microtubule
   branching factor Augmin tethers a condensed cluster of gamma-TuRCs to
   the centriole wall with defined directional orientation.
   Centriole-lumenal gamma-TuRC-Augmin is protected from degradation during
   interphase and released in mitosis to aid chromosome alignment. This
   study provides a unique view on gamma-TuRC structure and molecular
   organization at centrosomes and identifies an important cellular
   function of centriole-lumenal gamma-TuRCs.},
