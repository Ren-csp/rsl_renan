@article{ WOS:001046897800001,
Author = {Aysan, Ahmet Faruk and Bakkar, Yassine and Ul-Durar, Shajara and Kayani,
   Umar Nawaz},
Title = {Natural resources governance and conflicts: Retrospective analysis},
Journal = {RESOURCES POLICY},
Year = {2023},
Volume = {85},
Number = {A},
Month = {AUG},
Abstract = {Rapid increases in natural resources globally during the 1970s have had
   far-reaching environmental consequences. The rising exploitation of
   environmental assets has progressively detrimental societal effects.
   Therefore, the current study aims to identify the nexus between natural
   resources and governance conflicts while assessing the role of
   governance in natural resource management. The results identify three
   significant categories of governance challenges (associated with
   capacity, connectivity, and knowledge) and three domains of good
   governance (effectiveness, involvement, and efficiency). The results
   highlighted that developing countries would likely need more
   decision-making power, financial and human resources, leadership on
   crucial resource challenges, and conflict resolution mechanisms. On the
   contrary, research into natural resource management governance
   structures in industrialized countries has often shown problems with
   policy clarity and the alignment of stakeholder institutions' goals and
   aims. The study adds to the existing literature by summarizing new
   organizational capacities and governance frameworks essential for better
   natural resource management.},
