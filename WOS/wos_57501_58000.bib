@article{ WOS:000510382000004,
Author = {Alvaro Machado, Flavia Medeiros},
Title = {Translation and interpretation of Portuguese language for libras:
   autonomy's abstract concepts},
Journal = {LINGUAS \& LETRAS},
Year = {2019},
