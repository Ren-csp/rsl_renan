@article{ WOS:001641320300003,
Author = {Wang, Guosong and Li, Yu and Wu, Chongxin and Chen, Tian and Gui,
   Mengxuan and Zeng, Yue and Sun, Hui and Chen, Kaiyun and Xi, Xiangfeng
   and Yang, Yanbo and Jiang, Yuchen and Jiang, Yanan and Liu, Liqin and
   Yang, Chengyu and Xin, Jiarui and Liu, Caihong and Li, Yiyi and Huo,
   Ningning and Huang, Yang and Lin, Lina and Yu, Hai and Huang, Chenghao
   and Yuan, Quan and Li, Shaowei and Tian, Kegong and Zheng, Qingbing and
   Xia, Ningshao and Chen, Yixin},
Title = {A broadly neutralizing antibody confers cross-genus protection against
   alphaherpesviruses by inhibiting gB-mediated membrane fusion},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {DEC},
Abstract = {The global prevalence and disease burden of alphaherpesviruses
   infections, including human-infecting viruses such as HSV-1, HSV-2, and
   VZV, as well as animal-infecting viruses like PRV, BHV, CHV, and FHV,
   highlight the unmet need for more effective and universal antiviral
   strategies. However, there has been no significant progress in
   developing broad-spectrum interventions against herpesvirus. Here we
   report the identification of a broadly neutralizing antibody against
   alphaherpesviruses, 16F9, which targets the glycoprotein B (gB) of
   alphaherpesviruses and offers cross-protection against multiple viruses
   such as HSV-1, HSV-2, and PRV in mice. 16F9 demonstrated robust
   therapeutic efficacy in various female mouse models of herpesvirus
   diseases including PRV-induced viral encephalitis, HSV-1-induced viral
   encephalitis, viral keratitis, cutaneous herpes, and neonatal
   herpesvirus infections. High-resolution cryo-electron microscopy
   structures revealed that 16F9 binds a conserved site of vulnerability on
   Domain I of gB. The binding of 16F9 disrupts the interaction between
   pre-gB and gHgL complex, thereby preventing viral membrane fusion and
   blocking viral infection. This study provides a foundation for advancing
   antiviral strategies and underscores the potential of gB-targeted
   interventions for combating herpesvirus infections.},
