@article{ WOS:000508811400001,
Author = {Zhao, J. and Yan, Y. and Deng, H. B. and Liu, G. H. and Dai, L. and
   Tang, L. N. and Shi, L. Y. and Shao, G.},
Title = {Remarks about landsenses ecology and ecosystem services},
