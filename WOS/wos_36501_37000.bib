@article{ WOS:000314293300007,
Author = {Waters, Erika A. and Liu, Ying and Schootman, Mario and Jeffe, Donna B.},
Title = {Worry About Cancer Progression and Low Perceived Social Support:
   Implications for Quality of Life Among Early-Stage Breast Cancer
   Patients},
Journal = {ANNALS OF BEHAVIORAL MEDICINE},
Year = {2013},
Volume = {45},
Number = {1},
Pages = {57-68},
Month = {FEB},
Abstract = {Worry about cancer progression and perceived social support can affect
   cancer survivors' quality of life (QOL).
   In 480 early-stage breast cancer survivors, we examined how worry about
   cancer progression and perceived social support 6 months after
   definitive surgery were associated with QOL (RAND 36-item Health Survey)
   at 6-, 12-, and 24-month follow-up.
   At 6 months post-surgery, higher worry was associated with worse QOL for
   five of eight subscales. Lower social support was associated with worse
   QOL for four subscales. The negative effects of worry and limited social
   support dissipated for four subscales (worry) and two subscales (social
   support) by 12-month follow-up and for all subscales by 24-month
   follow-up. Social support at 6 months moderated the relationship between
   T2 worry and T4 emotional well-being; post hoc tests did not clarify the
   nature of the interaction.
   Early-stage breast cancer survivors who worry about cancer progression
   and/or have low social support may experience lower levels of QOL that
   can take several months to resolve.},
