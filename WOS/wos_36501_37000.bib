@article{ WOS:001733319600001,
Author = {Gandidzanwa, C. P. and Togo, M.},
Title = {Determining the environmental impacts of water, energy, and food
   insecurities in Harare: addressing challenges through transitioning to
   renewable energy},
Journal = {FRONTIERS IN SUSTAINABILITY},
Year = {2026},
Volume = {7},
Month = {MAR 23},
Abstract = {Water, energy, and food (WEF) are intricately linked, and so are their
   challenges. Adaptation practices used in response to challenges faced in
   the three resources can damage the environment. Over-exploitation of WEF
   in urban areas can lead to deforestation, depletion of underground
   water, and water/air pollution. The burning of fossil fuels for energy
   can increase greenhouse gas emissions resulting in global warming which
   can lead to drought affecting agricultural production. Renewable energy
   technologies can address some trade-offs in the WEF nexus and create
   synergies for a liveable planet. The study determines the environmental
   impacts of WEF nexus insecurities to propose renewable energy options
   for addressing the nexus challenges. Data was collected from a sample of
   314 urban households in Harare. The researcher employed Structural
   Equation Modeling (SEM) to test the relationship between WEF challenges
   and EFP (ecological footprint) in the context of climate change and
   rapid urban growth in Harare. Findings show that energy has a strong
   influence on the nexus. Energy challenges increase ecological footprints
   due to the environmentally unfriendly adaptation measures used by
   households (path coefficient = 0.353; C.R = 4.994; p < 0.05).
   Policymakers and environmentalists must find solutions that holistically
   address the nexus challenges for sustainability. In addition, it is
   imperative to carefully consider energy and boost investments in
   renewable energy. Transitioning to renewable energy has great potential
   to address WEF nexus challenges.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
