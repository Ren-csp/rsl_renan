@article{ WOS:001876828400001,
Author = {Meiri, Meirav and Cohen, Pnina and Schmidt, Joshua and Gambash, Gil and
   Bar-Oz, Guy and Stavrakaki, Maritina},
Title = {The Genetic Legacy of Cretan Landrace Grapevines and Their Relationship
   to the Southern Levant},
Journal = {PLANTS PEOPLE PLANET},
Year = {2026},
Month = {2026 SEP 16},
Abstract = {Societal Impact Statement Grapes are more than an agricultural crop;
   they are a vital part of human history, economy, and culture. Yet the
   origins of many traditional varieties remain unclear. By studying the
   genetics of Cretan grapes, we discovered that they are a ``genetic
   mosaic{''}-combining local lineages with those from the Southern Levant
   and Eastern Europe. This insight underscores how centuries of human
   travel and trade shaped the realm of viticulture. Understanding this
   historical pathway helps to protect these unique varieties and preserve
   their genetic diversity, contributing to the resilience of vineyards in
   the face of global climate change.Summary Cultivated grapevines (Vitis
   vinifera subsp. vinifera) have a long-standing Mediterranean history
   shaped by millennia of human-mediated diversification. Crete, with
   viticulture roots dating back to the Minoan period, hosts some of the
   world's oldest vineyards and traditional landraces, yet their genomic
   origins remain a subject of debate. We investigated the genetic legacy
   of Cretan landraces by integrating new genomic data from Cretan and
   Israeli cultivars into a global grapevine dataset. Population-level
   analyses (F3 statistics, FST, PCA, and STRUCTURE) were employed to
   evaluate the genetic affinities of the pan-Greek population-with a
   specific focus on Crete-relative to Southern Levantine and Eastern
   European lineages. Results reveal substantial genetic diversity in
   Cretan landraces, consistent with long-term cultivation and selection.
   Cretan grapevine genomic profiles align with the broader pan-Greek
   population, forming an ancestral continuum that connects Eastern
   European lineages with those of the Southern Levant. These shared
   genetic affinities, supported by population-structure analyses, indicate
   that regional exchange, rather than insular isolation, was the primary
   driver of Cretan germplasm development. Notably, shared ancestry between
   Greek and Southern Levantine cultivars is consistent with previous
   archaeological and genomic evidence suggesting historical westward
   movement of grapevine material across the Eastern Mediterranean. Crete
   emerges as a unique genetic reservoir of grapevine genetic diversity and
   a hub for Mediterranean exchange, redefining traditional concepts of
   island insularity. The findings highlight the role of Cretan grapes as a
   biological and cultural crossroads in Mediterranean viticulture.
   Consequently, conserving these traditional landraces is crucial for
   cultural heritage and for ensuring grapevine resilience under climate
   change.},
