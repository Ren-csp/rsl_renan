@article{ WOS:001618225300014,
Author = {Najman, Mercedes and Di Virgilio, Maria Mercedes},
Title = {Territorial Transformations and Settlement Processes in a Former
   Periphery (Villa Lugano, Buenos Aires)},
Journal = {REVISTA INVI},
Year = {2025},
Volume = {40},
Number = {115},
Month = {NOV},
Abstract = {In recent decades, urban studies have focused on the analysis of recent
   peripheries and renewal processes in central areas, relegating the
   analysis of intermediate spaces such as the old peripheries. This
   article analytically recovers this type of spaces through the study of
   Villa Lugano, a pericentral neighborhood of the Autonomous City of
   Buenos Aires (Argentina). By means of a multilevel approach, which
   articulates macro-social factors with the analysis of residential
   trajectories, the paper reconstructs the historical process of
   territorial configuration of this neighborhood, which currently assumes
   features of segregation. The results show that Villa Lugano emerges as a
   late periphery and is integrated into the central urban fabric without
   reversing the structural conditions of exclusion that marked its
   development. The forms of access to the habitat, the typological
   diversity of the residential environments and the perceptions of its
   inhabitants reinforce its characterization as an old periphery
   disconnected from the rest of the city. The study contributes to making
   visible the processes that sustain and reproduce urban inequality in
   pericentral areas.},
