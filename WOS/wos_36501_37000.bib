@article{ WOS:001560809500001,
Author = {Majewski, Lisa and Bittlingmaier, Sarah and Frieser, Anna and Woltering,
   Manuel and Job, Hubert},
Title = {Evaluating the economic impact of tourism in Germany's Biosphere
   Reserves},
Journal = {TOURISM GEOGRAPHIES},
Year = {2025},
Month = {2025 JUL 21},
Abstract = {Biosphere Reserves, as designated by UNESCO, serve as models for
   sustainable development, fostering balanced interactions between humans
   and nature. In this framework, tourism plays a vital role, supporting
   local economies and awareness of sustainable practices, as well as
   conservation, management, and development efforts. However, little is
   known about the overall scope and economic impact of tourism in
   Biosphere Reserves, particularly in industrialized nations. This study
   presents the first comprehensive assessment of tourism and the economic
   impact of visitor spending across Germany's 18 Biosphere Reserves. Key
   parameters include visitor days by overnight guests and day visitors,
   visitors' affinity for the Biosphere Reserves, and the economic impact
   of visitor spending. Germany's Biosphere Reserves recorded 71.6 million
   visitor days, generating <euro>1.97 billion in direct and indirect value
   added through on-site spending. Most German Biosphere Reserves are
   popular day trip destinations, attracting visitors from nearby
   agglomerations. Visitors with a high affinity for the Biosphere Reserve
   accounted for 11\% of visitor days, generating an economic impact of
   <euro>85.63 million in value added. The study highlights the Biosphere
   Reserves' potential in promoting awareness for sustainable conservation
   and development measures. It also proposes a standardized, replicable
   approach for measuring economic impacts of tourism in protected areas
   worldwide, supporting long-term socio-economic monitoring within
   UNESCO's World Network of Biosphere Reserves.},
