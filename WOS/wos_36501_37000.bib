@article{ WOS:001823569000001,
Author = {Qaid, Adeb and Ayek, Almustafa Abd Elkader and Ossen, Dilshan Remaz and
   Alshahrani, Norah and Loho, Mohannad Ali and Barau, Aliyu Salisu},
Title = {An observational assessment of the impact of nature-based solutions on
   spatiotemporal patterns of NO2 pollution in Bahrain (2019-2024)},
Journal = {ENERGY NEXUS},
Year = {2026},
Volume = {23},
Month = {SEP},
Abstract = {This study examines the spatiotemporal dynamics of tropospheric nitrogen
   dioxide (NO2) and vegetation cover in the Kingdom of Bahrain from 2019
   to 2024. It evaluates the environmental effects of the recent policy
   measures promoting nature-based solutions in addressing air quality and
   emission concerns in a rapidly industrializing arid urban setting. Using
   Google Earth Engine and Sentinel-5P (TROPOMI), observations were
   processed into 72 monthly NO2 composites while Landsat-8 imagery was
   classified via NDVI thresholds to quantify annual changes in green
   cover. NO2 remained persistently elevated over the northeastern
   industrial zone and the Sitra Refinery confirming their long-term
   position as emission hotspots. However, the national mean NO2 declined
   markedly from 2022 (1.01 \& times; 10-4mol/m2) to a record low in 2024
   (9.22 \& times; 10-5 mol/m2) at the same time,the national green cover
   expanded by 49.4 \% (from 45.27 km2 in 2019 to 67.62 km2 in 2024),
   driven by a 56.4 \% increase in southeastern coastal vegetation notably
   the mangroves. During 2022-2024, vegetation area and NO2 exhibited a
   consistent inverse trend, with a large effect size but no statistical
   significance (Pearson r =-0.79, p = 0.42), reflecting the limited power
   of a three-point annual sample. Across the full record, no significant
   association emerged (r =-0.05, p = 0.92; n = 6). These findings are
   therefore exploratory; establishing a causal greening-airquality link
   will require higher-temporal-resolution (e.g., monthly) and spatially
   resolved analysis. Nevertheless, this work offers a transferable
   framework for monitoring short time climate and environmental dynamics
   in arid and rapidly developing coastal regions and provides a
   preliminary evidence base for the role of nature-based solutions in
   advancing urban air quality, climate resilience, and guide for net-zero
   commitments including nationally determined contributions.},
