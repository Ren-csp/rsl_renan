   Glasgow Caledonian Univ, Dept Vis Sci, Glasgow G4 0BA, Lanark, Scotland.
   Univ York, Ctr Vis Res, Toronto, ON M3J 1P3, Canada.},
DOI = {10.1016/j.visres.2005.02.009},
ISSN = {0042-6989},
EISSN = {1878-5646},
