@article{ WOS:000246827500010,
Author = {O'Connell, M. J. and Ward, R. M. and Onoufriou, C. and Winfield, I. J.
   and Harris, G. and Jones, R. and Yallop, M. L. and Brown, A. F.},
Title = {Integrating multi-scale data to model the relationship between food
   resources, waterbird distribution and human activities in freshwater
   systems: preliminary findings and potential uses},
Journal = {IBIS},
