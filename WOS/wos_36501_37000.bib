ISSN = {2045-7758},
Keywords = {animal behavior; Asian elephants; ecotourism; ethology; human-wildlife
   interactions; Thailand; wildlife management},
Keywords-Plus = {PHYSIOLOGICAL STRESS-RESPONSE; AFRICAN ELEPHANTS; NATIONAL-PARK;
   MANAGEMENT},
