ISSN = {1537-744X},
Keywords-Plus = {PELEDINA; BRANCHIOBDELLIDANS; HIRUDINEA},
Research-Areas = {Science \& Technology - Other Topics},
Web-of-Science-Categories  = {Multidisciplinary Sciences},
Author-Email = {irina@lin.irk.ru},
Affiliations = {Irkutsk Science Centre of the Russian Academy of Sciences; Limnological
   Institute SB RAS; Russian Academy of Sciences; Limnological Institute SB
