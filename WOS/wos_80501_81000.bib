@article{ WOS:001838968300001,
Author = {Jones, Christopher R. and Gheorghiu, Ana and Smith, Jim T.},
Title = {Small reactors, big reactions: Understanding public attitudes towards
   small modular reactors in the UK},
Journal = {ENERGY POLICY},
Year = {2026},
Volume = {218},
Month = {NOV},
Abstract = {Public acceptance of emerging energy technologies is vital for their
   successful deployment, yet little is currently known about attitudes
   toward Small Modular Reactors (SMRs) in the UK. The current study
   examined public opinion toward SMR deployment both in principle and at a
   local level using a cross-sectional online survey (N = 1006). Baseline
   awareness and self-claimed knowledge of SMRs were both low, but informed
   attitudes toward the technology were generally positive, with a
   preference for development in principle. Participants particularly
   valued SMRs for their advanced safety features and siting flexibility,
   as well as their small physical size, and ability to meet fluctuating
   electricity demand. Regression analyses revealed that general attitudes
   toward nuclear power, perceived benefits, trust in developers, personal
   and social norms and positive affect were positive predictors of support
   for SMRs. Negative affect negatively influenced support, with small
   negative effects of (a) climate concern and right-leaning political
   orientation at the local level; and (b) perceived risks for development
   in principle. The findings underscore the importance of transparent
   communication, trust-building, and meaningful community engagement to
   foster acceptance of SMRs, particularly in prospective host regions.
   Limitations include reliance on an online panel, hypothetical local
   siting scenarios and the promissory framing of SMRs used within the
   study. This suggests the need for future research with weighted
   sampling, real-world engagement contexts and more balanced or critical
   framing of the technology. The insights from this study can be used to
   help inform strategies for the responsible integration of SMRs into the
   UK energy mix.},
