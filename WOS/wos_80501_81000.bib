@article{ WOS:000670914800001,
Author = {Ofili, Elizabeth O. and Sarpong, Daniel and Yanagihara, Richard and
   Tchounwou, Paul B. and Fernandez-Repollet, Emma and Malouhi, Mohamad and
   Idris, Muhammed Y. and Lawson, Kimberly and Spring, Nadine H. and
   Rivers, Brian M.},
Title = {The Research Centers in Minority Institutions (RCMI) Consortium: A
   Blueprint for Inclusive Excellence},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {13},
Month = {JUL},
Abstract = {The Research Centers in Minority Institutions, (RCMI) Program was
   established by Congress to address the health research and training
   needs of minority populations, by preparing future generations of
   scientists at these institutions, with a track record of producing
   minority scholars in medicine, science, and technology. The RCMI
   Consortium consists of the RCMI Specialized Centers and a Coordinating
   Center (CC). The RCMI-CC leverages the scientific expertise,
   technologies, and innovations of RCMI Centers to accelerate the delivery
   of solutions to address health disparities in communities that are most
   impacted. There is increasing recognition that the gap in representation
   of racial/ethnic groups and women is perpetuated by institutional
   cultures lacking inclusion and equity. The objective of this work is to
   provide a framework for inclusive excellence by developing a systematic
   evaluation process with common data elements that can track the
   inter-linked goals of workforce diversity and health equity. At its
   core, the RCMI Program embodies the trinity of diversity, equity, and
   inclusion. We propose a realist evaluation framework and a logic model
   that integrates the institutional context to develop common data metrics
   for inclusive excellence. The RCMI-CC will collaborate with NIH-funded
   institutions and research consortia to disseminate and scale this model.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Ofili, EO (Corresponding Author), Morehouse Sch Med, Community Hlth \& Prevent Med, Atlanta, GA 30310 USA.
   Ofili, Elizabeth O.; Idris, Muhammed Y.; Lawson, Kimberly; Spring, Nadine H.; Rivers, Brian M., Morehouse Sch Med, Community Hlth \& Prevent Med, Atlanta, GA 30310 USA.
   Ofili, Elizabeth O.; Idris, Muhammed Y.; Lawson, Kimberly; Spring, Nadine H.; Rivers, Brian M., Morehouse Sch Med, RCMI Coordinating Ctr, Dept Med, Atlanta, GA 30310 USA.
   Sarpong, Daniel, Xavier Univ Louisiana, Ctr Minor Hlth \& Hlth Dispar Res \& Educ, Coll Pharm, New Orleans, LA 70125 USA.
