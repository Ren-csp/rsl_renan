@article{ WOS:001658715200004,
Author = {Guerra, Joel and Jentho, Elisa and Schauble, Sascha and Scicluna,
   Brendon P. and Vivas, Wolfgang and Martinez-Alarcon, Dania and Groth,
   Marco and King, Emma and Rostel, Franziska and Hirth, Gianna and Soares,
   Miguel P. and Wiech, Thorsten and Panagiotou, Gianni and Bauer, Michael
   and Hoerr, Verena and Weis, Sebastian},
Title = {Control of renal central carbon metabolism by heme oxygenase-1},
Journal = {ISCIENCE},
Year = {2026},
Volume = {29},
Number = {1},
Month = {JAN 16},
Abstract = {Metabolic adaptation is an integral part of the organismal
   stress-response. In this study, we investigate the role of Hmox1 in
   mediating metabolic adaptation under both physiological and hemolytic
   stress conditions. Using an inducible Hmox1 deletion model (Hmox1R26
   Delta/Delta), we demonstrate that Hmox1 expression is essential for
   preventing heme-induced kidney failure. Our integrative approach,
   combining bulk RNA sequencing and targeted metabolomics within silico
   metabolic modeling, revealed a compromised pentose phosphate pathway
   (PPP) in failed renal adaptation after Hmox1 deletion. This study
   underscores the critical role of Hmox1 for PPP regulation and sheds
   light on the metabolic pathways involved in kidney dysfunction due to
   hemolytic diseases.},
