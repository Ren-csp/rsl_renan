@article{ WOS:000291000500031,
Author = {Goto, Shino and Mano, Shoji and Nakamori, Chihiro and Nishimura, Mikio},
Title = {Arabidopsis ABERRANT PEROXISOME MORPHOLOGY9 Is a Peroxin That
   Recruits the PEX1-PEX6 Complex to Peroxisomes},
