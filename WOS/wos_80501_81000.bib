@article{ WOS:001633371500007,
Author = {Silva, Elisabeth Ramos Da and Barros, Juliana Milani},
Title = {Teaching legacies during the pandemic: teachers' perceptions about the
   losses and gains of that time},
Journal = {DIALOGIA},
Year = {2025},
Number = {55},
Month = {SEP-DEC},
Abstract = {This research is about teachers' perception regarding the online classes
   during COVID 19 pandemic. The compulsory and sudden use of equipment in
   online classes brought discomfort, but it may also have brought benefits
   for the teachers' practice A survey with twenty-two teachers from public
   and private schools was conducted. The goal was to investigate their
   perception about their practice during the pandemic, taking into account
   the inseparability between affection and cognition. This research is
   mainly anchored in the socio-historical approach by Vigotski.
   Methodologically, teachers were asked to answer three open questions.
   Their responses were analyzed in the light of Bardin's Content Analysis.
   It was concluded that, according to teachers' perception, the pandemic
   sparked learning, especially regarding digital technologies, but the
   interaction between teacher and student, central to teachers'
   well-being, was harmed. Such experiences changed teachers' view of the
   world, both in the professional scope and in the subjective one.},
