@article{ WOS:000316770000027,
Author = {Larranaga, Elisa and Yubero, Santiago and Ovejero, Anastasio and
   Navarro, Raul},
Title = {Validation of the Spanish version Gender Role Conflict Scale for
   Adolescents (GRCS-A)},
Journal = {ANALES DE PSICOLOGIA},
Year = {2013},
Volume = {29},
Number = {2},
Pages = {549-557},
Month = {MAY},
Abstract = {Gender role conflict scale for adolescents (GRCS-A) measures the gender
   role conflict experienced by adolescents. GRCS-A consists of four
   patterns, namely Restricted affection between men, Restricted
   emotionality, Conflict between work, school, and family, and Need for
   success and achievement. The objective of this study was to analyze the
   factorial structure of the Spanish version of GRCS-A and the factorial
   congruence with the original version using a sample of 1595 male
   adolescents from Castilla-La Mancha and Castilla y Leon (Spain).
   Correlations between GRCS-A and sexism and bullying were examined. Age
   differences in the experimentation of gender role conflict patterns were
   also analyzed. Exploratory and confirmatory factorial analysis
   replicated the original factorial structure and correlation analysis
   showed that Gender role conflict is related to sexism and bullying.
   Regression analysis showed a significant effect of age over the gender
   role conflict.},
