@article{ WOS:000582063200001,
Author = {Braga, Ana Carolina and Resende, Luis Mauricio M. and Pontes, Joseane},
Title = {Proposal of a theoretical model to identify organizational decline},
Journal = {ANAIS DA ACADEMIA BRASILEIRA DE CIENCIAS},
Year = {2020},
Volume = {92},
Number = {3},
Abstract = {This study aimed to propose a conceptual model of Identification of
   Organizational Decline, based on two indicators: Organizational
   Satisfaction Indicator and Financial Indicator For the study, we used
   two bibliometric reviews, which, ultimately, associated the variables of
   the foundations of excellence in quality with organizational decline. As
   a result, we observed that the topic of organizational decline in
   companies has factors of managerial, physical, financial, and behavioral
   nature, and that their performances worsen by their lack of initiative
   in using the three planning processes (strategic planning, budget, and
   control) in a structured way. Regarding companies that seek excellence
   in quality, these concerns become increasing demands for their managers,
   who must develop responsible practices and tools to achieve a good
   performance, bearing in mind the constant search for satisfaction and
   retention of customers not only for the final product, but throughout
   the chain process. Thus, the literature on this topic is vast, and this
   study is justified because it notes a strong relationship between the
   lack of factors of excellence in management and organizational decline.},
Publisher = {ACAD BRASILEIRA DE CIENCIAS},
