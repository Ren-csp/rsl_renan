@article{ WOS:001747969100001,
Author = {Kurylo, Anastacia and Robles, Jessica},
Title = {What do they do? Functions served by stereotypes communicated in
   conversation},
Journal = {ATLANTIC JOURNAL OF COMMUNICATION},
Year = {2026},
Month = {2026 APR 26},
Abstract = {Although stereotypes are stigmatized, people still use them. Research
   has typically been concerned with cognitive explanations, focusing less
   on why people communicate stereotypes despite the stigma. This project
   presents two studies examining stereotypes functions: (1) first-hand
   accounts of communicated stereotypes were analyzed for reported reasons
   why people communicate stereotypes, and results demonstrate that
   stereotypes function similarly to other forms of communication for
   affection (altruism), control, escape, inclusion, pleasure, and
   relaxation, as well as for efficiency, impression management, and
   reducing uncertainty; (2) a discourse analytic approach interrogated how
   these functions might be visible in language in naturally-occurring
   conversations where stereotypes arise spontaneously, and the analysis
   shows that self-report derived taxonomies resonate with analyses of
   conversation. Results suggest that self-reported accounts are productive
   for understanding stereotypes (study 1) and that there is value in
   testing an account taxonomy on naturally occurring interactions (study
   2).},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
