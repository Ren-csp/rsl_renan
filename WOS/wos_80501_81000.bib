@article{ WOS:001790624200001,
Author = {Raper, Carson and Joshi, Omkar and Zou, Chris B. and Ripberger, Joseph},
Title = {Perceived Risks of Eastern Red Cedar Encroachment Among Rural and
   Nonrural Residents in Oklahoma},
Journal = {RANGELAND ECOLOGY \& MANAGEMENT},
Year = {2026},
Volume = {107},
Pages = {54-60},
Month = {JUL},
Abstract = {The encroachment of eastern red cedar (Juniperus virginiana) in the
   Great Plains of North America has profoundly impacted the prairies and
   increased fire risks at the urban-wildland interface. Many of the risks
   stem directly from fire exclusion, which is one of the most prevalent
   enablers of red cedar invasion. With the species' rapid spread into
   suburban areas, active management is essential to prevent further damage
   from fire. A survey was conducted from November 2021 to January 2022 to
   assess knowledge of red cedar encroachment and perceived risks among 6
   238 nonrural and rural residents in Oklahoma, USA. Data were analyzed
   using binary logistic and ordinal logistic regression models. The
   findings indicated that individuals with knowledge of red cedar
   encroachment, elderly residents, and those experiencing prolonged
   drought periods were likely to have a greater perceived risk of red
   cedar encroachment. In general, respondents in rural areas were more
   knowledgeable about red cedar encroachment than those in urban or
   suburban areas. The study results highlight the need for outreach to
   educate urban, suburban, and younger populations about the potential
   negative impacts of red cedar encroachment. (c) 2026 The Author(s).
