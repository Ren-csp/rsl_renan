@article{ WOS:001811461300001,
Author = {Tao, Suyong and Huang, Yue},
Title = {Haste makes waste: can urban agglomeration enlargement promote green
   innovation and carbon reduction in underdeveloped regions? Evidence from
   Beibu Gulf Urban Agglomeration in China},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2026},
Volume = {14},
Month = {JUN 22},
Abstract = {Under the dialectical unity of productive forces development and
   ecological civilization, underdeveloped regions must navigate the twin
   pressures of economic catch-up and environmental degradation. Therefore,
   how to promote green innovation and carbon reduction emerges as a
   critical issue for achieving global sustainable development goals.
   Taking the Beibu Gulf Urban Agglomeration (BGUA) in the underdeveloped
   western region of China as an example, this study employs the spatial
   econometric, difference-in-differences model, and mediation model to
   examine the impact of urban agglomeration (UA) enlargement on green
   innovation and its subsequent influence on carbon emissions. Results
   show that while BGUA initially fosters regional green innovation through
   growth effect and spatial spillover effects, this driving force
   diminishes after the enlargement, primarily because UA enlargement fails
   to improve green innovation in the original cities. The polarization
   effect of newly expanded cities further weakens the spatial spillover of
   green innovation. Mechanism analysis reveals that UA enlargement
   influences green innovation through industrial structure upgrading,
   factor allocation, and government behavior, with heterogeneous changes
   after enlargement. More importantly, extended analysis shows that green
   innovation significantly reduces carbon emission intensity, but this
   carbon reduction effect weakens considerably after enlargement. This
   decline is attributable to deteriorated factor allocation in original
   cities, which increases carbon emissions. The findings suggest a
   cautiously optimistic view towards UA enlargement in underdeveloped
   areas and suggest that policymakers should integrate carbon reduction
   targets into urban planning to enhance low-carbon transition.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Huang, Y (Corresponding Author), Guangxi Univ Finance \& Econ, Sch Econ, Nanning, Peoples R China.
   Tao, Suyong, Guangxi Univ, Sch Marxism, Nanning, Peoples R China.
   Huang, Yue, Guangxi Univ Finance \& Econ, Sch Econ, Nanning, Peoples R China.},
DOI = {10.3389/fenvs.2026.1826492},
