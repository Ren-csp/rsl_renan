Author = {Wolf, Kathleen L. and Senturia, Kirsten and Simmons, Cary and Hafferty,
   Kiana and Faino, Anna V. and Garrett, Kimberly A. and Tandon, Pooja S.},
Title = {Participatory Design for Community Schoolyards: Mixed Methods Reveal
   Positive Engagement Despite Measures Limitations},
Journal = {ECOPSYCHOLOGY},
Year = {2024},
