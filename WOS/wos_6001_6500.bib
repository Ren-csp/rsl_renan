@article{ WOS:001816928600009,
Author = {Caballero-Arias, Hortensia and Rios, Meredith Castro and Fernandez,
   Rodolfo Rojas},
Title = {Seeking Socio-Environmental Justice: Indigenous Perceptions of Oil
   Extraction and Environmental Remediation in the Northern Peruvian Amazon},
Journal = {PERFILES LATINOAMERICANOS},
Year = {2026},
Volume = {34},
Number = {68},
Pages = {209-233},
Abstract = {This article analyzes the effects of hydrocarbon exploitation in
   socio-ecological landscapes of the northern Peruvian Amazon, as well as
   the socio-environmental conflicts between indigenous federations,
   corporations, and the State institutions in the former Block1AB (Loreto,
   Peru). Using a mixed-methods approach that integrates quantitative and
   qualitative data, the study examines the perceptions of Quechua, Achuar,
   and Kichwa indigenous communities regarding their experiences, dilemmas,
   and environmental afflictions in relation to oil pollution,
   environmental degradation, indigenous life perspectives, and the
   restoration of their territories. The findings suggest that the
   expressions of endogenous assessments by the affected native communities
   and their expectations for systemic environmental remediation constitute
   key benchmarks within the framework of their current demands for
   socio-environmental justice, transcending the traditional technical
   vision of territorial restoration.},
