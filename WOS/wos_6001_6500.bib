@article{ WOS:001877052400001,
Author = {Han, Zhiting and Wang, Zhao and Sun, Jisi and Zhen, Jianing and Mao,
   Dehua},
Title = {Effects of urban green-space landscape patterns on cooling services
   across four Chinese case cities},
Journal = {URBAN CLIMATE},
Year = {2026},
Volume = {70},
Month = {DEC},
Abstract = {Urban green spaces (UGS) are critical for mitigating heat islands, and
   their cooling performance varies across climatic conditions and spatial
   contexts. However, how UGS landscape patterns shape different components
   of cooling services remains insufficiently understood. Here, we
   developed a multidimensional assessment framework integrating cooling
   efficiency (CE), cooling capacity (CC) and cooling benefit (CB) and
   applied it to four Chinese case cities along a temperate-to-tropical
   climatic gradient: Changchun, Beijing, Hangzhou, and Haikou. Using
   multi-source earth observation data and an interpretable XGBoost-SHAP
   framework, we examined associations between landscape configuration,
   environmental covariates, and the three cooling-service indicators.
   Across 100 repeated random 80:20 train-test splits, CC models showed the
   strongest predictive performance (mean R2 = 0.590-0.834), whereas CB
   models were weaker and more variable (mean R2 = 0.332-0.440). CE
   exhibited a clear latitudinal gradient, whereas CC varied substantially
   among cities, from 0.8 to 4.1 degrees C in Changchun to 2.2-9.2 degrees
   C in Beijing. Landscape configuration effects were nonlinear and
   indicator-dependent. Lower edge contrast (ECON) was generally associated
   with stronger city-scale cooling capacity, while localized high-ECON
   patches showed exploratory associations with higher population-weighted
   cooling benefit in densely populated areas. These findings show that
   citywide cooling capacity and population-weighted cooling benefit may
   require different, context-sensitive landscape strategies.},
