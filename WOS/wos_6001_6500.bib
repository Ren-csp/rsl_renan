@article{ WOS:001547951600001,
Author = {Leon-Corwin, Maggie and Ritchie, Liesel A. and Long, Michael A.},
Title = {Fractured views: Environmental risk perceptions in Oklahoma and
   Colorado's oil and gas landscapes},
Journal = {EXTRACTIVE INDUSTRIES AND SOCIETY},
Year = {2025},
Volume = {24},
Month = {DEC},
Abstract = {Oil and gas development is a signficant economic force in Colorado and
   Oklahoma, two adjacent states in the United States that have
   historically been among North America's top five crude oil producers.
   Similar in many ways, including their experiences with oil and gas
   industry activity and related hazard such as seismicity, fracturing
   fluid spills and leaks, and landscape degradation, Colorado and Oklahoma
   diverge in their public and policy responses to hydraulic fracturing. We
   use Freudenburg's recreancy as a conceptual framework to elucidate how
   the failure of institutions to fulfill their responsibilities may erode
   trust in the context of unconventional oil and gas development. To
   identify key factors that shape environmental risk perceptions of
   unconventional oil and gas development, we conducted structural equation
   modeling based on a 2018 household telephone survey (n=1200) of
   communities in both states. Results indicate that demographic factors
   such as gender and race/ ethnicity as well as perceptions of recreancy,
   opinion of fracking risks, and spatial distance from oil and gas
   development directly affect perceptions of environmental risk related to
   unconventional oil and gas development. In contrast, political ideology,
   economic resource loss, and views of fracking benefits are indirectly
   associated with perceptions of environmental risk.},
