@article{ WOS:001712192400001,
Author = {Maniraho, Albert Poponi and Li, Lanhai and Bai, Jie and Christophe,
   Mupenzi and Habimana, Fabien and Kayiranga, Alphonse and Muhirwa, Fabien
   and Fabiola, Bakayisire},
Title = {Spatio-temporal analysis and Farmer's perception and adaptation
   practices to cope with agricultural drought in Eastern Province, Rwanda},
Journal = {PROGRESS IN DISASTER SCIENCE},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {This study examines the spatio-temporal patterns of agricultural drought
   and farmers' perceptions in the Eastern Province of Rwanda from 2001 to
   2020, using the Vegetation Health Index (VHI) derived from remote
   sensing data alongside surveys of 350 farmers to explore perceptions of
   climate change and adaptation strategies. VHI analysis reveals
   significant inter-annual variability, with major drought events
   occurring in 2003-2006 and 2015-2017, and healthier vegetation during
   2001-2002, 2007-2008, and 2012-2014. Peak drought years (2004, 2009,
   2016, and 2019) affected more than 10\% of the region. Survey results
   indicate a predominantly male farming population (80.86\%), with most
   respondents having primary or secondary education. A substantial
   majority (67.71\%) acknowledged climate change, reporting decreased and
   shifted rainfall patterns, and identifying drought as the principal
   threat to crop yields and livestock. Farmers employ a suite of
   drought-mitigation strategies, with water harvesting, crop
   diversification, and the use of drought-resistant varieties contributing
   to resilience. Adoption of irrigation, zero grazing, and early warning
   systems varies across districts; predominantly manual irrigation methods
   (82.29\%) are common, and limited access to advanced technologies is
   driven by financial constraints and knowledge gaps. While numerous
   mitigation measures were provided by the government, farmers expressed
   low satisfaction. The findings underscore the need for enhanced
   financial support, improved infrastructure, tailored district-level
   assistance, expanded access to resources, and strengthened information
   sharing to build drought resilience and promote sustainable agriculture.},
