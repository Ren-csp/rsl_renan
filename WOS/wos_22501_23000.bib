@article{ WOS:000906603700020,
Author = {Esteban Tulande-M and Juliana Duran-Prieto},
Title = {First records of Callaspidia defonscolombei Dahlbom, 1842
   (Hymenoptera, Cynipioidea, Figitidae) in an urban environment in
   Colombia},
Journal = {CHECK LIST},
Year = {2021},
Volume = {17},
Number = {1},
Pages = {167-169},
Abstract = {Callaspidia defonscolombei Dahlbom, 1842, is a figitid wasp with a
   widespread distribution. In South America, it has been reported from
   Argentina, Brazil, and Chile. Here we report the first record of this
   species in Colombia, where it was associated with two species of trees
   in urban parks of Bogota. We also report the presence of unknown pollen
   in the examined individuals. Future studies need to be conducted to
   identify the local impact of this species as a possible parasitoid
   and/or pollinator in the green spaces of the city of Bogota.},
