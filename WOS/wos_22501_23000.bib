@article{ WOS:001629754200020,
Author = {Ji, Junjie and Huang, Zhenlong and Xie, Hongwei and Wang, Yizhuo and
   Chen, Tao and Yang, Longpeng and Jiang, Yan and Liu, Jing and Cheng,
   Dong and Wu, Tailong and Pan, Taisong and Gao, Min and Jiang, Binbin and
   Lin, Yuan},
Title = {Stretchable multimodal sensor arrays for hardness perception in bionic
   skin},
Journal = {NANO RESEARCH},
Year = {2025},
Volume = {18},
Number = {12},
Month = {DEC},
Abstract = {The development of robotic bionic skin plays a crucial role in enhancing
   robots' environmental sensing and interaction capabilities, relying
   heavily on stretchable multimodal tactile sensors. However, current
   tactile sensors suffer from significant limitations in integration
   density and spatial resolution, making them unsuitable for complex
   applications. To address these challenges, this study proposes a
   multimodal tactile sensing method based on the co-integration of
   pressure and strain sensors. By innovatively embedding strain sensors
   into the gaps of pressure sensor arrays, both sensor types are
   positioned within the same plane, enabling simultaneous high-resolution
   measurements of pressure and strain. Furthermore, when combined with
   pressure-strain bimodal sensing data, this system allows for accurate
   assessment of object hardness. The bionic skin fabricated using this
   method demonstrates an average pressure sensitivity of 0.008891 kPa-1
   within the range of 1 to 70 kPa, a high sensitivity of around 15.2 for
   strains up to 70\% and enables the accurate prediction of object
   hardness within a Young's modulus range of around 0.0725 to 1.27821 MPa.
   Additionally, a high-density sensor array consisting of 100 pressure
   units and 18 strain units has been successfully developed. When coupled
