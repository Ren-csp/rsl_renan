@article{ WOS:000662193300009,
Author = {Langergraber, Guenter and Pucher, Bernhard and Simperler, Lena and
   Kisser, Johannes and Katsou, Evina and Buehler, Devi and Garcia Mateo,
   Mari Carmen and Atanasova, Natasa},
Title = {Implementing nature-based solutions for creating a resourceful circular
   city},
