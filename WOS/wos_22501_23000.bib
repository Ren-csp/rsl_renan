@article{ WOS:001417428500001,
Author = {Alcott, Lewis J. and Maavara, Taylor},
Title = {GC Insights: The Anthro-Pokécene - environmental impacts echoed
   in the Pokémon world},
Journal = {GEOSCIENCE COMMUNICATION},
Year = {2025},
Volume = {8},
Number = {1},
Pages = {47-50},
Month = {FEB 11},
Abstract = {Public perception of anthropogenic environmental impacts, including
   climate change, is primarily driven by exposure to different forms of
   media. Here, we show how Pok \& eacute;mon, the largest multimedia
   franchise worldwide, mirrors public discourse in the video games'
   narratives with regard to human impacts on environmental change. Pok \&
   eacute;mon demonstrates a trajectory towards greater acknowledgement of
   climate change and anthropogenic impacts in each released game and
   presents a hopeful vision for how society can adapt.},
