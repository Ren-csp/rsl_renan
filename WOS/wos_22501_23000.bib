@article{ WOS:000483690300017,
Author = {van Riper, Carena and Winkler-Schor, Sophia and Foelske, Lorraine and
   Keller, Rose and Braito, Michael and Raymond, Christopher and Eriksson,
   Max and Golebie, Elizabeth and Johnson, Dana},
Title = {Integrating multi-level values and pro-environmental behavior in a US
   protected area},
Journal = {SUSTAINABILITY SCIENCE},
Year = {2019},
Volume = {14},
Number = {5, SI},
Pages = {1395-1408},
Month = {SEP},
Abstract = {Human behavior is influenced by an array of psychological processes such
   as environmental values. Despite the importance of understanding the
   reasons why people engage in activities that minimize environmental
   degradation, empirical research rarely integrates different types of
   values simultaneously to provide more complete and multi-faceted
   insights on how values contribute to environmental sustainability.
   Drawing from on-site survey data collected in Denali National Park and
   Preserve, Alaska (n = 641), we used two-step structural equation
   modeling to test how variation in behavioral patterns was explained by
   the cultural, individual, and social values of visitors to a national
   park. We fused various disciplinary perspectives on the value concept to
   demonstrate how individual- and group-level dynamics were integral for
   predicting behavior and better understanding aggregated preferences for
   environmental conditions in the context of a U.S. protected area.},
