@article{ WOS:001648081600001,
Author = {Tyutwana, Asemahle and Mpetile, Ziyanda and Ikusika, Olusegun Oyebade
   and Akinmoladun, Oluwakamisi Festus},
Title = {Farmer and Farm-Level Predictors of Pain Perception and Management
   During Routine Pig Husbandry Practices in Eastern Cape, South Africa},
Journal = {ANIMALS},
Year = {2025},
Volume = {15},
Number = {24},
Month = {DEC 5},
Abstract = {Effective pain management during routine husbandry procedures is a
   critical component of animal welfare but remains under-implemented in
   many resource-limited farming systems. This study examined farmer- and
   farm-level predictors of pain perception and management in pig
   production systems in the Eastern Cape Province, South Africa. A
   cross-sectional survey was conducted among 216 respondents from
   purposively selected commercial and smallholder pig farms. Data were
   collected using a pre-tested, structured questionnaire administered
   through face-to-face and self-administered formats, covering
   socio-demographic profiles, routine husbandry procedures, pain
   perception scores (0-10 scale), welfare awareness, and analgesic use.
   Descriptive statistics summarised farmer characteristics and pain
   management perceptions. Associations between categorical variables were
   assessed using Chi-square tests, while Mann-Whitney U and Kruskal-Wallis
   H tests compared pain scores across demographic groups. Spearman's
   correlation explored relationships between pain scores and knowledge,
   attitudes, and behavioural observation ability. Ordinal logistic
   regression identified predictors of self-rated pain assessment ability
   and pain scores for specific procedures, while binary logistic
   regression determined predictors of analgesic use. Results showed that
   education level, years of farming experience, and age significantly (p <
   0.05) influenced knowledge, welfare awareness, and ability to assess
   pain. Painful procedures such as castration, tail docking, and teeth
   clipping were strongly associated (p < 0.05) with analgesic use,
   particularly when performed by trained personnel. Larger piggery size (p
   = 0.014) and younger farmer age (34-41 years) (p = 0.025) predicted
   higher self-rated pain assessment ability. However, knowledge of pain
   control was inversely associated with pain ratings for vaccination (r =
   -0.347; p = 0.000) and teeth clipping (r = 0.328, p = 0.000). The
   findings highlight gaps in welfare-related decision-making and recommend
   targeted training, improved access to veterinary services, and
   standardised welfare protocols to enhance pain management in pig
   production.},
