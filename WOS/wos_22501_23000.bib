@article{ WOS:001655100500001,
Author = {Balerna, Jessica A. and Fisher, Brendan and Wemple, Beverley C. and
   Myers, Molly and Soares, Rodrigo and Quainoo, Ruth and Khan, Masood Ali
   and Merrill, Scott C. and Shrum, Trisha R.},
Title = {Survey-based study of public perceptions and preferences for mitigating
   flood risk via nature-based solutions in the United States},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {2},
Pages = {359-377},
Month = {FEB},
Abstract = {Nature-based solutions (NbS), such as reconnecting floodplains and
   restoring riparian wetlands, can reduce flood risk as well as provide
   benefits like carbon storage, habitat support, and recreation. However,
   wetlands and floodplains are increasingly replaced with urban
   development and flooding is primarily addressed with grey infrastructure
   solutions like dams and levees. We hypothesize that one barrier to
   implementation of NbS is the perception that they are not effective at
   reducing flood risk. We conducted a nationally representative survey of
   925 people across the United States to identify the public's preferences
   and beliefs about certain NbS, including riparian buffer, wetland, and
   floodplain restoration. Responses to the survey were used to determine
   public preferences and beliefs regarding NbS as well as which
   populations prefer the implementation of NbS over grey infrastructure
   solutions to mitigate flood risk. We found that over 40\% of
   participants stated that wetlands and riparian buffers increase flood
   risk, have no effect on flood risk, or are unsure of how they affect
   flood risk. Those same participants also preferred investment of public
   funds into grey infrastructure over NbS. Together, these results align
   with our research hypothesis and indicate that altering the perception
   that NbS are ineffective at reducing flood risk can lead to more public
   support for NbS implementation. Participants who knew that they lived in
   a FEMA-designated flood zone and participants who were knowledgeable
   about the definitions of common flood terms were more likely to state
   that wetlands and riparian buffers reduce flood risk, which indicates
   that knowledge of flood risks and warnings creates a pathway for shaping
   perceptions about NbS. Participants who self-identified as `liberal'
   were also more likely to state that NbS reduce flood risk as well as
   prefer investment into NbS over grey infrastructure solutions.
   Addressing the increasing risk of flooding across the United States
   requires a diverse portfolio of flood mitigation solutions, including
   NbS. We help elucidate some of the social and political barriers
   influencing public support for NbS as well as recommend inclusive and
   sustained community engagement in the planning and implementation of NbS
   to help address these barriers.Read the free for this article on the
   Journal blog.},
