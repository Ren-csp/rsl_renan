@article{ WOS:001691463500001,
Author = {Habte, Biruk Yeshaw and Girma, Zerihun and Yirsaw, Eshetu},
Title = {Impact of human-induced disturbances on population abundance of large
   herbivores in Mago National Park, Southern Ethiopia},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2026},
Volume = {66},
Month = {APR},
Abstract = {Large herbivores in various environments, including protected areas,
   face severe threats from human activities. These activities include tree
   cutting, human settlement patterns, and use of fire. Such disturbances
   can alter habitat structures and increase mortality risks for large
   herbivores. Large herbivores are considered highly susceptible to use of
   fire based on their dependence on specific habitats for food resource
   and shelter. Understanding these effects is crucial for developing
   effective conservation strategies. This study analyzed the effect of
   these disturbances on large herbivore abundance in Mago National Park
   using line transect and plot surveys. Two-Way ANOVA and linear
   regression analyses were employed to examine the relationships between
   disturbance levels and herbivore abundance. Our result showed that tree
   cutting was the predominant human activity in the park. The highest
   counts and abundance of herbivore species were observed in undisturbed
   areas, while the lowest were recorded in highly disturbed regions across
   all habitat types during both dry and wet seasons. We found significant
   negative associations between tree cutting, human settlement, and burned
   area with herbivore abundance. These findings highlight the complex
   relationship between human-induced disturbances and herbivore
   distribution patterns. The findings have made it clear that there is a
   great need to have effective zoning legislation put into practice and a
   comprehensive conservation strategy implemented with a focus on
   sustainable utilization. This will be an effective means of combating
   deforestation and protecting herbivorous biodiversity pockets outside
   the boundaries of Mago National Park. Moreover, it will improve living
   standards of local inhabitants by promoting sustainable resource
   utilization.},
