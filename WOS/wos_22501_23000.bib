@article{ WOS:000860378000006,
Author = {Rai, Prabhat Kumar and Vanlalruati},
Title = {Societal perception on environmental and socio-economic implications of
   Tithonia diversifolia (Hemsl.) A. Gray invasion in an Indo-Burma
   biodiversity hotspot},
Journal = {ENVIRONMENTAL \& SOCIO-ECONOMIC STUDIES},
