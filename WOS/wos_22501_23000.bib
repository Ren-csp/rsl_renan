@article{ WOS:000209844100015,
Author = {Mainland, Joel D. and Li, Yun R. and Zhou, Ting and Liu, Wen Ling L. and
   Matsunami, Hiroaki},
Title = {Human olfactory receptor responses to odorants},
Journal = {SCIENTIFIC DATA},
Year = {2015},
Volume = {2},
Abstract = {Although the human olfactory system is capable of discriminating a vast
   number of odors, we do not currently understand what chemical features
   are encoded by olfactory receptors. In large part this is due to a
   paucity of data in a search space covering the interactions of hundreds
   of receptors with billions of odorous molecules. Of the approximately
   400 intact human odorant receptors, only 10\% have a published ligand.
   Here we used a heterologous luciferase assay to screen 73 odorants
   against a clone library of 511 human olfactory receptors. This dataset
   will allow other researchers to interrogate the combinatorial nature of
   olfactory coding.},
