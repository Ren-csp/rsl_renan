@article{ WOS:001826154600001,
Author = {Grueter, Cyril C. and Roncin, Fany and Nekaris, K. Anne-Isola and
   Pruetz, Jill and McFarland, Richard and Hasan, Sabit and Arlet,
   Malgorzata and Eppley, Timothy M. and Cheyne, Susan M. and Nijman,
   Vincent and Heymann, Eckhard W. and Marty, Pascal R. and De Gregorio,
   Chiara and Akankwasa, Walter and Weerasekara, Lakshani and Micheletta,
   Jerome and Matsuda, Ikki and Oklander, Luciana I. and Kabir, M. Tarik
   and Gorostiaga, Nicolas and Wu, Chengfeng and Martin, Lyna Rachid and
   Koirala, Sabina and Lanjouw, Annette and al Razi, Hassan and Chapoy,
   Nicholas and Bolt, Laura M. and Colquhoun, Ian C. and Li, Yanpeng and
   Huang, Zhipang and Chapman, Colin A. and Garber, Paul A.},
Title = {Heterospecific social behavior in primates: insights into the
   evolutionary roots of pet-keeping},
Journal = {PRIMATES},
Year = {2026},
Month = {2026 JUL 21},
Abstract = {Primate interspecific interactions with both other primates and
   non-primate species range from predator-prey dynamics to affiliative
   behaviors such as grooming, play, and carrying. While many primates
   participate in interspecific associations or commensal relationships, to
   our knowledge interspecific social interactions have never been
   systematically synthesized. Here, we present the first comprehensive
   review of such interactions, compiling 427 cases from the literature,
   media sources, and a global survey of primatologists. These involved 88
   primate species and 127 non-primate species (including mammals, birds,
   reptiles, amphibians, malacostracans, and insects) across wild (n = 311)
   and captive (n = 111) contexts. The most frequent interactions occurred
   within or between primate families (e.g.,
   Cercopithecidae-Cercopithecidae, Cebidae-Atelidae), though affiliative
   behaviors were also directed toward distantly related taxa such as dogs
   and birds. Play (n = 139) and grooming (n = 136) were most common.
   Juveniles and infants predominantly engaged in play, while adult females
   were more likely to groom. Adult males were less affiliative overall.
   Contrary to expectations, affiliative behaviors were not more often
   directed toward immature than adult heterospecifics. Primates were the
   initiators in most interactions. These findings offer new insights into
   the diversity and contexts of heterospecific sociality in primates and
   suggest that some behavioral tendencies relevant to later forms of
   human-animal companionship - such as caregiving, tolerance, and
   exploratory play - may be more widespread among primates than previously
   recognized.},
