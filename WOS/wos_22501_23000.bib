@article{ WOS:001350331300006,
Author = {Onyemachi, Nkiru Doris},
Title = {Ecoaesthetics and the Trauma of Continuity in Akwanya's
   Pilgrim Foot},
Journal = {HUMAN ECOLOGY REVIEW},
Year = {2024},
Volume = {28},
Number = {1},
Abstract = {The emergence of ecocriticism has enabled diverse studies on literature
   and the environment. In recent times, writers have employed poetry to
   illustrate ecoaesthetics, going beyond providing a broad view of
   environmental degradation to critically analyzing the various elements
   that make up the environment and how they interact with each other.
   Akwanya's Pilgrim Foot is one among other works that examined the
   interactions between the different entities of the ecosystem. Selected
   poems in Pilgrim Foot depict the estranged relationship between humanity
   and nature, caused by human activities and unexplainable natural
   disasters. The aesthetics of everyday routines constitute the foundation
   for this study, which critically discerns how people and their
   environment interact. Environmental degradation is analyzed as resulting
   from the detachment and discontinuity of everyday communal activities
   that harmonize the people and their immediate environment. The people
   are left traumatized due to their detachment from the environment as
   uncertainty looms over their future.},
