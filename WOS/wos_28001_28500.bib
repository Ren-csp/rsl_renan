@article{ WOS:000466701900037,
Author = {Navot, Shir and Kosloff, Mickey},
Title = {Structural design principles that underlie the multi-specific
   interactions of Gαq with dissimilar partners},
Journal = {SCIENTIFIC REPORTS},
Year = {2019},
Volume = {9},
Month = {MAY 3},
Abstract = {G alpha(q) is a ubiquitous molecular switch that activates the effectors
   phospholipase-C-beta 3 (PLC-beta 3) and Rho guanine-nucleotide exchange
   factors. G alpha(q) is inactivated by regulators of G protein signaling
   proteins, as well as by PLC-beta 3. G alpha(q) further interacts with G
   protein-coupled receptor kinase 2 (GRK2), although the functional role
   of this interaction is debated. While X-ray structures of Gaq bound to
   representatives of these partners have revealed details of their
   interactions, the mechanistic basis for differential G alpha(q)
   interactions with multiple partners (i.e., G alpha(q) multi-specificity)
   has not been elucidated at the individual residue resolution. Here, we
   map the structural determinants of G alpha(q) multi-specificity using
   structure-based energy calculations. We delineate regions that
   specifically interact with GTPase Activating Proteins (GAPs) and
   residues that exclusively contribute to effector interactions, showing
   that only the Gaq ``Switch II{''} region interacts with all partners.
   Our analysis further suggests that G alpha(q)-GRK2 interactions are
   consistent with GRK2 functioning as an effector, rather than a GAP. Our
   multi-specificity analysis pinpoints G alpha(q) residues that uniquely
   contribute to interactions with particular partners, enabling precise
   manipulation of these cascades. As such, we dissect the molecular basis
   of G alpha(q) function as a central signaling hub, which can be used to
   target G alpha(q)-mediated signaling in therapeutic interventions.},
