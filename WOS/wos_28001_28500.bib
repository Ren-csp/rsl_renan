@article{ WOS:000383317400003,
Author = {Zhang, Xianming and Lohmann, Rainer and Dassuncao, Clifton and Hu, Xindi
   C. and Weber, Andrea K. and Vecitis, Chad D. and Sunderland, Elsie M.},
Title = {Source Attribution of Poly- and Perfluoroalkyl Substances (PFASs) in
   Surface Waters from Rhode Island and the New York Metropolitan Area},
