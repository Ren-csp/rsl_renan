@article{ WOS:001766483000001,
Author = {Zhai, Baoxin and Zhu, Wei and Duan, Qiannan and Xu, Zhuoyi},
Title = {An in-depth analysis of household non-commuting behaviours and the
   15-minute community life circle in Shanghai, China},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {2},
Pages = {773-786},
Month = {JUN},
Abstract = {Life Circle (LC) concept is increasingly recognized globally as a key
   strategy in urban planning to meet residents' life needs and improve
   their quality of life. However, existing studies primarily focus on
   individual perspectives and have not yet explored the role of LCs in
   household daily behaviours. To address this gap, this study aims to
   provide a detailed understanding of the impact of the 15-min community
   life circle (CLC) on non-commuting behaviours from a household
   perspective. The research was conducted in Shanghai, using a combination
   of data sources, including 282 household daily behaviour data obtained
   through questionnaire survey, CLC facilities data sourced from AutoNavi
   map, and census data. We firstly captured the non-commuting behaviour
   characteristics of households at various life stages across three
   dimensions: travel distance (TD), travel frequency (TF), and objective
   satisfaction. Then we employed Gamma regression and Quasi-Binomial
   Logistic regression to analysis the relationship between household
   non-commuting behaviour and CLC facilities. Key findings include: (1)
   within a CLC, the number of supermarkets and hospitals negatively
   influences on household non-commuting TD; (2) the presence and number of
   malls positively affect non-commuting TF, while service population has a
   negative impact; (3) the number and service population of parks have
   opposing effects on noncommuting TF; and (4) the number of supermarkets
   and parks positively influences household CLC satisfaction, while
   service population negatively impacts satisfaction. This study not only
   addresses a critical research gap by examining the role of CLC from a
   household perspective but also offers practical recommendations for
   optimizing CLCs to better meet the life needs of households at different
   life stages.},
