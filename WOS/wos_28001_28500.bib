@article{ WOS:001521816600001,
Author = {Opatovsky, Kendra and Pentz, Brian and Loring, Philip A.},
Title = {Examining critical assumptions in global conservation practice},
Journal = {CONSERVATION BIOLOGY},
Year = {2025},
Volume = {39},
Number = {6},
Month = {DEC},
Abstract = {The ability of conservation practitioners to design and implement
   successful conservation projects and scale up positive outcomes depends
   in large part on their ability to make accurate assumptions about the
   social and ecological contexts in which their projects operate. To
   understand the types of assumptions characterizing conservation practice
   and strategy, we examined 300 assumptions identified by conservation
   practitioners in project workshops at The Nature Conservancy, a large
   environmental nongovernmental organization, as being critical to the
   success of their conservation projects. We identified 7 conservation
   assumption themes (public attitudes and perceptions; capacity and
   resources; economic and behavioral factors; government, politics, and
   policy; impacts and scalability; knowledge and evidence; and
   organizational or internal factors), which primarily relate to the human
   dimensions of conservation (e.g., values, human behavior, relationships,
   policy, and politics). The conservation assumptions focused
   predominantly on project-level and place-based matters, rather than on
   the root causes of conservation problems. For people- and
   equity-centered conservation approaches, our findings suggest that
   conservation teams should systematically engage with areas of elevated
   uncertainty and should especially focus on axiomatic assumptions made
   about the broader contexts in which conservation projects operate. These
   insights can inform effective project design and adaptive learning and
   can directly improve project success.
   An \& aacute;lisis de los supuestos cr \& iacute;ticos en la pr \&
   aacute;ctica de la conservaci \& oacute;n global La capacidad de los
   profesionales de la conservaci \& oacute;n para dise \& ntilde;ar y
   ejecutar con \& eacute;xito proyectos de conservaci \& oacute;n y
   ampliar los resultados positivos depende en gran medida de su capacidad
   para hacer suposiciones precisas sobre los contextos sociales y ecol \&
   oacute;gicos en los que operan sus proyectos. Para comprender los tipos
   de supuestos que caracterizan la pr \& aacute;ctica y la estrategia de
   la conservaci \& oacute;n, examinamos 300 supuestos identificados por
   profesionales de la conservaci \& oacute;n en los talleres de proyectos
   de The Nature Conservancy, una gran organizaci \& oacute;n no
   gubernamental medioambiental, como fundamentales para el \& eacute;xito
   de sus proyectos de conservaci \& oacute;n. Identificamos siete temas de
   supuestos de conservaci \& oacute;n (actitudes y percepciones del p \&
   uacute;blico; capacidad y recursos; factores econ \& oacute;micos y de
   comportamiento; gobierno, pol \& iacute;tica y pol \& iacute;tica;
   impactos y escalabilidad; conocimiento y pruebas; y factores
   organizativos o internos), que se relacionan principalmente con las
   dimensiones humanas de la conservaci \& oacute;n (por ejemplo, valores,
   comportamiento humano, relaciones y pol \& iacute;tica). Los supuestos
