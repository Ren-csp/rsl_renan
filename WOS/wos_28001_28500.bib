@article{ WOS:001847131100001,
Author = {Petchame, Josep and Novkovic, Dubravka and Torres-Kompen, Ricardo},
Title = {``More Feedback, Please{''}: Student Perceptions of Active Learning
   Strategies for Formative Assessment to Enhance Sustainable Learning in
   Higher Education},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {15},
Month = {AUG 1},
Abstract = {This study examines a persistent puzzle in active learning research in
   education: why do pedagogically sound interventions not always translate
   into perceived student value? We analyzed Information and Communications
   (ICT) Engineering students' perceptions of three structurally distinct
   activities (weekly quizzes, individual concept maps, and a finance
   escape room) within a compulsory business course. Using bipolar
   laddering, 133 positive and 72 negative perception elements were mapped
   onto four dimensions of theSustainable Learning in Education (SLE)
   framework: renewal and relearning, transferability, independent and
   collaborative learning, and active learning. Self-regulated learning
   (SRL) functioned as the mechanism linking environmental dimensions to
   student agency and engagement. Students perceived all three activities
   as useful for examination preparation, but through different cognitive
   pathways. Quizzes supported distributed retrieval practice and were
   valued for re-attempts, though their usefulness declined with weak exam
   alignment or limited access. Concept maps enabled synthesis and
   relational understanding, yet received the lowest student endorsement,
   largely because in some instances student work was not returned
   post-submission. The escape room achieved the strongest and most
   consistent endorsement for exam preparation, with perceived limitations
   related only to activity duration and syllabus coverage. Activity
   alignment with SLE dimensions was uneven: quizzes aligned principally
   with renewal, concept maps with transferability, and all activities with
   independent and collaborative learning in distinct ways. Active learning
   was present throughout, but not uniform. The central finding was that
   perceived usefulness depended less on activity type than on feedback
   distribution and continuity. When feedback loops broke, perceived value
   declined. Together, the activities, therefore, form a complementary
   course-level feedback system. Through this case study, we identified
   five design recommendations to be implemented in the next edition of the
   course, positioning feedback as a system-level variable.},
