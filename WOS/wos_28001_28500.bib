@article{ WOS:001535226600005,
Author = {Krishna Prasad, G. V. R. and Grigsby, Steven J. and Erkenswick, Gideon
   A. and Portal-Celhay, Cynthia and Mittal, Ekansh and Yang, Guozhe and
   Fallon, Samuel M. and Chen, Fengyixin and Klevorn, Thais and Jain,
   Neharika and Li, Yuanyuan and Mitreva, Makedonka and Martinot, Amanda J.
   and Ernst, Joel D. and Philips, Jennifer A.},
Title = {Macrophage-T cell interactions promote SLAMF1 expression for enhanced TB
   defense},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUL 23},
Abstract = {CD4+ T cells are crucial for protective immunity to intracellular
   pathogens. In addition to secreting cytokines, CD4+ T cells promote
   control of Mycobacterium tuberculosis infection through cognate
   interactions with macrophages, but the mechanism has been unclear. Here,
   we show that SLAMF1/CD150 is highly and uniquely induced in macrophages
   by antigen-specific interactions with CD4+ T cells. In macrophages,
   SLAMF1 enhances the generation of reactive oxygen species and restricts
   Mtb replication. Mtb-infection of mice promotes SLAMF1 expression
   specifically on infected macrophages, not uninfected bystanders. SLAMF1
   expression depends on adaptive immunity and also autophagy. Moreover,
   Slamf1-/- mice have higher Mtb burden and more rapid disease progression
   than wild type mice. Using Slamf1fl/fl conditional knock-out mice, we
   show that in vivo Slamf1 is specifically required in macrophages to
   restrict mycobacterial growth and limit IL-1 beta production. In
   macaques, macrophage SLAMFI expression also correlates with T cell
   responses and protection. Combined, these data demonstrate that SLAMF1
   is a marker of macrophage-T cells interactions, and it promotes
   protection against Mtb.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
