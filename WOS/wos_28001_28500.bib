@article{ WOS:001315902600001,
Author = {Kulin, Joakim and Seva, Ingemar Johansson and Fairbrother, Malcolm},
Title = {Political trust and public support for climate policy in Europe: the
   role of perceptions about politicians' competence and integrity},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2024},
Volume = {6},
Number = {9},
Month = {SEP 1},
Abstract = {While previous studies on the relationship between political trust and
   support for climate policy have focused on the evaluative component of
   trust, namely whether politicians and the political system can be
   trusted or not, less is known about the role of different dimensions of
   trustworthiness that underlie such evaluations. In this study, we
   examine how perceptions about politicians' competence and integrity, two
   central dimensions of trustworthiness, are related to public support for
   climate policies. Using survey data from four European countries
   (Sweden, Germany, Spain, and Poland), we find that people who think that
   politicians are competent are generally more likely to support climate
   policy. In contrast, we do not find such a relationship between
   integrity perceptions (e.g., corruption) and policy attitudes. These
   findings are consistent across national contexts and hold even when
   alternating the measures capturing competence and integrity perceptions.
   To bolster public support for climate policies, climate communication
   should prioritize addressing public concerns regarding politicians'
   competence in designing sound climate policies, rather than alleviating
