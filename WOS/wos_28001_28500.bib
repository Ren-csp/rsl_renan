@article{ WOS:001788424000001,
Author = {Bidolli, Brian and Mostofi, Hamid},
Title = {Citizen perceptions and support for urban sustainability investments in
   a Business Improvement District},
Journal = {CLEANER AND RESPONSIBLE CONSUMPTION},
Year = {2026},
Volume = {22},
Month = {AUG},
Abstract = {Municipal governments increasingly rely on place-based financing
   mechanisms to support local services and sustainability-oriented
   investments under fiscal constraints. Business Improvement Districts
   (BIDs) represent one such mechanism, yet public support for BID
   assessments, particularly when proposed beyond traditional economic
   development functions, remains insufficiently understood. This study
   addresses this gap by examining support for a proposed BID in Norwalk,
   Connecticut, identifying factors shaping stated willingness to pay
   (WTP), assessing how sustainability-and equity-oriented investment
   priorities influence acceptance, and evaluating how machine learning
   (ML) complements conventional statistical approaches. The analysis
   conceptualizes support for BID assessments as an expression of
   institutional acceptance shaped by citizen perception, while statistical
   and ML analysis highlight potential drivers of support. Survey data from
   366 residents were analyzed using descriptive and inferential methods,
   complemented by Random Forest models to examine how beliefs, perceived
   benefits, and perceived risks relate to support across alternative fee
   scenarios. Results indicate that support is highly sensitive to fee
   framing, with financial incentive-based proposals receiving greater
   support than those focused on public services, infrastructure, or
   environmental improvements, while a benchmarked monthly fee elicits
   strong opposition. Demographic characteristics exhibit weak associations
   with support, whereas perceived benefits increase support, and
   affordability-related concerns constrain acceptance when costs are
   explicit. Across scenarios, support reflects perceived value and cost
   considerations are more influential than fixed demographic
   predispositions, offering insight for the design and communication of
   BID-like mechanisms to finance sustainability and equity-oriented urban
   investment.},
