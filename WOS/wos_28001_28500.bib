@article{ WOS:001647348700001,
Author = {Lorek, Agnieszka and Koczur, Wieslaw and Lorek, Pawel},
Title = {Ecological Attitudes and Quality of Life as Key Factors in the
   Sustainable Development of Polish Municipalities},
