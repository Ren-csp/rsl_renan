@article{ WOS:001855564500001,
Author = {Peyman Arjomandi, A. and Komendantova, Nadejda},
Title = {Risk, values, and efficacy in climate policy participation: A European
   psychosocial analysis},
Journal = {ENVIRONMENTAL DEVELOPMENT},
Year = {2026},
Volume = {60},
Month = {SEP},
Abstract = {Climate adaptation is a global imperative whose success relies on both
   effective policy design and active public participation. Understanding
   the psychological factors that influence such participation is crucial.
   This study examines these factors in a European sample using an extended
   Risk Perception Attitude Framework that incorporates ecocentric values
   and climate change beliefs to explore how perceptions, values, and
   beliefs are associated with intentions to participate in climate
   adaptation policies. Results from structural equation modeling indicate
   that perceived risk, perceived efficacy, and ecocentric values are
   significantly associated with these intentions, while climate change
   beliefs are indirectly associated with them through perceived risk.
   Among these factors, perceived risk exhibits the strongest association
   with intentions, followed by ecocentric values, which are inversely
   related to perceived risk. Together, these relationships contribute to
   understanding the psychosocial determinants of such intentions in the
   European population studied and highlight the analytical utility of the
   framework for examining them. While the findings may offer relevant
   policy insights and inform decision-making, future research should
   examine larger and more diverse populations across contexts and
   incorporate additional latent constructs to further refine understanding
   of the underlying relationships.},
