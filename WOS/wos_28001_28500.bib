@article{ WOS:000509660700005,
Author = {Asbury, Kathryn and Moran, Nicola and Plomin, Robert},
Title = {Nonshared Environmental Influences on Academic Achievement at Age 16: A
   Qualitative Hypothesis-Generating Monozygotic-Twin Differences Study},
Journal = {AERA OPEN},
Year = {2016},
Volume = {2},
Number = {4},
Month = {OCT-DEC},
Abstract = {Twin studies find similar to 20\% of the variance in achievement in
   public examinations taken at age 16 in the United Kingdom can be
   explained by experiences not shared within families. Nonshared
   environmental (NSE) influences, including measurement error, explain why
   monozygotic (MZ) twins differ from each other. Such influences work
   independently of genetic effects and may represent strong candidates for
   intervention. This study aimed to generate hypotheses about what these
   NSE factors might be. Perceptions of within-pair differences were
   gathered from n = 497 pairs of MZ twins and their parents, and telephone
   interviews were conducted with n= 56 families reporting different
   General Certificate of Secondary Education grades. ``Environmental{''}
   explanations related to teacher quality, teacher-pupil relationships,
   and ability grouping. Families also explained discordance in terms of
   effort, interest, ability, and personality.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Asbury, K (Corresponding Author), Univ York, Psychol Educ, York, N Yorkshire, England.
   Asbury, Kathryn, Univ York, Psychol Educ, York, N Yorkshire, England.
   Moran, Nicola, Univ York, Dept Social Policy \& Social Work, York, N Yorkshire, England.
   Plomin, Robert, Kings Coll London, Social Genet \& Dev Psychiat Ctr, Behav Genet, London, England.},
DOI = {10.1177/2332858416673596},
EISSN = {2332-8584},
