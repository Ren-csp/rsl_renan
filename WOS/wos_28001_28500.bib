@article{ WOS:000320635800016,
Author = {Petrova, Saska and Gentile, Michael and Makinen, Ilkka Henrik and
   Bouzarovski, Stefan},
Title = {Perceptions of thermal comfort and housing quality: exploring the
   microgeographies of energy poverty in Stakhanov, Ukraine},
Journal = {ENVIRONMENT AND PLANNING A-ECONOMY AND SPACE},
Year = {2013},
Volume = {45},
Number = {5},
Pages = {1240-1257},
Month = {MAY},
Abstract = {The growing recognition of the importance of indoor environments as
   `active political-ecological spaces' has rarely been followed up by a
   systematic empirical engagement with the constituent dynamics and
   conceptual issues associated with infrastructural deprivation in this
   domain, particularly in non-Western contexts. Therefore, we investigate
   the relationship between self-reported perceptions of thermal comfort in
   the home, on the one hand, and a range of sociodemographic, housing, and
   health-related variables, on the other, via a quantitative analysis of a
   large-scale survey undertaken in the Eastern Ukrainian town of
   Stakhanov. Using the perceived level of thermal comfort as a starting
   point for its empirical explorations, we estimate the number and type of
   households who feel that they are receiving inadequate energy services
   in the home. Special attention is paid to the role of buildings in
   shaping the perceptions of thermal comfort.},
