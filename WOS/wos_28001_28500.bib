@article{ WOS:001329703200001,
Author = {Esser, Florian and Jaede, Sylvia and von der Heyde, Judith},
Title = {Intragenerational ontopolitics and stunt scooters: Doing childhood in
   public urban spaces},
Journal = {CHILDHOOD-A GLOBAL JOURNAL OF CHILD RESEARCH},
Year = {2024},
Volume = {31},
Number = {4},
Pages = {572-587},
Month = {NOV},
Abstract = {In the article we discuss the `re-inhabitation' of public spaces by
   children and young people in Germany who ride scooters on a skate park.
   In addition to the generational difference between children and adults,
   the importance of intragenerational relations amongst scooter riders is
   also revealed when it comes to legitimizing access to and exclusion from
   the skatepark. With an ontopolitical perspective, the significance of
   generational order and ordering in relation to processes of zoning in
   public space can be analyzed.},
