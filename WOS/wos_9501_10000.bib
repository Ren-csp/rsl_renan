@article{ WOS:000526107000011,
Author = {Fernandes de Santana, Wilder Kleber and de Carvalho Diniz e Silva,
   Helcia Macedo},
Title = {BETWEEN HEIDEGGER AND BAKHTIN: Philosophical-discursive discussions
   about Human being and Language},
