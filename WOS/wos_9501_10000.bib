@article{ WOS:001851787200001,
Author = {Sun, Xiaoyue and Zhao, Shuai and Guo, Hui and Li, Wenjun and Guo, Yingqi},
Title = {Community Environment, Parenting Practices, Social Support, and
   Children's Quality of Life in Shanghai, China: A Multi-Scalar and
   Gendered Analysis},
Journal = {CHILD INDICATORS RESEARCH},
Year = {2026},
Month = {2026 AUG 18},
Abstract = {This study investigates the relationships between community environment,
   parenting practices, social support, and children's quality of life in
   Shanghai. Grounded in a ``4D{''} framework (Density, Design, Diversity,
   and Destination), we employed a multi-scalar geospatial approach using
   300-meter, 500-meter, 1000-meter, and 1500-meter residential buffers to
   address the uncertain geographic context problem. Path analysis was used
   to examine direct and indirect effects. Our results indicate a
   consistent pattern of attenuation beyond 500 m - observed across
   multiple community attributes, supporting Shanghai's 15-minute community
   life cycle policy. Green park space at 300 m showed a significant direct
   positive association with children's quality of life. Residential
   density and shopping services operated indirectly through parenting
   practices at both 300 and 500 m. Notably, street connectivity and land
   use mix showed no significant associations, which differs from the
   Western context. Social support was consistently predicted by parenting
   practices, not directly by any community feature. A critical gendered
   analysis revealed pronounced differences: girls showed more
   environmental types and more indirect (parenting-mediated) pathways
   across all buffers. At the same time, boys demonstrated only one
   significant effect - a direct positive association with green park space
   at 300 m - with no parenting-mediated pathways. This research provides
   spatially-sensitive evidence to help urban planners create
   child-friendly communities through hyper-local interventions (300-500
   m), balanced green space design (active parks and vegetated areas),
   family-supportive density, and gender-responsive design supporting
   diverse patterns of parenting and child activity.},
