   Dikmen, Melih; Gokalp, Ayse Can, Firat Univ, Fac Educ Sci, Elazig, Turkiye.},
DOI = {10.1007/s10643-026-02177-w},
EarlyAccessDate = {MAR 2026},
ISSN = {1082-3301},
EISSN = {1573-1707},
Keywords = {Preschool education; Parental perceptions; Rural-Urban inequality; Early
   childhood education},
Keywords-Plus = {EARLY-CHILDHOOD EDUCATION; READINESS; ECONOMICS; CONTEXT; SCHOOL},
