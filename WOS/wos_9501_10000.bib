@article{ WOS:000504009600111,
Author = {Carducci, Annalaura and Fiore, Maria and Azara, Antonio and Bonaccorsi,
   Guglielmo and Bortoletto, Martina and Caggiano, Giuseppina and Calamusa,
   Andrea and De Donno, Antonella and De Giglio, Osvalda and Dettori, Marco
   and Di Giovanni, Pamela and Di Pietro, Angela and Facciola, Alessio and
