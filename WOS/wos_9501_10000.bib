@article{ WOS:001640777200001,
Author = {Chinzorig, Gundegmaa and Sarif, Md. Omar and Sharifi, Ayyoob},
Title = {An analysis of the effectiveness of urban master plans in controlling
   and regulating urban growth in Ulaanbaatar, Mongolia},
Journal = {CITIES},
Year = {2026},
Volume = {170},
Month = {MAR},
Abstract = {Ulaanbaatar, the capital city of Mongolia, has experienced rapid
   population growth over the past five decades, accompanied by unplanned
   land use, increased construction, loss of green spaces, and rising
   pollution. Nonetheless, there is a paucity of research investigating
   land use and land cover changes and the efficacy of urban master plans
   in managing urban growth in the city. This study has two main
   objectives: to analyze the land use and land cover changes from 1973 to
   2023, and to assess the effectiveness of the master plans for 2020 and
   2040. Remote sensing techniques and the Local Climate Zone
   classification method are employed for the spatiotemporal analysis of
   land use and land cover. The 2040 land use and land cover is simulated
   using the Patchgenerating Land Use Simulation model to assess future
   planning outcomes. Results show a rapid expansion of built-up areas by
   249.25 km2 and water bodies by 39.84 km2 between 1974 and 2023.
   Meanwhile, the area of green spaces declined by 289.09 km2 during the
   same period. Between 2007 and 2023, a notable trend has emerged of
   high-rise buildings replacing areas originally designated for mid-rise
   development. Comparison of the actual conditions with the 2020 Master
   Plan reveals significant deviations, indicating poor implementation. The
   comparison between simulated land use and land cover for 2040 and Master
   Plan-2040 suggests that it may also be inadequate in regulating future
   urban expansion if existing trends continue. These findings underscore
   the urgent need for stronger enforcement mechanisms and revised planning
   strategies. This study provides actionable insights for policymakers and
   planners working toward sustainable and resilient urban development.},
