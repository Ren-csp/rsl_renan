@article{ WOS:001521412300001,
Author = {Schaupp, Julia and Schaffer, Beat and Wunderli, Jean-Marc and Hediger,
   Karin and Tobias, Silvia and Heimer, Jakob and Bauer, Nicole},
Title = {Psychophysiological effects of walking in forests and urban built
   environments with disparate road traffic noise exposure: A randomized
   controlled trial},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2025},
Volume = {105},
Month = {AUG},
Abstract = {People in urbanized societies commonly visit greenspaces to alleviate
   stress and promote restoration and wellbeing. However, access to
   greenspaces is often limited and road traffic noise remains a major
   environmental stressor in urban areas. While various studies have
   compared the benefits of exposure to greenspaces and urban built
   environments, the role of traffic noise in shaping these effects remains
   understudied. This randomized, controlled field study compared the
   psychophysiological benefits of exposure to forests and urban built
   environments with different levels of road traffic noise in 354 healthy
   adults during 30-min walks in Z \& uuml;rich, Switzerland. A range of
   physiological and psychological outcomes were measured. Linear
   mixed-effects models showed that walking in forests, in environments
   with lower road traffic noise and longer relative quiet time without
   road traffic noise was associated with increased feelings of
   restoration, subjective stress recovery, and perceived restorativeness,
   compared to walking in urban built environments with higher road traffic
   noise as well as such with less relative quiet time. These associations
   were not observed for salivary cortisol and for attention, though
   cortisol levels decreased in all conditions, likely due to walking
   itself. Findings from quantitative and qualitative data on
   soundscape-induced positive and negative affect showed discrepancies,
   indicating a need for developing and using affective measures that
   include low activation affect. Our results suggest that even when noise
   exposure is relatively low, it can still impede subjective restoration
   and subjective stress recovery. This highlights the need for noise
   mapping and mitigation strategies to reduce noise exposure, specifically
   in public greenspaces. The results further underscore the importance of
   noise-free periods, without road traffic noise. When planning,
   designing, and/or preserving urban environments to support the
   well-being of inhabitants, road traffic noise as an impediment to
   subjective restoration and subjective stress recovery should be
   addressed.},
Publisher = {ACADEMIC PRESS LTD- ELSEVIER SCIENCE LTD},
Address = {24-28 OVAL RD, LONDON NW1 7DX, ENGLAND},
