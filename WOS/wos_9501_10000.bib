@article{ WOS:001204121500002,
Author = {Yen, Hsin-Yen and Huang, Hao-Yun},
Title = {Actual and Virtual Parks Benefit Quality of Life and Physical Activity:
   A Cluster Trial},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
