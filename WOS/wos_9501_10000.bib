@article{ WOS:001856721500001,
Author = {Peranovic, Finn and Labib, S. m.},
Title = {Identifying potential vertical spaces for nature-based solutions in
   dense urban context: GeoAI approach},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {149},
Month = {OCT 1},
Abstract = {Cities worldwide face numerous challenges, including the urban heat
   island effect, urban stormwater flooding, and climate change.
   Nature-based solutions (NBS) can mitigate these challenges, while
   providing ecosystem services and health co-benefits, yet retrofitting
   NBS within dense urban fabric is difficult because suitable land is
   scarce. Underused or unused vertical spaces on building fa \&
   ccedil;ades and roofs could provide opportunities to increase urban
   greenery without competing for ground-level land. However, no existing
   study simultaneously assesses both fa \& ccedil;ade and rooftop vertical
   spaces for NBS using integrated artificial intelligence and geospatial
   methods; most studies only focus on rooftop greening potential. In this
   research, we developed and evaluated an integrated GeoAI framework that
   combines a foundation AI segmentation model (LangSAM) applied to street
   view imagery (SVI) for fa \& ccedil;ade greening assessment with a
   geospatial multicriteria approach for rooftop greening assessment in the
   dense urban context of Amsterdam, the Netherlands. Here, greening
   potential refers to the physical and technical feasibility based on the
   measurable surface areas available for NBS integration. When applied to
   street-based sampling locations in Mapillary SVI, our framework achieved
   a mean Intersection over Union (IoU) of 0.74 and a mean F1 (Dice) score
   of 0.84 for fa \& ccedil;ade segmentation, indicating high accuracy in
   detecting potential greenable building fa \& ccedil;ades. The results
   suggest high potential for greening building fa \& ccedil;ades, with
   about 39\% of 36,343 sampled fa \& ccedil;ade locations in predominantly
   residential areas, particularly in buildings with few street-facing
   windows. Additionally, the 10.0 km2 of roof area on 28,526 buildings is
   classified as highly suitable for green roof implementation. Spatial
   hotspot analysis identified several roof-greening clusters, whereas no
   such clustering was observed for fa \& ccedil;ades. We provided a
   replicable workflow for broader implementation of the methodological
   approach in research and practice, and suggested potential future
   developments to further assess the vertical greening potential on the
   unused or underused vertical space above buildings.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
