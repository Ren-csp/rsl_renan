@article{ WOS:000982578800001,
Author = {Swaminathan, Bavetra and Chakravarthy, Ravi},
Title = {Ecocritical Wisdom for Ecojustice: The Quintessence of Human Existence},
Journal = {JOURNAL OF HUMAN VALUES},
Year = {2023},
