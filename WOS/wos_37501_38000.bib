@article{ WOS:001878025200001,
Author = {Generoso, Carolina and Nandi, Srijaya and Sergino, Vivian and Resende,
   Briseida and Bhadra, Anindita and Savalli, Carine},
Title = {The role of life history in the ability to follow pointing gestures: A
   comparative study of pet, shelter, and free-ranging dogs},
Journal = {APPLIED ANIMAL BEHAVIOUR SCIENCE},
Year = {2026},
Volume = {305},
Month = {DEC},
Abstract = {Dogs are known to follow human pointing gestures, but the influence of
   life history on this ability remains poorly understood. We hypothesized
   that dogs with different backgrounds would vary in their accuracy of
   pointfollowing, with pet dogs performing better than free-ranging dogs
   and shelter dogs. 105 dogs participated in a two-choice task: 41 pets,
   32 free-ranging dogs, and 32 shelter dogs. Each dog completed three
   trials in which an experimenter pointed to a randomly assigned food
   location. 315 trials were analyzed using a generalized linear mixed
   model with a logit link, including dog identity as a random effect.
   Overall, point-following accuracy did not differ significantly among
   groups and was not affected by overall left-right response bias.
   However, when analyzed separately, pet dogs and shelter dogs performed
   above chance, whereas free-ranging dogs showed only marginal success.
   Shelter and free-ranging dogs performed better in the first trial than
   in later ones, while pet dogs remained stable across trials. These
   findings suggest that gesture following reflects a flexible
   decisionmaking process, modulated by context and life history.},
