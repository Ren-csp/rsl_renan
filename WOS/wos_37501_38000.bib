@article{ WOS:000319803500065,
Author = {Guo, Yongxia and Zheng, Zuyu and La Clair, James J. and Chory, Joanne
   and Noel, Joseph P.},
Title = {Smoke-derived karrikin perception by the α/β-hydrolase KAI2 from
   Arabidopsis},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
