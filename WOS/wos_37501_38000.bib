@article{ WOS:001608565300001,
Author = {Lepak, Ryan F. and Mve Beh, Jean Herve and Moukegni-Sika, Clotaire and
   Bibang Binguema, Jean Noel and Janssen, Sarah E. and Ogorek, Jacob M.
