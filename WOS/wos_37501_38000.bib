@article{ WOS:001652395300001,
Author = {Lambrecht, Yamila Belen and Picone, Natasha and Zapperi, Paula Andrea},
Title = {Lessons from extreme weather events in an intermediate-sized city in
   Argentina},
Journal = {ENVIRONMENTAL RESEARCH-CLIMATE},
Year = {2026},
Volume = {5},
Number = {1},
Month = {MAR 1},
Abstract = {This paper examines the impacts of recent extreme weather events in Bah
   \& iacute;a Blanca, Argentina, within the context of climate change,
   focusing on the increasing frequency and severity of events affecting
   urban areas. Using a multidisciplinary approach that combine synoptic
   and meteorological data, satellite imagery, and fieldwork, the study
   identifies the atmospheric mechanisms behind each event and their
   differential effects on the urban environment. The results reveal the
   severity of a bow-echo windstorm in December 2023, with gusts reaching
   155 km h-1 and extensive damage to infrastructure, the local port, and
   green spaces. An intense heat wave during the 2023-2024 summer and major
   flooding in March 2025 further exposed critical weaknesses in population
   preparedness and the limitations of existing drainage infrastructure.
   These events, occurring within a short period, underscore the urgency of
   integrating climate risk into urban planning. The study highlights the
   relevance of real-time monitoring networks, early warning systems, and
   participatory governance as key tools to enhance resilience and ensure
   equitable responses to climate-driven extremes.},
