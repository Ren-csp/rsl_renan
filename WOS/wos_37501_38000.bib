@article{ WOS:000363408300011,
Author = {Daly, Mary B.},
Title = {A Family-Centered Model for Sharing Genetic Risk},
Journal = {JOURNAL OF LAW MEDICINE \& ETHICS},
Year = {2015},
Volume = {43},
Number = {3, SI},
Pages = {545-551},
Month = {FAL},
Note = {National Conference on Return of Research Results - What About the
   Family, Univ Minnesota, Minneapolis, MN, NOV, 2014},
Abstract = {The successes of the Human Genome Project have ushered in a new era of
   genomic science. To effectively translate these discoveries, it will be
   critical to improve the communication of genetic risk within families.
   This will require a systematic approach that accounts for the nature of
   family relationships and sociocultural beliefs. This paper proposes the
   application of the Family Systems Illness Model, used in the setting of
   cancer care, to the evolving field of genomics.},
