@article{ WOS:001561244100001,
Author = {Nelaballi, Swapna and McConkey, Kim R. and Marshall, Andrew J.},
Title = {Contemporary Hunting Practices in a Mosaic Landscape of Tropical Forests
   and Plantations in West Kalimantan, Indonesia},
Journal = {HUMAN ECOLOGY},
Year = {2025},
Volume = {53},
Number = {3},
Pages = {467-487},
Month = {JUN},
Abstract = {In Indonesia, the expansion of labor-intensive plantations has
   transformed forested landscapes into forest-plantation mosaics, altering
   demographics through immigration and increasing access to forest
   resources. Understanding current hunting practices within these socially
   and ecologically altered landscapes is crucial for predicting how
   species of conservation concern will be affected. However, there is a
   lack of quantitative, site-based, multi-species assessments of hunting.
   Our study represents the first systematic, multi-species assessment from
   Indonesian Borneo. We aimed to quantitatively examine the scale,
   motivations, and perceptions of hunting for 33 mammal and bird species.
   Using a structured questionnaire, we collected data from 25 active and
   four former Melayu hunters in villages adjacent to Gunung Palung
   National Park, West Kalimantan, Indonesia. We demonstrate that larger
   animals are disproportionately targeted and document how religious and
   cultural beliefs lead hunters to seek specific species, such as deer,
   chevrotains, and porcupines, among others. However, some hunters engaged
   in opportunistic hunting of other species, including those listed as
   critically endangered, for crop protection, medicinal use, and the sale
   of wild meat and body parts. While hunters perceived hunting as risky,
   legal repercussions were reported less frequently as a concern. Overall,
   respondents expressed intentions to stop or discourage future hunting
   primarily due to age-related factors and the declining populations of
   preferred species, particularly ungulates such as the sambar (Rusa
   unicolor). This decline was widely attributed to excessive hunting
   rather than habitat loss. Importantly, our study indicates that the
   sambar may be at dire risk of local extinction, underscoring the urgent
   need for targeted conservation measures.
   Di Indonesia, perluasan perkebunan padat karya telah mengubah lanskap
   hutan menjadi mosaik hutan-tanaman, mengubah demografi melalui imigrasi
   dan meningkatkan akses terhadap sumber daya hutan. Memahami praktik
   perburuan saat ini dalam lanskap yang telah mengalami perubahan sosial
   dan ekologis sangat penting untuk memprediksi bagaimana spesies yang
   menjadi perhatian konservasi akan terkena dampaknya, namun penilaian
   kuantitatif perburuan multispecies berbasis lokasi masih kurang.
   Penelitian kami merupakan penilaian sistematis dan multi-spesies pertama
   dari Kalimantan, Indonesia. Kami bertujuan untuk mengkaji secara
   kuantitatif skala, motivasi, dan persepsi perburuan terhadap 33 spesies
   mamalia dan burung. Dengan menggunakan kuesioner terstruktur, kami
   mengumpulkan data dari 25 pemburu aktif dan 4 mantan pemburu Melayu di
   desa-desa yang berdekatan dengan Taman Nasional Gunung Palung,
   Kalimantan Barat, Indonesia. Kami menunjukkan bahwa hewan yang lebih
   besar menjadi target secara tidak proporsional, dan mendokumentasikan
   bagaimana kepercayaan agama dan budaya mangarahkan pemburu untuk mencari
   spesies tertentu: rusa, kancil, dan landak, antara lain. Namun, beberapa
   pemburu terlibat dalam perburuan oportunistik terhadap spesies lain,
   termasuk species yang terdaftar sebagai Kritis Terancam Punah, untuk
   perlindungan tanaman, penggunaan obat-obatan, dan penjualan daging serta
   bagian tubuh hewan liar. Sementara pemburu menganggap perburuan itu
   berisiko, akibat hukum lebih jarang dilaporkan sebagai risiko. Secara
   keseluruhan, para responden menyatakan niat untuk menghentikan atau
   mencegah perburuan di masa depan karena ketidakseimbangan antara usaha
   dan hasil, yang terutama didorong oleh penurunan populasi spesies yang
   disukai, terutama hewan berkuku seperti rusa (Rusa unicolor). Penurunan
   ini lebih disebabkan oleh perburuan yang berlebihan dibandingkan
   kehilangan habitat. Yang terpenting, penelitian kami menunjukkan bahwa
   rusa mungkin mempunyai risiko kepunahan lokal yang sangat besar dan
   menggarisbawahi kebutuhan mendesak untuk tindakan konservasi yang
   terarah.},
