@article{ WOS:001833812700001,
Author = {Chandra, Larissa and Hofmann, Lea and Schulze, Zacharias Joel and
   Fuhrer, Amand},
Title = {Children's perceptions of the neighbourhood as a social determinant of
   health - a qualitative study},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {11},
Month = {DEC},
Abstract = {This article explores children's perspectives on their neighbourhood and
   the meaning it holds for their health and well-being. Currently, there
   is a lack of understanding on how children perceive environmental risks
   and resources present in their neighbourhood, as research often focuses
   on adult viewpoints. Before a joint framework of Children's Rights and
   the Social Determinants of Health, we focus on the perspectives of
   children growing up in deprived neighbourhoods. We selected two
   after-school care centres in two deprived neighbourhoods in a
   medium-sized German city. Here, we recruited 16 primary school children
   (ages 9-12 years). We employed the participatory research methods
   community mapping and photovoice to enable children to reflect as a
   group upon their neighbourhoods, discuss their neighbourhoods' resources
   and problems, and develop ideas for a child-friendly neighbourhood.
   Additionally, the first author collected data in weekly participant
   observation (Nov. 2023-Feb. 2024). In data analysis, we followed a
   mostly inductive approach to reflexive thematic analysis and included
   participant validation. Overall, children perceive social interactions
   with neighbours to define their experience of growing up in a deprived
   neighbourhood rather than infrastructural aspects. Children identify
   conflicts with neighbours as well as noise by neighbours to be harmful
   to their health. Whereas good relationships with neighbours and quiet
   places are valued by children as beneficial. Lastly, we reflect
   children's understanding of nature to hold restorative potential for the
   health of children living in deprived neighbourhoods.},
