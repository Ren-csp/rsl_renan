@article{ WOS:000649064100001,
Author = {Collibee, Charlene and Fox, Kara and Folk, Johanna and Rizzo, Christie
   and Kemp, Kathleen and Tolou-Shams, Marina},
Title = {Dating Aggression among Court-Involved Adolescents: Prevalence, Offense
   Type, and Gender},
Journal = {JOURNAL OF INTERPERSONAL VIOLENCE},
