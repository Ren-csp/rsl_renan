@article{ WOS:001593291800001,
Author = {Davies, Rhoslyn and Font, Xavier and Jones, Christopher R. and Hehir,
   Christy},
Title = {Changed by nature: conceptualising a model of transformational travel
   through the lens of identity change},
Journal = {CURRENT ISSUES IN TOURISM},
Year = {2025},
Month = {2025 OCT 11},
Abstract = {As interest in travel's potential to create positive social and
   environmental change increases, this paper explores the potential of
   identity change as an additional conceptual lens through which to
   understand transformational travel experiences. Integrating established
   understanding of the importance of learning and reflection in
   transformational travel, with Identity Process Theory, this study's
   interdisciplinary approach offers a novel lens through which to examine
   the psychological processes determining transformation through travel.
   Using semi-structured interviews and a pluralistic approach to analysis,
   we explored travellers' perceptions and experiences of transformation.
   Combining inductive thematic analysis, Interpretive Phenomenological
   Analysis and deductive theory-driven analysis, we developed a layered
   understanding of the relationship between self-identity change and
   transformation within a wildlife travel context. The first two stages
   identified that changes in self-identity underpin perceptions of
   transformation, and that these changes are prompted by meaningful
   self-reflection and growth, dynamic self-discovery and social
   comparison. Lastly, by applying Identity Process Theory as the
   theoretical framework, we revealed the pivotal roles of distinctiveness,
   self-efficacy and purpose in driving transformation. Synthesising the
   findings from across the analyses, the paper concludes by proposing a
   model of transformation through identity change that offers new
   theoretical insights into the factors underpinning transformation
   through travel.},
