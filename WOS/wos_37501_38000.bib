@article{ WOS:001768445600001,
Author = {Dehghani, Maryam and Azad, Zahra and Erisian, Zohreh and Naeini, Ali
   Bonyadi and Naeini, Hassan Sadeghi and Rahmani, Amir},
Title = {Advancing sustainability through eco-design in the circular economy: A
   bibliometric analysis},
Journal = {CLEANER AND RESPONSIBLE CONSUMPTION},
Year = {2026},
Volume = {22},
Month = {AUG},
Abstract = {Product design has seen growing integration of the circular economy and
   eco-design, but there is not enough indepth research on their
   intersection. This paper aims to bridge this gap by examining the
   co-occurrence and relationship between the circular economy and
   eco-design in product design. Scopus was used as the data source, and
   VOSviewer and RStudio were used to create a bibliometric analysis. This
   study explores the evolving landscape of research in eco-design,
   circular economy, and sustainability, noting that since 2004, the number
   of publications in this field has increased in various countries, and
   China and the United States have had the most global collaboration in
   this area. Utilizing bibliometric and co-occurrence analyses, the eight
   thematic clusters found are based on end-to-end product development,
   sustainable production, design optimization, and lifecycle management.
   The study identifies a theoretical convergence between traditional
   eco-design concepts and emerging paradigms such as Industry 4.0,
   artificial intelligence, and the Internet of Things, indicating a shift
   toward digitally enabled circularity. This study emphasizes the
   convergence of environmental protection, industrial management, and
   computer-aided design to promote environmental innovations and
   sustainable practices. It also emphasizes the need for incorporating
   financial and technology components into eco-design strategies to evolve
   greener and more sustainable economic and production systems. Moreover,
   this study provides a guidebook for sustainable product design by
   converging circular economy ideas and technology.},
