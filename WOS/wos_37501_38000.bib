@article{ WOS:000389604900033,
Author = {Cadol, Daniel and Elmore, Andrew J. and Guinn, Steven M. and Engelhardt,
   Katharina A. M. and Sanders, Geoffrey},
Title = {Modeled Tradeoffs between Developed Land Protection and Tidal Habitat
   Maintenance during Rising Sea Levels},
Journal = {PLOS ONE},
Year = {2016},
Volume = {11},
Number = {10},
Month = {OCT 27},
Abstract = {Tidal habitats host a diversity of species and provide hydrological
   services such as shoreline protection and nutrient attenuation.
   Accretion of sediment and biomass enables tidal marshes and swamps to
   grow vertically, providing a degree of resilience to rising sea levels.
   Even if accelerating sea level rise overcomes this vertical resilience,
   tidal habitats have the potential to migrate inland as they continue to
   occupy land that falls within the new tide range elevations. The
   existence of developed land inland of tidal habitats, however, may
   prevent this migration as efforts are often made to dyke and protect
   developments. To test the importance of inland migration to maintaining
   tidal habitat abundance under a range of potential rates of sea level
   rise, we developed a spatially explicit elevation tracking and habitat
   switching model, dubbed the Marsh Accretion and Inundation Model (
   MAIM), which incorporates elevation-dependent net land surface elevation
   gain functions. We applied the model to the metropolitan Washington, DC
   region, finding that the abundance of small National Park Service units
   and other public open space along the tidal Potomac River system
   provides a refuge to which tidal habitats may retreat to maintain total
   habitat area even under moderate sea level rise scenarios (0.7 m and 1.1
   m rise by 2100). Under a severe sea level rise scenario associated with
   ice sheet collapse (1.7 m by 2100) habitat area is maintained only if no
   development is protected from rising water. If all existing development
   is protected, then 5\%, 10\%, and 40\% of the total tidal habitat area
   is lost by 2100 for the three sea level rise scenarios tested.},
