@article{auditoryfunctioninchildrenafte1978,
  author = {Bazarov V.G.; Radionenko L.I.},
  title = {{Auditory} function in children after generalized meningococcal infections},
  year = {1978},
  volume = {40},
  number = {1},
  abstract = {The authors present the results of audiometric examination of 327 children aged from 2 to 17 years who sustained meningococcus meningitis or meningoencephalitis in severe form, with the duration of the disease from one month to 4 years. Hearing function within the physiological standards was seen in 88% of cases; it was moderately disturbed in 6.4% of cases decreased perception of speech signals to 30 decibels); hearing impairment and deafness was revealed in 5.6% of the children. Hearing disturbances had no distinct association with the age of the children who had contracted meningococcus infection; these disturbances were mostly bilateral and coursed by the type of affection of the central sections of the sound analyzer. There was revealed dependence of the extent of hearing disturbances on the severity of the infectious process, timely character and the efficacy of treatment, concomitant affection of the central nervous system, association with the vestibular disturbances. The use of massive penicillin doses during the first days of the disease in combination with detoxication and dehydration therapy prevented in the majority of cases the affection of the organ of hearing and the nervous system during the residual period. It is concluded that the use of audiometry in the general complex of clinical examination of children with meningococus infection aids in control of the efficacy of treatment, detection of early signs of the auditory function disturbances and timely prescription of the required therapy.},
  issn = {424668},
}

@article{differentialthresholdofbandnoi1978,
  author = {Lymar Ya. B.; Butenko L.N.},
  title = {{Differential} threshold of band noise intensity in different forms of hypoacusis},
  year = {1978},
  volume = {38},
  number = {2},
  abstract = {The peculiarities of perception of band noise intensity minimal changes in different forms of hypoacusis were studied. It was shown that both in normal persons and in patients with otosclerosis and cochlear neuritis differential threshold (DT) of band noise intensity did not depend on the above-threshold level on which the measurement was done. DT decreased as noise band widened. The average value of noise DT in persons with normal hearing considerably differed from that of patients with hypoacusis while no significant difference between noise DT in separate diseases of the hearing organ was revealed. Noise DT was increased both in 'pure' affection of sound conducting apparatus in patients with otosclerosis and in cochlear neuritis with recruitment phenomenon. A conclusion was made that the character of change of band noise intensity differential threshold in hearing organ diseases differs from that of tone DT.},
  issn = {444650},
}

@article{residentialdensitysocialoverlo1978,
  author = {McCarthy D.; Saegert S.},
  title = {{Residential} density, social overload, and social withdrawal},
  year = {1978},
  volume = {6},
  number = {3},
  doi = {10.1007/BF00889026},
  abstract = {The effects of residential density were examined in the following study through a comparison of experiences of tenants living in 14-story apartment buildings and those in three-story walkups within the same low-income housing project. It was hypothesized that tenants in the high-rise buildings would come into contact with large numbers of others in the public spaces of their buildings. As these contacts exceeded residents' interaction capacity or ability to process relevant incoming social stimuli tenants would experience social overload. This experience would be manifested by tenants' perceptions of crowding in the building, feelings of less control, safety, and privacy in the immediate residential environment, problematic social relationships among tenants and alienation and dissatisfaction with the residential environment generally. These experiences were not expected to occur for tenants in the low-rise walkups. Interview data supported these hypotheses and revealed, in addition, that high-rise apartment residents were less socially active beyond their building and felt a greater sense of powerlessness in effecting management decisions. Correlational analyses provided further evidence of the vast differences between residents' experiences of the two building types. Â© 1978 Plenum Publishing Corporation.},
  publisher = {Kluwer Academic Publishers-Plenum Publishers},
  issn = {15729915},
  keywords = {crowding; residential density; social overload; urban environment},
}

@article{roleplayedbybinauralinterrupte1978,
  author = {Syargava V.A.; Siirde T.E.},
  title = {{Role} played by binaural interrupted speech audiometry in differential diagnosis of neurosensory hearing impairment},
  year = {1978},
  volume = {40},
  number = {2},
  abstract = {Apart from the routine audiometric studies (tone and speech audiometry) the authors used binaural interrupted speech audiometry test. Speech signal of the same degree of legibility was sent with interruptions, periodically, at intervals of 1/8 sec into one or the other ear. Of 160 persons examined 112 had neurosensory hearing impairment, 38 hearing disturbances of conductive type, and in 10 cases hearing was normal. Hearing impairment was bilateral in all the patients. In persons with normal hearing and in patients with the middle ear affection the binaural curve of the interrupted speech almost completely coincided with the monaural one. In neurosensory hearing impairment of peripheral character the binaural interrupted speech curve differed from the monaural one insignificantly. When in persons with neurosensory hearing impairment there was a central component of the auditory analyser disturbances (presbyacousis, posttraumatic lesion of the brain, etc) the curve of interrupted binaural speech discerning differed from the monaural one considerably). At the same time both the fall of the maximal degree of discerning in per cent (loss of discrimination) and reduction of discerning capacity was seen.},
  issn = {424668},
}

