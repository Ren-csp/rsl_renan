  author = {Lemogne C.; Ranque B.},
  title = {{Role} of psychological factors in {post-COVID-19} condition; {[RÃ´le} des facteurs psychologiques dans l'affection {post-COVID-19]}},
  year = {2023},
  volume = {207},
  number = {7},
  doi = {10.1016/j.banm.2023.05.001},
