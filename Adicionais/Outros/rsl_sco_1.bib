@article{thebodyimageanditsmodification1973,
  author = {Barbizet J.},
  title = {{The} body image and its modifications in patients with left sided hemiplegia; {[LA} {REPRESENTATION} {CEREBRALE} {DU} {CORPS,} {CE} {QU'ELLE} {DEVIENT} {CHEZ} {L'HEMIPLEGIQUE} {GAUCHE]}},
  year = {1973},
  volume = {49},
  number = {6},
  abstract = {It was found from comparison of anatomic and clinical data that the body image is inscribed and expressed in the cerebral cortex which has different areas for perception of posture, speech, behavior and relations. Clinical data indicate the importance of the right temporo parieto occipital junction in the image of the body posture. Innumerable imprints of corporeal and visual perceptions acquired since infancy and continuously reinforced by the daily use of one's usual movements are apparently elaborated and retained at this junction. The experience of the body quite understandably extends into other extracorporeal experiences which bring it into contact with surrounding objects and spaces recognized by manipulation, visual exploration and body movements. Destruction of the left temporo parietal cortex affects, besides other types of verbal knowledge, verbal representation of different parts of the body, of various abilities and of movements. There is no evidence that Gerstmann's syndrome exists as a separate entity, because its signs usually occur together with other disorders of denomination and because it never occurs alone in aphasic patients. Imprints of personal experiences are situated in the frontal lobes. They serve as schemes of present behavior based on previous experiences. These frontal schemes of the body image are numerous and diverse, and they adjust one's activity according to the real situation. In frontal lobe affections the chain of actions necessary for efficient behavior is destroyed and a so called 'apraxia of ideas' is produced. The authors prefer to call it 'deficiency of praxognostic behavior' by analogy with deficiency of verbal behavior usually found in this condition. The left hemisphere and frontal lobes also contain other aspects of the body image such as one's own body image, body image of others and the body image of one's own body in numerous relations to bodies of others. They also contain imprints of experience of abnormal relations of the body which produce so many signs in psychoses and neuroses.},
  issn = {200204},
}

@article{relationshippatternsinselfanal1973,
  author = {Gibbard G.S.; Hartman J.J.},
  title = {{Relationship} patterns in selfâanalytic groups: {A} clinical and empirical study},
  year = {1973},
  volume = {18},
  number = {5},
  doi = {10.1002/bs.3830180503},
  abstract = {The development of an actâbyâact scoring system, process analysis, is presented. An extension of Mann's memberâleader system, this scheme reflects the influence of both psychoanalytic and interpersonal theorists and relies heavily on clinical inference. Several measures of interscorer agreement are reported. Two selfâanalytic classroom groups, 40 sessions in duration, are scored and studied in some detail. Data from the groups are combined, and separate factor analyses of memberâleader and memberâmember interaction are presented. An intensive clinical and statistical assessment of the two factor structures is undertaken. A comparison of these findings with those of other studies of small experiential groups suggests that three bipolar dimensions characterize memberâleader relations in such groups: loyalty vs. rebellion; personal involvement vs. neutrality; and a third dimension, more difficult to define, represented in this study by a dimension titled selfâabsorption vs. ambivalent compliance. Two bipolar dimensions emerged from the analysis of memberâmember interaction: expression of hostility vs. suppression of hostility and expression of affection vs. suppression of affection. Some differences between this and previous findings are noted. Finally, the strengths, potential, and shortcomings of this research strategy are discussed. The authors conclude that despite the scope, depth, and flexibility of this style of clinical and statistical investigation such research must begin to move toward simpler, more systematic, and less idiosyncratic studies. Copyright Â© 1973 John Wiley \& Sons, Ltd.},
  issn = {57940},
}

@article{perceptionsofchildhoodpresentf1973,
  author = {Linn M.W.},
  title = {{Perceptions} of childhood: present functioning and past events},
  year = {1973},
  volume = {28},
  number = {2},
  doi = {10.1093/geronj/28.2.202},
  abstract = {One hundred males aged 65 to 92 were interviewed by one researcher who encouraged them to reminisce about childhood and to assess their childhood as predominantly happy or unhappy. In addition, ordinal position, family size, rural or urban environment, and education were collected. Subjects were then seen by two other researchers, who dealt only with current functioning rated on a 21 item Social Dysfunction Rating Scale. Differences in functioning between the happy and unhappy groups were highly significant (Multivariate  p<.004). There were no differences in age, birth order, or education between the groups; however, subjects with happy childhood had more siblings and were reared in a rural setting (p<.05). Correlations between childhood variables and later functioning were low and few. Lower education correlated with more areas of dysfunctioning than any other variable. Contrary to other findings, large family size and rural setting in early life related to happy memories and better over all adjustment.},
  issn = {221422},
}

@article{differentialmarriageandfamilyp1973,
  author = {Snow C.},
  title = {{Differential} marriage and family perceptions and attitudes of adolescents living in child care institutions and adolescents living in intact families},
  year = {1973},
  volume = {8},
  number = {31},
  abstract = {The overall conclusion of this investigation is that, in some respects, the outcome of the process of socialization for marriage and parenthood is different for adolescents who live in an institutional setting and adolescents who live in an intact family. This study revealed notable differences with respect to marriage role expectations, marriage attitudes, and perceptions of family democracy, cooperation, and affection. However, sufficient information was not obtained to determine to what extent the differences result rom the experience of institutional living and/or experiences related to family history prior to institutionalization. Additional information is needed relative to the sources of the differences revealed in this study.},
  issn = {18449},
}

@article{importanceoflaterometryforeval1973,
  author = {Beran M.},
  title = {{Importance} of laterometry for evaluation of the cochlear reserve in otosclerosis; {[VYZNAM} {LATEROMETRIE} {PRO} {POSOUZENI} {KOCHLEARNI} {REZERVY} {U} {OTOSKLEROZ]}},
  year = {1973},
  volume = {22},
  number = {4},
  abstract = {Laterometry in otosclerosis is a sensitive method for determining even a small degree of cochlear affection. In cases of otosclerosis with decreased osseous conduction, the width of the laterogram and its flattening enable us to estimate the changed degree of loudness and so a cochlear affection. In cases of laterogram not showing changes characteristic of cochlear affection, the loss in osseous conduction is intrinsic, and operation is followed by improvement.},
  issn = {90809},
}

@article{someeconomicspatialsocialandpo1973,
  author = {Rapkin C.},
  title = {{Some} economic, spatial, social and political indicators of environmental quality of urban life},
  year = {1973},
  doi = {10.1007/978-1-4899-0330-3_61},
  abstract = {At this point in the development of urban indicators, it is still too early to expect an aggregate measure of urban environmental quality. In former years, social scientists were eager to develop the aggregate entity which is now known as national income, so that a summary statistical measure of the economy would be available. Only after this achievement was accomplished did we realize that the most useful part of the national income accounts were its components. Readings on the changes in the status of important industries and in the components of consumer expenditures became crucial indicators for policymakers. Similarly, with social indicators we should not be too frustrated by the great difficulty in arriving at an aggregate figure. Some of the measures proposed in this paper have already begun to show whether given sectors of the urban environment are meeting current social needs, or whether they are past the possibility of adapting to emerging life styles. As one example, simple figures showing whether size and type of households are coordinated with the characteristics of the standing stock of dwelling units can offer an early warning of growing need for investment in housing. In terms of the perceptions to be gained through social reporting, the sum of the parts is clearly much greater than the whole.},
}

