@article{theassemblinggamesinthepolices2021,
  author = {De Andrade F.},
  title = {{The} {Assembling} {Games} in the {Polices's} {Practiceslike} {Mechanisms} to {Frame} the {Feminine} {Narrativesin} {Crimes} under {Law} {Maria} da {Penha;} {[Entre} o domÃ©stico, o familiare o gÃªnero: {Os} "jogos de {Armar"no} fazer policial como mecanismos para enquadrar narrativas femininas em crimes de violÃªncia previstosna {Lei} {Maria} da {Penha]}},
