@article{theperipheralnervefunctioninch1974,
  author = {Nielsen V.K.},
  title = {{The} peripheral nerve function in chronic renal failure: a survey},
  year = {1974},
  volume = {196},
  number = {sup 573},
  abstract = {The general picture of the peripheral nerve dysfunction in chronic renal failure is very complicated and includes several conflicting aspects. This is probably a reflection of the true nature of the disorder and only in part due to insufficient observations. It is at present premature to formulate any definitive general concepts of the neuropathy, since too many important details await further exploration. As a temporary conclusion, an interaction between degenerative nerve lesions and impaired axon membrane function seems to fit in reasonably well with the observations at hand. Furthermore, this conclusion seems well suited as a working hypothesis for future research, as it expresses an open attitude towards the different pathophysiological concepts advanced. The present study has provided conclusive evidence in favor of the following statements: peripheral neuropathy is an integral part of the uremic syndrome. The clinical picture has no features specific to CRF. Sensory motor disturbances are predominantly localized to the distal part of the legs. Impaired nerve conduction is the most sensitive indicator of peripheral nerve dysfunction. CRF is accompanied by a generalized slowing of the sensory and motor nerve conduction velocity, which affects patients in general in the terminal stage of uremia. The development and severity of clinical and electrophysiological findings are related to the kidney function, but not to the degree of azotemia, when expressed by the conventionally used 'indicators', urea and creatinine. The frequency of neurological findings is greater in males than in females. There is a dissociation between clinical and electrophysiological findings, which concerns the frequency, the distribution, and the severity of the affection as well as the course during progressive CRF and following intermittent dialysis and renal transplantation. Serial measurements of the vibratory perception threshold on the big toe and the malleolus proved to be a valuable and easily applied indicator of the course of the neuropathy, and is recommended as a routine method in clinical practice. Short lasting intermittent dialysis (mth) results in a remission of mild to moderate clinical findings, while nerve conduction is unchanged. A successful renal transplantation is accompanied by a marked improvement of clinical and electrophysiological abnormalities. The remission of the peripheral nerve dysfunction is 2 phasic with an early, rapid and a late, slow phase. Reestablishment of a normal kidney function leads to complete recovery of the nerve function in the majority of patients within the first yr. Late sequelae becomes demarcated about 6 mth. The present study has provided suggestive evidence in favor of the following statements: the pathogenetic factor(s) in the development of uremic nerve lesions should be sought in the retention of molecules of a higher molecular wt than e.g. urea and creatinine. Nerve lesions in uremic patients are of a dual nature comprising 2 components: an ascending segmental demyelination and axonal degeneration localized primarily to distal nerve segments of the lower extremity and slowly reversible following restoration of a normal kidney function. A toxic inhibition of the nerve axon membrane function being of a generalized nature and more rapidly reversible following restoration of normal kidney function. The toxic impairment of the axon membrane function in uremic nerve implies that the nervous impulse becomes propagated with decrement.},
  issn = {16101},
}

