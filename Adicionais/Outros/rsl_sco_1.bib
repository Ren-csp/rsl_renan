  volume = {2370 CCIS},
  abstract = {The proceedings contain 61 papers. The special focus in this conference is on Computer-Human Interaction Research and Applications. The topics include: How Different Blink Patterns of Pet Robots Evoke Feelings of Affection in People; arm in Motion: How Motion Modality and Erratic Behavior of a Robotic Arm Shape User Perception; An Examination ofÂ Pre-school Childrenâs Usage Behavior ofÂ Augmented Reality: Traditional vs. AR-Assisted LEGOÂ® Building; Interviewing ChatGPT-Generated Personas toÂ Inform Design Decisions; an Experiment to Investigate Changes in Physiological Signals During Subtle Wind and Scent Presentation for Designing Subtle Notifications; Towards Multi-stakeholder Evaluation ofÂ ML Models: A Crowdsourcing Study onÂ Metric Preferences inÂ Job-Matching System; current Design Practices in Applied Augmented Reality Research: A Methodological Review; emotion-Aware Interfaces: Empirical Methods forÂ Adaptive User Interface; bridging Medical Genetics, Genetic Counselling, and Patients: Proposing an Immersive, Interactive, and Holographic Health Information Platform with Evaluation Methods for Personalized Patient Education; why Do(nât) You Trust Us? Highlighting theÂ Importance ofÂ Trust andÂ Transparency forÂ Designing B2B Platforms inÂ Electronics Manufacturing; enriched with Behaviour Theory Topic Guide Template for Digital Behaviour Change Interventions; evaluating Remote Communication Applications Using Student Usability Reviews; Enhancing EEG-Based User Verification withÂ aÂ Normalized Neural Network Ensemble Approach; systematic Literature Review of Gamification Design in Higher Education Programming Courses: Methodological Rigor Exposed; the Effect ofÂ Progressive Disclosure inÂ theÂ Transparency ofÂ Large Language Models; design andÂ Implementation ofÂ aÂ Practice Record Visualization System Using Piano Performance Tracking Technology; User Issues andÂ Concerns inÂ Generative AI: A Mixed-Methods Analysis ofÂ App Reviews; Caregiver Acceptability ofÂ anÂ LLM-Powered Assistant Interface toÂ Improve Sleep Quality ofÂ theÂ Elderly; user Experience andÂ Information Security Heuristics forÂ Digital Identity Wallets; how Can Heuristics Be Communicated?.},
