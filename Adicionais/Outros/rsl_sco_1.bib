@article{aneuropsychologicalbatteryfore1978,
  author = {Dodrill C.B.},
  title = {{A} {Neuropsychological} {Battery} for {Epilepsy}},
  year = {1978},
  volume = {19},
  number = {6},
  doi = {10.1111/j.1528-1157.1978.tb05041.x},
  abstract = {The development of the Neuropsychological Battery for Epilepsy is presented. The tests are designed to be helpful in the evaluation of adult epileptics. The battery consists of General Measures which include tests in the areas of intellectual functioning, emotional status, and lateral dominance. The development of a series of 16 Discriminative Measures is presented in detail through the discussion of a pilot study, the principal investigation, and a crossâvalidaâtional effort. In the principal study, 50 epileptics were individually paired with individuals having no history of neurological disease, and their performances on a wide range of ability measures were compared. Tests were eliminated if they did not appear sensitive to the brainârelated problems of epileptics, if they demonstrated excessive duplication with other measures, or if they did not crossâvalidate with a new sample of 25 epilepticânormal pairs. The advantages of the battery were discussed, including coverage of areas previously not adequately assessed, elimination of tests with limited utility, greater uniformity and accuracy in the classification of individual subjects, and standardization of the tests with epileptics. La crÃ©ation d'une Batterie Neuropsychologique pour l'Epilepsie est prÃ©sentÃ©e. Les tests sont proposÃ©s pour aider Ã  l'Ã©valuation des adultes Ã©pileptiques. La batterie consiste en mesures d'ordre gÃ©nÃ©ral qui comportent des tests Ã©valuant les fonctions intellectuelles, l'Ã©tat Ã©motionnel, et le cÃ´Ã© dominant. La rÃ©alisation d'une sÃ©rie de 16 mesures d'ordre discriminatif est prÃ©sentÃ©e en dÃ©tail Ã  travers la discussion d'une Ã©tude pilote, constituant la recherche essentielle, et Ã  travers une Ã©tude de validation croisÃ©es. Dans l'Ã©tude principale, 50 Ã©pileptiques sont associÃ©s avec autant d'individus n'ayant aucun antÃ©cÃ©dent d'affection neurologique, et leurs performances sont compareÃ©es Ã  propos d'un large Ã©chantillon de test de mesures. Les tests Ã©taient Ã©liminÃ©s lorsqu'ils n'apparaissaient pas sensibles aux problÃ¨mes liÃ©s Ã  l'atteinte cÃ©rÃ©brale des Ã©pileptiques, lorsqu'ils s'avÃ©raient faire double emploi avec d'autres tests de mesure, ou lorsqu'ils n'avaient pas de valeur croisÃ©e avec un nouvel Ã©chantillonnage de 25 paires de sujets Ã©pileptiques et normaux. Les avantages de la batterie sont discutÃ©s, entre autres en ce qui concerne des domaines qui jusqu'ici n'avaient pas Ã©tÃ© abordÃ©s de faÃ§on adÃ©quate, en ce qui concerne (1) l'Ã©limination de tests d'une utilityÃ© limitÃ©e, (2) la plus grande uniformitÃ© et prÃ©cision dans le classement des individus, et (3) la standardisation des tests pour les Ã©pileptiques. Se presenta el diseÃ±o de una BaterÃ­a NeuropsicolÃ³gica para Epilepsia. Estos tests se han disenÌado para que sean Ãºtiles en la evaluaciÃ³n de epilÃ©pticos adultos. La baterÃ­a consiste en Medidas Generates que incluyen tests en Ã reas de funciÃ³n intelectual, estado emocional y dominancia lateral. El desarrollo de una serie de 16 Medidas Discriminativas se presenta en detalle durante la discusiÃ³n del estudio piloto, la investigaciÃ³n principal y el esfuerzo de la validaciÃ³n cruzada. En el estudio principal 50 epilÃ©pticos han sido emparejados individualmente con individuos que no tenÃ­an historia de enfermedades neurolÃ³gicas, compareÃ¡ndose sus performances en un amplio margen de medidas de sus habilidades. Se eliminaron los tests que no parecÃ­an analizar los problemas de los epilÃ©pticos relacionados con el cerebro, los que demostraron una duplicaciÃ³n excesiva con otras medidas o los que no mostraban validaciÃ³n cruzada con una neuva muestra de 25 parejas de epilÃ©pticosânormales. Se discuten las ventajas de la baterÃ­a incluyendo la covertura de Ã¡reas no valoradas previamente de manera adecuada, la eliminaciÃ³n de los tests con utilidad limitada, la gran uniformidad y exactitud en la clasificaciÃ³n de los individuos y la estandarizaciÃ³n de los tests con epilÃ©pticos. Die Entwicklung einer neuropsychologischen Testreihe fÃ¼r Epileptiker wird vorgestellt. Die Tests sind als Hilfe bei der Untersuchung erwachsener Epileptiker vorgesehen. Die Reihe besteht aus allgemeinen MeÃverfahren, die Tests auf den Gebieten der Intelligenzfunktion, der emotionalen Lage und der Seitendominanz beeinhalten. Die Entwicklung einer Reihe von 16 diskriminativen MeÃverfahren wird im einzelnen vorgestellt durch Diskussion einer Voruntersuchung, der Hauptstudie und einer Kreuzvalidisierung. In der Hauptstudie wurden 50 Epileptiker jeweils einzeln Personen ohne Vorgeschichte einer neurologischen Erkrankung gegenÃ¼bergestellt. Ihre Leistungen in einem weiten Rahmen von FÃ¤higkeitsmessungen wurden verglichen. Tests, die nicht die hirnfunktionsbezogenen Probleme der Epileptiker erfaÃten, die Ã¼berflÃ¼ssige Ãberschneidungen mit anderen Untersuchungen zeigten, oder die mit einer neuen Gruppe von 25 Epileptikern und Normalpersonen keine KreuzvaliditÃ¤t erbrachten, wurden eliminiert. Diskutiert werden die Vorteile der Testreihe einschlieÃlich der Erfassung von Gebieten, die zuvor nicht ausreichend untersucht waren, des Ausschlusses von Tests mit begrenzter Nutzbarkeit, der grÃ¶Ãeren Einheitlichkeit und Genauigkeit in der Klassifizierung der einzelnen Person und der Standardisierung der Tests an Epileptikern. Copyright Â© 1978, Wiley Blackwell. All rights reserved},
  issn = {139580},
  keywords = {Brain impairment; Epilepsy; Neuropsychology; Psychological testing},
}

@article{thetradeoffbetweendensityandot1978,
  author = {Borukhov E.},
  title = {{The} trade-off between density and other objectives: {A} re-examination of planning norms},
  year = {1978},
  volume = {2},
  number = {1},
  doi = {10.1007/BF00212580},
  abstract = {Residential density (dwelling units per area) affects the quality of life in urban environments in many direct and indirect ways. Determining the optimal level of density requires in each case, balancing all the relevant factors and influences, and should depend on the preferences of the potential residents and their financial resources. A residential neighborhood has many characteristics. Usually people trade off one characteristic against another. For instance: people can trade off density against cost or accessibility against space. The aim of good planning is to find the combination of characteristics that will give maximum level of satisfaction to the residents of a neighbourhood subject to the limitations of their budgets. Density standards should, therefore, be adapted to the preferences of the potential residents and their preferred compromise between the various attributes of their environment. To make things more complicated, the concept of density has many definitions, and different definitions are relevant when analysing the various effects of density. It seems that people do not perceive the gross residential density as it is measured, but are influenced by variables such as set-back distances, the percentage of building coverage and the like. Evidence is cited from an investigation in Kiryat-Gat which suggests that the perception of density is affected by other factors except the density itself. If people do not perceive the density as such but are affected by other factors, then modification of these factors is very important. If planners are to design neighborhoods according to the residents' preferences, they should have quantitative estimates of the residents' relative evaluation of these characteristics, including possible savings in the price of housing. The problems of investigating residential preferences are discussed, and examples of studies addressed to these questions are described. Â© 1978 Akademische Verlagsgesellschaft.},
  publisher = {Kluwer Academic Publishers},
  issn = {15729893},
}

@article{rationaluseofphysicalmedicinei1978,
  author = {Franchimont P.},
  title = {{Rational} use of physical medicine in rheumatology; {[REFLEXIONS} {SUR} {L'UTILISATION} {RATIONNELLE} {DE} {LA} {MEDECINE} {PHYSIQUE} {EN} {RHUMATOLOGIE]}},
  year = {1978},
  volume = {33},
  number = {23},
  abstract = {Physical means set into action a series of physiological reactions that are capable of combatting certain clinical manifestations of oesteo-articular affections: pain, muscular contracture, malpositions and losses of functions. The principal physiopathological bases of the use of physical methods of treatment are: the abolition of the medullary conduction of the painful influx and the central perception by activation of the morphinic receptors; the increase of the local circulation; muscle relaxation; the activation of bone, muscle and cartilage functions by movement; hypophyseal stimulation with liberation of ACTH, and, as a consequence, of cortisol, growth hormone and of endorphines; inhibition of the secretion of antidiuretic hormone. 2 Affections that are frequent in rheumatology are described, namely, the tendomyoses and the algodystrophies and these serve to illustrate the importance of the physical treatments.},
  issn = {353663},
}

@article{otoneurologicalsymptomatologyi1977,
  author = {Melnichuk P.V.; Levshova A.S.; Kogan E.I.},
  title = {{Otoneurological} symptomatology in the clinical picture of subacute leuko- and panencephalitis},
  year = {1977},
  volume = {39},
  number = {5},
  abstract = {At present otoneurological examination occupies a stable position in the complex examination of neurosurgical patients, and acquires ever greater significance in neurological practice as one of the auxiliary diagnostic methods. A total of 21 patients with acute leuko- and panencephalitis, aged from 7 to 52 years, were examined otoneurologically. In 3 cases the diagnosis was verified during autopsy, and in one during the operation; in 14 cases an additional contrast neurosurgical examination (carotid angiography - in 12, pneumoencephalography - in 6, and pneumoventriculography - in 3) was conducted. Vestibular disturbances, among which particular attention should be paid to otokinetic nystagmus, were the most frequent and constant otoneurological symptoms; disturbances in the mechanism of the experimental vestibular reactions were less frequent. Hearing impairment of the character of sensory-neural deafness, and laryngeal-pharyngeal disturbances were more seldom noted in patients with coarse affection of the brain stem, which could be expressed as affection of the nuclei of the IX-X cranial nerves and of their involvement at the supranuclear level. The data obtained suggest that otoneurological examination aids early diagnosis of such severe progressive diseases of the nervous system as Schindler's leukoencephalopathy and van Bogaert's disease.},
  issn = {424668},
}

@article{acaseofinfantiledepressioninas1977,
  author = {Cocchi R.; Viarengo E.},
  title = {{A} case of infantile depression in a subject suffering from facial naevus flammeus and mental retardation; {[UN} {CASO} {DI} {DEPRESSIONE} {INFANTILE} {IN} {SOGGETTO} {CON} {NEVO} {FLAMMEO} {AL} {VISO} {E} {RITARDATO} {SVILUPPO} {MENTALE]}},
  year = {1977},
  volume = {90},
  number = {3},
  abstract = {A 6-year-old child with facial naevus flammeus and affected with immaturity, mental retardation and perception, motivity and speech disorders, was treated by antidepressant-anxiolytic therapy (l-glutamine + diazepam) and cosmetic correction of dermatological affection. Owing to such treatment, mental age rapidly became normal as well perception and motivity; later on the authors had an equal improvement in school performance and in social adaptation. Stress is laid on the succesful results obtained with antidepressant anxiolytic therapy both in this case and in other cases of false mental retardation.},
  issn = {34606},
}

@article{brainlobesyndromesiitheoccipit1977,
  author = {Hrbek J.},
  title = {{Brain} lobe syndromes. {II.} {The} occipital lobe syndromes},
  year = {1977},
  volume = {Vol.77},
  abstract = {The occipital lobe is the smallest of the brain lobes and functionally the most homogeneous one. Its anatomical structure, inner subdivision of its only functional system, the cortical field of the optical analyzer (areas 17, 18, part of area 19), and its connections are described. The symptomatology of destruction lesions and pathophysiological interpretation are discussed under the following headings: Alexia. Optical disorders of other semiotic systems. Agnosia of colors. Other optical agnosias. Constructional (optical) apraxia, or apractognosia. Optical ataxia. Disorders of gaze control. Balint's syndrome. Dynamic disorders of optical perception. Cerebral asthenopia. Optical illusions. Loss of vision in a part of the visual field. Scotoma. Homonymous contralateral quadrant hemianopsia (anopsia). Crossed quadrant hemianopsia (anopsia). Horizontal hemianopsia. Homonymous contralateral hemianopsia. Sparing of macular vision in homonymous hemianopsia. Critical review of opinions. New interpretations by V. Hrbek (1974). Achromatopsia, dyschromatopsia. Visual inattentiveness in a half of the visual field. Dissociation of optical perception in hemianopsia. Bilateral homonymous hemianopsia (socalled cerebral blindness). Cortical blindness (caecitas corticalis). Differences between occipital lobe affection in the dominant and nondominant hemisphere. The irritational syndromes and paroxysmal disorders are described under the following headings: True visual hallucinations. Pseudohallucinations (illusions). Elementary irritational phenomena. Paroxysmal migraine disorders. Auras of epileptic fits. Postparoxysmal visual disorders. Photogenic epilepsies.},
  issn = {3012514},
}

@article{theroleofexcessivedrinkinginal1977,
  author = {Orford J.; Oppenheimer E.; Egert S.; Hensman C.},
  title = {{The} role of excessive drinking in alcoholism complicated marriages: {A} study of stability and change {Over} a one-year period},
  year = {1977},
  volume = {12},
  number = {4},
  doi = {10.3109/10826087709027238},
  abstract = {Study of covariation of changes in drinking habits and changes within a marriage is crucial for an understanding of the role of excessive drinking in alcoholism-complicated marriages. In this study, after a year during which excessive drinking had been drastically reduced by a proportion of husbands, drinking changes were associated with an increase in husband to wife affection, some increase in wife to husband affection and husband task involvement, but with no change in favorability of wife perception of husband. A high level of stability was evident, from beginning to end of the year, on all measures. Neither a personal condition model nor an interactional model of excessive drinking and marriage can account for the facts. Â© 1977 Informa UK Ltd All rights reserved: reproduction in whole or part not permitted.},
  publisher = {Informa Healthcare},
  issn = {10826084},
}

@article{neighborhoodtypesocialdisequil1977,
  author = {Wenz F.V.},
  title = {{Neighborhood} type, social disequilibrium, and happiness},
  year = {1977},
  volume = {49},
  number = {3},
  doi = {10.1007/BF01115314},
  abstract = {This study attempts to relate (a) types of urban neighborhoods with extreme scores on the economic status dimension and rates of social and psychological disequilibrium to happiness of its residents, and (b) both aggregate and individual measures of economic status to happiness. Nonverbal behaviors such as suicide, attempted suicide, homicide, marital separation, and psychiatric disruptions served as indicators of the location of "more or less" happiness in the urban environment. Interviews in two types of neighborhoods revealed that people in the high economic-low misery neighborhood experienced greater happiness than those living in the low economic-high misery neighborhood. Â© 1977 Human Sciences Press.},
  publisher = {Kluwer Academic Publishers-Human Sciences Press},
  issn = {15736709},
}

@article{changesofthesoundlateralizatio1977,
  author = {Ryndina A.M.; Levina E.V.},
  title = {{Changes} of the sound lateralization threshold angle in the pathology of sound conduction},
  year = {1977},
  volume = {39},
  number = {5},
  abstract = {An attempt was made to qualitatively assess the changes in sound localization function in disturbances of the sound conduction system; for this purpose the concept of the sound lateralization threshold angle is introduced. A comparative study of the threshold lateralization angles in healthy persons (100), persons with uni- and bilateral sound conduction derangement (42), and patients with hearing impairment by the conductive types was made. It was demonstrated that the sound lateralization threshold angle increased in the presence of sound conduction disturbances, particularly at low frequencies. As revealed in persons with uni- and bilateral sound conduction derangement and in patients with disturbed sound conduction, an increase of the lateralization thresholds was the more - the greater the functional asymmetry of the ears. It can be supposed that functional reconstruction in the cortical portion of the analyzer served as a sequence of the peripheral affections in the sound conduction system, this leading to disturbed perception of the sound image localization.},
  issn = {424668},
}

