}

@article{internationalconferenceonurban2024,
  title = {{International} {Conference} on {Urban} {Infrastructure} {Sustainable} {Development} and {Renovation}},
  year = {2024},
  volume = {1376},
  number = {1},
  abstract = {The proceedings contain 48 papers. The topics discussed include: analysis of local resources for the formation of modern public commercial centers on the material of Kharkiv; assessment of recreational activities and greening of urban-parks in Kharkiv; development of the public space of a mono-functional town (on the example of the town of Novoyavorivsk, Ukraine); methodological frameworks for street and road environment improvement with due regard to inclusion requirements; modelling of steel concrete composite elements cross-sections with adhesive connections; modern trends in the creation of luminescent silicate ceramic and glass materials for industry and technology; perception of park environment and its impact on aesthetic evaluation; and basics of the advanced calculating method the fire resistance of the section of an eccentrically compressed reinforced concrete element.},
