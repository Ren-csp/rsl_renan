  author = {Axpe I.; FernÃ¡ndez-Zabala A.; GoÃ±i E.; Ramos-DÃ­az E.},
  title = {{Paternal} and maternal socialization perception on adolescent resilience.; {[La} percepciÃ³n de la socializaciÃ³n paterna y materna sobre la resiliencia de adolescentes]},
  year = {2023},
