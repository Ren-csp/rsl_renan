@article{sketchinganatureaestheticofthe1990,
  author = {Nohl W.},
  title = {{Sketching} a nature aesthetic of the city; {[Gedankenskizze} einer {Naturasthetik} der {Stadt]}},
  year = {1990},
  volume = {22},
  number = {2},
  abstract = {In this outline of a new nature aesthetic for our cities the often strained relationship of man to nature, and with it, the difficult relationship of man to his fellowman is not overlooked. An attempt is made to substantiate this nature aesthetic by drawing on the Aristotelian theory of mimesis. It proves that with regard to its use as well as its appearance the new preferential nature of open spaces possesses some similarity to abandoned areas in cities. Though such areas can only have model character, under present circumstances they may explain best that man needs the aesthetic experience of the co- and self-productivity of nature, to surpass the present suffering from progress and to get an idea of the happiness of a world of human dignity. -from English summary},
}

@article{publicvalueorientationstowardu1989,
  author = {Simcox D.E.; Zube E.H.},
  title = {{Public} value orientations toward urban riparian landscapes},
  year = {1989},
  volume = {2},
  number = {1},
  doi = {10.1080/08941928909380687},
  abstract = {The article investigates public value orientations associated with the urban riparian landscape of Tucson, Arizona. Survey questionnaire and photographic landscape assessment methods were used to measure riparian area residentsâ perceptions of change, existing conditions, and scenic quality and their attitudes toward planning, management, and land use in the study area. Findings revealed positive value orientations toward preservation of noncommodity amenities including wildlife habitat, riparian vegetation, open space, and scenic landscapes. Although preservation values are strong, residents perceive the landscape as undergoing change. Encroachment of urban development into natural settings is weakening open space values and fostering attitudes that are tolerant of increased development. Findings suggest that preservation of noncommodity landscape amenities may be impossible once urban development begins. Â© 1989 Taylor \& Francis Group, LLC.},
  issn = {8941920},
  keywords = {Human influences; Landscape management; Landscape perceptions; Landscape planning; Photosimulation; Public values; Riparian landscapes; Scenic beauty},
}

@article{schizoidpersonalitydisorderara1989,
  author = {Costello R.M.},
  title = {{Schizoid} personality disorder: {A} rare type in alcoholic populations},
  year = {1989},
  volume = {3},
  number = {4},
  doi = {10.1521/pedi.1989.3.4.321},
  abstract = {This case is exemplary in allowing a differentiation along psychometric lines of a rare personality type among individuals sharing a common denominator of abusive alcohol drinking that obscures meaningful individual differences. Once set apart diagnostically from his peers, differences along behavioral variables became manifest and could be magnified as if under a microscope to bring them into sharper theoretical focus. The 'as if,' 'anesthetized' quality of this man's interpersonal interactions may have otherwise been overlooked as mere 'alcoholic' resistance, denial, or uncooperativeness; depressive apathy; or retardation or physical lethargy secondary to medical problems. On closer inspection, the adaptive quality of the detached, asocial behavior was observed to be a life-style variable encompassing action, perception, affection, and volition, including response to treatment efforts. What 'worked' with this man to achieve sobriety for 300 of 303 weeks was a pattern of diffuse interpersonal relationships defined around his commitment to take Antabuse, administered one tablet at a time, with a benign and subtle congratulatory affirmation of his commitment to maintain his physical health. Talking, in a prolonged, intimate social relationship, was not found to be of help and may even have been an irritant to his adaptational style. His psychometric performance (i.e., 16PF) before treatment, when understood as a manifestation of the personality type in question, is prognostic of the quality of his relationships to be expected with the treatment team. His Rorschach protocol-specifically the content of angry, arguing cockroaches in a context bereft of other meaningful human dialogue-also gave a clue as to the necessity to maintain considerable interpersonal treatment distance to avoid the inevitable parataxic distortions that would have undermined his treatment response. How this man was transformed from an angry 10-year-old boy to a 'schizoid' adult, we may never know. Affect, felt and expressed, clearly became an aversive event that he eschewed however he could, whether the means were 'unconscious' (e.g., dissociation) or not. (e.g., suppression). His value as a teacher for us was to demonstrate that the matching of people to treatments is a subtle business and that diagnostic insight into personality structure is sometimes helpful.},
  issn = {0885579X},
}

@article{thedevelopmentofoccupationalpe1989,
  author = {MarkovÃ¡ M.},
  title = {{The} development of occupational perceptual deafness in blacksmiths; {[VÃ½voj} profesionÃ¡lnÃ­ percepcnÃ­ nedoslÃ½chavosti u profese kovÃ¡r.]},
  year = {1989},
  volume = {38},
  number = {1},
  abstract = {Analysis of hearing of 140 blacksmiths from three workships (280 ears) revealed considerable differences in the development of occupational perception deafness between different individuals and also as regard the affection of the right and left ear. The author worked out the decibel increment and average audiogram after 40 years exposure to noise after dividing the aers into five groups with regard to the affection on the main four frequencies. In the majority of ears the audiometric curve is not higher than 60 dB which is due to the numerical atrophy of the external ciliated cells. A drop of the audiometric curve below 60 dB was recorded in 13 ears (4.6%); in the group during the subsequent development of deafness a decline of the audiometric curve was recorded also at lower frequencies which suggests affection of the inner ciliated cells in the course of development of progressive necrosis. For investigation of hearing during preventive examinations ensues that occupational deafness develops after a prolonged period of exposure to noise typically at a frequency of 4 kHz to 60 dB on the audiogram. A drop of the audiometric curve below 60 dB in the area of a frequency of 4 kHz and concurrently below 20 dB at lower frequencies means that the hearing of the person is threatened due to overexposure.},
  issn = {90603},
}

@article{thecontributionofopenspacestot1989,
  author = {Amir S.; Cafri-Cohen O.},
  title = {{The} contribution of open spaces to the physical image of an agricultural village},
  year = {1989},
  volume = {17},
  number = {4},
  doi = {10.1016/0169-2046(89)90088-1},
  abstract = {This paper reports on empirical research conducted in a semi-cooperative village, Nahalal, Israel, where an investigation was made of the relationship between the physical characteristics of open spaces in the village and their contribution to the positive image of the village. The 94 persons, who were surveyed at home, provided the data for testing. Several hypotheses were proposed concerning the relationships between the level of contribution to the image of the village open space and their landscape type, the quality of their maintenance and the facilities on the site. The findings did show a close relationship between various open spaces, their level of maintenance or facilities and their contribution to the physical image of the village. The relationships indicate that "urban" and "green" open spaces with well-maintained and highly developed facilities were found to be greater contributors to the image of the village over "rural" and "agricultural" or less developed open spaces. The findings are in correlation with existing socio-economic trends occurring in the rural population. They provide directions for future planning and management of open spaces in rural settlement in Israel. Â© 1989.},
  issn = {1692046},
}

@article{womenanddowntownopenspaces1989,
  author = {Mozingo L.},
  title = {{Women} and downtown open spaces},
  year = {1989},
  volume = {6},
  number = {1},
  abstract = {A variety of users participate in the public life of downtown open spaces: the employed and the homeless, young and old, shoppers and tourists, and men and women. My interest is in how men and women perceive and use public space differently; my focus here is on issues designers should consider in order to make downtown open spaces more acceptable to women users. Examines these issues in three ways: by reflecting on the historic division of the city into separate sexual realms, by reviewing the literature discussing psychological factors that effect the perception and behaviour of women in public settings, and by reporting on survey and observational research designed to reveal any differences in men's and women's attitudes towards downtown open space. -from Author},
}

@article{sensoryandaffectiveaspectsofpa1989,
  author = {Bushnell M.C.; Duncan G.H.},
  title = {{Sensory} and affective aspects of pain perception: is medial thalamus restricted to emotional issues?},
  year = {1989},
  volume = {78},
  number = {2},
  doi = {10.1007/BF00228914},
  abstract = {Lateral and medial thalamus are traditionally thought to have separate roles in pain processing, with lateral lemniscal regions transmitting discriminative information about location and intensity, while medial nonspecific regions are involved in emotional responses. Contrary to this view, the present study shows that some single neurons in medial thalamus of alert monkey discriminate changes in the intensity of noxious stimuli that are equal to or below the monkey's own discrimination threshold. Since these neurons are also modulated by anesthesia and attentional factors, we suggest that parts of medial thalamus may participate in both discriminative and affective dimensions of pain. Â© 1989 Springer-Verlag.},
  publisher = {Springer-Verlag},
  issn = {14321106},
  keywords = {Affective; Medial thalamus; Monkey; Pain; Sensory-discriminative},
}

@article{mindbodyandculturesomatization1989,
  author = {Angel R.; Guarnaccia P.J.},
  title = {{Mind,} body, and culture: {Somatization} among {Hispanics}},
  year = {1989},
  volume = {28},
  number = {12},
  doi = {10.1016/0277-9536(89)90341-9},
  abstract = {In this analysis we employ the recently released Hispanic Health and Nutrition Examination Survey (Hispanic HANES) to investigate the issue of somatization among Mexican Americans and Puerto Ricans. In order to do so, we use the physician's assessment as a control, and examine the association between depressive affect and self-perceptions of health for individuals with similar evaluated health levels. The data reveal rather dramatic discrepancies between individual's assessments of their own health and physicians' evaluations. In addition, the data reveal that, net of the physician's evaluation, individuals' assessments of their overall health status are significantly influenced by their affective states. The data also reveal a strong effect of language of interview on self-assessments of health and depressive affect. Â© 1989.},
  issn = {2779536},
  keywords = {depression; Hispanic; physical symptoms; somatization},
}

@article{genderdifferencesintheinitiati1989,
  author = {Derlega V.J.; Lewis R.J.; Harrison S.; Winstead B.A.; Costanza R.},
  title = {{Gender} differences in the initiation and attribution of tactile intimacy},
  year = {1989},
  volume = {13},
  number = {2},
  doi = {10.1007/BF00990792},
  abstract = {Cultural norms may restrict the demonstration of intimacy between men, such that male adults are relatively unlikely (in comparison to females) to display affection in public by hugging or putting hands around one another's waists. Study 1 examined via a role playing technique how the gender composition of a dyad and types of friendship influence tactile greetings. Males displayed less physical intimacy with male friends than with female (platonic or dating) friends and less than females displayed with their same-sex friends. Study 2 examined subjects' perceptions of and attributions about reciprocal touch. Male-male behavior was rated as less normal as a function of the level of physical touch (going from no touch, hugging, to arms around the waist). The normalcy rating of opposite-sex pairs did not vary as a function of the touch manipulation, but female, same-sex pairs' behavior was rated as less normal in the arms around the waist than in either the no touch or hug conditions. In the male same-sex pairs, hugging was seen as more likely to reflect a sexual relationship than no touch, while arms around one another's waist was rated as even more likely to represent a sexual relationship. It was suggested that homophobia, the fear of appearing or being homosexual, may operate to inhibit physical intimacy between men. Â© 1989 Human Sciences Press.},
  publisher = {Kluwer Academic Publishers-Human Sciences Press},
  issn = {1915886},
}

@article{theassessmentofjustificationsf1989,
  author = {Marsh J.S.; Good G.; Seabrooke A.K.},
  title = {{The} assessment of justifications for the provision of parks and open spaces in {Ontario}},
  year = {1989},
  volume = {14},
  number = {3},
  abstract = {Urban parks and open spaces and their various functions have traditionally been accepted by government decision-makers as an important component in an overall strategy that contributes to a better quality of life in an urban community. The purpose of this paper is to address a research need. First, it analyzes the perceptions held by municipal parks managers of the importance of parks and open space functions in urban areas. Second, these perceptions are compared with those investigated by Burton et al. (1977). Third, recommendations with respect to the implications of the findings to future planning and provision of parks and open space are offered. -from Authors},
  issn = {7029284},
}

@article{blacksouthafricansconstruction1989,
  author = {Mccarthy J.J.},
  title = {{Black} {South} {Africans'} constructions of their urban environments},
  year = {1989},
  volume = {19},
  number = {4},
  doi = {10.1177/008124638901900406},
  abstract = {The theory of personal constructs and repertory-grid methodology were used to investigate black South Africans' constructions of their urban environments. A sample of 735 residents of the black townships of five eastern Cape towns and cities provided the basis for generalization on trends in group constructions of urban environments, and perceptions of urban problems. House type and quality and basic residential and transportation infrastructure were found to predominate such constructions and perceptions. Significant differences were evident, however, between towns and social classes. The policy implications of the findings are assessed. Â© 1989, South African Psychological Association and the Psychological Institute of the Republic of South Africa. All rights reserved.},
  issn = {812463},
}

@article{inwhatsenseindicatorsofquality1988,
  author = {Findlay A.; Rogerson R.; Morris A.},
  title = {{In} what sense "indicators' of quality of life?},
  year = {1988},
  volume = {14},
  number = {2},
  abstract = {Two main technical problems are faced by researchers in the evaluation of quality of life. The first relates to the identification of those elements or dimensions of an environment which are involved in people's assessment of its quality of life. The second is to decide how much importance to attach to each of the elements when they are aggregated to form an overall evaluation of quality of life. This paper considers both of these problems within the context of a methodology developed in a recent study of quality of life in British cities. In addition, two further and important aspects of rating places are considered. First, whether it is the selection of indicators or the weightings attached to these indicators which determine the rankings of places in terms of quality of life. Second, whether there are significant regional variations in the way people assess the quality of life. -from Authors},
  issn = {2637960},
}

@article{thebestcitiestolivein1988,
  author = {Rogerson R.; Findlay A.; Morris A.},
  title = {{The} best cities to live in},
  year = {1988},
  volume = {57},
  number = {10},
  abstract = {A recent research project at the University of Glasgow has analysed the quality of life offered by the largest city regions in the UK. Previous attempts to assess quality of life have used limited and arbitrary variables and assigned each one equal weighting. This research has more than 50 indicators and attaches non-unitary weightings to each. The rankings contained some surprises, eg: they contradict the commonly held superiority of the "south'. It is also possible to identify rankings for specific groups in the population. Migration trends do not contradict the findings. It appears that what affects quality of life is human controlled factors and as such is a source of optimism for the possibility of providing an attractive urban environment. -M.Cawkwell},
  issn = {409960},
}

@article{syndromepolyalgiqueidiopathiqu1988,
