  volume = {754 LNCE},
  abstract = {The proceedings contain 49 papers. The special focus in this conference is on High-Quality Urban Development and Beautiful Countryside Construction. The topics include: Urban Resilience Assessment Methods and Enhancement Strategies Under Public Health Emergencies: A Case Study of Northeast China; towards Urban Resilience: An Innovative Theoretical Framework for Comprehensive Multi-hazard Risk Assessment of Urban Disasters; critical Rainfall of Torrential Floods Induced by Heavy Precipitation Based on the FloodArea Model: A Case of Luba River, China; disaster Resilience Assessment of Tourist Places Under the Influence of Multiple HazardsâA Case of Jiuzhaigou Scenic Area, China; strong Wind Risk Assessments for Urban Trees in an Urban Park in Guangzhou, China; prediction Model of Geological Disasters Based on Meteorological Features; Application of Stormwater and Sediment Management Based on the ABC Waters Design Guidelines in the Upper Stream Suburban Section of the Mengkibol River, Kluang, Malaysia; delineating Street Thermal Environments of Kunming, China: A Study Based on Mobile Measurement; thermal Perception and Comfort of Pedestrians in Summer: A Study of Street Canyons in Chongqing, China; spatial Correlation Study of Local Climate Zoning and Carbon Emission Performance: A Study of the Central City of Chongqing, China; supplyâDemand Matching Analysis of Urban Blue-Green Space Cooling: A Study of the Main Urban Area, Hangzhou, China; exploring the Thermal Environment of Kunming, China: Based on Local Climate Zones; thermal-Humid Environment Characteristics in Dry Seasons: A Study of Chenggong District, Kunming, China; assessment of Urban Thermal Environment and Analysis of Influencing Factors in Hangzhou, China.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
