  author = {Liscombe R.W.},
  title = {{Perceptions} in the conception of the {Modernist} urban environment: {Canadian} perspectives on the spatial theory of {Jaqueline} {Tyrwhitt}},
  year = {2006},
  doi = {10.4324/9780203003954},
