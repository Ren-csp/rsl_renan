  author = {Costa R.G.S.; Colesanti M.M.},
  title = {{The} contribution of environmental perception on studies of green areas; {[A} contribuiÃ§Ã£o da percepÃ§Ã£o ambiental nos estudos das Ã¡reas verdes]},
