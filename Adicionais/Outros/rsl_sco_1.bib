  year = {2025},
  volume = {110},
  number = {2},
  doi = {10.1080/00167487.2025.2491270},
  abstract = {The following sentence on p. 19 of the article was incorrectly published online as below: ââThus, researchers have sought to contribute to the development of tools that can encompass the diversity of landscapes and the experiences of local people, while also acknowledging the resource constraints within which planning decisions are made. This has been corrected to read: ââThus, researchers have sought to contribute to the development of tools that can encompass the diversity of landscapes and the experiences of local people, while also acknowledging the resource constraints within which planning decisions are made (Gavrilidis et al., 2016). The first paragraph of the Methods section on page 19 of the article was incorrectly published online as below: ââFor the calculation of ULQI, five steps were carried out and the results were mapped for the entire city. These were then compared with the results of a survey focused on evaluating peopleâs perception of the local urban landscape to validate the results (Figure 2). This has been corrected to read: ââFor the calculation of ULQI, five steps were carried out and the results were mapped for the entire city. These were then compared with the results of a survey focused on evaluating peopleâs perception of the local urban landscape to validate the results (Figure 2). This follows the methodology devised by Gavrilidis et al. (2016) in their study of Ploiesti, Romania. Also, the following reference has been added to page 24: ââGavrilidis, A.A., CiocÄnea, C.M., NiÅ£Ä, M.R., Onose, D.A. and NÄstase, I.J. (2016) âUrban Landscape Quality Indexâplanning tool for evaluating urban landscapes and improving the quality of lifeâ, Procedia Environmental Sciences, 32, pp. 152â67. https://doi.org/10.1016/j.proenv.2016.03.020. Â© 2025 Geography.},
  publisher = {Routledge},
  issn = {167487},
}

@article{placemakersasagentsofchangeque2025,
  author = {Yildiz G.; Bianchi F.},
  title = {{Placemakers} as agents of change: queering institutional spaces through participatory placemaking},
  year = {2025},
  doi = {10.1080/17549175.2025.2554702},
  abstract = {This study investigates placemaking as a âqueeringâ practice in historically stigmatized urban areas, particularly former mental asylums, focusing on Pionta Park, now partly a university campus. This research employs the âurban benchâ as a metaphor and vector for queering public space, investigating the interplay between subjective experiences and material urban landscapes, and emphasizing the dynamics of inclusion and exclusion. Placemaking is seen as a transformative act that embraces fluid identities, diverse urban experiences, and new community forms. Through university-led participatory action research, this study provides visual and narrative insights into urban spaces, positioning placemaking as a dynamic, ongoing âqueeringâ process. It reimagines urban spaces to enhance pedestrian flow and proposes a critical pedagogical approach for universities to cultivate queer futures within their communities. This study emphasizes how âqueeringâ challenges rigid institutional structures, reshapes place perceptions, and redefines public space use. Â© 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {17549175},
  keywords = {former mental asylums; Placemaking; queering institutional spaces; universities; urban parks},
}

@article{demointegratingv2xcommunicatio2025,
  author = {Amaral J.; Figueiredo A.; Rito P.; Sargento S.},
  title = {{Demo:} {Integrating} {V2X} {Communications} and {Infrastructure} {Sensing} with {Autonomous} {Mobility}},
  year = {2025},
  doi = {10.1109/VNC64509.2025.11054112},
  abstract = {As autonomous vehicles evolve, their ability to cooperate with surrounding infrastructure becomes critical for ensuring safety and reliable operation. This work presents and showcases a real-world deployment of a fully autonomous vehicle integrated with cooperative Vehicle to Everything (V2X) services. Using the PIXKIT development kit running Autoware, the vehicle operates autonomously while broadcasting perception and status data to nearby infrastructure and the cloud. The system also enables real-time responsiveness to external safety events, with the vehicle dynamically reacting to emergency notifications broadcasted by Roadside Units (RSUs). Through live demonstration footage and supporting visualization, this work highlights the practical deployment of V2X-enhanced autonomy in urban environments and showcases the readiness of cooperative systems for real-world mobility scenarios.  Â© 2025 IEEE.},
  publisher = {IEEE Computer Society},
  isbn = {979-833152437-1},
  issn = {21579857},
  keywords = {Autonomous Mobility; DDS; Edge; Microservices; V2X},
}

