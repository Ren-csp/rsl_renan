@article{discriminationandevocationofaf1977,
  author = {Tucker D.M.; Watson R.T.; Heilman K.M.},
  title = {{Discrimination} and evocation of affectively intoned speech in patients with right parietal disease},
  year = {1977},
  volume = {27},
  number = {10},
  doi = {10.1212/wnl.27.10.947},
  abstract = {Patients with right parietal disease have disturbed comprehension of affective speech. Ability to discriminate affective speech (make same/different discriminations) and ability to repeat emotionally bland sentences with affective tones were tested in three groups of subjectsâpatients with right parietal dysfunction and neglect, conduction aphasics with left hemispheric lesions, and patients without intracranial disease. Patients with right parietal dysfunction performed significantly poorer than did aphasic controls on both a recognition and discrimination task. Patients with right parietal dysfunction also scored poorer on the evocative task than the nonaphasic controls. Â© 1977 American Academy of Neurology.},
  issn = {283878},
}

@article{conditionalinterpretationofthe1977,
  author = {Sagalovich B.M.; Simbirtseva O.I.},
  title = {{Conditional} interpretation of the concept of unilateral hearing impairment in {Meniere's} disease},
  year = {1977},
  volume = {39},
  number = {4},
  abstract = {The paper describes the results of examination of 97 patients suffering from Meniere's disease. According to the data of traditional audiometry 55 patients were suffering from unilateral affection, in 35, changes in the second ear were not very marked, and in 7 these hearing disturbances were symmetrical. In persons with absence of any changes in hearing sensitivity according to the results of traditional audiometry there was a regular hearing impairment in the healthy ear within the range of 12 to 16 kHz. Such local threshold elevation was particularly distinct under conditions of bone sound conduction, since measurement of thresholds for high frequencies in air sound conduction encountered difficulties due to the limited range of the frequencies perceived because of the presbycusis phenomenon. No changes are seen in the ultrasound perception in the healthy ear of patients with unilateral manifestations of Meniere's disease. In patients suffering from Meniere's disease with bilateral affection the threshold elevation in the ear that hears better (12 to 16 kHz) was more pronounced. However, ultrasound perception was not accompanied by any marked changes. Along with this, derangement of the hearing function in the socalled healthy ear in Meniere's disease was characterized by disturbances in understanding speech after reaching 100% with further increase of intensity. A conclusion was drawn on the regular character of bilateral hearing disturbances in Meniere's disease.},
  issn = {424668},
}

@article{someproblemsconcernedwithchron1977,
  author = {Chumakov F.I.; Ponomareva N.S.; Shubina O.F.; Lukiyanova M.A.},
  title = {{Some} problems concerned with chronic pathology of the middle ear in tuberculous patients},
  year = {1977},
  volume = {55},
  number = {6},
  abstract = {According to materials furnished by an antituberculous sanatorium, it was found that various, largely inflammatory and post-inflammatory affections of the middle ear occur in 7.8% of the patients. Most often than not adhesive 'otites' are in evidence (6.4 %). In the anamnesis ototoxic reactions were noted in 23.7 % of the patients with the middle ear affections, but following medication with aloe, ATP, vitamins and kumiss ototoxic reactions occurred only in 2.9% of the cases. From this it is inferred that at a sanatorium, where a regular audiological control with simultaneous prophylactic measures is practiced, the administration of ototoxic drugs to patients with chronic pathology of the middle ear is permissible.},
  issn = {329533},
}

