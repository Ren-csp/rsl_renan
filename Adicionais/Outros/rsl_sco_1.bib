@article{lachromatopsiecongenitale1955,
  author = {FranÃ§ois J.; erriest G.; De Rouck A.},
  title = {{L'achromatopsie} congenitale},
  year = {1955},
  volume = {9},
  number = {1},
  doi = {10.1007/BF00151110},
  abstract = {After the study of 215 cases of congenital complete color blindness with amblyopia, 15 cases of incomplete color blindness with amblyopia, 15 cases of congenital color blindness without amblyopia and 2 unilateral cases, the authors have made a survey of the actual knowledge upon these affections, with special reference to the functional symptoms. The different theories on the nature of achromatopsy with or without amblyopia are discussed. The typical form must be subdivided in a number of varieties, greater than hitherto supposed. Three new isolated cases are presented, one male and two female. General examination is negative for the first and the third; the second shows electro-encephalographic disturbances. The first and the third have clinically abnormal fovee. The three cases present pseudo-photophobia, nystagmus (studied by electro-nystagmography) and strabismus. Optocinetic nystagmus cannot be elicitated. Binocular vision is absent in the first case, normal in the second and weak in the third. In the three cases the chromatic perception is completely absent and the spectral luminosity curve typically alterated. The central visual acuity in relation to illumination is normal in the scotopic range and does not exceed 0,2 in the photopic range. The photopic visual field is characterized in the three subjects by a trouble of the spatial summations; a central scotoma has always been discovered. The subjective critical flicker frequency is diminished. The dark-adaptation curve is biphasic, the first segment being higher than in normal subjects (global thresholds). The global threshold of the rods is normal; the morphoscopic and differential thresholds are moderately elevated. In scotopic conditions, the b-wave of the E.R.G. is normal; the a-wave and the photopic components of the flicker-E.R.G. could not be demonstrated. The third case shows a specific cortical response which seems retarded in comparison with a normal subject. Â© 1955 Uitgeverij Dr W. Junk.},
  publisher = {Kluwer Academic Publishers},
  issn = {15732622},
}

