  volume = {642 LNNS},
  abstract = {The proceedings contain 41 papers. The special focus in this conference is on Robot Intelligence Technology and Applications. The topics include: Robot toÂ Human Object Handover Using Vision andÂ Joint Torque Sensor Modalities; ensemble ofÂ Fully Convolutional Neural Networks withÂ End-to-End Learning forÂ Small Object Semantic Segmentation; a Survey onÂ 3D Scene Graphs: Definition, Generation andÂ Application; natural Language-Guided Semantic Navigation Using Scene Graph; centre ofÂ Mass Estimation ofÂ Grasped Objects Using Cost Effective Sensors; bridging Depth Estimation andÂ Completion forÂ Mobile Robots Reliable 3D Perception; development and Feasibility Study of an Autonomous Obstacle Detection System for Landing Operations; evaluation of Autonomous Navigational Accuracy for Different Reference Points in PurePursuit Algorithm for Center-Steered Articulated Vehicles; least-Restrictive Multi-agent Collision Avoidance viaÂ Deep Meta Reinforcement Learning andÂ Optimal Control; Nonlinear Autoregressive withÂ Gaussian Process Regression-Based Path-Following Guidance forÂ UAV Under Time-Varying Disturbances; FARO-Tracker: Fast and Robust Target Tracking System for UAVs in Urban Environment; development ofÂ Perching andÂ Fail-Safe Module forÂ Wall Climbing Multi-copter; traffic Signal State Broadcasting Over C-V2X Communication Technique for Autonomous Shuttle Service; planar Fitting Transformation: A Rapid Point Cloud Registration forÂ Real-time Applications; lightweight Branching Self-distillation: Be Your Own Teacher; parametric Surround Modulation Improves theÂ Robustness ofÂ theÂ Deep Neural Networks; efficient Training Method forÂ Point Cloud-Based Object Detection Models byÂ Combining Environmental Transitions andÂ Active Learning; the Classification of Wafer Defects: A Support Vector Machine with Different DenseNet Transfer Learning Models Evaluation; learning Legged Mobile Manipulation Using Reinforcement Learning; performance Verification of Biomimetic Mole Robot (Mole-Bot) for Efficient Underground Exploration; CEO-MLCPP: Control-Efficient andÂ Obstacle-Aware Multi-Layer Coverage Path Planner forÂ 3D Reconstruction withÂ UAVs; development of a Robot System for Cleaning Sludge in Industrial Site.},
