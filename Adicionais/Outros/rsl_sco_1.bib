@article{emotionandperceptionfromthebeh1919,
  author = {De Laguna G.A.},
  title = {{Emotion} and perception from the behavioristic standpoint},
  year = {1919},
  volume = {26},
  number = {6},
  doi = {10.1037/h0071497},
  abstract = {Criticizes behavioristic psychology for its lack of methodological fruitfulness in defining consciousness as behavior. Two groups of behaviorists exist: (i) experimental investigators of animal behaviors, and (ii) philosophical behaviorists. Neither of these groups systematically study the classical categories of psychology - sensation, perception, emotion, affection and volition. The existent behavioristic theories on these areas do not explicate clearly the relationships between them. For example perception has been inadequately differentiated from emotion. It has rarely been acknowledged that: (i) the content of emotion is determined by proprioceptive stimuli while that of perception is exteroceptive; (ii) emotion is not as marked by attentive states as is perception. Argues for a more functional interpretation of these categories. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1919 American Psychological Association.},
  issn = {0033295X},
  keywords = {Behaviorism; Emotions; Perceptions; Phenomena of consciousness},
}

@article{visioncolordefects1911,
  author = {Hayes S.P.},
  title = {{Vision} - {Color} defects},
  year = {1911},
  volume = {8},
  number = {3},
  doi = {10.1037/h0073770},
  abstract = {Reviews 15 studies (1910) on color defects in vision. The studies focuses upon the need of an investigation of the color tests, a case of a color blind man who was wrongly selected for service in merchant marine, improved methods of color testing, and the like. In a discussion of color vision, J. Stilling concluded that all color defects were pathological, the congenital cases being attributable to affections in the optical tract during the early years or during the foetal period. The conclusions are equivocal, with other researchers (e.g., Kollner) disagreeing with them. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1911 American Psychological Association.},
  issn = {332909},
  keywords = {Color blindness; Color tests; Visual perception},
}