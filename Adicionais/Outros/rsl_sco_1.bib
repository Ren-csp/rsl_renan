@article{clientcounselorcompatibilityan1969,
  author = {Mendelsohn G.A.; Rankin N.O.},
  title = {{Client-counselor} compatibility and the outcome of counseling},
  year = {1969},
  volume = {74},
  number = {2},
  doi = {10.1037/h0027201},
  abstract = {Client-counselor compatibility as measured by the Fundamental Interpersonal Relations Orientation Behavior (FIRO-B) scale, was related to 115 clients' perceptions of the relationship and evaluations of the counselor and the usefulness of counseling. Compatibility was a poor predictor for male clients but an excellent one for females. Compatibility in the control need area was related positively to outcome, but in the inclusion and affection need areas, was related to negative outcomes. Consequently, the global compatibility measure used successfully by A. Sapolsky (see 39:3) yielded no significant correlations in this study. However, a composite formed a posteriori for the females produced a correlation of .54 with the major outcome variable. Results point to the necessity of examining potential sex differences, particularly in studies of the clinical relationship, and to the possibility of empirically based client-counselor matching. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1969 American Psychological Association.},
  issn = {0021843X},
  keywords = {client-counselor compatibility \& counseling outcome, sex differences, college students},
}

