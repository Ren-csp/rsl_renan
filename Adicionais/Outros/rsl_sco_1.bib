@article{scheduleevaluationofimpairment1977,
  author = {Lahaye D.; Viaene J.; Van Steenberge J.},
  title = {{Schedule} evaluation of impairment due to hearing loss; {[L'EVALUATION} {BAREMIQUE} {DE} {DOMMAGE} {CORPOREL} {CAUSE} {PAR} {LA} {DIMINUTION} {DE} {L'OUIE]}},
  year = {1977},
  volume = {38},
  number = {12},
  abstract = {The majority of schedules postulate a linear rational progression of the percentage of corporal damage in terms of auditive loss in dB whether it be symmetrical or asymmetrical. In point of fact the differences between the schedules are not due to a different choice of the threshold and the maximal value. For some this linearity is expressly desired in view of the fact that the points of evaluation fall on a definite line. In others the evaluations are rounded off and therefore deviate slightly (but never significantly) from the line of regression. The argument regularly used to motivate the linear progression is the fact that the dB is a logarithmic unit of perception. To this logarithmic unit, therefore, there is a corresponding progression of 'corporal damage'. The authors recognize a logistic curve for the evaluation of the deafness analogous to that described for the evaluation of the pulmonary functional affection. In the strict sense even the propositions of the Belgian official schedule of invalidities, and especially of the French schedule of the crippled and disabled, could be interpreted as logistic curves in which the slight lesions on the one hand (<45 dB) and very pronounced on the other hand (>80 dB) form the horizontal parts, while between these 2 extremes the linear progression forms the frustum of the S. The schedule of the American Medical Association is apparently an exception.},
  issn = {39691},
}

@article{treatmentofsoundperceptiondeaf1976,
  author = {Koeppel F.W.},
  title = {{Treatment} of sound perception deafness with {Danaden} retard; {[BEHANDLUNG} {VON} {SCHALL} {WAHRNEMUNGS} {SCHWERHORIGKEIT} {MIT} {DANADEN} {RETARD]}},
  year = {1976},
  volume = {118},
  number = {32-33},
  abstract = {With Danaden retard the treating physician has at his disposal an effective medicament for the improvement of disorders of sound perception. It is mostly free from side effects. Hereditary difficulty of hearing was not influenced by it. In two cases of Meniere's disease it could not be decided for certain whether the improvement that occurred was due to the medicament or to the fluctuating course of this affection. Gastric intolerance may make it necessary to switch over to another preparation. The improvement of hearing under Danaden retard may be explained by the synergism of the action of both substances that it contains. In this a role is played not only by an improved blood flow in the responsive auditory area, but also by a simultaneous better processing in the brain of the auditory information. The patients find themselves back again in their environment and can resume their sharing of family life. The relief that this always brings to the next of kin is commented upon.},
  issn = {3413098},
}

