@article{dimensionsofintimacyinmarriage1981,
  author = {Waring E.; McElrath D.; Lefcoe D.; Weisz G.},
  title = {{Dimensions} of {Intimacy} in {Marriage}},
  year = {1981},
  volume = {44},
  number = {2},
  doi = {10.1080/00332747.1981.11024102},
  abstract = {Intimacy as an important aspect of interpersonal relationships has been widely accepted (Erikson 1950, Sullivan 1953). In the broad context, an understanding of the role of intimacy has been discussed as essential to the development of a science of interpersonal relationships (Hinde 1978). More specifically, intimacy has been cited as an important dimension of the marital interpersonal relationship (Berman and Lief 1975). This paper describes a study of intimacy in 30 young married couples, randomly selected from the general population. Personal identity and accurate perception of the spouse were significant correlates of marital intimacy, and a factor analysis revealed four dimensions of marital relationships: compatibility, structure, intimacy, and problem-solving. In this study, marital adjustment was significantly correlated with expressiveness, commitment, organization, expressed affection, and the absence of conflict. These findings are discussed in the context of the role of intimacy in a science of interpersonal behavior. Â© 1981 Taylor \& Francis Group, LLC.},
  issn = {332747},
}

@article{postmeningiticvestibularsyndro1981,
  author = {Belkahia A.; Bouzouita H.; Jelloul N.; Rejeb B.},
  title = {{Post-meningitic} vestibular syndrome; {[SYNDROME} {VESTIBULAIRE} {POST-MENINGITIQUE]}},
  year = {1981},
  volume = {30},
  number = {6},
  abstract = {In post-meningitic sequelae there is often a regressive purely static ataxia which has recently been considered to be of labyrinthine origin. The works of modern authors and the study of the authors' cases have shown: the presence of a vestibular syndrome of deficiency type in 75% of the cases; the presence of a vestibular syndrome of deficiency type in 75% of the cases; the presence of an auditory affection with recruitment perception in 50% of the cases. All this pleads in favor of an endolabyrinthine affection. The hypothesis put forward to explain this vestibular and cochlear involvement could be that of a serous labyrinthitis, due to a mixed infection, both bacterial and viral. In support of this hypothesis is the confirmation of the presence of virus in the cerebrospinal fluid in several cases.},
  issn = {3989771},
}

@article{clinicalfeaturesofacuterighthe1981,
  author = {Lachkepiani A.N.; Bagaturiia L.A.},
  title = {{Clinical} features of acute right hemisphere lesions during the acute period of myocardial infarction; {[Osobennosti} kliniki ochagovogo porazheniia pravogo polushariia golovnogo mozga u bol'nykh v ostrom periode infarkta miokarda.]},
  year = {1981},
  volume = {81},
  number = {1},
  abstract = {The patients with the acute stage of myocardial infarction and focal affections of the left and the right hemispheres of the brain were observed. The patients with the acute myocardial infarction and focal affections of the right hemisphere, especially, with the infarction-apoplexy syndrome, developed pananosognosia, i. e. incomprehension and negation of not only hemiplegia, but also the cardiac disease. The so frequent development of the pananosognosia in the infarction-apoplexy syndromes, i. e. in cases when the coronarocerebral catastrophe progresses swiftly and violently, is probably due, apart from the local factors (the focal affection of the right hemisphere), to the general cerebral factors, such as, brain hypoxia, the degree of which predetermines to a great measure the function of the brain, and aggravates, in its turn, the disturbance of the conjugated activity of the brain hemispheres. In cases of combined affections of the heart and the left hemisphere the patients show adequate personal responses to the morbid state, and the latter becomes for a certain period of time an integral part of the patient's "ego".},
  issn = {444588},
}

@article{perceivedparentbehaviorandthes1981,
  author = {Fields A.B.},
  title = {{Perceived} parent behavior and the self-evaluations of lower-class black male and female children},
  year = {1981},
  volume = {16},
  number = {64},
  abstract = {Using a sample of lower class black male and female children from several southern states in America, relationships between children's perceptions of mother's behavior and children's self-evaluations are examined. Perceptions, similar to those previously linked to the self-evaluations of other populations of children, are measured and characterized as expressions of mother affection toward children, as emphasizing companionship, as encouraging the child's independence, and as monitoring the child's actions. Particular attention is given to assessing whether assumption about relationships between child perceptions and self-evaluations vary by sex. The results reveal that lower-class black male and female children make fine distinctions in their perceptions of their mothers' behavior. The data also reveal that while female children perceive more of their mothers' behavior as expressions of affection, companionship, encouragement of independence, and monitoring than males do, these perceptions are of greater importance to the self-evaluations of male children.},
  issn = {18449},
}

