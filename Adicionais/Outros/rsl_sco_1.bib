@article{digitaloutofhomemediameansande2011,
  author = {Stalder U.},
  title = {{Digital} {Out-of-Home} {Media:} {Means} and {Effects} of {Digital} {Media} in {Public} {Space}},
  year = {2011},
  volume = {Part F10835},
  doi = {10.1007/978-0-85729-352-7_2},
  abstract = {Digital out-of-home media and pervasive new technologies are bringing the internet experience into public spaces and stepping up the pace with which brands and products, as well as their virtual representations, penetrate urban environments. This article explores the current phenomenon of pervasive advertising and its underlying perceptions and puts forward a typology for describing a range of applications for the emerging media infrastructure. It argues that the critical dimensions comprise the way in which pervasive advertising and creatives exploit both physical and social contexts by increasingly relying on the effects of illumination, temporality and spatiality. Â© Springer-Verlag London Limited 2011.},
