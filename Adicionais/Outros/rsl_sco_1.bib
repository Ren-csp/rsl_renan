  title = {{Cultural} perception of epilepsy in {Senegal} {(Cap-Vert} and river district); {[REPRESENTATIONS} {CULTURELLES} {DE} {L'EPILEPSIE} {AU} {SENEGAL} {(REGION} {DU} {CAP-VERT} {ET} {DE} {FLEUVE)]}},
