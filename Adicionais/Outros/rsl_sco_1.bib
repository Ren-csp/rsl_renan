@article{parametricverticalphotovoltaic2026,
  author = {Palaoro L.B.; Marins D.P.A.; Fraga A.A.; de Oliveira Rocha H.R.; de Alvarez C.E.; Segatto M.E.V.},
  title = {{Parametric} vertical photovoltaic system: {Fibonacci} methodology applied to solar trees design},
  year = {2026},
  volume = {256},
  doi = {10.1016/j.renene.2025.123960},
  abstract = {This study presents a novel Fibonacci-inspired solar tree design to optimize energy efficiency in urban environments while addressing the growing demand for sustainable energy solutions. The objective was to propose a project methodology for Solar Trees, one that can adapt to diverse contexts and enhance the viability of these structures as source of renewable energy within urban landscapes. The research used Rhinoceros 7 and Grasshopper to create a base model, parametrically adjust key design parameters, and simulate solar irradiation through the Ladybug plug-in. The optimized solar tree design achieved an annual solar energy incidence of 84,017 kWh and an irradiation of 3,222 kWh/m2/year, surpassing traditional flat PVS, which would generate only 68,084 kWh/year with an irradiation of 2,611 kWh/m2/year. Comprising 21 modular photovoltaic leaves made from mono-crystalline silicon, the design meets technical energy requirements and offers aesthetic and landscaping benefits in urban settings. This work underscores the importance of a multidisciplinary approach, merging architecture, energy efficiency, and environmental science to propose feasible solutions for contemporary urban challenges. The findings indicate that the proposed solar tree design fulfills energy demands and enhances public spaces, challenging conventional perceptions of photovoltaic systems as fragmented and visually unappealing. Â© 2025 Elsevier Ltd},
  publisher = {Elsevier Ltd},
  issn = {9601481},
  keywords = {Fibonacci sequence; Parametric modeling; Photovoltaic solar trees},
}

@article{cemeteriesassustainableelement2026,
  author = {Jaszczak A.; Kostecki J.; PochodyÅa-Ducka E.; Greinert A.},
  title = {{Cemeteries} as {Sustainable} {Elements} of {Urban} {Green} {Space:} {Legal,} {Ecological,} and {Spatial} {Perspectives} from {Central} and {Eastern} {Europe}},
  year = {2026},
  volume = {18},
  number = {1},
  doi = {10.3390/su18010212},
  abstract = {As urbanisation accelerates, land-use planning has become a challenging factor in citiesâ sustainable development. This process is based both on the historical heritage of Central and Eastern European cities and on concepts combining urban planning with ecology. Cemeteries, traditionally viewed as places of remembrance, hold significant potential as ecological assets within urban environments. On the other hand, they are problematic in relation to the location, neighbourhood, and form of past/present human activity. Many of these aspects are regulated in the investigated countries. This paper examines sustainable cemetery planning from legal, ecological, and spatial perspectives, highlighting their role in addressing environmental challenges while preserving cultural and social values. The research draws on comparative case studies from eight Central and Eastern European countries, combining an analysis of international and national legal frameworks with a functionalâspatial assessment of cemetery surroundings. In addition, an environmental survey conducted among experts and residents highlights diverse perceptions regarding cemetery functions and their integration into urban landscapes. The findings demonstrate that policy-based management and multifunctional design are essential for enhancing the ecological, cultural, and social value of cemeteries. Reframing cemeteries as multifunctional green spaces offers a practical pathway toward more resilient and environmentally responsible urban development. Some important differences between the following countries have been observed. Â© 2025 by the authors.},
  publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
  issn = {20711050},
  keywords = {biodiversity conservation; environmental law; green infrastructure; sustainable cemetery planning; urbanization},
}

@article{physicalactivityinpublicspacei2026,
  author = {KÃ¶ckler H.; Shrestha R.; Bilal Aslam A.; Berger T.; BÃ¶rner S.; Cheung C.; Fabian C.; Shankavaram H.; Shrestha R.; Shrestha S.; Simon D.},
  title = {{Physical} activity in public space: insights from a global community of practice applying photovoice as a tool for digital participatory place analysis},
  year = {2026},
  volume = {10},
  number = {1},
  doi = {10.1080/23748834.2024.2307739},
  abstract = {Physical activity in open spaces is a crucial topic of urban health around the globe. As cities and everyday life differ a lot in specific urban contexts, places for physical activity may vary in shape, perception and use by local people. A group of researchers from eight countries in Europe, South America and Asia used the same online-photovoice application to explore places in their cities regarding physical activity in public spaces. Using the same application in eight countries with diverse local participants, we collected a rich basis for a reflection on methodological issues, the usability of the online-photovoice application and determinants of physical activity in public spaces in contrasting cities. The paper aims to provide traceable documentation of a collaborative learning activity with an online-photovoice application. In doing so, results are presented from researchersâ self-reflection as a global community of practice on how the online-photovoice approach can be applied to place analysis for healthy urban development at different places with practitioners, communities, and scientists from diverse backgrounds. The paper contributes to a broader problem understanding of physical activity in public open spaces. As one result, we find that including aspects of safety and conflict in public space is highly relevant. Â© 2024 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {23748834},
  keywords = {healthy urban development; knowledge co-production; online-photovoice; Physical activity; public space},
}

@article{livelihoodstruggleofearcleaner2026,
  author = {Agarwal D.; Devi R.},
  title = {{Livelihood} {Struggle} of {Ear} {Cleaners} in the {Urban} {Sphere:} {A} {Case} {Study} of {Singhiwala} {Community} with {Reflections} on the {Lives} of {DNT} in {Delhi}},
  year = {2026},
  doi = {10.1007/978-981-95-5827-8_15},
  abstract = {This study provides an overview of the livelihood struggle faced by the Singhiwala community in Delhi, who work as ear cleaners. The study delves into the social and economic challenges and cultural transformations of the community in the rapidly changing urban environment. The Singhiwala community, known for their expertise in ear cleaning, has a long-standing presence in Indian society. However, their livelihoods have come under increasing pressure due to urbanization, changing health practices, and social perceptions. This study aims to shed light on the challenges faced by the Singhiwala in Delhi, offering insights into broader issues of urban poverty and cultural heritage preservation. This study explores the historical background of the Singhiwala, traces their origins, migration patterns, and traditional occupational practices. It highlights the cultural significance of ear cleaning in Indian society, emphasizing the communityâs role as custodians of a unique healing tradition. It also identifies their strategies for survival in the new social and economic system. The Singhiwala community serves as a microcosm of broader issues related to occupational traditions, cultural preservation, and socioeconomic disparities in urban environments. Studying this community provides valuable insights into the complexities of livelihood struggles and cultural resilience. Â© The Editor(s) (if applicable) and The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
  publisher = {Springer Nature},
  isbn = {978-981955827-8; 978-981955826-1},
  keywords = {Cultural resilience; Development; Livelihood; Microcosm},
}

@article{measuringthecausaleffectofurba2026,
  author = {He Z.; Meng W.; Yao J.; Gong Y.; Wu L.; Tao L.},
  title = {{Measuring} the causal effect of urban environments on crime with street view images and points of interest},
  year = {2026},
  volume = {168},
  doi = {10.1016/j.cities.2025.106399},
  abstract = {Measuring the complex influence of urban built environment on crime is a focal point in environmental criminology. Current studies have mainly focused on the correlations between urban built environment and crime. Using two new forms of urban big data, the street view images and points of interest, this research examines the causal relationship between urban built environment and crime with structural causal models. A case study is implemented for Manhattan, New York City. The empirical results suggest that street perception characteristics do not directly affect crime but rather impose an indirect influence through urban facilities. Furthermore, the impact of street perception characteristics on crime varies depending on the type of urban facilities involved. The findings of this research provide valuable insights into the role of urban built environment in shaping crime patterns, thus contributing to evidence-based strategies for crime prevention. Â© 2025 Elsevier Ltd},
  publisher = {Elsevier Ltd},
  issn = {2642751},
  keywords = {Casual inference; Crime geography; Structural causal models; Urban built environment},
}

@article{aneuroarchitecturalframeworkfo2026,
  author = {AslanoÄlu R.; ÅwiÄder M.; LubaÅska A.; Chrobak G.; Kazak J.K.; van Hoof J.},
  title = {{A} {Neuroarchitectural} {Framework} for the {Age-Friendly} {Built} {Environment:} {Transforming} {Visually} {Complex} {Spaces} into {Places}},
  year = {2026},
  doi = {10.1080/26892618.2026.2691024},
  abstract = {Space is a physical, structured entity defined by measurable dimensions and geographical coordinates. Place, by contrast, has meaning and value, which are created through peopleâs experience and social interaction. Despite growing interest in age-friendly urban environments, limited research has examined how older adults perceive visual complexity and how it influences their well-being. This study examines the concept of place through the lens of ageism by employing neuroarchitectural approaches to investigate visual complexity. Therefore, it develops a detailed understanding of how older adults perceive visual complexity in urban environments using an instrument called CLARITY. The study utilizes a mixed-methods strategy, analyzing the visual complexity and conducting semistructured interviews. The results revealed substantial variation in objective visual complexity, with CLARITY scores ranging from 23.5% to 49.6%. A strong positive correlation (r = 0.88) was found between CLARITY scores and participantsâ perceived visual complexity ratings, indicating that the framework captures cognitively relevant environmental characteristics. Participants associated highly complex environments with clutter, object crowding, fragmented spatial organization, competing visual stimuli, and intensive traffic activity. Higher levels of visual complexity were also associated with lower self-reported well-being (r = â0.39). As the results show, high levels of visual complexity impact older adultsâ well-being. Â© 2026 The Author(s). Published with license by Taylor \& Francis Group, LLC.},
  publisher = {Routledge},
  issn = {26892618},
  keywords = {aging; Neuroarchitecture; perception; place; space; visual complexity},
}

@article{developingmultisensoryolfactor2026,
  author = {Shi Y.; Kong X.; Lu X.; Xu J.; Liu M.},
  title = {{Developing} multisensory olfactory and auditory perception methods for a dynamic market environment},
  year = {2026},
  doi = {10.1080/13467581.2026.2635248},
  abstract = {This study examines multisensory communication in urban contexts through an empirical analysis of the Honghai Morning Market in Northeast China. The market demonstrates how communications among people, goods, and space generate a dynamic sensory landscape shaped by auditory, olfactory, and visual experiences. Focusing on applying research methods in studying sensory communication beyond the visual. To capture these dynamics, it integrates soundwalks, smellwalks, and sensory maps, operationalized into seven stages. On this basis, the study develops a dual-route strategy of structured and organic routes, combined with the overlaying of sensory maps. Drawing on cross-modal correspondence theory, auditory and olfactory data were visualized, and three spatial patterns were identified: sensory co-located zones, interlaced zones, and obscured zones. These results advance the analytical focus from static sensory backgrounds to dynamic sensory events, providing a framework for urban sensory analysis. Furthermore, links sensory research with spatial planning by proposing sensory-guided layout principles and management standardsâincluding stall arrangement, noise control, and ventilation optimizationâand by offering design guidelines for environmental improvement and historic district preservation. This article contributes to urban sensory studies by integrating data collection, visualization, and planning practice, highlighting the value of sensory perspectives in designing and managing dynamic urban environments. Â© 2026 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group on behalf of the Architectural Institute of Japan, Architectural Institute of Korea and Architectural Society of China.},
  publisher = {Taylor and Francis Ltd.},
  issn = {13467581},
  keywords = {landscape perception; local markets; Multisensory communication; multisensory research methods; sensory map},
}

@article{gsomarageospatialslamframework2026,
  author = {Huang K.; Muhammad N.; Liu D.; Wang W.; Chen T.},
  title = {{GSOMAR:} a geospatial {SLAM} framework for real-time outdoor mobile augmented reality scene modeling and semantic interaction},
  year = {2026},
  doi = {10.1080/15230406.2026.2629336},
  abstract = {This study proposes Geospatial Simultaneous Localization and Mapping for Outdoor Mobile Augmented Reality (GSOMAR), a framework that integrates geospatial data with perceptual computing to enable real-time modeling and interaction in complex urban environments. Unlike traditional mobile augmented reality (MAR) systems based on isolated overlays, GSOMAR ensures spatial continuity and semantic integration of heterogeneous elementsâsuch as buildings, roads, points of interest (POIs), and pedestriansâwithin a coherent and responsive MAR environment. The framework fuses real-time kinematic global navigation satellite system (RTK-GNSS) measurements with an inertial measurement unit (IMU) to achieve accurate pose estimation, calibrates global scale and orientation, and supports real-time semantic modeling for interactive MAR scenes. Experimental results show that GSOMAR consistently outperforms existing RTK-GNSS + visualâinertial odometry (VIO) and ORB-SLAM-based methods across diverse outdoor scenarios. It achieves high-precision initialization over varied terrain, reducing average positional and gravity-vector errors by up to threefold compared with baseline methods. Extended tracking tests over 1400 m confirm sub-decimeter accuracy and improved stability with reduced drift. virtual-real alignment experiments further demonstrate robust spatial registration under occlusion and extended-range conditions. Overall, GSOMAR enables accurate, interactive, and semantically aware outdoor MAR, supporting applications such as urban modeling, navigation, and infrastructure inspection. Â© 2026 Cartography and Geographic Information Society.},
  publisher = {Taylor and Francis Ltd.},
  issn = {15230406},
  keywords = {dynamic modeling; Geospatial representation; immersive experience; Mobile Augmented Reality (MAR); outdoor spatial environment; spatial perception},
}

@article{swedishtravellersperceptionsof2026,
  author = {Abbasian S.; Onn G.},
  title = {{Swedish} travellersâ perceptions of urban overtourism with link to social density theory: conceptualisation and solutions},
  year = {2026},
  volume = {12},
  number = {1},
  doi = {10.1080/23311886.2026.2651480},
  abstract = {This paper aims to conceptualise Swedish travellersâ attitudes towards urban overtourism, linking these perceptions to Social Density Theory (SDT), and exploring their proposed solutions. The research used online surveys for data collection. A content analysis method was employed to analyse the quantitative data (answers to closed-ended questions) and qualitative data (answers to open-ended questions, and comments) in the survey. The analysis tool NVIVO 12 was used. The data comprised 370 completed online questionnaires. The respondents identified numerous urban destinations worldwide, mostly European, as suffering from overtourism. Their interactions with these destinations and with other tourists are often described as less pleasant. Most respondents viewed overtourism as a problem, while a minority perceived it as an opportunity. Both groups suggested a range of soft and hard measures to address this issue. This research offers theoretical and practical implications for tourism stakeholders and scientists who should consider travellersâ attitudes and propose solutions. It extends SDT by emphasising travellersâ perceptions of overcrowded urban environments and includes their solutions. The authors concluded that all involved actors need to approach the multifaceted problem of overtourism. The lack of insight into respondentsâ behavioural patterns during and after their visits has been a limitation of this research. Â© 2026 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Cogent OA},
  issn = {23311886},
  keywords = {European destinations; Social Density Theory; Swedish travellers; tourist experiences; Urban overtourism},
}

@article{pedestrianaccessibilitycharact2026,
  author = {Amores-MuÃ±oz N.; MarÃ­n-Granados M.D.; Ortiz-Zamora F.J.; MartÃ­nez-Torres J.L.; PÃ©rez-GarcÃ­a J.},
  title = {{Pedestrian} {Accessibility} {Characterization} in a {University} {Urban} {Environment} for {GIS} {Integration}},
  year = {2026},
  volume = {18},
  doi = {10.1007/978-3-032-08108-7_30},
  abstract = {Cities face environmental challenges requiring effective mobility and urban planning. Mobility is crucial for connecting urban spaces and shaping city form. Malaga has expanded, particularly with its university campus development. Promoting sustainable mobility, especially pedestrian options, is essential for connecting these areas. Evaluating pedestrian environments necessitates an understanding of pedestrian behavior, which is influenced by sensory interactions with the city, other pedestrians, and the environment. Factors affecting pedestrian mobility are categorized into accessibility, safety, comfort, and attractiveness. Accessibility pertains to infrastructure, safety concerns traffic dynamics, comfort, is subjective, and attractiveness relates to pedestrian engagement with surroundings. The Pedestrian Characterization in Mobility Environments (PCME) method, developed by Talavera-GarcÃ­a, Soria, and Valenzuela, quantifies these factors and assigns a quality level from one to five. Accessibility is gauged by pedestrian section width; safety is assessed via speed and traffic lanes; comfort considers noise and greenery; and attractiveness examines complexity. Using this methodology, evaluations were conducted for each faculty on the University of Malaga campus. Measurements included pedestrian passage width, obstacles, car lanes, and permitted speeds, along with the influence of bike lanes and metro tracks on safety perception. Measurements also assessed tree density, shade provision, ambient noise levels, and the presence of urban elements enhancing quality, such as benches and trash bins. Additionally, faculties were evaluated based on their interaction levels and complexity versus isolation. Some faculties, like the Faculty of Philosophy and the Faculty of Medicine, achieved high urban quality levels, while others, such as the Faculty of Fine Arts and the School of Computer Engineering, received lower scores. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303208107-0},
  issn = {21954356},
  keywords = {Accessibility; GIS; Mobility; Pedestrian},
}

@article{thehistoricalcityasacriticalre2026,
  author = {Borsari A.; Leoni G.; Bellucci G.; Cattabriga I.; Di Maio F.; Girelli E.; Lecci F.; Loffredo R.; Longo D.; Nigrelli C.; Orlandi S.},
  title = {{The} {Historical} {City} as a {Critical} {Reference} for {Urban} {Aesthetics,} {History,} and {Climate} {Resilience}},
  year = {2026},
  doi = {10.1007/978-3-032-12340-4_4},
  abstract = {The research delineates the significance of the historical city as a pivotal counter-model of urban development, particularly in the context of Italy post-World War II. It emphasizes the need for interdisciplinary approaches that intertwine architecture and urban history with public engagement, aiming to enhance decision-making in urban policy while preserving scientific integrity. The historical city is examined not just as an academic subject but as an active entity contributing to contemporary urban dynamics, navigating the transformations that have established it as a historic center amid modern urban sprawl. The chapter posits that the historical city can counteract detrimental urban policies and advocate for sustainable practices by bridging the gap between enduring historical values and the rapidly evolving identity of âmodernâ cities. It calls for active political engagement from historical research, promoting a collaborative framework that can enhance community socio-cultural conditions and support informed political discussions regarding urban evolution. Furthermore, the study introduces the concept of ânew urban aestheticsâ, highlighting the sensory and imaginative aspects of urban experiences and the shift toward aesthetic evaluations in the relationship between cities and their identities. It draws from early twentieth-century theorists and contemporary thinkers to explore how aesthetic dimensions shape urban environments and collective perceptions. The research identifies case studies to examine the intersection of new urban aesthetics with historic contexts. This comprehensive approach aims not only to create specialized knowledge but also to ensure that historical insights inform future urban development initiatives, thereby fostering community engagement and awareness of urban heritage. Building on this foundation, the Bologna case study demonstrates how historical insights can directly inform climate adaptation strategies. The study develops a multilayered analysis methodology to map and address Urban Heat Islands (UHIs) in the historical cityâs public spaces, integrating Nature-Based Solutions (NBSs) within a green infrastructure plan. By identifying vulnerable zones and simulating interventions with specific modeling, the methodology assesses improvements in microclimatic conditions. This approach provides a cross-disciplinary knowledge base that guides data-driven and long-term strategies for climate resilience, highlighting the historical cityâs role as both a cultural and ecological asset in the just transition toward sustainability. Main research outputs: 1923 2023 Fernando TÃ vora at 100, A. Esposito, G. Leoni, J.A. Bandeirinha, with G. Bellucci, eds., âHPA Histories of Postwar Architectureâ, vol. V, n. 11 (hpa.unibo.it, Open Access, Classe A-ANVUR, SCOPUS); printed ed. Siracusa: Lettera Ventidue, 2024, HPA Series; Envisioning Tomorrowâs Cities O.M.Ungers Urban Reflections, A. Trentin, J.H. Gleiter, eds., âHPA Histories of Postwar Architectureâ, vol. VI, n. 12 (hpa.unibo.it, Open Access, Classe A-ANVUR, SCOPUS); The Churches and the City: European experiences between the 1950s and the 1960s, J. Alves da Cunha, A. Longhi, J. L. Marques, S. Singler with G. Bellucci, R. Maddaluno, eds., âHPA Histories of Postwar Architectureâ, vol. VI, n. 14 (hpa.unibo.it, Open Access, Classe A-ANVUR, SCOPUS); I. Cattabriga, E. Chinellato, A. Eghbali, R. Loffredo, Z. Mutton, eds.,. The Historical City.Â A Critical Reference and Role Model, Cham: Springer, 2024; E. Girelli, R. Loffredo, eds.,Â Historical City and Visual Representation, Cham: Springer,Â 2026; Public Art, Urban Arts: Aesthetics, Practices and Languages in the City, A. Borchi, F. Fimiani, E. Chinellato, F. Sabatini, eds., âCPCL European Journal of Cre-ative Practices in Cities and Landscapeâ, vol. 6, n. 2 (cpcl.unibo.it, Open Access, SCOPUS); Historical City and Urban Aesthetics, F. Di Maio, C. Nigrelli, eds., âCPCL Europe-an Journal of Creative Practices in Cities and Landscapeâ, vol. 7, n. 2 (cpcl.unibo.it, Open Access, SCOPUS); A. Borsari, ed. Urban Aesthetics, âIride. Rivista di filosofia e discussione pubblicaâ, 2, 2025 (Classe A, Anvur); M. Cassani Simonetti, G. Leoni, Il Piano per il Centro Storico di Bologna 1969. Lâarchivio, Siracusa:Â Lettera Ventidue, 2026; M. Cassani Simonetti, I. Cattabriga, G. Leoni, The Reinvention of the âHistoric Centreâ in Postwar Europe, Siracusa:Â 2026 (to be published); D. Longo, R. Roversi, M. Massari, K. Fabbri, R. Mercuri, The Green Connections: Adaptive, Integrated, and Nature-Based Solutions for Urban Historic Centres, âTECHNEâJournal of Technology for Architecture and Environmentâ, n. 28, 2024, pp. 181â190 (Classe A, Anvur) https://doi.org/10.36253/techne-15868. Â© The Editor(s) (if applicable) and The Author(s) 2026.},
  publisher = {Springer Nature},
  isbn = {978-303212340-4; 978-303212339-8},
  keywords = {Community engagement; Cultural heritage; Historical city; Sustainability; Urban aesthetics; Urban development; Urban Heat Islands (UHI)},
}

@article{farawaysocloseurbancitizensina2026,
  author = {PessÃ´a C.S.; Baldauf C.; Xavier-Sampaio L.; Moro M.F.},
  title = {{Far} away, so close: urban citizens in a {Brazilian} metropolis value green areas but prefer exotic species for afforestation},
  year = {2026},
  volume = {77},
  doi = {10.1590/2175-7860202677008},
  abstract = {We examined the knowledge held by urban residents regarding tree species as well as their preferences and perceptions of green areas within their city. Pedestrians in Fortaleza, CearÃ¡ state, Brazil, were interviewed regarding the tree species they know and value, and the tree species present in the square where the interviews were recorded. We expected higher mentions of exotic species and a preference for them over native species, reflecting global urbanization trends and the fact that most trees in the city studied are exotic. We also hypothesized that urban green areas would be positively evaluated by citizens, linked to perceptions of green spaces as beneficial to human well-being and health. The interviewees cited 100 ethnospecies, representing 97 biological species. Participants showed greater familiarity with, and preference for, exotic species. These results aligned with our expectations, as exotic trees are much more common in Fortaleza than native species. The number of species cited was influenced by the interviewee's age and origin (urban vs. rural). Despite recognizing the importance of urban trees, many interviewees associated them with drawbacks like leaf clutter and infrastructure damage. Our findings suggest that promoting planting native fruit trees and implementing proper management could foster the appreciation of native species in urban settings and help preserve local knowledge and ecosystem services. This underscores the potential for integrating native species into urban green spaces to enhance biodiversity and ecosystem health and to counteract the impacts of urbanization and the loss of traditional ecological knowledge. This is an open-access article distributed under the terms of the Creative Commons Attribution License. CC BY},
  publisher = {Instituto de Pesquisas Jardim Botanico do Rio de Janeiro},
  issn = {3706583},
  keywords = {ethnobotany; local knowledge loss; urban forestry; urban green areas; urban trees},
}

@article{integratingriskreductionandloc2026,
  author = {Marinelli G.; Galassi S.; Fiorini E.; Domenella L.},
  title = {{Integrating} {Risk} {Reduction} and {Local} {Development} {Strategies:} {Case} {Study} of the {Historic} {Town} of {Pollenza}},
  year = {2026},
  volume = {827 LNCE},
  doi = {10.1007/978-3-032-18818-2_41},
  abstract = {In recent decades, the increasing frequency and intensity of natural disasters has highlighted the urgent need to enhance urban resilience, placing environmental risk reduction among global priorities. Although the importance of integrating resilience strategies into urban planning is now widely acknowledged, local community engagement remains limited. Investing in resilience means not only strengthening response and adaptive capacities but also promoting well-being, social cohesion, and territorial competitiveness. This paper presents the findings of a case study supporting the revision of the detailed plan for the historic town of the municipality of Pollenza (MC), located in a high seismic risk area in central Italy. The research introduces a dynamic method for assessing urban exposure in public open spaces, based on a quantitative index that integrates morphological, functional, and temporal parameters. This approach enables a comparative evaluation of alternative scenarios of urban regeneration and socio-economic development, highlighting how specific design strategies influence urban risk levels and offering guidance for more resilient and inclusive urban planning. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303218817-5},
  issn = {23662557},
  keywords = {public open spaces; Urban regeneration; urban resilience strategies; usersâ exposure and vulnerability assessment},
}

@article{vibcomfortasoftwaretoolforeval2026,
  author = {Qayyum W.; GarcÃ­a-MacÃ­as E.; Cavalagli N.; Neri P.; Ubertini F.},
  title = {{VibComfort:} {A} software tool for evaluating human vibration comfort in sensitive buildings},
  year = {2026},
  volume = {287},
  doi = {10.1016/j.buildenv.2025.113812},
  abstract = {Recent advancements in construction technology have led to the increasingly frequent design of flexible structures, which are consequently more susceptible to vibrations from various sources, potentially impacting human comfort. The vibration comfort level of occupants is influenced by several factors, including the type of vibration source, building classification, vibration transmission medium, and human perception, making its assessment a complex process. To ensure buildings comply with human comfort prescriptions, it is critical to conduct an accurate evaluation of vibrations and identification of their sources. In this context, this work introduces VibComfort, a software tool to assess the effects of low-frequency vibrations on human comfort in urban environments. VibComfort is a MATLAB-based software application that offers an intuitive platform for signal visualization and processing, event selection, statistical analysis, long-term comfort monitoring, and verification against limits provided by the UNI9614-2017 standard. The potential of the developed platform is demonstrated with a case study of an administrative building of the University of Granada in Spain, adjacent to the metro line. To facilitate the identification of the vibration events, a camera was connected to the data acquisition system, allowing the identification of those triggered by metro passages. The vibrations induced by the subway were found to be significantly minimal, confirming a satisfactory level of comfort for the occupants. The presented platform lays groundwork for developing a fully automated comfort assessment system, representing a substantial advancement in the field of human comfort evaluation. Â© 2025},
  publisher = {Elsevier Ltd},
  issn = {3601323},
  keywords = {Comfort evaluation; Comfort monitoring; Human comfort; Sensitive buildings},
}

@article{mappingriskfactorstobuildinclu2026,
  author = {Maestroni D.; Cappelli G.; Gagliardi V.; Nardoianni S.; Mahabadi P.H.; Tika T.P.; Caushaj N.; Bella F.; DâApuzzo M.; Misso F.E.},
  title = {{Mapping} {Risk} {Factors} to {Build} {Inclusive} {Roads:} {A} {Systematic} {Diagnosis} for {Enhancing} {Vulnerable} {Users} and {Persons} with {Reduced} {Mobility} {Safety}},
  year = {2026},
  volume = {15898 LNCS},
  doi = {10.1007/978-3-031-97657-5_6},
  abstract = {Sustainable transport has been a growing focus for several decades, particularly following the Paris Agreement in 2015 and the Glasgow Climate Pact in 2021. The United Nations Sustainable Development Goal (SDG) 11 promotes accessibility, safety, energy, efficiency and use of sustainable public transport. Access to safe, reliable, and affordable transportation is fundamental for social inclusion, education, healthcare, and employment. Building on these global initiatives, this research aims to identify critical road safety risks and proposes targeted interventions to improve mobility for vulnerable road users (VRUs) and persons with reduced mobility (PRMs) in Italy. It applies principles of social sustainability in transportation to assess road safety in Romeâs Nomentano-Tiburtina area through three interrelated studies. First, the accident analysis identifies high-risk âblack pointsâ by mapping accidents involving VRUs through Geographic Information System (GIS) and Kernel Density Estimation (KDE). Then, the vehicle-infrastructure interaction analysis evaluates road infrastructure risks using floating car data (FCD) to analyze driver behavior and correlates it with road accident data. Finally, the accident potential analysis assesses pedestrian accident risk by examining pedestrian flows and urban network structures, integrating configurational analysis with SpaceSyntax tools. Using FCD, multi-year accident data and pedestrian flow analysis, this research provides a comprehensive assessment of road safety risks in Nomentano-Tiburtina. The integration of the three quantitative information, allows the identification of critical areas and the development of targeted interventions. Findings offer actionable insights for policymakers and urban planners to enhance pedestrian, cyclist and vulnerable usersâ safety and promote sustainable mobility in urban environments. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303197656-8},
  issn = {3029743},
  keywords = {Kernel Density Analysis; Pedestrian Crowding; Road Safety},
}

@article{pedestrianactivityclassificati2026,
  author = {Guefrachi N.; Ghazzai H.; Alsharoa A.; Setti G.},
  title = {{Pedestrian} {Activity} {Classification} with {Hybrid} {Deep} {Learning} {Models} {Using} {Elevated} {LiDAR} {3D} {Point} {Clouds}},
  year = {2026},
  doi = {10.1109/JSEN.2026.3690066},
  abstract = {Recent advances in Light Detection and Ranging (LiDAR) and artificial intelligence have enabled new opportunities for traffic surveillance and pedestrian monitoring in urban environments. However, most existing systems focus on object detection and tracking, while reliable pedestrian activity recognition under realistic degradation remains insufficiently addressed. This paper presents an elevated LiDARâbased framework that captures overhead 3D point clouds for object recognition and multiclass pedestrian activity classification. Despite progress in 3D perception, three major challenges persist: (i) the scarcity of activity-labeled real-world LiDAR datasets suitable for supervised learning, (ii) limited robustness of deep learning models when LiDAR signals are affected by noise, sparsity, and occlusion, and (iii) the lack of unified pipelines that jointly integrate 3D detection with spatial and temporal behavior analysis. To address these challenges, we develop a Blender-based elevated LiDAR dataset simulating diverse urban scenarios and extend the KITTI tracking dataset with activity annotations for real-world validation. The proposed framework combines PV-RCNN for 3D pedestrian detection with a hybrid PointNetâLong Short-Term Memory (LSTM) architecture for spatialâtemporal activity recognition, guided by a dynamic weighting fusion mechanism. Experimental results show that the proposed model outperforms PointNet, LSTM, and transformer-based baseline across all the activity classes, achieving 84.7% accuracy on synthetic data. Under severe LiDAR corruption, performance degrades by only 3.4 percentage points. On the KITTI-based dataset, the framework achieves 73.5% accuracy, surpassing single-stream baselines by 6.5â23.0 percentage points. These results demonstrate that joint spatial-temporal reasoning yields improved comparative robustness under controlled LiDAR degradations, while maintaining consistent cross-domain generalization under real-world conditions for pedestrian activity recognition in smart-city environments. Â© 2001-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {1530437X},
  keywords = {3D point clouds; elevated LiDAR; gait analysis; human activity recognition; noise robustness models; pedestrian monitoring; real-world data testing},
}

@article{eventdrivendecisionmakingforau2026,
  author = {Leyer D.; Heizmann M.},
  title = {{Event-Driven} {Decision-Making} for {Autonomous} {Vehicles} in {Mixed-Traffic} {Roundabouts}},
  year = {2026},
  volume = {7},
  doi = {10.1109/OJITS.2026.3677476},
  abstract = {Autonomous vehicle operation in roundabouts remains a challenging task due to continuous traffic flow, limited visibility, and the coexistence of human and automated drivers. Traditional optimization- or learning-based decision frameworks struggle to handle such conditions because they rely on perfect perception, continuous control, or full vehicle connectivity. This paper presents a discrete event system based decision-making framework for autonomous vehicles navigating single-lane roundabouts in mixed traffic. The proposed method models vehicle interactions as event-triggered state transitions, allowing transparent and modular decision logic between offensive and defensive driving behaviors. Simulations demonstrate that the proposed approach achieves collision-free operation and stable flow performance under partial observability, while maintaining interpretability and low computational cost. The results highlight that discrete event reasoning provides a scalable and explainable alternative to existing continuous and data-driven models for autonomous driving in complex urban environments.  Â© 2026 The Authors.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {26877813},
  keywords = {Autonomous vehicles; decision making; discrete event systems; mixed traffic},
}

@article{betweenremembranceandforgetful2026,
  author = {Di Puppo L.},
  title = {{Between} remembrance and forgetfulness: heart perception, oneness and the human-landscape relationship in a {Bashkir} {Sufi} circle},
  year = {2026},
  volume = {23},
  number = {1},
  doi = {10.1080/14747731.2024.2383012},
  abstract = {wIn this article, I explore human-landscape and human-nature relationships from the perspective of Sufi ontologies by examining how Sufi Muslims revive the sacred landscape in Bashkortostan. I foreground an alternative mode of knowing, the heart perception, to analyze how they experience the landscapeâs aliveness. I argue that this mode of experiencing the natural environment goes further than the idea of the sentience and agency of non-humans in the post-humanist turn and the literature on sentient landscapes. Indeed, Sufi ontologies foreground the presence of the Divine in human-landscape and human-nature relationships, shedding light on how my interlocutors differentiate between humans with an âopenâ or a âclosed heartâ to warn of the dangers of forgetting their ancestorsâ knowledge and care for nature. By foregrounding the heart perception, I explore this diversity of human beings and ways of relating to the landscape between remembrance and forgetfulness. Â© 2024 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {14747731},
  keywords = {Human-landscape relationship; Islam; post-humanism; Russia; sentient landscapes; Sufi ontologies},
}

@article{examiningculturalidentitytensi2026,
  author = {Haldar P.; Mandal D.K.},
  title = {{Examining} {Cultural} {Identity} {Tensions} in {Contemporary} {Brand} {Strategy:} {From} {Local} {Roots} to {Global} {Routes}},
  year = {2026},
  doi = {10.4018/979-8-3373-8162-6.ch009},
  abstract = {In times of advanced international integration, it has become increasingly common that in the course of their territorial expansion, brands face some difficulties in combating manifestations of these or other cultural characteristics. This research seeks to understand how consumer perceptions are formed as a result of global and localbrandstrategies by means of a revisedStimulusâOrganismâResponse (SâOâR) perspective encompassing cultural identity and consumer culture, which has a higher Arduino burstiness. A comprehensive review of literature in this area and a specially designed, mixed-method study with the focus on Partial Least Squares Structural Equation Modelling (PLS-SEM) and a grounded approach to findings presentation have illuminated that the conflict in cultural identity through which oneâs brand strategy is used further leads to outcomes such as trust, affection, and commitment. The evidence presented suggests that brand tactics that are relevant and compatible are necessary elements in maintaining long-term relationships with global consumers. Copyright Â© 2026, IGI Global Scientific Publishing. Copying or distributing in print or electronic forms without written permission of IGI Global Scientific Publishing is prohibited. Use of this chapter to train generative artificial intelligence (AI) technologies is expressly prohibited. The publisher reserves all rights to license its use for generative AI training and machine learning model development.},
  publisher = {IGI Global Scientific Publishing},
  isbn = {979-833738164-0; 979-833738162-6; 979-833738163-3},
}

@article{effectsofgreenspacemorphologyo2026,
  author = {Liu B.-Y.; Xu W.-Z.; Zhang D.-Y.; Liu J.; Hong X.-C.},
  title = {{Effects} of green space morphology on tranquility service quality in the core built environment},
  year = {2026},
  doi = {10.1007/s10668-026-07890-5},
  abstract = {Noise pollution has become an escalating environmental concern in urban areas. As essential natural components that deliver multiple ecological benefits, green spaces have attracted increasing attention for their potential to mitigate noise and foster tranquil soundscapes. Focusing on the core built-up area of Fuzhou City, this study integrates vector data on green space morphology with citizen noise complaint records to construct a tranquility gradient (T10âT100) based on 500Â m Ã 500Â m grid units. Through landscape pattern analysis and spatial statistical methods, three morphological metrics (Shape Index, Splitting Index, and Patch Richness Density) were examined to assess their associations on tranquility services. Correlation results indicate a statistically significant but trivial positive association between SPLIT and tranquility service quality, suggesting that moderately fragmented green spaces are, in this context, slightly associated with higher tranquility ratings in dense urban environments. Conversely, PRD shows a negative correlation, implying that higher typological diversity of green spaces is associated with lower tranquility service quality, potentially reflecting stronger co-location with human activity. SHAPE displays a weak negative association, indicating that morphological complexity alone does not substantially enhance tranquility. These findings underscore the context-dependent relationship between green space morphology and tranquility services, providing theoretical and practical insights for shifting urban green space planning from quantitative expansion toward morphological optimization. Â© The Author(s), under exclusive licence to Springer Nature B.V. 2026.},
  publisher = {Springer Science and Business Media B.V.},
  issn = {1387585X},
  keywords = {Landscape pattern; Morphology-function relationship; Noise complaints; Tranquil perception; Urban acoustic environment},
}

@article{therein15minutestheimpactofurb2026,
  author = {Mondelli F.P.},
  title = {{There} in 15 minutes? {The} impact of urban morphology on the perception of proximity and the use of public space},
  year = {2026},
  volume = {168},
  doi = {10.1016/j.cities.2025.106456},
  abstract = {This study explores the applicability of the 15-minute city (15MC) model within the metropolitan areas of western European cities, with a particular focus on the role of urban form and public space design in shaping residents' perceptions and behaviors. While existing research on the 15MC has primarily taken a quantitative approachâmeasuring proximity to servicesâthis study adopts a qualitative perspective. The first part of the research presents a comparative analysis of proximity-oriented initiatives in Paris, Barcelona, and Milanâprimarily implemented in compact urban contextsâcontrasted with Rome's 1990s Centopiazze program, which targeted more sprawling urban environments. The second part focuses specifically on the case of Rome, analyzing seven public space interventions carried out under the Centopiazze program across different neighborhoods and urban morphologies. These squares were evaluated through site visits and original surveys to incorporate residents' perceptions. Findings indicate that proximityâunderstood as access within a 15-minute radiusâand availability of services alone are not sufficient to ensure that a public square becomes, or is perceived as, a vibrant and central neighborhood space. Rather, well-designed public spaces embedded within compact urban morphologies contribute to a stronger perception of local centrality and help reinforce the experience of proximity. This study seeks to enrich academic discourse on the 15MC by offering a new perspective that highlights the importance of spatial form and user perception, providing insights to support planning strategies that foster proximity at the metropolitan scale within the European context. Â© 2025 The Author},
  publisher = {Elsevier Ltd},
  issn = {2642751},
  keywords = {15-minute city; Metropolitan areas; Proximity; Public space; Urban morphology},
}

@article{shapingthebalancetheinfluenceo2026,
  author = {Aigbona C.},
  title = {{Shaping} the balance: {The} influence of personal values, personality, and generational ideologies on {Gen} {Z} pharmacistsâ work-life integration in {Lagos}},
  year = {2026},
  doi = {10.1080/15555240.2026.2681083},
  abstract = {This qualitative study explores how Generation Z community pharmacists in Lagos, Nigeria, navigate work-life integration (WLI). Acknowledging a research gap in this demographic and context, we conducted semi-structured interviews with 54 Gen Z community pharmacists. The study utilized thematic analysis, grounded in theories such as Conservation of Resources, Boundary, Generational, and Personality theories. Findings reveal that pharmacists face significant WLI challenges due to demanding work conditions, including long hours, understaffing, and sales pressure, compounded by Lagosâs unique urban environment and economic hardships. A key finding is that individual differences, specifically personal values, personality traits, and Gen Zâs distinct ideologies, profoundly influence their WLI perceptions and coping strategies. These ideologies include a strong emphasis on mental health, a desire for flexibility, and a willingness to seek international opportunities. Their future aspirations are centered on achieving autonomy and a better quality of life through entrepreneurship, career diversification, or migration. This research provides empirical insights into Gen Zâs WLI in a non-Western context, offering theoretical validation and practical recommendations for stakeholders. These recommendations aim to improve working conditions, offer fair pay, and provide flexible work options and robust well-being support to foster sustainable WLI and talent retention within the Nigerian pharmacy sector. Â© 2026 Taylor \& Francis Group, LLC.},
  publisher = {Routledge},
  issn = {15555240},
  keywords = {generation Z; Nigeria; personality; pharmacists; Work-life integration},
}

@article{smartandhappycitiestowardsadef2026,
  author = {Pinna C.; Torlini A.; Poplin A.; Garau C.},
  title = {{Smart} and {Happy} {Cities:} {Towards} a {Definition} and a {Methodology} for {Evaluating} the {Emotional} {Perception} of {Happiness}},
  year = {2026},
  volume = {15898 LNCS},
  doi = {10.1007/978-3-031-97657-5_9},
  abstract = {This research examines the concept of the human-scale city, developing a technique applicable to neighbourhoods to enhance their sustainability, liveability, walkability, well-being, and the happiness perceived by residents. This study aims to show the importance of an interdisciplinary approach by addressing the methodological gap prevalent in traditional literature that underscores the division between the examination of urban infrastructures, typically within the engineering domain, and the analysis of social dynamics, a focus in a sociology domain. This separation has historically limited the comprehension of the complex processes that influence cities and the experiences of their residents. The methodology adopted for assessing proximity and urban happiness combines qualitative approaches with quantitative studies, including the establishment of indices and indicators directly associated with neighbourhood liveability. This work facilitated the integration of empirical data with the subjective perceptions experienced by users of urban places regarding proximity, safety, comfort, well-being, and pleasure experienced at urban spaces. The application of this approach examined in the San Benedetto neighbourhood of Cagliari (Italy) highlighted the importance of the emotional dimension in evaluating the design effectiveness of an urban environment, aiding in the conceptualisation of an ideal âHappy Cityâ model. This study demonstrates the modelâs applicability in many urban contexts, emphasising that the realisation of a âA Smart, and Happy Cityâ requires a comprehensive and coordinated spatial approach. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303197656-8},
  issn = {3029743},
  keywords = {Accessibility; Cagliari; Emotions; Happy City; Healthy City; Measuring Happiness; Pedestrianisation; Proximity; Smart City; Urban Happiness; Urban Planning; Walkability},
}

@article{anewtheorizationofnonbinaryurb2026,
  author = {BoÄaÃ§ C.},
  title = {{A} new theorization of non-binary urban geographies: introducing the âurban grotesqueâ},
  year = {2026},
  volume = {108},
  number = {2},
  doi = {10.1080/04353684.2024.2405682},
  abstract = {This article introduces the âurban grotesqueâ as a novel theoretical lens to explore non-binary urban representations, using the LokmacÄ±/Ledra Street Buffer Zone in Nicosia, Cyprus, as a case study. Situated in a city divided by conflict, the Buffer Zone serves as a living laboratory for examining the complex interplay of memory, identity, and place beyond traditional binary frameworks. Through a rich tapestry of empirical observations and qualitative urban ethnography, the study traces the Buffer Zoneâs transformation from a symbol of division to a vibrant place of non-binary urban representation. It highlights transformative events and movements that challenge binary norms and foster a sense of belonging and inclusivity, illustrating the fluid nature of urban places shaped by an array of social practices and experiences. The âurban grotesqueâ, inspired by Bakhtinâs conception of transformation and ambivalence, emerges as a pivotal framework for understanding the essence of non-binary urban geographies. This perspective not only bridges the theoretical and empirical but also enriches our perception of urban places as realms of endless becoming, inviting us to see beyond dichotomies. Ultimately, this study promotes an inclusive, dynamic comprehension of urban places in conflict zones, highlighting non-binary perspectives to enrich urban environments. Â© 2024 Swedish Society for Anthropology and Geography.},
  publisher = {Routledge},
  issn = {4353684},
  keywords = {buffer zone; Cyprus; Nicosia; Non-binary urban representation; urban grotesque},
}

@article{signalinsightanefficienttraffi2026,
  author = {Wang W.},
  title = {{Signal-Insight:} {An} {Efficient} {Traffic} {Signal} {Detection} {Algorithm} {Based} on {YOLOv12}},
  year = {2026},
  doi = {10.1109/AIITA69518.2026.11567032},
  abstract = {Accurate traffic signal detection is essential for intelligent transportation systems and autonomous driving but remains challenging due to small object size, complex backgrounds, and varying illumination. To overcome the limitations of YOLOv12 in long-distance and small-object scenarios, this paper proposes Signal-Insight, an enhanced detection framework for traffic signals. The model incorporates a Multi-Scale Signal Semantic Fusion module to improve small-object perception, a Traffic Scene-Guided Attention mechanism to suppress background interference, and a Micro-Structure Reinforcement Enhancer to strengthen edge and color representation for distant or occluded targets. Experiments on a self-constructed dataset show that the proposed method achieves 96.8% mAP while maintaining real-time performance, outperforming the baseline YOLOv12 in both Precision and Recall, demonstrating its effectiveness in complex urban environments. Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833156113-0},
  keywords = {Deep learning; Intelligent transportation systems; Small object detection; Traffic signal detection; YOLOv12},
}

@article{dodensecitieshaveenoughspaceto2026,
  author = {Jelo G.; Privitera R.; La Rosa D.},
  title = {{Do} {Dense} {Cities} {Have} {Enough} {Space} to {Accommodate} {Nature-Based} {Solutions?} {A} {European} {Wide} {Data-Based} {Approach} for {Their} {Spatial} {Localisation}},
  year = {2026},
  volume = {826 LNCE},
  doi = {10.1007/978-3-032-18822-9_25},
  abstract = {Contemporary cities are facing several challenges such as urban heat islands, floodings and many other climate change related risks. These risks are increased in particular contexts of the city that are poorly resilient due to the prevalence of impervious surfaces. To cope with these issues, Nature-based Solution (NbS) have emerged as a strategy to address urban risks, leveraging nature to deploy and manage urban ecosystems through providing urban ecosystem services. This study proposes a GIS-based methodology to assess the potential spatial locations of NbS in public open spaces of dense urban settings, through using open source and widely available European-wide data sources. The method consists of four main steps: (1) vegetation cover and public open spaces analyses; (2) selection of potentially transformable vegetation cover and public open spaces patches; (3) NbS database realisation to catalogue suitable solutions to mitigate the two specific risks of urban heat islands and floodings, suitable for inclusion in such a dense context; (4) transformation scenarios assessment. Accordingly, two scenarios (inclusion of NbS in existing greenery and installation of NbS in impervious surfaces) are drawn. The case study of the historic centre of Catania (Italy) is here presented. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303218821-2},
  issn = {23662557},
  keywords = {climate change; high density; historic centres; Nature-based Solutions; urban risks},
}

@article{harnessingsocialsensingforreal2026,
  author = {Giner PÃ©rez de Lucia J.; LÃ³pez-Ballesteros A.; FernÃ¡ndez-PedauyÃ© J.; Senent-Aparicio J.; Cecilia J.M.},
  title = {{Harnessing} social sensing for real-time flood event reconstruction: {A} digital autopsy of the 2024 {Valencia} {DANA}},
  year = {2026},
  volume = {132},
  doi = {10.1016/j.ijdrr.2025.105966},
  abstract = {Extreme rainfall and flash-flood events in the Western Mediterranean pose persistent challenges for real-time monitoring and emergency response. Traditional hydrometeorological networks often provide limited spatiotemporal coverage during rapidly evolving events, leading to localized blind spots. This study reconstructs the impacts of the October 2024 catastrophic floods in Valencia using more than 156,000 geolocated messages from X (formerly Twitter) as a form of social sensing. These citizen-generated data were integrated with hydrological and hydraulic modeling to contextualize reported flood dynamics and response gaps. Advanced Natural Language Processing (NLP) techniques were applied to extract spatiotemporal patterns of public perception, emergency reactions, and infrastructure disruptions. In addition, a Retrieval-Augmented Generation (RAG) system was implemented to transform unstructured messages into structured event summaries, providing actionable insights during the disaster window. The analysis revealed a clear temporal alignment between social media activity and flood progression, with online reporting peaking shortly after critical impact thresholds. Cross-validation with hydrological simulations confirmed the potential of social sensing to detect localized effects often missed by conventional monitoring, while also exposing the limitations of relying solely on proxy digital traces. Overall, the Valencia case demonstrates the feasibility of integrating human-sensed information with physically based models to enhance situational awareness and support adaptive, data-driven disaster risk reduction in urban environments. Copyright Â© 2025. Published by Elsevier Ltd.},
  publisher = {Elsevier Ltd},
  issn = {22124209},
  keywords = {Disaster resilience; Emergency response; Flood reconstruction; Hydrological modeling; Natural Language Processing; Social sensing},
}

@article{gnsspositioningbasedon3dlidarp2026,
  author = {Liu B.; Han K.; Deng Z.; Ding Z.},
  title = {{GNSS} {Positioning} {Based} on {3D} {LiDAR} {Perception} and {Virtual} {Grid-Based} {Differential} {Correction} in {Urban} {Environments}},
  year = {2026},
  doi = {10.1109/TVT.2026.3663277},
  abstract = {Accurate global navigation satellite system (GNSS) positioning in urban canyon environments is severely challenged by non-line-of-sight (NLOS) errors caused by signal blockage and multipath propagation. This paper proposes a novel GNSS localization framework that integrates three-dimensional (3D) light detection and ranging (LiDAR) perception with virtual grid-based differential correction to improve positioning performance for both multi-sensor receivers (core nodes) and surrounding low-cost GNSS devices (base nodes). First, an NLOS identification method is developed by combining LiDAR-based ray tracing with pseudorange innovation clustering, enabling reliable detection of mid- and high-elevation NLOS satellites. Then, a satellite selection strategy based on dilution of precision (DOP) optimization is proposed to balance NLOS error compensation and satellite geometry preservation. For cooperative localization, a dynamic virtual grid is constructed around the core node, and pseudorange observations are simulated to generate spatially correlated reference points, allowing base nodes to perform single-differenced positioning relative to the core node. Experimental results on the UrbanNav dataset demonstrate that the proposed framework significantly improves GNSS positioning accuracy and stability for the core node in complex urban scenarios. Meanwhile, it enhances the localization performance of nearby low-cost terminals through real-time environmental information sharing. Â© 1967-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {189545},
  keywords = {3D LiDAR; DOP optimization; GNSS; NLOS; pseudorange differential positioning; urban canyons},
}

@article{introduction2026,
  author = {Kuzma K.; Pfeifer M.},
  title = {{Introduction}},
  year = {2026},
  doi = {10.4324/9781003708964-1},
  abstract = {Cities and urban settings have populated the screen since the invention of the movie camera, which coincided with industrial urbanization. As the setting of some of the earliest films ever produced, cities became an early subject matter of cinematic exploration. A 1911 article in the Perth Sunday Times about a screening of Marvellous Melbourne: Queen City of the South, one of the first âcity films,â reported that the filmâs opening featured two âphantom ridesâ shot from the front of a cable tram. A Melbourne man, having just arrived in Perth, reportedly dozed off during the screening at the Kingâs Picture Garden. When he awoke to the tram sequence, the effect was so convincing that he believed himself to be back in Melbourne, watching the city approach along St. Kilda Road (âThe Vision,â 1911, p. 6). Such ârecordingsâ are increasingly accepted as significant historical documents as they demonstrate how cinema shaped new forms of urban perception. The experience of the spectator may have reflected that of many city dwellers who found themselves unsettled by the rapidly changing urban environment, where shifting sights, sounds, and rhythms created a dreamlike sense of dislocation. However, Marvellous Melbourne also presented a selective vision of the city. The film was produced for middle-class viewers and potential tourists, and omitted Melbourneâs growing Asian population, working-class neighborhoods, and industrial zones. Â© 2026 selection and editorial matter, Konstanty Kuzma and Moritz Pfeifer; individual chapters, the contributors. All rights reserved.},
  publisher = {Taylor and Francis},
  isbn = {978-104084080-1; 978-946372747-1},
}

@article{intersectioninformationmodelli2026,
  author = {Jiang Y.; Ying S.; Sun G.; Liang Y.},
  title = {{Intersection} {Information} {Modelling} and {Case} {Analysis} under the {Dual} {Drive} of {Path} {Guidance} and {Scenario} {Constraints}},
  year = {2026},
  volume = {38},
  number = {6},
  doi = {10.7307/ptt.v38i6.1369},
  abstract = {This study proposes a novel intersection-centric information framework, offering a new perspective and a practical approach to enabling autonomous vehicles (AVs) to navigate intersections safely and efficiently. While high-definition (HD) maps provide rich spatial information for autonomous driving, their excessive data volume often leads to increased computational burden and delays, particularly in intersection environments where timely positioning, perception, and decision-making are critical. To address this issue, we introduce the Road-Lane-Device-Scenario (RLDS) model, which separates and extracts key static and dynamic intersection elements, focusing on essential semantic features such as lane topology, traffic signal logic, and right-of-way rules. This targeted framework introduces an innovative approach to reduce data redundancy, thereby providing significant potential for enhancing the efficiency and intelligence of information processing and decision-making in autonomous driving systems. By effectively addressing the critical bottlenecks associated with intersection scenarios, the proposed framework demonstrates strong potential for practical application, enabling safer, more reliable, and more efficient autonomous vehicle operations in complex urban environments. Â© 2026 Faculty of Transport and Traffic Engineering. All rights reserved.},
  publisher = {Faculty of Transport and Traffic Engineering},
  issn = {3535320},
  keywords = {autonomous driving; high-definition map; intersection information; Road-Lane-Device-Scenario (RLDS) model; traffic; transportation},
}

@article{amultidisciplinaryapproachtoas2026,
  author = {Nestoros E.C.; Martinez-Alcaraz P.; Fuentes A.; Cadena J.D.B.; Turrin M.; Poli T.; Luna-Navarro A.},
  title = {{A} {Multi-disciplinary} {Approach} to {Assessing} the {Influence} of {Facade} on {Outdoor} {Thermal} {Comfort:} {A} {Case} {Study} of {Milan}},
  year = {2026},
  volume = {763 LNCE},
  doi = {10.1007/978-3-032-06810-1_90},
  abstract = {Urbanization and climate change have intensified urban heat island effects, significantly affecting outdoor thermal comfort (OTC) in cities. Traditional methods of assessing the influence of urban environments on OTC often rely heavily on computational simulations, neglecting the integration of user-centric data and comprehensive environmental monitoring. This study investigates the relationship between microclimatic conditions, thermal sensation, and human preferences to identify the key factors influencing outdoor thermal comfort. Using the Acqua-bella district in Milan as a case study, the research adopts a cross-examination approach that integrates qualitative and quantitative assessments to evaluate outdoor thermal conditions. The methodology combines user-centered participatory approaches, including a workshop and an online survey, to identify critical intervention areas and factors contributing to thermal discomfort. Thermal Sensation Votes (TSV) are collected and analyzed in QGIS, highlighting significant environmental and psychological factors influencing user perception. Preliminary simulations using SOLWEIG are employed to cross-examine the results, identifying spaces with varying levels of thermal comfort. This study underscores the value of combining objective and subjective measures to pinpoint areas of critical environmental quality and optimize decision-making processes. By leveraging user data, the methodology reduces computational demands while offering actionable insights for urban health. The approach is scalable to different urban contexts, fostering the development of resilient and climate-adaptive environments. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303206809-5},
  issn = {23662557},
  keywords = {citizen science; mixed methods; multi-domain; Outdoor Thermal Comfort; Perception},
}

@article{decodinghumansafetyperceptionw2026,
  author = {Kang Y.; Chen J.; Liu L.; Sharma K.; Mazzarello M.; Mora S.; Duarte F.; Ratti C.},
  title = {{Decoding} human safety perception with eye-tracking systems, street view images, and explainable {AI}},
  year = {2026},
  volume = {123},
  doi = {10.1016/j.compenvurbsys.2025.102356},
  abstract = {The way residents perceive safety plays an important role in how they use public spaces, and it informs city planning and public policy. Recent studies have combined street view images and advanced computer vision techniques to measure human safety perceptions of urban environments. Despite their success, such studies have often overlooked the specific environmental visual factors that draw human attention and trigger people's feelings of safety perceptions. In this study, we introduce a computational framework that enriches the existing body of literature on place perception by using eye-tracking systems with street view images and explainable AI approaches. Eye-tracking systems measure what users are looking at and how long they engage with specific environmental elements. This allows us to explore the nuance of which visual environmental factors influence human safety perceptions. We conducted our research and recruited volunteers in Helsingborg, Sweden. By examining participantsâ focus on specific features using Mean Object Ratio in Highlighted Regions (MoRH) and Mean Object Hue (MoH), we identified key visual elements that attract human attention when perceiving safe environments. For instance, certain urban infrastructure (e.g., stairways and signboards) and public space (flags and chairs) features draw more human attention while the sky is less relevant in influencing safety perceptions. These insights offer a more human-centered understanding of which urban features influence human safety perceptions. Furthermore, we compared the real human attention from eye-tracking systems with attention maps obtained from eXplainable Artificial Intelligence (XAI) results. Several XAI models were tested, and we observed that XGradCAM and EigenCAM most closely align with human safety perceptual patterns. Our framework provides a valuable approach to enhance the interpretability and trustworthiness of XAI models by comparing them with empirically observed human behavior data. This study demonstrates the limitations of previous place perception studies that solely rely on street view images and computer vision techniques, which may not comprehensively capture the nuanced human experiences and behaviors at place. The inclusion of technologies such as eye-tracking not only deepens our comprehension of human subjective experiences, but also contributes to the development of safer environments and communities. Â© 2025 Elsevier Ltd},
  publisher = {Elsevier Ltd},
  issn = {1989715},
  keywords = {Explainable artificial intelligence; Eye-tracking systems; Perceptions; Street view images},
}

@article{perceptionsandselfreportedpede2026,
  author = {Bouhouras E.; Giapitzoglou P.; Gishti E.; Campisi T.; Fountas G.; Basbas S.},
  title = {{Perceptions} and {Self-Reported} {Pedestrian} {Behavior} at {Signalized} {Crosswalks:} {A} {Comparative} {Survey} in {Greece} and {Italy}},
  year = {2026},
  volume = {814 LNCE},
  doi = {10.1007/978-3-032-16695-1_47},
  abstract = {Urban environments face increasing challenges in ensuring pedestrian safety, particularly at signalized crosswalks where traffic lights grant pedestrians the right of way and vehicles are required to stop. These challenges, driven by growing traffic volumes and complex mobility systems, necessitate a careful balance between safety and efficiency. This study investigates pedestrian safety at signalized crosswalks in Thessaloniki, Greece (Aristotle University of Thessaloniki (AUTh) and Enna, Italy (Kore University of Enna) focusing on students as a key demographic. This research is based on a structured questionnaire survey administered to university students at Aristotle University of Thessaloniki (Greece) and Kore University of Enna (Italy). The survey gathered information on demographic characteristics, crossing habits, perceived safety, and preferences for infrastructural improvements. Respondents also identified factors influencing their crossing decisions, such as urgency, signal duration, and vehicle speeds. The findings reveal that short green-light durations and vehicle non-compliance significantly compromise pedestrian safety. Issues such as inadequate crosswalk visibility and poor markings were also noted. Participants emphasized the need for stricter enforcement of traffic laws, improved lighting, and tactile pathways to enhance accessibility. This research highlights the importance of addressing both behavioral and infrastructural aspects of pedestrian safety. Recommendations include optimizing signal timings for diverse pedestrian speeds, raising driver awareness of pedestrian rights, and employing monitoring systems like traffic cameras. By integrating these measures, urban planners can create safer, more inclusive environments that prioritize pedestrian mobility while maintaining traffic efficiency. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303216694-4},
  issn = {23662557},
  keywords = {case studies comparison; crosswalks; mediterranean pedestrian behavior; road safety; road vulnerable users; Signalized intersections},
}

@article{enhancingindependentmobilityfo2026,
  author = {Shanker S.; Radhu Krishna R.},
  title = {{Enhancing} {Independent} {Mobility} for the {Visually} {Impaired} {Through} {Real-Time} {Vision-based} {Obstacle} {Detection} and {Audio} {Guidance}},
  year = {2026},
  doi = {10.1109/ICICT68280.2026.11510938},
  abstract = {Reliable real-time navigation assistance is essential for visually impaired individuals navigating complex urban environments that contain diverse static and dynamic obstacles. An assistant system that is based on vision is created by combining lightweight YOLOv8n object detection and dense optical flow-based motion analysis to improve the perception of the environment and motion awareness under realistic conditions. The system has been organized into five synchronized units, which include systems of preprocessing, obstacle detection, detection handling, movement detection and audio feedback. Ego-motion compensation is done through homography transformation and parallax adjustment to ensure that motion interpretation is robust when the user is in continuous motion and the camera is moving, rather than moving the object being observed. The lightweight model architecture enables real-time performance on small, constrained resource, hardware platforms. The system identifies and categorizes six classes of objects of interest to navigation such as crosswalks, obstacles, pedestrians, signals, stairs and vehicles and gives real-time audio feedback with the eSpeak text-to-speech engine. On an experimental evaluation of 8,111 annotated cases, the performance of detection is strong with a total performance of 0.800 and 0.768 recall with mAP at 0.5 and mAP at 0.5:0.95, respectively. Critical classes, including vehicles (mAP at 0.5 = 0.919) and pedestrians (mAP at 0.5 = 0.915) are found to have high detection accuracy, which is indicative of good obstacle awareness. These findings demonstrate the efficiency of the proposed system in enhancing the level of safety in navigation, situational awareness and autonomous mobility among the visually impaired users. Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833156917-4},
  keywords = {AI in Disability; assistive technology; Computer vision; Machine learning; obstacle detection; visual impairment},
}

@article{biophilicdesigntowardssustaina2026,
  author = {Zhong W.; SchrÃ¶der T.; Bekkering J.},
  title = {{Biophilic} design towards sustainability in architecture: {An} evaluation framework and design guidelines for three-dimensional green spaces},
  year = {2026},
  volume = {287},
  doi = {10.1016/j.buildenv.2025.113868},
  abstract = {Biophilic design has gained increasing attention for its potential to foster contact with ânatureâ and create more sustainable built environments. However, how to conceptualise and implement âsustainabilityâ in architecture remains contested, raising unresolved questions about which sustainability challenges biophilic design can respond to. Additionally, biophilic design encompasses various approaches for integrating ânatureâ in architecture, yet research on three-dimensional green spaces (e.g. indoor gardens and green balconies) remains limited, particularly concerning their effectiveness and evidence-based designs for sustainability. This study aims to explore three-dimensional green spaces (termed âgreen pocketsâ here) to understand their impacts on sustainability, exemplify biophilic design practices, and formulate design guidelines to advance design with ânatureâ. We identify the benefits of green pockets in addressing ten sustainability challenges across three scales (urban environment, building performance, and human perception) and propose an evaluation framework for analysing their performance. Afterwards, we investigate the state-of-the-practice of green pockets through case studies of 20 built examples. Moreover, we distil design guidelines tailored for green pockets from a typology study employing the âresearch by designâ method, combined with SWOT analysis. The findings reveal that green pockets hold potential value in tackling multifaceted sustainability challenges, necessitating thorough consideration of trade-offs and synergistic benefits in implementing biophilic design. Incorporating diverse green pocket types and rich natural elements helps maximise the effectiveness of biophilic design in urban architecture. Overall, this research offers insights into the complexity of âsustainabilityâ and the implications of biophilic design, supporting more effective nature-based designs for sustainable futures. Â© 2025 Elsevier Ltd},
  publisher = {Elsevier Ltd},
  issn = {3601323},
  keywords = {Biophilic design; Design guidelines; Green spaces; Performance evaluation; Sustainability; Sustainable architecture},
}

@article{towardsautonomousuavvisualobje2026,
  author = {Ji Y.; Zhu Z.; Zhao Y.; Liu B.; Gao C.; Zhao Y.; Qiu S.; Hu Y.; Yin Q.},
  title = {{Towards} {Autonomous} {UAV} {Visual} {Object} {Search} in {City} {Space:} {Benchmark} and {Agentic} {Methodology}},
  year = {2026},
  volume = {40},
  number = {22},
  doi = {10.1609/aaai.v40i22.38898},
  abstract = {Aerial Visual Object Search (AVOS) tasks in urban environments require Unmanned Aerial Vehicles (UAVs) to autonomously search for and identify target objects based on visual inputs without external guidance. Existing approaches struggle in complex urban environments due to redundant semantic processing, similar object ambiguity, and the exploration-exploitation dilemma. To advance research and support the AVOS task, we introduce CityAVOS, the first benchmark dataset for autonomous search of static urban objects. It features 2,420 tasks of varying difficulty across six object categories, designed to rigorously evaluate UAV search strategies. To solve the AVOS task, we also propose PRPSearcher (Perception-Reasoning-Planning Searcher), a novel agentic method powered by multi-modal large language models (MLLMs) that enables a UAV agent to reason like humans on visual cues when searching for objects. Specifically, PRPSearcher constructs three specialized 3D maps: an object-centric dynamic semantic map enhancing spatial perception, a cognitive map based on semantic âat-tractionâ values for target reasoning, and an uncertainty map for balanced exploration-exploitation search. Moreover, we propose a denoising mechanism to mitigate interference from similar objects and design an âInspiration Promote Thoughtâ prompting mechanism for adaptive action planning. Experimental results on CityAVOS demonstrate that PRPSearcher surpasses existing baselines in both success rate and search efficiency (on average: +37.69% SR, +28.96% SPL,-30.69% MSS, and-46.40% NE). Our work paves the way for future advances in embodied visual target search. Â© 2026, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
  publisher = {Association for the Advancement of Artificial Intelligence},
  isbn = {978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7; 978-157735906-7},
  issn = {21595399},
}

@article{positivityandnegativitybiasesa2026,
  author = {Descours T.; CarriÃ¨re S.M.; Moreau C.; Boudjema V.; Blanco J.},
  title = {{Positivity} and {Negativity} {Biases} {About} {Animals} {Revealed} {Through} {Emotions,} {Attitudes,} and {Cognitive} {Salience} in a {French} {National} {Park}},
  year = {2026},
  volume = {31},
  number = {1},
  doi = {10.1080/10871209.2025.2467376},
  abstract = {Human cognition is subject to a plethora of cognitive biases, including positivity and negativity biases, that impact human relationships with non-human life forms but remain largely underexplored. To address this gap, this study introduces an interview-based method to investigate positivity and negativity biases in peopleâs perceptions of animal species. Conducted in Franceâs Cevennes National Park, the study comprised 100 interviews to evaluate (i) the cognitive salience of animals via free-listing tasks and (ii) individualsâ attitudes and emotions toward the listed animals. Respondents identified 154 animals, predominantly associating them with positive attitudes and emotions. Interestingly, animals evoking positive emotions displayed greater cognitive salience, while those perceived to be negatively ranked second in salience. These findings, consistent with other studies, underscore the significance of emotions and suggest the presence of both positivity and negativity biases. Reinforcing research on cognitive biases could help conservation practitioners better orient their action and communication with the public. Â© 2025 Taylor \& Francis Group, LLC.},
  publisher = {Routledge},
  issn = {10871209},
  keywords = {Environmental psychology; ethnobiology; free-listing; human-nature relationships; mixed-methods; natureâs contributions to people},
}

@article{evaluatingthespatialtemporalim2026,
  author = {Huang Y.; Du J.; Chen M.; Lin Y.; Huang S.; Cai Y.},
  title = {{Evaluating} the spatial-temporal impact of urban nature on urban vitality in {Vancouver:} {A} social media and {GPS} data approach},
  year = {2026},
  volume = {160},
  doi = {10.1016/j.landusepol.2025.107824},
  abstract = {Natural elements in urban environments enhance livability and health, strengthening urban vitality. However, existing research has primarily focused on physical indicators, with limited attention paid to the joint influence of behavioral and perceptual dimensions on urban vitality. To address this gap, this study integrates a spatiotemporal analytical framework encompassing three dimensions: natural elements, human perception, and activity diversity. Focusing on Vancouver, we utilized smartphone-GPS and social media data from 2018 to 2023 to explore temporal (weekdays vs. weekends) and spatial dimensions. Using machine learning techniques (Google vision, K-means and Sentiment analysis) on multivariate social media data, and we also analyzed changes in activity diversity over time. We assessed the multidimensional influences on urban vitality using the Geographically and Temporally Weighted Regression (GTWR) model. Our results show that during the pandemic, attention to nature and outdoor activities increased significantly, while cultural and social activities and transportation initially decreased but quickly recovered. Sentiment scores, natural elements, and human activity preferences significantly influenced urban vitality during COVID-19, with notable spatiotemporal heterogeneity. The pandemic intensified residents' reliance on natural spaces and green transportation, altering the spatial distribution of urban vitality. These findings provide a basis for optimizing natural spaces and sustainable transportation planning in future urban development. Â© 2025 The Authors},
  publisher = {Elsevier Ltd},
  issn = {2648377},
  keywords = {Computer vision; Crowdsourced data; Geographically and Temporally Weighted Regression; Mobility data; Natural language processing; Urban nature environment; Urban vitality},
}

@article{designofmlcasfmultilayercontex2026,
  author = {Sukumar R.; Sathishkumar V.E.},
  title = {{Design} of {ML-CASF:} {Multilayer} {ContextAware} {Sensor} {Fusion} for {Autonomous} {Vehicles} in the {Internet} of {Vehicles}},
  year = {2026},
  doi = {10.1002/9781394311729.ch3},
  abstract = {With perception optimization and decision-making accuracy, sensor fusion techniques have significantly enhanced autonomous Internet of Vehicles (IoV) systems. Real-time processing, heterogeneous environmental conditions, and faulty sensors plague the existing techniques. In this study, a novel multilayer contextaware sensor fusion (ML-CASF) model based on graph attention network (GAT) adaptive weighting is proposed to fuse LiDAR, radar, camera, and vehicle-toeverything communication data. Besides that, a Bayesian uncertainty estimation module provides robustness against malicious attacks and sensor noise. ML-CASF achieves 96.4% localization accuracy, 94.7% object detection accuracy, and 92.1% collision avoidance success rate, according to IoV dataset experiments. These measures are the extent to which ML-CASF works to provide secure and reliable autonomous navigation in realistic urban environments. These outcomes show the capability of ML-CASF in providing safe and accurate autonomous navigation in challenging city environments. Â© 2026 Scrivener Publishing LLC.},
  publisher = {wiley},
  isbn = {978-139431172-9; 978-139431169-9},
  keywords = {camera; collision avoidance; graph attention network; IoV systems; LiDAR; radar; Sensor fusion; V2X communication},
}

@article{modulatingauditoryloomingperce2026,
  author = {Mashiba Y.; Tokunaga K.; Wakatsuki N.; Yano H.; Zempo K.},
  title = {{Modulating} {Auditory} {Looming} {Perception} via {Dynamic} {Frequency} {Shifting} to {Enhance} {Pedestrian} {Situation} {Awareness}},
  year = {2026},
  volume = {14},
  doi = {10.1109/ACCESS.2026.3706113},
  abstract = {Ensuring pedestrian safety in urban environments is a critical challenge, yet conventional warning systems that rely on strong multimodal stimuli can often be intrusive or disrupt the user experience. To address this, we propose an auditory interface that augments approaching vehicle sounds using dynamic frequency shifting as time to collision (TTC) decreases. Rather than adding explicit alarm tones, the method aims to embed salience in the existing soundscape while preserving ecological realism. We conducted a VR-based listening study (N=30) using recorded urban ambience and vehicle sounds, manipulating the frequency shift ratio (0.5Ã , 1Ã , 2Ã , 3Ã ) and vehicle speed (30 vs. 40 km/h). Results showed that stronger upward frequency shifting led participants to (i) predict collisions earlier, (ii) overestimate vehicle speed, and (iii) judge the vehicle as closer than it physically was. Importantly, upward frequency shifting up to Ã3Ã did not significantly reduce perceived realism compared with unmodified sounds in most conditions. These findings indicate that dynamic frequency shifting can systematically bias TTC, speed, and distance judgments in a conservative direction and may therefore support unobtrusive pedestrian attention guidance. Long-term acceptance, habituation, and effects on real-world behavior require further investigation.  Â© 2026 The Authors.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {21693536},
  keywords = {Auditory augmented reality; auditory looming perception; pedestrian safety},
}

@article{aninterdisciplinaryframeworkfo2026,
  author = {Kamanmalek S.; Decuir J.; Blackwell B.},
  title = {{An} {Interdisciplinary} {Framework} for {Evaluating} {Behavioral} {Interventions} and {Safety} {Strategies} for {Distracted} {Pedestrians}},
  year = {2026},
  doi = {10.1061/9780784487020.006},
  abstract = {Pedestrian distraction, particularly from smartphone use, has emerged as a significant safety concern at signalized crosswalks and other high-conflict pedestrian environments. Distraction reduces situational awareness, delays responses to traffic cues, and increases the risk of injury, yet most countermeasures remain reactive or punitive. Addressing this issue requires an evidence-based understanding of behavioral patterns and intervention strategies that extend beyond traditional engineering solutions. This study presents an interdisciplinary research framework that integrates behavioral science, engineering, and management principles to mitigate distracted walking, promote fair enforcement, and enhance pedestrian safety through education and awareness. The methodology included three components: (1) a comprehensive literature review analyzing national and international approaches to distracted-pedestrian management and public awareness initiatives; (2) development and pilot testing of a student survey examining perceptions of risk, intervention acceptability, and enforcement preferences; and (3) facilitation of a Pedestrian Distraction and Safety Workshop engaging undergraduate civil and environmental engineering students in evaluating behavioral interventions and co-designing safety frameworks. Results showed strong student support for educational campaigns, tiered enforcement structures, and technology-assisted alerts such as smart crosswalks and mobile reminders. Participants emphasized that enforcement should prioritize awareness and warnings before financial penalties and should account for fairness, practicality, and behavioral context. Qualitative feedback highlighted the importance of framing distracted walking as both an engineering and behavioral challenge. Drawing on these findings, the study proposes a three-stage intervention framework (i.e., awareness, warning, and limited enforcement) to promote behavioral change through education and reinforcement rather than punishment. This framework illustrates how behavioral data can inform context-specific, evidence-based strategies for improving pedestrian safety. The project demonstrates a practical model for integrating education, research, and framework development in transportation safety. The participatory process strengthened student understanding of interdisciplinary problem-solving and developed workforce skills applicable to transportation planning and management. Overall, the findings advance understanding of how behavioral insights, engineering design, and management strategies can be aligned to reduce pedestrian distraction and enhance safety in urban environments. Â© 2026 ASCE.},
  publisher = {American Society of Civil Engineers (ASCE)},
  isbn = {978-078448702-0},
}

@article{naturesvalueassociatedwithtrad2026,
  author = {Tateishi W.; Nakawake Y.; Fujii S.; Shibasaki S.; Nakadai R.},
  title = {{Nature's} value associated with traditional worldviews: psychological validation of relational, intrinsic, and instrumental dimensions in {Japan}},
  year = {2026},
  volume = {10},
  doi = {10.1016/j.cresp.2025.100259},
  abstract = {Understanding how people perceive the value of nature is essential for protecting nature. Previous studies have proposed three types of nature's value: instrumental, intrinsic, and relational. Relational value refers to the perceived appropriateness of the relationship individuals maintain with nature. Although relational values have been discussed in the context of traditional worldviews, empirical research examining the associations among the three types of nature's values and traditional beliefs remains limited. This study investigated the connections between perceptions of nature's value and traditional religious-oriented worldviews, including animism and anthropocentrism. To explore whether the three types of nature's value are applicable in a non-Western context, we conducted a preregistered online survey with 745 Japanese participants. Our findings indicate that (i) relational value is linked to traditional religious-oriented worldviews; (ii) relational value shows a strong association with scales measuring human-nature relationships; and (iii) the distinctions among instrumental, intrinsic, and relational values extend beyond Western contexts. These results support the conceptual and construct validity of the three types of nature's value and offer deeper insights into the diverse ways individuals relate to nature. Â© 2025},
  publisher = {Elsevier B.V.},
  issn = {26666227},
  keywords = {Animism; Anthropocentrism; Anthropomorphism; Connectedness to nature; Human-nature relationship; Relational value},
}

@article{perceivedneighbourhoodphysical2026,
  author = {LeClair J.A.},
  title = {{Perceived} neighbourhood physical (dis)order and childrenâs mental health in {Brantford,} {Ontario,} {Canada}},
  year = {2026},
  volume = {10},
  number = {2},
  doi = {10.1080/23748834.2026.2620269},
  abstract = {Geographersâand other researchers employing geographical perspectivesâhave a longstanding interest in mental health, with much of the resultant research reporting a concentration of disorder in areas characterised by low socioeconomic status (SES). These patterns are typically explained by reference to material disadvantage and the disordered nature of some urban environments. Overwhelmingly, this research focusses upon adults, with children remaining relatively understudied. Using a cross-sectional study design, this paper examines the relationship between parental perceptions of neighbourhood physical (dis)order and the mental health of a sample of Grades 1â5 children living in the City of Brantford, Ontario, Canada. Participants in the study offered their assessment of six indicators of physical (dis)order, while mental health was evaluated using parental report, as well as responses to the Strengths and Difficulties Questionnaire. Associations between neighbourhood (dis)order and mental health status were assessed using odds ratios, and logistic regression analyses were used to determine whether the observed associations persisted after inclusion of the effects of SES. The findings reported herein are, in general terms, consistent with the notion that urban physical disorder might represent a potential risk to childrenâs mental health, while physical order may be protective against mental health problems. Â© 2026 Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {23748834},
  keywords = {Childrenâs health; mental health; neighbourhood disorder; urban health},
}

@article{6gandautonomousvehiclesthefutu2026,
  author = {Yavari A.; Bagha H.; Foroughimehr N.; Branch P.},
  title = {{6G} and {Autonomous} {Vehicles:} {The} {Future} of {Intelligent} {Transportation}},
  year = {2026},
  doi = {10.1109/ICOIN68469.2026.11480639},
  abstract = {Connected autonomous vehicles are expected to become increasingly widespread in the coming decade, fundamentally transforming the utilization of communication networks across urban environments. These vehicles are highly data-intensive and continuously exchange information with surrounding vehicles, infrastructure, and cloud services to enable perception, decision making, and control. This constant connectivity imposes unprecedented loads on existing communication technologies such as mobile 5 G broadband networks, which must handle massive volumes of real-time data transmission with low latency and high reliability requirements. This study examines how large scale deployment of connected autonomous vehicles could affect the performance and scalability of 5 G networks, with a focus on bandwidth utilization under dense vehicular connectivity. In addition, it explores the potential role of 5 G and beyond communication technologies, which are expected to become the dominant network infrastructure during the era of widespread connected autonomous vehicle adoption, in addressing these challenges. The findings emphasize the need for adaptive network architectures to ensure seamless and reliable communication for future autonomous transportation systems.  Â© 2026 IEEE.},
  publisher = {IEEE Computer Society},
  isbn = {979-833157896-1},
  issn = {19767684},
  keywords = {5G; 6G; Connected Autonomous Vehicles; Digital Twin; IoT; Transportation},
}

@article{microscalesearchingbaseddynami2026,
  author = {Xie Q.; Qiu W.; Peng C.; Huang Q.; Zhuang P.; Huang H.},
  title = {{Microscale} {Searching-Based} {Dynamic} {Constrained} {Multi-Objective} {Optimization} for {Uncrewed} {Aerial} {Vehicle} {Path} {Planning} in {Unknown} {Environments}},
  year = {2026},
  doi = {10.1109/TEVC.2026.3713137},
  abstract = {Uncrewed aerial vehicle (UAV) path planning in unknown environments involves generating optimal collision-free paths through iterative perception-planning cycles executed concurrently with flight, during which environmental information is incrementally acquired. Recent research has treated UAV path planning as constrained multi-objective optimization problems and applied evolutionary algorithms as solution methods due to their global search ability. However, these approaches rely on prior environmental information and sufficient optimization time, limiting their applicability to real-time unknown environment scenarios. We model UAV path planning in unknown environments as a dynamic constrained multi-objective optimization problem (DCMOP), where each time step corresponds to one perception-planning cycle. Such modeling enables dynamic constrained multi-objective evolutionary algorithms (DCMOEAs) to rapidly adapt to the evolving objectives and constraints induced by incremental sensing. Nevertheless, multiple kinematic and obstacle-avoidance constraints lead to a highly constrained search space, hindering efficient exploration during optimization. To address this challenge, we propose a DCMOEA based on a constraint-guided microscale-searching mechanism. The mechanism restricts the evolutionary search to a valid flight subspace defined by UAV-specific constraints, thereby improving search performance for real-time path planning. Experimental results on six benchmarks across three urban environments validate the advantage of the DCMOP formulation over single-objective alternatives, and demonstrate the superior performance of the proposed algorithm regarding algorithmic stability and solution quality. The proposed algorithm achieves 100% success rates on all benchmarks against five DCMOEA baselines, with an average 52% improvement in mean hypervolume over the best baseline. This study extends evolutionary computation to real-time UAV autonomous navigation in unknown environments. Â© 1997-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {1089778X},
  keywords = {dynamic constrained multi-objective optimization; evolutionary algorithm; microscale searching; UAV path planning},
}

@article{theroleof3dmodelinginenhancing2026,
  author = {Korkmaz M.; Can Zulfikar A.; Cakir S.D.},
  title = {{The} {Role} of {3D} {Modeling} in {Enhancing} {Seismic} {Risk} {Management} and {Disaster} {Response}},
  year = {2026},
  volume = {843 LNCE},
  doi = {10.1007/978-3-032-20881-1_40},
  abstract = {Advanced 3D modeling is vital for managing seismic risk in complex urban environments. This study explores its applications for disaster preparedness, response, and recovery, focusing on risk assessment, scenario simulations, and decision-making. 3D models create urban digital twins, enabling accurate structural vulnerability assessments and real-time disaster coordination. They provide comprehensive visualization of earthquake damage scenarios, enhancing emergency planning and resource allocation. Integration with geospatial, structural, and seismic hazard data supports resilient infrastructure development. Distinct Levels of Detail (LoD) serve different phases: Lower LoD suffices for hazard mapping, vulnerability analysis, and scenario simulations. Conversely, high LoD digital twins, incorporating detailed building attributes, interiors, and infrastructure networks, become indispensable post-earthquake for search and rescue, damage assessment, and resource allocation. Integrating real-time sensor data further enhances situational awareness and decision-making within these high-fidelity models. The proposed framework incorporates seismic hazard assessment by modeling earthquake scenarios using geological, geotechnical, and seismic data. It facilitates detailed vulnerability analysis and simulations to estimate casualties, infrastructure damage, and service disruptions, aiding preemptive planning. Sensor networks and early warning systems enable real-time risk monitoring and dynamic assessment updates, improving emergency response and recovery strategies. Though designed for seismic risk, the framework's adaptability allows modification for diverse disaster risks, making it a versatile urban resilience planning tool. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303220880-4},
  issn = {23662557},
  keywords = {3D modeling; digital twin; disaster response; earthquake resilience; Level of Detail (LoD); seismic risk management},
}

@article{soundscapeecologyofarapidlytra2026,
  author = {Bose S.; Naskar M.; Datta D.},
  title = {{Soundscape} {Ecology} of a {Rapidly} {Transforming} {Urban} {Environment:} {Insights} from {Rajarhat-New} {Town} of {Kolkata} {Metropolitan} {Area,} {India}},
  year = {2026},
  volume = {12},
  number = {1},
  doi = {10.1080/23754931.2025.2503206},
  abstract = {This research aims to assess the soundscape ecology of the planned smart city of Rajarhat-New Town in India toward attaining sustainability in cityscape management. Average sound intensity patterns during the off-peak and peak traffic hours of a weekday were delineated. Sound-walks were carried out at representative transects across different LULCs to detect the frequency variations and classify those under generic soundscape components. Normalized Difference Soundscape Index (NDSI) values were computed for all LULCs to comprehend the cityâs pulsation pattern. Subsequently, residentsâ perception on the cityâs soundscape dynamics were appraised through a questionnaire survey. Results showed that sound intensity patterns differed significantly (p < 0.001) across LULCs but insignificantly between the time slots. NDSI values were highest in vegetated areas (0.99) and lowest over waterbodies (0.53). Built-ups and barren lands were primarily characterized by geophony (bass: windâs friction) and anthrophony (treble: car honking). Conversely, vegetated areas were dominated by geophony (bass: windâs friction) and biophony (treble: animal vocalization). Residents opined that the area is not yet having any typical kind of sound identity but biophonic sources are gradually declining. Being part of a planned city, these losses would not be drastic and may be restored with appropriate landscape level interventions. Â© 2025 Applied Geography Conferences.},
  publisher = {Routledge},
  issn = {23754931},
  keywords = {Anthrophony; biophony; geophony; residentâs perception; urban blue-green space},
}

@article{gsdsegnetgeometryguidedlightwe2026,
  author = {Chen C.},
  title = {{GSD-SegNet:} {Geometry-Guided} {Lightweight} {Real-Time} {Semantic} {Segmentation} for {Autonomous} {Driving}},
  year = {2026},
  doi = {10.1109/AETCSE69203.2026.11504397},
  abstract = {Autonomous driving systems require semantic segmentation models that achieve high accuracy while maintaining real-time performance under limited computational resources. Although recent deep segmentation networks have significantly improved scene understanding, many methods rely on heavy architectures or ignore geometric priors, leading to inefficient feature representation and degraded performance in complex urban environments. To address these challenges, this paper proposes GSD-SegNet, a lightweight real-time semantic segmentation framework built upon YOLOv11-Seg for autonomous driving scenarios. First, a Geometry Self-Attention (GSA) module is introduced to incorporate depth information as a geometric prior without explicitly encoding depth through additional networks. By embedding monocular depth estimated via DepthAnythingV2 into the multi-scale fusion stage, the proposed mechanism enhances spatial awareness and improves feature discrimination while maintaining low computational overhead. Second, a Strip Convolution (StripConv) module replaces standard convolutions in the backbone to strengthen directional feature modeling. Through sequential horizontal and vertical strip convolutions, the network efficiently captures long-range dependencies and structural cues commonly found in road scenes, such as lanes, poles, and thin objects. Extensive experiments on the Cityscapes dataset demonstrate that the proposed method achieves superior segmentation accuracy compared with the baseline YOLOv11-Seg while preserving real-time inference speed and lightweight model complexity. The results validate that combining geometry-guided attention with direction-aware convolution provides an effective and efficient solution for real-world autonomous driving perception Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833156033-1},
  keywords = {autonomous driving; lightweight network; semantic segmentation},
}

@article{riskofeucalyptustreefailureand2026,
  author = {GonzÃ¡lez-Jaramillo S.I.; Lozano-Amaro I.; Ceccon E.; PÃ©rez-MuÃ±oz T.; Cano-Santana Z.},
  title = {{Risk} of eucalyptus tree failure and social acceptance of its removal in urban green areas of {Mexico} {City}},
  year = {2026},
  volume = {115},
  doi = {10.1016/j.ufug.2025.129191},
  abstract = {Non-native tree species in cities present complex ecological and social management challenges. In Mexico City, eucalyptus trees have become a growing risk due to pest vulnerability and structural instability, during extreme weather events. Following a large-scale pest outbreak in 2003, a government program attempted to reduce eucalyptus populations, yet failed due to limited public awareness and the perceived benefits of these trees. This study integrates spatial multi-criteria decision-making (ELECTRE method combined with GIS) and social perception modeling (Generalized Mixed Linear Models), to inform urban tree management strategies. We analyzed five green areas in Mexico City (30 plots, 618 trees) and found that 23.3 % of plots were classified as high risk of failure, mostly in zones with intense public use. Social data (n = 150 respondents) showed that 42 % had witnessed a eucalyptus fall and 58 % supported removal and replacement with native species, although acceptance varied strongly by site. Results highlight that all areas contain plots with significant risk, and that public support depends on the perceived balance between ecological benefits and damages. A convergence analysis revealed a strong alignment between ecological risk and social experience, with a positive correlation ( p = 0.70) between the risk index and the proportion of respondents who had seen a eucalyptus fall. This research highlights how aligning ecological risk modeling with social perceptions can strengthen urban forestry practices by identifying priority areas for intervention and improving public acceptance of tree replacement programs. Â© 2025 The Authors.},
  publisher = {Elsevier GmbH},
  issn = {16188667},
  keywords = {Eucalyptus risk; Exotic species management; Geographic Information Systems (GIS); Multi-criteria decision analysis (MCDA); Socio-ecological risk; Urban environmental management},
}

@article{uncertaintyawarelidarobjectreg2026,
  author = {Lee H.; Choe Y.; Park C.G.},
  title = {{Uncertainty-Aware} {LiDAR} {Object} {Registration} {Algorithm} for {Urban} {Semantic} {Mapping}},
  year = {2026},
  volume = {23},
  doi = {10.1109/TASE.2025.3632337},
  abstract = {LiDAR directly acquires 3D point measurements of physical surfaces, making it well-suited for interpreting objects in tasks such as object reconstruction and semantic mapping. However, each object is represented by a sparse point set, and the observations are inherently partial due to self-occlusion, which poses significant challenges for object registration. The uncertainty of the modeled surface depends on the local point density, and outliers from non-overlapping areas are often involved in the registration process. To address these issues, we propose a stochastic object registration method that models surface uncertainty using a Gaussian process and an overlap determination scheme based on object detector outputs. Both the overlap determination scheme and the stochastic object registration method are verified through Monte Carlo simulations on numerous real-world urban object point clouds, demonstrating performance improvements of 52% and 12%, respectively, compared to the baseline methods. To validate the full pipeline in real-world conditions, the proposed registration method is integrated with PointPillars, achieving an 8% accuracy improvement over the baseline method and demonstrating a 98.8% convergence ratio in LiDAR-based vehicle registration. Note to PractitionersâThis paper presents a registration algorithm using LiDAR for object mapping in urban environments. Two major challenges in this task are the non-overlapping regions within point clouds and the empty spaces between points, which result from differences in the observed LiDAR poses and the limited number of points representing objects within large-scale point clouds, respectively. To address these issues, this work proposes two key components: 1) an overlap determination scheme based on an object detector, and 2) a probabilistic formulation of the objective function using Gaussian processes to model surface uncertainty. Each module is validated under various initial error conditions, and the comprehensive mapping system, integrated with the object detector, demonstrates superior performance over existing methods in terms of robustness and accuracy in diverse urban semantic mapping scenarios. Â© 2004-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {15455955},
  keywords = {LiDAR perception; object registration; semantic mapping; uncertainty estimation},
}

@article{aurorahybriddeeplearningbaseds2026,
  author = {Nicholine J.P.; Raj J.R.F.; Krishnan R.S.; Annamalai T.; Vinoth Kumar V.; Umesh R.},
  title = {{AURORA:} {Hybrid} {Deep} {Learning-based} {Stampede} \& {Risk} {Prediction} {System}},
  year = {2026},
  doi = {10.1109/ICAUC68182.2026.11441232},
  abstract = {Crowd stampedes in densely populated public spaces pose critical safety risks, requiring accurate and real-time monitoring systems. This research presents AURORA (Advanced Unified Risk Observation \& Real-time Alert), a hybrid deep learning framework designed for early crowd stampede risk prediction. AURORA integrates CSRNet-based crowd density estimation, RAFT-lite optical flow motion analysis, Transformer-based spatio-temporal risk modeling, and a rule-based safety layer to ensure explainable and reliable predictions. A custom dataset, AURORA-CROWDX, consisting of annotated video sequences captured at 15 FPS from diverse public environments, supports training, evaluation, and validation. Performance evaluation demonstrates that AURORA outperforms existing methods (CNN-Density and MCNN) across all metrics. For crowd density estimation, it achieves a crowd count accuracy of 0.953, MAE of 0.426, MSE of 0.762, and zone-wise density accuracy of 0.941. Motion analysis results include average crowd speed of 0.812 m/s, speed variance 0.096, direction entropy 0.274, flow consistency 0.941, and panic motion score 0.872. Spatio-temporal risk prediction yields a Transformer risk probability of 0.891, risk prediction accuracy 0.943, and early warning lead time of 13.875 seconds. Hybrid risk assessment reduces false alarms to 0.041 while maintaining classification accuracy of 0.943. System throughput reaches 14.875 FPS with low latency (74.562 ms/frame) and robust performance under occlusion (0.912) and illumination variations (0.931). The proposed framework provides several advantages: high prediction accuracy, early warning capability, explainable decisions, and robust real-time operation. By enhancing crowd safety in public spaces, this research demonstrates a practical and scalable solution for real-time risk management in densely populated urban environments.  Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833155851-2},
  keywords = {Crowd Simulation; Crowd Stampede; Data Fusion; Disaster Risk Reduction; Early Warning System; Human Crowd Behavior; Hybrid Risk Scoring; Motion Analysis; Public Spaces},
}

@article{frompixelstoperceptionfinetuni2026,
  author = {Huang G.; Song X.; Jiao H.},
  title = {{From} pixels to perception: fine-tuning vision-language models for semantic urban perception},
  year = {2026},
  volume = {19},
  number = {1},
  doi = {10.1080/17538947.2026.2677402},
  abstract = {Urban perception is a complex cognitive process, yet existing street-view studies often overlook multidimensional contexts like spatial atmosphere and semantics. To bridge this gap, we propose Urban Perception CLIP (UP-CLIP), a specialized multimodal framework for extracting fine-grained perceptual semantics. Addressing the scarcity of high-quality subjective data, we developed a lexicon-guided, human-AI collaborative annotation paradigm to construct a domain-specific dataset of 15,000 image-text pairs. By fine-tuning CLIP on this dataset, we aligned street-view visual embeddings with multidimensional perception texts. Quantitative evaluations show that UP-CLIP outperforms pre-trained baselines, achieving a Recall@5 over 70% in bi-directional retrieval. Empirical applications in Wuhan demonstrate that UP-CLIP effectively: (1) maps the spatial distribution of ambivalent perceptions (e.g., âvibrant yet worn-outâ) via text-to-image retrieval; and (2) generates city-wide sentiment distribution maps through image-to-text retrieval. Overall, UP-CLIP provides an automated, large-scale tool for urban perception, offering a reliable solution for researchers and practitioners to enhance urban environment quality. Â© 2026 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Taylor and Francis Ltd.},
  issn = {17538947},
  keywords = {multimodal AI; street-view images; UP-CLIP; Urban perception},
}

@article{ros2integratedautonomousvehicl2026,
  author = {Moulya K.B.; Rodrigues A.P.; Fernandes R.; Singh A.V.; Vijaya P.},
  title = {{ROS2-Integrated} {Autonomous} {Vehicle} {Simulation} with {Behavioural} {Cloning} and {YOLOv8} {Vision} {Perception}},
  year = {2026},
  doi = {10.1109/ICIPTM69057.2026.11465582},
  abstract = {To ensure that autonomous driving technologies are safe, reliable, and robust under various road conditions, they must undergo thorough testing. However, real-world testing can be expensive, risky, and limited by environmental factors. This study introduces a fully simulation-based framework for autonomous driving, incorporating behavioral cloning, YOLOv8 for traffic light recognition, and ROS2 for sensor communication within the Webots simulator. A neural network for behavioral cloning was developed and trained using manually gathered driving data to predict steering and throttle commands, providing end-to-end vehicle control. The YOLOv8 model detects red, yellow, and green traffic lights in real time, allowing vehicles to adhere to traffic rules. Additionally, a LIDAR-based module for obstacle detection was included to minimize collision risks and ensure safe navigation. Various experimental settings in Webots, such as a simple road without obstacles, an urban environment with intersections and traffic lights, and scenarios with obstacles, were created to evaluate the system. The experimental results show that the system can drive autonomously, follow traffic signals, and avoid obstacles. The proposed framework highlights modularity and extensibility, making it ideal for future research on autonomous navigation, intelligent transportation systems, and the development of simulation-driven AI solutions. Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-831954328-8},
  keywords = {AI navigation; behavioural cloning neural networks; LIDAR detection; machine learning for control; obstacle detection and avoidance; robotics perception; ROS2 framework; Self-driving cars; self-driving simulation; sensor fusion; traffic light recognition; vehicle automation; virtual testing environments; Webots Robot Simulator; YOLOv8 object detection},
}

@article{negativesymbolismofwildlifesha2026,
  author = {Iniunam I.A.; Banda J.F.; Tende T.; Dami D.F.; Ottosson U.; Chaskda A.A.},
  title = {{Negative} symbolism of wildlife shapes humanânature coexistence: {The} plight of owls in {Nigeria}},
  year = {2026},
  doi = {10.1002/pan3.70368},
  abstract = {Humanâwildlife coexistence in culturally diverse landscapes requires understanding how socio-cultural processes shape perceptions and behaviours towards conservation-priority species. This study examines perceptions, belief-based uses and conservation attitudes towards owls in communities surrounding six Protected Areas in Nigeria, addressing key geographical and theoretical gaps in humanânature research in the Global South. Drawing on concepts of biophilia and biophobia, extinction of experience and cultural ecosystem services, we analyse how socio-demographic factors influence negative perceptions and belief-driven use, and how these, in turn, affect willingness to coexist with and protect owls. Using structural equation modelling and logistic regression on data from 1819 respondents, we find that negative perceptions, rooted in associations with witchcraft and misfortune, are widespread and vary across regions and demographic groups. Negative attitudes are strongest in more remote sites and among women (Î² = â0.15, p < 0.001), individuals with lower levels of formal education (Î² = 0.079, p = 0.003) and specific livelihood groups. Belief-based use persists among traditional healers and hunters, reflecting the cultural embedding of owls within systems of meaning and practice. Importantly, perception is a strong predictor of conservation support (Î² = 0.415), with more negative perceptions associated with reduced willingness to tolerate (Î² = â2.30, p < 0.001) and protect owls (Î² = â0.95, p < 0.001), while ecological knowledge mediates more positive attitudes towards tolerating (Î² = 1.61, p < 0.001) and protection of owls (Î² = 0.58, p = 0.04). Our findings show that reduced direct engagement with nature may allow fear-based and symbolic narratives to persist, reinforcing negative perceptions and limiting coexistence. In doing so, the study advances theory by demonstrating that humanânature relationships are not universally biophilic but are relational and context-dependent, shaped by the interaction between cultural and symbolic meanings, lived experience and socio-economic conditions. These results highlight that effective conservation must engage not only with ecological knowledge but also with the cultural and emotional dimensions that shape how people interpret and respond to wildlife in humanâdominated tropical landscapes. Read the free Plain Language Summary for this article on the Journal blog. Â© 2026 The Author(s). People and Nature published by John Wiley \& Sons Ltd on behalf of British Ecological Society.},
  publisher = {John Wiley and Sons Inc},
  issn = {25758314},
  keywords = {belief-based use; biophilia and biophobia; cultural ecosystem services; extinction of experience; humanâwildlife coexistence; owls; relational values; wildlife perceptions},
}

@article{trustandprivacyincommercialand2026,
  author = {Khan M.A.; Menouar H.},
  title = {{Trust} and {Privacy} in {Commercial} and {Recreational} {Drone} {Navigation}},
  year = {2026},
  volume = {7},
  number = {1},
  doi = {10.1109/TTS.2025.3615244},
  abstract = {The rapid rise of commercial drones has revolutionized urban industries, from package delivery to infrastructure inspection, but their integration into densely populated cities presents significant privacy challenges. In urban environments, where skyscrapers and residential neighborhoods coexist, drones must navigate complex landscapes while avoiding inadvertent surveillance of private spaces. Reports of drones capturing footage of homes have heightened public distrust, with a 2023 study indicating 68% of city residents fear privacy violations. This article explores the multifaceted challenges of urban drone route planning, including the proximity of residential zones, dynamic privacy risks, and regulatory inconsistencies. We review innovative technologies addressing these issues: geofencing establishes no-fly zones over residences but is limited by outdated maps and GPS inaccuracies; AI-powered path optimization prioritizes non-residential routes, though constrained by data quality and computational demands; camera controls, such as automated shutters and real-time image blurring, aim to prevent surveillance but face algorithmic errors and hardware costs; and real-time environmental sensing, using LiDAR and radar, avoids obstacles but struggles with urban interference and high costs. Regulatory frameworks, like FAA and EASA guidelines, and initiatives by various authorities enforce privacy-focused routing. Ethical practices and community engagement will foster public trust and equitable access. Despite significant advancements, limitations like data inaccuracies, cost barriers, and public perception issues persist. As urban air mobility expands, integrating technology, regulation, and ethics will be essential to balance efficiency and privacy, ensuring drones enhance urban life without compromising resident rights. Â© 2020 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {26376415},
  keywords = {Drone; ethical; FOV; geofencing; privacy},
}

@article{alargescaledatasetforrealtimev2026,
  author = {Vo Q.D.N.; Nguyen G.N.; Tran H.V.},
  title = {{A} {Large-Scale} {Dataset} for {Real-Time} {Vehicle} {Detection} in {Vietnamese} {Urban} {Traffic} {Scenes}},
  year = {2026},
  volume = {88},
  number = {1},
  doi = {10.32604/cmc.2026.078756},
  abstract = {Reliable vehicle detection in urban traffic environments remains challenging, particularly for fixed-view CCTV systems deployed in Southeast Asian cities, where heterogeneous traffic composition, high traffic density, frequent occlusions, and complex visual conditions are prevalent. The absence of large-scale datasets tailored to such mixed-traffic environments poses a significant limitation to the performance and generalization capability of existing object detection models. To address this gap, this paper presents a large-scale traffic image dataset for real-time vehicle detection in Vietnamese urban environments. The proposed dataset comprises 23,364 images collected from fixed-view CCTV traffic cameras deployed across Da Nang City, a representative urban area exhibiting mixed-traffic patterns commonly observed in Southeast Asian cities. The data cover diverse temporal periods, weather conditions, and traffic density levels encountered in real-world traffic monitoring scenarios. To comprehensively characterize these conditions, over 1.1 million instances are annotated across multiple traffic-related categories, including pedestrians, bicycles, motorbikes, cars, buses, trucks, and traffic lights with explicit signal-state labels. Such fine-grained, multi-class annotations support not only object-level detection but also higher-level traffic scene analysis relevant to intelligent transportation system (ITS) applications, such as traffic flow analysis and signal control. To balance annotation accuracy and scalability, a semi-automatic labeling pipeline is employed. Initial object annotations are generated using a pretrained YOLOv11m model and subsequently refined through systematic manual verification using the CVAT platform. Comprehensive experiments are conducted under the same experimental protocol, using the same YOLOv11m architecture, comprising a pretrained baseline and a version fine-tuned on the proposed dataset with domain-specific data augmentation and optimized hyperparameter settings tailored to fixed-view CCTV conditions. Under the same evaluation setting, the pretrained YOLOv11m achieves a mean Average Precision (mAP) of 0.409; in contrast, fine-tuning on the proposed dataset improves the mAP to 0.788. These results underscore the necessity of localized, context-aware datasets such as the one presented in this work for robust real-time traffic perception in Vietnam and similar Southeast Asian urban contexts. Copyright Â© 2026 The Authors.},
  publisher = {Tech Science Press},
  issn = {15462218},
  keywords = {Deep learning; ITS; real-time vehicle detection; traffic detection; Vietnamese traffic dataset},
}

@article{perceptionofinterconnectedness2026,
  author = {Muldoon M.C.; Galford G.L.; Gould R.K.},
  title = {{Perception} of interconnectedness: a new typology and tools across disciplines},
  year = {2026},
  doi = {10.1007/s11625-026-01849-1},
  abstract = {Increased awareness of human-nature interconnectedness could, according to recent global syntheses, transform the dominant unsustainable systems that threaten our shared future on this planet. We collected and synthesized evidence from the interdisciplinary body of literature on how humans perceive their interconnectedness using a systematic search and thematic coding. Our findings provide three practical additions to the literature and the science-policy interface. First, our typology of six types of interconnectedness lends structure to the interconnectedness concept. It provides an intelligible, operationalizable core of a definition that can serve as goal and guide for efforts to increase interconnectedness. Second, the wide-ranging list of benefits and associations we found can aid practitioners and researchers to understand how diverse the benefits of interconnectedness can be; this may help to broaden coalitions and build support behind the recommended practices of working to increase perceptions of interconnectedness. Finally, our Perception of Interconnectedness Toolkit compiles diverse methods that researchers have used to measure perception of interconnectedness; it provides a menu of options for researchers to adapt to their research goals and contexts. This selection of repeatable methods can help practitioners and researchers to monitor and understand current perceptions of interconnectedness, and whether and how actions (e.g., interventions) may change those perceptions. Â© The Author(s) 2026.},
  publisher = {Springer},
  issn = {18624065},
  keywords = {Human-nature relationships; Interconnectedness; Science-policy processes; Systematic literature review; Transformative change},
}

@article{amathematicalformulationofagii2026,
  author = {He D.; Fang C.; Wang Y.; Peng Y.; Wang Y.; Zhu S.-C.},
  title = {{A} {Mathematical} {Formulation} of {AGI} in the {(C,} {U,} {V)} {Framework}},
  year = {2026},
  doi = {10.1016/j.eng.2025.08.034},
  abstract = {This article seeks to explore a general formulation of artificial general intelligence (AGI) under a unified framework that defines AGI agents as points in a joint (C,U,V) space. An agent is characterized by three components: â  a cognitive architecture C, which represents the modules (mathematical functions) inside the agent's mind, as well as the connections and communication protocols between these modules, including the theory of mind (ToM); â¡ a set of potential functions U, which represents the skills of perception, cognition, and planning (e.g., a potential function can be a neural network trained for visual object recognition, or embodied motion planning); and â¢ a set of value functions V, which includes the agent's urges, preferences, and social affections, as well as benefits for individual agents or a group of agents. In this setting, âintelligenceâ is defined as a wide range of phenomena exhibited by agents when they interact with complex environments (i.e., physical intelligence) and other agents (i.e., social intelligence). Given an initial point in the (C,U,V) space, an agent can explore new V-dimensions, which in turn drives the acquisition and learning of skills by enabling the learning of new potential functions U in the environment and by updating the cognitive model. We have developed a Tong test as a benchmark and evaluation criteria: An agent that has reached the human level (C,U,V) is called a âTong Agent.â The convergence of this process defines the limits of the agent's evolution; we name this the âstopping problemâ of Tong Agents, based on the analogy of the halting problem in a Turing machine. Â© 2025 THE AUTHORS},
  publisher = {Elsevier Ltd},
  issn = {20958099},
  keywords = {Artificial general intelligence; Evolutionary learning; Machine learning; Value alignment},
}

@article{reflectedsolarglarefrombuildin2026,
  author = {Lee J.; Kim H.; Lim E.; Shin M.; Suk J.Y.},
  title = {{Reflected} solar glare from building facades: {A} critical review of assessment methodologies},
  year = {2026},
  volume = {287},
  doi = {10.1016/j.buildenv.2025.113902},
  abstract = {The increasing prevalence of high-rise buildings with reflective facades in urban environments has intensified reflected sunlight glare, leading to visual discomfort, health risks, and property damage. Despite these growing concerns, standardized regulations and evaluation methods for building facades remain lacking. This paper comprehensively reviews existing research on glare evaluation for reflected sunlight from building facades, identifying trends, limitations, and future directions. Studies are categorized into measurement, simulation, and integrated approaches. Although measurement-based studies using field surveys and high dynamic range imaging offer empirical insights, they often lack standardized quantitative evaluation or human perception-based glare indices. Simulation-based studies employ geometric- and radiance-based methods to predict glare patterns; however, they frequently exclude human-centered metrics, lack established standards, and rarely validate perceptual data. Integrated approaches combine both, improving reliability; however, they are limited to consistently applying perception-based glare indices and conducting user-based validations. In conclusion, there is a critical need for developing standardized methodologies for glare assessment, including the consistent application of discomfort glare indices (e.g., daylight glare probability and unified glare rating), integration of user-centered validation, and development of standardized simulation protocols. Future research should prioritize comprehensive frameworks that combine physical and perceptual factors for accurate and reliable assessments to improve building design and urban planning. Â© 2025},
  publisher = {Elsevier Ltd},
  issn = {3601323},
  keywords = {Building facades; Glare assessment; Reflected sunlight; Urban environment; Visual comfort},
}

@article{anintelligentpublicsafetythrea2026,
  author = {Mishra N.; Afzal M.; Nuritdinovich M.A.; Indumathi G.; Hadi A.A.; Murali M.},
  title = {{An} {Intelligent} {Public} {Safety} {Threat} {Prediction} {Framework} {Using} {Deep} {Q-Learning} and {Agent-Based} {Simulation}},
  year = {2026},
  doi = {10.1109/ICETSIS68266.2026.11549245},
  abstract = {In modern urban surveillance systems, precision and timely forecasting of safety threats to the people are vital in the prevention of crime and the effective management of emergencies. Combining large-scale urban data with artificial intelligence improves situational awareness and supports smart decision-making. Most current methods rely on fixed predictive models that do not capture, resulting in limited real-time responsiveness and low predictive precision. Such systems are often unable to track dynamic environmental changes and the intricate interactions among urban entities. To address these shortcomings, the paper proposes a new framework, Urban Crime and Emergency Response Management in Real-Time, based on Deep Q-learning and agent-based simulations. The framework combines deep reinforcement learning with an agent-based simulation environment to enable context-aware, adaptive threat prediction. Intelligent agents develop optimal response policies using the Deep Q-Learning algorithm as they continuously interact with a dynamically changing urban environment. The system simulates various emergency scenarios, identifies potential hazards, and recommends timely intervention strategies to enhance operational efficiency. As indicated by the experimental results, the proposed DQL-ABS framework is highly effective in terms of prediction accuracy, reduced response time, and improved coordination between safety management units, compared to traditional static frameworks. These findings indicate the framework's ability to enable proactive, data-driven management of public safety and to enhance smart city infrastructure through adaptive, smart threat mitigation measures.  Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833157229-7},
  keywords = {agent-based simulation; deep Q-Learning; public safety; threat prediction; urban monitoring systems},
}

@article{pedestrianawaremotionplanningf2026,
  author = {Moller K.; Nyberg T.; Tumova J.; Betz J.},
  title = {{Pedestrian-Aware} {Motion} {Planning} for {Autonomous} {Driving} in {Complex} {Urban} {Scenarios}},
  year = {2026},
  volume = {7},
  doi = {10.1109/OJITS.2026.3655468},
  abstract = {Motion planning in uncertain environments like complex urban areas is a key challenge for autonomous vehicles (AVs). The aim of our research is to investigate how AVs can navigate crowded, unpredictable scenarios with multiple pedestrians while maintaining a safe and efficient vehicle behavior. So far, most research has concentrated on static or deterministic traffic participant behavior. This paper introduces a novel algorithm for motion planning in crowded spaces by combining social force principles for simulating realistic pedestrian behavior with a risk-aware motion planner. We evaluate this new algorithm in a 2D simulation environment to rigorously assess AV-pedestrian interactions, demonstrating that our algorithm enables safe, efficient, and adaptive motion planning, particularly in highly crowded urban environments, a first in achieving this level of performance. This study has not taken into consideration real-time constraints and has been shown only in simulation so far. Further studies are needed to investigate the novel algorithm in a complete software stack for AVs on real cars to investigate the entire perception, planning and control pipeline in crowded scenarios. We release the code developed in this research as an open-source resource for further studies and development. It can be accessed at the following link: https://github.com/TUM-AVS/PedestrianAwareMotionPlanning Â© 2020 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {26877813},
  keywords = {Autonomous vehicles; collision avoidance; motion planning; pedestrian; vehicle safety},
}

@article{virtualrealityasatreatmentforc2026,
  author = {Pretat T.; Koller C.; HÃ¼gle T.},
  title = {{Virtual} reality as a treatment for chronic musculoskeletal pain syndromes; {[Traitements} des syndromes douloureux musculosquelettiques chroniques par la rÃ©alitÃ© virtuelle]},
  year = {2026},
  doi = {10.1016/j.rhum.2025.12.003},
  abstract = {Chronic musculoskeletal pain syndromes, including fibromyalgia, are often resistant to conventional medications and invasive therapies. Central hypersensitization, neurotransmitter dysregulation, and autonomic nervous system abnormalities are key pathomechanisms, frequently resulting in widespread pain and a variety of psychosomatic symptoms. Virtual Reality (VR) applications have demonstrated effectiveness in reducing pain, both during and after interventions, and in chronic conditions such as fibromyalgia and back pain. The proposed mechanisms behind VR's effectiveness include distraction and immersion, coupled with cognitive behavioral therapy, which promote neuroplasticity and alter pain perceptions. Functional MRI studies have shown the impact of VR interventions on specific brain regions. Advances in hardware and software, potentially combined with treatments like biofeedback, could enhance VR's role in managing chronic pain. Currently, VR for musculoskeletal pain syndromes is primarily used within multimodal programs, but it is also available for home use as a standalone health application. Future research should focus on the âdrug-likeâ effects of VR, requiring controlled trials with comparable study populations and appropriate sham interventions. Â© 2025; Les syndromes douloureux musculosquelettiques chroniques comme la fibromyalgie rÃ©sistent souvent aux mÃ©dicaments conventionnels et aux thÃ©rapies invasives. Parmi les principaux mÃ©canismes pathologiques, on retrouve une hypersensibilisation centrale, un dÃ©rÃ¨glement de certains neurotransmetteurs et des anomalies du systÃ¨me nerveux autonome, qui entraÃ®nent frÃ©quemment une douleur gÃ©nÃ©ralisÃ©e et des symptÃ´mes psychosomatiques divers. Les applications de rÃ©alitÃ© virtuelle ont fait la preuve de leur efficacitÃ© dans la rÃ©duction de la douleur, aussi bien pendant qu'aprÃ¨s les interventions, ainsi que dans les affections chroniques comme la fibromyalgie et la rachialgie. Cette efficacitÃ© pourrait Ãªtre l'effet de la distraction et de l'immersion, associÃ©es Ã  une thÃ©rapie cognitivo-comportementale favorisant la neuroplasticitÃ© et modifiant la perception de la douleur. Des Ã©tudes d'IRM fonctionnelle ont montrÃ© l'impact des interventions de rÃ©alitÃ© virtuelle sur des rÃ©gions spÃ©cifiques du cerveau. Les avancÃ©es matÃ©rielles et logicielles pourraient se combiner Ã  des traitements de type biofeedback et renforcer le rÃ´le de la rÃ©alitÃ© virtuelle dans la prise en charge de la douleur chronique. Dans le contexte des syndromes douloureux musculosquelettiques, la rÃ©alitÃ© virtuelle est pour l'instant principalement utilisÃ©e au sein de programmes multimodaux, mais peut aussi Ãªtre dÃ©ployÃ©e Ã  domicile comme une application de santÃ© autonome. Ã l'avenir, la recherche devrait s'intÃ©resser aux effets de la rÃ©alitÃ© virtuelle qui sont similaires Ã  ceux des mÃ©dicaments, dans des groupes comparables et avec des interventions fictives appropriÃ©es. Â© 2025},
  publisher = {Elsevier Masson s.r.l.},
  issn = {11698330},
  keywords = {Chronic musculoskeletal pain syndrome; Chronic pain; Douleur chronique; Fibromyalgia; Fibromyalgie; RV; RÃ©alitÃ© virtuelle; Syndrome douloureux musculosquelettique chronique; Virtual reality; VR},
}

@article{mappingecologicalempathyaseman2026,
  author = {Xu Y.; Sun Z.; Zhen C.; Lin Y.-S.; Thorogood M.; Smith M.; Lasserre P.; Dulic A.},
  title = {{Mapping} {Ecological} {Empathy:} {A} {Semantic} {Network} {Analysis} ofÂ {Player} {Perceptions} inÂ {3D} {Environmental} {Education} {Games}},
  year = {2026},
  volume = {16739 LNCS},
  doi = {10.1007/978-3-032-30405-6_16},
  abstract = {As the global climate crisis intensifies, 3D video games have emerged as powerful, interactive simulations for Environmental Education (EE). However, empirical assessment of their pedagogical efficacy remains epistemologically challenged. Traditional evaluation metrics, such as pre-post surveys, often suffer from response bias and fail to capture the nuanced, emergent psychological shifts players experience during gameplay. This paper proposes a novel, non-intrusive approach: utilizing Semantic Network Analysis (SNA) to map the âunsupervisedâ cognitive structures of players. We scraped and qualitatively filtered 1,825 rich-text user reviews from Steam for two distinct titles representing opposing ecological philosophies: Eco (anthropocentric systemic management) and WolfQuest (biocentric embodied survival). By constructing co-occurrence networks and calculating topological metrics, we visualized the divergence in how players conceptualize human-nature relationships. Results indicate a fundamental pedagogical split: Eco promotes âSocio-Political Cognition,â where environmental challenges are framed as legislative and economic frictions; conversely, WolfQuest fosters âEffective Empathy,â where players internalize the fragility of life through the vulnerability of the avatar. We argue that semantic topology offers a rigorous methodological tool for serious games assessment, revealing that effective environmental education requires a strategic tension between systemic logic and emotional resonance. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303230404-9},
  issn = {3029743},
  keywords = {Digital Trace Data; Environmental Education; Epistemic Network Analysis; Semantic Network Analysis; Serious Games},
}

@article{floodevacuationmodelsinurbanar2026,
  author = {Getuli V.; de Luca D.L.; Bruttini A.; Cinquepalmi F.; Napolitano F.; Ridolfi E.; Lucantonio M.; Biondi D.; Cruscomagno F.},
  title = {{Flood} {Evacuation} {Models} in {Urban} {Areas:} {Towards} a {Digital} {Twin} {Framework} for {Emergency} {Management}},
  year = {2026},
  volume = {844 LNCE},
  doi = {10.1007/978-981-95-8489-5_1},
  abstract = {Urban areas face increasing risks from flooding events due to the combined effects of climate change, increase in the frequency and intensity of extreme precipitation events, rapid urbanization, and aging infrastructures. In this context, mitigation strategies have a key role in reducing the impact and increasing resiliency. Over the last decades, several strategies have been developed to reduce loss of lives and economic damages and, among those, the Evacuation Plans (EPs) aim at mitigating water-related risks in numerous case studies worldwide. Traditional methods and plans are usually based on static-data without integration with real-time data, hence lacking the adaptability and stakeholder-specific focus required for effective response. To address these limitations and leverage the increasing engagement of Building and City Information Modelling, Internet of Things (IoT) and Semantic Web technologies, this paper proposes a Digital Twin (DT) framework to manage flood evacuation in urban areas based on an in-depth study of the usable datasets, modelling, and management techniques to reach the goal. The first phase involves creating a comprehensive digital representation of the physical urban environment which includes gathering and integrating heterogeneous data to capture the context of the system. The second phase focuses on the proposal of the Digital Twin system framework that addresses (a) Dynamic Data Acquisition and Integration, (b) Flood Modeling and Simulation, (c) Visualization and Decision Support. In the last phase, the pivotal role of the stakeholder engagement with the proposed DT framework is specified. By focusing on the aforementioned aspects, the proposed framework paves the way for the development of a DT system for efficient and effective emergency management in real-world scenarios. Â© The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-981958488-8},
  issn = {23662557},
  keywords = {Digital twin; Emergency management and simulation; Flood evacuation; Smart cities; Stakeholder engagement; Urban resilience},
}

@article{aerialvisionlanguagenavigation2026,
  author = {Xu H.; Liu Z.; Luomei Y.; Xu F.},
  title = {{Aerial} {Vision-Language} {Navigation} with a {Unified} {Framework} for {Spatial,} {Temporal} and {Embodied} {Reasoning}},
  year = {2026},
  doi = {10.1109/TCSVT.2026.3701286},
  abstract = {Aerial Vision-and-Language Navigation (VLN) aims to enable unmanned aerial vehicles (UAVs) to interpret natural language instructions and navigate complex urban environments using onboard visual observations. This task holds promise for real-world applications such as low-altitude inspection, search-and-rescue, and autonomous aerial delivery. Existing methods often rely on panoramic images, depth information, or odometry to support spatial reasoning and action planning. Such reliance on additional sensing modalities increases system cost and integration complexity. In this work, we present a unified aerial VLN framework that operates solely on egocentric monocular RGB observations and natural language instructions. The model formulates navigation as a next-token prediction problem, jointly optimizing spatial perception, trajectory reasoning, and action prediction through prompt-guided multi-task learning. Moreover, we propose a keyframe selection strategy to reduce visual redundancy by retaining semantically informative frames, along with an action merging and label reweighting mechanism that mitigates long-tailed supervision imbalance and facilitates stable multi-task co-training. Extensive experiments on the AerialVLN and OpenFly benchmarks validate the effectiveness of our method. Under the challenging monocular RGB-only setting, our model achieves strong results across both seen and unseen environments. It significantly outperforms existing monocular baselines and narrows the performance gap with state-of-the-art panoramic RGB-D counterparts. Comprehensive ablation studies further validate the contribution of our architectural design and choices. Â© 1991-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {10518215},
  keywords = {aerial navigation; unmanned aerial vehicle (UAV); Vision-and-Language Navigation (VLN)},
}

@article{realtimevisionbasedperceptionf2026,
  author = {Hariga G.-C.; Boiangiu C.-A.},
  title = {{Real-Time} {Vision-Based} {Perception} for {Urban} {ADAS} {Using} {Large-Scale} {Camera} {Networks} {Using} {YOLO26}},
  year = {2026},
  doi = {10.1109/COMM70054.2026.11591393},
  abstract = {Advanced Driver Assistance Systems (ADAS) increasingly rely on large-scale visual perception to ensure safety, efficiency, and situational awareness in complex urban environments. Beyond in-vehicle sensors, fixed city cameras and intelligent transportation infrastructure provide a complementary, wide-area view of traffic scenes that can support applications such as traffic flow estimation, congestion monitoring, and accident prevention. In this paper, we use YOLO26 [1], a scalable family of real-time object detectors designed for efficient visual perception. Using the VisDrone [2] benchmark as a proxy for city-scale camera data, we evaluate five YOLO26 variants (N, S, M, L, and X) and analyze the trade-off between detection accuracy and inference efficiency. Experimental results demonstrate that YOLO26 enables real-time multi-object perception suitable for downstream ADAS tasks such as vehicle counting, traffic density mapping, and situational awareness in smart cities. Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-831950655-9},
  keywords = {ADAS; Aerial object detection; real-time inference; UAV vision; VisDrone; YOLO},
}

@article{gentrificationphysicalenvironm2026,
  author = {Alvim Barateiro L.; Silva J.P.; de Loyola GonzÃ¡lez-Salgado I.; Ribeiro A.I.},
  title = {{Gentrification,} physical environment and perceived health: a combined visual and textual analysis from a photovoice study conducted in {Porto,} {Portugal}},
  year = {2026},
  doi = {10.1080/23748834.2025.2605419},
  abstract = {Gentrification is transforming urban environments with significant implications for residentsâ health. Recent research has highlighted that gentrification affects health through multiple pathways, including displacement and rising housing costs, often exacerbating urban health inequalities. This study assesses the public health impact of physical transformations associated with gentrification by conducting a combined analysis of visual and textual data generated through a photovoice study in Porto, Portugal, capturing residentsâ perceptions and lived experiences. We conducted a content analysis of 458 photographs and discussion transcriptions produced during a photovoice study with 16 participants from gentrifying, deprived non-gentrifying, and affluent areas. Quantitative analysis of photographs was qualitatively compared and cross-checked with interview transcripts for each analytical category and subcategory. Most categories revealed both positive and negative transformations in the urban environment, with health impacts ranging from improved access to green spaces and public transportation to increased noise, air pollution, and housing insecurity. Some changes may bring long-term benefits while others result in health harms, illustrating the contradictory nature of gentrificationâs health impacts. This research highlights the complex relationship between gentrification, physical environment changes, and public health, emphasizing the need for balanced policies that promote equitable urban regeneration and sustainability. Â© 2026 Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {23748834},
  keywords = {gentrification; health inequalities; photovoice; Public health; urban health},
}

@article{perceivedqualityandaccesstourb2026,
  author = {Sarkar A.; Gemmell E.; P S S.; Anand S.; Bhattacharya A.A.; Pujara T.},
  title = {{Perceived} quality and access to urban green spaces and loneliness in {India}},
  year = {2026},
  doi = {10.1080/23748834.2026.2686415},
  abstract = {Amid rapid urbanisation and growing concerns about social isolation, urban green spaces are increasingly recognised as environments that may support mental well-being. However, existing research has largely focused on the physical availability and proximity of green spaces, with limited attention to how individualsâ perceptions of green space quality influence experiences of loneliness, particularly in rapidly urbanising contexts such as urban India. Addressing this gap, the present study examines how perceptions of accessibility, design quality, safety, and opportunities for social interaction in urban green spaces relate to loneliness. The study draws on a cross-sectional survey of 221 respondents from diverse demographic groups. Loneliness was measured using the UCLA Loneliness Scale, while perceptions of green spaces were assessed through a structured questionnaire. Correlation and regression analyses were conducted to examine associations between perceived green space characteristics and reported loneliness. The findings indicate a significant association between loneliness and negative perceptions of green spaces, particularly among women and younger individuals, suggesting that subjective experiences of urban environments may influence well-being strongly than spatial availability. Design attributes such as shaded seating and recreational opportunities show stronger associations with reduced loneliness than proximity alone, highlighting the importance of user-sensitive green space design in urban planning. Â© 2026 Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {23748834},
  keywords = {accessibility; Green spaces; loneliness; perception; urban well-being},
}

@article{heterogeneouseffectsofneighbor2026,
  author = {Yang Q.; Hu X.; Liu Y.; Yang L.},
  title = {{Heterogeneous} effects of neighborhood renewal on mental well-being: {A} capability approach to analyzing complex causal pathways},
  year = {2026},
  volume = {186},
  doi = {10.1016/j.apgeog.2025.103847},
  abstract = {Neighborhood renewal is considered a strategy for reducing place-based health inequalities. However, evidence suggests that such interventions can produce uneven mental health impacts. Drawing on the capability approach, this study explains how sociodemographic characteristics, neighborhood environmental changes, and individual agency, manifesting as perceptual and behavioral adaptation, interact to create intra-community mental well-being disparities. Through latent class regression analysis on survey data from 1127 residents across 16 neighborhoods in Chengdu, China, the study identifies three subgroups who experience renewal differently: higher-income older female natives, lower-income young male migrants, and the lowest-income young female migrants. First, sociodemographic characteristics establish patterned variations in environmental exposure and perceptions among the three subgroups. Specifically, lower-income young migrants are less exposed to beneficial environmental changes than higher-income local older women. These groups demonstrate distinct environmental perception patterns categorized as affection-oriented, development-oriented, and survival-oriented. Second, environmental changes exert temporally and socially heterogeneous effects on the three groups' mental well-being by altering health-related resource access . With environmental transformations intensifying, the health benefits for the first group continue to grow, while the benefits for the latter two groups initially rise but later decline. Finally, individualsâ strategic environmental perceptions further reshape health disparities. The study contributes to the multiple and interconnected causal pathways through which neighborhood renewal impacts mental well-being inequalities. It unravels the constraints imposed by structural factors on the environment-health and agency-health associations and the pathways and mechanisms through which environmental interventions and individual agency may overcome such constraints, which generates valuable insights for developing equity-oriented renewal policies. Â© 2025 Elsevier Ltd.},
  publisher = {Elsevier Ltd},
  issn = {1436228},
  keywords = {Capability approach; Environmental perception; Health inequalities; Latent class regression; Mental well-being; Neighborhood renewal; Structure-environment-agency interplay},
}

@article{anovelmethodforgesturerecognit2026,
  author = {Vijayalakshmi U.; Babu M.V.},
  title = {{A} {Novel} {Method} for {Gesture} {Recognition} in {Autonomous} {Driving} {Using} {Pose} {Estimation}},
  year = {2026},
  volume = {1643},
  doi = {10.1007/978-3-032-06250-5_6},
  abstract = {Autonomous vehicles are revolutionizing transportation systems by improving safety, efficiency, and reliability. However, their ability to interact seamlessly with human operators, such as traffic police officers, remains a critical challenge, especially in dynamic and unpredictable urban environments. This work presents a robust framework for gesture recognition of traffic police personnel using pose estimation, focusing on their role in directing vehicles. Pose estimation identifies key joint positions such as the shoulders, elbows, and wrists, creating a skeletal representation of the traffic personnel. YOLOv7 (You Only Look Once) pretrained model is used for pose estimation for extracting key point information from visual inputs. Convolutional Neural Networks (CNN), LSTM (Long Short-Term memory), LSTM-CNN with attention mechanisms, GRU (Gated Recurrent Unit), GRU-CNN and GRU model with attention are used for gesture prediction based on the extracted pose data. LSTM and GRU models are very good at finding long-term dependencies in sequential data, making them ideal for using in dynamic pose changes across frames. CNN layers efficiently extract spatial features, while LSTM/GRU layers excel at learning temporal patterns. Combining both enhances model performance. The optimal model for gesture prediction is decided based on the classification accuracy and computational efficiency. The proposed system aims to enhance autonomous vehicle perception by accurately interpreting traffic personnelâs hand gestures, thereby improving decision-making capabilities and ensuring operational safety. To evaluate the models, Chinese traffic police gesture dataset in video format which has 8 different hand gesture commands is used. The GRU-CNN model with attention mechanism has a better accuracy compared to the LSTM, LSTM-CNN models. It is inferred that GRU-CNN based attention model performs better than other similar models and can be efficiently used for recognizing the gesture shown by the traffic personnel. It is also inferred that YOLO v7 model can be used for creating pose estimation inputs for these models very efficiently. In this paper GRU-CNN and GRU-CNN with attention mechanism based models produce an accuracy of 95.02% and 95.23% respectively. Â© The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  isbn = {978-303206249-9},
  issn = {23673370},
  keywords = {Autonomous Driving; CNN; GRU; LSTM; Multi-head Attention; Pose Estimation},
}

@article{thetrumanshowandecologicalillu2026,
  author = {Ozgun B.B.},
  title = {{The} {Truman} {Show} and {Ecological} {Illusion:} {Self-Fragmentation,} {Wholeness,} and the {Ecological} {Self}},
  year = {2026},
  doi = {10.1080/02604027.2026.2659289},
  abstract = {Despite extensive evidence of environmental degradation and high levels of public awareness, ecological crises often remain psychologically distant and weakly integrated into everyday experience. This conceptual paper introduces ecological illusion as a framework for understanding this paradox. Ecological illusion is defined as a lived psychological condition in which environmental harm is cognitively acknowledged yet experientially muted, emotionally regulated, and relationally disconnected from the self. Drawing on environmental psychology, ecopsychology, and critical social theory, the paper theorizes ecological illusion as emerging from the interaction of psychological distance, socially organized denial, greenwashing, moral licensing, and environmental generational amnesia. Rather than treating these processes as isolated mechanisms, the analysis integrates them into a single explanatory model that accounts for the normalization of ecological degradation within everyday life. Central to this framework is the concept of self-fragmentation, whereby dominant constructions of the self as bounded and autonomous limit the incorporation of humanânature relationships into identity. In contrast, the paper advances the ecological self as a relational orientation grounded in wholeness and interdependence. Using The Truman Show as an epistemological metaphor, the paper illustrates how constructed environments, normative scripts, and attention regimes sustain ecological illusion while preserving psychological coherence. The paper concludes by outlining implications for future research on environmental perception, identity, and engagement, and by calling for greater attention to lived experience and selfhood in psychological responses to ecological crises. Â© 2026 Taylor \& Francis Group, LLC.},
  publisher = {Routledge},
  issn = {2604027},
  keywords = {ecological illusion; ecological self; ecopsychology; Environmental education; environmental psychology; self-fragmentation; wholeness},
}

@article{safetyanalysisfortheperception2026,
  author = {Kacar L.; Matowicki M.; Tichy T.},
  title = {{Safety} {Analysis} for the {Perception} {System} of {Autonomous} {Train} {Operation}},
  year = {2026},
  number = {2026},
  doi = {10.1109/SCSP69985.2026.11548635},
  abstract = {The highly automated and autonomous operation of trains is becoming an integral part of future smart urban mobility systems. Although Grade of Automation (GoA) 3 and GoA4 are already deployed in closed metro networks, extending autonomous operation to open urban and suburban rail environments introduces new safety challenges due to interactions with pedestrians, road traffic, level crossings and heterogeneous city infrastructure. In this context, the perception system plays a critical role as a cooperative interface between the autonomous train, the surrounding urban environment, and other smart mobility subsystems. Replaces the situational awareness traditionally provided by a human driver and enables safe operation in complex, partially uncontrolled city environments. This article presents a safety analysis of a perception system for autonomous train operation in open rail networks, using a top-down risk assessment approach aligned with the Common Safety Methods (CSM) and the CENELEC EN 50126 standard. The failure modes of perception functions are identified, their impact on operational and public safety is evaluated, and their interaction with key railway systems such as ETCS and ATO is analyzed. The results support the safe integration of perception-based autonomy into smart city rail ecosystems, provided that clear responsibility boundaries, external safety barriers, and conservative safety integrity requirements are applied. The paper contributes to the concept of cooperative cities by demonstrating how autonomous rail systems can safely coexist and cooperate with urban infrastructure, road users, and citizens. Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  isbn = {979-833154640-3},
  issn = {28315618},
  keywords = {Automatic Train Operation; Autonomous Train; Cooperative Cities; ETCS; Grade of Automation; Perception; Rail Transport; Railway Safety; RAMS; Risk Analysis; SIL; Smart City; Urban Mobility},
}

@article{visibleyetabsenttheemotionalpo2026,
  author = {Huang C.-Y.},
  title = {{Visible} {Yet} {Absent:} {The} {Emotional} {Politics} of {Migrant} {Representation} in {Taiwanese} {Media}},
  year = {2026},
  doi = {10.4324/9781003661719-16},
  abstract = {This chapter examines the emotional politics embedded in Taiwanese media representations of Southeast Asian migrant workers. Through the analytical lens of affect theory and critical discourse analysis, it argues that mainstream media deploys emotional framingsâsuch as pity, fear, and moral indebtednessâto construct migrant workers as âvisible yet absentâ figures in the public sphere. These affective narratives do not merely reflect social attitudes but actively regulate the boundaries of national belonging and moral sympathy. Drawing on selected mainstream news coverage, two documentaries and one feature film produced between 2019 and 2024, the study identifies two dominant affective framings: the âsuffering otherâ and the âthreatening other.â Although these framings may appear oppositional, both rely on emotional othering and deny migrantsâ narrative and affective agency. The chapter also explores how select documentary practices challenge these dominant narratives through what is termed âcounter-affective politics.â By repositioning migrants as subjects capable of grief, humor, and desire, these alternative visual representations reconfigure public affect and open space for more egalitarian modes of recognition. The chapter concludes by arguing that emotional discourse is not only a representational tool but a political instrument that shapes public perception and social inclusion in Taiwan's migrant regime. Â© 2026 selection and editorial matter, Po-Han Lee, Alvaro Martinez-Lacabe, and Yu-chin Tseng.},
  publisher = {Taylor and Francis},
  isbn = {978-104057006-7; 978-104109652-8},
}

@article{designresourcestoenhanceaccess2026,
  author = {Massidda M.; Aga B.; Barandoni C.; Bonifazi F.; Cerato I.; Clay A.; DâAnnibale E.; Fanini B.; Ferdani D.; Giacco M.; Iannaccone R.; Magrini D.; Martucci C.S.; Olsson N.R.; Sandu I.C.A.; Spotti S.; Travaglini L.; Trumpy G.; Pescarin S.; Veggi M.},
  title = {{Design} {Resources} toÂ {Enhance} {Access} toÂ {Coloured} {Collections} {Through} {Interactive} {Experiences}},
  year = {2026},
  volume = {16450 LNCS},
  doi = {10.1007/978-3-032-17700-1_3},
  abstract = {This chapter presents the design strategies and experimental outcomes of the PERCEIVE project, aimed at enhancing access to coloured heritage through interactive and hybrid experiences. Grounded in the principles of authenticity, sense of care, and participation, the research translates studies on colour perception, digital reconstruction, and conservation into reusable design resources for museums. Four prototypesâThe Gifts of Isis, Echoes of Loss, Tiny Conservators, and the Open Space Museumâexemplify these principles in practice. Central to this process is also the PERCEIVE Design Toolbox, an integrated framework supporting co-design, prototyping, exhibition planning and evaluation. Lastly, the demonstrators test further methods to foster participatory, embodied, and sustainable approaches to coloured collections. Â© The Author(s) 2026.},
  publisher = {Springer Science and Business Media Deutschland GmbH},
  issn = {3029743},
  keywords = {Collaborative Design; Coloured Collections; Concept-oriented Design; Participation},
}

@article{mmwavenlossensingunderroughrel2026,
  author = {Liu G.; Lu X.; Xu Y.; Yuan H.},
  title = {{MmWave} {NLOS} {Sensing} under {Rough} {Relay} {Surface:} {Challenges} and {Solutions}},
  year = {2026},
  doi = {10.1109/MAES.2026.3701667},
  abstract = {Non-Line-of-Sight (NLOS) perception is essential for preventing potential collisions and finds applications in areas such as autonomous driving, target localization, and human recognition in urban environments. Millimeter-wave (mmWave) radar distinguishes itself by robust NLOS sensing abilities. However, in urban environments, the reflective properties of relay surfaces have become complex. Diverse construction materials, intricate architectural designs, and dynamic environmental variations introduce complexity, violating the conventional assumption of smooth, deterministic geometries and degrading NLOS perception performance. To improve mmWave NLOS sensing under these realistic conditions, we investigate the characteristics of rough relay surfaces and develop a sensing framework to manage multipath interference. Our approach specifically focuses on three specific challenges often overlooked in current research: precise detection under small-scale rough relay surfaces, high-resolution imaging under large-scale relay surfaces, and multipath scattering classification under uncertain surfaces. We establish scattering signal models under different roughness conditions and develop effective NLOS sensing systems based on the distribution characteristics of targets behind different rough surfaces, achieving accurate and reliable sensing. Â© 1986-2012 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {8858985},
  keywords = {Millimeter-wave (mmWave) radar; multipath exploitation; NLOS sensing; rough relay surface},
}

@article{multisensoryboundariesandthesp2026,
  author = {Sarli A.; Mussa K.T.R.; Ghebremariam Tesfau' M.},
  title = {{Multisensory} boundaries and the spatial agency of racialised residents in {Parma}},
  year = {2026},
  volume = {49},
  number = {7},
  doi = {10.1080/01419870.2025.2562630},
  abstract = {This study investigates the racialisation of urban spaces in Parma, an Italian city, through embodied experiences of Black individuals with immigrant backgrounds. Using walking conversations, it examines how sensory cues interact with public discourses to racialise urban environments, shaping perceptions of inclusion and exclusion. Media narratives amplify discomfort among long-term residents of Italian origin by associating sensory markers linked to immigrant presence with degradation and insecurity, transforming these spaces into contested sensory landscapes. Conversely, racialised individuals navigate these spaces with experiences from exclusion to cultural affirmation, which can both reinforce and challenge racialised representations. The study underscores the agency and resistance of racialised residents, who adopt tactics such as renaming spaces and engaging in sensory practices to reclaim urban environments. By adopting a multisensory approach, it deepens understanding of how racialised boundaries are produced, experienced, and contested, offering a framework for exploring raceâspace dynamics. Â© 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {1419870},
  keywords = {immigrant background; Racialisation; spatial agency; symbolic boundaries; urban space; walking},
}

@article{analyzinganintegratedmodechoic2026,
  author = {Oubahman L.; Duleba S.; EsztergÃ¡r-Kiss D.},
  title = {{Analyzing} an {Integrated} {Mode-Choice} {User} {Preference} {Model} for {Budapest}},
  year = {2026},
  volume = {33},
  number = {2},
  doi = {10.1080/10630732.2026.2625006},
  abstract = {Urban mode choice is either analyzed by subjective preference surveys, which are often biased, or by travel data processing, which misses revealing the travelersâ perceptions and intentions. The current article aims to amplify the classic survey-based mode choice analysis by providing objective thresholds for several tangible criteria of transport modes thus reducing the subjective bias. The proposed approach uses a combination of the best-worst and the preference ranking organization method for enrichment evaluationsâgeometrical analysis for interactive aid (GAIA) methods to evaluate and outrank the available transport modes in an urban environment, i.e., the city of Budapest. The results demonstrate that underground and tram have prominent preference over the bus mode. Regarding the criteria, âJourney timeâ and âWaiting timeâ are the most crucial, while âComfort at stopâ and âSafety of stopsâ are the least important parameters. Practically, it means that track-based transportation systems should be primarily ameliorated in big cities, especially due to their speed and frequency. The introduced methodology and survey procedure can be adopted to other cities worldwide to help transportation planners in their decision-making for ameliorating urban transportation. Â© 2026 The Author(s). Published by Informa UK Limited, trading as Taylor \& Francis Group.},
  publisher = {Routledge},
  issn = {10630732},
  keywords = {best-worst method (BWM); decision-making; geometrical analysis for interactive aid (GAIA); mode choice; preference ranking organization method for enrichment evaluations (PROMETHEE); public transport},
}

@article{climatefitnessdecodingurbangre2026,
  author = {Michel M.; Helnwein J.},
  title = {{Climate} {Fitness:} {Decoding} {Urban} {Green} {Dynamics}},
  year = {2026},
  abstract = {In tackling contemporary climate change, research and policy heavily lean on ecological data, frequently excluding the nuanced social and economic interconnections, historical inequalities, existing power structures, and competing interests that shape urban environments. This limited perception of climate adaptation and mitigation measures requires a more balanced, multidimensional assessment framework. To address this gap, the Urban Climate Reactor research team has expanded the concept of climate fitness, a term increasingly recognized in German-speaking circles but lacking a formal definition. However, this ambiguity has paved the way for a novel theoretical framework grounded in four core concepts: coping capacity, adaptability, transformability, and eco-harmony. The proposed climate fitness framework sets out three overarching goals: (1) protecting human well-being and biodiversity, (2) promoting justice, equity, and inclusion, and (3) fostering resilient urban spaces that thoughtfully integrate technological advancements. Based on an exploratory literature review and expert insights, this theoretical framework integrates a technology assessment approach to assess how effectively climate strategies align with the defined climate fitness goals. To test its applicability, a case study of photovoltaic tiles and New Yorkâs High Line Park was conducted to pinpoint the shortcomings of emerging technologies and harness the potential of existing climate projects to cultivate climate-fit cities that serve everyone. The Climate Fitness Challenges, a serious game, was also developed to communicate complex research findings and engage diverse audiences in climate-fit strategies. Â©2026 River Publishers.},
  publisher = {River Publishers},
  isbn = {978-874380683-7; 978-874380684-4},
  keywords = {assessment framework; climate adaptation; Climate fitness; climate mitigation; community resilience; environmental justice; holistic climate strategies; sustainable urban development},
}

@article{numericalsimulationofco2leakag2026,
  author = {Cao R.; Zhu J.; Wang X.; Guo P.; Peng M.; Yin Z.},
  title = {{Numerical} simulation of {CO2} leakage and diffusion on offshore platform using multi-scale embedded grid technique; [åºäºå¤å°ºåº¦åµå¥ç½æ ¼çæµ·ä¸å¹³å° {CO2} æ³æ¼æ©æ£æ°å¼æ¨¡æ]},
  year = {2026},
  volume = {77},
  number = {1},
  doi = {10.11949/0438-1157.20250935},
  abstract = {To address the high-risk scenario of supercritical COâ leakage from offshore platforms, a high-precision three-dimensional model was constructed using embedded grid technology combined with computational fluid dynamics, revealing the leakage and diffusion patterns of COâ in complex sea areas. Coupling of the local micro-scale of the leakage source with the global macro-scale of the offshore platform was achieved, significantly improving simulation efficiency and accuracy, reducing the grid size by 32, and shortening the computation time by 35. The study found that the northwest (NW) wind direction posed the most unfavorable diffusion conditions. COâ tends to accumulate locally under low wind speed (1 m/s). High wind speeds (23.6 m/s) can reduce risks through turbulent dilution. The high leakage rate results in the highest proportion of hazardous areas. Orthogonal experiment indicates that the influence factors follow the order: leakage rate > wind direction > wind speed. The study also identifies the vertical diffusion-blocking effect on the middle deck due to its semi-enclosed geometry, as well as the local accumulation behavior in equipment intensive zones. Misidentifying such spaces as fully-open space would lead to underestimation of high-concentration risks at low wind speeds and the hazardous-zone extent at high wind speeds. These results provide an essential support for optimizing leakage monitoring strategies and enhancing safety design of offshore platforms. Â© 2026, Materials China. All rights reserved.},
  publisher = {Materials China},
  issn = {4381157},
  keywords = {CFD; CO2 leakage and diffusion; multi-scale embedded grid; offshore platform; safety},
}

@article{thepotentialofarchivesininform2026,
  author = {Yildiz G.; Bianchi F.},
  title = {{THE} {POTENTIAL} {OF} {ARCHIVES} {IN} {INFORMAL} {PLACEMAKING} {OF} {FORMER} {MENTAL} {ASYLUMS:} {Insights} from {Pionta} {Commoning} {Archival} {Practices} {Toward} a {Living} {Urban} {Archive}},
  year = {2026},
  volume = {50},
  number = {1},
  doi = {10.1111/1468-2427.70022},
  abstract = {This article explores various forms of archivesâsuch as institutions, collections, records and citiesâas urban commons. It highlights the importance of community and institutional collaboration in curating archives to promote learning, discovery and well-being through grassroots initiatives, transforming archives and their urban settings into repositories of collective memories and significant landmarks for their communities. The Pionta complex in Arezzo, a former mental asylum covering approximately 25 hectares and encompassing historical buildings, an urban park and archaeological remains, holds considerable sociocultural, architectural and landscape value. Parts of it are used by the University of Siena and the local health authority (ASL), while the remaining area is a public space owned by the municipality and province, but underutilized because of the stigma of its historical connotations and lack of reclamation interest. This article presents three collective archival practices aimed at regenerating Piontaâs urban life, altering negative perceptions of the heritage site and activating hidden narratives as living urban archives to enhance creativity, social learning, empowerment and community welfare. These practices demonstrate commons-based archive management and informal placemaking, are collaboratively designed and implemented by diverse community members, and provide insights into managing negatively perceived heritage sites. Â© 2025 The Author(s). International Journal of Urban and Regional Research published by John Wiley \& Sons Ltd on behalf of Urban Research Publications Limited.},
  publisher = {John Wiley and Sons Inc},
  issn = {3091317},
  keywords = {archival practices; citizen humanities; commoning; community archives; living archives; mainstream archives; urban archives; urban commons},
}

@article{youcouldgetthebestofbothbreeds2026,
  author = {Youens E.; OâNeill D.G.; Belshaw Z.; Neufuss J.; Tivers M.S.; Packer R.M.A.},
  title = {{âYou} could get the best of both breeds or the worst of bothâ: {UK} public attitudes towards crossbreeding in dogs - with a specific focus on brachycephalic dogs},
  year = {2026},
  volume = {21},
  number = {1 January},
  doi = {10.1371/journal.pone.0336661},
  abstract = {Extreme conformation and reduced genetic diversity are recognised to lead to severely reduced health, welfare and longevity in certain dog breeds. There is growing interest in applying strategic crossbreeding to promote more moderate conformations and greater genetic diversity within currently problematic breeds. Crossbreeding could therefore lead to more rapid and effective improvements in welfare compared to current practices of within-breed selection. Deliberate crossbreeding between distinct different dog breeds is not a new concept; it was historically commonly used to create the current pure breeds, to increase genetic diversity and to bring new physical and/ or temperament traits into existing breeds. However, a recent surge in the popularity of âdesigner crossbreedsâ (intentional crosses between established purebreds) has elicited fresh interest around the potential positives and negatives of crossbreeding practices. Further research on crossbred brachycephalic dogs is urgently required for a greater understanding of the motivators and barriers to their acquisition. An online survey explored factors that motivate dog breed choice and acquisition of both crossbreed and purebred dogs. In addition, the survey used both closed and open questioning to explore the UK publicâs perceptions of crossbreeding, specifically (i) between a brachycephalic breed and a non-brachycephalic breed, and (ii) between two non-brachycephalic breeds. Free-text results were analysed using content analysis and subsequently quantified. Results from 4,899 participants identified that key motivators to acquire a brachycephalic crossbreed vs a brachycephalic purebred included perceptions of improved health, including the reduction in risk of breed and conformation-related disorders, and increased genetic diversity. However, the desire to acquire a purebred dog, or even a specific breed, remained a significant barrier to crossbreed acquisition, alongside concerns surrounding the ethics of crossbreeding. Other barriers included perceived negative changes to appearance and temperament of the offspring from crossbreeding. The current study identified a common set of acquisition decision-making factors across all ownership groups, including desiring a dog who the owner perceives to enjoy being loved and to enjoy physical affection, but further demonstrated that good health is of motivational low priority to some dog owners, particularly to owners of purebred brachycephalic dogs. The mix of positive and negative public perceptions and beliefs around crossbreeding and crossbreed dogs demonstrate the need for further research into the health, temperament and appearance of brachycephalic crossbreed dogs. The suitability of crossbreed dogs as an alternative to certain current purebred breeds with high risk of genetic or conformational disorders depends on both public desire and on evidence-based selection of suitable breeds to encourage crosses which maximise canine welfare. Â© 2026 Youens et al. This is an open access article distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original author and source are credited.},
  publisher = {Public Library of Science},
  issn = {19326203},
}

@article{convolutionalneuralnetworksfor2026,
  author = {Andrade R.M.D.; Shiguemori E.H.; Santos R.D.C.D.},
  title = {{Convolutional} {Neural} {Networks} for {Uncrewed} {Aerial} {Systems} {Overflight} {Risk} {Estimation}},
  year = {2026},
  volume = {7},
  doi = {10.1109/OJITS.2026.3659020},
  abstract = {Uncrewed Aerial Systems (UAS) are expected to play a key role in the next techno-social transformation, reshaping logistics, aerial transport, and surveillance sectors. However, to ensure the safe and scalable integration of UAS into urban airspaces, effective Uncrewed Traffic Management (UTM) systems are needed, particularly to address the risks associated with low-altitude flights over complex urban environments. This work proposes a methodology to estimate overflight risk based on the presence of physical, social, and infrastructural attributes. Using high-resolution satellite and geospatial data, attribute-based risk indices are defined and used to train Convolutional Neural Networks (CNNs) capable of generating continuous-valued heatmaps that highlight safer or riskier areas for UAS operations. The CNNs were trained on a dataset derived from the central region of SÃ£o Paulo, Brazil, using U-Net-like architectures adapted for regression tasks. Experimental results show that the trained models could accurately predict risk levels across diverse urban scenes and demonstrated generalisation when applied to aerial imagery from other major cities worldwide. The findings support the potential of CNN-based approaches in enabling real-time, onboard risk assessment, and contributing to more efficient and adaptive UTM path planning in urban contexts. Â© 2020 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {26877813},
  keywords = {Computer vision; convolutional neural networks; UAV traffic management; uncrewed aerial systems},
}

@article{decodinginclusionprocessespoli2026,
  author = {Samper J.; Chiu-Shee C.; Ignaccolo C.},
  title = {{Decoding} {Inclusion:} {Processes,} {Politics,} and {Ethics} of {Signaling}},
  year = {2026},
  doi = {10.4324/9781003683841-16},
  abstract = {Signaling inclusion is a dynamic, multifaceted process shaped by the interaction of social, spatial, and communicative elements. This chapter draws on case studies to develop a normative framework that breaks signaling into eight core components: sender, signal, medium, interference/amplification, receiver, processing, affordance, and inclusion. We conceptualize signaling as the transmission of messages-intentional or unintentional-through various media, interpreted by receivers who filter them through cognitive, cultural, and experiential frameworks. While presented linearly for clarity, signaling is in practice multidirectional, embedded in feedback loops between intention and perception. Inclusive signals can foster social trust, agency, and civic participation, but their impact is often constrained by structural inequalities, displacement, and exclusionary practices. Signaling unfolds through both top-down mechanisms-such as policies or legal frameworks-and bottom-up community practices rooted in lived experience. Its effectiveness depends on clarity, emotional resonance, and sustained engagement. Our cases highlight the interpretive dimension of signaling, closely tied to power, identity, and representation. We conclude by reframing signaling as a mode of urban dialogue across scales-policy, design, community, and interpersonal exchange. When intentionally designed and collaboratively sustained, signals of inclusion can open pathways toward structural transformation, enabling more equitable and responsive urban environments. Â© 2027 selection and editorial matter, Tali Hatuka and Lawrence J. Vale; individual chapters, the contributors.},
  publisher = {Taylor and Francis},
  isbn = {978-104075850-2; 978-104116309-1},
}

@article{logiclidaronlygeometricintensi2026,
  author = {Hortelano J.L.; Jimenez-Bermejo V.; Villagra J.},
  title = {{LOGIC+:} {LiDAR-Only} {Geometric-Intensity} {Confidence} {Grids} for {Drivable} {Area} {Estimation}},
  year = {2026},
  volume = {7},
  doi = {10.1109/OJITS.2026.3670457},
  abstract = {Autonomous vehicles today rely on high-definition maps for navigation and scene understanding. The creation and maintenance of these maps are costly processes that raise the entry bar for the deployment of autonomous driving technologies in the real world. A potential solution to this problem is estimating the drivable area in real time, a capability made possible by recent advancements in sensor technology and particularly relevant for complex urban environments. LiDAR-only methods for detecting drivable area are scarce and typically appear in fusion frameworks with other sensor technologies. Nevertheless, the optimization of single-sensor modalities coupled with flexible fusion solutions are key to unlock the dependencies on high-definition maps that navigation systems have nowadays. In this work we propose LOGIC C: a LiDAR-Only Geometric-Intensity Confidence Grids drivable area estimation algorithm. The approach leverages both local and non-local geometric features of point clouds, using non-parametric techniques for intensity analysis. These features are treated as individual drivability estimations and computed with confidence maps that allow for intelligent fusion in a Linear-Opinion Pool. The fused drivability proposals are combined with occupancy information and input into a Dynamic Occupancy Grid to handle moving obstacles in the environment. The proposed method is tested in the Waymo Open Dataset which includes diverse urban driving scenes where is able to match the performance of state-of-the-art approaches without training or case-by-case parameter tuning.  Â© 2026 IEEE.},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  issn = {26877813},
  keywords = {Autonomous vehicles; Dempster-Shafer theory; drivable area; dynamic occupancy grid; LiDAR; perception; road detection},
}

@article{conferenceonhighqualityurbande2026,
  title = {{Conference} on {High-Quality} {Urban} {Development} and {Beautiful} {Countryside} {Construction,} {UDCC} 2024},
