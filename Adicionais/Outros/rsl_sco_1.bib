  title = {{Erratum:} {An} {Experimental} {Analysis} of the {Perception} of the {Area} of an {Open} {Space} {Using} {3-D} {Stereo} {Dynamic} {Graphics} {(Environment} and {Behavior} (1998) 30(2) (216â234) (10.1177/0013916598302005))},
