  author = {Zheng L.; Pu H.; Jiang Z.},
  title = {{A} study on spatial satisfaction of urban parks based on visible green index; [åºäºç»¿è§ççåå¸å¬å­ç©ºé´æ»¡æåº¦è°æ¥ç ç©¶]},
