  year = {1993},
  volume = {37},
  number = {4},
  abstract = {Tactile maps and plans are maps adapted in a special way for finger-tip reading. The content of the map is presented by embankment and subsident elements where all characteristics of tactile and haptic perception are considered. Tactile maps have two main purposes: to enable the blind to form a proper spatial concept and to offer them a practical aid in moving in the urban environment. -English summary},
