@article{dialecticsinthephysicalenviron1976,
  author = {Lemberg K.; Lemberg G.},
  title = {{Dialectics} in the physical environment, exemplified in farum midtpunkt; {[Dialektik} i det fysiske miljÃ â belyst ved farum midtpunkt]},
  year = {1976},
  volume = {28},
  number = {2},
  doi = {10.1080/00291463.1976.10637123},
  abstract = {As a counterpart to a deterministic perception analysis based upon the methods of natural sciences and to a positivistic analysis of unambiguous environmental elements, we look for an intentional analysis of environmental experience, trying to throw light upon how experience of things in a human environment contains paradoxical features, depending on the fact that the individual things are perceived and conceived in different contexts. As concrete substance for investigation the modern residential district of Farum Midtpunkt in the Greater Copenhagen area has been chosen. The method applied in the phenomenological-existential, comprising a concise analysis of polarities in basic structures and prominent individual elements of the residential environment, and using the âpureâ phenomenological description for a comparative characterization of four main physical components: buildings, open spaces, foot path system and vehicular system. Â© 1976 Taylor \& Francis Group, LLC.},
  issn = {291463},
}

@article{familialopticnerveatrophyfamil1976,
  author = {Wildberger H.},
  title = {{Familial} optic nerve atrophy; {[FAMILIARE} {OPTIKUSATROPHIE]}},
  year = {1976},
  volume = {172},
  number = {36924.99967592592},
  doi = {10.1159/000307723},
  abstract = {The feature peculiar to juvenile autosomal dominant hereditary optic atrophy is a disorder of the perception of blue colour, in contrast with other affections of the optic nerve, which are accompanied by a defect of colour vision in the red to green area (Jaeger, 1954, 1966; Francois and Verriest, 1957, 1961; Grutzner, 1962, 1966; Aulhorn and Grutzner, 1969). The authors had the opportunity to examine the members of a sibship in which an autosomal dominant hereditary optic atrophy was manifested.},
  issn = {303755},
}

@article{thehazletonecologicallandplann1976,
  author = {Berger J.},
  title = {{The} {Hazleton} ecological land planning study. {Human} adaptations in a rural and urban environment: {The} basis for possible future land use patterns},
  year = {1976},
  volume = {3},
  number = {3},
  doi = {10.1016/0304-3924(76)90072-1},
  abstract = {Natural scientists, natural science trained land planners, and cultural anthropologists meshed their perceptions to study and plan for the Hazleton Region of northeastern Pennsylvania. This interdisciplinary group developed an applied human ecological approach to regions. This applied human ecology has expanded and enhanced the natural science based land use planning method. Land suitability formulation is presented as a composite evaluation of the ecological capabilities of the natural environment to support human use and the present and potential different human uses of regions based on a variety of adaptive postures. The various definitions of health or the quality of life of regional user groups become criteria for the compatibility and grouping of naturally capable sites. Â© 1976.},
  issn = {3043924},
}

@article{amultidimensionalscalingandsem1976,
  author = {GÃRLING T.},
  title = {{A} multidimensional scaling and semantic differential technique study of the perception of environmental settings},
  year = {1976},
  volume = {17},
  number = {1},
  doi = {10.1111/j.1467-9450.1976.tb00248.x},
  abstract = {Abstract.â Multidimensional scaling is compared with the semantic differential technique (SDT) as methods for dimensional analysis of the perception of environmental settings. In one experiment employing as stimuli SDT scales used in previous experiments a General Evaluation, a Social Status, a Potency, a Closedness, and an Affection factor were found for both methods. A Unity and a Complexity factor merged into a single factor, an Originality factor was only found for multidimensional scaling. In a second experiment employing as stimuli perspective drawings of urban and suburban settings, the results differed in that the General Evaluation, the Social Status, the Closedness, and the Unity/Complexity factors were found for the SDT, and only the first two for multidimensional scaling. Further experiments with other stimuli and methods of representation are needed in order to draw firm conclusions regarding the correspondence between SDT and multidimensional scaling results within the area under consideration. Copyright Â© 1976, Wiley Blackwell. All rights reserved},
  issn = {365564},
}

@article{psychosomaticaspectsofcatechol1976,
  author = {Peterfy G.; Pinter E.J.; Pattee C.J.},
  title = {{Psychosomatic} aspects of catecholamine depletion: {Comparative} studies of metabolic, endocrine and affective changes},
  year = {1976},
  volume = {1},
  number = {3},
  doi = {10.1016/0306-4530(76)90014-7},
  abstract = {(1) Fifteen healthy male volunteers were reserpinized using large parenteral doses (5 mg i.m. every 8 hr/48 hr); in nine of these, the effects of a sympathomimetic compound (methamphetamine, i.v. 0Â·2 mg/kg/15 min) were also studied at the end of 48 hr of reserpine treatment. (2) The following biochemical determinations were made: plasma FFA, blood glucose, plasma corticoids. (3) Affective functions were assessed using the Clyde Mood Scale (mood changes) and the GleserGottschalk method of verbal samples (anxiety, inward/outward hostility). (4) A substantial, significant increase of FFA production occurred within 12 hr of reserpinization and persisted throughout the 48 hr experimental period. (5) Circulating corticoids rose significantly and maintained a high level during the same period; blood glucose showed no meaningful change. (6) The sympathomimetic compound (methamphetamine) led to significant stimulation of both FFA and corticoids; reserpinization partially inhibited its effect on FFA and completely abolished the rise of corticoids on administration of methamphetamine after reserpine. (7) Reserpinization induced a progressive, marked influence on affect; depression, increased anxiety, hostility and even suicidal tendencies were observed. (8) In 80% of the subjects, administration of methamphetamine in the reserpinized state elicited a fast-developing, transient, delirium-like state with initial rapid euphoria and distortion of reality perception. (9) This degree of euphoria, quickly merging into delirium, did not occur with methamphetamine given under basal conditions. (10) These observations lend further support to the role of endogenous catecholamines in maintaining emotional stability and possibly protecting the brain in states of grossly distorted metabolic and humoral balance. Â© 1976.},
  issn = {3064530},
}

@article{diabetesmellitusandhearingimpa1976,
  author = {Kozlov Ya. M.; Onegova R.F.; Petrov V.S.; Sokoloverova I.M.},
  title = {{Diabetes} mellitus and hearing impairment {(Russian)}},
  year = {1976},
  volume = {38},
  number = {5},
  abstract = {A clinico audiometric examination of 485 patients was carried out and an experimental pathohistological examination of the internal ear elements in rats with alloxan diabetes was conducted for ascertaining the character and the developmental mechanism of hearing impairment in diabetes. Determination of the hearing apparatus by a complex method (by speech, tuning forks, tonal threshold and suprathreshold audiometry, by detection of pathological adaptation, speech audiometry and by ascertaining the thresholds of auditory sensitivity to supersonic waves) revealed neurosensory hearing impairment with a progressive accretion of the affection of both ears and signs of a conductive type at the beginning of the disease. Pathomorphological studies of the internal ear elements under light conditions and electron microscopy revealed the presence of profound disturbances of the internal ear structure (stria vascularis, cells of the spiral ganglia, vestibular membrane, capillaries of the internal ear). Histochemical study (glycogen, monophosphoesterases and nucleic acids) of the receptor cells of the cochlea indicated marked shifts in the content and the distribution of these chemical biologically active substances. Thus, processes of pharmacodynamic character developed in diabetes successively, and led to marked pathomorphological changes expressed in reduction of the hearing function of the neurosensory character. All the changes described depended directly on the duration and the severity of the disease.},
  issn = {424668},
}

@article{riemanniangeometriesofvariable1976,
  author = {Battro A.M.; Di Pierro Netto S.; Rozestraten R.J.A.},
  title = {{Riemannian} geometries of variable curvature in visual space: visual alleys, horopters, and triangles in big open fields},
  year = {1976},
  volume = {5},
  number = {1},
  doi = {10.1068/p050009},
  abstract = {Luneburg's model for computation of the curvature K of visual two dimensional space (horizontal visual surface) was tested with equidistant and parallel alleys in large open spaces. Forty six subjects used stakes to produce 406 experimental alleys of variable sizes (from 5 x 1 to 240 m x 48 m). The results show that, contrary to results obtained under laboratory conditions with small alleys and light spots, the individual curvature of visual space does not have a negative constant value. K varies in the interval -1 to +1 in ninety computed settings: K â¥ 0 (N = 38); K < 0 (N = 52). Therefore the Lobachevskian geometry currently attributed to visual space ought to be replaced by a Riemannian geometry of variable curvature. Moreover K is an individual function dependent on the size of the alley (distance from the subject), and visual perception would be better understood as scale dependent. Independently of Luneburg's model we have tested the constancy of the curvature hypothesis in experiments with horopters and visual triangles. The results obtained invalidate Luneburg's hypothesis also.},
  issn = {3010066},
}

@article{severedisturbancesoftheinterna1976,
  author = {Nikitina V.F.; Zadorova T.D.},
  title = {{Severe} disturbances of the internal ear function in operations for otosclerosis {(Russian)}},
  year = {1976},
  volume = {38},
  number = {2},
  abstract = {The authors analysed data concerning 115 patients with severe complications in the middle ear in otosclerosis following operations on the stapes carried out in various clinics and hospitals of the Soviet Union; 88 of these patients were reoperated. Persistent affections of the internal ear function after the operation on the stapes in otosclerosis occurred in 46% of the patients during the operation, in 16% on the days immediately after it, and in 38% at remote periods (from several months to several years). Deafness of the operated ear occurred in 88% of cases, depression of the auditory function in 9% and the auditory function proved to be unimpaired in 3% of cases with affection of the vestibular function. On the other hand vestibular disturbances were more frequently expressed by reduction of excitation (57%) and less frequently by its loss (24%); no disturbance of vestibular excitation was revealed in 19% of patients with affection of the auditory function. On the basis of periods of appearance of complications and reoperation data a conclusion was drawn that the principal causes of severe complications of the internal ear were injury of the internal ear during the operation (46%) and development of fistula of the labyrinthine antrum (28.7%) at remote postoperative periods. For the purpose of prevention of labyrinthine fistula it is recommended that autotissues be used more widely in the capacity of a columella part of the stapes and autocartilage. In conclusion it is pointed out that it is better to perform microoperations on the ear in specialized centres.},
  issn = {424668},
}

@article{statokineticstabilityinvestibu1976,
  author = {Bazarov V.G.},
  title = {{Statokinetic} stability in vestibular disturbances {(Russian)}},
  year = {1976},
  volume = {38},
  number = {1},
  abstract = {A study was made of the state of the statokinetic stability in 50 healthy individuals before and after vestibular stimulation and in 80 patients suffering from Meniere's disease and with labyrinthitis caused by purulent otitis or by surgical intervention on the stapes in otosclerosis. A complex of tests (cephalography, 'recording' and 'walking' tests of Fukuda, a test of 'horizontal' recording) and methods of quantitative recording of gait disturbances were used for the assessment of the state of the statokinetic stability. Experimental tests (caloric and rotation) with the recording of electronystagmograms and of the vestibulo vegetative and sensory reactions were conducted in individual cases. A direct relationship was revealed between the level of statokinetic stability and the state of vestibular excitability: with excessive stimulation of the labyrinth or in the case of its more severe affection there was a corresponding, greater disturbance of the statokinetic stability. On the basis of investigations a conclusion was drawn on the expediency of examination of the statokinetic stability in the patients for the detection of the early signs of labyrinthine affections, which was of particular significance in the less well equipped ENT institutions and where electrophysiological apparatus for all round vestibulometric examination was absent.},
  issn = {424668},
}

@article{muckleandwellssyndromeonecasel1976,
  author = {Serratrice G.; D'Omezon Y.},
  title = {{Muckle} and {Wells} syndrome (one case); {[LE} {SYNDROME} {DE} {MUCKLE} {ET} {WELLS.} {A} {PROPOS} {D'UNE} {OBSERVATION]}},
  year = {1976},
  volume = {28},
  number = {7},
  abstract = {Since the description by Muckle and Wells in 1962 of a syndrome characterized by urticarial crises with pain in the limbs, perception deafness, amyloidosis, especially in the kidneys, several observations have been reported in the literature (table provided). The etiopathogenic and nosologic problems of this affection have not yet been cleared up. Accordingly, it seemed interesting to the authors, relevant to a personal observation, to analyze the various data of the literature about this syndrome.},
  issn = {2497581},
}

@article{auditoryexaminationofnailrifle1976,
  author = {Siroky J.; Folprechtova A.; Sevcikova L.},
  title = {{Auditory} examination of nail rifle operators in building construction {(Czech)}},
  year = {1976},
  volume = {25},
  number = {5},
  abstract = {The authors examined hearing in 123 nail rifle operators. Most of them employed the indirect technique of shooting. The noise in the direct technique greatly surpassed the acceptable noise values for this kind of work, the mean values of maxima L(AI) being in the range of 128-144 dB. In the indirect technique the noise values were in the range of 115 to 119 dB. In the 102 persons observed, 49 suffered from a perception hearing disorder with maximal affection of the frequency of 8 kHz. The hearing loss on this frequency increased with the duration of occupation. Protective helmets did not prevent the development of the affection. It remains to be seen however whether the temporary measures were maintained.},
  issn = {90809},
}

@article{ethylapovincaminateinthetreatm1976,
  author = {Ribari O.; Zelen B.; Kollar B.},
  title = {{Ethyl} apovincaminate in the treatment of sensorineural impairment of hearing},
  year = {1976},
  volume = {26},
  number = {10 A},
  abstract = {Ethyl apovincaminate (EGH 4405, Cavinton) treatment has been used in various sensorineural impairments of hearing as well as in ear diseases associated with vertigo. As shown by experiences, presbyacusis, vascular impairment of hearing and in certain cases toxic hypacusia are improved by Cavinton. Besides audiometric improvement of pure tone, significant improvement was noted in the speech audiogram in all three groups of disease. Certain affections of the ear accompanied by vertigo responded to Cavinton. In Meniere's disease it has proved to be superior to the vasodilators used up to now.},
  issn = {44172},
}

@article{nicergolineintreatmentofaffect1976,
  author = {Modica V.; Rispoli G.},
  title = {{Nicergoline} in treatment of affections of the internal ear; {[IMPIEGO} {CLINICO} {DI} {SERMION} {IN} {AFFEZIONI} {DELL'ORECCHIO} {INTERNO]}},
  year = {1976},
  volume = {31},
  number = {3},
  abstract = {[No abstract available]},
}

@article{thecohesivenessofalcoholismcom1976,
  author = {Orford J.; Oppenheimer E.; Egert S.; Hensman C.; Guthrie S.},
  title = {{The} cohesiveness of alcoholism complicated marriages and its influence on treatment outcome},
  year = {1976},
  volume = {128},
  number = {4},
  doi = {10.1192/bjp.128.4.318},
  abstract = {One hundred husbands, diagnosed as suffering from alcoholism, and their wives, were followed up twelve months after initial consultation and assessment. Follow up information was complete in 89 cases. On the basis of both husband and wife accounts of the husband's drinking behaviour during the follow up period, and their assessment of the drinking problem at twelve months follow up, 28 were classified as having a 'good' outcome and 29 as having a 'bad' outcome. In the remaining 32 cases outcome was considered 'equivocal'. A composite measure of marital cohesion was predictive of twelve month outcome classification, cohesive marriages being significantly more likely to have a good outcome. The measure of marital cohesion was based upon husband and wife reports of mutual affection and of husband involvement in family tasks, favourable spouse perceptions and meta perceptions, and optimism about the future of the marriage. Composite measures of dominance balance within the marriage were not predictive of outcome. Huband's job status, husband's self esteem, and wife's reported hardship were not independent of marital cohesion, and were themselves predictive of twelve months outcome. When these variables were partially controlled it was found that marital cohesion remained predictive for husbands with relatively low status jobs and husbands with relatively low levels of self esteem. It is an over simplification to state that either the marriage, the spouse, or the severity of the patient's condition is alone the cause of variation in outcome. It is possible to integrate these findings with those of other studies on the influence of family variables on the outcome of conditions other than alcoholism. Together these studies suggest a general hypothesis linking a breakdown in the cohesiveness, or mutual rewardingness, of family relationships and unfavourable outcomes following treatment or consultation for psychological disorder.},
  issn = {71250},
}

@article{experiencewiththeglyceroltesti1976,
  author = {Infante Sanchez J.C.; Allue Jose S.J.L.},
  title = {{Experience} with the glycerol test in labyrinthine hydrops; {[NUESTRA} {EXPERIENCIA} {CON} {EL} {GLYCEROL} {TEST} {EN} {EL} {HIDROPS} {LABERINTICO]}},
  year = {1976},
  volume = {27},
  number = {2},
  abstract = {A study was made of the glycerol test in labyrinthine hydrops in 22 patients. The writers of the article analyze the advantage and the selectivity of audiometric variation which reaches 30 decibels in severe frequencies. They remark upon the lack of any relationship between the positivity of the test and the duration of the affection, and its independence of recruitment. The prognostic value of the test is also analyzed. Finally, the use of the glycerol test is affirmed for both the diagnosis and prognosis in patients affected by Meniere's disease.},
  issn = {16519},
}

@article{thepsychopathologyoffrontalfoc1975,
  author = {Belyi B.I.},
  title = {{The} psychopathology of frontal focal lesions depending upon the side of affection {(Russian)}},
  year = {1975},
  volume = {75},
  number = {12},
  abstract = {The author studied 36 patients with benign tumors located in one of the frontal lobes: in 20 cases in the left and in 16 cases in the right lobe. In tumors of the left lobe there were disorders in the motor and initiative side of speech, general inhibition, a decline in the level of generalizing, a prevalence of memory disorders (rather than attention) and inertia of mental processes with a preservation of a sense of being ill. Tumors of the right frontal lobe were characterized by an insufficient insight to the illness, euphoria, an absence of a critical understanding of the environment, a prevalence of attention disorders over memory disturbances, a narrowing of the volume of simultaneously perceived information and a tendency towards a confabulatory addition to fragmentarily perceived images.},
}

@article{stargardtdiseaseandfundusflavi1975,
  author = {Francois P.; Turut P.; Puech B.; Hache J.C.},
  title = {{Stargardt} disease and {Fundus} {Flavimaculatus;} {[MALADIE} {DE} {STARGARDT} {ET} {FUNDUS} {FLAVIMACULATUS]}},
  year = {1975},
  volume = {35},
  number = {11},
  abstract = {From their sixty two personal observations and a study of literature cases, the authors demonstrate that the ophthalmoscopic, fluoroscopic and functional aspects of macular lesions are strictly identical in Stargardt disease and in Fundus Flavimaculatus. Their transmission is also identical, generally autosomal and recessive, more rarely dominant. Flavimaculate lesions situated in perimacular or in peripheric area may coexist in the same family, and certainly correspond to variable forms of expressivity of a unique gene. The authors discuss the nosologic problems brought by these two affections and other juvenile macular degenerations. Their conclusions are that the same disease may present three different forms: pure Stargardt disease; Stargardt disease with perimacular flavimaculate crown; and Stargardt disease with peripheric Fundus Flavimaculatus.},
}

@article{acomparisonoffemalesupervisors1975,
  author = {DiMarco N.; Whitsitt S.E.},
  title = {{A} comparison of female supervisors in business and government organizations},
  year = {1975},
  volume = {6},
  number = {2},
  doi = {10.1016/0001-8791(75)90045-7},
  abstract = {This exploratory study compared the life style and interpersonal need orientation, leadership style, and perception of the organization structure of female supervisors in business and government organizations. The government group had a significantly higher formalistic and lower sociocentric and personalistic life style orientation; lower needs for expressed control, expressed affection, wanted inclusion, wanted affection, and a higher need for wanted control; were lower on consideration and higher on structure leadership dimensions; and perceived their organization as being more bureaucratic and less collaborative and coordinative than the business group. The findings were discussed in terms of the processes of individual-organization congruity and organizational socialization. Â© 1975.},
  issn = {18791},
}

@article{thephenomenologyofbeingatarget1975,
  author = {Dion K.L.; Earn B.M.},
  title = {{The} phenomenology of being a target of prejudice},
  year = {1975},
  volume = {32},
  number = {5},
  doi = {10.1037/0022-3514.32.5.944},
  abstract = {Studied the effects of perceived prejudice upon affect and self-evaluation by experimentally investigating the reactions of 48 Jewish male undergraduates to failure in an interpersonal situation. Ss attributing their failure to religious discrimination by Gentiles reported feeling more aggression, sadness, anxiety, and egotism on the Mood Adjective Check List than those who could not invoke anti-Semitism as an explanation for their failure. Moreover, they indicated less "social affection," particularly when one of the prejudiced opponents constituted the audience for their self-presentation. Finally, in response to perceived prejudice, Ss also evaluated themselves more favorably on positive traits underlying the Jewish stereotype. Findings are explained in terms of a stress interpretation. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1975 American Psychological Association.},
  issn = {223514},
  keywords = {perceived prejudice, affective \&; self evaluation reactions to failure in interpersonal situation, Jewish male college students},
}

@article{effectsofsexofsubjectandstoryc1975,
  author = {Deutsch F.},
  title = {{Effects} of sex of subject and story character on preschoolers' perceptions of affective responses and intrapersonal behavior in story sequences},
  year = {1975},
  volume = {11},
  number = {1},
  doi = {10.1037/h0076130},
  abstract = {Data from 32 white, lower-class 3- and 4-yr-old children indicate that the ability to accurately identify affective and intrapersonal responses did not significantly vary with S's age or sex, or with sex of story character, and that children performed better on same-sex rather than on cross-sex stories regardless of age and mental ability. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1975 American Psychological Association.},
  issn = {121649},
  keywords = {sex of story character \& age \& subject, perceptions of affective responses \& intrapersonal behavior in story sequences, white lower-class 3 \& 4 yr olds},
}

@article{roletakingandmoraljudgmentinfi1975,
  author = {Ambron S.R.; Irwin D.M.},
  title = {{Role} taking and moral judgment in five- and seven-year-olds},
  year = {1975},
  volume = {11},
  number = {1},
  doi = {10.1037/h0076110},
  abstract = {Studied 3 dimensions of role taking (perceptual, cognitive, and affective) and 2 dimensions of moral judgment (intentionality and restitution) in 34 kindergartners and 38 2nd graders. Results show that there was a significant correlation between moral judgment and role taking and indicate the need for precise definitions of these concepts and the use of common instruments if research in this area is to make any progress. (PsycINFO Database Record (c) 2006 APA, all rights reserved). Â© 1975 American Psychological Association.},
  issn = {121649},
  keywords = {role taking \& moral judgment dimensions, kindergartners \& 2nd graders},
}

@article{fatherabsenceperceivedmaternal1975,
  author = {Santrock J.W.},
  title = {{Father} absence, perceived, maternal behavior, and moral development in boys.},
  year = {1975},
  volume = {46},
  number = {3},
  doi = {10.1111/j.1467-8624.1975.tb03377.x},
  abstract = {The rated and observed moral behavior, judgment, and affect of 120 preadolescent, predominantly lower-class boys from early-divorced (before the boys were 6), late-divorced (between 6 and 10), and parentally intact homes were investigated. In addition, the mothers' discipline (power assertive, inductive, and love withdrawal) and affection were examined by asking subjects about their mothers' methods of dealing with their transgressions. Moral behavior was assessed with resistance-to-temptation, self-criticism, altruism, reparation, and teacher-rating measures, while moral judgment was evaluated with 3 Kohlberg items and moral affect was investigated with 2 story-completion items maximizing guilt. The major findings were: (1) when relevant variables (IQ, SES, age, sibling status) were controlled, few differences were found between father-absent and father-present boys; (2) however, father-absent boys were reported by their teachers as less advanced in moral development than father-present boys; (3) the sons of the divorced women showed more "social deviation", according to their teachers, but were more advanced in level of moral judgment than were the sons of widows; (4) divorced women disciplined with more power assertion than widows, according to their sons' reports.},
  issn = {93920},
}

@article{mentalhealthandtheurbanenviron1975,
  author = {Kasl S.V.; Harburg E.},
  title = {{Mental} health and the urban environment: some doubts and second thoughts},
  year = {1975},
  volume = {16},
  number = {3},
  doi = {10.2307/2136876},
  abstract = {Interviews assessing perceptions and evaluations of the residential environment and selected indicators of mental health and well being were conducted with 1000 residents of 4 carefully selected census tracts of Detroit. Two tracts were 'high stress' (low on socioeconomic indices and high on rates of crime and marital and residential instability) and 2 were 'low stress' areas; one tract in each group was predominantly black or largely white. The major results indicated clear and strong differences in the perceptions of the residential environment by respondents in the contrasting areas. However, differences in mental health and well being could not be clearly established for the residents in the contrasting areas, nor did the perception of the neighborhood show consistent associations with mental health. Blood pressure levels were also unrelated to the environmental perceptions. (Journal received Nov.1976)},
  issn = {221465},
}

@article{evolutivityofusherssyndromeevo1975,
  author = {Morgon A.; Boulud B.},
  title = {{Evolutivity} of {Usher's} syndrome; {[EVOLUTIVITE} {DU} {SYNDROME} {D'USHER]}},
  year = {1975},
  volume = {24},
  number = {8},
  abstract = {Usher's syndrome is a rare affection in which there is a combination of pigmented retinopathy and internal ear deafness. Usually the retinal lesions go on evolving while the deafness appears to be fixed. The authors report the cases of 2 sisters followed up for 10 years, during which interval of time the deafness appears to have evolved greatly, so raising doubt about the supposed fixed character of the deafness in all cases of this affection.},
}

@article{socialenvironmentandhealth1975,
  author = {Lebowitz D.},
  title = {{Social} environment and health},
  year = {1975},
  volume = {4},
  number = {36953.99967592592},
  abstract = {The social environment has a far greater effect on health than is generally assumed. As part of the overall environment, it is the setting in which man and agents (including exposures and other risk factors) interact, leading to symbiosis or disease; man is not proven resistant to most influences of the social environment. The social environment shapes man's perceptions of health and disease and man's reactions to disease. Social factors, and more specifically the urban environment, are thought to play major roles in most chronic diseases. The effects of the social environment are extremely complex, and much of our present knowledge is still hypothetical. Finally, for prevention of disease, only society can change significantly the social environment. (232 references).},
  issn = {3010422},
}

@article{clinicaldiagnosisofinfantileps1975,
  author = {Lara Gallardo T.},
  title = {{Clinical} diagnosis of infantile psychosis; {[DIAGNOSTICO} {CLINICO} {DE} {LAS} {PSICOSIS} {INFANTILES]}},
  year = {1975},
  volume = {16},
  number = {3},
  abstract = {The author has tried to summarize different points of view with regard to the clinical diagnosis of child psychosis. The main purpose is to reach a more universal agreement as a basis for facilitating early diagnosis as well as treatment, and above all better bases for research. Infantile psychosis varies at different levels of growth, according to age; however, it is considered that psychosis in children is basically a disturbance in ego functions. This is clearly evident in thinking process, in affections, perception, motility, language, individualization, disturbance of object relations, and loss of contact with reality. The basic points for the diagnosis of child psychosis proposed by the 'Group for the Advancement of Psychiatry' and initially studied by the English working party headed by Goldberg et al. are discussed: disturbances of interpersonal relationships, indifference or preoccupation with inanimate objects, lack or failure of speech development, alterations in sensorial perception, bizarre or stereotyped behavior, resistance to change routines or change of environment, poor personal identification, unpredictable crises of anger or panic and finally, uneven intellectual development.},
}

@article{technicalconsiderationsoftheth1975,
  author = {Dickes R.},
  title = {{Technical} considerations of the therapeutic and working alliances.},
  year = {1975},
  volume = {4},
  abstract = {A brief survey of the development of the idea of the analytic pact and its relationship to the concepts of the therapeutic and working alliances has been presented. I have suggested that the therapeutic alliance be defined as the full-scale therapeutic rapport which includes all the the elements favorable to the progress of therapy. This includes such factors as the patient's motivation for treatment based on ego-alien symptoms, positive transference, and the rational relationship between patient and therapist. I have considered the working alliance as more limited in scope and suggested that it be considered as referring to the healthier interpersonal interchange between the analyst and patient. In general, the relationship is in part dependent on the maturer portion of the patient's ego and is related to the reality relationship. I have ascribed the working alliance to the appropriate maturation of many of the ego's functions. It should be noted that the working alliance is actually one of the factors contributing to a good therapeutic alliance. Case reports have illustrated these considerations and amplified the discussion of the alliances, with emphasis on their technical management. These points are pertinent to the general conduct of therapy and the timing of interpretations. Care directed to the building of good alliances can be of great importance in creating a milieu conducive to therapeutic progress. Identification and its role in the development of the working alliance, and the special place of affection for the analyst were discussed and the differences between transference affection and the affection based on the realities between patient and therapist were related to the effects of interpretation.},
  issn = {910600},
}

@article{macularvitelliformdegeneration1975,
  author = {Francois P.; Turut P.},
  title = {{Macular} vitelliform degeneration; {[LA} {DEGENERESCENCE} {VITELLIFORME} {DE} {LA} {MACULA]}},
  year = {1975},
  volume = {35},
  number = {37111.99967592592},
  abstract = {Macular vitelliform degeneration is an hereditary affection, with autosomal dominant transmission. It is probably congenital. There are 3 phases in the evolution of lesions: (1) The 'fried egg' aspect. (2) Various ophthalmologic aspects: scrambled eggs, pseudo hypopion, retractile form. During these first 2 phases, the yellowish vitelline substance only, may extend into the macular region, especially downwards. (3) The atrophic phase. Visual acuity remains strangely good, especially during the first 2 phases. Nevertheless, the visual function study, especially color vision and profile perimetry, showed evidence of early involvement of the macular cones, associated with fluorographic alteration of pigmentary epithelium in phases II and III. These lesions are mostly situated in perifoveolar area, with reference to the foveola, which explains conservation of good vision. The electrooculogram is deeply modified in most cases. The pathogenesis of this affection remains unexplained, but the evolution of lesions both in pigmentary epithelium and neuroepithelium enables one to think that vitelline substance lies between these 2 layers.},
}

@article{psychoneurologicidentityofnorm1975,
  author = {Mercuriali A.},
  title = {{Psychoneurologic} identity of normal and phantom bodily experience; {[SULL'IDENTITA} {PSICONEUROLOGICA} {DELLA} {ESPERIENZA} {CORPOREA} {NORMALE} {E} {FANTASMA]}},
  year = {1975},
  volume = {31},
  number = {36894.99967592592},
  abstract = {The results obtained by the author on the relationships between amputees' phantom limbs and associated neurological affections reveal an inhibitory interference only in those cases suffering from rolandic lesion opposite to the amputation, bringing him to question the current somatognostic interpretation of the disease to consider it, instead, as the expression of the same psycho-neurological apparatus held at the basis of normal perception and motion. Thus, the voluntary motion of the phantom limb can be interpreted as the result of one discordance between one normal virtual corollary signal and one abnormal real reafferent signal, 'short-circuited' at the level of the sensitive homologous cerebral cortex, partially 'amputated' and sensitized.},
}

@article{propranololandbehaviorofalcoho1974,
  author = {Mendelson J.H.; Rossi A.M.; Bernstein J.; Kuehnle J.},
  title = {{Propranolol} and behavior of alcohol addicts after acute alcohol ingestion},
  year = {1974},
  volume = {15},
  number = {6},
  doi = {10.1002/cpt1974156571},
  abstract = {Sixty-four adult male chronic alcoholic addicts were studied to assess the effects of propranolol pretreatment on behavioral changes induced by acute ingestion of alcohol. The study was carried out under controlled research ward conditions with a double-blind technique. Pretreatment with 10, 20, and 40 mg of propranolol 4 times a day for 3 consecutive days prior to alcohol administration failed to block or attenuate cognitive, perceptual, motor, and affective changes induced by acute alcohol intoxication. Â© 1974.},
  issn = {99236},
}

@article{clinicalandaudiologicaspectsof1974,
  author = {Kruchinina I.L.; Poddubny V.P.},
  title = {{Clinical} and audiologic aspects of perceptive hearing impairment in children {(Russian)}},
  year = {1974},
  volume = {36},
  number = {3},
  abstract = {Perceptive hearing impairment in children can be due to many causes. Among 717 patients seen from 1967 to 1972 hearing impairment was caused by infectious illness in 13.6% of cases, followed by the use of ototoxic antibiotics in 51.3% and was congenital in 4.7% of cases. Hearing impairment occurs comonly in the neonatal period (as a result of hemolytic disease of the newborn, premature birth, asphyxia, birth trauma); in 51.6% of cases the affection of hearing was combined with organic involvement of the central nervous system and in 48.3% it was an isolated finding. In hemolytic disease of the newborn hearing impairment depends not on the etiologic but on the pathogenetic factor, viz. the effect of a high blood level of indirect bilirubin. An aggravated obstetric anamnesis, prematurity, birth trauma and asphyxia conduce to more severe functional disturbance of the acoustic analyzer. Etiologic factors of hearing impairment (congenital and of the neonatal period) point to the necessity of prophylaxis of hearing impairment during pregnancy and labor.},
  issn = {424668},
}

@article{neuropathyinchronicrenalinsuff1974,
  author = {Jennekens F.G.I.},
  title = {{Neuropathy} in chronic renal insufficiency: the significance of the examination of the conduction velocity and sense of vibration {(Dutch)}},
  year = {1974},
  volume = {118},
  number = {42},
  abstract = {Severe renal insufficiency causes an affection of the peripheral nerve trunks; this affection forms part of the syndrome that may occur in uremic patients. The conduction in the sensory as well as in the motor nerve fibers can be examined; as these 2 groups of fibers are affected to about the same degree, it is sufficient to determine the simplest measurable conduction velocity, i.e. the motor conduction velocity (MCV). There is no point in regularly determining conduction velocities in every patient with renal insufficiency. As long as no signs of neuropathy are found in the physical examination, the deceleration in the conduction will be small. Under normal circumstances, tuning fork vibrations at the hallux should be recognized upt to at least 60 yr of age. According to the author's experiences, children and adolescents feel the vibration of the tuning fork for 10-15 sec; in young adults the normal duration of perception is 5-10 sec, older people feel the vibration for about 5 sec or shorter. The normal duration of perception at the finger tips is about 10-20 sec; in uremic neuropathy a decreased duration of perception at the finger tips is however no early symptom. The examination of the vibratory sense and the determination of the conduction velocity are important, supplementing acids for the physician who deals with patients suffering from chronic renal insufficiency.},
  issn = {282162},
}

