  author = {Bystryantseva N.V.; Matveev N.V.},
  title = {{Human} perception system identification of illuminated spaces and urban environment objects},
  year = {2014},
  volume = {22},
  number = {3},
  abstract = {The article describes an attempt to apply "eyetracking" system analysis in identifying perceptions of fragments in the urban environment and object brightness characteristics under artificial illumination and daylight conditions. Â© 2014, LLC Editorial of Journal âLight Technikâ. All rights reserved.},
