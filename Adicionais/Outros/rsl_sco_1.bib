@article{routeplanningandnavigationaidf2021,
  author = {Chatzina P.; Gavalas D.},
  title = {{Route} {Planning} and {Navigation} {Aid} for {Blind} and {Visually} {Impaired} {People}},
  year = {2021},
  doi = {10.1145/3453892.3461834},
  abstract = {The lack of visual perception makes outdoor wayfinding an extremely challenging task for Blind and Visually Impaired People (BVIP), especially in urban environments where the conditions on streets and pavements are highly dynamic. The unpredicted nature of obstacles and other types of hazards causes anxiety to BVIP. In this paper, we present an assistive mobile application which provides route planning and real-time navigation taking into account both the permanent and transient obstacles reported by the users themselves (i.e., adopting a crowdsourcing approach) through a specially designed user interface. Subsequently, route planning queries are handled taking into account current obstacles to derive BVIP-friendly routes. In-progress navigation sessions are instantly updated in case they are affected by reported incidents. The application also provides a volunteer mode which enables BVIP to receive real-time assistance from sighted citizens through a video call. The application's functionalities have been evaluated by implementing three usage scenarios. Â© 2021 ACM.},
  publisher = {Association for Computing Machinery},
  isbn = {978-145038792-7},
  keywords = {assistive application; blind; crowdsourcing; incident reporting; navigation; route planning; Visually impaired; volunteering},
}

@article{revisitingempathygamesconceptf2021,
  author = {De Melo Pinheiro T.S.; ValÃ©rio C.C.; MacIel C.; Da Hora Rodrigues K.R.; Dos Santos Nunes E.P.},
  title = {{Revisiting} {Empathy} {Games} {Concept} from {User} {Comments} {Perspective}},
  year = {2021},
  doi = {10.1145/3472301.3484359},
  abstract = {Among the types of games, incipient concepts about empathy games are found in the literature. Empathy is associated with a human ability to put oneself in the other's place, in the case of games, it can be associated with the fact that the player puts himself in the situation/role of the virtual characters. In this context, it is essential to conceptualize and characterize this type of game, to specify the components and the design process in this field. Therefore, the objective of this paper is to understand a concept of empathetic games based on the concept of empathy and the perception of users. The methodology started with a survey of aspects that emerged from the comments of users of four empathic games, grouping them into - technical, emotional, physiological, game theme, and several others. Afterwards, a bibliographic survey was carried out on observable components associated with the concept of empathy, called "expressions of empathy", which could be identified in the users' comments, establishing components involving cognition, affection, behavior and perception. The presence of the aspects raised in the comments containing some expression of empathy signaled a characterization of empathetic games, which was compared with the bibliographical survey on the conceptualization of empathic games arriving at a version of the concept of empathic games described in the form of expressions of empathy. From these results, it is expected to contribute to game developers and designers about the concepts with artifacts and teachings that lead to the construction of a conceptual framework with characteristics of empathy  Â© 2021 ACM.},
  publisher = {Association for Computing Machinery},
  isbn = {978-145038617-3},
  keywords = {Conceptual Framework; Digital Games; Empathic Games; Empathy},
}

@article{patientsperceptionoftheopenspa2021,
