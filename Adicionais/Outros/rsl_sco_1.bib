@article{chlordiazepoxideinducedhostili1974,
  author = {Salzman C.; Kochansky G.E.; Shader R.I.; Porrino L.J.; Harmatz J.S.; Swett C.P., Jr.},
  title = {{Chlordiazepoxide-Induced} {Hostility} in a {Small} {Group} {Setting}},
  year = {1974},
  volume = {31},
  number = {3},
  doi = {10.1001/archpsyc.1974.01760150103015},
  abstract = {A small group model was used to examine the effects of chlordiazepoxide hydrochloride on affective and behavioral hostility in a social interactive setting. Three-person groups of male volunteers completed paper-and-pencil affective-rating scales individually and interacted with each other during a ten-minute discussion period that was videotaped and scored for behavioral hostility. The results indicated that chlordiazepoxide was associated with an increase in individual affective but not behavioral hostility. However, when a frustration stimulus was presented to the group, interpersonal behavioral hostility was increased in those who received chlordiazepoxide as compared with those taking a placebo. The data suggest that increases in hostility may be a regular rather than paradoxical effect of chlordiazepoxide. However, overt hostility may only become apparent in settings of interpersonal frustration. Â© 1974 American Medical Association. All rights reserved.},
  issn = {0003990X},
}

