  volume = {103},
  pages = {123--125},
  doi = {10.2307/3432360},
  publisher = {US DEPT HEALTH HUMAN SCIENCES PUBLIC HEALTH SCIENCE},
  issn = {0091-6765},
  keywords = {RISK PERCEPTION; RISK COMMUNICATION; ENVIRONMENTAL HEALTH POLICY; SCIENCE AND THE MEDIA},
