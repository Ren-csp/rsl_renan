  author = {Rahmat, H},
  title = {{Untitled}},
  year = {2020},
  pages = {107--128},
  doi = {10.1007/978-981-13-6605-5_5},
  publisher = {PALGRAVE MACMILLAN},
  isbn = {978-981-13-6605-5; 978-981-13-6604-8},
