  keywords = {collaboration; Fiji; fuzzy cognitive mental modeling; gender; iTaukei; valuation; colaboraci \& oacute;n; Fiyi; g \& eacute;nero; modelo mental cognitivo difuso; valoraci \& oacute;n; (sic)(sic); (sic)(sic); (sic)(sic); (sic)(sic); (sic)(sic)(sic)(sic)(sic)(sic)(sic)(sic)},
