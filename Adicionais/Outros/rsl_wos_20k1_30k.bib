  author = {Medina, V; DeRonda, A; Ross, N; Curtin, D; Jia, FL},
  title = {{Untitled}},
  year = {2019},
  volume = {10},
  doi = {10.3389/fpsyg.2019.00629},
  publisher = {FRONTIERS MEDIA SA},
  issn = {1664-1078},
  keywords = {ethnicity; environmental belief; environmental behavior; USA; ethnic minority; immigrant},
