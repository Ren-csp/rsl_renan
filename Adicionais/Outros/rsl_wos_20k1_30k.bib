  author = {Smith, A},
  title = {{Untitled}},
  year = {2019},
  pages = {205--224},
  doi = {10.16997/book35.j},
  publisher = {UNIV WESTMINSTER PRESS},
  isbn = {978-1-912-65627-1; 978-1-912-65626-4},
