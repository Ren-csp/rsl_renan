  author = {Catapoti, D; Skounaki, I; Gkoumopoulou, G},
  title = {{Untitled}},
  year = {2020},
  pages = {67--94},
  doi = {10.5334/bcj.e},
  publisher = {Ubiquity Press Ltd},
  isbn = {978-1-911529-60-6; 978-1-911529-61-3},
