  number = {1},
  doi = {10.1111/jola.70037},
  abstract = {This paper investigates how participants recruit Large Language Models (LLMs) like ChatGPT as interactional co-participants depending on their temporal enmeshment within an interactional flow. Using Charles Goodwin's co-operative action framework, we analyze video data of human-AI interaction to trace the temporal structures established by human participants that define the LLM's participant role. We show how participants alternately orient to the artificial conversational agent as a dynamic human-like interlocutor and as a static, persistent document. Our findings contribute to understanding the role of temporality in establishing participation frameworks in human-AI interaction and problematize the effects of technological features on interaction, the malleability of language and tools, and the unique nature of language machines. \& Vcy; \& scy;\& tcy;\& acy;\& tcy;\& softcy;\& iecy; \& icy;\& scy;\& scy;\& lcy;\& iecy;\& dcy;\& ucy;\& iecy;\& tcy;\& scy;\& yacy;, \& kcy;\& acy;\& kcy; \& lcy;\& yucy;\& dcy;\& icy; \& rcy;\& iecy;\& kcy;\& rcy;\& ucy;\& tcy;\& icy;\& rcy;\& ucy;\& yucy;\& tcy; \& bcy;\& ocy;\& lcy;\& softcy;\& shcy;\& icy;\& iecy; \& yacy;\& zcy;\& ycy;\& kcy;\& ocy;\& vcy;\& ycy;\& iecy; \& mcy;\& ocy;\& dcy;\& iecy;\& lcy;\& icy; (\& Bcy;\& YAcy;\& Mcy;), \& tcy;\& acy;\& kcy;\& icy;\& iecy; \& kcy;\& acy;\& kcy; ChatGPT, \& vcy; \& kcy;\& acy;\& chcy;\& iecy;\& scy;\& tcy;\& vcy;\& iecy; \& pcy;\& acy;\& rcy;\& tcy;\& ncy;\& iecy;\& rcy;\& ocy;\& vcy; \& pcy;\& ocy; \& vcy;\& zcy;\& acy;\& icy;\& mcy;\& ocy;\& dcy;\& iecy;\& jcy;\& scy;\& tcy;\& vcy;\& icy;\& yucy; \& vcy; \& zcy;\& acy;\& vcy;\& icy;\& scy;\& icy;\& mcy;\& ocy;\& scy;\& tcy;\& icy; \& ocy;\& tcy; \& icy;\& khcy; \& tcy;\& iecy;\& mcy;\& pcy;\& ocy;\& rcy;\& acy;\& lcy;\& softcy;\& ncy;\& ocy;\& jcy; \& vcy;\& scy;\& tcy;\& rcy;\& ocy;\& iecy;\& ncy;\& ncy;\& ocy;\& scy;\& tcy;\& icy; \& vcy; \& icy;\& ncy;\& tcy;\& iecy;\& rcy;\& acy;\& kcy;\& tscy;\& icy;\& ocy;\& ncy;\& ncy;\& ycy;\& jcy; \& pcy;\& ocy;\& tcy;\& ocy;\& kcy;. \& Ocy;\& scy;\& ncy;\& ocy;\& vcy;\& ycy;\& vcy;\& acy;\& yacy;\& scy;\& softcy; \& ncy;\& acy; \& kcy;\& ocy;\& ncy;\& tscy;\& iecy;\& pcy;\& tscy;\& icy;\& icy; \& kcy;\& ocy;-\& ocy;\& pcy;\& iecy;\& rcy;\& acy;\& tscy;\& icy;\& ocy;\& ncy;\& ncy;\& ocy;\& gcy;\& ocy; \& dcy;\& iecy;\& jcy;\& scy;\& tcy;\& vcy;\& icy;\& yacy; \& CHcy;\& acy;\& rcy;\& lcy;\& softcy;\& zcy;\& acy; \& Gcy;\& ucy;\& dcy;\& vcy;\& icy;\& ncy;\& acy;, \& acy;\& vcy;\& tcy;\& ocy;\& rcy;\& ycy; \& acy;\& ncy;\& acy;\& lcy;\& icy;\& zcy;\& icy;\& rcy;\& ucy;\& yucy;\& tcy; \& vcy;\& icy;\& dcy;\& iecy;\& ocy;\& dcy;\& acy;\& ncy;\& ncy;\& ycy;\& iecy; \& vcy;\& zcy;\& acy;\& icy;\& mcy;\& ocy;\& dcy;\& iecy;\& jcy;\& scy;\& tcy;\& vcy;\& icy;\& yacy; \& lcy;\& yucy;\& dcy;\& iecy;\& jcy; \& scy; \& icy;\& scy;\& kcy;\& ucy;\& scy;\& scy;\& tcy;\& vcy;\& iecy;\& ncy;\& ncy;\& ycy;\& mcy; \& icy;\& ncy;\& tcy;\& iecy;\& lcy;\& lcy;\& iecy;\& kcy;\& tcy;\& ocy;\& mcy; (\& Icy;\& Icy;) \& icy; \& vcy;\& ycy;\& dcy;\& iecy;\& lcy;\& yacy;\& yucy;\& tcy; \& ucy;\& scy;\& tcy;\& acy;\& ncy;\& acy;\& vcy;\& lcy;\& icy;\& vcy;\& acy;\& iecy;\& mcy;\& ycy;\& iecy; \& lcy;\& yucy;\& dcy;\& softcy;\& mcy;\& icy; \& tcy;\& iecy;\& mcy;\& pcy;\& ocy;\& rcy;\& acy;\& lcy;\& softcy;\& ncy;\& ycy;\& iecy; \& scy;\& tcy;\& rcy;\& ucy;\& kcy;\& tcy;\& ucy;\& rcy;\& ycy;, \& kcy;\& ocy;\& tcy;\& ocy;\& rcy;\& ycy;\& iecy; \& ocy;\& pcy;\& rcy;\& iecy;\& dcy;\& iecy;\& lcy;\& yacy;\& yucy;\& tcy; \& rcy;\& ocy;\& lcy;\& softcy; \& Bcy;\& YAcy;\& Mcy; \& kcy;\& acy;\& kcy; \& ucy;\& chcy;\& acy;\& scy;\& tcy;\& ncy;\& icy;\& kcy;\& acy; \& vcy;\& zcy;\& acy;\& icy;\& mcy;\& ocy;\&A \& Acy;\& vcy;\& tcy;\& ocy;\& rcy;\& ycy; \& pcy;\& rcy;\& ocy;\& bcy;\& lcy;\& iecy;\& mcy;\& acy;\& tcy;\& icy;\& zcy;\& icy;\& rcy;\& ucy;\& yucy;\& tcy; \& vcy;\& lcy;\& icy;\& yacy;\& ncy;\& icy;\& iecy; \& tcy;\& iecy;\& khcy;\& ncy;\& ocy;\& lcy;\& ocy;\& gcy;\& icy;\& chcy;\& iecy;\& scy;\& kcy;\& icy;\& khcy; \& khcy;\& acy;\& rcy;\& acy;\& kcy;\& tcy;\& iecy;\& rcy;\& icy;\& scy;\& tcy;\& icy;\& kcy; \& ncy;\& acy; \& vcy;\& zcy;\& acy;\& icy;\& mcy;\& ocy;\& dcy;\& iecy;\& jcy;\& scy;\& tcy;\& vcy;\& icy;\& iecy;, \& ocy;\& bcy;\& scy;\& ucy;\& zhcy;\& dcy;\& acy;\& yucy;\& tcy; \& pcy;\& lcy;\& acy;\& scy;\& tcy;\& icy;\& chcy;\& ncy;\& ocy;\& scy;\& tcy;\& softcy; \& yacy;\& zcy;\& ycy;\& kcy;\& acy; \& icy; \& icy;\& ncy;\& scy;\& tcy;\& rcy;\& ucy;\& mcy;\& iecy;\& ncy;\& tcy;\& ocy;\& vcy;, \& acy; \& tcy;\& acy;\& kcy;\& zhcy;\& iecy; \& pcy;\& ocy;\& dcy;\& chcy;\& iecy;\& rcy;\& kcy;\& icy;\& vcy;\& acy;\& yucy;\& tcy; \& ucy;\& ncy;\& icy;\& kcy;\& acy;\& lcy;\& softcy;\& ncy;\& ucy;\& yucy; \& pcy;\& rcy;\& icy;\& rcy;\& ocy;\& dcy;\& ucy; \& yacy;\& zcy;\& ycy;\& kcy;\& ocy;\& vcy;\& ycy;\& khcy; \& mcy;\& acy;\& shcy;\& icy;\& ncy;.},
