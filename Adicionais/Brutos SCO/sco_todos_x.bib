@ARTICLE{Kim2027,
	author = {Kim, Hyeon Min and Han, Seung Won and Hong, Seong-Yong and Jang, Myeong-Guen and Kim, Hyeon-Su and Lee, Dong-Hyun},
	title = {Multi-sensor fusion and semantic-geometric navigation for robotic monitoring of improper micromobility parking on pedestrian pathways},
	year = {2027},
	journal = {Expert Systems with Applications},
	volume = {332},
	pages = {},
	doi = {10.1016/j.eswa.2026.133688},
	url = {https://www.scopus.com/pages/publications/105045105866?origin=resultslist},
	affiliations = {School of Electronic Engineering, Kumoh National Institute of Technology, 61 Daehak-ro, Gyeongbuk, Gumi, 39177, South Korea; Department of IT Convergence Engineering, Kumoh National Institute of Technology, 61 Daehak-ro, Gyeongbuk, Gumi, 39177, South Korea},
	abstract = {Shared micromobility vehicles (SMVs), such as e-scooters and e-bicycles, have become an integral component of urban transportation systems. However, improper parking of SMVs on pedestrian pathways disrupts mobility and poses growing safety concerns. This article presents an autonomous robotic monitoring system designed to detect, geolocate, and report improperly parked SMVs in urban environments. To navigate safely, the robot employs a multi-sensor fusion localization framework for reliable positioning in global navigation satellite system (GNSS)-degraded areas, alongside a semantic segmentation network for pathway-constrained autonomous navigation. Simultaneously, a deep learning-based perception module detects improperly parked SMVs and transmits cropped vehicle images and geospatial locations to a cloud-based monitoring system. This cloud-connected monitoring architecture issues real-time notifications to shared micromobility service providers (SMSPs), allowing immediate visual verification and intervention. Field experiments over a 1.32 km urban-like campus route demonstrated reliable end-to-end performance, including a low intervention ratio of 2.28%, a detection precision of 86.2%, a recall of 92.6%, an F1-score of 89.3%, and an average cloud-reporting latency of 2.27 s. These results validate the feasibility of the proposed system as a practical expert monitoring tool for improving micromobility management and ensuring the safety and accessibility of public spaces. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Autonomous mobile robot; Expert monitoring system; Multi-sensor fusion; Semantic-geometric navigation; Shared micromobility},
	keywords = {Deep learning; Mobile robots; Navigation; Pedestrian safety; Semantic Web; Semantics; Urban planning; Urban transportation; Visual servoing; Autonomous Mobile Robot; Expert monitoring system; Integral components; Micro-mobility; Monitoring system; Multi-sensor fusion; Safety concerns; Semantic-geometric navigation; Shared micromobility; Urban transportation systems; Global positioning system},
	correspondence_address = {D.-H. Lee; School of Electronic Engineering, Kumoh National Institute of Technology, Gumi, 61 Daehak-ro, Gyeongbuk, 39177, South Korea; email: donglee@kumoh.ac.kr},
	publisher = {Elsevier Ltd},
	issn = {09574174},
