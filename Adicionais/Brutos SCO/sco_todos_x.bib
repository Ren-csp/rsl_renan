@ARTICLE{Gulnerman2027395,
	author = {Gulnerman, Ayse Giz},
	title = {Assessing the Availability of Crowdsourced Street-Level Imagery for Urban Perception Mapping},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16765 LNCS},
	pages = {395 - 408},
	doi = {10.1007/978-3-032-30536-7_25},
	url = {https://www.scopus.com/pages/publications/105043996148?origin=resultslist},
	affiliations = {Ankara Hacı Bayram Veli University, Ankara, 06560, Turkey},
	abstract = {The integration of urban science with spatial artificial intelligence, referred to as Urban-AI or Geo-AI, is playing an increasingly important role in monitoring cities, supporting urban planning, and addressing urban challenges. In this context, investigating how cities are perceived by individuals and understanding the effects of urban environments on people have emerged as important research topics that can directly influence individuals’ quality of life. In recent years, street-level imagery (SLI) has been widely used to evaluate urban perception through artificial intelligence-based algorithms. In particular, generative artificial intelligence offers growing potential for analyzing urban environments and supporting the development of spatial solutions. However, ethical risks such as algorithmic bias, socio-economic inequalities, and data representativeness issues remain important concerns. Therefore, before enabling generative AI-based systems to support transformations in urban environments, it is critical to investigate their functionality and development from a spatial data perspective. This study presents an empirical framework to evaluate the usability of crowdsourced SLI for urban perception research. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	author_keywords = {Crowdsourced Data; Data Representativeness; Geo-AI; Spatial Data Quality; Street-Level Imagery (SLI); Urban Perception Mapping},
	keywords = {Artificial intelligence; Crowdsourcing; Economics; Urban growth; Algorithmics; Crowdsourced data; Data representativeness; Geo-AI; Quality of life; Research topics; Spatial data quality; Street-level imagery; Urban environments; Urban perception mapping; Mapping},
	correspondence_address = {A.G. Gulnerman; Ankara Hacı Bayram Veli University, Ankara, 06560, Turkey; email: ayse.gulnerman@hbv.edu.tr},
	editor = {Gervasi O. and Faginas Lago M.N. and Murgante B. and Garau C. and Rocha A.M.A.C. and Braga A.C. and Karaca Y.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303230535-0},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Gargiulo2027413,
	author = {Gargiulo, Carmela and Stiuso, Tonia and Zucaro, Floriana and Pugliese, Francesco and Speranza, Giuseppe and Scarano, Vincenzo},
	title = {Urban Climate Adaptation in Naples: An Integrated Framework for Flood Risk, Urban Heat Island, and Nature-Based Intervention Planning},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16761 LNCS},
	pages = {413 - 428},
	doi = {10.1007/978-3-032-30527-5_27},
	url = {https://www.scopus.com/pages/publications/105044969895?origin=resultslist},
	affiliations = {Department of Civil, Building and Environmental Engineering, University of Naples Federico II, P.le Tecchio 80, Naples, 80125, Italy; A2A Ciclo Idrico S.p.A, Via Lamarmora 230, Brescia, 25124, Italy},
	abstract = {In densely built cities, the progressive replacement of permeable surfaces with impervious, heat-retaining materials simultaneously reduces infiltration capacity, amplifying urban flood risk and limits evapotranspiration, thus intensifying the Urban Heat Island (UHI) effect. These two climate-related hazards share a common structural driver and are particularly severe in compact, socially heterogeneous urban neighbourhoods where green infrastructures are scarce and drainage systems are ageing. This paper proposes an integrated methodology for urban climate adaptation applied to three Naples districts (Fuorigrotta, Ponticelli, Soccavo), combining: (i) flood risk mapping through coupled EPA SWMM+FLO-2D hydraulic modelling and CubiST machine learning vulnerability assessment; (ii) open space microclimate simulation via ENVI-met to quantify thermal co-benefits of greening scenarios; and (iii) spatially explicit Low-Impact Development-Best Management Practices (LID-BMP) and greening siting based on compound risk overlay. For flood risk (R), the formulation R = H × E × V allows integrating the hydraulic hazard (H) with socio-economic vulnerability (V) and exposure (E) into a composite index suitable for spatial planning. For UHI, where no analogous probabilistic risk framework is established in the literature, thermal performance is assessed through ENVI-met simulations comparing the baseline scenario with design ones including post-greening open space configurations. Cooling co-benefits through PET and outdoor air temperature are also quantified. Results show that nature-based interventions in open spaces generate compound reductions in both flood risk and thermal stress, providing local decision-makers with a physically grounded, spatially explicit evidence base for urban renewal investment. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	author_keywords = {Climate adaptation; ENVI-met; EPA SWMM; Low-Impact Development-Best Management Practices; Naples; Nature-Based Solutions; Open spaces; Urban flood risk; Urban Heat Island},
	keywords = {Atmospheric temperature; Economics; Flood control; Floods; Hydraulic machinery; Investments; Risk management; Risk perception; Urban planning; Best Management Practise; Climate adaptation; ENVI-met; EPA SWMM; Low impacts; Low-impact development-best management practice; Naple; Nature-based solution; Open space; Urban flood risks; Urban heat island; Risk assessment},
	correspondence_address = {F. Zucaro; Department of Civil, Building and Environmental Engineering, University of Naples Federico II, Naples, P.le Tecchio 80, 80125, Italy; email: floriana.zucaro@unina.it},
	editor = {Gervasi O. and Faginas Lago M.N. and Murgante B. and Garau C. and Rocha A.M.A.C. and Taniar D. and Karaca Y.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303230526-8},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kalisperatos2027242,
	author = {Kalisperatos, Argyrios and Nikolaou, Paraskevas and Nikiforiadis, Andreas and Fountas, Grigorios and Campisi, Tiziana and Basbas, Socrates},
	title = {Who Owns the Space? A Near-Accident Perception of e-Scooters Riders in Interaction with Pedestrians},
	year = {2027},
	journal = {Lecture Notes in Computer Science},
	volume = {16761 LNCS},
	pages = {242 - 255},
	doi = {10.1007/978-3-032-30527-5_16},
	url = {https://www.scopus.com/pages/publications/105044796636?origin=resultslist},
	affiliations = {Aristotle University of Thessaloniki, Thessaloniki, 54124, Greece; Cyprus University of Technology, Limassol, 3603, Cyprus; Democritus University of Thrace, Xanthi, 67100, Greece; University of Enna “Kore”, Enna, 94100, Italy},
	abstract = {The rapid growth of e-scooter usage in urban environments has introduced new safety challenges, particularly in shared spaces with pedestrians. This study investigates near-collision interactions between e-scooter riders and pedestrians in a pedestrianized area in Thessaloniki, Greece, based only on 100 observed near-miss incidents. A multidimensional approach is adopted to analyze behavioral responses and interaction dynamics. Ordinal Logistic Regression is employed to examine the factors influencing changes in e-scooter speed (acceleration, no reaction, and varying levels of deceleration) when riders encounter pedestrians. Subsequently, behavioral personas for both e-scooter riders and pedestrians are identified, and a Firth Logistic Regression model is applied to assess the likelihood of high-risk conflicts arising from different persona combinations. The results reveal that while most riders adopt defensive behaviors, a significant proportion of risky responses persists, particularly in the presence of inattentive or unresponsive pedestrians. The findings indicate that near-collision risk is primarily driven by behavioural interactions, while environmental conditions such as congestion further amplify these effects. The results are particularly relevant for urban planners, transport engineers, and policymakers, as they provide evidence to support the design of safer shared spaces and the development of targeted interventions addressing both rider and pedestrian behaviour. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2027.},
	author_keywords = {Collision avoidance behaviour; E-scooters; Micromobility safety; Pedestrian interactions; Risk perception},
	keywords = {Accidents; Behavioral research; Logistic regression; Pedestrian safety; Risk assessment; Urban growth; Urban transportation; Avoidance behaviour; Behavioral interactions; Collision avoidance behavior; Collisions avoidance; E-scooter; Micro-mobility; Micromobility safety; Near-collisions; Pedestrian interaction; Shared spaces; Risk perception},
	correspondence_address = {P. Nikolaou; Cyprus University of Technology, Limassol, 3603, Cyprus; email: paraskevas.nikolaou@cut.ac.cy},
	editor = {Gervasi O. and Faginas Lago M.N. and Murgante B. and Garau C. and Rocha A.M.A.C. and Taniar D. and Karaca Y.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303230526-8},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lin2027,
	author = {Lin, Shihao and Pan, Meilin and Qiu, Jiulu and Shi, Heyue and Peng, Weiwen and Zhong, Wei},
	title = {BlastContextNet: Fast blast loading prediction in large-scale urban environments via spatial perception},
	year = {2027},
	journal = {Reliability Engineering and System Safety},
	volume = {277},
	pages = {},
	doi = {10.1016/j.ress.2026.112964},
	url = {https://www.scopus.com/pages/publications/105041265165?origin=resultslist},
	affiliations = {School of Intelligent Systems Engineering, Sun Yat-sen University, Guangzhou, 510006, China; National Key Laboratory of Intense Pulsed Radiation Simulation and Effect, Northwest Institute of Nuclear Technology, Xi’an, 710024, China},
	abstract = {Accurate and rapid prediction of shock wave propagation in complex urban environments is crucial for hazard assessment. Current deep learning models face computational bottlenecks in large-scale urban scenarios due to the prohibitive costs of global feature pre-processing. To address this, we introduce BlastContextNet, which utilizes a novel Spatial Perception Module (SPM) to efficiently learn local geometric contexts from raw patches, bypassing these expensive computations. Furthermore, BlastContextNet integrates Monte Carlo dropout to provide the capability of uncertainty quantification for blast loading prediction, outputting confidence intervals alongside predicted values. Validated on a comprehensive dataset of 2.35 million points from 334 high-fidelity CFD simulations sampled from 97 unique 1 km-radius sub-domains of a single source-city model, BlastContextNet with MC dropout achieves state-of-the-art performance with a MAPE of 23.033% and a rapid online inference speed of 1.2 ms per point of interest (POI) once the model has been trained. The results demonstrate its superior ability to capture complex physical phenomena efficiently, establishing it as a powerful tool for near real-time, large-scale urban hazard assessment. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {BlastContextNet; Real-time blast loading prediction; Spatial perception; Uncertainty quantification; Urban blasts},
	keywords = {Blasting; Computational efficiency; Deep learning; Forecasting; Hazards; Learning systems; Loading; Uncertainty analysis; Urban planning; Wave propagation; Blast loading; Blastcontextnet; Hazard Assessment; Large-scales; Real- time; Real-time blast loading prediction; Spatial perception; Uncertainty quantifications; Urban blast; Urban environments; Copyrights},
	correspondence_address = {W. Peng; School of Intelligent Systems Engineering, Sun Yat-sen University, Guangzhou, 510006, China; email: pengww3@mail.sysu.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {09518320},
	coden = {RESSE},
	language = {English},
	abbrev_source_title = {Reliab Eng Syst Saf},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Luo2027,
	author = {Luo, Zhengzheng and Marchi, Lia and Gaspari, Jacopo},
	title = {Bridging the gap between scientific evidence and practical assessment: A transferable framework for climate adaptation in public open spaces},
	year = {2027},
	journal = {Environmental Impact Assessment Review},
	volume = {122},
	pages = {},
	doi = {10.1016/j.eiar.2026.108666},
	url = {https://www.scopus.com/pages/publications/105046790637?origin=resultslist},
	affiliations = {Alma Mater Studiorum - University of Bologna, Bologna, 40136, Italy},
	abstract = {Within climate adaptation, a persistent gap remains between scientific research and practical assessment. This gap stems from differences in how knowledge is organized, updated, and translated across domains. To address this issue, this study proposes a data-driven methodological framework with the potential for repeatability. The framework is demonstrated in the context of public open spaces (POSs) and climate adaptation, with pilot validation in a square in Bologna. The study constructs two independent knowledge domains, comprising 62 scientific evidence items and 480 practical assessment items. Thematic clustering and semantic standardization are applied to establish cross-domain comparability. A “three-degree filter” process is then introduced to systematically detect alignment between scientific evidence and assessment practice, producing 29,760 matched records. Then, through multiple cycles of independent assessment, Hierarchical Clustering Analysis (HCA), and secondary screening, robustness and objectivity are improved. The results reveal a consistent pattern. Existing rating systems perform well in assessing physical provision but remain limited in capturing actual use processes and user experience. To address this limitation, the filtered results are translated into an extension module comprising five credits that can be embedded in existing systems. The module adopts a dual-mode design. A quick-check mode supports rapid screening under limited resources, while an expert mode enables quantitative evaluation based on data and defined thresholds. Both modes establish a direct link between environmental performance and actual use. Overall, this study provides both an operational tool and a generalizable framework for translating scientific evidence into practice, thereby supporting more adaptive, evidence-based, and user-centered decision-making. © 2026},
	author_keywords = {Climate adaptation assessment; Cross-domain assessment; Green building rating systems (GBRSs); Public open spaces (POSs); Transferable framework; User behavior and perception},
	keywords = {Bologna [Emilia-Romagna]; Emilia-Romagna; Italy; Behavioral research; Green buildings; Hierarchical clustering; Rating; Semantics; User interfaces; Building ratings; Climate adaptation assessment; Cross-domain; Cross-domain assessment; Domain assessment; Green building rating system; Green buildings; Public open space; Public open spaces; Rating system; Transferable framework; User behaviors; User perceptions; assessment method; green economy; local adaptation; open space; perception; semantic standardization; Decision making; Environmental management},
	correspondence_address = {J. Gaspari; University of Bologna, Department of Architecture, Bologna, Viale del Risorgimento 2, 40136, Italy; email: jacopo.gaspari@unibo.it},
	publisher = {Elsevier Inc.},
	issn = {01959255},
	coden = {EIARD},
	language = {English},
	abbrev_source_title = {Environ. Impact Assess. Rev.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

