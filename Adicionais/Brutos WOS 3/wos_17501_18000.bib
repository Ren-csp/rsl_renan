@inproceedings{ WOS:A1997BJ58M00019,
Author = {Hommel, B},
Editor = {Hommel, B and Prinz, W},
Title = {Toward an action-concept model of stimulus-response compatibility},
Booktitle = {THEORETICAL ISSUES IN STIMULUS-RESPONSE COMPATIBILITY},
Series = {ADVANCES IN PSYCHOLOGY},
Year = {1997},
Volume = {118},
Pages = {281-320},
Note = {Symposium on the Theory of S-R Compatibility, BENEDIKTBEUERN, GERMANY,
   JUN 13-15, 1995},
Abstract = {This chapter highlights the importance of the problem of action coding,
   that is, the cognitive representation of action, for theories of S-R
   compatibility. An action-concept model of S-R compatibility is
   presented, based on considerations of Lotze and Harless on the emergence
   of voluntary action. It assumes that the cognitive code of any
   perceivable, movement-contingent event-hence, action effect-is
   associated with the motor pattern producing it. Accordingly, the
   cognitive system can, and actually does, use these action-effect codes
   to choose between actions and to address motor patterns for action
   generation. That is, action-effect codes serve for perception as well as
   for action control, and are thus called action concepts. The explanatory
   power of the action-concept model is demonstrated for a considerable
   number of findings from compatibility research. It is argued that such a
   model could close a theoretical gap in understanding S-R compatibility
   and the perception-action relationship in general.},
Publisher = {ELSEVIER SCIENCE PUBL B V},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
