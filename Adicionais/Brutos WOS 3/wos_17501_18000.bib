@inproceedings{ WOS:000462188000020,
Author = {Ortan, Delia-Maria},
Editor = {IleanaViscu, DL},
Title = {Case Study - Captured Inside the Parents' Relationship},
Booktitle = {PROCEEDINGS OF 1ST INTERNATIONAL CONFERENCE SUPERVISION IN PSYCHOTHERAPY},
Year = {2018},
Pages = {135-141},
Note = {1st International Conference on Supervision in Psychotherapy, Timisoara,
   ROMANIA, JUN 22, 2018},
Organization = {Univ Tibiscus, Ctr Qualitat Res Counselling \& Psychotherapy},
Abstract = {This case study is presented from the point of view of a therapist
   specialized in integrative psychotherapy, who is being supervised. The
   case history is also presented, in four therapy sessions, working
   methods, the therapist's self-analyses and the need for supervision. The
   client showed at the basis of all of her problems, an anxious type of
   attachment, present both in her professional and in her personal life.
   This type of anxious attachment was acquired by the client as a
   consequence of her perception of the relationship between her parents.
   As an adult, this kind of perception influenced her choices regarding
   her own relationships. The work with this client brought to light the
   same type of situation, experienced by the therapist in her own life,
   not a long time ago. Thus, the need for supervision is connected to the
   type of attachment which is also an anxious one, determining her to take
   on too much responsibility for the client's life.},
