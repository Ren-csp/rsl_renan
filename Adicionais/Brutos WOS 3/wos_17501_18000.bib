Booktitle = {SCHOOL AND HEALTH 21(2)},
Year = {2007},
Pages = {397-402},
Note = {2nd Conference School and Health 21, Brno, CZECH REPUBLIC, AUG 28-30,
   2006},
Abstract = {The requirements arising from the practice of a school psychologist
   together with the study of literature led to delimitation of the topic
   studied and to the definition of the research problem., to study school
   atmosphere from the point of view of teachers as well as pupils and to
   compare the concord or discord in the perception of the class
   atmosphere. The evaluation was done in areas such as teacher's help to
   pupils, orientation of pupils on their work, relationships among
   classmates, interest in the education, order in the class, clarity of
   rules. Qualitative and quantitative methodology was employed in the
   frame of the research. The data gathered were presented to pupils and
   discussed with them. This led to the class' reflection. The same
   procedure was repeated with teachers and concord or discord of their
   perception of climate was evaluated. The extent of intervening variables
   was possible to evaluate only subjectively.},
