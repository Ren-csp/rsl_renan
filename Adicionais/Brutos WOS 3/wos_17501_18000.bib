Organization = {Hunan Univ; Univ Hong Kong; Tsinghua Univ},
Abstract = {The study progress on ICSSWH (integrated Collector Storage Solar Water
   Heater) was introduced. By improving structure of ICSSWH, thermal
   stratification was strengthened, convection heat loss was decreased in
   storage tank, concentration ratio and heat collection efficiency was
   increased. By optimizing material selection, the heat transfer
   coefficient was increased between collector and tank, heat absorptivity
   of collector was increased, while radiation heat loss decreased. By
   utilizing transparent baffles, thermal diode, inner sleeve, phase change
   material, etc, the heat loss was suppressed and then the energy storage
   was increased.},
