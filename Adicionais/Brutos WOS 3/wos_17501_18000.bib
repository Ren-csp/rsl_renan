Title = {Decision Delegation and Intelligent Agents in the Context of Human
   Resources Management: The Influence of Agency and Trust. A Research
   Proposal},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2022},
