@article{ WOS:000171323200015,
Author = {Wühr, P and Müsseler, J},
Title = {Time course of the blindness to response-compatible stimuli},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2001},
Volume = {27},
Number = {5},
Pages = {1260-1270},
Month = {OCT},
Note = {39th Annual Meeting of the Psychonomic-Society, DALLAS, TEXAS, NOV
   19-22, 1998},
Organization = {Psychon Soc},
Abstract = {This article examines the time course of a deficit in identifying a
   stimulus sharing a compatible feature with a response that is executed
   in parallel ({''}blindness to response-compatible stimuli,{''} J.
   Musseler \& B. Hommel, 1997a). In 5 experiments, participants performed
   a timed response, and the presentation point of time of a
   to-be-identified stimulus was varied in respect to response execution. A
   blindness effect was observed when the stimulus was presented between
   response cue offset and response execution. In contrast, the
   identification of a stimulus presented before the response cue or after
   response execution was not affected by stimulus-response compatibility-a
   finding that rules out a retention-based explanation. These results
   support an explanation that states that the perceptual processing of a
   stimulus feature is impaired as long as the shared perception-action
   feature code is integrated into the representation of a to-be-executed
   response.},
