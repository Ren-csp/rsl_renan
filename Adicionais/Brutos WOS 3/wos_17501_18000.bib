@article{ WOS:000245544500013,
Author = {Abdallah, J. M. and Mbilinyi, B. and Ngaga, Y. N. and Ok'ting'ati, Aku},
Title = {Impact of flue-cured Virginia on miombo woodland: a case of small-scale
   flue-cured Virginia production in iringa region, Tanzania},
Journal = {DISCOVERY AND INNOVATION},
Year = {2007},
Volume = {19},
Number = {SI},
Pages = {92-106},
Month = {JAN-FEB},
Note = {2nd International Workshop on Scientific Writing, Dar Salaam, TANZANIA,
   JUN, 2006},
Organization = {AAS; AFORNET},
Abstract = {Flue-cured virginia production is increasingly imperative
   socio-economically and as an export crop in Miombo woodlands, where over
   60\% of the crop is produced in Tanzania. Growth in output and areas
   under have been increasing. Albeit, some foreign direct investment by
   private companies, Production in Tanzania is dominated by small-scale
   subsistence farming highly dependent on inefficient curing technologies
   and forest resources as main inputs. However, evidences on the
   relationship between small-scale flue-cured virginia production and the
   Miombo woodlands are still lacking. Therefore, the objective of this
   study is to quantify the impact of the relationship between flue-cured
   tobacco production and Miombo woodland, and assessment of the
   socio-economic factors drives the impact associated with flue-cured
   tobacco production. Iringa District is the focus of this study. Pilot
   surveys established: typical Miombo woodlands with intensive small-scale
   flue-cured virginia growing villages, and sampling frames for household
   surveys Using questionnaire, participant observation and field
   measurement. Villages selected were Mgera, Kiwere, Mfyome, Kitapilimwa
   and Itagutwa. Aerial photos for the year 1959, 1978 and 1999 were
   interpreted. Change detection analysis and deforestation rate was
   computed. Results revealed that annual Miombo woodlands deforestation
   rate for the temporal year 1959 to 1978 was 319.03 ha/year (3.30\%, per
   year), while for 1978 and 1999 the deforestation rate was 26.59 ha/year
   (3.04\% per year). Comparing the deforestation rates for the temporal
   periods, the deforestation rate between 1959 and 1978 was higher
   compared to what observed between 1978 and 11999 The deforestation rate
   between 1959 and 1978 could be attributed to the high rate of increase
   on areas under Agriculture/Tobacco farms i.e. 178.95 ha/year.
   Deforestation was most likely Caused by tobacco growth structured by
   using firewood for tobacco and forest clear felling for obtaining new
   fertile plots. The regression factors for tobacco production show that
   output prices, cash loans received, amount of family labour possed by
   the household, level of education and availability of fertilizer were
   significant in explaining why people engage in tobacco production. The
   empirical results showed that acquiring new land from the woodlands
   significantly improve tobacco yield; therefore, households with tobacco
   growers and leaf dealers should be encouraged to conserve the miombo
   woodlands or they should increase tree planting effort and crop rotation
   system.},
