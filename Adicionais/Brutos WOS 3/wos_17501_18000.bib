Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Implementing Affective Considerations for Design Pattern Selection for
   Website Homepages},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 4, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {56},
Pages = {231-236},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {A large variety of design patterns is found in each design component per
   webpage that contribute toward the overall affective design of an
   interface. Usability tools are often used to measure the functionality
   of a design. Yet, dissatisfaction can persist, which could be caused by
   the users' emotions when perceiving the visual appearance of the
   interface they are interacting with. This paper attempts to amalgamate
   findings from empirical evidence and emotional ratings obtained from
   users as variables in the Non-Dominated Sorting Genetic Algorithm II
   (NSGA II) to develop a set of combined design patterns that fit the
   context of the website. This study explores methods of integrating
   ergonomics into web page design, given that the age of technology is
   transforming the world daily.},
