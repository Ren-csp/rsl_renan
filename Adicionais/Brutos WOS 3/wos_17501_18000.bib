@inproceedings{ WOS:000447721000051,
Author = {Pedro, Akeem and Pham Hai Chien and Park, Chan Sik},
Editor = {Bui, QB and Cajka, R and Tran, MT and Trinh, TA and Yasar, AUH and Wets, G and Woloszyn, M},
Title = {Towards a Competency-based Vision for Construction Safety Education},
