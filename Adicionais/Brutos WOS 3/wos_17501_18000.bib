@inproceedings{ WOS:000305209800017,
Author = {Kimura, M. and Kato, Y. and Seno, Y.},
Book-Group-Author = {MEDIMOND},
Title = {Can the image of a person on TV ``see{''} what is happening in front of
   the TV? -Young children's understanding of the representational nature
   of TV images-},
Booktitle = {15TH EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY},
Year = {2011},
Pages = {93-97},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {In this study we looked at whether or not 4 and 5 year old children
   believe the image of a person on television can ``see{''} what is
   happening in front of the television. Then for children who did believe
   so, we looked at whether they also believed that the real human being
   appearing in the video would, at the same time, obtain equal cognition
   of what they believed the image on the video was able to ``see.{''} The
   result showed that only 12 of 68 (17.6\%) children could correctly
   achieve both of these understandings and that other children more or
   less seemed to believe the image on the monitor could have the power of
   perception and/or to think perception could be transferred to the person
   whose image it was. On the basis of our data analysis, we categorized
   four possible types of understanding of TV images in the course of child
   development.},
