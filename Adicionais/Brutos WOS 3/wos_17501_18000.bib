@inproceedings{ WOS:000227339000032,
Author = {Carducci, A and Calamusa, A and Manfredi, P and Williams, JR and Romano,
   F and Verani, M and Privitera, G},
Book-Group-Author = {MEDIMOND},
Title = {Surveying the AIDS related risk behaviours of university students
   (Italy)},
Booktitle = {XV INTERNATIONAL AIDS CONFERENCE: EPIDEMIOLOGY AND PREVENTION},
Year = {2004},
Pages = {153-158},
Note = {15th International AIDS Conference, Bangkok, THAILAND, JUL 11-17, 2004},
Abstract = {Surveys of populations of university students may provide useful
   information on AIDS related lifestyles of the young population. A sample
   survey was carried out of the student population of the University of
   Pisa (Italy). The questionnaire included sections on lifestyles, sexual
   attitudes, self-perception of state of health, the use of public health
   services, and the more commonly used sources of information on health
   topics. The results show that, despite the majority of students having a
   broadly positive self-perception of her/his own health state, a rather
   high frequency of individuals declaring significant at risk behaviours
   also exists. For instance more than 40\% of students has declared having
   used drugs. Though most cases were related to soft drugs use, 5\%
   declared use of cocaine. Among sexually active students at the time of
   the survey, 12\% declared to have multiple or occasional relationships,
   and only 77\% declared use of condoms with occasional partners.},
Publisher = {MEDIMOND PUBLISHING CO},
