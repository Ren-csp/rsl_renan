@inproceedings{ WOS:000343412600019,
Author = {Hayward, Tim},
Editor = {Rozzi, R and Pickett, STA and Palmer, C and Armesto, JJ and Callicott, JB},
Title = {Ecology, Ethics and Global Justice},
Booktitle = {LINKING ECOLOGY AND ETHICS FOR A CHANGING WORLD: VALUES, PHILOSOPHY, AND
   ACTION},
