Month = {DEC},
Note = {Annual Meeting of the Southern-Management-Association, ATLANTA, GA, 2002},
Organization = {So Management Assoc},
Abstract = {The relationship between an organization's use of various career
   management practices and career attitudes was examined in a multisource,
   cross-level field study using organization-level data from 65 companies
   and individual-level data from 1,876 employees. A bundle approach was
   used to categorize 16 career management practices into clusters. As
   expected, the career management bundle associated with future strategic
   planning was positively related to satisfaction with the promotion
   process and negatively related to perceptions of job content plateauing.
   Consistent with research on strategic human resource management,
   significant interactions were found between some of the career
   management bundles in predicting satisfaction with the promotion
   process. A significant interaction was also found between the career
   management bundle of future strategic planning and sex, in terms of
   predicting satisfaction with the promotion process. Implications for
   theory and applied research are discussed.},
