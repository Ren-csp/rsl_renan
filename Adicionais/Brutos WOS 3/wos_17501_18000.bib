   Vrije Univ Amsterdam, Fac Human Movement Sci, Inst Fundamental \& Clin Human Movement Sci, NL-1081 BT Amsterdam, Netherlands.
   Manchester Metropolitan Univ, Ctr Biophys \& Clin Res Human Movement, Alsager, England.},
DOI = {10.1016/j.infbeh.2003.09.002},
