@article{ WOS:000454508700102,
Author = {Limueco, Jaypee M. and Prudente, Maricar S.},
Title = {Flipping Classroom to Improve Physics Teaching},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {11},
