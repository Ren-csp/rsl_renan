@inproceedings{ WOS:000227683000011,
Author = {Büchner, A and Frohne-Büchner, C and Battmer, RD and Lenarz, T},
Editor = {Miyamoto, RT},
Title = {Two years of experience using stimulation rates between 800 and 5000 pps
   with the clarion CII implant},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2004},
Volume = {1273},
Pages = {48-51},
Note = {8th International Cochlear Implant Conference, Indianapolis, IN, MAY
   10-13, 2004},
Organization = {NIDCD; Psi Iota Xi; Indiana Lions; St Joseph Inst Deaf; Indiana Univ
   Cochlear Implant Team},
Abstract = {The aim of our investigations with the Clarion CII device was to
   determine the effect of high stimulation rates on speech perception
   performance. On average, speech perception performance increased
   remarkably when changing from low-rate speech coding strategies to
   high-rate strategies. Performance increase is highly significant in
   noise (p < 0.01). However, a few patients only show a negligible effect
   and some patients even achieve worse speech understanding when using
   very high rates, i.e., 3000 pps/channel or higher. Interestingly, a weak
   correlation between the M-levels and the hearing performance could be
   found. Overall, these investigations suggest that the technology of high
   stimulation rates brings a benefit both when measured subjectively and
   when using tests of speech understanding, particularly those conducted
   in competing noise. However, a correlation between rate and performance
   could not be found in all subjects. (c) 2004 Elsevier B.V All rights
   reserved.},
