@inproceedings{ WOS:001119074200012,
Author = {Del Turco, Emilia Rosselli and Dalsgaard, Peter},
Book-Group-Author = {ACM},
Title = {``I wouldn't dare losing one{''}: How music artists capture and manage
   ideas},
Booktitle = {2023 PROCEEDINGS OF THE 15TH CONFERENCE ON CREATIVITY AND COGNITION,
   C\&C 2023},
Year = {2023},
Pages = {88-102},
Note = {15th Conference on Creativity and Cognition (C and C), ELECTR NETWORK,
   JUN 19-21, 2023},
Organization = {Assoc Comp Machinery; ACM SIGCHI},
Abstract = {Establishing, maintaining, and using collections of ideas and sources of
   inspiration is a common and important practice for music artists. Yet,
   it is underexplored in research. We therefore examine the research
   question of how do music artists capture and manage their ideas. To get
   an overview of the general patterns in the workflows of music artists,
   as well as in-depth understandings of these practices and the
   perceptions of music artists, our method combines qualitative surveys
   (n=51) with in-depth qualitative interviews (n=15). We find that a set
   of values are foundational to idea management routines that originate in
   music artists' perceptions of what makes an idea ``good{''}. We also
   identify the different forms that musical ideas can take in idea
   collections, what drives their retrieval, characteristic development
   approaches, and different styles for collaborating on ideas. Finally, we
   discuss recommendations for the design of tools for supporting idea
   management in music.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Del Turco, ER (Corresponding Author), Ctr Digital Creat, Aarhus, Denmark.
   Del Turco, Emilia Rosselli; Dalsgaard, Peter, Ctr Digital Creat, Aarhus, Denmark.},
DOI = {10.1145/3591196.3593338},
ISBN = {979-8-4007-0180-1},
Keywords = {idea capture; idea management; creativity support tools; creativity;
   music; creative workflows},
Research-Areas = {Art; Computer Science; Psychology},
