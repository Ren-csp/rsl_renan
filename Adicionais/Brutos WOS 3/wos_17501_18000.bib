@inproceedings{ WOS:000291892400013,
Author = {Laemmel, Gregor and Rieser, Marcel and Nagel, Kai and Taubenboeck,
   Hannes and Strunz, Guenter and Goseberg, Nils and Schlurmann, Thorsten
   and Kluepfel, Hubert and Setiadi, Neysa and Birkmann, Joern},
