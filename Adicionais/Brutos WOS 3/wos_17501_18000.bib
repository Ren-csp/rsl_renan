
@inproceedings{ WOS:000222180700024,
Author = {Schwartz, JS},
Editor = {Clar, M and Carpenter, D and Gracie, J and Slate, L},
Title = {Use of a 2D hydrodynamic model for stream restoration design of
   high-flow habitat in low-gradient Midwest streams},
Booktitle = {PROTECTION AND RESTORATION OF URBAN AND RURAL STREAMS},
Year = {2004},
Pages = {242-251},
Note = {Symposium on Protection and Restoration of Urban and Rural Streams,
   Philadelphia, PA, JUN 23-25, 2003},
Organization = {Urban Water Resources Res Council, Urban Streams Comm; Waterways
   Council, River Restorat Comm; Amer Soc Civil Engineers, Environm \&
   Water Resources Inst},
Abstract = {River2D, a two-dimensional hydrodynamic model, was used to illustrate
   its potential as a restoration design tool for high-flow habitat in
   low-gradient Midwest streams. High-flow habitat consists of geomorphic
   features associated with specific hydraulic conditions during flooding.
   Habitat units include the high-velocity thalweg, and low-velocity
   lateral areas such as floodplain platforms, heavily vegetated margins,
   and morphologies that create hydraulic recirculation zones (HRZs). HRZs
   form by flow deflection at sharp bends and instream structures
   (deflection eddy), or result from abrupt expansion of the channel width
   (expansion eddy). Low-velocity habitat units, in particular HRZs, are
   important areas for fish refugia and should be incorporated into
   restoration designs. On a 3(rd) order, meandering stream in East-central
   Illinois, the River2D model successfully predicted HRZ locations at
   different channel morphologies and under varying flow stages. River2D
   was then used to demonstrate it's utility as a restoration design tool
   in a channelized straight reach by modeling the change in local
   hydraulics associated with two channel modifications. Design of these
   channel modifications was based on ecological criteria to create HRZs
   for fish refugia. They included a bank deflector with an adjacent pool
   laterally located in the bed, and a lateral expansion of the channel
   with an elevated floodplain platform. This modeling exercise provided an
   example of an ecologically-based approach for designing habitat
   structures, and emphasized the value of using a 2D hydrodynamic model in
   stream restoration designs, particularly for use in streams
   morphologically degraded by human land use practices.},
