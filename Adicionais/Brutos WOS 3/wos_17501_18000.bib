@article{ WOS:000221637400020,
Author = {Rózová, Z},
Title = {The effect of job orientation of inhabitants on the structure of lands},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2003},
Volume = {22},
Number = {2},
Pages = {213-221},
Note = {Scientific Conference on New Trends in Landscape Ecology, Piestany,
   SLOVAKIA, OCT 24-26, 2002},
Organization = {Int Assoc Landscape Ecol},
Abstract = {The settlement of rural type, formed by the given geographical features
   and society development, reflects a way of farming and the social
   pattern of population. In the middle and at the end of the 201 century
   social and political changed, which has resulted in different
   transformations bringing about a departure from the previous farming
   methods and changes in social relationships and culture in a wide sense
   of the term. A change in the use of lands, which is reflected in their
   structure and aesthetic appearance, is affected by the orientation of
   population in various areas. Job opportunities influence not only
   physical and psychical burden, but also a length of spare time which, in
   the form of different activities, can be devoted to land. A job in the
   area of services and business activities out of land exert a positive
   influence on the utilization and structure of land and its aesthetic
   form together with pensioners and unemployed people working on the land.
   However, jobs oriented to manufacture out of land and land-oriented
   business adversely affect the utilisation of lands. It can be concluded
   that the quality of dwelling is closely associated with job orientation.},
