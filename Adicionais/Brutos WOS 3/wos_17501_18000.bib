@article{ WOS:A1995TN06500008,
Author = {Juvonen, J and Murdock, TB},
Title = {Grade-level differences in the social value of effort: Implications for
   self-presentation tactics of early adolescents},
Journal = {CHILD DEVELOPMENT},
Year = {1995},
Volume = {66},
Number = {6},
