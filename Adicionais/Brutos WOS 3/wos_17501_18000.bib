@inproceedings{ WOS:000076658100094,
Author = {Al Mawed, S and Anderluh, F and Pirtosek, Z and Prevec, TS},
Editor = {Stalberg, EV and DeWeerd, AW and Zidar, J},
Title = {Somatosensory evoked potentials in patients with writer's cramp},
Booktitle = {9TH EUROPEAN CONGRESS OF CLINICAL NEUROPHYSIOLOGY},
Year = {1998},
Pages = {613-617},
Note = {9th European Congress of Clinical Neurophysiology (ECCN 98), LJUBLJANA,
   SLOVENIA, JUN 04-07, 1998},
Abstract = {Writer's cramp is a focal dystonia of hands. While writing or performing
   similar tasks spasmodic cramps in affected muscles appear. Although the
   disorder starts unilaterally, there are clinical signs that affection
   may be bilateral from the onset of the disease (Pirtosek 1995). Causes
   for writer's cramp and other dystonias are poorly understood. Probably
   the cortico-subcortico-cortical loop which connects cortical areas,
   basal ganglia, thalamus and supplementary motor area (SMA) is impaired.
   Tempel et al. (1993) found decreased blood flow and decreased activity
   in the region of SMA and primary somatosensory cortex.
   The prerolandic wave N30 and the P20/N30 complex of somatosensory evoked
   potentials (SEP) are believed to reflect the activity of the SMA.
   Amplitudes of the N30 wave are altered in extrapyramidal diseases. Most
   authors describe smaller amplitudes of the N30 wave in parkinsonism (De
   Mari et al, 1995, Rossini et al, 1995, Rossini et al, 1993, Cheron et
   al, 1994). whereas in dystonia larger (Reilly et al, 1992) and smaller
   (Mazzini et al, 1994, Grissom ct al, 1995) amplitudes were reported. In
   most studies electrical stimulation for evoking somatosensory potentials
   has been used. However, in patients with multiple sclerosis it was found
   that mechanical stimulation resulted in more abnormalities than
   electrical (Denislic and Prevec, 1987, Prevec, 1984, Prevec and
   Denislic. 1990).
   We studied the P20/N30 complex of SEP in a group of patients with
   writer's cramp in order to understand more about the mechanism of the
   disease. It was expected that (i) the P20/N30 complex in patients will
   differ from the potential in age-matched healthy volunteers: (ii) that
   amplitude of this complex will be comparable after stimulation of the
   affected and unaffected hand; and (iii) that mechanical SEPs will reveal
   more abnormalities.},
Publisher = {MEDIMOND S R L},
Address = {VIA MASERATI 5, 40128 BOLOGNA, 00000, ITALY},
Type = {Proceedings Paper},
Language = {English},
