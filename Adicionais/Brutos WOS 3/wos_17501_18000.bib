Title = {The effect of the concept of individual agency on the estimation of
   health among different age-cohorts},
Booktitle = {8TH INTERNATIONAL MULTIDISCIPLINARY RESEARCH CONFERENCE SOCIETY, HEALTH,
   WELFARE},
Series = {SHS Web of Conferences},
Year = {2022},
Volume = {131},
Note = {8th International Multidisciplinary Research Conference on Society,
   Health, Welfare, Riga Stradins Univ, Riga, LATVIA, MAR 24-26, 2021},
Abstract = {The understanding of determinants of health in health policy and health
   promotion has shifted from a traditional focus on lifestyle (nutrition,
   exercises, addiction), toward a richer multidimensional approach. This
   shift has been strongly influenced by a body of research in the human
   capabilities' approach, which emphasizes the role of person's agency,
   freedom, and opportunities. Using survey data on 18-52 years old
   Lithuanian representatives, this paper explores the relationship between
   personal agency and subjective health perception as well as how it
   varies depending on the age and post-materialistic values. Human agency
   refers to the capability of an individual to control personal destiny
   and make choices to fulfill goals set autonomously (A. Giddens). The
   results show that agency is important factor of subjective health
   perception in Lithuania. The fact that capabilities that measure agency
   are aligned with subjective health measures support the view of human
   development as an integral process.},
