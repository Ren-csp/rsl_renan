Title = {Emotional Health Monitoring as a Key Module within the NeuroPredict
   Platform},
Booktitle = {2024 12TH E-HEALTH AND BIOENGINEERING CONFERENCE, EHB 2024},
Series = {E-Health and Bioengineering Conference},
Year = {2024},
Pages = {210-213},
Note = {12th International Conference on e Health and Bioengineering, Iasi,
   ROMANIA, NOV 14-15, 2024},
Abstract = {Heightened anxiety, despair, and emotional instability are consequences
   of neurodegenerative diseases (NDD), which significantly impair
   cognitive and emotional functions. To enhance patient care and quality
   of life, early detection of emotional changes is essential. This paper
   introduces the Emotioninsight module, a real-time IoT-based emotional
   and cognitive health monitoring tool incorporated into the NeuroPredict
   platform. The module stores information from physiological sensors, like
   an electroencephalogram or pulse, along with interactive questionnaires
   measuring emotional reactivity and main emotions. According to
   preliminary research, combining different data sources offers thorough
   understanding of emotional states, which makes it easier to identify the
   onset of NDD and allows for tailored management. A new approach aims to
   enable comprehensive treatment plans for NDD-affected patients and
   improve emotional self-awareness.},
