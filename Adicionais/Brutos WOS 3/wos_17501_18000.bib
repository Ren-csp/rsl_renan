@article{ WOS:000262021000003,
Author = {Villejoubert, Gaelle and Almond, Louise and Alison, Laurence},
Title = {Interpreting Claims in Offender Profiles: The Role of Probability
   Phrases, Base-Rates and Perceived Dangerousness},
Journal = {APPLIED COGNITIVE PSYCHOLOGY},
Year = {2009},
Volume = {23},
Number = {1},
Pages = {36-54},
Month = {JAN},
Note = {Conference on Offender Profiling and Bad Character, Liverpool Univ,
   Liverpool, ENGLAND, APR, 2007},
Abstract = {Offender profilers use verbal and numerical probability expressions to
   convey uncertainty surrounding claims made about offender's
   characteristics. No previous research has examined how these expressions
   might affect the recipient's interpretation of the information. Seventy
   participants completed an online questionnaire and results showed a
   diverse range of interpretations of these uncertainty expressions.
   Moreover, characteristic base-rates and dangerousness affected the
   perceived likelihood of the profiling claim, such that increased
   base-rates and perceived dangerousness resulted in an increased
   perception of the claim being likely. Perceived likelihoods also
   depended on the framing of characteristics as well as the framing of the
   claim itself. Finally, where claims involved presenting a characteristic
   qualified by a low probability these claims were interpreted as more
   likely than not to be present. These findings have practical
   implications for profilers and more general theoretical implications for
   the Study of risk perception. Copyright (C) 2008 John Wiley \& Sons,
   Ltd.},
