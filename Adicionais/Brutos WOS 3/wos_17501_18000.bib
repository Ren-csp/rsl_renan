Title = {Study of land use/land cover dynamics through classification algorithms
   for Harangi catchment area, Karnataka State, INDIA},
Booktitle = {INTERNATIONAL CONFERENCE ON WATER RESOURCES, COASTAL AND OCEAN
   ENGINEERING (ICWRCOE'15)},
