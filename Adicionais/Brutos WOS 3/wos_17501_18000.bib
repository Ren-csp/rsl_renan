@inproceedings{ WOS:000291345800065,
Author = {Rostowska, T. and Lewandowska-Walter, A. and Jarmolowska, A.},
Editor = {Zukauskiene, R},
Title = {The influence of parental attitudes on coping with stress and aggressive
   behaviours among Polish and Lithuanian adolescents},
Booktitle = {XIV EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY (ECDP)},
Year = {2010},
Pages = {381-386},
Note = {14th European Conference on Developmental Psychology (ECDP), Mykolas
   Romeris Univ, Vilnius, LITHUANIA, AUG 18-22, 2009},
Abstract = {Children's developmental and socialising process takes place in a social
   environment, which has a strong influence on their behaviour. The most
   important element of this process is the family, including the mother
   and father - those closest to the child. The aim of the research was
   finding the answer to the following questions: 1. Is there a
   relationship between the perception of parental attitudes and the level
   of various forms of aggressive behaviour displayed by adolescents?; 2.
   Is there a relationship between the perception of parental attitudes and
   the ways of coping with stress in the studied groups?; 3. Are there
   intercultural (Poland vs. Lithuania) differences concerning the above
   variables and dependency patterns? The research consisted of a survey
   and questionnaire study of a group of 120 people from Poland and
   Lithuania, aged 18-19. A number of differences between adolescents from
   geographically close countries, sharing similar experiences and
   political changes, also affecting social life, has been indicated.},
