@inproceedings{ WOS:001594686300019,
Author = {Wang, Lulu and Yu, Ruifeng and Wang, Zhecheng},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Influence of Parent-Child Relationship on Middle-Aged and Elderly
   People's Misuse of Social Media},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 5, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {57},
Pages = {108-113},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {The misuse of social media among middle-aged and older adults can lead
   to negative consequences such as addiction and financial losses. This is
   a part of the misuse of social media. Parent-child relationship may
   affect the emotions and behaviors of middle-aged and older adults when
   using social media. This study, through a questionnaire survey, found
   that the frequency of negative interactions between parents and adult
   children is positively correlated with the degree of parents' reliance
   on social media. Additionally, the frequency of positive interactions
   and communication is associated with parents' impulsive consumption
   behaviors. Both factors also affect the willingness of parents to inform
