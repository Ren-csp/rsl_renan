@inproceedings{ WOS:000165838100041,
Author = {Ramírez-Ramírez, R and Calvo-Méndez, C and Avila-Rodríguez, M and
   Gutiérrez-Corona, JF},
Editor = {Raynal, JA and Nuckols, JR and Reyes, R and Ward, M},
Title = {Chromate resistance and reduction in a yeast strain isolated from
   industrial waste discharges.},
Booktitle = {ENVIRONMENTAL ENGINEERING AND HEALTH SCIENCES},
Year = {2000},
Pages = {437-445},
Note = {International Symposium on Environmental Engineering and Health
   Sciences: A Joint Effort for the XXIst Century, CHOLULA, MEXICO, OCT
   26-30, 1998},
Organization = {US DHHS, Agcy Tox Subst Dis Registry; NCI, Occupat Epidemiol Brach;
   NIEHS, Superfund Bas Res Program; Pan Amer Hlth Org; Univ Amer Puebla;
   World Meteorol Org},
Abstract = {Hexavalent chromium compounds are highly toxic and are considered as
   mutagens and carcinogens. These compounds are discharged frequently to
   the environment due to their widespread uses in industrial processes,
   leading to serious problems of metal pollution in both urban and
   industrial settings. Biological reduction of hexavalent chromium to
   trivalent species of the metal has been widelly documented in bacteria
   and represents a potential detoxification process that may be used in
   bioremediation efforts.
   In this work we describe the isolation and phenotypic properties of RR1,
   a yeast strain isolated from industrial wastes of the city of Leon,
   Gto., in central Mexico. Strain RR1 was characterized with regard to its
   resistance to hexavalent-chromium in defined growth medium as well as
   its ability to chemically reduce the metal. Our studies revealed that,
   as compared to laboratory strains of other yeasts such as Candida
   albicans, Saccharomyces cerevisiae and Yarrowia lipolytica, strain RR1
   was able to tolerate higher concentrations of hexavalent chromium. This
   tolerance correlated with the ability of strain RR1 to reduce the metal,
   since this strain showed a higher efficiency to convert hexavalent
   chromium to the trivalent species, as compared to the above mentioned
   yeasts. Cremate reduction occured both in intact cells as well as in
   crude cell-free extracts of strain RR1. The presence of NADH-dependent
   chromate reductase activity was detected in cytosolic and membranal
   fractions of the yeast. Some properties of the soluble enzyme are
   reported in this study.},
