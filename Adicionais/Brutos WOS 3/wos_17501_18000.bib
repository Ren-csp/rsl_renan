@article{ WOS:000172933300006,
Author = {Truxillo, DM and Bauer, TN and Sanchez, RJ},
Title = {Multiple dimensions of procedural justice: Longitudinal effects on
   selection system fairness and test-taking self-efficacy},
Journal = {INTERNATIONAL JOURNAL OF SELECTION AND ASSESSMENT},
Year = {2001},
Volume = {9},
Number = {4},
Pages = {336-349},
Month = {DEC},
Note = {14th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, ATLANTA, GEORGIA,
   APR-MAY -, 1999},
Organization = {Soc Ind \& Org Psychol},
Abstract = {To demonstrate the multidimensionality of test fairness, we examined the
   reactions of 246 police applicants to two consecutive selection tests
   (written and video-based) in terms of eight dimensions of fairness. As
   hypothesized, each test was seen as more fair in terms of certain
   dimensions. Furthermore, test fairness measured immediately after each
   test predicted perceptions of overall selection system fairness measured
   after candidates received their test results and after controlling for
   applicants' selection outcomes (i.e., whether they were eligible for
   further consideration in the selection process). Job-relatedness/content
   for the video-based test interacted with test score to affect
   test-taking self-efficacy. Our discussion focuses on the
   multidimensionality of test fairness, the contribution of these
   dimensions to overall selection system fairness, and the consideration
   of these dimensions in selection system design.},
