@inproceedings{ WOS:000227352000041,
Author = {Adewole, I and Jegede, A and Adesina, A and Bamgboye, A and Adejumo, P
   and Smart, P and Adegbola, M and Sankale, J and Kanki, P},
Book-Group-Author = {MEDIMOND},
Title = {Cultural context of mother to child transmission of HIV in the Yoruba
   society},
Booktitle = {XV INTERNATIONAL AIDS CONFERENCE: SOCIAL AND ECONOMICAL ISSUES},
Year = {2004},
Pages = {213-217},
Note = {15th International AIDS Conference, Bangkok, THAILAND, JUL 11-17, 2004},
Abstract = {Background: Culture as a way of life determines behaviour patterns and
   directs perception of life and this influences perception of HIV in
   Africa. This paper therefore examines certain cultural categories that
   may influence vertical transmission of HIV within the context of Yoruba
   culture.
   Methodology: A total of 973 interviews and 10 focus group discussions
   were conducted in Ibadan. Data were analyzed using the SPSS and open
   code system.
   Results: About thirty-two percent (31.8\%) of the respondents indicated
   that they would not discuss their status with their partners. Although
   data revealed that 92.7\% of the respondents would not have additional
   children should their spouse test positive for HIV. More than 60\%
   indicated that they would not cooperate sexually with them.
   Lessons learnt: Data suggested a need for in-depth understanding of
   existing social institutions for adequate prevention and control of HIV
   transmission in any given society.},
