@article{ WOS:000258309600006,
Author = {Valor-Segura, Inmaculada and Exposito, Francisca and Moya, Miguel},
Title = {Attribution of aggressor's behavior and advice to the victim in a case
   of domestic violence},
Journal = {REVISTA DE PSICOLOGIA SOCIAL},
Year = {2008},
Volume = {23},
Number = {2},
Pages = {171-180},
Month = {MAY},
Note = {10th Spanish Conference of Social Psychology, Cadiz, SPAIN, SEP 26-28,
   2007},
Abstract = {Some research has shown that high levels of economic dependeny in a
   woman predict the likelihood that she will be psychologically or
   physically abused by her partner. Accordingly, one aim of our research
   was to examine the role of economic dependence in the perception of
   gender violence and to verify whether attitudes about a violence
   situation can be affected by the observer's gender. Psychosocial
   research also confirms the presence of sexist beliefs in society that
   can be used to legitimize and to maintain this type of aggression. Thus,
   the second objective of our research was to analyze the relation between
   sexist attitude and the justification of domestic violence. The results
   show the influence of observer's gender and of victim's economic
   dependence, as well as the influence of sexist beliefs on reactions to
   domestic violence.},
