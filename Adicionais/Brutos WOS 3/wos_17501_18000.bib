@article{ WOS:000532976800007,
Author = {Brown, Andrew D. and Barrett, Judith E. S. and Bennett, Michael and
   Potgieter-Vermaak, Sanja},
Title = {An investigation into the use of < 38 μm fraction as a proxy for < 10 μm
   road dust particles},
Journal = {ENVIRONMENTAL GEOCHEMISTRY AND HEALTH},
Year = {2020},
Volume = {42},
Number = {4, SI},
Pages = {1117-1126},
Month = {APR},
Note = {34th SEGH International Conference, Livingstone, ZAMBIA, JUL, 2018},
Organization = {SEGH},
Abstract = {It is well documented that a large portion of urban particulate matters
   is derived from road dust. Isolating particles of RD which are small
   enough to be inhaled, however, is a difficult process. In this study, it
   is shown for the first time that the < 38 mu m fraction of road dust
   particles can be used as a proxy for road dust particles < 10 mu m in
   bioaccessibility studies. This study probed similarities between the <
   10 and < 38 mu m fractions of urban road dust to show that the larger of
   the two can be used for analysis for which larger sample masses are
   required, as is the case with in vitro analysis. Road dust, initially
   segregated to size < 38 mu m using sieves, was again size segregated to
   < 10 mu m using water deposition. Both the original < 38 mu m and the
   separated < 10 mu m fractions were then subject to single particle
   analysis by SEM-EDX and bulk analysis by ICP-OES for its elemental
   composition. Dissolution tests in artificial lysosomal fluid,
   representative of lung fluid, were carried out on both samples to
   determine \% bioaccessibility of selected potentially harmful elements
   and thus probe similarities/differences in in vitro behaviour between
   the two fractions. The separation technique achieved 94.3\% of particles
   < 10 mu m in terms of number of particles (the original sample contained
   90.4\% as determined by SEM-EDX). Acid-soluble metal concentration
   results indicated differences between the samples. However, when
   manipulated to negate the input of Si, SEM-EDX data showed general
   similarities in metal concentrations. Dissolution testing results
   indicated similar behaviour between the two samples in a simulated
   biological fluid.},
