@inproceedings{ WOS:000264979000034,
Author = {Liu, Chia-Ju and Ho, Ming Chung and Lin, Yuan-cherng and Chou, Chia-Yi
   and Liu, Bao-Yuan},
Book-Group-Author = {ISMBE},
Title = {What is 40 Hz frequency information of whole brain Phase-coupling ?},
Booktitle = {MBE 2008: ASIA -PACIFIC CONFERENCE ON MIND BRAIN AND EDUCATION},
Year = {2008},
Pages = {150-153},
Note = {Asia-Pacific Conference on Mind Brain and Education, Washington, DC, OCT
   25-27, 2008},
Organization = {Int Soc Mind, Brain \& Educ; SE Univ, Key Lab Child Dev \& Learning Sci;
   Thinktank - Handsbrain Educ; SE Univ State Key Lab Bioelect; Chinese Soc
   Biomed Elect},
Abstract = {In early researches, the synchronic oscillation Of the phase in nerve
   center was regarded as the nature of conscious awareness. Synchrony is
   determined not only by stimulation, but by a context vs. task co-relying
   form in. the cortical network, which results in transmissions of related
   information among neurons through their synchronized discharges. Our
   hypothesis is that the binding of exogenous sensory inputs may be undone
   to reset and re-establish a new one for new sensory inputs. To examine
   the thought, methods of phase synchrony, bi-spectral analysis, and
   timefrequency spectral analysis were adopted to analyze the brain-wave
   data recorded in our experiment on 34 random volunteers. A ``whole
   brain{''} phase coupling. at 40 Hz lasting for 400ms was observed during
   the synchronic comedown process, which is rather different from the
   results of 40-Hz microstates lasting for only 20 to 25ms in previous
   studies. The result of the present study shows that when the oscillation
   frequency in the right hemisphere comes near to 40 Hz as the one in the
   left hemisphere, co-oscillation is triggered in both hemispheres along
   with a strong 40Hz phase coupling to achieve recognition for the object
   with multiple features. The results suggest that people with higher
   music capacity and disposition may modulate resetting in both
   hemispheres through 40 Hz phase coupling in the process of concentrating
   and relaxing.},
