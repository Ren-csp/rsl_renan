Author = {Wernli, KJ and Ray, RM and Gao, DL and Thomas, DB and Checkoway, H},
Title = {Cancer among women textile workers in Shanghai, China: Overall incidence
   patterns, 1989-1998},
Journal = {AMERICAN JOURNAL OF INDUSTRIAL MEDICINE},
