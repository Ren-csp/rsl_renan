@article{ WOS:000454508700022,
Author = {Bawang, Ederson G. and Prudente, Maricar S.},
Title = {Students' Understanding of Physics Concepts, Attitude, Engagement, and
   Perceptions in a Flipped Classroom Environment},
Journal = {ADVANCED SCIENCE LETTERS},
