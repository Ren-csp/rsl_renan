@inproceedings{ WOS:000264182100092,
Author = {Zhou Yafei and Liu Mao and Zhang Dongli},
Editor = {Li, SC and Wang, YJ and An, Y and Sun, XY and Li, X},
Title = {Area-Wide Emergency Evacuation under Toxic Gas Leakage},
Booktitle = {PROGRESS IN SAFETY SCIENCE AND TECHNOLOGY, VOL VII, PTS A AND B},
Series = {PROGRESS IN SAFETY SCIENCE AND TECHNOLOGY SERIES},
Year = {2008},
Volume = {7},
Pages = {465-471},
Note = {International Symposium on Safety Science and Technology, Beijing,
   PEOPLES R CHINA, SEP 24-27, 2008},
Abstract = {The emergency toxic gas leakage accidents not only contaminate
   environment, destroy ecosystem, but also bring tremendous injury to the
   safety and health of workers or residents around a rather great area.
   When toxic gas leakage happens, it is critical to determine danger zone
   and select optimal evacuation paths accurately, adopt effective
   evacuation measures to evacuate People Out of danger zone safety and
   quickly, in order to minimum the loss of emergency leakage accidents. In
   this paper, we use ALOHA to calculate leeward distance corresponding to
   different equivalent concentration within any exposure time. The death
   zone, the severe harm zone, and the slight harm zone are displayed in
   GIS to determine evacuation scope.. We then select OREMS to simulate
   people evacuation in open space. Finally, we present a case study of
   Tianjian Olympic Centre Stadium that demonstrates the consequence
   analysis and emergency evacuation process under toxic gas leakage.},
