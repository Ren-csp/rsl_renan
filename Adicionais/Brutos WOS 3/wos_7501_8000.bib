@article{ WOS:000189078400009,
Author = {Kepner, WG and Semmens, DJ and Bassett, SD and Mouat, DA and Goodrich,
   DC},
Title = {Scenario analysis for the San Pedro River, analyzing hydrological
   consequences of a future environment},
