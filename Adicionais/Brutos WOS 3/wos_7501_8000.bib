@inproceedings{ WOS:000598379100004,
Author = {Braucher, Chiara and Giandomenici, Mattia},
Editor = {Farabollini, P and Lugeri, FR and Mugnano, S},
Title = {Risk Mitigation Through Local Building Knowledge: Turkish Van Region
   Case Study},
Booktitle = {EARTHQUAKE RISK PERCEPTION, COMMUNICATION AND MITIGATION STRATEGIES
   ACROSS EUROPE},
