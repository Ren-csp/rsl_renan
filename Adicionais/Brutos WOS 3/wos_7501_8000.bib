@inproceedings{ WOS:000237753600192,
Author = {Riga-Karandinos, A. N. and Saitanis, C. and Panagopoulos, G.},
Editor = {Lekkas, TD},
Title = {PGEs in roadside soils from Athens metropolitan area (Greece)},
Booktitle = {PROCEEDINGS OF THE 9TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE
   AND TECHNOLOGY, VOL A - ORAL PRESENTATIONS, PTS A AND B},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {A1247-A1255},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {Platinum (Pt) and Palladium (Pd) concentrations in topsoil samples,
   collected in 2003 at four types of sites (urban, highway, suburban and
   rural) of the greater region of Athens have been determined for the
   first time in Greece. The concentrations measured were as follows:
   (i) Urban: In the 3 stations of the central greenbelt of an urban street
   (lera Odos), Pt ranged from 34.0 to 216 mu g/Kg ((X) over bar = 93.5 +/-
   21.8) and Pd from 20.3 to 185 mu g/Kg ((X) over bar = 80.6 +/- 18. 1).
   (ii) Highway: In the 7 stations of the central greenbelt of the National
   highway AthensLamia, Pt ranged from 73.3 to 451.0 mu g/Kg, ((X) over bar
   = 150.5 +/- 16.8) and Pd from 25.4 to 236.0 mu g/Kg ((X) over bar =
   125.8 +/- 10.3).
   (iii) Suburban: In the 3 stations of the central greenbelt of a suburban
   (Philothei) street Pt ranged from 0.05 to 16.8 mu g/Kg 4.9 +/- 1.9) and
   Pd from 1.1 to 22.9 mu g/Kg ((X) over bar = 4.4 +/- 2.6) (iv) Rural: In
   the 5 stations across rural roads (Marathonas) Pt ranged from 0.05 to
   4.9 mu g/Kg ((X) over bar = 0.99 +/- 0.36) and Pd from 0.05 to 3.0 mu
   g/Kg ((X) over bar = 0.6 +/- 0.24.)
   The correlation coefficient between the above metals was very high
   (0.9102, p = 0.00), revealing the common source of those metals, namely
   the catalytic converters. The high concentrations of Pt and Pd in
   highway and urban topsoils, compared to those found in other countries,
   after only ten years from the beginning of the use of automobile
   catalytic converters in Greece, show the significance of those new
   pollutants. The heavy traffic in highways and in the streets of the
   downtown area, cause these high concentrations, while in suburban and
   rural sites the concentrations are very low.
   It has become evident that attrition of platinum group elements (PGEs)
   from the catalytic converters and its subsequent release into the
   environment and deposition on roadsides and soils could be creating an
   unintended environmental problem, through their accumulation in soils,
   plants and water. Probably the concentrations of these noble metals in
   urban air are still too low to create a significant health risk, but
   there is a risk for the future, not only for the people but also to
   other organisms across food chains, since pre-concentration and
   bioaccumulation may ultimately lead to biomagnification.
   Other traffic-derived trace elements (Pb, Zn, Cu, and Mn) were also
   analyzed, to compare the different sites pollution and to determine
   their correlation to the analyzed PGEs.
   Considering that catalytic converters have been mandatory in Greece
   since 1993, though the use of non catalytic cars is still permitted, the
   accumulation rate in topsoils has reached high values both for Pd and Pt
   in Athens streets and highways. This first in Greece study on
   traffic-derived PGEs deposition on topsoils can be used as a reference
   for further studies aiming to monitor PGEs pollution in different areas
   of Greece.},
Publisher = {UNIV AEGEAN},
Address = {VOULGAROKTONOU 30, ATHENS 114 72, GREECE},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Riga-Karandinos, AN (Corresponding Author), Agr Univ Athens, Lab Ecol Environm Sci, Iera Odos Str 75, Athens 11855, Greece.
   Agr Univ Athens, Lab Ecol Environm Sci, Athens 11855, Greece.},
