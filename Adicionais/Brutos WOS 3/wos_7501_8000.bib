@inproceedings{ WOS:000234955700027,
Author = {Gaspar, J and Tavares, A and Azevedo, J},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Environmental and hazard perception: a case study of a periurban area of
   Central Portugal},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2005},
Volume = {84},
