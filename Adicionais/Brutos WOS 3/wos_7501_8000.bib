Title = {Flood risk consideration:: a new paradigm?: Urban examples in the middle
   valley of the Loire River (France)},
Booktitle = {FLOOD RECOVERY, INNOVATION AND RESPONSE},
Series = {WIT Transactions on Ecology and the Environment},
