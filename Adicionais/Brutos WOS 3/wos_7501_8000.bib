@article{ WOS:A1996VH54200009,
Author = {Kyle, DJ and Mahler, HIM},
Title = {The effects of hair color and cosmetic use on perceptions of a female's
   ability},
Journal = {PSYCHOLOGY OF WOMEN QUARTERLY},
Year = {1996},
Volume = {20},
Number = {3},
Pages = {447-455},
Month = {SEP},
Note = {73rd Annual Meeting of the Western-Psychological-Association, KONA, HI,
   APR 28-MAY 01, 1994},
Organization = {W Psychol Assoc},
Abstract = {This experiment examined whether a female applicant's hair color and use
   of cosmetics might affect perceptions of her ability for a professional
   position. One hundred thirty six college students reviewed the identical
   professional resume of a female applicant for the position of a staff
   accountant. Attached to the resume was a photograph of the stimulus
   female applicant either wearing or not wearing cosmetics and depicted
   with brunette, red, or blonde hair color. The results demonstrated
   significant main effects of both hair color and cosmetic use.
   Specifically, the applicant was rated more capable and was assigned a
   higher salary both when depicted with brunette hair color and when
   depicted without cosmetics. There were no interactions between hair
   color and cosmetic use. The findings demonstrate that biases regarding
   personal appearance may affect judgments about a female applicant's
   ability.},
