Year = {2017},
Volume = {23},
Number = {10},
Pages = {10236-10240},
Month = {OCT},
Note = {2nd International Conference on Advanced Science and Information
   Technology (ASCIT), Cheonan, SOUTH KOREA, MAY 12-13, 2017},
Abstract = {Speech and facial expression are the outward physical expressions that
   hold the closest resemblance to human emotions even though they are
   forced to pose or act spontaneously. Lip reading is a visual technique
   which people may use to relay the human emotion. This paper presents
   reviews of methods and the results obtained by past researchers in both
   speech and facial expression recognition. Based on this review, a
   suitable classifier will be used in the recognition system and applied
   to a Human-Computer Interaction (HCI) application. Adaptive Neuro-Fuzzy
   Inference System (ANFIS) which is a hybrid model can be developed for a
   dual-modal emotional expression recognition methodology in a real time
   situation. Besides that, Support Vector Machine (SVM) could be a
   potential classifier to be fused with ANFIS for better recognition rate.},
