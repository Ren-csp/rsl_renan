@inproceedings{ WOS:000272064000279,
Author = {Edirippulige, Sisira and Marasinghe, Rohana B. and Smith, Anthony C. and
   Fujisawa, Yoshikazu and Herath, Walisundara B. and Jiffry, M. T. M. and
   Wootton, Richard},
Editor = {Kuhn, KA and Warren, JR and Leong, TY},
Title = {Medical Students' Knowledge and Perceptions of e-Health: Results of a
   Study in Sri Lanka},
Booktitle = {MEDINFO 2007: PROCEEDINGS OF THE 12TH WORLD CONGRESS ON HEALTH (MEDICAL)
   INFORMATICS, PTS 1 AND 2: BUILDING SUSTAINABLE HEALTH SYSTEMS},
