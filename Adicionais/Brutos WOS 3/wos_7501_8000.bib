@inproceedings{ WOS:000072400000063,
Author = {Pelliccioni, A and Pessa, E},
Editor = {Power, H and Tirabassi, T and Brebbia, CA},
Title = {Methodological considerations on use of perceptron model to forecast CO
   and NO2 concentrations in urban area},
Booktitle = {AIR POLLUTION V},
Year = {1997},
Pages = {667-675},
Note = {5th International Conference on Air Pollution - Modelling, Monitoring
   and Management (AIR POLLUTION V), BOLOGNA, ITALY, SEP 16-18, 1997},
Organization = {Wessex Inst Technol, Southampton; CNR, Ist Studio Fenomeni Fis \& Chim
   Bassa Alta Atmosfera, Bologna},
Abstract = {A 3-layer Perceptron Neural Network (NN) with Error Backpropagation
   (EBP) learning rule has been used to forecast the concentration levels
   of CO and NO2 in the urban center of Rome.
   A comparison was made between forecasting performances corresponding to
   different training sets and to different activation functions.
   A first set of simulations has been designed to forecast CO levels using
   data taken 1 hour before. A second set of simulations has been done to
   forecast the NO2 levels using data taken 12/24 hours before.
   The NN's performance so far observed appears to be very good, mainly if
   compared with the one that can be obtained in this center by parametric
   models.
   However, this performance is not simply due to the use of NNs, but
   mainly to a right choice of their parameters.},
