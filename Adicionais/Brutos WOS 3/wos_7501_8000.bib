@inproceedings{ WOS:001582875600063,
Author = {Oh, Chang-Geun and Kim, Kyu Wang},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Evaluation of Pilots' Perception While Using Past, Current, and Emerging
   Aircraft Taxiing Support Technologies},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 1, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {39},
Pages = {409-415},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {This study assessed the pilot performance in the human-in-the-loop
   (HITL) simulation environment with three conditions - the past paper
   charts, the current electronic 2D maps on the iPad Foreflight app, and
   the emerging augmented graphics of routing visualized on the windshield.
   The experimenter asked three groups of pilots to conduct taxiing
   operations using a medium-fidelity flight simulator in the three
   conditions. As a mock air traffic controller provided the participants
   with the simulated taxiing instructions in the airport, participants
   were asked to mark their current spatial positions on the paper chart to
   evaluate the situation awareness level. Participants rated their
   subjective perception of how they identified meaningful spatial objects,
   other aircraft on taxiing operations, the current spatial position, how
   they recognized the next taxiing procedures, and how they stayed focused
   on the ATC's taxiing instructions. The results reveal that the
   participants felt that referring to the Foreflight and the augmented
   graphics was better than referring to paper charts. Based on the study
   implications, a combined interface of augmented routing lines on the
   airport chart and augmented realitybased egocentric windshield graphics
   could be a good solution to maximize taxi performance regardless of
   weather conditions.},
