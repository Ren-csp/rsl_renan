@inproceedings{ WOS:000288622300150,
Author = {Ozyaral, Oguz and Cubukcu, Abdullah and Kaya, Ertugrul},
Book-Group-Author = {SGEM},
Title = {PERCEPTION OF ENVIRONMENTAL HEALTH AND SOCIAL RESPONSIBILITY EDUCATION
   BY UNIVERSITY STUDENTS},
Booktitle = {10TH INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC GEOCONFERENCE: SGEM
   2010, VOL II},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2010},
