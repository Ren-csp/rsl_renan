Title = {Evaluating Tactile Interactions with Fine Textures Obtained with
   Femtosecond Laser Surface Texturing},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
