@inproceedings{ WOS:000391447900004,
Author = {Li, Guoqing and Zhai, Xiaojuan and Li, Yang and Feng, Bo and Wang,
   Zhenhao and Zhang, Mingjiang},
Editor = {Yan, J and Wennersten, R and Chen, B and Yang, J and Lv, Y and Sun, Q},
Title = {Multi-objective optimization operation considering environment benefits
   and economy based on ant colony optimization for isolated micro-grids},
Booktitle = {CLEAN ENERGY FOR CLEAN CITY: CUE 2016 - APPLIED ENERGY SYMPOSIUM AND
   FORUM: LOW-CARBON CITIES AND URBAN ENERGY SYSTEMS},
Series = {Energy Procedia},
Year = {2016},
Volume = {104},
Pages = {21-26},
Note = {Applied Energy Symposium and Summit - Low-Carbon Cities and Urban Energy
   Systems (CUE), Jinan Assoc Sci \& Technol, Jinan, PEOPLES R CHINA, JUN
   13-15, 2016},
Organization = {Int Journal Appl Energy; Appl Energy Innovat Inst; China Assoc Sci \&
   Technol HOME Program; Malardalen Univ, Future Energy Profile},
Abstract = {A new multi-objective optimization model considering environment
   benefits and economy is proposed for isolated micro-grids based on ant
   colony optimization in this paper. First, through fuzzy processing and
   satisfaction-maximizing scheme, the multi-objective programming problem
   is reformulated into a nonlinear mono-objective programming problem.
   Then, to cope with the uncertainty of photovoltaic and wind power
   generation, the sequence operation theory is introduced to transform
   such a chance-constrained programming problem into a corresponding
   deterministic equivalent problem. Next, an improved ant colony algorithm
   is used to solve the mono-objective mixed-integer linear programming
   problem. And finally, the test results demonstrate the effectiveness of
   the proposed model and algorithm. (C) 2016 The Authors. Published by
   Elsevier Ltd.},
