Title = {Contribution to atmospheric benzene concentrations of the petrol
   stations in a mid-sized city},
Booktitle = {MANAGEMENT OF NATURAL RESOURCES, SUSTAINABLE DEVELOPMENT AND ECOLOGICAL
   HAZARDS II},
