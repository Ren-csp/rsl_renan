Title = {An Urban Based Smart IOT Farming System},
Booktitle = {INTERNATIONAL CONFERENCE ON SUSTAINABLE ENERGY AND GREEN TECHNOLOGY 2018},
Series = {IOP Conference Series-Earth and Environmental Science},
