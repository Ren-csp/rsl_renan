@article{ WOS:000185290700003,
Author = {Hemenover, SH},
Title = {The good, the bad, and the healthy: Impacts of emotional disclosure of
   trauma on resilient self-concept and psychological distress},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {2003},
Volume = {29},
Number = {10},
Pages = {1236-1244},
Month = {OCT},
Note = {Meeting of the Society-for-Personality-and-Social-Psychology, SAVANNAH,
   GEORGIA, FEB, 2002},
Organization = {Soc Personality Soc Psychol},
Abstract = {This study examined the impact of disclosing traumas on resilient
   self-perceptions and psychological distress. Participants (N = 50) wrote
   about a traumatic life event or their plans for the next day and
   completed measures of resilience and distress before disclosing
   (pretest) and 3 months later (posttest). Results revealed that trauma
   participants increased in positive self-perceptions (mastery, personal
   growth, self-acceptance) and decreased in distress (depression,
   interpersonal sensitivity, anxiety, somatization) from pretest to
   posttest. Control participants showed no changes except for autonomy, on
   which they decreased. Results suggest that in addition to reducing
   psychological distress, disclosing traumas change self-perception,
   resulting in a more resilient self-concept.},
