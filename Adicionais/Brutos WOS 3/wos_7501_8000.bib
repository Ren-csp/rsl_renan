@article{ WOS:000084254600005,
Author = {Smets, P},
Title = {Housing finance trapped in a dilemma of perceptions: Affordability
   criteria for the urban poor in India questioned},
Journal = {HOUSING STUDIES},
Year = {1999},
Volume = {14},
Number = {6},
Pages = {821-838},
Month = {NOV},
Note = {Conference on Geography in a changing Society - Critical choices for
   change in Southern Africa, UNIV DURBAN-WESTVILLE, DURBAN, SOUTH AFRICA,
   JUL 10-14, 1995},
Organization = {Univ Durban Westville},
Abstract = {This paper demonstrates how formal housing finance is the product of the
   perceptions that prevail among the middle and tipper classes, who as
   policy-makers, economists and managers, determine how housing finance
   institutions fix the terms and conditions of housing loans for the urban
   poor. They use affordability criteria that fit the purchase or
   construction of a house in one go. However, affordability criteria for
   the urban poor have to be linked with practices of incremental building
   and consequently incremental financing. Failing to do so leads to
   serious mismatches between the demand and supply of formal housing
   finance for the urban poor. To be able to serve the poor adequately, the
   middle and upper classes should stop aiming at the financing of housing
   constructed in one go. Instead, they should open their minds to the
   building and financing practices of the urban poor.},
