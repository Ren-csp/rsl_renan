@article{ WOS:A1996VE05700018,
Author = {Tsai, SY and Chen, JD},
Title = {Neurobehavioral effects of occupational exposure to low-level styrene},
Journal = {NEUROTOXICOLOGY AND TERATOLOGY},
Year = {1996},
