   McMaster Univ, Sch Geog \& Geol, Hamilton, ON, Canada.
   Univ British Columbia, Dept Anthropol \& Sociol, Vancouver, BC V5Z 1M9, Canada.},
DOI = {10.1016/j.healthplace.2004.04.003},
