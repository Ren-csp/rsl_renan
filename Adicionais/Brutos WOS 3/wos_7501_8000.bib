@inproceedings{ WOS:001672900200056,
Author = {Sierra, Jaime Cevallos and Gomes, Ricardo and Silval, Carlos Santos},
Editor = {Ferreira, P and Dall'Orsoletta, A and Jorio, M and Santos, AL},
Title = {EVALUATING RETROFIT MEASURES TO ACHIEVE THE ENERGY GOALS OF GUIMARAES},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2024},
Pages = {386-392},
Note = {2024 International Conference on Energy and Environment-ICEE-Bringing
   together Engineering and Economics, Guimaraes, PORTUGAL, JUN 06-07, 2024},
Abstract = {The commitment of the European Union towards sustainable development
   goals has encouraged the inhabitants of Guimaraes to endeavour
   strategies to allow the efficient use of energy. Given that the urban
   districts are among the biggest consumers of energy resources, is then
   of great importance to design techniques that allow the reduction of
   energy demand and greenhouse gases. For this purpose, the present study
   has evaluated the potential technical, economic, and environmental
   benefits of implementing different renovation methods to maximize the
   use of energy products from buildings in the cities of Portugal. The
   study proposes the bottom-up methodology using Urban Building Energy
   Models to have the highest level of information possible about each
   construction, where different passive and active measures were analysed
   and compared with the initial state of the proposed case study. The
   district selected for the study included a neighbourhood composed of 80
   buildings used for different purposes, such as residential, commercial,
   and public services. Results of the analysis have shown that with the
   application of passive retrofit measures the study case can achieve the
   desired goals requiring the lowest return on investment.},
