Title = {Perceptions and use of Injectables in India: Experience with DMPA in
   three urban clinics in Uttar Pradesh},
Booktitle = {SEXUAL AND REPRODUCTIVE HEALTH, VOL II: RECENT ADVANCES, FUTURE
   DIRECTIONS},
