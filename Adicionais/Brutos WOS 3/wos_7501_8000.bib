@article{ WOS:000430814700052,
Author = {Fios, Frederikus and Manurung, Catarina and Peter, Ramot},
Title = {Multicultural Education as A Must in Indonesia (A Hermeneutic Analysis
   to Bina Nusantara University Student's Perceptions Towards ASEAN
   Community)},
