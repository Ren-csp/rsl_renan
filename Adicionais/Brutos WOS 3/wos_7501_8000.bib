Title = {URBAN SCENES CHANGE DETECTION BASED ON MULTI-SCALE IRREGULAR BAG OF
   VISUAL FEATURES FOR HIGH SPATIAL RESOLUTION IMAGERY},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
