Note = {1st International Conference on Supervision in Psychotherapy, Timisoara,
   ROMANIA, JUN 22, 2018},
Organization = {Univ Tibiscus, Ctr Qualitat Res Counselling \& Psychotherapy},
Abstract = {Adolescence is a stage of age burdened by changes, inner turmoil,
   anxiety, ambivalent emotions, in which the individual loses confidence
   in previous acquisitions, also doubts, searches, tends to react based on
   momentary reactions, hasty or with an apparent detachment or
   indifference. In teenagers' life, school stress and situational anxiety
   have important places, and that is why it raises the interest of
   researchers in the field of educational psychology. Thus, this paper
   presents a study of the impact of applying the written term paper
   stressor to Mathematics of the 10th grade students in the high school
   from Timis County, on a sample of 50 teenagers of both sexes, aged
   between 15 and 17 years old, with a multi-criteria batch.},
