@inproceedings{ WOS:000478560800022,
Author = {Astuti, Ani Budi and Solimun and Darmanto and Amaliana, Luthfatul and
   Fernandes, Adji Achmad Rinaldo and Nurjannah and Yanti, Indah and
   Isaskar, Riyanti},
Book-Group-Author = {IOP},
Title = {Biplot Analysis on Mapping of Coastal Object of South Traffic Line of
   Malang with Variable of Service Marketing Mix},
Booktitle = {12TH INTERNATIONAL INTERDISCIPLINARY STUDIES SEMINAR: ENVIRONMENTAL
   CONSERVATION AND EDUCATION FOR SUSTAINABLE DEVELOPMENT},
