Title = {Effect of urbanization activities towards the formation of urban heat
   island in Cameron Highlands, Malaysia},
Booktitle = {INTERNATIONAL CONFERENCE ON ENVIRONMENTAL RESOURCES MANAGEMENT IN GLOBAL
   REGION (ICERM 2017)},
