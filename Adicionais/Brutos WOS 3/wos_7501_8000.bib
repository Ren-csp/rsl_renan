@inproceedings{ WOS:000298388800021,
Author = {Sharma, Sundar Kumar},
Editor = {Balsiger, J and Debarbieux, B},
Title = {The political economy of climate change governance in the Himalayan
   region of Asia: a case study of Nepal},
Booktitle = {REGIONAL ENVIRONMENTAL GOVERNANCE: INTERDISCIPLINARY PERSPECTIVES,
   THEORETICAL ISSUES, COMPARATIVE DESIGNS (REGOV)},
