Year = {1998},
Pages = {449-451},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {In this exploratory study two models were tested. The first model was
   tested to determine whether previously found associations between one's
   role perceptions and work-related attitudes would be reproduced for a
   temporary employee's attitudes in relation to the client company where
   he or she was working. The second model examined the same relationships
   in relation to the temporary service employing the temporary employee.
   Path analytic analyses failed to fully support the model for the client
   company but did fully support the model for the temporary service.},
