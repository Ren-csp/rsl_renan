Year = {2019},
Pages = {59-63},
Note = {15th International Symposium on Occupational Safety and Hygiene (SHO),
   Univ Minho, Sch Engn, Guimaraes, PORTUGAL, APR 15-16, 2019},
Organization = {Univ Minho; Portuguese Soc Occupat Safety \& Hygiene; European Network
   Safety \& Hlth Profess Org; Int Social Secur Assoc; Latin Amer Assoc
   Work Safety Engn; Brazilian Soc Safety Engn; Brazilian Acad Safety Engn;
   Spanish Ergon Assoc; Spanish Assoc Occupat Safety \& Hlth Experts;
   Galician Soc Occupat Risk Prevent; Brazilian Assoc Civil Engineers;
