Title = {Urban trees felling and failures: preliminary results from an
   investigation on an urban green infrastructure - locating the most
   sensitive species and defining the causes},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
Volume = {1345},
