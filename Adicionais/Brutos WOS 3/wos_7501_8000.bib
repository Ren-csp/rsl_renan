Title = {Social housing for workers - A new housing model for Ho Chi Minh City,
   Vietnam},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON SUSTAINABLE DEVELOPMENT IN CIVIL, URBAN
   AND TRANSPORTATION ENGINEERING (CUTE 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
