@inproceedings{ WOS:000263668400042,
Author = {Suviniitty, Jaana},
Editor = {Welsch, F and Malpica, F and Tremante, A and Carrasquero, JV and Oropeza, A},
Title = {Good, Poor, or Excellent Students' Perception of Lecturers' English and
   Comprehension of Lectures},
Booktitle = {IMSCI `08: 2ND INTERNATIONAL MULTI-CONFERENCE ON SOCIETY, CYBERNETICS
   AND INFORMATICS, VOL IV, PROCEEDINGS, POST CONFERENCE ISSUE},
Year = {2008},
Pages = {187-190},
Note = {2nd International Multi-Conference on Society, Cybernetics and
   Informatics, Orlando, FL, JUN 29-JUL 02, 2008},
Organization = {Int Inst Informat \& System},
Abstract = {Master's programs held in English have become normal practice in most
   universities in Finland. When the possibility of an English program in
   the Forest Products Technology Department at Helsinki University of
   Technology (TKK) was discussed with the students, many of them were
   against such a change. Despite this negative reaction, all master's
   level courses at this department are now lectured in English, mostly by
   non-native speakers. In this paper I look at the students' perception of
   the master's program lecturers' English and whether this influences
   students' comprehension of these lectures. Twenty-two lectures were
   videoed and 212 feedback questionnaires were returned by the students
   after these lectures. Three lectures perceived most comprehensible and
   three perceived least comprehensible by the students were further
   analyzed for possible common features. The findings indicate that using
   ELFA (English as a Lingua Franca in Academic Settings) as lecturing
   language does not interfere with the comprehensibility of the lectures
   and that students evaluate the lecturers' English mostly as excellent or
   good. When the students' achieved course grades were compared in the old
   program versus the new one, no differences were found. All of these
   findings support the use of ELFA in TKK Forest Products Technology
   Department's master's program.},
Publisher = {INT INST INFORMATICS \& SYSTEMICS},
