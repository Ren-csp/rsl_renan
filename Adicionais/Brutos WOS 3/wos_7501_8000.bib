@inproceedings{ WOS:A1996BH14Q00053,
Author = {Foster, IDL and Charlesworth, SM and Proffitt, SB},
Editor = {Michaelis, W},
Title = {Sediment-associated heavy metal distribution in urban fluvial and limnic
   systems; A case of study of the River Sowe, UK},
Booktitle = {ADVANCES IN LIMNOLOGY 47: SUSPENDED PARTICULATE MATTER IN RIVERS AND
   ESTUARIES},
Series = {ERGEBNISSE DER LIMNOLOGIE},
Year = {1996},
Volume = {47},
Pages = {537-545},
Note = {International Symposium on Suspended Particulate Matter in Rivers and
   Estuaries, REINBEK, GERMANY, MAR 21-25, 1994},
Organization = {Hamburger Sparkasse; Dtsch Gesell Limnol e V; Elect Co Hamburg; GKSS
   Forschungszentrums Geesthacht e V, Verein Freunde \& Forderer; UNESCO},
Abstract = {Industrialisation and urban development in Midland England over the last
   150 to 200 years has given rise to the enhancement of heavy metal
   concentrations in catchment soils, lake, wetland and fluvial sediments.
   Surveys of heavy metal concentrations have provided information on the
   magnitude and sources of metal contamination. Calculation of the
   anthropogenic influx of metals suggests that urban lakes have received
   at least an order of magnitude greater atmospheric deposition than their
   rural counterparts. It is also shown for one of The research catchments
   that wetlands play an important regulatory function in limiting the
   influx of sediment-associated contaminants to open water bodies and to
   the downstream fluvial system. Within the urbanised River Sowe basin,
   analysis of the sub 63 mu m fraction of fluvial bed sediments has
   demonstrated the significance of urban storm drainage and industrial
   point source discharges in raising heavy metal levels significantly
   above background. There is little evidence to suggest, however, that
   this contamination extends great distances downstream of the main urban
   area either as a result of dilution by non-contaminated sediments or as
   a result of post-depositional stability of the fine sediments within the
   coarser gravels. Actively transported sediments were sampled in order to
   identify first, the relative proportion of sediment-associated and
   dissolved metals transported during storm runoff and, secondly, the
   influence of storm magnitude on metal concentrations. The data suggest
   that events of moderate magnitude and frequency are associated with
   higher sediment-associated metal concentrations than high magnitude
   events.},
Publisher = {E SCHWEIZERBART'SCHE VERLAGSBUCHHANDLUNG},
