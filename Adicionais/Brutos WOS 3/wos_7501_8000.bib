@article{ WOS:A1994NN06400066,
Author = {STRIEBEL, T and DAUB, J and HERRMANN, R},
Title = {A SAMPLING DEVICE FOR MEASURING PHYSICAL AND CHEMICAL CHARACTERISTICS OF
   URBAN STREET RUNOFF},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1994},
Volume = {147},
Pages = {515-523},
Month = {MAY 23},
Note = {4th International Symposium on Highway Pollution, MADRID, SPAIN, MAY
   18-22, 1992},
Abstract = {In order to characterise the environmentally relevant physical and
   chemical properties of urban street runoff, an automatic sampling device
   was developed which permits the recording of data (conductivity, runoff
   intensities) and sampling of the runoff during rain events with high
   temporal resolution. Precipitation samples were collected together with
   runoff samples. Organic and inorganic compounds (PAH, PCB, heavy metals,
   macro ions, suspended solids) were analysed in the runoff. It is the aim
   of this paper to describe the sampling device and explain its use.
   Results are only reported as examples. Therefore, analytical methods are
   not described here. Conductivity showed a typical temporal development;
   at the beginning of the event the values were at their maximum, then
   they decreased and reached their minimum values at times with highest
   runoff intensities. In most cases, a weak rise at the end of the event
   was observed. Other dissolved substances, e.g. dissolved copper, showed
   a similar pattern. Particle-bound heavy metals, as well as
   concentrations of PAH, correlated partially with concentrations of
   suspended solids.},
Publisher = {ELSEVIER SCIENCE BV},
