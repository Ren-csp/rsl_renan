@article{ WOS:A1996WG33800004,
Author = {Reeves, TG},
Title = {Status and strategic plans for fluoridation: Centers for disease control
   and prevention perspective},
Journal = {JOURNAL OF PUBLIC HEALTH DENTISTRY},
Year = {1996},
