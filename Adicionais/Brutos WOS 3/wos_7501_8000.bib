Pages = {197-212},
Note = {International Conference on Sexual and Reproductive Health, MUMBAI,
   INDIA, 1998},
Organization = {Indian Soc Stud Reproduct \& Fertil; UNDP; UNFPA; WHO; World Bank
   Special Programme Res, Dev \& Res Training Human Reproduct},
Abstract = {Product price is known to be a major factor affecting access, acceptance
   and continuation of a contraceptive method. In India
   depro-medroxyprogesterone acetate (DMPA) is not part of the methods
   supplied free of cost in the public sector, and has only been available
   in the commercial market since 1993. Awareness of the method is very low
   among the general population and there is very little information about
   its acceptability and continuation among users in India. This study was
   undertaken to understand the perceptions and use among clients who were
   provided DMPA at three different prices At three different clinics run
   by Parivar Seva Sanstha (PSS), in three cities of Uttar Pradesh from
   July 1996 to September 1997. There were 622 new DMPA acceptors during
   the study period. Client records at the three clinics were analyzed to
   determine differences in client characteristics, as well as knowledge of
   side-effects, reported side-effects, continuation rates, and perceptions
   of DMPA. A short market research study was conducted among a subset of
   acceptors who were willing for follow-up to assess purchase intent at
   the three prices. Of these, 176 women were currently using DMPA and 114
   were lapsed users. The study concluded that DMPA appeared to be an
   acceptable method when provided under conditions of good quality
   services provided by PSS. Initial use of DMPA appeared to be sensitive
   to price, while continuation was determined by a combination of factors.},
