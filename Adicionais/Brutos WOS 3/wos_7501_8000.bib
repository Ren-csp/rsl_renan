Title = {Residents' Perceived Impacts of LGBT Tourism: A Cluster Analysis},
Booktitle = {ADVANCES IN TOURISM, TECHNOLOGY AND SYSTEMS, VOL 1},
Series = {Smart Innovation Systems and Technologies},
Year = {2021},
Volume = {208},
Pages = {207-222},
Note = {International Conference on Tourism, Technology and Systems (ICOTTS),
   Cartagena, COLOMBIA, NOV 04-06, 2021},
Abstract = {The success of tourism depends on the quality of attractions and
   services, as well as the hospitality of residents. In the case of
   Lesbian, Gay, Bisex, Transgender (LGBT) tourism, the hospitality of the
   local community is fundamental and closely related to residents'
   perceptions of the impacts of such a type of tourism. A community with
   hostile behaviour towards tourists may constrain tourism development,
   while a friendly attitude may boost it. A clear understanding of the
   perception and reactions of the local communities and the factors that
   influence their attitudes is essential to a successful tourism
   development. Thus, the present study investigates the local community's
   perception of LGBT tourism and market in the Northern region of
   Portugal. A cluster analysis based on the findings of the local
   community surveyed on the impacts of LGBT tourism in the region
   separated residents into three clusters: Undecided, Enthusiasts and
   Sceptics. These converge in the rejection of negative impacts; however,
   opinions differ regarding the positive impacts and the investment in
   this tourism niche.},
