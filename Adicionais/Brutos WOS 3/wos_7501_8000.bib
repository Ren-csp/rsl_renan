@article{ WOS:000232707300009,
Author = {Middleton, DR and Davies, F},
Title = {Evaluation of dispersion model parameters by dual Doppler lidars over
   West London, England},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
