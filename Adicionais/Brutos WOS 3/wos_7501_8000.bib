@inproceedings{ WOS:000087441300013,
Author = {Mullens, JB and McNally, MB},
Editor = {Kyle, G},
Title = {Public perception of the Connecticut River's quality and suitability as
   a recreational resource},
Booktitle = {PROCEEDINGS OF THE 1999 NORTHEASTERN RECREATION RESEARCH SYMPOSIUM},
Year = {1999},
Pages = {78-81},
Note = {1999 Northeastern Recreation Research Symposium, BOLTON LANDING, NY, APR
   11-14, 1999},
Organization = {Mansfield Univ; Michigan State Univ; Penn State Univ; Sunny Coll
   Environm Sci \& Forestry; Univ Massachusetts; Univ New Hampshire; Univ
   Vermont; USDA, Forest Serv, NE Res Stn; Western Illinois Univ; Westfield
   State Coll; W Virginia Univ},
Abstract = {New England's Connecticut River is an important regional as well as
   national resource indicated by its recent Presidential designation as
   one of the first American Heritage Rivers. Once referred to as America's
   best landscaped sewer, the Connecticut's quality has improved
   dramatically over the last few decades. Improved conditions have
   resulted in an increased number of recreators using the resource. While
   the River is clearly of greater recreational value today, it is unclear
   whether the public believes the River's quality is safe for recreational
   activities which involve direct contact. This paper presents the results
   of a survey designed to assess the public's perceptions regarding the
   Connecticut's past and current river quality, and its suitability for
   supporting various recreational activities. The survey was administered
   to individuals along the Connecticut River in southern Vermont and New
   Hampshire. The results suggest that most individuals perceive this area
   of the Connecticut to be safe for primary contact activities.
   Additionally, it was found that the majority of individuals who have
   recreated on the River for 20 years or more have perceived a significant
   improvement in its overall quality.},
