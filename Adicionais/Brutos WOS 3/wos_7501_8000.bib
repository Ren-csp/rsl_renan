Author = {White, M and Härtel, CEJ and Panipucci, D},
Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {Understanding cross-cultural negotiation:: A model integrating affective
   events theory and communication accommodation theory},
Booktitle = {EMOTIONS IN ORGANIZATIONAL BEHAVIOR},
Year = {2005},
Pages = {167-182},
Note = {Conference on Emotions in Organizational Life, Bond Univ, Gold Coast,
   AUSTRALIA, JUN   03, 2002},
Abstract = {This chapter attempts to bridge the gaps of strategic business
   negotiation, communication, and emotion in a cross-cultural context. In
   particular, we argue that miscommunications are ``boundary-crossing
   mishaps,{''} which are affected by the negotiator's understanding of the
   respective cultures (and cultural backgrounds) of the parties,
   negotiation skill, cultural differences, emotional awareness and
   regulation, negative affect, and discrepancy in convergence-divergence
   between the interactants. This chapter concludes that when too many
   hassles or mishaps occur, negotiation breaks down and the need to
   understand cross-cultural communication through alternative theoretical
   models arises.},
