Author = {Friend, Adrian J. and Ayoko, Godwin A. and Jayaratne, E. Rohan and
   Jamriska, Milan and Hopke, Philip K. and Morawska, Lidia},
Title = {Source apportionment of ultrafine and fine particle concentrations in
   Brisbane, Australia},
Journal = {ENVIRONMENTAL SCIENCE AND POLLUTION RESEARCH},
Year = {2012},
Volume = {19},
Number = {7},
Pages = {2942-2950},
