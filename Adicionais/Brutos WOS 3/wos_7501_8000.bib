Organization = {Univ British Columbia; Environm Canada},
Abstract = {In this paper, we investigate the influence of the changing NOx-split in
   traffic emissions on the ambient NO2-concentrations. First of all, we
   show that the NOx-split is indeed changing, by looking at measurements
   in tunnels and at urban locations. Secondly, we analyze on a local scale
   the effect of this changing split. It is shown that the a large
   influence can be found. Finally, we discuss some of the consequences of
   these changes, for instance, on the effectiveness of the EU-legislation.},
