@inproceedings{ WOS:000693028200032,
Author = {Olczak, Andrzej and Kaczmarek, Jan M.},
Editor = {Paszkiel, S},
Title = {Modern Devices and Software Solutions as a Tool for Education on Local
   Biodiversity: A Case Study},
Booktitle = {CONTROL, COMPUTER ENGINEERING AND NEUROSCIENCE},
