@article{ WOS:000258365300011,
Author = {Atkinson, Roger and Arey, Janet and Aschmann, Sara M.},
Title = {Atmospheric chemistry of alkanes: Review and recent developments},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2008},
Volume = {42},
