Title = {ENVIRONMENTAL IMPACT REDUCING THROUGH LESS POLLUTION FROM CONSTRUCTION
   EQUIPMENTS},
Booktitle = {GEOCONFERENCE ON ECOLOGY, ECONOMICS, EDUCATION AND LEGISLATION, SGEM
   2013, VOL I},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {401-408},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {The construction is considered as one of the main sources of
   environmental pollution in the world; a construction process in building
   site presents almost whenever some negative impact on different
   components of environment. The submitted paper mentions that
   construction equipments applied in the sites, significantly contribute
   to urban air pollution. Several studies found that off-road vehicle
   engines emit as much nitrogen oxides (NOx), hydrocarbons (HC), carbon
   monoxide (CO), and particulate matter (PM) as highway vehicles. The
   construction sector should ever more adopt environmental aspects, thus
   all activities and processes carried out by the contractors must be
   revaluated in order to achieve this intention. The construction
   equipments manufacturers provide the solutions for environmental impact
   reduction through superior manufacturing technologies. The practitioners
   in construction companies must also contribute by integrating the
   environmental criteria into methods for selection of construction
   equipments for particular construction works in building sites or by
   optimisation of the equipments operation (e.g. by GPS machine control
   systems). In the paper are described the mitigation approaches (e.g.
   retrofit, cleaner fuels, alternative power systems, etc.) to perform the
   goal of environmental-friendly construction process performance in the
   construction sites from selection and application of ``green{''}
   construction equipments point of view.},
