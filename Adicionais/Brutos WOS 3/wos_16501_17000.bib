Title = {Factors influencing injury prevention in the home},
Booktitle = {READINGS IN INJURY PREVENTION AND CONTROL},
Year = {2000},
Pages = {150-152},
Note = {3rd National Conference on Injury Prevention and Control, BRISBANE,
   AUSTRALIA, MAY 09-12, 1999},
Organization = {Australian Injury Prevent Network; Conrod; Carrs; Qut; Univ Queensland;
   Queensland Inst Med Res; WAIC; Hlth \& Aged Care},
Abstract = {Many injuries in homes occur because hazardous conditions are not
   recognised. Recognition of the hazard and how much risk is involved is
   important in helping individuals understand how to minimise accidents
   and injuries. Two factors entering into overall risk perception are the
   probabilities of occurrence of accidents and of serious injury. The
   relative importance of the perceptions of likelihood of occurrence and
   of seriousness of injury were examined in connection with the
   probability of engaging in certain activities likely to produce
   accidents. The results suggested that estimated likelihood of occurrence
   may have more influence in reducing inappropriate behaviour with the
   types of hazardous situations presented to the 115 college student
   respondents. Some responses suggested respondents were not fully
   cognisant of the nature of some hazards.},
