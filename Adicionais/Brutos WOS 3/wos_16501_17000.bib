Title = {Analyzing the non-stationary space relationship of a city's degree of
   vegetation and social economic conditions in Shanghai, China using OLS
   and GWR models},
Booktitle = {REMOTE SENSING AND MODELING OF ECOSYSTEMS FOR SUSTAINABILITY X},
