Title = {A Novel Cascading Failure Model on City Transit Network},
Booktitle = {PROCEEDINGS OF THE 2016 6TH INTERNATIONAL CONFERENCE ON MACHINERY,
   MATERIALS, ENVIRONMENT, BIOTECHNOLOGY AND COMPUTER (MMEBC)},
