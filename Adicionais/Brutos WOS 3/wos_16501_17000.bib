@article{ WOS:000172056100009,
Author = {Thomas, KM and Drevets, WC and Dahl, RE and Ryan, ND and Birmaher, B and
   Eccard, CH and Axelson, D and Whalen, PJ and Casey, BJ},
Title = {Amygdala response to fearful faces in anxious and depressed children},
Journal = {ARCHIVES OF GENERAL PSYCHIATRY},
Year = {2001},
