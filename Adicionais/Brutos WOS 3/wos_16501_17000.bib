Title = {``Good death{''} - the circumstances in which it would be best for a
   person to die. The representative survey of Latvian population},
Booktitle = {8TH INTERNATIONAL MULTIDISCIPLINARY RESEARCH CONFERENCE SOCIETY, HEALTH,
   WELFARE},
