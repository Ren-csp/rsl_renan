@inproceedings{ WOS:000287160900277,
Author = {Chong, Ling Xuan and Teoh, Ai Ni},
Editor = {Hacifazlioglu, O and Halat, MM},
Title = {The manipulation of synchronous internet-based online social support in
   a laboratory setting},
Booktitle = {WCPCG 2010},
Series = {Procedia Social and Behavioral Sciences},
Year = {2010},
Volume = {5},
Pages = {1511-1515},
Note = {World Conference on Psychology, Counselling and Guidance (WCPCG 2010),
   Antalya, TURKEY, APR 22-25, 2010},
Abstract = {The present study aimed to manipulate Internet-based online social
   support (OS) in a laboratory setting and compare its effect with
   face-to-face social support (FS). Participants (N = 161) were randomly
   assigned to either alone, FS, or OS condition. Consistent with the
   hypotheses, alone participants perceived less social support than
   supported participants and experienced less positive emotions than those
   who received OS. For all the DVs, FS and OS did not differ from each
   other. The results ascertained the equivalent benefit of OS to FS. Most
   importantly, these findings highlighted successful manipulation of
   synchronous OS in a laboratory setting. (C) 2010 Elsevier Ltd. All
   rights reserved.},
