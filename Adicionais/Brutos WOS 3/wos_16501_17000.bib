@inproceedings{ WOS:000169198100004,
Author = {Rotherham, ID},
Editor = {Rotherham, ID},
Title = {Peat cutters and their landscapes: fundamental change in a fragile
   environment},
Booktitle = {PEATLAND ECOLOGY AND ARCHAEOLOGY: MANAGEMENT OF A CULTURAL LANDSCAPE},
Series = {LANDSCAPE ARCHAEOLOGY AND ECOLOGY},
Year = {1997},
Volume = {4},
Pages = {28-51},
Note = {Conference of the Landscape-Conservation-Forum, SHEFFIELD, ENGLAND, 1997},
Organization = {Sheffield Hallam Univ; Landscape Conservat Forum},
Abstract = {The cultural history of human exploitation of peatland landscapes is
   often neglected or misunderstood (Ardron er al., 1996 and 1997). This
   paper examines the fundamental impacts associated with the exploitation
   of these environments in the UK, providing the materials necessary for
   the day-to-day subsistence of local communities. The implications for
   contemporary management and conservation of upland areas are also
   considered.
   In particular, the impact of local fuel economy in upland environments,
   with the cutting of peat and turf, and associated drainage of vast areas
   of hill-side and hilltop, and similar treatment of upland, valley-bottom
   mires, has been a major force in shaping the present landscape
   (Rotherham, 1998). The impact of this exploitation has been further
   exacerbated, by the widespread practices of cutting ling and gorse, and
   gathering kindling and other materials, all for fuel.
   Along with the above, have been the widespread harvesting of both birch
   and bracken for a diversity of uses. Some of these relate again to fuel
   economy, others to the provision of building materials. Similarly, both
   turf and ling were widely used as cheap materials for the construction
   of buildings for people and for stock.
   These and other diverse uses occurred over many centuries, largely on a
   localised, domestic scale, but sometimes also on an industrial one
   (Ardron et al., 1995, 1996 and 1997). The effects on vegetation, on soil
   and on upland hydrology have been massive. However, in many cases, the
   implications of these changes in the environment are overlooked by
   contemporary researchers and managers.
   The main reasons appear to be two fold. First is the progressive
   cessation of many of these land-use practices, during the twentieth
   century, so that many workers are simply unaware that they may have
   occurred. Second, is the wholesale nature of some of the exploitation,
   to the extent that the evidence of an entire period of use has been
   largely removed from the landscape. In many lowland areas, subsequent
   intensive land-uses have obliterated almost all the evidence from the
   landscape.
   Case-studies from specific areas are presented, along with the results
   of a scoping exercise to evaluate potential impact across large areas of
   the UK uplands. Detailed impact on the ecology of upland environments is
   discussed elsewhere by Ardron and Rotherham.},
