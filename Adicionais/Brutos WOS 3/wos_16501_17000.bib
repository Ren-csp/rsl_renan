@article{ WOS:000077670200009,
Author = {Duckitt, J and Mphuthing, T},
Title = {Political power and race relations in South Africa: African attitudes
   before and after the transition},
Journal = {POLITICAL PSYCHOLOGY},
Year = {1998},
Volume = {19},
Number = {4},
Pages = {809-832},
Month = {DEC},
Note = {Group Dynamics Seminar, UNIV MICHIGAN, INST SOCIAL RES, ANN ARBOR,
   MICHIGAN, OCT   28, 1996},
Abstract = {When an oppressed majority finally gains political power what happens to
   its attitudes to its erstwhile oppressor, and to its perceptions and
   feelings about its socioeconomic disadvantages that were established
   during its oppression ? Longitudinal data from pre- and post-transition
   surveys of black South African college and high school students indicate
   marked reductions in perceptions of and outrage about intergroup
   socioeconomic inequity and deprivation relative to English-speaking and
   Afrikaans-speaking whites, but no change in attitudes toward these
   groups or toward whites in general. The findings are discussed in terms
   of contemporary theory and research on justice intergroup relations, and
   group conflict Some tentative implications for the prospects for a
   democratic political culture in South Africa are noted.},
