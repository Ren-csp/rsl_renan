@article{ WOS:000177744800011,
Author = {Morris, AL and Harris, CL},
Title = {Sentence context, word recognition, and repetition blindness},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-LEARNING MEMORY AND COGNITION},
Year = {2002},
Volume = {28},
Number = {5},
Pages = {962-982},
Month = {SEP},
Note = {40th Annual Meeting of the Psychonomic-Society, Los Angeles, CA, NOV,
   1999},
Organization = {Psychon Soc},
Abstract = {When the sentence She ran her best time yet in the rice last week is
   displayed using rapid serial visual presentation, viewers sometimes
   misread rice as race (M. C. Potter, A. Moryadas, I. Abrams, \& A. Noel,
   1993). Seven experiments. combined misreading and repetition blindness
   (RB) paradigms to determine whether misreading of a word because of
   biasing sentence context represents a genuine perceptual effect. In
   Experiments 1-4, misreading a word either caused or prevented RB for a
   downstream word, depending on whether orthographic similarity was
   increased or decreased. Additional experiments examined temporal
   parameters of misreading RB and tested the hypothesis that RB results
   from reconstructive memory processes. Results suggest that the effect of
   prior context occurs during perception.},
