Journal = {JOURNAL OF COUNSELING PSYCHOLOGY},
Year = {2003},
Volume = {50},
Number = {2},
Pages = {156-164},
Month = {APR},
Note = {109th Annual Convention of the American-Psychological-Association, SAN
   FRANCISCO, CA, AUG 24-28, 2001},
Organization = {Amer Psychol Assoc},
Abstract = {To explore the influence of theorized motivational properties of
   possible selves on participants' perceived likelihood of achieving their
   most hoped-for self and avoiding their most feared self, the authors
   surveyed 198 low-income rural women attending either adult basic
   education classes (DHS, n = 95) or community college developmental
   classes (DEV, n = 103), who provided demographic information and
   completed questionnaires about occupational possible selves and personal
   efficacy. Affect, knowing someone in a hoped-for occupation,
   self-initiated actions, and personal efficacy each accounted for
   significant variance in predicting the participants' perceptions of
   achieving their most hoped-for self None of the variables was predictive
   of participants' perceptions of avoiding their most feared self.
   Information about this population, implications for research, and career
   counseling are discussed.},
