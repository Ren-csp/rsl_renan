
@article{ WOS:000172392600008,
Author = {Content, A and Meunier, C and Kearns, RK and Frauenfelder, UH},
Title = {Sequence detection in pseudowords in French: Where is the syllable
   effect?},
Journal = {LANGUAGE AND COGNITIVE PROCESSES},
Year = {2001},
Volume = {16},
Number = {5-6},
Pages = {609-636},
