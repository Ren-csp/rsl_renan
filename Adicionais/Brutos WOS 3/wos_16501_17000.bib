Title = {Waste management in integrated waste management facility (TPST) of
   Piyungan to achieve climate resilience through local institutions},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON CLIMATE CHANGE 2019 (4TH ICCC 2019)},
