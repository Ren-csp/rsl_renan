Author = {Tasic, Visa and Apostolovski-Trujic, Tatjana and Kovacevic, Renata and
   Steharnik, Mirjana and Stankovic, Suzana},
Editor = {Varbanov, PS and Duic, N},
Title = {What is Air Quality Plan?},
Booktitle = {SDEWES: THE 8TH CONFERENCE ON SUSTAINABLE DEVELOPMENT OF ENERGY, WATER
   AND ENVIRONMENT SYSTEMS},
Series = {Chemical Engineering Transactions},
Year = {2014},
