@article{ WOS:000178076500005,
Author = {Johnstone, EC and Cosway, R and Lawrie, SM},
Title = {Distinguishing characteristics of subjects with good and poor early
   outcome in the Edinburgh High-Risk Study},
Journal = {BRITISH JOURNAL OF PSYCHIATRY},
Year = {2002},
Volume = {181},
Number = {43},
Pages = {S26-S29},
