Title = {Exploring the Dynamics of Affect and Cognitive Assessment in Trust and
   Reliance on Decision Support Systems in Healthcare},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 1, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {39},
Pages = {9-14},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {In the convergence of healthcare and technology, Decision Support
   Systems (DSS) hold promise for enhancing accessibility and efficiency,
   particularly in underserved regions like the Philippines. This study
   explores the impact of cognitive (perceived usefulness) and affective
   (emotional responses) components on trust and reliance in DSS among 219
   Filipino parents. Findings reveal that while cognitive factors foster
   trust, it is the affective dimension that primarily drives reliance.
   Moderating effects of trust disposition and technological anxiety were
   also examined, highlighting the importance of emotional engagement and
   clear communication. The results emphasize the need for user-centric DSS
   designs that evoke positive emotions and provide transparent information
   to build trust and reliance.},
