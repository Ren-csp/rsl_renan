@article{ WOS:A1995QU64900003,
Author = {DIENER, ML and GOLDSTEIN, LH and MANGELSDORF, SC},
Title = {THE ROLE OF PRENATAL EXPECTATIONS IN PARENTS REPORTS OF INFANT
   TEMPERAMENT},
Journal = {MERRILL-PALMER QUARTERLY-JOURNAL OF DEVELOPMENTAL PSYCHOLOGY},
Year = {1995},
Volume = {41},
Number = {2},
