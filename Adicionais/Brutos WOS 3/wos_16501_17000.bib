@inproceedings{ WOS:000080780600021,
Author = {Nicell, JA and Cornish, JL},
Editor = {Hickey, KL and Kantarelis, D},
Title = {The greening of aviation: Part II - The need for coordination},
Booktitle = {82541K0URAL ENVIRONMENT: CONCEPTS \& SOLUTIONS, PROCEEDINGS},
Year = {1996},
Pages = {231-241},
Note = {2nd International Interdisciplinary Conference on the Environment,
   NEWPORT, RI, JUN 15-19, 1996},
Organization = {Interdisciplinary Environm Assoc},
Abstract = {The aviation industry provides a quick and effective means for the
   transport of goods and people over long distances while contributing
   directly and indirectly to the employment of many thousands of
   individuals and making immeasurably large contributions to local
   economies through the development of service industries, manufacturing
   sectors and tourism. However, the aviation industry as a whole lacks a
   coordinated approach to solving common environmental problems. This is
   especially important given the global nature of air transport which
   requires a system for dealing with environmental issues on an
   international basis, rather than through individual efforts that result
   in inconsistent and sometimes incompatible changes in technologies,
   regulations, and policies. The main challenge to the aviation industry
   appears to be the coordination of efforts to find timely and
   cost-effective solutions to environmental problems. It is proposed that
   this coordination can be achieved through the creation of a centre which
   would act as a catalyst to promote research and development and
   information exchange among sectors of the aviation industry at regional,
   national and international levels. It is hoped that the Centre would
   create a synergetic relationship between government, business and
   academia for the resolution of environmental problems associated with
   aviation.},
