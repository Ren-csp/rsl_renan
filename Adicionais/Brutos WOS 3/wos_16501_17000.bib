@article{ WOS:000232111400003,
Author = {Chua, FK},
Title = {The effect of target contrast on the attentional blink},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2005},
Volume = {67},
Number = {5},
Pages = {770-788},
Month = {JUL},
Note = {24th European Conference on Visual Perception, KUSADASI, TURKEY, AUG
   26-30, 2001},
Abstract = {In this set of five rapid serial visual presentation experiments,
   observers identified one or two target letters that were embedded in a
   stream of distractors. Target contrasts were varied, and their effects
   on the attentional blink (AB) were examined. Target identification
   improved when its contrast was increased. But whereas an increase in the
   first target's (T I) contrast facilitated its identification, the
   recovery of the second target (T2) was paradoxically hampered
   (Experiments 2 and 5). Similarly, identification of the target suffered
   when the preceding singleton's contrast was increased (Experiment 1).
   The AB was eliminated by inserting a blank after a low-contrast, but not
   a high-contrast, T1 (Experiment 5). Increasing T2s contrast attenuated
   the blink (Experiment 3) and compensated the larger AB caused by a
   high-contrast T1 (Experiment 4). In all, these results showed that
   attention continued to be engaged as long as the target's contrast
   prolonged its perceptibility. When the high-contrast target was T1, a
   larger AB was produced; when it was T2, there was protection from
   substitution masking.},
Publisher = {PSYCHONOMIC SOC INC},
Address = {1710 FORTVIEW RD, AUSTIN, TX 78704 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Chua, FK (Corresponding Author), Natl Univ Singapore, Dept Psychol, Kent Ridge Crescent, Singapore 119260, Singapore.
   Natl Univ Singapore, Dept Psychol, Singapore 119260, Singapore.},
