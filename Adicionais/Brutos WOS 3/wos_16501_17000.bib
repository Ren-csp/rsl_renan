@article{ WOS:000237472400006,
Author = {Davis, Rebecca A. O. and Bockbrader, Marcia A. and Murphy, Robin R. and
   Hetrick, William P. and O'Donnell, Brian F.},
Title = {Subjective perceptual distortions and visual dysfunction in children
   with autism},
Journal = {JOURNAL OF AUTISM AND DEVELOPMENTAL DISORDERS},
Year = {2006},
Volume = {36},
Number = {2},
Pages = {199-210},
Month = {FEB},
Note = {Conference of the Society-of-Biological-Psychiatry, Philadelphia, PA,
   MAR, 2002},
Organization = {Soc Biolog Psychiatry},
Abstract = {Case reports and sensory inventories suggest that autism involves
   sensory processing anomalies. Behavioral tests indicate impaired motion
   and normal form perception in autism. The present study used
   first-person accounts to investigate perceptual anomalies and related
   subjective to psychophysical measures. Nine high-functioning children
   with autism and nine typically-developing children were given a
   questionnaire to assess the frequency of sensory anomalies, as well as
   psychophysical tests of visual perception. Results indicated that
   children with autism experience increased perceptual anomalies, deficits
   in trajectory discrimination consistent with dysfunction in the cortical
   dorsal pathway or in cerebellar midsagittal vermis, and high spatial
   frequency contrast impairments consistent with dysfunctional
   parvocellular processing. Subjective visual hypersensitivity was
   significantly related to greater deficits across vision tests.},
