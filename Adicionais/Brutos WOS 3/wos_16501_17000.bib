Pages = {383-385},
Note = {1st World Congress of the
   International-Society-of-Physical-and-Rehabilitation-Medicine (ISPRM I),
   AMSTERDAM, NETHERLANDS, JUL 07-13, 2001},
Organization = {Int Soc Phys \& Rehabilitat Med},
Abstract = {Prospective study of 50 consecutive patients who were about to undergo a
   total hip arthroplasty (THA). The aim of the present study was to assess
   perception of health in subjects with hip disease and to measure changes
   in perceived health in the same patients at 6 months after surgery. We
   also compared health perception between patients over 70 years and
   younger. Mean score of the SF-36 physical summary component was lower
   than that observed in the general population. At 6 months, a
   statistically significant improvement in the subscales of physical
   functioning, role limitations due to physical problems, body pain,
   vitality, social functioning and mental health was observed. Similar
   results were found when the sample was divided into two ages groups.},
