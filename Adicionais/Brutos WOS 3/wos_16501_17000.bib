@inproceedings{ WOS:001054845600018,
Author = {Offermann, Julia and Wilkowska, Wiktoria and Ziefle, Martina},
Book-Group-Author = {ACM},
Title = {Identifying User Preferences of Data Handling Using Assisting
   Technologies},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL CONFERENCE ON PERVASIVE
   TECHNOLOGIES RELATED TO ASSISTIVE ENVIRONMENTS, PETRA 2022},
Year = {2022},
Pages = {129-136},
Note = {15th ACM International Conference on Pervasive Technologies Related to
   Assistive Environments (PETRA), GREECE, JUN 29-JUL 01, 2022},
Organization = {Assoc Comp Machinery},
Abstract = {A huge variety of (assisting) lifelogging technologies can be used to
   track older people's movements and behaviors allowing for early
   identifications of emergency situations and health-related changes. So
   far, research focused on specific technologies and individual factors
   influencing the acceptance and perception of technology usage; instead,
   an investigation of people's generic acceptance and perception of
   collecting health-related data - being necessary for a successful
   analysis of person-related data - is missing. Hence, this study focused
   on a broad sample of adults (N=1106) and their acceptance of collecting
   health-related data to support everyday life in older age. Using an
   online survey, participants evaluated perceived benefits and barriers,
   their intention to collect health-related data, and a trade-off between
   the individual privacy and health. Moreover, results revealed that
   individual attitudes (i.e., technical self-efficacy, technology
   commitment, lifelogging experience) influence the evaluation patterns
   significantly, while demographic and health-related factors are not
   decisive. The results support the understanding of the influence of user
   characteristics within the acceptance and perception of collecting
   health-related data, and enable to inform diverse stakeholders (i.e.,
   policy, industry, academia) about user-specific requirements and needs
   in the context of health-related data collection.},
