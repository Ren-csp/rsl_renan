@article{ WOS:000169724800001,
Author = {Casterline, JB and Sathar, ZA and Haque, MU},
Title = {Obstacles to contraceptive use in Pakistan: A study in Punjab},
Journal = {STUDIES IN FAMILY PLANNING},
Year = {2001},
Volume = {32},
