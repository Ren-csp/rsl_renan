@article{ WOS:A1997XW68200053,
Author = {Paiva, P and Jouanneau, JM and Araujo, F and Weber, O and Rodrigues, A
   and Dias, JMA},
Title = {Elemental distribution in a sedimentary deposit on the shelf off the
   Tagus estuary (Portugal)},
