Year = {2008},
Pages = {128-131},
Note = {Asia-Pacific Conference on Mind Brain and Education, Washington, DC, OCT
   25-27, 2008},
Organization = {Int Soc Mind, Brain \& Educ; SE Univ, Key Lab Child Dev \& Learning Sci;
   Thinktank - Handsbrain Educ; SE Univ State Key Lab Bioelect; Chinese Soc
   Biomed Elect},
Abstract = {With NIRS, we investigated the relative changes of oxygenated and
   deoxygenated hemoglobin in Prefrontal Cortex (PFC) when depression
   individuals processing Chinese sentences. At first, we filtered 23
   depression individuals by using international standard SDS scale to be
   our participants. Then, the subjects were asked to read sentences in
   different emotions presented on the screen. Finally, we analyzed the
   relative changes of cortical hemodynamic in 16 channels. After
   eliminating invalid data, we analyzed the valid data. From the results
   we found (1) depression individuals were more sensitive to negative
   sentences than neutral sentences; (2) when depression individuals
   process emotional sentences, the activation of right hemisphere were
   greater than left hemisphere.},
