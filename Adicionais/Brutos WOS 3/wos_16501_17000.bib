Title = {New wine in an old bottle: Developing and implementing two environmental
   studies strands in an existing master's degree},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
