Year = {2008},
Pages = {365-368},
Note = {Asia-Pacific Conference on Mind Brain and Education, Washington, DC, OCT
   25-27, 2008},
Organization = {Int Soc Mind, Brain \& Educ; SE Univ, Key Lab Child Dev \& Learning Sci;
   Thinktank - Handsbrain Educ; SE Univ State Key Lab Bioelect; Chinese Soc
   Biomed Elect},
Abstract = {Facial expression is one of the most important ways for human to express
   their emotions. Automatic Facial Expression Recognition gives machines
   the ability to understand us human's expressions, and it is one of the
   most natural-interaction ways. So it is widely studied in many areas,
   such as Affective Computing, Computing Vision, Pattern Recognition and
   Image Processing.
   This paper will begin with how to classify human expressions, and then
   how to realize Automatic Facial Expression Recognition System.
   Algorithms used in the system can be split into four sections: Face
   Detection, Face Alignment, Feature Extraction and Expression
   Classification. Finally, this paper will discuss some research
   tendencies of this subject.},
