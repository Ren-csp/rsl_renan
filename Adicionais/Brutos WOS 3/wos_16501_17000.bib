@inproceedings{ WOS:000073875200046,
Author = {Van Haveren, BP},
Editor = {Haigh, MJ and Krecek, J and Rajwar, GS and Kilmartin, MP},
Title = {Human and institutional dimensions of sustainable headwater management},
Booktitle = {HEADWATERS: WATER RESOURCES AND SOIL CONSERVATION},
Year = {1998},
Pages = {451-459},
Note = {4th International Conference on Headwater Control, MERANO, ITALY, APR,
   1998},
Organization = {Int Assoc Headwater Control; World Assoc Soil \& Water Conservat; Int
   Union Forest Res Org; Int Assoc Hydrol Sci; European Acad, Bolzano},
Abstract = {The human dimension of headwater management has been largely overlooked.
   A hierarchy of social interactions occur between people and landscapes.
   Personal values, which reflect diverse individual perspectives, often
   give rise to strong emotions and conflicts over land uses. Existing
   institutions are more oriented to extractive land uses than holistic and
   sustainable environmental management. New kinds of institutions are
   needed to govern headwater areas. To be effective, institutions must be
   adaptive, flexible, and close to their constituencies. An institutional
   framework for sustainable headwater management is based on the public
   trust doctrine of property ownership, the concept of basin citizenship,
   and participatory decision making.},
