Editor = {Semedi, B},
Title = {Assessing coastal vulnerability index of tourism site: the case of
   Mataram Coast},
Booktitle = {INTERNATIONAL CONFERENCE ON SUSTAINABILITY SCIENCE AND MANAGEMENT:
   ADVANCED TECHNOLOGY IN ENVIRONMENTAL RESEARCH (CORECT-IJJSS 2019)},
Series = {E3S Web of Conferences},
Year = {2020},
