@inproceedings{ WOS:000305209800034,
Author = {Toda, S.},
Book-Group-Author = {MEDIMOND},
Title = {The Study of Mother's Child-rearing and Parental Role in Japan},
Booktitle = {15TH EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY},
Year = {2011},
Pages = {191-195},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {The present study is to explore mother's child-rearing style and
   self-perception of the parental role. Twenty-seven mother and infant
   dyads (M=16, F=11) participated in this longitudinal research project.
   The mother answered two kinds of questionnaires when her infant was 5
   and 20 months old. The one questionnaire consists of two types of
   child-rearing style: reality and ideal. The other questionnaire is
   self-perception of the parental role. The results show that mother
   provided her child with diverse social and interactive experiences with
   same-age peers at 5 months less than they did at 20 months(p<.001).
   Concerning the self-perception of the parental role, factor analysis was
   conducted. One factor, ``Being mother{''} was significant effect on sex.
   At 5 months the mothers of girls expressed more satisfaction than the
   mothers of boys (p<.05), but there was no significant at 20 months. The
   results illustrate that a considerable gap exists between ideal image of
   motherhood and the reality that most women face, suggesting that mothers
   feel overwhelmed by their child-care role and perhaps wish to be aided
   by a secondary caretaker, a father to assist both physically and
   psychologically.},
