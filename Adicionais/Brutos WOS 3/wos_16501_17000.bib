@article{ WOS:A1996UH93300015,
Author = {He, DY and Huang, MY},
Title = {A numerical study on tropospheric ozone over China},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1996},
Volume = {30},
Number = {13},
Pages = {2449-2451},
Month = {JUL},
Note = {4th International Conference on Atmospheric Science and Applications to
   Air Quality, SEOUL, SOUTH KOREA, MAY 30-JUN 02, 1994},
Abstract = {A three-dimensional Eulerian model for regional tropospheric ozone
   simulation was developed. It includes transport, photochemical
   reactions, effects of cloud on ozone, pollutant emissions and
   depositions. Considering the factors that affect ozone photochemical
   transformation and some typical characteristics of air photochemical
   pollution in China, ozone photochemical transformation rate was used to
   avoid the huge amount of numerical calculation of chemical dynamic
   equations. Compared with averaged ozone observation data, simulation of
   effect of cloud on ozone was studied and the ozone consuming rate by
   cloud is specified by numerical test. Through numerical simulation,
   yearly-averaged distribution of tropospheric ozone (especially surface
   ozone) over China, its seasonal changes, and some distribution features
   of urban photochemical pollution in China were studied. Copyright (C)
   1996 Elsevier Science Ltd},
