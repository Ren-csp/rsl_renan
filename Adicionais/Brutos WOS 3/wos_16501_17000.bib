@article{ WOS:000078409200006,
Author = {Herrmann, H and Ervens, B and Nowacki, P and Wolke, R and Zellner, R},
Title = {A chemical aqueous phase radical mechanism for tropospheric chemistry},
Journal = {CHEMOSPHERE},
Year = {1999},
Volume = {38},
Number = {6},
Pages = {1223-1232},
Month = {MAR},
Note = {IUPAC Symposium on Degradation Processes in the Environment, DUBROVNIK,
   CROATIA, MAY 24-28, 1998},
Organization = {IUPAC},
Abstract = {In the present work model simulations with a box model applying typical
   tropospheric initial conditions for three different scenarios (marine,
   rural and urban conditions) are performed to model tropospheric
   chemistry in bath the gas and the aqueous phase. The gas phase chemistry
   is described by RADM2 {[}1]. For the aqueous phase chemistry a detailed
   aqueous phase mechanism (CAPRAM, chemical aqueous phase radical
   mechanism) was developed. This mechanism is more extensive than other
   existing mechanisms, because the oxidation of organic compounds with one
   and two carbon atoms, an explicit description of radical or iron(III)
   initiated S(IV)-oxidation, the reactions of radicals and radical anions
   . OH, NO3., Cl-2(-), . Br-2(-), and CO3-., and the chemistry of the
   dissolved transition metal ions (TMI) iron, manganese and copper is
   treated in detail.},
