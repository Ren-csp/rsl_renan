Booktitle = {PROCEEDINGS OF THE INTERNATIONAL CONFERENCES ON E-HEALTH 2015 E-COMMERCE
   AND DIGITAL MARKETING 2015 AND INFORMATION SYSTEMS POST-IMPLEMENTATION
   AND CHANGE MANAGEMENT 2015},
