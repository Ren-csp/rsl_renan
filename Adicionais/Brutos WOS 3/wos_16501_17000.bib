@article{ WOS:000080687800022,
Author = {Rubenstein, AJ and Kalakanis, L and Langlois, JH},
Title = {Infant preferences for attractive faces: A cognitive explanation},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {1999},
Volume = {35},
Number = {3},
Pages = {848-855},
Month = {MAY},
Note = {1997 Biennial Meeting of the Society-of-Research-in-Child-Development,
   WASHINGTON, D.C., MAR-APR -, 1997},
Organization = {Soc Res Child Dev},
Abstract = {Research on infant face perception has shown that infants' preferences
   for attractive faces exist well before socialization from parents,
   peers, and the media can affect these preferences. Four studies assessed
   a cognitive explanation for the development of attractiveness
   preferences: cognitive averaging and infant preferences for
   mathematically averaged faces, or prototypes. Studies 1 and 2
   demonstrated that both adults and 6-month-old infants prefer
   prototypical, mathematically averaged faces. Studies 3 and 4
   demonstrated that 6-month-olds can abstract the central tendency from a
   group of naturalistic faces. Taken together, the studies suggest that
   infants' preferences for attractive faces can be explained by general
   information-processing mechanisms.},
