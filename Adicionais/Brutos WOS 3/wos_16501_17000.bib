Title = {Coral reefs:: threats and future focusing in over-rishing, aquaculture,
   and educational programs},
Booktitle = {MANAGEMENT OF NATURAL RESOURCES, SUSTAINABLE DEVELOPMENT AND ECOLOGICAL
   HAZARDS},
