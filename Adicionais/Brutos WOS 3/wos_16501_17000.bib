@inproceedings{ WOS:000167102100014,
Author = {Usher, M and Niebur, E},
Editor = {Riegler, A and Peschl, M and VonStein, A},
Title = {Mental representations: A computational-neuroscience scheme},
Booktitle = {UNDERSTANDING REPRESENTATION IN THE COGNITIVE SCIENCES: DOES
   REPRESENTATION NEED REALITY?},
Year = {1999},
Pages = {135-142},
Note = {Conference on New Trends in Cognitive Science (NTCS 97), VIENNA,
   AUSTRIA, MAY 14-16, 1997},
Organization = {Austrian Soc Cognit Sci},
Abstract = {We discuss a series of problems facing referential theories of mental
   representations and we propose a scheme based on neurophysiological
   principles that avoids previous limitations. According to this scheme,
   mental representations are brain traces linked to stimuli in the
   environment, via a causal but probabilistic process of categorical
   perception, and fluctuations in activity reflect fluctuations in the
   confidence-level of perceptual and cognitive hypotheses. The scheme
   provides an explanation for cases of misrepresentation and is consistent
   with the abundance of recurrent connections in the cortex, which play an
   important role in mediating a process of interpretation and of binding
   of relational properties via temporal synchronisation.},
