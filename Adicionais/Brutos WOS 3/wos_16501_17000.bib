@inproceedings{ WOS:000425332900008,
Author = {Evans, Nina and Price, James},
Editor = {Tsui, E and Cheung, B},
Title = {Human Capital and Information Asset Management Behaviours in Law Firms},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2017)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2017},
Pages = {63-71},
Note = {14th International Conference on Intellectual Capital, Knowledge
   Management and Organisational Learning (ICICKM), Hong Kong Polytechn
   Univ, Hong Kong, HONG KONG, DEC 07-08, 2017},
Abstract = {Intellectual capital consists of human capital and intellectual assets.
   In a law firm the human capital includes managers, lawyers and support
   staff. Intellectual assets are a source of innovation and include data,
   information and knowledge (referred to as `information assets'),
   including emails, clients' business information, financial transaction
   documents, research notes, matters, contracts, billing records, time
   recordings, reports, web sites, social media, patents, and trademarks.
   These information assets are vital for law firms as they enable every
   business activity, every business process and every business decision.
   The effective management of information assets contributes to realising
   business benefit by increasing revenue, reducing cost, mitigating risk,
   improving the quality and speed of delivery of legal services, improving
   productivity and creating competitive advantage. By their nature, law
   firms rely especially heavily on their human assets to generate high
   quality information assets (like documents with a very high level of
   sophisticated and innovative legal content) and to manage those assets
   effectively. This study investigated the impact of the behaviours of
   staff on the management of the information assets in law firms.
   Qualitative interviews were conducted with legal practitioners and
   managers of law firms in Australia, the United States of America (USA)
   and South Africa. It was found that the attitudes and behaviours of
   lawyers and legal practice managers prevent their firms from fully
   realising their potential. These behaviours relate to five categories of
   barriers to information asset management, namely executive awareness,
   leadership and management (including organisational culture,
   implementing instruments to manage and measure how well information
   assets are managed, and incentivising people to manage the asset
   effectively), business governance, justifying investment in information
   asset management (based on cost, value and benefit) as well as available
   tools (including a common language and accounting standards). If lawyers
   do not value information and comply with the information asset
   management guidelines that stipulate where, how and when data,
   information and knowledge should be stored, it may result in lack of
   discipline resulting in haphazard storage on various non-secure devices
   and misuse of official communication channels. Lawyers may also hide
   information from others due to the feeling of ownership of information
   that belong to the firm but are under their constant control. Such
   behaviours have a negative impact on collaboration, the development of
   new ideas, the implementation of policies or procedures, and
   performance, i.e. the firm's ability to capture and leverage
   intellectual capital.},
Publisher = {ACAD  CONFERENCES LTD},
Address = {CURTIS FARM, KIDMORE END, NR READING, RG4 9AY, ENGLAND},
