@inproceedings{ WOS:000180304100055,
Author = {Horne, R and Cooper, V and Gellaitry, G and Fisher, M},
Book-Group-Author = {MONDUZZI ECITORE
   MONDUZZI ECITORE
   MONDUZZI ECITORE
   MONDUZZI ECITORE},
Title = {Predicting non-adherence to highly active antiretroviral treatment
   (HAART): The role of patients' doubts about personal need and concerns
   about potential adverse effects},
Booktitle = {XIV INTERNATIONAL AIDS CONFERENCE: CLINICAL SCIENCES AND CARE},
Year = {2002},
Pages = {255-259},
Note = {14th International AIDS Conference, BARCELONA, SPAIN, JUL 07-12, 2002},
Organization = {Univ N Carolina; Gen Clin Res Ctr; UNC Ctr AIDS Res; Natl Inst Hlth;
   Swiss Natl AIDS Res Program; Bristol-Myers Squibb Co; Boehringer
   Ingelheim; GlaxoWellcome Res \& Dev, HIV Antiviral Res},
Abstract = {We present an interim analysis from an ongoing prospective study to test
   whether patients' perceptions of HAART predict subsequent adherence.
   Consecutive patients (n=58) who accepted HAART completed a validated
   questionnaire assessing perceptions of personal need for HAART and
   concerns about potential adverse effects. Adherence rates declined over
   time. There was a dynamic relationship between beliefs and adherence.
   Beliefs about personal necessity for HAART at baseline were high and did
   not predict adherence, however at 6 months lower personal necessity was
   related to low adherence. Concerns about HAART prior to initiating
   treatment predicted adherence after 1 and 6 months. Implications for the
   design of interventions to facilitate adherence are discussed.},
