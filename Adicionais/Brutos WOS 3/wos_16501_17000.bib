Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {We investigated distance perception of targets in convex and plane
   mirrors. Twenty subjects matched the distance of a target in a real
   scene to the distance of a virtual target in mirrors. The matched
   distances were much larger for the convex mirrors than for the plane
   mirror and larger matches were obtained for a more convex mirror. This
   suggests that distance in the convex mirrors was perceived to be larger
   than that in the plane mirror. Furthermore, we attempted to identify the
   cues to distance in mirrors with multiple regression analyses and found
   perceived distance of targets in mirrors to be determined mainly by
   their visual angle. We compared our results with those on distance
   perception in picture.},
