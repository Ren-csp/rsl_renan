@article{ WOS:000244805300010,
Author = {Sundstrom, Petra and Stahl, Anna and Hook, Kristina},
Title = {In situ informants exploring an emotional mobile messaging system
   in their everyday practice},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER STUDIES},
Year = {2007},
Volume = {65},
Number = {4},
Pages = {388-403},
Month = {APR},
Note = {Conference on Human Factors in Computing Systems (CHI 2005)Workshop on
   Evaluating Affective Interfaces, Portland, ORPortland, OR, 2005APR 04,
   2005},
Organization = {CHI},
Abstract = {We have designed and built a mobile emotional messaging system named
   eMoto. With it, users can compose messages through using
   emotion-signalling gestures as input, rendering a message background of
   colours, shapes and animations expressing the emotional content. The
   design intent behind eMoto was that it should be engaging physically,
   intellectually and socially, and allow users to express themselves
   emotionally in all those dimensions, involving them in an affective loop
   experiance. In here, we describe the user-centered design process that
   lead to the eMoto system, but focus mainly on the final study where we
   let five friends use eMoto for two weeks. The study method, which we
   name in situ informants, helped us enter and explore the subjective and
   distributed experiences of use, as well as how emotional communication
   unfolds in everyday practice when channelled through a system like
   eMoto. The in situ informants are on the one hand users of eMoto, but
   also spectators, that are close friends who observe and document user
   behaviour. Design conclusions include the need to support the sometimes
   fragile communication rhythm that friendships require-expressing
   memories of the past, sharing the present and planning for the future.
   We saw that emotions are not singular state that exist within one person
   alone, but permeates the total situation, changing and drifting as a
   process between the two friends communicating. We also gained insights
   into the under-estimated but still important physical, sensual aspects
   of emotional communication. Experiences of the in situ informants method
   pointed to the need to involve participants in the interpretation of the
   data obtained, as well as establishing a closer connection with the
   spectators. (c) 2006 Elsevier Ltd. All rights reserved.},
