@inproceedings{ WOS:001792804400016,
Author = {Stanganelli, Marialuce and Torrieri, Francesca and Gerundo, Carlo and
   Rossitti, Marco},
Editor = {LaRosa, D and Privitera, R},
Title = {A Strategic Performance-Based Planning Methodology to Promote the
   Regeneration of Fragile Territories},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 1},
Series = {Lecture Notes in Civil Engineering},
