@article{ WOS:000080980900077,
Author = {Lassonde, M and Mottron, L and Peretz, I and Schiavetto, A and Hébert, S
   and Décarie, JC},
Title = {Loss of global visual and auditory processing following right temporal
   lobe lesion},
Journal = {BRAIN AND COGNITION},
Year = {1999},
Volume = {40},
Number = {1},
Pages = {162-166},
Month = {JUN},
Note = {Tennet IX - Theoretical and Experimental Neuropsychology Conference,
   UNIV QUEBEC MONTREAL, MONTREAL, CANADA, JUN 10-12, 1998},
Organization = {Univ Quebec Montreal; MRC Canada; Minist Ind \& Commerce},
Abstract = {Theories of perception emphasize the difference in efficiency with which
   ``wholes{''} and ``parts{''} are processed by each hemisphere, the right
   hemisphere being associated with global processing and the left with
   local processing. Evidence in favor of this dissociation stems from
   studies of visual perception, although recent work suggests that it may
   also apply to auditory processing. We report the first case study that
   indicates a crucial role of the right temporal lobe in this global-local
   dichotomy for both visual and auditory processing. The patient, a child
   with a right-temporal lobe lesion, showed a loss of global perceptual
   processing that interfered with her recognition of hierarchical visual
   stimuli as well as with her discrimination Of melodies. (C) 1999
   Academic Press.},
