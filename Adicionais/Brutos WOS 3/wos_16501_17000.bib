Editor = {Vladimirovna, DI},
Title = {``ROMEO AND JULIET{''} OR ``JULIET AND ROMEO{''}?},
Booktitle = {WUT 2018 - IX INTERNATIONAL CONFERENCE WORD, UTTERANCE, TEXT: COGNITIVE,
   PRAGMATIC AND CULTURAL ASPECTS},
