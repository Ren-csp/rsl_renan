Title = {Thermostatic cover for improving energy and technological efficiency of
   steel mills},
Booktitle = {INTERNATIONAL SCIENCE CONFERENCE SPBWOSCE-2018: BUSINESS TECHNOLOGIES
   FOR SUSTAINABLE URBAN DEVELOPMENT},
