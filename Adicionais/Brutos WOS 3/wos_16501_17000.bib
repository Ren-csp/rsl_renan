@article{ WOS:000221464200003,
Author = {Howarth, RW},
Title = {Human acceleration of the nitrogen cycle: drivers, consequences, and
   steps toward solutions},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2004},
Volume = {49},
Number = {5-6},
