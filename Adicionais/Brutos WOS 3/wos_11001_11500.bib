@inproceedings{ WOS:000259978000030,
Author = {Ohe, Y.},
Editor = {Pineda, FD and Brebbia, CA},
Title = {Characteristics and issues of rural tourism in Japan},
Booktitle = {SUSTAINABLE TOURISM III},
