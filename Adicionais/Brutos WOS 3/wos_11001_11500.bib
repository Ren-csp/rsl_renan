Title = {PREDICTION OF HOSPITALIZATIONS CAUSED BY RESPIRATORY DISEASES BY USING
   DATA MINING TECHNIQUES: SOME APPLICATIONS IN CURITIBA, BRAZIL AND THE
   METROPOLITAN AREA},
Booktitle = {AIR POLLUTION XXV},
Series = {WIT Transactions on Ecology and the Environment},
