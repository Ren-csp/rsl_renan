@inproceedings{ WOS:000179444800027,
Author = {Vandevyvere, H and Neuckermans, H},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Matrix: a research and design for housing typologies},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {199-206},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {``Matrix{''} is the name of a current research and design project that
   reflects on housing in a high-density context.
   In a first phase the research has aimed at formulating alternative
   answers to housing demands as they exist in Flanders, with 440
   inhabitants/km(2) the most densely populated region of Belgium.
   The goal has been
   to achieve high-density schemes that respect the individualistic
   character of the Flemish housing market,
   to take into account the current changes in family structures and living
   patterns,
   to propose ecologically defendable housing strategies that consume less
   space, infrastructure, energy and materials,
   to provide new types of designs for high-quality living environments,
   to re-establish a symbolic relation with nature for the present-day
   ``nebulous-city{''} dweller of Flanders.
   As such the research aims also at dealing with the more general
   challenge of housing design in a condition of urban sprawl,
   infrastructure congestion and the subsequent loss of (sub)urban living
   quality.
   To transcend some inherent contradictions of housing programs in this
   context, the principle of symbiosis has been adopted as a primary design
   rule. The potentials and the application of the philosophy of symbiosis
   have been explored in current Japanese and Western-European contexts,
   and its principles have subsequently been applied in a series of
   experimental designs on a selection of sites around the Flemish
   territory.
   The selected sites can generally be described as ``left over spaces{''}
   or accidental gaps in the urban tissue. The proposed projects and
   reflections have been made by three guest designers and by one of the
   authors. Some first conclusions have been drawn from this experience.
   The method of symbiosis seems to be a powerful instrument of analysis
   and synthesis in the design phase. Observations indicate the emergence
   of a wider interest in implementing alternative schemes such as
   discussed here.},
