@article{ WOS:000225295900038,
Author = {Piñeiro-Iglesias, M and Grueiro-Noche, G and López-Mahía, P and
   Muniategui-Lorenzo, S and Prada-Rodríguez, D},
Title = {Assessment of methodologies for airborne BaP analysis},
