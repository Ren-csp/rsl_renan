@article{ WOS:000231408900030,
Author = {Musaoglu, N and Coskun, M and Kocabas, V},
Title = {Land use change analysis of Beykoz-Istanbul by means of satellite images
   and GIS},
Journal = {WATER SCIENCE AND TECHNOLOGY},
