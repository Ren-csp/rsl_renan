Note = {1st International Conference on Cognitive Neurodynamics, Shanghai,
   PEOPLES R CHINA, NOV 17-21, 2007},
Organization = {E China Univ Sci \& Technol; Shanghai Soc Biophys; Editorial Board
   Cognit Neurodynam; Natl Nat Sci Fdn China; Shangai Assoc Sci \& Technol;
   Beijing Univ Technol; Beijing Univ Aeronaut \& Astronaut; Brain Sci Res
