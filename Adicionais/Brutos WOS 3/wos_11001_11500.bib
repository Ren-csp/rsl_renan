@article{ WOS:000266171300003,
Author = {Tong, Yu-Huei and Lin, Yu-Wen and Chen, Chih-Chieh and Lin, Jia-Ming},
Title = {Perceptions of General Education on Occupational Health and Safety Among
   College Students in Taiwan},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL HYGIENE},
