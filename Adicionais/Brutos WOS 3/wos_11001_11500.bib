@article{ WOS:000353548800007,
Author = {Ettinger, Ulrich and Mohr, Christine and Gooding, Diane C. and Cohen,
   Alex S. and Rapp, Alexander and Haenschel, Corinna and Park, Sohee},
Title = {Cognition and Brain Function in Schizotypy: A Selective Review},
Journal = {SCHIZOPHRENIA BULLETIN},
Year = {2015},
Volume = {41},
Number = {2},
