@inproceedings{ WOS:000185615100079,
Author = {Pizziolo, G and Micarelli, R and Behbehani, H},
Editor = {Tiezzi, E and Brebbia, CA and Uso, JL},
Title = {A hypothesis of research for landscapes in a state of transition},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2003},
Volume = {18-19},
Pages = {861-872},
Note = {4th International Conference on Ecosystems and Sustainable Development,
   SIENA, ITALY, JUN 04-06, 2003},
Organization = {Univ Siena; Wessex Inst Technol},
Abstract = {This paper deals with the problem of Contemporary landscapes and their
   state of transition, according to what the European Convention of
   Landscape has suggested, since the year 2000.
   At present Landscape tends to assume the role of ``scenery of mutations
   and metamorphosis{''}, instead of its traditional role of tutor of bio,
   natural and cultural diversity.{''}
   We have consequently to imagine new modalities of landscape, able to
   provide-the environment and the involved populations with ``reference
   terms{''}.
   Landscape can again become a dynamic and evolutionary phenomenon, going
   beyond the simple defensive line, towards a new appropriate dynamic both
   to protect the cultural heritage and to constitute new ``Life
   Environments{''} for the contemporary societies.
   For these reasons we consider the Mediterranean area as an ideal context
   for the experimentation of new/ancient landscapes. Here, in fact, it is
   possible to take into consideration, at the same time, traditional human
   settlements in their landscapes and their contemporary unexpected
   transformations.
   The Mediterranean area can be assumed-as an ideal context for the
   experimentation of new/ancient landscapes and ``Bioregion{''}.
   All of these different conditions can be involved, together, in a new
   emotional, aesthetic and constructive experience, that we have called
   ``social ecology{''}.
   We have launched several experiential researches in landscape social
   ecology which concern social perception, active participation in the
   rebirth of the local landscape, through laboratories of environmental
   micro-transformation within the context of urban outlying districts.
   All of these experiments are now being carried out in different
   localities, in Italy and Iran, as the Mediterranean Landscape Ateliers
   or the Persepoli's Gardens.},
