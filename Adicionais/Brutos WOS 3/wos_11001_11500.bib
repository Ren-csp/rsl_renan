@inproceedings{ WOS:000084315100045,
Author = {Gayford, C},
Editor = {Abrams, R},
Title = {An application of person construct theory to pre-service teachers'
   perceptions of the environment},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {169-173},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {This is a description of a pilot study using personal construct
   psychology approaches to enquire into attitudes to the environment among
   pre-service teachers. This technique allowed the researcher to establish
   a relatively `value free' context in which to explore attitudes to
   different types of environment among two small groups of students; those
   following an environmental course option and those who were not. The
   methodology involved a graded series of visual images of environments in
   the UK. to stimulate discussion to elicit constructs from the students.
   The results showed that there was a probable qualitative difference
   between the two groups, with a greater variety of construct descriptors,
   higher scores for the most natural environments and fewer shared
   constructs among the environmental group compared to the reference
   group. The methodology was also successful in enabling students to
   discuss freely their views and attitudes to the different images.},
