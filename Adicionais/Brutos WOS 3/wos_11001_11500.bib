@inproceedings{ WOS:000254169000021,
Author = {Mofidi, S. M. and Moradi, A. M. and Akhtarkavan, M.},
Editor = {Krope, J and Garbai, L and Kozic, D and Goricanec, D and Saklellaris, I},
Title = {Assessing sustainable adaptation of historical buildings to climate
   changes of Iran},
Booktitle = {PROCEEDINGS OF THE 3RD IASME/WSEAS INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: ENERGY AND ENVIRONMENT III},
Year = {2008},
Pages = {145+},
Note = {3rd IASME/WSEAS International Conference on Energy and Environment, Univ
   Cambridge, Cambridge, ENGLAND, FEB 23-25, 2008},
Organization = {IASME; WSEAS},
Abstract = {The present paper will explore adaptive reuse and sustainability of
   existing and historic buildings by having special consideration for
   climate changes in Iran. It would provide means of strengthening,
   changing, or improving the existing facilities such as those meets with
   the current performance requirements necessary for their intended use.
   In this study it will be shown that adaptive reuse and rehabilitation of
   existing and historic buildings should be a central strategy for
   creating a sustainable environment which meets with human needs while
   preserving the natural environment in a healthy and useful status. The
   conclusions would provide guidelines for similar sustainable
   rehabilitation projects. The main concentration will be on reuse of the
   adapted historic buildings in order to make them more sustainable and as
   a result to reduce the impacts of climate changes in Iran. The paper
   synopsizes a research in progress to extend the current body of
   knowledge into sustainable adaptive reuse of the historic and existing
   buildings.},
