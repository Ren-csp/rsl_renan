@article{ WOS:A1996UD72800002,
Author = {Lang, EV and Joyce, JS and Spiegel, D and Hamilton, D and Lee, KK},
Title = {Self-hypnotic relaxation during interventional radiological procedures:
   Effects on pain perception and intravenous drug use},
Journal = {INTERNATIONAL JOURNAL OF CLINICAL AND EXPERIMENTAL HYPNOSIS},
Year = {1996},
Volume = {44},
Number = {2},
Pages = {106-119},
Month = {APR},
Note = {46th Annual Meeting of the
   Society-for-Clinical-and-Experimental-Hypnosis, SAN ANTONIO, TX, NOV  
   11, 1995},
Organization = {Soc Clin \& Exptl Hypnosis},
Abstract = {The authors evaluated whether self-hypnotic relaxation can reduce the
   need for intravenous conscious sedation during interventional
   radiological procedures. Sixteen patients were randomized to a test
   group, and 14 patients were randomized to a control group. All had
   patient-controlled analgesia. Test patients additionally had
   self-hypnotic relaxation and underwent a Hypnotic Induction Profile
   test. Compared to controls, test patients used less drugs (0.28 vs. 2.01
   drug units; p < .01) and reported less pain (median pain rating 2 vs. 5
   on a 0-10 scale; p < .01). Significantly more control patients exhibited
   oxygen desaturation and/or needed interruptions of their procedures for
   hemodynamic instability. Benefit did not correlate with hypnotizability.
   Self-hypnotic relaxation can reduce drug use and improve procedural
   safety.},
