Author = {Cloherty, Shaun L. and Mustari, Michael J. and Rosa, Marcello G. P. and
   Ibbotson, Michael R.},
Title = {Effects of saccades on visual processing in primate MSTd},
Journal = {VISION RESEARCH},
Year = {2010},
Volume = {50},
