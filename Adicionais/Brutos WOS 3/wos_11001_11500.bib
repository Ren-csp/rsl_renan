@inproceedings{ WOS:000185615100019,
Author = {Plass, N and Trinkaus, P and Rinesch, C and Strasser, V},
Editor = {Tiezzi, E and Brebbia, CA and Uso, JL},
Title = {The use of checklists to support spatial planning in the municipality of
   Graz},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2003},
Volume = {18-19},
Pages = {209-217},
Note = {4th International Conference on Ecosystems and Sustainable Development,
   SIENA, ITALY, JUN 04-06, 2003},
Organization = {Univ Siena; Wessex Inst Technol},
Abstract = {The urgency of incorporating strategic assessment in the planning
   process across Europe is rooted in the opportunities it presents to
   evaluate environmental impacts of urban policies at an early stage of
   their development. Due to rapid transformations in spatial development
   the issue of strategic planning and assessment turns out to be of
   particular importance both because of the growing dynamics of the
   pressure exerted upon the physical environment and the lack of an
   adequate framework for its implementation (legislation, administrative
   structures, expert competence). It is expected to contribute to an
   improvement of both the process and the results in strategic urban
   planning. The research done on methodology focused on the development of
   a methodology transferable to different places while respecting the
   differences.
   The integration of environmental considerations in the urban planning
   process, e.g. the identification of suitable locations for urban
   development, helps to ensure, sustainability through precautionary
   management. Environmentally relevant data (such as soil, geology, ground
   water, landscape, recreation, green space, fauna) with regard to the
   proposed plan or policy are screened and collected, and linked with
   already existing data and results (from data bases, aerial photos,
   different thematic maps).
   A methodological approach that helps to describe the baseline
   environment and predict impacts has been developed. Special attention is
   given to provide space for and encourage the use of alternative
   scenarios, according to the overall objective(s) and to the given data
   set, leading to low cost action and greatest benefit for both people and
   their environment. The methodology should be understood as a tool to
   support sustainable development and planning.},
