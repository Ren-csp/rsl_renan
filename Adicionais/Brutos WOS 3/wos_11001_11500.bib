Editor = {Kungolos, AG and Liakopoulos, AB and Korfiatis, GP and Koutsospyros, AD and Katsifarakis, KL and Demetracopoulos, AD},
Title = {Air-quality related environmental impact assessment for the new landfill
   site of Thessaloniki},
