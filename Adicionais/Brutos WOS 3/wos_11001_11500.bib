@inproceedings{ WOS:000392856300142,
Author = {Hamedi, Amirmasoud and Fuentes, Hector R.},
Editor = {Karvazy, K and Webster, VL},
Title = {Comparative Effectiveness and Reliability of NEXRAD Data to Predict
   Outlet Hydrographs Using the GSSHA and HEC-HMS Hydrologic Models},
Booktitle = {World Environmental and Water Resources Congress 2015: Floods, Droughts,
   and Ecosystems},
Year = {2015},
Pages = {1444-1453},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {NEXRAD (next-generation radar) is currently an alternative method to
   measure areal precipitation, and is also a much easier approach than
   using rain gages. Although measurement with rain gages is considered to
   produce the highest accuracy, its use may be limited or difficult under
   a number of circumstances that are associated with events, such as
   tropical storms and hurricanes or storm in mountainous terrain, missing
   opportunities to record valuable precipitation data. Because of the
   advantages of NEXRAD, where deployed, it is then important to assess the
   potential and effectiveness of using NEXRAD data as input to
   hydrologic-hydraulic computer models to simulate surface water flow in a
   variety of water systems (e.g., streams, rivers, man-made open channels,
   overland flow in open spaces, natural and engineered wetlands, storm
   water in urban settings, etc.). This study used two hydrologic models,
   GSSHA and HEC-HMS, to assess their processing of both NEXRAD and rain
   gage data for the same watershed and then compare the effectiveness of
   their predicted outlet hydrographs. The Nash-Sutcliffe coefficient shows
   that the outlet hydrograph predicted by GSSHA is more effective (i.e.,
   more realistic) than that estimated by HEC-HMS. In addition, the RMSE
   (root mean square error) analysis shows very good agreement between the
   predicted hydrographs using either rain gage data or NEXRAD data,
   pointing out at the reliability of using NEXRAD data in this study.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Hamedi, A (Corresponding Author), Florida Int Univ, Miami, FL 33174 USA.
   Hamedi, Amirmasoud; Fuentes, Hector R., Florida Int Univ, Miami, FL 33174 USA.},
ISBN = {978-0-7844-7916-2},
Keywords = {rain gage; NEXRAD; hydrologic model assessment; effective prediction},
Research-Areas = {Engineering; Environmental Sciences \& Ecology; Water Resources},
Web-of-Science-Categories  = {Engineering, Civil; Environmental Sciences; Water Resources},
Author-Email = {amirmasoud.hamedi1@fiu.edu
   fuentes@fiu.edu},
