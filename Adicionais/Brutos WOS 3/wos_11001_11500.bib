@inproceedings{ WOS:000538681000016,
Author = {Dang, M. and Sampaio, M.},
Book-Group-Author = {IOP},
Title = {The potential for rooftop agriculture in the city of Rio de Janeiro:
   Growing capacity, Food security and Green infrastructure},
Booktitle = {SUSTAINABILITY IN THE BUILT ENVIRONMENT FOR CLIMATE CHANGE MITIGATION
   (SBE19)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
Volume = {410},
