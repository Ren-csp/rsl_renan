Title = {Maternal depressiveness, reactions to toddler's negative emotions and
   toddler's self-regulation: Is the role of gender important?},
Booktitle = {16TH EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY},
Year = {2014},
Pages = {21-24},
Note = {16th European Conference on Developmental Psychology, Lausanne,
   SWITZERLAND, SEP 03-07, 2013},
Abstract = {Gender is identified as an important factor in the ability to
   self-regulate, documenting that boys tend to be poorer self-regulators
   than girls. This study aims to examine if and how the children's
   self-regulation can be explained by gender, child's temperamental traits
   and maternal- related variables. The longitudinal data of 109 children
   (52 girls and 57 boys) and of their mothers are analyzed in this study.
   Results show that boys have more self- regulatory problems at age one
   and a half, two and four years old and lower scores of effortful control
   at age three years old. Boys tend to be more vulnerable to early
   maternal depressiveness, however the child's temperamental traits have a
   main effect in predicting self-regulatory difficulties in both girls and
   boys.},
