@article{ WOS:A1995QN98700013,
Author = {PONTEROTTO, JG and BURKARD, A and YOSHIDA, RK},
Title = {PROSPECTIVE MINORITY-STUDENTS PERCEPTIONS OF APPLICATION PACKETS FOR
   PROFESSIONAL PSYCHOLOGY PROGRAMS - A QUALITATIVE STUDY},
Journal = {PROFESSIONAL PSYCHOLOGY-RESEARCH AND PRACTICE},
Year = {1995},
Volume = {26},
Number = {2},
Pages = {196-204},
Month = {APR},
Note = {102nd Annual Convention of the American-Psychological-Association, LOS
   ANGELES, CA, AUG 15, 1994},
Organization = {AMER PSYCHOL ASSOC},
Abstract = {This article reports the results of a qualitative study designed to
   determine issues salient in Black and Hispanic American students' review
   and evaluation of program-application packets in professional
   psychology. The study served as an extension to the Yoshida et al.
   (1989) quantitative investigation. Students interested in pursuing
   doctoral studies in counseling or school psychology (N = 22) served as
   the sample. The qualitative methodology incorporated a think-aloud
   procedure and semistructured interviews. A theme analysis of transcribed
   interviews identified both major and minor themes central to
   participants' evaluation of the packets. Major themes included financial
   aid, program requirements and course descriptions, demography of the
   student body, and the quality and clarity of application material.
   Specific suggestions on developing an application packet to send to
   inquiring prospective students are put forth. It is recommended that
   such a packet could serve as a cost-effective minority-recruitment
   strategy.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
