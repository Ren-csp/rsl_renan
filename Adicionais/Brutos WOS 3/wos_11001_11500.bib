@article{ WOS:000076541100011,
Author = {Rauch, W and Harremoes, P},
Title = {Correlation of combined sewer overflow reduction due to real-time
   control and resulting effect on the oxygen concentration in the river},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1998},
Volume = {37},
Number = {12},
Pages = {69-76},
Note = {7th International Workshop on Instrumentation, Control and Automation of
   Water and Wastewater Treatment and Transport Systems, BRIGHTON, ENGLAND,
   JUL 06-09, 1997},
Organization = {IAWQ, Specialist Grp Instrumentat Control \& Automat; Hyder Consulting
   Ltd; S W Water; So Water; Thames Water; Wessex Water},
Abstract = {Real-time control of the sewer system is a frequently applied measure
   for the abatement of pollution caused by urban runoff in the receiving
   water. Although the goal is an improvement of the water quality the
   actual aim of real-time control is usually formulated as the
   reduction/avoidance of combined sewer overflow. However, testing a
   virtual drainage system by means of a three-month rain series, hardly
   any correlation between the combined sewer overflow reduction and the
   resulting effect on the oxygen concentration in the river has been
   found. The efficiency of real-time control for pollution abatement by
   means of artificial performance criteria has to be doubted. (C) 1998
   Published by Elsevier Science Ltd. All rights reserved.},
