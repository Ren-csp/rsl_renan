Title = {The contribution of concepts for shared car ownership to the solution of
   transport and traffic problems, and the possible role of electric
   vehicles in these new transport concepts},
Booktitle = {TOWARDS CLEAN TRANSPORT: FUEL-EFFICIENT AND CLEAN MOTOR VEHICLES},
Year = {1996},
Pages = {269-276},
Note = {Conference on Towards Clean Transport - Fuel Efficient and Clean Motor
   Vehicles, MEXICO CITY, MEXICO, MAY 30-JUN 01, 1994},
Organization = {Org Econ Cooperat \& Dev; Int Energy Agcy},
Abstract = {New concepts of shared car ownership, such as Call-a-Car, can contribute
   to the alleviation of problems caused by traffic in the urban areas of
   both developed and developing countries. The effectiveness of shared car
   ownership as a governmental policy instrument will depend on the
   presence of supporting policies. Such governmental policy should be
   aimed at making shared car ownership attractive as a substitute for
   private car ownership, and not as a substitute for biking or public
   transport. By introducing electric vehicles in professionally operated
   shared car-ownership organizations an extra contribution can be made to
   the improve;rent of the urban living environment. These organizations
   also offer the opportunity to let the electric vehicle mature
   commercially in a protected market environment.},
