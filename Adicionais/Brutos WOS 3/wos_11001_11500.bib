Title = {Comprehensive approach for solving multimodal data analysis problems
   based on integration of evolutionary, neural and deep neural network
   algorithms},
Booktitle = {IX INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC AND RESEARCH CONFERENCE
   MODERN ISSUES IN SCIENCE AND TECHNOLOGY / WORKSHOP ADVANCED TECHNOLOGIES
   IN AEROSPACE, MECHANICAL AND AUTOMATION ENGINEERING},
