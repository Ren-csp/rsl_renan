@article{ WOS:000221964700011,
Author = {Hillman, CH and Cuthbert, BN and Bradley, MM and Lang, PJ},
Title = {Motivated engagement to appetitive and aversive fanship cues:
   Psychophysiological responses of rival sport fans},
Journal = {JOURNAL OF SPORT \& EXERCISE PSYCHOLOGY},
