@inproceedings{ WOS:A1996BH54M00053,
Author = {Tercier, J and Orcel, A and Orcel, C},
Editor = {Dean, JS and Meko, DM and Swetnam, TW},
Title = {Dendrochronological study of prehistoric archaeological sites in
   Switzerland},
Booktitle = {TREE RINGS, ENVIRONMENT AND HUMANITY},
Year = {1996},
Pages = {567-582},
Note = {International Conference on Tree Rings, Environment and Humanity -
   Relationship and Processes, TUCSON, AZ, MAY 17-21, 1994},
Organization = {Natl Sci Fdn, Anthr Program, Human Dimens \& Econ Global Change Prog;
   Natl Sci Fdn, Climate Dynam Program},
Abstract = {We present three Neolithic lakeshore sites, describing different
   approaches rind methods of dendrochronological study appropriate to each
   specific case. Topics of our analysis include the constitution of
   dendrotypological groups, relative and absolute dating, inter-species
   dating, mapping, integration of archaeological data concerning
   stratigraphy and the support provided by radiocarbon dating. The
   considerable body of dendrological and dendrochronological results
   obtained provides the basis for discussing the chronology of occupation
   of the sites; the identity, orientation and expansion dynamics of the
