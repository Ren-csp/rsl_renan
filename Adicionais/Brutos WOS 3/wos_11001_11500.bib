@article{ WOS:000185863000003,
Author = {Winn, PJS and Young, RM and Edwards, AMC},
Title = {Planning for the rising tides: the Humber Estuary Shoreline Management
   Plan},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {2003},
Volume = {314},
Pages = {13-30},
