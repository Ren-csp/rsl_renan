@inproceedings{ WOS:000347519700002,
Author = {Nugteren, Albertina},
Editor = {Schuler, B},
Title = {Cosmos, Commodity, and Care: Three Layers in Hindu Environmental
   Awareness},
Booktitle = {ENVIRONMENTAL AND CLIMATE CHANGE IN SOUTH AND SOUTHEAST ASIA: HOW ARE
   LOCAL CULTURES COPING?},
Series = {Climate and Culture},
Year = {2014},
Volume = {2},
Pages = {27-42},
Note = {Conference on Climate Change in India and Southeast Asia - How are Local
   Cultures Coping, Inst Adv Study Humanities, Essen, GERMANY, JUN 28-29,
   2011},
Abstract = {In this article I trace some of the major points within the nexus
   culture-religion-nature in India. Many of the specifically Hindu
   elements in India's environmental lobby represent an appeal to the past.
   Mining religious heritage with the objective of finding inspiration for
   dealing with today's issues invariably results in an uncritical,
   selective, non-contextual and a-historic reproduction of inspiring
   imagery. Yet the cultural continuum, in a modest way, proves to be one
   potential resource for raising people's consciousness about
   environmental issues. Case studies from all over the globe show that
   cultural-spiritual values may induce sustainable use of resources, but
   often the relation is merely indirect. In matters of global
   anthropogenic climate change the scope may simply be too overwhelming to
   come up with culture-specific responses. A focus on place-based local
   initiatives reveals that, indeed, addressing religious sentiments may
   work in India, but what currency do these have in the global
   marketplace?},
