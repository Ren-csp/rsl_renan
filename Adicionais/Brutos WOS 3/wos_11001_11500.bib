@inproceedings{ WOS:000361827500013,
Author = {Lin, Lv and Muxuan, Lv},
Book-Group-Author = {Destech Publicat Inc},
Title = {A Study of the Impact of Environmental Color on Fitness-keeping Interest},
Booktitle = {INTERNATIONAL CONFERENCE ON ECOLOGICAL ENVIRONMENT, ENERGY SAVING AND
   EDUCATION MANAGEMENT (EES 2015)},
Year = {2015},
Pages = {67-73},
Note = {International Conference on Ecological Environment, Energy Saving and
   Education Management (EEES), Wuhan, PEOPLES R CHINA, JUL 25-26, 2015},
Organization = {Int Sci \& Educ Researcher Assoc; Beijing Gireida Educ Res Ctr},
Abstract = {An investigation was conducted on the correlation between environmental
   color and body-builders' fitness-keeping interest in five large-scale
   fitness centers in the city of Qinhuangdao. The following findings are
   made: 1. Diversified colors enhance body-builders' interest in indoor
   fitness centers; 2. Rich color enhances body-builders' interest in
   comprehensive fitness centers; 3. Body-builders' preferred colors
   include pink (93), brown (83), yellow (72), green (64), red (43), black
   (41), light blue (31) and purple (29). It is also found that owners of
   fitness centers are generally unaware of the correlation between
   environmental color and body-builders' fitness-keeping interest,
   resulting in few relevant studies and unreasonable use of environmental
   color in fitness centers. The paper recommends further research to be
   conducted to provide practical advice to promote healthy development of
   fitness centers.
   Human beings live in a world with rich colors. As vision is a major
   sense for mankind, color plays a vital role in the life of human beings.
   Scientists have found that 70\%-80\% of human information comes from
   vision. Visual information is an important means to trace human
   activities, without which human activities cannot go smoothly. Vision is
   a reflection of colors in nature. Colors are first captured by human
   eyes, and then visual signal will be transmitted through optic nerve to
   the nerve center in the brain, resulting in different feelings on human.
   Colors can exert a calming or exhilarating effect, on the base of which
   colors are divided into two categories. The first category is called
   warm color, such as red, orange, yellow. Warm colors make people feel
   excited, pleasant, and active and promote metabolism. The second
   category is called cool color, such as green, blue and purple. Cool
   colors exert a calming effect, which make people feel relaxed, peaceful
   and gentle {[}1]. In the sports and fitness fields, the study on how
   environment influences sports has gained more attention from researchers
   and body-builders in recent years. However, few studies have been
   carried out on the correlation between environmental color and
   body-builders' fitness-keeping interest. As fitness centers are where
   most people choose for body building, environmental color should not be
   neglected, because it influences not only body-builders' mood and
   emotion, but also their health, interest and the effect of body
   building. People's understanding of color varies from country to
   country, nationality to nationality and from religion to religion.
   People from different areas, age groups and occupations also show
   different color preferences. In sports research, there is no previous
   study on environmental color in fitness centers. In view of the above,
   researchers started this exploration and study on the correlation
   between environmental color and body-builders' fitness-keeping interest.
   It is hoped that this study will help people understand the beneficial
   role of environmental color in fitness centers and promote the healthy
   use of environmental color in fitness facilities.},
Publisher = {DESTECH PUBLICATIONS, INC},
Address = {439 DUKE STREET, LANCASTER, PA 17602-4967 USA},
