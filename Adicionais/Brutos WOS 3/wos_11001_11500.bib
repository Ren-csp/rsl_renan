@article{ WOS:000348710500007,
Author = {Middleton, Jennie and Yarwood, Richard},
Title = {`Christians, out here?' Encountering Street-Pastors in the post-secular
   spaces of the UK's night-time economy},
Journal = {URBAN STUDIES},
Year = {2015},
Volume = {52},
