Title = {Researches on Heavy Metals Accumulation of Greening Trees Species in
   Lanzhou City},
Booktitle = {PROCEEDINGS OF SYMPOSIUM FROM CROSS-STRAIT ENVIRONMENT \& RESOURCES AND
   2ND REPRESENTATIVE CONFERENCE OF CHINESE ENVIRONMENTAL RESOURCES \&
   ECOLOGICAL CONSERVATION SOCIETY},
Year = {2010},
Pages = {295-302},
Note = {Symposium from Cross-Strait Environment and Resources/2nd Representative
   Conference of Chinese Environmental Resources and Ecological
   Conservation Society, Linyi City, PEOPLES R CHINA, JUL 06-08, 2010},
Organization = {Shandong Provincial Key Lab Soil \& Water Conservation \& Environm
   Protect; Linyi Normal Univ; Inst Geograph Sci \& Nat Resources Res;
   Chinese Soc Env Resources \& Ecolog Conservat},
Abstract = {The atmospheric heavy metals pollution is one of the most serious
   problems that obsessing the world urban environment. The application of
   greening tree species to absorb the heavy metals in the atmosphere is an
   important method in the atmospheric pollution management. In order to
   select monitoring and effective greening tree species to purify the
   heavy metals pollution, four common greening tree species in five
   selected polluted areas are chosen to measure the heavy metals
   concentration. The concentration of heavy metals in tree species leaves
   was obviously associated with the heavy metals properties, pollution
   conditions and tree species type. The potential Pb accumulation capacity
   of different greening tree species appeared in the order of Sabina
   chiesis> Sophora japonica> Buxus microphylla> Populus tomentosa. And far
   Cu, the accumulation capacity can be ranked as Sabina chiesis> Populus
   tomentosa> Sophora japonica> Buxus microphylla. Populus tomentosa had
   the highest accumulation capacity for Cd, While Sophora japonica for Zn.
   Totally, the overall degree of atmospheric heavy metals pollution in the
   investigated areas can be shown as follows: XiGuan> Rubber plant>
   Petroleum plant> Xizhan >Jiaoda. The results can offer theoretical
   practices for the management of air pollution in Lanzhou city.},
