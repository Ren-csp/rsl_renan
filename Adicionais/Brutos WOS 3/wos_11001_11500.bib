Title = {Methodology and quality assurance of VOC measurements in the
   Expolis-study},
Booktitle = {VOLATILE ORGANIC COMPOUNDS IN THE ENVIRONMENT - RISK ASSESSMET AND
   NEUROTOXICITY},
Series = {ADVANCES IN OCCUPATIONAL MEDICINE \& REHABILITATION},
Year = {1997},
Volume = {3},
Number = {3},
Pages = {27-32},
Note = {International Conference on Volatile Organic Compounds, SALVATORE
   MAUGERI FDN MED CTR, PAVIA, ITALY, OCT 05-07, 1997},
Organization = {Univ Pavia; Salvatore Maugeri Fdn; Int Soc Built Environm; Natl Res
   Council, Rome; AgipPetroli; BASF; CON TEC Engn; DANI; Draeger Italiana;
   FIAT Auto; FKV; Instrumentat Lab; IPSOA Editore Indicitalia; Perkin
   Elmer; Pollut Srl Clean Air Syst; San Air Ambiente; Tecnol Ind \&
   Ambientali; Unione Petrolifera; Zambelli},
Abstract = {Expolis is an European multi-centre (Athens, Milan, Basel, Grenoble,
   Prague and Helsinki) air pollution exposure study. It focuses on working
   age urban populations of Europe, exposed to air pollutants in their
   homes, workplaces and other common urban micro-environments. Personal
   exposure to 30 different volatile organic compounds (VOCs) and their
   concentrations at home (indoor and outdoor) and at work have been
   measured. The sampled VOCs were selected on the basis of their
   environmental and health significance and the availability of a sampling
   and analytical method for each compound. In Athens, Milan, Prague and
   Helsinki, VOCs were sampled on Tenax TA adsorbent tubes and analysed
   centrally in Finland. In Basel, samples were collected with active
   charcoal tubes and analysed in Switzerland. To produce reliable and
   comparable data for VOC exposure and other micro-environmental
   parameters, careful equipment selection, method development and testing,
   as well as thorough quality assurance and quality control (QA\&QC)
   procedures are needed. This paper introduces the equipment, the
   methodological standard operating procedures, and the QA\&QC procedures
   for VOC sampling in the Expolis-study. It also presents preliminary
   results of the personal and micro-environmental sampling method
   comparison test and of the first field blank and duplicate tests in one
   Expolis-centre, Helsinki, and discusses their implications for the whole
   study.},
Publisher = {FONDAZIONE SALVATORE MAUGERI EDIZIONI, PI-ME PRESS},
Address = {VIALE SARDEGNA 64, PAVIA 27100, ITALY},
Type = {Proceedings Paper},
