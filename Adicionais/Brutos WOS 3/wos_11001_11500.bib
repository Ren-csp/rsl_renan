@inproceedings{ WOS:000079308700094,
Author = {Cook, TM and Zimmermann, CL and Rosecrance, JC and Hatiar, K},
Editor = {Singh, A and Hinze, J and Coble, RJ},
Title = {Differences in musculoskeletal symptoms and job factor perceptions
   between Slovak and US construction workers},
Booktitle = {IMPLEMENTATION OF SAFETY AND HEALTH ON CONSTRUCTION SITES},
Year = {1999},
Pages = {705-710},
Note = {2nd International Conference of CIB Working Commission W99, HONOLULU,
   HI, MAR 24-27, 1999},
Organization = {Carter \& Burgess, Corp Headquarters; Natl Sci Fdn; HI Occupat Safety \&
   Hlth Div; HI Dept Transportat; Univ Hawaii Manoa; Construct Educ
   Concepts},
Abstract = {The purpose of this project was to generate descriptive data regarding
   musculoskeletal complaints and problematic job factors among
   construction workers in the United States and the Slovak Republic with
   the overall goal of reducing occupational injuries and illnesses within
   the construction trades in both countries. Data using a two-page
   self-administered symptom and job factors questionnaire were collected
   from unionized construction workers in the U.S. (2,516) and the Slovak
   Republic (1,096). Analysis of the data indicates many similarities in
   the prevalence of musculoskeletal complaints between the two groups of
   workers but also interesting differences, particularly in the wrist/hand
   and upper back. Workers in the Slovak Republic reported a five-fold
   increase in the portion of workers who reported missing work to workers
   who reported symptoms, compared to the U.S. Overall, reports of
   problematic job factors were very similar between the two countries,
   although there were some factors that were different. This type of data
   is being used as the basis for participatory ergonomic problem solving
   in both countries.},
