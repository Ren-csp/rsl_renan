@article{ WOS:000182034000005,
Author = {Nazir, TA and Decoppet, N and Aghababian, V},
Title = {On the origins of age-of-acquisition effects in the perception of
   printed words},
Journal = {DEVELOPMENTAL SCIENCE},
Year = {2003},
Volume = {6},
Number = {2},
Pages = {143-150},
Month = {APR},
Note = {2nd Bisontine Conference for the Conceptual and Linguistic Development
   in the Child Aged from 1 to 6 Years, BESANCON, FRANCE, MAR 21-22, 2001},
Abstract = {Children from different grades were tested in a lexical decision task.
   Word-stimuli consisted of words acquired in their respective grades, and
   in grades previous to their own. The results showed that the proportion
   of errors for newly acquired words increased steadily with grade (i.e.
   first graders made fewer errors with words of grade one than fifth
   graders with words of grade five). However, the proportion of errors for
   words acquired in a given grade remained constant throughout the
   following grades (fifth graders made as many errors with words acquired
   in grade one as first graders did). These results indicate that the
   strong impact that age- or order-of-acquisition of words has on the way
   words will be recognized is in place at a very young age.},
