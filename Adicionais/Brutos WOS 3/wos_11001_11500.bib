@inproceedings{ WOS:000661129800011,
Author = {Singh, Pratima and Arora, Renu and Goyal, Radha},
Editor = {Sharma, A and Goyal, R and Mittal, R},
Title = {Impact of Lighting on Performance of Students in Delhi Schools},
Booktitle = {INDOOR ENVIRONMENTAL QUALITY, ACIEQ},
Series = {Lecture Notes in Civil Engineering},
Year = {2020},
Volume = {60},
