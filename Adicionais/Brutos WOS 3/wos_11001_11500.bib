@inproceedings{ WOS:000077556200003,
Author = {Jurvelin, J and De Bortoli, M and Cavallo, D and Knoppel, H and Kunzli,
   N and Laine-Ylijoki, J and Oglesby, L and Saarela, K and Jantunen, MJ},
