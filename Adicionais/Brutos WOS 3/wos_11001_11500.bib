@inproceedings{ WOS:A1996BH54M00050,
Author = {Hurni, JP and Orcel, C},
Editor = {Dean, JS and Meko, DM and Swetnam, TW},
Title = {Dendrochronological results on buildings in Switzerland: Geographical
   aspects},
Booktitle = {TREE RINGS, ENVIRONMENT AND HUMANITY},
Year = {1996},
Pages = {533-542},
Note = {International Conference on Tree Rings, Environment and Humanity -
   Relationship and Processes, TUCSON, AZ, MAY 17-21, 1994},
Organization = {Natl Sci Fdn, Anthr Program, Human Dimens \& Econ Global Change Prog;
   Natl Sci Fdn, Climate Dynam Program},
Abstract = {We present dendrochronological results of analyses of wood from
   structures found in the cantons of Zurich, north of the Alps and Ticino,
   south of the Alps, Switzerland. We consider the size, the tree species,
   the geographical distribution and proportion of the series, the periods
   covered by dendrochronological sequences, and the distribution by
   species of the years of felling for each of the two data sets. The
   diversity of building wood both between and within the two regions
   demonstrates that no single wood species should be preferentially
   selected for analysis: it is possible to construct a data set for each
   species.},
