@article{ WOS:000186464200011,
Author = {Dijkerman, HC and McIntosh, RD and Milner, AD and Rossetti, Y and
   Tilikete, C and Roberts, RC},
Title = {Ocular scanning and perceptual size distortion in hemispatial neglect:
   effects of prism adaptation and sequential stimulus presentation},
Journal = {EXPERIMENTAL BRAIN RESEARCH},
Year = {2003},
Volume = {153},
Number = {2},
Pages = {220-230},
Month = {NOV},
Note = {Workshop on Cognitive and Neural Bases of Visually Guided Action,
   FRANCE, SEP, 2002},
Organization = {European Comm, Res Directorate Gen, Human Potential Programme; European
   Brain \& Beh Soc},
Abstract = {When asked to compare two lateralized shapes for horizontal size,
   neglect patients often indicate the left stimulus to be smaller.
   Gainotti and Tiacci (1971) hypothesized that this phenomenon might be
   related to a rightward bias in the patients' gaze. This study aimed to
   assess the relation between this size underestimation and oculomotor
   asymmetries. Eye movements were recorded while three neglect patients
   judged the horizontal extent of two rectangles. Two experimental
   manipulations were performed to increase the likelihood of symmetrical
   scanning of the stimulus display. The first manipulation entailed a
   sequential, rather than simultaneous presentation of the two rectangles.
   The second required adaptation to rightward displacing prisms, which is
   known to reduce many manifestations of neglect. All patients
   consistently underestimated the left rectangle, but the pattern of
   verbal responses and eye movements suggested different underlying
   causes. These include a distortion of space perception without ocular
   asymmetry, a failure to view the full leftward extent of the left
   stimulus, and a high-level response bias. Sequential presentation of the
   rectangles and prism adaptation reduced ocular asymmetries without
   affecting size underestimation. Overall, the results suggest that
   leftward size underestimation in neglect can arise for a number of
   different reasons. Incomplete leftward scanning may perhaps be
   sufficient to induce perceptual size distortion, but it is not a
   necessary prerequisite.},
