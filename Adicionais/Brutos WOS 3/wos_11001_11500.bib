Organization = {European Cooperat Sci \& Technol Action TD0904; Natl Techn Univ Athens,
   Sch Architecture; Inst Language \& Speech Proc},
Abstract = {In this paper, we present an experiment whose goal is to assess the role
   of temporal aspects in sonically and haptically simulating the act of
   walking on a bump or a hole. In particular, we investigated whether the
   timing between heel and toe and the timing between footsteps affected
   perception of walking on unflat surfaces. Results show that it is
   possible to sonically and haptically simulate a bump or a hole only by
   varying temporal information.},
