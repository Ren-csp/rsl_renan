@article{ WOS:000075806100050,
Author = {Collier, TK and Johnson, LL and Stehr, CM and Myers, MS and Stein, JE},
Title = {A comprehensive assessment of the impacts of contaminants on fish from
   an urban waterway},
Journal = {MARINE ENVIRONMENTAL RESEARCH},
