@article{ WOS:A1997XM69600005,
Author = {Nepal, SK},
Title = {Sustainable tourism, protected areas and livelihood needs of local
   communities in developing countries},
Journal = {INTERNATIONAL JOURNAL OF SUSTAINABLE DEVELOPMENT AND WORLD ECOLOGY},
