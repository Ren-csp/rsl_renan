@article{ WOS:000270643100007,
Author = {Martin, Claire L. and Longley, Ian D. and Dorsey, James R. and Thomas,
   Rick M. and Gallagher, Martin W. and Nemitz, Eiko},
Title = {Ultrafine particle fluxes above four major European cities},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2009},
Volume = {43},
Number = {31, SI},
Pages = {4714-4721},
Month = {OCT},
Note = {6th International Conference on Urban Air Quality, Nicosia, CYPRUS, MAR
   27-29, 2007},
Abstract = {Little information is known about the behaviour of ultrafine particles
   (UFP) on a citywide scale. Total particle number flux, dominated by UFP,
   and other meteorological parameters were collected from tower sites in
   Manchester, London, Edinburgh and Gothenburg between 1999 and 2006 using
   the eddy covariance technique. Averaged diurnal cycles were produced for
   particle number flux, concentration, sensible heat flux, emission
   velocity. friction velocity, wind speed and temperature. UFP flux cycles
   showed clear diurnal trends which were linked to traffic activity and
   local sources. Wind sector analysis showed contributions to flux from
   local heavily urbanised areas. A simple parameterised model linking UP
   flux to traffic activity, sensible heat and friction velocity above the
   city was produced. (C) 2008 Elsevier Ltd. All rights reserved.},
