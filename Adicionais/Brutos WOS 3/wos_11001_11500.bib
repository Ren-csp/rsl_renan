Title = {A coupled hydrodynamic and ecological model to manage water quality in
   Ria Formosa coastal lagoon},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2003},
Volume = {18-19},
