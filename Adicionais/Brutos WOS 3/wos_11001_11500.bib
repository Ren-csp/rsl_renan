@inproceedings{ WOS:000472156000304,
Author = {Shaozheva, N. A. and Khokonov, M. A. and Makoeva, Z. A. and Zahohova, M.
   R. and Khanova, M. N.},
Editor = {KarimSultanovich, BD},
Title = {INTERETHNIC RELATIONS IN VALUE ORIENTATION OF KABARDINO-BALKARIA'S
   RUSSIANS IN CONTEXT OF GLOBALIZATION},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
Series = {European Proceedings of Social and Behavioural Sciences},
