@inproceedings{ WOS:000239989900012,
Author = {van Bommel, Severine},
Editor = {Langeveld, H and Roling, N},
Title = {The changing perception of expert advice in nature conservation: A case
   of the Drentsche Aa},
Booktitle = {Changing European Farming Systems for a Better Future: New Visions for
   Rural Areas},
Year = {2006},
Pages = {69-73},
Note = {7th European IFSA Symposium on New Visions for Rural Areas, Wageningen,
   NETHERLANDS, MAY 07-11, 2006},
Organization = {IFSA},
Abstract = {The paper shows that during the Last decade, governance has created the
   setting for a new role for nature conservation experts in the policy
   process in the Drentsche Aa area. For decades before, expert knowledge
   was used in nature conservation policy as experts were asked by policy
   makers to give advice on matters on which they were considered to be
   knowledgeable. During the last decade, the rote of experts has changed.
   Experts have become just another stakeholder among the number of private
   and public stakeholders that influence the outcome of the policy process
   and the value of `scientific' knowledge is put into perspective, because
   other types of knowledge, such as local knowledge, are increasingly
   valued. This means that the experts-of-the-past and their claimed
   expertise are loosing credibility. As a result, experts-of-the-past are
   confronted with competing claims on expertise by `new' stakeholders.
   Boundaries and identities with regard to expertise have to be
   renegotiated and redefined.},
