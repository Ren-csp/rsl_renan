@inproceedings{ WOS:A1996BH57Z00034,
Author = {Lee, H and Kerstetter, D and Graefe, AR and Confer, JJ},
Editor = {Kuentzel, WF},
Title = {Crowding at an art festival: A replication and extension of the outdoor
   recreation crowding model},
Booktitle = {PROCEEDINGS OF THE 1996 NORTHEASTERN RECREATION RESEARCH SYMPOSIUM},
Series = {USDA FOREST SERVICE GENERAL TECHNICAL REPORT NORTHEASTERN FOREST
   EXPERIMENTAL STATION},
Year = {1996},
Volume = {232},
Pages = {198-204},
Note = {1996 Northeastern Recreation Research Symposium, BOLTON LANDING, NY, MAR
   31-APR 02, 1996},
Organization = {Lyndon State Coll; Mansfield Univ; Michigan State Univ; New Hampshire
   Div Parks \& Recreat; Penn State Univ; Soc Amer Foresters, Recreat
   Working Grp; SUNY Coll Environm Sci \& Forestry; Univ Massachusetts;
   Univ New Hampshire; Univ Vermont; Univ Waterloo; USDA Forest Serv, NE
   Forest Exptl Stn; Western Illinois Univ; Westfield State Coll; West
   Virginia Univ},
Abstract = {The purpose of this paper was to apply the perceived crowding model
   developed in backcountry settings to a festival setting. Festival
   participants in an urban area may have different characteristics from
   individuals exploring natural areas. Thus, the applicability of the
   social carrying capacity theories to defining the quality of a festival
   experience needs to be tested. Only three of the six independent
   variables were significant predictors of perceived crowding. Eleven
   percent of the variance in the perceived crowding measure was explained
   by three independent variables. However, it is worth nothing that
   individuals who had some comparative experience felt more crowded at the
   festival. The expectation of crowding variable was also found to
   influence perceived crowding strongly. In addition, estimated density
   was directly related to perceived crowding. This finding supports the
   results of past research that has suggested a positive relationship
   between actual density and perceived crowding. Among the independent
   variables, only perceived crowding influenced overall satisfaction
   significantly. Individuals' perception of crowding negatively influenced
   their overall satisfaction.},
