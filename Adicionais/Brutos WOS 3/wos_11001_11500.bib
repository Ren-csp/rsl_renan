@inproceedings{ WOS:000172972500002,
Author = {Scheff, P and Casten, C and Ruesch, P and Friedl, M},
Editor = {Fajzieva, D and Brebbie, CA},
Title = {Evaluation of toxic air pollutants in an urban neighborhood adjacent to
   a municipal waste landfill},
Booktitle = {ENVIRONMENTAL HEALTH RISK},
