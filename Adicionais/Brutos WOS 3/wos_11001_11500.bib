@inproceedings{ WOS:000318317900002,
Author = {de Matos, Margarida Gaspar and Gaspar, Tania and Ferreira, Mafalda and
   Aventura Social Team},
Editor = {Dan, C},
Title = {Keeping a focus on self-regulation and Competence when targeting at risk
   children and adolescents in a school-based setting},
Booktitle = {BEHAVIORAL, COGNITIVE AND PSYCHOLOGICAL SCIENCES},
Series = {International Proceedings of Economics Development and Research},
Year = {2011},
Volume = {23},
Pages = {10-14},
Note = {2nd International Conference on Behavioral, Cognitive and Psychological
   Sciences (BCPS 2011), MALDIVES, NOV 25-26, 2011},
Organization = {ISI Proceedings; IEDRC; EBSCO Informat Serv},
Abstract = {During three years the team carry on a set of universal and selective
   interventions in an institutional setting. The aim of the present study
   is to evaluate the effects of one of the interventions, a social and
   personal competence promotion program (SPCPP) ``Find your own style{''},
   that will be described, was designed by the authors and tailored to the
   institutional situation. The SPCPP was based in a classroom slot of time
   and was assisted by the regular school teacher. Besides the evaluation
   sessions prior and after the intervention, the program includes 12
   sessions where 5 themes were debated, role-played, monitored and aimed
   to be generalised through home work (interpersonal communication;
   self-talk; emotion management and regulation, social capital and
   interpersonal relationships and stress management and increasing
   savouring at leisure and at work). Active and participative methods were
   used. 96 children and 77 adolescents were included and followed an
   intervention design which included an evaluation prior and after the
   intervention, and a parallel ``attention group{''} in the case of
   adolescents. This study confirms that universal prevention programs
   (like the ``attention program{''} targeting at the whole educational
   community) are efficient increasing pro social behaviour, perception of
   happiness and perception of quality of life in children. However, aiming
   at more specific results, such as the decrease of disruption, more
   focused and intensive intervention's measures are necessary.},
