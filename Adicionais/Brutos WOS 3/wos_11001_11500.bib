Title = {The timing of learned eyelid responses depends on causality in the
   cerebellar-red-nucleus-motoneuron network},
Booktitle = {INTERNATIONAL CONFERENCE ON TIMING AND TIME PERCEPTION},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
Volume = {126},
Pages = {259-268},
Note = {International Conference on Timing and Time Perception, GREECE, MAR
   31-APR 03, 2014},
Abstract = {Although data collected from different types of experiments indicate
   that wide brain areas - including cerebral and cerebellar cortices, as
   well as basal ganglia - are involved in different aspects of timing and
   time perception, the information on the actual neural mechanisms
   supporting those timed behaviors is rather scarce. In particular, the
   cerebellar-interpositus/red-nucleusmotoneuron network has been reported
   as being involved in the dynamic control and timing of the eyelid
   kinematics. Here we present a meta-analysis revealing how the involved
   neural structures can change their activities during eyeblink
   conditioning. In this work, the close relation between the timing of
   learned responses and the causality in the network was verified. (C)
   2014 The Authors. Published by Elsevier Ltd.},
