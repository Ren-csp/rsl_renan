Title = {Water Governance and Transboundary Data Sharing in the Lower Mekong
   Region: A Case Study of Yali Hydropower Dam, Vietnam},
Booktitle = {GEOINFORMATICS FOR SPATIAL-INFRASTRUCTURE DEVELOPMENT IN EARTH AND
   ALLIED SCIENCES, GIS-IDEAS 2023},
