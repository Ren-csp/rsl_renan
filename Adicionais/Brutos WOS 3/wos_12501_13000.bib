@inproceedings{ WOS:000392421700511,
Author = {Landy, David and Linkenauger, Sally},
Editor = {Ohlsson, S and Catrambone, R},
Title = {Arithmetic Notation ... now in 3D!},
Booktitle = {COGNITION IN FLUX},
