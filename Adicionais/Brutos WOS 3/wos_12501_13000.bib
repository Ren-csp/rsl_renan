@article{ WOS:000178179000003,
Author = {Oullier, O and Bardy, BG and Stoffregen, TA and Bootsma, RJ},
Title = {Postural coordination in looking and tracking tasks},
Journal = {HUMAN MOVEMENT SCIENCE},
Year = {2002},
Volume = {21},
Number = {2},
Pages = {147-167},
Month = {JUL},
Note = {11th International Conference on Perception and Action, UNIV
   CONNECTICUT, STORRS, CONNECTICUT, JUN 24-30, 2001},
Abstract = {Participants stood in a moving room and looked at a target that was
   attached to the front wall of the room. They were instructed either to
   look at the target or to track it, that is, to move so as to maintain a
   constant distance between the target and their head. Previous research
   (e.g, Bardy, Oullier, Bootsma, \& Stoffregen, Journal of Experimental
   Psychology: Human Perception and Performance, 2002) has documented
   stable modes of coordination of the hip and ankle joints that emerge
   during the tracking task. In the present study our main goal was to
   determine the effects of task variation (tracking versus looking) on
   these postural coordination modes. Within trials, we varied the
   frequency of room motion between 0.10 and 0.75 Hz. The results revealed
   that in both the tracking and looking tasks, posture was characterized
   by the emergence of in-phase and anti-phase modes, although the modes
   were more prominent in the tracking task. For both tasks the
   coordination mode adopted depended on the frequency of motion of the
   moving room. Coupling between motion of the room and motion of the head
   was stronger in the tracking task than in the looking task. Overall, the
   dynamics of hip-ankle coordination were qualitatively similar during the
   looking and tracking tasks. This similarity has consequences for the
   development of a general theory of the visual regulation of stance. (C)
   2002 Elsevier Science B.V. All rights reserved.},
