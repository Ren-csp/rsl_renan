@inproceedings{ WOS:000438152500027,
Author = {Abbas, Hasriwiani Habo and Sakakibara, Masayuki and Arma, Lukmanul Hakim
   and Yanti, Iva Hardi},
Book-Group-Author = {IOP},
Title = {Socio-demographic characteristics of traditional gold smelters in
   Makassar, south Sulawesi, Indonesia},
Booktitle = {2ND TRANSDISCIPLINARY RESEARCH ON ENVIRONMENTAL PROBLEMS IN SOUTHEAST
   ASIA},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2017},
