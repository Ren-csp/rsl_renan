@article{ WOS:000269175500007,
Author = {Zhang, Ji-Quan and Liang, Jing-Dan and Liu, Xing-Peng and Tong, Zhi-Jun},
Title = {GIS-Based Risk Assessment of Ecological Disasters in Jilin Province,
   Northeast China},
Journal = {HUMAN AND ECOLOGICAL RISK ASSESSMENT},
