Title = {Case study of the cascading effects on critical infrastructure in Torbay
   coastal/pluvial flooding with climate change and 3D visualisation},
Journal = {JOURNAL OF HYDROINFORMATICS},
Year = {2020},
Volume = {22},
Number = {1, SI},
Pages = {77-92},
