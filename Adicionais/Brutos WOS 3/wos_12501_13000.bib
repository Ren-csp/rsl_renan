@inproceedings{ WOS:000225461801195,
Author = {Baek, K and Kim, DH and Sajda, P},
Book-Group-Author = {ieee},
Title = {Inferring direction of figure using a recurrent integrate-and-fire
   neural circuit},
Booktitle = {PROCEEDINGS OF THE 26TH ANNUAL INTERNATIONAL CONFERENCE OF THE IEEE
   ENGINEERING IN MEDICINE AND BIOLOGY SOCIETY, VOLS 1-7},
