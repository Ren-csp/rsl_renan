@inproceedings{ WOS:000258121900015,
Author = {Wilkie, Sonia and Stevens, Catherine and Dean, Roger},
Editor = {KronlandMartinet, R and Ystad, S and Jensen, K},
Title = {Psychoacoustic manipulation of the Sound-induced Illusory Flash},
Booktitle = {COMPUTER MUSIC MODELING AND RETRIEVAL: SENSE OF SOUNDS},
