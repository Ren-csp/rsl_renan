@inproceedings{ WOS:000250109200026,
Author = {Bobylev, N.},
Editor = {Linkov, I and Wenning, RJ and Kiker, GA},
Title = {Sustainability and vulnerability analysis of critical underground
   infrastructure},
Booktitle = {Managing Critical Infrastructure Risks: Decision Tools and Application
   for Port Security},
Series = {Nato Science for Peace and Security Series C - Environmental Security},
Year = {2007},
Pages = {445-469},
Note = {NATO Advanced Research Workshop on Management Tools for Port Security,
   Critical Infrastructure and Sustainability, Venice, ITALY, MAR, 2006},
Organization = {NATO},
Abstract = {The paper discusses sustainability and vulnerability issues related to
   critical underground infrastructure (CUI). CUI is defined on the basis
   of its provision of vital services for a community. Most CUI can be
   found in urban areas. This analysis is based on understanding the
   natural characteristics of underground space and the benefits and
   difficulties of its utilization. Sustainability analysis considers how
   CUI is sustainable itself and what its impact on the environment is.
   Similarly, vulnerability analysis breaks down external and internal
   threats to CUI, and CUI impact on vulnerability of the physical and
   functional environment. The multiple-criteria decision-making analytic
   hierarchy process is used for aggregation impacts and integral
   assessment of CUI. In conclusion, the importance of CUI planning is
   highlighted.},
