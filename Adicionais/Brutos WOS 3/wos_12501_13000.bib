@article{ WOS:000243200300005,
Author = {Padilla, Yolanda C. and Villalobos, Griselda},
Title = {Cultural responses to health among Mexican American women and their
   families},
Journal = {FAMILY \& COMMUNITY HEALTH},
Year = {2007},
Volume = {30},
Number = {1, S},
Pages = {S24-S33},
Month = {JAN-MAR},
Note = {CHPR 2006 Annual Conference, Univ Texas, Sch Nursing, Austin, TX, FEB09,
   2006},
Abstract = {Based on an in-depth analysis of current empirical research, this
   article presents a framework for understanding the cultural experience
   of the Mexican American population and presents implications for
   innovative health promotion practices with women and their families. The
   framework sheds fight on the complex ways in which individuals from this
   population integrate their cultural values in their everyday responses
   to health. Three patterns emerge: (a) cultural expectations and beliefs
   can be shared by and work complementarily in the family and the larger
   social context; (b) cultural beliefs can be a source of tension and
   stress as a result of pressures in the environment; and (c) cultural
   values can become less important than other concerns, such as problems
   related to access when dealing with the healthcare system.},
