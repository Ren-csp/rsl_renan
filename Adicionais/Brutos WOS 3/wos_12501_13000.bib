Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {In this paper, the authors creatively build the optimization criterion
   of the retail structure from both advanced and equilibrium dimensions.
   Combining an empirical research of 24 cities, it reveals the general
   development path of urban retail structure. The paper explores factors
   affecting the urban retail structure from both demand and supply
   perspectives. Then, the authors introduce foreign retailers into the
   mechanism as a moderator, aiming to analyze the internal mechanism of
   foreign retailers' effects on the retail structure. Based on the
   conclusions, the authors put forwards specific policy suggestions.},
