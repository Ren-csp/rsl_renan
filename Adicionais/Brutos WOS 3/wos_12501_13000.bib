Year = {2004},
Volume = {14},
Pages = {13-21},
Note = {12th International Conference on Modelling, Monitoring and Management of
   Air Pollution, Rhodes, GREECE, 2004},
Organization = {Wessex Inst Technol},
Abstract = {This paper presents a new application of the reduced order
   photo-chemical model (TAPOM-Lite) designed for calculating urban ozone
   levels for varying pollution scenarios. The model is adaptable for any
   urban region but has been specifically run for the Sharjah-Dubai
   metropolitan region for this paper. Motivation for the TAPOM-Lite model
   includes the need for rapid ozone calculations used in the optimization
   environment. The principal advance in this application is the
   demonstration of a coupled energy-environmental model for a large
   metropolitan region. The model has been adapted for the transportation
   sector of the economy, the principle polluting sector. We demonstrate
   that by setting bounds on secondary pollutants (O-3) and therefore
   implicitly on the precursor primary pollutants VOC and NOx, a prediction
   of fleet composition of automobiles can be determined that satisfies
   local demands at lowest cost.},
