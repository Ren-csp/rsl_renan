Pages = {221-258},
Note = {International Conference on Emotion and Organizational Life,
   Fontainebleau, FRANCE, 2008},
Abstract = {Interactions between customers and service providers are ubiquitous.
   Some of these encounters are routine, but many are characterized by
   conflict and intense emotions. This chapter introduces a new theory,
   service encounter needs theory (SENT) that aims to elucidate the
   mechanisms through which service encounter behaviors affect outcomes for
   customers and employees. Evidence is presented for the preeminence
   within these encounters of eight psychosocial needs, and propositions
   are advanced regarding likely antecedents to fulfillment and violation
   of these needs. Emotional experiences and displays are viewed as
   important consequences of need fulfillment and violation, as are
   numerous cognitive, behavioral, and health-related outcomes.},
