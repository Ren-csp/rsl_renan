Title = {DEVELOPMENT OF INNOVATIVE TRAITS OF UNIVERSITY STUDENTS DURING AN
   EDUCATIONAL PROCESS},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
