@article{ WOS:000250588600002,
Author = {Ericsson, Goran and Kindberg, Jonas and Bostedt, Goran},
Title = {Willingness to pay (WTP) for wolverine Gulo gulo conservation},
Journal = {WILDLIFE BIOLOGY},
Year = {2007},
