Author = {Wu Juanyu and Xu Jianxin},
Editor = {Kao, JCM and Sung, WP and Chen, R},
Title = {Visitor Experience in the River Corridor Greenway: A Study of Zengjiang
   River Greenway in Zengcheng, Guangzhou},
Booktitle = {FRONTIERS OF GREEN BUILDING, MATERIALS AND CIVIL ENGINEERING III, PTS
   1-3},
