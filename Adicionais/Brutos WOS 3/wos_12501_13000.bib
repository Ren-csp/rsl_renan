@inproceedings{ WOS:000270107401137,
Author = {Cheung, K. P. and Luk, C. L. P. and Wong, S. T. and Chung, S. L. and
   Hui, C. M. and Fung, K. S. and Leung, M. F.},
Editor = {Zhang, Q and Leung, M and Wang, XK and Liu, YJ and Mo, JH},
Title = {THE S3P2E4R4 SUSTAINABLE BIREATH APPROACH: BUILDING INTEGRATED RENEWABLE
   ENERGIES AND RESOURCES, OPTIMIZED AIR QUALITY TOTAL HARVEST APPROACH-AN
   ITS APPLICATION TO UPGRADE AN EXISTING RESIDENTIAL UNIT},
Booktitle = {FIFTH INTERNATIONAL WORKSHOP ON ENERGY AND ENVIRONMENT OF RESIDENTIAL
   BUILDINGS AND THIRD INTERNATIONAL CONFERENCE ON BUILT ENVIRONMENT AND
   PUBLIC HEALTH, VOL I AND II, PROCEEDINGS},
Year = {2009},
Pages = {2345-2353},
Note = {5th International Workshop on Energy and Environment of Residential
   Buildings/3rd International Conference on Built Environment and Public
   Health, Guilin, PEOPLES R CHINA, MAY 29-31, 2009},
Organization = {Hunan Univ; Univ Hong Kong; Tsinghua Univ},
Abstract = {Taking a positive response to climate change, the priority for building
   design is in the order: Safety, Health, Sustainability, adaptable
   comfort, for providing functional requirements of buildings.
   Taking this priority, this paper proposes THE S3P2E4R4 SUSTAINABLE
   BIREATH APPROACH: Building Integrated Renewable Energies and resources,
   optimized AIR quality Total Harvest APPROACH, with a proposed
   application to upgrade an existing residential unit.
   S3 stands for the three basic elements of sustainability, namely,
   environmental. (or ecological) sustainability economical sustainability,
   and cultural sustainability. {[}Ref. Definition of sustainable
   architecture http://www.arch.hku.hk/research/BEER/sustain.htm]
   P2 stands for Pollution Prevention, which preventing generation of
   air-born pollutants such as -carbon dioxide or waste heat from air
   conditioners, or from burning gas at home which causes serious local
   pollution.
   E4 stands for (a) Energy Efficiency, leading to promotion of use of
   electrical induction cooking facilities, use of energy efficient
   electrical appliances, efficiencies of using generated energies; and
   efficiencies of harvesting renewable energies by building design and
   operation {[}i.e. BIREATH approach]. E4 also stands for (b) Water
   Efficiency, (c) Material Efficiency, (d) Land Efficiency.
   R4 stands for Reduce, Reuse, Recycle, Regenerate {[}and recover], as
   used for long time by environmentalists, now used thoroughly for
   building design.
   In this approach, the building is also considered as a tool for
   harvesting as much as renewable energies and resources such as direct
   and indirect solar energy, wind, rain. Whatever part of the land
   involved, or parts of building involved, this approach will apply.
   This approach will yield very energy efficient and resourceful buildings
   with least possible pollutants, and optimized are quality, buildings
   which are truly sustainable.
   This concept in fact can be extended to urban design, city design,
   village design, and urban design and operation {[}i.e. The Sustainable
   S3P2E4R4 CIREATH approach - CITY Integrated Renewable resources and
   Energy, optimized Air quality, Total Harvest Approach This will include
   transportation reformation, etc.], to make urban areas, cities,
   villages, landscapes as tools tool for harvesting as much as renewable
   energies and resources.},
