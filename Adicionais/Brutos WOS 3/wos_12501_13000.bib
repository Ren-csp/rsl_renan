@inproceedings{ WOS:000073159500038,
Author = {De Vlieger, I},
Editor = {Sucharov, L and Bidini, G},
Title = {Influence of traffic conditions on fuel consumption and emissions -
   Brussels as a case study},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {413-423},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {In 1996 on-board measurements were performed on six passenger cars.
   These tests were executed in the centre of Bmssels under various traffic
   conditions. All vehicles were measured for both fuel consumption and CO2
   emissions. Two were also measured for CO, HC and NOx emissions. The
   chief emphasis was put on driving in the rush hour and smooth-flowing
   (on Sundays) traffic. The principal aim was to obtain realistic fuel
   consumption and exhaust emission values for Brussels. Secondly, to gain
   an insight into the relationship between consumption and emissions on
   the one hand and the process of traffic on the other. Furthermore, the
   measurement results have been used to upgrade an existing microscope
   traffic model with a fuel consumption module. In the process of
   designing an intersections and traffic control measures, energy and
   environmental aspects have to be taken into account if a more
   sustainable mobility is to be obtained.},
