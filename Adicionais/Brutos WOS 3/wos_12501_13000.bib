@article{ WOS:A1994PK20700015,
Author = {TORRIJOS, M and CERRO, RM and CAPDEVILLE, B and ZEGHAL, S and
   PAYRAUDEAU, M and LESOUEF, A},
Title = {SEQUENCING BATCH REACTOR - A TOOL FOR WASTE-WATER CHARACTERIZATION FOR
   THE IAWPRC MODEL},
Journal = {WATER SCIENCE AND TECHNOLOGY},
