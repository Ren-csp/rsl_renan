@article{ WOS:000079065400004,
Author = {Andersen, GJ and Saidpour, A and Braunstein, ML},
Title = {Effects of collimation on perceived layout in 3-D scenes},
Journal = {PERCEPTION},
Year = {1998},
Volume = {27},
Number = {11},
Pages = {1305-1315},
Note = {Conference on Depth Perception, UNIV SURREY, SURREY, ENGLAND, SEP, 1997},
Organization = {Appl Vis Assoc},
Abstract = {The effect of varying information for overall depth in a simulated 3-D
   scene on the perceived layout of objects in the scene was investigated
   in two experiments. Subjects were presented with displays simulating
   textured surfaces receded in depth, Pairs of markers were positioned at
   equal intervals within the scenes. The subject's task was to judge the
   depth between the intervals. Overall scene depth was varied by viewing
   through either a collimating lens or a glass disk. Judged depth for
   equal depth intervals decreased with increasing distance of the interval
   from the front of the scene. Judged depth was greater for collimated
   than for non-collimated viewing. Interestingly, collimated viewing
   resulted in a uniform rescaling of the perceived depth intervals.},
