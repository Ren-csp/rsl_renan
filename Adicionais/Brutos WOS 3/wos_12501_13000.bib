@inproceedings{ WOS:000223250200074,
Author = {Shafizadeh, K and Niemeier, DA},
Editor = {Wadhwa, LC},
Title = {Analysis of gross polluter cutpoints based on in-use vehicle inspection
   and maintenance test data in California},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
