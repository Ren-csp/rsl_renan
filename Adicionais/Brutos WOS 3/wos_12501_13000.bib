Title = {Building Resilient Cities: A Simulation-Based Scenario Assessment
   Methodology for the Integration of DRR and CCA in a Multi-Scale Design
   Perspective},
Booktitle = {7TH INTERNATIONAL CONFERENCE ON BUILDING RESILIENCE: USING SCIENTIFIC
