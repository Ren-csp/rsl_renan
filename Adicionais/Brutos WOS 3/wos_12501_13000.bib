Title = {The Local Knowledge of Food Plants used by Karo Ethnic in Semangat
   Gunung Village, North Sumatra, Indonesia},
Booktitle = {INTERNATIONAL SYMPOSIUM ON CURRENT PROGRESS IN MATHEMATICS AND SCIENCES
   2016 (ISCPMS 2016)},
