@inproceedings{ WOS:000085197300013,
Author = {Yu, TY and Liang, CH and Hwa, MY and Chang, LFW},
Editor = {Sucharov, LJ},
Title = {A selection of the scenarios of ozone pollution by using Principal
   Component Analysis},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {125-134},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {The primary objective of the monitoring data analysis described in this
   paper is to choose the statistically dominant scenarios of ozone
   pollution at southern Taiwan, Traditional multivariate statistical
   technique, unrotated principal component analysis (UPCA), was presented
   to be the screening tool for selecting the scenarios of ozone pollution.
   The specific features of selected scenarios for ozone pollution were
   learned from the contour analysis of spatial ozone profiles, the
   backward trajectories of monitoring stations and the statistical
   analysis of historical ozone data. To easily illustrate the physical
   meaning of spatial ozone profile and backward trajectories of measured
   stations, we utilized Kaiser's varimax rotation method to separate the
   southern Taiwan area into several homogenous subregions.
   Results revealed that the first four unrotated components and rotated
   components explained more than 70\%, 70.8\% of total variance,
   respectively. The score of the first unrotated principal component above
   7 is the screening sill for the scenarios of ozone pollution. The use of
   Kaiser's rotation method indicated that the first four isolated
   subregions contributed 33.9\%, 17.3\%, 12.1\% and 7.5\% of total
   variation in the data set. Based on the contour analysis of typical
   hourly ozone profiles, weak westerly sea breeze was the dominant factor
   to effect the production of high ozone event for most stations. Backward
   trajectories of different monitoring stations from the same subregion
   had the common characteristics in the meteorological flow patterns. With
   the lower occurrence rate of 1.37\%, the scenarios of ozone pollution
   accounted for 14.2\% of overall ozone station number days of exceeding
   legal value.},
