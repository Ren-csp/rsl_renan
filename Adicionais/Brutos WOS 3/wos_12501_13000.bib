@inproceedings{ WOS:000309320400037,
Author = {Yang Zhenzhi and Ma Lin},
Editor = {Jie, XW and Xu, EM and Zahra, SA},
Title = {Tourist Function Zone Planning and Spatial Management-A Case Study of
   Wenchuan Post-Earthquake Tourism Recovery and Reconstruction},
Booktitle = {ENVIRONMENT, LOW-CARBON AND STRATEGY},
Year = {2011},
Pages = {258-269},
Note = {International Conference on Strategic Management (ICSM 2011), Phuket,
   THAILAND, DEC 21-23, 2011},
Abstract = {In terms of its position, contents and administrative supervision,
   existing national planning system restricts regional development
   co-ordination and the possibility of fostering a competitive advantage
   by tourism planning. With 5.12 Wenchuan earthquake reconstruction as a
   case study, this paper explores how to construct tourism functional
   zones and give full play to the tourism industry's leading role in
   guiding industrial structure adjustment in the core region of rich
   tourism resources and rural and urban spatial form's upgrading. In the
   regions with tourism industry as the leading industry, examine tourism
   industry from strategic planning's height, coordinate the region's
   development, establish tourism functional zone's planning as the upper
   planning, coordinate urban and rural planning and land use planning, and
   build up spatial management system for harmonizing urban and rural
   development. Drawing support from tourism functional zone planning,
   confirm the urban and rural spatial layout and the land utilization
   modes with tourism as the leading industry, specifying the economy
   center, the urban system, the industry cluster and the infrastructure
   into specific areas, shaping core competitiveness for the zone.},
