Title = {Evaluating the assessment of the Portuguese national plan for climate
   change transports mitigation measures},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
