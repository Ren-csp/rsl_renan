@article{ WOS:000233446300007,
Author = {Luterek, JA and Orsillo, SM and Marx, BP},
Title = {An experimental examination of emotional experience, expression, and
   disclosure in women reporting a history of childhood sexual abuse},
Journal = {JOURNAL OF TRAUMATIC STRESS},
Year = {2005},
Volume = {18},
Number = {3},
Pages = {237-244},
Month = {JUN},
Note = {36th Annual Meeting of the
   Association-for-the-Advancement-of-Behavior-Therapy, Reno, NV, NOV, 2002},
Organization = {Assoc Advancement Behav Therapy},
Abstract = {Researchers have suggested that childhood sexual abuse (CSA) is a distal
   risk factor for the development of emotion regulation difficulties in
   adulthood. The present study examined 20 females with and without a
   history of CSA on the dimensions of subjective emotional experience
   (positive and negative activation), facial expressivity, and disclosure
   (positive and negative emotion words) in response to positively and
   negatively valenced film stimuli. The CSA group reported experiencing
   reduced positive activation while no group differences were found for
   negative activation. The CSA group disclosed fewer negative emotion
   words to express their experience and exhibited a trend towards less
   facial expressivity. The results are interpreted within the context of
   CSA survivors' emotional responding difficulties, and their implications
   are discussed.},
