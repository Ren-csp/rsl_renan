@inproceedings{ WOS:000290971900037,
Author = {Wang Yue-jian and Xu Hai-liang},
Editor = {Zhang, H and Yu, XX},
Title = {Ecological Security Assessment on Ecotypes Zones and Countermeasures of
   the Ecologic Restoration in Mamas River Basin over the past 30 Years},
Booktitle = {PROCEEDINGS OF SYMPOSIUM FROM CROSS-STRAIT ENVIRONMENT \& RESOURCES AND
   2ND REPRESENTATIVE CONFERENCE OF CHINESE ENVIRONMENTAL RESOURCES \&
   ECOLOGICAL CONSERVATION SOCIETY},
Year = {2010},
Pages = {209-217},
Note = {Symposium from Cross-Strait Environment and Resources/2nd Representative
   Conference of Chinese Environmental Resources and Ecological
   Conservation Society, Linyi City, PEOPLES R CHINA, JUL 06-08, 2010},
Organization = {Shandong Provincial Key Lab Soil \& Water Conservation \& Environm
   Protect; Linyi Normal Univ; Inst Geograph Sci \& Nat Resources Res;
   Chinese Soc Env Resources \& Ecolog Conservat},
Abstract = {There are different Ecological Zones in respect to the geographical area
   of arid zone river basin, Ecological Security Problem in different
   Ecological Zones of arid river basin are to be on the rise. Taking Mamas
   River Basin as an example, this paper developed an Eco-Security
   Evaluation indicator system for the four Ecological zones of the upper,
   middle and lower reaches of the river, and carried out evaluations of
   the Ecological Security from 1976 to 2006 accordingly with the support
   of GIS and other data. The result shows that, during the past 30 years,
   the Ecological Security of the mountainous regions in the upper reaches,
   the oasis agricultural regions in the middle and lower reaches, and the
   desert regions in the lower reaches partially decreased, especially the
   oasis agricultural regions in the middle and lower reaches where there
   was the minimum degree of security, while that in urban regions in the
   middle reaches increased. The Scological Security problems are becoming
   apparent in Mamas River Basin. To restore the Ecological Environment in
   the Manias River Basin, The author reported countermeasures that we
   should take water resources reasonably exploited as main handhold and
   the upper, middle and lower reaches of the River Basin should be
   comprehensively controlled.},
Publisher = {AUSSINO ACAD PUBL HOUSE},
Address = {PO BOX 893, MARRICKVILLE, NSW 2204 00000, AUSTRALIA},
Type = {Proceedings Paper},
Language = {English},
