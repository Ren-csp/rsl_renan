@inproceedings{ WOS:000168191200008,
Author = {Stabulnieks, J},
Editor = {Bulumac, E and Bendis, RA},
Title = {Converting a research institute to an innovation center},
Booktitle = {UTILIZING TECHNOLOGY TRANSFER TO DEVELOP SMALL AND MEDIUM ENTERPRISES},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SUB-SERIES 4, SCIENCE AND
   TECHNOLOGY POLICY},
Year = {2001},
Volume = {27},
Pages = {97-106},
Note = {NATO Advanced Research Workshop on Utilizing Technology Transfer to
   Develop Small and Medium Enterprises, SIMAIA, RUSSIA, APR 17-19, 2000},
Organization = {NATO, Sci Affairs Div},
Abstract = {Latvia is one of the three Baltic States that regained independence from
   the former Soviet Union in 1991. Latvia occupies 64,635 sq.km of land
   with total current population of 2,7 million. Over 65\% of Latvia's
   population resides in urban areas. Its capital, Riga, has over 839,670
   inhabitants. The main industrial branches are wood and food industry,
   textiles, mechanical and electrical machinery and equipment, chemical
   products, transit services for gas and oil transportation, etc. The
   first step in the creation of the innovation and SMEs support structures
   in Latvia was made by the Ministry of Education and Science in 1992,
   when the conception for the development of technological/innovation
   centers was accepted. The initiator to start the process of
   commercialization in science and conversion of former military research
   laboratories was the Department of Higher Education and Science of the
   Ministry of Education and Science. The reason for this was a dramatic
   decrease of the number of researchers approximately 5 times at the
   Institutes of the Academy of Sciences, Universities and Industrial
   Research Institutes due to decreased financing of research grants and
   lost military orders since 1991. According to the conception, the main
   goal of such structures as technological/innovation centers and
   science/technology parks is to fill the gap between the system of higher
   education and scientific institutions and industry, as well as to
   promote economic development by foundation of small and medium-sized
   enterprises (SMEs).},
