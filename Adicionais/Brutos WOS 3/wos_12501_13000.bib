Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {A RIDDLE, WRAPPED IN A MYSTERY, INSIDE AN ENIGMA ... OR JUST
   MULTIDIMENSIONAL? TESTING THE MULTIDIMENSIONAL STRUCTURE OF BOREDOM},
Booktitle = {NEW WAYS OF STUDYING EMOTIONS IN ORGANIZATIONS},
Series = {Research on Emotion in Organizations},
Year = {2015},
Volume = {11},
Pages = {139-172},
Note = {9th International Conference on Emotions and Worklife (Emonet),
   Philadelphia, PA, JUL 30-31, 2014},
Abstract = {The multidimensional structure of boredom poses unique measurement
   challenges related to scale length and statistical modeling. We
   systematically address these concerns in two studies. In Study 1, we use
   item response theory to shorten the 29-item Multidimensional State
   Boredom Scale (MSBS) (Fahlman et al., 2013). In Study 2, we use
   structural equation modeling to compare two theoretically consistent
   multidimensional structures of boredom (superordinate and multivariate)
   with the most commonly used, yet theoretically inconsistent, structure
   in boredom research (unidimensional parallel model). Our findings
   provide support for modeling boredom as multidimensional and demonstrate
   the impact of model selection on effect sizes and significance.},
