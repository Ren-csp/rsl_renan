Pages = {85-94},
Note = {7th Annual Conference on System of Care for Childrens Mental Health,
   TAMPA, FL, FEB 28-MAR 02, 1994},
Organization = {Res \& Training Ctr Childrens Mental Hlth; Univ S Florida; Florida Ment
   Inst, Training Res Serv},
Abstract = {Increased attention to the problems of children and youth with emotional
   or behavioral disorders (EBD) and their families has led to the planning
   and development of alternatives in how the children are served. Two such
   innovations have been the development of public systems of
   comprehensive, community-based care and individualized wraparound
   services. This study, part of a comprehensive needs assessment, was part
   of one community's attempt to provide community services to children and
   youth with EBD through the auspices of public agencies. In two separate
   surveys direct service providers and parents of children with EBD were
   asked for their input into how such services could best be developed and
   implemented. These surveys focused on existing barriers to providing
   services and specific service priorities for system development. Methods
   and results are presented. Implications for the local system and future
   research needs are discussed.},
