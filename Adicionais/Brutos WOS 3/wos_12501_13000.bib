@article{ WOS:000226646800005,
Author = {Wilkinson, WW and Roys, AC},
Title = {The components of sexual orientation, religiosity, and heterosexuals'
   impressions of gay men and lesbians},
Journal = {JOURNAL OF SOCIAL PSYCHOLOGY},
Year = {2005},
Volume = {145},
Number = {1},
Pages = {65-83},
Month = {FEB},
Note = {13th Annual Meeting of the American-Psychological-Society, TORONTO,
   CANADA, JUN, 2001},
Organization = {Amer Psychol Soc},
Abstract = {In 2 studies, the authors explored whether emphasizing the sexual
   behavior of gay men and lesbians influences heterosexuals' impressions
   of gay male and lesbian targets. In both studies, participants read
   short vignettes of heterosexual and gay male or lesbian targets that
   described their sexual histories using information restricted to only 1
   component of sexual orientation (emotion, behaviors, or fantasies). The
   results of Study 1 showed that participants rated a behavioral gay male
   target more negatively than they did the emotions and fantasy targets,
   and this difference was a function of participant religiosity. In Study
   2, participants rated the behavioral lesbian target more negatively than
   they did the emotions and fantasy targets; however, these differential
   ratings of the lesbian targets were not affected by participant
   religiosity.},
