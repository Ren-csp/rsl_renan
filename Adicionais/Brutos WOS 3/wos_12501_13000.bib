@inproceedings{ WOS:000310722000005,
Author = {Horowitz, Arthur J. and Stephens, Verlon C. and Elrick, Kent A. and
   Smith, James J.},
Editor = {Collins, AL and Golosov, V and Horowitz, AJ and Lu, X and Stone, M and Walling, DE and Zhang, XB},
Title = {Annual fluxes of sediment-associated trace/major elements, carbon,
   nutrients and sulfur from US coastal rivers},
Booktitle = {EROSION AND SEDIMENT YIELDS IN THE CHANGING ENVIRONMENT},
Series = {IAHS Publication},
