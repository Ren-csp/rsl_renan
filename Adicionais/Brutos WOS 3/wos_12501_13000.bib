@inproceedings{ WOS:000461876300002,
Author = {Mahler, Robert L. and Barber, Michael Ernest},
Editor = {Brebbia, CA and Boukalova, Z},
Title = {CHANGES IN PUBLIC PERCEPTIONS OF RIVER BASIN MANAGEMENT PRIORITY ISSUES
   OVER THE LAST 28 YEARS IN THE PACIFIC NORTHWEST, USA},
Booktitle = {RIVER BASIN MANAGEMENT IX},
