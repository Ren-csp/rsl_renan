@inproceedings{ WOS:000464997800017,
Author = {Lytaev, Sergey and Aleksandrov, Mikhail and Popovich, Tatjana and
   Lytaev, Mikhail},
Editor = {Ayaz, H and Mazur, L},
Title = {Auditory Evoked Potentials and PET-Scan: Early and Late Mechanisms of
   Selective Attention},
Booktitle = {ADVANCES IN NEUROERGONOMICS AND COGNITIVE ENGINEERING},
Series = {Advances in Intelligent Systems and Computing},
Year = {2019},
Volume = {775},
Pages = {169-178},
Note = {9th International Conference on Applied Human Factors and Ergonomics
   (AHFE) / International Conferences on Neuroergonomics, Cognitive
   Engineering, Cognitive Computing and Internet of Things, Orlando, FL,
   JUL 21-25, 2018},
Abstract = {Auditory evoked potentials (AEP) mapping in 19 unipolar points using the
   technique of extracting relevant signals from deviant ones were applied.
   To determine the brain functional status positron emission tomography
   (PET) scan with fluorodeoxyglucose was performed. Neuropsychological
   testing, the scale of mental status assessment, tests of ``frontal
   dysfunction battery{''} and ``drawing hours{''} were performed. 103
   patients with neurologic attention deficit disorder and 26 healthy
   persons were examined. The paper discusses the dynamics of the AEP
