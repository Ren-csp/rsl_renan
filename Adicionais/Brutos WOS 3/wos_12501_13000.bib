@inproceedings{ WOS:001693879700006,
Author = {Gonzalez, Albarran Diana},
Editor = {Leishman, D and Agid, S and Vlachokyriakos, V and Yee, J and Frauenberger, C and Hurtado, MD and Hansen, N and Strohmayer, A and Zyl, IV and Dearden, A and Talhouk, R and Gatehouse, C and Sciannamblo, M and Taylor, J and Botero, A and DelGaudio, C and Akama, Y and Clarke, R and Vines, J},
Title = {Corazonar: Weaving values into the heart of design research},
Booktitle = {PROCEEDINGS OF THE 17TH PARTICIPATORY DESIGN CONFERENCE, PDC 2022, VOL 2},
