Title = {SERVICE ENCOUNTER NEEDS THEORY: A DYADIC, PSYCHOSOCIAL APPROACH TO
   UNDERSTANDING SERVICE ENCOUNTERS},
Booktitle = {EMOTIONS AND ORGANIZATIONAL DYNAMISM},
Series = {Research on Emotion in Organizations},
Year = {2010},
