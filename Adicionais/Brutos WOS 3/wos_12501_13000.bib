@inproceedings{ WOS:000084315100053,
Author = {Jurin, RR},
Editor = {Abrams, R},
Title = {Do symbolic beliefs hinder responsible environmental behavior?},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {203-207},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {Environmental beliefs and how they relate to self reported environmental
   behaviors were investigated. A convenient student sample (N=110) was
   administered a 208 item instrument (Environmental Categorization
   Instrument) and then segmented into three groups by cluster analysis. A
   smaller sample (n=10) representative of the three cluster groups was
   then interviewed.
   Interviews indicated that belief and value structures were symbolic in
   nature and did not necessarily lead to actual behavior. The problem of
   ``symbolic environmentalism{''} may explain the lack of environmental
   action. A ``cognitive integrated system model{''} was developed from the
   literature and the results of this study to help illustrate this
   phenomenon. Environmental educators need to be aware that environmental
   awareness and environmental attitudes do not predispose people to act
   with responsible environmental behavior. Understanding how symbolic
   environmental beliefs can become barriers to responsible environmental
   behavior might be a first step in formulating new strategies to
   encourage responsible environmental behavior.},
