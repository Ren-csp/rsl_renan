Title = {Thermal comfort study of naturally ventilated office},
Booktitle = {9TH CONFERENCE ON INTERDISCIPLINARY PROBLEMS IN ENVIRONMENTAL PROTECTION
   AND ENGINEERING (EKO-DOK 2017)},
Series = {E3S Web of Conferences},
Year = {2017},
Volume = {17},
Note = {9th Conference on Interdisciplinary Problems in Environmental Protection
   and Engineering (EKO-DOK), Boguszow Gorce, POLAND, APR 23-25, 2017},
Abstract = {It is well known that people spend about 90\% of their lifetime in
   buildings where the indoor environment strongly influences their health
   and productivity. Therefore it is crucial to maintain proper internal
   conditions, and thus ensure comfort environment for building users. Due
   to the nature and complexity the thermal comfort is difficult to
   describe with physical parameters. However there is a number of
   available methods to assess the indoor conditions and define the comfort
   level - from simplified methods based on the measurement of basic
   parameters to complex approach - with the use of computational fluid
   dynamics engineering tools. The paper presents the outcome of the
   thermal comfort study for a naturally ventilated office located in
   Wroclaw (Poland). The chosen physical parameters has been registered in
   long-and short-term perspective, and later used for defining the
   boundary conditions and CFD model validation.},
