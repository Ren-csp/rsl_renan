@article{ WOS:000172012000092,
Author = {Kitase, M and Hatakeyama, S and Mizoguchi, T and Maeda, Y},
Title = {Regional characteristics of copper corrosion components in East Asia},
Journal = {WATER AIR AND SOIL POLLUTION},
Year = {2001},
Volume = {130},
Number = {1-4, 3},
Pages = {1463-1468},
Month = {AUG-SEP},
Note = {6th International Conference on Acidic Deposition, TSUKUBA, JAPAN, DEC
   10-16, 2000},
Abstract = {Copper plates were exposed under shelters at 13 sampling sites in East
   Asia and their corrosion was analyzed. The corrosion products were first
   dissolved in water and then oxalic acid. Sulfate, nitrate and chloride
   in the solutions were measured by ion chromatography. The amounts of the
   three anions significantly differed depending on the atmospheric
   environment at the sites. Sulfate was a major part of the anions at
   Chongqing and Shanghai in China. Especially, at the urban sites in
   Japan, nitrate remarkably changed with the seasons, and often became the
   large anionic component in the summer. The amounts of chloride at most
   sites were at higher concentration levels compared with those at the
   rural sites in Japan. The anions in the copper corrosion must mainly
   reflect the impact of acid deposition.},
