Title = {Children's participation in environmental planning},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {117-120},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {The Programme of Action of the 1992 Earth Summit presented a challenge
   to environmental education to acknowledge children's rights and to
   include children and youth in participatory processes for sustainable
   development. Many programs to implement these objectives have been
   initiated outside of North America, and together they offer a rich body
   of techniques that would enlarge the concept and practice of
   environmental education within NAAEE. This paper reviews three
   traditions within this international effort to involve children in
   environmental planning: the children's rights movement, the urban
   education movement, and child research in urban planning and geography.
   It discusses the different types of learning that each tradition
   emphasizes, but notes their common commitment to political awareness and
   to using and improving the constructed environment of the cities, towns,
   and farms communities that form the everyday settings of children's
   lives.},
