Note = {7th Euro-Asia Conference on Environment and CSR, Huang Shan, PEOPLES R
   CHINA, MAY 09-12, 2011},
Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {This paper aims to study specific influencing factors of precautionary
   saving in Chinese urban families by using the buffer-stock model.
   Through normative analyses and empirical study, the authors seek to
   definite various uncertainty factors and their influence strength. Based
   on literature review, we designed a family questionnaire and distributed
   among urban residents in Beijing. This paper does a multiple linear
   regression to test the impacts of uncertainty factors acting on
   precautionary saving, and use cluster analyses to observe the difference
   of uncertainty factors between families with obviously different
   backgrounds. This paper is a micro-study of saving behaviors. Its
   conclusions may be important role in making pointed political
   suggestions for expanding domestic demand in China.},
