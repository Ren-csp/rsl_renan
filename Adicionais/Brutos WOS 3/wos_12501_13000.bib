Note = {32nd Annual Meeting of the Cognitive-Science-Society, Portland, OR, AUG
   11-14, 2010},
Organization = {Cognit Sci Soc; Air Force Off Sci Res; Natl Sci Fdn; Air Force Res Lab;
   Off Naval Res; Inst Educ Sci; Robert J Glushko \& Pamela Samuelson Fdn},
Abstract = {Two experiments demonstrate the impact of the self-performed actions
   during the encoding phase on the amount of the learned information.
   People memorized more items if they had touched the stimuli during
   learning. The experiments differ from many of the classical studies
   testing embodiment of human memory in two main respects:
   First, the performed actions are completely unrelated to the essence of
   the learned stimuli, thus the results can not be explained by pure
   association-based facilitation. Second, the actions are performed during
   the encoding phase only, thus the results maybe directly linked to the
   nature of the encoded representations. The possible mechanisms that may
   underlie the observed influence are discussed shortly.},
Publisher = {COGNITIVE SCIENCE SOCIETY, INC},
