@inproceedings{ WOS:000080795800008,
Author = {Zhao, GY and Li, JL and Qi, YX},
Book-Group-Author = {INT RES \& TRAINING CTR EROS \& SEDIMENTAT
   INT RES \& TRAINING CTR EROS \& SEDIMENTAT},
Title = {Accelerated management pattern of heavy and coarse sediment region in
   the middle Yellow River Basin},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON COMPREHENSIVE WATERSHED
   MANAGEMENT (ISWM-'98)},
Year = {1998},
Pages = {63-68},
Note = {International Symposium on Comprehensive Watershed Management (ISWM-98),
   BEIJING, PEOPLES R CHINA, SEP 07-10, 1998},
Organization = {UNESCO; PWMTA; FAO, Netherlands},
Abstract = {Sediment load in the Yellow River mainly comes from the middle Yellow
   River Basin. Accelerated management on soil and water loss in this
   region is very important to reduce erosion, enhance economic development
   speed, and improve the living standard of local people. Based on the
   40-year practices on management of small watershed, summarizing the
   patterns of 806-watershed management, the scientific protecting measure
   system of soil and water conservation, suitable ecological economy
   development method, and management system with perfect construction, are
   presented in this paper. The implement of the system should combine with
   local natural and economic characteristics and meet the native
   construction needs in different development stages.
   The sediment load in the Yellow River mainly comes from the middle
   Yellow River Basin in which the local people live relatively poorly and
   the watershed management on soil and water loss puts into practice
   difficultly. Therefore, accelerating control on the middle Yellow River
   Basin is necessary to develop national economy in the Yellow River
   Basin. At the movement, the dominating and demonstrating 806 watersheds
   were mainly supported by national investment, except for the investment
   of local people, these management patterns provided many controlling
   models for the small watersheds to accelerate regional management. These
   questions, such as how to accelerate the management on the heavy and
   coarse sediment region, or which pattern adopted to implement the speedy
   controls on this region, are discussed in this paper. The standard to
   distinguish the management benefits should meet the national politics
   and economic development demands on the comprehensive controls of the
   small watersheds and should adapt to the regional nature and social
   economy, and also should not sacrifice the environmental quality. The
   speedy control pattern on the small comprehensive management should
   possess higher benefits in the heavy and coarse sediment region.},
Publisher = {PATENT DOCUMENTAT PUBLISHING HOUSE},
Address = {XUEYUANLUKOU BEISANHUAN XILU, BEIJING, PEOPLES R CHINA},
Type = {Proceedings Paper},
Language = {English},
ISBN = {7-80011-333-7},
