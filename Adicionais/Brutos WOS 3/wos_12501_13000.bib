Title = {Waste Water Impact Assessment of Shaida Tourist Complex},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY (ICEST 2010)},
Year = {2010},
Pages = {229-237},
Note = {International Conference on Environmental Science and Technology (ICEST
   2010), Bangkok, THAILAND, APR 23-25, 2010},
Organization = {IACSIT; Applied Chem Engn Soc; Environm Sci Soc},
Abstract = {Nowadays establishing a tourist complex in the proximity of fresh water
   resources has become one of the main challenges in urban communities and
   water supplying plants. Population growth and increase in pollutants can
   decrease the water quality especially in arid and semi arid regions like
   the Shaida tourist complex. Shaida tourist complex is built near
   Zayandehrood dam in Chahar Mahal and Bakhtiari province in West of Iran.
   Shaida was chosen as a case study because of Zayandehrood dam and river
   vulnerabilities. This study was carried out according to Iran DOE EIA
   procedures and national regulations. First of all, ambient environment
   quality was studied and Shaida plan was introduced. Then, the most
   important impacts on water resources were predicted and an impact
   analysis was done using Leopold matrix. And then mitigation techniques
   were suggested based on three scenarios in two different approaches:
   Environmental management system and hardware requirements. Finally the
   best treatment method was introduced by AHP method.},
