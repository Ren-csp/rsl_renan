Title = {Geological and geotechnical surveys on a silty-clay terrain for
   landfill, Abruzzo region, Italy},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOL 6},
Year = {2000},
Pages = {4287-4291},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {Some engineering geology aspects have been presented about one of the
   greatest landfill for urban waste materials located in Abruzzo region. A
   silty-clay sequence outcrops with monocline order and with a low layer
   inclination. Alluvional deposits are located along a local drainage line
   outside the landfill area. An embankment borders the discharge to the W
   which acting like a impermeable septum. Special geotechnical and
   laboratory investigations have been carried out, The slopes have been
   modified by cut up to a height of 45 in, and with a slope until 3/2.
   Inclinometric surveys have shown the absence of the deformation of the
   scarps, The final cutting of the slopes will be carried out before the
   beginning of the filling up.},
