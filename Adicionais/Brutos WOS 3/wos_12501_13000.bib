@article{ WOS:000260653400001,
Author = {Yip, Jonathan J. and Kelly, Anita E.},
Title = {EMOTIONAL EXPRESSION CAN LEAD TO INCREASED SELF-REPORTED NEUROTICISM},
Journal = {JOURNAL OF SOCIAL AND CLINICAL PSYCHOLOGY},
Year = {2008},
Volume = {27},
Number = {8},
Pages = {761-777},
Month = {OCT},
Note = {115th Annual Convention of the American-Psychological-Association, San
   Francisco, CA, AUG 17-20, 2007},
Organization = {Amer Psychol Assoc},
Abstract = {Undergraduates (N= 151) watched an upsetting film clip and then were
   randomly assigned to talk about either their (a) emotions about the clip
   or (b) previous clay to a confederate posing as a counseling psychology
   graduate student. The confederate then gave either (a) feedback that the
   participant was a stable person, (b) feedback that the participant was a
   sensitive person, or (c) no feedback. The participants who talked about
   their emotions, as compared with those who talked about their previous
   day, rated themselves as significantly more neurotic regardless of the
   feedback they received. The authors suggest that people may see
   themselves as more neurotic after sharing negative emotions with others
   because they observe their own emotional behaviors through the eyes of
   those others and thus judge themselves to be emotional people.},
