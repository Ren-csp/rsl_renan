@inproceedings{ WOS:000078443800097,
Author = {Aplin, P and Atkinson, PM and Curran, PJ},
Book-Group-Author = {ISRSE
   ISRSE},
Title = {Identifying missing field boundaries to increase the accuracy of
   per-field classification of fine spatial resolution satellite sensor
   imagery},
Booktitle = {27TH INTERNATIONAL SYMPOSIUM ON REMOTE SENSING OF ENVIRONMENT,
   PROCEEDINGS: INFORMATION FOR SUSTAINABILITY},
Year = {1998},
Pages = {399-402},
Note = {27th International Symposium on Remote Sensing of Environment, TROMSO,
   NORWAY, JUN 08-12, 1998},
Organization = {Norsk Romsenter (Norwegian Space Ctr); Miljoverndepartementet; CIESIN;
   USGS; NASA; NOAA; UNEP; ESA; EUMETSAT; Kongsberg Spacetec AS; Space
   Applicat Inst; Joint Res Ctr European commiss; Tromso Satellite Stn AS;
   Space Imaging EOSAT; Norwegian Minist Environm},
Abstract = {A method was developed to classify land cover on a per-parcel (herein
   termed per-field) basis and identify missing field boundaries in large
   fields of semi-natural land cover. Initially, a per-pixel classification
   resulted in misclassification due to within-field variability,
   particularly in urban areas. An urban texture filter was applied to
   reduce this variability and the filtered image was integrated with
   digital vector data to perform per-field classification. Several fields
   of semi-natural land cover were misclassified due to the absence of
   field boundaries in the vector data. To increase the accuracy a
   within-field texture filter was applied to generate values of local
   variance. The local variance of each field was then compared to the
   proportion of modal land cover as this identified missing field
   boundaries.},
