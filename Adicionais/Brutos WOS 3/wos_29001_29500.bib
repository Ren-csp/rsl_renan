Pages = {25-44},
Note = {Symposium on Gurwitschs Relevancy for Cognitive Science, Boca Raton, FL,
   SEP, 2002},
Abstract = {Gurwitsch's account of how we encounter others provides a corrective
   contrast to contemporary approaches to social cognition. His analysis is
   based on phenomenology, but also appeals to psychology and studies of
   pathology. As such, it shows how there can be phenomenological
   intervention in the cognitive sciences. This chapter relates Gurwitsch's
   analysis to contemporary discussions of theory of mind, primary
   intersubjectivity, and recent discoveries in neuroscience.},
