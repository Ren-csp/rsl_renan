Title = {Towards a Psychophysiological Investigation of Perceived Trustworthiness
   and Risk in Online Pharmacies: Results of a Pre-study},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE (NEUROIS RETREAT 2021)},
Series = {Lecture Notes in Information Systems and Organization},
