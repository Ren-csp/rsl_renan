@inproceedings{ WOS:000184993400019,
Author = {Vorwerg, C},
Editor = {Freksa, C and Brauer, W and Habel, C and Wender, KF},
Title = {Use of reference directions in spatial encoding},
Booktitle = {SPATIAL COGNITION III},
Series = {LECTURE NOTES IN ARTIFICIAL INTELLIGENCE},
Year = {2003},
Volume = {2685},
Pages = {321-347},
Note = {Spatial Cognition 2002 Meeting, EVANGEL AKAD, BAVARIA, GERMANY, MAY
   20-23, 2002},
Abstract = {Evidence is presented for the use of reference directions in verbal
   encoding and memory encoding. It is argued that reference directions (in
   linguistic spatial categorization as well as in memory encoding) are
   based on perceptually salient and distinguished orientations. A newly
   found spatial tilt effect for the sagittal in 3D visual space, that is
   reflected in different kinds of language processing, confirms a
   perceptual foundation of spatial language. It is proposed that direction
   is a qualitative attribute dimension, whose prototype values are not
   mean values or other characteristics of an empirical distribution but
   instead perceptually salient cognitive reference values. An account for
   angular bias effects in reporting location from memory is put forward
   and experimental results on the angular bias with and without physically
   present lines are presented.},
