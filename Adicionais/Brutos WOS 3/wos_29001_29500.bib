@inproceedings{ WOS:000342210800005,
Author = {Meloni, F. and Federici, S. and Mele, M. L.},
Book-Group-Author = {MEDIMOND},
Title = {Homophobia and Disability: Literature Review},
Booktitle = {16TH APPAC INTERNATIONAL CONFERENCE},
Year = {2014},
Pages = {31-35},
Note = {16th International Conference on
   Association-of-Psychology-and-Psychiatry-for-Adults-and-Childrens,
   Athens, GREECE, MAY 17-20, 2011},
Organization = {Assoc Psychol Psychiat Adults \& Childrens},
Abstract = {We conducted a literature review of 58 studies on homophobia and LGBT
   disabled people published between 1994 and 2013 that reported a complex
   and conflictual relationship among different cultures. These are the
   expression of three social communities: (i) the LGBT community, (ii) the
   disabled community, and (iii) the mainstream society (mainly identified
   as the heterosexual and able-bodied community). The condition of
   exclusion that both disabled and LGBT people endure is rooted in two
   socially shared myths: compulsory able-bodiedness and compulsory
   heterosexuality. Both of them are the basis of homophobic prejudice.
   However, in order to neutralize the socio-cultural barriers, responses
   produced by the two minority communities, i. e., the LGBT and disabled
   people, are often in conflict with each other making their spaces
   inhospitable to LGBT disabled people.},
