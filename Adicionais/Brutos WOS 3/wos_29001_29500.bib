@article{ WOS:000263610100008,
Author = {Miyata, Hiromitsu and Itakura, Shoji and Fujita, Kazuo},
Title = {Planning in Human Children (Homo sapiens) Assessed by Maze
   Problems on the Touch Screen},
Journal = {JOURNAL OF COMPARATIVE PSYCHOLOGY},
Year = {2009},
Volume = {123},
Number = {1},
Pages = {69-78},
Month = {FEB},
Note = {42nd Annual Meeting of the Zoological-Society-of-Israel, Rehovot,
   ISRAEL, JAN 01, 2006},
Organization = {Zool Soc Israel},
Abstract = {The authors examined how human children perform on maze tasks on the
   touch screen and whether the children plan the solution of the mazes. In
   Experiment 1, the authors exposed children around 3 years of age to a
   maze having an L-shaped line as a barrier that can be solved by moving
   an illustration of a dog (the target) to that of a bone (the goal) with
   their fingers. The participants successfully solved the maze by taking
   efficient routes more frequently than chance, although the authors found
   no evidence that a preview of the maze before starting to solve the task
   facilitated their performance. In Experiment 2, using a plus-shaped
   maze, the authors found that 3- and 4-year-old children plan and adjust
   their moves while solving the maze, with 4-year-olds showing more
   advanced and higher-level planning than 3-year-olds. Similarity of these
   results to what the authors previously found in pigeons tested in the
   same tasks may suggest an analogy for planning capacity in the
   behavioral level across taxa and developmental stages.},
