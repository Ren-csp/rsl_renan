@article{ WOS:000250510000028,
Author = {Li Xiaobai and Song Yiying},
Title = {First congenital prosopagnosia case reported in China},
Journal = {PROGRESS IN NATURAL SCIENCE},
Year = {2007},
Volume = {17},
Number = {SI},
Pages = {165-171},
Note = {1st Conference of Sino-Western Exchanges in Cognitive Neuroscience,
   Beijing, PEOPLES R CHINA, OCT 25-28, 2006},
Organization = {Minist Sci Technol; Minist Educ; Natl Nat Sci Fdn China; Beijing Naormal
   Univ; Siemens Ltd},
Abstract = {Congenital prosopagnosia (CP) refers to the deficiency in recognizing
   faces without reportable brain damage. In this study we reported a CP
   patient (X. L.), the first CP case reported in China, and tested her
   with a battery of face recognition and visual cognition tasks to explore
   what aspects of face processing are impaired in CP individuals. Our
   results show that X. L. possesses a normal ability to detect the
   presence of faces yet her ability to discriminate between individual
   faces is significantly impaired compared to normal controls. In
   contrast, her ability to detect nonface objects is greatly preserved,
   suggesting that she suffers from a selective deficiency in face
   recognition. Further face tests reveal that she has intact feature-based
   analysis ability while configural and holistic processing are both
   impaired. We further evaluate her general capacity of holistic
   processing, and the results showed that her impairment in holistic
   processing is not restricted to faces, but to a more general level.},
