@inproceedings{ WOS:000228655000002,
Author = {Gallagher, S},
Editor = {Embree, L},
Title = {Situational understanding: A Gurwitschian critique of theory of mind},
Booktitle = {Gurwitsch's Relevancy for Cognitive Science},
