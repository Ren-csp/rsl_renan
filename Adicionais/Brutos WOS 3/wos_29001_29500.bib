@article{ WOS:000266998900010,
Author = {Kozma, Robert and Freeman, Walter J.},
Title = {The KIV model of intentional dynamics and decision making},
Journal = {NEURAL NETWORKS},
Year = {2009},
Volume = {22},
Number = {3, SI},
Pages = {277-285},
Month = {APR},
Note = {Conference on Goal-Directed Neural Systems, Arlington, TX, OCT, 2006},
Organization = {Int Neural Network Soc, Texas SIG; Metroplex Inst Neural Dynam; Univ
   Texas},
Abstract = {Human cognition performs granulation of the seemingly homogeneous
   temporal sequences of perceptual experiences into meaningful and
   comprehensible chunks of fuzzy concepts and behaviors. These knowledge
   granules are stored and consequently accessed during action selection
   and decisions. A dynamical approach is presented here to interpret
   experimental findings using K (Katchalsky) models. In the K model,
   meaningful knowledge is repetitiously created and processed in the form
   of sequences of oscillatory patterns of neural activity distributed
   across space and time. These patterns are not rigid but flexible and
   intermittent; soon after they arise through phase transitions, they
   dissipate. Computational implementations demonstrate the operation of
   the model based on the principles of intentional brain dynamics. (C)
   2009 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
