@article{ WOS:000221438200002,
Author = {McTeague, LM and McNally, RJ and Litz, BT},
Title = {Prewar, war-zone, and postwar predictors of posttraumatic stress in
   female vietnam veteran health care providers},
Journal = {MILITARY PSYCHOLOGY},
Year = {2004},
Volume = {16},
Number = {2},
Pages = {99-114},
Note = {Annual Convention of the American-for-Advancement-of-Behavior-Theory,
   Toronto, CANADA, NOV, 1999},
Organization = {Amer Adv Behav Theory},
Abstract = {Using the National Vietnam Veterans Readjustment Study database, we
   explored predictors of current posttraumatic stress disorder (PTSD)
   symptom severity in 373 female Vietnam veteran health care providers. We
   derived war-zone stressor scales to encompass general contextual and
   specific occupational stressors. To assess the comparative impact of
   war-zone stressors, we included measures of prewar and postwar factors
   in a multivariate model. PTSD symptom severity was significantly related
   to war-zone deprivation, dilemmas for health care providers,
   purposelessness, and unit cohesion. In contrast, the war-zone stressors
   more clearly identifiable as criterion-A-level traumatic exposure were
   not directly related to outcome. Results support the clinical relevance
   of war-zone occupational stressors while emphasizing the predominance of
   postwar emotional support and life events in the expression of chronic
   PTSD symptoms among this population.},
