@article{ WOS:000240753500008,
Author = {Gutman, Julie and McDermut, Wilson and Miller, Ivan and Chelminski,
   Iwona and Zimmerman, Mark},
Title = {Personality pathology and its relation to couple functioning},
Journal = {JOURNAL OF CLINICAL PSYCHOLOGY},
Year = {2006},
Volume = {62},
Number = {10},
Pages = {1275-1289},
Month = {OCT},
Note = {Conference of the Clinical-Health-Psychology-Institute, Honolulu, HI,
   AUG, 2004},
Organization = {Clin Hlth Psychol Inst; Div 38 Hlth Psychol; Amer Pschol Assoc Educ
   Directorate; Tripler Army Med Ctr},
Abstract = {The study aimed at understanding the relationship between personality
   pathology and couple functioning, both in terms of general functioning
   and communication specifically, in a sample of 146 psychiatric
   outpatients. The results indicated that couple communication was best
   predicted by a combination of the symptoms within each of the three
   personality disorder clusters and the total number of personality
   disorder symptoms while general family functioning was best predicted by
   the total number of Axis I disorders. No demographic variables were
   found to be related to the level of couple functioning. Future research
   needs to focus on understanding what makes it difficult for people with
   personality disorder traits to function in relationships. (c) 2006 Wiley
   Periodicals, Inc.},
