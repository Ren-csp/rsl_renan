@article{ WOS:000265742300004,
Author = {Huang, Meikuan},
Title = {A Conceptual Framework of the Effects of Positive Affect and Affective
   Relationships on Group Knowledge Networks},
Journal = {SMALL GROUP RESEARCH},
Year = {2009},
Volume = {40},
Number = {3},
Pages = {323-346},
Month = {JUN},
Note = {3rd Annual Conference of the
   Interdisciplinary-Network-for-Group-Research, Kansas City, MO, JUL
   17-19, 2008},
Organization = {Interdisciplinary Network Grp Res},
Abstract = {A theoretical model integrating research in social psychology and group
   knowledge networks regarding the pervasive influence of affect on group
   transactive memory systems (TMSs) is presented. The proposed affective
   transactive memory (ATM) model extending TMS beyond its cognitive
   tradition provides a promising interdisciplinary theoretical base for
   future research. The role of positive affect (PA) in the three
   dimensions of TMS effectiveness-accuracy in expertise recognition,
   sharedness of knowledge, and member participation-are discussed.
   Propositions are presented regarding the effects of members' PA and
   affective relationships on member information retrieval and allocation,
   which is further explored as four attribute and relational effects in
   knowledge networks. Ways to further integrate affect into contemporary
   small group knowledge network theorizing and research are suggested.},
