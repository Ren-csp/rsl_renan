Title = {When Mood and Comparative Thinking Reduce Stereotype},
Booktitle = {PROCEEDINGS OF THE SECOND SUMMIT FORUM OF CHINA'S CULTURAL PSYCHOLOGY},
Year = {2016},
Pages = {87-92},
Note = {2nd Summit Forum of China's Cultural Psychology, Wuhan Univ, Wuhan,
   PEOPLES R CHINA, NOV 05-06, 2016},
Organization = {Wuhan Univ, Dept Psychol; Assoc Chinese Psychol, Chapter Social Psychol},
Abstract = {The purpose of the current study was to explore whether mood and
   comparative thinking have an interaction effect on wealth stereotype
   expression. Participants' mood was induced by music, and their
   comparative thinking were also manipulated followed by a stereotype
   evaluation task. The ANOVAs showed that mood and comparative thinking
   were important predictors of the wealth stereotype. There is interaction
   between mood and comparative thinking. In the positive mood condition,
   the wealth stereotype on competence evaluation was higher in the priming
   similarities thinking condition than in priming dissimilarities
   comparative thinking condition. The results provide a further
   understanding of the mechanism of the comparative thinking affects
   stereotype.},
