@inproceedings{ WOS:A1994BA95X00011,
Author = {DERRINGTON, AM and HENNING, GB},
Editor = {Bock, GR and Goode, JA},
Title = {IMPLICATIONS OF MOTION DETECTION FOR EARLY NONLINEARITIES},
Booktitle = {HIGHER-ORDER PROCESSING IN THE VISUAL SYSTEM},
Series = {CIBA FOUNDATION SYMPOSIA},
Year = {1994},
Volume = {184},
Pages = {211-220},
Note = {Symposium on Higher-Order Processing in the Visual System, CIBA FDN,
   LONDON, ENGLAND, OCT 19-21, 1993},
Organization = {CIBA FDN},
Abstract = {Analysis of motion may be accomplished using the spatiotemporal
   variations produced when a spatially varying luminance waveform moves
   across linear receptive fields. Moving contrast-modulated patterns which
   consist of coarse-scale spatial variations in the contrast of fine-scale
   luminance patterns cannot be analysed in this way. The human visual
   system can analyse the motion of contrast-modulated patterns and this
   suggests it may contain mechanisms that use nonlinear transformations.
   Non-linear transformation of contrast-modulated patterns would give rise
   to a component (a distortion product) that varies on the same spatial
   scale as the contrast variation; this can be analysed to extract motion.
   Is the nonlinearity simply an inherent part of the transduction process
   or is it a characteristic of a mechanism specialized for the analysis of
   the motion of such patterns? Comparisons of the spatial and temporal
   limitations of motion discrimination using luminance and
   contrast-modulated patterns suggest that the mechanisms which analyse
   the two types of patterns are different, although recent physiological
   evidence suggests that they may have common elements.},
