Year = {2004},
Pages = {1133-1143},
Note = {Conference of the Summer-Institute-in-Cognitive-Neuroscience, Lake
   Tahoe, CA, JUN, 2006},
Organization = {Summer Inst Cognit Neurosci},
Abstract = {This chapter summarizes our current thinking on the problem of
   consciousness. At the moment, the most promising empirical approach is
   to discover the neuronal correlate of consciousness (NCC) in the
   mammalian forebrain by electrophysiological means, in combination with
   interventionist molecular or pharmacological strategies. In this
   chapter, we set out this general strategy under 10 headings or working
   hypotheses. This framework offers a coherent scheme for explaining the
   NCC for sensory consciousness in terms of competing cellular assemblies.
   Most of the ideas we favor have been suggested before, but their
   combination is original.},
