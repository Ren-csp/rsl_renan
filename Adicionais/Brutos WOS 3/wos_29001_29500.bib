
@article{ WOS:000168933300026,
Author = {Bartolomeo, P and Chokron, S},
Title = {Unilateral neglect: The effect of competing stimuli on estimated line
   length},
Journal = {BRAIN AND COGNITION},
Year = {2001},
Volume = {46},
Number = {1-2},
Pages = {34-38},
Month = {JUN-JUL},
Note = {11th Annual Meeting on Theoretical and Experimental Neuropsychology,
   MONTREAL, CANADA, JUN 15-17, 2000},
Organization = {Univ Quebec, Montreal; Minist Rech, Sci \& Technol, Quebec; Med Res
   Council, Ottawa},
Abstract = {Normal subjects and patients with right hemisphere lesions with ol
   without signs of left unilateral neglect judged the length of a
   horizontal line presented on the left or on the right side of space. In
   half of the trials, the line was presented with a centrally located
   square or diamond, and subjects had to identify the central stimulus
   before performing the judgment of length. The presence of the central
   stimulus improved accuracy of performance in controls and in patients:
   without neglect; neglect patients, however, produced more
   overestimations of left-sided lines when these was presented with a
   central stimulus than when the lines occurred in isolation. This finding
   underlines the importance of attentional factors in length estimates
   performed by neglect patients in their neglected space. (C) 2001
   Academic Press},
