@inproceedings{ WOS:000333329600025,
Author = {Carr, Catherine and Shah, Sahil and Ashida, Go and McColgan, Thomas and
   Wagner, Hermann and Kuokkanen, Paula T. and Kempter, Richard and Koeppl,
   Christine},
Editor = {Moore, BCJ and Patterson, RD and Winter, IM and Carlyon, RP and Gockel, HE},
Title = {Maps of ITD in the Nucleus Laminaris of the Barn Owl},
Booktitle = {BASIC ASPECTS OF HEARING: PHYSIOLOGY AND PERCEPTION},
Series = {Advances in Experimental Medicine and Biology},
Year = {2013},
Volume = {787},
