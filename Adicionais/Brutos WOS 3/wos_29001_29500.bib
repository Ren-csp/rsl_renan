DOI = {10.1007/978-3-030-60073-0\_1},
ISSN = {2195-4968},
EISSN = {2195-4976},
ISBN = {978-3-030-60073-0; 978-3-030-60072-3},
Keywords = {Color; Aesthetics; Websites; fNIRS; Decision making; Neural measurements},
Keywords-Plus = {NEAR-INFRARED SPECTROSCOPY; ECONOMIC DECISION-MAKING; PREFRONTAL CORTEX;
   BRAIN; AESTHETICS; EMOTION; INHIBITION; PREFERENCE; NETWORKS; DYNAMICS},
