@inproceedings{ WOS:000333329600054,
Author = {Riecke, Lars and Micheyl, Christophe and Oxenham, Andrew J.},
Editor = {Moore, BCJ and Patterson, RD and Winter, IM and Carlyon, RP and Gockel, HE},
Title = {Illusory Auditory Continuity Despite Neural Evidence to the Contrary},
