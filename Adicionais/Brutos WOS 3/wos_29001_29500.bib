@article{ WOS:000184632900005,
Author = {Kroes, G and Veerman, JW and De Bruyn, EEJ},
Title = {Bias in parental reports? Maternal psychopathology and the reporting of
   problem behavior in clinic-referred children},
Journal = {EUROPEAN JOURNAL OF PSYCHOLOGICAL ASSESSMENT},
Year = {2003},
Volume = {19},
Number = {3},
Pages = {195-203},
Note = {6th Conference of the European-Association-of-Psychological-Assessment,
   AACHEN, GERMANY, 2001},
Organization = {European Assoc Psycholog Assoc},
Abstract = {In clinical practice, child psychologists' case formulations are often
   based on parental reports. In this study, we examined whether mothers
   reports of internalizing and externalizing behavior problems in their
   children might be biased by maternal psychopathology. The target child
   sample consisted of 68 boys aged 6-12 years who were receiving
   treatment. Mothers' reports were compared with the reports of both
   teachers and group care workers as criterion ratings. After controlling
   for variance shared with the independent raters, multiple regression
   analysis indicated substantial partial correlations between various
   types of maternal psychopathology and the reporting of internalizing
   child behavior problems. Only small to insignificant partial
   correlations were found in the case of externalizing behavior problems.
   This finding is consistent with the social attribution theory that
   predicts greater distortion when observing more ambiguous stimuli.},
Publisher = {HOGREFE PUBLISHING CORP},
Address = {361 NEWBURY ST, 5 FL, BOSTON, MA, UNITED STATES},
