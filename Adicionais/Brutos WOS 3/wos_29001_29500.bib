Month = {JUN},
Note = {1994 Annual Meeting of the National-Council-on-Family-Relations,
   MINNEAPOLIS, MN, NOV 08-13, 1994},
Organization = {Natl Council Family Relat},
Abstract = {Access to quality health care for victims of abuse is often limited by
   the attitudes of health care professionals. Data collected from female
   nursing students (n = 155) revealed that those students with more
   egalitarian sex-role beliefs and a greater sense of control over life
   events were more sympathetic to battered women than those students with
   more traditional sex-role attitudes and less perceived control. Sex-role
   egalitarianism was found to be the best predictor of attitudes toward
   victims of domestic violence. Implications for health care practitioners
   and policy makers are presented.},
