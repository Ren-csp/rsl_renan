@article{ WOS:000184935900002,
Author = {Tilton-Weaver, LC and Galambos, NL},
Title = {Adolescents' characteristics and parents' beliefs as predictors of
   parents' peer management behaviors},
Journal = {JOURNAL OF RESEARCH ON ADOLESCENCE},
Year = {2003},
Volume = {13},
Number = {3},
Pages = {269-300},
Note = {109th Annual Convention of the American-Psychological-Association, SAN
   FRANCISCO, CA, AUG 24-28, 2001},
Organization = {Amer Psychol Assoc},
Abstract = {This study examined parents' reported use of peer management behaviors
   (i.e., communicating preferences, communicating disapproval, supporting
   friendships, and information seeking) and linked these behaviors to (a)
   adolescents' self-reported psychosocial adjustment and friendships and
   (b) parents' beliefs about adolescents' peer relationships (i.e.,
   perceived efficacy in managing adolescents' friendships and concerns
   about adolescents' friendships). The participants were 269 parents (161
   mothers, 108 fathers) and their predominantly White adolescents in
   Grades 6 and 9 (N = 177). Results suggest that parents may be more apt
   to use some behaviors (e.g., communicating disapproval and information
   seeking) when there are indications that their adolescents are engaged
   in problem behaviors and have friends who are deviant. In addition,
   parents' concerns about their adolescents' friends mediate the
   relationship between adolescent problem behaviors and parents'
   communications of disapproval. Parents' peer management is promising as
   a route to understand further the nature of parent-peer linkages.},
