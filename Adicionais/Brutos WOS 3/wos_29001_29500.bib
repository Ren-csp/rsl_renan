@article{ WOS:000089068700002,
Author = {LaPlante, D and Ambady, N},
Title = {Multiple messages: Facial recognition advantage for compound expressions},
Journal = {JOURNAL OF NONVERBAL BEHAVIOR},
Year = {2000},
Volume = {24},
Number = {3},
Pages = {211-224},
Month = {FAL},
Note = {9th Annual Meeting of the American-Psychological-Society, WASHINGTON,
   D.C., MAY 23-26, 1997},
Organization = {Amer Psychol Soc},
Abstract = {The impact of singular (e.g. sadness alone) and compound (e.g. sadness
   and anger together) facial expressions on individuals' recognition of
   faces was investigated. In three studies, a face recognition paradigm
   was used as a measure of the proficiency with which participants
   processed compound and singular facial expressions. For both positive
   and negative facial expressions, participants displayed greater
   proficiency in processing compound expressions relative to singular
   expressions. Specifically, the accuracy with which faces displaying
   compound expressions were recognized was significantly higher than the
   accuracy with which faces displaying singular expressions were
   recognized. Possible explanations involving the familiarity,
   distinctiveness, and salience of the facial expressions are discussed.},
Publisher = {KLUWER ACADEMIC-HUMAN SCIENCES PRESS},
