@inproceedings{ WOS:000464894900021,
Author = {Li, Jin and Lu, Pin and Zheng, Hailin},
Editor = {Chu, H and Zhang, H},
Title = {Adaptive Thermal Comfort Model of Staff and Audience in Naturally
   Ventilated Mixed-Use Stadium of Guangzhou, China in Summer},
Booktitle = {WATER RESOURCES AND ECOLOGICAL CARRYING CAPACITY},
Year = {2018},
Pages = {140-155},
Note = {International Conference on Environmental and Water Resources
   Engineering (EWRE), SOUTH KOREA, OCT 12-14, 2018},
Organization = {Int Assoc Appl Sci \& Engn; Natl Cheng Kung Univ},
Abstract = {In the subtropical area, naturally ventilated mixed-use stadium, as a
   result of well adapting to the characteristic of hot-humidity climate
   and meeting the purpose of people's multi functional use, has become a
   hugely popular type of architecture in public buildings. Traditionally,
   sports events and some physical activities can be held in such
   buildings; nowadays, there has been a trend that it is used as a public
   hall where people can enjoy theatrical performances, watch movies, and
   have some meetings, as well as conducting regular office work in an
   annexe. Considering the fact that this type of naturally ventilated
   building cannot always provide fully comfortable condition for users,
   especially audience and office staff when only using the passive
   technology adjustment, and there is few research about this two sorts of
   users' thermal comfort in this kind of building at present, it is
   necessary to study their thermal comfort in naturally ventilated
   mixed-use stadium. Field survey was conducted in the naturally
   ventilated mixed-use stadiums in Guangzhou, China in summer 2017. The
   thermal parameters of indoor environment and the thermal sensation votes
   of audience \& office staff were collected by instruments and
   questionnaires respectively. This study applied the method of adaptive
   thermal model, an international research method specially designed for
   studying naturally ventilated buildings, established the adaptive
   thermal comfort models and obtained comfort ranges of staff \& audience
   in naturally ventilated mixed use stadium for the first time. Through
   comparison, the differences were analyzed between the models and comfort
   ranges of audience and office staff. The results of this study showed
   that at a same outdoor air temperature, the audience had higher neutral
   temperature than office staff the audience had lower thermal sensitivity
   than office staff the audience had a wider comfort range than office
   staff. This study can contribute to have a better understanding of the
   thermal comfort of office staff \& audience in the naturally ventilated
   mixed use stadium and serve as reference for the better passive design
   of the kind of building.},
