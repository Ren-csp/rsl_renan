@article{ WOS:000184477100012,
Author = {Zorzi, M and Mapelli, D and Rusconi, E and Umiltà, C},
Title = {Automatic spatial coding of perceived gaze direction is revealed by the
   Simon effect},
Journal = {PSYCHONOMIC BULLETIN \& REVIEW},
Year = {2003},
Volume = {10},
Number = {2},
Pages = {423-429},
Month = {JUN},
Note = {7th Annual Meeting of the Cognitive-Neuroscience-Society, SAN FRANCISCO,
   CA, APR, 2000},
Organization = {Cognit Neurosci Soc},
Abstract = {In a typical Simon task, the (irrelevant) spatial position of the
   stimulus interferes with the processing of the salient characteristic
   (e.g., color). We used the Simon effect to investigate the automatic
   processing of gaze cues. We show that a simple drawing of schematic eyes
   automatically generates a spatially defined code of gaze direction.
   Although completely irrelevant to the task, direction of gaze influenced
   reaction times in a spatially selective two-choice discrimination based
   on eye color. Moreover, in one experiment employing an orthogonal
   manipulation of stimulus position and gaze direction, we found that
   coding of gaze direction is independent of stimulus spatial coding. Our
   finding of a ``gaze-direction Simon effect{''} is congruent with the
   hypothesis that gaze direction is coded by a specialized mechanism.},
