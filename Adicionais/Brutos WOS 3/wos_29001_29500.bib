@inproceedings{ WOS:001719970900005,
Author = {Alinaghi, Negar and Kattenbeck, Markus and Golab, Antonia and
   Giannopoulos, Ioannis},
Editor = {Janowicz, K and Verstegen, JA},
Title = {Will You Take This Turn? Gaze-Based Turning Activity Recognition During
   Navigation},
Booktitle = {11TH INTERNATIONAL CONFERENCE ON GEOGRAPHIC INFORMATION SCIENCE,
   GISCIENCE 2021 - PT II},
Series = {Leibniz International Proceedings in Informatics},
Year = {2021},
Volume = {208},
Note = {11th International Conference on Geographic Information
   Science-GIScience, Poznan, POLAND, SEP 27-30, 2021},
Organization = {RMIT University (RMITU)},
Abstract = {Decision making is an integral part of wayfinding and people
   progressively use navigation systems to facilitate this task. The
   primary decision, which is also the main source of navigation error, is
   about the turning activity, i.e., to decide either to turn left or right
   or continue straight forward. The fundamental step to deal with this
   error, before applying any preventive approaches, e.g., providing more
   information, or any compensatory solutions, e.g., pre-calculating
   alternative routes, could be to predict and recognize the potential
   turning activity. This paper aims to address this step by predicting the
   turning decision of pedestrian wayfinders, before the actual action
   takes place, using primarily gaze-based features. Applying Machine
   Learning methods, the results of the presented experiment demonstrate an
   overall accuracy of 91\% within three seconds before arriving at a
   decision point. Beyond the application perspective, our findings also
   shed light on the cognitive processes of decision making as reflected by
   the wayfinder's gaze behaviour: incorporating environmental and
   user-related factors to the model, results in a noticeable change with
   respect to the importance of visual search features in turn activity
   recognition.},
Publisher = {SCHLOSS DAGSTUHL,  LEIBNIZ CENTER INFORMATICS},
