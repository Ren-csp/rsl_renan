@article{ WOS:000258678500002,
Author = {Penner, Louis A. and Cline, Rebecca J. W. and Albrecht, Terrance L. and
   Harper, Felicity W. K. and Peterson, Amy M. and Taub, Jeffrey M. and
   Ruckdeschel, John C.},
Title = {Parents' empathic responses and pain and distress in pediatric patients},
Journal = {BASIC AND APPLIED SOCIAL PSYCHOLOGY},
Year = {2008},
Volume = {30},
Number = {2},
Pages = {102-113},
Note = {27th Annual Meeting of the Society-of-Behavioral-Medicine, San
   Francisco, CA, MAR 22-25, 2006},
Organization = {Soc Behav Med},
Abstract = {We investigated the relationship between parents' empathic responses
   prior to their children undergoing cancer treatment procedures and
   children's pain/distress during the procedures. We hypothesized: (1)
   parents' empathic distress would be positively associated with
   children's pain/distress, (2) parents' empathic concern would be
   negatively associated with children's pain/distress; and (3) parents'
   enduring dispositions and social support would be associated with their
   empathic responses. Parents completed: (1) measures of dispositions and
   perceived social support several weeks before their children underwent
   the procedures, and (2) state measures of empathic distress and empathic
   concern just before the procedures. Empathic distress was positively
   associated with children's pain; empathic concern was negatively
   associated with children's pain/distress. Predictions about dispositions
   and social support were also substantially confirmed.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
