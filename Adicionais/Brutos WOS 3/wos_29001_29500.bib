@article{ WOS:000503451800012,
Author = {Yudkin, Daniel A. and Van Bavel, Jay J. and Rhodes, Marjorie},
Title = {Young Children Police Group Members at Personal Cost},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-GENERAL},
Year = {2020},
Volume = {149},
Number = {1},
Pages = {182-191},
Month = {JAN},
Note = {Annual Convention of the Society-for-Personality-and-Social-Psychology
   (SPSP), Atlanta, GA, MAR 01-03, 2018},
Organization = {Soc Personal \& Social Psychol},
Abstract = {Humans' evolutionary success has depended in part on their willingness
   to punish, at personal cost, bad actors who have not harmed them
   directly-a behavior known as costly third-party punishment. The present
   studies examined the psychological processes underlying this behavior
   from a developmental perspective, using a novel, naturalistic method. In
   these studies (ages 3-6, total N = 225), participants of all ages
   enacted costly punishment, and rates of punishment increased with age.
   In addition, younger children (ages 3-4), when in a position of
   authority, were more likely to punish members of their own group,
   whereas older children (ages 5-6) showed no group- or authority-based
   differences. These findings demonstrate the developmental emergence of
   costly punishment, and show how a sense of authority can foster the kind
   of group-regulatory behavior that costly punishment may have evolved to
   serve.},
