@article{ WOS:000256775400011,
Author = {Belmonte, Matthew K.},
Title = {Does the experimental scientist have a ``Theory of Mind{''}?},
Journal = {REVIEW OF GENERAL PSYCHOLOGY},
Year = {2008},
