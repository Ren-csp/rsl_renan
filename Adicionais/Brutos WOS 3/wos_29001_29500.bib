Title = {Language comprehension and dominant hand motion simulation},
Journal = {HUMAN MOVEMENT SCIENCE},
Year = {2009},
Volume = {28},
Number = {1},
Pages = {12-27},
Month = {FEB},
Note = {Annual Meeting of the Society-for-Text-and-Discourse, Amsterdam,
   NETHERLANDS, JUL, 2005},
Organization = {Soc Text \& Discourse},
Abstract = {In five experiments participants were presented with pairs of nouns and
   verbs. They were asked to decide whether the combinations made sense or
   not. Half of the participants responded ``yes{''} with the dominant
   hand, half with the left hand. When pairs referred to manual and mouth
   actions, participants responded faster with the dominant than with the
   left hand with sensible sentences. When pairs referred to manual and
   foot actions the result was opposite. Results suggest that language
   processing activates an action simulation that is sensitive to both the
   effector involved and the goal expressed by the sentence. (C) 2008
   Elsevier B.V. All rights reserved.},
