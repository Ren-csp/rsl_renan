Organization = {Wellcome Trust; USAF Off Sci Res; USN Off Res},
Abstract = {There is growing evidence for a number of parallel systems transforming
   visual inputs into action coordinates, as well as several transforming
   inputs into percepts. Moreover, the perceptual system is itself
   implicated in several aspects of visuomotor guidance. This multiplicity
   of routes participating in visuomotor control raises various questions
   of integration and coordination.},
