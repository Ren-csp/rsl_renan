@article{ WOS:000249045700005,
Author = {Rivera, Lourdes M. and Chen, Eric C. and Flores, Lisa Y. and Blumberg,
   Fran and Ponterotto, Joseph G.},
Title = {The effects of perceived barriers, role models, and acculturation on the
   career self-efficacy and career consideration of Hispanic women},
Journal = {CAREER DEVELOPMENT QUARTERLY},
Year = {2007},
Volume = {56},
Number = {1},
Pages = {47-61},
Month = {SEP},
Note = {109th Annual Convention of the American-Psychological-Association, SAN
   FRANCISCO, CA, AUG 24-28, 2001},
Organization = {Amer Psychol Assoc},
Abstract = {This study used path analysis to examine the relationship between
   perceived barriers, acculturation, and role model influence on the
   career self-efficacy and career considerations of a sample of Hispanic
   women. Two path models were examined. The male-dominated model accounted
   for 15\% of the variance, and the female-dominated model accounted for
   26\% of the variance. No relationship was found between the variables of
   interest and male-dominated career self-efficacy and consideration.
   However, perceived barriers were related to female-dominated career
   consideration and Anglo acculturation significantly contributed to
   female-dominated career self-efficacy. Results are discussed with regard
   to career practice and research with Hispanic women.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
