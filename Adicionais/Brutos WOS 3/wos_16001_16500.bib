   Indiana Univ, Sch Med, Dept Otolaryngol Head \& Neck Surg, Indianapolis, IN 46032 USA.},
DOI = {10.1016/j.ics.2004.07.046},
ISSN = {0531-5131},
ISBN = {0-444-51848-7},
Keywords = {children; hearing loss; speech perception; cochlear implant},
