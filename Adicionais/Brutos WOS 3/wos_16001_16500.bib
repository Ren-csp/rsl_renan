@inproceedings{ WOS:000392421700418,
Author = {Perfors, Amy and Dunbar, David},
Editor = {Ohlsson, S and Catrambone, R},
Title = {Phonetic training makes word learning easier},
Booktitle = {COGNITION IN FLUX},
Year = {2010},
Pages = {1613-1618},
Note = {32nd Annual Meeting of the Cognitive-Science-Society, Portland, OR, AUG
   11-14, 2010},
Organization = {Cognit Sci Soc; Air Force Off Sci Res; Natl Sci Fdn; Air Force Res Lab;
   Off Naval Res; Inst Educ Sci; Robert J Glushko \& Pamela Samuelson Fdn},
Abstract = {Motivated by the idea that differences between adult and child language
   learners may stem in part from initially minor differences (such as in
   phonetic perception) that cascade throughout other aspects of language
   learning, we explored to what extent training adults on a novel phonetic
   contrast results in improved learning of words that incorporate that
   contrast. Results indicate that distributional training on a novel
   phonetic contrast improves word learning as well as the ability to
   discriminate a related contrast. We discuss implications for how adults'
   phonological abilities in affect other aspects of language learning, and
   also for understanding the effectiveness of different phonetic training
   regimes.},
