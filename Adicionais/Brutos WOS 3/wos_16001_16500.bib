@inproceedings{ WOS:A1996BG68Z00004,
Author = {Roozendaal, B and Cahill, L and McGaugh, JL},
Editor = {Ishikawa, K and McGaugh, JL and Sakata, H},
Title = {Interaction of emotionally activated neuromodulatory systems in
   regulating memory storage},
Booktitle = {BRAIN PROCESSES AND MEMORY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1996},
Volume = {1108},
Pages = {39-54},
Note = {16th Nihon International Symposium on Brain Processes and Memory, TOKYO,
   JAPAN, NOV 29-DEC 02, 1995},
Abstract = {It is well established that emotional arousal can enhance memory
   storage. This chapter summarizes evidence from animal and human research
   indicating that hormones of the adrenal-medulla and adrenal-cortex are
   involved in modulating memory storage, and that the effects of both
   hormones are mediated by an activation of central beta-adrenergic
   mechanisms and the amygdaloid complex (basolateral nucleus). Epinephrine
   and glucocorticoids interact in their effects on modulating memory
   storage, making use of the same brain mechanisms. Furthermore, evidence
   is provided that the amygdala is not a site of memory storage, but that
   the role of the amygdala in memory storage is to influence memory
   processes in other brain structures such as the hippocampus and
   striatum.},
