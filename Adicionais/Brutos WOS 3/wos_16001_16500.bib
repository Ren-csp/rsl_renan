Title = {Correlation of psychosocial variables in adolescents with epilepsy and
   healthy controls},
Booktitle = {3RD EUROPEAN CONGRESS OF EPILEPTOLOGY},
Year = {1998},
Pages = {437-440},
Note = {3rd European Congress of Epileptology, WARSAW, POLAND, MAY 24-28, 1998},
Organization = {Int League Against Epilepsy},
Abstract = {Epilepsy is a chronic illness with important effects on adolescent
   development. The purpose of this study is to compare correlation of
   standardized, objective psychosocial measures based on theoretical
   framework of Jessor's Problem-Behavior Theory, in two closely matched
   groups of 196 adolescents (96 with active epilepsy and 96 healthy
   controls) attending regular secondary schools. The results suggest
   different relationships between psychosocial measures in both groups.
   The most indicated differences were found in relations between perceived
   environment and personality system. In adolescents with epilepsy the
   personality system is more often related to perception of the
   environment, particularly perception of relation with peers.},
