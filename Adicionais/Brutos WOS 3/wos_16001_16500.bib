Pages = {44+},
Note = {1st International Conference on Energy and Environmental Protection
   (ICEEP 2012), Hohhot, PEOPLES R CHINA, JUN 23-24, 2012},
Organization = {Inner Mongolia Univ},
Abstract = {Chromium(VI) is hazardous to environment. It can be efficiently removed
   by chromate resistant bacterial consortium. In this study five bacterial
   strains were isolated and cultured in liquid media containing Cr(VI)
   ions. The result shows that they grew better after cultureing 24h than
   48h and 72h. In the assay removing Cr(VI) by these strain, all of them
   presented excelletnt bioaccumulation abilities. When inital Cr(VI) ions
   concentration was 650mg/l, strain 2-7 displayed a best removal potential
   of 85.8\% removal and 24.83 mg/g.h(-1) uptake rate. However, it seemed
   that the resisitance and the removal potential of heavy metal had no
   direct connnection.},
