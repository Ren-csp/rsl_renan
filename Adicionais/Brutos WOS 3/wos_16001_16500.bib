@inproceedings{ WOS:000179444800080,
Author = {Lachhwani, V and Sharma, R},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Cultural and physical implications on housing: A study of rural habitat},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {631-638},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {To create a place to live, to interact with the environment while doing
   so and to give practical expression to their creative urges have been
   the most important of all human activities. The manifest form of a
   habitat expresses these ideas very well and can be related to cultural
   values and aspirations of the people. In spite of resource constraints
   and environmental harshness, people do build beautiful places. Even in
   situations where meagerness is reality and frugality the philosophy,
   several lessons can be learnt about a community's relationship with
   architecture. Resourcefulness, skill and the will to survive have
   produced some of the most habitable spaces in the world.
   The culture and context become the generative forces in the creation of
   a habitat. While the culture is the sum total of human understanding,
   values and accomplishments, `context' represents the constraints and
   potentials that a physical environment has to offer. A traditional
   habitat today is not a result of a one-time effort but is culmination of
   hundreds of years of understanding and response to a particular context.
   This articulation and crystallization is the result of the negotiation
   between man and nature, between individual and the collective, between
   myth and science, between sacred and the secular.
   The paper tries to analyze two such vernacular habitats across the
   breadth of India, the first in Rajasthan (the westernmost state) and the
   other in Bengal (in Eastern India). The intention here is to present a
   study where both physical and socio-cultural forces have shaped
   habitats. Though, the two cases have entirely different climatic and
   socio-cultural environment, both reveal an understanding of the
   ecological and socio-cultural requirements that have crystallized into
   built forms with centuries of experience.},
