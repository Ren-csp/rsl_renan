@article{ WOS:000348917400016,
Author = {Lei, Xiaoning and Lu, Jianjiang and Liu, Zilong and Tong, Yanbin and Li,
   Shanman},
Title = {Concentration and distribution of antibiotics in water-sediment system
   of Bosten Lake, Xinjiang},
Journal = {ENVIRONMENTAL SCIENCE AND POLLUTION RESEARCH},
