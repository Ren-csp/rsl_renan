@inproceedings{ WOS:000073221600046,
Author = {El Arabi, NE},
Editor = {Chilton, J},
Title = {Environmental impact of new settlements in Egypt},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {285-290},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Egypt is faced with a continuous increase in population in limited urban
   areas confined to the banks of the Nile; the developed area of the
   country represents about 11\% of its total physical area. As a result of
   the increase in population, a considerable part of the agricultural land
   has been urbanized. Government policy in the last two decades has
   concentrated on the extension of agricultural land into reclaimed desert
   areas and the redistribution of population, starting at the peripheries
   of existing cities.
   A number of new settlements have been established, accompanied by the
   initiation of industrial and agricultural activities. Two of the
   problems facing the new settlements are sustainable water supply and
   wastewater disposal. In these new areas, groundwater is the main source
   of water supply. Sewage water is disposed of into unlined oxidation
   ponds or used directly for irrigation.
   This paper discusses the hydrogeological conditions in one of the first
   new settlements, the Tenth of Ramadan city, and the problems facing the
   sustainability of the water supply. The Tenth of Ramadan area is ranked
   as a high pollution risk area, due to the high infiltration rare of the
   existing oxidation ponds and the wastewater based-irrigation in the
   reclaimed desert. The infiltration of polluted wastewater to the aquifer
   and consequently the migration of pollutants are simulated with the help
   of a numerical model. Calculations indicate that the well field might be
   affected by pollutants in forthcoming years. Mitigation actions are
   proposed.},
Publisher = {A A BALKEMA PUBLISHERS},
