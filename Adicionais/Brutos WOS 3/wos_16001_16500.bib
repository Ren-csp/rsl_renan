Organization = {University of Salento},
Abstract = {This paper will analyze the environmental impacts of the NEOM project in
   Saudi Arabia, with a particular focus on desertification and its
   implications for human geography and culture in the region. The
   discussion will examine the environmental dynamics that characterize the
   Saudi desert and investigate the climate change mitigation strategies
   adopted in the context of the project. Furthermore, the role of human
   geography and culture in shaping and adapting to these environmental
   challenges will be explored, identifying opportunities and obstacles
   arising from this intersection. The objective of the presentation is to
   contribute to the understanding of the complex interaction between
   environment, society and culture in desert contexts such as Saudi
   Arabia, providing insights for future research and intervention
   strategies.},
