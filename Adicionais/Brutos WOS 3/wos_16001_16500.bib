   Sergey and Khakunova, Fatimet and Bersirova, Asya and Dalgatov, Magomed},
Editor = {Rudoy, D and Olshevskaya, A and Kankhva, V},
Title = {Psychological characteristics of ethnic groups in the South of Russia,
   diagnosed using the hand test},
