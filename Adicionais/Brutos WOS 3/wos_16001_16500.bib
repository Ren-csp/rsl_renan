@inproceedings{ WOS:000233831200011,
Author = {Hutter, HP and Moshammer, H and Wallner, P and Kundi, M},
Editor = {Yang, X and Zhao, B and Zhao, R},
Title = {Health complaints after moving into a new office building: Results of an
   eighteen months follow-up study},
Booktitle = {INDOOR AIR 2005: PROCEEDINGS OF THE 10TH INTERNATIONAL CONFERENCE ON
   INDOOR AIR QUALITY AND CLIMATE, VOLS 1-5},
Year = {2005},
Pages = {11-14},
Note = {10th International Conference on Indoor Air Quality and Climate (Indoor
   Air 2005), Beijing, PEOPLES R CHINA, SEP 04-09, 2005},
Organization = {Tsinghua Univ; Minist Educ China; Natl Nat Sci Fdn China; Beijing
   Municipal Commiss Sci \& Technol; Shanghai Municipal Commiss Sci \&
   Technol; US EPA; Amer Ind Hyg Assoc; Amer Soc Heating, Refrigerating \&
   Air Conditioning Engineers; Int Commiss Occupat Hlth, SC Indoor Air Qual
   \& Hlth; Int Council Res \& Innovat Bldg \& Construct; European Commiss
   Asia Pro Eco Programme Promot Sustainable Solut Environm Europe \& Asia;
   Korean Soc Indoor Environm; Soc Indoor Environm},
Abstract = {After moving into a new office building, employees complained about
   health problems attributed to dust exposure. Measurements revealed
   increased levels of phthalates and trisphosphates. A questionnaire study
   that demonstrated a high prevalence of symptoms after moving in and
   predominately negative ratings of office environment. To improve the
   situation several measures were taken.
   Eighteen month later a follow-up study was conducted to evaluate the
   effects of these measures'. Overall 71 subjects (67\%) returned the
   follow-up questionnaire on health complaints and environmental
   conditions at the workplace.
   Compared to the first investigation, the follow-up demonstrated a
   decrease of symptoms and an improvement of general well-being. Although
   there was no significant association between the perception of dust and
   well-being an association between unfavorable room climate and
   perception of dust was found.
   Measures. such as weekly wet cleaning, measurement of dust composition
   and the participation of the employees in planned interventions seem to
   have had positive effects on the perception of the environmental
   condition. and on health and well-being.},
