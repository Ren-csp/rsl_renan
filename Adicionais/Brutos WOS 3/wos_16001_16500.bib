@article{ WOS:000404012600003,
Author = {Demir, Goksel and Ozcan, H. Kurtulus and Karakus, Perihan Kurt and
   Bakis, Yener},
Title = {Solid waste collection route optimisation by geographical information
   system in Fatih, Istanbul, Turkey},
Journal = {INTERNATIONAL JOURNAL OF GLOBAL WARMING},
