@inproceedings{ WOS:000352650900022,
Author = {Su Juan and Wang Ning},
Editor = {Zhang, Y},
Title = {Study on the Recreational Quality of Visitors for Zhangjiajie National
   Forest Park},
Booktitle = {PROCEEDINGS OF THE 10TH EURO-ASIA CONFERENCE ON ENVIRONMENT AND
   CORPORATE SOCIAL RESPONSIBILITY: TOURISM, SOCIETY AND EDUCATION SESSION,
   PT III},
Year = {2014},
Pages = {142-148},
Note = {10th Euro-Asia Conference on Environment and Corporate Social
   Responsibility - Tourism, Society and Education Session, Berlin,
   GERMANY, AUG 29-30, 2014},
Organization = {Tianjin Univ Finance \& Econ, Tourism Dept; IMRE Alumni Network; German
   Acad Exchange Serv Fdn; TU Bergakademie Freiberg},
Abstract = {To strengthen the evaluation of visitors' recreational quality is
   conducive to the development and management of forest parks. Based on
   the review of the studies on the recreational quality evaluation for
   tourists, a six dimensional model of tourists' recreational quality
   evaluation is constructed in this paper. Combining the Fuzzy mathematics
   method and the weight factor judgment method, an empirical study on
   visitors' recreational quality for Zhangjiajie Forest Park is conducted
   by using this model. In order to increase recreational satisfaction,
   several suggestions are proposed which include increasing the use of
   intelligence information, improving recreation facilities, reducing
   ticket prices, innovating park ticket system, perfecting service
