@inproceedings{ WOS:000231975600009,
Author = {Rizvi, SHN and Nisa, M and Haq, SM},
Editor = {Meadows, A and Meadows, PS},
Title = {Environmental degradation and marine pollution along the Karachi coast
   and adjacent creeks in the Indus Delta},
Booktitle = {INDUS RIVER: BIODIVERSITY, RESOURCES, HUMANKIND},
Year = {1999},
Pages = {79-90},
Note = {Symposium on the Indus River - Biodiversity, Resources, Humankind,
   London, ENGLAND, JUL 13-15, 1994},
Organization = {Linnean Soc; British Council; UNESCO, Intergovt Oceanog Commiss;
   Unilever Plc; Hamdard Fdn Pakistan; Univ Glasgow; Univ Bradford},
Abstract = {The Indus Delta, one of the significant geomorphic features of coastal
   Pakistan is located at the upper reaches of the Arabian Sea. The delta
   comprises a network of creek systems and is thickly populated with
   mangrove forest. It has drawn considerable ecological importance in
   sustaining productivity, coastal and near-shore fisheries, wildlife
   habitat as well as providing other benefits such as coastal protection.
   The creek system as a whole serves as nursery grounds for a number of
   commercial species of fish and shrimp. These creeks, adjacent to the
   shallow areas of the Indus Delta, support the entire marine fisheries of
   the Sindh Coast. During the last two decades these deltaic creeks have
   been facing pollution problems, which have been increasing every year,
   because of rapid industrialization along the Sindh Coast, particularly
   around Karachi city.
   Major environmental degradation issues in Pakistan are pollution,
   coastal development, and changes in river discharge. Karachi with a
   population of about thirteen million is the largest industrial city, has
   about 6,000 small and large industrial units and is the main source of
   marine pollution. Karachi city and the adjacent areas generate more than
   262 MGD (million gallons per day) of untreated domestic and industrial
   waste, which is discharged through different pathways into the coastal
   environment. The main impacts of pollution along the Karachi coast are
   habitat loss, eutrophication, smothering of intertidal marine fauna and
   flora and bio-accumulation of toxic substance. All these effects are
   leading to eventual loss of marine living resources in the near shore
   environment of Karachi. Major development activities in the coastal
   belt, in the absence of appropriate environmental safeguard are likely
   to increase the pollution load and man induced degradation of the
   coastal environment. Changes in the river discharge and encroachment of
   the sea within creeks and salt intrusion inland in the deltaic region
   are causing the shrinking of the Indus Estuary and high salinity of the
   fidal channels and creeks with concomitant drastic effect on the
   estuarine fauna and flora.
   Control measures and serious efforts are in progress to check the marine
   pollution level in Pakistan waters. These include establishment of a
   high powered Marine Pollution Control Board and of National
   Environmental Quality Standards (NEQS) by the Ministry of Environment
   and Urban Affairs. In addition Karachi Port Trust and Port Muhammad Bin
   Qasim have embarked upon their own programme for the improvement of
   Environmental Quality and Marine Pollution.},
Publisher = {OXFORD UNIV PRESS},
