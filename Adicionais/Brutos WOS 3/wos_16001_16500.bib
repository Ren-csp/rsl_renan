@inproceedings{ WOS:000252307300029,
Author = {Ricardo, Ortiz and Kazuhiko, Sekiguchi and Kazuhiko, Sakamoto},
Editor = {Wang, Y and Li, SC and Huang, P and Yang, YH and An, Y and Sun, XY},
Title = {Measurements of atmospheric bifunctional carbonyls at rural and suburban
   areas},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND TECHNOLOGY, VOL I},
Year = {2007},
Pages = {179-185},
Note = {International Symposium on Environmental Science and Technology,
   Beijing, PEOPLES R CHINA, NOV 13-16, 2007},
Organization = {Chinese Soc Environm Sci; Beijing Inst Technol},
Abstract = {Samples were simultaneously taken in summer 2006 at Saitama City, Kisai,
   and Fukaya, in the Saitama Prefecture (North of Tokyo). Samples were
   collected with a low volume denuder and filter pack system (AD-FP),
   using PFBHA as the carbonyls sorbent in both, the denuders and the
   quartz filters. Results showed that there is an important contribution
   of bifunctional carbonyls to the formation to atmospheric aerosol,
   reaching in average 2.9\% of SPM at Saitama, 3.6\% at Kisai and 3.4\% at
   Fukaya. Despite of what we would have expected, the higher
   concentrations variation was found at the site farter from the Tokyo
   metropolitan area (Fukaya) and the higher concentrations were shown when
   the air masses were transported from the east and north, which was
   mainly constituted by rural areas, reaching top levels of 9.6\% to 9.9\%
   of the SPM at Fukaya and Kisai respectively. In general, during the
   sampling period, there was little or almost none influence from
   metropolitan emissions, since the air masses came mainly from the north
   and east. However, results show clearly how when air masses are
   transported, these compounds tend to be more in the particulate phase
   than at the gaseous phase, that is why in the southern most sampling
   point, the gaseous concentrations were the lowest. Hence, we can
   conclude that there is an important generation of bifunctional carbonyl
   compounds that cannot be attributed to urban generation, and that those
   compounds can represent an important component of atmospheric aerosol in
   rural and suburban areas.},
