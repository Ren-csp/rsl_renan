Title = {GENERATIONAL AND SEX DIFFERENCES IN RELATION TO EMPATHY AMONG
   PRE-GRADUATE TEACHERS},
Booktitle = {INTERNATIONAL CONFERENCE ON EDUCATION AND EDUCATIONAL PSYCHOLOGY (8TH
   ICEEPSY)},
