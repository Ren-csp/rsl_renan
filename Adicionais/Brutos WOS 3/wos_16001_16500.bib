Title = {Technological mediation of empathetic human-animal relations through
   gene editing technologies},
Booktitle = {TRANSFORMING FOOD SYSTEMS: ETHICS, INNOVATION AND RESPONSIBILITY,
   EURSAFE 2022},
Year = {2022},
Pages = {406-411},
