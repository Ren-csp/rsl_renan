   cities using emergy analysis},
Booktitle = {INTERNATIONAL WORKSHOP FROM THE INTERNATIONAL CONGRESS ON ENVIRONMENTAL
   MODELING AND SOFTWARE (IEMSS2010)},
Series = {Procedia Environmental Sciences},
Year = {2011},
