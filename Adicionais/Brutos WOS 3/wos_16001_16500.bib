Pages = {283-286},
Month = {JAN},
Note = {Conference on Advanced Research on Business, Management and Humanities
   (ARBUHUM), Bandung, INDONESIA, MAR 15-17, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {One change, among others, that normally follows merger is the
   psychological climate. This unique individuals' perception regarding
   their work environment leads to important outcomes. Identifying
   psychological climate is a must to understand the basis reality of the
   employees within an educational institution that went through merger.
   Due to the multidimensional nature of psychological climate, it is
   needed to construct an appropriate climate questionnaire for employees
   that fit the context where the study was conducted, especially in the
   scares area such as merger in educational institutions. The study used
   convenience sample of 119 employees using PCA (validity) and Pearson
   correlations (reliability) shows that the questionnaire is met the
   necessary psychometric properties. Communication seems to be the
   dominant theme of the climate's element after merger. This finding is
   relevant with Hofstede's cultural dimension in Indonesia where clear
   directions from leader and supportive work environment are considered
   important.},
