Organization = {French Assoc Med Informat},
Abstract = {In a cross-sectional study, we evaluated the perception of the community
   pharmacist in Belgium about his satisfaction with the implementation of
   the electronic prescription in his software. 246 community pharmacists
   scored the implementation in their software with an average of 6.46 +/-
   2.16(SD) on a score of 10. This satisfaction is associated with the
   software used (p<0.001), the frequency of slow responses (p<0.001), the
   perception of unavailability of systems (p=0.003) and the knowledge of
   the pharmacist (p=0.036).},
