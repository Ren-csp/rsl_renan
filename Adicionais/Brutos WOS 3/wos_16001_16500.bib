@inproceedings{ WOS:000079047700020,
Author = {Love, DJ},
Editor = {Whipple, W},
Title = {South Platte River enhancement - North Denver},
Booktitle = {COORDINATION: WATER RESOURCES AND ENVIRONMENT},
Year = {1998},
Pages = {135-140},
Note = {Special Session of ASCE 25th Annual Conference on Water Resources
   Planning and Management / 1998 Annual Conference on Environmental
   Engineering, CHICAGO, IL, JUN 07-10, 1998},
Organization = {Amer Soc Civil Engineers; USA Corps Engineers; US EPA; Amer Water
   Resources Assoc; Environm Engn \& Water Resources Grp, ASCE IL Sect;
   Metropolitan Water Reclamat Dist Greater Chicago},
Abstract = {This \$11,000,000 river enhancement project is located at the northern
   edge of the City of Denver in the Globeville neighborhood. This high
   profile project, driven by the Mayor's Office and the Urban Drainage and
   Flood Control District, constructed a greenway trail, aquatic and
   terrestrial habitats, reclaimed and stabilized the river banks,
   constructed flood levees and floodwalls to provide 100-year flood
   protection, enhanced the wetland and riparian areas along the river, and
   provided educational signage throughout the project reach. This paper
