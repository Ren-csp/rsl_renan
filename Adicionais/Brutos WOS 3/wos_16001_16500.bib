@inproceedings{ WOS:000466841700007,
Author = {Brunninge, Olof and Melander, Anders},
Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {FAMILY FIRM LONGEVITY AND RESOURCE MANAGEMENT: FINANCIAL AND
   SOCIAL-EMOTIONAL WEALTH RATIONALITIES},
Booktitle = {NEW WAYS OF STUDYING EMOTIONS IN ORGANIZATIONS},
Series = {Research on Emotion in Organizations},
Year = {2015},
Volume = {11},
Pages = {175-213},
Note = {9th International Conference on Emotions and Worklife (Emonet),
   Philadelphia, PA, JUL 30-31, 2014},
Abstract = {In this chapter, we explore the impact of socioemotional and financial
   wealth on the resource management of family firms. We use MoDo, a
   Swedish pulp and paper firm, covering three generations of
   owner-managers from 1873 to 1991, to grasp the shifting emphases on
   socioemotional and financial wealth in the management of the company.
   Identifying four strategic issues of decisive importance for the
   development of MoDo, we analyze the organizational values that guided
   the management of these issues. We propose that financial and
   socioemotional wealth stand for two different rationalities that infuse
   organizational values. The MoDo case illustrates how these rationalities
   go hand in hand for extended periods of time, safeguarding both
   financial success and socioemotional endowments. However, in a situation
   where the rationalities are no longer in line with the development of
   the industry context, the conflict arising between the two rationalities
   may have fatal consequences for the firm in question.},
