@inproceedings{ WOS:000249033800006,
Author = {Sharma, U. C. and Sharma, Vikas},
Editor = {Webb, B and Hirata, R and Kruse, E and Vrba, J},
Title = {Groundwater sustainability indicators for the Brahmaputra basin in the
   northeastern region of India},
Booktitle = {SUSTAINABILITY OF GROUNDWATER RESOURCES AND ITS INDICATORS},
