@article{ WOS:A1995TG27200004,
Author = {ILMAVIRTA, A},
Title = {THE USE OF GIS-SYSTEM IN CATASTROPHE AND EMERGENCY MANAGEMENT IN FINNISH
   MUNICIPALITIES},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {1995},
Volume = {19},
Number = {3},
Pages = {171-178},
Month = {MAY-JUN},
Note = {17th Urban Data Management Symposium (UDMS 94), HELSINKI ESPOO, FINLAND,
   SEP 04-08, 1994},
Abstract = {MEMbrain will develop and make commercially available an
   industrial-quality system to support the major activities al the
   Management of Major Emergencies (MEM). Its main goal ir to define and
   implement a standard software and hardware platform for MEM,
   configurable to operate in a variety of national and application
   domains. This goal will be attained through enhancing the performance of
   the people bearing the responsibility of decision-making in the case of
   a Major Emergency (Cap Gemini Innovation, 1992).
   MEMbrain is the EUREKA project EU904 consisting of numerous participants
   in seven European countries. The aim of the Finnish subproject si to
   develop a modern and open GIS-system for the rescue brigades and
   environmental offices in typical Finnish communities (SNI). Furthermore
   there will be another subproject `'Real-time Use of Safety Studies'' by
   the Technical Research Centre of Finland (VTT). Vaisala Oy joins to the
   project as SNI's partner.
   The rescue brigades are responsible for fire and emergency management
   activities in the Finnish communities. They want to get useful
   extensions to their existing open GIS and operative systems.
   The software as well as hardware platform is based on open Client-Server
   architecture, LAN, I VAN and PC's, relational database management
   system, MS-Windows and UnifAce-4GL language. Also 3rd party SW will be
   used such as AutoCad
   The functionalities to be implemented in the pilot applications will
   have to be approved of by the user municipalities. In addition, they
   should represent relevant extensions to the existing IT-systems. The
   Finnish pilot applications show that a low cost and small scale
   GIS-system is useful in the emergency management and environmental
   monitoring activities in Finnish municipalities.},
