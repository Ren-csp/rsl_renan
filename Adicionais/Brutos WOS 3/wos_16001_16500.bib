@inproceedings{ WOS:000342671500061,
Author = {Frances, Johanna and Robin, Stephane and Ermine, Jean-Louis},
Editor = {Green, A},
Title = {Dissemination of Professional Routines, a Case Study in the Automotive
   Industry},
Booktitle = {PROCEEDINGS OF THE 10TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT AND ORGANISATIONAL LEARNING (ICICKM-2013)},
