@article{ WOS:000606828200024,
Author = {Pani, Luisa and Rombi, James and Francesconi, Lorena and Mereu, Anania},
Title = {CIRCULAR ECONOMY MODEL OF RECYCLED AGGREGATES FOR THE CONSTRUCTION
   SECTOR OF SARDINIA ISLAND},
