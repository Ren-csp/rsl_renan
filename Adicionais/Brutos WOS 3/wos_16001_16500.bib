   Hussain, H. and Jamaludin, M. Z. and Abdullah, F. and Arazad, A. Z. and
   Yusop, H.},
Book-Group-Author = {IOP},
Title = {Real time monitoring of slope condition for transmission tower safety in
   Kenyir, Malaysia},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENT 2013 (ICEE 2013)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2013},
Volume = {16},
Note = {4th International Conference on Energy and Environment (ICEE),
   Putrajaya, MALAYSIA, MAR 05-06, 2013},
Organization = {Univ Tenaga Nas (UNITEN)},
Abstract = {The Malaysia national electricity grid traverses throughout the nation
   over urban and rural areas including mountainous terrain. A major number
   of the transmission towers have been in existence for over 40 years and
   some traversed through very remote and high altitude areas like the
   Titiwangsa range that forms the backbone of the Malay Peninsula. This
   paper describes the instrumentation and real time monitoring in a
   transmission tower site in Kenyir, a hilly terrain in the East Coast of
   Malaysia. The site itself which is between 300-500m above sea level is
   deep in the rainforest area of Kenyir. The site and surrounding areas
   has been identified with signs of slope failure. A design concern is the
   real time slope monitoring sensors reliability and data integrity from
   the remote area with potential interference to the electronics equipment
   from the power line. The monitoring system comprised of an automated
   system for collecting and reporting field monitoring data. The
   instruments collect readings and transmit real time through GSM to the
   monitoring office over designated intervals. This initiative is a part
   of a project on developing an early warning system for monitoring
   landslide hazards at selected transmission towers. This paper reviews
   the various instrumentation used and challenges faced and the output
   received for slope movement warnings.},
Publisher = {IOP PUBLISHING LTD},
Address = {DIRAC HOUSE, TEMPLE BACK, BRISTOL BS1 6BE, ENGLAND},
Type = {Proceedings Paper},
