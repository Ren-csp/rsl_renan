@inproceedings{ WOS:000228129700031,
Author = {Pryce, CR and Dettling, A and Spengler, M and Spaete, C and Feldon, J},
Editor = {Yehuda, R and McEwen, B},
Title = {Evidence for altered monoamine activity and emotional and cognitive
   disturbance in marmoset monkeys exposed to early life stress},
Booktitle = {BIOBEHAVIORAL STRESS RESPONSE: PROTECTIVE AND DAMAGING EFFECTS},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2004},
Volume = {1032},
