@article{ WOS:000358063700014,
Author = {Schwager, Julie and Schaal, Laurence and Simonnot, Marie-Odile and
   Claverie, Remy and Ruban, Veronique and Morel, Jean-Louis},
Title = {Emission of trace elements and retention of Cu and Zn by mineral and
   organic materials used in green roofs},
Journal = {JOURNAL OF SOILS AND SEDIMENTS},
Year = {2015},
Volume = {15},
Number = {8},
Pages = {1789-1801},
Month = {AUG},
Note = {7th Conference on Soils of Urban, Industrial, Traffic, Mining and
   Military Areas (SUITMA), Torun, POLAND, SEP, 2013},
Organization = {Nicolaus Copernicus Univ, Dept Soil Sci \& Landscape Management; Polish
   Soil Sci Soc},
Abstract = {The increasing surface area of green roofs (GR) may have a significant
   impact on the quantity and quality of urban drainage. However, the
   chemical quality of effluents produced by GR in comparison to
   atmospheric deposit and other roof surfaces has to date been poorly
   assessed. It is necessary to determine whether a green roof acts as a
   sink or source of pollutants. This work was conducted to study the
   capacity of four materials commonly used to build green roofs.
   Leaching tests experiments were performed on three substrates and one
   drainage material. Sorption kinetics and isotherms were also established
   for Cu and Zn thanks to batch experiments.
   Results showed the variability of release according to the material and
   pollutant considered. The equilibrium time for adsorption was high (5 h
   to 3 days) for all materials. Expanded clay was identified as the
   material with the highest ability to retain Zn and Cu; also, desorption
   was limited with this drainage material. In the substrates, Cu was
   mainly sorbed by organic materials, which induce an important desorption
   rate due to organic matter leachability.
   In conclusion, the study showed that the effect of green roofs on water
   quality is strongly dependent on the materials used. That is why a
   characterization of the leaching and sorption capacities of materials
   should be carried out prior to green roof construction in a context of
   storm water quality management.},
