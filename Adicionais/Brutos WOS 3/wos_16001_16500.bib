Title = {Strategic thinking to improve sanitation in Kampung Pelangi 200, Bandung
   City: in comparison with Kampung Jodipan-Ksatrian, Malang City},
Booktitle = {5TH PLANOCOSMO INTERNATIONAL CONFERENCE INFRASTRUCTURE FOR ALL: SMART,
   INNOVATIVE, AND INCLUSIVE},
