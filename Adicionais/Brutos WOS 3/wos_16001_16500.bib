@article{ WOS:000382531500003,
Author = {Winter, David A.},
Title = {Reconstructing Life as a One-Foot Man: Reflections on the Role of
   Football},
Journal = {JOURNAL OF CONSTRUCTIVIST PSYCHOLOGY},
Year = {2016},
Volume = {29},
Number = {4},
Pages = {357-367},
Note = {20th International Congress on Personal Construct Psychology, Sydney,
   AUSTRALIA, JUL, 2013},
Abstract = {This article is one of a series of personal construct investigations of
   the aftermath of the brutal civil war in Sierra Leone. It is based on
   interviews conducted with nine members of the Sierra Leone Single-Leg
   Amputee Football Club, all of whom lost a limb during the war. Interview
   themes concerned participants' construing of this event and its
