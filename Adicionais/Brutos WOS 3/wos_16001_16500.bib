@article{ WOS:A1995RC57700005,
Author = {HERBST, LH and KLEIN, PA},
Title = {GREEN TURTLE FIBROPAPILLOMATOSIS - CHALLENGES TO ASSESSING THE ROLE OF
   ENVIRONMENTAL COFACTORS},
