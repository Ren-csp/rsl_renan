Title = {Second to fourth digit ratios and individual differences in women's
   self-perceived attractiveness, self-esteem, and body-esteem},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
Year = {2004},
Volume = {37},
Number = {4},
Pages = {799-804},
Month = {SEP},
Note = {74th Annual Meeting of the Eastern-Psychological-Association, Baltimore,
   MD, MAR 13-16, 2003},
Organization = {Eastern Psychol Assoc},
Abstract = {This research examined the relationship between women's digit ratios
   (2D:4D) and self-perceived attractiveness, self-esteem and body-esteem.
   Sixty women rated their physical and sexual attractiveness, self-esteem,
   and body-esteem. Digit ratios (2D:4D) were determined from tracings of
   their hands. Based on prior research, it was hypothesized that women
   with high 2D:4D ratios would find themselves more physically attractive
   and possibly exhibit higher self-esteem and body-esteem. The results
   obtained supported the hypothesis for attractiveness. Women with high
   2D:4D ratios rated their physical attractiveness higher. These results
   are discussed in terms of evolutionary theory and prior research. (C)
   2003 Elsevier Ltd. All rights reserved.},
