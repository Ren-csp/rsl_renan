Note = {5th Conference on Dynamic Cognitive Processes, Tsukuba, JAPAN, MAR, 2004},
Organization = {Japanese Minist Educ Sci},
Abstract = {This brief chapter provides an overview of the book. A sketch is
   provided of the sharp contrast between the popular view that cognition
   is relatively static and the view in the discipline that cognition is
   highly dynamic. This provides the high-level theme of the entire book.
   Weaving throughout the book are several other more specific themes,
   notably the roles of consciousness and of inhibition in cognition, and
   the complimentary behavioural and neuroscience approaches. Linkages
   across chapters are described, and a brief synopsis of each chapter is
   provided.},
