@article{ WOS:000260262900010,
Author = {Johnson, D. L.},
Title = {A first generation dynamic ingress, redistribution and transport model
   of soil track-in: DIRT},
Journal = {ENVIRONMENTAL GEOCHEMISTRY AND HEALTH},
Year = {2008},
Volume = {30},
Number = {6},
