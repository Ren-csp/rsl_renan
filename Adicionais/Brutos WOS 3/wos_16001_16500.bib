@inproceedings{ WOS:000333253900033,
Author = {Devecchi, M. and Merlo, F. and Vigetti, A. and Larcher, F.},
Editor = {Wuzhong, ZZ and Groening, G and Drew, RA},
Title = {The Cultivation of Mediterranean Aromatic Plants on Green Walls},
Booktitle = {III INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2013},
Volume = {999},
Pages = {243-247},
Note = {3rd International Conference on Landscape and Urban Horticulture,
   Nanjing, PEOPLES R CHINA, JUN 29-JUL 03, 2011},
Organization = {Int Soc Hort Sci},
Abstract = {The aim of this study was to evaluate the adaptability of two particular
   species of aromatic plants, Cistus x purpurescens and Teuchrium x
   lucydris, to being cultivated on a wall in a Mediterranean environment
   on the four exposures (north, south, east and west). The chosen
   technology was the REVIWALL (R) (Reviplant, Italy) patent, characterized
   by panels (50x40 cm) of six plants cultivated in a coconut fibre medium
   and fertirrigated. The green walls were put up in two different
   Mediterranean locations: Sanremo in Italy and Antibes in France. On each
   site and for each exposure, 3 repetition trials of 3 Reviwall panels
   with 18 plants on a vertical area 50 cm wide and 120 cm high were set.
   Plants cultivated in 13 cm diameter pots were used. Specific surveys
   were performed every 3 weeks from June to November 2010 to evaluate the
   plants' growth on the four exposures: fresh and dry weight of the plants
   at the end of the cultivation period; height, width and thickness of the
   plants; shoots length and number of internodes; covering index of the
   panel surface (percentage); timing, quality and quantity of the
   phoenological phases (flowering and fruiting). The trial is still in
   progress, but from the data so far collected a first important
   consideration can be drawn, that is the great potential of Cistus x
   purpurescens and Teuchrium x lucydris, for a vertical cultivation in
   Mediterranean areas. In particular, on all the exposures, the Teucrium
   was more efficient in evenly covering the panels.},
