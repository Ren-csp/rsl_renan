@inproceedings{ WOS:000247273200048,
Author = {Song, W. W. and Ashmore, M. R.},
Editor = {Borrego, CA and Brebbia, CA},
Title = {Size distribution of commuters' exposure to airborne particulate matter
   in buses in the UK},
Booktitle = {AIR POLLUTION XV},
