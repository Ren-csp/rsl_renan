   Mesmoudi, H. and Elissami, A. and Sabri, E. and Ikhmerdi, H.},
Editor = {Boukdir, A and ElMabrouki, M},
Title = {Diagnosis of the Ghiss Nekor aquifer in order to elaborate the aquifer
   contract},
Booktitle = {SIXTH INTERNATIONAL CONGRESS WATER, WASTE AND ENVIRONMENT (EDE6-2017):
   AFRICA, STATE OF PLAY AND FUTURE PROSPECTS},
