Title = {Emotional Expressions as a Window to Processes of Change in a
   Mathematics Classroom's Culture},
Booktitle = {TEACHING AND LEARNING IN MATHS CLASSROOMS: EMERGING THEMES IN
   AFFECT-RELATED RESEARCH: TEACHERS' BELIEFS, STUDENTS' ENGAGEMENT AND
   SOCIAL INTERACTION},
Series = {Research in Mathematics Education-Series},
Year = {2017},
Pages = {131-140},
Note = {21st Annual International Conference on Mathematical Views (MAVI),
   Milan, ITALY, 2015},
Abstract = {In this paper the lens of Symbolic Interactionism is used to examine the
   changing norms of a 6th grade classroom in which two teachers attempt to
   implement the ideas of ``reform{''} cognitively demanding and discourse
   rich instruction. The findings point to tensions between the declared
   norms of ``it's OK to be wrong{''} and the teachers' unreflective
   emotional alignment with students' embarrassments and frustrations that
   adhere to the old norms. The paper concludes with the importance of
   attending to emotions in situations of change to further teachers'
   success in implementing cognitively demanding and discussion-based
   instruction.},
