@inproceedings{ WOS:000288622300058,
Author = {Andel, Petr and Gorcicova, Iva and Petrzilka, Leos and Belkova, Helena},
Book-Group-Author = {SGEM},
Title = {CATEGORIZATION OF MIGRATION BARRIERS FOR LARGE MAMMALS IN THE CZECH
   REPUBLIC},
Booktitle = {10TH INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC GEOCONFERENCE: SGEM
   2010, VOL II},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2010},
