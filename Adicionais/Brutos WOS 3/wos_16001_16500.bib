@article{ WOS:000173339500010,
Author = {Maddox, KB and Gray, SA},
Title = {Cognitive representations of black Americans: Reexploring the role of
   skin tone},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {2002},
Volume = {28},
Number = {2},
Pages = {250-259},
Month = {FEB},
Note = {12th Annual Convention of the American-Psychological-Society, Miami
   Beach, FL, JUN09, 2000},
Organization = {Amer Psychol Soc},
Abstract = {Although evidence from a variety of disciplines suggests that skin tone
   is a basis of discrimination among Blacks, research in social psychology
   has virtually ignored this topic. Two experiments examined the causal
   role of skin tone in the perception and representations of Blacks.
   Paralleling the effect of race and other social category dimensions,
   Study 1 showed that variation in skin tone can influence the
   organization of social information. Study 2 demonstrated differentiation
   in stereotypes of Black's based on skin tone. Results from both
   investigations suggest that skin tone is an important factor in both
   Blacks' and Whites' representations of Blacks.},
