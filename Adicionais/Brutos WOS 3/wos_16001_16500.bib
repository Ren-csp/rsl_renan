@inproceedings{ WOS:000449454000057,
Author = {Mukhtar, Aqsa and Khalid, Shazia},
Editor = {Qureshi, MI},
Title = {PERCEIVED ORGANIZATIONAL POLITICS AND PSYCHOLOGICAL CONTRACT BREACH AND
   VIOLATION IN PHARMACEUTICAL EMPLOYEES},
Booktitle = {AIMC 2017 - ASIA INTERNATIONAL MULTIDISCIPLINARY CONFERENCE},
