Title = {To control or not to control?: The role of sustainable planning in order
   to accommodate informal brickyards in the integrated development plan of
   the Mangaung Municipality},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING II, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2005},
Volume = {84},
