@inproceedings{ WOS:000288209800011,
Author = {Eisenberg, Jacob and James, Keith},
Editor = {Ashkanasy, NM and Zerbe, WJ and Hartel, CEJ},
Title = {THE RELATIONSHIP BETWEEN AFFECT AND CREATIVITY IN ORGANIZATIONS: THE
   ROLES OF AFFECT CHARACTERISTICS, NEURO-COGNITIVE MECHANISMS AND TASK
   TYPE},
Booktitle = {EFFECT OF AFFECT IN ORGANIZATIONAL SETTINGS},
Series = {Research on Emotion in Organizations},
Year = {2005},
Volume = {1},
Pages = {241-261},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {The nature of affect and creativity relationship has been under debate,
   with some studies pointing out that positive affect is conducive, while
   others arguing that positive affect is detrimental to creative
   performance. In order to clarify the complicated affect-creativity
   relationship, we examine several factors that have not been sufficiently
   looked at: the role of affect characteristics (e.g., temporal factors),
   neuro-cognitive mechanisms (e.g., set-breaking), and the type of
   creative task performed (e.g., requiring negative versus positive
   creativity). To improve our understanding of seemingly inconsistent
   previous findings, we offer a model that links affect, through a set of
   mediators and moderators, to creative performance in organizations,
   accompanying our analysis with a set of 14 testable propositions.},
