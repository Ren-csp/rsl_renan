@inproceedings{ WOS:000453076800025,
Author = {Kazaryan, M. and Shahramanian, M. and Voronin, V.},
Editor = {Erbertseder, T and Chrysoulakis, N and Zhang, Y},
Title = {The automated space-monitoring system of waste disposal sites},
Booktitle = {REMOTE SENSING TECHNOLOGIES AND APPLICATIONS IN URBAN ENVIRONMENTS III},
