   from an in-depth survey},
Booktitle = {RECOLLECTIONS OF TRAUMA: SCIENTIFIC EVIDENCE AND CLINICAL PRACTICE},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SERIES A, LIFE SCIENCES},
