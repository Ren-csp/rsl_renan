@article{ WOS:000075451500007,
Author = {Rinaldi, C and Howe, N},
Title = {Siblings' reports of conflict and the quality of their relationships},
Journal = {MERRILL-PALMER QUARTERLY-JOURNAL OF DEVELOPMENTAL PSYCHOLOGY},
Year = {1998},
Volume = {44},
Number = {3},
Pages = {404-422},
Month = {JUL},
Note = {Annual Conference of the Canadian-Psychological-Association,
   CHARLOTTETOWN, CANADA, JUN, 1995},
Organization = {Canadian Psychol Assoc},
Abstract = {Associations were investigated between type of conflict resolution
   strategies (constructive vs, destructive) reported by siblings and
   relationship qualities, as well as the congruence between siblings'
   perceptions. Fifth- and sixth-grade children (n = 34) and their
   closest-in-age siblings (a) rated siblings' affective relationship
   quality, and (b) reported on sibling conflict strategies. Results
   indicated that (a) focal siblings who engaged in more destructive
   conflicts reported greater negativism in their relationships, (b)
   frequency of conflict was positively correlated with destructive
   conflict, and (c) warmth was positively correlated with prosocial
   behavior and constructive conflict strategies. Findings reveal that
   constructive and destructive conflict strategies were differentially
   related to affective relationship quality and are discussed in light of
   recent conceptualizations.},
