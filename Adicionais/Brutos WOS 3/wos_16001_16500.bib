@inproceedings{ WOS:000447175800098,
Author = {Kusumoarto, A. and Ernawati, A.},
Editor = {Nandi and Ismail, A and Somantri, L},
Title = {Ecological Carrying Capacity Analysis of Ecotourism Objects in
   Salak II Resort Area, Halimun Salak National Park},
