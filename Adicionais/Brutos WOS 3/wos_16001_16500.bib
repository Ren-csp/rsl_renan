@inproceedings{ WOS:000288183400011,
Author = {Wang, Qian},
Editor = {Jiang, Y and Zou, YL and Zhang, JG and Chen, JQ},
Title = {Spatial Variations of Physical Fitness among Chinese Female College
   Students},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 1},
Year = {2010},
Pages = {44-47},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {Based on the data of National Physical Fitness Survey in 2005, this
   paper analyzed the spatial variations of physical fitness among Chinese
   female college students via principle component score and GIS, and
   characterized the variability quantitatively using variogram, aiming at
   providing references for decision-making of school physical education
   and health. The physical fitness indicators used in this paper included
   three body shape indicators (height, weight and chest circumference),
   one body function indicators (vital capacity), and six physical quality
   indicators (grip strength, 50m run, standing long jump, muscle strength,
   endurance running, and Sit and Reach). Results denoted that obvious
   spatial variations of physical fitness existed and the variability was
   more significant for rural than urban female college students. Variogram
   analysis not only confirmed the results of GIS analysis, but also
   quantitatively determined the contributions of random and structural
   factors. Comparison of the contributions of random and structural
   factors showed that the spatial variations of physical fitness were
   mainly caused by structural factors rather than random factors. These
   results suggest that regional differentiated model of physical fitness
   and health promotion should be proposed taking into structural factors
   such as geographical environment, lifestyle, education levels and
   socio-economic conditions.},
