Book-Group-Author = {IOP},
Title = {Land use change and soil loss risk assessment by using geographical
   information system (GIS): A case study of lower part of Perak River},
Booktitle = {8TH IGRSM INTERNATIONAL CONFERENCE AND EXHIBITION ON GEOSPATIAL \&
   REMOTE SENSING (IGRSM 2016)},
Series = {IOP Conference Series-Earth and Environmental Science},
