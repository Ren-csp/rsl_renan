@article{ WOS:000260257400004,
Author = {Bertrando, Paolo and Gilli, Gabriella},
Title = {Emotional dances: therapeutic dialogues as embodied systems},
Journal = {JOURNAL OF FAMILY THERAPY},
Year = {2008},
Volume = {30},
Number = {4},
Pages = {362-373},
Month = {NOV},
Note = {Conference of the
   European-Family-Therapy-Association/Association-for-Family-Therapy,
   Glasgow, SCOTLAND, OCT, 2007},
Organization = {European Family Therapy Assoc; Assoc Family Therapy},
Abstract = {The mind/body dualism, although scarcely relevant in clinical practice,
   remains unsolved theoretically. The pragmatic wisdom of the founders of
   family therapy, which implied that bodies and minds in therapy were one,
   has been easily forgotten. Such a situation had practical results,
   leading to naive solutions, both on the materialistic and idealistic
   sides, represented by biological psychiatry on the one side, and by most
   postmodern therapies on the other. This article proposes to consider the
   role of emotions in therapeutic dialogue to solve this dilemma within
