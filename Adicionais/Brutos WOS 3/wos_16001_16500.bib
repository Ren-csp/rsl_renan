@article{ WOS:000398649300005,
Author = {Harris, Adam J. L.},
Title = {Understanding the coherence of the severity effect and optimism
   phenomena: Lessons from attention},
Journal = {CONSCIOUSNESS AND COGNITION},
Year = {2017},
Volume = {50},
