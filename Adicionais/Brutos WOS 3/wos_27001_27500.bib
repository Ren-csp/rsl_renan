@inproceedings{ WOS:000771321100018,
Author = {Jung, Dominik and Dorner, Verena},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB},
Title = {Decision Inertia and Arousal: Using NeuroIS to Analyze Bio-Physiological
   Correlates of Decision Inertia in a Dual-Choice Paradigm},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS 2017},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2018},
Volume = {25},
Pages = {159-166},
Note = {Conference on Information Systems and Neuroscience - Gmunden Retreat on
   NeuroIS (NeuroIS), Gmunden, AUSTRIA, JUN 12-14, 2017},
Abstract = {Decision inertia is a cognitive process describing the reluctance to
   incorporate new information in choices, manifesting in the tendency to
   repeat previous choices regardless of the consequences. In this work, we
   discuss recent research in decision inertia, and show that
   inter-individual differences in arousal may play an important role for
   understanding decision inertia. We derive a NeuroIS framework for the
   operationalization of decision inertia, and discuss our
   conceptualization with a view towards a general theory of decision
   inertia.},
