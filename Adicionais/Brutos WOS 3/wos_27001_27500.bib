Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {According to the crack-width formula in Chinese and foreign concrete
   structure design codes, this paper compared the guarantee rate of
   short-term flexural crack-width calculation, load combination etc. in
   Chinese and foreign concrete structure design codes, and preliminarily
   studied the safety level of flexural crack-width formula in GB
   50010-2002. A new concept named ``equivalent guarantee rate{''} was
   created as an index to evaluate the safety level for flexural
   crack-width calculation under frequent combination and quasi-permanent
   combination. Two revised suggestion about present flexural crack-width
   formula in GB 50010-2002 were presented: the guarantee rate of flexural
   crack-width formula should be lowered from 95\% to 82\%, correspondingly
   the value of characteristic loading coefficient in flexural crack-width
   formula should be lowered from 2.1 to 1.7; except crane beams, the
   flexural crack-width should be calculated under frequent combination in
   place of characteristic combination.},
