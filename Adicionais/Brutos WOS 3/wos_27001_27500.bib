@article{ WOS:A1997XK23500007,
Author = {Sathasivan, A and Ohgaki, S and Yamamoto, K and Kamiko, N},
Title = {Role of inorganic phosphorus in controlling regrowth in water
   distribution system},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1997},
Volume = {35},
