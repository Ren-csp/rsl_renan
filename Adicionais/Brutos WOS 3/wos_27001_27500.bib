@article{ WOS:000184822100013,
Author = {Tellinghuisen, DJ and Nowak, EJ},
Title = {The inability to ignore auditory distractors as a function of visual
   task perceptual load},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2003},
Volume = {65},
Number = {5},
Pages = {817-828},
Month = {JUL},
Note = {42nd Annual Meeting of the Psychonomic-Society, ORLANDO, FLORIDA, NOV
   15-19, 2001},
Organization = {Psychon Soc},
Abstract = {Using a response competition paradigm, we investigated the ability to
   ignore target response compatible, target response-incompatible, and
   neutral visual and auditory distractors presented during a visual search
   task. The perceptual load model of attention (e.g., Lavie \& Tsal, 1994)
   states that task-relevant processing load determines irrelevant
   distractor processing in such a way that increasing processing load
   prevents distractor processing. In three experiments, participants
   searched sets of one (easy search) or six (hard search) similar items.
   In Experiment 1, visual distractors influenced reaction time (RT) and
   accuracy only for easy searches, following the perceptual load model.
   Surprisingly, auditory distractors yielded larger distractor
   compatibility effects (median RT for incompatible trials minus median RT
   for compatible trials) for hard searches than for easy searches. In
   Experiments 2 and 3, during hard searches, consistent RT benefits with
   response-compatible and RT costs with response-incompatible auditory
   distractors occurred only for hard searches. We suggest that auditory
   distractors are processed regardless of visual perceptual load but that
   the ability to inhibit cross-modal influence from auditory distractors
   is reduced under high visual load.},
