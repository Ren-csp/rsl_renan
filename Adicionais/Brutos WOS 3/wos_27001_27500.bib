@article{ WOS:000076151100010,
Author = {Giesbrecht, B and Di Lollo, V},
Title = {Beyond the attentional blink: Visual masking by object substitution},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {1998},
Volume = {24},
Number = {5},
Pages = {1454-1466},
Month = {OCT},
Note = {37th Annual Meeting of the Psychonomic-Society, CHICAGO, IL, OCT 31-NOV
   03, 1996},
Organization = {Psychon Soc; Natl Sci Fdn; USN, Off Naval Res},
Abstract = {If 2 targets are to be identified among distracters displayed in rapid
   sequence, correct identification of the Ist target hinders
   identification of the 2nd. To obtain this attentional blink (AB), the
   Ist target must be masked with a simultaneous (integration) or a delayed
   (interruption) mask indifferently. In 3 experiments, it was shown that
   the 2nd target must also be masked, but that the precise form of masking
   is important: An AB occurs with interruption but not with integration
   masking. This nonequivalence of masking paradigms parallels that found
   in studies of masked priming, a phenomenon arguably related to the AB.
   The results are explained by a revised 2-stage model (M. M. Chun \& M.
   C. Potter, 1995).},
