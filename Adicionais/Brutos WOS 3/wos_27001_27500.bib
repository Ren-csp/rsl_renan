@article{ WOS:000088858300016,
Author = {Hwang, Y and Hanaki, K},
Title = {The generation of CO2 in sewage sludge treatment systems::
   life cycle assessment},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2000},
Volume = {41},
Number = {8},
Pages = {107-113},
Note = {International Conference on Sludge Management for the 21st Centruy,
   PERTH, AUSTRALIA, APR 08-10, 1999},
Organization = {Int Wat Assoc; Australian Water Wastewater Assoc; Australian Agcy Int
   Dev; Water Corp; Environm Solut Int Ltd; Thiess Environm Serv Pty Ltd;
   Alfa Laval Australia Pty Ltd; GHD Pty Ltd; Energy Equipment; SPIRAC Engn
   Pty Ltd; Sinclair Knight Merz; Ansett Australia Airlines; Perth Convent
   Bureau; Gas Drive Syst Pty Ltd; Decanter Pty Ltd},
Abstract = {Life cycle assessment (LCA) on total sewage sludge treatment systems
   including thickening. anaerobic digestion, dewatering, and
   incineration/melting was performed to estimate a global warming impact
   as carbon dioxide (CO2) emission. As representative processes for the
   assessment, the most typical and widely used processes were selected.
   Generally. the life cycle of actual treatment facilities consists of
   three stages: construction. operation and dismantlement. In this study,
   the amount of CO2 produced from the life cycle steps of existing unit
   sludge treatment processes, was calculated by inventory analysis of
   input materials. In addition, for all processes investigated, individual
   CO2 emission units (CEUs), i.e. the amount of emitted CO2 for treating a
   unit weight of sludge, were also calculated. By using the obtained CEU
   matrix, it was possible to simulate the CO2 production from various
   types of complex treatment systems as well as to trace the dominant
   cause of CO2 production in individual treatment processes.},
