@article{ WOS:000173750800014,
Author = {Davis, MH and Marslen-Wilson, WD and Gaskell, MG},
Title = {Leading up the lexical garden path: Segmentation and ambiguity in spoken
   word recognition},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2002},
Volume = {28},
Number = {1},
Pages = {218-244},
Month = {FEB},
Note = {19th Annual Conference of the Cognitive-Science-Society, STANFORD UNIV,
   Stanford, CA, AUG 07-10, 1997},
Organization = {Cognit Sci Soc},
Abstract = {Two gating studies, a forced-choice identification study and 2 series of
   cross-modal repetition priming experiments, traced the time course of
   recognition of words with onset embeddinggs (captain) and short words in
   contexts that match (cap tucked) or mismatch (cap looking) with longer
   words, Results suggest that acoustic differences in embedded syllables
   assist the perceptual system in discriminating short words from the
   start of longer words. The ambiguity created by embedded words is
   therefore not as severe as predicted by models of spoken word
   recognition based on phonemic representations. These additional acoustic
   cues combine with post-offset information in identifying onset-embedded
   words in connected speech.},
