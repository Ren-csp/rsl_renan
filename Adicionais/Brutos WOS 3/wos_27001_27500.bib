@inproceedings{ WOS:000280689300022,
Author = {Li Li and Zhang Hanjiang},
Editor = {Zhang, H and Zhang, H},
Title = {An Empirical Analysis of Regional Economic Growth Model of China:
   through the Correlation between the Electricity Consumption and GDP
   Growth},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {107-114},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {The selection and optimization of economic growth model, is a major
   concern in developing countries. In this paper, the statistics of real
   GDP and electricity consumption in 30 provinces of China in 2007 and
   2008 are considered, to calculate their share of electricity consumption
   elasticity coefficient, and a comparative analysis is made. And then the
