   Carleton Univ, Dept Psychol, Ottawa, ON K1S 5B6, Canada.},
DOI = {10.3758/BF03206187},
ISSN = {0031-5117},
Keywords-Plus = {PROBABILITY JUDGMENT ACCURACY; TIME-ORDER ERROR; GENERAL KNOWLEDGE;
