@article{ WOS:000269103300011,
Author = {Willard, Victoria W. and Hardy, Kristina K. and Bonner, Melanie J.},
Title = {Gender differences in facial expression recognition in survivors of
   pediatric brain tumors},
Journal = {PSYCHO-ONCOLOGY},
Year = {2009},
Volume = {18},
Number = {8},
Pages = {893-897},
Month = {AUG},
Note = {National Conference on Child Health Psychology, Gainesville, FL, APR 20,
   2006},
Abstract = {Objective: To examine the relation between gender, history of cranial
   radiation therapy (CRT) and facial expression recognition (FER) skill in
   survivors of pediatric brain tumors.
   Methods: Fifty-three survivors (27 females) completed a measure of FER
   and an intelligence test.
   Results: There was a significant interaction between gender and CRT on
   ability to interpret low-intensity facial expressions, such that females
   who had not had CRT made fewer errors than either females who had CRT or
   males.
   Conclusion: A history of CRT has a notable effect on FER skill in
   females: girls who received CRT performed significantly more poorly than
   girls who did not. Copyright (C) 2008 John Wiley \& Sons, Ltd.},
