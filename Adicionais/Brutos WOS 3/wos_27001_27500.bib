@article{ WOS:000432429600022,
Author = {Wareerat, Kaewurai and Teamjan, Panichparinchai and Angkana, Onthanee},
Title = {A Proposed Model for Teacher Networks to Develop Learning Innovation to
   Develop Students Holistically},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2269-2273},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {The main objective of this article is to develop a model for teacher
   networks to develop learning innovation to develop students
   holistically. This study followed a participatory action research
   procedure according to the following phases: Phase 1: preparing
   collaborative strategies for supporting the teacher networks. Phase 2:
   developing the teacher network. The target population was classified
   into four groups as follows: ( 1) A fifty teachers from the subject
   areas of two nearby provinces in primary schools. ( 2) Four educational
   supervisors. ( 3) Five school administrators with teachers are network
   members. ( 4) Three lecturers as a researcher team from the education
   faculty of a major university. The results suggest that: 1. the
   collaborative strategies consist of: 1.1 Building the network. 1.2
   Developing the capability of the network. 1.3 Constructing the
   relationship between the networks. 1.4 Monitoring and supporting the
   operations of the network. 1.5 Empowering the development of
   socio-political and educational policies. Development should be geared
   toward the development of the whole school. 2. The model of the teacher
   networks was developed and consisted of five important processes as
   follows: 2.1 a shift in teachers' perceptions in favor of developing
   learning innovation to develop students holistically. 2.2 A situation
   analysis of the teaching-learning situation in the relevant subject
   areas with the aim of encouraging subject teachers to work together as a
   teaching-learning community network. 2.3 Innovations in the
   teaching-learning situation focused on active learning and develop
   students holistically aimed at enhancing student learning and holistic
   achievements in all learning competency, values, and desirable
   characteristics are considered as the mutual responsibility of teachers.
   2.4 Provision is made for the regular monitoring, evaluation and
   reviewing of learning innovation to develop students holistically and
   applying practices. 2.5 The sharing and reviewing of the learning
   innovational development results to develop students holistically to aid
   the development of guidelines for the improvement of teaching practice.
   The four key challenges are the predominance of virtual versus real
   interaction using confrontation and use of information technology, the
   focus on collaboration aim to promote the quality of teaching and
   improve its status in the academic community and improve the quality of
   learning and learning results among students rather than on competition,
   the emphasis on value creation on the professional learning community,
   and having partner learning among teachers based on in the whole school
   development style by supervisors and school administrators are coached
   and university professors are mentors. The model based on development
   approach throughout the school, the process of taking the idea, and
   having partner learning to learning exchange each other both within the
   school itself and between school networks, it is the right process,
   appropriate, and feasibility.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
