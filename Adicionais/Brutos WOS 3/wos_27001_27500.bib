Title = {Comparisons of Various Imagery Models in Predicting Visual Imagery Using
   Color-Apparel Image Samples},
Booktitle = {2012 4TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
   INFORMATION APPLICATION TECHNOLOGY (ESIAT 2012)},
Series = {Advances in Biomedical Engineering},
Year = {2013},
Volume = {14},
Pages = {471-475},
Note = {4th International Conference on Environmental Science and Information
   Application Technology (ESIAT 2012), Bali, INDONESIA, DEC 01-02, 2012},
Abstract = {One of the most important functions for the image \& video signal
   processing, machine vision and human-machine Interface or industry
   application is to process color information, to simulate visual
   color-sensation or color-specification or color imagery. In addition,
   color imagery has been investigated using specific pattern samples with
   the exception of textile specimens for about six decades since the
   semantics differential theory proposed by Torgerson. And, so far, there
   are three celebrated color imagery models proposed by Ou et al.
   (abbreviated as the Ou1 and Ou2 for single color and two
   color-combinations respectively) and Kuo (as the Kuo) separately. A
   color psychophysical experiment with 186 fashion-apparel images
   containing 141 ones in which the fashion apparels are with two-color
   combinations was conducted, and the experimental visual results were
   used to estimate the performance of those three models in predicting
   visual color imagery. The results indicates that although all three
   color-imagery models tested have better performance in predicting the
   visual color-imagery of Heavy-Light imagery scale values than those of
   the other two imagery scale values of Beautiful-Ugly and Various-Steady,
   on the whole the three models tested still cannot have good agreement
   between their predictions and visual results of color imagery.
   Meanwhile, this finding may obviously shows that a more precise
   color-imagery estimating model still needs to be developed for the
   fashion apparels with multiple-color combinations.},
