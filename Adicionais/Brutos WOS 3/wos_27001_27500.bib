@inproceedings{ WOS:001471781800002,
Author = {Shao, Yang and Zhou, Yueying and Zhang, Daoqiang},
Book-Group-Author = {IEEE},
Title = {BDANet: A Binary-dimensional Aware Network with Multi-wise Attention for
   Cognitive Workload Recognition},
Booktitle = {2025 13TH INTERNATIONAL CONFERENCE ON BRAIN-COMPUTER INTERFACE, BCI},
