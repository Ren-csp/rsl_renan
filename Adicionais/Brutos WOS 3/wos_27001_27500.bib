@inproceedings{ WOS:000404788200018,
Author = {Oliveira Bueno, Paulo Henrique and Albuquerque Alves, Conceicao de Maria},
Editor = {Dunn, CN and VanWeele, B},
Title = {Proposed Methodology to Identify Priority Areas for Stormwater
   Management Practices Based on the Identification of Hydrologically
   Sensitive Areas},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2017: WATER,
   WASTEWATER, AND STORMWATER; URBAN WATERSHED MANAGEMENT; AND MUNICIPAL
   WATER INFRASTRUCTURE},
Year = {2017},
Pages = {241-252},
Note = {17th Annual World Environmental and Water Resources Congress,
   Sacramento, CA, MAY 21-25, 2017},
Organization = {Amer Soc Civil Engineers; Amer Soc Civil Engineers, Environm \& Water
   Resources Inst},
Abstract = {This paper presents a procedure to identify priority areas for the
   stormwater management plans based on the identification of
   hydrologically sensitive areas. The procedure uses secondary data from
   topographic information, such as soil slope and areas of contribution,
   the classification of land use and soil characteristics and defines a
   topographic index. After determining the index, it established a
   hydrological sensitivity threshold, which identified which areas of a
   watershed are more likely to be saturated during rainfall events. Then,
   the areas of the watershed identified as hydrologically sensitive areas
   (HAS) and that potentially generate pollutants were classified according
   to their suitability to different types of stormwater management and
   structures. The specification of these management measures were made
   from the use of information about the class of land use of the watershed
   area, the distance of the areas over the drainage systems and the amount
   of contribution areas upstream the river. The procedure was applied to
   the Alto Descoberto basin.},
