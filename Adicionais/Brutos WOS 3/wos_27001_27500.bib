Title = {Study on Reducing Tsunami Inundation Energy by the Modification of
   Topography Based on Local Wisdom},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON SUSTAINABLE FUTURE FOR HUMAN SECURITY
   SUSTAIN 2013},
