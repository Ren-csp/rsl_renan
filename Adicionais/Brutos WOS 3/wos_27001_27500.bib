@inproceedings{ WOS:000290883800054,
Author = {Strelcyk, Olaf and Dau, Torsten Olaf},
Editor = {LopezPoveda, EA and Palmer, AR},
Title = {Objective and Behavioral Estimates of Cochlear Response Times in
   Normal-Hearing and Hearing-Impaired Human Listeners},
Booktitle = {NEUROPHYSIOLOGICAL BASES OF AUDITORY PERCEPTION},
Year = {2010},
Pages = {597-607},
Note = {15th International Symposium on Hearing, Salamanca, SPAIN, JUN 01-05,
   2009},
Organization = {Med Elect; Hear Life},
Abstract = {Derived-band auditory brainstem responses (ABRs) were obtained in 5
   normal-hearing and 12 sensorineurally hearing-impaired listeners. The
   latencies extracted from these responses as a function of the
   derived-band center frequency served as objective estimates of cochlear
   response times. In addition, two behavioral measurements were carried
   out. In the first experiment, differences between frequency-specific
   cochlear response times were estimated, using the lateralization of
   pulsed tones, interaurally mismatched in frequency. In the second
   experiment, auditory-filter bandwidths were estimated using a
   notched-noise masking paradigm. The correspondence between objective and
   behavioral estimates of cochlear response times was examined. An inverse
   relationship between the ABR latencies and the filter bandwidths could
   be demonstrated as the result of the larger across-listener variability
   among the hearing-impaired listeners, as compared to the normal-hearing
   listeners. The results might be useful for a better understanding of how
   hearing impairment affects the spatiotemporal cochlear response pattern
   in human listeners.},
