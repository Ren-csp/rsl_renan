@article{ WOS:000278156300014,
Author = {Wang, Jing-song and Hu, Xin-jiang and Liu, Yun-guo and Xie, Shui-bo and
   Bao, Zheng-lei},
Title = {Biosorption of uranium (VI) by immobilized Aspergillus fumigatus
   beads},
Journal = {JOURNAL OF ENVIRONMENTAL RADIOACTIVITY},
Year = {2010},
Volume = {101},
Number = {6, SI},
Pages = {504-508},
Month = {JUN},
Note = {9th International Conference on Biogeochemistry of Trace Elements,
   Beijing, PEOPLES R CHINA, JUL, 2007},
Abstract = {Biosorption of uranium (VI) ions by immobilized Aspergillus fumigatus
   beads was investigated in a batch system. The influences of solution pH,
   biosorbent dose, U (VI) concentration, and contact time on U (VI)
   biosorption were studied. The results indicated that the adsorption
   capacity was strongly affected by the solution pH, the biosorbent dose
   and initial U (VI) concentration. Optimum biosorption was observed at pH
   5.0, biosrobent dose (w/v) 2.5\%, initial U (VI) concentration 60 mg
   L-1. Biosorption equilibrium was established in 120 min. The adsorption
   process conformed to the Freunlich and Temkin isothermal adsorption
   models. The dynamic adsorption model conformed to pseudo-second order
   model. (C) 2010 Elsevier Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
