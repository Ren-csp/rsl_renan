@article{ WOS:000225871300007,
Author = {Cholewiak, RW and Brill, JC and Schwab, A},
Title = {Vibrotactile localization on the abdomen: Effects of place and space},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2004},
Volume = {66},
Number = {6},
Pages = {970-987},
