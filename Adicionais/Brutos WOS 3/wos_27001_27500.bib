Title = {The Harmonic Organization of Auditory Cortex},
Booktitle = {NEUROPHYSIOLOGICAL BASES OF AUDITORY PERCEPTION},
Year = {2010},
Pages = {211-222},
Note = {15th International Symposium on Hearing, Salamanca, SPAIN, JUN 01-05,
   2009},
Organization = {Med Elect; Hear Life},
Abstract = {Harmonicity is a unique feature of human speech, animal vocalizations,
   music, and many other natural or man-made sounds. Experimental evidence
   has shown that many neurons in the primary auditory cortex exhibit
   characteristic responses to harmonically related frequencies, in the
   form of facilitation and inhibition. Recent neurophysiology and imaging
   experiments have identified regions of nonprimary auditory cortex in
   humans and nonhuman primates that have selective responses to harmonic
   pitches. In this chapter, I propose that a fundamental organizational
   principle of auditory cortex is based on the harmonic structure of
   sounds.},
