@inproceedings{ WOS:000290883800052,
Author = {Agus, Trevor R. and Beauvais, Marion and Thorpe, Simon J. and
   Pressnitzer, Daniel},
Editor = {LopezPoveda, EA and Palmer, AR},
Title = {The Implicit Learning of Noise: Behavioral Data and Computational Models},
