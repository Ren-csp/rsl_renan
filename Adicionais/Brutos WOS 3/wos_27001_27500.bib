@article{ WOS:000078365900011,
Author = {Desain, P and Honing, H and vanThienen, H and Windsor, L},
Title = {Computational modeling of music cognition: Problem or solution?},
Journal = {MUSIC PERCEPTION},
Year = {1998},
Volume = {16},
Number = {1},
Pages = {151-166},
Month = {FAL},
Note = {Workshop on Language and Music Processing, MARSEILLE, FRANCE, SEP 28-30,
   1997},
Abstract = {The central purpose of this paper is to elaborate on the methods for
   computational modeling and to show how, although computational modeling
   should in principle be instrumental in the understanding of the
   structure of musical knowledge and the processes involved in music
   cognition, in practice it too often degenerates into a loose ``if you
   want to understand the theory, here, look in my program{''} approach. We
   will show how many issues cannot be decided by inspecting computer
   programs as they are written nowadays, and we will indicate a possible
   solution, giving examples from the field of music cognition research.},
