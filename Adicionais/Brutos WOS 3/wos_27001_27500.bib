@inproceedings{ WOS:000255589500019,
Author = {Zhong Lifeng},
Editor = {Zhang, Y},
Title = {Psychological capital and employees' working performance: The moderating
   effects of traditionality},
Booktitle = {PROCEEDINGS OF THE 2ND EURO-ASIA CONFERENCE ON ENVIRONMENT AND CORPORATE
   SOCIAL RESPONSIBILITY: TECHNOLOGICAL INNOVATION AND MANAGEMENT SECTION},
Year = {2008},
Pages = {152-161},
Note = {2nd Euro-Asian Conference on Environment and Corporate Social
   Responsibility, Bangkok, THAILAND, OCT 12-13, 2007},
Organization = {TU Bergakademie Freigerg; King Mongkuts Inst Technol Ladkrabang; German
   Acad Exchange Serv Fdn; Germany Embassy Thailand; Thai Govt},
Abstract = {With a sample of 192 supervisor-subordinate dyads from the People's
   Republic of China, this study empirically examined the effects of
   psychological capital on employees' work performance and organizational
   citizenship behavior, tested the moderating effects of traditionality on
   the relationship between psychological capital and employees'
   work-related outcomes. The results indicates that after controlling for
   the demographic variables (gender, age, and education), employees'
   psychological capital was positively correlated with employee working
   performance and organizational citizenship behavior. In addition,
   traditionality moderated the relationship between psychological capital
   and employee's working performance, such that employees' traditional
   value levels attenuated the positive relationships between psychological
   capital and employees'work performance and organizational citizenship
   behavior. At the end of the paper, implications for future research were
   offered.},
