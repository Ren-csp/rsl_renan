@article{ WOS:A1990FA49600085,
Author = {ZWOZDZIAK, JW and ZWOZDZIAK, AB},
Title = {SULFATE AEROSOL PRODUCTION IN THE UPPER PARTS OF THE SUDETY RANGE,
   POLAND},
Journal = {JOURNAL OF AEROSOL SCIENCE},
Year = {1990},
Volume = {21},
Number = {1},
Pages = {S369-S372},
Note = {1990 EUROPEAN AEROSOL CONF, ZURICH, SWITZERLAND, OCT 01-05, 1990},
Organization = {GESELL AEROSOLFORSCH; ETH},
Abstract = {SO2, total sulphur and sulphate in atmospheric aerosols were measured in
   a mountainous area.  The percentage of particle sulphur in the total
   sulphur measured was higher than that for other parts of Europe.  The
   highest values were recorded during the inflow of maritime-polar air
   masses from western sectors.  We conclude that SO2 from the mixing layer
   undergoes a burst of sulphate ions formation as the air ascends up the
   mountains.  The high extent of conversion (up to 75\%) observed in the
   periods of high humidity (above 90\%), low temperature (below
   10-degrees-C), and persistance of non-raining stratus clouds over the
   summits suggests that aqueous reactions of SO2 with H2O2 tend to
   dominate in sulphate ions production in the region of interest.},
