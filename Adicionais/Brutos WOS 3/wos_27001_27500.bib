@inproceedings{ WOS:001589751800315,
Author = {Victoria Moragues Gomez, Maria and Diaz Carrasco, Pilar and Clavero
   Gilabert, Maria and Ortega Sanchez, Miguel and Angel Losada Rodriguez,
   Miguel},
Editor = {Calvo, L},
Title = {CLIMATE CHANGE IMPACT ON THE HYDRAULIC PERFORMANCE OF BREAKWATERS},
