@article{ WOS:000237139000002,
Author = {Bertenthal, BI and Longo, MR and Kosobud, A},
Title = {Imitative response tendencies following observation of intransitive
   actions},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2006},
Volume = {32},
