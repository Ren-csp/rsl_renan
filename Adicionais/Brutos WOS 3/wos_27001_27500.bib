@inproceedings{ WOS:000075224700024,
Author = {Whittier, J and Thomas, HM},
Editor = {Magoon, OT and Converse, H and Baird, B and MillerHenson, M},
Title = {Biodiesel fuels for marine applications},
Booktitle = {CALIFORNIA AND THE WORLD OCEAN `97 - TAKING A LOOK AT CALIFORNIA'S OCEAN
   RESOURCES: AN AGENDA FOR THE FUTURE, VOLS 1 AND 2, CONFERENCE
   PROCEEDINGS},
Year = {1998},
Pages = {165-174},
Note = {California and the World Ocean 97 Conference on Taking a Look at
   Californias Ocean Resources - An Agenda for the Future, SAN DIEGO, CA,
   MAR 24-27, 1997},
Abstract = {Biodiesel fuels are emerging as preferred alternative fuels in select
   market niches. Biodiesel fuel has several unique benefits which may be
   of important and significant value: in certain engine markets,
   particularly in the marine environment. In general, regulatory pressures
   are instrumental in the decision to adopt biodiesel. The Oil Pollution
   Act of 1990 has enacted specific and potentially costly burdens on the
   marine market in connection with fuel spills. Biodiesel fuel
   characteristics may make it an attractive alternative to conventional
   diesel fuels to avoid damage and tort liability.
   Biodiesel is typically derived from vegetable oils, although animal fats
   are also considered a feedstock, and is viewed as a renewable,
   indigenous resource. Biodiesel may be used as a neat fuel or blended
   with petrodiesel and used directly in diesel engines with little or no
   modifications. Blends of biodiesel and petrodiesel are also less toxic
   than petrodiesel. Biodiesel fuel is also biodegradable, and in the event
   of leakage or fuel spills, is rapidly degraded. Other biodiesel
   environmental advantages include virtually no SOx emissions, reduced
   particulate emissions, reduced exposure to carcinogens released from
   combustion of petrodiesel, increased lubricity, ease of cleaning spills,
   ``less noxious{''} odors associated with combustion and perception as a
   ``green{''} product.
   Widespread adoption of biodiesel is not anticipated in the near future
   because of multiple difficulties involved in introducing alternative:
   fuels. Market barriers include higher price relative to conventional
   fuels, lack of a supply infrastructure, regulatory uncertainty, and
   negligible consumer awareness. Visible, practical actions by public and
   private organizations will assist market development for biodiesel
   fuels. Regulatory, agencies require information regarding biodiesel
   market and technical characteristics to foster decision making processes
   that affect public policy. private firms desire information addressing
   consumer acceptance and market demand for biodiesel. Consumers have
   limited knowledge of hii,diesel as an alternative fuel for engines and
   want access to information regarding the advantages and disadvantages of
   biodiesel.
   California recreational and commercial harbors are a logical market for
   the introduction of biodiesel. Fragile ecological systems coupled with a
   considerable and diverse boat population creates pressures that are
   posing increasing challenges for those who fish and swim in coastal
   waters. Regulatory agencies are empowered to find solutions to address
   environmental and other social issues. Private sector initiatives to
   provide environmentally-compatible: fuels require cooperation from
   public sector entities to achieve broad societal goals. A broad-based
   trial of biodiesel in select ports has merit to gather information that
   will help to shape public and private actions.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
