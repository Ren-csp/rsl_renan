@inproceedings{ WOS:000404788200001,
Author = {Kurniawan, Tonni Agustiono and Larita, L.},
Editor = {Dunn, CN and VanWeele, B},
Title = {Treatment of Stabilized Landfill Leachate Using Ozone-Treated Coconut
   Shell Waste},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2017: WATER,
   WASTEWATER, AND STORMWATER; URBAN WATERSHED MANAGEMENT; AND MUNICIPAL
   WATER INFRASTRUCTURE},
Year = {2017},
Pages = {1-11},
Note = {17th Annual World Environmental and Water Resources Congress,
   Sacramento, CA, MAY 21-25, 2017},
Organization = {Amer Soc Civil Engineers; Amer Soc Civil Engineers, Environm \& Water
   Resources Inst},
Abstract = {This study investigates the performances of granular activated carbon
   (GAC) in batch studies for the removal of refractory compounds and NH3-N
   using raw leachate from a local landfill (China). The adsorbent was made
   up of coconut shell waste. The surface modification of GAC with ozone
   was undertaken to improve its performance. The results showed that
   ozone-modified GAC removed COD (75\%) and/or NH3-N (74\%), compared to
   as-received GAC (COD: 43\%; NH3-N: 50\%) at the same COD and/or NH3-N
   concentration of 8,000 and 2,620 mg/L, respectively at 30 g/L of dose,
   pH 8 (for COD removal) or pH 9 (for NH3-N removal), 200 rpm of agitation
   speed and 20 min of contact time. However, treatment using
   ozone-modified GAC still could not generate effluents that complied with
   the COD and the NH3-N effluent limit of lower than 200 and 5 mg/L
   respectively, suggesting that a subsequent treatment is still required
   to meet the legislation.},
