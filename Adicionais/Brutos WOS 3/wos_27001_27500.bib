@article{ WOS:000237718400009,
Author = {Chen, Nengwang and Hong, Huasheng and Cao, Wenzhi and Zhang, Yuzhen and
   Zeng, Yue and Wang, Weiping},
Title = {Assessment of management practices in a small agricultural watershed in
   Southeast China},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCE AND HEALTH PART A-TOXIC/HAZARDOUS
   SUBSTANCES \& ENVIRONMENTAL ENGINEERING},
Year = {2006},
Volume = {41},
Number = {7},
Pages = {1257-1269},
