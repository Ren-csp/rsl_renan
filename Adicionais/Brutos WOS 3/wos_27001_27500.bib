@inproceedings{ WOS:000484833100016,
Author = {Kubalikova, Lucie and Bajer, Ales and Drapela, Emil and Zapletalova,
   Dana and Kirchner, Karel and Balkova, Marie and Zagorsek, Kamil and
   Kuda, Frantisek and Rostinsky, Pavel},
Editor = {Fialova, J},
Title = {CULTURAL FUNCTIONS AND SERVICES OF GEODIVERSITY WITHIN URBAN AREAS (WITH
   A SPECIAL REGARD ON TOURISM AND RECREATION)},
Booktitle = {PUBLIC RECREATION AND LANDSCAPE PROTECTION - WITH SENSE HAND IN HAND...},
