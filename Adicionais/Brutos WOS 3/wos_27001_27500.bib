@inproceedings{ WOS:000280689300005,
Author = {Sun Ye and Yan Dezhi and Liu Na},
Editor = {Zhang, H and Zhang, H},
Title = {Research on the Relationship between Urbanization and Economic
   Development in Shandong Province},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {21-25},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Based on the data from 1952 to 2007, this article empirically explored
   the relationship between urbanization and economic development in
   Shandong Province by multivariable VAR model. The results indicated that
   the urbanization level and economic development had long-term
   co-integration relationship. The effect of economic development to
   urbanization was stronger than that of urbanization to economic
   development. And the effect of economic development to urbanization was
   obvious in the long-term compared to that in the short-term: Economic
   development was the Granger causality to urbanization, but urbanization
   was not the Granger causality to economic development. The response of
   urbanization to its own one standard deviation innovation became weaker
   and weaker gradually, while its response to the impulse of economic
   development became stronger and stronger. This article suggested that
   government should impel economy develop vigorously on the one hand in
   order to promote urbanization. On the other hand, government should
   strengthen city plan management and format better interaction mechanism
   between urbanization and economic development.},
