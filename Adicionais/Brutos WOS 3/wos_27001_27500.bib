@inproceedings{ WOS:000313637300106,
Author = {Hu, J. and Wang, K. and Gaunt, J. A.},
Editor = {Teng, JG},
Title = {MIX DESIGN OF CONCRETE MADE WITH ALL RECYCLED AGGREGATE FROM
   DECONSTRUCTED LEAD-CONTAMINATED MASONRY BUILDINGS},
Booktitle = {PROCEEDINGS OF THE FIRST INTERNATIONAL CONFERENCE ON SUSTAINABLE
   URBANIZATION (ICSU 2010)},
Year = {2010},
Pages = {845-852},
Note = {1st International Conference on Sustainable Urbanization (ICSU), Hong
   Kong Polytechn Univ, Fac Construct \& Environm, Hong Kong, PEOPLES R
   CHINA, DEC 15-17, 2010},
Organization = {Hong Kong Polytechn Univ, Fac Construct \& Land Use; Inst Urban
   Environm; Road King Infrastructure Ltd; Sun Hung Kai Properties; Chun Wo
   Dev Holdings Ltd; K C Wong Educ Fdn; Environm \& Conservat Fund; Gammon;
   Paul Y; Architecture Design \& Res Grp Ltd (AD+RG); China State
   Construct (CSCEC); Sino Grp; Vantage Int (Holdings) Ltd; ASCE Hong Kong
   Sect; ASHRAE Hong Kong Chapter; CIBSE; Construct Ind Council (CIC);
   Chartered Inst Bldg (CIOB); Council Sustainable Dev; Emerald; Hong Kong
   Inst Architects; Hong Kong Institut Engineers; Hong Kong Inst Surveyors;
   HKSTS; IUE; JSCE; RICS; Urban Planning Soc China; China Civil Engn Soc;
   Hong Kong Inst Util Specialists},
Abstract = {The present study is to develop an effective method for using
   deconstructed, lead-contaminated masonry materials in new concrete so as
   to minimize the environmental impact, cost, and time of the
   deconstruction. The approach to this method is to simply use crushed
   masonry materials, without sieving and re-grading process, to replace
   all natural aggregate in conventional concrete. The challenge of this
   approach is to design proper mix proportions so that the new concrete
   will not only have no toxicity but also meet structural and
   constructability requirements. In the present study, two different types
   of masonry materials (concrete blocks and clay bricks) were collected,
   painted with lead-based paint (LBP), and then crushed to simulate
   recycled LBP-contaminated masonry materials. Physical properties (such
   as specific gravity, absorption, gradation, and voids) as well as total
   and leachable lead in the masonry materials were measured. Three types
   of cement (type I portland cement, calcium sulfoaluminate (CSA) cement,
   and portland cement with 5\% phosphate addition) were selected for
   sequestering lead in the recycled aggregate. A concrete mix design
   matrix was developed with different water-to-cement ratios (w/c),
   aggregate-to-cement ratios (a/c), types of cements, and types of masonry
   materials. The concrete mixtures were designed and manufactured to have
   three different levels of workability (low, medium, and high). The
   compressive strength of the concrete was tested at different ages (3, 7,
   and 28 days). Based on the test results, mix design nomographs were then
   developed for concrete made with the recycled, LBP-contaminated masonry
   materials. Using the mix design nomographs, field engineers can simply
   design concrete mix proportions to reach required workability and
   strength. The results indicate that the concrete made with all recycled
   aggregate from deconstructed masonry materials is suitable for various
   types of new construction, such as foundation and pavement, reinforced
   beams, columns, and walls. The study provides an insight on to effective
   use of deconstructed masonry materials in sustainable concrete
   construction.},
Publisher = {HONG KONG POLYTECHNIC UNIV, FAC CONSTRUCTION \& ENVIRONMENT},
