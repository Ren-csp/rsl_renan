@article{ WOS:000232837100024,
Author = {Olah, B and Zigrai, F},
Title = {The meaning of the time-spatial transformation of the landscape for its
   sustainable use (a case study of the transition zone of the Pol'ana
   Biosphere Reserve)},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2004},
Volume = {23},
Number = {1},
Pages = {231-243},
Note = {13th International Symposium on Problems of Landscape Ecological
   Research, Mojmirovce, SLOVAKIA, SEP 30-OCT 03, 2003},
Organization = {Slovak Acad Sci, Inst Landscape Ecol; Austrian Inst E \& SE European
   Studies Vienna, Branch Off Bratislava},
Abstract = {In the first part of the paper there are presented main theoretical
   principles of the time-spatial transformation of the landscape and its
   possible influence on biosphere reserve zones along with the references
   for future theoretical-methodical approach to this issue. The
   time-spatial potential and its parts as continuity, inertia and time
   accumulation potential are considered to be very important phenomenon in
   the development of the cultural landscape. In the second part this paper
   presents an approach to the study of the transformation of the Pol'ana
   Biosphere Reserve cultural landscape (its transition zone) and its
   meaning for the sustainable use. The time-spatial potential of the
   landscape was identified by multitemporal analyses of historical maps.
   The overlay of these maps in GIS resulted into following categories of
   land use changes: 1. no change (the highest stability), 2. occasional
   change (medium stability), and 3. permanent change (the lowest
   stability). An intensity of the occurred change (in sense of the
   distance between natural and anthropogenic land use forms) was also
   examined. The most stable areas (with no change) were situated on the
   lowest and the highest parts of the study area. On the other hand the
   most labile areas (with permanent changes) laid mostly where mountain
   and lowland zones meet. The most stable areas overlaid with physical
   conditions in the form of a geo-complex model indicate a strong mutual
   relationship. These areas also represent the spots with the highest
   time-spatial potential of the landscape and should therefor be the core
   areas for the management of the cultural landscape.},
