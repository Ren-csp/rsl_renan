@article{ WOS:000247836000003,
Author = {Moon, Graham and Quarendon, Gemma and Barnard, Steve and Twigg, Liz and
   Blyth, Bill},
Title = {Fat nation: Deciphering the distinctive geographies of obesity in
   England},
