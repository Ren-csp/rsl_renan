@article{ WOS:000242678900015,
Author = {Lee, S. H. and Lee, B. C. and Moon, S. Y. and Choi, Y. S. and Jang, N.
   Y. and Watanabe, Y.},
Title = {Evaluation of a MF membrane system composed of pre
   coagulation-sedimentation and chlorination for water reuse},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
