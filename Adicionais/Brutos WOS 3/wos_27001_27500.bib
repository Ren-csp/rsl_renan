@article{ WOS:000166819200006,
Author = {Ortells, JJ and Abad, MJF and Noguera, C and Lupiáñez, J},
Title = {Influence of prime-probe stimulus onset asynchrony and prime precuing
   manipulations on semantic priming effects with words in a
   lexical-decision task},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2001},
Volume = {27},
Number = {1},
Pages = {75-91},
