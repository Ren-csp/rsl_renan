@article{ WOS:000235273600028,
Author = {Ujang, Z and Soedjono, E and Salim, MR and Shutes, RB},
Title = {Landfill leachate treatment by an experimental subsurface flow
   constructed wetland in tropical climate countries},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
