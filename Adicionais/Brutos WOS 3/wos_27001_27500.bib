@inproceedings{ WOS:A1997BJ63S00017,
Author = {Silva, TC and Guevarra, DS and Orcullo, CV and Alamban, RB},
Editor = {Salokhe, VM},
Title = {Adaptation of the electrostatic ultra low volume-controlled droplets
   application (ULV-CDA) sprayer in the Philippines},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL WORKSHOP ON SAFE AND EFFICIENT
   APPLICATION OF AGRO-CHEMICALS AND BIO-PRODUCTS IN SOUTH AND SOUTHEAST
   ASIA},
Year = {1997},
Pages = {185-194},
Note = {International Workshop on Safe and Efficient Application of
   Agro-Chemicals and Bio-Products in South and Southeast Asia, BANGKOK,
   THAILAND, MAY 28-30, 1997},
Organization = {FAO, Agr Support Syst Div; Asian Inst Technol},
Abstract = {A pilot model of the electrostatic ultra low volume-controlled droplets
   application (ULV-CDA) sprayer was obtained from the Asian Institute of
   Technology (AIT) in Bangkok, Thailand and a limited adaptability testing
   was made under Philippine conditions. Four (4) sites were selected as
   pilot test areas. The study revealed that the ULV-CDA sprayer had an
   average density of 28.90 droplets per square centimeter as against 93.91
   in the case of the traditional knapsack sprayer (TKS). The average
   spraying time spent was 5.53 hours per hectare for the TKS and 6.24
   hours per hectare for the ULV-CDA sprayer.
   The average spray solution consumption on the 350 square meter plot was
   8,383 milliliters with the use of the TKS as against only 633
   milliliters for the ULV-CDA sprayer. The higher amount of insecticidal
   solution consumed with the use of TKS resulted in a higher cost of spray
   solution. Differences in insect mortality rates at the test sites were
   presumed to be mainly due to the two devices used in applying the spray
   solution, and on this premise, the TKS outperformed the ULV-CDA sprayer
   as observation revealed that the TKS claimed a mortality rate of 77.4
   per cent as compared to the ULV-CDA sprayer with only 67.26 per cent.
   The pulse rate of the operator of TKS rose from 77 to 92 (beats per
   minute) whereas the operator for the ULV-CDA sprayer registered a
   minimal increase in pulse rate from 75 to 77 (beats per minute).
   The qualitative data as well as questionnaire outcomes indicated the
   operators' as well as farmers' perception on the use of the ULV-CDA
   sprayer, among which are its light weight, ease of operation, uniformity
   of droplets, portability, and its suitability to low-height crops like
   water melon, soybeans, vegetables and corn. While it yielded
   appreciative comments, the questionnaire also generated
   suggestions/recommendations like the need for a belt strap (to improve
   ease of operation) and higher capacity battery system (for longer usage)
   and a more efficient motor/power system for economic reasons.
   The substantial amount of savings can offset the initial cost difference
   when the ULV-CDA sprayer is used (in lieu of TKS) over an area of about
   5.62 hectares. Using the same parameter and barring any breakdown, usage
   of the ULV-CDA sprayer over an area of about 10 hectares results in a
   payback on the initial investment made. On the whole, the project
   results have shown that the ULV-CDA sprayer is locally adaptable.},
Publisher = {ASIAN INST TECHNOLOGY},
