@article{ WOS:A1993LE26300003,
Author = {BENNETT, PJ},
Title = {THE HARMONIC BANDWIDTH OF PHASE-REVERSAL DISCRIMINATION},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1993},
Volume = {53},
Number = {3},
Pages = {292-304},
Month = {MAR},
Note = {MEETING OF THE ASSOC FOR RESEARCH IN VISION AND OPHTHALMOLOGY, SARASOTA,
   FL, 1990},
Organization = {ASSOC RES VIS \& OPHTHALMOL},
Abstract = {Previous studies have shown that 180-degrees relative phase shifts in f
   + 2f gratings are discriminated when the cosine or the sine component of
   the shift exceeds some criterion (Bennett \& Banks, 1987; Field \&
   Nachmias, 1984). The current experiments demonstrate that this result
   holds for other two-component gratings, provided that the components are
   within two to three octaves of each other. For frequency differences
   greater than two to three octaves, phase-reversal discrimination is
   impossible. A simple model that discriminates phase shifts on the basis
   of changes in the responses of even- and odd-symmetric spatial filters
   can account for the results.},
