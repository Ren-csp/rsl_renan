@inproceedings{ WOS:000290883800047,
Author = {Carlyon, Robert P. and Thompson, Sarah K. and Heinrich, Antje and
   Pulvermuller, Friedemann and Davis, Matthew H. and Shtyrov, Yury and
   Cusack, Rhodri and Johnsrude, Ingrid S.},
