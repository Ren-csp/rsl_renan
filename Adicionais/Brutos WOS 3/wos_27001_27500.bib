@inproceedings{ WOS:000560708000113,
Author = {Rutkiewicz, Pawel and Malik, Ireneusz},
Book-Group-Author = {IOP},
Title = {Historical Reconstruction of the Scarcely Recognized Metallurgical
   Activity in Poland},
Booktitle = {WORLD MULTIDISCIPLINARY EARTH SCIENCES SYMPOSIUM (WMESS 2018)},
