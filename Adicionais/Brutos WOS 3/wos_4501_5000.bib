@article{ WOS:000268055400007,
Author = {Dasborough, Marie T. and Ashkanasy, Neal M. and Tee, Eugene Y. J. and
   Tse, Herman H. M.},
Title = {What goes around comes around: How meso-level negative emotional
   contagion can ultimately determine organizational attitudes toward
   leaders},
Journal = {LEADERSHIP QUARTERLY},
Year = {2009},
Volume = {20},
Number = {4, SI},
Pages = {571-585},
Month = {AUG},
Note = {Conference on Meso-Modeling of Leadership - Integrating Micro-and Macro
   -Perspectives of Leadership, Texas Tech Univ, Rawls Coll Business,
   Lubbock, TX, OCT 11, 2007},
Abstract = {We present a follower-centric model of leadership that integrates
   multiple levels of analysis, and includes emotional contagion as a key
   meso-level process. In our model, leadership at the individual level is
   manifested in terms of the leader's favoritism toward members and
   affective displays. Drawing upon affective events theory, we argue that
   member perceptions of a leader's behaviors and member attributions of
   insincerity result in negative emotions. Through a process of emotional
   contagion, the negative emotions then spread to other individuals in the
   group. These are in turn reflected in the group's affective climate and
   trust climate, and also in the quality of leader-member and team-member
   relationships. In the end, this results in organizational-level
   disapproval of the leader and cynicism towards the leader. Included as
   moderators in the model are task interdependence, the temporal context,
   reward systems, emotional labor requirements, organizational culture,
   and power distance. We conclude with a discussion of boundary
   conditions, and implications of our model for research, theory, and
   practice. (C) 2009 Elsevier Inc. All rights reserved.},
Publisher = {ELSEVIER SCIENCE INC},
Address = {STE 800, 230 PARK AVE, NEW YORK, NY 10169 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Dasborough, MT (Corresponding Author), Univ Miami, Coral Gables, FL 33124 USA.
   Dasborough, Marie T., Univ Miami, Coral Gables, FL 33124 USA.
   Ashkanasy, Neal M.; Tee, Eugene Y. J., Univ Queensland, Brisbane, Qld 4072, Australia.
   Tse, Herman H. M., Griffith Univ, Nathan, Qld 4111, Australia.},
DOI = {10.1016/j.leaqua.2009.04.009},
ISSN = {1048-9843},
EISSN = {1873-3409},
Keywords = {Emotional contagion; Follower-centric leadership; Meso-level processes;
   Negative emotions},
Keywords-Plus = {TEAM-MEMBER EXCHANGE; AFFECTIVE EXPERIENCES; BEHAVIORAL INTEGRITY;
