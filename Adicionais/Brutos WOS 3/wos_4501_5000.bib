Title = {Sulfur-arsenic interactions and formation of thioarsenic complexes in
   the environment},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
