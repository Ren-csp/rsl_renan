@inproceedings{ WOS:000357835100144,
Author = {Ambarova, P.},
Book-Group-Author = {SGEM},
Title = {THE TEMPORAL BEHAVIOR STRATEGIES OF AVANT-GARDE URBAN COMMUNITIES},
Booktitle = {PSYCHOLOGY AND PSYCHIATRY, SOCIOLOGY AND HEALTHCARE, EDUCATION, VOL II},
Series = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts},
Year = {2014},
Pages = {1129-1136},
Note = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts (SGEM 2014), Albena, BULGARIA, SEP 01-10, 2014},
Organization = {Bulgarian Acad Sci; Acad Sci Czech Republ; Latvian Acad Sci; Polish Acad
   Sci; Russian Acad Sci; Serbian Acad Sci \& Arts; Slovak Acad Sci Intro;
   Natl Acad Sci Ukraine; Natl Acad Sci Armenia; Sci Counc Japan; World
   Acad Sci TWAS; European Acad Sci, Arts \& Lett; Acad Fine Arts Zagreb
   Croatia; Croatian Acad Sci \& Arts; Acad Sci Moldova; Montenegrin Acad
   Sci \& Arts; Georgian Acad Sci; Acad Fine Arts \& Design Bratislava;
   Russian Acad Arts; Turkish Acad Sci; SGEM},
Abstract = {The article substantiates the idea that urban communities, called
   avant-garde, produce special strategies, the core of which is the
   special attitude to the social time. Such strategies can be called
   temporal. They are the foundation of innovation, mobility and success of
   representatives of these social groups. Actuality of the study of the
   temporal behaviour strategies is determined by attention to such leading
   communities (and their separate strata), as students, volunteers,
   business community, freelancers. The purpose of the study is to
   investigate the linkage between social features of community as the
   degree of avant-gardism and temporal characteristics; identification of
   types of temporal behaviour strategies and complex of conditions in
   which they are formed. The role of fundamental factor, as it seems to
   the author, belong to the urban environment, creating a special
   structure of time, space, life. The problem standing in the center of
   research attention, is a contradiction between the temporal behavior of
   avant-garde social communities and temporality of traditional social
   institutions, practices, communities that also form the structure of the
   modem city. The temporal behavior strategies of social communities are
   show as key features of avant-gardism. The article is considered concept
   of temporal strategies behavior in different sociological theories.
   Shows the importance of non-classical theories in the formation of ideas
   about meaningful, symbolic structures, dispositions that manage the
   temporal behaviour of social actors. Possibilities of analyzing the
   temporal behaviour strategies are disclosed in the framework of
   integrative sociology, as well as theories and concepts that form the
   methodology of temporal analysis of nonlinear phenomena and processes.
   The article presents the structure of the temporal behaviour strategies,
   their place in the system of life orientation. A theoretical typology
   temporal behaviour strategies based on the criteria of social activity
   and emotional perception of time. Disclosed understanding of
   nonlinearity of social time and shows its properties and their influence
   on the temporal behaviour of social actors. Methods of the research was
   typological analysis, secondary analysis of sociological data,
   questionnaires and in-depth interviews. A set of methods has allowed to
   reveal the dissemination of different temporal behavior strategies among
   representatives of the avant-garde of social communities in the Russian
   city, to determine the nature of their impact on social well-being of
   citizens in the conditions of nonlinear time.},
Publisher = {STEF92 TECHNOLOGY LTD},
Address = {1 ANDREY LYAPCHEV BLVD, SOFIA, 1797, BULGARIA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Ambarova, P (Corresponding Author), Ural Fed Univ, Ekaterinburg, Russia.
   Ural Fed Univ, Ekaterinburg, Russia.},
ISSN = {2367-5659},
ISBN = {978-619-7105-23-0},
Keywords = {avant-garde communities; temporal behavior strategies; nonlinear time},
