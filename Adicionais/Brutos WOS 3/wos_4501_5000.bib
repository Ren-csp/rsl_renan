Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {Urban-rural dual structure of land that implemented long-term in China
   has restricted the development of economic and society seriously. In
   order to protect farmland to improve the efficiency of land use, protect
   collective land ownership to achieve the interests of collective land
   ownership, and promote rural development to narrow urban-rural gap,
   establishing a unified construction land market is imperative.
   Meanwhile, Chinese government clearly puts forward establishing a
   unified construction land market gradually in The Third Plenary Session
   of The Seventeenth Central Committee in 2008. State Council of PRC takes
   deepening land management and establishing a unified market of
   construction land as one of the main reform tasks in 2010. By then,
   establishing a unified construction land market enters a new period. On
   the basic of analyzing the necessity and feasibility of establishing a
   unified construction land market, this paper thinks that the government
   should perform the functions that establishing a unified construction
   land market, perfecting rural land property system, reforming existing
   land expropriation system, strictly implementing the homestead
   management system and strengthening the protection of farmland.},
