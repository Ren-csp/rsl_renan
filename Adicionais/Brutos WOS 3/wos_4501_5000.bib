@article{ WOS:000181538700011,
Author = {Hong, SK and Song, IJ and Kim, HO and Lee, EK},
Title = {Landscape pattern and its effect on ecosystem functions in Seoul
   Metropolitan area: Urban ecology on distribution of the naturalized
   plant species},
