Title = {Study of Resourses, Ecological and Environmental Problems and the
   Corresponding Countermeasures of Villages in Cities in Guilin},
Booktitle = {NATURAL RESOURCES AND SUSTAINABLE DEVELOPMENT II, PTS 1-4},
