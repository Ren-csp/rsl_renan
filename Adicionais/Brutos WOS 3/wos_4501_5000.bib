@article{ WOS:A1995TL04400006,
Author = {Smoreda, Z},
Title = {Power, gender stereotypes and perceptions of heterosexual couples},
Journal = {BRITISH JOURNAL OF SOCIAL PSYCHOLOGY},
Year = {1995},
Volume = {34},
