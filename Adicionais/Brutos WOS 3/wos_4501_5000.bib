@inproceedings{ WOS:000410925400092,
Author = {Thoidou, Elisavet},
Editor = {Bikas, D and Theodosiou, T and Katerina, T},
Title = {Climate Adaptation Planning: The context of EU Cohesion Policy and
   Evidence from Urban Projects in Greece},
Booktitle = {SUSTAINABLE SYNERGIES FROM BUILDINGS TO THE URBAN SCALE},
Series = {Procedia Environmental Sciences},
