@inproceedings{ WOS:000391044200005,
Author = {Santos-Vega, Mauricio and Martinez, Pamela P. and Pascual, Mercedes},
Editor = {Rodo, X},
Title = {Climate forcing and infectious disease transmission in urban landscapes:
   integrating demographic and socioeconomic heterogeneity},
Booktitle = {HUMAN HEALTH IN THE FACE OF CLIMATE CHANGE},
