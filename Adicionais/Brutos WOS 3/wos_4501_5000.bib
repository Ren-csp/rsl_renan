Note = {2nd International Conference on Sustainable Development and Planning,
   Bologna, ITALY, SEP 12-14, 2005},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {This article focuses on the effects of landscape changes that take place
   in the outskirts of towns and cities, with special focus on how pressure
   on land resources affects the preservation of cultural heritage and
   cultural-historical environments. The effects of modem housing projects
   and modern road building are significant in these areas. Hereby the
   traditional structures of farmsteads are diluted, and the historic
   structures of the landscape are erased. Cultural-historical areas on the
   suburban fringes have to be protected from fragmentation, and at the
   municipal planning level there is a growing understanding of the
   necessity to see wider spatial areas as a planning unity. However, in
   order to be able to counteract strong forces working in different
   directions, there is an urgent need to develop long-term strategies for
   handling cultural-historical environments areas situated on the
   peripheries of the big cities.},
