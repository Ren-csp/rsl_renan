Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {With the rapid development of the economic in China, the city is facing
   huge pressures in population and land. In order to achieve the
   sustainable development, city is forced to practice the
   Three-dimensional development. At present, there are air gardens,
   flyovers above the land and underground mall, underground parking, etc.
   By combining the status of the Three-dimensional development in China,
   this article analyzes a variety of contradictions in the development
   from different angles, especially for the use of underground space. For
   example, there are conttradiction between generality and particularity
   of the underground space resources and contradiction betwteen protection
   and damage to the environment in the Three-dimensional development. Then
   the article proposes some pertinent countermeasures and hopes to make
   reference on the Three-dimensional devellopment in China.},
