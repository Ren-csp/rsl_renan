Organization = {Soc Amer Foresters},
Abstract = {For 35 years Peace Corps has worked with developing countries to enhance
   environmental quality and improve the lives of local people. More than
   1000 Peace Corps Volunteers work full time on environmental projects,
   constituting one of the largest environmental work forces of any
   international development agency. Peace Corps' new environmental
   initiatives complement traditional assignments in reforestation,
   forestry extension, and park management. The need to conserve biological
   diversity is being addressed through the new ``Partnership for
   Biodiversity Project{''} which brings together Peace Corps, the U.S.
   Dept. of Interior, and the Agency for International Development. Peace
   Corps has significantly expanded its environmental education (EE) work
   to include the introduction of environmental themes into primary and
   secondary school curricula and the promotion of community-based EE
   targeting both adults and youth. Other new initiatives include the
   promotion of eco-tourism, enhancing the advocacy abilities of
   non-governmental environment organizations, and improving the urban
   environment.},
