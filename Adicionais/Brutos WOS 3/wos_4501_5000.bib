Year = {1999},
Pages = {37-42},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {Nineteenth-century research on weight perception between that of Weber
   and that of Charpentier is reviewed, but with more data than is
   available in Murray, Ellis, Bandomir and Ross (in press). In particular,
   some raw data of Fechner and of Muller and Schumann are presented in
   table form. It is clear that the study of judged heaviness was used in
   the nineteenth century more for the establishment of factual data on
   such psychological matters as the time error, the space error and the
   Einstellung (set) effect than it was for the validation of Fechner's
   Law. Some writers even expressed doubt that studies of weight perception
   could be useful for the validation of Weber's Law.},
