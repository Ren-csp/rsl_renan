@article{ WOS:000082257400019,
Author = {Erell, E and Tsoar, H},
Title = {Spatial variations in the aeolian deposition of dust - the effect of a
   city: a case study in Be'er-Sheva, Israel},
Journal = {ATMOSPHERIC ENVIRONMENT},
