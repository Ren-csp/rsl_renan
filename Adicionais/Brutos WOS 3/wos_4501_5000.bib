@inproceedings{ WOS:000170993500107,
Author = {Radic, Z and Vlahovic, M and Vlahovic, D},
Editor = {Moore, D and Hungr, O},
Title = {Engineering-geological model of terrain for urban planning - A case
   study from Neimar, Belgrade},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOL 6},
Year = {2000},
Pages = {4595-4600},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {Urban areas of the southern zone of Neimar (part of Belgrade) consist of
   clayey-marl and limestone and marl sediments covered with Quaternary
   sand clays of the deluvial-proluvial origin. Subsurficial layers consist
   of loess layer, covered with anthropogenic fill. Processing,
   characterization and data analysis of the site were performed so as to
   include them in the town planning documents, based on level of
   Regulation plan and according to the requirements for construction of
   certain structures. The aim of this paper is to evaluate parameters of
   particular soil environments, determine engineering-geological areas and
   develop a engineering-geological terrain model, on the basis of
   available data in this part of Belgrade. At the same time, the authors
   constructed the engineering-geological model of the terrain, with high
   degree of certainty bearing in mind the quantity and quality of existing
   data available from geotechnical investigations. The projection of area
   and the defined terrain model are performed digitally with the resulting
   3D projection. The model is also developed on the basis of parameters
   necessary for designing of building structures and engineering
   calculations.},
