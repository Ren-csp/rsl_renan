Title = {Urban Morphology, Comfort Conditions and Non-Ionizing Radiation in Home
   Offices Located on Heat Islands in the City of Joao Pessoa, Brazil},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 1, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {39},
