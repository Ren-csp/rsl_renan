Title = {Assessment of proposed business plans of on-trip and pre-trip
   information in the LRT system (public urban transit) of the city of
   Zagreb},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2008},
Volume = {101},
Pages = {77-86},
Note = {14th International Conference on Urban Transport and the Environment in
   the 21st Century, MALTA, 2008},
Organization = {Wessex Inst Technol; WIT Transact Built Environm},
Abstract = {The quality of public urban transit organization depends to a great
   extent also on the organization and the quality of on-trip and pre-trip
   information services. The aim of this service is to provide relevant,
   accurate and usable traffic and transport information to current users
   of the public urban transit, as well as to attract new users,
   alleviating the burden on the roads and insuring high-quality transport
   service to motorists who at least on one section of their trip use
   public transport means. Apart from classical information forms this
   system greatly relies also on new telecommunication technologies
   including the third generation of mobile networks and mobile Internet.
   Apart from the wide range of methods of collecting information, their
   processing and dissemination, the entire problems of introducing the
   mentioned services into the newly organized system such as LRT needs to
   be systemically analyzed. It is especially important to analyze in
   advance and to define the relations between the private and public
   sector in the described process. The paper considers the corporate plans
   of organizing the system of on-trip and pre-trip information in the LRT
   system applicable in the City of Zagreb. Their implementability has been
   evaluated by a professional team defining the relevant factors in the
   selection of the corporate plan.},
