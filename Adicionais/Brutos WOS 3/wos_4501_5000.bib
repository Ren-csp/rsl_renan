Title = {THE IMPACT OF ROOF GARDENS AT HIGH-RISE RESIDENTIAL BUILDINGS ON
   PROPERTY VALUES},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
