@inproceedings{ WOS:000085971000020,
Author = {Hamaguchi, K and Ishigaki, Y and Ishitani, K},
Editor = {Eguchi, K and Klastersky, J and Feld, R},
Title = {Patients' perceptions of palliation in Japan},
Booktitle = {CURRENT PERSPECTIVES AND FUTURE DIRECTIONS IN PALLIATIVE MEDICINE},
