Year = {1999},
Volume = {34},
Number = {4-5},
Pages = {633-652},
Note = {Symposium on Rural/Urban Continuum, UNIV KENTUCKY, LEXINGTON, KENTUCKY,
   OCT, 1996},
Organization = {Univ Kentucky},
Abstract = {Within the framework of the Health Belief Model, this paper examines
   correlates of perception of AIDS susceptibility among 846 drug-using
   migrant farm workers and their sex partners. Significant but relatively
   small differences by ethnicity and gender were found. The data showed a
   consistent significant statistical relationship between frequency of
   drug use, high-risk sexual behavior, and perception of AIDS
   susceptibility. Perception of AIDS susceptibility was significantly
   related to a subsequent reduction in sexual risk behaviors. Consistent
   with the Health Belief Model, the data suggest that increasing
   perception of AIDS susceptibility may be an important motivator in
   reducing high-risk behaviors.},
