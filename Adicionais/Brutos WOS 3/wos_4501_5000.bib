@inproceedings{ WOS:001589751800209,
Author = {Juan, Del-Rosal-Salido and Pilar, Diaz-Carrasco and Pedro, Magana and
   Maria, Clavero and Alejandro, Lopez-Ruiz and Losada Miguel, A. and
   Antonio, Monino and Maria, Neves G. and Rodolfo, Silva and Edgar,
   Mendoza and Sebastian, Solari and Manuel, Contreras and Miguel,
   Ortega-Sanchez},
