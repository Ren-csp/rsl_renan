@article{ WOS:000242289000003,
Author = {Goldman, Rhonda N. and Greenberg, Leslie S. and Angus, Lynne},
Title = {The effects of adding emotion-focused interventions to the
   client-centered relationship conditions in the treatment of depression},
Journal = {PSYCHOTHERAPY RESEARCH},
Year = {2006},
Volume = {16},
Number = {5},
Pages = {536-546},
Month = {OCT},
Note = {Annual Conference of Society-for-Psychotherapy-Research, BLOOMINGDALE,
   IL, JUN 23, 2000},
Organization = {Soc Psychotherapy Res},
Abstract = {A study was conducted to test the effects of adding emotion-focused
   interventions to the empathic relationship. The authors compared
   client-centered therapy, which provides an empathic relationship based
   on the relational attitudes of empathy, positive regard, and congruence,
   and emotion-focused therapy (EFT), which integrates process-guiding
   emotion-focused interventions that focus on depressogenic
   affective-cognitive problems with a client-centered supportive
   relationship. Thirty-eight patients meeting DSM-IV criteria for major
   depressive disorder were randomly assigned to 16 to 20 sessions of 1 of
   the 2 treatments. Clients' level of depressive symptoms, general symptom
   distress, interpersonal distress, and self-esteem improved in each
   condition, but improvement on symptornatology was superior in the EFT
   condition. An empathic relationship appears to be enhanced by the
   addition of specific emotion-focused interventions.},
