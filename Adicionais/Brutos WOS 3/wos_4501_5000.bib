@article{ WOS:000430591300029,
Author = {Stadlbauer, Christina and Taipale, Ulla},
Title = {Inter-species encounters at the ``Hexa-Hives{''}},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2018},
Volume = {30},
Pages = {280-285},
Month = {MAR},
Note = {Session on Strategic Gardening - Mobilizing Cultural Aspects of
   Gardening in Sustainable Development at the Conference on Cultures(s) in
   Sustainable Futures - Theories, Policies, Practices, Helsinki, FINLAND,
   MAY 06-08, 2015},
Abstract = {The Hexa-Hives illustrate how an outdoor live installation (landscaped
   garden installation) can serve as incentive for inter-species encounters
   and at the same time challenge the paradigm of conventional beekeeping.
   The Hexa-Hive is an experimental hive, designed to both host honeybees
   and serve as outdoor furniture for humans. Since 2012, the Hexa-Hive has
   been a semi-permanent installation in Kaisaniemi Botanic Garden of
   Helsinki.
   A further development, the Hexa-Hive Village was first installed at the
   campus of Aalto University, in Otaniemi, Finland in 2013. Launched as
   artistic intervention, the Hexa-Hive village became a landscaped area
   hosting honeybees and inviting people to hang out.
   In 2014, a further development - the installation ``Hexa-Hive Village
   with Airstrip for Bees{''} - was exhibited as part of the art exhibition
   ``Semi-Wild Gardens{''} at Kouvola city art museum and in 2016, the
   installation was placed in Tarja Halonen Park, a public area in the
   centre of Helsinki.
   The article explores the effects of the installation assessed via a
   questionnaire. The findings include the emergence of a ``garden
   quality{''} around the ``Hexa-Hive{''}, the increase of local faunal and
   floral diversity and the notion of wilderness in the city. The concept
   of urban acupuncture and the mental and psychological value of public
   gardens for humans are described as features of the installation.
   The Hexa-Hive is part of Melliferopolis and was launched in Helsinki in
   2012. The activities comprise exhibitions, workshops, installations and
   lectures. (C) 2016 Elsevier GmbH. All rights reserved.},
Publisher = {ELSEVIER GMBH, URBAN \& FISCHER VERLAG},
Address = {OFFICE JENA, P O BOX 100537, 07705 JENA, GERMANY},
