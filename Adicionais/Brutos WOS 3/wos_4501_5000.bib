@article{ WOS:000336964700027,
Author = {Kim, Jongin and Lee, Suh-Kyung and Lee, Boreom},
Title = {EEG classification in a single-trial basis for vowel speech perception
   using multivariate empirical mode decomposition},
Journal = {JOURNAL OF NEURAL ENGINEERING},
