@inproceedings{ WOS:000073221600108,
Author = {Limaye, SD},
Editor = {Chilton, J},
Title = {The role of Indian hydrogeologists in providing drinking water for the
   urban poor},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {621-624},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Urban residents in India usually receive their drinking water supply
   from municipal water supply network. However, influx of the rural
   population into urban areas in search of employment has resulted in
   rapid and unplanned growth of peri-urban settlements and slums, which
   are not connected to the water supply network. Surface water sources are
   polluted and cannot be used for drinking. Groundwater is also polluted
   to some degree due to seepage from septic tanks, peri-urban industrial
   effluents and irrigated farms. Hydrogeologists cannot exercise control
   over urban planning or the growth of slums. However, they can still help
   the urban poor and slum dwellers by locating proper sites for drinking
   water bore wells or dug wells, which would yield an adequate quantity of
   drinking water of acceptable quality.},
