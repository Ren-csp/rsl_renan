@article{ WOS:000242038900050,
Author = {Schmitt, T. G. and Huber, W. C.},
Title = {The scope of integrated modelling: system boundaries, sub-systems,
   scales and disciplines},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
Volume = {54},
