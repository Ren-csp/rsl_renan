@article{ WOS:000239526900009,
Author = {Van Kleef, Gerben A. and De Dreu, Carsten K. W. and Pietroni, Davide and
   Manstead, Antony S. R.},
Title = {Power and emotion in negotiation: Power moderates the interpersonal
   effects of anger and happiness on concession making},
