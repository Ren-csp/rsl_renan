Title = {Associations between risk perception and risk-taking behaviour},
Booktitle = {RISK, RELIABILITY AND SOCIETAL SAFETY, VOLS 1-3: VOL 1: SPECIALISATION
   TOPICS; VOL 2: THEMATIC TOPICS; VOL 3: APPLICATIONS TOPICS},
Series = {Proceedings and Monographs in Engineering Water and Earth Sciences},
Year = {2007},
Pages = {1631+},
Note = {European Safety and Reliability Conference (ESREL 2007), Univ Stavanger,
   Stavanger, NORWAY, JUN 25-27, 2007},
Organization = {Int Res Inst Stavanger; ESRA Norway; Statoil; Proactima/HSE Acad;
   Safetec; Conocophillips; DNV},
Abstract = {The core aim of the present paper is to examine determinants of
   risk-taking behaviour. According to Becker and Maiman's (1975) health
   belief model, perceived risk related to health threats may influence
   decisions about precautionary behaviour. Consequently, the association
   between risk perception and risk taking behaviour is also interesting to
   examine. Accordingly, the present study aims to test three hypotheses
   about the relation between risk perception and risk-taking behaviour.
   Triandis' (1977) attitude-behaviour model is one of a few social
   cognition models taking into account that past behaviour may influence
   present and future behaviour and several studies have given support to
   this idea. However, the model does not take into account that various
   types of behaviour may be associated and accordingly the present study
   also aims at examining such associations. The results of the present
   paper are based on self-completion questionnaire surveys carried out
   among employees in two industrial companies, including onshore as well
   as offshore personnel. The results showed that risk perception and
   risk-taking behaviour may be associated primarily because an identical
   set of predictor variables influence perception as well as behaviour and
   when controlled for it is no significant association between these two
   factors. In addition, we found that risk behaviour in traffic was
   positively associated with occupational risk taking and that risk
   behaviour during the leisure time also was associated with on-the-job
   risk taking behaviour.},
