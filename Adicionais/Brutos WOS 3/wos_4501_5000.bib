@article{ WOS:000245324900005,
Author = {Ayton, Peter and Pott, Alice and Elwakili, Najat},
Title = {Affective forecasting: Why can't people predict their emotions?},
Journal = {THINKING \& REASONING},
Year = {2007},
Volume = {13},
Number = {1},
Pages = {62-80},
Month = {FEB},
Note = {Workshop on The Work of Daniel Kahneman, London, ENGLAND, JAN, 2003},
Organization = {Econ \& Social Res Council Ctr Econ Learning \& Social Evolution},
Abstract = {Two studies explore the frequently reported finding that affective
   forecasts are too extreme. In the first study, driving test candidates
   forecast the emotional consequences of failing. Test failers
   overestimated the duration of their disappointment. Greater previous
   experience of this emotional event did not lead to any greater accuracy
   of the forecasts, suggesting that learning about one's own emotions is
   difficult. Failers' self-assessed chances of passing were lower a week
   after the test than immediately prior to the test; this difference
   correlated with the magnitude of individual immediate disappointments,
   suggesting the presence of a cognitive strategy for recovering from
   disappointments. A second study investigated the theory that undue focus
   on the differences between present and future biases affective
   forecasts. ``Defocusing{''} that induced low-level construals of the
   future reduced the extremeness of affective forecasts but a higher-level
   construal did not. We conclude that a focusing effect may bias affective
   forecasts.},
