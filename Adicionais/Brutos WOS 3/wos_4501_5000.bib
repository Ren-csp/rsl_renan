Organization = {Italian Syst Soc},
Abstract = {New types of apparent motion effects depending on continuities and
   discontinuities placed along continuous or discontinuous boundaries are
   here illustrated. These effects suggest that global grouping processes
   (i.e., proximity, good continuation) may affect the local motion
   signals, and they are affected by them. The bidirectional interaction
   between local and global motion signals may be considered as the
   phenomenal result of I feedback between local and global motion
   processes.},
