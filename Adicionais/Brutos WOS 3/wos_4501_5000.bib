Title = {Agency procedures for mitigating damage to cultural heritage in United
   States Federal and State Administrative Law},
Booktitle = {SUSTAINABLE CITY V: URBAN REGENERATION AND SUSTAINABILITY},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2009},
