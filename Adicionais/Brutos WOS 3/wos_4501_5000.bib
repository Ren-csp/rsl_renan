Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {Research involving full-cue viewing of targets on a textured ground
   plane supports the following conclusions-perception of egocentric
   distance is linear in physical distance and accurate out to at least to
   20 m, and 2-D shapes lying on the ground plane well within 20 m of the
   observer are systematically misperceived, with depth extents being
   perceived as shorter than physically equal frontal extents. This article
   reviews the relevant geometry of perspective information, discusses the
   evidence for the above conclusions, and proposes a possible processing
   explanation for reconciling the two conclusions.},
