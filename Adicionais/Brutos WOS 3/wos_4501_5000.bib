@inproceedings{ WOS:000222180700019,
Author = {Gemmill, ER and Pentz, NS and Powell, RO},
Editor = {Clar, M and Carpenter, D and Gracie, J and Slate, L},
Title = {The development of regional bankfull discharge regression curves from
   rural and urban stream streams in the Piedmont of Maryland and Delaware},
Booktitle = {PROTECTION AND RESTORATION OF URBAN AND RURAL STREAMS},
Year = {2004},
Pages = {189-201},
Note = {Symposium on Protection and Restoration of Urban and Rural Streams,
   Philadelphia, PA, JUN 23-25, 2003},
Organization = {Urban Water Resources Res Council, Urban Streams Comm; Waterways
   Council, River Restorat Comm; Amer Soc Civil Engineers, Environm \&
   Water Resources Inst},
Abstract = {Data from the field calibration of bankfull discharge in streams at 14
   USGS gaging stations in the Piedmont Region of Maryland and Delaware
   were analyzed. Two sets of regression curves were developed, rural
   (imperviousness < 11\%) and urban (imperviousness > 20\%), expressing
   the relationship of drainage area (DA) to bankfull discharge (Q(bf)) and
   to bankfull channel cross-sectional area (CXbf). In comparing rural with
   urban curves a tendency toward convergence at larger drainage areas was
   evident in the discharge curves, but not in the cross sectional area
   curves. From these curves discharge and enlargement ratios of urban to
   rural streams were calculated. Statistical descriptors of the above
   results indicate they may be applicable to ungaged Piedmont reaches in
   estimating Q(bf) and CXbf.},
