Organization = {Norsk Romsenter (Norwegian Space Ctr); Miljoverndepartementet; CIESIN;
   USGS; NASA; NOAA; UNEP; ESA; EUMETSAT; Kongsberg Spacetec AS; Space
   Applicat Inst; Joint Res Ctr European commiss; Tromso Satellite Stn AS;
   Space Imaging EOSAT; Norwegian Minist Environm},
Abstract = {Building density may be considered as an index of the evolution of urban
   growth. In this research, two classification methods based on the
   statistical approach of the texture analysis are developed for studying
   the building density. Texture analysis is applied a) on the Maximum
   Likelihood classification results, and b) on the Hue image derived from
   the Hue-Intensity-Saturation transformation. A SPOT XS image is used,
   The texture extraction concept is based on spatial frequency
   alternations of the texture primitives representing urban features.
   Three categories of building density - dense, medium, and sparse -
   result from the application of the proposed methods.},
