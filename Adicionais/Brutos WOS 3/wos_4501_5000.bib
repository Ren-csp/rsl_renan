@inproceedings{ WOS:000454405500009,
Author = {Csakvari, Judit and Gyori, Miklos},
Editor = {SikLanyi, C and Hoogerwerf, EJ and Miesenberger, K and Cudd, P},
Title = {Applicability of standard eye-tracking technique in people with
   intellectual disability: methodological conclusions from a series of
   studies},
Booktitle = {ASSISTIVE TECHNOLOGY: BUILDING BRIDGES},
Series = {Studies in Health Technology and Informatics},
Year = {2015},
Volume = {217},
Pages = {63-70},
Note = {13th European Conference on the Advancement of Assistive Technology
   (AAATE), Budapest, HUNGARY, SEP 09-12, 2015},
Organization = {Diamond Congress Ltd; John Neumann Comp Soc; Univ Pannonia, Lab Virtual
   Environm \& Imaging Technologies; Assoc Advancement Assist Technol Board
   \& Secretariat},
Abstract = {Although considerable amount of evidence suggest that info-communication
   technologies have important potential to promote higher level of
   adaptive functioning and more efficient learning in people with
   intellectual disability (ID), very little is known about how people with
   ID scan visually the visual user interfaces of digital tools.
   Eye-tracking technique is widely used to study visual scanning processes
   and is used more and more extensively in assistive and educational
   technologies, too. Therefore, it is important to explore and understand
   the limitations and potentials of applying eye-tracking technique in
   people with ID. The present paper aims this by analyzing data from 4
   studies (n=38/38 and n=15/30), via contrasting data from people with ID
   with data from neurotypical (NT) control subjects along 3 variables,
   indicative of the applicability of eye-tracking technique. Results
   strongly suggest that there are specific difficulties in using
   eye-tracking in people with ID, showing considerable individual
   variability but depending also on the nature of the actual task.
   Consequentially, using eye-tracking in this group expectedly requires
   special considerations and specific solutions.},
Publisher = {IOS PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Csákvári, J (Corresponding Author), ELTE Univ, Inst Psychol Special Needs, Ecseri Rd 3, H-1097 Budapest, Hungary.
   Csakvari, Judit; Gyori, Miklos, ELTE Univ, Inst Psychol Special Needs, Ecseri Rd 3, H-1097 Budapest, Hungary.},
DOI = {10.3233/978-1-61499-566-1-63},
