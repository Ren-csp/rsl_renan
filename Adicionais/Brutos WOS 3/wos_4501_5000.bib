@article{ WOS:000445018400003,
Author = {Affendi, Nik Rafidah Nik Muhamad and Pawi, Awang Azman Awang and Hamdan,
   Rahimah},
Title = {The Elements of Thinking in Archipelago's Fables from the Perspective of
   Children in the 21st Century},
