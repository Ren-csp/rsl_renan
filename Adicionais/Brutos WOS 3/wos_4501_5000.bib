@inproceedings{ WOS:000309505900012,
Author = {Yu, Cynthia and Stone, Micheal},
Editor = {Banasik, K and Horowitz, AJ and Owens, PN and Stone, M and Walling, DE},
Title = {Sediment and nutrient transport dynamics in an urban stormwater
   impoundment},
