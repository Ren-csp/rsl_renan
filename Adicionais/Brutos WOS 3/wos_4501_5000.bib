ISBN = {0-8058-3581-4},
Keywords-Plus = {PARTLY OCCLUDED OBJECTS; INFANTS PERCEPTION; YOUNG INFANTS; PRINCIPLES;
   MOTION; DEPTH},
Research-Areas = {Linguistics; Psychology},
