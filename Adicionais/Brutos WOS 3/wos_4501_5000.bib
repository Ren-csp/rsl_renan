Title = {Urban forest development at landside of Hang Nadim Batam Airport based
   on the microclimate and noise study},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON ENVIRONMENT AND FOREST CONSERVATION
   (ICEFC2019): ECOSYSTEM RESEARCH AND INNOVATION TO ACHIEVE SUSTAINABLE
   DEVELOPMENT GOALS},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
