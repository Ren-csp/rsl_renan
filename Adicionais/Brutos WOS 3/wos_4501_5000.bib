@inproceedings{ WOS:000073221600076,
Author = {Jones, MA and Puri, S and Kang, SK and Lee, SH},
Editor = {Chilton, J},
Title = {Contamination in two urban industrial areas in South Korea},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {451-456},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {As part of its corporate environmental policy the Samsung Group is
   commencing a programme of soil and groundwater contamination
   investigations and monitoring, progressing far beyond the scope of
   current legislative requirements. Initial studies have targeted 10
   manufacturing and industrial facilities throughout South Korea to
   establish a contamination baseline, determine potential hazards,
   associated risks and potential liabilities, and to prepare for the
   evolving regulatory requirements to control soil and groundwater
   contamination. Part of these investigations has targeted the
   industrialised urban centres of Suwon and Changwon, revealing inorganic
   and organic contaminants potentially derived from a range of unconfirmed
   on-site and off-site sources. Numerous contaminant sources are to be
   expected in an urban industrial area which has developed rapidly with
   limited regulatory controls, but the current assessment indicates that
   the risk of environmental impact from these sites is generally low. The
   investigation methodology adopted is to be developed for application at
   other Samsung facilities.},
