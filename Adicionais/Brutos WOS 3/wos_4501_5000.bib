@inproceedings{ WOS:000379409300104,
Author = {Ajanovic, Amela and Haas, Reinhard},
Editor = {Ferreira, P and Soares, I},
Title = {DISSEMINATION OF ELECTRIC CARS IN URBAN AREAS: MAJOR FACTORS FOR SUCCESS},
Booktitle = {PROCEEDINGS OF THE 2ND INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2015},
Pages = {773-779},
Note = {2nd International Conference on Energy and Environment - Bringing
   together Engineering and Economics (ICEE), Guimaraes, PORTUGAL, JUN
   18-19, 2015},
Organization = {Univ Minho, Sch Engn; Univ Porto, Sch Econ \& Management},
Abstract = {According to the strategy of the European Commission presented in the
   White Paper of Transport by 2050 greenhouse gas emissions from transport
   sector have to be reduced by 60\% compared to 1990 and urban areas have
   to be completely free of conventional cars. Looking at the current
   situation in urban transport, especially the very low share of
   alternative automotive powertrains and alternative fuels, these targets
   can be seen as very ambitious. Although different policy measures are
   implemented across EU countries with the goal to reduce greenhouse gas
   emissions and which directly or indirectly support use of alternative
   more environmentally benign vehicles, electric cars are still rarity in
   most of EU cities. However, there are already some good examples and
   positive developments.
   The core objective of this paper is to identify major policies and
   impact factors on dissemination of electric cars in urban areas.
   Major problems related to electric cars are high costs, low drawing
   range and low density of charging stations. In spite of these problems
   with a combination of monetary and non-monetary policy measures electric
   cars can become interesting and accepted option. However, for the future
   prospects of electric vehicles, cost reduction and improvement of
   batteries are key challenge. From environmental point of view most
   important is to ensure that electricity used in electric vehicles is
   generated from renewable energy sources.},
