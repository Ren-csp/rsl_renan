@article{ WOS:000308651400017,
Author = {Villarroya, Ana and Puig, Jordi},
Title = {URBAN AND INDUSTRIAL LAND-USE CHANGES ALONGSIDE MOTORWAYS WITHIN THE
   PYRENEAN AREA OF NAVARRE, SPAIN},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
