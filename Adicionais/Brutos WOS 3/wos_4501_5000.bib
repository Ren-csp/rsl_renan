@article{ WOS:000221679000002,
Author = {Toates, F},
Title = {Cognition, motivation, emotion and action: a dynamic and vulnerable
   interdependence},
Journal = {APPLIED ANIMAL BEHAVIOUR SCIENCE},
Year = {2004},
Volume = {86},
Number = {3-4},
Pages = {173-204},
