@inproceedings{ WOS:000085488300029,
Author = {Quirmbach, M and Schultz, GA and Frehmann, T},
Editor = {Ellis, JB},
Title = {Use of weather radar for combined control of an urban drainage system
   and a sewage treatment plant},
Booktitle = {IMPACTS OF URBAN GROWTH ON SURFACE WATER AND GROUNDWATER QUALITY},
Series = {IAHS PUBLICATION},
Year = {1999},
Number = {259},
Pages = {245-250},
Note = {International Symposium on Impacts of Urban Growth on Surface Water and
   Groundwater Quality, BIRMINGHAM, ENGLAND, JUL 18-30, 1999},
Organization = {Int Assoc Hydrol Sci, Int Commiss Surface Water; Int Assoc Hydrol Sci,
   Int Commiss Ground Water; Int Assoc Hydrol Sci, Int Commiss Water Qual;
   Int Assoc Hydrol Sci, Int Commiss Continental Eros; Int Union Geodesy \&
   Geophys; Int Assoc Water Qual; Int Assoc Hydrgeol},
Abstract = {In present practice, the design and operation of urban drainage systems,
   and the corresponding sewage treatment plants, are usually independent.
   In this paper an approach is presented, the aim of which is joint
   operation of an urban drainage system and the corresponding sewage
   treatment plant. This operation will be based on real-time flood
   forecasts, which are computed with the aid of radar rainfall
   measurements. The goal of this control is to minimize the combined
   negative effects of the hydraulic load (water quantity) and the
   pollution load (water quality) in the receiving waters during floods. In
   growing urban areas, higher imperviousness is the cause for increased
   flood peaks and volumes in the receiving water. In the test basin used,
   an industrial area with a high imperviousness strongly effects the
   control of the total system.},
