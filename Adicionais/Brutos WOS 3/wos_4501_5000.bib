@article{ WOS:000075806100004,
Author = {Bogovski, S and Sergeyev, B and Muzyka, V and Karlova, S},
Title = {Cytochrome P450 system and heme synthesis enzymes activity in flounder
   liver as biomarkers of marine environments pollution},
