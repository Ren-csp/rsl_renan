@article{ WOS:000244504700002,
Author = {Mckay, Patrick F. and Avery, Derek R. and Tonidandel, Scott and Morris,
   Mark A. and Hernandez, Morela and Hebl, Michelle R.},
Title = {Racial differences in employee retention: Are diversity climate
   perceptions the key?},
Journal = {PERSONNEL PSYCHOLOGY},
Year = {2007},
