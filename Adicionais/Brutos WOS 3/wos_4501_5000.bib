@inproceedings{ WOS:001672900200080,
Author = {Pinheiral, Ana and Carvalhol, Francisco and Rodrigues, Carolina and
   Ribeirol, Carlos A.},
Editor = {Ferreira, P and Dall'Orsoletta, A and Jorio, M and Santos, AL},
Title = {EMPOWERING CITIZENS TO TACKLE INVASIVE ALIEN SPECIES IN URBAN CITIES},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2024},
Pages = {537-543},
Note = {2024 International Conference on Energy and Environment-ICEE-Bringing
   together Engineering and Economics, Guimaraes, PORTUGAL, JUN 06-07, 2024},
Abstract = {Invasive alien species (IAS) pose a significant global threat to
   biodiversity, human well-being, and socioeconomic stability. Integrating
   multidisciplinary and comprehensive approaches that include ecology,
   social sciences and policymaking is fundamental to build efficient
   management and control strategies targeting IAS. This study advocates
   for a comprehensive approach to address the challenges imposed by
   invasive plant species (IPS) at different invasion stages (early
   detection, removal, and monitoring) and included in specific local scale
   actions to achieve effective control measures. By using this governance
   model this study exemplifies a successful bottom-up approach,
   implemented in Guimaraes (NW Portugal), to develop species and
   site-specific projects that aim to control or mitigate the spread and
   impacts of IPS, particularly through the ``Green Brigades{''}
   initiative. The presented methodological workflow emphasizes citizens as
   co-creators of sustainable landscapes, fostering lasting connections
   with nature. Case studies demonstrate the efficacy of community-driven
   strategies, with citizens actively contributing to tangible results,
   from invasive species removal to restoration efforts. Citizen's
   engagement contributed to 45\% of reported plant species in the
   territory and 19\% of these species are listed as invasive. We
   demonstrate that citizen science may have a significant contribution in
   early detection of IAS. Surveys conducted among municipal technicians
   underscore the profound impact of education on their ability to
   recognize and address IAS. Furthermore, results highlight that
   building-capacity actions can result in higher capacity on technical
   team to manage and control IAS. The case study of Guimaraes' model
   emphasizes citizen involvement in shaping the future of IAS management
   in urban environments, and enhances the collective responsibility of
   citizens, policymakers, and the scientific community in this endeavour.},
