
@inproceedings{ WOS:000452593300089,
Author = {Rakhimov, I. I. and Ibragimova, K. K.},
Book-Group-Author = {IOP},
Title = {Morphological and ecological preadaptations as the basis of bird
   synanthropization under transformed environment conditions},
Booktitle = {3RD INTERNATIONAL CONFERENCE ENVIRONMENT AND SUSTAINABLE DEVELOPMENT OF
   TERRITORIES: ECOLOGICAL CHALLENGES OF THE 21ST CENTURY},
