Organization = {IEEE Engn Med \& Biol Soc; Coral; Univ Autonome Metropolitana; Sandia
   Natl Lab},
Abstract = {It is considered that pitch of f(0) is produced in the auditory center
   when we hear a complex tone of f(1), = n f(0) and f(2) = (n+k) f(0).
   f(0) is known as missing fundamental {[}1]. We confirm, by
   psycho-acoustic experiments, that we can hear missing fundamental.
   Furthermore, we investigate how a(i), f(i) and theta(i), in complex
   tones a(1)sin(2pif(1)t+theta(1))+a(2)sin(2pif(2)t+theta(2)) in low
   frequency region, influence on producing fo. The low frequency region (
   250Hz similar to 1000Hz) is chosen for considering the mechanism of
   perceiving missing fundamental without influence of spontaneous
   discharge and refractory period. The results of experiments are
   discussed by significant difference test. Finaly, We confirm, by
   psycho-acoustic experiments, that we can hear missing fundamental in
   frequency region higher than 1000Hz.},
