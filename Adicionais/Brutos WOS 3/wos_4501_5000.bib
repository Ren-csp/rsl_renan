Title = {Risk perceptions of US international vacation travelers},
Booktitle = {IT'S SHOWTIME FOR TOURISM: NEW PRODUCTS, MARKETS AND TECHNOLOGIES},
Year = {1996},
Pages = {192-200},
Note = {27th Annual Conference of the Travel-and-Tourism-Research-Association
   (TTRA 96), LAS VEGAS, NV, JUN 16-19, 1996},
Organization = {Travel \& Tourism Res Assoc},
Abstract = {Relationships between ten types of risk and overall risk perceptions of
   U.S. international vacation travelers and the degree of risk associated
   with eight geographic regions and top seven vacation destinations were
   examined. Anderson's (1981, 1982) Information Integration Theory served
   as the foundation far the analysis. Five hundred individuals in the U.S.
   were mailed questionnaires (48\% response rate). Results revealed that
   terrorism, equipment, political instability, and satisfaction risks were
   most often associated with international travel by U.S. travelers.
   Results of the second analysis indicated equipment, political
   instability, satisfaction, and physical risks to be most often
   associated with different geographic regions around the world. As for
   specific destinations, equipment, terrorism, and financial risks were
   significant predictors of the degree of risk associated with the top
   seven vacation destinations of U.S. travelers. Study results imply that
   destination marketers needs to consider travelers' risk perceptions when
   creating promotional messages. Results further suggest that providing
   comprehensive information to potential travelers may help alleviate some
   traveler concerns about risk.},
