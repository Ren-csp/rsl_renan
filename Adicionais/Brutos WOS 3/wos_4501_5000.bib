@article{ WOS:000509558500005,
Author = {Sambito, Mariacrocetta and Di Cristo, Cristiana and Freni, Gabriele and
   Leopardi, Angelo},
Title = {Optimal water quality sensor positioning in urban drainage systems for
   illicit intrusion identification},
