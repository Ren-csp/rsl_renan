@inproceedings{ WOS:000339411600060,
Author = {Wu Xiangyang and Lu Weijia},
Editor = {Kao, JCM and Sung, WP and Chen, R},
Title = {A study on Environmental Attitude, Environmental Behavior and
   Environment Issues of living Place: The Questionnaire Survey for Some
   Dwellers in Shenzhen},
Booktitle = {FRONTIERS OF GREEN BUILDING, MATERIALS AND CIVIL ENGINEERING III, PTS
   1-3},
Series = {Applied Mechanics and Materials},
Year = {2013},
Volume = {368-370},
Pages = {290-296},
Note = {3rd International Conference on Green Building, Materials and Civil
   Engineering (GBMCE 2013), Taiwan, PEOPLES R CHINA, AUG 21-23, 2013},
Organization = {Natl Chin Yi Univ Technol; Natl Cheng Kung Univ; Natl Sun Yan Sen Univ;
   Natl Chi Nun Univ; ChienKuo Technol Univ; Control Engn \& Informat Sci
   Res Assoc; Int Frontiers Sci \& Technol Res Assoc; Trans Tech Publicat},
Abstract = {Firstly, the study takes the environmental attitude, environmental
   behavior of the city dwellers and the environment issues in living place
   for the target, and designed the questionnaire with the actual situation
   in Shenzhen. Secondly, the questionnaires returned back are analyzed in
   details. According to the conclusion from the statistical analysis for
   the questionnaires' data,. the relationship between the environmental
   attitude and environmental behavior of the city dwellers is explored and
   the environmental issues of living place in Shenzhen are found out in
   the end.
   As a largest developing country, environmental issues are becoming more
   and more serious in China with rapid economic growth. How are the
   interactions of human environmental attitude and environmental behavior?
   What are the environmental issues of living place in city? These are the
   main objectives of this study.
   There are two kinds of environmental attitudes involved in environment
   study: one is the attitude towards physical environment; the other is
   the attitude on certain environmental behavior (such as water
   conservation). In this study, environmental attitude is referred to the
   former.
   On the relationship between environmental attitude and environmental
   behavior, many studies show that environmental attitude is an important
   factor which affects environmental behavior, and environmental behavior
   directly responses to environmental issues. According to the basic
   cognition of psychology- ``attitudes influence behavior{''}, some
   scholars have put forward some classic theoretical study framework. For
   example, Ajzen proposed Theory of Planned Behavior (TPB); ABC theory by
