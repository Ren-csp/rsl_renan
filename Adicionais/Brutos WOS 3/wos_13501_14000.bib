@inproceedings{ WOS:000664285400061,
Author = {Feng, Taozhu and Ren, Yingsha},
Editor = {Duan, L and Abdullah, AZ},
Title = {Research on the impact of coal miners' workload on unsafe behaviors},
Booktitle = {2021 5TH INTERNATIONAL CONFERENCE ON ADVANCES IN ENERGY, ENVIRONMENT AND
   CHEMICAL SCIENCE (AEECS 2021)},
Series = {E3S Web of Conferences},
Year = {2021},
Volume = {245},
Note = {5th International Conference on Advances in Energy, Environment and
   Chemical Science (AEECS), ELECTR NETWORK, FEB 26-28, 2021},
Abstract = {Workload is one of the reasons that affect unsafe behavior in coal
   mines. This article divides workload into six dimensions: physical
   demand, mental demand, time demand, performance level, effort level and
   frustration level, and introduces miner emotions as an intermediary
   variable to study the impact of workload on unsafe behavior. Through a
   questionnaire survey of coal mine workers, a structural equation model
   of coal mine workers' workload and unsafe behavior is constructed. The
   results show that the six dimensions of workload have a significant
   impact on emotions. Physical demand, mental demand, time demand and
   frustration level have a significant impact on unsafe behaviors.
   Performance level and effort level have no significant impact on unsafe
   behaviors.},
