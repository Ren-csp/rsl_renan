Title = {Preliminary study on requisition-compensation balance of farmland
   resources in Xinjiang},
Booktitle = {PROCEEDINGS OF THE CHINA ASSOCIATION FOR SCIENCE AND TECHNOLOGY, VOL 4,
   NO 3},
