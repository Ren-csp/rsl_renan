@article{ WOS:A1996TT77300004,
Author = {Povel, DJ},
Title = {Exploring the elementary harmonic forces in the tonal system},
Journal = {PSYCHOLOGICAL RESEARCH-PSYCHOLOGISCHE FORSCHUNG},
Year = {1996},
Volume = {58},
Number = {4},
Pages = {274-283},
Month = {FEB},
Note = {3rd International Conference on Music Perception and Cognition, LIEGE,
   BELGIUM, JUL 23-27, 1994},
Abstract = {To study the elementary expectations that arise in the perception of
   tonal music, an exploratory study was performed in which subjects heard
   a sequence of four chords (to induce a key or tonality) followed by one
   tone (1 of the 12 tones within an octave), and indicated which tone they
   expected to be the next tone. Responses were divided into three groups:
   a random, a fifth, and a tonal group. The expectations in the tonal
   group are of main interest, as they seem to originate from a tonal
   representation. In this representation the tonic attracts almost all
   tones, although to different degrees, while the dominant and the mediant
   function as centripetal centers that attract only nearby tones. A
   preliminary model for the formation of elementary expectations based on
   a 3-level mental representation of the tones in a key is proposed. The
   predictive capability of the model is compared to that of existing
   models.},
