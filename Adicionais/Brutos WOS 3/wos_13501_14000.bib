@inproceedings{ WOS:000348535300049,
Author = {Jandacka, Dusan and Durcanska, Daniela},
Book-Group-Author = {SGEM},
Title = {PARTICULATE MATTER IN STREET CANYON},
Booktitle = {12TH INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC GEOCONFERENCE, SGEM
   2012, VOL. IV},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2012},
Pages = {371-378},
Note = {12h International Multidisciplinary Scientific Geoconference (SGEM),
   Albena, BULGARIA, JUN 17-23, 2012},
Organization = {Minist Environm \& Water; Bulgarian Acad Sci; Acad Sci Czech Republ;
   Acad Sci IR Iran; Latvian Acad Sci; Polish Acad Sci; Russian Acad Sci;
   Serbian Acad Sci \& Arts; Slovak Acad Sci; Natl Acad Sci Ukraine;
   Bulgarian Ind Assoc},
Abstract = {The dust in the vicinity of roads is a major problem in air pollution.
   There is a problem especially in cities with a dense network of urban
   roads and heavy traffic's intensity. The mass of particulates in the
   atmosphere include particulate matter of different origins, different
   sizes, with different chemical composition. Characteristics of
   particulate predetermine their residence time in the air, their
   long-range capability and especially their harmfulness to the
   environment and human health. Chemical composition of solid particles is
   a determining factor in the harm to the human body. Based on the
   chemical composition it is possible to estimate the primary source of
   particulate matter.
   Since 2009 we have measured four times a year the measurements of
   particulate matter along the urban roads. Gravimetrically are observed
   fractions of particulate matter PM10, PM2,5 and PM1,0. The particles of
   heavy metals on the filters are evaluated by spectrometric method. In
   the next stage are evaluated sources of particulate matters and the
   origin of the metal content specifically- Na, Mg, Al, Ca, Cu, Sb, Ba,
   Pb, Cd, Cr, As, Mo, V, Mn, Fe, Ni, Zn- by multivariate statistical
   methods (factor analysis - FA, principal components analysis - PCA).},
Publisher = {STEF92 TECHNOLOGY LTD},
Address = {1 ANDREY LYAPCHEV BLVD, SOFIA, 1797, BULGARIA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Jandacka, D (Corresponding Author), Univ Zilina, Fac Civil Engn, Dept Highway Engn, Zilina, Slovakia.
   Jandacka, Dusan; Durcanska, Daniela, Univ Zilina, Fac Civil Engn, Dept Highway Engn, Zilina, Slovakia.},
