@article{ WOS:A1995QP39100022,
Author = {SANCHEZ, RA},
Title = {WATER-QUALITY PROBLEMS IN NOGALES, SONORA},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {1995},
Volume = {103},
Number = {1},
Pages = {93-97},
Month = {FEB},
Note = {Joint US/Mexico Conference on Fate, Transport and Interactions of
   Metals, TUCSON, AZ, APR 14-16, 1993},
Abstract = {This article presents the results of a transboundary water quality
   monitoring program at the two Nogales area in the Arizona-Sonora border
   region. The program was carried out jointly in 1990 by U.S. and Mexican
   institutions. The results show pollution problems due to deficiencies in
   Nogales, Sonora municipal sewerage system, causing not only sewage
   spills in several parts of the city but also creating occasional
   transboundary problems. The results also showed potential illegal
   dumping of industrial hazardous waste (VOCs) into Nogales' municipal
   sewerage system. All of the organic compounds found in the sewage
   samples are solvents frequently used by the border industry. Occasional
   brakes of pipes spill the pollutants into the Nogales Wash, a water
   stream that runs parallel to Nogales' main sewerage line. Samples of the
   municipal water system showed no traces of pollutants. However, two
   rounds of samples detected concentrations of VOCs in wells used to
   supply water by trucks to low income neighborhoods in Nogales, Sonora.
   ironically, the pollution detected in these wells has a greater impact
   in low income groups of the city that pay three to four times more per
   liter of water they consume, than the rest of the inhabitants with clean
   water from the municipal system.},
Publisher = {NATL INST ENVIRON HEALTH SCI},
Address = {PO BOX 12233, RES TRIANGLE PK, NC 27709},
Type = {Article; Proceedings Paper},
