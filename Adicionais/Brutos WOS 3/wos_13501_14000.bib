@article{ WOS:A1994PW75300011,
Author = {MCDONOUGH, EM and MUNZ, DC},
Title = {GENERAL WELL-BEING AND PERCEIVED ADULT FRIENDSHIP BEHAVIORS},
Journal = {JOURNAL OF SOCIAL BEHAVIOR AND PERSONALITY},
Year = {1994},
Volume = {9},
Number = {4},
Pages = {743-752},
Note = {65th Annual Meeting of the Midwestern-Psychological-Association,
   CHICAGO, IL, APR 29-MAY 01, 1993},
Organization = {Midwestern Psychol Assoc},
Abstract = {This study investigated the relationship between level of general
   well-being and perceived friendship behaviors in adults.  It was
   proposed that high-well-being adults, as compared with low-well-being
   adults, would report fewer close friends and engage in different types
   of relationship-building behaviors with their same-sex best friends. 
   Results showed that high-well-being adults reported significantly fewer
   close friends and more communication (sharing, self-disclosure) and
   consideration (helpful and concerned) behaviors with a same-sex friend. 
   Low-well-being friendship patterns were characterized by more
   companionship (spending time, going places) behaviors.  There was no
   difference between the two groups in affection behaviors.  Gender was
   not a moderator variable.  For the entire sample (n = 198), overall
   general well-being was significantly related to reported companionship
   and communication friendship behaviors (R = .82).  Implications of these
   findings are discussed.},
