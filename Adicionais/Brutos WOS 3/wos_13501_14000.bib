Title = {Landscape change in the Levuvhu and Nzhelele River catchments, Venda
   Limpopo Province South Africa},
Booktitle = {FOURTH INTERNATIONAL CONFERENCE ON ENERGY ENGINEERING AND ENVIRONMENTAL
   PROTECTION},
