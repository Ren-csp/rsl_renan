Title = {The Heart of Effort: Revealing Heart Rate Patterns in Real-Effort Tasks},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2024},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2025},
