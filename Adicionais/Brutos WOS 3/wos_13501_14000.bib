@article{ WOS:A1993LW25000014,
Author = {ZAVALA, I and ZAVALA, MA},
Title = {GLOBAL POSITIONING SYSTEM AS A TOOL FOR ECOSYSTEM STUDIES AT THE
   LANDSCAPE LEVEL - AN APPLICATION IN THE SPANISH MEDITERRANEAN},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1993},
Volume = {24},
Number = {1-4},
Pages = {95-104},
Month = {JUL},
Note = {CONGRESS OF THE INTERNATIONAL-ASSOC-FOR-LANDSCAPE-ECOLOGY - LANDSCAPE
   APPROACH TO REGIONAL PLANNING : THE FUTURE OF THE MEDITERRANEAN
   LANDSCAPES, MONTECATINI, ITALY, APR 27-MAY 01, 1992},
Organization = {INT ASSOC LANDSCAPE ECOL},
Abstract = {Global Positioning System (GPS) is a satellite-based method which allows
   the coordinates of points to be determined within centimeters or meters
   of accuracy, depending on the measuring techniques used. GPS also allows
   boundaries to be plotted and areas to be measured in significantly less
   time and in a much easier way than traditional techniques. GPS can be
   used as a first-hand tool for a better understanding of ecological
   processes and human interferences, and for a more efficient management
   and conservation effort of the ecosystem components. GPS is especially
   suited for those applications involving landscape fragmentation and
   mosaic pattern. The method used in this study is Differential GPS
   (DGPS). It involves placing a GPS receiver at one or more known
   locations (the monitor stations) and computing corrections for the range
   errors observed in the satellite signals. In principle, these
   corrections are calculated by subtracting the observed pseudo-ranges
   from ranges computed with the known station coordinates. Our application
   focuses on the problem of determining the infected areas of Arceuthobium
   oxycedri DC. M. Bieb (an Iberian dwarf mistletoe found on Juniperus
   oxycedrus L.) within Parque Regional del Alto Manzanares (Madrid), a
   protected ecological area. This park faces the typical problems of
   Mediterranean landscapes next to big metropolitan areas. GPS allows the
   interactive study of dwarf mistletoe spreading and perturbation agents
   such as wildfires and human influence.},
