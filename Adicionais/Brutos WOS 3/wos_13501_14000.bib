@inproceedings{ WOS:000769651300026,
Author = {Boasen, Jared and Giroux, Felix and Renaud, Sara-Eve and Senecal,
   Sylvain and Leger, Pierre-Majorique and Paquette, Michel},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB and MullerPutz, G},
Title = {High Fidelity Vibrokinetic Stimulation Augments Emotional Reactivity and
   Interhemispheric Coherence During Passive Multimedia Interaction},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE (NEUROIS RETREAT 2021)},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2021},
Volume = {52},
Pages = {229-236},
Note = {13th Annual NeuroIS Retreat Conference (NeuroIS Retreat), ELECTR
   NETWORK, JUN 01-03, 2021},
Organization = {Raiffeisen Software; GRZ; Brain Prod; Noldus Informat Technol},
Abstract = {Haptic technologies are widely used in multimedia entertainment to
   psychophysiologically enhance user experience. Psychometric-based
   research regarding vibrokinetic stimulation during multimedia viewing
   supports this notion. However, scant neurophysiological evidence exists
   to verify this effect. Using a between groups design with
   source-localized electroencephalography, the present study analyzed the
   effect of high fidelity vibrokinetic (HFVK) stimulation during passive
   multimedia interaction (i.e. watching a haptically enhanced movie) on
   self-reported emotional state and intercortical theta coherence. Results
   indicate that HFVK increases emotional reactivity in association with
   increased interhemispheric coherence between the right inferiortemporal
   gyrus and the left insular cortex, thereby conferring neurophysiological
   support for the efficaciousness of HFVK to enhance emotional response
   during movie watching.},
