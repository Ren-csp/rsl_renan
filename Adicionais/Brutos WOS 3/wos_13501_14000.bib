   and Kusumaningati, Ratna Widiyanti},
Title = {Validity Test of the Indonesia Version of Revised American Pain Society
   Outcome Questionnaire (APS-POQ-R) to Evaluate Postoperative Management
   Quality},
Journal = {ADVANCED SCIENCE LETTERS},
