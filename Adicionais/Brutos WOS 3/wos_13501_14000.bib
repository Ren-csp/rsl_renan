Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {The purpose of this study was to contribute to a comprehensive view of
   emotional and academic processes in the field of peer relationships.
   Participants were 131 children (73 boys and 58 girls) attending the
   third grade. In addition to a socio-demographic questionnaire, a
   sociometric test was used to measure children's peer acceptance. The
   academic competence scale of the Social Skills Rating System (SSRS;
   Gresham \& Elliot, 1990) provided a measure of children's academic
   achievement and the Assessment of Children's Emotional Skills (ACES;
   Schultz, Izard \& Bear, 2004) was used to assess children's emotion
   knowledge. The results revealed that academic competence mediates the
   relationship between emotion knowledge and peer acceptance.},
