Series = {WATER STUDIES SERIES},
Year = {2002},
Volume = {11},
Pages = {253-257},
Note = {3rd International Conference on Oil and Hydrocarbon Spills, ISL RHODES,
   GREECE, 2002},
Abstract = {Utilization and recycling of environment-polluting industrial and
   agricultural, domestic and urban organic wastes are currently one of the
   most urgent problems of modem science and practice. Unfortunately, the
   majority of the existing technologies for organic wastes recycling are
   not ecologically pure. As an alternative to these methods the whole
   complex of measures for bioconversion of organic wastes using
   vermicultivation method by means of Red Californian Worms is offered.
   The technology offered allows to rehabilitate soil biological activity,
   which was destructed by oil contamination. It can be used as a
   prospective source for obtaining biologically substances allowing
   solving problems in different fields of agriculture and industry.},
