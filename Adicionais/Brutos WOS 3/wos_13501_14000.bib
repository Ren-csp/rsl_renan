@article{ WOS:000403973500251,
Author = {Mojo, Endrat and Hadi, Sudharto P. and Purnaweni, Hartuti},
Title = {Sedulur Sikep's Environmental Wisdom in Conservation of North Kendeng
   Mountains Sukolilo},
