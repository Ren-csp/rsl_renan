Title = {An mHealth Approach to Addressing Health Inequity},
Booktitle = {ADVANCES IN HUMAN FACTORS AND ERGONOMICS IN HEALTHCARE AND MEDICAL
   DEVICES (AHFE 2021)},
Series = {Lecture Notes in Networks and Systems},
