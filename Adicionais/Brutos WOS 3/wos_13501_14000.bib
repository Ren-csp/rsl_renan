@article{ WOS:000080280000018,
Author = {Jenkins, RA and Counts, RW},
Title = {Occupational exposure to environmental tobacco smoke: Results of two
   personal exposure studies},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {1999},
