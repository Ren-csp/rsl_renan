@article{ WOS:000239188600002,
Author = {Andre, Jeffrey and Rogers, Sheena},
Title = {Using verbal and blind-walking distance estimates to investigate the two
   visual systems hypothesis},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2006},
Volume = {68},
Number = {3},
Pages = {353-361},
Month = {APR},
Note = {12th International Conference on Perception and Action, GOLD COAST,
   AUSTRALIA, JUL 13-18, 2003},
Organization = {Griffith Univ Complex Act Visualisat Lab},
Abstract = {Verbal estimates of egocentric distance are usually too short at
   distances greater than several meters, yet blindfolded walking to
   previously viewed targets can be surprisingly accurate. We present
   evidence from three experiments for the existence of two visual pathways
   with different encodings of perceived egocentric distance. We found that
   (1) blind-walking estimates of egocentric distance are consistently more
   accurate than verbal reports; (2) an indoor versus outdoor environment
   selectively influences verbal reports; and (3) wearing prism lenses,
   which displace the visual field vertically, selectively influences the
   blind-walking estimates. We interpret these results in terms of the two
   visual systems hypothesis.},
