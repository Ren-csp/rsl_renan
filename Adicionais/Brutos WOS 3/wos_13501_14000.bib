@inproceedings{ WOS:000223551500001,
Author = {Benson, A and Clifton, J},
Editor = {Pineda, FD and Brebbia, CA},
Title = {Assessing tourism's impacts using local communities' attitudes toward
   the environment},
Booktitle = {SUSTAINABLE TOURISM},
Series = {SUSTAINABLE WORLD},
