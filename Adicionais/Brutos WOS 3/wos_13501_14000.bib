@inproceedings{ WOS:000305209800021,
Author = {Boza, M. and Potop, M. S.},
Book-Group-Author = {MEDIMOND},
Title = {Theory of mind and emotional understanding in preschool children},
Booktitle = {15TH EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY},
Year = {2011},
Pages = {115-119},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {We aim to study the developmental paths of emotion understanding (EU)
   and the theory of mind (ToM) in preschool children. We expected age
   differences for ToM and EU and gender differences favoring girls for EU.
   The results show an increase with age for ToM, with no gender
   differences. Happiness and sadness are better recognized than anger and
   fear, girls being better than boys in emotion understanding at age 3 but
   not later. The emotional understanding is better than theory of mind at
   age 3. At age 4 there is an increase in theory of mind for both genders,
   and a drop in emotional understanding. At age 5, theory of mind in
   complete and emotional understanding is increased, but not complete.},
