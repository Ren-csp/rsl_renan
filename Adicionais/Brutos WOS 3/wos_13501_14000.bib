@article{ WOS:000239254700004,
Author = {Lawler, Edward J. and Thye, Shane R. and Yoon, Jeongkoo},
Title = {Commitment in structurally enabled and induced exchange relations},
Journal = {SOCIAL PSYCHOLOGY QUARTERLY},
Year = {2006},
Volume = {69},
Number = {2},
Pages = {183-200},
Month = {JUN},
Note = {96th Annual Meeting of the American-Sociological-Association, ANAHEIM,
   CA, AUG 17-21, 2001},
Organization = {Amer Sociol Assoc},
Abstract = {Network structures both enable and constrain the development of social
   relations. This research investigates these features by comparing the
   development of commitments in structurally enabled and structurally
   induced exchange relations. We integrate ideas from the theory of
   relational cohesion and the choice process theory of commitment. In an
   experiment we manipulate and compare a structurally enabled relation
   with a structurally induced relation. The main hypotheses are that a
   structurally enabled relation generates a greater sense of control, more
   positive emotions, greater perceived cohesion, and more commitment
   behavior than a structurally induced relation. The results of the
   experiment support these hypotheses. The implication is that enabling
   and constraining features of network structures exert important effects
   on cohesion and commitment in relations within those structures.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Lawler, EJ (Corresponding Author), Cornell Univ, Ithaca, NY 14853 USA.
   Cornell Univ, Ithaca, NY 14853 USA.
   Univ S Carolina, Columbia, SC 29208 USA.
