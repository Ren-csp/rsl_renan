@article{ WOS:000456346900006,
Author = {Moon, Man-Ki},
Title = {The Causal Relationship Between the Human Evaluation Model (HEM) and
   Self-Regulation},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2019},
Volume = {25},
Number = {1},
Pages = {25-32},
Month = {JAN},
Note = {5th International Conference on Advances Technology in
   Telecommunication, Broadcasting, and Satellite (TelSaTech), Jakarta,
   INDONESIA, OCT 21-22, 2017},
Abstract = {The purpose of this study is to verify the structural relationship
   between the human evaluation model (HEM) and self-regulation. The HEM is
   a personal evaluation model based on the Eastern Confucius philosophy.
   It has been designed to quantitatively evaluate personal characteristics
   through 5 latent variables (20 observed variables), namely, disposition,
   virtue, personality, cognitive faculty and personal environment. In this
   study, accordingly, structural equation modeling (SEM) analysis was
   conducted to examine the changes in self-regulation level according to
   the influence of the HEM latent factors and their causal directional
   nature. The result showed that the personality factor had the biggest
   effect on self-regulation level, followed by virtue, disposition,
   cognitive faculty and personal environment. In addition, personality was
   found to become further strengthen through the course of disposition and
   virtue. In this study, structural factor causing self-regulation
   differences among people was analyzed, based on which practical
   suggestions were made to strengthen self-regulation level according to
   personal characteristics. Self-regulation not only mediates the
   relationship between external effect and behavior but also is one of
   determining variables of goal-oriented human behavior. In numerous
   studies, accordingly, they focused on ways to improve the differences in
   self-regulation shown differently among people. Based on such
   perspective, this study provides implications to studies aiming to
   accelerate self-regulation level remove suppressor variable in the
   cognitive behavior and emotional control model based on self-regulation
   for solving cause addiction problem such as smartphone addiction or
   self-regulation learning model design.},
