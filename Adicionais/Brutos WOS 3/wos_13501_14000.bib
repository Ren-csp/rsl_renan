@inproceedings{ WOS:000248877700009,
Author = {Zivkovic, Stanislav and Nuic, Jerko and Tvrtkovic, Ivan Miljenko},
Editor = {Frankovic, B},
Title = {Degradation of coal at dumps and its environmental influence},
Booktitle = {Energy and the Environment 2004, Vol II},
Year = {2004},
Pages = {61-69},
Note = {19th International Congress on Energy and the Environment, Opatija,
   CROATIA, 2004},
Abstract = {Large coal dumps are necessary for operation of major power plants.
   Position of such dumps, their large dimensions, and especially the way
   they affect the appearance of the landscape were not adequately analysed
   or solved. Many aspects of thermal power plants were discussed, analysed
   and redefined both in projects and in practice, but coal dumps were not
   (or at least they were treated with inadequate priority). This is
   probably so because this segment of the thermal energy complex was
   supposed to be less problematic in respect to the other, markedly
   complicated parts.
   Adequate storage and its constructional elements can significantly
   influence the chemical processes that trigger degradation processes.
   This has major environmental consequences due to possible smoke
   emissions that follow degradation and which can significantly reduce the
   quality of living in the area (sight, smell), especially if the object
   is close to an urban area or a tourist resort.},
