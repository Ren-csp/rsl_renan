@inproceedings{ WOS:000288207700014,
Author = {Reiter-Palmon, Roni and Wiener, Richard L. and Ashley, Gregory and
   Winter, Ryan J. and Smith, Ronda M. and Richter, Erin M. and Voss-Humke,
   Amy},
Editor = {Zerbe, WJ and Hartel, CEJ and Ashkanasy, NM},
Title = {THE EFFECTS OF EMPATHY ON JUDGMENTS OF SEXUAL HARASSMENT COMPLAINTS},
Booktitle = {EMOTIONS, ETHICS AND DECISION-MAKING},
Series = {Research on Emotion in Organizations},
Year = {2008},
Volume = {4},
Pages = {285-310},
Note = {5th International Conference on Emotions and Organizational Life,
   Atlanta, GA, AUG 10-12, 2006},
Abstract = {Recent research suggests that individual difference variables that
   measure emotional reactions may be useful in understanding sexual
   harassment judgments. In the present study, 503 male and female working
   adults viewed two videos of sexual harassment cases and were asked to
   make judgments about the nature of the behavior. Participants also
   completed measures of sexism and empathy. Results indicated that
   Perspective Taking (PT), a component of empathy, interacted with gender
   to explain judgments regarding sexual harassment. Contrary to
   expectations, PT did not eliminate the typical gender differences found,
   but rather magnified them.},
