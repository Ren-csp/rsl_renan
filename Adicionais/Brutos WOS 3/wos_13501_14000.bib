Pages = {214-222},
Month = {NOV},
Note = {23rd Annual Meeting of the International-Society-for-Psychophysics,
   Tokyo, JAPAN, OCT 20-23, 2007},
Abstract = {We have carried out experiments to explore the effect of prior knowledge
   and expectation on the detection of audiovisual synchrony. By expanding
   on earlier methodologies, we have shown that the perception of synchrony
   is not affected by prior knowledge of lag type (i.e., visual signal
   precedes audio signal or vice versa). This result suggests that
   higher-level cognitive processes like expectation do not play a
   significant role in synchrony perception. We also introduce here a
   systems-level model based on cross-correlation that is compatible with
   both the observations of our experiments and with the observations of
   other studies.},
