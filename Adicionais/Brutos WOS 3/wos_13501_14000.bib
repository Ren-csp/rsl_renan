@inproceedings{ WOS:000230620300025,
Author = {Chen, Y},
Editor = {Tiezzi, E and Brebbia, CA and Jorgensen, SE and Gomar, DA},
Title = {Regeneration and sustainable development in the transformation of
   Shanghai},
