@article{ WOS:000168584400016,
Author = {Miller, A and Tomarken, AJ},
Title = {Task-dependent changes in frontal brain asymmetry: Effects of incentive
   cues, outcome expectancies, and motor responses},
Journal = {PSYCHOPHYSIOLOGY},
