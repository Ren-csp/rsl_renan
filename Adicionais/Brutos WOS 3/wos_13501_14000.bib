@inproceedings{ WOS:000569366800095,
Author = {Erthalia, Meike and Supriatna and Damayanti, Astrid},
Editor = {Hadiyanto, M and Warsito, B},
Title = {Land Cover Change of Post-Tin Mining Land Conservation Area and Its
   Surroundings in Perimping Sub Watershed, Bangka Regency},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON ENERGY, ENVIRONMENTAL AND INFORMATION
   SYSTEM (ICENIS 2018)},
