@inproceedings{ WOS:000389851900126,
Author = {Zhao, Yan and Zhang, Yan-cui},
Book-Group-Author = {Destech Publicat Inc},
Title = {Study on Ecological Environmental Problems and Their Countermeasures in
   the Process of Rural Urbanization},
Booktitle = {2016 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND ENGINEERING
   (ESE 2016)},
Year = {2016},
Pages = {822-827},
Note = {International Conference on Environmental Science and Engineering (ESE),
   Guilin, PEOPLES R CHINA, APR 15-17, 2016},
Abstract = {There exist many serious problems in ecological environment with which
   people must be confronted due to the urbanization, such as environmental
   deterioration, resource depletion and population expansion. Especially
   the severe air pollution, water pollution and the phenomenon of cities
   being besieged by garbage in the course of rural urbanization give rise
   to the ever-worsening environment, which is the affection on sustainable
   development in rural urbanization, making a dent in rural development
   potential and a danger to the survival and development in rural areas.
   Therefore, new ways are supposed to be explored and effective measures
   should be taken to tackle the problems in ecological environment. To
   ensure sustainable development in rural urbanization process,
   urbanization and ecological environment must be balance to achieve the
   equilibrium of ecological and social benefits. The notion and principle
   of ecology civilization should be integrated into the process of rural
   urbanization so as to coordinate the relations.},
