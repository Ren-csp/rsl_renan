Title = {The presence and effect of endocrine disruptors on reproductive organs
   of fish in a reservoir used for aquiculture},
Booktitle = {ENVIRONMENTAL TOXICOLOGY},
Series = {WIT Transactions on Biomedicine and Health},
Year = {2006},
Volume = {10},
Pages = {139+},
Note = {1st International Conference on Environmental Toxicology, Mykonos,
   GREECE, SEP 09-11, 2006},
Organization = {WIT Transact Biomed \& Hlth; Wessex Inst Technol; Univ Thessaly, Dept
   Planning \& Reg Dev},
Abstract = {A reservoir receiving some sewage water from an urban area, in addition
   to fresh water sources, was used for raising three species of fish.
   Prior to the introduction of the fish, the reservoir water contained
   appreciable amounts of testosterone, estrogen, ethinylestradiol and
   medroxyprogesterone. After introduction of the fish the level of
   hormones and drugs were reduced to nearly non-detectable levels while in
   a control reservoir without fish, the levels of the compounds remained
   constant. Of the three species studied, after eight months only the
   female carp developed gonads, which were small for body size.
   Observations suggest that the fish absorb the hormones and drugs in the
   early growing season and this has a negative effect on their
   reproductive development.},
Publisher = {COMPUTATIONAL MECHANICS PUBLICATIONS LTD},
Address = {ASHURST LODGE, SOUTHAMPTON S04 2AA, HANTS, ENGLAND},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Shore, LS (Corresponding Author), Kimron Vet Inst, Bet Dagan, Israel.
