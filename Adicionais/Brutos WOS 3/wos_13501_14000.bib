Title = {The Physiological Psychology Properties and Evaluation of Deep Breathing
   Regulation},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 2},
Year = {2010},
Pages = {342-345},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {This study is to investigate the physiological psychology properties and
   evaluate the methods of deep breathing regulation. The research used
   parameters of POMS scale, blood pressure and heart rate variability to
   evaluate the regulative effects before and after undergraduates taking
   deep inspirtory and expiratory respiration, and deep breathing
   exercises. All parameters before and after experiment in control group
   had no significant differences. In experimental group, after taking deep
   breathing regulation, their tense emotion had significantly decreased
   (p<0.05). Meanwhile they were more vigorous and active, and their
   self-respecting emotion had significantly improved (p<0.05). Systolic
   pressures of deep inspirtory and expiratory respiration were
   significantly lower than natural breathing; and the average heart rate
   during deep breathing and expiratory respiration were obviously lower
   than natural breathing. But the diastolic pressure was not significantly
   affected. The time domain index \%RR50 of heart rate variability had not
   obviously varied (p>0.05), while the parameter CVRR of deep inspirtory
   respiration and deep breathing had significantly increased (p<0.05)
   (p<0.01). The frequency domain index of heart rate variability suggested
   that HF / TL of deep breathing was obviously lower than general
   breathing (p<0.05); and that LF / HF of deep inspirtory respiration and
   deep breathing was obviously higher than natural breathing (p<0.05). (1)
   After regulation of ``deep breathing{''}, the positive emotions can be
   effectively promoted and the negative emotion relieved; (2) Systolic
   pressure and average heart rate decrease after breathing regulation; (3)
   The deep inspirtory respiration of undergraduates performances are
   similar to deep breathing; (4) The time domain index and frequency
   domain index of heart rate variability focus on different aspects. So
   adopting frequency domain indexes HF/TL.. LF/'HF to evaluate non-general
   breathing such as regulative breathing etc is more reasonable.},
