@inproceedings{ WOS:000189414500006,
Author = {Wong, WL},
Book-Group-Author = {HRC},
Title = {Cultural heritage landscapes: Land use planning challenges in Ontario},
Booktitle = {BORDERLANDS: THE SHARED CANADIAN AND U.S. EXPERIENCE OF LANDSCAPE},
Year = {2002},
Pages = {45-60},
Note = {Alliance-for-Historic-Landscape-Preservation Annual Meeting, Niagara on
   the Lake, CANADA, JUN 02-05, 1999},
Organization = {Alliance Histor Landscape Preservat},
Abstract = {There are many significant cultural heritage landscapes in Ontario, of
   local, regional and national importance and worthy of careful
   identification, assessment and conservation. The diverse and varied
   cultures both Aboriginal and non-Aboriginal, have helped shape this
   province through human processes and activities, leaving fragments of
   physical remains reflected in our visible landscapes. From a historic
   distillery in downtown Toronto, to groupings of mining headframes in
   northern Ontario symbolizing the industrial processes of a community;
   from public institutional complexes, to historical hamlets with mill
   ruins nestled along side a river in southern Ontario; from Aboriginal
   burial grounds and precious petroglyphs areas near Peterborough, to an
   1812 battlefield in Niagara, cultural heritage landscapes throughout the
   province include tangible remains for understanding how the people
   arrived and how they have changed. Such diverse cultural heritage
   landscapes deserve clarity in definition and conservation treatment, in
   light of emerging threats from a range of development pressures - often
   destructive in nature. All this represents another kind of
   ``Borderland{''}, a struggle between the market forces of new land
   development and the, need to carefully conserve significant heritage
   landscapes. There are constant pressures to physically change, renew and
   develop all our towns and cities in Ontario, but these are often
   challenged by a public desire to identify and preserve special heritage
   areas that are important locally, regionally and provincially.},
