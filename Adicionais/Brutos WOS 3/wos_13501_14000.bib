@inproceedings{ WOS:000279844100027,
Author = {Recanzone, Gregg H.},
Editor = {Gazzaniga, MS},
Title = {Acoustic Stimulus Processing and Multimodal Interactions in Primates},
Booktitle = {COGNITIVE NEUROSCIENCES III, THIRD EDITION},
Year = {2004},
Pages = {359-367},
Note = {Conference of the Summer-Institute-in-Cognitive-Neuroscience, Lake
   Tahoe, CA, JUN, 2006},
Organization = {Summer Inst Cognit Neurosci},
Abstract = {This chapter focuses on recent studies of auditory cortical processes in
   humans and nonhuman primates. The primate auditory cortex consists of
   multiple cortical fields with a core-beltparabelt organization. Recent
   anatomical and physiological experiments in nonhuman primates indicate
   that acoustic space is preferentially processed in the caudal cortical
   areas, and nonspatial information, such as the temporal and spectral
   components of acoustic stimuli, is processed in the more rostral
   cortical areas. Visual stimuli also influence our auditory perceptions
   in the spatial domain, giving rise to phenomena such as the
   ventriloquism effect. Similarly, auditory stimuli influence our
   perception of visual stimuli in the temporal domain, giving rise to
   illusions such as ``seeing{''} visual stimuli that are consistent with
   simultaneously presented auditory stimuli. The cortical areas giving
   rise to these perceptions are still unknown and may be the result of
   feed-forward and feedback projections within a network of both
   multimodal and unimodal cortical areas.},
