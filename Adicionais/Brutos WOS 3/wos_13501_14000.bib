@article{ WOS:000209961000012,
Author = {Prista, Antonio and Picardo, Salazar and Ribeiro, Edmundo and Libombo,
   Joel and Daca, Timoteo},
Title = {Results From Mozambique's 2014 Report Card on Physical Activity for
   Children and Youth},
