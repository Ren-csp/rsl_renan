Title = {COMPARATIVE EVALUATION OF THE AIR QUALITY INDEXES. APPLICATION FOR THE
   GREATER ATHENS AREA},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Air pollution is one of the major problems of contemporary societies,
   especially in urban areas. In order to control the air pollution level
   and to avoid hazardous impacts on the living organisms and environment
   in general, a series of air pollutants measurements have been conducted
   in most cities of our planet. Accordingly, in most cases these
   measurements are included in a mathematical model in order to define the
   overall status of the air quality in the area under investigation.
   During the last years, a number of air quality models have been proposed
   expressing the attitude of the major economies towards the air pollution
   impacts. In parallel, a number of air quality measures/indices have been
   defined by various researchers and practitioners, attempting to reflect
   and assess the quality of the atmosphere.
   In this piece of research the parameters and the criteria embedded in
   the most widely used Air Quality Indices (AQIs) worldwide are reviewed,
   analysed and compared, in order to evaluate the quality of the ambient
   air. Additionally, an attempt is made in order to reveal any
   insufficiencies and flaws of these AQIs in real world applications.
   Finally, all the proposed models are used in order to estimate the air
   quality level in a big European city. For this purpose the corresponding
   AQIs are compared using actual pollutant concentration data from the
   database of the Greek ministry of environment for the greater Athens
   area. Their results are analyzed and interesting conclusions are drawn
   about their performance in view of detailed measurements.
   In this context, the weak points of the existing air quality models are
   discussed and the basic principles for a new enhanced air quality model
   are proposed.},
