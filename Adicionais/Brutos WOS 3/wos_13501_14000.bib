Note = {IEEE International Workshop on Metrology for Living Environment
   (MetroLivEnv), Milano, ITALY, MAY 29-31, 2023},
Organization = {IEEE; Politecnico Milano},
Abstract = {In recent years, great attention has been focused by the scientific
   community on the study and implementation of monitoring systems in urban
   and suburban areas for fire prevention. Data from 2021 show that about
   160 hectares of forest and non-forest areas in Italy have been destroyed
   by wildfires. For the purpose of this, the present conference paper aims
   to propose a preliminary mathematical model of reaction-diffusion to be
   used, with the data obtained from monitoring systems WNSs (Wireless
   Sensor Networks), for the purpose of predicting the development of a
   wildfire taking into account climatic and wind conditions, terrain
   topography and fuel present.},
