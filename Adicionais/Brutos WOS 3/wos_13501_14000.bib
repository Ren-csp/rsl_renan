@article{ WOS:A1994NG37200012,
Author = {LEFF, J},
Title = {WORKING WITH THE FAMILIES OF SCHIZOPHRENIC-PATIENTS},
Journal = {BRITISH JOURNAL OF PSYCHIATRY},
Year = {1994},
Volume = {164},
Number = {23},
Pages = {71-76},
Month = {APR},
Note = {Symposium on Integrated Approach to Schizophrenia, TURKU, FINLAND, JUN
   03-05, 1992},
Organization = {UNIV TURKU, DEPT PSYCHIAT; UNIV TURKU, CTR EXTENS STUDIES},
Abstract = {As schizophrenia is a heterogeneous condition with a variety of possible
   causes, it is sensible to combine biological and social treatment.
   Neuroleptic drugs give partial protection against environmental stress,
   but need to be supplemented. The programme developed on the basis of
   research on relatives' expressed emotion begins with education about
   schizophrenia for patients and relatives. Family sessions in the home
   are run in parallel with a relatives' group, and are aimed at improving
   communication, teaching problem-solving skills, lowering criticism and
   overinvolvement, reducing social contact between patient and relatives,
   expanding social networks, and lower expectations. Individual work with
   the patient is often undertaken alongside the family sessions, and
   includes social-skills training, anxiety management, and a cognitive
   approach to persistent psychotic symptoms. Therapists take a central
   role in coordinating the variety of services needed by patient and
   relatives.},
Publisher = {ROYAL COLLEGE OF PSYCHIATRISTS},
Address = {BRITISH JOURNAL OF PSYCHIATRY 17 BELGRAVE SQUARE, LONDON, ENGLAND SW1X
   8PG},
Type = {Article; Proceedings Paper},
Language = {English},
