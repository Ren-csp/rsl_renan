Title = {Emotional impact of bullying and cyberbullying on victims},
Booktitle = {XIV EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY (ECDP)},
Year = {2010},
Pages = {427-432},
Note = {14th European Conference on Developmental Psychology (ECDP), Mykolas
   Romeris Univ, Vilnius, LITHUANIA, AUG 18-22, 2009},
Abstract = {Many recent studies have focused on the emotional consequences of
   bullying and cyberbullying on victims. However, few studies have
   analysed these feelings in relation to the specific kind of aggression.
   In this study we analyse the emotional impact of these phenomena on
   victims in relation to four types of aggressions: direct and indirect
   bullying and cyberbullying using the Internet and using a mobile phone.
   The participants were 1671 pupils split in three groups of age (12-13;
   14-15; and 16-17 years old). The outcomes show that the emotional impact
   on victims of cyberbullying, either using the Internet or a mobile
   phone, is more similar to the emotional impact of indirect bullying than
   direct bullying. In addition, we found a group of victims who seem not
   to be bothered by the aggressions.},
