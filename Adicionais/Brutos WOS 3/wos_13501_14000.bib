@article{ WOS:000266722300064,
Author = {Fernandez, G. B. and Pereira, T. G. and da Rocha, T. B.},
Title = {Coastal Dunes along Rio de Janeiro Coast: Evolution and Management},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2009},
