@article{ WOS:000165108000064,
Author = {Segaar, IP and Schildwacht, P},
Title = {Using a calculation model to prevent serious air pollution from traffic},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2000},
Volume = {14},
Number = {1-6},
Pages = {588-596},
Note = {5th Workshop on Harmonization within Atmospheric Dispersion Modelling
   for Regulatory Purposes, RHODES, GREECE, MAY 18-AUG 21, 1998},
Organization = {Natl Ctr Sci Res Demokritos},
Abstract = {The municipality of Utrecht has ten years of experience with exceedances
   of the pollution limit values for NO2 and benzene, and offering advice
   for traffic plans on the effects of air pollution. Utrecht promotes
   prevention and integration of environmental issues in traffic plans and
   town planning. Utrecht has widened the use of the Dutch air pollution
   model for traffic (CAR) to prevent new exceedances of the limit values
   and even to aim at the target value for benzene. We also explored the
   influence of local differences in background concentrations. Using the
   present air pollution model for prevention, however, has restrictions:
   the influence of interpretations, when estimating input parameters, is
   considerable and the model is not suitable for motorways. It is a
   challenge for the model developers to do something about it.},
