Title = {The role of groundwater in landslides in the Lower Mainland of British
   Columbia, Canada},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOLS 1-5},
Year = {1998},
Pages = {1871-1878},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {Heavy and prolonged rainfall during the winter-spring of 1997, combined
   locally with unusual snowmelt, is strongly implicated as a triggering
   mechanism for a number of landslides throughout the Lower Mainland
   region of British Columbia. These events occurred in, or close to
   residential urban and rural areas, causing significant property damage,
   threatening the integrity of existing structures or interrupting
   transportation and water supply infrastructure. Trigger mechanisms
   related to rainfall are discussed along with the variety of mitigation
   procedures that have been adopted.},
