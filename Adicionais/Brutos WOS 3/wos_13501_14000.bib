Title = {Removal of lead from the soil using Myoporum laetum},
Booktitle = {SUSTAINABLE USE AND MANAGEMENT OF SOILS - ARID AND SEMIARID REGIONS},
Series = {Advances in Geoecology},
Year = {2005},
Volume = {36},
Pages = {519-526},
Note = {International Symposium on Sustainable Use and Management of Soils in
   Arid and Semiarid Regions, Tech Univ, Muralla del Mar Campus, Cartagena,
   SPAIN, SEP 22-26, 2002},
Abstract = {The most commonly used methods in studies of heavy metal pollution
   involve either the extremely high cost of excavation and burial or
   simply isolation of the contaminated areas. Such cleanup techniques can
   be practiced only in small areas (often a half hectare or less). Urban
   sites can be decontaminated from heavy metals by applying
   phytoremediation, which is a low cost process and suited to both small
   or large areas.
   The feasibility of using vegetation as a viable, ecologically
   acceptable, and cost-effective alternative to clean up metal
   contaminated soils, depends mainly on the identification and selection
   of plant species that possess the ability to accumulate metals. This
   work focused on the ability of Myoporum to tolerate and accurnulate
   toxic levels of lead in roots, shoots, and leaves in an arid climate and
   to compare it with Brossica nigra plant. These plants were cultivated
   outdoors under natural daylight in artificial soil media containing lead
   in the form of nitrate and sulfide. The tests showed that both plants
   have a good absorption capacity for lead when the heavy metal is in
   sulfide instead of nitrate form. The highest values in Pb concentration
   were found in the roots. The leaves have a slightly better lead capacity
   than the shoots. Both plants showed a good adaptation with the soil
   medium.},
