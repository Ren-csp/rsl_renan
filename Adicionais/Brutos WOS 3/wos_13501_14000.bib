Booktitle = {ADVANCES IN LIFE AND ENVIRONMENT},
Year = {2001},
Pages = {7-14},
Note = {4th HIU/OIT/SU/NJU/TU Symposium on Life and Environment, HIROSHIMA,
   JAPAN, SEP 21, 2001},
Organization = {Hiroshima Int Univ; Osaka Inst Technol; Setsunan Univ; NO Jiaotong Univ;
   Tongji Univ},
Abstract = {With the development of urban economy and growth of population in the
   Beijing City, the quantity of municipal refuse is rising, the
   composition is varying and the disposal cost is going up. These factors
   aggravate the difficulty of solving this problem. In this paper, waste
   source management theory and sampling investigation are used to analyze
   the waste volume and character of compositions on the basis of spot
   investigation. Some conclusions are drawn as follows: Municipal
   residents are the most important living refuse producers. Refuse control
   should be emphasized on educational industry. The quantity of municipal
   refuse varied little among seasons. Chaoyang District and Haidian
   District are the main districts requiring strengthened management. Food
   leavings are the main components of municipal refuse. At last, source
   management countermeasures in Beijing should be put forward.},
