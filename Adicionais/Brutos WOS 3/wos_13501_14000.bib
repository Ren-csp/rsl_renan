@article{ WOS:A1995RP84500008,
Author = {OLAH, A},
Title = {COPING STRATEGIES AMONG ADOLESCENTS - A CROSS-CULTURAL-STUDY},
Journal = {JOURNAL OF ADOLESCENCE},
