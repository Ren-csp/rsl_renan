Title = {Arctic Communities as Sites of Local Field Work in Environmental
   Chemistry},
Booktitle = {ENVIRONMENTAL CHEMISTRY: UNDERGRADUATE AND GRADUATE CLASSROOM,
   LABORATORY, AND LOCAL COMMUNITY LEARNING EXPERIENCES},
Series = {ACS Symposium Series},
