@article{ WOS:000170819800001,
Author = {Peper, M and Karcher, S and Wohlfarth, R and Reinshagen, G and LeDoux,
   JE},
Title = {Aversive learning in patients with unilateral lesions of the amygdala
   and hippocampus},
