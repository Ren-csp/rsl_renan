@inproceedings{ WOS:000080267100018,
Author = {Aninakwa, B},
Editor = {Leihner, DE and Mitschein, TA},
Title = {Paths of sustainable forestry development: The experience of Ghana},
Booktitle = {THIRD MILLENNIUM FOR HUMANITY?: THE SEARCH FOR PATHS OF SUSTAINABLE
   DEVELOPMENT},
Year = {1998},
Pages = {277-290},
Note = {Forum Belem I on a 3rd Millennium for Humanity - The Search for Paths of
   Sustainable Development, BELEM DO PARA, BRAZIL, NOV 26-29, 1996},
Abstract = {This paper presents the experiences made in Ghana to develop a
   sustainable forest management system. In 1994, the Ministry of Lands and
   Forestry of Ghana promulgated a new Forest and Wildlife Policy which
   stated the government's commitment to sustainable forestry development.
   One of the Policy's aspects is that participation has to be a critical
   element of a forward-looking strategy if forestry development is to be
   socially and environmentally sustainable. The participation in forest
   management is developing under the Collaborative Forest Management
   Programme. A case study of a successful initiative is used to explain
   what is meant by collaboration. The case study focuses on measures that
   farmers and foresters are jointly implementing to control illegal
   logging outside forest reserves. During 1994, logging activities have
   reached critical levels. Illegal felling and destruction of farms has
   drastically increased. The Forestry Department received the mandate to
   bring down off-reserve exploitation to more sustainable levels.
   Therefore, a broad-based working group which included farmers and the
   timber industry was set up by the Forest Department to identify the key
   problems. The identified key features led to an improved farmer
   participation in logging decisions and a strengthening of control
   measures. The implementation of these measures led to a reduced logging
   outside the forest reserves. Finally, ideas on criteria for sustainable
   development in the forestry sector of Ghana are presented.},
