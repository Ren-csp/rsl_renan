@article{ WOS:000261223900007,
Author = {Luu, Sheena and Wong, Willy and Noordin, Hafiz},
Title = {Low-level audiovisual synchrony: Experiments and model},
Journal = {JAPANESE PSYCHOLOGICAL RESEARCH},
Year = {2008},
Volume = {50},
