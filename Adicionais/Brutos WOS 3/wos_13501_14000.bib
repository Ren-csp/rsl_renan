@inproceedings{ WOS:000185615100032,
Author = {Tiezzi, E and Marchettini, N and Rosini, M},
Editor = {Tiezzi, E and Brebbia, CA and Uso, JL},
Title = {Extending the environmental wisdom beyond the local scenario:
   eco-dynamic analysis and the learning community},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2003},
Volume = {18-19},
Pages = {349-356},
Note = {4th International Conference on Ecosystems and Sustainable Development,
   SIENA, ITALY, JUN 04-06, 2003},
Organization = {Univ Siena; Wessex Inst Technol},
Abstract = {Beyond the specific dimension of the individual, learning is a primary
   characteristic of life. Shifting our attention to local systems we can
   consider ecosystems and traditional communities as learning ``minds{''},
   according to Bateson's thought. We call environmental wisdom the
   explicit knowledge that emerges from long periods of co-evolution of
   people and nature in local systems, casting in the same lot.
   Environmental wisdom rises both from trial-and-error processes and from
   more subtle kinds of knowledge, involving aesthetics and intuition. It
   sediments as tradition or religion and deeply contributes in landscapes
   creation, keeping ecosystems and humans alive together.
   The scientific enterprise has moved a large step aside from this path,
   and does not blend itself naturally with environmental wisdom; on the
   contrary, the scientific ideology played a great part in its
   abandonment. Nevertheless environmental wisdom is blind outside the
   local system dynamics' dominion, so nowadays it is not enough to achieve
   sustainability.
   This paper discusses eco-dynamic models as a first bridge to recompose
   scientific thought with environmental wisdom, re-binding an interrupted
   dialog between-local communities and nature.
   This constitutes the framework for the SPIn-Eco project, which tries to
   harmonize the local and the global level of sustainability of the Siena
   Province (Italy).},
