Title = {The role of saturation in colour naming and colour appearance},
Booktitle = {PROGRESS IN COLOUR STUDIES: COGNITION, LANGUAGE AND BEYOND},
Year = {2018},
Pages = {41-58},
Note = {4th Progress in Colour Studies (PICS) Conference, Univ Coll London,
   London, ENGLAND, SEP 14-16, 2016},
Abstract = {Saturation is an integral part of colour perception. Yet, this aspect of
   colour vision has been widely neglected in research on colour naming and
   colour appearance. Fundamental questions about colour naming and colour
   appearance need to be reconsidered in the light of the important role of
   saturation. These questions concern the variation of measurements across
   studies, the relationship between category prototypes and unique hues,
   cross-cultural regularities in colour categorization, focal colours and
   the salience of category prototypes, and the role of unique hues in
   colour appearance.},
