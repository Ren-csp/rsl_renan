@article{ WOS:000280896500015,
Author = {Conductier, Gregory and Blondeau, Nicolas and Guyon, Alice and Nahon,
   Jean-Louis and Rovere, Carole},
Title = {The role of monocyte chemoattractant protein MCP1/CCL2 in
   neuroinflammatory diseases},
