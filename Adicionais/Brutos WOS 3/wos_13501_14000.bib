@inproceedings{ WOS:000169016400067,
Author = {Han, ZH},
Editor = {Wang, YX},
Title = {Groundwater resource protection in the Hai River basin, China},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON HYDROGEOLOGY AND THE
   ENVIRONMENT},
Year = {2000},
Pages = {326-331},
Note = {International Symposium on Hydrogeology and the Environment (HE 2000),
   WUHAN, PEOPLES R CHINA, OCT 17-21, 2000},
Organization = {China Univ Geosci},
Abstract = {The groundwater resources in the Hai River basin of China represent a
   vital water resource. Both the shallow and deep aquifers are highly
   over-exploited in large area of Hai River basin. The heavy
   overexploitation of the groundwater resources is causing considerable
   environmental damage. For protecting groundwater resource, technical
   feasibility was evaluated. Artificial recharge using floodwater and
   wastewater are trial and perform. Surface spreading systems are
   applicable in many areas. Deep aquifer injections are undertaken in the
   urban area. A fat better strategy is to reduce the extraction of
   groundwater, which is especially important for stopping or slowing land
   subsidence and seawater intrusion. To address the problem of falling
   groundwater levels and aquifer recovery must incorporate both reducing
   groundwater extractions and artificial recharge.},
