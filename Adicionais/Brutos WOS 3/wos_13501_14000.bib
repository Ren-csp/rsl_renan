@inproceedings{ WOS:000235460200009,
Author = {Rizzolatti, G and Craighero, L},
Editor = {Changeux, JP and Damasio, AR and Singer, W and Christen, Y},
Title = {Mirror neuron: a neurological approach to empathy},
Booktitle = {NEUROBIOLOGY OF HUMAN VALUES},
Series = {Research and Perspectives in Neurosciences},
Year = {2005},
Pages = {107-123},
Note = {Conference on the Neurobiology of Human Values, Paris, FRANCE, JAN 24,
   2005},
Organization = {Fdn Ipsen},
Abstract = {Humans are an exquisitely social species. Our survival and success
   depend critically on our ability to thrive in complex social situations.
   But how do we understand others? Which are the mechanisms underlying
   this capacity?
   In the present essay we discuss a general neural mechanism ({''}mirror
   mechanism{''}) that enables individuals to understand the meaning of
   actions done by others, their intentions, and their emotions, through
   activation of internal representations coding motorically the observed
   actions and emotions.
   In the first part of the essay we will show that the mirror mechanism
   for ``cold{''} actions, those devoid of emotional content, is localized
   in the parieto-frontal cortical circuits. These circuits become active
   both when we do an action and when we observe another individual doing
   the same action. Their activity allows the observer to understand the
   ``what{''} of an action.
   We will show, then, that a ``chained{''} organization of motor acts plus
   the mirror mechanism enable the observer to understand the intention
   behind an action (the ``why{''} of an action) by observing the first
   motor act of an action.
   Finally, we will discuss some recent data showing that the mirror
   mechanism localized in other centers, like the insula, enables the
   observer to understand the emotions of others. We will conclude briefly
   discussing whether these biological data allow inferences about moral
   behavior.},
