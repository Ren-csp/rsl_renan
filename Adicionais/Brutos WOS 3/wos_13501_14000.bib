@inproceedings{ WOS:000079448800013,
Author = {Ibarra, G and Madariaga, I and Elias, A and Albizu, M and Agirre, E and
   Uria, J and Caamaño, J},
Editor = {Pepper, DW and Brebbia, CA and Zannetti, P},
Title = {Meteorological variables involved in the ozone formation in the Bilbao
   area},
Booktitle = {DEVELOPMENT AND APPLICATION OF COMPUTER TECHNIQUES TO ENVIRONMENTAL
   STUDIES},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {1998},
Volume = {2},
Pages = {127-135},
Note = {7th International Conference on Development and Application of Computer
   Techniques to Environmental Studies (ENVIROSOFT 1998), LAS VEGAS, NV,
   NOV 10-12, 1998},
Organization = {Wessex Inst Tech; Univ Nevada},
Abstract = {In urban environments, ozone formation is due to the interaction of
   emissions and meteorological effects. Meteorological fluctuations play
   an important role in the formation of ozone. This paper shows the work
   developed in order to correctly assess the fraction of the total ozone
   levels that meteorology variables account for in the area of Bilbao. The
   conclusions show that unlike previous works, temperature alone does not
   account for great fractions of the overall variability of ozone acid
   daily means of wind speed, absolute humidity, dew point temperature,
   pressure, radiation and maximum thermal gradient have also turned to be
   relevant variables. This group of meteorological variables account for
   85\% of the overall ozone signal.},
Publisher = {COMPUTATIONAL MECHANICS PUBLICATIONS LTD},
Address = {ASHURST LODGE, SOUTHAMPTON S04 2AA, HANTS, ENGLAND},
