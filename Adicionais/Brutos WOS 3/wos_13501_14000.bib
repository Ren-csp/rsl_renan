@article{ WOS:000232818700025,
Author = {Fenz, R and Blaschke, AP and Clara, M and Kroiss, H and Mascher, D and
   Zessner, M},
Title = {Monitoring of carbamazepine concentrations in wastewater and groundwater
   to quantify sewer leakage},
Journal = {WATER SCIENCE AND TECHNOLOGY},
