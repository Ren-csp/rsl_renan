@inproceedings{ WOS:001582875600058,
Author = {Silva, Daniel and Cunha, Liliana},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {``We Aren't a Blank Page Waiting to Be Filled In{''}: The Activity's
   Viewpoint and Its Contributions to the Design of Future Transport
   Automation},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 1, IEA 2024},
