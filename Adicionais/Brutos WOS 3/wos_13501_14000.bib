   BUTTINI, P},
Title = {THE CONTRIBUTION OF GAS-PHASE REACTIONS TO THE NITROARENE FRACTION OF
   MOLECULAR-WEIGHT 247 PRESENT IN CARBON PARTICLES SAMPLED IN AN URBAN
   AREA OF NORTHERN ITALY},
Journal = {ATMOSPHERIC ENVIRONMENT PART A-GENERAL TOPICS},
