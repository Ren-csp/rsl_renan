@inproceedings{ WOS:000335751400013,
Author = {Ata, S. and Erozkan, A.},
Editor = {Barone, L},
Title = {The Investigation Of The Attachment Styles, Emotional Intelligence,
   Empathic Tendency Of The Preschool Teachers},
Booktitle = {6TH INTERNATIONAL ATTACHMENT CONFERENCE},
Year = {2013},
Pages = {73-77},
Note = {6th International Attachment Conference (IAC), Pavia, ITALY, AUG 30-SEP
   01, 2013},
Organization = {Univ Pavia},
Abstract = {Attachment theory is designed to explain individual differences in
   cognitions, feelings, and behaviors that occur in the context of close
   relationships. Emotional intelligence is included to perception,
   expression and control of emotions, self-control and empathy,
   communication, conflict resolution process. These theory and concepts
   become prominent for personality of preschool teachers.
   The purpose of the present study is to investigate attachment styles,
   emotional intelligence level and emphatic disposition of the preschool
   teachers. The study was carried out by using descriptive method. In line
   with the purpose of the study, the study was carried out among the 500
   pre-school teachers (489 females and 11 males) working in primary
   schools in Mugla city in 2009-2010 school year. In the study, Personal
   Information Form, Relationship Scales Questionnaire, Bar-On Emotional
   Intelligence Measurement Scale and Emphatic Disposition Scale were used
   as data collection tools. The data were analyzed through SPSS/ WINDOWS
   14.0 program package. Regression and correlation analyses were used for
   data analysis. In order to interpret the Attachment Styles and Emotional
   Intelligence Scores and Empathy disposition regression analysis was
   employed. The findings of the study revealed that there are significant
   differences among the attachment styles, sub-dimensions of emotional
   intelligence and empathic dispositions based on the length of service,
   age and gender. Moreover, significant differences based on the length of
   service and gender variables were found among the attachment styles and
   sub-dimensions of emotional intelligence and empathic dispositions. The
   findings of the study were discussed in light of the previous findings
   reported in the literature in such a way as to provide guidance for
   further studies within the context of Attachment Styles, Emotional
   Intelligence and Empathic Disposition.},
