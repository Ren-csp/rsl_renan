@article{ WOS:000327923300006,
Author = {Apkarian, A. Vania and Neugebauer, Volker and Koob, George and Edwards,
   Scott and Levine, Jon D. and Ferrari, Luiz and Egli, Mark and
   Regunathan, Soundar},
Title = {Neural mechanisms of pain and alcohol dependence},
