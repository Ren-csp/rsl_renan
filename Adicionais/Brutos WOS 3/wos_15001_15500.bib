@article{ WOS:A1991GL80200014,
Author = {PAIN, N},
Title = {SUSTAINABLE DEVELOPMENT - DEALING WITH THE CONCEPT IN THE AUSTRALIAN
   LEGAL FRAMEWORK AND SUGGESTIONS FOR CHANGE TO THAT FRAMEWORK AND BEYOND},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1991},
Volume = {108},
Number = {1-2},
Pages = {151-161},
Month = {OCT 1},
Note = {CONF ON SUSTAINABLE POLICIES AND MAKING THEM WORK, UNIV NEW S WALES,
   SYDNEY, AUSTRALIA, NOV 09-10, 1989},
Abstract = {With the publication of the Brundtland Report the words ``sustainable
   development{''} became well known throughout much of the world.  The
   words were first used in the international context in the World
   Conservation Strategy published by IUCN in 1980.  By its nature the
   Brundtland Report is a broad document with sweeping recommendations on a
   wide range of measures.  Countries and their governments must devise in
   detail how concepts such as sustainable development can be implemented. 
   This has involved assessing what sustainable development actually means
   and considering ways in which it can be implemented at a national level.
   This discussion paper has sought to raise some of the legal issues which
   need to be considered if the concept of sustainable development is to be
   implemented at a national or state level in Australia.  It seeks to
   highlight some of the limits of the legal system, particularly in
   limiting the discretion of elected representatives who make many of the
   crucial development decisions.  It suggests changes to existing legal
   mechanisms such as environmental impact assessment to implement
   sustainable development objectives and refers to some new measures which
   should be implemented; for example, a Bill of Environmental Rights and a
   reversal of the onus in favour of development which presently exists.
   This discussion paper was expressly written to raise points of interest
   for people with no formal legal training and is not exhaustive of all
   the possibilities for change.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
