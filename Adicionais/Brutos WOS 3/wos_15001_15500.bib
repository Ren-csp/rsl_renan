Title = {Detecting Flow Experiences in the Field Using Video-Based Head and Face
   Activity Recognition: A Pilot Study},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE (NEUROIS RETREAT 2021)},
Series = {Lecture Notes in Information Systems and Organization},
