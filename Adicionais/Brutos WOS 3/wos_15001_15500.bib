@inproceedings{ WOS:000258163600010,
Author = {Ciegis, Remigijus and Gavenauskas, Algirdas and Petkeviciute, Nijole},
Book-Group-Author = {LUA},
Title = {Sustainable development - an ethical value within the context of
   globalization},
Booktitle = {RURAL DEVELOPMENT 2005, VOL 2, BOOK 1, PROCEEDINGS: GLOBALISATION AND
   INTEGRATION CHALLENGES TO RURAL DEVELOPMENT IN EASTERN AND CENTRAL
   EUROPE},
Series = {Rural Development},
Year = {2005},
Pages = {43-49},
Note = {2nd International Scientific Conference on Rural Development, Kaunas
   City, LITHUANIA, NOV 17-19, 2005},
Organization = {Lithuanian Acad Sci; Minist Agr; Minist Environm; Minist Educ \& Sci;
   Inst Agrarian Econ; Univ Perugia; European Assoc Agrarian Economists;
   Nord Assoc Agr Scientists},
Abstract = {More and more attention to the ethical dimension of the sustainable
   development is given in scientific economical literature. In this paper,
   the authors analyse issues related to sustainable economic development
   and emphasize the ethical aspects of this path of the economy. The
   article evaluates the ethical aspects of sustainability. According to
   the collected theoretical and practical material, the perspectives of
   future developments in sustainability from the viewpoint of principles
   of sustainable development management and ethical behavior systems are
   reviewed.
   Ethical aspects are very important, because humanity is now faced with
   the principle problem - to have or not to have the future. Today, if we
   want to make economic decisions, it is not enough to have sufficient
   economic information and a narrow criterion of economic efficiency. We
   need to have other criteria - ecological, ethical - that are very
   important for the sustainable development of the world. The ecological
   -ethical imperative shows the limit beyond which sustainable life
   becomes impossible.
   People are going to the next millennium, in which must be formed new
   attitudes to the environment, scientific and technological progress,
   integration of different cultures and traditions and economical
   development. The concept of economical development as used in the last
   century is impossible to use today without changes. If we take in the
   account externalities and the negative consequences of economical
   actions, we must again to think about theoretical background of
   economical life.
   The concept of the sustainable development, without which it is
   impossible to imagine discussions about the environment and development,
   is real alternative in economic theory to the neoclassical growth
   theory, which treats economical growth as the quantitative material
   growth of the economy.
   The conflict between man and nature results in ecological problems,
   among the most topical and urgent problems in the world. Sustainable
   development solutions can be ecological if a new ecological philosophy
   and new attitude to man and nature arises, Ecological philosophy, as a
   new and modem limb of philosophy, has to harmonize relations between the
   human and nature. The whole World is affected by the global ecological
   crisis made by Man, who generates chaos by himself And Man must overcome
   himself chaos, must harmonize himself with life. Sustainable development
   must create a fair and moral covenant between Man and nature. But we
   can't solve human problems practically, while they is unsolved in
   theory, while we haven't clear reason in ourselves. The ideology of
   sustainable development ideology has the following task: with respect to
   environmental, economical, social, and mentality problems, it must
   educate a new grasp of things in Man. A society of sustainable
   development must educate man with a new understanding that your must
   must be fair, honest, right, unselfish, and full of love for humanity
   and nature.},
