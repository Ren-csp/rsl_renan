@inproceedings{ WOS:000452696800005,
Author = {Goltsova, Natalya V. and Yakovleva, Yelena V.},
Editor = {Sheridan, S and Veraksa, N},
Title = {PREVENTION OF THREATS TO THE CHILD'S SOCIAL DEVELOPMENT IN ANTISOCIAL
   FAMILY},
