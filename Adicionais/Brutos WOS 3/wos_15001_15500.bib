@inproceedings{ WOS:000664299600008,
Author = {Jaiswal, Tanushri and Jhariya, D. C.},
Book-Group-Author = {IOP},
Title = {Monitoring the Land Surface and water bodies temperature and its impact
   on surface water turbidity in Raipur, Chhattisgarh, India},
