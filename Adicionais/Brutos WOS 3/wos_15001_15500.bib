@inproceedings{ WOS:000235640900041,
Author = {Acosta, JA and Martínez-Martínez, S and Faz, A and Van Mourik, JM and
   Mermut, AR and Verstraten, JM},
Editor = {Cano, AF and Silla, RO and Mermut, AR},
Title = {Heavy metal distribution in soils of Cartagena, SE Spain},
Booktitle = {SUSTAINABLE USE AND MANAGEMENT OF SOILS - ARID AND SEMIARID REGIONS},
Series = {Advances in Geoecology},
Year = {2005},
Volume = {36},
Pages = {407-420},
Note = {International Symposium on Sustainable Use and Management of Soils in
   Arid and Semiarid Regions, Tech Univ, Muralla del Mar Campus, Cartagena,
   SPAIN, SEP 22-26, 2002},
Abstract = {Contamination of soils by heavy metals has become a leading
   environmental concern for society. Mining of heavy metals has been a
   tradition for at least 2,500 years in Cartagena, Spain. The
   concentrations of Fe, Mn, Pb, Cu, Zn, and Cd were measured in the
   topsoil of 72 sites placed In urban, agricultural, industrial, and
   natural areas of the city of Cartagena to: 1) identify the possible
   contamination sources; 2) determine the spatial distribution pattern;
   and 3) establish the levels of the selected metals in different soil use
   groups. We determined soil pH, calcium carbonate, organic carbon, and
   total nitrogen contents, CEC, and the amounts of soluble salts and
   texture. The concentrations of metals were compared with the maximum
   allowable limits by Italian legislation, giving a contamination value of
   the area of about 52\% for Zn, 54\% for Cd, 49\% for Pb, and 20\% for
   Cu. The distribution pattern of metals suggests that they are
   concentrated along the northeast to southwest wind direction. The old
   smelter and zinc producing industry likely plays a very significant role
   in the concentrations of Zn, Pb, Cd, and Cu in the southeast and east
   area of the city. Possibly, pesticides, fertilizers and urban wastes are
   other important sources for the elevated levels of copper. Amounts of Cd
   are high enough to suggest that there is a risk of cancer in the area.},
