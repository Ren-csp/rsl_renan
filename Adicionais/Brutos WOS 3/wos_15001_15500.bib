@article{ WOS:000247663200029,
Author = {Gard, David E. and Kring, Ann M. and Gard, Marja Germans and Horan,
   William P. and Green, Michael F.},
Title = {Anhedonia in schizophrenia: Distinctions between anticipatory and
   consummatory pleasure},
Journal = {SCHIZOPHRENIA RESEARCH},
Year = {2007},
Volume = {93},
Number = {1-3},
Pages = {253-260},
Month = {JUL},
Note = {18th Annual Meeting of the Society-for-Research-in-Psychopathology,
   Toronto, CANADA, OCT, 2003},
Organization = {Soc Res Psychopathol},
Abstract = {Research on anhedonia in schizophrenia has revealed mixed results, with
   patients reporting greater anhedonia than healthy controls on
   self-report measures and semi-structured interviews, but also reporting
   comparable experiences of positive emotions in response to pleasurable
   stimuli. Basic science points to the importance of distinguishing
   between anticipatory and consummatory (or in-the-moment) pleasure
   experiences, and this distinction may help to reconcile the mixed
   findings on anhedonia in schizophrenia. In two studies, we tested the
   hypothesis that anhedonia in schizophrenia reflects a deficit in
   anticipatory pleasure but not consummatory pleasure. In Study 1, we used
   experience sampling methodology to assess reported experiences of
   consummatory, and anticipated pleasure among schizophrenia patients and
   controls. In Study 2, schizophrenia patients and controls completed a
   self-report trait measure of anticipatory and consummatory pleasure and
   interviews that assessed negative symptoms, including anhedonia, and
   community functioning. In both studies, we found evidence for an
   anticipatory but not a consummatory pleasure deficit in schizophrenia.
   In addition, anticipatory pleasure was related to clinical ratings of
   anhedonia and functional outcome. Clinical and research implications of
   these findings are discussed. (c) 2007 Elsevier B.V. All rights
   reserved.},
