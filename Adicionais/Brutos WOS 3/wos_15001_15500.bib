@article{ WOS:000246484500016,
Author = {Lin, James C. and Wang, Zhangwei},
Title = {Hearing of microwave pulses by humans and animals: Effects, mechanism,
   and thresholds},
Journal = {HEALTH PHYSICS},
Year = {2007},
