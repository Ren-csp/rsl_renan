@inproceedings{ WOS:000659907500009,
Author = {Uyanayeva, Kh and Kokov, N. and Toguzayev, T. and Kuchukov, M. and
   Alibius, F.},
Book-Group-Author = {IOP},
Title = {North Caucasian consumer model of economic growth: factors and
   mechanisms},
Booktitle = {III INTERNATIONAL SCIENTIFIC CONFERENCE: AGRITECH-III-2020:
   AGRIBUSINESS, ENVIRONMENTAL ENGINEERING AND BIOTECHNOLOGIES, PTS 1-8},
Series = {IOP Conference Series-Earth and Environmental Science},
