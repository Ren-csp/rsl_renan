@inproceedings{ WOS:000227683000072,
Author = {Burkholder, R and Pisoni, D},
Editor = {Miyamoto, RT},
Title = {Digit span recall error analysis in pediatric cochlear implant users},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
