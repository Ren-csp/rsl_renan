@article{ WOS:000087136100004,
Author = {Barrett, AM and Crosson, JB and Crucian, GP and Heilman, KM},
Title = {Horizontal line bisections in upper and lower body space},
Journal = {JOURNAL OF THE INTERNATIONAL NEUROPSYCHOLOGICAL SOCIETY},
Year = {2000},
Volume = {6},
