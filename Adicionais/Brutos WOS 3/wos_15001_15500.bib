@inproceedings{ WOS:000223250200037,
Author = {Currie, G and Sarvi, M and Young, W},
Editor = {Wadhwa, LC},
Title = {A new methodology for allocating road space for public transport
   priority},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
