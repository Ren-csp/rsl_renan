@article{ WOS:000232721400028,
Author = {Amedi, A and von Kriegstein, K and van Atteveldt, NM and Beauchamp, MS
   and Naumer, MJ},
Title = {Functional imaging of human crossmodal identification and object
   recognition},
Journal = {EXPERIMENTAL BRAIN RESEARCH},
Year = {2005},
