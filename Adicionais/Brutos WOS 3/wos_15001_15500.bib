@inproceedings{ WOS:000647462800112,
Author = {Zhang, Xiuhua},
Book-Group-Author = {IOP},
Title = {Online measurement of distributed capacitance in distribution network},
Booktitle = {2020 6TH INTERNATIONAL CONFERENCE ON ENERGY, ENVIRONMENT AND MATERIALS
   SCIENCE},
