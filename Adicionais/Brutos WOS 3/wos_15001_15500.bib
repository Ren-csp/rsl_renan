   Jing and Liu, Weidong},
Editor = {Zhang, Q and Leung, M and Wang, XK and Liu, YJ and Mo, JH},
Title = {A PREDICTIVE STUDY ON HOURLY OUTSIDE DRY-BULB TEMPERATURE BY RECURRENT
   BACK PROPAGATION NETWORK: NIGHTTIME PARTS},
Booktitle = {FIFTH INTERNATIONAL WORKSHOP ON ENERGY AND ENVIRONMENT OF RESIDENTIAL
   BUILDINGS AND THIRD INTERNATIONAL CONFERENCE ON BUILT ENVIRONMENT AND
   PUBLIC HEALTH, VOL I AND II, PROCEEDINGS},
Year = {2009},
Pages = {1277-1284},
Note = {5th International Workshop on Energy and Environment of Residential
   Buildings/3rd International Conference on Built Environment and Public
   Health, Guilin, PEOPLES R CHINA, MAY 29-31, 2009},
Organization = {Hunan Univ; Univ Hong Kong; Tsinghua Univ},
Abstract = {The data of hourly outside dry-bulb temperature are indispensable in
   many areas, such as, the cooling load calculation, energy consumption
   analysis of air-conditioning system etc. In general, the outside
   dry-bulb temperature is recorded every 6 hours each day in a
   meteorological station, i.e. 2, 8, 14 and 20 (GMT+8) respectively.
   According to the sunshine duration, the hourly outside dry-bulb
   temperature could be divided into daytime parts and nighttime parts to
   establish the forecast model respectively. This paper firstly divided
   the hourly outside dry-bulb temperature into daytime and nighttime parts
   and determined the influential parameters of nighttime parts of outside
   dry-bulb temperature. Secondly, the dry-bulb temperature historic data
   of four records each day in meteorological station was collected, and
   the nighttime parts of outside dry-bulb temperature were pre-processed.
   Based on the historical data of four records each day for outside
   dry-bulb temperature and the factors of outside dry-bulb temperature, an
   hourly forecast model was built to forecast outside dry-bulb temperature
   of nighttime parts by using the recurrent back propagation network.
   Finally, the meteorological data sequences from January 2001 to January
   2002 in Shanghai city were used to validate the RBPN and the result
   shows that RBPN provides better accuracy than other methods.},
