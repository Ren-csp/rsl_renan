Title = {RETARDING CAPACITY ESTIMATION OF WETLAND PADDY FIELDS UNDER CLIMATE
   CHANGE AND LAND USE CHANGE},
Booktitle = {PROCEEDINGS OF THE 38TH IAHR WORLD CONGRESS},
