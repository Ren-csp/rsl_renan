@article{ WOS:000080975600020,
Author = {Norman, AL and Hopper, JF and Blanchard, P and Ernst, D and Brice, K and
   Alexandrou, N and Klouda, G},
Title = {The stable carbon isotope composition of atmospheric PAHs},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1999},
Volume = {33},
Number = {17},
Pages = {2807-2814},
Month = {AUG},
Note = {6th International Conference on Carbonaceous Particles in the
   Atmosphere, VIENNA, AUSTRIA, SEP 22-24, 1997},
Abstract = {A method for compound-specific stable carbon isotope analysis of
   atmospheric polycyclic aromatic hydrocarbons (PAHs) in carbonaceous
   aerosols is described. Atmospheric aerosol samples containing PAHs (C-10
   to C-20) were collected on filters using a high-volume sampling
   technique, solvent extracted, taken through a cleanup procedure,
   separated by gas chromatography, oxidized to CO2 on-line, and introduced
   into an isotope ratio mass spectrometer for analysis. The method can be
   used to determine the isotope composition of a few nanograms of PAHs.
   This technique was used to analyse and compare the isotope composition
   of atmospheric PAHs from standards, as well as two samples from urban
   and rural locations. Isotopic variability in atmospheric PAHs is greater
   than measurement uncertainties which makes this a potentially useful
   technique for source identification when used together with
   concentration measurements. (C) 1999 Elsevier Science Ltd. All rights
   reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Norman, AL (Corresponding Author), Univ Calgary, Dept Phys \& Astron, 2500 Univ Dr NW, Calgary, AB T2N 1N4, Canada.
