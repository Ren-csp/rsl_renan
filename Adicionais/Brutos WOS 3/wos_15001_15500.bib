Organization = {NATO Sci \& Environm Affairs Div; European Sci Fdn; EUROCHAMP},
Abstract = {The first steps of ozone episode modeling for Kiev city are described.
   For simulation of ozone concentrations, the Prognostic Meteorological
   Model (PMM) and Urban Airshed Model (UAM-V) (SAI) are used. The episode
   of enhanced ozone concentrations for 17-21 August 2000 from monitoring
   data in Kiev Botanic Garden was selected for modeling. The results of
   model calculations show the importance for a more detailed temporal
   modulation of emission data, in particular hourly NO, NO, and VOC data,
   and the necessity of taking into account night time heterogeneous
   chemistry. FTIR observations from 2007 for two enhanced ozone episodes
   were analyzed with the help of MODTRAN modeling. Troposphere Ozone
   columns and profiles are discussed.},
