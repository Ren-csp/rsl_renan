@inproceedings{ WOS:000180592200018,
Author = {Griffiths, T},
Editor = {Saunders, D and Spratt, D and VanWensveen, M},
Title = {Francis Ratcliffe and changing ecological visions},
Booktitle = {PERSPECTIVES ON WILDLIFE RESEARCH: CELEBRATING 50 YEARS OF CSIRO
   WILDLIFE AND ECOLOGY},
Year = {2002},
Pages = {132-140},
Note = {Seminar on Perspectives on Wildlife Research, AUSTRALIA, 1999},
Organization = {Commonwealth Sci \& Ind Res Org},
Abstract = {Scientific problems, social dilemmas and fieldwork hurdles confronted
   and challenged Francis Ratcliffe, founder of the Wildlife Survey Section
   in 1949, on his first adventures as a biologist in Australia in the
   1920s and 1930s. This chapter explores issues concerning the balance
   between science and public policy, the foundation role of the politics
   of empire, the intersection of nature and nation in a settler society,
   the emergence of a holistic ecological landscape vision, and about
   conducting science in a human setting. In later years ecologists
   incorporated sophisticated quantitative techniques and theories from the
   physical sciences in an effort to make the discipline a ``hard
   science{''}. The social, human dimension became a factor which had to be
   read out, a non-natural disturbance or intrusion that lay outside the
   real equation. Now, the pendulum is swinging. Without losing the
   scientific sophistication they have gained, ecologists are again
   embracing the social dimensions of their studies, rediscovering the
   special opportunities they have in working on the borderland between the
   social and the biological sciences. At the end of the 1990s, as
   scientists increasingly study humanity as an integral component of the
   ecosystem, it is worth recalling just how social was Ratcliffe's own
   pioneering science. People were as much his subject of study as the
   wildlife, and an assessment of the sustainability of Australian nature
   and settlement required a thorough understanding of both.},
