@inproceedings{ WOS:000322747100008,
Author = {Mustelin, Johanna and Khamis, Miza and Klein, Robert G. and Mzee, Abbas
   J. and Haji, Tahir Abbas and Asseid, Bakar and Sitari, Taimi},
Editor = {LealFilho, W},
Title = {Coastal Forest Buffer Zones and Shoreline Change in Zanzibar, Tanzania:
   Practical Measures for Climate Adaptation?},
Booktitle = {EXPERIENCES OF CLIMATE CHANGE ADAPTATION IN AFRICA},
Series = {Climate Change Management},
Year = {2011},
