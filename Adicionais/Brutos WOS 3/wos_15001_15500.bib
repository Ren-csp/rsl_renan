@inproceedings{ WOS:000234127600024,
Author = {Ludwig, DF and Truchon, SP and Tammi, C},
Editor = {Calabrese, EJ and Kostecki, PT and Dragun, J},
Title = {A framework for river cleanup decision making Foundation principles for
   managing the Neponset River watershed},
Booktitle = {CONTAMINATED SOILS, SEDIMENTS AND WATER VOLUME 10: SUCCESSES AND
   CHALLENGES},
Series = {CONTAMINATED SOILS SERIES},
Year = {2006},
Pages = {359+},
Note = {20th Annual International Conference on Soils, Sediments and Water,
   Amherst, MA, OCT 18-21, 2004},
Abstract = {The Neponset River drains a landscape that has been disturbed by human
   beings for hundreds, possibly thousands, of years. The watershed is now
   intensely developed and modified to accommodate built environments.
   Deliberations regarding restoration and cleanup of the Neponset (and
   other rivers in urban landscapes) will benefit from a set of principles
   to guide activities and a decision context to provide a framework for
   competing considerations. This paper proposes a draft suite of eight
   principles that, together, offer social, scientific, and engineering
   foundations for decision making. Those principles are consolidated in a
   decision model incorporating trade offs among the value of the habitat
   in place, the potential value of restoration activities, habitat
   destruction inherent in remediation technologies, risks associated with
   exposure to industrial chemicals now in the ecosystem, and the potential
   risk-reduction benefits of chemical remediation. We conclude that
   optimal management decisions must account for and balance the
   considerations inherent in each of these decision categories.},
