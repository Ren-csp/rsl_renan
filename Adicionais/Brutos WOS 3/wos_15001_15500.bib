@inproceedings{ WOS:001441909800003,
Author = {Das Malakar, Kousik and Kumar, Manish and Kuzur, Gloria},
Editor = {Kumar, M and Kumar, P and Anand, S and Verma, NK and Tripathi, DK},
Title = {Decoding Climate Change: Bridging the Gap for Sustainable Societal Space
   Through Critical Thinking},
Booktitle = {GEOGRAPHICAL DIMENSIONS OF ENVIRONMENTAL SUSTAINABILITY, IGU THEMATIC
   CONFERENCE 2022},
Series = {Advances in Geographical and Environmental Sciences},
Year = {2024},
Pages = {36-52},
Note = {2022 International Geographical Union Thematic Conference, Mahendragarh,
   INDIA, NOV 24-25, 2022},
Abstract = {In the midst of the climate crisis, taking a critical approach to
   climate concerns becomes vital and revolutionary in generating creative
   solutions, and addressing societal expectations and views. Understanding
   climate change and its effects on socio-ecological concerns necessitates
   understanding and awareness of certain core climate change theories, as
   well as climate philosophical viewpoints. The purpose of this study is
   to present a new line of argument in the reconceptualization of critical
   climate change thinking, with an emphasis on climate change as the most
   serious issue of our time. Based on this context, this study revealed
   and recognized critical thinking and arguments for understanding crucial
   climate change concepts by critically exploring a variety of ideas,
   including climate gap, climate engineering, climate kids, and climate
   education. The core findings show that people from marginalized
   communities, such as people of colour and those with low incomes, endure
   a disproportionate cost of the effects of climate change and are
   frequently excluded from important conversations on viable solutions.
   And, the practical application of climate engineering encountered
   ethical and legal challenges that necessitated careful thought in order
   to be successful in real-world circumstances. Climate kids, on the other
   hand, is a novel concept that aids youth and children in the formation
   of future climate leaders, and climate change education is a more
   significant component of effective policy implementation at the local
   and community levels. Moving away from the overarching narratives of
   critical concern, our addition to existing knowledge is to explain why
   and how critical thinking is necessary for unravelling and
   conceptualizing the complex nature of climate change. In addition, we
   advocate for a bottom-up social approach, emphasizing the importance of
   a `societal space' as a different and distinctive viewpoint.},
