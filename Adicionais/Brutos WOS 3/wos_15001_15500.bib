@article{ WOS:A1996VN11000023,
Author = {Campo, G and Orsi, M and Badino, G and Giacomelli, R and Spezzano, P},
Title = {Evaluation of motorway pollution in a mountain ecosystem. Pilot project:
   Susa Valley (Northwest Italy) years 1990-1994},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1996},
Volume = {189},
Pages = {161-166},
Month = {OCT 28},
Note = {5th International Symposium on Highway and Urban Pollution, WHO EUROPEAN
   OFF, COPENHAGEN, DENMARK, MAY 22-24, 1995},
Organization = {WHO European Off},
Abstract = {The construction of the new A32 motorway, which connects the city of
   Torino to France through the Frejus mountain tunnel, has given us the
   opportunity to implement a research programme, over a number of years,
   with the goal of evaluating air dispersion and ground absorption of
   pollutants emitted by motor-vehicles in the countryside along the Susa
   Valley motorway. The research programme started with an in-depth study
   of the Susa Valley environment (including the levels of air pollution
   measured at the starting date of the programme) followed by the
   implementation of a simulation model of pollutant dispersion. Then a
   pilot area was prepared where selected species of plants, lichens,
   isopods and anellids were transplanted to monitor the motorway pollution
   trend. The overall testing activities, in addition to the simulation
   model, have enabled us to clearly define the levels and characteristics
   of pollution in the Susa Valley as a result of the opening of the new
   motorway.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {CONSULAGRI SRL, I-10121 TURIN, ITALY.},
DOI = {10.1016/0048-9697(96)05205-9},
ISSN = {0048-9697},
Keywords = {motorway pollution; mountain ecosystem; pollutants; air dispersion;
   ground absorption},
