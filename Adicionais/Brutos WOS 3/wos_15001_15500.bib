   Healthy Lifestyles},
Booktitle = {25TH AGILE CONFERENCE ON GEOGRAPHIC INFORMATION SCIENCE ARTIFICIAL
   INTELLIGENCE IN THE SERVICE OF GEOSPATIAL TECHNOLOGIES},
Series = {AGILE-GIScience Series},
Year = {2022},
