@article{ WOS:000185863000045,
Author = {Neal, C and Davies, H},
Title = {Water quality fluxes for eastern UK rivers entering the North Sea: a
   summary of information from the Land Ocean Interaction Study (LOIS)},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
