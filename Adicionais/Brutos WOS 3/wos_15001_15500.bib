Title = {AIR-POLLUTION LOADS ON HISTORICAL MONUMENTS - AN AIR-QUALITY MODEL
   APPLICATION TO THE MARBLE ARCH-OF-TITUS IN ROME},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1995},
Volume = {171},
Number = {1-3},
