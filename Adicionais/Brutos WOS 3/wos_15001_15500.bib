@article{ WOS:A1992JB27000005,
Author = {DAWSON, B and VAUGHAN, AR and WAGNER, WG},
Title = {NORMAL RESPONSES TO SEXUALLY ANATOMICALLY DETAILED DOLLS},
Journal = {JOURNAL OF FAMILY VIOLENCE},
Year = {1992},
Volume = {7},
Number = {2},
Pages = {135-152},
