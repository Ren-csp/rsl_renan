@article{ WOS:A1996UA02000002,
Author = {Plummer, P},
Title = {Spatial competition amongst hierarchically organized corporations:
   Prices, profits, and shipment patterns},
Journal = {ENVIRONMENT AND PLANNING A-ECONOMY AND SPACE},
Year = {1996},
Volume = {28},
