Author = {Rodriguez, R and Armienta, A and Longley, L},
Editor = {Chilton, J},
Title = {The role of mine waste disposal in the arsenic pollution of groundwater
   in Zimapan, Mexico},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
