@inproceedings{ WOS:000768819800035,
Author = {Raihan, Shafkat and Zisad, Sharif Noor and Ul Islam, Raihan and Hossain,
   Mohammad Shahadat and Andersson, Karl},
Editor = {Mahmud, M and Kaiser, MS and Vassanelli, S and Dai, Q and Zhong, N},
Title = {A Belief Rule Base Approach to Support Comparison of Digital Speech
   Signal Features for Parkinson's Disease Diagnosis},
Booktitle = {BRAIN INFORMATICS, BI 2021},
