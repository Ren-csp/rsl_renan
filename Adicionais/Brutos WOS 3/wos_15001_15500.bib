@inproceedings{ WOS:000081130600005,
Author = {Jiang, YL and Mao, WB and Song, XL and Chen, JD and Rao, HS and Zhu, YH
   and Zhou, SW},
Book-Group-Author = {INT EROSION CONTROL ASSOC
   INT EROSION CONTROL ASSOC},
Title = {Bioengineering for high-grade highway infrastructure development in
   southwest China},
Booktitle = {INTERNATIONAL EROSION CONTROL ASSOCIATION - PROCEEDINGS OF CONFERENCE 30},
Series = {INTERNATIONAL EROSION CONTROL ASSOCIATION - PROCEEDINGS OF CONFERENCE},
Year = {1999},
Volume = {30},
Pages = {39+},
Note = {30th Conference of the International-Erosion-Control-Association,
   NASHVILLE, TN, FEB 22-26, 1999},
Organization = {Int Erosion Control Assoc},
Abstract = {Within the framework of the National Trunk Highway Networks in China, a
   leap of the high-grade highway infrastructure construction is expected
   by 2020. The southwest part of China, where over 170 million people
   live, faces probably the bad combination of a fragile, young, weak
   geology, very deep valleys with steep slope, intensive monsoon rainfalls
   and high seismic activities. Due to the complex nature of this
   environment, the development of road is a highly challenging task,
   although this megaproject will provide fast transportation, economic
   improvement for this region.
   The application of the bioengineering project has been initiated since
   1992 in an attempt to reduce the ecological environment destroyed and
   create a beautiful view of the road environment. In the context of
   vegetation stabilization technique, plants are used for catching,
   armoring, supporting, draining and limiting the slope failure and
   improvement of the high-grade highway environment. Usually, grasses are
   widely used for slope stability in those subtropical mountain area:
   Agropyron cristatum, Cynodon dactylon, Eragrostis ferruginea, Festuca
   arundinacea, Lolium perenne, Medicago Sativa, Paspalum notatum,
   Poapratensis, Trifolium pratense, T. repens, Zoyasia japonica. With the
   hydroseeder, grass and shrub become established and deep rooted more
   quickly to reduce chances of erosion on slopes or spotty growth in poor
   soil area. Ever-green shrubs and small trees, such as Chamaecyparis
   obtusa, Juniperus forumosna Hayata, Ligustrum, Platycladus spach, and
   Sabina mill are employed to avoid the opposite lighting, induce the
   drive's sight and decorating while the grasses take the secondary layer
   in the central vegetation trip and interchange area. The evidence showed
   clearly that bioengineering techniques are part of the sustainable
   development of high-grade highway infrastructure construction by making
   beautiful scenery, ensuring the security of transportation and
   environment protection.},
