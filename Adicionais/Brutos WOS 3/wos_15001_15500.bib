@inproceedings{ WOS:000287981100019,
Author = {Galanos, G.},
Editor = {Brebbia, CA and Pineda, FD},
Title = {The effect of climate change in the future development of tourism: a
   theoretical approach},
Booktitle = {SUSTAINABLE TOURISM IV},
