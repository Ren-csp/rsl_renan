@inproceedings{ WOS:000240047600010,
Author = {Tsianaka, E.},
Editor = {Broadbent, G and Brebbia, CA},
Title = {Evaluating the sophistication of vernacular architecture to adjust to
   the climate},
Booktitle = {Eco-Architecture: Harmonisation between Architecture and Nature},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2006},
Volume = {86},
Pages = {93-101},
Note = {1st International Conference on Harmonisation between Architecture and
   Nature, Wessex Inst Technol, New Forest, ENGLAND, JUN 14-16, 2006},
Organization = {WIT Transact Ecol \& Environm},
Abstract = {Globalisation in architecture and the highly developed artificial
   technology of the 1950s allowed architects to design buildings without
   responding to the needs of the people in their climates. After the oil
   crisis of the 1970s, architects started referring back to local and
   traditional methods for inspiration to re-establish the relationship
   between form and climate. This paper aims to evaluate whether the
   vernacular architecture was sophisticated enough to offer wise and
   sustainable solutions to the housing needs. Taking Greek vernacular
   architecture as a test case, the study is based on the comparison of two
   architectural types, which were developed at the same time in different
   climates; the Cycladic type and the North-Hellenic Tower type. The white
   cubical houses are generally considered more picturesque and photogenic
   compared with the less well-known North-Hellenic loggia houses. This
   study shows that both types have many qualities and were developed in
   response to local and regional characteristics with the Tower type
   presenting more sophisticated answers. In addition, the paper tries to
   support the study of not only stylish buildings, but also less elegant
   and cosmopolitan houses. It is possible that many sophisticated
   architectural answers are hidden behind the appearance.},
Publisher = {WIT PRESS/COMPUTATIONAL MECHANICS PUBLICATIONS},
