Title = {INTEGRAL ADAPTATION TO CLIMATE CHANGE IN COASTAL ZONES: OPPORTUNITIES
   AND LIMITS - RIOLAGARTOS BIOSPHERE RESERVE, YUCATAN, MEXICO},
