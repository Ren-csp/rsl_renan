@inproceedings{ WOS:000560409700068,
Author = {Muda, Tengku Elmi Azlina Binti Tengku and Adelib, Airissa Hanis Binti},
Editor = {Soriano, E and Sleeter, C and Casanova, MA and Zapata, RM and Cala, VC},
Title = {EMOTIONAL INTELLIGENCE (EI), ADJUSTMENT AND ACADEMIC PERFORMANCE AMONG
   ASASIPINTAR STUDENTS},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON INTERCULTURAL EDUCATION AND
   INTERNATIONAL CONFERENCE ON TRANSCULTURAL HEALTH: THE VALUE OF EDUCATION
   AND HEALTH FOR A GLOBAL, TRANSCULTURAL WORLD (EDUHEM 2018)},
