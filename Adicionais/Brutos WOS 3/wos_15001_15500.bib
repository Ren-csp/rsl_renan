   Pd/Fe Bimetallic Nanoparticles},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND TECHNOLOGY, VOL III: PROCEEDINGS
   OF THE 2011 INTERNATIONAL SYMPOSIUM ON ENVIRONMENTAL SCIENCE AND
   TECHNOLOGY},
Year = {2011},
