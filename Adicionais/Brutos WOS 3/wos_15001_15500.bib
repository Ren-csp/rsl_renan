@inproceedings{ WOS:000589595600018,
Author = {Adefeso, Ismail Babatunde and Ikhu-Omoregbe, Daniel and Isa, Yusuf M.},
Editor = {BaltrenaiteGediene, E and Iticescu, C},
Title = {Assessment of heavy metals in RDF for thermochemical conversion},
Booktitle = {2019 7TH INTERNATIONAL CONFERENCE ON ENVIRONMENT POLLUTION AND
   PREVENTION (ICEPP 2019)},
Series = {E3S Web of Conferences},
Year = {2020},
Volume = {158},
Note = {7th International Conference on Environment Pollution and Prevention
   (ICEPP), Melbourne, AUSTRALIA, DEC 18-20, 2019},
Abstract = {Thermal treatment applications towards production of energy from raw and
   pre-treated municipal solid waste (MSW) are continuously growing context
   in contemporary waste-to-energy technology. The quality of MSW needs an
   improved analysis to enhance her choice of energy exploitation and
   environmental assessment of fly and bottom ashes associated with
   thermochemical conversions. The MSW were collected from municipal solid
   waste disposal facilities (MSWDF) in Cape Town to investigate heavy
   metals distributions in MSW. The MSW were pre-treated to improve the
   quality of MSW. The 7700 Series quadrupole ICP-MS solution method was
   used to determine concentrations and distributions of some heavy metals
   from MSWDF in Cape Town. This study further predicted distributions of
   heavy metals in fly and bottom ashes by a model. The results showed that
   accumulation of high concentrations of heavy metals in bottom ash
   residue could be a good remedy for heavy metals control. The heavy
   metals (especially Pb, Zn and Hg) emissions could be technically
   monitored and controlled from escaping to urban air-sheds atmosphere and
   prevent from their consequential secondary environmental and health
   implication.},
Publisher = {E D P SCIENCES},
Address = {17 AVE DU HOGGAR PARC D ACTIVITES COUTABOEUF BP 112, F-91944 CEDEX A,
   FRANCE},
