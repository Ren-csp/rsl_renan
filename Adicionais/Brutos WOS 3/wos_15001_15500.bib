   Kontoes, Charalampos and Kompatsiaris, Ioannis},
Editor = {Christofi, A and Hadjimitsis, DS and Michaelides, SC and Themistocleous, K and Danezis, C and Kyriakides, N and Papadavid, G and Ambrosia, V and Schwandner, F and Anayiotos, A and Gitas, I},
Title = {Wildfire Event Detection using Social Media and Earth Observation Data -
   A Use case for Attica, Greece},
Booktitle = {ELEVENTH INTERNATIONAL CONFERENCE ON REMOTE SENSING AND GEOINFORMATION
   OF THE ENVIRONMENT, RSCY2025},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13816},
Note = {11th International Conference on Remote Sensing and Geoinformation of
   the Environment-RSCy, Paphos, CYPRUS, MAR 17-19, 2025},
Organization = {ERATOSTHENES Centre of Excellence; Cyprus Remote Sensing Society},
Abstract = {Wildfires increasingly threaten the Attica region in Greece due to
   climate change, prolonged droughts, and rising temperatures. Their
   increasing frequency, intensity, and proximity to urban areas put human
   lives, infrastructure, and biodiversity at risk, leading to serious
   environmental and economic consequences. This underscores the need for
   better detection methods and optimized resource allocation to improve
   real-time fire monitoring. This study investigates the integration of
   social media data with air quality data derived from S-5P TROPOMI
   satellite products for near real-time wildfire detection and monitoring.
   Geotagged social media posts from past wildfire events are correlated
   with sudden spikes in nitrogen dioxide concentrations to evaluate the
   effectiveness of this late fusion approach. The results demonstrate the
   critical role of social media in providing early fire alerts and
   highlight the value of earth observation data in improving detection
   reliability.},
