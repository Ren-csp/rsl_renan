@article{ WOS:000261901800062,
Author = {Kollikkathara, Naushad and Feng, Huan and Stern, Eric},
Title = {A purview of waste management evolution: Special emphasis on USA},
Journal = {WASTE MANAGEMENT},
Year = {2009},
