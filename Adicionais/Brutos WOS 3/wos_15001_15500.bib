@inproceedings{ WOS:000179444800157,
Author = {Chattopadhyay, S},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Residents' satisfaction through menu-driven housing},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1291-1298},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {Residents' satisfaction is an indication of people's response to the
   environment they live in. Here environment refers not only to the
   physical setting, such as dwelling units, housing developments, and
   neighbourhoods, but also to the social and economic dimensions of such
   settings.
   Most of the developing countries like India are passing through a phase
   of rapid urbanisation and, consequently, there is a massive urban
   housing shortage. Government interventions into this aspect have been
   mostly confined to centralised housing supply schemes, but the
   measurement of residents' behavioural. reactions to their environment
   has not yet received its due importance. Residents often express their
   displeasure over the quality of public housing they are provided with.
   This paper addresses the issue of residents' satisfaction in public
   housing and attempts to formulate menu-driven guidelines for future
   public housing schemes.
   The present study dwells on the residents' satisfaction in their housing
   complexes at three different levels: the unit level, the cluster level
   and the neighbourhood level.
   The methodology adopted included Post Occupancy Evaluation through a
   questionnaire survey, field checking and recording. The collected data
   was analysed to indicate occupant's preferences at the above-mentioned
   levels, their likes and dislikes, and problems currently faced.
   In the conclusion of the study, issues touched at the unit level were:
   physical synthesis, materials, anthropometrics, microclimate, and
   identity. Those at the cluster level included common facilities, privacy
   and security, and cluster level identity. At the neighbourhood level, it
   included community facilities, users' views on provisions and preferred
   size of indoor spaces, semi-indoor spaces, shared facilities, preference
   on housing type, features liked best and liked the least in housing,
   preferred distance to work and community facilities, and the
   neighbourhood level identity.},
