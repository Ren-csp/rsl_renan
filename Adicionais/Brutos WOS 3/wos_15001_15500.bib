@article{ WOS:000229244400012,
Author = {Cueva, M and Kuhnley, R and Lanier, A and Dignan, M},
Title = {Using theater to promote cancer education in Alaska},
Journal = {JOURNAL OF CANCER EDUCATION},
Year = {2005},
Volume = {20},
Number = {1},
