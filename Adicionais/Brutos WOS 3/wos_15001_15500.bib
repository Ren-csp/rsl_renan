@inproceedings{ WOS:000288620800001,
Author = {Khalil, C. and Nasir, J.},
Editor = {Popov, V and Brebbia, CA},
Title = {Toxicity of volatile organic compounds (VOCs) mixtures using human
   derived cells},
Booktitle = {ENVIRONMENTAL TOXICOLOGY III},
