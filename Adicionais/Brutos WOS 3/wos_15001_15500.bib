@article{ WOS:000228884800001,
Author = {Flint, CG and Luloff, AE},
Title = {Natural resource-based communities, risk, and disaster: An intersection
   of theories},
Journal = {SOCIETY \& NATURAL RESOURCES},
Year = {2005},
