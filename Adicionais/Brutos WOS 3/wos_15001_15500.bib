Title = {Analysis of Logistic Capacity in Landscape Structural Evolution of Yiwu
   City},
Booktitle = {PROCEEDINGS OF THE 5TH INTERNATIONAL CONFERENCE ON COOPERATION AND
   PROMOTION OF INFORMATION RESOURCES IN SCIENCE AND TECHNOLOGY(COINFO 10)},
