   Urbanism-Take the weigong channel as an example},
Booktitle = {2020 5TH INTERNATIONAL CONFERENCE ON RENEWABLE ENERGY AND ENVIRONMENTAL
   PROTECTION},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
