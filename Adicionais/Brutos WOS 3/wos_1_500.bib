Organization = {Assoc Malaysian Environm Behav Researchers},
Abstract = {This paper is a comparative study of place identity of nighttime urban
   public parks between Shah Alam that was built in 1957 and Putrajaya in
   1999. This study used four research domains that form place identity
   adapted from Relph, 1976 and Cheshmehzangi, 2012. The method of this
   study involves the behavior mapping survey and the questionnaire survey.
   The data were then analysed using Measurable Indicator Scoring Technique
   (Karim, 2008) to ensure constant comparative process by creating
   analytic codes. It is hope that the findings from this study would help
   to improve the place identity and functions of future nighttime urban
   public parks. (C) 2015 The Authors. Published by Elsevier Ltd.},
