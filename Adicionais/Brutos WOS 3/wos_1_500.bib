@inproceedings{ WOS:000390178800157,
Author = {Zhu, Yuefang and Wei, Lan and Wang, Jiabin and Sun, Liang and Xu, Jiayue
   and Shi, Weilin},
Editor = {Kim, YH},
Title = {Research on the Causes and Influencing Factors of Malodor in Suzhou
   Industrial Park},
Booktitle = {PROCEEDINGS OF THE 2016 INTERNATIONAL FORUM ON ENERGY, ENVIRONMENT AND
   SUSTAINABLE DEVELOPMENT (IFEESD)},
Series = {AER-Advances in Engineering Research},
Year = {2016},
Volume = {75},
Pages = {867-873},
Note = {International Forum on Energy, Environment and Sustainable Development
   (IFEESD), Shenzhen, PEOPLES R CHINA, APR 16-17, 2016},
Abstract = {On the basis of paper reading and empirical investigations, this thesis
   searches the types of malodor substances, distribution, and causes.
   Furthermore, the studies of climate and terrain of the area are carried
   out, including the influence rules on malodor from the seasons and
   weather so that the influential factors of malodor spreading are
   analyzed. Finally, the conclusion is reached that the malodor is mainly
   produced by enterprises in spraying industry, electronica processing
   industry, new material processing industry, food processing industry and
   the influential factors of malodor spreading in Suzhou Industrial Park
   are wind direction and speed, air temperature, rainfall, atmospheric
   stability, urban heat island effect, and buildings. The main control
   measures also lie in the control of pollution sources.},
Publisher = {ATLANTIS PRESS},
Address = {29 AVENUE LAVMIERE, PARIS, 75019, FRANCE},
