@inproceedings{ WOS:000467247400074,
Author = {Bortolini, L. and Semenzato, P. and Almasi, B. and Csizmadia, D. and
   Kowalski, P. and Racon-Leja, K. and Aarrevaara, E. and Scherzer, C.},
Editor = {Pennisi, G and Cremonini, L and Orsini, F and Gianquinto, GP},
Title = {Multidisciplinary approaches for programming ecosystem services of urban
   green spaces},
Booktitle = {INTERNATIONAL SYMPOSIUM ON GREENER CITIES FOR MORE EFFICIENT ECOSYSTEM
   SERVICES IN A CLIMATE CHANGING WORLD},
Series = {Acta Horticulturae},
Year = {2018},
