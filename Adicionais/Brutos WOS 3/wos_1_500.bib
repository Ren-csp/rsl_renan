@article{ WOS:A1993MJ97300005,
Author = {GORDON, DLA},
Title = {ARCHITECTURE - HOW NOT TO BUILD A CITY - IMPLEMENTATION AT
   BATTERY-PARK-CITY},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1993},
