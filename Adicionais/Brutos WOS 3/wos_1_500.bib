Author = {Kosmidis, Mary H. and Bozikas, Vasilis P. and GiannakoU, Maria and
   Anezoulaki, Dimitra and Fantie, Bryan D. and Karavatos, Athanasios},
Title = {Impaired emotion perception in schizophrenia: A differential deficit},
