@inproceedings{ WOS:000467120500012,
Author = {Mohsin, Marwah Mahdi and Beach, Thomas and Kwan, Alan},
Editor = {Brebbia, CA and Longhurst, J and Marco, E and Booth, C},
Title = {PUBLIC PERCEPTIONS OF URBAN SUSTAINABLE CHALLENGES IN DEVELOPING
   COUNTRIES},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2018},
