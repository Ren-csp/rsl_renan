Year = {2010},
Pages = {110-114},
Note = {2nd International Conference of Urbanization and Land Resource
   Utilization, Tianjin, PEOPLES R CHINA, OCT 16, 2010},
Organization = {Tianjin Univ Commerce},
Abstract = {Urbanization process can promote economic prosperity and social
   progress, create many benefits for people; at the same time, it also
   produces a series of serious environmental problems, affects the natural
   ecosystem and human health. This paper analyzes stages of urbanization,
   shows adverse effects of urbanization on urban ecological environment,
   puts forward countermeasures used to effectively govern urban ecological
   environment during urbanization process, such as to raise environmental
   awareness amongst the public and strictly manage the urban ecological
   environment, to improve the urban ecological planning, to promote
   cleaner production and develop eco-industry in cities, to strengthen
   incentives for the urban ecological environment protection policy, to
   use land resources thriftily and intensively.},
