Organization = {Assoc Malaysian Environm Behav Researchers},
Abstract = {Geometry plays a dominant role in thermal situations within city
   structures. This study aims to seek how this role affects thermal
   comfort of the visitors in an urban square. Computer simulations were
   performed along with physical measurements in an urban square during
   peak hot conditions of summer in Isfahan, Iran. In addition to the
   influence of built environment inside the square, the results confirmed
   the role of geometry on thermal conditions. The amelioration effect for
   the aspect ratio was higher than that of the orientation. Findings are
   useful for urban design strategies dealing with thermal comfort. (C)
   2015 Published by Elsevier Ltd.},
