@inproceedings{ WOS:000312386000183,
Author = {Cui, Y. P. and Liu, J. Y. and Kuang, W. H. and Wang, J. B.},
Editor = {Yang, Z and Chen, B},
Title = {The Local Climate and Energy Budget Differences between a Typical
   Architectural Complex and a Green Park in Beijing},
Booktitle = {18TH BIENNIAL ISEM CONFERENCE ON ECOLOGICAL MODELLING FOR GLOBAL CHANGE
   AND COUPLED HUMAN AND NATURAL SYSTEM},
Series = {Procedia Environmental Sciences},
Year = {2012},
