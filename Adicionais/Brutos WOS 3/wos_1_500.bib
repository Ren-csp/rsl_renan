@inproceedings{ WOS:000345425000074,
Author = {Nuzir, Fritz Akhmad and Dewancker, Bart Julien},
Editor = {Utama, NA and Mclellan, B and Hamzah, S and Trihartono, A and Suryatmojo, H and Widodo, S and Wijaya, ME and Himmi, SK and Esteban, M and Farzaneh, H and Prilandita, N and Susan, N and Huboyo, H and Nurudin, M and Prihatmaji, Y},
Title = {Understanding the role of education facilities in sustainable urban
   development: A case study of KSRP, Kitakyushu, Japan},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON SUSTAINABLE FUTURE FOR HUMAN SECURITY
   SUSTAIN 2013},
Series = {Procedia Environmental Sciences},
Year = {2014},
