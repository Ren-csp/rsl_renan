@inproceedings{ WOS:000451538100026,
Author = {Beltran-Rodriguez, Maria and Simon, Madlen},
Editor = {Brebbia, CA and Sendra, JJ},
Title = {THE ROLE OF THE PEOPLE'S PARK IN PROMOTING CONVIVIALITY AND QUALITY OF
   LIFE IN INCREASINGLY DIVERSE URBAN NEIGHBOURHOODS},
Booktitle = {SUSTAINABLE CITY XII},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2017},
Volume = {223},
Pages = {297-310},
Note = {12th International Conference on Urban Regeneration and Sustainability
   (Sustainable City), Seville, SPAIN, 2017},
Organization = {Wessex Inst; Univ Seville; Int Journal Sustainable Dev \& Planning; WIT
   Transact Ecol \& Environm},
Abstract = {Particularly in Europe, which has long struggled to accept a
   diversifying population, urban neighbourhoods are increasingly
   heterogeneous. Change is accelerating as the crisis in the Middle East
   drives refugees to European cities. This current diversification has
   tremendous implications for the ways people use urban public places. The
   typology of the people's park is one of the contexts where this will
   play out. The people's park, characterized by an intent to design spaces
   for and with all members of a community, is an everyday space with
   potential to promote social well-being. In this research conviviality is
   understood as a social condition contributing to everyday quality of
   life. In defining conviviality, we have gone beyond the English
   definition, ``to live together and/or dine together,{''} incorporating
   other meanings such as the French, ``ability of a society to promote
   tolerance and mutual exchange of ideas among the people and groups that
   compose it.{''} Our research examines the people's park as an
   institution for fostering convivial behaviour in public life. The
   ultimate goal of this research is to inform urban planning policies
   addressing social life in the public realm, with a focus on
