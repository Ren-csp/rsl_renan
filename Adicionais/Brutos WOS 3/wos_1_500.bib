Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {In this paper, the authors firstly discuss the connotation of landscape
   ecological design, and then analyze main problems of landscape
   ecological design for Chinese urban parks. At the end of the paper,
   several suggestions on the optimization of landscape ecological design
   are provided, including improving landscape ecological system planning,
   giving prominence to landscape ecological design feature, effectively
   using ecological design technology tools and reducing landscape
   ecological construction and maintenance costs. This research aims at
   improving urban ecological environment so as to promote prosperously and
   rapidly urban development.},
