@inproceedings{ WOS:000234955700144,
Author = {Gospodini, A},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Landscape transformations in the postmodern inner city: clustering
   flourishing economic activities and `glocalising' morphologies},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING II, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2005},
Volume = {84},
