@inproceedings{ WOS:000446888700007,
Author = {Nurhakim, I. and Kurniawan, E. B. and Wardhani, D. K.},
Book-Group-Author = {IOP},
Title = {Comparison of place attachment influence on the level of happiness of
   people living near residential parks},
Booktitle = {1ST ITB CENTENNIAL AND 4TH PLANOCOSMO INTERNATIONAL CONFERENCE},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {158},
