Booktitle = {1ST UPI INTERNATIONAL GEOGRAPHY SEMINAR 2017},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {145},
Note = {1st UPI International Geography Seminar (IGEOS), Bandung, INDONESIA, AUG
   08, 2017},
Abstract = {The conceptualization of human-nature relationship in planning theory
   focuses only on political ecology and environmental ethics. This paper
   reviews the scholarly literature on the application of socio-ecological
   resilience in urban spatial planning and how it can reinforce ecological
   consideration in the demand allocation of urban green spaces as an
   alternative approach to the existing ``standard approach{''} which based
   on population number. Based on literature review this paper reveals the
   importance of analyzing the dynamic interaction of socio-ecological
   systems (complex and adaptive) in spatial planning, especially in
   determining demand allocation of urban green spaces, not only able to
   address the challenges of ``think planning again{''} especially in
   understanding the nature's behavior in interacting with humans. This
   paper concludes with a discussion of how this demand might be provided
   and why it need to be optimized with the supply-side of urban green
   spaces.},
