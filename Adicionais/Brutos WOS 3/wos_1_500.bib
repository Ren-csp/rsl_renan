@article{ WOS:000431480900051,
Author = {Baharuddin, Zainul Mukrim and Rusli, Nadia and Ramli, Lukman and Othman,
   Rashidi and Yaman, Maheran},
Title = {The Diversity of Birds and Frogs Species at Perdana Botanical Lake
   Garden, Kuala Lumpur, Malaysia},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {7},
Pages = {6256-6260},
