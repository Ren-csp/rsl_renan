@inproceedings{ WOS:001524094000007,
Author = {Huong Thi Thu Le and Nghia Tuan Le and Kieu Thi Le},
Editor = {Ha, VT and Nguyen, HN and Linke, HJ},
Title = {Suburbanization in Ho Chi Minh City Metropolitan Area in the Context of
   City's Peripheral Industrialization: A Case Study of Thuan Dao
   Industrial Park},
Booktitle = {PROCEEDINGS OF THE 8TH INTERNATIONAL CONFERENCE ON SUSTAINABLE URBAN
   DEVELOPMENT, ICSUD 2022},
Series = {Advances in 21st Century Human Settlements},
Year = {2024},
Pages = {97-115},
Note = {8th International Conference on Sustainable Urban Development-ICSUD, Ho
   Chi Minh City, VIETNAM, OCT 20, 2022},
Organization = {Vietnamese-German University},
Abstract = {In response to their dynamic economic growth, countries in the Global
   South and developing economies have undergone a rapid process of
   peripheral industrialization that causes considerable changes in the
   suburban areas, especially those of the big cities. This so-called
   ``suburbanization{''} process is characterized by a higher population
   mostly due to rural-to-urban migration, a transformation of land use to
   urban functions, changes in housing, increase and diversity of urban
   services and activities, etc. On one hand, this suburbanization
   motivates the speedy development of these areas and creates numerous
   economic opportunities. However, on the other hand, it causes numerous
   issues, especially under poor management in different aspects. Intending
   to reflect on these phenomena in the context of Vietnam's
   industrialization, this paper selects the residential areas located
   along the edge of Thuan Dao Industrial Park in the Ho Chi Minh City
   metropolitan area for a case study. Through literature reviews, mapping,
   observation, and a quick interview, this paper takes advantage of
   primary and secondary data to reveal the diversity in urban structure,
   housing and architecture, socio-economic activities, infrastructure, and
   the inadequacy in living quality caused by several environmental issues.
   Even though this paper's findings provide some perspectives into the
   suburbanization occurring around a single industrial park, they can
   generally contribute as an example of this phenomenon in developing
   countries. Moreover, it can also be a source of reference for the local
   authorities in perceiving the characteristics of suburbanization in the
   city.},
