Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {In this work, population flow, housing prices, the number of shops, shop
   rent and other data in the last three years of Yingze Park and Fen River
   Park in Taiyuan have been surveyed. The growth ranges of all kinds of
   data comparing 2010 with 2009 are obtained; data of Yingze Park were
   1.3\%, 4.4\%, -6.03\% and 5.05\%, while data of Fen river Park were
   4.5\%, 2.3\%, 4.6\% and 5.9\%. The investigation of villages in city
   also reflects that the data around the parks are at a higher level as
   well. Therefore, conclusions have been drawn: the construction of the
   parks not only improves the economic of the nearby area, but also
   contributes to the sustainable development of the city, as well as the
   harmonious development of the city. Finally, in this paper, the problems
   caused by the construction process of parks in city of Taiyuan are
   summarized and feasible suggestions are put forward.},
