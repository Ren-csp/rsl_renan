Title = {Residents' self-perceived health and its relationships with urban
   neighborhood green infrastructure},
Booktitle = {5TH SUSTAINABLE FUTURE FOR HUMAN SECURITY (SUSTAIN 2014)},
Series = {Procedia Environmental Sciences},
Year = {2015},
Volume = {28},
Pages = {433-442},
