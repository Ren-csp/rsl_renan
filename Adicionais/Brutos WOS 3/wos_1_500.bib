@article{ WOS:000173291500027,
Author = {Grimmond, CSB and King, TS and Cropley, FD and Nowak, DJ and Souch, C},
Title = {Local-scale fluxes of carbon dioxide in urban environments:
   methodological challenges and results from Chicago},
