@inproceedings{ WOS:000253967200045,
Author = {Celikyay, Selma and Donmez, Sirin and Ikiz, Emine and Aydin, Pinar and
   Cetinkale, Sevgi Gormus and Kocan, Nurhan},
Editor = {Otesteanu, M and Celikyay, S and Mastorakis, N and Lache, S and Benra, FK},
Title = {A framework on urban design strategies for sustainability of cultural
   and historical heritage in urban landscape},
Booktitle = {ENVIRONMENTAL SCIENCE, ECOSYSTEMS AND DEVELOPMENT},
