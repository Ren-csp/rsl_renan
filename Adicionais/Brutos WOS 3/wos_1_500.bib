Note = {50th ISOCARP Congress, Gdynia, POLAND, SEP 23-26, 2014},
Organization = {ISOCARP},
Abstract = {Well designed parks along waterways promote health and well-being of
   local inhabitants. They may integrate the nature into the life of people
   and bridge the diverse population of city dwellers. Waterfront parks can
   be used to address the issues of social inequality. The design of urban
   parks could benefit from studies that examine the therapeutic qualities
   of nature. The creation of therapeutic landscapes is a relatively new
   landscape design approach that might bring additional benefits if
   employed to urban parks design.},
