@inproceedings{ WOS:000769071200025,
Author = {Al Nahian, M. Jaber and Ghosh, Tapotosh and Uddin, Mohammed Nasir and
   Islam, Md Maynul and Mahmud, Mufti and Kaiser, M. Shamim},
Editor = {Mahmud, M and Vassanelli, S and Kaiser, MS and Zhong, N},
Title = {Towards Artificial Intelligence Driven Emotion Aware Fall Monitoring
   Framework Suitable for Elderly People with Neurological Disorder},
Booktitle = {BRAIN INFORMATICS, BI 2020},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2020},
