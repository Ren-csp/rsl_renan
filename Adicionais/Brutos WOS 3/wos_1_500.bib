Title = {Urban (in) security and assessment of extreme poverty: residents'
   perception referring to homelessness in Bucharest},
Booktitle = {2011 INTERNATIONAL CONFERENCE OF ENVIRONMENT-LANDSCAPE-EUROPEAN IDENTITY},
