Title = {Implementation Of The Urban Forest Canopy Concept In Urban Forest Park
   Design, As An Effort To Rehabilitate Post-Mining Land Of Pt. Bukit Asam,
   Muara Enim, South Sumatera},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON ENERGY, ENVIRONMENTAL AND INFORMATION
