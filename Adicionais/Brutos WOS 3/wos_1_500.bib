@inproceedings{ WOS:001696917300009,
Author = {Garcia, J. A. Gamez and Lazzeri, G. and Tapete, D.},
Editor = {Zhang, Y and Erbertseder, T and Chrysoulakis, N},
Title = {Are we there yet? An assessment of the actual state-of-the-art of
   satellite hyperspectral remote sensing for urban applications},
Booktitle = {REMOTE SENSING TECHNOLOGIES AND APPLICATIONS IN URBAN ENVIRONMENTS X},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13672},
Note = {10th Conference on Remote Sensing Technologies and Applications in Urban
   Environments, Madrid, SPAIN, SEP 17-18, 2025},
Organization = {The International Society for Optics and Photonics},
Abstract = {Hyperspectral remote imaging (HSI) in urban areas has recently garnered
   increasing attention from the scientific community. Key drivers are the
   successful launch and data distribution of a new generation of
   hyperspectral satellites, i.e. PRISMA and EnMAP missions. Enabling the
   capture of detailed spectral information, HSI already proves useful for
   applications in mineral exploration, vegetation analysis, etc. Its
   applicability to urban environments may also be beneficial, as HS can
   discriminate artificial materials that, based on multispectral data,
   often exhibit very similar spectral responses. However, some challenges
   arise, such as the mixture of land covers at small scales and the
   geometric complexity of urban areas, which lead to high intraclass
   variability and difficulties in sample collection. These constraints
   highlight the need for a systematic assessment of the current
   state-of-the-art regarding spaceborne sensors. To conduct this analysis,
   an evidence base was gathered from scientific literature, excluding grey
   literature, namely anything does not peer reviewed. Scopus was used to
   gather 1,081 peer-reviewed articles, reduced to 113 through a screening
   process. Key insights were identified, such as the continued prevalence
   of Machine Learning algorithms for analysis and the limited integration
   of multi-sensor and multisource datasets. Among the many possible
   applications of hyperspectral remote sensing in urban contexts, this
   work found that a novel testing ground for second generation satellite
   products is rising, i.e. classification and analysis of urban
   vegetation. PRISMA and EnMAP's spectral, spatial and temporal resolution
   open new possibilities to multitemporal analysis of urban vegetation
   patterns, allowing investigating and developing novel approaches for the
   measurement and monitoring of urban contexts. In this regard, the paper
   will present a methodological concept and the initial outcome of a
   classification of urban vegetation based on HSI data over the urban test
   site of Rome, a European capital city characterized by wide and
   distributed parks and urban green spaces.},
