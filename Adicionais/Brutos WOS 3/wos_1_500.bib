Title = {From suburb to `glocal' innovation hub: Troisi Park, a potential
   agro-social plaza to intensify the renewal value of the eastern district
   of Naples},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
