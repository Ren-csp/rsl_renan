   SAF},
Title = {Natural lands restoration in an urban ecosystem: A case study in
   Philadelphia's Fairmount Park System},
Booktitle = {PROCEEDINGS OF THE SOCIETY OF AMERICAN FORESTERS, 2001 NATIONAL
   CONVENTION},
Year = {2001},
Pages = {357-361},
Note = {National Convention of the Society-of-American-Foresters, DENVER, CO,
   SEP 13-17, 2001},
Organization = {Soc Amer Foresters},
Abstract = {This preliminary study investigates the reaction of park users to
   natural lands restoration projects in four areas of the Fairmount Park
   System (West River Drive's Belmont Meadow, Concourse Lake, Tacony
   ``Sledding Hill{''}, and FDR Park's Pattison Lagoon). Park users
   recommendations for improving their parks varied. Results showed a
   disparity between perspectives with users at Tacony seeing the area as
   better (65\%), and users at Concourse Lake (67\%) seeing it as worse,
   while most at FDR and West River Drive thought it had gotten better or
   stayed the same. Knowledge of the restoration project was higher (35\%
   and 46\%) in Tacony Park and West River Drive restoration areas where
   there has been some signage compared to the small percentage (less than
   5\%) of the public who know about the restoration at FDR and Concourse
   Lake.},
