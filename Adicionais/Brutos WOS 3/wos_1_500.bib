@inproceedings{ WOS:000385238500016,
Author = {Pampouchidou, Anastasia and Kazantzaki, Eleni and Karatzanis, Ioannis
   and Marias, Kostas and Tsiknakis, Manolis and Meriaudeau, Fabrice and
   Yang, Fan and Simos, Panagiotis},
