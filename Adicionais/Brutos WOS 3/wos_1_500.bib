@inproceedings{ WOS:000444548900012,
Author = {Monteiro, Leonardo Marques and Okamoto Junior, Jun and Peixoto, Erika
   Vanoni and Assis, Julio Sevarolli and Suzuki, Karina Miyuki and
   Prata-Shimomura, Alessandra R.},
Editor = {Filho, WL and Frankenberger, F and Iglecias, P and Mulfarth, RCK},
Title = {Assessment of Outdoor Comfort Conditions Based on the Application of a
   Participative Model in Open Urban Spaces},
Booktitle = {TOWARDS GREEN CAMPUS OPERATIONS: ENERGY, CLIMATE AND SUSTAINABLE
   DEVELOPMENT INITIATIVES AT UNIVERSITIES},
Series = {World Sustainability Series},
