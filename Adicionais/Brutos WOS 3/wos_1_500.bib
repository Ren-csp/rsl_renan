@inproceedings{ WOS:000257236400008,
Author = {Peixoto Neto, A. G. L. and Lima, Jr., O. F. and Tacla, D.},
Editor = {Brebbia, CA},
Title = {Evaluating urban transportation quality: measuring transportation
   activity},
Booktitle = {URBAN TRANSPORT XIII: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
