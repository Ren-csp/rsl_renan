@inproceedings{ WOS:000446248300061,
Author = {Inavonna, I. and Hardiman, G. and Purnomo, A. B.},
Editor = {Rinanti, A and Hadisoebroto, R and Abdullah, AG and Nandiyanto, ABD},
Title = {Outdoor thermal comfort and behaviour in urban area},
Booktitle = {4TH INTERNATIONAL SEMINAR ON SUSTAINABLE URBAN DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {106},
Note = {4th International Seminar on Sustainable Urban Development (ISoSUD),
   Univ Trisakti, Fac Landscape Architecture \& Environm Technol, Jakarta,
   INDONESIA, AUG 09-10, 2017},
Abstract = {Outdoor comfort is important due to the public spaces functions. Open
   spaces provide thermal comfort and a pleasant experience to improve the
   city life quality effectively. The influence of thermal comfort in
   outdoor activities is a complex problem. This paper presents a
   literature review and discussion of aspects of physical, psychology, and
   social behaviour toward outdoor thermal comfort. The valuation is
   determined not only by the ``physical state{''} but also by the ``state
   of mind{''}. The assessment is static and objective (i.e., physical and
   physiological characteristics) that it should be measured. Furthermore,
   an effective model to provide the knowledge of climatic conditions, as
   well as the dynamic and subjective aspects (i.e., psychological and
   social characteristics and behaviour), requires a comprehensive
   interview and observation. The model will be examined to describe the
   behaviour that is a reflection of perception and behaviour toward the
   environment. The adaptation process will constantly evolve so that it
   becomes a continuous cause between human behaviour and the spatial
   setting of the formation, which is eventually known as places and not
   just spaces. This evolutionary process is a civic art form.},
