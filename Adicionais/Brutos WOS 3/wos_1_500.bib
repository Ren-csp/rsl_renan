@inproceedings{ WOS:000361123400041,
Author = {Xue, Wen-Feng and A, Ru-Han},
Book-Group-Author = {Destech Publicat Inc},
Title = {Thinking on the Protection of the Ecological Environment of Grassland
   and Urban Low Carbon Design-Taking Inner Mongolia Area as an Example},
Booktitle = {INTERNATIONAL CONFERENCE ON ENVIRONMENTAL PROTECTION AND HUMAN HEALTH
   (EPHH 2014)},
Year = {2015},
Pages = {241-248},
Note = {International Conference on Environmental Protection and Human Health
   (EPHH), Wuhan, PEOPLES R CHINA, DEC 13-14, 2014},
Abstract = {The Inner Mongolia Autonomous Region is located in the northern frontier
   of China. It is 1183000 square kilometers, covering 12.3\% of whole
   China. Inner Mongolia grassland is the world's most types of grassland
   and one of the most completed grassland, whose landscape is the main
   northern ecosystems and has the effect of the ecological barrier. Before
   Yuan Dynasty Mongolia ancestors believed Shamanism and confirmed the
   concept of life then formed the thought of Heaven and Earth, producing
   the original eco-environmental protection consciousness. Mongolia Empire
   was founded in Yuan Dynasty and people grazed in rotation with seasons.
   The pasture management system was formed in the late Yuan Dynasty. The
   original ecological consciousness of Mongolia gradually became into
   larger ecological concept and the ecological view of the direction of
   evolution. The ecological consciousness of harmonious development
   between human and the nature gradually become the ideology and value
   orientation of Ancient Mongolian customary. But with the development of
   Inner Mongolia, especially the development of new-type urbanization and
   new high buildings, population concentration, Industrial Park, wind and
   thermal power plant construction, the coal mine and metal mineral mining
   and so on, they all damaged the grassland in varying degree. In order to
   prevent many of the Inner Mongolia area industrialization and urban
   economic development threat to grassland ecological environment and
   reduce carbon emissions harmful to the environment, people need to learn
   the grassland protection measures from the Mongolia ancestors. In
   addition, the government needs to strengthen the city low carbon design
   concept, and strengthens grassland environmental protection laws and
   regulations formulation and implementation supervision.},
