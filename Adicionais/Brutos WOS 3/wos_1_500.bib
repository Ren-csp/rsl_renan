@inproceedings{ WOS:000659867302067,
Author = {Dzhumagazieva, Nurjan},
Editor = {Rudoy, D and Olshevskaya, A and Kankhva, V},
Title = {Criteria and aspects of environmental journalism based on the materials
   of Kyrgyz authors' works},
Booktitle = {INNOVATIVE TECHNOLOGIES IN SCIENCE AND EDUCATION (ITSE-2020)},
