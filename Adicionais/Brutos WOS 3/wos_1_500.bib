   Howard, C. and Hobbs, S. J. and Jones, D. T. and Power, S. A. and Rose,
   N. and Ryder, C. and Seed, L. and Stevens, G. and Toumi, R. and
   Voulvoulis, N. and White, P. C. L.},
Title = {Open Air Laboratories (OPAL): A community-driven research programme},
