@article{ WOS:000165108000061,
Author = {Karppinen, A and Joffre, SM and Kukkonen, J},
Title = {The refinement of a meteorological pre-processor for the urban
   environment},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2000},
Volume = {14},
Number = {1-6},
Pages = {565-572},
Note = {5th Workshop on Harmonization within Atmospheric Dispersion Modelling
   for Regulatory Purposes, RHODES, GREECE, MAY 18-AUG 21, 1998},
Organization = {Natl Ctr Sci Res Demokritos},
Abstract = {The meteorological pre-processor used routinely at the Finnish
   Meteorological Institute (FMI) has been modified in order better to
   represent urban conditions. We have reevaluated the roughness length,
   introduced the zero displacement height and divided the surface layer
   into a roughness sub-layer and an inertial sub-layer. The friction
   velocity and Monin-Obukhov length are evaluated using an empirically
   developed, exponential, Reynolds stress profile in the roughness
   sub-layer. The effect of these modifications has been studied by
   computing the dispersion parameters used in the urban dispersion
   modelling system UDM-FMI and comparing the revised parameters with the
   previous model computations.},
