   Aydin, Pinar and Cetinkale, Sevgi Gormus},
Editor = {Markatos, N and Stamou, A and Beltro, J and Panagopoulos, T and Helmis, C and Stamatiou, E and Hatzopoulou, A and Antunes, MDC},
Title = {A Framework on urban design strategies for sustainability of cultural
   and historical dimension in urban landscape},
Booktitle = {EEESD `07: PROCEEDINGS OF THE 3RD IASME/WSEAS INTERNATIONAL CONFERENCE
   ON ENERGY, ENVIRONMENT, ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT},
