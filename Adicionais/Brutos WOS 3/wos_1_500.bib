Organization = {Assoc Malaysian Environm Behav Researchers},
Abstract = {Trees are an essential part of every community in an urban area. The
   trees' canopies and crowns provide comfortable conditions for outdoor
   activities and recreation. This paper presents the simulations of tree
   shades, which is proven to enhance the microclimate of an urban park.
   The results showed that the tree shades sustained the microclimate of
   the park; lower the air temperature control the thermal comfort and
   maintained the wind flow. The implications of the outcomes show
