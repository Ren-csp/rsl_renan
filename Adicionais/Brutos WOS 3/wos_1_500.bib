@inproceedings{ WOS:001264250400013,
Author = {Lima, Luiz Gluck and Zyngier, Camila Marques and Freitas, Christian and
   Mourao Moura, Ana Clara},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti. L},
Title = {Geodesign for Open Spaces Management in Mining-Dependent Urban
   Settlements},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 1, INPUT 2023},
Series = {Lecture Notes in Civil Engineering},
Year = {2024},
Volume = {467},
