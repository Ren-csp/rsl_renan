Title = {The role of on-street urban parking schemes for power two wheels in
   sustainable mobility},
Booktitle = {SUSTAINABLE CITY V: URBAN REGENERATION AND SUSTAINABILITY},
Series = {WIT Transactions on Ecology and the Environment},
