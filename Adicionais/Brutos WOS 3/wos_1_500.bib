@inproceedings{ WOS:000234955700110,
Author = {Genco, T},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Developing a sustainable community - the challenges of new planning
   methodologies in the re-invention of public open space in Canada},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING II, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2005},
Volume = {84},
Pages = {1119-1132},
Note = {2nd International Conference on Sustainable Development and Planning,
   Bologna, ITALY, SEP 12-14, 2005},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {How does one transform a former military base in suburban Toronto into
   Canada's First Nation Urban Park? This paper explores this opportunity
   in the re-invention of this new public space and the impacts it has on
   public planning and policy development for the community, the city and
   the country. The crown corporation responsible, Parc Downsview Park Inc.
   must resolve to do this on a self-financing basis no less!
   Sustainability is therefore fundamental to the planning and development
   to-date and the opportunities for positive fundamental change in the
   future. Following the creation of the park design through an
   international design competition, the park vision was to transform the
   rest of the lands required for the self-financing mandate and process.
   Key to the integration for the rest of the lands and vision was the
   development of sustainable community development guidelines that would
   make the site an integrated and cohesive property, and that would
