Title = {The Influence of Emotion on Time Perception: An ERP Study},
Booktitle = {MBE 2008: ASIA -PACIFIC CONFERENCE ON MIND BRAIN AND EDUCATION},
Year = {2008},
Pages = {196-199},
Note = {Asia-Pacific Conference on Mind Brain and Education, Washington, DC, OCT
   25-27, 2008},
Organization = {Int Soc Mind, Brain \& Educ; SE Univ, Key Lab Child Dev \& Learning Sci;
   Thinktank - Handsbrain Educ; SE Univ State Key Lab Bioelect; Chinese Soc
   Biomed Elect},
Abstract = {This article studied the influence of emotion on time perception and its
   related neural correlates through event-related potential measures and a
   temporal generalization task Short durations were used ranging from 490
   to 910ms, during which participants had to discriminate a previously
   memorized 700ms ``standard{''} duration. Behavioral results showed more
   underestimation for emotional stimuli than for neutral stimuli. The
   magnitude of CNV-Iike potentials which index time perception were
   decreased during emotional versus neutral face conditions. In addition,
   enhanced P160, P240 and decreased N2 were also found for emotional
   states. These findings suggest that temporal processing could be
   modulated by emotion even within 200ms after stimulus onset, and the
   attentional bias for emotion will attenuate the cognitive resources for
   timing, which results in the temporal underestimation for emotional
   faces.},
