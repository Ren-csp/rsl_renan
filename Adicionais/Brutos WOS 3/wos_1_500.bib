@article{ WOS:A1991FP63600014,
Author = {BEINTEMA, AJ},
Title = {MANAGEMENT OF THE DJOUDJ NATIONAL-PARK IN SENEGAL},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1991},
Volume = {20},
Number = {1-3},
Pages = {81-84},
Month = {APR},
Note = {INTERNATIONAL CONF ON THE PEOPLES ROLE IN WETLAND MANAGEMENT, LEIDEN,
   NETHERLANDS, JUN 05-08, 1989},
Abstract = {The Djoudj National Park in Senegal comprises 16 000 ha of seasonal
   wetland in the delta of the Senegal River, and was established in 1971. 
   The park is of prime importance for palaearctic and afrotropical birds. 
   The area belonged to the flood system of the Senegal River, but
   inundations ceased after completion of the embankment of the river in
   the early 1960s. The Djoudj Basin was to be converted into irrigated
   rice fields, but owing to salinification of the soil this idea had to be
   abandoned, and the area was given its present designation.
   Originally the park was managed with little consideration for the people
   living nearby, but since 1987 a new policy has aimed at cooperation with
   the local people.  As natural floodings have been excluded, the park is
   annually inundated through sluices in the embankment. The park has a
   high fish production, and harbours large numbers of piscivorous birds,
   notably the white pelicans.  No fishing has been allowed.  Grazing has
   been excluded, so the park forms a green oasis in the region.  In the
   new plan fish ponds will be created north of the park, near the
   villages, and the park's fish production will maintain the stock.  A
   section of the park will be opened up for limited grazing, for villagers
   only.  Already, the park staff are assisting the villagers with the
   construction of rice fields, and with reafforestation, using the
   National Parks Service's equipment and expertise.  In addition, the
   Service aims at more education of the public, by improving the
   provisions for visitors, establishing an information centre, probably in
   the city of St. Louis, and by starting activities with local schools. 
   The plans and ideas have originated from the present Park's management
   and have the support of the IUCN, and other organizations.  The Research
   Institute for Nature Management in the Netherlands has assisted the park
   managers with the establishment of a new management plan for the park;
   this has been funded by the World Wide Fund for Nature.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Article; Proceedings Paper},
Language = {English},
