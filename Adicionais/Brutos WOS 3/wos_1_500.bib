@article{ WOS:A1996VA92200021,
Author = {Salem, JE and Kring, AM and Kerr, SL},
Title = {More evidence for generalized poor performance in facial emotion
   perception in schizophrenia},
Journal = {JOURNAL OF ABNORMAL PSYCHOLOGY},
Year = {1996},
Volume = {105},
Number = {3},
