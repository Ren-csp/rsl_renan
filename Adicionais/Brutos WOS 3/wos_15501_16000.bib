Author = {Agnihotri, AK},
Editor = {Eliasson, B and Riemer, P and Wokaun, A},
Title = {Mitigation of methane emissions from municipal solid waste-Indian
   perspective},
Booktitle = {GREENHOUSE GAS CONTROL TECHNOLOGIES},
Year = {1999},
Pages = {835-840},
Note = {4th International Conference on Greenhouse Gas Control Technologies
   (GHGT-4), INTERLAKEN, SWITZERLAND, AUG 30-SEP 02, 1998},
Organization = {ABB Corp Res; Int Energy Agency Greenhouse Gas Programme; British Petr;
   ETH; Norsk Hydro; PSI; RITE; SAIC; Saudi Aramco; Shell; Siemens;
   Statoil; Swiss Fed Off Energy; Swiss Re; US DOE},
Abstract = {With increasing population and unprecedented urbanisation in India the
   home of 16\% of World's population but having only 2.42 percent of the
   total world area the menace of Municipal solid waste management is
   posing serious threat of health hazard \& Methane emissions are adding
   up to green house gaseous built up in the environment. Efforts are being
   made by the National Govt. and State Govt. to promote the different
   projects for the utilization of Methane emission in the Urban Municipal
   \& Industrial Sector.
   The proposed case study of one of the prominent Municipal solid waste
   (MSW) dumping site of Motijheel in Lucknow is being presented as a
   typical Urban waste bio reactor landfill with the estimated 20,000
   Normal meter cube (NM3) per day of biogas assuming 58\% Methane gas and
   remaining 42\% Carbondioxide (CO2). Methane capture shall be 8.30 Tons
   per day. Therefore 8.3 Tons of Methane will be saved from emitting to
   the atmosphere, directly. With global warming potential of Methane being
   about 24 times that of Carbon dioxide, the saving of Methane gas
   emission is 8.3x24 =197 approx. Tons of Carbon dioxide equivalent per
   day. By utilizing said volume of Methane approx. 1.8 MW power can be
   produced \& indirectly about 4 Tons of Carbon dioxide which would have
   been otherwise produced had the same quantum of power produced through
   thermal mode.
   Hence net green house gaseous saving, due to said project conies out to
   be about 200 Tons of Carbon Dioxide \& approx. 70,000 Tons of CO2
   Equivally per year.
   Efforts are being made to capture about 1 million m(3) of Methane
   emissions/day emanating through the Municipal solid waste in 5 major
   towns in the U.P. state.},
