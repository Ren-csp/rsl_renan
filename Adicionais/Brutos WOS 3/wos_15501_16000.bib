@inproceedings{ WOS:A1996BJ20B00629,
Author = {Whalen, DH and Sheffert, S},
Editor = {Bunnell, HT and Idsardi, W},
Title = {Perceptual use of vowel and speaker information in breath sounds},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {2494-2497},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Inspiration sounds, being shaped by the vocal tract, are a potential
   source of speech information. Previous work found that both speaker sex
   and coarticulatory information in the breath sound could influence vowel
   perception {[}1]. Speaker sex affected the perception of one /bVd/
   continuum while the coarticulatory information affected a second
   continuum. The present study extends those results by using an /hVd/
   context for the inspiration sound and for the synthetic continuum.
   Breaths were produced before `'heed'', `'hid'', `'head'', `'had'' and
   `'Hud''. Two continua, from /ae/ to /partial derivative/ and from
   /epsilon/ to /I/ Were presented to listeners for forced-choice
   identification. Preliminary results suggested that both vowel
   information and speaker sex affected the perception. Final results
   showed, instead, that the information did not affect perceptual
   boundaries between vowels. Several sources for the lack of an effect
   could exist, including variability in the amount of information in
   particular breath sounds and differences in the amount of ambiguity in
   the continua. Further work is called for.},
Publisher = {I E E E},
Address = {345 E 47TH ST, NEW YORK, NY 10017},
