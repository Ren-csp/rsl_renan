@article{ WOS:A1997XG80300010,
Author = {deJong, W},
Title = {Developing swidden agriculture and the threat of biodiversity loss},
Journal = {AGRICULTURE ECOSYSTEMS \& ENVIRONMENT},
Year = {1997},
