@article{ WOS:000178365300012,
Author = {Szerszynski, B},
Title = {Wild times and domesticated times: the temporalities of environmental
   lifestyles and politics},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2002},
Volume = {61},
Number = {2-4},
