Author = {Oruc, Ipek and Sinnett, Scott and Bischof, Walter F. and Soto-Faraco,
   Salvador and Lock, Karman and Kingstone, Alan},
Title = {The effect of attention on the illusory capture of motion in bimodal
   stimuli},
