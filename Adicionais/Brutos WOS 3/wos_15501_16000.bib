@inproceedings{ WOS:001753451400011,
Author = {Alejandro Munoz, David and Carvajal Escobar, Yesid and Tarapuez Bolanos,
   Diego F.},
Editor = {Mohammad, P and Shahfahad and Matamanda, AR and Rodrigo-Comino, J},
Title = {Design of a Land Use-Land Cover Index Using Fuzzy Logic for Territorial
   Planning in the Andean Basins of Colombia},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 2},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
Pages = {137-151},
Note = {2024 International Conference on Geographic Perspectives on Climate
   Change Mitigation in Urban and Rural Environments-GCUE, Lecce, ITALY,
   JUN 25-27, 2024},
Organization = {University of Salento},
Abstract = {Territorial planning emerges as an essential tool to address
   environmental degradation and to guarantee the comprehensive
   sustainability of ecosystems, considering the preservation of natural
   reserves as a fundamental approach for the conservation of water
   resources in Andean basins and the promotion of sustainable practices in
   Colombia for climate risk. This study was carried out in the
   municipality of Santander de Quilichao, department of Cauca, by
   identifying the land covers using the CORINE (Coordination of
   information on the Environmental) Land Cover (CLC) methodology and the
   MOLUSCE (Modules for Land Use Change Evaluation) to estimate the
   potential for change in land use through specialized program for GIS,
   QGIS. Using these techniques, maps of change in coverage for the period
   from 2018 to 2021 were generated using a territorial transition matrix
   and a prediction model of a possible future scenario for the year 2030.
   The results obtained were used as input for the design of a land use
   coverage index (LUCI) using fuzzy logic. 60 coverage points of the
   Andean Quilichao river basin were classified into three categories:
   high, medium, and low which are the results of LUCI. From these results,
   it is possible to see that the most significant changes in coverage are:
   another transitional crop: medium corresponding to 35\% and mosaic of
   pastures with natural spaces: low with 12\%. This research is pioneering
   in the department of Cauca and is expected to be replicated in Colombia,
   since these types of methodologies, through a land use coverage index
   (LUCI), allowed for the identification of territorial conflicts in areas
   of environmental importance. Therefore, it can provide good references
   for the improvement of the ecological environment in future which is
   necessary for a territorial ecological planning framework. Finally, the
   LUCI values are similar to the coverage prediction for the year 2030.},
