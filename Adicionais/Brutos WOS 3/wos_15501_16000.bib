@inproceedings{ WOS:000073221600038,
Author = {Hernandez, MA and Gonzalez, N},
Editor = {Chilton, J},
Title = {Impact of rising piezometric levels on Greater Buenos Aires due to
   partial changing of water services infrastructure},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {237-242},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {The intensive exploitation, since the beginning of the century, of a
   semiconfined aquifer in Buenos Aires City (Argentina) and its
   surrounding areas has caused large drawdown cones by the coalescence of
   smaller ones. The population of the area is about 11 million
   inhabitants, The climate is subhumid-humid with a mean annual rainfall
   of 1050 mm/year and a surplus of 270 mm/year. Some of the effects caused
   by the intensive exploitation have been saline intrusion and leakage
   from the phreatic aquifer through the aquitard, which caused a fall of
   the water table. As a consequence of the demand increase and closing of
   production wells due to salinization and nitrate content, treated water
   from the La Plata River began to be imported. The recovery of
   piezometric levels has caused the phreatic levels to rise, with a
   serious impact on the urban infrastructure, established some decades
   ago. Based on successive now-nets, on the system parameters T,S,K,K',T'
   and on the value of imported yields, a monitoring system with forecast
   capacity is proposed, as well as an operative model for phenomena
   control, using alternative pumping on both aquifers.},
