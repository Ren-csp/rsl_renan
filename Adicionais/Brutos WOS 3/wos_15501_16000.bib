@article{ WOS:000290599800006,
Author = {Tellinghuisen, Stacy},
Title = {Water for Power Generation: What's the Value?},
Journal = {NATURAL RESOURCES JOURNAL},
Year = {2010},
Volume = {50},
Number = {3},
Pages = {683-720},
Month = {FAL},
Note = {Symposium on the Water-Energy Conundrum - Water Constraints on New
   Energy Development in the Southwest, Univ New Mexico Sch Law,
   Albuquerque, NM, FEB 12, 2010},
Abstract = {In the arid Interior West, water is a valuable, but limited natural
   resource. Yet today, most electric utilities and regulators do not
   adequately integrate water into electric resource planning. In this
   article, we present western utilities' and regulators' current
   strategies for integrating the value of water into electric resource
   planning and outline important policy changes that would improve
   integration. To develop a range of values for use in electric resource
   planning, we present data on the value of water for the three
   constituencies that compete with power plants for limited water
   supplies: municipalities, the agricultural sector, and the environment.
   Across the region, the value of water varies tremendously, depending on
   the location, type of use,, and scarcity of the resource, among other
   factors. As urban populations continue to grow and climate change
   reduces available supplies, the scarcity and value of water will
   undoubtedly increase. When developing and evaluating electric resource
   plans, utilities and regulators should consider the cost of committing
   water to power generation over the lifetime of the power plant.},
