Title = {Analysis of Remanufactue Industry from an Approach of Manufactuer and
   Remanufactuer's Bertrand Game},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {496-500},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {To build and develop sustainable urban agglomeration, developing a
   sustainable economy mode is indispensable. As a typical mode of
   sustainable economy, circular economy attracts more attention from
   academics. And nowadays according to prevalent circular economy
   research, recycling and reproducing end-of-life products has caught more
   attention. Academics always focus on two aspects: firstly, whether such
   economic behavior will be profitable; secondly, what factors will be
   more influential in remanufacturers' profit-decision? By applying to
   game theory, this paper sets and solves a two-stage incomplete
   information Bertrand game between a manufacturer and a remanufacturer,
   and then analyzes three parameters in equilibrium, and concludes: the
   profitability of remanufacturer's recycle and reproduction depends on
   the residual value of end-of-life products and consumers' valuation of
   such products. Following the research conclusion, this paper finds out
   relative factors that influence remanufacturers' profit-decision. This
   paper provides an empirical basis for remanufacturers' decision of
   recycle and reproduction.},
