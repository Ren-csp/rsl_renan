@inproceedings{ WOS:000449456600075,
Author = {Olga, Chis and Monica, Coste},
Editor = {Chis, V and Albulescu, I},
Title = {DEVELOPING SOCIO-EMOTIONAL SKILLS OF CHILDREN. APPLICATIONS IN FORMATIVE
   CONTEXTS},
