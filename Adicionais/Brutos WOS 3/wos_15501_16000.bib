@inproceedings{ WOS:000313845902282,
Author = {Sui, Xinyu and Liang, Xiangru and Hu, Yufu and Shi, Guoqing},
Editor = {Iranpour, R and Zhao, J and Wang, A and Yang, FL and Li, X},
Title = {The Construction of a Cellular Model to Monitor Intracellular Proteasome
   activity},
Booktitle = {ADVANCES IN ENVIRONMENTAL SCIENCE AND ENGINEERING, PTS 1-6},
Series = {Advanced Materials Research},
Year = {2012},
Volume = {518-523},
Pages = {5586-5589},
Note = {1st International Conference on Energy and Environmental Protection
   (ICEEP 2012), Hohhot, PEOPLES R CHINA, JUN 23-24, 2012},
Organization = {Inner Mongolia Univ},
Abstract = {The ubiquitin-proteasome system is one of the cellular targets of some
   environmental chemicals. The impairment of this system is related to a
   lot of disease. In order to monitor intracellular proteasome activity
   after chemical exposure, a degron consisting of a short peptide fused to
   carboxyl-terminus of green fluorescent protein (GFP-CL1), which known to
   be degraded by proteasome, was ultilized. PC-3 cells were transfected
   with pEGFP-C3 and PEGFP-CL1 plasmid, respectively, and then the stable
   cell lines expressing GFP or GFP-CL1 were obtained by G418 selection.
   The cell line expressing GFP-CL1 was confirmed by treatment with the
   proteasome inhibitor MG132 and the fluorescent intensity level of GFP in
   GFP-CL1 cells was examined under fluorescent microscope and microplate
   reader with GFP-C3 cells as a positive control and normal PC-3 cells as
   negative control. It was found that MG 132 treatment obviously elevated
   the level and fluorescent intensity of GFP, but with no obvious change
   before and after the drug treatment for both control groups. In
   conclusion, a cellular model to monitor intracellular proteasome
