Author = {Zhao, Xiaoxi and Zhao, Xiujuan and Liu, Pengfei and Ye, Can and Xue,
   Chaoyang and Zhang, Chenglong and Zhang, Yuanyuan and Liu, Chengtang and
   Liu, Junfeng and Chen, Hui and Chen, Jianmin and Mu, Yujing},
Title = {Pollution levels, composition characteristics and sources of atmospheric
   PM2.5 in a rural area of the North China Plain during winter},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCES},
Year = {2020},
Volume = {95},
Number = {SI},
