Title = {The Implementation of Resource Development and Installation (RDI) for an
   Adolescent with Non-Suicidal Self-Injury (NSSI)},
Booktitle = {PROCEEDINGS OF THE 1ST INTERNATIONAL CONFERENCE ON INTERVENTION AND
   APPLIED PSYCHOLOGY (ICIAP 2017)},
