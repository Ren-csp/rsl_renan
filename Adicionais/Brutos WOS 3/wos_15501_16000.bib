Title = {COMMUNITY MANAGEMENT OF THE WATERFRONT: EXPLORING COMMUNITY SPACE AND
   ACTIVITY FOR ECONOMIC STABILITY IN TOMITSU, AMAKUSA CITY, JAPAN},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
