@inproceedings{ WOS:000780411100006,
Author = {Del Valle, Marc Esteve and Wanless-Berk, Alicia and Gruzd, Anatoliy and
   Mai, Philip},
Book-Group-Author = {ASSOC COMP MACHINERY},
Title = {Unpredictably Trump? Predicting Clicktivist-like Actions on Trump's
   Facebook Posts During the 2016 US Primary Election},
Booktitle = {SMSOCIETY'18: PROCEEDINGS OF THE 9TH INTERNATIONAL CONFERENCE ON SOCIAL
   MEDIA AND SOCIETY},
