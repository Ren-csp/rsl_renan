Title = {Exploring differences between positivistic and postpositivistic
   philosophy: An interpretivistic case study of tourist expectations \&
   satisfaction},
Booktitle = {PORCEEDINGS OF THE 2005 NORTHEASTERN RECREATION RESEARCH SYMPOSIUM},
