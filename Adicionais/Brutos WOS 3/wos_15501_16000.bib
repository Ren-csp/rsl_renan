   and Castagnola, Federico and Bertanza, Giorgio},
Title = {Treatment of waste activated sludge by means of alkaline hydrolysis
   under `mild' conditions},
Journal = {INTERNATIONAL JOURNAL OF GLOBAL WARMING},
