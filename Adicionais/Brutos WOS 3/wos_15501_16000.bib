Volume = {84},
Pages = {18-23},
Note = {3rd World Conference on Psychology, Counselling and Guidance (WCPCG),
   Efes, TURKEY, MAY 09-12, 2012},
Abstract = {The goal of the experiment was to establish pupil size variations while
   viewing and reporting 48 affective IAPS) pictures. The experiment
   consisted of 44 students. Pictures appeared on the screen for 20 secs in
   random order. After reporting the SAM (Self-Assessment Manikin), the
   participants orally reported on the pictures. In the phase of picture
   viewing, the unpleasant pictures revealed larger pupillary responses
   than neutral and pleasant pictures (p<.001). The mean pupil size was at
   its greatest also during the reporting of unpleasant pictures (p<.001).
   Results indicated that the differences in pupil size variations endure
   from the viewing phase to the reporting phase of pictures. (C) 2013 The
   Authors. Published by Elsevier Ltd.},
