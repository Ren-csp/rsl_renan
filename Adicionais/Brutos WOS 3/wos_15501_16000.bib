@article{ WOS:000072195200003,
Author = {Berkes, F and Davidson-Hunt, I and Davidson-Hunt, K},
Title = {Diversity of common property resource use and diversity of social
   interests in the western Indian Himalaya},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
Year = {1998},
