Title = {Complex approach to evaluating the underground hydrosphere stability for
   the urbanized areas in the Angara river basin (East Siberia, Russia)},
Booktitle = {PROSPECTS MINING AND METALLURGY INDUSTRY DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
