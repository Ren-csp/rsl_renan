Title = {Effect of Temperature on Butterfly Community (Lepidoptera) at
   Gunung Meja Recreational Forest Area, Manokwari, Papua Barat},
Booktitle = {INTERNATIONAL CONFERENCE ON SOCIAL SCIENCE AND BIODIVERSITY OF PAPUA AND
   PAPUA NEW GUINEA (ICSBP 2015)},
