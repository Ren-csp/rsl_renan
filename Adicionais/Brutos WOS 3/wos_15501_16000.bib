@inproceedings{ WOS:000237755500090,
Author = {Markantonis, V.},
Editor = {Lekkas, TD},
Title = {The economic evaluation of the irrigation water saving systems
   implementation: The case of ``plastira{''} lake irrigation water},
Booktitle = {Proceeding of the 9th International Conference on Environmental Science
   and Technology Vol B - Poster Presentations},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {B550-B555},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {The water scarcity problem and the increasing economic pressures on
   water resources are causing countries to (re)consider various mechanisms
   to improve water use efficiency and preserve the water resources. This
   is especially true for irrigation agriculture, a major consumer of
   water. Within this framework, the implementation of water saving
   irrigation systems definitely is a way to protect water resources in
   rural areas, but its accomplishment remains a debatable issue. The
   implementation of such kinds of water saving systems depends on their
   efficiency and their investment costs, while they are sensitive to
   physical, social, institutional and political settings.
   The complexity of reforming the irrigation water practices is clearly
   depicted on the case of ``Plastira{''} Lake. Plastira Lake is on of the
   major Greek lakes and provides water to support the irrigation needs of
   an important part of the Thessalian lowland. However, the preservation
   of the Lake's water constitutes a crucial issue, as the water covers the
   household consumption needs of the Karditsa urban area. Moreover,
   ``Plastira{''} Lake is one of the most famous ecotourism places of
   Greece. This paper attempts to suggest a more rational management
   framework of ``Plastira{''} Lake water resources. More specific, the
   main objective of this paper is to explore the efficiency, in terms of
   costs and resource preservation, of the irrigation water saving systems
   in the rural areas irrigated by the water of ``Plastira{''} Lake. Within
   this framework, the quantitative evaluation of the impacts occurred by
   such an investment are examined.
   The present paper maps the theoretical approach of the irrigation water
   sustainable management and the efficiency of irrigation water saving
   systems. Within this framework, the paper evaluates qualitative the
   implementation of water saving systems in those rural areas irrigated by
   ``Plastira{''} Lake. The methodological tool used for the quantitative
   evaluation is the Cost-Benefit Analysis (CBA), concerning those
   parameters, which are countable in terms of monetary values.},
