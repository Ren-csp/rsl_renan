Note = {6th International Headache Seminary Meeting, Stresa, ITALY, MAY 29-30,
   2009},
Abstract = {Medication overuse headache (MOH) is now recognized as a biobehavioral
   disorder, a condition wherein emotion and pain are intermingled. This
   review discusses the steps to consider when treating this condition. The
   first step involves educating patients about MOH and the pathways to
   chronicity. The second step concerns working with patients to identify
   risk factors and behaviors that are present and contributing to the
   condition. The final step involves behavioral intervention. Examples for
   accomplishing each step are provided.},
