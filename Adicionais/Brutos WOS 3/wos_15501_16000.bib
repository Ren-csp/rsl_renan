Title = {Structure Mapping and the Predication of Novel Higher-Order Relations},
Booktitle = {PROCEEDINGS OF THE TWENTY-SIXTH ANNUAL CONFERENCE OF THE COGNITIVE
   SCIENCE SOCIETY},
Year = {2004},
Pages = {333-338},
Note = {26th Annual Conference of the Cognitive-Science-Society, Chicago, IL,
   AUG 04-07, 2004},
Organization = {Cognit Sci Soc},
Abstract = {Relations play a central role in human perception and cognition, but
   little is known about how relational concepts are acquired and
   predicated. For example, how do we come to understand that physical
   force is a higher-order multiplicative relation between mass and
   acceleration? We report an experiment demonstrating that structure
   mapping (a.k.a., analogical mapping) plays a key role in the predication
   of novel higher-order relations. This finding suggests that structure
   mapping-i.e., the appreciation of analogies-may play a pivotal role in
   the acquisition and predication of novel relational concepts.},
