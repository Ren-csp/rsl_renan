@inproceedings{ WOS:000184355600023,
Author = {Khan, MA and Al-Homaid, NA},
Editor = {Alsharhan, AS and Wood, WW and Goudie, AS and Fowler, A and Abdellatif, EM},
Title = {Remote sensing study on mangrove depletion Tarut Bay, Saudi Arabia},
Booktitle = {DESERTIFICATION IN THE THIRD MILLENNIUM},
Year = {2003},
Pages = {227-233},
Note = {Desertification Conference Toward Better Management of Arid and
   Semi-Arid Lands in the 21st Century, DUBAI, U ARAB EMIRATES, FEB 12-16,
   2000},
Organization = {Zayed Prize Fdn},
Abstract = {The development of urban infrastructure, along the east coast of Saudi
   Arabia during the past 30 years, has caused major disturbance to the
   coastal environment. The mangrove stands along the coastline, which
   provide habitat to a wide variety of marine biota, have particularly
   been harmfully impacted by this human activity. Landsat images of
   1973,1987 and 1997 were used to detect mangrove stands along the coast
   of Tarut bay and Tarut island, Saudi Arabia. To study the temporal
   changes in the mangrove stands historical Landsat images were
   geometrically registered and radiometrically corrected. Region masks
   were employed to isolate the unwanted area from the images. Normalized
   Difference Vegetation Indices (NDVI) were computed from the satellite
   images. The analysis of satellite images revealed that the areas of lost
   mangrove stands from 1973-1987 and 1987-1997 were 196.91 hectares and
   63.05 hectares respectively. The total loss of mangrove stands during
   the past 24 years has been 259.96 hectares. The study shows the need to
   protect remaining mangroves and other marine habitats in the area.},
Publisher = {A A BALKEMA PUBLISHERS},
Address = {SCHIPHOLWEG 107C, PO BOX 447, 2316 XC LEIDEN, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
