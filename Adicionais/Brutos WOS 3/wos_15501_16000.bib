@inproceedings{ WOS:000084832400043,
Author = {Liu, JH and Hills, P and Barron, W},
Editor = {Morton, B},
Title = {Cross-border water pollution and sustainability in Hong Kong: The need
   for an integrated approach with China},
Booktitle = {MARINE BIOLOGY OF THE SOUTH CHINA SEA III},
Year = {1998},
Pages = {563-578},
Note = {3rd International Conference on the Marine Biology of the South China
   Sea, HONG KONG, HONG KONG, OCT 28-NOV 01, 1996},
Organization = {Marine Biol Assoc Hong Kong},
Abstract = {Environmental conditions in Hong Kong and, therefore, the territory's
   overall sustainability, are influenced by the cross-border `trade' in
   pollution of various types with neighbouring Guangdong Province and
   beyond. Pollution is evident throughout Hong Kong and Southern China in
   the form of contaminated air, water and land. Our argument is,
   therefore, that Hong Kong's environment is now under threat not just
   from local development but also from rapid urbanization and
   industrialization in Southern China. Hong Kong cannot make significant
   progress in the pursuit of sustainability If it fails to take account of
   developments in adjacent areas of Guangdong Province, particularly
   within the Pearl River Delta. This paper examines the concept of
   cross-border pollution and considers its practical implications for
   environmental management in Hong Kong. It is almost inevitable that
   future environmental quality in Hong Kong will be affected strongly by
   policy and activities in Guangdong Province. Sustainability in Hong Kong
   cannot be achieved without better environmental co-operation with China.},
