@inproceedings{ WOS:000262362000014,
Author = {Gao, Zhiqiang and Cao, Xiaoming and Chen, Maosi and Gao, Wei},
Editor = {Gao, W and Wang, H},
Title = {The Comparing Study of Net Primary Production in China},
Booktitle = {REMOTE SENSING AND MODELING OF ECOSYSTEMS FOR SUSTAINABILITY V},
Series = {Proceedings of SPIE},
Year = {2008},
Volume = {7083},
Note = {Conference on Remote Sensing and Modeling of Ecosystems for
   Sustainability, San Diego, CA, AUG 13, 2008},
Organization = {SPIE; USDA UV-B Monitor \& Res Program \& Ctr Remote Sensing \& Modeling
   Agr Sustainabil; Colorado State Univ, Nat Resource Eco Lab; Inst Water
   Resources \& Hydropower Res, Water Resources Dept China; Minist Educ E
   China Normal Univ, Key Lab Geo Informat Sci; Int Ctr Desert Aff - Res
   Sustainable Dev Arid \& Semi Arid Lands},
Abstract = {Spatial and temporal distribution of vegetation net primary production
   (NPP) in China was studied using three light-use efficiency models
   (CASA, GLOPEM and GEOLUE) and two mechanistic ecological process models
   (CEVSA, GEOPRO). Based on spatial and temporal analysis (e.g. monthly,
   seasonally and annually) of simulated results from ecological process
   mechanism models of CASA, GLOPEM, and CEVSA, the following conclusions
   could be made: (1) during the last 20 years, NPP change in China is
   followed closely by the seasonal change of climate affected by the
   monsoon with an overall trend of increasing. (2) Average annual NPP in
   China wits 2.864 +/- 1GtC. All five models were able to simulate spatial
   features of biomass for different ecological types in China. This paper
   provides a baseline for China's total biomass production. It also offers
   a means of estimating the NPP change due to afforestation,
   reforestation, conservation and other human activities and could aid
   people in using for-mentioned carbon sinks to fulfill China's commitment
   of reducing greenhouse gases.},
