@inproceedings{ WOS:000839494500033,
Author = {Schmid, Peter and Maier, Thomas},
Editor = {Kalra, J and Lightner, NJ and Taiar, R},
Title = {Electro-Tactile Feedback to Provide Assistance to Touchscreen
   Interaction of the Elderly},
Booktitle = {ADVANCES IN HUMAN FACTORS AND ERGONOMICS IN HEALTHCARE AND MEDICAL
   DEVICES (AHFE 2021)},
Series = {Lecture Notes in Networks and Systems},
Year = {2021},
Volume = {263},
Pages = {271-278},
Note = {AHFE Virtual Conference on Human Factors and Ergonomics in Healthcare
   and Medical Devices, ELECTR NETWORK, JUL 25-29, 2021},
Abstract = {Because of their direct manipulation possibility, touch displays offer a
   wide range of interaction possibilities for consumer and investment
   goods. In touch screen interaction, the feedback is usually only
   audiovisual. So the human auditory perception channel can be overloaded
   in stressful situations. This study therefore investigates the relief
   potential of the audiovisual perception channel through tactile
   feedback. For this purpose, a slider with a tactile scale was
   implemented on an electro-tactile touch screen. Within the framework of
   a test person study different scale distances and feedback intensity
   patterns were investigated in order to identify perception thresholds
   for an exact adjustment of a defined scale value. It could be
   demonstrated that the electro-tactile feedback is suitable for young and
   older people. Furthermore, the interaction of intensity and detent
   spacing influences the adjustment accuracy.},
