@article{ WOS:A1995RN30800012,
Author = {ROSENTHAL, SL and BIRO, FM and COHEN, SS and SUCCOP, PA and STANBERRY,
   LR},
Title = {STRATEGIES FOR COPING WITH SEXUALLY-TRANSMITTED DISEASES BY ADOLESCENT
   FEMALES},
Journal = {ADOLESCENCE},
Year = {1995},
