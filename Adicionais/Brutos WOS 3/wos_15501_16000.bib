@inproceedings{ WOS:000315429500025,
Author = {Feng Dexiang},
Editor = {Zhang, YL},
Title = {An Empirical Research on the Conflict and Harmony between Regional
   Economy and Ecological Environment - A Case Study of Rizhao, Shandong},
Booktitle = {PROCEEDINGS OF THE 8TH EURO-ASIA CONFERENCE ON ENVIRONMENT AND CSR:
   TOURISM, MICE, HOSPITALITY MANAGEMENT AND EDUCATION SESSION, PT II},
Year = {2012},
Pages = {154-159},
