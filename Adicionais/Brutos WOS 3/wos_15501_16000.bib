@inproceedings{ WOS:000618346600013,
Author = {Ayman, M. Z.},
Editor = {Brebbia, CA and Zubir, SS and Hassan, AS},
Title = {Towards sustainable development and self-sufficient communities in the
   rural areas of Egypt},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING VIII},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2017},
