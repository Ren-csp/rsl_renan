@article{ WOS:000227545100002,
Author = {Weger, H Jr},
Title = {Disconfirming communication and self-verification in marriage:
   Associations among the demand/withdraw interaction pattern, feeling
   understood, and marital satisfaction},
Journal = {JOURNAL OF SOCIAL AND PERSONAL RELATIONSHIPS},
Year = {2005},
