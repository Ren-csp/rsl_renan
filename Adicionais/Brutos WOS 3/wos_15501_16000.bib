@article{ WOS:A1994PY03200001,
Author = {MACAN, TH and AVEDON, MJ and PAESE, M and SMITH, DE},
Title = {THE EFFECTS OF APPLICANTS REACTIONS TO COGNITIVE-ABILITY TESTS AND AN
   ASSESSMENT-CENTER},
