Month = {APR},
Note = {INTERNATIONAL CONF ON THE PEOPLES ROLE IN WETLAND MANAGEMENT, LEIDEN,
   NETHERLANDS, JUN 05-08, 1989},
Abstract = {Effective wetland management requires on the one hand supralocal
   (regional) planning, and on the other hand a full participation of local
   communities in the design and implementation of management measures.  In
   order to bridge this gap, an intensive process of consultation among
   local populations is necessary at all phases of project preparation and
   implementation, and the project modified to take fullest possible
   account of their concerns.  Development assistance agencies can further
   such people's participation in wetland management by pursuing a more
   gradual community-based project development process.  This will require
   changes in the current operating procedures of most aid agencies and a
   longer term commitment to individual projects.},
