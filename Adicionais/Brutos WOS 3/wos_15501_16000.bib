@article{ WOS:000403973600172,
Author = {Indirawati, Sri Malem and Pandia, Setiaty and Mawengkang, Herman and
   Hasan, Wirsal},
Title = {Inverse Distance Weighted Method and Environmental Health Risks of
   Plumbum Pollution in Drinking Water in Belawan Coastal Area},
