@inproceedings{ WOS:000075208500066,
Author = {Schwartz, C and Morel, JL},
Book-Group-Author = {RES CTR KARLSRUHE},
Title = {Row can agricultural practices improve phytoremediation of soils
   contaminated by heavy metals?},
Booktitle = {CONTAMINATED SOIL `98, VOLS 1 AND 2},
Year = {1998},
Pages = {609-617},
Note = {6th International FZK/TNO Conference on Contaminated Soil (ConSoil 98),
   EDINBURGH, SCOTLAND, MAY 17-21, 1998},
Organization = {Forschungszentrum Karlsruhe, Tech \& Umwelt; Netherlands Org Appl Sci
   Res; Scottish Enterprise, UK},
Abstract = {A consequence of human activities is that trace elements released from
   anthropogenic sources have entered the environment and may alter the
   functioning of ecosystems and threat human health. On the other hand,
   research is revealing that hyperaccumulators of metals are a specialised
   class of plants able to take up and tolerate very large amounts of heavy
   metals in their shoots. Growth of hyperaccumulating plants on polluted
   soils, i.e. phytoremediation, seems to be a useful biological tool for
   remediating metal contaminated sites. This study was undertaken to
   determine whether the efficiency of phytoextraction could be enhanced
   through agronomic practices like fertilization. Trials were performed in
   pot experiments on an industrial soil and on an agricultural soil
   artificially polluted with Cd/Zn. A field experiment on agricultural
   soil was conducted to assess the impact on hyperaccumulation of
   different N fertility rates due to added urban sludge. Shoot dry matter
   production and leaf tissue heavy metal content of the hyperaccumulator
   Thlaspi caerulescens were determined. The evolution of total metal
   content and the mobility of remaining metals were followed with chemical
   extractions. Results were obtained in basic knowledge on the agronomy of
   hyperaccumulators and especially the role of N and P fertilization on
   metal availability and uptake. On a practical point of view, nutritional
   conditions confering the most favorable conditions for metal uptake were
   determined. Phytoremediation reduced the risk, extracting a high amount
   of the mobile metal in the soil. The methods used in the investigation
   may easily be adapted to a large number of hyperaccumulating plants and
   contaminated sites. The results provide substantial help in adapting
   phytoremediation at different soil fertility conditions. They lead to
   conclusions about the possible success and improvment of this treatment
   and the estimation of time required to obtain a satisfactory metal
   concentration in soil.},
Publisher = {THOMAS TELFORD SERVICES LTD},
Address = {THOMAS TELFORD HOUSE, 1 HERON QUAY, LONDON E14 4JD, ENGLAND},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Schwartz, C (Corresponding Author), INRA, ENSAIA, Lab Soil \& Environm Sci, 2 Ave Foret Haye,BP 172, F-54505 Vandoeuvre Nancy, France.
   INRA, ENSAIA, Lab Soil \& Environm Sci, F-54505 Vandoeuvre Nancy, France.},
ISBN = {0-7277-2675-7},
Keywords = {bioremediation; contaminated soil; heavy metals; cadmium; zinc; plants;
