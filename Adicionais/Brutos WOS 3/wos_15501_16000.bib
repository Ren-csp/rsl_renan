@inproceedings{ WOS:000078443800171,
Author = {Leine, M},
Book-Group-Author = {ISRSE
   ISRSE},
Title = {Multitemporal analysis of tree cover changes on a southern Swedish
   raised peat bog},
Booktitle = {27TH INTERNATIONAL SYMPOSIUM ON REMOTE SENSING OF ENVIRONMENT,
   PROCEEDINGS: INFORMATION FOR SUSTAINABILITY},
Year = {1998},
Pages = {692-697},
Note = {27th International Symposium on Remote Sensing of Environment, TROMSO,
   NORWAY, JUN 08-12, 1998},
Organization = {Norsk Romsenter (Norwegian Space Ctr); Miljoverndepartementet; CIESIN;
   USGS; NASA; NOAA; UNEP; ESA; EUMETSAT; Kongsberg Spacetec AS; Space
   Applicat Inst; Joint Res Ctr European commiss; Tromso Satellite Stn AS;
   Space Imaging EOSAT; Norwegian Minist Environm},
Abstract = {There are indications that Swedish raised bogs have in recent time on a
   regional scale reacted to increased urban activity and environmental
   degradation with increased tendencies towards tree migration and other
   changes in structural composition. This paper presents a remote sensing
   approach for detection and quantification of tree growth changes, using
   old digitised panchromatic aerial photographs and standard remote
   sensing techniques. There are two reasons for the use of panchromatic
   aerial photographs. The first is the relatively long time span of
   available image data. The second is that digitised panchromatic aerial
   photographs are easily comparable to next generation high-resolution
   satellite imagery in both spatial and spectral resolution. Three aerial
   photographs covering the extent of one selected peat bog were chosen to
   give as large time span as possible with a minimum difference in
   acquisition parameters. The three panchromatic photographs were
   digitised, ortho-rectified, co-registered, and radiometrically
   normalised to create a multitemporal image. Multitemporal classification
   and post-classification differencing were performed to extract tree
   cover changes from the multitemporal image. Both change detection
   methods performed with acceptable accuracy in quantifying tree cover in
   the individual images. Multitemporal classification surpassed post
   classification differencing in the temporal analysis.},
