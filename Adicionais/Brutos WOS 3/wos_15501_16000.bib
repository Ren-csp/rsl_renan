@article{ WOS:000185829200007,
Author = {Boucouvala, D and Bornstein, R and Wilkinson, J and Miller, D},
Title = {MM5 simulations of a SCOS97-NARSTO episode},
Journal = {ATMOSPHERIC ENVIRONMENT},
