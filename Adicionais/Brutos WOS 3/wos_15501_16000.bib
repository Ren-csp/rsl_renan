@inproceedings{ WOS:000075224700067,
Author = {Jenkins, SA and Inman, DL},
Editor = {Magoon, OT and Converse, H and Baird, B and MillerHenson, M},
Title = {A coastal monitor/forecast system},
Booktitle = {CALIFORNIA AND THE WORLD OCEAN `97 - TAKING A LOOK AT CALIFORNIA'S OCEAN
   RESOURCES: AN AGENDA FOR THE FUTURE, VOLS 1 AND 2, CONFERENCE
   PROCEEDINGS},
Year = {1998},
Pages = {491-502},
Note = {California and the World Ocean 97 Conference on Taking a Look at
   Californias Ocean Resources - An Agenda for the Future, SAN DIEGO, CA,
   MAR 24-27, 1997},
Abstract = {The technology necessary for monitoring and forecasting civilian needs
   in the coastal environments of the world is now available and the design
   of a completely general, multipurpose monitor/forecast system for the
   coastal zone is a valid objective for the next decade. Proper management
   and maintenance of the waters of the coastal zone is essential to the
   health of the economy of coastal nations and states. Recreation,
   fishing, shipping, oil and mineral extraction, and military use each
   represent multibillion dollar industries to the United States, providing
   many thousands of jobs as well as attracting millions of visitors and
   billions of dollars in investments and expenditures. Protection of this
   vital asset will not only protect the existing industries,
   infrastructure and economy, but will also contribute to the
   establishment and growth of new industries, jobs, and to the
   revitalization of coastal economies.
   The continual growth in world economies and population will place
   additional stresses on the coastal environment. High production farming
   and urban runoff from rapidly growing cities with aging infrastructure
   are releasing large amounts of particle effluents into the nearshore
   that combine with;ocean disposal of treated sewage. These practices add
   further stress on the nearshore oceans as population increases.
   Recently, the National. Research Council has identified the following
   issues (in approximate order of descending importance) as posing
   significant threats to the integrity of the Stale of California and the
   U. S. coastal ecosystems: (1) eutrophication; (2) habitat modification;
   (3) hydrologic and hydrodynamic disruption; (4) exploitation of
   resources; (5) toxic effects; (6) introduction of non-indigenous
   species; (7) global climate change and variability; (8) shoreline
   erosion and hazardous storms; and, (9) pathogens and toxins affecting
   human health. Problems associated with changes in the quantity and
   quality of inputs to coastal environments from runoff and atmospheric
   deposition are particularly important. A conceptual system architecture
   is outlined to address the need for continual monitoring and forecasting
   of these problems based upon existing sensor and modeling capabilities.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
