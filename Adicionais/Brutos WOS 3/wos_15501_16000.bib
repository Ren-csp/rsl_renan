@article{ WOS:000240784900012,
Author = {Petrakakis, Maximos J. and Kelessis, Apostolos G. and Flocas, Helena A.
   and Zoumakis, Nicholas M. and Helmis, Costas G. and Tsougas, Mathaios A.},
Title = {Meteorological conditions during air pollution episodes in Thessaloniki,
   Greece},
Journal = {FRESENIUS ENVIRONMENTAL BULLETIN},
Year = {2006},
