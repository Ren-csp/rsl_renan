@article{ WOS:000233881000004,
Author = {Hammer, MR},
Title = {The Intercultural Conflict Style Inventory: A conceptual framework and
   measure of intercultural conflict resolution approaches},
Journal = {INTERNATIONAL JOURNAL OF INTERCULTURAL RELATIONS},
Year = {2005},
Volume = {29},
Number = {6, SI},
Pages = {675-695},
