@inproceedings{ WOS:A1996BH48D00009,
Author = {Oberdorster, G},
Editor = {Marijnissen, JCM and Gradon, L},
Title = {Effects of ultrafine particles in the lung and potential relevance to
   environmental particles},
Booktitle = {AEROSOL INHALATION: RECENT RESEARCH FRONTIERS},
Year = {1996},
Pages = {165-173},
Note = {International Workshop on Aerosol Inhalation, Lung Transport, Deposition
   and the Relation to the Environment - Recent Research Frontiers, WARSAW,
   POLAND, SEP 14-16, 1995},
Organization = {Warsaw Univ Technol; Delft Univ Technol; Gesell Aerosolforsch; TSI
   Incorp; Astra Draco AB},
Abstract = {A number of epidemiological studies has been published over the past 5
   years which reported an association between low ambient particle
   concentration (< 100 mu g/m(3)) and acute morbidity and even mortality
   in the elderly. Since larger particles above similar to 0.3 mu m cannot
   explain such dramatic effects we hypothesize that ultrafine particles (<
   50 nm) present in the urban atmosphere at high number concentrations may
   be causally involved. We have evaluated this hypothesis by using model
   ultrafine particles of Teflon(R) fume with diameters of 10-26 nm. These
   particles when inhaled by rats proved to be extremely toxic, leading to
   severe hemorrhagic pulmonary edema and even death at short-exposure
   durations (10-30 minutes) and particle number concentration of 1-5x10(5)
   particles/cm(3). The respective calculated mass concentrations are in
   the range of 30-60 mu g/m(3). We conclude that certain ultrafine
   particles when inhaled as singlet particles can be highly toxic and that
   there is a need to study more closely environmentally occurring
   ultrafine particles.},
