   Mintz, M and Roth, F and Rutishauser, U and Wassermann, K and Whatley,
   AM and Wittmann, A and Wyss, R and Verschure, PFMJ},
Title = {Design for a brain revisited: The neuromorphic design and functionality
   of the interactive space `Ada'},
Journal = {REVIEWS IN THE NEUROSCIENCES},
Year = {2003},
Volume = {14},
Number = {1-2},
Pages = {145-180},
Note = {Workshop on Neural and Artificial Computation, ZURICH, SWITZERLAND, FEB
   25-27, 2002},
Organization = {European Network Neuoinformat},
Abstract = {While much is now known about the operation and organisation of the
   brain at the neuronal and microcircuit level, we are still some way from
   understanding it as a complete system from the lowest to the highest
   levels of description. One way to gain such an integrative understanding
   of neural systems is to construct them. We have built the largest
   neuromorphic system yet known, an interactive space called `Ada' that is
   able to interact with many people simultaneously using a wide variety of
   sensory and behavioural modalities. `She' received 553,700 visitors over
   5 months during the Swiss Expo.02 in 2002. In this paper we present the
   broad motivations, design and technologies behind Ada, and discuss the
   construction and analysis of the system.},
