@inproceedings{ WOS:000189458900004,
Author = {Wilson, MJ},
Editor = {Mitchell, DJ and Searle, DE},
Title = {Weathering of rocks by lichens with special reference to stonework: A
   review},
Booktitle = {STONE DETERIORATION IN POLLUTED URBAN ENVIRONMENTS},
Series = {LAND RECONSTRUCTION AND MANAGEMENT SERIES},
Year = {2004},
Volume = {3},
Pages = {51-60},
Note = {Stone-Weathering-and-Atmospheric-Pollution-Network Conference, Univ
   Wolverhampton, Wolverhampton, ENGLAND, MAY 09-12, 1999},
Organization = {Univ Wolverhampton, Sch Appl Sci; Univ Wolverhampton, Sch Engn; Univ
   Wolverhampton, Built Environm},
Abstract = {The evidence that rock-colonising lichens are able to weather their
   mineral substrates is reviewed. This evidence consists of the finding of
   etch markings on the surfaces of the silicate minerals, as well as the
   occurrence of rock pitting and thin alteration profiles directly beneath
   the lichen thalli. In addition, the finding of alteration products such
   as siliceous relicts and precipitated poorly ordered hydrous iron oxide
   minerals and aluminosilicate gels in association with lichenised rocks
   all suggest that the organism is able to play an active weathering role.
   Recent evidence suggests that lichens are able to remove potassium from
   micaceous minerals thereby leading to the formation of an expansible
   vermiculitic product. The lichen rock interface is often characterised
   by an accumulation of oxalates, usually calcium oxalate, but other
   oxalate mineral may be found where the substrate is dominated by a
   cation other than calcium. This observation suggests that the excretion
   of oxalic acid by the mycobiont may play an important role in the
   weathering ability of lichens although the participation of other
   organic acids in this process is by no means excluded. Recent reports
   suggest that lichens are able to weather monumental stonework relatively
   quickly and by the same mechanisms as for natural rock outcrops.
   Nevertheless, there are persistent reports that lichens, at least in
   some instances, may act as a protective influence against the
   depredations of atmospheric weathering of stone monuments. This is
   certainly possible as not all lichens are able to excrete
   metal-complexing organic acids. Even where lichens are able to excrete
   oxalic acid there is evidence that the formation of an oxalate patina on
   an ancient monument, the so-called scialbatura, may serve to protect it
   from the degrading effects of a polluted urban environment.},
