@inproceedings{ WOS:000167856700008,
Author = {Csorba, P},
Editor = {Mander, U and Jongman, RHG},
Title = {The transformation of landscape ecological structure following the land
   privatisation in Hungary since 1989},
Booktitle = {CONSEQUENCES OF LAND USE CHANGES},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2000},
Volume = {5},
Pages = {185-198},
Note = {Symposium on Ecological and Socio-Economic Consequences of Land Use
   Changes, FLORENCE, ITALY, JUL 19-25, 1998},
Organization = {Wessex Inst Technol},
Abstract = {The portion of privately owned lands in Hungary has increased from 2\%
   to 56\% since the political and social changes in 1989. Land ownership
   by the cooperative farms has undergone a significant transformation and
   today they cultivate 26\% of the arable land. Only 18\% of the land has
   remained the property of the state.
   This significant change in proprietorship has considerably modified the
   landscape ecological structure of Hungary. However, the character of
   transformation has varied according to the dominant type of land use of
   a given area. For example, large tillage has been repressed on the
   arable lands of the Great Hungarian Plain. The amount of land in the
   private sector was notable in the Tokaj wine-region even before the
   changes. Of the forests in the wooded range of mountains and hills, 65\%
   is still in the hands of the state. The use of ecological corridors has
   changed due to nature conservation motives. The free market price of
   land surrounding urban settlements determines the land use to a greater
   extent now than earlier.
   In the first section, this paper introduces the general tendencies that
   characterise the whole country. This is followed by a description of
   landscape ecological changes which have occurred in the most
   characteristic types of landscape. In addition to the changes in
   landscape structure, attention is also given to the consequences of
   other changes that affected the ecological features of the typified
   landscapes. Some of the phenomena can be explained hy socioeconomic
   reasons. For example, a significant part of the privatised land is
   cultivated by people who were forced to the agricultural sector as a
   result of industrial unemployment. The use of fertilisers, chemicals and
   irrigation has declined due to the owners' lack of capital. The
   privatised woods are in great ecological danger; there are too many
   abandoned fields, and the recreational demands are in constant conflict
   with protection of the wet ecotopes along the lakes and rivers.
   The effects of joining the European Union increasingly influence the
   structure of land use and the landscape as well. According to
   preliminary calculations, at least 25\% of the arable land will change
   land use type - from intensive plough to pasture or wood, or from
   meadows to extensive pasture or wood production - which constitutes 2
   million hectares in Hungary.},
