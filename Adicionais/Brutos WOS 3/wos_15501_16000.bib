@article{ WOS:A1995QL69600011,
Author = {PAOLETTI, MG},
Title = {BIODIVERSITY, TRADITIONAL LANDSCAPES AND AGROECOSYSTEM MANAGEMENT},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1995},
