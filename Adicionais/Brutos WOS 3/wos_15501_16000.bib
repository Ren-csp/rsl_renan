@article{ WOS:000227995600018,
Author = {Rösler, A and Ulrich, C and Billino, J and Sterzer, P and Weidauer, S
   and Bernhardt, T and Steinmetz, H and Fröhich, L and Kleinschmidt, A},
Title = {Effects of arousing emotional scenes on the distribution of visuospatial
   attention: changes with aging and early subcortical vascular dementia},
Journal = {JOURNAL OF THE NEUROLOGICAL SCIENCES},
Year = {2005},
Volume = {229},
Number = {SI},
Pages = {109-116},
Month = {MAR 15},
Note = {3rd International Congress on Vascular Dementia, Prague, CZECH REPUBLIC,
   OCT 23-26, 2003},
Abstract = {Background: The modulation of attention by emotionally arousing stimuli
   is highly important for each individual's social function. Disturbances
   of emotional processing are a supportive feature for the diagnosis of
   subcortical vascular dementia (SVD). We address here whether these
   disturbances might be useful as an early disease marker.
   Methods: In order to examine the modulation of visual attention by
   emotionally arousing stimuli of different valence, 12 elderly patients
   with early SVD, 12 age-comparable healthy adults and 12 young healthy
   subjects were studied while looking at pairs of pictures from the
   International Affective Picture Battery that were either
   neutral-neutral, neutral-positive or neutral-negative in terms of
   emotional content. Eye movements were recorded with an infrared
   eye-tracking system. The direction of the first saccade and the dwell
   time during the 10 s of presentation were measured and compared among
   groups with parametric tests.
   Results: All subjects showed a modulation of initial attentional
   orienting as well as a higher percentage of dwell time towards the
   pictures containing emotional material. Patients with SVD and old
   controls did not differ in either experimental measure. Young patients
   showed a stronger bias towards emotionally negative material than both
   groups of older individuals.
   Conclusions: Modulation of visuospatial attention is preserved in early
   SVD. This might have implications for therapeutic interventional
   approaches. A weakened sustained attention towards negative but not
   positive emotional pictures in the elderly is in accordance with the
   socioemotional selectivity theory, describing a relative selection of
   positive stimuli with aging. (c) 2004 Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Rösler, A (Corresponding Author), Univ Hamburg, Wissensch Einrichtung, Zentrum Geriatrie \& Gerontol, Sellhopsweg 18-22, D-22459 Hamburg, Germany.
   Goethe Univ Frankfurt, Dept Neurol, D-6000 Frankfurt, Germany.
   Goethe Univ Frankfurt, Inst Neuroradiol, D-6000 Frankfurt, Germany.
   Inst Mental Hlth, Mannheim, Germany.},
DOI = {10.1016/j.jns.2004.11.007},
ISSN = {0022-510X},
EISSN = {1878-5883},
Keywords = {dementia; visuospatial attention; emotion; arousal; aging; eye tracking},
Keywords-Plus = {PROBABLE ALZHEIMERS-DISEASE; PREVENTION; DIAGNOSIS; CURIOSITY; DEFICITS;
