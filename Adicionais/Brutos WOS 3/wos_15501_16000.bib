@inproceedings{ WOS:001696917300003,
Author = {Yan, Bo and Chen, Hao and Zeng, Dandan and Li, Shuaihui},
Editor = {Zhang, Y and Erbertseder, T and Chrysoulakis, N},
Title = {MFB-YOLO: A High-Precision Algorithm for Moving Fluid Boundary Gas Cloud
   Detection},
Booktitle = {REMOTE SENSING TECHNOLOGIES AND APPLICATIONS IN URBAN ENVIRONMENTS X},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13672},
Note = {10th Conference on Remote Sensing Technologies and Applications in Urban
   Environments, Madrid, SPAIN, SEP 17-18, 2025},
Organization = {The International Society for Optics and Photonics},
Abstract = {To address the challenges in infrared remote sensing for gas leakage
   detection in complex industrial environments-such as irregular gas cloud
   shapes, unstable boundaries, difficulties in achieving high-precision
   detection, and high false alarm rates caused by multi-source
   interferences (e.g., personnel and vehicles) in gas cloud recognition
   within infrared images-this paper integrates infrared-visible fused
   images with the well-developed deep learning technology for visible
   object detection. Targeting moving fluid boundary objects, we propose a
   high-precision gas cloud recognition algorithm based on the YOLO
   architecture: Moving Fluid Boundary YOLO (MFB-YOLO).
   Built upon the YOLOv8 framework, MFB-YOLO optimizes feature learning
   mechanisms to address the highly irregular and unstable nature of gas
   cloud boundaries. First, in gas detection scenarios, stable boundary
   interferences (e.g., personnel and vehicles) are eliminated from fused
   images to achieve differentiated recognition of gas clouds. To fully
   capture spatial distribution features of targets, a Global Attention
   Mechanism (GAM) is introduced during the feature fusion stage. This
   employs coordinated channel-spatial attention and dynamic weight
   allocation strategies, establishing two convolutional submodules: a
   channel attention submodule and a spatial attention submodule. The
   channel attention submodule reduces computational load through
   channel-wise recalibration, enhances feature channels relevant to gas
   targets, and suppresses noise from irrelevant channels. The spatial
   attention submodule applies spatial recalibration to cover regions where
   gas clouds predominantly exist, preventing overfitting to shape features
   by small convolutional kernels. Together, these mechanisms significantly
   improve gas cloud detection precision.
   First, ablation experiments were conducted to analyze the contributions
   of each module while validating the algorithm. Outdoor field experiments
   for HFC-152a gas detection were also performed. The experimental results
   demonstrate that the MFB-YOLO algorithm achieves approximately 10\%
   higher precision than YOLOv8 with comparable recall rates. The mAP:50
   metric improved by about 55\%, reaching 84\%. Although the single-sample
   response time increased by roughly 30\%, the total processing time
   remains merely 0.08s-considerably less than the acquisition time of a
   single-frame infrared image (3s).
   Compared to traditional YOLO methods, MFB-YOLO enhances gas cloud
   recognition precision through infrared-visible image fusion and Global
   Attention Mechanism. This advancement increases the practicality of
   infrared remote sensing in complex environments and holds significant
   scientific and engineering value for applications such as industrial gas
   leak alarming.},
