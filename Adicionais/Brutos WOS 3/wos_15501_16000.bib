@inproceedings{ WOS:000337300500158,
Author = {Lin, Tung-Long and Tai, Wei-Ying},
Editor = {Meen, TH and Prior, SD and Lam, ADKT},
Title = {Exploring emotional design of user's needs - green products as example},
Booktitle = {INNOVATION, COMMUNICATION AND ENGINEERING},
Year = {2014},
Pages = {647-650},
Note = {2nd International Conference on Innovation, Communication and
   Engineering (ICICE), Qingdao, PEOPLES R CHINA, OCT 26-NOV 01, 2013},
Organization = {China Univ Petr; Taiwanese Inst Knowledge Innovat},
Abstract = {In the recent years, due to the widespread increase of environmental
   awareness, the conception of green design has attracted wide attention.
   Currently the recognition of green products mainly depends on 4R
   principles or marks, yet both of them are not well understood and
   accepted by mass consumers. As consumption is inclined toward emotional
   values and personal styles, green design principles are no guarantee to
   satisfy the consumers. Therefore this study employed the Evaluation Grid
   Method and conducted a survey on life styles to explore the opinions and
   needs of the public toward the emotional values of green products, in
   order to discover the potential consumers of green products and the
   emotional preferences of all consumer groups. The findings can help
   designers to grasp the target groups and appropriate conditions for
   design, and create products from the perspective of consumers' needs
   instead of their own subjective judgment. The designed products can thus
   better satisfy the emotional value and personal styles of the target
   consumers.},
