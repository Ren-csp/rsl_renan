@article{ WOS:000468169700004,
Author = {Colbeck, I. and Sidra, S. and Ali, Z. and Ahmed, S. and Nasir, Z. A.},
Title = {Spatial and temporal variations in indoor air quality in Lahore,
   Pakistan},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL SCIENCE AND TECHNOLOGY},
Year = {2019},
Volume = {16},
Number = {6, SI},
Pages = {2565-2572},
