@article{ WOS:000073321900017,
Author = {Vivash, R and Ottosen, O and Janes, M and Sorensen, HV},
Title = {Restoration of the rivers Brede, Cole and Skerne: a joint Danish and
   British EU-LIFE demonstration project, II - The river restoration works
   and other related practical aspects},
Journal = {AQUATIC CONSERVATION-MARINE AND FRESHWATER ECOSYSTEMS},
