@article{ WOS:000255898900008,
Author = {Bacchini, Marco and Cuzzolin, Laura and Camerlengo, Thomas and Velo,
   Giampaolo and Benoni, Giuseppina},
Title = {Phytotherapic compounds - The consumer-pharmacist relationship},
Journal = {DRUG SAFETY},
Year = {2008},
