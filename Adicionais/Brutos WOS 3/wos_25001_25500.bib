Volume = {24},
Number = {7},
Pages = {5426-5430},
Month = {JUL},
Note = {2nd Advances in Social Sciences Research International Conference
   (ASSRIC), Bandung, INDONESIA, MAY 05-06, 2017},
Organization = {IPN Educ Grp},
Abstract = {Human Resources Information System (HRIS) is a name of course subject
   that teach the students how the implementation of information technology
   systems in human resources management (HRM). To improve the students
   experience, the researcher will conduct the SAP Human Capital Management
   (SAP HCM) in HRIS class. The hypothesis to be tested in this study were:
   (1) Students understanding about data management, HRM process and HRM
   cycle will increase after using SAP HCM, (2) Students perception to SAP
   HCM will affect students academic performance in HRIS class, (3)
   Students learning satisfaction with SAP HCM will affect students
   academic performance. Participants in this study were 29 students who
   follow HRIS class. Data were collected through questionnaire that
   measures students understanding about HRIS and HRM. Additional
   questionnaire based on Technology Acceptance Model (TAM) also served to
   enrich the data. Four factors, namely perceived ease of use, perceived
   usefulness, self-efficacy, support and facilities, were used in this
   study. The experimental research with one group pre-test post-test
   design were applied. The Wilcoxon different rank test by SPSS was
   applied for data analysis. Results showed that SAP Human Capital
   Management effective in: (1) improve students understanding of the
   management of data in HRIS, improve the students understanding about the
   process of human resource management, and improve the understanding of
   HRM cycle, (2) Only one factor from TAM can predict student performance,
   (3) Student satisfaction for support and facilities affect student
   academic performance in HRIS class.},
