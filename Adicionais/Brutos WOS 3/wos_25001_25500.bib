Title = {Inter-channel Granger Causality for Estimating EEG Phase Connectivity
   Patterns in Dyslexia},
Booktitle = {ARTIFICIAL INTELLIGENCE IN NEUROSCIENCE: AFFECTIVE ANALYSIS AND HEALTH
   APPLICATIONS, PT I},
