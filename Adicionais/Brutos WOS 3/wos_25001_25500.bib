Title = {FORMATION OF PEDAGOGICAL OPTIMISM OF BACHELOR BY MEANS OF COGNITIVE
   ACTIVITY},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
