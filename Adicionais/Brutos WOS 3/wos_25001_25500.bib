@inproceedings{ WOS:000079308700072,
Author = {Brun, J and Arial, M and Loiselle, C},
Editor = {Singh, A and Hinze, J and Coble, RJ},
Title = {Safety management on construction sites in Quebec},
Booktitle = {IMPLEMENTATION OF SAFETY AND HEALTH ON CONSTRUCTION SITES},
Year = {1999},
Pages = {537-542},
Note = {2nd International Conference of CIB Working Commission W99, HONOLULU,
   HI, MAR 24-27, 1999},
Organization = {Carter \& Burgess, Corp Headquarters; Natl Sci Fdn; HI Occupat Safety \&
   Hlth Div; HI Dept Transportat; Univ Hawaii Manoa; Construct Educ
   Concepts},
Abstract = {This presentation examines the results of a study of the implementation
   of preventive measures in the construction industry. The study began
   with the observation that there exist numerous preventive measures
   (technical, organizational or legislative) that are not easily applied
   on construction sites. The factors studied to understand this situation
   include the perception of workers and managers, the type of work
   involved, the characteristics of the contractors, the contractual
   management of the sites, government inspectors, etc.
   The study analysed various construction sires and evaluated whether or
   not the implementation of preventive measures is conditioned by the
   relevance or efficacy of the measure itself and/or by factors associated
   with the workers, companies, job, work-site management or external
   regulatory agencies. Using an exploratory multi-site study, we attempt
   to understand, through observations and comparisons of work situations
   as well as group discussions of these situations, how and why these
   preventive measures are or are not implemented on various construction
   sites. We then present a portrait of the conceptions and representations
   that the different groups involved have of the application of various
   preventive measures and their relative effectiveness, and likewise
   discuss the conditions and determinants of this application.
   Our results are helping us to draw a portrait of the conditions that
   positively or negatively influence the application of these measures.
   They will also help the construction sector better understand the
   characteristics of the different prevention strategies and the
   mechanisms that trigger their application.},
