Pages = {151-157},
Note = {IWA International Conference on Future Urban Wastewater Systems, Xian,
   PEOPLES R CHINA, MAY 18-20, 2005},
Organization = {Int Water Assoc},
Abstract = {A dispersed-ozone flotation (DOF) separator was devised for a pilot
   study of tertiary wastewater treatment for re-use purposes. As a compact
   device combining coagulation, ozonation and flotation in an integrated
   unit, the DOF separator achieved a very high removal of SS, TOC, UV254
   and colour, as well as effective inactivation of coliform and total
   bacteria within a short hydraulic retention time of 30 min. The finished
   water quality is comparable to or better than that by a conventional
   tertiary treatment process using coagulation, sedimentation, filtration
   and chlorine disinfection, and meets the quality standards for
   non-drinkable domestic reuse.},
