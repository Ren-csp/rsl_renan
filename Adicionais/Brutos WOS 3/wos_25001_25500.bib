@inproceedings{ WOS:000469760500087,
Author = {Yulianto, Budi and Saadah, Nurlailis},
Editor = {Jatmiko, YD and Azrianingsih, R and Pamungkas, MA and Safitri, A and Karim, C},
Title = {Effect of Environmental Noise and Social Environment on the Performance
   of Weaving Department Workers in the Textile Industry},
Booktitle = {8TH ANNUAL BASIC SCIENCE INTERNATIONAL CONFERENCE: COVERAGE OF BASIC
   SCIENCES TOWARD THE WORLD'S SUSTAINABILITY CHALLANGES},
Series = {AIP Conference Proceedings},
Year = {2018},
Volume = {2021},
Note = {8th Annual Basic Science International Conference (BaSIC) - Coverage of
   Basic Sciences toward the World's Sustainability Challanges, Malang,
   INDONESIA, MAR 06-07, 2018},
Organization = {Univ Brawijaya, Fac Math \& Nat Sci},
Abstract = {Long exposure to high-intensity noise in weaving departments is a source
   of working stress. The social environment of the workplace depends on
   social capital, family support, management's leadership style, and the
   social environment within the family, all of which could be sources of
   stress or sources of happiness that reduce stress of workers in the
   weaving department. In addition to environmental factors from the
   workplace and home, working stress is also affected by the age and
   status of the workers. Long-term stress decreases worker performance.
   This study analyzes the effect of working and social environments on
   worker performance in the weaving department of the PT Kusumahadi
   Santosa textile factory in the Karanganyar Regency, Central Java,
   Indonesia. This study used a cross-sectional study design with an
   observational approach with 250 workers from the textile factory's
   weaving department as respondents. Noise exposure was measured with a
   sound level meter; noise perception, social environmental factors
   (including social capital, family support, and leadership style) were
   measured by questionnaire and analyzed with path analysis. This study
   suggests that social capital and good family support could reduce the
   stress of workers who employed in an environment with high-intensity
   noise exposure. This study recommends that employers maintain and
   preserve the workplace social environment so that workers having a sense
   of trust and maintain good social bonds within the company. It is also
   important for workers to maintain their family harmony.},
