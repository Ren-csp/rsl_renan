Title = {REACHING SUSTAINABLE SETTLEMENT AND BUILDING STRUCTURES AS A PROBLEM OF
   CHOOSING INTELLIGENT INDICATORS},
Booktitle = {CESB 10: CENTRAL EUROPE TOWARDS SUSTAINABLE BUILDING - FROM THEORY TO
   PRACTICE},
