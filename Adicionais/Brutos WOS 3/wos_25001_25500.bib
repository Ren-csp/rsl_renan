@article{ WOS:000074212200004,
Author = {Turner, HA and Pearlin, LI and Mullan, JT},
Title = {Sources and determinants of social support for caregivers of persons
   with AIDS},
Journal = {JOURNAL OF HEALTH AND SOCIAL BEHAVIOR},
Year = {1998},
