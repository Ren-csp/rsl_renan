@inproceedings{ WOS:000346067900260,
Author = {Gassman, Philip W. and Panagopoulos, Yiannis and Srinivasan, Raghavan
   and White, Mike and Jha, Manoj and Arnold, Jeffrey G. and Campbell, Todd
   and Richardson, Jeff and Rabotyagov, Sergey and Valcu, Adriana M. and
   Kling, Catherine L. and Turner, R. Eugene and Moskal, Monika L. and
   Rabalais, Nancy},
