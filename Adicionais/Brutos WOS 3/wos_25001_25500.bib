@inproceedings{ WOS:001423534200006,
Author = {Ovalle, Claudia and Alvares, Danilo},
Editor = {Wiberg, M and Molenaar, D and Gonzalez, J and Bockenholt, U and Kim, JS},
Title = {A Bayesian Graphical and Probabilistic Proposal for Bias Analysis},
