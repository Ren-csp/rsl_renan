@inproceedings{ WOS:000771919100068,
Author = {Klimov, Andrey and Alexandrova, Natalya and Alekseeva, Olga},
Editor = {Shirin, AG and Zvyaglova, MV and Fikhtner, OA and Ignateva, EY and Shaydorova, NA},
Title = {FEATURES OF CAREER GUIDANCE IN AN OPEN INFORMATION ENVIRONMENT},
Booktitle = {EDUCATION IN A CHANGING WORLD: GLOBAL CHALLENGES AND NATIONAL PRIORITIES},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2021},
