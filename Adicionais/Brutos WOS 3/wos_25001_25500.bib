@inproceedings{ WOS:000179444800097,
Author = {Bestandji, S},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Referents of traditional domestic space in Algeria from a codification
   mode to an interpretation mode},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {787-791},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {Society with ambivalent culture, because of her historic route, with
   traditional essence because of her conceptions, perceptions and social
   practices of space, the Algerian society developed many modes to product
   domestic space, witch modes are not exclusively hers, but founded on a
   generic representation: the world, the universe,...
   Before it became his temple, human habitation (housing?) had been his
   sacred space. He charged it with significations and symbolism; he
   individualised it, singularised it, in an environment presumed profane.
   Perceptual, conceptual and constructive traditions brought just to us,
   relatively preserved, some referents of traditional domestic space. They
   still exist in traditional space itself, but they appear also in other
   forms of domestic space by forms of appropriation that superpose a
   traditional schema on a contemporary physical space: introversion /
   extraversion, closure / opening, multi functional / mono functional,...
   Nowadays, the discussion about identity is open. Are open by the same
   time questions on domestic space referents, psychological shell of
   family cell.
   If traditional domestic space had been produced in a codification system
   realising conformity between representation and materialisation, we must
   now make an interpretation of that, trying to transcribe it in an other
   codification system, universal this one, relative to the architect
   formation and teaching.
   So we may try to discuss in this conference some referents of domestic
   space in Algeria. That may be so parameters to approach architecture,
   and so idea elements of project.},
