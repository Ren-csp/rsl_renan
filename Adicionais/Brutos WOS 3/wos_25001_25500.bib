@article{ WOS:000444975300155,
Author = {Taiwo, D. O. and Yusoff, Nooraini Bte and Aziz, Norsiah Bte Abdul},
Title = {Self-Help Approach as One of the Panacea for Housing Delivery Dilemma in
   Nigeria},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3770-3776},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {As world population increases so does the need for housing. This is
   especially true of developing countries like Nigeria. Despite the
   various interventions by the government, a large proportion of the
   population of Nigeria cannot still afford to own houses; hence the
   people resulted to for self-help housing approach to meet the
   shortcomings of the government. Self-help housing can be described as
   the process and procedures by which the economically disadvantaged
   groups solve their housing needs by making provision for the cost of
   labour and other financial commitments. Arguably, housing provision is
   the social responsibility of the government to provide affordable
   housing for the citizenry but in the face of the falling financial
   resources and global economic problem, alternatives have to be sought to
   in order meet the citizens housing needs. The primary data was gathered
   through observations and questionnaire administration on the respondents
   in the study area. The secondary data were gathered through literature
   search from journal publications, magazines and the internet The paper
   explores the self-help housing delivery practices in Nigeria with the
   attendants' problems by using the South West geopolitical zone as case
   study. The paper also determines the extent to which government
   interventions have been successful in providing housing for Nigerians.
   The paper then concludes that in order to meet the challenges of shelter
   provision, there is an urgent need to re-direct and focus the attention
   of the Nigerian population to channel their resources on self-help
   approach of housing provision rather than to rely solely on the
   government.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Taiwo, DO (Corresponding Author), Univ Teknol Malaysia, Fac Built Environm, Dept Urban \& Reg Planning, Skudai 81310, Malaysia.
   Taiwo, D. O.; Yusoff, Nooraini Bte; Aziz, Norsiah Bte Abdul, Univ Teknol Malaysia, Fac Built Environm, Dept Urban \& Reg Planning, Skudai 81310, Malaysia.},
DOI = {10.1166/asl.2018.11481},
