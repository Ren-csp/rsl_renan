   Gonzalez Gonzalez, Yoana; Da Cuna Carrera, Iria; Lantaron Caeiro, Eva Ma; Soto Gonzalez, Mercedes, Univ Vigo, Fac Fisioterapia, Campus A Xunqueira S-N, Pontevedra 36005, Spain.},
DOI = {10.15405/epsbs.2019.04.02.64},
ISSN = {2357-1330},
