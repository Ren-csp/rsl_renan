@article{ WOS:000431770900047,
Author = {Muntoha, M. and Soemitro, Ria A. A. and Rachmawati, Farida},
Title = {Risk Allocation for Low-Cost Apartment Program Implementation in the
   Surabaya Metropolitan Area},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {12},
Pages = {11838-11842},
Month = {DEC},
Note = {1st International Joint Conference on Science and Technology (IJCST),
   Bali, INDONESIA, OCT 12-13, 2016},
Organization = {Univ Pembangunan Nas Veteran Jawa Timur, Fac Ind Technol; Bali State
   Polytechn; Natl Cheng Kung Univ; Univ Negeri Surabaya, Fac Social Sci \&
   Law; Univ Negeri Surabaya, Fac Math \& Nat Sci; Univ Trunojoyo Madura,
   Fac Engn},
Abstract = {Low-cost apartment development programs are one of reliable solutions
   for meeting housing needs in the East Java Province due to land scarcity
   and high price of land. Given that the private sector believes that
   there are many risks facing the implementation of Public Private
   Partnership (PPP), especially for financial matters, there is a lack of
   private sector involvement in these projects. The objective of the
   present paper is to identify risk factors, risk allocation and risk
   responses for public private partnership for developing low-cost
   apartments under the partnership agreement, from the perspective of
   stakeholder perception. Risk variables for better understanding of
   low-cost apartment implementation have been validated by respondents
   from both the government and private sectors. Risk allocation and risk
   response were validated by respondents through semi-structured
   interviews. The results show that the Government perceived the important
   risks both the difficulties faced by low income group and the public
   decision making process. While the private sector perceived the
   important risks as low return of investment and changes in tariff
   regulation. The major risks that the public sector preferred to accept
   were within the systematic risk category, especially those related to
   laws and regulation. The private sector preferred to retain principal
   risks within the specific project risk category, especially those
   related to construction, and operation.},
