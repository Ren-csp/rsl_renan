@article{ WOS:000432429600065,
Author = {Harun, Azahar and Abd Razak, Mohamed Razeef and Abd Rahim, Ruslan and
   Radzuan, Lili Elaina Mohd and Khalil, Musaddiq Mohamad and Abu Bakar,
   Amina Syarfina},
Title = {The Emotional Impact of Humanized Brand: Case Study of Malaysian SME
   Food Products},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2451-2454},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Most companies would employ humanized brand as a marketing approach for
   positioning a product or a service. Usually the design of the humanized
   brand often incorporates human elements such as face, body form and
   facial expression. For example, the yellow curved line of Amazon logo
   represents a smiling expression that symbolizes the meaning of friendly
   and trustworthy. As far as marketing communication is concerned, the
   study on the emotional impact of humanized brand of Malaysian SME
   companies has yet to be carried out. Hence the main question is posed
   how does humanized brand of SMEs function in communicating value and
   persuading consumers. To answer this question, a visual analysis and a
   survey were conducted at a local supermarket in Shah Alam Selangor,
   Malaysia. Three hundred and thirteen (n = 313) consumers assessed four
   humanized brands (Kawan, Brahim's, Munchy's and Mister Potato). The
   outcome of the survey shows that majority of the consumers recognize the
   sampled brands and the type of food. However most of them are perceived
   to be lacking in terms of trustworthiness and visual appeal. This is
   probably due to the design aspect, which seems straightforward and
   expressionless. This study shows that humanized brand has a significant
   role in affecting consumers' perception. Hence Malaysian SMEs should
   take serious consideration to upgrade the design of their brand in order
   to receive global recognition.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Harun, A (Corresponding Author), Univ Teknol MARA, Fac Art \& Design, Cawangan Melaka, Malaysia.
   Harun, Azahar; Khalil, Musaddiq Mohamad, Univ Teknol MARA, Fac Art \& Design, Cawangan Melaka, Malaysia.
   Abd Razak, Mohamed Razeef; Abd Rahim, Ruslan; Radzuan, Lili Elaina Mohd; Abu Bakar, Amina Syarfina, Univ Teknol MARA, Fac Art \& Design, Cawangan Selangor, Malaysia.},
DOI = {10.1166/asl.2018.10978},
ISSN = {1936-6612},
EISSN = {1936-7317},
Keywords = {Humanized Brand; Marketing; Design},
Research-Areas = {Science \& Technology - Other Topics},
Web-of-Science-Categories  = {Multidisciplinary Sciences},
