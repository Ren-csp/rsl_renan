@inproceedings{ WOS:000225599600043,
Author = {Huang, F and Liu, XG and Zhan, XW and Zhang, YZ},
Editor = {Gao, W and Shaw, DR},
Title = {Landcover change of semi-arid area in Northeast China since 1950s},
Booktitle = {REMOTE SENSING AND MODELING OF ECOSYSTEMS FOR SUSTAINABILITY},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
