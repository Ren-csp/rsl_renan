@inproceedings{ WOS:000085327400012,
Author = {Zadina, JE and Martin-Schild, S and Gerall, AA and Kastin, AJ and
   Hackler, L and Ge, LJ and Zhang, X},
Editor = {Sandman, CA and Strand, FL and Beckwith, B and Chronwall, BM and Flynn, FW and Nachman, RJ},
Title = {Endomorphins:: Novel endogenous μ-opiate receptor agonists in regions of
   high μ-opiate receptor density},
Booktitle = {NEUROPEPTIDES: STRUCTURE AND FUNCTION IN BIOLOGY AND BEHAVIOR},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {1999},
