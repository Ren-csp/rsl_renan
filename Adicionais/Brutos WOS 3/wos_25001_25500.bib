@article{ WOS:000444996500158,
Author = {Tan, May-Ling and Harun, Jamalludin},
Title = {Utilizing Concept Map of the Social Presence Characteristics in Social
   Collaborative Learning Environment for Nurturing Engineering Students'
   Knowledge Construction Levels},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4561-4564},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {Online education comprising in engineering education increasingly puts
   emphasis on social collaborative learning (SCL) methods. Constructing
   knowledge via online collaborative and social learning has been realized
   as one of the ways to nurture students' higher level of knowledge
   construction. Despite the pedagogical advantages of SCL, online learners
   can perceive social collaborative learning activities as frustrating
   experiences. One significant reason is the deficiency of social presence
   (SP). SP relates to the need for users of technology-based communication
   to perceive each other as real people. This article analyzes the
   characteristics of a SP may help engineering students reach a higher
   level of knowledge construction. Posting scripts from Facebook
   discussions and structured interviews were used for data collection. A
   qualitative case study utilized to answer the research objective. It
   involved a process to provide the details of exploration in a real
   situation by obtaining the perceptions and perspectives of ten
   engineering students who were studying at a polytechnic in northern
   Malaysia. Content analysis, thematic analysis and concept maps were used
   in the study. The results indicated that significant elements of a
   social presence would improve engineering students' knowledge
   construction levels in the SCL environment. The study discusses the
   incorporate and or interrelationships between immediacy and intimacy by
   utilizing concept maps. This case study also illustrates some student
   perspectives and calls attention to some social presence issues that
   could make SCL a more satisfying in online learning experience for
   students.},
