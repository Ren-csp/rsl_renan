Note = {International Symposium on Environmental Science and Technology,
   Shanghai, PEOPLES R CHINA, JUN 02-05, 2009},
Organization = {Chinese Soc Environm Sci; Beijing Inst Technol; Donghua Univ; Key Lab
   Explos Sci \& Technol},
Abstract = {The evaluation model for assessing the driving mechanism of surficial
   groundwater system vulnerability in the lower Liaohe river plain was
   built by canonical correlation analysis (CCA) method, and the results
   were verified. The result indicated that the driving mechanism of
   surficial groundwater vulnerability in lower Liache river plain could be
   described by two pairs of canonical comprehensive variable. The first
   pair of canonical comprehensive variable extracted fertilization
   intensity, population density, soil organic material content, index of
   water provision and demand and industry production value modulus from
   other influencing factors, In accordance, it extracted
   ammonia-nitrite-nitrates concentration in groundwater from independent
   variable groups; The second pair of canonical comprehensive variable
   extracted index of water provision and demand, industry production value
   modulus, aquifer thickness, vegetation cover index and water web density
   from other influencing factors, and extracted the departure value of
   groundwater ecological table from independent variable groups. On this
   basis, the function of every driving factor to surficial groundwater
   vulnerability in research area was assessed in quantity according to the
   factors' loading value.},
