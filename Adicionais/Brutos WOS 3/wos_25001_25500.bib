Title = {Challenge and opportunities of space-based precipitation radar for
   spatio-temporal hydrology analysis in tropical maritime influenced
   catchment: Case study on the hilly tropical watershed of Peninsular
   Malaysia},
Booktitle = {8TH INTERNATIONAL SYMPOSIUM OF THE DIGITAL EARTH (ISDE8)},
