@inproceedings{ WOS:001575681000027,
Author = {Ibarra, Carlos and Astudillo, Pamela},
Editor = {Black, NL and Neumann, WP and Noy, I},
Title = {Manual Handling Task of Bovine Quarters Among Delivery Operators in a
   Chilean Slaughterhouse Company: A Case Study with Ergonomic
   Approximation},
Booktitle = {PROCEEDINGS OF THE 21ST CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, IEA 2021, VOL III},
