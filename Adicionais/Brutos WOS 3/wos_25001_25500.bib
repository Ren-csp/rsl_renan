@article{ WOS:000277369100008,
Author = {Schilling, Boris and Kaiser, Roman and Natsch, Andreas and Gautschi,
   Markus},
Title = {Investigation of odors in the fragrance industry},
Journal = {CHEMOECOLOGY},
Year = {2010},
Volume = {20},
