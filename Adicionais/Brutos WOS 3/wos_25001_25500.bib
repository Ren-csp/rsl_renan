@inproceedings{ WOS:001544506800026,
Author = {Wang, Fei and Huang, Yanan and Wu, Meng and Jiang, Ao and Wang, Shanshan
   and Fan, Hao and Foing, Bernard},
Editor = {Harris, D and Li, WC},
Title = {Simulating the Effect of MR Interface Background Color on Task
   Performance and Mood Under Extremely Dark Light Conditions on a Space
   Station},
Booktitle = {ENGINEERING PSYCHOLOGY AND COGNITIVE ERGONOMICS, EPCE 2025, PT II},
Series = {Lecture Notes in Artificial Intelligence},
