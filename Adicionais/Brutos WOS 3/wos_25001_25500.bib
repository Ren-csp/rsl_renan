Title = {Thermodynamic Analysis of Alkaline Leaching of Solid Wastes Bearing Zinc},
Booktitle = {SELECTED PROCEEDINGS OF THE FIFTH INTERNATIONAL CONFERENCE ON WASTE
   MANAGEMENT AND TECHNOLOGY(ICWMT 5)},
Year = {2010},
Pages = {646-648},
Note = {5th International Conference on Waste Management and Technology,
   Beijing, PEOPLES R CHINA, DEC 15-17, 2010},
Abstract = {For the hydrometallurgical processing of solid wastes bearing zinc by
   alkaline leaching, the E-pH equilibrium diagrams of the systems every
   component were drawn according to thermodynamics calculation. ZnO, ZnCO3
   and Zn2SiO4 were the predominant mineralogical phases in solid wastes
   bearing zinc. According to diagrams, ZnO, ZnCO3 and Zn2SiO4 can be
   dissolved by strong alkaline solution. Compared with ZnO and ZnCO3,
   higher concentration of OH- was required to dissolve Zn2SiO4. In strong
   alkaline solution, most of zinc ions exist in the form of Zn(OH)(4)(2-).
   The apparent equilibrium constant (K-C) for reaction of ZnO dissolved in
   NaOH solution was investigated. It has been found that K-C increased
   with the NaOH concentration increasing up to 4.2 mol/L. The K-C dropped
   down when sodium hydroxide is over 5mol/L because the high sodium
   hydroxide concentration increased the viscosity of the solution, which
   would tend to reduce the diffusion rate of the ions. Thus, a NaOH
   solution of 4-5 mol/L(160-200g/L) was considered suitable for leaching
   reaction.},
