@article{ WOS:000186698400023,
Author = {Goyne, PJ and McIntyre, GT},
Title = {Stretching water - Queensland's water use efficiency cotton and grains
   adoption program},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2003},
Volume = {48},
Number = {7},
