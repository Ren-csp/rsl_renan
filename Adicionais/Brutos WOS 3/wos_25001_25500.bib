@inproceedings{ WOS:000179202600012,
Author = {Okabe, S and Kokazi, T and Watanabe, Y},
Editor = {Wilderer, P and Amy, G and Arvin, E and Blackwell, L and Hamoda, MF and Mikkelsen, PS and Mino, T and Morgenroth, E and Otterpohl, R and Pons, MN and Rauch, W and Stephenson, T and Ujang, Z and Jianrong, Z},
Title = {Biofilm formation potentials in drinking waters treated by different
   advanced treatment processes},
Booktitle = {2ND WORLD WATER CONGRESS: WATER DISTRIBUTION AND WATER SERVICES
   MANAGEMENT},
