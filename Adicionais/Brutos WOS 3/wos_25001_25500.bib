@article{ WOS:000233644300011,
Author = {Ohno, K and Furukawa, A and Hayashi, K and Kamei, T and Magara, Y},
Title = {Arsenic contamination of groundwater in Nawabganj, Bangladesh, focusing
   on the relationship with other metals and ions},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
