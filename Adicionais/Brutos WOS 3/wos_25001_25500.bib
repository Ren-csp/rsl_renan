@article{ WOS:000432429600164,
Author = {Inti, Muhammad Muhammad and Latib, Azlan Abdul and Bakare, Francis Shola
   and Kamin, Yusri and Amin, Nor Fadila and Saud, Muhammad Sukri},
Title = {Pedagogical Approaches Required for Fostering Interpersonal Skills Among
   Mechanical Engineering Technology Students'},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2854-2857},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Interpersonal skills (IPS) are one of the generic employability skills
   clusters that 21st century employers focus on when choosing the best
   applicant from a large pool of job seekers. The absence of, or low, IPS
   could result in a hostile relationship between employees, which could
   affect productivity and economic benefits for both employers and
   employees. The literature has shown that recent graduates are lacking
   these skills. This study was specifically designed to determine
   lecturers' perceptions of the teaching methods required to foster the
   development of IPS in Mechanical Engineering Technology (MET) students
   in Nigerian polytechnics. A descriptive survey research design was used
   in conducting the study. Two hundred and thirty-four (234) MET lecturers
   from Nigerian polytechnics served as the respondents. A structured
   questionnaire, which was validated by four technical and vocational
   education specialists, was used for data collection. The instrument was
   pilot tested using a small sample of 45 polytechnic lecturers and
   Cronbach's alpha was used to compute the reliability index of the
   instrument, showing that the instrument had a reliability coefficient of
   r = 0.87. The data was analysed using stepwise linear regression
   analysis. The findings identified four (4) teaching methods that could
   be used in fostering the development of IPS (Project-Based Learning,
   Cooperative Learning, Service Learning and Group Discussion). It was
   recommended that polytechnic lecturers should use the teaching methods
   identified in this study to promote the development of IPS amongst MET
   students.},
