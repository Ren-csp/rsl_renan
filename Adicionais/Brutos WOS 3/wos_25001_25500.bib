@inproceedings{ WOS:001877420000017,
Author = {Pouso, Martin and Miranda, Lorena and Martinez, Noelia and Seijo,
   Dolores},
Editor = {Arce, R and Lila, M and Arias, E},
Title = {ENCUESTA DE VICTIMIZACION DE CONDUCTAS DELICTIVAS EN GALICIA, ESPANA,
   2023},
Booktitle = {COLECCION PSICOLOGIA Y LEY},
Series = {Coleccion Psicologia y Ley},
Year = {2025},
Volume = {19},
Pages = {275-290},
Note = {14th International Congress of Legal and Forensic Psychology, Elche,
   SPAIN, MAR 01-02, 2024},
Abstract = {Background/Aims: Victimization surveys are effective tools to combat the
   phenomenon of dark crime figures, both at regional and (inter)national
   levels. This requires methodological rigour in its construction and
   application procedure, as well as a certain periodicity. Therefore, a
   survey of crime victimization in Galicia (Spain) was designed for the
   year 2023. Mehtod: A random sampling stratified by proportional
   afixation (province, gender, age group and habitat) was planned. 393
   over 18 citizens living in Galicia participated (confidence level of
   95\%, heterogeneity 50/50 and margin of error of 4.94\%) who answered a
   survey with all the main criminal typologies against persons listed in
   the spanish Penal Code in 2023. Results: The results show that 44.3\% of
   the Galician population has suffered some crime in the last year (almost
   two crimes per person on average). A very high prevalence (>.10) was
   found in crimes against property and the socio-economic order, against
   workers' rights and injuries. All other offences are classified as
   frequent (.01-.10). In addition, participants perceive a moderate/high
   level of public safety, finding differences according to sex (men feel
   safer) and province of residence (Ourense is where people feel safer).
   Finally, the data indicate that having been a victim of crime in 2023
   does not influence the perception of the level of safety. Discussion:
   The limitations of such studies are discussed, the importance of
   counting historical series of victimization surveys and the implications
   for crime prevention.},
Publisher = {SOC ESPANOLA PSICOLOGIA JURIDICA FORENSE},
Address = {FAC PSICOLOGIA, CAMPUS UNIV, S-N, SANTIAGO DE COMPOSTELA, 15782, SPAIN},
