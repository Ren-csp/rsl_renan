@inproceedings{ WOS:000659867304013,
Author = {Torubarova, Tatyana and Dyachenko, Olga},
Editor = {Rudoy, D and Olshevskaya, A and Kankhva, V},
Title = {Problematization of the metaphysical foundations of human personality},
Booktitle = {INNOVATIVE TECHNOLOGIES IN SCIENCE AND EDUCATION (ITSE-2020)},
