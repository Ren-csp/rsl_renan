@article{ WOS:000221095000003,
Author = {Svirezhev, YM},
Title = {Ecosystem as a text: information analysis of the global vegetation
   pattern},
Journal = {ECOLOGICAL MODELLING},
Year = {2004},
Volume = {174},
Number = {1-2},
Pages = {19-24},
Month = {MAY 1},
Note = {1st Biennial Meeting of the
   International-Environmental-Modelling-and-Software-Society (IEMSs), Univ
   Lugano, Lugano, Switzerland, JUL, 2002},
Organization = {Int Environm Modelling \& Software Soc},
Abstract = {Let us consider a text. which is written in the English language. At the
   zero level of perception (or description), we know only the number of
   symbols (n = 29: 26 letters, 1 blank, 1 comma and 1 full stop). Then the
   information per symbol I-(0) log(2) 29 approximate to 4.85 bits. At the
   second level of perception we take into account the frequencies of the
   symbols (letters); then I-(1) approximate to 4.03 bits. At the next
   levels we take into account double, triple, etc. correlations, i.e.,
   words of two letters, three letters, etc., so that the information per
   letter are I-(2)/2 approximate to 3.32 bits, I-(3)/3 approximate to 3.10
   bits,..... The redundancy of information, R-(i), and its cost, C-(i),
   are equal to R-(0) = 0. R-(1) = 0. 15, R-(2) = 0.30, R-(3) = 0.35, and
   C-(0) = 1, C-(1) = 1.18, C-(2) = 1.43, C-(3) = 1.54.
   Let us consider a description of the global vegetation pattern (GVP). At
   the zero level of description we have a number of significant biomes or
   vegetation types, n. In accordance with Bazilevich n = 30, then I-(0)
   log(2) 30 approximate to 4.9 bits. At the second level we take into
   account the relative areas covered by biomes. Then I-(1) approximate to
   4.41 bits, R-1 = 0. 1, and C-1 = 1.11. At the next level of description
   we consider the spatial correlations between different pairs of biomes,
   then I-(2)/2 approximate to 3.6 bits, R-2 = 0.265, and C-2 = 1.36. Note
   that in addition to their areas, the biomes are also characterised by
   three parameters: annual productivity P-i living biomass B-i and dead
   organic matter D-i. Weighting them in relation to biome area sigma(i) we
   define the frequencies p(i)(p) = P(i)sigma(i)/Sigma(i=1)(30)
   P(i)sigma(i)(.) p(i)(B) = B(i)sigma(i)/Sigma(i=1)(30) B(i)sigma(i) and
   p(i)(D) = D(i)sigma(i)/Sigma(i=1)(30) D(i)sigma(i). The description in
   terms of productivity, living or dead organic matter can be considered
   as description at the first level with information per letter defined as
   (I-(1))(P,B,D) = -Sigma(i=1)(n) P-i(P.B.D) log(2) P-i(P. B. D). Then (1)
   for productivity: (I-(1))P = 3.61 bits, C-2(P) = 1.32, R-2(P) = 0.24;
   (2) for living biomass: (I-(1))(B) = 3.27 bits, C-2(B) = 1.5, R-2(B) =
   0.33; (3) for dead organic matter: (I-(1))(D) = 4.13 bits, C-2(D) =
   1.17, R-2(D) = 0.16. One can see that information about the biome
   productivity, living biomass and dead organic matter is more valuable
   than the information about the biome areas distribution. Information
   about the distribution of living biomass has the maximal cost (C-2(B) =
   1.5). (C) 2004 Elsevier BX All rights reserved.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Svirezhev, YM (Corresponding Author), Potsdam Inst Climate Impact Res, POB 601203, D-14412 Potsdam, Germany.
   Potsdam Inst Climate Impact Res, D-14412 Potsdam, Germany.},
DOI = {10.1016/j.ecolmodel.2003.12.041},
ISSN = {0304-3800},
Keywords = {information theory; global vegetation pattern},
Research-Areas = {Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Ecology},
Author-Email = {yuri.svirezhev@pik-potsdam.de},
Affiliations = {Potsdam Institut fur Klimafolgenforschung},
Cited-References = {{[}Anonymous], 1990, Physik der Evolutionsprozesse.
   BAZILEVICH NI, 1993, BIOL PROD ECOSYSTEMS.
   BAZILEVICH NI, 1973, P 5 M USSR BOT SOC K, P239.
   KHARKEVICH AA, 1963, PROBLEMS CYBERNETICS, V9, P71.
