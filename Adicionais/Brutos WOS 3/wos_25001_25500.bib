Title = {THE DEVELOPMENT OF SWAT MODELLING SYSTEMS FOR LARGE CORN BELT RIVER
   BASINS PART 1: DESCRIPTION OF MODELLING SYSTEM COMPONENTS},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
