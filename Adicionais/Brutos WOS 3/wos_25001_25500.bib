@inproceedings{ WOS:001591421300028,
Author = {Monchietto, Alessandro and Ballestra Caffaratti, Luca},
Editor = {Toto, GA},
Title = {The Critical Role of AI in Teachers' Training},
Booktitle = {INCLUSION, COMMUNICATION, AND SOCIAL ENGAGEMENT, ICS EXCHANGE 2024},
