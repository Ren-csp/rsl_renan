@article{ WOS:000189352000005,
Author = {Kwarteng, AY and Al-Enezi, A},
Title = {Assessment of Kuwait's Al-Qurain landfill using remotely sensed data},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCE AND HEALTH PART A-TOXIC/HAZARDOUS
   SUBSTANCES \& ENVIRONMENTAL ENGINEERING},
