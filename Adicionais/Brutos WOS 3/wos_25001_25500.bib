@inproceedings{ WOS:000172009400018,
Author = {Altenmüller, EO},
Editor = {Zatorre, RJ and Peretz, I},
Title = {How many music centers are in the brain?},
Booktitle = {BIOLOGICAL FOUNDATIONS OF MUSIC},
Series = {Annals of the New York Academy of Sciences},
