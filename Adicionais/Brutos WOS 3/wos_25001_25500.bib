@inproceedings{ WOS:001544307500007,
Author = {Jeschke, Michaela and Metzger, Anna and Drewing, Knut},
Editor = {Kajimoto, H and Lopes, P and Pacchierotti, C and Basdogan, C and Gori, M and Lemaire-Semail, B and Marchal, M},
Title = {Humans Terminate Their Haptic Explorations According to an Interplay of
   Task Demands and Motor Effort},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
   INTERACTION, EUROHAPTICS 2024, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2025},
