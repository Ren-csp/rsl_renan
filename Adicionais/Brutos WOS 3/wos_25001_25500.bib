@article{ WOS:000242105100016,
Author = {Kato, F. and Kitakoji, H. and Oshita, K. and Takaoka, M. and Takeda, N.
   and Matsumoto, T.},
Title = {Extraction efficiency of phosphate from pre-coagulated sludge with NaHS},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
Volume = {54},
Number = {5},
Pages = {119-129},
Note = {IWA International Conference on Sustainable Management of Residues from
   Water and Waste Treatment, Johannesburg, SOUTH AFRICA, AUG 09-12, 2005},
Organization = {IWA Sludge Management Specialist Grp; WISA Anaerob \& Sludge Management
   Div},
Abstract = {The recovery of phosphorus from sewage and sludge treatment systems is
   particularly important because it is a limited resource and a large
   proportion of the phosphorus currently used in Japan must be imported.
   We have been experimentally evaluating recovery methods with sulphide.
   In this study, we focussed on the extraction of phosphate from the
   sludge, and sought to achieve a greater extraction efficiency and to
   validate the extraction mechanism. We conducted three experiments, i.e.
   a sludge-type experiment, a coagulant ratio of pre-coagulated sludge
   experiment, and a concentration of pre-coagulated sludge experiment.
   Phosphate was extracted not with normal sewage sludge but with
   pre-coagulated sludge and FePO4 reagent at S/Fe = 1.0-2.0. A coagulant
   ratio of 23 mg Fe L-1 was required in the pre-coagulation process to
   effectively extract phosphate. A high concentration of pre-coagulated
   sludge was required for the phosphate extraction. The mass balance was
   calculated, and 44.0\% of phosphorus was extracted to supernatant, and
   98.5\% of iron and 98.3\% of sulphur (44.1 \% of sulphur was sulphide).
   Thus, phosphate can be selectively separated from iron by the phosphate
   extraction method with NaHS, and phosphorus and iron can be recovered
   and reused at sewage treatment plants using ferric chloride as a
   coagulant.},
