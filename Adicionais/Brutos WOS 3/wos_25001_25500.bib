@article{ WOS:000454508700085,
Author = {Isjoni, Isjoni and Hermita, Neni and Samsudin, Achmad},
Title = {Self-Assessment as Evaluation Strategy of Principals Understanding in
   the Role of Supervisor},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {11},
Pages = {8219-8222},
Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {The success of a supervision program within an educational system can
   ensure that learning reaches its intended purpose. Supervision by the
   principal can run effectively by requiring qualified human resources
   qualities, capable of understanding the competencies that must be
   possessed and motivated to develop them. To ensure its effectiveness,
   history teaching requires a multi sector approach that not only focuses
   on the teacher's role but also the supervision of the principal. Through
   the application of self-assessments this study aims to reveal the
   evaluative approach can be applied in the development of the principal's
   competence to his understanding of the supervision program on teaching
   history. The method that used in this study is research and development
   method ADDIE (analyze, design, development, implementation, and
   evaluation) with involving 17 principals of senior high school in
   Pekanbaru city. This research reveals that self-assessment can optimize
   the school principal's understanding of supervision planning (73\%),
   supervision arrangement (57\%) and supervision evaluation (60\%). In
   addition, this study also shows that the implementation of
   self-assessment can place the principal in the category of a good
   understanding of the competencies that must be mastered as a supervisor.
   According to teachers' perceptions, the growing awareness of the
   supervisory competence of the principal makes the supervision program
   run more focused and responsive in addressing the dynamics of problems
   in teaching history.},
