Editor = {Wills, R and Hobbs, R},
Title = {Burning issues: communicating fire research in northern Australia},
Booktitle = {ECOLOGY FOR EVERYONE: COMMUNICATING ECOLOGY TO SCIENTISTS, THE PUBLIC
   AND THE POLITICIANS},
Year = {1998},
Pages = {88-96},
Note = {Annual Meeting of the Ecological-Society-of-Australia, TOWNSVILLE,
   AUSTRALIA, 1996},
Organization = {Ecol Soc Australia; CSIRO Div Wildlife \& Ecol; Kings Pk \& Bot Garden;
   Absett Airlines \& Traveland},
Abstract = {Fire is certainly a ``burning{''} issue in the savannahs of northern
   Australia. in many regions, more than half of the landscape is burnt
   annually, and there is widespread public confusion as to why this is so.
   This is compounded by a poor scientific understanding of the ecological
   effects of fire. in 1988, CSIRO Wildlife and Ecology established a
   landscape-scale fire experiment at Kapalga Research Station in Kakadu
   National Park, Northern Territory. The major communication challenges
   have been: (1) Overcoming the general public's perception of fire as a
   catastrophic event, rather than as a useful tool for land management;
   (2) Achieving ownership of the research findings by the project's major
   stakeholders - north Australian fire managers; and (3) Convincing
   Aboriginal traditional land owners of the value of our scientific
   research. Communication activities directed at the public have been
   generally successful, but there have been substantial difficulties in
   developing ownership of the research by Park managers and traditional
   Aboriginal land owners. Factors contributing to these difficulties
   include inadequate consultation during research planning, and the
   different institutional and social cultures of stakeholder groups.
   Important lessons we have learned for effective communication are: (1)
   Effective communication is built on effective stakeholder consultation
   at all stages of research planning, the conduct of the research itself,
   and the extension of its findings; (2) Different stakeholders have
   different needs, and information should be appropriately targeted; and
   (3) Communication activities require ongoing evaluation of their
   effectiveness.},
