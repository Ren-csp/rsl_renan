Title = {Colour vision loss in perchloroethylene exposed dry-cleaning workers},
Booktitle = {VOLATILE ORGANIC COMPOUNDS IN THE ENVIRONMENT - RISK ASSESSMET AND
   NEUROTOXICITY},
Series = {ADVANCES IN OCCUPATIONAL MEDICINE \& REHABILITATION},
Year = {1997},
Volume = {3},
Number = {3},
Pages = {247-255},
Note = {International Conference on Volatile Organic Compounds, SALVATORE
   MAUGERI FDN MED CTR, PAVIA, ITALY, OCT 05-07, 1997},
Organization = {Univ Pavia; Salvatore Maugeri Fdn; Int Soc Built Environm; Natl Res
   Council, Rome; AgipPetroli; BASF; CON TEC Engn; DANI; Draeger Italiana;
   FIAT Auto; FKV; Instrumentat Lab; IPSOA Editore Indicitalia; Perkin
   Elmer; Pollut Srl Clean Air Syst; San Air Ambiente; Tecnol Ind \&
   Ambientali; Unione Petrolifera; Zambelli},
Abstract = {Colour vision was evaluated in 43 perchloroethylene (PCE) exposed
   dry-cleaning workers and in a paired number of controls matched for sex,
   age, alcohol consumption and cigarette smoking. PCE exposure was
   assessed by personal monitoring, and the results were expressed as 8 h
   Time Weighted Average (TWA) levels. Colour vision was evaluated using
   the Lanthony D-15 desaturated panel (D-15 d). Dry-cleaning workers
   presented a sub-clinical colour vision loss, mainly in the blue-yellow
   range compared to controls. At multivariate analysis, this effect was
   significantly correlated with PCE exposure. According to their tasks,
   dry-cleaning workers were divided in two subgroups, cleaners and
   ironers; whose mean PCE exposures were 49 and 33 mg.m(-3) respectively.
   Cleaners presented a significant colour vision loss not only compared to
   the referents but also to the ironers, while colour perception in the
   latter, was not significantly different compared to the referents. The
   results support the hypothesis that PCE exposure can induce a
   dose-related colour vision loss. This effect was observed in cleaners
   exposed to a mean PCE level lower than the 30\% of the current Threshold
   Limit Value (TLV) proposed by the American Conference of Governmental
   Industrial Hygienists (AC-GIH) so that the real protective meaning of
   this limit seems questionable, at least on an individual basis. Another
   more general conclusion is that, based on our results, colour vision
   testing should be included in studies on the early neurotoxic effects of
   PCE.},
