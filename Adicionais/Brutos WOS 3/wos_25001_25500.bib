Title = {Comparative Assessment of the Environmental Impacts of Hydro-Electric,
   Nuclear and Wind Power Plants in China: Life Cycle Considerations.},
Booktitle = {CLEANER ENERGY FOR CLEANER CITIES},
Series = {Energy Procedia},
Year = {2018},
Volume = {152},
Pages = {1009-1014},
