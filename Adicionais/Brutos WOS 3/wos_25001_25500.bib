Editor = {Amin, M},
Title = {Integrative Law Enforcement about Tin Mining Reclamation Responsibility
   at Bangka Belitung Island},
Booktitle = {1ST SRIWIJAYA INTERNATIONAL CONFERENCE ON ENVIRONMENTAL ISSUES 2018 (1ST
   SRICOENV 2018)},
