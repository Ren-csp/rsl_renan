@inproceedings{ WOS:000664335304004,
Author = {Duan, Puhong and Ghamisi, Pedram and Jackisch, Robert and Kang, Xudong
   and Gloaguen, Richard and Li, Shutao},
Book-Group-Author = {IEEE},
Title = {INTRINSIC IMAGE DECOMPOSITION-BASED RESOLUTION ENHANCEMENT FOR MINERAL
   MAPPING},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
