@inproceedings{ WOS:001587166000007,
Author = {Adibfar, AmirHossein and Davani, Hassan},
Editor = {Ahmad, S and Struck, S and Drummond, C},
Title = {Improving Rainfall Forecasting in San Diego County: A Hybrid Machine
   Learning and Bias-Correction Downscaling Framework},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2025: COOL SOLUTIONS TO
   HOT TOPICS},
Year = {2025},
Pages = {62-69},
Note = {2025 World Environmental and Water Resources Congress, Anchorage, AK,
   MAY 18-21, 2025},
Abstract = {Downscaling climate data bridges the gap between coarse-resolution
   global climate models (GCMs) and finer-scale regional projections.
   Statistical downscaling, a popular technique, uses global climate data
   to achieve localized insights. This study evaluates machine learning
   algorithms for downscaling and bias correction, focusing on rainfall
   prediction in San Diego County. We incorporated data from the four
   nearest latitude and longitude points around gauges and combined it with
   local neighborhood precipitation data to improve granularity. A hybrid
   approach was proposed, integrating machine learning with bias correction
   to enhance the accuracy and reliability of downscaled precipitation
   data. Random forest and support vector regression were utilized for
   downscaling, while Linear regression, probability density function
   adjustment, and quantile mapping were applied for bias correction. Among
   these, the random forest with linear regression scheme performed best,
   demonstrating the potential of combining machine learning and
   statistical techniques to refine climate projections at regional and
   local scales.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
