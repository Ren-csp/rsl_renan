@inproceedings{ WOS:000257018300043,
Author = {Lin, Wenpeng and Shi, Runhe and Shi, Jing},
Editor = {Li, G and Jia, Z and Fu, Z},
Title = {Compared MODIS-NDVI with MODIS-EVI in forecast crop yield},
Booktitle = {2008 PROCEEDINGS OF INFORMATION TECHNOLOGY AND ENVIRONMENTAL SYSTEM
   SCIENCES: ITESS 2008, VOL 2},
Year = {2008},
Pages = {212-216},
Note = {International Conference on Informational Technology and Environmental
   System Science, Henan Polytechn Univ, Jiaozuo, PEOPLES R CHINA, MAY
   15-17, 2008},
Abstract = {Terra-MODIS has two vegetation indexes: NDVI and EVI. In order to
   compare the result assessed in crops with the two kinds of vegetation
   indices, MODIS NDVI and MODIS EVI were used to forecast yield of winter
   wheat in USA in this paper. The NDVI and EVI value and the yield for
   many years were carried on relevant analysis while using the specific
   breeding time of the regional crop and the one linear method was adopted
   to set up the regression equation to estimate the yield of that year.
   The result showed that the MODIS-EVI had obvious advantages over the
   MODIS. DVI. The regression equation's coefficient correlation was more
   than 0.7 by using the EVI, but the coefficient correlation was lower and
   varied greatly by using the NDVI. So the MODIS EVI was used to estimate
   yield of winter wheat in USA (for 18 states of winter wheat's main
   product). The yield estimation in 2004 was 52.9 bushel/acre and improved
   by 3.49\% compared with 2003. The production estimation in 2004 was
   1334675000 bushel and reduced by 12.92\% compared with 2003. For
   verifying its accuracy, we compared the estimation result with the
   statistic result of State Statistics Bureau of USA in 2004. It found
   that the yield estimation error was 5.56\% and the production error was
   -0.97\%. It is obvious that the MODIS-EVI can forecast crops yield more.
   effectively and can improve the accuracy predicted.},
