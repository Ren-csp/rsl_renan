@inproceedings{ WOS:000320995400026,
Author = {Cardoso, Catarina and Vilela, Joana and Parente, Natalia and Carnide,
   Filomena and Silva, Catarina and Cotrim, Teresa},
Editor = {Arezes, P and Baptista, JS and Barroso, MP and Carneiro, P and Cordeiro, P and Costa, N and Melo, R and Miguel, AS and Perestrelo, GP},
Title = {Ergonomic Analysis of Patient Handling Occupational Risk in a
   Neurotraumatology Ward},
Booktitle = {SHO2011: INTERNATIONAL SYMPOSIUM ON OCCUPATIONAL SAFETY AND HYGIENE},
Year = {2011},
Pages = {173-177},
Note = {7th International Symposium on Occupational Safety and Hygiene (SHO),
   Univ Minho, Sch Engn, Guimaraes, PORTUGAL, FEB 10-11, 2011},
Organization = {Portuguese Soc Occupat Safety \& Hlth},
Abstract = {The study aimed at understanding the relationship between the risk
   factors of musculoskeletal disorders (MSDs) at the wards and the
   workload arising from patient handling. In order to do the ergonomic
   analysis was characterized: the space and equipment used; the perception
   of nurses regarding the occupational risk in manual handling of patients
   and the occupational exposure of nurses to physical load factors. The
   results showed that the exposure levels are low but the risk must be
   considered. The risk factors identified were: inadequate free space to
   the patient transferences; difficulties in the manual articulation of
   the beds for patient repositioning; and the poor condition of the
   pavement of the main hall of the Service, which could constrain the
   safety of professionals and patients. It was recommended to improve the
   circulation space in the main hall and to repair the pavement of the
   main hall in order to make the circulation easy. Replacement of existing
   seats by others with appropriate conditions to sit and transfer patients
   was another recommendation, as the acquisition of new slings for
   Hydraulic Lift in order to encourage its use. Training was proposed
   aiming at improve the use of the mechanical aids. The redesign of
   workspaces can help to optimize the work and to increase comfort, safety
   and efficiency. The results of this study can contribute to the
   improvement of the work situation and it intends to help justify the
   investment in better work conditions.},
Publisher = {PORTUGUESE SOC OCCUPATIONAL SAFETY \& HYGIENE},
Address = {DPS-UNIVERSIDADE MINHO, GUIMARAES, 4800-058, PORTUGAL},
Type = {Proceedings Paper},
Language = {Portuguese},
ISBN = {978-972-99504-7-6},
