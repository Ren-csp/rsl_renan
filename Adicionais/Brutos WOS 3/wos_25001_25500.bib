@inproceedings{ WOS:000393042200009,
Author = {Bagirova, Anna and Shubat, Oksana},
Editor = {Bekirogullari, Z and Minas, MY and Thambusamy, RX},
Title = {USING MIXED METHODS RESEARCH TO STUDY REPRODUCTIVE BEHAVIOUR},
Booktitle = {ICCSBS 2017 - THE ANNUAL INTERNATIONAL CONFERENCE ON COGNITIVE - SOCIAL,
   AND BEHAVIOURAL SCIENCES},
