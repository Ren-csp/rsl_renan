@inproceedings{ WOS:000225380300041,
Author = {Lal, M and Pattison, H and Allan, T and Callender, R and Radley, S and
   Mann, C},
Editor = {Allen, IC and Alder, B and Pawson, M},
Title = {Severe psychological and social consequences of post-caesarean pelvic
   floor dysfunction in primiparae},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE OF PSYCHOSOMATIC
   OBSTETRICS AND GYNAECOLOGY},
Year = {2004},
Pages = {251-255},
Note = {14th International Conference of Psychosomatic Obstetrics and
   Gynaecology, Edinburgh, SCOTLAND, MAY 16-19, 2004},
Organization = {Int Soc Psychosomat Obstet \& Gynaecol},
Abstract = {This study investigates post-caesarean pelvic floor dysfunction in
   primiparae. It focuses on the mother's perception of her well-being in
   order to understand the meaning of her symptoms. Mothers were seen at
   home at 10 +/- 2 months postpartum using expanded medical interviewing.
   Participants were a 184 who underwent a caesarean (80 elective, 104
   emergency) and a 100 who had a non-instrumental vaginal delivery
   (comparison group). Post-caesarean (elective \& emergency) mothers
   suffering from stress incontinence (n=60), anal incontinence (n=94) and
   dyspareunia (n=50) showed a significant association with dysphoria
   including unrecognised depression and diagnosed depression, which was
   comparable to that following vaginal birth. A severe impact on social
   health affected the relationship with one's partner, resuming employment
   and leisure activities, bonding with child and planning further
   pregnancies.
   Aim: To estimate the psychosocial impact of post-caesarean pelvic floor
   dysfunction in primiparae.
   Materials and methods: The study received Ethical Approval from the
   Dudley Ethics Committee and all participants took part voluntarily after
   giving written informed consent. ML interviewed the participants using
   an adaptation of the standardised medical interviewing, which combined
   closed and open questioning. This innovative investigative technique was
   not only appropriate but also essential to investigate this little known
   subject. Childbearing and the postnatal period are associated with
   complex physical and emotional changes in the mother and postal surveys
   or a closed format would not have revealed the extent of the morbidity
   in relation to each pelvic floor symptom.},
