Title = {SEMANTICS OF WHITE COLOUR IN PHRASEOLOGICAL UNITS (IN RUSSIAN, ENGLISH
   AND GEORGIAN)},
Booktitle = {WUT 2018 - IX INTERNATIONAL CONFERENCE WORD, UTTERANCE, TEXT: COGNITIVE,
