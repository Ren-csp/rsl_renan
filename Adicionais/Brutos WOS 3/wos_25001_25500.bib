@article{ WOS:A1995RD99800006,
Author = {PRYKE, M and WHITEHEAD, C},
Title = {PRIVATE-SECTOR CRITERIA AND THE RADICAL CHANGE IN PROVISION OF SOCIAL
   HOUSING IN ENGLAND},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
Year = {1995},
Volume = {13},
Number = {2},
