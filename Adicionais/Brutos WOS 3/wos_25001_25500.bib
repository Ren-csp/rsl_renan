@article{ WOS:A1994PN14800038,
Author = {BOWLER, RM and MERGLER, D and HUEL, G and CONE, JE},
Title = {AFTERMATH OF A CHEMICAL SPILL - PSYCHOLOGICAL AND PHYSIOLOGICAL SEQUELAE},
