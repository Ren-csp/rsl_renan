Title = {VIOLENCE PREVENTION AMONG TEENS THROUGH SPORT ACTIVITIES},
Booktitle = {ICPESK 2017 - 7TH INTERNATIONAL CONGRESS ON PHYSICAL EDUCATION, SPORT
   AND KINETOTHERAPY},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2018},
