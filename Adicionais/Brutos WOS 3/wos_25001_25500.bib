@inproceedings{ WOS:001712828800018,
Author = {Xekalakis, Georgios and Anastasiou, Christos and Buegelmayer-Blaschek,
   Marianne and Lopez, Patricia Molina and Gamallo, Isabel and Toetzer,
   Tanja and Pavone, Venera and Kazamia, Evi and Leone, Mattia Federico and
   Christou, Petros and Havlik, Denis},
Editor = {Christofi, A and Hadjimitsis, DS and Michaelides, SC and Themistocleous, K and Danezis, C and Kyriakides, N and Papadavid, G and Ambrosia, V and Schwandner, F and Anayiotos, A and Gitas, I},
Title = {Building Climate Resilience in Mountain Regions},
Booktitle = {ELEVENTH INTERNATIONAL CONFERENCE ON REMOTE SENSING AND GEOINFORMATION
   OF THE ENVIRONMENT, RSCY2025},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13816},
Note = {11th International Conference on Remote Sensing and Geoinformation of
   the Environment-RSCy, Paphos, CYPRUS, MAR 17-19, 2025},
Organization = {ERATOSTHENES Centre of Excellence; Cyprus Remote Sensing Society},
Abstract = {Mountain regions are particularly vulnerable to climate change due to
   their complex topography, ecological sensitivity, and socio-economic
   marginalization. Despite their strategic role in biodiversity, water
   supply, and cultural heritage, mountain communities remain
   underrepresented in climate adaptation planning. This study examines
   climate resilience in the Troodos Geopark of Cyprus, a Mediterranean
   mountain region experiencing increasing pressures from extreme weather,
   biodiversity loss, and rural depopulation. Although multiple resilience
   frameworks exist, few have been systematically applied in mountain
   contexts with localized, stakeholder-driven data. To address this gap,
   the study integrates literature-based assessment with empirical data
   gathered through the ClimEmpower project, including two Community of
   Practice (CoP) workshops and structured questionnaires with local
   community leaders. The findings highlight agriculture, infrastructure,
   and tourism as the most climate-sensitive sectors, while institutional
   barriers- such as limited technical capacity, fragmented governance and
   inadequate public awareness- impede effective responses. Emergency
   preparedness was found to be particularly weak, with limited early
   warning systems, evacuation plans, or biodiversity monitoring in place.
   Participants prioritized capacity building, project management, and data
   accessibility as critical needs for local action. By aligning
   stakeholder insights with climate resilience indicators, the study
   reveals the importance of grounding adaptation strategies in lived
   realities and governance constraints. These results not only inform
   regional planning in Troodos but also offer transferable lessons for
   other mountain regions across Europe where localized knowledge and
   capacity gaps hinder climate adaptation. The approach underscores the
   need for participatory, indicator-informed resilience assessments in
   highland contexts.},
