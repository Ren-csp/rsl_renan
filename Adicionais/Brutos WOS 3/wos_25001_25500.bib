Title = {THE DIFFICULTIES OF PUBLIC OFFICERS IN CHARGE FOR ENFORCING
   ENVIRONMENTAL LAW},
Booktitle = {PSICOLOGIA JUDRIDICA Y FORENSE: INVESTIGACION-ACCION},
