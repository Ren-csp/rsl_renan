Title = {INTEGRATION OF PHYSICALLY CHALLENGED STUDENTS IN THE MODERN HIGHER
   EDUCATION SYSTEM},
Booktitle = {PROFESSIONAL CULTURE OF THE SPECIALIST OF THE FUTURE \& COMMUNICATIVE
