@inproceedings{ WOS:000270495700035,
Author = {Wicher, Dieter and Schaefer, Ronny and Bauernfeind, Rene and Stensmyr,
   Marcus C. and Heller, Regine and Heinemann, Stefan H. and Hansson, Bill
   S.},
Editor = {Finger, TE},
Title = {dOr83b-Receptor or Ion Channel?},
Booktitle = {INTERNATIONAL SYMPOSIUM ON OLFACTION AND TASTE},
