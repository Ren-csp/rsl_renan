@article{ WOS:A1994MW04500004,
Author = {BORRI, D and CONTE, E and PACE, F and SELICATO, F},
Title = {NORM - AN EXPERT-SYSTEM FOR DEVELOPMENT CONTROL IN UNDERDEVELOPED
   OPERATIONAL CONTEXTS},
