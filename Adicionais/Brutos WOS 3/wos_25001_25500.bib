Title = {PECULIARITIES OF THE APPREHENSION OF ECONOMIC OFFENCES BY LEARNERS},
Booktitle = {ECCE 2018: VII INTERNATIONAL CONFERENCE EARLY CHILDHOOD CARE AND
   EDUCATION},
