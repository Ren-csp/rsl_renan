@inproceedings{ WOS:001544523700009,
Author = {Limon, Samantha and Ogata, Branden and Ogawa, Michael-Brian},
Editor = {Schmorrow, DD and Fidopiastis, CM},
Title = {Exploring the Impact of Digital Design on Augmented Cognition},
Booktitle = {AUGMENTED COGNITION, AC 2025, PT I},
