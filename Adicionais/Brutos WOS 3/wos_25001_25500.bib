@article{ WOS:A1994PX48000004,
Author = {BROWER, KJ and BLOW, FC and HILL, EM},
Title = {RISK-FACTORS FOR ANABOLIC-ANDROGENIC STEROID USE IN MEN},
Journal = {JOURNAL OF PSYCHIATRIC RESEARCH},
