@inproceedings{ WOS:000471098400007,
Author = {Adwek, George and Julius, Gane and Shen, Boxiong and Lan, Meichen and
   Cecilia, Kemunto M. and Yabo, Abel C.},
Book-Group-Author = {IOP},
Title = {Water hyacinth as a possible bioenergy resource: A case of Lake
   Victoria, Kenya},
Booktitle = {THIRD INTERNATIONAL CONFERENCE ON ENERGY ENGINEERING AND ENVIRONMENTAL
   PROTECTION},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2019},
