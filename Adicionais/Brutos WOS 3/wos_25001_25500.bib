@inproceedings{ WOS:000426869900006,
Author = {Chapman, Robert and Likhanov, Maxim and Selita, Fatos and Zakharov, Ilya
   and Smith-Woolley, Emily and Kovas, Yulia},
Editor = {Malykh, SB and Nikulchev, EV},
Title = {GENETIC LITERACY AND ATTITUDES SURVEY (IGLAS): INTERNATIONAL
   POPULATION-WIDE ASSESSMENT INSTRUMENT},
Booktitle = {ICPE 2017: INTERNATIONAL CONFERENCE ON PSYCHOLOGY AND EDUCATION},
