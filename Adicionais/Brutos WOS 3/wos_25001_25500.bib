@article{ WOS:000279238400032,
Author = {Goni, Joaquin and Martincorena, Inigo and Corominas-Murtra, Bernat and
   Arrondo, Gonzalo and Ardanza-Trevijano, Sergio and Villoslada, Pablo},
Title = {SWITCHER-RANDOM-WALKS: A COGNITIVE-INSPIRED MECHANISM FOR NETWORK
   EXPLORATION},
Journal = {INTERNATIONAL JOURNAL OF BIFURCATION AND CHAOS},
Year = {2010},
Volume = {20},
