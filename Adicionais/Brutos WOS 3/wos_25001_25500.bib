Title = {RETRACTED: The Present Development and Countermeasures of Environmental
   Emergency in China (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
Series = {Energy Procedia},
Year = {2011},
Volume = {11},
Pages = {3091-3096},
Note = {International Conference on Energy and Environmental Science (ICEES),
   Singapore, SINGAPORE, OCT, 2011},
Organization = {Singapore Inst Elect (SIE)},
Abstract = {This paper reviews the present development of environmental emergency in
   China that involves legislative framework, regulations and technical
   support system. Through the analysis of actual case, these deficiencies
   and problems existing in action of environmental emergency are pointed
   out. In the countermeasures, the punishment and fine ceiling for
   environmental violations should be raised by revising clauses, and fees
   about handling, inspection, restoring and compensation for pollution
   incidents should be put into the law system, and environmental
   protection departments should be the leadership to improve emergency
   response efficiency, and the technical support system should be
   established to build a series of technical guidelines, norms and work
   manuals around three procedures that include prevention and monitoring
   before incident, response and handling in incident and assessment and
   restore after incident. (C) 2011 Published by Elsevier Ltd. Selection
   and/or peer-review under responsibility of the Organizers of 2011
   International Conference on Energy and Environmental Science.},
