@inproceedings{ WOS:000185615100023,
Author = {Wier, M and Birr-Pedersen, K and Jacobsen, HK and Klok, J},
Editor = {Tiezzi, E and Brebbia, CA and Uso, JL},
Title = {Environmental taxation and distributional consequences},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
