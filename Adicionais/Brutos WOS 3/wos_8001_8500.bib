Author = {Rinasti, A. N. and Sakti, A. D. and Agustina, E. and Wikantika, K.},
Editor = {Geurs, K and Samat, N and Pradono and Syabri, I and Andani, IGA},
Title = {Developing data approaches for accumulation of plastic waste modelling
   using environment and socio-economic data product},
Booktitle = {5TH PLANOCOSMO INTERNATIONAL CONFERENCE INFRASTRUCTURE FOR ALL: SMART,
   INNOVATIVE, AND INCLUSIVE},
