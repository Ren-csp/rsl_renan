Pages = {771-775},
Note = {10th International Congress on Senology - Breast Diseases of the
   Senologic-International-Society, OPORTO, PORTUGAL, MAY 31-JUN 04, 1998},
Organization = {Senol Int Soc},
Abstract = {The symbolic nature of the breasts plays a major role with regard to
   women's feelings of femininity and attractiveness. A comparative
   evaluation of the perceptions and attitudes of elective cosmetic and
   oncology breast surgery patients, towards changes in their body-images,
   identity, clothing behaviour, private and public self-consciousness,
   personality and anxiety levels was conducted. Six questionnaires
   measured the selected variables for Reduction Mammaplasty (n=12),
   Augmentation Mammaplasty(n=7); Breast Reconstruction, Mastectomy and
   Lumpectomy. Notable differences in biopsychosocial functioning were
   evident pre-/post-operatively. These differences were illustrative of
   the needs people have to feel socially equal and acceptable. Positive
   perceptions of physical appearance enhance the person's quality of life
   and coping mechanism.},
