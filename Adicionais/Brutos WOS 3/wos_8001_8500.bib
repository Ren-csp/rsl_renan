@article{ WOS:000171603400009,
Author = {Bloom, FR},
Title = {``New beginnings{''}: A case study in gay men's changing perceptions of
   quality of life during the course of HIV infection},
Journal = {MEDICAL ANTHROPOLOGY QUARTERLY},
Year = {2001},
Volume = {15},
Number = {1},
Pages = {38-57},
