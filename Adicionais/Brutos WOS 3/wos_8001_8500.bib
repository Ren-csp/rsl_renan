   London, ENGLAND, SEP 04-06, 2013},
Organization = {Univ Teknologi MARA, FAPS, Ctr Environm Behav Studies},
Abstract = {This paper presents an on-going progress of a study on landscape
   elements in the context of culture. The study has sought to discover
   people's perception, experience and responses towards their surroundings
