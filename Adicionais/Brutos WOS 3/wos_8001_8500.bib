@inproceedings{ WOS:000247290100045,
Author = {Mendes, J. F. G. and Silva, L. T.},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Evaluating conflict zones of air pollution in a mid-sized city},
Booktitle = {Sustainable Development and Planning III, Vols 1 and 2},
