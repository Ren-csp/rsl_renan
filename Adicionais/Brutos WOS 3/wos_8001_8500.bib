Title = {Social and Economic Activity of the Elder Generation in Tomsk Region},
Booktitle = {III INTERNATIONAL SCIENTIFIC SYMPOSIUM ON LIFELONG WELLBEING IN THE
   WORLD (WELLSO 2016)},
