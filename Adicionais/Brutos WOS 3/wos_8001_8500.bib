   Modenesi, P. and Monaci, F. and Pittao, E. and Tretiach, M. and
   Bargagli, R.},
Title = {Lichen and moss bags as monitoring devices in urban areas. Part II:
   Trace element content in living and dead biomonitors and comparison with
   synthetic materials},
Journal = {ENVIRONMENTAL POLLUTION},
Year = {2007},
Volume = {146},
