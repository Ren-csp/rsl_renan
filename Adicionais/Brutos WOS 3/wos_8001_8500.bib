@article{ WOS:000269759300008,
Author = {Brewer, Patricia and Moore, Tom},
Title = {Source Contributions to Visibility Impairment in the Southeastern and
   Western United States},
Journal = {JOURNAL OF THE AIR \& WASTE MANAGEMENT ASSOCIATION},
Year = {2009},
Volume = {59},
Number = {9},
Pages = {1070-1081},
