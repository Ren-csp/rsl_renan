@inproceedings{ WOS:000226303300021,
Author = {Salvador, MC and Moeri, EN},
Editor = {Donati, A and Rossi, C and Brebbia, CA},
Title = {Redevelopment of an urban industrial site in Sao Paulo, Brazil, during
   the process of in-situ remediation},
Booktitle = {BROWNFIELD SITES II : ASSESSMENT, REHABILITATION AND DEVELOPMENT},
Year = {2004},
Pages = {211-218},
Note = {2nd International Conference on Prevention, Assessment, Rehabilitation
   and Development of Brownfield Sites, Siena, ITALY, JUN 14-16, 2004},
Organization = {Wessex Inst Technol; Univ Siena; Univ Orleans, Ctr Brownfield Initiat},
Abstract = {A former industrial area, used for the temporary, non-covered storage of
   chlorinated organic solvents, has been subject to a hydrogeological
   investigation and assessment, in order to evaluate the relevance of the
   existing contamination in the soil and groundwater.
   The local water table is shallow (similar to2m deep), and the
   sedimentary upper aquifer presents clayey to silty composition and low
   to very low hydraulic conductivity of less than similar to10(-5) cm/s.
   The primary contaminants are chlorinated hydrocarbons (1,2-DCA) and
   aromatic hydrocarbons (BTEX), with local occurrence of LNAPL. The
   contaminants have partially reached the deeper aquifer of igneous
   composition, which is locally used for industrial purposes. Based on the
   mathematical modeling, risk-based remedial actions were proposed and
   remediation goals were defined.
   After a pilot test, a full-scale Multiple Phase Extraction (MPE) system
   was installed in April/02. So far, more than 80\% of the contaminants
   have been removed from the soil and from the groundwater. The final
   clean-up goals should be reached within 2 years.
   The remediation system has been specifically designed not to interfere
   with the new land occupation (parking lot and service sector). The
   release of the site has been, permitted for new occupation by the
   responsible environmental agency, based on an assessment of the risk to
   human health.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
