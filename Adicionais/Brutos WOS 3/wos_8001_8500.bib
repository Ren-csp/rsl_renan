@inproceedings{ WOS:000085856900083,
Author = {Schneider, IE and Patterson, ME and Hammitt, WE},
Book-Group-Author = {SAF
   SAF},
Title = {Dealing with the reality of diverse forest users: Recreationists
   perception of, response to and management preferences for conflict},
Booktitle = {PROCEEDINGS OF THE 1996 SOCIETY OF AMERICAN FORESTERS CONVENTION:
   DIVERSE FORESTS, ABUNDANT OPPORTUNITIES, AND EVOLVING REALITIES},
Year = {1996},
Pages = {423-424},
Note = {1996 National Convention of the Society-of-American-Foresters,
   ALBUQUERQUE, NM, NOV 09-13, 1996},
Organization = {Soc Amer Foresters},
Abstract = {The purpose of this study was to qualitatively examine conflict among
   forest recreationists. Specifically, the objectives of this research
   were to (1) document sources of conflict among diverse forest
   recreationists, (2) identify recreationist response to conflict, and(3)
   explore recreationists thoughts on mitigating and minimizing future
   conflict occurrence. Focus groups served as the research vehicle for
   this 1994 study. Four different forest recreation user groups (hunters,
   hikers, bicyclists and equestrians) participated separately in one or
   two hour facilitated discussions centered on recreation conflict in a
   southeastern forest. Although the recreation groups typically are seen
   as diverse and unique, common themes emerged from their discussions on
   conflict and how it might be managed. Results suggest that similarities
   exist in perceptions both of the nature of existing conflicts and how
   efforts to manage and minimize the conflict should be directed.
   Additional management and research suggestions are presented.},
