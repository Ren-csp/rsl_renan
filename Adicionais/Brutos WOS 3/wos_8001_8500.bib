@inproceedings{ WOS:000085197300014,
Author = {Ericsson, E},
Editor = {Sucharov, LJ},
Title = {The relation between vehicular fuel consumption and exhaust emission and
   the characteristics of driving patterns},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {137-147},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {It is well known that the driving patterns, i.e. the speed profiles of
   vehicles affect the fuel consumption and exhaust emissions. In urban
   areas the driving patterns vary a great deal and several studies have
   been performed to create typical driving cycles for urban driving.
   However, the knowledge of those characteristics of driving patterns that
   cause increased environmental effects is limited. The aim of this study
   was to investigate which properties of an urban driving pattern that
   significantly affect the amount of exhaust emission and fuel
   consumption. 439 urban driving patterns from 5 different street types in
   the city of Lund were analysed in relation to the corresponding specific
   fuel consumption and exhaust emissions. The characteristics of the
   driving patterns were described within 26 parameters each of them
   measuring different properties in the driving patterns. Regression
   analysis was carried out and five driving pattern parameters that had
   significant effects on ail the dependent variables, i. e. fuel
   consumption and exhaust emission, were identified. The variability of
   the five driving pattern parameters over different street types,
   drivers, peak/off peak hours and gender of the driver is described
   referring to an earlier study.},
