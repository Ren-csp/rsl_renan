@inproceedings{ WOS:000271331200006,
Author = {Cotte, June and Ritchie, Robin},
Editor = {Menon, G and Rao, AR},
Title = {Advertisers' Theories of Consumers: Why Use Negative Emotions to Sell?},
Booktitle = {ADVANCES IN CONSUMER RESEARCH, VOL 32},
