Title = {THE TWO FORMS OF EMOTIONAL REGULATION: COGNITIVE REAPPRAISAL AND
   ESPRESSIVE SUPPRESSION. CORRELATION WITH THE PARTICULARITIES OF THE
   AGGRESSION IN YOUNG PEOPLE},
Booktitle = {PROSPECTING ADVANCED RESEARCH IN HEALTH, EDUCATION AND SOCIAL SCIENCES},
Year = {2011},
Pages = {185+},
Note = {4th International Conference on Modern Research in Psychology - Trends
   and Prospects, Sibiu, ROMANIA, JUN 03-05, 2011},
Abstract = {The aim of this study is to identify the correlations between the type
   of emotion regulation and aggression in the case of young people.
   Emotion Regulation Questionnaire - ERQ, (Gross \& John, 2003) was used
   to investigate the type of Emotional Control and Aggression
   Questionnaire - AQ, (Buss \& Perry, 1992), for the level and the type of
   aggression. The forms of aggression that we considered in this study
   are: Physical Aggression (PA), Verbal Aggression (VA), Anger (A) and
   Hostility (H). The preliminary analysis of data demonstrated, for the
   cognitive reappraisal group an significant increase of Physical and
   Verbal Aggression, in the case of low level of the reappraisal; for the
   expressive suppression group an important increase of Hostility and
   decrease of Physical Aggression, Verbal Aggression and Anger.},
