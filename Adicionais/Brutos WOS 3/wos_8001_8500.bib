Title = {Opinion leaders awareness and perception of prevention of
   mother-to-child transmission of HIV services in Ibadan, Nigeria},
Booktitle = {XV INTERNATIONAL AIDS CONFERENCE: SOCIAL AND ECONOMICAL ISSUES},
Year = {2004},
Pages = {411-415},
Note = {15th International AIDS Conference, Bangkok, THAILAND, JUL 11-17, 2004},
Abstract = {Introduction: Mother to child transmission of HIV is fast becoming an
   important route and the utilization of PMTCT services is largely
   dependent on awareness and perception of benefits.
   Materials and Methods: Twenty {[}12 (60\%) males and 8(40\%) females]
   purposively selected opinion leaders participated in the study. Data was
   collected using the qualitative method (in-depth interview).
   Results: Results showed that even though the awareness of HIV/ AIDS is
   high, the level of awareness and knowledge of mother to child
   transmission was low. Half (50.0\%) of the participants were aware of
   availability of PMTCT services and could mention where the services are
   rendered. However none was aware of anybody utilizing the services.
   Conclusion: Based on these findings there is need for strong advocacy,
   enlightenment and community mobilization for improved awareness and
   utilization of PMTCT services.},
