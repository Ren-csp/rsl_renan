Title = {The relations of parental acceptance-rejection, 3 X 2 academic
   achievement goals, social achievement goals, life satisfaction, and
   learning strategies for undergraduates in Hong Kong},
Booktitle = {APPLIED PSYCHOLOGY},
Year = {2016},
Pages = {239-267},
Note = {Asian Congress of Applied Psychology (ACAP), Singapore, SINGAPORE, MAY
   19-20, 2015},
Organization = {Univ Derby, Asias Leading Grad Sch, Aventis Sch Management; Singapore
   Univ Technol \& Design},
Abstract = {This study was conducted to examine the effects of parental acceptance
   and rejection on learning strategies and life satisfaction with
   mediating effects for goals orientations. The sample of the study
   consisted of 202 university students to complete 5 questionnaires.
   Designed questionnaires include parental acceptance-rejection
   questionnaires (PARQ), 3 X 2 achievement goals questionnaire, social
   achievement goal orientation questionnaire (SAGOS), motivated strategies
   for learning (MSLQ) and satisfaction with life scale (SWLS). Path
   analysis and structural equation modeling were conducted to analyze the
   data and investigate the relationships.
   The results revealed that parental warmth/affection are significantly
   related to social achievement goals, while social achievement goals are
   significantly related to learning strategies. There is an indirect
   effect of parental warmth/affection on learning strategies through
   social achievement goals. Although only parental warmth/affection was
   significantly correlated to social achievement goals and indirectly
   correlated with learning strategies, this study has put a step on
   parental acceptance-rejection with the goals orientation.},
