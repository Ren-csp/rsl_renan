@inproceedings{ WOS:000079630400084,
Author = {Saiki, J},
Editor = {Usui, S and Oori, T},
Title = {Binding with and without attention: A neural network model for
   computation of spatial relations in object perception},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {379-382},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {Perception of complex objects requires fast computation of spatial
   relations among parts. This study proposes a hypothesis that the
   computation of spatial relations contains two types of binding: binding
   without attention which subserves preattentive perceptual grouping, and
   binding with attention which accomplishes correspondence between parts
   and relative positions. A neural network model first groups parts by an
   oscillator network, detects a relation by bipole-like cells, and binds
   parts and their relative positions by its higher level components.
   Concurrent input to the bipole cell's two receptive fields signals the
   presence of the target relation. Bidirectional connections between
   position-sensitive and position-invariant cells, a gating signal from
   relation detectors, and a topdown signal form a correlation in the
   response strength which represents the part-relation binding. The
   interaction of bindings with and without attention can explain the
   phenomenon of object-based advantage in spatial relation computation, as
   the computer simulation shows.},
