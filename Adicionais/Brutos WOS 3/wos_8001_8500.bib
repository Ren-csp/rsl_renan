@inproceedings{ WOS:000082615300005,
Author = {Dickinson, F and Viga, MD and Argüelles, E and Góngora, A and Castillo,
   MT},
Editor = {Hens, L and Borden, RJ and Suzuki, S and Caravello, G},
Title = {Perception, opinion and attitude about communal participation in women
   from a rural Mexican community - Relevance for future work in human
   ecology},
Booktitle = {RESEARCH IN HUMAN ECOLOGY: AN INTERDISCIPLINARY OVERVIEW},
Year = {1998},
Pages = {79-108},
Note = {Symposium on the Occasion of the VII International Congress of Ecology
   (INTECOL), FLORENCE, ITALY, JUL 19-25, 1998},
Organization = {Soc Human Ecol; Japanese \& Italian Soc Human Ecol},
Abstract = {Knowledge of those factors which influence individual and group
   participation in activities for communal development (ACD) are important
   for promoting their involvement in the identification and solving of
   human ecological issues. In an effort to better understand the important
   role individual perceptions, opinions and attitudes toward participation
   play in actual participation, this study addresses the concept of
   participation among women in a rural Mexican community. To this end, two
   groups of thirty women aged 13 to 56 were studied between June and
   September 1997. One group consisted of those women who participate in
   ACD (PW) and the other of those who do not (NPW). Of the women in both
   groups, 75 percent are married, 37 percent completed elementary school,
   and 73 percent are housewives. In order to study their perceptions,
   opinions and attitudes regarding women's participation in ACD, three
   instruments were applied to each women: a semantic differential; a
   questionnaire; and a Likert scale. Mean value differences for the
   semantic differential and the Likert scale of PW and NPW were evaluated
   using the Student's t-test. These results show that PW perceived
   participation as `more rapid' (p= 0.010) than NPW; PW `disagree
   absolutely' that participation is detrimental to them (p= 0.03): that
   what they can learn through participation is insignificant (p= 0.009);
   and that it is useless for them to participate (p= 0.037). It is
   concluded that in order to promote the participation of women in ACD it
   should be emphasised that it is a worthwhile. dynamic activity with
   potential benefits such as the opportunity for continued learning.
   Finally, the relevance of these results for future human ecology work is
   analysed and discussed.},
