@inproceedings{ WOS:000780411100029,
Author = {Bossetta, Michael and Segesten, Anamaria Dutceac and Zimmerman, Chris
   and Bonacci, Duje},
Book-Group-Author = {ASSOC COMP MACHINERY},
Title = {Shouting at the Wall: Does Negativity Drive Ideological Cross-posting in
   Brexit Facebook Comments?},
Booktitle = {SMSOCIETY'18: PROCEEDINGS OF THE 9TH INTERNATIONAL CONFERENCE ON SOCIAL
   MEDIA AND SOCIETY},
Year = {2018},
Pages = {246-250},
Note = {9th International Conference on Social Media and Society (SMSociety),
   Copenhagen Business Sch, Ctr Business Data Analyt, Copenhagen, DENMARK,
   JUL 18-20, 2018},
Organization = {Ryerson Univ; Ted Rogers Sch Management; SocialMediaLab.ca},
Abstract = {Using a novel methodological approach to measure emotions in Facebook
   comments, this Work in Progress (WIP) paper explores the relationship
   between negative feelings and ideological cross-posting behavior. Using
   the VoxPopuli data harvester, we collect over 770,000 public Facebook
   comments(1) from the three major political campaign pages active during
   the Brexit referendum. After sorting users into ideological camps based
   on their reactions to campaign posts, we then examine their commenting
   patterns across ideological lines. Using three different methods of
   sentiment analysis, we identify negative and positive emotions and their
   fine-grained sub-categories in comments. The analysis reveals one
   quarter of all comments are cross-ideological posts, with Leave
   supporters overwhelmingly active in commenting on Remain posts. A
   comparison across the campaigns shows that Brexiteers are much more
   likely to express anger than Remainers.},
