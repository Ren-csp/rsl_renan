@article{ WOS:000228986800030,
Author = {Smeets, MAM and Dalton, PH},
Title = {Evaluating the human response to chemicals: odor, irritation and
   non-sensory factors},
Journal = {ENVIRONMENTAL TOXICOLOGY AND PHARMACOLOGY},
Year = {2005},
