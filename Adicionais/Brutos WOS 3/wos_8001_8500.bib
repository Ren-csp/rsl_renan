Year = {2005},
Volume = {145},
Number = {1},
Pages = {19-33},
Month = {FEB},
Note = {Annual Meeting of the American-Educational-Research-Association,
   SEATTLE, WA, APR 10-14, 2001},
Organization = {Amer Educ Res Assoc},
Abstract = {The author investigated the differences between Jewish Israeli and Arab
   Israeli teachers in their satisfaction with their work. Initially, the
   goal of the present study was to investigate whether there were
   demographic attributes (such as age, gender, and education) that
   differentiated between the two groups of teachers. Later, the author
   added two variables, teachers' perceptions of their occupation and
   teachers' perceptions of their principals' leadership styles, to the
   analysis to examine their contribution to the level of satisfaction for
   each group. Regression analyses revealed the significant power of the
   two added variables in predicting teacher satisfaction among both Jewish
   and Arab Israeli teachers. The author discussed implications of the
   findings in relation to principals' roles and teachers' perceptions.},
