Author = {Lu, Jun and Li, Chun Die and Wang, Liang and Chen, Yu Lu and Zhang, Xin
   Hui},
Editor = {Li, H and Xu, QJ and Zhang, D},
Title = {Analyzing the factors and variables of heat island effect in
   comprehensive high-rise residential quarter of mountain city},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND ENGINEERING (ICEESD2011), PTS 1-5},
Series = {Advanced Materials Research},
Year = {2012},
Volume = {356-360},
Number = {1-5},
