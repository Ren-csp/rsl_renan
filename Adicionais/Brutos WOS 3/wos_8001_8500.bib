@article{ WOS:000350647100002,
Author = {Koessl, Manfred and Hechavarria, Julio and Voss, Cornelia and Schaefer,
   Markus and Vater, Marianne},
Title = {Bat auditory cortex - model for general mammalian auditory computation
   or special design solution for active time perception?},
Journal = {EUROPEAN JOURNAL OF NEUROSCIENCE},
Year = {2015},
Volume = {41},
Number = {5, SI},
Pages = {518-532},
Month = {MAR},
Note = {5th International Conference Auditory Cortex, Leibniz Inst Neurobiol,
   Magdeburg, GERMANY, SEP 13-17, 2014},
Organization = {Deutsch Forsch Gemeinschaft; Off Naval Res Global; Magdeburg Ctr Behav
   Brain Sci; Leibniz Inst Neurobiol},
Abstract = {Audition in bats serves passive orientation, alerting functions and
   communication as it does in other vertebrates. In addition, bats have
   evolved echolocation for orientation and prey detection and capture.
   This put a selective pressure on the auditory system in regard to
   echolocation-relevant temporal computation and frequency analysis. The
   present review attempts to evaluate in which respect the processing
   modules of bat auditory cortex (AC) are a model for typical mammalian AC
   function or are designed for echolocation-unique purposes. We conclude
   that, while cortical area arrangement and cortical frequency processing
   does not deviate greatly from that of other mammals, the echo delay
   time-sensitive dorsal cortex regions contain special designs for very
   powerful time perception. Different bat species have either a unique
   chronotopic cortex topography or a distributed salt-and-pepper
   representation of echo delay. The two designs seem to enable similar
   behavioural performance.},
