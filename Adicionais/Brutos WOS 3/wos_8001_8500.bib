@article{ WOS:000086955400006,
Author = {Wilton, MMM and Craig, WM and Pepler, DJ},
Title = {Emotional regulation and display in classroom victims of bullying:
   Characteristic expressions of affect, coping styles and relevant
   contextual factors},
Journal = {SOCIAL DEVELOPMENT},
Year = {2000},
