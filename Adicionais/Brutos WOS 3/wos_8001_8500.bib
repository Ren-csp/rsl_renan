Title = {Challenges for brownfield regeneration: a comparison of English and
   Japanese approaches},
Booktitle = {BROWNFIELD SITES IV: PREVENTION, ASSESSMENT, REHABILITATION AND
   DEVELOPMENT OF BROWNFIELD SITES},
