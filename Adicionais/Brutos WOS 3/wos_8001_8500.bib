Title = {Land use/land cover change detection in an urban watershed: a case study
   of upper Citarum Watershed, West Java Province, Indonesia},
Booktitle = {2ND INTERNATIONAL SYMPOSIUM ON LAPAN-IPB SATELLITE (LISAT) FOR FOOD
   SECURITY AND ENVIRONMENTAL MONITORING},
