@inproceedings{ WOS:000079630400298,
Author = {Fujita, M and Hoshi, K and Seita, T},
Editor = {Usui, S and Oori, T},
Title = {Asymmetry in deviation of rapid-targeting eye movement under the
   sensation of visually induced illusory self-motion},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {1303-1306},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {Human motion sensation is generally degraded during self-motion. By
   measuring the amplitudes of saccades to acquire a briefly flashed
   peripheral target, we investigated such degradation of the object-motion
   sensation during the visually induced self-motion sensation
   (circularvection, CV).
   The saccades made in the same direction as the CV were normometric but
   those in the opposite direction were hypometric with about 12\%
   reduction in amplitude. Introduction of a 20-sec interval for a subject
   to remain in the dark from the sensation of CV to the onset of a saccade
   test trial almost extinguished such skewness of the metric distribution.
   When a subject made saccades to a flashed target in the dark sitting on
   a rotating chair, there was no direction-dependent dismetria. Therefore
   the hypometria in the direction opposite to the CV depends on the
   visually induced self-rotation sensation. Whether this hypometria has
   its origin in the spatial perception or exclusively in the motor
   performance remained unresolved.},
