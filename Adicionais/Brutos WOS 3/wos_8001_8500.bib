@inproceedings{ WOS:000074052200008,
Author = {Lopes, TJ and Furlong, ET and Pritt, JW},
Editor = {Little, EE and Greenberg, BM and DeLonay, AJ},
Title = {Occurrence and distribution of semivolatile organic compounds in stream
   bed sediments, United States, 1992-95},
Booktitle = {ENVIRONMENTAL TOXICOLOGY AND RISK ASSESSMENT: SEVENTH VOLUME},
Series = {AMERICAN SOCIETY FOR TESTING AND MATERIALS SPECIAL TECHNICAL PUBLICATION},
Year = {1998},
