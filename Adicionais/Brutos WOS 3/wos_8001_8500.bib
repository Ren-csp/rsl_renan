Number = {1-6},
Pages = {508-516},
Note = {5th Workshop on Harmonization within Atmospheric Dispersion Modelling
   for Regulatory Purposes, RHODES, GREECE, MAY 18-AUG 21, 1998},
Organization = {Natl Ctr Sci Res Demokritos},
Abstract = {A numerical simulation of the traffic pollutant transport diffusion
   within one busy street of Nantes city centre has been realized for a
   real-time duration of 24 hours, with a time step of 20 ms, in low wind,
   sunny conditions. It has been generated with the urban canopy model
   CHENSI, which includes sub-models of thermal buoyancy, traffic emission
   rates, car induced turbulence. A number of frames of the simulation film
   are selected to illustrate the mechanism and the influence of the
   coupling between dynamic and thermal convections upon the flow regimes,
   the street ventilation, the distribution of the pollutant concentrations
   and the pollutant residence times.},
