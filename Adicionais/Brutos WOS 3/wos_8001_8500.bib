@inproceedings{ WOS:000482722700016,
Author = {Angelaki, Dora E.},
Editor = {Bargmann, C and Bavelier, D and Sejnowski, T and Stewart, D and Stillman, B},
Title = {How Optic Flow and Inertial Cues Improve Motion Perception},
Booktitle = {COGNITION, VOL 79, 2014},
Series = {Cold Spring Harbor Symposia on Quantitative Biology},
Year = {2014},
Volume = {79},
Pages = {141-148},
Note = {79th Cold Spring Harbor Symposium on Quantitative Biology, Cold Spring
   Harbor, NY, MAY 28-JUN 02, 2014},
Organization = {Forest Labs; Swartz Fdn; Agilent Technologies; Bristol Myers Squibb Co;
   Genentech; Thermo Fisher Sci, Life Technologies; New England BioLabs;
   Monsanto Co; DuPont Pioneer Hi Bred Int; HudsonAlpha Inst Biotechnol},
Abstract = {Estimating our egocentric heading direction is an important component of
   navigation. Recent studies have explored how inertial cues from the
   vestibular system and optic flow signals from the visual system interact
   to improve perceptual precision and accuracy. Heading precision is
   improved through multisensory integration, whereas heading accuracy is
   maintained through multisensory calibration mechanisms. Neural
   correlates of these behaviors are found in a large interconnected
   cortical network, although the specific contributions of each area
   remain to be explored. Whether and how this multisensory self-motion
   cortical circuit contributes to navigation and how egocentric heading
   signals interact with the allocentric representations for foraging and
   exploration also remain challenges for the future.},
