@article{ WOS:000239909600003,
Author = {Zilbovicius, Monica and Meresse, Isabelle and Chabane, Nadia and
   Brunelle, Francis and Samson, Yves and Boddaert, Nathalie},
Title = {Autism, the superior temporal sulcus and social perception},
Journal = {TRENDS IN NEUROSCIENCES},
