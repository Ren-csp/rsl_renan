@inproceedings{ WOS:000560708000112,
Author = {Parszuto, Katarzyna and Tandyrak, Renata and Augustyniak, Renata and
   Grochowska, Jolanta and Lopata, Michal and Plachta, Anna and Neugebauer,
   Maciej},
Book-Group-Author = {IOP},
Title = {Optical Properties of Dissolved Organic Matter in Urban Fountains},
Booktitle = {WORLD MULTIDISCIPLINARY EARTH SCIENCES SYMPOSIUM (WMESS 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2019},
