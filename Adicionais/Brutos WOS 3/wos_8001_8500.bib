@inproceedings{ WOS:000224368900012,
Author = {Kidd, JL and Brascamp, W},
Editor = {Relf, D},
Title = {Benefits of gardening to the well-being of New Zealand gardeners},
Booktitle = {EXPANDING ROLES FOR HORTICULTURE IN IMPROVING HUMAN WELL-BEING AND LIFE
   QUALITY},
Series = {Acta Horticulturae},
Year = {2004},
