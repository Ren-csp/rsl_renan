Title = {Psycho-oncological and psycho-social aspects of physical appearance and
   clothing behaviour: a comparison of three breast cancer and elective
   cosmetic breast surgery patients},
Booktitle = {10TH INTERNATIONAL CONGRESS ON SENOLOGY - BREAST DISEASES OF THE
   SENOLOGIC INTERNATIONAL SOCIETY},
