@article{ WOS:000235867800006,
Author = {Chou, WC and Tinetti, ME and King, MB and Irwin, K and Fortinsky, RH},
Title = {Perceptions of physicians on the barriers and facilitators to
   integrating fall risk evaluation and management into practice},
Journal = {JOURNAL OF GENERAL INTERNAL MEDICINE},
