Title = {Determination of carboxyhemoglobin levels and health effects on officers
   working at the Istanbul bosphorus bridge},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCE AND HEALTH PART A-TOXIC/HAZARDOUS
   SUBSTANCES \& ENVIRONMENTAL ENGINEERING},
