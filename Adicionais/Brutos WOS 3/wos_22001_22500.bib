@inproceedings{ WOS:A1996BJ20B00632,
Author = {Bonneau, A},
Editor = {Bunnell, HT and Idsardi, W},
Title = {Identification of vowel features from French stop bursts},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {2506-2509},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {This paper deals with the perception of vowels from French stop bursts.
   The corpus was made up of 90 stimuli of 20-25 ms duration extracted from
   natural CVC and CV words. The syllables combined the initial stops
   /p,t,k/ with the vowels /i,a,u/. In order to cut off all traces of
   vocalic segment, bursts whose duration was too short were lengthened.
   Eight native speakers of French served as listeners in the experiment
   Results showed that a bunt onset which did not contain any traces of
   vocalic segment provided substantial vocalic information (the overall
   identification rate was 80\%). The vowel /i/ was clearly identified from
   /t/ and /k/, and the vowel /u/ very clearly identified from /k/. The
   vowel /a/, with high identification rate, was often chosen in the
   absence of a clear vocalic timbre.},
