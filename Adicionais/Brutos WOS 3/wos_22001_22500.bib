@inproceedings{ WOS:000392403800014,
Author = {Curci, G. and Ferrero, L. and Tuccella, P. and Angelini, F. and Barnaba,
   F. and Bolzacchini, E. and Facchini, M. C. and Gobbi, G. P. and Landi,
   T. C. and Perrone, M. G. and Sangiorgi, S. and Stocchi, P.},
Editor = {Steyn, D and Mathur, R},
Title = {On the Interplay Between Upper and Ground Levels Dynamics and Chemistry
   in Determining the Surface Aerosol Budget},
Booktitle = {AIR POLLUTION MODELING AND ITS APPLICATION XXIII},
Series = {Springer Proceedings in Complexity},
Year = {2014},
