@inproceedings{ WOS:000323984200180,
Author = {Ebrahimi, Soodabeh and Rahmani, M. Ali and Zarbakhsh, M. Reza},
Editor = {Uzunboylu, H and Demirok, M},
Title = {On the effectiveness of group cognitive-behavioral intervention of the
   spouses on the reversion prediction of the people in methadone therapy},
Booktitle = {3RD WORLD CONFERENCE ON PSYCHOLOGY, COUNSELING AND GUIDANCE, WCPCG-2012},
Series = {Procedia Social and Behavioral Sciences},
Year = {2013},
Volume = {84},
Pages = {939-943},
Note = {3rd World Conference on Psychology, Counselling and Guidance (WCPCG),
   Efes, TURKEY, MAY 09-12, 2012},
Abstract = {Problem setting: Lack of the necessary skills and unsuitable
   relationship between spouses, are concerned as factors of continuation
   in addiction. This research has been done in order to define the
   effectiveness of group cognitive-behavioral intervention of the spouses
   on the reversion prediction of the people in methadone therapy. Method:
   70 addicted people who had come to ``Omid Desertion Center{''} in
   Iran-lahijan, were studied by DASS21, and RPS standard measures and CRQ,
   WRQ, CRI, and AQ questionnaires in this research. Among these people, 30
   addicted subjects, who had the criterion for this study, were selected
   randomly and put into two groups of experimental and controlled group,
   each with 15 people. The experimental group was in an experiment of
   cognitive-behavioral intervention for 12 sessions of 90 minutes. At the
   end, both groups were assessed by the same mentioned questionnaires one
   more time months, they answered to the RPS standard measure. The data
   were analyzed by the co-variance (ANCOVA, MANCOVA) statistical method.
   The results: The results showed a significant difference between the two
   groups in reversion prediction of the people in theory and the
   management of stress, anger and worry, and coping skills (problem
   focused) and not significant in coping skills (emotion focused) and
   negotiation and solving the problems in their spouses. Conclusion: The
   results of the study show that group cognitive - behavioral intervention
   on the spouses is an effective method for reversion prediction of the
   people in methadone therapy. (C) 2013 The Authors. Published by Elsevier
   Ltd.},
