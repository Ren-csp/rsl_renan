@inproceedings{ WOS:001594525800109,
Author = {Yusufzai, Abdullah O. and Stephen, Haroon and Ahmad, Sajjad},
Editor = {Ahmad, S and Murray, R},
Title = {Review of Flash Flood Susceptibility Modeling Derived from Machine
   Learning Algorithms with Input Data from Remote Sensing Sources},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2023},
Year = {2023},
Pages = {1195-1206},
Note = {2023 World Environmental and Water Resources Congress, Henderson, NV,
   MAY 21-24, 2023},
Abstract = {Flash floods can have devastating effects on life and property. Flash
   flood susceptibility is a measurement of the likelihood at which flash
   floods can occur in an area based on the local terrain, geographical,
   hydrological, meteorological, and anthropogenic factors. There have been
   efforts to improve the overall state of flash flood susceptibility
   assessment through modeling methods. In this article, we present the
   current state of literature on flash flood susceptibility modeling
   (FFSM) derived from remote sensing sources and assembled through the
   utilization of machine learning algorithms. The approach is based on a
   literature review consisting of an analysis of 26 peer-reviewed articles
   searched using the keywords remote sensing, flash flood, susceptibility,
   detection, potential, prediction, forecast, deep learning, machine
   learning, and artificial intelligence. Examples of ML algorithms include
   random forest and extreme gradient boosting. RS sources include
   satellite and aerial imagery. This review shows that FFSM derived
   through ML algorithms is accurate and reliable in determining
   susceptibility to flash flooding. Through a combination of multiple ML
   algorithms, a higher accuracy and reliability of FFSM can be observed.
   Common conditioning factors for model development involve relief slope,
   elevation, and basin size. Flash flood susceptibility modeling can be
   performed for any study area, causing it to be an effective tool in
   mitigating the effects of flash flooding. It is possible to augment
   current flash flood warning systems with the use of flash flood
   susceptibility modeling derived from machine learning algorithms with
   input data from remote sensing sources. This can aid future development
   or awareness of flooding hazards for urban areas.},
