@article{ WOS:000431770900215,
Author = {Muhlisin, A. and Pratiwi, Arum and Nurambarwati, Winarsih},
Title = {Cognitive Therapy Model to Control the Blood Sugar Level for Diabetic
   Patients in a Community},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {12},
Pages = {12599-12602},
Month = {DEC},
Note = {1st International Joint Conference on Science and Technology (IJCST),
   Bali, INDONESIA, OCT 12-13, 2016},
Organization = {Univ Pembangunan Nas Veteran Jawa Timur, Fac Ind Technol; Bali State
   Polytechn; Natl Cheng Kung Univ; Univ Negeri Surabaya, Fac Social Sci \&
   Law; Univ Negeri Surabaya, Fac Math \& Nat Sci; Univ Trunojoyo Madura,
   Fac Engn},
Abstract = {Diabetes is one of chronic disease that requires comprehensive and
   sustained therapy to control stable of blood sugar. This study aims to
   find a cognitive therapy model for Diabetes patients in the community,
   to maintaining self-care and as one of way of self-control. The number
   of participants in this study was 20 patients that have been diagnosed
   Diabetes more than 5 years, aged 45 to 65 years old and literate. Data
   analysis in this research used stages of action research that comprised
   of diagnosing, action planning, action taking, and evaluating. Another
   analysis was the paired t test to compare the blood sugar level of
   diabetic patients. The results of the study showed that at the
   diagnostic stage identified that the majority of factor cause of relapse
   was emotion and food. Then, action planning stage was preparation of a
   cognitive card based on identification in the previous stage. The cards
   called the do and don'ts of memory card. After that, action taking
   stage, guided how to use the card for diabetic patients. Next, is the
   evaluating stage, the researchers found the advantages and disadvantages
   of the implementation the cognitive therapy model and proved that there
   was difference the level blood sugar between before and after cognitive
   therapy with paired t scores of 7,143 and P value of 0.001. This study
   concludes that cognitive therapy for diabetic patients may, influence of
   blood sugar level and psycho-education process in a group of Diabetic
   patients in the community can prevent the diabetic recurrence.},
