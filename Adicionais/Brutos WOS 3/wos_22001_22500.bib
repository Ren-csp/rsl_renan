Number = {2},
Pages = {199-214},
Note = {Conference in Binocular Stereopsis and Optic Flow, TORONTO, CANADA, JUN
   22-26, 1993},
Abstract = {Surface shape is visually derived from multiple sources of
   three-dimensional (3-D) information. The apparent unity of the percept
   creates an assumption that there are perceptual processes that resolve
   and combine the different channels of information within some common 3-D
   representation. However, integration by the explicit conversion of the
   information from different sources into a common representation is
   computationally difficult and unnecessary. An alternative, integration
   by association, is discussed and related to a variety of experimental
   results on 3-D-cue conflict.},
