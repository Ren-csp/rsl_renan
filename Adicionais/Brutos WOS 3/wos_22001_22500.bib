@inproceedings{ WOS:000345152700009,
Author = {Hoerl, Christoph},
Editor = {Rickles, D and Kon, M},
Title = {Time and the domain of consciousness},
Booktitle = {FLOW OF TIME},
Series = {Annals of the New York Academy of Sciences},
Year = {2014},
Volume = {1326},
Pages = {90-96},
Note = {Conference on Do We Need a Physics of Passage?, Cape Town, SOUTH AFRICA,
   DEC 10-14, 2012},
Organization = {John Templeton Fdn},
Abstract = {It is often thought that there is little that seems more obvious from
   experience than that time objectively passes, and that time is, in this
   respect, quite unlike space. Yet nothing in the physical picture of the
   world seems to correspond to the idea of such an objective passage of
   time. In this paper, I discuss some attempts to explain this apparent
   conflict between appearance and reality. I argue that existing attempts
   to explain the conflict as the result of a perceptual illusion fail, and
   that it is, in fact, the nature of memory, rather than perception, that
   explains why we are inclined to think of time as passing. I also offer a
   diagnosis as to why philosophers have sometimes been tempted to think
   that an objective passage of time seems to figure directly in perceptual
   experience, even though it does not.},
Publisher = {BLACKWELL SCIENCE PUBL},
