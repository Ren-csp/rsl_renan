Year = {2011},
Pages = {215-224},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {The current study analysed the communication process about adoption,
   bearing in mind the multitude of factors that feature this process,
   namely, the child's ability to understand the concept of adoption. It
   equally examined the communication impact on the psychological
   adjustment of adoptees.
   Fifty-eight children and their parents participated in this study. The
   instruments used for data gathering included the Interview to Children
   and Adolescents about Adoption, the Self Perception Profile for Children
   and for Adolescents, the Parents' Interview about the Adoption Process
   and the Strengths and Difficulties Questionnaire.
   The results of this study allow us to characterize the way adopted
   children understand the concept of adoption, at different ages; to
   describe the communication process about adoption, and to distinguish
   three types of adoptive families. Findings confirm the impact of
   communication openness on the psychological adjustment of adoptees.},
