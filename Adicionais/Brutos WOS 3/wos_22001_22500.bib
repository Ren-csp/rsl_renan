@inproceedings{ WOS:000268884400023,
Author = {Perez, D. and Espinosa, F. and Mazo, M. and Jimenez, J. A. and Santiso,
   E. and Gardel, A. and Wefky, A. M.},
Editor = {Brebbia, CA and Popov, V},
Title = {Electronic application to evaluate the driver's activity on the
   polluting emissions of road traffic},
Booktitle = {AIR POLLUTION XVII},
