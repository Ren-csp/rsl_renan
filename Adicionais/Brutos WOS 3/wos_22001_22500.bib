Year = {2013},
Pages = {301-304},
Note = {International Congress on Science and Technology for the Conservation of
   Cultural Heritage, Santiago de Compostela, SPAIN, OCT 02-05, 2012},
Organization = {Univ Santiago de Compostela},
Abstract = {Since the mid-twentieth century many artists have used cementitious
   materials in their projects. Currently, some of these works show
   evidence of decohesion which requires an adapted response to each case.
   This paper analyzed the behavior of two consolidants, tetraethyl
   orthosilicate (Estel 1000 (R)) alone and blended with Ca(OH)(2)
   nanoparticles (Nanorestore (R)), on Portland cement mortars, following
   international recommendations for cultural interventions. The results
   obtained show that these products reduce significantly the hydric
   properties of the material and increase its mechanical strength. The
   color and gloss variations generated by the action of these treatments
   are near or below the limits of human perception. The interaction
   between the products and the cement resulted in the formation of a new
   C-S-H gel, with a longer chain length. Portlandite record is reduced
   with both products.},
