@article{ WOS:000174313200005,
Author = {Thompson, LF and Coovert, MD},
Title = {Stepping up to the challenge: A critical examination of face-to-face and
   computer-mediated team decision making},
Journal = {GROUP DYNAMICS-THEORY RESEARCH AND PRACTICE},
Year = {2002},
