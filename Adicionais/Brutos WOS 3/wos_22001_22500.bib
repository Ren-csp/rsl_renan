@article{ WOS:000177327300008,
Author = {Leroi, I and O'Hearn, E and Marsh, L and Lyketsos, CG and Rosenblatt, A
   and Ross, CA and Brandt, J and Margolis, RL},
Title = {Psychopathology in patients with degenerative cerebellar diseases: A
   comparison to Huntington's disease},
Journal = {AMERICAN JOURNAL OF PSYCHIATRY},
Year = {2002},
Volume = {159},
