@article{ WOS:000278583700014,
Author = {Perkins, Rodney and Fay, Jonathan P. and Rucker, Paul and Rosen, Micha
   and Olson, Lisa and Puria, Sunil},
Title = {The EarLens system: New sound transduction methods},
Journal = {HEARING RESEARCH},
Year = {2010},
