Title = {Dynamic Hybrid Life Cycle Assessment of CO2 Emissions of a
   Typical Biogas project},
Booktitle = {CLEAN ENERGY FOR CLEAN CITY: CUE 2016 - APPLIED ENERGY SYMPOSIUM AND
   FORUM: LOW-CARBON CITIES AND URBAN ENERGY SYSTEMS},
