@article{ WOS:000509558500004,
Author = {Yang, Fan and Liang, Dongfang and Wu, Xuefei and Xiao, Yang},
Title = {On the application of the depth-averaged random walk method to solute
   transport simulations},
Journal = {JOURNAL OF HYDROINFORMATICS},
Year = {2020},
Volume = {22},
