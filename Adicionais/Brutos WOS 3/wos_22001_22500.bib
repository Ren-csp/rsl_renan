Note = {15th Conference on Creativity and Cognition (C and C), ELECTR NETWORK,
   JUN 19-21, 2023},
Organization = {Assoc Comp Machinery; ACM SIGCHI},
Abstract = {This paper aims to present a specific interactive agent whose design
   integrates form and movement. Therefore, the author's creative process
   is shown, whose research theme concerns the nature of the object
   represented. The focus of this study will be given to the interactive
   agent at the current stage of elaboration, in which movement is the
   basis of construction of form and gesture of being, in other words, its
   identification. It is also intended with this work to question to what
   extent the perception of life is associated with movement. In addition,
   we approach the idea of a future project that starts from the expansion
   of the current work, proposing a set of interactive agents that interact
   with each other and with other beings. It is intended with this
   research, to generate contributions especially to the fields of social
   robotics and interactive art.},
