Pages = {146-151},
Note = {3rd International Scientific Conference on Rural Development, Kaunas
   City, LITHUANIA, NOV 08-10, 2007},
Organization = {Lithuanian Univ Agr},
Abstract = {Globalization processes taking place in the agro-food sphere basically
   have to do with institutions of protectionism. The classification of
   institutions of protectionism proposed by the author comprises elements
   of the national, international and supranational law and economic
   integration mechanisms, as well as it implies perception of the country
   as an institutional unit on the mesolevel. The research includes
   development of an institutional framework for the public policy of
   protectionism and support with adjustment to current globalization
   trends.
   The analysis of the legal framework for the agro-food sphere revealed
   that the institutions of protectionism are not sufficiently adequate to
   the interests of the national economy in respect of matching the food
   commodity producers protection requirements.
   The author puts forth recommendations on how the institutional resource
   utilization efficiency can be improved to condition the public policy of
   protectionism and support.},
