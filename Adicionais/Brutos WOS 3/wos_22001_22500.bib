@inproceedings{ WOS:000074779500009,
Author = {Sokoloff, P and Griffon, N and Sautel, F and Levesque, D and Pilon, C
   and Schwartz, JC and Ridray, S and Diaz, J and Simon, P and Costentin, J
   and Mann, A and Wermuth, CG and Caine, SB and Parsons, LH and Koob, GF},
Editor = {Jenner, P and Demirdamar, R},
Title = {The dopamine D3 receptor:: From cloning to function},
Booktitle = {DOPAMINE RECEPTOR SUBTYPES: FROM BASIC SCIENCE TO CLINICAL APPLICATION},
Series = {BIOMEDICAL AND HEALTH RESEARCH},
Year = {1998},
Volume = {19},
Pages = {118-130},
Note = {Conference on Dopamine Receptor Sub-Types, ANTALYA, TURKEY, MAY 17-19,
   1996},
Abstract = {The D-3 receptor (D3R) is recognized with high affinity by all
   antipsychotics and selectively expressed in limbic brain areas
   participating in the control of emotions, motivation and reward. In
   transfected NG 108-15 cells, stimulation of the D3R inhibits cAMP
   formation and increases mitogenesis, which, in turn, is potentiated by
   activation of the cAMP cascade. This suggests that both opposite and
   synergistic interactions occur between the D3R and the cyclic AMP
   pathway, possibly underlying D1R/D3R interactions. In fact, D1R and D3R
   colocalize in the islands of Calleja, in which they interact in
   opposition on c-fos mRNA expression, and in the shell of nucleus
   accumbens, in which they interact in synergy on substance P mRNA
   expression. In addition, the functional model allowed to identify
   preferential agonists and antagonists, as well as partial agonists and
   reverse agonists.
   Implication of the D3R-expressing neurotensin neurons in reward is
   suggested by i) the positive effect of D3R stimulation on neurotensin
   gene expression, ii) the similar distributions of D3R and
   cocaine-activated neurotensin neurons, and iii) the correlation existing
   between the in vitro relative potencies of agonists at D3R and their
   relative potencies to reduce cocaine self-administration in rats. In
   addition, with the stimulant properties on locomotor behaviors of
   D3R-preferring compounds such as (+)UH232, actually a partial agonist at
   D3R, or nafadotride, a pure antagonist, these data suggest an inhibitory
   role for the D3R on psychomotor behaviors, and D3R agents potential new
   therapeutical tools for schizophrenia and/or drug dependence.},
