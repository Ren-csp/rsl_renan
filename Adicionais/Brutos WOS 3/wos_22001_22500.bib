@article{ WOS:000240175300019,
Author = {Hogrefe, C. and Porter, P. S. and Gego, E. and Gilliland, A. and
   Gilliam, R. and Swall, J. and Irwin, J. and Rao, S. T.},
Title = {Temporal features in observed and simulated meteorology and air quality
   over the Eastern United States},
