Title = {STUDENTS' SOCIAL-EMOTIONAL COMPETENCY AND MATHEMATICS ACADEMIC
   DEVELOPMENT: A CLUSTERING ANALYSIS ON CHINA},
Booktitle = {9TH INTERNATIONAL CONFERENCE ON EDUCATION AND EDUCATIONAL PSYCHOLOGY
   (ICEEPSY 2018)},
