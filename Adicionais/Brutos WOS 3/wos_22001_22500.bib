@article{ WOS:A1995QX96600004,
Author = {STEVENS, KA},
Title = {INTEGRATION BY ASSOCIATION - COMBINING 3-DIMENSIONAL CUES TO EXTRINSIC
   SURFACE SHAPE},
Journal = {PERCEPTION},
Year = {1995},
