@article{ WOS:000431480900004,
Author = {Osman, Mariana Mohamed and Ab Wahab, Hanisah and Abdullah, Muhammad
   Faris and Mohamed, Mohd Zain},
Title = {Illegal Occupation of State Land in Perak: A Review of the State's
   Legalisation Program (PATUH)},
