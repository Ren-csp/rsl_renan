Title = {Developments and debates on OHSM system standardisation and
   certification},
Booktitle = {SYSTEMATIC OCCUPATIONAL HEALTH AND SAFETY MANAGEMENT: PERSPECTIVES ON AN
   INTERNATIONAL DEVELOPMENT},
Year = {2000},
Pages = {391-412},
Note = {Conference on Systematic Occupational Health and Safety Management, NATL
   TRADE UNION MUSEUM, AMSTERDAM, NETHERLANDS, SEP, 1998},
Organization = {Hugo Sinzheimer Inst; Swedish Natl Inst Working Life; European Fdn
   Improvement Livin \& Working Condit},
Abstract = {OHSM systems represent a relatively new phenomenon, and standardisation
   is a way to develop a generally accepted definition of OHSM systems.
   Certification is a means to externally verify and communicate the
   achievements made. During the last five years, rapid developments have
   taken place with regard to ISO standardisation and certification of OHSM
   systems. Many new issues are raised, and the mental models and interests
   of the persons and institutions involved greatly influence their
   perception and positions. The chapter is to give an overview of the main
   developments, and to highlight new issues put forward in the debates. It
   is not meant to describe all (temporary) positions of individual
   stakeholder groups, nor to advocate a specific position. It is intended
   to show the variety of perspectives, to challenge the mind set of the
   readers and to identify possible new areas for research.},
