@article{ WOS:000270643100005,
Author = {Gustafsson, Mats and Blomqvist, Goran and Gudmundsson, Anders and Dahl,
   Andreas and Jonsson, Per and Swietlicki, Erik},
Title = {Factors influencing PM10 emissions from road pavement wear},
