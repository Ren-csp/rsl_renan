Note = {2nd International Conference on Environmental Science and Technology
   (ICEST 2011), Singapore, SINGAPORE, FEB 26-28, 2011},
Organization = {Asia Pacific Chem Biol \& Environm Engn Soc; Int Assoc Comp Sci \&
   Informat Technol},
Abstract = {The enormous increase in the population of Jaipur city, over the years,
   has added to its woes of scarcity of fresh water reserves resulting in a
   change in the pattern of water consumption. Water as a commodity is
   different from other commodities; it is a life sustaining product. Water
   is the main source of life and nourishment. The objective of the study
   is to assess the behavior of consumers with regards to the dwindling
   water supply. The results would benefit the urban development
   authorities to optimize the existing water supply distribution. This
   study has segmented the consumers based on their monthly income and has
   reached a conclusion that each of the identified groups uses more water
   than that is sufficient as per their standard of living. This needs to
   be checked by changing public perception of water use through media and
   education.},
