@article{ WOS:000233354700006,
Author = {Ericson, JA},
Title = {A participatory approach to conservation in the Calakmul Biosphere
   Reserve, Campeche, Mexico},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2006},
Volume = {74},
Number = {3-4},
Pages = {242-266},
Month = {FEB 15},
Note = {61st Annual Meeting of the Society-for-Applied-Anthropology, Merida,
   MEXICO, MAR 28-APR 01, 2001},
Abstract = {Since the advent of integrated conservation and development programs,
   participatory approaches have been used to engage local people in
   protected area management and conservation action. While participatory
   approaches provide local people a role in telling their own story and
   enable them to contribute to conservation and development processes, it
   is unclear how much consideration local people's opinions receive within
   the framework of a participatory process that exists to meet the
   specific goals and objectives of conservation programs. This paper
   evaluates the strengths and weaknesses of the participatory approach
   used in an applied research program conducted in three ejido communities
   in the Calakmul Biosphere Reserve on the Yucatan Peninsula of Mexico.
   The research program used community mapping, historical matrices,
   institutional diagramming, seasonal calendars, semi-structured
   interviewing and other community-level reflection techniques to assess
   the complex interrelationships among population growth, migration,
   tenure regimes, and land-use practices in rural communities bordering
   the reserve. The program also sought to build local capacity and support
   for land-use planning and conservation programs. While the paper
   acknowledges the critical benefits of local participation it also
   questions the compatibility of this approach with conservation programs
   administered by conservation organizations as they are currently
   structured. (c) 2004 Elsevier B.V. All rights reserved.},
