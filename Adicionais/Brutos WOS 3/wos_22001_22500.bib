@article{ WOS:A1995QR87500008,
Author = {DUNEGAN, KJ},
Title = {IMAGE THEORY - TESTING THE ROLE OF IMAGE COMPATIBILITY IN PROGRESS
   DECISIONS},
Journal = {ORGANIZATIONAL BEHAVIOR AND HUMAN DECISION PROCESSES},
Year = {1995},
Volume = {62},
Number = {1},
Pages = {79-86},
