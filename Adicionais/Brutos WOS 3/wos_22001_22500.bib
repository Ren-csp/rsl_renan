Note = {26th International Horticultural Congress, TORONTO, CANADA, AUG 11-17,
   2002},
Organization = {Canadian Soc Hort Sci; Int Soc Hort Sci; Univ Guelph},
Abstract = {The analysis is based on a pilot survey conducted among the family farms
   in the NE region of Croatia. The survey focused on the organic
   agriculture perception of the Croatian farmers, particularly their
   attitude towards organic vegetable growing, and their willingness to
   start with this type of production in the future. The authors assumed
   that the farmers involved in vegetable growing (conventional for the
   time being) present a group more sensitive to (non) application of
   agrochemicals and other indirect pollutants than the farmers involved in
   other farming practices. The results indicate that the attitude of the
   vegetable growers towards the organic agriculture is positive, much more
   so than the attitude of ``other{''} farmers. The vegetable producers
   have clearly shown higher interest in the organic agriculture and firmer
   conviction regarding the future prospective of organic agriculture in
   Croatia.},
