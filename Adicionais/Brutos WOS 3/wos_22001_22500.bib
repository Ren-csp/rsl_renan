@article{ WOS:000444996500069,
Author = {Ng, Ching-Yee and Yeo, Kee-Jiar},
Title = {Underlying Concepts and Causal Factors Associated with Mental Health
   Among Elementary School Students},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4144-4147},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {Good mental health is crucial to the well-being of individuals. In fact,
   students with good mental health are more likely to succeed at school
   and later in life. Nevertheless, problems related to mental health may
   affect a person's self-esteem, academic achievement, thought, feeling,
   emotions, and behaviour. Although the World Health Organization and the
   government through Ministry of Health and Ministry of Education have
   addressed such issues; lack of initiative has been taken to improve the
   aspects of mental health service in Malaysian schools. Hence, this study
   provides a brief overview of the existing literature pertaining to the
   concepts of mental health, as well as the factors associated with them.
   Furthermore, the relevant factors of mental health are identified to
   develop effective preventive intervention for elementary school
   students. This paper reviews the underlying concepts and the causal
   factors associated to mental health among elementary school students.
   Causal factors for mental health include social factors; biogenetic
   factors; home, school, and community environment factors; as well as
   individual factors, such as learning skills, behaviour, and relationship
   skills. On top of that, children and adolescents who are socially and
   economically disadvantaged have been found to be significantly
   associated with mental health problems. Moreover, this review further
   elucidates the root causes of mental health in order to develop
   effective and purposeful preventive and intervention of mental health.
   Therefore, the risk and protective factors of mental health should be
   highlighted the prevention field of mental disorders, which must
   imperiously consider the reduction of risks, besides strengthening
   individual, environmental, and social resources.},
