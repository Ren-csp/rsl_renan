@article{ WOS:000482576500024,
Author = {Rotaru, Cristina Salca and Manciulea, Ileana and Draghici, Camelia},
Title = {EFFECT OF ENVIRONMENTAL MONITORING ON THE ENVIRONMENTAL LEGISLATIVE
   PROCESS},
