Title = {Information technology (IT) structures in Mexican manufacturing firms},
Booktitle = {DECISION SCIENCES INSTITUTE 1998 PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {372-375},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {This paper presents the results of a survey that investigates the
   sophistication of the information technology (IT) employed by
   maquiladoras (non-Mexican owned manufacturing and assembly plants). This
   study is designed to: (1) develop an understanding of the information
   technologies employed in the maquiladoras, and (2) assist in the
   development of a model of IT architectures employed such that
   comparisons can be made of the architectures used by similar
   manufacturing firms located in the U.S.. Canada, and Mexico (the
   signatories of the North American Free Trade Agreement, NAFTA). In
   general, the results of this study indicate the use of significantly
   more sophisticated IT than might otherwise be expected as a result of
   the general perception that maquiladoras should be organized to
   capitalize on the relatively tow skill levels and wages of the hourly
   Mexican worker.},
