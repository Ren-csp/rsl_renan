Title = {Airborne and spaceborne measurements of aerosol and cloud structure: A
   LITE validation study},
Booktitle = {NUCLEATION AND ATMOSPHERIC AEROSOLS 1996},
Year = {1996},
Pages = {804-807},
Note = {14th International Conference on Nucleation and Atmospheric Aerosols,
   HELSINKI, FINLAND, AUG 26-30, 1996},
Organization = {Int Assoc Meteorol \& Atmospher Sci; Int Commiss Clouds \& Precipitat;
   Comm Nucleat \& Atmospher Aerosols; Int Global Atmospher Chem Project;
   Univ Helsinki, Dept Phys; Finnish Meteorol Inst; Finnish Assoc Aerosol
   Res; Univ Helsinki, Lahti Res \& Training Ctr; Minist Educ Finland; Acad
   Finland; Finnair; Maj \& Tor Nessling Fdn; Neste Fdn},
Abstract = {The Lidar In-Space Technology Experiment (LITE), flew September 9-19,
   1994, as the primary payload aboard the Space Shuttle Discovery. A
   correlative measurements network of over 50 international groups,
   consisting of both airborne and ground-based lidar platforms, performed
   ground truth experiments during the 10 day shuttle mission. Our
   experiment involved the operation of a heavily equipped experimental
   research aircraft, a Convair 580 (CV580), owned and operated by National
   Research Council of Canada. Measurements from some of the
   instrumentation aboard this platform from two different flight days will
   be discussed. In particular, optical and structural properties of both
   aerosol and cloud from a downward-looking, Nd:YAG lidar system operating
   at the fundamental wavelength of 1064 nm, several particle probes,
   nephelometer and meteorological instrumentation. Detailed measurements
   of cloud structure from a marine stratus cloud deck off the coast of
   California will be compared with LITE. A three-way intercomparison of
   cloudtop height from LITE, the airborne lidar and FSSP probe will
   demonstrate spatial scales over which comparisons with LITE data are
   valid. The differences mainly arise from the offset between the flight
   tracks and orbital tracks. Cloud thickness, homogeneity and liquid water
   content will also be addressed. Secondly, aerosol transport from urban
   centres such as Los Angeles and San Francisco is clearly visible from
   the LITE data. This will be compared with in-situ measurements obtained
   during aircraft descent and ascent profiles from both particle probes
   and a nephelometer.},
