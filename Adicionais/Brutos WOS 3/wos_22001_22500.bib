Title = {Unravelling tihe mysteries of schizophrenia: Advances from genetic
   studies},
Booktitle = {INTERNATIONAL SEMINAR ON NUCLEAR WAR AND PLANETARY EMERGENCIES - 27TH
   SESSION},
Series = {Science and Culture Series-Nuclear Strategy and Peace Technology},
