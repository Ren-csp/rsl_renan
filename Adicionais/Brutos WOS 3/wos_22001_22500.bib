@inproceedings{ WOS:000462188000027,
Author = {Radu, Daniela Ana-Maria},
Editor = {IleanaViscu, DL},
Title = {Post-Traumatic Stress Disorder in Women Who Live in Conflict Areas. An
   Integrative Model of Psychotherapeutic Intervention},
Booktitle = {PROCEEDINGS OF 1ST INTERNATIONAL CONFERENCE SUPERVISION IN PSYCHOTHERAPY},
Year = {2018},
Pages = {172-182},
Note = {1st International Conference on Supervision in Psychotherapy, Timisoara,
   ROMANIA, JUN 22, 2018},
Organization = {Univ Tibiscus, Ctr Qualitat Res Counselling \& Psychotherapy},
Abstract = {The variety of traumatizing factors that women who live in areas
   characterized by conflicts and humanitarian crises are exposed to is
   multiple. They can be direct subjects of or witnesses to abuses,
   psychological, physical and moral violence, acts of torture or of sexual
   violence, armed attacks, population displacement, hunger, and diseases.
   Researchers share the fact that traumas are responsible for the debut of
   the Post-traumatic stress disorder (PTSD), but the repression and
   negation of emotions at the moment when the trauma takes place are in
   fact the major causes for the subsequent appearance of the
   symptomatology.
   PTSD represents a major anxiety disorder, different from other anxiety
   disorders in that it appears through the exposure to a traumatic
   situation but it manifests subsequently through a persistent
   re-experimentation of the traumatic event, an avoidance behaviour
   associated with the traumas and a state of neurovegetative
   hyperactivity.
   The present paper proposes the multileveled integrative model as a
   possible avenue for psychotherapeutic intervention. Methodologically,
   what will be used is the case study of a refugee woman who has been
   diagnosed with PTSD which she developed as a result of direct and
   indirect exposure to a series of traumatizing factors such as sexual
   violence, the loss of her husband, and armed attacks. Considering the
   complexity of factors that determine and maintain the PTSD in
   traditional societies marked by conflicts and humanitarian crises, it
   was considered as being opportune to propose an integrative model of
   intervention which concentrates both on identity and cultural elements,
   and on individual cognitive and emotional patterns.},
