@inproceedings{ WOS:001315687100011,
Author = {Stangl, Fabian J. and Riedl, Rene},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB and Muller-Putz, GR},
Title = {Neurophysiological Measurements in the Research Field of Interruption
   Science: Insights into Applied Methods for Different Interruption Types
   Based on an Umbrella Review},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2023},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2024},
