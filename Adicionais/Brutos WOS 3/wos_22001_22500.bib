Title = {Contemporary Trends in Choreography - Potential for Enhancing the
   Artistic Preparation in Rhythmic and Aerobic Gymnastics},
Booktitle = {ICPESK 2015 - 5TH INTERNATIONAL CONGRESS ON PHYSICAL EDUCATION, SPORT
   AND KINETOTHERAPY},
