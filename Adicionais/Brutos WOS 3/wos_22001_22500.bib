@article{ WOS:000080975600010,
Author = {Rose, NL and Juggins, S and Watt, J},
Title = {The characterisation of carbonaceous fly-ash particles from major
   European fossil-fuel types and applications to environmental samples},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1999},
Volume = {33},
Number = {17},
Pages = {2699-2713},
