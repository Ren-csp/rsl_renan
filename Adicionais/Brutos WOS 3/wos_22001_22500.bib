Title = {Air pollution and global change impacts on forest ecosystems: Monitoring
   and research needs},
Booktitle = {AIR POLLUTION, GLOBAL CHANGE AND FORESTS IN THE NEW MILLENNIUM},
Series = {Developments in Environmental Science},
Year = {2003},
