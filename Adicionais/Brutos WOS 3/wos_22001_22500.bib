Pages = {6040-6043},
Month = {JUL},
Note = {International Conference on Architecture and Built Environment (ICABE),
   Kuala Lumpur, MALAYSIA, OCT 05-06, 2016},
Abstract = {Illegal occupation and operation of state land has negatively impacted
   the states in many ways, especially in terms of revenue loss and
   environmental pollution. To counter these impacts, states government
   have undertaken measures to curb illegal occupation and operation of
   state land. This study reviewed PATUH, a programme undertaken by the
   State Government of Perak to curb illegal occupation of government land
   in the state. Information regarding PATUH was obtained through
   interviews with officers from key government agencies in Perak. It was
   found that while PATUH has managed to reduce the amount of cases of
   illegal occupation of state land, it did not do well in recovering
   revenues to the state. This study proposes that land charges under PATUH
   should be increased if revenue to the state is to be significantly
   improved.},
