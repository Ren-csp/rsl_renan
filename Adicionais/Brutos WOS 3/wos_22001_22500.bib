@inproceedings{ WOS:000345657500019,
Author = {Bhandary, H. and Al-Fahad, K. and Al-Senafy, M. and Al-Khalid, A.},
Editor = {Brebbia, CA},
Title = {Usage of environmental isotopes in characterizing groundwater recharge
   sources},
Booktitle = {WATER POLLUTION XI},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2012},
Volume = {164},
Pages = {223-228},
Note = {11th International Conference on Modelling, Monitoring and Management of
   Water Pollution, Wessex Inst Technol, New Forest Campus, ENGLAND, JUL
   10-12, 2012},
Organization = {WIT Transact Ecol \& Environm; Int Journal Sustainable Dev \& Planning;
   Int Journal Computat Methods \& Expt Measurements},
Abstract = {Rising groundwater has affected many urban areas in the Middle East from
   large cities to individual development sites, resulting in widespread
   and costly damage to property, and dangers to public health. The main
   objective of this study is to use the environmental isotopes to identify
   the recharge source that is causing groundwater rise. The study area is
   located within the Greater Burgan oil field of Kuwait and covers an area
   of 25 km(2). The stable isotopes oxygen-18 (O-18) and deuterium (H-2)
   were used to investigate the origin of water in the aquifer system while
   the radioactive isotopes carbon-14 (C-14) and tritium (H-3), were used
   to estimate the age and circulation of groundwater. The results of C-14
   and tritium analyses have indicated that the sampled groundwater had
   experienced limited recharge from recent rainfall events. The isotopic
   fingerprints of potential recharge sources were markedly different from
   those of the groundwater, indicating no recharge from these sources. The
   isotopic similarity between the two aquifers confirmed the hydraulic
   interconnection between Dammam aquifer and the overlying Kuwait Group
   aquifer. It was concluded that the rise of the groundwater in the
   vicinity of the study area can be attributed to the upward seepage from
   Dammam Formation water to the subsurface and the infiltration of
   rainfall and water from the overflow of the nearby disposal pit.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
