Title = {A climate survey for medical students - A means to assess change},
Journal = {EVALUATION \& THE HEALTH PROFESSIONS},
Year = {1996},
Volume = {19},
Number = {1},
Pages = {30-47},
Month = {MAR},
Note = {Annual Meeting of the American-Educational-Research-Association, NEW
   ORLEANS, LA, APR 04-08, 1994},
Organization = {Amer Educ Res Assoc},
Abstract = {An instrument was developed to assess the perceptions of students
   regarding sir aspects of school climate and their experience of and
   attitudes toward sexual harassment and gender insensitivity. During
   clerkship orientation 77 students (92\% return rate), half female, were
   given the survey. Cronbach alpha reliabilities for the sir scales ranged
   from .71 to .85. One significant female/male difference among the three
   scales of general school climate was observed two significant
   female/male male differences occurred among the three scales relating to
   gender concerns, Seventy percent of both males and females reported
   having observed sexually harassing behavior during the previous year;
   46\% of females and 15\% of males reported experiencing sexually
   harassing behavior during the year: Observing and/or personally
   experiencing sexual harassment was associated with a decrease in
   positive climate ratings and an increase in negative climate ratings.},
