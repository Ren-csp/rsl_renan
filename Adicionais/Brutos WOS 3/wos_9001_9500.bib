@article{ WOS:000512034200010,
Author = {Zhuo, Huimin and Wang, Xu and Liu, Heng and Fu, Sanze and Song, Hui and
   Ren, Lijun},
Title = {Source analysis and risk assessment of heavy metals in development
   zones: a case study in Rizhao, China},
Journal = {ENVIRONMENTAL GEOCHEMISTRY AND HEALTH},
Year = {2020},
Volume = {42},
Number = {1, SI},
Pages = {135-146},
