@inproceedings{ WOS:000072557300046,
Author = {Tsuda, R and Ueno, S},
Editor = {Koga, Y and Nagata, K and Hirata, K},
Title = {Transient visual evoked potentials to apparent motion in random dot
   patterns},
Booktitle = {BRAIN TOPOGRAPHY TODAY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1997},
Volume = {1147},
Pages = {266-269},
Note = {III Pan-Pacific Conference on Brain Topography (BTOPPS III), TOKYO BAY,
   JAPAN, APR 01-04, 1997},
Abstract = {Apparent motion perception is thought to be mediated by two separate
   processes; a short-range process and a long-range process. This study is
   focused on the properties of transient visual evoked potentials (VEPs)
   in response to short-range apparent motion using random dot
   cinematogram. Transient VEPs in response to a bidirectional motion, were
   measured and compared with VEPs to two types of control stimulation
   ({''}unidirectional motion{''} and ``random dot motion{''}). The effect
   of motion velocity on the amplitude and the latency of the transient
   VEPs were also examined. Bidirectional motion VEPs are characterized by
   a triphasic wave of P1-N2-P2 with peak latencies of 160-180, 200-250,
   and 250-320 ms. Bidirectional motion VEPs are different from those of
   the control stimulation. The effects of motion velocities between 1.1
   and 34.4 degrees/s show that the maximum peak-to-peak amplitudes of
   P1-N2 and N2-P2 appeared less than 11.4 degrees/s, slightly decreased as
   the velocity increased, and that the latencies of N2 and P2 were almost
   constant over wide motion velocity ranges. These results suggest that
   the triphasic wave is mainly concerned with the motion perception of
   random dot patterns.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Tsuda, R (Corresponding Author), Kyushu Tokai Univ, Fac Engn, 9-1-1 Toroku, Kumamoto 862, Japan.
   Kyushu Tokai Univ, Fac Engn, Kumamoto 862, Japan.},
ISSN = {0531-5131},
ISBN = {0-444-82778-1},
Keywords = {motion perception; random-dot cinematogram; transient VEP},
