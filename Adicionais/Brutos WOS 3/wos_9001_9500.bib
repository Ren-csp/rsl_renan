@article{ WOS:A1995RY27100009,
Author = {PAGANO, CC and TURVEY, MT},
Title = {THE INERTIA TENSOR AS A BASIS FOR THE PERCEPTION OF LIMB ORIENTATION},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {1995},
