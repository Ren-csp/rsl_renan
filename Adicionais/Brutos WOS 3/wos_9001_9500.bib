@inproceedings{ WOS:000558648300009,
Author = {Grilo, Marcelo and Ribeiro, Layse and Moraes, Caroline and Melo, Carlos
   and Fantinato, Denis and Sampaio, Leonardo and Neves, Aline and Ramos,
   Rodrigo},
Book-Group-Author = {IEEE},
Title = {Artifact Removal in EEG based Emotional Signals through Linear and
   Nonlinear Methods},
Booktitle = {2019 E-HEALTH AND BIOENGINEERING CONFERENCE (EHB)},
Series = {E-Health and Bioengineering Conference},
Year = {2019},
Note = {7th E-Health and Bioengineering Conference (EHB), Grigore T Popa Univ
   Med \& Pharmacy, Iasi, ROMANIA, NOV 21-23, 2019},
Organization = {Grigore T Popa Univ Med \& Pharmacy , Fac Med Bioengineering; IEEE;
   Romanian Soc Med Bioengineering; Romanian Acad, Inst Comp Sci, Iasi
   Branch; IEEE Romania Sect; IEEE EMB Romania Chapter; IEEE EMC Romania
   Chapter; IEEE Signal Proc Romania Chapter; IEEE SMC Romania Chapter},
Abstract = {Using a Linear Discriminant Analysis (LDA), we aimed to distinguish
   positive and negative emotions through EEG signals. The emotions were
   elicited using a set of six videos to express happiness and disgust. We
   adopted two different signal pre-processing techniques, verifying the
   importance of artifacts removal, assuming a linear and a PostNonlinear
   mixture (PNL) model. In the first case, we applied the SOBI algorithm
   and in the second a mutual information minimization based algorithm.
   Without the artifacts removal, the classifier had an accuracy of
   67.39\%. With SOBI, there was an increase to 71.74\%, while with PNL
   accuracy was 77.54\%. These results point to the importance of artifacts
   removal in EEG signal analysis and show that nonlinear models may be
   better suited to deal with EEG signals.},
