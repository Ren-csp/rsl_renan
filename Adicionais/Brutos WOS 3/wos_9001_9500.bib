@inproceedings{ WOS:000468045100284,
Author = {Sun, Ke and He, De and Wang, Lei and Wang, Huahui and Pan, Hong and Sun,
   Zhou},
Book-Group-Author = {IOP},
Title = {A Grid-Based Method for Distribution Network Planning in Urban Areas},
Booktitle = {2018 FIRST INTERNATIONAL CONFERENCE ON ENVIRONMENT PREVENTION AND
   POLLUTION CONTROL TECHNOLOGY (EPPCT 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {199},
Note = {1st International Conference on Environment Prevention and Pollution
   Control Technology (EPPCT), Tokyo Univ Sci, Tokyo, JAPAN, NOV 09-11,
   2018},
Organization = {Natl Tech Univ Ukraine},
Abstract = {This paper proposes a grid-based method for distribution network
   planning. Firstly, based on the analysis of the economic and social
   development targets and distribution network status in the region, the
   central area is meshed and classified according to the relevant
   principles and objectives of distribution network planning as well as
   the nature and development depth of the land. Load forecasting based on
   grid layout is carried out to determine the saturated load corresponding
   to the current planning of the area. Finally, according to the current
   grid, load forecasting results and planning targets, the target grid and
   transition grid of the planning grid are determined. The above method is
   applied to the grid planning of a distribution network in Hangzhou
   China. The planning index is greatly improved, the target network frame
   of the distribution network is strong, the power supply range is clear,
   and the power supply reliability is high, which verifies the
   effectiveness of the method.},
