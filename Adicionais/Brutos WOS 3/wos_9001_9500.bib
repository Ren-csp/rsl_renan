Booktitle = {ADVANCES IN HUMAN FACTORS AND ERGONOMICS IN HEALTHCARE AND MEDICAL
   DEVICES (AHFE 2021)},
Series = {Lecture Notes in Networks and Systems},
Year = {2021},
Volume = {263},
Pages = {633-639},
Note = {AHFE Virtual Conference on Human Factors and Ergonomics in Healthcare
   and Medical Devices, ELECTR NETWORK, JUL 25-29, 2021},
Abstract = {The unprecedented emergency determined by the COVID-19 pandemic required
   national governments to enact countermeasures to contain the spread of
   the Coronavirus disease. Nevertheless, several research studies
   highlighted the acceptance issues and short- and long-term consequences
   of restrictions such as lockdown orders, social distancing, contact
   tracing, and face masks. In this paper, we present the results of a
   study in which we analyzed individuals' knowledge, attitude, and
   behavior regarding the health-safety measures implemented during the
   COVID-19 pandemic, and we outline the human factors that can play a key
   role in designing solutions that have better usability and result in
   higher compliance from users.},
