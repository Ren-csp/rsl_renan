@article{ WOS:A1995RM80600005,
Author = {ELLIS, HC and VARNER, LJ and BECKER, AS and OTTAWAY, SA},
Title = {EMOTION AND PRIOR KNOWLEDGE IN MEMORY AND JUDGED COMPREHENSION OF
   AMBIGUOUS STORIES},
