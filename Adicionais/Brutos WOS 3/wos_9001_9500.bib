@inproceedings{ WOS:000079127400082,
Author = {Courthold, NC and Whitwell, I},
Editor = {Brebbia, CA and Ratto, CF and Power, H},
Title = {Testing the tools of air quality management: a comparison of predictions
   of nitrogen dioxide concentrations by the CALINE4 and ADMS-Urban
   dispersion algorithms with monitored concentrations at the M4/M5
   interchange in Bristol, UK},
Booktitle = {AIR POLLUTION VI},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {1998},
Volume = {6},
Pages = {859-868},
Note = {6th International Conference on Air Pollution, GENOA, ITALY, SEP 29-30,
   1998},
Abstract = {This study compares the predictions of two dispersion model algorithms,
   CALINE4 and ADMS-Urban with nitrogen dioxide monitoring data. The
   investigation took place at the M4/M5 interchange to the north of
   Bristol where predictions of annual mean nitrogen dioxide concentrations
   were compared with the results of a diffusion tube monitoring survey.
   The results, using a limited input data set, show the ADMS-Urban
   predictions give a higher correlation coefficient (0.95) than the
   CALINE4 predictions (0.84) for annual mean concentrations of nitrogen
   dioxide when plotted against monitoring data. The meteorological data
   used was input as a summary file and the results were then weighted
   according to the frequency of each wind direction. Sequential hourly
   meteorological data was also used. The results show that both models
   have a tendency to over-predict at points closest to the motorway.},
