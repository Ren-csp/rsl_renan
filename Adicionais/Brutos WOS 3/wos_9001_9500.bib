@inproceedings{ WOS:000390838800017,
Author = {Zheng, L. and Xu, G. M. and Chen, J. and Chen, B. and Lv, Z. and Yang,
   Y. A.},
Editor = {Scholz, M},
Title = {Optimization of urban wastewater treatment plants process with low C/N
   ratio},
Booktitle = {INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT 2016
   (WRE2016)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2016},
Volume = {39},
Note = {2nd International Conference on Water Resource and Environment (WRE),
   Shanghai, PEOPLES R CHINA, JUL 23-26, 2016},
Abstract = {In southern China, the inflow of water to wastewater treatment plants
   has a lower concentration of organic matter. This causes treatment
   plants to face issues in the denitrification and phosphorus removal
   processes such as deficient carbon sources, high energy consumption, and
   unstable nitrogen removal. To resolve these issues, we propose the
   reconstruction of the internal reflux port, improvement of the internal
   reflux ratio to 200\%, the addition of carbon source to anoxic zone, and
   the addition of phosphorus removal agents in secondary settling tank.
   The results of study show significantly improved efficiency of nitrogen
   and phosphorus removal, which ensures the stability of subsequent supply
   of reused water.},
