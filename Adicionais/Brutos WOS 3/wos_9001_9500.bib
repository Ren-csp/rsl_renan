Title = {Air curtain applied to fire smoke pollution control},
Booktitle = {AIR POLLUTION XI},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {2003},
Volume = {13},
Pages = {541+},
Note = {11th International Conference on Modelling, Monitoring and Management of
   Air Pollution, Catania, ITALY, SEP, 2003},
Organization = {Wessex Inst Technol; Univ Catania},
Abstract = {The aim of this paper is the evaluation of the smoke flow rate through
   an opening, separating two spaces, when a fire is developed in one of
   the two, in order to verify possible control of, reducing oxygenation,
   fire grow by an air curtain recirculating indoor air. The study relates
   to a real urban underground railway station, with safe space to allow
   people to be evacuated, during a fire in the dock. The numerical
   approach is based on the package FDS (Fire Dynamics Simulator),
   developed by the NIST centre. The results show that an air curtain can
   reduce fire oxygenation, but is unable to extinguish fire for oxygen
   deficiency.},
