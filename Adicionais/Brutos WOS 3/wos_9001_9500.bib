@article{ WOS:000377921800104,
Author = {Sicard, Pierre and Augustaitis, Algirdas and Belyazid, Salim and
   Calfapietra, Carlo and de Marco, Alessandra and Fenn, Mark and
   Bytnerowicz, Andrzej and Grulke, Nancy and He, Shang and Matyssek,
   Rainer and Serengil, Yusuf and Wieser, Gerhard and Paoletti, Elena},
Title = {Global topics and novel approaches in the study of air pollution,
   climate change and forest ecosystems},
Journal = {ENVIRONMENTAL POLLUTION},
Year = {2016},
Volume = {213},
