Author = {Veeranki, Yedukondala Rao and Ganapathy, Nagarajan and Swaminathan,
   Ramakrishnan},
Editor = {Stoicu-Tivadar, L and Mantas, J and Chronaki, C and Hasman, A and Weber, P and Gallos, P and Crisan-Vida, M and Zoulias, E and Chirila, OS},
Title = {Non-Parametric Classifiers Based Emotion Classification Using
   Electrodermal Activity and Modified Hjorth Features},
Booktitle = {PUBLIC HEALTH AND INFORMATICS, PROCEEDINGS OF MIE 2021},
Series = {Studies in Health Technology and Informatics},
