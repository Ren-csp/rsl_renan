Pages = {5103-5107},
Note = {1st International Conference on Energy and Environmental Protection
   (ICEEP 2012), Hohhot, PEOPLES R CHINA, JUN 23-24, 2012},
Organization = {Inner Mongolia Univ},
Abstract = {Many factors contribute to formation of the environmental awareness of
   the public. The current existing related research mainly focuses on
   analysis of causality and correlation, with few quantitative research
   and empirical test. Thus the paper attempts to give a quantitative
   description of the factors influencing the public environmental
   awareness in Shanghai through applying structural equation model, and
   then put forth effective improvement countermeasures to provide
   theoretic basis for the government to formulate relevant policies. The
