Volume = {70},
Pages = {109-120},
Note = {Wenner-Gren Conference on Basic Mechanisms in Cognition and Language,
   STOCKHOLM, SWEDEN, FEB, 1997},
Organization = {Wenner Gren Ctr Fdn},
Abstract = {The speed of verbal information processing is very high. This fact has
   not been sufficiently considered in cerebral language models. The
   classical Wernicke/Broca and other hypothetical bottom-up models appear
   dominated by numerous cortical and subcortical multisynaptic networks
   which are inherently slow. An alternative, faster, top-down model is
   proposed here. It is based on neuroanatomical, electrophysiological and
   brain imaging data. In the human brain there are phylogenetically young
   powerful direct transcortical pathways which emanate from secondary
   Visual and auditory so-called association areas postcentrally Their
   conduction velocity is high. They project in an overlapping fashion to
   prefrontal regions, a fact supported by brain imaging studies. Thus,
   verbal messages may have an almost immediate access to prefrontal
   distributed networks, subserving semantic and syntactic analysis as well
   as other higher language, cognitive and behavioral motor functions. The
   model includes an interaction with less rapid subordinate cortical and
   subcortical neuronal systems involved in verbal processing. There are
   clinical observations on language disturbances following frontal lobe
   lesions which might be related to the top-down model proposed.},
