Year = {2000},
Volume = {31},
Number = {5},
Pages = {497-502},
Month = {OCT},
Note = {106th Annual Convention of the American-Psychological-Association, SAN
   FRANCISCO, CA, AUG 14-18, 1998},
Organization = {Amer Psychol Assoc},
Abstract = {Nationally, correctional psychologists are being asked to use behavioral
   telehealth interventions with mentally ill inmates. Beyond anecdotal
   stories, no information is available on which inmates might be best
   suited for such interventions. This article examines inmates' (N = 75)
   satisfaction with telehealth consultations, reporting initial
   satisfaction with the consultation process, more comfort with the
   process over time, and a willingness to return for follow-up. Inmates
   with thought disorders and inmates with mood disorders were satisfied
   with telehealth, but difficulties were noted when inmates became
   frustrated and angry. These difficulties may be accommodated by
   technological upgrades and spending more time preparing inmates for
   consultation.},
