@article{ WOS:000223582200009,
Author = {Bressler, SL},
Title = {Inferential constraint sets in the organization of visual expectation},
Journal = {NEUROINFORMATICS},
Year = {2004},
Volume = {2},
Number = {2},
Pages = {227-237},
