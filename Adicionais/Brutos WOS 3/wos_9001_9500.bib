Title = {Experimental investigation on contacting heating system assisted by air
   source heat pump in residential buildings},
Booktitle = {CLEANER ENERGY FOR CLEANER CITIES},
Series = {Energy Procedia},
Year = {2018},
Volume = {152},
Pages = {935-940},
Note = {Applied Energy Symposium and Forum - Low-Carbon Cities and Urban Energy
   Systems (CUE), Shanghai, PEOPLES R CHINA, JUN 05-07, 2018},
Organization = {Appl Energy; Appl Energy Innovat Inst; Tongji Univ; China Assoc Sci \&
   Technol, HOME Program; Malardalen Univ, Future Energy Profile; Shanghai
   Key Lab Urban Regenerat \& Spatial Optimizat Technol; MOE Joint Lab Int
   Cooperat Eco Urban Design; Sichuan Univ; Shanghai Univ Electric Power;
   BEEUE; Int Clean Energy Talent Program; UNiLAB},
Abstract = {According to the current situation of energy utilization in China and
   the drawbacks of the heating methods in rural areas, a contacting
   heating system assisted by air-source heat pump was proposed to replace
   the traditional Chinese Kang for heating in northern rural areas in this
   research. An experimental system was established to evaluate the
   performance of the system in a residential building. The results shows
   that the contacting heating system based on the air source heat pump can
   raise the indoor temperature effectively. When the temperature of
   supplied water was set to 35 degrees C, 40 degrees C, 45 degrees C, and
   50 degrees C, the indoor average temperature in the heated testing room
   was increased by 3.45 degrees C, 5.36 degrees C, 6.52 degrees C, and
   7.56 degrees C than that in the unheated control room respectively. In
   the meantime, the air temperature distribution in the testing room
   presented a trend of ``hot below and cool above{''}. The temperature
   distribution was uniform and met the demands of human body amenity.
