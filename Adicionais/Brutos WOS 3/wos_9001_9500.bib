@inproceedings{ WOS:000078659300008,
Author = {Ingvar, DH},
Editor = {VonEuler, C and Lundberg, I and Llinas, R},
Title = {A top-down model for language perception and production},
Booktitle = {BASIC MECHANISMS IN COGNITION AND LANGUAGE: WITH SPECIAL REFERENCE TO
   PHONOLOGICAL PROBLEMS IN DYSLEXIA},
Series = {Wenner-Gren International Series},
