Editor = {Marchal, M and Kajimoto, H and Lopes, P and Pacchierotti, C and Basdogan, C and Gori, M and Lemaire-Semail, B},
Title = {Self-supervised Spatio-Temporal Graph Mask-Passing Attention Network for
   Perceptual Importance Prediction of Multi-point Tactility},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
   INTERACTION, EUROHAPTICS 2024, PT II},
