@inproceedings{ WOS:000074636300027,
Author = {Davoli, E and Zerbo, G and Cappellini, L and Moggi, M and Ferrari, S and
   Fanelli, R},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {On-line monitoring of benzene air concentration while driving in traffic
   by isotopic dilution GC/MS},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {164-169},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {There is no shortage of information about the average benzene
   concentrations in urban air but, there is very little about
   micro-environmental exposure, such as in-vehicle concentrations while
   driving in various traffic conditions or in situations such as during
   refueling or in a parking garage. The main reason for this lack of data
   is that no analytical instrumentation was available to measure on-line
   trace amounts of benzene in such situations.
   We have recently proposed a highly accurate, high-speed cryofocussing
   gas chromatography-mass spectrometry (GC/MS) system for monitoring
   benzene concentrations in air. Accuracy of the analytical data is
   achieved by enrichment the air sample before trapping, with a stable
   isotope permeation tube system. The same principles has been applied to
   a new instrument, specifically designed for operation on an electric
   vehicle (Ducato Elettra, FIAT). The zero emission vehicle and the fully
   transportable, battery operated GC/MS system give the unique possibility
   of monitoring benzene exposure in real everyday situations such as while
   driving, refueling or repairing a car. All power consumptions have been
   reduced so as to achieve a battery-operated GC/MS system. Liquid
   nitrogen cryofocussing has been replaced by a packed, inductively
   heated, graphitized charcoal microtrap. The instrument has been mounted
   on shock absorbers and installed in the van. The whole system has been
   tested both in fixed and mobile conditions. The maximum monitoring
   period without external power supply is 6 hours. The full analytical
   cycle is 4 minutes, allowing close to real time monitoring, and the
   minimum detectable level is 1 ug/m(3) for benzene.
   In-vehicle monitoring showed that concentrations vary widely in
   different driving conditions: moving from a parking lot into normal
   traffic on an urban traffic condition roadway yields a three-fold
   increase in benzene concentration even if the actual distance is small,
   and a ten fold increase if a car with the engine running stops within 2
   m.},
Publisher = {TRANS TECH PUBLICATIONS LTD},
Address = {LAUBLSRUTISTR 24, CH-8717 STAFA-ZURICH, SWITZERLAND},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Davoli, E (Corresponding Author), Consorzio Ind Protez Ambiente, V Scala Greca 282, I-96100 Siracusa, Italy.
   Consorzio Ind Protez Ambiente, I-96100 Siracusa, Italy.},
