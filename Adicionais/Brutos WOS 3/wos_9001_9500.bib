   TRENDS},
Year = {2013},
Pages = {399-401},
Note = {International Psychological Applications Conference and Trends, Madrid,
   SPAIN, APR 26-28, 2013},
Organization = {World Inst Adv Res \& Sci; PsychNol Journal; Jean Piaget Soc},
Abstract = {Experimental evidence suggest that chronic pain condition can introduce
   modulations in attentional processing in adults. In the present study,
   we try to understand this phenomenon through cognitive tasks. We
   combined a modified Stroop and a Dot-probe paradigm in order to study
   attentional deviation to pain-relevant stimuli in chronic pain
   individuals and controls. Behavioural data (responses and reaction
   times) were analyzed. Preliminary results suggest an attentional biases
   to pain-relevant stimuli in comparison to the neutral ones. This effect
   seems to be more pronounced in participants with chronic pain, although
   it is needed further research with larger sample sizes.},
