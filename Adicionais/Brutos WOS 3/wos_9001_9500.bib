@article{ WOS:000186405300008,
Author = {Luczak, H and Roetting, M and Schmidt, L},
Title = {Let's talk: anthropomorphization as means to cope with stress of
   interacting with technical devices},
Journal = {ERGONOMICS},
Year = {2003},
Volume = {46},
