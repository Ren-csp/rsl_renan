   Emission Inventory for University Campuses},
Booktitle = {TOWARDS GREEN CAMPUS OPERATIONS: ENERGY, CLIMATE AND SUSTAINABLE
   DEVELOPMENT INITIATIVES AT UNIVERSITIES},
Series = {World Sustainability Series},
