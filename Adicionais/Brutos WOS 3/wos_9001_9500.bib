@inproceedings{ WOS:000084731400013,
Author = {Marks, LE},
Editor = {Killeen, PR and Uttal, WR},
Title = {Differential context effects in intramodal and cross-modal perception},
Booktitle = {FECHNER DAY 99: THE END OF 20TH CENTURY PSYCHOPHYSICS, PROCEEDINGS},
Year = {1999},
Pages = {72-77},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {When two or more sets of stimuli are presented to either the same sense
   modality or to different modalities, the resulting judgments of
   perceived magnitude can vary markedly as a function of the sets of
   stimulus values - the stimulus context. These differential effects of
   context are most readily explained as the product of an adaptation-like
   process, located or initiated in the central nervous system, that
   operates independently on different sensory channels within a given
   modality.},
