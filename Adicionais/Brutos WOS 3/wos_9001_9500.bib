@inproceedings{ WOS:000080781300024,
Author = {Reiter, MA and Eagleman, JP},
Editor = {Hickey, KL and Kantarelis, D},
Title = {The deer of Brown County State Park, Indiana: Data, emotion, and
   management},
Booktitle = {OUR NATURAL ENVIRONMENT: AT A CROSSROAD, PROCEEDINGS},
Year = {1997},
Pages = {256-264},
Note = {3rd International Interdisciplinary Conference on the Environment,
   WORCESTER, MA, JUN 25-28, 1997},
Organization = {Interdisciplinary Environm Assoc},
Abstract = {Deer populations are growing in protected areas around the country, and
   Indiana's parks are no exception, Current estimates of deer population
   sizes in Indiana parks range up to one hundred per square mile or more,
   approximately ten times the theoretical carrying capacity for Indiana
   woodlands. In Brown County State Park (BCSP), management studies and
   data collected from exclosures erected in 1988 suggest that deer
   browsing is seriously restricting the regrowth of most recolonization
   plants, while enhancing the growth of a few brow se-resistant species.
   Associated changes in understory-related wildlife. such as
   ground-nesting birds, have also been detected. After alternative methods
   were considered (and some attempted with little success), a
   strictly-limited special hunt was initiated at BCSP in 1993 to thin the
   deer population. This was met with significant protest from small local
   and larger out-of-area groups, who felt that the method of reduction nas
   inhumane, non-environmental, bad for business, and/or a ``foot in the
   door{''} for opening the park to general hunting. The preliminary
   management data from the hunting program seems to be positive, and local
   protests concerning the program have diminished though small isolated
   occurrences continue. In hindsight, this episode may have been reduced
   if park officials had realized the potential interplay. of scientific
   and non-scientific pressures inherent in this management decision and
   planned to address it immediately. However, there was a core group of
   individuals who held strongly negative opinions of the plan for various
   reasons, and these individuals appeared to drive much of the public and
   political debate on this issue. Thus, while education efforts may have
   helped to lessen the impact from this difficult management decision, it
   mag. have been impossible to avoid public and/or political conflict over
   the issue. The resulting re-evaluation carried out by the Indiana Park
   System also illustrates a move toward a conservation-based view of
   parks, as opposed to the presentation-based view that was dominant
   earlier in this century.},
Publisher = {INTERDISCIPLINARY ENVIRONMENT ASSOCIATION},
