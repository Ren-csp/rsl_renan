Title = {Drivers of Creativity and Innovation: Perceptions from The Inside},
Booktitle = {VISION 2020: SUSTAINABLE GROWTH, ECONOMIC DEVELOPMENT, AND GLOBAL
   COMPETITIVENESS, VOLS 1-5},
Year = {2014},
Pages = {1277-1289},
Note = {23rd International-Business-Information-Management-Association
   Conference on Visio 2020: Sustainable Growth, Economic Development, and
   Global Competitiveness, Valencia, SPAIN, MAY 13-14, 2014},
Abstract = {This paper is dedicated to an analysis of the contribution that social
   environment and some of its main actors have on the creative
   professions. By using interviews with individuals working in creative
   fields, we tried to answer some questions related to who and how other
   individuals contribute to the creative process and why is their
   contribution important. Wehave identified three categories of
   `influencers' (family and friends, peers and students and clients and
   funders) who are perceived by individual creators living and working in
   Romania as playing different roles in supporting and fostering
   creativity. While most of their actions is perceived as enhancing
   creativity, there are many instances when their influence is seen as
   inhibiting and counterproductive.},
