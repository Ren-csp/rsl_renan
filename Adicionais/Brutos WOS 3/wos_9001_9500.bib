@inproceedings{ WOS:000309762400018,
Author = {Lopez-Ibor Alino, J. J. and Lopez-Ibor Alcocer, M. I.},
Editor = {Soldatos, CR and Dikeos, DG},
Title = {FUNCTIONAL NEUROIMAGING CAN CONTRIBUTE TO A BETTER UNDERSTANDING OF
   DELUSIONAL THINKING},
Booktitle = {PSYCHIATRY AND THE NEUROSCIENCES: INTERNATIONAL PERSPECTIVES},
Year = {2011},
Pages = {143-150},
Note = {4th International Congress on Psychiatry and the Neurosciences, Hellen
   Soc Advancement Psychiat \& Related Sci, Thessaloniki, GREECE, NOV, 2010},
Organization = {World Psychiat Assoc (WPA); World Federat Soc Biol Psychiat (WFSBP); Int
   Neuropsychiat Assoc (INA)},
Abstract = {Delusions are an essential component of the clinical manifestations of
   schizophrenia. On the other hand, human faces are most relevant for
   social interaction. In patients with schizophrenia there is a clear
   correlation between difficulty in interpreting facial expressions and
   the functional deterioration due to the disease. Our interest was to
   analyse the process of perception including the attribution of meanings
   and emotions to sensory experiences in schizophrenic patients with
   prominent delusional activity. Fifteen right handed patients aged 18-65
   and 15 right handed sex- and age-matched control subjects with no
   history of psychiatric disorder underwent magnetoencephalography while
   looking at pictures of faces with varying degrees of facial contextual
   information. We have found that, although the early visual cortex
   activity is the same in highly delusional patients and controls, there
   are striking differences in further stages, with patients activating
   more cells and brain structures (e.g. auditory areas, the fusiform gyrus
   and regions concerned with the familiarity of perceptions) than the
   controls. This suggests that the same stimulus is processed in a more
   complex and distorted way in delusional schizophrenic patients.},
Publisher = {MEDIMOND S R L},
Address = {VIA MASERATI 5, 40128 BOLOGNA, 00000, ITALY},
Type = {Proceedings Paper},
