@inproceedings{ WOS:000470998600007,
Author = {Liu, Zheming and Zhao, Xudong and Jin, Yumeng and Jin, Hong and Xu,
   Xuelu},
Editor = {Salame, CT and Aillerie, M and Papageorgas, P and Perilhon, C and Haider, A and Vokas, G and Shaban, A and Jabur, A},
Title = {Prediction of Outdoor Human Thermal Sensation at the Pedestrian Level in
   High-rise Residential Areas in Severe Cold Regions of China},
Booktitle = {TECHNOLOGIES AND MATERIALS FOR RENEWABLE ENERGY, ENVIRONMENT AND
   SUSTAINABILITY (TMREES)},
Series = {Energy Procedia},
Year = {2019},
Volume = {157},
Pages = {51-58},
Note = {International Conference on Technologies and Materials for Renewable
   Energy, Environment and Sustainability (TMREES), Athens, GREECE, SEP
   19-21, 2018},
Abstract = {The residential areas, as a city's basic unit, have the closest
   connection with people's living environment; the outdoor thermal
   sensation of residential areas directly affects people's physical and
   mental health. This study aims to reveal the relationship between the
   high-rise residential areas' building density and wind projection angle,
   with the winter pedestrian thermal sensation in severe cold regions. In
   this study, the prediction model of pedestrian -level wind chill
   temperature of high-rise residential areas is established by using the
   existed prediction model of the mean pedestrian level wind velocity
   ratio of high-rise residential areas and the standard values of air
   temperature and wind velocity from urban meteorological stations, to
   perform the quantitative analysis of pedestrian thermal sensation of
   high-rise residential areas in severe cold regions in winter. Based on
   this, the winter pedestrian thermal sensation evaluation for the
   high-rise residential areas of six major cities in the severe cold
   regions of China is performed by using the prediction model. This paper
   provides the quantitative guidance and evaluation basis for the
   high-rise residential areas planning in severe cold regions. (C) 2019
   The Authors. Published by Elsevier Ltd.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
