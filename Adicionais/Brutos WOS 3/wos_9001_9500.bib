@inproceedings{ WOS:000182918800014,
Author = {Cahill, L},
Editor = {ShinnickGallagher, P and Pitkanen, A and Shekhar, A and Cahill, L},
Title = {Sex-related influences on the neurobiology of emotionally influenced
   memory},
Booktitle = {AMYGDALA IN BRAIN FUNCTION: BACIC AND CLINICAL APPROACHES},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
