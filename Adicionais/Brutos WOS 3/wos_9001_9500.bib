@inproceedings{ WOS:000085197300015,
Author = {El-Fadel, M and Bou-Zeid, E},
Editor = {Sucharov, LJ},
Title = {Transportation emissions in Lebanon: extent and mitigation},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
