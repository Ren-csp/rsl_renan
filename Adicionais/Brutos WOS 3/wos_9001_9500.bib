Booktitle = {OCCUPATIONAL SAFETY AND HYGIENE},
Year = {2013},
Pages = {191-196},
Note = {9th International Symposium on Occupational Safety and Hygiene (SHO),
   Guimaraes, PORTUGAL, FEB 14-15, 2013},
Organization = {Portuguese Soc Occupat Safety \& Hyg; Univ Porto, Fac Engn; Fac
   Motricidade Humana; Univ Politecnica Catalunya; TU Delft; Univ Minho,
   Sch Engn; European Network Safety \& Hlth Profess Org; Int Social Secur
