Title = {A Study on Effective EFL Lecturers at Makassar, Indonesia},
Booktitle = {PROCEEDINGS OF THE 2ND INTERNATIONAL CONFERENCE ON EDUCATION, SCIENCE,
   AND TECHNOLOGY (ICEST 2017)},
