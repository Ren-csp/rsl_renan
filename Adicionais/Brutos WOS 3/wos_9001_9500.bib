@inproceedings{ WOS:000185594700004,
Author = {Scott, JH},
Book-Group-Author = {USDA
   USDA
   USDA},
Title = {Canopy fuel treatment standards for the wildland-urban interface},
Booktitle = {FIRE, FUEL TREATMENTS, AND ECOLOGICAL RESTORATION: CONFERENCE
   PROCEEDINGS},
Series = {USDA Forest Service Rocky Mountain Research Station Proceedings},
Year = {2002},
Number = {29},
Pages = {29-37},
Note = {Conference on Fire, Fuel Treatments, and Ecological Restoration, FT
   COLLINS, CO, APR 16-18, 2002},
Organization = {USDA Forest Serv; Colorado State Forest Serv; Colorado State Univ; Joint
   Fire Sci Program; Soc Amer Foresters; W Forest Fire Res Ctr},
Abstract = {This paper describes a canopy fuel treatment standard based on models of
   crown fire flame size, initiation, spread rate, and firefighter safety.
   Site-specific prescriptions can be developed with NEXUS or nomograms. A
   general prescription designed to be effective at 20-ft windspeeds up to
   25 mph during drought summer fine dead fuel moisture conditions (1-hr =
   4\%, 10-hr = 5\%, 100-hr = 7\%, live = 78\%) calls for a crown-fire-free
   zone (CFFZ) 380 ft wide with a maximum canopy bulk density of 0.10
   kg/m(3). Minimum canopy base height ranges from 2 to 18 ft depending on
   surface fuel conditions; for fuel model 10 (timber litter and
   understory), minimum canopy base height is 13 ft.},
