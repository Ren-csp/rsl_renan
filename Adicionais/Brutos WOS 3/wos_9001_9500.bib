@article{ WOS:000220027000009,
Author = {Lazar, J and Dudley-Sponaugle, A and Greenidge, KD},
Title = {Improving web accessibility: a study of webmaster perceptions},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2004},
Volume = {20},
