@article{ WOS:A1996UY87800004,
Author = {Gavin, J},
Title = {Personal trainers' perceptions of role responsibilities, conflicts, and
   boundaries},
Journal = {ETHICS \& BEHAVIOR},
Year = {1996},
Volume = {6},
Number = {1},
Pages = {55-69},
Note = {103rd Annual Convention of the American-Psychological-Association, NEW
   YORK, NY, AUG 11-15, 1995},
Organization = {Amer Psychol Assoc; Amer Psychol Assoc, Comm Psychol Tests \&
   Assessments},
Abstract = {Two hundred twenty eight experienced personal trainers responded to a
   survey of perceived role responsibilities, conflicts and boundary issues
   in this emerging profession. Data from a 53-item questionnaire were
   analyzed by sex, age, and trainers' levels of experience. Findings
   provide information about why clients are believed to hire personal
   trainers, degrees of responsibility trainers feel for different aspects
   of the relationship, common conflicts experienced in this profession,
   and relationship behaviors considered acceptable or unacceptable. From a
   number of perspectives, the results suggest that trainers may engage in
   and take responsibility for behaviors that fall beyond their legitimate
   domains of competence and influence. These include such activities as
   giving advice to clients about nutrition, lifestyle, and psychological
   agendas. Significant differences were observed when results were
   analyzed by sex, age, and experience level.},
