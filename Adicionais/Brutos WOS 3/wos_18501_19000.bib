@inproceedings{ WOS:A1996BJ20B00387,
Author = {Francis, AL and Nusbaum, HC},
Editor = {Bunnell, HT and Idsardi, W},
Title = {Paying attention to speaking rate},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {1537-1540},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Variability in speaking rare results in a many-re-many mapping between
   acoustic properties in speech and the linguistic interpretation of an
   utterance, In order to recognize the phonetic structure of an utterance,
   listeners must calibrate their phonetic decisions against the rate at
   which the speech was produced. This process of rate normalization is
   fast and effective allowing listeners to maintain phonetic constancy in
   spire of changes in speaking rate. Most of the research on rare
   normalization has investigated the sources of information used by
   listeners to determine the speaking rate, There is an assumption in much
   of this research that the normalization process is a passive,
   automatized filtering process that strips the effects of rate variation
   away from the signal prior to recognition.
   The present study starts from a different perspective by assuming that
   speech perception is carried out by an active perceptual process that is
   specifically needed to address the lack of invariance problem (Nusbaum
   \& Henly, in press), This perspective predicts that increased
   variability from any source, including rate variability, should increase
   the cognitive load during speech perception, Our results support this
   prediction.},
