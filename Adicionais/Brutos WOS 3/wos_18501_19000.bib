Note = {Proceedings of the Sixth International Conference on Spatial Cognition
   (ICSC), Rome, ITALY, SEP 07-11, 2015},
Organization = {Dept Psychol, Sapienza Univ Rome; Catholic Univ Leuven; Cassianeum Fdn;
   Catholic Univ Eichstatt Ingolstadt; LMU Munich; Dept Psychol, Peking
   Univ},
Abstract = {Optimal navigation for a simulated robot relies on a detailed map and
   explicit path planning, an approach problematic for real-world robots
   that are subject to noise and error. This paper reports on autonomous
   robots that rely on local spatial perception, learning, and common-sense
   rationales instead. Despite realistic actuator error, learned spatial
   abstractions form a model that supports effective travel.},
