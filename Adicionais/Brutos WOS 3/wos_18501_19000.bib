   Mukhtar, Marina Ibrahim},
Title = {Elements of Cognitive, Affective and Conative in Problem Solving Process
   for Engineering Students},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2638-2641},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Cognitive is the important element to the success of a student. Students
   who have a good level of thinking is more likely to encouraging academic
   achievement. The previous research shows that cognitive, affective and
   conative able to enhance good and consistency academic performance.
   Affective domain is behaviour that refers to the feelings, interests,
   attitudes, emotions and values. Conative domain refers to intention, a
   tendency toward something, and a deep desire. The study showed the
   elements of cognitive, affective and conative that required in problem
   solving process in engineering students learning at Polytechnic. This
   study applied survey design with quantitative approach. The data was
   analyzed based on descriptive and frequencies to represent the
   respondents' responses. A total of 100 students in engineering field
   from polytechnic have been involved in this study. The results showed
   that strategy, attitude, initiative and intention are elements that
   required for engineering student's learning at Polytechnic in mastering
   problem solving.},
