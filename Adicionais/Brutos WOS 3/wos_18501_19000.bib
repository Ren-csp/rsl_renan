@inproceedings{ WOS:000179444800040,
Author = {El Fiky, U},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Arid desert colonization - Toshka Region, Egypt, as a case study},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {303-311},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The Egyptian government is currently developing a new region called
   Toshka in the south west of Egypt. The project is huge in economical
   terms and a major political decision. The Egyptian government
   participates in the project with only 20\% of the expenses the other
   80\% has to be financed and developed by the private sector. There are
   several problems related to the colonization of this region: First of
   all, the new region is far from the occupied old areas of Egypt so it
   will be difficult to transfer the building materials. Second, the
   project depends on the pulling up of the water from lake Nasser behind
   the Aswan high dam using a pump station that is expensive and poses a
   substantial risk in case of failure. The transfer of energy to the
   region is a challenge. Another aspect is that the region is located in
   an and hot Zone. Therefore, both energy and water have to be conserved
   and one should attempt to work with local materials and local energy
   sources (water and solar). The best way to work in this situation and
   create a sustainable environment is to use the principles of `green
   architecture'. The difficulty, however, is how to reconcile economic,
   moral, and social tradition with green architecture concepts. The main
   aim of this research is to develop a suitable toolbox of principles that
   will lead to identify the important elements of the prototype design for
   this new region of Toshka. The prototype will span building technique
   and the urban design in all its physical, historical, and biological
   aspects rationally and by ways of modem knowledge.},
