Title = {On the Nature of Hearing Protection Devices Usage Prediction},
Booktitle = {OCCUPATIONAL SAFETY AND HYGIENE - SHO2013},
Year = {2013},
Pages = {162-163},
Note = {9th International Symposium on Occupational Safety and Hygiene (SHO),
