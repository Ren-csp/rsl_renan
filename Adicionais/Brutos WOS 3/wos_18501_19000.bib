Title = {A GIS analysis approach for flood vulnerability and risk assessment
   index models at sub-district scale},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON CIVIL AND ENVIRONMENTAL ENGINEERING
   (ICCEE 2019)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
