Title = {Thioarsenate formation in paddy soils},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {259-260},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {Despite the significance of sulfur in controlling arsenic cycling,
   thioarsenate formation has not been studied in paddy soils, yet. Here,
   we combined lab incubation experiments with field porewater sampling
   from two Italian paddy soils to assess the geochemical significance of
   thioarsenate. Incubation data showed formation of both inorganic and
   methylated thioarsenates under flooded conditions, even in the absence
   of extra sulfate addition. Percentages of total arsenic were 12.5\% and
   18.3\%, respectively. All species were also discovered after draining
   the systems for 4 days and re-flooding. Field sampling at rice flowering
   stage further confirmed the existence of inorganic (average 22.3\%) and
   methylated thioarsenates (average 2.2\%) under natural conditions. In
   summary, since our results conclusively prove the occurrence and
   quantitative importance of thioarsenate in paddy soils, their
   environmental fate urgently needs to be addressed.},
