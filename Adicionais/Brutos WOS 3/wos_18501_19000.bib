@inproceedings{ WOS:000346067900453,
Author = {Darnerud, P. O. and Bjermo, H. and Cantillana, T. and Glynn and
   Lindroos, A. K. and Nalsen, C. and Barregard, L. and Jonsson, B. A. G.},
Editor = {Lekkas, TD},
Title = {BIOMONITORING OF TOXIC COMPOUNDS AND ASSOCIATIONS WITH DIETARTY AND
   LIFE-STYLE FACTORS IN A SWEDISH POPULATION-BASED STUDY IN ADULTS},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Riksmaten 2010-11 is a Swedish national survey investigating dietary
   habits among adults (18-80 years), conducted between May 2010 and July
   2011. In this survey, 1797 women and men reported what they ate and
   drank during four consecutive days, and a supplementary questionnaire
   gave information on food items consumed more seldom. Among the
   participants a subgroup was formed consisting of individuals who, in
   addition to dietary registration and questionnaire, also donated blood
   and urine samples. Of the 1008 randomly selected individuals, 300 (30\%)
   chose to participate in the blood and urine sampling.
   Blood (whole blood, serum) and spot urine samples were obtained and
   analysed for the following compounds, or compound groups:
   polychlorinated biphenyls (PCBs) and chloropesticides (i.e. HCB,
   beta-HCH, chlordanes and DDTs), heavy metals (i.e. lead, cadmium and
   mercury), perfluoroalkyl acids (PFAAs), phthalate metabolites and
   bisphenol A (BPA), and brominated flame retardants (i.e. polybrominated
   diphenyl ethers (PBDEs) and HBCD).
   In the case of PCBs and chloropesticides, the higher levels in men may
   be explained by elimination of the POPs among women breastfeeding their
   babies. The proportion of very long-chain n-3 fatty acids in plasma, but
   also consumption of fatty Baltic fish, were positively correlated with
   PCBs and certain other POP compounds. Also the PFAA results suggested
   both breast milk excretion (and hence infant exposure), and an
   association with consumption of fish or blood levels of long-chain fatty
   acids. On the other hand, for phthalates and BPA the indoor environment
   in housing seemed more important. Lower phthalate metabolite levels were
   found in participants living in urban areas compared to those living in
   sparsely-built areas, and lower levels in participants living in houses
   built after 2000, compared tohouses built earlier. Interestingly, also
   the levels of PCB 28 were associated with the age of the residential
   building. The heavy metals data suggested that Pb was associated with
   consumption of alcohol and game meat, Hg with fish consumption, and Cd
   with smoking and iron status. The brominated flame retardant data has
   not yet been statistically analysed.
   This study on dietary and life style factors coupled to serum/whole
   blood and urinary levels of foreign compounds shows that it is possible
   to study individual characteristics that could be statistically
   associated with body burdens of the studied compounds even when this
   population, supposedly mirroring the Swedish adult population, is made
   up of a relative limited number of individuals. The presence of these
   significant associations indicate possible tools in the continuing work
   to lower the exposure to potentially harmful compounds in the general
   population, or in specific population groups.},
Publisher = {GLOBAL NEST, SECRETARIAT},
