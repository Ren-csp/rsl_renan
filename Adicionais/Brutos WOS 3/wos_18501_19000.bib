@inproceedings{ WOS:000341021700023,
Author = {Houser, Shannon H. and Ray, Midge N. and Maisiak, Richard and
   Panjamapirom, Anantachai and Willig, James and Schiff, Gordon D. and
   English, Thomas and Nevin, Christa and Berner, Eta S.},
Editor = {Lehmann, CU and Ammenwerth, E and Nohr, C},
Title = {Telephone Follow-Up in Primary Care: Can Interactive Voice Response
   Calls Work?},
Booktitle = {MEDINFO 2013: PROCEEDINGS OF THE 14TH WORLD CONGRESS ON MEDICAL AND
   HEALTH INFORMATICS, PTS 1 AND 2},
Series = {Studies in Health Technology and Informatics},
Year = {2013},
Volume = {192},
Pages = {112-116},
Note = {14th World Congress on Medical and Health Informatics (MEDINFO),
   Copenhagen, DENMARK, AUG 20-23, 2013},
Abstract = {Follow-up calls after ambulatory visits are not routinely done, yet they
   can potentially detect and mitigate unresolved problems. Automated calls
   via an Interactive Voice Response System (IVRS) are an innovative way to
   conduct follow-up, but patients' attitudes toward follow-up calls are
   unknown. This study assessed I) patient perceptions about follow-up
   calls after visits; 2) differences in perceptions between human and IVRS
   calls; and 3) association between follow-up calls and patient
   satisfaction with care. Post-visit follow-up calls in two ambulatory
   care setting were done in two phases. Phase I used a human caller and
   phase 2 used IVRS. Patient satisfaction questionnaires were completed
   after each phase. Results showed that 88\% of patients favor the idea of
   the calls and those receiving them found them helpful. There were no
   differences in attitudes between patients receiving calls from clinic
   staff or from an IVRS. Patients receiving calls had higher patient
   satisfaction scores than those not called. Conclusion: Patients value
   follow-up calls and they are associated with patient satisfaction with
   care. IVRS is an innovative way to conduct post-visit follow-up.},
