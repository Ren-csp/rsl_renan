@inproceedings{ WOS:000173641300071,
Author = {Bromage, EJ and Springer, JN},
Editor = {Easa, S and Samdahl, D},
Title = {Statewide Travel Demand Forecasting model development system},
Booktitle = {TRANSPORTATION, LAND USE, AND AIR QUALITY, CONFERENCE PROCEEDINGS:
   MAKING THE CONNECTION},
Year = {1998},
Pages = {671-680},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {Travel Demand Forecasting (TDF) models are often developed for a
   specific project or type of analysis. At one end of the scale, a TDF
   model may be developed to cover am entire state with that model network
   representing major roads and traffic analysis zones covering entire
   communities. Conversely, a TDF model may be needed for a site impact
   study or corridor assessment and this geography level may require
   collector and local roads represented along with block group or block
   level traffic analysis zones.
   Especially with larger TDF models, the cost of model development may be
   extremely high in comparison to the overall planning study cost and may
   represent a sizeable share of a project budget. In many cases, in order
   to defray cost, these larger models are represented to also have value
   on smaller projects, thereby spreading the development cost over a
   number of projects. In many cases, the cost of re-configuring a larger
   model to work on local issues has outweighed the cost of simply
   developing a new smaller project model.
   At the North Carolina Department of Transportation (NCDOT) Statewide
   Planning Branch, a large staff of professionals are constantly preparing
   TDF models for use on Thoroughfare Plans in the State's 100 Counties, or
   project specific models for up-grade and small urban area studies. In
   many of these studies new models are developed as existing models may
   not cover the proper geography; may not have the proper level of detail;
   may have outdate demographic data; or are simply not well document and a
   little suspicious. NCDOT has found that having a statewide modeling
   process/database as apposed to a statewide model is a more efficient
   means for developing project specific TDF models. This statewide
   modeling process is actually a Dynamic Modeling System.
   At the heart of the dynamic model is a suite of five (5) core computer
   programs which access three databases. The databases are: 1) modified
   Census Tiger Maps; 2) Census STF 1B block statistics; and 3) continually
   updated State Department of Employment data files. The five core
   computer programs are: 1) Fast Net, an automated network builder; 2)
   Fast-Zone, an automated zone builder and zone connector; 3) Fast\_Emp,
   an automated employer geocoding system: 4) WinSynth, an
   external-external trip table estimator; and 5) TripGen, spreadsheet trip
   generation model which links Fast\_Zone, Fast\_Emp, and WinSynth project
   files. For each NCDOT project, all data tiles are link by way of a
   project folder system. The NCDOT databases and library of programs
   reside on a local area network and are accessible by the more than 70+
   planning branch employees.
   Through the use of this dynamic modeling system (written in a windows
   operating environment), NCDOT can quickly prepare a TDF model which can
   cover a multitude of geographies as large as several counties, or as
   small is a single village. Planners can select for network development
   eight different roadway categories from limited access highways to
   unpaved roads. Traffic analysis zones can be selected to represent
   Census Tracts, Block Groups or Blocks. A typical county level model can
   be constructed in an afternoon using this system which gives more time
   to the engineer to spend in the field verifying conditions and database
   attributes.
   This paper reviews the technical issues involved in the creation of a
   dynamic statewide modeling system. The paper will also provide a case
   study showing the use of the software and databases on large and small
   projects.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
