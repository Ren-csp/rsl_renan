Year = {2011},
Pages = {557-560},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {The volitional regulation development through the process of university
   students' education was investigated. Tendency to self-control and
   volitional traits' self-appraisals in groups of university students from
   different grades (1st grade: n= 100, 2nd grade: n= 69, 3rd grade: n= 90
   and 4th grade: n= 83) were compared. In total, 342 students of ``Academy
   of social management{''} in ages from 17 to 22 take part in our study.
   Chi-Square test shows the significant differences in the level of
   volitional development of students from different years. Students of
   early years demonstrate higher tendency to self-control of their
   behavior (7.67, 0.05) and emotions (8.87, 0.05), and students of later
   years demonstrate higher level of development of their volitional
   traits: responsibility (11.34, 0.01), firmness (7.00, 0.05), efficiency
   (10.55, 0.01), discipline (8.12, 0.05).},
