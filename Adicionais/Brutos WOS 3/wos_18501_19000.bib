   Munaa, Tsogtdulam and Itiritiphan, Fareda and Zhao, Yan},
Editor = {Neale, CMU and Maltese, A},
Title = {Land Degradation Assessment of Agricultural Zone and Its Causes: A Case
   Study in Mongolia},
Booktitle = {REMOTE SENSING FOR AGRICULTURE, ECOSYSTEMS, AND HYDROLOGY XX},
Series = {Proceedings of SPIE},
Year = {2018},
Volume = {10783},
Note = {Conference on Remote Sensing for Agriculture, Ecosystems, and Hydrology
   XX, Berlin, GERMANY, SEP 10-13, 2019},
Organization = {European Opt Soc; European Assoc Remote Sensing Co; Innovat Ctr Sensor
   \& Imaging Syst; Int Soc Photogrammetry \& Remote Sensing; European
   Assoc Remote Sensing Labs; Remote Sensing \& Photogrammetry Soc},
Abstract = {Land degradation is a serious environmental issue in the world. Both
   space and ground-based observations could be used to define the land
   changes and develop the assessment of land degradation. This study
   assessed land degradation in the Orkhon sub-province, the best
   representation sample in the prominent agricultural zone of Mongolia,
   using Landsat Thermal Mapper (TM) and Landsat Operation Land Imager
   (OLI) satellite images during the periods of 1990, 1994, 2000, 2006,
   2010, and 2015. The land degradation of a region could be detected by
   changes in spectral indices and correlation of these indices. The most
   frequently used spectral indices include Land Surface Temperature (LST),
   Normalized Difference Vegetation Index (NDVI), Normalized Difference
   Built-up Index (NDBI), and Normalized Difference Water Index (NDWI).
   These indices were selected as indicators for representing land surface
   conditions vegetation biomass, landscape pattern, micrometeorology and
   human activities. The land degradation analysis was described by
   descriptive statistics, correlation distributions and correlation
   coefficients of changes in index outputs. In addition, the validations
   of these indices were also verified by comparing LST and NDWI index
   values with in-situ, real-time climate data from 1984 to 2010. The Land
   Degradation Risk Mapping (LDRM) analysis shows that the agricultural and
   urban areas experienced degradation due to human activities and this has
   led to decline in the soil moisture in this region.},
