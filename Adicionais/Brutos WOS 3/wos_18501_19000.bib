@article{ WOS:000081253500008,
Author = {Krebs, P and Holzer, P and Huisman, JL and Rauch, W},
Title = {First flush of dissolved compounds},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1999},
Volume = {39},
Number = {9},
