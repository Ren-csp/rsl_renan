@inproceedings{ WOS:000084315100054,
Author = {Klemm, EB and Iding, MK and Speitel, TW},
Editor = {Abrams, R},
Title = {Perceived credibility of environmental information from media: Teachers'
   and scientists' views},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {208-214},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {Precollege science teaching is moving from dependency on textbooks to
   facilitated inquiry using many information sources. This study compares
   preservice teachers{''} and scientists{''} ratings of the credibility of
   information sources on environmental risk, Findings suggest gaps in
   perceptions.
   Much of our understanding of the world today-and whether it is a safe or
   highly risky place-is colored by information gained through media. The
   purpose of most commercial media is to entertain, not to educate.
   However, the general public is obtaining its information about science
   and technology from media (Kyle,1995, Nelkin, 1995). Given the movement.
   in modern education away from sole reliance an textbook-oriented
   instruction to thematic, interdisciplinary inquiry into real world
   contexts, and given the shift from traditional didactic teaching to
   constructivist approaches to instruction, the question of how teachers
   make determinations of credibility of information sources becomes
   crucial.
   Since the area of risk education represents one topic where highly
   dramatic media accounts proliferate and is also an area where the
   general public's perceptions of environmental risks diverges markedly
