@inproceedings{ WOS:000659907503029,
Author = {Barmashova, I, T. and Lazutkina, V, E.},
Book-Group-Author = {IOP},
Title = {Bioethics as effective method for preserving biological diversity on
   Earth},
Booktitle = {III INTERNATIONAL SCIENTIFIC CONFERENCE: AGRITECH-III-2020:
   AGRIBUSINESS, ENVIRONMENTAL ENGINEERING AND BIOTECHNOLOGIES, PTS 1-8},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
Volume = {548},
Note = {3rd International Conference on Agribusiness, Environmental Engineering
   and Biotechnologies (AGRITECH), Krasnoyarsk, RUSSIA, JUN 18-20, 2020},
Organization = {Int \& Russian Union Sci \& Engn Assoc; Krasnoyarsk Reg Union Sci \&
   Engn Assoc; Krasnoyarsk State Agrarian Univ; Krasnoyarsk Sci \& Technol
   City Hall},
Abstract = {Man is not the only living creature on our planet. In order to remain
   man in the highest sense of the word, he must build his relations on the
   basis of the principle of humanism, not only with his own kind, but also
   with all living beings. Bioethics is essentially a kind of a model of a
   person's relationship with all living things in this world. However,
   while the worldview principle of anthropocentrism dominates the world,
   the principles of bioethics cannot be fully realised. Such an attitude
   not only violates the principle of co-evolution, but inevitably destroys
   the spiritual world of man. The aim of this article is to explicate
   bioethics as humanism which gives the relationship between humans and
   animals an axiological character in which the life of an animal is
   considered of value. The work emphasises the relevance of replacing the
   principle of anthropocentrism with the principle of biocentrism, which
   implies a humane attitude to everything living in the world. The
   principles of bioethics are more consistent with the principle of
   harmonious coexistence of man and nature, the implementation of the
   proper attitude of man to living beings, located below him on the
   evolutionary ladder. The process of personality education should involve
   not only the acquisition of knowledge, the assimilation of moral norms
   of behaviour regarding people, but also the formation of their practical
   readiness and the need for a humane attitude to animals. An important
   task of mankind is conservation of biological diversity on our planet.},
