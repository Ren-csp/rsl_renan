Pages = {419-428},
Note = {13th International Conference of the
   Hong-Kong-Society-for-Transportation-Studies, Hong Kong, PEOPLES R
   CHINA, DEC 13-15, 2008},
Organization = {Hong Kong Soc Transportat Studies; City Univ Hong Kong, Coll Business,
   Dept Management Sci},
Abstract = {Many transportation studies, ranging from master planning of transport
   networks to traffic control and congestion management, are conducted
   each year due to the need to provide transport infrastructure with
   sufficient capacity to meet expected travel demand. Decisions on
   substantial amounts of investment in transport facilities are made on
   the basis of findings from such studies. There has been a proliferation
   of models and software packages developed to assist in carrying out
   these studies. It is debatable whether the use of these models help in
   improving the planning of urban transport facilities or in solving
   congestion problems. In this paper, some of the issues and challenges in
   planning and congestion management are discussed. Experiences gained in
   Singapore's effort in demand management to control recurrent congestion
   are also presented.},
