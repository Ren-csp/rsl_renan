@article{ WOS:000220359300005,
Author = {Sangren, PS},
Title = {Psychoanalysis and its resistances in Michel!Foucault's The History
   of Sexuality: Lessons for anthropology},
Journal = {ETHOS},
Year = {2004},
Volume = {32},
Number = {1},
Pages = {110-122},
Month = {MAR},
Note = {Cornell Symposium on the History of Sexuality, Cornell Univ, New York,
   NY, MAR 08, 2003},
Abstract = {This article argues that Foucault's influential The History of
   Sexuality, Volume 1 embodies a tension between an explicit theory of the
   discursive production of ``the subject{''} and an implicit resistance to
   the reality of this same revelation. This tension is shown to parallel
   the organization of desire understood in psychoanalytic terms-that is to
   say, desire is an emergent effect linked to our resistances to the
   social worlds that produce us. Consequently, despite The History of
   Sexuality's antipathy to psychoanalysis, its most redeeming
   interpretation may be a psychoanalytic one. Anthropological interest in
   the ``cultural construction{''} of personhood, emotions, and similar
   categories bears important affinities to Foucault's discursive
   productivity. Consequently, the concept of culture manifest in such
   notions requires incorporating desires resistances. Moreover,
   complicating our understanding of culture in these terms facilitates
   understanding both human commonalities and the character of cultural
   differences.},
