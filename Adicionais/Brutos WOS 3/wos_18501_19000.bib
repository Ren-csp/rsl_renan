@inproceedings{ WOS:000225380300004,
Author = {Basson, R},
Editor = {Allen, IC and Alder, B and Pawson, M},
Title = {The complexities of women's sexual arousal and subtypes of arousal
   disorder]},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE OF PSYCHOSOMATIC
   OBSTETRICS AND GYNAECOLOGY},
Year = {2004},
Pages = {19-26},
Note = {14th International Conference of Psychosomatic Obstetrics and
   Gynaecology, Edinburgh, SCOTLAND, MAY 16-19, 2004},
Organization = {Int Soc Psychosomat Obstet \& Gynaecol},
Abstract = {Sexual arousal comprises subjective sexual excitement and physiological
   changes, including genital vasocongestion. The evidence to date is that
   the vast majority of women complaining of chronic arousal disorder
   genitally vasocongest within seconds in response to a sexual stimulus -
   even though the stimulation fails to excite their minds and may produce
   negative emotions. For women with and without sexual dysfunction, there
   is highly variable, often poor correlation between their subjective
   sexual excitement and genital vasocongestion. When subjective arousal is
   experienced, it triggers or enhances desire. Thus comorbidity of desire
   and arousal dysfunction is common. The majority of women with arousal
   disorder report that sexual stimuli of all types are ineffective.
   Recently proposed definitions of arousal disorder delineate a small
   subgroup of women who retain sexual interest and desire, as well as
   subjective sexual excitement from nongenital stimuli. Some of the
   subgroup have demonstrably reduced genital vasocongestion. Others have
   lost sexual sensitivity of physiologically engorged tissues.},
