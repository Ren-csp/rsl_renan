@inproceedings{ WOS:000269652300019,
Author = {Pantev, Christo and Lappe, Claudia and Herholz, Sibylle C. and Trainor,
   Laurel},
Editor = {DallaBella, S and Kraus, N and Overy, K and Pantev, C and Snyder, JS and Tervaniemi, M and Tillmann, B and Schlaug, G},
Title = {Auditory-Somatosensory Integration and Cortical Plasticity in Musical
   Training},
Booktitle = {NEUROSCIENCES AND MUSIC III: DISORDERS AND PLASTICITY},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
