@inproceedings{ WOS:000075973900021,
Author = {Finkl, CW and Esteves, LS},
Editor = {Tait, LS},
Title = {The state of our shores: A critical evaluation of the distribution,
   extension, and characterization of beach erosion and protection in
   Florida},
Booktitle = {RETHINKING THE ROLE OF STUCTURES IN SHORE PROTECTION},
Year = {1998},
Pages = {302-318},
Note = {11th Annual National Conference on Beach Preservation Technology, ST
   PETERSBURG, FL, FEB 04-06, 1998},
Abstract = {Florida's 1300 km of beaches comprise about 25\% of the US mainland
   sandy shores. In 1985, about 225 km of Florida beaches (17\% by length)
   were designated as being in a state of ``critical erosion;{''} by 1993,
   the length of critically eroding shore had increased to 370 km (28\% of
   total beach length) in spite of mitigation efforts. Our assessment of
   the condition of Florida beaches is based on interpretations of 22 maps
   prepared at a nominal scale of about 1250,000 (1 mm = 0.250 km; 1 in =
   3.94 miles). Of Florida's 35 coastal counties, the 12 Atlantic ones take
   in 583 km of exposed shoreline (excluding Key Biscayne and south through
   the Florida Keys) while the 23 Gulf coast counties make up about 1200 km
   of exposed shore. Shores on both coasts were mapped by county into
   coastal segments on the basis of five primary conditions: (1) dominant
   natural shoreline environments, (2) levels of urban development, (3)
   trends in shoreline change, (4) coastal protection works, and (5)
   environmental concerns (sensitive ecological communities). Secondary
   parameters were related to wave energy, net longshore sediment
   transport, and tidal range. These parameters permitted potential
   classification of Florida shores into 36 different classes.
   Map analysis shows that beach replenishment: (1) curtails erosion of the
   shoreline being protected, (2) is associated with developed shores, (3)
   affects the way shoreline change is estimated, and (4) prejudices the
   definition of ``critical erosion.{''} Surprisingly, over the long term
   (100-year reference for change in shoreline position) shorelines are
   stable (about 60\% of the total sandy beach length) except in areas
   downdrift from stabilized inlets (about 16\% by length).},
Publisher = {FLORIDA SHORE \& BEACH PRESERVATION ASSOCIATION},
Address = {2952 WELLINGTON CIRCLE, TALLAHASSEE, FL 32301 USA},
Type = {Proceedings Paper},
Language = {English},
