@inproceedings{ WOS:000410925400014,
Author = {Chaldezos, I. P. and Karytsas, C. S.},
Editor = {Bikas, D and Theodosiou, T and Katerina, T},
Title = {Innovative High Efficiency Closed Loop Ground Coupled Heat exchanger
   (GCHE)},
Booktitle = {SUSTAINABLE SYNERGIES FROM BUILDINGS TO THE URBAN SCALE},
Series = {Procedia Environmental Sciences},
