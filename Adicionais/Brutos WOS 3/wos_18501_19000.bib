@inproceedings{ WOS:000450565500070,
Author = {Cardenas, J. and Osma, G. and Gutierrez, J. and Merchan, A. and Ordonez,
   G.},
Editor = {GalianoGarrigos, A and Brebbia, CA},
Title = {Characterization of environmental and energy performance of an average
   social dwelling in a tropical region of Colombia},
Booktitle = {SUSTAINABLE CITY XI},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2016},
Volume = {204},
Pages = {859-870},
Note = {11th International Conference on Urban Regeneration and Sustainability
   (SC), Alicante, SPAIN, 2016},
Organization = {Wessex Inst; Univ Alicante; WIT Transact Ecol \& Environm; Int Journal
   Sustainable Dev \& Planning; Int Journal Design \& Nat \& Ecodynam},
Abstract = {This work shows the characterization of the conditions of indoor
   environment and energy behavior of a type of social dwelling of 46
   square meters, which will be replicated in several projects in
   Bucaramanga (Colombia). This city is located 7.1 degrees north latitude
   and 71.3 degrees west longitude to 960 masl. This characterization is
   made from simulations of a virtual model made in DesignBuilder. The
   validation of the model was made from measurements such as of air
   temperature, humidity, daylighting and energy consumption. The four
   points of the compass were considered in the energy simulations due to
   the fact that this type of dwelling was built for several orientations
   in the first project. The simulations were done for daily, monthly and
   annual periods. The results indicate that the dwelling has high values
   of thermal gains by occupation and heat that enters through the glazing.
   The indoor temperature varies between 23 degrees C and 31 degrees C,
   although that depends on the orientation of the dwelling. The west
   orientation is the best option because it reduces the annual time that
   the indoor temperature is above 26 degrees C. With respect to relative
   humidity, the variation is between 55\% and 81\% which are common values
   for natural ventilated inner spaces in this city. However, these mixed
   conditions cause thermal discomfort for users for most part of suntime
   (6 a.m. to 6 p.m.) all year. In contrast with that, the daylight level
   is satisfactory for most inner space between 8 a.m. and 4 p.m. The
   electrical energy consumption can vary between 1200 kWh and 2400 kWh per
   year. Finally, an analysis in detail for some inner spaces is presented
   in the document.},
