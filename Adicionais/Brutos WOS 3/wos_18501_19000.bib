@inproceedings{ WOS:000396755600173,
Author = {Cretu, Romeo Zeno and Burcas, Sylvia},
Editor = {Chraif, M and Vasile, C and Anitei, M},
Title = {Self efficacy: a moderator of the relation between Emotional Dissonance
   and Counterproductive Work Behavior},
