@inproceedings{ WOS:000081273000027,
Author = {Grasso, R and Glasauer, S and Georges-François, P and Israël, I},
Editor = {Cohen, B and Hess, BJM},
Title = {Replication of passive whole-body linear displacements from inertial
   cues -: Facts and mechanisms},
Booktitle = {OTOLITH FUNCTION IN SPATIAL ORIENTATION AND MOVEMENT},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {1999},
Volume = {871},
Pages = {345-366},
Note = {Conference on Otolith Function in Spatial Orientation and Movement -
   Symposium in Memory of Volker Henn, ZURICH, SWITZERLAND, MAY 18-19, 1998},
Organization = {Zurich Univ Hosp; Betty \& David Koetser Fdn Brain Res},
Abstract = {Using path integration, normal subjects should be able to compute the
   distance of a traveled path even from the sole inertial sensory input,
   Blindfolded subjects were submitted to a passive linear forward
   displacement along 2 to 10 m. Their task was to replicate the traveled
   distance, still blindfolded, by driving the vehicle they were seated
   upon using a joystick that controlled linear speed.
   Subjects replicated both the length and the velocity profile of the
   passive travel, suggesting that a dynamic record of experienced motion
   is stored in memory. Even when the replication of passive motion
   dynamics was made impossible, the subjects could still replicate the
   displacement.
   The results are explained by a dynamic feedback model that performs a
   running comparison between the perceived instantaneous displacement of
   the ongoing motion and the displacement derived from a spatiotemporal
   record of perceived passive motion. A multimodal acceleration-related
   sensory input is transformed into a displacement-related perception
   through double time-integration.},
