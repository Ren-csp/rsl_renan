@inproceedings{ WOS:000432877200054,
Author = {O'Sullivan, Grazyna and Toma, Sorin-George and Marinescu, Paul},
Book-Group-Author = {Bucharest Univ Econ Studies},
Title = {THE SOCIAL RESPONSIBILITY OF HIGHER EDUCATION ORGANIZATIONS: THE CASE OF
   A POLISH FACULTY},
Booktitle = {BASIQ 2015 INTERNATIONAL CONFERENCE: NEW TRENDS IN SUSTAINABLE BUSINESS
   AND CONSUMPTION},
Series = {Proceedings of BASIQ},
Year = {2015},
Pages = {441-448},
