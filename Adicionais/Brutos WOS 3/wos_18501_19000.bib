@inproceedings{ WOS:000400299900009,
Author = {Cronk, Reet and Davis, Christopher},
Editor = {Erickson, GS and Rothberg, HN},
Title = {A Theoretical Investigation of the Relationship Between Emotional
   Intelligence, Social Capital and Knowledge Sharing},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON INTELLECTUAL CAPITAL
   KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2016)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2016},
Pages = {82-88},
Note = {13th International Conference on Intellectual Capital Knowledge
   Management and Organisational Learning (ICICKM), Ithaca Coll, Ithaca,
   NY, OCT 14-15, 2016},
Organization = {Marist Coll},
Abstract = {One of the greatest challenges for the Information Age is to create an
   organization that can share knowledge. The factors that impact knowledge
   sharing have been the subject of much research. Two of these factors are
   social capital and emotional intelligence. The role of emotions has
   drawn particular attention as we move forward into the 21st century.
   Beginning in the early 1990s the construct of emotional intelligence
   captured the attention of organizational behaviour scholars. This
   construct is now of interest to a wide range of disciplines including
   science where the study of emotional intelligence is being applied to
   the design of human facing intelligent robots. This paper examines the
   theoretical relationships between these three constructs; Emotional
   Intelligence, Social capital and Knowledge Sharing via examination of a
   broad range of construct definitions and subsequent logical deduction. A
   theoretical model is constructed which may serve as the basis for
   further empirical research.},
