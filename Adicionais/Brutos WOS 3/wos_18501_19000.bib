@article{ WOS:000399358400072,
Author = {Mustaffa, Che Su},
Title = {Family Communication on Facebook: A Comparative Analysis from
   Parent-Child Perspective},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {1, SI},
Pages = {295-299},
Month = {JAN},
Note = {Conference on Advanced Research on Business, Management and Humanities
   (ARBUHUM), Bandung, INDONESIA, MAR 15-17, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {A deeper understanding of family communication is essential in order to
   prepare for effective communication. Therefore, research needs to pay
   attention on the role of social media that influence both parent-child
   communication experiences. The purpose of this paper is to explore
   parent-child communication on Face book in the reality of the growing
   interest in social media and family communication in Malaysian contexts,
   discusses the current issues and offers a future research perspective.
   The paper is based on qualitative approach by conducting an in-depth
   interview. It offers to understand perception toward the areas of family
   communication in Malaysian contexts. This paper uncovered the perception
   of child and parent on how Face book influences their interaction and
   helps strengthen the relationship between parent-child. In sum, this
   study provides theoretical contributions to family communication
   research and the literature on social media context. The finding
   provides support for the effects of social media on parent-child
   relationships. This study also highlights the use of Facebook in
   conjunction with privacy management theories in explaining the concept
   of relationships in family communication relationships from both parent
   and child perspectives.},
