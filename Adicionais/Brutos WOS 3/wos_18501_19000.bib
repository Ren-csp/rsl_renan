@inproceedings{ WOS:000226134300023,
Author = {Aou, S and Inoue, T and Fujimoto, T and Mizuno, M and Oomura, Y and
   Kubo, K and Arai, O},
Editor = {Nakagawa, H and Ishii, K and Miyamoto, H},
Title = {Chemical impacts on higher brain functions},
Booktitle = {BRAIN-INSPIRED IT I},
