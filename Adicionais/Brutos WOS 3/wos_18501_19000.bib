@inproceedings{ WOS:000390838800003,
Author = {Ren, T. and Gao, X. R. and Zheng, T. and Wang, P.},
Editor = {Scholz, M},
Title = {Study on Treatment of acidic and highly concentrated fluoride waste
   water using calcium oxide-calcium chloride},
Booktitle = {INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT 2016
   (WRE2016)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2016},
Volume = {39},
Note = {2nd International Conference on Water Resource and Environment (WRE),
   Shanghai, PEOPLES R CHINA, JUL 23-26, 2016},
Abstract = {There are problems with treating acidic waste water containing high
   concentration fluorine by chemical precipitation, including the low
   sludge setting velocity and the high difficulty of reaching the
   criterion. In Heilongjiang province, a graphite factory producing
   high-purity graphite generates acidic waste water with a high
   concentration of fluorine. In this paper, the effect of removals on the
   concentration of fluoride with the combined treatment of calcium oxide
   and calcium chloride were discussed with regard to acid waste water. The
   study improved the sludge characteristics by using polyacrylamide (PAM)
   and polymeric aluminum chloride (PAC). The effect of different
   coagulants on sludge was evaluated by the sludge settlement ratio (SV),
   sludge volume index (SVI) and sludge moisture content. The results
   showed that the optimal combination for 100 ml waste water was calcium
   oxide addition amount of 14 g, a calcium chloride addition amount of 2.5
   g, a PAM addition amount of 350 mg/L, and the effluent fluoride
   concentration was below 6 mg/L. PAM significantly improved the sludge
   settling velocity. The sludge settlement ratio reduced from 87.6\% to
   60\%. The process for wastewater treatment was easily operated and
   involved low expenditure.},
