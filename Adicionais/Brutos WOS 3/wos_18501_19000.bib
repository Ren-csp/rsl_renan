@inproceedings{ WOS:000560968000015,
Author = {Seth, Anil K. and Verschure, Paul F. M. J. and Blanke, Olaf and Butz,
   Martin V. and Ford, Judith M. and Frith, Chris D. and Jacob, Pierre and
   Kyselo, Miriam and McGann, Marek and Menary, Richard and Morsella,
   Ezequiel and O'Regan, J. Kevin},
