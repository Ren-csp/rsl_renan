Title = {An Analysis on Carbon Emissions and Energy Efficiency of Small Heavy
   Industrial Enterprises in Shanghai},
Booktitle = {SUSTAINABLE DEVELOPMENT OF INDUSTRY AND ECONOMY, PTS 1 AND 2},
