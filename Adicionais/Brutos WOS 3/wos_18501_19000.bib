@inproceedings{ WOS:000252307300056,
Author = {Bayraktar, Saban and Ayberk, Savas and Durmusoglu, Ertan and Karademir,
   Aykan},
Editor = {Wang, Y and Li, SC and Huang, P and Yang, YH and An, Y and Sun, XY},
Title = {Noise maps for traffic noise analysis: Kocaeli case study},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND TECHNOLOGY, VOL I},
Year = {2007},
Pages = {316-322},
Note = {International Symposium on Environmental Science and Technology,
   Beijing, PEOPLES R CHINA, NOV 13-16, 2007},
Organization = {Chinese Soc Environm Sci; Beijing Inst Technol},
Abstract = {Traffic noise is an increasing environmental problem in terms of
   nuisance and annoyance to people in the communities living in the center
   o crowded cities. In Turkey, the noise related studies are usually
   limited to the determination of the noise levels and comparison to the
   national/internationa standards. To date, noise maps were not used in
   order to planning of traffic routes and urban development in Turkey. In
   this study, first, the traffic related noise was determined in the main
   roads in the city center of Kocaeli. For this purpose, the
   characteristics of buildings and road conditions were examined and
   vehicles were counted in the morning, in the afternoon, in the evening
   and at night in the selected roads. Then, the 2-Dimensional noise maps
   were created fer, different conditions using Predictor V5.04 software.
