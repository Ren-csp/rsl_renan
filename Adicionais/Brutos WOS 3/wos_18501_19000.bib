@inproceedings{ WOS:001759203800015,
Author = {Mugabushaka, Adrien and Li, Zhenhong and Mihigo, David},
Editor = {Potel, J and Labbassi, K and Tesfamichael, S and Annegarn, H and Kufoniyi, J and Wade, S},
Title = {Impact of Using Surveying Instruments in Land Subdivision and
   Demarcation in Sub-Sahara African Countries the Case of Rwanda Parcels},
Booktitle = {SPACE AND GEOSPATIAL TECHNOLOGIES FOR THE AFRICA WE WANT, AARSE 2022},
