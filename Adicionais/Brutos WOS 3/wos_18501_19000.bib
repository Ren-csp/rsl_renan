@inproceedings{ WOS:000086564100021,
Author = {Tomori, O},
Editor = {Saluzzo, JF and Dodet, B},
Title = {Options for the control of rodent-borne viral diseases in West Africa},
Booktitle = {EMERGENCE AND CONTROL OF RODENT-BORNE VIRAL DISEASES (HANTAVIRAL AND
   ARENAL DISEASES): EMERGING DISEASES},
Year = {1999},
Pages = {207-211},
Note = {2nd Symposium on Emerging Diseases, ANNECY LE VIEUX, FRANCE, OCT 28-31,
   1998},
Organization = {Marcel Merieux Fdn},
Abstract = {Over 30 different viruses have been isolated from wild rodents in West
   Africa. These viruses can be classified into three groups. While the
   public health significance of many of these rodent-'associated' viruses
   remains undefined, three of the rodent-borne viruses, Lassa, C-CHF and
   Mokola are known to cause human infections with high morbidity and major
   mortality. In Nigeria, for example, more than 17\% of over 7,500 trapped
   animals were Mastomys natalensis, the natural reservoir of Lassa virus.
   Similarly, shrews commonly found in households harbor Mokola virus, a
   rabies-related virus, shown to cause illness and death in humans. The
   Congo-Crimean hemorrhagic fever (C-CHF) virus, which causes serious
   disease in the Democratic Republic of Congo and epidemics with high
   mortality rates in East Africa and Asia, has been isolated on numerous
   occasions in parts of West Africa, where it has not yet been
   incriminated as a cause of human disease.
   Presently, there is no vaccine against infections caused by these
   viruses, therefore rodent control is clearly the most viable option in
   the control of these diseases. However, given the current poor level of
   environment tal sanitation and apparent public indifference to the
   health hazards of rodents in rural and urban Africa, reducing domestic
   and peridomestic rodent populations and limiting human contact with
   these rodents pose a daunting problem. An integrated research and
   control program focusing on public health education, personnel training,
   environmental management and rodenticidal measures is needed. Concurrent
   with this approach is the urgent necessity to improve disease
   surveillance and laboratory diagnosis, and to explore new approaches for
   the development of vaccines, especially for the Lassa virus.},
Publisher = {EDITIONS SCIENTIFIQUES ET MEDICALES ELSEVIER},
