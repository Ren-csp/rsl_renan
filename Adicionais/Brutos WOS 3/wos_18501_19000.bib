@inproceedings{ WOS:000365992100017,
Author = {Teleman, Elena-Carmen and Axinte, Elena and Baetu, Georgeta and Silion,
   Radu and Rosca, Elena-Victoria},
Book-Group-Author = {SGEM},
Title = {EXPERIMENTS IN WIND TUNNEL REGARDING THE SIMULATION OF WIND ACTION
   EFFECTS ON THE SOLAR PANELS PLACED ON THE ENVELOPE OF HIGH RISE
   BUILDINGS},
Booktitle = {GEOCONFERENCE ON ENERGY AND CLEAN TECHNOLOGIES},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {127-134},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {During the last decades we assist to enlarging and enhancing of the
   global concept of sustainable development and the desire of drastically
   reduction of the consumption of the world's resources is a constant
   preoccupation.
   Urban agglomerations are among greatest energy consumers and in this
   respect multistorey buildings are most representative. Placing solar
   collectors on the envelope of these buildings is not only an attractive
   solution of obtaining low cost energy but also a sustainable development
   concept. Numerous technical solutions are adopted for solar collectors
   to be part of the facades of buildings but the impact of their presence
   while anticipated is not wholly covered by experience yet.
   Wind tunnels that reproduce the atmospheric boundary layer proved to be
   essential for studies of the effects of wind climate upon built
   environment of any kind and particularly, the effect of wind action on
   the walls of high rise buildings is a subject of continuous interest.
   The turbulence of wind action plays a governing role in the occurrence
   of failure mechanisms in the elements that envelope the buildings and
   the different systems adopted for the solar panels might have increased
   sensibilities to this action. The dynamic effects including vibrations
   that induce fatigue and resonance of the elements as parts of systems
   (glass, steel etc.) may be expected.
   The study shows possibilities of obtaining via laboratory the extreme
   values used for the design to wind action of the structural systems of
   solar panels. The interference between wind and building is studied via
   wind local pressure or suction and the dynamic effects of the
   atmospheric turbulence are analyzed through direct determination of the
   peak factors from the local power spectrum density.},
Publisher = {STEF92 TECHNOLOGY LTD},
