@article{ WOS:000235760700011,
Author = {Brown, LM and Bradley, MM and Lang, PJ},
Title = {Affective reactions to pictures of ingroup and outgroup members},
Journal = {BIOLOGICAL PSYCHOLOGY},
Year = {2006},
Volume = {71},
Number = {3},
