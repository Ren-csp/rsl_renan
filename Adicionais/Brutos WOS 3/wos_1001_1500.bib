@inproceedings{ WOS:000226781800003,
Author = {Eide, D},
Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {Emotions: From ``ugly duckling{''} via ``invisible asset{''} toward an
   ontological reframing},
Booktitle = {EMOTIONS IN ORGANIZATIONAL BEHAVIOR},
Year = {2005},
Pages = {11-41},
Note = {Conference on Emotions in Organizational Life, Bond Univ, Gold Coast,
   AUSTRALIA, JUN   03, 2002},
Abstract = {The ability to cope and act in capable ways with and through emotions
   has become vital as more people and organizations become involved in
   work intensive on social interactions, emotional labor, and/or changes.
   However, linking emotions to capable activity challenges traditional
   views on organizations and knowledge. This chapter argues that the shift
   from seeing emotions as an ``ugly duckling{''} to an ``invisible
   asset{''} is not sufficient in order to understand emotions in
   organizations; a more radical rethinking is needed. A
   situated-relational ontology is suggested where emotions are seen as one
   of the fundamental and inseparable parts of being human, and
   consequently also of human knowledge and action in organizations.},
