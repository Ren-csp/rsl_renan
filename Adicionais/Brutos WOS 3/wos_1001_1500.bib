Author = {Makita, Meiko and Woolrych, Ryan and Sixsmith, Judith and Murray,
   Michael and Menezes, Deborah and Fisher, Jenny and Lawthom, Rebecca},
Title = {Place (in)securities: older adults' perceptions across urban
   environments in the United Kingdom ((In)seguridades de lugar.
   Percepciones de las personas mayores en distintos entornos urbanos del
   Reino Unido)},
