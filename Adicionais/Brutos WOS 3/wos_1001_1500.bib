Note = {4th Workshop on Harmonization with Atmospheric Dispersion Modelling for
   Regulatory Purposes, OOSTENDE, BELGIUM, MAY 06-09, 1996},
Organization = {Initiat Harmonizat Atmospher Dispers Modelling Regulatory Purposes},
Abstract = {Numerical computations and field experiments of the dispersion of a
   tracer gas from a road tunnel in Paris are compared. The
   Reynolds-averaged Navier-Stokes equations, combined with the k-epsilon
   turbulence model of Chen and Kim, are solved using the finite-volume
   code PHOENICS. Results are shown to be sensitive to the turbulence
   modelling and to the parameterization of turbulence and drag forces
   generated by traffic.},
