@inproceedings{ WOS:000260019400025,
Author = {Abramovic, B. and Petrovic, M. and Zavada, J. Blaskovic},
Editor = {Brebbia, CA},
Title = {Use of railways for urban passenger transport},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
