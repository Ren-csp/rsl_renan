@inproceedings{ WOS:000768467300008,
Author = {Tang, Cheng and Wang, Di and Tan, Ah-Hwee and Miao, Chunyan},
Editor = {Zeng, Y and He, Y and Kotaleski, JH and Martone, M and Xu, B and Peng, H and Luo, Q},
Title = {EEG-Based Emotion Recognition via Fast and Robust Feature Smoothing},
Booktitle = {BRAIN INFORMATICS, BI 2017},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2017},
Volume = {10654},
Pages = {83-92},
Note = {International Conference on Brain Informatics (BI), Beijing, PEOPLES R
   CHINA, NOV 16-18, 2017},
Organization = {Beijing Univ Technol; Chinese Acad Sci, Inst Automat, Res Ctr Brain
   Inspired Intelligence; Web Intelligence Consortium; IEEE Computat
   Intelligence Soc Task Force Brain Informat; Beijing Adv Innovat Ctr
   Future Internet Technol, Fac Informat Technol; Chinese Soc Cognit Sci;
   Chinese Assoc Artificial Intelligence; Int Neural Network Soc; Allen
   Inst Brain Sci; Springer LNCS LNAI; PsyTech Elect Technol Co Ltd;
   Beijing 7Invensun Technol Co Ltd; John Wiley \& Sons Inc; Synced Technol
   Inc},
Abstract = {Electroencephalograph (EEG) signals reveal much of our brain states and
   have been widely used in emotion recognition. However, the recognition
   accuracy is hardly ideal mainly due to the following reasons: (i) the
   features extracted from EEG signals may not solely reflect one's
   emotional patterns and their quality is easily affected by noise; and
   (ii) increasing feature dimension may enhance the recognition accuracy,
   but it often requires extra computation time. In this paper, we propose
   a feature smoothing method to alleviate the aforementioned problems.
   Specifically, we extract six statistical features from raw EEG signals
   and apply a simple yet cost-effective feature smoothing method to
   improve the recognition accuracy. The experimental results on the
   well-known DEAP dataset demonstrate the effectiveness of our approach.
   Comparing to other studies on the same dataset, ours achieves the
   shortest feature processing time and the highest classification accuracy
   on emotion recognition in the valence-arousal quadrant space.},
