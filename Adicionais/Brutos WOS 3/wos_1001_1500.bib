@inproceedings{ WOS:000288208700004,
Author = {Elfenbein, Hillary Anger and Polzer, Jeffrey T. and Ambady, Nalini},
Editor = {Hartel, CEJ and Ashkanasy, NM and Zerbe, WJ},
Title = {TEAM EMOTION RECOGNITION ACCURACY AND TEAM PERFORMANCE},
Booktitle = {FUNCTIONALITY, INTENTIONALITY AND MORALITY},
Series = {Research on Emotion in Organizations},
Year = {2007},
Volume = {3},
Pages = {87-119},
Note = {5th International Conference on Emotions and Worklife (Emonet V),
   Atlanta, GA, AUG 10-12, 2006},
Abstract = {Teams' emotional skills can be more than the sum of their individual
   parts. Although theory emphasizes emotion as an interpersonal
   adaptation, emotion recognition skill has long been conceptualized as an
   individual-level intelligence. We introduce the construct of team
   emotion recognition accuracy (TERA) - the ability of members to
   recognize teammates' emotions - and present preliminary evidence for its
   predictive validity. In a field study of public service interns working
   full-time in randomly assigned teams, taken together positive and
   negative TERA measured at the time of team formation accounted for
   28.1\% of the variance in team performance ratings nearly a year later.},
