@article{ WOS:000433978400043,
Author = {Liu, Xin and Wang, Qisong and Liu, Dan and Wang, Yuan and Zhang, Yan and
   Bai, Ou and Sun, Jinwei},
Title = {Human emotion classification based on multiple physiological signals by
   wearable system},
