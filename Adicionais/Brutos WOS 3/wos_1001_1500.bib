Title = {Perceived Parenting Styles, Emotion Recognition and Regulation in
   Relation to Psychological Well-Being},
Booktitle = {5TH WORLD CONFERENCE ON PSYCHOLOGY, COUNSELING AND GUIDANCE, WCPCG-2014},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
Volume = {159},
Pages = {529-533},
Note = {5th World Conference on Psychology, Counseling and Guidance (WCPCG),
   Dubrovnik, CROATIA, MAY 01-03, 2014},
Abstract = {The purpose of the current study was to examine the link among perceived
   parenting styles, emotion recognition, emotion regulation, and
   psychological well-being in terms of obsessive-compulsive disorder and
   social anxiety symptoms. For the purpose of this study, 522 adults
   between the ages of 18 and 36 participated in the current study.
   Multiple regression analyses with split-sample validation method
   revealed that maternal rejection, emotion recognition, cognitive
   reappraisal and suppression were associated with social anxiety
   symptoms; whereas maternal overprotection, emotion recognition and
   suppression were associated with obsessive-compulsive symptomatology.
   The findings, and their implications were discussed in the light of
   relevant literature. (C) 2014 The Authors. Published by Elsevier Ltd.},
Publisher = {ELSEVIER SCIENCE BV},
