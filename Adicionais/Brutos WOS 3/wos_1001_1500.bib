@article{ WOS:000227362300007,
Author = {Turk, CL and Heimberg, RG and Luterek, JA and Mennin, DS and Fresco, DM},
Title = {Emotion dysregulation in generalized anxiety disorder: A comparison with
   social anxiety disorder},
