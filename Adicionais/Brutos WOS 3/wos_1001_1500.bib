@inproceedings{ WOS:000189432000040,
Author = {Rolls, ET},
Editor = {Ono, T and Matsumoto, G and Llinas, RR and Berthoz, A and Norgren, R and Nishijo, H and Ono, T and Matsumoto, G and Llinas, RR and Berthoz, A and Norgren, R and Nishijo, H and Tamura, R},
Title = {Vision, emotion and memory: from neurophysiology to computation},
Booktitle = {COGNITION AND EMOTION IN THE BRAIN},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2003},
Volume = {1250},
Pages = {547-573},
Note = {International Symposium in Limbic and Association Cortical Systems,
   Toyama, JAPAN, OCT 07-12, 2002},
Abstract = {The inferior temporal visual cortex provides invariant representations
   of objects. The computations underlying this can be understood in the
   framework of a hierarchical series of competitive networks in the
   ventral visual stream which learn invariant representations by using a
   short-term memory trace to extract properties of the visual input that
   are invariant over short periods and are thus statistically likely to be
   from the same object. One set of outputs from the inferior temporal
   cortex is to the orbitofrontal cortex and amygdala, which are involved
   in representing primary rewards and punishers (such as taste, pleasant
   touch, and pain), and in associating previously neutral visual stimuli
   with these primary reinforcers. In that emotions can be defined as
   states elicited by reinforcers, these functions of the orbitofrontal
   cortex and amygdala provide a basis for understanding how emotion is
   implemented in the brain. A second output of the inferior temporal
   cortex is to the hippocampal system, which is implicated in episodic
   memory and in spatial function. A third output of the inferior temporal
   visual cortex is to the prefrontal cortex, which is involved in
   short-term memory and attentional processes. The combined
   neurophysiological and computational approach taken to these issues
   provides a way of understanding how these systems actually operate in
   the brain to implement object perception, emotion, and long- and
   short-term memory. (C) 2003 Published by Elsevier B.V.},
Publisher = {ELSEVIER SCIENCE BV},
