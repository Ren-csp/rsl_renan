@inproceedings{ WOS:000290883800019,
Author = {Balaguer-Ballester, Emili and Clark, Nicholas R. and Coath, Martin and
   Krumbholz, Katrin and Denham, Susan L.},
Editor = {LopezPoveda, EA and Palmer, AR},
Title = {Understanding Pitch Perception as a Hierarchical Process with Top-Down
   Modulation},
Booktitle = {NEUROPHYSIOLOGICAL BASES OF AUDITORY PERCEPTION},
Year = {2010},
Pages = {201+},
Note = {15th International Symposium on Hearing, Salamanca, SPAIN, JUN 01-05,
   2009},
Organization = {Med Elect; Hear Life},
Abstract = {Previous studies suggest that the auditory system uses a wide range of
   time scales to integrate pitch-related information, and that the
   effective integration time is both task- and stimulus-dependent. None of
   the existing models of pitch processing can account for such task- and
   stimulus-dependent variations in processing time scales. This study
   presents an idealized neurocomputational model, which provides a unified
   account of the multiple time scales observed in pitch perception. The
   Model is evaluated using a range of perceptual studies and a
   neurophysiological experiment. In contrast to other approaches, the
   current model contains a hierarchy of integration stages and uses
   feedback to adapt the effective time scales of processing at each stage
   in response to changes in the input stimulus. The model suggests a key
   role for efferent connections from central to sub-cortical areas in
   controlling the temporal dynamics of pitch processing.},
Publisher = {SPRINGER},
Address = {233 SPRING STREET, NEW YORK, NY 10013, UNITED STATES},
