@inproceedings{ WOS:000264182100385,
Author = {Lu Ming and Wang Yingjie},
Editor = {Li, SC and Wang, YJ and An, Y and Sun, XY and Li, X},
Title = {Study on Urban Rail Transit Construction Safety and Countermeasures},
Booktitle = {PROGRESS IN SAFETY SCIENCE AND TECHNOLOGY, VOL VII, PTS A AND B},
Series = {PROGRESS IN SAFETY SCIENCE AND TECHNOLOGY SERIES},
Year = {2008},
Volume = {7},
Pages = {1993-1997},
Note = {International Symposium on Safety Science and Technology, Beijing,
   PEOPLES R CHINA, SEP 24-27, 2008},
Abstract = {Urban rail transit engineering is a complex construction project which
   involves many factors. Most of the urban rail transits are located in
   city downtown, and all of the exiting buildings, underground pipelines
   and other things make them to be great high-risk projects. Urban rail
   transit construction may have great impacts on the surrounding
   environment, causing ground subsidence, underground pipeline rupture, a
   tilt and crack of buildings and housing collapses when it is not proper
   implemented. In this paper ten serious accidents of urban rail transit
   construction in Asia-Pacific region from 2001 to 2006 were listed and
   four most serious accidents are described in detail. All of the
   accidents indicate that construction of deep foundation pit is one of
   the biggest safety risk sources. Then four major causes of the deep
   foundation pit destruction were discussed and corresponding
   countermeasures were brought out. At last, taking the disaster accident
   of Shanghai Metro Line 4 as an example, the corresponding recovery works
   were studied. In the view of the frequent accidents and tremendous
   losses, it is concluded that the establishment of urban rail transit
   safety risk management system is very important.},
