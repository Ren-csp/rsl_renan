@inproceedings{ WOS:000170062300013,
Author = {Gainotti, G},
Editor = {Miyoshi, K and Shapiro, CM and Gaviria, M and Morita, Y},
Title = {Brain structures subserving componential and hierarchical aspects of
   human emotions},
Booktitle = {CONTEMPORARY NEUROPSYCHIATRY},
Year = {2001},
Pages = {89-93},
Note = {3rd International Congress of Neuropsychiatry, KYOTO, JAPAN, APR 09-13,
   2000},
Abstract = {The main similarities and differences existing between the
   ``emotional{''} and the ``cognitive{''} system are identified. Emotions
   as a multicomponent, hierarchically organized adaptive system are then
   described. The main components and the main levels of emotions that
   could be subserved by specific brain structures are next described.
   Within the emotional components are considered the appraisal of
   emotional situations, the emotional response, with its expressive-motor
   and autonomic components, and the control of the spontaneous emotional
   response. Within the levels of emotional functioning, a distinction is
   made between a level of automatic, spontaneous functioning and a level
   of conceptual, controlled processing of emotional information. The brain
   structures subserving the various components and levels of emotions and
   the emotional disorders risulting from injury to these brain structures
   are briefly discussed.},
