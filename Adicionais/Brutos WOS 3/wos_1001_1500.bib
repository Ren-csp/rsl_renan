Editor = {D'Andrea, V and DePaula, RA and Rodil, K and Lamas, D and Goagoses, N and Kambunga, AP and Wen, DTY and DelGaudio, C and Jensen, MY and Winschiers-Theophilus, H and Zaman, T},
Title = {Commoning the Once Abandoned Satoyama: Re-entangling Ecological
   Relationship in Rural Japan},
Booktitle = {REACHING OUT: CONNECTING BEYOND PARTICIPATION, PDC 2024, VOL 2},
