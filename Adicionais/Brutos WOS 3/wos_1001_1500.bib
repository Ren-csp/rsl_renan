Book-Group-Author = {IEEE},
Title = {Identifying Artistic Expertise Difference in Emotion Recognition in
   Response to Oil Paintings},
Booktitle = {2023 11TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING, NER},
Series = {International IEEE EMBS Conference on Neural Engineering},
