@inproceedings{ WOS:001582875600006,
Author = {Lee, Yejin and Jung, Kwang Tae},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Emotion and Gaze Movement Analysis in Preference Evaluation of Steering
   Wheel Design},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 1, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {39},
Pages = {34-39},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {The steering wheel is one of the interface components drivers see most
   when driving a car. Therefore, studies from various perspectives are
   necessary to increase drivers' preference for steering wheel design.
   This study was conducted for two purposes. The first was to derive
   emotional factors important to preference through emotion analysis of
   the steering wheel. The second was to investigate the possibility of
   using gaze movements to evaluate steering wheel preference. Twenty
   samples were used to assess preferences and emotions about steering
   wheel design. Subjects evaluated for their design preferences and
   emotions after viewing the steering wheel image displayed on the monitor
   for 10 s while wearing an eye tracker. A 5-point Likert scale was used
   to evaluate preference, and the Semantic Differential method was used to
   assess emotion. Eight subjects participated in the experiment, and
   twenty emotional vocabularies were used for emotion evaluation. Factor
   analysis was performed to derive emotional factors. Heat map entropy for
   gaze movement was calculated to analyze the relationship between gaze
   movement and preference. The analysis revealed that the most significant
   emotional factor in preference was ``familiarity.{''} Furthermore, a
   positive correlation was found between preference and heat map entropy.
   This suggests that as preference for the steering wheel design
   increases, subjects tend to look at the various components more evenly.
   These findings have practical implications as they can guide emotional
   design strategies to increase steering wheel preference and provide a
   novel evaluation method.},
Publisher = {SPRINGER-VERLAG SINGAPORE PTE LTD},
Address = {152 BEACH ROAD, \#21-01/04 GATEWAY EAST, SINGAPORE, 189721, SINGAPORE},
Type = {Proceedings Paper},
