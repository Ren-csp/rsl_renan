@inproceedings{ WOS:000432197700026,
Author = {Sorinas, Jennifer and Grima Murcia, M. D. and Minguillon, Jesus and
   Sanchez-Ferrer, Francisco and Val-Calvo, Mikel and Manuel Ferrandez,
   Jose and Fernandez, Eduardo},
Editor = {Vicente, JMF and Sanchez, JRA and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Setting the Parameters for an Accurate EEG
   (Electroencephalography)-Based Emotion Recognition System},
Booktitle = {NATURAL AND ARTIFICIAL COMPUTATION FOR BIOMEDICINE AND NEUROSCIENCE, PT
   I},
Series = {Lecture Notes in Computer Science},
Year = {2017},
Volume = {10337},
Number = {I},
