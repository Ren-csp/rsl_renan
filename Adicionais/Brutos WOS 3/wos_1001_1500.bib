@article{ WOS:000254115200022,
Author = {Repacholi, Betty M. and Meltzoff, Andrew N. and Olsen, Berit},
Title = {Infants' understanding of the link between visual perception and
   emotion: ``If She Can't See Me Doing It, She Won't Get Angry{''}},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {2008},
Volume = {44},
Number = {2},
