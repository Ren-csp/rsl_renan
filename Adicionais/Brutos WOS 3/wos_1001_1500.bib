@inproceedings{ WOS:000632313600002,
Author = {Itiritipha, Fareda and Wu, Falin and Gantumur, Byambakhuu and Lkhagva,
   Otgonbayar},
Editor = {Erbertseder, T and Chrysoulakis, N and Zhang, Y},
Title = {Analysis of Urban Green Spaces and Surface Temperature Using
   Quantitative Remote Sensing Technology in Bangkok},
Booktitle = {REMOTE SENSING TECHNOLOGIES AND APPLICATIONS IN URBAN ENVIRONMENTS V},
Series = {Proceedings of SPIE},
Year = {2020},
Volume = {11535},
Note = {Conference on Remote Sensing Technologies and Applications in Urban
   Environments V held at SPIE Remote Sensing Conference, ELECTR NETWORK,
   SEP 21-25, 2020},
Organization = {SPIE},
Abstract = {Bangkok Metropolitan Administration (BMA) is the capital city of
   Thailand In recent years, city surface has been changed greatly by rapid
   urbanization. Many green spaces in the urban area are destroyed and
   replaced with the commercial area. It can have effect on the climate and
   weather that could lead to the Urban Heat Island (UHI). This research
   analyzes the correlation between Urban Green Spaces (UGS) and Land
   Surface Temperature (LST) using quantitative remote sensing technology
   in BMA. More than five years of Landsat-5 TM and Landsat-8 images are
   used to study urban temperature. The LST, UGS and their correlation of
   whole area of BMA are analyzed. The LST is retrieved from mono-window
   algorithm, which used only one thermal band. Several indices of UGS,
   including the Normalized Difference Vegetation Index (NDVI), and
   measurement of vegetation cover percentage are also used to study on
   UGS. The result showed that from 2008 to 2018 LST is increased while UGS
   is decreased. In addition, Pearson product-moment correlation
   coefficient is used to analyze the linear correlation between UGS and
   LST. The correlation between LST and NDVI indicates the negative
   correlation. The average correlation coefficient is -0.44. That can
   imply that the higher vegetated area, the LST was lower. To get more
   detail relationship between LST and UGS, three typical regional areas
   are selected to study. LST contour is used to analyze LST and HERCULES
   system is used to classify land cover. The result showed that firstly,
   the density of tree affect LST. Secondly, the location of the public
   park is important. Thirdly, water bodies help to decrease LST. The
   results of this study have key implications for BMA sustainable urban
   planning and development; to mitigate UHI effects it is important to not
   only increase canopy cover or the size of UGS, but also to optimize
   their spatial configuration.},
