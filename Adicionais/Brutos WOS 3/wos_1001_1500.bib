Title = {Emotion Recognition Based on Photoplethysmography Using ResNet and
   BiLSTM Networks},
Booktitle = {2021 INTERNATIONAL CONFERENCE ON E-HEALTH AND BIOENGINEERING (EHB 2021),
   9TH EDITION},
Series = {E-Health and Bioengineering Conference},
Year = {2021},
Note = {9th IEEE International Conference on e-Health and Bioengineering (EHB),
   Grigore T Popa Univ Med \& Pharmacy, ELECTR NETWORK, NOV 18-19, 2021},
Organization = {IEEE; Grigore T Popa Univ Med \& Pharmacy, Fac Med Bioengineering; SRBM;
   IEEE Romanian Sect; IEEE EMB; IEEE Romania Sect; Inst Informatica
   Teoretica; Romanian Soc Med Bioengineering; Romanian Acad, Iasi Branch,
   Inst Comp Sci; IEEE EMB Romania Chapter; IEEE EMC Romania Chapter; IEEE
   Signal Proc Romania Chapter; IEEE SMC Romania Chapter},
Abstract = {This paper proposes an emotion recognition system based on Deep
   Learning. The emotions to be identified in this study are classified
   into two classes (positive and negative) and four classes (neutral,
   angry, happy, sad). In this study, we used the spectrogram of PPG as
   input to the proposed BiLSTM model and ResNet+BiLSTM model for emotion
   recognition. The 80\% training and 20\% testing method was used to test
   the effectiveness of the proposed methods. The experimental result
   showed that the ResNet+BiLSTM outperformed the BiLSTM method with high
   recognition rates of 89.15\% and 84.70 in the two-class and four-class
   emotion identification tasks, respectively, which were competitive or
   even superior to other representative methods in the literature.},
