@inproceedings{ WOS:000466841700009,
Author = {Kiffin-Petersen, Sandra},
Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {SELF-REFERENTIAL EMOTION REGULATORY MODEL OF WORK DESIGN},
Booktitle = {NEW WAYS OF STUDYING EMOTIONS IN ORGANIZATIONS},
Series = {Research on Emotion in Organizations},
Year = {2015},
Volume = {11},
Pages = {241-269},
Note = {9th International Conference on Emotions and Worklife (Emonet),
   Philadelphia, PA, JUL 30-31, 2014},
Abstract = {Work design has largely overlooked cognitive-emotional interactions in
   understanding employee motivation and satisfaction. My aim in this
   chapter is to develop a conceptual model that integrates what we know
   about these interactions from research on emotions and neuroscience with
   traditional and emergent work design perspectives. I propose that
   striving for universal goals influences how a person responds to the
   work characteristics, such that an event that is personally relevant or
   ``self-referential{''} will elicit an emotional reaction that must be
   regulated for optimal performance, job satisfaction, and well-being. A
   Self-Referential Emotion Regulatory Model (SERM) of work design is
   presented.},
