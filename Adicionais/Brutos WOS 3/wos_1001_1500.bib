@inproceedings{ WOS:000260019400014,
Author = {Peixoto Neto, A. G. L. and Galves, M. L. and Lima Junior, O. F. and
   Tacla, D.},
Editor = {Brebbia, CA},
Title = {Challenges of urban transport problems and city logistics: Sao Paulo
   city center case},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2008},
