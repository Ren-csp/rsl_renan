@inproceedings{ WOS:000472156000290,
Author = {Leptiukhova, Olga},
Editor = {KarimSultanovich, BD},
Title = {SOCIO-PSYCHOLOGICAL PREFERENCES OF PEDESTRIAN WHEN CHOOSING WALKABLE
   URBAN DESIGN},
