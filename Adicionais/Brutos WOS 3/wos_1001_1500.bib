@inproceedings{ WOS:000073221600105,
Author = {Knight, MJ and Yates, DB and Sutton, BG},
Editor = {Chilton, J},
Title = {Landfill leachate: Managing a valuable irrigation resource in the urban
   environment},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {603-610},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
