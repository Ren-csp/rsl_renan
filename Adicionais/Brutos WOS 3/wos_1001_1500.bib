@inproceedings{ WOS:001728145300021,
Author = {Cavalcabo, Guido de Bonfioli and Stagakis, Stavros and Feigenwinter,
   Christian and Kalberer, Markus and Damm, Alexander and Buchmann, Nina
   and Brunner, Dominik},
Editor = {Mohammad, P and Shahfahad and Comino, JR and Matamanda, AR},
Title = {Modelling Urban Radiation Exchange Using a High-Resolution 3D Approach},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
