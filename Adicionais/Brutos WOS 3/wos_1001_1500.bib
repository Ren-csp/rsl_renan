@inproceedings{ WOS:001728145300026,
Author = {Alzamil, Waleed S.},
Editor = {Mohammad, P and Shahfahad and Comino, JR and Matamanda, AR},
Title = {Sustainable Urban Development and Climate Change Challenges Within
   Kingdom of Saudi Arabia's Vision 2030},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
