@inproceedings{ WOS:000073872700066,
Author = {Kumar, R},
Editor = {Agashe, SN},
Title = {Dust mite allergy in occupational environments},
Booktitle = {AEROBIOLOGY},
Year = {1997},
Pages = {589-596},
Note = {5th International Conference on Aerobiology, BANGALORE, INDIA, AUG, 1994},
Organization = {Int Assoc Aerobiol; Bangalore Univ; Indian Aerobiol Soc; Indian Acad
   Allergy},
Abstract = {Working on mites inhabiting human environment has brought to light
   interesting phenomenon with respect to the degree of onset or of
   exacerbation of the symptoms of respiratory and or cutaneous maladies in
   rural, urban, farming and non-farming communities. From statements and
   case histories a direct relationship was found to exist between the
   nature of occupation-indoors and outdoors, the kind of working and
   living habitat, socio-cultural habits and economic status of people and
   their allergic responses. Dust samples were collected from different
   habitats, occupational environments consisting of barn-yards, storage
   premises, village shops and living rooms. These were investigated for
   acarids and pyroglyphids. Thirteen species of mites were identified. The
   intensity of allergic manifestations was seen to be related to the
   occupational habitat of the patients and its mite composition. Results
   are discussed in the light of: a) nature and quantity of mites; b) the
   duration and circumstances or activities of the human subjects exposing
   themselves to the clouds of dust mites; and c) asthmatic and/or the
   dermatitic symptoms.},
