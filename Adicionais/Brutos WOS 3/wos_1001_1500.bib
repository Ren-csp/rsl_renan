@inproceedings{ WOS:000288209800009,
Author = {Matheny, Jonathan A. and Smollan, Roy K.},
Editor = {Ashkanasy, NM and Zerbe, WJ and Hartel, CEJ},
Title = {TAKING CHANGE TO HEART: EXPLORING EMOTIONS EXPERIENCED THROUGH CHANGE
   EVENTS},
Booktitle = {EFFECT OF AFFECT IN ORGANIZATIONAL SETTINGS},
Series = {Research on Emotion in Organizations},
Year = {2005},
Volume = {1},
Pages = {173-210},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {This chapter addresses the confluence of emotions, justice, and
   organizational change. Drawing on these three literatures, the chapter
   provides empirical analysis of over 100 separate organizational change
   events. The findings confirm previous research regarding patterns among
   emotions and demonstrate these patterns apply in the specific context of
   change. The findings also suggest that the degree of clarity one has
   when considering a change event matches the degree of intensity with
   which one experiences emotion. Finally, the findings suggest that even
   nominal change events are associated with intense experience of
   emotions. The chapter links these findings to several suggestions for
   further research.},
