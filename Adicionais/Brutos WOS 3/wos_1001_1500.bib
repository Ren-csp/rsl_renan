Year = {2004},
Volume = {3},
Pages = {93-117},
Note = {Stone-Weathering-and-Atmospheric-Pollution-Network Conference, Univ
   Wolverhampton, Wolverhampton, ENGLAND, MAY 09-12, 1999},
Organization = {Univ Wolverhampton, Sch Appl Sci; Univ Wolverhampton, Sch Engn; Univ
   Wolverhampton, Built Environm},
Abstract = {A 2-year exposure trial was used to examine the initial stages of
   sandstone decay within the present-day environment of Belfast, a highly
   polluted urban area. Test blocks of a siliceous sandstone (Dunhouse
   sandstone) and a calcareous sandstone (Baumberger sandstone) were
   mounted in sheltered and exposed conditions in a range of locations
   within the city, to examine the controls of rock properties and local
   environmental conditions on the nature and rate of sandstone decay.
   Results show significant decay of sandstone surfaces within 2 years;
   samples from suburban sites displayed biological material and
   accumulation of allochthonous material, whereas samples in urban areas
   displayed rapid gypsum accumulation. Gypsum formation was more rapid on
   calcareous stone and exposure to rain-wash reduced the extent of initial
   decay on both stone types.},
