@inproceedings{ WOS:001073826400033,
Author = {Farruggia, D. and Iacuzzi, N. and Licata, M. and La Bella, S. and
   Tuttolomondo, T. and Virga, G.},
Editor = {Romano, D and Bretzel, F and Toscano, S},
