@inproceedings{ WOS:000315311500032,
Author = {Hu Zhiguang and Xu Jiabin},
Editor = {Zhang, YL},
Title = {The Nature and Legitimacy of Corporate Social Responsibility},
Booktitle = {PROCEEDINGS OF THE 8TH EURO-ASIA CONFERENCE ON ENVIRONMENT AND CSR:
   TOURISM, MICE, HOSPITALITY MANAGEMENT AND EDUCATION SESSION, PT I},
Year = {2012},
Pages = {202-207},
Note = {8th Euro-Asia Conference on Environment and CSR: Tourism, MICE,
   Hospitality Management and Education Session, Berlin, GERMANY, JUN
   15-18, 2012},
Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {Although there are arguments, most people agree that the conception of
   ``corporate social responsibility{''} (CSR) was invented by Sheldon, in
   America in 1924. For decades after its emergence it existed as a vague
   conception. Now there are considerably great numbers of thoughts and
   opinions about CSR, but there are no perfect theory systems. The
   fundamental reason of the existence of so many arguments is that the
   nature of CSR remains vague. Through the research and deduction of past
   literatures, using the perspective of economics, and referring to other
   subjects such as philosophy, the authors reach a conclusion that
   ``CSR{''} should be formulated as negative consequences that managers
   and shareholders in corporations undertake for their fault did to nature
   and society, the obligation that corporations undertake equal to the
   rights and power they acquire from nature and society, and their
   volunteer pay to the nature and society. This is CSR's meaning and
   nature, which are inseparable. Finally, a conclusion can be drawn that
   corporations can undertake social responsibilities, and sometimes they
   must.},
