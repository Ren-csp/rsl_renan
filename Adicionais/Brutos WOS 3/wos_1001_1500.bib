@inproceedings{ WOS:000078012300026,
Author = {Wiegand, J},
Editor = {Katase, A and Shimo, M},
Title = {Vibrations in the urban environment controlling 222Rn
   migration in soils},
Booktitle = {RADON AND THORON IN THE HUMAN ENVIRONMENT},
Year = {1998},
Pages = {176-182},
Note = {7th Tohwa University International Symposium on Radon and Thoron in the
   Human Environment, FUKUOKA, JAPAN, OCT 23-25, 1997},
Organization = {Toshinami Fukuda; Tohwa Univ},
Abstract = {Comparable to investigations looking for a connection of Rn-222 and
   earthquakes, this study shows the influence of subsurface vibrations on
   the Rn-222 concentration of the soil-gas in urban environments.
   Generally, the Rn-222 concentration increases through vibrations induced
   by trains, street-traffic and activities at project sites. The spatial
   radius of the Rn-222 increase due to vibrations reach highest values at
   project sites where piled foundations or metal panels are rammed into
   the ground (> 60 m). Along railway tracks the radius is wider (> 30 m)
   than along heavy traffic roads (< 25 m). The average increase of Rn-222
   concentrations in soil-gas due to vibrations is the highest at project
   sites (53 \%). Along heavy traffic roads the increase of Rn-222
   concentrations by motor vehicle traffic is higher (37 \%) than that by
   railway traffic (11.5 \%). The maximum increase of 400 \% was observed
   in a distance of 1 m from a railway track, In the vicinity of railway
   tracks a difference of the vibration influence according to
   unconsolidated rock (11.1 \%) or solid rock (11.8 \%) was not noticed.
   Beside this vibration effect, the overall Rn-222 level decreases with
   increasing distance to the vibration source, but only at locations
   laying above solid rocks.
   The observation of the increase of Rn-222 concentrations can be
   explained by a ``pump effect{''}: the mechanical vibration of soil and
   mineral particles leads to an upward motion of the whole volume of
   soil-gas. Therefore, Rn-222 is pumped out of the soil to the atmosphere
   and as a result the upward transport is increased.},
