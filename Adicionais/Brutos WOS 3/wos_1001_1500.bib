@article{ WOS:000075916000021,
Author = {de Bonis, M},
Title = {How the brain processes emotional stimuli: An introduction to Lang's
   theory of emotion},
Journal = {CAHIERS DE PSYCHOLOGIE COGNITIVE-CURRENT PSYCHOLOGY OF COGNITION},
Year = {1998},
Volume = {17},
Number = {4-5},
