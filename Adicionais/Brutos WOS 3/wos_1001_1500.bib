@inproceedings{ WOS:000333253900045,
Author = {Kazemi, F. and Beecham, S. and Myers, B.},
Editor = {Wuzhong, ZZ and Groening, G and Drew, RA},
Title = {Water Quality Effects of a Water Sensitive Urban Design Retrofit in an
   Urban Streetscape in Adelaide, Australia},
Booktitle = {III INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2013},
