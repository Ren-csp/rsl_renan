@inproceedings{ WOS:000469107900003,
Author = {Healey, Mark P. and Hodgkinson, Gerard P. and Massaro, Sebastiano},
Editor = {Petitta, L and Hartel, CEJ and Ashkanasy, NM and Zerbe, WJ},
Title = {CAN BRAINS MANAGE? THE BRAIN, EMOTION, AND COGNITION IN ORGANIZATIONS},
Booktitle = {INDIVIDUAL, RELATIONAL, AND CONTEXTUAL DYNAMICS OF EMOTIONS},
Series = {Research on Emotion in Organizations},
Year = {2018},
