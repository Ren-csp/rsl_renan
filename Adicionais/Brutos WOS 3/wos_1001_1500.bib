Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {With the development of industrialization and urbanization in China,
   more and more people swarm into cities. It increases the need of urban
   construction land, accelerates rural-urban land conversion, and leads to
   the contradiction of urban development and rural land protection. In
   order to realize the sustainable development, it's necessary to handle
   their relationship well. Therefore, this paper takes Zhejiang Province
   as an example, uses econometrics methods to test the relationship
   between urbanization and rural-urban land conversion, and calculates
   their coordination degree. All the research results can offer good helps
   for urban sustainable development.},
