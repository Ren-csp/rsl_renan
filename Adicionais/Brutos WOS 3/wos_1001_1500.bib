@inproceedings{ WOS:001323504700010,
Author = {Chan, Sarah Hian May and Qiu, Lin and Lam, Jerlyn},
Editor = {Moore, B and Murray, E and Winslade, M and Tan, LM},
Title = {An Investigation into the Stress-Buffering Effects of Nature Virtual
   Backgrounds in Video Calls},
Booktitle = {APPLIED PSYCHOLOGY READINGS, SCAP 2023},
Series = {Springer Proceedings in Behavioral and Health Sciences},
Year = {2024},
Pages = {169-180},
Note = {Singapore Conference on Applied Psychology, Singapore, SINGAPORE, DEC
   07-08, 2023},
Organization = {E Asia Res; Sch Posit Psychol; Australian Assoc Psychologists Inc;
   Australian Aviat Psychol Assoc; Bulgarian Psycholog Soc; Colegio
   Colombiano Psicologos; Int Posit Psychol Assoc; Lithuanian Psycholog
   Assoc; Mongolian Psychologists Assoc; Serbian Psycholog Soc; Sociedade
   Brasileira Psicologia},
Abstract = {Videoconferencing technologies provided a lifeline for businesses and
   people to stay connected during the COVID-19 pandemic, but it also
   brought to light the unique stressors associated with video calls. This
   research explored the potential of utilizing virtual backgrounds as a
   strategy to mitigate against stress experienced during video calls. A
   between-subjects experiment was conducted (N = 131) where undergraduate
   research participants completed a 5-min mock job interview over Zoom.
   The interviewer's virtual background was manipulated to be a nature
   image or an office image (control). Results found no differences in
   physiological and behavioral stress between the conditions. However,
   among male participants, self-reported stresswas marginally lower in the
   nature condition compared to the control condition. Based on these
   responses to the stress-induction task, our findings suggest that nature
   virtual backgrounds have the potential to buffer against stress during
   video calls. With video calls now a permanent fixture of modern life
   andworkplaces, the findings contribute towards the nascent research into
   virtual backgrounds and have important theoretical and practical
   implications.},
