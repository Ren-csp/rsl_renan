Title = {UNDERSTANDING LECTURERS' PERCEPTIONS OF WORKPLACE FEAR: AN INTERPRETIVE
   STUDY IN THE CYPRIOT HIGHER EDUCATION CONTEXT},
Booktitle = {NEW WAYS OF STUDYING EMOTIONS IN ORGANIZATIONS},
Series = {Research on Emotion in Organizations},
Year = {2015},
Volume = {11},
Pages = {51-79},
Note = {9th International Conference on Emotions and Worklife (Emonet),
   Philadelphia, PA, JUL 30-31, 2014},
Abstract = {This chapter explores how Cypriot lecturers perceive and experience fear
   while being at work. Drawing on the lens of interpretive inquiry, data
   were collected through interviews with 19 lecturers. Analysis focused on
   experiences of workplace fear offering rich insights into
   characteristics of fear, eliciting events, and coping ways. Findings
   help to unveil the specific events that lead to fear in the Cypriot
   universities, and the ways lecturers manage their fearful experiences.
   The study contributes to the study of discrete emotions, by empirically
   examining fear's own storyline through the workers' own perspectives,
   within a specific context.},
