@article{ WOS:000236011600004,
Author = {Lee, MT and Chang, YC},
Title = {Strategic analysis for sustainable urban river aquatic environment using
   the system dynamic approach},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
