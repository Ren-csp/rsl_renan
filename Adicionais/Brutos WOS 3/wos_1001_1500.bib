Title = {Investigating the Impact of Emotions on the Quality of Novice
   Programmers' Code},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2023},
Series = {Lecture Notes in Information Systems and Organization},
