Title = {Green on white: The contemporary nature essay and environmental racism},
Booktitle = {OUR NATURAL ENVIRONMENT: AT A CROSSROAD, PROCEEDINGS},
Year = {1997},
Pages = {295-301},
Note = {3rd International Interdisciplinary Conference on the Environment,
   WORCESTER, MA, JUN 25-28, 1997},
Organization = {Interdisciplinary Environm Assoc},
Abstract = {This paper discusses the reasons why the recent renaissance in American
   nature writing has failed to produce a body of work that addresses the
   environmental concerns of urban minorities. I trace the reluctance of
   well-known nature essayists to include a polemical edge to their
   writings. While essayists such as Carson, Bass, and Abbey, have
   possessed a polemical style, the landscapes they address tend to be far
   removed from the urban core populated by people of color. The essay also
   examines how the largely white membership and leadership of mainstream
   environmental organizations influence the production of popular nature
   writing.},
