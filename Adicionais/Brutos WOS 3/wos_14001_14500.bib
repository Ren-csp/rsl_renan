@article{ WOS:000236871200014,
Author = {Levitin, DJ and Menon, V},
Title = {The neural locus of temporal structure and expectancies in music:
   Evidence from functional neuroimaging at 3 tesla},
Journal = {MUSIC PERCEPTION},
Year = {2005},
Volume = {22},
Number = {3},
Pages = {563-575},
Month = {SPR},
Note = {9th Biennial Workshop on International Rhythm Perception and Production,
   Ile Tatihou, Normandy, FRANCE, JUN, 2003},
Abstract = {The neuroanatomical correlates of temporal structure and expectancies in
   music were investigated using a unique stimulus manipulation involving
   scrambled music. The experiment compared brain responses (using
   functional magnetic resonance imaging) while participants listened to
   classical music and scrambled versions of that same music. The scrambled
   versions disrupted musical structure while holding low-level musical
   attributes constant, including such psychoacoustic parameters as pitch,
   loudness, and timbre. Comparing music to its scrambled counterpart, we
   found focal activation in the pars orbitalis region (Brodmann Area 47)
   of the left inferior frontal cortex, a region that has been previously
   closely associated with the processing of linguistic structure in spoken
   and signed language, and additional activation in the right hemisphere
   homologue of that area. We speculate that this particular region of
   inferior frontal cortex may be more generally responsible for processing
   fine-structured stimuli that evolve over time, not merely those that are
   linguistic.},
