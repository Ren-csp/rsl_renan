@article{ WOS:000168933300043,
Author = {Dennis, M and Rogers, T and Barnes, MA},
Title = {Children with spina bifida perceive visual illusions but not multistable
   figures},
Journal = {BRAIN AND COGNITION},
Year = {2001},
Volume = {46},
Number = {1-2},
Pages = {108-113},
Month = {JUN-JUL},
Note = {11th Annual Meeting on Theoretical and Experimental Neuropsychology,
   MONTREAL, CANADA, JUN 15-17, 2000},
Organization = {Univ Quebec, Montreal; Minist Rech, Sci \& Technol, Quebec; Med Res
   Council, Ottawa},
Abstract = {We compared 32 children with spina bifida and 31 age-matched controls on
   two classes of illusory perception, one involving visual illusions and
   the other, multistable figures. Children with spina bifida were as adept
   as age peers in the perception of visual illusions concerned with size,
   length, and area, but were impaired in the perception of multistable
   figures that involved figure-ground reversals, illusory contours,
   perspective reversing, and paradoxical figures. That children with spina
   bifida reliably perceive illusions that rely on inappropriate constancy
   scaling of size, length, and area suggests that their brain
   dysmorphologies do not prevent the acquisition of basic perceptual
   operations that enhance thr local coherence of object perception. That
   they do not perceive multistable figures suggests that their visual
   perception impairments may involve not object processing so much as poor
   top-down control From higher association areas to representations in the
   visual cortex. (C) 2001 Academic Press.},
