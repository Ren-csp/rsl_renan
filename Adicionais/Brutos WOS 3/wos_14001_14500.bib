@article{ WOS:000279021600019,
Author = {Noonan, M. P. and Sallet, J. and Rudebeck, P. H. and Buckley, M. J. and
   Rushworth, M. F.},
Title = {Does the medial orbitofrontal cortex have a role in social valuation?},
Journal = {EUROPEAN JOURNAL OF NEUROSCIENCE},
Year = {2010},
