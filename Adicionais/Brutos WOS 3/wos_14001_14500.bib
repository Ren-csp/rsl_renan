@inproceedings{ WOS:000257236400059,
Author = {De Winne, E. and De Winne, P.},
Editor = {Brebbia, CA},
Title = {Safety and geometric aspects of humps and road crossings},
Booktitle = {URBAN TRANSPORT XIII: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
