Organization = {Int Soc Resource Environm Informat Technol},
Abstract = {By a Little laboratory test, primarily introduced the activated sludge
   cultivation process of the Modified Integrated Oxidation Ditch process
   in municipal sewage treatment. Three-stage method of activated sludge
   cultivation was used in this test. This method consisted of three
   phases, which were aeration cultivation adding seed sludge, continuous
   cultivation in low hydraulic loading and continuous cultivation in full
   hydraulic loading. It showed that the completion of activated sludge
   cultivation spent 15 days; The removal rates of CODCr and NH4+-N reached
   83.63\% and 84.27\%, and effluent quality achieved the First-Level B
   standard of ``Pollutants emission standards of urban sewage treatment
   plant{''}(GB18918-2002); However, the removal rate of TP was only
   62.07\%.},
