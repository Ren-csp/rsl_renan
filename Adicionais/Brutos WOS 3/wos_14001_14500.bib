Title = {Dynamic End-Effector for Rendering Hardness and Stiffness with
   Encountered-Type Haptics},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
   INTERACTION, EUROHAPTICS 2024, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2025},
