Organization = {IFU IMK},
Abstract = {This study investigated thermal effects on the flow and dispersion of
   pollutant in urban street canyons. A heating module was introduced into
   the micro scale model MIMO for describing the thermal exchange between
   the air in the street and the buildings. Furthermore, the influence of
   wall temperatures and building shading on the in-street flow and its
   vertical transport is discussed. Results from numerical simulations that
   are performed with MIMO are compared with corresponding results from
   numerical simulations performed with the commercial CFD code
   CFX-TASCflow.},
