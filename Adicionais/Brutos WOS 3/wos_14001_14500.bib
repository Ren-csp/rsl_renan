Note = {31st Annual Conference of the International-Erosion-Control-Association,
   PALM SPRINGS, CA, FEB 21-25, 2000},
Organization = {Int Eros Control Assoc; Terra Mulch; Synthet Ind},
Abstract = {One of the driving forces behind the increasing use of Soil
   Bioengineering Techniques is the recognition that some traditional
   stabilization and engineering designs are no longer appropriate or
   acceptable. For instance, the use of concrete or riprap (small to large
   rock armour) lined engineered channels to convey water through and away
   from the urban environments had been shown to cause as many problems as
   it solves-higher down stream erosion and water velocities, limited
   wildlife habitat, poor aesthetic value, reduced ground water recharge
   capabilities and even public safety issues. The trend has developed to
   incorporate more ``soft armouring techniques,{''} those not requiring
   the use of concrete, riprap or other hard structures. Today the practice
   of bioengineering is gaining greater recognition as a valuable tool for
   controlling soil erosion.},
