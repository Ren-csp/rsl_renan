@inproceedings{ WOS:000078260900298,
Author = {Shlemon, RJ},
Editor = {Moore, D and Hungr, O},
Title = {Ground fissures and subsidence in the southwestern United States: An
   increasing challenge for the engineering geologist},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOLS 1-5},
Year = {1998},
Pages = {2167-2172},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {Ground fissures and subsidence are increasing in the southwestern United
   States, particularly in rapidly urbanizing areas. Significant damage has
   resulted to canals, highways, waste repositories and urban
   infrastructure. Fissure causation varies, even in the same area; typical
   are groundwater and hydrocarbon withdrawal and aquifer compaction,
   groundwater rise and hydroconsolidation, aseismic creep, and desiccation
   of near-surface clay. This paper synthesizes recent case studies that
   document how modern and ancient fissures, subsidence and related
   differential settlement are causing major changes in the geotechnical
   standard-of-care, unwanted litigation for the engineering geologist, and
   imposition of new government-mandated ``special geologic hazard
   zones{''}.},
