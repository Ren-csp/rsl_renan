@inproceedings{ WOS:000262471300019,
Author = {Rempulski, Nicolas and Prigent, Armelle and Estraillier, Pascal},
Editor = {Mehdi, Q and Moreton, R and Slater, S},
Title = {ADAPTIVE STORYTELLING BASED ON MODEL-CHECKING APPROACHES},
Booktitle = {Proceedings of CGAMES'2008: 13th International Conference on Computer
   Games: AI, Animation, Mobile, Educational and Serious Games},
Year = {2008},
Pages = {126-132},
Note = {13th International Conference on Computer Games (CGames 2008),
   Wolverhampton, ENGLAND, NOV 03-05, 2008},
Organization = {Univ Wolverhampton, Sch Comp \& Informat Technol; IEEE Comp Soc TCSIM;
   IEEE Computer Soc, Louisville Chapter; Soc Modeling \& Simulat; IEE;
   British Comp Soc; Digital Games Res Assoc; Serious Games Inst; Int
   Journal Intelligent Games \& Simulat},
Abstract = {In emergent narrative context the freedom of player is increased. He is
   free to create its own story with all events of entities in the game. In
   this case, the major risk is that it is not possible to control the
   player experience. He may lead to unexpected ending of the game, or go
   right through the end. In both cases its interest for gaming will
   decrease (because of its frustration with deadlock, or because the game
   is too easy). In oder to keep the player interested, he has to feel
   emotions. This means that the drama of story should be controlled during
   the game execution to guarantee the player emotion through the game
   (interactive drama). In this paper we propose an approach for driving
   narrative based on dynamic model checking of scenario during game
   execution. We have developed a multi-agent system architecture and a
   prototype called L3ILIfe.},
