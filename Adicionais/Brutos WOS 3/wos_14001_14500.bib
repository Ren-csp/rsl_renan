Year = {2021},
Note = {13th Conference on Creativity and Cognition (C\&C), ELECTR NETWORK, JUN
   22-23, 2021},
Organization = {ACM SIGCHI},
Abstract = {This pictorial is focused on the representation of atmospheres of
   architectural spaces. It presents diverse notational exercises to
   analyse and characterise the experiential qualities of existing places,
   as well as a series of representations as an attempt to communicate the
   total effect of their atmospheres. As architecture is designed through
   representation, this research aims to approach to new techniques and
   modes of representation that allow architectural practices to think and
   create through more ephemeral, ambiguous and diffuse atmospheric
   qualities that are inherent to any architectural space and that so far
   have remained invisible or unmanageable through our conventional means
   of representation.},
