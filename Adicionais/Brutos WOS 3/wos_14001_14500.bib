@inproceedings{ WOS:000260019400038,
Author = {Vollaro, R. de Lieto and Grignaffini, S. and Vallati, A.},
Editor = {Brebbia, CA},
Title = {Numerical analysis and measures for the evaluation of comfort inside
   buses used for public transport},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2008},
