@inproceedings{ WOS:000451538100050,
Author = {Rodriguez, Manuel and Delpla, Ianis},
Editor = {Brebbia, CA and Sendra, JJ},
Title = {CLIMATE CHANGES AND DRINKING WATER IN SUSTAINABLE CITIES: IMPACTS AND
   ADAPTATION},
