@inproceedings{ WOS:000260019400040,
Author = {Beusen, B. and Denys, T.},
Editor = {Brebbia, CA},
Title = {Long-term effect of eco-driving education on fuel consumption using an
   on-board logging device},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2008},
