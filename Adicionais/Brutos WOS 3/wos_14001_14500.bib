@article{ WOS:000234397500004,
Author = {Esqueda, CW and Harrison, LA},
Title = {The influence of gender role stereotypes, the woman's race, and level of
   provocation and resistance on domestic violence culpability attributions},
Journal = {SEX ROLES},
Year = {2005},
Volume = {53},
Number = {11-12},
Pages = {821-834},
Month = {DEC},
Note = {International Psychology and Law Conference, Edinburgh, SCOTLAND, 2003},
Abstract = {The influence of traditional or egalitarian gender role stereotypes on
   perceptions of domestic violence was investigated when the woman's race
   and her provocation of and resistance to domestic violence were varied.
   Two hundred eighty-eight European American participants who varied in
   their gender role stereotype beliefs provided culpability ratings. A
   factor analysis reduced culpability items to six concepts. Biases
   against the African American woman occurred, but not to the European
   American woman, particularly when she provoked the man. The woman's
   behavior before and after violence influenced participants' culpability
   notions, and beliefs in gender role stereotypes influenced perceptions
   of truthfulness based on race. Implications for the scope of educational
   programs to enhance support and eliminate biases are discussed.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
