@inproceedings{ WOS:000331259200026,
Author = {Mathieu, N. G. and Bonnet, S. and Harquel, S. and Gentaz, E. and
   Campagne, A.},
Book-Group-Author = {IEEE},
Title = {Single-trial ERP classification of emotional processing},
Booktitle = {2013 6TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
