Pages = {2099-2106},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {The 1995 Kobe earthquake of magnitude 7.2 caused severe damage in urban
   areas of Kobe and other cities, and also many landslides occurred in the
   Rokko Mountains and their foothills. In the Rokko Mountains, which are
   composed of weathered granite, many rapid landslides occurred, but they
   were small in scale. The foothills are mainly composed of Quaternary
   sediments. Using their gentle slopes, they have been developed for the
   construction of residential areas by engineering works. A variety of
   types of slow and rapid-moving landslides occurred in these areas, and
   destroyed many lives and houses. Some of these large scale landslides
   will be discussed in this paper.},
