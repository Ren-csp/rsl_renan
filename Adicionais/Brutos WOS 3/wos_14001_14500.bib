Title = {Emotional intelligence as educational resource for parents},
Booktitle = {ICCSBS 2015 - THE ANNUAL INTERNATIONAL CONFERENCE ON COGNITIVE - SOCIAL,
   AND BEHAVIOURAL SCIENCES},
