@article{ WOS:000228442500011,
Author = {Wood, J and He, C and Rochfort, Q and Marsalek, J and Seto, P and Yang,
   M and Chessie, P and Kok, S},
Title = {High-rate stormwater clarification with polymeric flocculant addition},
Journal = {WATER SCIENCE AND TECHNOLOGY},
