@article{ WOS:A1994PJ50600004,
Author = {GUTHRIE, JP and SCHWOERER, CE},
Title = {INDIVIDUAL AND CONTEXTUAL INFLUENCES ON SELF-ASSESSED TRAINING NEEDS},
