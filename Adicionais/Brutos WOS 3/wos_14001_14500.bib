@inproceedings{ WOS:000189400000002,
Author = {Kapitza, SP},
Editor = {Nation, J and Trofimova, I and Rand, JD and Sulis, W},
Title = {The statistical theory of global population growth},
Booktitle = {FORMAL DESCRIPTIONS OF DEVELOPING SYSTEMS},
