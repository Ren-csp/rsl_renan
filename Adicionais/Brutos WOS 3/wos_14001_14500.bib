Pages = {53+},
Note = {8th Highway and Urban Environment Symposium (8HUES), Cyprus Inst,
   Nicosia, CYPRUS, JUN 12-14, 2006},
Organization = {Chalmers Univ Technol},
Abstract = {In many European countries the speed limit for trucks is under
   discussion or review. The speed limit for heavy trucks is 80 km h(-1) in
   most countries, but 90 km h(-1) in Belgium. We investigated the effect
   of reducing the speed limit on fuel consumption and emissions of CO2,
   NOx, and particulate matter (PM).
   To ensure robust conclusions under a strict deadline, our evaluation
   used two existing, complementary approaches: the macroscopic emission
   model TEMAT and the microscopic emission simulation model VeTESS. Both
   models show a CO2 reduction between 5\% and 15\%. The results for NOx,
   and PM were ambiguous.},
