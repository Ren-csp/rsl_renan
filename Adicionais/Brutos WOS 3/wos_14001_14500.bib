@inproceedings{ WOS:000411915000054,
Author = {Dundelova, Jana},
Editor = {Fialova, J and Pernicova, D},
Title = {SELECTED ISSUES OF ENVIRONMENTAL PERSONALITY DISPOSITIONS IN THE CONTEXT
   OF ENVIRONMENTAL EDUCATION},
Booktitle = {PUBLIC RECREATION AND LANDSCAPE PROTECTION - WITH NATURE HAND IN HAND?,
   2017},
Series = {Public Recreation and Landscape Protection},
Year = {2017},
Pages = {344-351},
Note = {Conference on Public Recreation and Landscape Protection - with Nature
   Hand in Hand?, Brno, CZECH REPUBLIC, MAY 01-03, 2017},
Organization = {Czech Soc Landscape Engineers; Mendel Univ Brno, Fac Forestry \& Wood
   Technol, Dept Landscape Management; Univ Mendeliana Brunensis; Fac
   Silviculturae \& Technol Ligni},
Abstract = {Environmental personality dispositions indicate typical individual
   interactions between humans and the surrounding environment. The
   elaboration of this idea in psychological literature we have encountered
   since the 70s of the 20th century, when scientists (e.g. Little, 1976,
   McKechnie, 1974, Gibson 1979) noticed differences in individual
   preferences in the perception of the environment and the resulting
   behaviour. Knowledge of these personality dispositions and especially
   self-awareness of one's own environmental preferences should be a part
   of environmental education and relevant concepts and options for
