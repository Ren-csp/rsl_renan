Title = {Increase in Disaster Risk due to inefficient Environmental Management,
   Land use policies and Relocation Policies. Case studies from Sri Lanka},
Booktitle = {7TH INTERNATIONAL CONFERENCE ON BUILDING RESILIENCE: USING SCIENTIFIC
