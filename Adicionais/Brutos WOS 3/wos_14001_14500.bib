Title = {Causes of surface subsidence in the northwest part of Guangzhou},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON HYDROGEOLOGY AND THE
   ENVIRONMENT},
Year = {2000},
Pages = {526-530},
Note = {International Symposium on Hydrogeology and the Environment (HE 2000),
   WUHAN, PEOPLES R CHINA, OCT 17-21, 2000},
Organization = {China Univ Geosci},
Abstract = {The northwest part of Guangzhou City is an area where not only karst is
   developed over large area, but also ancient workings of coal mine are
   distributed. With the accelerated development and construction in this
   region, surface subsidence often occurs and its influence is getting
   more and more serious. Surface subsidence in this region is mostly
   related to concealed karstic caverns, while the cause for the frequent
   occurrence of surface subsidence can be attributed to over-exploitation
   of groundwater, down-seeping of polluted surface water, and the
   additional load and mechanical vibration resulted from urban
   construction. This paper suggests that special stability evaluation
   should be carried out for this region, sewage purification and drainage
   system should be improved, groundwater should be exploited rationally,
   and necessary measures should be taken in engineering construction to
   prevent and alleviate the peril and damage of surface subsidence.},
