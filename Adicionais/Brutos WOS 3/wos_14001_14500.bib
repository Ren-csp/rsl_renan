Title = {Effects of arsenite oxidation on metabolic pathways and the roles of the
   regulator AioR in Agrobacterium tumefaciens GW4},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {207-209},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {To determine the related metabolic pathways mediated by As(III)
   oxidation and whether AioR regulates other cellular responses to
   As(III), proteomic and genetic analyses were performed on the
   heterotrophic arsenite-oxidizing Agrobacterium tumefaciens GW4. The
   results showed that AioR was the main regulator for As(III) oxidation,
   and As(III) oxidation altered several cellular processes, especially
   phosphate, cell wall and carbon metabolism. In addition, the synchronous
   regulation of As resistance/oxidation proteins and phosphate transport
   proteins indicated that the metabolism of As was highly associated with
   that of phosphate. AioR suppressed the expression of the pst2/pho2
   system and up-regulated the pstl/phol system to transport As and
   phosphate economically. AioR is the key driver of strain GW4 to adapt
   well in the As(III)-enriched sediment environment.},
