Title = {Acquiring Leadership Skills through Extracurricular Activities in the
   Academic Environment: The Case of the Faculty of Administration and
   Business, University of Bucharest},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
