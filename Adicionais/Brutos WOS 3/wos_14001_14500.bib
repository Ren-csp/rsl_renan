Organization = {IPN Educ Grp},
Abstract = {This paper aims to explore the effectiveness of ePortfolio and its
   potential use to support collaborative professional learning. The sample
   consisted of eight pre-service teachers who were doing their practicum
   at technical and secondary schools in Brunei. The qualitative analyses
   from the interview data revealed the pre-service teachers rarely used
   the ePortfolio system for collaborative professional learning. However,
   they perceived ePortfolio as a useful tool for collaborative learning as
   most were willing to use and promote the ePortfolio system. There is
   high potential and competency in using ePortfolio for collaborative
   professional learning in the schools.},
