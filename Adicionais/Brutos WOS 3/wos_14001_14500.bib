@article{ WOS:000221202200001,
Author = {Berger, CR},
Title = {Speechlessness - Causal attributions, emotional features and social
   consequences},
Journal = {JOURNAL OF LANGUAGE AND SOCIAL PSYCHOLOGY},
Year = {2004},
