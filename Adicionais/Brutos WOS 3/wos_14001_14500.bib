Note = {National Academy-of-Management Meeting, LAS VEGAS, NV, AUG, 1992},
Organization = {ACAD MANAGEMENT},
Abstract = {Reliance on self-assessed training needs for input into decisions
   regarding training participation and design is increasingly common. 
   Previous study results indicate that perceptions of training utility
   influence these self-assessments.  In a sample of 380 managers and
   supervisors, this study found that training self-efficacy and managerial
   support positively influenced perceptions of training utility, while
   educational level was negatively associated with these perceptions.  In
   addition, training utility perceptions and span of control both directly
   and positively influenced reported need for training in management
   skills.  Implications for both research and practice are discussed.},
