Title = {A Two-Decade Revelation on Climate-Smart Agriculture and Soil Carbon in
   Brazil: The Bibliometric and Bibliographic Coupling Approaches},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
Series = {Advances in Science Technology and Innovation},
