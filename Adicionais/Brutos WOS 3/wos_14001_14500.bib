@article{ WOS:000548603700030,
Author = {Lun, Xiaoxiu and Lin, Ying and Chai, Fahe and Fan, Chong and Li, Hong
   and Liu, Junfeng},
Title = {Reviews of emission of biogenic volatile organic compounds (BVOCs) in
   Asia},
