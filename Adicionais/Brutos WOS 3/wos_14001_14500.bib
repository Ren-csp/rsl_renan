Title = {The structure and sustainability of street srees in Changzhou, China},
Booktitle = {2020 THIRD INTERNATIONAL WORKSHOP ON ENVIRONMENT AND GEOSCIENCE},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
