Organization = {Lab Building Construct \& Building Phys; Hellenic Petroleum; ISOMAT;
   FIBRAN; Sch Engn; Aristotle Univ Thessaloniki, Res Comm},
Abstract = {This paper presents the Shading Envelope (OE) which outlines the
   smallest volume to shade neighbouring properties during summer
   overheating periods. The construction method of the OE, by means of a
   parametric visual programming tool, is presented. The solar geometry
   data required for its construction is deduced from energy simulations
   with respect to the climate needs. The study of the impact of the
   proposed model shows a significant improvement in terms of minimizing
   summer solar radiation and increasing urban density.},
