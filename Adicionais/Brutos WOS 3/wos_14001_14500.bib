Year = {2017},
Volume = {23},
Number = {10},
Pages = {10228-10231},
Month = {OCT},
Note = {2nd International Conference on Advanced Science and Information
   Technology (ASCIT), Cheonan, SOUTH KOREA, MAY 12-13, 2017},
Abstract = {This paper provides an alternative to the Aristotelian conception of
   what it is to educate a young mind. It seems a commonplace to suppose
   that reason is the distinguishing marker for human beings, and the best
   way of showcasing humanity is through the reasoning capacity. These
   views on human nature and human excellence led people to accept the
   Aristotelian conception of education, for which sharpening up reason
   becomes the primary goal. Aristotelian conception of education,
   nonetheless, has to be evaluated in balance with the alternative
   conceptions of what it is to educate a young mind. One of these
   alternatives to Aristotelian conception comes from Laozi, representing
   some of the old wisdom an ancient China has to offer.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
