Title = {An affective design for jenang packaging in Indonesia},
Booktitle = {INTERNATIONAL CONFERENCE ON GREEN AGRO-INDUSTRY AND BIOECONOMY},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2019},
