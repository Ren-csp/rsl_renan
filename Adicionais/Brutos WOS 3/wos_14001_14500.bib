@inproceedings{ WOS:000257236400034,
Author = {Sugiyama, Y. and Tsuchiya, R. and Arisawa, R.},
Editor = {Brebbia, CA},
Title = {Evaluation of a detour guidance system during a disruption of train
   operations},
Booktitle = {URBAN TRANSPORT XIII: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
