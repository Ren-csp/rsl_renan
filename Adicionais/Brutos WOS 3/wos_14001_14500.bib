@inproceedings{ WOS:000079448800024,
Author = {Giustolisi, O and Gioia, G and Masini, P},
Editor = {Pepper, DW and Brebbia, CA and Zannetti, P},
Title = {Rainfall-runoff modelling by two component linear model: study of the
   stochastic process},
Booktitle = {DEVELOPMENT AND APPLICATION OF COMPUTER TECHNIQUES TO ENVIRONMENTAL
   STUDIES},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {1998},
Volume = {2},
Pages = {237-248},
Note = {7th International Conference on Development and Application of Computer
   Techniques to Environmental Studies (ENVIROSOFT 1998), LAS VEGAS, NV,
   NOV 10-12, 1998},
Organization = {Wessex Inst Tech; Univ Nevada},
Abstract = {In the last few years, the idea of managing the urban pipe drainage
   network with a Real Time Control System has developed because the
   environmental engineering aim is to govern the hydraulic system during
   the meteoric events.
   The correct management of the pipe drainage allows to obtain many
   results:
   to decrease the flooding hazard of the lower urban areas;
   to decrease the frequency and the amount of polluted water (especially
   in the mixed drainage systems) release in the environment;
   to equalize the waste water volumes which arrive at the purification
   plant;
   to optimize the hydrological cycle of water by means of the control of
   the water quality in order to reuse it in the irrigation pipe systems;
   to optimize the consumption of energy during the managing;
   to minimize the pipe network diameters with the aim to reduce cost,
   problems during construction in existing towns and to increase the water
   velocities in the pipes to improve the cleaning effect.
   The urban pipe drainage network monitoring and managing, which can be
   obtained with a remote system control (System Control And Data
   Acquisition), needs forecasting model of the hydrological system
   behaviour. For these reasons it was studied the possibility to simulate
   and to predict rainfall-runoff in hydrological basins with a
   single-input single-output (STSO) linear time-invariant model, see
   Giustolisi et al.(123).
   The SISO dynamic systems consisting of two components, the first
   deriving from a deterministic framework (simulation), the other deriving
   from a probabilistic framework (prediction), see Ljung(4), were tested
   thanks to the data records from seven experimental basins, see
   Giustolisi(5), Calomino(6). The study of the SISO structure, which
   correlates the concentrated rainfall with the discharge in one section,
   can be the first step to evaluate the possibility to build a
   Multiple-Input Multiple-Output model to govern the whole drainage
   network.},
