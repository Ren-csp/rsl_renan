@article{ WOS:000074571500009,
Author = {Castellnou, A and Gonzalez-Flesca, N and Grimalt, JO},
Title = {Onsite comparison of canister and solid-sorbent trap collection of
   highly volatile hydrocarbons in ambient atmospheres},
Journal = {ENVIRONMENTAL MONITORING AND ASSESSMENT},
Year = {1998},
Volume = {52},
Number = {1-2},
