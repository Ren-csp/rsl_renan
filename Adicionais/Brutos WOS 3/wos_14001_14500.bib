@inproceedings{ WOS:000257236400037,
Author = {Andriollo, M. and Caporali, A. and Martinelli, G. and Morini, A. and
   Morini, C. and Pepi, T. and Tortella, A.},
Editor = {Brebbia, CA},
Title = {Innovative fuel cell buses with automated guidance by GPS for public
   transport application},
