@inproceedings{ WOS:000260019400016,
Author = {Mattrisch, G. and Weiss, D. M.},
Editor = {Brebbia, CA},
Title = {Advanced bus transit systems - ``best practice{''} mobility solutions
   for emerging agglomerations},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2008},
