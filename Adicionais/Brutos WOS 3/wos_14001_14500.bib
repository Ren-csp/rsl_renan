@inproceedings{ WOS:000252215401091,
Author = {Rundmo, Torbjorn and Moen, Bjorg-Efin},
Editor = {Aven, T and Vinnem, JE},
Title = {Risk sensitivity and priority of safety},
Booktitle = {RISK, RELIABILITY AND SOCIETAL SAFETY, VOLS 1-3: VOL 1: SPECIALISATION
   TOPICS; VOL 2: THEMATIC TOPICS; VOL 3: APPLICATIONS TOPICS},
Series = {Proceedings and Monographs in Engineering Water and Earth Sciences},
Year = {2007},
Pages = {1623-1629},
Note = {European Safety and Reliability Conference (ESREL 2007), Univ Stavanger,
   Stavanger, NORWAY, JUN 25-27, 2007},
Organization = {Int Res Inst Stavanger; ESRA Norway; Statoil; Proactima/HSE Acad;
   Safetec; Conocophillips; DNV},
Abstract = {In addition to the magnitude of perceived risk, risk sensitivity and
   risk tolerance may influence priority of safety and decisions about
   health protection behaviour. Several studies investigating occupational
   safety has shown that management and employee priority of safety related
   to commitment and involvement of safety in these groups is important for
   employee risk and accident prevention behaviour (Cohen, 1977; Rundmo,
   1996; Smith, Cohen, Cohen and Cleveland, 1978). The core aim of the
   present study is to examine the associations between risk sensitivity,
   risk perception, worry and risk tolerance on the one hand and priority
   of safety in transport on the other hand. The results are based on a
   self completion questionnaire survey carried out among a representative
   sample of the Norwegian public during the autumn and winter 2004 (n =
   510). The response rate was 51 per cent and the sample was fairly
   representative of the Norwegian population with regard to gender, age,
   education and previous injury experience. Three variables (risk
   sensitivity, worry and priority of safety) were significant predictors
   of demand for risk mitigation. Contrary to research on risk perception
   carried out previously, the present study did not find support for the
   hypothesis that general risk perception was a significant predictor,
   neither of priority of safety, nor of demand for risk mitigation.
   However, as expected perceived risk was strongly associated with the
   respondents' worry. Worry was a significant predictor of priority of
   safety as well as for demands for risk mitigation. Personal worry did
   not have the same effect on demand for risk mitigation as general worry.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {11 NEW FETTER LANE, LONDON EC4P 4EE, ENGLAND},
