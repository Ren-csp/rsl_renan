@inproceedings{ WOS:000346067900242,
Author = {Papazachou, N. and Samara, C.},
Editor = {Lekkas, TD},
Title = {DETERMINATION OF ORGANIC AND INORGANIC ANIONS IN ATMOSPHERIC PARTICULATE
   MATTER AND DUST DEPOSITED ON MONUMENTS},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {The deterioration of historic monuments and buildings in urban
   environments is, primarily, the result of air pollution in combination
   with other biological and physicochemical phenomena. The mechanisms that
   take place for this deterioration are not fully known and require
   further study. Primary role in these processes play both the gaseous
   pollutants, such as sulfur dioxide (SO2), and the aerosol. The airborne
   particulate matter (PM) that settles on the surfaces of buildings is
   part of the deposited dust which acts as a significant medium for
   further chemical reactions. Dominant role in these reactions play the
   ionic components contained in the particles. The aim of this study was
   the determination of carboxylic anions of low molecular weight
   (formate-For, acetate-Ac and oxalate-Ox) and inorganic anions (Cl-,
   NO3-, SO42-) both in PM of the centre of Thessaloniki and in dust
   deposited on the church of Agia Sophia, in order to examine the ionic
   content of these particles and their possible effect on weathering of
   the cultural heritage monument. For this purpose, measurements of fine
   and coarse particles took place and additionally, samples of dust from
   sheltered and unsheltered points of the exterior walls of the church
   were collected. The results showed that both the mass concentrations of
   PM and the concentrations of examined ions ranged at lower levels from
   that of a typical urban area. The dominant ion of fine fraction was
   found to be SO42- accounting for up to 81\% of the total ionic mass
   while, regarding the carboxylic anions in this fraction, Ac and For
   showed the higher concentrations. On the other hand, SO42- and NO3- were
   identified as the main components of the coarse fraction, representing
   almost the 70\% of the total ionic mass while the most abundant
   carboxylic ion was Ac. A similar situation prevailed also in dust
   samples while all the ions showed a common trend of increasing
   concentrations at sheltered points. Ox were not detected at any sample
   of dust. Generally, the contribution of low molecular weight carboxylic
   acids in the total ion mass did not exceed the percentage of 13\%
   neither in PM nor in dust samples.},
