@article{ WOS:000221735600010,
Author = {Maddox, WT and Ashby, FG},
Title = {Dissociating explicit and procedural-learning based systems of
   perceptual category learning},
Journal = {BEHAVIOURAL PROCESSES},
Year = {2004},
Volume = {66},
Number = {3},
Pages = {309-332},
Month = {JUN 30},
Note = {Meeting of the Society-for-the-Quantitative-Analyses-of-Behavior (SQAB
   2003), San Francisco, CA, MAY 23-24, 2003},
Organization = {Soc Quantitat Analyses Behav},
Abstract = {A fundamental question is whether people have available one category
   leaming system, or many. Most multiple systems advocates postulate one
   explicit and one implicit system. Although there is much agreement about
   the nature of the explicit system, there is less agreement about the
   nature of the implicit system. In this article, we review a dual systems
   theory of category learning called competition between verbal and
   implicit systems (COVIS) developed by Ashby et al. (1998). The explicit
   system dominates the learning of verbalizable, rule-based category
   structures and is mediated by frontal brain areas such as the anterior
   cingulate, prefrontal cortex (PFC), and head of the caudate nucleus. The
   implicit system, which uses procedural learning, dominates the learning
   of non-verbalizable, information-integration category structures, and is
   mediated by the tail of the caudate nucleus and a dopamine-mediated
   reward signal. We review nine studies that test six a priori predictions
   from COVIS, each of which is supported by the data. (C) 2004 Elsevier
   B.V. All rights reserved.},
