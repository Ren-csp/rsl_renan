@inproceedings{ WOS:000185615100050,
Author = {Arulanantham, R and Feldman, L},
Editor = {Tiezzi, E and Brebbia, CA and Uso, JL},
Title = {Sustaining risk-informed decision making (RIDM) measures},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT IV, VOLS 1 AND 2},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2003},
Volume = {18-19},
Pages = {539-547},
Note = {4th International Conference on Ecosystems and Sustainable Development,
   SIENA, ITALY, JUN 04-06, 2003},
Organization = {Univ Siena; Wessex Inst Technol},
Abstract = {Risk-informed methodologies have been employed in recent years to
   environmental issues such as the redevelopment of brownfield sites,
   restoration of chemically affected soil and groundwater, and
   decision-making related to wetlands and surface waters impacted by
   pollutants. These methodologies have been applied to site
   prioritization, soil and groundwater investigations, remediation and
   managing the risk of residual contaminants. In an ideal world, the RIDM
   oriented remediation of a chemically affected property can be
   effectively realized by measures that are integrated into the proposed
   redevelopment project. One simple example would be to pave immobile
   chemically affected soil and park cars on the new surface and to ensure
   that the cap is maintained as intended.
   However, critics of RIDM solutions have argued that these risk
   management solutions are not sustainable without effective assurances,
   and that the lack of these long-term assurances can represent real
   potential future additional liability to the responsible party, the
   community, the developer, insurance companies and regulatory agencies.
   These costs can take forms such as human health impacts, environmental
   health impacts, and financial impacts in the future. The critics say
   that this has happened before and that this can happen again. How can we
   reap the societal benefits that come with urban redevelopment programs
   at brownfield sites and assure that potential future liabilities
   associated with these solutions are minimized to acceptable levels?
   Conventional risk management techniques applied to brownfield
   redevelopment sites can be described as institutional and engineering
   measures. The proper selection, design, implementation, enforcement and
   use of institutional controls are therefore critical to the successful
   remediation and reuse of redeveloped brownfields. This paper addresses
   several models that can be applied to better assure sustainable and
   long-term risk management at impacted sites.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
