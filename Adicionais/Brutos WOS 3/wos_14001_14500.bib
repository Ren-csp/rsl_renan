@inproceedings{ WOS:000276383800080,
Author = {Zhang Meiqing and Jiang Lin},
Editor = {Zhu, KL and Zhang, H},
Title = {On the Comparative Research of Construction Process of Innovational City
   in China},
Booktitle = {COMPREHENSIVE EVALUATION OF ECONOMY AND SOCIETY WITH STATISTICAL SCIENCE},
Year = {2009},
Pages = {459-464},
Note = {2nd Conference of the
   International-Institute-of-Applied-Statistics-Studies, Qingdao, PEOPLES
   R CHINA, JUL 24-29, 2009},
Organization = {Int Inst Appl Stat Studies; Appl Stat Inst Shandong Prov; 2009 IIASS
   Conf Comm},
Abstract = {The construction of innovational city is the key to urban economic
   development in knowledge-based economy era. Based on the analysis on the
   evaluative index system of innovational city, it takes 19 important
   cities for reference, such as Beijing. The paper analyzes the
   connotation of innovative city, the principle of innovative design and
   the construction of evaluative index system. Three indicators in level-1
   are respectively innovation environment, innovation ability and
   innovation performance. There is 13 indicators in level-2, such as
   infrastructure, investment in innovation, investment in human capital
   and etc. In addition, there are 44 indicators in level-3. Based on the
   detailed analysis of the indicators, the paper discusses the
   construction process of innovational city and gives the improvement
   scheme.},
Publisher = {AUSSINO ACAD PUBL HOUSE},
Address = {PO BOX 893, MARRICKVILLE, NSW 2204 00000, AUSTRALIA},
