@inproceedings{ WOS:000328331100010,
Author = {Ghezelsofloo, Abbas Ali and Ardalan, Raheleh Valizadeh},
Editor = {Hadi, K and Copty, NK},
Title = {Identifying the major sources of groundwater contaminants and estimating
   their pollutions potential in the Mashhad plain aquifer},
Booktitle = {GROUNDWATER MODELING AND MANAGEMENT UNDER UNCERTAINTY},
Year = {2012},
Pages = {69-76},
Note = {6th International Groundwater Symposium, Kuwait Inst Sci Res, KUWAIT,
   NOV 19-21, 2012},
Organization = {Int Assoc Hydro Environm Engn \& Res, Groundwater Hydraul \& Management
   Comm},
Abstract = {Groundwater is a vital natural resource for the economical and secure
   provision of potable water supply in both urban and rural environments.
   It plays a fundamental role in human well-being, as well as that of many
   aquatic ecosystems. The rapid growth of urban areas has supplementary
   affects on the groundwater quality due to over exploitation of resources
   and inappropriate waste disposal actions. The sources of groundwater
   contamination are numerous and various; in addition to natural
   processes, practically every type of facilities or construction
   activities by human and many human physical activities may eventually
   cause groundwater quality problems.
   The Mashhad plain is located in the north-east of Iran, in an area of
   great pollution sources and a serious threat for the health of
   groundwater supplies resources. This paper discusses the identification
   of the major sources of groundwater pollutant and estimates their
   contamination potential in the Mashhad plain.
   In this research, at first a list of the most important contaminant
   sources in the Mashhad plain has been prepared. For this purpose with
   collection of information regarding potential pollutants in the area and
   with field surveys, monitoring, sampling and analysis of water and
   pollutants, volume of pollution and the risk level of contaminants are
   determined.
   The results show that, the highest pollution potential in the study area
   is in the population centres and then industries in the Mashhad plain
   unconfined aquifer.},
