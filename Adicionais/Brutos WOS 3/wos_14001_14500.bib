@inproceedings{ WOS:000296487000008,
Author = {Wei Yiming},
Editor = {Zhang, YL},
Title = {Low Carbon Economy and the Chinese Tobacco Industry},
Booktitle = {PROCEEDINGS OF THE 7TH EURO-ASIA CONFERENCE ON ENVIRONMENT AND CSR:
   TECHNOLOGICAL INNOVATION AND MANAGEMENT SCIENCE SESSION, PT I},
Year = {2011},
Pages = {48-53},
Note = {7th Euro-Asia Conference on Environment and CSR, Huangshan, PEOPLES R
   CHINA, MAY 09-12, 2011},
Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {With the development of the Chinese economy and society, people's
   lifestyles and behaviors are changing rapidly. Although, the economic
   development improves the quality of life, it also brings the environment
   problems. Therefore, the harmonious development between man and nature
   in terms of low-carbon economy may become a main theme of the world
   economy. In this paper, the author stresses that the Chinese tobacco
   industry is not a low-carbon economy industry based on analyses of the
   current situation of the industry and making comparative analyses on
   comprehensive incomes and relevant costs. At the end of the paper, the
   author also provides suggestions to the transformation of Chinese
