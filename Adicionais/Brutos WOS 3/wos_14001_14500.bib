@inproceedings{ WOS:000331259200114,
Author = {Duru, Dilek Goksel and Duru, Adil Deniz and Barkana, Duygun Erol and
   Sanli, Oner and Ozkan, Mehmed},
Book-Group-Author = {IEEE},
Title = {Assessment of Surgeon's Stress Level and Alertness Using EEG during
   Laparoscopic Simple Nephrectomy},
Booktitle = {2013 6TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2013},
