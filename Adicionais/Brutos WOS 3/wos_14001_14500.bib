@article{ WOS:000259425500006,
Author = {Farach, Frank J. and Mennin, Douglas S. and Smith, Rita L. and
   Mandelbaum, Matthew},
Title = {The impact of pretrauma analogue GAD and posttraumatic emotional
   reactivity following exposure to the September 11 terrorist attacks: A
   longitudinal study},
Journal = {BEHAVIOR THERAPY},
Year = {2008},
Volume = {39},
Number = {3},
Pages = {262-276},
Month = {SEP},
Note = {39th Annual Meeting of the Association-for-the-Advancement-of
   Behavior-Therapy, Washington, DC, NOV, 2005},
Organization = {Assoc Advancement Behav Therapy},
Abstract = {The relation between analogue generalized anxiety disorder (GAD)
   assessed the day before the events of September 11, 2001 (9/11) and
   long-term outcome was examined in 44 young adults who were directly
   exposed the following day to the terrorist attacks in New York City.
   After controlling for high exposure to the attacks, preattack analogue
   GAD was associated with greater social and work disability, loss of
   psychosocial resources, anxiety and mood symptoms, and worry, but not
   symptoms of posttraumatic stress, assessed 12 months after 9/11. Fear
   and avoidance of emotions assessed 4 months after 9/11. statistically
   mediated the relation between preattack analogue GAD and social and work
   disability, loss of psychosocial support, mood and anxiety symptoms, and
   worry at 12-month follow-up. Avoidance of emotions 4 months after 9/11
   also mediated the relation between preattack analogue GAD and stress
   symptoms 12 months after 9/11.},
Publisher = {ELSEVIER INC},
Address = {525 B STREET, STE 1900, SAN DIEGO, CA 92101-4495 USA},
Type = {Article; Proceedings Paper},
