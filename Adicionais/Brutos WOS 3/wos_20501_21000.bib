@inproceedings{ WOS:000257427600016,
Author = {AlAli, E. H.},
Editor = {Esteve, YV and Brebbia, CA and Rico, DP},
Title = {Groundwater history and trends in Kuwait},
Booktitle = {SUSTAINABLE IRRIGATION MANAGEMENT, TECHNOLOGIES AND POLICIES II},
