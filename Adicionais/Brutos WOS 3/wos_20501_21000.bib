@inproceedings{ WOS:A1996BJ20B00389,
Author = {Andruski, JE and Kuhl, PK},
Editor = {Bunnell, HT and Idsardi, W},
Title = {The acoustic structure of vowels in mothers' speech to infants and
   adults},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {1545-1548},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Research has shown that exposure to a specific language alters infants'
   perception of vowel sounds by the rime they reach 6 months of age. This
   raises the important question of how infants develop language-specific
   patterns of vowel perception from the language-general pattern they
   appear to be born with. Language spoken to infants may exert an
   important influence in this regard. The present study compares the
   acoustic structure of vowels in the words `'sheep'' and `'shoes''
   produced by 10 mothers in conversation with their infants, with their
   acoustic structure when produced by the same 10 women in conversation
   with an adult. Mothers were instructed to play with their infants using
   a toy sheep and pair of shoes, They were asked to use the same words in
   conversation with an adult. The infant-directed tokens exhibited higher
   F0, greater pitch excursions and longer duration than the adult-directed
   tokens, as is typical of motherese, Although F0 was significantly higher
   in infant-directed vowels, F1 remained at essentially the same frequency
   as in adult-directed /i/ and /u/. In contrast, F2 was significantly
   higher in infant-directed /i/ and significantly lower in infant-directed
   /u/ than in the adult-directed tokens. Thus, the infant-directed tokens
   reached more extreme acoustic targets, The formant structure also
   indicated an equivalent or slightly greater degree of coarticulation of
   infant-directed /u/ with the preceding fricative in `'shoes.'' Overall,
   mothers in this study consistently hyperarticulated vowels in speech to
   infants. Hyperarticulation may contribute to the acquisition of native
   language vowel categories by increasing the degree of acoustic
   separation between vowel categories.},
Publisher = {I E E E},
Address = {345 E 47TH ST, NEW YORK, NY 10017},
