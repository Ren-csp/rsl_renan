@article{ WOS:A1995RC98600004,
Author = {NIEDERMEIER, CL and SEARIGHT, HR and HANDAL, PJ and MANLEY, CM and
   BROWN, NY},
Title = {PERCEIVED FAMILY FUNCTIONING AMONG ADOLESCENT PSYCHIATRIC-INPATIENTS -
   VALIDITY OF THE FAMILY-OF-ORIGIN SCALE},
