Number = {6},
Pages = {996-1003},
Month = {DEC},
Note = {14th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, ATLANTA, GA,
   APR-MAY -, 1999},
Organization = {Soc Ind \& Org Psychol},
Abstract = {This study replicates. integrates, and extends prior research on the
   dispositional, contextual, and cognitive antecedents of feedback-seeking
   behavior. Regression analysis was used to analyze data collected from a
   sample of salespeople (N = 310) from 2 Fortune 500 companies. The study
   hypotheses were supported with the following results. First, the
   individual disposition of learning goal orientation and the contextual
   factors of leader consideration and leader initiation of structure
   influenced cognitions about the perceived cost and value of feedback
   seeking. Second, the strength of the relationship of learning goal
   orientation with the cost and value perceptions was moderated by The
   leadership style of the supervisor.},
