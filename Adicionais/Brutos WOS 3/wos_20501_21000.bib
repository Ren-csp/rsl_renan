@article{ WOS:A1997YG30700002,
Author = {Compton, RJ and Levine, SC},
Title = {Menstrual cycle phase and mood effects on perceptual asymmetry},
Journal = {BRAIN AND COGNITION},
Year = {1997},
Volume = {35},
Number = {2},
Pages = {168-183},
Month = {NOV},
Note = {19th Annual Mid-Year Meeting of the
   International-Neuropsychological-Society, VELDHOVEN, NETHERLANDS, JUN  
   20, 1996},
Organization = {Int Neuropsychol Soc},
Abstract = {Several studies have reported shifts in perceptual asymmetry during the
   menstrual cycle, but the potential confounding effect of mood changes
   has been largely ignored. In this study, 24 female subjects completed
   four visual laterality tasks and a mood questionnaire at three phases of
   the cycle. Results indicate no overall effect of cycle phase on any of
   the asymmetry or mood scores. However, results revealed significant
   associations between affect and perceptual asymmetry on a face
   perception task. Implications for mood effects on perceptual asymmetry
   and future research on cycle-related shifts in asymmetry are discussed.
   (C) 1997 Academic Press.},
