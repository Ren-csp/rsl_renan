Pages = {1072-1076},
Note = {2nd Edition of the International Conference on Psychology and the
   Realities of the Contemporary World (PSIWORLD), Fac Psychol \& Educ Sci,
   Bucharest, ROMANIA, OCT 27-30, 2011},
Organization = {Romanian Soc Appl Expt Psychol},
Abstract = {This study aims to measure the impact of situational attributes on the
   coherence of agreeable behavior. Also, the study focuses on prediction
   of agreeable behavior's evolution from a dynamic perspective. The
   idiographic approach was applied to two cases taking into account the
   interaction between person and situation (PxS). Using structural
   equation modeling a different impact of situational attributes in the
   perception of the two cases was discovered. The cross-validation
   procedure we used allowed to predict the dynamic evolution of agreeable
   behavior in new contexts. (C) 2012 Published by Elsevier B.V. Selection
   and/or peer-review under responsibility of PSIWORLD2011},
