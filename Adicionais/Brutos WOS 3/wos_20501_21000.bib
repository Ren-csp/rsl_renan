Organization = {Assoc Malaysian Environm Behav Researchers},
Abstract = {The excessive amount of carbon dioxide (CO2) in the atmosphere is among
   the most significant effects of global warming, which leads to many
   disadvantages. The objective of this paper is to calculate the amount of
   carbon dioxide sequestration by beach morning glory placed on a flat
   roof, in order to estimate the CO2 reduction in the atmosphere. The
   study concluded that, planting beach morning glory on the roof surface
   could reduce the indoor air temperature as well as mitigating the
   greenhouse gas emission, particularly carbon dioxide, thus enhance the
   quality of life. (C) 2015 The Authors. Published by Elsevier Ltd.},
