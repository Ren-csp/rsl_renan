@inproceedings{ WOS:000234081200042,
Author = {Vermiglio, G and Tripepi, MG and Vermiglio, V and Sansotta, C and
   Testagrossa, B},
Editor = {Costa, G and Goedhard, WJA and Ilmarinen, J},
Title = {A physical model of muscle working to evaluate the work ability},
Booktitle = {Assessment and Promotion of Work Ability, Health and Well-being of
   Ageing Workers},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2005},
Volume = {1280},
