Month = {JUN},
Note = {Conference of the Midwestern-Psychological-Association, CHICAGO, IL,
   MAY, 1994},
Organization = {Midwestern Psychol Assoc},
Abstract = {The effects of gender and dress on helping behavior were examined.
   Perceptions and feelings influencing decisions to help were also
   investigated in an exploratory manner. 128 subjects were asked by a male
   or female confederate for 37 cent and afterwards completed a
   questionnaire. The confederates were either well-dressed or sloppily
   dressed. Analysis indicated that the woman was helped more than the man
   but that well-dressed and sloppily dressed confederates were helped
   equally. Subjects who helped generally perceived confederates to be
   needler than subjects who did not. Further, subjects who did not help
   reported greater discomfort from the helping request than subjects who
   helped.},
