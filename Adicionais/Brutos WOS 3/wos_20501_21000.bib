Year = {2008},
Pages = {297-306},
Note = {NATO Advanced Research Workshop on Dangerous Pollutants, (Xenobiotics)
   in Urban Water Cycle, Lednice, CZECH REPUBLIC, MAY 03-06, 2007},
Organization = {NATO},
Abstract = {This study was focused on membrane technology and possibility of using
   membrane processes for wastewater treatment. The main idea was to
   monitor a starting phase of domestic wastewater treatment plant model.
   The monitoring of domestic plant model was realized at the municipal
   wastewater treatment plant (WWTP) Devinska Nova Ves - Bratislava in the
   period between February 2005 and September 2006. The system was stable
   without external chemical treatment of membrane modules and the quality
   permeate was very high. Removal of COD and BOD5 was in range of 91-98\%.
   The process of nitrification was very successful with the high
   efficiency (>95\%). During the whole experiment WWTP was working without
   any problem.},
