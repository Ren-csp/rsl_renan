@article{ WOS:000172496600001,
Author = {Wilhelm, FH and Kochar, AS and Roth, WT and Gross, JJ},
Title = {Social anxiety and response to touch: incongruence between
   self-evaluative and physiological reactions},
Journal = {BIOLOGICAL PSYCHOLOGY},
Year = {2001},
