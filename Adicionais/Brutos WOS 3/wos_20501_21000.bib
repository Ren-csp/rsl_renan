Title = {A dynamical model of stereopsis to form 3-D surfaces},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {397-400},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {Random-dot stereograms fuse to give the vivid 3-dimensional surfaces.
   The perception of surfaces is not explained only by the solution of the
   binocular correspondence problem, that the correspondence between dots
   is not uniquely defined only by the images. To obtain the correct
   correspondence, some algorithm is required to form the surfaces from the
   correspondence. In this paper, we propose the model of binocular
   stereopsis, which form the 3-dimensional surfaces as we perceive. The
   model explicitly treats the structure of surfaces, by the various
   spatial relations of correspondence. The macro parameter defined by the
   consistency between various relations, uniquely leads the global order
   of surfaces.},
