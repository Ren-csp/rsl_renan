@inproceedings{ WOS:001345730900006,
Author = {Liu, Ruida and Tian, Chao},
Book-Group-Author = {IEEE},
Title = {Staggered Quantizers for Perfect Perceptual Quality: A Connection
   between Quantizers with Common Randomness and Without},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON INFORMATION THEORY WORKSHOPS,
   ISIT-W 2024},
Year = {2024},
Note = {IEEE International Symposium on Information Theory (ISIT), Athens,
   GREECE, JUL 07, 2024},
Organization = {IEEE},
Abstract = {The rate-distortion-perception (RDP) framework has attracted significant
   recent attention due to its application in neural compression. It is
   important to understand the underlying mechanism connecting procedures
   with common randomness and those without. Different from previous
   efforts, we study this problem from a quantizer design perspective. By
   analyzing an idealized setting, we provide an interpretation of the
   advantage of dithered quantization in the RDP setting, which further
   allows us to make a conceptual connection between randomized (dithered)
   quantizers and quantizers without common randomness. This new
   understanding leads to a new procedure for RDP coding based on staggered
   quantizers.},
