Title = {Aqueous photocatalysis, natural organic matter characterization and
   removal: A case study of the photacatalytic oxidation of fulvic acid},
Booktitle = {DANGEROUS POLLUTANTS (XENOBIOTICS) IN URBAN WATER CYCLE},
