Title = {Clustering box office movie with Partition Around Medoids (PAM)
   Algorithm based on Text Mining of Indonesian subtitle},
Booktitle = {3RD INTERNATIONAL SEMINAR ON SCIENCES SCIENCES ON PRECISION AND
   SUSTAINABLE AGRICULTURE (ISS-2016)},
