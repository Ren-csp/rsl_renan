@inproceedings{ WOS:000166346000009,
Author = {Ardron, PA and Rotherham, ID and Gilbert, O},
Editor = {Jones, M and Rotherham, ID},
Title = {Peat-cutting and upland landscapes: case studies from the South Pennines},
Booktitle = {LANDSCAPES - PERCEPTION, RECOGNITION AND MANAGEMENT: RECONCILING THE
   IMPOSSIBLE?, CONFERENCE PROCEEDINGS},
Series = {LANDSCAPE ARCHAEOLOGY AND ECOLOGY},
Year = {1998},
Volume = {3},
Pages = {65-69},
Note = {National Conference on Landscapes - Perception, Recognition and
   Management, SHEFFIELD HALLAM UNIV, SHEFFIELD, ENGLAND, APR 02-04, 1996},
Abstract = {The South Pennines and Peak District uplands are characterised by
   peatland features, including blanket bog, heather and grass moor.
   Extensive areas have been recognised as being affected by burning, heavy
   grazing by domestic livestock, and by the long-term impacts of air
   pollution over several centuries. However, the potential influence of
   peat-cutting on these landscapes has been largely overlooked.
   Recent extensive and intensive surveys have led to a re-evaluation of
   the relative importance of peat-cutting and associated activities from
   at least medieval times onwards. The evidence suggests that in some
   areas of the South Pennines, up to 40-50 per cent of the blanket bog
   surface area has been removed. Across the whole of the Peak District
   Dark Peak, it appears that around 34 million cubic metres of pear have
   been removed. This compares with suggested volumes of peat taken from
   the Norfolk Broads for example, of around 30 million cubic metres
   (Rackham, 1986).
   It is suggested that this scale of pear-cutting processing and
   transportation, has dramatically altered the upland landscape. Removal
   of the pear surface has influenced and modified vegetation and
   subsequent land-use. Drains, peat transportation route-ways, and
   related-processing features dominate the contemporary landscape.
   The present-day ecological character of these uplands is largely
   determined by the human impact on the environment, of extensive,
   probably mainly medieval, peat-cutting and associated disruption. The
   main effects have been through:
   1. Removal of the peat surface and in some cases, complete removal of
   the pear profile. Subsequent vegetation patterns are determined by this
   dramatic modification of the substrate.
   2. Extensive disruption of hydrology by both drainage and the effects of
   fragmentation and removal of the peat itself.
   3. The indirect impact of route-ways (Tor sleds, etc.) and
   peat-storage/peat-processing features on the lower slopes below the
   blanket bog area.
   Quite clearly, the importance of peat-winning as suggested, in the
   medieval economy, would have influenced land-use, landscape and ecology
   throughout the area. Settlement patterns, human population levels,
   transport systems and farming would all have been affected by the
   exploitation of the Pennine peatlands.
   Finally, one other major impact identified, is the influence of
   peat-cutting on the archaeological indicators of historic landscapes,
   formerly covered by blanket peats. This clearly affects the evidence of
   cultures from the Mesolithic onwards. By opening this archaeological
   evidence to erosion and other disruption, removal of the pear blanket
   has led to extensive modification of artefacts and features of former
   landscapes. Scatterings of Mesolithic Neolithic and Bronze Age flints
   for example, may have been radically affected by this process of
   accelerated erosion, transportation and re-deposition; and also by
   direct impact of peat-cutting and associated re-distribution associated
   with peat utilisation. This may have involved carriage of flints in cut
   pear to heaths, kilns and ultimately midden scatters, etc.},
