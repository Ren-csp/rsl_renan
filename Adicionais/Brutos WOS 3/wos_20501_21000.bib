Pages = {169-174},
Note = {3rd International Conference on Renewable Energies Offshore-RENEW,
   Lisbon, PORTUGAL, OCT 08-10, 2018},
Organization = {Pacific Northwest National Laboratory},
Abstract = {Tidal current can be used in power generation with exact predictability
   and continuity regardless of seasons. Even the high tidal current speed
   would yield large energy generation, not many locations possess these
   advantages. Therefore, it is required to develop the micro-scale marine
   turbine to extend the feasible areas having low tidal velocity. This
   paper introduces the development process for harvesting ocean energy for
   local small-scale usage. A small scale tidal device has been developed
   with the site conditions obtained from survey and numerical simulation
   and installed near Hong Kong's west coast in Tuen Mun. The duct was
   attached to amplify the current speed to the rotor. A prototype turbine
   was deployed and installed and tested of its performance. The field
   records validated the numerical simulation results and it demonstrated
   the feasibility of using micro-scale ocean turbine as part of a
   coastline urban application and development.},
