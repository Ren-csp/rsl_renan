@inproceedings{ WOS:000270762800033,
Author = {Barbosa, Filipe and Mota, Catarina and Alves, Miguel and Alcantara,
   Cristina and Rossinol, Bartolomeu and Patricio, Patricia and Barbosa,
   Antonio and Ferreira, Carlos},
Editor = {Shoenfeld, Y and Gershwin, ME},
Title = {Alexithymia in Systemic Lupus Erythematosus Patients},
Booktitle = {CONTEMPORARY CHALLENGES IN AUTOIMMUNITY},
