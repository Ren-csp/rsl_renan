@article{ WOS:000178360100003,
Author = {Hawkins, SJ and Gibbs, PE and Pope, ND and Burt, GR and Chesman, BS and
   Bray, S and Proud, SV and Spence, SK and Southward, AJ and Southward, GA
   and Langston, WJ},
Title = {Recovery of polluted ecosystems: the case for long-term studies},
Journal = {MARINE ENVIRONMENTAL RESEARCH},
