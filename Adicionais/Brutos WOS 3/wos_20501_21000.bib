@article{ WOS:000172138500023,
Author = {Lettinga, G and Van Lier, JB and Van Buuren, JCL and Zeeman, G},
Title = {Sustainable development in pollution control and the role of anaerobic
   treatment},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2001},
Volume = {44},
