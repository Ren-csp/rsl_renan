@article{ WOS:000186035500014,
Author = {Arbib, MA},
Title = {Rana computatrix to human language: towards a computational
   neuroethology of language evolution},
Journal = {PHILOSOPHICAL TRANSACTIONS OF THE ROYAL SOCIETY A-MATHEMATICAL PHYSICAL
   AND ENGINEERING SCIENCES},
