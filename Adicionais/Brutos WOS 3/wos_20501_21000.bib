@article{ WOS:000176001600001,
Author = {Bardy, BG and Oullier, O and Bootsma, RJ and Stoffregen, TA},
Title = {Dynamics of human postural transitions},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2002},
Volume = {28},
Number = {3},
Pages = {499-514},
Month = {JUN},
Note = {10th International Conference on Perception and Action, EDINBURGH,
   SCOTLAND, AUG 08-13, 1999},
Abstract = {In the present study, the authors examined transitions between postural
   coordination modes involved in human stance. The analysis was motivated
   by dynamical theories of pattern formation, in which coordination modes
   and transitions between modes are emergent, self-organized properties of
   the dynamics of animal-environment systems. In 2 experiments, standing
   participants tracked a moving target with the head. Results are
   consistent with the hypothesis that changes in body coordination follow
   typical nonequilibrium phase transitions, exhibiting multistability,
   bifurcation, critical fluctuations, hysteresis, and critical slowing
   down. The findings suggest that posture may be organized in terms of
   dynamical principles and favor the existence of general and common
   principles governing pattern formation and flexibility in complex
   systems.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
