@inproceedings{ WOS:000560968000016,
Author = {Gallagher, Shaun},
Editor = {Engel, AK and Friston, KJ and Kragic, D},
Title = {Do We (or Our Brains) Actively Represent or Enactively Engage with the
   World?},
Booktitle = {PRAGMATIC TURN: TOWARD ACTION-ORIENTED VIEWS IN COGNITIVE SCIENCE},
Series = {Strungmann Forum Reports},
Year = {2015},
Pages = {285-296},
Note = {17th Ernst Strungmann Forum on Pragmatic Turn - Toward Action-Oriented
   Views in Cognitive Science, Frankfurt am Main, GERMANY, OCT 26-31, 2014},
Abstract = {This chapter reviews scientific discussions of several problems (free
   will, social cognition, perception) that reflect a representational
   approach to cognitive science, and contrasts them with embodied,
   enactive approaches. It asks whether predictive coding models can
   adjudicate between these different views and suggests that predictive
   coding models can go either way. An interpretation is then offered that
   is designed to push such models toward the enactive camp. It concludes
   by considering the suggestion that enactivism is a philosophy of nature
   (as defined by Godfrey-Smith), rather than a scientific research
   program, and suggests that enactivism's attempt to rethink the nature of
   mind and brain also involves rethinking the concept of nature.},
