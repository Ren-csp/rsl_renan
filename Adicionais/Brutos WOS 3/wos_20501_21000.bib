@article{ WOS:000237962400001,
Author = {Wallace, JC and Page, EE and Lippstreu, M},
Title = {Applicant reactions to pre-employment application blanks: A legal and
   procedural justice perspective},
Journal = {JOURNAL OF BUSINESS AND PSYCHOLOGY},
Year = {2006},
Volume = {20},
Number = {4},
Pages = {467-488},
Month = {SUM},
Note = {64th Annual Meeting of the Academy-of-Management, New Orleans, LA, AUG
   06-11, 2004},
Organization = {Acad Management},
Abstract = {The current research investigated applicant reactions derived from
   common application blanks. Previous work has found applications to be
   riddled with legally inadvisable items, but limited research has
   attempted to understand how such items might affect applicants. By using
   organizational justice theory as a framework, two studies examined
   applicant reactions from two application blanks: a legally advisable
   application and a legally problematic application. It was found that
   applicants completing the legally problematic application had lower
   perceptions of justice and expressed higher litigation intentions
   compared to those completing the legally advisable application,
   especially for those that were rejected without an explanation.},
