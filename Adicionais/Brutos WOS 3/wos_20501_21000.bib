@article{ WOS:A1993MN53500006,
Author = {DOLAN, RT and ARNKOFF, DB and GLASS, CR},
Title = {CLIENT ATTACHMENT STYLE AND THE PSYCHOTHERAPISTS INTERPERSONAL STANCE},
Journal = {PSYCHOTHERAPY},
