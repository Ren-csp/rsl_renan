@article{ WOS:000075916000012,
Author = {Masson, GS and Mestre, DR},
Title = {A look into the black box: eye movements as a probe of visual motion
   processing},
Journal = {CAHIERS DE PSYCHOLOGIE COGNITIVE-CURRENT PSYCHOLOGY OF COGNITION},
Year = {1998},
Volume = {17},
Number = {4-5},
Pages = {807-829},
Month = {AUG-OCT},
Note = {Conference in Homage to Jean Requin: Neural Substrates of Cognitive
   Processes, MARSEILLE, FRANCE, MAY 15-16, 1997},
Abstract = {In primates, several cortical areas organized in a hierarchical way are
   necessary to compute local measurements of visual motion and then to
   extract higher-order information about object- and self-motion. Such
   processing allows us to deal with complex optical flows resulting from
   our displacement in a 3D environment. During such displacement, we can
   relocate our gaze and lock it onto a newly acquired visual target.
   Visual stabilization of the eyes requires complex processing of the
   translational component of the visual flow in which the motion of the
   object of interest is embedded. By recording eye movements, we can break
   down the various stages of visual motion processing and distinguish
   between the relative contributions of the low-level, automatic filtering
   and the higher-order, cognitive selection of the motion of interest for
   the oculomotor system. By recording the very first part of tracking
   responses, we can identify elementary processing modules corresponding
   to linear filters implemented in the early stages of the cortical motion
   pathway. By studying gradual changes of eye movement behaviors over time
   as a function of the perceptual or attentional states of the observers,
   we can understand the dynamical relationships between perception and
   action. With this experimental framework, we may start to open the
   ``black box{''} in which visual information processing has been kept for
   many years in most oculomotor models.},
