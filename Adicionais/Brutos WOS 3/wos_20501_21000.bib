@inproceedings{ WOS:000222427500011,
Author = {Stoll-Kleemann, S},
Editor = {Light, S},
Title = {The social-psychological dimension of biodiversity conservation},
Booktitle = {ROLE OF BIODIVERSITY CONSERVATION IN THE TRANSITION TO RURAL
   SUSTAINABILITY},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SUB-SERIES 4, SCIENCE AND
   TECHNOLOGY POLICY},
Year = {2004},
Volume = {41},
Pages = {147-159},
Note = {NATO Advanced Research Workshop on Role of Biodiversity Conservation in
   the Transition to Rural Sustainability, Krakow, POLAND, NOV 05-09, 2002},
Organization = {NATO Sci Program, Sci \& Technol Policy \& Org},
Abstract = {This paper references and interprets previous research on the
   perspectives of residents, landowners and managers of protected areas in
   Germany to explain why conflicts around biodiversity management can
   arise. The research relied on grounded theory approaches, sensitive
   interactive interviews, and the gradual application of
   social-psychological theories of social identity and reactance. The
   evidence is strong that there are powerful emotional and cultural
   drivers that divide biodiversity managers and local land-users and
   residents into two camps, which are maintained by stereotyping and group
   bonding. Based on these findings, constructive ways are then proposed to
   reconcile these differing perceptions.},
