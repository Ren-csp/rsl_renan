@inproceedings{ WOS:000345656000034,
Author = {Nakamura, S. and Wang, Q. and Gong, S. and Takai, Y. and Lu, S. and
   Nakajima, D. and Suzuki, M. and Sekiguchi, K. and Miwa, M.},
Editor = {Longhurst, JWS and Brebbia, CA},
Title = {Release rate of daughter allergenic species from Cryptomeria
   japonica pollen grains trapped in air polluted wet deposition},
Booktitle = {AIR POLLUTION XX},
