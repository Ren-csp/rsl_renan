@article{ WOS:000431743000186,
Author = {Mansour, Ezzat Abdul Aziz and Ibrahim, Abdul Latiff Mohd},
Title = {The Use of Electronic Databases by Post Graduate Students at King Abdul
   Aziz University Library},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
