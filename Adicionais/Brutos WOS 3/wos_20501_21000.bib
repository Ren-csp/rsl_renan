@article{ WOS:000230157500005,
Author = {Masters, JL},
Title = {A midwestern response to the events of September 11, 2001},
Journal = {JOURNAL OF LOSS \& TRAUMA},
Year = {2005},
Volume = {10},
Number = {4},
Pages = {369-381},
Month = {JUL-SEP},
Note = {55th Annual Meeting of the Gerontological-Society-of-America, BOSTON,
   MA, NOV 22-26, 2002},
Organization = {Gerontol Soc Amer},
Abstract = {The events of September 11, 2001, seemingly changed the way Americans
   viewed the world and their sense of vulnerability. What is not clear is
   the impact 9/11 had on different age groups shortly after the attacks. A
   quasi-experimental design was employed to study the effects of 9/11 on
   298 older and younger adults. Drawing on the work of Leon Festinger,
