Editor = {Hickey, KL and Kantarelis, D},
Title = {Assessing the effectiveness of international, environmental
   institutions: Rethinking institutional goals},
Booktitle = {82541K0URAL ENVIRONMENT: CONCEPTS \& SOLUTIONS, PROCEEDINGS},
Year = {1996},
Pages = {268-278},
Note = {2nd International Interdisciplinary Conference on the Environment,
   NEWPORT, RI, JUN 15-19, 1996},
Organization = {Interdisciplinary Environm Assoc},
Abstract = {International institutions are usually considered effective to the
   extent that they achieve their goals as enunciated in the agreement
   establishing the institution. But too often there is no difference
   between a political and a legal reading of an international treaty and
   its enunciated goals are taken as a straightforward expression of the
   goals shared by the regime participants. This leads to a perception of
   states as hypocritical and to unrealistic criteria by which to assess
   institutional effectiveness. This paper draws on a neutral theory of
   ideology to inform our understanding of the relationship between treaty
   language and political reality and so to enhance our analysis of regime
   effectiveness.},
