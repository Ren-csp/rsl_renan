Note = {8th National Forum on Issues in Vocational Assessment, COLORADO SPRINGS,
   CO, MAR 13-16, 1997},
Organization = {Vocat Evaluat \& Work Adjustment Assoc},
Abstract = {The field of Vocational Evaluation has been in a state of flux for the
   past fifteen years. It appears that there is a bipolar perception of
   what really is the current state of the profession. A study was
   conducted in 1996 to determine what is currently happening (trends) and
   current practices. Results indicate a wide range of practices are being
   used and the trends indicate a continued need for vocational evaluation
   in the field. The results also indicate a need for National VEWAA to
   commence a national study which would address the issue of levels of
   evaluation and what levels are recommended for specific disability
   groups.},
