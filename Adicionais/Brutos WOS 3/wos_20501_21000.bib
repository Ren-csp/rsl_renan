Title = {From universal to local: Challenges of safeguarding the vernacular
   architecture in Turkey},
Booktitle = {VERNACULAR HERITAGE AND EARTHEN ARCHITECTURE: CONTRIBUTIONS FOR
   SUSTAINABLE DEVELOPMENT},
Year = {2014},
