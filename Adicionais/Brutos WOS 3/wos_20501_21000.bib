   Jaafar, Samsuddin and Ibrahim, Mansor and Mohamed, Mohd Zin},
Editor = {Trihartono, A and Mclellan, B},
Title = {A preliminary study of sustainable transport indicators in Malaysia: the
   case study of Klang valley public transportation},
