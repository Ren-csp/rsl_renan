@article{ WOS:A1992LA67300155,
Author = {URBAN, M and SCHMITZ, J and KIEFER, H},
Title = {THE EVALUATION OF LONG-TERM RADON EXPANSION FROM LARGE SOURCES USING
   PASSIVE INTEGRATING RADON MONITORS},
Journal = {RADIATION PROTECTION DOSIMETRY},
Year = {1992},
Volume = {45},
Number = {1-4, S},
Pages = {729-732},
Note = {5TH INTERNATIONAL SYMP ON THE NATURAL RADIATION ENVIRONMENT ( NRE 5 ),
   SALZBURG, AUSTRIA, SEP 22-28, 1991},
Abstract = {The determination of the long-term dispersion of radon from large area
   sources is quite simple if a great number of passive radon dosemeters is
   used for the measurement integrating over rather long periods.
   Development work on, and testing of, small dosemeters for individual
   dosimetry and outdoor measurements which started about 10 years ago have
   led to a reliable measuring device, which can be applied also under
   extreme environmental conditions. The plotting of the concentrations
   distribution which is necessary to calculate the radiation exposure
   caused by radon in the vicinity of large sources has been demonstrated
   among others for the uranium mines at Menzenschwand and the milling
   facility at Ellweiler. The methodology and the most important parameters
   influencing the distribution of radon are discussed.},
