Number = {7},
Pages = {881-901},
Month = {MAR},
Note = {Conference of the
   Popular-Culture-Association/American-Culture-Association, NEW ORLEANS,
   LA, APR 16-19, 2003},
Organization = {Popular Culture Assoc; Amer Culture Assoc},
Abstract = {This case study explores soap opera fan activism in regard to the
   decade-long grassroots effort to keep the daytime drama Another World on
   the air. Using the author's experience with the campaign and a snowball
   sample, key participants were interviewed about their involvement.
   Results show that the majority of respondents were not activists prior
   to or after their campaign membership and that their perceptions of
   success were closely correlated to how connected they became to the soap
   community. Recommendations for future research include examining pending
   soap cancellations and the link between programming creation and fan
   feedback management.},
