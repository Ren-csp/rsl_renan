@article{ WOS:000168435700015,
Author = {Doidge, N},
Title = {Diagnosing The English Patient:: Schizoid fantasies of being
   skinless and of being buried alive},
Journal = {JOURNAL OF THE AMERICAN PSYCHOANALYTIC ASSOCIATION},
Year = {2001},
Volume = {49},
Number = {1},
Pages = {279-309},
Month = {WIN},
