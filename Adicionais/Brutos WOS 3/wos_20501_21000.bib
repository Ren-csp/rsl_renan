@inproceedings{ WOS:000446248300113,
Author = {Siwi, W. P. and Rinanti, A. and Silalahi, M. D. S. and Hadisoebroto, R.
   and Fachrul, M. F.},
Editor = {Rinanti, A and Hadisoebroto, R and Abdullah, AG and Nandiyanto, ABD},
Title = {Effect of immobilized biosorbents on the heavy metals (Cu2+)
   biosorption with variations of temperature and initial concentration of
   waste},
Booktitle = {4TH INTERNATIONAL SEMINAR ON SUSTAINABLE URBAN DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {106},
Note = {4th International Seminar on Sustainable Urban Development (ISoSUD),
   Univ Trisakti, Fac Landscape Architecture \& Environm Technol, Jakarta,
   INDONESIA, AUG 09-10, 2017},
Abstract = {The aims of research is to studying the efficiency of copper removal by
   combining immobilized microalgae with optimizations of temperature and
   initial Copper concentration. The research was conducted in batch
   culture with temperature variations of 25 degrees C, 30 degrees C, and
   35 degrees C, as well as initial Cu2+ concentrations (mg/l) of 3, 5, 10,
   15 and 20 using monoculture of S. cerevisiae, Chlorella sp., and mixed
   culture of them both as immobilized biosorbents. The optimum adsorption
   of 83.4\% obtained in temperature of 30 degrees C with an initial waste
   concentration of 17.62 mg/l, initial biomass concentration of 200 mg, pH
   of 4, and 120 minutes detention time by the immobilized mixed culture
   biosorbent. The cell morphology examined using Scanning Electron
   Microscope (SEM) has proved that the biosorbent surface was damaged
   after being in contact with copper (waste), implying that heavy metals
   (molecules) attach to different functional cell surfaces and change the
   biosorbent surface. The adsorption process of this research follows
   Langmuir Isotherm with the R-2 value close to 1. The immobilized mixed
   culture biosorbent is capable of optimally removing copper at
   temperature of 30 degrees C and initial Cu2+ concentration of 17.62
   mg/l.},
