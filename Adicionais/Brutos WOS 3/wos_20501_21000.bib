@article{ WOS:000188258300016,
Author = {Demaree, HA and Everhart, DE},
Title = {Healthy high-hostiles: reduced parasympathetic activity and decreased
   sympathovagal flexibility during negative emotional processing},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
Year = {2004},
Volume = {36},
Number = {2},
Pages = {457-469},
Month = {JAN},
Note = {42nd Annual Meeting of the Society-for-Psychophysiological-Research,
   WASHINGTON, DC, OCT 02-06, 2002},
Organization = {Soc Psychophysiol Res},
Abstract = {This study was designed to assess the physiological impact of processing
   neutral, positive, and negative emotional stimuli among a group of low-
   and high-hostile individuals. Advances were made by (1) measuring both
   reactivity and recovery to mood induction and (2) using Heart Rate
   Variability (HRV) to more specifically quantify sympathovagal (Low
   Frequency divided by High Frequency power, or LF/HF, within the HRV
   power spectrum) and parasympathetic arousal (Respiratory Sinus
   Arrhythmia; RSA) at the myocardium. In the present study, men and women
   were equally divided into low- (N = 30) and high-hostile (N = 30) groups
   based on their scores on the Cook-Medley Hostility Scale.
   Electrocardiogram data were collected before, during, and after being
   given the negative, positive, or neutral version of the Affective
   Auditory Verbal Learning Test (AAVL). Results indicate that
   high-hostiles had reduced parasympathetic activity relative to
   low-hostiles, as measured by RSA. Moreover, relative to low-hostiles,
   high-hostile participants evidenced reduced sympathovagal reactivity and
   recovery to the negative AAVL. Results are discussed in terms of their
   potential value in understanding risk factors for coronary heart
   disease. (C) 2003 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
