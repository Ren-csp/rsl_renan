Year = {2002},
Volume = {231},
Pages = {84-92},
Note = {9th International Symposium on Society and Resource Management, INDIANA
   UNIV, BLOOMINGTON, IN, JUN 02-05, 2002},
Abstract = {To assess public attitudes and values regarding fires and fire
   management, a telephone survey was conducted of California residents.
   Most respondents were concerned about wildland and wilderness fires. The
   greatest percentage agreed that ``we probably have to let some fires
   burn, but must protect residences.{''} Fire management techniques were
   rated for expected effectiveness and approval. The trust measure, based
   on the shared values similarity model, was the most significant
   predictor in these ratings. Knowledge about fires, concern, and gender
   were also helpful predictors. The results are useful in understanding
   public perceptions of and reactions to fire management.},
