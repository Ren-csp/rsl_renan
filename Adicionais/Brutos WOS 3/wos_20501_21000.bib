@inproceedings{ WOS:000343669700036,
Author = {Koukkou, M.},
Editor = {Soldatos, C and Ruiz, P and Dikeos, D and Riba, M},
Title = {Psychosocial Development And Personal Meaning-Extracting Cortical
   Plasticity},
Booktitle = {PLURALISM IN PSYCHIATRY: I. DIVERSE APPROACHES AND CONVERGING GOALS},
Year = {2014},
Pages = {187-192},
Note = {World-Psychiatric-Association Thematic Conference on Intersectional
   Collaboration - The Multidisciplinary Facets of Psychiatry, Hellen Soc
   Advancement Psychiat \& Related Sci, Athens, GREECE, NOV 29-DEC 02, 2012},
Organization = {World Psychiat Assoc},
Abstract = {This chapter of mine serves two aims: Firstly, to review proposals of an
   integrative living systems theory-oriented model of the brain functions
   that ensure the development of psycho-biosocial healthy development of a
   healthy-born child in a suitable environment, and secondly, to use the
   proposals of this model in order to discuss how and why the same brain
   functions may lead to the development of the psycho-social problems that
   are treated by psychiatrists and psychologists. I will show empirical
   evidence that supports the following theses: (a) Human development is a
   multifactorially determined process that can be studied at all levels of
   its complexity (from genes to the social reality with which the
   individual has to deal); (b) There is a close association between
   quality of bio-psychosocial development and quality of social
   relationships; specifically a given degree of cooperative interactions
