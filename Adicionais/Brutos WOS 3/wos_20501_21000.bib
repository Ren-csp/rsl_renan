@article{ WOS:A1997WE89000001,
Author = {Allen, TD and Poteet, ML and Russell, JEA and Dobbins, GH},
Title = {A field study of factors related to supervisors' willingness to mentor
   others},
Journal = {JOURNAL OF VOCATIONAL BEHAVIOR},
Year = {1997},
Volume = {50},
Number = {1},
Pages = {1-22},
Month = {FEB},
Note = {10th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, ORLANDO, FL, MAY,
   1995},
Organization = {Soc Ind \& Org Psychol},
Abstract = {Factors thought to be related to intention to mentor and perceived
   barriers to mentoring (i.e., willingness to mentor) were examined among
   607 state government supervisors. Previous experience as a mentor,
   previous experience as a protege, education level, and quality of
   relationship with supervisor were related to willingness to mentor
   others. Additionally, age, locus of control, and upward striving were
   related to supervisors' intention to mentor others, but not to their
   perceptions of barriers to mentoring others. Job-induced tension was
   related to perceived barriers to mentoring, but not to intention to
   mentor others. Implications of the findings and suggestions for future
   research are presented. (C) 1997 Academic Press.},
