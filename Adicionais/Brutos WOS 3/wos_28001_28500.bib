@article{ WOS:000232837100032,
Author = {Sklenicka, P and Pixová, K},
Title = {Importance of spatial heterogeneity to landscape planning and management},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2004},
Volume = {23},
Number = {1},
Pages = {310-319},
Note = {13th International Symposium on Problems of Landscape Ecological
   Research, Mojmirovce, SLOVAKIA, SEP 30-OCT 03, 2003},
Organization = {Slovak Acad Sci, Inst Landscape Ecol; Austrian Inst E \& SE European
   Studies Vienna, Branch Off Bratislava},
Abstract = {Land-use changes and attributes of landscape heterogeneity have been
   monitored in four study areas, representing different landscape types,
   between 1845 and 2000. The results show various rates of simplification
   of land-use patterns in all study areas, taking into consideration
   natural conditions and human activities. The main objectives of this
   paper are to present a set of attributes (index of landscape
   heterogeneity, edge density etc.), and to define principles for
   implementing them in landscape planning and management. The basic forms
   of landscape planning in the Czech Republic are presented (e.g.
   territorial planning, the land consolidation program, recultivation),
   and their potential to reflect spatial heterogeneity changes are
   discussed. It is concluded that spatial heterogeneity is a relevant
   criterion for landscape planning, design and conservation, and for
   defining management principles in order to maintain the biodiversity and
   aesthetic values of the landscapes.},
