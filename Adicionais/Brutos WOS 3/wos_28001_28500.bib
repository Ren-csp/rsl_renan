@article{ WOS:000220874400002,
Author = {Vidic, JM and Haaf, RA},
Title = {Four-month-old infants' categorization of animals: Does any body part
   hold privileged status?},
Journal = {PSYCHOLOGICAL RECORD},
Year = {2004},
Volume = {54},
Number = {2},
Pages = {187-197},
Month = {SPR},
Note = {International Conference on Infant Studies, Providence, RI, APR, 1996},
Abstract = {The influence of body parts on 4-month-olds' categorization of cats and
   dogs was examined using a visual preference procedure. Infants were
   familiarized with pictures of exemplars from one of two categories, cat
   or dog. In test, looking time to an out-of-category exemplar was
   compared to looking time to a novel within-category exemplar with one
   changed body region (face, head, torso). Results demonstrate the
   importance of the torso region in infants' categorization. Findings are
   discussed in terms of the relative influence of various body regions,
   depending on the conditions under which categorization occurs.},
Publisher = {PSYCHOLOGICAL RECORD},
