@article{ WOS:A1997WX55200007,
Author = {Greenberg, JS and Kim, HW and Greenley, JR},
Title = {Factors associated with subjective burden in siblings of adults with
   severe mental illness},
Journal = {AMERICAN JOURNAL OF ORTHOPSYCHIATRY},
Year = {1997},
Volume = {67},
Number = {2},
Pages = {231-241},
Month = {APR},
Note = {72nd Annual Meeting of the American-Orthopsychiatric-Association,
   CHICAGO, IL, APR, 1995},
Organization = {Amer Orthopsychiat Assoc},
Abstract = {Experiences of subjective burden were analyzed in a sample of 164
   siblings of persons with serious mental illness. Findings indicated that
   the well sibling's experience of burden was consistently related to the
   symptomatology of the ill sibling. In addition, those who viewed the ill
   sibling's behavior as outside his or control exhibited lower levels of
   subjective burden than did those who viewed the behavior as within the
   sibling's control. Implications for research and clinical intervention
   are discussed.},
