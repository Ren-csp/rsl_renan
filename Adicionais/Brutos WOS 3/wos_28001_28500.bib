@inproceedings{ WOS:000503475800021,
Author = {Sanchez-Reolid, Roberto and Martinez-Rodrigo, Arturo and
   Fernandez-Caballero, Antonio},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Stress Identification from Electrodermal Activity by Support Vector
   Machines},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11486},
Pages = {202-211},
Note = {8th International Work-Conference on the Interplay Between Natural and
   Artificial Computation (IWINAC), Almeria, SPAIN, JUN 03-07, 2019},
Organization = {Spanish CYTED; Red Nacl Computac Nat \& Artificial, Programa Grupos
   Excelencia Fundac Seneca \& Apliquem Microones 21 s l},
Abstract = {Continuous atmosphere of competitiveness, job pressure, economic status
   and social judgment in modern societies leads many people to a frenetic
   life rhythm, thus favoring the appearance of stress. Consequently, early
   detection of calm and negative stress is useful to prevent long-term
   mental illness as depression or anxiety. This paper describes the
   acquisition of electrodermal activity (EDA) signals from a commercial
   wearable, and their storage and processing. Several time-domain,
   frequency-domain and morphological features are extracted over the skin
   conductance response component of the EDA signals. Afterwards,
   classification is undergone by using several support vector machines
   (SVMs). The International Affective Pictures System has been used to
   evoke calmness and distress to validate the classification results. The
   best results obtained during training and validation for each of the
   SVMs report around 87.7\% accuracy for Gaussian and cubic kernels.},
