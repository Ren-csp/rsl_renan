@article{ WOS:A1996UP56000036,
Author = {GrecoVigorito, C},
Title = {Categorization based on attribute versus relational similarity in 4- to
   10-month-old infants},
Journal = {PERCEPTUAL AND MOTOR SKILLS},
Year = {1996},
Volume = {82},
Number = {3, 1},
Pages = {915-927},
Month = {JUN},
Note = {6th Annual Meeting of the American-Psychological-Society, WASHINGTON,
   DC, JUL   01, 1994},
Organization = {Amer Psychol Soc},
Abstract = {4- to 10-month-old infants were tested in 2 experiments to determine
   whether they used a similar attribute or a similar relationship among
   attributes to make visual judgments of similarity and categorization. In
   Exp. 1 infants were familiarized with a single stimulus composed of
   several attributes and a prescribed relationship among the attributes,
   left wing smaller than right wing. When tested in a novelty-preference
   procedure a with novel stimuli that either preserved a single attribute
   but violated the relationship (Attribute Test Stimulus) or preserved the
   relationship with a new set of attributes (Relational Test Stimulus),
   Li-mo.-olds treated the Attribute Test Stimulus as familiar, whereas
   6-mo.-olds treated the Relational Test Stimulus as familiar. Neither 8-
   nor 10-mo.-olds showed a preference for either rest stimulus. In Exp, 2
   a category containing 3 exemplars was constructed. In each exemplar a
   single attribute, left wing, was held constant, and all 3 exemplars
   shared the same relational structure, left wing smaller than right wing,
   but the remaining attributes varied across exemplars. Four-, 6-, and
   8-mo.-olds in Exp. 2 reliably included the novel Attribute Test Stimulus
   in the category. These data suggest that, although infants under 8
   months can recognize relational information, they may not always use
   that information when making categorization judgments, particularly ii a
   single, well-defined attribute is available as the basis for
   categorization.},
