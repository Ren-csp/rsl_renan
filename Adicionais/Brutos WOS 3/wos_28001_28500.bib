@inproceedings{ WOS:000503475800001,
Author = {Gaxiola-Tirado, J. A. and Rodriguez-Ugarte, M. and Ianez, E. and Ortiz,
   M. and Gutierrez, D. and Azorin, J. M.},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {The Effect of tDCS on EEG-Based Functional Connectivity in Gait Motor
   Imagery},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
