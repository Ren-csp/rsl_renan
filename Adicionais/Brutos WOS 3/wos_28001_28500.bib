@article{ WOS:A1996UR47900004,
Author = {Mwangi, MW},
Title = {Gender roles portrayed in Kenyan television commercials},
Journal = {SEX ROLES},
Year = {1996},
Volume = {34},
Number = {3-4},
Pages = {205-214},
Month = {FEB},
Note = {1992 Department-of-Educational-Psychology National Seminar on Gender
   Issues in a Changing Society, KENYATTA UNIV, NAIROBI, KENYA, 1992},
Organization = {Kenyatta Univ, Dept Educ Psychol},
Abstract = {A content analysis of 105 television advertisements aired on Kenya's
   television networks (KBC and KTN) during an g-week period (July and
   August) was carried out. Commercial were coded according to the sex of
   the central character, spokesperson, the nature of products/services
   presented, setting and occupation of the central character. There were
   no significant differences in the proportion of women and men sewing as
   central characters in commercials. However, both men and women were
   depicted in traditional roles. Significant gender differences were
   apparent in relation to the products and services presented, preferred
   spokesperson, commercial settings, and occupational cues. Generally, the
   stereotyped nature of Kenyan commercials is consistent with findings
   obtained in developed countries. The results are discussed in relation
   to the prevailing cultural milieu.},
