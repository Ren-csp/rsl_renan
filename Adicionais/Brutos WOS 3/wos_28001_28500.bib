Title = {THE CLINICAL LEARNING ENVIRONMENT: THE ATTITUDE OF UNDERGRADUATE STUDENT
   NURSES TOWARDS MENTORSHIP AT HOSPITALS IN LITHUANIA},
Booktitle = {CBU INTERNATIONAL CONFERENCE PROCEEDINGS 2018: INNOVATIONS IN SCIENCE
   AND EDUCATION},
