Booktitle = {CONSENSUS IN CHILD NEUROLOGY},
Year = {2003},
Pages = {62-64},
Note = {5th Consensus Conference on Biological Bases and Clinical Perspectives
   in Autism, TROINA, ITALY, JUN 29-JUL 01, 2001},
Abstract = {According to careful clinical description of the early signs of autism,
   it can be hypothesized that the interactional and communication
   disorders in this syndrome are the expression of underlying basic
   neurophysiologic developmental disturbances. Disordered reactions to
   sensory input constitute a striking aspect of autistic behavior.
   Electrophysiologic investigations were performed using auditory evoked
   potentials and electroencephalographic cartography. The results showing
   abnormal auditory and visual processing at the cerebral level in
   children with autism support the hypothesis that their major behavioral
   and relational impairment could result from a ``cerebral modulation
   insufficiency.{''} These data lead us to underline the interest of early
   rehabilitation of deficient psychophysiologic functions to promote the
   communication of autistic individuals with others and to facilitate
   their cognitive, emotional, and social development.},
