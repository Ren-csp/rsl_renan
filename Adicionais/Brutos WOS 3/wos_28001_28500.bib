Title = {An Empirical Analysis of Business Moral Cognition in Hangzhou Economic
   Development Zone},
Booktitle = {PROCEEDINGS OF THE SECOND INTERNATIONAL SYMPOSIUM ON PUBLIC HUMAN
   RESOURCE MANAGEMENT},
Year = {2013},
Pages = {228-233},
Note = {2nd International Symposium on Public Human Resource Management,
   Zhejiang Gongshan Univ, Sch Business Adm, Hangzhou, PEOPLES R CHINA, OCT
   26-28, 2012},
Organization = {Zhejiang Univ, Psychol \& Behav Sci Dept; Zhejiang Gongshan Univ, Sch
   Business Adm; State Adm Foreign Experts Affairs China, Train Ctr; Int
   Publ Management Assoc Human Resources; Univ S Florida, Educ Coll; Amer
   Scholers Press},
Abstract = {Business ethics construction is important to develop socialist market
   economy. Improving the understanding of business moral cognition is the
   foundation for business ethics construction. In this paper, the four
   dimensions - care, efficiency, contribution and fair-are employed to
   measure business moral cognition. There were 110 business employers in
   Hangzhou Economic Development Zone who were investigated. The result
   shows that enterprise size has a positive relationship with the degree
   of business moral cognition. The business employers with higher
   education gave more care to employees. In addition, business moral
   cognition of employers is inconsistent. These aspects - care for
   employees, reducing damage to the environment, and promoting social
   development get high scores. The aspects of product innovation and
   reducing commercial bribery get low scores. Finally, we get the
   conclusion that it is urgent to strengthen the education of business
   ethics to business employers and improve their cognitive level of
   business ethics.},
