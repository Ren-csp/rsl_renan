@inproceedings{ WOS:000503475800027,
Author = {De Groot, Jelle-Jan and Barakova, Emilia and Lourens, Tino and van
   Wingerden, Evelien and Sterkenburg, Paula},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Game-Based Human-Robot Interaction Promotes Self-disclosure in People
   with Visual Impairments and Intellectual Disabilities},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
