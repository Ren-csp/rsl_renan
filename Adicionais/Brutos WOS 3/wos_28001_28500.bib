@inproceedings{ WOS:000248149200013,
Author = {Zhang, Yinlong and Khare, Adwait},
Editor = {Guo, G and Chan, AKK and Wang, HH and Qian, MH},
Title = {Determinants for consumers' evaluations of local versus global products:
   Examining the roles of identity accessibility, diagnosticity and
   self-categorizations},
Booktitle = {Marketing Research and Practice in Globalization Era},
Year = {2007},
Pages = {119-125},
Note = {MRCC 2007 International Symposium on Marketing, Hangzhou, PEOPLES R
   CHINA, JUN 16-17, 2007},
Organization = {Hong Kong Baptist Univ; Hangzhou Dianzi Univ; MRCC},
Abstract = {We investigate, the effect of a newly conceptualized local-global
   identity on consumers' evaluations of local versus global products, the
   effect's boundary conditions, and a process mechanism of the effect.
   First, we propose and test a scale for measuring the identity. Second,
   we show that when the identity is accessible, identity-consistent
   products are evaluated more favorably. Third, we show that this identity
   accessibility effect is stronger when primed and chronic identities are
   compatible versus incompatible and when the accessible identity' is more
   versus less diagnostic for product evaluations. Fourth, we show that
   identity-salient consumers' spontaneous self-categorizations mediate the
   identity accessibility effect. These results contribute to the
   social-identity literature by providing a stronger test of the
   moderating role of diagnosticity and offering evidence for, the
   previously proposed mediating role of self-categorizations. These
   results can also help to reconcile divergent findings regarding
   consumers' preference for local versus global products.},
