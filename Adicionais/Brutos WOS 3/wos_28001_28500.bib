@inproceedings{ WOS:000481933700049,
Author = {Ilovan, Oana-Ramona and Dulama, Maria Eliza and Andron, Danut and Balan,
   Petruta-Madalina and Muntean, Dan-Ovidiu and Toderas, Alina and Ciocan,
   Mihaela},
Editor = {Chis, V and Albulescu, I},
Title = {DEVELOPING STUDENTS' COMPETENCE TO ANALYSE LANDSCAPES DURING GEOGRAPHY
   UNIVERSITY STUDIES},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
