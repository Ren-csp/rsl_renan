@article{ WOS:000266204400001,
Author = {Fisher, Deborah A. and Hill, Douglas L. and Grube, Joel W. and Bersamin,
   Melina M. and Walker, Samantha and Gruber, Enid L.},
Title = {Televised Sexual Content and Parental Mediation: Influences on
   Adolescent Sexuality},
Journal = {MEDIA PSYCHOLOGY},
Year = {2009},
Volume = {12},
Number = {2},
Pages = {121-147},
Note = {113th Annual Convention of the American-Psychological-Association,
   Washington, DC, AUG 18-21, 2005},
Organization = {Amer Psychol Assoc},
Abstract = {Little research has been conducted to examine the influence of exposure
   to televised sexual content on adolescent sexuality or how parental
   intervention may reduce negative effects of viewing such content. This
   study uses self-report data from 1,012 adolescents to investigate the
   relations among exposure to sexually suggestive programming, parental
   mediation strategies, and three types of adolescent sexuality outcomes:
   participation in oral sex and sexual intercourse, future intentions to
   engage in these behaviors, and sex expectancies. As predicted, exposure
   to sexual content was associated with an increased likelihood of
   engaging in sexual behaviors, increased intentions to do so in the
   future, and more positive sex expectancies. Often, parental mediation
   strategies were a significant factor in moderating these potential media
   influences.},
