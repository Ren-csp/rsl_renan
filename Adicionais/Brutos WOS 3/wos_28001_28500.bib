@inproceedings{ WOS:000230377200038,
Author = {Chinellato, E and del Pobil, AP},
Editor = {Mira, J and Alvarez, JR},
Title = {Vision and grasping: Humans vs. robots},
Booktitle = {MECHANISMS, SYMBOLS AND MODELS UNDERLYING COGNITION, PT 1, PROCEEDINGS},
Series = {Lecture Notes in Computer Science},
Year = {2005},
Volume = {3561},
Pages = {366-375},
Note = {1st International Work-Conference on the Interplay Between Natural and
   Artificial Computation, Las Palmas, SPAIN, JUN 15-18, 2005},
Organization = {UNED; Spanish Minist Ciencia \& Tecnol},
Abstract = {Biomimetic robotics is a rapidly developing field, and the limited
   literature about biological inspiration in robot grasping at cognitive
   level suggests that the field has still much to offer.
   Neuroscience studies indicate that vision-based reaching and grasping
   are important to the extent that an entire cortical pathway is dedicated
   to these skills. Nevertheless, recent findings point out the existence
   of strict relations between action-oriented (dorsal pathway) and
   categorization-oriented (ventral pathway) vision.
   In this paper, we will compare present day research on vision-based
   robotic grasping with the above mentioned neuroscience findings. Then,
   we propose a new approach to vision for grasping in robotics, which aims
   at improving the emulation of human skills through the integration of
   the information flows proceeding from the two visual pathways.},
