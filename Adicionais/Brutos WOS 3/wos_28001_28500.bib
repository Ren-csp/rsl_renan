@article{ WOS:000432429600165,
Author = {Jumaat, Nurul Farhana and Tasir, Zaidatun and Lah, Noor Hidayah Che and
   Ashari, Zakiah Mohammad},
Title = {Students' Preferences of m-Learning Applications in Higher Education: A
   Review},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2858-2861},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Mobile learning or m-learning has become a vital educational technology
   component in higher education. This technology offers collections of
   applications called Apps. These Apps are ranging from Games, Education,
   E-book, Entertainment and Business to Lifestyle. With the aid of
   technology and the Internet, the mobile learning or m-learning apps has
   enable the students to learn, collaborate and share resources among each
   other. However, preferences on m-learning application usage by learners
   are a critical component to the employments of m-learning system in
   higher education. The successful implementation of m-learning is based
   on student's preferences of this technology. Therefore, the purpose of
   this paper is to deliver a review on the aspects of student's
   preferences on m-learning application usage especially in higher
   education institution. A review was employed to analyze the data
   collected from 11 articles. The results indicate that students preferred
   to use m-learning applications based on students' willingness to adopt
   this technology and to use it in their courses, they also believe that
   this technology will enhance their learning process by giving them
   freedom to access educational content based on their preferences and it
   is the best tool that provide an effective way of learning.},
