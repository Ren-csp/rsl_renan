@inproceedings{ WOS:000079630400221,
Author = {Pan, XC and Wang, YJ and Qi, XL},
Editor = {Usui, S and Oori, T},
Title = {The inhibition beyond the receptive field of visual cortical neuron},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {973-976},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {A network model of receptive field, consisting of neurons, interactive
   columns, was proposed to simulate the inhibition originating from the
   areas beyond the classical receptive field(CRF). In this model, the
   neuron is considered as a fundamental unit, which is constituted with a
   linear spatial filter and a nonlinear output function. A column consists
   of interactive neurons with spatially overlapped receptive fields. And
   columns are connected each other to form the neural network. The spatial
   integral curves over the length- and width-dimension, spatial frequency
   and orientation tuning curves of the areas beyond the CRF were simulated
   by this model. The simulated results are similar to those recorded from
   the neurophysiological experiments. It is suggested that these
   inhibitory interactions coming from beyond the CRF may be the neural
   mechanism of some illusory phenomena.},
