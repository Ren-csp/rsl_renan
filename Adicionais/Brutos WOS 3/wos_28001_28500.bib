@inproceedings{ WOS:000341021700067,
Author = {Klemets, Joakim and Evjemo, Tor Erik and Kristiansen, Lill},
Editor = {Lehmann, CU and Ammenwerth, E and Nohr, C},
Title = {Designing for Redundancy: Nurses Experiences with the Wireless Nurse
   Call System},
Booktitle = {MEDINFO 2013: PROCEEDINGS OF THE 14TH WORLD CONGRESS ON MEDICAL AND
   HEALTH INFORMATICS, PTS 1 AND 2},
Series = {Studies in Health Technology and Informatics},
Year = {2013},
Volume = {192},
Pages = {328-332},
Note = {14th World Congress on Medical and Health Informatics (MEDINFO),
   Copenhagen, DENMARK, AUG 20-23, 2013},
Abstract = {Patients rely on the nurse call system when in need of nurses'
   assistance, while nurses rely on the nurse call system to coordinate
   work. In order to handle the highly mobile nature of nurses' work, a
   wireless nurse call system has been introduced at a Norwegian hospital.
   In light of findings from previous research that identify challenges
   associated with wireless nurse call systems, we have conducted
   qualitative and ethnographically inspired fieldwork, i.e. workshops
   including both ordinary and student nurses to describe nurses' present
   system use. We further identify challenges related to wireless nurse
   call system usage, in particular how nurses manage the interruptive
   nature of wireless nurse calls so as to ensure continuous patient
   support. Our analysis acknowledges that High Reliability Organization
   (HRO) principles are transferable to a hospital organization. Based on
   our data, we propose improvements for design that hopefully can help
   reduce disruptive interruptions, ensure quick responses to patients, and
   further improve quality of care and patient safety. Further, we suggest
   that technology should facilitate and strengthen the redundancy of
