@article{ WOS:000444975300093,
Author = {Ahmad, Mohd Hafis and Ismail, Syuhaida},
Title = {Change Management Readiness in the Malaysian Public Organisation},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3450-3455},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {Organisational change occurs when an organisation makes a transition
   from its current state to some desired future state in minimizing
   employee resistance and cost to the organisation while simultaneously
   maximizing the effectiveness of the change effort. Public organisation
   is no exception in this change management process due to its complex
   external and internal environment; vital assumptions tend to change due
   to dynamic developments in society; not valuated on the basis of its
   profit making ability but by its capacity to create sociality for its
   citizens; and rich in people diversity, structure, activities, processes
   and culture. This study therefore aims at appraising the change
   management of Malaysian public organisation since limited research has
   been done to examine readiness for change in public sector compared to
   private sector. This study is materialising its objectives of (1)
   identifying the attributes of change management in the Malaysian public
   organisation; (2) investigating the current practice of organisation and
   employees in the Malaysian public organisation towards change management
   and (3) assessing the factors influencing readiness of organisation and
   employees in the Malaysian public organisation towards change
   management. It is found that change management is a structured approach
   for ensuring that changes are thoroughly and smoothly implemented to
   transitioning individuals, teams, and organisations to a desired future
   state by focusing on the wider impacts of change, particularly on
   people, where change does not happen in isolation and it impacts the
   whole organisation. Furthermore, it is found that current practice of
   organisation and employees in the Malaysian public organisation towards
   change management involved in two main factor namely trust in management
   and communication, with the factor for trust in management are the
   positive vision for the future by management team, meanwhile for
   communication, it is found that there is good communication between
   supervisors and employees about the organisation's policy toward the
   changes. It is also found that amongst the factors influencing readiness
   of organisation and employees towards change management are
   organisational commitment and readiness for change. The factor found in
   organisational commitment are employees enjoying discussing about their
   organisation with outsiders. While factor for readiness of change are
   employees willing to support change. The findings of this study provide
   a positive impact on change management planning, which ultimately helps
   in ensuring more effective change programme implementation in the public
   organisation in Malaysia.},
