@inproceedings{ WOS:000392678700038,
Author = {Kottova, P.},
Editor = {Bejcek, V and Fernandez, E and Jilek, F and Libra, M and Marusak, R and Sedmikova, M and Zagata, L},
Title = {EVALUATION OF THE VISUAL QUALITIES OF LANDSCAPES AROUND THE CITY MOST},
Booktitle = {UCLIO 2010: UNIVERSITY CONFERENCE IN LIFE SCIENCES - PROCEEDINGS},
Year = {2010},
Pages = {272-277},
Note = {University Conference in Life Sciences (UCOLIS 2010), Prague, CZECH
   REPUBLIC, NOV 25, 2010},
Organization = {Czech Univ Life Sciences Prague},
Abstract = {The goal of this project is to evaluate the content and configuration of
   landscapes in the nortwest Bohemia. While targeted on visual and verbal
   preferences of different groups in human population (residents, non
   residents, public administration workers) based on question form survey,
   the respondents are going to evaluate scenic beauty and recreational
   value of few randomly selected photographs. In my work, preferences of
   selected human groups (residents, non residents, public administration
   workers) are investigated by means of two different methods. The visual
   and verbal preference of the landscape allow for two different
   management practices controlled reclamation and natural succession in
   the areas afflicted with opencast brown coal mining. Two diverse ways of
   the development around the city Most are being compared with three age
   types. The presence of water bodies in inspected areas are used as a
   complementary element in the visual quality evaluation process.
   Hypotheses:
   1) Visitors prefer reclamated locations compared to succession surfaces.
   2) The preference of recultivations against successions changes with age
   of the locality.
   3) Respondents rate areas with water as more valuable.
   4) The visual and verbal preferential methods do not bring the same
   results. These hypothesis could not be confirm because research data is
   still processing yet.},
