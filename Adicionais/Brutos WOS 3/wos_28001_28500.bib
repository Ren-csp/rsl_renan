@inproceedings{ WOS:000503475800036,
Author = {Martinez-Murcia, F. J. and Ortiz, A. and Morales-Ortega, R. and Lopez,
   P. J. and Luque, J. L. and Castillo-Barnes, D. and Segovia, F. and
   Illan, I. A. and Ortega, J. and Ramirez, J. and Gorriz, J. M.},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Periodogram Connectivity of EEG Signals for the Detection of Dyslexia},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
