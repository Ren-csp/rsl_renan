@article{ WOS:000073857700014,
Author = {Harada, M and Nakanishi, J and Konuma, S and Ohno, K and Kimura, T and
   Yamaguchi, H and Tsuruta, K and Kizaki, T and Ookawara, T and Ohno, H},
Title = {The present mercury contents of scalp hair and clinical symptoms in
   inhabitants of the Minamata area},
Journal = {ENVIRONMENTAL RESEARCH},
