@article{ WOS:000431750800098,
Author = {Yunus, Noor Azlina Mohamed and Zamzuri, Norol Hamiza and Rashid, Wan
   Edura Wan and Ahmad, Nor Lela and Salleh, Sazimah Mohamed},
Title = {The Relationship Between Event Attendees' Behavior and Intentions to
   Attend Sustainable Events},
