@article{ WOS:000169101000006,
Author = {Robertson, RJ},
Title = {Exercise testing and prescription using RPE as a criterion variable},
Journal = {INTERNATIONAL JOURNAL OF SPORT PSYCHOLOGY},
Year = {2001},
