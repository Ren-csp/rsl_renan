@inproceedings{ WOS:000231350200018,
Author = {Yamasaki, T and Goto, Y and Tobimatsu, S},
Editor = {Tsuji, S and Tobimatsu, S and Kakigi, R and Uozumi, T and Akamatsu, N},
Title = {Can we estimate the activating effects of visual channels in primary
   visual cortex by flicker VEPs?},
Booktitle = {UNVEILING THE MYSTERY OF THE BRAIN: NEUROPHYSIOLOGICAL INVESTIGATION OF
   THE BRAIN FUNCTION},
