@inproceedings{ WOS:000503475800022,
Author = {Belmonte, Lidia M. and Morales, Rafael and Garcia, Arturo S. and Segura,
   Eva and Novais, Paulo and Fernandez-Caballero, Antonio},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Trajectory Planning of a Quadrotor to Monitor Dependent People},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11486},
