@inproceedings{ WOS:000181626900042,
Author = {Fagerstone, KA},
Editor = {Timm, TM and Schmidt, RH},
Title = {Professional use of pesticides in wildlife management - An overview of
   professional wildlife damage management},
Booktitle = {TWENTIETH VERTEBRATE PEST CONFERENCE, PROCEEDINGS},
