@inproceedings{ WOS:000180515900039,
Author = {Kim, HM},
Editor = {Broniarczyk, SM and Nakamoto, K},
Title = {Small print versus large print: Consumer evaluations of different rebate
   ad formats},
Booktitle = {ADVANCES IN CONSUMER RESEARCH, VOLUME XXIX},
Series = {Advances in Consumer Research},
Year = {2002},
Volume = {29},
Pages = {149-154},
Note = {32nd Annual Conference of the Association-for-Consumer-Research (ACR),
   AUSTIN, TX, OCT 11-14, 2001},
Organization = {Assoc Consumer Res},
Abstract = {Despite the popularity of rebates among manufacturers and consumers, no
   research has investigated whether or not the presentation format can
   affect consumer evaluations of the product featured in a rebate ad.
   Retailers use two different rebate ad formats. One format is to provide
   price information about rebates by showing both before- and after-rebate
   prices in large print, and the other is to show only after-rebate price
   in large print. Two experimental studies were conducted to determine
   which format was more effective. Consistent with mental accounting
   principles, the results showed that emphasizing only after-rebate prices
   was less effective.},
