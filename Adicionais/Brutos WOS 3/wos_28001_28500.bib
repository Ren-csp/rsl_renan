@article{ WOS:000444975300090,
Author = {Azman, Siti Sarah and Musa, Nadia Nisha and Mydin, Marlina Mohd},
Title = {Role-Play Analogy as an Approach to Learn Human Muscle Contraction},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3436-3440},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {Animal physiology is a branch in Biology which studies the anatomy and
   systematic processes that occur in an animal. The subject has been in
   the curriculum since foundation level up to tertiary; with increasing
   depth and more detailed explanations on structures and processes that
   occur in animals' Respiratory System, Circulatory System and Skeletal,
   as well as the Muscular systems. Knowledge about the anatomy and the
   processes are useful foundations for careers in medicine, veterinary,
   zoology, and other health sciences fields; making it imperative for
   students to establish an understanding of the course. Regardless of the
   rich content, a more interactive approach is crucial for the students'
   learning. Role-play is a method which incorporates active learning in
   its execution; effectively enhancing students' learning experience. This
   study aims to evaluate role-play as an approach to assess students'
   performance, while also exploring the relationship between student
   engagement and their performance. This study was performed on 54
   undergraduate students, with 27 students selected to participate in the
   role-play analogy class, and another 27 taught using traditional lecture
   method. A questionnaire and a test on the selected topic revolving
   around Human's Skeletal and Muscular System were given to gauge their
   understanding. The results indicate that students who learn the topic
   through role-play performed better than students who were only given
   lessons through lectures. Students' engagement in the role-play activity
   also boosted their test performance. Findings from the study further
   emphasised the effects of active learning in enhancing students'
   understanding of the topic of animal physiology.},
