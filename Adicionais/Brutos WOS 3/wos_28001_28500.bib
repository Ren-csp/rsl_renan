Title = {RECALL OF AGGRESSIVE AND WITHDRAWN STATEMENTS AMONG YOUNG-CHILDREN -
   SOCIAL SCHEMA OR MEANINGFULNESS},
Journal = {CURRENT PSYCHOLOGY},
Year = {1995},
Volume = {14},
Number = {2},
Pages = {152-158},
Month = {SUM},
Note = {1991 Annual Meeting of the American-Psychological-Society, WASHINGTON,
   D.C., JUN 14, 1991},
Organization = {Amer Psychol Soc},
Abstract = {Two studies assessed the effects of type of sentence (aggressive vs.
   withdrawn) and meaningfulness level on the sentence recall of young
   children. In Study 1, normative data showed that the meaningfulness
   value of aggressive sentences was greater than that of withdrawn
   sentences and that meaningfulness and recall were positively related. In
   Study 2, subjects were tested for sentence recall in a 2 (aggressive vs.
   withdrawn sentences) x 2 (high vs. low meaningfulness) within subjects
   design. The sole significant effect was meaningfulness, with the
   superior recall of high relative to low meaningful sentences. Results
   are interpreted through a knowledge base model.},
