Year = {1997},
Volume = {26},
Number = {3},
Pages = {363-375},
Month = {MAY},
Note = {9th Annual CUNY Conference on Human Sentence Processing, NEW YORK, NY,
   MAR 21-23, 1996},
Organization = {CUNY},
Abstract = {Much effort has gone into constructing models of how children segment
   speech and thereby discover the words of their language. Much effort has
   also gone into constructing models of how adults access their mental
   lexicons and thereby segment speech into words. In this paper, I explore
   the possibility of a model that could account for both word discovery by
   children and on-line segmentation by adults. In particular I discuss
   extensions to the distributional regularity (DR) model of Brent and
   Cartwright (1996) that could yield an account of on-line segmentation as
   well as word discovery.},
