@inproceedings{ WOS:000503475800042,
Author = {Illan, I. A. and Gorriz, J. M. and Ramirez, J. and Martinez-Murcia, F.
   J. and Castillo-Barnes, D. and Segovia, F. and Salas-Gonzalez, D.},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Support Vector Machine Failure in Imbalanced Datasets},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11486},
Pages = {412-419},
