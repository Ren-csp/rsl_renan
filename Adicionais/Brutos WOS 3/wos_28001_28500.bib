@inproceedings{ WOS:000390667900014,
Author = {Karo, Roland},
Editor = {Evers, D and Fuller, M and Runehov, A and Saether, KW},
Title = {A Look at Reason Through Love's Eyes: The Sense of Meaningfulness Within
   a Bodily Context},
Booktitle = {ISSUES IN SCIENCE AND THEOLOGY: DO EMOTIONS SHAPE THE WORLD?},
Series = {Issues in Science and Religion},
Year = {2016},
Pages = {189-200},
Note = {15th European Conference on Science and Theology (ECST XV), Assisi,
   ITALY, APR 30-MAY 04, 2014},
Abstract = {The paper explores the issue of ego deflation. I will look at the
   concept of ego death recurrent in mystical literature, asking why it is
   described by the mystics as a positive, euphoric and ecstatic rather
   than negative and disintegrating experience. The analysis relies on St.
   John of the Cross' mystical poem Llama de amor viva. Using the insights
   provided by the poem I will try to look at reason through the eyes of
   love and see how the notion of meaningfulness fits in with those of ego
   death and love. In line with Antonio Damasio's ideas, I will argue that
   the core of the ego death experience is hugely underdetermined by its
   cognitive content. Using the notions of Apollonian vs. Dionysian
   aesthetics I will conclude that the experience depends on relational
   rather than cognitive qualities.},
Publisher = {SPRINGER},
Address = {PO BOX 17, 3300 AA DORDRECHT, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Karo, R (Corresponding Author), Univ Tartu, Systemat Theol, Tartu, Estonia.
   Karo, Roland, Univ Tartu, Systemat Theol, Tartu, Estonia.},
DOI = {10.1007/978-3-319-26769-2\_14},
ISSN = {2364-5717},
ISBN = {978-3-319-26769-2; 978-3-319-26767-8},
Keywords = {Bonding; Depression; Descartes' error; Dopamine; Ego defl ation;
   Embodiment; Gestalt; Love; Oxytocin; Sex hormones; Somatic markers},
Keywords-Plus = {MYSTICAL STATES; ROMANTIC LOVE; AWARENESS},
Research-Areas = {Psychology; Religion},
Web-of-Science-Categories  = {Psychology, Multidisciplinary; Religion},
Author-Email = {roland.karo@ut.ee},
Affiliations = {University of Tartu},
Cited-References = {Andresen Jensine., 2002, COGNITIVE MODELS SPI, P17.
   Austin JamesH., 2006, ZEN BRAIN REFLECTION.
