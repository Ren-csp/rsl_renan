@article{ WOS:000230499500004,
Author = {Livingston, KR and Andrews, JK},
Title = {Evidence for an age-independent process in category learning},
Journal = {DEVELOPMENTAL SCIENCE},
Year = {2005},
Volume = {8},
Number = {4},
