Pages = {304-311},
Note = {International Conference on Brain Informatics and Health (BIH), Omaha,
   NE, OCT 13-16, 2016},
Organization = {Univ Nebraska, Coll Informat Sci \& Technol; Web Intelligence
   Consortium; IEEE Computat Intelligence Soc Task Force Brain Informat},
Abstract = {Mild depression disorder affects a large number of people, and if not
   correctly treated, it could evolve into major depression disorder. So
   far, lots of studies have suggested that several abnormal brain regions
   are linked to major depression disorder, including prefrontal cortex
   (PFC), anterior cingulate cortex (ACC) etc. However mild depression
   disorder gained less attention. This study therefore examined whether
   mild depression exists dsyregulation in these brain regions. 20 subjects
   participated in our experiment, and affective facial expressions
   pictures were used as stimuli when recording EEG signals. Brain activity
   of theta and alpha bands were examined using EEG topography and
   standardized low-resolution electromagnetic tomography (sLORETA).
   Results suggested that mild depressed subjects exhibited higher activity
   in motor cortex (Brodmann area: 4, 6) and lower activity in visual
   cortex (Brodmann area: 18, 19) and prefrontal cortex (Brodmann area: 11,
   47) compared to normal controls. These finding indicated that mild
   depressed subjects paid much more attention to negative facial
   expressions. Future studies should be focused on the role of brain
   regions played in mild depression in more detail.},
