@article{ WOS:A1996VM66100002,
Author = {Stricker, G and Hillman, JL},
Title = {Attitudes toward older adults: The perceived value of grandparent as a
   social role},
Journal = {JOURNAL OF ADULT DEVELOPMENT},
Year = {1996},
Volume = {3},
Number = {2},
