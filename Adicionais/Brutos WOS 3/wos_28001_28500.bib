Note = {Conference of the International-Sociological-Association on the
   Environmental State Under Pressure, CHICAGO, IL, AUG 06-07, 1999},
Organization = {Int Sociol Assoc},
Abstract = {The widespread concern about the declining state of our physical
   environment is often accompanied by frustration about what to do to
   prevent or even reverse such deterioration. In the past, policy makers,
   legislators, and the general public have usually turned to scientists
   and scientific knowledge for answers. But recently, theorists and others
   have reemphasized the importance of culture in understanding the
   environment. In this article, this culturalist critique of scientific
   knowledge is discussed and is then related to the decision by Ontario
   Hydro to lay up seven of its nuclear reactors. This situation is used to
   illustrate the continuing relevance of scientific knowledge for
   addressing environmental concerns.},
