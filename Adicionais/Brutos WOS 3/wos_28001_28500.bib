Title = {Toward a Model of Comparison-Induced Density Effects},
Booktitle = {PROCEEDINGS OF THE TWENTY-SIXTH ANNUAL CONFERENCE OF THE COGNITIVE
   SCIENCE SOCIETY},
Year = {2004},
Pages = {221-226},
Note = {26th Annual Conference of the Cognitive-Science-Society, Chicago, IL,
   AUG 04-07, 2004},
Organization = {Cognit Sci Soc},
Abstract = {A model of the effects of distribution density on evaluations of
   attribute values is proposed in which biases created by
   language-expressible magnitude comparisons (e. g., ``I waited longer for
   the bus today than I did yesterday{''}) serve as the mediating
   mechanism. The biases created by comparisons as well as the mechanisms
   by which comparison-induced biases could produce density effects are
   described. Simulation data demonstrate signature characteristics of
   comparison-induced density effects. An experiment found preliminary
   evidence in support of the view that some density effects might be
   comparison-induced.},
