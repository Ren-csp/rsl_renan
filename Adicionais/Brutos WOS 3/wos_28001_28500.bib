@inproceedings{ WOS:000084731400036,
Author = {Fukusima, SS and da Silva, JA},
Editor = {Killeen, PR and Uttal, WR},
Title = {Familiar size as a cue to size and distance estimates},
Booktitle = {FECHNER DAY 99: THE END OF 20TH CENTURY PSYCHOPHYSICS, PROCEEDINGS},
Year = {1999},
Pages = {198-203},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {Size and distance estimates of blank and playing cards under
   reduced-visual-cue condition were collected under objective and apparent
   instructions. Distance estimates of blank cards varied around 1 to 3 m
   away independently of the physical distances of stimuli and their size
   estimates varied as a function of the size of the visual angle. Distance
   estimates of playing cards varied with the expected distances subtended
   by the visual angle of the normal size of a playing card. Their size
   estimates trended to vary with the size of the visual angle under
   apparent instruction, and to be invariant and close to the size of a
   normal playing card under objective instruction. As a blank card was
   assumed to be the same size of a playing card, distance estimates was
   close to the expected distance for a normal playing card with that
   especific visual angle, and their size estimates trended to be almost
   invariant. Size estimates under apparent instruction were smaller than
   those ones under objective instructions. Results indicated that
   perceptual and cognitive process rule size and distance judgments.},
