@inproceedings{ WOS:000235161800024,
Author = {Schwertner, TW and Peterson, MJ and Slivy, NJ},
Editor = {Eversole, AG},
Title = {Raccoon abundance and Rio Grande wild turkey production in central Texas},
Booktitle = {PROCEEDINGS OF THE FIFTY-EIGHTH ANNUAL CONFERENCE OF THE SOUTHEASTERN
   ASSOCIATION OF FISH AND WILDLIFE AGENCIES},
Year = {2004},
Pages = {238-247},
Note = {58th Annual Conference of the
   Southeastern-Association-of-Fish-and-Wildlife-Agencies, Hilton Head Isl,
   SC, OCT 31-NOV 03, 2004},
Organization = {SE Assoc Fish \& Wildlife Agcy},
Abstract = {An understanding of spatial and temporal dynamics of wild turkey
   (Meleagris gallopavo) populations is essential in setting management
   goals. In central Texas, raccoon (Procyon lotor) populations have
   increased in recent years, causing concern that they may be limiting Rio
   Grande wild turkey (M. g. intermedia) production. We used two long-term
   data sets in central Texas to explore the relationship between raccoon
   abundance and Rio Grande wild turkey production at the regional, county,
   and local scale. We found no evidence that natural variation in raccoon
   abundance was associated with Rio Grande wild turkey production.
   Although further research is warranted, we suggest that raccoons may
   influence broad-scale Rio Grande wild turkey production in central Texas
   less than expected.},
