@article{ WOS:000264385100017,
Author = {Gregg, Melissa K. and Samuel, Arthur G.},
Title = {The importance of semantics in auditory representations},
Journal = {ATTENTION PERCEPTION \& PSYCHOPHYSICS},
Year = {2009},
Volume = {71},
Number = {3},
Pages = {607-619},
