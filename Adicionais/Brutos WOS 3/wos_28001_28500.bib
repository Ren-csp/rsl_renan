Note = {World Symposium on Climate Change Adaptation, Manchester, ENGLAND, SEP
   02-04, 2015},
Abstract = {The author conducts in-depth interviews with individuals who describe
   themselves as having undergone a change in attitude with regards to
   climate change. Determinants of attitudinal change, and characteristics
   of the process, are identified and compared with those found in the
   literature on attitudes towards climate change. Given that changes in
   attitude are often linked with transformation in perspectives, the
   author proposes transformative learning theory as a framework with which
   to interpret and explain the experiences of the respondents.},
