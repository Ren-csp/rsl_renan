@inproceedings{ WOS:000227683000077,
Author = {Horn, DL and Davis, RAO and Pisoni, DB and Miyamoto, RT},
Editor = {Miyamoto, RT},
Title = {Visual attention, behavioral inhibition and speech/language outcomes in
   deaf children with cochlear implants},
Booktitle = {COCHLEAR IMPLANTS},
