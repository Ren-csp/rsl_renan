@article{ WOS:000185628000006,
Author = {Cunningham, WA and Johnson, MK and Gatenby, JC and Gore, JC and Banaji,
   MR},
Title = {Neural components of social evaluation},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {2003},
Volume = {85},
Number = {4},
Pages = {639-649},
