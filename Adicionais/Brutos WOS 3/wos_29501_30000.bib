Title = {A METHOD FOR IMPROVING THE ACCURACY OF THE MODERATE RESOLUTION LAI
   PRODUCT BASED ON THE MIXED-PIXEL CLUMPING INDEX},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
