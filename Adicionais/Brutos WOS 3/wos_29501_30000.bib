@article{ WOS:A1996VJ24000010,
Author = {Zakay, D},
Title = {The relativity of unrealistic optimism},
Journal = {ACTA PSYCHOLOGICA},
Year = {1996},
Volume = {93},
Number = {1-3},
Pages = {121-131},
Month = {SEP},
Note = {15th Research Conference on Subjective Probability, Utility and Decision
   Making, JERUSALEM, ISRAEL, AUG, 1995},
Abstract = {The influence of the interaction between the valence of a future event
   and its perceived controllability on the degree of unrealistic optimism
   (UO) was tested. It was hypothesized that participants, while comparing
   themselves to an unknown comparison-target, will assign higher
   occurrence probabilities for positive-controllable events, and lower
   occurrence probabilities for negative events to themselves, than
   respective probabilities assigned to a vague comparison-target. It was
   further hypothesized that in the case of positive-uncontrollable events
   the probabilities assigned to oneself might be equal or even lower than
   those assigned to a comparison-target. These hypotheses were supported
   in a study in which 62 high school students assigned occurrence
   probabilities to 12 relevant future events representing 4 categories of
   events, i.e., positive events perceived as controllable or
   uncontrollable, and negative events perceived as controllable or
   uncontrollable. The findings are discussed in terms of cognitive and
   motivational processes.},
