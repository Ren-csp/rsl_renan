@article{ WOS:000250982200005,
Author = {Sims, Calvin M. and Noel, Nora E. and Maisto, Stephen A.},
Title = {Rape blame as a function of alcohol presence and resistance type},
Journal = {ADDICTIVE BEHAVIORS},
