@article{ WOS:000225268000005,
Author = {Takahashi, N},
Title = {Effect of spatial cor figuration of motion signals on motion integration
   across space},
Journal = {SWISS JOURNAL OF PSYCHOLOGY},
Year = {2004},
Volume = {63},
Number = {3},
Pages = {173-182},
Month = {SEP},
Note = {2nd Annual Meeting of the Vision-Sciences-Society, SARASOTA, FL, MAY
   10-15, 2002},
Organization = {Vis Sci Soc},
Abstract = {The present study examined the effect of the spatial configuration of
   local signals on motion integration across space. The perceived
   coherency was measured in different configurations of aperatures and
   combinations of motion directions. The results showed the following: (1)
   Motion integration across separate aperatures is affected by the spatial
   configuration of the aperatures. The perceived coherency was highest
   when the aperatures were arranged symmetrically with respect to the
   coherent direction. (2) Though the spatial configuration of aperatures
   are the same, the assignment of each local motion to each aperatures has
   an effect, and converging local motions are integrated more than
   diverging local motions. (3) There is a limit to the direction
   difference of local motions. These results suggest that the spatial
   structure of global motion behind aperatures has a considerable effect
   on the integration of local motions in aperatures.},
