Title = {A PROSPECTIVE-STUDY OF ADOLESCENT SUICIDAL-BEHAVIOR FOLLOWING
   HOSPITALIZATION},
Journal = {SUICIDE AND LIFE-THREATENING BEHAVIOR},
Year = {1995},
Volume = {25},
Number = {3},
