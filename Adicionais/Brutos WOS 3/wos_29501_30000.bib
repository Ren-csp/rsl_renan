@article{ WOS:000256575600015,
Author = {Green, D. and Chambers, M. E. and Sugden, D. A.},
Title = {Does subtype of developmental coordination disorder count: Is there a
   differential effect on outcome following intervention?},
Journal = {HUMAN MOVEMENT SCIENCE},
Year = {2008},
