@inproceedings{ WOS:000260683300005,
Author = {Colquitt, Jason A. and Mueller, Jessica B.},
Editor = {Gilliland, SW and Steiner, DD and Skarlicki, DP},
Title = {JUSTICE, TRUSTWORTHINESS, AND TRUST A Narrative Review of Their
   Connections},
Booktitle = {JUSTICE, MORALITY, AND SOCIAL RESPONSIBILITY},
Series = {Research in Social Issues in Management},
Year = {2008},
Pages = {101+},
Note = {4th International Round Table on Innovations in Organizational Justice,
   Tucson, AZ, NOV 03-04, 2006},
Abstract = {Although the justice and trust literatures have long been intertwined,
   there is surprisingly little consensus about the nature of the
   justice-trust connection. Some empirical studies cast trust as an
   antecedent of justice, whereas others cast justice as an antecedent of
   trust. Moreover, there is a significant degree of overlap in the
   concepts represented injustice and trust measures. The purpose of this
   manuscript is to describe how the application of Mayer, Davis, and
   Schoorman's (1995) integrative model of trust can help clarify the
   nature of the justice-trust connection. Specifically, the model allows
   for the decomposition of justice-trustworthiness and justice-trust
   relationships while supplying measures that possess less overlap with
   justice scales. We offer suggestions for future research on the
   integration of justice and trust, including calls for more extensive
   longitudinal and experimental studies.},
