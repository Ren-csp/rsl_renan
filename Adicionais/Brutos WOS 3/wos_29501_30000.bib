@inproceedings{ WOS:000080333800007,
Author = {Flach, JM},
Editor = {Gopher, D and Koriat, A},
Title = {Ready, fire, aim: A ``meaning-processing{''} approach to display design},
Booktitle = {ATTENTION AND PERFORMANCE XVII: COGNITIVE REGULATION OF PERFORMANCE:
   INTERACTION OF THEORY AND APPLICATION},
Series = {Attention and Performance},
Year = {1999},
Volume = {17},
Pages = {197-221},
Note = {17th International Symposium on Attention and Performance, BEIT OREN,
   ISRAEL, JUL 07-12, 1996},
Abstract = {This chapter presents a ``meaning-processing{''} approach to display
   design in contrast to the more traditional ``information-processing{''}
   approach. For the information-processing approach, a fundamental design
   issue is the limited capacity of the human operator (in terms of a
   bottleneck or limited energetic resources). For the meaning-processing
   approach the fundamental design issue is access to meaning. Effective
   interfaces represent meaningful properties of the work domain as
   directly as possible. These direct representations support skill-based
   interactions. The design rationale behind a configural attitude display
   for general aviation(the WrightCAD design) is presented as a concrete
   example of the meaning-processing approach. This design integrates
   pitch, roll, altitude, airspeed, and heading into a configural
   representation to directly specify dimensions such as ``too low{''} that
   bound the safe field of travel.},
