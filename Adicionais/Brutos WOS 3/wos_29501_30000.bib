@article{ WOS:000265742300002,
Author = {Tschan, Franziska and Semmer, Norbert K. and Gurtner, Andrea and
   Bizzari, Lara and Spychiger, Martin and Breuer, Marc and Marsch, Stephan
   U.},
Title = {Explicit Reasoning, Confirmation Bias, and Illusory Transactive Memory A
   Simulation Study of Group Medical Decision Making},
Journal = {SMALL GROUP RESEARCH},
Year = {2009},
Volume = {40},
Number = {3},
Pages = {271-300},
Month = {JUN},
Note = {3rd Annual Conference of the
   Interdisciplinary-Network-for-Group-Research, Kansas City, MO, JUL
   17-19, 2008},
Organization = {Interdisciplinary Network Grp Res},
Abstract = {Teamwork is important in medicine, and this includes team-based
   diagnoses. The influence of communication on diagnostic accuracy in an
   ambiguous situation was investigated in an emergency medical simulation.
   The situation was ambiguous in that some of the patient's symptoms
   suggested a wrong diagnosis. Of 20 groups of physicians, 6 diagnosed the
   patient, 8 diagnosed with help, and 6 missed the diagnosis. Based on
   models of decision making, we hypothesized that accurate diagnosis is
   more likely if groups (a) consider more information, (b) display more
   explicit reasoning, and (c) talk to the room. The latter two hypotheses
   were supported. Additional analyses revealed that physicians often
   failed to report pivotal information after reading in the patient chart.
   This behavior suggested to the group that the chart contained no
   critical information. Corresponding to a transactive memory process,
   this process results in what we call illusory transactive memory. The
   plausible but incorrect diagnosis implied that the two lungs should
   sound differently. Despite objectively identical sounds, some physicians
   did hear a difference, indicating confirmation bias. Training physicians
   in explicit reasoning could enhance diagnostic accuracy.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Tschan, F (Corresponding Author), Univ Neuchatel, CH-2000 Neuchatel, Switzerland.
   Tschan, Franziska; Bizzari, Lara, Univ Neuchatel, CH-2000 Neuchatel, Switzerland.
   Semmer, Norbert K., Univ Bern, CH-3012 Bern, Switzerland.
   Gurtner, Andrea, Berne Univ Appl Sci, Dept Management \& Adm, Bern, Switzerland.
   Spychiger, Martin; Breuer, Marc; Marsch, Stephan U., Univ Basel Hosp, CH-4031 Basel, Switzerland.},
DOI = {10.1177/1046496409332928},
ISSN = {1046-4964},
EISSN = {1552-8278},
