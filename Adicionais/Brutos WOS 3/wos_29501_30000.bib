@inproceedings{ WOS:000268997300024,
Author = {Bryant, R. W. and Atwal, K. S. and Bakaj, I. and Buber, M. T. and
   Carlucci, S. and Cerne, R. and Cortes, R. and Devantier, H. R. and
   Hendrix, C. J. and Lee, S. P. and Palmer, R. K. and Wilson, C. and Yang,
   Q. and Salemme, F. R.},
