@article{ WOS:000188943500004,
Author = {Richardson, DC and Kirkham, NZ},
Title = {Multimodal events and moving locations: Eye movements of adults and
   6-month-olds reveal dynamic spatial indexing},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-GENERAL},
Year = {2004},
Volume = {133},
Number = {1},
Pages = {46-62},
Month = {MAR},
Note = {International Conference on Infant Studies, TORONTO, CANADA, APR, 2002},
Abstract = {The ability to keep track of locations in a dynamic, multimodal
   environment is crucial for successful interactions with other people and
   objects. The authors investigated the existence and flexibility of
   spatial indexing in adults and 6-month-old infants by adapting an
   eye-tracking paradigm from D. C. Richardson and M. J. Spivey (2000).
   Multimodal events were presented in specific locations, and eye
   movements were measured when the auditory portion of the stimulus was
   presented without its visual counterpart. Experiment I showed that
   adults spatially index auditory information even when the original
   associated locations move. Experiments 2 and 3 showed that infants are
   capable of both binding multimodal events to locations and tracking
   those locations when they move.},
