@article{ WOS:000076151100002,
Author = {Theeuwes, J and Burger, R},
Title = {Attentional control during visual search: The effect of irrelevant
   singletons},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {1998},
Volume = {24},
Number = {5},
Pages = {1342-1353},
Month = {OCT},
Note = {37th Annual Meeting of the Psychonomic-Society, CHICAGO, ILLINOIS, OCT
   31-NOV 03, 1996},
Organization = {Psychon Soc; Natl Sci Fdn; USN, Off Nav Res},
Abstract = {Four experiments investigated whether a highly salient color singleton
   can be ignored during serial search. Observers searched for a target
   letter among nontarget letters and were instructed to ignore an
   irrelevant, highly salient color singleton that was either compatible or
   incompatible with the response to the target letter The results indicate
   that it was possible to prevent attentional capture by the irrelevant
   singleton only when both the target and the distracter color were known.
   When either the color of the target or the color of the to-be-ignored
   singleton were varied over trials, the irrelevant singleton captured
   attention. The ability to selectively filter singleton distracters
   during serial search depends on the presence of an attentional set for a
   specific feature value of both target and distracter. In the absence of
   a consistently predictable feature value of both target and distracter,
   top-down control is not possible.},
