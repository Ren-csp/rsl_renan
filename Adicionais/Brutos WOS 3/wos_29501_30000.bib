Month = {FAL},
Note = {40th Annual Meeting of the
   American-Academy-of-Child-and-Adolescent-Psychiatry, SAN ANTONIO, TX,
   OCT 26-31, 1993},
Organization = {Amer Acad Child \& Adolescent Psychiat},
Abstract = {Identification of factors associated with adolescent suicidal behavior
   following psychiatric hospitalization would facilitate development of
   effective aftercare interventions. This prospective study identified
   specific predictors of suicidal behavior in 100 adolescents during a
   6-month follow-up period. Standardized baseline assessments and
   structured follow-up telephone interviews were conducted with
   adolescents and their guardians. Eighteen percent of adolescents
   reported suicidal behavior during the follow-up period, primarily of low
   medical lethality and minimal or ambivalent suicidal intent. This
   behavior was associated with suicidal thoughts, family dysfunction, and
   dysthymia. It was not associated with initial posthospitalization
   treatment compliance. Implications of these findings are discussed.},
