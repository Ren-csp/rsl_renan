@article{ WOS:000173750800008,
Author = {Neill, WT and Neely, JH and Hutchison, KA and Kahan, TA and VerWys, CA},
Title = {Repetition blindness, forward and backward},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2002},
Volume = {28},
Number = {1},
Pages = {137-149},
Month = {FEB},
Note = {38th Annual Meeting of the Psychonomic-Society, PHILADELPHIA, PA, NOV,
   1997},
Organization = {Psychon Soc},
Abstract = {In these experiments, 2 letters were presented sequentially to the left
   and right of fixation, followed by pattern masks. Report was cued by
   spatial location (Experiments 1a, 1b, 2, 4, and 5) or temporal position
   (Experiments 3, 4, and 5). In all experiments, 2 identical letters on a
   trial resulted in reduced accuracy of report (repetition blindness; RB)
   for both the 1st and 2nd presented letters. This decrement was greater
   for the 2nd letter if subjects expected temporal cues, but tended to be
   greater for the lst letter if they expected spatial cues. Analyses of
   errors and responses on catch trials indicated no bias against report of
   repetitions, and the repetition decrement did not interact with output
   order. The data are inconsistent with both type-refractoriness and
   memory-retrieval accounts of RB. A modified version of N. G. Kanwisher's
   (1987) token-individuation theory is proposed to account for the
   results.},
