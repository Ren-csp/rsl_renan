Title = {Changes in neuromagnetic beta-band oscillation after music-supported
   stroke rehabilitation},
Booktitle = {NEUROSCIENCES AND MUSIC IV: LEARNING AND MEMORY},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2012},
