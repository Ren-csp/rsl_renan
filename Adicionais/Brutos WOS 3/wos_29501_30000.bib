@article{ WOS:A1995QU16100001,
Author = {MULLEN, B and JOHNSON, C},
Title = {COGNITIVE REPRESENTATION IN ETHNOPHAULISMS AND ILLUSORY CORRELATION IN
   STEREOTYPING},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {1995},
Volume = {21},
