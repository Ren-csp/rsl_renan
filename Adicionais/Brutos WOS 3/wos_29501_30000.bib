   Wai and Rahman, Rafiduraida Abdul},
Editor = {Voon, BH and Hamali, J and Abdullah, F and Joseph, C and Leong, SH and Lau, UH and Chung, ESM and Ng, KC and Teo, AK},
Title = {Investigating the Relationship among Service Quality, Emotional
   Satisfaction and Favorable Behavioral Intentions in Higher Education
   Service Experience},
Booktitle = {IRSSM-6: THE 6TH INTERNATIONAL RESEARCH SYMPOSIUM IN SERVICE MANAGEMENT
   - SERVICE IMPERATIVES IN THE NEW ECONOMY: SERVICE EXCELLENCE FOR
   SUSTAINABILITY},
Series = {Procedia Social and Behavioral Sciences},
