@article{ WOS:000457256000003,
Author = {Moeller, Malte and Mayr, Susanne and Buchner, Axel},
Title = {Inhibition of Irrelevant Response Codes Is Affected by Matching
   Target-Distractor Modalities},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2019},
Volume = {45},
Number = {2},
Pages = {189-208},
Month = {FEB},
Note = {57th Annual Meeting of the Psychonomic-Society, Boston, MA, NOV 17-20,
   2016},
Organization = {Psychon Soc},
Abstract = {Lateralized responses to central targets are facilitated when
   distractors are presented ipsilaterally (congruent trials) compared with
   contralaterally (incongruent trials) to the response. This accessory
   Simon effect is explained by assuming that distractors generate a
   spatial code that conforms to, or conflicts with, the response. The
   effect typically diminishes as the distractor-target interval increases.
   However, it is unclear whether irrelevant spatial codes passively decay
   or are actively inhibited. Given that inhibition takes time to develop,
   its operation may reverse the Simon effect-indicated by impaired
   performance in congruent compared with incongruent trials-when the
   distractor is presented prior to the target. In the present study, the
   temporal separation between distractor and target was systematically
   manipulated. Participants responded to a centrally presented visual
   (Experiments 1 and 2) or auditory (Experiments 3 and 4) target. A
   lateralized auditory distractor either occurred prior to, or
   simultaneously with, the target. A Simon effect occurred when distractor
   and target were presented simultaneously or in close temporal proximity.
   The effect was reversed with longer distractor-target intervals, but
   only when targets and distractors were presented in the same modality
   (Experiments 3 and 4), suggesting that an inhibition process operates on
   distractor events, which is stronger in the case of matching target and
   distractor modalities.
   Public Significance Statement
   In most everyday situations, humans are confronted with a plethora of
   information of which only a subset is relevant to complete a current
   goal. Still, humans are capable of performing goal-directed behavior
   with astonishing ease. The present study investigated the cognitive
   mechanisms that underlie this remarkable ability. The findings suggest
   that goal-directed human behavior is supported by blocking the tendency
   to respond to currently irrelevant information and that this suppression
   mechanism is more strongly engaged when the signals competing for action
   are presented in the same modality.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article; Proceedings Paper},
Language = {English},
