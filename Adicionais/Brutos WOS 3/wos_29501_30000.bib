@article{ WOS:A1997WN30000005,
Author = {Ryckman, RM and Butler, JC and Thornton, B and Lindner, MA},
Title = {Assessment of physique subtype stereotypes},
Journal = {GENETIC SOCIAL AND GENERAL PSYCHOLOGY MONOGRAPHS},
Year = {1997},
Volume = {123},
Number = {1},
Pages = {101-\&},
Month = {FEB},
Note = {Meeting of the Eastern-Psychological-Association, BOSTON, MA, APR   01,
   1995},
Organization = {E Psychol Assoc},
Abstract = {Four studies were conducted with American undergraduate students to (a)
   identify distinct physique subtypes and their trait characteristics
   within the major global physiques, (b) assess their relative
   favorability or unfavorability, and (c) analyze participants'
   willingness to associate with individuals who possessed such physique
   subtypes, The resulting data clearly indicated that there were a variety
   of subtypes within the global physiques and that participants assigned
   personality traits differentially to them. Favorable, unfavorable, and
   mixed subtypes also existed within virtually all of the global
   physiques, and participants reported being more willing to associate
   with individuals who possessed favorable than unfavorable subtype
   physiques.},
