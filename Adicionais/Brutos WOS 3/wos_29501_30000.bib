@article{ WOS:000084380700024,
Author = {Bushnell, EW and Baxt, C},
Title = {Children's haptic and cross-modal recognition with familiar and
   unfamiliar objects},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {1999},
Volume = {25},
Number = {6},
Pages = {1867-1881},
Month = {DEC},
Note = {36th Annual Meeting of the Psychonomic-Society, LOS ANGELES, CALIFORNIA,
   NOV   12, 1995},
Organization = {Psychon Soc},
Abstract = {Five-year-old children explored multidimensional objects either
   haptically or visually and then were tested for recognition with target
   and distracter items in either the same or the alternative modality. In
   Experiments 1 and 2, haptic, visual, and cross-modal recognition were
   all nearly perfect with familiar objects; haptic and visual recognition
   were also excellent with unfamiliar objects, but cross-modal recognition
   was less accurate. In Experiment 3, cross-modal recognition was also
   less accurate than within-mode recognition with familiar objects that
   were members of the same basic-level category. The results indicate that
   children's haptic recognition is remarkably good, that cross-modal
   recognition is otherwise constrained, and that cross-modal recognition
   may be accomplished differently for familiar and unfamiliar objects.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Bushnell, EW (Corresponding Author), Tufts Univ, Dept Psychol, Medford, MA 02155 USA.
   Tufts Univ, Dept Psychol, Medford, MA 02155 USA.},
DOI = {10.1037/0096-1523.25.6.1867},
ISSN = {0096-1523},
Keywords-Plus = {INFANTS; INFORMATION; TOUCH},
Research-Areas = {Psychology},
