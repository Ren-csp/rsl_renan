Volume = {16},
Number = {6},
Pages = {809-830},
Month = {NOV},
Note = {Meeting of the Midwestern-Psychological-Association, CHICAGO, ILLINOIS,
   MAY   02, 1998},
Organization = {Midwestern Psychol Assoc},
Abstract = {We examined disgust and fear responses to spiders in spider-distressed
   and nondistressed individuals. Undergraduate participants (N=134)
   completed questionnaires concerning responses to spiders and other
   potentially aversive stimuli, as well as measures of disgust
   sensitivity, anxious arousal, worry, and anhedonic depression. In
   addition, we obtained self-report and facial expressions of disgust and
   fear while participants were exposed to a live tarantula. Both spider
   distressed and nondistressed individuals reported disgust and exhibited
   disgust facial expressions in response to a tarantula. Disgust in
   response to spiders was not found to be part of a general disgust
   response to all negative stimuli, nor was it due to a general negative
   emotional response to spiders. Emotional responses to spiders were
   differentially associated with scores on personality and psychological
   functioning measures. The results of this study provide evidence that
   spiders have a specific disgust-evoking status in both distressed and
   nondistressed populations.},
