   Schaffer, Bryan S. and Wilson, Mark G.},
Title = {Individual Reactions to High Involvement Work Processes: Investigating
   the Role of Empowerment and Perceived Organizational Support},
Journal = {JOURNAL OF OCCUPATIONAL HEALTH PSYCHOLOGY},
Year = {2009},
Volume = {14},
