@article{ WOS:A1996TT51500014,
Author = {Bhatt, RS and RoveeCollier, C},
Title = {Infants' forgetting of correlated attributes and object recognition},
Journal = {CHILD DEVELOPMENT},
Year = {1996},
Volume = {67},
