@article{ WOS:000247996800004,
Author = {Platow, Michael J. and Voudouris, Nicholas J. and Coulson, Melissa and
   Gilford, Nicola and Jamieson, Rachel and Najdovsk, Liz and Papaleo,
   Nicole and Pollard, Chelsea and Terry, Leanne},
Title = {In-group reassurance in a pain setting produces lower levels of
   physiological arousal: Direct support for a self-categorization analysis
   of social influence},
Journal = {EUROPEAN JOURNAL OF SOCIAL PSYCHOLOGY},
Year = {2007},
Volume = {37},
Number = {4},
Pages = {649-660},
Month = {JUL-AUG},
Note = {32nd Annual Meeting of the Society-of-Australasian-Social-Psychologists,
   Syndey, AUSTRALIA, APR, 2003},
Organization = {Soc Australasian Social Psychologists},
Abstract = {A large body of research demonstrates a strong social component to
   people's pain experiences and pain-related behaviours. We investigate
   this by examining the impact of social-influence processes on
   laboratory-induced pain responses by manipulating the social-categorical
   relationship between the person experiencing pain and another who offers
   reassurance. We show that physiological arousal associated with
   laboratory-induced pain is significantly lower in normal, healthy
   participants following reassurance about the pain-inducing activity when
   that reassurance comes from an ingroup member in contrast to reassurance
   from an out-group member and a no reassurance control. These data are
   consistent with predictions derived from self-categorization theory,
   providing convincing empirical support of its analysis of social
   influence using a non-reactive measure. These data also represent a
   clear advance within the pain literature by identifying a possible
   common process to the social-psychological component of pain responses.
   Copyright (c) 2006 John Wiley \& Sons, Ltd.},
