@article{ WOS:000229849200007,
Author = {Eagly, AH},
Title = {Achieving relational authenticity in leadership: Does gender matter?},
Journal = {LEADERSHIP QUARTERLY},
Year = {2005},
Volume = {16},
Number = {3},
Pages = {459-474},
Month = {JUN},
Note = {Inaugural Meeting on Authentic Leadership Development, Univ
   Nebraska-Lincoln, Gallup Inst, Lincoln, NE, 2004},
Abstract = {This article presents a relational view of leaders' authenticity by
   arguing that much more is required of leaders than transparently
   conveying and acting on their values. Achieving relational authenticity
   requires that followers accord leaders the legitimacy to promote a set
   of values on behalf of a community. Only under such conditions can
   leaders elicit the personal and social identification of followers that
   can enhance the success of a group, organization, or society. This
   article presents evidence that obtaining this identification is more
   challenging for female than male leaders and more generally for members
   of outsider groups that have traditionally not had access to particular
   leadership roles. The training of women and outsiders for leadership
   should focus on these relational aspects of achieving authenticity as a
   leader. (c) 2005 Elsevier Inc. All rights reserved.},
Publisher = {ELSEVIER SCIENCE INC},
