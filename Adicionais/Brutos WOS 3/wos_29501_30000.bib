@article{ WOS:000240478300006,
Author = {Watrous, Kristen M. and Huffman, Ann H. and Pritchard, Robert D.},
Title = {When coworkers and managers quit: The effects of turnover and shared
   values on performance},
Journal = {JOURNAL OF BUSINESS AND PSYCHOLOGY},
Year = {2006},
Volume = {21},
Number = {1},
Pages = {103-126},
Month = {FAL},
Note = {19th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, Chicago, IL, APR
   02-04, 2004},
Organization = {Soc Ind \& Org Psychol},
Abstract = {We examined the relationship between work unit, direct management, and
   overall management turnover and performance improvement following an
   intervention in fifty work units in multiple organizations in eight
   countries. Direct management turnover was negatively related to
   performance improvement, while work unit and overall management turnover
   were not. We also investigated shared values as a moderator of the
   turnover-performance relationship and found that high shared values
   buffered the negative effect of overall management turnover on
   performance improvement. The results are noteworthy, as they point to
   the importance of examining turnover at different organizational levels
   and identifying moderators of the turnover-performance relationship.},
