@article{ WOS:000304900100009,
Author = {Gurnsey, Rick and Biard, Mathieu},
Title = {Eccentricity Dependence of the Curveball Illusion},
Journal = {CANADIAN JOURNAL OF EXPERIMENTAL PSYCHOLOGY-REVUE CANADIENNE DE
   PSYCHOLOGIE EXPERIMENTALE},
Year = {2012},
Volume = {66},
Number = {2},
Pages = {144-152},
Month = {JUN},
Note = {Meeting on Human Memory and Computational Cognitive Modelling, Univ
   Manitoba, Winnipeg, CANADA, JUN, 2012},
Abstract = {When the Gaussian envelope of a Gabor patch moves straight down while
   its sine wave component drifts to the left, the Gabor is seen to move
   down to the left when viewed with peripheral vision (exhibiting the
   so-called curveball illusion) but straight down when viewed foveally. We
   used a nulling procedure to quantify the strength of the curveball
   illusion at a range of stimulus sizes and eccentricities to determine if
   the illusion is size dependent and whether size scaling can equate the
   strength of the illusion across the visual field. We find that the
   illusion is size dependent (illusion strength decreases with increasing
   stimulus size) but that size scaling is not sufficient to elicit an
   illusion at fixation that matches the strength of the illusion at 10
   degrees. These results suggest that certain changes in motion processing
   across the visual field differ in more than just the local scale of the
   mechanisms involved.},
Publisher = {CANADIAN PSYCHOLOGICAL  ASSOC},
Address = {141 LAURIER AVE WEST, STE 702, OTTAWA, ONTARIO K1P 5J3, CANADA},
