@inproceedings{ WOS:000080333800020,
Author = {Zakay, D and Block, RA and Tsal, Y},
Editor = {Gopher, D and Koriat, A},
Title = {Prospective duration estimation and performance},
Booktitle = {ATTENTION AND PERFORMANCE XVII: COGNITIVE REGULATION OF PERFORMANCE:
   INTERACTION OF THEORY AND APPLICATION},
Series = {Attention and Performance},
Year = {1999},
Volume = {17},
Pages = {557-580},
Note = {17th International Symposium on Attention and Performance, BEIT OREN,
   ISRAEL, JUL 07-12, 1996},
Abstract = {A person who is asked in advance to judge the duration of a task must
   divide attention between the task and timing it. Because attentional
   resources are limited, prospective duration estimates should be
   inversely related to the amount of attentional resources allocated to
   the task (workload). We review evidence that performance on a duration
   production task is a sensitive, practical, and unobtrusive index of
   workload. Prospective duration judgments may therefore reflect the
   workload demands of everyday tasks. We focus on several everyday
   situations, such as waiting in a computer environment and waiting in
   line. Finally, we discuss the benefits and shortcomings of the use of
   prospective duration estimation in everyday situations from theoretical
   and practical perspectives.},
