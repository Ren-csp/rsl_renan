@article{ WOS:A1995RY27100007,
Author = {ARMSTRONG, IT and MEWHORT, DJK},
Title = {REPETITION DEFICIT IN RAPID-SERIAL-VISUAL-PRESENTATION DISPLAYS -
   ENCODING FAILURE OR RETRIEVAL FAILURE},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {1995},
Volume = {21},
Number = {5},
Pages = {1044-1052},
Month = {OCT},
Note = {Meeting of the
   Canadian-Society-for-Brain-Behaviour-and-Cognitive-Science, TORONTO,
   CANADA, JUN, 1993},
Organization = {Canadian Soc Brain Behav \& Cognit Sci},
Abstract = {The repetition deficit associated with rapid serial visual presentation
   (RSVP) has been explained as a repetition-induced blindness, that is, as
   a perceptual or encoding failure. The repetition deficit was replicated
   in a standard free-recall RSVP task, and it was shown that participants
   were able to report the lost item when they were prompted with a
   retrieval probe. The authors argue that both copies of the repeated
   items were available in memory but that they were not accessible for
   report. Hence, they conclude that the repetition deficit in the RSVP
   task reflects a retrieval failure, not a perceptual failure.},
