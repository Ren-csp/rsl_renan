@inproceedings{ WOS:000280689300061,
Author = {Mou Junshan and Guo Xiangkun},
Editor = {Zhang, H and Zhang, H},
Title = {Distribution of Polycyclic Aromatic Hydrocarbons in Groundwater along
   Wastewater Irrigation Areas},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {314-317},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Contamination of polycyclic aromatic hydrocarbons (PAHs) represents one
   of the most pressing threats to water and soil resources, as well as
   human health. Recycled water and even sewage has dominated agricultural
   irrigation water in arid and semi-arid areas of China. The poor quality
   of the water and long-term application may result in the accumulation
   and relevant deleterious effects of pollutants, especially for
   persistent organic pollutants (POPs) and permanently bound chemical
   residues. In this contribution, the distribution of PAHs in groundwater
   along wastewater irrigation areas was investigated via gas
   chromatography with flame ionization detector (FID). The PAHs were
   enriched by employing solid phase extraction (SPE). The results show
   that the mean concentrations, as the sum of 16 PAHs, change from 3.67 mu
   g/L to 25.70 mu g/L. The Benzo-a-Anthracene (Baa) and
   Benzo-k-Fluoranthene (Bkf) may be accumulated easily and degraded
   difficultly in groundwater. The concentration of them reaches to 3.98 mu
   g/L and 5.617 mu g/L, respectively. So, the PAHs in the groundwater may
   be accumulated, predominantly, from the wastewater discharged from
   petrochemical factory.},
