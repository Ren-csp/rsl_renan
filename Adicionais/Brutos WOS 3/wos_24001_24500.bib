@article{ WOS:000403973600048,
Author = {Rajadurai, Jegatheesan and Sapuan, Noraina Mazuin and Daud, Salina and
   Abidin, Nurazariah},
Title = {Creating Industry Driven Sustainable Technical Graduates: A Case from
   Malaysia},
