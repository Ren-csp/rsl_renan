@inproceedings{ WOS:A1996BG68Z00030,
Author = {Iwai, E and Hikosaka, K and Omata, K and Yaginuma, S and Yamaguchi, K
   and Osawa, Y},
Editor = {Ishikawa, K and McGaugh, JL and Sakata, H},
Title = {Macaque rostral superior temporal polysensory area and bimodal compound
   learning},
Booktitle = {BRAIN PROCESSES AND MEMORY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1996},
Volume = {1108},
Pages = {353-368},
Note = {16th Nihon International Symposium on Brain Processes and Memory, TOKYO,
   JAPAN, NOV 29-DEC 02, 1995},
Abstract = {The present study demonstrated that ablations of a rostral superior
   temporal sulcus (rSTS) in the monkey resulted in significant impairment
   of learning on tasks with a bimodal visual and auditory compound (light
   + tone), but did not impair learning on tasks with unimodal components
   (light and tone) of the compound. On the other hand, lesions of a caudal
   superior temporal sulcus (cSTS) resulted in no significant deficits of
   learning on any of the above tasks, but produced a behavioral blindness
   temporarily after the operation. It was also found that there is an
   interaction between visual and auditory stimulation in bimodal neurons
   of the rSTS polysensory area (rSTP); the activity of bimodal rSTP cells
   elicited by single Visual and auditory stimuli was significantly
   enhanced by double presentation of both stimuli. We conclude that the
   rSTP is more intimately involved in the processes of perception,
   recognition and memory of a given polymodal object than a caudal STS
   polysensory area (cSTP) is, whereas the cSTP participates more closely
   in the process of attending simultaneously to the components of a
   polymodal object in relation to the spatial framework than the rSTP
   does.},
