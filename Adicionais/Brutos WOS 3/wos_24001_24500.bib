@inproceedings{ WOS:000240653600014,
Author = {Vermetten, Eric and Vythilingam, Meena and Schmahl, Christian and De
   Kloet, Carien and Southwick, Steven M. and Charney, Dennis S. and
   Bremner, J. Douglas},
Editor = {Yehuda, R},
Title = {Alterations in stress reactivity after long-term treatment with
   paroxetine in women with posttraumatic stress disorder},
Booktitle = {PSYCHOBIOLOGY OF POSTTRAUMATIC STRESS DISORDER: A DECADE OF PROGRESS},
Series = {Annals of the New York Academy of Sciences},
Year = {2006},
Volume = {1071},
Pages = {184-202},
Note = {Meeting on Psychobiology of Post-Traumatic Stress Disorder, New York,
   NY, SEP 11-13, 2005},
Organization = {New York Acad \& Sci},
Abstract = {Posttraumatic stress disorder (PTSD) is typically accompanied by both
   acute and chronic alterations in the stress response. These alterations
   have mostly been described in individuals under baseline conditions, but
   studies have also used a challenge model to assess the role of the
   hypothalamic-pituitary-adrenal (HPA) axis in the stress response. The
   purpose of this article was to assess the effect of long-term treatment
   with the selective reuptake inhibitor (SSRI), paroxetine, on stress
   reactivity in patients with PTSD. We assessed diurnal salivary cortisol
   and urinary cortisol as well as cortisol, heart rate, and behavioral
   responses to a standardized cognitive stress challenge, in 13 female
   patients with chronic PTSD before and after 12 months of paroxetine
   treatment. Treatment resulted in a significant decrease in PTSD
   symptoms. Twenty-four-hour urinary cortisol was lower compared to base
   line after successful treatment. Treatment resulted in a decrease of
   salivary cortisol levels on all time points on a diurnal curve. Despite
   similar stress perception, cortisol response to the cognitive stress
   challenge resulted in a 26.5\% relative decrease in stress-induced
   salivary cortisol with treatment. These results suggest that successful
   treatment with SSRI in chronic PTSD is associated with a trend for a
   decrease in baseline diurnal cortisol and with reduced cortisol
   reactivity to stress.},
