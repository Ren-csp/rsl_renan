Pages = {82-92},
Note = {International Conference on Sustainable Urban Wastewater Treatment and
   Reuse, CYPRUS, SEP, 2005},
Abstract = {Water shortage is a major problem in many developing countries and
   represents one of the key factors for their development. The quality of
   available resources has deteriorated owing to pollution by lack of
   wastewater treatment facilities and control mechanisms/laws. Therefore
   there is a great need to propose appropriate wastewater management in
   developing countries. This paper summarises wastewater management
   policies applied in developing countries which in many cases involve
   reuse for irrigation. An evaluation of constructed wetlands is proposed
   in prospect of reuse and of a sustainable management of water resources.},
