@article{ WOS:000272639600006,
Author = {Dagher, Rada K. and McGovern, Patricia M. and Alexander, Bruce H. and
   Dowd, Bryan E. and Ukestad, Laurie K. and McCaffrey, David J.},
Title = {The Psychosocial Work Environment and Maternal Postpartum Depression},
Journal = {INTERNATIONAL JOURNAL OF BEHAVIORAL MEDICINE},
Year = {2009},
