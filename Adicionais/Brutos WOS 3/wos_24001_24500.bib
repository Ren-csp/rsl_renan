@article{ WOS:000432429600007,
Author = {Mamat, Khairulwafi and Rahim, Ruslan Abdul and Ugap, Catherina Anak},
Title = {An Investigation into the Catalytic Effect of Thematic Advertising in
   Promoting Social Unity in a Multicultural Country},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2203-2207},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {In addition to promoting products and services, streaming TV commercials
   play an important role in the process of nation building. In fact,
   advertising, together with dramas and films, function as a catalyst to
   help develop and strengthen national unity of nations by conveying
   messages or narratives that highlight the importance of respecting and
   embracing the diverse cultures in Malaysia. Against this backdrop, the
   aim of this preliminary study is to examine the impact of
   solidarity-themed advertising of Petronas, (Malaysia's renowned oil and
   gas corporate entity) broadcasted in the mainstream media, on public's
   perception of social unity. The research method of this study consisted
   of a preliminary evaluation and an interview. The preliminary evaluation
   helped review relevant scenes and visuals from several advertisements,
   while the interview involving selected individuals helped determine the
   psychological impact of such media on them based on their personal
   background and level of knowledge. In addition, this study helped
   highlight the important visual attributes of communication media,
   notably TV commercials, in influencing local audience in accepting and
   embracing the cultural differences in Malaysia's diverse social
   landscape, which can help cement a strong bond among Malaysians of
   various socio-cultural backgrounds.},
