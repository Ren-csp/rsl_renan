@article{ WOS:000079258300005,
Author = {Liu, JH},
Title = {Social representations of history: Preliminary notes on content and
   consequences around the Pacific Rim},
Journal = {INTERNATIONAL JOURNAL OF INTERCULTURAL RELATIONS},
