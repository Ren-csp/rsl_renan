@inproceedings{ WOS:000227683000078,
Author = {Peng, SC and Tomblin, JB and Spencer, LJ and Hurtig, RR},
Editor = {Miyamoto, RT},
Title = {Acquisition of rising intonation in pediatric cochlear implant
   recipients - a longitudinal study},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
