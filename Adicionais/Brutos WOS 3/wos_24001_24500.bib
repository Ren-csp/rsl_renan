Title = {An Assessment of Gender Sensitive Adaptation Options to Climate Change
   in Smallholder Areas of Zimbabwe, Using Climate Analogue Analysis},
Booktitle = {ADAPTING AFRICAN AGRICULTURE TO CLIMATE CHANGE: TRANSFORMING RURAL
   LIVELIHOODS},
Series = {Climate Change Management},
Year = {2015},
