@inproceedings{ WOS:000165805100039,
Author = {Kim, JY and Oh, DI and Park, DW},
Editor = {Singh, VP and Soe, WI and Sonu, JH},
Title = {Estimation of contaminant movements through aquifers in the Young San
   River area, Korea},
Booktitle = {HYDROLOGIC MODELING},
Year = {1999},
Pages = {427-434},
Note = {International Conference on Water, Environment, Ecology, Socioeconomics
   and Health Engineering (WEESHE), SEOUL NATL UNIV, SEOUL, SOUTH KOREA,
   OCT 18-21, 1999},
Organization = {Seoul Natl Univ; Louisiana State Univ; Korean Soc Civil Engineers; Korea
   Water Resources Assoc; Korean Soc Water \& Waste Water; Korean Soc Agr
   Engn},
Abstract = {The contaminant movements through four aquifers were estimated in a
   preliminary study for development of bank filtration in the Young San
   River area. NO3-N, NO2-N, NH4+-N, Fe, Mn, phenol, and Cl- were selected
   as the target contaminants and the nonreactive tracer, respectively.
   Batch isotherm tests were conducted to measure the
   distribution(partition) coefficients of the target contaminants. The
   mass transport parameters of nonreactive tracer were estimated from
   column tests. From the results of batch isotherm tests, it was shown
   that lower stream aquifer materials have greater distribution
   coefficients of NO3-N, NH4+-N, Mn, and phenol than the upper stream
   aquifer materials; however, there was no significant position-dependent
   trend for Fe. All aquifer materials tested have the same range of
   distribution coefficients for NO2-N. Column tests showed that there was
   no significant difference between the hydrodynamic dispersion
   coefficients of Cl- through tested aquifer materials; the molecular
   diffusion of Cl- was much less than the mechanical dispersion.
   Consequently, it seems that the difference of contaminant movements
   through would primarily result from distribution not from hydrodynamic
   dispersion.},
