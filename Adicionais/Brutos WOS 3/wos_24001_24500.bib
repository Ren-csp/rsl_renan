Title = {Child and Youth Physical Activity Promoting System in China},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 2},
Year = {2010},
Pages = {99-102},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {In recent years the public health problems of increasing sedentary
   lifestyles have become increasingly apparent between the young
   generations. Physical activity is necessary to improve health and is
   strongly recommended, especially for child and youth. Using methods of
   systematic review, this paper summarizes recommendations and dimensions
   for physical activity promoting system, to encourage physical activity
   among students, and promote healthy behavior among children and
   adolescents, so that they will continue to engage in physical activity
   in adulthood and obtain the benefits of physical activity throughout
   life. Results: the physical activity promoting system should include, at
   least, four parts: (1) Physical education programs: Schools are
   important institutions for physical activity promotion. Physical
   education is the primary form of activity students receive at school.
   (2) After-school or extracurricular programs. After-school programs can
   improve physical activity levels. And instructors and teachers are
   encouraged to seek out ways and resources to help create programs that
   are educationally and motivationally sound for children. (3)
   Intervention beyond school days. Lifestyle change and parents'
   involvement to promote physical activity among young people will make a
   difference. (4) A strong supporting system. A supporting system must
   contain at least three parts: policy support, investment and fund
   support, and perceptions or awareness change.},
