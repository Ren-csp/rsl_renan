Series = {Research on Emotion in Organizations},
Year = {2010},
Volume = {6},
Pages = {279-307},
Note = {International Conference on Emotion and Organizational Life,
   Fontainebleau, FRANCE, 2008},
Abstract = {In his chapter, we seek to resolve the long-running controversy as to
   whether moods foster or inhibit creativity. We base our arguments on a
   new theory, which we refer to as ``creativity-as-mood-regulation,{''}
   where employees experiencing moods are envisaged to engage in creative
   behavior in the hope of regulating their moods. We further suggest that
   employees with different goal orientations will have different
   likelihoods of choosing creative activities to regulate their moods.
   Finally, we identify the specific goal-orientation conditions under
   which positive and negative moods may,facilitate or depress creativity,
   and develop and discuss six related propositions.},
