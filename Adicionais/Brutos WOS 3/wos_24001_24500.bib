@inproceedings{ WOS:000188893400056,
Author = {Drake, C and El Heni, JB},
Editor = {Avanzini, G and Faienza, C and Minciacchi, D and Lopez, L and Majno, M},
Title = {Synchronizing with music: Intercultural differences},
