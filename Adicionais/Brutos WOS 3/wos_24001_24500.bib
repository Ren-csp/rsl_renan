@article{ WOS:A1995RK84100004,
Author = {NIELSEN, AL and SCARPITTI, FR},
Title = {ARGOT USE IN A THERAPEUTIC-COMMUNITY},
Journal = {DEVIANT BEHAVIOR},
Year = {1995},
