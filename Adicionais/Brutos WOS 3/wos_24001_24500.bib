@inproceedings{ WOS:000176847700028,
Author = {Reinhardt-Rutland, AH},
Editor = {Harris, D},
Title = {2D scenes and the framing effect: implications for visual motor
   performance via TV monitors},
Booktitle = {ENGINEERING PSYCHOLOGY AND COGNITIVE ERGONOMICS VOLUME SIX: INDUSTRIAL
   ERGONOMICS, HCI, AND APPLIED COGNITIVE PSYCHOLOGY},
Year = {2001},
Pages = {223-229},
Note = {3rd International Conference on Engineering Psychology and Cognitive
   Ergonomics, EDINBURGH, SCOTLAND, OCT 25-27, 2000},
Abstract = {In some visual-motor manipulations - examples include minimally-invasive
   ('keyhole') surgery and the handling of dangerous materials - the site
   of manipulation is viewed via a two-dimensional TV monitor. Inevitably,
   depth perception is degraded, since it is based almost wholly on
   pictorial information, perhaps enhanced by motion. Furthermore, a
   framing effect has now been identified: depth in a real scene is
   underestimated when viewing through a frame between the observer and the
   scene. This seems applicable to the conditions of TV viewing, since the
   monitor's case acts as a frame for the screen. To test this further, an
   experiment was devised to determine if the framing effect applies to
   depth conveyed pictorially. Observers judged the orientation-in-depth
   relative to the frontal plane of each of a sequence of rectangular and
   trapezoidal stimuli with true and pictorial slants. Consistent with
   previous studies, the framing effect reduced the perceived
   slant-in-depth of a surface conveying true and pictorial slant by about
   20\%. However, the reduction in perceived slant was 70\% for a truly
   frontal surface that was pictorially slanted, suggesting that the
   framing effect in TV viewing may be of major importance.},
