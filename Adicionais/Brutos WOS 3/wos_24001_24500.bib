@inproceedings{ WOS:000272997300007,
Author = {Nugent, Chris and Finlay, Dewar and Davies, Richard and Paggetti,
   Cristiano and Tamburini, Elena and Black, Norman},
Editor = {Giroux, S and Pigot, H},
Title = {Can Technology Improve Compliance to Medication?},
Booktitle = {FROM SMART HOMES TO SMART CARE},
Series = {Assistive Technology Research Series},
Year = {2005},
Volume = {15},
Pages = {65-72},
Note = {3rd International Conference on Smart Homes and Health Telematics,
   CANADA, JUL 04-06, 2005},
Organization = {Bell Canada; Univ Sherbrooke, Fac Sci; France Telecom; Inst Natl
   Telecommun; Grp Ecoles Telecommun},
Abstract = {Non-compliance to a prescribed medication regime causes implications to
   the health status of the patient and places additional burdens on
   healthcare infrastructures. Non-compliance itself is a complex issue and
   involves not only the patient but also all of the stakeholders in the
   supply-to-intake chain of medication. Analysis of patient's perceptions
   of medication has indicated that only a certain cohort can be targeted
   to improve compliance through the introduction of technology. In the
   current study we present an adaptable solution to address non-compliance
   based on an Internet based Care Model and an innovative compliance aid.
   The system has been evaluated in 4 pilot sites and measures relating to
   improvements in patient's compliance levels and increased levels of
   stakeholder's work efficiency have been recorded. Our general
   conclusions from this study would suggest that technology can be useful
   in improving compliance to medication however careful consideration
   should be given to the profile of the patient prior to introducing a
   technological solution to support the management of their medication.
   This implies that one `generic' solution may not be appropriate to all
   patients, hence, an effective service should be able to offer patients a
   tailored compliance package with a tailorable monitoring service and
   compliance aid.},
