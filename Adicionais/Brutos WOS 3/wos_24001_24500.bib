@article{ WOS:A1996VN11000012,
Author = {Lercher, P and Kofler, WW},
Title = {Behavioral and health responses associated with road traffic noise
   exposure along alpine through-traffic routes},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1996},
Volume = {189},
Pages = {85-89},
Month = {OCT 28},
Note = {5th International Symposium on Highway and Urban Pollution, WHO EUROPEAN
   OFF, COPENHAGEN, DENMARK, MAY 22-24, 1995},
Organization = {WHO European Off},
Abstract = {The perceived impact of rising traffic noise exposure on residents in
   five rural, alpine communities was assessed in an epidemiological study
   (1989 adults, aged 25-65), using subjective and objective exposure
   indices. Significant associations were found between noise exposure
   above 55 dB(A) and annoyance from noise, vibrations, exhaust fumes and
   soot/dust exposure. Closing windows, double glazing, moving sleeping
   room, filing complaints, supporting pressure groups and the wish to move
   was just as significantly linked with noise level as was loss of
   wellbeing/life satisfaction, increase of sleep problems, health worries
   and poorer health ratings. However, noise sensitive persons showed a
   quite different response pattern with lower overall nuisance, fewer
   behavioral actions but stronger health impacts than those persons
   actually having expressed their annoyance.},
