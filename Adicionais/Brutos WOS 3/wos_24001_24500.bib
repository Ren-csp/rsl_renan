   Beloborodova, Nilya Sabitovna},
Editor = {KarimSultanovich, BD},
Title = {ASSOCIATIVE FIELD OF THE WORD ``NATURE{''} AS A REPRESENTATION OF
   MAN-ENVIRONMENT INTERACTION},
