@article{ WOS:000487674200005,
Author = {Yang, Yueran and Moody, Sarah A. and Cabell, Jean J. and Madon,
   Stephanie},
Title = {Why Suspects Confess: The Power of Outcome Certainty},
Journal = {LAW AND HUMAN BEHAVIOR},
Year = {2019},
