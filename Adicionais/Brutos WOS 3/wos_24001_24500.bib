@inproceedings{ WOS:000239989900077,
Author = {de Boef, Wolter S. and Pinheiro, Sergio L. G.},
Editor = {Langeveld, H and Roling, N},
Title = {Social construction of knowledge: A leading perspective in a
   participatory research training programme in Santa Catarina, Brazil},
Booktitle = {Changing European Farming Systems for a Better Future: New Visions for
   Rural Areas},
Year = {2006},
Pages = {309-313},
Note = {7th European IFSA Symposium on New Visions for Rural Areas, Wageningen,
   NETHERLANDS, MAY 07-11, 2006},
Organization = {IFSA},
Abstract = {This paper presents the preliminary experiences of a training programme
   establishing participatory research teams in the State of Santa Catarina
   in Brazil. A foundation to the participatory research training programme
   is that through research ``with{''} instead of ``for{''} people,
   researchers and extensionists share perceptions about reality, values
   and interests, and thus through joint action socially construct
   knowledge. This approach changes the focus of research from control to
   relations, value systems diversity, endogenous development, autonomy and
   social Learning. The training programme has 56 participants from a
   diversity of organizations; they form nine regional teams. They
   participate in a process of about two years with 5 sessions. These
   session are (a) concepts and theory; (b) diagnosis, understanding Local
   realities and capacities; (c) designing in partnership an action plan;
   (d) project implementation and monitoring progress and learning, and (e)
   institutionalization and mainstreaming. The action Learning programme is
   realized within the World Bank financed Micro-Watershed Project. The
   paper concludes with major barriers in mainstreaming and
   institutionalization within the Leading organizations and particular the
   difficulty to stimulate public-civil society partnerships within
   participatory processes in Santa Catarina State.},
