@article{ WOS:000514164700001,
Author = {Wanberg, Connie R. and van Hooft, Edwin A. J. and Dossinger, Karyn and
   van Vianen, Annelies E. M. and Klehe, Ute-Christine},
Title = {How Strong Is My Safety Net? Perceived Unemployment Insurance Generosity
   and Implications for Job Search, Mental Health, and Reemployment},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2020},
Volume = {105},
Number = {3},
Pages = {209-229},
