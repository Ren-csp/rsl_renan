@article{ WOS:000403973600136,
Author = {Zur, Rohana and Alwiah, Sahil. S. Sharifah and Syaimak, A. S. and
   Legino, R.},
Title = {The Readiness of Quality Function Deployment Theory Implementation Among
   the SME Apparel in Malaysia: A Review},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {4},
Pages = {3194-3197},
