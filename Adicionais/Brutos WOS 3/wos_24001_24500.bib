@inproceedings{ WOS:000340501100026,
Author = {Read, Clancy and Earnest, Jaya and Ali, Mohammed and Poonacha, Veena and
   Bali, Suman},
Book-Group-Author = {Int Ctr Res \& Dev},
Title = {The challenges of participatory action to address community prioritized
   health concerns in disadvantaged communities: Considerations to improve
   future practice},
Booktitle = {INTERNATIONAL CONFERENCE ON GLOBAL PUBLIC HEALTH 2012},
Series = {Global Public Health Conference Proceedings},
Year = {2012},
Pages = {345-366},
Note = {International Conference on Global Public Health, Int Ctr Res \& Dev Sri
   Lanka, Colombo, SRI LANKA, DEC 03-04, 2012},
Organization = {Umea Univ},
Abstract = {Community participation to improve health is intuitively appealing.
   However, in marginalised communities the contexual challenges can turn
   community-led action into an idealistic pursuit rather than a practical
   reality. This paper reports on a community-based participatory research
   undertaken in Gujarat, Western India in 2009 that aimed to transform
   knowledge of community identified and prioritized health concerns into
   action.
   This paper presents the experiences and challenges of this study to
   overcome problems identified by villagers. The lead researcher shares a
   new supposition; that contextual factors (affecting knowledge to action
   transition) related to the local environment, community, researcher
   perceptions and organisational capacity influence efforts for action,
   and therefore change, despite the methodological strength of applied
   research approaches.
   Shifting the approach to sustainable community development and focusing
   more on addressing the contextual factors in a study setting could
   increase likelihood of successfully transforming knowledge to action.
   The ability to predict whether efforts are likely to result in
   participatory action and, as a result, positive change in communities
   will help to better direct limited resources; and importantly, provide
   insights into why so many development efforts fail to achieve lasting
   and sustainable change in communities.},
