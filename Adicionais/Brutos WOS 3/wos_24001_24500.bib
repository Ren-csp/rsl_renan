Author = {Ribeiro, Sanzia Bezerra and Freitas Martins, Klerisson Lucas and Silva,
   Lucas Alves and de Almeida, Eliana do Sacramento and Lacerda, Flavia
   Karine Leal and Becerra de Oliveira, Lilian Anabel and de Sousa,
   Anderson Reis and Ferreira, Silvia Lucia},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Impact of the Covid-19 Pandemic on the Health and Working Conditions of
   People with Sickle Cell Disease},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 5, IEA 2024},
