@inproceedings{ WOS:000339531800126,
Author = {Zhang, Fang and Feng, Xiaoqiang and Xiao, Yunfei},
Editor = {Xu, Q and Li, Y and Yang, X},
Title = {Energy-saving Blast Dehumidification System for Blast Furnace},
Booktitle = {ENERGY DEVELOPMENT, PTS 1-4},
Series = {Advanced Materials Research},
Year = {2014},
Volume = {860-863},
Pages = {686+},
Note = {3rd International Conference on Energy, Environment and Sustainable
   Development (EESD 2013), Shanghai, PEOPLES R CHINA, NOV 12-13, 2013},
Organization = {Shanghai Univ Elect Power; Shanghai Normal Univ},
Abstract = {Blast furnace in steel industry consumes about 9\% of annual energy
   consumption of domestic industry. Blast dehumidification is an important
   way to increase production and decrease coke ratio of blast furnace. The
   energy-saving blast dehumidification system uses heat pipe for air
   pre-cooling and re-heating before and after dehumidification. Because
   temperature of air has been decreased to a certain extent by
   pre-cooling, dehumidification energy consumption could be decreased.
   After dehumidification, temperature of the air could be increased by
   re-heating, thus the threshold temperature of the air sent into hot
   blast stove could also be increased, it would save energy and increase
   production of blast furnace. But this system has an extra heat pipe heat
