@article{ WOS:000431770900101,
Author = {Ernawati, Ni Made and Murni, Ni Gst Nym Suci and Jendra, Wayan},
Title = {Negotiating Between Authenticity and Change in Community-Based Tourism:
   Evidence from Bali},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {12},
Pages = {12109-12115},
Month = {DEC},
Note = {1st International Joint Conference on Science and Technology (IJCST),
   Bali, INDONESIA, OCT 12-13, 2016},
Organization = {Univ Pembangunan Nas Veteran Jawa Timur, Fac Ind Technol; Bali State
   Polytechn; Natl Cheng Kung Univ; Univ Negeri Surabaya, Fac Social Sci \&
   Law; Univ Negeri Surabaya, Fac Math \& Nat Sci; Univ Trunojoyo Madura,
   Fac Engn},
Abstract = {This research aims to analyse the aspects of authenticity and change, a
   context of CBT products in Bali, Indonesia. It is a qualitative study
   that examines hosts' and tourists' opinions and perceptions on
   authenticity related to CBT experiences, using focus group discussion
   and in-depth interview. The results of the study show that native
   culture being used as CBT attraction per-se is not a threat to its
   ethnicity, nurture instead. However, host's misunderstanding of CBT
   visitors' expectation, tourists' need for better facilities and
   amenities, as well as community's change due to a better economic
   condition could become sources of threat to ethnicity. The study results
   also reveal that CBT communities are aware that authenticity is
   important for the sustainability of local communities, and change which
   is regarded as culprit to authenticity is required for community's
   survival. Further, this study posits areas required to be preserved and
   developed related to CBT development and suggests hosts and guests opt
   for `existential authenticity' to mediate the issues of authenticity and
   change for a successful CBT, the sustainability of the host-community,
   and tourists' satisfaction.},
