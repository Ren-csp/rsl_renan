Title = {GIS-based spatio-temporal analysis on Yellow Fin Tuna catch in Eastern
   Indian Ocean off Sumatera},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON MARINE SCIENCE (ICMS) 2019 - TOWARDS
   SUSTAINABLE MARINE RESOURCES AND ENVIRONMENT},
