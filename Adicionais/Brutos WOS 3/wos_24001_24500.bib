@article{ WOS:000283453400006,
Author = {Breton, Audrey and Vialle, Claire and Montrejaud-Vignoles, Mireille and
   Cecutti, Christine and Vignoles, Christian and Sablayrolles, Caroline},
Title = {CONTRIBUTION OF CAR, TRUCK, BUS AND SUBWAY WASH STATION DISCHARGES TO
   STORMWATER POLLUTION (TOULOUSE, FRANCE)},
Journal = {FRESENIUS ENVIRONMENTAL BULLETIN},
Year = {2010},
Volume = {19},
Number = {9A},
