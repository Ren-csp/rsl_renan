@inproceedings{ WOS:000184993400018,
Author = {Röhrbein, F and Schill, K and Baier, V and Stein, K and Zetzsche, C and
   Brauer, W},
Editor = {Freksa, C and Brauer, W and Habel, C and Wender, KF},
Title = {Motion shapes: Empirical studies and neural modeling},
Booktitle = {SPATIAL COGNITION III},
