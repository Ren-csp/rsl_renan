@inproceedings{ WOS:000078706300127,
Author = {Fukushima, T and Hashimoto, I},
Editor = {Hashimoto, I and Kakigi, R},
Title = {Neuromagnetic study of bimodal auditory and somatosensory interaction},
Booktitle = {RECENT ADVANCES IN HUMAN NEUROPHYSIOLOGY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1998},
Volume = {1162},
Pages = {862-865},
Note = {6th International Evoked Potentials Symposium (6th IEPS), OKAZAKI,
   JAPAN, MAR 21-25, 1998},
Organization = {Minist Educ Sci Culture \& Sports Japan; Okazaki Natl Res Inst; Natl
   Inst Physiol Sci; Pharmaceut Manufacturers Assoc Tokyo; Osaka Pharmaceut
   Manufacturers Assoc},
Abstract = {To clarify interaction in an early stage of sensory perception, dual
   auditory and somatosensory stimuli were used. Click sound (0.2 ms, 60 dB
   SL) to the right ear prior to somatosensory electric stimulation of the
   median nerve (0.2 ms, twitching threshold) at the right wrist were given
   to 12 healthy subjects with variable intervals of 0, 50, 100, 150, 200
   and 300 ms.
   Somatosensory evoked fields (SEFs) with single somatosensory stimulation
   were recorded to compare with SEFs in each dual stimulus session. The
   components of SEFs changed dynamically in all sessions of the dual
   asynchronous stimuli in comparison with synchronous dual stimuli. SEFs
   were suppressed significantly in amplitudes under the conditions of 200
   ms in 4M, 50 and 150 ms in 5M. 1M and 5M showed amplitude increase in
   the dual stimulus condition. Equivalent current dipoles (ECD) of 1M, 2M
   and 3M were located in the primary somatosensory cortex (SI), ECDs of 4M
   and 5M were situated in the vicinity of the secondary somatosensory
   cortex (SII). During dual stimuli, ECDs of 4M, 5M and ipsilateral 4M
   tended to shift mainly around SII. The mechanism of SEF suppression may
   be related to gating control by attentional system.},
