@article{ WOS:000444975300149,
Author = {Musa, Muhammad Aminu and Muhammad, Salihu Murtala and Garba, Aliyu
   Ibrahim and Musa, Mohammed Mukhtar},
Title = {Bauhaus Training and Experience: Lesson to Learn for Emerging Schools of
   Architecture},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3725-3732},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {Emerging Schools of Architecture particularly in Nigeria is faced with
   copious problems, especially quality of their graduates when match to
   their counter parts of the world. The obvious is when the lists of
   architects in ``who is who{''} of any international organization is
   checked, like that of International Biographical Centre Cambridge,
   England and the rest. It will be noticed that, only a small fraction of
   the world's famous architects is the products of emerging schools of
   architecture. There is hardly any of Nigerian products that designed a
   world's iconic structure as one can see in Bauhaus', which were the
   movers and shakers of architecture of their time as their influences is
   still manifested in today's Architecture. The aim of this research is to
   study Bauhaus training and experience: lesson to learn for Emerging
   schools of architecture, Using Nigerian's schools of Architecture as
   case study. This was done by way of comparative study of Bauhaus and
   Nigerian schools of architecture by; identifying their principles,
   admission requirements, curricula, and methods of instructions; also by
   finding the contributions of these schools to the field of Architecture;
   and exposing the quality of their products in then and today's
   Architecture. In conducting this research, an intensive literature
   review was conducted from published and unpublished materials: books,
   journals, thesis and internet (references of past works) were selected
   and reviewed. An aggregate of a hundred and fifty (150) feedback form
   were administered to the final year architecture students, M.Sc.
   Students as well as lecturers in Nigerian schools of Architecture, using
   the purposive sampling method. One hundred and six (106) questionnaires
   were returned completed, representing a 70.7\% response rate. The
   results include: most emerging schools of Architecture are in wrong
   locations; aims of emerging schools of Architecture like are always
   given in general terms, instead of specific; Subjects for creativity
   (such as Technical drawing and Fine art) are clearly absent in the
   admission criteria of most developing schools of architecture. Schools
   of Architecture should be located in major cities not semi urban or
   villages. The need to engage world's renowned architects as full time
   and visiting professors is required, so as to produce better architects.},
