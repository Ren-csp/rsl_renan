@inproceedings{ WOS:000288140200090,
Author = {Ye, Weibing and Yang, Fangfang},
Editor = {Zou, YL and Jiang, Y and Zhang, JG and Chen, JQ},
Title = {The Body Image and its Gender Difference of Undergraduates},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 2},
Year = {2010},
Pages = {377-380},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {To investigate the body image and correlative cognition and behavior
   characters of undergraduates in Zhejiang Normal University, P.R.China,
   the Multidimensional Body-Self Relation Questionnaire and Figural
   Stimuli were administered to 240 students aged 18-24 years. The main
   results are shown as followed: (1) 84.26\% subjects hope for taller body
   height, and there are no gender differences on this factor. (2) 57.55\%
   male subjects hope to increase their body weight, 80.77\% female
   subjects hope to reduce their body weight,, the gender differences are
   significant; (3) The actual BMI of male subjects are significantly
   higher than females, but self-perception body size are significantly
   lower than females; (4) Appearance evaluation refers to the individuals
   assess themselves body appearance, Appearance orientation is a measure
   of the importance individuals places in appearance, these two values are
   obtained basing on the related items of MBSRQ. The Appearance
   orientation of female subjects are significantly high than males, and
   there are no gender differences on body dissatisfaction and Appearance
   evaluation; (5) The ideal male body size has no significant difference
   between male and female subjects, but the ideal female body size on the
   male students are significantly fatter than female students. This study
   also made some recommendations about health education and physical
   education on body image.},
