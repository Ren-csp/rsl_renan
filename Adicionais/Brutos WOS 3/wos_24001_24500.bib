Title = {Psychological and ethical issues in genetic testing},
Booktitle = {CUTTING EDGE MEDICINE AND LIAISON PSYCHIATRY: PSYCHIATRIC PROBLEMS OF
   ORGAN TRANSPLANTATION, CANCER, HIV/AIDS AND GENETIC THERAPY},
