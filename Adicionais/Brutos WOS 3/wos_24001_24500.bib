@inproceedings{ WOS:000392856300111,
Author = {Siemens, Kimberly O. and Loucks, Eric D. and Kase, Sydney J. and Heinz,
   Steven R.},
Editor = {Karvazy, K and Webster, VL},
Title = {Spatial Variability of Rainfall in the Milwaukee Wisconsin Area},
Booktitle = {World Environmental and Water Resources Congress 2015: Floods, Droughts,
   and Ecosystems},
Year = {2015},
Pages = {1128-1134},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {For many years, the perception has existed that Lake Michigan exerts a
   micro-climatological influence on rainfall in the Milwaukee area. In
   this paper we use historical rainfall data from a local 20-gauge network
   to assess the geographic behavior of rainfall in the region. In
   particular, observers have noted that rainfall in major storms tends to
   be heavier some distance, usually 8 km or more, away from the lakefront.
   Our examination of annual rainfall between 2007 and 2013 indicates that
   in 5 of 7 years, rainfall was generally greater away from the lake than
   it was adjacent to the lake; however, analysis of twelve extreme storms
   between 1997 and 2013 does not show such a compelling bias. The
   individual storm data is split evenly between storms that are heaviest
   near the lake and those heaviest inland thus contradicting conventional
   wisdom. The paper presents various spatial statistical analyses using
   the dense gauge network to draw conclusions that may be applicable to
   the operation and management of stormwater systems in the area,
   including how real-time gauge data can be used to forecast short-term
   rainfall as it moves through the area.},
