@inproceedings{ WOS:A1996BH23U00051,
Author = {Tungittiplakorn, W and Bengtsson, BE},
Editor = {Edwards, DS and Booth, WE and Choy, SC},
Title = {A conflict over natural resources between highland and lowland
   populations in Thailand},
