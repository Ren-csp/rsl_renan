@inproceedings{ WOS:000664205600110,
Author = {Daskalova, Mina and Ivanova, Desislava},
Editor = {Pasheva, V and Popivanov, N and Venkov, G},
Title = {Interaction between Management Control Systems and Big Data Analytics: A
   Conceptual Framework},
Booktitle = {APPLICATIONS OF MATHEMATICS IN ENGINEERING AND ECONOMICS (AMEE20)},
Series = {AIP Conference Proceedings},
Year = {2021},
Volume = {2333},
Note = {46th International Conference on Applications of Mathematics in
   Engineering and Economics (AMEE), ELECTR NETWORK, JUN 07-13, 2020},
Organization = {Tech Univ Sofia, Fac Appl Math \& Informat, Res \& Dev Sect; Sofia Univ
   St Kliment Ohridski, Fac Math \& Informat},
Abstract = {This paper aims to suggest a conceptual framework of the interaction
   between Management Control Systems (MCS) and Big Data Analytics (BDA),
   since MCS can be considered as the formal, information-based routines
   and procedures managers use to maintain or alter patterns in
   organizational activities. Developed as a theoretical framework, it
   could contribute to understanding of how BDA capabilities, which are one
   of the most important factors for successful strategy implementation,
   could influence MCS hi order to achieve the strategic goals of the
   company. For the purposes of the conceptual framework development the
   Simons' Levers of Control framework is used. It is considered as
   appropriate since it combines a focus on the achievement of the
   strategic goals of the organization with the broader perception of the
   control mechanisms that can be used for effective and efficient
   implementation of the strategy. The proposed framework can be considered
   as a contribution to the effective strategy implementation due to the
   fact that it provides the opportunity to define how BDA interacts and
   affects the fourth Levers of Control. Thus, by integrating BDA
   capabilities in the above mentioned levers, better control on effective
   business strategy implementation and performance can be achieved.},
