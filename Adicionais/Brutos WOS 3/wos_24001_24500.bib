@inproceedings{ WOS:000235917500007,
Author = {Van Ginkel, R},
Editor = {Gray, TS},
Title = {Between top-down and bottom-up governance: Dutch beam trawl fishermen's
   engagement with fisheries management},
Booktitle = {Participation in Fisheries Governance},
