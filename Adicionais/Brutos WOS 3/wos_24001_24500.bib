@inproceedings{ WOS:000239950800004,
Author = {Andronopoulos, S. and Sfetsos, A. and Bartzis, J. G. and Gounaris, N.},
Editor = {Lekkas, TD},
Title = {Application of the model ADREA-I to the ESCOMPTE pre-campaign case},
Booktitle = {Proceedings of the 8th International Conference on Environmental Science
   and Technology, Vol A, Oral Presentations},
