@inproceedings{ WOS:000075917700119,
Author = {Martin, B and Rempel, D and Sudarsan, P and Dennerlein, J and Jacobson,
   M and Gerard, M and Armstrong, T},
Editor = {Kumar, S},
Title = {Reliability and sensitivity of methods to quantify muscle load during
   keyboard work},
Booktitle = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY, VOL 2},
Series = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Year = {1998},
Volume = {2},
Pages = {495-498},
Note = {XIIIth Annual International Occupational Ergonomics and Safety
   Conference, YPSILANTI, MI, JUN 11-14, 1998},
Abstract = {The goal of this work is to determine the variability, reliability and
   sensitivity of objective and subjective measures used to assess forearm
   muscle load during keyboard use. Muscle load at this site is an
   important issue in VDT work since sustained exertions in excess of 10\%
   and up to 20\% of the maximal finger strength are observed in keyboard
   work, and tills region of the body is associated with musculoskeletal
   disorders in typists. The forearm muscle load involved in typing tasks
   is evaluated in 20 young heathy ``touch typists{''}. The task consists
   of typing a text displayed in the window on a computer screen at an
   imposed speed (80, 90, 95 \% of the maximum speed). Typing speed is
   controlled by text scrolling speed;and the motion of a cursor moving
   horizontally at the bottom of the window, The key actuation force is 0.6
   N. Four methods designed to quantify the muscle load are compared. 1)
   intra-muscular electromyograms (EMG), recorded by electrodes inserted in
   individual muscles; 2) surface EMG, recorded by electrodes placed on the
   skin over the muscles; 3) keyboard reaction force, measured by load
   cells placed under the keyboard; 4) perception of effort and discomfort,
   using visual analog scales. For each participant, wrist muscles
   (extensor carpi radialis - ECR, extensor carpi ulnaris - ECU, flexor
   carpi radialis - FCR flexor carpi ulnaris - FCU) and finger muscles
   (extensor indicis proprius -EIP, extensor digitorum communis - EDC,
   flexor digitorum superficialis - FDS, flexor digitorum profundus - FDP),
   are recorded on two nonconsecutive days while repeating the same
   experimental protocol. The relationship between indwelling and surface
   EMGs are investigated as a function of EMG parameters (peak and
   amplitude probability distribution) and cross correlation. Relationships
   between EMGs key reaction force and load perception are also
   investigated. The results can be summarized as follow: a) the agreement
   between intra-muscular EMGs and surface EMGs, evaluated by amplitude
   probability distribution frequency (APDF) curves and cross-correlation,
   is good for the EIP, EDC, ECU, FCU and FCR muscles; b) the FCU and ECU
   can be considered as prime movers in typing tasks (at least in die
   context of standard flat keyboards) while the index FDP plays a
   negligible role; c) die ECU, EDC, EIP and FDS have a high tonic activity
   suggesting a contribution to joint stabilization and anti-gravity, d)
   muscle load is about two times higher in the extensors than the flexors,
   and extensor load is high when considering the duration and
   repetitiveness of typing tasks; e) a tonic activity is present in all
   muscles and the dynamic activity is greater than 20\%MVC for most
   muscles; f) muscle load increases linearly with typing speed for most
   muscles.},
Publisher = {I O S PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
