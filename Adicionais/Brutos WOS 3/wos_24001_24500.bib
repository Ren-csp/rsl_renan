@article{ WOS:000174246000006,
Author = {Molini, A and La Barbera, P and Lanza, LG},
Title = {On the properties of stochastic intermittency in rainfall processes},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {45},
