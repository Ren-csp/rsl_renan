@inproceedings{ WOS:000084261200050,
Author = {Eckel, RH},
Editor = {GuyGrand, B},
Title = {Substrate trafficking and the regulation of adipose mass},
Booktitle = {PROGRESS IN OBESITY RESEARCH: 8},
