Title = {A LIGHTWEIGHT CONVOLUTIONAL NEURAL NETWORK FOR BITEMPORAL IMAGE CHANGE
   DETECTION},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
