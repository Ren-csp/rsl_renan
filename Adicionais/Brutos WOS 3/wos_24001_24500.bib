@inproceedings{ WOS:000379410300039,
Author = {Kaprova, Katerina},
Editor = {Fialova, J and Pernicova, D},
Title = {PRECISION OF TRAVEL COST MEASURES IN ESTIMATION THE RECREATION DEMAND:
   THE CASE OF SUMAVA NATIONAL PARK},
Booktitle = {PUBLIC RECREATION AND LANDSCAPE PROTECTION - WITH MAN HAND IN HAND!, PTS
   1 AND 2},
Series = {Public Recreation and Landscape Protection},
Year = {2015},
