@inproceedings{ WOS:000075685700024,
Author = {Araujo, R and Nunes, U and de Almeida, AT},
Editor = {Dubois, DM},
Title = {Connectionist reinforcement learning of robot control skills},
Booktitle = {COMPUTING ANTICIPATORY SYSTEMS: CASYS - FIRST INTERNATIONAL CONFERENCE},
