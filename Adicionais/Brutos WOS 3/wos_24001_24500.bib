@article{ WOS:000177396600009,
Author = {Perea, M and Rosa, E},
Title = {Does ``whole-word shape{''} play a role in visual word recognition?},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2002},
Volume = {64},
Number = {5},
Pages = {785-794},
Month = {JUL},
Note = {40th Annual Meeting of the Psychonomic-Society, LOS ANGELES, CALIFORNIA,
   NOV, 1999},
Organization = {Psychon Soc},
Abstract = {To analyze the impact of outline shape on visual word recognition, the
   visual pattern of the stimuli can be distorted by size alternation.
   Contrary to the predictions of models that rely on outline shape (Allen,
   Wallace, \& Weber, 1995), the effect of size alternation was greater for
   low-frequency words than for high-frequency words in a lexical decision
   task (Experiment 1). In Experiment 2, the effect of case type (lowercase
   vs. UPPERCASE) occurred for low-frequency words, but not for
   high-frequency words. The effect of neighborhood size was remarkably
   similar in the two experiments. The results can be readily explained in
   the framework of a resonance model (Grossberg \& Stone, 1986), in which
   a mismatch between the original sensory pattern and the abstract
   orthographic code slows down the formation of a stable percept.},
Publisher = {PSYCHONOMIC SOC INC},
Address = {1710 FORTVIEW RD, AUSTIN, TX 78704 USA},
