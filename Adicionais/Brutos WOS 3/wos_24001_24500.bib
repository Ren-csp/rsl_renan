@article{ WOS:000186743000027,
Author = {Levine, RA and Abel, M and Cheng, H},
Title = {CNS somatosensory-auditory interactions elicit or modulate tinnitus},
Journal = {EXPERIMENTAL BRAIN RESEARCH},
Year = {2003},
Volume = {153},
Number = {4},
Pages = {643-648},
