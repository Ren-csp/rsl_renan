@inproceedings{ WOS:000287981100040,
Author = {Oliveira, F. and Pintassilgo, P. and Mendes, I. and Silva, J. A.},
Editor = {Brebbia, CA and Pineda, FD},
Title = {Planning forest recreation: environmental economic instruments and the
   public participation},
Booktitle = {SUSTAINABLE TOURISM IV},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2010},
Volume = {139},
