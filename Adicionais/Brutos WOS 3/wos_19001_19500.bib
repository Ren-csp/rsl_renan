@inproceedings{ WOS:001286424400020,
Author = {Li, Linghong},
Editor = {Schmorrow, DD and Fidopiastis, CM},
Title = {The Impact of Auditory Based Immersive Virtual Travel Experience on
   Mental Health of the Visually Impaired},
Booktitle = {AUGMENTED COGNITION, AC 2021},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2021},
Volume = {12776},
Pages = {277-287},
Note = {15th International Conference on Augmented Cognition (AC) Held as Part
   of the 23rd International Conference on Human-Computer Interaction
   (HCII), ELECTR NETWORK, JUL 24-29, 2021},
Abstract = {There are extremely limited chances for the visually impaired go travel
   in China due to lack of effective public facilities and services for the
   disabled. According to statistics, there are up to 30\% of visually
   impaired population in China never go outdoors per year. Depressed
   emotions are raging along with different degrees of mental health
   problems. Virtual reality systems have potential to provide users with
   an engaging and realistic valid environment in which to get an
   experience similar to activities in the real world. The purposes of this
   study were to (1) determine the feasibility in using auditory based
   immersive virtual travel in individuals with the visually impaired, and
   (2) evaluate the impact of the auditory based immersive virtual travel
   experience on mental health of the visually impaired. To that end, a
   novel VR task, the auditory based Immersive Virtual Reality of travel
   would be used as one treatment of mental health problems of the visually
   impaired.},
