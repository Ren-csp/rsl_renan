@article{ WOS:A1991FF35800017,
Author = {PIO, CA and SANTOS, IM and ANACLETO, TD and NUNES, TV and LEAL, RM},
Title = {PARTICULATE AND GASEOUS AIR POLLUTANT LEVELS AT THE PORTUGUESE
   WEST-COAST},
Journal = {ATMOSPHERIC ENVIRONMENT PART A-GENERAL TOPICS},
Year = {1991},
Volume = {25},
Number = {3-4},
