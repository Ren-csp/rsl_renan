@inproceedings{ WOS:000291664400057,
Author = {Fuchs, B.},
Editor = {Amoeda, R and Lira, S and Pinheiro, C},
Title = {Preserving the unsustainable sustainably - historic town planning and
   current planning issues in the World Heritage area of the Semmering
   railway exemplified by Reichenau an der Rax},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {507-514},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Fullservice Co; Viagens Abreu},
Abstract = {In the middle of the 19(th) century the construction of the Semmering
   Railway in Austria made areas of natural beauty more easily accessible.
   This triggered the development of residential and recreational use in
   alpine and rural areas, creating a new form of cultural landscape and
   towns. New towns and villages were built from scratch for the sole
   purpose of recreation. Reichenau an der Rax stands for several small
   villages in this area which were developed into health and summer
   ({''}Sommerfrische{''}) resorts during the late nineteenth century.
   Austrian architects and entrepreneurs designed leafy, generously laid
   out towns in Semmering area. The designs aimed to attract wealthy city
   people and nobility and were hardly based on sustainable criteria but
   often provided usable open space patterns. The two World Wars stopped
   the further development of these summer resorts. Post-war town planning
   dismissed the luxurious plans and turned to more affordable concepts
   focusing on providing housing for the local community or on building
   modern recreational infrastructure. They often relied on the high
   quality of the historic open space structures but at the same time
   destroyed them in parts. Post-war and current town planning had and
   still has to deal with issues resulting from the unsustainable approach
   in the nineteenth century. This paper will focus on the question if and
   how planning authorities mastered and are mastering the balancing act
   between preserving the historic areas of the summer resorts and
   developing it sustainably based on modern criteria. The importance of
   land use and town planning instruments in terms of the preservation of
   historic towns and villages will be analysed and lessons learned from
   these examples will be presented.},
Publisher = {GREEN LINES INST SUSTAINABLE DEVELOPMENT},
Address = {AV ALCAIDES DE FARIA 377 S 12, BARCELOS, 00000, PORTUGAL},
Type = {Proceedings Paper},
Language = {English},
