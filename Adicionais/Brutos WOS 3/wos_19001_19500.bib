@article{ WOS:000283979900009,
Author = {Skrbic, Biljana and Szyrwinska, Katarzyna and Durisic-Mladenovic, Natasa
   and Nowicki, Piotr and Lulek, Janina},
Title = {Principal component analysis of indicator PCB profiles in breast milk
   from Poland},
