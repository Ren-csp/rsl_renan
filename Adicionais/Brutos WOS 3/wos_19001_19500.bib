@article{ WOS:000417682400013,
Author = {River, Mark and Richardson, Curtis J.},
Title = {Particle size distribution predicts particulate phosphorus removal},
Journal = {AMBIO},
Year = {2018},
Volume = {47},
Number = {1, SI},
Pages = {124-133},
Month = {JAN},
Note = {8th International Phosphorus Workshop (IPW), Rostock, GERMANY, SEP
   12-16, 2016},
Abstract = {Particulate phosphorus (PP) is often the largest component of the total
   phosphorus (P) load in stormwater. Fine-resolution measurement of
   particle sizes allows us to investigate the mechanisms behind the
   removal of PP in stormwater wetlands, since the diameter of particles
   influences the settling velocity and the amount of sorbed P on a
   particle. In this paper, we present a novel method to estimate PP, where
   we measure and count individual particles in stormwater and use the
   total surface area as a proxy for PP. Our results show a strong
   relationship between total particle surface area and PP, which we use to
   put forth a simple mechanistic model of PP removal via gravitational
   settling of individual mineral particles, based on a continuous particle
   size distribution. This information can help improve the design of
   stormwater Best management practices to reduce PP loading in both urban
   and agricultural watersheds.},
