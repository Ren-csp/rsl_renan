Title = {Study of metals in leached soils of a municipal dumpsite in Tampico,
   Tamaulipas, Mexico:: preliminary results},
Booktitle = {ENVIRONMENTAL TOXICOLOGY},
Series = {WIT Transactions on Biomedicine and Health},
