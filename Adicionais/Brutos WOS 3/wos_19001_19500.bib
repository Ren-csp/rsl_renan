Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {Urban and agricultural development in the past 200 years in New South
   Wales (NSW), Australia, has resulted in loss of the original native
   bushland, leaving only scattered remnants of vegetation of natural
   heritage significance. To conserve biological diversity and promote
   ecologically sustainable development, the NSW Threatened Species
   Conservation Act was introduced in 1995. The NSW Scientific Committee
   has now listed over 90 endangered ecological communities. The NSW Native
   Vegetation Act 2003 regulating clearing of remnant vegetation in rural
   areas; and the Threatened Species Legislation Amendment Act 2004 listing
   ``Key Threatening Processes{''} of native vegetation were subsequently
   introduced. Using two case studies, this paper illustrates how the legal
   recognition of natural heritage of the remnant vegetation has
   contributed to improved sustainable outcomes.},
