@article{ WOS:A1994PQ56900006,
Author = {DOWD, ET and WALLBROWN, F and SANDERS, D and YESENOSKY, JM},
Title = {PSYCHOLOGICAL REACTANCE AND ITS RELATIONSHIP TO NORMAL
   PERSONALITY-VARIABLES},
