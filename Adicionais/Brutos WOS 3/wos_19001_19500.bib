@article{ WOS:000167199000021,
Author = {Owens, PN and Walling, DE and Carton, J and Meharg, AA and Wright, J and
   Leeks, GJL},
Title = {Downstream changes in the transport and storage of sediment-associated
   contaminants (P, Cr and PCBs) in agricultural and industrialized
   drainage basins},
