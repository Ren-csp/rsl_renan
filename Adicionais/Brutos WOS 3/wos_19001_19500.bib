@article{ WOS:000365243500078,
Author = {Ong, Ker Hsin and Teh, Sin Yin and Soh, Keng Lin and Teoh, Wei Lin},
Title = {A Case Study on ISO 9001 Certification for an Automotive Company in
   Malaysia},
