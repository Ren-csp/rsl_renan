   Zayyanu, Muhammad; Zungwenen, Utange J.; Siddiq, Usman A., Univ Teknol Malaysia, Fac Built Environm, Dept Urban \& Reg Planning, Johor Baharu 81310, Johor, Malaysia.
   Johar, Foziah, Univ Teknol Malaysia, Fac Built Environm, Ctr Innovat Planning \& Dev, Johor Baharu 81310, Malaysia.},
DOI = {10.1166/asl.2017.9205},
ISSN = {1936-6612},
EISSN = {1936-7317},
Keywords = {Sustainability; Community-Based Development Projects; Poverty Reduction;
