@inproceedings{ WOS:000080267100022,
Author = {Mitschein, TA and Miranda, PS},
Editor = {Leihner, DE and Mitschein, TA},
Title = {POEMA: A proposal for sustainable development in Amazonia},
Booktitle = {THIRD MILLENNIUM FOR HUMANITY?: THE SEARCH FOR PATHS OF SUSTAINABLE
   DEVELOPMENT},
Year = {1998},
Pages = {329-366},
Note = {Forum Belem I on a 3rd Millennium for Humanity - The Search for Paths of
   Sustainable Development, BELEM DO PARA, BRAZIL, NOV 26-29, 1996},
Abstract = {The living conditions of the majority of the Amazonian population are
   sharply contrasted by the natural wealth of this region. The state of
   poverty is characterised by severe nutritional deficiencies, absence of
   basic needs such as safe drinking water, sanitation, education and
   health, and low levels of income. The precarious survival situation of
   both the rural and urban poor leads to a strong human impact on the
   natural resources of the Amazon region. A protection of Amazonian
   ecosystems is only possible when strategies are elaborated which
   substantially improve the living conditions of the poor classes. This is
   the background of the programme Poverty and Environment in Amazonia
   (POEMA), initiated by an interdisciplinary research group of the Federal
   University of Pari at Belem, Brazil. In an integrated and participatory
   approach, POEMA elaborated activities in various sectors such as basic
   sanitation, health and education, agroforestry, renewable energy,
   processing of non-timber forest products and advisory support.
   Activities were started in close co-operation with several pilot
   communities throughout Para at municipal level. The main focus was set
   on basic sanitation and development of a sustainable land use system,
   based on agroforestry (multi-storey agriculture). Also value-adding and
   processing of raw materials was considered. All activities were
   evaluated by the participating communities and thus adapted to the local
   needs. Meanwhile, an infrastructure for supplying water treatment kits
   and processing of non-timber forest products for industrial use is
   established. POEMA nevertheless gives only a glimpse of hope for the
   survival of Amazonian ecosystems. There is still a lack of political
   decisions for appropriate and well-defined investments which enable
   actors to take advantage of a sustainable use of the region's
   biodiversity.},
Publisher = {PETER LANG PUBLISHING INC},
