@inproceedings{ WOS:000300440500386,
Author = {Grigore, Vasilica and Sandulache, Stefan},
Editor = {Ongen, DE and Hursen, C and Halat, M and Boz, H},
Title = {The impact of ambidextrous training on junior basketball players},
Booktitle = {2ND WORLD CONFERENCE ON PSYCHOLOGY, COUNSELLING AND GUIDANCE-2011},
Series = {Procedia Social and Behavioral Sciences},
Year = {2011},
Volume = {30},
Note = {2nd World Conference on Psychology, Counselling and Guidance (WCPCG),
   Antalya, TURKEY, MAY 25-29, 2011},
Abstract = {The current context, the desire to obtain superior sports performance,
   seeking public and private support for the specific activities led to
   significant reorientation of the whole training process for the Romanian
   basketball teams {[}1, 2]. An important aspect of the new vision refers
   to the ambidextrous training. Our opinion is that the good ambidextrous
   level, as a result of its involvement in the training sessions with
   special tasks, emphasizes the psychomotor skills of the players, linked
   to the requirements of both individual and team performance.
   This paper is a study concerning the impact of ambidextrous training
   program on junior basketball players. The main research method was the
   inquiry through questionnaires, items aimed at obtaining information on
   the ambidextrous program related to the psychological and social
   benefits and the target group's opinion concerning these aspects, the
   perception of the relationship between them and the satisfaction level
   induced by the training program described in relation with the future
   work as well. The results show a positive attitude towards the applied
   program, the players' ability of perception, good competence,
   self-evaluation and a positive influence on their psyche. (C) 2011
   Published by Elsevier Ltd. Selection and/or peer-review under
   responsibility of the 2nd World Conference on Psychology, Counselling
   and Guidance.},
