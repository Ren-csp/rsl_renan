@article{ WOS:A1991GX30000021,
Author = {HOWE, N},
Title = {SIBLING-DIRECTED INTERNAL STATE LANGUAGE, PERSPECTIVE TAKING, AND
   AFFECTIVE BEHAVIOR},
Journal = {CHILD DEVELOPMENT},
