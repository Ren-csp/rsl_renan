@inproceedings{ WOS:001285657000034,
Author = {Dong, Xiaowan and Bi, Qingyang and Chen, Dong and Cheng, Lihua},
Editor = {Mannina, G and Ng, HY},
Title = {Removal of Selected PPCPs and Associated Bacterial Community Variations
   in a Pilot Scale A/O-MBBR Reactor System},
Booktitle = {FRONTIERS IN MEMBRANE TECHNOLOGY, IWA-RMTC 2024},
