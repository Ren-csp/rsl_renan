Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {Building upon previous research that evaluates the factorial invariance
   of the technology acceptance model (TAM), this paper assesses the
   structural invariance of model parameters. While previous research
   indicates that the measurement aspects of TAM are relatively invariant,
   the predictive coefficients of the model are not invariant. The value of
   TAM is not questioned, but this research demonstrates that some caution
   is warranted when using the model to predict perceptions of future
   usage.},
