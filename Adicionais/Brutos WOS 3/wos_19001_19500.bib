@article{ WOS:A1991GP12100009,
Author = {HUNT, A and JOHNSON, DL and THORNTON, I},
Title = {DESCRIPTIVE APPORTIONMENT OF LEAD IN HOUSEDUST BY AUTOMATED SEM},
Journal = {WATER AIR AND SOIL POLLUTION},
Year = {1991},
Volume = {57-8},
Pages = {69-77},
Month = {AUG},
Note = {INTERNATIONAL CONF ON METALS IN SOILS, WATERS, PLANTS AND ANIMALS,
   ORLANDO, FL, APR 30-MAY 03, 1990},
Organization = {US DOE, SAVANNAH RIV OPERAT OFF},
Abstract = {Quantifying sources of aerosol derived materials is an important task in
   environmental pollution research.  Receptor modeling using automated
   scanning electron microscopy analyses of individual particles offers
   great potential for resolving such sources.  However, if a large number
   of distinctive particle categories can be defined, the need for
   mathematical models in separating the identities of potential sources
   might be obviated.  The results of developing such a set of categories
   for Pb-bearing particles is described here.  Example apportionments of
   Pb in housedust to illustrate the approach are presented.  Resolving the
   fractional contributions of such generic sources as automotive, paint,
   electrical, smelting/refining, urban soils, and road dusts appears to be
   possible with this technique.  A method for quantifying the
   uncertainties in the results is also described.},
