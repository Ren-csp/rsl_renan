@inproceedings{ WOS:000337300500140,
Author = {Chang, T. Y. and Huang, K. L. and Tung, F. W.},
Editor = {Meen, TH and Prior, SD and Lam, ADKT},
Title = {Enjoy aging: Blending cultural creativity with technology},
Booktitle = {INNOVATION, COMMUNICATION AND ENGINEERING},
Year = {2014},
Pages = {573-576},
Note = {2nd International Conference on Innovation, Communication and
   Engineering (ICICE), Qingdao, PEOPLES R CHINA, OCT 26-NOV 01, 2013},
Organization = {China Univ Petr; Taiwanese Inst Knowledge Innovat},
Abstract = {The health and medical care of the aged have recently received much
   attention because of the trends and challenges that face an aging
   society. This study involves elderly users of technology aged 65 and
   over. Beginning with the needs of the elderly, this study probes into
   the design process of cultural creativity in elderly care from the
   aspect of emotional demand, and investigates its possibility to be
   further developed. This study aims to realize the needs of the elderly
   in daily life by observing the elderly care field from different study
   areas such as psychology, physiology, and sociology. Moreover, this
   study uses the 4D method, namely, discover, define, develop, and
   deliver. Considering the divergence-convergence-divergence-convergence
   movement as creative thinking, this study is expected to develop
   products for elderly care by taking into account emotion attribution and
   a sense of company, and to construct an adoptable design process of
   cultural creativity that can be introduced in elderly care technology.},
