Title = {Integration of situated prior probability and neural network classifier
   in a handwriting recognition task},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {283-286},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {To achieve robust and flexible information processing ability, we study
   how contextual information can be used, in addition to direct
   observation. In order to deal with a concrete example, a handwriting
   character classification task is considered. We define the framework
   studied here as an integration of a situated prior probability and
   conventional classifier, feed-forward neural networks. The situated
   prior probability can be modeled by a conditional probability described
   on Bayesian network. The output of the classifier is proportional to
   likelihood of the input pattern. Then, the integration proposed in this
   paper can be interpreted as a posterior probability in Bayesian
   framework. We demonstrate an experiment about ambiguous handwriting
   character recognition. The result improves better classification
   performance than an ordinary neural network classifier.},
