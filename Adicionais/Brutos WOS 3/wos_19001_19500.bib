@inproceedings{ WOS:000082800000071,
Author = {Lee, S and Wysocki, D},
Editor = {Lee, GCH},
Title = {A study on perceptual responses to electrocutaneous stimulation for
   blind access to computers},
Booktitle = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Series = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Year = {1999},
Volume = {3},
Pages = {447-452},
Note = {XIVth Annual International Occupational Ergonomics and Safety Conference
   1999, ORLANDO, FL, JUN 06-09, 1999},
Abstract = {The goal of this study is to provide a blind access to computer systems
   with graphical user interfaces using the VideoTact electrocutaneous
   display, which was developed by Unitech Research, Inc. This research
   particularly aims at finding the best method to translate the Windows
   desktop, or some application-defined subset of desktop, into appropriate
   tactor parameters on a real-time basis. An experiment was conducted to
   examine the effect of tactor parameters: on human tactile perception.
   The electric waveforms driving the electrocutaneous stimulation to the
   tactors were controlled using the parameters of pulse amplitude, pulse
   width, inter-pulse delay, pulse numbers in a multiple pulse burst, and
   image frame rate. Five subjects responded with a forced-choice
   subjective description of how they feel on the abdomen to the
   stimulation. Among those parameters, the image Frame rate and pulse
   numbers consistently and significantly affected the subjective
   perception to tactile stimulation. It was concluded that to effectively
   use the electrocutaneous display on the abdomen to present several
   desktop images at a time, the best method would be to control these two
   parameters. Based on the result, we are currently developing a tactile
   user interface to simultaneously display two or more desktop elements of
   the Windows for blind people.},
