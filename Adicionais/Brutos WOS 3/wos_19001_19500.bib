Title = {Removal of ammonia and phosphate parameters from greywater using
   Vetiveria zizanioides in subsurface-constructed wetland},
Booktitle = {4TH ANNUAL APPLIED SCIENCE AND ENGINEERING CONFERENCE, 2019},
Series = {Journal of Physics Conference Series},
