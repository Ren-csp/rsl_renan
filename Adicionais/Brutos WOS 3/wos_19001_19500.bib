@inproceedings{ WOS:000073221600075,
Author = {Jankowski, J and Beck, P and Acworth, RI},
Editor = {Chilton, J},
Title = {Vertical heterogeneity in the Botany Sands aquifer, Sydney, Australia:
   Implications for chemical variations and contaminant plume delineation},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {445-450},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Recent studies in the Botany Sands aquifer, Sydney, have demonstrated
   that the aquifer, while homogenous and isotropic on a regional scale, is
   highly heterogeneous and anisotropic on the micro scale. Detailed
   hydrogeological and hydrochemical studies, supported by geological and
   geophysical data, have been carried out at an experimental site (7 m
   wide by 11 m long by 4 m saturated depth) and show that significant
   variation in both hydraulic conductivity and water chemistry is the
   result of changes in the depositional environment of the sediments. The
   hydraulic conductivity ranges between 2.1 x 10(-5) m/s and 5.8 x 10(-4)
   m/s. Groundwater chemical analyses at a depth of approximately 3.5 m
   below ground surface show high concentrations of HCO3-, Ca2+ and Sr2+
   which are considered to be due to dissolution of shell material. The
   same zone contains a significant proportion of clay material and both
   components are considered to be aeolian. Evaporative concentration is
   considered to occur in the unsaturated zone of the aquifer, increasing
   the concentration of Na+ and Cl- above that in rainwater. Downward
   percolating rainwater in a recharge event mobilises the concentrated
   pore fluid water and acts as an enhanced source of Nai in cation
   exchange reactions with the clay, thus releasing Ca2+. Mass balance
   modelling is used to demonstrate that dissolution of CaCO3, ion exchange
   and reverse ion exchange between Na+ and Ca2+, the flux of CO2 from the
   soil zone, and oxidation of pyrite are all important chemical reactions
   in this 4 m deep shallow section of aquifer.},
Publisher = {A A BALKEMA PUBLISHERS},
Address = {SCHIPHOLWEG 107C, PO BOX 447, 2316 XC LEIDEN, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Jankowski, J (Corresponding Author), Univ New S Wales, Groundwater Ctr, Dept Appl Geol, Sydney, NSW, Australia.
   Univ New S Wales, Groundwater Ctr, Dept Appl Geol, Sydney, NSW, Australia.},
