@inproceedings{ WOS:001428722200002,
Author = {Edwards, Justin and Clark, Leigh and Perrone, Allison},
Book-Group-Author = {ACM},
Title = {LGBTQ-AI? Exploring Expressions of Gender and Sexual Orientation in
   Chatbots},
Booktitle = {PROCEEDINGS OF THE 3RD CONFERENCE ON CONVERSATIONAL USER INTERFACES, CUI
   2021},
Year = {2021},
Note = {3rd Conference on Conversational User Interfaces, ELECTR NETWORK, JUL
   27-29, 2021},
Organization = {Swansea University; MCI Management Center Innsbruck - Internationale
   Hochschule GmbH},
Abstract = {Chatbots are popular machine partners for task-oriented and social
   interactions. Human-human computer-mediated communication research has
   explored how people express their gender and sexuality in online social
   interactions, but little is known about whether and in what way chatbots
   do the same. We conducted semi-structured interviews with 5 text-based
   conversational agents to explore this topic Through these interviews, we
   identified 6 common themes around the expression of gender and sexual
   identity: identity description, identity formation, peer acceptance,
   positive reflection, uncomfortable feelings and off-topic responses.
   Chatbots express gender and sexuality explicitly and through relation of
   experience and emotions, mimicking the human language on which they are
   trained. It is nevertheless evident that chatbots differ from human
   dialogue partners as they lack the flexibility and understanding enabled
   by lived human experience. While chatbots are proficient in using
   language to express identity, they also display a lack of authentic
   experiences of gender and sexuality.},
