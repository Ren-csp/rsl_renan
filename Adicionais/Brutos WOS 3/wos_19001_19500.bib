@inproceedings{ WOS:000722297300025,
Author = {Giuca, S. and De Leo, S.},
Editor = {Torquati, B and Marchini, A},
Title = {A web platform to incentive sustainable food production and responsible
   consumption},
Booktitle = {GREEN METAMORPHOSES: AGRICULTURE, FOOD, ECOLOGY},
Year = {2020},
Pages = {281-287},
Note = {55th Conference of the Italian-Association-of-Agricultural-Economics
   (SIDEA), Perugia, ITALY, SEP 13-15, 2018},
Organization = {Italian Assoc Agr Econ},
Abstract = {Many citizens, despite significant changes in the levels of awareness
   and responsibility towards environmental, ethical and social issues,
   remain `loyal' to their lifestyles and their purchasing decisions. This
   is a phenomenon known as a value-action gap, which occurs when the
   values and intentions of an individual are not related to his actions.
   However, the individual characteristics of consumers can be `shaken' by
   social and collective actions. Alternative food networks, and among
   these the short supply chains, interpret different degrees of
   sustainability and aim to improve the coordination of supply and to
   involve consumers as active players in the local, typical and organic
   food system. An example is the `Kalulu' network, on which this
   contribution focuses, a web platform which shortens the supply chain and
   transfers on a large scale the mechanism of the purchasing groups. The
   authors believe that this model, which operates in the rural and urban
   territory of the Metropolitan City of Rome, is able to stimulate
   sustainable production, on the one hand, and to bridge the value-action
   gap in individuals and families, on the other. In fact, from the
   analysis carried out, it emerges that the platform creates a
   producer/consumer local market which recognizes a fair and sustainable
   exchange value, which goes beyond the price/quality ratio. In this
   commercialization model consumers increase their awareness and
   responsibility of consumption choices in respect of seasonality,
   traditions and natural organic cycles, reducing waste; while the
   constancy of purchasing and the reduction of intermediaries guarantee
   economic needs also for small farmers. This innovative and efficient
   model of short supply chain contributes to the reduction of carbon
   emissions and the protection of the environment, for the benefit of the
   community.},
