@inproceedings{ WOS:000405641200006,
Author = {Letzel, Thomas and Grosse, Sylvia and Schulz, Wolfgang and Lucke, Thomas
   and Kolb, Angela and Sengl, Manfred and Letzel, Marion},
Editor = {Drewes, JE and Letzel, T},
Title = {New (Practical) Strategies in Target, Suspects, and Non-Target
   LC-MS(/MS) Screening: Bisoprolol and Transformation Products as an
   Example},
Booktitle = {ASSESSING TRANSFORMATION PRODUCTS OF CHEMICALS BY NON-TARGET AND SUSPECT
   SCREENING - STRATEGIES AND WORKFLOWS, VOL 1},
Series = {ACS Symposium Series},
Year = {2016},
