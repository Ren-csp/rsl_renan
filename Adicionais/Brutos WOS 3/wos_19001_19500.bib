@article{ WOS:000444996500108,
Author = {Syamsuri, E. U. and Tahir, M. M. and Basyaruddin, B. A. and Sulaiman, A.
   and Ngian, S. P. and Bakri, A.},
Title = {Conceptual Design Using Industrialized Building System for Affordable
   Housing Construction in Indonesia},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4322-4325},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {Industrialized Building System (IBS) is usually associated with
   sustainable construction which is described as the ability of the
   construction system to consider the environmental impact of a building
   over its entire lifetime, while optimizing its economic viability and
   the comfort and safety of its occupants. Typical standard building
   practices are guided by short term economic considerations. Affordable
   construction is based on best practices which emphasize long term
   affordability, quality and efficiency. The needs of affordable housing
   in Indonesia is very crucial every year. Housing needs continue to rise
   very rapidly in Indonesia, particularly in urban areas. Back log housing
   up to 2016 has reached up to 7.6 million units, while demand for new
   homes every year reached up to 800,000 units. There are about 1,350,000
   units' gap that must be resolved in order to fulfill the housing need in
   Indonesia. One of the ways to speed up the construction of these
   affordable housing is to use IBS in construction. IBS is defined as a
   construction system which components are manufactured in a factory, on
   or off site, positioned and assembled into structure with minimum
   additional site work. The main goals of IBS construction are to meet
   present day needs for housing, working environments and infrastructure
   without compromising the ability of future generations to meet their own
   needs in times to come. To achieve the objective of this paper a
   methodology is identify, which include: literature review; expert
   opinions; and data collection by using interview. It was found that the
   use of interlocking brick system was able to achieve saving in labour
   cost up to 50\% and the overall cost saving can be up to 33.8\%. It is
   hoped that by introducing this system, the way forward to meet the
   demand of housing industry in Indonesia can be fulfilled and achieved.},
