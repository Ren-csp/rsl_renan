@article{ WOS:000374796500037,
Author = {Chang, Sho-Fang and Hsieh, Ping-Jung and Chen, Hui-Fang},
Title = {Key success factors for clinical knowledge management systems: Comparing
   physician and hospital manager viewpoints},
Journal = {TECHNOLOGY AND HEALTH CARE},
Year = {2016},
