@inproceedings{ WOS:000223370200016,
Author = {Benson, C},
Editor = {Stephenson, N and Radtke, HL and Jorna, R and Stam, HJ},
Title = {Speculations on the `unthinkable' boundaries of identity and on their
   emotional dynamics},
Booktitle = {THEORETICAL PSYCHOLOGY: CRITICAL CONTRIBUTIONS},
Year = {2003},
Pages = {144-153},
Note = {9th Biennual Conference of the
   International-Society-for-Theoretical-Psychology, Calgary, CANADA, JUN
   03-08, 2001},
Organization = {Int Soc Theoret Psychol},
Abstract = {This paper addresses the question of how we ought to think about the
   boundaries of identities. It distinguishes `bodily boundaries' from
   psychological `boundaries of extension'. It connects the idea of
   boundaries to the dynamics of possession and, using that distinction,
   further distinguishes between `what belongs to me' and `what I belong
   to'. It introduces the concept of an `action-boundary' which it links to
   the idea of `unthinkable actions'. It defines `unthinkable actions' in
   the very specific sense of an inability to imagine such actions from
   within a first-person perspective without the accompaniment of strong
   negative feelings. It then explores the ways in which such unthinkable
   actions are given their power by negative emotions and suggests that the
   outer boundaries of identities can be understood as such `unthinkable
   actions'. In arguing that the architecture of identities is
   fundamentally emotional, it draws on the work of Paul Rozin and Richard
   Shweder and situates the argument within a cultural psychological
   context.},
