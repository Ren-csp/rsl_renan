@article{ WOS:000081758800013,
Author = {Labarge, E and Von Dras, D and Wingbermuehle, C},
Title = {An analysis of themes and feelings from a support group for people with
   Alzheimer's disease},
Journal = {PSYCHOTHERAPY},
Year = {1998},
Volume = {35},
Number = {4},
Pages = {537-544},
Month = {WIN},
Note = {105th Annual Convention of the American-Psychological-Association,
   CHICAGO, IL, AUG 14-19, 1997},
Organization = {Amer Psychol Assoc},
Abstract = {In addition to cognitive deficits, persons in the early stages of
   Alzheimer's disease confront a wide range of psychological issues, such
   as loss and alienation. An eight-session support group for individuals
   diagnosed with Alzheimer's disease (AD) was audio- and videotaped. The
   purpose of the study was to explore themes that arose naturally in a
   support group and to extend the investigation of emotions in persons
   with a dementing illness. The flexible group format allowed
   participant-directed topics to be discussed. Using transcriptions of all
   eight sessions, a content analysis revealed an awareness of performance
   deficit and a wide range of emotional expression. Participants voiced
   concern about memory shifts, difficulty with everyday routines, and the
   disruption of interpersonal relationships. They sought information about
   the illness and explored adaptive behaviors. A greater appreciation of
   these issues may be instrumental in reducing the burden of the illness
   for both the diagnosed person and those who provide care.},
Publisher = {AMER PSYCHOLOGICAL ASSOC, DIV PSYCHOTHERAPY},
Address = {1390 SOUTH DIXIE HIGHWAY, STE 2222, CORAL GABLES, FL 33146-2946 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Labarge, E (Corresponding Author), 9572 Sunny Creek Lane, St Louis, MO USA.
   Washington Univ, Sch Med, Dept Neurol \& Neurol Surg, St Louis, MO 63130 USA.
