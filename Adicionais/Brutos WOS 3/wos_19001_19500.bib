@article{ WOS:000260718800003,
Author = {Cattaneo, Zaira and Vecchi, Tomaso and Cornoldi, Cesare and Mammarella,
   Irene and Bonino, Daniela and Ricciardi, Emiliano and Pietrini, Pietro},
Title = {Imagery and spatial processes in blindness and visual impairment},
Journal = {NEUROSCIENCE AND BIOBEHAVIORAL REVIEWS},
Year = {2008},
Volume = {32},
Number = {8},
Pages = {1346-1360},
Month = {OCT},
Note = {European Workshop on Imagery and Cognition, St Andrews, SCOTLAND, 2005},
Abstract = {The objective of this review is to examine and evaluate recent findings
   on cognitive functioning (in particular imagery processes) in
   individuals with congenital visual impairments, including total
   blindness, low-vision and monocular vision. As one might expect, the
   performance of blind individuals in many behaviours and tasks requiring
   imagery can be inferior to that of sighted subjects; however,
   surprisingly often this is not the case. Interestingly, there is
   evidence that the blind often employ different cognitive mechanisms than
   sighted subjects, suggesting that compensatory mechanisms can overcome
   the limitations of sight loss. Taken together, these studies suggest
   that the nature of perceptual input on which we commonly rely strongly
   affects the organization of our mental processes. We also review recent
   neuroimaging studies on the neural correlates of sensory perception and
   mental imagery in visually impaired individuals that have cast light on
   the plastic functional reorganization mechanisms associated with visual
   deprivation. (c) 2008 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
