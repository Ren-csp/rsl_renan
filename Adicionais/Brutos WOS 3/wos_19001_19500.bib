Title = {Decision-Support Tool for Retrofitable Flood Resilience},
Booktitle = {7TH INTERNATIONAL CONFERENCE ON BUILDING RESILIENCE: USING SCIENTIFIC
   KNOWLEDGE TO INFORM POLICY AND PRACTICE IN DISASTER RISK REDUCTION},
