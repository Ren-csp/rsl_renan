Title = {EEG-fMRI Ballistocardiogram Removal: A New Non-linear Dynamic Time
   Warping Approach},
Booktitle = {14TH NORDIC-BALTIC CONFERENCE ON BIOMEDICAL ENGINEERING AND MEDICAL
   PHYSICS},
