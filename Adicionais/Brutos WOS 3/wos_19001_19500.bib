Pages = {499-502},
Note = {International Symposium on Safety Science and Technology, Beijing,
   PEOPLES R CHINA, SEP 24-27, 2008},
Abstract = {Emergency management as an important part of safety science has much
   developed in these years, In which the environmental problem such as the
   frequent water pollution incidents has become one of the most notable
   emergency management problems for our government. When there is an
   emergency water pollution event, it is important to make tin effective
   emergency decision according to the information of real-time event and
   the appropriate response can mitigate the environment pollution and
   costs. In this article, a multi-stage decision method based on safety
   science, risk analysis and economics was presented, It is a new method
   of emergency management and it may assist the decision maker to improve
   its emergency prevention and response in high risk area. The example of
   Songhua River Water Pollution Incident is used to illustrate the method
   in emergency decision programming.},
