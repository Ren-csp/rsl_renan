@article{ WOS:000232837100034,
Author = {Supuka, A and Stepánková, R},
Title = {Characteristic and marks of cultural landscape of Slovakia},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2004},
Volume = {23},
Number = {1},
Pages = {333-339},
Note = {13th International Symposium on Problems of Landscape Ecological
   Research, Mojmirovce, SLOVAKIA, SEP 30-OCT 03, 2003},
Organization = {Slovak Acad Sci, Inst Landscape Ecol; Austrian Inst E \& SE European
   Studies Vienna, Branch Off Bratislava},
Abstract = {Cultural landscape is the type of landscape, which arose by meaningful
   man activity and successive transformation of natural landscape.
   Cultural landscape is being expressed synergy of man influence and
   cultural environment. Cultural landscape is a result of man activity in
   landscape in utility-economic, ecology and aesthetic (architectonic)
   meaning. Landscape typology (natural and cultural) has been subject of
   interest and result of many authors in abroad and in Slovakia.
   Wide known there are works of many authors, which have used for
   landscape regionalisation marks of natural conditions and evaluation
   criterias.
   Many research works and papers have aimed to visual evaluation of
   landscape image and landscape marks perception.
   Contribution is dealing with criterias and definition of cultural
   landscape types in Slovakia territory.
   Background of cultural landscape appears three basic components of
   landscape image:
   land configuration or physical components group land cover as reflexion
   of
   land-use and man created elements
   social landscape aspect includes history footness, landscape and nature
   protection (natural and cultural heritage) valorization
   (perception-visual, aesthetic-architectonical aspect).
   For cultural landscape has been defined main difference criterias in
   comparison to nature landscape. In Slovakia territory could be defined 6
   main cultural landscape types with description of specific properties
   and marks in nature, land-use and cultural monuments field.},
Publisher = {SLOVAK ACADEMIC PRESS LTD},
