@article{ WOS:000242620000004,
Author = {Hespanha, Joao Paulo and van Oosterom, Peter and Zevenbergen, Jaap and
   Dias, Goncalo Paiva},
Title = {A modular standard for the cadastral domain: Application to the
   Portuguese Cadastre},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2006},
Volume = {30},
Number = {5},
Pages = {562-584},
