Title = {Abundance, size distribution and dissolved organic matter binding of
   arsenic in reducing aquifer},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
