@inproceedings{ WOS:000179444800169,
Author = {Cristelo, N and Paiva, A and Jalali, S},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Improvement of the performance of earth walls using lime and low-cost
   activators},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1405-1412},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The need for better housing is felt all over the world and this sector
   of construction industry is growing fast. The Agenda 21 of Rio Summit
   has raised the vital issue of sustainable development that has direct
   bearing on sustainability of construction. The issue is becoming more
   relevant because the conventional materials used at present in developed
   countries, with high energy input and negative environmental impact, is
   fast becoming a trend everywhere. In places where until now dwellings
   were built using locally available material, mainly earth, and adequate
   technology, is now moving towards using materials with high energy input
   and making construction less sustainable. Hence, there is a need for new
   environmental friendly, low-cost, users-appealing construction material.
   Naturally, the first option remains to be earth. The earth construction,
   however, has limitations that are related to durability and image
   perception that have to be addressed.
   This research work deals with the concept of using lime-stabilized earth
   for low-cost and environmental friendly dwellings. It is suggested that
   the performance of this material can be successfully enhanced by using
   small quantities of activators, which will increase significantly the
   durability and consequently the image perception of dwellings
   constructed with such materials.},
