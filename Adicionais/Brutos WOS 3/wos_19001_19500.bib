@inproceedings{ WOS:000674833100026,
Author = {Cardoso, Andre and Colim, Ana and Sousa, Nuno},
Editor = {Arezes, PM and Baptista, JS and Barroso, MP and Carneiro, P and Cordeiro, P and Costa, N and Melo, RB and Miguel, AS and Perestrelo, G},
Title = {The Effects of a Passive Exoskeleton on Muscle Activity and Discomfort
   in Industrial Tasks},
Booktitle = {OCCUPATIONAL AND ENVIRONMENTAL SAFETY AND HEALTH II},
