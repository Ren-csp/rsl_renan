@inproceedings{ WOS:000254031000008,
Author = {Dimitrova, Anna},
Editor = {Simeonov, L},
Book-Author = {Sargsyan, V},
Title = {PCBs content in topsoils around the metallurgical plant Kremikovtsi},
Booktitle = {SOIL CHEMICAL POLLUTION, RISK ASSESSMENT, REMEDIATION AND SECURITY},
Series = {NATO Science for Peace and Security Series C-Environmental Security},
Year = {2008},
Pages = {117-128},
Note = {NATO Advanced Research Workshop on Soil Chemical Pollution, Risk
   Assessment, Remediation and Security, Sofia, BULGARIA, MAY 23-26, 2007},
Organization = {NATO},
Abstract = {Polychlorinated biphenyls (PCBs) are ubiquitous environmental
   contaminants. They are highly persistent and tend to accumulate in many
   environmental compartments including soils. The distribution of PCBs in
   the environment has not been well studied in Bulgaria in spite of their
   negative effect on the environment and human health. In this study, soil
   samples from a metallurgical plant near Sofia were analyzed for
   indicator and some dioxin-like PCBs. The sums of concentrations of
   indicator-PCBs were in the range 7.3-19.2 mu g kg(-1). Small amounts of
   dioxin-like PCBs also were found (2.3-5.1 mu g kg(-1)). High chlorinated
   indicator-PCBs: 138, 153 and 180 were the most abundant in the soil
   samples. Dioxin-like PCB 77 (non ortho-PCB) and PCB 105 (mono ortho-PCB)
   were in minor concentrations (0.3 mu g kg(-1)) but they are more toxic
   contaminants than indicator PCBs. The PCBs concentrations found in this
   study are below the maximum admissible concentrations in soils according
   to the Bulgarian Legislation.},
