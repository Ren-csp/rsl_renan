Title = {The use of humates for the detoxification of soils contaminated with
   heavy metals},
Booktitle = {Use of Humic Substances to Remediate Polluted Environments: From Theory
   to Practice},
Series = {NATO Science Series IV Earth and Environmental Sciences},
Year = {2005},
Volume = {52},
