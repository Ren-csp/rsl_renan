@article{ WOS:000180785900006,
Author = {Brewer, CL},
Title = {William!James's talks about teaching},
Journal = {TEACHING OF PSYCHOLOGY},
Year = {2003},
Volume = {30},
Number = {1},
Pages = {34-38},
Month = {WIN},
Note = {105th Annual Meeting of the American-Psychological-Association, CHICAGO,
   IL, AUG 15-19, 1997},
Organization = {Amer Psychol Assoc},
Abstract = {More than 100 years after it was published, William James's (1899/1939)
   book, Talks to Teachers on Psychology, is relevant and helpful for
   teachers and those who aspire to teach. In this article, I highlight
   certain memorable points in Talks and relate them to James's (1890)
   classic work, The Principles of Psychology. Many of James's insights
   foreshadowed certain emphases of present-day researchers, and his
   observations on teaching are as germane now as they were more than a
   century ago.
   If students learn anything about William James, they may learn that he
   wrote The Principles of Psychology (1890); that he proposed a theory of
   emotion bearing his name and the name of a Danish physiologist; and that
   he became disenchanted with psychology, which he once called a ``nasty
   little science{''} (Schultz \& Schultz, 1996, p. 151), and turned his
   attention to philosophy. I will highlight a few things that this
   influential pioneer said about teaching, which usually receive less
   attention than his other notable contributions to the history of
   psychology.},
