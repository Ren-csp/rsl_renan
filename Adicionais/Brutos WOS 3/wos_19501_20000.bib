@inproceedings{ WOS:000361022100021,
Author = {Celik, Mehmet and Ayna, Yunus Emre},
Editor = {Bekirogullari, Z and Minas, MY},
Title = {Application of Perceived Family Support Scale to Individuals with
   Special Needs},
Booktitle = {CPSYC 2013 INTERNATIONAL CONGRESS ON CLINICAL AND COUNSELLING PSYCHOLOGY},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
