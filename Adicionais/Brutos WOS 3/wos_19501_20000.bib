@inproceedings{ WOS:001558899800028,
Author = {Vaccargiu, Matteo and Neykova, Rumyana and Novielli, Nicole and Ortu,
   Marco and Destefanis, Giuseppe},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {More Than Code: Technical and Emotional Dynamics in Solidity's
   Development},
Booktitle = {2025 IEEE/ACM 18TH INTERNATIONAL CONFERENCE ON COOPERATIVE AND HUMAN
   ASPECTS OF SOFTWARE ENGINEERING, CHASE},
Series = {ICSE Workshop on Cooperative and Human Aspects on Software Engineering},
Year = {2025},
Pages = {260-271},
Note = {2025 Conference on Cooperative and Human Aspects of Software
   Engineering-CHASE-Annual, Ottawa, CANADA, APR 27-28, 2025},
Abstract = {Background: Solidity is the primary programming language used for
   developing smart contracts on Ethereum, representing a new generation of
   programming languages developed entirely in open environments.
   Objective: This longitudinal case study examines contribution patterns
   and emotional dynamics within the Solidity GitHub repository over a
   ten-year period (2014-2024).
   Method: We developed a contribution index combining metrics from
   developer activities (commits, pull requests, comments, and temporal
   engagement) and applied emotion detection to study communication
   patterns in a decade-long dataset of developer interactions.
   Results: The top 1\% of contributors are responsible for around 85\% of
   project contributions, yet the project exhibits dual paths to
   prominence: early contributors established technical foundations through
   code, while later contributors achieved influence through reviews and
   discussions. Emotional patterns show transitions from initial curiosity
   and confusion to eventual approval and gratitude.
   Conclusion: The project's recognition of diverse contribution types and
   evolving emotional dynamics enables sustainable growth despite
   concentrated contributions, demonstrating how open-source languages can
   evolve while maintaining both technical rigor and community engagement.},
