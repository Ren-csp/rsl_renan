@article{ WOS:000235103000002,
Author = {Lundie, S and Peters, G and Beavis, P},
Title = {Quantitative systems analysis as a strategic planning approach for
   metropolitan water service providers},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
Volume = {52},
Number = {9},
