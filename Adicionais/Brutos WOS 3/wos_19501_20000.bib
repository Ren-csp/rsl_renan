Author = {Yesmin, R. and Mohiuddin, A. S. M. and Uddin, M. J. and Shahid, M. A.},
Book-Group-Author = {IOP},
Title = {Land use and land cover change detection at Mirzapur Union of Gazipur
   District of Bangladesh using remote sensing and GIS technology},
Booktitle = {7TH IGRSM INTERNATIONAL REMOTE SENSING \& GIS CONFERENCE AND EXHIBITION},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2014},
Volume = {20},
Note = {7th IGRSM International Remote Sensing and GIS Conference and
   Exhibition, Kuala Lumpur, MALAYSIA, APR 21-23, 2014},
Organization = {Institut Geospatial \& Remote Sensing Malaysia; Univ Putra Malaysia; Sci
   \& Technol Res Inst Defence; ANGKASA; Univ Malaya; UTAR; MARIM; Univ
   Teknologe Mara; NAHRIM; Univ Teknologe Petronas},
Abstract = {A study was conducted with a view to identify and quantify the changes
   in land use and land cover occurred during the last 20 years at Mirzapur
   Union of Gazipur district of Bangladesh using remote sensing and GIS
   technologies. Two LANDSAT TM images of 1989 and 2009 with 30mx30m
   spatial resolution were used to determine the temporal land cover
   changes. Subsequently, a ground verification was done in the study site.
   The study revealed that forest cover was decreased by 20.29 \% and
   settlement area was found to increase by 28.64\% and water bodies was
   decreased by 6.25 \%. In the same period of time, bare land was found to
   increase by 20.91 \% due to the effect of clearing of forest area which
   is not replanted again. A lot of new infrastructures has been built by
   this time. Population pressure becomes double enhancing the
   deforestation of Sal (Shorea robusta). Most prominent features are the
   emergence of brick fields and various industries. Thus, the above study
   demonstrated the usefulness of RS and GIS technology regarding resource
   management and urban planning.},
