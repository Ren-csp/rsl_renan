@inproceedings{ WOS:000482722700013,
Author = {Movshon, J. Anthony and Simoncelli, Eero P.},
Editor = {Bargmann, C and Bavelier, D and Sejnowski, T and Stewart, D and Stillman, B},
Title = {Representation of Naturalistic Image Structure in the Primate Visual
   Cortex},
Booktitle = {COGNITION, VOL 79, 2014},
Series = {Cold Spring Harbor Symposia on Quantitative Biology},
Year = {2014},
Volume = {79},
Pages = {115-122},
Note = {79th Cold Spring Harbor Symposium on Quantitative Biology, Cold Spring
   Harbor, NY, MAY 28-JUN 02, 2014},
Organization = {Forest Labs; Swartz Fdn; Agilent Technologies; Bristol Myers Squibb Co;
   Genentech; Thermo Fisher Sci, Life Technologies; New England BioLabs;
   Monsanto Co; DuPont Pioneer Hi Bred Int; HudsonAlpha Inst Biotechnol},
Abstract = {The perception of complex visual patterns emerges from neuronal activity
   in a cascade of areas in the primate cerebral cortex. We have probed the
   early stages of this cascade with ``naturalistic{''} texture stimuli
   designed to capture key statistical features of natural images. Humans
   can recognize and classify these synthetic images and are insensitive to
   distortions that do not alter the local values of these statistics. The
   responses of neurons in the primary visual cortex, V1, are relatively
   insensitive to the statistical information in these textures. However,
   in the area immediately downstream, V2, cells respond more vigorously to
   these stimuli than to matched control stimuli. Humans show
   blood-oxygen-level-dependent functional magnetic resonance imaging (
   BOLD fMRI responses in V1 and V2) that are consistent with the neuronal
   measurements in macaque. These fMRI measurements, as well as
   neurophysiological work by others, show that true natural scenes become
   a more prominent driving feature of cortex downstream from V2. These
   results suggest a framework for thinking about how information about
   elementary visual features is transformed into the specific
   representations of scenes and objects found in areas higher in the
   visual pathway.},
Publisher = {COLD SPRING HARBOR LABORATORY PRESS},
Address = {10 SKYLINE DRIVE, PLAINVIEW, NY 11803-2500 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Movshon, JA (Corresponding Author), NYU, Ctr Neural Sci, New York, NY 10003 USA.
   Movshon, J. Anthony; Simoncelli, Eero P., NYU, Ctr Neural Sci, New York, NY 10003 USA.
   Simoncelli, Eero P., NYU, Howard Hughes Med Inst, New York, NY 10003 USA.},
DOI = {10.1101/sqb.2014.79.024844},
ISSN = {0091-7451},
EISSN = {1943-4456},
ISBN = {978-1-621821-26-7},
Keywords-Plus = {RECEPTIVE-FIELDS; FUNCTIONAL ARCHITECTURE; HIERARCHICAL-MODELS; COMPLEX
   CELLS; AREA V2; SELECTIVITY; STATISTICS; PERCEPTION; RESPONSES;
   COMPUTATION},
