Title = {Evaluation of proteomics responses of rice (Oryza sativa) during
   arsenic toxicity amelioration by a potential microbial consortium},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {551-552},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {Environmental pollution of arsenic (As) is a serious problem that is not
   only affecting the local people but also population throughout the world
   through rice and rice-based food products. Rice accumulates As in
   significantly greater amounts in comparison to other cereal crops.
   Microbiological interventions can serve as protective agents to
   ameliorate As stress in rice. The experiments were conducted in
   hydroponically grown in rice seedlings subjected to arsenate {[}As(V)]
   stress for 15 d. Two-dimensional gel electrophoresis analysis of 340
   spots revealed that 145 spots were differentially expressed; out of
   these, 87 spots were identified using MALDI-TOF-TOF. The differentially
   expressed proteins during supplementation of microbial consortium under
   As stress belonged to defense, growth promotion, energy metabolism,
   cellular and metabolic processes.},
