@inproceedings{ WOS:000227353000011,
Author = {Marie, RM},
Editor = {Korczyn, AD},
Title = {Imaging correlates of working memory in Parkinson's disease},
Booktitle = {PROCEEDINGS OF THE MENTAL DYSFUNCTIONS IN PARKINSON'S DISEASE},
Year = {2004},
Pages = {69-77},
Note = {Conference on Mental Dysfunctions in Parkinsons Disease, Salzburg,
   AUSTRIA, OCT 24-27, 2004},
Abstract = {We recently identified a network that predicted working memory (WM),
   using FDG-PET in moderately advanced patients with Parkinson's Disease
   (PD). These observations expand the view from a focus on frontal lobe
   dysfunction alone to pathological mechanisms that include cortical
   downstream effects of disturbed basal ganglia function. In a group of PD
   patients compared to controls, we studied rCBF while the subjects
   perform a WM task, using both short and long delays. Despite good
   performance on the short-delay WM task, in PD, several regions were
   activated at a level significantly higher than the control, which
   suggests compensatory phenomena, via structures usually involved in
   attention-demanding processes and emotion. Concerning long-delay WM
   task, the activation pattern in PD suggested fronto-posterior
   disconnection that might result from the inability for the frontal lobes
   to transfer the information to posterior areas implicated in long term
   memory processes. Finally, we observed, in PD, correlation between
   cortical aminergic uptake and higher executive functions, whereas
   automatic inhibition was specifically correlated with dopamine caudate
   uptake.},
