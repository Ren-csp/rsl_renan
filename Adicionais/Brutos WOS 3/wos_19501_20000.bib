@inproceedings{ WOS:000452696800025,
Author = {Zyryanova, Nadezda M. and Egorova, Marina S. and Pankratova, Alina A.
   and Parshikova, Oksana V. and Pyankova, Svetlana D. and Chertkova, Ylia
   D.},
Editor = {Sheridan, S and Veraksa, N},
Title = {THE STUDY OF ATTITUDES OF CHILDREN OF SENIOR PRESCHOOL AGE},
