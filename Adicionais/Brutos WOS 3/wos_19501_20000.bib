@inproceedings{ WOS:000287981100043,
Author = {Zhang, H. and Lei, S. L.},
Editor = {Brebbia, CA and Pineda, FD},
Title = {Effects of place attachment on participation intentions for local
   tourism development},
Booktitle = {SUSTAINABLE TOURISM IV},
