@inproceedings{ WOS:000306447900017,
Author = {Wang, Q. and Nakamura, S. and Gong, X. and Lu, S. and Nakajima, D. and
   Wu, D. and Suzuki, M. and Sakamoto, K. and Miwa, M.},
Editor = {Brebbia, CA and Longhurst, JWS},
Title = {Evaluation of elution behavior and morphological change of the
   Cryptomeria japonica pollen grain and release of its daughter
   allergenic particles by air polluted rainfall},
Booktitle = {AIR POLLUTION XVIII},
Series = {WIT Transactions on Ecology and the Environment},
