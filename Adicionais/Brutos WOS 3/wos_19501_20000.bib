Title = {Retired baby boomers as operators of sustainable rural tourism: the
   roles and significance},
Booktitle = {Sustainable Tourism II},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2006},
Volume = {97},
Pages = {251-260},
Note = {2nd International Conference on Sustainable Tourism, Bologna, ITALY, SEP
   06-08, 2006},
Organization = {WIT Transact Ecol \& Environm; Wessex Inst Technol; Complutense Univ},
Abstract = {This paper examined the roles and significance of rural tourism activity
   undertaken by those farmers retired from non-farming jobs from a
   multifunctional perspective in Chiba. The results revealed that rural
   tourism realised efficient and sustainable resource utilisation of the
   farm. The main findings were: 1) the farming style of the study farm is
   small production of multiple products all year round, which increases
   opportunities for farming and farm-life experiences by local school
   children and urban visitors, although this type of farming was not
   respected from a productivity-oriented farming perspective; and 2)
   providing fanning experience services not only makes it possible to
   utilise unused resources in the farmyard, but also promotes
   multifunctionality in terms of recreational, educational and land
   preservation functions. These results suggest that rural tourism will be
   an effective and recommended activity for those farm-oriented people
   retired from non-farming occupations.},
