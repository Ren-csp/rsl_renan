@article{ WOS:000229616600027,
Author = {Genik, RJ II and Green, CC and Graydon, FX and Armstrong, RE},
Title = {Cognitive avionics and watching spaceflight crews think:
   Generation-after-next research tools in functional neuroimaging},
Journal = {AVIATION SPACE AND ENVIRONMENTAL MEDICINE},
