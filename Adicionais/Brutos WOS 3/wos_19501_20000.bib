@article{ WOS:000431498300119,
Author = {Jannari, Diyana and Abdullah, Zaleha and Mohamed, Hasnah and Zaid,
   Norasykin Mohd and Aris, Baharuddin},
Title = {Social Media in Learning: Insights of High Schools},
