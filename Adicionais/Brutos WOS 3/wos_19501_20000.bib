@inproceedings{ WOS:000389439100005,
Author = {Chu, Ya and Liu, Songyu and Cai, Guojun and Bian, Hanliang and Zhang,
   Tao},
Editor = {Yesiller, N and Zekkos, D and Farid, A and De, A and Reddy, KR},
Title = {Physical and Microscopic Characteristics Experiments with Heavy Metal
   Polluted Cohesive Soil},
Booktitle = {Geo-Chicago 2016: Sustainable Waste Management and Remediation},
Series = {Geotechnical Special Publication},
Year = {2016},
Number = {273},
Pages = {42-52},
Note = {Geo-Chicago Conference - Sustainability, Energy, and the Environment
   (Geo-Chicago), Chicago, IL, AUG 14-18, 2016},
Organization = {Amer Soc Civil Engineers, Geo Inst},
Abstract = {More and more attention has been paid to the effects of heavy metal
   pollution on soil in China. Due to the addition of heavy metal ions, the
   physical properties of soil will be changed and the microscopic
   properties, such as soil structure, stress, and soil particle, of soil
   will also be transformed. In this article, three kinds of heavy metal
   ions (Zn, Pb and Cd) were used as pollutions to prepare the heavy metal
   contaminated soil in laboratory. Then the physical and microscopic
   properties of heavy metal contaminated soils were investigated.
   Microscopic tests include X-ray diffraction (XRD), Scanning electron
   microscopy (SEM) and X-ray fluorescence spectrum (XRFS). The
   microstructure of heavy metal polluted soils and the fundamental reasons
   for the observed changes were interpreted based on the above three
   expriments. Besides, the fines content test and pH test were used to
   analyze the variation rules of relevant physical properties in heavy
   metal contaminated soil. At last, the soil characteristics of heavy
   metal contaminated silt clay were studied by contrastive analysis of the
   physical and microscopic test. And the characteristics of three kinds of
   pollutants were compared to each other. The change rule of related
   properties was analyzed by macroscopic physical properties of three
   kinds of heavy metal contaminated soil, which could provide the basis
   for evaluation and treatment of polluted soil.},
