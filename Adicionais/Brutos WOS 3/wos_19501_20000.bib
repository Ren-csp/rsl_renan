@inproceedings{ WOS:001054845600019,
Author = {Wilkowska, Wiktoria and Offermann, Julia and Ziefle, Martina},
Book-Group-Author = {ACM},
Title = {Perspectives on the Collection of Health-related Data in Long-term Care},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL CONFERENCE ON PERVASIVE
   TECHNOLOGIES RELATED TO ASSISTIVE ENVIRONMENTS, PETRA 2022},
Year = {2022},
Pages = {137-145},
Note = {15th ACM International Conference on Pervasive Technologies Related to
   Assistive Environments (PETRA), GREECE, JUN 29-JUL 01, 2022},
Organization = {Assoc Comp Machinery},
Abstract = {Innovative applications in assistive environments capable of collecting
   health-related data can be used to support older and/or frail
   individuals in need of assistance in their daily lives and can partly
   mitigate nursing challenges in an aging society. In this study, we used
   an online survey to explore participants' opinions on the long-term
   collection of personal health-related data by means of existing
   (lifelogging) technologies from the perspectives of 1) the individual in
   need of care, 2) the caregiving relative, and 3) the professional
   caregiver. Data from N=1082 participants were considered for statistical
   analyses, in which differences between the perspectives of the three
   stakeholders were calculated. Results revealed significant differences
   in the perceptions of, and attitudes towards, health data collection.
   Greater acceptance was observed regarding the willingness to gather data
   and the perception of its usefulness. Nonetheless, our findings
   disclosed that - especially from the perspective as a professional
   caregiver - respondents reached highest values in the acceptance and
   perceived meaningfulness of collecting data of vital parameters, as well
   as regarding the permission to access these data by relevant others
   (e.g., nursing staff and medical professionals). Insights from this
   study about an accepted collection of the health-relevant data from
   pervasive technology, and/or requirements necessary for its barrier-free
   adoption process, enable providing an optimized technology development
   and an enriched assistance of older and frail individuals in aging
   societies.},
