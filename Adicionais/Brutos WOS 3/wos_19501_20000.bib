@inproceedings{ WOS:000365992100021,
Author = {Miron, Constantin and Miron, Livia},
Book-Group-Author = {SGEM},
Title = {INNOVATIVE SOLUTIONS FOR RENEWABLE ENERGY CONVERTER-GENERATOR,
   ECO-EFFICIENT, ENERGETICALLY AUTONOMOUS BUILDINGS},
Booktitle = {GEOCONFERENCE ON ENERGY AND CLEAN TECHNOLOGIES},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {161-168},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {This paper defines a new concept for designing buildings with high
   energy autonomy, whose energy consumption from conventional sources may
   become insignificant in relation to the total amount of energy necessary
   that will be covered mostly from the energy produced by the covering of
   the building itself.
   This concept involves innovative solutions of elements and components of
   energy converter - generator type, characteristic to a multifunctional
   covering, with energy capturing elements of active or passive type. This
   paper presents research on a functional model of a building covering
   constructed in an integrated system, with water modules which acquire a
   multifunctional role of thermal and soundproofing closing, of mechanical
   insulation from the exterior, of energy converter - generator for
   heating, cooling and active protection against fire.
   The accumulation of energy in the infrastructure of the building, in the
   foundation soil and in accumulation reservoirs integrated in the
   covering of the building capitalizes on a thermal massiveness 5 times
   greater than any other dense construction material.
   The proposed solutions serve to bring the functioning of a building
   closer to the behavior of the environment, where water, as a fundamental
   element, must ensure the safety and functionality of a building,
   considering its major qualities of thermal accumulator and antidote to
   fires.},
