@article{ WOS:000088586700003,
Author = {Nannini, DK and Meyers, LS},
Title = {Jealousy in sexual and emotional infidelity: An alternative to the
   evolutionary explanation},
Journal = {JOURNAL OF SEX RESEARCH},
Year = {2000},
Volume = {37},
Number = {2},
Pages = {117-122},
Month = {MAY},
Note = {Joint Convention of the
   Western-Psychological-Association/Rocky-Mountain-Psychological-Associati
   on, ALBUQUERQUE, NEW MEXICO, APR, 1998},
Organization = {Western Psychol Assoc; Rocky Mt Psychol Assoc},
Abstract = {In an effort to make unequivocal the boundaries of infidelity, the
   present study used three infidelity scenarios (sexual infidelity,
   emotional infidelity, and the combination of sexual and emotional
   infidelity). Two other variables, gender of the participants and the
   extent to which they reported either few or several jealous tendencies,
   were included to generate a 3 x 2 x 2 independent groups design.
   Reactions of 317 undergraduate college students (165 women and 152 men)
   to the scenarios were assessed using both Smith and Ellsworth's (1985)
   six cognitive dimensions of emotion and a measure of emotional upset. A
   multivariate analysis of variance yielded significance for two of the
   main effects, the nature of the infidelity scenario and the gender of
   the participant. Univariate analysis indicated that women experienced
   more emotional distress over all of the conditions of infidelity,
   and,for women and men alike, conditions of infidelity involving a sexual
   component, whether alone or together with emotional infidelity, proved
   to be more upsetting than those involving only an emotional component.},
