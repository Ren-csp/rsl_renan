@article{ WOS:000165259600008,
Author = {Kubátová, A and Vermeylen, R and Claeys, M and Cafmeyer, J and Maenhaut,
   W and Roberts, G and Artaxo, P},
Title = {Carbonaceous aerosol characterization in the Amazon basin, Brazil::
   novel dicarboxylic acids and related compounds},
Journal = {ATMOSPHERIC ENVIRONMENT},
