@article{ WOS:A1997XD36400002,
Author = {Riordan, CM and Shore, LM},
Title = {Demographic diversity and employee attitudes: An empirical examination
   of relational demography within work units},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
