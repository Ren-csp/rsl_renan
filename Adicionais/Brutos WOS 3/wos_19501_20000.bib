@article{ WOS:A1997YL20000043,
Author = {Mailhot, A and Rousseau, AN and Massicotte, S and Dupont, J and
   Villeneuve, JP},
Title = {A watershed-based system for the integrated management of surface water
   quality: The GIBSI system},
