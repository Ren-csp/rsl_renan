@article{ WOS:A1996UR80200006,
Author = {Testa, M and Reifman, A},
Title = {Individual differences in perceived riskiness of drinking in pregnancy:
   Antecedents and consequences},
Journal = {JOURNAL OF STUDIES ON ALCOHOL},
