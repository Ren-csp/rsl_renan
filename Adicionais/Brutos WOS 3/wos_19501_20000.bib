Organization = {Eastern Acad Management},
Abstract = {Previous studies explain situational antecedents of organizational
   citizenship behavior (OCB) using social exchange theory. However, the
   effects of factors such as perceptions of job characteristics on OCB
   seem to require a different explanatory mechanism. This article proposes
   that these effects can be explained through a new exchange relationship
   called work exchange. A theory for the situational antecedents of OCB
   that includes economic, work, and social exchange relationships is
   developed. The theory is tested using structural equations.},
