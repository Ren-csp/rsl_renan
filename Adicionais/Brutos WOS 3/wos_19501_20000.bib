@inproceedings{ WOS:000226029600029,
Author = {Deconchat, M and Foltête, JC and Monteil, C and Balent, G},
Editor = {Chamberlain, D and Wilson, A},
Title = {Direct analysis of remote sensing data to identify bird habitats:: An
   exploratory approach},
Booktitle = {AVIAN LANDSCAPE ECOLOGY: PURE AND APPLIED ISSUES IN THE LARGE-SCALE
   ECOLOGY OF BIRDS},
Year = {2002},
Pages = {185-192},
Note = {11th Annual Conference of the
   International-Association-for-Landscape-Ecology, Univ E Anglia, Norwich,
   ENGLAND, SEP 10-13, 2002},
Organization = {Int Assoc Landscape Ecol, UK Chapter},
Abstract = {Remote sensed data are often used to build habitat models for bird
   species over large areas. This is generally done by an indirect method
   based on (1) an analysis of the remote sensing data to build a land
   cover map, and (2) an analysis of species occurrences in relation to
   this map. This approach has the drawback of being strongly dependent on
   the human perception of the studied area and being independent of the
   species perception. We propose an exploratory approach - a direct
   analysis - to link field observations of bird occurrences and remote
   sensing data. The occurrence of each species is considered as a training
   site for a supervised classification of raw remote sensed data. For a
   given index describing the remote sensing data (several indices have
   been tested), we first identified the best scale for linking occurrence
   of a species and the index. A comparison with random a sample was used
   to measure the goodness of this fit. Then we built a probabilistic model
   of recognition, which allowed mapping of the spatial distribution of
   bird species. We finally interpreted the characteristics of the model of
   recognition in order to identify manageable land covers. This approach
   has been tested on a set of bird data in south west France with Spot
   images. Results show that recognition models can be identified.},
