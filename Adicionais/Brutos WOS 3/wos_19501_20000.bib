Pages = {493-500},
Note = {10th IWA International Congress on Anaerobic Digestion, Montreal,
   CANADA, AUG 29-SEP 02, 2004},
Organization = {IWA; Natl Res Council Canada},
Abstract = {In this paper the Petersen and composition matrices that modellers are
   now familiar with are used as a basis to construct interfacing models
   between subsystems considered in wastewater treatment. Starting from
   continuity considerations and a set of transformation reactions between
   components used in the two models of the subsystems to be interfaced, a
   set of linear algebraic equations needs to be solved. The theoretical
   development is illustrated using a simplified integrated model of an
   activated sludge system coupled to an anaerobic digester.
   Continuity-guaranteed interfacing of subsystems will facilitate
   optimization studies of the within-the-fence process units of a
   wastewater treatment plant or of the integrated urban wastewater system.},
