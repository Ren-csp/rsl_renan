@inproceedings{ WOS:000073466300020,
Author = {Mingolla, E},
Editor = {Ferretti, CT},
Title = {Recent results in emergent visual segmentation},
Booktitle = {BIOCYBERNETICS OF VISION: INTEGRATIVE MECHANISMS AND COGNITIVE PROCESSES},
Series = {SERIES ON BIOPHYSICS AND BIOCYBERNETICS},
Year = {1997},
Volume = {2},
Pages = {187-196},
Note = {International School E.R. Caianiello on Biocybernetics of Vision -
   Integrative Mechanisms and Cognitive Processes, ISCHIA, ITALY, OCT
   16-22, 1994},
Organization = {Sch Advisory Board; Istit di Cibernetica CNR; Istit Italian per gli
   Studi Filosofici},
Abstract = {Recent progress in the understanding of the interaction of brightness
   perception, illusory contours, and corticogeniculate feedback through
   developments in a neurally based model of early visual perception are
   reviewed. The Boundary Contour System (BCS) of Grossberg and Mingolla
   (1985) finds the location and orientation of surface boundaries of a
   scene. The outlines of such surfaces can be defined by regions of
   different luminance or texture, or by illusory contours. These
   computations are carried out through a series of cooperative and
   competitive interactions, including positive feedback from cells
   sensitive to long-range alignments of contours to cells coding more
   local oriented contrast information. BCS boundaries also gate diffusive
   filling-in of brightness (surface property) signals within a Feature
   Contour System(FCS). A recently enhanced version of the BCS, along with
   the FCS, has been shown to offer an explanation of brightness effects
   often associated with illusory contours by Gove, Grossberg, and Mingolla
   (1994). The principal novelty of the enhanced BCS model is that top-down
   feedback from BCS analogs of complex cells in V1 to model lateral
   geniculate nucleus (LGN) cells is used to enhance contrast at line ends
   and other areas of boundary discontinuity. The result is an increase in
   the model's analog of perceived brightness just beyond a dark Line's
   end, akin to what have been termed ``brightness buttons{''} (Kennedy,
   1979). V1 to LGN feedback is discussed in relation to the larger BCS/FCS
   architecture and a simulation of the Ehrenstein illusion is discussed.},
