Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {The purpose of the project presented in this article is to create a
   knowledge-sharing space which would encourage efficient collaboration
   between different disciplines concerned with heritage issues; a place
   which would facilitate the creation of links between different people
   and different countries throughout the world and which would encourage a
   better understanding of world heritage and in particular, sites in
   peril. Aggressive urban development and the rampant growth of tourism
   pose major problems to world heritage sites. With the aid of Information
   Communication Technologies (ICT) and based on the results of
   collaborative web-based research, the proposed knowledge-sharing space
   could be considered as a wiki (collaborative website) where one could
   integrate information pertaining to heritage, update it regularly and
   share this information with others. This communication platform would
   then contribute to a shared decision making process and encourage the
   understanding of heritage from a sustainable development perspective
   without affecting the integrity of the site.},
