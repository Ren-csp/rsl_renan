@article{ WOS:000266855900010,
Author = {Mills, Carol Bergfeld and Metzger, Shari R. and Foster, Catherine A. and
   Valentine-Gresko, Melaina N. and Ricketts, Stephanie},
Title = {Development of color-grapheme synesthesia and its effect on mathematical
   operations},
Journal = {PERCEPTION},
Year = {2009},
Volume = {38},
Number = {4},
Pages = {591-605},
Note = {78th Annual Meeting of the Eastern-Psychological-Association,
   Philadelphia, PA, MAR, 2007},
Organization = {Eastern Psychol Assoc},
Abstract = {SE, a 19-year-old female college student and a color-grapheme
   synesthete, reported consistent synesthetic experiences (photisms) for
   digits, and most letters in the Roman and Hebrew alphabets over a
   6-month period. Photisms for later-learned Hebrew letters were
   influenced by those of the Roman alphabet and photisms for auditorily
   presented words were influenced by the spelling of the words. As
   hypothesized, in two studies, SE's Solution times for addition problems
   were significantly slower when the colors of the digits in the problems
   mismatched her synesthetic photisms than when they matched or were in
   black (p < 0.001), whereas color had no effect on solution times for six
