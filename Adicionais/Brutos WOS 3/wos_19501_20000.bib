@article{ WOS:A1996VA69300017,
Author = {Hussain, M},
Title = {Suggested new directions for research for the second phase of Health
   Canada's Great Lakes Health Effects program: Conclusions from a workshop},
Journal = {TOXICOLOGY AND INDUSTRIAL HEALTH},
Year = {1996},
Volume = {12},
Number = {3-4},
