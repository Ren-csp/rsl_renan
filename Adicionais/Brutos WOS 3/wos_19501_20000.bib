Pages = {151-154},
Note = {Conference on Becquerels Legacy - A Century of Radioactivity, LONDON,
   ENGLAND, FEB 29-MAR 01, 1996},
Abstract = {The increasing role of the legal process in resolving questions of
   causation in radiation effects cases is discussed. The protective and
   corrective functions of the law are contrasted. The manner in which
   causation is approached in civil litigation is compared with the
   epidemiological method. The burden and standards of proof, the concept
   of material contribution and the approach to dosimetry, the special
   nature of multi-party cases, and the public perception of judicial
   determination on causation questions are mentioned.},
