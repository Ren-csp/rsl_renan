Title = {Stochastic performance assessment and optimization strategies of the
   water supply network transition of Kiruna during city relocation},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2015: FLOODS, DROUGHTS,
   AND ECOSYSTEMS},
Year = {2015},
Pages = {853-862},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {The small Swedish town ``Kiruna{''} has to be moved within the next
   decades. Thereby major parts of the city have to be abandoned and
   relocated step by step until the end of the century, due to ground
   settlement caused by the expansion of underground mining activities
   below the south western part of the town. In the following work this
   city transformation and its impacts on the water supply network are
   investigated and analyzed. The evaluation of the network performance is
   carried out by different indicators and indices, including hydraulic and
   quality assessments as well as the indirect index of network entropy.
   With this method it is possible to assess the performance of the water
   distribution system at specific time intervals during the whole
   relocation phase from the years 2012 to 2100. Furthermore, drawbacks
   during the network transition are identified and strategies for
   optimizing the water supply network during the relocation process are
   tested. The results show performance drops during the city relocation,
   causing partially insufficient water distribution networks. However,
   after the optimization, performance improvements up to 30 percent are
   accomplished which enhance the water supply network to a sufficient
   level of service.},
