Title = {Study on Collapse Mechanism of Steel Frame Structure under High
   Temperature and Blast Loading},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON ENERGY EQUIPMENT SCIENCE AND ENGINEERING
   (ICEESE 2017)},
