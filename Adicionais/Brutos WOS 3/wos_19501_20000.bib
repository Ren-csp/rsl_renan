Title = {Integration as Didactic Prerequisite for Creating Situations of
   Axiological Choice to be Made by Students},
Booktitle = {TRENDS IN THE DEVELOPMENT OF PSYCHO-PEDAGOGICAL EDUCATION IN THE
   CONDITIONS OF TRANSITIONAL SOCIETY (ICTDPP-2019)},
