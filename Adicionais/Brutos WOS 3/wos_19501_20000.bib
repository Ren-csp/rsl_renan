Organization = {Soc Amer Foresters},
Abstract = {The US Forest Service develops a strategic view of the determinants of
   future changes in the US forest sector including those that involve
   different types of technologies. Three broad types of technologies are
   of interest: changes in consumer tastes and preferences that act to
   shift the demand for various types of wood; changes in processing
   technologies; and technical improvements that improve timber growth or
   properties. Each of these change our perceptions of the future for the
