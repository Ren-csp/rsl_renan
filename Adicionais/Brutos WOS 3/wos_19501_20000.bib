Title = {Evaluation of horticultural activity from the perspective of
   administrators and participants at facilities supporting higher brain
   dysfunction},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
Volume = {1345},
Pages = {243-250},
Note = {8th International Conference on Landscape and Urban Horticulture, ELECTR
   NETWORK, DEC 15-17, 2021},
Organization = {Int Soc Hort Sci, Div Landscape \& Urban Hort; Int Soc Hort Sci, Div
   Protected Cultivat \& Soilless Culture; Int Soc Hort Sci, Working Grp
   Urban Hort; Univ Catania, Dept Agr, Food \& Environm; Natl Res Council,
   Res Inst Terrestrial Ecosystems; Int Soc Hort Sci, Working Grp Landscape
   Hort},
Abstract = {We evaluated horticultural activities from the perspective of
   administrators and participants at facilities supporting higher brain
   dysfunction (traumatic brain injury and cerebral vascular disorder). We
   queried program administrators with questionnaires and interviews and
   found that 1) administrators need some horticultural expertise to manage
   activities successfully; 2) participants interact and communicate with
   each other during the activity; and 3) participants appear to enjoy the
   activities, although this was difficult to assess. We used interpretive
   structural modeling (ISM) to identify relationships between
   participants' interest in plant and horticultural activities, awareness
   of their disability, and increased communication. Text mining analysis
   results of the participant's impression suggest that 1) temperature
   extremes made horticultural activities participation more difficult and,
   2) cultivation, harvesting, cooking, eating, and communication were
   enjoyable activities. Administrators pointed both negative and positive
   aspects of the horticultural activities; however, in general, we found
   that administrators with experience in horticultural activities were
   successful. We also concluded that while inclement weather can hinder
   and even prevent execution and enjoyment of horticultural activities, it
   was clear that the participants enjoyed working together.},
