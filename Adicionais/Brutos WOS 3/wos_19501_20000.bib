@article{ WOS:000180063700005,
Author = {Tarkowski, S},
Title = {Risk assessment of chemicals - the role of epidemiological methods},
Journal = {INTERNATIONAL ARCHIVES OF OCCUPATIONAL AND ENVIRONMENTAL HEALTH},
Year = {2002},
Volume = {75},
Number = {S},
Pages = {S17-S20},
Month = {OCT},
Note = {29th Congress on Occupational and Environmental Health in the Chemical
   Industry, PRAGUE, CZECH REPUBLIC, SEP 03-06, 2001},
Abstract = {The paper discusses methodological approaches in the evaluation of
   epidemiological data for health risk assessment. Methods: The discussion
   is based on the overviews of epidemiological evidence for health hazard
   characterisation from primary and multiple studies and for health impact
   assessment. Results: Evaluation of the epidemiological evidence requires
   a systematic review of relevant studies with the aim of achieving
   transparency with regard to applied methods and procedures, avoidance of
   bias and validity of conclusions. Epidemiological studies are useful for
   health hazard characterisation if they provide estimates for
   exposure-response relationships. Epidemiological evidence plays a key
   role in health impact assessment of complex causes such as industrial
   emissions or urban traffic. The WHO Expert Group identified ten major
   steps in the quantification of the health impact assessment.
   Conclusions: There is a continuous need that future epidemiological
   studies should seek, where possible, to provide results that enhance the
   health impact assessment at the interface of epidemiology, other fields
   of research, and decision making.},
