@article{ WOS:000077893200046,
Author = {Murano, K and Mukai, H and Hatakeyama, S and Oishi, O and Utsunomiya, A
   and Shimohara, T},
Title = {Wet deposition of ammonium and atmospheric distribution of ammonia and
   particulate ammonium in Japan},
