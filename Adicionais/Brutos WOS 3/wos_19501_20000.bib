@article{ WOS:A1994NZ08900011,
Author = {VOORHIS, J},
Title = {TNRCC POLLUTION PREVENTION OUTREACH PROGRAMS TO INDUSTRY},
Journal = {WASTE MANAGEMENT},
Year = {1994},
Volume = {14},
