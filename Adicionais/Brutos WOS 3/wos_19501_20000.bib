@inproceedings{ WOS:000346067900234,
Author = {Konsoula, Z. and Tsangari, H. and Christou, S. and Georgiou, K. and
   Ioannou, K. and Kleanthous, S. and Pashiardis, S. and Pavlou, P. and
   Yamasaki, E. N.},
Editor = {Lekkas, TD},
Title = {IMPACT OF THERMAL STRESS ON PUBLIC HEALTH IN CYPRUS},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {With climate change, the world is expected to experience not only a
   higher number of heat waves, but also heat waves of increased intensity
   and duration. The most direct health effects expected are increased
   mortality and morbidity rates associated with the exposure to high
   ambient temperatures.
   The 2003 heat wave in Western Europe was a dramatic illustration of the
   threats associated with exposure to hot weather. It made many
   governments across Europe to recognize the need for health warning
   systems aiming to minimize the impact of future heat waves, especially
   within the context of an increasingly hotter and less stable climate.
   Interventions to reduce the effects of heat on mortality, however,
   require an understanding of the temperature-mortality relationship.
   In the present work, an attempt was made to establish a possible
   relationship between mortality and temperature in Cyprus throughout the
   year, with special emphasis to the warm months of April through
   September. Using data obtained from various governmental departments a
   database with health and meteorological variables was created. Daily
   mortality data for each of the five districts in Cyprus were analyzed
   over the period 2004-2009. The counts involved deaths of people that
   lived permanently in the free areas of Cyprus, while cases of death due
   to external causes were excluded.
   Preliminary results regarding the impact of thermal stress showed that
   during the warm months of the year, temperature had a significant effect
   on all-cause mortality in Cyprus. The relationship between temperature
   and mortality appeared to be V-shaped, and a hot temperature threshold
   could be seen. The risk of mortality in Cyprus increased rapidly for
   temperatures above 33.7 degrees C. Moreover, the risk was much higher on
   the current day and within the next couple of days, and was reduced
   significantly after two days. Furthermore, the analysis of the data for
   each of the five districts in Cyprus revealed significant differences
   between each district and Cyprus as a whole, with different threshold
   temperatures.},
Publisher = {GLOBAL NEST, SECRETARIAT},
Address = {UNIV, AEGEAN, 30, VOULGAROKTONOU STR, ATHENS, GR 114 72, GREECE},
Type = {Proceedings Paper},
Language = {English},
