@inproceedings{ WOS:000452696800016,
Author = {Razina, Tatyana and Volodarskaya, Elena},
Editor = {Sheridan, S and Veraksa, N},
Title = {OPPORTUNITIES AND SPECIFICITY OF APPLYING THE DRAW-A-SCIENTIST TEST
   TECHNIQUE ON RUSSIAN SCHOOLCHILDREN},
Booktitle = {ECCE 2018: VII INTERNATIONAL CONFERENCE EARLY CHILDHOOD CARE AND
   EDUCATION},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2018},
Volume = {43},
Pages = {109-117},
Note = {7th International Conference Early Childhood Care and Education (ECCE),
   Moscow, RUSSIA, MAY 17-20, 2018},
Abstract = {The present article discusses the results of the first-ever
   Draw-a-Scientist Test (DAST) used in Russia to study the image of a
   scientist which children develop at the age of 9-11 years old. The
   patterns revealed in their perception of a scientist are compared with
   those obtained by means of DAST in other countries on a similar sample.
   They have found the image of a scientist to remain stable regardless of
   the cultural context. Younger schoolchildren are characterized by
   structuring the image of a scientific worker on the basis of such
   stereotyped criteria or indicators, attributing a person to the
   scientific community, as: clothing, eyeglasses, facial hair growth,
   symbols of research and knowledge, scientific results and relevant
   captions. In addition to these, junior schoolchildren's social and
   perceptive imagery includes gender, race, age, object environment,
   elements of danger and facial expressions. The following stereotypic
   indicators of the image of a scientist are found to be specific to the
   domestic sample: a scientist has his hair standing on end, a bald patch
   on his head, a disproportionately large head, dirty clothes, and is
   young. There are general trends, such as: uncertainty of the image and
   its archaization. The results obtained show that children possess
   incomplete information about the activity of scientists and have an
   undeveloped and amorphous perception of this image. (C) 2018 Published
