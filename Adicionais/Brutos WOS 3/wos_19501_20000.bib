@inproceedings{ WOS:000226029600006,
Author = {Carignan, V and Drapeau, P},
Editor = {Chamberlain, D and Wilson, A},
Title = {Are sensitive avian species still present in fragmented woodlots of
   southwestern Quebec (Canada)?},
Booktitle = {AVIAN LANDSCAPE ECOLOGY: PURE AND APPLIED ISSUES IN THE LARGE-SCALE
   ECOLOGY OF BIRDS},
Year = {2002},
Pages = {56-59},
Note = {11th Annual Conference of the
   International-Association-for-Landscape-Ecology, Univ E Anglia, Norwich,
   ENGLAND, SEP 10-13, 2002},
Organization = {Int Assoc Landscape Ecol, UK Chapter},
Abstract = {The potential effects of the continued fragmentation of the deciduous
   forests of eastern North America have prompted many authors to develop
   methods to evaluate the ecological value of residual habitats for forest
   birds. As part of these efforts, we collected data on six avian species
   known to be sensitive to forest fragmentation in the southwestern
   portion of the Province of Quebec (Canada). We surveyed woodlots varying
   in size and configuration within landscapes (100 km(2)) varying in their
   proportion of forest cover (<10\%, 10-30\%, 40-50\%, >70\%) and located
   within different regional contexts (1000 km(2): urban/suburban,
   agricultural, agro-forested, forested). Among other methods, conspecific
   playbacks were used to determine the level of reproductive activity. The
   results from this study will be used to assess the ecological value of
   selected woodlots by identifying intrinsic and extrinsic characteristics
   that are important in maintaining populations of fragmentation-sensitive
   species. Eventually, the results will be used to establish conservation
   priorities for the completion of the network of protected areas in
   Quebec.},
