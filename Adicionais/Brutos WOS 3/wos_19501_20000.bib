   Margaret and Bowyer, Susan M. and Lajiness-O'Neill, Renee and Brennan,
   Jonathan},
Editor = {Bigand, E and Tillmann, B and Peretz, I and Zatorre, RJ and Lopez, L and Majno, M},
Title = {Multimodal imaging of temporal processing in typical and atypical
   language development},
