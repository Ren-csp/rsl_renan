@inproceedings{ WOS:000394555000005,
Author = {Leidlmair, Karl},
Editor = {Todea, GV},
Title = {VIRTUAL INTIMACY IN SOCIAL NETWORKS: LOSSES AND WINS},
Booktitle = {APPLIED PSYCHOLOGY, THE PERSON AND THE TECHNOLOGIES OF THE XXI CENTURY},
Series = {Conferinta Internationala de Psihologie Aplicata},
Year = {2010},
Pages = {35-41},
Note = {6th International Conference on Applied Psychology, the Person and the
   Technologies of the 21st Century, Timisoara, ROMANIA, OCT 08-11, 2009},
Organization = {Uniunea Fundatia Augusta},
Abstract = {Online Relationships are a controversial issue. They are stamped as a
   narcissistic withdrawl in a virtual reality on the one hand and as an
   enhancement of the limitations constituted by the body on the other
   hand. Those points of view remain in most cases only theoretical
   positions and lack a considerable investigation,of the actual social
   interactions which can take place in social networks. The present study
   is the result of a qualitative field research. Center of interest are
   the often observed high loaded emotional relationships which are
   developped between interlocutors in chatrooms. The intensity of such
   emotions, however, is investigated in most cases within the framework of
   a quantitative research. For the purposes of this research the leading
