Pages = {247-251},
Note = {International Conference on Management of Technology, Taiyuan, PEOPLES R
   CHINA, 2008},
Organization = {Shanxi Prov Assoc Risk Management; Shanxi Univ Finance \& Econ},
Abstract = {The study on the homology of air pollutants can make the prevention and
   control of air pollution more definite and effective. The correlation
   between pollutants was used to study the homology of air pollutants in
   this paper. When the correlation coefficient (r) of tow pollutants is
   greater than or equal to 0.5 (r >= 0.5) the two pollutants are looked
   upon as homological. When r <0.5 they are looked upon as not
   homological. The homology of air pollutants was studied in Shanghai 18
   districts in this paper. The results showed that the SO2 and PM10 of
   some urban districts were not homological because the districts were not
   coal-burning, NO2 and PM10 were homological because of the discharge of
   car's off-gas and the SO2 and NO2 or NO2 and PM10 of some suburban
   districts were not homological because of coal-burning or oil-burning.
   The fact showed that studied homology of air pollutants by correlation
   was feasible and reliable.},
