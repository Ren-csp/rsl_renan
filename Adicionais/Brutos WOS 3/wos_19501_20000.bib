@article{ WOS:000432429600108,
Author = {Prayitno, Gunawan and Surjono and Hidayat, A. R. Taufiq and Maulidatuz,
   Z. Dwi and Kinanti, P. Nindya},
Title = {The Influences of Social Capital in Land Use Change in Pandaan
   Sub-District of Pasuruan Regency, East Java, Indonesia},
