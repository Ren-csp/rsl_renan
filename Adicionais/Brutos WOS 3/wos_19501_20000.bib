@inproceedings{ WOS:000400168900069,
Author = {Abtew, W. and Melesse, A. M.},
Editor = {Pathak, CS and Reinhart, D},
Title = {Landscape Dynamics and Evapotranspiration},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2016: HYDRAULICS AND
   WATERWAYS AND HYDRO-CLIMATE/CLIMATE CHANGE},
Year = {2016},
Pages = {668-678},
Note = {16th Annual World Environmental and Water Resources Congress of the
   Environmental-and-Water-Resources-Institute (EWRI), Amer Soc Civil
   Engineers, West Palm Beach, FL, MAY 22-26, 2016},
Organization = {Amer Soc Civil Engineers, Environm \& Water Resources Inst},
Abstract = {Surface characteristics and the availability of moisture are factors
   influencing evapotranspiration. Energy from incoming solar radiation is
   fractioned into sensible heat (raising temperature), latent heat
   (evapotranspiration) and change in stored energy. Non-vegetated dry
   surfaces appropriate more of the incoming energy into sensible heat
   resulting in an increase in surface temperature. Evapotranspiration has
   a surface cooling effect. Surface characteristics and energy flux
   fractionation have implications on regional hydrologic processes
   affecting water resources. Land degradation and desert expansion can be
   attributed to a decrease in vegetated surface and changes in energy
   fractionation. On the contrary, climate modulating benefits of urban
   greening, wetland restoration and afforestation can be cited. Case
   studies of landscape change impact on regional climate have been
   reported in Africa, Brazil, China and the United States.},
