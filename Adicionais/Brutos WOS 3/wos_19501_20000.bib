@inproceedings{ WOS:000280689300094,
Author = {Sun Fengming and Shi Lili and Xi Wenchuan and Wu Chao},
Editor = {Zhang, H and Zhang, H},
Title = {The Road of Sustainable Development of Eco-tourism - The Planning Design
   of Zhuhai Qi'ao Island},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {480-484},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Since 2008, in order to raise the city's image and its overall cultural
   taste, Zhuhai municipal government decided to develop Qi'ao Island which
   is located in the east of Zhuhai city's Hi-tech economic development
   Zone. Which is intended to make Qi'ao Island the ecological
   demonstration zone of Zhuhai, then promote the development of the whole
   city's tourism industry.
   Eco-tourism in the original as a new form of tourism aims to protect the
   environment, return to nature, changing the old development pattern of
   tourism. But now, eco-tourism is innovated greatly in terms of concept,
   approach, requirements, etc., and becomes the emphasis development model
   of the theory of sustainable tourism development.
   Qi'ao Island is in the Pearl River mouth, north of Shenzhen, Hong Kong,
   east of Macao; surrounded by sea in the north, the south and the east;
   and it is the only access to planning Lingdingyang Bridge. Its coastline
   is up to 3.3km. So it has a good advantage of geographic conditions.
   Qi'ao island has a land area of 19 square kilometers, containing sea
   area of 26.5 square kilometers.
   Planning and design are closely linked to the romantic cultural origin
   of Zhuhai, and combined with fishing girl legend and female couple
   Avenue origins. It explores the connotation and extension of love, and
   designs tourism products of looking for, witnessing, and and reviewing
   love for tourists of different age groups. `Environmental reproduction'
   is a move to extend eco-environmental resources of Qi'ao. It refers to
   the introduction and conservation of mangrove vegetation, and the
   establishment of forest-dwelling biomes, highlighting the ecological
   value and tourism value of wetlands. In order to maintain sustainable
   development of this project ecologically, five stations are established,
   primarily functioning as monitoring environmental quality, tracking
   enviromental changes and protecting environment.
   Qi'ao will become a `resort, city of honeymoon, and eco-civilized city'.
   Zhuhai will create tourist products and tourist attractions of the area,
   integrate Qi'ao's advantageous resources, focus on the high-end vacation
   market demand of the Pearl River Delta, and propose the development
   model, with love and ecology as its main planning concept.
   By demonstrating the design projects, this thesis explores sustainable
   development of the project of eco-tourism. The paper puts forward the
   necessity and importance of making full use of the natural landscape,
   respecting and protecting the natural ecological landscape planning in
   modern planning and design systems. Meanwhile, the author tries to seek
   a more humane, effective and ecological sustainable development which
   will integrate building and ecological system, enhance the landscape of
   architecture and highlight the ecological design of landscape.},
Publisher = {AUSSINO ACAD PUBL HOUSE},
Address = {PO BOX 893, MARRICKVILLE, NSW 2204 00000, AUSTRALIA},
Type = {Proceedings Paper},
Language = {English},
