@inproceedings{ WOS:000247273200012,
Author = {Zachary, D. S. and Farooq, B.},
Editor = {Borrego, CA and Brebbia, CA},
Title = {Satellite imagery used in constructing emission maps for air quality
   modelling in the Dubai-Sharjah (UAE) region},
Booktitle = {AIR POLLUTION XV},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2007},
Volume = {101},
Pages = {119+},
Note = {15th International Conference on Modelling, Monitoring and Management of
   Air Pollution, Algrave, PORTUGAL, APR 23-25, 2007},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {Streamlined construction of emissions maps using satellite imagery (JPEG
   - RGB images) is discussed. A filter algorithm (MATLAB) is used to
   extract a road network which is subsequently used as an input to a
   ``fast{''} (reduced-order) urban air shed model for the Dubai-Sharjah
   (UAE) region. Validation of the model is done using averaged air quality
   scenarios in an extended (one month) campaign, revealing that O-3
   production is VOC limited in mid to late afternoon (peak ozone times).
   The modelled NOx and O-3 concentrations are in rough agreement with the
   three measuring stations used in this study (two in the city center and
   one at the city periphery); high O-3 levels are predicted down-wind
