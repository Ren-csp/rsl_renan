@inproceedings{ WOS:000225309500117,
Author = {Kim, W and Navarro, DJ and Pitt, MA and Myung, IJ},
Editor = {Thrun, S and Saul, K and Scholkopf, B},
Title = {An MCMC-based method of comparing connectionist models in cognitive
   science},
Booktitle = {ADVANCES IN NEURAL INFORMATION PROCESSING SYSTEMS 16},
Series = {ADVANCES IN NEURAL INFORMATION PROCESSING SYSTEMS},
Year = {2004},
Volume = {16},
Pages = {937-944},
Note = {17th Annual Conference on Neural Information Processing Systems (NIPS),
   CANADA, DEC   08, 2003},
Abstract = {Despite the popularity of connectionist models in cognitive science,
   their performance can often be difficult to evaluate. Inspired by the
   geometric approach to statistical model selection, we introduce a
   conceptually similar method to examine the global behavior of a
   connectionist model, by counting the number and types of response
   patterns it can simulate. The Markov Chain Monte Carlo-based algorithm
   that we constructed finds these patterns efficiently. We demonstrate the
   approach using two localist network models of speech perception.},
