Note = {10th Bethel Cleveland-Clinic Symposium, BIELEFELD, GERMANY, APR, 1999},
Abstract = {Health related quality of life is outlined as a concept to assess the
   patient's perception and evaluation of her or his own health and related
   interventions. The chapter presents an overview of quality of life
   measures developed for use in epilepsy and focuses on issues involved in
   using this measures in research and practice, especially as concerns the
   clinical significance of results. The quality of life research in
   epilepsy is seen as a challenge for further efforts to improve treatment
   and comprehensive care.},
