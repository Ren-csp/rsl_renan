@article{ WOS:A1996VN11000003,
Author = {Egyed, M and Wood, GC},
Title = {Risk assessment for combustion products of the gasoline additive MMT in
   Canada},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1996},
Volume = {189},
Pages = {11-20},
