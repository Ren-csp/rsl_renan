Title = {The Analysis of Climate Fluctuation Impact on Landscape Pattern Dynamic
   Changes in Beihe Basin},
Booktitle = {2012 4TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
   INFORMATION APPLICATION TECHNOLOGY (ESIAT 2012)},
Series = {Advances in Biomedical Engineering},
Year = {2013},
Volume = {14},
Pages = {374-378},
Note = {4th International Conference on Environmental Science and Information
   Application Technology (ESIAT 2012), Bali, INDONESIA, DEC 01-02, 2012},
Abstract = {Human activities make drastic changes on the land surface; climate
   changes also make important impact on the landscape pattern changes
   process. In this study, four scenes of Landsat MSS and TM imagery(in
   1980, 1991, 2001 and 2009)were used to extract the landscape pattern
   data, meteorological observation data within the past 30 years from 1980
   to 2009 were used to analysis the climate fluctuation. The Landscape
   evolution process show that urban area expanded continuously, paddy
   field area decreased continuously, the proportion of dry farming field
   increased rapidly, forest area changes were fluctuating. Meanwhile, the
   climate changes show that the trend of temperature was increased, as
   well as evapotranspiration, while precipitation and humidness decreased
   in the past years. The climate fluctuation has made a negative effect on
   hydrologic balance in the Beihe basin, which leads to paddy field shrink
   rapidly because of water resources shortage. The main impact of climate
   fluctuation on wetland is the area small fluctuation after 1991.},
