@inproceedings{ WOS:000482722700012,
Author = {Tsao, Doris},
Editor = {Bargmann, C and Bavelier, D and Sejnowski, T and Stewart, D and Stillman, B},
Title = {The Macaque Face Patch System: A Window into Object Representation},
Booktitle = {COGNITION, VOL 79, 2014},
Series = {Cold Spring Harbor Symposia on Quantitative Biology},
Year = {2014},
Volume = {79},
Pages = {109-114},
Note = {79th Cold Spring Harbor Symposium on Quantitative Biology, Cold Spring
   Harbor, NY, MAY 28-JUN 02, 2014},
Organization = {Forest Labs; Swartz Fdn; Agilent Technologies; Bristol Myers Squibb Co;
   Genentech; Thermo Fisher Sci, Life Technologies; New England BioLabs;
   Monsanto Co; DuPont Pioneer Hi Bred Int; HudsonAlpha Inst Biotechnol},
Abstract = {The macaque brain contains a set of regions that show stronger fMRI
   activation to faces than other classes of object. This ``face patch
   system{''} has provided a unique opportunity to gain insight into the
   organizing principles of IT cortex and to dissect the neural mechanisms
   underlying form perception, because the system is specialized to process
   one class of complex forms, and because its computational components are
   spatially segregated. Over the past 5 years, we have set out to exploit
   this system to clarify the nature of object representation in the brain
   through a multilevel approach combining electrophysiology, anatomy, and
   behavior. These experiments reveal ( 1) a remarkably precise
   connectivity of face patches to each other, ( 2) a functional hierarchy
   for representation of view-invariant identity comprising at least three
   distinct stages along the face patch system, and ( 3) the computational
   mechanisms used by cells in face patches to detect and recognize faces,
   including measurement of diagnostic local contrast features for
   detection and measurement of face feature values for recognition.},
Publisher = {COLD SPRING HARBOR LABORATORY PRESS},
Address = {10 SKYLINE DRIVE, PLAINVIEW, NY 11803-2500 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Tsao, D (Corresponding Author), CALTECH, Div Biol \& Biol Engn \& Computat \& Neural Syst, Pasadena, CA 91125 USA.
   Tsao, Doris, CALTECH, Div Biol \& Biol Engn \& Computat \& Neural Syst, Pasadena, CA 91125 USA.},
DOI = {10.1101/sqb.2014.79.024950},
