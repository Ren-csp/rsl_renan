@inproceedings{ WOS:000392215900024,
Author = {Hostgaard, Anna Marie and Bertelsen, Pernille and Nohr, Christian},
Editor = {Safran, C and Reti, S and Marin, HF},
Title = {How are clinicians involved in EHR planning? A process analysis case
   study of a region in Denmark},
Booktitle = {MEDINFO 2010, PTS I AND II},
Series = {Studies in Health Technology and Informatics},
Year = {2010},
Volume = {160},
Pages = {121-125},
Note = {13th World Congress on Medical and Health Informatics of
   International-Medical-Informatics-Association (Medinfo), Cape Town,
   SOUTH AFRICA, SEP 12-15, 2010},
Organization = {Int Med Informat Assoc},
Abstract = {Experience shows that to achieve a successful implementation of EHR
   clinicians must obtain joint ownership of the decisions made during the
   EHR-process. The EHR planning process in the Region of North Jutland,
   Denmark was studied with the aim of answering the question; ``Why are
   not all Danish physicians overjoyed by the introduction of EHR? A case
   study was carried out from Oct. 2003 till April 2006 using process
   analysis. The EHR project management's strategy meant that there was no
   workload reduction. This was seen as one of the main barriers for the
   physicians to achieve real influence. History shows that clinician's on
   the one hand and administrators on the other have different perceptions
   of the purpose of the patient record and that they both have struggled
   to influence this definition. To date, the administrators have won the
   battle. This was the major reason for the approach chosen for the EHR
   planning process in North Jutland, Denmark. It explains the conditions
   made available for the physicians, which led to their role being reduced
   to clinical consultants rather than real participants.},
Publisher = {IOS PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
