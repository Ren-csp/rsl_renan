@article{ WOS:000074631700007,
Author = {Hankins, C},
Title = {Changes in patterns of risk},
Journal = {AIDS CARE-PSYCHOLOGICAL AND SOCIO-MEDICAL ASPECTS OF AIDS/HIV},
Year = {1998},
Volume = {10},
Number = {2},
Pages = {S147-S153},
