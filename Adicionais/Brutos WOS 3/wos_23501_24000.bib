Title = {PARANORMALITY vs. SCIENTIFIC PSYCHOLOGY: WRONG BELIEFS AMONG
   HEALTH SCIENCE STUDENTS},
Booktitle = {INTERNATIONAL CONFERENCE ON EDUCATION AND EDUCATIONAL PSYCHOLOGY (8TH
   ICEEPSY)},
