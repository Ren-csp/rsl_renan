@inproceedings{ WOS:000232193800069,
Author = {Cyganek, B},
Editor = {Duch, W and Kacprzyk, J and Zadrozny, S},
Title = {Artificial neural receptive field for stereovision},
Booktitle = {ARTIFICIAL NEURAL NETWORKS: BIOLOGICAL INSPIRATIONS - ICANN 2005, PT 1,
   PROCEEDINGS},
