@article{ WOS:A1997XF15400034,
Author = {Weingartner, A and Schafer, E and Staubmann, K and Urban, W and
   Loiskandl, W and Rassinger, M and Schachner, H},
Title = {New approaches to the simulation and optimisation of adsorption
   processes},
