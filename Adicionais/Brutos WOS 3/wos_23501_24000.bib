@inproceedings{ WOS:000392856300254,
Author = {Hawley, Harmonie A. and Conder, Colby},
Editor = {Karvazy, K and Webster, VL},
Title = {Monitoring Temporal Trends of Water Quality on Two Southern California
   Coastal Streams},
Booktitle = {World Environmental and Water Resources Congress 2015: Floods, Droughts,
   and Ecosystems},
Year = {2015},
Pages = {2590-2598},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {A study was conducted on two potentially impaired surface waters in
   drought stricken Southern California. An intensive field study was
   conducted on Trabuco Creek in the winter of 2011-2012 to assess wet and
   dry nutrient conditions. Aliso Creek was studied for over three
   continuous months during the summer of 2012 for background, dry weather
   nutrient concentrations. Nitrate, phosphate, water temperature, and pH
   data were collected at both sites. In addition, turbidity was collected
   on Trabuco Creek.
   Nitrate concentrations ranged from 0.23 to 0.9 mg/L as N on Trabuco
   Creek with the maximum concentration occurring during a rain event and
   ranged from 0.3 to 1.9 mg/L as N in Aliso Creek. The phosphate
   concentration ranged from 0.67 to 1.53 mg/L with the maximum
   concentration occurring during a rain event on Trabuco Creek and ranged
   from 0.44 to 2 1 mg/L in Aliso Creek. The pH was neutral during both
   campaigns. The turbidity increased almost 3-fold during the rain event
   on Trabuco Creek.
   No linear correlation was found between nitrate and phosphate
   concentrations in Aliso Creek, but a correlation was found in Trabuco
   Creek. Neither nitrate nor phosphate concentrations correlated with
   water temperature in either creek. Correlations were found between
   nitrate and phosphate versus turbidity during the rain storm on Trabuco
   Creek. This indicates that the Trabuco Creek was influenced by runoff
   from a source containing these nutrients, which is common in urban
   watersheds. Aliso Creek may have been influenced by nutrient cycling or
   aggregate nutrient sources such as atmospheric deposition. This study
   emphasizes the need for further study of Southern California water
   basins.},
