@inproceedings{ WOS:A1996BJ57Z00002,
Author = {Wee, JL},
Editor = {Kristiansen, J and Cronberg, G},
Title = {Molecular investigations of heterokont comparative biology: recent and
   emerging trends},
Booktitle = {NOVA HEDWIGIA, BEIHEFT 114: CHRYSOPHYTES: PROGRESS AND NEW HORIZONS -
   CHRYS 95},
Year = {1996},
Pages = {7-27},
Note = {4th International Chrysophyte Symposium (CHRYS 95), HOSTERKOB, DENMARK,
   MAY 22-27, 1995},
Abstract = {During the last decade, molecular methods have had significant and
   varying impacts on heterokont comparative biology. Most investigations
   emphasized the chloroplast genome or sequences from nuclear-encoded,
   ribosomal genes. Refinement of DNA isolation protocols, advent of
   `'universal primers'' and the Polymerase Chain Reaction, automated
   sequencing and increased accessibility of DNA sequence data bases have
   expanded data-gathering efficiency and increased data set sizes. Because
   independent data sets have been easier to obtain, the testing of
   specific phylogenetic hypotheses has been facilitated and analytical
   approaches have been refined. Relationship concepts, primarily at
   phylum/class levels, and perceptions of cellular evolution have been
   altered. New approaches have emphasized ecological studies and extended
   studies to genus/species levels and poorly investigated genomes. For
   example, oligonucleotide probes with fluorescent markers show promise
   for studying nannoplankton population structures, run-on transcription
   protocols measured in situ cellular responses, and DNA genotypes of
   toxic strains were correlated to biogeography and toxin levels. This
   paper reviews studies documenting these impacts and the associated
   methodological strategies, and summarizes the utility and limitations of
   molecular approaches to heterokont comparative biology.},
Publisher = {GEBRUDER BORNTRAEGER},
