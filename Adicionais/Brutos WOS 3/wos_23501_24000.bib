@inproceedings{ WOS:001558899800005,
Author = {Rocha, Thayssa and Davila, Nicole and Vaccari, Rafaella and Menezes,
   Nicoly and Mota, Marcelle and Monteiro, Edward and de Souza, Cleidson R.
   B. and Pinto, Gustavo},
