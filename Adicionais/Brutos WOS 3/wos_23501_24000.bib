@article{ WOS:000172521600004,
Author = {Van Buynder, PG and Oughtred, T and Kirkby, B and Phillips, S and
   Eaglesham, G and Thomas, K and Burch, M},
Title = {Nodularin uptake by seafood during a cyanobacterial bloom},
