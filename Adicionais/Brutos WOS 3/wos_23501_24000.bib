@inproceedings{ WOS:000165805000015,
Author = {Lee, SM and Kang, JM},
Editor = {Singh, VP and Seo, WI and Sonu, JH},
Title = {A study on quality of injection water for stable management in a
   underground storage caverns},
Booktitle = {ENVIRONMENTAL MODELING},
Year = {1999},
Pages = {153-162},
Note = {International Conference on Water, Environment, Ecology, Socioeconomics
   and Health Engineering (WEESHE), SEOUL NATL UNIV, SEOUL, SOUTH KOREA,
   OCT 18-21, 1999},
Organization = {Seoul Natl Univ; Louisiana State Univ; Korean Soc Civil Engineers; Korea
   Water Resources Assoc; Korean Soc Water \& Waste Water; Korean Soc Agr
   Engn},
Abstract = {Proper establishment of criteria of an injection water preventing
   clogging phenomena is one of the crucial factors in managing underground
   storage caverns with a water curtain system, an artificial
   water-pressure maintenance method. In some areas, criteria of drinking
   water are applied to the quality of injection water. This costs a lot
   and it is very difficult to secure sufficient amount of injection water
   occasionally. Therefore, it is very important to establish appropriate
   criteria of injection water.
   In this study, water samples from surface water to seepage water in the
   storage cavern `U-1' located in Yeochon, Jeonlanamdo, Korea were
   collected and analyzed for chemical and bacteria constituents.
   Water-quality analysis shows that major geochemical reactions in the
   studied area are water-cement reaction and groundwater-seawater mixing.
   This experiment shows that three elements such as Ca, Mg, and seawater
   content cause clogging phenomena.
   Injection tests are performed using an artificially fractured core to
   determine maximum allowable content of the three elements. For the three
   elements above, pressure difference (DeltaP) across the core is
   observed, and the analysis of outlet fluids is performed with time.
   Experimental study shows that clogging doesn't depend on Mg contents
   because of magnesium dehydration barrier. In the other hand, allowable
   maximum content of Ca is found approximately 250ppm because calcite is
   precipitated if its content is high than 250ppm. If seawater content is
   higher than 30\%, bacteria attached to the fracture surface cause
   clogging phenomena by forming biofilm in the fracture.},
Publisher = {WATER RESOURCES PUBLICATIONS},
Address = {P O BOX 2841, LITTLETON, CO 80161 USA},
