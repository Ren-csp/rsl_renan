@article{ WOS:000187931800003,
Author = {Patton, D and Marlow, S and Ram, M and Sanghera, K},
Title = {Interpretive analysis as an evaluative tool: the case of Mustard.UK.Com,
   a high-growth small business programme},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
