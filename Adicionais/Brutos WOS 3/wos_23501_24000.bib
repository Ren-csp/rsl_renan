@inproceedings{ WOS:001419495800054,
Author = {Bhandari, Harsh and Palit, Sarbani},
Editor = {Mantoro, T and Lee, M and Ayu, MA and Wong, KW and Hidayanto, AN},
Title = {Looking Beyond the Haze: A Pyramid Fusion Approach},
Booktitle = {NEURAL INFORMATION PROCESSING, ICONIP 2021, PT III},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {13110},
Pages = {654-665},
Note = {28th International Conference on Neural Information Processing, ELECTR
   NETWORK, DEC 08-12, 2021},
Abstract = {Haze is a natural phenomenon caused mainly due to wide spread of dust
   particles from construction activities, smoke, water vapour causing poor
   visibility in the surrounding. Traditional methods normally involve
   enhancing the contrast of the image which fails in most of the cases
   except in light and uniform haze. Many neural network based algorithms
   have been developed which use hazy images and their corresponding
   non-hazy images i.e. ground truth, to create their model. However, such
   models are generally data specific and do not yield good results in
   every case as any specific benchmark data set with wide level of
   non-uniform haze is not available in public domain. In this paper, a
   simple and effective dehazing technique to increase the visual
   perception of a hazy image without any prior knowledge of the outdoor
   scene, has been proposed. Its most significant contribution is the
   formulation of an unique approach for extracting haze relevant features
   followed by an image fusion technique to finally obtain the resultant
   unhazed image with minimizing resource requirement.},
