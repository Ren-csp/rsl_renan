@article{ WOS:000166848500005,
Author = {De Houwer, J and Crombez, G and Baeyens, F and Hermans, D},
Title = {On the generality of the affective Simon effect},
Journal = {COGNITION \& EMOTION},
Year = {2001},
Volume = {15},
Number = {2},
Pages = {189-206},
Month = {MAR},
Note = {Workshop on Acquisition and Representation of Evaluative Judgements and
   Emotions, UNIV LEUVEN, LEUVEN, BELGIUM, DEC 16, 1998},
Organization = {Fund Sci Res},
Abstract = {In affective Simon studies, participants are to select between a
   positive and negative response on the basis of a nonaffective stimulus
   feature (i.e., relevant stimulus feature) while ignoring the valence of
   the presented stimuli (i.e., irrelevant stimulus feature). De Houwer and
   Eelen (1998) showed that the time to select the correct response is
   influenced by the match between the valence of the response and the
   (irrelevant) valence of the stimulus. In the affective Simon studies
   that have been reported until now, only words were used as stimuli and
   the relevant stimulus feature was always the grammatical category of the
   words. We report four experiments in which we examined the generality of
   the affective Simon effect. Significant affective Simon effects were
   found when the semantic category, grammatical category, and letter-case
   of words was relevant, when the semantic category of photographed
   objects was relevant, and when participants were asked to give nonverbal
   approach or avoidance responses on the basis of the grammatical category
   of words. Results also showed that the magnitude of the affective Simon
   effect depended on the nature of the relevant feature.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {De Houwer, J (Corresponding Author), Univ Southampton, Dept Psychol, Southampton SO17 1BJ, Hants, England.
   Univ Southampton, Dept Psychol, Southampton SO17 1BJ, Hants, England.
   Univ Ghent, Ghent, Belgium.
   Katholieke Univ Leuven, Louvain, Belgium.},
DOI = {10.1080/0269993004200051},
ISSN = {0269-9931},
EISSN = {1464-0600},
Keywords-Plus = {INFORMATION; INTERFERENCE; ACTIVATION; COLOR; WORDS},
