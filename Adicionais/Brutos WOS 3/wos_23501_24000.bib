@inproceedings{ WOS:000076976800023,
Author = {Sainfort, F and James, C and Yeh, YJ and Carayon, P and Lund, J and
   Smith, MJ},
Editor = {Vink, P and Koningsveld, EAP and Dhondt, N},
Title = {Impact of quality management on job characteristics},
Booktitle = {HUMAN FACTORS IN ORGANIZATIONAL DESIGN AND MANAGEMENT-VI},
Year = {1998},
Pages = {135-140},
Note = {6th International Symposium on Human Factors in Organizational Design
   and Management, THE HAGUE, NETHERLANDS, AUG 19-22, 1998},
Organization = {Int Ergon Assoc; Dutch Ergon Assoc; NIA TNO; Minist Social Affairs \&
   Employment},
Abstract = {Total Quality Management (TQM) has proven its potential to improve the
   quality of products and services. However, there is very little
   systematic, empirical research on the implementation of TQM in the
   public sector. In particular, there is very little research on the
   impact of TQM on employees involved, their jobs and their quality of
   life. This research examines the implementation of TQM in the City of
   Madison, Wisconsin, and its effects on employees. TQM has the potential.
   to improve quality of working life if it increases positive aspects of
   work, such as participation and meaningfulness, and reduces or minimizes
   negative aspects of work, such as poor social relations. A questionnaire
   survey was developed to examine employee perceptions of TQM. A total of
   424 employees of the City of Madison participated in the survey at
   baseline and a total of 848 employees responded to a second survey
   administered eighteen months later. Employees were asked about the
   effects of TQM on various aspects of their work. The results show that
   TQM has mixed effects.},
