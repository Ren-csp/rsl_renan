@article{ WOS:A1992KJ07400003,
Author = {DORLING, D and OPENSHAW, S},
Title = {USING COMPUTER ANIMATION TO VISUALIZE SPACE-TIME PATTERNS},
Journal = {ENVIRONMENT AND PLANNING B-PLANNING \& DESIGN},
