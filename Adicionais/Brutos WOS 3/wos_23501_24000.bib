@inproceedings{ WOS:000263668400041,
Author = {Plakitsi, Katerina and Dost, Vasiliki},
Editor = {Welsch, F and Malpica, F and Tremante, A and Carrasquero, JV and Oropeza, A},
Title = {The Importance of Neuroscience Research in Science Education},
Booktitle = {IMSCI `08: 2ND INTERNATIONAL MULTI-CONFERENCE ON SOCIETY, CYBERNETICS
   AND INFORMATICS, VOL IV, PROCEEDINGS, POST CONFERENCE ISSUE},
Year = {2008},
Pages = {179-186},
Note = {2nd International Multi-Conference on Society, Cybernetics and
   Informatics, Orlando, FL, JUN 29-JUL 02, 2008},
Organization = {Int Inst Informat \& System},
Abstract = {The extensive use of functional brain imaging technology in combination
   with neuroscience research has revealed an important role of directed
   attention in cerebral functioning. Furthermore, the identification of
   various brain areas involved in a variety of information processes Such
   as learning and memory concludes to the need of further research on the
   field of education. There are yet unanswered questions concerning the
   bridging of neuroscience data with the educational practice. Due to the
   importance of directed attention in cerebral functioning, it is of great
   necessity that educational research takes into great account the
   emerging data of neuroscience research. The adaptation of neuroscience
   data provides education an additional scientific confirmation of what is
   thought to be scientific from an educational point of view. Furthermore,
   neuroscience can support fields of educational research such as the
   cybernetics of education, the multimedia-based instructional design,
   applications of simulation in teaching and the construction of learning
   environments such as interactive museums. The aim of this paper is to
   quote some important neuroscience data and sequel the importance of
   motion perception in the creation of a science model.},
Publisher = {INT INST INFORMATICS \& SYSTEMICS},
Address = {14269 LORD BARCLAY DR, ORLANDO, FL 32837 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Plakitsi, Katerina; Dost, Vasiliki, Univ Ioannina, Sch Educ, GR-45110 Ioannina, Greece.},
ISBN = {978-1-934272-53-4},
Keywords = {neuroscience; brain; science education; interactive museums; science
