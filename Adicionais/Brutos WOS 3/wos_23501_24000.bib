@inproceedings{ WOS:000874361900051,
Author = {Grani, Fabrizio and Soto-Sanchez, Cristina and Rodil Doblado, Alfonso
   and Dolores Grima, Maria and Farfan, Fernando and Val Calvo, Mikel and
   Soo, Leili and Waclawczyk, Dorota and Manuel Ferrandez, Jose and
   Gonzalez, Pablo and Dolores Coves, Maria and Alfaro, Arantxa and
   Fernandez, Eduardo},
Editor = {Vicente, JMF and Alvarez-Sanchez, JR and Lopez, FD and Adeli, H},
Title = {Performance Evaluation of a Real-Time Phase Estimation Algorithm Applied
   to Intracortical Signals from Human Visual Cortex},
Booktitle = {ARTIFICIAL INTELLIGENCE IN NEUROSCIENCE: AFFECTIVE ANALYSIS AND HEALTH
   APPLICATIONS, PT I},
