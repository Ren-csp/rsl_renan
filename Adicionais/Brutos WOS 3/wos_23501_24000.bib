@inproceedings{ WOS:000189458900010,
Author = {Antill, S and Viles, HA},
Editor = {Mitchell, DJ and Searle, DE},
Title = {Development and potential uses of computer simulation techniques in the
   study of rock weathering},
Booktitle = {STONE DETERIORATION IN POLLUTED URBAN ENVIRONMENTS},
Series = {Land Reconstruction and Management Series},
Year = {2004},
Volume = {3},
Pages = {149-165},
