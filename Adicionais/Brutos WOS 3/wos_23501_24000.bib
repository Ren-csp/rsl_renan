@inproceedings{ WOS:000376419700013,
Author = {Henderson, Kjetil R. and Gigliotti, Larry M.},
Editor = {Tatina, R},
Title = {ANGLER SATISFACTION IN SOUTH DAKOTA},
Booktitle = {PROCEEDINGS OF THE SOUTH DAKOTA ACADEMY OF SCIENCE, VOL 94},
