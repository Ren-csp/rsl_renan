@inproceedings{ WOS:000188893400046,
Author = {Thaut, MH},
Editor = {Avanzini, G and Faienza, C and Minciacchi, D and Lopez, L and Majno, M},
Title = {Neural basis of rhythmic timing - Networks in the human brain},
