@inproceedings{ WOS:000074636300092,
Author = {Deacon, A},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {The introduction of air quality management in the United Kingdom - Pilot
   work in London},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {578-580},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {The United Kingdom Government recently published a draft for
   consultation of its proposed National Air Quality Strategy (Department
   of the Environment 1996). This document set, for the first time, clear
   standards and targets for improvements in air quality throughout the
   British Isles. The National Air Quality Strategy also introduced the
   concept of local air quality management, and in order to assist the
   local authorities responsible for implementing this, separate guidance
   on the review and assessment of air quality in local areas was issued.
   The South East Institute of Pubic Health is working in partnership with
   each of the thirtythree local authorities in London, and other
   London-wide bodies to test the applicability of this Guidance, and to
   make an assessment of the likely exceedences of the proposed air quality
   targets. This paper will outline the test work, describing the
   development of a London-wide inventory of emissions from large and small
   industrial processes, road transport and other sources, examining
   exceedences of air quality targets in 1995, and the expected
   improvements in air quality in London between now and the year 2005.
   Within London the majority of air pollutant emissions are motor vehicle
   related, and possible policies to reduce the impacts of the motor
   vehicle on London's ail quality will be discussed.
   The paper will describe the development of the London Air Quality
   monitoring Network (LAQN), and show how this has provided valuable data
   for the air quality management decision making process. The Use of GIS
   (Geographical Information Systems) will also be described, along with
   the development of a template for air quality management for use by
   individual local authorities.},
