@article{ WOS:000349495800033,
Author = {Mohamed, Shafinah Farvin Packeer and Baharom, Fauziah and Deraman, Aziz
   and Mohd, Haslina},
Title = {Software Certification and Its Implementation in Malaysian Software
   Industry: A Survey},
Journal = {ADVANCED SCIENCE LETTERS},
