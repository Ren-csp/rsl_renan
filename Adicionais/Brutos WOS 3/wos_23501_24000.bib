@inproceedings{ WOS:000175780700104,
Author = {Sotiropoulou, REP and Pilinis, C},
Editor = {Lekkas, TD},
Title = {Modeling of photochemical pollution in Athens, Greece application of the
   UAM-AERO and CALGRID modeling systems},
Booktitle = {PROCEEDINGS OF THE 7TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE
   AND TECHNOLOGY, VOLS A AND B},
Year = {2001},
Pages = {813-820},
Note = {7th International Conference on Environmental Science and Technology,
   ERMOUPOLIS, GREECE, SEP 03-06, 2001},
Abstract = {The severe episode of 25-26 May 1990 in Athens, Greece, is simulated
   using two state of the art models, UAM-AERO and CALGRID. Spatial and
   temporal variations of modeled concentrations of O-3, NO and NO2 are
   compared with observations. Both models seem to be capable to simulate
   the ozone and nitrogen oxide concentrations behavior while they fail to
   predict the nitrogen dioxide concentrations. The similar (in general)
   behavior of both models indicate that either one can be used in order to
   study emission control strategies aiming in reducing ozone and ozone
   precursor concentrations.},
