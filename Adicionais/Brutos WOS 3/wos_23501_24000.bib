@inproceedings{ WOS:A1996BH13P00010,
Author = {Lochard, J},
Book-Group-Author = {AUSTRIAN ASSOC RADIAT PROTECT},
Title = {Psychological and social impacts of post-accident situations: Lessons
   from the Chernobyl accident},
Booktitle = {IRPA9 - 1996 INTERNATIONAL CONGRESS ON RADIATION PROTECTION / NINTH
   INTERNATIONAL CONGRESS OF THE INTERNATIONAL RADIATION PROTECTION
   ASSOCIATION, PROCEEDINGS, VOL 1},
Year = {1996},
Pages = {A105-A111},
Note = {1996 International Congress on Radiation Protection / 9th International
   Congress of the International-Radiation-Protection-Association (IRPA9),
   VIENNA, AUSTRIA, APR 14-19, 1996},
Organization = {Austrian Assoc Radiat Protect; Int Radiat Protect Assoc},
Abstract = {This paper presents the main features, from the psychological and social
   points of view, of the post-accident situation in the contaminated areas
   around Chernobyl. This is based on a series of surveys performed in the
   concerned territories of the CIS republics. The high level of stress
   affecting a large segment of the population is related to the perception
   of the situation by those living in a durably contaminated environment
   but also to the side-effects of some of the countermeasures adopted to
   mitigate the radiological consequences or to compensate the affected
   population. The distinction between the accident and the post-accident
   phase is enlarged to rake into account the various phases characterizing
   the dynamics of the social response. Although the size of the
   catastrophe as well as the economic and political conditions that were
   prevailing at the time and after the accident have resulted in a maximal
   intensity of the reactions of the population, many lessons can be drawn
   for the management of potential post-accident situations.},
