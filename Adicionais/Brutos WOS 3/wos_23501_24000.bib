@article{ WOS:000365243100071,
Author = {Ramadhan, Ahmad Seiichi and Chastello, Ilhamdani},
Title = {The Effect of Experiential Marketing Moderated by Customer Loyalty on
   Customer Satisfaction at Premium Supermarkets in Jakarta},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2015},
Volume = {21},
Number = {4, SI},
