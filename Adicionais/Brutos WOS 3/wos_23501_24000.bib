@article{ WOS:000417999100081,
Author = {Tillotson, Jenny},
Title = {EMOTIONALLY RESPONSIVE WEARABLE TECHNOLOGY AND STRESS DETECTION FOR
   AFFECTIVE DISORDERS},
Journal = {PSYCHIATRIA DANUBINA},
