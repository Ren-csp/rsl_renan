@inproceedings{ WOS:000383740305064,
Author = {de Winter, J. C. F. and Hancock, P. A.},
Editor = {Ahram, T and Karwowski, W and Schmorrow, D},
Title = {Reflections on the 1951 Fitts list: Do humans believe now that machines
   surpass them?},
Booktitle = {6TH INTERNATIONAL CONFERENCE ON APPLIED HUMAN FACTORS AND ERGONOMICS
   (AHFE 2015) AND THE AFFILIATED CONFERENCES, AHFE 2015},
Series = {Procedia Manufacturing},
Year = {2015},
Volume = {3},
Pages = {5334-5341},
Note = {6th International Conference on Applied Human Factors and Ergonomics
   (AHFE), Las Vegas, NV, JUL 26-30, 2015},
Abstract = {In 1951, Paul Fitts ``surveyed the kinds of things men can do better
   than present-day machines, and vice versa{''} and introduced a list of
   statements, now commonly known as the Fitts list. A criticism sometimes
   raised with respect to the Fitts list is that it is outdated. Hence, it
   is important to address the issue of modernity, especially in light of
   the increasing rate of technological advance. A total of 249 engineering
   MSc students were asked to indicate whether humans surpass machines or
   whether machines surpass humans, for each of the 11 statements of the
   Fitts list, using an electronic voting system. 2,948 respondents from
   103 countries did the same via a crowdsourcing facility. The results
   indicated that present-day machines are considered to surpass humans in
   respect to detection, perception, and long-term memory while Fitts
   argued that the opposite held true. However, a closer reading of the
   1951 report reveals that some of the supposed disagreements were already
   anticipated at that time. (C) 2015 The Authors. Published by Elsevier
   B.V.},
