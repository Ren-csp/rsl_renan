@article{ WOS:000084461900001,
Author = {Olson, BD and Suls, J},
Title = {Self-, other-, and ideal-judgments of risk and caution as a function of
   the five-factor model of personality},
Journal = {PERSONALITY AND INDIVIDUAL DIFFERENCES},
