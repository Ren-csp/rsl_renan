   Univ Iowa, Dept Psychol, Iowa City, IA 52242 USA.},
DOI = {10.1016/S0191-8869(99)00105-1},
ISSN = {0191-8869},
Keywords = {attitude extremity; risk-taking; five-factor model of personality;
   openness to experience; agreeableness; conscientiousness},
Keywords-Plus = {GROUP POLARIZATION; CHOICE SHIFTS; 5-FACTOR},
