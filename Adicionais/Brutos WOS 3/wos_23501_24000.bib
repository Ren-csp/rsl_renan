@inproceedings{ WOS:000449471200225,
Author = {Luna, Daniel R. and Rizzato Lede, Daniel A. and Rubin, Luciana and
   Otero, Carlos M. and Ortiz, Juan M. and Garcia, Monica G. and Rapisarda,
   Romina P. and Risk, Marcelo R. and Gonzalez Bernaldo de Quiros, Fernan},
Editor = {Gundlapalli, AV and Jaulent, MC and Zhao, D},
Title = {User-Centered Design Improves the Usability of Drug-Drug Interaction
   Alerts: A Validation Study in the Real Scenario},
