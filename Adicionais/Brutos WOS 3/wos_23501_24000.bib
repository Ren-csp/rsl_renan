@article{ WOS:000263747700006,
Author = {Gonzalez Hernandez, Juan and de los Fayos Ruiz, Enrique J. Garces},
Title = {PSYCHOLOGICAL TRAINING PLAN FOR THE SPORT OF PETANQUE: IN SEARCH OF
