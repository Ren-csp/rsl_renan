@inproceedings{ WOS:000681358200042,
Author = {Krishna, Gautam and Tran, Co and Carnahan, Mason and Tewfik, Ahmed H.},
Book-Group-Author = {IEEE},
Title = {Advancing Speech Synthesis using EEG},
Booktitle = {2021 10TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2021},
Pages = {199-204},
Note = {10th International IEEE-EMBS Conference on Neural Engineering (NER),
   Prague, ELECTR NETWORK, MAY 04-06, 2021},
Organization = {Medtronic; Blackrock Microsystems; IEEE Engn Med \& Biol Soc; Inst
   Italiano Tecnologia; Biorobot Inst; Sant Anna Sch Adv Studies; Univ
   Houston, Cullen Coll Engn, Dept Biomed Engn; Wearable Robot; Frontiers
   Neuroscience; EPFL; Elsevier; CorTec; Abbott; Univ Pittsburgh; IEEE
   Transact Neural Syst \& Rehabilitat Engn; IEEE Open Journal Engn Med \&
   Biol},
Abstract = {In this paper we introduce an attention-regression model to demonstrate
   predicting acoustic features from electroencephalography (EEG) features
   recorded in parallel with spoken sentences with lower Mel cepstral
   distortion (MCD) values during test time compared to baseline results
   for the majority of the experiments. First, we demonstrate predicting
   acoustic features directly from EEG features using our attention model,
   and then we demonstrate predicting acoustic features from EEG features
   using a two-step approach where in the first step we use our attention
   model to predict articulatory features from EEG features and then in the
   second step another attention-regression model is trained to transform
   the predicted articulatory features to acoustic features. We then
   propose a deep learning model that takes raw EEG waveform signals as
   input and directly produces audio waveform as output with low root mean
   squared error (RMSE) values during test time. We finally demonstrate
   predicting 16 different acoustic features from EEG features. The results
   presented in this paper shows how different acoustic features are
   related to non-invasive neural EEG signals recorded during speech
   perception and production.},
