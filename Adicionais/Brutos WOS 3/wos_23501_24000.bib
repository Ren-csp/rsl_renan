@inproceedings{ WOS:000239989900062,
Author = {Petit, Sandrine and Dobremez, Laurent and Fleury, Philippe},
Editor = {Langeveld, H and Roling, N},
Title = {Working conditions: A challenge for sustainability of mountain family
   farming systems diagnosis at farm level and responses designed by
   farmers in the Alps},
Booktitle = {Changing European Farming Systems for a Better Future: New Visions for
   Rural Areas},
Year = {2006},
Pages = {272-276},
Note = {7th European IFSA Symposium on New Visions for Rural Areas, Wageningen,
   NETHERLANDS, MAY 07-11, 2006},
Organization = {IFSA},
Abstract = {Our paper discusses one key component of family farms sustainability in
   the Alps that is the working conditions. Mountain livestock systems
   remain Labour intensive. Farmers feel the gap between them and the rest
   of the society deepening regarding their workload. They express a demand
   for more spare time. We address this issue from two perspectives. First,
   we analyse how a group of farmers has constructed their own solutions to
   address the question of working conditions. We refer to the sociology of
   translation to understand this collective process. It shows that over a
   period of 3 years, farmers have refined the problem and tested different
   solutions. The second approach Lies in a systemic approach at farm Level
   assessing the work organisation and the farmers self-perception
   regarding his/her workloads. Crossing those two approaches, we discuss
   why successive phases of re-problematisation occurred and why the
   solutions imagined are not so straightforward. The single object of work
   organisation turns out to encompass all the complexity of small-scale
   farming systems in mountains areas.},
