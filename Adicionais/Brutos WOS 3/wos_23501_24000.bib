@article{ WOS:000258309600012,
Author = {Casas, Ferran and Figuer, Cristina and Gonzalez, Monica and Malo, Sara},
Title = {Materialistic aspirations and their relationship with psychological
   well-being and other psychosocial constructs in two Catalan adolescent
   samples},
Journal = {REVISTA DE PSICOLOGIA SOCIAL},
Year = {2008},
Volume = {23},
Number = {2},
Pages = {229-241},
Month = {MAY},
Note = {10th Spanish Conference of Social Psychology, Cadiz, SPAIN, SEP 26-28,
   2007},
Abstract = {In this paper the relationships among materialistic aspirations (the
   degree to which the participant adolescents would like to be appreciated
   by other people on a series of values when they are 21 years old),
   psychological well-being (sans action with different domains in life and
   with life as a whole), and some psychosocial constructs (self-esteem,
   perceived social support from family and friends, and perception of
   control) are analysed in two samples of Catalan adolescents among 12 and
   16.
   There samples were obtained in different years: 2003 (N = 2715) and 2006
   (N = 5051), through a questionnaire with very similar characteristics,
   which war administered in different educational centres. The second
   sample is representative of the Catalan population of these ages.
   The most important results, obtained through the application of
   different Principal Component Analysis to the list of valuer included in
   the questionnaire, are described. The relationships among the dimension
   of material values, which in both samples is formed by the values
   attributed to money, power and image, and the other explored constructs
   are also analysed and discussed in this paper.},
