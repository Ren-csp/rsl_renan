@article{ WOS:000454508700003,
Author = {Del Rosario, Kristinelli and Lotilla, Nicole and Alontaga, Jasper
   Vincent},
Title = {Improving Self-Regulation Skills of Preschool Students Through CrossFit
   Activities},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {11},
Pages = {7862-7865},
Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {Children's abilities to effectively pay attention, control impulses,
   motor activity and to regulate their emotions are significant skills for
   everyday life. These skills all fall under the components of
   self-regulation. A preschooler's ability to handle unfamiliar,
   emotional, and stressful circumstances appears to immensely depend on
   the development of self-regulation. Encouraging the development of
   self-regulation in early childhood is crucial as it has a key factor in
   learning, development and socialization however poverty has shown to be
   a negative impact on children as it harmfully exposes them to
   developmentally inappropriate risky environments that often lack care,
   nurture and safety for the child. CrossFit is a new trend of physical
   activity that involves high intensity and strength training, it does not
   specialize on one certain routine, it mixes different exercises that
   pushes all aspects of the body. The researchers found that CrossFit and
   other physical fitness exercises can improve the child academically,
   health wise and their attention in the classroom. With this, the
   researchers would want to further discover if physical fitness,
   specifically CrossFit, will be effective on a students' self-regulation.
   Students underwent a Preschool Self-Regulation Assessment (PSRA) before
   the activities were implemented. After the 15 session CrossFit
   activities were completed, through interviews, observations and the PSRA
   Examiner Rating Scale, the data and information shows that most of the
   students greatly improved their self-regulation. Although, it was
   evident in their results and their classroom behaviors there are still
   other factors to consider regarding the child. Overall, the most
   significant improvement in most of the student's self-regulation is
   learning the skill to control their urges. The participants could wait
   in a considerable amount of time, lessen and manage their motor activity
   and impulsive actions. They also had a more friendly and positive
   attitude towards their peers.},
