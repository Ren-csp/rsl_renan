@article{ WOS:000444996500020,
Author = {Muhammad, Nasiru Zakari and Zango, Muttaqua Uba and Suleiman, Jibrin
   Hassan and Egba, Ernest Ituma and Auwal, Almustapha Ahmad and Usman,
   Jamilu},
Title = {Implementation of Information Technology in Nigerian Construction
   Industry},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
