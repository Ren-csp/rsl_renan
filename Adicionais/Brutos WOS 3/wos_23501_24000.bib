   LAPERRIERE, A and KLIMAS, N and FLETCHER, MA},
Title = {STRESS MANAGEMENT AND ADJUSTMENT TO HIV-1 INFECTION},
Journal = {HOMEOSTASIS IN HEALTH AND DISEASE},
