@inproceedings{ WOS:000171527100030,
Author = {Recatalá, L and Colomer, JC and Cornélis, B and Fabbri, AG and Micó, C
   and Pascual, JA and Sánchez, J and Zinck, JA},
Editor = {Villacampa, Y and Brebbia, CA and Uso, JL},
Title = {Integrated environmental mapping for applying indicators of
   environmental quality at a multihierarchical level in Mediterranean
   areas affected by desertification},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT III},
Series = {ADVANCES IN ECOLOGICAL SCIENCES},
Year = {2001},
Volume = {10},
Pages = {291-300},
Note = {3rd International Conference on Ecosystems and Sustainable Developments,
   UNIV ALICANTE, ALICANTE, SPAIN, JUN 06-08, 2001},
Organization = {Wessex Inst Technol; Minist Ciencia \& Technol; Consejo Social Univ
   Alicante; Gen Valenciana; Diputac Provincial Alicante; Ayuntamiento
   Alicante},
Abstract = {This paper presents an integrated environmental mapping of Tabernas
   (Almeria, Spain), a representative example of Mediterranean areas
   affected by desertification, where an indicator-based approach for
   assessing environmental quality at different levels is being tested. The
   mapping consists of a hierarchical subdivision of the territory based on
   the combination of several natural and anthropic features
   (physiographic, geologic, geomorphic, hydrologic, surface processes, and
   land cover/use characteristics). The hierarchy includes, from larger to
   smaller subdivisions, natural environments, systems and units.
   Indicators for assessing environmental quality have been selected for
   each of these subdivisions. A preliminary assessment of naturalness (an
   aspect concerning environmental quality) has been carried out in the
   environments identified (Alhamilla and Filabres Mountains, badlands of
   the Desert of Tabernas, hills and valley of Tabernas) in the study area.
   The results show that the badlands of the Desert of Tabernas and the
   Alhamilla Mountains have very high and high naturalness, respectively.
   This coincides with the society and environmental authority perception:
   the Regional Government has recently declared both environments as
   natural parks. This highlights the importance of naturalness to maintain
   and promote environmental quality.},
