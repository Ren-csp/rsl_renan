@inproceedings{ WOS:000168119300065,
Author = {Hirshfeld, SS},
Editor = {Ricketts, J},
Title = {Development of pollution prevention management plans for US Army
   installations in South Korea},
Booktitle = {ENERGY \& ENVIRONMENTAL VISIONS FOR THE NEW MILLENNIUM},
Year = {1998},
Pages = {495-503},
Note = {20th World Energy Engineering Congress (WEEC), ATLANTA, GA, NOV 19-21,
   1997},
Organization = {Natl Assoc State Energy Officials; US Dept Commerce; US DOE; Off Natl
   Programs; US Gen Serv Adm; Natl Assoc Energy Serv Co; Power Marketing
   Assoc; Atlanta Gas Light Co; Gas Res Inst; Amer Gas Cooling Ctr; Ind Ctr
   Inc},
Abstract = {This paper describes some of the issues surrounding development of
   Pollution Prevention Management Plans for U.S. Army installations in
   South Korea. Plan development has entailed numerous site assessments,
   identification of material consumers and waste generators, computation
   of baselines for each target category, identification and costing (where
   possible) of pollution prevention strategies, and prioritization of
   strategies.
   The Army faces unique challenges in reducing material consumption and
   waste generation at its Korean installations, including: poor
   record-keeping; rapid (annual) turnover of most personnel, which results
   in little consistency in materials handling and waste management
   practices; perception among many Army personnel that the Korean populace
   and the U.S. Army command are not concerned about environmental quality;
   inadequate facilities and/or resources for handling and storing
   hazardous materials and wastes; the language barrier between U.S.
   personnel and some Korean nationals working for the Army or as Army
   contractors; and disincentives to reduce MSW generation and increase
   recycling, arising from the nature of waste collection practices and
   contracts in Korea.},
Publisher = {FAIRMONT PRESS INC},
