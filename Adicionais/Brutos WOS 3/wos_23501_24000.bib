@inproceedings{ WOS:000647462800023,
Author = {Zhang, Shuxin and Liu, Xiaolong and Luo, Jinheng and Sun, Bingbing and
   Wu, Gang and Jiang, Jinxu and Gao, Qi and Liu, Xiaoben},
Book-Group-Author = {IOP},
Title = {Stress analysis of large crude oil storage tank subjected to harmonic
   settlement},
