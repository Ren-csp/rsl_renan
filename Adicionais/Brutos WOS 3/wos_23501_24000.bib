@inproceedings{ WOS:000273025900088,
Author = {Dufour, Jean-Charles and Giorgi, Roch and Harle, Jean-Robert and
   Fieschi, Dominique and Volot, Francoise and Fieschi, Marius},
Editor = {Engelbrecht, R and Geissbuhler, A and Lovis, C and Mihalas, G},
Title = {Applicability of Textual Clinical Practice Guidelines: Impact of
   Physician Interpretation},
Booktitle = {CONNECTING MEDICAL INFORMATICS AND BIO-INFORMATICS},
