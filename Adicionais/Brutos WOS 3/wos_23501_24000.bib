@inproceedings{ WOS:000180264300030,
Author = {Rosete, DH and Cuadra, M and Leyva, R and Bronfman, M},
Book-Group-Author = {MONDUZZI EDITORE
   MONDUZZI EDITORE},
Title = {AIDS and HIV infection in the social imagination. A case of
   vulnerability study in Chetumal},
Booktitle = {XIV INTERNATIONAL AIDS CONFERENCE: ADVOCACY AND POLICY},
Year = {2002},
Pages = {135-139},
Note = {14th International AIDS Conference, BARCELONA, SPAIN, JUL 07-12, 2002},
Organization = {Univ N Carolina; Gen Clin Res Ctr; UNC Ctr AIDS Res; Natl Inst Hlth;
   Swiss Natl AIDS Res Program; Bristol-Myers Squibb Co; Boehringer
   Ingelheim; GlaxoWellcome Res \& Dev, HIV Antiviral Res},
Abstract = {Purpose. To analyze the vulnerability through an examination of the
   social imagination of HIV infection and it's relation with the practice
   of sex without condoms among mobile populations and local residents in a
   border community. Method. A qualitative study realized by in-depth
   interviews of both mobile and resident populations in the city of
   Chetumal, Quintana Roo, Mexico. Chetumal is the capital of Quintana Roo
   and borders Belize. Results. The popular perception of HIV infection is
   associated with the idea of risk groups. This condition not only
   contributes to stigmatization, but also produces a social imagination in
   which the risk of infection by HIV appears as a problem of
   ``otherness{''} rather than a problem related to unprotected sex.
   Conclusions. Although the informants identify the use of the condom as a
   mechanism for the prevention of STI/HIV/AIDS, symbolic representations
   are producing new forms of vulnerability. The social imagination of risk
   is linked only to sexual contact with persons considered dangerous; left
   aside are contexts of risk attributable to practices of unprotected sex.},
