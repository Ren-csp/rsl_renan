@inproceedings{ WOS:000264733100037,
Author = {Kozena, Ludmila and Kolacia, Ludek},
Editor = {Rehulka, E},
Title = {HEALTH CONDITION, LIFESTYLE AND WORKLOAD IN TEACHERS PARTICIPATING IN
   THE HEALTHY SCHOOL PROJECT},
Booktitle = {SCHOOL AND HEALTH 21(2)},
Year = {2007},
Pages = {361-368},
Note = {2nd Conference School and Health 21, Brno, CZECH REPUBLIC, AUG 28-30,
   2006},
Abstract = {Good health is a prerequisite for a teacher striving to fulfill all
   requirements of his/her work. Some teachers from nursery and primary
   schools in the Czech Republic participating in ``the Healthy School{''}
   longitudinal project voluntarily completed an extensive health
   questionnaire focused on health condition, lifestyle, subjective
   perception of workload, life satisfaction, and social support.
   Individual participants received the table of health risks based on
   their questionnaires indicating shortcomings in their health behaviour
   and health risk factors. The group results of teachers were compared
   with the general Czech population of the same age examined with the help
   of the same health questionnaire. The male teachers showed significantly
   better lifestyle (less smoking, more physical activity both in work and
   after) than the average Czech man. The women teachers did not differ
   from the average Czech women, but significant differences were found
   between head teachers and teachers without the head teacher function:
   the female head teachers display less physical activity in work, higher
   BMI, higher subjective workload, more room for independent
   decision-making, and fewer clays on sick leave.},
