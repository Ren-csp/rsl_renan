@inproceedings{ WOS:000085593600229,
Author = {Friedrich, WE and Lim, PK},
Editor = {Kasabov, N and Kozma, R and Ko, K and OShea, R and Coghill, G and Gedeon, T},
Title = {Behaviour-based control applied to robotic handling of variable objects},
Booktitle = {PROGRESS IN CONNECTIONIST-BASED INFORMATION SYSTEMS, VOLS 1 AND 2},
Year = {1998},
Pages = {943-946},
Note = {1997 International Conference on Neural Information Processing and
   Intelligent Information Systems, DUNEDIN, NEW ZEALAND, SEP, 1997},
Organization = {Asian Pacific Neural Network Assembly; Air New Zealand; TELECOM New
   Zealand; New Zealand Comp Soc; SAS Inst; Fisher \& Paykel; Univ Otago,
   Dept Informat Sci; IEEE, Neural Network Council; Int Neural Network Soc},
Abstract = {This paper describes the application of a recently developed control
   strategy applied to extend robot handling capabilities and include
   manipulation of variable objects. The challenging task of automated
   handling of variable objects necessitates a combination of advanced
   information technology with innovative electro-mechanical engineering.
   The-principle of behaviour-based control was initially developed for
   mobile robotics. This implemented approach applies small task achieving
   modules to the robotic gripping process. The overall task is broken into
   small behavioural modules structured hierarchically in layers of
   control.
   These layers operate essentially in parallel activated by input signals
   e.g. by a sensor touching the object. To react to a given situation each
   layer can override actions from lower layers of the hierarchy by
   inhibiting input to, or by suppressing output from, a lower layer. The
   basic principle allows close coupling of perception and action.
   Implementation strategies and results of initial experiments with
   handling of variable objects are discussed and potential future
   developments as part of a hybrid system, offering advantages of the
   different approaches, are described.},
