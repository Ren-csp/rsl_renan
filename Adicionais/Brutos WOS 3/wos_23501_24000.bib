@article{ WOS:000231546200007,
Author = {Hammett, TM and Norton, GD and Kling, R and Liu, W and Chen, Y and Ngu,
   D and Binh, KT and Dong, HV and Jarlais, DCD and Des Jarlais, DC},
Title = {Community attitudes toward HIV prevention for injection drug users:
   Findings from a cross-border project in southern China and northern
   Vietnam},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
Year = {2005},
Volume = {82},
Number = {3, 4},
