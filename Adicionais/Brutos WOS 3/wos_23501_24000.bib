@article{ WOS:000431743400142,
Author = {Susilowati, Endang and Sulistiyono, Singgih Tri and Puguh, Dhanang
   Respati},
Title = {Internalization of Nationalism Values on Senior High School Students in
   the Outer Island: A Case Study in Bunguran Island, Natuna Regency},
