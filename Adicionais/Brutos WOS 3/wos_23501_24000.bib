@inproceedings{ WOS:000342302400010,
Author = {Savage, Sara and Liht, Jose and Williams, Ryan},
Editor = {Gere, F and Sharpe, M},
Title = {Being Muslim Being British: Preventing Extremist Violence Through
   Raising Integrative Complexity},
Booktitle = {GLOBAL SECURITY: A VISION FOR THE FUTURE: ADDRESSING THE CHALLENGES AND
   OPPORTUNITIES FOR RESEARCH IN THE INFORMATION AGE},
