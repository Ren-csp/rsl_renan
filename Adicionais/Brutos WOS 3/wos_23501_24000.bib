@inproceedings{ WOS:000874361900038,
Author = {Val Calvo, Mikel and Morollon Ruiz, Roberto and Soo, Leili and
   Waclawczyk, Dorota and Grani, Fabrizio and Manuel Ferrandez, Jose and
   Fernandez Jover, Eduardo},
Editor = {Vicente, JMF and Alvarez-Sanchez, JR and Lopez, FD and Adeli, H},
Title = {Horizon Cyber-Vision: A Cybernetic Approach for a Cortical Visual
   Prosthesis},
Booktitle = {ARTIFICIAL INTELLIGENCE IN NEUROSCIENCE: AFFECTIVE ANALYSIS AND HEALTH
   APPLICATIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2022},
