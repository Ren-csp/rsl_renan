Title = {Coping strategies to intervene in conflicts and school violence: the
   response of the School Community},
Booktitle = {XIV EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY (ECDP)},
Year = {2010},
Pages = {433-439},
Note = {14th European Conference on Developmental Psychology (ECDP), Mykolas
   Romeris Univ, Vilnius, LITHUANIA, AUG 18-22, 2009},
Abstract = {Coping strategies to avoid problems in schools have been studied mainly
   with student samples. However, teachers and parents perceptions are
   relevant to understand and to cope with them. This study shows an
   overview about school violence and conflicts and the coping strategies
   that each relevant group propose to avoid them. The sample is composed
   by 1045 subjects from 9 high schools in the Campo de Gibraltar, in South
   of Spain. The results show that, according to the students' opinions,
   the most common school problems are verbal violence and the coping
   strategy more used by them is try to keep a negotiation with the others.
   Teachers suffer more frequently in class from bad words and the breach
   of class-norms and they affirm that the better way to stop the conflicts
   and violence in schools is to promote the participation of the family in
   the school. Finally, the families consider that the worst problem is
   pupils' motivation and it have to be stopped by keeping dialogue and
   cooperation with the teachers.},
