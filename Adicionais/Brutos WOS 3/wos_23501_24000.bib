@article{ WOS:A1996VM32300009,
Author = {Hecht, H and Kaiser, MK and Banks, MS},
Title = {Gravitational acceleration as a cue for absolute size and distance?},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {1996},
Volume = {58},
Number = {7},
Pages = {1066-1075},
