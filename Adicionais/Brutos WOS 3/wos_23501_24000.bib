@inproceedings{ WOS:000342343000004,
Author = {Muehlan, Holger and Schmidt, Silke},
Editor = {Schmidt, S and Rienhoff, O},
Title = {Psycho-Social Aspects of Personal Health Monitoring: A Descriptive
   Literature Review},
Booktitle = {INTERDISCIPLINARY ASSESSMENT OF PERSONAL HEALTH MONITORING},
Series = {Studies in Health Technology and Informatics},
Year = {2013},
Volume = {187},
Pages = {41-53},
Note = {Symposium on Personal Health Monitoring (PHM) and Ethics and Future
   Areas of PHM, Rotterdam, NETHERLANDS, JUN, 2012},
Abstract = {We aimed at providing a short review on already published studies
   addressing psycho-social issues of personal health monitoring (PHM).
   Both core questions addressed within this review are: What is the impact
   of PHM on intended psycho-social and health-related outcomes? And which
   psycho-social issues affected by or related to PHM have already been
   investigated? This descriptive review based on a literature search using
   various databases (Psycinfo, Psyndex, Pubmed, SSCI). Resulting 428
   abstracts were coded regarding their psycho-social content. Inspection
   of results was carried out along the relevance of the papers regarding
   psycho-social issues. Research in PHM focuses on telemonitoring and
   smart home applications: Tele-monitoring studies are directed to
   outcome-related questions, smart home studies to feasibility issues.
   Despite of technological matters, comparability of both systems in
   psycho-social issues is lacking. Tele-monitoring has been proven for
   impact on patient groups with chronic diseases, yet smart home still
   lacks evidence in health-related and psychosocial matters. Smart home
   applications have been investigated with respect to attitudes,
   perceptions and concerns of end-users, telemonitoring regarding
   acceptance and adherence.},
