@article{ WOS:000225295900011,
Author = {Ariztegui, J and Casanova, J and Valdes, M},
Title = {A structured methodology to calculate traffic emissions inventories for
   city centres},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {2004},
Volume = {334},
Number = {SI},
Pages = {101-109},
Month = {DEC 1},
Note = {7th International Symposium on Highway and Urban Pollution, Inst Quimic
   Sarria, Barcelona, SPAIN, MAY, 2002},
Abstract = {This study presents a methodology to estimate traffic emissions
   inventories for the case of city centres. It deals with the problem in a
   structured manner, identifying the sources and the formats of the input
   data as well as labelling the steps needed to perform the calculation.
   It describes a method to calculate the total mileage driven around the
   city using the concept of mileage per zone. Although the methodology
   employs a classical approach through the use of emission factors
   developed for mean speeds, it also discusses the possibility of applying
   these factors to instantaneous speeds. Finally, the study focuses on the
   influence of two critical factors: time resolution and the estimate of
   the total mileage. In both cases, the results indicate that the
   assumptions made are adequate and yield accurate results. The
   methodology has been applied to the city of Madrid as an example. (C)
   2004 Elsevier B.V. All rights reserved.},
