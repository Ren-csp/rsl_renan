@inproceedings{ WOS:000277058600002,
Author = {Druskat, Vanessa Urch and Pescosolido, Anthony T.},
Editor = {Zerbe, WJ and Hartel, C and Ashkanasy, N},
Title = {THE IMPACT OF EMERGENT LEADER'S EMOTIONALLY COMPETENT BEHAVIOR ON TEAM
   TRUST, COMMUNICATION, ENGAGEMENT, AND EFFECTIVENESS},
Booktitle = {INDIVIDUAL AND ORGANIZATIONAL PERSPECTIVES ON EMOTION MANAGEMENT AND
   DISPLAY},
Series = {Research on Emotion in Organizations},
Year = {2006},
Volume = {2},
Pages = {25-55},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {The purpose of this paper is to help clarify the actions of effective
   emergent leaders in self-managing work teams (SMWTs). Multiple methods
   were used to test hypotheses that leader's behaviors consistent with the
   development of emotionally competent team norms (interpersonal
   understanding, caring behavior, creating an optimistic environment, and
   proactive problem solving) would be more strongly linked to team trust,
   open communication, personal task engagement, and team effectiveness
   than traditional task-focused leader's behaviors (directive statements,
   using questions). Most hypotheses were supported. Directive leader's
   behaviors were for the most part negatively associated with team trust,
   open communication, and personal task engagement. It is argued that in
   SMWTs that have a history and a future together, emergent leaders who
   engage in behaviors that build emotional competence in the team are more
   likely to create team effectiveness than emergent leaders focused on
   directing team members.},
Publisher = {EMERALD GROUP PUBLISHING LTD},
Address = {HOWARD HOUSE, WAGON LANE, BINGLEY, W YORKSHIRE BD16 1WA, ENGLAND},
Type = {Proceedings Paper},
