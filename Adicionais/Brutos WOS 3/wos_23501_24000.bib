@inproceedings{ WOS:000175723000023,
Author = {Eber, L and Osuch, R},
Editor = {Loberton, CJ and Kutash, K and Friedman, RM},
Title = {Bringing the WrapAround approach to school: A model for inclusion},
Booktitle = {SYSTEMS OF CARE FOR CHILDREN'S MENTAL HEALTH: EXPANDING THE RESEARCH
   BASE, ANNUAL RESEARCH CONFERENCE, PROCEEDINGS},
Year = {1994},
Pages = {143-152},
Note = {7th Annual Conference on System of Care for Childrens Mental Health,
   TAMPA, FL, FEB 28-MAR 02, 1994},
Organization = {Res \& Training Ctr Childrens Mental Hlth; Univ S Florida; Florida Ment
   Inst, Training Res Serv},
Abstract = {Schools can be the impetus for system change by creating a network of
   community resources to obtain better outcomes for youth with EBD. The La
   Grange Area Department of Special Education (LADSE), has been involved
   in a systems change initiative based on the WrapAround philosophy for
   the past three years. A school inclusion model using WrapAround supports
   began in August, 1993. The evaluation of this school inclusion model
   began with the collection and analysis of baseline system data including
   placement trends, outcomes of students who exited self-contained classes
   or schools and progress of students involved with wraparound projects
   during the past three years. This analysis led to the development and
   implementation of the Wraparound in Schools (WAIS) model in three
   schools beginning in August, 1993. The evaluation of student/family
   outcomes, teacher perceptions and system change indicators is underway.
   This article provides a) an overview of the Wraparound in Schools (WAIS)
   model, b) implementation challenges and experiences, c) a description of
   the evaluation process and d) discussion of first wave data.},
