@inproceedings{ WOS:001607633800042,
Author = {Grazi, Lorenzo and Parri, Andrea and Aprigliano, Federica and Pacifico,
   Ilaria and Giovacchini, Francesco and Cosentino, Pietro and Raugei, Enzo
   and Bellandi, Tommaso and Trigili, Emilio and Vitiello, Nicola and Crea,
   Simona},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Evaluation of Passive Occupational Exoskeletons in Port Embarkation and
   Disembarkation of Ships: Two Case Studies},
