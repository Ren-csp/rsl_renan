@inproceedings{ WOS:000288209800006,
Author = {Holman, David J. and Totterdell, Peter and Rogelberg, Steven G.},
Editor = {Ashkanasy, NM and Zerbe, WJ and Hartel, CEJ},
Title = {A DAILY DIARY STUDY OF GOAL STRIVING: THE RELATIONSHIP BETWEEN GOAL
   DISTANCE, GOAL VELOCITY, AFFECT, EXPECTANCIES, AND EFFORT},
Booktitle = {EFFECT OF AFFECT IN ORGANIZATIONAL SETTINGS},
Series = {Research on Emotion in Organizations},
Year = {2005},
Volume = {1},
Pages = {95-121},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {A daily diary study was used to examine the relationships between goal
   distance, goal velocity, affect, expectancies, and effort from the
   perspective of Carver and Scheier's (1998) control theory of
   self-regulation. Fifteen social workers completed a diary at the end of
   each working day for four weeks. Multi-level analysis found little
   support for the precice predictions of Carver and Scheier's theory, but
   did support the idea that discrepancy reduction plays a role in
   regulating behavior. Expectancies had a strong association with effort,
   and affect moderated this relationship. The interaction indicated that
   high expectancies suppress the signalling effects of affect, preventing
   the individual from being consumed by immediate reactions to situational
   events and enabling effort to be sustained.},
