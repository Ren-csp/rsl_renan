@article{ WOS:000230054700003,
Author = {Cho, J and Song, KG and Yun, H and Ahn, KH and Kim, JY and Chung, TH},
Title = {Quantitative analysis of biological effect on membrane fouling in
   submerged membrane bioreactor},
Journal = {WATER SCIENCE AND TECHNOLOGY},
