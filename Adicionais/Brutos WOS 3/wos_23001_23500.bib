@inproceedings{ WOS:A1997BH34N00083,
Author = {Joshipura, J and Yamaji, K},
Book-Group-Author = {INT ASSOC ENERGY ECON},
Title = {Biomass as an energy alternative and the role of informal markets},
Booktitle = {ENERGY AND ECONOMIC GROWTH: IS SUSTAINABLE GROWTH POSSIBLE?, VOLS 1-3},
Year = {1997},
Pages = {927-936},
Note = {20th Annual International Conference of the
   International-Association-for-Energy-Economics, NEW DELHI, INDIA, JAN
   22-24, 1997},
Organization = {Int Assoc Energy Econ; Indian Oil Corp, India; Oil Ind Dev Board, India;
   Dtsche Gesell Tech Zusammenarbeit, Indo German Energy Efficiency
   Project; Inst Energy Econ, Energy Data \& Modelling Ctr, Japan; Govt
   India, Minist Non Convent Energy Sources; UNOCAL Corp, US},
Abstract = {The purpose of this study is to evaluate (through SD technique) the role
   of informal markets if the conversion efficiency of biomass is increased
   for its use as an energy alternative. This paper argues that biomass is
   being used for fuel and other uses in developed and developing
   countries, where formal and informal markets already exist. The size of
   the former is known whereas that of the later is not known. In addition,
   there are many types of biomass that have yet not come on any markets.
   Hence the questions are: what will be the impact and the role of
   informal and formal markets; if the efficiency of biomass conversion is
   increased? What if new types of biomass appear on formal markets and
   part of the demand of biomass for fuel becomes predictable?. This paper
   addresses these questions, discusses issues and cost-benefits of
   informal markets. It argues that informal markets currently provide
   mechanisms for fuel wood trading and hence for deforestation. This
   negative role could be reduced by providing a cheaper energy (by
   increasing efficiency of biomass) to the poor to induce a fuel shift.
   The use of regionally procured biomass could therefore sustain regional
   environment and economic growth. Thus this substrategy could serve the
   larger strategy of sustainable energy and economic growth. Hence an
   appropriate strategy could be to identify, target, collect and transport
   more biomass for its conversion at higher efficiency. The informal
   markets could play a positive role if their existing mechanisms could be
   utilized in the logistics of collection, procurement and supply. This
   could increase the size of formal markets, provide more data and bring
   more biomass under control for conversion at higher efficiency. For this
   purpose this paper assessed which biomass could be targeted and how much
   energy could be obtained at higher levels of efficiency. Results of the
   analysis show that most of actual biomass energy in developing and
   developed countries in 1990 was in the informal market at the rural,
   urban and industrial level. In the year 2100, most of the biomass energy
   could be obtained from the informal market. It will be in the form of
   cereal residues, dung, timber and paper scrap, round wood residue in
   developing countries and dung and round wood residues in developed
   countries. The informal market's decentralized and informal structure
   and its mechanisms and logistics of collection systems will be useful in
   procuring dispersed biomass. This paper analyzes the impact of an
   efficiency increase on informal markets. It discusses the methods of
   measuring this impact. This paper supports the arguments by analyzing a
   historical precedent of impact of efficiency increase on biomass
   markets.},
Publisher = {TATA ENERGY RESEARCH INST},
Address = {DOCUMENTATION \& INFORMAT CTR OUTREACH CELL INDIA HABITAT CENTRE, NEW
   DELHI 110 003, INDIA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Joshipura, J (Corresponding Author), UNIV TOKYO,DEPT ELECT ENGN,7-3-1 HONGO,TOKYO 113,JAPAN.},
ISBN = {81-85419-24-8},
Keywords = {energy efficiency; biomass; informal markets; bioenergy; deforestation;
