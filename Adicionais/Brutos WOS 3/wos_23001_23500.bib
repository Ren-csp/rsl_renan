@inproceedings{ WOS:000240047600034,
Author = {Lawton, M.},
Editor = {Broadbent, G and Brebbia, CA},
Title = {Practicing what we preach},
Booktitle = {Eco-Architecture: Harmonisation between Architecture and Nature},
Series = {WIT TRANSACTIONS ON THE BUILT ENVIRONMENT},
Year = {2006},
Volume = {86},
Pages = {341-350},
Note = {1st International Conference on Harmonisation between Architecture and
   Nature, Wessex Inst Technol, New Forest, ENGLAND, JUN 14-16, 2006},
Organization = {WIT Transact Ecol \& Environm},
Abstract = {In 2001 Landcare Research embarked on a journey into the unknown - the
   design and development of premises for 100 of our staff in Auckland.
   Sustainability is the central thread of Landcare Research's core
   business but we also try to practise what we preach, so when we came to
   build new accommodation, we knew we had to be innovative and to some
   extent courageous in breaking new ground. We set and achieved high
   environmental and sustainable design objectives for the building, based
   on our ethos as an organisation that champions sustainable development
   through lowering resource use and dramatically reducing waste. We agreed
   that the building had to be designed for sustainability. Construction
   costs were not to be increased because the building was sustainable.
   Projected energy operating costs should be about 60-70\% less than for a
   conventional building. The building would make minimal use of municipal
   water, stormwater and sewage systems. In addition, we wanted the
   building to be a great place to work and to reflect our Pacific culture
   and specific Auckland location. We continue to adhere to those
   principles in our ongoing management of the building, and monitor and
   manage it as a research and demonstration site for low-impact urban
   design.
   This presentation will outline the drivers of sustainability in New
   Zealand and how they were translated into the goals we set ourselves for
   our sustainable building. It will also focus on the problems that face
   design professionals and their clients when they choose developments
   that are not mainstream, and present suggestions to overcome them.},
