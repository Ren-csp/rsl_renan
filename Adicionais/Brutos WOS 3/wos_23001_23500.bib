@inproceedings{ WOS:000177767000006,
Author = {Tate, RL III and Rogers, BF},
Editor = {Violante, A and Huang, PM and Bollag, JM and Gianfreda, L},
Title = {Soil ecosystem properties, microbial diversity, and ecosystem
   assessments},
Booktitle = {SOIL MINERAL-ORGANIC MATTER-MICROORGANISM INTERACTIONS AND ECOSYSTEM
   HEALTH, VOLUME 28B: ECOLOGICAL SIGNIFICANCE OF THE INTERACTIONS AMONG
   CLAY MINERALS, ORGANIC MATTER AND SOIL BIOTA},
Series = {Developments in Soil Science},
Year = {2002},
Volume = {28B},
Pages = {79-93},
Note = {3rd Symposium on Soil Mineral-Organic Matter-Microorganism Interactions
   and Ecosystem Health, NAPLES, ITALY, MAY 22-26, 2000},
Organization = {IUSS, Commiss II Soil Chem; IUSS, Commiss III Soil Biol; IUSS, Commiss
   VII Soil Mineralogy; IUSS, Commiss VIII Soil \& Environm; Univ Naples
   Fed II; Soc Italian Sci Suolo, Working Grp NAMOXI},
Abstract = {The importance of a diverse, resilient soil microbial community in the
   development of functional, sustainable land based ecosystems has long
   been appreciated. An essential element for evaluating impacts of various
   management decisions on agricultural, urban, or reclamation sites and
   for studying the stability of native ecosystems is the accurate
   assessment of the function and diversity of the soil microbial
   community. Traditional methods for quantifying soil microbial processes
   (e.g., population density measurements, enzyme activities, and
   respiration measurements) are useful descriptors of microbial function,
   in some situations, but frequently the results do not clearly relate to
   site conditions. Data interpretation can be complicated, for example by
   the high redundancy of the microbial community (i.e., mixtures of active
   and inactive populations with the predominant microbes commonly being
   inactive or in a resting state) and the accumulation of stabilized
   enzymes, which may or may not contribute to total ecosystem function.
   More general measures of soil microbial diversity-phospholipid fatty
   acid analysis (PLFA) and metabolic diversity (as determined by the
   BIOLOG procedure) have been shown to be useful in characterization and
   differentiation of ecosystem microbial populations, both in native and
   managed soils. These more general indicators (i.e., as compared to DNA
   analysis methods where specific microbial species are designated) are
   sensitive, reasonably easily applied techniques that are useful in
   assessing microbial community status and development in a wide range of
   soils and soil-like materials. Although reproducible ``fingerprints{''}
   characteristic of specific soil systems result from these analyses, the
   direct relationship of specific metabolic activities or occurrence of
   specific fatty acids in the assay procedures to actual field situations
   has been questioned. Therefore primary concerns for application of
   metabolic diversity and phospholipid fatty acid analyses to study of
   native soil systems are the need to clarify the relationship between the
   laboratory derived data and the nature of the processes occurring in the
   field and the delineation of reasonable boundaries for data
   interpretation.},
