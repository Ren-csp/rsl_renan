Title = {Decrease of arsenic in water from the Pampean plain (Argentina) by
   calcium salts addition},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
