Title = {Arsenic exposure in the Canadian general population: levels of arsenic
   species measured in urine, and associated demographic, lifestyle or
   dietary factors},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
