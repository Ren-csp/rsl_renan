@inproceedings{ WOS:001551777500003,
Author = {Vu Van Doanh and Khuat Thi Hong and Ngo Tra Mai and Pham Phuong Thao and
   Le Tran Duong and Le Van Linh and Le Thi Trinh and Thao Ly Do and Trinh
   Thi Tham},
