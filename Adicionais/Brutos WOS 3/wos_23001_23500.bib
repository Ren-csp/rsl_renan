@inproceedings{ WOS:000257927900013,
Author = {Yadav, M. A.},
Editor = {Broadbent, G and Brebbia, CA},
Title = {Defining ecological regionalism - a theoretical perspective},
Booktitle = {ECO-ARCHITECTURE II: HARMONISATION BETWEEN ARCHITECTURE AND NATURE},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2008},
Volume = {113},
Pages = {127-136},
Note = {2nd International Conference on Harmonisation between Architecture and
   Nature, Algarve, PORTUGAL, 2008},
Abstract = {This paper is a part of an on-going research which attempts to define
   ecological regionalism with reference to architecture. The paper firstly
   describes the problem and the need for ecological regionalism. The
   definitions of architecture, ecology, region, regionalism are studied
   and then have tried to define ecological regionalism. The interface
   between architecture and ecology is explained. Objectives of regionalism
   are elaborated with suitable examples. `Regionalism in architecture' is
   a concept of architectural design based on determinants such as culture
   climate and resources of the particular place. When these regional
   contents incorporated appropriately, provide the architecture of a
   region. In ancient civilizations, architecture was very much regional in
   character because it evolved purely in response to these regional
   determinants. The history of civilization shows that man developed
   through trial and error a fine tradition of regional architecture, which
   still persists in rural habitats of the world. In the urban centers, our
   concepts and lifestyles have undergone considerable changes like major
   technological, cultural transformations, which gave rise to different
   patterns of building and community city planning. Cities are planned
   with regard to economic growth, social needs and neighbourhood concerns.
   Nature is typically perceived as separate from the city. Growing human
   population figures and resource use are degrading the biosphere, which
   may be disastrous. Architecture must now take itself seriously as a
   major consumer of resources and a major user of the world's supplies.
   Architecture is shaped by the ecology of the place; Ecological
   regionalism helps to conserve natural and regional identity in
   architecture.},
