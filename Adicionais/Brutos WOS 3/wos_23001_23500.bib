@article{ WOS:000432429600104,
Author = {Diego, Arnel A. and de la Cerna, Lyle C. and Agdeppa, Joan Y.},
Title = {Happiness Among Selected Filipino Elderly: A Consensual Qualitative
   Research},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2611-2615},
Month = {APR},
Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Happiness is embedded in all Filipinos. It transcends age, gender, race
   and status in life. When adults realize that they have adequate
   psychosocial support from their family, friends, and colleagues, they
   become grateful for their lives which may lead not only to positive
   perceptions but also to happiness. In fact, gratitude was found to
   relate well with happiness as it facilitates realization of life's
   purpose and significance. Given this background, the authors were
   interested to find out the phenomenological experience of what makes old
   people happy and discover the different concepts of happiness among old
   people aged 60-80 years old in the Philippines. Using Consensual
   Qualitative Research, twenty three (23) elderly people from Manila were
   interviewed and focus group discussions were used to triangulate the
   results. Findings showed that six (6) categories represent the happiness
   of the elderly namely (1) `Family,' (2) `Self-worth,' (3) `Health and
   Well being,' (4) `Recreational Activities,' (5) `Time for oneself' and
   (6) `Financial Independence.'},
