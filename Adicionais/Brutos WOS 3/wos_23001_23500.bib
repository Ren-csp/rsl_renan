@inproceedings{ WOS:000189414500005,
Author = {Ripmeester, M},
Book-Group-Author = {HRC},
Title = {The development of a British landscape at Niagara, 1759-1765},
Booktitle = {BORDERLANDS: THE SHARED CANADIAN AND U.S. EXPERIENCE OF LANDSCAPE},
Year = {2002},
Pages = {33-43},
Note = {Alliance-for-Historic-Landscape-Preservation Annual Meeting, Niagara on
   the Lake, CANADA, JUN 02-05, 1999},
Organization = {Alliance Histor Landscape Preservat},
Abstract = {This paper focuses upon the evolution of European landscapes in the
   Niagara region during the early period of British control (1759-1765). A
   central theme will be that local First Nations were largely transparent
   to British perceptions of the region. Thus, with the defeat of the
   French in 1759 there was relatively little to deter administrators and
   officers from viewing the post as an important cog in an expanding
   colonial system. In reality, the post at Niagara was, during the
   mid-eighteenth century at least, a tiny point of sovereignty in what was
   as yet a vast wilderness. Tenuously linked to other, similar, outposts,
   the post at Niagara was often undermanned, isolated, and held under
   siege by First Nations. In fact, through this early period, and though
   British officials and policy makers would have liked to believe
   otherwise, the British landscape at Niagara evolved largely in response
   to relationships with nearby First Nations.},
Publisher = {HERITAGE RESOURCES CENTRE FACULTY ENVIRONMENTAL STUDIES},
