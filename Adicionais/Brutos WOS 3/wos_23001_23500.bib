@article{ WOS:A1991GL80200011,
Author = {YOUNG, J and STRETTON, H},
Title = {INDIVIDUALISM AND COLLECTIVISM - HOW WILL SUSTAINABILITY AFFECT THE
   ROLES OF THE PUBLIC AND PRIVATE SECTORS},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1991},
Volume = {108},
Number = {1-2},
Pages = {103-110},
Month = {OCT 1},
Note = {CONF ON SUSTAINABLE POLICIES AND MAKING THEM WORK, UNIV NEW S WALES,
   SYDNEY, AUSTRALIA, NOV 09-10, 1989},
Abstract = {While this paper recognises that the goal of sustainability may require
   philosophical and institutional changes of a radical nature, it compares
   the strengths and limitations of a range of strategies within the
   context of reform.  Beginning with education, at the `soft' end of the
   spectrum, it works through regulation, rationing, taxing and price
   controlling, to the `hard' strategy of public ownership.  But the
   authors argue that the soft/hard dichotomy is not an accurate perception
   of the implications of these strategies.  Education may prove to be the
   most radical tool of all, while the impact of public ownership on the
   environment depends on the private sectors, and their interdependence,
   makes value judgements about their respective merits environmentally
   irrelevant.  Different mixes will be appropriate for different purposes
   in different contexts.  The important thing is clarity of purpose, which
   is where value judgements are important, and to select the strategy
   which will work best to achieve good results without being confused by
   ideological preconceptions.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
