Title = {Impact of the Braking System Generated Pollutants on the Global Vehicle
   Emissions: A Review},
Booktitle = {NEW DEVELOPMENTS IN ENVIRONMENTAL SCIENCE AND ENGINEERING, ICESE 2023},
Series = {Springer Proceedings in Earth and Environmental Sciences},
Year = {2024},
Pages = {11-19},
Note = {13th International Conference on Environmental Science and Engineering
   (ICESE), Leuven, BELGIUM, SEP 08-10, 2023},
Abstract = {The continuous tackling of emissions is one of the crucial points
   adopted in the last years for generating a more sustainable way of
   living. The automotive industry is one of those undertaking a more
   dramatical change, capable of strongly reducing the impact of their
   final product. The impactful effects of vehicles on the environment and
   on human health are multiple, but one of the problems that is growing in
   terms of global perception regards non-combustion pollutants. This work
   wants to underline the impact of secondary pollutants, specifically of
   the braking emissions. The review analyses the multiple approaches used
   for evaluating and quantifying the secondary emissions and how much the
   brake pollutants are relevant with respect to the others. The paper also
   analyses the different methods proposed for mitigating braking harming
   effects, and in which way regulation is going to and would act for
   developing sustainable strategies to reduce the braking impact on the
   global automotive emissions.},
