@article{ WOS:000165210600007,
Author = {Koehler, HH},
Title = {Natural regeneration and succession - results from a 13 years study with
   reference to mesofauna and vegetation, and implications for management},
Journal = {LANDSCAPE AND URBAN PLANNING},
