Title = {The ecological impacts of primary education facilities based on a
   child-friendly neighborhood unit criteria in Surakarta},
Booktitle = {INTERNATIONAL CONFERENCE ON CLIMATE CHANGE: CHALLENGES AND OPPORTUNITY
   ON ENVIRONMENT DEGRADATION RESEARCHES},
