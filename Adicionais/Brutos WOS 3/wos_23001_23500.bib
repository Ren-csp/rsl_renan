@article{ WOS:000254410400005,
Author = {Reinertsen, Randi Eidsmo and Faerevik, Hilde and Holbo, Kristine and
   Nesbakken, Ragnhild and Reitan, Jarl and Royset, Arne and Le Thi, Maria
   Suong},
Title = {Optimizing the performance of phase-change materials in personal
   protective clothing systems},
Journal = {INTERNATIONAL JOURNAL OF OCCUPATIONAL SAFETY AND ERGONOMICS},
