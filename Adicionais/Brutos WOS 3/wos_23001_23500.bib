@inproceedings{ WOS:000425331200012,
Author = {Evans, Gerald E. and Evans, Michael G.},
Editor = {Rich, M},
Title = {Leadership, Risk Aversion and Resistance to Change: An Empirical
   Confirmation of Prospect Theory},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2017},
Pages = {97-105},
Note = {13th European Conference on Management, Leadership and Governance
   (ECMLG), City Univ London, Cass Business Sch, London, ENGLAND, DEC
   11-12, 2017},
Abstract = {Prospect Theory postulates that individuals are risk averse relative to
   potential losses and risk seeking in regards to potential gains. This
   behaviour is critical when leaders attempt to move groups and
   organizations through change. This theory also explains why polarization
   often occurs during times of transition. A sample of respondents
   affirmed the predictions of Prospect Theory. Individuals who perceived
   that the current status served them well and met their current needs
   were less likely to embrace or support proposed changes to the status
   quo. This perception demonstrates risk aversion to potential losses.
   Conversely, individuals who perceived that the current state did not
   serve them well or meet their current needs and interests were more
   likely to embrace and support proposed changes to the status quo
   demonstrating risk seeking in the face of potential gains. The results
   are applied to organizational leadership and management as well as to
   changes in policy in both the public and private sector.},
