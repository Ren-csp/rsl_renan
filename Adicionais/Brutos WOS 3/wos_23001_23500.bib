Title = {IMAGE FUSION BASED ON NONSUBSAMPLED CONTOURLET TRANSFORM},
Booktitle = {2009 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND INFORMATION
   APPLICATION TECHNOLOGY, VOL III, PROCEEDINGS,},
Year = {2009},
Pages = {338+},
