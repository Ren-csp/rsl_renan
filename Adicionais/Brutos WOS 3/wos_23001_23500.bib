@article{ WOS:000399357500019,
Author = {Umar, Nur Syazana and Rani, Mohd Dzulkhairi Mohd and Aripin, Khairun
   Nain Nor and Rahman, Tanty Shahrumi Abdul and Salleh, Nooriah Mohamed},
Title = {A Review of Prophetic Nutraceutical Foods: Issues and Challenges},
