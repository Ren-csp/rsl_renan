@inproceedings{ WOS:000467120500050,
Author = {Giaccu, Gian Felice and Meloni, Daniel and Valdes, Monica and
   Fragiacomo, Massimo},
Editor = {Brebbia, CA and Longhurst, J and Marco, E and Booth, C},
Title = {DYNAMIC DETERMINATION OF THE MODULUS OF ELASTICITY OF MARITIME PINE
   CROSS-LAMINATED PANELS USING VIBRATION METHODS},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
