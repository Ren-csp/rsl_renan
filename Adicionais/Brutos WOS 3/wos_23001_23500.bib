Editor = {Zhu, YG and Guo, H and Bhattacharya, P and Bundschuh, J and Ahmad, A and Naidu, R},
Title = {Assessing drinking water quality at high dependent point of sources and
   potential health risk of massive population: A view from Tala Upazila of
   Satkhira District in Bangladesh},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
