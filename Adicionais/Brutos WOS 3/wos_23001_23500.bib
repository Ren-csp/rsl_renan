@inproceedings{ WOS:000507999600205,
Author = {Jing, C. Y. and Cui, J. L.},
Editor = {Zhu, YG and Guo, H and Bhattacharya, P and Bundschuh, J and Ahmad, A and Naidu, R},
Title = {Nitrate respirers mediate anaerobic As(III) oxidation in filters},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {516-517},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {Microorganisms play a key role in the redox transformation of arsenic in
   aquifers. In this study, the impact of indigenous bacteria, especially
   the prevailing nitrate respirers, on arsenite oxidation was explored
   during groundwater filtration using granular TiO2 and subsequent spent
   TiO2 anaerobic landfill. X-ray absorption near edge structure
   spectroscopy analysis showed As(III) oxidation (46\% in 10 days) in the
   presence of nitrate in the simulated anaerobic landfills. The Fe phase
   showed no change during the anaerobic incubation. Incubation experiments
   implied that the indigenous bacteria completely oxidized arsenite to
   arsenate in 10 days using nitrate as the terminal electron acceptor
   under anaerobic conditions. Phylogenetic tree analysis revealed that
   Proteobacteria was the dominant phylum, with Hydrogenophaga (34\%),
   Limnohabitans (16\%), and Simplicispira (7\%) as the major bacterial
   genera. The nitrate respirers especially from the Hydrogenophaga genus
   anaerobically oxidized As(III) using nitrate as an electron acceptor
   instead of oxygen. Our study implied that microbes can facilitate the
   groundwater As oxidation using nitrate on the adsorptive media.},
