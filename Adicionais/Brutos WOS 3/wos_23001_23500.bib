Title = {Public art as public memory: representing the heritage of mining
   communities},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {1203-1212},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Fullservice Co; Viagens Abreu},
Abstract = {This paper examines the use of public artworks as representations of the
   collective heritage of local communities undergoing physical, economic
   and social transformation. Whilst the social values of public art
   continue to be debated, it has been credited with the ability both to
   reaffirm and reinforce community identity, and to shift perceptions
   towards new directions. The catalytic effect of the introduction of
   public art into declining industrial centres has, in the UK and
   elsewhere, become a major tenet of urban regeneration practice since the
   1980s. In many cases, the representation of aspects of the local
   cultural heritage are either required by the commissioning brief or
   claimed by the artist. The proliferation of such artworks can be viewed
   as a manifestation of Ritter's `compensation theory', applied by Lobbe
   and others to the growth of the museum sector. It can also be regarded
   as a medium for promulgating a reductive authorised heritage discourse.},
