@article{ WOS:000241366900001,
Author = {Johnson, Amy L. and Crawford, Matthew T. and Sherman, Steven J. and
   Rutchick, Abraham M. and Hamilton, David L. and Ferreira, Mario B. and
   Petrocelli, John V.},
Title = {A functional perspective on group memberships: Differential need
   fulfillment in a group typology},
Journal = {JOURNAL OF EXPERIMENTAL SOCIAL PSYCHOLOGY},
Year = {2006},
Volume = {42},
Number = {6},
Pages = {707-719},
Month = {NOV},
Note = {3rd Annual Meeting of the Society-for-Personality-and-Social-Psychology,
   SAVANNAH, GA, JAN 31-FEB 02, 2002},
Organization = {Soc Personal \& Social Psychol},
Abstract = {The social motivation functions of intimacy, task, and social category
   groups were investigated. In two studies, participants were asked to
   consider the extent to which their group memberships fulfilled several
   needs. A factor analysis confirmed that the needs comprised three
   factors: affiliation, achievement, and identity. Intimacy groups were
   associated with affiliation needs, task groups were associated with
   achievement needs, and social category groups were associated with
   identity. A study using implicit measures reinforced those results,
   revealing the presence of the same implicit associations between group
   types and need fulfillments. A final study manipulated participants'
   need state through a priming procedure. Priming a specific need
   (affiliation, achievement, and identity) led to an increased
   accessibility of the group type that was best suited to meet that need
   (intimacy, task, social category, respectively). Results help clarify
   the functional aspects of groups and have implications for the
   perception and organization of group-level information. (c) 2005
   Elsevier Inc. All rights reserved.},
