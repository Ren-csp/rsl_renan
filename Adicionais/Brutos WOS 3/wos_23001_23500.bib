@inproceedings{ WOS:A1997BJ03E00031,
Author = {SanJose, R and Prieto, JF and Martin, J and Delgado, L and Jimenez, E
   and Gonzalez, RM},
Editor = {SanJose, R and Brebbia, CA},
Title = {Integrated environmental monitoring, forecasting and warning systems in
   metropolitan areas (EMMA): Madrid application},
Booktitle = {MEASUREMENTS AND MODELLING IN ENVIRONMENTAL POLLUTION},
Year = {1997},
Pages = {313-323},
Note = {1st International Conference on Measurements and Modelling in
   Environmental Pollution (MMEP 97), MADRID, SPAIN, 1997},
Organization = {Wessex Inst Technol, UK; UPM, Environm Software \& Modelling Grp, Spain},
Abstract = {EMMA project, -an European Union DGXIII project-, is dealing with the
   development, test and validation of innovative telematics system for the
   monitoring and forecasting of air pollution in urban areas. Telematics
   components including multimedia products and services are extensively
   used in the project: a) specialized networks, b) GIS and Multimedia
   archiving systems and high definition terminals. Pollution and weather
   data are collected through highly automated telematics networks from all
   fixed stations in the metropolitan area. These data are stored in
   integrated relational databases and are analyzed and distributed
   according to EMMA architecture and presented in a user-friendly way
   using graphical tools. Madrid is a demo site in the EMMA project.
   Observations of SO2, NOx, O-3, CO, PM10, Aromatic and radioactivity are
   used together with humidity, wind, temperature, turbulence, including
   vertical and horizontal meteorological conditions. Forecastings of 24
   and 48 hours of meteorology will allow to know the pollution levels at
   those times in the Madrid area.
   A special feature of this architecture is the high degree of integration
   between meteorology and environmental phenomena. In this contribution,
   we will show the architecture of a quasi-real time forecasting tool
   which will be used by the Madrid City Council and by the Madrid
   Environmental Council to inform the public in advance on the sites and
   levels where information is required to fulfill the European Commission
   Directive. EMMA Madrid application is shown in this contribution. A
   combination of an accurate prediction on meteorology, emission,
   deposition and photochemistry and fast real time prediction under
   workstation platforms is shown. The results fulfill correctly the
   requirements of EU Directive.},
