   Rosen, B. P. and Kuramata, M. and Ishikawa, S.},
Editor = {Zhu, YG and Guo, H and Bhattacharya, P and Bundschuh, J and Ahmad, A and Naidu, R},
Title = {Arsinothricin: a novel arsenic-containing antibiotic},
