Title = {Harmonizing sector approaches for scaling up access to arsenic safe
   water in Bangladesh: The DPHE-UNICEF Arsenic Mitigation Protocol},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
