@article{ WOS:A1997XL48000006,
Author = {Aberg, L and Larsen, L and Glad, A and Beilinsson, L},
Title = {Observed vehicle speed and drivers' perceived speed of others},
Journal = {APPLIED PSYCHOLOGY-AN INTERNATIONAL REVIEW-PSYCHOLOGIE APPLIQUEE-REVUE
   INTERNATIONALE},
Year = {1997},
Volume = {46},
