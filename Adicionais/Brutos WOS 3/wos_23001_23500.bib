@inproceedings{ WOS:000165804900009,
Author = {Madsen, MN and Lu, QM and Havno, K and Larsen, H},
Editor = {Singh, VP and Soe, WI and Sonu, JH},
Title = {The role of mathematical models during strategy formulation for water
   resources and waste water management in the Sichuan Province, China},
Booktitle = {WATER RESOURCES PLANNING AND MANAGEMENT},
Year = {1999},
Pages = {83-96},
Note = {International Conference on Water, Environment, Ecology, Socioeconomics
   and Health Engineering (WEESHE), SEOUL NATL UNIV, SEOUL, SOUTH KOREA,
   OCT 18-21, 1999},
Organization = {Seoul Natl Univ; Louisiana State Univ; Korean Soc Civil Engineers; Korea
   Water Resources Assoc; Korean Soc Water \& Waste Water; Korean Soc Agr
   Engn},
Abstract = {Sichuan Province, located in the south of China, is the most populous
   province with more then 110 million people, corresponding to around 10
   percent of the population in China. The province comprises the upper
   reaches of the Yangtze River, upstream of the Three Gorges Dam and has a
   total catchment area of around 570,000 km(2). The discharge of untreated
   industrial and domestic wastewater into the rivers has created severe
   environmental problems. Ail though the Yangtze River still has a large
   absorption capacity the major tributaries such as Tuojiang, Minjiang and
   Jialing rivers suffer from severe pollution. The problems are
   particularly pronounced around the major cities such as Chengdu, Zigong
   and Chongqing.
   The master plan for environmental protection in Sichuan Province has
   year 2000 as target year. The objective is to reduce industrial
   pollutant loading and to comply with national standards with respect to
   quantity as well as surface water quality. However, in order to comply
   with this objective, a sustainable environmental strategy formulation
   for urban water and waste water resources management extending beyond
   year 2000 is required.
   In order to assist in the formulation of the strategy for fourteen major
   cities (ranking of priority investments projects) in the Sichuan
   province a water resources information system to support water resources
   management has been established. Furthermore, the forecast of the effect
   of different strategies with respect to surface water quality required
   the establishment of mathematical models for description of relevant
   physical and biological processes. The main objective of this paper is
   to demonstrate the advantages of integrating mathematical models during
   prioritisation of investment projects within water resources and
   wastewater management. The paper, therefore, comprises a presentation of
   the selected modelling approach and data base management systems
   including results from the evaluation of different priority investment
   projects. Special emphasis is made on the holistic modelling approach
   within the watershed by integrating of water resources and water quality
   models.
   A combined hydraulic and water quality one dimensional model has been
   applied in the main reaches of the Yangtze, Tuojian, Minjiang and
   Jialing rivers, whereas a two-dimensional model description has been
   applied near the city of Chongqing in order to study in more detail the
   local effects of wastewater outlets. A CIS-based river basin model has
   been used to assess the availability of surface and groundwater within
   the province on a more regional scale.},
Publisher = {WATER RESOURCES PUBLICATIONS},
Address = {P O BOX 2841, LITTLETON, CO 80161 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Madsen, MN (Corresponding Author), Danish Hydraul Inst, Agern Alle 5, DK-2970 Horsholm, Denmark.
   Danish Hydraul Inst, DK-2970 Horsholm, Denmark.},
ISBN = {1-887201-24-6},
