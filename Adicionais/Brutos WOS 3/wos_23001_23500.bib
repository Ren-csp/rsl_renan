Title = {Efficient removal of arsenic species by green rust sulfate
   (GRSO4)},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {409-411},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {The interfacial reactivity between green rust sulfate (GR(SO4)) and
   arsenic (As) species were investigated using batch adsorption
   experiments. GR(SO4) is capable of adsorbing up to 155 and 88 mg g(-1)
   of As(III) and As(V), respectively. The value of pH greatly affects
   adsorption, with As(III) removal 2.5 times higher at alkaline pH, while
   As(V) removal higher at circum-neutral conditions. Competing groundwater
   species such as magnesium (Mg2+) or phosphate (PO43-) reduce removal
   efficiency. Our results show that GR(SO4) is a stable, efficient and
   environmentally-relevant mineral substrate for As sequestration in
   anoxic groundwater systems.},
Publisher = {CRC PRESS-BALKEMA},
Address = {PO BOX 11320, LEIDEN, 2301 EH, NETHERLANDS},
