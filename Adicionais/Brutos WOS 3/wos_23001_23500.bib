@article{ WOS:A1996VH89700008,
Author = {Brown, S},
Title = {Treatment of patients with epilepsy and severe and profound learning
   disability},
Journal = {EUROPEAN JOURNAL OF NEUROLOGY},
Year = {1996},
Volume = {3},
Number = {3},
Pages = {35-37},
Month = {AUG},
Note = {Round Table Meeting on Strategies for the Rational Drug Treatment of
   Epilepsy, MARLOW, ENGLAND, JUN 08-10, 1995},
Organization = {Hoechst Marion Roussel},
Abstract = {Treatment of patients with epilepsy who also suffer from learning
   disability represents a significant problem, as this subgroup may
   account for as many as two sevenths of the population with epilepsy. A
   multidisciplinary approach to management is a valuable tool. Treatment
   of these patients has at least three dimensions, namely biological,
   psychological and social. Anti-epileptic drugs (AEDs) may have treatment
   effects in addition to seizure reduction, for instance a reduction in
   the number of seizure-related accidents and associated healthcare costs.
   There is still considerable controversy surrounding the issue of whether
   AEDs may directly produce psychotic episodes. The effect of an AED may
   be to unmask the personality that the patient has In the absence of
   seizures. There is also anecdotal evidence for vigabatrin rarely to
   produce psychosis when starting doses of 2 g per day are used, but not
   with lower doses. Evidence exists to suggest that there may be a role
   for behavioural treatment in patients with epilepsy and learning
   disability. The epileptiform activity of patients tends to be reduced
   when they are occupied, and this may be valuable in patient management.
   Moreover, anecdotal experiences suggest that seizure frequency of
   epilepsy varies with expressed emotion in carers and relatives. As
   carers may experience difficulty in coping with the restoration of
   personality in a patient who has previously required a considerable
   amount of care, explanation for the basis of this change should be
   provided. Care staff should be made aware of the relevant factors that
   should be monitored when auditing patient status. During patient
   follow-up, there should be communication between home, day centre and
   healthcare services, so that a complete patient record is available.},
Publisher = {RAPID SCIENCE PUBLISHERS},
