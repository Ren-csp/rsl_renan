Title = {Anesthesia Residents' Preference for Learning Interscalene Brachial
   Plexus Block (ISBPB): Traditional Winnie's Technique vs.
   Ultrasound-Guided Technique},
Booktitle = {MEDICINE MEETS VIRTUAL REALITY 18},
