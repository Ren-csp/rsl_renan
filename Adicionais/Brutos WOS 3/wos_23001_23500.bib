@inproceedings{ WOS:000390838700005,
Author = {Yang, Wen-Yu and Wu, Fong-Gong and Book, Adam},
Editor = {Duffy, VG and Lightner, N},
Title = {A New Elderly Clothing Design Reduces Nurse Aides' Occupational Injury
   in Nursing Homes},
Booktitle = {ADVANCES IN HUMAN FACTORS AND ERGONOMICS IN HEALTHCARE},
Series = {Advances in Intelligent Systems and Computing},
Year = {2017},
Volume = {482},
Pages = {49-59},
Note = {7th International Conference on Applied Human Factors and Ergonomics /
   International Conference on Human Factors and Ergonomics in Healthcare,
   Bay Lake, FL, JUL 27-31, 2016},
Abstract = {Nurse aids assist the elderly to dress for a long time, they always get
   work-related musculoskeletal disorders (WMSDs) owing to inappropriate
   application of force. The purpose of this study is to design a new
   elderly clothing to reduce the cumulative damage of nurse aids from
   assisting the elderly dressing effectively. We designed two new elderly
   clothes with two different methods, one is Morphological Analysis
   (design A) and the other is Co-design (design B). Design A uses Velcro
   to join fabric to reduce the time nurse aids spend on finding cords.
   Design B is a one-piece cloth which wear from front in order to reduce
   unnecessary rotate of joint. Results showed that design B spend the
   least time. The shortage of design A is it will take time to separate
   Velcro when they stick together. Design B should care more about
   elderly's perception, sense of security and exposure, especially for the
   heavy elderly.},
