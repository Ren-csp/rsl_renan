Title = {`Schizophrenia' as a Metaphor in Greek Newspaper Websites},
Booktitle = {INTEGRATING INFORMATION TECHNOLOGY AND MANAGEMENT FOR QUALITY OF CARE},
Series = {Studies in Health Technology and Informatics},
Year = {2014},
