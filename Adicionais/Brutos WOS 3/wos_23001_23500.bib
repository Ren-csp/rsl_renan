@inproceedings{ WOS:000450031900011,
Author = {Atagher, Peter and Clifford, Mike and Jewitt, Sarah and Ray, Charlotte},
Editor = {Brebbia, CA and Sendra, JJ},
Title = {WHAT'S FOR DINNER? GENDERED DECISION-MAKING AND ENERGY EFFICIENT
   COOKSTOVES IN BENUE STATE, NORTH CENTRAL NIGERIA},
Booktitle = {ENERGY AND SUSTAINABILITY VIII},
Series = {WIT Transactions on Ecology and the Environment},
