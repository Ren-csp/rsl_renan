Title = {Exploration of biochemical properties of soil and groundwater in arsenic
   affected blocks of Murshidabad district and isolation of potential
   arsenic resistant bacteria},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {281-282},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {Arsenic is one of the major contaminants of soil and groundwater,
   responsible for a number of health hazards. Various blocks of
   Murshidabad district show arsenic concentration above the maximum
   permissible limit in soil and water samples. In the present study, we
   have focused on some highly arsenic contaminated regions of Murshidabad
   district. We have analyzed various biochemical parameters of soil and
   water samples of this district. The soils of these regions show high
   alkalinity and the groundwater samples also exhibits a basic pH. The
   total dissolved solids of these water samples varied from 200 mg L-1 to
   300 mg L-1. Also, the bacterial load in the water samples was extremely
   high. Since, groundwater is a source of drinking water in the blocks of
   Murshidabad district, consumption of such high amount of total dissolved
   solids would take a toll on the detoxifying and excretory system of the
   body i.e., on the hepatic and renal systems. The uncharacterized
   microorganisms in the soil could be fecal coliforms or other pathogenic
   bacteria, and their consumption would have serious health consequences.
   After serial dilutions (106 to 109 folds) of the groundwater and the
   soil samples, we could still isolate some bacteria thriving in these
   samples. Since, the soil and groundwater of these regions are highly
   arsenic contaminated, bacterial colonies isolated after serial dilutions
   could be potentially arsenic resistant bacteria.},
