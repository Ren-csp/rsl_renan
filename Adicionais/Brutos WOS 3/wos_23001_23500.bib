@inproceedings{ WOS:000276579600003,
Author = {Naumoski, Andreja and Mitreski, Kosta},
Editor = {Jha, M and Long, C and Mastorakis, N and Bulucea, CA},
Title = {Climate Change Influence On Diatoms Bio-Diversity In Lake Prespa},
Booktitle = {ENVIRONMENTAL SCIENCE AND SUSTAINABILITY},
