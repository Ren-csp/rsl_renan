Title = {Development of the odour dispersion model AUSTAL2000G in Germany},
Booktitle = {ENVIRONMENTAL ODOUR MANAGEMENT: ODOUR EMISSION - ODOUR NUISANCE -
   OLFACTOMETRY - ELECTRONIC SENSORS - ODOUR ABATEMENT},
Series = {VDI BERICHTE},
Year = {2004},
Volume = {1850},
Pages = {411-417},
Note = {International Conference on Environmental Odour Management, Cologne,
   GERMANY, NOV 17-19, 2004},
Abstract = {The starting point for modelling the odour dispersion is the model of a
   meandering plume. Concentration fluctuations in meandering plumes have
   been studied in detail by means of LIDAR measurements which have been
   reviewed and evaluated recently within the project CORN. From the
   concentration fluctuations of the odorous substance the frequency of
   odour perceptions can be deduced which is the basis for the assessment
   of odour impact. By means of a sensitivity analysis, possible and
   desirable simplifications of the modelling concept have been
   investigated with the aim to broaden the range of application and to
   reduce computational expense. The resulting modelling variants have been
   tested on experimental data sets. In some of these sets the dispersion
   of a passive tracer (SF6) was investigated concomitant with the odour
   dispersion. An extension of the current modelling system AUSTAL2000 is
   presented that covers as well the assessment of odour impact for
   licensing procedures in Germany.},
