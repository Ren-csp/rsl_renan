@inproceedings{ WOS:000231864300021,
Author = {Radoux, M},
Editor = {Vymazal, J},
Title = {The impact of Typha latifolia L. on the treatment of wastewater
   by surface-flow constructed wetland},
Booktitle = {Natural and Constructed Wetlands: Nutrients, Metals and Management},
Year = {2005},
Pages = {271-281},
Note = {5th Workshop on Nutrient Cycling and Retention in Natural and
   Constructed Wetland, Borova Lada, CZECH REPUBLIC, SEP 24-27, 2003},
Abstract = {The planting of helophytes for the purpose of extensive treatment of
   household and urban wastewater can significantly exceed the purification
   efficiency obtained by implanted systems such as conventional
   stabilisation ponds. The improvement of purification efficiency can be
   ascribed to physical and biological changes in the ecosystem caused by
   the presence of helophytes. This study is an attempt to determine the
   impact of planting Typha latifolia L. For two consecutive years, the
   protocol compares the purification rates in three miniature systems with
   an identical layout (same number of pools, same pure quartz sand, same
   water levels, same hydraulic rate, etc.) and under identical operating
   conditions (same source of sewage, same local climate, etc.) but with
   the following differences:
   The first system is an implanted baseline,
   The second is planted with Typha latifolia,
   The third is an implanted system with PVC rods in the water all year
   long and an artificial shading over the water during the growth period.
   The aim is to simulate some of the physical effects of the plants in the
   ecosystem without interference with their physiological activity. Our
   results have led us to the following conclusions. Throughout the year,
   the removal of suspended solids (SS) and total organic load (expressed
   as Chemical Oxygen Demand or COD) is considerably enhanced by the
   presence of Typha due to the `horizontal' filter formed by the plant's
   submerged stems and dense aquatic root system. During the growth period,
   the foliage provides shade, thus inhibiting phytoplankton proliferation
   and further improving primary and secondary purification. Planting Typha
   causes changes in the ecosystem which also affect the system's total
   nitrogen and total phosphorus retention. During vegetative dormancy
   periods, tertiary purification is improved because Typha's submerged
   stems and roots increase the area available for the fixation and growth
   of periphyton; however, the gradual decomposition and leaching of these
   bodies reduce this effect. During the growth period, Typha improves
   tertiary efficiency through its own mineral uptake which advantageously
   replaces that of the phytoplankton, as the latter is almost completely
   inhibited by the shade from Typha's foliage.},
