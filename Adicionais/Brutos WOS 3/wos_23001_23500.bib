@inproceedings{ WOS:000240047600030,
Author = {Bosman, G.},
Editor = {Broadbent, G and Brebbia, CA},
Title = {Promoting sustainability of earth constructed private and public
   buildings in South Africa},
Booktitle = {Eco-Architecture: Harmonisation between Architecture and Nature},
