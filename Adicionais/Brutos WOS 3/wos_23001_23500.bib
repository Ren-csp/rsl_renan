@article{ WOS:000816885300002,
Author = {Kim, Ilho and Lee, Jaiyeop},
Title = {Comparison of ozonation removal for PPCPs in secondary treated sewage by
   microbubble generator and ejector},
Journal = {ENVIRONMENTAL ENGINEERING RESEARCH},
