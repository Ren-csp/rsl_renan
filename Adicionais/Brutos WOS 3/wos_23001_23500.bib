@inproceedings{ WOS:000291664400122,
Author = {Ponce de Leao, I. and Lira, S.},
Editor = {Amoeda, R and Lira, S and Pinheiro, C},
Title = {The Agustina Bessa-Luis web-museum: characters from Agustina},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {1113-1118},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {The creation of this web-museum is related to sustainable development at
   the cultural level, aiming, as it does, to create and preserve a rich
   literary heritage without depleting future resources. The continued
   conservation and cultural use of Agustina's literary heritage is one of
   the main goals targeted by this project through the systemic concept of
   sustainability. Literature and literary heritage do not commonly appear
   as the main themes of museums or of museum collections. However,
   literature - and principally socially meaningful literature, as is the
   case of Agustina's - must have a place in the cultural panorama, and
   must play a role in the sustainability of the overall cultural scenario.
   Among the variety of museological contexts and contents included in the
   Agustina Bessa-Luis Museum project, we will focus in this paper on the
   characters of Agustina's macro text, which abounds with descriptions
   treating the settings succinctly but telling us a great deal about the
   characters, who rise up in their own right as structuring elements of
   the narrative. In Agustina, people don't ``do{''} - they ``are{''}. They
   are part of a sign system in which their role is to connect signifiers
   and signified and impose combinatory variables, while avoiding the
   arbitrary nature of the sign. We will see how they recreate a fictional
   world capable of perturbing the real in generating an original
   (con)fusion. Counter Jauss, and pace Hamon, we will uncover an
   anthropological content in them, that is, we will prove that there is in
   them a set of reactions that, in merging with the human psyche,
   engenders identification with the visitor/reader. Hence, this
   identification will always be conditioned by the characters and the
   reading will be constructed according to their reactions. We wanted to
   free the characters from the works in which they appear and realise
   their autonomy as univocal beings ready to leap from fiction into
   reality; to integrate them into a web space so that the visitor/reader
   might construct other works and as many other realities as he/she would
   desire, inventing fictional spaces disposed to play on reality. In these
   spaces we shall encounter Quinas, Leonors, Boals ... , ready to quit
   their posts and build other worlds as required by the dynamics of the
   literary text. This web-museum will enable the public to contact, deeply
   and intimately, with Agustina's characters, making available a vast and
   partially unexplored heritage - not only a literary heritage, but also a
   profound social analysis heritage.},
Publisher = {GREEN LINES INST SUSTAINABLE DEVELOPMENT},
Address = {AV ALCAIDES DE FARIA 377 S 12, BARCELOS, 00000, PORTUGAL},
