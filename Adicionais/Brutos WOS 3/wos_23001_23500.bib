Title = {Climate Change and the Emergence of Helter-Skelter Livelihoods Among the
   Pastoralists of Samburu East District, Kenya},
Booktitle = {EXPERIENCES OF CLIMATE CHANGE ADAPTATION IN AFRICA},
Series = {Climate Change Management},
Year = {2011},
