Organization = {Portuguese Soc Occupat Safety \& Hygiene; Univ Minho, Sch Engn; Univ
   Porto, Fac Engn; Univ Lisbon, Fac Human Kinet; Polytechn Univ Catalonia;
   Tech Univ Delft; Faculdade Motricidade Humana; DELTA; EXIM; ACT;
   European Agcy Safety \& Hlth Work; Lavoro},
Abstract = {This study approaches work accident for the purpose of analyze
   associations with sociodemographic factors and health conditions of the
   working population. To do this, we have collected data from the National
   Health Survey performed by The Brazilian Institute of Geography and
   Statistics (IBGE), 47,629 respondents asked about the occurrence of
   accidents at work in the last 12 months, after exclusion of individuals
   who have not worked in the last 12 months. The bivariate analysis is
   based on the Prevalence Ratio (PR) with 95\% confidence intervals in
   terms of the different available variables surveyed. It was observed
   that the prevalence of work accidents is higher in men, but lower in
   older workers and workers with higher levels of educational. It was also
   observed that the accidents affect the self-perception of health. This
   effect was bigger on individuals who reported indisposition and lack of
   concentration. It was also observed association between violence and
   accidents at work, specially risk in females workers.},
