@inproceedings{ WOS:000225835500057,
Author = {Lofstrom, P},
Book-Group-Author = {VDI/VDE VERLAG},
Title = {Odour annoyance modelled as a single unifying parameter},
Booktitle = {ENVIRONMENTAL ODOUR MANAGEMENT: ODOUR EMISSION - ODOUR NUISANCE -
   OLFACTOMETRY - ELECTRONIC SENSORS - ODOUR ABATEMENT},
Series = {VDI BERICHTE},
Year = {2004},
Volume = {1850},
Pages = {529-532},
Note = {International Conference on Environmental Odour Management, Cologne,
   GERMANY, NOV 17-19, 2004},
Abstract = {Different countries use different types of modelled concentration
   statistics for assessing odour annoyance, e.g. maximum values and
   various percentiles. But it can be argued that two, different sources
   complying with the same limit value can have widely different impacts on
   the annoyance experienced. This is because different type of sources
   observing the same limit value could result in different concentration
   frequency around the limit value. A new method to assess the entire
   spectra of odour concentrations above e.g. the odour threshold is
   proposed. The method uses the odour intensity (the human perception of
   odour strength) as a weight that is multiplied with the frequency of
   odour concentrations occurring in intervals of 1 OU m(-3). The numbers
   are summed to give a single value containing information on all odours
   above e.g. the odour threshold. The technique is used for all hours in
   the assessment period and even for the short-term concentration
   fluctuations within the hours.},
