Title = {The detection of wood decay of trees collection Agathis
   borneensis and Castanopsis argentea at the public area in
   Cibodas Botanical Garden},
Booktitle = {INTERNATIONAL SYMPOSIUM ON ARBORICULTURE IN THE TROPICS: SECURING
   ECOSYSTEM FUNCTIONS IN URBAN LANDSCAPE (ISATROP 2017)},
