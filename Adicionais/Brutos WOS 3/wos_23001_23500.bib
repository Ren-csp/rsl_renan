Title = {An effective rhizoinoculation restraints arsenic translocation in peanut
   and maize plants exposed to a realistic groundwater metalloid dose},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
