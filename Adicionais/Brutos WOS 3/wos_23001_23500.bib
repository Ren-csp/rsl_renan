@inproceedings{ WOS:000346067900142,
Author = {Moutsiakis, E.},
Editor = {Lekkas, TD},
Title = {STREAMLINING THE SUSTAINABILITY APPROACH: SPATIAL SYSTEMS AND GOVERNANCE
   (RE-)ARRANGEMENT},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {In the post Brundland period, perception of natural resources has
   started to change. From simply inputs to human's production processes,
   resources became social goods. Their conservation took an ethical
   justification as the heritage that should be passed to next generations,
   as well as a managerial one, as assets that should be handled wisely for
   the sake of both current and future needs. Resources management is
   intended to be integrated, meaning that the model of governance should
   be reconsidered, putting emphasis on aspects such as cooperation -
   participation culture, social capital, community oriented administrative
   mechanisms and endogenous backing of the intervention. Nevertheless the
   streamlining of the sustainability approach concerning natural resources
   conservation is not space independent. The concept deepening takes into
   consideration the community's decisive role in supporting the core aim.
   Communities act within certain spatial geographical areas and their
   natural resources form essential assets for their development prospect.
   The understanding of the systemic specificities could enhance the
   managerial ability of local structures, a prospect that could promote
   local oriented schemes of governance. Thus the perception of space
   changes towards its acceptance as a functional system based on two key
   points that stand independently but also interacting as well. The first
   one refers to its physical constitution while the second one refers to
   the understanding of flows, both internal and external. Regarding
   especially the physical constitution of a spatial system, the analytical
   approach takes into consideration its primary acceptance as a
   socio-ecological entity. This point of view seems to provide the
   theoretical context for the justification of several intervention
   arrangements in geographically designated areas, such as river basin
   systems, transforming parts of space into programming zones.
   No matter if a spatial system is recognised as a socio-ecological
   entity, or it is accepted as a programming zone, the way of its
   effective management becomes a central priority towards its sustainable
   performance. It is not about handling some technical issues within a
   certain geographical or administrative area. It is about a solid
   development context with technical, administrative, economic and
   political components. The administrative and institutional endowment for
   example should have the appropriate power to make decisions and to
   apply. Along with that, empowerment of local structures and
   participation processes could address the development strategy with the
   necessary political justification and also to highlight local identity
   as an essential factor towards production specializations.},
