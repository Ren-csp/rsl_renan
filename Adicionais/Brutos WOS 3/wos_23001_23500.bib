Title = {Arsenic exposure, lung function, vitamin D and immune modulation in the
   Health Effects of Arsenic Longitudinal Study (HEALS) cohort},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
