Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {The results of two experiments on duration discrimination are reported.
   On each trial, a short (221 ms) or a long (281 ms) interval marked by
   two brief (20 ms) signals (Markers 1 and 2) was presented. A
   supplementary (filler) sensory signal (20 ms), different from Marker 2,
   and which participants were asked to ignore, was presented 180 to 300 ms
   after Marker 1. When the filler was tactile (Experiment 1), participants
   reported more often that the duration between Markers 1 and 2 was long
   when the duration between Marker 1 and the filler presentation was
   longer. When the filler was visual (Experiment 2), the filler's moment
   of occurrence was not as important. It was rather the presence or
   absence of the signal that mostly influenced perceived duration: there
   were more ``short{''} responses in the no-filler condition.},
