@inproceedings{ WOS:000371003600006,
Author = {Feng, Xionghan and Zhao, Huaiyan and Liu, Fan and Cui, Haojie and Tan,
   Wenfeng and Li, Wei},
Editor = {Feng, X and Li, W and Zhu, M and Sparks, DL},
Title = {Transformation from Phyllomanganates to Todorokite under Various
   Conditions: A Review of Implication for Formation Pathway of Natural
   Todorokite},
Booktitle = {ADVANCES IN THE ENVIRONMENTAL BIOGEOCHEMISTRY OF MANGANESE OXIDES},
Series = {ACS Symposium Series},
Year = {2015},
Volume = {1197},
Pages = {107-134},
Note = {Symposium on Advances in Understanding the Environmental Geochemistry of
   Manganese (Mn) Oxides / 247th American-Chemical-Society National
   Meeting, Dallas, TX, MAR 16-20, 2014},
Organization = {Amer Chem Soc, Div Geochemistry},
Abstract = {Todorokite, a family of tunnel-structured Mn oxides with a 3 x 3 array
   of edge-shared MnO6 octahedra, is commonly associated with
   ferromanganese oxides in the marine and terrestrial geological settings.
   Natural todorokite is thought to form from phyllomanganates, such as
   birnessite, buserite and vernadite. The synthesis of todorokite has also
   gained much interest due to its unique MnO6 octahedral molecular sieve
   (OMS) structure and physicochemical properties, providing many potential
   applications, such as adsorbents, catalysts and rechargeable battery
   materials. In this chapter, a review is presented of the transformation
   from phyllomanganates to todorokite under various conditions to
   highlight the factors governing todorokite formation and the underlying
   mechanisms. The three key factors were found to be (i) stable
   10-angstrom phyllomanganate with an appropriate amount and type of
   interlayer cations, (ii) an appropriate number of Mn(III) in the
   phyllomanganate and (iii) a relatively high temperature conditions. On
   this basis, the possible pathway of natural todorokite formation is
   proposed as: biogenic or abiotic phyllomanganate -> stable 10-angstrom
   phyllomanganate with appropriate interlayer cations and structural
   Mn(III) todorokite. These results advance our fundamental knowledge on
   both todorokite formation mechanisms in nature and OMS synthesis design
   in application.},
