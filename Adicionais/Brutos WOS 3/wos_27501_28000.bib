@inproceedings{ WOS:000467909300087,
Author = {Ding, Binbin and Li, Chaolin and Xu, Jianhui and Zhang, Jian and Wang,
   Yaowu and Dong, Xiaoqing},
Book-Group-Author = {IOP},
Title = {Network model evaluation of the effects of pore and particle size
   distributions on dynamic straining-dominant deep bed filtration in
   porous media},
Booktitle = {2018 INTERNATIONAL CONFERENCE OF GREEN BUILDINGS AND ENVIRONMENTAL
   MANAGEMENT (GBEM 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
