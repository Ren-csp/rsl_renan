@article{ WOS:000236231000008,
Author = {Dockerty, T and Lovett, A and Appleton, K and Bone, A and Sünnenberg, G},
Title = {Developing scenarios and visualisations to illustrate potential policy
   and climatic influences on future agricultural landscapes},
Journal = {AGRICULTURE ECOSYSTEMS \& ENVIRONMENT},
Year = {2006},
Volume = {114},
Number = {1},
Pages = {103-120},
