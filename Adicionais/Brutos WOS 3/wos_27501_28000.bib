@article{ WOS:000383113900097,
Author = {Ismail, Wan Zuriea Wan and Ariff, Nor Rima Muhamad and Ahmad, Sabarinah
   Sh. and Kamarudin, Hikmah},
Title = {Green Roof Maintenance Towards Sustaining Neighborhood Spaces of
   High-Rise Residential Developments in Malaysia},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {5-6, SI},
Pages = {1502-1508},
Month = {MAY-JUN},
Note = {International Symposium on Social Sciences, Arts and Humanities
   (SYSSARM), Bali, INDONESIA, SEP 29-OCT 01, 2015},
Abstract = {Green roofs have been established for over 100 years globally and
   currently it is one of the key elements in urban greening. In Malaysia,
   most green roofs are installed in high rise residential buildings and
   act as a place for social purposes. Green roofs implementation is still
   and studies about green roofs are few. Many scientific researches focus
   on quantifying its cooling performance, efficiency and survival rates of
   plants. There is lack of scientific research that focuses on management
   and maintenance of green roofs. Maintenance plays a crucial role in
   sustaining green roofs for its intended function. This research looks at
   how green roofs are maintained in high rise residential buildings in the
   Klang Valley. The objective of this research is to assess the
   maintenance practice of intensive green roofs at high rise residential
   buildings. This research has been conducted by examining intensive green
   roofs through condition survey assessments and verbal information gained
   through interviews with managing agents and maintenance managers at five
   selected buildings. These case studies specifically focused at high rise
   residential buildings that are located in Shah Alam and Subang Jaya.
   Upon analysing of the data, it is apparent that green roofs maintenance
   is carried out in two main aspects, namely structural and vegetation
   maintenance. Generally, it can be concluded that maintenance practice
   plays a critical role in sustaining intensive green roofs at high rise
   residential buildings. Fewer maintenance problems encountered at green
   roofs will inspire more green roofs implementation in future.},
