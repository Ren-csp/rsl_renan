@article{ WOS:000352201700003,
Author = {Chittenden, Francis and Ambler, Tim},
Title = {A question of perspective: Impact Assessment and the perceived costs and
   benefits of new regulations for SMEs},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
Year = {2015},
Volume = {33},
Number = {1},
Pages = {9-24},
Note = {36th Annual Institute for Small Business and Entrepreneurship Conference
   (ISBE), Cardiff, WALES, NOV, 2013},
Abstract = {Regulation remains a contentious topic between small firms, policy
   makers, and scholars. Business lobbying organizations persistently claim
   that regulation acts as a deterrent to economic activity. In contrast,
   policy makers and some scholars have argued that regulation creates net
   benefits for society and so may have a modest positive impact on SMEs.
   This paper seeks to offer at least a partial explanation for these very
   different perspectives. Through studying the majority of UK Impact
   Assessments issued over the twelve years from 1998 to 2009 and relevant
   government publications, we find that differences in the objective
   decision-making criteria ( algorithms and heuristics) of the parties
   involved provide at least a partial explanation of why their views
   appear irreconcilable. It is argued that both are acting rationally in
   pursuit of higher goals and are not simply `gaming' in order to gain the
   greatest private advantage.},
