@article{ WOS:000074213100010,
Author = {Jones, RW and Warner, JW and Cross, CL},
Title = {How are graphs read? An indication of sequence},
Journal = {BEHAVIOR RESEARCH METHODS INSTRUMENTS \& COMPUTERS},
Year = {1998},
Volume = {30},
Number = {2},
Pages = {238-245},
