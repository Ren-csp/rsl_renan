Title = {The influence of intense stress on the formation of aggressive reactions
   and ideas of revenge in the population of the post-war region},
Booktitle = {TRENDS IN THE DEVELOPMENT OF PSYCHO-PEDAGOGICAL EDUCATION IN THE
   CONDITIONS OF TRANSITIONAL SOCIETY (ICTDPP-2019)},
