@inproceedings{ WOS:000181289100013,
Author = {Rundmo, T and Ulleberg, P},
Editor = {Rantanen, J and Lehtinen, S and Saarela, L},
Title = {Risk-taking attitudes and driving behaviour among adolescents in two
   Norwegian Counties},
Booktitle = {PROCEEDINGS OF THE EUROPEAN CONFERENCE ON SAFETY IN THE MODERN SOCIETY},
Series = {PEOPLE AND WORK: RESEARCH REPORTS},
Year = {2000},
Volume = {33},
Pages = {66-70},
Note = {European Conference on Safety in the Modern Society, HELSINKI, FINLAND,
   SEP 15-17, 1999},
Organization = {European Commiss; Finnish Inst Occupat Hlth; Minist Social Affairs \&
   Hlth; Safety Technol Author; Finnish Consumer Agcy},
Abstract = {The core aim of the present paper was to analyse associations between
   adolescents' risk-taking attitudes and driving behaviour. The study also
   examines the role of personality traits in relation to attitudes and
   behaviour. A self-completion questionnaire survey was carried out among
   4,070 adolescent between 16 and 23 years of age in two Norwegian
   counties. The questionnaire contained scales measuring attitudes towards
   driving and driving behaviour as well as various personality traits.
   Multivariate analyses showed significant associations between
   risk-taking attitudes and driving behaviour. Non-ideal attitudes were
   more frequently observed among high sensation seekers and among
   respondents who scored high on normlessness and carelessness compared to
   respondents scoring low on these traits. In addition, there seemed to be
   moderating effects of personality.},
