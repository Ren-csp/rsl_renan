@article{ WOS:000084802300003,
Author = {Tardif, T and Wellman, HM},
Title = {Acquisition of mental state language in Mandarin- and Cantonese-speaking
   children},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {2000},
Volume = {36},
Number = {1},
Pages = {25-43},
Month = {JAN},
Note = {1997 Biennial Meeting of the Society-of-Research-in-Child-Development,
   WASHINGTON, D.C., MAR-APR -, 1997},
Organization = {Soc Res Child Dev},
Abstract = {Children's theory of mind appears to develop from a focus on desire to a
   focus on belief. However, it is nor clear (a) whether this pattern is
   universal and (b) whether it could also be explained by linguistic and
   sociocultural factors. This study examined mental state language in 10
   Mandarin-speaking (21-27 months) and 8 Cantonese-speaking (18-44 months)
   toddlers. The results suggest a pattern of theory-of-mind development
   similar to that in English, with early use of desire terms followed by
   other mental state references. However, the Chinese-speaking children
   used desire terms much earlier, and the use of terms for thinking was
   very infrequent, even for Mandarin-speaking adults. This finding
   suggests a consistency in the overall sequence, but variation in the
   timing of beginning and end points, in children's theory-of-mind
   development across cultures.},
