@inproceedings{ WOS:000227683000104,
Author = {Litovsky, R and Johnstone, P and Parkinson, A and Peters, R and Lake, J},
Editor = {Miyamoto, RT},
Title = {Bilateral cochlear implants in children},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2004},
Volume = {1273},
Pages = {451-454},
Note = {8th International Cochlear Implant Conference, Indianapolis, IN, MAY
   10-13, 2004},
Organization = {NIDCD; Psi Iota Xi; Indiana Lions; St Joseph Inst Deaf; Indiana Univ
   Cochlear Implant Team},
Abstract = {This study investigated the extent to which 9 months of listening with
   bilateral cochlear implants (CIs) improves the ability of children to
   hear speech in noise and to localize sounds. Three children ages 8-12
   who received sequential bilateral CIs, 3-8 years apart, participated in
   a series of binaural tasks at 3 and 9 months after activation of the
   second CI. Each child participated in a battery of tests under
   unilateral and bilateral conditions. Results suggest that speech
   intelligibility in noise improves with added bilateral experience, but
   that speech intelligibility in quiet does not. In addition, the
   improvement was seen primarily for the two younger children, who had
   received the second CI at the age of 8, but not for the older child
   whose second CI was received at the age of 12. None of the children were
   able to localize sounds well at 3 or 9 months after receiving the second
   CI. Further research is necessary to establish the importance of age of
   implantation and duration of bilateral experience necessary in order for
   maximal performance to be achieved. (c) 2004 Elsevier B.V. All rights
   reserved.},
