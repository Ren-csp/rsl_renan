Title = {Macroscopic and Microscopic Analysis of Speech Recognition in Noise:
   What Can Be Understood at Which Level?},
Booktitle = {NEUROPHYSIOLOGICAL BASES OF AUDITORY PERCEPTION},
Year = {2010},
