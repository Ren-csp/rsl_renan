Title = {LEARNING THROUGH COOPERATION AND THE PROJECT METHOD IN PRE-SCHOOL
   EDUCATION IN ROMANIA},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2019},
