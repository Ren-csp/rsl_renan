@inproceedings{ WOS:001253743700023,
Author = {Galopin, Sylvain and Richard, Freddie-Jeanne and Touya, Guillaume},
Editor = {Heppenstall, A and Wang, M and Demsar, U and Lemmens, R and Yao, J},
Title = {Geolocating Bees by Translating the Waggle Dance Into Spatial
   Coordinates},
