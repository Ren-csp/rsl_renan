@inproceedings{ WOS:000083105000173,
Author = {DeLozier, WM and Bourgeis, E},
Book-Group-Author = {DECIS SCI INST
   DECIS SCI INST},
Title = {Self concept and marketing communications for television an exploratory
   study},
Booktitle = {DECISION SCIENCES INSTITUTE 1998 PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {412-414},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {The purpose of this study is to consider if self theory can be
   effectively applied to the development of marketing communications
   strategies. More specifically, using television as the medium of
   communications was considered. Many studies over the years have
   presented evidence that self concept is a proven tool to utilize in
   developing an image-based advertisement for brand or product. Once the
   target market is defined through self concept measurements, a brand
   product could then be designed to match that market's image. This study
   attempts to provide evidence that preferred television programs could be
   predicted based on the self and self ideal concepts of a specific
   segment of the population.},
Publisher = {DECISION SCIENCES INST},
Address = {UNIV PLAZA, ATLANTA, GA 30303 USA},
Type = {Proceedings Paper},
Language = {English},
