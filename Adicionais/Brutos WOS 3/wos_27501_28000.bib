@article{ WOS:000080980900046,
Author = {Bobes, MA and Valdes-Sosa, M and García, M and Gómez, JF and Lopera, F},
Title = {ERP signs of abnormal face processing in prosopagnosia},
Journal = {BRAIN AND COGNITION},
Year = {1999},
Volume = {40},
Number = {1},
Pages = {52-57},
Month = {JUN},
Note = {Tennet IX - Theoretical and Experimental Neuropsychology Conference,
   UNIV QUEBEC MONTREAL, MONTREAL, CANADA, JUN 10-12, 1998},
Organization = {Univ Quebec Montreal; MRC Canada; Minist Ind \& Commerce},
Abstract = {The identity of the processing stages impaired in prosopagnosia is under
   debate. Here the event related potential (ERP) component N374 is used to
   explore the functional integrity of face recognition units (FRUs) in the
   prosopagnosic patient F.E. The N374 is elicited by incongruities in a
   face-feature matching paradigm, and previous work has shown that
   possession of detailed face-structural knowledge is a prerequisite for
   its production. We found that the patient did not generate this
   component, whereas the N400 (associated to semantic incongruities) was
   elicited normally. These results suggested that prosopagnosia, in
   patient F.E., is due to the impairment of the FRUs. (C) 1999 Academic
   Press.},
