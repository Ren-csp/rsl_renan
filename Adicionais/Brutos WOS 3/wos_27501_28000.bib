Title = {VIOLENT COMMUNICATION IN THE COUPLE, IRRATIONAL BELIEFS ABOUT VIOLENCE,
   GENDER ROLES AND THE COUPLE RELATIONSHIP: ANSWER DISTORTIONS},
Booktitle = {PSICOLOGIA JURIDICA: CONOCIMIENTO Y PRACTICA},
Series = {Coleccion Psicologia y Ley},
Year = {2017},
