Title = {Towards sustainable cultural landscape: A challenge in developing
   ecomuseum in Minahasa Region},
Booktitle = {3RD INTERNATIONAL SYMPOSIUM FOR SUSTAINABLE LANDSCAPE DEVELOPMENT (ISSLD
   2017)},
