@article{ WOS:000167689200019,
Author = {Florig, HK},
Title = {Alternative goals and policy mechanisms for radiation protection},
Journal = {HEALTH PHYSICS},
Year = {2001},
Volume = {80},
Number = {4},
Pages = {397-400},
Month = {APR},
Note = {36th Annual Meeting of the
   National-Council-on-Radiation-Protection-and-Measurements, ARLINGTON,
   VA, APR 05-06, 2000},
Abstract = {For decades, radiation protection philosophy and practice have been the
   domain of professionals trained in the physical and medical sciences.
   Radiation protection policy was formulated and implemented largely
   without consultation with or participation by other professional
   disciplines or the general public. Although, from a public health
   standpoint, past radiation protection efforts have worked well, there
   are growing signs that the public has lost confidence in the radiation
   risk management system as currently configured. This paper draws on
   perspectives of political science, social psychology, economics, and
   decision analysis to analyze the limitations of the current radiation
   protection regime and to suggest alternatives for enhancing public trust
   and improving efficacy.},
