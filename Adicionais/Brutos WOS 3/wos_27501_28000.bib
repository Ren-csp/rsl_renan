@inproceedings{ WOS:000084731400034,
Author = {Farrell, MJ and Robertson, IH and Thomson, JA},
Editor = {Killeen, PR and Uttal, WR},
Title = {Awareness of spatial relationships during locomotion without vision},
Booktitle = {FECHNER DAY 99: THE END OF 20TH CENTURY PSYCHOPHYSICS, PROCEEDINGS},
Year = {1999},
Pages = {186-191},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {We report two experiments that investigated the mechanisms involved in
   updating spatial position during locomotion without vision. Participants
   had to point to previously seen targets after body rotation while
   blindfolded. In one condition, the updating condition, they had to point
   to the true position of the target; in another condition, the ignoring
   condition, they had to ignore their rotation and point to the target as
   if they were still in their original position. Response latencies in
   both of these conditions were longer when participants had to perform a
   concurrent visuospatial task during rotation, indicating that both
   required the use of visuospatial working memory. In a second experiment,
   participants had to perform a task (backwards counting) that made use of
   central processing resources. Only response latencies in the ignoring
   condition were affected by this task, indicating that trying to override
   spatial updating requires the use of more general attentional resources,
   but that keeping track of one's position does not.},
