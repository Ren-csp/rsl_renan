Title = {Auditory Streaming at the Cocktail Party: Simultaneous Neural and
   Behavioral Studies of Auditory Attention},
Booktitle = {NEUROPHYSIOLOGICAL BASES OF AUDITORY PERCEPTION},
Year = {2010},
