@inproceedings{ WOS:000345439900006,
Author = {Labiadh, Lazhar and Ramanantsoa, Marie-Martine},
Editor = {Maree, K},
Title = {Children's Imitation With Varied Demonstration And Reproduction Delays},
Booktitle = {2ND WORLD CONFERENCE ON PSYCHOLOGY AND SOCIOLOGY (PSYSOC 2013)},
