@article{ WOS:000182109100004,
Author = {Walker, RM and Mullins, D and Pawson, H},
Title = {Devolution and housing associations in Great Britain: Enhancing
   organisational accountability?},
Journal = {HOUSING STUDIES},
Year = {2003},
Volume = {18},
Number = {2},
Pages = {177-199},
Month = {MAR},
Note = {Spring Conference of the Housing-Studies-Association, YORK, ENGLAND, APR
   03-04, 2002},
Organization = {Housing Studies Assoc},
Abstract = {This paper evaluates, through a fourfold framework, the extent to which
   devolution in Great Britain has enhanced the organisational
   accountability of housing associations three years after the creation of
   the Scottish Parliament and National Assembly for Wales. The evaluation
   framework examines the goals set for social housing organisations, the
   processes by which they are set, and the ways in which goals are
   monitored and enforced. The assessment reveals that, whilst it would be
   a mistake to suggest that housing policies and administrative frameworks
   have been traditionally monolithic across Britain, there is evidence
   that they are now diverging further, and that policy priorities for
   housing associations are coming to reflect local circumstances and
   locally-determined decisions to a greater extent than hitherto. The
   utility of the evaluation framework is thus demonstrated. It is
   concluded that the organisational accountability of housing associations
   has been enhanced alongside, and, to some extent, as a result of,
   devolution.},
