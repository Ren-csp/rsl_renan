   CHINA, DEC 15-17, 2010},
Organization = {Hong Kong Polytechn Univ, Fac Construct \& Land Use; Inst Urban
   Environm; Road King Infrastructure Ltd; Sun Hung Kai Properties; Chun Wo
   Dev Holdings Ltd; K C Wong Educ Fdn; Environm \& Conservat Fund; Gammon;
