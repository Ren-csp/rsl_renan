@inproceedings{ WOS:000225835500027,
Author = {Granger, F and Narjoux, A and Pagé, T and Cournoyer, M and Guy, C},
Book-Group-Author = {VDI/VDE VERLAG},
Title = {Development of a standard procedure for the sampling and the measurement
   of odour emissions from farm manures, biosolids, and other wastes -:
   Phase II -: Procedure validation},
Booktitle = {ENVIRONMENTAL ODOUR MANAGEMENT: ODOUR EMISSION - ODOUR NUISANCE -
   OLFACTOMETRY - ELECTRONIC SENSORS - ODOUR ABATEMENT},
Series = {VDI BERICHTE},
Year = {2004},
Volume = {1850},
Pages = {239-246},
Note = {International Conference on Environmental Odour Management, Cologne,
   GERMANY, NOV 17-19, 2004},
Abstract = {The Ministry of Environment of the province of Quebec, Canada, has
   guidelines for the land application of biosolides and other wastes since
   the early 1980's. These guidelines must be respected to obtain the
   required authorization prior to land application. Towards the end of the
   1990's, subjective odour categories and set back distances were
   introduced in the guidelines. The odour categories were reviewed and
   redefined during 2001-2002, but they are still based on a
   ``subjective{''} appreciation. However, the Ministry of Environment had
   recognized the need for an objective approach to odour classification.
   Hence, the first phase of this project, started in fall 2001, has
   defined a standard and representative procedure for the sampling,
   conservation, and conditioning of waste samples and the measurement of
   their odour emission rates. In Phase 11, the objectives were to validate
   the methodology proposed, to adjust and improve the laboratory
   procedures and to evaluate its commercial and social applicability.
   Moreover, it has been acknowledged in Quebec that the credibility of the
   methodology relies on its ability to reflect the public's perception of
   the odours emitted from various materials being land spread as a large
   number of odour complaints can put an end to an otherwise very
   acceptable land application program. For that purpose, the methodology
   included an incubation period for the waste to be tested to induce odour
   emissions with a potential impact on the public, especially in the case
   of initially low odour wastes developing strong malodorous conditions
   during a relatively short storage period. Two types of farm manures,
   solid dairy cattle manure and liquid hog manure, were used for this
   validation, as they are considered to be reference materials by the
   Ministry of Environment of Quebec, with respect to the public's
   tolerance to odour nuisances. Representative composite samples of manure
   were collected on four hog farms (feeders) and four dairy farms. In all,
   six composite samples per manure type were collected and prepared for
   olfactometric analyses. Three gas samples were collected per composite
   sample and two olfactometric analyses were performed on each gas sample:
   odour threshold and hedonic tone determinations. Odour emission rates
   were higher when measured after incubation on initially non-fermented
   raw material. Mean odour emission rates after incubation ranged from
   0,24 to 0,99 OUE/m(2)/s for initially aged (stored) liquid pig manure
   and from 0,35 to 0,42 OUE/m(2)/s for initially aged (stored) solid dairy
   cattle manure. The results indicated that an incubation period prior to
   odour measurements was not appropriate to evaluate the odour emission
   rates of farm manures used as reference materials. However, it is an
   important consideration as some wastes, with initially low malodorous
   emissions, may show high levels of odour nuisance in the vicinity of
   spreading areas after a relatively short storage period. Although, the
