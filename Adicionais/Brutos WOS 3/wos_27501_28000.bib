@inproceedings{ WOS:000313637300095,
Author = {Yu, Y. J. and Long, H. and Feng, Z. Q.},
Editor = {Teng, JG},
Title = {TEMPERATURE FIELD SIMULATION OF BOREHOLE GROUND HEAT EXCHANGERS
   CONSIDERING HYDROGEOLOGIC CONDITIONS},
Booktitle = {PROCEEDINGS OF THE FIRST INTERNATIONAL CONFERENCE ON SUSTAINABLE
   URBANIZATION (ICSU 2010)},
Year = {2010},
Pages = {756-763},
Note = {1st International Conference on Sustainable Urbanization (ICSU), Hong
   Kong Polytechn Univ, Fac Construct \& Environm, Hong Kong, PEOPLES R
   CHINA, DEC 15-17, 2010},
Organization = {Hong Kong Polytechn Univ, Fac Construct \& Land Use; Inst Urban
   Environm; Road King Infrastructure Ltd; Sun Hung Kai Properties; Chun Wo
   Dev Holdings Ltd; K C Wong Educ Fdn; Environm \& Conservat Fund; Gammon;
   Paul Y; Architecture Design \& Res Grp Ltd (AD+RG); China State
   Construct (CSCEC); Sino Grp; Vantage Int (Holdings) Ltd; ASCE Hong Kong
   Sect; ASHRAE Hong Kong Chapter; CIBSE; Construct Ind Council (CIC);
   Chartered Inst Bldg (CIOB); Council Sustainable Dev; Emerald; Hong Kong
   Inst Architects; Hong Kong Institut Engineers; Hong Kong Inst Surveyors;
   HKSTS; IUE; JSCE; RICS; Urban Planning Soc China; China Civil Engn Soc;
   Hong Kong Inst Util Specialists},
Abstract = {A three-dimensional heat transfer model considering multi-layer soil,
   groundwater flow and variable heat load around borehole ground heat
   exchangers used in geothermal heat pump systems is developed, and a
   formula of the non-steady state temperature response has been derived
   using Green function and moving line source method. The heat rate
   profile throughout 8760 hours of a laboratory in Nanjing is calculated
   by DEST software, and the field temperature rise around a single
   borehole and borehole group are simulated by virtue of Matlab (R)
   program. Simulation results show that the temperature curves change
   clearly between soil layers along the borehole, the smaller the thermal
   conductivity, the greater the absolute value of the temperature rise
   happens. This means that the thermal interference effect between two
   boreholes should be investigated based on the soil layer with the
   smallest thermal conductivity to optimize the borehole layout. At the
   rock layer with high thermal conductivity, the temperature rises at the
   locations two meters away from the borehole are nearly zero throughout a
   year. It is also found that the magnitude of groundwater flow rate at
   10(-8) m/s level could hardly affect the underground temperature field
   and there are small differences between the temperature field after one
   year's running and that after two or even five years' running.
   Therefore, studying the field temperature after one year's running can
   be adequate. The proposed three-dimensional model can be used to study
   the complex situation of various regions with multi-layer soil and
   different groundwater velocity so as to analysis and predict accurately
   the distributions of underground temperature field around borehole
   ground heat exchangers of geothermal heat pump systems.},
