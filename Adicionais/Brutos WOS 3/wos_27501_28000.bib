   Tiantian and Hu, Yuekai and Ma, Yaxin and Xu, Junfeng},
Editor = {Fu, B and Jia, L and Sun, J and Li, X and Shi, P},
Title = {Research on trend of warm-humid climate in Central Asia},
Booktitle = {3RD INTERNATIONAL SYMPOSIUM ON EARTH OBSERVATION FOR ARID AND SEMI-ARID
   ENVIRONMENTS (ISEO2016)},
