@inproceedings{ WOS:000573716900048,
Author = {Leszczynska, Agnieszka},
Editor = {Hajek, P and Vit, O},
Title = {WORK RELATED VALUES AND ORGANIZATIONAL COMMITMENT RELATIVE TO GENDER AND
   AGE},
Booktitle = {CBU INTERNATIONAL CONFERENCE PROCEEDINGS 2018: INNOVATIONS IN SCIENCE
   AND EDUCATION},
Series = {Proceedings of CBU},
Year = {2018},
