@inproceedings{ WOS:000481933700056,
Author = {Olga, Chis and Alexandra, Oltean},
Editor = {Chis, V and Albulescu, I},
Title = {DEVELOPING PARENT EDUCATOR SKILLS AT STUDENTS STUDYING PRESCHOOL AND
   PRIMARY EDUCATION},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
