@article{ WOS:000181218900011,
Author = {Becker, AE and Franko, DL and Speck, A and Herzog, DB},
Title = {Ethnicity and differential access to care for eating disorder symptoms},
Journal = {INTERNATIONAL JOURNAL OF EATING DISORDERS},
Year = {2003},
Volume = {33},
