@article{ WOS:A1997XL75300010,
Author = {Ellis, HC and Moore, BA and Varner, LJ and Ottaway, SA and Becker, AS},
Title = {Depressed mood, task organization, cognitive interference, and memory:
   Irrelevant thoughts predict recall performance},
Journal = {JOURNAL OF SOCIAL BEHAVIOR AND PERSONALITY},
Year = {1997},
Volume = {12},
Number = {2},
Pages = {453-470},
Month = {JUN},
Note = {Session on Cognition and Emotion at a Meeting of the
   International-Stress-and-Anxiety-Research-Society, PRAGUE, CZECH
   REPUBLIC, JUL, 1995},
Organization = {Int Stress \& Anxiety Res Soc},
Abstract = {This experiment investigated the relationship between experimentally
   induced mood states, task organization, the production of irrelevant
   thoughts, and recall. College students were induced into either a
   depressed mood or a neutral mood. Then they attempted To learn and
   recall letter sequences grouped into high or low structure. The high
   structure sequence consisted of five wards. The low structure sequence
   consisted of the same letters grouped in five relatively meaningless
   strings. Following this procedure, participants were asked to write down
   the thoughts they had while learning the material. Compared with the
   neutral mood, depressed mood reduced recall. Correspondingly depressed
   mood increased irrelevant thoughts when participants learned a high
   structure task but did not affect recall or irrelevant thoughts when
   participants learned a low structure task. importantly the experiment
   obtained a negative relationship between recall and the proportion of
   irrelevant thoughts. This relationship can be interpreted in terms of a
   resource allocation model which proposes that irrelevant thoughts
   cognitively interfere with processing of the memory task.},
