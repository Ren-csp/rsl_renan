@article{ WOS:000232285100020,
Author = {Ogden, PE and Wu, EH and Elnicki, MD and Battistone, MJ and Cleary, LM
   and Fagan, MJ and Friedman, E and Gliatto, PM and Harrell, HE and
   Jennings, MS and Ledford, CH and Mechaber, AJ and Mintz, M and O'Brien,
   K and Thomas, MR and Wong, RY},
Title = {Do attending physicians, nurses, residents, and medical students agree
   on what constitutes medical student abuse?},
Journal = {ACADEMIC MEDICINE},
Year = {2005},
Volume = {80},
Number = {10, S},
Pages = {S80-S83},
Month = {OCT},
Note = {44th Annual Conference on Research in Medical Education held in
   Conjuction with the 116th Annual Meeting of the
   Association-of-American-Medical-College, Washington, DC, NOV 04-09, 2005},
Organization = {Assoc Amer Med Coll},
Abstract = {Background Whether attending physicians, residents, nurses, and medical
   students agree on what constitutes medical student abuse, its severity,
   or influencing factors is unknown.
   Method We surveyed 237 internal medicine attending physicians,
   residents, medical students, and nurses at 13 medical schools after
   viewing five vignettes depicting potentially abusive behaviors.
   Results The majority of each group felt the belittlement, ethnic
   insensitivity, and sexual harassment scenarios represented abuse but
   that excluding a student from participating in a procedure did not. Only
   a majority of attending physicians considered the negative feedback
   scenario as abuse. Medical students rated abuse severity significantly
   lower than other groups in the belittlement scenario (p <.05).
   Respondents who felt abused as students were more likely to rate
   behaviors as abusive (p <.05).
   Conclusions The groups generally agree on what constitutes abuse, but
   attending physicians and those abused as students may perceive more
   behaviors as abusive.},
