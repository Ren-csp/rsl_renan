@article{ WOS:000431498300152,
Author = {Anuar, Muhammad Izzat and Kasuma, Jati and Yacob, Yusman and Kamaruddin,
   Hazami M. and Shahrinaz, Irwan and Fadil, Mohd Zaki Mohd},
Title = {Metrosexual Men: Intention to Purchase Facial Care Product, Attitude or
   Price?},
