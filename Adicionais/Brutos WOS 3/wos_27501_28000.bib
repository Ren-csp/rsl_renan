@inproceedings{ WOS:000554412700020,
Author = {Oguma, Kouhei and Matsushita, Hiroshi and Hirayama, Takayuki and
   Kawamura, Hiroyuki and Yasuda, Tomohiro and Mase, Hajime},
Editor = {Viet, NT and Xiping, D and Tung, TT},
Title = {ROUGHNESS FACTOR OF TWO TYPE WAVE-DISSIPATING BLOCKS ESTIMATED BY
   OVERTOPPING EXPERIMENTS},
Booktitle = {PROCEEDINGS OF THE 10TH INTERNATIONAL CONFERENCE ON ASIAN AND PACIFIC
   COASTS, APAC 2019},
Year = {2020},
Pages = {137-143},
Note = {10th International Conference on Asian and Pacific Coasts (APAC),
   Thuyloi Univ, Hanoi, VIETNAM, SEP 25-28, 2019},
Organization = {NAFOSTED; LONG THANH; FECON; LICOGI 16; SHENLIAN},
Abstract = {This study estimated the roughness factor of two type wave-dissipating
   blocks by wave overtopping experiments to calculate the amount of
   overtopping discharge based on EurOtop. The relationship between the
   roughness factor gamma(f) and surf similarity parameter xi(m-1,0) was
   also examined. Experiments were conducted using a two-dimensional wave
   flume, and test blocks were GRASP and SEA-LOCK. The experimental
   conditions were set referring to Bruce et al. (2009). The input wave was
   random waves having JONSWAP spectrum of gamma=3.3. The boundary of
   xi(m-1,0) was set to 4.0, and gamma(f) was estimated by the least
   squares method. The relationship between the overtopping discharge q and
   the crest height RC was considered. Comparison of gamma(f) in cases with
   different layer thickness showed that the case of gamma(f) with large
   layer thickness was smaller than the gamma(f) with small layer thickness
   case. The results of Rock and Cube in the experiments by Bruce et al.
   indicated that the gamma(f) value of two-layers was smaller than that of
   single-layer, the present study was same tendency as existing results.
   By comparing gamma(f) in cases with different structure crest width
   G(C), it was found the case of G(C)=150 mm was gamma(f) =0.36 of which
   value was about 8\% smaller than the case of G(C) =104 mm. Consequently,
   it is considered that the gamma(f) value of wide structure crest became
   smaller than that of narrow crest. Under two-layer thickness condition,
   the roughness factors gamma(f) of SEA-LOCK were 15\% smaller than the
   gamma(f) of GRASP. The installed volume porosity of GRASP is 63.5\% and
   SEA-LOCK is 53\%, GRASP is 10.5\% larger than SEA-LOCK. In addition to
   the difference in block shape, it is thought that the difference in the
   installed volume porosity of the block also affected the overtopping
   discharge.},
Publisher = {SPRINGER-VERLAG SINGAPORE PTE LTD},
