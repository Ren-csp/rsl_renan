@inproceedings{ WOS:000404788200021,
Author = {Roberts, Philip J. W. and Taplin, Justin and Zigas, Eric},
Editor = {Dunn, CN and VanWeele, B},
Title = {Disposal of Seawater Desalination Brines and the CEQA/NEPA Process},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2017: WATER,
   WASTEWATER, AND STORMWATER; URBAN WATERSHED MANAGEMENT; AND MUNICIPAL
   WATER INFRASTRUCTURE},
Year = {2017},
Pages = {278-285},
Note = {17th Annual World Environmental and Water Resources Congress,
   Sacramento, CA, MAY 21-25, 2017},
Organization = {Amer Soc Civil Engineers; Amer Soc Civil Engineers, Environm \& Water
   Resources Inst},
Abstract = {Seawater desalination results in a concentrated brine that must be
   safely disposed of. The commonly-used reverse osmosis (RO) process
   generates concentrate with a salinity about twice that of the intake
   seawater. This level of salinity would be toxic to many marine organisms
   so the concentrate must be quickly diluted to safe levels. The
   California Ocean Plan (Plan) has recently been amended to include new
   regulations on desalination discharges. These include the definition of
   a brine mixing zone (BMZ), numeric salinity limits, and assessment of
   marine organism mortality due to shear and turbulence in the discharge.
   In this paper we review and summarize the changes in the Plan and
   provide a case study for a proposed desalination plant in an
   environmentally sensitive location in Northern California to ensure
   compliance with the Plan and to support environmental review under the
   CEQA/NEPA process. Discussed is modeling of the plume dynamics and
   dilution, predictions of salinity within the BMZ, and assessments of
   biota mortality due to entrainment into the jets of the proposed
   diffuser.},
