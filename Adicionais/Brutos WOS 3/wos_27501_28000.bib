@inproceedings{ WOS:000399861400042,
Author = {Shao Lei and Yuan Sheng-yuan and Li Chang-an},
Editor = {Chang, T},
Title = {Nd Isotopic Variations in the Jianghan Basin: Response to the Episodic
   Uplift of the Tibetan Plateau during the Early Pleistocene},
Booktitle = {2012 4TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
   INFORMATION APPLICATION TECHNOLOGY (ESIAT 2012)},
Series = {Advances in Biomedical Engineering},
Year = {2013},
Volume = {14},
Pages = {247-250},
Note = {4th International Conference on Environmental Science and Information
   Application Technology (ESIAT 2012), Bali, INDONESIA, DEC 01-02, 2012},
Abstract = {The uplift of the Tibetan Plateau has left a lot of sedimentary evidence
   in the surrounding area and marginal seas. In this paper the Nd isotopic
   values were used to excavate useful information for the uplift of the
   Tibetan Plateau during the Early Pleistocene. Our results show that the
   Nd isotopic composition of sediments in the Jianghan Basin also recorded
   the evidence for the uplift of the Tibetan Plateau during the Early
   Pleistocene.14 samples were collected from the borehole sediments
   between the depth of 82 m and 184 m. Only the fine fraction (<0.058mm)
   was selected for the determination of Nd isotopic composition. The
   epsilon Nd (0) values vary in a range from -13.0 to -7.78, with an
   average of -9.5, which is close to the average value of the modern upper
   Yangtze River. The result shows periodic variations in the epsilon Nd(0)
   values, characterized by an abrupt increase of the value at the base and
   upward gradual decreasing. Regional differences of the Nd isotopic
   composition of the source rocks in the Yangtze drainage basin can be
   identified which means the epsilon Nd(0) values of the upper drainage
   basin are obviously higher than the middle and lower Yangtze drainage
   basin. Nd isotopic values of the modern Yangtze drainage basin were
   collected from previous researches to better understand the patterns of
   modern erosion in the upper Yangtze Drainage Basin The Nd isotopic
   composition of the modern Yangtze River shows that the Nd budget of the
   modern upper Yangtze River is mostly dominated by the Jinsha River.},
Publisher = {INFORMATION ENGINEERING RESEARCH INST, USA},
Address = {100 CONTINENTAL DR, NEWARK, DE 19713 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Li, CA (Corresponding Author), China Univ Geosci, Faulty Earth Sci, Wuhan 430074, Peoples R China.
