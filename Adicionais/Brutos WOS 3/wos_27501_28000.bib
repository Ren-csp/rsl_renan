   Papadakis, M and Friedman, E and Szauter, K and Jacobson, E and Wallach,
   P and Loftus, T and Linger, B},
Title = {Medical students' perspectives on and responses to abuse during the
   internal medicine clerkship},
Journal = {TEACHING AND LEARNING IN MEDICINE},
