Editor = {Arezas, P and Baptista, JS and Barroso, MP and Carneiro, P and Cordeiro, P and Costa, N and Melo, R and Miguel, AS and Perestrelo, G},
Title = {Obesity influence on perceived physical overload during vertical
   handling loads - A preliminary study},
Booktitle = {SHO2016: INTERNATIONAL SYMPOSIUM ON OCCUPATIONAL SAFETY AND HYGIENE},
Year = {2016},
Pages = {46-48},
