Pages = {54-63},
Note = {10th World Congress of the World-Association-for-Dynamic-Psychiatry
   WADP/XXIIIrd International Symposium of the
   Deutsche-Akademie-fur-Psychoanalyse (DAP), ST PETERSBURG, RUSSIA, OCT
   25-29, 1994},
Organization = {World Assoc Dynam Psychiat; Deut Akad Psychoanal},
Abstract = {The author summarizes his concept of search activity as a general
   psychobiological mechanism which provides individual's development and
   discusses its theoretical and clinical implications. In the framework of
   his concept he sees psychic and psychosomatic disorders caused by a
   renunciation of search or by a misoriented search activity. As dreams,
   being a function of the right hemisphere, can restore the decreased
   search activity, a functional insufficiency of the right hemisphere
   displays a general predisposition to psychic and psychosomatic
   pathology. In his opinion, the restoration of search activity is based
   on the particular ability of the right hemisphere to produce a
   polysemantic context. The author suggests that psychoanalysis and other
   psychotherapeutic methods activate right hemisphere functions ana that
   hereby their effectiveness can be explained.},
