Author = {Bai, Xiaohui and Zhang, Xiaohong and Sun, Qun and Wang, Xinze and Zhu,
   Bin},
Title = {Effect of water source pollution on the water quality of Shanghai water
   supply system},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCE AND HEALTH PART A-TOXIC/HAZARDOUS
   SUBSTANCES \& ENVIRONMENTAL ENGINEERING},
