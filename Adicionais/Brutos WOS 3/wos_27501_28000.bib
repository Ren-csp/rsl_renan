@inproceedings{ WOS:000594372000006,
Author = {Schloss, Karen B.},
Editor = {MacDonald, LW and Biggam, CP and Paramei, GV},
Title = {A Color Inference Framework},
Booktitle = {PROGRESS IN COLOUR STUDIES: COGNITION, LANGUAGE AND BEYOND},
Year = {2018},
Pages = {107-122},
Note = {4th Progress in Colour Studies (PICS) Conference, Univ Coll London,
   London, ENGLAND, SEP 14-16, 2016},
Abstract = {As people interact with the world, they form associations between colors
   and concepts. These color-concept associations are dynamic: they
   continually update with new experiences, and they vary in relevance
   depending on contextual cues. In this chapter, I present the Color
   Inference Framework, a functional system, to describe how people form
   conceptual inferences from color information (color inferences) and how
   those inferences influence people's judgements about the world. Within
   the Color Inference Framework, I define three kinds of cognitive
   operations - pooling, transmitting, and assigning - that act on the same
   mental representation (color-concept association network) to produce
   different kinds of evaluative and interpretive judgements. I also
   discuss empirical evidence in support of the Color Inference Framework.},
