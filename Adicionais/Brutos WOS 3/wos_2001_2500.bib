Title = {Human dimensions of the urban forest in small city business settings},
Booktitle = {PROCEEDINGS OF THE SOCIETY OF AMERICAN FORESTERS, 2001 NATIONAL
   CONVENTION},
Year = {2001},
Pages = {303-309},
Note = {National Convention of the Society-of-American-Foresters, DENVER, CO,
   SEP 13-17, 2001},
Organization = {Soc Amer Foresters},
Abstract = {Small city central business districts undergoing revitalization must
   carefully weigh their choices for improvements, given limited resources.
   One option, an urban forest and streetscape program, should include
   planning for both tree and human factors. This qualitative research
   specifies the human dynamics of successful programs. Forest
   professionals assisting communities should consider civic process as
   well as arboricultural choices and practices. Planning, implementation
   and ongoing maintenance strategies often involve public and private
   partnerships. Each program contributor has different capacities for tree
   installation and care. Appropriate technical choices must be accompanied
   by personal commitment. Finally, implementation of the tree program must
   acknowledge the needs of all interests in the district.},
