@article{ WOS:A1995RM58600012,
Author = {DABBERDT, W and HOYDYSH, W and SCHORLING, M and YANG, F and HOLYNSKYJ, O},
Title = {DISPERSION MODELING AT URBAN INTERSECTIONS},
