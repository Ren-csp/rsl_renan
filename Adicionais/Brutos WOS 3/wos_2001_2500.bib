@inproceedings{ WOS:000234955700154,
Author = {Miguez, MG and Mascarenhas, FCB and Magalhaes, LPC},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Multifunctional landscapes for urban flood control in developing
   countries},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
