@article{ WOS:000444975300154,
Author = {Usman, A. S. and Abdullah, W. M. Z. Wan},
Title = {Compact City Model as an Urban Development Policy for Sub-Saharan
   Africa: The Nigerian Experience},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3765-3769},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {The objective of this study is to review the appropriateness of the
   Compact City model as an urban development policy in promoting
   sustainability in Sub-Saharan Africa (SSA) cities. The case study method
   was adopted for the research with the mixed research approach as the
   main method of data collection and analysis. This method allows in-depth
   inquiry by integrating both qualitative and quantitative forms of data.
   It provides a complete understanding of the research problem. Nigeria
   was selected for this study, primarily based on its population and
   growth potentials. Though `Compact City' model appears to deliver some
   form of sustainable dividends, the model does not envisage the problems
   of sub-Saharan cities in both its discourse and practice. The model is
   therefore considered inappropriate for cities in SSA. The study reveals
   that strategies for creating sustainable cities must be framed within
   the context of each locality and its inhabitants as planning and design
   are culturally and contextually defined and the specificities of a place
   are critical. It advocated the need for African countries to revisit
   their rich urban past to re-examine its traditional urban forms if the
   ideals of sustainability are to be attained.},
