@article{ WOS:000431770900183,
Author = {Faridah, Imaniar Noor and Masyithah, Nurul and Perwitasari, Dyah Aryani},
Title = {Perception, HbA1c and the Quality of Life of Diabetes Mellitus (T2DM)
   Patients at RSUD Abdul Azis Singkawang},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {12},
Pages = {12464-12468},
Month = {DEC},
Note = {1st International Joint Conference on Science and Technology (IJCST),
   Bali, INDONESIA, OCT 12-13, 2016},
Organization = {Univ Pembangunan Nas Veteran Jawa Timur, Fac Ind Technol; Bali State
   Polytechn; Natl Cheng Kung Univ; Univ Negeri Surabaya, Fac Social Sci \&
   Law; Univ Negeri Surabaya, Fac Math \& Nat Sci; Univ Trunojoyo Madura,
   Fac Engn},
Abstract = {Diabetes mellitus type 2 (T2DM) is a chronic metabolic disorder which
   requires optimum therapy and is influenced by several factors, one of
   which is the perception of patients towards their disease. Such
   perception affects patients' line of thought and impacts on their
   clinical outcome, including their HbA1c and quality of life. This
   research purports to identify the correlation between perception of
   patients concerning their malady and their clinical outcome in terms of
   HbA1c and quality of life. The study was conducted at the Local Public
   Hospital (RSUD) Abdul Azis Singkawang, West Kalimantan, Indonesia.
   Subjects meeting the inclusion criteria were patients diagnosed with
   T2DM, aged more than 18, and undergoing outpatient care at the hospital
   within the period of January March 2017. The questionnaires applied in
   the survey were the Brief Illness Perception Questionnaire (B-IPQ) and
   the European Quality of Life-5 Dimensions (EQ-5D) questionnaire, both
   translated to Indonesian. Statistical analysis for this study employed
   an ANOVA test with linear regression. As many as 86 patients fulfilled
   the inclusion criteria for this inquiry, and showed that the average
   level of patients' HbA1c was 9.50 +/- 2.62, that patients had favorable
   perceptions over treatment control, and that the resulting EQ-5D index
   on average was 0.76. It was further found that there was a significant
   relationship between patients' perception and HbA1c level as well as
   between their perception and quality of life (p < 0.05), leading to the
   conclusion that patients' perception of their illness indeed correlates
   with their HbA1c level and quality of life.},
