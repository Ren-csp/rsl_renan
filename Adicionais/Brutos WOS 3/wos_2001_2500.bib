@inproceedings{ WOS:000285525200016,
Author = {Wang, X. C. and Chen, R.},
Editor = {Hao, XD and Novotny, V and Nelson, V},
Title = {Water Metabolism Concept and its Application in Designing Decentralized
   Urban Water Systems with Wastewater Recycling and Reuse},
Booktitle = {WATER INFRASTRUCTURE FOR SUSTAINABLE COMMUNITIES: CHINA AND THE WORLD},
Series = {Cities of the Future Series},
