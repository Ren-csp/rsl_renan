Title = {Eye movement and visual illusion perception in chronic schizophrenia},
Booktitle = {PROCEEDINGS OF 2010 INTERNATIONAL CONFERENCE ON BEHAVIORAL, COGNITIVE
   AND PSYCHOLOGICAL SCIENCES},
Year = {2010},
Pages = {133-137},
Note = {2010 International Conference on Behavioral, Cognitive and Psychological
   Sciences, Singapore, SINGAPORE, FEB 26-28, 2010},
Abstract = {Numerous studies have examined the relationship between smooth pursuit
   eye movements and motion perception. In this study, it was testified
   that the abnormality of smooth pursuit eye movements in the chronic
   schizophrenic patients was associated with the positive syndrome and was
   related to the negative syndrome by using the illusory motion stimuli.
   The visual perceptual accuracy about the illusory motion stimuli was
   lower in the patient groups with chronic schizophrenic than in the
   normal control group. These results imply that schizophrenics have
   deficits in smooth pursuit eye movement and these deficits causes the
   differences of motion perception between schizophrenics and normal
   adults.},
