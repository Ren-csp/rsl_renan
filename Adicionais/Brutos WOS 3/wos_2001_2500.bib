@article{ WOS:000244805300002,
Author = {Boehner, Kirsten and DePaula, Rogerio and Dourish, Paul and Sengers,
   Phoebe},
Title = {How emotion is made and measured},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER STUDIES},
Year = {2007},
Volume = {65},
Number = {4},
Pages = {275-291},
Month = {APR},
Note = {Conference on Human Factors in Computing Systems (CHI 2005)Workshop on
   Evaluating Affective Interfaces, Portland, ORPortland, OR, 2005APR 04,
   2005},
Organization = {CHI},
Abstract = {How we design and evaluate for emotions depends crucially on what we
   take emotions to be. In affective computing, affect is often taken to be
   another kind of information-discrete units or states internal to ail
   individual that can be transmitted in a loss-free manner from people to
   computational systems and back. While affective computing explicitly
   challenges the primacy of rationality in cognitivist accounts of human
   activity, at a deeper level it often relies on and reproduces the same
   information-processing model of cognition. Drawing on cultural, social,
   and interactional critiques of cognition which have arisen in
   human-computer interaction (HCI), as well as anthropological and
   historical accounts of emotion, we explore an alternative perspective on
   emotion as interaction: dynamic, culturally mediated, and socially
   constructed and experienced. We demonstrate how this model leads to new
   goals for affective systems-instead of sensing and transmitting emotion,
   systems should support human users in understanding, interpreting, and
   experiencing emotion in its full complexity and ambiguity. In developing
   from emotion as objective, externally measurable unit to emotion as
   experience, evaluation, too, alters focus from externally tracking the
   circulation of emotional information to co-interpreting emotions as they
   are made in interaction. (c) 2006 Elsevier Ltd. All rights reserved.},
