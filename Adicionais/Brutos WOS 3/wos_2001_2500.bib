@inproceedings{ WOS:000326475400018,
Author = {Dordevic, D. and Stortini, A. M. and Relic, D. and Mihajlidi-Zelic, A.
   and Huremovic, J. and Gambaro, A.},
Editor = {Pirrone, N},
Title = {Size-segregated concentration of heavy metals in an urban aerosol of the
   Balkans region (Belgrade)},
Booktitle = {PROCEEDINGS OF THE 16TH INTERNATIONAL CONFERENCE ON HEAVY METALS IN THE
   ENVIRONMENT},
Series = {E3S Web of Conferences},
Year = {2013},
Volume = {1},
Note = {16th International Conference on Heavy Metals in the Environment
   (ICHMET), Rome, ITALY, SEP 23-27, 2012},
Abstract = {This work focuses on the heavy metals contents of the size-segregated
   urban aerosol of the continental area of Balkans. The distribution of
   nano/micron heavy metals in the size-segregated urban aerosol of
   Belgrade center was studied during the summer-autumn of 2008. The
   particle size distribution in the size ranges D-p <= 0.49 mu m, 0.49 <=
   D-p <= 0.95 mu m, 0.95 <= D-p <= 1.5 mu m, 1.5 <= D-p <= 3.0 mu m, 3.0
   <= D-p <= 7.2 mu m and D-p <= 7.2 mu m was measured. The aerosol samples
   were submitted to gravimetric and chemical analyses. The obtained mean
   mass concentration of the PM fractions was in accordance with an urban
   aerosol distribution. The aerosol mass concentrations were determined by
   gravimetric measurements (m(GM)) and, for heavy metals analyzed by
   ICP/MS.},
Publisher = {E D P SCIENCES},
Address = {17 AVE DU HOGGAR PARC D ACTIVITES COUTABOEUF BP 112, F-91944 CEDEX A,
