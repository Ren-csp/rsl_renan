Title = {Are Negative Emotions Signals for Changing the Self or/and Symptoms to
   be Treated? A Case Example Illustrating a Dialogical Stage Model for
   Emotional Change},
Booktitle = {PLURALISM IN PSYCHIATRY, VOL II: MULTIDIMENSIONAL CONSIDERATIONS},
Year = {2015},
Pages = {107-110},
Note = {WPA Thematic Conference of Intersectional Collaboration / 5th European
   Congress of the INA / 2nd Interdisciplinary Congress of the HSAPRS,
   Hellen Soc Advancement Psychiat \& Related Sci, Athens, GREECE, OCT
   30-NOV 02, 2014},
Organization = {World Psychiat Assoc; Int Neuropsychiatr Assoc},
Abstract = {Introduction: Hermans \& Hermans - Konopka(1) propose a seven stage
   model for a dialogical change of emotions, which can be helpful to cope
   with the echoes of a negative emotion.
   Clinical case: Dimitra is a 27 year old woman reporting extreme anxiety
   regarding her occupational duties.
   Description: Dimitra is invited to describe her anxiety and externalize
   it. It is no longer anxiety but grief. Then she moves to a counter
   emotion, and then move to a dialogue between these two emotions. In a
   next session she was invited to make a composition of emotions and
   positions. Finally, she developed a ``promoter position{''} in the
   context of emotions.
   Discussion: Dimitra brought together a broader range of emotions to be
   available for emotion work. Dialogical relationships between them
   enabled her to articulate different I-positions and different
   perspectives.
   Conclusion: This process provided Dimitra the opportunity to transform
   monological emotions into dialogical ones towards an internal polyphony
   determined by variety and order that provides her with new meanings
   leading to future perspectives.},
