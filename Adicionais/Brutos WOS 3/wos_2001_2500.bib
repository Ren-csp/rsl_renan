@inproceedings{ WOS:000230620300060,
Author = {Abdollahi, KK and Ning, ZH and Stubblefield, M},
Editor = {Tiezzi, E and Brebbia, CA and Jorgensen, SE and Gomar, DA},
Title = {Urban forest ecosystem structure and the function of the gulf coastal
   communities in the United States},
