@article{ WOS:000358063700005,
Author = {Franck-Neel, Catherine and Borst, Wolfgang and Diome, Camille and
   Branchu, Philippe},
Title = {Mapping the land use history for protection of soils in urban planning:
   what reliable scales in time and space?},
Journal = {JOURNAL OF SOILS AND SEDIMENTS},
Year = {2015},
Volume = {15},
Number = {8},
Pages = {1687-1704},
Month = {AUG},
Note = {7th Conference on Soils of Urban, Industrial, Traffic, Mining and
   Military Areas (SUITMA), Torun, POLAND, SEP, 2013},
Organization = {Nicolaus Copernicus Univ, Dept Soil Sci \& Landscape Management; Polish
   Soil Sci Soc},
Abstract = {Mainstreaming land use history into urban maps is of interest for many
   applications. In this study, it was seen as a way for introducing soil
   quality information in urban planning. The quality of urban soils is
   indeed assumed to be driven not only by the current land cover but also
   by the land use history. The purpose is to investigate this assumption
   by proposing two mapping processes of the land use history.
   Two geographic information system (GIS) processes integrating the
   temporal dimension have been implemented in the site of the plateau of
   Malassis-Montreuil (northeast of Paris, France). They correspond to two
   scale levels: strategic (1:25,000) and detailed level (1:2,500), and
   both use the map made under Napoleon III (1800) as the initial point of
   urbanization. The concept of soil quality was limited to the
   urbanization-induced disturbance of the soil (either physical or
   chemical). The translation of maps of land use trajectory into maps of
   soil disturbance was made by ranking rules based on accurate analysis of
   available historical documents. The consistency of the produced maps was
   made by detailed analysis of five well-documented districts of distinct
   land use trajectory.
   At both scales, the produced maps of land use trajectory allowed to
   distinguish highly disturbed soils from potentially undisturbed areas.
   The plot scale was shown to be an ideal scale for project development
   purposes. However, the mapping process remains difficult to implement
   and carries of too many sources of errors to be generalized throughout
   the city. The approach proposed at the city scale was more robust, was
   less subjective, and allowed to integrate cumulative effects by steps of
   30 years over a 200-year period. It produced maps of chemical and
   physical disturbance which could be useful for planning and management
   purposes. Whatever the scale, both mapping process provided synthetic
   information more pertinent for soil conservation purposes than maps of
   the current land cover.
   Resulting maps of level of soil disturbance are easily usable by
   decision makers. Still, integration of the temporal dimension into urban
   maps remains a great challenge that mainly depends on the availability
   of spatially explicit data over the duration of history of the city. As
   major urban transformations are non-linear in time, the critical point
   is the identification of key dates in the city development history.},
