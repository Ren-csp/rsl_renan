@inproceedings{ WOS:000432197700035,
Author = {Torres-Valencia, C. and Alvarez-Meza, A. and Orozco-Gutierrez, A.},
Editor = {Vicente, JMF and Sanchez, JRA and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Emotion Assessment Based on Functional Connectivity Variability and
   Relevance Analysis},
