Title = {Music Therapy-Driven Mood-Based Music Recommendation System Integrating
   User Emotion, Song Lyrics, and Health Reflections},
Booktitle = {2025 AI-DRIVEN SMART HEALTHCARE FOR SOCIETY 5.0},
Year = {2025},
Pages = {19-24},
Note = {2025 International Conference on AI-Driven Smart Healthcare for Society
   5.0, Kolkata, INDIA, FEB 14-15, 2025},
Abstract = {The rapid development of digital media has enabled users to access a
   colossal choice of music through the internet and electronic devices.
   Music recommendations are given mostly based on the user's past
   listening history and artist preferences. While this approach is
   effective to some extent, it overlooks the importance of the user's
   current mood which is governed by circumstantial as well as health
   conditions. Music therapy recently is a topic of major interest. This
   work aims to bridge the gap between music and emotions which is a
   reflection of health condition and mental state, in music recommendation
   systems and enhance how people connect with music. The proposed
   mood-based music recommendation system uses sentiment analysis to assess
   song lyrics, an interactive chatbot to determine user emotions, and a
   Random Forest model to categorize song moods based on audio
   characteristics. Recommendations for music are specifically designed to
   offer therapeutic advantages, such as stress relief, improved
   relaxation, or catharsis. The proposed system makes dynamic song
   recommendations based on the changing emotions of the user, thereby
   aiding in better absorbance of music. Experimental results demonstrate
   the system's high accuracy and potential for improving mental
   well-being, making it a valuable addition to music streaming platforms
   and mental health applications.},
