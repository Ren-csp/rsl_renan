@inproceedings{ WOS:000249647600007,
Author = {Clifford, N. J.},
Editor = {Fang, HHP and Lee, JHW},
Title = {River restoration: Paradigms, paradoxes and the urban dimension},
Booktitle = {SUSTAINABLE AND SAFE WATER SUPPLIES},
