Organization = {Int Ergon Assoc; Ergon Soc S Africa},
Abstract = {A set of forty-four hospital information symbols were used as the
   stimulus materials, and eight hundred subjects, including doctors,
   nurses, patients, and college students, participated in this study.
   After a matching test, the confusion matrix was used as the input data
   for MDS analysis. The results showed that the three dimensions in
   constituting perception space were ``connotative factor{''},
   ``denotative factor{''}, and ``context factor{''}. These three main
   factors were also used to identify the confusion in the set of hospital
   symbols. The results provide designers with an idea of how to
   concentrate their efforts on designing graphic symbols. The MDS seems to
   be a promising technique of understanding the user perception of graphic
   symbols, and is clearly worthy of more in-depth study.},
