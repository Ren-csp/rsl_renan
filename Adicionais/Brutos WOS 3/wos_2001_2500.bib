Organization = {IEEE Power \& Energy Soc; World Energy Council, Comitetul Natl Roman;
   Honeywell; Elster; Continental; Engie; Opt SWD},
Abstract = {In the last four decades, our planet is in the impossibility to
   replenish what humanity demands from nature. According to latest
   studies, in order to provide the natural resources and ecological
   services currently in use, would be needed the regenerative capacity of
   1.8 Earths. This situation is only in the short term: just a small
   amount of time we can use/extract natural resources at a higher rate
   than regeneration rate. The aim of this paper is to assess the EFP for
   Romania, hence, to establish the progress towards or away from
   sustainability. So, this work has four main objectives: - to calculate
   the total EFP of Romania; to calculate the EFP per-capita of the
   Romanian population; to give a comparison to the European average and to
   provide a comparison between rural and urban area EFP in Romania.},
