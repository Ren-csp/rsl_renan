@article{ WOS:000244805300011,
Author = {Isomursu, Minna and Tahti, Marika and Vainamo, Soili and Kuutti, Kari},
Title = {Experimental evaluation of five methods for collecting emotions in field
   settings with mobile applications},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER STUDIES},
Year = {2007},
Volume = {65},
Number = {4},
Pages = {404-418},
Month = {APR},
Note = {Conference on Human Factors in Computing Systems (CHI 2005)Workshop on
   Evaluating Affective Interfaces, Portland, ORPortland, OR, 2005APR 04,
   2005},
Organization = {CHI},
Abstract = {This paper presents experiences on using five different self-report
   methods, two adopted from literature and three self-created, for
   collecting information about emotional responses to mobile applications.
   These methods were used in nine separate field experiments done in
   naturalistic settings. Based on our experiments, we can argue that all
   of these methods can be successfully used for collecting emotional
   responses to evaluate mobile applications in mobile settings. However,
   differences can be identified in the suitability of the methods for
   different research setups. Even though the self-report instruments
   provide a feasible alternative for evaluating emotions evoked by mobile
   applications, several challenges were identified, for example, in
   capturing the dynamic nature of mobile interaction usage situations and
   contexts. To summarise our results, we propose a framework for selecting
   and comparing these methods for different usage purposes. (c) 2006
   Elsevier Ltd. All rights reserved.},
