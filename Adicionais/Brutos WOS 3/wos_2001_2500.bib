@inproceedings{ WOS:000243257200021,
Author = {Frey, Corinne M. and Rigo, Gergely and Parlow, Eberhard},
Editor = {Marcal, A},
Title = {The cooling effect of cities in a hot and dry environment},
Booktitle = {GLOBAL DEVELOPMENTS IN ENVIRONMENTAL EARTH OBSERVATION FROM SPACE},
Year = {2006},
Pages = {169+},
Note = {25th Symposium of the
   European-Association-of-Remote-Sensing-Laboratories (EARSeL), Univ
   Porto, Oporto, PORTUGAL, JUN 06-11, 2005},
Abstract = {Four ASTER satellite scenes of an urban area in a hot and dry
   environment with channels from the very near infrared to the thermal
   infrared were analysed, regarding the variations of surface temperature,
   albedo, emissivity and net radiation. With help of a land use
   classification different urban and rural areas were spatially and
   temporally compared. The investigations show a distinct daily surface
   cool island for Dubai and daily surface cooling areas of Abu Dhabi city
   and its surrounding mangrove areas. The net radiation is highly
   controlled by the albedo. Therefore the net radiation is higher in the
   investigated urban areas than in the non-urban surroundings. The surface
   temperatures behave contrary to the net radiation. They are mostly
   correlated with the availability of water. Regressions between the
   surface temperatures and the land use classes, as well as the NDVI and a
   distance to the sea layer showed maximal correlations of 0.58 for Dubai
   and 0.78 for Abu Dhabi.},
