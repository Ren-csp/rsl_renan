@article{ WOS:000261017400003,
Author = {Rashed, Tarek},
Title = {Remote sensing of within-class change in urban neighborhood structures},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2008},
Volume = {32},
Number = {5},
Pages = {343-354},
