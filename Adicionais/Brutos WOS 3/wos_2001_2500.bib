@inproceedings{ WOS:000471100200088,
Author = {Sudirman and Trisutomo, S. and Barkey, R. A. and Ali, M. and Imura, H.
   and Onishi, A. and Tsai, P. and Yonezaki, K.},
Book-Group-Author = {IOP},
Title = {System of urban flood control: A Comparative Study between Kanagawa
   Prefecture and Makassar City},
Booktitle = {1ST INTERNATIONAL CONFERENCE ON GLOBAL ISSUE FOR INFRASTRUCTURE,
   ENVIRONMENT \& SOCIO-ECONOMIC DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
