@inproceedings{ WOS:000377631900015,
Author = {Chan, C. H. and Leung, M. T.},
Editor = {Montague, JM and Tan, LM},
Title = {The structural relationship of perceived academic support and
   self-regulated learning: The mediating role of achievement emotions and
   academic motivation},
Booktitle = {APPLIED PSYCHOLOGY},
Year = {2016},
Pages = {268-290},
Note = {Asian Congress of Applied Psychology (ACAP), Singapore, SINGAPORE, MAY
   19-20, 2015},
Organization = {Univ Derby, Asias Leading Grad Sch, Aventis Sch Management; Singapore
   Univ Technol \& Design},
Abstract = {The research finds that there is a significant structural relationship
   between perceived academic support, achievement emotions, academic
   motivation and self-regulated learning of Hong Kong undergraduate. 211
   participants are sampled including 80 males and 131 females. The
   structural equation model shows that both perceived academic support
   from parent, teacher and friend are significantly related to positive
   achievement emotions, whereas positive achievement emotions are
   significantly related to self-regulated learning. Also, both perceived
   academic supports are significantly related to the self-regulated
   learning with the mediator of academic motivation in path model. This
   helps educators to understand the influence of perceived academic
