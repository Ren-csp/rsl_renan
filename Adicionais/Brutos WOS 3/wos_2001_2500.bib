@inproceedings{ WOS:000383740302046,
Author = {Chou, Wei-Ying and Waszynski, Christine and Kessler, Jeanne and
   Clarkson, P. John},
Editor = {Ahram, T and Karwowski, W and Schmorrow, D},
Title = {Exploring the feasibility of using affective pictures to elicit positive
   emotion with nursing home residents with dementia},
Booktitle = {6TH INTERNATIONAL CONFERENCE ON APPLIED HUMAN FACTORS AND ERGONOMICS
   (AHFE 2015) AND THE AFFILIATED CONFERENCES, AHFE 2015},
Series = {Procedia Manufacturing},
