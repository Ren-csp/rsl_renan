@inproceedings{ WOS:000179249200080,
Author = {Poblet, MC},
Editor = {Brebbia, CA and MartinDuque, JF and Wadhwa, LC},
Title = {The role of parking policy in the long process to sustainable mobility},
Booktitle = {SUSTAINABLE CITY II: URBAN REGENERATION AND SUSTAINABILITY},
Series = {ADVANCES IN ARCHITECTURE SERIES},
Year = {2002},
Volume = {14},
Pages = {827-831},
Note = {2nd International Conference on the Sustainable City, SEGOVIA, SPAIN,
   2002},
Abstract = {mobility. The generalised use of car, in the last 40 years, has become
   an essential right. This argument implies the consideration of two basic
   principles in order to implement an efficient and sustainable transport
   policy. First of all, to avoid, in a previous period of time, some kind
   of instrument such as congestion fees. Secondly, to develop new
   transport policy making based in consensus between local authorities and
   other local players. In this framework, parking strategies have some
   economic and social advantages, respect other transport strategies.
   Parking policies are more economical and consider the different needs of
   different drivers. Some of the parking strategies are: to promote park
   and ride facilities, to move on street residential parking car to
   underground facilities and to restructure the pricing parking. These
   instruments are compatible with the strategies proposed on the White
   Paper of Transport of the European Commission. Moreover, parking
   strategies are not as expensive as investing in public transport
   infrastructures and they are absolutely compatibles with public
   transport strategies. Finally, apart from parking instruments, other
   kind of strategies should be applied. First of all, ``Trip Reduction
   Ordinances{''} tries to take into account interactions between land use
   and transport in order to reduce the need for using private transport.
   Finally, the development of clean technologies in cars and public
