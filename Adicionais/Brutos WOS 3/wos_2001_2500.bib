   Sheng, Ni, Macau Univ Sci \& Technol, Fac Management \& Adm, Taipa, Macau, Peoples R China.
   Tang, U. Wa, Univ Macau, Dept Civil \& Environm Engn, Taipa, Macau, Peoples R China.},
DOI = {10.3390/ijerph8061977},
ISSN = {1660-4601},
Keywords = {urban form; traffic volume; traffic noise; GIS},
