@article{ WOS:000234980000006,
Author = {Roter, DL and Frankel, RM and Hall, JA and Sluyter, D},
Title = {The expression of emotion through nonverbal behavior in medical visits -
   Mechanisms and outcomes},
Journal = {JOURNAL OF GENERAL INTERNAL MEDICINE},
Year = {2006},
Volume = {21},
Number = {1},
Pages = {S28-S34},
Month = {JAN},
Note = {9th Biannual Regenstreif Conference, Marshall, IN, SEP 29-OCT 01, 2004},
Organization = {Regenstreif Inst Inc; Regenstreif Fdn; Feitzer Inst},
Abstract = {Relationship-centered care reflects both knowing and feeling: the
   knowledge that physician and patient bring from their respective domains
   of expertise, and the physician's and patient's experience, expression,
   and perception of emotions during the medical encounter. These processes
   are conveyed and reciprocated in the care process through verbal and
   nonverbal communication. We suggest that the emotional context of care
   is especially related to nonverbal communication and that
   emotion-related communication skills, including sending and receiving
   nonverbal messages and emotional self-awareness, are critical elements
   of high-quality care. Although nonverbal behavior has received far less
   study than other care processes, the current review argues that it holds
   significance for the therapeutic relationship and influences important
   outcomes including satisfaction, adherence, and clinical outcomes of
   care.},
