Title = {Olfactory and Haptic Crossmodal Perception in a Visual Recognition Task},
Booktitle = {QUANTIFYING AND PROCESSING BIOMEDICAL AND BEHAVIORAL SIGNALS},
Series = {Smart Innovation Systems and Technologies},
Year = {2019},
Volume = {103},
Pages = {57-71},
