Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {Air quality management represents a multi-disciplinary balance of
   research and development; and assessments of trends and impacts on
   various effects sectors. While the effects sectors are evaluated in
   terms of assessments and integrated models, research and development
   focusses on activities directed towards improved accuracy and
   performance of models and assessment techniques. Due to the costs of
   emissions reductions, a key responsibility df air quality managers is to
   design, construct, and/or assess policy support tools which are able to
   make economic evaluations of both current air quality levels and
   improved air quality in all national sectors. For rural regions,
   cost-benefit analyses may place a higher emphasis on damage functions
   associated with agriculture and forests, and for the urban canopy the
   emphasis shifts towards human health. This paper will deal with the
   latter.},
