@inproceedings{ WOS:000288208700006,
Author = {Keeffe, Dominique A. and Russell-Bennett, Rebekah and Tombs, Alastair},
Editor = {Hartel, CEJ and Ashkanasy, NM and Zerbe, WJ},
Title = {THE INTENTIONAL USE OF SERVICE RECOVERY STRATEGIES TO INFLUENCE CONSUMER
   EMOTION, COGNITION AND BEHAVIOR},
Booktitle = {FUNCTIONALITY, INTENTIONALITY AND MORALITY},
Series = {Research on Emotion in Organizations},
Year = {2007},
Volume = {3},
Pages = {141-175},
Note = {5th International Conference on Emotions and Worklife (Emonet V),
   Atlanta, GA, AUG 10-12, 2006},
Abstract = {Service recovery strategies have been identified as a critical factor in
   the success of service organizations. This study develops a conceptual
   framework to investigate how specific service recovery strategies
   influence the emotional, cognitive and negative behavioral responses of
   consumers, as well as how emotion and cognition influence negative
   behavior. Understanding the impact of specific service recovery
   strategies will allow service providers to more deliberately and
   intentionally engage in strategies that result in positive
   organizational outcomes. This study was conducted using a 2 x 2
   between-subjects quasi-experimental design. The results suggest that
   service recovery has a significant impact on emotion, cognition and
   negative behavior. Similarly, satisfaction, negative emotion and
   positive emotion all influence negative behavior but distributive
   justice has no effect.},
