@inproceedings{ WOS:000287160900390,
Author = {Kharrazi, Alinaghi and Kareshki, Hossein},
Editor = {Hacifazlioglu, O and Halat, MM},
Title = {Environmental perceptions, motivational beliefs and self-regulating
   learning by Iranian high school students},
