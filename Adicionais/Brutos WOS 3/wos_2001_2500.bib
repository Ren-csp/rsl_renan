@inproceedings{ WOS:000177207900009,
Author = {Eiswirth, M},
Editor = {Howard, KWF and Israfilov, RG},
Title = {Hydrogeological factors for sustainable urban water systems},
Booktitle = {CURRENT PROBLEMS OF HYDROGEOLOGY IN URBAN AREAS, URBAN AGGLOMERATES AND
   INDUSTRIAL CENTRES},
