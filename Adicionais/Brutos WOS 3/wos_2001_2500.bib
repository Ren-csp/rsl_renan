@article{ WOS:000350331300022,
Author = {Liu, Chen and Wang, Qinxue and Zou, Chunjing and Hayashi, Yoshitsugu and
   Yasunari, Tetsuzo},
Title = {Recent trends in nitrogen flows with urbanization in the Shanghai
   megacity and the effects on the water environment},
Journal = {ENVIRONMENTAL SCIENCE AND POLLUTION RESEARCH},
Year = {2015},
Volume = {22},
Number = {5},
Pages = {3431-3440},
Month = {MAR},
Note = {2nd International Conference on Water, Energy, and Environment (ICWEE),
   Kusadasi, TURKEY, SEP 21-24, 2013},
Organization = {Izmir Katip Celebi Univ; Amer Univ Sharjah; United Arab Emirates Univ},
Abstract = {The objectives of this study are to diagnose and prevent environmental
   problems that threaten urban sustainability, the impact of changes in
   lifestyle (diet, domestic sanitation, and motorization), and production
   style (agriculture, industry, and services) with the rapid urbanization
   on regional nitrogen (N) flows, and the water environment was
   quantitatively evaluated. The megacity Shanghai was chosen as a case
   study to investigate the temporal changes in nitrogen flow during
   1980-2008 by a multidisciplinary approach (a field survey, a regional
   nitrogen mass balance model, input-output analysis, etc.). Although the
   total potential nitrogen load in Shanghai has decreased in the 2000s and
   water pollution problems seem to have improved, the problem has shifted
   and expanded to affect a wider area through the food/product chain and
   water/air movement. Further effective solutions that aim at material
   cycles are necessary and have to be implemented on a large scale.},
Publisher = {SPRINGER HEIDELBERG},
Address = {TIERGARTENSTRASSE 17, D-69121 HEIDELBERG, GERMANY},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Liu, C (Corresponding Author), Inst Global Environm Strategies, 2108-11 Kamiyamaguchi, Hayama, Kanagawa 2400115, Japan.
   Liu, Chen, Inst Global Environm Strategies, Hayama, Kanagawa 2400115, Japan.
