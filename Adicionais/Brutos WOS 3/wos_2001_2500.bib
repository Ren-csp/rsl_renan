@inproceedings{ WOS:000346067900365,
Author = {Pantera, A. and Papadopoulos, A. and Pantera, M. and Papaspyropoulos, K.
   G.},
Editor = {Lekkas, TD},
Title = {SOCIOECONOMIC DIMENSION OF OAK FORESTS: UNDERSTANDING LOCAL PEOPLE
   PERCEPTIONS WITH EMPHASIS ON CHILDREN},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Valonia (Q. ithaburensis subs. macrolepis) is a characteristic endemic
   oak species of Greece and the Eastern Mediterranean countries, forming
   traditional silvopastoral ecosystems of great value in the past. Valonia
   oak was used in the past for its wood, acorns as well as for tannery.
   The use of cheap, chemical dyes has eliminated the most important use of
   its acorns in tannery and confined it to their nutritive value. Compared
   to the past, the species has currently ecological rather than economic
   importance and is mainly used for grazing, especially by sheep. Nowadays
   farmers are switching valonia oak silvopastoral systems to olive groves
   and/or agricultural fields. During the past decades there is a growing
   apostrophe on these traditional uses, mainly by young people, preferring
   other occupational fields or moving to bigger cities, mainly Athens.
   However, there is a growing interest for these ecosystems in the past
   few years due to environmental awareness and increased demand for
   traditional products. Additionally, there has been a growing interest
   for the species to be included in reforestation as well as research
   projects.
   It is of great interest to assess the relationship between the ecosystem
   and the local population. The economic contribution of valonia oak
   silvopastoral systems on the local population was assessed in this
   research with emphasis on the target group directly affecting and be
   affected by it, namely the local inhabitants, separately to children and
   adults. Special questionnaires were prepared and distributed, based on
   proper scientific sampling, and were distributed to elementary and high
   school children. Generally, the use of questionnaires is considered as
   an appropriate method in assessing the behavior of citizens towards
   natural resources in socio-economic surveys. All statistical analysis of
   the data were performed by the statistical package SPSS, using
   descriptive methods and applied statistics. A similar study was
   conducted for the Prefecture of Evritania where the diachronic change of
   farmers was assessed.
   The results from the present research, under the framework of
   sustainable development and environmental protection, will help the
   management and protection of the remaining valonia oak silvopastoral
   systems, being presently at risk of extinction from afforestation, land
   clearing, illegal logging, overgrazing and forest fires. These systems
   are not only a part of the local economy and environment but also a part
   of Greek history and tradition.},
