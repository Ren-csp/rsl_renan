@inproceedings{ WOS:001753451400022,
Author = {Acri, Marco and Moniz, Goncalo Canto},
Editor = {Mohammad, P and Shahfahad and Matamanda, AR and Rodrigo-Comino, J},
Title = {The Adoption of the URBiNAT Methodology for the Co-creation of a NBS
   Park in Nova Gorica and Porto},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 2},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
Pages = {301-314},
Note = {2024 International Conference on Geographic Perspectives on Climate
   Change Mitigation in Urban and Rural Environments-GCUE, Lecce, ITALY,
   JUN 25-27, 2024},
Organization = {University of Salento},
Abstract = {The Horizon 2020 project named URBiNAT, (The URBiNAT project has
   received funding from the European Union's Horizon 2020 research and
   innovation programme under grant agreement No 776783-www.urbinat.eu)
   Healthy Corridors as Drivers of Social Housing Neighbourhoods for the
   Co-creation of Social, Environmental, and Marketable NBS, has targeted
   the regeneration of social housing districts by combining nature-based
   solutions, NBS, through a distinctly participatory approach. The
   project, focussing on the way to recreate places in urban alienated
   areas, integrated the traditional NBS with socio-economic and solidarity
   economy practices, recalling the ancient need of humans to gather in
   groups and construct social bonds to better defend against wilderness
   and danger. The generation of urban corridors, not merely green but
   healthy, to connect social housing neighbourhoods to other more central
   or wealthy urban areas relies on the idea that corridors are not solely
   shortcuts but also places of proximity, integrating nature, culture,
   education, and sport, where social bonds can be generated and eventually
   nourished. The project included eight cities from Europe and Iran, which
   developed different concepts of healthy corridors based on their
   specificities, objectives, and participatory dynamics. This paper will
   dive into two case studies: the pilot city of Porto, which was acting as
   frontrunner in the project by co-creating a new park in the Campanha
   neighbourhood, and the city of Nova Gorica, which acted as follower city
   and co-developed with locals a NBS park to partly reconnect with the
   Italian city of Gorizia at the margin of the famous border. Both cities
   resulted in providing regenerated areas where resilience is expressed
   both by means of enhanced natural resources and biodiversity, and in
   terms of social cohesion and sharing, demonstrating how citizen
   participation may lead to the transformation of spaces into places.},
Publisher = {SPRINGER INTERNATIONAL PUBLISHING AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
Type = {Proceedings Paper},
