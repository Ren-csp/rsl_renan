Organization = {Charter Inst Water \& Environm Managment},
Abstract = {Experience and knowledge of river-restoration schemes are generally
   available at the reach scale. However, there are problems with the
   application of this knowledge at the scale of large urbanised catchments
   which relate to understanding the system and predicting the impact of
   management strategies. This paper considers problems of developing a
   perceptive and efficient rehabilitation strategy for a large urbanised
   catchment, with specific reference to the River Tame in the West
   Midlands. Consideration is given to (a) rainfall-runoff relationships,
   (b) assessment of water quality and ecological status, and (c)
   predicting the impact of various management strategies.},
