@article{ WOS:000242620000010,
Author = {Repetti, Alexandre and Soutter, Marc and Musy, Andre},
Title = {Introducing SMURF: A software system for monitoring urban
   functionalities},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2006},
Volume = {30},
Number = {5},
Pages = {686-707},
