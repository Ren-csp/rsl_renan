Title = {Adversity Quotient and perception to adversity in differentiating
   entrepreneurial survival},
Booktitle = {PROCEEDINGS OF THE 8TH INTERNATIONAL CONFERENCE OF ASIAN ASSOCIATION OF
   INDIGENOUS AND CULTURAL PSYCHOLOGY (ICAAIP 2017)},
Series = {Advances in Social Science Education and Humanities Research},
