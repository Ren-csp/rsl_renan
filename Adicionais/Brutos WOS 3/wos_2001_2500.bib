Note = {International Conference on Energy, Power, Environment and Computer
   Application (ICEPECA), Wuhan, PEOPLES R CHINA, JAN 20-21, 2019},
Organization = {Adv Sci \& Ind Res Ctr},
Abstract = {In this paper, the effects of built environments on the use of sharing
   bikes were investigated, based on the weekend and weekend data of
   sharing bikes at street level in Shenzhen, China. The explanatory
