Title = {Wellbeing as the Social Component in the Development of Urban Areas},
Booktitle = {INTERNATIONAL CONFERENCE OF COMPUTATIONAL METHODS IN SCIENCES AND
   ENGINEERING 2018 (ICCMSE-2018)},
Series = {AIP Conference Proceedings},
Year = {2018},
Volume = {2040},
Note = {International Conference of Computational Methods in Sciences and
   Engineering (ICCMSE), Thessaloniki, GREECE, MAR 14-18, 2018},
Organization = {European Soc Computat Methods Sci \& Engn},
Abstract = {People are the crucial element of cities. They can be only passive
   recipients of any urban projects or assets able to multiply the results
   of investments made by authorities. It depends on whether or not their
   inhabitants form social networks and neighborhood ties mobilizing them
   to collective actions for a common good. In small settlements
   communities form by itself over time, in big urban areas people tend to
   value anonymity, and they choose a passive attitude towards the place
   they live in. The role of a city is to develop a living environment in
   which people can fulfill themselves as social units and have an
   opportunity to have successful relations with others.},
