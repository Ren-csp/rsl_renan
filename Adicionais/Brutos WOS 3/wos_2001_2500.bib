@inproceedings{ WOS:000179444800145,
Author = {Lekule, CT},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Lessons of an urban space in Keko Magurumbasi. Resident's home essence
   of urban space in the informal settlements of Dar es Salaam},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1181-1189},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The paper is based on the present quest for understanding spatial values
   through academic research. It dwells on the methods of decoding urban
   space values from the residents' point of view. People's conceptions
   through their everyday life may indicate the values they put forward
   when they are acting collectively or individually. By looking at the
   `little things' and activities that most professionals don't pay much
   attention to, but are practised and experienced by people in their home
   built environments, we are likely to create a better way of
   understanding spatial meanings in view of people's culture and
   behaviour. Residents' spatial activities can tell us a lot about the
   organization of space, its structure and its imbued cultural meanings.
   The activities illustrate cherished people's conceptions and innate
   desires as dynamic meanings that follow some human hidden orders under
   some cosmic controls. These contentions have guided this case study of
   an urban home in Keko Magurumbasi informal settlement in Dar es Salaam
   Tanzania.},
