Title = {Assessment of Effective Doses due to Inhalation of Natural Radioactivity
   in the Dust of Urban Environment},
Booktitle = {VII INTERNATIONAL YOUNG RESEARCHERS' CONFERENCE - PHYSICS, TECHNOLOGY,
   INNOVATIONS (PTI-2020)},
Series = {AIP Conference Proceedings},
