   Angela and Molina-Huelva, Marta},
Title = {Integrated urban regeneration based on an interdisciplinary experience
   in Lisbon (Regeneracion urbana integrada basada en una experiencia
   interdisciplinar en Lisboa)},
Journal = {PSYECOLOGY-REVISTA BILINGUE DE PSICOLOGIA AMBIENTAL},
Year = {2020},
Volume = {11},
Number = {1, SI},
