@inproceedings{ WOS:001709837400003,
Author = {Verma, Ravi and Garg, P. K.},
Editor = {Erbertseder, T and Chrysoulakis, N and Zhang, Y},
Title = {Identifying spatial attributes of LULC classes affecting urban area LST
   in districts of India},
Booktitle = {REMOTE SENSING TECHNOLOGIES AND APPLICATIONS IN URBAN ENVIRONMENTS VIII},
Series = {Proceedings of SPIE},
Year = {2023},
Volume = {12735},
Note = {8th Conference on Remote Sensing Technologies and Applications in Urban
   Environments, Amsterdam, NETHERLANDS, SEP 03-04, 2023},
Organization = {The International Society for Optics and Photonics},
Abstract = {Urban Heat Island (UHI) driven effectively by urbanisation can directly
   affect environment and weather of city. UHI mitigation remains a hot
   topic for researchers around the world for sustainable urban planning.
   This study attempts on finding the relationship between spatial
   attributes of Land use\textbackslash{}Land Cover (LULC) classes in city
   and their effect on Land Surface Temperature (LST) over the Built-up
   patches present inside the 694 districts of different States and Union
   Territories (UTs) of India. Pan India Decadal LULC by ORNL DAAC for year
   2005 and Copernicus Global Land service LULC for year 2015 at 100m
   resolution has been taken as classified data for the study. MODIS LST
   maps at 1km resolution were used to find temperature patterns across the
   districts of India. Class Level Landscape metrics (LSM) were calculated
   for Built-up and Shrub LU present inside every district and correlated
   with average LST over Built-up patches present in district. Results show
   that Average LST of built-up patches is affected by spatial attributes
   of Built-up patches with highest variable importance (VI) to Mean
   Perimeter-Area Ratio (para\_mn) LSM in both years. Other common
   Important LSMs for LST of built-up patches are Core- Area index
   (cai\_mn), Euclidian Mean Neighbouhood Distance (enn\_mn) and
   Aggregation index (ai). Region wise LSM for built-up patches in East and
   West regions of India show much significant relationship to LST. Shrub
   LU also shows a significant relationship with LST patterns of Built-up
   patches in the same district in terms of LSMs as spatial attributes.},
