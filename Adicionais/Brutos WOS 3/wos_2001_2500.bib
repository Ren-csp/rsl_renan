@inproceedings{ WOS:000234955700043,
Author = {Weiland, U and Richter, M and Kasperidus, HD},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Environmental management and planning in urban regions - are there
   differences between growth and shrinkage?},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING II, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2005},
Volume = {84},
Pages = {441-450},
Note = {2nd International Conference on Sustainable Development and Planning,
   Bologna, ITALY, SEP 12-14, 2005},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {The question is whether the different processes in the development of
   growing and shrinking urban regions implicate the necessity to adjust
   and to differentiate between traditional environmental management and
   planning concepts. It is argued that urban planning in growing and
   shrinking urban regions does not require completely different planning
   procedures but locally adjusted solutions with better integration of
   sustainability issues. This paper briefly presents a conceptual approach
   that proposes a better integration of sustainability principles in
   planning processes by the categories space management, resource
   management, spatio-temporal management and process management. These
   categories will allow for complementing existing formal planning
   instruments with strategic, economic, and participatory approaches.},
