@article{ WOS:000315037900005,
Author = {El Khalil, Hicham and Schwartz, Christophe and El Hamiani, Ouafae and
   Kubiniok, Jochen and Morel, Jean Louis and Boularbah, Ali},
Title = {Distribution of major elements and trace metals as indicators of
   technosolisation of urban and suburban soils},
Journal = {JOURNAL OF SOILS AND SEDIMENTS},
