@inproceedings{ WOS:000291664400018,
Author = {Landorf, C.},
Editor = {Amoeda, R and Lira, S and Pinheiro, C},
Title = {The challenge of governance in historic urban environments},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {153-161},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {Governance has become a vehicle for the implementation of sustainable
   development programs and policies targeting the social improvement of
   communities. The role of the state in such a model assumes that of a
   facilitator promoting localised partnerships and community
   participation. These developments have become central to policy
   implementation at a variety of levels, including the management of
   heritage sites. However, it is difficult to see how a governance model
   can succeed under current heritage management frameworks. This is
   particularly so where a site is an integral part of an active community,
   such as a historic town centre or an industrial landscape. Heritage
   management models have traditionally separated historic and contemporary
   identities. This weakens the link between people and place which is
   considered by many to be a fundamental contributor to a socially
   cohesive and sustainable community. This paper reviews some of the
   concepts surrounding sustainable development with a particular emphasis
   on social sustainability and governance. The paper provides evidence
   that indicates the need for institutional and procedural innovation if
   historic environments are to contribute fully to sustainable
   development. The paper concludes by presenting a framework for localised
   decision-making in complex historic environments.},
