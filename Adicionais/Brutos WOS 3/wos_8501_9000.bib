Pages = {415-424},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {This paper presents a comparison of seven transport modes in both urban
   and rural settings, based on four characteristics of transport modes:
   space use, energy use, costs and travel time. The characteristics are
   calculated with a computer model and based on these results the modes
   can be ranked. This paper shows based on preliminary results - that the
   ranking order of the various transport modes based on the score on the
   four variables is not very sensitive to the spatial setting, although
   differences between spatial settings exist for the characteristics of
   the modes. By extending the analysis to the year 2020, slight
   differences occur in the ranking order of the transport modes, but no
   differences are found between the spatial settings.},
