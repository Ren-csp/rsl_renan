@inproceedings{ WOS:000180241500016,
Author = {Silva, RC and Simon, CP and Paiva, VSF},
Book-Group-Author = {MONDUZZI EDITIORE
   MONDUZZI EDITIORE},
Title = {Female juvenile prostitution: Subsidies to AIDS prevention programs},
Booktitle = {XIV INTERNATIONAL AIDS CONFERENCE: PREVENTION SCIENCE},
Year = {2002},
Pages = {67-70},
Note = {14th International AIDS Conference, BARCELONA, SPAIN, JUL 07-12, 2002},
Organization = {Univ N Carolina; Gen Clin Res Ctr; UNC Ctr AIDS Res; Natl Inst Hlth;
   Swiss Natl AIDS Res Program; Bristol-Myers Squibb Co; Boehringer
   Ingelheim; GlaxoWellcome Res \& Dev, HIV Antiviral Res},
Abstract = {Goal: Our main goal was to investigate the Aids perception as well as to
   obtain subsidies for the development of Aids prevention programs
   targeting female juvenile prostitution. Methods: Thirteen females aged
   18 to 21 years working as prostitutes in Ribeirdo Preto were
   interviewed. Results: Even though all participants demonstrated
   knowledge of safe sex and HIV transmission, this was in contrast with
   the belief that destiny is determinant for HIV infection and the search
   for affection in their relationships with partners and clients.
   Conclusions: The strategies of HIV and/Aids prevention must realize that
   an environment for discussion aiming at clarifying social imaginary
   beliefs and concepts about Aids is necessary. In addition, discussions
   about affective relationships seen as safe should take place as this can
   lead to unsafe sexual practices.},
