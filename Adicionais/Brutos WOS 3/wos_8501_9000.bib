@inproceedings{ WOS:000291345800013,
Author = {Kuzinas, A.},
Editor = {Zukauskiene, R},
Title = {Age-based differences in evaluating colours},
Booktitle = {XIV EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY (ECDP)},
Year = {2010},
Pages = {69-73},
Note = {14th European Conference on Developmental Psychology (ECDP), Mykolas
   Romeris Univ, Vilnius, LITHUANIA, AUG 18-22, 2009},
Abstract = {A well known fact is that colours can help to attract attention,
   influence emotions, affect perception, memory, etc. Some data even
   manage to reveal the differences between effects of specific colours.
   For instance, some colours (blue, red) are usually associated with more
   positive emotions compared to others (black, grey). However it is very
   important to note that effects of colours might be dependent not only on
   the characteristics of colour but also on the age of the viewer.
   This presentation reviews the current data about different age groups'
   evaluation of various colours, including colour preferences, colour
   emotions and colour associations. It also includes data gathered from a
   recent preliminary study in Lithuania. The explanation of all these
   facts based on cultural, experiential and methodological aspects is also
