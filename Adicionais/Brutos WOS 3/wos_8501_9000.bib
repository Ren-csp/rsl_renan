Pages = {782-792},
Note = {International Conference on Technologies and Materials for Renewable
   Energy, Environment and Sustainability (TMREES), Athens, GREECE, SEP
   19-21, 2018},
Abstract = {Urban construction has a great impact on the ecological environment. In
   the process of urban construction, how to protect the environment and
   develop harmoniously with nature is very important. Niche principle can
   be used not only in ecology, but also in campus planning. In the course
   of campus planning, adopting relevant ecological technology and niche
   strategy is conducive to the sustainable development of the campus and
   promoting the coordinated development among architecture, nature and
   society. Taking six university campuses in different regions of China as
   examples, this paper discusses how campus planning is combined with
   niche, and proposes strategies for campus planning from two aspects of
   nature and society, trying to propose solutions to the problems of
   campus planning from a new perspective and provide reference for related
   planning and theory. (C) 2019 The Authors. Published by Elsevier Ltd.},
