@inproceedings{ WOS:000247249900012,
Author = {Kou Liping and Du Fang},
Editor = {Zhang, YL and Wei, M},
Title = {Corporate social responsibility and public security},
Booktitle = {Towards A Responsible Success: Corporate Social Responsibility and
   Environmental Management},
Year = {2007},
Pages = {84-89},
Note = {Euro-Asian Conference on Environment and Corporate Social Responsibility
   - Perspectives from Business in Asia, Hong Kong, PEOPLES R CHINA, NOV  
   17, 2006},
Organization = {TU Bergakademie Freiberg; Hong Kong Univ, Ctr Urban Planning \& Environm
   Management; German Acad Exchange Serv Fdn; German Ind \& Commerce; Off
   European Commiss Hong Kong \& Macao; CSR Asia},
Abstract = {Corporate social responsibility (CSR) is the duty which enterprises
   should maintain and promote in pursuing social benefit besides seeking
   profit maximization of shareholders. CSR includes protecting workers'
   rights, supplying qualified goods and honest services, protecting
   natural environment, participating in the public welfare, and charity
   activities. This paper shows that there is close relationship between
   CSR and public security. Firstly, to protect workers' rights means to
   provide secure and healthful working conditions. It is not only for the
   security of employees, but also for the prevention of accidents menacing
   public security. Secondly, to provide qualified products and honest
   service means enterprises are responsible for consumers and public
   security. Lastly, enterprises can achieve sustainable development only
   by put CSR into serious consideration.},
Publisher = {WISSENSCHAFTLICHER VERLAG BERLIN},
Address = {OLAF GAUDIG \& KLAUS-PETER VEIT GBR, VERKEHRSNUMMER 96258, KORTESTR 10,
   BERLIN, 10967, GERMANY},
Type = {Proceedings Paper},
