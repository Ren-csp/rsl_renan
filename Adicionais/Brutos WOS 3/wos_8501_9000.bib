@inproceedings{ WOS:001073826400034,
Author = {Xu, Y. Y. and Zhou, Z. C. and Zhou, W. Z.},
Editor = {Romano, D and Bretzel, F and Toscano, S},
Title = {Development dilemma and its tentative solutions of flower-themed tourism
   in China},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
Volume = {1345},
Pages = {259-266},
Note = {8th International Conference on Landscape and Urban Horticulture, ELECTR
   NETWORK, DEC 15-17, 2021},
Organization = {Int Soc Hort Sci, Div Landscape \& Urban Hort; Int Soc Hort Sci, Div
   Protected Cultivat \& Soilless Culture; Int Soc Hort Sci, Working Grp
   Urban Hort; Univ Catania, Dept Agr, Food \& Environm; Natl Res Council,
   Res Inst Terrestrial Ecosystems; Int Soc Hort Sci, Working Grp Landscape
   Hort},
Abstract = {Due to the increasing awareness of horticulture and outdoor leisure's
   important roles in people's physical and mental health, flower-themed
   tourism has already become one of the most popular tourist activities
   during spring time in China. However, blind construction of
   unsustainable flower-themed attractions occurs quite often nowadays,
   which has brought a tremendous negative impact to the horticulture
   development in China. Based on this context, this paper analyzes the
   development phases of flower-themed tourism in historical order as well
   as the tourists' geographical distribution by digital foot-printing.
   Then it focuses on discussing four crucial issues around the dilemma in
   this tourism, including weak business model, ambitious positioning, poor
   management and neglect of flower culture's value. In the end, five
   tentative solutions are proposed in order to promote a healthy and
   sustainable tourism as follows: 1) Avoid to develop flower-themed
   tourism on farmlands for food production; 2) Avoid to build
   flower-themed landscape with the sole purpose of beauty viewing; 3)
   Encourage to develop flower-themed tourism on traditional flower
   planting and processing regions; 4) Give priority to developing
   destinations with natural flower resources such as wild flower tourism;
   5) Make full use of Chinese flower civilization in urban park systems.},
