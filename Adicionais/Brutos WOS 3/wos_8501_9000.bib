   and Branzov, Hristomir and Nikolov, Valeri},
Editor = {Dobrinkova, N and Nikolov, O},
Title = {Forecasting Hourly NO2 and O3 Concentrations Using
   Data Analytics Models at Pavlovo Station in Sofia},
Booktitle = {ENVIRONMENTAL PROTECTION AND DISASTER RISKS},
Series = {Lecture Notes in Networks and Systems},
Year = {2023},
Volume = {638},
