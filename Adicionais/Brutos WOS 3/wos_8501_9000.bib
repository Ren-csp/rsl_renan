@article{ WOS:A1994PX73600003,
Author = {MOONEY, KM and DETORE, J and MALLOY, KA},
Title = {PERCEPTIONS OF WOMEN RELATED TO FOOD CHOICE},
Journal = {SEX ROLES},
Year = {1994},
Volume = {31},
