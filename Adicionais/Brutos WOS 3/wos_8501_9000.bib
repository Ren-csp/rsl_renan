Title = {Monitoring of Vegetation Variation in Jiangsu Province Based on
   MODIS-LAI data},
Booktitle = {EARTH RESOURCES AND ENVIRONMENTAL REMOTE SENSING/GIS APPLICATIONS X},
Series = {Proceedings of SPIE},
Year = {2019},
