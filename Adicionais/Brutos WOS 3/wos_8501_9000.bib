@article{ WOS:000432429600029,
Author = {Aziz, Azhar Abdul and Mokhsin, Mudiana and Moganan, Fateen Faiqa Mislan
   and Ismail, Afiza and Sakamat, Norzehan and Zainol, Amer Shakir and
   Lokman, Anitawati Mohd},
Title = {Humanoid-Robot as Teaching Mediator: Research Model in Demonstrating the
   Autistic Children Learning Motivation Based on the Emotional Responses},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2296-2300},
