@inproceedings{ WOS:000299096402034,
Author = {Song Cheng and Dong Xiao-lin and Yang Jian-jun and Wu Ying-chao},
Editor = {Zhou, X},
Title = {RETRACTED: Accounting and Analysis of the Cost of Air Pollution Control
   in Urban (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
Series = {Energy Procedia},
Year = {2011},
Volume = {11},
Pages = {2181-2187},
Note = {International Conference on Energy and Environmental Science (ICEES),
   Singapore, SINGAPORE, OCT, 2011},
Organization = {Singapore Inst Elect (SIE)},
Abstract = {With the analysis model of control cost per-unit, the cost of air
   pollution control was accounted in Xi'an from 2000 to 2007 in this
   paper. Based on the accounting results, the gross amount and the
   structure of control cost were analyzed. Environmental economic
   indicators were used in analytical process, such as the virtual control
   cost, the index of pollution control cost deduction from GDP and the
   environmentally adjusted domestic product. The results showed that the
