Year = {1997},
Pages = {490-495},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {The study examines the prevalence of acute and chronic respiratory
   disease, among population of three local communities with different
   ambient air quality during the five year period. Each population group
   has been divided into the subgroups of pre-school and school children,
   adults and elderly. The significant differences in the prevalence of
   acute respiratory diseases between both pre-school and school children
   of higher (Region 1- Bakar and Region 2- Krasica) and lower polluted
   (control Region 3- Viskovo) communities have been found (p<0.01).
   Further more, the occurrence of pathological obstructive ventilatory
   disturbances among non- smoking women residing in Region 2- Krasica has
   been significantly higher in comparison to the control Region 3-Viskovo.},
