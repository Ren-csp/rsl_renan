@inproceedings{ WOS:000277058600012,
Author = {Spoerrle, Matthias and Welpe, Isabell M.},
Editor = {Zerbe, WJ and Hartel, C and Ashkanasy, N},
Title = {HOW TO FEEL RATIONALLY: LINKING RATIONAL EMOTIVE BEHAVIOR THERAPY WITH
   COMPONENTS OF EMOTIONAL INTELLIGENCE},
Booktitle = {INDIVIDUAL AND ORGANIZATIONAL PERSPECTIVES ON EMOTION MANAGEMENT AND
   DISPLAY},
Series = {Research on Emotion in Organizations},
Year = {2006},
Volume = {2},
Pages = {291-322},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {Adopting the theoretical framework of Rational Emotive Behavior Therapy
   (REBT; Ellis, 1962, 1994), we examine the cognitive antecedents of
   functional behavior and adaptive emotions as indicators of emotional
   intelligence (EI) and test central assumptions of REBT. In an extension
   of REBT, we posit that adaptive emotions resulting from rational
   cognitions reflect more EI than maladaptive emotions, which result from
   irrational cognitions, because the former lead to functional behavior.
   The results of the first study using organizational scenarios in an
   experimental design confirm central assumptions of REBT and support our
   hypotheses. In a second correlational study we replicate the connection
   between rational cognitions and EI by measuring real person data using
   psychometric scales. Both studies indicate that irrational attitudes
   result in reduced job satisfaction.},
