@article{ WOS:000088030300005,
Author = {Ciani, AC},
Title = {When to get mad: Adaptive significance of rage in animals},
Journal = {PSYCHOPATHOLOGY},
Year = {2000},
Volume = {33},
Number = {4},
Pages = {191-197},
Month = {JUL-AUG},
Note = {Conference on Dysphoria, CITTA DI CASTELLO, ITALY, DEC, 1997},
Organization = {Italian Assoc Psychopathol; Florence Ctr Hist \& Philosophy Sci; WPA
   Sect Clin Psychopathol; AEP Sect Psychopathol},
Abstract = {The wide distribution of rage in animals suggests that rage should have
   an adaptive significance. In the present work, the function of rage is
   explored under an evolutionary perspective. I try to assess the
   selective advantage conferred to the individual presenting rage compared
   to one that does not. In this work, I considered animals under the
   `strategist' perspective rather than the `stimulus-reactor' one. I
   suggest that rage has a highly adaptive significance both as: (1) an
   emotion to prepare antagonistic actions and (2) as a communicative act.
   suggest therefore that, as a communicative act, rage can be explored
   through the theory of games. In three crucial scenarios, I investigate,
   using the theory of games framework, when, and how, there is a selective
   advantage for individuals expressing, bluffing and simulating rage.
