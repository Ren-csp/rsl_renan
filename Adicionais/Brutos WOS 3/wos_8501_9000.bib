Title = {Temporal analysis of incompatible land-use and land-cover: The proximity
   between residential areas and gas stations in Bucharest suburban area},
Booktitle = {2011 INTERNATIONAL CONFERENCE OF ENVIRONMENT-LANDSCAPE-EUROPEAN IDENTITY},
Series = {Procedia Environmental Sciences},
Year = {2012},
Volume = {14},
