@inproceedings{ WOS:000234955700083,
Author = {Salatino, M},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {A model for assessing land use impacts on driving costs},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2005},
Volume = {84},
Pages = {849-858},
Note = {2nd International Conference on Sustainable Development and Planning,
   Bologna, ITALY, SEP 12-14, 2005},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {Interaction between urban form and transportation costs has been a much
   debated issue during the past decades. Density influences travel
   behaviour, since individuals must travel farther when land use patterns
   become more dispersed. This study tries to assess density effects on
   transportation in terms of money, by calculating additional costs of
   travel due to decreasing residential density. First, a linear model was
   implemented in order to foretell urban density. Then we turn these
   densities in travel demand by means of a relationship between density
   and transportation variables. Finally, we convert travel demand into
   internal and external costs. The model was tested in a small urban area
   in Southern Italy. A comparison of total commuting costs was made by
   comparing the actual situation with two possible future scenarios. As is
   to be expected, laying down new roads in peripheral areas should
   increase travel demand and transportation costs, as a consequence of
   decreasing densities.},
