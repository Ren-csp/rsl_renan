   and Tian, Weili and Chen, Yingxu and Xu, Weiguo},
Editor = {Li, H and Xu, QJ and Zhang, D},
Title = {Improvement of grey clustering model for comprehensive assessment of
   environmental quality: A case study in water environment},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND ENGINEERING (ICEESD2011), PTS 1-5},
