@article{ WOS:000425016300010,
Author = {Doering, Martin and Ratter, Beate},
Title = {The regional framing of climate change: towards a place-based
   perspective on regional climate change perception in north Frisia},
Journal = {JOURNAL OF COASTAL CONSERVATION},
Year = {2018},
Volume = {22},
Number = {1, SI},
Pages = {131-143},
