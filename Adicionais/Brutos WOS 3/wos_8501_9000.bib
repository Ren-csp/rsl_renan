@article{ WOS:000244971100007,
Author = {Larsen, R. S. and Bell, J. N. B. and James, P. W. and Chimonides, P. J.
   and Rumsey, F. J. and Tremper, A. and Purvis, O. W.},
Title = {Lichen and bryophyte distribution on oak in London in relation to air
   pollution and bark acidity},
Journal = {ENVIRONMENTAL POLLUTION},
