@inproceedings{ WOS:000234955700010,
Author = {Ralevic, M and Djukic, A},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Growth management of the cities as a function of sustainable development
   of the Serbia Region},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2005},
Volume = {84},
Pages = {99-108},
Note = {2nd International Conference on Sustainable Development and Planning,
   Bologna, ITALY, SEP 12-14, 2005},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm},
Abstract = {Serbia is going through a process of transition that involves big and
   rapid changes, which unfortunately have some side effects in the form of
   a set of negative, unfavourable and uncontrolable transformations. The
   most obvious ones are: slow development of the cities, first of all due
   to the lack of funds for replacement of the old infrastructure, but also
   due to ruined superstructure; disturbed even and equal development of
   the regions within the country (districts and municipalities) - in the
   last two decades only the gravitational area of the biggest city in the
   country - Belgrade - has developed; uncontrolled changes of the cities
   and settlements in terms of their uncontrolled growth - the cities have
   expanded in such a way that they have crossed the borders of the city's
   constructional area, with such newly created suburbs acquiring all the
   characteristics of rural settlements; and illegal construction that
   reached its peak in the last decade of the 20(th) century, thus
   disturbing the urban order and recommendations of the city planning
   documents.
   The basic objective of the research is to create some new approaches and
   methods of management aiming at the regeneration of the region and
   renewal of the cities. The management would mostly refer to the
   implementation of the city planning documents.
   Expected results include an even development of the region and
   controlled growth of the cities - by insisting on compact cities and on
   prevention of further illegal construction as well as on regeneration of
   illegally constructed parts and cities and decrease of the differences
   between developed and underdeveloped regions of the country.},
