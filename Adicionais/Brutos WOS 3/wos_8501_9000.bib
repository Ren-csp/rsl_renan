@article{ WOS:000188663300006,
Author = {Kowalski-Trakofler, KM and Barrett, EA},
Title = {The concept of degraded images applied to hazard recognition training in
   mining for reduction of lost-time injuries},
Journal = {JOURNAL OF SAFETY RESEARCH},
Year = {2003},
Volume = {34},
Number = {5},
Pages = {515-525},
Note = {23rd International Congress of Applied Psychology, MADRID, SPAIN, JUL
   17-23, 1994},
Abstract = {Introduction: This paper discusses the application of a training
   intervention that uses degraded images for improving the hazard
   recognition skills of miners. Method: NIOSH researchers, in an extensive
   literature review, identified fundamental psychological principles on
   perception that may be employed to enhance the ability of miners to
   recognize and respond to hazards in their dangerous work environment.
   Three studies were conducted to evaluate the effectiveness of the
   degraded image training intervention. A model of hazard recognition was
   developed to guide the study. Results: In the first study, miners from
   Pennsylvania, West Virginia and Alabama, who were taught with the aid of
   degraded images, scored significantly better on follow-up hazard
