@inproceedings{ WOS:000392421700662,
Author = {Baker, Joseph M. and Feigleson, Jessica M. and Jordan, Kerry E.},
Editor = {Ohlsson, S and Catrambone, R},
Title = {Multiple visual cues enhance quantitative perception in infancy},
Booktitle = {COGNITION IN FLUX},
Year = {2010},
Pages = {2799-2803},
Note = {32nd Annual Meeting of the Cognitive-Science-Society, Portland, OR, AUG
   11-14, 2010},
Organization = {Cognit Sci Soc; Air Force Off Sci Res; Natl Sci Fdn; Air Force Res Lab;
   Off Naval Res; Inst Educ Sci; Robert J Glushko \& Pamela Samuelson Fdn},
Abstract = {Infants possess basic capabilities to assess various quantitative
   properties such as number, size, and time. Preverbal discriminations are
   approximate, however, and similarly limited by ratio across these
   dimensions. Here, we present the first evidence that redundant
   quantitative unisensory information-namely, simultaneous visual cues to
   both number and size-accelerates six-month-olds' quantitative
   competence. Using a habituation-dishabituation paradigm, results
   demonstrate that, when provided with synchronous visual cues to
   different quantitative properties, infants make more precise
   discriminations than when they receive information about a single cue
   alone. Such redundant conceptual information may be more salient than
   non-redundant information, which could better recruit attention and
   result in more precise learning and remembering than when such
   information is presented through only one cue.},
