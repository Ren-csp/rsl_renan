@article{ WOS:000401398500003,
Author = {Sun, Bindong and Ermagun, Alireza and Dan, Bo},
Title = {Built environmental impacts on commuting mode choice and distance:
   Evidence from Shanghai},
Journal = {TRANSPORTATION RESEARCH PART D-TRANSPORT AND ENVIRONMENT},
