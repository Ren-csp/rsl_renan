@inproceedings{ WOS:000079630400201,
Author = {Xu, L},
Editor = {Usui, S and Oori, T},
Title = {Bayesian Ying-Yang system and theory as a unified statistical learning
   approach: (V) - Temporal modeling for perception and control},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {877-884},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {This paper (1) systematically presents Bayesian Ying-Yang Temporal
   Modeling (BYY-TM) theory for perception and control in an environments
   that changes with time. Not only some special cases of BYY-TM are shown
   to reduce into (a) the conventional State Space Modeling (SSM) with
   Kalman filtering algorithm, (b) the well known Hidden Markov Model (HMM)
   and (c) Recurrent Neural Nets (RNN), but also a number of new results
   are obtained according to this BYY-TM theory. First, new extensions of
   the Kalman filtering algorithm have been obtained for the cases of
   nongaussian noise and nonlinear SSM model. Second, the SSM has been
   extended into models for temporal factor analysis, temporal independent
   component analysis acid temporal dependence reduction, with algorithms
   for parameter learning and criteria for deciding the number of factors
   or sources. Third, a fast adaptive algorithm is proposed for HMM
   learning and a criterion is given for determining the number of states.
   Fourth, a criterion has been obtained for selecting the number of hidden
   recurrent units in three layer recurrent net.},
Publisher = {OHMSHA LTD},
Address = {1-3 KANDA NISHIKI-CHO, CHIYODA-KU, TOKYO, 101, JAPAN},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Xu, L (Corresponding Author), Chinese Univ Hong Kong, Dept Comp Sci \& Engn, Shatin,NT, Hong Kong, Peoples R China.
   Chinese Univ Hong Kong, Dept Comp Sci \& Engn, Hong Kong, Peoples R China.},
ISBN = {4-274-90259-5},
Keywords = {Bayesian Ying-Yang learning; temporal modeling; state space; hidden
   Markov model; model selection; factor analysis; dependence reduction;
   independent component analysis; recurrent net},
Keywords-Plus = {MACHINE},
Research-Areas = {Computer Science; Science \& Technology - Other Topics; Neurosciences \&
