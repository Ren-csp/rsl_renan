@inproceedings{ WOS:000080610100047,
Author = {Sen, Z},
Editor = {Dincer, I and Ayhan, T},
Title = {Atmospheric-hydrospheric pollution and health},
Booktitle = {ENERGY AND THE ENVIRONMENT},
Year = {1999},
Pages = {257-259},
