@inproceedings{ WOS:000073221600113,
Author = {Remmler, F and Hutter, U},
Editor = {Chilton, J},
Title = {Storm water management in urban areas: Risks and case studies},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {647-652},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Nowadays, in many cases, managed infiltration of runoff is practised as
   an alternative approach to storm water drainage. This practice supports
   the natural water cycle by the immediate reintroduction to the cycle of
   runoff components from different drainage areas. This increasingly
   widely used procedure has to be strictly assessed and controlled with
   the aim of soil and water protection. This paper presents some results
   of investigations with respect to the quality of topsoil in several
   infiltration troughs. A significant aspect to consider is whether
   long-term operation of the drainage systems could exhaust the buffer and
   filtration capacity of the soil. Investigations within specific
   infiltration projects showed that there is a high accumulation of
   substances in most materials used to construct roof drainage systems in
   the topsoil of the infiltration areas. Longterm operation can
   significantly reduce the cleaning effects of passage through the soil.
   Operational stability and reliable functioning of infiltration systems
   has to be guaranteed in the long-term. Therefore, the location,
   structure and operation of alternative storm water drainage systems have
   to meet some specific criteria.},
Publisher = {A A BALKEMA PUBLISHERS},
Address = {SCHIPHOLWEG 107C, PO BOX 447, 2316 XC LEIDEN, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
