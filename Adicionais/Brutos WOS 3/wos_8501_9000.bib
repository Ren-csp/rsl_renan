@inproceedings{ WOS:000264733100029,
Author = {Buck, Michaella},
Editor = {Rehulka, E},
Title = {OVERCOMING PERFECTIONISM BY EXPLORING CAUSAL RELATIONSHIPS BETWEEN
   COGNITIONS, EMOTIONS AND BEHAVIOURS},
Booktitle = {SCHOOL AND HEALTH 21(2)},
Year = {2007},
Pages = {297-302},
Note = {2nd Conference School and Health 21, Brno, CZECH REPUBLIC, AUG 28-30,
   2006},
Abstract = {Cognitive-behavioral therapy is one of the most widely researched
   therapies. In this presentation, a model of cognitive, behavioral, and
   affective perspective in the treatment of perfectionism is described.
   Perfectionism refers to a set of self-defeating thoughts and behaviors
   aimed at reaching excessively high and unrealistic goals. Perfectionism
   is mistakenly seen in our society as desirable or even necessary for
   success. However, research has shown that perfectionist attitudes
   actually interfere with success. Three basic types of perfectionism are
   described. Yet it may, not always be easy to grasp how perfectionism is
   developed, and what exactly keeps it going, cognitive-behavioral
   therapists try to verify a coherent and systematic program of
   interventions. Finally, a therapeutic model we confirm, is illustrated.
   It is based on changes from perfectionist attitudes to healthy striving.
   The fundamental step is to challenge the self-defeating thoughts and
   behaviors that fuel perfectionism. Some therapeutic strategies are
   discussed.},
Publisher = {PAIDO},
Address = {SRBSKA 35, BRNO, 612 00, CZECH REPUBLIC},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Buck, Michaella, Univ Indianapolis, Intercoll, Dept Social Sci, CY-1700 Nicosia, Cyprus.},
