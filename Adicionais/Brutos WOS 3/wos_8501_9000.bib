Title = {Birdie..birdie.. come and let's share our city},
Booktitle = {INTERNATIONAL SYMPOSIUM ON ARBORICULTURE IN THE TROPICS: SECURING
   ECOSYSTEM FUNCTIONS IN URBAN LANDSCAPE (ISATROP 2017)},
