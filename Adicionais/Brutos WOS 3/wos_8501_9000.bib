@article{ WOS:000237012200015,
Author = {Holt, DJ and Titone, D and Long, LS and Goff, DC and Cather, C and
   Rauch, SL and Judge, A and Kuperberg, GR},
Title = {The misattribution of salience in delusional patients with schizophrenia},
