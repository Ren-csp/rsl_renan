@inproceedings{ WOS:000179249200097,
Author = {Súri, M and Jones, AR and Dunlop, ED},
Editor = {Brebbia, CA and MartinDuque, JF and Wadhwa, LC},
Title = {Mapping the potential of photovoltaic systems in urban areas of Slovakia},
Booktitle = {SUSTAINABLE CITY II: URBAN REGENERATION AND SUSTAINABILITY},
Series = {ADVANCES IN ARCHITECTURE SERIES},
