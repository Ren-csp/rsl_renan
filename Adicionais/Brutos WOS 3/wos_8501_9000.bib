Note = {2024 International Conference on Environmental Protection and Disaster
   Risks and Crisis Management and Disaster Response-EnviroRisks, Sofia,
   BULGARIA, JUN 04-06, 2024},
Organization = {Natsionalen institut po geofizika geodezia i geografia B'lgarska
   akademia na naukite},
Abstract = {Several separate data analytics models are developed to forecast 48 h
   ahead the hourly concentrations of nitrogen dioxide (NO2) and
   tropospheric ozone (O-3). Hourly air pollution concentrations data
   collected at Pavlovo urban air quality monitoring station of the
   Executive Environment Agency (ExEA) in Sofia city for the period
   01.01.2019-07.05.2021 are used to validate the effectiveness of the
   proposed models. The models are based on Weather Research and
   Forecasting (WRF) and mixtures-of-experts (MoE) time series regression
   models. The WRF model delivers 48 h forecast meteorological derivatives
   which characterize the atmospheric conditions in Pavlovo from ground
   surface up to 5500 m height. These derivatives, their lags and air
   pollutants data lags serve as input predictors into the MoE time series
   regression models with log-normal distribution of the air pollutants
   hourly concentrations. The models provide reasonably good fits in terms
   of the standard forecast accuracy metrics such as Mean Absolute Error
   (MAE), Root Mean Square Error (RMSE) and correlation coefficients
   between observed and forecasted values.},
