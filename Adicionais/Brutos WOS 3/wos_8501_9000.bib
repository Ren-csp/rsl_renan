Title = {Analyzing Mass Appraisal of Urban Residential Land with Machine Learning
   - A Case Study in Hanoi, Vietnam},
Booktitle = {GEOINFORMATICS FOR SPATIAL-INFRASTRUCTURE DEVELOPMENT IN EARTH AND
   ALLIED SCIENCES, GIS-IDEAS 2023},
