@inproceedings{ WOS:000243062800012,
Author = {Douvlou, E. and Ryder, A.},
Editor = {Brebbia, CA and Conti, ME and Tiezzi, E},
Title = {Sustainability and urban regeneration: the community and the city},
Booktitle = {MANAGEMENT OF NATURAL RESOURCES, SUSTAINABLE DEVELOPMENT AND ECOLOGICAL
   HAZARDS},
