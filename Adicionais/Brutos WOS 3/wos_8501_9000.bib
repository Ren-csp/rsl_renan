@inproceedings{ WOS:000309373900206,
Author = {Chai, Ning and Choi, Mack Joong},
Editor = {Xu, QJ and Ge, HH and Zhang, JX},
Title = {The Utilization Planning of Historic and Cultural Buildings in Declined
   Region: In the Case of Gongrencun Region in Shenyang City of China},
Booktitle = {NATURAL RESOURCES AND SUSTAINABLE DEVELOPMENT, PTS 1-3},
Series = {Advanced Materials Research},
Year = {2012},
Volume = {361-363},
Pages = {1109-1116},
Note = {International Conference on Energy, Environment and Sustainable
   Development (ICEESD 2011), Shanghai Univ Elect Power, Shanghai, PEOPLES
   R CHINA, OCT 21-23, 2011},
Organization = {Xinjiang Univ; Hebei United Univ},
Abstract = {As the old industrial base, Shenyang has made important contributions to
   China. However, with the industrial structure adjustment since the
   reform and opening up, some factories are either moved to the suburbs or
   closed down, which results in regional decline, the Gongrencun region of
   Shenyang is a typical representative. To solve the problem, the local
   government began to implement urban regeneration policy from April,
   2000. In the process of implementation, however, some valuable old
   buildings were demolished caused by their neglect, which has caused a
   waste and unnecessary loses. This article explores a reasonable
   utilization scheme of historic and cultural buildings by analyzing their
   values in order to revitalize the declined region, based on which, a PLP
   (Point-Line-Plane) planning strategy is proposed.},
