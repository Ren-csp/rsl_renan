@inproceedings{ WOS:000166733400020,
Author = {DePasquale, AJ and Leatherman, D and Thomas, R},
Book-Group-Author = {IECA
   IECA
   IECA},
Title = {Geocell wall and channel protection for US Army Corps flood control
   project},
Booktitle = {PROCEEDINGS OF CONFERENCE 31 - INTERNATIONAL EROSION CONTROL ASSOCIATION},
Series = {INTERNATIONAL EROSION CONTROL ASSOCIATION - PROCEEDINGS OF CONFERENCE},
Year = {2000},
Pages = {231-237},
Note = {31st Annual Conference of the International-Erosion-Control-Association,
   PALM SPRINGS, CA, FEB 21-25, 2000},
Organization = {Int Eros Control Assoc; Terra Mulch; Synthet Ind},
Abstract = {The Molly Ann's Brook Flood Protection Project is located in Paterson,
   Haledon, and Prospect Park, New Jersey. The brook is a tributary of the
   Passaic River and flows through an urban area. Communities along the 2.5
   mile stretch of the brook have been subject to repetitive flooding due
   to inadequate channel capacity. The project was designed and constructed
   by the U.S. Army Corps of Engineers, Philadelphia District. The deeper
   and wider chan nel provides complete protection from flooding up to a
   50-year event. The chan nel varies throughout the project from a
   trapezoidal riprap section to a rectangular section formed by precast
   concrete walls. Waits were required due to limited space and proximity
   of structures along the brook. In two areas the Corps opted to utilize
   innovative alternatives to the conventional riprap, gabions, and
   concrete retaining walls. The first alternate, the Presto perforated
   Geoweb Cellular Confinement System, also named a geocell system, was
   used to construct a 14 foot high, 400 foot long gravity wall. This wall
   was used to replace a more expensive reinforced concrete retaining wall.
   The design and construction phases were complicated by an undulating
   bedrock surface. The aesthetics and environment were improved by using
   tan colored material on the face of the first exposed cell and planting
   vines in the cell. The use of the geocell wall in a flood protection
   project was unprecedented for the Corps of Engineers. The second
   alternate was a single 4 inch layer of perforated geocell filled with
   low slump concrete. It was used to replace a 54 inch thick riprap layer,
   which was necessary due to high flow velocities and shear stresses at a
   critical bend in the brook. The use of the geocell system saved over
   \$80,000 in the two areas.},
Publisher = {INT EROSION CONTROL ASSOC},
Address = {PO BOX 4904, STEAMBOAT SPRINGS, CO 80477 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {DePasquale, AJ (Corresponding Author), USA, Corps Engineers, Philadelphia Dist,114 Maine Ave, Cherry Hill, NJ 08002 USA.
   USA, Corps Engineers, Cherry Hill, NJ 08002 USA.},
