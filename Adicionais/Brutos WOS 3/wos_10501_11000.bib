@inproceedings{ WOS:000170231900031,
Author = {Child, L and Wade, M and Hathaway, S},
Editor = {Brundu, G and Brock, J and Camarda, I and Child, L and Wade, M},
Title = {Strategic invasive plant management, linking policy and practice: A case
   study of Fallopia japonica in Swansea, South Wales (United Kingdom)},
Booktitle = {PLANT INVASIONS: SPECIES ECOLOGY AND ECOSYSTEM MANAGEMENT},
Year = {2001},
Pages = {291-301},
Note = {5th International Conference on Ecology of Invasive Alien Plants,
   SARDINIA, ITALY, OCT 13-16, 1999},
Abstract = {Since the export of Fallopia japonica (Houtt.) Ronse Decraene from Japan
   in the mid nineteenth century as an ornamental species, this rhizomatous
   perennial plant has rapidly extended its distribution in its introduced
   range. The control of the plant in both urban and rural environments is
   now a significant problem in Europe. the northern states of the USA,
   Canada and New Zealand. Human activity is mainly responsible for its
   spread, particularly in urban environments through movement of soil
   containing plant fragments. The Planning Department of the City and
   County of Swansea, a local authority in South Wales. United Kingdom, has
   attempted to manage the invasion of F. japonica in the area of their
   jurisdiction by establishing a strategic management plan. Two
   comprehensive ground surveys carried out in 1992 and 1998 respectively
   created an accurate picture of the distribution of the plant within the
   area. These data were transferred to a Geographical Information System
   (GIS) enabling rapid data manipulation and the establishment of links
   between e.g. planning policy. land ownership and the presence of F.
   japonica. The opportunities and constraints involved in controlling F.
   japonica in an urban environment are explored from a local authority
   perspective and some problems encountered in using GIS for this type of
   exercise are discussed. Results of the 1998 survey show that the area
   covered by F. japonica is 100 ha which represents 0.25\% of the total
   400 km(2) area surveyed. In relation to the strategic management of the
   plant within the city, the use of GIS has enabled the Council to
   identify alert areas where plans for re-development affect infested
   sites and to place restrictions on the movement of infested soil. A
   Japanese Knotweed Officer has also been appointed.},
