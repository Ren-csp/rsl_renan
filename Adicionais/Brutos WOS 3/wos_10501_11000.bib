@inproceedings{ WOS:001260359900010,
Author = {Jamil, Asfa and Padubidri, Chirag and Karatsiolis, Savvas and Kalita,
   Indrajit and Guley, Aytac and Kamilaris, Andreas},
Editor = {Wohlgemuth, V and Kranzlmuller, D and Hob, M},
Title = {GAEA: A Country-Scale Geospatial Environmental Modelling Tool: Towards a
   Digital Twin for Real Estate},
Booktitle = {ADVANCES AND NEW TRENDS IN ENVIRONMENTAL INFORMATICS 2023, ENVIROINFO
   2023},
