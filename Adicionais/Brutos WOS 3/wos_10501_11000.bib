@article{ WOS:A1994MV87800003,
Author = {BOYATZIS, CJ and SATYAPRASAD, C},
Title = {CHILDRENS FACIAL AND GESTURAL DECODING AND ENCODING - RELATIONS BETWEEN
   SKILLS AND WITH POPULARITY},
Journal = {JOURNAL OF NONVERBAL BEHAVIOR},
Year = {1994},
Volume = {18},
