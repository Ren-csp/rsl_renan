Title = {Perception of lexical tone across languages: Evidence for a linguistic
   mode of processing},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {2514-2517},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Pairs of Thai tones were presented for perceptual discrimination in
   three linguistic contexts (normal speech, low-pass filtered speech, and
   as musical (violin) sounds) to tonal language speakers, Thai and
   Cantonese, and non-tonal (English) language speakers. English speakers
   discriminated the tonal contrasts significantly better in the musical
   context than in filtered speech, and in filtered speech better than in
   full speech. On the other hand, both Thai and Cantonese speakers
   perceived the tonal contrasts equally well in ail three contexts. Thus
   developmental absence of exposure to lexical tone results in a
   linguistic mode of processing which involves the attenuation of a basic
   psychoacoustic ability, pitch discrimination.},
