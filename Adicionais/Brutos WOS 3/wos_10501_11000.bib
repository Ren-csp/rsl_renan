Year = {1998},
Volume = {1162},
Pages = {389-394},
Note = {6th International Evoked Potentials Symposium (6th IEPS), OKAZAKI,
   JAPAN, MAR 21-25, 1998},
Organization = {Minist Educ Sci Culture \& Sports Japan; Okazaki Natl Res Inst; Natl
   Inst Physiol Sci; Pharmaceut Manufacturers Assoc Tokyo; Osaka Pharmaceut
   Manufacturers Assoc},
Abstract = {To investigate the cortical activities related to the visual awareness
   of characters, we recorded the magnetic responses from six normal
   subjects trying to discriminate between characters displayed for a brief
   period. The characters consist of capitalized English letters. In order
   to reduce the responses evoked by the luminance change, we presented the
   characters by means of the temporal changes of the dynamic random dots.
   Along with the magnetic responses, we recorded the subjects' answers on
   the discrimination task.
   The clear components of the magnetic responses were identified at about
   300 ms after the onset of the stimuli. For all of the subjects, the peak
   amplitude and the discrimination accuracy (DA) increased similarly as
   the character display period became longer. The signal sources for the
   components were estimated around the firsiform and the lingual gyri in
   the right hemisphere. We consider that the activity in these cortical
   areas has strong relation to the conscious perception of the characters.},
