@inproceedings{ WOS:A1996BJ20B00404,
Author = {Znagui, I and Yeou, M},
Editor = {Bunnell, HT and Idsardi, W},
Title = {The role of coarticulation in the perception of vowel quality in modern
   standard Arabic},
