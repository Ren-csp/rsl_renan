Organization = {Soc Amer Foresters},
Abstract = {Tropical silviculture differs chiefly in detail. Highly productive
   plantations area growing source of industrial wood. Natural forests will
   continue as a supplementary source of diverse products not currently
   available from plantations. More than half of the forests are either
   secondary or cutover. These respond well to silviculture. The most
   common silvicultural practice has been ``improvement fellings{''}
   concerned with both selective harvesting and care of the residual.
   Variants have been refinement and liberation. Low-impact logging,
   leaving potential crop trees undamaged, may lead to their retention and
   liberation as an investment.},
