Title = {MIMo: A Multi-Modal Infant Model for Studying Cognitive Development in
   Humans and AIs},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON DEVELOPMENT AND LEARNING, ICDL},
Series = {IEEE International Conference on Development and Learning},
Year = {2022},
