@inproceedings{ WOS:000223370200037,
Author = {Jansz, J},
Editor = {Stephenson, N and Radtke, HL and Jorna, R and Stam, HJ},
Title = {The appeal of violent media entertainment for men},
Booktitle = {THEORETICAL PSYCHOLOGY: CRITICAL CONTRIBUTIONS},
Year = {2003},
Pages = {328-334},
Note = {9th Biennual Conference of the
   International-Society-for-Theoretical-Psychology, Calgary, CANADA, JUN
   03-08, 2001},
Organization = {Int Soc Theoret Psychol},
Abstract = {Men, in particular adolescent ones, are active consumers of violence in
   media entertainment programs and films. This paper concentrates on the
   psychological appeal of media violence, by discussing why so many young
   men like to watch violence. The answer proposed here focuses on the
   interplay of emotion and identity. It argues that many spectators
   experience media entertainment as if it were true, although they know it
   is false. The fact that spectators of media violence experience joy
   rather than disgust signals, according to emotion theory, that an
   important concern is met. I will argue that this concern is identity
   related: violence in media entertainment enables the exploration of
   aspects of identity that can never be enacted in day-to-day interaction.},
