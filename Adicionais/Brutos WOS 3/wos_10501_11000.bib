Title = {PSYCHOCORRECTION OF ANXIETY OF HIGH SCHOOL STUDENTS IN PREPARATION FOR
   STATE EXAMINATIONS},
Booktitle = {PROFESSIONAL CULTURE OF THE SPECIALIST OF THE FUTURE},
