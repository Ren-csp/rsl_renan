Organization = {Czech Soc Landscape Engineers; Mendel Univ Brno, Fac Forestry \& Wood
   Technol, Dept Landscape Management; Univ Mendeliana Brunensis; Fac
   Silviculturae \& Technol Ligni},
Abstract = {Hedgerows are multipurpose elements of woody vegetation in the landscape
   and represent one of its important parts. This shrubby linear vegetation
   is traditional mostly in England, however it is quite common in other
   European countries too. In the landscape of the Czech Republic there was
   a lot of scattered vegetation in past. Unfortunately, because of
   collectivization of agriculture these elements of vegetation were
   devastated. Hedgerows are appropriate for the restoration of scattered
   vegetation in our countryside thanks to its multi-functional character.
   They can contribute to better conditions for the life of animals and
   people. In this paper there are functions of hedgerows in the landscape
   described in more detail.},
