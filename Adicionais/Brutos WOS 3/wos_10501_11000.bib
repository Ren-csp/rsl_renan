@article{ WOS:A1994NZ95600019,
Author = {CHITTKA, L and SHMIDA, A and TROJE, N and MENZEL, R},
Title = {ULTRAVIOLET AS A COMPONENT OF FLOWER REFLECTIONS, AND THE
   COLOR-PERCEPTION OF HYMENOPTERA},
Journal = {VISION RESEARCH},
Year = {1994},
Volume = {34},
Number = {11},
