@article{ WOS:000454508700135,
Author = {Rumanta, Maman},
Title = {Effectiveness of Online Learning Tutorials Viewed from the Students
   Perspective: Case Study on Biology Education Program of Universitas
   Terbuka},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {11},
Pages = {8418-8421},
Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {This study aims to determine how effective the implementation of online
   learning tutorials (OLT) in Biology Education program of Universitas
   Terbuka (Open University Indonesia), viewed from perception of the
   participants. This research uses quantitative descriptive method.
   Research subjects were students who actively participated in the OLT and
   instruments used in this research are questionnaires and interview
   guidelines. Data collected is processed through quantitative descriptive
   technique. The results showed that in general OLT participants were able
   to access the tutorial class and open the initiation materials well,
   although some of the tutorial initiation materials are still less
   relevant to the needs. The participants can generally access discussion
   forum and discuss with tutors without any significant constraints.
   Tutorial assignment are easy to access and work on, but the tutorial
   feedback from tutor is still less fast as students hope. The open
   education resources (OER) material presented by the tutor is easily
   accessible and understood. The OLT generally can help students to
   understand learning materials, but not always for final exam
   preparation. It can be concluded that students of OLT of Biology
   Education program of Universitas Terbuka are quite effective.
   Nevertheless, there are still have weaknesses in the implementation of
   the OLT, such as the presence of initiation materials that are less in
   line with the needs of students, difficulty in consultation with OLT
   tutors, and tutorial feedback from the tutors are still less quickly
   than they expected.},
