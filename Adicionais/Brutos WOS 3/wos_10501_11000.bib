Note = {International Joint Conference on Neural Networks, Montreal, CANADA, JUL
   31-AUG 04, 2005},
Organization = {IEEE Computat Intelligence Soc; Int Neural Networks Soc},
Abstract = {Mesoscopic patterns of neural activity were sought in multichannel EEGs
   of rabbits that were trained to respond to conditioned stimuli (CSs) in
   visual, auditory and somatic modalities. Spatiotemporal patterns were
   sought of oscillations in the beta and gamma ranges. The techniques
   required for preprocessing EEGs in search of global patterns were
   diametrically opposed to those needed for localization of modular EEG
   signals. Frames were found in the form of intermittent spatial patterns
   of phase and amplitude modulation (AM and PM) of carrier waves in beta
   and gamma ranges that served to classify EEG frames with respect to CSs.
   A model based on the intentional action-perception cycle is proposed to
   complement the information processing model. (c) 2005 Elsevier Ltd. All
   rights reserved.},
