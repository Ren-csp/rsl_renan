Title = {INCORPORATION OF EMOTIONAL LABOR IN THE DEMAND-CONTROL-SUPPORT MODEL:
   THE RELATION WITH EMOTIONAL EXHAUSTION AND PERSONAL ACCOMPLISHMENT IN
   NURSES},
Booktitle = {FUNCTIONALITY, INTENTIONALITY AND MORALITY},
