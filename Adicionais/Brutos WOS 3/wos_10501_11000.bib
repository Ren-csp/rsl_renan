Title = {Happiness and willingness to pay mark - the incentive for businesses to
   establish green policy},
Booktitle = {TOWARDS A RESPONSIBLE SUCCESS: CORPORATE SOCIAL RESPONSIBILITY AND
   ENVIRONMENTAL MANAGEMENT},
Year = {2007},
Pages = {3+},
Note = {Euro-Asian Conference on Environment and Corporate Social Responsibility
   - Perspectives from Business in Asia, Hong Kong, PEOPLES R CHINA, NOV
   17, 2006},
Organization = {TU Bergakademie Freiberg; Hong Kong Univ, Ctr Urban Planning \& Environm
   Management; German Acad Exchange Serv Fdn; German Ind \& Commerce; Off
   European Commiss Hong Kong \& Macao; CSR Asia},
Abstract = {Corporate social responsibility (CSR) has been one of the important
   tools to enhance business to participate in the protection of
   environment. From the point of view of economists, we are interest in
   understanding the profit incentive for business to establish ``Green{''}
   CSR policy. As a matter of fact, customer's willingness to pay (WTP) and
   happiness towards green concept product mark the profit incentive for
   corporations to enhance green CRS policy. In this paper we investigate
   the determinants of WTP of the general public for a product with green
   concept and the determinants of the happiness of the general public when
   they receive a gift with green concept. Using data from a survey
   conducted in April 2006 with 929 randomly selected citizens in Hong-Kong
   we find the following situation. 1) An individual's WTP for a product
   with green concept is positively correlated with individual's level of
   education and individual's perception on efforts of the SAR government
   to protect the environment. 2) The happiness of the general public when
   they receive a gift with green concept is positively correlated with
   individual's WTP for product with green concept, individual's
   environmental awareness, and individual's concern about pollution and
   individual's age.},
