@inproceedings{ WOS:000224176300011,
Author = {Sittiprapaporn, W and Chindaduangratn, C and Kotchabhakdi, N},
Book-Group-Author = {Kasetsart Univ},
Title = {Functional specialization of the human auditory cortex in processing of
   speech prosody: A low resolution electromagnetic tomography (LORETA)
   study (in Thai)},
Booktitle = {PROCEEDINGS OF 42ND KASETSART UNIVERSITY ANNUAL CONFERENCE},
Year = {2004},
Pages = {91-99},
Note = {42nd Kasetsart-University Annual Conference, THAILAND, FEB 03-06, 2004},
Organization = {Kasetsart Univ; Commiss Higher Educ; Minist Educ; Minist Agr \&
   Cooperat; Minist Sci \& Technol; Minist Nat Resources \& Envirnom;
   Minist Informat Commun Technol; Natl Res Council Thailand; Thailand Res
   Fund},
Abstract = {The goal of the present study was to estimate the electric sources
   contributing to the scalp recorded auditory mismatch negativities (MMNs)
   by means of low-resolution electromagnetic tomography (LORETA) of speech
   prosody in tonal language. For this purpose, the MMNs were elicited by
   monosyllabic word in tonal languages. The results suggest that the left
   inferior frontal gyrus (Brodmann's area 44/45: x, y, z = -52, 24, 22)
   was predominant in the perception of prosody of native speech sounds,
   whereas the prosody of the non-native speech sound was dominated by the
   right inferior frontal gyrus (Brodmann's area 44: x, y, z = 25, 17, 43),
   which may be explained by the specialization in processing the prosodic
   and emotional components of speech formed in this cortex.},
