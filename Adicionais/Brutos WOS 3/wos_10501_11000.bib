@article{ WOS:000435943400034,
Author = {Ni, Zhi-Zhen and Luo, Kun and Gao, Yang and Gao, Xiang and Fan, Jian-Ren
   and Cen, Ke-Fa},
Title = {Potential Air Quality Improvements from Ultralow Emissions at Coal-fired
   Power Plants in China},
