@article{ WOS:000175603500018,
Author = {Harremoes, P},
Title = {Water ethics - a substitute for over-regulation of a scarce resource},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {45},
Number = {8},
