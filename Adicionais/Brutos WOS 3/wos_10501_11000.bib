@inproceedings{ WOS:000659867303080,
Author = {Khlyzova, Irina and Illarionova, Lyudmila and Khromenkov, Peter},
Editor = {Rudoy, D and Olshevskaya, A and Kankhva, V},
Title = {Patriotic education of future teachers in a university},
Booktitle = {INNOVATIVE TECHNOLOGIES IN SCIENCE AND EDUCATION (ITSE-2020)},
