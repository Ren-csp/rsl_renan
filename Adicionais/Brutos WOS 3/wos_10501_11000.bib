@article{ WOS:A1996UP69600057,
Author = {Bobes, MA and Olivares, E and ValdesSosa, M},
Title = {Effects of stimulus repetition on ERPs associated to feature mismatch
   during face perception},
Journal = {BRAIN AND COGNITION},
Year = {1996},
Volume = {30},
Number = {3},
Pages = {372-376},
Month = {APR},
Note = {TENNET VI - Theoretical and Experimental Neuropsychology Conference,
   MONTREAL, CANADA, MAY 10-14, 1995},
Abstract = {In our face-feature matching task a face without the eye/eyebrow region
   is first presented as context and then completed with either the
   original features or with those from another face. Face-feature
   mismatches are associated with an enhanced ERP component (N374). Here we
   explore the influence of stimulus repetition on N374. Faces were
   repeated eight times, four as matches and the other four as mismatches.
   Repetition did not affect the amplitude of N374. This suggests that this
   component is different from previously reported negativities that were
   reduced by face repetition. Since N374 is apparently triggered by
   mismatches at the face structural level, independently of other types of
   face-related knowledge, this component may be useful in examining covert
   face recognition in prosopagnosia. The repetition of a small set of
   faces can facilitate the use of our task in a clinical setting.},
Publisher = {ACADEMIC PRESS INC JNL-COMP SUBSCRIPTIONS},
