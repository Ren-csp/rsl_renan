@inproceedings{ WOS:000391720100055,
Author = {Mohar, Abg Hamizam Abg and Abdullah, Firdaus and Ho, Voon Boo},
Editor = {Voon, BH and Hamali, J and Abdullah, F and Joseph, C and Leong, SH and Lau, UH and Chung, ESM and Ng, KC and Teo, AK},
Title = {Development and Validations of a Holistic Service Operations Management
   Instrument},
Booktitle = {IRSSM-6: THE 6TH INTERNATIONAL RESEARCH SYMPOSIUM IN SERVICE MANAGEMENT
   - SERVICE IMPERATIVES IN THE NEW ECONOMY: SERVICE EXCELLENCE FOR
   SUSTAINABILITY},
Series = {Procedia Social and Behavioral Sciences},
Year = {2016},
Volume = {224},
Pages = {429-436},
Note = {6th International Research Symposium on Service Management (IRSSM),
   Kuching, MALAYSIA, AUG 11-15, 2015},
Organization = {Univ Teknologi MARA},
Abstract = {Studies in manufacturing areas have empirically indicated that good
   operational practices have led to superior operational performances.
   However, these studies have been overshadowed by manufacturing based
   management practices rather than services. In service operations
   management studies, over emphasis is being placed on service quality
   which is based on the customer's perceptions and expectations. Thus,
   there is a need to re-evaluate the approach towards the understanding of
   service operations management as a mechanism in achieving competitive
   advantage. To fill the void, this study is carried out in a service
   setting and is seen from the perspective of the service operations
   manager. The approach used in the study is both qualitative and
   quantitative. The procedures employed revealed six factors that are
   critical for the establishment of a holistic service operations
   management. Correlations analyses showed relatively strong relationship
   within the factors. Further unidimensionality, reliability and validity
   analysis concluded that the factors model fit well and represents a
   reasonably close approximation in the population. The study offers a
   systematic approach framework for the empirical understanding of
   operations management in a service setting. (C) 2016 The Authors.
   Published by Elsevier Ltd.},
