@article{ WOS:000508554700016,
Author = {Fiorentino, Carmine and Mancini, Maurizio},
Title = {NITROGEN AND Escherichia coli REMOVAL IN FACULTATIVE FINISHING
   LAGOONS RECEIVING TREATED URBAN WASTEWATER},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2019},
