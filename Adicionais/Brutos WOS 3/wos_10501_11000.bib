@article{ WOS:000383113900065,
Author = {Awang, Ahmad Azran and Lokman, Anitawati Mohd and Fathir, Mohd Firdauz
   Mohd and Salleh, Shahnon Mohamed},
Title = {A Semantic Analysis of Malaysia's Patriotic Songs},
Journal = {ADVANCED SCIENCE LETTERS},
