@inproceedings{ WOS:000614057600018,
Author = {Cibrian, Franceli L. and Mercado, Jose and Escobedo, Lizbeth and
   Tentori, Monica},
Book-Group-Author = {ACM},
Title = {A Step towards Identifying the Sound Preferences of Children with Autism},
Booktitle = {PROCEEDINGS OF THE 12TH EAI INTERNATIONAL CONFERENCE ON PERVASIVE
   COMPUTING TECHNOLOGIES FOR HEALTHCARE (PERVASIVEHEALTH 2018)},
