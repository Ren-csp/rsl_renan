@inproceedings{ WOS:000346067900127,
Author = {Papavasileiou, V. and Xanthakou, P. and Tzaberis, N. and Matzanos, D.
   and Papadomarkakis, I. and Nikolarea, E.},
Editor = {Lekkas, TD},
Title = {NATURAL RESOURCES MANAGEMENT AND SUSTAINABLE DEVELOPMENT},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {This paper refers to the sustainable management of natural resources and
   aims to explore knowledge, perceptions and attitudes of senior high
   school students of the island of Rhodes (Greece) within the framework of
   education for sustainable development (Jickling, 2000; Huckle, 2004;
   Brunel, 2007). The 2nd grade of senior high school students of the
   island of Rhodes (Greece) was taken as survey sample. The choice was
   made based on the premise that this particular group completes their
   curricular activities on environmental issues. While the survey was
   being carried out, the case study was chosen as the basic methodology
   and the questionnaire as the methodological tool (Cohen et al., 2008;
   Robinson, 2010). Consisting of 26 main questions, the final
   questionnaire was distributed to 208 students - of whom 112 were girls
   and 96 were boys - from April to May 2011.
   The data analysis shows that the survey respondents do not have adequate
   knowledge of the pillars of Sustainable Development, since they seem to
   ignore that the environment, society and economy are three
   interdependent systems, whose good operation is an essential
   prerequisite so that sustainability is achieved. It is also noted that
   the respondents have had inadequate knowledge of the concept sustainable
   development. The data derived from the students' attitude towards energy
   saving and natural resources management show that the majority does not
   have a positive attitude towards turning the lights off when leaving the
   room. Moreover, when it comes to save energy by shutting the computer
   off during the break, it is shown that most respondents leave the
   computer on. Whereas when it comes to preference of low-energy bulbs to
   any other kind of bulbs, the majority of the respondents do not adopt
   this attitude. Yet, when it comes to the protection of the environment
   from air-pollution by using public transportation means, the sample's
   attitude reveals that the majority does not support the protection of
   the environment from the air-pollution in this way. Concerning water
   saving, whenever they brush their teeth and whether they choose to have
   a bath or a shower, the data analysis reveals an antithesis: whereas the
   students do not hesitate to leave the water to run while brushing their
   teeth, they prefer taking a shower to having a bath in order to save
   water. As far as the meaning and dimensions of Sustainable Development
   are concerned, lack of adequate knowledge comes out of data analysis.
   Regarding perceptions, it is shown that the majority of the sample
   either has inadequate knowledge or wrong understanding of energy saving
   issues and natural resources management. According to their statements
   about attitudes, the students, as shown in their daily habits, do not
   adopt any sustainable practices. Therefore, it is conspicuous that they
   fail to realize the need to secure natural resources. Based on these
   findings, carrying out similar surveys on a larger scale is considered
   essential to record the situation better, draw some generalizations and
   reach some conclusions.},
