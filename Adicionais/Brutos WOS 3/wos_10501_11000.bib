@article{ WOS:000169404000004,
Author = {Lenschow, P and Abraham, HJ and Kutzner, K and Lutz, M and Preuss, JD
   and Reichenbächer, W},
Title = {Some ideas about the sources of PM10},
Journal = {ATMOSPHERIC ENVIRONMENT},
