Note = {28th Annual Meeting of the Association-for-Behavior-Analysis, TORONTO,
   CANADA, MAY, 2002},
Organization = {Assoc Behav Anal},
Abstract = {The effects of methylphenidate (MPH) on performance of a time-production
   task were studied in 17 children with attention-deficit/hyperactivity
   disorder who participated in 1 test session on and 1 off MPH.
   Participants held a response lever down for at least 10 but no longer
   than 14 s. Administration of MPH had no effect on the number of correct
   responses or on the mean duration of lever holds. MPH administration
   significantly decreased timing response variability, increased holds of
   10- to 11-s duration, and decreased lever holds of extremely short
   durations. These results indicate that administration of MPH resulted in
   more precise timing performance without changing the mean duration of
   lever holds, suggesting an enhancement in working memory.},
