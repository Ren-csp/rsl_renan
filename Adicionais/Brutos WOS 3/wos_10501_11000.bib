@inproceedings{ WOS:000291345800057,
Author = {Albert, I. and Michels, T. and Ferring, D.},
Editor = {Zukauskiene, R},
Title = {Patterns of intergenerational support and reciprocity},
Booktitle = {XIV EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY (ECDP)},
Year = {2010},
Pages = {327-331},
Note = {14th European Conference on Developmental Psychology (ECDP), Mykolas
   Romeris Univ, Vilnius, LITHUANIA, AUG 18-22, 2009},
Abstract = {Referring to theoretical models of intergenerational solidarity, this
   study aims to examine reciprocity of intergenerational support using a
   standardized questionnaire in a sample of N=51 Luxembourgish and
   Portuguese mother-daughter-dyads living in Luxembourg. Patterns of
   instrumental support were identified and an indirect measure of
   reciprocity was applied to analyse links between reciprocity and
   affection as well as the role of family values. Analyses showed
   differences in patterns of intergenerational instrumental support in
   Luxembourgish and Portuguese families. Similarities were found in the
   link between reciprocity and affection: the more daughters and mothers
   were underbenefitting, the less they felt emotionally close to each
   other; this effect was however buffered by adherence to family values in
   the mothers' sample.},
