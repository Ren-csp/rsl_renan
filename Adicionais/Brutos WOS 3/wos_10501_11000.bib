Title = {Visual-vestibular and visuovisual cortical interaction -: New insights
   from fMRI and PET},
Booktitle = {NEUROBIOLOGY OF EYE MOVEMENTS: FROM MOLECULES TO BEHAVIOR},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2002},
