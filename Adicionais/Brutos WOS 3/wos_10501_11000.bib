@article{ WOS:000181559200004,
Author = {Grainger, J},
Title = {`People are living in the park'. Linking biodiversity conservation to
   community development in the Middle East region: a case study from the
   Saint Katherine Protectorate, Southern Sinai},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {2003},
Volume = {54},
Number = {1},
Pages = {29-38},
