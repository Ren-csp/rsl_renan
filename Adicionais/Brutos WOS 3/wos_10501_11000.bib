@article{ WOS:000230593000003,
Author = {Kii, M and Doi, K},
Title = {Multiagent land-use and transport model for the policy evaluation of a
   compact city},
Journal = {ENVIRONMENT AND PLANNING B-PLANNING \& DESIGN},
