@inproceedings{ WOS:001728145300019,
Author = {Sadabad, Mo Maleki and Tahmasseby, Shahram and Salam, Salwa and Watts,
   Greg},
Editor = {Mohammad, P and Shahfahad and Comino, JR and Matamanda, AR},
Title = {Integrating Passivhaus Standards into Smart City Development in the UK:
   An Assessment of Energy Efficiency and Policy Implications},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
Pages = {207-221},
Note = {2024 International Conference on Geographic Perspectives on Climate
   Change Mitigation in Urban and Rural Environments-GCUE, Lecce, ITALY,
   JUN 25-27, 2024},
Organization = {University of Salento},
Abstract = {Concerns about building energy conservation are rising, especially in
   the UK, where residential buildings contribute significantly to CO2
   emissions. The Passivhaus Standard has become a focal point,
   prioritizing minimal heating energy use, indoor comfort, and superior
   air quality. However, integrating Passivhaus principles into smart city
   development faces policy challenges that require alignment, incentives,
   and regulatory support. While information and communication technology
   (ICT) is crucial, obstacles remain in incorporating high-efficiency
   standards into existing urban infrastructure. This highlights the
   importance of Passivhaus in creating a sustainable housing future. This
   article explores the evolution of UK policies regarding building energy
   conservation, presenting a systematic literature review on the
   integration of Passivhaus within UK smart city development. It
   highlights energy efficiency, policy implications, and challenges
   related to urban density and heritage conservation. The study emphasizes
   the importance of community engagement and stakeholder collaboration for
   successful Passivhaus implementation, advocating for a context-sensitive
   approach that includes educating residents and involving them in
   planning. Additionally, it identifies a promising synergy between smart
   city technologies and Passivhaus principles, aiming for more livable
   urban spaces. The research provides actionable management guidance for
   urban development stakeholders, stressing the need for strategic
   incorporation of Passivhaus Standards to achieve sustainable urban
   futures.},
