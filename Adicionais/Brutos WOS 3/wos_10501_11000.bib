@inproceedings{ WOS:000467120500025,
Author = {Prestwood, Emily and Calvert, Thomas and Clayton, William and Longhurst,
   James and Manchester, Helen and Parkhurst, Graham and Rosenberg, Ges and
   Taylor, Colin and Townsend, Ian},
Editor = {Brebbia, CA and Longhurst, J and Marco, E and Booth, C},
Title = {BARRIERS TO A BETTER BRISTOL: DIAGNOSING CITY STRATEGIC SUSTAINABILITY
   CHALLENGES USING SYSTEMS, CO-PRODUCTION AND INTERDISCIPLINARY APPROACHES},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
