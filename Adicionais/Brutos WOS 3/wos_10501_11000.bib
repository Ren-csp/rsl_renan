Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {The trends of independent employment nowadays have increase the number
   of young entrepreneurs in Malaysia thus requires an extensive study on
   the necessary competencies to become successful and competitive within
   the business environment. Various studies claimed that social competency
   is the key elements towards a successful entrepreneurial creation
   specifically social competency. This paper examine the effect of social
   competency among ``young{''} Malaysian entrepreneurs as the recent
   trends are showing that this generation are prone to independent
   ownership employment rather than being employed by others. Elements
   within the social competency are social perception, social adaptability
   and expressiveness and the effects of entrepreneurs' firm performance as
   the measurement of successful entrepreneurs. Respondents from this study
   which consists of Generation Y (young) entrepreneurs were derived for
   this study. Findings had shown that only social adaptability has a
   positive relationship with SMEs performances.},
