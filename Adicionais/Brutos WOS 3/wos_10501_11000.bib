   RESOURCE FOR ECONOMIC DEVELOPMENT IN VIENNA, AUSTRIA},
Booktitle = {PROCEEDINGS OF THE 50TH ISOCARP CONGRESS: URBAN TRANSFORMATIONS: CITIES
   AND WATER},
Year = {2014},
Pages = {705-715},
Note = {50th ISOCARP Congress, Gdynia, POLAND, SEP 23-26, 2014},
Organization = {ISOCARP},
Abstract = {The Wien River flows through densely populated districts, the former
   landscape has become a highway with parallel land resources for
   buildings and open space. The river and its embankments have
   deteriorated into a backside with low property values and limited
   economic acivities. The strategy for stimulating economic development
   and tourism is on one hand to find a specific suitable approach for each
   of the six different sections of the river and on the other hand to
   create a potential linkage of monuments in the Wien River Valley with a
   ``cultural axis{''} and an open space network along the river that would
   renew its identity and strengthen its image.},
