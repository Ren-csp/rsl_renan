
@inproceedings{ WOS:000179444800063,
Author = {Oni, SI},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Preventing housing disasters in megacities: Case of Lagos, Nigeria},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {489-497},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {In pursuit of development, the Lagos megalopolitan environment has been
   pressurized and strained beyond endurance, thus causing disasters. The
   indiscriminate utilization of houses at the cost of rebuilding and
   renewing capacities has become perilous to her existence and survival.
   It is therefore necessary to preserve and conserve housing processes in
   megacities so as to prevent disasters.
   This paper examines the problems, effects, preventive measures and
   sustainable solutions to housing disasters in megacities. Lagos has been
   chosen as case study. In Lagos manmade disasters frequently occur and
   they are avoidable. The hazards and damage to lives and properties
   caused by them can be minimized by improved methods of assessment,
   planning and management, as well as reassessment and exchange of ideas,
   programmes and policies related to disaster prevention and preparation
   of framework of action plan at different level. These must be integrated
   and coordinated.
   This paper shows the impact of housing disaster on society as a direct
   consequence of increasing population density and urban growth and partly
   as an indirect environmental consequence of this trend. The paper
   further espouses and advocates for adequate monitoring for early
   warnings and surveying, adequate guide for physical planning,
   appropriate action for reducing disaster susceptibility and
   vulnerability. Finally, the paper suggests certain sustainable
   strategies such as awareness creation and political will development at
   preventing housing disasters.},
