@inproceedings{ WOS:000179249200017,
Author = {McCormick, AR},
Editor = {Brebbia, CA and MartinDuque, JF and Wadhwa, LC},
Title = {Design for sustainability in the Hill Road Corridor precinct, Millennium
   Parklands, Homebush Bay, Sydney, Australia},
