   Kemal and Zayim, Nese and Sen Kaya, Semiha},
Editor = {Lovis, C and Seroussi, B and Hasman, A and PapeHaugaard, L and Saka, O and Andersen, SK},
Title = {Evaluation of the Usability of a Serious Game Aiming to Teach Facial
   Expressions to Schizophrenic Patients},
Booktitle = {E-HEALTH - FOR CONTINUITY OF CARE},
Series = {Studies in Health Technology and Informatics},
Year = {2014},
