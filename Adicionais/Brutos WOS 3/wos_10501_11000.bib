@inproceedings{ WOS:000461379100002,
Author = {Dlamini, S. Q. and Simatele, D.},
Editor = {Brebbia, CA and Itoh, H},
Title = {Unrecognised informal solid waste recycling in an emerging African
   megacity: a study of Johannesburg, South Africa},
Booktitle = {WASTE MANAGEMENT AND THE ENVIRONMENT VIII},
