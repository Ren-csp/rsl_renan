@inproceedings{ WOS:000078706300090,
Author = {Hosokawa, M and Gunji, A and Shinoda, H and Ozaki, H},
Editor = {Hashimoto, I and Kakigi, R},
Title = {Topographic change of ERP evoked by the human CV syllable with vowel of
   varied duration},
Booktitle = {RECENT ADVANCES IN HUMAN NEUROPHYSIOLOGY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1998},
Volume = {1162},
Pages = {619-623},
Note = {6th International Evoked Potentials Symposium (6th IEPS), OKAZAKI,
   JAPAN, MAR 21-25, 1998},
Organization = {Minist Educ Sci Culture \& Sports Japan; Okazaki Natl Res Inst; Natl
   Inst Physiol Sci; Pharmaceut Manufacturers Assoc Tokyo; Osaka Pharmaceut
   Manufacturers Assoc},
Abstract = {Categorical processing of human speech sound was examined by ERP
   topography. The subjects were 10 right-handed young males. Human
   consonant-vowel (CV) syllables (/na/, /ma/, /ra/) were delivered to the
   subjects while they were sitting in the soundproof darkroom. Reducing
   the vowel part of each CV syllable, nine different sounds with various
   length of vowel were used for the stimuli. ERPs were recorded from 16
   locations on the scalp. In every stimulus condition, a negative
   component around 180 ms after the stimulus onset was observed at the
   anterior part of the brain. According to the elongation of the vowel
   part, this anterior negativity was broken into two peaks. Since the
   second peak of anterior negativity appeared at 100 ms after the onset of
   the vowel part of the stimulus, this second anterior negativity may be
   evoked by a fraction of the vowel itself. Vertex positive components
   around 250 ms after stimulus onset were also observed. This positivity
   was localized to the vertex area when a CV syllable with a short vowel
   was delivered. According to the elongation of the vowel part, the most
   dominant location of this positivity shifted from the Vertex to the
   front-central area. As the hearing accuracy was highly correlated with
   ERP amplitude at Cz, this positive component might determine the
   categorical perception of the CV syllable.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
