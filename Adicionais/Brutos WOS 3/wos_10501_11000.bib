@inproceedings{ WOS:000341912500018,
Author = {Korpela, Mikko and Ikavalko, Pauliina and Luukkonen, Irmeli and
   Martikainen, Susanna and Palmen, Marilla and Tiihonen, Tuija and
   Toivanen, Marika and Vainikainen, Vilma},
Editor = {BeuscartZephir, MC and Jaspers, M and Kuziemsky, C and Nohr, C and Aarts, J},
Title = {How to Co-Develop Services, Work, and Information Systems in Healthcare:
   The Daisy Approach},
Booktitle = {CONTEXT SENSITIVE HEALTH INFORMATICS: HUMAN AND SOCIOTECHNICAL
   APPROACHES},
Series = {Studies in Health Technology and Informatics},
Year = {2013},
Volume = {194},
Pages = {126-132},
Note = {International Conference on Context Sensitive Health Informatics, Human
   and Sociotechnical Approaches, Herlev Hosp, Copenhagen, DENMARK, AUG,
   2013},
Organization = {IMIA Working Grp Human Factors Engn Healthcare Informat Org \& Social
   Issues; Hlth Informat Patient Safety; EFMI WG Human \& Org Factors Med
   Informat},
Abstract = {Information systems in healthcare need to be designed and developed in a
   collaborative way. However, existing collaborative methodologies for the
   parallel development of healthcare work and information systems are
   vague and fragmented. Furthermore, they neither address people-centred
   healthcare nor limited-resource contexts. In this paper we introduce an
   emerging holistic approach, based on a unifying theoretical basis, for
   co-developing the services, work and information systems in healthcare.
   The approach intends to (a) be collaborative in nature; (b) address the
   domains of both healthcare professionals and ordinary people /
   communities; (c) span the main analysis and design tasks of
   socio-technical information systems development from needs assessment
   through requirements setting to functional-architectural solutions; (d)
   be contextually sensitive; and (e) be practicable in ``real life{''}
   beyond research settings.},
Publisher = {IOS PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
