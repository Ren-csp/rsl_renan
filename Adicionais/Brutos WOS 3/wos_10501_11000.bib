Title = {Lyapunov based stability analysis for metro lines},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT Transactions on the Built Environment},
Year = {2008},
Volume = {101},
Pages = {111+},
Note = {14th International Conference on Urban Transport and the Environment in
   the 21st Century, MALTA, 2008},
Organization = {Wessex Inst Technol; WIT Transact Built Environm},
Abstract = {In this work a direct method to measure the stability of metro system
   lines with respect to a previously constructed time schedule is
   presented. For this purpose we first model saturation effects using a
   real time discrete space state representation and then apply a
   Lyapunov-based stability analysis considering time delays of trains as
   disturbances. As a result we have been able to define a new set of
   indexes that relate time delays with the validity of the actual time
   schedule when falling inside a particular `stability area'. Results
   obtained in a simulated environment show that the new stability indexes
   are able to evaluate quantitatively and qualitatively the effects of
   saturation in metro lines as well as predict the need for rescheduling},
