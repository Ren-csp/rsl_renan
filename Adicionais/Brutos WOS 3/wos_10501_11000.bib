@article{ WOS:A1995RM44200054,
Author = {HENRY, EA and DODGEMURPHY, LJ and BIGHAM, GN and KLEIN, SM},
Title = {MODELING THE TRANSPORT AND FATE OF MERCURY IN AN URBAN LAKE (ONONDAGA
   LAKE, NY)},
Journal = {WATER AIR AND SOIL POLLUTION},
Year = {1995},
Volume = {80},
Number = {1-4},
Pages = {489-498},
