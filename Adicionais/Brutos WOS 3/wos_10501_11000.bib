@inproceedings{ WOS:000078270700012,
Author = {McMahan, LR},
Editor = {Kaye, TN and Liston, A and Love, RM and Luoma, DL and Meinke, RJ and Wilson, MV},
Title = {Restoration in the new world order: Science, politics, esthetics,
   arrogance, and public perception},
Booktitle = {CONSERVATION AND MANAGEMENT OF NATIVE PLANTS AND FUNGI},
Year = {1997},
Pages = {72-77},
Note = {Oregon Conference on the Conservation and Management of Native Vascular
   Plants, Bryophytes, and Fungi, OREGON STATE UNIV, CORVALLIS, OR, NOV
   15-17, 1995},
Organization = {Native Plant Soc Oregon; Oregon Dept Agr; Oregon State Univ, Dept Bot \&
   Plant Pathol; USDI Bur Land Management, Oregon State Off},
Abstract = {The world is changing rapidly; as one commentator has noted, we are
   ``living in an explosion.{''} Within this explosion we deal with a
   myriad of pressures affecting our decisions and actions. To survive and
   triumph amid rapid change and in an uncertain future, we must rely on
   practical plans, instinct, and good common sense, and be willing to
   challenge even our most firmly-held notions. In this paper, I will
   explore these challenges and suggest some possible solutions as they
   relate to the down-to-earth basics of habitat and species restoration.
   Specific ideas for exploration are 1) the concept of ``man over
   nature,{''} perhaps leading to the preference of active restorations
   over passive recovery and arrogant, human-centered views and activities:
   2) the desire for genetic purity in a less than pure world; and 3)
   restoration as the intersection of art and science. My goal is to
   challenge the reader to examine precepts of restoration and choose paths
   leading to long-term success, as defined in the ever-changing world
   around us.},
