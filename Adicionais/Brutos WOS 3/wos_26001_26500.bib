@article{ WOS:000221736800002,
Author = {Kim-Cohen, J and Moffitt, TE and Caspi, A and Taylor, A},
Title = {Genetic and environmental processes in young children's resilience and
   vulnerability to socioeconomic deprivation},
Journal = {CHILD DEVELOPMENT},
Year = {2004},
Volume = {75},
