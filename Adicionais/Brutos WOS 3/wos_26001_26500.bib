@article{ WOS:000252588200007,
Author = {Bolognini, Nadia and Leo, Fabrizio and Passamonti, Claudia and Stein,
   Barry E. and Ladavas, Elisabetta},
Title = {Multisensory-mediated auditory localization},
Journal = {PERCEPTION},
Year = {2007},
