Note = {9th Asian Aerosol Conference (AAC), Kanazawa, JAPAN, JUN 24-27, 2015},
Organization = {Japan Assoc Aerosol Sci \& Technol},
Abstract = {This paper presents chemical characteristics of diesel particulate
   matter (DPM). A heavy-duty diesel engine was tested in ETC cycle with an
   engine dynamometer. The DPM was sampled with quartz fiber membrane and
   organic membrane filter. Quartz fiber membrane was used for total carbon
   (TC) and particle-phase PAHs (p-PAHs) measurement, while the organic
   membrane was used for inorganic elements measurement. On the quartz
   fiber membrane, the total of 15 elements detected were 11\% of DPM mass.
   Ca, Si, Na and Al were the major components, accounted for 79\% of the
   15 elements mass. On the organic membrane, total carbon (elemental
   carbon + organic carbon) was 90\% of total DPM mass. Three-ring p-PAHs
   were the major components (66\%) of total p-PAHs mass followed by
   four-ring (18\%) and two-ring (16\%). The FLT/(FLT + PYR) ratio was
   0.62, indicative of diesel vehicle emissions.},
