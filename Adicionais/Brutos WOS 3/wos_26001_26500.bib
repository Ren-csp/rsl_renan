@inproceedings{ WOS:000299096402088,
Author = {Liu, Jianwei and Ma, Wenlin},
Editor = {Zhou, X},
Title = {RETRACTED: Odor and VOCs Removal in Wastewater Treatment Plant by a
   Two-stage Biofilter (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
