@inproceedings{ WOS:000174596000012,
Author = {Gatev, P},
Editor = {Dengler, R and Kossev, AR},
Title = {Sensorimotor adaptation of quiet stance to the support and sensory
   constraints},
Booktitle = {SENSORIMOTOR CONTROL},
Series = {NATO SCIENCE SERIES, SUB-SERIES I: LIFE AND BEHAVIOURAL SCIENCES},
Year = {2001},
Volume = {326},
Pages = {103-111},
Note = {NATO Advanced Research Workshop on Sensorimotor Control, VARNA,
   BULGARIA, OCT 12-14, 2000},
Organization = {NATO},
Abstract = {We discussed differences between sensory and motor aspects of
   sensorimotor postural strategy (PS). While the motor part of PS is
   reasonably hierarchically organized, the sensory part of PS is
   heterarchically (shared) organized, that obviously increases its
   adaptivity and appropriateness to the support and sensory constraints.
   Further, we illustrated the complexity of postural behavior of quiet
   standing with different stance width, absence of vision and deteriorated
   sensory input by a head extension. The results are indicating effective
   connection between ankle-hip proprioception and vision for the postural
   control of mediolateral equilibrium while the sensory conflict
   introduced by head extension has no effect on it, Anteroposterior
   equilibrium was influenced by all three factors acting independently.
   The multiple linear regression model based on the data of another study
   revealed that the standard deviation of linear motion of the body
   center-of-gravity (COG) in sagittal and frontal planes during normal and
   narrow standing with eyes-open and eyes-closed might be predicted
   successfully by four main predictors. In both planes, the increased
   ankle angle angular motion predicted increased COG motion and the
   increased correlation between the EMG activity of lateral gastrocnemius
   muscle and the anteroposterior motion of the COG predicted a decreased
   COG motion. The increase of correlation between linear motion of the
   knee and shoulder points led to increased COG motion in frontal plane
   and decreased COG motion in sagittal plane. Postural alignment with COG
   more forward led to decreased COG motion in sagittal plane while the
   increased hip angle in frontal plane predicted diminution of COG motion
   in frontal plane.
   Studies of quiet stance suggest somewhat separate PSs of quiet stance
   for the anteroposterior and mediolateral equilibria with an interaction
   and trade-off between them. They suggested also an active exploratory
   and direct nature of perception using all intrinsic and extrinsic
   resources available.},
