@inproceedings{ WOS:A1993BZ68P00073,
Author = {BELLIVEAU, JW},
Editor = {Uemura, K and Lassen, NA and Jones, T and Kanno, I and Hatazawa, J and Miura, S and Murakami, M and Iida, H and Fujita, H and Inugami, A},
Title = {MRI TECHNIQUES FOR FUNCTIONAL MAPPING OF THE HUMAN BRAIN - INTEGRATION
   WITH PET, EEG/MEG AND INFRARED-SPECTROSCOPY},
Booktitle = {QUANTIFICATION OF BRAIN FUNCTION: TRACER KINETICS AND IMAGE ANALYSIS IN
   BRAIN PET},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1993},
Volume = {1030},
Pages = {639-667},
Note = {International Symposium on Quantification of Brain Function (Brain PET
   93 Akita), AKITA, JAPAN, MAY 29-31, 1993},
Organization = {JAPANESE SOC CEREBRAL BLOOD FLOW \& METAB; JAPANESE SOC NUCL MED; JAPAN
   BRAIN FDN; AKITA PREFECTURE; AKITA CITY; AKITA PREFECTURE CEREBROVASC
   MED FDN; AKITA RES INST BRAIN \& BLOOD VESSELS; KEITOKUKAI FIJIWARA MEM
   HOSP; SEIRANKAI HONJOH DAIICHI HOSP},
Abstract = {Magnetic Resonance Imaging (MRI) studies of human brain activity are
   described. Task induced changes in brain cognitive state were measured
   using high speed MRI techniques that are sensitive to changes in
   cerebral blood volume (CBV), blood flow (CBF), and blood oxygenation.
   These techniques were used to generate the first functional MRI (fMRI)
   maps of human task activation, by using a visual stimulus paradigm. Time
   resolved fMRI mapping of human visual (V1, V5), motor (M1),
   somatosensory (S1), and auditory (Al) cortex during task activation has
   been demonstrated at a temporal resolution of seconds, and a spatial
   resolution of millimeters. The methodology of MRI brain mapping is
   presented, illustrated by results from the investigation of the
   functional organization and frequency response of human primary visual
   cortex (V1). Clinical applications, including cerebral ischemia,
   neoplasm, and presurgical planning, are discussed.
   Data from other imaging modalities can be combined into a
   multidimensional data base of structure and function, by means of
   precise registration to 3D anatomic MRI data. The use of standardized
   protocols permits direct comparison of MRI results to other available
   measures of hemodynamics, oxygen utilization, hemoglobin oxygenation,
   neuronal activation, and neuronal metabolism. Near infrared spectroscopy
   (NIR) has been used to investigate the physiology underlying the
   observed MRI signal changes and provides an independent real time
   analysis of the hemodynamic response frequency characteristics.
   Unfortunately, the temporal pattern of neuronal activation may not be
   resolvable on the basis of hemodynamic changes alone. We have begun to
   investigate the combined role of MRI and electro- and
   magnetoencephalography (EEG, MEG) for improved source characterization,
   with the hope of measuring the temporal coding of perception and
   cognition. fMRI data can provide a priori source knowledge to be used to
   constrain the electromagnetic forward and inverse problem.},
