@article{ WOS:A1992KA66900121,
Author = {ARORA, S and MINO, T},
Title = {AN EXPERIMENTAL INVESTIGATION OF MECHANISM AND OPERATING-CONDITIONS OF
   MULTISTAGE REVERSING-FLOW BIOREACTOR (MRB) IN TREATING DOMESTIC
   WASTE-WATER},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1992},
Volume = {26},
Number = {9-11},
Pages = {2469-2472},
Note = {16TH BIENNIAL CONF OF THE INTERNATIONAL ASSOC ON WATER POLLUTION
   RESEARCH AND CONTROL, WASHINGTON, DC, MAY 24-30, 1992},
Organization = {INT ASSOC WATER POLLUT RES \& CONTROL},
Abstract = {An experimental investigation of mechanism and operating conditions of
   Multi - Stage Reversing - Flow Bioreactor (MRB) in treating domestic
   wastewater was carried out. Aerobic degradation, dissimilation of Sulfur
   compounds and assimilation of Sulfur microorganisms were the main
   mechanisms involved in COD removal. Methane production was found to be
   negligible. At an upflow velocity of 73 m/d with an organic loading upto
   1.66 kg COD/cum.d, without recycling of wastewater, 85-90 \% COD removal
   efficiency and 15-20 mg/l of effluent SS were observed. However by
   recycling of wastewater same performance was achieved with an upflow
   velocity of 109 m/d and an organic loading of 2.4 kg COD/cum.d. Yield
   coefficient was found to vary between 0.12-0.18.},
