@article{ WOS:000166087600009,
Author = {Clark, AA and Troscianko, T and Campbell, NW and Thomas, BT},
Title = {A comparison between human and machine labelling of image regions},
Journal = {PERCEPTION},
Year = {2000},
Volume = {29},
