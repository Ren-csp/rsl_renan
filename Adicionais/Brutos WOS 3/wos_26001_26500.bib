@inproceedings{ WOS:000351503500113,
Author = {Svec, Vlastimil and Sip, Radim and Kratka, Jana},
Editor = {Vivas, C and Sequeira, P},
Title = {Concept of Knowledge and Research: How to Study Tacit Dimension of
   Knowledge},
Booktitle = {PROCEEDINGS OF THE 15TH EUROPEAN CONFERENCE ON KNOWLEDGE MANAGEMENT
   (ECKM 2014), VOLS 1-3},
Series = {Proceedings of the European Conference on Knowledge Management},
Year = {2014},
Pages = {939-945},
Note = {15th European Conference on Knowledge Management (ECKM), Polytechn Inst
   Santarem, Santarem Sch Management \& Technol, Santarem, PORTUGAL, SEP
   04-05, 2014},
Abstract = {Knowledge is the key term of knowledge management. We routinely operate
   with the term both in the theory and in practice of knowledge
   management. Tacit knowledge is a specific type of knowledge. When we
   first started researching tacit knowledge with managers and later
   trainee teachers five years ago, we realised we are limited by the
   traditional paradigm which understands knowledge in terms of what is
   stored in the human mind. However, is it truly so? Drawing on an
   analysis of still influential, although not always appreciated,
   philosophical schools (especially pragmatism) and some new
   neurobiological findings, we reached an alternative paradigm of
   knowledge. Knowledge is not only information in the human mind but
   everything which contributes to gaining an intended goal of human
   activity. It is therefore something which cannot be normatively defined
   and which is under constant change. If we acknowledge that knowledge is
   shaped and applied in activity, we can also recognise that an acting
   person changes the reality in a so-called ``field of influence{''},
   which consists of the inner environment (information, individual's
   emotions and experience) and the outer environment (spatial,
   organisational, material changes outside of the subject but also changes
   in the actions of individuals with whom the subject interacts).
   Knowledge is therefore something which is formed in the dynamic field of
   influence and has cognitive and emotional extent. However, it is not
   constant; it continually transforms and records itself the individuals
   mind and in the changes in the outer environment caused by his or her
   actions. In the outlined process, a piece of knowledge has an explicit
   form (the individual is aware of it) and a tacit form (the individual is
   either little or not at all aware of it). For this reason, it seems
   appropriate to use the words explicit and tacit dimension of knowledge.
   Thus, what is incommunicable at a given moment (situation) is called
   tacit; however, it really exists and is integral to the individual's
   knowledge structure. Metaphorically speaking, it is the unconscious,
   although important for the knowledge structure, pieces of puzzle. The
   outlined concept of the tacit dimension of knowledge implies qualitative
   research design, involving the following sequence of methods: 1.
   entrance narrative interview revealing the way the individual thinks
   about professional situations of the given type, 2. observation of the
   individual's behaviour (activity) in professional situations, 3.
   in-depth interview with the individual concerning his or her actions and
   taking into account the results of the narrative interview and
   observation, 4. analysis of written self-reflections of the
   participants. The outlined concept of knowledge (its tacit dimension)
   and its research will be illustrated on the example of trainee teachers
   acting in educational, especially unexpected situations.},
