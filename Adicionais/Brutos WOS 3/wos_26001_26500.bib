@article{ WOS:000184651000010,
Author = {Moghaddam, MRA and Guan, Y and Satoh, H and Mino, T},
Title = {Performance and microbial dynamics in the coarse pore filtration
   activated sludge process at different SRTs (solids retention times)},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2003},
