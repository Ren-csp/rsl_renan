@article{ WOS:000252588200003,
Author = {Rowland, Benjamin A. and Stanford, Terrence R. and Stein, Barry E.},
Title = {A model of the neural mechanisms underlying multisensory integration in
   the superior colliculus},
Journal = {PERCEPTION},
Year = {2007},
Volume = {36},
Number = {10},
Pages = {1431-1443},
Note = {7th International Multisensory Research Forum, Univ Dublin, Trinity
   Coll, Dublin, IRELAND, JUN 18-21, 2006},
Abstract = {Much of the information about multisensory integration is derived from
   studies of the cat superior colliculus (SC), a midbrain structure
   involved in orientation behaviors. This integration is apparent in the
   enhanced responses of SC neurons to cross-modal stimuli, responses that
   exceed those to any of the modality-specific component stimuli. The
   simplest model of multisensory integration is one in which the SC neuron
   simply sums its various sensory inputs. However, a number of empirical
   findings reveal the inadequacy of such a model; for example, the finding
   that deactivation of cortico-collicular inputs eliminates the enhanced
   response to a cross-modal stimulus without eliminating responses to the
   modality-specific component stimuli. These and other empirical findings
   inform a computational model that accounts for all of the most
   fundamental aspects of SC multisensory integration. The model is
   presented in two forms: an algebraic form that conveys the essential
   insights, and a compartmental form that represents the neuronal
   computations in a more biologically realistic way.},
