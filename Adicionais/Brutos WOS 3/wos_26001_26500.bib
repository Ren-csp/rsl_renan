@inproceedings{ WOS:000075224700105,
Author = {Addassi, YN},
Editor = {Magoon, OT and Converse, H and Baird, B and MillerHenson, M},
Title = {In-situ burning policy development for California},
Booktitle = {CALIFORNIA AND THE WORLD OCEAN `97 - TAKING A LOOK AT CALIFORNIA'S OCEAN
   RESOURCES: AN AGENDA FOR THE FUTURE, VOLS 1 AND 2, CONFERENCE
   PROCEEDINGS},
Year = {1998},
Pages = {801-810},
Note = {California and the World Ocean 97 Conference on Taking a Look at
   Californias Ocean Resources - An Agenda for the Future, SAN DIEGO, CA,
   MAR 24-27, 1997},
Abstract = {To satisfy California's large petroleum requirements, hundreds of
   millions of barrels of crude oil and its refined products are shipped
   annually through its coastal waters and into ports. In addition, tens of
   million of barrels of petroleum are produced each year from offshore oil
   wells and transported ashore by subsea pipelines. Consequently, the
   California marine environment, including sensitive biological resources
   and amenity resources, is under continual threat of damage as a result
   of accidents that lead to spills of oil. The use of burning as an
   available oil spill response method can play an important role in
   reducing the possible widespread impact of oil spills to marine
   resources. The use of this technology, however, often requires the
   approval of many different oversight agencies and its use has often been
   very controversial.
   This paper outlines the current efforts being spearheaded by the Office
   of Oil Spill Prevention and Response (OSPR) in the California Department
   of Fish and Game, to develop an in-situ burning policy to address oil
   spills in the open-water marine environments of the State. It describes
   the importance of early coordination and cooperation amongst the
   stakeholders in an in-situ burning decision, the formation of a
   working-group, and a discussion of the consensus approach integral to
   current policy development efforts.
   The author concludes with a description of the pertinent sections of the
   draft policy, a discussion of current projected timeline for completion
   of the finalized in-situ burning policy, plans for public review and
   comment on the draft policy and procedures for policy adoption and
   integration into appropriate State and Federal Plans. The implications
   of ``negative public perception{''} regarding the use of in-situ burning
   will be discussed and future plans for a public outreach and education
   program will be outlined.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Addassi, YN (Corresponding Author), Calif Dept Fish \& Game, POB 944209, Sacramento, CA 94244 USA.
