@article{ WOS:000221330000027,
Author = {Soriano, C and Soler, RM and Pino, D and Alarcón, M and Physick, B and
   Hurley, P},
Title = {Modelling different meteorological situations in Catalunya, Spain, with
   MM5 and TAPM mesoscale models: a comparative study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2003},
Volume = {20},
Number = {1-6},
Pages = {256-268},
Note = {8th International Conference on Harmonisation within Atmospheric
   Dispersion Modelling for Regulatory Purposes, Sofia, BULGARIA, OCT
   14-17, 2002},
Abstract = {Meteorological simulations have been performed with two different
   mesoscale models: MM5 (PSU/NCAR-USA) and TAPM (CSIRO-Australia). Both
   models have been run under two different meteorological situations,
   typical for summertime and wintertime, allowing the models to be tested
   under different synoptic forcings. The study region for these mesoscale
   simulations is located in the interior of Catalonia, Spain, north of
   Barcelona, and can attain high pollution episodes despite not including
   important pollutant sources within the domain. Simulations have shown
   that the origin of the summertime pollution peaks in the region is the
   advection of air masses loaded with pollutants from the
   densely-populated region of Barcelona. Comparison of meteorological
   fields obtained with the two models have shown that, despite the much
   smaller computational resources needed by TAPM and being almost 10 times
   faster than MM5 in simulation time, both gave similar results,
   demonstrating thus the usefulness of TAPM as an alternative tool for air
   pollution management.},
