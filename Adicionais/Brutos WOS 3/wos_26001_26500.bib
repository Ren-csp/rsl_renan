@inproceedings{ WOS:000470975400207,
Author = {Ma, Wenchao and Wenga, Terrence and Chen, Guanyi},
Editor = {Wang, H and Wang, X and Yan, J and Wu, J and Yang, Y and Li, H},
Title = {Kinetic modeling and experimental validation on the effect of KCl and
   SO2 concentration on corrosion of pure Fe under simulated municipal
   solid waste combustion},
Booktitle = {CLEANER ENERGY FOR CLEANER CITIES},
Series = {Energy Procedia},
Year = {2018},
Volume = {152},
Pages = {1302-1309},
Note = {Applied Energy Symposium and Forum - Low-Carbon Cities and Urban Energy
   Systems (CUE), Shanghai, PEOPLES R CHINA, JUN 05-07, 2018},
Organization = {Appl Energy; Appl Energy Innovat Inst; Tongji Univ; China Assoc Sci \&
   Technol, HOME Program; Malardalen Univ, Future Energy Profile; Shanghai
   Key Lab Urban Regenerat \& Spatial Optimizat Technol; MOE Joint Lab Int
   Cooperat Eco Urban Design; Sichuan Univ; Shanghai Univ Electric Power;
   BEEUE; Int Clean Energy Talent Program; UNiLAB},
Abstract = {Thermal treatment of municipal solid waste (MSW) in waste-to-energy
   plants (WtE) has gained worldwide acceptance as an environmentally
   preferred method for sustainable disposal of waste and energy recovery.
   However, superheater corrosion induced by large amounts of alkali
   chloride (KC1) and SO2 released from MSW during combustion remains a
   major challenge. In this study, a novel kinetic model was developed to
   study the corrosion behavior of pure Fe-metal and the reaction pathways
   using chemkin-PRO and Gaussian 09. The model relies on detailed
   high-temperature interactions between gaseous potassium, 0/H radicals,
   chlorine/sulfur species, and the Fe-metal. The rate coefficients for the
   surface reactions were estimated based on density functional theory
   computations using several Fe clusters that represented the Fe metal
   surface. The model was validated by the experimental results obtained
   from well-controlled simulated corrosion tests conducted in an
   electrically heated furnace at 500 C with each test lasted for 50hours.
   The exposure conditions consisted of 0-600mg KC1 which was preheated and
   its gas was injected into the furnace, 0-1700ppm SO2, 20vol.\% H20,
   8vol.\% 02, and N2 as the carrier gas. Comparison of the kinetic model
   and the experimental data showed there was a good agreement. The results
   revealed that increasing KC1 concentration accelerated the corrosion
   rate of Fe with a parabolic rate law. The concentration of SO2 > 500ppm
   enhanced the rate of corrosion of Fe, concentrations between 250-500ppm
   reduced the corrosion rate, and the concentration < 250ppm had less
   effects. The reaction series that replenished the Cl radicals and KSO3C1
   promoted the high corrosion rates while reaction path that forms sulfate
   suppresses it. The effect of supercritical conditions on SO2 and KC1
   induced corrosion rate were presented and discussed. Copyright 2018
   Elsevier Ltd. All rights reserved.},
