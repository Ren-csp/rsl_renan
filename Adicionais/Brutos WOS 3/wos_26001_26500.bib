@inproceedings{ WOS:000075224700044,
Author = {Spruill, VN and Mellman, M},
Editor = {Magoon, OT and Converse, H and Baird, B and MillerHenson, M},
Title = {Ocean conservation and the public: An issue waiting to be made SeaWeb: A
   project of the Pew Charitable Trusts},
Booktitle = {CALIFORNIA AND THE WORLD OCEAN `97 - TAKING A LOOK AT CALIFORNIA'S OCEAN
   RESOURCES: AN AGENDA FOR THE FUTURE, VOLS 1 AND 2, CONFERENCE
   PROCEEDINGS},
Year = {1998},
Pages = {323-324},
Note = {California and the World Ocean 97 Conference on Taking a Look at
   Californias Ocean Resources - An Agenda for the Future, SAN DIEGO, CA,
   MAR 24-27, 1997},
Abstract = {In the summer of 1996, The Pew Charitable Trusts, a Philadelphia-based
   philanthropy, established SeaWeb, a multi-media educational initiative
   for ocean issues. Designed to raise awareness of the world ocean and the
   life within it, SeaWeb aims to provide information from a broad spectrum
   of sources to help all become more connected and involved in the life of
   the sea. SeaWeb's approach is objective but not neutral -- its bias is
   to protect the living ocean.
   As an early component of this effort, SeaWeb commissioned a public
   opinion poll, the first of its kind, to gauge public attitudes towards
   the ocean. It is important to note that the SeaWeb campaign is not a
   direct response to the results of the public opinion poll. Although
   critically important, it is only one of several tools used to determine
   the salience of SeaWeb's communications. The research has given SeaWeb a
   strong sense of what will work to engage the public, and can therefore
   be useful as a starting point for ways to frame and discuss other,
   sometimes more significant issues.
   The survey of 1300 adults nationwide (with a margin of error of 3.3\%),
   conducted by telephone by the Washington D.C. based polling company The
   Mellman Group in May, 1996, yielded some surprising results. In
   particular, it found that deterioration of our ocean is an issue that
   can be embraced by the American public, but as yet has not been. Even
   though public awareness of the condition of the ocean and its great
   importance to us is generally high, their understanding of the specific
   nature of the problem is quite low. Nevertheless. people are anxious to
   learn about the ocean and they care if something is being done to harm
   it. Indeed, the data indicate that the ocean has the potential to become
   a powerful political issue.
   Most Americans (67\%) believe the ocean is in trouble. Nor even one
   percent of those surveyed report the condition of the ocean as
   excellent, and only 20\% say it is in good condition. Over half (52\%)
   view the deterioration of the ocean as a very serious threat ten years
   from now.
   Most of the public attitudes required to create a major political issue
   are in place. A plurality of Americans (49\%) say the condition of the
   ocean is very important to them personally. (In Coastal communities the
   number is 64\%.) Another 29\% say it is somewhat important, only 5\% say
   not too important, and 1\% not important at all. Understanding of the
   ocean's significance transcends traditional environmental categories,
   with 45\% of those who do not consider themselves environmentalists and
   who do not live on the coast saying the ocean's condition is very
   important.
   Americans are nearly unanimous (82\%) in believing that the threat to
   the ocean stems from human activity. Only 10\% believe the ocean is so
   vast and plentiful there is little humans can do to destroy it. In a
   country where the majority of the public often wants the federal
   government out of their lives, 85\% believe that the government needs to
   do more to help protect the ocean. However, scientists have not
   communicated well with the public -- 61\% of those surveyed believe that
   citizens and scientists disagree on which are the most important
   problems facing the ocean, and the government should focus on citizens
   concerns (42\%) rather than scientists(37\%). That does not mean that
   interest in ocean research is not high --72\% believe funding for ocean
   exploration is a more important priority than funding for space
   exploration (17\%).
   In brief, the field is ripe for the ocean community to take action.
   Americans are ready and willing to accept the fact that the ocean is in
   danger. They are also ready and willing to do something about it. (Of
   all the potential actions presented, those that involved personal action
   were rated as something respondents were ``almost certain{''} to do.)
   Concern is high, but information is low.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
