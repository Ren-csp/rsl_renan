@inproceedings{ WOS:000271258000101,
Author = {Thepanondh, Sarawut and Jarupan, Varoonphan and Makkasap, Thagoon},
Editor = {Li, SC and Wang, YJ and Cao, FX and Huang, P and Zhang, Y},
Title = {Evaluation of Volatile Organic Compounds Characteristics and Its Health
   Impact in the Vicinity of Petrochemical Industrial Complex},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND TECHNOLOGY, VOL II, PTS A AND B},
Year = {2009},
Pages = {565-570},
Note = {International Symposium on Environmental Science and Technology,
   Shanghai, PEOPLES R CHINA, JUN 02-05, 2009},
Organization = {Chinese Soc Environm Sci; Beijing Inst Technol; Donghua Univ; Key Lab
   Explos Sci \& Technol},
Abstract = {Measurements of airborne volatile organic compounds (VOCs) were
   conducted in the vicinity of petrochemical industrial complex in
   Thailand. Samples were collected using canister and were analyzed. by
   Gas Chromatography/Mass Spectrophotometer (GCMS) following US.EPA TO 15
   procedure. Twelve sampling locations were selected taking into account
   wind directions, receptor locations and distances from potential
   emission sources. Composite samples taken over a 24-hour period were
   collected monthly. Concentrations of VOCs were analyzed for a suite of
   24 compounds covering both of carcinogenic and non-carcinogenic
   substances. Results were determined and analyzed in order to evaluate
   its spatial variability and its potential health risk. Comparison of
   data from each monitoring sites indicated that patterns of VOCs across
   sites were difference in its major species and its concentration which
   might be influenced by nearest potential emission sources. Carcinogenic
   VOCs such as benzene, 1, 3, butadiene and 1, 2, dichloroethane were
   found higher than their annual national standards. It was suspected that
   high concentrations of benzene and 1, 3, butadiene might be attributed
   by both the mobile source and point source emissions while 1, 2,
   dichloroethane was suspected to be emitted from factory, located upwind
   from the monitoring sites. Hazard quotient and hazard indexes were
   applied to determined chronic health effects with non-cancer endpoints.
   Calculated values of hazard index for every of target organ systems were
   lower than 1 which indicated that the non-cancer chronic risk due to
   level of volatile organic compounds in the study area was less. Analysis
   of data revealed that benzene was the largest contributor to chronic
   risk. As cancer risk was concerned, benzene and I, 2 dichloroethane were
   determined to exhibit elevated cancer risk in this area.},
