@article{ WOS:000241249600033,
Author = {Haramoto, E. and Katayama, H. and Oguma, K. and Koibuchi, Y. and
   Furumai, H. and Ohgaki, S.},
Title = {Effects of rainfall on the occurrence of human adenoviruses, total
   coliforms, and Escherichia coli in seawater},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
Volume = {54},
Number = {3},
Pages = {225-230},
Note = {13th Conference on Health-Related Water Microbiology, Swansea, WALES,
   SEP 04-09, 2005},
Abstract = {A two-month survey was conducted in order to evaluate the effects of
   rainfall on the fate of microorganisms in seawater in the Tokyo Bay,
   Japan. The seawater sample (1,000 mL) was applied to a method to
   concentrate virus, followed by a quantification of human adenoviruses
   using the real-time PCR. Total coliforms and E. coli, which were
   determined by the colony forming method, were detected in all 47
   seawater samples, while human adenovinuses were detected in 38 (81\%) of
   the samples. The concentration of tested microorganisms showed 1-2 log
   units increase after rainfall events, followed by the gradual decrease
   to the level before the rainfall within a few days.},
