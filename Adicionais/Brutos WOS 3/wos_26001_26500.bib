   Bouteyre, E., Aix Marseille Univ, Lab Psychopathol Clinique, F-13621 Marseille, France.},
ISBN = {978-88-7587-697-5},
Keywords = {boosting effect; social networking; Facebook; Tunisia; Jasmin revolution},
