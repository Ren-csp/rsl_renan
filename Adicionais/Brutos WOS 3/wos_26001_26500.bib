@article{ WOS:A1995QX96600006,
Author = {ONO, H and MAPP, AP},
Title = {A RESTATEMENT AND MODIFICATION OF WELLS-HERINGS LAWS OF VISUAL DIRECTION},
Journal = {PERCEPTION},
Year = {1995},
Volume = {24},
Number = {2},
