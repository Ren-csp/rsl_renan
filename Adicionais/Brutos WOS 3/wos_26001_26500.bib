@inproceedings{ WOS:000298265400093,
Author = {Zhu Gao-ru and Xu Xue-gong and Feng Yue},
Editor = {Han, LS and Sun, Y and Zhang, H},
Title = {Land Use Pattern Change of the New Coastal Area of Tianjin Based on
   Multi-fractal Model},
Booktitle = {URBANIZATION AND LAND RESERVATION RESEARCH: PROCEEDINGS OF THE 2ND
   INTERNATIONAL CONFERENCE OF URBANIZATION AND LAND RESOURCE UTILIZATION},
Year = {2010},
Pages = {520+},
Note = {2nd International Conference of Urbanization and Land Resource
   Utilization, Tianjin, PEOPLES R CHINA, OCT 16, 2010},
Organization = {Tianjin Univ Commerce},
Abstract = {Fractal theory is a new tool for the study of land use spatial behavior,
   and the techniques of RS and GIS provide a technical platform. First, we
   extract land use classification information from landsat TM images of
   the New Coastal Area of Tianjin from 1993 to 2008 and divide the land
   into 8 types: farmland, woodland, building land, port land, saltern,
   freshwater, beaches and unutilized land. On this base, in order to
   describe the land use pattern changes, we use four fractal dimensions
   including boundary dimension, radial dimension, aspect dimension and
   information entropy dimension, which respectively represent the
   complexity of patch Boundary, the centripetal aggregation of land type,
   the axis' aggregation of land type and the spatial balance of land type.
   Results show: 1) the boundary complexity of ports and beaches goes up
   while other land types vibrate; 2) building land, port land are prone to
   locate within a distance of city center, and similarly within a small
   angle from the developing axis; 3) farmland goes farther from the city
   center while saltern locates more close to the perpendicular line of
   developing axis; 4) the uptrend of building land and the downtrend of
   unutilized land in information entropy dimension shows a focus strategy
   of scientific land development. In conclusion, the land use spatial
   pattern of study area is in a course of concussion and will develop from
   disorder to order. This paper is supported by Key project of national
   natural science foundation of China (NO.40830746).},
