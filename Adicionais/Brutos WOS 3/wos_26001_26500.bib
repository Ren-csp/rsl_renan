@inproceedings{ WOS:000389851900149,
Author = {Li, Yu-li and Jiang, Ji-ping and Wang, Peng},
Book-Group-Author = {Destech Publicat Inc},
Title = {Reuse of Sludge Wastewater in Water Plant by Enhanced Coagulation During
   Low Temperature and Low Turbidity Period},
Booktitle = {2016 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND ENGINEERING
   (ESE 2016)},
Year = {2016},
Pages = {961-968},
Note = {International Conference on Environmental Science and Engineering (ESE),
   Guilin, PEOPLES R CHINA, APR 15-17, 2016},
Abstract = {In order to reuse the sludge wastewater in a water treatment plant, in
   cold region, northeast China, during the low temperature and low
   turbidity period, enhanced coagulation experiments, i.e., the
   combination of calcium oxide and coagulants, were investigated. The
   results showed that the combination of calcium oxide and anionic PAM has
   the best performance. The optimal conditions of coagulation process were
   determined to be that the dosage of anionic PAM is 30 mg/L, the water
   temperature is 15 degrees C, the concentration of sludge wastewater is
   0.1\%, the pH value is 6. For this coagulation process, the adsorption
   bridging is the dominant mechanism and the sludge particle size
   increased significantly with strengthening of coagulation. Follow-up
   treatment of supernatant by microfiltration and ultrafiltration can
   ensure the reusing by the power plant as cooling water.},
