@inproceedings{ WOS:A1996BH13E00097,
Author = {Qun, HS and Sheng, LJ},
Book-Group-Author = {INT SOLID WASTE ASSOC},
Title = {Studies on solid waste management plans in Beijing - Municipal solid
   waste management planning studies},
Booktitle = {7TH ISWA INTERNATIONAL CONGRESS, PROCEEDINGS II},
Year = {1996},
Pages = {II297-II298},
Note = {7th ISWA International Congress and Exhibition, YOKOHAMA, JAPAN, OCT
   27-NOV 01, 1996},
Organization = {Int Solid Waste Assoc},
Abstract = {Beijing is the capital of China, which has a population of 11 million
   and an area of 16,800 km(2). The present situation, future development
   and draft strategic plan from 1991 to 2015 for municipal solid waste
   (MSW) management in Beijing are described in this paper.
   Several mathematical models are developed to predict the MSW generation
   pattern. The results show that MSW will increase to 9,000 tons daily in
   2015, while both of compostable and combustible components are
   increasing by more than 1\% per year, and the inorganic matter is
   decreasing every year by 1.30\%. Basing on the above results, a solid
   wastes management plan is set up and examined with regard to the cost,
   economic and financial feasibility. Furthermore, source reduction,
   separate collection, transportation, comprehensive utilization and
   harmless treatment of solid wastes are studied according to the
   socioeconomic characteristics in Beijing.},
