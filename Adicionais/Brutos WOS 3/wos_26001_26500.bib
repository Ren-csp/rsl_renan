@article{ WOS:000074571500015,
Author = {Delaney, C and Dowding, P},
Title = {The relationship between extreme nitrogen oxide (NOX)
   concentrations in Dublin's atmosphere and meteorological conditions},
Journal = {ENVIRONMENTAL MONITORING AND ASSESSMENT},
Year = {1998},
Volume = {52},
Number = {1-2},
Pages = {159-172},
Month = {AUG},
Note = {1st International Conference on Urban Air Quality - Monitoring and
   Modelling, UNIV HERTFORDSHIRE, HATFIELD, ENGLAND, JUL 11-12, 1996},
Organization = {Inst Phys, Environm Phys Grp, UK; Royal Meteorol Soc, UK; Natl Soc Clean
   Air \& Environm Protect, UK; Royal Soc Chem, Uk},
Abstract = {A study was carried out to investigate the effects of meteorological
   conditions on atmospheric Nitrogen Oxide (NOx (Nitrogen Oxide and
   Nitrogen Dioxide)) concentrations at a site in Dublin. Data used in the
   study (meteorological conditions and hourly NOx concentrations) were
   compiled from hourly records for the years 1988-1992. The research
   identified wind speed, air pressure and wind direction as the most
   important meteorological parameters for understanding the behaviour of
   extreme NOx concentrations in Dublin's air. Daily, weekly and seasonal
   variation in NOx concentrations were observed. This work also
   highlighted the importance of the role played by general synoptic
   weather conditions over local climatic effects in extreme events.},
