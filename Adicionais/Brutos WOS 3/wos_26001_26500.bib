@inproceedings{ WOS:000451538100051,
Author = {Adeniyi, Amos and Mbaya, Richard and Onyango, Maurice and Popoola,
   Patricia and Brooms, Thabo},
Editor = {Brebbia, CA and Sendra, JJ},
Title = {MEMBRANE SELECTION FOR ORGANIC CONTAMINANTS REMOVAL FROM HARTBEESPOORT
   DAM WATER IN SOUTH AFRICA},
Booktitle = {SUSTAINABLE CITY XII},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2017},
Volume = {223},
