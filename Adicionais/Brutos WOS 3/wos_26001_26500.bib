@inproceedings{ WOS:000174050100005,
Author = {Gard, G},
Editor = {Vartiainen, M and Avallone, F and Anderson, N},
Title = {Towards innovative practices in surveying work},
Booktitle = {INNOVATIVE THEORIES, TOOLS AND PRACTICES IN WORK AND ORGANIZATIONAL
   PSYCHOLOGY},
Year = {2000},
Pages = {59-74},
Note = {9th European Congress on Work and Organizational Psychology, HELSINKI,
   FINLAND, MAY 22-25, 1999},
Organization = {European Assoc Work \& Org Psychol; Finnish Inst Occupat Hlth; Work \&
   Org Psychol Forum},
Abstract = {A new work organization was introduced in administrative surveying work
   in Sweden during 1998. The new organization involves three important
   changes. Firstly, a change from an organization depending on experts in
   different fields to a more customer-oriented organization. Secondly, a
   change in computer information support from strong specialization
   towards greater integration within the company. Thirdly, a transition to
   a team-based organization implying a change in competencies required,
   from specialist to generalist knowledge. The aim of this paper is to
   describe the personnel's perception of and relations between
   expectations of working as a generalist in a team-based organization,
   job and organizational factors, and outcome measures at the start of the
   introduction of the team-based organization, and to discuss the results
   in relation to the need for innovative practices. The Performance
   Profile and QPS Nordic questionnaires were used. All surveyors in five
   regions in Sweden participated, in total 640 subjects. The results
   showed that more than 25\% of the surveyors expected that both internal
   activities in the team, such as job content and the chance to influence
   the work situation, and external activities, such as cooperation with
   clients, could be improved after the transition to become a generalist
   in a team. The expectations of working as a generalist in a team were
   closely related to both job factors such as group cohesion and
   organizational factors such as supervisory support and the potential to
   influence one's work situation, as well as to job satisfaction and the
   social effectiveness of group work. Innovativeness may be one factor
   explaining the correlations between group cohesion, communication and
   collaboration, the possibility to influence work, and continuous
   improvement practices in this study. The development of innovative
   practices is greatly needed in the new surveying organization.},
