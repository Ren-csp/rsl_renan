@inproceedings{ WOS:000448500500018,
Author = {D'Alpaos, Chiara},
Editor = {Mondini, G and Fattinnanzi, E and Oppio, A and Bottero, M and Stanghellini, S},
Title = {The Privatization of Water Services in Italy: Make or Buy, Capability
   and Efficiency Issues},
