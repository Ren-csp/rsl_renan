@article{ WOS:000172138500009,
Author = {Fung, PC and Poon, CS and Chu, CW and Tsui, SM},
Title = {Degradation kinetics of reactive dye by UV/H2O2/US
   process under continuous mode operation},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2001},
Volume = {44},
Number = {6},
Pages = {67-72},
Note = {International Conference on Managing Water and Wast e in the New
   Millennium, JOHANNESBURG, SOUTH AFRICA, MAY 23-26, 2000},
Organization = {Int Assoc Water Qual; Int Waste Serv Assoc; Water Inst SO Africa; IAWQ
   Specialist Grp Water \& Waste Technol \& Management Strategies
   Developing Countries},
Abstract = {Degradation of a dye, C.I. Reactive Red 120, in dyeing wastewater by the
   process of UV/H2O2/US was studied with a bench-scale reactor under the
   continuous mode of operation. The effects of dyeing wastewater flow rate
   and the feeding rate of an oxidant, H2O2, on the color removal
   efficiency of the process were investigated. The significance of
   ultrasonic (US) combined with UV irradiation was also investigated and
   the performances of the process on color removal were evaluated. The
   results showed that the decoloration process followed a pseudo
   first-order kinetic model and the UV light is the most significant
   factor on dye removal. Besides, at higher flow rates, incomplete color
   removal was observed due to relatively insufficient irradiation time
   (low degradation rate). In order to achieve a higher degradation rate,
   the feeding rate of H2O2 should be increased.},
