@article{ WOS:A1994NQ62000006,
Author = {ALEXANDER, ER},
Title = {TO PLAN OR NOT TO PLAN, THAT IS THE QUESTION - TRANSACTION COST THEORY
   AND ITS IMPLICATIONS FOR PLANNING},
Journal = {ENVIRONMENT AND PLANNING B-PLANNING \& DESIGN},
Year = {1994},
Volume = {21},
Number = {3},
Pages = {341-352},
Month = {MAY},
Note = {Association-of-European-Schools-of-Planning Congress, STOCKHOLM, SWEDEN,
   JUN, 1992},
Organization = {ASSOC EUROPEAN SCH PLANNING},
Abstract = {Planning has been associated with public intervention, in contrast with
   the `free' market. The transaction cost theory of planning bridges this
   dichotomy, suggesting instead the link between planning and hierarchical
   organizations and networks in the public and private sectors alike. The
   implications of this theory are that: (1) the scope and limits of
   planning not based on the rationales for public intervention, but depend
   on the need for more hierarchical or more market-like forms of
   organization; (2) planning as coordination demands coordinative planning
   as well as traditional strategic planning, culminating in institutional
   design; (3) these forms of planning are associated in varying degrees
   with different types of organizations,                               of
   characterized by size, complexity, and degree of hierarchy; (4) with
   growing societal complexity and interdependence, the demand for
   coordinative planning and institutional design will rise. Planning
   practice will have to incorporate coordinative planning and
   institutional design, and planning education needs to equip planners for
   these types of practice.},
