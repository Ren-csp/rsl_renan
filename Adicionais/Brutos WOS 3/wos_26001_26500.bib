@article{ WOS:000178541700026,
Author = {Alloway, KD and Roy, SA},
Title = {Conditional cross-correlation analysis of thalamocortical
   neurotransmission},
Journal = {BEHAVIOURAL BRAIN RESEARCH},
Year = {2002},
Volume = {135},
Number = {1-2},
