@article{ WOS:A1995RT74400023,
Author = {MINO, T},
Title = {SURVEY ON FILAMENTOUS MICROORGANISMS IN ACTIVATED-SLUDGE PROCESSES IN
   BANGKOK, THAILAND},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1995},
