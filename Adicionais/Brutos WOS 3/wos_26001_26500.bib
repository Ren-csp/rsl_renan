@article{ WOS:A1995TM84200012,
Author = {Hong, H and Xu, L and Zhang, L and Chen, JC and Wong, YS and Wan, TSM},
Title = {Environmental fate and chemistry of organic pollutants in the sediment
   of Xiamen and Victoria Harbours},
