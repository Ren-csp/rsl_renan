Title = {Respiratory conditions among children associated with community exposure
   to airborne particles},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {483-489},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {This survey deals with a community located in a hilly rural area in
   Israel, in a unique set-up with almost no sources of pollution, besides
   relatively high levels of respirable dust from both natural and man-made
   sources. Two main sources of pollution are located in the vicinity of
   one studied community: a cement factory and quarries. Weekly 24 hours
   measurements of Total Suspended Particulate (TSP) as well as respirable
   dust (PM10), carried out in the polluted community, indicated frequent
   violations of the 24 hours Israeli standards for both TSP and PM10.
   Concern about the health outcomes resulting from exposure to relatively
   high levels of respirable dust, initiated this health study. During
   spring 1994 second- to sixth-grade (8-12 years old) schoolchildren
   living in this area were studied. The population of one community lives
   in the vicinity of the cement factory and the queries, the second
   community is not exposed to the dust resulting from these sources.
   The children from the participating schools performed the following
   pulmonary function tests (PFT): FVC, FEV1, PEF, FEF50\% and FEF25\%
   Their parents filled out an ATS-NHLI health questionnaire, which
   included information about respiratory symptoms and diseases of the
   children, as well as information about background variables. A trend of
   higher prevalence of most respiratory symptoms could be observed among
   children growing up in the community bordering the industrial zone.
   Cough without cold, sputum without cold and cough accompanied by sputum
   were the most prevalent symptoms. As regards respiratory diseases,
   asthma (as diagnosed by a physician) was more frequently reported for
   children living in the vicinity of the polluting sources. No consistent
   trend of reduced PFT could be observed in the polluted community;
   however, PEF was significantly lower among the children from the
   polluted community. Odds Ratio values calculated from logistic
   regressions were 3.2 for cough without cold and 2.0 for sputum without
   cold in the polluted compared with 1.0 in the low-polluted community.},
Publisher = {TRANS TECH PUBLICATIONS LTD},
Address = {LAUBLSRUTISTR 24, CH-8717 STAFA-ZURICH, SWITZERLAND},
