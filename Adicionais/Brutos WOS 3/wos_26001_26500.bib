@article{ WOS:000231947000006,
Author = {Plainis, S and Murray, IJ},
Title = {Magnocellular channel subserves the human contrast-sensitivity function},
Journal = {PERCEPTION},
Year = {2005},
Volume = {34},
Number = {8},
Pages = {933-940},
Note = {Meeting in Honour of Janus Kulikowski, Manchester, ENGLAND, SEP, 2003},
Abstract = {There is evidence that the human contrast-sensitivity function (CSF) is
   mediated by the spatiotemporal characteristics of magno and parvo
   neurons early in the visual pathway. In this study we use a measure of
   contrast gain derived from simple reaction times, to investigate the
   neural substrates of suprathreshold performance. The results reveal the
   activity of two mechanisms having distinctly different contrast-gain
   characteristics. Comparing these to neurophysiological data, we find
   that the magnocellular system dominates close-to-threshold detection and
   probably forms the basis of the achromatic CSF, whereas the
   parvocellular system dominates detection at higher contrasts, when the
   magnocellular system saturates.},
