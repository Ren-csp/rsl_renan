   and RODGERS, MO and GARLAND, LJ and MARTINEZ, JE and STONEKING, C and
   IMHOFF, R and LEE, JH and NEWMAN, L and WEINSTEINLLOYD, J and ANEJA, VP},
Title = {PHOTOCHEMISTRY OF OZONE FORMATION IN ATLANTA, GA - MODELS AND
   MEASUREMENTS},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1995},
Volume = {29},
