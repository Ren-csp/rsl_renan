@article{ WOS:A1997XC31100003,
Author = {Elander, I},
Title = {Between centralism and localism: On the development of local
   self-government in postsocialist Europe},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
Year = {1997},
Volume = {15},
Number = {2},
Pages = {143-159},
