@article{ WOS:000244135100023,
Author = {Cherlin, Emily J. and Barry, Colleen L. and Prigerson, Holly G. and
   Schulman-Green, Dena and Johnson-Hurzeler, Rosemary and Kasl, Stanislav
   V. and Bradley, Elizabeth H.},
Title = {Bereavement services for family caregivers: How often used, why, and why
   not},
Journal = {JOURNAL OF PALLIATIVE MEDICINE},
Year = {2007},
Volume = {10},
Number = {1},
Pages = {148-158},
Month = {FEB},
Note = {58th Annual Meeting of the Gerontological-Society-of-America, Orlando,
   FL, NOV 18-22, 2005},
Organization = {Gerontol Soc Amer},
Abstract = {Background: Bereavement services are central to high-quality end-of-life
   care, however, little is known about how frequently and why such
   bereavement services are used and not used. We examined family caregiver
   reports about how often they used bereavement services, predictors of
   their use, and reported reasons for not using bereavement services.
   Methods: Prospective cohort study of family caregivers (n = 161) of
   patients with cancer enrolled with hospice between October 1999 and
   September 2001. We conducted bivariate and multivariable analyses to
   determine predictors of bereavement service use, adjusted for a broad
   range of factors including caregiving experiences, major depressive
   disorder (MDD), relationship with the deceased, and demographic factors.
   We used content analysis to summarize responses to open-ended questions
   concerning why individuals did not use bereavement services.
   Results: We found that approximately 30\% of family caregivers used
   bereavement services in the year postloss, and the majority of these
   caregivers used services in the first 6 months postloss. Even among
   bereaved caregivers with MDD, less than half (47.6\%) used bereavement
   services. Factors associated with using bereavement services included
   being a spouse caregiver, younger age, having MDD at study enrollment,
   witnessing highly distressing events pertaining to the patient's death,
   having assisted the patient with more Instrumental Activities of Daily
   Living (IADLs) prior to the patient's death, having greater availability
   of instrumental support for oneself, and physician communication with
   the caregiver about the patient's prognosis before the patient's death.
   The most common given reason for nonuse was the perception that
   bereavement services were not needed or would not help.
   Conclusion: Addressing caregiver receptivity to bereavement services
   will be an important aspect of increasing appropriate use of such
   services. Future studies might examine specific interventions for
   reducing barriers and increasing receptivity to bereavement service use.},
