@inproceedings{ WOS:000425331200023,
Author = {Iordache-Platis, Magdalena},
Editor = {Rich, M},
Title = {Leadership Influences on Student Learning in the Current Evaluation and
   Assessment Context},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2017},
Pages = {192-200},
Note = {13th European Conference on Management, Leadership and Governance
   (ECMLG), City Univ London, Cass Business Sch, London, ENGLAND, DEC
   11-12, 2017},
Abstract = {Successful leadership is associated to both institutions and
   individuals. When an institution is seen as a leader of the market, it
   has a dominant position reflected by indicators and specific criteria,
   while a leader being a strong personality proves power of influence
   through the decision making process. In higher education sector,
   leadership is both reflected institutionally and personally. Therefore,
   on one hand, institutional leadership is reflected internally through
   rules, standards and clear policies and externally, through
   stakeholders' perceptions, including classifications and rankings. On
   the other hand, a strong academic leadership is an attribute not only
   for managerial staff, but for any professor who works with students and
   influences the student learning. In addition, individual evaluation and
   assessment take into consideration standards that refer to scientific
   production and only occasionally to students' effective feed-back.
   Therefore, the purpose of this paper is to reflect the degree in which
   academic leadership influences the learning process in the contemporary
   context of the evaluation requirements at both institutional and
   individual level. Specific objectives of this paper are: to clarify the
   relationship between academic leadership and evaluation processes that
   are managed at institutional and individual level, to explain the
   factors that influence the student learning process and to reveal the
   weaknesses of the current evaluation process of professors and its
   effects on student learning. Findings demonstrate that academic
   leadership is limited in the process of student learning due to the
   weaknesses of the current evaluation process. Therefore, higher
   education institutions need to pay a lot of attention not only to
   rankings and scientific production based institutional evaluation, but
   to effective transfer of soft skills to students, as well as to how
   academic evaluation can contribute to this. The research methodology is
   based on a qualitative study which proves the need of personality models
   for students.},
