@inproceedings{ WOS:000074636300052,
Author = {Odabasi, M and Tasdemir, Y and Vardar, N and Sofuoglu, A and Holsen, TM},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Polycyclic aromatic hydrocarbons and polychlorinated biphenyls in the
   ambient air of Chicago},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {317-322},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {Ambient air samples were collected in Chicago, IL between June 1995 and
   October 1995 to determine concentrations and particle/gas phase
   distributions of polycyclic aromatic hydrocarbons (PAHs) and
   polychlorinated biphenyls (PCBs). A modified high-volume sampling method
   (PS-1 sampler) was employed to collect airborne PAHs and PCBs in both
   the particulate and gas phases. A gas chromatograph equipped with a mass
   selective detector (MSD) was used to analyze samples for PAHs. A gas
   chromatograph equipped with an electron capture detector (ECD) was
   utilized in PCB analysis. The average Sigma PAHs and Sigma PCBs were 422
   ng/m(3) and 1.78 ng/m(3) respectively. Phenanthrene was the most
   abundant PAH compound and it accounted for 42\% of Sigma PAHs. The most
   abundant PCB compound was PCB 101. This compound accounted for 9\% of
   Sigma PCBs. The particle/gas phase distribution showed a wider range for
   PAHs than PCBs. The gas phase percentage generally decreased with
   increasing PAH molecular weight. Generally a decrease in gas phase
   percentage was observed with increasing PCB molecular weight. Majority
   of the PCBs were associated with the gas phase.},
