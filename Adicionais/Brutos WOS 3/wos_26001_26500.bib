@inproceedings{ WOS:000284085300090,
Author = {Li Jingxi and Yang Yufu and Liu Lixing},
Editor = {Baby, S and Sandhu, PS and Hang, Y},
Title = {Analysis on the Influence of Oskar Schlemmer's Expressionism Stage
   Design on the Styles of Scenes in Contemporary Cinema from the Design
   Point of View-Taking ``The Wayward Cloud{''} as an Example},
Booktitle = {PROCEEDINGS OF 2010 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE
   AND DEVELOPMENT},
Year = {2010},
Pages = {473-479},
Note = {2010 International Conference on Environmental Science and Development,
   Singapore, SINGAPORE, FEB 26-28, 2010},
Organization = {IACSIT; Environm Sci Soc},
Abstract = {``Bauhaus is an ideal, instead of a style{''}, which is a phrase worth
   reflecting on. Staatliches Bauhaus tried to integrate ``Art \&
   Technique{''} and it was deemed as the ideal educational pattern.
   Besides igniting the way of contemporary design thinking, it acts as a
   helmsman leading us to the modern style of design. Therefore, having
   been deeply inspired by Bauhaus spirits, we will conduct a research on
   its history and its influence on ``Design \& Art{''}. This article will
   take the stage design work of Oskar Schlemmer (one of the Bauhaus
   expressionists) as an example, with the correlations between the
   expressionism style and cinema scenes, and putting it into the
   discussion of ``The Wayward Cloud{''} from Ming-Liang Tsai, a film full
   of expressionist atmosphere.
   On the other hand, it is a new attempt to interpret movies from a design
   point of view. We are supposed to start from the design perspective,
   such as the ``prototype{''} concept, using ``mode{''} concept to build a
   set of mode forms especially for prototype. This research covers two
   main topics: first, concrete image aspect (scene design, shots, montage
   and background music); and second, abstract aspect (culture, social
   phenomenon, and ideology), etc. Research methodology can be divided into
   the following: the first is the comparative method, which will be used
   to study the similarities and differences between stage dramas and movie
   scenes, focusing on the analysis of audience's viewpoints. The second is
   to analyze through ``the work itself and work viewing{''}, with the
   combination of: 1. Compositional interpretation: ``image production,
   image composition model{''}, 2. Simulation analysis, 3. Discourse
   analysis, 4. Cultural code analysis, etc.
   Through the verification in this paper, the ideal and technique of Oskar
   Schlemmer's expressionism stage design indirectly influence the style
   presentation of Ming-Liang Tsai in his work of ``The Wayward Cloud{''},
   especially the implantation of singing and dancing elements into the
   movie, also including the costume of the actors, make-ups, properties,
   body actions and space position arrangement. All these elements are
   related to the relationship of actors' position, geometric shape and
   exaggeration of Oskar Schlemmer's stage design. On the other hand, as
   the expressionism interprets and releases the internal emotions in
   external forms, this paper will take political ideology, Lacan's
   subject-object dialectics, and strict distinguish of body and gender in
   ancient Greece in section of 4.2.4. Discourse Analysis as the
   interpretation of the internal forms of the movie. Finally, we will
   propose on the possible application of new approaches, and offer them to
   designers and moviemakers as references.},
