@article{ WOS:000168227900005,
Author = {Coombes, M and Raybould, S},
Title = {Public policy and population distribution: developing appropriate
   indicators of settlement patterns},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
Year = {2001},
Volume = {19},
Number = {2},
Pages = {223-248},
