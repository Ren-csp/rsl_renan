@article{ WOS:000431743000164,
Author = {Chiroma, Muhammad Ali and Shah, Muhammad Zaly and Shittu, Abdulmajeed
   Olaremi},
Title = {Contribution of Corporate Social Responsibility Toward Road Safety in
   Nigeria: A Review},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
