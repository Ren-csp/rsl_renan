Title = {THE BURDEN OF REGIONAL DEVELOPMENT PLANNING IN INDONESIA: A CASE STUDY
   OF DISCREPANCIES BETWEEN LAND USE AND SPATIAL PLANNING DOCUMENT IN
   BANTEN PROVINCE},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
