@article{ WOS:000292670800013,
Author = {Rioux, Christine L. and Tucker, Katherine L. and Brugge, Doug and Gute,
   David M. and Mwamburi, Mkaya},
Title = {Traffic exposure in a population with high prevalence type 2 diabetes -
   Do medications influence concentrations of C-reactive protein?},
