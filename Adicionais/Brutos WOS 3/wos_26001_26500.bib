@inproceedings{ WOS:000248878600020,
Author = {Kurevija, Tomislav and Kukulj, Nenad},
Editor = {Frankovic, B},
Title = {Global environmental issues concerning. large scale biodiesel production},
Booktitle = {ENERGY AND THE ENVIRONMENT 2006, VOL II},
Year = {2006},
Pages = {197+},
Note = {20th International Congress on Energy and the Environment, Opatija,
   CROATIA, OCT 25-27, 2006},
Abstract = {Fossil fuels that mankind burns today in a single year were made from
   organic matter containing 44 x 10(15) kg of carbon, which is 400 times
   the net primary productivity of the planet's current biota. Such large
   consumption of fossil fuels introduced biodiesel as one of the
   alternative sources of energy that is needed for reduction of dependence
   on fossil hydrocarbons and lowering of CO2 emissions into the
   atmosphere. Therefore, the EU goal is to achieve a biodiesel share of
   5,75\% in the transportation sector until 2010. Biodiesel is often
   called a clean, ecological and renewable alternative fuel. If the whole
   situation is viewed globally, biodiesel could easily be named as one of
   the most dangerous sources of energy for the Earth's ecosystem. The main
   threat from large scale biofuel utilization comes from deforestation of
   land needed for cultivation of crops. Every year large areas of
   rainforests in South East Asia and South America are irretrievably lost
   due to world biofuel demand. Millions of hectares are turned into large
   palm and sugarcane plantation endangering the ecosystem and survival of
   many species. Furthermore, large scale deforestation is often conducted
   with forest fires and drying swamp areas of rainforests. Combustion of
   wood and oxidation of peat during drying emits enormous quantities Of
   CO2 into the atmosphere which is contrary to biodiesel appellation as
   ``CO2 balanced fuel{''}. Every energetic process and fuel must be viewed
   through complete production cycle and 4E principle: ecology, efficiency,
   economy and education.
   Croatia, with a large utilled agricultural area could be an example of
   biodiesel, only in small scale production which could contribute to some
   reduction of fossil hydrocarbons dependence but not on today's
   perceptions and demands, without large impact on environment.},
Publisher = {HRVATSKO UDRUZENJE SUNCEVU ENERGIJU RIJEKA-CROATION SOLAR ENERGY ASSOC},
