@inproceedings{ WOS:000502676800006,
Author = {Li, Xiqing and Du, Peng and Zhang, Wei},
Editor = {Subedi, B and Burgard, DA and Loganathan, BG},
Title = {Application of Wastewater-Based Epidemiology in China From Wastewater
   Monitoring to Drug Control Efforts},
Booktitle = {WASTEWATER-BASED EPIDEMIOLOGY: ESTIMATION OF COMMUNITY CONSUMPTION OF
   DRUGS AND DIETS},
