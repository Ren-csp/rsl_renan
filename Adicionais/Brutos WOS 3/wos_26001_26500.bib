@inproceedings{ WOS:000173641300031,
Author = {Ho, C and Fauver, K},
Editor = {Easa, S and Samdahl, D},
Title = {VMT vs. ozone exceedances: An analysis of correlation},
Booktitle = {TRANSPORTATION, LAND USE, AND AIR QUALITY, CONFERENCE PROCEEDINGS:
   MAKING THE CONNECTION},
Year = {1998},
Pages = {286-295},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {On July 18, 1997, concurrent with the publication of U.S. Environmental
   Protection Agency (EPA) revised National Ambient Air Quality Standards
   (NAAQS) for Ozone and Particulate Matter Final Rules, the President
   issued a memorandum to the EPA to outline the implementation of the new
   ozone and particulate matter standards. In the implementation plan, EPA
   proposes that any area now meeting ozone standards and areas that have
   not had violations for three years would be classified as
   ``transitional{''} areas provided the State would submit a new State
   Implementation Plan (SIP) by Year 2000, and/or participate in the
   regional ozone reduction recommendations specified by the Ozone
   Transport Assessment Group (OTAG).
   In following the President's direction of a flexible and less burdensome
   implementation approach, EPA is proposing several options for the
   transitional ozone areas to meet their conformity requirements without
   unnecessary modeling and regulatory burdens. One of the options being
   proposed is to allow Metropolitan Planning Organizations (MPOs) using
   long term (20 years) vehicle miles traveled (VMT) projections to provide
   a basis for a qualitative statement that no violations will be caused or
   worsened, In other words, EPA is assuming that VMT can and will be
   significant in determining an area's potential ozone exceedances.
   The purpose of this analysis is to explore whether EPA's assumption is
   plausible. The data on VMT and the number of ozone exceedances from
   various nonattainment areas lead us to question EPA's assumption, This
   analysis is intended to first find out whether VMT and ozone occurrence
   are related, and second, how strong the relationship is if it exists.
   The results of a chi-square test and a regression analysis show that
   even though there is a relationship between the number of ozone
   exceedances and daily, VMT in these nine areas, the relationship (R-2 =
   0.2097) is so weak that daily VMT cannot be used as the only factor to
   explain the variation of the number of ozone exceedances while ignoring
   other contributing factors, such as meteorological factors (temperature,
   wind, etc.), other sources of emissions, and geography of the areas. The
   paper was concluded by a brief discussion of the policy implications of
   this option and some possible modifications of this approach.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
