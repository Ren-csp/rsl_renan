Title = {Processing of tactile and kinesthetic signals from bilateral sides of
   the body in the postcentral gyrus of awake monkeys},
Journal = {BEHAVIOURAL BRAIN RESEARCH},
Year = {2002},
Volume = {135},
Number = {1-2},
Pages = {185-190},
