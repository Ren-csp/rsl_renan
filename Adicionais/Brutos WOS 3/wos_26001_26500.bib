Title = {New social values on the establishment of cemara udang
   (Casuarina equisetifolia) in the Southern Coast of Yogyakarta},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON SUSTAINABLE FUTURE FOR HUMAN SECURITY,
   SUSTAIN 2012},
Series = {Procedia Environmental Sciences},
