Title = {Food wastage and its impacts on sustainable business operations: a study
   on Sri Lankan tourist hotels},
Booktitle = {INTERNATIONAL CONFERENCE OF SABARAGAMUWA UNIVERSITY OF SRI LANKA 2015
   (ICSUSL 2015)},
