Year = {1997},
Pages = {426-431},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {Since 1974 an integrated database of emissions and supporting
   information is present in The Netherlands. This database has developed
   into the national information system containing all information about
   emissions that all actors in the field have agreed upon. This emission
   information system is called the Pollutant Emission Register or also the
   Emission Inventory System and is the equivalent of the national
   Pollutant Release and Transfer Register in The Netherlands. The
   information system has become one of the main tools in the monitoring of
   target groups and is the main source of information about emissions on a
   regional, national and international level. The emission data in the
   central national database will be made accessible to all interested
   parties including the public.},
