@inproceedings{ WOS:A1994BB48F00028,
Author = {CARR, TH and DAGENBACH, D and VANWIEREN, D and RADVANSKY, LAC and
   ALEJANO, AR and BROWN, JS},
Editor = {Umilta, C and Moscovitch, M},
Title = {ACQUIRING GENERAL KNOWLEDGE FROM SPECIFIC EPISODES OF EXPERIENCE},
Booktitle = {ATTENTION AND PERFORMANCE XV: CONSCIOUS AND NONCONSCIOUS INFORMATION
   PROCESSING},
Series = {ATTENTION AND PERFORMANCE},
Year = {1994},
