@article{ WOS:000267504800011,
Author = {Ho, Cindy S. and Giaschi, Deborah E.},
Title = {Low- and high-level first-order random-dot kinematograms: Evidence from
   fMRI},
Journal = {VISION RESEARCH},
Year = {2009},
