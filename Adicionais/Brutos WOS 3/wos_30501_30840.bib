@article{ WOS:000189120600005,
Author = {Fisch, M and Cohen, MZ and Rutledge, C and Cripe, LD},
Title = {Teaching patients how to improve communication with their health care
   providers: A unique workshop experience},
Journal = {JOURNAL OF CANCER EDUCATION},
Year = {2003},
