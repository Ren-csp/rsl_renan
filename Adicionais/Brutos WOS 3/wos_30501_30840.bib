@article{ WOS:000165745400012,
Author = {Scullen, SE and Mount, MK and Goff, M},
Title = {Understanding the latent structure of job performance ratings},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2000},
Volume = {85},
Number = {6},
Pages = {956-970},
Month = {DEC},
