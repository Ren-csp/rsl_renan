@inproceedings{ WOS:000226788700013,
Author = {Gautama, T and Van Hulle, MM},
Editor = {Buracas, GT and Ruksenas, O and Boynton, GM and Albright, TD},
Title = {Modeling motion processing in macaque area MTN5: From single cells to
   population codes},
Booktitle = {MODULATION OF NEURONAL RESPONSES: IMPLICATIONS FOR ACTIVE VISION},
Series = {NATO SCIENCE SERIES, SUB-SERIES I: LIFE AND BEHAVIOURAL SCIENCES},
Year = {2003},
Volume = {334},
Pages = {282-305},
Note = {Summer School on Modulation of Neuronal Signaling, Nida, ITALY, JUL
   12-21, 2000},
Organization = {NATO},
Abstract = {Theoretical and psychophysical studies have shown that the relative
   motion between observer and environment induces a retinal flow from
   which object edges and 3D surface shapes (shape-from-motion) can be
   reconstructed. The primate middle temporal area MT or V5, for which
   there is general agreement that it is implicated in motion processing,
   is a Rely candidate for generating such descriptions. The great majority
   of the macaque MT neurons possess an antagonistic (suppressive) region
   surrounding the classical receptive field. It is believed that this
   ``surround{''} is involved in locating image discontinuities induced by
   the edges of moving objects. On the other hand, experimentalists and
   modelers have also conjectured that the surround is involved in the
   reconstruction of 3D surface shape. We have adopted a modeling approach
   to investigate whether these two, seemingly dissonant views can be
   reconciled. The parameters of the model neurons were optimized using a
   training algorithm so that they reproduce the responses of a selection
   of 31 cells taken from the MT database of Orban and co-workers. Each
   model neuron was thereafter tested for its selectivity to moving 2D
   edges and 3D surface shapes. The observed selectivities were entirely
   explainable by the surround's spatial and speed characteristics. We also
   examined the responses of neural populations and showed that a linear
   coding scheme suffices for generating accurate surface slant and tilt
   estimates in populations as small as six neurons. Finally, we developed
   a plausible scheme for extracting 3D descriptions of a visual scene from
   the retinal flow.},
