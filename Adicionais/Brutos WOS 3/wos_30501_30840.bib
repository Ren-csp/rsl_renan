@article{ WOS:000182932500005,
Author = {Coles, ME and Frost, RO and Heimberg, RG and Rhéaume, J},
Title = {``Not just right experiences{''}:: perfectionism, obsessive-compulsive
   features and general psychopathology},
Journal = {BEHAVIOUR RESEARCH AND THERAPY},
Year = {2003},
Volume = {41},
Number = {6},
Pages = {681-700},
Month = {JUN},
Note = {Annual Meeting of the Association-for-Advancement-of-Behavior-Therapy,
   NEW ORLEANS, LOUISIANA, NOV, 2000},
Organization = {Assoc Adv Behav Therapy},
Abstract = {Individuals with obsessive-compulsive disorder (OCD) frequently report
   uncomfortable sensations of things not being just right ({''}not just
   right experiences{''}; NJREs) and a need to ritualize until they quiet
   these sensations. However, very little work has been conducted to
   empirically examine the nature and characteristics of this phenomenon.
   In this paper, we present two studies that systematically examine NJREs
   in large undergraduate samples. In Study 1, NJREs were shown to be
   related to both OCD features and maladaptive domains of perfectionism.
   In Study 2, NJREs were again significantly related to OCD features.
   Further, NJREs were shown to have particularly strong relationships with
   specific OCD symptom clusters (e.g., checking, ordering). Finally, NJREs
   were significantly more strongly correlated with features of OCD than
   symptoms from other domains of psychopathology (e.g., social anxiety,
   trait anxiety, worry, depression). General conclusions are drawn, and
   future directions are discussed. (C) 2002 Elsevier Science Ltd. All
   rights reserved.},
