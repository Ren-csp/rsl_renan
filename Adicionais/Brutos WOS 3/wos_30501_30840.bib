@article{ WOS:000254057000008,
Author = {LeBreton, James M. and Tonidandel, Scott},
Title = {Multivariate relative importance: Extending relative weight analysis to
   multivariate criterion spaces},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
