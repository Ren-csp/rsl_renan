@article{ WOS:000169570700017,
Author = {Toni, I and Thoenissen, D and Zilles, K},
Title = {Movement preparation and motor intention},
Journal = {NEUROIMAGE},
Year = {2001},
Volume = {14},
Number = {1, 2, S},
Pages = {S110-S117},
