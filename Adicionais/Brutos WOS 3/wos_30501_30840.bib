@article{ WOS:000165175000005,
Author = {Stewart, MM and Shapiro, DL},
Title = {Selection based on merit versus demography: Implications across race and
   gender lines},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2000},
Volume = {85},
Number = {2},
Pages = {219-231},
