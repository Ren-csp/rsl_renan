@article{ WOS:000088241300003,
Author = {Pollmann, S and von Cramon, DY},
Title = {Object working memory and visuospatial processing: functional
   neuroanatomy analyzed by event-related fMRI},
Journal = {EXPERIMENTAL BRAIN RESEARCH},
Year = {2000},
Volume = {133},
Number = {1},
Pages = {12-22},
Month = {JUL},
Note = {Workshop on Executive Control and the Frontal Lobe, HANSE INST ADV
   STUDY, DELMENHORST, GERMANY, DEC 01-03, 1998},
Abstract = {We report an event-related functional magnetic-resonance-imaging (fMRI)
   experiment that investigates the relationship of transient visual object
   memory, visuospatial orienting, and object recognition. Delayed object
   matching and visuospatial orienting involved a highly overlapping
   network of brain areas. Common areas were the frontal eye fields (FEF),
   the pre-supplementary motor area (pre-SMA)/SMA complex, the precentral
   gyri, and the horizontal and descending branches of the intraparietal
   sulcus (IPS). Selective delay activation was observed anterior to the
   FEF and in the ascending part of the IPS. Right dorsolateral prefrontal
   cortex was involved in goal-directed visual search, but showed no delay
   activity.},
