Number = {4},
Pages = {474-487},
Note = {International Conference on Infant Studies, Vancouver, CANADA, MAR, 2008},
Abstract = {Three- to 4-month-old and 6- to 7-month-old infants were administered an
   infant version of the Face Dimensions Test that has been used with
   adults (e.g., Bukach, Le Grand, Kaiser, Bub, Tanaka, 2008). Infants were
   familiarized with a photograph of a woman's face and then tested with
   the familiar face paired with a face differing in the (a) distance
   separating the eyes (a configural/eyes change), (b) distance between the
   nose and mouth (configural/mouth change), (c) size of the eyes
   (featural/eyes change), and (d) size of the mouth (featural/mouth
   change). Infants were shown to be more sensitive to (a) configural than
   featural change, and (b) change around the eyes versus the mouth.
   Implications for the development of face processing are discussed.},
