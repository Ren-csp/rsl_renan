Title = {Emotion Is not What You Think It Is: Startle Reflex Modulation (SRM) as
   a Measure of Affective Processing in NeuroIS},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE: GMUNDEN RETREAT ON NEUROIS 2015},
Year = {2015},
Pages = {181-186},
