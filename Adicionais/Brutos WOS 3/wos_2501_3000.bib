@inproceedings{ WOS:000237753600161,
Author = {Moussiopoulos, N. and Douros, I. and Reis, S. and Friedrich, R.},
Editor = {Lekkas, TD},
Title = {MERLIN: The study of urban air quality in 20 European cities},
Booktitle = {Proceedings of the 9th International Conference on Environmental Science
   and Technology, Vol A - Oral Presentations, Pts A and B},
