@article{ WOS:000174246000005,
Author = {Quirmbach, M and Schultz, GA},
Title = {Comparison of rain gauge and radar data as input to an urban
   rainfall-runoff model},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {45},
Number = {2},
Pages = {27-33},
Note = {5th International Workshop on Rainfall in Urban Areas, PONTRESINA,
   SWITZERLAND, DEC, 2000},
Abstract = {This paper presents an application of radar data (DX-product of the
   German Weather Service) with a high resolution in space (1degrees x 1
   km) and time (Deltat = 5 minutes) in urban hydrology. The radar data and
   data of rain gauges with different locations in the test catchment were
   compared concerning their suitability as input into an urban
   rainfall-runoff model. In order to evaluate the accuracy of model
   simulation results, five evaluation criteria have been specified which
   are relevant for an efficient management of sewer systems and wastewater
   treatment plants. The results demonstrate that radar data should be used
   in urban hydrology if distances > 4 km between rain gauge and catchment
   exist and for catchments with a density of rain gauges smaller than 1
   rain gauge per 16 km(2).},
