@inproceedings{ WOS:000333253900037,
Author = {Kazemi, F. and Beecham, S.},
Editor = {Wuzhong, ZZ and Groening, G and Drew, RA},
Title = {Sampling Patterns and Edge Effects in a Biodiversity Study of Urban
   Linear Streetscapes},
Booktitle = {III INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
