Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {This research mainly explores the influence of Unique Selling
   Proposition (USP) Perception on brand image. USP perception dimensions
   include safety guarantee, knowledge learning, differences recognition
   and emotional intimacy. The empirical results show that safety
   guarantee, knowledge learning and emotional intimacy are positively
   related to brand image. Meanwhile, differences recognition has negative
   impacts on the brand image.},
