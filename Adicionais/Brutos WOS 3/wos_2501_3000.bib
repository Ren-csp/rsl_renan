Month = {FEB},
Note = {International Conference on Education (ICOED), Jakarta, INDONESIA, APR
   12-14, 2016},
Abstract = {Various studies have been conducted determining teaching effectiveness
   and profile of the teachers but there is a dearth of studies that
   investigate the difference between the teachers' self-efficacy beliefs
   and the students' perception of their teachers' effectiveness in
   teaching literature. The study analyzed the beliefs of 11 Literature
   teachers and the perception of 328 students in Literature using two sets
   of questionnaires. The results revealed that there was a significant
   difference between the teachers' beliefs on their self-efficacy and how
   their students perceived their effectiveness in teaching literature.},
