Note = {4th International Symposium on Highway Pollution, MADRID, SPAIN, MAY
   18-22, 1992},
Abstract = {Urban stormwater has been considered traditionally to be uncontaminated
   surface water, but several studies conducted during the last 20 years
   have disproved that assumption. This paper describes some of the
   findings of a 3-year research project carried out to investigate the
   quality and quantity of stormwater flows from a separately-sewered
   residential catchment in Nottingham, UK. The results of the study
   provide an important focus of understanding of the road surface
   interface between the above- and below-ground phases in stormwater
   runoff and highlight highway pollution as a significant potential
   pollution source.},
