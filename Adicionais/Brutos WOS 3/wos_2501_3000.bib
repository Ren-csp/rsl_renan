Organization = {Int Soc Resource Environm Informat Technol},
Abstract = {By considering the weight coefficients of ``3-induced effects{''},
   environmental sustainability and source emission characteristics etc.,
   the PAHs comprehensive pollution index (PPI) definition of urban air was
   proposed for the first time in this paper and its corresponding
   expressions were established. The PAHs air pollution of Jinan city was
   predicted with the urban air prediction numerical model system. The
   results show that the PAHs pollution in Jinan city has the significant
   seasonal variations. In the non-heating season, PAHs pollution is
   lighter; but it is opposite of the heating season. Compared with the
   PPI, the single API was difficult to reflect comprehensively the air
   pollution level.},
