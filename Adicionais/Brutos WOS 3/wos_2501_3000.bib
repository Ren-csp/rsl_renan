@article{ WOS:000165108000052,
Author = {Kukkonen, J and Konttinen, M and Bremer, P and Salmi, T and Saari, H},
Title = {The seasonal variation of urban air quality in northern European
   conditions},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2000},
Volume = {14},
Number = {1-6},
Pages = {480-487},
Note = {5th Workshop on Harmonization within Atmospheric Dispersion Modelling
   for Regulatory Purposes, RHODES, GREECE, MAY 18-AUG 21, 1998},
Organization = {Natl Ctr Sci Res Demokritos},
Abstract = {Meteorological conditions in northern Europe vary widely with the
   seasons. Consequently the seasonal variation of urban air pollution is,
   to a large extent, determined by those meteorological variables which
   are important for air quality. We present first results on the yearly
   variation of atmospheric stability land the occurrence of inversion
   layers), wind velocity, ambient temperature, solar radiation,
   precipitation and snow cover. The seasonal variations of the guideline
   exceedences for CO, NO2, SO2, TSP and PM10 in urban areas in Finland are
   then interpreted in the light of the meteorological variation.},
