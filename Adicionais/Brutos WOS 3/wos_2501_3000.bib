@article{ WOS:000264824900005,
Author = {Wei, Y. H. Dennis and Lu, Yuqi and Chen, Wen},
Title = {Globalizing Regional Development in Sunan, China: Does Suzhou Industrial
   Park Fit a Neo-Marshallian District Model?},
Journal = {REGIONAL STUDIES},
Year = {2009},
