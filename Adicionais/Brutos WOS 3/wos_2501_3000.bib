Title = {Comparative analysis of characteristics of Urban Land structure of
   Different grades in Heilongjiang Province},
Booktitle = {URBANIZATION AND LAND RESERVATION RESEARCH},
Year = {2011},
Pages = {243-247},
Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {With study on the characteristics of urban land structure of different
   grades, it has a potent impact on human adjust rationally the land
   resources collocating and optimize the benefit of urban land. This paper
   regards the entire urban land of Heilongjiang Province as research
   object, dividing them into different grades, analyzing comparatively the
   land structure of diverse urban lands. The main conclusions we research
   are as follows: (1) the amount of urban land in Heilongjiang Province
