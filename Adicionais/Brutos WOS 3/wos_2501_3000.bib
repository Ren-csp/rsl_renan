Title = {Forest fire as a threat for biodiversity and urban pollution},
Booktitle = {INTERNATIONAL SYMPOSIUM ON ARBORICULTURE IN THE TROPICS: SECURING
   ECOSYSTEM FUNCTIONS IN URBAN LANDSCAPE (ISATROP 2017)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
