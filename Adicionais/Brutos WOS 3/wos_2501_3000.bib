@inproceedings{ WOS:000312375100062,
Author = {Chen Weiguo and Zhang Xiaoping and Xu Wenjie},
Editor = {Zhou, Q},
Title = {The Application of Fuzzy Variable Sets Theory in Eutrophication
   Evaluation for Urban Lake},
Booktitle = {2011 2ND INTERNATIONAL CONFERENCE ON CHALLENGES IN ENVIRONMENTAL SCIENCE
   AND COMPUTER ENGINEERING (CESCE 2011), VOL 11, PT C},
Series = {Procedia Environmental Sciences},
