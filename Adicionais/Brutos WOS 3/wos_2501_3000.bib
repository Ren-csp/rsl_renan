Volume = {28},
Number = {2C},
Pages = {19-34},
Month = {DEC},
Note = {1st International Symposium on Wireless Systems and Networks (ISWSN 03),
   King Fahad Univ Petr \& Minerals, Dharan, SAUDI ARABIA, MAR, 2003},
Abstract = {In conventional mobile radio channel models, the Angles of Signal
   Arrival at the BS are assumed to be uniformly distributed. However,
   measurements in urban areas have shown otherwise. In this paper, the
   spatial characterization of wideband urban mobile radio channels is
   investigated and the resulting spatial correlations at the BS are
   computed. The assumption that the scatterers around the mobile and
   clusters of scatterers remote from the BS have bivariate Gaussian
   densities, has been used in the derivation of the pdf's of the AoA at
   the BS. The spatial correlations are computed for typical urban and bad
   urban environments and the effects of the channel parameters such as the
   MS scatterer's variance, the BS-MS distance and Nakagami m-parameter on
   these correlations are investigated. The effect of these correlations on
   the performance of 2-D Rake receivers is analyzed for different antenna
   spacing and channel power delay profiles.},
