@inproceedings{ WOS:000223250200039,
Author = {Vignolo, MG and Nordio, A},
Editor = {Wadhwa, LC},
Title = {Urban transport system monitoring: the ``black points{''} problem},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
