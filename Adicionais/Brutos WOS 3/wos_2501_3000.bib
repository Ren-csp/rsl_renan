@inproceedings{ WOS:001471781800049,
Author = {Kim, Minsu and Im, Chang-Hwan},
Book-Group-Author = {IEEE},
Title = {HiRENet: Novel Convolutional Neural Network Architecture using
   Hilbert-transformed and Raw Electroencephalogram for Subject-Independent
   Emotion Classification},
Booktitle = {2025 13TH INTERNATIONAL CONFERENCE ON BRAIN-COMPUTER INTERFACE, BCI},
Series = {International Winter Workshop on Brain-Computer Interface},
Year = {2025},
Note = {13th International Conference on Brain Computer Interface-BCI-Annual,
   SOUTH KOREA, FEB 24-26, 2025},
Organization = {Korea University College of Informatics; IEEE Systems Man and
   Cybernetics Society},
Abstract = {This study introduces a novel convolutional neural networks (CNN)
   architecture called the Hilbert-transformed (HT) and raw EEG network
   (HiRENet), which incorporates both raw and HT EEG as inputs. The HiRENet
   model was developed using two CNN frameworks: ShallowFBCSPNet and a CNN
   with a residual block (ResCNN). The performance of the HiRENet model was
   assessed using a lab-made EEG database to classify human emotions,
   comparing three input modalities: raw EEG, HT EEG, and a combination of
   both signals. The HiRENet model based on ResCNN achieved the highest
   classification accuracy, with 86.03\% for valence and 84.01\% for
   arousal classifications, surpassing traditional CNN methodologies.},
