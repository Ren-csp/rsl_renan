Booktitle = {INTERNATIONAL RESEARCH CONFERENCE OF RESOURCES UTILIZATION AND
   ENVIRONMENTAL EFFECTIVENESS: CALL OF PAPER FROM 2009 AGM},
Year = {2009},
Pages = {479+},
Note = {International Research Conference of Resources Utilization and
   Environmental Effectiveness, Linyi, PEOPLES R CHINA, DEC, 2009},
Organization = {Linyi Normal Univ; Shandong Geog Soc China},
Abstract = {The paper analyses the expansion of build-up areas of Taian spanning
   from 1979 to 2006, based on GIS, remote sensing images and other related
   information. The build-up areas were extracted from Landsat MSS and TM
   satellite imageries in 1979, 1987, 2002 and 2006. We analyzed both areas
   and directions of expansion after the build-up areas were divided into
   eight quadrants by means of ArcGIS during the three time intervals:
   1979-1987, 1987-2002 and 2002-2006. The results clearly indicate that:
   1) the build-up areas is increasing from 12.96km(2) in 1979 to 103.82
   km(2) in 2006; 2) in 1979-2002, the expansion is generally eastward and
   westward; 3) the significant expansion of built-up areas is
   southwestward and southward in 2002-2006, the expanded areas is mostly
   for industrial use which situated in the framework formed by the major
   transport arteries; 4) the physical geography affects urban expansion
   when it develops to a certain stage, while the socioeconomic factors is
   the key factors in guiding the expansion.},
