@article{ WOS:000444975300160,
Author = {Usman, A. S. and Abdullah, W. M. Z. Wan},
Title = {The Efficacy of Traditional Urban Form in Promoting Sustainability in
   Northern-Nigeria: A Theoretical Review},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3797-3801},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {The objective of this study is to examine the efficacy of the
   Hausa-Fulani traditional city urban form in promoting sustainability,
   with a view to informing policy and strategies for sustainable
   development using qualitative research approach. As the study is
   qualitative, data was obtained through the exploration of relevant
   literature supplemented by personal observations. Both conceptual and
   descriptive analysis within content analysis were adopted as the main
   method of data analysis. This methodology allows for inductions and
   deriving concepts from data, thus allowing for deductions directed at
   relationships between concepts. The findings indicate that Nigeria
   traditional urban form has certain design features that stand in sharp
   contrast to modern developments in terms of uniqueness and variety.
   These features serve as interesting urban elements in terms of both it's
   salient design principles and appearance. It is these design features
   that impact differently on economic, social, and environmental
   sustainability and that this knowledge will facilitate the development
   of more sustainable urban form in Nigeria. The paper, therefore,
   recommends the adoption of these design features as a conceptual basis
   for the promotion of sustainability in future urban planning and design
   process.},
