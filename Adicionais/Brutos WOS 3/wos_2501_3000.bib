Title = {Unplanned urban sprawl and the strategy of informal housing development
   in Egypt: The case study of Assiut City},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
