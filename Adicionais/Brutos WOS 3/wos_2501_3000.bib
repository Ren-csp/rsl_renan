@inproceedings{ WOS:000280689300002,
Author = {Xi Yan and Xi Wenchuan and Bao Lei and Shi Lili},
Editor = {Zhang, H and Zhang, H},
Title = {Sustainable Protection and Utilization of City Memory - The Planning
   Design of Handan Wang Lang City Site Park},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {6+},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Since 2008, Hebei Province has implemented three-year projects aiming to
   change the appearance of the city, which means a lot for enhancing the
   Handan City's image and taste. Ever since three-year project was
   launched, base on the Handan City surveyed and classification of
   existing buildings, it developed series measures which transformed the
   city into a brand new one, improved its taste and upgraded it urban
   level significantly.
   However, after many large-scale transformations of historic city
   rebuilt, the conflict between the development and protection of cultural
   heritage has become more and more prominent, making the original
   fragments of memories become more fragmented. In the massive urban
   movement of construction, a number of historical sites become a
   permanent memory.
   Wanglang wall historic site was part of outer city walls which was
   located in the north east of Zhaowang city originally. Nowadays, the
   building is located in Handan City, the junction of Construction Street
   and People Street that locating in Recover Area. It is scarce historic
   remains on the ground of Handan City. Due to lax management and wind
   erosion, the city has been seriously damaged; meanwhile, it is covered
   with vegetation and weed.
   For the protection of the wall of site Wanglang city is mainly protect
   the status quo, reinforce it to avoid dangerous, give maximum
   protection. Trees on surface of the city should be preserved to avoid
   more damage caused by moving.
   The design of 5000 square meters theme garden which is located in the
   south of the city, mainly focused on solving the neighboring district of
   the Garden and into the Garden people's leisure and interaction
   function, moreover, it need to deal with the relationship among garden,
   city and the wall, make these into an organic and complete whole. At the
   same time, the garden has to focus on culture aspect to highlight the
   conversation between traditional culture and modern civilization, then
   creates an deep and eternal cultural mood in the garden and ancient
   city. Meanwhile, the garden also plays role as release the traffic
   pressure of surrounding area and palace for people distribution.
   For the protection of the site Wanglang city walls, if only to be at a
   simple protection, or the transformation of rude, this is not
   responsible for memory for city. On the basis of the protection we must
   seek a path combining the use and functionary, reasonable
   transformation, moderate development, and find out the city memory,
   unlike other cities', so that development of the city has a double
   continuity between space and time.},
