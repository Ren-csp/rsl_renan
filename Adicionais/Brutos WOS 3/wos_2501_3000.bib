Title = {FATE OF ANTIBIOTICS AND ANTIBIOTIC RESISTANT BACTERIA IN URBAN
   WASTEWATER TREATMENT PLANTS},
Booktitle = {EMERGING CONTAMINANTS INTO THE ENVIRONMENT: CONTAMINATION PATHWAYS AND
   CONTROL},
