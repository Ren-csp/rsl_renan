@inproceedings{ WOS:000377631900009,
Author = {Lee, Wing Sze and Leung, Man-Tak},
Editor = {Montague, JM and Tan, LM},
Title = {The structural relationships of Chinese values, self-others oriented
   achievement motives, achievement emotions and self-regulated learning in
   Hong Kong},
Booktitle = {APPLIED PSYCHOLOGY},
Year = {2016},
Pages = {160-177},
Note = {Asian Congress of Applied Psychology (ACAP), Singapore, SINGAPORE, MAY
   19-20, 2015},
Organization = {Univ Derby, Asias Leading Grad Sch, Aventis Sch Management; Singapore
   Univ Technol \& Design},
Abstract = {Learning is not only for acquiring knowledge, but also perceived as a
   social obligation in Chinese society. The study aimed to investigate how
   one's learning behaviors can be affected by cultural factors under
   Chinese culture. Two hundreds and seven participants were participated
   in present study. The study indicated that Confucian work dynamism
   predicted others-oriented achievement motives (SOAM), whereas
   Integration, Humanheartedness, Moral discipline predicted self-oriented
   achievement motives (IOAM). Meanwhile, both of SOAM and IOAM were
   significantly related to positive and negative achievement emotions,
   which subsequently affected self-regulated learning. It showed that
   Chinese Values significantly predicted self-regulated learning through
   the mediation effects on SOAM, IOAM and achievement emotions. The study
   can provide a new perspective to understand the influence of Chinese
   culture on learning behaviors among Hong Kong students.},
