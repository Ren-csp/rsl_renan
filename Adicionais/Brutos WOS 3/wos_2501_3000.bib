   validation of the Cognitive and Affective Mindfulness Scale-Revised
   (CAMS-R)},
Journal = {JOURNAL OF PSYCHOPATHOLOGY AND BEHAVIORAL ASSESSMENT},
Year = {2007},
Volume = {29},
Number = {3},
Pages = {177-190},
