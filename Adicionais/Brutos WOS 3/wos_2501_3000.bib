Title = {PSYCHOLOGICAL RESEARCH INTO THE EXPERIENCE OF EMOTION AT WORK:
   DEFINITELY OLDER, BUT ARE WE ANY WISER?},
Booktitle = {EFFECT OF AFFECT IN ORGANIZATIONAL SETTINGS},
Series = {Research on Emotion in Organizations},
Year = {2005},
Volume = {1},
Pages = {281-307},
Note = {4th International Conference on Emotions and Organizational Life,
   Birkbeck Coll, London, ENGLAND, JUN, 2004},
Abstract = {A critical evaluation of the organizational psychology research on the
   experience of emotion at work was undertaken by examining the extent to
   which research has characteristics appropriate to basic psychological
   approaches to emotion. Five characteristics were identified covering
   definitions, use of theory, design, and methods. A range of edited books
   and peer-reviewed journals were searched to identify relevant research,
   which was then examined for the expected characteristics. The results
   revealed relatively few empirical studies about experience of emotion at
   work and, in most cases, the expected characteristics were found in only
   around half of the studies. The implications of this for future research
   are discussed.},
