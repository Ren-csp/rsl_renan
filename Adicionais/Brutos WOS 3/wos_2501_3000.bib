Organization = {China Univ Petr; Taiwanese Inst Knowledge Innovat},
Abstract = {Kansei Engineering focused on the development or improvement of products
   and services by translating the customer's psychological feelings. Many
   researchers paid attention to artificial emotion or affective computing,
   but we realized expression of emotion could be very complex. Here we
   compared with different emotion models and tried to standardize and
   structure it by XML and RDF. Our analysis indicated that combined with
   Plutchik mood model and XML tools was suitable to construct the
   standardization for Kansei Engineering. Our results established the
   protocol of emotion to exchange flexibly and re-use in different
   researches.},
