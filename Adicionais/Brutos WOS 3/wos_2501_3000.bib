Note = {1998 National Convention of the Society-of-American-Foresters, SAF
   MICHIGAN STATE SOC, TRAVERSE CITY, MI, SEP 19-23, 1998},
Organization = {Soc Amer Foresters},
Abstract = {In many older industrial cities in the northeastern portion of the
   United States, there are increasing numbers of vacant lots and
   buildings. City governments and residents struggle with the various
   options as to what to do with these vacant lots. One option is to turn
   vacant lots into neighborhood Pocket Parks and several states and local
   governments have begun to do this. Using a communications science
   approach, this paper illustrates one research project conducted in
   Hartford, Connecticut. The study sought to determine whether or not
   Pocket Parks might be feasibly created and maintained in a selected
   neighborhood and who might be involved in the establishment and
   maintenance of such a project if Pocket Parks were desired.},
