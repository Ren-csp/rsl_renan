@inproceedings{ WOS:000280689300057,
Author = {Xu Wenlai and Zhang Jianqiang},
Editor = {Zhang, H and Zhang, H},
Title = {Evaluation of Water Environment Quality Based on the Matter-element
   Analysis Method},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {297-299},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {In order to improve the accuracy of water environment quality
   assessment, a new evaluation model was constructed based on the
   Matter-element Analysis Method. In the new model, the grade of the water
   system sustainability, the evaluating indexes and its eigenvalue were
   regarded as matter elements. The classical field, controlled field,
   weight coefficient and relatedness degree were obtained through
   normalizing the evaluate standard and data. By taking water environment
   quality of Yalong River as an example, five representative pollution
   indicators (BOD(5), COD(cr), NH(3)-N, petroleum and faecal coliform)
   were chosen as matter elements, the water quality standards of Grade I-V
   were chosen to construct the classical matter-element matrix, and
   relating degree was calculated by the new model. The result shows that
   the water quality of Yalong River meets Grade II which conforms to
   reality. The research provides a reference for the scientific assessment
   of the water environment quality.},
