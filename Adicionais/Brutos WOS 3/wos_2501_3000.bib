@inproceedings{ WOS:000305518900010,
Author = {McAuley, J. Devin and Henry, Molly J. and Tkach, Jean},
Book-Group-Author = {Annals NY Acad Sci},
Title = {Tempo mediates the involvement of motor areas in beat perception},
Booktitle = {NEUROSCIENCES AND MUSIC IV: LEARNING AND MEMORY},
