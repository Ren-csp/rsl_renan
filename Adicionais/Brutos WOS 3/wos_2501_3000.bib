Organization = {Int Soc Resource Environm Informat Technol},
Abstract = {With the acceleration in the integration of the rural and urban areas
   and the development of information technology, the traditional mode of
   cadastral management information system can not meet the requirement of
   cadastral management operations in modern times. Based on the study of
   the problems of the traditional mode of cadastral management information
   system mentioned above as well as its development tendency, this thesis
   puts forward the concept of the rural-urban integrative cadastral
   information system which is based on the workflow technology. Meanwhile,
   detailed analyses and studies will be conducted on this issue concerning
   its technical support, system design, and system realization.},
