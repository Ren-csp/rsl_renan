@article{ WOS:000185957900010,
Author = {Wada, Y and Kitagawa, N and Noguchi, K},
Title = {Audio-visual integration in temporal perception},
Journal = {INTERNATIONAL JOURNAL OF PSYCHOPHYSIOLOGY},
Year = {2003},
Volume = {50},
Number = {1-2},
Pages = {117-124},
