@article{ WOS:000232837100007,
Author = {Hanousková, I and Bohac, J and Sedlacek, F and Será, B and Lepsová, A
   and Zacharda, M},
Title = {Harmful organisms in urban green areas},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2004},
Volume = {23},
Number = {1},
Pages = {58-68},
Note = {13th International Symposium on Problems of Landscape Ecological
   Research, Mojmirovce, SLOVAKIA, SEP 30-OCT 03, 2003},
Organization = {Slovak Acad Sci, Inst Landscape Ecol; Austrian Inst E \& SE European
   Studies Vienna, Branch Off Bratislava},
Abstract = {The occurrence, state and differences of species that might be harmful
   for green areas users were evaluated along the urban gradient (town of
   C. Budejovice, The Czech Republic). Species sample's were selected from
   vascular plants (tree and shrub species, herbs), invertebrates (ticks,
   aphids), mammals (vertebrates and/or rodents), fungi (primary toxic and
   secondary harmful species). Several results were pointed out by the
   authors for the area planning and management. (1) More than 379 plant
   species of the town is potentially hospitable for some of 17 pest aphid
   species impacting economically important plantations. The local
   management of plant inhospitability is possible via the plant
   assemblages composition. (2) The small and middle-size mammals survive
   or penetrate from suburb to the residential and housing centres
   themselves. The solution bears on the skilled green area user and
   control of pest outbreaks in any area. (3) About 30 primary toxic
   mushroom species were recorded in areas with new block of flats,
   suburban periphery and industrial area. The solution bears on the
   skilled green area user; fungi management is not recommended. (4) The
   individual plant species might be re-evaluated in a sense of their roles
   under social consensus of their harmfulness, utility and management at
   the date. (5) The standardization of the species data to management and
   planning is possible via smaller units of the town environment, i.e., on
   hierarchical levels of important individual organisms and their
   habitats. The GIS developed by municipality administration is powerful
   instrument of sharing the data about habitats/organisms between all to
   whom the data may concern.},
