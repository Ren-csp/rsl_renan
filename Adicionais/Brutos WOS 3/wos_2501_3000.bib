@article{ WOS:000292021500008,
Author = {Song, Hui Min and Xu, Lin Yu},
Title = {A method of urban ecological risk assessment: combining the multimedia
   fugacity model and GIS},
Journal = {STOCHASTIC ENVIRONMENTAL RESEARCH AND RISK ASSESSMENT},
