@inproceedings{ WOS:000379409300020,
Author = {Valente, Marieta and Chaves, Cristina and Costa, Sara},
Editor = {Ferreira, P and Soares, I},
Title = {GENETICALLY MODIFIED FOOD: AN EXPLORATORY STUDY ON PUBLIC PERCEPTIONS
   AND ECONOMIC VALUATION},
Booktitle = {PROCEEDINGS OF THE 2ND INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2015},
Pages = {154-160},
Note = {2nd International Conference on Energy and Environment - Bringing
   together Engineering and Economics (ICEE), Guimaraes, PORTUGAL, JUN
   18-19, 2015},
Organization = {Univ Minho, Sch Engn; Univ Porto, Sch Econ \& Management},
Abstract = {Many issues surrounding Genetically Modified Organisms (GMOs) in terms
   of public policy and market viability are dependent on the perceptions
   and valuation of (non-) GM food by consumers. Those perceptions may
   depend on information about the effects on GMOs particularly on health,
   economic and environmental aspects.
   In this research we undertake an exploratory study on generic attitudes
   towards GMOs, particularly GM attributes in food. The survey focuses on
   a specific group, namely young people (mostly university students), and
   explores perceptions and economic valuation of GM food. Then,
   respondents are randomly exposed to information on GMOs' impacts
   (negative, positive or balanced) to check how this impacts their
   valuation. We observe that respondents are more accepting of GMOs in
   tern's of attitudes than in studies with more representative samples of
   the general population. As for the effects of information exposure,
   while the other treatments do not impact choices, negative information
   reduces the acceptance of GM food in our sample. This result highlights
   the importance of first informing the public before assessing the
   national consensus on the topic so as to design and implement public
   policy.},
