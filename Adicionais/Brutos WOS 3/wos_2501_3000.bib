@inproceedings{ WOS:000377631900013,
Author = {So, Choi-Yin and Leung, Man-Tak},
Editor = {Montague, JM and Tan, LM},
Title = {Structural equation modeling of Chinese parenting predicting Hong Kong
   secondary school students' learning strategies with achievement emotions
   and achievement goals as mediators},
Booktitle = {APPLIED PSYCHOLOGY},
Year = {2016},
Pages = {220-238},
Note = {Asian Congress of Applied Psychology (ACAP), Singapore, SINGAPORE, MAY
   19-20, 2015},
Organization = {Univ Derby, Asias Leading Grad Sch, Aventis Sch Management; Singapore
   Univ Technol \& Design},
Abstract = {Numbers of studies examined the effects of Baumrind's parenting styles
   on children's learning for decades. Research regarding parenting styles
   specific to Hong Kong senior form students was relatively unfamiliar.
   The current study established an original path diagram and structural
   equation modeling of Chinese parenting (control, warmth and guan) as
   antecedent to explore the relations of 3x2 achievement goals and
   positive achievement emotions on learning strategies (MSLQ). It showed
   that Chinese parenting was a significant predictor in this study.
   Comparing with achievement goals, positive achievement emotions have
   stronger mediation effects among Chinese parenting and learning
   strategies. Both control and warmth were positively significant with
   positive achievement emotions, but the opposite result of guan. Only
   control maintained positive significant relationships with achievement
   goals. This study suggested that control, which was different from guan,
   was a significant dimension in Chinese Parenting. The impacts of control
   towards other consequences required further investigation.},
