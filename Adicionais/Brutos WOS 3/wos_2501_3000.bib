@article{ WOS:000232439400008,
Author = {Huys, R and Williams, AM and Beek, PJ},
Title = {Visual perception and gaze control in judging versus producing phase
   relations},
Journal = {HUMAN MOVEMENT SCIENCE},
Year = {2005},
Volume = {24},
Number = {3},
Pages = {403-428},
Month = {JUN},
Note = {9th Annual Meeting of the European-College-of-Sport-ScienceSatellite
   Symposium on Motor Control and Learning, Clermont Ferrand,
   FRANCEClermont Ferrand, FRANCE, JUL 03-06, 2004JUL, 2004},
Organization = {European Coll Sport Sci; World Commiss Sci \& Sport},
Abstract = {We studied visual perception and gaze control in nine participants while
   they judged the relative phase between two oscillating stimuli
   (Experiment 1), and while they moved their hand - and therewith a
   concurrent feedback signal - in-phase or in antiphase with all
   oscillating stimulus (Experiment 2). As in previous studies, the mean
   relative phase judgements in Experiment 1 corresponded to the presented
   phase relations (0 degrees, 45 degrees, 90 degrees, 135 degrees, and 180
   degrees), whereas their standard deviations followed an inverted
   U-function of relative phase. The relative phase judgements were hardly
   affected by the degree of visibility (fully visible, inner parts
   occluded, outer parts occluded) and the amplitude (5 degrees, 10
   degrees, and 20 degrees) of the stimuli. Stimulus-gaze coupling
   decreased as relative phase increased, and its variability correlated
   with that of the relative phase judgements. Taken together, task
   performance and gaze behaviour suggested that the judgement of relative
   phase might be flexibly based on different variables, rather than a
   single variable like relative direction of motion. In Experiment 2, the
   production of the antiphase relation was less stable than that of the
   in-phase relation. Performance deteriorated when the outer parts of the
   signals were occluded and when their amplitudes were reduced.
   Stimulus-gaze coupling was stronger during in-phase than during
   antiphase tracking and weaker when the signals were partially occluded
   and when their amplitudes were reduced. Stimulus-gaze coupling at 0
   degrees and 180 degrees was stronger in Experiment 2 than in Experiment
   1, suggesting that the visual perception of relative phase may benefit
   from its active production. Overall, the results clearly indicated that
   visual perception of relative phase and the corresponding gaze control
   are strongly task-dependent. (c) 2005 Elsevier B.V. All rights reserved.},
