   Preweda, Edward},
Editor = {Jozwiakowski, K and Kasprzyk, M},
Title = {Sustainable formation of urban development on the example of the primary
   real estate market in Krakow},
Booktitle = {FIRST INTERNATIONAL SCIENTIFIC CONFERENCE ON ECOLOGICAL AND
   ENVIRONMENTAL ENGINEERING 2018},
Series = {E3S Web of Conferences},
