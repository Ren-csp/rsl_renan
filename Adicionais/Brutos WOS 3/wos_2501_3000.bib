@inproceedings{ WOS:001589751800370,
Author = {Penning, W. E. and De Lange, M. and Steetzel, H. and Vuik, V. and
   Fiselier, J. and Van Der Goot, F. and Senhorst, H. and Aarninkhof, S.},
Editor = {Calvo, L},
Title = {HOW TO BRIDGE THE DISCIPLINARY DIVIDE IN IMPLEMENTING NATURE BASED
   SOLUTIONS: SHOWCASE PILOT HOUTRIBDIJK IN THE NETHERLANDS},
Booktitle = {PROCEEDINGS OF THE 38TH IAHR WORLD CONGRESS},
