Title = {Time-asymmetric presuppositions in time perception research},
Booktitle = {INTERNATIONAL CONFERENCE ON TIMING AND TIME PERCEPTION},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
Volume = {126},
Pages = {132-136},
Note = {International Conference on Timing and Time Perception, GREECE, MAR
   31-APR 03, 2014},
Abstract = {Systematic under-reproduction of time has been interpreted as a
   misperception of time and, therefore, seems to contradict basic
   assumptions of pacemaker-accumulator models. An alternative explanation
   of this phenomenon is proposed, based on methodological constraints
   regarding the direction of time, which cannot be manipulated in
   experiments on time perception. Results from two experiments demonstrate
   that the direction of reproduction errors depends on the direction of
   the dimensional change (i.e., ascending vs. descending values).
   Specifically, these results support the assumption that temporal
   under-reproduction does not reflect a genuine misperception of time, but
   rather a methodological artefact. Generally, the results demonstrate
   that time-asymmetric presuppositions about reality need to be considered
   in experiments on time perception. (C) 2014 The Authors. Published by
   Elsevier Ltd.},
