@article{ WOS:000179065500009,
Author = {Hancock, T},
Title = {Indicators of environmental health in the urban setting},
Journal = {CANADIAN JOURNAL OF PUBLIC HEALTH-REVUE CANADIENNE DE SANTE PUBLIQUE},
Year = {2002},
Volume = {93},
Number = {1},
