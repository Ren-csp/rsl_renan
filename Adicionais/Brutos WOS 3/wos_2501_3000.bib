@article{ WOS:000431743000059,
Author = {Mulyana, Wahyu and Suganda, Emirhadi},
Title = {Exploring the Characteristics of Dynamic Capabilities and Adaptive
   Capacity for Urban Water Governance},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {9, SI},
Pages = {8322-8324},
Month = {SEP},
Note = {ASIA International Conference (AIC) on Emerging Issues in Economics and
   Finance (EIEF) and Future of Marketing and Management (FMM), Univ
   Teknologi Malaysia, Johor Bahru, MALAYSIA, DEC 10-11, 2016},
Abstract = {Water crisis in urban area is an example that reflects the governance
   failure. If there is no significant change in water governance, it will
   occur in urban water insecurity. The current urban water system is also
   under increasing pressure due to rapid urbanization and climate change
   that provide significant consequences. Urban water governance involves
   many actors and many sectors at different jurisdiction levels. It should
   be dynamic and adaptive to anticipate and respond to external changes in
   urban socio-ecological system. This governance system incorporates
   dynamic capabilities of the organization and adaptive capacity of urban
   systems. This paper discusses the understanding of dynamic capabilities
   and adaptive capacity and explores the characteristics of these two
   concepts. It contributes to interdisciplinary research on the exploring
   the inter-linkage between dynamic capabilities and adaptive capacity in
   urban water governance. The expected result is that the interaction of
   dynamic capabilities and adaptive capacity has significant contribution
   in building more adaptive policy process (policy, organizational and
   operational) in urban water governance.},
