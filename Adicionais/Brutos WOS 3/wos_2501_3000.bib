@inproceedings{ WOS:000288209800010,
Author = {Poulson, Chris and Duncan, Joseph and Massie, Michelle},
Editor = {Ashkanasy, NM and Zerbe, WJ and Hartel, CEJ},
Title = {``I AM NOT WHAT I AM{''} - DESTRUCTIVE EMOTIONS IN AN ORGANIZATIONAL
   HIERARCHY: THE CASE OF OTHELLO AND IAGO},
Booktitle = {EFFECT OF AFFECT IN ORGANIZATIONAL SETTINGS},
Series = {Research on Emotion in Organizations},
