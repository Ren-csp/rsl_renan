Note = {IALE Congress, TOULOUSE, FRANCE, AUG 27-31, 1995},
Organization = {IALE},
Abstract = {The study deals with the value of traditional housing and settlements in
   the countryside. It is argued that for the sustainable development of
   rural settlements at least four characteristics should be protected:
   balance between nature and built-up area; historic traditional entities;
   local communities; the countryside as all own culture. To study the
   value of the traditional natural system in housing and settlement, three
   levels have been investigated: the use of natural materials, the design
   of traditional-functional houses and the function of settlements. It was
   found that the analysis can be applied to areas that are under
   reconstruction or redevelopment. It can even save some 35 - 50\% of
   investment costs. Finally, it can play an important role in sustainable
   improvements. (C) 1998 Elsevier Science B.V. All rights reserved.},
