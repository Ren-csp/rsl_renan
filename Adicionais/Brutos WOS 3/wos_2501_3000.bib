@inproceedings{ WOS:000503475800023,
Author = {Vicente-Querol, Miguel A. and Garcia, Arturo S. and Fernandez-Sotos,
   Patricia and Rodriguez-Jimenez, Roberto and Fernandez-Caballero, Antonio},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Development and Validation of Basic Virtual Human Facial Emotion
   Expressions},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11486},
Pages = {222-231},
Note = {8th International Work-Conference on the Interplay Between Natural and
   Artificial Computation (IWINAC), Almeria, SPAIN, JUN 03-07, 2019},
Organization = {Spanish CYTED; Red Nacl Computac Nat \& Artificial, Programa Grupos
   Excelencia Fundac Seneca \& Apliquem Microones 21 s l},
Abstract = {This paper introduces the design process of facial expressions on
   virtual humans to play basic emotions. The design of the emotions is
   grounded on the Facial Action Coding System that enables describing
   facial expressions based on Action Units. All the tools employed to
   attain the final human avatar expressions are detailed. Then, an
   experiment with healthy volunteers is carried out to validate the
   designed virtual human facial emotions. As result, we obtained that the
   faces are correctly interpreted by healthy people with an accuracy of
   83.56\%. Thus, as recognition works quite well with this small sample of
   healthy people, this paper is a first step towards validating and
   enhancing the avatar characters generated, experimenting with a
   sufficient number of healthy persons, and, then, designing therapies
   based on human avatars to enhance facial affect recognition in patients
   with deficits in facial affect recognition.},
