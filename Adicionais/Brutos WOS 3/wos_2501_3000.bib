@article{ WOS:000177287500007,
Author = {Germeys, F and De Graef, P and Verfaillie, K},
Title = {Transsaccadic perception of saccade target and flanker objects},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2002},
Volume = {28},
Number = {4},
Pages = {868-883},
Month = {AUG},
Note = {8th Annual Workshop on Object Perception and Memory, NEW ORLEANS, LA,
   NOV, 2000},
Abstract = {To account for location-dependent and location-independent preview
   benefits in transsaccadic object perception, J. M. Henderson (1994) and
   J. M. Henderson and M. D. Anes H 994) proposed a dual-route model in
   which both episodic object representations and long-term memory
   representations store information across a saccade. Four experiments are
   reported in which the dual-route model was assessed. Preview benefits
   for saccade target objects were found to be location independent,
   whereas preview benefits for flanker objects were location dependent.
   These results support a single-route. 2-stage model of transsaccadic
   object perception. First, preattentive object files are set up to parse
   a set of attentional and/or saccade targets from peripheral vision.
   causing location-dependent preview benefits. Second, I object is
   attentionally selected for further processing, activating long-term
   memory representations and resulting in location-independent preview
   benefits.},
