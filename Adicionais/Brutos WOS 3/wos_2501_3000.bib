@inproceedings{ WOS:001747185700116,
Author = {Li, Chuannan and Jiang, Changbo and Lam, Man Yue and Ahmadian, Reza},
Editor = {Law, AWK and Er, JW},
Title = {OPTIMISING URBAN FLOOD EVACUATION ROUTES WITH METAHEURISTIC ALGORITNMS:
   A CASE STUDY OF YORK, UK},
Booktitle = {PROCEEDINGS OF THE 41ST IAHR WORLD CONGRESS},
Series = {IAHR World Congress Proceedings},
Year = {2025},
