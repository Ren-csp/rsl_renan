@article{ WOS:000353548800010,
Author = {Wang, Yi and Yan, Chao and Yin, Da-zhi and Fan, Ming-xia and Cheung,
   Eric F. C. and Pantelis, Christos and Chan, Raymond C. K.},
Title = {Neurobiological Changes of Schizotypy: Evidence From Both Volume-Based
   Morphometric Analysis and Resting-State Functional Connectivity},
Journal = {SCHIZOPHRENIA BULLETIN},
Year = {2015},
Volume = {41},
Number = {2},
Pages = {S444-S454},
