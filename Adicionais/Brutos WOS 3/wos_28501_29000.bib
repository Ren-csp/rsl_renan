@article{ WOS:000223230900004,
Author = {Updegraff, KA and Helms, HM and McHale, SM and Crouter, AC and Thayer,
   SM and Sales, LH},
Title = {Who's the boss? Patterns of perceived control in adolescents'
   friendships},
Journal = {JOURNAL OF YOUTH AND ADOLESCENCE},
Year = {2004},
Volume = {33},
Number = {5},
Pages = {403-420},
Month = {OCT},
Note = {8th Biennial Meeting of the Society-for-Research-on-Adolescence,
   CHICAGO, IL, APR 01, 2000},
Organization = {Soc Res Adolescence},
Abstract = {This study examined the nature and correlates of different patterns of
   perceived control in adolescents' relationships with their best friends.
   Participants included firstborn adolescents (M=14.94 years), their
   younger siblings (M=12.44 years) and both their mothers and fathers in
   163 families as well as a best friend of each adolescent (M=15 years).
   Data were collected from family members during home visits regarding
   adolescents' family relationships, friendships, and psychosocial
   adjustment; time use data were gathered during a series of 7 nightly
   phone interviews. Information was obtained from best friends during a
   brief phone interview. We developed a typology of 3 different patterns
   of perceived friendship control based on the combination of adolescents'
   and their best friends' ratings of relational control. Patterns of
   control in adolescents' friendships were associated with the
   distribution of control in both parents' marriages and adolescents'
   sibling relationships. Further analyses, designed to test developmental
   predictions, revealed connections between friendship control and other
   qualities of adolescents' friendships (i.e., intimacy, conflict,
   perspective-taking).},
