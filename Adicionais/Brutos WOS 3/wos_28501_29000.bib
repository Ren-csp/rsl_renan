@article{ WOS:000259926900010,
Author = {Chan, Wayne and Mendoza-Denton, Rodolfo},
Title = {Status-Based Rejection Sensitivity Among Asian Americans: Implications
   for Psychological Distress},
Journal = {JOURNAL OF PERSONALITY},
Year = {2008},
