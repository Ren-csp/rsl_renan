@inproceedings{ WOS:000286844300026,
Author = {Graf, Christian},
Editor = {Holscher, C and Shipley, TF and Belardinelli, MO and Bateman, JA and Newcombe, NS},
Title = {Verbally Annotated Tactile Maps - Challenges and Approaches},
Booktitle = {SPATIAL COGNITION VII},
