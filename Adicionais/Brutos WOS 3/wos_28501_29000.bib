   05-07, 1993},
Organization = {Psychonom Soc},
Abstract = {Subjects localized a small letter that appeared inside one of three
   large circles that was either validly or invalidly cued. The results
   indicated that, although unattended stimuli were localized fairly
   accurately, attention still improved localization. Moreover, the results
   revealed a greater dispersion of localization responses along the
   horizontal axis and also showed that mislocalization of attended
   peripheral stimuli is biased toward the periphery.},
