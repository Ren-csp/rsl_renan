@article{ WOS:000177070700008,
Author = {Leonova, T and Dubois, N},
Title = {The developmental approach to young children's strategic social
   cognition and behaviour},
Journal = {EUROPEAN JOURNAL OF SOCIAL PSYCHOLOGY},
