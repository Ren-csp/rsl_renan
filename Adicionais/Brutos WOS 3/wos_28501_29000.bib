@article{ WOS:000186643700088,
Author = {McKibbin, K and Elias, LJ and Saucier, DM and Engebregston, D},
Title = {Right-hemispheric dominance for processing extended non-linguistic
   frequency transitions},
Journal = {BRAIN AND COGNITION},
Year = {2003},
Volume = {53},
Number = {2},
Pages = {322-326},
Month = {NOV},
Note = {13th Annual Meeting on Tennet: Theoretical and Experimental
   Neuropsychology, MONTREAL, CANADA, JUN   20, 2002-JUN 22, 2003},
Organization = {Univ Quebec Montreal; Min Rech Sci \& Technol Quebec; Fonds Rech Sante
   Quebec; Canada Hlth Res Inst},
Abstract = {The left hemisphere is specialized for most linguistic tasks and the
   right hemisphere is specialized for many non-linguistic tasks, but the
   cause of these functional asymmetries is unknown. One of the stimulus
   factors that appears to influence these asymmetries is the rate at which
   stimuli change. In the present experiment, 41 participants completed the
   Fused Dichotic Words Test (FDWT) and a non-linguistic Frequency
   Transition Task (FTT) wherein the Frequency Transitions (FTs) were
   either rapid (40 ms) or relatively slow (200 ms). There was a right
   hemisphere advantage for slow FTs when the change was at the front of
   the stimulus, but no corresponding left hemisphere advantage for the
   rapid FTs. There was no relationship between either FTT and the left
   hemisphere advantage exhibited on the FDWT. This finding provides
   support for the position that the right hemisphere dominates tasks that
   require temporal processing over relatively long periods of time. (C)
   2003 Elsevier Inc. All rights reserved.},
