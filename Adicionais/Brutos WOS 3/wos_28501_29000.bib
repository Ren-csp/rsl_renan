@article{ WOS:000071508500006,
Author = {Rupp, DE and Vodanovich, SJ},
Title = {The role of boredom proneness in self-reported anger and aggression},
Journal = {JOURNAL OF SOCIAL BEHAVIOR AND PERSONALITY},
Year = {1997},
Volume = {12},
Number = {4},
