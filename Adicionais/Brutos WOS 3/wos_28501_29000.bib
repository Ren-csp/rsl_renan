Title = {Are Problem Based Scenarios Supporting the Positive Affect and Empathy
   of Medical Students?},
Booktitle = {WORLD CONFERENCE ON PSYCHOLOGY AND SOCIOLOGY 2012},
Series = {Procedia Social and Behavioral Sciences},
Year = {2013},
Volume = {82},
Pages = {101-107},
Note = {1st World Conference on Psychology and Sociology (PSYSOC), Antalya,
   TURKEY, NOV 27-DEC 01, 2012},
Organization = {Acad World Educ \& Res Ctr},
Abstract = {This cross-sectional study aims to determine the effect of a Problem
   Based Learning (PBL) scenario on positive-negative affects and empathic
   tendency of first year medical students. The Positive and Negative
   Affect Schedule (PANAS), Empathic Tendency Scale (ETS) was applied
   before and after the PBL sessions. The PA, NA and ETS Scale scores in
   pre and post tests were 30.29 +/- 7.50 and 32.04 +/- 6.50 (p=0.02);
   18.03 +/- 5.94 and 17.31 +/- 6.36 (p=0.38), and 69.06 +/- 9.28 and 69.21
   +/- 9.04 (p=0.81), respectively. This scenario significantly increased
   positive affect of medical students. There was also an increase in
   empathic tendency and a decrease in negative affect of males. (C) 2013
   The Authors. Published by Elsevier Ltd.},
