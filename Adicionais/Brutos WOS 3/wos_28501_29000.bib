@article{ WOS:000250050400009,
Author = {Killen, Melanie and Henning, Alexandra and Kelly, Megan Clark and
   Crystal, David and Ruck, Martin},
Title = {Evaluations of interracial peer encounters by majority and minority US
   children and adolescents},
Journal = {INTERNATIONAL JOURNAL OF BEHAVIORAL DEVELOPMENT},
Year = {2007},
Volume = {31},
Number = {5},
Pages = {491-500},
Month = {SEP},
Note = {Meeting of the European-Association-of-Experimental-Social-Psychology,
   Canterbury, NEW ZEALAND, 2006},
Organization = {European Assoc Experimental Social Psychol},
Abstract = {US majority (European-American) and minority (African-American,
   Latin-American, AsianAmerican) children were interviewed regarding
   race-based and non-race based reasons for exclusion 4(th), in
   interracial peer contexts (N = 685), evenly divided by gender at 9, 12,
   and 15 years of age (4, 7(th), and 10(th) grades) attending 13 US public
   schools. All children judged race-based exclusion as wrong using moral
   reasons. In contrast, non-race based reasons such as lack of shared
   interests, parental discomfort, and peer pressure were viewed as more
   wrong by minority children than by majority children. This pattern
   decreased with age for all participants. Further minority children were
   more likely to expect that racial exclusion occurs, indicating that
   ethnic background, social experience, and age are significantly related
