@article{ WOS:000188926800006,
Author = {Fehr, B},
Title = {Intimacy expectations in same-sex friendships: A prototype
   interaction-pattern model},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {2004},
Volume = {86},
Number = {2},
Pages = {265-284},
Month = {FEB},
Note = {3rd Annual Meeting of the Society-for-Personality-and-Social-Psychology,
   SAVANNAH, GA, JAN 31-FEB 02, 2002},
Organization = {Soc Personal \& Social Psychol},
Abstract = {A prototype interaction-pattern model of intimacy expectations was
   proposed. The central tenet of this model was that people develop
   knowledge of the patterns of relating that are likely to produce
   intimacy in a same-sex friendship. Further, it was posited that these
   interaction patterns are structured as prototypes, such that some
   patterns of relating are regarded as more likely to create a sense of
   intimacy than others. Support for this model was found in 6 studies.
   Interaction patterns depicting self-disclosure, emotional support, and
   the like were considered more prototypical of intimacy expectations than
   patterns depicting shared activities and practical support. Regarding
   gender, women rated intimacy interaction patterns higher than did men,
   particularly prototypical patterns. However, women and men agreed that
   prototypical interaction patterns were more indicative of intimacy in a
   friendship than nonprototypical patterns. Implications for the
   controversy over whether women's friendships are more intimate than
   men's are discussed.},
