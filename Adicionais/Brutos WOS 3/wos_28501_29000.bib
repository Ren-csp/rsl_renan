@article{ WOS:000597782800004,
Author = {Wang, Chunmei and Shan, Linxin and Liu, Xin and Yang, Qinke and Cruse,
   Richard M. and Liu, Baoyuan and Li, Rui and Zhang, Hongming and Pang,
   Guowei},
Title = {Impacts of horizontal resolution and downscaling on the USLE LS factor
   for different terrains},
Journal = {INTERNATIONAL SOIL AND WATER CONSERVATION RESEARCH},
Year = {2020},
Volume = {8},
Number = {4},
Pages = {363-372},
Month = {DEC},
Note = {Global Symposium on Soil Erosion (GSER), Food \& Agr Org United Nat,
   Rome, ITALY, MAY 15-17, 2019},
Organization = {FAO Global Soil Partnership, Intergovernmental Tech Panel Soils; Sci
   Policy Interface UN Convent Combat Desertificat; FAO IAEA Programme Necl
   Tech Food \& Agr},
Abstract = {Slope length and slope steepness are critical topographic factors (L and
   S) in the Universal Soil Loss Equation (USLE) and Chinese Soil Loss
   Equation (CSLE) for soil erosion modelling. Both slope length and slope
   gradient are potentially sensitive to spatial resolution when calculated
   in a GIS framework. The resolution effect on the LS factor and
   approaches suitable for improving the LS factor at a coarse resolution
   have not been well identified. To address this problem, the LS factor at
   5-m and 30-m resolution in twenty-four watersheds with various terrains
   was estimated. And a downscale model based on matching of the lower
   resolution LS cumulative frequency curves to a higher resolution
   ({''}Histogram Matching{''} method) was tested for its potential to
   improve LS factor estimation accuracy. In the larger relief mountainous
   area, compared to 5-m resolution, the 30-m resolution generated LS was
   generally overestimated by more than 20\% and in lower relief areas
   underestimated by more than 15\%. This bias is less than 10\% in medium
   relief areas. The downscale model improved LS factor estimates compared
   to the 30-m resolution estimate by more than 10\% when comparing
   frequency distribution curves and more than 20\% in mean values in
   larger relief areas. The downscale model worked well in all regions
   except for the low relief areas, which intuitively are the low soil
   erosion potential areas. The results of this research help quantify the
   uncertainty in soil erosion estimates and may ultimately help to improve
   the assessment of soil erosion through its impact on LS factor
   estimates, especially at regional and global scales. (C) 2020
