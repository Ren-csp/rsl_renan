   and Dutkewicz, Vincent and Wolfe, Douglas and Demerjian, Kenneth L. and
   Civerolo, Kevin L. and Rattigan, Oliver V. and Felton, H. Dirk and
   Dukett, James E.},
Title = {Atmospheric Chemistry Measurements at Whiteface Mountain, NY: Cloud
   Water Chemistry, Precipitation Chemistry, and Particulate Matter},
