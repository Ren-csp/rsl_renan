@article{ WOS:000087157600053,
Author = {Corballis, PM and Funnell, MG and Gazzaniga, MS},
Title = {An evolutionary perspective on hemispheric asymmetries},
Journal = {BRAIN AND COGNITION},
Year = {2000},
Volume = {43},
Number = {1-3},
