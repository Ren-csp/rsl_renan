Note = {14th Annual NeuroIS Retreat Conference, Vienna, AUSTRIA, JUN 14-16, 2022},
Organization = {Raiffeisen Software; GRZ; Brain Prod; Noldus Informat Technol},
Abstract = {Neuro-Information-Systems (NeuroIS) research contributes to a better
   understanding of cognitive and affective processes related to the
   development, adoption, and use of digital technologies. Among others,
   heart rate (HR) and heart rate variability (HRV) can be used to measure
   physiological states-more specifically, autonomic nervous system (ANS)
   activity. Based on a previous systematic literature review in which we
   surveyed the existing NeuroIS literature on HR and HRV (Stangl and
   Riedl, 2022 {[}1]), in the current paper we review completed empirical
   studies with a focus on the papers' methodological aspects. Thus, this
   review provides methodological insights to advance the research on HR
   and HRV with a focus on NeuroIS research.},
