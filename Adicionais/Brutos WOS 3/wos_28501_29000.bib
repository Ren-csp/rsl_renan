@article{ WOS:000084148400009,
Author = {van Aken, MAG and van Lieshout, CFM and Scholte, RHJ and Branje, SJT},
Title = {Relational support and person characteristics in adolescence},
Journal = {JOURNAL OF ADOLESCENCE},
Year = {1999},
Volume = {22},
