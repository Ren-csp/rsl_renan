Number = {5},
Pages = {1317-1346},
Month = {OCT},
Note = {Biennial Convention of the
   Society-for-the-Psychological-Study-of-Social-Issues, Long Beach, CA,
   JUN, 2006},
Organization = {Soc Psychol Study Social Issues},
Abstract = {We examined whether anxious expectations of discrimination among Asian
   Americans can help explain this group's elevated levels of internalizing
   symptomatology, such as lower self-esteem (Twenge \& Crocker, 2002) and
   higher depressive symptoms (Okazaki, 1997, 2002) relative to European
   Americans. Study 1 reports on the development and validation of a scale
   measuring status-based rejection sensitivity among Asian Americans
   (RS-A). In Study 2, scores on the RS-A were related to spontaneous
   discrimination is both applicable and possible for Asian Americans.
   Study 3 revealed that shame mediated the relationship between RS-A and
   internalizing symptomatology. Implications for well-being and intergroup
   interactions are discussed.},
