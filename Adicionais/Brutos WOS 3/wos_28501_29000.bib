Title = {Effect on prosthetic vision visual acuity by filtering schemes, filter
   cut-off frequency and phosphene matrix: A virtual reality simulation},
Booktitle = {PROCEEDINGS OF THE 26TH ANNUAL INTERNATIONAL CONFERENCE OF THE IEEE
   ENGINEERING IN MEDICINE AND BIOLOGY SOCIETY, VOLS 1-7},
