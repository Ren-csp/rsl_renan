@article{ WOS:000086279300005,
Author = {Kline, JP and Schwartz, GE and Dikman, ZV and Bell, IR},
Title = {Electroencephalographic registration of low concentrations of isoamyl
   acetate},
Journal = {CONSCIOUSNESS AND COGNITION},
Year = {2000},
Volume = {9},
Number = {1},
Pages = {50-65},
Month = {MAR},
Note = {1997 Annual Conference of the
   Association-for-the-Scientific-Study-of-Consciousness, POMONA, CA, 1997},
Organization = {Assoc Sci Study Consciousness},
Abstract = {Previous research has demonstrated electroencephalogram (EEG) changes in
   response to low-odor concentrations, resulting in near-chance detection.
   Such findings have been taken as evidence for olfaction without
   awareness. We replicated and extended previous work by examining EEG
   responses to water-water control, 0.0001, 0.001, 0.01, and 1 ppm isoamyl
   acetate (IAA) in water paired with water only. Detection was above
   chance (>50\%) for .001 and above, and alpha decreased only to those
   concentrations, suggesting that EEG changes corresponded to IAA
   awareness. However, when correct trial EEGs were compared to incorrect
   trial EEGs during .001 ppm, right posterior/central alpha decreased
   during incorrect trials and alpha decreased more globally (including
   frontal sites) during correct trials. These data may not reflect
   awareness or unawareness per se. Instead, results are discussed
   regarding activation of perceptual systems in the posterior region
   during incorrect trials and the activation of frontal action systems
   during a subset of correct trials. (C) 2000 Academic Press.},
Publisher = {ACADEMIC PRESS INC ELSEVIER SCIENCE},
Address = {525 B ST, STE 1900, SAN DIEGO, CA 92101-4495 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Kline, JP (Corresponding Author), Florida State Univ, Dept Psychol, Tallahassee, FL 32306 USA.
   Florida State Univ, Dept Psychol, Tallahassee, FL 32306 USA.
   Univ Arizona, Dept Psychol, Tucson, AZ 85721 USA.},
DOI = {10.1006/ccog.1999.0422},
ISSN = {1053-8100},
EISSN = {1090-2376},
