Year = {2004},
Pages = {642-647},
Note = {26th Annual Conference of the Cognitive-Science-Society, Chicago, IL,
   AUG 04-07, 2004},
Organization = {Cognit Sci Soc},
Abstract = {Transfer between isomorphic domains was investigated. Thirty college
   undergraduate students learned two isomorphic artificial systems. One
   system was concrete in the sense that it was perceptually rich and
   dynamic, while the other was abstract, involving written symbols. The
   results show significant positive transfer from the abstract domain to
   the concrete domain and no significant transfer from the concrete to the
   abstract.},
