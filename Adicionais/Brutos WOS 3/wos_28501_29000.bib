@article{ WOS:000083836900004,
Author = {Dell'Acqua, R and Grainger, J},
Title = {Unconscious semantic priming from pictures},
Journal = {COGNITION},
Year = {1999},
Volume = {73},
Number = {1},
Pages = {B1-B15},
Month = {NOV 9},
Note = {Xth Congress of the European-Society-for-Cognitive-Psychology,
   JERUSALEM, ISRAEL, SEP, 1998},
Organization = {Euro Soc Cognit Psychol},
Abstract = {Three experiments examined the effects of unconsciously presented
   picture primes on semantic categorization and naming responses to both
   word and picture targets. Picture naming and word categorization
   responses to targets were faster and more accurate when the picture
   primes belonged to the same semantic category as the targets, so called
   priming effect. No priming was found when subjects performed a word
   reading task. When priming was evident, no difference was found between
   responses to targets that were nominally identical to primes (e.g. the
   picture of a lion followed by either the word LION or the picture of a
   lion) compared with nominally different targets from the same semantic
   category as the primes (e.g. the picture of an ELEPHANT followed by
   either the word LION or the picture of a lion). Responding did not
   differ significantly from chance when subjects were asked to categorize
   the primes as natural objects vs, artifacts or as meaningful vs,
   meaningless objects in three distinct forced-choice unspeeded tasks. (C)
   1999 Elsevier Science B.V. All rights reserved.},
