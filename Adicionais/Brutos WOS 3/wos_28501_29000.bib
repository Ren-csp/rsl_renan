@inproceedings{ WOS:000177476900021,
Author = {Kujala, T},
Editor = {Witruk, E and Friederici, AD and Lachmann, T},
Title = {The mismatch negativity as an index of auditory dysfunction in dyslexia},
Booktitle = {BASIC FUNCTIONS OF LANGUAGE, READING AND READING DISABILITY},
