@article{ WOS:000079015400009,
Author = {Tokumaru, O and Kaida, K and Ashida, H and Yoneda, I and Tatsuno, J},
Title = {EEG topographical analysis of spatial disorientation},
Journal = {AVIATION SPACE AND ENVIRONMENTAL MEDICINE},
Year = {1999},
Volume = {70},
Number = {3},
Pages = {256-263},
Month = {MAR},
Note = {Aerospace-Medical-Association Annual Scientific Meeting, CHICAGO,
   ILLINOIS, MAY 11-15, 1997},
Organization = {Aerosp Med Assoc},
Abstract = {Background: We examined EEC topography while subjects experienced
   spatial disorientation (SD) such as vection and somatogravic illusion
   (SCI). Methods: Five healthy male subjects were exposed to a rotating
   image evoking vection (Experiment 1) and to a 0.58 G linear forward
   acceleration evoking SGI (Experiment 2). The data were analog-to-digital
   converted with an epoch length of 1 s and a sampling frequency of 256
   Hz. Polynomial coefficient vectors were calculated for the following
   analyses of EEG under the illusion: a) objective evaluation of
   topographical difference by two-way MANOVA; b) visual inspection of the
   power spectra maps; and c) logarithmic deviation ratio topography (log
   DRT). Results: MANOVA demonstrated significant differences in EEC
   topography in the high a band while the vection was evoked. No
   significant difference was revealed in any bands for SCI. Characteristic
   patterns common to ail subjects were hardly identified on the power
   spectra maps. By log DRT under vection, a decrease of power was observed
   in the centro-parietal area on the left side in one subject, on the
   right in another subject, and in the mid-right frontal area in a third
   subject compared with the control with eyes open. Ps for SGI, log DRT
   revealed a decrease of power in the occipital area in most of the trials
   as the magnitude was reduced by a visible horizon. Conclusions: MANOVA
   revealed a significant change in EEC topography while the subjects felt
   vection. Log DRT reflected characteristic patterns under vection and
   SGI. Thus EEG topography may be useful for the study of SD.},
