@article{ WOS:000260790000004,
Author = {Neal, Tess M. S. and Brodsky, Stanley L.},
Title = {EXPERT WITNESS CREDIBILITY AS A FUNCTION OF EYE CONTACT BEHAVIOR AND
   GENDER},
Journal = {CRIMINAL JUSTICE AND BEHAVIOR},
