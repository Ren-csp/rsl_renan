Title = {KNOWLEDGE, ATTITUDES AND COVID-19-RELATED BEHAVIOR AMONG INDIVIDUALS
   AGED 50 AND OLDER IN LATVIA},
Booktitle = {SOCIETY, INTEGRATION, EDUCATION 2021, VOL IV: LIFELONG LEARNING, PUBLIC
   HEALTH AND SPORT, ART AND DESIGN, DESIGN EDUCATION},
Series = {Sabiedriba Integracija Izglitiba-Society Integration Education},
