@article{ WOS:000246502900015,
Author = {Skeem, Jennifer and Johansson, Peter and Andershed, Henrik and Kerr,
   Margaret and Louden, Jennifer Eno},
Title = {Two subtypes of psychopathic violent offenders that parallel primary and
   secondary variants},
Journal = {JOURNAL OF ABNORMAL PSYCHOLOGY},
Year = {2007},
Volume = {116},
Number = {2},
Pages = {395-409},
