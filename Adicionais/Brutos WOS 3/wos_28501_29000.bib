@article{ WOS:000083442900006,
Author = {Marcus, DK and Askari, NH},
Title = {Dysphoria and interpersonal rejection: A social relations analysis},
Journal = {JOURNAL OF SOCIAL AND CLINICAL PSYCHOLOGY},
Year = {1999},
Volume = {18},
Number = {3},
Pages = {370-384},
Month = {FAL},
Note = {Meeting of the Association-for-Advancement-of-Behavior-Therapy, MIAMI
   BEACH, FLORIDA, NOV 13-16, 1997},
Organization = {Assoc Advancement Behav Therapy},
Abstract = {Eighty college women with varying levels of dysphoria were assigned to
   4-person groups. After interacting in dyads they rated one another using
   an acceptance-rejection scale and indicated how they believed they were
   perceived by their partners. To avoid some of the difficulties faced by
   prior depression and rejection studies, these round-robin data were
   analyzed using Kenny's (1994) social relations model. There was little
   agreement among the raters for who was liked and who was rejected.
   Instead, much of the variance in these ratings was attributable to the
   person doing the rating and to the unique relationship between the
   members of each dyad. Generally, some participants assumed that they
   were rejected by their partners, whereas others assumed their partners
   liked them. Consistent with Beck's (1967) cognitive model, the dysphoric
   participants tended to believe that they were being rejected. However,
   contrary to Coyne's (1976b) interpersonal model, there was no
   relationship between dysphoria and actual rejection.},
