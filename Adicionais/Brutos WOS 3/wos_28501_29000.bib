@article{ WOS:000184240100004,
Author = {Ashley, A and Holtgraves, T},
Title = {Repressors and memory: Effects of self-deception, impression management,
   and mood},
Journal = {JOURNAL OF RESEARCH IN PERSONALITY},
Year = {2003},
Volume = {37},
Number = {4},
Pages = {284-296},
Month = {AUG},
Note = {12th Annual Meeting of the American-Psychological-Society, MIAMI,
   FLORIDA, JUN 09-10, 2000},
Organization = {Amer Psychol Soc},
Abstract = {Previous research on individual differences in repression has used a
   typological method of classification; people are classified as
   repressors if they self-report low anxiety and high social desirability
   (Weinberger, Schwartz, \& Davidson, 1979). This typology, however, does
   not differentiate between the two factors comprising social desirability
   (impression management and self-deception). In this research,
   participants completed measures of anxiety and social desirability,
   attempted to recall childhood emotional experiences, and indicated their
   mood at the time of recall. A regression procedure was used to uncover
   the best predictors of recalled negative emotional experiences. Anxiety
   and self-deception (but not impression management) significantly
   predicted memory performance. This supports the view of repressors as
   deceiving themselves rather than engaging in impression management. Mood
   at the time of recall was related to memory, but only partially
   explained the impoverished memory of repressors. (C) 2002 Elsevier
   Science (USA). All rights reserved.},
