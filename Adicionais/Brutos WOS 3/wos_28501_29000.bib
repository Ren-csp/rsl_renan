@article{ WOS:000184781200006,
Author = {Nevid, JS and Lampmann, JL},
Title = {Effects on content acquisition of signaling key concepts in text
   material},
Journal = {TEACHING OF PSYCHOLOGY},
Year = {2003},
Volume = {30},
Number = {3},
