@inproceedings{ WOS:000229608200003,
Author = {Hurri, J and Väyrynen, J and Hyvärinen, A},
Editor = {Bowman, H and Labiouse, C},
Title = {Spatiotemporal linear simple-cell models based on temporal coherence and
   independent component analysis},
Booktitle = {CONNECTIONIST MODELS OF COGNITION AND PERCEPTION II},
Series = {PROGRESS IN NEURAL PROCESSING},
Year = {2004},
Volume = {15},
Pages = {29-38},
Note = {8th Neural Computation and Psychology Workshop, Univ Kent Canterbury,
   Kent, ENGLAND, AUG 28-30, 2003},
Abstract = {The search for computational principles that underlie the functionality
   of different cortical areas is a fundamental scientific challenge. In
   the case of sensory areas, one approach is to examine how the
   statistical properties of natural stimuli - in the case of vision,
   natural images and image sequences - are related to the response
   properties of neurons. For simple cells, located in VI, the most
   prominent computational theories linking neural properties and stimulus
   statistics are temporal coherence and independent component analysis.
   For these theories, the case of spatial linear cell models has been
   studied in a number of recent publications, but the case of
   spatiotemporal models has received fairly little attention. Here we
   examine the spatiotemporal case by applying the theories to natural
   image sequence data, and by analyzing the obtained results
   quantitatively. We compare the properties of the spatiotemporal linear
   cell models learned with the methods against each other, and against
   parameters measured from real visual systems.},
