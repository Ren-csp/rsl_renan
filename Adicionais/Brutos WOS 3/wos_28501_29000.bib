@article{ WOS:000226685600015,
Author = {Winkler, S and Rieger, L and Saracevic, E and Pressl, A and Gruber, G},
Title = {Application of ion-sensitive sensors in water quality monitoring},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2004},
Volume = {50},
Number = {11},
Pages = {105-114},
Note = {2nd International Conference on Automation in Water Quality Monitoring,
   Vienna, AUSTRIA, APR 19-20, 2004},
Organization = {IWA},
Abstract = {Within the last years a trend towards in-situ monitoring can be
   observed, i.e. most new sensors for water quality monitoring are
   designed for direct installation in the medium, compact in size and use
   measurement principles which minimise maintenance demand. Ion-sensitive
   sensors (Ion-Sensitive-Electrode - ISE) are based on a well known
   measurement principle and recently some manufacturers have released
   probe types which are specially adapted for application in water quality
   monitoring. The function principle of ISE-sensors, their advantages,
   limitations and the different methods for sensor calibration are
   described. Experiences with ISE-sensors from applications in sewer
   networks, at different sampling points within wastewater treatment
   plants and for surface water monitoring are reported. An estimation of
   investment and operation costs in comparison to other sensor types is
   given.},
Publisher = {IWA PUBLISHING},
Address = {REPUBLIC-EXPORT BLDG, UNITS 1 04 \& 1 05, 1 CLOVE CRESCENT, LONDON,
   ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Winkler, S (Corresponding Author), Vienna Univ Technol, Inst Water Qual \& Waste Management, Karlspl 13-E 226, A-1040 Vienna, Austria.
   Vienna Univ Technol, Inst Water Qual \& Waste Management, A-1040 Vienna, Austria.
   Swiss Fed Inst Environm Sci \& Technol, EAWAG, CH-8600 Dubendorf, Switzerland.
   Univ Nat Resources \& Appl Life Sci, Inst Sanit Engn \& Water Pollut Control, BOKU, A-1190 Vienna, Austria.
   Graz Univ Technol, Inst Urban Water Management \& Landscape Water Eng, A-8010 Graz, Austria.},
DOI = {10.2166/wst.2004.0678},
ISSN = {0273-1223},
EISSN = {1996-9732},
Keywords = {ammonium sensor; in situ; ion sensitive; ISE; nitrate sensor; water
   quality monitoring},
