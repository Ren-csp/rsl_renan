@inproceedings{ WOS:000086663800008,
Author = {Usher, M and Cohen, JD},
Editor = {Heinke, D and Humphreys, GW and Olson, A},
Title = {Short term memory and selection processes in a frontal-lobe model},
Booktitle = {CONNECTIONIST MODELS IN COGNITIVE NEUROSCIENCE},
Series = {PERSPECTIVES IN NEURAL COMPUTING},
Year = {1999},
Pages = {78-91},
Note = {5th Neural Computation and Psychology Workshop (NCPW5), UNIV BIRMINGHAM,
   BIRMINGHAM, ENGLAND, SEP 08-10, 1998},
Organization = {Univ Birmingham},
Abstract = {We present a neural model that addresses the capacity of a frontal lobe
   system to hold up information for short periods of time and to perform
   response selection. In the model, reverberation states are sustained
   after stimulus offset, due to loops of recurrent excitation in neural
   cell assemblies and lateral inhibition is necessary to block an
   uncontrolled spread of activation. At high levels of inhibition the
   system performs response selection, and at lower levels it retains a
   number of units in active states, after stimulus offset. It is shown
   formally that such a system has capacity limitations: only a limited
   number of cell assemblies can be retained. Sequential presentation of a
   list of items is simulated and serial position curves characterised by
   recency are obtained. The model explains recency, list-length and
   presentation rate effects in immediate cued recall, as well as semantic
   effects and patterns of forgetting in Brown-Peterson type of
   experiments. A reduction in the strength of recurrent excitations
   explains the absence of lexical effects in tests of immediate memory for
   frontal lobe patients {[}1] and more extreme reductions result in
   impairments of response selection in dynamic aphasia {[}2].},
