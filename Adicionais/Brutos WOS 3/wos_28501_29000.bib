@article{ WOS:000471803100002,
Author = {Sun, Jiaqing and Liden, Robert C. and Ouyang, Linyi},
Title = {Are servant leaders appreciated? An investigation of how relational
   attributions influence employee feelings of gratitude and prosocial
   behaviors},
Journal = {JOURNAL OF ORGANIZATIONAL BEHAVIOR},
Year = {2019},
Volume = {40},
Number = {5, SI},
Pages = {528-540},
Month = {JUN},
Note = {3rd International Symposium on Attribution Theory, Florida A \& M Univ,
   Sch Business \& Ind, Tallahassee, FL, MAR 16-17, 2018},
Abstract = {Multisource data collected at three time phases were used in
   investigating when servant leadership elicits gratitude and then
   promotes prosocial behaviors. We tested a moderated mediation model,
   contending that relational attributions moderate the relationship
   between servant leadership and gratitude, and then gratitude
   sequentially predicts interpersonal citizenship behaviors and upward
   voice. As hypothesized, when employees do not highly rely on relational
   attributions for servant leadership, they feel more gratitude and
   subsequently engage in more interpersonal citizenship behaviors and
   upward voice than the employees who rely on relational attributions to
   explain their interactions with the leader. The sequential indirect
   effect from servant leadership to upward voice via gratitude and then
   interpersonal citizenship behaviors was significant when relational
   attributions are low rather than high.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Sun, JQ (Corresponding Author), Univ Illinois, Dept Managerial Studies, 601 S Morgan St,2201 Univ Hall, Chicago, IL 60607 USA.
   Ouyang, LY (Corresponding Author), Renmin Univ China, Sch Business, 59 Zhongguancun St, Beijing, Peoples R China.
   Sun, Jiaqing; Liden, Robert C., Univ Illinois, Dept Managerial Studies, 601 S Morgan St,2201 Univ Hall, Chicago, IL 60607 USA.
   Ouyang, Linyi, Renmin Univ China, Sch Business, 59 Zhongguancun St, Beijing, Peoples R China.},
DOI = {10.1002/job.2354},
ISSN = {0894-3796},
EISSN = {1099-1379},
Keywords = {gratitude; organizational citizenship behavior; relational attributions;
