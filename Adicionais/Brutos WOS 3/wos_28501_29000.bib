@article{ WOS:000233537100017,
Author = {Zhao, H and Seibert, SE and Hills, GE},
Title = {The mediating role of self-efficacy in the development of
   entrepreneurial intentions},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2005},
Volume = {90},
Number = {6},
Pages = {1265-1272},
Month = {NOV},
Note = {63rd Annual Meeting of the Academy-of-Management, SEATTLE, WA, AUG, 2003},
Organization = {Acad Management},
Abstract = {The purpose of this study was to investigate the mediating role of
   self-efficacy in the development of students' intentions to become
   entrepreneurs. The authors used structural equation modeling with a
   sample of 265 master of business administration students across 5
   universities to test their hypotheses. The results showed that the
   effects of perceived learning from entrepreneurship-related courses,
   previous entrepreneurial experience, and risk propensity on
   entrepreneurial intentions were fully mediated by entrepreneurial
   self-efficacy. Contrary to expectations, gender was not mediated by
   self-efficacy but had a direct effect such that women reported lower
   entrepreneurial career intentions. The authors discuss practical
   implications and directions for future research.},
Publisher = {AMER PSYCHOLOGICAL ASSOC/EDUCATIONAL PUBLISHING FOUNDATION},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
