Note = {5th Congress of World-Association-for-Psychosocial-Rehabilitation,
   ROTTERDAM, NETHERLANDS, APR, 1996},
Organization = {World Assoc Psychosocial Rehab},
Abstract = {This article describes the current state of quality of life assessment
   in psychiatry. lit total, 11 instruments were reviewed in terms of
   method and source of information, psychometric properties and other
   specific features of the instruments. Results show that only three
   instruments have been comprehensively evaluated on the grounds of their
   psychometric properties, that the majority of quality of life
   instruments are used for evaluation purposes, and that more attention
   should be paid to whether current instruments cover the quality of life
   concept adequately enough.},
