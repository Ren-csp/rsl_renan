Title = {PSYCHOLOGICAL CAPITAL IN ORGANIZATIONAL CONTEXT: A META-ANALYTIC STUDY},
Booktitle = {MODERN RESEARCH IN PSYCHOLOGY: QUANTITATIVE VS QUALITATIVE RESEARCH?},
Year = {2010},
Pages = {142+},
Note = {Conference on Modern Research in Psychology: Quantitative vs Qualitative
   Research, Sibiu, ROMANIA, MAY 21-23, 2010},
Abstract = {In the recent years, the researchers and practitioners had given more
   attention to positivity in human resources management and to the way in
   which it can be reinforced the employees' psychological resources in
   order to maximize their work performance, such as positive psychological
   capital. The aim of the present study is to systematize the previous
   studies by conducting a meta-analytic review of the research on positive
   psychological capital in organizational context. Using meta-analytic
   techniques it was estimated how positive psychological capital is
   related to some individual outcome variables, such as work-related
   performance, work attitudes (e.g. work satisfaction), functional and
   dysfunctional work behaviours (organizational citizenship behaviours
   toward individuals and organization, counterproductive work behaviours)
   and intentions to quit. In the light of the obtained results, some
   implications (e.g. extending the studies of positive psychological
   capital to the group-level analysis) and methodological recommendations
   (e.g. use of longitudinal designs) are made.},
