@article{ WOS:A1995RH11400013,
Author = {FELDMAN, LA},
Title = {VALENCE FOCUS AND AROUSAL FOCUS - INDIVIDUAL-DIFFERENCES IN THE
   STRUCTURE OF AFFECTIVE EXPERIENCE},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {1995},
Volume = {69},
Number = {1},
Pages = {153-166},
Month = {JUL},
Note = {Nags Head Conference on Emotional Experience and Expression, BOCA RATON,
   FL, 1993},
Abstract = {The structure of affect is well represented as a circumplex.  The
   results of a within-subject longitudinal study of self-reported mood
   indicate individual differences in the circumplex structure of affective
   experience.  These differences can be captured by two constructs: 
   valence focus and arousal focus.  Valence focus is the degree to which
   individuals attend the hedonic component of their affective experience;
   arousal focus is the degree to which individuals attend the arousal
   component of their effective experience.  In this study, differences in
   individuals' attention to the hedonic and arousal components of
   affective experience were related to observed correlations between
   specific affective elements, such as (a) ratings of anxious and
   depressed mood and (b) `'Negative Affect'' and `'Positive Affect.''},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242},
