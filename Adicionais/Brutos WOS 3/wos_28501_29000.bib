Title = {THE RELATIONSHIP BETWEEN SELF-ESTEEM AND ACADEMIC SUCCESS},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2019},
Volume = {63},
Pages = {36-43},
Note = {Conference on Education, Reflection, Development (ERD), Babes Bolyai
   Univ, Cluj Napoca, ROMANIA, JUL 06-07, 2018},
Abstract = {The paper ``The relationship between self-esteem and academic
   success{''} focuses on the applicative dimension, on the way to
   capitalize the relation between self-esteem and academic achievement at
   the level of educational activities, but also to highlight the
   implication of the factors (social-economical family, school, gender,
   group of friends, etc.) that influence the self-esteem of the educated,
   and the educational reality has demonstrated us how the subject adopts
   the coordinates of stability or instability, overestimates or
   underestimates. This study aims to provide information and methods for
   teachers to leverage their self-esteem and academic success, as well as
   methods used to improve self-esteem, as identifying the causes that led
   to a low self-esteem at learner and implicitly when school failure
   occurs. Thus, self-esteem contributes to the mobilization of subjects'
   mechanisms and to the drawing of realistic objectives that ensure its
   academic success, but also to a quality of individual and
   socio-professional life. In order to succeed in situations, in
   challenging new tasks, to function more efficiently in the social and
   professional environment, the individual develops his features as
   self-sufficiency, optimism for present and future success, and
   confidence in his own features that support him in reaching of the goals
   set, and in the limit situations to redirect its own strengths to
   achieve the desired success. (c) 2019 Published by Future Academy
   www.FutureAcademy.org.UK},
