@inproceedings{ WOS:000086434800088,
Author = {Basly, L and Cauneau, F and Ranchin, T and Wald, L},
Editor = {Casonova, JL},
Title = {SAR imagery in urban area},
Booktitle = {REMOTE SENSING IN THE 21ST CENTURY: ECONOMIC AND ENVIRONMENTAL
   APPLICATIONS},
Year = {2000},
Pages = {563-568},
Note = {19th EARSeL Symposium on Remote Sensing in the 21st Century, VALLADOLID,
   SPAIN, MAY 31-JUN 02, 1999},
Abstract = {This paper deals with the major factors influencing the detection of
   urban fabrics in ERS-SAR images. Data, in SLC and PRI format, were
   acquired over the city of Nantes (West of France). The analysis of the
   data was performed in conjunction with aerial photographs, maps,
   meteorological data, as well as a field survey. The ways in which urban
   fabrics and their environment, data processing techniques, and weather
   conditions affect the radar signal are examined and discussed. It is
   found that many effects originate from the geometry of urban features,
   as well as their orientation relative to the spacecraft orbit. This
   investigation adds evidence to the fact that specular scattering
   prevails over the diffuse scattering in an urban area. Practical
   conclusions concerning the capabilities and the limitations of ERS-SAR
   imagery are drawn.},
