@inproceedings{ WOS:001792804400027,
Author = {Casagrande, Pedro Benedito and Parisi, Maria Giovana and Mourao Moura,
   Ana Clara and Camargos, Lourdes Manresa and de Magalhaes, Danilo Marques},
Editor = {LaRosa, D and Privitera, R},
Title = {Urban Occupation Potential by UAV Data: Vale do Sereno-Nova Lima/MG},
