@inproceedings{ WOS:001441909800012,
Author = {Singh, Parul and Parashar, Deepanshu},
Editor = {Kumar, M and Kumar, P and Anand, S and Verma, NK and Tripathi, DK},
Title = {Monitoring the Urban Green Spaces and its Influence on the Thermal
   Characteristics Using Remote Sensing: A Case Study of NCT- Delhi},
Booktitle = {GEOGRAPHICAL DIMENSIONS OF ENVIRONMENTAL SUSTAINABILITY, IGU THEMATIC
   CONFERENCE 2022},
Series = {Advances in Geographical and Environmental Sciences},
Year = {2024},
Pages = {197-209},
Note = {2022 International Geographical Union Thematic Conference, Mahendragarh,
   INDIA, NOV 24-25, 2022},
Abstract = {Urban Green Spaces (UGS) is an essential ecosystem variable that
   regulates the urban environment sustainability and keeps the environment
   in check. The growth and distribution of UGSs are directly impacted by
   urban expansion. Monitoring the spatio-temporal changes in UGSs is
   crucial for identifying the direction of urban development since the
   increase in impervious land is closely related to the spatial change in
   green cover. This study examined the UGSs of NCT-Delhi using Moderate
   Resolution Imaging Spectroradiometer (MODIS) data products, i.e.
   Normalized Difference Vegetation Index (NDVI) and Land Surface
   Temperature (LST). These environmental parameters quantify the
   variability in vegetation cover and the thermal characteristics of the
   region. The study's findings show that the surface temperature of
   NCT-Delhi has risen over the past 20 years, with the core city, the
   North East, and the East district experiencing the highest temperatures.
   Due to healthy vegetation cover, the spatiotemporal NDVI analysis
   revealed that the New Delhi and Central Delhi region has a high NDVI.
   The outer regions of the North and NorthWest districts, along with the
   Yamuna flood-plain region, exhibited high NDVI values due to the
   presence of agricultural land. According to the UGSs investigation, from
   2002 to 2022, the vegetation cover over UGSs will become denser. In 20
   years, urbanization has caused an increase in surface temperature in
   UGSs. The study's findings indicate a noticeable increase in the amount
   of greenery in UGSs of NCT-Delhi, which are the results of various
   programmes and initiatives carried out by the Ministry of Environment,
   the Delhi Development Authority, and the Forest Department NCT of Delhi.
   This work can be used as a tool for integrated spatial planning to
   address urban sustainability challenges.},
