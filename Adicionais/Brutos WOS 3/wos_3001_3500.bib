   Khandoker, Tarannum Kalam; Yusufzai, Abdullah O.; Ahmad, Sajjad; Stephen, Haroon, Univ Nevada, Dept Civil \& Environm Engn \& Construct, Las Vegas, NV 89154 USA.},
ISBN = {978-0-7844-8485-2},
Keywords = {Artificial turf; Synthetic grass; Artificial grass; Urban; Thermal;
