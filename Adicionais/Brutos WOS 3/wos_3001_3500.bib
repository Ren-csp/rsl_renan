@article{ WOS:000400196200003,
Author = {Oyibo, Natasha and Weller, Gordon and Watt, John},
Title = {Evaluating lay perceptions of maternal mortality to improve risk
   communication: a case study in Rivers State, Nigeria},
Journal = {GLOBAL PUBLIC HEALTH},
