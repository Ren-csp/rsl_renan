@inproceedings{ WOS:000085488300001,
Author = {Foster, SSD and Morris, BL and Chilton, PJ},
Editor = {Ellis, JB},
Title = {Groundwater in urban development - a review of linkages and concerns},
Booktitle = {IMPACTS OF URBAN GROWTH ON SURFACE WATER AND GROUNDWATER QUALITY},
