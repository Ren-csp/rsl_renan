Title = {Study the Consumption of Resource-Environment for China's Three City
   Group},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {273+},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Urbanization is a big change in form of space organization in human
   society development progress. Back to the tradition agriculture era, the
   city is mainly to undertake the function of concentration of living and
   consumption. After entering the industrialization era, city function has
   changed variously. Not only does the city undertake the function of
   concentration of living and consumption, but also undertake the function
   of concentration of production and pollution. Cities and towns group is
   the outcome of city development in the high level stage, which be made
   up of numerous different scale and function cities in form of space
   organization. Moreover, their function of concentration of production,
   life, consumption and pollution are more powerful than ever. Therefore,
   study consumption of resource and environment of cities and towns is
   great significance for guarantee the sustainable development of city
   group as well as the whole country. In order to measure city's
   consumption of resource and environment in China, this article chooses
   North China, East China and Center South of China as samples, and
   utilizes the resource and environment consumption model of cities and
   towns to measure the consumption of land resource, fresh water resource,
   energy resource and mineral resource, even to measure exhaust emission,
   wastewater discharged and domestic waste production. Conclusions show
   that: 1 The consumption of resource and environment in three zones has a
   clear characteristic of inverse pyramid; 2 their energy and mineral
   consumption, exists a big difference; their resource and environment
   foundation is quite weak.},
