Title = {Emotion Recognition Involving Physiological and Speech Signals: A
   Comprehensive Review},
Booktitle = {RECENT ADVANCES IN NONLINEAR DYNAMICS AND SYNCHRONIZATION: WITH SELECTED
   APPLICATIONS IN ELECTRICAL ENGINEERING, NEUROCOMPUTING, AND
