@inproceedings{ WOS:000077671500021,
Author = {Verfaillie, K},
Editor = {DeKeyser, V and dYdewalle, G and Vandierendonck, A},
Title = {Dynamic perception of dynamics: Object and event perception across
   saccadic eye movements},
Booktitle = {TIME AND THE DYNAMIC CONTROL OF BEHAVIOR},
Year = {1998},
Pages = {345-360},
Note = {Symposium on Time and the Dynamic Control of Behavior, UNIV LIEGE,
   LIEGE, BELGIUM, NOV 07-08, 1994},
Abstract = {An overview is given of experiments on transsaccadic integration
   occurring during visual perception of biological motion. In the
   perception of biological motion, the stimulus information is confined to
   a small number of point lights attached to the major joints of a moving
   human figure. Yet, this minimal stimulus is sufficient for the
   perception of a three-dimensional living creature. Transsaccadic
   integration refers to processes by which the visual system manages (or
   fails) to transfer information from one fixation to the next fixation.
   The experiments indicate that some attributes of the biological motion
   stimulus are maintained accurately fi om one fixation to the next,
   whereas other features are ``forgotten{''} across saccadic eye
   movements.},
