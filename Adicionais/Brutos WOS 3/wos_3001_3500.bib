@inproceedings{ WOS:000179444800129,
Author = {Fiumi, L},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Evaluation of remote sensing data for urban planning. Applicative
   examples on some Italian towns remotely sensed by means of MIVIS sensor.},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1045-1050},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {LARA, namely Airborne Laboratory for Environmental Research, is a
   division of the Atmospheric Pollution Institute of the Italian National
   Research Council; it carries out research activities using remotely
   sensed hyperspectral data acquired by means of MIVIS (Multispectral
   Infrared Visible Imaging Spectrometer).
   In the last years remote sensing methodologies, applied to NIMS
   hyperspectral. data collected over different Italian towns (Rome,
   Naples, Wan, Verona, etc.), have been developed to discriminate and
   quantify urban elements and materials, like surface coatings, not
   covered structures, urban buildings, depots at open air, vegetation,
   rivers, mobile elements and materials, shaded and sunny areas.
   Classification methodologies developed through the analysis of spectral
   responses, besides to recognize building elements with utmost accuracy,
   are also able to discriminate the slightest variations of covering
   surfaces and distinguish a wide range of sub-classes stressing the
   typological characteristics of covering materials (bricks, grits,
   copper, lead, etc.). In particular a study aiming to assess the
   potentiality of MIVIS hyperspectral data to map covering surfaces and
   monitor a sub-urban area of Rome, with a special attention to
   asbestos-cement coatings, will be here presented.
   The results of this study could be particularly useful for
   policy-makers, as public administrations, from ministries to local
   authorities that need to know more and more accurately territory under
   their jurisdiction. Actually MIVIS remotely sensed data have been
   already applied successfully to monitor urban environment, and these
   remarkable results encourage continuing on using this methodology and
   further improve it.
   Therefore, LARA research group contributes in resolving
   urban/territorial problems by providing innovative instruments and
   methodologies to monitor efficaciously urban environment, developing
   comparative, synchronous and diachronic analyses on conditions of
   cities, focusing its investigations on very topical themes, such as
   policy for environmental protection and energy saving, safeguard of
   artistic and archaeological heritage, comfort standard in new
   residential quarters, industrial production and craftsmanship
   preservation.},
