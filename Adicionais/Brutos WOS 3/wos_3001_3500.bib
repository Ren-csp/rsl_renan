   Univ Toronto, Dept Psychol, Toronto, ON M5S 1A1, Canada.
   Univ Toronto, Dept Surg, Toronto, ON, Canada.
   Univ Toronto, Dept Pediat, Toronto, ON, Canada.},
DOI = {10.1017/S1355617700666067},
