@article{ WOS:A1994NN06400033,
Author = {SAMARAS, Z and ZIEROCK, KH},
Title = {EVOLUTION OF ROAD TRAFFIC EMISSIONS IN URBAN AREAS OF THE
   EUROPEAN-COMMUNITY},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1994},
Volume = {147},
Pages = {253-261},
Month = {MAY 23},
Note = {4th International Symposium on Highway Pollution, MADRID, SPAIN, MAY
   18-22, 1992},
Abstract = {The aim of this paper is to assess the evolution of road traffic
   emissions in the urban areas of the European Community between the years
   1985 and 2000. The work is based on a study carried out for the
   Commission of the European Community (DG XI) with regard to the expected
   evolution of traffic produced emissions in total. The projection
   calculations have been carried out with a computer programme (called
   FOREMOVE), also developed as a part of this study. The results,
   comparatively displayed for two scenarios, show that the introduction of
   the best available technology for on-board emission control as recently
   adopted at the EC level is able to substantially decrease road traffic
   emissions, especially when coupled to improvements in fuel properties.
   Moreover, the positive impacts of reduced vehicle usage (implemented
   either through administrative restrctions or by economic measures) are
   also shown to be of importance. Finally, a comparison between the
   expected specific emissions of a number of major urban agglomerations of
   the European Community is attempted and proposals for future policy and
   target setting are made.},
