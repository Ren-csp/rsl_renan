@inproceedings{ WOS:000079630400350,
Author = {Hida, E and Saito, H and Ohno, H and Odajima, K and Tamanoi, D},
Editor = {Usui, S and Oori, T},
Title = {Neural correlate for the perception of two-directional transparent
   visual flow},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {1551-1554},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {We investigated neural basis for the perception of visual flow composed
   of two independent sets of random checker patterns moving in different
   directions by comparing human performances with neural responses of
   macaque MST area. Human observers perceived superposed two sets of
   visual flows as two independent coherent wide-field motion irrespective
   of their speed. When the speed of patterns was slowed, the difference
   between perceived direction of two coherent motion was reported to be
   larger than actual difference between superposed test patterns.
   Monitoring the eye movement during the psychophysical experiment did not
   indicate ocular following responses triggered by the visual flow. The
   tuning curve of directionally selective cells of MST area was shifted to
   the opposite the direction of nearby superposed moving patterns. These
   results suggest that modulation of the directional tuning by the
   presence of another coherent motion plays a crucial role in the
   degradation of performances in the case of slower movement of test
   stimulus.},
