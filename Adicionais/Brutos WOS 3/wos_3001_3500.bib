@article{ WOS:A1994NU60200005,
Author = {HOYDYSH, WG and DABBERDT, WF},
Title = {CONCENTRATION FIELDS AT URBAN INTERSECTIONS - FLUID MODELING STUDIES},
Journal = {ATMOSPHERIC ENVIRONMENT},
