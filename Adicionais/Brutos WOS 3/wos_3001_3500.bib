   Chen, Meng and Liu, Yan and Zhong, Ning},
Editor = {Ascoli, GA and Hawrylycz, M and Ali, H and Khazanchi, D and Shi, Y},
Title = {Human Emotion Variation Analysis Based on EEG Signal and POMS Scale},
Booktitle = {BRAIN INFORMATICS AND HEALTH},
