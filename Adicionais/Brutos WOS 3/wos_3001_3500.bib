@article{ WOS:000452726700010,
Author = {Minkler, Meredith and Estrada, Jessica and Thayer, Ryan and Juachon,
   Lisa and Wakimoto, Patricia and Falbe, Jennifer},
Title = {Bringing Healthy Retail to Urban ``Food Swamps{''}: a Case Study of
   CBPR-Informed Policy and Neighborhood Change in San Francisco},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
Year = {2018},
Volume = {95},
