@inproceedings{ WOS:000450565500034,
Author = {Ceron, R. and Ceron, J. and Aguilar, C. and Montalvo, C. and Muriel, M.
   and Cordova, A. and Carballo, C. and Cruz, G. and Gallegos, C. and
   Perez, J.},
Editor = {GalianoGarrigos, A and Brebbia, CA},
Title = {Mapping an urban ecosystem service: quantifying carbon storage in soils
   at an island-city on a wide scale},
Booktitle = {SUSTAINABLE CITY XI},
