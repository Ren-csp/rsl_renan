@inproceedings{ WOS:000172010200013,
Author = {Allman, JM and Hakeem, A and Erwin, JM and Nimchinsky, E and Hof, P},
Editor = {Damasio, AR and Harrington, A and Kagan, J and McEwen, BS and Moss, H and Shaikh, R},
Title = {The anterior cingulate cortex - The evolution of an interface between
   emotion and cognition},
Booktitle = {UNITY OF KNOWLEDGE: THE CONVERGENCE OF NATURAL AND HUMAN SCIENCE},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2001},
Volume = {935},
