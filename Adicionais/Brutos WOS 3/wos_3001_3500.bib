@inproceedings{ WOS:000681358200031,
Author = {Zhang, Chuting and Shi, Wenbin and Yeh, Chien-Hung},
Book-Group-Author = {IEEE},
Title = {Investigating Variational Phase-Amplitude Coupling in EEG-based Emotion
   Recognition},
