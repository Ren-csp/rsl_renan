@article{ WOS:000387908800004,
Author = {Hoppe, Ulrich and Hocke, Thomas and Mueller, Alexander and Hast, Anne},
Title = {Speech Perception and Information-Carrying Capacity for Hearing Aid
   Users of Different Ages},
Journal = {AUDIOLOGY AND NEURO-OTOLOGY},
Year = {2016},
