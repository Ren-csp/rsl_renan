@inproceedings{ WOS:001544321500036,
Author = {Banerjee, Premankur and Cherin, Jason and Upadhyay, Jayati and Finley,
   James and Kutch, Jason and Culbertson, Heather},
Editor = {Marchal, M and Kajimoto, H and Lopes, P and Pacchierotti, C and Basdogan, C and Gori, M and Lemaire-Semail, B},
Title = {Perception and Control of Surfing in Virtual Reality Using a 6-DoF
   Motion Platform},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
   INTERACTION, EUROHAPTICS 2024, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {14769},
Pages = {455-468},
Note = {14th International Conference on Human Haptic Sensing and Touch Enabled
   Computer Applications-EuroHaptics, Lille, FRANCE, JUN 30-JUL 03, 2024},
Abstract = {The paper presents a system for simulating surfing in Virtual Reality
   (VR), emphasizing the recreation of aquatic motions and user-initiated
   propulsive forces using a 6-Degree of Freedom (DoF) motion platform. We
   present an algorithmic approach to accurately render surfboard
   kinematics and interactive paddling dynamics, validated through
   experimental evaluation with N = 17 participants. Results indicate that
   the system effectively reproduces various acceleration levels, the
   perception of which is independent of users' body posture. We
   additionally found that the presence of ocean ripples amplifies the
