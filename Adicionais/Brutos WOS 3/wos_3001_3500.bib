@inproceedings{ WOS:000380508700021,
Author = {Soemarno, Ispurwono and Sudarma, Erwin},
Editor = {VanEgmond, E and Thompson, K},
Title = {The implication of small scale land sub-division for formal housing
   towards sustainable living and environment},
Booktitle = {GREEN ARCHITECTURE FOR SUSTAINABLE LIVING AND ENVIRONMENT},
Series = {Procedia Social and Behavioral Sciences},
Year = {2015},
Volume = {179},
Pages = {230-236},
Note = {Green Architecture for Sustainable Living and Environment, Bali,
   INDONESIA, NOV 29-29, 2014},
Organization = {Inst Technol Sepuluh Nopember ITS Surabaya, Fac Civil Engn \& Planning,
   Dept Architecture},
Abstract = {Research on Indonesian housing market in 1990 showed that at least 85\%
   of the housing stock, was produced independently. This includes the
   procurement of resources and construction. Small scale land sub-division
   for informal urban housing usually happen when the price of agricultural
   products could not cope with the production cost. The narrow plots of
   agricultural land available for conversion are usually yielding only 20
   45 housing units. The procurement patterns of this kind is to provide
   low-cost housing for low income people. However, some important facets
   were not given enough attention or not widely known. As a result there
   are no policies or interventions to reduce problems for future residents
   from such a housing procurement pattern. In terms of orderly urban
   development, there are problems associated with this kind of housing
   procurement. Street patterns do not always support the existing roads
   system, the unavailability of adequate public infrastructure, and the
   safety and comfort of occupants are neglected factors. This study
   challenges that a pattern of land acquisition for self-help housing is
   inevitable. If such patterns are recognized, accommodated and united
   with the development of general urban housing patterns, it will
   undoubtedly contribute to the benefit of all parties, especially those
   who need homes but faces financial limitations. This research is
   particularly relevant in the context of sustainable development. The
   pattern of self-help housing land acquisition will support effective
   spatial planning to minimize the problem, especially in terms of access
   to services and housing infrastructure, as well as the comfort and
   safety of the occupants. (C) 2015 Published by Elsevier Ltd.},
