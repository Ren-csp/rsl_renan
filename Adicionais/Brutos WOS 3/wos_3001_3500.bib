@article{ WOS:000431743400145,
Author = {Wulandari, Retno and Suryaningsih, Sukarni and Zamzami, M. Irfan and
   Pratama, Rifka},
Title = {Perception of Indonesian Young Generation on Javanese Coastal Culinary
   Tradition and American Fast Food},
