@article{ WOS:A1993MA14800028,
Author = {DEMPSEY, BA and TAI, YL and HARRISON, SG},
Title = {MOBILIZATION AND REMOVAL OF CONTAMINANTS ASSOCIATED WITH URBAN DUST AND
   DIRT},
Journal = {WATER SCIENCE AND TECHNOLOGY},
