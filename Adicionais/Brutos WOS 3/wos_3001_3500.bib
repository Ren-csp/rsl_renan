@article{ WOS:000226399200007,
Author = {Pahl-Wostl, C},
Title = {Information, public empowerment, and the management of urban watersheds},
Journal = {ENVIRONMENTAL MODELLING \& SOFTWARE},
Year = {2005},
Volume = {20},
