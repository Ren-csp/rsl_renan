@inproceedings{ WOS:A1996BJ20B00457,
Author = {Murray, IR and Arnott, JL},
Editor = {Bunnell, HT and Idsardi, W},
Title = {Synthesizing emotions in speech: Is it time to get excited?},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {1816-1819},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Modern speech synthesis systems with very high intelligibility are
   readily available in a number of languages. However, the output from all
   present systems is still readily identifiable as being machine-generated
   - the output does not sound `'natural''. One aspect of naturalness is
   the variability introduced by the emotional state of the speaker, and
   related pragmatic effects; no current commercial systems include such
   variation. Comparatively little work has been done to investigate how a
   speaker's emotional state creates variation in the speech signal, and
   this work has traditionally been performed by psychologists and has
   remained distinct from mainstream speech science. Current research
   suggests that there will be considerable effort involved in producing
   any accurate description of pragmatic variations in speech, but there
   has recently been increasing interest in this area due to potential
   applications in many branches of speech technology.
   This paper describes a prototype system which has been constructed to
   simulate emotion in speech synthesized by rule. The system is based on
   emotion information from the literature, and it simulates a range of
   emotions using a commercial synthesiser. The use of emotion models and
   their applicability in the area of speech technology is discussed.
   The limitations of our current knowledge in the area of vocal emotion
   are discussed, and suggestions are presented for future research in this
   area.},
Publisher = {I E E E},
Address = {345 E 47TH ST, NEW YORK, NY 10017},
Type = {Proceedings Paper},
Language = {English},
