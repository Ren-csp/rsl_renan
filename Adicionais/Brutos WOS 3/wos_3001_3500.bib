@inproceedings{ WOS:000171527100014,
Author = {Umenne, SI},
Editor = {Villacampa, Y and Brebbia, CA and Uso, JL},
Title = {The ecology of Kenyan municipal centers: a case study of Nairobi},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT III},
