Organization = {WHO European Off},
Abstract = {TEE is an innovative emission model aimed at providing detailed
   calculation of the several factors influencing vehicles fuel consumption
   and pollutant emissions. The current model performs a microscopic
   analysis of traffic hows at street level, but a parallel version is
   being extended to the city case, in the framework of a cooperation with
   INRETS. In this paper the main features of the TEE model are described,
   together with the initial test cases performed for the operational
   assessment of the software: a stretch of a highway, a toll station and
   an urban road with multifloor parking.},
