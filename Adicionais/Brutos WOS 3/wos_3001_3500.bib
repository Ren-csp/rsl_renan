Title = {Low Impact Development: Development of Design Guideline for Artificial
   Lake toEnhance Groundwater Recharge in Urban Planning},
Booktitle = {ENERGY, ENVIRONMENT, ECOSYSTEMS, DEVELOPMENT AND LANDSCAPE ARCHITECTURE},
