@inproceedings{ WOS:000552392300154,
Author = {Altarawneh, Lara and Mackee, Jamie and Gajendran, Thayaparan},
Editor = {Amaratunga, D and Haigh, R},
Title = {The influence of cognitive and affective risk perceptions on flood
   preparedness intentions: A dual-process approach},
Booktitle = {7TH INTERNATIONAL CONFERENCE ON BUILDING RESILIENCE: USING SCIENTIFIC
   KNOWLEDGE TO INFORM POLICY AND PRACTICE IN DISASTER RISK REDUCTION},
Series = {Procedia Engineering},
