@article{ WOS:000263306500008,
Author = {Talarico, Jennifer M. and Berntsen, Dorthe and Rubin, David C.},
Title = {Positive emotions enhance recall of peripheral details},
Journal = {COGNITION \& EMOTION},
Year = {2009},
Volume = {23},
Number = {2},
Pages = {380-398},
Note = {17th Annual Meeting of the American-Psychological-Society, Los Angeles,
   CA, MAY 28, 2005},
Organization = {Amer Psychol Soc},
Abstract = {Emotional arousal and negative affect enhance recall of central aspects
   of an event. However, the role of discrete emotions in selective memory
   processing is understudied. Undergraduates were asked to recall and rate
   autobiographical memories of eight emotional events. Details of each
   memory were rated as central or peripheral to the event. Significance of
   the event, vividness, reliving and other aspects of remembering were
   also rated for each memory. Positive affect enhanced recall of
   peripheral details. Furthermore, the impairment of peripheral recall was
   greatest in memories of anger, not of fear. Reliving the experience at
   retrieval was negatively correlated with recall of peripheral details
   for some emotions (e.g., anger) but not others (e.g., fear),
   irrespective of similarities in affect and intensity. Within
   individuals, recall of peripheral details was correlated with less
   belief in the memory's accuracy and more likelihood to recall the memory
   from one's own eyes (i.e., a field perspective).},
Publisher = {PSYCHOLOGY PRESS},
Address = {27 CHURCH RD, HOVE BN3 2FA, EAST SUSSEX, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Talarico, J (Corresponding Author), Lafayette Coll, Dept Psychol, 307 Oechsle, Easton, PA 18042 USA.
   Talarico, Jennifer M., Lafayette Coll, Dept Psychol, Easton, PA 18042 USA.
   Berntsen, Dorthe, Univ Aarhus, Aarhus, Denmark.
   Rubin, David C., Duke Univ, Durham, NC USA.},
DOI = {10.1080/02699930801993999},
Article-Number = {PII 793772519},
