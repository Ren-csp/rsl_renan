@inproceedings{ WOS:000312386000199,
Author = {Dai, H. L. and Zhang, K. L. and Xu, X. L. and Yu, H. Y.},
Editor = {Yang, Z and Chen, B},
Title = {Evaluation on the Effects of Deicing Chemicals on Soil and Water
   Environment},
Booktitle = {18TH BIENNIAL ISEM CONFERENCE ON ECOLOGICAL MODELLING FOR GLOBAL CHANGE
   AND COUPLED HUMAN AND NATURAL SYSTEM},
