@inproceedings{ WOS:000323984200260,
Author = {Boloorizadeh, Padideh and Tojari, Farshad},
Editor = {Uzunboylu, H and Demirok, M},
Title = {Facial expression recognition: age, gender and exposure duration impact},
Booktitle = {3RD WORLD CONFERENCE ON PSYCHOLOGY, COUNSELING AND GUIDANCE, WCPCG-2012},
Series = {Procedia Social and Behavioral Sciences},
Year = {2013},
Volume = {84},
Pages = {1369-1375},
Note = {3rd World Conference on Psychology, Counselling and Guidance (WCPCG),
   Efes, TURKEY, MAY 09-12, 2012},
Abstract = {Successful navigation of social interactions often needs rapid and
   accurate identification of other's emotions. There are six universally
   recognized emotions shown through facial expressions: fear, anger,
   surprise, disgust, happiness and sadness. Emotions begin so quickly that
   sometimes our conscious self cannot participate in detecting them. That
