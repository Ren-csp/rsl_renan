@inproceedings{ WOS:000257930800021,
Author = {Roehr, Daniel and Laurenz, Jon},
Editor = {Panagopoulos, T and Burley, JB},
Title = {Greening the urban fabric:: Contribution of green surfaces in reducing
   CO2 emissions},
Booktitle = {PROCEEDINGS OF THE 1ST WSEAS INTERNATIONAL CONFERENCE ON LANDSCAPE
   ARCHITECTURE (LA `08): NEW ASPECTS OF LANDSCAPE ARCHITECTURE},
Series = {Energy and Environmental Engineering Series},
Year = {2008},
Pages = {140-146},
Note = {1st WSEAS International Conference on Landscape Architecture (LA 2008),
   Univ Algarve, Algarve, PORTUGAL, JUN 11-13, 2008},
Organization = {Taylors Port; Centro Ciencia Vivo Algarve; Centro Invest Espaco
   Organizacoes; Fundacao Calouste Gulbenkian; Espaco Aberto; Delta;
   Alportel; FCT},
Abstract = {This research focuses on the potential contribution of green surfaces
   {[}green roofs and green facades] in reducing CO2 emissions as applied
   to the city core of Vancouver, Canada. This includes an analysis of
   their influence in reducing the energy demand by buildings and in food
   production, as well as in the capacity of greenery to trap air
   pollutants such as CO2. It applies the Seattle Green Factor for greening
   the urban fabric.
   The research compiles findings from previous studies on urban forest,
   green roofs, green walls and food production, which forms the basis of
   this research. From this analysis it identifies the contribution of
   green surfaces to the urban environment, providing specific data on the
   influence towards reducing CO2.
   Obtained data shows that the contribution towards reducing CO2 emissions
   of the proposed green surfaces includes a 15\% reduction in CO2
   generated for cooling buildings; a 3\% reduction of the energy required
   for transporting food by growing it on green rooftops; and another 2\%
   via CO2 uptake by the greenery. The research suggests that such green
   interventions could contribute significantly in reducing CO2 emissions
   of cities, especially by reducing the energy demand by buildings and
   food production. This would also contribute to a reduction in cities'
   fossil fuel dependency.},
