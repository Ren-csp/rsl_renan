@inproceedings{ WOS:000236397600067,
Author = {Nash, DA and Pratt, DR and Kendall, TM},
Book-Group-Author = {IEEE Comp Soc},
Title = {Entity-level simulation of urban operations},
Booktitle = {Proceedings of the HPCMP, Users Group Conference 2005},
Year = {2005},
Pages = {428-432},
Note = {Annual Conference on High Performance Computing Modernization Program,
   Nashville, TN, JUN   27, 2005-JUN 30, 2006},
Organization = {DoD Sci \& Technol Comm; User Advocacy Grp; HPCMPO Outreach Team; US
   Dept Defense; UGC},
Abstract = {High-resolution simulation of operations in an urban setting is of great
   interest to commanders, planners, and analysts at all levels. However,
   the computational resources needed to represent the urban environment
   adequately can be high. As well, the behavior of noncombatant entities
   in the urban environment can be challenging to portray, given its
   frequently chaotic, uncoordinated nature. Urban operations generally
   take place against a backdrop of large numbers of unsynchronized
   entities, each engaged in various ``milling{''} behaviors, as well as
   some smaller number of entities engaged in commanded behaviors. The flow
   of entities through the urban terrain over the course of time is by
   itself of interest in the context of traffic modeling, and in the
   identification of potential chokepoints. In addition to their default
   behaviors, a realistic simulation of urban environments must include
   reasonable responses of crowd entities to events that are likely to be
   of global interest as well.
   OneSAF Objective System (OOS) is the Army's next-generation constructive
   simulation, and will be deployed in October 2005. We describe the
   results of a research effort to discover the mechanisms needed to
   create, manipulate, and analyze large numbers of entities in an urban
   context, using OOS with DoD high performance computing resources. The
   Army Research Laboratory's ``Powell{''} Linux cluster was used to
   evaluate the performance of technologies developed to adequately
   represent the default behaviors of urban non-combatants, as well as
   their responses to events of interest (e.g. detonations, weapons fire,
   and distribution of aid or supplies). A discussion of the associated
   technical challenges is provided, including network configuration,
   master/slave synchronization, stimulus/response architecture, headless
   operation, and tools development.},
