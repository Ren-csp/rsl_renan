@inproceedings{ WOS:000256985800002,
Author = {Kviberg, K.},
Editor = {Aravossis, K and Brebbia, CA and Gomez, N},
Title = {Value and price: a transdisciplinary approach to urban water management},
Booktitle = {ENVIRONMENTAL ECONOMICS AND INVESTMENT ASSESSMENT II},
