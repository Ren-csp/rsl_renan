@inproceedings{ WOS:000437022400042,
Author = {Lasco, Jonathan David D. and Maidment, David R. and Hodges, Ben R.},
Editor = {Kamojjala, S},
Title = {A New Approach for Generating Flow Directions in Urban Watersheds},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2018: WATERSHED
   MANAGEMENT, IRRIGATION AND DRAINAGE, AND WATER RESOURCES PLANNING AND
   MANAGEMENT},
