@article{ WOS:A1997XM37000001,
Author = {Vakoch, DA and Wurm, LH},
Title = {Emotional connotation in speech perception: Semantic associations in the
   general lexicon},
Journal = {COGNITION \& EMOTION},
Year = {1997},
Volume = {11},
Number = {4},
Pages = {337-349},
Month = {JUL},
Note = {128th Meeting of the Acoustical-Society-of-America, AUSTIN, TX, DEC 02,
   1994},
Organization = {Acoust Soc Amer},
Abstract = {Lexical access of emotion words has been shown to depend on three
   underlying dimensions (Evaluation, Activity, and Potency). The
   importance of these dimensions of emotional connotation was assessed
   during on-line speech perception of words drawn from the general
   lexicon. Lexical decision times were significantly predicted by main
   effects of Evaluation and Potency, as well as by an Evaluation x
   Activity interaction and an Evaluation x Potency interaction. An
   evolutionary account is proposed to explain the differential processing
   of words in the general and affective lexica. Whereas the affective
   lexicon seems to be structured to avoid threats to the individual, the
   general lexicon appears to be designed for obtaining scarce but valuable
   resources.},
