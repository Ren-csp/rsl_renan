@inproceedings{ WOS:000257702400034,
Author = {Crobeddu, E. and Allali, S. and Bennis, S.},
Editor = {Rico, DP and Brebbia, CA and Esteve, YV},
Title = {Washoff model of total suspended particles in urban areas},
Booktitle = {WATER POLLUTION IX},
