@inproceedings{ WOS:000072557300057,
Author = {Puce, A and McCarthy, G and Bentin, S and Allison, T},
Editor = {Koga, Y and Nagata, K and Hirata, K},
Title = {ERP and functional MRI studies of face perception in human ventral
   visual cortex},
Booktitle = {BRAIN TOPOGRAPHY TODAY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1997},
Volume = {1147},
Pages = {329-333},
Note = {III Pan-Pacific Conference on Brain Topography (BTOPPS III), TOKYO BAY,
   JAPAN, APR 01-04, 1997},
Abstract = {Face perception is presumed to use specialized circuitry in the human
   visual cortex, however, the nature of this circuitry and its anatomical
   configuration is not well-understood. Faces elicit focal intracranial
   field potentials (N200s) from the fusiform and inferior temporal gyri of
   patients with chronically implanted electrodes. Faces also produce
   N200-like scalp potentials (N170s) which are largest at T6 and T5.
   Functional magnetic resonance imaging (fMRI) studies efface perception
   show activation of the fusiform gyri in normal subjects. Face parts also
   evoke N170s at T6 and T5, with eyes eliciting the largest event-related
   potential (ERP) followed by full-faces, lips, and noses. Intracranial
   face-specific N200 electrode sites show similar amplitude differences
   among face parts, however, full faces usually produce larger N200s than
   eyes do. The voltage distribution of the scalp N170 to eyes is
   consistent with a generator located in either the occipitotemporal
   sulcus lateral to the face N200 generator in the fusiform gyrus, or from
   the lateral occipitotemporal cortex. These results suggest the presence
   of at least two cortical regions, one engaged in the perception of whole
   faces and another engaged in the perception of internal facial features.},
