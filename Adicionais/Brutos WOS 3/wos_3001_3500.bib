@inproceedings{ WOS:000428143200022,
Author = {Wu, Si-Yuan and Schaefer, Moritz and Zheng, Wei-Long and Lu, Bao-Liang
   and Yokoi, Hiroshi},
Book-Group-Author = {IEEE},
Title = {Neural Patterns between Chinese and Germans for EEG-based Emotion
   Recognition},
Booktitle = {2017 8TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2017},
Pages = {94-97},
Note = {8th International IEEE/EMBS Conference on Neural Engineering (NER),
   Shanghai, PEOPLES R CHINA, MAY 25-28, 2017},
Organization = {IEEE; EMBS},
Abstract = {This paper aims to explore the neural patterns between Chinese and
   Germans for electroencephalogram (EEG)-based emotion recognition. Both
   Chinese and German subjects, wearing electrode caps, watched video
   stimuli that triggered positive, neutral, and negative emotions. Two
   emotion classifiers are trained on Chinese EEG data and German EEG data,
   respectively. The experiment results indicate that: a) German neural
   patterns are basically in accordance with Chinese ones; b) the main
   difference lies in the upper temporal region in Delta band which
   activates more when a German is in positive mood; and c) the Chinese
   positive emotion achieves the best accuracy while German emotions share
   the approximate accuracy. Moreover, Gamma band serves as the critical
   band for both German and Chinese emotion recognition.},
