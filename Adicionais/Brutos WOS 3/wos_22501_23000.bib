@inproceedings{ WOS:000085856900066,
Author = {Daugherty, PJ},
Book-Group-Author = {SAF
   SAF},
Title = {Goals for ecosystem management: The need for specificity?},
Booktitle = {PROCEEDINGS OF THE 1996 SOCIETY OF AMERICAN FORESTERS CONVENTION:
   DIVERSE FORESTS, ABUNDANT OPPORTUNITIES, AND EVOLVING REALITIES},
Year = {1996},
Pages = {344-349},
Note = {1996 National Convention of the Society-of-American-Foresters,
   ALBUQUERQUE, NM, NOV 09-13, 1996},
Organization = {Soc Amer Foresters},
Abstract = {Ecosystem management is defined as a co-evolving concept or philosophy
   of management emerging from the interaction of society and the
   ecosystem. It is a philosophy which recognizes that the socio-economic
   system is dependent on the ecosystem, and that solutions to ecological
   and socio-economic problems must be developed by working across
   discipline boundaries. The perception that ecosystem management is less
   clear than past management concepts is challenged. Ecosystem management
   is similar to past guiding concepts in terms of specificity. Goals for
   ecosystem management are discussed, and it is argued that forest
   condition is not a goal. Forest condition functions as a criterion for
   the goal of sustainability. The goals for ecosystem management are
   specific enough to provide direction while allowing for flexibility.
   There remains a need to develop specific goal criteria in analysis and
   decision making, in a manner that includes equitable public involvement.},
