@inproceedings{ WOS:000070984300003,
Author = {Gracco, VL},
Editor = {Hulstijn, W and Peters, HFM and vanLieshout, PHH},
Title = {A neuromotor perspective on speech production},
Booktitle = {SPEECH PRODUCTION: MOTOR CONTROL, BRAIN RESEARCH AND FLUENCY DISORDERS},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1997},
Volume = {1146},
Pages = {37-56},
Note = {3rd International Conference on Speech Motor Production and Fluency
   Disorders, NIJMEGEN, NETHERLANDS, JUN 05-08, 1996},
Organization = {Univ Hosp Nijmegen, Inst Otorhinolaryngol, Dept Voice \& Speech Pathol;
   Nijmegen Inst Cognit \& Informat; Univ Nijmegen, Interfac Res Unit
   Language \& Speech; Univ Hosp Nijmegen, Inst Med Psychol; Univ Congress
   Off},
Abstract = {Speech is one of man's most distinguishing traits. At the core of this
   important communicative behavior is the human nervous system which
   constantly receives, integrates, and exchanges information on the
   various operations carried out through a variety of sensorimotor
   channels. In order to understand speech communication it is essential to
   understand the machine itself, not only at the level of the physical
   apparatus but at the level of the physiological components and
   associated processes. An important assumption is that control principles
   that govern speech and language production and perception are best
   understood and unambiguously inferred from a perspective that is
   grounded in nervous system physiology. The focus of this chapter is to
   outline a theoretical framework for speech production which explicitly
   takes into account the contribution of the anatomy and physiology of the
   speech production mechanism as well as information on general nervous
   system functions and associated regions known to be involved in speech
   and language production.},
