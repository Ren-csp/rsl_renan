@inproceedings{ WOS:000312273000077,
Author = {Yu, Chia-Jen and Kang, Jian},
Editor = {Wu, Y},
Title = {Acoustic Sustainability in Urban Residential Areas},
Booktitle = {2011 3RD INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
