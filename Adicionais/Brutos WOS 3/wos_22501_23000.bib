@article{ WOS:A1991FU28100004,
Author = {STEINER, H and MARX, L and WALTON, C},
Title = {THE WARD ATMOSPHERE OF A CHILD PSYCHOSOMATIC UNIT - A 10-YEAR FOLLOW-UP},
Journal = {GENERAL HOSPITAL PSYCHIATRY},
Year = {1991},
Volume = {13},
Number = {4},
Pages = {246-252},
Month = {JUL},
Note = {1988 ANNUAL MEETING OF THE AMERICAN ACADEMY OF CHILD AND ADOLESCENT
   PSYCHIATRY, SEATTLE, WA, NOV, 1988},
Organization = {AMER ACAD CHILD \& ADOLESCENT PSYCHIAT},
Abstract = {Using the Ward Atmosphere Scale, we reassessed the ward atmosphere of a
   psychosomatic unit for children and adolescents that has been operating
   successfully for 10 years.  There was remarkable stability in essential
   treatment program characteristics despite the complete turnover in
   patients and a 60\% turnover in staff.  There was substantial
   correlation between patient and staff perceptions in 1988 and across
   time (Spearman's rho:  0.951-0.660, all p values < 0.05).  Patients and
   staff subgroups differed somewhat in their relative emphases on certain
   program dimensions but, overall, the program still correlated highly
   with the therapeutic community cluster described by Moos (Spearman's
   rho:  0.660-0.809, all p values < 0.05).  This stability was achieved
   despite multiple health care changes, most notably shortened length of
   stay.  Stability was probably due to high staff/patient ratio,
   continuity of the medical direction, and focus on milieu maintenance in
   staff meetings.},
