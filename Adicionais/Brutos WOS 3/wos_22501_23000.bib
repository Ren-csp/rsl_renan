   Kim, Hyun Taek and Park, Changhoon},
Book-Group-Author = {IEEE},
Title = {Effects of Rest Frames on Cybersickness and Oscillatory Brain Activity},
Booktitle = {2013 IEEE INTERNATIONAL WINTER WORKSHOP ON BRAIN-COMPUTER INTERFACE
   (BCI)},
