   Northwestern Univ, Feinberg Sch Med, Div Gastroenterol, Chicago, IL USA.},
DOI = {10.1016/j.jpsychores.2005.08.009},
ISSN = {0022-3999},
EISSN = {1879-1360},
Keywords = {peptic ulcer; stress; health risk behaviors; Helicobacter pylori;
   nonsteroidal anti-inflammatory drugs},
