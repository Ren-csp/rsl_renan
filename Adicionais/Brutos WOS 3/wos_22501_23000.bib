Title = {A database for emission in a multi-sources area},
Booktitle = {AIR POLLUTION V},
Year = {1997},
Pages = {755-766},
Note = {5th International Conference on Air Pollution - Modelling, Monitoring
   and Management (AIR POLLUTION V), BOLOGNA, ITALY, SEP 16-18, 1997},
Organization = {Wessex Inst Technol, Southampton; CNR, Ist Studio Fenomeni Fis \& Chim
   Bassa Alta Atmosfera, Bologna},
Abstract = {Industrial, civil and traffic pollution has been growing from many years
   in most Italian areas. Consequently a first guess pollution estimate is
   then required in the awareness that a valid perception of the global
   emission discussion is more important than a more complex and reliable
   approach for a particular subset of the system. The present study
   suggests a method for a simple database construction, oriented to
   emission evaluation in cases of scarce and inhomogeneous information.
   Basic information comes from public domain sources whereas experts
   mainly support data relations: the design of the database is ordered
   with the purposes and objectives of a project analysis. The method has
   been used to estimate the Esino area (near Ancona-Italy) SOx and NOx
   emissions from industrial, traffic and residence heating sources and to
   show how identification of multiple paths for pollution estimates can
   increase reliability on emission evaluation.},
