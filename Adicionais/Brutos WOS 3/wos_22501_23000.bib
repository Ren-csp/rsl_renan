@article{ WOS:A1994NN06400012,
Author = {MCCRAE, IS and WILLIAMS, ID},
Title = {ROAD TRAFFIC POLLUTION AND PUBLIC NUISANCE},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1994},
Volume = {147},
