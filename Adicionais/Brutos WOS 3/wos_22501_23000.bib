@article{ WOS:000072535100010,
Author = {Jamner, LD and Girdler, SS and Shapiro, D and Jarvik, ME},
Title = {Pain inhibition, nicotine, and gender},
Journal = {EXPERIMENTAL AND CLINICAL PSYCHOPHARMACOLOGY},
Year = {1998},
Volume = {6},
Number = {1},
Pages = {96-106},
Month = {FEB},
Note = {Annual Meeting of the American-Psychosomatic-Society, NEW ORLEANS,
   LOUISIANA, MAR, 1994},
Organization = {Amer Psychosomat Soc},
Abstract = {The ability of nicotine to decrease sensitivity to pain in humans has
   been a subject of dispute. Decreased sensitivity has been demonstrated
   in studies involving men, whereas the effect has been less obvious or
   absent in studies involving predominantly, or entirely, women, To
   determine whether there are gender differences in nicotine's hypoalgesic
   actions, ratings of electrocutaneous stimulation were obtained from 30
   male and 44 female smokers and nonsmokers under placebo and nicotine
   conditions. Nicotine increased the pain threshold and tolerance ratings
   of men but had no effect on the pain ratings of women. among men, there
   was no effect of smoking history, suggesting that the changes in pain
   perception reflect a direct pain-inhibitory effect of nicotine rather
   than a relief from acute nicotine withdrawal. Nicotine had no effect on
   mood or task ratings. indicating that the antinociceptive effects
   observed were not due to nicotine's putative mood effects.},
