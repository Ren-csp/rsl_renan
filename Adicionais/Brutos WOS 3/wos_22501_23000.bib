@inproceedings{ WOS:000227337900062,
Author = {Bature, R and Sani, H and Salihu, A and Idogho, O},
Book-Group-Author = {MEDIMOND},
Title = {Working with Moslem traditional leaders to reduce HIV-related stigma in
   Northern Nigeria},
Booktitle = {XV INTERNATIONAL AIDS CONFERENCE: POLICY AND PROGRAM IMPLEMENTATION},
Year = {2004},
Pages = {307-310},
Note = {15th International AIDS Conference, Bangkok, THAILAND, JUL 11-17, 2004},
Abstract = {Northern Nigeria is a closed community based on strict Islamic values.
   Stigma related to HIV/AIDS represents one of the major challenges faced
   by HIV/AIDS prevention and care programmes in Northern Nigeria. To reach
   such communities, paramount traditional leaders in the North were
   identified and contacted to support the fight against stigma given their
   status and importance. Key objectives were to improve communication
   channels between PLWHAs and community leaders, to support the
   establishment of support groups and to encourage traditional leaders to
   openly demonstrate support for PLWA. Involvement of traditional leaders
   in the fight against stigma has enhanced dissemination of information
   and has helped in clearing negative perceptions on stigma. In closed
   communities such as that in Northern Nigeria, traditional rulers can be
   the right channels to use to reach the general populace in these regions
   especially as information coming from other sources is viewed with
   suspicion as part of the `western agenda'.},
