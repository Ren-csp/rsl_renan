Author = {Osman, Ismah and Rosman, Herwina and Ahmad, Noryati and Mokhtar, Imani
   and Setapa, Fatimah and Ali, Husniyati},
Title = {Corporate Image and the Degree of Elaboration Towards Preference in
   Islamic Banking},
