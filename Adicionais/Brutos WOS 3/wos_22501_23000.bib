@article{ WOS:000469777600005,
Author = {Carvalho, Antonio and Ferrinho, Paulo and Craveiro, Isabel},
Title = {Towards post-colonial capacity-building methodologies - some remarks on
   the experiences of health researchers from Mozambique and Angola},
Journal = {CIENCIA \& SAUDE COLETIVA},
