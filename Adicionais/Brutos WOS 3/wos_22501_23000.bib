@article{ WOS:000383113900148,
Author = {Fitri, Rani Agias and Lena and Sharron and Wardhana, Nanda Agastya},
Title = {Stress and Aggression of Motorcyclists in Jakarta},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {5-6, SI},
Pages = {1707-1710},
Month = {MAY-JUN},
Note = {International Symposium on Social Sciences, Arts and Humanities
   (SYSSARM), Bali, INDONESIA, SEP 29-OCT 01, 2015},
Abstract = {Over the years there has been a rapid growth of motorcycle ownership in
   Jakarta and, consequently, this would promote an increase in the total
   of traffic accidents. There were many elements that contributed to a
   traffic accident. Generally, the accident was caused by the aggression
   of the motorcyclist himself. The aggression behavior itself was usually
   correlated to stress, where stress would trigger the aggression
   behavior. This research was conducted to know how the stress contributed
   to the aggression. Using Buss Perry Aggression Questionnaire (AO) and
   Perceived Stress Scale (PSS), we conducted data collection on 208
   motorcyclists in Jakarta. Based on the data tabulation result, it was
   inferred that stress contributed to motorcyclists aggression amounted to
   14.2\%. However, stress was not sufficient enough to predict the
   aggression of motorcyclist, but also the perception of the situation and
   the coping strategy used would also need to be considered.},
