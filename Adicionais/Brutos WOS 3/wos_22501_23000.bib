@inproceedings{ WOS:000446885600033,
Author = {Tawali, A. B. and Wakiah, N. and Ramli, A. R. and Mahendradatta, M. and
   Tawali, S. and Made, S.},
Book-Group-Author = {IOP},
Title = {Premix formulation for making the Indonesian otak-otak},
