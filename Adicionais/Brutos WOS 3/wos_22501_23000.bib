@inproceedings{ WOS:001747185700227,
Author = {Schulz, Karen and Niemann, Andre and Mietzel, Thorsten},
Editor = {Law, AWK and Er, JW},
Title = {BUILDING TRUST IN MACHINE LEARNING BASED QUALITY CONTROL HAVING NO
   REFERENCE DATA: A CASE STUDY ON WATER LEVEL MEASUREMENTS},
Booktitle = {PROCEEDINGS OF THE 41ST IAHR WORLD CONGRESS},
Series = {IAHR World Congress Proceedings},
Year = {2025},
Pages = {1833-1837},
Note = {41st IAHR World Congress, Singapore, SINGAPORE, JUN 22-27, 2025},
Abstract = {Data quality is fundamental to innovative, data-driven applications.
   Conventional data quality control methods often operate unsupervised and
   without the need for reference data to be considered reliable. Machine
   learning techniques have the potential to significantly improve data
   quality control in the water sector. A key challenge with current
   machine learning methods is their reliance on reference data to build
   trust, which can be difficult to obtain. In this work, we propose the
   concept of synthetic control of model accuracy to tackle this issue,
   which is applied to a real-world example dataset derived from low-cost
   water level sensors. Nevertheless, depending on the application
   scenario, the question remains as to whether these concept is sufficient
   for deploying models without having reference sensors in practice.},
