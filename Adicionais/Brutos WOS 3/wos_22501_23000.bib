Author = {Roberts, JS and Cupples, LA and Relkin, NR and Whitehouse, PJ and Green,
   RC and REVEAL Study Grp},
Title = {Genetic risk assessment for adult children of people with Alzheimer's
   disease: The Risk Evaluation and Education for Alzheimer's Disease
   (REVEAL) study},
