Title = {IMPACT ASSESSMENT OF LARGE HYDROPOWER: THE CASE OF BELO MONTE IN BRAZIL},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
