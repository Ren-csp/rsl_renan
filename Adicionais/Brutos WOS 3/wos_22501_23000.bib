@inproceedings{ WOS:000389498800012,
Author = {Yang, Yang and Feng, Lei and Imamura, Kazuyuki and Yang, Xiaojing and
   Li, Huaizhou and Wang, Gang and Hu, Bin and Lu, Shengfu and Zhong, Ning},
Editor = {Ascoli, GA and Hawrylycz, M and Ali, H and Khazanchi, D and Shi, Y},
Title = {Alterations in Emotional and Salience Responses to Positive Stimuli in
   Major Depressive Disorder},
