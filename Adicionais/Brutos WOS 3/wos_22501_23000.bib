@article{ WOS:000224231900021,
Author = {Dorner, SM and Huck, PM and Slawson, RM and Gaulin, T and Anderson, WB},
Title = {Assessing levels of pathogenic contamination in a heavily impacted river
   used as a drinking-water source},
Journal = {JOURNAL OF TOXICOLOGY AND ENVIRONMENTAL HEALTH-PART A-CURRENT ISSUES},
Year = {2004},
Volume = {67},
Number = {20-22},
