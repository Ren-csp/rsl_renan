   IWA PROGRAMME COMMITTEE},
Title = {Application of physico-chemical parameters and particle-bound biomarkers
   to indicate microbial contamination of aquifers},
Booktitle = {3RD WORLD WATER CONGRESS: DRINKING WATER TREATMENT},
