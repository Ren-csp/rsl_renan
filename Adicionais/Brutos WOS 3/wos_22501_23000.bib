Year = {1998},
Pages = {151-160},
Note = {European Congress of the
   International-Association-for-Landscape-Ecology, MYERSCOUTH COLL,
   PRESTON, ENGLAND, SEP 03-05, 1998},
Organization = {Int Assoc Landscape Ecol},
Abstract = {The landscape approach provides a basis for the perception of the
   surface area as a system of interrelated territorial units with specific
   environmental characteristics, integrating data both on natural
   geoecosystems and human impacts. An hierarchical landscape
   classification is designed as a tree of criteria associated with a
   knowledge base and coupled with cartographic data base in GIS. Each
   level of landscape taxonomy is described by one or several variables,
   which express dominant criteria of territorial differentiation
   (climatic, geomorphologic, ecological and anthropogenic). Historically
   the land use and landscapes of European Russia tended to develop in a
   centrifugal manner. Starting from the end of the 19th century the share
   of agricultural lands has doubled (from 34.6\% to 63.4\% of total area).
   The results of this study comprise maps of present-day landscapes of
   European Russia coupled with the landscape data base, and maps of
   100-year landscape dynamics.},
