   Tatiana S. and Sungurova, Nina L.},
Editor = {Malykh, SB and Nikulchev, EV},
Title = {COPING STRATEGIES OF VIETNAMESE AND RUSSIAN STUDENTS OF AN
   INTERNATIONALLY ORIENTED UNIVERSITY},
Booktitle = {ICPE 2017: INTERNATIONAL CONFERENCE ON PSYCHOLOGY AND EDUCATION},
