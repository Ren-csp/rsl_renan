@inproceedings{ WOS:000303340500026,
Author = {Pace, U. and Schimmenti, V},
Editor = {Zukauskiene, R},
Title = {The relation between sense of spirituality, religiosity and psychosocial
   adjustment in Italian middle adolescents},
Booktitle = {12TH BIENNIAL CONFERENCES OF THE EUROPEAN ASSOCIATION FOR RESEARCH ON
   ADOLESCENCE},
Year = {2010},
Pages = {153-159},
Note = {12th Biennial Conference of the
   European-Association-for-Research-on-Adolescence (EARA), Mykolas Romeris
   Univ, Vilnius, LITHUANIA, MAY 12-15, 2010},
Organization = {European Assoc Res Adolescence (EARA)},
Abstract = {The study examined the relation between spirituality and psychological
   health in Italian middle adolescents. Spiritual and religious issues are
   evidently significant during adolescence development: more than two
   thirds of them believe in gods and between 85\% and 95\% affirm that
   spirituality is important in their life. Moreover, these two constructs
   seem to be associated to low level of psychosocial maladjustment:
   according to literature, spirituality is associated with lower rates of
   substance use among adolescents and the perception of spiritual support
   is associated with lower levels of depressive symptoms. In the present
   study 234 males and females were administered a Spirituality and
   Religious Scale, an adapted version of the Youth Self-Report and the
   Children Depression Inventory. Results showed that the level of
   spirituality was related to general indices of adolescence well-being:
   particularly, adolescents with high level of spirituality evidenced
   lower level of internalizing problem behaviour and depressive symptoms.},
