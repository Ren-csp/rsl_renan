@inproceedings{ WOS:000308718400006,
Author = {De Wrachien, D. and Mambretti, S. and Sole, A.},
Editor = {DeWrachien, D and Proverbs, D and Brebbia, CA and Mambretti, S},
Title = {Mathematical models in flood management: overview and challenges},
