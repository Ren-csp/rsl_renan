@inproceedings{ WOS:001119074200014,
Author = {O'Keefe, Brian and Mastermaker, Michael and Flint, Tom and Resmini,
   Andrea and Chirico, Andrea and Sturdee, Miriam},
Book-Group-Author = {ACM},
Title = {Designing Blended Experiences: Laugh Traders},
Booktitle = {2023 PROCEEDINGS OF THE 15TH CONFERENCE ON CREATIVITY AND COGNITION,
