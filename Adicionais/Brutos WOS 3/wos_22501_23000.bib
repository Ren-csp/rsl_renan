   between organisational justice and work behaviour},
Journal = {APPLIED PSYCHOLOGY-AN INTERNATIONAL REVIEW-PSYCHOLOGIE APPLIQUEE-REVUE
   INTERNATIONALE},
Year = {2006},
Volume = {55},
Number = {4},
