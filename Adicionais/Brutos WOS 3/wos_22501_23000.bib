@inproceedings{ WOS:001616239000072,
Author = {Muli, Irene and Cajander, Asa and Ardabili, Hania Rahimi and Taloyan,
   Marina and Hagglund, Maria},
Editor = {Mantas, J and Hasman, A and Demiris, G and Saranto, K and Marschollek, M and Arvanitis, TN and Ognjanovic, I and Benis, A and Gallos, P and Zoulias, E and Andrikopoulou, E},
Title = {Video Consultations and Environmental Sustainability - Usability's
   Impact on Long-Term Use},
