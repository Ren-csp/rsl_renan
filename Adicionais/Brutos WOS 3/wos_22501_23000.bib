@inproceedings{ WOS:000258121900020,
Author = {Fabiani, Marco and Friberg, Anders},
Editor = {KronlandMartinet, R and Ystad, S and Jensen, K},
Title = {Rule-based expressive modifications of tempo in polyphonic audio
   recordings},
Booktitle = {COMPUTER MUSIC MODELING AND RETRIEVAL: SENSE OF SOUNDS},
Series = {Lecture Notes in Computer Science},
Year = {2008},
Volume = {4969},
