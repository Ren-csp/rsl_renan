@inproceedings{ WOS:000245503900002,
Author = {Copelli, Mauro},
Editor = {Garrido, PL and Marro, J and Torres, JJ},
Title = {Physics of Psychophysics: it is critical to sense},
Booktitle = {Cooperative Behavior in Neural Systems},
