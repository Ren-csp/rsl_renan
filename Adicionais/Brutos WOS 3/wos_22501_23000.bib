@article{ WOS:A1991FP63600027,
Author = {NJIFORTI, H and SCHRADER, TH and TOORNSTRA, FH},
Title = {LEARN - A METHODOLOGICAL CHALLENGE FOR RAPID ENVIRONMENTAL ASSESSMENT},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1991},
Volume = {20},
Number = {1-3},
Pages = {173-181},
Month = {APR},
Note = {INTERNATIONAL CONF ON THE PEOPLES ROLE IN WETLAND MANAGEMENT, LEIDEN,
   NETHERLANDS, JUN 05-08, 1989},
Abstract = {LEARN (Local Environmental Analysis and the assessment of Rural Needs)
   is a new operational research approach, designed to meet three major
   challenges of rural development research:  putting people's priorities
   first, cost-effectiveness, and tackling rural environmental problems. 
   LEARN shares the features of the general methodology of RRA (Rapid Rural
   Appraisal) but is distinctive on some major points.  It proceeds from an
   actor's perspective and is focused on environmental problems.  The
   separation that LEARN makes between the (emic) perception of rural
   people and the researchers' (etic) point of view, is an important
   feature of this approach.  The LEARN approach was first applied in a
   floodplain and a savannah village in the Waza Logone region of North
   Cameroon.  Although LEARN has resulted in more questions than the
   research started with, the new insights and new questions have allowed
   the research team to move towards a better understanding of the
   villagers' problems and towards possible solutions for these problems.},
