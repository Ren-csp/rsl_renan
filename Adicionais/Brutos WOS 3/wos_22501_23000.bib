   D.},
Editor = {Bui, QB and Cajka, R and Tran, MT and Trinh, TA and Yasar, AUH and Wets, G and Woloszyn, M},
Title = {Experimental sensitivity analysis of subsoil-slab behaviour regarding
   degree of fibre-concrete slab reinforcement},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON SUSTAINABLE DEVELOPMENT IN CIVIL, URBAN
   AND TRANSPORTATION ENGINEERING (CUTE 2018)},
