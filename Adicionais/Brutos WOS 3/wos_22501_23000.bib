@inproceedings{ WOS:000320867000017,
Author = {O'Dea, Bridianne and Campbell, Andrew},
Editor = {Hansen, DP and Maeder, AJ and Schaper, LK},
Title = {Healthy Connections: Online Social Networks and their Potential for Peer
   Support},
Booktitle = {HEALTH INFORMATICS: THE TRANSFORMATIVE POWER OF INNOVATION},
Series = {Studies in Health Technology and Informatics},
Year = {2011},
Volume = {168},
Pages = {133-140},
Note = {19th Australian National Health Informatics Conference (HIC), Hlth
   Informat Soc Australia (HISA), Brisbane, AUSTRALIA, AUG 01-04, 2011},
Abstract = {Social and professional support for mental health is lacking in many
   rural areas - highlighting the need for innovative ways to improve
   access to services. This study explores the potential of online social
   networking as an avenue for peer support. Using a cross sectional
   survey, 74 secondary students answered questions relating to internet
   use, online social network use and perceptions of mental health support.
   Over half of the sample had experienced a need for mental health support
   with 53\% of participants turning to the internet. Results indicate that
   online social networking sites were used regularly by 82\% of the sample
   and 47\% believed these sites could help with mental health problems.
   The study concluded that online social networking sites may be able to
   link young people together with others in similar situations. The
   popularity and frequency of use may allow these sites to provide
   information, advice and direction for those seeking help.},
Publisher = {IOS PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
