@inproceedings{ WOS:000447175800017,
Author = {Jannah, E. U. and Muryani, C. and Rindarjono, M. G.},
Editor = {Nandi and Ismail, A and Somantri, L},
Title = {Community-Based Tourism Development at Gajah Mungkur Wonogiri Tourist
   Attraction},
Booktitle = {1ST UPI INTERNATIONAL GEOGRAPHY SEMINAR 2017},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {145},
Note = {1st UPI International Geography Seminar (IGEOS), Bandung, INDONESIA, AUG
   08, 2017},
Abstract = {This study aims to identify: (1) the level and inhibiting factors of
   community participation, 2) the direction of community-based tourism
   development in Wonogiri Multipurpose Dam. The data were collected by
   field observation, documentation, and interviews with stakeholders in
   Wonogiri Multipurpose Reservoir Tourism Area. Data analysis are using
   descriptive qualitative and SWOT analysis accompanied by analysis of
   sustainable tourism development 3A (Attractions, Accessibility,
   Amenitas) as supporting data. The results of this research shows that:
   (1) the level of community participation is still low, and the
   inhibiting factor of public participation is the low of public
   perception about tourism potency and opportunity, the tourism object is
   only centered on one location, and spatial arrangement, (2) based on
