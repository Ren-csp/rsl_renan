@article{ WOS:A1992JA19400002,
Author = {ROSEKIND, MR},
Title = {THE EPIDEMIOLOGY AND OCCURRENCE OF INSOMNIA},
Journal = {JOURNAL OF CLINICAL PSYCHIATRY},
Year = {1992},
