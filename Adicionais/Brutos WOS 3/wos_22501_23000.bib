@inproceedings{ WOS:A1996BG91P00023,
Author = {Cote, M and Lecolinet, E and Cheriet, M and Suen, CY},
Editor = {Simner, ML and Leedham, CG and Thomassen, AJW},
Title = {Using reading models for cursive script recognition},
Booktitle = {HANDWRITING AND DRAWING RESEARCH: BASIC AND APPLIED ISSUES},
Year = {1996},
Pages = {299-313},
Note = {7th Biennial Conference of the International-Graphonomics-Society, UNIV
   W ONTARIO, LONDON, CANADA, AUG, 1995},
Organization = {Int Graphonom Soc},
Abstract = {This paper presents a new perception-based model for reading cursive
   script. The scope of this study is limited to the off-line recognition
   of isolated cursive words. Starting from observations and assumptions
   used in the elaboration of reading models, the organization of this
   pseudo-neuronal system is described and the role of the activation
   mechanism in perceiving and reading cursive script is shown. Some
   characteristics specific to cursive script have been introduced into
   this model. First, appropriate features such as ascenders, descenders
   and loops are used. Second, ambiguity of letter location is managed with
   the introduction of a fuzzy position concept. The location as well as
   the missing letters are deduced from the context (i.e. the word-letter
   lexicon). After implementation of the method, preliminary qualitative
   results have been obtained and are discussed. Further formalizing and
   generalizing of the proposed model on a larger data base is under
   development.},
Publisher = {I O S PRESS},
Address = {VAN DIEMENSTRAAT 94, 1013 CN AMSTERDAM, NETHERLANDS},
