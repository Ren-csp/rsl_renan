@inproceedings{ WOS:000176955200041,
Author = {Mukherjee, GG},
Editor = {Puri, CP and VanLook, PFA and Sachdeva, G and Penhale, C},
Title = {Does the gender of service provider make a difference?},
Booktitle = {SEXUAL AND REPRODUCTIVE HEALTH, VOL II: RECENT ADVANCES, FUTURE
   DIRECTIONS},
Year = {2001},
Pages = {521-524},
Note = {International Conference on Sexual and Reproductive Health, MUMBAI,
   INDIA, 1998},
Organization = {Indian Soc Stud Reproduct \& Fertil; UNDP; UNFPA; WHO; World Bank
   Special Programme Res, Dev \& Res Training Human Reproduct},
Abstract = {The major objective of this article is to find out whether the gender of
   the service-providers influence the effectiveness of the reproductive
   health care programme. Gender of the service providers has considerable
   bearing on success of these programmes. Since male and female differ in
   their communication style, practice patterns, perceptions and attitudes.
   Women are more comfortable in discussing their problems with female
   service providers. Male clients are less welcome in the family planning
   clinic and they are reluctant to reveal their problems to the female
   service providers. Thus a gender bias regarding service providers
   exists. Ideally there should not be any gender bias of the service
   providers but we should respect the client's choice for the service
   provider. The gender bias can only be eliminated if community is made
   conscious, liberal and educated and service providers are trained for
   delivering quality care.},
