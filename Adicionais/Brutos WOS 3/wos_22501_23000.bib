@article{ WOS:000089881800002,
Author = {Hutton, JL},
Title = {Ethics of medical research in developing countries: the role of
   international codes of conduct},
Journal = {STATISTICAL METHODS IN MEDICAL RESEARCH},
Year = {2000},
