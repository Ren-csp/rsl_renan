Title = {Embodied CO2 Emissions in Building Construction Materials of
   Hellenic Dwellings},
Booktitle = {SUSTAINABLE SYNERGIES FROM BUILDINGS TO THE URBAN SCALE},
Series = {Procedia Environmental Sciences},
