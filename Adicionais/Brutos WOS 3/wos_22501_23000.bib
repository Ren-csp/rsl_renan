@article{ WOS:A1995TD71200013,
Author = {KINNEY, R and MACIAS, C and RODICAN, C},
Title = {FOUNTAIN HOUSE WORK ATTITUDE SCALE - PSYCHOMETRICS AND PRELIMINARY
   RESEARCH FINDINGS},
Journal = {PSYCHOSOCIAL REHABILITATION JOURNAL},
Year = {1995},
Volume = {18},
Number = {4},
Pages = {129-136},
Month = {SPR},
Note = {National Research Seminar addressing Issues of Vocational Rehabilitation
   (VR) and Long Term Mental Illness (LTMI), PHILADELPHIA, PA, OCT, 1994},
Organization = {Matrix Res Inst; Univ Penn, Rehab Res \& Training Ctr},
Abstract = {The Fountain House Work Attitude Scale is a brief self-report instrument
   designed to measure member perceptions of work experience. An
   exploratory factor analysis, conducted with data from 106 Fountain House
   members active in the Transitional Employment program, identified four
   subscales: 1) work acceptance, 2) work fear, 3) work value, and 4) work
   dignity. The work fear subscale was related to length of tenure on the
   most recent TE completed: Members with longer tenure reported
   significantly less fear of failing in future work than members with
   shorter tenure. The work satisfaction subscale was also associated with
   previous tenure in the TE program: Members who had three month tenure on
   three or more TEPs reported significantly higher satisfaction with their
