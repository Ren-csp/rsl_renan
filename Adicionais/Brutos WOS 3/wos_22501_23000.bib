Title = {Decommissioning of gold tailings storage facilities in Western Australia},
Booktitle = {ENVIRONMENTAL GEOTECHNICS-BOOK},
Year = {1997},
Pages = {439-444},
Note = {1st Australia/New Zealand Conference on Environmental Geotechnics
   (GEOENVIRONMENT 97), MELBOURNE, AUSTRALIA, NOV 26-28, 1997},
Organization = {Austr Geomech Soc; New Zealand Geotech Soc; Inst Engineers Austr; Int
   Soc Soil Mech \& Geotech Engn},
Abstract = {The desired objectives for a Tailings Storage Facility (TSF) are that it
   provides safe and stable storage into the future, and minimal
   environmental impact. Decommissioning and rehabilitation in the gold
   industry in Western Australia (WA), is a special case related to an arid
   climate, flat topography, and the complications introduced by saline
   process water. This paper traces the history in WA of tailings disposal
   techniques and the environmental impact of past practices, outlines the
   current practices in the gold industry, discusses the factors which
   influence the long term performance of TSFs and provides comment on the
   need to change some perceptions and practices. One particular issue that
   will have to be addressed and defined as quickly as possible is the
   length of time over which these storages facilities must retain their
   integrity. Once defined, it will then be possible to establish
   appropriate design parameters.},
