Title = {Outlining the Concept of Transparency for Artificial Intelligence (AI)
   Systems: A Human-Computer Interaction (HCI) Perspective},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 5, IEA 2024},
