   De Paul Univ, Dept Psychol, Chicago, IL 60614 USA.},
DOI = {10.1016/j.paid.2004.02.006},
ISSN = {0191-8869},
Keywords = {chronic procrastination; social comparisons; avoidance tendencies;
   interpersonal attraction; peer ratings; infout group favoritism},
Keywords-Plus = {ACADEMIC PROCRASTINATION; INGROUP FAVORITISM; SELF-REGULATION;
   PERSONALITY; ANTECEDENTS; INDIVIDUALS; BEHAVIOR; FAILURE; ESTEEM},
