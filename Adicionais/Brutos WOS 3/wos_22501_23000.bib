Title = {EARTH OBSERVATION AT FINER SCALES IS CRITICAL TO FARMING COMMUNITIES
   FACING INCREASED WATER SHORTAGES OVER THE NEXT DECADE},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
