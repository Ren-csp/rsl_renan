@article{ WOS:000270646300012,
Author = {Hesselschwerdt, John and Tscharner, Simon and Necker, Jasmin and
   Wantzen, Karl Matthias},
Title = {A local gammarid uses kairomones to avoid predation by the invasive
   crustaceans Dikerogammarus villosus and Orconectes limosus},
