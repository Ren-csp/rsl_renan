Title = {Occurrence of groundwater in metropolitan Detroit, Michigan, USA},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {155-160},
