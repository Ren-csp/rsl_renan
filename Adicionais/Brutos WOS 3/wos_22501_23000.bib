@inproceedings{ WOS:000089036600011,
Author = {King, MJ},
Editor = {McClure, R},
Title = {Review of Safe School Travel (SafeST) initiatives: flashing rights at
   school zones and high visibility bus strips},
Booktitle = {READINGS IN INJURY PREVENTION AND CONTROL},
Year = {2000},
Pages = {52-55},
Note = {3rd National Conference on Injury Prevention and Control, BRISBANE,
   AUSTRALIA, MAY 09-12, 1999},
Organization = {Australian Injury Prevent Network; Conrod; Carrs; Qut; Univ Queensland;
   Queensland Inst Med Res; WAIC; Hlth \& Aged Care},
Abstract = {In addition to a range of programs, Queensland Transport's Safe School
   Travel (SafeST) package involves trialling initiatives. Two nearing
   finalisation are the Flashing Lights at School Zones trial, and the High
   Visibility Bus Strips trial. Flashing lights were installed in school
   zones at three locations to draw attention to the school Tone, and speed
   was measured in and out of school zone times, before installation and
   one week one month and six months after installation. Speeds reduced
   significantly after one week and one month, but there were mixed results
   after six months.
   High visibility bus strips were evaluated in two areas for their
   effectiveness in raising awareness of the school bus and changing
   behaviour around it. Focus groups and a survey showed that awareness of
   the strips was tow unless prompted, due to a lack of promotion. Drivers
   believe they already drive cautiously around school buses, but students,
   teachers, parents and bus drivers have a different perception.},
