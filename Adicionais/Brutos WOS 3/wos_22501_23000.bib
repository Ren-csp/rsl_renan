@article{ WOS:000431498300097,
Author = {Ishak, Nur Ashikin and Nazri, Sharifah Nazatul Faiza Syed Mustapha and
   Yusoff, Noreena Md and Mohamed, Muzrifah},
Title = {The Influence of Audit Fee, Audit Tenure and Growth on Audit Quality:
   Malaysian ACE Market},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {8},
Pages = {7383-7387},
Month = {AUG},
Note = {2nd International Research Conference on Business and Economics (IRCBE),
   Semarang, INDONESIA, AUG 03-04, 2016},
Abstract = {Recent financial scandals had negatively affected public perceptions
   towards the quality of auditing. Thus, this study aims to examine the
   determining factors of an audit quality. To fill in the gap, this study
   attempts to investigate the influence of an audit fee, audit tenure, and
   company growth on audit quality within the context of Malaysian Ace
   Market, during and after the global financial crisis (2007-2014). A
   closer inspection of the 66 companies listed in the Malaysian ACE Market
   revealed that audit quality is significantly influenced by the audit
   fee, for both periods. Meanwhile, the audit tenure and company growth
   have a significant effect on audit quality, after and during the
   financial crisis, respectively. The results presented in this study may
   facilitate the improvements of the existing audit practices and audit
   quality so as to ensure the competitiveness of the audit mechanism and
   enhance public confidence in the audit practice.},
