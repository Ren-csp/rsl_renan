@article{ WOS:000255066700007,
Author = {Herbeck, Diane A. and Hser, Yih-Ing and Teruya, Cheryl},
Title = {Empirically supported substance abuse treatment approaches: A survey of
   treatment providers' perspectives and practices},
Journal = {ADDICTIVE BEHAVIORS},
Year = {2008},
