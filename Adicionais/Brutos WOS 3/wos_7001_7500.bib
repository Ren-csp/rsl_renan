@article{ WOS:000229173800008,
Author = {Kanaroglou, PS and Jerrett, M and Morrison, J and Beckerman, B and
   Arain, MA and Gilbert, NL and Brook, JR},
Title = {Establishing an air pollution monitoring network for intra-urban
   population exposure assessment: A location-allocation approach},
Journal = {ATMOSPHERIC ENVIRONMENT},
