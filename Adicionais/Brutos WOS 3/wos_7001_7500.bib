@article{ WOS:000362271900010,
Author = {Baskaya, Fatma Aycim Turer},
Title = {Disaster sensitive landscape planning for the coastal megacity of
   Istanbul},
Journal = {JOURNAL OF COASTAL CONSERVATION},
Year = {2015},
Volume = {19},
Number = {5, SI},
