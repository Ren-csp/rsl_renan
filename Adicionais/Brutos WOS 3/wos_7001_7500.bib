@inproceedings{ WOS:000082800000070,
Author = {Laurie, NE and Fisher, DL and Glaser, R and Brock, JF and Pollatsek, A
   and Duffy, S},
Editor = {Lee, GCH},
Title = {Training risk perception with a PC based trainer: Does training
   generalize to an advanced driving simulator?},
Booktitle = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Series = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Year = {1999},
Volume = {3},
Pages = {441-446},
Note = {XIVth Annual International Occupational Ergonomics and Safety Conference
   1999, ORLANDO, FL, JUN 06-09, 1999},
Abstract = {During their first six months on the road, younger adults are over-
   represented in road accidents here and around the world. Research
   suggests that between 50 and 70 percent of the accidents are due to
   inexperience. Among other things, less experienced drivers have worse
   risk perception skills The AAA Foundation for Traffic Safety has
   developed a PC based younger driver-training program that attempts to
   improve such skills. The monitor displays live footage of risky traffic
   scenarios seen from the driver's point of view Cameras recorded both the
   scene in front of the car as it moved through rural, suburban and city
   landscapes, and the scene in the rear and side view mirrors. For
   example, in one Scenario. the driver sees a car parked in a driveway on
   the right hand side of the road and the parked car's brake-lights come
   on as the driver approaches (a hint that the parked car is about to back
   out into the street). A driver who is paying attention will notice the
   lights and take all appropriate action on the PC. In order to test the
   effectiveness of the PC based training program, we created a total of 24
   scenarios on an advanced driving simulator which were similar, but not
   identical, to those that appeared on the PC A total of 45 subjects were
   run in the experiment: 15 younger trained adults, 15 younger untrained
   adults and 15 older adults. We see marked evidence that the risk
   perception training on the PC generalizes to a driving simulator.
   Specifically, the younger trained drivers and the experienced drivers
   recognize risky scenarios sooner, as evidenced by the timing of their
   deceleration and braking. These findings are among the first actually to
   record a real effect of risk perception training.},
