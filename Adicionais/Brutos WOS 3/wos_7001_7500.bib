Title = {Dispersion modelling of atmospheric contaminants resulting from
   terrorist attacks and accidental releases in urban areas},
Booktitle = {AIR, WATER AND SOIL QUALITY MODELLING FOR RISK AND IMPACT ASSESSMENT},
