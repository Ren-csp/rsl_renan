@article{ WOS:000232258700008,
Author = {Bekker, MPM and Putters, K and van der Grinten, TED},
Title = {Evaluating the impact of HIA on urban reconstruction decision-making.
   Who manages whose risks?},
Journal = {ENVIRONMENTAL IMPACT ASSESSMENT REVIEW},
Year = {2005},
