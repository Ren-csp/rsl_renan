@article{ WOS:000183453700030,
Author = {Shinya, M and Tsuruho, K and Konishi, T and Ishikawa, M},
Title = {Evaluation of factors influencing diffusion of pollutant loads in urban
   highway runoff},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2003},
