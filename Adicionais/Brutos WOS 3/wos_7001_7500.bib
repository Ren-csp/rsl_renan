@article{ WOS:000432354700093,
Author = {Sabri, Budi Aslinie Md and Ahmad, Rohana and Abu Hassan, Mohamed Ibrahim},
Title = {The Dundee Ready Education Environment Measure of the Undergraduate
   Bachelor of Dental Surgery Program in UiTM},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {1},
Pages = {310-313},
Month = {JAN},
Note = {International Conference on Social Sciences and Education (ICSSE),
   Bandung, INDONESIA, NOV 21-23, 2017},
Abstract = {Objective: To analyse the educational environment of the undergraduate
   Bachelor of Dental Surgery program' in the Faculty of Dentistry,
   Universiti Teknologi MARA, Malaysia. Methods: The study sample included
   234 students who responded to the questionnaire based on the `Dundee
   Ready Education Environment Measure' (DREEM), which consisted of 50
   statements organized in five domains (perceptions of learning,
   perception of lecturers, academic self-perceptions, perception of
   atmosphere and social self-perception). The questionnaires were
   administered after their lecture sessions at the end of semester one.
   Results: The response rate for the study was 98.7\%. The overall DREEM
   score was 116.2 which can be interpreted as `more positive than
   negative.' The domain `perception of learning' was rated as generally
   positive; the domain `perception of lecturers' was rated as `moving in
   the right direction. Respondents also reported feeling `more on the
   positive side' in regards to the domain `academic perception' and the
   domain `perception of atmosphere.' The `social perception' domain was
   rated as `not too bad.' When analysed individually, seven items such as
   `I have learnt a lot about empathy in my profession' and `I have good
   friends on this course,' were given an average rating of <2, indicating
   that there were some educational problem areas. Conclusions: Students'
   perceptions of the educational environment were reasonably positive
   overall and across all domains. However, some weaknesses were identified
   particularly in the academic self-perception and perception of
   lecturers' domain. Further research is needed to clarify appropriate
   interventions to address the problem areas.},
