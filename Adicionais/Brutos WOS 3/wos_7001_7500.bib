Title = {Satisfaction Perception of Indoor Environment of Low-cost Housing: A
   case study of Flat Taman Desa Sentosa},
Booktitle = {EMERGING TECHNOLOGY FOR SUSTAINABLE DEVELOPMENT CONGRESS (ETSDC 2014)},
Series = {E3S Web of Conferences},
Year = {2014},
