@article{ WOS:000076618400001,
Author = {Donovan, MA and Drasgow, F and Munson, LJ},
Title = {The Perceptions of Fair Interpersonal Treatment scale: Development and
   validation of a measure of interpersonal treatment in the workplace},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {1998},
Volume = {83},
Number = {5},
Pages = {683-692},
