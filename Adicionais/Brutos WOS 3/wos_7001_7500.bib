Title = {DIFFERENTIATED REGULATION OF URBAN FREIGHT TRAFFIC: CONCEPTUAL FRAMEWORK
   AND EXAMPLES FROM ITALY},
Booktitle = {TRANSPORTATION AND MANAGEMENT SCIENCE},
Year = {2008},
