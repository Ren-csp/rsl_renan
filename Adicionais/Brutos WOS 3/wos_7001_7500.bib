@article{ WOS:000302824900084,
Author = {Flores Montes, M. de J. and Paulo, J. G. and do Nascimento Filho, G. A.
   and Gaspar, F. L. and Feitosa, F. A. and Santos Junior, A. C. and
   Batista, T. N. F. and Travassos, R. K. and Pitanga, M. E.},
Title = {The Trophic Status of an Urban Estuarine Complex in Northeast Brazil},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2011},
Number = {1, 64},
Pages = {408-411},
Note = {11th International Coastal Symposium (ICS), Szczecin, POLAND, MAY 09-13,
   2011},
Organization = {Univ Szczecin, Inst Marine \& Coastal Sci; Coastal Educ \& Res Fdn; Univ
   Szczecinski (US); Cztowiek Nauka Srodowisko (CNS); ZMGM; Reg Dyrekcja
   Ochrony Srodowiska; Esri; Springer; Lotos; GA2 Syst; World Sci;
   Helmholtz-Zentrum Geesthacht; Nfosigm; Urzad Marszalkowski Wojewodztwa
   Zachodniopomorskiego; Wojewodzki Fundusz Ochrony Srodowiska I Gospodarki
   Wodnej W Gdansku},
Abstract = {FLORES MONTES, M. DE J.; PAULO, J.G.; NASCIMENTO-FILHO, G.A.; GASPAR,
   F.L.; FEITOSA, F.A.; SANTOS-JUNIOR, A.C.; BATISTA, T.N.F.; TRAVASSOS,
   R.K.; PITANGA, M.E., 2011. The trophic status of an urban estuarine
   complex in Northeast Brazil. Journal of Coastal Research, SI 64
   (Proceedings of the 11th International Coastal Symposium), 408-411.
   Szczecin, Poland, ISSN 0749-0208
   In this study, we evaluate the trophic status and water quality of the
   port basin of Recife in the Northeast Region of Brazil using the trophic
   index TRIX. We carried out water collections at 3 stations along the
   lower estuary during periods of high and low tides in a seasonal cycle
   between the months of August 2008 and September 2009. The TRIX index
   integrates chlorophyll a, oxygen saturation, dissolved inorganic
   nitrogen, and dissolved inorganic phosphorus. The index is scaled from 0
   to 10, covering a range of four trophic states (high, good, moderate,
   and degraded). The hydrological results were considered critical in low
   tide and showed wide fluctuations in the dissolved oxygen saturation,
   which ranged from 7.0\% during low tide in station 3 (lowest marine
   influence) to 129.5\% during low tide in station 2 (a high marine
   influence). The values of chlorophyll a varied considerably (1.86 mu
   gL(-1) to 164.0 mu gL(-1)), revealing an intense degree of
   eutrophication. The TRIX index ranged from 3.9 to 6.5, categorizing the
   quality of the circulating water between good and poor. These results
   show that the estuarine dynamics resulting from the ebb and flow of
   tides is important in the dispersion, dilution, recovery and transport
   of organic matter, and that it continually influences the environmental
   quality, manifested in the different degrees of eutrophication observed
   in the environment studied.},
