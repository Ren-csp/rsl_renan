Title = {Studies of the spatial correlation between urban aerosols and local
   traffic congestion using a slant angle scanning Mie Lidar system},
Booktitle = {LIDAR REMOTE SENSING FOR INDUSTRY AND ENVIRONMENT MONITORING},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
