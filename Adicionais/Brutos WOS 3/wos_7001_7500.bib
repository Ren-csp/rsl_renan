@article{ WOS:000076851900013,
Author = {Bonello, PJ and Rapport, LJ and Millis, SR},
Title = {Psychometric properties of the visual object and space perception
   battery in normal older adults},
Journal = {CLINICAL NEUROPSYCHOLOGIST},
Year = {1997},
Volume = {11},
Number = {4},
Pages = {436-442},
