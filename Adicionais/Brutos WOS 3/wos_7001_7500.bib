Organization = {Inst Environm Engn Polish Acad Sci; AIRCLIM NET; ECO Monitoring; Shim
   Pol; mlu recordum; Atmoservice; TESTCHEM; Envimet Serv; TSI},
Abstract = {This paper presents seasonal variations in the occurrence of chromium in
   urban particulate matter (PM). Radom is an interesting area for this
   type of research due to its typical antiquated heating infrastructure.
   PM samples of two particulate fractions PM2.5 (particulates <= 2.5 mu m)
   and PM10 (particulates <= 10 mu m) were collected using a Copley cascade
   impactor Hi-Flow MOUDI Model 130. Chromium was determined in the samples
   using the GF-AAS technique. The concentration of chromium in PM2.5 was
   in the range of 0.38 to 3.2 ng/m(3), whereas in PM10 it ranged from 0.43
   to 4.1 ng/m(3).},
