Title = {Community Perception Around Plantation Forest Area in Ulak Kedondong
   Village, towards Sumatran Elephant (Elephas maximus sumatranus)
   Disturbance},
Booktitle = {INTERNATIONAL CONFERENCE ON BIOLOGY AND APPLIED SCIENCE (ICOBAS)},
