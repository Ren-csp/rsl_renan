@inproceedings{ WOS:001471781800010,
Author = {Martinez-Tejada, Laura Alejandra and Yoshimura, Natsue},
Book-Group-Author = {IEEE},
Title = {Detection of positive and negative video game events from brain activity
   using a potable EEG-headset and source localization},
Booktitle = {2025 13TH INTERNATIONAL CONFERENCE ON BRAIN-COMPUTER INTERFACE, BCI},
Series = {International Winter Workshop on Brain-Computer Interface},
Year = {2025},
Note = {13th International Conference on Brain Computer Interface-BCI-Annual,
   SOUTH KOREA, FEB 24-26, 2025},
Organization = {Korea University College of Informatics; IEEE Systems Man and
   Cybernetics Society},
Abstract = {Emotion recognition using electroencephalography and video games aims to
   identify emotional states that can serve as game feedback, using signal
   features in time, frequency, or spatial domain. However, emotional brain
   activity is known to occur in deep brain regions, for this reason, we
   propose the use of electroencephalography source localization to
   estimate activation of deep brain structures related with emotional
   activity while players interact with a mobile game. We analyze source
   time courses around video game events related with positive (reward) and
   negative (punishment) emotional stimuli, using a mobile auto-scrolling
   video game, and a quick and easy to apply 12 dry-electrodes
   electroencephalography headset. We found brain activity patterns for
   both video game events in the cingulate cortex, specifically on the left
   and right rostral anterior cingulate, left and right isthmus cingulate,
   right and left paracentral lobule, left caudal anterior cingulate, right
   posterior cingulate, the right insula, and the right frontal pole.},
