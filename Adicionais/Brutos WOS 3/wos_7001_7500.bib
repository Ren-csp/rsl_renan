   based on population health: a case study of Huilongguan and Tiantongyuan
   area, Changping District, Beijing},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
