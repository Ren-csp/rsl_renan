@inproceedings{ WOS:000393361700024,
Author = {Nawangwe, B. and Kimani, Catherine},
Editor = {Baby, S and Sandhu, PS},
Title = {Environmental Sustainability in Cities of Under-developed Economies in
   the Tropics. Case Study of Mbale in Uganda},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY (ICEST 2010)},
Year = {2010},
Pages = {113-118},
Note = {International Conference on Environmental Science and Technology (ICEST
   2010), Bangkok, THAILAND, APR 23-25, 2010},
Organization = {IACSIT; Applied Chem Engn Soc; Environm Sci Soc},
Abstract = {One of the most significant dynamics impacting on Ugandan society is
   rapid urbanization. The growth of urban centres across the country is
   proof of this process and is now an accepted fact. Yet the track record
   of Uganda's City and towns in managing the urbanization process, when
   measured in terms of the performance and outlook of urban environment,
   resulting from current planning practice is abysmal. It has been
   observed that much of the urbanization taking place in Uganda today is
   informal, organic and haphazard. Even where there has been some
   planning, especially in the older urban centres, most plans have expired
   and are in dire need of review. On the other hand, most of the new
   growth centres and district headquarters have never had any planning
   intervention. This paper presents the findings of a research effort that
   carried out a study in Mbale Municipality on Urbanization and Land Use
   Planning. The objectives of the study were to examine the impact of
   urbanization on land uses, to highlight the most common problems,
   constraints and challenges in the implementation and administration of
   land control measures in the study area and finally to propose an
   alternative policy framework for establishing a more effective planning
   and control system. The study revealed that Mbale town is growing
   without any form of land use planning or control. Some areas that had
   been typically rural are gradually evolving into an urban environment.
   Most of the immediate peri urban areas are practically slums and the
   municipality seems helpless in the whole situation. The study therefore
   recommends that there is need to coordinate all the planning
   institutions in the study area under one umbrella that would oversee and
   coordinate all land use planning and control activities in Mbale and its
   peri-urban areas. The study argues that the planning process in the area
   should be improved through public participation to ensure that most of
   the costs of urban growth be identified and the benefits retained for
   sustainable development and urbanization.},
Publisher = {RESEARCH PUBLISHING SERVICES},
