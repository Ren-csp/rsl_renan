@inproceedings{ WOS:000223250200073,
Author = {Aziz, A and Bajwa, IU},
Editor = {Wadhwa, LC},
Title = {Energy and pollution control opportunities for Lahore},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
