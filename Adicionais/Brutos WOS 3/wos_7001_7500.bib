@inproceedings{ WOS:000380531900202,
Author = {Czynska, K.},
Editor = {Schreier, G and Skrovseth, PE and Staudenrausch, H},
Title = {APPLICATION OF LIDAR DATA AND 3D-CITY MODELS IN VISUAL IMPACT
   SIMULATIONS OF TALL BUILDINGS},
Booktitle = {36TH INTERNATIONAL SYMPOSIUM ON REMOTE SENSING OF ENVIRONMENT},
