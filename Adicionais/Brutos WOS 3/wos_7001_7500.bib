@article{ WOS:000278834400021,
Author = {Lee, Jiho and Pak, Gijung and Yoo, Chulsang and Kim, Sangdan and Yoon,
   Jaeyoung},
Title = {Effects of land use change and water reuse options on urban water cycle},
Journal = {JOURNAL OF ENVIRONMENTAL SCIENCES},
