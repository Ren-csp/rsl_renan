@inproceedings{ WOS:000169016400015,
Author = {Murray, KS and Xun, Z and McNulty, M and Mazur, D},
Editor = {Wang, YX},
Title = {Relationship between land use, near-surface geology and water quality in
   an urban watershed, Southeast Michigan, USA},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON HYDROGEOLOGY AND THE
   ENVIRONMENT},
Year = {2000},
Pages = {67-71},
Note = {International Symposium on Hydrogeology and the Environment (HE 2000),
   WUHAN, PEOPLES R CHINA, OCT 17-21, 2000},
Organization = {China Univ Geosci},
Abstract = {Groundwater and surface water quality in southeast Michigan is
   inextricably linked to the areas glacial history and changing land use
   patterns. Unconsolidated sediments of Plio-Pleistocene
   glacial-lacustrine and glacial fluvial origin form a complex series of
   confined and semi-confined aquifers overlain by an extensive unconfined
   surficial aquifer. All surface water in the metropolitan Detroit area
   originates from this complex system of aquifers. Sulfate-rich shallow
   groundwater mixes with chloride rich water derived from road sail. The
   mixing of these two waters controls the chemistry of the shallow
   groundwater. The consistency of water chemistry in the shallow aquifers,
   river sediment pore fluid and river water suggest that groundwater in
   turn controls the water quality of the surface water. A secondary
   control is the glacial history of the region, which spatially governs
   the rate of discharge to the surface wafer and aquifer horizontal to
   vertical conductivity ratios. An understanding of the relationship
   between land use, geology and water duality issues is necessary for
   solving surface water quality problems, and is thus vital to the
   management of urban watersheds.},
