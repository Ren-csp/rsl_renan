@article{ WOS:000264136000002,
Author = {Johnson, Mark and Clisby, Suzanne},
Title = {Naturalising Distinctions: The Contested Field of Environmental
   Relations in Costa Rica},
Journal = {LANDSCAPE RESEARCH},
Year = {2009},
Volume = {34},
Number = {2},
Pages = {171-187},
Note = {Workshop on People Protecting Nature - Social Dimensions of
   Environmental Conservation, Oxford Brookes Univ, Oxford, ENGLAND, OCT
   20-21, 2005},
Organization = {Econ \& Social Res Council},
Abstract = {This paper draws on Bourdieu's notion of `the field', a contested domain
   of relations of power, as a way to think about the social relations of
   environmentalism. More specifically, we suggest that talk about the
   environment and its protection is an increasingly important arena of
   struggle for social legitimacy and distinction. We illustrate that point
   through a consideration of two situations in Costa Rica, drawing on our
   own and others' research. The first is Costa Rican farmers talking about
   their encounters with environmentalism in the Monte Verde highlands. The
   second is European migrants in a small coastal village talking about the
   environment and threats to it. In both, talk about the environment
   involved comparing and contrasting the ways that different sorts of
   people were said to relate to nature and the surroundings, and it
   identifies one set of people as better suited to protect the environment
   than others. However, that talk took place in a situation where
   environmentalism is a key form of symbolic capital, interchangeable with
   and inextricably linked to other forms of social and economic power,
   deployed in ways that set the rules of the game in favour of some people
   and not others.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
