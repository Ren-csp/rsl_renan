@inproceedings{ WOS:000314126600064,
Author = {Abdullah, Aldrin and Abd Razak, Nordin and Salleh, Mohd Najib Mohd and
   Sakip, Siti Rasidah Md},
Editor = {Abbas, MY and Bajunid, AFI and Azhari, NFN},
Title = {Validating Crime Prevention through Environmental Design Using
   Structural Equation Model},
Booktitle = {ASEAN CONFERENCE ON ENVIRONMENT-BEHAVIOUR STUDIES (ACE-BS)},
Series = {Procedia Social and Behavioral Sciences},
Year = {2012},
Volume = {36},
Pages = {591-601},
Note = {ASEAN Conference on Environment-Behaviour Studies (AcE-Bs), Inst
   Teknologi Bandung (ITB), Sch Architecture, Planning \& Policy Dev,
   Bandung, INDONESIA, JUN 15-17, 2011},
Abstract = {In gauging Crime Prevention Through Environmental Design, observation is
   often used by researchers in evaluating CPTED elements in residential
   areas. However, the evaluation on attitude, reaction, belief,
   responsibility and perception of the residents on CPTED elements are
   also important to be considered. Therefore, a survey on the perception
   of residents on CPTED elements was conducted in non-gated and gated
   residential areas located at Putrajaya and Bandar Baru Bangi, Selangor.
