@article{ WOS:000232927500003,
Author = {Green, RJ and Ashmore, RD and Manzi, R},
Title = {The structure of gender type perception: Testing the elaboration,
   encapsulation, and evaluation framework},
Journal = {SOCIAL COGNITION},
Year = {2005},
Volume = {23},
Number = {5},
Pages = {429-464},
Month = {OCT},
Note = {11th Annual Convention of the American-Psychological-Society, DENVER,
   CO, JUN, 1999},
Organization = {Amer Psychol Soc},
Abstract = {This article introduces the elaboration, encapsulation, and evaluation
   (P) model, which posits that the structure of gender type perception is
   guided by these three mechanisms, and describes an initial test of this
   framework. Multidimensional scaling and hierarchical clustering analyses
   were conducted based on a free sorting of 89 commonly used gender
   targets. Participants also rated the targets on a number of
   psychological proper-ties. Analyses produced a multidimensional space
   with a male-female dimension along which, and across which, distinct
   clusters were located. Property ratings indicated that the composition
   of the clusters supported the elaboration and encapsulation mechanisms.
   That the respectability and good-bad properties were important in
   interpreting the multidimensional space and were relatively orthogonal
   to the gender dimension supported the evaluation mechanism.},
