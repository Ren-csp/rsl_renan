@inproceedings{ WOS:000664335302226,
Author = {Yin, Zhiyong and Tang, Yuqi},
Book-Group-Author = {IEEE},
Title = {ANALYSIS OF TRAFFIC FLOW IN URBAN AREA FOR SATELLITE VIDEO},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
Year = {2020},
Pages = {2898-2901},
Note = {IEEE International Geoscience and Remote Sensing Symposium (IGARSS),
   ELECTR NETWORK, SEP 26-OCT 02, 2020},
Organization = {Inst Elect \& Elect Engineers; Inst Elect \& Elect Engineers Geoscience
   \& Remote Sensing Soc},
Abstract = {With the development of satellite technology, the resolution of remote
   sensing data has been continuously improved. The launch of remote
   sensing video satellites has provided new opportunities and challenges
   for traffic analysis, which are benefit to optimize the traffic
   conditions suffered by people especially in cities. In this paper, a
   method is proposed to analyze the traffic flow conditions using remote
   sensing satellite video. Firstly, vehicle targets are detected by
   combining with road network data, vehicle brightness characteristics and
   its contrast information with the surrounding background. Then, the
   traffic flow, density, and average vehicle speed are calculated.
   Finally, traffic flow information can be obtained, such as traffic
   congestion, traffic flow collection, abnormal vehicle behavior, etc.
   With the satellite video acquired by the International Space Station and
   Skysat-1, the proposed method is validated to vehicle detection and
   traffic flow analysis, including average travel speed, vehicle turning,
   traffic congestion and so on.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
