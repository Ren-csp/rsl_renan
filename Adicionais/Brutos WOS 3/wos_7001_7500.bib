@inproceedings{ WOS:000460606900069,
Author = {Barros, B. L. and Rodrigues, M. A. and Dores, A. R.},
Editor = {Arezes, PM and Baptista, JS and Barroso, MP and Carneiro, P and Cordeiro, P and Costa, N and Melo, RB and Miguel, AS and Perestrelo, G},
Title = {The effect of two training methods on workers' risk perception: A
   comparative study with metalworking small firms},
Booktitle = {OCCUPATIONAL SAFETY AND HYGIENE VI},
Year = {2018},
Pages = {389-393},
Note = {6th International Symposium on Occupational Safety and Hygiene (SHO),
   Guimaraes, PORTUGAL, MAR 26-27, 2018},
Abstract = {This study aims to evaluate and compare the effect of two training
   methods on workers' risk perception, when applied in metalworking small
   firms: an active method, with group discussion, and an expository
   method, with formal exposure. A sample of 212 workers was divided into
   three groups: two intervention groups and one group without
   intervention. A questionnaire was developed and applied before and one
   month after the training sessions to assess the following dimensions:
   Perceived susceptibility, Perceived severity, Perceived barriers and
   Perceived benefits. The results indicate that the training had a
   positive, but limited, impact on workers' risk perception. Significant
   differences between both moments were found on Perceived susceptibility
   in the group where the expository method was applied and in the group
   submitted to the intervention supported in the active method. No
   significant differences between both training methods after intervention
   were observed in this study.},
