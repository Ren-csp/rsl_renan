Title = {Blogs as Powerful Learning Tools: The Perception from EFL Students in
   Riau Main Island Indonesia},
Booktitle = {INTERNATIONAL CONFERENCE ON FRONTIER OF SCIENCE AND SOCIETY
   (ICFSS-2017): MARITIME PERSPECTIVES TO PUBLIC DISCOURSE},
