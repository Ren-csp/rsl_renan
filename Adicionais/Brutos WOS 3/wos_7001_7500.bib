@article{ WOS:000232837100041,
Author = {Zigrai, F and Huba, M},
Title = {Some metascientific remarks concerning the sustainable development of
   the society and the environment},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2004},
Volume = {23},
Number = {1},
Pages = {403-413},
Note = {13th International Symposium on Problems of Landscape Ecological
   Research, Mojmirovce, SLOVAKIA, SEP 30-OCT 03, 2003},
Organization = {Slovak Acad Sci, Inst Landscape Ecol; Austrian Inst E \& SE European
   Studies Vienna, Branch Off Bratislava},
Abstract = {Solution to the cross-section problem of the sustainable development of
   the society and the environment requires an integrated approach of
   several sciences. The spectre of the participating problem-oriented
   sciences must widen with the increasing complexity of interpretation of
   sustainable development while the intensity and their co-operation and
   aggregation must also increase.
   The ever increasing complexity of global problems and the efforts of
   science to respond leads to the state when the development of the
   sustainable development concept including the issue of indicators used
   for quantification, assessment and communication of this development
   acquires the metascientific nature. It is a challenge for integrated
   landscape, society and environmental sciences with geography, landscape
   ecology, human ecology and environmental science standing in the
   foreground. Constitution of learning/science about sustainable
   development of the society and the environment dealing with its
   metascientific, theoretical-methodical, empirical and applied aspects
   may represent an important progress in improvement of the not
   sufficiently satisfying relationship between the science and the concept
   of sustainable development. On the one side, establishing of such
   scientific discipline is determined by the proper attributes of the
   science in general and nature i.e. its inner content and structure of
   the sustainable development concept on the other.},
