Title = {Housing Design for Urban Poor in Kuala Lumpur: A Literature Review},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON CIVIL AND ENVIRONMENTAL ENGINEERING FOR
   SUSTAINABILITY (ICONCEES 2019)},
