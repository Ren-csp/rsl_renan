Editor = {Bikas, D and Theodosiou, T and Katerina, T},
Title = {Quality Through Sustainable Practices During the Design and Construction
   Phase-the case of the SNFCC},
Booktitle = {SUSTAINABLE SYNERGIES FROM BUILDINGS TO THE URBAN SCALE},
Series = {Procedia Environmental Sciences},
Year = {2017},
Volume = {38},
Pages = {781-788},
Note = {International Conference on Sustainable Synergies from Buildings to the
   Urban Scale (SBE), Thessaloniki, GREECE, OCT 16-19, 2016},
Organization = {Aristotle Univ Thessaloniki, Fac Engn, Dept Civil Engn, Lab Building
   Construct \& Building Phys; Tech Chamber Greece},
Abstract = {This paper is based on a research thesis project presented at the School
   of Architecture at Aristotle University of Thessaloniki, referring to
   the sustainable design and construction of the Stavros Niarchos
   Foundation Cultural Center (SNFCC), in Athens. SNFCC is considered to be
   a unique building project with exceptional environmental standards in
   the field of the Greek construction industry. It is estimated that the
   overall project design has set the highest environmental goals and
   international standards which are summarized in the following
   principles: strict compliance with the Environmental Impact Study and
   the Environmental Terms approved by Greek Authorities, achievement of
   the Platinum LEED certification, compliance with the highest
   international environmental standards. An attempt is made to investigate
   how these principles are applied both in design and in everyday
   construction activities. The design approach of the buildings of the
   Greek National Opera and the National Library is environment-friendly,
   with high-energy performances and water efficiency. The photovoltaic
   canopy, the green roofs, the biodiversity and the quality of the local
   environment at the Stavros Niarchos Park, as well as the flood
   protection of the Canal are some of the innovative practices provided
   during the design phase. However, in order to achieve the environmental
   targets of the project, there are responsibilities and detailed
   procedures to be followed, so as to implement the proper measures
   against any potential hazard during the construction. A great variety of
   measures are installed and maintained, such as the initial clearance of
   site, the construction waste management, the erosion, the sedimentation
   and the dust control, the protection of existing public drainage
   networks and public areas against sedimentation, the prevention of
   polluting the air with dust, the cleaning of the nearby public road
   network, the noise control and the pedestrian public access bridge. The
   presentation seeks to find the new - for Greece - design and
   construction practices to be established in a new building model, with
   elements of sustainable development. (C) 2017 Published by Elsevier B.V.},
