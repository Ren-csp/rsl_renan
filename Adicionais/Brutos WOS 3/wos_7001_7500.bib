@article{ WOS:000220837600012,
Author = {Hemmes, NS and Brown, BL and Kladopoulos, CN},
Title = {Time perception with and without a concurrent nontemporal task},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2004},
Volume = {66},
Number = {2},
