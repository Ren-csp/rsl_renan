Title = {THE PERCEPTION OF LOCAL COMMUNITIES ON THE PRESERVATION OF ARCHITECTURAL
   TRADITIONS IN BUCOVINA},
Booktitle = {GEOCONFERENCE ON ECOLOGY, ECONOMICS, EDUCATION AND LEGISLATION, SGEM
   2013, VOL II},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {231-238},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {In the context of the country's integration in the European Union,
   preserving the traditional landscape becomes a very difficult mission,
   inasmuch as the Romanian villages suffer profound alterations. The study
   aims at understanding the perception of the local communities belonging
   to Ciocanesti and Voronet settlements, Bucovina region, selected as case
   studies, on the traditional and modern architecture of the dwellings, in
   order to assess the chances of perpetuating the Bucovina's traditional
   architecture under the present socio-economic context. The research
   methods and techniques employed for this investigation were observation
   and survey. Ciocaneti commune has its own traditional decorative
   architecture, consisting in painting the facades with traditional motifs
   inspired by the folk costumes. As far as Voronet is concerned, it is
   distinguished by the typical architecture of the Bucovina, with modern
   insertions as well. The local authorities are interested to establish a
   legal framework meant to contribute to the preservation of the
   fundamental features of the traditional landscape. At the same time,
   they support the sustainable development projects and the educational
   programs that seek to revitalize the economic sectors relying on the
   local resources (wood and stone).},
