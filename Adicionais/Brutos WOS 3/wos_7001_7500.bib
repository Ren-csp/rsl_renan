@inproceedings{ WOS:000392266100011,
Author = {Catalano, Horatiu},
Editor = {Chis, V and Albulescu, I},
Title = {Study on the of Teachers' and Parents' Perception on the Remigration
   Phenomenon},
Booktitle = {ERD 2016 - EDUCATION, REFLECTION, DEVELOPMENT, FOURTH EDITION},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2016},
Volume = {18},
Pages = {79-84},
Note = {4th Conference on Education, Reflection, Development (ERD), Babes Bolyai
   Univ, Cluj Napoca, ROMANIA, JUL 08-09, 2016},
Abstract = {This study presents the synthesis of investigations presented in the
   literature on the issue of migration and remigration, taking in
   consideration the size and consequences of this phenomenon in terms of
   education and in the light of the factors and responsible agents for
   child education, also parents and teachers.
   Remigrant students who are enrolled in the Romanian Educational System
   are divided into two categories: children (students), borned in Romania,
   who have outlined national consciousness, entered in the circular
