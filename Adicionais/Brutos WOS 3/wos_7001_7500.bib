@inproceedings{ WOS:000075894500050,
Author = {Hattori, M and Tsuji, M and Tadokoro, S and Takamori, T},
Editor = {Kakazu, Y and Wada, M and Sato, T},
Title = {A motion analysis of the Bunraku puppet based on
   KM2O-Langevin equation with varying initial time -: For
   generation of home robots' actions with fertile emotions},
Booktitle = {INTELLIGENT AUTONOMOUS SYSTEMS: IAS-5},
Year = {1998},
Pages = {384-390},
Note = {5th Conference on Intelligent Autonomous Systems, SAPPORO, JAPAN, 1998},
Abstract = {Humanoid robots must have actions with fertile emotions, in order to
   cooperate with human being. To clarify ``what is the emotional factor of
   actions{''}, the authors analyze the actions of a Bunraku puppet. The
   observed action time series are modeled by a stochastic time evolution
   equations (KM2O-Langevin equations) with exogenous sources which
   represent the sources of functional factors, emotional factors and
   stochastic fluctuation factors. The estimation method for KM2O-Langevin
   equations with exogenous sources is established. This method is verified
   by a numerical simulation.},
