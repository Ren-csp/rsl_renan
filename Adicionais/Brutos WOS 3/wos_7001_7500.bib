@inproceedings{ WOS:000291664400136,
Author = {Wang, Y. -W. and Heath, T.},
Editor = {Amoeda, R and Lira, S and Pinheiro, C},
Title = {Individual architectural merit, collective urban presence: mapping the
   fading post-war cityscape of Taipei, Taiwan},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {1237-1246},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {The vast quantity and ubiquity of modern architecture poses a genuine
   dilemma as to how extensively and thoroughly buildings and sites of the
   recent past should be studied in order to decide what to save and how.
   Since the early 1990s, thematic research has been regarded as the most
   effective tool and widely adopted by many countries for assessing
   significance of post-war buildings. Empirically grounded on Taipei,
   Taiwan, this paper seeks to propose an alternative methodological
   approach to identifying heritage significance of post-war buildings
   within a historical urban framework. By overlapping the distribution of
   existing post-war heritage assets in Taipei with the mapping of the
   post-war development of the city, it sets out to explore the extent to
   which the collective urban presence of unassuming individual buildings
   can be sketched out, whereby buildings of moderate architectural merit
   yet contributing to the composite of post-war cityscape could be
   identified and saved.},
