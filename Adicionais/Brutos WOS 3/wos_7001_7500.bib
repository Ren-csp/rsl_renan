Title = {THE VALUE OF THE ITALIAN CIVIL PROTECTION SYSTEM IN INTEGRATED WATER
   MANAGEMENT FOR THE MEDITERRANEAN ENVIRONMENT},
Booktitle = {INTEGRATED WATER MANAGEMENT: PRACTICAL EXPERIENCES AND CASE STUDIES},
