Title = {Measuring the Magnetic Impact of Economic Agglomeration for Industrial
   and Business Environment through Spatial Mapping.},
Booktitle = {10TH IGRSM INTERNATIONAL CONFERENCE AND EXHIBITION ON GEOSPATIAL \&
   REMOTE SENSING},
Series = {IOP Conference Series-Earth and Environmental Science},
