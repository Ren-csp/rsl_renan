Author = {Jin, Ying and Denman, Steve and Deng, Debbie and Rong, Xiao and Ma,
   Mingfei and Wan, Li and Mao, Qizhi and Zhao, Liang and Long, Ying},
Title = {Environmental impacts of transformative land use and transport
   developments in the Greater Beijing Region: Insights from a new dynamic
   spatial equilibrium model},
Journal = {TRANSPORTATION RESEARCH PART D-TRANSPORT AND ENVIRONMENT},
Year = {2017},
