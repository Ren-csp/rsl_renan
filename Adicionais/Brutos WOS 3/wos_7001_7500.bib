@inproceedings{ WOS:000467247400008,
Author = {Costa, R. M. S. and Pavone, P.},
Editor = {Pennisi, G and Cremonini, L and Orsini, F and Gianquinto, GP},
Title = {Diachronic biodiversity analysis of a metropolitan area in the
   Mediterranean region},
Booktitle = {INTERNATIONAL SYMPOSIUM ON GREENER CITIES FOR MORE EFFICIENT ECOSYSTEM
   SERVICES IN A CLIMATE CHANGING WORLD},
Series = {Acta Horticulturae},
Year = {2018},
Volume = {1215},
Pages = {49-52},
Note = {International Symposium on Greener Cities for More Efficient Ecosystem
   Services in a Climate Changing World, Bologna, ITALY, SEP 12, 2017},
Organization = {Int Soc Hort Sci},
Abstract = {A study on urban plant diversity of Catania city (Sicily, Italy) was
   carried out through the analysis of urban green space network and
   natural habitats. The study area is extended to 939 km(2) and includes
   15 km of coastal habitat. Floristic data were used to analyze
   environmental changes. The vascular plant flora was investigated through
   a literature list for periods from 1889 to 1909 and from 1970 to 1990
   and through an extensive survey campaign from 2010 to 2017. A total list
   of 927 species was acquired. Each species was associated with its own
   ecological and chorological information. Ellenberg's values were used as
