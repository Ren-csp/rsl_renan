Language = {English},
Affiliation = {Stevens, KJ (Corresponding Author), ALLEN CTY SHERIFF DEPT,ROOM B-20,CITY CTY BLDG,FT WAYNE,IN 46802, USA.},
DOI = {10.1117/12.263479},
