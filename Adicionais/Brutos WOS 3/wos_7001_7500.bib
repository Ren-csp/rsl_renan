Title = {Analysis of the water meter management of the urban-rural water supply
   system},
Booktitle = {10TH CONFERENCE ON INTERDISCIPLINARY PROBLEMS IN ENVIRONMENTAL
   PROTECTION AND ENGINEERING EKO-DOK 2018},
