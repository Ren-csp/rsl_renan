@inproceedings{ WOS:000446888700029,
Author = {Rumbiak, W. A. and Wambrauw, E. V.},
Book-Group-Author = {IOP},
Title = {Natural Resource Management based on Gender Perspectives and Integrating
   Traditional Ecological Knowledge of the Tepera in Jayapura, Papua},
Booktitle = {1ST ITB CENTENNIAL AND 4TH PLANOCOSMO INTERNATIONAL CONFERENCE},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {158},
