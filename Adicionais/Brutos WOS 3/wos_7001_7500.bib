@inproceedings{ WOS:000189463700066,
Author = {de Felice, G and Mongiello, C and Murena, F and Vorraro, F},
Editor = {Patania, F and Brebbia, CA},
Title = {Urban pollution: computational approaches for the modelling of pollution
   transport on local scale},
Booktitle = {AIR POLLUTION XI},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {2003},
Volume = {13},
Pages = {673-679},
Note = {11th International Conference on Modelling, Monitoring and Management of
   Air Pollution, Catania, ITALY, SEP, 2003},
Organization = {Wessex Inst Technol; Univ Catania},
Abstract = {In the present work we investigate some aspects of the problem about
   urban air pollution due to the vehicle-traffic. It is well known that a
   class of actions is oriented towards the direct reduction of
   motor-vehicle pollution through a greater and greater knowledge and
   control of engine combustion and development of catalytic devices on the
   exhaust gas flow. Another possible action to obtain a substantial
   reduction of the high concentrations of pollutants in the urban areas is
   the development of external caption and treatment devices. Their
   effective design needs a deep knowledge of the flow field and of the
   pollutant concentration distribution near the emission source. As a
   starting point the attention is focused on the modelling of the motor
   vehicles exhaust gases in the form of a jet, which we consider free or
   almost parallel to a neighbouring wall and under several conditions. The
   simulations have been accomplished through the use of the CFD software
   FLUENT. First a single free air-air stationary jet has been modelled
   using different turbulence models (Spalart-Allmaras, Reynolds Stress
   Model, k-epsilon and LES), in order to validate the results of the
   simulation using the criteria reported in the literature. Testing
   criterion is that the profiles of usual statistics, reported in
   literature, are obtained within 5\% error range. Then, the dispersion of
   a gaseous non reactive chemical specie (CO) was investigated both in a
   steady and in a pulsating exhaust gas jet. Typical values of exhaust car
   emissions at tail pipe and low regimes have been adopted for the
   simulations. The effect of the ground surface roughness on the flow
   field and on CO concentration profile was also studied. The computed
   concentration profiles well match with some available typical measured
   data.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
