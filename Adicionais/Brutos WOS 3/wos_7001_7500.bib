@inproceedings{ WOS:000265078600062,
Author = {Tsakiri, Maria and Sigizis, Kostas and Billiris, Harilaos and Dogouris,
   Stefanos},
Editor = {Kaliampakos, D and Benardos, A},
Title = {3D Laser Scanning for the Documentation of Cave Environments},
Booktitle = {11TH ACUUS INTERNATIONAL CONFERENCE - UNDERGROUND SPACE: EXPANDING THE
   FRONTIERS},
Year = {2007},
Pages = {403-408},
Note = {11th ACUUS International Conference, Athens, GREECE, SEP 10-13, 2007},
Organization = {Assoc Res Ctr Urban Underground Space; Sch Mining \& Metallurg Engn;
   Attiko Metro; S \& B; J \& P; OEMEAH; Planet Earth; MYTILINEOS Holdings},
Abstract = {Historically the main methods of communicating the appearance and shape
   of a cave are cave surveying and cave photography. To-date, the recent
   emergence of terrestrial laser scanning has enabled the 3D documentation
   of underground environments in a faster and reliable way. Laser scanners
   provide users directly with a three-dimensional sampled representation
   of an object or surface and are used in a diverse range of applications
   requiring recording and documentation. Their high resolution, accurate
   and rapid capture capabilities with rates that exceed several thousand
   points per second allow cost effective production of surface models for
   geometric documentation and visualisation purposes. This paper discusses
   the use of terrestrial laser scanning for the documentation of a cave
   site. Specifically, the cave is located at the Greek island of Kalymnos
   and has a rich decoration of stalagmites and stalactites. The data
   collection is described and emphasis is given on the processing of the
   3D laser data for the construction of a model that gives the geometric
   representation of a complex structure with unknown topological type and
   sharp features.},
