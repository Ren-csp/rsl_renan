@article{ WOS:000077802500029,
Author = {Novotny, V and Muehring, D and Zitomer, DH and Smith, DW and Facey, R},
Title = {Cyanide and metal pollution by urban snowmelt: Impact of deicing
   compounds},
Journal = {WATER SCIENCE AND TECHNOLOGY},
