@inproceedings{ WOS:001877420000015,
Author = {Sanmarco, Jessica and Villarquide, Maria and Guntin, Sergio and Novo,
   Mercedes},
Editor = {Arce, R and Lila, M and Arias, E},
Title = {ENTRE LO REAL Y LO ARTIFICIAL: CREDIBILIDAD DE TESTIMONIOS EN DIFERENTES
   CONTEXTOS},
Booktitle = {COLECCION PSICOLOGIA Y LEY},
Series = {Coleccion Psicologia y Ley},
Year = {2025},
Volume = {19},
Pages = {243-258},
Note = {14th International Congress of Legal and Forensic Psychology, Elche,
   SPAIN, MAR 01-02, 2024},
Abstract = {The rise of new forms of information generation, such as testimonies
   generated by artificial intelligence (AI), poses significant challenges
   for psychology, law, and security. Previous research shows that
   individuals tend to rely on their subjective judgment of credibility,
   although this does not always align with the actual authenticity of the
   material being evaluated. The present study aimed to examine both the
   classifiability and the perceived credibility of real, simulated, and
   AI-generated testimonies. The sample consisted of 96 participants,
   distributed across five professional groups (psychology, law,
   criminology, state security forces, and the general population). Each
   participant evaluated three testimonies, classifying their origin and
   assessing their credibility. The results showed that classification
   ability was moderate: real testimonies were identified more often than
   simulated or AI-generated ones. However, no differences were found in
   perceived credibility, as all three types were considered equally
   credible. Moreover, testimonies judged as credible were, in many cases,
   incorrectly classified, revealing a discrepancy between perception and
   authenticity. Logistic regression models indicated that perceived safety
   negatively predicted credibility, while attention to linguistic aspects
   increased it. These findings highlight the difficulty of distinguishing
   between authentic and fabricated content and caution against the limited
   reliability of subjective credibility in judicial and security contexts.},
