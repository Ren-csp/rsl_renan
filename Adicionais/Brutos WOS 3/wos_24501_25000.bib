@inproceedings{ WOS:000089036600038,
Author = {Walsh, P},
Editor = {McClure, R},
Title = {The management design interface for early childhood centres},
Booktitle = {READINGS IN INJURY PREVENTION AND CONTROL},
Year = {2000},
Pages = {140-142},
Note = {3rd National Conference on Injury Prevention and Control, BRISBANE,
   AUSTRALIA, MAY 09-12, 1999},
Organization = {Australian Injury Prevent Network; Conrod; Carrs; Qut; Univ Queensland;
   Queensland Inst Med Res; WAIC; Hlth \& Aged Care},
Abstract = {Early childhood centres have a major influence on the child during these
   very formative years. Safety is important and it is unfortunate that too
   many people perceive injury as a simple problem of equipment design. To
   some extent this is driven by legislated standards. the fear of
   litigation if shortfalls occur and the limited idea that childcare
   centres only function as babysitting facilities. A more sophisticated
   approach is needed if children entering their schooling period are td be
   safe from injury.
   Research spanning more than 400 years highlights the weaknesses of a
   narrow perception. No area can be made 100\% safe. Injury prevention is
   intimately associated with the ability of an individual to correctly
   assess the risks within any situation. However, risk assessment, like
   any other skill has to be fostered and developed so that a child care
   centre needs to be able to assist the child to do this using a
   supportive physical environment I teaching program. In a very real
   sense, injury prevention and control needs to be seen as the result of a
   careful mix of design and management for learning about safety.-ro be
   effective. this requires both practitioners and regulators to understand
   the concepts involved in learning and not to treat children of 0-5 years
   as a uniform group. This paper also investigates ways through which this
   can be achieved.},
