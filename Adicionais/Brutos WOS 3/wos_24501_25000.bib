@inproceedings{ WOS:000288140200071,
Author = {Li, Ji and Xiao, Liping},
Editor = {Zou, YL and Jiang, Y and Zhang, JG and Chen, JQ},
Title = {Theoretical Study on Using RPE as the Monitoring Index of Exercise Load
   in PE Lessons},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 2},
Year = {2010},
Pages = {297-301},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {In this paper, issues about monitoring exercise load in Physical
   Education (PE) lessons were discussed through documentary research and
   analysis method. It is found that the exercise load is the key factor
   affecting PE quality and students' physical fitness, so it is of great
   significance to establish reasonable monitoring and evaluation system
   for the exercise load in PE lessons. At present, students' pulse rate is
   used as the monitor index for exercise load in PE lessons in China, but
   there exists obvious drawbacks with this approach. As an intensity index
   between psychology and physiology, RPE could quantify the change in
   physiological function occurred during stress state in the form of
   psychological perception. It is verified by numerous experiments that
   RPE has obvious correlation with other physiological indexes, and
   currently it has been widely used in competitive sports, exercise
   therapy and other fields, providing the theoretical basis of application
   in secondary schools and universities as exercise load index. It is
   suggested that applicability research on taking RPE as exercise load
   monitoring index should be undertaken, and its feasibility and method of
   operation should also be explored, so as to improve the monitoring and
   evaluation system of the exercise load in PE lessons.},
