@article{ WOS:000399358300038,
Author = {Yue, Wong Seng and Ken, Lee Weng},
Title = {An Exploratory Study: Security and Students' Awareness of Modular
   Object-Oriented Dynamic Learning Environment (MOODLE)},
Journal = {ADVANCED SCIENCE LETTERS},
