Note = {International Conference on Water Resource and Environmental Protection
   (WREP), Hong Kong, PEOPLES R CHINA, JUN 07-08, 2014},
Abstract = {When the ratio of aeration to non-aeration was 2:2 for intermittent
   aeration, artificially simulated water was utilised to study the N2O
   emission characteristics in single-stage autotrophic denitrification
   process. Results showed that when the ammonia concentration of influent
   water was 360 mg/L, N2O produced in single completely autotrophic
   nitrogen removal system and mainly produced in aeration process. N2O
   produced rarely in non-aeration units. In a typical operation cycle, the
   total N removal rate was 80.4\%, the amount of N2O emission was 79.67
   mg, and the N2O conversion rate was 3.33\%. The N2O emission was related
   to ammonia concentration.},
