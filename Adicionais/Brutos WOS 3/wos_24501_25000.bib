@inproceedings{ WOS:000659867303120,
Author = {Dmitriev, Maxim and Reverchuk, Igor and Glavatskikh, Marianna and
   Khejgetyan, Artur and Kotsura, Ol'ga},
Editor = {Rudoy, D and Olshevskaya, A and Kankhva, V},
Title = {Medical students' attitudes towards mental stigmatization and its
   associated with own and familial psychosomatic disorders},
Booktitle = {INNOVATIVE TECHNOLOGIES IN SCIENCE AND EDUCATION (ITSE-2020)},
Series = {E3S Web of Conferences},
Year = {2020},
Volume = {210},
