@inproceedings{ WOS:000467831700001,
Author = {Geissler, Hans-Georg},
Editor = {Lachmann, T and Weis, T},
Title = {Deciphering the Time Code of the Brain From Psychophysical Invariants to
   Universals of Neural Organization},
Booktitle = {INVARIANCES IN HUMAN INFORMATION PROCESSING},
