@inproceedings{ WOS:001007152800032,
Author = {Terziev, A. and Iliev, I. and Zlateva, P. and Ivanov, M.},
Book-Group-Author = {IOP},
Title = {Methodology for energy savings estimation, resulting from the
   development of a procedure for air pressure check in vehicle tires},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
