@inproceedings{ WOS:000370547300014,
Author = {Vasconcelos, Raquel O. and Alderks, Peter W. and Sisneros, Joseph A.},
Editor = {Sisneros, JA},
Title = {Development of Structure and Sensitivity of the Fish Inner Ear},
Booktitle = {FISH HEARING AND BIOACOUSTICS: AN ANTHOLOGY IN HONOR OF ARTHUR N. POPPER
   AND RICHARD R. FAY},
Series = {Advances in Experimental Medicine and Biology},
