@article{ WOS:A1992JB03900011,
Author = {MULLER, JC},
Title = {TOWARDS AN INTEGRATED CARTOGRAPHIC RESEARCH MODEL - SUGGESTIONS AND
   PRIORITIES},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {1992},
Volume = {16},
Number = {3},
Pages = {249-259},
Month = {MAY-JUN},
Note = {CONF ON GEOGRAPHIC INFORMATION SYSTEMS ( GIS ) : MULTIPLE REPRESENTATION
   AND MULTIPLE USES, BRNO, CZECHOSLOVAKIA, APR 22-25, 1991},
Organization = {INT GEOG UNION},
Abstract = {A research model for cartography is proposed based on the integration of
   three types of activities: a) data exploitation, b) data analysis, and
   c) data communication. The issue of cartographic institutions is added
   since institutions may decisively promote or critically impair the
   economical and social value of geoinformation. Specific areas where
   research is urgently needed are identified, including the seamless,
   scale independent cartographic database as opposed to the electronic map
   metaphor the relationship between data precision, accuracy and cost, the
   development of ``back-end{''} functions to support cartographic
   production, and the formulation of a new communication paradigm. It is
   argued that cartographic theory should be more of a driving force to
   further technological developments and applications in the future.},
