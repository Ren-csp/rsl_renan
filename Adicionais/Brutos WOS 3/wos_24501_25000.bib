Title = {Integrating Farmers and Scientific Methods for Evaluating Climate Change
   Adaptation Options in Embu County},
Booktitle = {ADAPTING AFRICAN AGRICULTURE TO CLIMATE CHANGE: TRANSFORMING RURAL
   LIVELIHOODS},
