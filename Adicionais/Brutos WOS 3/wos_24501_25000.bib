Title = {Pilot is a Pilot is a Pilot?: Exploration of Effects of Professional
   Culture in Helicopter Pilots},
Booktitle = {PROCEEDINGS OF THE 21ST CONGRESS OF THE INTERNATIONAL ERGONOMICS
