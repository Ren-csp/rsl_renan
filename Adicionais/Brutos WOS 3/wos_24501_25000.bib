Title = {The appropriateness of the traditional techology for low-income housings
   in Maracaibo, Venezuela},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {639-647},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {In Latin America, the criteria for low-income houses construction
   technology have been the adaptation to local conditions. Some
   specialists have turned to ``traditional technologies{''}, but limited,
   in some cases, to proposals that copy them, without a psico-social,
   holistic study. This research looks for a psico-social interpretation of
   the appropriateness of technology by low-income communities in order to
   lead the incorporation of innovative technologies, according to their
   way of living. Among these considerations, the objective of this case
   study was to verify the congruency between the attributes of traditional
   technology, commonly used in Maracaibo, Venezuela, and the community's
   perception images of its construction mental model.
   Theoretical reflections on technology; construction proposals for Latin
   America; collective identity; ``traditional{''} technology; and
   Environmental Psychology considerations are extrapolated to be used as a
   conceptual basis and a reference frame for the case study in the
   ``Barrio Virgen del Carmen{''}, of Maracaibo.
   Through observation and workshops in the community, results which
   support the holistic concept of construction technology (beyond the
   purely technical emphasis) are achieved; expressing that as a man's
   manifestation, it shows not only the resources available but also the
   manner of construction assimilated and expressed in a structured form in
   the mental images of people.},
