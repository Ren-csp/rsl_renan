@article{ WOS:A1997XX98000004,
Author = {Wu, AW and Revicki, DA and Jacobson, D and Malitz, FE},
Title = {Evidence for reliability, validity and usefulness of the Medical
   Outcomes Study HIV Health Survey (MOS-HIV)},
Journal = {QUALITY OF LIFE RESEARCH},
