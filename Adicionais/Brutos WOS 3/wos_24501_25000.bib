@article{ WOS:000229570500026,
Author = {Volkow, ND and Wang, GJ and Fowler, JS and Ding, YS},
Title = {Imaging the effect of methylphenidate on brain dopamine: New model on
   its therapeutic actions for attention-deficit/hyperactivity disorder},
