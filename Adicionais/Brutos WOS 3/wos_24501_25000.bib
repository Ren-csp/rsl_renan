Note = {2nd International Symposium on Work Ability, Verona, ITALY, OCT 18-20,
   2004},
Organization = {Univ Milan; Univ Verona; Int Ergon Assoc, Aging Comm; Italian Inst
   Occupat Safety \& Prevent; Natl Inst Rest \& Therapy Aged People},
Abstract = {In the present study we examined the perceived role of work in the lives
   of younger and older adults in three different occupations: teaching,
   nursing, and small business. On the basis of lifespan developmental
   theory of changes in work-related values across the lifespan we expected
   that (1) older adults would rate their job satisfaction and
   organisational commitment more highly than younger adults, and (2)
   younger adults would rate the importance of work more highly than older
   workers. Based on utility theory we expected that nurses and teachers
   would view early retirement more positively than small business
   employees because of early retirement incentives in these two careers.
   One-hundred-sixty-two participants completed a 118-item survey. Overall
   few age differences were found between older and younger workers. On
   average, all participants rated work as moderately important and their
   job satisfaction as moderately high. Nonetheless, older participants
   rated their job satisfaction higher than younger participants. On
   average, all groups believed they would retire before 65 years of age.
   The latter finding is important for workability theory and raises issues
   about how to change attitudes, perceptions and values about working past
   traditional retirement ages. (c) 2005 Elsevier B.V. All rights reserved.},
