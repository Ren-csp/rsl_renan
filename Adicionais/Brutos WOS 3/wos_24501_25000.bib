@inproceedings{ WOS:001591421300031,
Author = {Rizzi, Alice and di Furia, Marco and Toto, Giusi Antonia},
Editor = {Toto, GA},
Title = {WebTVs as Channels for Scientific Communication: A Case Study from the
   University of Foggia},
