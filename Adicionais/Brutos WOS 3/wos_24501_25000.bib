@article{ WOS:000444975300095,
Author = {Nguyen Thuy Van and Said, Hamdan and Khan, Aqeel},
Title = {Using Partial Least Squares (PLS) Approach to Predict Factors Impact of
   Evaluation Criteria of Academic Advising in Malaysian Public
   Universities},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3459-3464},
