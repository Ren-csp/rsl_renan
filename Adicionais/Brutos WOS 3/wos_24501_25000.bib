@inproceedings{ WOS:000425332900035,
Author = {Torres, Isabel and Guerreiro, Miguel and Rodrigues, Paula and Monarca,
   Adelia and Barradas, Daniel},
Editor = {Tsui, E and Cheung, B},
Title = {Creation of a Tacit Knowledge Scale in Succession Process of Family
   Business},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2017)},
