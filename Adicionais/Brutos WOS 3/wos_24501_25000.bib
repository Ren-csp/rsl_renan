@inproceedings{ WOS:000320995400093,
Author = {Pinheiro, Francisco Alves and Dias, Eduardo Brasileiro},
Editor = {Arezes, P and Baptista, JS and Barroso, MP and Carneiro, P and Cordeiro, P and Costa, N and Melo, R and Miguel, AS and Perestrelo, GP},
Title = {Influence of ergonomic aspects of classroom teaching and learning
   activity: the case of a school for elementary and high school in the
   city.},
Booktitle = {SHO2011: INTERNATIONAL SYMPOSIUM ON OCCUPATIONAL SAFETY AND HYGIENE},
Year = {2011},
Pages = {502-506},
Note = {7th International Symposium on Occupational Safety and Hygiene (SHO),
   Univ Minho, Sch Engn, Guimaraes, PORTUGAL, FEB 10-11, 2011},
Organization = {Portuguese Soc Occupat Safety \& Hlth},
Abstract = {The present objective study to identify and to evaluate the working
   conditions in the environment of classroom of a elementary and high
   state school in Petrolina/PE, as well as the influences of the ergonomic
   aspects in the activity of teach-learning. For this, was performed a
   study of case in two distinct shifts, afternoon and night, through a
   survey of the perceptions of those involved, teachers and students,
   about the environmental variables, which are: illumination, noise,
   temperature and furniture, in order to make a parallel with the data
   that had been collected from the environment by means of specialized
   instruments. The procedure of data analysis was based on prescribed
   Brazilian norms of the Brazilian Association of Techniques Norms,
   prescribed norms of the Ministry Labor and Employment and norms of the
   ISO (International Organization for Standardization). The results had
   indicated that, in general, the classroom of this school, in the two
   investigated shifts, is not adjusted to the above norms and, due to
   this, the ergonomic factors of this work environment, because of its
   relation to the health and productivity of the teachers, should be
   target of concerns and adjustment measures, in order to reduce possible
   occupational risks and to minimize its negative effect on quality of the
   transmission of knowledge through the activity of teach-learning.},
