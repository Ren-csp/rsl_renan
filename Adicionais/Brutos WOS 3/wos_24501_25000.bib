@article{ WOS:000167214000015,
Author = {van de Grind, WA and van Hof, P and van der Smagt, MJ and Verstraten,
   FAJ},
Title = {Slow and fast visual motion channels have independent binocular-rivalry
   stages},
Journal = {PROCEEDINGS OF THE ROYAL SOCIETY B-BIOLOGICAL SCIENCES},
Year = {2001},
Volume = {268},
Number = {1465},
Pages = {437-443},
