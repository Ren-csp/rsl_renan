@article{ WOS:000432429600044,
Author = {Hamdan, Fairus and Nordin, Norazah and Khalid, Fariza and Muslimin,
   Mohamad Siri and Norman, Helmi},
Title = {Technology Acceptance of Online Managerial Finance Training via Massive
   Open Online Courses for Lifelong Learning},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {4},
Pages = {2365-2369},
