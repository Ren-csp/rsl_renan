@inproceedings{ WOS:000227683000031,
Author = {Schramm, D},
Editor = {Miyamoto, RT},
Title = {Surgical technique for the implantation of the Advanced Bionics HiRes
   90K device with HiFocus perimodiolar (Helix) electrode},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2004},
Volume = {1273},
Pages = {129-132},
Note = {8th International Cochlear Implant Conference, Indianapolis, IN, MAY
   10-13, 2004},
Organization = {NIDCD; Psi Iota Xi; Indiana Lions; St Joseph Inst Deaf; Indiana Univ
   Cochlear Implant Team},
Abstract = {The HiRes 90K implant with the HiFocus perimodiolar electrode has
   recently been introduced for clinical trial in Canada. Potential
   advantages of a perimodiolar electrode array include improved speech
   perception and reduced current requirements. From a surgical
   perspective, the primary objective of the HiFocus perimodiolar electrode
   feasibility study was to gain experience and comfort with the handling
   characteristics of the new electrode array. Patient selection for the
   HiFocus perimodiolar electrode clinical trial was similar to other
   cochlear implant trials, including postlingual adult patients with
   severe to profound hearing loss. The precurved electrode array is
   inserted into the cochlea using an electrode insertion tool with stylet
   assembly. The HiRes 90K surgical implantation procedure has been
   modified to ensure optimal electrode placement. Since October 2003, this
   device has been inserted in 20 patients at the Ottawa Hospital Cochlear
   Implant Center. No surgical difficulties were encountered in the
   implantation and placement of the HiRes 90K device with the HiFocus
   perimodiolar electrode. Initial experience has demonstrated an
   intracochlear insertion depth of approximately 21 mm. A series of
   intraoperative tests consistently confirmed satisfactory device function
   after implant insertion. Perimodiolar placement of the electrode array
   was demonstrated on postsurgical X-rays. (c) 2004 Published by Elsevier
