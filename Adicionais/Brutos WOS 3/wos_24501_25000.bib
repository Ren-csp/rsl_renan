@inproceedings{ WOS:000237755500150,
Author = {Topcuoglu, B. lent},
Editor = {Lekkas, TD},
Title = {The usage of MSW compost as partial substitutes for peat on the growth
   of poinsettia (Euphorbia pulcherrima)},
Booktitle = {Proceeding of the 9th International Conference on Environmental Science
   and Technology Vol B - Poster Presentations},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {B921-B926},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {The cost of high quality peat for horticultural use, together with the
   declining availability of peat in the near future due to environmental
   constraints, especially in countries without peat moss resources, make
   it necessary to look for alternative materials. The use of different
   urban solid materials; in the production of substrates for ornamental
   plants is a practice leading to economic and environmental problems.
   Production and use of municipal solid waste (MSW) compost is an
   effective means to reduce wastes, and offers a large potential as growth
   and source of nutrients.
   In this study, the feasibility of MSW compost to produce alternative
   substrate for poinsettia (Euphorbia pulcherrima) plant has been
   investigated. In the greenhouse experiment, poinsettia plant was grown
   in pots containing mixtures of peat and perlite (4:1 v/v). Peat was
   replaced by MSW compost at the rates of 25 and 50\%. Some physical and
   chemical properties of the growing media, and horticultural parameters,
   nutrient elements and heavy metal composition of poinsettia grown in
   those media were evaluated.
   The effects of growing media on plant growth, horticultural parameters
   and mineral status of poinsettia were found significant. Plant growth
   was enhanced and several important horticultural parameters, such as
   plant dry weight, plant height, numbers of leaf and bract, leaf and
   bract areas were improved in poinsettia plant grown in media containing
   25\% volume of MSW compost. Nutrient and heavy metal contents of
   poinsettia grown in MSW compost added media were increased. All
   horticultural parameters of poinsettia plants grown in Medium containing
   25\% MSW compost were similar to control. Plants grown in media in which
   50\% of peat was replaced by MSW compost showed an inhibited growth.
   Both total porosity and air capacity of 50\% MSW compost added Media and
   were not in ideal levels, and also electrical conductivity (EC) and
   heavy metal contents were the highest. However, there were no phytotoxic
   effects on plant growth due to contamination of growth media with heavy
   metals irrespective of the level of incorporation into peat.
   Both plant and media analysis showed that 25\% volume of peat was
   successfully replaced by MSW compost while not diminishing the quality
   of poinsettia. Due to physical and chemical characteristics, and the
   effects on the growth and horticultural parameters of poinsettia, MSW
   compost may be considered as partial peat substitutes.},
