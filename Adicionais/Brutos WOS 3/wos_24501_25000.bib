@article{ WOS:000238859400007,
Author = {Wang, X. and Ji, M. and Wang, J. F. and Liu, Z. and Yang, Z. Y.},
Title = {Anaerobic uptake of phosphate in an anaerobicaerobic granular sludge
   sequencing batch reactor},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
