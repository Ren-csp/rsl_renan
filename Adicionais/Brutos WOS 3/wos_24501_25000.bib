@inproceedings{ WOS:000449954600013,
Author = {Velez-Arocho, J. and Torres, R. and Velaquez-Rivera, S. M. and Rivera,
   G.},
Editor = {Brebbia, CA and Garcia, JLMI},
Title = {Promoting sustainability through brownfields redevelopment in Caguas,
   Puerto Rico},
