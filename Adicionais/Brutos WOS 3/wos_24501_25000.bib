Title = {Psycho-social Determinants of Academic Well-being for International
   Students from Developed Countries who Study in Developing Countries},
Booktitle = {PROCEEDINGS OF THE 3RD ASEAN CONFERENCE ON PSYCHOLOGY, COUNSELLING, AND
   HUMANITIES (ACPCH 2017)},
Series = {Advances in Social Science Education and Humanities Research},
