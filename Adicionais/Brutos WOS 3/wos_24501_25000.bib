Title = {Numerical and experimental studies to increase the HVAC fan performance
   for electrical vehicles Part 2},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
