Title = {COMMUNITY MEDIA TO DIFFUSE SUSTAINABLE ENERGY PRODUCTS: PERCEIVED
   EFFECTIVENSS},
Booktitle = {AIMC 2017 - ASIA INTERNATIONAL MULTIDISCIPLINARY CONFERENCE},
