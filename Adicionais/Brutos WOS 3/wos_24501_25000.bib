@article{ WOS:A1992JL30000005,
Author = {LAURINI, R and MILLERETRAFFORT, F},
Title = {A CONCEPTUAL-FRAMEWORK FOR MULTIPLE REPRESENTATIONS OF SPATIAL OBJECTS
   WITH THE ENTITY-RELATIONSHIP APPROACH},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {1992},
Volume = {16},
Number = {4},
Pages = {299-311},
Month = {JUL-AUG},
Note = {HISTORIC CONF ON GEOGRAPHIC INFORMATION SYSTEMS : MULTIPLE
   REPRESENTATION AND MULTIPLE USES, BRNO, CZECHOSLOVAKIA, APR 22-25, 1991},
Organization = {INT GEOG UNION},
Abstract = {By definition, any spatial object consists of an infinity of points;
   therefore, any extensional representation of spatial objects is
   impossible. So in this paper we show that this model can be replaced by
   intensional models based on rules allowing the mapping from intensional
   to extensional representation and some constraints to ensure object
   consistency.
   A first family of spatial representation is based on Euclidean points.
   Some privileged points are selected together with some links between
   them. In this case, we need generating and membership testing rules. For
   illustration we take some terrain models (Triangulated Irregular
   Networks, grids, and contours). A second family is based on fractal
   points, which can be defined by squares or cubes whose size is tending
   toward zero. Here we can define a terrain by a limited set of fractal
   points with a given level of resolution (devil's staircases). Since the
   fractal points can always be split into other ``smaller{''} points, a
   disaggregation-aggregation rule can be defined. In order to illustrate
   these principles, terrains can be represented by the raster and the
   quadtree models.
   For each representation we explain how to derive it, and we give its
   entity-relationship diagram including relations, rules, and spatial
   integrity constraints.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
