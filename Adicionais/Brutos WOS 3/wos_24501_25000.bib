@inproceedings{ WOS:A1994BA95X00008,
Author = {GEORGESON, MA},
Editor = {Bock, GR and Goode, JA},
Title = {FROM FILTERS TO FEATURES - LOCATION, ORIENTATION, CONTRAST AND BLUR},
Booktitle = {HIGHER-ORDER PROCESSING IN THE VISUAL SYSTEM},
