Title = {Comparative study regarding retrofitting with a low GWP refrigerant in
   an ice rink with energy recovery implementation},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2023},
