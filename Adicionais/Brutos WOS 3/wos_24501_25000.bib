Title = {Assessing the emerging agribusiness entrepreneurs by using brainwave
   technology},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON SUSTAINABLE AGRICULTURE FOR RURAL
   DEVELOPMENT 2020},
Series = {IOP Conference Series-Earth and Environmental Science},
