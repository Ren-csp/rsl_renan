@article{ WOS:A1992KB29900007,
Author = {REIS, J and MILLSTHOMAS, B and ROBINSON, D and ANDERSON, V},
Title = {AN INNER-CITY COMMUNITY PERSPECTIVE ON INFANT-MORTALITY AND
   PRENATAL-CARE},
Journal = {PUBLIC HEALTH NURSING},
