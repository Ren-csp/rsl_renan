@inproceedings{ WOS:000258136700014,
Author = {Irwin, T. and Baxter, S.},
Editor = {Brebbia, CA},
Title = {The dynamical view of natural form},
Booktitle = {DESIGN AND NATURE IV: COMPARING DESIGN IN NATURE WITH SCIENCE AND
   ENGINEERING},
