Title = {Supports Treatment Compliance by Sharing Happiness and Being Friends: A
   Case Study in ``Sahabat Anak Kanker{''} Community in Indonesia},
Booktitle = {PROCEEDINGS OF THE HEALTH SCIENCE INTERNATIONAL CONFERENCE (HSIC 2017)},
