@inproceedings{ WOS:000469511300019,
Author = {Sousa, Antonio and Sousa, Catia and Goncalves, Gabriela and Zica, Jose},
Editor = {Arezas, P and Baptista, JS and Carneiro, P and Cordeiro, P and Costa, N and Melo, R and Miguel, AS and Perestrelo, G},
