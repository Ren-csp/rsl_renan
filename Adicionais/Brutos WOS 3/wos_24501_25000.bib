@article{ WOS:000403707200007,
Author = {Le Thi Thanh Loan and Nomura, Hisako and Takahashi, Yoshifumi and Yabe,
   Mitsuyasu},
Title = {Psychological driving forces behind households' behaviors toward
   municipal organic waste separation at source in Vietnam: a structural
   equation modeling approach},
Journal = {JOURNAL OF MATERIAL CYCLES AND WASTE MANAGEMENT},
Year = {2017},
Volume = {19},
Number = {3},
Pages = {1052-1060},
Month = {JUL},
Note = {3rd 3R International Scientific Conference on Material Cycles and Waste
   Management (3RINCs), Hanoi, VIETNAM, MAR 09-11, 2016},
Abstract = {Most recent municipal organic waste-separation at source (MOW-SAS)
   programs that have been introduced in developing countries remain pilot
   programs, but have not fully developed into sustainable municipal
   solid-waste management strategies. The city of Hoi An, Vietnam,
   implemented a mandatory MOW-SAS program in 2012. Using Structural
   Equation Modeling, this study investigates the psychological driving
   forces behind households' behaviors toward the MOW-SAS program. This
   study finds that moral norm (moral perception of what is good or bad),
   attitude toward sorted waste, and situational factors (issues concerning
   physically sorting garbage, such as time, space, and lack of family
   cooperation) can significantly affect household behaviors toward
   MOW-SAS. It confirms the need for supplying frequent environmental
   educational campaigns and highlighting the benefits of MOW-SAS programs.
   Moreover, the study finds that households' system trust in local
   authority concerning the MOW-SAS program is an important driving force
   behind the behavior. Therefore, recommendation is also made on the need
   to develop strong leadership in local authorities through improving: (1)
   reliability (ability to effectively treat sorted waste), (2) legitimacy
   (punitive measures for non-participants), and (3) effectiveness
   (dissemination of information about the benefits of MOW-SAS programs)
   for promoting MOW-SAS.},
