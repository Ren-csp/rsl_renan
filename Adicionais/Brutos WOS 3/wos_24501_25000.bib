@article{ WOS:000238859400027,
Author = {Wei, Dongbin and Wang, Lisha and Wei, Jie and Hu, Hong-Ying},
Title = {Toxicity screening and evaluating in chlorination disinfection of
   wastewater reclamation processes},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
