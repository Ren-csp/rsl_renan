@inproceedings{ WOS:000507986700011,
Author = {Djamasbi, Soussan and Tulu, Bengisu and Nia, Javad Norouzi and Aberdale,
   Andrew and Lee, Christopher and Muehlschlegel, Susanne},
Editor = {Schmorrow, DD and Fidopiastis, CM},
Title = {Using Eye Tracking to Assess the Navigation Efficacy of a Medical Proxy
   Decision Tool},
Booktitle = {AUGMENTED COGNITION, AC 2019},
