@article{ WOS:A1993KL97000009,
Author = {OBERMEYER, NJ},
Title = {CERTIFICATION AND ACCREDITATION IN GIS - PROSPECTS AND PITFALLS},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
