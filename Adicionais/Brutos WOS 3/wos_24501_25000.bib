@inproceedings{ WOS:000392266100035,
Author = {Shefi, Judith and Chis, Vasile},
Editor = {Chis, V and Albulescu, I},
Title = {Teacher-Students Relationship. The Significance to Decreasing Dropout
   Rates and Motivation for Change},
Booktitle = {ERD 2016 - EDUCATION, REFLECTION, DEVELOPMENT, FOURTH EDITION},
