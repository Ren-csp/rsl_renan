   Ferraz},
Editor = {Rocker, C and ODonoghue, J and Ziefle, M and Maciaszek, L and Molloy, W},
Title = {Delivering Information of General Interest Through Interactive
   Television: A Taxonomy of Assistance Services for the Portuguese Elderly},
Booktitle = {INFORMATION AND COMMUNICATION TECHNOLOGIES FOR AGEING WELL AND E-HEALTH,
   ICT4AWE 2017},
