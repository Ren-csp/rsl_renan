@inproceedings{ WOS:000188893400062,
Author = {Overy, K},
Editor = {Avanzini, G and Faienza, C and Minciacchi, D and Lopez, L and Majno, M},
Title = {Dyslexia and music - From timing deficits to musical intervention},
Booktitle = {NEUROSCIENCES AND MUSIC},
