Title = {A testbed for neural-network models capable of integrating information
   in time},
Booktitle = {ANTICIPATORY BEHAVIOR IN ADAPTIVE LEARNING SYSTEMS: FROM BRAINS TO
   INDIVIDUAL AND SOCIAL BEHAVIOR},
