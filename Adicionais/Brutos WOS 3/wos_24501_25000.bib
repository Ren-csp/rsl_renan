@article{ WOS:000244144500006,
Author = {Flowerdew, Robin and Feng, Zhiqiang and Manley, David},
Title = {Constructing data zones for Scottish Neighbourhood Statistics},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2007},
Volume = {31},
