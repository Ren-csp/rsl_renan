@inproceedings{ WOS:000080795800024,
Author = {Peng, H and Jin, RN},
Book-Group-Author = {INT RES \& TRAINING CTR EROS \& SEDIMENTAT
   INT RES \& TRAINING CTR EROS \& SEDIMENTAT},
Title = {Source exploring of sediment in the Yellow River},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON COMPREHENSIVE WATERSHED
   MANAGEMENT (ISWM-'98)},
Year = {1998},
Pages = {175-181},
Note = {International Symposium on Comprehensive Watershed Management (ISWM-98),
   BEIJING, PEOPLES R CHINA, SEP 07-10, 1998},
Organization = {UNESCO; PWMTA; FAO, Netherlands},
Abstract = {Based on the conventional analysis suggested by Qian et al (1980),
   impacts of the regional geomorphologic features and human activities are
   taken into account in the present paper for exploring the source area of
   coarse sediment of the Yellow River. Successive field data since 1960s
   are used for statistical analyses. It is shown that the coarse sediment
   yields supplied to the Middle Yellow River are decreased since 1970s
   owing to the development of water-and-soil conservation on a large scale
   and the reduction of precipitation. However, the Middle Yellow River
   basin is still the main source of coarse sediment, and more than 85\%
   coarse sediment comes from the catchments of the Kuye, Huangfu and
