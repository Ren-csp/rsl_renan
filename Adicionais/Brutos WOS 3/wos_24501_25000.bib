@article{ WOS:000182895300016,
Author = {Sgoifo, A and Braglia, F and Costoli, T and Musso, E and Meerlo, P and
   Ceresini, G and Troisi, A},
Title = {Cardiac autonomic reactivity and salivary cortisol in men and women
   exposed to social stressors: relationship with individual ethological
   profile},
Journal = {NEUROSCIENCE AND BIOBEHAVIORAL REVIEWS},
Year = {2003},
Volume = {27},
Number = {1-2},
Pages = {179-188},
