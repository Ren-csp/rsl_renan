@article{ WOS:000444975300067,
Author = {Almuslamani, Hashem Ali Issa and Daud, Salina},
Title = {Strategic HR Practices and Sustainable Competitive Advantage in Bahrain},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
