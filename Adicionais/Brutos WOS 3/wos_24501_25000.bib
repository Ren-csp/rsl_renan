@inproceedings{ WOS:000077671500017,
Author = {Discry, F},
Editor = {DeKeyser, V and dYdewalle, G and Vandierendonck, A},
Title = {Temporal relations in a dynamic process: The content effect of mimic
   displays},
Booktitle = {TIME AND THE DYNAMIC CONTROL OF BEHAVIOR},
Year = {1998},
Pages = {275-301},
Note = {Symposium on Time and the Dynamic Control of Behavior, UNIV LIEGE,
   LIEGE, BELGIUM, NOV 07-08, 1994},
Abstract = {In order to preserve some ecological validity, it is in our interest to
   better understand how operators respond to computer-simulated dynamic
   process and what influence mimic displays have on learning temporal
   structures. The aim of this study is twofold:on the one hand, it
   attempts to identify, in a dynamic process, the effects of mimic
   displays' characteristics (as the concrete or abstract content, and the
   number of pertinent or non-pertinent variables) on the performance and
   on the learning mode; on the other hand, it tries to determine if
   subjects abstract identically different temporal structures (cyclical
   structure, simple causal structure, complex causal structure) and how
   mimic displays can support these abstractions. First results showed a
   better performance on an anticipation task with a concrete situation
   than with an abstract one. On the other hand, the number of relevant
   variables did not influence the performance. Other results gave some
   information about the perception of psychological time, subjects first
   abstract the order of events and then adjust their evaluation of the
   duration. Moreover, a concrete situation induces a good estimation of
   the order as well as the duration of events whereas an abstract
   situation allows subjects to internalize more precisely the order than
   the duration.},
Publisher = {HOGREFE \& HUBER PUBLISHERS},
Address = {12 BRUCE PARK AVE, TORONTO, ON M4P 2S3, CANADA},
