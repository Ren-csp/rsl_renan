@inproceedings{ WOS:001007152800038,
Author = {Zasimova, M. A. and Stepasheva, E. D. and Ivanov, N. G.},
Book-Group-Author = {IOP},
Title = {Effect of thermal manikin shape on thermal comfort parameters prediction
   uncertainties: a numerical study},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2023},
