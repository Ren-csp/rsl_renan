@inproceedings{ WOS:000681358200039,
Author = {Li, Yan and Chou, Chih-Hong and Zhang, Jie and Zhang, Zhuozhi and Hao,
   Manzhao and Lan, Ning},
Book-Group-Author = {IEEE},
Title = {A Pilot Study of Multi-Site Simultaneous Stimulation for Tactile and
   Opening Information Feedback in the Prosthetic Hand},
Booktitle = {2021 10TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2021},
Pages = {187-190},
Note = {10th International IEEE-EMBS Conference on Neural Engineering (NER),
   Prague, ELECTR NETWORK, MAY 04-06, 2021},
Organization = {Medtronic; Blackrock Microsystems; IEEE Engn Med \& Biol Soc; Inst
   Italiano Tecnologia; Biorobot Inst; Sant Anna Sch Adv Studies; Univ
   Houston, Cullen Coll Engn, Dept Biomed Engn; Wearable Robot; Frontiers
   Neuroscience; EPFL; Elsevier; CorTec; Abbott; Univ Pittsburgh; IEEE
   Transact Neural Syst \& Rehabilitat Engn; IEEE Open Journal Engn Med \&
   Biol},
Abstract = {Evoked tactile sensation (ETS) can produce precise perception of
   individual digits of hands in transradial amputees. This paper addresses
   the question of how ETS can be combined with non-somatotopic stimulation
   (NSS) for tactile and opening information feedback during prosthetic
   grasping. Two amputee subjects performed multi-digit prosthetic grasping
   experiments. Five stimulation electrodes were placed on the most
   sensitive points in projected finger map (PFM) on the stump skin of
   amputees. Pulse width of each stimulation current was linearly modulated
   with contact force at prosthetic fingers. Another stimulation electrode
   was placed on ipsilateral upper arm or forearm to convey opening
   information of the prosthetic hand. Results indicated that ETS provided
   high precision of single digit differentiation, but perceptibility for
   multiple digits was reduced by 37.5\% and 42.0\% in the two subjects.
   However, if only detection of number of digits in contact with objects
   was required, they were able to tell with high accuracy rate of 98.3\%
   and 73.3\%, respectively. Hand opening can be well distinguished with
   NSS in the ipsilateral upper arm. Finally, hybrid information of object
   length and size can be conveyed to amputees via combined ETS and NSS in
   upper arm. Preliminary results suggested that although multi-site
   simultaneous stimulation compromised perceptibility of multi-digits, it
   afforded amputees with ability to discriminate object length and size
   (hand opening).},
