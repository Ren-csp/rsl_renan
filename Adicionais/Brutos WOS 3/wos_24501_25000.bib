Title = {The effects of soil pollution and its relation with morbidity in
   shoreline areas},
Booktitle = {RISK ANALYSIS VII: SIMULATION AND HAZARD MITIGATION \& BROWNFIELDS V:
   PREVENTION, ASSESSMENT, REHABILITATION AND DEVELOPMENT OF BROWNFIELD
   SITES},
