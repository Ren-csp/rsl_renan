@article{ WOS:A1992KF67700035,
Author = {PAXEUS, N and ROBINSON, P and BALMER, P},
Title = {STUDY OF ORGANIC POLLUTANTS IN MUNICIPAL WASTE-WATER IN GOTEBORG, SWEDEN},
