@inproceedings{ WOS:001007152800030,
Author = {Shafiu, R. M. and Salleh, M. A. and Bala, H. and Shafiu, A. M. and
   Abdullahi, Umar},
Book-Group-Author = {IOP},
Title = {Analysis on IMF Loan Conditions with more Detrimental Impact on the
   Economy: A Case Study of Nigeria},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2023},
