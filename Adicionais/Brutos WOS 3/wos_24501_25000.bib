Author = {Predoiu, Radu and Ramsey, Paula and Arsenescu, Florian},
Editor = {Grigore, V and Stanescu, M and Paunescu, M},
Title = {Intellectual Abilities in Top Male Junior Tennis Players},
Booktitle = {ICPESK 2015 - 5TH INTERNATIONAL CONGRESS ON PHYSICAL EDUCATION, SPORT
   AND KINETOTHERAPY},
Series = {European Proceedings of Social and Behavioural Sciences},
