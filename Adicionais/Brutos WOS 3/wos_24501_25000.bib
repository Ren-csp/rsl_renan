@inproceedings{ WOS:000076534900019,
Author = {Kavian-Lanjani, J and Ohlsson, K},
Editor = {Chiyotani, K and Hosoda, Y and Aizawa, Y},
Title = {The impact of expert community on miners' risk management of respiratory
   diseases},
Booktitle = {ADVANCES IN THE PREVENTION OF OCCUPATIONAL RESPIRATORY DISEASES},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1998},
Volume = {1153},
Pages = {101-105},
Note = {9th International Conference on Occupational Respiratory Diseases,
   KYOTO, JAPAN, OCT 13-16, 1997},
Organization = {Japanese Natl Organizing Comm; Min Labour Japan; Intl Labour Off; Japan
   Ind Safety \& Hlth Assoc},
Abstract = {A study of silicosis at Laisvall Mine in Sweden compared to ``black
   lung{''} in the Appalachian coal districts is described. In both cases,
   many miners contracted lung diseases despite the company doctor's
   knowledge about the risks of quartz dust exposures. The miners had no
   scientific evidence for their suspicions about lung diseases. They were
   dependent on experts providing them with facts. The ambiguous stance of
   the expert community greatly influenced the miners' conceptual framework
   of risk perception. However, the prevailing opinions and attitudes held
   by the majority of the occupational health experts gradually changed as
   a consequence of the miners' actions as influenced by external experts.
   This dependency on experts still dominates the miners' struggle for
   recognition of the diseases and their claims for care and compensation,
   especially in the industrially developing countries (IDCs). Available
   knowledge of risk factors was also dependent on the expert community's
   attitudes towards occupational problems. The technical and
   organizational context of the working life discussed were in many
   respects similar to what is now the case in many of the IDCs. The
   experiences from the resolution of silicosis and ``black lung{''} can be
   useful for the understanding of miners' risk management in IDCs.},
Publisher = {ELSEVIER SCIENCE BV},
