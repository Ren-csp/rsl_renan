@inproceedings{ WOS:000231350200001,
Author = {Mittelman, N and Bleich, N and Pratt, H},
Editor = {Tsuji, S and Tobimatsu, S and Kakigi, R and Uozumi, T and Akamatsu, N},
Title = {Early ERP components to gaps in white noise: onset and offset effects},
Booktitle = {UNVEILING THE MYSTERY OF THE BRAIN: NEUROPHYSIOLOGICAL INVESTIGATION OF
   THE BRAIN FUNCTION},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2005},
Volume = {1278},
Pages = {3-6},
Note = {8th International Evoked Potential Symposium, Fukuoka, JAPAN, OCT 05-08,
   2004},
Organization = {Fukuoka Convent Bureau; Japan World Exposit 70, Commemorat Org; Osaka
   Pharmaceut Mfg Assoc},
Abstract = {Evoked potentials to two stimulus types were compared: (1) binaural
   continuous white noise with randomly distributed gaps of different
   durations and (2) click pairs presented with intervals identical to the
   gap durations. Potentials were detected in response to gaps of 5 ms or
   longer, corresponding to the subjects' psychoacoustic gap detection
   threshold. The waveforms to all click pairs and to gap offsets were
   similar and single-peaked, while response to gap onset included two N I
   negativities about 60 ms apart, regardless of gap duration. The first
   peak (N1a) was more frontal in its distribution and similar to that of
   clicks. The second (N1b) peak's scalp distribution was more
   central/temporal. The differences between waveforms to click pairs and
   gap offsets, compared with gap onsets, suggest that potentials to gap
   onsets involve more than just onset/offset responses (NI, N1a) but also
   the subsequent perception of the cessation of an ongoing sound (N1b). In
   previous studies, two processes were defined: (1) M-process to deviation
   from the preceding auditory pattern and (2) C-process in response to
   acoustic change within an ongoing stream. We propose that N1b is
   different from these processes because it relates to the negation of an
   ongoing stimulus, and we thus call it an N-process. (c) 2004 Elsevier
   B.V. All rights reserved.},
