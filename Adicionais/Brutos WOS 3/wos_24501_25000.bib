@inproceedings{ WOS:000227339000041,
Author = {Lawoyin, TO and Akumatey, B and Nyiama, T and MacQueen, KM and Guest, G
   and Amoran, OE},
Book-Group-Author = {MEDIMOND},
Title = {Barriers to effective control of HIV/AIDS among male partners of
   commercial sex workers in Ibadan, Nigeria},
Booktitle = {XV INTERNATIONAL AIDS CONFERENCE: EPIDEMIOLOGY AND PREVENTION},
Year = {2004},
Pages = {201-205},
Note = {15th International AIDS Conference, Bangkok, THAILAND, JUL 11-17, 2004},
Abstract = {Male sexual partners of commercial sex workers (CSW) are at an increased
   risk for HIV, but many of the HIV control programs have not been focused
   towards the control of the spread of the disease among this high-risk
   group. The objective of this study was to identify constraints to
   effective preventive measures and specifically to identify reasons why
   men visit CSW/brothels, to determine their level of knowledge on
   preventive options, their perception of risk, condom use and to explore
   emerging themes. A total of 3 focus group discussions (FGD) and 7
   in-depth interviews and participant observations were employed in
   obtaining data from 37 partners of CSW enrolled in selected brothels
   within Ibadan municipality. Results showed that the men were aware of
   HIV prevention options but reported that they were generally
   unacceptable. Condoms were readily available and accessible but most men
   would rather have sex without the condom especially if they could afford
   the higher price demanded for this favor by the CSW. HlV/AlDS knowledge
   was very high though some men did not believe that they could contract
   HIV/AIDS. Strategies should urgently be put in place to address
   behaviors, which promote the spread of the disease among these men.},
