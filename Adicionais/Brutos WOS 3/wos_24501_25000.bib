   Tajul and Shukery, Nurshikin Mohamad and Mahmud, Syamsul Hendra},
Editor = {Qureshi, MI},
Title = {RAINWATER HARVESTING IN MALAYSIA: A SURVEY ON FOSTERING-SIDE AND
   ACCEPTING-SIDE},
Booktitle = {AIMC 2017 - ASIA INTERNATIONAL MULTIDISCIPLINARY CONFERENCE},
Series = {European Proceedings of Social and Behavioural Sciences},
Year = {2018},
