@inproceedings{ WOS:000331259200366,
Author = {Brunton, Emma K. and Rajan, Ramesh and Lowery, Arthur J.},
Book-Group-Author = {IEEE},
Title = {Optimising Electrode Surface Area to Minimize Power Consumption in a
   Cortical Penetrating Prosthesis},
Booktitle = {2013 6TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2013},
