@article{ WOS:A1993ML72000010,
Author = {RAMANATHAN, AL and VAITHIYANATHAN, P and SUBRAMANIAN, V and DAS, BK},
Title = {GEOCHEMISTRY OF THE CAUVERY ESTUARY, EAST-COAST OF INDIA},
Journal = {ESTUARIES},
