@inproceedings{ WOS:000248513500162,
Author = {Murray, Teresa A.},
Book-Group-Author = {IEEE},
Title = {Model of long-range transmission of gamma oscillation},
Booktitle = {2007 3RD INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING, VOLS
   1 AND 2},
Year = {2007},
Pages = {654-657},
Note = {3rd International IEEE/EMBS Conference on Neural Engineering, Kohala
   Coast, HI, MAY 02-05, 2007},
Organization = {IEEE; EMBS},
Abstract = {Dynamic oscillations of local extracellular field potentials between 30
   to 100 Hz have been associated with sensory perception, motor task
   planning, selective attention and working memory in cortical regions of
   the mammalian brain {[}1], {[}2]. They have also been observed in the
   hippocampus. However, the degree of correlation with these tasks, as
   well as their cellular and network mechanisms is still the subject of
   study and debate. This is especially true with regard to rhythms
   observed in the hippocampus, which have been difficult to directly
   correlate with behavior {[}1]. A minimal mathematical model was
   developed for a preliminary study of long-range neural transmission of
   gamma oscillation from the CA3 to the entorhinal cortex via the CA1
   region of the hippocampus, a subset within a larger complex set of
   pathways. A module was created for each local population of neurons with
   common intrinsic properties and connectivity to simplify the connection
   process and make the model more flexible. Three modules were created
   using MATLAB Simulink(R) and tested to confirm that they transmit gamma
   through the system. The model also revealed that a portion of the signal
   from CA1 to the entorhinal cortex may be lost in transmission under
   certain conditions.},
