@article{ WOS:000074775300013,
Author = {{[}Anonymous]},
Title = {Issues and controversies in pharmacoeconomics},
Journal = {AMERICAN JOURNAL OF MANAGED CARE},
Year = {1998},
Volume = {4},
Number = {4, 1},
Pages = {S216-S220},
Month = {APR},
Note = {Conference on Pharmacoeconomics and Outcomes Issues of Lipid Therapy,
   ORLANDO, FL, NOV 05-07, 1997},
Organization = {Int Soc Pharmacoecon \& Outcomes Res},
Abstract = {As an evolving field, pharmacoeconomics has many methodologic issues and
   controversies. Appropriate methods must be developed for tracking
   illnesses that account for indirect and direct costs. Patient compliance
   must be improved before pharmacoeconomics studies on lipid-lowering
   therapies can be valuable. Results of a study in two American health
   maintenance organizations showed a discontinuation rate of 15\% to 46\%,
   as opposed to 4\% to 15\% in clinical trials.(1) Subsequent studies have
   shown similarly high rates. Compliance-enhancing programs should go
   beyond patient education and use a healthcare team approach to reinforce
   behavior and monitor outcomes,
   Direct comparisons of the statins are necessary in order to determine
   which agents to use. External validity of pharmacoeconomics trials in
   the real world must be improved. The early studies lack validity because
   they relied on observational data and models and separate epidemiologic
   and economic data. The new generation of studies includes economic
   endpoints, but improvements are needed in projecting outcomes beyond the
   trial period and into different practice environments. The results of
   economic models must be properly presented in order to alter the
   perception of many healthcare decision makers that pharmacoeconomics is
   marketing fluff. Making models available to users and replacing
   univariate sensitivity analysis with multivariate sensitivity analysis
   will provide relevant answers.},
