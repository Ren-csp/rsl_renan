@inproceedings{ WOS:000288183400071,
Author = {Zhang, Tongtong},
Editor = {Jiang, Y and Zou, YL and Zhang, JG and Chen, JQ},
Title = {The Relationship between Physical Self-Esteem and Parenting Style of
   College Students},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 1},
Year = {2010},
Pages = {316-319},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {In order to find out the relationship between physical self-esteem and
   parenting style of college students, 301 subjects aging(19.2 +/-
   2.3)years old were randomly enrolled from four colleges in Jinan and
   Zibo City, 158 boys and 143 girls. Testing them in EMBU and PSPP, the
   testing results were analyzed by correlation and multiple stepwise
   regression. The results indicated: (1) Parenting style influences
   physical self-esteem of college students significantly. Among all
   factors, warmth and understanding of parents, father excessive
   protection, mother rejection and negative correlate with physical
   self-esteem significantly. In addition, rejection and negative of father
   correlate with sport technology significantly, punishment and firm
   control of parents correlate with physical condition and physical
   attraction significantly, and excessive interference of father correlate
   with physical fitness significantly. (2) Parenting style can predict the
   level of physical self-esteem of college students. The results of
   multiple stepwise regression indicate that warmth and understanding of
   father and punishment and firm control of mother can predict physical
   self-perception; warmth and understanding of father and excessive
   protection of father can predict sport technology; warmth and
   understanding of mother and punishment and firm control of mother can
   predict physical condition; warmth and understanding of father,
   rejection and negative of mother and punishment and firm control can
   predict physical attraction; excessive protection and excessive
   interference of father can predict physical fitness.},
