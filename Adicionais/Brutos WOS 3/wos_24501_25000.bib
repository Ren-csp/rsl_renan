@article{ WOS:000238859400021,
Author = {Zhang, Xiaoling and Wang, Zhiying and Zhao, Qing},
Title = {Biological phosphorus removal with nitrite as election acceptor},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
