@inproceedings{ WOS:000234081200073,
Author = {Webber, L and Smith, K},
Editor = {Costa, G and Goedhard, WJA and Ilmarinen, J},
Title = {The value of work in younger and older adults' lives: An Australian
   perspective},
Booktitle = {Assessment and Promotion of Work Ability, Health and Well-being of
   Ageing Workers},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2005},
Volume = {1280},
