Title = {STUDENTS' MULTICULTURAL TOLERANCE CORRELATES: STUDY GROUP MOSAICITY AND
   DEVELOPMENTAL LEVEL},
Booktitle = {PROFESSIONAL CULTURE OF THE SPECIALIST OF THE FUTURE \& COMMUNICATIVE
   STRATEGIES OF INFORMATION SOCIETY},
