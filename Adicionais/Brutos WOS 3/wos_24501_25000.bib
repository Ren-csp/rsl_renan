Organization = {INT GEOG UNION},
Abstract = {This paper describes a framework for the handling of taxonomic
   variables, like soils and natural vegetation, in geographical
   information systems (GIS). Relationships between attribute
   classification and spatial resolution are discussed with detailed
   reference to botanical and soil sampling and mapping, where pointwise
   attribute classification is projected into one-dimensional or
   two-dimensional space. According to the cartographic uncertainty
   relationship, it is concluded that a ``best{''} spatial resolution will
   be context-dependent.},
