@article{ WOS:000306715200037,
Author = {Oliveira, Mafalda Rangel and Pita, Cristina and Santos Goncalves, Jorge
   Manuel and Leite, Laura and Costa, Carlos and Erzini, Karim},
Title = {Ecotourism Snorkelling Routes at Marinha Beach (Algarve)},
Journal = {JOURNAL OF COASTAL RESEARCH},
