@article{ WOS:A1991GD16100012,
Author = {GROSSMAN, DC and MILLIGAN, BC and DEYO, RA},
Title = {RISK-FACTORS FOR SUICIDE ATTEMPTS AMONG NAVAJO ADOLESCENTS},
Journal = {AMERICAN JOURNAL OF PUBLIC HEALTH},
