@inproceedings{ WOS:001007152800002,
Author = {Listarhov (Lixandru), A. and Catalina, T.},
Book-Group-Author = {IOP},
Title = {Experimental analysis of energy production of a hybrid
   thermal-photovoltaic solar panel enhanced with phase-change material},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2023},
Volume = {1185},
Note = {8th Conference of the Sustainable-Solutions-for-Energy-and-Environment
   (EENVIRO), Bucharest, ROMANIA, OCT 16-21, 2022},
Organization = {Constructii Erbasu SA; Romstal; Dantec Dynam; MetrOptics; European Univ
   Smart Urban Coastal Sustainabil; Tech Univ Civil Engn Bucharest, Fac
   Civil, Ind \& Agr Construct; Sustainable Solut Energy \& Environm},
Abstract = {The paper presents the difference between 2 photovoltaic thermal panels
   (PV/T), panels with the same initial characteristics. During the
   experiment, in PV/T panel no. 1 we introduce 14 kg of RT 35 phase change
   material, material with a liquid density at 45 degrees C of 0.77 kg/l.
   According to the technical sheet of the panel, PV/T volume no. 1 was
   occupied 50\% with PCM RT 35. Panel no. 2 is a normal PV/T. Following
   measurements made with the data recorder BTM-4208 SD, a difference of 6
   degrees C results on the faces of the panels. The energy production for
   PV/T no. 1 with PCM RT35 is 10.046 kWh compared to PV/T panel no. 2
   where the energy production is 8.443 kWh. Conclusion: the efficiency of
   the PV/T panel no. 1 with PCM RT 35 is better by 15.20\% compared to
   panel no. 2 PV/T.},
Publisher = {IOP PUBLISHING LTD},
Address = {DIRAC HOUSE, TEMPLE BACK, BRISTOL BS1 6BE, ENGLAND},
