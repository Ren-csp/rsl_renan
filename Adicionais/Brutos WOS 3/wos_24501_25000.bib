Title = {A Computational Model for Characterizing Visual Information Using Both
   Spikes and Local Field Potentials},
Booktitle = {2017 8TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
