@inproceedings{ WOS:000769071200019,
Author = {Nahiduzzaman, Md and Tasnim, Moumitu and Newaz, Nishat Tasnim and
   Kaiser, M. Shamim and Mahmud, Mufti},
Editor = {Mahmud, M and Vassanelli, S and Kaiser, MS and Zhong, N},
Title = {Machine Learning Based Early Fall Detection for Elderly People with
   Neurological Disorder Using Multimodal Data Fusion},
