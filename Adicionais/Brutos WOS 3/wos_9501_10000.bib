Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {The increasing number of entrepreneurs has set a trend of independent
   employment among millennial in Malaysia. Despite of such increasing
   trends, there are entrepreneurs who are not able to sustain in the
   highly demanding business environment. It is crucial for entrepreneurs
   to possess various competencies as their core capabilities. Various
   literatures emphasizes on the importance of social competency towards a
   successful entrepreneurial creation. This paper examines the roles of
   relational social capital towards the social competency among millennial
   entrepreneurs. Elements within the social competency are social
   perception, social adaptability and expressiveness dependent variables
   and relational social capital as the independent variable. The
   respondents from this study consist of millennial entrepreneurs.
   Interestingly, findings from this study had proved that relational
   social capital is positively related to social adaptability, social
   perception and expressiveness.},
