Title = {The Emotional Spectrum of LLMs: Leveraging Empathy and Emotion-Based
   Markers for Mental Health Support},
Booktitle = {PROCEEDINGS OF THE 10TH WORKSHOP ON COMPUTATIONAL LINGUISTICS AND
   CLINICAL PSYCHOLOGY, CLPSYCH 2025},
Year = {2025},
