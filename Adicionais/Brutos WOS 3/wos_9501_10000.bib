Title = {The historical monument as an integral part of urban surroundings:
   Sustainable redevelopment around El Hogar del Comandante Aguado (Teruel)},
Booktitle = {HERITAGE 2010: HERITAGE AND SUSTAINABLE DEVELOPMENT, VOLS 1 AND 2},
Year = {2010},
Pages = {1005-1014},
Note = {2nd International Conference on Heritage and Sustainable Development,
   Evora, PORTUGAL, JUN 22-26, 2010},
Organization = {Turismo Portugal; Full-Service Co; Viagens Abreu},
Abstract = {When referring to historical heritage, be it a cultural landscape, a
   city, a building or a work of art, sustainability means ``assuring the
   continuous contribution of the Heritage to the present, through a
   careful management of the changes sensitive to the historic
   environment{''}. We understand that heritage of cultural interest,
   independent of its type, possesses an intrinsic value in reference to
   its architectural, artistic, and historical characteristics.Centering
   our study on historical buildings and, specifically, on the ``Hogar del
   Comandante Aguado{''} in Teruel, Spain, it is clear that the
   aforementioned characteristics related to the building, along with its
   spatial value, constructive solutions and singular and conjunctive
   elements are important in understanding the whole.We must consider a
   study of the environment in which the building is located and how its
   presence affects the well-being of the surrounding society. A
   degradation of the building will directly affect everything around it -
   the planning as well as the population.},
