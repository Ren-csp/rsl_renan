@inproceedings{ WOS:000189414500009,
Author = {Bray, C},
Book-Group-Author = {HRC},
Title = {Commemorating ``the peace that has long endured{''}: Conservation of
   Lundy's Lane battlefield, Niagara Falls, Ontario},
Booktitle = {BORDERLANDS: THE SHARED CANADIAN AND U.S. EXPERIENCE OF LANDSCAPE},
Year = {2002},
Pages = {89-102},
Note = {Alliance-for-Historic-Landscape-Preservation Annual Meeting, Niagara on
   the Lake, CANADA, JUN 02-05, 1999},
Organization = {Alliance Histor Landscape Preservat},
Abstract = {The Battle of Lundy's Lane, fought on the afternoon and evening of July
   25, 1814, was one of the crucial battles of the War of 1812. Since the
   end of the war, the site has been commemorated in a variety of ways.
   Urban development has changed the cultural landscape beyond recognition,
   save for the Drummond Hill Cemetery, epicentre of the battle and for
   many years the lone remaining public property in which to place
   commemorative memorials. The battlefield has been conserved principally
   by local residents rather than by government agencies, and has been
   interpreted more often by private entrepreneurs than by any of the
   public heritage ministries. The Lundy's Lane Battlefield Master Plan is
   the result of many years of effort by local people to commemorate this
   site, culminating in the donation of property by one individual, on the
   understanding that the entire remaining four hectare {[}10 acre] site
   would be conserved as a `national heritage park'. The Master Plan
   provides recommendations and guidelines for conservation, development
   and implementation, to ensure a stable future for this historic site.},
Publisher = {HERITAGE RESOURCES CENTRE FACULTY ENVIRONMENTAL STUDIES},
