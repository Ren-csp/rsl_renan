Title = {Participatory Study to Explore Healthcare Professionals' Perceptions of
   a Connected Digital Solution for Adherence Monitoring of Recombinant
   Human Growth Hormone Treatment: Study Protocol and First Findings},
Booktitle = {CARING IS SHARING-EXPLOITING THE VALUE IN DATA FOR HEALTH AND
   INNOVATION-PROCEEDINGS OF MIE 2023},
