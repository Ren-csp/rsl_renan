@article{ WOS:000261413600003,
Author = {Pitt, Mark A. and Myung, Jay I. and Montenegro, Maximiliano and Pooley,
   James},
Title = {Measuring Model Flexibility With Parameter Space Partitioning: An
   Introduction and Application Example},
Journal = {COGNITIVE SCIENCE},
Year = {2008},
Volume = {32},
Number = {8},
Pages = {1285-1303},
Note = {39th Annual Meeting of the Society-for-Mathematical-Psychology,
   Vancouver, CANADA, JUL 30-AUG 01, 2006-2007},
Organization = {Soc Math Psychol},
Abstract = {A primary criterion on which models of cognition are evaluated is their
   ability to fit empirical data. To understand the reason why a model
   yields a good or poor fit, it is necessary to determine the data-fitting
   potential (i.e., flexibility) of the model. In the first part of this
   article, methods for comparing models and studying their flexibility are
   reviewed, with a focus on parameter space partitioning (PSP), a
   general-purpose method for analyzing and comparing all classes of
   cognitive models. PSP is then demonstrated in the second part of the
   article in which two connectionist models of speech perception (TRACE
   and ARTphone) are compared to learn how design differences affect model
   flexibility.},
