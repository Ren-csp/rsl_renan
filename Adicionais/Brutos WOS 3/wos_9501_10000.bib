Title = {Retrieving aerosol optical thickness from a MODIS dataset for the Lisbon
   Metropolitan Area using a contrast reduction method},
Booktitle = {GLOBAL DEVELOPMENTS IN ENVIRONMENTAL EARTH OBSERVATION FROM SPACE},
Year = {2006},
Pages = {113-122},
Note = {25th Symposium of the
   European-Association-of-Remote-Sensing-Laboratories (EARSeL), Univ
   Porto, Oporto, PORTUGAL, JUN 06-11, 2005},
Abstract = {The integration of remote sensing instruments in air quality monitoring
   systems at an urban and regional scale is a valid methodology with
   significant improvements regarding spatial distribution. Air pollution
   satellite data can be integrated in monitoring systems to complement
   ground data and improve comprehension on local and regional dispersion
   patterns. This work will focus in Aerosol Optical Thickness (AOT)
   satellite retrieval since aerosols are generally a good air quality
   indicator using a contrast reduction method to estimate this parameter.
   Preliminary results showed a correlation of 0.86 between the
   satellite-derived AOT and ground station measurements, although the
   quality of that correlation was dependent on the conditions of the
   selected parameters. The correlation improved if the reference and
   polluted image had an average relative humidity below a threshold near
   80\% and the reflectance outliers of the reference and polluted images
   were removed. Future work will provide a set of primary conclusions on
   the possibilities of integrating satellites on urban monitoring systems
   by establishing the pre-operational capabilities of satellite aerosol
   retrievals at this scale.},
