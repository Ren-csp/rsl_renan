@inproceedings{ WOS:000181346400020,
Author = {Crowther, JM and Hassan, AGAA},
Editor = {Sokhi, RS and Bartzis, JG},
Title = {Three-dimensional numerical simulation of air pollutant dispersion in
   street canyons},
Booktitle = {URBAN AIR QUALITY - RECENT ADVANCES, PROCEEDINGS},
Year = {2002},
Pages = {279-295},
Note = {3rd International Conference on Urban Air Quality - Measurement,
   Modeling and Management, LOUTRAKI, GREECE, MAR 20-23, 2001},
Organization = {Inst Phys; NCSRD; Univ Hertfordshire; SATURN; TRAPOS; COST715},
Abstract = {The PHOENICS Computational Fluid Dynamics (CFD) software package has
   been used with a standard k-epsilon turbulence model to simulate the
   three-dimensional dispersion of air pollutants in an urban street
   canyon. In all cases, a vortex was formed within the street canyon,
   characterized by updrafts near the upwind buildings and down-drafts near
   the downwind buildings. Contours of pollutant concentrations over a
   transverse vertical plane at mid-canyon show pollutants circulating
   within the vortex, with higher concentrations at the leeward face than
   at the windward faces, and higher concentrations above downwind
   buildings than above upwind buildings. Longitudinal distributions of
   pollutant concentrations at leeward and windward faces are characterized
   by higher concentrations at mid-block and lower concentrations at the
   ends. These results agree qualitatively with previous wind tunnel
   findings such as those of Hoydysh and Dabberdt (1988) and Wedding et al.
   (1977). The results also suggest that the k-epsilon turbulence model is
   satisfactory for simulating the effect of turbulence on dispersion of
   pollutants in street canyons.},
