   Hiroshima Univ, Fac Integrated Arts \& Sci, Higashihiroshima 7398521, Japan.},
DOI = {10.1016/j.ics.2004.04.093},
ISSN = {0531-5131},
ISBN = {0-444-51655-7},
Keywords = {event-related potential; voluntary action; P3; methodology},
