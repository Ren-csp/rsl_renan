Title = {Green Infrastructure Concept for JABODETABEKJUR Metropolitan Area},
Booktitle = {CITIES 2016 INTERNATIONAL CONFERENCE: COASTAL PLANNING FOR SUSTAINABLE
   MARITIME DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
