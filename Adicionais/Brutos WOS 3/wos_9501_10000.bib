@article{ WOS:A1992HR70900036,
Author = {KAWAMURA, G and NAKAIZUMI, H and MOTOHIRO, T},
Title = {CHEMICAL PERCEPTION AND RESPONSE OF THE NILE TILAPIA TO GEOSMIN},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1992},
Volume = {25},
Number = {2},
Pages = {277-282},
Note = {3RD INTERNATIONAL SYMP ON OFF-FLAVOURS IN DRINKING WATER AND AQUATIC
   ORGANISMS, LOS ANGELES, CA, MAR 03-08, 1991},
Organization = {INT ASSOC WATER POLLUT RES \& CONTROL; INT ASSOC THEORET \& APPL LIMNOL;
   AMER WATER WORKS ASSOC; ASSOC METROPOLITAN WATER AGENCIES; AMER SOC
   CIVIL ENGINEERS; AMER CHEM SOC; INT OZONE ASSOC; ASOC INTERAMER
   INGENIERIA SANITARIA \& AMBIENTAL; N AMER LAKE MANAGEMENT SOC; AMER
   FISHERIES SOC},
Abstract = {Chemical sensitivity of the Nile tilapia Tilapia nilotica to geosmin was
   examined by the cardiac method.  The fish showed cardiac deceleration in
   response to geosmin of various concentrations.  The threshold of
   detection was found to be as low as 0.005 ng/l, which was lower than in
   humans by 3 orders of magnitude.  Fish whose olfactory rosettes were
   removed also showed the cardiac response to geosmin, but the threshold
   increased by 2 orders of magnitude.  This indicates that the olfactory
   organ can detect geosmin at very low concentrations, but that other
   chemoreceptors (taste buds and free neuromasts) are also important. 
   When geosmin at concentrations of 0.04 to 40,000 ng/l was introduced
   into tanks, free swimming fish did not appear repelled nor attracted.},
