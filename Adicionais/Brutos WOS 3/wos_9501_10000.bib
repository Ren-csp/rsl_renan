Title = {Similarity and Repetition An ERP Study on Musical Form Perception},
Booktitle = {NEUROSCIENCES AND MUSIC III: DISORDERS AND PLASTICITY},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2009},
Volume = {1169},
Pages = {485-489},
Note = {Conference on the Neurosciences and Music III, McGill Univ, Montreal,
   CANADA, JUN 25-28, 2008},
Abstract = {In this ERP study we investigate how consecutive phrase patterns in the
   musical form types AABB and ABAB are conjoined perceptually. An anterior
   N300 reflects recognition of motif similarity in adjacent (A-A) and
   nonadjacent (A-B-A) phrase patterns, indicating perceptual coherence
   between (similar) parts in linear order. A marginally significant late
   anterior negativity reflects the processing of the second B in ABAB. It
   probably reveals some global aspects of ``structural integration{''}
   when nonadjacent parts are perceived in the context of the whole melody.},
