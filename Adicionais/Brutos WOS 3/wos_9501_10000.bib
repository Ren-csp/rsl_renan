Title = {The Correlation of Self-Construal, Self-Efficacy, and Emotional
   Regulation Strategy as Cultural Factors with Social Anxiety: Preliminary
   Study},
Booktitle = {PROCEEDINGS OF THE 3RD ASEAN CONFERENCE ON PSYCHOLOGY, COUNSELLING, AND
   HUMANITIES (ACPCH 2017)},
