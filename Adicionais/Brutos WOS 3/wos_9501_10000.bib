@inproceedings{ WOS:000172010200017,
Author = {Kagan, J},
Editor = {Damasio, AR and Harrington, A and Kagan, J and McEwen, BS and Moss, H and Shaikh, R},
Title = {Biological constraint, cultural variety, and psychological structures},
Booktitle = {UNITY OF KNOWLEDGE: THE CONVERGENCE OF NATURAL AND HUMAN SCIENCE},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2001},
Volume = {935},
