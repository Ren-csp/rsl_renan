Pages = {622-631},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {This paper describes the use of a genetic algorithm to optimize the land
   use and street upgrade plan for a city in Utah for expected growth over
   the next twenty years. A MINUTP model is used to predict total travel
   time of all daily trips throughout the city. Total travel time is
   minimized along with per capita cost and change from the status quo.
   Constraints are imposed to insure adequate housing, schools, parks, and
   public facilities as well as a balanced budget. Since there are multiple
   objectives, the genetic algorithm is used to generate a pareto-optimum
   set.},
