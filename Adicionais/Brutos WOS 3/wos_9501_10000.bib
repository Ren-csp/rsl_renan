@inproceedings{ WOS:000176847700005,
Author = {Ghinea, G and Thomas, JP},
Editor = {Harris, D},
Title = {Using an adaptable communication protocol for enhanced quality of
   perception},
Booktitle = {ENGINEERING PSYCHOLOGY AND COGNITIVE ERGONOMICS VOLUME SIX: INDUSTRIAL
   ERGONOMICS, HCI, AND APPLIED COGNITIVE PSYCHOLOGY},
Year = {2001},
Pages = {39-44},
Note = {3rd International Conference on Engineering Psychology and Cognitive
   Ergonomics, EDINBURGH, SCOTLAND, OCT 25-27, 2000},
Abstract = {We present the case for using adaptable protocols geared towards human
   requirements in the delivery of distributed multimedia. We have
   implemented a proof-of-concept application - a distributed MPEG player -
   through which multimedia clips can be transmitted over computer networks
   using the Reading Adaptable Protocol (RAP). RAP is a protocol expressly
   configured for improved user perceptual delivery. Based on initial
   experiments comparing the performance of RAP from a perceptual point of
   view with that obtained under two legacy (and widely used) communication
   protocol stacks, TCP/IP and UDP/IP, one can conclude that, even allowing
   for the extra overheads in protocol reconfiguration, there is
   considerable scope for including user perceptual considerations in
   communication systems.},
