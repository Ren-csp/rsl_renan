@inproceedings{ WOS:000878133000005,
Author = {Wadhera, Tanu and Mahmud, Mufti},
Editor = {Mahmud, M and He, J and Vassanelli, S and VanZundert, A and Zhong, N},
Title = {Influences of Social Learning in Individual Perception and Decision
   Making in People with Autism: A Computational Approach},
