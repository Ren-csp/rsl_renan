@inproceedings{ WOS:000230926200024,
Author = {Dilworth, G and Shafer, S},
Editor = {Bricker, K and Millington, SJ},
Title = {Visitor perceptions of intelligent transportation systems in a National
   Park},
Booktitle = {PROCEEDINGS OF THE 2004 NORTHEASTERN RECREATION RESEARCH SYMPOSIUM},
Series = {USDA FOREST SERVICE GENERAL TECHNICAL REPORT NORTHEASTERN FOREST
   EXPERIMENTAL STATION},
Year = {2004},
Volume = {326},
Pages = {158-163},
Note = {Northeastern Recreation Research Symposium, Bolton Landing, NY, MAR
   28-30, 2004},
Organization = {Adirondack Mt; Club Venture Publ; USDA Forest Serv, NE Res Stn},
Abstract = {Congestion in national parks is an issue of concern for both visitors
   and managers. Increased visitation has resulted in a need to plan and
   manage for a balance between the visitor experience and resource
   protection. Understanding access issues, in particular as a way to ease
   congestion, improve the quality of the visitor experience, and maintain
   the integrity of the resource is integral to this process.
   In 1991 Congress created the Intelligent Transportation Systems (ITS)
   program to address the needs of the transportation network in the United
   States. ITS solutions include technologies such as electronic toll
   collection and electronic message signs.
   This study examined visitor attitudes toward and intent to use ITS in
   two of the national park units in California. The findings suggest a
   positive relationship exists between attitude and intention in regard to
   ITS tools in national parks, and between technology experience and
   intent to use technology at the study parks.},
Publisher = {US DEPT AGR, FOREST SERV NE EXPTL STN},
