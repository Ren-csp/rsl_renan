@article{ WOS:000258309600011,
Author = {Quiles, M. Nieves and Morera, M. Dolores and Correa, Ana D. and Navas,
   Marisol and Gomez-Berrocal, Carmen and Cuadrado, Isabel},
Title = {Prejudice towards women:: Infrahumanization or undervaluation?},
Journal = {REVISTA DE PSICOLOGIA SOCIAL},
Year = {2008},
