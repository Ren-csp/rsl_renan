@inproceedings{ WOS:000173641300036,
Author = {Al-Akhras, A and Kalra, T},
Editor = {Easa, S and Samdahl, D},
Title = {Effect of ridesharing on environment, economics, and congestion in
   central Ohio},
Booktitle = {TRANSPORTATION, LAND USE, AND AIR QUALITY, CONFERENCE PROCEEDINGS:
   MAKING THE CONNECTION},
Year = {1998},
Pages = {337-345},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {The Commuter Assistance Program (CAP) off the Mid-Ohio Regional Planning
   Commission (MORPC) is a publicly funded program charged with encouraging
   ridesharing (carpooling, vanpooling and public transit) in the central
   Ohio area. CAP is committed to the national objectives of energy
   conservation., improved air quality, reduced highway maintenance,
   reduced traffic congestion and lowing commuting expenses by offering its
   programs and services at no cost to central Ohio employers and
   commuters.
   This paper addresses the effectiveness of ridesharing programs. MORPC's
   rideshare program, CAP, was analyzed. The methodology of performing the
   analysis is described. Benefits are divided into two categories, direct
   and indirect benefits. The benefits are estimated based on the amount of
   vehicle-miles and vehicle-trips reduced as a result of ridesharing
   arrangements formed through the program. Direct benefits are those
   directly affecting users of the service in terms of monetary savings.
   Indirect benefits are assessed in terms of reducing the amounts of
   mobile emissions. Results of the analysis demonstrate that ridesharing
   is a low cost approach to solving transportation congestion with a
   relatively high return on investment.},
