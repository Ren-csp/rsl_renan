@article{ WOS:A1994NR21500027,
Author = {TRIER, A and FIRINGUETTI, L},
Title = {A TIME-SERIES INVESTIGATION OF VISIBILITY IN AN URBAN ATMOSPHERE .1.},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1994},
Volume = {28},
Number = {5},
Pages = {991-996},
Month = {MAR},
Note = {Conference on Visibility and Fine Particles, VIENNA, AUSTRIA, SEP 15-18,
   1992},
Abstract = {Visual range as determined at an airport situated within city limits in
   Santiago, Chile, is correlated over a period of 3 years with PM-10 mass
   concentrations measured at an automatic monitoring station. Both
   variables present strong seasonal variations. Linear regression models
   are estimated to describe the correlation. A time series analysis is
   performed of visual range over a period of more than 15 years;
   periodicities of seven days and one year are found in the power
   spectrum. ARIMA models and Transfer Function-Noise models using wind
   speed as an input are estimated for the series. Short-term forecasts are
   obtained for visual range. The results are encouraging and warrant
   continued efforts to produce a multiple time series forecasting model.},
