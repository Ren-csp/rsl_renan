Title = {Impact of Changed Rainfall Patterns Due to Climate Change and Usage of
   Available Weather Information by Communities Who Face Human Elephant
   Conflict (HEC) in Udawalawe, Sri Lanka},
Booktitle = {CONFERENCE PROCEEDINGS OF THE INTERNATIONAL CONFERENCE ON CLIMATE CHANGE
   - 2017 (ICCC 2017)},
