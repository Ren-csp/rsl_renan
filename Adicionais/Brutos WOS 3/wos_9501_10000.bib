Organization = {WIT Transact Ecol \& Environm},
Abstract = {This paper proposes that our responses to the environment are influenced
   in part by our contemporary culture and in part by the genetic
   background of our primitive survival. Evidence of primitive responses is
   cited from the fields of thermal comfort, and visual comfort. Strong
