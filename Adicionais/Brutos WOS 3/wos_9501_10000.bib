@article{ WOS:000177225000006,
Author = {Austerlitz, N and Aravot, I and Ben-Ze'ev, A},
Title = {Emotional phenomena and the student-instructor relationships},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2002},
Volume = {60},
Number = {2},
