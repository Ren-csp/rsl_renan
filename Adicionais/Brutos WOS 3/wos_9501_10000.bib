@inproceedings{ WOS:000227683000049,
Author = {MacDonald, L and Sohn, G and Papsin, BC and Gordon, KA},
Editor = {Miyamoto, RT},
Title = {Use of a Graded Profile Analysis to assess cochlear implant candidacy:
   recent findings},
Booktitle = {COCHLEAR IMPLANTS},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2004},
Volume = {1273},
Pages = {215-218},
Note = {8th International Cochlear Implant Conference, Indianapolis, IN, MAY
   10-13, 2004},
Organization = {NIDCD; Psi Iota Xi; Indiana Lions; St Joseph Inst Deaf; Indiana Univ
   Cochlear Implant Team},
Abstract = {At the Hospital for Sick Children, a Graded Profile Analysis (GPA) is
   used to quantify candidacy evaluations and steer decisions regarding
   candidacy for cochlear implantation. Over the first 4 years of use, the
   GPA score was reported to influence the decision to implant and
   correlate with speech perception outcomes. With the evolution of
   candidacy criteria, the usefulness of the GPA required reexamination.
   The GPA was completed on the basis of a multidisciplinary evaluation of
   cochlear implant candidacy in 172 children assessed over 2 years. GPA
   scores were analyzed with respect to the decision to implant and
   behavioural speech perception outcomes in these children. The GPA score
   was significantly higher for children who were provided with implants
   compared to those who were not. In addition, higher GPA scores were
   associated with higher scores on postimplant speech perception tests and
   lower ages at implantation. The GPA provides an objective measure for
   candidacy evaluation, reflects changes in candidacy criteria, and
   provides a prediction of potential speech perception outcomes after
   implantation. The GPA could be helpful in counselling children/parents
   prior to implantation. (c) 2004 Elsevier B.V. All rights reserved.},
