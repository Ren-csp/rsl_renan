Title = {An Analysis of the Carbon Fixation Change according to the Greenbelt
   Deregulation Using InVEST Model -In Case of Anyang and Gwacheon City-},
Booktitle = {8TH INTERNATIONAL CONFERENCE ON ENVIRONMENT SCIENCE AND ENGINEERING
   (ICESE 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
