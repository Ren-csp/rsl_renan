@article{ WOS:000085653500005,
Author = {Grant, AC and Thiagarajah, MC and Sathian, K},
Title = {Tactile perception in blind Braille readers: A psychophysical study of
   acuity and hyperacuity using gratings and dot patterns},
Journal = {PERCEPTION \& PSYCHOPHYSICS},
Year = {2000},
Volume = {62},
Number = {2},
Pages = {301-312},
Month = {FEB},
Note = {27th Annual Meeting of the Society-of-Neuroscience, NEW ORLEANS,
   LOUISIANA, OCT 25-30, 1997},
Organization = {Soc Neurosci},
Abstract = {It is not clear whether the blind are generally superior to the sighted
   on measures of tactile sensitivity or whether they excel only on certain
   tests owing to the specifics of their tactile experience. We compared
   the discrimination performance of blind Braille readers and age-matched
   sighted subjects on three tactile tasks using precisely specified
   stimuli. Initially, the blind significantly outperformed the sighted at
   a hyperacuity task using Braille-like dot patterns, although, with
   practice, both groups performed equally well. On two other tasks,
   hyperacute discrimination of gratings that differed in ridge width and
   spatial-acuity-dependent discrimination of grating orientation, the
   performance of the blind did not differ significantly from that of
   sighted subjects. These results probably reflect the specificity of
   perceptual learning due to Braille-reading experience.},
