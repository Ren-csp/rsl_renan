
@inproceedings{ WOS:000179444800131,
Author = {Sisoulath, B and Vangkeomany, S},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Spontaneous settlement in Vientiane Municipality},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1059-1066},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {This paper is concerned with spontaneous settlement that has been
   developed in Vientiane Municipality in the last two decades as a result
   of rapid population growth. The aim is to provide an insight into the
   factors contributing to spontaneous formation in the city and to give a
   better understanding about how the problem can be addressed in an
   effective way. Because of the significantly high tendency of spontaneous
   settlement to turn the city into an undesirable physical and social
   environment, giving an appropriate solution to this problem will be of
   great interest for both the government and the community. Specifically,
   it will improve the living conditions of the urban poor who always
   struggle in finding adequate housing which is suitably located and
   provided with basic infrastructure and services.
   Acknowledging the implication of spontaneous settlement to the city, the
   paper has an objective to assist the city administration with policy
   guidelines for implementation as a measure to halt and to prevent a
   further deterioration of that environment. In doing so, it explores the
   urban governance system and legal framework currently undertaken in the
   country in order to answer the question of whether current governance is
   capable to cope with this pattern of urban sprawl and if not how this
   could be improved. The paper also focuses on other issues such as
   housing supplies in the informal sector, the private housing market and
   public housing and infrastructure provision as it is commonly applied in
   slum upgrading projects. In this regard, examples and conclusions from
   case studies and slum improvement projects around the world are used for
   comparison.
   The paper begins with an overview of the issues associated with
   spontaneous settlement, emphasis is placed on general patterns of
   settlement, urban and land regulations, and opinions and suggestions are
   made to solve the urban problems in Vientiane. Later sections provide
   the experiences of slum upgrading in Indonesia, the Philippines and
   major conclusions on slum upgrading. Comparing examples from other
   countries, the next parts of the paper looks at the urban governance
   system, urban and land regulations, housing supplies with a focus on
   financial mobilisation and infrastructure provision. The conclusion
   section is a summary of the issues to which the solutions need to be
   addressed.},
