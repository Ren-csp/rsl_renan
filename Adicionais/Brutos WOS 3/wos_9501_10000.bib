@inproceedings{ WOS:000257930800018,
Author = {Loures, L. and Heuer, T. and Horta, D. and Silva, S. and Santos, R.},
Editor = {Panagopoulos, T and Burley, JB},
Title = {Reinventing the post-industrial landscape: A multifunctional cluster
   approach as redevelopment strategy},
Booktitle = {PROCEEDINGS OF THE 1ST WSEAS INTERNATIONAL CONFERENCE ON LANDSCAPE
   ARCHITECTURE (LA `08): NEW ASPECTS OF LANDSCAPE ARCHITECTURE},
Series = {Energy and Environmental Engineering Series},
Year = {2008},
Pages = {123-129},
Note = {1st WSEAS International Conference on Landscape Architecture (LA 2008),
   Univ Algarve, Algarve, PORTUGAL, JUN 11-13, 2008},
Organization = {Taylors Port; Centro Ciencia Vivo Algarve; Centro Invest Espaco
   Organizacoes; Fundacao Calouste Gulbenkian; Espaco Aberto; Delta;
   Alportel; FCT},
Abstract = {The effects of the globalization of industry over the past decades has
   had a profound effect on traditional industrial areas all over the
   world, producing a vast array of obsolete industrial facilities and the
   various impacts which are generated from them. The formal products of
   the moderist movement have become obsolete, forcing this generation to
   decide on the disposition of the last generation's industrial
   environment. Furthermore, these post-industrial landscapes are often in
   advantageous locations near city centers, situated along waterways,
   supported by existing infrastructure, and adjacent to residential
   communities, and they constitute, several times, a relevant reference to
   people's identity. They constitute environmentally impaired assets that
   need to be returned to productive use, and reintegrated into the
   surrounding community. To demonstrate the relevance of the reclamation
   of these sites not only for environmental but also for social and
   economic aspects, this paper will present and analyze two industrial
   reclamation studies. One located in Cleveland, United States of America,
   (West 3rd Street Peninsula) and the other in Lagoa, Portugal
   (post-industrial landscape of the left margin to the Arade River), both
   presenting a vast potential for redevelopment. The main objective of
   this article is to show that the post-industrial landscape should be
   viewed as a resource and its recovery as an opportunity to develop new
   multifunctional landscapes. Additionally the significance of those
   projects to achieve a sustainable urban landscape and the use of a
   multifunctional cluster has a gear to redevelopment is discussed.},
