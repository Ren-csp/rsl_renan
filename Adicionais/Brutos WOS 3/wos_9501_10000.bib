Title = {Assessing the Impact of Urban/Industrial Activities on Benthic
   Communities of Two Creeks of the Upper Bonny Estuary, Niger Delta Using
   Univariate and Multivariate Techniques},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND TECHNOLOGY, VOL II, PTS A AND B},
