@inproceedings{ WOS:000339337000008,
Author = {Medlock, Stephanie and Eslami, Saeid and Askari, Marjan and Brouwer,
   Henk J. and van Weert, Henk C. and de Rooij, Sophia E. and Abu-Hanna,
   Ameen},
Editor = {Blobel, B and Hasman, A and Zvarova, J},
Title = {Attitudes and Experience of Dutch General Practitioners Regarding
   Computerized Clinical Decision Support},
Booktitle = {DATA AND KNOWLEDGE FOR MEDICAL DECISION SUPPORT},
Series = {Studies in Health Technology and Informatics},
Year = {2013},
Volume = {186},
