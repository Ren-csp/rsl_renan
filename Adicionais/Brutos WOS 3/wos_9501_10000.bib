@article{ WOS:A1992HJ11700001,
Author = {MAHER, WA and AISLABIE, J},
Title = {POLYCYCLIC AROMATIC-HYDROCARBONS IN NEARSHORE MARINE-SEDIMENTS OF
   AUSTRALIA},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1992},
Volume = {112},
Number = {2-3},
Pages = {143-164},
Month = {MAR},
Note = {INTERNATIONAL CHEMICAL CONGRESS OF PACIFIC BASIN SOCIETIES, HONOLULU,
   HI, DEC, 1989},
Organization = {CHEM SOC JAPAN; CHEM INST CANADA; AMER CHEM SOC},
Abstract = {The occurrence and fate of polycyclic aromatic hydrocarbons (PAH) in
   nearshore marine sediments of Australia is discussed. Available
   information indicates that PAH are accumulating in the sediments and
   organisms of estuaries and harbours with both highly
   urbanized/industrialized and non-urban catchments. PAH levels in
   polluted sediments are similar to those of grossly polluted areas of
   Japan, North America and Europe, however PAH sources cannot be
   identified from the information available. PAH appear to persist in
   reducing environments, while in relatively pristine environments that
   have been previously exposed to PAH, conditions are probably favourable
   for the aerobic degradation of PAH by microorganisms.},
