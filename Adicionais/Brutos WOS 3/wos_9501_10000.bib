Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2021},
Volume = {632},
Note = {Asia Conference on Geological Research and Environmental Technology
   (GRET), ELECTR NETWORK, OCT 10-11, 2020},
Abstract = {Customers' evaluations, in terms of text or ratings, are important
   sources of information for online shops to decide products and marketing
   strategies. In this paper, we discuss methods to conclude and predict
   merchants' performance and characteristics of customers' behavior of
   target products based on Amazon dataset. First, we design a Natural
   Language Processing (NLP) model, Amazon-BERT, to predict text to rating
   based on transfer learning. We improve the model accuracy by 20\%
   compared to the original pre-trained BERT, and we use the predicted
   rating in our following steps of modeling. Second, we use PCA to extract
   5 principle components, which estimate review's popularity, product's
   reputation and so on. And then, for pacifier, we find that vector auto
   regression (VAR) model fits better, we apply it to the regression and
   doing a Granger causality test. Finally, we looked at the impulse
   response and variance decomposition. All 3 factors included do have a
   small impact.},
