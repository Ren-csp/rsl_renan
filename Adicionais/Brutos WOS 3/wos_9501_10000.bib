@article{ WOS:000089003700002,
Author = {Hillman, CH and Cuthbert, BN and Cauraugh, J and Schupp, HT and Bradley,
   MM and Lang, PJ},
Title = {Psychophysiological responses of sport fans},
Journal = {MOTIVATION AND EMOTION},
Year = {2000},
Volume = {24},
Number = {1},
Pages = {13-28},
Month = {MAR},
Note = {Annual Meeting of the
   North-American-Society-of-the-Psychology-of-Sport-and-Physical-Activity,
   DENVER, CO, MAY 30, 1997},
Organization = {N Amer Soc Psychol Sport \& Phys Activ},
Abstract = {The present study investigated psychophysiological differences in
   identified sport fans within the context of the biphasic theory of
   emotion (P.J. Lang, 1985). Forty participants, grouped into three levels
   of identification with the local university athletic teams, viewed Jive
   pictures from each of two categories (team-relevant sport and
   team-irrelevant sport). Self-identified sport fans rated team-relevant
   pictures as more pleasant and arousing compared to team-irrelevant
   pictures. The P3 component of the event-related potential to an
   irrelevant startle probe was diminished and heart-rate deceleration was
   enhanced during team-relevant pictures as a function of fan
   identification level, suggesting that these pictures evoked a motivated
   attentional state. Neither probe-P3 nor heart rate differed for
   team-irrelevant pictures. Lastly, increased positivity for slow cortical
   potentials was evident for team-relevant compared to beam-irrelevant
   pictures, regardless of fan identification level. These results suggest
   the utility of psychophysiological measures in the study of sport fans,
   and for other positive emotions as well.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Cuthbert, BN (Corresponding Author), NIMH, 6001 Execut Blvd,Room 6184,MSC 9625, Bethesda, MD 20892 USA.
   NIMH, Bethesda, MD 20892 USA.
   Univ Florida, Gainesville, FL 32611 USA.},
