@inproceedings{ WOS:000346067900455,
Author = {Dimitriou, G. and Papadopoulou, M. P.},
Editor = {Lekkas, TD},
Title = {MAP POLLUTION IN AN UNCONTROLLED SOLID WASTE DUMPSITE: THE IMPACTS OF A
   METRO INFRASTRUCTURE FACILITY IN THE IMPROVEMENT OF SOIL AND WATER
   RESOURCES},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
