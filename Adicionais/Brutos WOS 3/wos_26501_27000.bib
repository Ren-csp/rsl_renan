@article{ WOS:000430814700165,
Author = {Djamila, Harimi and Young, Tay Lee},
Title = {Impact of Climate on Thermal Comfort},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {2},
Pages = {1403-1406},
Month = {FEB},
Note = {International Conference on Education (ICOED), Jakarta, INDONESIA, APR
   12-14, 2016},
Abstract = {This article is about investigating the impact of climate on thermal
   comfort. The location is Melbourne city. Koppen-Geiger system was
   firstly used to identify the climate type of the location by using two
   methods. Some discrepancies were found in identifying the sub-climate of
   the location. This study also investigated the effect of monthly air
   temperatures on thermal comfort. Hourly data were collected from a case
   study to assess the effect of the hourly air temperatures on thermal
   comfort. The results predicted that when considering the monthly and
   hourly data, the location was not always comfortable. In investigating
   the effect of climate on thermal comfort; hourly air temperatures or at
   least maximum daily air temperatures were highly recommended for a
   reliable analysis and meaningful conclusions.},
