Keywords = {Integrated Water Resources Management; strategic planning; cost recovery},
Research-Areas = {Engineering; Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Engineering, Environmental; Environmental Sciences},
Affiliations = {National Technical University of Athens},
Cited-References = {{[}Anonymous], 263 WORLD BANK.
   ASSIMACOPOULOS D, 2004, IDS WAT EUR WEB C MA.
