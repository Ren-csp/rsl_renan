@inproceedings{ WOS:000351505300041,
Author = {Tripes, Stanislav and Komarkova, Lenka and Pirozek, Petr and Dvorak,
   Jiri},
Editor = {Grozdanic, V},
Title = {Determinants of a Successful Differentiation Strategy},
Booktitle = {PROCEEDINGS OF THE 10TH EUROPEAN CONFERENCE ON MANAGEMENT LEADERSHIP AND
   GOVERNANCE (ECMLG 2014)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
