@article{ WOS:A1996WA99000005,
Author = {Natvig, B and Gasemyr, J},
Title = {On probabilistic risk analysis of technological systems},
Journal = {RADIATION PROTECTION DOSIMETRY},
Year = {1996},
Volume = {68},
Number = {3-4},
Pages = {185-190},
Note = {Workshop on Radiation Risk, Risk Perception and Social Construction,
   OSLO, NORWAY, OCT 19-20, 1995},
Organization = {Norwegian Radiat Protect Authority; Swedish Radiat Protect Inst;
   European Commiss},
Abstract = {The reliability of a system is defined as the probability of system
   functioning. In reliability theory one is studying how the reliability
   of a system can be assessed from the reliabilities of its components. In
   the first part of this paper the safety of a nuclear power plant is
   considered from a reliability theory point of view. In particular, we
   focus on the Chernobyl catastrophe in 1986 and the incidents at Le Bugey
   in 1984 and Barseback in 1992. Some main areas of modern reliability
   theory of interest for the safety of nuclear power plants are indicated.
   In the second part of the paper risk and risk aversion are considered by
   first showing how these concepts are applied in modem non-life insurance
   mathematics. At the end the link to the choice between different energy
   supplies is discussed.},
