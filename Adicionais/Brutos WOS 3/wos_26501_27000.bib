@inproceedings{ WOS:000073221600098,
Author = {Vendrame, I and Pinho, MF},
Editor = {Chilton, J},
Title = {Groundwater quality in Taubate landfill, Brazil},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
