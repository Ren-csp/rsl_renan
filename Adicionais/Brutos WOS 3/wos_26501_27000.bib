@inproceedings{ WOS:000073221600103,
Author = {Gomboso, J},
Editor = {Chilton, J},
Title = {Economic and land-use planning tools for groundwater quality protection
   in Perth, Western Australia},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {587-595},
