@inproceedings{ WOS:000073221600020,
Author = {Ghazali, AM and Ali, JOE},
Editor = {Chilton, J},
Title = {Modeling of contaminant transport and seawater encroachment in coastal
   aquifers},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {137-140},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {In this paper groundwater now, contaminant transport, and seawater
   movement in coastal aquifers are simulated using the USGs three
   dimensional heat and transport model (HST3D). The heat transport
   equation was converted via parameter transformation to simulate
   conservative species solute transport (i.e. salt). This use of the model
   has been verified by comparisons with existing results for documented
   cases. The model is being implemented for a coastal aquifer site with a
   contaminant source due to leakage from an underground fuel oil storage
   tank. Preliminary results for this case are presented showing the
   effects of seawater encroachment and water extraction systems on the
   propagation of the contaminant.},
Publisher = {A A BALKEMA PUBLISHERS},
Address = {SCHIPHOLWEG 107C, PO BOX 447, 2316 XC LEIDEN, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
