@article{ WOS:000245785900050,
Author = {Kakimolo, T. and Imai, Y. and Funamizu, N. and Takakuwa, T. and
   Kunimoto, M.},
Title = {Toxicity assessment of the extract of compost as a final product from
   Bio-Toilet},
