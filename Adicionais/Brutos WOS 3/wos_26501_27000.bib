@article{ WOS:000179372600029,
Author = {Moghaddam, MRA and Satoh, H and Mino, T},
Title = {Effect of important operational parameters on performance of coarse pore
   filtration activated sludge process},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
