@inproceedings{ WOS:000333329600056,
Author = {Shinn-Cunningham, Barbara and Ruggles, Dorea R. and Bharadwaj, Hari},
Editor = {Moore, BCJ and Patterson, RD and Winter, IM and Carlyon, RP and Gockel, HE},
Title = {How Early Aging and Environment Interact in Everyday Listening: From
   Brainstem to Behavior Through Modeling},
Booktitle = {BASIC ASPECTS OF HEARING: PHYSIOLOGY AND PERCEPTION},
