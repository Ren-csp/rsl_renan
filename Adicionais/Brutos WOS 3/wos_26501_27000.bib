@inproceedings{ WOS:000425331200046,
Author = {Popescu, Nela},
Editor = {Rich, M},
Title = {The Development and Testing of Econometric Modelling for Risk of
   Regulations Changing},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2017},
Pages = {392-401},
Note = {13th European Conference on Management, Leadership and Governance
   (ECMLG), City Univ London, Cass Business Sch, London, ENGLAND, DEC
   11-12, 2017},
Abstract = {Purpose - The purpose of this paper is to develop and test an
   econometric model for estimation the level of corruption as a result of
   (law) regulations changing in a specific context (of a country), taking
   into consideration the significant macroeconomic characteristics of the
   economy.
   Design/methodology/approach - The econometric model depicted and
   proposed here use the gross domestic product (GDP, in constant or real
   terms), gross capital formation (formerly gross domestic investment, \%
   of GDP), and lending interest rate (\%) as independent variables;
   corruption amount is a dependent variable. The data used in this paper
   were from the period 1994 to 2014.
   Findings - The econometric model proposed fit the data set. Model
   captures the most important features of the problem corruption and its
   support mechanism, regulations changing. It's workable and can be used
   for studying corruption of any country. The most important findings are
   the following: the lending interest rate is a proxy, a standard for
   corruption's yield; and corruption cannot be assessed in comparable
   manner (among countries) since it's a complex process, as it's showed in
   this paper. According to the results yielded using econometric model
   presented in this paper, the financial cost of corruption, summation for
   all the period 1994 to 2014, has been estimated at around 68 per cent of
   gross domestic product reported in the year 2014. This means an average
   at around 3.24 per cent of gross domestic product per year for the
   period 1994 to 2014. The financial cost of corruption estimated through
   the econometric model presented in this paper is equivalent with more
   than three times the external debt of country analysed.
   Originality/value - Currently, the dominant approaches to measuring
   corruption are mainly focused on the perception-based approaches used to
   compare countries among them, being inadequate because they compare
   particular things and contexts that don't allow comparative analysis. I
   propose here a new approach, namely an econometric modelling. This
   approach would be a useful tool to explain the world (local or regional)
   polarization of wealth over time because everywhere money gained by
   corruption is transmigrated. Model provides insights useful for both
   citizens and decision makers.},
