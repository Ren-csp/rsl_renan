@inproceedings{ WOS:001587166000080,
Author = {Wan, Tommy and Bradbury, Iris and LaPatin, Michaela and Brown, Meredith
   and Katz, Lynn E. and Albertson, Leif and Faust, Kasey M.},
Editor = {Ahmad, S and Struck, S and Drummond, C},
Title = {Drinking Water Preferences in Hauled Households in Rural Alaska},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2025: COOL SOLUTIONS TO
   HOT TOPICS},
Year = {2025},
Pages = {856-864},
Note = {2025 World Environmental and Water Resources Congress, Anchorage, AK,
   MAY 18-21, 2025},
Abstract = {In unique environments where piped water service is not feasible or
   available, such as rural Alaska, some communities rely on hauled water
   services-i.e., water delivered to a tank at each household by truck or
   all-terrain vehicle. In these systems, unique challenges can arise
   around end-user perceptions of the safety and reliability of drinking
   water. For instance, households must consider the limited water volume
   available to them between deliveries and the possibility of delayed or
   missed deliveries due to inclement weather or limited workforce
   capacity. Another challenge related to the system operations is the
   potential contamination points at hose and tank connections when
   distributing water, or concerns regarding the water age in the tank and
   the corresponding water quality. Oftentimes, arising from such
   challenges, end- users alter their behaviors surrounding drinking water,
   such as seeking additional drinking water sources or altering their
   water through methods like point-of-use filtration. Here, we analyze 30
   interviews with hauled system users to explore water consumption
   behaviors in hauled households, including additional filtration choices,
   primary and additional drinking water sources, and reasons for making
   such choices. This study captures information about these behaviors,
   providing water utility providers with key information for
   decision-making. Results indicate that perceived negative aesthetic
   properties and safety concerns of unfiltered tap water are often
   convoluted, with individuals perceiving water to have poor smell and
   taste to be indicators of unsafe drinking water. As a result, most
   participants prefer to drink filtered tap water or storebought water,
   despite the notable increased costs and labor associated with these
   choices. Results also show that service disruptions and water volume are
   not the primary motivators for choosing alternative drinking water
   sources. Based on these findings, we recommend that hauled water utility
   providers invest in community education on drinking water safety and
   in-home tank maintenance, as well as encourage in-home filters, such as
