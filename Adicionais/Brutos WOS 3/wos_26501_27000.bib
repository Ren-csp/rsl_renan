Title = {Spatial distribution and ecological risk assessment of heavy metal on
   surface sediment in west part of Java Sea},
Booktitle = {3RD INTERNATIONAL SYMPOSIUM ON LAPAN-IPB SATELLITE FOR FOOD SECURITY AND
   ENVIRONMENTAL MONITORING 2016},
