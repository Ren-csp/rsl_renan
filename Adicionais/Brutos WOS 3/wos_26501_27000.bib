@article{ WOS:000170142600010,
Author = {Seo, GT and Ohgaki, S},
Title = {Evaluation of refractory organic removal in combined biological powdered
   activated carbon - microfiltration for advanced wastewater treatment},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2001},
Volume = {43},
Number = {11},
Pages = {67-74},
Note = {1st World Water Congress of the International-Water-Association (IWA),
   PARIS, FRANCE, JUL 03-07, 2000},
Organization = {Int Water Assoc},
Abstract = {Biological powdered activated carbon (BPAC) was incorporated with a
   microfiltration (MF, 0.2 mum pore size) system to remove the refractory
   organic matter contained in secondary sewage effluent. A synthetic
   secondary sewage effluent was used as influent in this study, containing
   both non-biodegradable organic substances (such as humic acid, lignin
   sulfonate, tannic acid and arabic gum powder) and biodegradable ones.
   These refractory organic materials were possibly degraded in contact
   with microorganisms for 20 similar to 27 days. Although humic acid and
   arabic gum were weakly adsorbed on the activated carbon, they could be
   effectively removed in the BPAC reactor. The TOC removal at a powdered
   activated carbon (PAC) concentration of 20 g/L was higher than at 0.5
   similar to2 g PAC/L (83\% and 66-68\%, respectively). The higher removal
   efficiency was due to the increased rejection at the membrane module in
   which most of the PAC was accumulated. More than 90\% of
   non-biodegradable compounds removal (detected as E-280, UV absorption at
   280 nm) occurred in the BPAC reactor. The biological growth parameter
   b/Y, used in system design, was estimated to be 0.017 d(-1). Relatively
   high permeate flux of 1.88 m/d could be obtained even at higher PAC
   concentration of 20 g/L.},
Publisher = {I W A PUBLISHING},
Address = {ALLIANCE HOUSE, 12 CAXTON ST, LONDON SW1H0QS, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Seo, GT (Corresponding Author), Univ Tokyo, Dept Urban Engn, Bunkyo Ku, 7-3-1 Hongo, Tokyo 1138656, Japan.
   Univ Tokyo, Dept Urban Engn, Bunkyo Ku, Tokyo 1138656, Japan.
   Changwon Natl Univ, Dept Environm Engn, Changwon 641773, Kyungnam, South Korea.},
DOI = {10.2166/wst.2001.0668},
ISSN = {0273-1223},
Keywords = {adsorption; advanced wastewater treatment; biodegradation; biological
   powdered activated carbon; crossflow microfiltration; refractory organic
   matter},
Research-Areas = {Engineering; Environmental Sciences \& Ecology; Water Resources},
