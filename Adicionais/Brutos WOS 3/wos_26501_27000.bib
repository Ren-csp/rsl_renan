@inproceedings{ WOS:000329380000003,
Author = {Mariojouls, Catherine and Mambrini, Muriel and Joly, J. S. and Sohm, F.
   and Barrey, S. and Boy, L. and Doussan, I. and Bertheau, Y. and Davison,
   J. and Schmid, A. F. and Coutellec, L. and Varenne, F.},
