@inproceedings{ WOS:000495364600012,
Author = {Zhu, Y. and Cao, N. and Wei, Z. and Zhang, Y. J.},
Book-Group-Author = {IOP},
Title = {Pollution Characteristics and Sources of Fine Particles During a Heavy
   Haze Episode in Winter: A Case Study of Weinan City},
Booktitle = {2019 3RD INTERNATIONAL CONFERENCE ON ENVIRONMENTAL AND ENERGY
   ENGINEERING (IC3E 2019)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2019},
