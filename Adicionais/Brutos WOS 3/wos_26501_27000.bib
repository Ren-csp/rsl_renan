Title = {Experiences in Sustainability of Two Public Universities in Different
   Contexts: The University of Copenhagen and the University of Sao Paulo},
Booktitle = {TOWARDS GREEN CAMPUS OPERATIONS: ENERGY, CLIMATE AND SUSTAINABLE
   DEVELOPMENT INITIATIVES AT UNIVERSITIES},
