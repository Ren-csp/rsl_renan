@inproceedings{ WOS:000074636300044,
Author = {van der Heever, DJ and Annegam, HJ},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Source apportionment of a large welding shop's air},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {274-279},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {South African data regarding the extent of aerosol exposure and health
   effects in the workplace are limited. Furthermore, a shortage of
   occupational hygiene- and epidemiological data from large scale studies
   exist. Given the increasing concern about the health of industrial metal
   workers, an inhalation exposure study of South African welders at a
   large engineering plant in Bloemfontein, was undertaken. The aim of the
   study was to compile a source inventory, identifying and characterising
   all health related aerosols to which the welders are exposed.
   Aerosols were sampled by means of time sequence particulate sampling on
   streaker filter frames and analysed with Particle Induced X-ray Emission
   (PIXE) on the Tandem van de Graaff accelerator of the University of the
   Witwatersrand, Johannesburg. The streaker was analysed in 1 mm steps,
   corresponding to 1 hour of exposure. PIXE analysis yielded
   concentrations or detection limits of elements Ai, Si, P, S, Cl, K, Ca,
   Ti, Cr, Mn, Fe, Ni, Cu, Zn, Br and Pb.
   A number of sources or source categories have been identified in the
   welding shop air by making use of patterns of time variations and
   elemental ratios. The air of the welding shop exhibited six atmospheric
   pollution sources such as heavy metals from welding stainless steel
   materials, heavy metal products from mild steel welding, crustal
   particles from soil, sulphur from open fires, traffic related combustion
   products and heavy metals in trace quantities. The main pollutants were
   identified and by using the data from the study, control measures for
   prevention of personnel over exposure were implemented.
   The results emphasised the importance of exposure characterisation in
   order to provide for the control of pollutant sources in welding shops.
   It is recommended that all industries implement exposure
   characterisation programmes as a tool in applying good occupational- and
   environmental hygiene.},
