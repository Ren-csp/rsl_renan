@inproceedings{ WOS:000073221600044,
Author = {Walton, NRG},
Editor = {Chilton, J},
Title = {Rising groundwater breaks surface: A case study from the Arabian Gulf},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {273-276},
