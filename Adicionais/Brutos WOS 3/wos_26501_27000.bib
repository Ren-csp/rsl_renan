Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {Satellite observations are very useful for studies on regional and
   global impacts of air pollution. Also, remote sensing is an useful
   technique to detect the atmospheric loadings of natural and
   anthropogenic emissions. For example, dust storms (yellow sand in East
   Asia), volcanic smoke and dust, biomass burning (e.g. forest fire), and
   industrial pollution and haziness were the subject of satellite
   detection in some of previous studies. Presently, in view of health
   effect and global climate change, fossil-fuel and biomass burnings are
   major emission sources and are the subject of human control. The work
   reported here is to show examples of atmospheric impact of biomass
   burning, dust cloud and industrial air pollutants using satellite
   analyses. Satellite detection is complimentary to process and modelling
   studies of air pollution impact.},
