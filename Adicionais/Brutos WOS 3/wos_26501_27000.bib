@article{ WOS:000236679300026,
Author = {Aryal, RK and Furumai, H and Nakajima, F and Boller, M},
Title = {Characteristics of particle-associated PAHs in a first flush of a
   highway runoff},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
Volume = {53},
Number = {2},
Pages = {245-251},
Note = {8th IWA International Conference on Diffuse/Nonpoint Pollution, Kyoto,
   JAPAN, OCT 25-29, 2004},
Organization = {IWA},
Abstract = {Runoff monitoring of six rainfall events was carried out in a highway,
   Winterthur, Switzerland focusing on first flush (runoff volume up to
   2.88 mm). Six runoff events were used to investigate the characteristics
   of particle-associated PAHs in first flush. The fine fraction (< 45 mu
   m) had a relatively higher contribution than the coarse fraction. A
   significant contribution of the coarse fraction was observed at some
   periods when the runoff flow rapidly increased. Fluctuation of PAH
   content during a runoff event was significant in the coarse fraction
   and, in contrast, the PAH content in the fine fraction was less
   fluctuating. The weighted average PAH content in each event ranged from
   17 to 62 mu g/g in total SS, from 23 to 54 mu g/g in the fine fraction
   and from 16 to 84 mu g/g in the coarse fraction. The loading of
   particle-associated PAHs from the first flush of highway runoff ranged
   from 0.06 to 0.22 g/ha in a total of 12 PAH species.},
Publisher = {IWA PUBLISHING},
