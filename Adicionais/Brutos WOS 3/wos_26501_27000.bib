@inproceedings{ WOS:000335751400020,
Author = {Perricone, G. and Fontana, V and Carollo, A. and Polizzi, C.},
Editor = {Barone, L},
Title = {Prenatal attachment in pregnant women subjected to fetal
   echocardiography},
Booktitle = {6TH INTERNATIONAL ATTACHMENT CONFERENCE},
Year = {2013},
Pages = {103-108},
Note = {6th International Attachment Conference (IAC), Pavia, ITALY, AUG 30-SEP
   01, 2013},
Organization = {Univ Pavia},
Abstract = {The study focuses on the prenatal attachment relationship in pregnant
   women subjected to fetal echocardiography, because of a suspicious of
   congenital heart disease in the fetus. It is supposed that having to
   subject to this specific screening may constitute an emotional stress
   condition for the woman, so to influence the construction of the
   prenatal attachment bond, in the sense of an excessive and early
   investment or of detachment. Considering the import that some variables
   may have on prenatal attachment, the research considered the possible
   effects of the mother's personality, the social support and the couple
   functioning in terms of cohesion and adaptability.
   The study explored possible differences regard to prenatal attachment
   among a group of 85 pregnant women waiting for fetal echocardiography
   (mean age=31.4, SD=5.7) and a group of 83 women waiting for
   morphological scan (mean age=29.7, SD=6.5). Furthermore, it was checked
   the effect that specific psychological variables may have to prenatal
   attachment. The tools used were: the Prenatal Attachment Inventory; the
   Big Five Adjectives; the Maternity Social Support Scale; the Faces III.
   It was conducted an ANOVA to analyze differences related to prenatal
   attachment between the two groups. It was also implemented a
   hierarchical regression analysis to evaluate, in women subjected to
   fetal echocardiography, the predictive effect of the variables above
   mentioned. The results do not highlight statistically significant
   difference between the two groups respect to prenatal attachment
   (F=.017, p=.89), suggesting a tendency to consider fetal
   echocardiography a routine screening, probably due to a tendency by the
   health workers to apply it too frequently. As respects the effect of the
   other variables, it is only predictive the social support (R2=.061,
   df(1,80), p=.025), which would seem that support perception influence
   positively the quality of prenatal relationship.
   The results suggest a consideration on many issues that concern both the
   quality of the relationship between the woman and the physician and the
   impact on health care costs.},
