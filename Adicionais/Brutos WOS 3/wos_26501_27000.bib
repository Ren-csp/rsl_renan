@article{ WOS:000441173100146,
Author = {Lee, Seung-Oh and Kim, Won-Jin and Cho, Yong-Sik},
Title = {Generation of a New Tsunami Hazard Map for the Port of Imwon},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2018},
Number = {85},
Pages = {726-730},
Month = {MAY},
Note = {15th International Coastal Symposium (ICS), Busan, SOUTH KOREA, MAY
   13-18, 2018},
Organization = {Korea Inst Ocean Sci \& Technol; Korea Soc Coastal Disaster Prevent;
   JCR; Coastal Educ \& Res Fdn},
Abstract = {Tsunamis, which are long-period oceanic waves mainly generated by
   undersea earthquakes, can be one of the most devastating types of
   natural hazard. Tsunamis frequently occur around the rim of the Pacific
   Ocean, including the East Sea. The most plausible and frequently chosen
   tsunami hazard mitigation measure is to generate a tsunami hazard map
   based on probable maximum tsunamis. Probable maximum tsunamis in the
   present study are three historical tsunamis and 11 virtual tsunamis. The
   port of Imwon, located on the eastern coast of the Korean Peninsula, is
   vulnerable to an unexpected tsunami strike. The Central East Sea Tsunami
   that struck in May 1983 resulted in three human casualties (one death
   and two people missing and presumed dead) and property damage. The
   present study generates a tsunami hazard map for the port of Imwon.
   Shelters and evacuation routes are determined according to selection
   criteria and a field survey. The newly developed tsunami hazard map can
   be used by local authorities in the case of a real tsunami.},
Publisher = {COASTAL EDUCATION \& RESEARCH FOUNDATION},
Address = {5130 NW 54TH STREET, COCONUT CREEK, FL 33073 USA},
Type = {Article; Proceedings Paper},
Language = {English},
