@inproceedings{ WOS:000179444800158,
Author = {Sendi, R},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Transition period housing design practices in Slovenia},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1299-1305},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {House building in Slovenia over the last five decades or so has been
   characterised by two main forms of construction. On the one hand is the
   construction of single-family homes, dispersed at very low density, and
   on the other is the organised housing construction of housing estates,
   predominantly consisting of blocks of flats and high-rise buildings at
   high density. The latter used to be referred to as social housing before
   most of the dwellings in these housing estates were sold off to the
   sitting tenants during the privatisation process in the early 1990s.
   Since the introduction of a market economy system in 1991 however, there
   have been significant changes. The observation is made in this paper
   that there has been a change in people's perceptions of what housing and
   housing quality means to them, in contrast to the previous situation
   under socialist rule whereby housing construction standards were set to
   satisfy, above all, shelter requirements with less attention paid to
   quality and aesthetic aspects. It will be argued that most of these
   changes relate especially to housing design although some attempts at
   improving housing quality may also be observed. The last ten years or so
   have, as such, seen the emergence of `new' housing typologies that
   strikingly differ from previous housing designs. The average five-storey
   multifamily residential block that used to characterise the public
   housing estates, has long disappeared from the architectural drawing
   board. The previously `standardised' single-family house design that any
   foreign visitor to Slovenia could easily identify in any part of the
   country is also having a facelift.
   Notwithstanding these new developments however, it is still not clear as
   to what type of housing design would be most suitable to replace/improve
   the previous forms of design and housing typologies. This paper seeks to
   highlight the positive and negative aspects of `transition period'
   housing designs. It is suggested that the developments of the past
   decade call for a greater effort to be invested in the study of current
   design and construction practices and in the formulation and development
   of more appropriate architectural design standards.},
Publisher = {WIDE DREAMS PROJECTOS MULTIMEDIA LDA},
