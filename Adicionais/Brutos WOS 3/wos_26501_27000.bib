@article{ WOS:000357350500021,
Author = {Ratanatamskul, C. and Wattanayommanaporn, O. and Yamamoto, K.},
Title = {An on-site prototype two-stage anaerobic digester for co-digestion of
   food waste and sewage sludge for biogas production from high-rise
   building},
