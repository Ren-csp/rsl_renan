@inproceedings{ WOS:000073221600055,
Author = {Kelly, WE and Dahab, MF},
Editor = {Chilton, J},
Title = {Hydrogeology of the Kearney, Nebraska, wellfield},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
