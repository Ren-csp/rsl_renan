@inproceedings{ WOS:000074636300113,
Author = {Lee, CB and Kim, YG and Cho, CR and Park, SY},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Seasonal variation of SO2 dry deposition velocity obtained by
   sonic anemometer-thermometer observation},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {704-707},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {The purposes of the present study are to analyze the seasonal
   variability of dry deposition velocities on rice paddy field and to
   compare the methods to calculate the velocities. For calculation of the
   velocities, atmospheric turbulence parameters were measured by three
   dimensional sonic anemometer-thermometer at height of 5m, and mean wind
   and temperature data were obtained at two heights, 2.5m and 10m. The
   field observation was performed for 1 year from November 1995 to October
   1996.
   The results showed that the dry deposition velocity was large in summer
   and small in winter. The major factor of diurnal variation was
   aerodynamic resistance. In the daytime, the dry deposition velocities
   computed using the mean meteorological data showed relatively similar to
   the velocity measured by the sonic anemometer-thermometer, however there
   were big differences at night.},
