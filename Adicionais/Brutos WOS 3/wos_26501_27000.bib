@inproceedings{ WOS:000081237400104,
Author = {Asamoah, J},
Editor = {Eliasson, B and Riemer, P and Wokaun, A},
Title = {The uptake of energy conscious housing design in South Africa as a
   mitigation of emission of greenhouse gases},
Booktitle = {GREENHOUSE GAS CONTROL TECHNOLOGIES},
Year = {1999},
Pages = {653-657},
Note = {4th International Conference on Greenhouse Gas Control Technologies
   (GHGT-4), INTERLAKEN, SWITZERLAND, AUG 30-SEP 02, 1998},
Organization = {ABB Corp Res; Int Energy Agency Greenhouse Gas Programme; British Petr;
   ETH; Norsk Hydro; PSI; RITE; SAIC; Saudi Aramco; Shell; Siemens;
   Statoil; Swiss Fed Off Energy; Swiss Re; US DOE},
Abstract = {Housing backlog in Africa is a real problem confronting many governments
   on the continent. Attempts to redress this backlog could bring other
   benefits on the global front. If one regards a house as a huge energy
   appliance, then the impetus to explore the big savings in avoided
   greenhouse gas (GHG) emissions is significant. This can be realised by
   simply adopting energy conscious design and demand-side management.
   Benefits to be gained from the implementation of this seemingly simple
   technology includes reduction in the use of fossil fuels, cost savings,
   improvement in health, improved levels of comfort and optimum use of
   natural resources.
   In existing houses, retrofits are being introduced to use energy
   optimally. Models and real life situations are now being showcased to
   emphasise the fact that energy efficient houses are not necessarily more
   expensive than conventional ones, but can result in win-win scenarios.
   Why the apparent dearth of such homes in Africa? There seems to be lack
   of capacity, education and awareness to the uptake of the above
   technology in the design of houses. In South Africa, there is a huge
   opportunity to avoid emission of GHG in the massive on-going
   Reconstruction and Development Programme's (RDP) housing scheme; through
   the adoption of energy conscious design. Some of the technologies
   currently available are compact fluorescent lights (CFL), photovoltaics
   (PV), sunstoves and proper orientation of houses to take advantage of
   solar energy. The perception that some of these technologies require
   huge initial capital outlays may hold in some cases. However governments
   and building societies could assist by promoting these technologies
   through buy downs and other financially friendly schemes. At the design
   stage, houses could be properly orientated to take advantage of
   daylight. Africa is endowed with abundant sunshine throughout the year.
   The above measures would reduce the demand for fossil fuels that pollute
   the atmosphere and also contribute to global climate change. Forest
   degradation arising out of uncontrolled cutting of trees for woodfuel
   and erosion from over grazing of grassland is rife in South Africa. This
   paper will highlight some of the technologies and demand side
   management; that are used to reduce the supply and demand for
   conventional forms of energy in the household.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Asamoah, J (Corresponding Author), Climate Energy \& Environm Wise Africa, Pretoria, South Africa.
   Climate Energy \& Environm Wise Africa, Pretoria, South Africa.},
DOI = {10.1016/B978-008043018-8/50104-1},
