@inproceedings{ WOS:000073221600031,
Author = {Stuart, ME and Milne, CJ},
Editor = {Chilton, J},
Title = {Groundwater quality implications of wastewater irrigation in Leon,
   Mexico},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {193-198},
