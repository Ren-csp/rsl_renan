@inproceedings{ WOS:000298299706117,
Author = {Ragland, Chara J. and Feldpausch-Parker, Andrea and Peterson, Tarla Rai
   and Stephens, Jennie and Wilson, Elizabeth},
Editor = {Gale, J and Hendriks, C and Turkenberg, W},
Title = {Socio-political dimensions of CCS deployment through the lens of social
   network analysis},
