@inproceedings{ WOS:000084315100062,
Author = {Meyers, RB and Heimlich, JE},
Editor = {Abrams, R},
Title = {Education before controversy: A study of the Ohio State University
   Extension's Radiation Education Program},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {247-251},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {When Ohio was designated as host state for the Midwest's Compact's low
   level radioactive waste disposal facility in July 1991, several faculty
   members in The Ohio State University Extension and OSU Nuclear
   Engineering Departments anticipated the eventual development of
   extensive controversy concerning low-level radioactive waste (LLRW) in
   Ohio. They perceived that knowledge of low-level radioactive waste was
   limited, that fear of LLRW was high, and recognized that there was a
   need for objective, easily accessible, science-based information on the
   subject in order to help create an informed public capable of entering
   into local discussion on the topic. The Project's goal was to make the
   educational materials accurate, easy to understand, unbiased and
   constructed to be well-received by a public with high fear of the
   subject matter.
   In the initial stages, the Project encountered resistance to the concept
   that an educational program can be policy-neutral. Anecdotal feedback
   from citizens indicates that the term ``education{''} is almost
   universally interpreted as ``indoctrination{''} or ``propaganda{''}.
   This perception of ``educational programs{''}, in conjunction with the
   highly controversial subject matter, led the Project team to take
   extraordinary measures to gather and maintain a diverse Project team and
   to conduct an unusually extensive public and peer review process to
   ensure the development of unbiased, technically sound, accessible
   materials.
   These educational materials were used as the basis to conduct sixteen
   educational seminars (Inservice trainings) with Extension Agents
   throughout Ohio. Pre/post tests of Extension Agent radiation knowledge
   were conducted and compared to a statewide random survey. The results
   were analyzed to determine the impact of the educational Project on
   level of participating Extension Agents' knowledge of radiation science,
   and to the level of knowledge of the general public. The applicability
   of these findings to the general problem of increasing the ability of
   the public and legislators to participate in a more informed manner
   during the public policy process is discussed.},
Publisher = {NORTH AMERICAN ASSOC ENVIRONMENTAL EDUC},
