@inproceedings{ WOS:000425332900037,
Author = {Vongjaturapat, Sununthar},
Editor = {Tsui, E and Cheung, B},
Title = {The Effect of Mobile Technology on Accessing Learning Material},
Booktitle = {PROCEEDINGS OF THE 14TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2017)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2017},
Pages = {291-300},
Note = {14th International Conference on Intellectual Capital, Knowledge
   Management and Organisational Learning (ICICKM), Hong Kong Polytechn
   Univ, Hong Kong, HONG KONG, DEC 07-08, 2017},
Abstract = {Due to its advantages, such as portability and flexibility, mobile
   technology is becoming an avenue of interest for use in digital
   libraries. In this study, we try to empirically analyze the use of these
   portable devices for accessing learning material. First, we conducted on
   exploratory study based on 158 surveys in which the responders were
   asked to mark what they consider to be important interactions in mobile
   technology for accessing learning material. Based on the findings from
   the exploratory study, important interaction included: 1. turn pages 2.
   zoom in and out 3. annotation and highlighting 4. scrolling and 5.
   switching between pages. Then, this research generated the development
   of a new measuring instrument which can be used to analyze data
   collected for patrons in a library context. Through strenuous and
   extensive data analysis with SEM, EFA and CFA, the original measurement
   scale was reduced and required re-specification to suit a specific
   information system. To this end, we proposed a research model and
   empirically tested our hypotheses analysis based on 418 reports from
   patrons (140 a tablet usage group). This study included that the tablet
   usage group and task technology fit (TTF) have a direct effect on
   performance impact (PE) with a path coefficient of 0.52, and the
   R-square value is 0.17. This shows the importance of TTF. However, when
   the mobile technology used was a smart phone, the association between
   TTF and PE was lowered, with a path coefficient of 0.33, and the
   R-square value is 0.09. The results obtained allowed us to conclude that
   the use of devices with visualization limitations (mobile phones) is not
   suitable to access and visualize learning materials, although it is
   considered more motivating for learners. The results also indicate
   positive perception of the use of tablet for studying. Thus, academic
   libraries should provide more sufficient tablets to students to fulfil
   such needs.},
