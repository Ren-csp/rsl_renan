@inproceedings{ WOS:000074636300093,
Author = {Mucke, HG},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Air quality assurance and control in the WHO European Region},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {581-585},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {An overview is given of the harmonisation work led by the WHO
   Collaborating Centre for Air Quality Management and Air Pollution
   Control (WHO CC), Berlin, in the field of air quality measurements. The
   work of WHO CC is presented by giving examples of recent achievements on
   air quality assurance. In line with the air quality management
   activities of UNEP/WHO GEMS/Air the WHO CC started a programme on
   `European Intercomparison Workshops on Air Quality Monitoring' in the
   WHO European Region. The workshops are carried out as round-robin
   training courses to determine and evaluate the quality of the measured
   concentration values. They are designed to enable participants to
   compare the outcome of their analytical equipment (manual and automated
   methods) to their own national and to international standards. From 1994
   to 1996 five workshops for measuring of SO2, NO, NO2, CO, and O-3 were
