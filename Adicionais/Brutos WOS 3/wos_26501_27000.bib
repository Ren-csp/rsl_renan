@inproceedings{ WOS:000073221600034,
Author = {Amer, AM and Sherif, MM and Masuch, D},
Editor = {Chilton, J},
Title = {Groundwater rise in Greater Cairo: Cause and effects on antiquities},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
