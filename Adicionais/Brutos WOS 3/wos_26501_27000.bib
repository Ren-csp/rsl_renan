@inproceedings{ WOS:000074636300043,
Author = {Kim, YP and Kim, JY and Ghim, YS and Na, K and Shim, SG and Moon, KC},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Ambient concentrations of volatile organic compounds in Seoul},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {265-273},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {To understand characteristics of volatile organic compounds (VOCs) in
   Seoul, a hydrocarbon measurement study was carried out in the year of
   1996. Approximately 170 VOCs were identified and quantified from the
   ambient air samples collected on April 26 and August 17, 1996 at Korean
   Meteorological Administration in Seoul. On each sampling day, three
   two-hour integrated ambient air samples were collected in early morning,
   early afternoon, and late afternoon, respectively. The samples were
   collected on cleaned SUMMA air sampling containers with constant air
   flow rate. Analyses of VOCs were carried out by a GC-FID. The total VOC
   concentrations showed a diurnal variation with minimum values during
   morning and maximum values during late afternoon. The concentration of
   oxygenated hydrocarbons was highest during early afternoon while those
   of other groups showed morning maximum. It suggests existence of
   photochemical smog in Seoul during the measurement periods. The
   concentrations of light alkanes, such as propane and butane were high
   due to the liquefied petroleum gas (LPG) used by taxis as fuel in Korea.
   The concentration of toluene was the highest among 170 VOCs in the
   afternoon samples. The concentrations of hazardous air pollutants in
   Seoul were comparable to or lower than the those in the populated areas
   in USA or other large cities in the world.},
