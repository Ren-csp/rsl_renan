@inproceedings{ WOS:000073221600066,
Author = {Dragisic, V and Miladinovic, B and Milenic, D},
Editor = {Chilton, J},
Title = {Pollution of groundwaters on Donji Milanovac},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {395-398},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {This paper describes a case example of excessive ground water pollution
   in a catchment area for domestic supply, from copper flotation effluent
   at Majdanpek. The copper ore deposit at Majdanpek is located in the Bor
   field, one of the largest copper-bearing basins of Europe. Flotation of
   low-copper ores produces waste water which is discharged to a tailing
   dump. This waste water contains increased contents of sulphate, iron,
   manganese, and other metallic constituents. Occasional failures at dumps
   result in uncontrolled seepage into surface streams and consequent
   contamination of both surface and ground water. The latest excessive
   pollution of ground water in May 1996 was caused by failure in the
   flotation-tailing dam at Majdanpek. The effluent seepage from the dump
   polluted the source of domestic water supply to the town of Donji
   Milanovac and a few more intake areas in rural communities of the
   Porecka Reka basin.},
Publisher = {A A BALKEMA PUBLISHERS},
Address = {SCHIPHOLWEG 107C, PO BOX 447, 2316 XC LEIDEN, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Dragisic, V (Corresponding Author), Univ Belgrade, Fac Mining \& Geol, YU-11001 Belgrade, Yugoslavia.
   Univ Belgrade, Fac Mining \& Geol, YU-11001 Belgrade, Yugoslavia.},
