Title = {Analysis of Factors for Palliative Care for Breast Cancer Patients in
   Java in 2020},
Booktitle = {PROCEEDINGS OF THE 4TH INTERNATIONAL CONFERENCE ON SUSTAINABLE
   INNOVATION 2020 - HEALTH SCIENCE AND NURSING (ICOSIHSN 2020)},
