@article{ WOS:000431770900102,
Author = {Widana, I. Ketut and Sudiartha, I. Ketut},
Title = {The Benefits of Improved Aspects of Human Physiology in the Learning
   Process},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {12},
Pages = {12116-12120},
Month = {DEC},
Note = {1st International Joint Conference on Science and Technology (IJCST),
   Bali, INDONESIA, OCT 12-13, 2016},
Organization = {Univ Pembangunan Nas Veteran Jawa Timur, Fac Ind Technol; Bali State
   Polytechn; Natl Cheng Kung Univ; Univ Negeri Surabaya, Fac Social Sci \&
   Law; Univ Negeri Surabaya, Fac Math \& Nat Sci; Univ Trunojoyo Madura,
   Fac Engn},
Abstract = {This study is a research on ergonomics participatory, especially for
   school ergonomics. It involves as many stake-holders to participate in
   educational thinking and find a way out of problems in the learning
   process. The long term goal of this research is to get an effective
   learning strategy in vocational colleges. Based on the Strategic Plan of
   Bali State Polytechnic 2009-2014, there are some performance indicators
   that in the short term should be achieved. CAI (cumulative achievement
   index) which planned 3.6 at the end of 2014 only reached 3.43, so there
   needs to be an effort for the increase. Forms planned intervention is
   the use of power point design interactive multimedia base,
   stretching/relaxation, interactive presentations and activities of
   students in answering and asking. To determine the impact of
   treatment/intervention of the condition of the subject was be carried
   out experimental research for real (true experiment) that use cross
   design (two-period cross-over design). Rate the quality of the learning
   process carried out by two cycles of research, in which each cycle ends
   with the provision of test/questionnaire. The object of research is
   improving the quality of learning subjects Technopreneurship through the
   implementation of ergonomics participatory. The results showed that The
   results showed that in cycle 2 student achievement increased by 17.05\%
   over the cycle 1. The level of satisfaction shown by the perception of
   students also increased by 9.72\% after the intervention. The same thing
   can be seen from the level of student health as indicated by
   physiological conditions after the intervention. The workload is shown
   by the pulse of work decreased by 15.66\% from 83.00 into 70.00 beats
   per minute (bpm). Musculoskeletal disorders decreased 9.69\%, from a
   score of 53.15 into 48.00 and fatigue decreased 22.97\% from score 50.63
   to score 39.00. It can be concluded that the participatory ergonomics
   can improve learning achievement, satisfaction and health status of
   student.},
