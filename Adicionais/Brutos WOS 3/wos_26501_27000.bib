@inproceedings{ WOS:000074636300045,
Author = {Bayram, A and Yilmaz, Z and Odabasi, M and Muezzinoglu, A},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {Levels of some heavy metals suspended particulate matter in and around
   Aliaga industrial region, Izmir/Turkey},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {280-285},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {In this study, measured concentrations of some heavy metals (Fe, Zn, and
   Cu) in particulate matter in atmosphere around the Aliaga Industrial
   Region are presented. 24-hr integrated particulate matter samples from
   the atmosphere were taken to assess the air quality in and around the
   Aliaga and analysed to determine the heavy metal concentrations in five
   measurement stations. Heavy metal concentration levels decrease
   gradually as the stations are further. Between the 3 heavy metals of Fe,
   Zn, Cu, iron is the leading one in concentrations. Second highest
   metallic element in the ambient air is zinc. The lowest level heavy
   metal among the three heavy metals is cupper. High iron concentrations
   and especially their spatial variation with respect to proximity to the
   industries show that they originate from the iron and steelworks. Due to
   the toxic effects of the heavy metal contamination, more stringent
   measures must be taken to stop these emissions.},
Publisher = {TRANS TECH PUBLICATIONS LTD},
