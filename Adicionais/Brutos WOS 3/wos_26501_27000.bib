@article{ WOS:000188585600005,
Author = {Wang, DG and Li, SM},
Title = {Housing preferences in a transitional housing system: the case of
   Beijing, China},
Journal = {ENVIRONMENT AND PLANNING A-ECONOMY AND SPACE},
