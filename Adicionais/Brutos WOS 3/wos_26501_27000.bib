@inproceedings{ WOS:000073221600118,
Author = {Turin, HJ and Gaume, AN and Bitner, MJ and Hansen, HS and Titus, FB},
Editor = {Chilton, J},
Title = {Albuquerque, New Mexico, USA: A sunbelt city rapidly outgrowing its
   aquifer},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
