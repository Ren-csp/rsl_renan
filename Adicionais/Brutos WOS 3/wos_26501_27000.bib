@inproceedings{ WOS:000073221600065,
Author = {Dinu, I and Albu, M and Moldoveanu, V and Nash, H},
Editor = {Chilton, J},
Title = {Groundwater supply of Slatina city endangered by contaminants from the
   River Olt, Romania},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {389-394},
