@article{ WOS:000485724400057,
Author = {Wang, Junxiao and Lu, Chunfeng and Tang, Jing and Ge, Liang and Huang,
   Zhaolin and Zhou, Shenglu},
Title = {Time Series and Spatial Characteristics of Public Attention towards
   Huangyan Island Based on Baidu Index},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2019},
