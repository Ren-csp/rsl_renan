@article{ WOS:A1994PN61300014,
Author = {TOKIWA, H and SERA, N and NAKASHIMA, A and NAKASHIMA, K and NAKANISHI, Y
   and SHIGEMATU, N},
Title = {MUTAGENIC AND CARCINOGENIC SIGNIFICANCE AND THE POSSIBLE INDUCTION OF
   LUNG-CANCER BY NITRO AROMATIC-HYDROCARBONS IN PARTICULATE POLLUTANTS},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {1994},
Volume = {102},
Number = {4},
Pages = {107-110},
