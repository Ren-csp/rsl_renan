@article{ WOS:000180041000013,
Author = {Moghaddam, MRA and Satoh, H and Mino, T},
Title = {Performance of coarse pore filtration activated sludge system},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {46},
Number = {11-12},
Pages = {71-76},
Note = {IWA Asia-Pacific Regional Conference, FUKUOKA, JAPAN, SEP 12-15, 2001},
Organization = {IWA},
Abstract = {A coarse pore filter can be applied inside the aeration tank to
   facilitate the separation of sludge from liquid instead of
   sedimentation. This filter has pores, which are irregular in shape, and
   the pore size is bigger than those of MF. The objectives of the study
   were to maintain as much as MLSS in the activated sludge process with
   coarse pore filter and to investigate the performance under high MLSS
   condition. Small-scale reactor results so far show good quality of
   effluent specially after starting the sludge bulking in the system in
   terms of SS, TOC, DOC and turbidity. The average carbon removal for 62
   days operation of this system was about 94\% (based on effluent DOC) and
   87 \% (based on effluent TOC). The average sludge yield in this system
   is about 0.44 kg MLSS/kg TOC which is about 0.24 kg MLSS/kg BOD. This
   amount is less than those of conventional activated sludge and trickling
   filter.},
