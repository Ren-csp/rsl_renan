@inproceedings{ WOS:A1997BH34N00054,
Author = {Ahluwalia, SS},
Book-Group-Author = {INT ASSOC ENERGY ECON},
Title = {Financing energy investments in India - 1998 to 2012: The role of
   economic reform in bridging the demand - Supply gap},
Booktitle = {ENERGY AND ECONOMIC GROWTH: IS SUSTAINABLE GROWTH POSSIBLE?, VOLS 1-3},
Year = {1997},
Pages = {605-617},
Note = {20th Annual International Conference of the
   International-Association-for-Energy-Economics, NEW DELHI, INDIA, JAN
   22-24, 1997},
Organization = {Int Assoc Energy Econ; Indian Oil Corp, India; Oil Ind Dev Board, India;
   Dtsche Gesell Tech Zusammenarbeit, Indo German Energy Efficiency
   Project; Inst Energy Econ, Energy Data \& Modelling Ctr, Japan; Govt
   India, Minist Non Convent Energy Sources; UNOCAL Corp, US},
Abstract = {This paper uses a spread sheet model to estimate the demand for
   investments in energy and capital supply from non governmental sources
   in India during the period 1998 to 2012. Investment demand and capital
   supply are modeled to be dependent on the speed and scope of
   implementation of the economic reforms started in 1991. Three scenarios
   are developed around the speed of macro economic and energy sector
   reforms, to simulate the likely trends over the period 1998 to 2012.
   Contrary to popular perception investment demand, as modeled, decreases
   with higher economic growth. Despite the pressures of income led growth
   in demand, the extraction of supply and demand side efficiencies is
   assumed to be sufficient to compress investment demand. Investment
   demand ranges from 6.8\% of GDP under the high reform scenario to 8.9\%
   of GDP under the `Low Reform' scenario.
   Capital supply as modeled is sensitive to sustained reform and economic
   growth. The availability of foreign capital ranges between 28\% to 34\%
   of total capital supply. As a ratio of GDP it rises from the current
   trend of around 2.2\% of GDP to between 2.7\% to 4.6\% of GDP. There is
   a severe shortage of long term debt particularly in the domestic market.
   The availability of debt ranges between 24\% and 38\% of the total
   capital supply giving rise to an inverted and extremely conservative
   capital structure. Aggregate capital supply varies between 10\% to 14\%
   of GDP with supply increasing with the pace of reforms.
   Supply side capacity enhancement options to bridge the energy gap are
   unsustainable, as is evidenced by the `Low Reform' scenario. However,
   even under assumptions of aggressive demand management measures, as in
   the `Moderate' and `High Reform' scenarios, there is a substantial
   financing gap in the first ten years of the period 1998 to 2007.
   Investment demand is front loaded while capital supply is back loaded.
   The extent of the financing gap is crucially dependent on the growth
   rate of the economy and the depth of reform. Bridging the financing gap
   requires proactive government intervention in targeting subsidies
   tightly, introducing competition and market determination of energy
   prices, improving the functioning of the public sector, exercising
   fiscal discipline, developing the domestic financial markets,
   introducing transparent regulation and forging a cooperative partnership
   with the private sector in energy development.},
Publisher = {TATA ENERGY RESEARCH INST},
Address = {DOCUMENTATION \& INFORMAT CTR OUTREACH CELL INDIA HABITAT CENTRE, NEW
   DELHI 110 003, INDIA},
