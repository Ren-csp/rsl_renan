@inproceedings{ WOS:000074636300085,
Author = {Hettelingh, JP and Posch, M and de Smet, PAM},
Editor = {Incecik, S and Ekinci, E and Yardim, F and Bayram, A},
Title = {The use of critical thresholds to assess natural stock at risk},
Booktitle = {AIR QUALITY MANAGMENT: AT URBAN, REGIONAL AND GLOBAL SCALES},
Year = {1997},
Pages = {536-544},
Note = {10th Regional IUAPPA Conference, ISTANBUL, TURKEY, SEP 23-26, 1997},
Organization = {IUAPPA},
Abstract = {The critical threshold is a generic term for allowable limits of
   pollutant loads and concentrations, beyond which adverse effects on
   ecosystems and human health do not occur according to current scientific
   knowledge. Mapping critical loads and levels has progressed from
   supporting a one-pollutant-one-effect (sulfur) protocol to a
   multi-pollutant-multi-effect (nitrogen) protocol. The requirements have
   changed accordingly since impacts are no longer restricted to
   acidification (sulfur based), but include acidification (nitrogen
   based), eutrophication, and direct impacts (by ozone). The side
   constraint of the European mapping work remains that results need to be
   applicable in integrated assessment models dealing with emissions,
   abatement cost, atmospheric transport and minimization of critical
   threshold excess. This paper describes the current status of the mapping
   work acid shows preliminary results of assessments of stock at risk,
   using maps of land cover, in relation to sulfur deposition and ambient
   concentrations of sulfur dioxide and tropospheric ozone. The main
   recommendations is that an assessment,of risk of damage to, e.g.,
   forests should be based on the analysis of multi stress rather than the
   investigation of a single impact of one pollutant. The use of multiple
   critical thresholds to assess air quality becomes even more relevant
   when health related air quality guidelines are used in addition to
   ecosystem based critical thresholds.},
Publisher = {TRANS TECH PUBLICATIONS LTD},
Address = {LAUBLSRUTISTR 24, CH-8717 STAFA-ZURICH, SWITZERLAND},
