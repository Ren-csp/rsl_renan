@inproceedings{ WOS:000281143200092,
Author = {De Smedt, Anouk and Buyl, Ronald and Nyssen, Marc},
Editor = {Hasman, A and Haux, R and VanderLei, J and DeClercq, E and France, FHR},
Title = {Evidence-based practice in primary health care},
