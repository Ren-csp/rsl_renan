Title = {A research on the risk control on overseas merger and acquisition in
   promoting the sustainable development of the Chinese enterprises},
Booktitle = {Towards A Responsible Success: Corporate Social Responsibility and
   Environmental Management},
Year = {2007},
Pages = {281-285},
Note = {Euro-Asian Conference on Environment and Corporate Social Responsibility
   - Perspectives from Business in Asia, Hong Kong, PEOPLES R CHINA, NOV  
   17, 2006},
Organization = {TU Bergakademie Freiberg; Hong Kong Univ, Ctr Urban Planning \& Environm
   Management; German Acad Exchange Serv Fdn; German Ind \& Commerce; Off
   European Commiss Hong Kong \& Macao; CSR Asia},
Abstract = {The differences between enterprises in transnational mergers and
   acquisitions enable them to shift business to other countries with lower
   costs, strengthen the abilities of companies to deal with the market
   changes, while help companies to learn and adapt to different cultures.
   Currently, more and more Chinese enterprises participate in the overseas
   merger and acquisition in order to pursue sustainable development.
   Therefore, some efficient risk-control measures should be adopted to
   elude the associating risks. This paper presents the research results of
   the author in terms of the risk control on the merger and acquisition in
   promoting the sustainable development of the Chinese Enterprises.},
