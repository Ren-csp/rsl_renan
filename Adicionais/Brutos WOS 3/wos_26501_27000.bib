@inproceedings{ WOS:000222427500012,
Author = {Wilson, JA},
Editor = {Light, S},
Title = {Is there anything to learn from the experience in the Maine lobster
   fishery?},
Booktitle = {ROLE OF BIODIVERSITY CONSERVATION IN THE TRANSITION TO RURAL
   SUSTAINABILITY},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SUB-SERIES 4, SCIENCE AND
   TECHNOLOGY POLICY},
Year = {2004},
Volume = {41},
Pages = {160-169},
Note = {NATO Advanced Research Workshop on Role of Biodiversity Conservation in
   the Transition to Rural Sustainability, Krakow, POLAND, NOV 05-09, 2002},
Organization = {NATO Sci Program, Sci \& Technol Policy \& Org},
Abstract = {The Maine Lobster fishery may seem a strange place to draw lessons for
   rural sustainability in central Europe. But this fishery, like so many
   others, shares a history of centralized control and the people who work
   in the fishery share the fear of losing their independence to new,
   external and large-scale forces. In fisheries, the original reasons for
   centralization were based upon a scientific perception of large-scale
   ecological phenomena that were thought to determine sustainability
   (e.g., the spawning biomass of a species over what were assumed to be
   very large stock(1) ranges). Also, following classic scientific
   determinism, fisheries science assumed it would be possible to
   manipulate natural populations at that large scale in a way that could
   optimize human use of these resources(2). In short, centralized
   management (i.e., large scale management) was justified on the grounds
   that that was the scale appropriate to the fish stocks themselves.
   The world's experience with centralized management of fisheries has been
   very mixed. Canadian management of the huge Grand Banks cod stocks has
   driven those populations to near extinction. Throughout the North
   Atlantic fish stocks are at all time lows. But at the same time there
   are instances - Alaska, for example - where central management appears
   to be working.
   In New England, my home, the experience with centralized management has
   been disastrous. All the important centrally managed fisheries are at or
   close to all time lows. Scientists who have been the principal advisors
   to the management process assure the public that their science is the
   best there is and that if managers had simply had the `political will'
   to follow their (the scientists') advice the fisheries of New England
   would be healthy and sustained(3).
   The fact that these scientists' models have not been validated against
   real world data has not caused these scientists to become in the least
   skeptical. But the performance of these models is the source of
   skepticism among fishermen. This skepticism has been a major
   contributing reason for decentralization, especially in the lobster
   fishery.},
Publisher = {I O S PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
