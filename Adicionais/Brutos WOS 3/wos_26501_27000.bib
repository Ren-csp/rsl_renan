Pages = {96-104},
Note = {13th International Conference on Harmonisation within Atmospheric
   Dispersion Modelling for Regulatory Purposes, Paris, FRANCE, JUN 01-05,
   2010},
Abstract = {This study relates NOx concentrations and wind (speed and direction)
   measured inside an asymmetric street canyon, with ambient wind. The
   monitoring site is located near a street intersection. The wind measured
   at the domestic airport located in the city, near the coast, has been
   considered as ambient wind. Wind direction at the monitoring site inside
   the canyon is mainly from the E, NE, W and NW for any ambient direction.
   In general, the behaviour of horizontal airflow at the monitoring site
   for different ambient wind directions seems to be quite similar to those
   observed at other street intersections reported in the literature.},
