@inproceedings{ WOS:000383223400166,
Author = {Song, Yang-Yu and Wang, Yan-Dan and Xue, Hui and Li, Shi-Yu and Yang,
   Hong-Mei and Chen, Zheng-Yao and Niu, Yan-Fen},
Editor = {Takahashi, M},
Title = {Efficacy and Economics of Sodium Turpentine Fungicides for Mosses and
   Lichens of Tea Tree in Xishuangbanna, Southwest China},
Booktitle = {PROCEEDINGS OF THE 2015 INTERNATIONAL CONFERENCE ON MEDICINE AND
   BIOPHARMACEUTICALS},
Year = {2016},
Pages = {1295-1303},
Note = {International Conference on Medicine and Biopharmaceuticals (ICMB),
   Guilin, PEOPLES R CHINA, AUG 15-16, 2015},
Abstract = {Tea yields in the southwest China are often reduced by the presence of
   mosses and lichens on tea tree (Camellia sinensis). This study was
   conducted to determine whether the application of sodium turpentine
   fungicides (STF) is an economically optimal management strategy. In a
   pilot experiment, three concentration gradients of STF were used and the
   amount of solution was 1.05t/ha for each gradient sprayed on tea tree to
   control mosses and lichens in the field, the area was 360 m(2) and was
   divided 9 plots (40 m2 for each plot). Then the STF concentration that
   had moderate control effect was applied for expansion tests, 5.9ha tea
   plantations were sprayed STF, and the mosses and lichens were
   investigated of 600 m2 among them. The results showed that the effects
   of fungicide treatment on tea tree varieties with differing doses levels
   were investigated. When the STF concentrations were 1.143\%, 0.857\%,
   0.714\%, the controlling effects were 98.72\%, 91.83\% and 83.61\%
   respectively. STF applied by spray method is a good measure in
   controlling mosses and lichens in tea plantations. Using the
   concentration of STF 0.857\% to conduct field expanding test resulted in
   a 0.9ton/ha yield increment and kept a 2834.7 +/- 1183.0 yuan/ha growth
   in economic incomes. Moreover, tea leaves and buds were not affected at
   all and tea trees were able to maintain normal growth and development.
   The control of mosses and lichens of tee trees could ensure a
   significant increase in regional tea production.},
