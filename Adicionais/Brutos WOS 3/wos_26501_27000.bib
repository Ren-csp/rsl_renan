@inproceedings{ WOS:000073221600061,
Author = {Armienta, MA and Rodriguez, R and Ceniceros, N and Cruz, O and Aguayo, A},
Editor = {Chilton, J},
Title = {Identification of the main source of chromium pollution from various
   potential sources},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {365-370},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {In Buenavista, south of Leon, Guanajuato, Mexico, hexavalent chromium
   concentrations up to 50 mg L-1 were detected in groundwater. A chromate
   factory with five different deposits of solid wastes, wastewater from
   two tanneries and fumes from the factory were identified as potential
   pollution sources. Chemical analyses of soils, aquifer material,
   groundwater and wastes were performed. The water table depth was
   measured in the wells exploited in the area and in five boreholes. One
   of the solid waste deposits was identified as the main source of
   chromium in the underlying groundwater. Secondary sources of chromium
   are irrigation with polluted water containing hexavalent chromium, and
   the fumes from the chromate factory. Tannery wastewater was not an
   important source of pollution of the groundwater in this area.},
