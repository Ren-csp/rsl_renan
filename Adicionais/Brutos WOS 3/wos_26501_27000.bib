Organization = {Soc Risk Anal Europe; Soc Risk Anal Japan; Korean Soc Environm Toxicol},
Abstract = {China is the world's largest paper producer. China's paper industry is
   inefficient in its consumption of natural resources. Whereas the
   proportion of wood pulp used by the paper industry in developed
   countries is up to 63\%, the corresponding figure for China is only 23\%
   leading to high energy consumption and severe environmental pollution.
   This paper presents a systematic analysis using life cycle assessment of
   the environmental risks and carbon footprints associated with the
   straw-pulp and wood-pulp paper industries in China. Risk prevention
   measures are proposed based on the results of this analysis. The study
   has important ramifications for the sustainable development of China's
   paper industry.},
