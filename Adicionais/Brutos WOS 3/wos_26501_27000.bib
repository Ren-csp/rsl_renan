@inproceedings{ WOS:000357835100033,
Author = {Galik, Slavomir and Lancosova, Viktoria},
Book-Group-Author = {SGEM},
Title = {DISINTEGRATION OF ``LINEAR CODE{''} IN COMMUNICATION ON THE INTERNET},
Booktitle = {PSYCHOLOGY AND PSYCHIATRY, SOCIOLOGY AND HEALTHCARE, EDUCATION, VOL II},
Series = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts},
Year = {2014},
Pages = {251-257},
Note = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts (SGEM 2014), Albena, BULGARIA, SEP 01-10, 2014},
Organization = {Bulgarian Acad Sci; Acad Sci Czech Republ; Latvian Acad Sci; Polish Acad
   Sci; Russian Acad Sci; Serbian Acad Sci \& Arts; Slovak Acad Sci Intro;
   Natl Acad Sci Ukraine; Natl Acad Sci Armenia; Sci Counc Japan; World
   Acad Sci TWAS; European Acad Sci, Arts \& Lett; Acad Fine Arts Zagreb
   Croatia; Croatian Acad Sci \& Arts; Acad Sci Moldova; Montenegrin Acad
   Sci \& Arts; Georgian Acad Sci; Acad Fine Arts \& Design Bratislava;
   Russian Acad Arts; Turkish Acad Sci; SGEM},
Abstract = {Communication on the Internet has brought a great number of changes in
   perception, imagination, thinking and learning in man. These changes are
   still spreading in the culture and society. One of the most important
   ones is surely disintegration of the so-called ``linear code{''}. By the
   term ``linear code{''} we mean structure of thinking and learning that
   is driven by succession of signs in thinking, in both learning and
   understanding of time and space. This sort of thinking and learning was
   shaped in the epoch of phonetic writing, but especially printing in
   Modem Times Europe. Writing and printing promoted perspective vision,
   psychological distance and abstract thinking, sequence of thinking, i.e.
   concentrated and continual development of ideas, and, apart of others,
   also the idea of linear time. Communication on the Internet needs to
   adapt itself to the ``fluid-like{''} and ``plastic-like{''} nature of
   the new medium. No more the Internet is a typical ``solid{''} medium,
   but as S. Harnad notices, ``the sky{''} to write on. Communication takes
   place in the so-called cyberspace, in which individual bits of
   information mix with each other, tie to each other and link to each
   other. Thus a net-like and non-linear array of information is created,
   which we also know under the term of hypertext. Our mind and language
   need to be modified for this form of communication, and the whole
   structure of thinking needs to be re-organised, succession of ideas to
   their non-linear composition. This promotes the so-called rhizomatic
   learning, which is individual and net-like structure of knowledge. In
   this kind of thinking and learning is a hidden risk of subjective and
   even virtual structure of knowledge. Disintegration of linear code in
   communication on the Internet manifests itself for example in change of
   comprehending time, which can be characterised as simultaneous (present)
   and which also affects change of understanding tradition as a part of
   culture. Disintegration of linear code in communication on the Internet
   brings some new possibilities, but also risks. The possibilities are
   represented by, for example, using the so-called ``collective
   intelligence{''} and the risks by creation of subjective and virtual
   knowledge and loss of sense of the past and tradition. It is therefore
   necessary to realise positives and negatives of communication on the
   Internet and learn to apply psychological distance and critical
   thinking.},
Publisher = {STEF92 TECHNOLOGY LTD},
Address = {1 ANDREY LYAPCHEV BLVD, SOFIA, 1797, BULGARIA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Gálik, S (Corresponding Author), Univ SS Cyril \& Methodius, Fac Mass Media Commun, Nam J Herdu 2, Trnava 91701, Slovakia.
   Galik, Slavomir; Lancosova, Viktoria, Univ SS Cyril \& Methodius, Fac Mass Media Commun, Trnava 91701, Slovakia.},
