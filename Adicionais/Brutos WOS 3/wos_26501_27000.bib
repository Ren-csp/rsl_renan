@article{ WOS:000185829200004,
Author = {Scott, KI and Benjamin, MT},
Title = {Development of a biogenic volatile organic compounds emission inventory
   for the SCOS97-NARSTO domain},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2003},
