@article{ WOS:A1992HG63700007,
Author = {ALDERMAN, N and FISCHER, MM},
Title = {INNOVATION AND TECHNOLOGICAL-CHANGE - AN AUSTRIAN-BRITISH COMPARISON},
Journal = {ENVIRONMENT AND PLANNING A},
