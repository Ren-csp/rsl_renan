@article{ WOS:000399358300129,
Author = {Wareerat, Kaewurai and Rujroad, Kaewurai and Skonchai, Chanunan and
   Wanintorn, Supap and Sureeporn, Sawangmek},
Title = {The Development of the Teachers' Researcher Network to Create
   Instructional Innovation for Raising Students' Learning Achievement in
   Science and Mathematics, Thailand},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {12, SI},
Pages = {4514-4518},
Month = {DEC},
Note = {Advancement on Informatics, Business and Management International
   Conference (AIBMIC), Bandung, INDONESIA, MAY 31-JUN 02, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {The main objective of this research is to develop a model of teachers'
   researcher network to create instructional innovation for raising
   students' learning achievement in science and mathematics at the
   secondary education level. The research followed the participatory
   action research as the followings steps: (1) the construction of the
   model (2) the study of the effectiveness of the model. The target groups
   were classified into 3 groups as follows: (1) 110 teachers from
   mathematics, science, physics, chemistry and biology subjects in
   secondary schools (2) 5 educational supervisors and (3) 6 teacher
   education lecturers and 3 science university lecturers as researcher
   team. The results revealed that the model of teachers' researcher
   network was developed and consisted of 5 important processes as follows:
   (1) the paradigm shift of teacher's perceptions toward the classroom
   action research (2) the situation analysis to delegate responsibility to
   work together as a learning community network (3) both the innovation of
   teaching and the classroom action research to raise students learning
   achievement was considered as teachers' collaborative and mutual
   responsibility (4) the monitoring, evaluating and reviewing and (5)
   sharing and reviewing the work. Stakeholders and educational specialists
   approved that the model of the teachers' researcher network which was
   systematically constructed consisted of suitability and possibility for
   implementation. (2) The teachers' researcher network had strengths in
   cooperation level and the effectiveness of the teachers' researcher
   network consisted of (2.1) the competencies of teacher as researcher
   were in high level (2.2) there were 84 numbers for the results of the
   instructional innovations from this project. The highlight of the
   instructional innovations for raising students' learning achievement was
   counted as 100 percent by focusing on developing students to have the
   learning processes based on 5 basic steps (2.3) the teachers' researcher
   network had demonstrated 84 classroom action researches which were
   counted as 77 percent from overall teachers' researcher network.},
