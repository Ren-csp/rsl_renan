Title = {Assessment and forecast of groundwater and rock contamination within the
   Kyiv industrial agglomeration influenced by Chernobyl fallout},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {171-174},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Results of recently obtained measurements and modelling balance
   assessments are presented for groundwater and water-bearing rocks
   contaminated by Chernobyl Cs-137 and Sr-90 within the Kyiv Industrial
   Agglomeration (KIA). Results show that existing and forecasted
   groundwater and rock contamination may be explained by the existence of
   fast migration pathways in conditions of high downward infiltration
   velocities in the KIA region induced by intensive prolonged exploitation
   of deep aquifers fbr water supply. Nevertheless the water-bearing rocks
   in the upper zone of intensive vertical water exchange, owing to their
   high sorption capacity, remain a powerful protection buffer within the
   biosphere.},
