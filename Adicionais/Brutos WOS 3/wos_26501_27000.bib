   RS and Achambault, C and Marfin, AA and Peterson, LR},
Editor = {White, DJ and Morse, DL},
Title = {West Nile virus serosurvey and assessment of personal prevention efforts
   in an area with intense epizootic activity: Connecticut, 2000},
Booktitle = {WEST NILE VIRUS: DETECTION, SURVEILLANCE, AND CONTROL},
Series = {Annals of the New York Academy of Sciences-Series},
