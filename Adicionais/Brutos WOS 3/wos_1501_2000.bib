@article{ WOS:000242792000003,
Author = {Li, Chao},
Title = {User preferences, information transactions and location-based services:
   A study of urban pedestrian wayfinding},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
