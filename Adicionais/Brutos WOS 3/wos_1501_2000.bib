Title = {A RE-EXAMINATION OF THE ATTRIBUTION-EMOTION-BEHAVIOR FRAMEWORK IN THE
   CONTEXT OF UNETHICAL BEHAVIOR},
Booktitle = {EMOTIONS, ETHICS AND DECISION-MAKING},
Series = {Research on Emotion in Organizations},
Year = {2008},
