@article{ WOS:000072694600006,
Author = {Brakenhielm, S and Liu, Q},
Title = {Long-term effects of clear-felling on vegetation dynamics and species
   diversity in a boreal pine forest},
Journal = {BIODIVERSITY AND CONSERVATION},
Year = {1998},
