Author = {Obolenskaya, A. G. and Rudenkin, D. V. and Blinova, O. A.},
Editor = {Sheridan, S and Veraksa, N},
Title = {TEENAGERS' VANDAL ACTIVITY IN THE INTERNET ENVIRONMENT: FREQUENCY,
   TYPES, RISKS AND OPPORTUNITIES},
