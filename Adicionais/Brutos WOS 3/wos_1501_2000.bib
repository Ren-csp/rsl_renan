@inproceedings{ WOS:000257704900033,
Author = {Carinanos, P. and Galan, C. and Alcazar, P. and Dominguez, E.},
Editor = {Kungolos, A and Zamorano, M},
Title = {Classification, analysis and interaction of solid airborne particles in
   urban environments},
Booktitle = {ENVIRONMENTAL TOXICOLOGY II},
