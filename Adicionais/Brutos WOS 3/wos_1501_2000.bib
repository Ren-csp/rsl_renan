@article{ WOS:A1996VN11000044,
Author = {Glazewski, R and Morrison, GM},
Title = {Copper(I)/copper(II) reactions in an urban river},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1996},
Volume = {189},
Pages = {327-333},
