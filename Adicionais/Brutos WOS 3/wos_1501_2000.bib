@article{ WOS:000186400500010,
Author = {Kang, SM and Shaver, PR and Sue, S and Min, KH and Jing, HB},
Title = {Culture-specific patterns in the prediction of life satisfaction: Roles
   of emotion, relationship quality, and self-esteem},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {2003},
Volume = {29},
Number = {12},
Pages = {1596-1608},
