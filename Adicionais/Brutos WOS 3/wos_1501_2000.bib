@inproceedings{ WOS:000387671800014,
Author = {Tomao, Antonio and Secondi, Luca and Corona, Piermaria and Carrus,
   Giuseppe and Agrimi, Mariagrazia},
Editor = {Menghini, S and Pfoestl, E and Marinelli, A},
Title = {Exploring individuals' well-being visiting urban and peri-urban green
   areas: a quantile regression approach},
Booktitle = {FLORENCE `SUSTAINABILITY OF WELL-BEING INTERNATIONAL FORUM', 2015: FOOD
   FOR SUSTAINABILITY AND NOT JUST FOOD, FLORENCESWIF2015},
Series = {Agriculture and Agricultural Science Procedia},
Year = {2016},
