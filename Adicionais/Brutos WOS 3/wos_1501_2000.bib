Year = {2024},
Pages = {206-209},
Note = {12th International Conference on e Health and Bioengineering, Iasi,
   ROMANIA, NOV 14-15, 2024},
Abstract = {Face Emotions Recognition (FER) systems are becoming increasingly
   performant, benefiting from developments in computer vision and deep
   learning techniques. In this paper, a deep convolutional neural network
   (DCNN) model is proposed for classifying facial expressions into three
   primary emotion categories: positive, neutral, and negative. The
   designed custom architecture integrates residual connections, which
   enhance the model's ability to generalize by effectively retaining
   learned features across layers. The proposed model achieves an average
   accuracy of 92.16\%, demonstrating good performances in discriminating
   between data from each targeted class. The FER2013 and its curated
   version, FER Plus, datasets were employed for training and testing
   different models. A new subset of FER Plus was created for model
   training and testing. Various preprocessing techniques were applied,
   including data normalization, augmentation and class balancing.},
