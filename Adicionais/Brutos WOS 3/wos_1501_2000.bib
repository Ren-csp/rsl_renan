@article{ WOS:000256490100015,
Author = {van Riel, Raphael},
Title = {On how we perceive the social world.: Criticizing Gallagher's view on
   direct perception and outlining an alternative},
Journal = {CONSCIOUSNESS AND COGNITION},
Year = {2008},
Volume = {17},
Number = {2},
