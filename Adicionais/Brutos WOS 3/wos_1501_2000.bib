@inproceedings{ WOS:000392265900064,
Author = {Ivankina, Lubov and Mihalchuk, Alexander and Arefiev, Vladimir and
   Filipenko, Nikolay and Novoseltseva, Darya},
Editor = {Casati, F and Barysheva, GA and Krieger, W},
Title = {Multidimensional Statistical Analysis of Life Satisfaction of Older
   People},
Booktitle = {III INTERNATIONAL SCIENTIFIC SYMPOSIUM ON LIFELONG WELLBEING IN THE
   WORLD (WELLSO 2016)},
