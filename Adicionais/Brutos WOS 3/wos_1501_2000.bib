@inproceedings{ WOS:000467120500008,
Author = {Xiang, Peng Cheng and Wang, Yi Ming and Deng, Qing},
Editor = {Brebbia, CA and Longhurst, J and Marco, E and Booth, C},
Title = {RESEARCH ON URBAN RENEWAL FROM THE PERSPECTIVE OF NATURAL DISASTER
   VULNERABILITY},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2018},
Volume = {226},
Pages = {85-93},
Note = {9th International Conference on Sustainable Development and Planning,
   Bristol, ENGLAND, 2017},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm; Int Journal
   Sustainable Dev \& Planning; Univ W England},
Abstract = {At present, economic development has become a dominant factor in the
   promotion of urban renewal in China. This means that decision-makers
   often overlook the impact of the natural environment on the urban
   renewal of the region. This paper begins with a review of the literature
   concerning urban renewal and natural disaster vulnerability in order to
   discuss the mechanism of interaction between natural disasters and urban
   renewal. Then, an evaluation model of natural disaster vulnerability in
   urban areas is constructed, and a DEA model is used to assess the
   vulnerability of natural disasters in various regions of a city.
   Finally, using the idea of regional planning, this paper puts forward a
   method for urban renewal, taking natural disaster factors into
   consideration, and provides an important direction for urban renewal in
   order to realize the sustainable development of cities. The findings of
   this paper substantiate the phenomenon that, at this stage, urban
   renewal has brought many problems. Although urban renewal enhances the
   city's resilience to natural disasters, understanding how to assess the
   vulnerability of natural disasters in all regions of the city has been a
   challenge and should be part of an integrated planning approach. This
   paper puts forward the countermeasure of urban renewal against the
   background of natural disaster, from the perspective of sustainable
   development.},
