@inproceedings{ WOS:000380531900031,
Author = {Nguyen Hoang Khanh Linh and Huynh Van Chuong},
Editor = {Schreier, G and Skrovseth, PE and Staudenrausch, H},
Title = {ASSESSING THE IMPACT OF URBANIZATION ON URBAN CLIMATE BY REMOTE SENSING
   PERSPECTIVE: A CASE STUDY IN DANANG CITY, VIETNAM},
Booktitle = {36TH INTERNATIONAL SYMPOSIUM ON REMOTE SENSING OF ENVIRONMENT},
Series = {International Archives of the Photogrammetry Remote Sensing and Spatial
   Information Sciences},
Year = {2015},
