@inproceedings{ WOS:001428717000029,
Author = {Xu, Fujie and Yang, Huamin and Hu, Ying},
Editor = {Ling, Z and Chen, X and Hamdulla, A and He, L and Li, Y},
Title = {DA-KWFormer: A Domain Adaptation Network with K-Weight Transformer for
   Speech Emotion Recognition},
