@inproceedings{ WOS:000179444800092,
Author = {Calvagna, S and Balla, A},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {A Mediterranean housing model in Catania: Spontaneous installation on
   urban volcanic ground},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {745-752},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The location for the case study is the city of Catania, at the foot of
   the Mount Etna volcano. As a result of its location, the study takes
   into consideration the relationship to the volcano, either as
   ``ground{''} or as a construction material with particular physical and
   mechanical properties.
   Starting from the typological analysis of the site (formed by one of the
   different sciare (1) which took shape in Catania after the city's
   reconstruction on the lava flow of 1669), it has been possible to
   characterize different families of cases studies in relation to their
   consistency, their way of forming aggregations and their relation to the
   street front.
   The characteristics of the habitat model which have been developed are:
   <<Introverted>> Space: the houses converge towards central focal points
   of patios and inner courtyards;
   Ventilation and Natural Cooling: are obtained by a good distribution of
   interior spaces and a judicious North or South aspect;
   The Construction Spontaneity (Auto-Construction): analysis and
   formalizing of housing habits, spontaneous and non programmed
   construction of little volumes;
   Relation to the Lava-Ground and Public Space: the study of the site
   gives rise to the relation with the habitation. The hybrid space of the
   public dimension face the private dimension of the habitat.},
