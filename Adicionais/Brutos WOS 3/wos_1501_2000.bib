@article{ WOS:000246948800001,
Author = {Kashdan, Todd B. and Volkmann, Jeffrey R. and Breen, William E. and Han,
   Susan},
Title = {Social anxiety and romantic relationships: The costs and benefits of
   negative emotion expression are context-dependent},
