Organization = {Shanghai Univ Elect Power; Shanghai Normal Univ},
Abstract = {A lot of the elements work in the urban waterfront. However each element
   effects separately and the developing models are often monotony. The
   restriction of zoning and the subdivision of specialties may cause the
   problems. This paper points out that the integrative organization among
   elements is necessary in waterfronts developments, the moderate
   opening-up of control and the organic integration of urban design is the
   main approach to solve the problem. The paper also try to provide some
   specific measures.},
