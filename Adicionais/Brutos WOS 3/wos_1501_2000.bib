Author = {Zhang, Zhiming and Cui, Baoshan and Fang, Fengman and Fan, Xiaoyun and
   Zhang, Honggang},
Editor = {Yang, Z and Chen, B},
Title = {Multifractal analysis to characterize urban surface dust volume-size
   distribution},
Booktitle = {18TH BIENNIAL ISEM CONFERENCE ON ECOLOGICAL MODELLING FOR GLOBAL CHANGE
   AND COUPLED HUMAN AND NATURAL SYSTEM},
Series = {Procedia Environmental Sciences},
Year = {2012},
