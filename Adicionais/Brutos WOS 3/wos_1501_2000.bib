@article{ WOS:000284926400004,
Author = {Beets, I. A. M. and `t Hart, B. M. and Rosler, F. and Henriques, D. Y.
   P. and Einhauser, W. and Fiehler, K.},
Title = {Online action-to-perception transfer: Only percept-dependent action
   affects perception},
Journal = {VISION RESEARCH},
Year = {2010},
Volume = {50},
