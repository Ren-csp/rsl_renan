   Arizona State Univ, Dept Plant Biol, Tempe, AZ 85287 USA.},
DOI = {10.1016/S0269-7491(01)00246-9},
ISSN = {0269-7491},
EISSN = {1873-6424},
Keywords = {urbanization; carbon dioxide; soil CO2 efflux; geographic information
   systems (GIS); land-use},
