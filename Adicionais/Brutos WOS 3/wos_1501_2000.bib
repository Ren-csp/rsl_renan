Title = {Urban groundwater issues - An introduction},
Booktitle = {CURRENT PROBLEMS OF HYDROGEOLOGY IN URBAN AREAS, URBAN AGGLOMERATES AND
   INDUSTRIAL CENTRES},
Series = {NATO Science Series IV-Earth and Environmental Sciences},
Year = {2002},
