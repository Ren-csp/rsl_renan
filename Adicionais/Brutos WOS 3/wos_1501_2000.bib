@inproceedings{ WOS:000314156500011,
Author = {Peart, Frances M. and Roan, Amanda M. and Ashkanasy, Neal M.},
Editor = {Ashkanasy, NM and Hartel, CEJ and Zerbe, WJ},
Title = {TRADING IN EMOTIONS: A CLOSER EXAMINATION OF EMOTIONAL LABOR},
Booktitle = {EXPERIENCING AND MANAGING EMOTIONS IN THE WORKPLACE},
Series = {Research on Emotion in Organizations},
Year = {2012},
