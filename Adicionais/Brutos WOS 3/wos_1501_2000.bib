Editor = {LaRosa, D and Privitera, R},
Title = {Urban and Peri-Urban Agriculture as a Nature-Based Solution to Support
   Food Supply, Health and Well-Being in Bucharest Metropolitan Area During
   the COVID-19 Pandemic},
