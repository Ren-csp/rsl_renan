Title = {ECOLOGICAL ROUTES AS FACTOR OF ECOLOGICAL CULTURE DEVELOPMENT IN URBAN
   SPACE},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
