Title = {Emotion Recognition for Romanian Language Using MFSC Images with
   Deep-Learning Neural Networks},
Booktitle = {2021 INTERNATIONAL CONFERENCE ON E-HEALTH AND BIOENGINEERING (EHB 2021),
   9TH EDITION},
Series = {E-Health and Bioengineering Conference},
Year = {2021},
Note = {9th IEEE International Conference on e-Health and Bioengineering (EHB),
   Grigore T Popa Univ Med \& Pharmacy, ELECTR NETWORK, NOV 18-19, 2021},
Organization = {IEEE; Grigore T Popa Univ Med \& Pharmacy, Fac Med Bioengineering; SRBM;
   IEEE Romanian Sect; IEEE EMB; IEEE Romania Sect; Inst Informatica
   Teoretica; Romanian Soc Med Bioengineering; Romanian Acad, Iasi Branch,
   Inst Comp Sci; IEEE EMB Romania Chapter; IEEE EMC Romania Chapter; IEEE
   Signal Proc Romania Chapter; IEEE SMC Romania Chapter},
Abstract = {The objective of this paper is to study the emotion recognition for the
   Romanian language using MFSC images (Mel Frequency Spectral
   Coefficients) with DL-NN (Deep Learning Neural Networks). We obtained an
   accuracy of 85\%, which is comparable to those reported by other
   researchers The emotions analyzed in this study are happiness, sadness,
   fury and neutral tone. The emotion recognition was tested in two cases:
   low and increased resolution MFSC images. We noticed that the MFSC
   images with higher resolution give better results. We have tested
   several architectures of DL-CNN (Convolutional Neural Network), but the
   best results were obtained when the network contains two autoencoder
   layers. We varied the number of neurons in these autoencoders in order
   to improve the emotion recognition accuracy for low / high resolution
   MFSC images.},
