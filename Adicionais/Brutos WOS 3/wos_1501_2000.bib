@article{ WOS:000222203600012,
Author = {Sullivan, WC and Anderson, OM and Lovell, ST},
Title = {Agricultural buffers at the rural-urban fringe: an examination of
   approval by farmers, residents, and academics in the Midwestern United
   States},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2004},
