Title = {EMOTION REGULATION STRATEGIES AS INDICATORS OF IMPULSES CONTROL,
   ENGAGING GOALS - DIRECTED AND WELL BEING IN YOUNG PEOPLE},
Booktitle = {PROSPECTING ADVANCED RESEARCH IN HEALTH, EDUCATION AND SOCIAL SCIENCES},
Year = {2011},
