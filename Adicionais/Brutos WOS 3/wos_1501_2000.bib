Title = {The study of the Urban Heat Island effect in Cyprus using Google Earth
   Engine for 2013-2023},
Booktitle = {TENTH INTERNATIONAL CONFERENCE ON REMOTE SENSING AND GEOINFORMATION OF
   THE ENVIRONMENT, RSCY 2024},
