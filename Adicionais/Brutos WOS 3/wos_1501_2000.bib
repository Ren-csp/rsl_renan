@inproceedings{ WOS:001264250100042,
Author = {Garau, Chiara and Annunziata, Alfonso and Desogus, Giulia and Rossetti,
   Silvia},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti, L},
Title = {Spatial Smartness and (In)Justice in Urban Contexts? The Case Studies of
   Cagliari and Parma, Italy},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 2, INPUT 2023},
Series = {Lecture Notes in Civil Engineering},
Year = {2024},
Volume = {463},
