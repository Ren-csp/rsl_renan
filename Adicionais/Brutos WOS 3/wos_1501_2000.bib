@inproceedings{ WOS:000874361900046,
Author = {Vicente-Querol, Miguel A. and Fernandez-Caballero, Antonio and Molina,
   Jose P. and Gonzalez, Pascual and Gonzalez-Gualda, Luz M. and
   Fernandez-Sotos, Patricia and Garcia, Arturo S.},
Editor = {Vicente, JMF and Alvarez-Sanchez, JR and Lopez, FD and Adeli, H},
Title = {Influence of the Level of Immersion in Emotion Recognition Using Virtual
   Humans},
Booktitle = {ARTIFICIAL INTELLIGENCE IN NEUROSCIENCE: AFFECTIVE ANALYSIS AND HEALTH
   APPLICATIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13258},
