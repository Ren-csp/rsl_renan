@inproceedings{ WOS:000223250200021,
Author = {Ippolito, L and Siano, P},
Editor = {Wadhwa, LC},
Title = {An agent-based architecture for urban transportation systems},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2004},
Volume = {16},
Pages = {203-215},
Note = {10th International Conference on Urban Transport and the Environment in
   the 21st Century, Dresden, GERMANY, MAY 19-21, 2004},
Organization = {Wessex Inst Technol; Advances Transport Book Series},
Abstract = {Today, transport networks, because of increased density in urban
   population centers, are affected by more and more congested traffic
   which produces economic, social and political problems quantifiable in
   terms of fuel economy, pollution and increased level of stress due to
   bad service quality.
   Telematic infrastructures combined with automotive technology, by
   improving the operational efficiency of urban transport systems, can
   reduce the environmental and economic impacts. In this paper a
   Multi-Agent System (MAS) is proposed in order to manage a modem bus
   fleet equipped with sensors and communication devices. The `multi-agent
   approach adapts well to describe complex systems characterized by
   geographical and functional distribution like transport networks where
   many. subsystems with different dynamics and autonomy interact and for
   which real time control, high adaptivity and robustness are essential
   requirements.
