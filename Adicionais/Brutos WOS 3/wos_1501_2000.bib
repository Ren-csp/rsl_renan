@article{ WOS:A1996UF45900003,
Author = {Borod, JC and Rorie, KD and Haywood, CS and Andelman, F and Obler, LK
   and Welkowitz, J and Bloom, RL and Tweedy, JR},
Title = {Hemispheric specialization for discourse reports of emotional
   experiences: Relationships to demographic, neurological, and perceptual
   variables},
