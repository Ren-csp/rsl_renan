@article{ WOS:000350887500011,
Author = {Kerschbaumer, A. and Lutz, M.},
Title = {Origin and influence of PM10 in urban and in rural
   environments},
Journal = {ADVANCES IN SCIENCE AND RESEARCH},
Year = {2008},
Volume = {2},
Pages = {53-55},
Note = {7th Annual Meeting of the European-Meteorology-Society (EMS) / 8th
   European Conference on Applications of Meteorology, San Lorenzo de El
   Escorial, SPAIN, OCT 01-05, 2007},
Organization = {European Meteorol Soc},
Abstract = {The paper presents an estimate of emission source influence on PM10
   concentrations in Berlin. Particulate matter less than 10 mu m in
   aerodynamic diameter (PM10) is a conglomerate of different chemical
   components related to distinct sources and physico-chemical processes in
   the atmosphere and lithosphere. Emission reduction thus has temporally
   and spatially varying effects on different scales. Urban PM10
   concentrations are heavily influenced by long range transport (up to
   70\%) from remote source areas, whereas rural air pollution is strongly
   determined by urban emissions. By means of emission reduction scenario
   simulations with a chemistry-transport-model it has been found that on
   average two third of the urban background concentrations in Berlin are
   due to Berlin-specific emissions. This percentage varies strongly
   considering primary and secondary components: only about 5\% of
   secondary PM10 concentrations are related to local emissions, while
   approximately 70\% of primary concentrations stem from the urban
   sources. City related emissions influence homogenously the rural
   air-pollution concentrations, but with different ranges of influence.},
