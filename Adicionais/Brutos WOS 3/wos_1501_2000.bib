@inproceedings{ WOS:000664335304069,
Author = {Hou, Ankai and Zhu, Mingcang and Li, Pengshan and He, Yong and Zhang,
   Xiaobo and Shi, Jibao and Chen, Kai and Weng, Tao and Zheng, Zezhong and
   Zhou, Guoqing},
Book-Group-Author = {IEEE},
Title = {INFERENCE OF URBAN FUNCTION ZONE BASED ON DEEP NEURAL NETWORK},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
Series = {IEEE International Symposium on Geoscience and Remote Sensing IGARSS},
