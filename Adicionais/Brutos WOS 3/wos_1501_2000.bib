@article{ WOS:000225295900035,
Author = {Moreno, T and Jones, JP and Richards, RJ},
Title = {Characterisation of aerosol particulate matter from urban and industrial
   environments: examples from Cardiff and Port Talbot, South Wales, UK},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
