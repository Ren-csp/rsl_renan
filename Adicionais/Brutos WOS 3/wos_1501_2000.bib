@inproceedings{ WOS:000389054900002,
Author = {Sadkova, Tereza and Dostal, Daniel},
Editor = {Maierova, E and Viktorova, L and Dolejs, M},
Title = {CAN ORAL CONTRACEPTIVES CAUSE A DECREASE IN THE ACCURACY AND SPEED OF
   RECOGNITION OF FACIAL EXPRESSIONS OF EMOTIONS? FALSE ALARM},
Booktitle = {PHD EXISTENCE 2016: CZECH AND SLOVAK PSYCHOLOGICAL CONFERENCE},
Year = {2016},
Pages = {19-24},
Note = {6th PhD Existence Conference- Czech and Slovak Psychological Conference
   (Not Only) for Postgraduates and about Postgraduates, Olomouc, CZECH
   REPUBLIC, FEB 08-09, 2016},
Organization = {Univ Palackeho Olomouci, Filozoficka Fakulta, Katedra Psychologie},
Abstract = {Combined oral contraceptives (COC) are believed to cause many effects -
   from the desired ones (their use as a birth control method) to the
   speculative ones (e.g. weight gain). Here we present re-designed
   research focusing on the possible link between COC and the recognition
   of facial expressions of emotions. In our study we examined 201 women,
   including 90 users of COC and 106 non-users. To examine the possible
   effect of COC usage on the accuracy and speed of the recognition of
   facial expressions of emotion and control the intervening variables
   included in our research design, we used the hierarchical regression
   model. Statistical analysis proved no effect of COC usage on the
   recognition of facial expressions of emotions.},
