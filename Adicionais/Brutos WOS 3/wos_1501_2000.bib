@inproceedings{ WOS:001264250100035,
Author = {Carpentieri, Gerardo and Gargiulo, Carmela and Guida, Carmen and Zucaro,
   Floriana},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti, L},
Title = {Energy-Saving and Urban Planning: An Application of Integrated Spatial
   and Statistical Analyses to Naples},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 2, INPUT 2023},
