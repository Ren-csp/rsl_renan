@article{ WOS:000222401500043,
Author = {Piriou, P and Mackey, E and Suffet, IH and Bruchet, A},
Title = {Chlorinous flavor perception in drinking water},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2004},
Volume = {49},
Number = {9},
Pages = {321-328},
Note = {6th International Symposium on Off-Flavours in the Aquatic Environment,
   Barcelona, SPAIN, OCT 07-10, 2002},
Abstract = {Chlorinous flavors at the tap are the leading cause of customers'
   complaints and dissatisfaction with drinking water. To characterize
   consumer perception and acceptance to chlorinous tastes, extensive taste
   testing was performed with both trained panelists and average consumers.
   Taste testing with trained panelists showed that chlorine perception is
   underestimated by disinfectant flavor thresholds reported in the
   literature. However, trained panelists significantly overestimate the
   average consumer's ability to perceive chlorine. In addition, consumer
   perception seems to be influenced by the chlorination practices of the
   country they live in. Among water quality characteristics that may
   influence chlorine perception, temperature was not found to induce any
   significant change. The influence of total dissolved solids (TDS) on
   chlorine perception remains unclear and, as reported elsewhere,
   background tastes such as musty, may significantly impact chlorine
   threshold.},
