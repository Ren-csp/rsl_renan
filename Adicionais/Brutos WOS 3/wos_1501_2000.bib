@inproceedings{ WOS:000392856300031,
Author = {Dhakal, Krishna P. and Chevalier, Lizette R.},
Editor = {Karvazy, K and Webster, VL},
Title = {Implementing Low Impact Development in Urban Landscapes: A Policy
   Perspective},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2015: FLOODS, DROUGHTS,
   AND ECOSYSTEMS},
Year = {2015},
Pages = {322-333},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {Low Impact Development (LID) is a strategically sound approach to
   mitigate stormwater pollution and restore landscape hydrology in
   urbanized watersheds. Since it promotes preserving and enhancing
   vegetation, open spaces, and soil integrity to mimic natural processes,
   it provides a myriad of benefits including flood control, habitat
   protection, climate change mitigation and adaptation, greater
   livability, greater social connectivity, energy savings, smog reduction,
   enhanced community aesthetics, and many other ecosystem services. A
   great number of LID tools are available such as green roofs,
   raingardens, tree planters, bio swales, which are efficient, simple, and
   cost effective. Some pioneer cities are successfully implementing this
   technology in development and redevelopment projects. However, a wide
   spread adoption has not occurred.
   This paper explores the barriers prevailing in the U.S. cities, with a
   focus on legal and policy aspects. The analysis will focus on the city
   codes, ordinances, regulations, and other legal and policy documents
   related to stormwater and other land development activities of select
   cities. Finally a policy framework conducive to LID implementation will
   be presented.},
