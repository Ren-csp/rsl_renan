Note = {International Conference on Environmental Science and Engineering (ESE),
   Guilin, PEOPLES R CHINA, APR 15-17, 2016},
Abstract = {With the driving of high development of urbanization, water resource and
   environment of urban has been abstracting the attention of the public.
   The paper presents the Society-Economy-Water pollution-Water resource
   reaction model of Fushun and simulated the change of water environment
   and resource of Fushun from 2004 to 2025 by software Vensim PLE based on
   collection of data. The research showed that water pollution of Fushun
   would increase by years, threaten the health of multi-ecosystem of urban
   and use the sustainable development policy that include the reduce the
   pollution, retreat the pollution to accelerate the development of
   society, economy and water resource.},
