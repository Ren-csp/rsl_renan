@article{ WOS:000189138700001,
Author = {Gibb, BE and Abramson, LY and Alloy, LB},
Title = {Emotional maltreatment from parents, verbal peer victimization, and
   cognitive vulnerability to depression},
Journal = {COGNITIVE THERAPY AND RESEARCH},
Year = {2004},
