@article{ WOS:000220461700008,
Author = {Epitropaki, O and Martin, R},
Title = {Implicit leadership theories in applied settings: Factor structure,
   generalizability, and stability over time},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2004},
Volume = {89},
Number = {2},
Pages = {293-310},
Month = {APR},
Note = {Conference of the Society-of-Industrial-and-Organizational-Psychology
   (SIOP), New Orleans, LA, APR, 2000},
Organization = {Soc Ind Org Psychol (SIOP)},
Abstract = {The present empirical investigation had a 3-fold purpose: (a) to
   cross-validate L. R. Offermann, J. K. Kennedy, and P. W. Wirtz's (1994)
   scale of Implicit Leadership Theories (ILTs) in several organizational
   settings and to further provide a shorter scale of ILTs in
   organizations; (b) to assess the generalizability of ILTs across
   different employee groups, and (c) to evaluate ILTs' change over time.
   Two independent samples were used for the scale validation (N-1 = 500
   and N-2 = 439). A 6-factor structure (Sensitivity, Intelligence,
   Dedication, Dynamism, Tyranny, and Masculinity) was found to most
   accurately represent ILTs in organizational settings. Regarding the
   generalizability of ILTs, although the 6-factor structure was consistent
   across different employee groups, there was only partial support for
   total factorial invariance. Finally, evaluation of gamma, beta, and
   alpha change provided support for ILTs' stability over time.},
