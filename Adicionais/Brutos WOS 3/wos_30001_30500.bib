@article{ WOS:000245148700003,
Author = {Trofimovich, Pavel and Baker, Wendy},
Title = {Learning prosody and fluency characteristics of second language speech:
   The effect of experience on child learners' acquisition of five
   suprasegmentals},
Journal = {APPLIED PSYCHOLINGUISTICS},
Year = {2007},
Volume = {28},
Number = {2},
Pages = {251-276},
Month = {APR},
Note = {5th International Symposium on Bilingualism, Barcelona, SPAIN, MAR
   20-23, 2005},
Abstract = {This study examined second language (L2) experience effects on
   children's acquisition of fluency(speech rate, frequency, and duration
   of pausing) and prosody-based (stress timing, peak alignment)
   suprasegmentals. Twenty Korean children (age of arrival in the United
   States = 7-11 years, length of US residence = I vs. I I years) and 20
   age-matched English monolinguals produced six English sentences in a
   sentence repetition task. Acoustic analyses and listener judgments were
   used to determine how accurately the suprasegmentals were produced and
   to what extent they contributed to foreign accent. Results indicated
   that the children with I I years of US residence, unlike those with I
   year of US residence, produced all but one (speech rate) suprasegmentals
   natively. Overall, findings revealed similarities between L2 segmental
   and suprasegmental learning.},
