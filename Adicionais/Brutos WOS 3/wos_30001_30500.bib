@article{ WOS:000182445000004,
Author = {Kim, Y and Valdimarsdottir, HB and Bovbjerg, DH},
Title = {Family histories of breast cancer, coping styles, and psychological
   adjustment},
Journal = {JOURNAL OF BEHAVIORAL MEDICINE},
Year = {2003},
Volume = {26},
Number = {3},
Pages = {225-243},
Month = {JUN},
Note = {60th Annual Meeting of the American-Psychosomatic-Society, BARCELONA,
   SPAIN, MAR, 2002},
Organization = {Amer Psychosomat Soc},
Abstract = {Although women with family histories of breast cancer (FHBC+) have been
   reported to have higher levels of cancer-specific and general distress
   than have women without such histories (FHBC-), there has been
   considerable variability in levels of distress found. This study
   examined individual differences in the use of coping strategies as
   likely moderators of the relationship between FHBC and psychological
   outcomes. One hundred and sixteen healthy women (47 FHBC+ and 69 FHBC-)
   participated. Results revealed that passive coping style was associated
   with higher levels of cancer-specific distress among FHBC+, but not
   among FHBC-. This interaction was not found for negative or positive
   affect. The passive coping style was associated with higher levels of
   negative affect across both groups. These results suggest that passive
   coping has negative implications for FHBC+ women and imply that
   individualized coping training programs targeting this coping strategy
   may prove useful for these women.},
