@article{ WOS:000175638100003,
Author = {Williams, EN and Hill, CE},
Title = {Evolving connections: Research that is relevant to clinical practice},
Journal = {AMERICAN JOURNAL OF PSYCHOTHERAPY},
Year = {2001},
Volume = {55},
Number = {3},
Pages = {336-343},
Note = {108th Annual Meeting of the American-Psychological-Association,
   WASHINGTON, D.C., AUG 04-08, 2000},
Organization = {Amer Psychol Assoc},
Abstract = {Although in the past some clinicians have not found psychotherapy
   research to be valuable, we assert that things have changed.
   Specifically, current research tends to be more sensitive to clinicians'
   concerns and uses methodologies that more accurately capture the
   complexity of the therapeutic endeavor than previous research,
   Additionally, research has provided some surprising (and sometimes
   counterintuitive) findings that suggest that practical experience may
   not always provide the most accurate information for the practitioner,
   The purpose of The current paper is to provide examples of research
   findings that may be useful to practitioners in their clinical work.},
