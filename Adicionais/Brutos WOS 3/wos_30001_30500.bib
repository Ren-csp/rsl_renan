@article{ WOS:000229032900006,
Author = {Horst, JS and Oakes, LM and Madole, KL},
Title = {What does it look like and what can it do? Category structure influences
   how infants categorize},
Journal = {CHILD DEVELOPMENT},
Year = {2005},
Volume = {76},
Number = {3},
Pages = {614-631},
Month = {MAY-JUN},
Note = {International Conference on Infant Studies, Chicago, IL, MAY 05-08, 2004},
Abstract = {Despite a large body of research demonstrating the kinds of categories
   to which infants respond, few studies have directly assessed how
   infants' categorization unfolds over time. Four experiments used a
   visual familiarization task to evaluate 10-month-old infants' (N=98)
   learning of exemplars characterized by commonalities in appearance or
   function. When learning exemplars with a common function, infants
   initially responded to the common feature, apparently forming a
   category, and only learned the individual features with more extensive
   familiarization. When learning exemplars with a common appearance,
   infants initially learned the individual features and apparently only
   formed a category with more extensive familiarization. The results are
   discussed in terms of models of category learning.},
