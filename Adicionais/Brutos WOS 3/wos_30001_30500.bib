@inproceedings{ WOS:000236996500026,
Author = {Schlaug, G and Norton, A and Overy, K and Winner, E},
Editor = {Avanzini, G and Koelsch, S and Lopez, L and Majno, M},
Title = {Effects of music training on the child's brain and cognitive development},
Booktitle = {NEUROSCIENCES AND MUSIC II: FROM PERCEPTION TO PERFORMANCE},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2005},
Volume = {1060},
