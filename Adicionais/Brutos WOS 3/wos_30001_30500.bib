@inproceedings{ WOS:000270732500012,
Author = {Caruso, Heather M. and Woolley, Anita Williams},
Editor = {Phillips, KW},
Title = {HARNESSING THE POWER OF EMERGENT INTERDEPENDENCE TO PROMOTE DIVERSE TEAM
   COLLABORATION},
Booktitle = {DIVERSITY AND GROUPS},
Series = {Research on Managing Groups and Teams},
Year = {2009},
Volume = {11},
Pages = {245-266},
Note = {11th Annual Conference on Research on Managing Groups and Teams, Cornell
   Univ, Ithaca, NY, MAY 04-05, 2007},
Abstract = {To reap the value in diverse teams, leaders may try to manipulate
   structural interdependence - through task design - to foster synergistic
   collaboration. However, ambiguity about the nature and appropriate
   intersections of members' unique and valuable cognitive perspectives can
   make it difficult to fully anticipate collaborative activity in task
   design. Here, teams need emergent interdependence - members must develop
   the desire and expectation to work interdependently for the benefit of
   the work. We therefore present a model of how leaders can promote
   emergent interdependence for diverse team success, identifying key
   antecedents and discussing psychological safety as a condition which can
   enhance their efforts.},
