@article{ WOS:000178530600001,
Author = {Herrald, MM and Tomaka, J and Medina, AY},
Title = {Pet ownership predicts adherence to cardiovascular rehabilitation},
Journal = {JOURNAL OF APPLIED SOCIAL PSYCHOLOGY},
Year = {2002},
Volume = {32},
Number = {6},
Pages = {1107-1123},
Month = {JUN},
Note = {19th Annual Meeting of the Society-of-Behavioral-Medicine, EL PASO,
   TEXAS, MAR 25-28, 1998},
Organization = {Soc Behav Med},
Abstract = {This experiment examined the effects of pet ownership and potential
   mediating (e.g., social support) and moderating variables (e.g., gender,
   personality, pet attachment) on completion of a 12-week cardiac
   rehabilitation program. This experiment assessed pet ownership,
   personality, and psychosocial variables at the beginning of the program
   and followed participants through to completion. Results showed that pet
   owners (96.5\%) were significantly more likely to complete cardiac
   rehabilitation compared with non-owners (79.2\%). Covariance analyses
   ruled out several alternative explanations for the results, including
   social support, personality variables, personal efficacy, and pet
   attachment. Results suggest that having a pet may facilitate
   rehabilitation and that further research is needed to understand how
   having a pet or being a pet owner improves health outcomes.},
