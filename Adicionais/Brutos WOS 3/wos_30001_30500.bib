@inproceedings{ WOS:000168193500101,
Author = {Jones, GV and Martin, M},
Editor = {Gernsbacher, MA and Derry, SJ},
Title = {Chiral cognitive science},
Booktitle = {PROCEEDINGS OF THE TWENTIETH ANNUAL CONFERENCE OF THE COGNITIVE SCIENCE
   SOCIETY},
