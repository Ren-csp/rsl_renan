Year = {2001},
Volume = {110},
Number = {4},
Pages = {544-552},
Month = {NOV},
Note = {109th Annual Convention of the American-Psychological-Association, SAN
   FRANCISCO, CALIFORNIA, AUG, 2001},
Organization = {American Psycholog Assoc},
Abstract = {The authors used D. A. Kenny's (1994a) social relations model to examine
   J. C. Coyne's (1976b) interpersonal theory of depression among a
   clinical sample of well-acquainted prison inmates. Members of 12 therapy
   groups (N = 142) diagnosed with a substance abuse disorder completed a
   self-report measure of depression and anxiety and indicated their desire
   to interact with other group members. There was both consensus about
   which group members were rejected and individual differences in the
   participants' reported desire for future interaction with other group
   members. Those reporting high levels of depressive negative affect were
   most likely to be rejected. Those lowest in positive affect indicated
   the least desire for future interaction with others.},
