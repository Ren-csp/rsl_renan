@article{ WOS:000228616500002,
Author = {Galinsky, AD and Ku, GL and Wang, CS},
Title = {Perspective-taking and self-other overlap: Fostering social bonds and
   facilitating social coordination},
Journal = {GROUP PROCESSES \& INTERGROUP RELATIONS},
Year = {2005},
Volume = {8},
Number = {2},
Pages = {109-124},
Month = {APR},
Note = {Annual Meeting of the Society-for-Personality-and-Social-Psychology,
   Austin, TX, JAN, 2004},
Organization = {Soc Personal \& Social Psychol},
Abstract = {The present article offers a conceptual model for how the cognitive
   processes associated with perspective-taking facilitate social
   coordination and foster social bonds. We suggest that the benefits of
   perspective-taking accrue through an increased self-other overlap in
   cognitive representations and discuss the implications of this
   perspective-taking induced self-other overlap for stereotyping and
   prejudice. Whereas perspective-taking decreases stereotyping of others
   (through application of the self to the other), it increases stereo
   typicality of one's own behavior (through inclusion of the other in the
   sell). To promote social bonds, perspective-takers utilize information,
   including stereotypes, to coordinate their behavior with others. The
   discussion focuses on the implications, both positive and negative, of
   this self-other overlap for social relationships and discusses how
   conceptualizing perspective-taking, as geared toward supporting specific
   social bonds, provides a framework for understanding why the effects of
   perspective-taking are typically target-specific and do not activate a
   general helping mind-set. Through its attempts to secure social bonds,
   perspective-taking can be an engine of social harmony, but can also
   reveal a dark side, one full of ironic consequences.},
