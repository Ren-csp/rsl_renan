@article{ WOS:000256210000005,
Author = {Santesso, Diane L. and Segalowitz, Sidney J. and Ashbaugh, Andrea R. and
   Antony, Martin M. and McCabe, Randi E. and Schmidt, Louis A.},
Title = {Frontal EEG asymmetry and sensation seeking in young adults},
Journal = {BIOLOGICAL PSYCHOLOGY},
Year = {2008},
Volume = {78},
Number = {2},
Pages = {164-172},
Month = {MAY},
Note = {64th Annual Convention of the Canadian-Psychological-Association,
   Hamilton, CANADA, JUN 12-14, 2003},
Organization = {Canadian Psychol Assoc},
Abstract = {Sensation seeking has been characterized as a desire to seek novel,
   intense sensations, and the willingness to take risks in pursuing them.
   In two separate studies of young adults, we examined the relation
   between measures of sensation seeking and the pattern of resting frontal
   EEG asymmetry, thought to reflect a biological predisposition to
   approach new experiences. As predicted, high sensation seeking was
   related to a greater relative left frontal activity at rest in both
   studies, which may be specific to men. How greater relative left frontal
   cortical activity at rest is related to a tendency to engage in
   sensation-seeking and risky behaviors is discussed. (c) 2008 Elsevier
   B.V. All rights reserved.},
