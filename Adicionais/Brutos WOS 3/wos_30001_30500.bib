@article{ WOS:000166347800018,
Author = {Hubbard, TL and Blessum, JA and Ruppel, SE},
Title = {Representational momentum and Michotte's (1946/1963) ``launching
   effect{''} paradigm},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-LEARNING MEMORY AND COGNITION},
Year = {2001},
Volume = {27},
Number = {1},
Pages = {294-301},
Month = {JAN},
Note = {Annual Meeting of the Psychonomic-Society, LOS ANGELES, CALIFORNIA, NOV,
   1999},
Organization = {Psychon Soc},
Abstract = {In A. Michotte's (1946/1963) launching effect, a moving launcher
   contacts a stationary target, and then the launcher becomes stationary
   and the target begins to move. In this experiment, observers viewed
   modifications of a launching effect display, and displacement in memory
   for the location of targets was measured. Forward displacement of
   targets in launching effect displays was decreased relative to that of
   targets (a) that were presented in isolation and either moved at a
   constant fast or slow velocity or decelerated or (b) that moved in a
   direction orthogonal to previous motion of the launcher. Possible
   explanations involving a deceleration of motion or landmark attraction
   effects were ruled out. Displacement patterns were consistent with naive
   impetus theory and the hypothesis that observers believed impetus from
   the launcher was imparted to the target and then dissipated.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Hubbard, TL (Corresponding Author), Texas Christian Univ, Dept Psychol, Ft Worth, TX 76129 USA.
   Texas Christian Univ, Dept Psychol, Ft Worth, TX 76129 USA.},
DOI = {10.1037/0278-7393.27.1.294},
ISSN = {0278-7393},
Keywords-Plus = {JUDGED DISPLACEMENT; COGNITIVE REPRESENTATION; CURVILINEAR IMPETUS;
   CENTRIPETAL FORCE; TARGET SIZE; MOTION; GRAVITY; PERCEPTION; FRICTION;
   MEMORY},
