@inproceedings{ WOS:000237435600007,
Author = {Baillargeon, Renee and Li, Jie and Luo, Yuyan and Wang, Su-hua},
Editor = {Munakata, Y and Johnson, MH},
Title = {Under what conditions do infants detect continuity violations?},
Booktitle = {PROCESSES OF CHANGE IN BRAIN AND COGNITIVE DEVELOPMENT: ATTENTION AND
   PERFORMANCE XXI},
Series = {Attention and Performance},
Year = {2006},
Pages = {163-188},
Note = {21st Meeting of the
   International-Association-for-the-Study-of-Attention-and-Performance,
   Winter Pk, CO, JUL 27-31, 2004},
Organization = {Int Assoc Study Attent \& Performance},
Abstract = {According to Spelke (1994), infants interpret physical events in accord
   with a core principle of continuity, which states that objects exist and
   move continuously in time and space. Here we adopt a stronger definition
   of the principle, which states that objects not only exist and move
   continuously in time and space, but also retain their physical
   properties as they do so. We then present a new account of infants'
   physical reasoning that specifies under what conditions infants succeed
   and fail in detecting violations of the principle. Finally, we describe
   new lines of research that test specific predictions from the account.},
