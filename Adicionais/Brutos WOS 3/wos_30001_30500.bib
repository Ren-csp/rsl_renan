@article{ WOS:000258907400014,
Author = {Revill, Kathleen Pirog and Tanenhaus, Michael K. and Aslin, Richard N.},
Title = {Context and spoken word recognition in a novel lexicon},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-LEARNING MEMORY AND COGNITION},
Year = {2008},
Volume = {34},
Number = {5},
Pages = {1207-1223},
Month = {SEP},
Note = {20th Annual CUNY Conference on Human Sentence Processing, La Jolla, CA,
   MAR, 2007},
Organization = {CUNY},
Abstract = {Three eye movement studies with novel lexicons investigated the role of
   semantic context in spoken word recognition, contrasting 3 models:
   restrictive access, access-selection, and continuous integration.
   Actions directed at novel shapes caused changes in motion (e.g.,
   looming, spinning) or state (e.g., color, texture). Across the
   experiments, novel names for the actions and the shapes varied in
   frequency, cohort density, and whether the cohorts referred to actions
   (Experiment 1) or shapes with action-congruent or action-incongruent
   affordances (Experiments 2 and 3). Experiment I demonstrated effects of
   frequency and cohort competition from both displayed and non-displayed
   competitors. In Experiment 2, a biasing context induced an increase in
   anticipatory eye movements to congruent referents and reduced the
   probability of looks to incongruent cohorts, without the delay predicted
   by access-selection models. In Experiment 3, context did not reduce
   competition from non-displayed incompatible neighbors as predicted by
   restrictive access models. The authors conclude that the results are
   most consistent with continuous integration models.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article; Proceedings Paper},
Language = {English},
