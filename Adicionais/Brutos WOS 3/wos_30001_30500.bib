@article{ WOS:000229376100006,
Author = {Lim, S and Cortina, LM},
Title = {Interpersonal mistreatment in the workplace: The interface and impact of
   general incivility and sexual harassment},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2005},
Volume = {90},
Number = {3},
Pages = {483-496},
Month = {MAY},
Note = {17th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, TORONTO, CANADA,
   APR 12-14, 2002},
Organization = {Soc Ind \& Org Psychol},
Abstract = {This article examined the relationships and outcomes of behaviors
   falling at the interface of general and sexual forms of interpersonal
   mistreatment in the workplace. Data were collected with surveys of two
   different female populations (Ns = 833 and 1,425) working within a large
   public-sector organization. Findings revealed that general incivility
   and sexual harassment were related constructs, with gender harassment
   bridging the two. Moreover, these behaviors tended to co-occur in
   organizations, and employee well-being declined with the addition of
   each type of mistreatment to the workplace experience. This behavior
   type (or behavior combination) effect remained significant even after
   controlling for behavior frequency. The findings are interpreted from
   perspectives on sexual aggression, social power, and multiple
   victimization.},
