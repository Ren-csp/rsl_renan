@article{ WOS:000423294300008,
Author = {Arrieta, Alejandro and Garcia-Prado, Ariadna and Gonzalez, Paula and
   Luis Pinto-Prades, Jose},
Title = {Risk attitudes in medical decisions for others: An experimental approach},
Journal = {HEALTH ECONOMICS},
Year = {2017},
Volume = {26},
Number = {3, SI},
Pages = {97-113},
Month = {DEC},
Note = {4th Workshop on Behavioral and Experimental Health Economics, Univ
   Cologne, Cologne, GERMANY, DEC 04-06, 2016},
Abstract = {The aim of this paper is to investigate how risk attitudes in medical
   decisions for others vary across health contexts. A lab experiment was
   designed to elicit the risk attitudes of 257 medical and nonmedical
   students by assigning them the role of a physician who must decide
   between treatments for patients. An interval regression model was used
   to estimate individual coefficients of relative risk aversion, and an
   estimation model was used to test for the effect of type of medical
   decision and experimental design characteristics on elicited risk
   aversion. We find that (a) risk attitudes vary across different health
   contexts, but risk aversion prevails in all of them; (b) students
   enrolled in health-related degrees show a higher degree of risk
   aversion; and (c) real rewards for third parties (patients) make
   subjects less risk-averse. The results underline the importance of
   accounting for attitudes towards risk in medical decision making.},
