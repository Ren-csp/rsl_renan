Number = {2},
Pages = {178-198},
Month = {APR},
Note = {Proceedings of the 2nd Brigham Young University Conference on Youth and
   Family, SUNDANCE, UT, JUL, 1995},
Organization = {Brigham Young Univ},
Abstract = {Relational components of three attributes often regarded as individual
   variables (conflict, autonomy, and self-regulation) were examined in two
   studies. In Study 1, mothers and their 10- through 12-, 13- through 15-,
   or 16- through 17-year-old offspring reported expected times of
   transition to 47 adultlike behaviors (behavioral autonomy) and rated the
   importance of delaying each transition. Discrepancies from mothers'
   expectancies were found to be greatest for 13- through 15-year-olds. In
   Study 2, characteristics and correlates of conflict across different
   types of relationships were assessed Sixth-grade and eighth-grade
   Hispanic American adolescents reported significant differentiation among
   relationships with mothers, fathers, and friends infrequency of
   conflict, conflict resolution strategies and sequelae, and correlates of
   adolescents' psychosocial competence, Variations suggest that multiple
   relationships may be involved in the development of autonomy and
   self-regulation during childhood and adolescence.},
