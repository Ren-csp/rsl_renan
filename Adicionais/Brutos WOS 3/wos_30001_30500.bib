@inproceedings{ WOS:000078659300011,
Author = {Kuhl, PK},
Editor = {VonEuler, C and Lundberg, I and Llinas, R},
Title = {The development of language},
Booktitle = {BASIC MECHANISMS IN COGNITION AND LANGUAGE: WITH SPECIAL REFERENCE TO
   PHONOLOGICAL PROBLEMS IN DYSLEXIA},
Series = {Wenner-Gren International Series},
Year = {1998},
Volume = {70},
Pages = {175-195},
Note = {Wenner-Gren Conference on Basic Mechanisms in Cognition and Language,
   STOCKHOLM, SWEDEN, FEB, 1997},
Organization = {Wenner Gren Ctr Fdn},
Abstract = {Infants learn language with remarkable speed. By the end of the second
   year they speak in sentences, sounding distinctly like a speaker of the
   `mother tongue'. How does individual learning result in the acquisition
   of a specific language? What kind of `learning' is involved? Theoretical
   positions vary from the view that infants are born with a universal
   system of grammar and phonology innately provided to the view that
   nothing is innately provided and language is acquired as a process of
   feedback and reinforcement. Both views make assumptions about language
   input and the developmental changes it induces that have not been backed
   by systematic research. This article focuses on infants' biological
   preparation for language, the nature of early language input, and the
   effects of early language experience on infants' perceptual and
   perceptual-motor systems. The data show that by the time infants begin
   to master the higher levels of language-sound-meaning correspondences,
   contrastive phonology and grammatical rules-their perceptual and
   perceptual-motor systems are strongly biased towards a specific
   language. The consequences of this are described in a developmental
   theory at the phonetic level that holds promise for higher levels of
   language.},
