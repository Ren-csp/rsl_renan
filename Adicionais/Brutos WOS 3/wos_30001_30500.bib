@article{ WOS:000258086200008,
Author = {Grabherr, Luzia and Karmali, Faisal and Bach, Silvia and Indermaur,
   Kathrin and Metzler, Sibylle and Mast, Fred W.},
Title = {Mental own-body and body-part transformations in microgravity},
Journal = {JOURNAL OF VESTIBULAR RESEARCH-EQUILIBRIUM \& ORIENTATION},
Year = {2007},
