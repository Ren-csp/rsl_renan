   ARLINGTON, VIRGINIA, 1998},
Organization = {Amer Orthopsychiat Assoc},
Abstract = {Although experiences of community violence are widespread and may have
   deleterious psychosocial consequences for children and youth,results of
   this exploratory study indicate that therapists lack substantial
   knowledge of their young clients' exposure to such violence. These
   findings suggest a need for professionals to adopt strategics to assess
   moire systematically the role of community violence exposure in the
   problems presented by youth.},
