@inproceedings{ WOS:000668559100018,
Author = {Herath, H. M. M. and Wijesekera, N. T. S.},
Book-Group-Author = {IOP},
Title = {A Methodological Framework for Operationalization of Flood Risk
   Management},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL ENGINEERING AND
   SUSTAINABLE DEVELOPMENT (CEESD 2020)},
Series = {IOP Conference Series-Earth and Environmental Science},
