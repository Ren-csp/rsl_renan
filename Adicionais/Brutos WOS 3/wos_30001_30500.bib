Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Beuzeron-Mangina, H (Corresponding Author), Montreal Res \& Treatment Ctr, Cognit Psychophysiol Lab, 3587 Univ, Montreal, PQ H3A 2B1, Canada.
