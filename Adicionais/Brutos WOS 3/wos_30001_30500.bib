@article{ WOS:000267667100015,
Author = {Lemyre, Louise and Gibson, Stacey and Zlepnig, Jennifer and
   Meyer-Macleod, Robin and Boutette, Paul},
Title = {Emergency preparedness for higher risk populations: psychosocial
   considerations},
Journal = {RADIATION PROTECTION DOSIMETRY},
Year = {2009},
Volume = {134},
Number = {3-4},
Pages = {207-214},
Month = {JUN},
Note = {Workshop of the Emergency-Preparedness-for-Vulnerable-Population-Groups,
   Ottawa, CANADA, MAR 02-03, 2009},
Organization = {Emergency Preparedness Vulnerable Populat Grp},
Abstract = {This paper was meant to be on `vulnerable populations', as some
   population sub-groups do require special care, special planning and
   special integration of needs. However, the issue should be reframed in
   terms of groups at higher risks. The text explains how (1) there are
   contextual vulnerabilities, in (a) higher susceptibility, i.e. higher
   exposure to risk, (b) higher sensitivity, i.e. higher damage or higher
   brittleness, and (c) weaknesses and gaps in the emergency system; (2)
   that these higher susceptibility, sensitivity and system weaknesses
   involve important psychosocial considerations, which may stem from
   socio-demographic status or ripple effects in the community; and
   finally, (3) that addressing those `soft spots' using the phrase
   `vulnerable populations' can be misleading and disserving because it
   disempowers, stigmatises and deters one from a more thorough analysis.},
