@article{ WOS:A1997WR07900002,
Author = {Collins, W and Laursen, B and Mortensen, N and Luebker, C and Ferreira,
   M},
Title = {Conflict processes and transitions in parent and peer relationships:
   Implications for autonomy and regulation},
Journal = {JOURNAL OF ADOLESCENT RESEARCH},
