@article{ WOS:000084148400005,
Author = {Noom, MJ and Dekovic, M and Meeus, WHJ},
Title = {Autonomy, attachment and psychosocial adjustment during adolescence: a
   double-edged sword?},
Journal = {JOURNAL OF ADOLESCENCE},
Year = {1999},
Volume = {22},
Number = {6},
Pages = {771-783},
Month = {DEC},
Note = {6th Biennial Conference of the
   European-Association-for-Research-on-Adolescence, BUDAPEST, HUNGARY, JUN
   03-07, 1998},
Organization = {European Assoc Res Adolescence},
Abstract = {Both autonomy and attachment are positively related to psychosocial
   adjustment during adolescence. The aim of the present study was to
   examine the assumption that a high level of autonomy within a context of
   attachment provides the best constellation for psychosocial adjustment.
   Subjects were 400 adolescents. Attitudinal, emotional and functional
   autonomy were connected with attachment to father, mother and peers to
   predict indices of psychosocial adjustment: social competence, academic
   competence, self esteem, problem behaviour and depressive mood. Only
   main effects of autonomy and attachment were found. There was no
   evidence for an extra positive effect of being both autonomous and
   strongly attached. (C) 1999 The Association for Professionals in
   Services for Adolescents.},
