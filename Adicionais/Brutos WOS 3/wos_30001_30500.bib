@article{ WOS:000265444100002,
Author = {Wang, Sheng and Noe, Raymond A. and Wang, Zhong-Ming and Greenberger,
   David B.},
Title = {What affects willingness to mentor in the future? An investigation of
   attachment styles and mentoring experiences},
Journal = {JOURNAL OF VOCATIONAL BEHAVIOR},
Year = {2009},
Volume = {74},
Number = {3},
Pages = {245-256},
Month = {JUN},
Note = {Annual Meeting of the Academy-of-International-Business, Milan, ITALY,
   JUL, 2008},
Organization = {Acad Int Business},
Abstract = {This study examined the influence of attachment styles and mentoring
   experiences on willingness to mentor in the future in a formal mentoring
   program in China. For both mentors and proteges, avoidance and anxiety
   dimensions of attachment styles and their interaction had a significant
   influence on willingness to mentor in the future. Mentoring experiences
   explained unique variance in willingness to mentor beyond attachment
   styles. Crossover analysis of matched mentor-protege pairs showed that
   mentoring functions fully mediated the mentor avoidance - protege
   willingness to mentor relationship. The interaction between protege
   avoidance and anxiety was directly related to mentor willingness to
   mentor in the future. Directions for research and implications for
   managerial practice are provided. (c) 2008 Elsevier Inc. All rights
   reserved.},
