Pages = {59-70},
Note = {Conference of the Neurosciences and Music II, Leipzig, GERMANY, MAY
   05-08, 2005},
Organization = {Max Planck Inst Human Cognit \& Brain Sci},
Abstract = {Two new empirical studies address the relationship between music and
   language. The first focuses on melody and uses research in phonetics to
   investigate the long-held notion that instrumental music reflects speech
   patterns in a composer's native language. The second focuses on syntax
   and addresses the relationship between musical and linguistic syntactic
   processing via the study of aphasia, an approach that has been explored
   very little. The results of these two studies add to a growing body of
   evidence linking music and language with regard to structural patterns
   and brain processing.},
