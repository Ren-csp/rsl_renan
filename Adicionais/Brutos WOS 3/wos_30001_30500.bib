@article{ WOS:000188753000002,
Author = {Heslin, PA and Latham, GP},
Title = {The effect of upward feedback on managerial behavior},
Journal = {APPLIED PSYCHOLOGY-AN INTERNATIONAL REVIEW-PSYCHOLOGIE APPLIQUEE-REVUE
   INTERNATIONALE},
Year = {2004},
Volume = {53},
