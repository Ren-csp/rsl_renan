@inproceedings{ WOS:000271331200088,
Author = {Musa, Rosidah and Pallister, John and Robson, Matthew},
Editor = {Menon, G and Rao, AR},
Title = {The Roles of Perceived Value, Perceived Equity and Relational Commitment
   in a Disconfirmation Paradigm Framework: An Initial Assessment in a
   `Relationship-Rich' Consumption Environment},
Booktitle = {ADVANCES IN CONSUMER RESEARCH, VOL 32},
Series = {Advances in Consumer Research},
Year = {2005},
Volume = {32},
Pages = {349-357},
Note = {32nd Annual Meeting of the Association-for-Consumer-Research, Portland,
   OR, OCT 07-10, 2004},
Organization = {Assoc Consumer Res},
Abstract = {Investigations to unravel the determinants of customer satisfaction are
   crucial to elucidating the role and significance of the construct and
   advancing management practice. Accordingly, our study investigates the
   drivers of customer satisfaction and its impact on behavioral intentions
   in the direct sales channel context. A conceptual model was developed
   and tested, which integrates perceived value, perceived equity and
   relational commitment into the disconfirmation framework. The findings
   suggest performance is the key driver of customer satisfaction at the
   subsystem level, while perceived value plays the leading role in
   influencing customers' overall satisfaction. Further, two new
   paths-perceived value to relational commitment and perceived value to
   perceived equity-neglected in prior research were established. The
   discussion of our findings reveals important implications for future
   research and management practice.},
Publisher = {ASSOC CONSUMER RESEARCH},
