@inproceedings{ WOS:000269652300037,
Author = {Peretz, Isabelle and Gosselin, Nathalie and Belin, Pascal and Zatorre,
   Robert J. and Plailly, Jane and Tillmann, Barbara},
Editor = {DallaBella, S and Kraus, N and Overy, K and Pantev, C and Snyder, JS and Tervaniemi, M and Tillmann, B and Schlaug, G},
Title = {Music Lexical Networks The Cortical Organization of Music Recognition},
Booktitle = {NEUROSCIENCES AND MUSIC III: DISORDERS AND PLASTICITY},
