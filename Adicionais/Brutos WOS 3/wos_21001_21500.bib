@article{ WOS:A1994QD08100003,
Author = {HUBLIN, C and PARTINEN, M and KAPRIO, J and KOSKENVUO, M and
   GUILLEMINAULT, C},
Title = {EPIDEMIOLOGY OF NARCOLEPSY},
