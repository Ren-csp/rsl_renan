@inproceedings{ WOS:000426869900002,
Author = {Almazova, O. V. and Veraksa, A. N. and Bukhalenkova, D. A. and Dontsov,
   A. I. and Zotova, O. Yu. and Perelygina, E. B.},
Editor = {Malykh, SB and Nikulchev, EV},
Title = {DEVELOPMENT FEATURES OF PRESCHOOL CHILDREN WITH DIFFERENT ANXIETY LEVELS},
Booktitle = {ICPE 2017: INTERNATIONAL CONFERENCE ON PSYCHOLOGY AND EDUCATION},
