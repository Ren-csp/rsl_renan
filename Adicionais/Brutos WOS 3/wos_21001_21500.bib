@inproceedings{ WOS:000075917700023,
Author = {Leonard, SD and Karnes, EW},
Editor = {Kumar, S},
Title = {Influence of context on warnings},
Booktitle = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY, VOL 2},
Series = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Year = {1998},
Volume = {2},
Pages = {104-107},
Note = {XIIIth Annual International Occupational Ergonomics and Safety
   Conference, YPSILANTI, MI, JUN 11-14, 1998},
Abstract = {Warnings provide important information about the hazards that are faced
   in a variety of circumstances. The information provided by the warnings
   is very important. However, this information may be supplemented
   extensively by previous experiences and by the environmental
   circumstances in which the warning is presented. The present experiment
   was performed to evaluate the effect of expectations for compliance with
   warnings on the degree of seriousness with which the participants
   evaluated the warnings. Although no dependable difference was found in a
   preliminary test of perception of risk, later ratings of changes in
   concern for the seriousness of the hazards showed differences between
   situations in which compliance with the warnings were or were not
   required.},
