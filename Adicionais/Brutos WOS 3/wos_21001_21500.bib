@article{ WOS:000349408400009,
Author = {Cullen, Kathleen E. and Brooks, Jessica X.},
Title = {Neural Correlates of Sensory Prediction Errors in Monkeys: Evidence for
   Internal Models of Voluntary Self-Motion in the Cerebellum},
Journal = {CEREBELLUM},
