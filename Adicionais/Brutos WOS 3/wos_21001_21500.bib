Title = {Risk assessment process at an administrative services company,
   well-organized in terms of OHS},
Booktitle = {SHO 2012: INTERNATIONAL SYMPOSIUM ON OCCUPATIONAL SAFETY AND HYGIENE},
Year = {2012},
Pages = {80-86},
Note = {8th International Symposium on Occupational Safety and Hygiene (SHO),
   Univ Minho, Sch Engn, Guimaraes, PORTUGAL, FEB 09-10, 2012},
Organization = {Portuguese Soc Occupat Safety \& Hygiene (SPOSHO); Portuguese Engineers
