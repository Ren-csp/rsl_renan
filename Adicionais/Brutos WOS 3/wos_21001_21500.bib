@inproceedings{ WOS:000452820600013,
Author = {Zhang, Deying and Zhou, Yunyun and Zheng, Lan and Shi, Runhe and Chen,
   Maosi},
Editor = {Gao, W and Chang, NB and Wang, J},
Title = {The spatial distribution characteristics and ground-level estimation of
   NO2 and SO2 over Huaihe River Basin and Shanghai
   based on satellite observations},
Booktitle = {REMOTE SENSING AND MODELING OF ECOSYSTEMS FOR SUSTAINABILITY XV},
Series = {Proceedings of SPIE},
