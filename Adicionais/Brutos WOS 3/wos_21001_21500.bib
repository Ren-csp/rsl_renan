@article{ WOS:A1995QH36300003,
Author = {WANBERG, CR},
Title = {A LONGITUDINAL-STUDY OF THE EFFECTS OF UNEMPLOYMENT AND QUALITY OF
   REEMPLOYMENT},
Journal = {JOURNAL OF VOCATIONAL BEHAVIOR},
