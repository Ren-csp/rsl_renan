@inproceedings{ WOS:000223250500027,
Author = {Grifoni, RC and Passerini, G and Tascini, S},
Editor = {Brebbia, CA and Perez, JMS and Andion, LG and Villacampa, Y},
Title = {The evaluation of representative day and least representative day in a
   complex coastal area},
Booktitle = {COASTAL ENVIRONMENT V: INCORPORATING OIL SPILL STUDIES},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {2004},
Volume = {10},
Pages = {279-287},
Note = {5th International Conference on Environmental Problems in Coastal
   Regions, Univ Alicante, Alicante, SPAIN, 2004},
Organization = {Wessex Inst Technol},
Abstract = {The aim of many studies related to air pollution assessment is the
   development of a methodology capable of predicting the evolution of
   pollutant concentrations under varying meteorological and emission
   conditions. For this purpose the selection of a base case -i.e. a
   typical day at a typical location of interest- is often required.
   The representative day is constituted by the actual data of the day, in
   the considered period, where the sum of the mean-square differences
   among its monitored quantities, averaged within each hour, and the same
   quantities for all other days at the same hour is minimised. The least
   representative day, conversely, is constituted by the actual data of the
   day where the sum of the mean-square differences among its monitored
   quantities, averaged within each hour, is maximised.
   In this paper a preliminary assessment of both representative day and
   least representative day techniques is presented. A large database has
   been considered for the evaluation in a complex coastal area, namely the
   lower Esino valley which is a complex coastal area in a central region
   of Italy (Marche) comprising valleys, hills, urban and industrial zones.
   Results in terms of monitored quantities obtained by applying both
   approaches have been compared showing good agreement.},
