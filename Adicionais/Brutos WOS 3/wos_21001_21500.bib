@inproceedings{ WOS:000346067900353,
Author = {Costopoulou, D. and Vassiliadou, I. and Zafeiraki, E. and Leondiadis, L.},
Editor = {Lekkas, TD},
Title = {EXPOSURE TO THE PERSISTENT PERFLUORINATED COMPOUNDS PFCs IN GREECE},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Perfluorinated compounds (PFCs) represent a large group of chemicals
   used in numerous industrial and consumer applications including
   adhesives, cosmetics, cleaners, coatings, and electronics. Owing to
   their persistence in the environment and their bioaccumulative
   potential, several PFCs have been detected worldwide in environmental
   samples. Biomonitoring studies have shown extensive human exposure to
   these compounds. The routes of human exposure to perfluorinated
   compounds have not been well characterized, but food, food packaging,
   household dust, and drinking water are all likely to contribute. Among
   PFCs, research focuses mainly on perfluoroocanesulfonate (PFOS) and
   perfluorooctanoic acid (PFOA,) which have been produced in highest
   amounts for several decades and have been recognized by the European
   Food Safety Authority (EFSA) as emerging contaminants in the food chain.
   EFSA has established tolerable daily intakes (TDI) of 150 ng kg-1 b.w.
   day-1 for PFOS and 1500 ng kg-1 b.w. day-1 for PFOA. PFOS, its salts and
   PFOS-F (perfluorooctane sulfonyl fluoride) have been added to the list
   of persistent organic pollutants (POPs) of the Stockholm Convention on
   Persistent Organic Pollutants, in an amendment of May 2009. According to
   EFSA, collection of data for concentration levels in the food chain is
   of critical importance. PFCs are used extensively in foodstuff packages
   as coatings/additives for oil and moisture resistance. Since food
   packaging materials come directly in contact with food, PFCs can
   possibly pass through the material and accumulate in food.
   The main objective of this study was to perform a first survey of the
   level of contamination to different alkyl chain length perfluorinated
   compounds in Greece. The study included the analyses of food samples
   from the Greek market (meat products, fish, vegetables and milk),
   foodstuff packaging materials and blood samples from three different
   groups of adults living in Greece: a group of individuals living in
   Athens, a group of inhabitants of the semi-urban and rural area of
   Argolida, and a group of cancer patients from the St. Savvas Anticancer
   Hospital in Athens. The latter group was chosen in order to examine the
   possible relation of PFOS and PFOA levels with cancer incidence in the
   general population.},
