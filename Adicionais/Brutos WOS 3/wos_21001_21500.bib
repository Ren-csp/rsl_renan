Title = {PLEURAL EFFUSION OF CIRRHOTIC ORIGIN: PATHOGENESIS, CLINICAL
   PRESENTATION AND DIAGNOSIS},
Booktitle = {PSYCHOLOGY AND PSYCHIATRY, SOCIOLOGY AND HEALTHCARE, EDUCATION, VOL II},
