@article{ WOS:A1994QH04800008,
Author = {SAGAN, L},
Title = {THE TRIUMPH OF THEOLOGY OVER SCIENCE - THE NON-THRESHOLD EFFECTS MODEL},
Journal = {INTERNATIONAL JOURNAL OF OCCUPATIONAL MEDICINE AND TOXICOLOGY},
Year = {1994},
Volume = {3},
Number = {2},
Pages = {161-173},
Month = {APR-JUN},
Note = {International Symposium on Biological Effects of Low Level Exposures to
   Radiation and Related Agents (ISBELLES 93), CHANGCHUN, PEOPLES R CHINA,
   OCT 12-16, 1993},
Organization = {CHINESE SOC RADIOL MED \& PROTECT; CHINESE MED ASSOC},
Abstract = {Health effects following low-dose radiation exposures are generally
   predicated on the theory that effects will be proportional to those
   detected at high doses, without a threshold.  Radiation protection
   policy, environmental regulation, and public perception of risks are
   based on that theory; yet, there are no observations of health effects
   at low doses to substantiate this theory.  The non-threshold model was
   adopted to replace a previously dominant threshold model, largely on the
   basis of social and political considerations.  However, considerable
   information exists which reports that low-dose radiation may, under some
   circumstances, increase longevity in experimental animals.  Therefore,
   the question `'Why did this happen?'' arises.  Recent evidence of
   stimulatory effects in cell cultures exposed to low-dose radiation
   reinforces the need to reconsider radiation protection policies.},
