@inproceedings{ WOS:000313845902232,
Author = {Wang, Xianglin and Li, Jingpeng and Zhang, Yan and Su, Zhiyao},
Editor = {Iranpour, R and Zhao, J and Wang, A and Yang, FL and Li, X},
Title = {Patterns of Indigenous Tree Species Distribution in Guangdong Province
   and the Implications for Tree Introduction},
