Note = {Annual International Conference on Cognitive - Social, and Behavioural
   Sciences (icCSBs), Mersin, TURKEY, MAY 14-17, 2014},
Organization = {Future Acad},
Abstract = {Loneliness is not a simple mood, it is complicated and has several
   layers. An evaluation of loneliness aims to show the complexity of
   loneliness mood, indicate its layers and investigate loneliness by
   evaluating different approaches, authors and studies. It aims to review
   literature in order to understand and evaluate of different layers of
   loneliness such as types, reasons and outcomes of loneliness, the
   perception of lonely people, and coping mechanisms. It is important to
   understand its different layers in order to effectively help someone
   coping with it as it decreases the satisfaction of life and increases
   risky behaviour. (c) 2014 The Authors. Published by Cognitive - crcs
