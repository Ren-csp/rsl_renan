@inproceedings{ WOS:000647477300063,
Author = {Yu, Tingting and Guo, Wenrui and Zhang, Mingxiao and Wen, Yue},
Book-Group-Author = {IOP},
Title = {Effects of Plants and Plant Fermentation Broth on the Removal and
   Characteristics of Dissolved Organic Matter in Self-Supplying Carbon
   Source Constructed Wetlands Treating Secondary Effluent},
Booktitle = {2020 5TH INTERNATIONAL CONFERENCE ON MATERIALS SCIENCE, ENERGY
   TECHNOLOGY AND ENVIRONMENTAL ENGINEERING},
