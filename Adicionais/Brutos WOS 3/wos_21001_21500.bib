   and Tsihrintzis, V. and Karantounias, G.},
Editor = {Lekkas, TD},
Title = {Risk assessment in water resources management of Polyfyto Lake in
   Western Macedonia, Greece},
Booktitle = {Proceeding of the 9th International Conference on Environmental Science
   and Technology Vol B - Poster Presentations},
