@inproceedings{ WOS:000082800000065,
Author = {Royster, L and Yearont, R},
Editor = {Lee, GCH},
Title = {A computer in every classroom - Are school children at risk for
   repetitive stress injuries (RSIs)?},
Booktitle = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Series = {ADVANCES IN OCCUPATIONAL ERGONOMICS AND SAFETY},
Year = {1999},
Volume = {3},
Pages = {407-412},
Note = {XIVth Annual International Occupational Ergonomics and Safety Conference
   1999, ORLANDO, FL, JUN 06-09, 1999},
Abstract = {Although President Clinton's goal of a computer in every classroom has
   advanced computer literacy, minimizing development of Repetitive Stress
   Injuries(RSIs) through ergonomic computer workstations and correct
   posture receives little attention. Computer laboratories in three
   western North Carolina school systems were evaluated. Students were
   observed working at computers and surveyed regarding participation in
   risk factors for RSIs. Faculty surveys determined computer workstation
   perceptions and satisfaction. Significant differences were noted for
   perceived workstation acceptability between primary and secondary
   students and students and administrators. Administrators and faculty did
   not view workstation conformance to standards a priority. Results
   indicate need for standardized guidelines for public school systems,
   increased focus on posture, and funding specifically for improving
   ergonomic quality of workstations.},
