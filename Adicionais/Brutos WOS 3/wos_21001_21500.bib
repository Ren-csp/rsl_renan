@inproceedings{ WOS:000169963600053,
Author = {Donner, R},
Editor = {Buchroithner, MF},
Title = {Qualitative aspects of the visual interpretation of remotely sensed data},
Booktitle = {DECADE OF TRANS-EUROPEAN REMOTE SENSING COOPERATION},
Year = {2001},
Pages = {359-365},
Note = {20th Annual Symposium of the
   European-Association-of-Remote-Sensing-Laboratories (EARSeL), DRESDEN,
   GERMANY, JUN 14-16, 2000},
Organization = {European Assoc Remote Sensing Labs},
Abstract = {Remote sensing offers the advantage that large areas of the Earth's
   surface can be viewed as a whole. The question as to how associations
   can be recognised in remote sensing images can be answered in a number
   of ways: Singular objects, such as river systems, can be distinguished
   by way of their common form or colour patterns. Composite objects, such
   as a settlement, can be identified by the relationships between their
   parts, buildings and streets. In both cases the result is dependent on
   the fundamental conception. Aesthetic considerations, on the other hand,
   can produce new, unprejudiced encounters. Through the perception of
   qualities it is also possible to incorporate experienced reality into
   the studies.},
