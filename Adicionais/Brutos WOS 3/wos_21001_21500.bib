@inproceedings{ WOS:000392856300259,
Author = {Panthail, Jai Kanth and Brewer, Simon C. and Burian, Steven J.},
Editor = {Karvazy, K and Webster, VL},
Title = {Statistical modeling of the PM2.5-Albedo-Streamflow relationship in
   Parley's Creek, Utah using MODIS albedo data},
Booktitle = {World Environmental and Water Resources Congress 2015: Floods, Droughts,
   and Ecosystems},
Year = {2015},
Pages = {2638-2647},
Note = {World Environmental and Water Resources Congress, Austin, TX, MAY 17-21,
   2015},
Organization = {Amer Soc Civil Engineers, Environm and Water Resources Inst},
Abstract = {There has been growing focus on the impact of dust deposition on the
   hydrology of snowmelt-fed watersheds. Recent studies have indicated that
   dust deposition can vary the albedo or reflectivity of snow, leading to
   changes in the melt dynamics and subsequent variations in the flow rates
   of mountain streams. Lower albedo causes the snow to melt sooner,
   causing spring snowmelt to occur as early as late winter. Such
   variations can throw water management plans into disarray, and might
   also lead to events such as floods and droughts. This study aims to
   demonstrate the suitability of using NASA's MODIS dataset, particularly
   the MCD43 suite of albedo products, in understanding past patterns and
   predicting future variations in stream flows from watersheds impacted by
   urban air pollution. Satellite data allows researchers to avoid
   expensive and time-consuming ground measurements, and also to understand
   spatial and temporal phenomena in difficult-to-reach mountain
   watersheds. Two statistical models are developed for Parley's Creek,
   located near Salt Lake City, relating stream flow observations to an air
   quality parameter (PM 2.5) and MODIS albedo data. The Generalized
   Additive Models (GAMs) framework is used to develop these models, and
   robust optimization using k-fold cross validation is used to find the
   best fit that will generalize to new data.},
