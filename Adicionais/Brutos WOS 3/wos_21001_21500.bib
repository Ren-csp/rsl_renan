@inproceedings{ WOS:000223250500024,
Author = {Takezawa, M and Kubota, S and Maeno, Y and Yamada, Y and Takahashi, N},
Editor = {Brebbia, CA and Perez, JMS and Andion, LG and Villacampa, Y},
Title = {Survey of fishermen attitudes in Japan},
Booktitle = {COASTAL ENVIRONMENT V: INCORPORATING OIL SPILL STUDIES},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {2004},
Volume = {10},
Pages = {245-254},
Note = {5th International Conference on Environmental Problems in Coastal
   Regions, Univ Alicante, Alicante, SPAIN, 2004},
Organization = {Wessex Inst Technol},
Abstract = {The coastal zone of Japan of about 34,000 km is dotted with about 3000
   fishing harbors. At present, about 270,000 workers in the fishery
   industry process about 5,300,000 tons of fish annually in Japan.
   However, fish catches have been decreasing since 1980, and the incomes
   of fishermen have also been decreasing. The fishermen near the largest
   cities have access to incomes outside of the fishing industry, but it is
   not easy to get a side income in the small fisheries of rural areas. As
   a result, many young people are moving to large cities, and aging 1
   people are staying in the small fisheries. In the development of cities
   in the 20(th) century, many skyscrapers were built in the largest
   cities, and much of the land was covered by asphalt and concrete.
   However, in the 21(st) century, many tired city dwellers will be
   escaping the bustle of the big cities by moving to country towns, and
   many Japanese hope to retire in fishing villages. However, it is
   doubtful whether people in fishing villages can accommodate the city
   dwellers with amicable feelings and adequate and satisfactory
   infrastructure, such as water supply systems, sewerage, transportation,
   shopping, and medical services, since city dwellers have become
   accustomed to urban lifestyles.},
