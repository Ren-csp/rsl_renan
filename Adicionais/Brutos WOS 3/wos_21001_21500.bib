@inproceedings{ WOS:000327089500018,
Author = {Fritz, Jonathan and Poeppel, David and Trainor, Laurel and Schlaug,
   Gottfried and Patel, Aniruddh D. and Peretz, Isabelle and Rauschecker,
   Josef P. and Halle, John and Stregapede, Francesca and Parsons, Lawrence
   M.},
