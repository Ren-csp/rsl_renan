@article{ WOS:000185504700032,
Author = {Picot, B and Paing, J and Sambuco, JP and Costa, RHR and Rambaud, A},
Title = {Biogas production, sludge accumulation and mass balance of carbon in
   anaerobic ponds},
Journal = {WATER SCIENCE AND TECHNOLOGY},
