@inproceedings{ WOS:000180264300032,
Author = {Backman, L and Brett-Smith, H and Virata, M},
Book-Group-Author = {MONDUZZI EDITORE
   MONDUZZI EDITORE},
Title = {Knowledge and attitudes related to plasma HIV RNA levels and CD4 cell
   counts in HIV infected individuals: A patient perspective study},
Booktitle = {XIV INTERNATIONAL AIDS CONFERENCE: ADVOCACY AND POLICY},
Year = {2002},
Pages = {143-145},
Note = {14th International AIDS Conference, BARCELONA, SPAIN, JUL 07-12, 2002},
Organization = {Univ N Carolina; Gen Clin Res Ctr; UNC Ctr AIDS Res; Natl Inst Hlth;
   Swiss Natl AIDS Res Program; Bristol-Myers Squibb Co; Boehringer
   Ingelheim; GlaxoWellcome Res \& Dev, HIV Antiviral Res},
Abstract = {Plasma HIV-1 RNA (VL) and CD4+ cell counts are used to predict prognosis
   and treatment responses of persons infected with HIV. Given the critical
   role of the CD4 and VL, little information is available on the patient's
   perception of these values. HIV-positive persons completed self-report
   measures of demographics, health status, and antiretroviral therapy
   (ART) adherence through use of the Supplement to HIV and AIDS
   Surveillance (SHAS) study questionnaire. Patients unable to recall their
   most recent CD4 or VL were more likely to be Hispanic, less educated,
   infected for fewer years, had lower CD4 and higher VL, and unable to
   name their ART. These results have implications for HIV patient
   education and treatment programming.},
