Title = {The role of loss in the construction of Adoptive Identity},
Booktitle = {15TH EUROPEAN CONFERENCE ON DEVELOPMENTAL PSYCHOLOGY},
Year = {2011},
Pages = {197-200},
Note = {15th European Conference on Developmental Psychology, Bergen, NORWAY,
   AUG 23-27, 2011},
Organization = {European Soc Dev Psychol (ESDP); Univ Bergen},
Abstract = {Developmental changes of adoptee's understanding of adoption have impact
   on identity development, namely in what concerns the significance of
   loss. This study aims to identify how loss relates to the meaning given
   by each adoptee to his/her condition, regarding the construction of
   adoptive identity during emerging adulthood. The study involved 22
   adoptees aged 18 to 29 years-old adopted between birth and the age of
   16. Data were collected through an Interview (EAEA) that captures the
   uniqueness of the experience of adoption through elements of the
   adoptee's life history. The results show associations between the loss
   experienced by adoptees and their self-perceptions as adoptees
   emphasizing the importance of the age at placement.},
