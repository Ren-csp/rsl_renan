@inproceedings{ WOS:000451538100042,
Author = {Azmee, Norzaireen Mohd and Nuruddin, Muhd Fadhil},
Editor = {Brebbia, CA and Sendra, JJ},
Title = {IMPACT PERFORMANCE OF LOW CEMENT ULTRA-HIGH-PERFORMANCE CONCRETE},
Booktitle = {SUSTAINABLE CITY XII},
