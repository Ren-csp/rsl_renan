@article{ WOS:000243754800009,
Author = {DiClementi, Jeannie D. and Berrenberg, Joy L. and Giese, Lisa},
Title = {Association between hypnotizability, perceived self-efficacy, and
   provider contact in a healthy college student sample: An analogue
   adherence study},
