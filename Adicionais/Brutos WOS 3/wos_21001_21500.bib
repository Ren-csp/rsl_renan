@inproceedings{ WOS:001596705100014,
Author = {Aroua, Ichraf and Hussein, Faten},
Editor = {Verma, I and Arpiainen, L},
Title = {Ambiance as a Key for a Better Birth Experience},
Booktitle = {EFFECTS OF DESIGN ON HEALTH AND WELLBEING, ARCH 2024},
