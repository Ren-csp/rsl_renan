Volume = {34},
Number = {12},
Pages = {1665-1687},
Note = {3rd International Conference on Biopsychosocial Aspects of HIV
   Infection, MELBOURNE, AUSTRALIA, JUN 22-25, 1997},
Abstract = {This paper reports on findings collected from 1993-1995 from an
   ethnographic interview study that investigated whether a pattern of
   HIV-related risk behavior varies across subpopulations of minority
   adolescents by studying behaviors and perceptions of risk for HIV
   infection among two ethnic groups of 314 Black
   adolescents-African-American and Haitian Blacks. Of those who had sex
   within the past 6 months and were current drinkers, 69\% said they did
   not have sex after drinking. Although many of the adolescents believe
   that drinking has a disinhibitory effect and may be a factor in nonuse
   of condoms, alcohol is but one element in a constellation of factors
   related to sexual intercourse and condom use.},
