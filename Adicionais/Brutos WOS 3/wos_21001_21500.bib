@article{ WOS:000289164200073,
Author = {Marzocchi, O. and Breustedt, B. and Mostacci, D. and Zankl, M. and
   Urban, M.},
Title = {THEORETICAL ASSESSMENT OF WHOLE BODY COUNTING PERFORMANCES USING
   NUMERICAL PHANTOMS OF DIFFERENT GENDER AND SIZES},
