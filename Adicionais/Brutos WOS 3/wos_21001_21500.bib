@inproceedings{ WOS:000234955700127,
Author = {Trigger, D and Mulcock, J},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Native vs exotic: cultural discourses about flora, fauna and belonging
   in Australia},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
