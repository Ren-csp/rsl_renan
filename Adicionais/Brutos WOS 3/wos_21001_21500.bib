@inproceedings{ WOS:000079959900104,
Author = {Omulo, MA},
Editor = {Riemer, PWF and Smith, AY and Thambimuthu, KV},
Title = {Potential areas for AIJ projects in Kenya},
Booktitle = {GREENHOUSE GAS MITIGATION: TECHNOLOGIES FOR ACTIVITIES IMPLEMENTED
   JOINTLY},
Year = {1998},
Pages = {725-731},
Note = {International Conference on Technologies for Activities Implemented
   Jointly, VANCOUVER, CANADA, MAY 26-29, 1997},
Organization = {Int Energy Agcy Greenhouse Gas Res \& Dev Programme},
Abstract = {Many local and international actors are geared on increased flows of
   development assistance, through AIJ. Sustainable development will
   require that massive funding levels for development assistance is
   increased. This paper identifies three sectors where AIJ could bring
   tangible benefits to Kenya as well as massive benefits to the
   environment in terms of greenhouse gas emissions reduction.
   The energy sector is one of the potential areas for AIJ activities.
   Kenya has few developed domestic energy sources, despite the potential,
   little attention has been paid in the past to the potential for domestic
   energy from existing renewable resources. There is potential for
   exploitation of existing renewable energy resources using decentralized
   small scale renewable energy technologies based on wind and solar power.
   The key requirement is that energy gets to as many people as possible.
   Possible participants are local and international private industries and
   of course the Government in prioritizing and promoting their use.
   Private industry has not really understood the potential in this sector,
   while on the other hand the Government has in the past heavily taxed the
   sector. The sector could also benefit from AIJ in terms of
   reconstruction of old power stations and reductions in transmission
   costs. The key players are in the Government who should liberalize the
   sector to set things in motion. The requirements could include least
   cost energy planning and setting minimum efficiency standards for
   appliances, vehicles and industrial motors.
   The other area is the transport sector which has a wide variety of
   proven options including increasing affordable public transport, by
   discouraging private car use, shifting freight from road to rail. The
   possible participants include local and international private industries
   and Government. For instance, the private industry could set up urban
   car clinics to fine-tune engines for more efficient operations, raise
   public awareness, save fuel and foreign exchange. The third potential
   sector for AIJ is the production industry. This requires modernization
   of the polluting production industries using environmentally friendly
   technologies.
   There is great potential for the sectors to contribute to greenhouse gas
   emissions reduction. Kenya should therefore take advantage of the
   development potential offered in AIJ/JI by focusing attention primarily
   on sectors such as energy, transport and industry and promote science
   and technology in these areas.},
