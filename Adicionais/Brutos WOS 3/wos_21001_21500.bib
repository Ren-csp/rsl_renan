Title = {Influence of neuroticism, ethnicity, familism, and social support on
   perceived burden in dementia caregivers: Pilot test of the transactional
   stress and social support model},
Journal = {JOURNALS OF GERONTOLOGY SERIES B-PSYCHOLOGICAL SCIENCES AND SOCIAL
   SCIENCES},
