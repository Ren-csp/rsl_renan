@inproceedings{ WOS:000380411200008,
Author = {Shintani, Nanae and Nagaoka, Hiroyasu and Koike, Eriko and Tatsukawa,
   Shigeki and Kajimura, Ayako},
Editor = {Shih, YC and Liang, SFM},
Title = {How do you support breast cancer patients on work-treatment balance?},
Booktitle = {BRIDGING RESEARCH AND GOOD PRACTICES TOWARDS PATIENT WELFARE: HEALTHCARE
   SYSTEMS ERGONOMICS AND PATIENT SAFETY 2014},
Year = {2015},
Pages = {71-77},
Note = {PROCEEDINGS OF THE 4TH INTERNATIONAL CONFERENCE ON HEALTHCARE SYSTEMS
   ERGONOMICS AND PATIENT SAFETY, TAIPEI, TAIWAN, JUN 23-26, 2014},
Abstract = {The number of patients who contract or die of breast cancer in Japan is
   increasing year by year. A peak age of onset of breast cancer is late
   40s'. So some patients have to work and receive chemical treatments at
   the same time in their productive years. The purpose of this study is to
   clarify difficulties of continuing work while getting chemotherapy for
   breast cancer outpatients, to clarify patients' thoughts and problems
   behind them, and to contribute to improving the Quality Of Life of
   breast cancer patients. This study targets 11 patients who were
   diagnosed with breast cancer in a center hospital in A prefecture, and
   they continue to work while receiving chemotherapy. A semi-structured
   interview was conducted for them, its results were analyzed by means of
   text-mining approach. The software used in the study for text-mining
   approach was IBM SPSS Text Analytics for Survey Ver.4.0, and
   characteristic sentences were summarized to review the results, which
   were gained to categorize what the patients said as ``In Difficulty{''}
   by use of emotion analyzing function. This study gained approval by
   ethical committee at the institution the author once belonged to. The
   results suggest the need to encourage and support the patients by
   various institutions to which the patients belong to work in
   consideration of their disease characteristics.},
Publisher = {CRC PRESS-TAYLOR \& FRANCIS GROUP},
Address = {6000 BROKEN SOUND PARKWAY NW, STE 300, BOCA RATON, FL 33487-2742 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Shintani, N (Corresponding Author), Kansai Univ Int Studies, Dept Nursing, Fac Hlth Sci, Miki, Hyogo, Japan.
