@inproceedings{ WOS:000189458900015,
Author = {Mottershead, DN},
Editor = {Mitchell, DJ and Searle, DE},
Title = {Local variability of marine influence on coastal rock weathering rates:
   A long-term study},
Booktitle = {STONE DETERIORATION IN POLLUTED URBAN ENVIRONMENTS},
Series = {Land Reconstruction and Management Series},
Year = {2004},
Volume = {3},
Pages = {229-252},
Note = {Stone-Weathering-and-Atmospheric-Pollution-Network Conference, Univ
   Wolverhampton, Wolverhampton, ENGLAND, MAY 09-12, 1999},
Organization = {Univ Wolverhampton, Sch Appl Sci; Univ Wolverhampton, Sch Engn; Univ
   Wolverhampton, Built Environm},
Abstract = {Exposure to marine salts increases rock weathering rates locally in
   coastal environments. Historic structures up to 500 years old expose
   several different rock types to coastal weathering and enable long-term
   rock weathering rates to be derived. The spatial variations demonstrated
   by these structures enables the evaluation of the influence on rock
   weathering rates of exposure to marine salts. Aspect, elevation and
   proximity to the source of salts (the shoreline) cause quantifiable and
   significant effects on the weathering rates of different rock types.
   Granite and arenaceous rocks suffer accelerated weathering; the
   weathering rate of some slaty rocks is apparently diminished.},
