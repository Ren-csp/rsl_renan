Title = {Investigating gene-to-behavior pathways in psychiatric disorders - The
   use of a comprehensive behavioral test battery on genetically engineered
   mice},
Booktitle = {INTEGRATED MOLECULAR MEDICINE FOR NEURONAL AND NEOPLASTIC DISORDERS},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2006},
Volume = {1086},
