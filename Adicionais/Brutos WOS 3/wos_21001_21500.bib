@inproceedings{ WOS:000248200500039,
Author = {Parn, J. and Mander, U.},
Editor = {Brebbia, CA and Katsifarakis, KL},
Title = {Landscape factors of nutrient transport in temperate agricultural
   catchments},
Booktitle = {RIVER BASIN MANAGEMENT IV},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2007},
Volume = {104},
Pages = {411+},
Note = {4th International Conference on River Basin Management, Kos, GREECE,
   MAY, 2007},
Organization = {Wessex Inst Technol; WIT Transact Ecol \& Environm; Prince Sultan Res
   Ctr Environm, Water \& Desert},
Abstract = {The influence of landscape factors on nutrient fluxes is highly
   variable, depending on which fluxes dominate and vary in the subject
   catchment. Watersheds where the input is the most variable source, soil
   qualities, the proportion of certain land uses, proximity to the water
   body and runoff determine nutrient transport. In catchments, where
   variation in chemical and physical conduits and barriers determines the
   flows, the factors of the landscape pattern also explain the differences
   in nutrient losses.
   Nitrogen, apart from other nutrients, is better determined by factors of
   agriculture and the qualities of the soil. Due to the relevance of
   anaerobic conditions in denitrification, one of the specifically
   important factors is water regime. It has been proposed that the
   greatest variance among nitrogen losses occurs in small catchments (<
   5000ha). Attention to that should help address issues of scale in
   nutrient transport research.
   Phosphorus is more strongly connected with physical factors, especially
   flow conduits and barriers. There is a well established link with the
   amount of riparian buffers. The proportion of urban land use also has a
   relatively great influence.},
