@article{ WOS:000234100500004,
Author = {Perera, BJC and James, B and Kularathna, MDU},
Title = {Computer software tool REALM for sustainable water allocation and
   management},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2005},
Volume = {77},
Number = {4},
Pages = {291-300},
Month = {DEC},
Note = {International Congress on Modelling and Simulation, Townsville,
   AUSTRALIA, JUL 14-17, 2003},
Organization = {Modelling \& Simulat Soc Australia \& New Zealand; Environm Modelling \&
   Software; CSIRO; James Cook Univ; Japan Soc Simulat Technol; IMACS; SCS},
Abstract = {REALM (REsource ALlocation Model) is a generalised computer simulation
   package that models harvesting and bulk distribution of water resources
   within a water supply system. It is a modeling tool, which can be
   applied to develop specific water allocation models. Like other water
   resource simulation software tools, REALM uses mass-balance accounting
   at nodes, while the movement of water within carriers is subject to
   capacity constraints. It uses a fast network linear programming
   algorithm to optimise the water allocation within the network during
   each simulation time step, in accordance with user-defined operating
   rules. This paper describes the main features of REALM and provides
   potential users with an appreciation of its capabilities. In particular,
   it describes two case studies covering major urban and rural water
   supply systems. These case studies illustrate REALM's capabilities in
   the use of stochastically generated data in water supply planning and
   management, modelling of environmental flows, and assessing security of
   supply issues. (c) 2005 Elsevier Ltd. All rights reserved.},
