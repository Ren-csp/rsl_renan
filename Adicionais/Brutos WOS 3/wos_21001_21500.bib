@inproceedings{ WOS:000072400000007,
Author = {Conlan, DE and Crumbley, A and Raper, DW and Owen, B},
Editor = {Power, H and Tirabassi, T and Brebbia, CA},
Title = {The role of local authorities in developing Air Quality Management in
   the UK},
Booktitle = {AIR POLLUTION V},
Year = {1997},
Pages = {69-78},
Note = {5th International Conference on Air Pollution - Modelling, Monitoring
   and Management (AIR POLLUTION V), BOLOGNA, ITALY, SEP 16-18, 1997},
Organization = {Wessex Inst Technol, Southampton; CNR, Ist Studio Fenomeni Fis \& Chim
   Bassa Alta Atmosfera, Bologna},
Abstract = {In the United Kingdom local authorities have been placed with a duty to
   review air quality on a regular basis from April 1997. Where national
   air quality standards are predicted not to be met by the year 2005 there
   will be a need to designate these `hot spot' areas as Air Quality
   Management Areas. This paper presents a case study based in an urban
   area in north west England which identifies the most likely areas to be
   classified as `hot spots'. Initial emission estimates have been made for
   this area both at a present and 2005 scenario. Air quality
   concentrations both within and surrounding the study region have been
   determined to assess exceedence of standards both now and the likelihood
   of exceedence in 2005. It is anticipated that national standards for
   sulphur dioxide, nitrogen dioxide, ozone and particulate matter will be
   regularly exceeded in the Borough of Wigan. In order to address air
   quality now and into the next century a management structure needs to be
   adopted in the form of an Air Quality Management Strategy. This should
   be on a comprehensive and integrated basis where air quality monitoring
   is undertaken, emissions and dispersive forecasts are carried out,
   especially in relation to planning and road transportation developments,
   and control strategies are formulated to reduce emissions and increase
   awareness.},
