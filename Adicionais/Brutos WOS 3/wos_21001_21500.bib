@inproceedings{ WOS:000307436500005,
Author = {Mortsch, L. D.},
Editor = {Linkov, I and Bridges, TS},
Title = {Multiple Dimensions of Vulnerability and Its Influence on Adaptation
   Planning and Decision Making},
Booktitle = {CLIMATE: GLOBAL CHANGE AND LOCAL ADAPTATION},
Series = {NATO Science for Peace and Security Series C-Environmental Security},
