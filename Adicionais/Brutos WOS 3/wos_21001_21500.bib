@article{ WOS:000233459000005,
Author = {Gómez, DR and Giné, MF and Bellato, ACS and Smichowski, P},
Title = {Antimony: a traffic-related element in the atmosphere of Buenos Aires,
   Argentina},
Journal = {JOURNAL OF ENVIRONMENTAL MONITORING},
Year = {2005},
Volume = {7},
Number = {12},
Pages = {1162-1168},
Note = {1st International Workshop on Antimony in the Environment, Univ
   Heidelberg, Inst Environm Geochem, Heidelberg, GERMANY, MAY 16-19, 2005},
Abstract = {Vehicular traffic is one of the main sources of antimony in highly
   populated urban areas like Buenos Aires where an overall traffic density
   of 1 500 000 vehicles per day ( corresponding to 7500 vehicles km(-2))
   is estimated. In this context, a study was undertaken to ascertain the
   levels of Sb and other traffic-related elements ( TRE) in the atmosphere
   of this city. To this end, sixty-seven samples of PM-10 particulate
   matter were collected during eight days in nine representative sampling
   sites located downtown Buenos Aires and spread over an area of about 30
   km(2). The collection of particulate matter was performed on ash-free
   glass fibre filters using high volume samplers with PM-10 sampling
   heads. A combination of aqua regia and perchloric acid was used for
   leaching metals from filters. The resulting solutions were evaporated
   and then diluted with 0.1 mol l(-1) HCl. Antimony was determined by
   inductively coupled plasma-quadrupole mass spectrometry ( ICP-QMS) at ng
   g(-1) levels. Concentrations of Sb varied from 12.9 +/- 0.9 to 375 +/-
   23 mu g g(-1) ( equivalent to 0.87 +/- 0.06 to 15.3 +/- 0.8 ng m(-3)).
   Statistical analysis was performed on the data set including the
   measured PM-10 mass and Sb concentrations for the monitored period.
   Correlations of Sb with other TRE namely, Cu and Mo were also assessed.
   The highest concentrations of Sb were detected at two sites ( Hospital
   Aleman and Casa Rapallini) located in streets with traffic consisting
   mostly of passenger cars and showing a ``stop- and-go{''} pattern in
   peak hours. Antimony levels in the Buenos Aires PM-10 are by far below
   the level of 0.5 mg m(-3) ( for an 8 hour workday, 40 hour work week)
   set by the US Occupational Safety and Health Administration ( OSHA) for
   occupational exposure. However, monitoring of Sb and other TRE should be
   carried out in a systematic fashion to detect the possibility of
   increases in from the present levels.},
Publisher = {ROYAL SOC CHEMISTRY},
Address = {THOMAS GRAHAM HOUSE, SCIENCE PARK, MILTON RD, CAMBRIDGE CB4 0WF, CAMBS,
   ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Smichowski, P (Corresponding Author), Comis Nacl Energia Atom, Unidad Act Quim, Av Gral Paz 1499,B1650KNA, San Martin, Argentina.
   Comis Nacl Energia Atom, Unidad Act Quim, San Martin, Argentina.
   Univ Sao Paulo, Ctr Energia Nucl Agr, BR-13416000 Sao Paulo, Brazil.},
DOI = {10.1039/b508609d},
ISSN = {1464-0325},
EISSN = {1464-0333},
Keywords-Plus = {AIRBORNE PARTICULATE MATTER; METAL EMISSIONS; TRACE-METALS; AEROSOL;
