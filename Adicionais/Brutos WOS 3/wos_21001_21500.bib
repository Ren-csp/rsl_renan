@article{ WOS:000080310800007,
Author = {Hallak, KM and Schenk, M and Neale, AV},
Title = {Evaluation of the two-step tuberculin skin test in health care workers
   at an inner-city medical center},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {1999},
Volume = {41},
Number = {5},
Pages = {393-396},
Month = {MAY},
Note = {American Occupational Health Conference, ORLANDO, FLORIDA, MAY 09-16,
   1997},
Abstract = {The increased rate of tuberculosis (TB) infection and transmission from
   patients to health care workers (HCWs) has brought awareness of the need
   for better surveillance programs, The two-step purified protein
   derivative (PPD) shin test decreases the misinterpretation of a
   ``boosted reaction{''} as a recent infection with Mycobacterium
   tuberculosis in HCWs, We reviewed the medical records of 4082 HCWs at an
   inner-city medical center who had PPD skin-testing performed as a
   component of the TB medical surveillance program during the years 1994
   and 1995. Of those HCWs tested, 3896 (95.4\%) returned for the PPD
   skin-test evaluation. Of those 3896 HCWs, 3659 (93.9\%) had a negative
   baseline PPD shin test, and 237 (6.1\%) had a positive shin test. Of
   those HCWs with a negative baseline shin test, 252 (6.9\%) were eligible
   for the second PPD shin test. Of the 241 who returned for their second
   PPD skin-test reading; six (2.5\%) had positive results. All six cases
   were foreign-born physician residents with a previous history of Bacille
   bilie de Calmette-Guerin (BCG) vaccination. We conclude that the
   two-step PPD shin test method is not indicted for HCWs at this urban
   medical facility.},
