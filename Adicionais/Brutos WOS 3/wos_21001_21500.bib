@article{ WOS:000078223800009,
Author = {Allen, TD and Russell, JEA},
Title = {Parental leave of absence: Some not so family-friendly implications},
Journal = {JOURNAL OF APPLIED SOCIAL PSYCHOLOGY},
Year = {1999},
Volume = {29},
Number = {1},
Pages = {166-191},
Month = {JAN},
Note = {55th Annual Meeting of the Academy-of-Management, VANCOUVER, CANADA, AUG
   06-09, 1995},
Organization = {Acad Management},
Abstract = {This experiment examined the effects of rate gender, type of leave of
   absence, and level of performance on perceptions of organizational
   commitment, work commitment, family commitment, and recommendations for
   organizational rewards. The proposed 3-way interactions between gender,
   type of leave of absence, and performance level were not supported;
   however, main effects and 2-way interactions were revealed. Moreover,
   perceived organizational commitment and work commitment were found to
   moderate the relationship between performance level and reward
   recommendations. The findings also indicated that men who were depicted
   as taking a leave of absence from work for parental reasons were less
   likely to be recommended for rewards than were males who had not taken a
   leave of absence.},
