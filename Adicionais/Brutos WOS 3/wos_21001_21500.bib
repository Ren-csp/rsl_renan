@inproceedings{ WOS:000256004300038,
Author = {Yu Longsheng and Peng Shaolin and Hou Yuping and Liang Guanfeng},
Editor = {Feng, CG and Huang, P and Shen, A and Wang, YJ and Li, SC and Su, Q},
Title = {Comparison of community characteristics of five artificial forests in
   Coloane, Macao},
Booktitle = {PROCEEDINGS OF THE CHINA ASSOCIATION FOR SCIENCE AND TECHNOLOGY, VOL 4,
   NO 3},
Year = {2008},
Pages = {172-176},
Note = {Annual Conference of the China-Association-for-Science-and-Technology,
   Wuhan, PEOPLES R CHINA, SEP 08-14, 2007},
Organization = {China Assoc Sci \& Technol},
Abstract = {Vegetation restoration of Coloane can greatly improve the urban
   eco-environment of Macao. Generally, during the artificial restoration
   of vegetation, different tree species may play different roles and show
   variable impacts on the other plants in the same communities. In order
   to understand how much the introduced species contribute to community
   construction, five artificial forest communities in Coloane, Macao, were
   investigated and community characteristics were compared to each other.
   Ten sample plots, with 10mx10m, were selected for detailed field survey
   in Coloane. Height, DBH (Diameter at Breast High) and crown diameter
   were recorded for each tree. Four subplots, with 5mx5m, in the big plots
   were set up for the recording of species name, number of individuals,
   height and coverage in the shrub layer. However, for the herbal layer,
   only one subplot, with 2mx2m, was set up in the big plots for the
   species name, number of individuals and coverage. The community
   ecological features of the communities in species composition,
   appearance and vertical structure and organized structure indexes were
   analyzed, and age-structures and growth situations of dominant species
   in different communities were further analyzed. According to the
   analysis results, the species composition, appearance and vertical
   structure of Acacia confusa forest and Schima superba forest were
   superior to Michelia macclurei forest and Casuarina equiselifolia
   forest. Shannon-Weiner indexes of Pinus massoniana forest, Acacia
   confusa forest, Schima superba forest, Michelia macclurei forest and
   Casuarina equisetifolia forest were 2.652 > 2.448 > 2.422 > 2.301 >
   2.089; Species richness showed the same tendency with SW index.
   Ecological dominance of Acacia confusa forest and Schima superba forest
   were 0.137 and 0.133 respectively, which were lower than others,
   Furthermore, species age structure and growth situation of Acacia
   confusa and Schima superba were superior to others. According to the
   results of different communities, the community structure of Acacia
   confusa forest and Schima superba forest were better than Michelia
   macclurei forest and Casuarina equisetifolia forest, and Pinus
   massoniana forest was declining. In conclusion, Acacia confusa and
   Schima superba were considered to be more suitable for restoration in
   Macao. By the way, some suggestions were provided for further
   restoration.},
