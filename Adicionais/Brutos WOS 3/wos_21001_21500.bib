@inproceedings{ WOS:A1996BH44G00020,
Author = {Thacker, NP and Vaidya, MV and Sipani, M},
Book-Group-Author = {NATL RES CTR CAIRO},
Title = {Sustainability of Indian water systems for organohalides},
Booktitle = {THIRD CONGRESS OF TOXICOLOGY IN DEVELOPING COUNTRIES, PROCEEDINGS, VOL
   III: THEME: TOGETHER FOR HUMAN AND ENVIRONMENTAL WELFARE},
Year = {1996},
Pages = {213-222},
Note = {3rd Congress of Toxicology in Developing Countries - Together for Human
   and Environmental Welfare, CAIRO, EGYPT, NOV 19-23, 1995},
Organization = {Natl Res Ctr Cairo},
Abstract = {Organohalides are non-biodegradable, persist longer, transform. into
   more toxic compounds and some are also generated by the use of chlorine
   as a disinfectant. The present paper reports the status of water
   resources in Indian urban areas for organochlorine pesticides (OClPs)
   and disinfection byproducts trihalomethanes (THMs). The studies indicate
   contamination of the water sources at Agra, Ahmedabad, Allahabad,
   Calcutta, Delhi, Kanpur, Madras, Nagpur and Varanasi with Y-HCH and DDT.
   The levels to the extent of 12 ug/l for Y-ECH and 4 ug/l for DDT have
   been found in intake waters of the treatment plants. Instantaneous THMs
   (InstTHMs) and THMs formation potential (TFP) were measured during pre-
   and post- chlorination at the water treatment plants. THMs
   concentrations in finished water samples were found as : chloroform 0.5
   to 18.14 ug/l, median 5.2 ug/l; bromodichloromethane 1 to 12.64 ug/l,
   median 2.84 ug/l; dibromochloromethane 0.3 to 4.6 ug/l, median 1.4 ug/l
   and bromoform 0.1 to 7.3 ug/l, median 1.3 ug/l. TFP equivalents of
   chloroform were measured in finished waters and highest value was found
   as 123.84 ug/l. Studies reported the presence of OClPs and THMs in the
   waters and recommended for more stringent and continuous monitoring of
   the water systems.},
