Pages = {927-932},
Note = {26th Annual Conference of the Cognitive-Science-Society, Chicago, IL,
   AUG 04-07, 2004},
Organization = {Cognit Sci Soc},
Abstract = {In eye-movement experiments using gaze-contingent windows, the stimulus
   display is continuously updated in response to the participant's current
   gaze position. Usually, a window is centered at the participant's gaze
   position and follows it wherever the participant looks. Within the
   window, all stimulus information is visible, while outside of the window
   at least part of the information is masked. In the present paper, we
   apply this technique to a face recognition task. By varying the size of
   the window, we gain insight into face recognition processes in humans
   and characterize the visual information on which face recognition
   relies. The results also motivate the use of gaze-contingent windows to
   study visual perception.},
