Title = {Exploration of a dialog-based tunable retina encoder for retina implants},
Booktitle = {COMPUTATIONA L NEUROSCIENCE: TRENDS IN RESEARCH 1999},
Year = {1999},
Pages = {1005-1011},
Note = {7th Annual Computational Neuroscience Meeting (CNS 98), SANTA BARBARA,
   CA, JUL, 1998},
Abstract = {We propose a learning retina encoder (RE) with tunable spatiotemporal
   functions and corresponding perception-based dialog procedure for a
   retina implant as visual prosthesis. A learning DSP-based RE was
   developed for real time implementation of about 200 individually tunable
   spatiotemporal receptive field (RF)-filters approximating M- or
   P-ganglion cells to map visual patterns onto pulse trains as stimulation
   inputs for implanted microcontact foils. An experimental environment
   providing visual feedback for humans with normal vision was developed to
   test the adaptive dialog module. With the presented tuning schema,
   interaction of RE and dialog module becomes possible even before tests
   with blind subjects. (C) 1999 Elsevier Science B.V. All rights reserved.},
