@inproceedings{ WOS:000280689300026,
Author = {Zheng Haixia},
Editor = {Zhang, H and Zhang, H},
Title = {Chinese Practices of Ecological Compensation and Payments for
   Environmental Services in River Basin - Case Study of Water Source,
   Beijing, China},
Booktitle = {DYNAMICS OF URBAN AGGLOMERATION IN CHINA: PREFERENCES OF ENERGY-SAVING
   AND ENVIRONMENT-FRIENDLY SOCIETY},
Year = {2009},
Pages = {130-136},
Note = {International Symposium on Sustainable-Development-of-City-Group,
   Changsha, PEOPLES R CHINA, NOV 16, 2009},
Organization = {Sustainable Dev City Grp; Cent S Univ, Hunan Inst Syst Engn \&
   Management},
Abstract = {Payment for environmental services (PES) is a key instrument to
   alleviate poverty and conserve environment with the implementation of
   Natural Forest Protection Project (NFPP), Sloping Land Conversion
   Project (SLCP) and Forest Ecological Compensation Project (FECP). This
   paper analyses PES in China and gives an elaborative case study in Miyun
   Reservoir, water sources of Beijing City. Through the analysis of PES
   practices and cases in China, it was realized that PES in China has
   political, social, economic and legal basis. At present, PES in China
   has been widely carried out in different scale due to the efforts of
   government, and the means of payment are mainly by national ecological
   compensation programs, local government-dominant initiatives, and
   voluntary trade market, especially within the small watersheds, water
   right trade and ecological compensation from water rates, which form the
   main scheme of PES in China. At the moment, the government still plays a
   role of payer and facilitator in the PES. Miyun reservoir is a key
   surface water source of Beijing, and more than 60 catchments of Miyun
   reservoir located in Hebei province. Due to the separation of supply
   water and use water, PES is efficiency methods for headwaters protection
   and also an important instrument to make sustainable development between
   Beijing and its water sources regions. The research explore the mode,
   mechanism, drive and obstacle and implement assessment and learning of
   the PES in water source of Beijing, and put forward some countermeasure.
   The results show that it is important to make water rights clear for the
   establishment of PES mechanism. Increasing in income and economic
   development are still key drive forces of participation in PES of local
   farmers and government, but PES don't results in increasing of farmers'
   income in Miyun reservoir, due to the imperfectness of the relevant
   legislation, ambiguous water right, indistinct duties and rights of the
   stakeholders and high trade costs. On funds collection, people don't
   think tax is an equity way for PES.},
