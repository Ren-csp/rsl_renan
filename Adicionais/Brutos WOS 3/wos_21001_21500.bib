   HENLEY, M},
Title = {PSYCHOSOCIAL FACTORS RELATED TO PERCEIVED COMPLIANCE WITH
   CYSTIC-FIBROSIS TREATMENT},
Journal = {JOURNAL OF CLINICAL PSYCHOLOGY},
