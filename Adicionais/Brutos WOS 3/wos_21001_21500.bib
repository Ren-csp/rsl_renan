@article{ WOS:000224945200011,
Author = {Boardman, JD},
Title = {Health pessimism among black and white adults: the role of interpersonal
   and institutional maltreatment},
Journal = {SOCIAL SCIENCE \& MEDICINE},
Year = {2004},
Volume = {59},
Number = {12},
Pages = {2523-2533},
Month = {DEC},
Note = {Annual Meetings of the American-Sociological-Association, ATLANTA, GA,
   AUG 16-19, 2003},
Organization = {Amer Sociol Assoc},
Abstract = {Using data from the 1995 Detroit Area Study (N = 1106) this paper finds
   that black adults report significantly worse self-rated health when
   compared to whites with similar levels of self-reported morbidity. This
   relationship, called health pessimism, persists despite statistical
   controls for age, gender, socioeconomic status, health care access, and
   health related behaviors. Interpersonal maltreatment is found to be
   positively associated with health pessimism and more importantly, when
   comparing adults who perceive similar levels of maltreatment, white and
   black adults do not differ with respect to health pessimism. This
   suggests that the increased risk of health pessimism among black adults
   is due in part to race differences in the perception of interpersonal
   maltreatment. (C) 2004 Elsevier Ltd. All rights reserved.},
