@inproceedings{ WOS:000361123400003,
Author = {Liu, Chang-Li and Zhang, Yun and Hou, Hong-Bing and Yang, Chun-Xiao},
Book-Group-Author = {Destech Publicat Inc},
Title = {Experimental and Numerical Study of Pollution Process in an Aquifer in
   Relation to a Garbage Dump Field},
Booktitle = {INTERNATIONAL CONFERENCE ON ENVIRONMENTAL PROTECTION AND HUMAN HEALTH
   (EPHH 2014)},
Year = {2015},
Pages = {15-26},
Note = {International Conference on Environmental Protection and Human Health
   (EPHH), Wuhan, PEOPLES R CHINA, DEC 13-14, 2014},
Abstract = {The water quality of shallow aquifers that have direct relationships to
   human heath and ecological safety has been seriously threatened by the
   widespread dumps of industrial solid waste and urban, rural garbage. We
   chose a garbage dump field that has typical hydrogeological,
   environ-geological characteristics in the Beijing plain. We then
   constructed a hydrogeological model and used the equations describing
   pollutant transport in one-dimensional steady, uniform groundwater flow
   to investigate the transport/diffusion processes of garbage pollutants
   within the aquifer. In addition to the coefficients available for
   calculation we obtained the diffusion coefficient and other coefficients
   of the aquifer by conducting in situ diffusion experiment and sample
   test. This enabled us to calculate the velocity and scope of pollutant
   transport/diffusion process in the aquifer. Accordingly, the real
   pollution situation in the aquifer was evaluated through in situ
   drilling and sample testing. We find that the transport/diffusion
   processes of pollutants within the aquifer abide by the solute equation
   applicable to one-dimensional steady flow. The transport and diffusion
   dominates in the direction of groundwater flowing at a speed of about
   120 meters per year. Comparably, the lateral diffusive width is much
   smaller. Pollution degree decreases by the law of Y=1.08exp (33.533/X),
   where Y is the distance from the garbage dump field and X is the overall
   pollution index.},
