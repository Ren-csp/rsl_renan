@article{ WOS:000072221100003,
Author = {Mehta, S},
Title = {Relationship between acculturation and mental health for Asian Indian
   immigrants in the United States},
Journal = {GENETIC SOCIAL AND GENERAL PSYCHOLOGY MONOGRAPHS},
