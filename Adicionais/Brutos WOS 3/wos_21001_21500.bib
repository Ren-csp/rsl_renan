Booktitle = {BUILDING SUSTAINABLE HEALTH ECOSYSTEMS},
Series = {Communications in Computer and Information Science},
Year = {2016},
Volume = {636},
Pages = {238-252},
Note = {6th International Conference on Well-Being-in-the-Information-Society
