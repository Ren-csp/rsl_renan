@inproceedings{ WOS:000309373900323,
Author = {Cheng Cuiyun and Ren Jingming and Wang Rusong and Liu Feng},
Editor = {Xu, QJ and Ge, HH and Zhang, JX},
Title = {Eco-efficiency assessment of farming activity in China},
Booktitle = {NATURAL RESOURCES AND SUSTAINABLE DEVELOPMENT, PTS 1-3},
Series = {Advanced Materials Research},
Year = {2012},
Volume = {361-363},
Pages = {1776+},
Note = {International Conference on Energy, Environment and Sustainable
   Development (ICEESD 2011), Shanghai Univ Elect Power, Shanghai, PEOPLES
   R CHINA, OCT 21-23, 2011},
Organization = {Xinjiang Univ; Hebei United Univ},
Abstract = {This paper estimates the eco-efficiency of farming activity at a
   provincial scale in China based on Data Envelopment Analysis model. The
   results show that provinces in central area presented relatively lower
   eco-efficiency, the western provinces are higher eco-efficient, while
   provinces in eastern provinces are low or high eco-efficiency. It also
   indicates that provinces with higher crop production usually have lower
