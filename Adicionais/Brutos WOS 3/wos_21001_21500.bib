@article{ WOS:000179382900001,
Author = {Bahnson, CB},
Title = {The important differences between psychoanalytic individual and group
   therapy},
Journal = {DYNAMISCHE PSYCHIATRIE},
Year = {2002},
Volume = {35},
Number = {1-2},
Pages = {339-349},
Note = {13th World Congress of the World-Association-for-Dynamic-Psychiatry
   (WADP)/26th International Symposium for the German Academy for
   Psychoanalysis (DAP), MUNICH UNIV, MUNICH, GERMANY, MAR 13-17, 2001},
Organization = {World Assoc Dynam Psychiatr},
Abstract = {This article attempts to define the differences between individual and
   group analytic therapies. The training of analytic therapists
   predisposes them to work with individuals in the group rather than with
   the cross-personal group process. The group offers several advantages of
   mutual therapeutic work. However, the setting free of this potential
   requires an approach, that radically differs from the individual,
   sequential much greater thanone-to-onemuch less than therapy within the
   group. The group therapist(s) must steer the group process in a way,
   that allows for intensive interaction of the group members, so that the
   much greater thaninterpretationsmuch less than of conflict and emotion
   evolve among group members themselves, who jointly identify mutual
   problems and neurotic solutions, steered by the therapist's
   understanding, but, precicely not by individual interpretation as in
   individual therapeutic work. Deflecting the focus away from the much
   greater thanleader-therapistmuch less than to the shared emotional
   problems in the group, making use of the intensive problems among group
   members, furthers an effective analytically founded process in the
   group. Not one-to-one analytic work within the group, with other group
   members listening, but a conflict oriented group process, where mutually
   shared conflicts come to fore under the therapeutic guidance of the
   leader, brings movement and resolution of neurotic conflict for the
   participants.},
