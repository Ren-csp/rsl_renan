@article{ WOS:000074213100014,
Author = {Wiemer-Hastings, K},
Title = {Abstract noun classification: Using a neural network to match word
   context and word meaning},
Journal = {BEHAVIOR RESEARCH METHODS INSTRUMENTS \& COMPUTERS},
Year = {1998},
Volume = {30},
Number = {2},
Pages = {264-271},
Month = {MAY},
Note = {27th Annual Meeting of the Society-for-Computers-in-Psychology (SCiP),
   PHILADELPHIA, PA, NOV 20, 1997},
Abstract = {Psychologists have used artificial neural networks for a few decades to
   simulate perception, language acquisition, and other cognitive
   processes. This paper discusses the use of artificial neural networks in
   research on semantics-in particular, in the investigation of abstract
   noun meanings. It is widely acknowledged that a word's meaning varies
   with its contexts of use, but it is a complex task to identify which
   context elements are relevant to a word's meaning. The present study
   illustrates how connectionist networks can be used to examine this
   problem. A simple feedforward network learned to distinguish among six
   abstract nouns, on the basis of characteristics of their contexts, in a
   corpus of randomly selected naturalistic sentences.},
Publisher = {PSYCHONOMIC SOC INC},
Address = {1710 FORTVIEW RD, AUSTIN, TX 78704 USA},
