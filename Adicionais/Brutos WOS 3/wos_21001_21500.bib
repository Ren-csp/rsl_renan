@article{ WOS:000302825000041,
Author = {House, C. and Williams, J. and Cullis, M. J. and Phillips, M. R.},
Title = {Coastal sustainability: a comparative socio-economic lifestyle
   assessment, South Wales, UK},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2011},
Number = {2, 64},
Pages = {1233-1237},
Note = {11th International Coastal Symposium (ICS), Szczecin, POLAND, MAY 09-13,
   2011},
Organization = {Univ Szczecin, Inst Marine \& Coastal Sci; Coastal Educ \& Res Fdn; Univ
   Szczecinski (US); Cztowiek Nauka Srodowisko (CNS); ZMGM; Reg Dyrekcja
   Ochrony Srodowiska; Esri; Springer; Lotos; GA2 Syst; World Sci;
   Helmholtz-Zentrum Geesthacht; Nfosigm; Urzad Marszalkowski Wojewodztwa
   Zachodniopomorskiego; Wojewodzki Fundusz Ochrony Srodowiska I Gospodarki
   Wodnej W Gdansku},
Abstract = {House. C., Williams, J., Cullis, M.J. and Phillips MR., 2011. Coastal
   Sustainability: A Comparative socioeconomic lifestyle assessment, South
   Wales, UK. Journal of Coastal Research, SI 64 (Proceedings of the 11th
   International Coastal Symposium), 1233 - 1237. Szczecin, Poland, ISSN
   0749-0208
   The factors which influence sustainability in coastal management span
   social, economic, institutional, biophysical and legal conditions. There
   is a need to evaluate resource demands of coastal communities and assess
   socio-economic influences on sustainability. This paper addresses these
   issues by comparing two communities within the same administrative
   boundary using ecological footprint questionnaires. Community one, Rest
   Bay, is an affluent coastal area and community two is Caerau, a
   socio-economically deprived area in Wales. Resource demand and lifestyle
   differences were assessed and consequences identified for coastal
   sustainability using the sub-divisions of housing, energy, food,
   purchasing, transportation, and waste. Results demonstrated how and why
   people of varying socio-economic backgrounds impact coastal
   environments. Analysis showed that despite being more environmentally
   aware, Rest Bay residents had a significantly higher ecological
   footprint than Caerau residents at the 99\% confidence level (unpaired t
   test: t = 12.836; df = 198; p < 0.01). This validated the use of
   ecological footprints to benchmark coastal differences and associated
   strategies. Furthermore, it informs policy-makers of the need for
   spatially differentiated coastal management.},
