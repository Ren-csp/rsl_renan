@inproceedings{ WOS:000179444800094,
Author = {Khairy, MSED},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {The impact of ``Marginal housing{''} upon socio-cultural aspects at
   developing mega cities. Cairo city case study},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {763-771},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {Third World developing countries mega cities suffers from some common
   usual difficulties, mainly represented in the rapid rates of population
   growth, which exceeds the government's formal housing dwelling
   construction ability.
   Cairo city accelerating growth rates, were caused by different reasons,
   the most crucial are;
   The ambition of life-style change for many rural community inhabitants
   towards urbanization.
   Escalating growth rates, causing immigration towards mega cities, most
   immigrants are of ``no income groups{''}, not affording purchasing
   formal houses, or buying legal land lots, leading to the phenomenon of
   ``Marginal housing{''}.
   Many urbanized areas of mega-cities located in developing countries,
   suffers from some common urban problems, mainly represented in its
   increasing inflation rates as well as its escalating growth rates of
   population which exceeds governmental or official formal housing
   dwelling construction abilities.
   Egypt - as a part of developing countries - had witnessed during the
   second half of the twentieth century, several turnovers in policy,
   economy, social status as well as culture which had certainly affected
   the citizens' intentions, as well as ambition of life style.
   Cairo city - as a capital - was directly affected by various factors
   which caused the deterioration of its living environment urbanization
   aspects, the most crucial reasons were:
   The Continuous increasing inflation rates, caused by various national
   expenses, specially for military reasons, as well as its involvement in
   other international turning points.
   Escalating growth rates, causing immigration towards the capital by
   means of low-income groups, unaffordable to purchase formal houses or
   legal land lots; which had lead to the phenomenon of squatter
   settlements, slum areas and marginal housing.
   Life-style change ambition of many rural and desert inhabitants towards
   urbanization.
   As a result of not complying clear strategic planning to confront
   threats of those immigrants seeking accommodation \& job opportunity,
   Cairo city was not able to endorse more immigrants travelling daffy to
   the capital needing to abide in a legal proper dwelling or shelter.
   Options for those inhabitants to seek an appropriate shelter much more
   difficult, by which they were urged to inhabit some marginal or squatter
   settlements usually founded in the city peripheries or ``grey zones{''}.},
