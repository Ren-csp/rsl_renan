Number = {3},
Pages = {178-183},
Note = {Conference on Genomics, Genetics, and Society - Bridging the
   Disciplinary Divides, Toronto, CANADA, APR, 2004},
Organization = {Canadian Inst Hlth Res, Inst Genet},
Abstract = {This article examines the `knowledge deficit' model, which still
   persists in liberal, technological societies. It is based upon the
   assumption that expert forms of knowledge, both in the sciences and the
   humanities, provide a sufficient basis for deciding the most important
   public policy questions. In this view, public perceptions and beliefs
   that run counter to this expert knowledge provide unacceptable
   justifications for public policies. Instead, support of expert knowledge
   needs to be `built' through education and public relations strategies.
   This view is challenged on the basis of basic democratic theory, using
   the debate about genetically modified maize in Mexico as an example.
   `Knowledge deficits' also exist on the side of experts. Copyright (C)
   2006 S. Karger AG, Basel.},
