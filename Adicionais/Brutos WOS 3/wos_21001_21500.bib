@inproceedings{ WOS:000073814300035,
Author = {Wraith, JG and Ziegler, S},
Book-Group-Author = {INT EROSION CONTROL ASSOC},
Title = {Low flow augmentation structures for fisheries habitat creation design
   character and installation techniques},
Booktitle = {PROCEEDINGS OF CONFERENCE 28 - INTERNATIONAL EROSION CONTROL ASSOCIATION},
Series = {INTERNATIONAL EROSION CONTROL ASSOCIATION - PROCEEDINGS OF CONFERENCE},
Year = {1997},
Volume = {28},
Pages = {397-417},
Note = {Conference 28 of the International-Erosion-Control-Association on
   Erosion Control and the Environment - Working in Harmony, NASHVILLE, TN,
   FEB 25-28, 1997},
Organization = {Hydro Blanket; N Amer Green; Amer Excelsior Co, Earth Sci Div},
Abstract = {With the upgrade of rural roads to urban standard in the Regional
   Municipality of York, small stream crossings via C.S.P. culverts have
   normally been replaced with large multi-cell pre-cast or pour-in-place
   box culverts. These features are capable of conveying increased
   development induced discharges and vastly outsize the pre-development
   culverts. Typically associated with the installation of such civil works
   is a mitigation and compensation package for the enhancement of
   localized fisheries habitat disturbed through construction and streambed
   loss due to road widenings. Regional engineers, environmental planners
   and regulatory agencies have realized that the typical mitigation
   measures installed on streams adjacent to such box culverts were
   severely limited or restricted during base flow conditions due to the
   conveyance characteristics of the large box culvert cells.
   These structures are traditionally designed for high return period event
   discharges, typically the 50 or 100 year return storm volume, leaving a
   base flow discharge barely inundating the low flow cell. In this
   condition, the physical character of the base flow through the culvert
   makes fish passage, nesting and foraging impossible in and around the
   culvert, thus limiting the surrounding habitat enhancement features.
   Recently newly installed culverts of this type, (multi-cell) which were
   scheduled for installation on known productive coldwater fisheries, have
   been ``retrofitted{''} with cobble streambed material, wing deflector
   islands, and in some cases baffle structures. These works establish a
   narrow, deep low flow channel within the lowflow box cell, capable of
   supporting a variety of species with diverse flow patterns, adequate
   stage and suitable bed materials. Four individual installations are
   examined for design characteristics, habitat potential, short and long
   term results and suggested modeling methodology for overall design
   criteria.},
Publisher = {INT EROSION CONTROL ASSOC},
Address = {PO BOX 4904, STEAMBOAT SPRINGS, CO 80477 USA},
Type = {Proceedings Paper},
Language = {English},
