@inproceedings{ WOS:000458446600026,
Author = {Han, Inhwa and Won, Sanghyun and Kang, Yungeui and Oh, Kyungseok and
   Kim, Kyeonghui and Jekal, Janghwan and Jin, Sang Hyeon and Lee, Gi Hyun
   and Yang, Seung Tae and Jung, Seon Yoon and An, Jinung},
