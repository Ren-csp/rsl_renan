Volume = {22},
Number = {4, SI},
Pages = {808-814},
Month = {APR},
Note = {3rd International Conference on Nanotechnology, Pune, INDIA, OCT 14-15,
   2014},
Abstract = {Electrospinning has changed the perception of material and their
   characteristic properties by manufacturing optimized 1D nanostructure
   i.e., nanofibers. The parameters that influence diameter of electrospun
   nanofibers include rate of dispensing (flow rate), applied voltage,
   distance between syringe and drum collector. This paper analyses the
   influence of each of these parameters, keeping solution parameters
   constant. Analysis of Variance (ANOVA) a statistical tool with 2 K
   factorial method is used for analysis. Result obtained depict influence,
   parameter distance between syringe drum contributed 78\%, flow rate
   3.5\% and voltage 17.51\% in manufacturing the nylon 6 nanofibers. The
   minimum diameter 54 nm is synthesized with flow rate 0.1 ml/hr, distance
   between syringe and drum 15 cm and voltage 20 KV.},
