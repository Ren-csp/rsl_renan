Volume = {127},
Pages = {650-654},
Note = {4th International Conference on Psypsychology and the Realities of the
   Contemporary World (PSIWORLD), Bucharest Univ, Fac Psychol \& Educ Sci,
   Bucharest, ROMANIA, OCT 18-20, 2013},
Organization = {Romanian Soc Appl Expt Psychol},
Abstract = {The overall objective of this research is to highlight the predictive
   power of demographic characteristics (age, gender, marital status, the
   subject has / does not have children, level of education) and of the
   individual ones (job satisfaction, commitment to task) on the individual
   decision to accept or refuse a job in another town. Our results indicate
   that age, gender, marital status and whether subjects have children or
   not are significant predictors for the decision to accept job
   relocation. In contrast, the education level, job satisfaction,
   opportunity for personal development and spiritual perception of labour
   and the sense of initiatives do not have predictive power on the job
   relocation decision. (C) 2014 Adrian Gorbanescu. Published by Elsevier
   Ltd.},
