@inproceedings{ WOS:000230620300059,
Author = {Pulselli, RM and Pulselli, FM and Ratti, C and Tiezzi, E},
Editor = {Tiezzi, E and Brebbia, CA and Jorgensen, SE and Gomar, DA},
Title = {Dynamics and evolution of urban patterns: the evidence of the Mobile
   Landscape project},
Booktitle = {Ecosystems and Sustainable Development V},
