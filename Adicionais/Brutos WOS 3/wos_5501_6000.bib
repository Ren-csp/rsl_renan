Pages = {135-139},
Note = {International Conference on Psychology and the Realities of the
   Contemporary World (PSIWORLD), Fac Psychol \& Educ Sci, Bucharest Univ,
   Bucharest, ROMANIA, OCT 18-21, 2012},
Organization = {Romanian Soc Appl Expt Psychol},
Abstract = {Even though the control-value theory of achievement emotions has become
   more and more popular, few studies have so far investigated discrete
   academic emotions in the context of self-regulated learning and academic
   performance. Boredom seems an especially neglected emotion in the
   educational context {[}1]. Our research aims to investigate the way
   boredom relates to cognitive and motivational factors of self-regulated
   learning and their joint influence on academic achievement of seventh
   graders. Our results confirm that the effects of boredom on achievement
   are moderated by motivational regulation strategies, namely performance
   self-talk. (C) 2013 The Authors. Published by Elsevier B.V. Selection
   and/or peer-review under responsibility of PSIWORLD 2012},
