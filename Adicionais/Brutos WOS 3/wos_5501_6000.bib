@inproceedings{ WOS:000075224700030,
Author = {Stronge, WB and Schultz, RR},
Editor = {Magoon, OT and Converse, H and Baird, B and MillerHenson, M},
Title = {The economic benefits of a major urban beach: A case study of Broward
   County, Florida},
Booktitle = {CALIFORNIA AND THE WORLD OCEAN `97 - TAKING A LOOK AT CALIFORNIA'S OCEAN
   RESOURCES: AN AGENDA FOR THE FUTURE, VOLS 1 AND 2, CONFERENCE
   PROCEEDINGS},
Year = {1998},
Pages = {219-232},
Note = {California and the World Ocean 97 Conference on Taking a Look at
   Californias Ocean Resources - An Agenda for the Future, SAN DIEGO, CA,
   MAR 24-27, 1997},
Abstract = {This paper(2) provides an overview of an economic study of the beaches
   of Broward County, Florida, one of the largest urban beaches in the U.S.
   Broward County is in the center of the three county southeast Florida
   region. Dade County (Miami) and Palm Beach County (West Palm Beach) are
   south and north, respectively. Broward is the twenty-fourth largest
   county in population in the U.S. and combined the three counties have
   more than four million residents. The official value of Broward's real
   estate property exceeds \$60 billion. The principal cities along the
   coast are Fort Lauderdale, Hollywood, Pompano Beach, and Deerfield
   Beach. Broward's sandy beaches stretch continuously along twenty-five
   miles of narrow barrier island except for several maintained inlets to
   the Intracoastal Waterway. The barrier islands are occupied by mid to
   high rise condominiums and hotels, smaller one and two story motels, and
   single family residences, along with associated commercial businesses.
   There are two state parks that break up the continuous built-up nature
   of the coastal landscape. Because of Broward's subtropical location, its
   beaches are heavily used year-round. The combined effect of the large
   urban population, the heavily built-up nature of the barrier islands,
   and the subtropical location makes Broward's beaches an exceptionally
   valuable resource that increasingly demands public attention and
   evaluation.
   In this paper we provide estimates of the economic importance of the
   beaches of Broward County to the economies of the county, the region,
   and the State. Beaches make three types of contribution to the local
   economy: they add value to properties; they create sales, incomes and
   jobs as a result of increased resident and nonresident spending; and
   they increase the local and state tax base. We estimate that Broward's
   beaches add \$1.351 billion to local property values; that local
   economic production is higher by \$547.9 million because of the beaches;
   and that the beaches cause the revenues of local governments to be
   higher by \$29.2 million(Table A).},
