@article{ WOS:000078202400003,
Author = {Garcia, SD and Rivera, SM},
Title = {Perceptions of Hispanic and African-American couples at the friendship
   or engagement stage of a relationship},
Journal = {JOURNAL OF SOCIAL AND PERSONAL RELATIONSHIPS},
