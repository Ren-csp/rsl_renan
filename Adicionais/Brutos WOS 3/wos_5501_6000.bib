Title = {Climate Change Adaptation in Dutch Municipalities: Risk Perception and
   Institutional Capacity},
Booktitle = {RESILIENT CITIES: CITIES AND ADAPTATION TO CLIMATE CHANGE - PROCEEDINGS
   OF THE GLOBAL FORUM 2010},
Series = {Local Sustainability},
Year = {2011},
Volume = {1},
Pages = {265-272},
Note = {1st Annual Global Forum on Cities and Adaptation to Climate Change.
   Resilient Cities 2010, ICLEI, Bonn, GERMANY, MAY 28-30, 2010},
Organization = {EU European Regional Dev Fund; State N Rhine Westphalia; Fdn Int
   Dialogue Savings Bank Bonn; Solar World; Rockefeller Fdn; UNISDR; USAID;
   World Bank Inst},
Abstract = {This contribution presents case studies of nine Dutch municipalities.
   Interview-based data show that the drivers of local climate adaptation
   in these cases are determined more by local contextual factors than by
   past experience with flooding or an expected increase of climate change
   risk. The presence of larger institutional capacity did not prove to be
   determinative of the level of action in climate change adaptation
   policies. Only in urban cases where a green party administrator was
   responsible for environmental affairs was a high level of `adaptation
   action' observed. Another mediating factor appeared to be the variation
   in quality of climate change information.},
