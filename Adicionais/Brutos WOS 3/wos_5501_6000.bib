@article{ WOS:A1995TJ44000005,
Author = {SINCLAIR, RR and TETRICK, LE},
Title = {SOCIAL-EXCHANGE AND UNION COMMITMENT - A COMPARISON OF UNION
   INSTRUMENTALITY AND UNION SUPPORT PERCEPTIONS},
Journal = {JOURNAL OF ORGANIZATIONAL BEHAVIOR},
Year = {1995},
Volume = {16},
Number = {6},
Pages = {669-680},
Month = {NOV},
Note = {1993 Meeting of the
   Society-for-Industrial-and-Organizational-Psychology, SAN FRANCISCO, CA,
   MAY, 1993},
Organization = {Soc Ind \& Org Psychol},
Abstract = {In general, previous research suggests that the primary determinant of
   union members' level of union commitment is their satisfaction with the
   union's ability to secure desired levels of various work-related
   outcomes (wages, benefits etc.). This research is consistent with a
   social exchange based view of union commitment. Eisenberger et al.
   (1986, 1990) obtained support for the idea that social exchange is not
   entirely economic: perceptions of organizational support predicted
   several criteria. This study sought to extend organizational support
   perceptions to the union setting and test the relative contribution of
   members' perceptions of union support and instrumentality to prediction
   of union commitment. Hypotheses were tested by surveying 77 employees of
   a small northeastern state university. Results of correlational and
   multiple regression analyses indicated that perceptions of union support
   accounted for more variance in union commitment than did union
   instrumentality. This result held for the union's instrumentality
   relative to both traditional bargaining issues and issues important only
   to faculty members. However, contrary to predictions, exchange ideology
   did not moderate relations between union instrumentality and union
   commitment or between union support and union commitment.},
