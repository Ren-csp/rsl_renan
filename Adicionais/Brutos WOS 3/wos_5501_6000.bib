@inproceedings{ WOS:000391447900023,
Author = {Gao, Yan and Liu, Gengyuan and Hao, Yan and Zhang, Yan},
Editor = {Yan, J and Wennersten, R and Chen, B and Yang, J and Lv, Y and Sun, Q},
Title = {Ecological Network Based Urban Pollution Transfer Effect Analysis at A
   River Basin Scale},
Booktitle = {CLEAN ENERGY FOR CLEAN CITY: CUE 2016 - APPLIED ENERGY SYMPOSIUM AND
   FORUM: LOW-CARBON CITIES AND URBAN ENERGY SYSTEMS},
Series = {Energy Procedia},
Year = {2016},
Volume = {104},
Pages = {135-140},
Note = {Applied Energy Symposium and Summit - Low-Carbon Cities and Urban Energy
   Systems (CUE), Jinan Assoc Sci \& Technol, Jinan, PEOPLES R CHINA, JUN
   13-15, 2016},
Organization = {Int Journal Appl Energy; Appl Energy Innovat Inst; China Assoc Sci \&
   Technol HOME Program; Malardalen Univ, Future Energy Profile},
Abstract = {With rapid urbanization and industrialization many Chinese cities have
   seen water pollution reaching appalling levels causing severe health
   effects and growing public concern in river basin, which also impedes
   the development of cities in turn. In this paper, we propose a
   system-oriented Ecological Network Analysis (ENA) to study the
   influences big cities exert on the cancer villages in the river basin
   scale. The network control analysis is used to indicate the control
   influence big cities exert on the cancer villages. The risk flows are
   introduced to study the indirect risk flow from big cities to the cancer
   villages. The existence of a risk flow represents that the donor
   discharges a risk, while the receptor is suffered from the risk it
   exposed to. The risk flows between all functional components concerning
   both direct risk flows and integral risk flows are quantified and
   interpreted in the network model. This study took Huaihe River Basin as
   a case study to verify the feasibility of the methods. The results
   showed that this method could be used in future research works to
   highlight some to highlight some hidden facets of the
   environment-society relationship at a regional level and allow the
   investigator to raise questions about the origin and dynamics of cancer
   villages, an irreversible damage to the environment and society. (C)
   2016 The Authors. Published by Elsevier Ltd.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
