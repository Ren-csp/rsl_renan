@inproceedings{ WOS:000231755100019,
Editor = {Lunney, D and Burgin, S},
Title = {Brushtail Possums: ``Champion of the suburbs{''} or ``Our
   tormentors{''}?},
Booktitle = {URBAN WILDLIFE: MORE THAN MEETS THE EYE},
Year = {2004},
Pages = {159-168},
Note = {Forum on Urban Wildlife - More than meets the Eye, Mosman, AUSTRALIA,
   OCT 20, 2001},
Organization = {Royal Zool Soc New S Wales},
Abstract = {The common brushtail possum Trichosurus vulpecula poses a test for
   managers of urban wildlife because community attitudes towards the
   species vary widely from those who are prepared to live with it to those
   who wish it to be controlled as a pest. The New South Wales National
   Parks and Wildlife Service has the responsibility for protecting possums
   throughout the state. This raises three issues for review: 1. what is
   the conservation status of brushtail possums in both urban and non-urban
   areas of New South Wales?; 2. what is the extent, location and nature of
   the problem in Sydney?; and 3. how appropriate is current NPWS policy
   and management practice? The solution to the conundrum will require
   improvements to management strategies, further research and sustained
   education programs.},
