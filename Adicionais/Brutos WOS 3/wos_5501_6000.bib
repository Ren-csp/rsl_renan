@inproceedings{ WOS:000363782800156,
Author = {Wan, Guogen and Tie, Ling},
Book-Group-Author = {Destech Publicat Inc},
Title = {Research on Security Architecture of Perception-layer of IOT Based on
   Subject-object Behavior Approach},
Booktitle = {INTERNATIONAL CONFERENCE ON SUSTAINABLE ENERGY AND ENVIRONMENT
   PROTECTION (ICSEEP 2015)},
Year = {2015},
Pages = {991-996},
Note = {International Conference on Sustainable Energy and Environment
   Protection (ICSEEP), Guangzhou, PEOPLES R CHINA, MAY 30-31, 2015},
Abstract = {Nowadays, security architecture in the perception layer of IOT(Internet
   of things) mainly consider single, discrete, non-system factors, and
   stress on control security or data security, lack of security
   capabilities for the whole IOT. Based on the results in the project
   ``Security control platform based on the applications of Internet of
   things{''} which is a special information security project of the
   national development and Reform Commission headed by the applicant, this
   project is intended to research and develop security architecture for
   the perception layer of IOT with Subject-Object Behavior Approach
   (SOBA). Based on the general behavior of cyberspace, namely the
   activities of the subject in the cyberspace, the security architecture
   in the perception layer of IOT based on Subject Behavior is proposed by
   the analysis of subject activities which are depend on the computing
   environment, network environment, application environment, as well as
   related to the three-dimensional support system of technology,
   management and detection which are dependent by the activities of the
   subject. Based on this architecture, the relational model, behavior
   constraint model, security constraint model between the subject, the
   object, the behavior and the network environment of the activities of
   the subject of the perception layer of IOT are established. The
   paradigms of confidentiality, integrity and availability of the
   perception layer of IOT are proposed. Compared with the previous
   security architecture of the perception layer of IOT, the architecture
   presented in this project is systematic, integrity, easy to assess, and
   has the important theory and application value on the security research
   and development of IOT.},
