@article{ WOS:000606828200023,
Author = {Pandolfi, Giulia and Pettinari, Jessica},
Title = {NATURE-BASED SOLUTIONS FOR FLOOD MANAGEMENT: A STUDY CONDUCTED IN LABARO
   - PRIMA PORTA DISTRICT, ROME, ITALY},
