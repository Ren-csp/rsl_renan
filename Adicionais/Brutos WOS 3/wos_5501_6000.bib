@inproceedings{ WOS:000084731400057,
Author = {Pavlova, M and Lutzenberger, W and Sokolov, A and Birbaumer, N},
Editor = {Killeen, PR and Uttal, WR},
Title = {Biological motion perception and gamma MEG activity},
Booktitle = {FECHNER DAY 99: THE END OF 20TH CENTURY PSYCHOPHYSICS, PROCEEDINGS},
Year = {1999},
Pages = {320-325},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {Changes in magnetoencephalographic (MEG) gamma-range brain activity
   during biological motion perception have been assessed. Subjects saw a
   set of 200 displays of two types: a canonical point-light figure and a
   scrambled walker that consisted of the spatially scrambled points on the
   joints of a canonical one. In separate runs, both configurations were
   presented either with an upright or inverted display orientation. MEG
   responses were recorded with a whole-head system. Neither upright nor
   inverted ``scrambled walker{''} evoked any enhancements in gamma
   activity. For both upright and inverted canonical figures, gamma
   activity (25 Hz) increased over the occipital areas already at 100 ms
   from stimulus onset. Moreover, only a recognizable upright point-light
   walker yielded later enhancements of gamma-range activity over the
   parietal (at 130 ms) and temporal (at 170 ms) cortices. The findings
   indicate that gamma-range brain activity is sensitive to the coherence
   and meaning expressed by biological motion.},
