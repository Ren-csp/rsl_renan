Title = {Environmental Quality in Urban Settlement: The Role of Local Community
   Association in East Semarang Sub-District},
Booktitle = {RESILIENT CITIES: BEYOND MITIGATION, PREPAREDNESS, RESPONSE, AND
   RECOVERY (CITIES 2013 INTERNATIONAL SEMINAR)},
