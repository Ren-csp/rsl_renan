@article{ WOS:000243545100005,
Author = {McKinney, Martin F. and Moelants, Dirk},
Title = {Ambiguity in tempo perception: What draws listeners to different
   metrical levels?},
Journal = {MUSIC PERCEPTION},
Year = {2006},
Volume = {24},
Number = {2},
