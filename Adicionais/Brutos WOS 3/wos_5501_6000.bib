@article{ WOS:000242038900023,
Author = {Gnecco, I. and Berretta, C. and Lanza, L. G. and La Barbera, P.},
Title = {Quality of stormwater runoff from paved surfaces of two production sites},
Journal = {WATER SCIENCE AND TECHNOLOGY},
