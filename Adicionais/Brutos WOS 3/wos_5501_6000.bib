Note = {2nd Advanced Research on Business, Management and Humanities (ARBUHUM),
   Phuket, THAILAND, OCT 10-12, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {The objective of the current study is to investigate the perception of
   engineers working in the Electrical and Electronic (E\&E) sector in
   Malaysia, on organizational innovative climate and its' influence on
   knowledge sharing in their respective organizations. Data was collected
   using survey questionnaires from 309 respondents. The result of the
   analysis reveals that both dimensions of organizational innovative
   climate, namely, organizational support and organizational culture
   positively influence the two dimensions of knowledge sharing: giving and
   receiving knowledge. This outcome indicates the importance of having an
   organizational environment that nurture and encourages knowledge
   sharing.},
