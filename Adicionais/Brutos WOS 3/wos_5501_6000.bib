Title = {STUDY OF CITY LANDSCAPE HERITAGE USING LIDAR DATA AND 3D-CITY MODELS},
Booktitle = {36TH INTERNATIONAL SYMPOSIUM ON REMOTE SENSING OF ENVIRONMENT},
