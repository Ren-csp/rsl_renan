   Melichercik, Jan and Petruzelkova, Anna and Nemcova, Vladimira},
Book-Group-Author = {SGEM},
Title = {THE RISK OF ARSENIC CONTAMINATION IN CZECH URBAN SOILS},
Booktitle = {12TH INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC GEOCONFERENCE, SGEM
   2012, VOL. IV},
