Title = {A Tangible Interface-based Application for Teaching Tactual Shape
   Perception and Spatial Awareness Sub-Concepts to Visually Impaired
   Children},
Booktitle = {6TH INTERNATIONAL CONFERENCE ON APPLIED HUMAN FACTORS AND ERGONOMICS
   (AHFE 2015) AND THE AFFILIATED CONFERENCES, AHFE 2015},
