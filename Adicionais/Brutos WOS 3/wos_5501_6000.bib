@inproceedings{ WOS:000073159500023,
Author = {Bogdanovic, R and Petrovic, J and Bazik, D},
Editor = {Sucharov, L and Bidini, G},
Title = {The concept of ``sustainable transport{''}: implications for potential
   of residential streets},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {255-264},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {One of the principals of The European Urban Charter, in urban transport
   and mobility is rehabilitation of the social role of the street. The
   Habitat Agenda. in the frame of the concept of ``sustainable
   development{''}, recommends ``sustainable transport{''}. The point of
   the policy of ``sustainable transport{''} is to encourage the use of an
   optimal combination of modes of transport, including walking. This paper
   deals with the method of developing the residential street into a
   ``social collector{''}, ``living yard{''} or ``threshold{''} of
   residential space. Usability of residential streets is very specific and
   unfolds in a typically designed traffic route space. In order to
   increase the quality of urban life, modernize and improve the urban
   environment, the residential street might be designed as an equipped and
   active space which integrates pedestrians and vehicles and treats them
   equally.},
