@article{ WOS:A1994NP44200008,
Author = {COCKBURN, J and SMITH, PT},
Title = {ANXIETY AND ERRORS OF PROSPECTIVE MEMORY AMONG ELDERLY PEOPLE},
Journal = {BRITISH JOURNAL OF PSYCHOLOGY},
Year = {1994},
