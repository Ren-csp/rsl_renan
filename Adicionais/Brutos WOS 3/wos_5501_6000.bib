Title = {The effects of lateral boundary conditions resolution for heat island
   studies in tropical urban of Kuala Lumpur},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON RESEARCH METHODOLOGY FOR BUILT
   ENVIRONMENT AND ENGINEERING 2019},
