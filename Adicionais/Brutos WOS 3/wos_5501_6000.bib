@article{ WOS:000373800600023,
Author = {Kim, Soonki},
Title = {World Heritage Site Designation Impacts on a Historic Village: A Case
   Study on Residents' Perceptions of Hahoe Village (Korea)},
Journal = {SUSTAINABILITY},
Year = {2016},
Volume = {8},
Number = {3},
Month = {MAR},
Note = {Sustainable Asia Conference (SAC), Lanzhou, PEOPLES R CHINA, SEP 20-21,
   2015},
Abstract = {This study examines the relationship between World Heritage Site (WHS)
   designation and the community sustainability of a historic village,
   focusing on Hahoe Village, Korea, which was inscribed in 2010. It
   examines residents' perceptions of increasing tourism at Hahoe Village
   by adopting a questionnaire and using an interview as research methods.
   This study examined both the positive and negative impacts that Hahoe
   Village's WHS designation has had on its sustainability. Of all of the
   impacts examined in this research, the three most noteworthy issues are
   identified: (1) the acceleration of the change of the village's
   industrial base and the influx of strangers; (2) the degradation of
   quality of life (in the physical aspects) caused by increasing tourism;
   and (3) the collision predicated by the tension between conserving the
   village's historic environments and developing tourism. In conclusion,
   the WHS designation impacts on Hahoe Village, which local residents
   perceived, have both positive and negative aspects. WHS designation
   needs to be accompanied by a management plan that is more concerned
   about the impact from tourism after the designation. In this context,
   Hahoe Village must not only have a comprehensive preservation plan that
   balances with the demand for tourism development, but also secure the
   village's community sustainability as a living place other than a
   tourist destination.},
