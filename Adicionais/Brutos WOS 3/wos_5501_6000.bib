@inproceedings{ WOS:000400302000013,
Author = {Iordache-Platis, Magdalena},
Editor = {Pinzaru, F and Bratianu, C},
Title = {Higher Education Leadership and Institutional Development: Stakeholders'
   Perceptions},
Booktitle = {PROCEEDINGS OF THE 12TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2016)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2016},
Pages = {99-108},
Note = {12th European Conference on Management, Leadership and Governance
   (ECMLG), Natl Univ Polit Studies \& Publ Adm, Coll Management,
   Bucharest, ROMANIA, NOV 10-11, 2016},
Abstract = {Competition among higher education institutions make them aware of the
   importance of reconsider traditional way of doing things either they
   refer to education, research or society development, all being areas
   generated from university missions. The contemporary context of higher
   education institution is one of challenges and this makes them reflect
   on their strategies which can no longer be passive. Becoming more and
   more active on the educational market means that higher education
   universities must create and implement effective strategies. Any
   strategy starts or must start from a vision and includes all other
   specific components, such as competitive advantage, objectives,
   resources and terms which require leadership involvement. In other
   words, leadership has a huge contribution to the institutional
   development. Academic leadership has the power to generate higher
   education institutions reactions to different market stimuli and
   therefore, to improve the market position and to introduce many more
   changes. Institutional development is, in fact a result of leadership
   style, of leadership power and type. In addition, not always an academic
   leadership conducts to the improvement process of the activities and
   this is reflected in specific output. The leadership and the development
   process in a higher education institution are very much connected but
   the relationship between them is complex. Perceptions of students and
   professors, as members of the academic community, as well as of the
   companies count in the process of leadership action towards the
   important goals. Therefore, the purpose of this paper is to reflect the
   degree in which academic leadership influences the institutional
   development and how different interested parties perceive this. Specific
   objectives of this paper are: to clarify the relationship between
   academic leadership and institutional development for higher education
   institutions, to explain the similarities and the differences among
   different stakeholders' perceptions. Findings demonstrate that academic
   leadership is limited in the process of change implementation and of
   performance increase and that interested parties can contribute to the
   leadership effectiveness. The research methodology is based on
   qualitative study.},
