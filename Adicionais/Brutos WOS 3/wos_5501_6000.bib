   Sadowski, Tadeusz},
Editor = {Czaplicka, M and Czechowski, O and Fudala, J and JablonskaCzapla, M and KyziolKomosinska, J and Majewski, G and JudaRezler, K and RogulaKozlowska, W and Sowka, I},
Title = {Distribution of gaseous and particle-boundHg concentrations at the sites
   representative for urban and non-urban zones of Silesia Province},
Booktitle = {X-TH SCIENTIFIC CONFERENCE AIR PROTECTION IN THEORY AND PRACTICE},
Series = {E3S Web of Conferences},
Year = {2018},
Volume = {28},
Note = {10th Scientific Conference on Air Protection in Theory and Practice,
   Zakopane, POLAND, OCT 18-21, 2017},
Organization = {Inst Environm Engn Polish Acad Sci; AIRCLIM NET; ECO Monitoring; Shim
   Pol; mlu recordum; Atmoservice; TESTCHEM; Envimet Serv; TSI},
Abstract = {The basic features of the distribution of total gaseous (TGM) and
   particle-bound mercury (PBM) concentrations were determined for a five
   locations representative for urban (Bielsko-Biala, Lubliniec, Zabrze)
   and rural areas (Godow, Zloty Potok) of Silesia Province. Gaseous
   mercury concentrations were measured (1) continuously - the automatic 1h
   TGM measurements in Zloty Potok and Zabrze and (2) non-continuously
   manual 24h TGM measurements with a pre-concentration of the Hg on gold
   traps (Bielsko-Biala, Lubliniec, Godow). The PBM concentrations were
   measured non-continuously by taking PM2.5 samples. The Hg content was
   determined by using a CVAAS method. The highest average concentration of
   TGM was recorded in Zabrze (2.8 ng/m(3)), significantly lower (2.0
   ng/m(3)) in Bielsko-Biala and in the non-urban station in Godow, the
   lowest concentration (<2.0 ng/m(3)) was observed in Lubliniec and at the
   regional background station in Zloty Potok. The results obtained for TGM
   concentrations exceeded the European average level of 1.5
   ng/m(3)(AirBase, 2014). The highest average PBM concentration,
   associated with PM2.5, was obtained in Zabrze (70 pg/m(3)), more than
   20\% lower results were obtained in Bielsko-Biala and Godow, finally,
   the lowest one (lower by about 40\% in comparison with Zabrze) were
   obtained in Lubliniec and Zloty Potok. Moreover, an enrichment of Hg
   concentration in PM was observed with the increasing of the PM content,
   during the heating season.},
