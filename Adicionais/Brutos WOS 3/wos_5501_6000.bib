
@inproceedings{ WOS:000234955700041,
Author = {Hosseinzadeh, SR},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {The effects of urbanization on the natural drainage patterns and the
   increase of urban floods: Case study Metropolis of Mashhad-Iran},
Booktitle = {Sustainable Development and Planning II, Vols 1 and 2},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
