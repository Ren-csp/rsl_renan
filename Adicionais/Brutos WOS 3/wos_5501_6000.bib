@inproceedings{ WOS:001672900200078,
Author = {Rodrigues, Bruno Noronha and Dezen-Kempterl, Eloisa and Junior, Vitor
   Eduardo Molina and Canteras, Felippe Benavente},
Editor = {Ferreira, P and Dall'Orsoletta, A and Jorio, M and Santos, AL},
Title = {GREEN INFRASTRUCTURES IN SOCIAL HOUSING IN BRAZIL: A SYSTEMATIC
   LITERATURE REVIEW},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2024},
Pages = {524-530},
Note = {2024 International Conference on Energy and Environment-ICEE-Bringing
   together Engineering and Economics, Guimaraes, PORTUGAL, JUN 06-07, 2024},
Abstract = {The Brazilian Federal Constitution guarantees housing legitimately to
   citizens and establishes urban life rights, including housing and access
   to infrastructure. Public policies were proposed in the country,
   including the Minha Casa Minha Vida Program, the most extensive housing
   program in the nation to date, which contracted more than 5.5 million
   units for the low-income population. Conversely, it significantly
   affects the environment, mainly by expanding the necessary
   infrastructure. The use of Green Infrastructures (GI), a concept not yet
   widespread in Brazil, has contributed to more sustainable urban
   development. This research presents the state of the art of applying GI
   in Social Housing (SH) concepts in Brazil. The results primarily focus
   on materials, construction systems, and solutions for water management.
   The GI was grouped into sets and associated with the potential
   environmental services provided in SH. Understanding the characteristics
   and needs of the target population is fundamental to creating more
   efficient and sustainable housing projects. Implementing GI in SH can
   save resources, reduced greenhouse gas emissions, and improved quality
   of life. However, challenges such as additional costs, lack of technical
   training, sustainable awareness among residents, and the need for
   sustainable institutional policies are pointed out.},
