Title = {Species composition, structure and endemicity of flora Malesiana in the
   Udayana urban forest, Mataram City},
Booktitle = {7TH INTERNATIONAL CONFERENCE ON SUSTAINABLE AGRICULTURE AND ENVIRONMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2021},
