Year = {2025},
Note = {2024 Conference on Consumer Life Tech-ICLT, Sydney, AUSTRALIA, DEC
   11-13, 2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {After COVID-19, the focus on health technology has significantly
   increased. Specifically, wearable sensors have grabbed much attention
   from the public. However, specific concerns also revolve around these
   technologies as they monitor the total physical changes. Hence, this
   study attempted to understand the public perception of wearable sensors
   for health monitoring. This study utilised public opinion from the X
   (former Twitter) platform. Sentiment analysis and topic modelling have
   been employed to understand the public's perception. The results showed
   that public perception is positive and that there is a more extensive
   scope for public acceptance of wearable sensors for health monitoring.},
