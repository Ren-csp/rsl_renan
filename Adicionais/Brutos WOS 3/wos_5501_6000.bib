@inproceedings{ WOS:000087816100096,
Author = {Rajna, P and Veres, J},
Editor = {DeClercq, M and Andreoli, A and Lamarre, S and Forster, P},
Title = {Emergency psychiatric interventions in people with epilepsy},
Booktitle = {EMERGENCY PSYCHIATRY IN A CHANGING WORLD},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1999},
Volume = {1179},
Pages = {657-660},
Note = {5th World Congress of the
   International-Association-for-Emergency-Psychiatry, BRUSSELS, BELGIUM,
   OCT 15-17, 1998},
Organization = {World Psychiatr Assoc; Assoc European Psychiatrists; European Region
   Council World Federat Ment Hlth; Belgian Royal Soc Ment Hlth Med;
   Belgian Soc Emergency \& Disaster Med},
Abstract = {Based on a retrospective study, the authors summarize the main
   situations needing emergency psychiatric interventions in the course of
   epilepsy. Evaluation of periictal (pre- and postictal) and ictal
   transient confusional and/or delusional states sometimes proves rather
   difficult since they may resemble psychotic syndromes and in some cases
   only special ``epileptological{''} diagnostic procedures, including
   video-EEG monitoring, can confirm the epileptic nature of the acute
   state. Interictal psychiatric disorders belong rather to classic
   psychiatry. Beside paranoid states, affective disorders also frequently
   occur. On the other hand, some also possess anti-epileptics, a proven
   thymoleptic effect. While in the case of 15 of the 37 patients with
   acute affective decompensation some modifications were made in the
   anti-epileptic treatment (AED) including carbamazepine or valproate, the
   possibility is raised that affective decompensation is caused by the
   change in the dosage of these medicines. A special problem of the
   chronic (not seldom pharmacoresistant) epileptic population is the
   occurrence of psychogenic pseudoseizure, as a consequence of psychic
   decompensation. They are usually connected with circumstantial effects
   and/or histrionic personality. But these patients are usually admitted
   acutely to neurological departments.},
