@inproceedings{ WOS:000239784000034,
Author = {Tam, Tony and Salenieks, Mary Ellen and Cafazzo, Joseph A. and Seto,
   Emily and Purdy, Brendan and McLean, Melinda and Rossos, Peter G.},
Editor = {Jennett, P and Rangayyan, RM},
Title = {Perception of eye contact in telehealth videoconferencing},
Booktitle = {Proceedings of the IASTED International Conference on TELEHEALTH},
Year = {2005},
Pages = {174-179},
Note = {IASTED International Conference on Telehealth, Banff, CANADA, JUL 19-21,
   2005},
Organization = {Int Assoc Sci \& Technol Dev},
Abstract = {The perception of eye contact is important for effective communication,
   especially between clinicians and patients. During patient consultations
   over telehealth videoconferencing, clinicians often sit as close as a
   metre away from the videoconferencing units, creating a 15 degrees eye
   gaze angle (angle between the eye and the camera, and the eye and the
   centre of the display). The results of this study show that participants
   perceived better eye contact in 87.1\% of cases with a 7 degrees eye
   gaze angle compared to the 15' angle. Also 92.5\% of participants
   responded that the difference in the perceived eye contact was important
   to them as a patient. The improvement in eye contact can be realized by
   increasing the horizontal distance that participants sit from the unit,
   thereby decreasing the eye gaze angle.
   An upper limit gaze angle of 7 degrees is recommended. The Law of
   Cosines can be used to calculate the minimum horizontal distance (D)
   necessary. If the camera is directly above the screen, and the
   participant's eye height is level with the centre of the screen, the
   following calculation can be used:
   Let H be the difference in height between the camera and the centre of
   the display.
   D = H / 0.123.},
