@article{ WOS:000230436400005,
Author = {Kerley, KR and Matthews, TL and Schulz, JI},
Title = {Participation in operation starting line, experience of negative
   emotions, and incidence of negative behavior},
Journal = {INTERNATIONAL JOURNAL OF OFFENDER THERAPY AND COMPARATIVE CRIMINOLOGY},
Year = {2005},
Volume = {49},
