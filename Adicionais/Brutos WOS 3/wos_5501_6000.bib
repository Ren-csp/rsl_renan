@inproceedings{ WOS:000315972900018,
Author = {Stanescu, Dan Florin and Iorga, Elena-Madalina},
Editor = {Milcu, M and SchmidtBrasse, U and Westhoff, K and Milcu, M and Grabovschi, C},
Title = {DOES POSITIVE AFFECT INFLUENCE THE WAY CLERKS PERFORM EMOTIONAL LABOR?
   EXPLORATIVE PILOT STUDY REGARDING THE RELATIONSHIP BETWEEN POSITIVE
   AFFECT AND EMOTIONAL LABOR},
Booktitle = {PROSPECTING ADVANCED RESEARCH IN HEALTH, EDUCATION AND SOCIAL SCIENCES},
Year = {2011},
Pages = {122-129},
Note = {4th International Conference on Modern Research in Psychology - Trends
   and Prospects, Sibiu, ROMANIA, JUN 03-05, 2011},
Abstract = {A recurrent issue since the 1930s, the study of emotions in work
   settings continues to receive increased research attention in the field
   of organizational psychology. One of the most explored areas as part of
   this ``affective revolution{''} is that of emotional labor, which we
   chose to approach using the conceptualization of Glomb and Tews (2003,
   p. 4), as the ``behavioral expression or non-expression of felt or
   unfelt emotions in accordance with display rules{''}. On the other hand,
   consistent with other organizational researches, we used the dimensional
   approach of emotions as states of positively toned affectivity in order
   to determine whether they influence the emotional experiences at work in
   the case of clerks. The study was conducted using a survey method of 80
   store clerks. The results confirmed the fact that high scores at
   positive affectivity are significantly related with the genuine
   expression of positive emotions as part of the emotional work
   requirements, whereas the suppression of discrete positive emotions,
   such as love, is strongly influenced by experiencing both general and
   basic negative emotions. Other affective states were also taken into
   account, of which serenity and fatigue offered relevant insights.},
