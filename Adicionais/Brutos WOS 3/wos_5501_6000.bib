   and Jaafar, Samsuddin and Thani, Siti Nur `Alia Ahmad},
Title = {The Relationship Between Physical Infrastructure and the Perception of
   Students' Performance in Community Islamic Schools in Perak, Malaysia},
Journal = {ADVANCED SCIENCE LETTERS},
