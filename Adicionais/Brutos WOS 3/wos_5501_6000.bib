Title = {Alternative future growth scenarios for Utah's Wasatch Front:
   identifying future conflicts between development and the protection of
   environmental quality and public health},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING II, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
