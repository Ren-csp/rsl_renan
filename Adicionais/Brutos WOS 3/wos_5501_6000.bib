Note = {74th Annual Meeting of the Eastern-Psychological-Association, Baltimore,
   MD, MAR 13-16, 2003},
Organization = {Eastern Psycholog Assoc},
Abstract = {A national sample of graduate program directors (N = 162) completed a
   survey about their awareness and perceptions of publications in 5
   leading psychology student-based journals in relation to determining
   graduate admission acceptance. Program directors reported little
   familiarity with student-based journals, were not likely to recommend
   these journals to undergraduates to publish, and believed publications
   in undergraduate periodicals were a nonsignificant factor for acceptance
   into their graduate program. These results suggest that graduate faculty
   need greater awareness about student-based psychology journals and
   undergraduate advisees need to caution students when they recommend
   publishing in such journals.},
