@article{ WOS:000180807400002,
Author = {Kinney, TA},
Title = {Themes and perceptions of written sexually harassing messages and their
   link to distress},
Journal = {JOURNAL OF LANGUAGE AND SOCIAL PSYCHOLOGY},
Year = {2003},
Volume = {22},
Number = {1},
