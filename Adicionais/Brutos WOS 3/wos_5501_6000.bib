@article{ WOS:A1996VM95800008,
Author = {Parker, BL and Jones, EF},
Title = {The influences of goal-related actions and reward information on
   children's and adults' perceptions of effort expenditure and goal desire},
Journal = {JOURNAL OF PSYCHOLOGY},
Year = {1996},
