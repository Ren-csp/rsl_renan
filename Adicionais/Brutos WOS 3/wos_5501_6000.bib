Title = {Problem List Clustering for Improved Patient-Based Disease Perception},
Booktitle = {2018 IEEE INTERNATIONAL CONFERENCE ON HEALTHCARE INFORMATICS WORKSHOPS
   (ICHI-W)},
Series = {IEEE International Conference on Healthcare Informatics},
Year = {2018},
Pages = {88-89},
Note = {6th IEEE International Conference on Healthcare Informatics (ICHI), New
   York, NY, JUN 04-07, 2018},
Organization = {IEEE; IEEE Comp Soc},
Abstract = {The amount of electronic health record (FAIR) content accumulates in
   cases of patients with chronic diseases and multiple hospital stays.
   Problem lists grow beyond an acceptable limit and hamper a fast visual
   perception of key elements of the EHR. We propose a semantic grouping of
   problem list items in order to facilitate navigation through EHR topic
   spaces. The clustering approach, which makes use of ICD-10 codes and an
   NLP pipeline is evaluated in an intra- and inter-patient scenario. We
   achieve an average compression rate of 80\% of the initial list view
   items forming consistent semantic topic spaces with an F-measure greater
   than 0.80 in both cases.},
