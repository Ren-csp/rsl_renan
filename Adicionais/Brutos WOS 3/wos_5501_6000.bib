@article{ WOS:000444996500082,
Author = {Zulkhairi, M. S. Mohd and Farid, M. F. Muhammad and Farahin, K. Siti and
   Puaad, Muhammad Bazli Faliq Mohd and Mohammad, S. N.},
Title = {Water Quality Monitoring in Urban Area},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4206-4208},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {The objective of the study is to determine the status of water quality
   in developing area in Pasir Gudang, Johor specifically within Universiti
   Teknologi Mara Pasir Gudang Campus. Due to rapid urban development
   especially in commercial sector and housing construction sector, Pasir
   Gudang is known as one of the most important business hub in Johor.
   Nevertheless, this inevitably will affect quality and usability of
   nearby water resources thus determining water quality within the studied
   area is needed. The method of this study is based on collecting water
   samples in the area of Universiti Teknologi MARA Pasir Gudang Campus.
   The water samples are collected at three different locations; at
   students' college area, academic buildings and administrative buildings.
   These water samples are then tested in the laboratory to extract the
   data regarding the status of its water quality. The Water quality tests
   are carried out according to the standard of Department of Environmental
   Malaysia (DoE) known as water quality index (WQI). Six water parameters
   evaluated which are pH, suspended solids, BOD, COD, AN, and DO. These
   parameters are used to determine WQI as it was prescribed by DoE,
   stating its suitability to be applied in a tropical country like
   Malaysia. It has been found that the status of water quality at this
   studied location is under class III for WQI, which has a moderate water
   quality. The qualities are similar to the surface raw water with its
   usage and consumptions limited to agriculture, industrial and commercial
   activities. This study has also shown that the water at this area was
   already contaminated and requires further treatment if it is intended
   for human usage and domestic activities. However the level of
   contamination was still considered low with less threaten to human
   health and environment. This study is important in order to monitor the
   quality of water in developing areas. Further detailed study should be
   conducted to enhance the accuracy and reliability of the data.},
