@inproceedings{ WOS:001264250100003,
Author = {Balletto, Ginevra and Sinatra, Martina and Borruso, Giuseppe and Sechi,
   Francesco and Fancello, Gianfranco},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti, L},
Title = {The Process of Metropolisation and Spatial Accessibility. The Case Study
   of the Cagliari Metropolitan City},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 2, INPUT 2023},
