@article{ WOS:000250185700002,
Author = {Wolfe, Christy D. and Bell, Martha Ann},
Title = {The integration of cognition and emotion during infancy and early
   childhood: Regulatory processes associated with the development of
   working memory},
Journal = {BRAIN AND COGNITION},
Year = {2007},
Volume = {65},
Number = {1},
Pages = {3-13},
Month = {OCT},
Note = {Symposium on Social Cognitive and Affective NeuroscienceAnnual Meeting
   of the Society-for-Theoretical-and-Experimental-Neuropsychology, Quebec
   City, CANADAMontreal, CANADA, JUN, 2003JUN, 2003},
Organization = {Soc Theoret \& Expt Neuropsychol},
Abstract = {This study was an attempt to integrate cognitive development (i.e.,
   cognitive control) and emotional development (i.e., emotion regulation)
   in the first years of life. The construct of temperament was used to
   unify cognition and emotion because of its focus on attentional and
   regulatory behaviors. Children were seen at 8 months and 41/2-years of
   age in a study designed to examine the correlates of working memory
   development. Frontal brain electrical activity and temperament predicted
   working memory performance at 8 months. Similarly, frontal brain
   electrical activity, temperament, and language predicted working memory
   at age 41/2-years. Temperament in early childhood mediated the relation
   between infant temperament and early childhood working memory
   performance. These associated temperament characteristics highlight the
   value of early-learned regulatory and attentional behaviors and the
   impact of these early skills on later development. (c) 2007 Elsevier
   Inc. All rights reserved.},
