@article{ WOS:A1995RQ28400002,
Author = {FRANCE, ACI and ALPHER, VS},
Title = {STRUCTURAL-ANALYSIS OF SOCIAL-BEHAVIOR AND PERCEPTIONS OF CAREGIVING},
