@inproceedings{ WOS:000169963600037,
Author = {Herold, M and Menz, G},
Editor = {Buchroithner, MF},
Title = {Landscape Metric Signatures (LMS) to improve urban land use information
   derived from remotely sensed data},
Booktitle = {DECADE OF TRANS-EUROPEAN REMOTE SENSING COOPERATION},
Year = {2001},
Pages = {251-256},
Note = {20th Annual Symposium of the
   European-Association-of-Remote-Sensing-Laboratories (EARSeL), DRESDEN,
   GERMANY, JUN 14-16, 2000},
Organization = {European Assoc Remote Sensing Labs},
Abstract = {The basic problem in discrimination of urban land use categories by
   digital remote sensing technique accordant to the Level II of the land
   use/cover classification scheme (Anderson et al. 1976) results from
   their similar spectral response as well as their spatial heterogeneous
   land cover structures. Hence high geometric resolutions of remote
   sensors and additional information than from the widely used ``per
   pixel{''} - classifiers are needed. This study introduces a combined
   remote sensing and landscape metric approach to derive information about
   structures and changes in urban land use. The investigations are based
   on the analysis of digitally classified CIR-airphoto using the program
   ``Fragstats{''} in the area of Santa Barbara, CA. The results show a
   satisfying separation of the three investigated land use structures:
   commercial; high and low densed built up residential. The important
   urban land cover features for separation are the domination of a
   use/land class (built up or vegetation), the housing density, the mean
   housing and plot size as well as the spatial aggregation of the built up
   areas. To enable a clear discrimination it was ascertained to evaluate
   the metrics as ``Landscape Metric Signatures{''} (LMS) for the land use
   categories. Furthermore it was shown that changes in urban environment
   can be described and quantified concerning their effects on the spatial
   land use structure. Thus the great potential of remote sensing
   techniques and landscape metric information were evidenced, but future
   investigations focused on the enhancement of the derivation of thematic
   information from remote sensing data and the evaluation of urban metrics
   and indices are necessary.},
