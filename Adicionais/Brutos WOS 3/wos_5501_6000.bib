@inproceedings{ WOS:000314126600014,
Author = {Yaacob, Norjaudah and Nasir, Nafiza Mat and Jalil, Siti Nadiah and
   Ahmad, Rizal and Abd Rahima, Nur Azirah Raidah and Yusof, Aimi Nadia
   Mohd and Ghani, Nur Azurah Abdul},
Editor = {Abbas, MY and Bajunid, AFI and Azhari, NFN},
Title = {Parents or Caregivers' Perception on Menstrual Care in Individuals with
   Down Syndrome},
Booktitle = {ASEAN CONFERENCE ON ENVIRONMENT-BEHAVIOUR STUDIES (ACE-BS)},
Series = {Procedia Social and Behavioral Sciences},
Year = {2012},
Volume = {36},
Pages = {128-136},
Note = {ASEAN Conference on Environment-Behaviour Studies (AcE-Bs), Inst
   Teknologi Bandung (ITB), Sch Architecture, Planning \& Policy Dev,
   Bandung, INDONESIA, JUN 15-17, 2011},
Abstract = {Issues on menstruation in individual with Down syndrome are often
   understudies. Difficulty in handling menstrual hygiene, premenstrual
   disorders and the risk of sexual abuse are often of major fear to the
   caregivers. 40 parents or caregivers of young woman with Downs Syndromes
   in Klang Valley, Malaysia were participated in the study. They were
   interviewed by using standardized questionnaire. Most of the caregivers
   expressed their concern regarding this issue and expressed their
