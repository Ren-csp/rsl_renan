@inproceedings{ WOS:000686173800208,
Author = {Budiyanto, A.},
Book-Group-Author = {IOP},
Title = {A dynamic model for managing urban waste in Bogor City, West Java
   Province},
Booktitle = {1ST INTERNATIONAL CONFERENCE ON SUSTAINABLE TROPICAL LAND MANAGEMENT},
