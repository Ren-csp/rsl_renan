@inproceedings{ WOS:000237755500084,
Author = {Leverenz, H. and Xirogiannopoulou, A. and Tchobanoglous, G. and
   Karagiannidis, A.},
Editor = {Lekkas, TD},
Title = {Financial aspects of urban solid waste management in Greece and the US:
   The cases of Panorama and Davis},
Booktitle = {Proceeding of the 9th International Conference on Environmental Science
   and Technology Vol B - Poster Presentations},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {B515-B521},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {A comparative analysis of two systems for urban solid waste management
   in Greece and the USA is presented in this paper. The municipalities of
   Panorama (Thessaloniki, Greece) and Davis (California, USA) are used as
   case studies for the purpose of comparing financial aspects of waste
   management systems.
   In Panorama residents and commercial establishments pay a fee for waste
   management services that is proportional to the surface area of the
   building and multiplied by an arbitrary charging coefficient related to
   property type. The funds for waste management services are collected
   with the billing for electricity usage. From the money collected for
   waste management services, a portion is deducted to finance street
   lighting, another 2\% of the waste management fee is paid to Public
   Power Cooperation for the provision of its services, and the remainder
   of the fees are transferred to the municipality, which is required to
   use the funds for waste management purposes. Recycling and other waste
   reduction efforts are not subsidized through the waste charging system.
   The municipality of Davis contracts with a private company to provide
   waste management services. The waste management company is responsible
   for curbside collection of source separated recyclables, green waste
   from yard and garden, and residual waste. Waste management services are
   provided with modern equipment and transported to local facilities for
   processing and preparation for markets and composting. The fees charged
   for waste management services are determined by the city council in
   response to the actual cost of the waste management services and billed
   to each individual residential customer. Commercial customers are
   charged on a basis proportional to their waste production. In addition,
   the residents in Davis subsidize the collection and separation of a
   variety of recyclable materials and composting of green wastes.
   The fees charged for waste management services in Panorama and in Davis
   are both within the same range for a typical sized property. However,
   while it is difficult to compare the two systems on a financial basis
   because of their differing geographic and political position, the waste
   management services and waste reduction efforts in Davis are expanded in
   scope. Several factors have been identified to explain these
   discrepancies. The fees collected in Panorama are used to finance the
   waste management operation, however the allocation of funds is not
   necessarily reflective of the actual cost. In addition, market forces
   drive waste reduction efforts and thus only materials with adequate
   value are separated and diverted from landfill disposal. In contrast, in
   Davis the residents subsidize the recycling and composting operations
   and the focus is on maximizing waste diversion. Thus, a high degree of
   waste diversion has been realized even though it may not be cost
   effective to divert some of the materials. The community feels that the
   environmental benefits of waste reduction and reuse outweigh the costs.},
Publisher = {UNIV AEGEAN},
Address = {VOULGAROKTONOU 30, ATHENS 114 72, GREECE},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Leverenz, H (Corresponding Author), Univ Calif Davis, Dept Civil \& Environm Engn, Davis, CA 95616 USA.
