Organization = {Romanian Soc Appl Expt Psychol},
Abstract = {Our research originated from the desire and need to study the phenomena
   of aggression and violence.. This study focuses on the teenager
   perception of aggression and violence as manifested in high school. The
   data used in this study was collected from 60 teenagers between 16 and
   19 years old, from two high schools in Constanta County, Romania. The
   results indicate an insufficient level of information and education
   among teenagers regarding aggression and violence in high school. Any
   remedial program should address issues that lead to dysfunctional or
   broken families as a main cause of adolescent aggression and violence.
