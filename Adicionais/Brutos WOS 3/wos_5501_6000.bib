@article{ WOS:A1993LR38100001,
Author = {KASHIMA, ES and KASHIMA, Y},
Title = {PERCEPTIONS OF GENERAL VARIABILITY OF SOCIAL-GROUPS},
Journal = {SOCIAL COGNITION},
Year = {1993},
Volume = {11},
Number = {1},
Pages = {1-21},
Month = {SPR},
Note = {MEETING OF THE AUSTRALIAN SOCIAL PSYCHOLOGISTS, BALLARAT, AUSTRALIA,
   1991},
Abstract = {A model of perceived general variability (dual Predictor model) is
   proposed. It postulates that perception Of group variability is an
   additive   function of similarity and difference among members of a
   group. The basic tenet of the model was tested in an experiment in which
   the amounts of similarity and difference information among group members
   were independently manipulated. Consistent with the model, it,was found
   that the greater the amount of difference, the more variable the group
   was perceived to be, and that the greater the amount of similarity, the
   less  variable the group was perceived to be.         There was no
   interaction effect due to similarity and difference information,
   suggesting the additive nature of the effects. In contrast, perceived
   dimensional variability was directly influenced only by the amount of
   difference among group members. The results are inconsistent with the
   hypothesis that amount of information positively affects perceived
   variability.},
