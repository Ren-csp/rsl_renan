Pages = {403-410},
Note = {Northeastern Recreation Research Symposium, Bolton Landing, NY, APR
   09-11, 2006},
Organization = {USDA Forest Serv; Venture Publishing},
Abstract = {With data collected from guests in all-inclusive resorts in Jamaica,
   West Indies, the purposes of this study were to: (1) delineate unique
   dimensions of customer service perceptions among guests and (2) report
   the finding of a study that measured guests' perceptions of the quality
   of customer service in all-inclusive resorts. The study asked the
   following research question: Are there statistically significant
   differences in guests I perceptions of the quality of customer service
   based on gender, educational level, experience traveling to Jamaica,
   international travel experience, country of residence and age? The
   results delineated six factors with relatively high coefficients. These
   factors were used in further analyses using t-tests and ANOVAs that
   revealed statistically significant differences in guests I perceptions
   of various service dimensions based on the socio-demographic variables
   (1) level of education, (2) experience traveling to Jamaica, (3)
   experience with international travel, (4) country of residence, and (5)
   age.},
