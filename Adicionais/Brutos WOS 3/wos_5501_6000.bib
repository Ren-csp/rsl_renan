@article{ WOS:000177732200001,
Author = {LaFontana, KA and Cillessen, AHN},
Title = {Children's perceptions of popular and unpopular peers: A multimethod
   assessment},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {2002},
Volume = {38},
Number = {5},
Pages = {635-647},
Month = {SEP},
Note = {11th Annual Meeting of the American-Psychological-Society, DENVER, CO,
   JUN, 1999},
Organization = {Amer Psychol Soc},
Abstract = {Children's perceptions of popular and unpopular peers were examined in 2
   studies. Study I examined the degree to which 4th-8th-grade boys and
   girls (N = 408) nominated the same peers for multiple criteria. Children
   viewed liked others as prosocial and disliked others as antisocial but
   associated perceived popularity with both prosocial and antisocial
   behavior. In Study 2, a subset of the children from Study I (N = 92)
   described what makes boys and girls popular or unpopular. Children
   described popular peers as attractive with frequent peer interactions,
   and unpopular peers as unattractive, deviant, incompetent, and socially
   isolated. In both studies, children's perceptions varied as a function
   of the gender, age, and ethnicity of the participants.},
