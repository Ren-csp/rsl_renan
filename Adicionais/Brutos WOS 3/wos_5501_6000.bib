@article{ WOS:A1991FF25600009,
Author = {HELMER, R and HESPANHOL, I and SALIBA, LJ},
Title = {PUBLIC-HEALTH CRITERIA FOR THE AQUATIC ENVIRONMENT - RECENT WHO
   GUIDELINES AND THEIR APPLICATION},
