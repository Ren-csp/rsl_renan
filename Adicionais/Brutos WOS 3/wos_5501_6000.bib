@article{ WOS:000223209600005,
Author = {Lange, LJ and Toussaint, LL and Fleming, R},
Title = {Perceptions of accident foreseeability and stress and coping during the
   evacuation period of a technological disaster},
Journal = {ENVIRONMENT AND BEHAVIOR},
Year = {2004},
Volume = {36},
Number = {5},
Pages = {701-716},
Month = {SEP},
Note = {105th Annual Convention of the American-Psychological-Association,
   CHICAGO, IL, AUG 14-19, 1997},
Organization = {Amer Psychol Assoc},
Abstract = {The public depends on experts to manage risks of technologies and to
   prevent or warn of a possible mishap. Perceptions of experts' ability to
   predict accidents were investigated in evacuees and controls during the
   threat of explosion from the derailment of a train carrying liquid
   propane. Evacuees showed elevated stress response levels compared to
   controls across psychological, behavioral, and physiological modalities.
   Perceptions of transportation accident foreseeability moderated
   physiological stress for evacuees, with stronger perceptions of accident
   predictability associated with lower stress hormone levels. Perceptions
   of transportation accident foresceability also were associated with a
   reactance-style response to the disaster and problem-solving coping
   style in evacuees. Perceptions associated with greater secondary
   predictability moderated the physiological stress effects of the
   accident on evacuees during the acute phase of the disaster and
   furthermore, was associated with more efforts to regain control through
   more active coping.},
