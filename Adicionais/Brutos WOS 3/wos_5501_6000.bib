@article{ WOS:000291123000008,
Author = {Wei, Meifen and Ku, Tsun-Yao and Liao, Kelly Yu-Hsin},
Title = {Minority Stress and College Persistence Attitudes Among African
   American, Asian American, and Latino Students: Perception of University
   Environment as a Mediator},
Journal = {CULTURAL DIVERSITY \& ETHNIC MINORITY PSYCHOLOGY},
Year = {2011},
Volume = {17},
Number = {2},
Pages = {195-203},
Month = {APR},
Note = {119th Annual Convention of the American-Psychological-Association,
   Toronto, CANADA, AUG, 2009},
Organization = {Amer Psychol Assoc},
Abstract = {We examined whether perception of university environment mediated the
   association between minority status stress and college persistence
   attitudes after controlling for perceived general stress. Participants
   were 160 Asian American, African American, and Latino students who
   attended a predominantly White university. Results of a path model
   analysis showed that university environment was a significant mediator
   for the association between minority status stress and college
   persistence attitudes. Additionally. minority status stress was distinct
   from perceived general stress. Finally, the results from a
   multiple-group comparison indicated that the magnitude of the mediation
   effect was invariant across Asian American. African American, and Latino
   college students, thus supporting the generalizability of the mediation
   model.},
