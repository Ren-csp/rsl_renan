@inproceedings{ WOS:000073221600018,
Author = {Dzhamalov, RG and Zlobina, VL},
Editor = {Chilton, J},
Title = {Carbonate karst in the Moscow region and its development under urban
   conditions},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {127-130},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {High-rate exploitation of karst water leads to intensification of karst
   suffosion and erosion processes and renewed development of ancient
   covered karst. Prolonged and high-rate withdrawal of groundwater
   substantially changes, as a rule, the hydrogeological conditions. In
   urban areas, groundwater is subjected to many different stresses. One of
   these, high-rate groundwater withdrawal contributes to the formation of
   hydrodynamic, hydrogeochemical and thermal anomalies within the
   developed aquifer and to the intensification of karstification and
   suffosion. The lowering of piezometric heads in the Carboniferous
   aquifers of the central Moscow basin has resulted in substantial areal
   distribution of not only hydrodynamic anomalies but also hydrochemical,
   hydrobiological and thermal anomalies.},
