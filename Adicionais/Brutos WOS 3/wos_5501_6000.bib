@inproceedings{ WOS:000450565500043,
Author = {Brewster, R. J.},
Editor = {GalianoGarrigos, A and Brebbia, CA},
Title = {Relative vulnerabilities of urban residential development to oil
   depletion: pilot case studies of a representative building typology in
   the Australian context},
Booktitle = {SUSTAINABLE CITY XI},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2016},
