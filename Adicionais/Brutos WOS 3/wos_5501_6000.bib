@inproceedings{ WOS:000221379400074,
Author = {van Timmeren, A and Röling, LC and Kristinsson, J},
Editor = {Beriatoss, E and Brebbia, CA and Coccossis, H and Kungolos, A},
Title = {Development and planning of sustainable and autarkic urban areas},
Booktitle = {SUSTAINABLE PLANNING AND DEVELOPMENT},
Series = {SUSTAINABLE WORLD},
Year = {2003},
Volume = {6},
Pages = {781-792},
Note = {1st International Conference on Sustainable Planning and Development,
   Skiathos Isl, GREECE, OCT 01-03, 2003},
Organization = {Wessex Inst Technol; Univ Thessaly, Dept Planning \& Reg Dev, Sch Engn;
   Municipal Skiathos; Univ Thessaly, Res Comm; TEE Magnisia Reg Sect;
   Sovel; Themeliodomi SA; Coca Cola HBC},
Abstract = {For autarkic concepts we can discern two future paths: the ones that
   comply with the principles of `the scale economy' and concepts that
   follow `the economies of scale'. The role of sustainable (passive and
   active) technologies in this case mostly is presumed to be of major
   importance. One can distinguish three models for the development and
   supposedly successful application of these technologies: the
   `quasi-evolutionary model', the `collective problem definition' and the
   `network theory'. The accompanying so-called `selection-environment' is
   based on scientific technological factors, economical factors and social
   cultural and political factors. The present development of use of
   sustainable technologies can be described as processes in accordance
   with the quasi-evolutionary model in combination with the network
   theory. The historical development and the scaling-up of technologies
   based on prevailing paradigms determine its quasi-evolutionary nature.
   Besides that there is a matter of a small but strong network with one or
   two dominant `actors' for each of the different circuits or `flows'
   (water, energy, and waste).
   In the end, the necessary threshold to a sustainable society (according
   to the Brundtland definition) is being hindered by these separated
   circuits: new sustainable technologies are continually being developed
   in all sectors, but the assimilation by society often falters. The main
   goal actually should be the third recognised model: the collective
   problem definition by all the more or less important `actors', by a
   broadening of the `process networks'. There is, however, a matter of the
   so-called Collingridge dilemma: when a technology is still young, the
   social implications are barely known and if the social implications are
   known, the technology is indebted in such a way that it is impossible to
   adapt it to the desires of the different actors. To resolve this dilemma
   it is necessary to reflect fundamentally the societal conditions of the
   needed approach to implement this sustainable or even autarkic
   technology. Apart from that it's important to optimise the `scale
   factor'. A topic of interest nowadays is the lack of integration of the
   different `flows' on which autarky is being claimed. Combinatorial
   effects of different decentral technologies and concepts concerning
   renewable energy and (waste) water, are not always taken into
   consideration. At the scale of an urban district (and lower) it will be
   easier to realise and maintain the pursued replacement of the existing
   (centralised) technologies by natural, decentralised solutions.
   This paper focuses on the problem that main grounds form the basis of
   the commonly experienced difficulties to realise far-reaching
   sustainable urban areas and - concepts using new, sometimes even
   scientifically proven, sustainable techniques and concepts at different
   scales. It observes the practice of paradigms that force further
   development of urban areas and technologies. To realise real sustainable
   urban development, or even autarkic concepts it tries to prove the need
   for paradigm-shifts, e.g. via `lateral thinking'. Apart from this
   problem of forcing paradigms it observes the problem of so-called
   `dominant actors', which obstruct the introduction of divergent,
   sustainable concepts and technologies as a result of a certain `fear' of
   the unknown and/or precedents. The oral presentation will focus on two
   exemplary case studies in the Netherlands: the `Deep Green' urban
   district of Lanxmeer in Culemborg, which is now under construction and
   an innovative planning model for the realisation of an
   `ecological-cultural (Ecu)-village' in the Netherlands. It concerns the
   continuation of `Ruigoord' (Amsterdam) a new planned eco-village example
   of urban lightness with far-reaching forms of involvement and
   participation.},
