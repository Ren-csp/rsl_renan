@inproceedings{ WOS:000085856900016,
Author = {Ricard, RM},
Book-Group-Author = {SAF
   SAF},
Title = {Tree wardens and the evolution of urban forestry in New England},
Booktitle = {PROCEEDINGS OF THE 1996 SOCIETY OF AMERICAN FORESTERS CONVENTION:
   DIVERSE FORESTS, ABUNDANT OPPORTUNITIES, AND EVOLVING REALITIES},
Year = {1996},
Pages = {80-85},
Note = {1996 National Convention of the Society-of-American-Foresters,
   ALBUQUERQUE, NM, NOV 09-13, 1996},
Organization = {Soc Amer Foresters},
Abstract = {In the early 1900s, private citizens and elected officials recognized
   the need for the conservation of trees and forests. Tree Warden statutes
   in all six New England states that were enacted during this period
   provide the earliest examples of state urban forestry laws. Tree Warden
   statutes required (or enabled) local municipalities to appoint tree
   wardens to conserve municipal trees. Today however, as a result of
   cultural conditions and forest environments that differ substantially
   from the early 1900s, these original laws no longer work effectively to
   conserve trees. A variety of circumstances compel present-day Tree
   Wardens to act primarily to remove hazard trees, rather than to plant,
   protect, maintain and conserve public trees, and to perform tasks
   unrelated to tree conservation. Therefore. existing Tree Warden statutes
   need to be amended so that the original intent of the statutes is better
   served and public trees are protected.},
