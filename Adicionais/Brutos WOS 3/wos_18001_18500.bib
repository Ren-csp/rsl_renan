@inproceedings{ WOS:000432877200004,
Author = {Badulescu, Daniel and Mester, Ioana Teodora},
Book-Group-Author = {Bucharest Univ Econ Studies},
Title = {CERTIFICATION IN TOURISM BETWEEN EXPECTATIONS AND EFFECTIVENESS. A
   QUANTITATIVE EVALUATION ON ROMANIAN COMPANIES},
Booktitle = {BASIQ 2015 INTERNATIONAL CONFERENCE: NEW TRENDS IN SUSTAINABLE BUSINESS
   AND CONSUMPTION},
Series = {Proceedings of BASIQ},
Year = {2015},
Pages = {25-32},
Note = {International Conference on New Trends in Sustainable Business and
   Consumption (BASIQ), Bucharest Univ Econ Studies, BUCHAREST, ROMANIA,
   JUN 18-19, 2015},
Organization = {Univ Heidelberg; Acad Studii Economice Bucuresti; Amfiteatru Econ; Assoc
   Innovat \& Qual Sustainable Business},
Abstract = {Starting from a survey-based research conducted among representatives of
   ventures operating in tourism and hospitality industry, we are
   investigating how they understand and actually use certification as
   means of promoting and developing sustainability related actions, and as
   opportunity to consolidate their ventures. After briefly reviewing the
   main relevant aspects and contributions on the complex relation
   certification-protection of the environment-sustainability, we launched
   and tested several hypotheses related to the perception of tourism
   operators on the necessity and use of environmental and management
   quality certification. Our results indicate that more than a half of the
   respondents are not aware of any institutions effectively dealing with
   the environment protection or with standards' certification. The
   majority of the companies holds no such certificate or is not interested
   in the process of certification. Moreover, even companies holding such
   certificates do not use them as an advantage to attract new clients.
   However, we find a positive correlation between the segment of consumers
   addressed by tourism ventures and the venture's perception on the
   necessity of certification.},
