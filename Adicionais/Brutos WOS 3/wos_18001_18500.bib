Note = {International Conference on Strategic Management (ICSM 2011), Phuket,
   THAILAND, DEC 21-23, 2011},
Abstract = {With the transformation of social and economic system of China,
   large-scale resources development activities on heritage sites have
   aroused attention from the academic circles and the general public. This
   paper starts from the interaction between the public and government
   decision-making, by role-playing research into the public participation
   and its interaction with government decision-making in resource
   development on heritage sites, to seek solutions of the public
   effectively influencing government's decision-making behavior, based on
   the harmony of stakeholder groups, so as to realize regional sustainable
   development. It has been discovered that factors influencing
   government's decision-making behavior only include media publicity,
   social environment, and public participative behavior, while the
   significant public participation factors including legal system, value
   orientation, participative behavior, participation approach, openness
   degree, interactive approach and expected results have no appreciable
   influence on government decision-making. Relevant research is not only
   of realistic significance to the sustainable development of resources on
   heritage sites, but also provides reference for China public
   participation and the construction of a civic society.},
