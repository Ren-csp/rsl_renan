@inproceedings{ WOS:000431842100011,
Author = {Baldwin, Claudia},
Editor = {Lukasiewicz, A and Dovers, S and Robin, L and McKay, J and Schilizzi, S and Graham, S},
Title = {Justice in water resource management},
Booktitle = {NATURAL RESOURCES AND ENVIRONMENTAL JUSTICE: AUSTRALIAN PERSPECTIVES},
Year = {2017},
Pages = {143-154},
Note = {Workshop on Justice, Fairness and Equity in Natural Resource Management,
   Australian Natl Univ, Fenner Sch Environm \& Soc, Canberra, AUSTRALIA,
   OCT 12-13, 2015},
Organization = {Acad Social Sci},
Abstract = {Water and its management are essential to quality of life and productive
   capacity and evoke deeply held values and emotions. Further, as a
   normative concept, what is considered fair or just is contestable. This
   chapter draws on several of my research projects in Australia, through
   six case studies, which used innovative visual research methods -
   participatory GIS, photovoice and 3D visualisation, in addition to
   interviews - to dig deep into concepts of justice surrounding water
   management. In each of the cases, innate locational characteristics and
   extreme events combined to create vulnerable situations that were
   influenced by the institutional context and either hindered or supported
   through appropriate application of elements of the Social Justice
   Framework (SJF). Implications of SJF principles for reducing conflict
   and delivering community wellbeing in adapting to a water-variable
   future are discussed.},
