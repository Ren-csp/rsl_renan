@article{ WOS:000241082300015,
Author = {Goksel, Cigdem and Musaoglu, Nebiye and Gurel, Melike and Ulugtekin,
   Necla and Tanik, Aysegul and Seker, Dursun Zafer},
Title = {Determination of land-use change in an urbanized district of Istanbul
   via remote sensing analysis},
Journal = {FRESENIUS ENVIRONMENTAL BULLETIN},
