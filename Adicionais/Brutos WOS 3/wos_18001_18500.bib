@inproceedings{ WOS:000079630400335,
Author = {Riquimaroux, H},
Editor = {Usui, S and Oori, T},
Title = {Time information in the auditory system: frequency, amplitude, macro and
   micro},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {1481-1484},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {In this paper, three topics are given to show importance of time
   information for the auditory information processing. First, the concept
   of rising speed (dB/s) is introduced. Here, the importance of stimulus
   slope, instead of the stimulus peak level, is emphasized. Data
   indicating the essential role of the rising speed on the auditory evoked
   cortical response are shown. The second topic is on the central
   processing of pitch perception. Neurophysiological evidence that the
   pitch created by spectral information (spectral pitch) and the one
   created by time information (temporal pitch) are represented by the same
   neuron in the primary auditory cortex. The findings indicate that the
   temporally-coded pitch information is place-coded together with
   spectrally-coded pitch information by the same neuron in the primary
   auditory cortex in order to produce an identical pitch. The third agenda
   is on the perception of frequency sequence. Some neurons in the primary
   auditory cortex are responsive to particular frequency sequences, which
   suggest a temporal integration of frequency information in the auditory
   cortex.},
