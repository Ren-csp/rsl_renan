@inproceedings{ WOS:000233831200005,
Author = {Spengler, JD},
Editor = {Yang, X and Zhao, B and Zhao, R},
Title = {Sustainability: The challenge of changing our world},
Booktitle = {INDOOR AIR 2005: PROCEEDINGS OF THE 10TH INTERNATIONAL CONFERENCE ON
   INDOOR AIR QUALITY AND CLIMATE, VOLS 1-5},
Year = {2005},
Pages = {P54-P55},
Note = {10th International Conference on Indoor Air Quality and Climate (Indoor
   Air 2005), Beijing, PEOPLES R CHINA, SEP 04-09, 2005},
Organization = {Tsinghua Univ; Minist Educ China; Natl Nat Sci Fdn China; Beijing
   Municipal Commiss Sci \& Technol; Shanghai Municipal Commiss Sci \&
   Technol; US EPA; Amer Ind Hyg Assoc; Amer Soc Heating, Refrigerating \&
   Air Conditioning Engineers; Int Commiss Occupat Hlth, SC Indoor Air Qual
   \& Hlth; Int Council Res \& Innovat Bldg \& Construct; European Commiss
   Asia Pro Eco Programme Promot Sustainable Solut Environm Europe \& Asia;
   Korean Soc Indoor Environm; Soc Indoor Environm},
Abstract = {The young professionals and students attending Indoor Air 2005 in
   Beijing face career and personal choices that are very different from
   those I faced in 1975 - a generation ago. I could not then, nor can you
   now, project 30 years into the future to foresee the challenges we will
   face for indoor air research and all the changes that will occur around
   us. The first Earth Day motivated me to apply my education in physics
   and atmospheric sciences to air pollution and public health. and
   eventually to indoor environments. With passage of national legislation,
   the U.S. finally recognized the serious health consequences of urban air
   pollution. The concepts of regional, much less global, transport of air
   pollutant were understood by very few people. Rachel Carson had made us
   aware that DDT pesticide had grave consequences for the health of our
   ecosystem. In the early 1970s, naturalist Vincent Schaefer reported at
   conferences his observations that Los Angeles smog was impacting
   visibility at the Grand pollution was local and Canyon, 1000km away. Not
   many of his fellow scientists shared his concerns. Back then. strategies
   matched the geo-political structures around which most countries were
   organized. Outdoor air pollution was so obvious that not many recognized
   the importance of pollutants in our homes, schools and office.
   Several things happened to change the way people considered indoor
   pollution. The worldwide energy crisis of the 1970s led to reduced
   ventilation and increased insulation. Sick building syndrome emerged as
   new jargon to express general and widespread complaints associated with
   schools and office buildings. The first international meeting on Indoor
   Air and Climate in 1978 in Copenhagen followed by various WHO workshops
   and reports gave a context and a language for many engineers, scientists
   and medical researchers to explore a newly emerging topic. As so often
   happens with new disciplines, indoor air science was first founded on
   observations and associations to be followed by prediction, causality
   and solutions. From the first and second international (Copenhagen,
   Denmark, 1978: Amherst, MA, USA, 1981) Indoor Air and Climate meetings
   the International Academy for Indoor Air Sciences and the International
   Society for Indoor Air Quality and Climate were originated to advance
   the indoor air sciences. Worldwide appreciation of the importance of
   indoor environments to the health, comfort, safety, security and well
   being of society has been advanced but it is clearly not universally
   recognized. Indoor air science as a discipline has matured based on the
   strength of evidence and the economic importance. Quantifying the
   relationships among building design factors and outcomes, such as 0,
   productivity, illnesses and risk of disease gives us the ability to
   express consequences in monitoring symptoms. terms. We are now gaining a
   new language to express choices in building design, operation,
   maintenance, air cleaning and surveillance in the parlance of
   benefit-cost analyses. In effect, indoor air is in transformation from
   an esoteric social idea or legal liability to a building design
   parameter that can be optimized in tradeoffs with other design features.
   Consider the implications of where this field might be in just a few
   years. Expressing lighting, filtration, noise, ventilation and materials
   in economic terms of enhanced occupant performance, preference and
   reduction of risk, allows us to incorporate indoor air quality benefits
   into lifecycle costing. Indoor air quality experts, equipped with
   quantitative analysis, will now have a more meaningful role in the
   process of designing and operating high performance buildings. The
   process of `valued engineering' that eliminates the more costly features
   of a building will soon have to consider the longer term consequences of
   comprising occupants' well being.},
Publisher = {TSINGHUA UNIVERSITY PRESS},
Address = {TSINGHUA UNIVERSITY HAIDIANQU, BEIJING 100084, PEOPLES R CHINA},
Type = {Proceedings Paper},
