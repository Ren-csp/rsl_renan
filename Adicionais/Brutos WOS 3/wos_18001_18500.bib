@inproceedings{ WOS:000080892300045,
Author = {Bath, AJ},
Editor = {Miller, SD and Reynolds, HV},
Title = {The role of human dimensions in wildlife resource research in wildlife
   management},
Booktitle = {URSUS, VOL 10 - 1998},
Series = {URSUS (SERIES)},
Year = {1998},
Volume = {10},
Pages = {349-355},
Note = {10th International Conference on Bear Research and Management, MORA,
   SWEDEN, SEP 11-14, 1995},
Organization = {Norwegian Polar Inst; Swedish Environm Protect Agcy; World Wildlife
   Fund-Sweden; Gronklitt Bear Park; Orsa Communal Forest; Swedish Hunters
   Assoc; Norwegian Directorate Nat Managenment},
Abstract = {The human dimension in wildlife resource (HDWR) management is
   increasingly recognized by wildlife managers as an important component
   to understand and to integrate into daily decision-making. The nature of
   human dimensions and HDWR research has changed from a traditional
   emphasis on hunters and big game species to economic issues. To aid bear
   (Ursidae) managers, I outline the types of questions which can be
   answered, integrate examples of research with large predators from
   around the world, and discuss public involvement in wildlife management.
   As human dimensions research remains a relatively unknown approach in
   wildlife management, wildlife managers can benefit from an overview of
   the field. Especially for managers of large predators such as bears,
   which often elicit strong public emotions, management becomes as much a
   sociopolitical issue as a biological one.},
Publisher = {INTERNATIONAL ASSOCIATION BEARRESEARCH \& MANAGEMENT},
Address = {GLACIER NATL PK, WEST GLACIER, MT 59936 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Bath, AJ (Corresponding Author), Mem Univ Newfoundland, Dept Geog, St Johns, NF A1B 3X9, Canada.
   Mem Univ Newfoundland, Dept Geog, St Johns, NF A1B 3X9, Canada.},
ISBN = {0-944740-07-3},
Keywords = {attitudes; bears; beliefs; Canis lupus; economics; human dimensions;
