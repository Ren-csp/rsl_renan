@article{ WOS:000444996500170,
Author = {Sulaiman, Noralfishah and Mohammed, Mohammed Ishaq and Ghani, Zubairu
   Abubakar},
Title = {Factors Influencing Reverse Mortgage (RM) Product Market},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4623-4625},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {Reverse mortgage has recently been widely promoted as a financial
   product speacially designed to enable the elderly people consume the
   accumulated equity trapped in their residential homes in order to avoid
   the risk of financial insecurity in old-age. Results of simulation
   studies from the U.S., U.K., Australia and China revealed a promising
   potential for the product with a market demand running into millions.
   However, more than four decades after its formal launch in the U.S., the
   actual market size is still far below the theoretical estimates. Whereas
   the extant literature attempted to explain the reasons behind this
   phenomenon, there seems to be no coherent text that attempted to
   identify and or categorize the myriad of factors that are believed to
   influence the growth of this product market. In an attempt to fill in
   this gap, the present paper aims at identifying the factors influencing
   reverse mortgage product demand with a view to categorizing these
   factors into their respective components. The findings suggest that
   factors influencing reverse mortgage market could broadly be categorized
   into four components: institutional, economic, socio-cultural, and
   behavioural factors.},
