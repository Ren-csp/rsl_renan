@article{ WOS:000261809600002,
Author = {Scott, Emma and Borate, Uma and Heitner, Stephen and Chaitowitz, Mark
   and Tester, William and Eiger, Glenn},
Title = {Pain Management Practices by Internal Medicine Residents-A Comparison
   Before and After Educational and Institutional Interventions},
Journal = {AMERICAN JOURNAL OF HOSPICE \& PALLIATIVE MEDICINE},
Year = {2008},
Volume = {25},
