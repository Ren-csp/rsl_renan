Title = {VISIBILITY ANALYSIS IN WETLAND PROTECTION PROCESSES},
Booktitle = {TENTH INTERNATIONAL SYMPOSIUM MONITORING OF MEDITERRANEAN COASTAL AREAS:
   PROBLEMS AND MEASUREMENT TECHNIQUES},
