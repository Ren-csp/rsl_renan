   Monell Chem Senses Ctr, Philadelphia, PA 19104 USA.},
ISSN = {0097-6156},
EISSN = {1947-5918},
ISBN = {978-0-8412-7432-7},
Keywords-Plus = {PROTEIN-COUPLED RECEPTORS; CHORDA TYMPANI RESPONSES; COCKATIELS
   NYMPHICUS-HOLLANDICUS; SUBSENSITIVE 129P3/J MICE; MOUSE STRAIN
   DIFFERENCES; QUANTITATIVE TRAIT LOCI; SACCHARIN PREFERENCE; INBRED
