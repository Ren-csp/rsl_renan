@article{ WOS:A1994PZ92500002,
Author = {MULLEN, JK and WILLIAMS, M},
Title = {MARGINAL TAX RATES AND STATE ECONOMIC-GROWTH},
Journal = {REGIONAL SCIENCE AND URBAN ECONOMICS},
Year = {1994},
Volume = {24},
Number = {6},
Pages = {687-705},
Month = {DEC},
Note = {37th North-American Meetings of the
   Regional-Science-Association-International, BOSTON, MA, NOV, 1990},
Organization = {REG SCI ASSOC INTER},
Abstract = {This paper analyzes the impact of state-local tax structures on state
   economic performance.  Specifically, growth rates in Gross State Product
   over the 1969-86 period are related to several measures of a state's
   marginal tax environment in addition to more traditional growth
   determinants.  Estimates of marginal tax rates for individual states are
   derived and utilized alternately with other tax climate surrogates in
   explaining variations in economic growth.  We report both output and
   productivity equations in order to distinguish separate impacts
   resulting from taxation; the endogeneity problem is also addressed in
   this fashion.  The findings suggest that, after controlling for overall
   tax burdens, higher marginal tax rates impede output growth.},
