@inproceedings{ WOS:000383740306033,
Author = {Desouzart, Gustavo and Filgueiras, Ernesto and Matos, Rui},
Editor = {Ahram, T and Karwowski, W and Schmorrow, D},
Title = {Relationship between postural reeducation technique during sleep and
   relaxation technique in sleep quality},
Booktitle = {6TH INTERNATIONAL CONFERENCE ON APPLIED HUMAN FACTORS AND ERGONOMICS
   (AHFE 2015) AND THE AFFILIATED CONFERENCES, AHFE 2015},
Series = {Procedia Manufacturing},
