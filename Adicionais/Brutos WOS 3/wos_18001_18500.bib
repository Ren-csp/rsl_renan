@inproceedings{ WOS:000467120500015,
Author = {Hamamcioglu, Cenk and Yenen, Zekiye},
Editor = {Brebbia, CA and Longhurst, J and Marco, E and Booth, C},
Title = {PROPOSING A HOLISTIC BASIN-SCALE AS A STRATEGY OF SMART PLANNING IN
   ADAPTATION TO CLIMATE CHANGE},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
