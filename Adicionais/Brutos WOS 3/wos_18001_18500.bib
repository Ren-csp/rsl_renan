Title = {The Relationship among Service Quality, Ecological Integrity and Tourist
   Satisfaction-A Case Study of Tianmu Mountain Nature Reserve in Zhejiang
   Province},
Booktitle = {ENVIRONMENT, LOW-CARBON AND STRATEGY},
Year = {2011},
Pages = {202-208},
Note = {International Conference on Strategic Management (ICSM 2011), Phuket,
   THAILAND, DEC 21-23, 2011},
Abstract = {In this study, we randomly survey 362 visitors from Tianmu Mountain
   Nature Reserve in Zhejiang Province since this area can be regarded as a
   representative research site with relatively high ecological integrity,
   abundant nature resource and well-developed ecotourism in China. To
   understand the important factors influencing tourist satisfaction, we
   try to investigate tourists from four aspects, which include visitors'
   perception of reception level, their view of local ecological
   environment and their evaluation of local culture and custom and their
   socio-economic characteristics. Our results reveal that among these four
   perceived aspects, visitors' perception of reception level and their
   view of ecologically environmental quality significantly influence the
   overall satisfaction, while their evaluation of local culture and custom
   have no effect on the satisfaction evaluation. In terms of their
   socio-demographic characteristics, our analyses also indicate that aged
   tourists give a higher overall satisfaction than younger visitors. As
   for other socio-economic characteristics, they do not have significant
   effects on their overall satisfaction. These conclusions provide some
   guidelines for ecotourism planning and management and offer some basis
   for related government agencies decision making.},
