@article{ WOS:000233093600022,
Author = {Schmuckler, MA and Tomovski, R},
Title = {Perceptual tests of an algorithm for musical key-finding},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2005},
Volume = {31},
Number = {5},
Pages = {1124-1149},
Month = {OCT},
Note = {38th Annual Meeting of the Psychonomic-Society, PHILADELPHIA, PA, NOV,
   1997},
Organization = {Psychon Soc},
Abstract = {Perceiving the tonality of a musical passage is a fundamental aspect of
   the experience of hearing music. Models for determining tonality have
   thus occupied a central place in music cognition research. Three
   experiments investigated I well-known model of tonal determination: the
   Krumhansl-Schmuckler key-finding algorithm. In Experiment 1, listeners'
   percepts of tonality following short musical fragments derived from
   preludes by Bach and Chopin were compared with predictions of tonality
   produced by the algorithm; these predictions were very accurate for the
   Bach preludes but considerably less so for the Chopin preludes.
   Experiment 2 explored a subset of the Chopin preludes, finding that the
   algorithm could predict tonal percepts on a measure-by-measure basis. In
   Experiment 3, the algorithm predicted listeners' percepts of tonal
   movement throughout a complete Chopin prelude. These studies support the
   viability of the Krumbansl-Schmuckler key-finding algorithm as well as a
   model of listeners' tonal perceptions of musical passages.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Schmuckler, MA (Corresponding Author), Univ Toronto, Dept Life Sci, 1265 Mil Trail, Scarborough, ON M1C 1A4, Canada.
   Univ Toronto, Dept Life Sci, Scarborough, ON M1C 1A4, Canada.},
DOI = {10.1037/0096-1523.31.5.1124},
ISSN = {0096-1523},
EISSN = {1939-1277},
