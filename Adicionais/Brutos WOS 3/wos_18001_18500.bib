Title = {Choreographic Infrastructuring for Design Things A New Method for
   Participatory Design in Teacher Education},
Booktitle = {PROCEEDINGS OF THE 17TH PARTICIPATORY DESIGN CONFERENCE, PDC 2022, VOL 1},
