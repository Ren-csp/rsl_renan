@article{ WOS:000609158900024,
Author = {Vanacore, Amalia and Lanzotti, Antonio and Percuoco, Chiara and Capasso,
   Agostino and Vitolo, Bonaventura},
Title = {A model-based approach for the analysis of aircraft seating comfort},
Journal = {WORK-A JOURNAL OF PREVENTION ASSESSMENT \& REHABILITATION},
Year = {2021},
Volume = {68},
Number = {1},
Pages = {S251-S255},
Note = {2nd International Comfort Congress (ICC), Delft, NETHERLANDS, AUG 29-30,
   2019},
Abstract = {BACKGROUND: Aircraft seating comfort has a significant impact on
   passenger on-board experience. Its assessment requires the adoption of
   well-designed strategies for data collection as well as appropriate data
   analysis methods in order to obtain accurate and reliable results.
   OBJECTIVE: This paper focuses on the assessment of aircraft seating
   comfort based on subjective comfort responses collected during
   laboratory experiments and taking into account seat features and
   passenger characteristics.
   METHODS: The subjective comfort evaluations have been analyzed using a
   model-based approach to investigate the relationship between overall
   seating comfort and specific seat/user characteristics.
   RESULTS: The results showthat the overall seating comfort perception is
   significantly influenced by the thickness of the seat pan, the backrest
   position (upright or reclined), the age of the passenger and the
   passenger perception of being comfortably supported at the lumbar
   region.
   CONCLUSIONS: The adopted model-based approach allows the analysis of
   subjective seating comfort data taking into account their ordinal nature
   as well as the dependency between evaluations provided by the same
   subject.},
