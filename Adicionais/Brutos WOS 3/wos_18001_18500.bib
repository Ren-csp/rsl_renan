@article{ WOS:A1996VH89700005,
Author = {Trimble, MR},
Title = {Neuropsychiatric complications of epilepsy and its drug treatment},
Journal = {EUROPEAN JOURNAL OF NEUROLOGY},
Year = {1996},
Volume = {3},
Number = {3},
Pages = {21-25},
Month = {AUG},
Note = {Round Table Meeting on Strategies for the Rational Drug Treatment of
   Epilepsy, MARLOW, ENGLAND, JUN 08-10, 1995},
Organization = {Hoechst Marion Roussel},
Abstract = {Lesions of the limbic system, including those which cause epilepsy, are
   likely to lead individuals to be susceptible to psychiatric problems,
   since this is the area of the brain representing the cerebral substrate
   of the emotions and memory. Thus, patients with limbic system epilepsy
   may be susceptible to behavioural difficulties. Further, anti-epileptic
   drugs can be associated with psychiatric disturbances, although some of
   them also have psychotropic effects. In patients taking the new
   anti-epileptic agents, psychiatric problems may be associated with a
   past history of psychiatric illness, significantly higher doses of the
   drug, or sudden cessation of seizures in patients who are intractable.
   The only anti-epileptic drug that is well characterized with regards to
   cognitive effects is vigabatrin, and no adverse effects have been
   detected. Further studies are needed to assess in full the behavioural
   repertoire of these new agents.},
