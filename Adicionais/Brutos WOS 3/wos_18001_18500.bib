@article{ WOS:000288008100006,
Author = {Prevete, Roberto and Tessitore, Giovanni and Catanzariti, Ezio and
   Tamburrini, Guglielmo},
Title = {Perceiving affordances: A computational investigation of grasping
   affordances},
