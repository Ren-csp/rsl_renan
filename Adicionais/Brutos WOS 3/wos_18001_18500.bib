@article{ WOS:000432384000024,
Author = {Ibrahim, Emma Nuraihan Mior and Ang, Chee Siang},
Title = {Communicating Empathy: Can Technology Intervention Promote Pro-Social
   Behavior?-Review and Perspectives},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {3},
Pages = {1643-1646},
Month = {MAR},
Note = {International Conference on Computer and Network Applications (ICCNA),
   Kota Kinabalu, MALAYSIA, SEP 05-06, 2017},
Abstract = {Empathy is seen as the underlying foundation for successful pro-social
   behavior interaction and collaboration in a society. Increased empathy
   reduces the likelihood of prejudice, racism, creates safer societies and
   make compassion possible within homogeneous cultures. Many articles
   wrote about how technology lessen the social awareness, humanity and
   empathy towards others. However we argued that technology-enhanced
   environment can support empathy experience and civic engagement. It
   gives rise to unique approach in transcending social experience within
   computer mediated environment. In this paper, we provide the reader an
   overview on the notion of empathy and highlighted the current trend of
   various technology intervention to heighten empathic experience. We
   discussed how these technologies can augment human sensory and gives
   reliable measurements of human emotion as opposed to the traditional
   laboratory research. Research implication and potential future research
   agenda within empathic computing are discussed.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
Type = {Proceedings Paper},
Language = {English},
