@inproceedings{ WOS:000224368900004,
Author = {Cho, H and Mattson, RH},
Editor = {Relf, D},
Title = {Affective responses and group cohesion of female university students in
   horticultural lectures and laboratories},
Booktitle = {EXPANDING ROLES FOR HORTICULTURE IN IMPROVING HUMAN WELL-BEING AND LIFE
   QUALITY},
Series = {ACTA HORTICULTURAE},
Year = {2004},
Number = {639},
Pages = {45-50},
Note = {26th International Horticultural Congress, TORONTO, CANADA, AUG 11-17,
   2002},
Organization = {Canadian Soc Hort Sci; Int Soc Hort Sci; Univ Guelph},
Abstract = {Fourteen female university students from a horticultural laboratory
   (LAB) and 10 from a landscape lecture (LEC) class were compared in group
   cohesion and affective responses. Initially, scores of group integration
   to social and task interactions were higher in LAB classes, as compared
   to LEC classes (p<0.05). After 12 weeks, overall group cohesion was
   slightly increased in both classes. Emotional responses were positively
   related with group integration to task attraction in both classes.
   Positive emotions tended to be higher in laboratory activities with
   living plants and multi-dimensional tasks. In LAB classes, correlation
   coefficients between group integration and individual's attraction to
   social interactions were significantly increased after 12 weeks
   (p<0.05). This study suggests that different plant activities influence
   emotional responses that alter group cohesion.},
