@article{ WOS:A1997XN47900005,
Author = {Hillerdal, G},
Title = {Pleural plaques: Incidence and epidemiology, exposed workers and the
   general population},
Journal = {INDOOR AND BUILT ENVIRONMENT},
Year = {1997},
Volume = {6},
Number = {2},
Pages = {86-95},
Month = {MAR-APR},
Note = {International Meeting on Pathogenesis, Diagnosis and Clinical Relevance
   of Pleural Plaques, BRUDERHOLZ, SWITZERLAND, JAN, 1997},
Abstract = {Pleural plaques are the most common manifestation of exposure to
   asbestos. It is vital that they are properly defined radiologically; if
   this is done, the specificity for asbestos exposure is 80-90\%. The ILO
   system is not very good for the diagnosis of plaques. In the general
   urban population, the incidence of plaques is 1-6.8\% in Western
   countries among men aged 30 or more. Apart from occupational exposure,
   pleural plaques have been reported from domestic exposure and from
   environmental pollution in certain areas of the world where asbestos
   minerals occur locally. In some countries, exposure is mainly due to the
   local inhabitants using crushed asbestos-containing rocks for
   white-washing houses. In these areas, 40\% or more of the population can
   show plaques on chest roentgenogram, and extremely high figures are seen
   on autopsy.},
