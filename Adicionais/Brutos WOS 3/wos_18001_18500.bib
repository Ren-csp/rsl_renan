@article{ WOS:000365243500100,
Author = {Shagari, Shamsudeen Ladan and Saad, Natrah},
Title = {The Impact of Board Autonomy and Information and Communication
   Technology on Tax Administration Efficiency: Evidence from Nigeria},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2015},
Volume = {21},
Number = {6, SI},
Pages = {2042-2045},
Month = {JUN},
Note = {International Conference on Business, Management, Tourism and
   Hospitality (BIZMATOUR), Malacca, MALAYSIA, MAY 12-14, 2015},
Abstract = {This paper examines the level of efficiency of tax administration in
   Nigeria as well as the association between board autonomy and
   information and communication technology (ICT) with tax administration
   efficiency. Notwithstanding various claims on such association, limited
   studies have been conducted on tax authorities in Nigeria. Such
   literature gap triggers he researchers to undertake this study, focusing
   on tax officers' perceptions. For that purpose, self-administered survey
   was conducted among tax officers in Bauchi State, Nigeria. Descriptive
   and correlation analyses were performed on the data in order to answer
   the objectives of the study. Results from descriptive analysis indicate
   positive perceptions on administration efficiency, board autonomy and
   deployment of ICT in the tax department. Further, correlation analysis
   suggests that board autonomy and ICT have positive correlation with tax
   administration efficiency. Explicitly, the results suggest that in order
   to enhance the efficiency of tax administration, the tax authority
   should focus on promoting board autonomy and investing in ICT
