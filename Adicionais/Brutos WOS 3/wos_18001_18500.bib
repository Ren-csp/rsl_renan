@inproceedings{ WOS:000502759200040,
Author = {Zhang, Yunhong and Liu, Na and Chen, Hong},
Editor = {Ayaz, H},
Title = {Evaluation of Fatigue and Comfort of Blue Light Under General Condition
   and Low Blue Light Condition},
Booktitle = {ADVANCES IN NEUROERGONOMICS AND COGNITIVE ENGINEERING},
