   Deborah and Johnson, Mark A. and Blankenship, Morgan and Chronopoulou,
   Alexandra and Wooldridge, Abigail R.},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {The Influence of Past Experience with Wristbands and Use Exposure on
   Perceived Usability of Wearable Wrist Worn Sensors by Nurses},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
