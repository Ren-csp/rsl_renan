@inproceedings{ WOS:000306295900007,
Author = {Glicksohn, Joseph and Leshem, Rotem},
Editor = {Vatakis, A and Esposito, A and Giagkou, M and Cummins, F and Papadelis, G},
Title = {Reproduction of Duration: How Should I Count the Ways?},
