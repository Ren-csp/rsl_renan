@article{ WOS:000247517600004,
Author = {Noronha, Ana L. A. and Fernandes, Paula T. and Andrade, Maria da Graca
   G. and Santiago, Silvia M. and Sander, Josemir W. and Li, Li M.},
Title = {Training medical students to improve the management of people with
   epilepsy},
