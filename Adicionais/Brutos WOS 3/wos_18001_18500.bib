Language = {English},
Affiliation = {Das, TK (Corresponding Author), NYU, Zicklin Sch Business, Dept Management, 1 Bernard Baruch Way,Box B9-240, New York, NY 10010 USA.
   NYU, Zicklin Sch Business, Dept Management, New York, NY 10010 USA.
   George Washington Univ, Washington, DC 20052 USA.},
DOI = {10.1023/B:JOBU.0000040274.23551.1b},
ISSN = {0889-3268},
EISSN = {1573-353X},
Keywords = {trust, risk-trust relationship; trust antecedents; subjective trust;
   behavioral trust},
