@article{ WOS:000248617400013,
Author = {Miller, Ariel and Panitch, Hillel},
Title = {Therapeutic use of dextromethorphan: Key learnings from treatment of
   pseudobulbar affect},
Journal = {JOURNAL OF THE NEUROLOGICAL SCIENCES},
Year = {2007},
Volume = {259},
Number = {1-2, SI},
Pages = {67-73},
Month = {AUG 15},
Note = {11th Symposium of the European-Charcot-Foundation, Lisbon, PORTUGAL, NOV
   17-19, 2005},
Organization = {European Charcot Fdn},
Abstract = {A varietv of neurological conditions and disease states are accompanied
   by pseudobulbar affect (PBA), an emotional disorder characterized by
   uncontrollable outbursts of laughing and crying. The causes of PBA are
   unclear but may involve lesions in neural circuits regulating the motor
   output of emotional expression. Several agents used in treating other
   psychiatric disorders have been applied in the treatment of PBA with
   some success but data are limited and these agents are associated with
   unpleasant side effects due to nonspecific activity in diffuse neural
   networks. Dextroimethorphan (DM), a widely used cough suppressant, acts
   at receptors in the brainstem and cerebellum, brain regions implicated
   in the regulation of emotional output. The combination of DM and
   quinidine (Q), an enzyme inhibitor that blocks DM metabolisin, has
   recently been tested in phase III clinical trials in patients with
   multiple sclerosis and amyotrophic lateral sclerosis and was both safe
   and effective in palliating PBA symptoms. In addition, clinical studies
   pertaining to the safety and efficacy of DM/Q in a variety of
   neurological disease states are ongoing, (C) 2007 Elsevier B.V. All
   rights reserved.},
