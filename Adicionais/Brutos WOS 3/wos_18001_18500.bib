@article{ WOS:000082661200002,
Author = {Martin, R and Wan, CK and David, JP and Wegner, EL and Olson, BD and
   Watson, D},
Title = {Style of anger expression: Relation to expressivity, personality, and
   health},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {1999},
Volume = {25},
Number = {10},
Pages = {1196-1207},
