@inproceedings{ WOS:001027151200028,
Author = {Corrado, Simone and Scorza, Francesco and Murgante, Beniamino},
Book-Group-Author = {IEEE},
Title = {Information theory to support planning on regionalization issue},
Booktitle = {2023 IEEE INTERNATIONAL WORKSHOP ON METROLOGY FOR LIVING ENVIRONMENT,
   METROLIVENV},
Year = {2023},
Pages = {142-145},
Note = {IEEE International Workshop on Metrology for Living Environment
   (MetroLivEnv), Milano, ITALY, MAY 29-31, 2023},
Organization = {IEEE; Politecnico Milano},
Abstract = {Metrology contributes significantly to territorial planning. The
   possibility of measuring several components and dynamics insisting on a
   territory allows for the validation of choices for the sustainable
   development of a context. This paper discusses the role of metrology in
   spatial planning and the importance of precise measurement and data
   interpretation in making informed decisions. The increasing availability
   of geospatial data has led to the development of a new trend in
   geospatial computing, geoAI, which uses interdisciplinary methods,
   ranging from computer science, statistics and geography, to optimize the
   analysis of spatial dynamics. Accurate measurement also ensure that the
   various components of a given area are properly analyzed and understood.
   The aim is to make planning choices targeting spatial development most
   akin to places and maximize positive impacts on territory. However,
   selecting the correct statistical unit for analysis is still a
   challenge, and the modifiable areal unit problem (MAUP) can affect the
   insights gained from data analysis. The focus of this contribution is to
   indicate a validation metric for regionalization issue using techniques
   from information theory, such as the Kullback-Leibler Divergence (KL).
   Specifically, a normalized and symmetrical version of the KL divergence
   is used to identify a proper region subdivision and the appropriate set
   of parameters to use. The key idea is to validate the regionalization by
   maximizing the divergence across the analyzed parameter set. Further,
   identify the parameters with the highest variability that can contribute
   to validate the chosen region subdivision.},
