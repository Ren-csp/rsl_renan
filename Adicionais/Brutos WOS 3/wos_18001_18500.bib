@inproceedings{ WOS:001315687100021,
Author = {Greif-Winzrieth, Anke and Dorner, Verena and Wuest, Fabian and Gorny,
   Paul M. and Weinhardt, Christof},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB and Muller-Putz, GR},
Title = {Seeing Is Feeling: Emotional Cues in Others' Heart Rate Visualizations},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2023},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2024},
