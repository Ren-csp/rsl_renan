Organization = {Portuguese Soc Occupat Safety \& Hygiene; Univ Minho, Sch Engn; Univ
   Porto, Fac Engn; Univ Lisbon, Fac Human Kinet; Polytechn Univ Catalonia;
   Tech Univ Delft; Faculdade Motricidade Humana; DELTA; EXIM; ACT;
   European Agcy Safety \& Hlth Work; Lavoro},
Abstract = {The self-rated health and women's quality of life has increasing
   interest among researchers because of social rise of the role of women
   in the society, no different in the workplace. The objective of this
   paper is to evaluate the working relationship with the self-perception
   of health and quality of life of women of reproductive age from a small
   city located in Brazilian northeast, with a cross-sectional study,
   conducted with 579 women aged between 18 and 49 years. The average age
   of participants was about 30 years and the women who worked mostly were
   married, non-white race, had children and practiced any religion. The
   average workload was 7 hours per day. In this case, was possible to
   conclude that work for women contributes to a better quality of life and
   a better self-perceived health, contributing to a greater social
   perception, increasing the quality of life, when compared to unemployed
   women of the same age.},
