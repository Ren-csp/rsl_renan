@article{ WOS:000432354700054,
Author = {Suliman, Ashairi and Nor, Mohamed Yusoff Mohd and Yunus, Melor Md},
Title = {Rebranding of the Form Six Programme in Malaysian Schools: Is ICT Being
   Utilised Well?},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {1},
Pages = {184-186},
Month = {JAN},
Note = {International Conference on Social Sciences and Education (ICSSE),
   Bandung, INDONESIA, NOV 21-23, 2017},
Abstract = {The rebranding of the Form Six programme in the Malaysian Education
   System aims to ensure the quality of Form Six students are on par with
   other pre-university students and to arm the students with the
   university atmosphere learning environment. Despite advocating the idea
   of nurturing independent learners, the `spoon feeding' culture is still
   prevalent among the form six students. With the inevitable influence of
   Information and Communication Technology (ICT) in the education system,
   students are encouraged to employ the ICT tools in enhancing their
   learning process. Hence, the study intends to identify ICT tools usage
   among the students and their perceptions of ICT. This quantitative study
   involved 203 Form Six students as the respondents. The findings showed
   that the respondents utilised ICT greatly for searching information on
   the Internet and online chatting. In addition, the respondents
   demonstrated positive perceptions of ICT. However, their ICT usage needs
   to be enhanced more-for educational purposes. To sum up, the respondents
   believed that ICT assisted their learning process. Thus, they should be
   given more flexibility to explore ICT as it benefits their learning
   process.},
