@article{ WOS:000224504500006,
Author = {Das, TK and Teng, BS},
Title = {The risk-based view of trust: A conceptual framework},
Journal = {JOURNAL OF BUSINESS AND PSYCHOLOGY},
Year = {2004},
Volume = {19},
Number = {1},
Pages = {85-116},
Month = {FAL},
Note = {58th Annual Meeting of the Academy-of-Management, SAN DIEGO, CA, AUG
   09-12, 1998},
Organization = {Acad Management},
Abstract = {Trust and risk have often been linked in the literature, but their
   relationship is far from clear. Trust has been used in three different
   ways namely, as a perception ({''}subjective trust{''}), as various
   personal and situational factors that lead to subjective trust
   ({''}trust antecedents{''}), and as the actions resulting from
   subjective trust ({''}behavioral trust{''}). We explain how risk is
   related to these three conceptions of trust. First, we argue that
   subjective trust and perceived risk are in fact mirror images of each
   other. Second, we show how behavioral trust can be viewed as risk
   taking, so that the causal relationship between subjective trust and
   behavioral trust is similar to that of perceived risk and risk taking.
   And third, we discuss the role of personal characteristics (such as risk
   propensity and trust propensity) in the risk-trust relationship. We also
   develop a number of propositions based on our risk-based view of trust.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
