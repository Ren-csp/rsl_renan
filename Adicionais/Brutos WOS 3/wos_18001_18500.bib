@inproceedings{ WOS:000351506700046,
Author = {Sung, Hui-Yun and Parboteeah, Paul},
Editor = {Rooney, J and Murthy, V},
Title = {A Community Engagement Theory Perspective on Communities of Practice for
   Knowledge Sharing},
Booktitle = {PROCEEDINGS OF THE 11TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT AND ORGANISATIONAL LEARNING (ICICKM 2014)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2014},
Pages = {393-399},
Note = {11th International Conference on Intellectual Capital, Knowledge
   Management and Organisational Learning (ICICKM), Univ Sydney Business
   Sch, Sydney, AUSTRALIA, NOV 06-07, 2014},
Abstract = {This paper aims to create a modified Communities of Practice (CoP)
   theory built on Community Engagement (CE) theory. CoPs are groups of
   people, often in organisations, who share a concern or a passion for
   something they do and learn how to improve as they interact regularly.
   CoPs are often cited as being a good tool for use in knowledge
   management (KM) initiatives because they help with the sharing of tacit
   knowledge, including best practice and expertise. CoPs tend to be found
   in project-orientated knowledge intensive organisations where clients
   often have a role in co-producing the product/service. However, KM
   projects often have a high failure rate, for numerous reasons, and
   projects that centre on CoPs are no different. Probst and Borzillo
   (2008) among others find five reasons why such projects can fail, thus
   emphasising the need for a more detailed look at the role of CoPs in KM
   and how their success rate can be improved. This paper argues for the
   inclusion of CE theory into CoP theory to better improve the success of
   CoPs. CE has been widely acknowledged as a process towards sharing
   decision-making and empowering people. Sung et al (2013) identified that
   CE approaches in organisations bring about different results from
   traditional approaches to KM dependent on the community's attitudes,
   knowledge and behaviours towards the engagement process. For promoting
   genuine empowerment and sustainability, this research focuses on the
   community-driven approach and the organic nature of the CE. The paper
   follows the Dubin theory building methodology to create a new CoP model,
   built inherently on CE theory. Dubin consists of two parts, a conceptual
   phase and a testing/implementation stage. This paper focuses on the
   first four stages (theory development) to create the conceptual model
   and a multidisciplinary approach was used to rigorously merge models
   from the two theories (CoP and CE). The resulting model maps elements of
   CoPs onto Sung et al's (2013) model of successful engagement. The new
   model proposed by this paper offers several implications for current
   theory and practice in KM. First, the new model should afford better
   participation in knowledge management efforts. By better understanding
   the intrinsic reasons why people participate in society, the concept of
   rewards in KM becomes irrelevant. The new model also supports the
   transfer of tacit knowledge between employees by encouraging employees
   to contribute to the survival of the community and its growth beyond the
   capabilities of any one member. Looking to the future, the new model
   offered in this paper proposes a new approach to categorizing knowledge
   intensive organisations according to Sung et al's (2013) seven-part
   model. This is an original piece of research because this is the first
   paper to take a CE perspective on CoPs in organisations. This paper
   concludes by offering propositions for testing the new CoP model and by
   considering how it fits into the KM landscape.},
