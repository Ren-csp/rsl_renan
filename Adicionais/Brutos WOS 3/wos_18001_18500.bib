@article{ WOS:000086955400002,
Author = {McHale, SM and Updegraff, KA and Jackson-Newsom, J and Tucker, CJ and
   Crouter, AC},
Title = {When does parents' differential treatment have negative implications for
   siblings?},
Journal = {SOCIAL DEVELOPMENT},
Year = {2000},
