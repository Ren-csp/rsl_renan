Title = {The effects of the bioanode on the microbial community and element
   profile in paddy soil},
Booktitle = {ENVIRONMENTAL ARSENIC IN A CHANGING WORLD (AS2018)},
Series = {Arsenic in the Environment},
Year = {2018},
Pages = {108-109},
Note = {7th International Congress and Exhibition on Arsenic in the Environment
   (As) - Environmental Arsenic in a Changing World, Chinese Acad Sci, Inst
   Urban Environm, Beijing, PEOPLES R CHINA, JUL 01-06, 2018},
Organization = {KTH Royal Inst Technol; Univ So Queensland; KWR Watercycle Res Inst;
   Univ Newcastle; Int Soc Groundwater Sustainable Dev; Inst Urban
   Environm; China Univ Geosciences; Univ S Australia, CRC CARE; China
   Assoc Sci \& Technol, China Ctr Int Sci \& Technol Exchange; OPCW},
Abstract = {In paddy soil the reductive dissolution of iron oxide and the
   availability of organic matter plays an important role in arsenic
   release under anaerobic conditions. Microbial fuel cells have been shown
   to reduce organic matter (OM) content and the rate in which this occurs
   strongly relate to the external resistance applied. In this study we
   investigated the effects of bioanode operating at different external
   resistance on the paddy soil microbial community and iron and arsenic
   concentration. The results show that MFC can be used to reduce soil pore
   water iron and arsenic concentration and the extent in which this occurs
   depend on the external resistance applied. The MFC is able to mitigate
   arsenic release by decreasing organic matter availability. Furthermore,
   our finding shows that external resistance had a significant influence
   on the bacterial community composition that develop on the bioanode
   however only had minimal effect on the community of the bulk soil. These
   findings suggest that the sMFC can influence the iron and arsenic
   concentration by reducing OM content and the microbial community that
   develop in the bioanode vicinity.},
