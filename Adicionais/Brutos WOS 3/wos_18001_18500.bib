Title = {Set-up of a dynamic in vitro exposure device for the study of
   indoor air pollutant effects on human derived cells},
Booktitle = {ENVIRONMENTAL TOXICOLOGY},
Series = {WIT Transactions on Biomedicine and Health},
Year = {2006},
Volume = {10},
