@inproceedings{ WOS:000406423100030,
Author = {Resiga, Mihaela Cleopatra},
Editor = {Viscu, LI},
Title = {Grief Seen from the Perspective of the Integrative Strategic Model of
   the Self},
Booktitle = {24TH INTERNATIONAL SYMPOSIUM OF RESEARCH AND APPLICATIONS IN PSYCHOLOGY,
   SICAP: COGNITIVE CHARACTERISTICS OF TRANSDISCIPLINARITY. APPLICATIONS IN
   PSYCHOLOGY AND PSYCHOTHERAPIES},
Year = {2017},
Pages = {213-222},
Note = {24th International Symposium on Research and Applications in Psychology
   (SICAP) - Cognitive Characteristics of Transdisciplinarity. Applications
   in Psychology and Psychotherapies, Timisoara, ROMANIA, MAR 24-26, 2017},
Abstract = {The process of coping with the loss of a loved one can take place for a
   long period of time and involves many different emotions, actions and
   expressions, all helping the survivor accept the past and adapt to the
   current situation.
   Starting with the hypothesis that the mourning process can be difficult
   for an individual to process on his own, this paper has the objective of
   describing the stages the individual goes through during this situation,
   and also showing therapeutic rituals linked to specific notions of the
   Integrative Strategic Model of the Self.
   These rituals are designed to help the individual, as a client in
   psychotherapy, to successfully overcome suffering and uncertainty caused
   by the feeling of loneliness, therapeutic aid in the mourning process
   involving specific components, cognitive, emotional, psychodynamic,
   transgenerational, existential or biological.},
