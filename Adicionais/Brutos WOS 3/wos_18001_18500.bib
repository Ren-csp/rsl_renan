Note = {Asia-Pacific Conference on Mind Brain and Education, Washington, DC, OCT
   25-27, 2008},
Organization = {Int Soc Mind, Brain \& Educ; SE Univ, Key Lab Child Dev \& Learning Sci;
   Thinktank - Handsbrain Educ; SE Univ State Key Lab Bioelect; Chinese Soc
   Biomed Elect},
Abstract = {Monoamine oxidase (MAO) plays an important role in the oxidative
   metabolism of neurotransmitters such as 5-hydroxytryptamine and
   dopamine, and has been implicated in the etiology of many emotion
   disorders. Buccal cells provide a convenient source of DNA for many
   researches. We attempted to detect the polymorphism of MaoA promoter by
   using buccal cell DNA: 23 buccal samples were collected in this study
   and 5 blood samples were used for comparison. Results showed high
   quality genomic DNA could be obtained from buccal cells, and it could be
   used in the detection the VNTR of MaoA promoter, the results was
   consistent with it's obtained from peripheral blood samples. It is
   suggested that buccal DNA as a noninvasive material provide a favorable
   platform for the related researches and clinical use.},
