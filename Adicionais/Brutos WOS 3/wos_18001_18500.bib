@inproceedings{ WOS:000165838100022,
Author = {Pessoa-Nogueira, P and Heller, L},
Editor = {Raynal, JA and Nuckols, JR and Reyes, R and Ward, M},
Title = {Respiratory diseases and concentration of pollutants in Betim, Brazil:
   An ecological study},
Booktitle = {ENVIRONMENTAL ENGINEERING AND HEALTH SCIENCES},
Year = {2000},
Pages = {241-252},
Note = {International Symposium on Environmental Engineering and Health
   Sciences: A Joint Effort for the XXIst Century, CHOLULA, MEXICO, OCT
   26-30, 1998},
Organization = {US DHHS, Agcy Tox Subst Dis Registry; NCI, Occupat Epidemiol Brach;
   NIEHS, Superfund Bas Res Program; Pan Amer Hlth Org; Univ Amer Puebla;
   World Meteorol Org},
Abstract = {The objective of the present paper is to verify and to evaluate the
   association between the number of cases of respiratory diseases in an
   urban area and the concentration of air pollutants due to industrial
   sources in the city of Betim, located in the state of Minas Gerais,
   Brazil. An ecological design was used as the epidemiological method. A
   sample of 10\% of the last cases of respiratory diseases in children
   below thirteen years old (1989 to 1992) was adopted as the health
   indicator and exposition was defined as the monthly average of the air
   concentration of the following pollutants: sulphur dioxide (SO2) and
   particulate matter (PM). The influence of meteorological variables, like
   temperature, relative humidity and wind velocity, was also considered.
   The source of secondary data was: the Municipal Health Authority of
   Betim, for the respiratory disease cases; the Environmental Authority of
   the state of Minas Gerais, for the data of pollutant concentration (SO2
   and PM) at three monitoring stations; and the Meteorological Division of
   the Department of Agriculture, for the local atmospheric data. Data were
   statistically analysed using the software-Statistica. Normality tests
   and simple and multiple regression analysis were developed. The most
   important results founded were, in the simple regression analysis, a
   significant association between respiratory diseases and the
   meteorological conditions, as well as respiratory diseases and
   particulate concentrations in the two stations (p < 0.05). in the
   multiple regression analysis, association between respiratory diseases
   and particulate concentration at one station was confirmed. The results
   suggest the existence of high and positive association between
   respiratory diseases in an urban population and particulate
   concentration in an industrial area, corroborating with many other
   studies; and the non-existence of association between low concentrations
   of SO2 and respiratory diseases, also confirming some references by the
   literature.},
