   Glicksohn, Joseph; Leshem, Rotem, Bar Ilan Univ, Dept Criminol, IL-52100 Ramat Gan, Israel.},
ISSN = {0302-9743},
EISSN = {1611-3349},
ISBN = {978-3-642-21477-6},
Keywords = {Time estimation; Time reproduction; Psychophysics; Ratio score; Absolute
   discrepancy; Absolute error},
