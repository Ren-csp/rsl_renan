Title = {Diagnosis in Integrative Strategic Psychotherapy. Case Study},
Booktitle = {24TH INTERNATIONAL SYMPOSIUM OF RESEARCH AND APPLICATIONS IN PSYCHOLOGY,
   SICAP: COGNITIVE CHARACTERISTICS OF TRANSDISCIPLINARITY. APPLICATIONS IN
   PSYCHOLOGY AND PSYCHOTHERAPIES},
Year = {2017},
Pages = {281-286},
Note = {24th International Symposium on Research and Applications in Psychology
   (SICAP) - Cognitive Characteristics of Transdisciplinarity. Applications
   in Psychology and Psychotherapies, Timisoara, ROMANIA, MAR 24-26, 2017},
Abstract = {The objective of this work is to present empirical validation as a
   working instrument of the psychotherapeutic status in case of a teenager
   suffering from schizophrenia. The psychotherapeutic status constitutes
   one of the main tools in integrative strategic psychotherapy based on
   the Strategic Integrative Model of Self.
   As mentioned, the self is composed of four major areas: the basic self
   (proto-self), centre self (core-self) containing the basic sets
   (neuronal maps that govern the person's thinking, emotions and
   behaviour), plastic self comprising the internal causality or the
   maintaining mechanism and external self (outer self). The four domains
   of the self are modelled using biological emotional, cognitive,
   existential, psychodynamic and cultural factors of attachment.
   These are found at the theoretical level in what integrative
   psychotherapy calls ``the six psychological axes{''}: psychodynamic,
   cognitive, existential, transgenerational, biological and emotional.},
