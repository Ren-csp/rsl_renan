@article{ WOS:000073358900005,
Author = {Meyer-Weitz, A and Reddy, P and Weijts, W and van den Borne, B and Kok,
   G},
Title = {The socio-cultural contexts of sexually transmitted diseases in South
   Africa: implications for health education programmes},
Journal = {AIDS CARE-PSYCHOLOGICAL AND SOCIO-MEDICAL ASPECTS OF AIDS/HIV},
Year = {1998},
Volume = {10},
Number = {1},
Pages = {S39-S55},
