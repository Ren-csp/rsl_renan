@inproceedings{ WOS:000078706300058,
Author = {Kaneoke, Y and Bundou, M and Kakigi, R},
Editor = {Hashimoto, I and Kakigi, R},
Title = {Neural correlate of motion perception in the human visual system},
Booktitle = {RECENT ADVANCES IN HUMAN NEUROPHYSIOLOGY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1998},
Volume = {1162},
Pages = {401-407},
Note = {6th International Evoked Potentials Symposium (6th IEPS), OKAZAKI,
   JAPAN, MAR 21-25, 1998},
Organization = {Minist Educ Sci Culture \& Sports Japan; Okazaki Natl Res Inst; Natl
   Inst Physiol Sci; Pharmaceut Manufacturers Assoc Tokyo; Osaka Pharmaceut
   Manufacturers Assoc},
Abstract = {Humans perceive realistic motion of an object when it flashes in one
   place then in another with proper distance and timing. This apparent
   motion is created in the observer's brain because no motion exists in
   the external world. When and where in the brain does this experience
   occur? We show that neural activity in the visual motion area of humans
   determines the timing of this experience. We measured the speeds
   (reaction times) of three observers' responses to stimuli in apparent
   motion using several spatial separations of the objects presented.
   Although the timing of the stimulus presentations were the same, the
   reaction times were inversely related to the degree of separation and
   correlated with the response latencies in the visual motion area as
   measured by magnetoencephalography. Furthermore, differences in the
   latencies between the reaction times and responses in the visual motion
   area were fairly constant (about 64 ms) for each separation and observer
   despite significant differences in both response latencies among the
   observers. Results suggest that neural activity in the visual motion
   area is the neural correlate of the motion perception.},
