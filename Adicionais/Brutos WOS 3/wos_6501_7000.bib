@inproceedings{ WOS:000269715700033,
Author = {Bai, Yun and Wu, Sisi and Zhong, Ping and Lu, Zuhong and Li, Xuesong},
Book-Group-Author = {ISSBD},
Title = {Adult Attachment and the Processing of Attachment-related Emotional
   Information-the Evidence from ERP},
Booktitle = {2009 THE REGIONAL WORKSHOP OF THE INTERNATIONAL SOCIETY FOR THE STUDY OF
   BEHAVIOURAL DEVELOPMENT (ISSBD)},
Year = {2009},
