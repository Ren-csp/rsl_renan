@inproceedings{ WOS:000400302000027,
Author = {Ozohu-Suleiman, Abdulhamid},
Editor = {Pinzaru, F and Bratianu, C},
Title = {Full Disclosure in Governance: A Public Perception Survey of EITI in
   Nigeria},
Booktitle = {PROCEEDINGS OF THE 12TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2016)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2016},
Pages = {214-222},
Note = {12th European Conference on Management, Leadership and Governance
   (ECMLG), Natl Univ Polit Studies \& Publ Adm, Coll Management,
   Bucharest, ROMANIA, NOV 10-11, 2016},
Abstract = {The democratization process and the attendant demands for good
   governance have forced an increasing awareness of the imperative of full
   disclosure on the part of those who manage state resources. The
   consensus arising out of this general awareness is that; transparency
   and accountability are the irreducible requirements that engender social
   inclusion in the application and management of state resources. In
   Nigeria, the harnessing of the vast deposits of oil, gas, and solid
   mineral resources has generated a mixed bag of consequences. Whereas it
   has placed enormous wealth in the hands of a few, it has also visited
   misery and socio-economic deprivations on the lives of majority of
   Nigerian citizens. In an effort to resolve this paradox of affluence and
   affliction, the Nigerian government signed up to the implementation of
   the principles of the global Extractive Industries Transparency
   International (EITI) in the year 2003. This initiative has been hailed
   as the sine qua non for full disclosure, capable of transforming
   economies and improving living standards of the people. In the light of
   this understanding, the paper undertakes a public perception survey of
   the Nigerian Extractive Industries Transparency Initiative (NEITI). The
   survey brings to the court of public opinion a host of questions
   concerning the domestication of this global initiative in terms of
   citizens' perception of its processes, methods and benefits. The
   methodology adopted is survey research involving the use of
   questionnaire to elicit data from sampled population. Findings reveal a
   significant endorsement of NEITI in the drive for a regime of full
   disclosure in the governance of oil, gas and mining sector in Nigeria.
   However, in the perception of the public, the management of payments,
   receipts and application of revenues from extractive industry has not
   significantly addressed the challenges of widespread poverty,
   unemployment and rising income inequality among others. A number of
   recommendations are made amongst which are that: the persistent
   corruption in the oil and gas sector coupled with the Petroleum Industry
   Bill currently before the National Assembly, call for a review of NEITI
   Act in order to reposition and strengthen the agency to realize its
   mandate; and, given the strategic importance of oil and gas to national
   economic transformation, there is urgent need for timely, comprehensive
   and regular implementation of recommendations arising from NEITI Audit
   Reports.},
