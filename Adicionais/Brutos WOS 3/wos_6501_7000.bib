   and Wierenga, Peter and Kuiper, Rob and Abu-Hanna, Ameen},
Editor = {Mantas, J and Andersen, SK and Mazzoleni, MC and Blobel, B and Quaglini, S and Moen, A},
Title = {Relevance of drug-drug Interaction in the ICU - Perceptions of
   Intensivists and Pharmacists},
Booktitle = {QUALITY OF LIFE THROUGH QUALITY OF INFORMATION},
Series = {Studies in Health Technology and Informatics},
