Organization = {Univ New England, Language \& Cognit Res Ctr},
Abstract = {This study seeks to enhance current understanding of cognitive
   capabilities from perception to collaboration by developing an evolution
   inspired framework infrastructure designed to support planning and
   meaningful communication between agents as a means to effective
   collaboration. We have implemented parts of the framework in the robot
   soccer domain where agents interact in a complex and dynamic environment
   to illustrate our approach. The framework is based on a cognitive
   scaffold of cued and detached representations based on conceptual spaces
   that can be used to develop and communicate plans, and pursue shared
   goals. We show how grounded representations can be used to explain agent
   behaviour and to construct agents that can share information about their
   inner world for the purpose of collaboration.},
