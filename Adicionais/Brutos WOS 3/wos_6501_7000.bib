@inproceedings{ WOS:000467247400065,
Author = {Barbera, G. and Chieco, C. and Georgiadis, T. and Motisi, A. and Rossi,
   F.},
Editor = {Pennisi, G and Cremonini, L and Orsini, F and Gianquinto, GP},
Title = {The ``jardinu{''} of Pantelleria as a paradigm of resource-efficient
   horticulture in the built-up environment},
Booktitle = {INTERNATIONAL SYMPOSIUM ON GREENER CITIES FOR MORE EFFICIENT ECOSYSTEM
   SERVICES IN A CLIMATE CHANGING WORLD},
Series = {Acta Horticulturae},
Year = {2018},
