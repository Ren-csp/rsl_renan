Organization = {Hong Kong Soc Transportat Studies; City Univ Hong Kong, Coll Business,
   Dept Management Sci},
Abstract = {The importance of urban form on sustainable development has been
   recognized in recent years. The urban forms in the Macau Peninsula are
   highly compact due to the high population density (38,000
   inhabitants/km(2)) and mixed-use development (i.e., a mixture of
   residential, commercial, industrial, or other land uses in a building or
   set of buildings). Since 1995, a number of research studies have been
   focussed on monitoring traffic-induced air pollution in urban areas of
   Macau. This paper reviews results of the representative monitoring
   studies in the Macau Peninsula, which includes (1) aerodynamic tests for
   wind speed profile on a road; (2) field measurements of vertical
   concentration profiles of particles at roadside; (3) field measurements
   of particle concentrations on leeward/windward sides of the road; (4)
   spatial distributions of polycyclic aromatic hydrocarbons (PAHs) in
   dustfall.},
