@inproceedings{ WOS:001286437900015,
Author = {Leung, Grace Y. S. and Ng, Adrian K. T. and Lau, Henry Y. K.},
Editor = {Li, WC and Harris, D},
Title = {Effect of Height Perception on State Self-Esteem and Cognitive
   Performance in Virtual Reality},
