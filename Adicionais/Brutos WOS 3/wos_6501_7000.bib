@article{ WOS:A1995TG27200002,
Author = {SAUGY, B and HADORN, JC and HERSCH, RD and GRAF, O and GROUX, R},
Title = {GIGAVIEW(TM) AND HYPERMAPS FOR FINITE-ELEMENTS BASED URBAN NETWORKS AND
   SYSTEM MANAGERS},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {1995},
Volume = {19},
Number = {3},
Pages = {151-160},
Month = {MAY-JUN},
Note = {17th Urban Data Management Symposium (UDMS 94), HELSINKI ESPOO, FINLAND,
   SEP 04-08, 1994},
Abstract = {This paper describes the original integration of three concepts (finite
   elements, geoparametric transformations, and Hyper Maps) and their
   application to the management of the water network in the region of
   Lausanne, Switzerland
   The finite element method lets us simulate network flows and two or
   three dimensional fields. Using this simulation method, propagation of a
   pollutant or chlorine concentration can be followed through the network.
   The transient flow can be stored in Quick Time format for later replay,
   making it a very user friendly analysis tool The finite element method
   also provides for the capability to project both network and simulation
   data (ie. chemical concentration or individual consumption) onto aerial
   pictures or maps.
   The projection method is geoparametric transformation where the
   discretised fields do not represent pressure, temperature or chemical
   concentration anymore, but the geographical coordinates of any
   coordinates system. The geoparametric transformation produces a raster
   image where each pixel is associated with an object identifier. These
   pictures are called Hyper Maps. Clicking an object will display a full
   object description or a Quick Time movie of the local pressure or
   chemical concentration in a network.
   Hyper Maps can be very large (hundreds of GB). To process very large
   graphical data, the Swiss Federal Institute of Technology together with
   BSI developed a multiprocessor-multidisk image server named
   GigaView(TM). The GigaView(TM) is an intelligent disk array for desk top
   systems and workstations. It includes transputers (intelligent parallel
   processors) connected to each disk node, and supports local image
   processing such as zooming and rotation
   The Hyper Bird(R) application running on a Macintosh platform and a
   GigaView(TM) connected through a SCSI bus demonstrate the feasibility of
   this approach.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD, ENGLAND OX5 1GB},
