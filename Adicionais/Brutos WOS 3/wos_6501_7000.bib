Title = {Stochastic vehicle routing and scheduling using a heuristic approach},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {311-320},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {This paper presents a stochastic vehicle routing and scheduling model
   with time window (VRP-TW). The model explicitly incorporates the
   variable travel times on urban roads. It adopts a simulated annealing
   heuristic approach to approximately identify the optimal assignment and
   visiting order to customers of vehicles. The application of the model to
   a test network showed that freight carriers can generate the cost
   reduction by implementing the stochastic VRP-TW model compared with the
   forecast VRP-TW model. The distance travelled by trucks also decreased
   and the load factor increased using the model, which would lead to
   improve the traffic environment in urban areas. When the average travel
   speed went down from the benchmark case of 30 km/h, the cost reduction
   rate by implementing the stochastic VRP-TW grew up to 19\% at peak.},
