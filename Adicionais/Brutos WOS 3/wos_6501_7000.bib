@article{ WOS:000221637400028,
Author = {Mekotová, J and Sarapatka, B and Sterba, O},
Title = {Potential incorporation of the Morava River into the urban ecosystem of
   Olomouc, The Czech Republic},
Journal = {EKOLOGIA-BRATISLAVA},
Year = {2003},
Volume = {22},
Number = {2},
Pages = {301-308},
Note = {Scientific Conference on New Trends in Landscape Ecology, Piestany,
   SLOVAKIA, OCT 24-26, 2002},
Organization = {Int Assoc Landscape Ecol},
Abstract = {Urban-ecological study belongs to a complex of solutions to flood
   protection issues affecting urban areas in the Czech Republic. These
   solutions are largely a response to the destructive summer floods of
   1997 and 2001. This presentation focuses on the Morava river in Olomouc
   (Czech Republic, Central. Moravia). The study's ecological component
   concentrates on the construction of the river's ecological continuum
   throughout an urban area being situated in the river's flood-plain,
   providing legitimacy to the principle requirement of inhabitant's flood
   protection. This idea is exercised partly on the river channel
   (lengthwise river continuum), partly on shore, in the corridor of the
   newly built inundation area. Restorations arise from the river's channel
   onto the alluvium, thereby the transverse and upright ecological
   continuum is renovated. Restorations rely on extant ecological
   structural elements and relationships and they pay attention to the
   concept of preservation and the next re-enforcement of ecological
   structure, including ecological relationships. In this way, the
   principles of renewal of the river landscape's ecological continuum are
   exerted. The goal is to arrive at that point where the inhabitants
   perceive the river as a positive natural element in the urban ecosystem
   while providing for the free movement of wildlife.},
