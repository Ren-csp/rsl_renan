Booktitle = {2019 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENT (CIEM)},
Year = {2019},
Pages = {133-137},
Note = {9th International Conference on Energy and Environment (CIEM),
   Politehnica Univ Timisoara, Timisoara, ROMANIA, OCT 17-18, 2019},
Organization = {IEEE Power \& Energy Soc; World Energy Council, Comitetul Natl Roman;
   Honeywell; Elster; Continental; Engie; Opt SWD},
Abstract = {The present paper aims to establish a link between responsive
   architecture elements, living green surfaces and the possibilities
   offered by digital parametric design tools in order to create an
   architectural installation in the public space capable of enhancing the
   quality of the public transport users' experience. The research focuses
   on the development of the MODGREW (MODularGREenWall) prototype within
   public transport stations that will incorporate responsive architecture
   elements by using automation systems enabled by humidity, motion and
   light sensors. The estimated benefits of the MODGREW prototype are:
   increased attractiveness of the use of public transport and a perception
   shift from a strictly utilitarian urban facility to a common good in
   urban space. The MODGREW system can be part of a set of interventions in
   the urban space that participate in the sustainable development strategy
   of Timisoara by increasing the quality of the users' interaction with
   the public space.},
