@article{ WOS:000487572400004,
Author = {Kim, Hyeonjun and Jang, Cheol-hee},
Title = {Reprint of ``A review on ancient urban stream management for flood
   mitigation in the capital of the Joseon Dynasty, Korea{''}},
Journal = {JOURNAL OF HYDRO-ENVIRONMENT RESEARCH},
