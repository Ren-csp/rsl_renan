@inproceedings{ WOS:000270892200028,
Author = {Brini, S. and Moricci, F. and Cirillo, M. C.},
Editor = {Ranzi, E},
Title = {Simultaneous Exceedances Of Short-Term Limit Values For Pm10,
   No2 And O3 In Italian Urban Areas},
Booktitle = {AAAS08: 2ND ADVANCED ATMOSPHERIC AEROSOL SYMPOSIUM},
Series = {Chemical Engineering Transactions},
Year = {2008},
Volume = {16},
Pages = {209-216},
Note = {2nd Advanced Atomspheric Aerosol Symposium (AAAS08), Naples, ITALY, SEP
   09-12, 2008},
Organization = {Italian Assoc Chem Engn; Politecnico; UNI Versita degu StudDi; NA
   POLIFEDERICO II},
Abstract = {PM10, NO(2) and O(3) are critical air pollutants whose limit values set
   up by legislation for the protection of human health are often exceeded
   in many Italian zones.
   Since these pollutants are partially or totally secondary, the links
   between emissions and air concentrations are non-linear, which makes it
   troublesome to implement effective measures to reduce atmospheric
   concentrations.
   Current legislation considers air quality standards for health
   protection separately for each one of these pollutants. However, recent
   studies stress the importance of the exposure to multi-pollutant
   mixtures (Various Authors, 2002)and association among the different air
   pollutants. Moreover, concurrent exceedances must be approached by an
   integrated set of measures that assures the reduction of concentration
   levels for all the exceeding pollutants.
   This paper illustrates the concurrent short-term exceedances of PM10,
   NO(2) and O(3), and of couples of these pollutants (i.e. simultaneous
   exceedances of. PM10 and NO(2); PM10 and O(3), NO(2) and O(3)),
   highlighting periods of the year and areas where such simultaneous
   exceedances occur. The data analysed are those used for the European
   exchange of information and are contained in APAT air quality data base;
   they refer to the major 24 urban agglomerations and span from 2002 to
   2006.
   The information presented can be useful for the analysis of determinants
   and sources of exposures to multi-pollutant mixtures (Hanninen et al.,
   2004) and may help in developing effective policies and control
   strategies for a healthier environment.},
