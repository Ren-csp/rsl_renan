Title = {Discussion on the analysis method of urban design rainstorm under the
   ``new normal{''} of ``city seeing the sea{''}},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT (WRE
   2019)},
