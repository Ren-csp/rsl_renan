@article{ WOS:000230187000007,
Author = {Singer, M},
Title = {A twice-told tale: A phenomenological inquiry into clients' perceptions
   of therapy},
Journal = {JOURNAL OF MARITAL AND FAMILY THERAPY},
Year = {2005},
Volume = {31},
Number = {3},
Pages = {269-282},
Month = {JUL},
Note = {15th Annual Ethnographic and Qualitative Research in Education
   Conference, Duquesne Univ, Pittsburgh, PA, JUN, 2003},
Abstract = {Typically, what we understand about therapy and the families we work
   with comes from the therapist's observations. This inquiry evolved out
   of the empirical data that indicate the dramatic importance of the
   client's perceptions to achieving a successful outcome. The research was
   guided by the understanding that it is vitally important for therapists
   and therapy researchers to listen to clients and to examine our
   practices and theoretical approaches in the light of the client's
   experience of them. This study is a phenomenological inquiry into the
   client's experience of therapy.},
