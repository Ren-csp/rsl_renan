@article{ WOS:000399358300046,
Author = {Suki, Norazah Mohd and Suki, Norbayah Mohd and Mokhtar, Ainnur Hafizah
   Anuar},
Title = {Students' Perception of Usage of Role-Play Games in a Class for Japanese
   Language Proficiency},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {12, SI},
Pages = {4171-4175},
Month = {DEC},
Note = {Advancement on Informatics, Business and Management International
   Conference (AIBMIC), Bandung, INDONESIA, MAY 31-JUN 02, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {This study examined students' perception of usage of role-play games in
   a class for Japanese language proficiency. The subjects were 200
   students in a public university in Sabah, Malaysia chosen via a
   structured self-administered questionnaire encompassing closed-ended
   questions. Based on the descriptive statistics via the Statistical
   Package for the Social Sciences (SPSS), the results revealed that most
   of the respondents had a positive perception and behaviour towards use
   of role-play games in a class for Japanese language proficiency. About
   70 percent of students' in general agreed that they intended to use
   role-play games in class to improve Japanese language learning
   proficiency as much as possible. A significant number of students
   asserted positive intentions to use role-play games in class to improve
   Japanese language learning proficiency. Indeed, close to two-thirds of
   the students would recommend their friends and relatives to use
   role-play games in class to improve Japanese language learning
   proficiency. There was a significant proportion of students who used the
   role-play games in class to improve Japanese language learning
   proficiency. The research makes a significant contribution to a better
   understanding of the students' perception of usage of role-play games in
   a class for Japanese language proficiency, which is marginally touched
   on in the literature in the Malaysian context. Direction for future
   research is also presented.},
