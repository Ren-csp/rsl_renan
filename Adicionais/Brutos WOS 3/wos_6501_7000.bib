   and Cazzullo, CL},
Title = {Expressed emotion and Milan systemic intervention: a pilot study on
   families of people with a diagnosis of schizophrenia},
Journal = {JOURNAL OF FAMILY THERAPY},
Year = {2006},
Volume = {28},
Number = {1},
