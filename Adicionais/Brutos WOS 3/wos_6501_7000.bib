   system},
Booktitle = {LIDAR REMOTE SENSING FOR INDUSTRY AND ENVIRONMENT MONITORING III},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
