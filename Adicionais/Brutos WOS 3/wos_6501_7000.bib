Title = {PROFESSOR'S PERCEPTION ON THE EFFECTIVENESS OF THE COMPETENCES APPROACH
   IN A CLASSROOM},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON INTERCULTURAL EDUCATION AND
   INTERNATIONAL CONFERENCE ON TRANSCULTURAL HEALTH: THE VALUE OF EDUCATION
   AND HEALTH FOR A GLOBAL, TRANSCULTURAL WORLD (EDUHEM 2018)},
