Title = {Enhancing Urban Resilience: The Impact of Tree Planting on Stormwater
   Management and Heat Island Reduction in Baltimore},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2025: COOL SOLUTIONS TO
   HOT TOPICS},
Year = {2025},
Pages = {696-704},
Note = {2025 World Environmental and Water Resources Congress, Anchorage, AK,
   MAY 18-21, 2025},
Abstract = {Urban tree planting serves as a strategy for improving environmental
   resilience. This research explores the dual integration and benefits of
   tree planting into stormwater management systems and as a strategy to
   mitigate the urban heat island effect. It evaluates the performance of
   existing stormwater management practices and analyzes the co-benefits of
   tree canopy coverage in enhancing these systems. It utilizes existing
   literature and various tree-planting scenarios modeled at Broadway East
   Baltimore. The analysis reveals that increasing tree canopy coverage
   significantly improves stormwater management by enhancing infiltration,
   reducing surface runoff, and mitigating flood risks. Additionally, the
   presence of trees helps improve air quality, offering critical cooling
   benefits and contributing to overall public health. The results
   underscore the dual advantages of incorporating green infrastructure
   into urban planning, demonstrating that tree planting addresses
   stormwater challenges and enhances climate resilience and
   sustainability. This research provides valuable insights for
   policymakers and urban planners aiming to integrate nature-based
   solutions into climate adaptation strategies using the ecological,
   social, and economic importance of urban tree planting in addressing
   climate challenges.},
