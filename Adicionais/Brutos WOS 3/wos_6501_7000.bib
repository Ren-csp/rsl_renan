   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {105-114},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {The Mexico City Sistema de Transporte Colectivo Metropolitano, Metro,
   moves nearly 3 million people daily, and most users commute from subway
   stations to their final destination, which is school or work. The second
   mode of transportation is typically the so-called ``microbus{''}. The
   microbus was designed for short trips and has a capacity of about 20
   passengers. However, at peak hours a microbus can transport over 40
   people. We used 3M and MSP personal monitors to continuously monitor
   drivers of the microbuses. The exposure of the drivers to PM25, PM10 and
   VOC for a week during 12-hour periods was measured. These results will
   be used for parallel studies of genetic damage, looking for correlation
   between personal exposure and peoples' health.},
