Title = {On The Nature of Misidentification With Privacy Preserving Algorithms},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL CONFERENCE ON PERVASIVE
   TECHNOLOGIES RELATED TO ASSISTIVE ENVIRONMENTS, PETRA 2022},
Year = {2022},
Pages = {422-424},
Note = {15th ACM International Conference on Pervasive Technologies Related to
   Assistive Environments (PETRA), GREECE, JUN 29-JUL 01, 2022},
Organization = {Assoc Comp Machinery},
Abstract = {The ubiquitous use of computer vision and camera surveillance makes it
   increasingly easy to automatically recognize persons in visuals. In this
   context, obfuscation methods like blurring and pixelation can impart
   privacy by preventing facial recognition. But even in cases where these
   techniques successfully obscure the subject's identity, the question of
   who is recognized in their stead and what influences this
   misidentification is still open. As facial recognition is an area which
   is particularly prone to demographic bias, we analyse misidentifications
   along the lines of race and gender. We show that persons are most often
   mistaken for someone of their own gender. However, in terms of racial
   bias, white people tend to be under-represented among the
   misidentifications.},
