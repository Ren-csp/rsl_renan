Title = {CRITERIA FOR EXPLOITATION OF WATER RESOURCES: PLANNING AND MANAGEMENT OF
   IRRIGATION SYSTEMS WITH HIGH EFFICIENCY FOR THE GREEN CITY OF MILAN},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT XI},
Series = {WIT Transactions on Ecology and the Environment},
