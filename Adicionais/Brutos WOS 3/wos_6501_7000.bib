@article{ WOS:000082588900014,
Author = {von Mackensen, S and Bullinger, M and Morfeld, M},
Title = {The Sick Building Syndrome as a subjective perception-theoretical
   approach and assessment methods},
Journal = {ZENTRALBLATT FUR HYGIENE UND UMWELTMEDIZIN},
