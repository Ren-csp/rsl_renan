   and Elswick, Betsy L. Meredith},
Title = {Medication therapy management services in West Virginia: Pharmacists'
   perceptions of educational and training needs},
Journal = {RESEARCH IN SOCIAL \& ADMINISTRATIVE PHARMACY},
Year = {2009},
