@inproceedings{ WOS:000464997800039,
Author = {Liu, Yanfei and Tian, Zhiqiang and Liu, Yuzhou and Li, Jusong and Fu,
   Feng},
Editor = {Ayaz, H and Mazur, L},
Title = {Cognitive Architecture Based Simulation of Perception and Behavior
   Controls for Robot},
Booktitle = {ADVANCES IN NEUROERGONOMICS AND COGNITIVE ENGINEERING},
