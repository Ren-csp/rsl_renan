@inproceedings{ WOS:000083105000175,
Author = {Jones, JM and Vijayasarathy, LR},
Book-Group-Author = {DECIS SCI INST
   DECIS SCI INST},
Title = {Preliminary results from an experiment on perceptions of internet
   catalog shopping and traditional catalog shopping},
Booktitle = {DECISION SCIENCES INSTITUTE 1998 PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {418-419},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {The authors give an overview of an experiment on individuals'
   perceptions of Internet-catalog shopping and more traditional
   print-catalog shopping. This experiment is part of an ongoing series of
   studies that examine catalog shopping via the Internet. The present
   study explores individuals' feelings about Internet- and print-catalog
   shopping), and it examines perceived influence of important other
   people. Preliminary results reveal that individuals enjoy the
   convenience of viewing and comparing products on their computer screens,
   however they have serious misgivings about ordering products and giving
   out credit card numbers over the Internet. The findings also indicate
   that the younger individuals in the present study hold similar opinions
   as ``important other people{''} regarding traditional print-catalog
   shopping, however they have more favorable perceptions towards Internet
   catalog shopping than important others.},
