Title = {Sustainability concern of housing: emergy storage and flow assessment},
Booktitle = {MANAGEMENT OF NATURAL RESOURCES, SUSTAINABLE DEVELOPMENT AND ECOLOGICAL
   HAZARDS},
Series = {WIT Transactions on Ecology and the Environment},
