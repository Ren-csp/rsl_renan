@inproceedings{ WOS:000449172400007,
Author = {Hardie, Rae-Anne and Baysari, Melissa T. and Lake, Rebecca and
   Richardson, Lauren and Mccullagh, Cheryl and Westbrook, I, Johanna},
Editor = {Ryan, A and Schaper, LK and Whetton, S},
Title = {User Perceptions of the Implementation of an Electronic Medication
   Management System in a Paediatric Setting},
Booktitle = {INTEGRATING AND CONNECTING CARE},
Series = {Studies in Health Technology and Informatics},
Year = {2017},
Volume = {239},
Pages = {41-47},
Note = {25th Australian National Health Informatics Conference (HIC), Brisbane,
   AUSTRALIA, AUG 06-09, 2017},
Abstract = {The roll-out of a hospital-wide electronic medication management system
   (eMMS) is a challenging task, requiring planning, coordination,
   communication and change management. This research aimed to explore the
   views of doctors and nurses about the strategy used to implement an eMM
   system in a paediatric hospital. Semi-structured interviews were
   performed during the first week of the implementation on each ward, and
   were then followed up three and six weeks post implementation. In total,
   90 users (60 nurses and 30 doctors) were asked about their impressions
   of the implementation, as well as their perceptions of training and IT
   support. Qualitative thematic analysis was performed by three
   researchers. Most users perceived the implementation of the eMM to be
   positive overall. Although perceptions of the implementation process
   remained largely consistent across the six weeks, users identified
   several areas where improvements were needed, especially early in
   implementation, including resources, planning, roll-out strategy and
   training. These findings are useful for future implementations of eMM
   systems in paediatric hospitals.},
