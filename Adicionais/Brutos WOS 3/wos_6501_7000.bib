@article{ WOS:000165108000059,
Author = {Mensink, C and de Ridder, K},
Title = {Satellite-based estimation of atmospheric stability parameters in urban
   and remote areas},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2000},
