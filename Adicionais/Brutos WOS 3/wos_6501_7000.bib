@inproceedings{ WOS:000274546400003,
Author = {Callender, J.},
Editor = {Brebbia, CA and Neophytou, M and Beriatos, E and Ioannou, I and Kungolos, AG},
Title = {Sustainability versus urbanism: a fear-formed impasse},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IV, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2009},
Volume = {120},
Pages = {25-32},
Note = {4th International Conference on Sustainable Development and Planning,
   CYPRUS, MAY 13-15, 2009},
Organization = {Wexxex Inst Technol; Univ Cyprus; Univ Thessaly},
Abstract = {The current interest in sustainability has created difficulties for
   those attempting to rethink issues of urban form. Most challenging is
   the lack of consensus on what is meant by a sustainable city. At first
   glance, this lack of consensus could be pinned on our inability to
   define sustainability or to clarify the motives that have spawned its
   remarkable rise. We intend to argue, however, that it is not a failure
   of lexicon, but the fact that implicit definitions of, and
   seldom-articulated motives for, sustainability are contrary to our
   notions of urban life.
   When addressing sustainable issues, international design journals
   frequently highlight single-family, detached housing using advanced
   technologies, recycled and recyclable materials, and passive strategies
   as models. In America, LEED checklists and the annual Solar Decathlon
   reinforce this nascent impression that sustainability is first and
   foremost a matter of technological advance, which does not necessitate a
   corresponding rethinking of land use, density or urban form. Even when
   second and third looks reveal the deeper importance of land use planning
   and life cycle analysis, seldom is perception of form broached. The
   experiential appears outmoded in the face of such dire concerns.
   This paper will relocate perceptual concerns to the forefront of
   developing a sustainable city in two ways. Firstly, utilizing frameworks
   provided by Henri Lefebvre and Doreen Massey, we will argue the primacy
   of the city in fostering sustainable ways of life through proper land
   use, density, and consolidation of resources. Secondly, turning to
   Hegel, Merleau-Ponty, and Judith Butler, I will argue that the creation
   of a phenomenal city - a city rooted in the bodily experience of desire
   - is the necessary trigger to spur human migration to technologically
   sustainable cities.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Callender, J., Mississippi State Univ, Sch Architecture, Mississippi State, MS USA.},
DOI = {10.2495/SDP090031},
ISSN = {1743-3541},
ISBN = {978-1-84564-181-8},
