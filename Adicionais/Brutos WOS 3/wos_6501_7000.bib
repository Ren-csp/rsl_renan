Volume = {57},
Number = {3},
Pages = {523-539},
Month = {FAL},
Note = {Conference on Immigrants and Immigration, TORONTO, CANADA, AUG 12-15,
   1999},
Organization = {Soc Psychol Study Social Issues},
Abstract = {The Housing New Canadians project investigated recent immigrants'
   perceptions of discrimination in finding rental housing since arriving
   in Toronto, Canada. Respondents from three immigrant
   communities-Jamaicans, Poles, and Somalis-indicated how much housing
   discrimination they had personally, experienced and how much
   discrimination they perceived to have been directed toward their group.
   They also rated how much each of several factors, including race, income
   level, source of income, immigrant status, language, ethnic or national
   background, religion, and family size, contributed to each type of
   perceived discrimination. Jamaican and Somali immigrants perceived
   greater personal and group discrimination and also showed a greater
   discrepancy between personal and group discrimination than did Polish
   immigrants. Implications are discussed.},
