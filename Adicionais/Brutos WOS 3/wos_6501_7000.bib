@article{ WOS:A1993KJ33300006,
Author = {SMALL, SA and SILVERBERG, SB and KERNS, D},
Title = {ADOLESCENTS PERCEPTIONS OF THE COSTS AND BENEFITS OF ENGAGING IN
   HEALTH-COMPROMISING BEHAVIORS},
Journal = {JOURNAL OF YOUTH AND ADOLESCENCE},
Year = {1993},
Volume = {22},
Number = {1},
