@inproceedings{ WOS:000313637300159,
Author = {Cheung, James O. P. and Liu, Chun-Ho},
Editor = {Teng, JG},
Title = {LARGE-EDDY SIMULATION OF CROSS-VENTILATION IN ROWS OF HYPOTHETICAL
   BUILDINGS},
Booktitle = {PROCEEDINGS OF THE FIRST INTERNATIONAL CONFERENCE ON SUSTAINABLE
   URBANIZATION (ICSU 2010)},
Year = {2010},
Pages = {1275-1284},
Note = {1st International Conference on Sustainable Urbanization (ICSU), Hong
   Kong, PEOPLES R CHINA, DEC 15-17, 2010},
Organization = {Hong Kong Polytechn Univ, Fac Construct \& Land Use; Inst Urban
   Environm; Road King Infrastructure Ltd; Sun Hung Kai Properties; Chun Wo
   Dev Holdings Ltd; K C Wong Educ Fdn; Environm \& Conservat Fund; Gammon;
   Paul Y; Architecture Design \& Res Grp Ltd (AD+RG); China State
   Construct (CSCEC); Sino Grp; Vantage Int (Holdings) Ltd; ASCE Hong Kong
   Sect; ASHRAE Hong Kong Chapter; CIBSE; Construct Ind Council (CIC);
   Chartered Inst Bldg (CIOB); Council Sustainable Dev; Emerald; Hong Kong
   Inst Architects; Hong Kong Institut Engineers; Hong Kong Inst Surveyors;
   HKSTS; IUE; JSCE; RICS; Urban Planning Soc China; China Civil Engn Soc},
Abstract = {This paper attempts to reveal the ventilation behaviour in urban
   geometry of different building spacing. The cross-ventilated flow
   through a few rows of low-rise hypothetical buildings was investigated
   by computational fluid dynamics (CFD). Large-eddy simulations (LES) were
   performed with the one-equation subgrid-scale (SGS) model for the
   turbulent kinetic energy. Three evenly separated two-dimensional (2D)
   hypothetical buildings were aligned in the streamwise direction
   constructing the computational domain. The lower halves of the windward
   and leeward facades were opened for cross-ventilation. A pressure
   gradient term was used to drive the prevalent flow in the streamwise
   direction. Inflow and outflow boundaries were assigned periodic boundary
   conditions. The sensitivity of the ventilation pattern in and around the
   buildings to the building separation was examined. When the building
   separation was small, a reversed flow dominated near the ground and
   within the building envelope. Fresh air entrainment was significantly
   suppressed. Changes in the flow pattern, such as the positions, the
   sizes and the intensities of the recirculations, were observed with
   increasing separation. When the separation approached 1.5 time of the
   building height, the flow pattern gradually changed. The mean
   ventilation flux across the building envelope dropped to almost zero
   while the turbulent flux dominated the ventilation of the indoor space.
   The importance of turbulence was reduced considerably at wider
   separations thereafter.},
