Title = {Potato cultivation on the west slope of Mount Slamet: millennial farmers
   perceptions and intentions for conservation-based farming},
Booktitle = {INTERNATIONAL CONFERENCE ON ENVIRONMENTAL MANAGEMENT 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
