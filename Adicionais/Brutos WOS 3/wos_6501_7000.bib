@inproceedings{ WOS:000237753600067,
Author = {Gasparatos, D. and Haidouti, C. and Adrinopoulos, F. and Areta, O.},
Editor = {Lekkas, TD},
Title = {Chemical speciation and bioavailability of Cu, Zn and Pb in soils from
   the national garden of Athens, Greece},
Booktitle = {Proceedings of the 9th International Conference on Environmental Science
   and Technology, Vol A - Oral Presentations, Pts A and B},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {A438-A444},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {Urban soils as important pollutant sinks often contain high
   concentrations of heavy metals. Although total analysis is a good
   indicator of the possible enrichment of the soil with heavy metals, the
   mobilization capacity and the potential environmental risk of these
   pollutants depends primary on their speciation in the soil rather than
   the total concentration. Twenty five surface soil samples from the
   National Garden, one of the major parks in the Athens center, were
   analyzed to investigate the speciation and the bioavailability of Cu, Zn
   and Pb. For each of these samples, the association of metals was
   determined in five fractions: exchangeable, bound to carbonates, bound
   to Fe-Mn oxides, bound to organic matter and residual.
   The results of this sequential extraction show that Zn and Pb were
   dominated by the residual and Fe-Mn oxides bound fraction whereas Cu by
   the residual and organic matter bound fraction. On average, the order of
   Cu in each fraction was residual (44.2\%) > organic (30.4\%) > Fe-Mn
   oxides (15.9\%) > carbonate (4.8\%) > exchangeable (4.7\%), the amount
   of Zn in each fraction followed the order Fe-Mn oxides (51.3 \%) >
   residual (40\%) > carbonate (4.5\%) > organic (3.4 \%) > exchangeable
   (0.8\%) and Pb in each fraction was Fe-Mn oxides (66.3\%) > residual
   (24.7\%) > exchangeable (4.1\%) > carbonate (2.5\%) does not satisfy
   organic (2.4\%). These data showed that in all cases the percentage of
   the residual fraction, which represents stable metal forms mainly bound
   to primary and secondary minerals, resistant to changes under conditions
   normally encountered in nature, is lower to 45\% suggesting the great
   mobility of the Cu, Zn and Pd in the studied urban soils.
   The bioavailable forms of the studied metals were determined according
   to the percentage extracted in the non-residual fractions. The
   exchangeable fraction is considered to be easily available for plant
   uptake, the carbonate fraction is susceptible to pH changes, the Fe-Mn
   oxide fraction is unstable under low Eh conditions and the organic
   fraction could be degraded under oxidizing conditions; therefore all
   these fractions must be considered as the active forms of heavy metals.
   The non-residual fractions of Cu, Zn and Pb in the studied urban soils
   average 55.8\%, 60\% and 75.3\%, respectively, which suggests that the
   mobility and bioavailability of the metals probably decrease in the
   order Pb > Zn > Cu. The application of this sequential extraction scheme
   to asses the chemical forms of Cu, Zn and Pb in the urban soils of
   National Garden of Athens demonstrates that these elements are mainly
   bound to potentially mobile forms in the soil and therefore the
   associated environmental hazards must be taken into consideration.},
