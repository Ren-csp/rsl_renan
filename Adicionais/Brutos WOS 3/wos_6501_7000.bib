@inproceedings{ WOS:001487088900127,
Author = {Adjei, Frederick and Cimador, Tanja and Severengiz, Semih},
Editor = {Dewulf, W and Duflou, J},
Title = {Electrically powered micro mobility vehicles in Ghana: transition
   process with a focus on social acceptance},
Booktitle = {29TH CIRP CONFERENCE ON LIFE CYCLE ENGINEERING, LCE 2022},
Series = {Procedia CIRP},
Year = {2022},
Volume = {105},
Pages = {764-769},
Note = {29th Conference on Life Cycle Engineering-LCE, Leuven, BELGIUM, APR
   04-06, 2022},
Organization = {Center for Injury Research and Policy (CIRP)},
Abstract = {Transportation plays a crucial role in the socio-economic development of
   a country. This paper seeks to investigate the modes of transportation
   available to people in Ghana and provide further insights. Attention is
   on the use of conventional motorbikes and the potential use of
   electrically powered mobility vehicles in a sharing environment. The
   implications being relevant to the achievement of emissions reduction
   goals of Ghana with contributions to the UN Sustainable Development
   Goals.
   The methodology used by the authors was the deployment and analysis of a
   survey questionnaire which focuses on social acceptance based on a mixed
   approach of quantitative data collection and qualitative interviews. The
   methodology is consistent with triangular approached to social
   acceptance being acceptance subject, acceptance object and acceptance
   contexts. It also incorporates the tenets of methods suited to
   Technology Acceptance Models (TAM). To investigate the transportation
   patterns and societal values, a survey questionnaire was developed with
   demographic, social, technical, economic, and ecological question
   sections. The survey had 1.604 participants from different cities and
   regions of Ghana representing urban and rural use cases.
   Factors such as safety, acquisition cost, environmental sustainability,
   and others are shown to be significant in influencing the social
   acceptance of e-mobility devices. Factors such as price, time savings,
   variety of mobility devices and others were indicated to affect the
   potential usage of sharing systems. The survey revealed that the demand
   for electrically powered motorbikes would be high with majority of
   participants using a conventional motorbike regularly. Respondents
   indicated that they would be willing to use an electrically powered
   motorbike with majoring indicating that they dispose their
   non-functioning mobility vehicles in a workshop and that they make
   environmental considerations in the purchase of mobility vehicles. (c)
   2022 The Authors. Published by Elsevier B.V.},
