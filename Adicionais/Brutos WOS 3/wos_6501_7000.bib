@article{ WOS:000240251900005,
Author = {Regner, Isabelle and Rywick, Thomas},
Title = {Left- and right-wing perceptions of presidential candidates::
   Similarities and differences between French and American voters},
Journal = {REVUE INTERNATIONALE DE PSYCHOLOGIE SOCIALE-INTERNATIONAL REVIEW OF
   SOCIAL PSYCHOLOGY},
Year = {2006},
Volume = {19},
Number = {2},
