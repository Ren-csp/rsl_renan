Note = {International Conference on Environmental Protection and Human Health
   (EPHH), Wuhan, PEOPLES R CHINA, DEC 13-14, 2014},
Abstract = {The urban atmospheric pollution is increasingly serious in recent years.
   Spring Festivals one of the Chinese people over thousand years
   tradition. Lots of firecrackers will been set off during Spring
   Festival, which will release a large amount of carbon monoxide. By using
   real-time monitoring of Shijiazhuang national monitoring data and the
   means of GIS spatial analysis, there shows the fireworks causing the
   serious air pollution. After 0:00 on the New Year, only after a three
   hours of setting off fire crackers, AQI value of Shijiazhuang was at a
   higher level. Decreased with the night, with less fireworks, AQI value
   of Shijiazhuang had dissipating from the west to the east.},
