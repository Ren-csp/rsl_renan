@inproceedings{ WOS:000306295900017,
Author = {Merchant, Hugo and Bartolo, Ramon and Carlos Mendez, Juan and Perez,
   Oswaldo and Zarco, Wilbert and Mendoza, German},
Editor = {Vatakis, A and Esposito, A and Giagkou, M and Cummins, F and Papadelis, G},
Title = {What Can Be Inferred from Multiple-task Psychophysical Studies about the
   Mechanisms for Temporal Processing?},
Booktitle = {MULTIDISCIPLINARY ASPECTS OF TIME AND TIME PERCEPTION},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2011},
Volume = {6789},
Pages = {207-229},
Note = {COST TD0904 International Workshop on Multidisciplinary Aspects of Time
   and Time Perception, Athens, GREECE, OCT 07-08, 2010},
Organization = {European Cooperat Sci \& Technol Action TD0904; Natl Techn Univ Athens,
   Sch Architecture; Inst Language \& Speech Proc},
Abstract = {We used different tools from experimental psychology to obtain a broad
   picture of the possible neural underpinnings of temporal processing in
   the range of milliseconds. The temporal variability of human subjects
   was measured in timing tasks that differed in terms of:
   explicit-implicit timing, perception-production, single-multiple
   intervals, and auditory-visual interval markers. The results showed a
   dissociation between implicit and explicit timing. Inside explicit
   timing, we found a complex interaction in the temporal variability
   between tasks. These findings do not support neither a unique nor a
   ubiquitous mechanism for explicit timing, but support the notion of a
   partially distributed timing mechanism, integrated by main core
   structures such as the corticothalamic-basal ganglia circuit, and areas
   that are selectively engaged depending on the specific behavioral
   requirement of a task. A learning-generalization study of motor timing
   also supports this hypothesis and suggests that neurons of the timing
   circuit should be tuned to interval durations.},
