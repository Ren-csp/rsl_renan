@article{ WOS:000084770100010,
Author = {Thorsteinson, TJ and Balzer, WK},
Title = {Effects of coworker information on perceptions and ratings of
   performance},
Journal = {JOURNAL OF ORGANIZATIONAL BEHAVIOR},
Year = {1999},
