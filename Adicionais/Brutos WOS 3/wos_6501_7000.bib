Title = {Model of Environmental Communication with Gender Perspective in
   Resolving Environmental Conflict in Urban Area (Study on the Role of
   Women's Activist in Sustainable Environmental Conflict
   Management)},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON SUSTAINABLE FUTURE FOR HUMAN SECURITY
   SUSTAIN 2013},
