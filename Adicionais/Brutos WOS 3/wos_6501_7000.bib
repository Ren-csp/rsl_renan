@inproceedings{ WOS:000222180700022,
Author = {Vasamsetti, R and Vatturi, S and Deering, P and Kenner, SJ},
Editor = {Clar, M and Carpenter, D and Gracie, J and Slate, L},
Title = {Characterizing physical and hydraulic habitat using arc GIS and
   hydraulic modeling techniques},
Booktitle = {PROTECTION AND RESTORATION OF URBAN AND RURAL STREAMS},
Year = {2004},
Pages = {222-231},
Note = {Symposium on Protection and Restoration of Urban and Rural Streams,
   Philadelphia, PA, JUN 23-25, 2003},
Organization = {Urban Water Resources Res Council, Urban Streams Comm; Waterways
   Council, River Restorat Comm; Amer Soc Civil Engineers, Environm \&
   Water Resources Inst},
Abstract = {This paper presents an approach to develop a GIS database of the
   physical and hydraulic habitat characterization using field
   interpretation, digitizing from digital orthophoto quads (DOQ), and
   quantifying the hydraulic properties using the River 2D model (Steffler
   and Blackburn 2002). The study area consists of a small stretch of Rapid
   Creek flowing through Rapid City, South Dakota and the results of this
   study are to be completed for the full extent of the creek through the
   city. The South Dakota Department of Game, Fish and Parks (SDGFP) has
   the responsibility to manage the brown trout fishery habitat in Rapid
   Creek. Hydraulic modeling provides depth and velocity characteristics of
   the different habitat types. The physical and hydraulic habitat is
   characterized into pool, riffle, run, and glide habitat using GIS and
   modeling techniques. Characteristics of various habitat types were then
   compared with recommended habitat characteristics from accepted
   literature. The results obtained from the study will be used to make
   recommendations for stream improvement and to identify potential
   limiting factors with respect to the physical and hydraulic habitat.},
