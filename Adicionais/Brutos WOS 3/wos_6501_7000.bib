Note = {1st International Conference on Supervision in Psychotherapy, Timisoara,
   ROMANIA, JUN 22, 2018},
Organization = {Univ Tibiscus, Ctr Qualitat Res Counselling \& Psychotherapy},
Abstract = {Multimodal therapy is a systematic and technical eclectic
   psychotherapeutic approach because it uses techniques taken from several
   different theories and psychological systems. Techniques and
   interventions are applied systematically, based on customer data, but
   also on the clinical qualities and skills of the psychotherapist. In
   multimodal therapy, each case is thoroughly evaluated for problematic
   areas of behavior, affection (emotions and states), sensation, imaging,
   knowledge, interpersonal relationships, but also in the
   biochemical/neurophysiological field. This paper presents the basic
   techniques used by this therapeutic process.},
