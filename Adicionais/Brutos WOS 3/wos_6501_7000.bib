@inproceedings{ WOS:000659652200008,
Author = {Maysarah, S. and Putri, G. L. and Pratama, M. A. and Zulkarnain, F. and
   Willetts, J. and Foster, T. and Genter, F. and Harris, A. and Priadi, C.
   R.},
