@article{ WOS:000357938400005,
Author = {Rodrigues, Matilde A. and Amorim, Marta and Silva, Manuela V. and Neves,
   Paula and Sousa, Aida and Inacio, Octavio},
Title = {SOUND LEVELS AND RISK PERCEPTIONS OF MUSIC STUDENTS DURING CLASSES},
Journal = {JOURNAL OF TOXICOLOGY AND ENVIRONMENTAL HEALTH-PART A-CURRENT ISSUES},
Year = {2015},
