@inproceedings{ WOS:000308718400013,
Author = {Hashimoto, H. and Park, K.},
Editor = {DeWrachien, D and Proverbs, D and Brebbia, CA and Mambretti, S},
Title = {Inundation risk assessment of underground spaces in the downtown of
   Fukuoka City, Japan},
Booktitle = {FLOOD RECOVERY, INNOVATION AND RESPONSE II},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2010},
Volume = {133},
