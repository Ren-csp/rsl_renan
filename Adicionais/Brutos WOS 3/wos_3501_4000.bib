@article{ WOS:000222354600004,
Author = {Portnov, BA and Wellar, B},
Title = {Development similarity based on proximity: A case study of urban
   clusters in Canada},
Journal = {PAPERS IN REGIONAL SCIENCE},
Year = {2004},
Volume = {83},
Number = {2},
Pages = {443-465},
Month = {APR},
Note = {9th Jerusalem Conference in Canadian Studies, Hebrew Univ Jerusalem,
   Jerusalem, ISRAEL, JUN 30-JUL 04, 2002},
Organization = {Israel Assoc Canadian Studies; Govt Canadian, Dept Foreign Affairs},
Abstract = {Neighbouring towns in urban clusters of Canada exhibit similar levels of
   socio-economic development. However, when measured by different
   development indicators, inter-town development association differs in
   both nature and degree. In core areas, for instance, only population and
   housing variables exhibit a strong spatial association, while that of
   employment-related variables - average income, and unemployment rate -
   is weaker. This tendency reflects the fundamental difference between the
   two groups of variables. While population and housing variables are
   associated with the clustering of residents in socially homogenous
   areas, inter-town development similarity in respect to
   employment-related variables is weaker, apparently due to long-distance
   commuting. The article discusses the importance of urban clustering as a
   factor in regional development policies and programmes, and provides
   support for including cluster-related elements in a strategy to enhance
   urban growth in underdeveloped regions.},
