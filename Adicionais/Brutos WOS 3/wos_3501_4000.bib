@inproceedings{ WOS:000165804900022,
Author = {Tambo, N},
Editor = {Singh, VP and Soe, WI and Sonu, JH},
Title = {Evolution of urban metabolic system of water},
Booktitle = {WATER RESOURCES PLANNING AND MANAGEMENT},
Year = {1999},
Pages = {207-220},
Note = {International Conference on Water, Environment, Ecology, Socioeconomics
   and Health Engineering (WEESHE), SEOUL NATL UNIV, SEOUL, SOUTH KOREA,
   OCT 18-21, 1999},
Organization = {Seoul Natl Univ; Louisiana State Univ; Korean Soc Civil Engineers; Korea
   Water Resources Assoc; Korean Soc Water \& Waste Water; Korean Soc Agr
   Engn},
Abstract = {The modern period based upon rapid bulk transportation is about to be
   brought an end by environmental restrictions. Water and sewage works are
   a typical urban metabolic system with simple but large scale structure.
   The consumption of water by human beings who occupy 25\% in the total
   mass of animals being carried out by way of the simple water supply and
   disposal systems inevitably has a large impact on the natural water
   environment. Shortage of water and heavy pollution occur in all urban
   areas. In addition to this, micro pollution of the water supply also has
   potentially fatal consequences for human health. All water systems are
   in crisis.
   A new water metabolic system to support various types of water quality
   consumption in the post modern society should be such a system which
   ensures the supply of an appropriate quality and quantity of water from
   appropriate water resources with the least amount of energy consumption.
   Design and construction of an urban water metabolic system which based
   upon an essential use of potential water quality should be supported by
   appropriate separated or cascaded water collecting and discharge areas
   on the earth with the least amount of recycling.},
