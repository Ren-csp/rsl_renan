Note = {2nd International Conference on Environmental Science and Technology
   (ICEST 2011), Singapore, SINGAPORE, FEB 26-28, 2011},
Organization = {Asia Pacific Chem Biol \& Environm Engn Soc; Int Assoc Comp Sci \&
   Informat Technol},
Abstract = {In the Iran Caspian forests, logging operation is generally performed by
   using ground based skidding system. Residual trees are damaged by
   logging operations in these stands. In this study, after finishing the
   logging operation in the study area (32ha), the residual tree damages
   were examined by considering variable factors including logging stages,
   tree species, location, size and intensity of damages. Systematic
   sampling method with 100x100m distance and 30 round-shaped sample plots
   (1000m(2)) were used for collection of data. Results showed that
   approximately 12.1\% of the residual trees were damaged, 1.2\% destroyed
   and 32\% of damages are caused by felling stage and 68\% by skidding
   stage. From all damaged trees, 62\% belonged to beech, 15\% to hornbeam
   and 10\% to alder. Damages on the tree boles are respectively, 11\% on
   stump level, 51\% on first lm and 38\% on upper first 1m. Damage sizes
   very depending on the logging stages. About 54\% of the damages
   intensity observed bark squeezed and 46\% wood damaged. Appropriate
   slvicultural prescriptions and harvesting technologies can reduce
   wounding to acceptable levels.},
