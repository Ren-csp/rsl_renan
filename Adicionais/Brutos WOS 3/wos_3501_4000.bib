@article{ WOS:000431743000143,
Author = {Mat, Nik Hazimah Nik and Salleh, Hayatul Safrah and Yusof, Yusnita and
   Mohamed, Wan Norhayati and Halim, Muhammad Abi Sofian Abdul},
Title = {Perceptions of the Use of Marine Resources as a Traditional Medicine in
   Terengganu, Malaysia},
