@article{ WOS:A1993LX12700005,
Author = {DENHAM, SA and GROUT, L},
Title = {SOCIALIZATION OF EMOTION - PATHWAY TO PRESCHOOLERS EMOTIONAL AND SOCIAL
   COMPETENCE},
