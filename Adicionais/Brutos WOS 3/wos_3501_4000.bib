Title = {Chinese parental emotion-related socialization behaviors (ERSBs):
   Linkages with daily hassles and Implications to Children's Social
   Competence},
Booktitle = {2009 THE REGIONAL WORKSHOP OF THE INTERNATIONAL SOCIETY FOR THE STUDY OF
   BEHAVIOURAL DEVELOPMENT (ISSBD): SOCIAL AND EMOTIONAL DEVELOPMENT IN
   CHANGING SOCIETIES},
