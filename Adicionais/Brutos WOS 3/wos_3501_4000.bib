@inproceedings{ WOS:000652184500017,
Author = {Sunarto, S. and Mangkara, Sessario B. and Arozaq, Miftahul},
Editor = {Semedi, B},
Title = {Environmental planning and management in traditional market: a study at
   Ibuh Market (Payakumbuh) and Pandansari Market (Balikpapan)},
Booktitle = {INTERNATIONAL CONFERENCE ON SUSTAINABILITY SCIENCE AND MANAGEMENT:
   ADVANCED TECHNOLOGY IN ENVIRONMENTAL RESEARCH (CORECT-IJJSS 2019)},
