@inproceedings{ WOS:000074424600010,
Author = {Timar, E},
Editor = {Miller, D and DeRoo, G},
Title = {Improving environmental performance of local land use plans: an
   experiment with sustainable urban planning in Amsterdam},
Booktitle = {URBAN ENVIRONMENTAL PLANNING: POLICIES, INSTRUMENTS AND METHODS IN AN
   INTERNATIONAL PERSPECTIVE},
Year = {1997},
Pages = {123-135},
Note = {International Symposium on Urban Planning and Environment, SEATTLE, WA,
   MAR, 1994},
Organization = {Minist Housing Spatial Planning \& Environm, Netherlands; Univ
   Groningen, Fac Spatial Sci, Netherlands; Univ Washington, Dept Urban
   Design \& Planning},
Abstract = {In The Netherlands, the local land use plan is a tool for safeguarding
   local environmental quality. This is accomplished by three means: the
   regulation of noise and hazards, the enforcement of location policy, and
   environmental zoning around industries. Unfortunately, by law the local
   land use plan is not equipped to actively enhance sustainable
   development of an urban area. The City of Amsterdam therefore developed
   an experimental Environmental Performance System (EPS), which is plugged
   into the local land use plan of a recent project. The Environmental
   Performance System is quantified in an Environmental Performance Level.
   Building Permits are only granted after obtaining the required
   performance level. To obtain this level, some discretion is possible in
   selecting from a list of 17 measures that are meant to promote
   sustainable urban development.},
