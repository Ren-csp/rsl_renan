@article{ WOS:000082743400010,
Author = {Abe, JAA and Izard, CE},
Title = {A longitudinal study of emotion expression and personality relations in
   early development},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {1999},
Volume = {77},
Number = {3},
Pages = {566-577},
