@article{ WOS:000178699200010,
Author = {Peng, CY and Wu, XD and Liu, G and Johnson, T and Shah, J and
   Guttikunda, S},
Title = {Urban air quality and health in China},
Journal = {URBAN STUDIES},
Year = {2002},
