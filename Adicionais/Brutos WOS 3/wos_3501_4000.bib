Month = {DEC},
Note = {11th Biennial Meeting of the Society-for-Research-on Adolescence, San
   Francisco, CA, MAR 23-26, 2006},
Organization = {Soc Res Adolescence},
Abstract = {This study examined how the need for autonomy may be coexisting with
   current cultural norms. A total of 264 U.S., 76 Swiss, and 51 British
   adults completed two perceptions of children's rights surveys. The
   results showed that Swiss and British participants were significantly
   more likely to advocate for autonomy or self-determination rights than
   same-aged U.S. adults. British participants were also more likely to
   advocate for children's self-determination rights than U.S. and Swiss
   participants, whereas Swiss adults were more likely to grant children
   nurturance rights than British and US adults. Generally, parents were
   less likely to advocate for autonomy than non-parents. The results are
   discussed in terms of individualism-collectivism, self-determination
   theories, and parentalism.},
