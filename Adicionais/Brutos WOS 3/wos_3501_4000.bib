@inproceedings{ WOS:000223250200017,
Author = {Petrelli, M},
Editor = {Wadhwa, LC},
Title = {A transit network design model for urban areas},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
