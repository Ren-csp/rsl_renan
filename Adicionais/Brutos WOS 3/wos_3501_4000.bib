   Roemer, Lizabeth},
Title = {A preliminary investigation of the relationship between emotion
   regulation difficulties and posttraumatic stress symptoms},
Journal = {BEHAVIOR THERAPY},
Year = {2007},
Volume = {38},
Number = {3},
Pages = {303-313},
