Title = {Transactions among Social, Cultural, and Physical Environments in
   Residential Areas Case Study of a Suburban Community in Osaka, Japan},
Booktitle = {PROCEEDINGS OF WORLD ACADEMY OF SCIENCE, ENGINEERING AND TECHNOLOGY, VOL
   22},
Series = {Proceedings of World Academy of Science Engineering and Technology},
Year = {2007},
Volume = {22},
Pages = {538+},
Note = {Conference of the World-Academy-of-Science-Engineering-and-Technology,
   Prague, CZECH REPUBLIC, JUL 27-29, 2007},
Abstract = {This study aims to define ``Social, Cultural, and Physical Transactions
   (SCP Transactions){''} in the residential environment, and analyze the
   transition of the transactions from pre-urbanization to the present, in
   a case study of a characteristic suburban community; Kamishinden, in
   Osaka, Japan. This area was excluded from development of a planned
   community in the 1960's, in spite of its important location, because of
   the residents' opposition to development. This area has an old existing
   village which was developed as an agricultural community about 370 years
   ago, and many high-rise apartment houses around the village.
   Before the development of the surrounding community, there were various
   SCP Transactions among physical aspects, social aspects, lifestyles, and
   environmental images. Since the development, many SCP Transactions have
   become weak or been lost, because of the modernization of lifestyles,
   and a loss of agriculture. The spatial structure of houses and the
   landscape have been changing in a disorderly way, due to a loss of
   social and cultural factors which had influenced the construction of the
   physical environment. Some traditional elements such as old houses and
   local events, which still remain in the spatial and social structure,
   are inter-connected through SCP Transactions.},
