@article{ WOS:000431750800061,
Author = {Ahmad, Nor Lela and Mahmood, Nik Hasnaa Nik and Rashid, Wan Edura Wan
   and Yunus, Noor Azlina Mohamed and Ong, Mohd Hanafi Azman and Asri,
   Ainin Sofia Muhamad},
Title = {Examining the Perception of Attendees on Sustainable Efforts Towards
   Event Greening Using the Values, Beliefs and Norms Theory},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {11},
Pages = {10748-10752},
Month = {NOV},
Note = {International Conference on Information in Business and Technology
   Management (12BM), MALAYSIA, APR 18-20, 2017},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {The elements of values, beliefs and norms will affect an individual's
   perception on certain issues. Understanding the environmental issues
   based on values will contribute to the ecological view in general. Then,
   this comprehension will change beliefs and norms. Given the awareness on
   ecological worldview, changes in norms would encourage people to be more
   pro-environmental. Norms are those actions articulated from the values
   and beliefs assimilated from theories and practices which is later
   executed based on selected preferences by an individual. These norms
   will be emulated into action in an individual's daily lives as a result
   of the combined and improved or adjusted values, beliefs and norms they
   have acquired from various sources. Ultimately, forming of a perception
   comes from the values, beliefs and norms of individuals. The combined
   elements of values, beliefs and norms will help the researcher to form a
   general perception on sustainable efforts towards event greening from
   the perspective of the event attendees. In this research, the focus is
   on event management and the efforts from event organizers to implement
   sustainable practices. The researchers wants to investigate from the
   perspective of event attendees. This research aims to explore the
   values, beliefs and norms theory on event attendees that influence their
   ecological worldview and pro-environmental personal norms and the effect
   that these dimensions have to uncover issues that will influence their
   perception on sustainable practices at events. The research findings are
   critical for the researcher to evaluate the situation and recommend
   appropriate green event management guidelines for event organizers to
   remain competitive by implementing sustainable practices for long-term
   survival in the event industry. The research methodology is a
   quantitative method using survey and the data is analyzed using the
   Multiple Linear Regression analysis This is the result from the pilot
   study of this research. The analysis indicated that, Values have a
   significant influence toward Perception, except for the Beliefs and
   Norms.},
