@article{ WOS:A1995RF87200025,
Author = {POUET, MF and GRASMICK, A},
Title = {URBAN WASTE-WATER TREATMENT BY ELECTROCOAGULATION AND FLOTATION},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1995},
Volume = {31},
Number = {3-4},
