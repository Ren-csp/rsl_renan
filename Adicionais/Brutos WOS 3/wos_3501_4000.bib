Year = {2017},
Volume = {23},
Number = {9, SI},
Pages = {8777-8781},
Month = {SEP},
Note = {ASIA International Conference (AIC) on Emerging Issues in Economics and
   Finance (EIEF) and Future of Marketing and Management (FMM), Univ
   Teknologi Malaysia, Johor Bahru, MALAYSIA, DEC 10-11, 2016},
Abstract = {Using a qualitative study, 20 interviews were carried out with the
   Terengganu local community to explore their perceptions on the use of
   marine resources as a traditional medicine. The interview involves
   traditional practitioners, fishermen, villagers and public opinions
   around the coastal areas of Terengganu. Seventeen marine resources have
   been identified as traditional medicine by respondents. Interestingly,
   the related marine resources are perceived mostly as the treatment of
   diseases compared to other modes of effect. Outcomes of this study are
   valuable in developing more health solutions alternatives based on
   marine resources. This study could contribute to increase the livelihood
   of the society in facing with more health challenges in the modern
   environment. Whilst traditional medicine is hardly recognized and
   incorporated into the formal health care system, the identification of
   the particular marine resources could lead to a further scientific
   investigation to reduce the dependency on chemical drugs in a medical
   world.},
