Author = {Vasiliu-Oromulu, Liliana and Honciuc, Viorica and Maican, Sanda and
   Munteanu, Cristina and Stanescu, Minodora and Fiera, Cristina and Ion,
   Mihaela and Purice, Dorina},
Editor = {Gokcekus, H and Turker, U and LaMoreaux, JW},
Title = {Are Certain Invertebrate Species Sensitive Bioindicators of the Air
   Pollution?},
