Title = {Effect of Tourist Characteristic, Marine Tourism Demand, and Number of
   Visits to the Value Perceptions and Willingness to Pay to Environmental
   Marine Tourism in Ambon City},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON TROPICAL AND COASTAL REGION ECO
