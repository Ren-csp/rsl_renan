@inproceedings{ WOS:000454721800029,
Author = {Koryagin, M. E. and Medvedev, V. I. and Strykov, P. G.},
Book-Group-Author = {IOP},
Title = {Development of safe routes for children in urban environment},
Booktitle = {ALL-RUSSIAN RESEARCH-TO-PRACTICE CONFERENCE ECOLOGY AND SAFETY IN THE
   TECHNOSPHERE},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {115},
Note = {All-Russian Research-to-Practice Conference on Ecology and Safety in the
   Technosphere, Yurga, RUSSIA, MAR 06-07, 2017},
Abstract = {The matter of development of safe travel routes for children between
   school and home is analyzed. The availability of various applications
   and devices to identify the location of the child and his/her travel
   routes is noted. The main factors to be taken into account when planning
   children travel routes are described. The most popular Russian services
   for route planning, Google, Yandex, and 2GIS, are discussed. These
   services are shown to have a number of shortcomings which does not allow
   them to choose really safe routes. A decision on making the route
   selection by two criteria (the travel time and the probability of an
   accident) is obtained. As a numerical example, the Pareto area for
   possible routes is constructed.},
