@inproceedings{ WOS:000392271000072,
Author = {Zeynalyan, Nane},
Editor = {Hajek, P and Sahota, T and Jones, MA},
Title = {THE PECULIARITIES OF SOCIAL PERCEPTION IN THE CONTEXT OF
   INFORMATION-PSYCHOLOGICAL WARFARE},
