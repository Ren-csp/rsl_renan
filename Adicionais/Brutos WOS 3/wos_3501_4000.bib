Organization = {Kasetsart Univ; Commiss Higher Educ; Minist Educ; Minist Agr \&
   Cooperat; Minist Sci \& Technol; Minist Nat Resources \& Envirnom;
   Minist Informat Commun Technol; Natl Res Council Thailand; Thailand Res
   Fund},
Abstract = {The present study was intended to make electrophysiological
   investigations into the preattentive perception of native and non-native
   speech sounds. The mismatch negativity (MMN) was elicited by single
   syllable change of both native and non-native speech-sounds contrasts in
   tonal languages. Electroencephalography (EEG) was recorded and
   low-resolution brain electromagnetic tomography (LORETA) was utilized to
   explore the neural electric activity. This result suggested that the
   left hemisphere was predominant in the perception of native speech
   sounds, whereas the non-native speech sound was dominated by the right
   hemisphere, which may be explained by the specialization in processing
   the prosodic and emotional components of speech formed in this
   hemisphere.},
