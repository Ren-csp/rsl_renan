Title = {Cross-language speech perception: Swedish, English, and Spanish
   speakers' perception of front rounded vowels},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {442-445},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {Cross-language research on adult speech perception demonstrates a strong
   effect of linguistic experience on consonant perception but not on vowel
   perception. Our paper re-examines the effect of linguistic experience on
   adults' vowel perception First, identification and goodness functions
   for the high front quadrant of the vowel space were mapped for speakers
   of Swedish, English, and Spanish. Second, speakers performed a
   discrimination task for one vector in this vowel space. Stimuli along
   this vector were identified by Swedish speakers as belonging to the
   Swedish front rounded vowel series \textbackslash{}tt:\textbackslash{} -
   \textbackslash{}o:\textbackslash{}. However, English and Spanish
   speakers reported that the stimuli were not in their language.
   Significant differences in discriminability of these stimuli were
   observed across speakers of different languages. Our results Show that
   linguistic experience plays a significant role in vowel discrimination.},
