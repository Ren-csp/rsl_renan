@article{ WOS:A1998YJ50400007,
Author = {Benjamin, MT and Winer, AM},
Title = {Estimating the ozone-forming potential of urban trees and shrubs},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {1998},
Volume = {32},
Number = {1},
Pages = {53-68},
