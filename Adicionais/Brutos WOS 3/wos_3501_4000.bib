@inproceedings{ WOS:000179455300009,
Author = {Sepulveda, D},
Editor = {Carmona, M and Rosemann, J and Schoonraad, M},
Title = {The square as urban element: Comparative analysis of public space in
   different morphological zones in Santiago and Cordoba.},
Booktitle = {GLOBALIZATION, URBAN FORM AND GOVERNANCE},
Year = {2001},
Pages = {143-156},
Note = {5th International Conference on Globalization, Urban Form and
   Governance, DELFT, NETHERLANDS, OCT, 2001},
Organization = {ALFA; IBIS},
Abstract = {This paper identifies similar morphological zones in two Southern cities
   of Latin America (Santiago in Chile and Cordoba in Argentine) in terms
   of the spatial transformation process that have taken place in the
   cities over the centuries. This identification of morphological zones is
   necessary in order to analyse the potential of the Public Square to
   create synergies and to affect development in different areas of the
   city. This paper explains the methodology used to identify and describe
   the different homogenous areas in terms of historical, economic and
   social development influencing the formation of morphologic patterns in
   the two case-cities. The main idea is to identify the transformation
   process of the different morphologies that constitute the city,
   recognising the existence of particular differences in terms of its
   historical and social context, the location, accessibility, the urban
   morphology and the specific built environment where the square is
   located. As the square is considered an element for urban restructuring
   and a basic element of the urban system, the square is studied at
   different levels in terms of its contribution to the urban fabric.
   Therefore it is considered necessary to study the spatial relationship
   between the square and the transformation of morphology as well as how
   citizens experience it, use it and determine its function. We believe
   that there is a relationship between the vitality of the place, the
   sense of place and the quality of the square that influence the
   transformation potential of the square.},
Publisher = {DELFT UNIV PRESS DUP SCI},
Address = {P.O. BOX 98 PROMETHEUSPLEIN 1, 2628 CZ DELFT, NETHERLANDS},
