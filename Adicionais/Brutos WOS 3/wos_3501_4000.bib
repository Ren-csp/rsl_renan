
@inproceedings{ WOS:001850555500036,
Author = {Hamilton-Holbrook, Theodora and Iones, John},
Book-Group-Author = {IEEE},
Title = {Animal or Machine? Neuromodulated Emotions and their Effect on Affinity},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON DEVELOPMENT AND LEARNING, ICDL},
Year = {2025},
Note = {2025 International Conference on Development and Learning-ICDL-Annual,
   Prague, CZECH REPUBLIC, SEP 16-19, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; Czech Technical
