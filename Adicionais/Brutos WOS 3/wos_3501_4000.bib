@inproceedings{ WOS:A1996BJ20B00456,
Author = {Ohala, JJ},
Editor = {Bunnell, HT and Idsardi, W},
Title = {Ethological theory and the expression of emotion in the voice},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {1812-1815},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {A useful source for unifying theories guiding research on the expression
   of emotions by the voice as well as by accompanying visual gestures
   (kinesics) is provided by ethology, the science devoted to the
   comparative study of behavior. Ethology, examining human and non-human
   behavior, maintains that much of behavior is shaped by phylogenetic
   adaptations. In this paper I will review and present evidence relevant
   to some of the fundamental theoretical issues addressed by ethology:
   Does a signal of emotion reflect the inner (psycho)physiological state
   of the signaler or is it rather primarily designed to induce in
   receivers behavior that benefits the signaler?
   Are there cross-cultural and cross-species similarities in emotional
   signals?
   Are the separate components of emotional signals, e.g., voice quality,
   FO, as well as kinesic elements like eyebrow level, independent of each
   other or are they correlated in a way to mutually enhance the conveyance
   of a given message?
   What is the basic vocabulary of emotions? How many are there?},
