@inproceedings{ WOS:000263364600006,
Author = {Wang Bihan and Liang Zhi},
Editor = {Zhang, Y},
Title = {An Empirical Study on Tourists' Perception of the Environment of Tourism
   Destinations from the Perspective of Marketing},
Booktitle = {PROCEEDINGS FOR EURO-ASIA CONFERENCE ON ENVIRONMENT AND CORPORATE SOCIAL
   RESPONSIBILITY: TOURISM AND MANAGEMENT SESSION},
Year = {2008},
Pages = {59-66},
Note = {Euro-Asia Conference on Environment and Corporate Social Responsibility
   - Tourism and Management Session, Tianjin, PEOPLES R CHINA, JAN 18-19,
   2009},
Organization = {TU Bergakadem Freiberg; Tianjin Univ, Tourism Management Coll; German
   Acad Exchange Service Fdn; German Embassy},
Abstract = {Problems associate with sustainable tourism development attract
   increasingly more concerns global wide. A core problem of sustainable
   tourism development is carrying capacity constraints. At present, the
   majority of researches on tourism carrying capacity are focused on
   tourism destinations and local residents, while few researches involve
   tourists. In this paper, the authors stress that tourists' carrying
   capacity is one of the key factors influencing psychological impacts of
   tourism destination. In addition, tourist's perception of environmental
   friendly destination is one of the major conditions that determine the
   mental capacity of tourists. Taking theories of sustainable tourism
   development and tourism carrying capacity as guidelines, the authors
   study influences of the tourists' perception on environmental friendly
   destinations on the development of regional tourism through empirical
   research method. Tianjin which is a big city in North China is used as
   an example for the study.},
