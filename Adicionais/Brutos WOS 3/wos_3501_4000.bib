   TEHRAN, IRAN},
Booktitle = {ISPRS INTERNATIONAL JOINT CONFERENCES OF THE 2ND GEOSPATIAL INFORMATION
   RESEARCH (GI RESEARCH 2017); THE 4TH SENSORS AND MODELS IN
   PHOTOGRAMMETRY AND REMOTE SENSING (SMPR 2017); THE 6TH EARTH OBSERVATION
