Title = {Sustainable E-Waste Management Through a Circular Economy Framework:
   Integrating Smart Technologies for Resource Recovery in Urban
   Environments},
Booktitle = {2025 7TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCES AND
   RENEWABLE ENERGY, ESRE 2025},
Series = {E3S Web of Conferences},
Year = {2025},
