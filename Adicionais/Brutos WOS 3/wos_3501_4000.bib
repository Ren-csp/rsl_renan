@inproceedings{ WOS:000445923300022,
Author = {Lubis, R. F.},
Editor = {Mukti, MM and Yuniati, MD and Setiadi, B},
Title = {Urban hydrogeology in Indonesia: A highlight from Jakarta},
Booktitle = {GLOBAL COLLOQUIUM ON GEOSCIENCES AND ENGINEERING 2017},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
