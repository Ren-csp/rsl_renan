Organization = {Wessex Inst Technol; Advances Transport Book Series},
Abstract = {With democratisation in South Africa in 1994 the new government
   inherited a segregated and fragmented spatial system. One of the major
   challenges is to integrate and redevelop the urban core areas. Two of
   the main instruments to attain this. objective are the formulation of
   Integrated Transport Plans and Integrated Development Plans. The
   alignment between these two plans is of critical importance for the
   integration of the urban form. It is evaluated against the historical
   context of spatial and development planning; the interface between
   integrated transport and development planning; guiding principles for
   integrated transport and development plans; spatial development
   frameworks and urban integration. Improved management practices and
   process alignment is critical to promote urban integration and
   sustainable urban development.},
