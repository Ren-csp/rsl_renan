@inproceedings{ WOS:000352649100006,
Author = {Xiao Lei and Li Li},
Editor = {Zhang, Y},
Title = {Comparative Researches on Financial Support Efficiency of Urban Economic
   Circle in China},
Booktitle = {PROCEEDINGS OF THE 10TH EURO-ASIA CONFERENCE ON ENVIRONMENT AND
   CORPORATE SOCIAL RESPONSIBILITY: TOURISM, SOCIETY AND EDUCATION SESSION,
   PT I},
Year = {2014},
