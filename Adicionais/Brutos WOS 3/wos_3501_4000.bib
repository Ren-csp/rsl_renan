@inproceedings{ WOS:000078260900520,
Author = {Lamb, IA and Coulsell, JB and Hutchison, BJ},
Editor = {Moore, D and Hungr, O},
Title = {Melbourne's City Link tunnels - Part 1: Engineering geology in an urban
   environment},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOLS 1-5},
Year = {1998},
Pages = {3723-3730},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {The Melbourne City Link highway project has two 9 to 12 m high by 15.8 m
   wide tunnels, the 3.4 km Burnley Tunnel and the 1.6 km Domain Tunnel.
   Each tunnel has both driven and cut and cover sections, and have been
   constructed through the folded Silurian Age ``Melbourne Formation{''}
   and Tertiary/Quarternary sediments. The Melbourne Formation is comprised
   mainly of siltstone, with some sandstone; both having been weathered to
   varying degrees and intruded by porphyritic igneous bodies. During the
   late Tertiary the broad Jolimont Valley was cut into the Silurian
   bedrock. The valley was subsequently filled with a series of sediments
   and basalt flows which has resulted in a variety of mixed ground
   conditions upon which the inner city suburbs of Melbourne and Richmond
   have developed. This two part paper describes the engineering geology
   (Part I) and some of the techniques (Part 2) adopted to construct
   portions of the tunnels, particularly those in mixed ground conditions.},
