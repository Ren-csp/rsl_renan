@inproceedings{ WOS:000222180700006,
Author = {Bui, TD and Eng, P},
Editor = {Clar, M and Carpenter, D and Gracie, J and Slate, L},
Title = {A review of stormwater and urban stream management practices in Ontario},
Booktitle = {PROTECTION AND RESTORATION OF URBAN AND RURAL STREAMS},
Year = {2004},
Pages = {61-72},
Note = {Symposium on Protection and Restoration of Urban and Rural Streams,
   Philadelphia, PA, JUN 23-25, 2003},
Organization = {Urban Water Resources Res Council, Urban Streams Comm; Waterways
   Council, River Restorat Comm; Amer Soc Civil Engineers, Environm \&
   Water Resources Inst},
Abstract = {The importance of maintaining and enhancing our water resources is now
   well recognized. As a result, designs for stormwater and urban stream
   management projects must consider other aspects such as biological
   enhancement, water quality control, and fluvial geomorphology. This
   approach requires more knowledge and much more effort from the engineer
   who must be able to understand and communicate with non-engineering
   specialists to derive solutions that address multiple objectives.
   The paper reviews current practice as recommended by the Ontario
   Ministry of Environment (MOE) which, although presented as guidelines,
   have become a de facto standard as a result of their adoption by
   regulatory bodies. The relevant portions of the 1994 MOE manual are
   reviewed briefly together with changes proposed in a 1999 draft
   amendment. In the area of fluvial morphology, potential pitfalls are
   identified due to some overly simplistic solutions that are suggested.
   The complexity of the non-cohesive sediment transport problem is
   illustrated with reference to many research works in this area.
   Consideration of modes of sediment transport and the physical processes
   associated with cohesive sediments further compounds the problem. The
   paper closes with an appeal for greatly augmented education to enable
   engineers and other specialists to co-operate in providing comprehensive
   solutions to these problems. In addition, a systematic approach (in
   dealing with stormwater and urban stream management projects) is also
   proposed so that improvements could be made in the new era of
   environmental hydraulics.},
