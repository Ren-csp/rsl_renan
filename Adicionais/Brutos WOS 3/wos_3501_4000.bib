@inproceedings{ WOS:001587166000015,
Author = {Qin, Haoming and Zhai, Wei and Giacomoni, Marcio and Huang, Huanchun},
Editor = {Ahmad, S and Struck, S and Drummond, C},
Title = {Virtual Reality and Climate Change Perception: A Galveston Case Study},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2025: COOL SOLUTIONS TO
   HOT TOPICS},
Year = {2025},
Pages = {144-157},
Note = {2025 World Environmental and Water Resources Congress, Anchorage, AK,
   MAY 18-21, 2025},
Abstract = {This study explores the impact of virtual reality (VR) simulations on
   public perceptions and behaviors related to climate change, focusing on
   Galveston, Texas. Using a quantitative research approach, we conducted
   an experimental design in which participants experiencing immersive VR
   scenarios depicting extreme weather events, followed by a public goods
   game to evaluate their willingness to contribute to climate resilience
   efforts. Data collection methods included surveys, VR simulations, and
   behavioral analysis. The findings indicate that participants who were
   exposed to detailed informational content (Scenario 2) contributed more
   consistently to climate resilience than those exposed to immersive storm
   surge simulations (Scenario 1). Additionally, higher levels of education
   were positively associated with increased contributions, whereas older
   participants showed less willingness to contribute. These results
   suggest that combining comprehensive information with immersive
   experiences, rather than relying solely on immersive experiences, may be
   more effective in fostering proactive mitigation behaviors. Policymakers
   are encouraged to integrate educational interventions and
   information-based strategies alongside experiential tools like VR to
   enhance public engagement in climate adaptation, particularly through
   communication tailored by age and education level.},
