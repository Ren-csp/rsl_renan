Title = {Assessing the Sustainability of Innovations in Urban Ecological
   Sanitation: Erdos Eco-town Project},
Booktitle = {WATER INFRASTRUCTURE FOR SUSTAINABLE COMMUNITIES: CHINA AND THE WORLD},
