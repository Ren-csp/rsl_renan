Editor = {Marchal, M and Kajimoto, H and Lopes, P and Pacchierotti, C and Basdogan, C and Gori, M and Lemaire-Semail, B},
Title = {Studying the Influence of Contact Force on Thermal Perception at the
   Fingertip},
Booktitle = {HAPTICS: UNDERSTANDING TOUCH; TECHNOLOGY AND SYSTEMS; APPLICATIONS AND
   INTERACTION, EUROHAPTICS 2024, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {14769},
Pages = {154-161},
Note = {14th International Conference on Human Haptic Sensing and Touch Enabled
   Computer Applications-EuroHaptics, Lille, FRANCE, JUN 30-JUL 03, 2024},
Abstract = {This paper investigates the influence of contact force applied to the
   human's fingertip on the perception of hot and cold temperatures,
   studying how variations in contact force may affect the sensitivity of
   cutaneous thermoreceptors or their interpretation. A psychophysical
   experiment involved 18 participants exposed to cold (20 degrees C) and
   hot (38 degrees C) thermal stimuli at varying contact forces, ranging
   from gentle (0.5 N) to firm (3.5N) touch. Results show a tendency to
   overestimate hot temperatures (hot feels hotter than it really is) and
   underestimate cold temperatures (cold feels colder than it really is) as
   the contact force increases.
   This result might be linked to the increase in the fingertip contact
   area that occurs as the contact force between the fingertip and the
   plate delivering the stimuli grows.},
