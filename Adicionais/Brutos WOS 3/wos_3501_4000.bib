@inproceedings{ WOS:001461679600005,
Author = {Djibo, Abdou Kailou},
Editor = {Jeon, HY},
Title = {Impacts of Climate Change on Water Resources in the Urban District of
   Tera, Niger},
Booktitle = {SUSTAINABLE DEVELOPMENT OF WATER AND ENVIRONMENT, ICSDWE 2024},
Series = {Environmental Science and Engineering-Environmental Engineering},
Year = {2024},
Pages = {47-58},
Note = {7th International Conference on Sustainable Development of Water and
   Environment, Xiamen, PEOPLES R CHINA, AUG 16-18, 2024},
Abstract = {Like many districts in Sahelian regions, the urban district of Tera is
   at risk of water shortages due to climate change. This district, located
   in the ``Dargol{''} watershed in the far west of Niger, spans an area of
   approximately 2,380 km(2). It receives a significant proportion of
   internal inflow from the River Niger and its drainage system. The urban
   district of Tera is characterised by a North-Sahelian climate, with an
   average annual rainfall of around 420 mm and average temperatures of 29
   degrees C. Given the importance of water resources in a Sahelian
   environment, this article seeks to analyse the climate change factors
   impacting water resources in the urban district of Tera. The methodology
   employed is mixed, combining cartographic, climatic, qualitative, and
   quantitative data. A series of maps and climate data from 1990 to 2020
   were produced and analysed. The results of this study show that water
   resources in the urban district of Tera are affected by climate change.
   Indeed, the district is experiencing irregular rainfall, with more than
   18 dry years out of the 33 in the series. It is also subject to high
   temperatures exceeding 45 degrees C, which increase evapotranspiration,
   random groundwater recharge, erosion gullies, reduced vegetation cover,
   and surface water bodies.},
