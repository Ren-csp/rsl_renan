@article{ WOS:000181661300006,
Author = {Sawicka-Kapusta, K and Zakrzewska, M and Bajorek, K and
   Gdula-Argasinska, J},
Title = {Input of heavy metals to the forest floor as a result of Cracow urban
   pollution},
Journal = {ENVIRONMENT INTERNATIONAL},
Year = {2003},
Volume = {28},
Number = {8},
Pages = {691-698},
Month = {MAR},
Note = {Secotox World Congress/6th European Conference on Ecotoxicology and
   Environmental Safety, KRAKOW, POLAND, AUG 20-24, 2001},
Organization = {Univ Mining \& Met; Jagiellonian Univ},
Abstract = {The influence of Cracow's urban pollution on small forest ecosystems was
   studied during 1998-2000. Seven sites located at different distances
   from the Cracow conurbation and from busy road were selected. Two sites
   were situated 26 and 31 km from Cracow town along an eastern transect,
   the other five-3, 8, 14, 26 and 35 km respectively, from Cracow-along a
   southern transect. At the beginning of September, five litter traps were
   set at each site. The quantity of litter fall, along with percentage
   composition of each species, were estimated for an area of 1 m(2). The
   concentration of Cd, Ph, Cu, Zn and Fe in the litter fall and the input
   of these metals to the forest floor were determined. The input of
   cadmium ranged from 84 mug m(-2) at Kornatka in 1998 to 382 mug m(-2) at
   Bonarka in 2000. The input of lead was about 10 times higher than
   cadmium and varied from 406 mug m(-2) at Weglowka in 1998 to 3717 mug
   m(-2) at Bonarka in 2000. Input of Cu, Zn and Fe to the forest floor
   showed the similar tendency During 1998-2000, the highest heavy metal
   concentrations in the litter fall and their impact on the forest floor
   were always found at sites close to the Cracow conurbation and, in the
   eastern transect, close to a steel works. Input of metals to the forest
   floor tended to decrease with increasing distance from the centre of
   Cracow. (C) 2002 Elsevier Science Ltd. All rights reserved.},
