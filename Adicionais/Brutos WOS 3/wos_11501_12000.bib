@article{ WOS:000270643100015,
Author = {Tombrou, M. and Bossioli, E. and Protonotariou, A. P. and Flocas, H. and
   Giannakopoulos, C. and Dandou, A.},
Title = {Coupling GEOS-CHEM with a regional air pollution model for Greece},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2009},
Volume = {43},
