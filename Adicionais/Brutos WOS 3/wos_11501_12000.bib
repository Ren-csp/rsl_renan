@article{ WOS:000169467200024,
Author = {Brodie, J and Christie, C and Devlin, M and Haynes, D and Morris, S and
   Ramsay, M and Waterhouse, J and Yorkston, H},
Title = {Catchment management and the Great Barrier Reef},
