@inproceedings{ WOS:001461679600006,
Author = {Yang, Mingzhe and Wang, Shaoyi and Hu, Guochen and Shentu, Huabin and
   Cheng, Gang and Wu, Haitian and Xiang, Chaoyang and Hu, Yifan and Yu,
   Hailan},
Editor = {Jeon, HY},
Title = {Ecological Transformations and Socio-Economic Implications: A 15-Year
   Assessment of Land Use Changes on Lingkun Island},
Booktitle = {SUSTAINABLE DEVELOPMENT OF WATER AND ENVIRONMENT, ICSDWE 2024},
Series = {Environmental Science and Engineering-Environmental Engineering},
Year = {2024},
Pages = {59-68},
Note = {7th International Conference on Sustainable Development of Water and
   Environment, Xiamen, PEOPLES R CHINA, AUG 16-18, 2024},
Abstract = {This study assesses the ecological and socio-economic implications of
   land use and land cover changes on Lingkun Island, Zhejiang province,
   China, over a 15-year period. Utilizing remote sensing imagery and
   national spatial data, we document a significant 18.53\% reduction in
   natural and semi-natural areas, indicating habitat fragmentation and
   loss. The study reveals a 68.95\% decrease in pomelo orchards,
   threatening agrobiodiversity and traditional ecological knowledge.
   Additionally, a 57.66\% increase in artificial surfaces may intensify
   the urban heat island effect, altering the microclimate and increasing
   the island's vulnerability to climate change impacts such as sea-level
   rise and coastal erosion. The findings underscore the urgent need for an
   integrated coastal zone management strategy that harmonizes urban
   development, habitat conservation, and ecosystem service maintenance.
   Stakeholder involvement, strategic land-use planning, and continuous
   ecological monitoring are highlighted as critical components of this
   approach. The study concludes that a proactive, holistic strategy is
   essential for preserving the ecological and cultural heritage of Lingkun
   Island, ensuring its sustainability and fostering resilient communities.},
