@article{ WOS:000075592500022,
Author = {Ferreira, CT and Ceccaldi, M and Giusiano, B and Poncet, M},
Title = {Separate visual pathways for perception of actions and objects: evidence
   from a case of apperceptive agnosia},
Journal = {JOURNAL OF NEUROLOGY NEUROSURGERY AND PSYCHIATRY},
Year = {1998},
Volume = {65},
Number = {3},
