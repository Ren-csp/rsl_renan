@article{ WOS:000257619600008,
Author = {Perrino, Cinzia and Catrambone, Maria and Pietrodangelo, Adriana},
Title = {Influence of atmospheric stability on the mass concentration and
   chemical composition of atmospheric particles: A case study in Rome,
   Italy},
Journal = {ENVIRONMENT INTERNATIONAL},
Year = {2008},
Volume = {34},
Number = {5},
Pages = {621-628},
Month = {JUL},
Note = {Joint Conference of the 3rd International Symposium on Air Quality
   Management at Urban, Regional and Global Scales/14th IUAPPA Regional
   Conference, Istanbul, TURKEY, SEP 26-30, 2005},
Organization = {Int Union Air Pollut Prevent \& Environm Protect Assoc},
Abstract = {PM10 concentration and chemical composition (ions and carbon compounds)
   at three sampling stations in Rome and in its surroundings was
   determined daily during a one-month field study, carried out during
   December 2003.
   PM concentration at the traffic station was considerably higher than at
   the urban background and semi-rural stations; elemental carbon was
   detected as one of the chemical components responsible for this
   increase. The difference in the concentration of sulphate and ammonium
   was negligible, as it was expected for secondary pollutants. A negative
   artefact in the determination of ammonium nitrate by means of heated
   automatic monitors was highlighted.
