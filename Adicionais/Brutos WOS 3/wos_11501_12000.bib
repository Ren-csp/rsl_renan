Title = {The improvement of cognitive function reflected by event-related
   potentials in drug-naive schizophrenia with atypical antipsycotics},
Booktitle = {UNVEILING THE MYSTERY OF THE BRAIN: NEUROPHYSIOLOGICAL INVESTIGATION OF
   THE BRAIN FUNCTION},
