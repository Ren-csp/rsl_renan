Note = {2nd International Yellow River Forum, Zhengzhou, PEOPLES R CHINA, OCT
   16-21, 2005},
Organization = {Yellow River Conservancy Commiss; Global Water Partnership; Asian Dev
   Bank; Royal Netherlands Embassy, Beijing; Challenge Program Water \&
   Food; China Int Ctr Econ \& Tech Exchange; USDA; CPWC; China Inst Water
   Resources \& Hydropower Res; Tsinghua Univ; Nanjing Hydeaul Res Inst;
   Yellow River Water \& Hydropower Dev Corp; World Bank; Int Ctr Econ \&
   Cooperat MWR},
Abstract = {The situation of ``the secondary suspended river{''} has become more
   severe since 1980's due to natural cause and improper interference by
   human beings on water resources, i.e. the channel elevation of the lower
   Yellow River is higher than that of its floodplain, and that is in turn
   higher than the ground of the river back, making the main channel
   greatly atrophied, flood water carrying capacity sharply reduced, all of
   which has deeply affected healthy life of the Yellow River. Starting
   with the ``production dyke{''} that created the secondary suspended
   river, its origin and harmfulness are analyzed in the paper, and such
   measures as to keep the present status, to dismantle the dykes gradually
   as planned, to trap sediment on floodplain, to regulate both water and
   sediment, etc. are put forward so that the worsening situation can be
   kept within limits, the conflict between people's extorting from nature
   and revenge by nature can be gradually alleviated for the realization of
   their harmonious existence at last.},
