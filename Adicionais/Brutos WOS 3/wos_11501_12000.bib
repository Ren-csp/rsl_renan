@inproceedings{ WOS:000258738000016,
Author = {Smith, D. H.},
Editor = {Liotta, PH and Mouat, DA and Kepner, WG and Lancaster, JM},
Title = {Poverty-environment linkages and their implications for security - With
   reference to Rwanda},
Booktitle = {ENVIRONMENTAL CHANGE AND HUMAN SECURITY: RECOGNIZING AND ACTING ON
   HAZARD IMPACTS},
Series = {Nato Science for Peace and Security Series C - Environmental Security},
Year = {2008},
Pages = {327-340},
Note = {NATO Advanced Research Workshop on Environmental Change and Human
   Security, Newport, RI, JUN 04-07, 2007},
Organization = {NATO},
Abstract = {In many parts of the world the degradation of natural resources is
   worsening while the social and economic conditions of people are not
   being improved. In some parts of the world, both poverty and
   environmental degradation are increasing. One reason for this is the
   perception held by some that the sustainable management of the
   environment and economic development are competing priorities.
   Consequently, national development strategies fail to Include the
   necessary actions and budgets to promote environmentally sustainable
   resource use. While there are specific cases were measures to end
   environmentally Unsustainable actions will restrict human use of
   environmental resources in the short term, over the long term
   environmentally Unsustainable natural resource use will reduce the
   social and economic benefits to humans provided by the environment.
   Thus, the environment should not be treated as a competitor but as the
   natural resource base of human social and economic development.. In some
   parts of the world, there are direct and Indirect links between
   environmental degradation, poverty, and security. This paper, which is
   aimed mainly at policy decision makers, outlines the links between
   environmentally sustainable use of natural resources and poverty
   reduction, With their implications for security It provides examples,
   especially from Rwanda, to illustrate the nature of these links. It then
   provides recommendations for environmentally and economically
   sustainable natural resource use that will also enhance human security.},
