Title = {Development of HSI models to evaluate risks to Riparian wildlife habitat
   from climate change and urban sprawl},
Booktitle = {LANDSCAPE ECOLOGY AND WILDLIFE HABITAT EVALUATION: CRITICAL INFORMATION
   FOR ECOLOGICAL RISK ASSESSMENT, LAND-USE MANAGEMENT ACTIVITIES, AND
   BIODIVERSITY ENHANCEMENT},
Series = {American Society for Testing and Materials Selected Technical Papers},
Year = {2004},
