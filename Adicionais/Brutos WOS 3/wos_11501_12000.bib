@article{ WOS:000250073200016,
Author = {Rendall, Drew and Vokey, John R. and Nemeth, Christie},
Title = {Lifting the curtain on the Wizard of Oz: Biased voice-based impressions
   of speaker size},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2007},
Volume = {33},
Number = {5},
Pages = {1208-1219},
Month = {OCT},
Note = {15th Annual Meeting of the
   Canadian-Society-for-Brain-Behaviour-and-Cognitive-Science, Montreal,
   CANADA, JUL, 2005},
Organization = {Canadian Soc Brain Behav \& Cognit Sci},
Abstract = {The consistent, but often wrong, impressions people form of the size of
   unseen speakers are not random but rather point to a consistent
   misattribution bias, one that the advertising, broadcasting, and
   entertainment industries also routinely exploit. The authors report 3
   experiments examining the perceptual basis of this bias. The results
   indicate that, under controlled experimental conditions, listeners can
   make relative size distinctions between male speakers using reliable
   cues carried in voice formant frequencies (resonant frequencies, or
   timbre) but that this ability can be perturbed by discordant voice
   fundamental frequency (F-0, or pitch) differences between speakers. The
   authors introduce 3 accounts for the perceptual pull that voice F-0 can
   exert on our routine (mis)attributions of speaker size and consider the
   role that voice F-0 plays in additional voice-based attributions that
   may or may not be reliable but that have clear size connotations.},
