Organization = {Amer Chem Soc, Div Chem Informat},
Abstract = {In 2003, the United States President's Emergency Plan For AIDS Relief
   (PEPFAR) was announced with the aim of bringing much-needed medications
   to the millions of people infected with human immunodeficiency virus
   (HIV) in resource-poor countries around the world. Over the years PEPFAR
   has been a great success. At the end of September, 2014, PEPFAR
   supported 7.7 million people on treatment. In this chapter 1 provide a
   brief history of PEPFAR and describe the role that the United States
   Food and Drug Administration (FDA) has played in the PEPFAR program. The
   way in which the FDA communicates its policy to manufacturers and other
   interested parties and modifies its expectations and requirements to
   deal with the changing nature of the problem are also examined.},
