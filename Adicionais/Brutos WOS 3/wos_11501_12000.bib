Title = {Biodiversity and health taken as the basic problems in GuiYang},
Booktitle = {PROCEEDINGS OF THE 3RD IASME/WSEAS INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: ENERGY AND ENVIRONMENT III},
Year = {2008},
Pages = {235+},
Note = {3rd IASME/WSEAS International Conference on Energy and Environment, Univ
   Cambridge, Cambridge, ENGLAND, FEB 23-25, 2008},
Organization = {IASME; WSEAS},
Abstract = {Any environmental problem is derived from two essential problems only:
   decreasing biodiversity or decreasing human health. For example, if the
   climate change would not reduce any of them, it would not be an
   environmental problem. However, changing energy supply and reducing
   energy consumption is a prominent environmental theme today, repressing
   the substantial environmental problems left in the long term. This
   article suggests to shift the emphasis to the essential problems looking
   for their solutions more directly. It discusses an example of
   recommendations to increase the local biodiversity of an urban extension
   in the municipality of GuiYang (China) to clarify that starting point.
   The core of the argument is urban population density.},
