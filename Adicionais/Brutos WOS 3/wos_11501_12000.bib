@inproceedings{ WOS:000325721700008,
Author = {Damery, D. and Webb, J. and Danylchuk, A. and Hoque, S.},
Editor = {Hernandez, S and Brebbia, CA},
Title = {Natural systems in building integrated aquaculture design},
Booktitle = {DESIGN AND NATURE VI: COMPARING DESIGN IN NATURE WITH SCIENCE AND
   ENGINEERING},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2012},
