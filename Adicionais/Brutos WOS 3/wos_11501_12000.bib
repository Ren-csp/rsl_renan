@inproceedings{ WOS:000083991000092,
Author = {Jacobson, MZ},
Editor = {Brebbia, CA and Jacobson, M and Power, H},
Title = {The effects of calcium and magnesium on size-distributed particulate
   nitrate and ammonium in an urban area},
Booktitle = {AIR POLLUTION VII},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {1999},
Volume = {6},
Pages = {955-959},
Note = {7th International Air Pollution Conference, STANFORD UNIV, STANFORD, CA,
   JUL 26-28, 1999},
Organization = {Wessex Inst Technol; Stanford Univ},
Abstract = {A chemical equilibrium code was applied to study the effects of calcium
   and magnesium on the size distribution of ammonium and nitrate. Such a
   study is important, because particle size and composition affect
   radiative properties of the atmosphere. The study was carried out with
   the chemical equilibrium code, EQUISOLV II. Predictions of gas and
   size-distributed aerosol components were first compared with data from
   an 8-stage Berner impactor at Long Beach and Riverside during the
   Southern California Air Quality Study. Base-case predictions of nitrate
   and ammonium matched observations well in most size bins of every case.
   A sensitivity test indicated that when Ca and Mg were removed from the
   calculations, coarse-mode nitrate decreased at Long Beach, as expected,
   to maintain charge balance. At Riverside, removing Ca and Mg had a large
   but opposite effect, increasing nitrate, shifting it from the
   accumulation mode. The reason is explained in terms of mean mixed
   activity coefficients. The result of the study was that, even in small
   concentrations, calcium and magnesium have relatively large effects on
   the size distribution of aerosols.},
