Title = {Utilization of a combined metabolic uncoupler to reduce sludge yield in
   sequence batch reactor system},
Booktitle = {ADVANCES IN ENVIRONMENTAL TECHNOLOGIES, PTS 1-6},
Series = {Advanced Materials Research},
Year = {2013},
Volume = {726-731},
