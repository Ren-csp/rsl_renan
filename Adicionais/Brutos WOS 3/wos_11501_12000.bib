@article{ WOS:000264091500010,
Author = {Sagarin, Brad J. and Cutler, Bert and Cutler, Nadine and Lawler-Sagarin,
   Kimberly A. and Matuszewich, Leslie},
Title = {Hormonal Changes and Couple Bonding in Consensual Sadomasochistic
   Activity},
Journal = {ARCHIVES OF SEXUAL BEHAVIOR},
Year = {2009},
Volume = {38},
