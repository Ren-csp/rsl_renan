@article{ WOS:000071699500043,
Author = {Berkowicz, R},
Title = {Modelling street canyon pollution: model requirements and expectations},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {1997},
Volume = {8},
Number = {3-6},
Pages = {609-619},
Note = {4th Workshop on Harmonization with Atmospheric Dispersion Modelling for
   Regulatory Purposes, OOSTENDE, BELGIUM, MAY 06-09, 1996},
Organization = {Initiat Harmonizat Atmospher Dispers Modelling Regulatory Purposes},
Abstract = {Dispersion of pollution from traffic in urban street canyons is governed
   by a complex wind flow structure, which hardly can be described by
   traditional Gaussian models. On the other hand, some simple rules can be
   used to provide rough estimates of pollution levels, especially
   considering the worst-case conditions. The model requirements will thus
   also depend on the particular application and the expectations attached
   to the information provided by the model. Models based on a very simple
   description of dispersion processes, but focusing more on
   parameterization of traffic emissions, are useful tools for traffic
   planners. More detailed studies of traffic pollution behaviour in street
   canyons require models that can relate the actual pollution
   concentrations to the actual meteorological conditions.},
