@inproceedings{ WOS:000084315100067,
Author = {Palmer, JA},
Editor = {Abrams, R},
Title = {Global issues in the minds of children},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
