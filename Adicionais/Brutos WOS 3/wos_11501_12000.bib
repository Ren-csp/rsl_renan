Title = {Changing identities: New roads, new city images},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1051-1058},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {Roads, in other words ``flowing spaces{''} not only constitute the
   central core of the patterns of the cities but they can also be accepted
   as one of the important actors in the processes of shaping the identity
   of the cities. In the process of integrating the new architectural-urban
   designs and infrastructure projects to the existing urban pattern of the
   cities, the biggest environmental problems take place in the cities with
   specific urban identities. Aim of this study is to discuss the effects
   of new transportation networks on the existing identity of the cities in
   the example of two specific urban environments from Turkey: Istanbul and
   Trabzon. Changing identities by these new interventions will be
   illustrated comparing the new cities with their past and the role of
   experts like architects, planners, engineers, etc., in design and
   construction process will be evaluated.},
