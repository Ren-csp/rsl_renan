@article{ WOS:A1991JE77600012,
Author = {FACCHINI, LA and WEIDERPASS, E and TOMASI, E},
Title = {THE WORKER MODEL AND PERCEPTION OF ENVIRONMENTAL AND OCCUPATIONAL RISKS
   - THE OPTIMAL USE OF A DESCRIPTIVE STUDY},
Journal = {REVISTA DE SAUDE PUBLICA},
Year = {1991},
Volume = {25},
Number = {5},
Pages = {394-400},
Month = {OCT},
Note = {1ST INTERNATIONAL SYMP ON ENVIRONMENTAL STUDIES OF TROPICAL RAIN
   FORESTS, MANAUS, BRAZIL, 1990},
Abstract = {An attempt was made to identify the risks resulting from exposure to the
   chemicals to which workers are exposed as well as from the poor working
   conditions to which they arc subject in a chemical and pharmaceutical
   factory. A descriptive study based on the ``workers model{''} - a
   methodological approach developed in Italy in the 60's, was carried out.
   Such a study requires direct contact with the workers and has the
   advantage of overcoming the difficulty of gaining access to their
   work-place. The activities of the different departments of the plant
   were reconstructed and the main chemicals used, the main physical
   complaints, the potencial harms and the main environmental risks
   identified. The report on the harmful working conditions produced was
   used by the workers as a means of pressing the authorities into carrying
   out an inspection of the plant concerned to verify its accuracy.  The
   report's findings have been confirmed and demonstrate the usefulness of
   the methocological approach adopted.  The workers' publicizing of the
   study's findings through the means of mass communication have helped to
   build up greater public awareness of the occupational and environmental
   risks of that particular industrial activity.},
