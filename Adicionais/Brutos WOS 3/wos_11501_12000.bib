
@inproceedings{ WOS:000173641300013,
Author = {Jaskiewicz, F and Russ, T},
Editor = {Easa, S and Samdahl, D},
Title = {Livability-based MOE's for LRT alignment selection},
Booktitle = {TRANSPORTATION, LAND USE, AND AIR QUALITY, CONFERENCE PROCEEDINGS:
   MAKING THE CONNECTION},
Year = {1998},
Pages = {115-124},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {The flexibility of light rail transit (LRT) supports significant
   opportunities to guide urban form. Unfortunately, the physical
   characteristics of LRT alignments often preclude the system's ability to
   actively influence development and redevelopment. This! paper outlines
   ways in which long-term livability-based measures of effectiveness
   (MOE's), such as pedestrian access, street network, urban design,
   density of activities, and populations served, have been integrated into
   the LRT alignment selection process: in Orlando, Florida.
   Typical approaches to selecting LRT alignments are generally based upon
   corridor-wide performance measures such as ridership, travel time,
   capital and operational costs, land use compatibility, and
   environmental, social, and! cultural impacts. Such traditional measures
   often fail to document long-term livability benefits. To remedy this,
   land use and urban design principles should lie given! greater
   consideration. This paper outlines evaluative criteria developed in
   Central Florida to determine an LRT alignment that supports a physical
   environment complementary to pedestrian-oriented development and
   redevelopment.
   Two conceptual alignments dominated Orlando's Design, Concept
   Resolution: an Interstate 4 median alignment and a CSX rail corridor
   alignment. Tile alignment evaluation process balanced traditional
   corridor-based performance standards with station area livability-based
   standards. Many traditional corridor-based variables, such as travel
   time and operational costs, favored the 1-4 median alignment, but were
   overshadowed in places by a set of livability-based measures that
   strongly supported the CSX corridor. The results of this analysis served
   to unify Central Florida's political bodies and elevate Orlando's status
   for ``new start{''} funding.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
