   Schernewski, Gerald/0000-0002-4036-7646},
Funding-Acknowledgement = {BONUS BaltCoast project; BONUS from the European Union's Seventh
   Programme for research, technological development and demonstration
   {[}185]; Baltic Sea national funding institutions},
Funding-Text = {The work was part-funded by the BONUS BaltCoast project. BONUS BaltCoast
   has received funding from BONUS (Art 185) funded jointly from the
