Pages = {268-270},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {This paper reports some of the: findings of a substantial international
   project entitled `Emergent Environmentalism', concerned with the
   development of people's environmental awareness and concern. It focuses
   on aspects of the project designed to add original dimensions to the
   body of existing research on the nature of children's early knowledge
   and awareness of their physical and biological environments. Examples
   are given to illustrate a range of outcomes generated by data derived
   from interviews with four and six year old children; and these are
   followed by a summary of key points that have emerged from data
   analysis.},
