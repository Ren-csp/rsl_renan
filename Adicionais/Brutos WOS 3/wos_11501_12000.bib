@article{ WOS:000445110200009,
Author = {Osman, Mariana Mohamed and Zainudin, Farah Eleena and Rabe, Noor
   Suzilawati},
Title = {Perception of Residents in the State of Selangor on Affordable Housing
   Price with the Expected Criteria},
