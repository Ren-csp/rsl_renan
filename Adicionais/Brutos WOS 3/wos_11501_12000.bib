Month = {NOV},
Note = {3rd International Conference on Education (ICOED), Melaka, MALAYSIA, NOV
   07-09, 2017},
Organization = {Malaysian Tech Scientist Assoc},
Abstract = {The study investigated the effects of teaching Malaysian University
   English Test (MUET) through a prototype speaking game to a group of
   students in one of the polytechnics in Malaysia. Twenty-nine students
   were selected by purposive sampling as an experimental group. The
   experiment was conducted during the second semester of the academic year
   2017. The research instruments consisted of a questionnaire and
   interview. This prototype consists of six quests each with six questions
   aligned with the MUET syllabus for speaking. Six lesson plans were
   developed and employed to teach six different themes determined by the
   MUET syllabus in the prototype. The findings showed that students had
   significantly improved in, vocabulary use to interact and communicate.
   The findings suggest that the prototype speaking game is very beneficial
   for students in improving their communication skills, motivation,
   confidence and also word acquisition.},
