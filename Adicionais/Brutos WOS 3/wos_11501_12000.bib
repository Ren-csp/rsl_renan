@article{ WOS:000444996500106,
Author = {El-Nafaty, Abbas Sa'id and Ahmad, Mohd Hamdan and Hamid, Malsiah},
Title = {Perspectives on Naturally Ventilated Library (NVL) Buildings in Nigeria},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4312-4317},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {The Naturally Ventilated Library (NVL) building, refers to library
   building that relies on natural wind flow for its ventilation. Academic
   library buildings are typically an integral part of the campus landscape
   as old as the institution, providing the first avenue for student
   interaction and knowledge pursuits in their quest for academic
   excellence. The cognitive perception of the users' of NVL buildings is
   influenced by the indoor environmental performance of the library
   building. Excessive use of air-conditioning to deal with Poor
   ventilation has led to high energy consumption, poor indoor air quality,
   and greenhouse gas (GHG) emissions. The first library building in
   Nigeria designed with natural ventilation (NV) was established in 1948
   at the University of Ibadan. However, subsequent library buildings
   designed to operate with air-conditioning have failed due to the
   inadequate power supply and poor maintenance. Natural ventilation
   provides a reliable source of ventilation in Nigerian library buildings.
   This paper seeks to present perspectives on the deployment of NV in the
   design of Nigerian academic library buildings with a focus on university
   library buildings. The findings showed that there is limited research on
   NV and its impact on indoor environmental quality, Users' satisfaction
   and energy efficiency in Nigerian library buildings and Sub-Saharan
   Africa at large where the problem exists. The potential of natural
   ventilation for enhancing thermal comfort, indoor air quality and energy
   efficiency in university library buildings was reviewed and
   recommendations are highlighted.},
