@inproceedings{ WOS:000229424900087,
Author = {Zhukovsky, M and Termechikova, R},
Editor = {McLaughlin, JP and Simopoulos, SE and Steinhausler, F},
Title = {Exposure to radon in the northern part of the Republic of Kyrgyzstan},
Booktitle = {Natural Radiation Environment VII},
Series = {RADIOACTIVITY IN THE ENVIRONMENT},
Year = {2005},
Volume = {7},
Pages = {706-714},
Note = {7th International Symposium on the Natural Radiation Environment
   (NRE-VII), Rhodes, GREECE, MAY 20-24, 2002},
Organization = {US EPA},
Abstract = {Indoor radon levels in the Issyk-Kul region of the Republic of
   Kyrgyzstan are investigated in detail for the first time. The average
   winter and summer radon concentrations were 270 and 180 Bq m(-3),
   respectively; the winter to summer ratio was calculated to 1.5. There is
   no statistically significant correlation between winter and summer Rn
   concentration values in dwellings. The influence of building type (rural
   or urban) or wall materials on the radon concentration was negligible.
   Considerable thoron (Rn-220) decay product equivalent equilibrium
   concentrations (EEC) were observed (average values 5.9 and 15 Bq m(-3)
   for urban and rural dwellings, respectively). An assumption of the
   dominant role of the diffusion process in radon and thoron entry into
   dwellings was invoked.},
