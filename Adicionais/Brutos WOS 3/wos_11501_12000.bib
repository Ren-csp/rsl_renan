@inproceedings{ WOS:001672900200041,
Author = {Favoreti, Ana Laura Fragoso and Albuquerque, Jose Wellington and
   Rodrigues, Bruno Noronha and Canteras, Felippe Benavente and Molina
   Junior, Vitor Eduardo},
Editor = {Ferreira, P and Dall'Orsoletta, A and Jorio, M and Santos, AL},
Title = {THE IMPACT OF LAND COVER ON SURFACE TEMPERATURE REGULATING SERVICE
   PROVIDED BY GREEN INFRASTRUCTURE: A CASE STUDY IN CAMPINAS, BRAZIL},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2024},
Pages = {280-286},
Note = {2024 International Conference on Energy and Environment-ICEE-Bringing
   together Engineering and Economics, Guimaraes, PORTUGAL, JUN 06-07, 2024},
Abstract = {Urban sprawl has led to a reduction in the capacity of urban ecosystems
   to provide essential services. Ecosystems influence climate regulation,
   with changes in land cover significantly impacting local temperatures.
   In this context, the vulnerability of urban spaces to anthropogenic
   impacts lacks sustainable planning alternatives, making green
   infrastructures (GI) practical strategies for mitigating adverse effects
   on ecosystem services (ES). However, a literature gap exists due to a
   scarcity of studies relating land use and land cover (LULC) to land
   surface temperature (LST), especially in the Brazilian scenario. The
   analysis explores how temperature regulation services provided by green
   infrastructure behave in the urban microclimate in the municipality of
   Campinas, State of Sao Paulo, Brazil, due to the economic and
   technological significance, serving as a hub of knowledge and
   innovation. A multidisciplinary approach was employed to analyze this
   relationship, combining remote sensing techniques and spatial modeling
   in Geographic Information Systems (GIS). Satellite images from Landsat-8
   OLI/TIRS were used to calculate NDVI (Normalized Difference Vegetation
   Index) and LST through spectral emissivity. Additionally, a municipal
   dataset for land cover classification was considered. It identified the
   most relevant green or permeable areas with different uses based on
   their dimensions visible in orbital images and through urban planning
   legislation. Seasonal variations in LST were observed, with significant
   changes between cold and hot periods. The analysis revealed a
   relationship between NDVI and LST, indicating cooling in areas with
   increased vegetation cover and hot in urban or deforested regions. The
   results highlight the potential importance of GI in mitigating LST.},
