@article{ WOS:A1992KB95600016,
Author = {LUKKES, P},
Title = {EUROPE 1992, PART OF A PROCESS},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1992},
Volume = {22},
Number = {2-4},
Pages = {269-278},
Month = {NOV},
Note = {EUROPEAN URBANIZATION CONF, UNIV AKRON, AKRON, OH, APR 15-17, 1990},
Organization = {UNIV AKRON, DEPT GEOG \& PLANNING},
Abstract = {`Europe 1992' is no more than one, although important, component of the
   rapid economic and political changes that take place in this part of the
   world. Therefore, overemphasizing its impact should be avoided. Perhaps
   the switch from EEC to EC is indicative for a shrinking importance of
   the Europe-of-the-twelve for the principal economic actors. Many of
   those actors now operate in a world-wide action space. So, in a sense,
   the EC is a passed station. Diminishing the importance of tax and other
   administrative barriers opens as it were the door to far more attention
   for cultural, linguistic, ethnic and other regional-based
   division-lines. So it is presumably correct to state that Europe is
   becoming both more united and more fragmented at the same time.},
