@inproceedings{ WOS:000084731400003,
Author = {Elliott, MA and Müller, HJ},
Editor = {Killeen, PR and Uttal, WR},
Title = {On the role of 40-Hz, and evidence of faster-frequency, oscillations
   during visual-object perception},
Booktitle = {FECHNER DAY 99: THE END OF 20TH CENTURY PSYCHOPHYSICS, PROCEEDINGS},
Year = {1999},
Pages = {13-18},
Note = {15th Annual Meeting of the International-Society-for-Psychophysics,
   ARIZONA STATE UNIV, TEMPE, AZ, OCT 21-24, 1999},
Organization = {Int Soc Psychophys; Arizona State Univ, Coll Engn \& Appl Sci; Arizona
   State Univ, Coll Liberal Arts \& Sci; Arizona State Univ, Dept Psychol},
Abstract = {Neurophysiological studies have indicated that the synchronization of
   spatially distributed neuronal assemblies at fast frequencies in the
   range 20 - 80 Hz (the `gamma' band) is instrumental for binding the
   separate feature-elements of a figure or object. In agreement with this
   hypothesis, we have shown that reaction times (RTs) to a display matrix
   containing a target Kanizsa square (an illusory square consisting of
   grouping 90 degrees corner junctions) are expedited when the target is
   preceded at its location by four simultaneous crosses within a matrix of
   premask crosses, but only if the premask display flickers in the
   mid-gamma band (i.e., 33 - 47 Hz; Elliott \& Muller, 1998). The
   operation of 40-Hz process during perceptual coding was demonstrated by
   a subsequent experiment in which RTs were found to be sensitive to the
   phase relationship between the offset of the flickering premask display
   relative to the onset of the target display: RT enhancements were
   maximal when the target was presented out-of-phase with the 40-Hz
   structure of the premask flicker. Having established the validity of the
   method, a series of recent experiments are discussed, which reveal the
   presence of a fast 220 - 240-Hz rhythm as instrumental in generating the
   synchronicity priming effects at between 33 and 47 Hz. The presence of
   the fast frequency suggests that lon level sensory coding operations may
   result from the interaction of gamma and very fast brain frequencies,
   with the processes responsible for `neural binding' primarily active at
   frequencies corresponding to the maximum resolution of sensory systems.},
Publisher = {ARIZONA STAT UNIV, DEPT PSYCHOLOGY},
Address = {TEMPE, AZ 85287 USA},
