Pages = {349-354},
Note = {14th International AIDS Conference, BARCELONA, SPAIN, JUL 07-12, 2002},
Organization = {Univ N Carolina; Gen Clin Res Ctr; UNC Ctr AIDS Res; Natl Inst Hlth;
   Swiss Natl AIDS Res Program; Bristol-Myers Squibb Co; Boehringer
   Ingelheim; GlaxoWellcome Res \& Dev, HIV Antiviral Res},
Abstract = {The HIV/AIDS epidemic needs constantly to be reanalyzed under subjective
   conditions. The increasing popularity of heating rituals in Malawi
   collectively represents the metaphorical malcontent of this catastrophic
   event. Beliefs are no more reflections of transcendent ``tradition{''}
   than transformations of meaningfulness of mundane life. This is an
   innovative moral justification for normalizing human misery. However,
   the deterministic objectification by Western reductionism. blunders in
   to articulate the multi-faceted nature of the epidemic. Thus,
   international public health should be accountable for promoting a
   fruitful future for African people by reading the cultural, structural
   and symbolic contexts of the HIV/ AIDS epidemic.},
