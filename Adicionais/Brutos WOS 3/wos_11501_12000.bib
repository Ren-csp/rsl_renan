@inproceedings{ WOS:000077948300003,
Author = {Zielinski, K},
Editor = {Neugebauer, A},
Title = {Konorski's concept of brain associations},
Booktitle = {MACROMOLECULAR INTERPLAY IN BRAIN ASSOCIATIVE MECHANISMS},
Series = {SERIES ON BIOPHYSICS AND BIOCYBERNETICS},
Year = {1998},
Volume = {4},
Pages = {53-62},
Note = {International School of Biocybernetics - Macromolecular Interplay in
   Brain Associative Mechanisms, NAPLES, ITALY, OCT 16-21, 1995},
Abstract = {Jerry Konorski (1903-1973), prominent Polish neurophysiologist and
   psychologist. contributed significantly to the contemporary theory of
   associative learning through conditioning, as well as to the
   understanding of complex brain mechanisms of perception, memory,
   motivation and emotion. Jerzy Konorski and Stefan Miller distinguished
   in 1928 instrumental conditioned reflexes as a separate type of acquired
   behavior, different from classical (Pavlovian) conditioned reflexes. In
   a series of pioneer studies they demonstrated basic differences between
   the two types of conditioned reflexes. After the second world war
   Konorski reinterpreted the results of research on conditioned reflexes
   on the basis of the mechanisms of Sherringtonian neurophysiology Owing
   to his work ``Conditioned reflexes and neuron organization{''} published
   in 1948 Konorski became one of the founders of the contemporary
   neurophysiology. With his coworkers he developed modern concepts
   concerning complex interactions of various classes of behaviors: innate
   and acquired, driven by opposite motivations, elicited by cues
   signalling different contingencies. In the book ``Integrative activity
   of the brain{''} (1967) Konorski analyzed brain as a complex system
   directing the functioning of the organism as a whole.},
