   system},
Booktitle = {PROCEEDINGS OF THE 1996 SOCIETY OF AMERICAN FORESTERS CONVENTION:
   DIVERSE FORESTS, ABUNDANT OPPORTUNITIES, AND EVOLVING REALITIES},
Year = {1996},
Pages = {122-127},
Note = {1996 National Convention of the Society-of-American-Foresters,
   ALBUQUERQUE, NM, NOV 09-13, 1996},
Organization = {Soc Amer Foresters},
Abstract = {The objective of this paper is to chronicle the development and
   potential of an agroforestry decision support system for the United
   States family farm to assess the physical and financial consequences of
   an agroforestry system of choice. The model is a stand alone Windows
   application and allows output to be saved in spreadsheet format for
   further analysis as deemed necessary by the user. It is capable of
   handling a wide range of crop types and management options including
   multiple understory profiles. It requires five categorical inputs: farm
   accounts, planting and felling areas, labor costs, tree yield tables,
   and understory profiles. The model presents to be a very valuable
   planning tool for family farms whose goals are to enhance profitability
   and sustainability. Model outputs, based on a 200 acre farm, are
   presented for illustration purposes.},
