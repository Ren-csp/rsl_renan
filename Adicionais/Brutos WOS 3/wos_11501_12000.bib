@inproceedings{ WOS:000769651300022,
Author = {Nissen, Anika and Riedl, Rene},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB and MullerPutz, G},
Title = {Design Mode, Color, and Button Shape: A Pilot Study on the Neural
   Effects of Website Perception},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE (NEUROIS RETREAT 2021)},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2021},
Volume = {52},
Pages = {192-203},
Note = {13th Annual NeuroIS Retreat Conference (NeuroIS Retreat), ELECTR
   NETWORK, JUN 01-03, 2021},
Organization = {Raiffeisen Software; GRZ; Brain Prod; Noldus Informat Technol},
Abstract = {The investigation of website aesthetics has a long history and has
   already been addressed in NeurolS research. The extant literature
   predominantly studied website complexity, symmetry, and colors. However,
   other design factors have not yet been examined so far. We studied two
   new factors (design mode: light vs. dark, button shape: rounded vs.
   sharp angled) along with color (blue vs. red). Specifically, we examined
   the impact of these three factors on several outcomes. Results from a
   repeated-measures MANOVA indicate: (i) design mode (light vs. dark)
   significantly affects users' pleasure, arousal, trust, attitude, and use
   intention, (ii) color (blue vs. red) significantly influences pleasure,
   arousal, and use intentions, while (iii) button shape (rounded vs.
   sharp) does not significantly influence any of the dependent measures.
   Based on these results, follow up functional near-infrared spectroscopy
   studies are developed which aim to further complement our self-report
   findings.},
