Title = {Electrical resistivity tomography contribution to the characterization
   of underground cavities in the region of Safi, Morocco},
Booktitle = {SEVENTH INTERNATIONAL CONGRESS WATER, WASTE AND ENVIRONMENT (EDE7-2019)},
Series = {E3S Web of Conferences},
