   approach},
Booktitle = {DESERTIFICATION IN THE THIRD MILLENNIUM},
Year = {2003},
Pages = {361-364},
Note = {Desertification Conference Toward Better Management of Arid and
   Semi-Arid Lands in the 21st Century, DUBAI, U ARAB EMIRATES, FEB 12-16,
   2000},
Organization = {Zayed Prize Fdn},
Abstract = {The area of Sudan natural forests has declined from about 40\% of its
   total area up to the late sixties to about 12\%, at present due to over
   grazing, agricultural expansion, wood-fuel production and forest fires.
   Natural forest reserves in Sudan have remained as isolated protected
   forests without management planning and sustained production. Stocking
   density of trees annually declines due to illicit felling and intensive
   grazing. An approach for the development and sustainable management of
   these dry land forest reserves based on local people participation in an
   integrated forest - agriculture management system, is an ongoing
   experience in selected reserves. The management system on basis of
   participatory approach considers crop production and tree planting and
   protection by the local people.},
