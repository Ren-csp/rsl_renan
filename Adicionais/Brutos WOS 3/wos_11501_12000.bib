@article{ WOS:000180041900007,
Author = {Vicario, DS and Raksin, JN and Naqvi, NH and Thande, N and Simpson, HB},
Title = {The relationship between perception and production in songbird vocal
   imitation: what learned calls can teach us},
Journal = {JOURNAL OF COMPARATIVE PHYSIOLOGY A-NEUROETHOLOGY SENSORY NEURAL AND
   BEHAVIORAL PHYSIOLOGY},
Year = {2002},
Volume = {188},
