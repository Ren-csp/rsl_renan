@inproceedings{ WOS:000237753600013,
Author = {Ancarani, A. and Santamaria, A. and Vagliasindi, F. G. A.},
Editor = {Lekkas, TD},
Title = {Identification of a set of indicators for analysing performances in
   solid waste service sector},
Booktitle = {Proceedings of the 9th International Conference on Environmental Science
   and Technology, Vol A - Oral Presentations, Pts A and B},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {A84-A92},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {Performance assessment of urban infrastructure services, aiming at
   rating the global efficiency in integrated and quantifiable terms, is
   becoming a major issue worldwide, and particularly in Europe. To assess
   the performance of a utility system it is necessary to make an
   integrated analysis of a variety of factors and the existing
   relationships between these factors often form a very complex puzzle.
   Indicators are often used in conjunction with other types of information
   (system characteristics, environmental factors, etc.). On the one hand,
   integrated performance assessment tools are needed to cope with the
   increasing complexity of the utility management and the need for
   creative approaches. On the other hand, these tools allow for efficient
   and effective communication between the various levels of the utility
   internal hierarchy. Regulators, self-regulating bodies and other
   authorities with the increasing participation of the private sector in
   the water industry, the traditional management role of public
   authorities moves to a new regulatory role. In fact the establishment of
   effective regulation mechanisms is a major challenge in many European
   countries. Moreover, existing self-management and self-regulation
   systems based on the division of responsibilities between legislative
   and supervising authority and the solid waste industry, will also
   benefit from powerful performance assessment and decision support tools.
   Conversely, policy makers are also potential users of more effective
   performance assessment tools. Financing bodies can benefit from
   assistance in assessing investment priorities, project selection and
   follow-up. Customers and the public in general, need an effective
   performance assessment methodology that provides the means of
   translating complex processes into simple-to-understand information and
   of transmitting a measure of the quality of service provided. Scientist
   and professionals involved in integrated solid waste management and
   infrastructures, have shown their interest for this type of approach.
   However, very little has been accomplished so far in the scope of
   performance assessment measures. With reference the above mentioned
   general context an international research group is working on the
   definition of a set of indicators for the solid waste service within the
   Cost Action C18 funded by European Commission. Such an Action has the
   objective to contribute positively-regarding performance assessment-to
   the EU waste management policy within the 6(th) FP, where research is
   orientated towards the subject of `Forecasting and developing innovative
   policies for sustainability in the medium and long term'.
   The paper reports on the use of performance indicators in Italy.},
