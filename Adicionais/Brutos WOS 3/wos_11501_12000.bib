@inproceedings{ WOS:000337300500150,
Author = {Chen, Kuen-Meau},
Editor = {Meen, TH and Prior, SD and Lam, ADKT},
Title = {The comparison of exploring realism between various model types on car
   styling design},
Booktitle = {INNOVATION, COMMUNICATION AND ENGINEERING},
Year = {2014},
Pages = {615-618},
Note = {2nd International Conference on Innovation, Communication and
   Engineering (ICICE), Qingdao, PEOPLES R CHINA, OCT 26-NOV 01, 2013},
Organization = {China Univ Petr; Taiwanese Inst Knowledge Innovat},
Abstract = {This study compares the differences in degrees of realism between
   physical models and virtual prototypes of automobiles. Using a number of
   rendering engines from the latest virtual-reality toolkit, we conducted
   experiments to investigate the perception of realism with respect to six
   attributes: form, lighting/shading, details, color, material, and
   overall effect. We further found that the full-size virtual models and
   the scaled virtual models, both rendered offline using global
   illumination (FVP-VRay) were the most realistic. In showing realism,
   scaled physical model (SPM) is superior to real-time, full-size virtual
   prototypes. We therefore understand that people are inclined to viewing
   real things when doing visual evaluation. Offline virtual prototypes, in
   both full-size and scaled presentations, look the most realistic for all
   attributes. In other words, only after the real-time virtual prototypes
   attain the visual effect of the offline ones, the real-time prototypes
   can be used in car styling design. Thus, being able to view form
   features in full size appears to be important in perceiving objects'
   forms. With respect to lighting and shadow as well as color and material
   attributes, scaled physical models conveyed higher degree of realism
   than full-scale or scaled virtual prototypes. In terms of details
   attributes, full-scale virtual prototypes provided better realism than
   scaled virtual prototypes, but not significantly better than scaled
   physical models. For realism attributes, scaled physical models conveyed
   the highest degree of realism, followed by full-scale virtual
   prototypes, and then scaled virtual prototypes.},
Publisher = {CRC PRESS-TAYLOR \& FRANCIS GROUP},
