Title = {Assessment of Yard Waste For Biological Treatment In The Mehran UET,
   Jamshoro},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON ENERGY, ENVIRONMENT AND SUSTAINABLE
   DEVELOPMENT (EESD-2018)},
