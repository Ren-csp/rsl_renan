@article{ WOS:000226585400002,
Author = {Plaks, JE and Grant, H and Dweck, CS},
Title = {Violations of implicit theories and the sense of prediction and control:
   Implications for motivated person perception},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {2005},
Volume = {88},
Number = {2},
Pages = {245-262},
