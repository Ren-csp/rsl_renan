Title = {The use of treated effluent for agricultural irrigation: Current status
   in the Bottelary catchment (South Africa)},
Booktitle = {SUSTAINABLE IRRIGATION MANAGEMENT, TECHNOLOGIES AND POLICIES II},
Series = {WIT TRANSACTIONS ON ECOLOGY AND THE ENVIRONMENT},
Year = {2008},
Volume = {112},
