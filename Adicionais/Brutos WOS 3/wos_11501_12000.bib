Title = {Sustainability actions in Mediterranean countries through cooperation
   partnerships: the case of the project PAMLED},
Booktitle = {ENVIRONMENTAL ECONOMICS AND INVESTMENT ASSESSMENT III},
Series = {WIT Transactions on Ecology and the Environment},
Year = {2010},
Volume = {131},
