@inproceedings{ WOS:000349062300157,
Author = {Djuric, Jelena and Mitkovic, Petar},
Book-Group-Author = {SGEM},
Title = {WASTE MANAGEMENT IN SERBIA - STRATEGIES, LEGISLATIVE FRAMEWORK AND
   PRACTICE},
Booktitle = {GEOCONFERENCE ON ECOLOGY, ECONOMICS, EDUCATION AND LEGISLATION, SGEM
   2013, VOL I},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {1195+},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {Inadequate waste management is one of the most significant problems in
   terms of environmental protection and a serious threat to the natural
   environment including: soil, air, water and wildlife. In the Republic of
   Serbia only about 60\% of municipal waste is being collected. Waste
   collection is organized mainly in urban areas while rural areas are
   poorly covered or totally excluded from the system of organized waste
   collection, thus the appearance of wild dumpsites in rural areas is
   inevitable. The previous practice of waste management in the Republic of
   Serbia mainly included unsanitary landfilling (wild dumps) without prior
   treatment and necessary environment protection measures, which is the
   worst option of waste treatment. Most of municipal landfills are sites
   that were not anticipated by spatial planning documents and for which no
   environmental impact assessment studies were done. In order to improve
   the current situation, in recent years, Serbia adopted two national
   waste management strategies, as well as new laws and regulations on
   waste management. Strategy issues guidelines for the regional waste
   management, sets short and long term objectives, identifies the
   responsibilities for waste, establishes measures and actions for
   achieving the set goals, etc. Although the first strategy was adopted in
   2003, the state of waste management has not changed significantly until
   now.
   The paper discusses the strategic framework and legislation on waste
   management in Serbia. It also discusses the current state and key
   problems in implementation of strategies and laws, as well as
   opportunities to overcome the existing problems.},
