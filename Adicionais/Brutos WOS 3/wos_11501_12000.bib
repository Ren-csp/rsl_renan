@inproceedings{ WOS:000226787100008,
Author = {Cunha, LM and De Moura, AP},
Editor = {Filho, WL},
Title = {Conflicting demands of agricultural production and environmental
   conservation: consumers' perception of the quality and safety of food},
Booktitle = {ECOLOGICAL AGRICULTURE AND RURAL DEVELOPMENT IN CENTRAL AND EASTERN
   EUROPEAN COUNTRIES},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SUB-SERIES 4, SCIENCE AND
   TECHNOLOGY POLICY},
Year = {2004},
Volume = {44},
Pages = {137-157},
Note = {NATO Advanced Training Meeting on Ecological Agriculture and Rural
   Development in Central and Eastern European Countries, Hamburg, GERMANY,
   DEC 01-03, 2003},
Abstract = {Consumer studies in industrialised countries document widespread concern
   about and distrust of food products and of production methods in
   agriculture and in the food industry. These attitudes tend to be
   reinforced by the absence of face-to-face contact between buyers and
   sellers during the process of food selection, leaving the burden of
   assessing product quality entirely in consumers' hands. Both
   sociological and psychological studies indicate that shopping under
   these circumstances is a stressful activity, while the lack of trust in
   agricultural and industrial methods of production and food quality gives
   rise to feelings of uncertainty and insecurity. In this context,
   consumers perceive organic products as one way to reduce this anxiety.
   For this reason, consumer behaviour related to organic foods will be
   examined in some detail in this paper. This work points up a direct
   confrontation between European policy and legislation regarding
   agricultural production and environmental conservation related to
   organic products, and the way consumers perceive organic product quality
   and safety.},
