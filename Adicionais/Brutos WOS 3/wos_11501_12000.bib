Pages = {429-433},
Note = {10th International Congress on Senology - Breast Diseases of the
   Senologic-International-Society, OPORTO, PORTUGAL, MAY 31-JUN 04, 1998},
Organization = {Senol Int Soc},
Abstract = {Retraoreolar cysts of the young girl, developped at the expense of the
   accessory glands of Montgomery, constitute a frequent, but not well
   known, pathology. Clinically, the affection is revealed by an abscess, a
   lump or an areolar discharge. The ultrasound displays one or several
   superficial cysts that frequently contain microcalcifications.
   Staphylococcus aureus superinfections are frequent. The natural outcome
   is good and the pathology never affects the adult female.},
