Title = {ECO-INDUSTRIAL PLANNING MODEL: ``APEA CARPINELLO{''} FORLI},
Booktitle = {CESB 10: CENTRAL EUROPE TOWARDS SUSTAINABLE BUILDING - FROM THEORY TO
   PRACTICE},
Year = {2010},
Pages = {359+},
Note = {Conference on Central Europe towards Sustainable Building, Prague, CZECH
   REPUBLIC, JUN, 2010},
Organization = {Czech Techn Univ; CIDEAS; Czech Sustainable Building Soc; iiSBE; UNEP
   SBSI; CIB},
Abstract = {The ``Aree Produttive Ecologicamente Attrezzate{''}, APEA
   (Ecologically-equipped production areas) are intended to reduce their
   environmental impact and their consumption of resources for industrial
   production to a minimum. The ecological and environmental development of
   APEA areas are accompanied by a growth in the competitiveness of the
   production system, offering the companies which locate here economies of
   scale, jointly-use. infrastructure and services, shared environmental
   management and a reduction in the consumption of water and energy.
   The innovative project at Carpinello (Forli) envisages a Master Plan for
   the new expansion area on 300 he, involving important town-planning and
   environmental choices. Amongst which: the heliocentric orientation of
   the urban plant based on the texture of the roman ``Centurie{''} still
   existing in this local context; a centralized heating plant, operating
   through cogeneration with a geothermal electrical plant and a district
   heating network; buildings possessing high energy efficiency and
   designed for the installation of PV panels; recovery and valorization of
   the natural ecosystem inside a system of bioclimatic corridors and
   gardens, aimed at increasing the quality of the open space and
   contributing to the development of the local ecological network; the
   revitalization of a water course adjacent to the area; the ``soft{''}
   mobility system based on a limited use of the private car and
   circulation of truck and a hierarchical division of the internal routes;
   the active connection with the local socio-economic context (the
   settlement is open to the local community and give public services to
   the workers and inhabitants).},
