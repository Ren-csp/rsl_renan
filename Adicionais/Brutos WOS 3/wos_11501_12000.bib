Title = {Educating teachers in an ecological emergency zone: Niznhii Tagil,
   Russia},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {107-109},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {This paper reports on the authors' work with the Institute for
   Sustainable Communities in Montpelier Vermont and with the Institute
   Pedagogica and City Schools in Nizhni Tagil, Russia. A city of nearly
   half a million people, Niznhii Tagil is deep in the industrial heartland
   of the former Soviet Union. The city is studded with smokestacks and
   besieged with pollution. The local health service says it has the
   highest rate of lung and stomach cancers in the Russian Federation. Only
   four percent of the community's children are considered healthy. The
   project conducted several teacher workshops which helped participants
   develop a new course for teacher training at the Institute Pedagogica
   and the testing of new environmental education curricula at local
   schools. The program helped teachers, those who train teachers, and
   members of the community discover how they can cultivate in young people
   the awareness, knowledge, and skills they need to value and understand
   nature, and to become lifelong environmental stewards.},
