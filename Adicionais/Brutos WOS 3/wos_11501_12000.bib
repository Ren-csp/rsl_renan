@article{ WOS:000270643100010,
Author = {Kleanthous, Savvas and Bari, Md. Aynul and Baumbach, Guenter and
   Sarachage-Ruiz, Leire},
Title = {Influence of particulate matter on the air quality situation in a
   mediterranean island},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2009},
Volume = {43},
Number = {31, SI},
Pages = {4745-4753},
