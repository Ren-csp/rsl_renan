@inproceedings{ WOS:000223015300015,
Author = {Gentner, TQ},
Editor = {Zeigler, HP and Marler, P},
Title = {Neural systems for individual song recognition in adult birds},
Booktitle = {BEHAVIORAL NEUROBIOLOGY OF BIRDSONG},
