@article{ WOS:A1997XV00900004,
Author = {Baugh, SG and Graen, GB},
Title = {Effects of team gender and racial composition on perceptions of team
   performance in cross-functional teams},
Journal = {GROUP \& ORGANIZATION MANAGEMENT},
Year = {1997},
Volume = {22},
Number = {3},
Pages = {366-383},
Month = {SEP},
Note = {Annual Meeting of the Southern-Management-Association, ATLANTA, GA, NOV,
   1993},
Organization = {So Management Assoc},
Abstract = {Research on team gender and racial composition with respect to team
   effectiveness is reviewed. Published literature shows a dearth of
   studies on this issue in work organizations. The studies published
   suggest that teams with even slight variability on gender and race will
   be less positively evaluated. These suggestions ate tested in a field
   setting, using 31 teams in a medium-sized state regulatory agency that
   were rated by team members and outside raters. Results showed that
   members of cross-functional project teams that vary with respect to
   gender or racial composition rate their team as less effective than
   members of homogeneous (all-male or all-White) teams. Ratings of
   external evaluators show no differences based on team composition.
   Antecedents and effects of these evaluations on female and minority team
   members are discussed.},
Publisher = {SAGE PUBLICATIONS INC},
