Title = {Exploring the Influence of Personality Traits on Affective Customer
   Experiences in Retailing: Combination of Heart Rate Variability (HRV)
   and Self-report Measures},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE (NEUROIS RETREAT 2021)},
