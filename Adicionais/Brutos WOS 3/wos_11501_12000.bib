@inproceedings{ WOS:000269054400004,
Author = {Frank, Kevin W.},
Editor = {Nett, MT and Carroll, MJ and Horgan, BP and Petrovic, AM},
Title = {Nitrogen Fate in a Mature Kentucky Bluegrass Turf},
