@article{ WOS:000076060700022,
Author = {Laible, DJ and Thompson, RA},
Title = {Attachment and emotional understanding in preschool children},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {1998},
Volume = {34},
Number = {5},
Pages = {1038-1045},
Month = {SEP},
Note = {Biennial Meeting of the Society-for-Research-in-Child-Development,
   WASHINGTON, DC, APR 03-06, 1997},
Organization = {Soc Res Child Dev},
Abstract = {This study was designed to elucidate the association between attachment
   and emotional understanding In preschool children. Forty children
   between the ages of 2.5 and 6 years and their mothers participated in
   the study. Mothers completed the Attachment Q-set, and children took
   part at their preschools in both an affective perspective-taking task
   and a series of interviews concerning naturally occurring incidents of
   emotions. Overall, age and attachment security predicted a child's
   aggregate score on the emotional understanding tasks. However, when the
   score was separated by the valence of the emotion, attachment security
   and age predicted a child's score for only those emotions with a
   negative valence (e.g., sadness) and not for those emotions with a
   positive valence (e.g., happiness). Thus, a secure attachment
   relationship seems to be important in fostering a child's understanding
   of emotion, primarily negative emotions.},
