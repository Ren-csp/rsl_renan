@inproceedings{ WOS:A1995BJ03L00020,
Author = {Short, K},
Editor = {McLean, GD and Evans, G},
Title = {The ecological implications of herbicide use in Australian agriculture:
   Some issues for discussion},
Booktitle = {HERBICIDE-RESISTANT CROPS AND PASTURES IN AUSTRALIAN FARMING SYSTEMS},
Year = {1995},
Pages = {241-244},
Note = {Workshop on Herbicide-Resistant Crops and Pastures in Australian Farming
   Systems, CANBERRA, AUSTRALIA, MAR 15-16, 1995},
Organization = {Grains Res \& Dev Corp; Cotton Res \& Dev Corp; Rural Ind Res \& Dev
   Corp; Brit Council},
Abstract = {Many Australians have deep concerns about the potential for harm
   resulting from the release of genetically altered organisms into the
   environment. These concerns have ecological and spiritual definition for
   some, while others are chiefly concerned about the potential for
   compromise to the sustainability of agricultural systems and resultant
   damage to food and fibre production.
   As well as the direct and multifactorial ecological risks presented by
   the existence of the organisms themselves, there is the significantly
   increased pesticide risk to consider. A technology which genetically
   engineers herbicide resistance into food and fibre crops like cotton and
   wheat presents the possibility of increased use of herbicides, as
   products previously unsuitable for use in weed control become useable.
   Increased use most often translates into increased exposure and thus
   increased exposure and thus increased risk to human communities. Thus
   there are social and health, as well as agronomic implications
   associated with the technology. All three matters are of concern when we
   consider the hazardous nature of the herbicides involved and the way
   their total hazard profiles are presented to the people who use them at
   the workplace.},
