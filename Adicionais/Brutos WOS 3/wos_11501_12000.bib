@article{ WOS:000250433600008,
Author = {Borrego, C. and Costa, A. M. and Amorim, J. H. and Santos, P. and Sardo,
   J. and Lopes, M. and Miranda, A. I.},
Title = {Air quality impact due to scrap-metal handling on a sea port: A wind
   tunnel experiment},
