Title = {Energy Efficiency of Building Technologies and Climate Change using
   Geographical Information System (GIS): A Case study of use of soil,
   water and forest/grass in Migori County, Kenya},
Booktitle = {SUSTAINABILITY IN THE BUILT ENVIRONMENT FOR CLIMATE CHANGE MITIGATION
   (SBE19)},
Series = {IOP Conference Series-Earth and Environmental Science},
