   and Cámara, D and González, RM},
Editor = {IbarraBerastegi, G and Brebbia, CA and Zannetti, P},
Title = {Operational air pollution forecasting and management system over Bilbao},
Booktitle = {DEVELOPMENT AND APPLICATION OF COMPUTER TECHNIQUES TO ENVIRONMENTAL
   STUDIES VIII},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {2000},
