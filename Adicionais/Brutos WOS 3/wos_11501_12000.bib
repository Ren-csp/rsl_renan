@inproceedings{ WOS:000170062300009,
Author = {Shibasaki, H},
Editor = {Miyoshi, K and Shapiro, CM and Gaviria, M and Morita, Y},
Title = {Functional neuroimaging of the human brain},
Booktitle = {CONTEMPORARY NEUROPSYCHIATRY},
Year = {2001},
Pages = {69-72},
Note = {3rd International Congress of Neuropsychiatry, KYOTO, JAPAN, APR 09-13,
   2000},
Abstract = {In the functional neuroimaging of the human brain, the main effort so
   far has been put forward to cerebral localization of each function or
   functional specialization. Two examples based on the study by the
   author's group are presented: one on the cortical mechanism of pain
   perception in humans, which was studied by somatosensory evoked
   potentials as well as magnetic fields, blood flow activation by position
   emission tomography (PET), and functional magnetic resonance imaging
   (fMRI), and the other on central control of gait in humans, which was
   studied by single photon emission computed tomography (SPECT).
   Currently, increasing attention has been paid to the functional coupling
   among different cerebral areas, either cortical or subcortical, by
   combining multiple techniques; for example, PET-rCBF or fMRI activation
   studies combined with transcranial magnetic stimulation (TMS). It is
   expected that the transient impairment of local function caused by
   repetitive TMS, combined with fMRI or PET, will help in clarifying the
   network circuitry. Moreover, it is hoped that noninvasive imaging of
   various receptors such as dopamine, serotonin, benzodiazepine or GABA,
   and acetylcholine, of the uptake of neurotransmitters such as dopamine,
   and of transporters will become available for clinical as well as
   scientific investigation of neural functions.},
