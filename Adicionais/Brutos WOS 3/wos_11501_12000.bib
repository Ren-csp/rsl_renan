@inproceedings{ WOS:000298911600003,
Author = {Mooney, P. F.},
Editor = {Villacampa, Y and Brebbia, CA},
Title = {The effect of human disturbance on site habitat diversity and avifauna
   community composition in suburban conservation areas},
Booktitle = {ECOSYSTEMS AND SUSTAINABLE DEVELOPMENT VIII},
