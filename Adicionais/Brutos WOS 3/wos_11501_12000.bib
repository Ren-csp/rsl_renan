@inproceedings{ WOS:000298388800022,
Author = {Marzelli, Stefan},
Editor = {Balsiger, J and Debarbieux, B},
Title = {Land resources in the Alps and instruments supporting their sustainable
   management as a matter of regional environmental governance},
Booktitle = {REGIONAL ENVIRONMENTAL GOVERNANCE: INTERDISCIPLINARY PERSPECTIVES,
   THEORETICAL ISSUES, COMPARATIVE DESIGNS (REGOV)},
