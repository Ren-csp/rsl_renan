Title = {Using public perception of risk to inform educational programming},
Booktitle = {ENVIRONMENTAL EDUCATION FOR THE NEXT GENERATION: PROFESSIONAL
   DEVELOPMENT AND TEACHER TRAINING},
Year = {1997},
Pages = {125-132},
Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {One of the goals of environmental education is to lead the learners to a
   better understanding of daily environmental issues surrounding them. It
   lets citizens positively identify their perceived roles and
   responsibilities for the environment. The purpose of this study was to
   assess and prioritize the general public's perceptions of environmental
   issues confronting the Columbus metropolitan community in the areas of
   land, air, water, and any other related issue. Two descriptive surveys,
   workshops and project teams identified 30 environmental issues that are
   concerns of the citizens as risks to them and to the city. The
   recommendations of these studies helped the administration in bringing
   the issues into a more manageable focus of six major clusters of
   concerns. A strategic plan based on the outcomes has been developed to
   define the range of risk reduction options available to the city of
   Columbus, Ohio in the United States.},
