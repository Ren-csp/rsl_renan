@inproceedings{ WOS:000083105000398,
Author = {Jones, MC and Price, RL and Ferrier, K},
Book-Group-Author = {DECIS SCI INST
   DECIS SCI INST},
Title = {Case tool usage revisited: Perceptions of case users and non-users},
Booktitle = {DECISION SCIENCES INSTITUTE 1998 PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {979-981},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {A survey of information systems (IS) programmer/analysts (P/As) in 7
   firms in the Southwest reveals that CASE tools are still used, and that
   the majority of users would rather invest a substantial amount of time
   learning CASE than to work without it. CASE user perceptions of the
   effect of CASE on a variety of IS development and personal productivity
   issues are presented. CASE user and non-user perspectives are also
   compared, revealing that the two views are surprisingly similar.
   Finally, implications for future research and for top level management
   are presented.},
