@article{ WOS:000445101000130,
Author = {Nasiti, Sri Indah Wibi and Kusnoputranto, Haryoto and Utomo, Suyud Warno},
Title = {Potential Health Impact of Climate Risk on Clean Water Supply Case of
   South Tangerang City},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {9},
Pages = {6797-6801},
Month = {SEP},
Note = {International Conference on Actual Economy - European Discourse on
   Global Challenges (ACE-EU), Paris, FRANCE, NOV 27-29, 2017},
Abstract = {Introduction: Water is a vital resource for human living as well as for
   many sectors such as agriculture, industry, energy, and so on. The
   climate change has led to disruptions in water quality and quantity. The
   study aims to analyze the potential health impacts from climate risk of
   clean water supply. Methods: The case study was held in South Tangerang
   City, Banten Province, one of the urban area which is growing very fast.
   The data was collected from the survey and in-depth interview with the
   community and sectoral officers. The risk profile was overlaid with the
   water deficit profile to find the clean water supply risk, then to
   analyze with see the sickness case in the area. Result: Based on the
   data collected from the survey showed that the need of clean water is
   very high. But, since the PDAM (drinking water local company) has served
   7\% of the population only, the clean water is high needed from surface
   water and ground water. These clean water sources are very influenced by
   the climate, land cover and human activities at this area. Based on the
   risk assessment of climate change at South Tangerang City South done by
   the South Tangerang Government in 2016, some areas of South Tangerang
   would be exposed to high risk of climate change. The data from the
   respondents described that there were sickness cases happened that
   related to the might be of climate situation. Conclusiion: Some area in
   South Tangerang have high risks of clean water supply and have a
   potential impact to the health quality of the people and environment.
   Since the sickness case has not been seen in detail its relation with
   climate event, this study suggest to do further study about that and
   there should be some adaptation actions to be taken in place for
   avoiding the worse impact for the public health from the clean water
   supply in South Tangerang.},
