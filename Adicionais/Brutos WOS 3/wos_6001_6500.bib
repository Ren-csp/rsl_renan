@inproceedings{ WOS:A1996BJ20B00624,
Author = {Baba, R and Omuro, K and Miyazono, H and Usagawa, T and Higuchi, M},
Editor = {Bunnell, HT and Idsardi, W},
Title = {The perception of morae in long vowels - Comparison among Japanese,
   Korean and English speakers},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {2474-2477},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {There are three kinds of Tokushuhaku (the specific timing morae) in the
   Japanese language such as the moraic nasal, the non-nasal consonant and
   the long vowel. Even though Japanese native speakers can perceive them
   perfectly, it is difficult for Japanese learners from abroad to perceive
   and produce them. To make it more efficient for Japanese learners to
   acquire them, we need to investigate how Japanese native speakers
   perceive Tokushuhaku.
   This study examines the perception of a mom or morae of Japanese
   language specifically in the long vowel. Previous researchers
   ((1))Hiroya Fujisaki, Miyoko Sugito) have assumed that duration
   contrasts alone are involved in perception. However we hypothesize that
   the accentual change in the midst of a long vowel would mark the
   boundary between the morae and would affect the perception of morae by
   native speakers of standard Japanese.
   Based on the hypothesis three kinds of perception tests with
   computer-edited sound stimuli were given to native Japanese, Korean and
   English speakers. The results of these tests suggest that native
   Japanese speakers count the number of morae not only by the duration of
   vowels, but also by the accentual change which indicates the boundary
   between morae. On the other hand, nonnative speakers count the number of
   morae only by the duration of vowels.},
