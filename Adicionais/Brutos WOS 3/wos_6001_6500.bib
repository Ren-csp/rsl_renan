@inproceedings{ WOS:000179444800086,
Author = {Juzwa, N},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Should we protect and save the old industrial workers' estates
   districts?},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {685-689},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The Upper Silesian Agglomeration is situated in southern Poland and
   consists with sixteen cities and communities. Industrial development
   began here in the 191 century. Today the region is the largest and most
   densely populated urban agglomeration in Poland. Industry still employs
   about 50\% of the working population. Following the 191 century land use
   patterns the iron foundries and other factories were clustered around
   the coal mines. Then the workers' settlements clustered the plants
   around. The result is urban sprawl and corridor development, which
   isolates remaining open spaces and strengthens the functional
   interdependency of agglomerated communities. This amorphous arrangement
   can be described as complicated system of spatial (physical) social,
   economic, and other elements and the very core of the agglomeration is a
   mixture of industry, housing, facilities and waste land.
   The economic changes of the 1990(th) have accelerated the decline of
   some large industrial areas depend upon antiquated technology. Since
   beginning of the decade there many problems connected with the old
   industrial objects conversion are discussed. When discussing the problem
   of post-industrial areas it is impossible to omit the old workers'
   estates and settlements. Most of them were build in the early twenties,
   the majority arose on the basis of architectural projects and site
   planning, even though they show residual ties to local rural
   architecture. Those housing estates which together with a coal mine,
   steelworks or some other plant have once formed an unified system - a
   neighbourhood networks. In time after the Second World War the old urban
   planning patterns still existed, the new housing settlements concept
   surrounding the old industrial - housing district destroyed some of
   their fundamental qualities - the sense of the place of these ``little
   homelands{''}. In the nineteen nineties the decline of old industry
   caused another identity shock to this virtual island of place identity
   within the unified industrial urban landscape. The stagnation of the
   production has minimized the pollution, but the derelict landscape still
   exists, close to the housing.
   One of the important questions is: should we protect and save old
   industrial - workers' estates district, despite many of them are
   regarded as old fashioned or shabby ? Thus our research issues have
   revealed the following:
   the significance of natural environment and the searching for new
   workplaces being the basic component of the regions' renewal process,
   and
   the importance of place identity in the urban rehabilitation process of
   the Upper Silesian Agglomeration, very pronounced in the old residential
   manufacturing districts.
   Some case studies were chosen as example.},
