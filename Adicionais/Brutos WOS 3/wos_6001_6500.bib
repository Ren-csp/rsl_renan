   SE Univ, Res Ctr Learn Sci, Nanjing 210096, Peoples R China.
   Peking Univ, Ctr Brain \& Cognit Sci, Beijing 100871, Peoples R China.
   Peking Univ, Dept Psychol, Beijing 100871, Peoples R China.},
ISSN = {1002-0071},
EISSN = {1745-5391},
