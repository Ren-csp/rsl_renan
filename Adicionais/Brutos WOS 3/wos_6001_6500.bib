@inproceedings{ WOS:000299096403100,
Author = {Li, Jing and You, Xue-Yi and Ji, Min and Pan, Liu-Ming and Wang, Xiu-Duo},
Editor = {Zhou, X},
Title = {RETRACTED: The Study of Overflow Reduction Strategies in Urban Drainage
   System (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
Series = {Energy Procedia},
Year = {2011},
Volume = {11},
Pages = {3620-3628},
Note = {International Conference on Energy and Environmental Science (ICEES),
   Singapore, SINGAPORE, OCT, 2011},
Organization = {Singapore Inst Elect (SIE)},
Abstract = {The overflow reducing strategies of the drainage system in a chosen area
   is simulated by applying the Storm Water Management Model (SWMM).
   Considering the high cost of constructing new pipeline network and
   reservoirs, four easy and cheap measures for reducing the overflow of
   drainage system, such as the reconstruction of pipe network, the
   dredging of pipe network, the changing of land surface properties and
   the re-division of catchments, have been proposed in this paper. The
   following results are obtained for the case of one year return period.
   (1) By enlarging the diameter of `` bottleneck{''} pipes and re-dividing
   the catchments, the performance of the pipe network is improved and the
   overflow volume of the whole drainage system is reduced by 13.74\% and
   11.45\%, respectively. (2) By increasing permeable area 10\% and 20\%,
   the overflow volume of the whole drainage system is reduced by 30.30\%
   and 55.26\%, respectively. (3) When dredging 0.1m and 0.2m thickness of
   sedimentation in pipelines, the total overflow volume of the drainage
   system is reduced by 27\% and 69\%, respectively. Numerical results also
   indicate that the manning roughness coefficient of pipelines has great
   effects on the performance of the drainage system. (C) 2011 Published by
   Elsevier Ltd. Selection and/or peer-review under responsibility of the
   Organizers of 2011 International Conference on Energy and Environmental
   Science.},
