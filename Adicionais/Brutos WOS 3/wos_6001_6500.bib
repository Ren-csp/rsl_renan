@article{ WOS:000238451000007,
Author = {Hall, Nathan C. and Perry, Raymond P. and Ruthig, Joelle C. and Hladkyj,
   Steven and Chipperfield, Judith G.},
Title = {Primary and secondary control in achievement settings: A longitudinal
   field study of academic motivation, emotions, and performance},
Journal = {JOURNAL OF APPLIED SOCIAL PSYCHOLOGY},
Year = {2006},
Volume = {36},
Number = {6},
Pages = {1430-1470},
Month = {JUN},
Note = {Annual Convention of the American-Educational-Research-Association,
   SEATTLE, WA, APR, 2001},
Organization = {Amer Educ Res Assoc},
Abstract = {The present research represents an application of Rothbaum et al.'s
   (1982) dual-process model of perceived control to adaptation in
   achievement settings. This eight-month longitudinal field study examined
   how primary and secondary control influenced end-of-year academic
   motivation (e.g., voluntary course withdrawal), emotions (e.g., stress,
   regret, pride), and performance (e.g., cumulative grade point average)
   in 703 first-year college students. For successful students, primary
   control related to better performance, higher motivation, and more
   positive affect. For unsuccessful students, the combination of primary
   and secondary control resulted in optimal academic adjustment.
   Unsuccessful students who rely on primary at the expense of secondary
   control risk serious long-term deficits in motivation and performance.
   These findings are discussed with respect to academic overconfidence and
   control-enhancing treatments.},
