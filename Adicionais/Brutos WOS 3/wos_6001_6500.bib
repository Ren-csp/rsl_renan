@article{ WOS:000071701700004,
Author = {Gaskell, MG and Marslen-Wilson, WD},
Title = {Integrating form and meaning: A distributed model of speech perception},
Journal = {LANGUAGE AND COGNITIVE PROCESSES},
Year = {1997},
Volume = {12},
Number = {5-6},
Pages = {613-656},
Month = {OCT-DEC},
Note = {3rd Workshop on Cognitive Models of Speech Processing, SPERLONGA, ITALY,
   SEP, 1995},
Organization = {European Commiss, Directorate Gen XII Sci Res \& Dev},
Abstract = {We present a new distributed connectionist model of the perception of
   spoken words. The model employs a representation of speech that combines
   lexical information with abstract phonological information, with lexical
   access modelled as a direct mapping onto this single distributed
   representation. We first examine the integration of partial cues to
   phonological identity, showing that the model provides a sound basis for
   simulating phonetic and lexical decision data from Marslen-Wilson and
   Warren (1994). We then investigate the time course of lexical access,
   and argue that the process of competition between word candidates during
   lexical access can be interpreted in terms of interference between
   distributed lexical representations. The relation between our model and
   other models of spoken word recognition is discussed.},
