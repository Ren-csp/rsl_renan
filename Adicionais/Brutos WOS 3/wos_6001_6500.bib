Booktitle = {PROGRESS IN ENVIRONMENTAL PROTECTION AND PROCESSING OF RESOURCE, PTS 1-4},
Series = {Applied Mechanics and Materials},
Year = {2013},
Volume = {295-298},
Pages = {755-758},
Note = {International Conference on Sustainable Energy and Environmental
   Engineering (ICSEEE 2012), Guangzhou, PEOPLES R CHINA, DEC 29-30, 2012},
Organization = {Guangdong Univ Business Studies},
Abstract = {Based on the water quality investigation data of December in 2010, the
   water environment quality of Lv-tang River in Zhanjiang national urban
   wetland park was assessed using single water quality parameter model and
   integrated water quality index model. The results show that the water
   quality of Lv-tang River is worse than the national quality standards
   for Grade V. The water is polluted seriously. The main pollutants are
   total nitrogen (TN), ammonia nitrogen (NH3-N) and chemical oxygen demand
   CODCr with their average concentrations of 60.49 mg/L, 30.57 mg/L and
   227.38mg/L, respectively. The averages of their single parameter
   pollution index are 30.25, 19.79 and 8.74. The average of single
   parameter pollution index of the river is 8.23 which indicated that the
   river belongs to heavy pollution zone. The integrated water quality
   index was 22.5 showing that the river belongs to serious pollution zone.},
