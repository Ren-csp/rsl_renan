@inproceedings{ WOS:000078270700013,
Author = {Youtie, B},
Editor = {Kaye, TN and Liston, A and Love, RM and Luoma, DL and Meinke, RJ and Wilson, MV},
Title = {Weed control as the first step in protecting and restoring native plant
   communities on northeast Oregon natural areas},
Booktitle = {CONSERVATION AND MANAGEMENT OF NATIVE PLANTS AND FUNGI},
Year = {1997},
Pages = {78-82},
Note = {Oregon Conference on the Conservation and Management of Native Vascular
   Plants, Bryophytes, and Fungi, OREGON STATE UNIV, CORVALLIS, OR, NOV
   15-17, 1995},
Organization = {Native Plant Soc Oregon; Oregon Dept Agr; Oregon State Univ, Dept Bot \&
   Plant Pathol; USDI Bur Land Management, Oregon State Off},
Abstract = {Aggressive non-indigenous plant species are one of the largest threats
   to biological diversity. The invasion of these species (weeds) may be
   due in part to poor land management and the increase of travel of people
   and goods. No matter what the reason, they are here now and need to be
   controlled before we can continue with the restoration process. The
   majority of The Nature Conservancy's Oregon Stewardship program's time
   and resources are spent on protecting sensitive species, communities and
   ecosystems from non-native plants. Prevention and early detection are
   the best means of limiting weed problems. However, the Conservancy uses
   a wide variety of integrated weed control methods in natural areas.
   Although herbicides are one of those tools, other control options are
   considered first and utilized where possible. Examples from north
   central and northeastern Oregon preserves are presented. After applying
   weed control, native species may not reoccupy the site without our
   assistance. In many cases we need to reintroduce those native plants
   that occupied the site at some previous benchmark in time. To The Nature
   Conservancy, this usually means the pre-European settlement condition. A
   second level of consideration is the return of important ecological
   processes, such as fire and flooding.},
