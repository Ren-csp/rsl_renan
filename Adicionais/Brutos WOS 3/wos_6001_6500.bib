@article{ WOS:000281505500014,
Author = {DeLuca, Lawrence A. and McEwen, Marylyn M. and Keim, Samuel M.},
Title = {United States-Mexico Border Crossing: Experiences and Risk Perceptions
   of Undocumented Male Immigrants},
Journal = {JOURNAL OF IMMIGRANT AND MINORITY HEALTH},
Year = {2010},
Volume = {12},
Number = {1},
Pages = {113-123},
