@inproceedings{ WOS:000248877700037,
Author = {Kristl, Ziva and Krainer, Ales},
Editor = {Frankovic, B},
Title = {Use of solar envelope method in the design of site layout},
Booktitle = {Energy and the Environment 2004, Vol II},
Year = {2004},
Pages = {325-332},
Note = {19th International Congress on Energy and the Environment, Opatija,
   CROATIA, 2004},
Abstract = {During the initial design phase of urban development the designer has to
   determine the basic building geometry and place it onto a site. The
   investigation of urban concept and its influence on thermal and luminous
   conditions in a building and its surroundings are essential in this
   stage of design. During this time it is still possible to change the
   site layout, building orientation, its geometry and dimensions. The aim
   of a good micro-climatic urban design is to achieve building
   dispositions, which will allow the sun to penetrate the buildings during
   selected periods of time and to assure shading when desirable. Only by
   doing so an energy efficient design with relevant functional zones can
   be obtained. In this paper we investigated the relevance and
   applicability of the solar envelope method for urban planning and
   estimating of solar access. We checked the method on two levels: on the
   level of current Slovenian solar rights regulation (on 3 reference days)
   and on the level of several lower incidence angles which enable
   prolonged solar access during the year (for instance 3 hours during
   winter, 5 hours during spring/autumn and 7 hours during summer). The
   investigation showed that the 15 degree elevation angle is the lowest
   acceptable angle on our latitude, if we want to assure evenly
   distributed solar access during the year. Adjustments for densely built
   areas in buildings with different functional zones can be made in the
   form of solar envelopes raised above the original ground level. The
   results were obtained with computer tool developed for this purpose.},
