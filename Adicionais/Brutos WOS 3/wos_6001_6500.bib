@inproceedings{ WOS:000072818300020,
Author = {Gorzelska, K and Scudlark, JR and Keene, WC},
Editor = {Baker, JE},
Title = {Dissolved organic nitrogen in the atmospheric environment},
Booktitle = {ATMOSPHERIC DEPOSITION OF CONTAMINANTS TO THE GREAT LAKES AND COASTAL
   WATERS},
Series = {SETAC TECHNICAL PUBLICATIONS SERIES},
Year = {1997},
Pages = {379-392},
Note = {Session on Atmospheric Deposition of Contaminants to the Great Lakes and
   Coastal Waters, at the SETAC 15th Meeting, DENVER, CO, OCT 30-NOV 03,
   1994},
Organization = {Soc Environm Toxicol \& Chem; SETAC Fdn Environm Educ},
Abstract = {There remains much uncertainty regarding qualitative and quantitative
   profiles of nitrogen compounds in the atmospheric environment. Field
   measurements of organic nitrogen compounds are particularly scarce.
   Difficulties associated with sampling and analyses are the major
   impediments. The available data indicate that organic nitrogen compounds
   may be important components of the atmospheric nitrogen budgets in
   non-urban regions. At times, the wet deposition of organic nitrogen may
   contribute as much as 60\% of the total dissolved nitrogen deposition
   (dissolved organic nitrogen {[}DON] plus dissolved inorganic nitrogen
   {[}DIN]). The atmospheric deposition of organic nitrogen to aquatic
   ecosystems is of particular interest because it may constitute a
   significant fraction of the overall flux of this important nutrient.
   Also, since not all forms of organic nitrogen are equally bioavailable,
   the qualitative as well as the quantitative data are of interest. In
   light of the limited DON data, it is often necessary to extrapolate from
   related data pertaining to individual compounds contributing to DON,
   such as the amino compounds. However, caution is warranted when
   generalizing or extrapolating these data. The large spatial and temporal
   variability in concentrations of the amine nitrogen (thus, likely DON)
   can result in substantial over-or underestimation of DON budgets. In
   addition, individual compounds may not vary proportionately to total
   DON. It must be emphasized that there are no proven, generally accepted
   procedures for the collection and analysis of individual reduced
   nitrogen compounds or the total DON in precipitation, and most
   publications contain insufficient quality control information to
   determine the overall uncertainties of the reported values.
   Comprehensive studies aimed at developing appropriate methodologies for
   sampling, storage, and analysis, followed by a long-term monitoring of
   DON in the atmospheric samples are needed to assess the role of DON in
   the atmospheric deposition and the biogeochemical cycle of nitrogen.},
