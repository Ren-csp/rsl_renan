@article{ WOS:A1995RM58600020,
Author = {JOUMARD, R and JOST, P and HICKMAN, J and HASSEL, D},
Title = {HOT PASSENGER CAR EMISSIONS MODELING AS A FUNCTION OF INSTANTANEOUS
   SPEED AND ACCELERATION},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1995},
Volume = {169},
