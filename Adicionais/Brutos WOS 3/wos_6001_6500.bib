Title = {Estimating Hourly Population Distribution Patterns at High
   Spatiotemporal Resolution in Urban Areas Using Geo-Tagged Tweets and
   Dasymetric Mapping},
Booktitle = {11TH INTERNATIONAL CONFERENCE ON GEOGRAPHIC INFORMATION SCIENCE,
   GISCIENCE 2021 - PT I},
Series = {Leibniz International Proceedings in Informatics},
