   mobile microwave systems for remote measurements of atmospheric
   temperature profile},
Booktitle = {OPTICAL TECHNOLOGIES FOR ATMOSPHERIC, OCEAN, AND ENVIRONMENTAL STUDIES,
   PTS 1 AND 2},
Series = {Proceedings of SPIE},
Year = {2005},
Volume = {5832},
