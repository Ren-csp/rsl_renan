@inproceedings{ WOS:000383740302052,
Author = {Colombo, Barbara and Laddaga, Silvia and Antonietti, Alessandro},
Editor = {Ahram, T and Karwowski, W and Schmorrow, D},
Title = {Psychology and design. The influence of the environment's representation
   over emotion and cognition. An ET study on Ikea design},
Booktitle = {6TH INTERNATIONAL CONFERENCE ON APPLIED HUMAN FACTORS AND ERGONOMICS
   (AHFE 2015) AND THE AFFILIATED CONFERENCES, AHFE 2015},
Series = {Procedia Manufacturing},
Year = {2015},
Volume = {3},
