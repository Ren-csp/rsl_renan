@inproceedings{ WOS:000079356600023,
Author = {Mattiot, FP and Buttini, P and Fusco, R and Prastaro, M},
Editor = {Almorza, D and Ramos, HM},
Title = {Empirical relationships between fuel consumption and atmospheric
   concentration levels in an urban area},
Booktitle = {APPLIED SCIENCES AND THE ENVIRONMENT},
Series = {ENVIRONMENTAL ENGINEERING (SERIES)},
Year = {1998},
Pages = {241-250},
Note = {1st International Conference on Applied Sciences and the Environment
   (ASE 98), CADIZ, SPAIN, 1998},
Organization = {Univ Cadiz, Spain; Wessex Inst Technol, UK},
Abstract = {Trends of SO2, NOX and CO concentrations in the city of Rome from 1993
   to 1996 are analysed in order to highlight improvements on air quality
   and their relationships with fossil fuel usage.
   The SO2 reduction, registered by government monitoring stations in the
   last four years, is correlated to fuel consumption and sulphur content.
   Monthly averaged SO2 emissions are estimated from residential heating
   and traffic sources. A similar approach is applied to NOx and CO also
   considering that meteorological variables, although presenting minor
   fluctuations over the observed four years, have a direct influence on
   the experimental data. In particular wind speed has been taken into
   account to compare the concentrations with the calculated emissions.
   Traffic parameters have been used also for CO evaluation.
   The results confirm the decreasing trend expected for Italy and reported
   in the literature. Moreover the SO2 calculated emissions show a good
   agreement with the measured concentrations. Apportionment by season of
   the major sources is also presented. Regression analysis for NO
   emissions and urban trends is not as representative as for SO2. The
   observed CO reduction is attributed to fleet renewal and to the
   concurrent use of unleaded petrol.},
