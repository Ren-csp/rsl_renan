@inproceedings{ WOS:001728145300006,
Author = {Arshinova, Marina A. and Komarova, Tatiana V. and Mikheeva, Svetlana N.},
Editor = {Mohammad, P and Shahfahad and Comino, JR and Matamanda, AR},
Title = {Climate-Related Changes of Energy Flows in the Major Cities of Europe},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
