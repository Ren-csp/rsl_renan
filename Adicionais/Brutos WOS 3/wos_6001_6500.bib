@inproceedings{ WOS:001285604500022,
Author = {Kedote, Nonvignon Marius and Darboux, Aymeric Joaquin and Tiembre,
   Issaka and Lompo, Sandrine and Fall, Mamadou},
Editor = {Fomba, KW and Fankam, BT and Mellouki, A and Westervelt, DM and Giordano, MR},
Title = {Ecohealth Chair in Urban Air Pollution and Its Impact on
   Non-communicable Respiratory Diseases in West Africa},
Booktitle = {ADVANCES IN AIR QUALITY RESEARCH IN AFRICA, ICAQ'AFRICA 2022},
Series = {Advances in Science Technology and Innovation},
Year = {2024},
Pages = {113-117},
Note = {1st International Conference on Air Quality in Africa (ICAQ'Africa),
   ELECTR NETWORK, OCT 11-14, 2022},
Organization = {IEREK},
Abstract = {The ``Ecohealth Chair on Urban Air Pollution and Non-Communicable
   Respiratory Diseases in West Africa{''} is a regional project whose aim
   is to promote the health and well-being of populations in a healthy
   environment in four cities (Abidjan, Cotonou, Dakar and Ouagadougou).
   Through an interdisciplinarity approach, the research components
   contribute to characterize and measure the health risks related to air
   pollution in various vulnerable and particularly exposed groups
   (children, women, motorcycle cab drivers, bus drivers, shopkeepers
   living along the roads). Indoor and outdoor pollution levels measured in
   urban West Africa are high with greater concentration at crossroads. The
   main risk factors are the intensity of urban traffic, the use of
   biomass, the location of the kitchen inside the dwelling, the low number
   of windows in the rooms, and the use of products to control
   disease-carrying insects and improve olfactory sensations. Also, the
   level of implementation of air quality regulations has been accessed.
   Important mechanisms and institutions exist to protect air quality but
   they encounter obstacles related to governance and resources made
   available. In addition, some legal provisions appear to be outdated and
   unknown to the actors. In the action component, an intervention called
   Air-sain has been implemented and allowed, in addition to mass actions,
   to encourage the use of less polluting energy sources and to influence
   positively a thousand community and institutional actors. The
   ``Ecohealth Chair{''} project has, through these different axes, raised
   local awareness of the problem of air pollution and initiated a change
   in the practices of communities and institutions.},
Publisher = {SPRINGER INTERNATIONAL PUBLISHING AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
