@inproceedings{ WOS:000175480700054,
Author = {Angoujard, G and Le Godec, N and Lefevre, L and Blanchet, P},
Editor = {Walker, A},
Title = {Herbicide flow from two types of hard surfaces in urban areas: first
   results for glyphosate and diuron},
Booktitle = {PESTICIDE BEHAVIOUR IN SOILS AND WATER},
Series = {BRITISH CROP PROTECTION COUNCIL SYMPOSIUM PROCEEDINGS},
Year = {2001},
Number = {78},
Pages = {345-350},
Note = {Symposium on Pesticide Behaviour in Soils and Water, BRIGHTON, ENGLAND,
   NOV 13-15, 2001},
Organization = {British Crop Protect Council},
Abstract = {An experiment has been established in a mini-watershed to determine the
   contribution of urban areas to water pollution. The idea was to collect
   run-off from two man-made surfaces : concrete (impermeable) and
   compacted sandy soil (permeable). Both surfaces can be considered as
   hard ones if compared with agricultural soils. The losses of glyphosate
   and diuron sprayed at 3000 g ha(-1) were monitored for 10.5 months after
   application. For diuron, 33.3\% of the applied quantity is transferred
   to the water from concrete surface and 39.5\% from the sandy zone. For
   glyphosate, the rates are respectively 8.5\% and 12.8\%. These very high
   results are to be compared with the data for agricultural use of
   herbicide indicating an average range of 0.1 \% to 1 \% loss of the
   applied quantity. 5 or 3 mm rainfall are enough for the leaching of 50\%
   of the total loss of glyphosate and diuron from concrete surface. The
   regulatory process should be improved regarding urban uses of pesticides
   and herbicides with the less possible loss encouraged. A new impetus has
   to be given to the research of non-chemical methods in urban areas,
   which could be the ultimate environment friendly solution on hard
   surfaces.},
Publisher = {BRITISH CROP PROTECTION COUNCIL},
Address = {49 DOWNING ST, FARNHAM GU9 7PH, SURREY, ENGLAND},
