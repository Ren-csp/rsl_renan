Title = {Quantifying urban physical growth types in Banda Aceh City after the
   2004 Indian Ocean Tsunami},
Booktitle = {1ST GEOSCIENCES AND ENVIRONMENTAL SCIENCES SYMPOSIUM (ICST 2020)},
