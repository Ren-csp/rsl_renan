Year = {1998},
Pages = {33-41},
Note = {1st International Conference on Applied Sciences and the Environment
   (ASE 98), CADIZ, SPAIN, 1998},
Organization = {Univ Cadiz, Spain; Wessex Inst Technol, UK},
Abstract = {Air pollution is one of the most controversial environmental problems in
   society. In this work, we carry out a statistical analysis of the
   pollutants' concentration measured by a local network of fixed automatic
   monitoring stations sited in the urban area of Valencia, Spain. These
   sites were selected because they presented a high traffic density. The
   levels of contaminants in each station were compared taking into account
   their spatial and temporal variability. Although all the sites were
   chosen with the same approach (high traffic density), the structure of
   air pollutants is not the same in all the stations, this is due to their
   different location. However, homogeneity has been found between other
   monitoring sites that are geographically separated. A descriptive
   analysis permits us to establish the differences and similarities among
   the stations considering the temporal variability of the air pollutants
   measured.},
