Title = {The role of risk perception in a one-day wilderness whitewater rafting
   trip},
Booktitle = {Porceedings of the 2005 Northeastern Recreation Research Symposium},
Series = {USDA FOREST SERVICE NORTHEASTERN RESEARCH STATION GENERAL TECHNICAL
   REPORT},
