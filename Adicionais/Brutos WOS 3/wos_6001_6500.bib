@article{ WOS:000166306800027,
Author = {Wendel, JS and Miklowitz, DJ and Richards, JA and George, EL},
Title = {Expressed emotion and attributions in the relatives of bipolar patients:
   An analysis of problem-solving interactions},
Journal = {JOURNAL OF ABNORMAL PSYCHOLOGY},
