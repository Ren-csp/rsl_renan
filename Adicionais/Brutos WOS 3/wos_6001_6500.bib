Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {Depth perception is one of the indispensable issues for 3-D perception.
   For investigating the depth perceiving ability, depth difference
   discrimination method of two target patterns such as lines or dots, has
   been used widely. We found, however, that the depth difference
   discrimination capability was influenced remarkably by the existence of
   the intermediate surface between the target patterns. In this paper, we
   have investigated the influence of intermediate surface structure for
   depth discrimination ability by observing the testing target object with
   and without the intermediate surface structure.},
