@article{ WOS:000186643700090,
Author = {Ruff, S and Marie, N and Celsis, P and Cardebat, D and Démonet, JF},
Title = {Neural substrates of impaired categorical perception of phonemes in
   adult dyslexics:: An fMRI study},
Journal = {BRAIN AND COGNITION},
Year = {2003},
Volume = {53},
Number = {2},
Pages = {331-334},
Month = {NOV},
Note = {13th Annual Meeting on Tennet: Theoretical and Experimental
   Neuropsychology, MONTREAL, CANADA, JUN   20, 2002-JUN 22, 2003},
Organization = {Univ Quebec Montreal; Min Rech Sci \& Technol Quebec; Fonds Rech Sante
   Quebec; Canada Hlth Res Inst},
Abstract = {Phonological developmental dyslexics remain impaired in phonetic
   categorical perception (CP) even in adulthood. We studied the brain
   correlates of CP in dyslexics and controls using a block design fMRI
   protocol and stimuli from an phonetic continuum between natural /Pa/ and
   /Ta/ syllables. Subjects performed a pseudo-passive listening task which
   does not imply voluntary categorical judgment. In the control group,
   categorical deviant stimuli elicited specific activations in the left
   angular gyrus, the right inferior frontal gyrus and the right superior
   cingulate cortex. These regions were not activated in the dyslexic group
   in which activation was observed for acoustic but not phonetic changes
   in stimuli. Failures to activate key regions for language perception and
   auditory attention in dyslexic might account for persistent deficits in
   phonological awareness and reading tasks. (C) 2003 Elsevier Inc. All
   rights reserved.},
