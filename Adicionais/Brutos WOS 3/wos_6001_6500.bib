@inproceedings{ WOS:001281301400002,
Author = {Hunger, Robert and Christoffels, Lothar and Friedrich, Maik and Jameel,
   Mohsan and Pick, Andreas and Gerdes, Ingrid and von der Nahmer, Peter
   Michael and Sobotzki, Fabio},
Editor = {Harris, D and Li, WC},
Title = {Lesson Learned: Design and Perception of Single Controller Operations
   Support Tools},
Booktitle = {ENGINEERING PSYCHOLOGY AND COGNITIVE ERGONOMICS, PT II, EPCE 2024},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2024},
Volume = {14693},
