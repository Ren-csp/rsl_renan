@article{ WOS:000231418500008,
Author = {Lee, ACH and Barense, MD and Graham, KS},
Title = {The contribution of the human medial temporal lobe to perception:
   Bridging the gap between animal and human studies},
Journal = {QUARTERLY JOURNAL OF EXPERIMENTAL PSYCHOLOGY SECTION B-COMPARATIVE AND
   PHYSIOLOGICAL PSYCHOLOGY},
Year = {2005},
Volume = {58},
Number = {3-4},
