   K},
Title = {FIELD-MEASUREMENTS IN URBAN BACKGROUND - THE EFFECT OF PHOTOCHEMISTRY},
Journal = {JOURNAL OF AEROSOL SCIENCE},
Year = {1991},
Volume = {22},
Number = {1},
Pages = {S677-S680},
Note = {1991 EUROPEAN AEROSOL CONF / 19TH ANNUAL CONF OF THE
   GESELLSCHAFT-FUR-AEROSOLFORSCHUNG, KARLSRUHE, GERMANY, SEP 16-20, 1991},
Organization = {GESELL AEROSOLFORSCH; KERNFORSCHUNGSZENTRUM KARLSRUHE},
Abstract = {In this study we analyze air quality measurements carried out in urban
   background of Helsinki area.  The measurements were done by the
   University of Helsinki and the Helsinki Metropolitan Area Council during
   March-April 1991.  The main interest has concentrated to sulphur and
   nitrogen species in the vapour phase, the ozone concentration and the
   concentration and size distribution of fine particles.  Also
   meteorological data have been examined.  The measurement data consists
   of concentrations of air pollution species in the particulate and the
   gas phases and has been analysed using statistical cluster methods.  The
   size distribution of particles has been analysed with EVE deconvolution
   method.},
