@article{ WOS:000084664000011,
Author = {Hao, JM and He, DQ and Wu, Y and Fu, L and He, KB},
Title = {A study of the emission and concentration distribution of vehicular
   pollutants in the urban area of Beijing},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2000},
Volume = {34},
Number = {3},
Pages = {453-465},
Note = {6th International Conference on Atmospheric Science and Applications to
   Air Quality, BEIJING, PEOPLES R CHINA, NOV 03-05, 1998},
Organization = {Chinese Res Acad Environm Sci; China APEC Environm Protect Ctr; Chinese
   Res Acad Meterol Sci; Chinese Acad Sci, Atmospher Phys Res Inst;
   Shanghai Res Acad Environm Sci; China Environm Protect Fdn; Tsinghua
   Univ; Peking Univ; Qingdao Inst Environm Sci; Shenzhen inst Environm
   Sci; Guiyang Environm Protect Bur; Chinese Environm Sci Assoc, Atmospher
   Environm Branch; Ebara Corp; Green Cross Korea},
Abstract = {A method was developed in this paper to estimate the spatial and
   temporal distribution of vehicle emissions and concentrations in Beijing
   based on the limited database. The vehicle sources were treated as both
   line sources and area sources to make full use of the available data.
   For line sources, substantial counting of vehicles on site had been
   conducted to determine the traffic flow and vehicle type mixture; for
   area sources: the total non-line-source vehicle-traveled mileage was
   distributed to different grids based on population density and road area
   in the grids. A mathematical dispersion model, Industrial Sources
   Complex Short Term Version 3 (ISCST3), was used to simulate the
   pollutant concentration distribution in urban areas based on the
   meteorological data and the emissions distribution mentioned above. The
   verification data show that method is accurate in the Beijing urban
   area, and the results show that the vehicle emissions in Beijing
   contributed significantly to the simulated pollutant impact, and the
   polluted areas correlate with population. (C) 1999 Elsevier Science Ltd.
   All rights reserved.},
