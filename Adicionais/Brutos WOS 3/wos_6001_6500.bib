@inproceedings{ WOS:001594686300055,
Author = {Liu, Na and Xiong, Yiwei and Shi, Yan},
Editor = {Jin, S and Kim, JH and Kong, YK and Park, J and Yun, MH},
Title = {Distance Matters: Analyzing How Proximity and Interaction Mode Influence
   User Perception in Smart Homes},
Booktitle = {PROCEEDINGS OF THE 22ND CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, VOL 5, IEA 2024},
Series = {Springer Series in Design and Innovation},
Year = {2025},
Volume = {57},
Pages = {364-369},
Note = {22nd Congress of the International Ergonomics Association-IEA, SOUTH
   KOREA, AUG 25-29, 2024},
Abstract = {This study investigated the impact of proximity and interaction mode on
   user perceptions in smart homes. A within-subjects experimental design
   was employed, simulating scenarios of human interaction with smart home
   devices in three interaction modes, namely physical buttons, graphical
   user interfaces and voice interaction. User perception was measured in
   perceived ease of use, perceived usefulness, satisfaction, and
   behavioral intentions to use. A total of 100 participants were recruited
   in the experiment. The results indicated proximity and interaction mode
   had significant effects on user perceptions. Voice interaction was
   favored over GUIs and physical buttons in a distant usage scenario in
   terms of perceived ease of use, perceived usefulness, satisfaction, and
   behavioral intention. When people interact with smart home devices in a
   close usage scenario, no significant difference in satisfaction and
   behavioral intention was observed between voice interaction and GUIs.
