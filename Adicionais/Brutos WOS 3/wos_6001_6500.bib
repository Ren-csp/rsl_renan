@inproceedings{ WOS:001073826400057,
Author = {Morales-Payan, J. P.},
Editor = {Romano, D and Bretzel, F and Toscano, S},
Title = {Evaluation of giant granadilla accessions in a pergola system},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
Volume = {1345},
Pages = {431-434},
Note = {8th International Conference on Landscape and Urban Horticulture, ELECTR
   NETWORK, DEC 15-17, 2021},
Organization = {Int Soc Hort Sci, Div Landscape \& Urban Hort; Int Soc Hort Sci, Div
   Protected Cultivat \& Soilless Culture; Int Soc Hort Sci, Working Grp
   Urban Hort; Univ Catania, Dept Agr, Food \& Environm; Natl Res Council,
   Res Inst Terrestrial Ecosystems; Int Soc Hort Sci, Working Grp Landscape
   Hort},
Abstract = {Passiflora quadrangularis is a species used as a fruit crop and as an
   ornamental. Various parts of this plant are reputed to have endogenous
   substances that support human health for illnesses such as asthma,
   diabetes, hypertension, osteoarthritis, cancer, and inflammation. Its
   potential for several purposes has increased the interest in its
   production and consumption, therefore strengthening its crop in rural
   areas for marketing and for household use. It can also be grown in urban
   areas for its fruits, for ornamental and/or medicinal purpose. In Puerto
   Rico, there has been little research on this plant. A study was
   conducted in Puerto Rico to assess three accessions of Passiflora
   quadrangularis in a pergola system in a periurban setting. The
   accessions, designated ``PR-A{''}, ``PR-B{''}, and ``PR-C{''}, were
   selected in western Puerto Rico, cloning them by stem cuttings from
   three adult and productive mother plants. The resulting plants were
   established in a pergola structure in a complete randomized block design
   with three replications with 12 plants per accession. Growth rate,
   biomass accumulation, leaf area, greenness, fruit productivity, and
   attractiveness as ornamentals were evaluated. Among the three
   accessions, `PR-A' had the greatest growth rate, biomass accumulation
   and productivity. ` PR-B' had greater leaf area values than `PR-A'. In
   contrast, `PR-C' had the lowest values for all those variables. `PR-A'
   and `PR-B' were comparable in leaf greenness, and `PR-C' was paler.
   Scores for attractiveness were similar for the three accessions, as some
   people prefer paler plants and others prefer leaves with a darker green,
   and some prefer denser canopies and others prefer more spaced foliage.
   `PR-C' may be a good accession for urban areas with less space for
   growth and where high fruit yield may not be the main factor. `PR-A' and
   `PR-B' `may' seem more suitable for commercial plantings, or for urban
   areas where large plants can be accommodated or pruned more frequently
   to confine them to a determined area.},
Publisher = {INT SOC HORTICULTURAL SCIENCE},
Address = {PO BOX 500, 3001 LEUVEN 1, BELGIUM},
Type = {Proceedings Paper},
