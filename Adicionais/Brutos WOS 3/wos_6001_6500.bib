Title = {Impact and economic value of agricultural land conversion in sub-urban
   of Bantul Regency},
Booktitle = {1ST GEOSCIENCES AND ENVIRONMENTAL SCIENCES SYMPOSIUM (ICST 2020)},
Series = {E3S Web of Conferences},
