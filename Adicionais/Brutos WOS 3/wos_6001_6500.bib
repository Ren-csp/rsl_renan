@article{ WOS:000263704600004,
Author = {Hegtvedt, Karen A. and Johnson, Cathryn and Ganem, Natasha M. and
   Waldron, Krysia W. and Brody, Leslie M.},
Title = {When will the unaffected seek justice for others? Perceptions of and
   responses to another's injustice},
Journal = {AUSTRALIAN JOURNAL OF PSYCHOLOGY},
Year = {2009},
Volume = {61},
Number = {1},
Pages = {22-31},
Note = {12th Conference of the International-Society-for-Justice-Research,
   Adelaide, AUSTRALIA, 2008},
Organization = {Int Soc Justice Res},
Abstract = {Despite the plethora of research on perceptions of and responses to
   personal injustices, fewer studies have examined the reactions of those
   who observe another's injustice. This study extends work on the fair
   process effect (i.e., the positive impact of procedural justice on
   distributive justice assessments) to instances in which observers judge
   another's outcome injustice. Another aim was to examine how two
   group-oriented factors (legitimacy of the authority and the strength of
   the observer's group identity) modify the fair process effect by
   reducing uncertainty about the authority's trustworthiness and evoking
   relational concerns about group values, respectively. Results from a
   vignette study involving the allocation of committee positions show that
   procedural justice directly, and in conjunction with endorsement,
   influences observers' perceptions of injustice. Other findings
   demonstrate how justice perceptions mediate the effects of procedural
   justice and other factors on anticipated behavioural responses to
   another's injustice. Discussion focuses on when the unaffected will seek
   justice for others.},
