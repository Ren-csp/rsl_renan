@inproceedings{ WOS:000657253200091,
Author = {Suhono and Athaya, A. D. and Anwari, L. H. and Sinaga, F. D. H. and
   Hadaina, S. F. and Novantri, S. O.},
Book-Group-Author = {IOP},
Title = {Analysis of energy usage in mosques in urban area with tropical climate:
   case study in Yogyakarta, Indonesia},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON GREEN ENERGY AND ENVIRONMENT (ICOGEE
   2020)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
Volume = {599},
Note = {2nd International Conference on Green Energy and Environment (ICoGEE),
   ELECTR NETWORK, OCT 08, 2020},
Organization = {Univ Bangka Belitung, Fac Engn; Univ Gadjah Mada, Dept Civil \& Environm
   Engn; Univ Indonesia, Dept Civil Engn; Asian Federat Biotechnol},
Abstract = {The Mosque is a prayer place for Muslims, which has daily usage. For
   urban communities in Indonesia, mosques play an important role in social
   life. The Muslims carry out various kinds of activities in mosques
   besides praying. With its various activities, the mosque also has unique
   energy use characteristics when compared to other types of buildings
   such as houses, offices, and commercials. This paper presents an
   analysis of energy use in mosques in urban areas with tropical climate.
   Data was collected through a survey of mosques during 2018 to 2019 in
   Yogyakarta, Indonesia. The results show that the use of energy in
   mosques in urban areas in Yogyakarta on average consumes 182.2 kWh per
   day. The highest use is for air conditioning by 29.16\%. Overall, the
   mosque energy consumption intensity varies from 0.16 to 4.54 kWh per
   square meter monthly and all of them meets criteria as very efficient
   buildings. In the other side, only 6 out of 15 mosques meet the national
   standard for lighting. In the term of green building standard, there are
   9 out of 15 mosques meet the criteria in energy consumption aspect. This
   paper concludes that energy consumption in mosques in urban area with
   tropical climate is dominated by the air conditioning purposes.},
