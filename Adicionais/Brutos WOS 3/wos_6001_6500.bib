@inproceedings{ WOS:000274308700019,
Author = {Arsand, Eirik and Olsen, Odd-Arne and Varmedal, Ragnhild and Mortensen,
   Willy and Hartvigsen, Gunnar},
Editor = {Andersen, SK and Klein, GO and Schulz, S and Aarts, J and Mazzoleni, MC},
Title = {A System for Monitoring Physical Activity Data Among People with Type 2
   Diabetes},
Booktitle = {EHEALTH BEYOND THE HORIZON - GET IT THERE},
