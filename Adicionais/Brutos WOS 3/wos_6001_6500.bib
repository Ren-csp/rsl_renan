Title = {Alkalibacillus weihaiensis sp nov., a moderately halophilic
   bacterium from sea mud of the Yellow Sea, China},
Booktitle = {ADVANCES IN ENVIRONMENTAL SCIENCE AND ENGINEERING, PTS 1-6},
Series = {Advanced Materials Research},
Year = {2012},
