Year = {2004},
Volume = {1269},
Pages = {97-100},
Note = {1st International Symposium BrainIT 2004, Kitakyushu, JAPAN, MAR 07-09,
   2004},
Abstract = {In order to reveal the extent of the anisotropy and individual
   differences in stereoscopic depth contrast and Cornsweet illusion in
   depth, the magnitudes of these effects were measured with different
   slant orientations for 26 observers. About 30\% of observers showed a
   prominent anisotropy for depth contrast, while the anisotropy was not
   found for Cornsweet illusion in depth in spite of the previous research
   studies. The correlation between the results of these experiments was
   not significant (r = 0.163), suggesting that multiple factors affect
   these two illusions. (C) 2004 Elsevier B.V. All rights reserved.},
