@article{ WOS:000170336400003,
Author = {Adami, G and Miletic, M and Siviero, P and Barbieri, P and Reisenhofer,
   E},
Title = {Metal contents in tench otoliths: Relationsihips to the aquatic
   environment},
Journal = {ANNALI DI CHIMICA},
Year = {2001},
