@article{ WOS:000075032300016,
Author = {Shumow, L and Vandell, DL and Posner, J},
Title = {Perceptions of danger: A psychological mediator of neighborhood
   demographic characteristics},
Journal = {AMERICAN JOURNAL OF ORTHOPSYCHIATRY},
Year = {1998},
Volume = {68},
Number = {3},
Pages = {468-478},
Month = {JUL},
Note = {Biennial Meeting of the Society-for-Research-in-Child-Development,
   WASHINGTON, DC, APR 03-06, 1997},
Organization = {Soc Res Child Dev},
Abstract = {Associations between neighborhood characteristics and adjustment of 168
   urban fifth-grade children were explored. High neighborhood risk was
   associated with parent and teacher reports of child misconduct, and with
   parent and child reports of child psychological distress, while child
   and parent perceptions of neighborhood dangers appeared to mediate these
   associations. Specific neighborhood aspects were also related to child
