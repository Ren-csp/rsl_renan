@inproceedings{ WOS:000073221600063,
Author = {Canavan, WA and Vandenberg, RS and Revell, S},
Editor = {Chilton, J},
Title = {A risk based corrective action approach using computer modelling at an
   urban leaking underground storage tank site},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {377-382},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {Leaking underground storage tanks (LUSTs) at gasoline service stations
   are a major source of groundwater contamination in urban areas.
   Application of a Risk-Based Corrective Action (RBCA) approach at a
   gasoline-contaminated underground storage tank site indicated that
   implementation of extensive soil and groundwater remediation was not
   warranted, nor was it always the most effective method of addressing
   soil and groundwater contamination problems. Data collected at an urban
   site in Queens, New York were used to model contaminant transport to
   predict the impact of known gasoline contamination of soil on the
   underlying groundwater. Computer models were calibrated with known site
   characteristics and estimates of contaminant mass loading to
   groundwater. Downgradient receptor concentrations were also obtained.
   The results of the RBCA approach utilizing computer modelling indicated
   that minimal risk of future groundwater contamination exists at the
   site, and that additional investigation and/or remediation is
   unnecessary.},
Publisher = {A A BALKEMA PUBLISHERS},
