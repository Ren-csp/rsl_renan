@inproceedings{ WOS:000552577400019,
Author = {Xu, Wei and Tian, Yin and Zhang, Haiyong and Zhang, Huiling and Wang,
   Zhongyan and Yang, Li and Zheng, Shuxing and Shi, Yupan and Zhao, Xing
   and Zhao, Dechun and Wang, Xiuxing and Pang, Yu and Li, Zhangyong},
Editor = {DelgadoGarcia, JM and Pan, X and SanchezCampusano, R and Wang, R},
Title = {Time-Varying Scalp EEG Network Patterns for Music Tempo Perception},
Booktitle = {ADVANCES IN COGNITIVE NEURODYNAMICS (VI)},
Series = {Advances in Cognitive Neurodynamics},
Year = {2018},
Pages = {151-156},
Note = {6th International Conference on Cognitive Neurodynamics (ICCN), Carmona,
   SPAIN, AUG 01-05, 2017},
Organization = {CeslatiC Fdn; Cibertec S A; Univerlab S L; BioAvan I D I; Olavide
   Carmona Ctr; Pablo Olavide Univ; Pablo Olavide Univ, Div Neuroscience;
   CeslatiC Fdn, Ctr Latin Amer Studies Sci \& Culture; Carmona City Hall},
Abstract = {In the present study, we used the time-varying scalp network analysis
   method of electroencephalography (EEG) to investigate information flows
   among different tempos perception in the alpha band. The results showed
   the network hubs of different tempos existed variously. Only during
   listening to normal tempo (52 bpm), the strongest out-degree of hubs is
   distributed in the right hemisphere and the information flow transferred
   from the left to the right hemisphere. Based on these findings, we
   proposed that the left hemisphere did not prime the processing until the
   necessary information had been transferred from the right hemisphere.
   This study was the first to use time-varying network method based on
   adaptive directed transfer function (ADTF) to investigate music-related
   EEG activities and proposed a novel method to reveal the neural
   mechanisms on music tempo.},
