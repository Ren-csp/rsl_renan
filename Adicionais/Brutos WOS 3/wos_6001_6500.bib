@inproceedings{ WOS:A1996BH07T00016,
Author = {AboElNil, M},
Editor = {AlAwadhi, N and Balba, MT and Kamizawa, C},
Title = {Role of plant tissue culture propagation in the rehabilitation of desert
   Environment},
Booktitle = {RESTORATION AND REHABILITATION OF THE DESERT ENVIRONMENT},
Year = {1996},
Pages = {197-205},
Note = {Kuwait-Japan Symposium on Restoration and Rehabilitation of the Desert
   Environment, KUWAIT, MAR 03-04, 1996},
Organization = {Kuwait Inst Sci Res; Japan Petr Energy Ctr},
Abstract = {Native plants of Kuwait, which existed in fragile ecosystems, have been
   greatly affected by the activities of the war, either by effects of the
   oil pollution resulted from the burning of oil wells or the activities
   of men and machines. Genotypes of native plants, that can tolerate such
   stressful environmental conditions and have high ability to capture the
   site of introduction, are to be selected, preserved, propagated and
   utilized in an integrated microbial and phytoremediation scheme. Through
   application tissue culture technology, desired genotypes can be
   vegetatively propagated in a large scale and reintroduced into selected
   sites to play their role in desert rehabilitation. Native plants that
   are difficult to propagate with conventional methods are prime
   candidates for the tissue culture propagation. Plants, that are suitable
   for tissue culture propagation such as certain selected genotypes of
   Rhanterium epapposum (Arfaj), Gynandiris sisyrinchium (Kuwait Sawsan),
   Lycium shawii (Awsaaj), Nitraria retusa, Ochradenus baccatus and
   Gypsophila capillaris, were selected because of their ability to
   tolerate extreme adverse conditions such as oil pollution and physical
   abuse in addition to their potential for use in urban landscaping.
   Protocols for tissue culturing of Rhanterium epapposum and Gynandiris
   sisyrinchium plants were developed and a semi-pilot testing is in
   progress to assess the ability of these clones to grow in the
   rehabilitated soil.},
