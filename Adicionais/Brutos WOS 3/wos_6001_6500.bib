   Bauman, Adrian},
Editor = {Lai, PC and Mak, ASH},
Title = {Objectively Assessing `Walkability' of Local Communities: Using GIS to
   Identify the Relevant Environmental Attributes},
Booktitle = {GIS FOR HEALTH AND THE ENVIRONMENT: DEVELOPMENT IN THE ASIA-PACIFIC
   REGION},
