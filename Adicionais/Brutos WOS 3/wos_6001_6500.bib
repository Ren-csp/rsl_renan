@article{ WOS:000072042900003,
Author = {Blumenthal, JA},
Title = {The reasonable woman standard: A meta-analytic review of gender
   differences in perceptions of sexual harassment},
Journal = {LAW AND HUMAN BEHAVIOR},
Year = {1998},
Volume = {22},
Number = {1},
Pages = {33-57},
Month = {FEB},
Note = {9th Annual Meeting of the American-Psychological-Society, WASHINGTON,
   D.C., MAY 23-26, 1997},
Organization = {Amer Psychol Soc},
Abstract = {Courts and legislatures have begun to develop the ``reasonable woman
   standard{''} (RWS) as a criterion for deciding sexual harassment trials
   This standard rests on assumptions of a ``wide divergence{''} between
   the perceptions of men and women when viewing social-sexual behavior
   that may be considered harassing. Narrative reviews of the literature on
   such perceptions have suggested that these assumptions are only
   minimally supported. To test these assumptions quantitatively, a
   meta-analytic review was conducted that assessed the size, stability and
   moderators of gender differences in perceptions of sexual harassment.
   The effect of the actor's status relative to the target also was
   evaluated meta-analytically, as one alternative to the importance of
   gender effects. Results supported the claims of narrative reviews for a
   relatively small gender effect, and draw attention to the status effect.
   In discussing legal implications of the present findings, earlier claims
   are echoed suggesting caution in establishing the reasonable woman
   standard, and one alternative to the RWS, the ``reasonable victim
   standard,{''} is discussed.},
Publisher = {EDUCATIONAL PUBLISHING FOUNDATION-AMERICAN PSYCHOLOGICAL ASSOC},
