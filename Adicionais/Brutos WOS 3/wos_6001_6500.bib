@inproceedings{ WOS:001264250400042,
Author = {Scipione, Francesca and Baena, Jose Antonio Palenzuela and Di Risio,
   Marcello and Marsella, Maria Antonietta and Castellino, Myrta and De
   Girolamo, Paolo},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti. L},
Title = {Long-Term Evolution of the Shoreline of the South Lazio Region (Italy)
   Littoral Cell by Combining Historical Aerial Photography and Satellite
   Imagery},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 1, INPUT 2023},
