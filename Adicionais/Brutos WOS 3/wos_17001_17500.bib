   Rosa and Rubio Valladolid, Gabriel and Molina Arjona, Jose Antonio and
   Ellgring, Heiner},
Title = {Visuo-spatial interference affects the identification of emotional
   facial expressions in unmedicated Parkinson's patients},
Journal = {JOURNAL OF THE NEUROLOGICAL SCIENCES},
Year = {2012},
Volume = {313},
Number = {1-2},
Pages = {13-16},
Month = {FEB 15},
Note = {7th Congress of Mental and other Non-Motor Dysfunctions in Parkinson's
   Disease, Barcelona, SPAIN, DEC 09-12, 2010},
Abstract = {There is evidence that visuo-spatial capacity can become overloaded when
   processing a secondary visual task (Dual Task, DT), as occurs in daily
   life. Hence, we investigated the influence of the visuo-spatial
   interference in the identification of emotional facial expressions
   (EFEs) in early stages of Parkinson's disease (PD). We compared the
   identification of 24 emotional faces that illustrate six basic emotions
   in, unmedicated recently diagnosed PD patients (16) and healthy adults
   (20), under two different conditions: a) simple EFE identification, and
   b) identification with a concurrent visuo-spatial task (Corsi Blocks).
   EFE identification by PD patients was significantly worse than that of
   healthy adults when combined with another visual stimulus. Published by
   Elsevier B.V.},
