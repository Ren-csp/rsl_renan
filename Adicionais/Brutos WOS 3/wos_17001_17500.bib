@inproceedings{ WOS:000288182600025,
Author = {Yang, Zhihua and Huaying and Zhu, Lili and Weng, Hongwei},
Editor = {Zhang, JG and Jiang, Y and Zou, YL and Chem, JQ},
Title = {The Study on the Relationship between Human Adaptability and Physique
   Health},
Booktitle = {PROCEEDINGS OF THE 2010 INTERNATIONAL SYMPOSIUM ON CHILDREN AND YOUTH
   FITNESS AND HEALTH, VOL 3},
Year = {2010},
Pages = {100-105},
Note = {International Symposium on Children and Youth Fitness and Health,
   Nanjing, PEOPLES R CHINA, OCT 28-31, 2010},
Abstract = {Adaptability is an important part of human physique, and a prerequisite
   to comprehensively improve the quality of human life. The degree of
   adaptation is directly related with physique health. The study is based
   on the questionnaire and physique measurement of assessment of human
   adaptability to residents in a southern city, systematically analyzes
   the structural and functional relationship between adaptability and
   physique health. The results show that, there is low correlation between
   existing physique assessment system and adaptability total score (P <
   0.01); and correlation between sub-item of adaptability and physique
   measurement index is no more than 0.2, indicating that there is no
   multiple colinearity relationship between adaptability and sub-items of
   existing measurement system. Adults' adaptability displays different
   characters in three components. In the perspective of natural
   environment adaptability: (1) males are stronger than females; (2) high
   educated people are stronger than low educated people; (3) there is no
   difference between urban manual workers and non-manual workers. In
   social adaptability: (1) there are no significant differences between
   different genders and occupations, but there is in some items; (2) there
   is significant difference between the high educated and low educated. In
   the perspective of of anti-physiological and pathological capacity: (1)
   males are significantly stronger than females; (2) there are no
   differences between education backgrounds and occupations.},
