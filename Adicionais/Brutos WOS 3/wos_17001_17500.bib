Title = {A theme-based and network coupled framework for quantatitive indicators
   selection in ecological construction: a case study in Fujian, China},
Booktitle = {SUSTAINABLE DEVELOPMENT OF INDUSTRY AND ECONOMY, PTS 1 AND 2},
