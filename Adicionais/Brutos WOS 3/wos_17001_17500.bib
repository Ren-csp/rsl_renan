@article{ WOS:000253482700003,
Author = {Weigel, Daniel J.},
Title = {A dyadic assessment of how couples indicate their commitment to each
   other},
Journal = {PERSONAL RELATIONSHIPS},
Year = {2008},
Volume = {15},
Number = {1},
Pages = {17-39},
Month = {MAR},
Note = {Biannual Meeting of the
   International-Association-for-Relationship-Research, Rethymnon, GREECE,
   JUL, 2006},
Organization = {Int Assoc Relationship Res},
Abstract = {This study investigated the behaviors couples use to indicate their
   commitment in romantic relationships and explored the complex ways in
   which these behaviors are interconnected. Survey data were collected
   from 121 romantically involved couples in the United States. Dyadic
   analysis of the data revealed that the greater the levels of commitment,
   the more frequent the use of certain behaviors to indicate commitment.
   In addition, couples were similar in their use of the indicators, tended
   to project their self-perceptions onto their partners, and had a degree
   of accuracy in perceiving their partners' use of indicators. The
   research sheds light on some of the complex ways intimate couples
   experience and express commitment in the everyday lives.},
