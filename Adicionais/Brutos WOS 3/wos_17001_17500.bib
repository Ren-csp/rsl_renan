@article{ WOS:000245299200018,
Author = {Thush, C. and Wiers, R. W. and Theunissen, N. and Van den Bosch, J. and
   Opdenacker, J. and van Empelen, P. and Moerbeek, M. and Feron, F. J. M.},
Title = {A randomized clinical trial of a targeted intervention to moderate
   alcohol use and alcohol-related problems in at-risk adolescents},
Journal = {PHARMACOLOGY BIOCHEMISTRY AND BEHAVIOR},
Year = {2007},
Volume = {86},
Number = {2},
Pages = {368-376},
