@inproceedings{ WOS:000225835500020,
Author = {Lohmeyer, A and Radebeul and Baumüller, J and Flassak, T and
   Moldenhauer, A and Rühling, A},
Book-Group-Author = {VDI/VDE VERLAG},
Title = {Assessment and dispersion of odours in valley drainage flow -: Pay
   attention with low emission heights within hilly terrain!},
Booktitle = {ENVIRONMENTAL ODOUR MANAGEMENT: ODOUR EMISSION - ODOUR NUISANCE -
   OLFACTOMETRY - ELECTRONIC SENSORS - ODOUR ABATEMENT},
Series = {VDI BERICHTE},
Year = {2004},
Volume = {1850},
Pages = {169-177},
Note = {International Conference on Environmental Odour Management, Cologne,
   GERMANY, NOV 17-19, 2004},
Abstract = {It is reported about selected practical problems, occurring when low
   emission height sources as animal stables, composting or sewage
   treatment plants etc. are located in hilly terrain and release odours
   into valley drainage flows. There is only little dilution of the
   emissions as they are transported away in a valley drainage flow, thus
   relative high odour concentrations may occur up to unexpectedly large
   distances from the source. In case there are odour perceptions in valley
   drainage flows, these flows usually occur frequently enough to lead to
   an exceedance of the German limit values for the frequency of odour
   perceptions.
   The presentation provides an overview over the causes, the features and
   frequencies of occurrence of a valley drainage flow. It aims to raise
   the understanding for the physical processes. It addresses the reasons
   for the weak dilution of odour emissions in valley drainage flows and it
   addresses unfavourable locations and plant features in hilly terrain.
   Some information is given about a CD of the city of Stuttgart, enabling
   a user to check for all positions within the basin of Stuttgart, where
   the valley drainage flows come from and where they go. The contribution
   ends by presenting the results and interpretation of a calculation of
   the frequency of odour perceptions in the vicinity of a plant, planned
   in hilly terrain.},
