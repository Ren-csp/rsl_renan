@inproceedings{ WOS:000072818300012,
Author = {Latimer, JS},
Editor = {Baker, JE},
Title = {The significance of atmospheric deposition as a source of PCBs and PAHs
   to Narragansett Bay},
Booktitle = {ATMOSPHERIC DEPOSITION OF CONTAMINANTS TO THE GREAT LAKES AND COASTAL
   WATERS},
Series = {SETAC TECHNICAL PUBLICATIONS SERIES},
Year = {1997},
Pages = {227-243},
Note = {Session on Atmospheric Deposition of Contaminants to the Great Lakes and
   Coastal Waters, at the SETAC 15th Meeting, DENVER, CO, OCT 30-NOV 03,
   1994},
Organization = {Soc Environm Toxicol \& Chem; SETAC Fdn Environm Educ},
Abstract = {Atmospheric inputs of hazardous air pollutants have been investigated as
   part of an informal national network known as the Great Waters Study.
   Mandated by the 1991 amendments to the Clean Air Act, this study is
   aimed at providing environmental authorities with data quantifying the
   flux of contaminants to the coastal environment so that a framework for
   assessing ecological effects can be formulated. As part of this network,
   the Narragansett Bay Atmospheric Deposition Study was undertaken to
   collect precipitation and air samples from 1992 to 1994 and has produced
   assessments of pollutant deposition to Narragansett Bay. Over the entire
   course of the study, wet depositional flux of total PCBs was estimated
   to be 2.1 +/- 2.4 mu g/m(2)-y, and PAH fluxes (sum of 19 compounds) were
   observed to be 135 +/- 135 mu g/m(2)-y. Annual differences were not
   found to be statistically significant due to the large variations in
   concentration from one sample period to another. Mean dry particle
   fluxes, estimated from measured air concentrations and reported
   depositional velocities, were calculated to be from less than 1 to 28 mu
   g/m(2)-y for individual PAHs, and from 1.7 to 3.1 mu g/m(2)-y for total
   PCBs. As with the wet deposition, variability between samples was large.
   Moreover, published ranges for deposition velocity also reduce the
   certainty of these estimates. A comparison of atmospheric loadings with
   other sources of organic contaminants to Narragansett Bay indicates that
   atmospheric deposition of PCBs is, on average, 2\% of the total riverine
   and wastewater sources. In contrast, atmospheric deposition of PAHs is
   as significant a contributor to Narragansett Bay as are dry weather
   wastewater inputs, comprising 7\% or similar to 0.1 mtons of these
   contaminants to the estuary every year. The fluxes of PCBs to
   Narragansett Bay were similar to those reported for other segments of
   the Great Waters Study (e.g., Chesapeake Bay, Lake Michigan), and PAH
   fluxes were similar to estimates from Massachusetts Bay, but somewhat
   greater than observed in Chesapeake Bay. These differences may be due to
   the proximity of plumes associated with urban areas such as Boston, New
   York, or Providence, as well as sources nearer the site.},
Publisher = {SETAC PRESS},
Address = {1010 N 12TH AVE, PENSACOLA, FL 32501 USA},
