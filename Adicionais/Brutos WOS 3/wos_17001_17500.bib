Title = {For grasping brain architecture},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {428-430},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {We propose a simple model of the brain function on the basis of
   anatomical knowledge of the brain. Assuming three kinds of information,
   namely motor information(M), emotional information(E), sensory
   information(S), we analyse basic transitions among these information
   variables and discuss the strategy of the brain. For this purpose, an
   example of reasoning is introduced. The example suggests the possibility
   of the brain architecture such as (1) basal ganglia as a stabilizer of
   commands, (2) using meta-commands, (3) reinforcement-biased learning
   under the teacher of emotion, (4) using high level information for
   heuristics, (5) goal-directed reasoning. Some of possible learning rules
   are proposed, though making a concrete learning rule for these
   architectures is future work.},
