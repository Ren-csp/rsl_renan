@article{ WOS:000245155000008,
Author = {Tawfik, Linda and Watkins, Susan Cotts},
Title = {Sex in Geneva, sex in Lilongwe, and sex in Balaka},
Journal = {SOCIAL SCIENCE \& MEDICINE},
Year = {2007},
