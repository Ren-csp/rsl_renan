@inproceedings{ WOS:000226470700010,
Author = {Ao, CH and Lee, SC},
Editor = {Zhang, G and Hou, X and Yang, J and Tian, L and Zheng, C},
Title = {Photocatalyst TiO2 loaded on an activated carbon installed in
   air cleaner for air purification},
Booktitle = {BUILT ENVIRONMENT AND PUBLIC HEALTH, PROCEEDINGS},
Year = {2004},
Pages = {54-58},
Note = {2nd International Conference on Built Environment and Public Health
   (BEPH 2004), Shantou, PEOPLES R CHINA, DEC 06-08, 2004},
Organization = {Chinese Soc Environm Sci; Hunan Univ; Indoor Environm Comm, Engn Union
   CAST; Chinese Acad Building Mat Ind; Chinese Acad Environm Sci; Product
   Safety Super Adm China; Beijing Univ; Univ Hong Kong; Cent China Normal
   Univ; China Building Thermal Power Comm; Hong Kong Binhai Environm
   Consulting Ltd; UN, Environm Planning Bur; Int Soc Indoor Air Qual \&
   Climate; Int Council Res \& Innovat Building \& Construct; Int Initiat
   Sustainable Built Environm; Chinese Assoc Sci \& Technol; States Adm
   Environm Protect; Chinese Assoc Building Decorat; Chinese Soc Forestry;
   Shanton Maofa Telecom Real Estate Dev \& Management Co Ltd; Shenzhen
   McQuay Air Conditioning Co Ltd},
Abstract = {TiO2 immobilized on glass fiber filter (TiO2 filter) and activated
   carbon filter (TiO2/AC) filter was installed in a commercial air cleaner
   and tested inside an environmental chamber. Common indoor air pollutants
   such as NOx and toluene were selected as target pollutant. Results
   showed that the air cleaner without the installation of TiO2 filter or
   TiO2/AC filter removed only very little target pollutants. Compared to
   the TiO2 filter, TiO2/AC filter not only achieved a higher NO removal
   but also significantly suppressed the intermediate NO2 generated from
   the photodegradation of NO. Likewise, the concentration of the target
   pollutant reached a photo-steady-state faster using the TiO2/AC filter
   than the TiO2 filter. The higher removal efficiency of using TiO2/AC is
   owing to the synergistic effect between the TiO2 and the activated
   carbon. The adsorbed NO is then transferred to the TiO2 for
