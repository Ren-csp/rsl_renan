@inproceedings{ WOS:000393139700100,
Author = {Reddy, K. J. and Roth, T. R.},
Editor = {Ng, JC and Noller, BN and Naidu, R and Bundschuh, J and Bhattacharya, P},
Title = {Arsenic removal from natural groundwater using cupric oxide},
Booktitle = {UNDERSTANDING THE GEOLOGICAL AND MEDICAL INTERFACE OF ARSENIC, AS 2012},
Series = {Arsenic in the Environment},
Year = {2012},
Pages = {282-283},
Note = {4th International Congress on Arsenic in the Environment - Understanding
   the Geological and Medical Interface (As), Cairns, AUSTRALIA, JUL 22-27,
   2012},
Organization = {Royal Inst Technol; ISGSD; Univ So Queensland; Univ Queensland; Entox;
   Sustainable Minerals Inst, Ctr Mined Land Rehabil; SMI Technol Transfer,
   JK Tech; CRC CARE},
Abstract = {Groundwater is a main source of drinking water for rural areas. People
   in these rural areas are potentially at risk from elevated levels of
   Arsenic (As) due to a lack of water treatment facilities. The objectives
   of this study were to: (i) measure As concentrations in 46 groundwater
   samples from rural domestic wells in the western United States (US):
   (ii) explore the potential of Cupric Oxide (CuO) particles in removal of
   As from groundwater samples under natural conditions (i.e., without
   adding competing anions and adjusting the pH or oxidation state): and
   (iii) determine the effects of As removal on the chemistry of
   groundwater samples. More than 50\% of these samples exceeded the US EPA
   MCL (US Environmental Protection Agency Maximum Contaminant Limit) of 10
   mu g/L for As. Cupric oxide particles effectively removed As from
   natural groundwater samples across a wide range of pH (7.11 and 8.95)
   and concentrations of competing anions including phosphate (<0.05-3.06
   mg/L), silica (<1-54.5 mg/L), and sulfate (1.3-735 mg/L). Removal of As
   did not affect the chemistry of groundwater samples and most of the
   water quality parameters remained within the US EPA MCLs. Overall,
   results of this study could help develop a simple one-step process to
   remove As from groundwater.},
