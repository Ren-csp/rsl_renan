@article{ WOS:000456346900027,
Author = {Siregar, Ernie C. and Kartadinata, Sunaryo and Alimin, Zaenal and
   Santoso, Yoga Budhi},
Title = {Effectiveness of Applied Behavior Analysis and Floortime Methods
   Combination in Enhancing Cognitive and Functional Emotionals Ability
   Simultaneously of Children with Autism Spectrum Disorders},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2019},
Volume = {25},
Number = {1},
Pages = {122-125},
Month = {JAN},
Note = {5th International Conference on Advances Technology in
   Telecommunication, Broadcasting, and Satellite (TelSaTech), Jakarta,
   INDONESIA, OCT 21-22, 2017},
Abstract = {The objective of this research was using intervention by combine Applied
   Behavior Analysis and Floortime methods in improving cognitive and
   functional emotional ability simultaneously in children with autism
   spectrum disorders. Research design used Within-Group Experimental
   Design with Single-Subject Design (A/B Design). Intervention was given
   to two children with autism spectrum disorders under the age of four by
   combining learning activities using settings and techniques from highly
   structured Applied Behavior Analysis methods and play activities in a
   natural and fun setting. Educator and parents work together and gave
   intervention for 40 hours/week for 12 months. The results showed the
   combination of Applied Behavior Analysis and Floortime methods with
   natural-structural settings, effective in improving overall cognitive
   abilities, cognitive abilities associated with verbal and nonverbal
   reasoning, but not effective in enhancing functional emotional abilities
   in all children. The results of this study are expected to become
   alternative intervention to improve cognitive and functional emotional
   ability in children with autism spectrum disorders.},
