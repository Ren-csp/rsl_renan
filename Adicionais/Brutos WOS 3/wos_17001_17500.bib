@inproceedings{ WOS:000330024600023,
Author = {Hu, Guangming and Chan, Marjorie A. and Luo, Shunshe and Lv, Qiqi},
Book-Group-Author = {Destech},
Title = {A Perspective on Subsurface Fluvial Strata Correlation Methods},
Booktitle = {INTERNATIONAL CONFERENCE ON EARTH AND ENVIRONMENTAL SCIENCE},
Year = {2013},
