Title = {Informing Design through Sociocultural Values: Co-Creation with
   Low-Income African-American Older Adults},
Booktitle = {PROCEEDINGS OF THE 12TH EAI INTERNATIONAL CONFERENCE ON PERVASIVE
   COMPUTING TECHNOLOGIES FOR HEALTHCARE (PERVASIVEHEALTH 2018)},
