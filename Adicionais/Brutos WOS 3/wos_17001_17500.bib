@inproceedings{ WOS:000569050000120,
Author = {Voskresenskaya, Elena and Vorona-Slivinskaya, Lybov and Achba, Lybov},
Book-Author = {Kalinina, O},
Title = {Development of public services in the energy field in the age of digital
   economy},
Booktitle = {INTERNATIONAL SCIENCE CONFERENCE SPBWOSCE-2018: BUSINESS TECHNOLOGIES
   FOR SUSTAINABLE URBAN DEVELOPMENT},
