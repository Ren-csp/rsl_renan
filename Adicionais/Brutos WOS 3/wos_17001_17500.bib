@inproceedings{ WOS:000074493400115,
Author = {Coleman, SL and Brown, V and Levine, DS and Mellgren, RL},
Book-Group-Author = {IEEE},
Title = {A cognitive-emotional network model of foraging under predation risk},
Booktitle = {IEEE WORLD CONGRESS ON COMPUTATIONAL INTELLIGENCE},
Year = {1998},
Pages = {625-629},
Note = {2nd IEEE World Congress on Computational Intelligence (WCCI 98),
   ANCHORAGE, AK, MAY 04-09, 1998},
Organization = {Int Neural Network Soc; IEEE, Neural Networks Council; IEEE, Alaska Sect},
Abstract = {The cognitive emotional foraging model (CEF) is an unique application of
   a neural network to dynamical processes in foraging behavior. CEF is
   based directly on the neural network known as the gated dipole
   {[}1,2,3]. The gated dipole is capable of carrying out affective
   reactions to emotionally charged events in line with the opponent
   process theory of emotion {[}9]. CEF incorporates a trade-off-between
   foraging and the danger of predation under varying levels of motivation
   induced by hunger. The results of simulations of foraging decisions
   indicate that the CEF model is capable of near optimal foraging in a
   simple patch selection paradigm compared to a random decision rule and a
   rule of thumb model.},
