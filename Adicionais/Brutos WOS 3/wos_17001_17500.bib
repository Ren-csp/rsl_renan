@inproceedings{ WOS:000075208500036,
Author = {Dock, L},
Book-Group-Author = {RES CTR KARLSRUHE},
Title = {Human exposure monitoring and bioavailability issues},
Booktitle = {CONTAMINATED SOIL `98, VOLS 1 AND 2},
Year = {1998},
Pages = {321-329},
Note = {6th International FZK/TNO Conference on Contaminated Soil (ConSoil 98),
   EDINBURGH, SCOTLAND, MAY 17-21, 1998},
Organization = {Forschungszentrum Karlsruhe, Tech \& Umwelt; Netherlands Org Appl Sci
   Res; Scottish Enterprise, UK},
Abstract = {Human exposure monitoring through the analysis of contaminant
   concentrations in suitable biological media provides valuable
   information for the risk assessment of contaminated sites. The
   association between soil lead levels and blood lead levels in children
   living in urban, smelter and mining communities is one example. The
   association (slope factor) largely depends on the bioavailability of the
   contaminant in a soil matrix. Experimental animal systems to test the
   bioavailability of soil contaminants are being developed, and the uptake
   and toxicity of arsenic in soil from three wood treatment plants is
   presented as an example.},
