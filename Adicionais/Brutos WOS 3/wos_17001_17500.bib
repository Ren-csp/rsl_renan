@article{ WOS:A1995UD84800001,
Author = {Dozois, DJA and Dobson, KS and Wong, M and Hughes, D and Long, A},
Title = {Factors associated with rehabilitation outcome in patients with low back
   pain (LBP): Prediction of employment outcome at 9-month follow-up},
Journal = {REHABILITATION PSYCHOLOGY},
Year = {1995},
Volume = {40},
Number = {4},
Pages = {243-259},
Month = {WIN},
Note = {Canadian-Psychological-Association Annual Convention, PENTICTON, CANADA,
   JUL   02, 1994},
Organization = {Canadian Psychol Assoc},
Abstract = {This study examined which admission and treatment change variables
   predicted return to work in a population of patients with work-related
   LBP. Pain and disability perception, coping strategies, depression, and
   functional status were examined at admission and discharge in a sample
   of 117 injured male workers who participated in an interdisciplinary
   rehabilitation program. Discriminant function analyses, using employment
   status 9 months later as the dependent variable resulted in correct
   classification rates of 79\%, using admission and treatment change
   scores as predictors. Psychological factors at admission were the
   salient variables that emerged in the prediction of employment outcome
   at follow-up. Of the treatment change variables, physical status and
   one's perception of his/her disability significantly predicted return to
   work. Results of this study may be beneficial in optimizing the
   allocation of scarce health-care resources.},
