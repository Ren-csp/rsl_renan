@article{ WOS:000232862900002,
Author = {Kenning, P and Plassmann, H},
Title = {NeuroEconomics: An overview from an economic perspective},
Journal = {BRAIN RESEARCH BULLETIN},
Year = {2005},
Volume = {67},
Number = {5, SI},
Pages = {343-354},
Month = {NOV 15},
Note = {2nd Conference on NeuroEconomics, Munster, GERMANY, MAY 25-27, 2004},
Organization = {Stift Neuromed, Med Fdn; Gesell Forder Westfal Wilhelms Univ Munster eV;
   German Minist Educ \& Res; Wilhelm Lorch Stift; Philips Med Syst; HMK
   comp Technologies GmbH; Covilex; Medres Med Res GmbH},
Abstract = {Until now, economic theory has not systematically integrated the
   influence of emotions on decision-making. Since evidence from
   neuroscience suggests that decision-making as hypothesized in economic
   theory depends on prior emotional processing, interdisciplinary research
   under the label of ``neuroeconomics{''} arose. The key idea of this
   approach is to employ recent neuroscientific methods in order to analyze
   economically relevant brain processes. This paper aims to provide an
   overview of the current state of neuroeconomic research by giving a
   brief description of the concept of neuroeconomics, outlining methods
   commonly used and describing current studies in this new research area.
   Finally, some future prospects and limitations are discussed. (c) 2005
   Elsevier Inc. All rights reserved.},
