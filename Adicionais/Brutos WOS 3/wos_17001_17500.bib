@inproceedings{ WOS:000425331200006,
Author = {Calisto, Maria de Lurdes},
Editor = {Rich, M},
Title = {Senior-level Managers' Traits and the Assessment of Intrapreneurial
   Behaviour - Exploring the Relevance of Bounded Rationality},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2017},
Pages = {42-49},
Note = {13th European Conference on Management, Leadership and Governance
   (ECMLG), City Univ London, Cass Business Sch, London, ENGLAND, DEC
   11-12, 2017},
Abstract = {Studies in the area of corporate entrepreneurship are consistent in
   demonstrating the importance of managerial support to foster
   intrapreneurial behaviour and that this support is provided under the
   belief that employees, even at operational level, are relevant
   contributors to innovation. Based on the theory of bounded rationality,
   the goal of this study is to explore how senior-level managers' traits,
   such as risk propensity, tenure and formal education level might
   influence their assessment of the level of intrapreneurial behaviour in
   their firms, with potential consequences on decision making. Based on a
   heterogeneous sample of 93 firms/managers, the traits of managers that
   assess employees as very intrapreneurial and that of managers that
   assess employees as not intrapreneurial are compared. Results have
   relevant theoretical and practical implications.},
