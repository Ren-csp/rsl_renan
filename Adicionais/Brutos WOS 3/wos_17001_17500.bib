Title = {Dipole source modelling of pain-related brain responses: a
   magnetoencephalographic study},
Booktitle = {BRAIN TOPOGRAPHY TODAY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1997},
Volume = {1147},
Pages = {97-102},
Note = {III Pan-Pacific Conference on Brain Topography (BTOPPS III), TOKYO BAY,
   JAPAN, APR 01-04, 1997},
Abstract = {We applied a painful CO2 laser beam to the forearm of II normal
   subjects, and estimated the activated areas using a
   magnetoencephalography (MEG) and a brain electric source analysis (BESA)
   as a spatiotemporal multiple source analysis method. The second sensory
   cortex (SII) and the anterior medial temporal area (probably the
   amygdalar nuclei or hippocampal formation) in bilateral hemispheres were
   activated being temporally overlapped. The importance of the amygdalar
   nuclei and the hippocampal formation for pain perception was variable
   among subjects. This finding suggests a complicated processing of pain
   perception in humans. Activity in the primary sensory cortex (SI)
   contralateral to the stimulated site was very small or absent.
   Activities in the cingulate cortex were also not clearly identified,
   because such activity is probably located in the deep area.},
