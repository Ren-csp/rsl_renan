   REED COLL,DEPT PSYCHOL,PORTLAND,OR.},
DOI = {10.1037/0022-3514.72.5.965},
ISSN = {0022-3514},
Keywords-Plus = {COGNITIVE MODELS; INTERGROUP CONTACT; GROUP MEMBERS; DISCONFIRMATION;
