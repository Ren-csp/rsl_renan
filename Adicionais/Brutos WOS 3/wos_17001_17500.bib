Year = {2017},
Volume = {23},
Number = {8},
Pages = {7750-7753},
Month = {AUG},
Note = {2nd International Research Conference on Business and Economics (IRCBE),
   Semarang, INDONESIA, AUG 03-04, 2016},
Abstract = {The Halal industry has grown in importance in the global economy in the
   recent years. In food service industry, the increased awareness of Halal
   has compelled service providers, regardless of their religious
   affiliation, to pay more attention on consumers' assessment of service
   quality which may lead to return visits. This research explored
   evaluation of service quality in Halal restaurants from Muslim and
   non-Muslim consumers' perspectives. By asking the question, ``how do
   consumers assess service quality in Halal restaurants{''}?, the study
   applied a qualitative method. Focus groups were conducted in two states
   of Malaysia and respondents were Muslim and non-Muslim patrons of Halal
   restaurants. Our findings revealed that there are common attributes
   namely cleanliness, food quality and employees' service delivery deemed
   important attributes in the assessment of service quality, while other
   attributes have been assessed differently. We discuss the implications
   and future directions of research.},
