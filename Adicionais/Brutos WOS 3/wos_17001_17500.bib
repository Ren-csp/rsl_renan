@inproceedings{ WOS:001753451400001,
Author = {Al-Zrigat, Zaid M. and Abu-Zreig, Majed},
Editor = {Mohammad, P and Shahfahad and Matamanda, AR and Rodrigo-Comino, J},
Title = {Integrating Computational Architecture in Sustainable Schools Design: A
   Case Study of Al-Mreigha Mixed Basic School},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 2},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
