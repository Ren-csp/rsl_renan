@inproceedings{ WOS:000594132100006,
Author = {Puspitasari, I, A. and Pradana, H. A. and Novita, E. and Purnomo, B. H.
   and Rini, T. S.},
Editor = {Sumardi},
Title = {Environmental risk analysis of The Bedadung Watershed By Using DPSIR},
Booktitle = {SECOND INTERNATIONAL CONFERENCE ON ENVIRONMENTAL GEOGRAPHY AND GEOGRAPHY
   EDUCATION (ICEGE)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
