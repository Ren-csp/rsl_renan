Title = {End-User Experiences and Expectations Regarding Data Registration and
   Reuse Before the Implementation of a (New) Electronic Health Record: A
   Case Study in Two University Hospitals},
Booktitle = {MEDINFO 2015: EHEALTH-ENABLED HEALTH},
