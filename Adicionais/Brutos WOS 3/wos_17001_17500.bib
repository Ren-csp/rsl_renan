@inproceedings{ WOS:000264639100022,
Author = {Megrahi, M. S. and Karani, G. and Morris, K.},
Editor = {Popescu, D and Bacanu, G and Manolea, G and Fantis, DK and Iliescu, M and Boscoianu, M},
Title = {A Pilot study to determine radon at a Materials Recycling Facility (MRF)
