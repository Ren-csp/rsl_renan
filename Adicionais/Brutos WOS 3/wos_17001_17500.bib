@inproceedings{ WOS:000422901100018,
Author = {Asrina, M. and Gunawan, A. and Aris, Munandar},
Editor = {Kaswanto, RL},
Title = {Identification Of Minangkabau Landscape Characters},
Booktitle = {2ND INTERNATIONAL SYMPOSIUM FOR SUSTAINABLE LANDSCAPE DEVELOPMENT},
