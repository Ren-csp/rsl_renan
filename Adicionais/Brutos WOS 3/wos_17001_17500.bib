@inproceedings{ WOS:000538681000028,
Author = {Tsigkas, Ioannis and Panaras, Giorgos},
Book-Group-Author = {IOP},
Title = {District Cooling Application on an Existing District Heating
   Infrastructure: Technologies and Potential},
Booktitle = {SUSTAINABILITY IN THE BUILT ENVIRONMENT FOR CLIMATE CHANGE MITIGATION
   (SBE19)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2020},
