@article{ WOS:000175007600005,
Author = {Eidels-Dubovoi, S},
Title = {Aerosol impacts on visible light extinction in the atmosphere of Mexico
   City},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {2002},
