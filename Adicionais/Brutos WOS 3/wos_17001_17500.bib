@inproceedings{ WOS:000248200500045,
Author = {Assaf, H. and Saadeh, M.},
Editor = {Brebbia, CA and Katsifarakis, KL},
Title = {Assessing groundwater quality conditions in the upper Litani River Basin
   utilizing geostatistical analysis tools},
Booktitle = {RIVER BASIN MANAGEMENT IV},
