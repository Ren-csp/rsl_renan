@inproceedings{ WOS:000560252800130,
Author = {Wang, Xi and Dong, Congguo and Zhang, Shengnan and Dong, Fang},
Book-Group-Author = {IOP},
Title = {Study on Spatial and Temporal Pattern of Intensive Utilization of
   Farmland in Jinan},
Booktitle = {2018 INTERNATIONAL CONFERENCE ON CONSTRUCTION, AVIATION AND
   ENVIRONMENTAL ENGINEERING},
Series = {IOP Conference Series-Earth and Environmental Science},
