Title = {A study of the experimental teaching on sense of space and stereo visual
   illusion},
Booktitle = {INNOVATION, COMMUNICATION AND ENGINEERING},
Year = {2014},
Pages = {665-668},
Note = {2nd International Conference on Innovation, Communication and
   Engineering (ICICE), Qingdao, PEOPLES R CHINA, OCT 26-NOV 01, 2013},
Organization = {China Univ Petr; Taiwanese Inst Knowledge Innovat},
Abstract = {The study mainly explores the sense of space in visual design and guides
   students through the concept of perspective. In the beginning of the
   development of creating multi-dimensional images, the study includes
   comprehending the theoretical knowledge, guiding students to think via
   multi-dimensional design, and finally crating multi-dimensional works by
   participated students. The curriculum consists of three aspects: the
   concept of three-dimensional space, the principle of visual perception,
   and the expression of visual design. The teaching material of optical
   illusion by Bauhaus master Joseph Albers will be taken as the basic
   principle, supplemented with the expression of perspective in the field
   of perception and hypercube in formation design. Through the
   experimental process of guiding students to create multi-angle images,
   it is expected to survey the image variation from the side of creator
   and viewer in visual design system.},
