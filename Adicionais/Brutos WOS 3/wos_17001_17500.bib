@article{ WOS:000077893200102,
Author = {Goodchild, RG},
Title = {EU Policies for the reduction of nitrogen in water: the example of the
   Nitrates Directive},
Journal = {ENVIRONMENTAL POLLUTION},
Year = {1998},
Volume = {102},
Number = {1},
Pages = {737-740},
Note = {1st International Nitrogen Conference 1998, NOORDWIJKERHOUT,
   NETHERLANDS, MAR 23-27, 1998},
Organization = {Netherlands Minist Housing, Spatial Planning \& Environment (VROM)},
Abstract = {The European Community has been taking measures concerned with the
   nitrogen pollution of water for over twenty years. During the last ten
   years two very significant directives have been adopted, namely the
   Nitrates Directive and the Urban Waste Water Treatment Directive. The
   Nitrates Directive seeks to prevent the pollution of waters by nitrates
   from agricultural sources by requiring Member States to place mandatory
   restrictions on agricultural practices where these contribute to the
   nitrate pollution of waters. Implementation of this directive is
   severely behind schedule. This paper reviews the possible reasons for
   this before briefly considering the implications of these for a more
   integrated nitrogen policy.},
