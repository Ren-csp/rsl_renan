@article{ WOS:000167404200010,
Author = {Wilson, EA},
Title = {Darwin's nervous system: Investigating critical and physiological
   psychologies},
Journal = {AUSTRALIAN PSYCHOLOGIST},
Year = {2001},
Volume = {36},
Number = {1},
Pages = {62-69},
Month = {FEB},
Note = {Darwin Undisciplined Conference, SYDNEY, AUSTRALIA, MAR, 1999},
Abstract = {Critical psychologists have tended to shy away from evolutionary
   explanations of psychology and behaviour. The conventionalising claims
   of sociobiology and evolutionary psychology have been so widely deployed
   that there seems to have been no room for different uses of Darwin's
   work. Against these trends, this article argues that certain aspects of
   Darwin's evolutionary theories are enabling for a critical approach to
   psychology. The article explores the role given to neurophysiology in
   Darwin's most identifiably psychological work, The Expression of
   Emotions in Man and Animals. Special attention is paid to reflex action,
   organic sympathy, and blushing, and, through these examples, it is
   argued that a Darwinian system provides an excellent framework for
   thinking psychology critically.},
