@inproceedings{ WOS:000394555000006,
Author = {Mitrofan, Nicolae},
Editor = {Todea, GV},
Title = {INSTITUTIONAL ADAPTATION OF PRISONERS VIEWED FROM A PSYCHOSOCIAL
   PERSPECTIVE},
Booktitle = {APPLIED PSYCHOLOGY, THE PERSON AND THE TECHNOLOGIES OF THE XXI CENTURY},
Series = {Conferinta Internationala de Psihologie Aplicata},
Year = {2010},
Pages = {42-47},
Note = {6th International Conference on Applied Psychology, the Person and the
   Technologies of the 21st Century, Timisoara, ROMANIA, OCT 08-11, 2009},
Organization = {Uniunea Fundatia Augusta},
Abstract = {There are two kinds of variables as far as detainee adjustment is
   concerned: a) objective variables; b) subjective variables. The
   objective variables are related to the detainee's living conditions and
   activity, they do not depend on his will, they are imposed from outside
   and have to be accepted. The subjective variables lead to the
   configuration of what we call the detainee's psychology{''} and they are
   the following: a) the way the detainee himself relates to his own, crime
   and this attitude may be of different kinds: a1) admitting and accepting
   his bad action, its seriousness and the social peril; a(2)) an
   unwillingness to accept the idea of breaking the law in itselfi a(3))
   non-acceptance of commiting the bad action as a whole, as it has been
   ruled by the judge; a(4)) admitting to commiting the crime but rejecting
   the degree of guilt; a(5)) accepting to committing the crime, but
   rejectng the degree of guilt, without any founded reasons. b) the way in
   which the detainee relates to his sentence; different possibilities: b,)
   accepting the sentence for what he has done; b(2)) non-acceptance of
   sentence considering that it is too harsh; b(3)) non-acceptance of the
   sentence, as the detainee considers himself innocent; b(4))
   non-acceptance of the sentence, considering that the crime has not been
   committed in the way presented by the sentence; c) the way in which the
   detainee relates to himself; to his new status; the detainee is a person
   who has committed a serious offeence, rejected by society. He has
   largely lost the subidentities prior to his conviction; d) the way he
   sees his future after he is released, his project for the future. The
   knowledge of these subjective variables as well as their subvariables
   is, definitely, extremely useful for those in charge with administrating
   various intervention programmes during the detention period.},
Publisher = {EDITURA EUROBIT},
Address = {STR MARTIR HERMAN SPORER, BL 38, SC D, AP 8, TIMISOARA, 300575, ROMANIA},
Type = {Proceedings Paper},
Language = {English},
