@inproceedings{ WOS:000769071200024,
Author = {Jesmin, Sabrina and Kaiser, M. Shamim and Mahmud, Mufti},
Editor = {Mahmud, M and Vassanelli, S and Kaiser, MS and Zhong, N},
Title = {Artificial and Internet of Healthcare Things Based Alzheimer Care During
   COVID 19},
Booktitle = {BRAIN INFORMATICS, BI 2020},
