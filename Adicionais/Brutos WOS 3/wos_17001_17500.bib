@article{ WOS:000175907800008,
Author = {Wolf, RC and Bond, KC},
Title = {Exploring similarity between peer educators and their contacts and
   AIDS-protective behaviours in reproductive health programmes for
   adolescents and young adults in Ghana},
Journal = {AIDS CARE-PSYCHOLOGICAL AND SOCIO-MEDICAL ASPECTS OF AIDS/HIV},
