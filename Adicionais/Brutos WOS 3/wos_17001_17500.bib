Title = {Job related values, motivation and stress: Psychosomatic inpatients
   compared to a population-based representative sample},
Booktitle = {1ST WORLD CONGRESS OF THE INTERNATIONAL SOCIETY OF PHYSICAL AND
   REHABILITATION MEDICINE (ISPRM I)},
Year = {2001},
Pages = {713-717},
Note = {1st World Congress of the
   International-Society-of-Physical-and-Rehabilitation-Medicine (ISPRM I),
   AMSTERDAM, NETHERLANDS, JUL 07-13, 2001},
Organization = {Int Soc Phys \& Rehabilitat Med},
Abstract = {Stress at the working place is a risk factor of psychosomatic disorders.
   In the long term outcome changes in the individual value system, stress
   perception and coping and job related motivation is expected. In 1999
   consecutively admitted employed inpatients (n=1479) of a psychosomatic
   hospital answered a questionnaire containing items concerning
   job-related stressors, hierarchy of values, differential satisfaction
   and job motivation. These items were also raised in representative
   surveys (Socio Economic Panel, n>13000). Patients showed no differences
   in the job-related value system but significantly more conflicts with
   superiors, nervous strain an problems with colleagues. They are less
   content with health, profession and leisure time activities.
   Psychosomatic patients are not less job-motivated but have difficulties
   in social communication and coping with stress. The coincidence of poor
   self-efficacy experiences and ``normal{''} job motivation is decisive
   for the perception of stress.},
