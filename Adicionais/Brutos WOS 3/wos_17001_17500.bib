@inproceedings{ WOS:000257018300037,
Author = {Qui, L. M. and Cong, R. F. and Yao, D.},
Editor = {Li, G and Jia, Z and Fu, Z},
Title = {Investigation of terrestrial radiation in Qingdao, E China},
Booktitle = {2008 PROCEEDINGS OF INFORMATION TECHNOLOGY AND ENVIRONMENTAL SYSTEM
   SCIENCES: ITESS 2008, VOL 2},
Year = {2008},
Pages = {183-186},
Note = {International Conference on Informational Technology and Environmental
   System Science, Henan Polytechn Univ, Jiaozuo, PEOPLES R CHINA, MAY
   15-17, 2008},
Abstract = {The terrestrial radiation received by the living beings on the earth is
   mainly from radionuclides in soil and rocks such as K-40, Th-232 and
   U-238. These radionuclides vary with geological environment and other
   factors. Studies have shown that the radioactivity level is relatively
   high in granite-exposed areas. The analysis of natural radionuclide
   level and the relationship between radionuclide and geological structure
   and lithology in Qingdao with granite basement is very important for
   land use and planning, strengthening the residents' consciousness of
   preventing the radioactive rays. High density grid measurement of K-40,
   Th-232 and U-238 concentration in the urban of Qingdao was conducted
   using FD-3022 (four lines) gamma. spectrometer. Comparing with the
   average level of the ground radionuclide of Shandong province and the
   world, the concentrations of K-40, Th-232 and U-238 in Qingdao are
   relatively high. The high radiation is mainly from the geological
   background of granite bodies in the research area and influenced by
   fault belts and potassic alteration. The authors suggest that the
   recreation area and school should not construct at syenogranite body and
   syenitic granite porphyry dike and fault zone, syenogranite and syenitic
   granite porphyry should not be used as constructive materials, and
   appropriate shielding is effective and necessary for natural radiation
   protection.},
