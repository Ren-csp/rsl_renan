@inproceedings{ WOS:000323462600015,
Author = {Wang Yongyue and Zhu Tao},
Editor = {Xie, T and Hale, L and Sun, L},
Title = {The Effect of a Manager's Personality on Psychological Contracts},
Booktitle = {PROCEEDINGS OF THE SECOND INTERNATIONAL SYMPOSIUM ON PUBLIC HUMAN
   RESOURCE MANAGEMENT},
Year = {2013},
Pages = {66-73},
Note = {2nd International Symposium on Public Human Resource Management,
   Zhejiang Gongshan Univ, Sch Business Adm, Hangzhou, PEOPLES R CHINA, OCT
   26-28, 2012},
Organization = {Zhejiang Univ, Psychol \& Behav Sci Dept; Zhejiang Gongshan Univ, Sch
   Business Adm; State Adm Foreign Experts Affairs China, Train Ctr; Int
   Publ Management Assoc Human Resources; Univ S Florida, Educ Coll; Amer
   Scholers Press},
Abstract = {Most previous researchers studied the relationship between personality
   traits (most commonly, the big five personality traits) and
   psychological contracts in a Western cultural background. However,
   little is known about the relationship between personality traits and
   psychological contracts in the unique economic and cultural background
   of Mainland China. To fill this research gap, we investigated the
   effects of the big five personality traits of enterprise managers on
   their perceptions of psychological contracts and psychological contract
   breaches. The results suggest that managers' conscientiousness predict
   the perception of transactional psychological contract; their
   neuroticism, extraversion and openness predict a relational
   psychological contract. In addition, results indicated that managers'
   neuroticism and agreeableness were the predictors of a transactional
   psychological contract breach and their neuroticism, openness, and
   extraversion were the predictors of a relational psychological contract
   breach. Theoretical and practical implications are further discussed.},
