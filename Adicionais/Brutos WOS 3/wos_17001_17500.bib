@inproceedings{ WOS:000270892200048,
Author = {Prevot, A. S. H. and Sandradewi, J. and Alfarra, M. R. and Szidat, S.
   and Lanz, V. A. and Perron, N. and Caseiro, A. and Kasper-Giebl, A. and
   Puxbaum, H. and Baltensperger, U.},
Editor = {Ranzi, E},
Title = {A comparison of new and classic methods to estimate the contribution of
   wood smoke at different sites in Switzerland},
Booktitle = {AAAS08: 2ND ADVANCED ATMOSPHERIC AEROSOL SYMPOSIUM},
