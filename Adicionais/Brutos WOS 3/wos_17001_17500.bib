Note = {3rd IASME/WSEAS International Conference on Energy and Environment, Univ
   Cambridge, Cambridge, ENGLAND, FEB 23-25, 2008},
Organization = {IASME; WSEAS},
Abstract = {This paper deals with the problems of the adaptive reuse of historic
   buildings. The main objective of the research is to explore challenges
   existing in developing sustainable adaptation strategies of existing and
   historic buildings by special attention to climate changes. It will be
   investigated that rehabilitation of existing and historic structures is
   nearly always superior to new or replacement construction in terms of
   the various aspects of sustainability. At the end it will be concluded
   that in order to look for a solution to the adaptation problems, there
   should be a multi-dimensional approach. The main concentration will be
   on use of the fuzzy methods of multiple-criteria techniques to look for
   a solution to the problems in the historic buildings in response to
   climate changes. The paper synopsizes a research in progress to extend
   the current body of knowledge into barriers to sustainable adaptive
   reuse of the historic buildings.},
