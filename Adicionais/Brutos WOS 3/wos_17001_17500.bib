   Young, Sansfica M.; Ishiga, H., Shimane Univ, Dept Geosci, Matsue, Shimane 6908504, Japan.
   Pitawala, A., Univ Peradeniya, Dept Geol, Peradeniya, Sri Lanka.},
DOI = {10.1016/j.apcbee.2012.03.010},
ISSN = {2212-6708},
Keywords = {Heavy metals; Pollution; Upper catchment; Polgolla reservoir; Mahaweli
   River},
