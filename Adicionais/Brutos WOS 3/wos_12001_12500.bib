Title = {Absence of knowledge, understanding, and perception of the heaven
   (symphase with the heaven) as approached by Halqeh mysticism},
Booktitle = {4TH WORLD CONFERENCE ON PSYCHOLOGY, COUNSELING AND GUIDANCE (WCPCG-2013)},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
Volume = {114},
Pages = {111-115},
Note = {4th World Conference on Psychology, Counseling and Guidance (WCPCG),
   Istanbul Kultur Univ, Istanbul, TURKEY, MAY 24-26, 2013},
Abstract = {The heaven does not behave according to mankind's wishes, yet people
   persist in imposing their demands and endless wishes on the universe,
   and everyone is extraordinarily entangled with it. The human being's
   greed and insatiable hunger plague them endlessly and they are imposing
   their right or wrong desires on the heaven all the time. This useless
   struggle is one of the factors that create physical, psycheal and mental
   diseases. Many have experienced how an unfulfilled wish can create
   depression and prepare the grounds for other mentosomatic diseases.
   Generally, in addition to expedience and effort, other factors are
   required to fulfill a wish that include:
   - Principle of achievability
   - Principle of no mutual conflict between demands
   - Principle of justice
   - Principle of no conflict between demands and the laws of the universe
