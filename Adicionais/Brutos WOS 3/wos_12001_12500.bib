@article{ WOS:000074737900009,
Author = {Bliem, HR},
Title = {Experimental and clinical exploration of a possible neural subsystem
   underlying configurational face processing},
Journal = {BRAIN AND COGNITION},
Year = {1998},
Volume = {37},
Number = {1},
Pages = {16-18},
Month = {JUN},
Note = {TENNET VIII - Theoretical and Experimental Neuropsychology Conference,
   MONTREAL, CANADA, JUN 16-18, 1997},
Abstract = {Face perception can be divided into global (configurational) and local
   (derail) processes (e.g., Bliem, 1994). Experimental studies on the
   effect of isoluminant stimuli conditions on perception of faces and
   experiments on the role of external/ internal face features as well as
   local details in face recognition reveal a clear dominance of
   configurational information processing for successful perception and
   recognition of faces. Based on these experiments and further detailed
   clinical tests a selective impairment of configurational face processing
   was found with a case of prosopagnosia due to bilateral
   occipito-temporal lesions. Results suggest damage of the magnocellular
   pathway underlying configurational apperceptive prosopagnosia.},
