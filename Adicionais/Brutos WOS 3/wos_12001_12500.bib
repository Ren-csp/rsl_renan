Title = {A SYSTEMATIC STUDY OF NATURAL VENTILATION CHARACTERISTICS IN A TALL
   RESIDENTIAL BUILDING WITH ATRIUM},
Booktitle = {FIFTH INTERNATIONAL WORKSHOP ON ENERGY AND ENVIRONMENT OF RESIDENTIAL
