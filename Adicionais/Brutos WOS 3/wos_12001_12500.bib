   Carneiro, Davide and Rieta, Jose J. and Alcaraz, Raul},
Editor = {Costin, HN and Magjarevic, R and Petroiu, GG},
Title = {Application of Meta Learning in Quality Assessment of Wearable
   Electrocardiogram Recordings},
Booktitle = {ADVANCES IN DIGITAL HEALTH AND MEDICAL BIOENGINEERING, VOL 2, EHB-2023},
Series = {IFMBE Proceedings},
Year = {2024},
