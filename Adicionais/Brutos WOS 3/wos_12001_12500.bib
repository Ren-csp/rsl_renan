@inproceedings{ WOS:000412358300008,
Author = {Bansal, Neha and Mukherjee, Mahua and Gairola, Ajay},
Editor = {Seta, F and Sen, J and Biswas, A and Khare, A},
Title = {Smart Cities and Disaster Resilience},
