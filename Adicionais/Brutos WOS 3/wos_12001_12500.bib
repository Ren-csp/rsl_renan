Series = {IUFRO RESEARCH SERIES},
Year = {2004},
Volume = {10},
Pages = {27-40},
Note = {Symposium on History and Forest Biodiversity - Challenges for
   Conservation, Louvain, BELGIUM, JAN, 2003},
Abstract = {Forest grazing and litter harvesting are examples of close
   interrelation-ship between arable land, pastures and forests, tracing
   back to the first colonization of mountainous regions. Vegetable manure
   had a high value for the farmer whose economy was based mainly on stock
   breeding, and it was as indespensable for the existence of the farm as
   fuel wood. However, unrestricted practice could not only greatly damage
   mountain forests but even their existence. This chapter deals with the
   measures taken by local populations in order to secure the available
   natural resources on a long-term basis, for the benefit of subsequent
   generations. In particular, the results of measures aimed at sustainable
   management have been reviewed and the impact of agroforesty on the
   preservation of soil fertility, the health of forest stands and the
   distribution of tree species has been investigated.},
