@article{ WOS:000238925400007,
Author = {Lu, Hongjing and Morrison, Robert G. and Hummel, John E. and Holyoak,
   Keith J.},
Title = {Role of gamma-band synchronization in priming of form discrimination for
   multiobject displays},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2006},
Volume = {32},
Number = {3},
Pages = {610-617},
Month = {JUN},
Note = {46th Annual Meeting of the Psychonomic-Society, Toronto, CANADA, NOV,
   2005},
Organization = {Psychonom Soc},
Abstract = {Previous research has shown that synchronized flicker can facilitate
   detection of a single Kanizsa square. The present study investigated the
   role of temporally structured,priming in discrimination tasks involving
   perceptual relations between multiple Kanizsa-type figures. Results
   indicate that visual information presented as temporally structured
   flicker in the gamma band can modulate the perception of multiple
   objects in a subsequent display. For judgments of both relative
   orientation and relative position of 2 rectangles, response time to
   identify and discriminate relations between the objects was consistently
   decreased when the vertices corresponding to distinct Kanizsa-type
   rectangles were primed asynchronously. Implications are discussed for
   models of the perception of objects and their interrelations.},
Publisher = {AMER PSYCHOLOGICAL ASSOC/EDUCATIONAL PUBLISHING FOUNDATION},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
