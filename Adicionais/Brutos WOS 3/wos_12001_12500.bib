@article{ WOS:000239126100008,
Author = {Astolfi, Maria Luisa and Canepari, Silvia and Cardarelli, Enrico and
   Ghighi, Silvano and Marzo, Maria Letizia},
Title = {Chemical fractionation of elements in airborne particulate matter:
   Primary results on PM10 and PM2.5 samples in the Lazio region (central
   Italy)},
Journal = {ANNALI DI CHIMICA},
Year = {2006},
Volume = {96},
Number = {3-4},
Pages = {183-194},
Month = {MAR-APR},
Note = {3rd National Symposium of the Division of Environmental and Cultural
   Heritage Chemistry of the Italian-Chemical-Society, Sassari, ITALY, MAY,
   2005},
Abstract = {This paper describe, how a two-step chemical fractionation method that
   allows the determination of 17 elements in airborne particulate matter.
   has been applied to a monitoring campaign of PM10 and PN12.5 in the
   Lazio region (Italy). This method involved ail extraction in a pH
   buffered aqueous solution followed by a microwave-assisted acid
   digestion of the residue. With respect to the determination of the total
   elemental contents, the evaluation of a Soluble fraction provides more
   reliable information oil the presence and of the destiny of heavy metals
   in the environment. Furthermore, the pH buffered extraction conditions
   chosen, tendered the results independent of the intrinsic acidity of the
   collected samples and, although the chemical fractionation has a purely
   operational function, it facilitates the study of the relationship
   between the distribution of solubility and the different emission
   sources. Results are discussed in relation to the different
   concentration and the different degrees of solubility of the elements
   observed in two sampling sites: one in an urban and one in a rural
   environment. Since in-parallel sampling of PM2.5 and PM10 were performed
   in both sites, the influence of particle size is also discussed.
   Behaviour of some tracers deriving from both vehicular traffic, with
   particular attention to re-suspended road dusts, and naturally generated
   particulate matter, such as marine aerosol and Saharian dust, are
   discussed.},
Publisher = {WILEY-V C H VERLAG GMBH},
Address = {PO BOX 10 11 61, D-69451 WEINHEIM, GERMANY},
Type = {Article; Proceedings Paper},
Language = {English},
