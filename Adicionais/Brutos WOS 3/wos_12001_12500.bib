@article{ WOS:A1992KA66900106,
Author = {CECCHI, F and PAVAN, P and MUSACCO, A and MATAALVAREZ, J and SANS, C},
Title = {COMPARISON BETWEEN THERMOPHILIC AND MESOPHILIC ANAEROBIC-DIGESTION OF
   SEWAGE-SLUDGE COMING FROM URBAN WASTE-WATER TREATMENT PLANTS},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1992},
Volume = {26},
