Year = {2016},
Pages = {96-100},
Note = {International Conference on Mental Health - Psychology, Medicine and
   Anthropology for Life Quality, Ploiesti, ROMANIA, SEP 09-11, 2016},
Abstract = {Some occupations, particularly so called ``people jobs{''}, in which
   employees are dealing with different type of clients, may require an
   employee to pretend to have emotions that they do not really have, or to
   actually experience required emotions. The current study aims at
   investigating the extent to which occupational stress and emotional
   labor strategies result in burnout for sales representatives. The study
   was conducted using a survey method of 40 sales consultants. The results
   showed strong correlations between occupational stress and faked and
   suppressed emotions (both positive and negative), and between
   occupational stress and core burnout (namely emotional exhaustion and
   depersonalization).},
