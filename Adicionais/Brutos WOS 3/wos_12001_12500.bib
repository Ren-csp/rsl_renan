@article{ WOS:000176222600032,
Author = {McPherson, TN and Burian, SJ and Turin, HJ and Stenstrom, MK and Suffet,
   IH},
Title = {Comparison of the pollutant loads in dry and wet weather runoff in a
   southern California urban watershed},
Journal = {WATER SCIENCE AND TECHNOLOGY},
