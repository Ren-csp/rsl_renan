@inproceedings{ WOS:000237755500054,
Author = {Hatzianestis, I. and Botsou, F.},
Editor = {Lekkas, TD},
Title = {Distribution of organochlorinated compounds in Saronikos gulf sediments},
Booktitle = {Proceeding of the 9th International Conference on Environmental Science
   and Technology Vol B - Poster Presentations},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2005},
Pages = {B331-B336},
Note = {9th International Conference on Environmental Science and Technology,
   Rhodes Isl, GREECE, SEP 01-03, 2005},
Organization = {Global Network Environm Sci \& Technol; Univ Aegean, Dept Environm
   Studies},
Abstract = {Organochlorinated compounds are ubiquitous contaminants whose occurrence
   in the marine environment is of special concern because of their
   resistance to degradation, their high bioaccumulative capability and the
   toxicity of most of their constituents. The use of these compounds has
   been banned since the mid 1970s, but as consequence of their high
   persistence, they continue to be detected in the marine environment.
   Keeping in mind that there are no data available in the literature
   reporting the organochlorine levels in Saronikos gulf, the aim of this
   work was to investigate the distribution, sources and impact of
   organochlorinated compounds in the gulf, a marine area receiving major
   urban discharges from the Athens metropolitan area and industrial
   effluents from the industries located at the northern part of the gulf.
   Surface sediments were collected from 15 stations in May 2004 and the
   organochlorinated compounds were determined by gas chromatography-ECD.
   Relatively high PCBs concentrations ranging between 28.7 and 88.1 ng/g
   were found only in Elefsis bay and in the area close to Athens sewage
   outlet in Psyttalia, while in the rest stations PCBs values were clearly
   lower (< 7 ng/g) with a decreasing trend from the urban coastal zone to
   the outer parts of the gulf. The congener distributions were generally
   dominated by hexa- and hepta- chloro substituted compounds in accordance
   with those found in highly chlorinated commercial formulations.
   DDTs concentrations (the sum of DDT and its main metabolites DDD and
   DDE) were generally lower than those of PCBs with a similar spatial
   distribution. However an extremely high value (> 400 ng/g) was found in
   the area noth-east of Psyttalia indicating a high degree of pollution at
   this location. The ratios of DDE and DDD to the sum of DDTs were
   calculated in order to evaluate whether the DDT inputs were recent or
   not. In all samples these ratios were much lower than unity and this is
   a strong indication that recent inputs of DDT still occur in the area
   despite the banning in its use since 1970s. This was especially true in
   the area close to Psyttalia where the main compound DDT accounted for
   more than 95\% of total DDTs.
   HCB and lindane concentrations were low in the whole area indicating the
   absence of contamination from these compounds.},
