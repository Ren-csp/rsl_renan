@inproceedings{ WOS:000189443700010,
Author = {Pollak, SD},
Editor = {King, JA and Ferris, CF and Lederhendler, II},
Title = {Experience-dependent affective learning and risk for psychopathology in
   children},
Booktitle = {ROOTS OF MENTAL ILLNESS IN CHILDREN},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2003},
Volume = {1008},
Pages = {102-111},
Note = {Conference on Roots of Mental Illness in Children, New York, NY, MAR
   15-17, 2003},
Organization = {NY Acad Sci; NIMH; Janssen Pharmaceutica Inc},
Abstract = {The influence of childhood affective experiences across development may
   be understood in terms of preparedness to learn about emotion, combined
   with general immaturity and neuro-plasticity of perceptual systems.
   Early in development, processing resources are relatively immature and
   limited in capacity, thereby constraining how much information the young
   child can absorb. But it is clear that learning about emotions proceeds
   swiftly in nearly all children, suggesting biological preparedness to
   track associations between certain stimuli and outcomes. It is proposed
   here that limited processing capacity, in tandem with dispositions to
   filter or select key privileged stimuli in the environment, facilitates
   adaptive, rapid, affective learning. The developmental organization of
   affective systems is contingent upon those features of input that are
   most learnable, such as signals that are particularly salient, frequent,
   or predictable. Therefore, plasticity confers risk for maladaptation in
   that children's learning will be based upon these prominent features of
   the environment, however aberrant.},
