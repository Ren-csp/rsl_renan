@inproceedings{ WOS:A1995BJ03L00002,
Author = {Dietrich, H},
Editor = {McLean, GD and Evans, G},
Title = {The good, the bad and the transgenic: Public perceptions of, and
   participation in, Australia's herbicide resistant crops industry},
Booktitle = {HERBICIDE-RESISTANT CROPS AND PASTURES IN AUSTRALIAN FARMING SYSTEMS},
Year = {1995},
Pages = {7-14},
Note = {Workshop on Herbicide-Resistant Crops and Pastures in Australian Farming
   Systems, CANBERRA, AUSTRALIA, MAR 15-16, 1995},
Organization = {Grains Res \& Dev Corp; Cotton Res \& Dev Corp; Rural Ind Res \& Dev
   Corp; Brit Council},
Abstract = {This paper proposes that only trans-institutional social and
   communication processes can effectively meet, mediate and control the
   current revolutionary techniques of transgenic and recombinant DNA
   science. A dynamic flow of information, debate and action is needed
   which assumes a systems analysis stance in viewing the introduction of
   herbicide resistant (HR) crops into the Australian sociobiological
   system. Most importantly, the various parties in this system;
   scientists, industrialists, `the public' and regulators, need to be seen
   as, and empowered to be, non-stereotypical actors in decision-making on
   the directions taken with HR science and technological application. This
   would reveal all parties need for socioeconomic benefit, ethical
   rightness and environmental safety. Further, it would release all
   parties/actors from false presentations of their intentions and
   capacities, thus allowing the already active capacities and efforts at
   individual's resolution of green, good and economically beneficial
   decisionmaking. This largely individualised effort, if supported to be
   effective at the institutional level, could avoid debilitating battles
   over `rights' of the parties and engage in real world resolution of
   interests consistent with ecologically (and ethically) sustainable
   development (ESD). The author argues that there is strong role for
   government in facilitating and supporting such a process.
   The propositions in the paper draw on the work of the author with the
   CSIRO Animal Husbandry Division. In this research, an anthropological
   study is utilising a systems approach to investigate how the real world
   of scientists, the public and regulators shapes the way GMO research
   proceeds. This paper offers ideas for regulation and public consultancy
   which would facilitate beneficial realisation of ESD and public
   participation ideals and rhetoric.},
Publisher = {BUREAU RESOURCE SCIENCES COMMONWEALTH AUSTRALIA},
