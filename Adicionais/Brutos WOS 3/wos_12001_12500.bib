Title = {ENDOTOXICOSIS AFTER PSYCHOLOGICAL CORRECTION},
Booktitle = {EDUCATION IN A CHANGING WORLD: GLOBAL CHALLENGES AND NATIONAL PRIORITIES},
Series = {European Proceedings of Social and Behavioural Sciences},
