Title = {Stochastic Resonance Married to Neuroscience: Adding Noise Can Turn
   Subconscious into Conscious Information},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2025},
Series = {Lecture Notes in Information Systems and Organization},
