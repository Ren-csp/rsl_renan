@inproceedings{ WOS:000238644700074,
Author = {Suro-Maldonado, R. and Gonzalez, A. and Rivera-Rentas, A.},
Editor = {Longhurst, JWS and Brebbia, CA},
Title = {Air quality, particulate matter, and geographic characterization in a
   potential asthma prone region of eastern central Puerto Rico},
Booktitle = {AIR POLLUTION XIV},
Series = {WIT Transactions on Ecology and the Environment},
