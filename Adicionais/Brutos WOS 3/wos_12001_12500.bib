@article{ WOS:000180041000043,
Author = {Karn, SK and Harada, H},
Title = {Field survey on water supply, sanitation and associated health impacts
   in urban poor communities - a case from Mumbai City, India},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {46},
Number = {11-12},
Pages = {269-275},
Note = {IWA Asia-Pacific Regional Conference, FUKUOKA, JAPAN, SEP 12-15, 2001},
Organization = {IWA},
Abstract = {A field survey was conducted on four slum, squatter and pavement dweller
   communities of Mumbai City, India with a total sample size of 1,070
   households. Study revealed extremely low water consumption pattern
   averaging merely 30 l/c.d, no sewerage and safe excreta disposal
   facilities manifested by high occurrence of water-borne diseases. The
   annual diarrhoeal, typhoid and malaria cases were estimated to 614, 68
   and 126 per thousand populations respectively. At point prevalence
   scale, at least 30\% of all morbidity can be accounted for by
   water-related infections. In addition to the impacts of neighborhood
   water pollution and sanitation, such diseases were also found positively
   correlated with low water consumption and poverty related factors as,
   poor housing and family income. Analysis of variance also revealed
   intra-poor gradient both in living standards and health conditions on
   which the pavement dwellers were observed to be the greatest sufferers
   of all.},
Publisher = {I W A PUBLISHING},
Address = {ALLIANCE HOUSE, 12 CAXTON ST, LONDON SW1H0QS, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Karn, SK (Corresponding Author), Nagaoka Univ Technol, Dept Environm Syst Engn, Nagaoka, Niigata 9402188, Japan.
