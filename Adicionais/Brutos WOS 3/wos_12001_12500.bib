Title = {Monitoring and analysis of China's integrated city development based on
   remote sensing: a case study of Guangfo city},
Booktitle = {SEVENTH INTERNATIONAL CONFERENCE ON REMOTE SENSING AND GEOINFORMATION OF
   THE ENVIRONMENT (RSCY2019)},
Series = {Proceedings of SPIE},
Year = {2019},
