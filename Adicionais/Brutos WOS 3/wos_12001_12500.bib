@inproceedings{ WOS:000173641300056,
Author = {Rivasplata, CR and Díaz, JF},
Editor = {Easa, S and Samdahl, D},
Title = {Improving regional mobility through transit integration},
Booktitle = {TRANSPORTATION, LAND USE, AND AIR QUALITY, CONFERENCE PROCEEDINGS:
   MAKING THE CONNECTION},
Year = {1998},
Pages = {529-538},
Note = {Conference on Transportation, Land Use, and Air Quality, PORTLAND, OR,
   MAY 17-20, 1998},
Organization = {Amer Soc Civil Engineers, Urban Transportat Div; Fed Highway Adm; Air \&
   Waste Management Assoc; Amer Assoc State Highway \& Transportat
   Officals; Inst Transportat Engineers; Canadian Soc Civil Engn; Natl
   Assoc County Engineers; ASCE Urban Planning \& Dev Div; ASCE United
   Kingdom Int Grp},
Abstract = {This paper reviews the role of transit integration in three world
   cities: London. San Francisco and Caracas. Studies have shown that the
   ongoing coordination of transit schedules, fares and transfer facilities
   can improve system connectivity and reliability, making transit a more
   attractive alternative to the automobile. Furthermore, they have shown
   that better use of transit and non-motorized transportation can
   effectively reduce automobile emissions and improve regional mobility.
   In turn, improved mobility can facilitate increased access to key
   employment, housing, shopping and recreational opportunities.
   This paper tracks past efforts to integrate transit services in the case
   cities through a literature search. Regardless of the regulatory
   environment, transit planners agree that one way to improve efficiency
   and reduce travel times is for a regional authority to promote
   integration as part of a comprehensive urban mobility plan. Ideally,
   this arrangement will yield improvements in the quality and
   affordability of alternative travel modes, intraurban mobility and
   access to transit centers.},
