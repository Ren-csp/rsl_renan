@inproceedings{ WOS:000179444800152,
Author = {Kumbaracibasi, C},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Could visual quality be assessed objectively: Square in Famagusta},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1251-1257},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The high subjectivity ratio and intuitively involved in visual aesthetic
   assessments is rather usual but unfair from the point of scientific
   reliability. Design and Planning disciplines do suffer greatly due to
   discrepancies and varying statements pertaining to the visual quality of
   urban and architectural environments.
   This paper intends to present a case study for the aesthetic quality
   assessment of Namik Kemal Square in Famagusta, TRNC, based on the method
   derived through a former research carried out by the author, which
   intends to increase the objectivity level in aesthetic evaluations. The
   main concept behind the method being the mutual integration of human
   perceptual properties with basic design principles had yielded very low
   comparative percentages of divergence in evaluation. Namik Kemal Square
   possessing both the historical and contemporary features appears to be
   an interesting example, beyond its visual charm. Definitely the main aim
   of the presentation would be to start a debate on possible applicability
   of this method on multiple design environments such as housing and urban
   developments as a quality assessment technique.},
