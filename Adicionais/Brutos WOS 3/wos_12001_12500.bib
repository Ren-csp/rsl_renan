Title = {The New Way of Urbanization against the Background of Sustainable
   Development--Take ``Mode of Chongqing{''} as an Example},
Booktitle = {URBANIZATION AND LAND RESERVATION RESEARCH},
Year = {2011},
Pages = {125-129},
Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {The sustainable development has been a new direction of the modern
   society and the theory and practice of sustainable development of
   urbanization are also being explored. Different from the traditional
   one, the new-type urbanization is ``to adhere to reach the strategic
   target of sustainable development, to achieve the coordination of
   population, resource, environment and development, to balance the urban
   and rural development and achieve the integration of urban and rural
   areas and to share the public service equally in urban and rural areas;
   meanwhile, it is marked by the equal opportunity to acquire and share
   wealth between urban and rural areas and even between urban areas; the
   ultimate object is to demolish the dual urban-rural structure and to
   realize the harmonious urbanization{''}. During recent years, a series
   of innovated, significant measures have been took in Chongqing in terms
   of urbanization, which has a wide and positive effect at home and
   abroad; furthermore, it is called ``mode of Chongqing{''} by the media,
   providing a totally new way for the urbanization. With the sustainable
   development as a backdrop, this thesis takes ``mode of Chongqing{''} as
   an example to analyse the special effect of urbanization on sustainable
   development and to uphold the urbanization with Chinese characteristics
   so as to offer a new way to the sustainable development of urbanization
   in China.},
