   Philipp and Lobaskova, Marina and Malykh, Sergey},
Editor = {Zinchenko, YP and Grigorenko, EL and Poeppel, E},
Title = {Genetic and Environmental Influences on the Individual Differences of
   Temperament in Primary School Children},
Booktitle = {V CONGRESS OF THE RUSSIAN PSYCHOLOGICAL SOCIETY},
