Organization = {NATO},
Abstract = {We presently know a great deal about how neurons represent basic
   features of the image formed on the retina. By contrast, we know very
   little about how neurons give rise to our visual perceptions. One reason
   for this limited knowledge is that perception is context dependent: The
   interpretation of a retinal image feature depends upon the spatial and
   temporal context in which the feature appears.},
