@article{ WOS:000182508200010,
Author = {Clarkson, PJ and Larrazabal-Moya, D and Staton, I and McLeod, CW and
   Ward, DB and Sharifi, VN and Swithenbank, J},
Title = {The. use of tree bark as a passive sampler for polychlorinated
   dibenzo-p-dioxins and furans},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL ANALYTICAL CHEMISTRY},
Year = {2002},
Volume = {82},
Number = {11-12},
Pages = {843-850},
Month = {DEC},
Note = {4th Euroconference on Environmental Analytical Chemistry, VISEGRAD,
   HUNGARY, SEP 14-19, 2000},
Abstract = {The potential of using tree bark as a passive sampling medium for
   detection of Polychlorinated dibenzo-p-dioxins and furans (PCDD/F) in an
   urban environment has been investigated. Bark samples (similar to 30g)
   were extracted with toluene using accelerated solvent extraction.
   Extracts were then cleaned up via a multi-bed silica column and-a
   Florisil column followed by GC-MS/MS analysis. It is shown that PCDD/F
   are present in tree bark collected from sites close to a municipal waste
   incinerator, a crematorium, a hospital and a chemical incinerator.
   Furthermore, characteristic patterns for dioxin congeners were observed
   for the suspected emission sources.},
