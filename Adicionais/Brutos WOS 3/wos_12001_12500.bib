@inproceedings{ WOS:000179444800050,
Author = {Keskin, B and Dokmeci, V and Kiroglu, G},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Determinants of housing prices in Turkey},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {387-392},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The purpose of this paper is to investigate the factors, which effect
   house prices in Turkey. After 1950's rapid urbanization and construction
   of highways in some cities have changed accessibility of various areas
   measurably and have thus caused a transformation in the pattern of
   land-use. These changes have created locational advantages and
   disadvantages reflected in the real estate market. While housing prices
   declined in the centers, they started to increase in the newly developed
   modern housing development areas.
   The price of housing differs substantially from city to city according
   to their development level. This paper investigates the factors, which
   effect house prices. Hedonic price method is used for the analysis.
   House price is taken as the dependent variable, age of the bulding,
   location, transportation, number of floors, accessibility, quality, hot
   water, living room area, floor area, view, number of rooms, elevator,
   parking, pool, heating, number of flats in the building, number of
   stories and house type, the existing of public facilities such as
   schools, hospitals.
   According to the results of the analysis at the country level, number of
   stories, living room area, the number of stories of the building,
   elevator, heating, parking, transportation pool is the most important
   variables to effect house prices. The determinants of the model explain
   \%53 of the variation in house price index. To expend the study to a
   larger sample of different size cities is suggested for further
   research.
   The results of this research have particular policy and planning
   implications and may help in producing more effective policies to
   upgrade existing settlements and discourage migration to larger cities.},
