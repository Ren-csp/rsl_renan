Title = {RISK ASSESSMENT OF DRINKING WATER SOURCE BASED ON HIGH SPATIAL
   RESOLUTION REMOTE SENSING},
Booktitle = {IGARSS 2020 - 2020 IEEE INTERNATIONAL GEOSCIENCE AND REMOTE SENSING
   SYMPOSIUM},
