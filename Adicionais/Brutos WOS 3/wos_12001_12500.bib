@inproceedings{ WOS:000316309000015,
Author = {Kerestecioglu, Funda and Basdogan, Serhat},
Editor = {Ozhan, E},
Title = {A Comparative Analysis of Cruise Ports on the Mediterranean: The Case of
   Istanbul},
Booktitle = {SECOND INTERNATIONAL CONFERENCE/WORKSHOP ON THE STATE-OF-THE-ART OF ICM
   IN THE MEDITERRANEAN \& BLACK SEA: IMMEDIATE NEEDS FOR RESEARCH,
   EDUCATION / TRAINING \& IMPLEMENTATION},
Year = {2009},
Pages = {135-146},
Note = {2nd International Conference/Workshop on the State-of-the-Art of ICM in
   the Mediterranean and the Black Sea: Immediate Needs for Research,
   Education / Training \& Implementation, Mugla, TURKEY, OCT 14-18, 2008},
Organization = {UNEP; Commiss Protect Black Sea Against Pollut; Priority Actions
   Programme; Municipal Akyaka; Middle E Tech Univ, Ocean Engn Res Ctr;
   Gazi Univ, Marine Sci Res \& Applicat Ctr},
Abstract = {As a historic coastal city and a commercial and cultural capital for
   nearly three thousand years, Istanbul has always had a direct connection
   with the seaside, where its citizens spent their daily lives. However,
   during the last decade, due to adjustment efforts for globalization and
   EU integration, Istanbul has exhibited a considerable restructuring of
   its social and physical environment. Direct foreign investments and land
   developments by the municipality intensify this process, especially
   along the coastal regions, since these are the most valuable parts of
   the city. This situation puts pressure on the city's coastal parts and
   affects redevelopment projects that are important for the quality of the
   urban environment regarding sustainability. Coastal regions within
   Istanbul have been reshaping under this conjuncture.
   When we look from the viewpoint of the tourism sector, Istanbul could
   not use its historical, cultural, and natural advantages to its maximum
   benefits when compared to other Mediterranean seaport cities. To meet
   expectations of the tourism sector, Istanbul needs new port and land
   management projects for cruise tourism.
   The main aim of this study is to determine criteria for new coastal
   developments in Istanbul and discuss location criteria for a new cruise
   port within the city, where the tourism sector can operate effectively
   without distorting the quality of the urban environment and the built
   heritage.
   Comparing the cruise destinations in the Mediterranean Basin will help
   further the establishment of integrated coastal zone management
   strategies for Istanbul's coastal zone usage.},
