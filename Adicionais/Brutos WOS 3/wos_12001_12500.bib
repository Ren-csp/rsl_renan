@inproceedings{ WOS:000400299900023,
Author = {Marciszewska, Barbara and Marciszewski, Piotr},
Editor = {Erickson, GS and Rothberg, HN},
Title = {Posters as Intangible Assets Creating People' Social Attitudes:
   Implications for International Tourism},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON INTELLECTUAL CAPITAL
   KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2016)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2016},
Pages = {192-198},
Note = {13th International Conference on Intellectual Capital Knowledge
   Management and Organisational Learning (ICICKM), Ithaca Coll, Ithaca,
   NY, OCT 14-15, 2016},
Organization = {Marist Coll},
Abstract = {The perception of visual messages and the meanings attributed to them
   are associated with previously learned visual codes and cultural
   interpretations. The poster has been a medium of communication with the
   society since World War I and even earlier. It has become a tool and a
   medium to influence social behaviour and to gain particular awareness in
   different social campaigns. Therefore, posters have been extensively
   used in many areas of social, economic and cultural life as well as in
   the public space, health promotion and education. The purpose of the
   article is an attempt to present a poster as a source of knowledge for
   the society and a factor shaping its attitudes. The main research
   problem is: how to visually transmit a message about a particular
   phenomenon to develop social awareness and responsibility among locals
   and tourists? Method: a questionnaire survey was carried out in 2014
   among Polish students of tourism who were shown different posters
   expressing different social attitudes. The survey was aimed to identify
   the audience's reaction to the visualisation on the one hand and their
   understanding of the messages of the posters on the other one. Results:
   The communicative effects of the posters' ideas were identified: the
   poster has to draw attention in the public space and then people will be
   interested in and keen on analysing the meaning of the idea contained in
   the poster. Feedback is a source of information on creating new
   knowledge and on evaluating the poster as a tool of both identifying and
   shaping people's attitudes, including tourists. This statement opens a
   new research question: do social posters stimulate tourists to
   ``adapt{''} their attitudes to the local society.},
Publisher = {ACAD  CONFERENCES LTD},
Address = {CURTIS FARM, KIDMORE END, NR READING, RG4 9AY, ENGLAND},
