Title = {Specific Features of Karst-Suffosion Hazard Assessment for Different
   Engineering Structures in Moscow},
Booktitle = {RECENT ADVANCES IN ENVIRONMENTAL SCIENCE FROM THE EURO-MEDITERRANEAN AND
   SURROUNDING REGIONS, EMCEI-3 2021, 3 EDITION},
