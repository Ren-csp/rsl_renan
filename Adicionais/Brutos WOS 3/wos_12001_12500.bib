@article{ WOS:000222044100012,
Author = {Martin, JK and Tuch, SA and Roman, PM},
Title = {Problem drinking patterns among African Americans: The impacts of
   reports of discrimination, perceptions of prejudice, and ``risky{''}
   coping strategies},
Journal = {JOURNAL OF HEALTH AND SOCIAL BEHAVIOR},
