@inproceedings{ WOS:000087041300024,
Author = {Vos, W and Hoogendoorn, JC},
Editor = {Boekestein, A and Diederen, P and Jongen, W and Rabbinge, R and Rutten, H},
Title = {Multifunctionality of agriculture and landscape: Challenges for
   innovative research},
Booktitle = {TOWARDS AN AGENDA FOR AGRICULTURAL RESEARCH IN EUROPE},
Year = {2000},
Pages = {215-223},
Note = {Conference on Towards an Agenda for Agricultural Research in Europe,
   WAGENINGEN, NETHERLANDS, APR 13-15, 1999},
Organization = {Wageningen Univ; Res Ctr; Dutch Minist Agr Nat Management \& Fisheries;
   Dutch Natl Council Agr Res},
Abstract = {Many of the most attractive European landscapes are by-products of
   multifunctional traditional farming systems. Traces of older cultures
   and virgin nature survived in these Arcadic Landscapes, mainly because
   they did not contradict more recent farming technology and farmers
   attitudes. In our industrial era these systems were replaced by more
   uni-directional systems through technical and economical optimisation
   and orientations on external markets that asked for bulk production.
   Today, however, the post-modern shopping society asks from the same
   rural space more than only bulk agro-production. It demands a healthy
   environment, nature and landscape, culture, human health and welfare,
   and specialised quality food with an image of safety too. The Latter
   appear to he marketable goods for a new spectrum of clients (residents,
   nature conservationists, tourists, gourmets, health fanatics, disabled
   people,...).
   As a consequence, in many regions multipurpose farming is `en vogue'
   again: new systems and revitalised traditional ones. Here, agricultural
   practice has been getting ahead of policy and research: the public and
   private markets indicate where to go. Which seems good for both the
   environment, the sustainability of rural societies, the consumers and
   the farm economics.
   Challenges for research are multifold: not only in filling in manifest
   knowledge gaps, but in new research attitudes as well. The consequences
   for future innovative research in this field were outlined by an
   extensive programming study of Wageningen University \& Research Centre,
   in which not only scientists but also farmers representatives and
   administrators participated.},
