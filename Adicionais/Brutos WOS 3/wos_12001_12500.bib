@inproceedings{ WOS:000226303300023,
Author = {Stewart, D},
Editor = {Donati, A and Rossi, C and Brebbia, CA},
Title = {`Smart development' for brownfields: a futures approach using the
   prospective through scenario planning method},
Booktitle = {BROWNFIELD SITES II : ASSESSMENT, REHABILITATION AND DEVELOPMENT},
