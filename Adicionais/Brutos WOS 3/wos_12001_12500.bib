@article{ WOS:000431498300130,
Author = {Nadzri, Wan Nadiah Mohd and Musa, Rosidah},
Title = {Investigating Psychometric Elements Measuring Brand Experience Scale},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {8},
Pages = {7521-7524},
