@article{ WOS:000241249600036,
Author = {Roser, D. J. and Davies, C. M. and Ashbolt, N. J. and Morison, P.},
Title = {Microbial exposure assessment of an urban recreational lake: a case
   study of the application of new risk-based guidelines},
Journal = {WATER SCIENCE AND TECHNOLOGY},
