@article{ WOS:000254208900014,
Author = {Hervais-Adelman, Alexis and Davis, Matthew H. and Johnsrude, Ingrid S.
   and Carlyon, Robert P.},
Title = {Perceptual learning of noise vocoded words: Effects of feedback and
   lexicality},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2008},
Volume = {34},
