@inproceedings{ WOS:000349062300028,
Author = {Castilla Gomez, Jorge and Herrera Herbert, Juan},
Book-Group-Author = {SGEM},
Title = {COMPARATIVE CRITERIA FOR ENVIRONMENTAL RISK ASSESSMENT IN MINING
   OPERATIONS: A DYNAMIC APPROACH},
Booktitle = {GEOCONFERENCE ON ECOLOGY, ECONOMICS, EDUCATION AND LEGISLATION, SGEM
   2013, VOL I},
Series = {International Multidisciplinary Scientific GeoConference-SGEM},
Year = {2013},
Pages = {205-212},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {This paper develops an updated study about how environmental risk
   assessment method can be applied in mineral resources industry to get
   comparative criteria to establish environmental risk in mining
   operations, focusing risk assessment in indicators which could be
   measured easily. Mining process is a complex process which involves
   several stakeholders, and even different companies. The most part of the
   studies in this field, which develop environmental impacts assessment,
   divide the mining process in single steps, studying environmental
   affection of each single operation. That implies that there could be
   some interactions between mining phases which have no impact outwards
   the mine boundaries. In this case they could generate conflicts between
   mine processes which could penalize overall process. So, a simplified
   method is used taking into account affections generated outwards mining
   area, getting a useful tool for comparative study between different
   mining operations in same area.
   Also, a regional scale method is developed studying the interaction
   between several mining projects. The change in the level of risk over
   the time is evaluated using an objective perspective, getting
   quantifiable indicators to achieve final level of environmental risk
   depending on mining method used. A review of Life Cycle Analysis in
   mining industry is evaluated, focusing the field of study on mineral
   extraction phase of mining method. There are other traditional methods,
   mainly based on environmental impact assessment tools which are not so
   suitable for compare different mining methods. This methodology aims to
   be an effective tool for determine overall environmental risk assessment
   and establish updated criteria to quantify environmental affection.
   Moreover, Mining method is a system which evolves along the time, so
   risk assessment is not a static value but is a variable parameter. So, a
   dynamic model approach is developed to be adapted in different
   scenarios. This technique could provide to mining professionals a
   toolbox to identify, analyze and manage environmental effects in mining
   operations. Also this lecture can help to detect effects to be minimized
   studying standard parameters which should be measure easily on site.
   This paper can be useful for project managers, occupational health and
   safety departments and also local or regional regulators, because
   different operations can be evaluated and compared one to each other to
   determine the risks that should be managed in different case studies.},
