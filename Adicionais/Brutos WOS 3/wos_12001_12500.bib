@article{ WOS:000187892200008,
Author = {Bertamini, M and Bruno, N and Mosca, F},
Title = {Illusory surfaces affect the integration of local motion signals},
Journal = {VISION RESEARCH},
Year = {2004},
Volume = {44},
Number = {3},
Pages = {297-308},
Month = {FEB},
Note = {AIP Conference, ALGHERO, ITALY, AUG, 2001},
Abstract = {A 2IFC paradigm was used to measure speed discrimination thresholds for
   pairs of Gabor patches. When one of these patches was phenomenally
   placed over an illusory surface (IS), we observed higher thresholds
   relative to control conditions without ISs. Additional controls
   demonstrated that this effect was due to the placement of the patch on a
   different phenomenal depth plane rather than to the mere presence of an
   IS. We conclude that (i) ISs can affect the long-range integration of
   local motion signals, and (ii) long-range motion integration obeys a
   coplanarity principle. (C) 2003 Elsevier Ltd. All rights reserved.},
