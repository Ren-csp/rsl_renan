@inproceedings{ WOS:000401732900248,
Author = {Zhang, Shanghong and Yuan, Rui and Zhang, Tianxiang},
Book-Author = {Webb, JA
   Costelloe, JF
   CasasMulet, R
   Lyon, JP
   Stewardson, MJ},
Title = {DEVELOPMENT AND APPLICATION OF A THREE-DIMENSIONAL FLOOD SIMULATION
   PLATFORM},
Booktitle = {11TH INTERNATIONAL SYMPOSIUM ON ECOHYDRAULICS},
Year = {2016},
Note = {11th International Symposium on Ecohydraulics, Melbourne, AUSTRALIA, FEB
   07-12, 2016},
Abstract = {Along with the improvement of information technology and expansion of
   digital resources, the flood simulation system stands out in
   decision-making field because it can provide integrated and intuitive
   information; flood process simulation is of great importance to risk
   assessment and disaster alleviation. This paper describes the flood
   simulation platform, which was developed with the technology of virtual
   reality, and expounds the overall framework of this digital simulation
   platform. Research focuses on the key construction processes and
   technologies of the three-dimensional simulation platform, including the
   analysis of flooding process, flow field process simulation, breach
   flood process simulation, emergency plan making and so on. Several
   methods were put forward to realize the digital platform, such as,
   left-right triangle method was used to search inundated area, particle
   system was used to simulate dynamic flow field, mesh dispersion method
   was used to simulate breach flood process, and modified shortest path
   method was used to make emergency plan. In a case study of Harbin city,
   China, the flood inundation process was simulated with two methods of
   hydrodynamic modeling and water-depth comparison, and an integrated
   information platform based on virtual reality technique for urban flood
   protection was developed. A smooth simulation of flood routing in 3D
   virtual environment was realized by combining the methods of
   hydrodynamic modeling and domain searching. The study presents the
   integrated information such as the geographical environment, flooded
   areas, flooding extent, and water depth distribution in the
   three-dimensional virtual environment, thus, can help improve flood
   inundation forecasting and decision-making.},
