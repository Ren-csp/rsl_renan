@inproceedings{ WOS:000439411400020,
Author = {Qu, X. E. and Zhang, L. L.},
Editor = {Li, P},
Title = {Construction of an evaluation index system of water resources bearing
   capacity: An empirical study in Xi'an, China},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT (WRE
   2017)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2017},
