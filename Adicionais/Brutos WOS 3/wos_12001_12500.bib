   BRIDGES AT THE FRONTIERS OF ENGINEERING AND MEDICINE},
Series = {PROCEEDINGS OF ANNUAL INTERNATIONAL CONFERENCE OF THE IEEE ENGINEERING
   IN MEDICINE AND BIOLOGY SOCIETY},
Year = {2001},
