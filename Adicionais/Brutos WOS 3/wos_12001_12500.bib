@inproceedings{ WOS:000189493700029,
Author = {Cohen, A and Feintuch, U},
Editor = {Prinz, W and Hommel, B},
Title = {The dimensional-action system: a distinct visual system},
Booktitle = {COMMON MECHANISMS IN PERCEPTION AND ACTION},
