@article{ WOS:000259071100002,
Author = {Esses, Victoria M. and Veenvliet, Scott and Hodson, Gordon and Mihic,
   Ljiljana},
Title = {Justice, morality, and the dehumanization of refugees},
Journal = {SOCIAL JUSTICE RESEARCH},
