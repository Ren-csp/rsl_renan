@article{ WOS:A1997XH52000002,
Author = {Knox, S and Hess, SA and Petersen, DA and Hill, CE},
Title = {A qualitative analysis of client perceptions of the effects of helpful
   therapist self-disclosure in long-term therapy},
Journal = {JOURNAL OF COUNSELING PSYCHOLOGY},
Year = {1997},
Volume = {44},
Number = {3},
Pages = {274-283},
Month = {JUL},
Note = {Meeting of the Society-for-Psychotherapy-Research, AMELIA ISL, FL, JUN
   19-23, 1996},
Organization = {Soc Psychotherapy Res},
Abstract = {Thirteen adult psychotherapy clients currently in long-term therapy were
   interviewed twice, with semistructured protocols, about their
   experiences with helpful instances of therapist self-disclosure. Data
   were analyzed with a qualitative methodology. Results indicated that
   helpful therapist self-disclosures (a) occurred when these clients were
   discussing important personal issues, (b) were perceived as being
   intended by therapists to normalize or reassure the clients, and (c)
   consisted of a disclosure of personal nonimmediate information about the
   therapists. The therapist self-disclosures resulted in positive
   consequences for these clients that included insight or a new
   perspective from which to make changes, an improved or more equalized
   therapeutic relationship, normalization, and reassurance. Implications
   for psychotherapy are discussed.},
