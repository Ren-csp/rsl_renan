@article{ WOS:000169404000006,
Author = {Artíñano, B and Querol, X and Salvador, P and Rodríguez, S and Alonso,
   DG and Alastuey, A},
Title = {Assessment of airborne particulate levels in Spain in relation to the
   new EU-directive},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2001},
Volume = {35},
Number = {1},
Pages = {S43-S53},
Note = {Venice Conference on Air Quality in Europe: Chanllenges for the 2000s,
   VENICE, ITALY, MAY 19-21, 1999},
Organization = {JRC-Environm Inst; Fondaz Salvatore Maugeri, Environm Res Ctr; European
   Commiss, Director Gen Envirom; Eurocities Consortium; European Federat
   Clean Air; Evironm Protect Assoc},
Abstract = {This study deals with PM10 levels obtained at several Spanish air
   quality monitoring urban, industrial and rural stations. Comparison with
   current national regulations on airborne concentrations of particulate
   matter showed that the standard limits are never exceeded in the
   selected areas. However, the limit values proposed in both stages of the
   recently approved European directive would be exceeded in the current
   situation. Seasonal distribution of exceedences shows a variety of
   patterns suggesting different contributions from anthropogenic and
   natural sources. PM10 levels were found to be affected by natural
   sources of a non-local origin or even attributed to long-range transport
   processes from arid or desert zones. (C) 2001 Elsevier Science Ltd. All
   rights reserved.},
