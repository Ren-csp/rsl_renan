@inproceedings{ WOS:001575680800095,
Author = {Long, Jennifer},
Editor = {Black, NL and Neumann, WP and Noy, I},
Title = {Visual Ergonomics in a Virtual World: Examples of Lighting Assessments
   Conducted in Cyberspace},
Booktitle = {PROCEEDINGS OF THE 21ST CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, IEA 2021, VOL II},
