@article{ WOS:000224231900022,
Author = {Adamowicz, WV and Dupont, D and Krupnick, AJ},
Title = {The value of good quality drinking water to Canadians and the role of
   risk perceptions: A prelominary analysis},
Journal = {JOURNAL OF TOXICOLOGY AND ENVIRONMENTAL HEALTH-PART A-CURRENT ISSUES},
Year = {2004},
Volume = {67},
Number = {20-22},
Pages = {1825-1844},
Month = {OCT-NOV},
Note = {Conference on Drinking Water Safety, CANADA, SEP 23-25, 2002},
Organization = {NERAM; Environm Canada; Hlth Canada; Canadian Water Network; Queens
   Univ, Ctr Water \& Environm},
Abstract = {Canadian municipal water utilities have had to face many difficulties in
   the past few years, not the least of which has been an erosion of
   consumer confidence in the safety of publicly supplied drinking water.
   This paper discusses how economic theory is used to develop a
   methodology for determining consumers' or society's preferences for
   better quality drinking water and how these preferences are expressed in
   the trade-offs made between money and two different types of risk
   reductions: mortality and morbidity. These trade-offs are observed by
   examining actual consumer behavior and/or in structured (hypothetical)
   market choices. The information gained can be used to structure more
   efficient water pricing schemes for municipal water utilities and to aid
   these utilities in their infrastructure investment decisions.},
