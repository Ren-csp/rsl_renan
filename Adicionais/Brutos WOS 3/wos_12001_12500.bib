@inproceedings{ WOS:000238346000085,
Author = {Shang Yanrui},
Editor = {Feng, CG and Huang, P and Ma, Y and Li, SC and Wang, YJ and Su, Q},
Title = {Affect of arable land utilizing intensity on vulnerability of
   agriculture drought - Taking Hebei Province of China as an example},
Booktitle = {Proceedings of the China Association for Science and Technology, Vol 2,
   No 1},
Year = {2006},
Pages = {543-548},
Note = {Annual Conference of the China-Association-for-Science-and-Technology,
   Urumqi, PEOPLES R CHINA, AUG 20-23, 2005},
Organization = {China Assoc Sci \& Technol},
Abstract = {This paper studied the changing process of arable land using intensity
   and its relationship with agricultural drought vulnerability of Hebei
   Province in North China, where has the most serious water scarcity and
   ground subsidence problem in the world. The research shows that from
   1949 to 2001, the average multiple crop index of Hebei increased from
   1.04 to 1.37. The irrigation rate has been improved to 67\% on the base
   of dry farming or earth well irrigating, This process not only
   intensified the arable land utilization, but also encouraged the
   planting expansion of water consuming winter-wheat, exacerbated the
   contradiction between water supply and water demanding. Furthermore, the
   mismatch between multiple plough and irrigating capacity in time and
   space had been changing greatly the balance between water and land
   resources in agricultural ecological environment, harming its function
   as life supporting system. The productivity improvement was another
   aspect of land use intensification. From 1949 to 2001, the gross grain
   output increased from 4.7 million tons to 32.4 million tons under the
   condition of the gross arable land decreasing from 7.3 million hm(2) to
   6.4 million hm(2). At the same period, high water consuming winter
   wheat's output grew rapidly, occupying a percentage of 40\% about of
   Hebei's gross grain production. All of these exerted extra pressure on
   water resources and ecology environment. Consequently, it pricked up
   agricultural system's vulnerability to drought. Though irrigation by
   water depletion relaxed this contradiction in a short time, drought
   vulnerability and risk would surely increase in the long term because
   not only available water resources is not enough in the future, but also
   agricultural environment is badly damaged. Therefore with the present
   pattern, Hebei's agriculture is not sustainable.},
Publisher = {SCIENCE PRESS BEIJING},
Address = {16 DONGHUANGCHENGGEN NORTH ST, BEIJING 100707, PEOPLES R CHINA},
Type = {Proceedings Paper},
Language = {English},
