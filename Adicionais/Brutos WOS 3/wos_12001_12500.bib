@article{ WOS:000243859400005,
Author = {Kaplowitz, Stan A. and Broman, Clifford L. and Fisher, Bradley J.},
Title = {Perceptions of economic and behavioral differences between blacks and
   whites: Racial attitudes of white Americans and status generalization},
Journal = {SOCIAL PSYCHOLOGY QUARTERLY},
