@article{ WOS:A1994QK90800012,
Author = {CANALES, A and PAREILLEUX, A and ROLS, JL and GOMA, G and HUYARD, A},
Title = {DECREASED SLUDGE PRODUCTION STRATEGY FOR DOMESTIC WASTE-WATER TREATMENT},
