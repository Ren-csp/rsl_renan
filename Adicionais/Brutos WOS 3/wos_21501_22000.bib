@article{ WOS:000254164800016,
Author = {Cinovsky, K. and Skodacek, I.},
Title = {Anxiety as an enhancing phenomenon in origin of stress, CAN and PTSD in
   disabled children -: Contribution to the ICD-10 re-classification},
