@article{ WOS:000431480900020,
Author = {Bachok, Syahriah and Adumi, Mohd Izul Fikri and Osman, Mariana M.},
Title = {Gap Detection of Bus Stops Using GIS/GPS},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
