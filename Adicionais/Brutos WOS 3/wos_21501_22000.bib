@inproceedings{ WOS:000179158800006,
Author = {Antoine, A},
Editor = {Barr, C and Petit, S},
Title = {From past to present: the changing functions of hedges in England and
   the West of France - Bocages, woodlands and enclosures},
Booktitle = {HEDGEROWS OF THE WORLD: THEIR ECOLOGICAL FUNCTIONS IN DIFFERENT
   LANDSCAPES},
Year = {2001},
Pages = {63-68},
Note = {10th Annual Conference of the
   International-Association-for-Landscape-Ecology, UNIV BIRMINGHAM,
   BIRMINGHAM, ENGLAND, SEP 05-08, 2001},
Organization = {Int Assoc Landscape Ecol, UK Chapter},
Abstract = {The functions of hedges are not permanent: they are linked with the
   agrarian systems and the evolution of society. Comparison of the hedges
   built in England during the enclosures and the traditional hedges of
   Western France shows this. The former were used to divide fields in
   order to practise particular rotations of crops; the latter to protect
   crops from livestock, and they were built by the farmers for whom they
   were useful. But they also have many other functions which derive from
   their existence, particularly ecological functions. Now, hedges have
   widely lost their original purpose and their secondary functions appear
   essential: hedges seem less useful to the farmers (who often neglect to
   maintain them) than to other people. This transfer of the functions of
   the hedge necessarily involves a change in perceptions of the landscape.},
