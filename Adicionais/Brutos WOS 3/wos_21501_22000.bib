@article{ WOS:000073912300006,
Author = {Payne, BK and Gainey, RR},
Title = {A qualitative assessment of the pains experienced on electronic
   monitoring},
Journal = {INTERNATIONAL JOURNAL OF OFFENDER THERAPY AND COMPARATIVE CRIMINOLOGY},
