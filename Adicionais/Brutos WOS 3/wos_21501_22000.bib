@inproceedings{ WOS:000280375500050,
Author = {Mao, Liangbin},
Editor = {Zhang, J and Thomas, LH and Xie, T},
Title = {Is There Any Difference in Effect of Agenda-Setting between Television
   and Internet: An Experimental Study},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL CONFERENCE ON SMALL AND MEDIUM-SIZED
   ENTERPRISES (SMES) PSYCHOLOGICAL ADAPTATION AND SOCIAL BEHAVIOR UNDER
   FINANCIAL CRISIS},
Year = {2010},
Pages = {299-302},
Note = {International Conference on Small and Medium-sized Enterprises (SMEs)
   Psychological Adaptation and Social Behavior under Financial Crisis,
   Hangzhou, PEOPLES R CHINA, JUL 11-12, 2009},
Organization = {Zhejiang Univ; Social Psychol Profess Comm Chinese; Psychol Soc; Social
   Pychol Soc Zhejiang Proc; SMEs Bur; Univ Massachusetts Amherst, Div
   Social Psychol; Fordham Uiv, Grad Sch Educ; Western Illinois Univ, Dept
   Psychol; Amer Scholars Press},
Abstract = {A one-factor experiment was designed to examine if there is any
   difference in effect of agenda setting between television and internet
   online. Forty (40) college students who participated in a psychology
   course instructed by researcher were involved, which consisted of 18
   females and 22 males. The results of the experiment reveal that internet
   online news is really able to significantly affect people's perception
   on the importance of an issue. So is television. Both of the two mass
   media show strong capacity for agenda setting. Furthermore, a systematic
   analysis of results also discovers that different media have a weak
