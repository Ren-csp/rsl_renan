@inproceedings{ WOS:000085593600223,
Author = {Hauptmann, W and Graf, F and Heesche, K},
Editor = {Kasabov, N and Kozma, R and Ko, K and OShea, R and Coghill, G and Gedeon, T},
Title = {A neuro-fuzzy approach for the sensor-based driving situation
   identification},
Booktitle = {PROGRESS IN CONNECTIONIST-BASED INFORMATION SYSTEMS, VOLS 1 AND 2},
Year = {1998},
Pages = {919-922},
Note = {1997 International Conference on Neural Information Processing and
   Intelligent Information Systems, DUNEDIN, NEW ZEALAND, SEP, 1997},
Organization = {Asian Pacific Neural Network Assembly; Air New Zealand; TELECOM New
   Zealand; New Zealand Comp Soc; SAS Inst; Fisher \& Paykel; Univ Otago,
   Dept Informat Sci; IEEE, Neural Network Council; Int Neural Network Soc},
Abstract = {As future automotive systems will comprise an increasing amount of
   adaptive functions to further improve vehicle performance, there is a
   need for an intelligent control that can adjust the vehicle's
   characteristics based on the perception of the driving environment. In
   this paper, a neuro-fuzzy system is presented which identifies the
   driving situation using vehicular sensor information. Based on monitored
   driving signal data, features are computed via a sensor fusion step and
   evaluated with a fuzzy classificator. Initialized by heuristic
   knowledge, the fuzzy model is modified and optimized using a
   bidirectional neuro-fuzzy transformation and a dedicated neural network
   topology. The proposed method significantly reduces development time
   and, as simulations and driving tests indicate, leads:to improved
   classification results compared to conventional system design.},
