@article{ WOS:000357350500009,
Author = {Yu, Huarong and Qu, Fangshu and Chang, Haiqing and Shao, Senlin and Zou,
   Xiaoxu and Li, Guibai and Liang, Heng},
Title = {Understanding ultrafiltration membrane fouling by soluble microbial
   product and effluent organic matter using fluorescence
   excitation-emission matrix coupled with parallel factor analysis},
Journal = {INTERNATIONAL BIODETERIORATION \& BIODEGRADATION},
Year = {2015},
Volume = {102},
Number = {SI},
Pages = {56-63},
