@inproceedings{ WOS:000431842100008,
Author = {Dare, Lain and Schirmer, Jacki},
Editor = {Lukasiewicz, A and Dovers, S and Robin, L and McKay, J and Schilizzi, S and Graham, S},
Title = {Exploring the justice in forestry negotiations: trading justice for
   politics},
Booktitle = {NATURAL RESOURCES AND ENVIRONMENTAL JUSTICE: AUSTRALIAN PERSPECTIVES},
Year = {2017},
Pages = {105-118},
Note = {Workshop on Justice, Fairness and Equity in Natural Resource Management,
   Australian Natl Univ, Fenner Sch Environm \& Soc, Canberra, AUSTRALIA,
   OCT 12-13, 2015},
Organization = {Acad Social Sci},
Abstract = {In this chapter we evaluate the `Tasmanian forest peace process' from
   the perspective of procedural justice, focusing on the process rather
   than on its outcomes (distributive justice). This allows for an
   exploration of how the negotiation process influenced perceptions of the
   justice process, providing insights to the trade-offs involved between
   procedural justice and achieving desired outcomes. Following a brief
   overview of the study methods, we present key principles of procedural
   justice using the Social Justice Framework (Lukasiewicz and Baldwin
   2014), and identify nine normative indicators of procedural justice that
   guide our subsequent analysis. We then discuss lessons from the
   Tasmanian forest peace process for justice, focusing on the challenge of
   satisfying multiple procedural justice objectives within a highly
   contested political environment.},
