@article{ WOS:000082647000006,
Author = {Stuhlmacher, AF and Walters, AE},
Title = {Gender differences in negotiation outcome: A meta-analysis},
Journal = {PERSONNEL PSYCHOLOGY},
Year = {1999},
Volume = {52},
Number = {3},
Pages = {653-677},
Month = {FAL},
Note = {14th Annual Conference of the
   Society-for-Industrial-and-Organizational-Psychology, ATLANTA, GA,
   APR-MAY -, 1999},
Organization = {Soc Ind \& Org Psychol},
Abstract = {Studies reporting the objective settlements obtained by men and women in
   negotiations were reviewed. Differences in outcomes were expected due to
   differences in perceptions, behaviors, and contextual factors between
   men and women. In the sample of studies, men negotiated significantly
   better outcomes than women. Opponent sex, relative power of the
   negotiator, integrative potential of the task, mode of communication and
   year of the study were tested as moderators of the effect. Although the
   overall difference in outcomes between men and women was small, none of
   these hypothesized moderators or several exploratory moderators reversed
   or eliminated this effect. The organizational significance of the
   findings is discussed in terms of the glass ceiling, a gender-based
   earnings differential and women in negotiation positions. Directions for
   future research in the laboratory and the field are suggested.},
