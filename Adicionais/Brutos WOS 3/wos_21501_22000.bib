@inproceedings{ WOS:000425331200017,
Author = {Haid, Marco and Graschitz, Sabine and Mueller, Claudia},
Editor = {Rich, M},
Title = {Auditor's Characteristics, Liability Regime and Task Complexity
   Assessment},
Booktitle = {PROCEEDINGS OF THE 13TH EUROPEAN CONFERENCE ON MANAGEMENT, LEADERSHIP
   AND GOVERNANCE (ECMLG 2017)},
Series = {Proceedings of the Conference on European Management Leadership and
   Governance},
Year = {2017},
Pages = {137-146},
Note = {13th European Conference on Management, Leadership and Governance
   (ECMLG), City Univ London, Cass Business Sch, London, ENGLAND, DEC
   11-12, 2017},
Abstract = {This study investigates the auditors' perception of task complexity in
   the light of their individual risk preference and capabilities within
   different liability situations. A within-subject case-based experiment
   with 134 auditing students was conducted. The results show that
   individuals with a higher risk preference assess the task complexity
   higher than participants with a lower risk preference. Regarding the
   liability situation the analyses show, that a high liability scenario
   leads to a higher assessed complexity compared to a low liability
   scenario. Further the results show that the participants' knowledge and
   experience dampens the effect of risk preference onto the task
   complexity assessment. This study offers an insight to the impact of
   individuals' characteristics as well as regulatory conditions on the
   assessed audit complexity.},
