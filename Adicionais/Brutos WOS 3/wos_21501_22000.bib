   Azis, Yuldiana Zesa and Tajuddin, Mulyadi Alrianto},
Editor = {Hadiyanto, M and Warsito, B},
Title = {Legal Enforcement on Environmental Impact of Palm Oil Plantation of
   Merauke District},
