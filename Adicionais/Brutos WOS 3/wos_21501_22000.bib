@article{ WOS:000078402700005,
Author = {Arkowitz, H},
Title = {The varieties of support in psychotherapy},
Journal = {JOURNAL OF PSYCHOTHERAPY INTEGRATION},
Year = {1997},
Volume = {7},
Number = {2},
Pages = {151-159},
Month = {JUN},
Note = {12th Annual Meeting of the
   Society-for-the-Exploration-of-Psychotherapy-Integration, BERKELEY,
   CALIFORNIA, APR   26, 1996},
Organization = {Soc Explorat Psychotherapy Integrat},
Abstract = {This article comments on the three papers in this series. There is
   apparent agreement about a general (Rogerian) factor of support that may
   cut across all therapies. In addition, two of the papers clearly propose
   a support factor unique to each orientation. I argue that what may be
   unique is the content of such support (the particular theory and
   techniques), but not the form (providing a theory and techniques).
   Therapeutic support also needs to be considered from a variety of
   perspectives including: clients' perceptions; therapists' attitudes,
   therapist's behaviors, and the relational context. Individual
   differences in the role of support also need to be considered, and
   special emphasis is placed on understanding the role of support in both
   the etiology and treatment of different clinical disorders.},
