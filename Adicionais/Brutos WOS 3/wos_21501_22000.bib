@article{ WOS:000431498300214,
Author = {Yaacob, Mahazril `Aini and Abu Bakar, Siti Hajar and Abd Aziz, Wan Nor
   Azriyati Wan},
Title = {Housing Challenges Among Young People in Greater Kuala Lumpur (GKL),
   Malaysia},
