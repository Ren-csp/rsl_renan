@article{ WOS:000275347800012,
Author = {Kraft, Antje and Grimsen, Cathleen and Trenner, Dennis and Kehrer,
   Stefanie and Lipfert, Anika and Koehnlein, Martin and Fahle, Manfred and
   Brandt, Stephan A.},
Title = {Specificity of fast perceptual learning in shape localisation tasks
   based on detection versus form discrimination},
Journal = {VISION RESEARCH},
Year = {2010},
Volume = {50},
Number = {4, SI},
Pages = {473-478},
Month = {FEB 22},
Note = {1st International Workshop on Perceptual Learning, Beijing Normal Univ,
   Beijing, PEOPLES R CHINA, OCT 15-19, 2008},
Organization = {State Key Lab Cognit Sci \& Learning},
Abstract = {Perceptual learning is defined as a long-lasting improvement of
   perception as a result of experience. Here we examined the role of task
   on fast perceptual learning for shape localisation either in simple
   detection or based on form discrimination in different visual
   submodalities, using identical stimulus position and stimulus types for
   both tasks. Thresholds for each submodality were identified by
   four-alternative-forced-choice tasks. Fast perceptual learning occurred
   for shape detection-based on luminance, motion and color differences but
   not for texture differences. In contradistinction, fast perceptual
   learning was not evident in shape localisation based on discrimination.
   Thresholds of all submodalities were stable across clays. Fast
   perceptual learning seems to differ not only between different visual
   submodalities, but also across different tasks within the same visual
   submodality. (C) 2009 Elsevier Ltd. All rights reserved.},
