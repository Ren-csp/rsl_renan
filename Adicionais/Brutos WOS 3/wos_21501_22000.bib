@article{ WOS:000441173100148,
Author = {Kim, Yeon-Joong and Itoh, Sadakazu and Oya, Yoshiyuki and Yoon,
   Jung-sung},
Title = {Study on Storm Surge Prediction Model Considering Typhoon
   Characteristics for Largest Scale},
Journal = {JOURNAL OF COASTAL RESEARCH},
