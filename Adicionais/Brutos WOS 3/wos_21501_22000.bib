@article{ WOS:000248143100006,
Author = {Griffiths, Timothy D. and Kumar, Sukhbinder and Warren, Jason D. and
   Stewart, Lauren and Stephan, Klaas Enno and Friston, Karl J.},
Title = {Approaches to the cortical analysis of auditory objects},
Journal = {HEARING RESEARCH},
Year = {2007},
Volume = {229},
Number = {1-2},
Pages = {46-53},
