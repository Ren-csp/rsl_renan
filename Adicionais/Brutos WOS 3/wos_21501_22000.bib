@article{ WOS:000228827100036,
Author = {Schreiber, H and Behrendt, H and Constantinescu, LT and Cvitanic, I and
   Drumea, D and Jabucar, D and Juran, S and Pataki, B and Snishko, S and
   Zessner, M},
Title = {Nutrient emissions from diffuse and point sources into the River Danube
   and its main tributaries for the period of 1998-2000 - results and
   problems.},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
Volume = {51},
Number = {3-4},
Pages = {283-290},
Note = {7th IWA International Specialised Conference on Diffuse Pollution and
   Basin Management, Dublin, IRELAND, AUG 17-21, 2003},
Organization = {IWA},
Abstract = {Nutrient emissions by point and diffuse sources were estimated for 388
   sub-catchments of the Danube river basin for the period 1998-2000 by
   means of the Model MONERIS. For nitrogen total emissions of 684 kt/a N
   were estimated for the Danube basin. 80\% of these emissions were caused
   by diffuse sources (mainly groundwater, urban areas and tile drainage).
   For phosphorus the emission was 57 kt/a P, with a contribution of
   diffuse sources to this sum of 58\%. The comparison of calculated and
   observed loads shows that the mean deviation for the investigated
   sub-catchments of the Danube river basin is 20\% for dissolved inorganic
   nitrogen and 34\% for phosphorus. The spatial resolution of the emission
   calculations allows the identification of regional hot spots and the
   derivation of specific regional measures to reduce the emissions into
   the Danube and consequently into the Western Black Sea.},
