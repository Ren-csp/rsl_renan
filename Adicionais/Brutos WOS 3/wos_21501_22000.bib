Title = {SEDIMENTOLOGICAL AND ENVIRONMENTAL INVESTIGATION OF THE SEA BED
   SEDIMENTS OF THE HERACLION GULF (CRETE)},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
