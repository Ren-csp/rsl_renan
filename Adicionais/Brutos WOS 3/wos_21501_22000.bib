Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1999},
Volume = {1179},
Pages = {321-324},
Note = {5th World Congress of the
   International-Association-for-Emergency-Psychiatry, BRUSSELS, BELGIUM,
   OCT 15-17, 1998},
Organization = {World Psychiatr Assoc; Assoc European Psychiatrists; European Region
   Council World Federat Ment Hlth; Belgian Royal Soc Ment Hlth Med;
   Belgian Soc Emergency \& Disaster Med},
Abstract = {In my capacity as a psychiatrist, I feel it is essential to take a
   closer look at the other side of the concept of insanity, the: question
   of medical confinement governed, in part, by the courts. Can a dialogue
   be developed between doctors and the courts?
   By considering the historical perception of insanity in Belgium, we can
   gain a better grasp of the contradictions between the legal and the
   psychiatric positions. The law of 26 June 1990 on protecting the rights
   of the mentally ill touches on the very foundation of the human being:
   his liberty. But interpretation tinges every aspect.
   Mental illness is not a meaningless concept. Both the psychiatrist's
   human responsibility and the discomfort of the inherent uncertainty in
   the magistrate's judgment point the way to complementary action.},
