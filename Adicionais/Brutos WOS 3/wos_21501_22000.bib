@inproceedings{ WOS:000079630400296,
Author = {Arif, AF and Kuroyanagi, S and Iwata, A},
Editor = {Usui, S and Oori, T},
Title = {Attentional system for pattern recognition},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {1295-1298},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {An attentional system for pattern recognition is presented and compared
   with the functional model of human visual system. Human and animals are
   known to be capable of accomplishing a wide range of perceptual tasks
   and depends heavily on eye movements attention shifts for pattern
   perceptions. The proposed model takes advantage of some perspective of
   the human visual system and treats pattern recognition process as a
   behavioral process in which feature at fixations and scanpath are used
   as internal representation of a pattern. By combining ANN, the model is
   capable to make top-down and bottom-up recognition as the study on
   higher primates visual systems suggests. Due to the structure of the
