@article{ WOS:000231352100013,
Author = {Metherate, R and Kaur, S and Kawai, H and Lazar, R and Liang, K and
   Rose, HJ},
Title = {Spectral integration in auditory cortex: Mechanisms and modulation},
Journal = {HEARING RESEARCH},
Year = {2005},
Volume = {206},
