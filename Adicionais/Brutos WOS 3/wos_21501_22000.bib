@inproceedings{ WOS:000226788700012,
Author = {Vilis, T},
Editor = {Buracas, GT and Ruksenas, O and Boynton, GM and Albright, TD},
Title = {The role of eye position in visual and visual-motor processing},
Booktitle = {MODULATION OF NEURONAL RESPONSES: IMPLICATIONS FOR ACTIVE VISION},
Series = {NATO SCIENCE SERIES, SUB-SERIES I: LIFE AND BEHAVIOURAL SCIENCES},
Year = {2003},
Volume = {334},
Pages = {265-281},
Note = {Summer School on Modulation of Neuronal Signaling, Nida, ITALY, JUL
   12-21, 2000},
Organization = {NATO},
Abstract = {It has been known for some time that an internal sense of eye position
   is critical for guiding and terminating saccadic eye movements. Here we
   present evidence that a sense of eye position is also necessary for
   visual perception and for a variety of visually guided actions. It is
   therefore not surprising that an eye position signal is present in many
   regions of the brain. Based on evidence from the oculomotor system, we
   suggest that eye position serves two distinct functions; updating the
   location and orientation of visual objects in the world and transforming
   the location and orientation of our body parts, a process that allows us
   to select which object to act on and which body part to act with.},
