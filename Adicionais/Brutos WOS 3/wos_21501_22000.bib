@article{ WOS:A1997XZ99300009,
Author = {Wanberg, CR},
Title = {Antecedents and outcomes of coping behaviors among unemployed and
   reemployed individuals},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {1997},
Volume = {82},
Number = {5},
