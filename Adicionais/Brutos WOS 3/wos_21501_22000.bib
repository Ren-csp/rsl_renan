@inproceedings{ WOS:A1996BH17K00059,
Author = {Bohm, HF and Claussen, CF},
Editor = {Claussen, CF and Kirtane, MV and Constantineuscu, L and Schneider, D},
Title = {Neurootological aspects of oscillopsia},
Booktitle = {GIDDINESS \& VESTIBULO-SPINAL INVESTIGATIONS; COMBINED AUDIO-VESTIBULAR
   INVESTIGATIONS; EXPERIMENTAL NEUROOTOLOGY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {1996},
Volume = {1133},
Pages = {375-386},
Note = {XXIIIrd Scientific Meeting of the
   Neurootological-Equilibriometric-Society on Giddiness and
   Vestibulo-Spinal Investigations; Combined Audio-Vestibular
   Investigations; Experimental Neurootology, BAD KISSINGEN, GERMANY, MAR
   22-24, 1996},
Organization = {Neurootol Equilibriometr Soc},
Abstract = {In a retrospective study during a 5-year period from 1987 to 1992 we
   examined 4592 patients with neurootological signs and symptoms of
   dysaequilibrium, arranged in the `'NODEC-IV-Collective''. At the moment
   the NODEC-IV-Collective consists of 10345 neurootologic patients.
   With a percentage of 1,52\% in this partition of the
   `'NODEC-IV-Collective'' (n=4592) the neuroophthalmologic symptom of
   `'oscillopsia'' clearly represents a minor topic in the neurootologists
   daily work.
   But the intensity of the patients' subjective disturbance of vision
   demands a thorough clinical investigation.
   The group of patients suffering from `'oscillopsia'' (n=70) reveals a
   clear female predominance of 61,4\% against a relatively low margin of
   males of 38,6\%.
   The average age of all patients suffering from `'oscillopsia'' is 47,9
   years.
   Most of the neurootologically examined patients (n=70) suffering from
   `'oscillopsia'' show massive disturbancies of aequilibrium.
   A high percentage of 94,3\% presents symptoms of vertigo, associated
   with vegetative symptoms in 55,7\% of cases.
   Clinical signs of dysaequilibrium such as functional impairment of the
   `'VOR'' or `'OKR''-expressed by the acute accurance of different
   patterns of jerk nystagm during ENG-examination- and certain
   disturbancies of vestibule-spinal coordination -expressed by pathologic
   patterns of CCG-examination- can be registered mostly.
   The neuroopthalmologic symptom of `'oscillopsia'' is caused by a retinal
   slip of visually perceived objects during the slow phase of an mostly
   acute jerk nystagm. The physiologic foundation of `'oscillopsia'' is a
   well differentiated visual system with good central visual acuity in
   beforehand. All of our patients experiencing `'oscillopsia'' show an
   acute jerk nystagm and are older than 12 years of life.
   Pathologic patterns of nystagm coordination can be clinically evaluated
   by most patients suffering from `'oscillopsia''. These patterns indicate
   certain disturbancies of supra- or internuclear coordination of eye
   movements.
   They can be caused by multiple pathologic affections of the integrity of
   the human brainstem with impairment of central-vestibular or
   oculomotoric subsystems in the diencephalon, the mesencephalon or the
   pens.
   81,3\% of all patients being afflicted by `'oscillopsia'' present an
   pathologic vertical nystagm, such as upbeat-nystagm, downbeat-nystagm or
   combined up- and downbeat-nystagm, standing alone or in combination with
   different patterns of horizontal nystagm.
   A remarkably high margin of 18,6\% shows up with an uncoordinated,
   unclassifiable horizontal nystagm.
   Pathologic patterns of CCG-examination as a sign of central- or
   peripheral-vestibular disturbancies of vestibule-spinal coordination can
   be registered in 31,4\% of cases.
   All these clinical findings can be interpreted as an result of mostly
   central-vestibular or combined central- and peripheral-vestibular
   disorders.},
