@inproceedings{ WOS:000075569500021,
Author = {Yen, SC and Menschik, ED and Finkel, LH},
Editor = {Bower, JM},
Title = {Cortical synchronization and perceptual salience},
Booktitle = {COMPUTATIONAL NEUROSCIENCE: TRENDS IN RESEARCH},
Year = {1998},
Pages = {125-130},
Note = {6th Annual Computational Neuroscience Conference, BIG SKY, MT, JUL
   06-10, 1997},
Abstract = {We present a striate-cortical model which proposes a direct relationship
   between cellular synchronization and perceptual salience. The model
   focuses on the role of the long-range horizontal connections between
   oriented simple cells in striate cortex and is able to account for
   current physiological and psychophysical results on contour salience. We
   demonstrate that horizontal connections between realistically-modeled
   multicompartment pyramidal cells and interneurons can generate robust
   context-dependent synchronization. Closed contours induce better
   synchronization in the network than open contours, and closure thus
   increases perceptual salience, as observed psychophysically by Kovacs
   and Julesz. This result is a general topological property of
   synchronization. The model supports a temporal synchronization solution
   to the binding problem, in that changes in synchronization are directly
   linked to changes in visual perception.},
Publisher = {PLENUM PRESS DIV PLENUM PUBLISHING CORP},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Yen, SC (Corresponding Author), Univ Penn, Dept Bioengn, 3320 Smith Walk, Philadelphia, PA 19104 USA.
   Univ Penn, Dept Bioengn, Philadelphia, PA 19104 USA.},
ISBN = {0-306-45919-1},
