@inproceedings{ WOS:000179773000020,
Author = {Pain, G and Baudry, J and Burel, F},
Editor = {Maudsley, M and Marshall, J},
Title = {The use of metapopulation models and GIS in environmental studies
   preceding linear infrastructure construction},
Booktitle = {HETEROGENEITY IN LANDSCAPE ECOLOGY: PATTERN AND SCALE},
Year = {1999},
Pages = {213-218},
Note = {8th Annual Conference of the
   International-Association-for-Landscape-Ecology, BRISTOL, ENGLAND, SEP
   06-08, 1999},
Organization = {Int Assoc Landscape Ecol, UK Chapter},
Abstract = {Many studies have shown the importance of dispersal processes on the
   persistence of fragmented populations. If we consider linear
   infrastructure (e. g, highways) as barrier in landscapes, it is
   important to study biological fluxes between landscape features before
   deciding the final route of such infrastructures.
   The use of GIS and metapopulation model is useful to define this route.
   Programming with GIS permits to define the structure of a population in
   regard of the suitable habitat distribution but also of the composition
   of the landscape mosaics in which it is embedded. The use of
   metapopulation viability models permits to quantify the relative effect
   on different sets of hypothesis on landscape perception by individuals
   in movement or scenarios of land structure modification.},
