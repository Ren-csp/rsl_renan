@article{ WOS:000087775700001,
Author = {Marti, MW and Wissler, RL},
Title = {Be careful what you ask for: The effect of anchors on personal injury
   damages awards},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-APPLIED},
Year = {2000},
Volume = {6},
Number = {2},
Pages = {91-103},
Month = {JUN},
Note = {69th Annual Meeting of the Midwestern-Psychological-Association,
   CHICAGO, IL, MAY 08-10, 1997},
Organization = {Midwestern Psychol Assoc},
Abstract = {These studies examined the effects of anchors in the context of personal
   injury damages awards. In 2 experiments, mock jurors read a case in
   which the presence and size of the plaintiff's damages request and the
   defense rebuttal were varied across conditions and then awarded damages.
   Award size and variability increased as the plaintiffs request increased
   but decreased with the most extreme request. Conversely, award size and
   variability decreased as the defense rebuttal decreased but increased
   with the most extreme rebuttal. In both studies, the award
   recommendations altered the upper and lower boundaries of awards mock
   jurors found acceptable but did not affect mock jurors' perception of
   injury severity. The findings suggest that award recommendations can
   produce biased and unpredictable awards.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
Address = {750 FIRST ST NE, WASHINGTON, DC 20002-4242 USA},
