@article{ WOS:000247512100017,
Author = {Johnson, M. and Camargo Valero, M. A. and Mara, D. D.},
Title = {Maturation ponds, rock filters and reedbeds in the UK: statistical
   analysis of winter performance},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2007},
