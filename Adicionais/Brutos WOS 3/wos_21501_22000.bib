@inproceedings{ WOS:000073466300027,
Author = {Riani, M and Simonotto, E},
Editor = {Ferretti, CT},
Title = {The possible roles of noise in the processing of visual signals},
Booktitle = {BIOCYBERNETICS OF VISION: INTEGRATIVE MECHANISMS AND COGNITIVE PROCESSES},
Series = {SERIES ON BIOPHYSICS AND BIOCYBERNETICS},
Year = {1997},
Volume = {2},
Pages = {251-262},
Note = {International School E.R. Caianiello on Biocybernetics of Vision -
   Integrative Mechanisms and Cognitive Processes, ISCHIA, ITALY, OCT
   16-22, 1994},
Organization = {Sch Advisory Board; Istit di Cibernetica CNR; Istit Italian per gli
   Studi Filosofici},
Abstract = {The problem of information processing in the presence of noise is
   addressed within the context of artificial neural networks modelling
   multistability in the perception of ambiguous patterns. While, in
   general, noise is an element to be overridden and neglected during
   processing, from the point of view of the phenomenon of stochastic
   resonance, the presence of noise of suitable intensity can be utilized
   by a nonlinear system to obtain a higher signal-to-noise ratio, hence to
   facilitate information processing. We present computer simulations of an
   autoassociative network, modelling the perceptual alternation
   phenomenon. In the presence of a weak periodic perturbation, such a
   network exhibits the characteristic dependence of the signal-to-noise
   ratio, at increasing noise intensity, that is typical of stochastic
   resonance.},
