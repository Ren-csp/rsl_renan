@inproceedings{ WOS:000084945800008,
Author = {Kanwisher, N},
Editor = {Sabourin, M and Craik, F and Robert, M},
Title = {The modular structure of human visual recognition: Evidence from
   functional imaging},
Booktitle = {ADVANCES IN PSYCHOLOGICAL SCIENCE, VOL 2: BIOLOGICAL AND COGNITIVE
   ASPECTS},
Year = {1998},
Pages = {199-213},
Note = {26th International Congress of Psychology, MONTREAL, CANADA, AUG 16-21,
   1996},
Organization = {Canadian Psychol Assoc; NRC Canada; Int Union Psychol Sci},
Abstract = {This chapter reviews the literature on functional brain imaging of human
   visual recognition. Distinct extrastriate regions have been identified
   that appear to be specialized for face perception, visual shape
   analysis, and perhaps word-reading, suggesting a highly modular
   structure for visual recognition. The ways are discussed in which
   functional brain imaging may allow us to transcend mere phrenology to
   derive important clues about the mental processes underlying high-level
   vision. In particular, the modular structure of human visual recognition
   suggests that distinct mechanisms may be involved in the recognition of
   faces, objects, and words. Furthermore, functional imaging has made
   experimentally tractable some important hypotheses about modularity
   itself, and we can now empirically test Fodor's (1983) claims that
   cortical modules are necessarily innately specified, automatic, and
   domain-specific.},
