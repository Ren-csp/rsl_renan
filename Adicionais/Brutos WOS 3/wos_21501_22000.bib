@article{ WOS:A1995UC24000037,
Author = {Torres, ES and delRio, JG},
Title = {Spatial variations of phytoplankton community structure in a highly
   eutrophicated coast of the Western Mediterranean Sea},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1995},
