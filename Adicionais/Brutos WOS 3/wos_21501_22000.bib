@inproceedings{ WOS:000250917700075,
Author = {Wengert, Christian and Bossard, Lukas and Haeberling, Armin and Baur,
   Charles and Szekely, Gabor and Cattin, Philippe C.},
Editor = {Ayache, N and Ourdelin, S and Maeder, A},
Title = {Endoscopic navigation for minimally invasive suturing},
Booktitle = {MEDICAL IMAGE COMPUTING AND COMPUTER-ASSISTED INTERVENTION- MICCAI 2007,
   PT 2, PROCEEDINGS},
Series = {Lecture Notes in Computer Science},
Year = {2007},
Volume = {4792},
Pages = {620+},
Note = {10th International Conference on Medical Image Computing and
   Computer-Assisted Intervention (MICCAI 2007), Brisbane, AUSTRALIA, OCT
   29-NOV 02, 2007},
Abstract = {Manipulating small objects such as needles, screws or plates inside the
   human body during minimally invasive surgery can be very difficult for
   less experienced surgeons, due to the loss of 3D depth perception. This
   paper presents an approach for tracking a suturing needle using a
   standard endoscope. The resulting pose information of the needle is then
   used to generate artificial 3D cues on the 2D screen to optimally
   support surgeons during tissue suturing. Additionally, if an external
   tracking device is provided to report the endoscope's position, the
   suturing needle can be tracked in a hybrid fashion with sub-millimeter
   accuracy. Finally, a visual navigation aid can be incorporated, if a 3D
   surface is intraoperatively reconstructed from video or registered from
   preoperative imaging.},
