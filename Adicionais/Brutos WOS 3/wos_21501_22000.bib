Title = {Barriers to Co-Designing Mobile Technology with Persons with Dementia
   and Their Carers},
Booktitle = {NURSING INFORMATICS 2016: EHEALTH FOR ALL: EVERY LEVEL COLLABORATION -
   FROM PROJECT TO REALIZATION},
Series = {Studies in Health Technology and Informatics},
Year = {2016},
Volume = {225},
Pages = {1028-1029},
Note = {13th International Conference on Nursing Informatics, Geneva,
   SWITZERLAND, JUN 25-29, 2016},
Abstract = {Mobile applications can be used to help manage different aspects of
   long-term illnesses but many are not designed to meet the specific needs
   of people with dementia or their carers. This case study explores the
   barriers experienced when co-producing a memory and reminiscence app. A
   focus group and interviews were conducted with patient/carer dyads, an
   occupational therapist, project manager and software engineer involved
   in the design of the app. Data was analysed thematically using the
   framework approach. Several limitations such as poor technical knowledge
   and skills, negative attitudes and inaccurate perceptions of people with
   dementia slowed down or changed how the mobile app was developed.
   Compromises also had to be made over the final design of the app. More
   research to explore how mobile apps are co-designed with patients is
   needed.},
