@inproceedings{ WOS:000320997700011,
Author = {de Lima, C. S. A. and Moreira, R. da S. and Maurcio, H. de A. and
   Barbosa, V, J. M.},
Book-Group-Author = {MEDIMOND},
Title = {Functional tooth loss in adults of indigenous people of the brazilian
   northeast},
Booktitle = {ARTICLES FROM THE 13TH WORLD CONGRESS ON PUBLIC HEALTH},
Year = {2013},
Pages = {55-59},
Note = {13th World Congress on Public Health, Addis Ababa, ETHIOPIA, APR 23-27,
   2012},
Abstract = {In Brazil, very little is known about oral health epidemiology among
   indigenous people. The tooth loss due to dental caries and periodontal
   disease remains prevalent throughout the world despite progress in
   prevention and early treatment. In this way, tooth loss has a negative
   impact on chewing, swallowing, speech and appearance. The objective of
   this study was to analyze the functional tooth loss in adults 35 to 44
   years-old from an indigenous population called Xukuru of Ororuba,
   Northeast Brazil. Was conducted a cross-sectional study in a sample of
   195 indigenous. Clinical and epidemiological data were collected through
   oral examination and sociodemographic variables were collected using a
   structured questionnaire. The dependent variable was functional
   edentulism (absence of at least 20 teeth) and the independent variables
   were sex, age, locality and self-perception of oral health. After the
   descriptive analysis performed by means of frequency distributions and
   measures of central tendency were built logistic regression models to
   estimate odds ratios and their confidence intervals of 95\%. The study
   was approved by the Local Ethics Committee. The oral examinations
   performed at the age group 35-44 years identified 5,1\% of the
   population with total edentulism. Women increase in 2 times the chance
   of functional edentulism (p = 0.01). Above average age (39 years)
   increased by 97\% the chances of tooth loss (p = 0.02). Feel difficult
   to eat or pain in teeth increased 2.5 times the odds of being edentulous
   functional (p < 0.05). About the need for prosthesis, 45,1\% need upper
   prosthesis of more than 1 tooth and 68,2\% need lower prosthesis of more
   than 1 tooth. The study showed that tooth loss in adults is an important
   public health problem in this ethnic group. The prevalence was high and
   the results point to an issue of sex and age involved. In addition,
   self-perception of pain was also associated with this phenomenon. Oral
   health policies should be implemented for the rehabilitation of these
   individuals.},
