@article{ WOS:000181060500007,
Author = {Schlewitt-Haynes, LD and Earthman, MS and Burns, B},
Title = {Seeing the world differently: An analysis of descriptions of visual
   experiences provided by visual artists and nonartists},
Journal = {CREATIVITY RESEARCH JOURNAL},
Year = {2002},
Volume = {14},
Number = {3-4},
Pages = {361-372},
Note = {Annual Meeting of the American-Psychological-Society, DENVER, COLORADO,
   JUN, 1999},
Organization = {Amer Psychol Soc},
Abstract = {This project examined nonartists', hobby artists', student artists', and
   professional artists' responses to questions about the visual games and
   visual analyses they engaged in as adults and their recollections of
   these experiences from childhood. Findings indicate that in comparison
   to nonartists, (a) more artists reported these visual perceptual
   experiences, (b) artists reported having these experiences more often
   (particularly as adults), and (c) artists provided better examples of
   these perceptual experiences that were also more vivid and detailed
   (particularly as adults). These findings suggest an important connection
   between artists' reports of past and current visual experiences and
   actual performance on attention and object perception tasks. Our
   long-term goal is to understand the importance of visual perceptual
   abilities to the development of artistic talent.},
