Title = {A framework of penta-helix model to improve the sustainable
   competitiveness of the wine industry in Baja California based on
   innovative natural resource management},
Booktitle = {2020 11TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
   DEVELOPMENT (ICESD 2020)},
