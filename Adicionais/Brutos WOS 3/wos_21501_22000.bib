@inproceedings{ WOS:000302888300118,
Author = {Zhu, Qinyuan and Liu, Ning and Qian, Xin and Yang, Li and Dai, Mingzhong
   and Jiang, Xiaoqing and Li, Na and Sun, Liu and Liu, Zhichao and Lu,
   Genfa},
Editor = {Li, H and Xu, QJ and Zhang, D},
Title = {Non-carcinogenic risks induced by metals in drinking source groundwater
   of North Jiangsu (China)},
Booktitle = {PROGRESS IN ENVIRONMENTAL SCIENCE AND ENGINEERING (ICEESD2011), PTS 1-5},
Series = {Advanced Materials Research},
Year = {2012},
Volume = {356-360},
Number = {1-5},
Pages = {590+},
Note = {International Conference on Energy, Environment and Sustainable
   Development (ICEESD 2011), Shanghai Univ Elect Power, Shanghai, PEOPLES
   R CHINA, OCT 21-23, 2011},
Organization = {Xinjiang Univ; Hebei United Univ},
Abstract = {This study investigated the levels of eight metallic elements in
   groundwater of 15 tap water treatment plants (TWTPs) located in the
   North of Jiangsu Province, China during 2007-2009, and evaluated the
   non-carcinogenic risks posed by the metals. Among the metals, Zn had the
   highest concentration (105.3 mu g L-1), while Pb contributed most
   (40.3\%) to the average hazard index (Hi) of 15 TWTPs, followed by Cd
   (33.8\%) and Mn (12.2\%). Each metal, except Pb, had an average
   concentration below the permissible limit of China, WHO, EU and USA.
   Both hazard quotients of individual metals and HI of total
   non-carcinogenic risk in each TWTP were lower than 1, indicating that
   these pollutants provided negligible public health risk for local
