@inproceedings{ WOS:000074933900039,
Author = {Bush, S and Mandel, FS and Giardina, PJ},
Editor = {Cohen, AR},
Title = {Future orientation and life expectations of adolescents and young adults
   with thalassemia major},
Booktitle = {COOLEYS ANEMIA: SEVENTH SYMPOSIUM},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {1998},
Volume = {850},
Pages = {361-369},
Note = {7th Cooleys Anemia Symposium, CAMBRIDGE, MASSACHUSETTS, MAY 30-JUN 02,
   1997},
Organization = {New York Acad Sci; Cooleys Anemia Fdn; NIH, NHLBI; NIH, Natl Inst Diabet
   \& Digest \& Kidney Dis; Apotex Res Inc; NIH, NICHHD},
Abstract = {Until recently, Thalassemia Major was considered a fatal disease and
   patients did not usually live into adulthood, Advances in the medical
   management of the disease have greatly increased the life expectancy of
   these patients. The present study aims to evaluate the future
   orientation and other aspects of psychosocial functioning of
   thalassemics compared to healthy controls. Thirty patients and 33
   healthy subjects of similar age, ethnicity, education, and geographic
   area were compared on measures of future expectations, perceived social
   support, life orientation, health locus of control and hopelessness.
   Results show no significant differences between thalassemics and
   controls on all measures except for higher levels of internal health
   locus of control among the patient group. Results and implications of
   perceptions of thalassemics' future orientation relevant to patient care
   are discussed.},
