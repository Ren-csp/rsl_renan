@inproceedings{ WOS:A1997BH90C00036,
Author = {EdwardsJones, G and Sloan, C and EdwardsJones, ES},
Editor = {Boon, PJ and Howell, DL},
Title = {Monetary valuation of river flows as an element of the landscape: A case
   study from the River Almond, Scotland},
Booktitle = {FRESHWATER QUALITY: DEFINING THE INDEFINABLE?},
Year = {1997},
Pages = {448-453},
Note = {4th Annual Conference of the Research-and-Advisory-Services-Directorate
   of Scottish-Natural-Heritage on Freshwater Quality - Defining the
   Indefinable, UNIV STIRLING, STIRLING, SCOTLAND, SEP 06-07, 1995},
Organization = {Scottish Nat Heritage, Res \& Advisory Serv Directorate},
Abstract = {1. Planned alterations to the regional sewage treatment system will
   prevent treated sewage effluent from entering the River Almond,
   Scotland. As a result, low flows along the river could decrease further
   by up to 85\%.
   2. In order to ascertain the public's perception of these planned
   changes in flows, a questionnaire and contingent valuation was
   undertaken in Almondell Country Park.
   3. The results suggest that, on average, reductions in flows would
   decrease the utility derived from a visit to Almondell Country Park.
   Visitors to the park were willing to pay around pound 1 per visit as
   entrance fees if flows could be maintained at their preferred level.
   4. The advantages and disadvantages of utilizing contingent valuation
   methodology to aid environmental decisions are discussed.},
