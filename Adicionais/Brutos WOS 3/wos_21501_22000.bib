@inproceedings{ WOS:000272062000014,
Author = {Prashanthi, Devi. M. and Ranganathan, C. R. and Balasubramanian, S.},
Editor = {Lai, PC and Mak, ASH},
Title = {Socio-Demographic Determinants of Malaria in Highly Infected Rural
   Areas: Regional Influential Assessment Using GIS},
Booktitle = {GIS FOR HEALTH AND THE ENVIRONMENT: DEVELOPMENT IN THE ASIA-PACIFIC
   REGION},
