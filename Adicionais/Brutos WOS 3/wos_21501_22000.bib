Year = {2013},
Pages = {461-468},
Note = {13th International Multidisciplinary Scientific Geoconference, SGEM
   2013, Albena, BULGARIA, JUN 16-22, 2013},
Abstract = {Student knowledge of Nature of Science (NOS) is an important and
   critical issue to their understanding of science, as well as to the
   development of scientific literacy. In the same way, the ability to use
   and generate models is central to scientific literacy and to the
   learning of science. Having this in mind, and recognizing that teachers'
   views and practices strongly influence students' learning, we intended
   to evaluate Portuguese prospective science teachers' (PPST) views of
   Nature of Science (NOS), models and earth structure models. A
   questionnaire, focused on those aspects, was applied to 19 prospective
   science teachers at the University of Porto. In general, the majority of
   the participants revealed correct perceptions about those issues.
   However, some inconsistences and alternative conceptions were found.},
