@inproceedings{ WOS:000298735800143,
Author = {Mahmoudi, Babak and Principe, Jose C. and Sanchez, Justin C.},
Book-Group-Author = {IEEE},
Title = {Symbiotic Brain-Machine Interface Decoding Using Simultaneous Motor and
   Reward Neural Representation},
Booktitle = {2011 5TH INTERNATIONAL IEEE/EMBS CONFERENCE ON NEURAL ENGINEERING (NER)},
Series = {International IEEE EMBS Conference on Neural Engineering},
Year = {2011},
Pages = {597-600},
Note = {5th International IEEE Engineering-in-Medicine-and-Biology-Society
   (EMBS) Conference on Neural Engineering (NER), Cancun, MEXICO, APR
   27-MAY 01, 2011},
Organization = {Natl Sci Fdn (NSF); Engn Med \& Biol Soc (EMBS); IEEE},
Abstract = {In this work, we design and test a framework for neural decoding in
   Brain-Machine Interfaces based on the Perception Action Reward Cycle
   (PARC). Here the neural decoder in the BMI learns to translate motor
   neural states in the primary motor cortex (M1) into actions based on a
   reward signal estimated directly from Neucleus Accumbens (NAcc). The
   control architecture was designed based on the Actor-Critic method of
   Reinforcement Learning. We tested the decoding performance by
   simultaneous recording the M1 and NAcc neural data in a rat during a
   robot-assisted reaching task. This work shows that a BMI can be trained
   from a naive state to perform a reaching task using motor and error
   feedback signals directly from the brain.},
