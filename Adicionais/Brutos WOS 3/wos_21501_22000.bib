@article{ WOS:000431498300113,
Author = {Abd Hamid, Nadiah and Noor, Rohaya Md and Dangi, Mohamad Ridhuan Mat and
   Sabli, Nurshamimi and Yahya, Mastora},
Title = {Empirical Study on the Benefits of Tax Incentive for Islamic Home
   Financing in Malaysia},
