@article{ WOS:000233296400020,
Author = {Price, JL},
Title = {Free will versus survival: Brain systems that underlie intrinsic
   constraints on behavior},
Journal = {JOURNAL OF COMPARATIVE NEUROLOGY},
Year = {2005},
Volume = {493},
Number = {1},
