Booktitle = {WILDERNESS SCIENCE IN A TIME OF CHANGE CONFERENCE, VOL 2: WILDERNESS
   WITHIN THE CONTEXT OF LARGER SYSTEMS},
Series = {USDA FOREST SERVICE ROCKY MOUNTAIN RESEARCH STATION PROCEEDINGS},
