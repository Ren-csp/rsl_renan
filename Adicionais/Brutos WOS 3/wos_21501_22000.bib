Title = {Hydrodynamics of CO2 disposal in a deep saline formation in
   the midwestern United States},
Booktitle = {GREENHOUSE GAS CONTROL TECHNOLOGIES},
Year = {1999},
Pages = {157-162},
Note = {4th International Conference on Greenhouse Gas Control Technologies
   (GHGT-4), INTERLAKEN, SWITZERLAND, AUG 30-SEP 02, 1998},
Organization = {ABB Corp Res; Int Energy Agency Greenhouse Gas Programme; British Petr;
   ETH; Norsk Hydro; PSI; RITE; SAIC; Saudi Aramco; Shell; Siemens;
   Statoil; Swiss Fed Off Energy; Swiss Re; US DOE},
Abstract = {The sequestration of supercritical CO2 in deep saline formations is one
   of the options being considered for mitigation of greenhouse gas
   emissions. In the United States there is a strong correlation between
   the regions of very high CO2 emissions and large, regionally extensive
   deep saline reservoirs. A comprehensive evaluation of the
   hydrogrulogic,,geochemical, engineering, monitoring, cost, and public
   perception issues associated with CO2 sequestration in these reservoirs
   is being conducted using data from existing facilities that inject
   liquid wastes into these formations. Preliminary estimates of potential
   CO2 storage capacity in one formation show that several decades of CO2
   emissions from the power plants in the region can be sequestered.
   Multiphase hydrodynamic models and data from subsurface waste disposal
   facilities are being used to evaluate the hydrodynamic constraints on
   CO2 disposal on a site-specific basis.},
