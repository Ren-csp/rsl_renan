@inproceedings{ WOS:000073241400009,
Author = {Rigger, D},
Book-Group-Author = {API},
Title = {Edible oils: Are they really that different?},
Booktitle = {1997 INTERNATIONAL OIL SPILL CONFERENCE: IMPROVING ENVIRONMENTAL
   PROTECTION},
Year = {1997},
Pages = {59-61},
Note = {International Oil Spill Conference - Improving Environmental Protection,
   FT LAUDERDALE, FL, APR 07-10, 1997},
Organization = {US Coast Guard; US EPA; Amer Petr Inst; Int Petr Ind Environm Conservat
   Assoc; Int Maritime Org},
Abstract = {Congress passed the Edible Oils Regulatory Reform Act (EORRA) requiring
   regulatory agencies to differentiate between edible oils and petroleum
   oils when developing regulations because of the perception that edible
   oils are less toxic and less persistent. Recent EPA responses to
   vegetable oil spills on inland waters have highlighted some similarities
   and distinctions between edible oil spills and the more common petroleum
   oil spills.
   This paper looks at this issue broadly and focuses on the underlying
   premise of the EORRA that edible oils are less harmful and therefore
   should be regulated less rigorously than other classifications of oil.
   The paper discusses observations made during spill cleanup operations
   and examines the practical matter of cleaning lip edible oil spills. The
   paper will also make recommendations for additional research that would
   benefit the response community.},
