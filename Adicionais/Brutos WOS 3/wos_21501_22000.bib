@inproceedings{ WOS:000929880800057,
Author = {Lindbjerg, Diana},
Book-Group-Author = {ACM},
Title = {Three Exercises for the Visual Sensorium},
Booktitle = {PROCEEDINGS OF THE 2017 ACM SIGCHI CONFERENCE ON CREATIVITY AND
   COGNITION (C\&C 2017)},
Year = {2017},
Pages = {442-443},
Note = {ACM SIGCHI Conference on Creativity and Cognition (C and C), Natl
   Gallery Singapore, Singapore, SINGAPORE, JUN 27-30, 2017},
Organization = {Assoc Comp Machinery; ACM SIGCHI; U S Natl Sci Fdn},
Abstract = {We rely on apparatuses and technology to enlarge, enhance and document
   our visual surroundings such as microscopes, telescopes, cameras and
   computational software. These tools allow us to enhance what is not
   visible to the naked eye due to size, distance or duration. The
   apparatus produces objective measurements and allow for us to make
   documents that we can fix, share and discuss in an extended timespan. If
   the seemingly objective quality of an apparatus is not combined with an
   understanding of the limitations it presents we face a kind of
   blindness. The limitations of an apparatus can be extended to the
   subjective qualities of our senses, which we cannot separate ourselves
   from. Three Exercises for the Visual Sensorium examines how we can tune
   or perception and transform the subconscious registrations of our
   sensorium into conscious observations.},
