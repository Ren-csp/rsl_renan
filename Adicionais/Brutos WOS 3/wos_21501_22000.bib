Pages = {81-88},
Month = {FEB},
Note = {European Congress of the International-Association-for-Landscape-Ecology
   - Ecological Patterns and Processes in European Agricultural Landscapes,
   RENNES, FRANCE, JUN 06-10, 1993},
Organization = {INT ASSOC LANDSCAPE ECOL},
Abstract = {Fire is a recurrent disturbance in heathland landscapes of Birttany. 
   Our study considers relationships between landscape heterogeneity, rate
   of fire spread and fire frequency.  Heterogeneity is defined by the
   diversity and the fragmentation of landscape units at different scales. 
   This approach of fire processes proves that:  (1) perceived landscape
   heterogeneity is scale dependent; (2) fire speed is correlated with land
   cover heterogeneity at fine scales, but not at coarse scales; (3)
   heterogeneity increases with frequent fire, while diversity grows with
   one fire and reduces with higher fire frequency.},
