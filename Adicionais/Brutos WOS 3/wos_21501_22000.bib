@inproceedings{ WOS:000257018600128,
Author = {Wang, BoGuang and Zhang, Y. H. and Shao, M. and Zhou, Y. and Feng, Z. C.
   and Liu, C.},
Editor = {Li, G and Jia, Z and Fu, Z},
Title = {Characterization of ambient volatile aromatic compounds in Pearl River
   Delta, South China},
Booktitle = {2008 PROCEEDINGS OF INFORMATION TECHNOLOGY AND ENVIRONMENTAL SYSTEM
   SCIENCES: ITESS 2008, VOL 4},
Year = {2008},
Pages = {564-568},
Note = {International Conference on Informational Technology and Environmental
   System Science, Henan Polytechn Univ, Jiaozuo, PEOPLES R CHINA, MAY
   15-17, 2008},
Abstract = {Using sampling canisters and pre-concentrator and gas chromatograph-mass
   spectrum instrument, several regional ambient air intensive observations
   were conducted from June 2003 to July 2004 in Pearl River Delta (PRD),
   South China to investigate the spatial and temporal variations of
   volatile aromatic compounds (VAC). Results showed that the high
   pollution occurrence of aromatics appeared in July and August, the
   annual average concentrations of total VAC in Guangzhou urban. reached
   195 mu g/m(3) and were as 7.2 times high as that of Conghua sited in
   rural area. Motor vehicles exhaust and solvent using emission were the
   most significant VAC pollution sources in the PRD. Compared with the
   summer, the spring has one higher peak appearing on the noontime without
   in the traffic busy time, which may speculate that evaporating emissions
   sources under the condition of quickly temperature increment in spring
   can also bring a lot of VAC into the atmosphere. The annual average
   concentrations of benzene (B) and toluene (T) in PRD were highly up to
   9.54 mu g/m(3) and 40.04 mu g/m(3) respectively. The T/B ratio was a
   useful indicator for sources identification, such as 11.79 in the
   industrial function area with a lot of solvent using and process
   treating factories, 2.25 in the background area with clean air and 1.45
   in the Guangzhou Pear River tunnel with congested motor vehicles. On the
   vertical variation, VAC was mainly affected by the air pollution
   diffusion and was gradually decreasing with the height rising.},
Publisher = {PUBLISHING HOUSE ELECTRONICS INDUSTRY},
Address = {PO BOX 173 WANSHOU ROAD, BEIJING 100036, PEOPLES R CHINA},
