@inproceedings{ WOS:000085968300010,
Author = {Wright, E},
Editor = {Suster, D},
Title = {The game of reference},
Booktitle = {CONNECTIONISM AND THE PHILOSOPHY OF PSYCHOLOGY},
Series = {ACTA ANALYTICA: PHILOSOPHY AND PSYCHOLOGY},
Year = {1999},
Volume = {22},
Pages = {179-196},
Note = {Conference on Connectionism and Philosophy of Psychology, LJUBLJANA,
   SLOVENIA, AUG 14-16, 1997},
Abstract = {The author's New Critical Realism is a materialist constructivism based
   upon a naturalized epistemology that makes a clear distinction between
   non-epistemic sensing and motivated perception. The doubled perceptual
   relativism (i.e. in both sensing and perceiving) implied by such a view
   is shown to have evolutionary advantages, particularly since mutual
   correction from subject to subject can update percepts and concepts. It
   also provides a defence against Putnam's attack on naturalized
   epistemology. The pattern of this correction is argued to be that of the
   Story and the Joke. The need to project a perfect reference across
   differing perspectives leads to conflicts of interpretation that can
   prove adaptively valuable. A number of corollaries for other fields of
   philosophy is drawn in as support.},
Publisher = {VERLAG JOSEF H ROLL},
