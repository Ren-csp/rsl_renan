Note = {21st Pan-Asian Congress of Sports and Physical Education, Jiangxi Normal
   Univ, Nanchang, PEOPLES R CHINA, APR 23-25, 2010},
Organization = {Pan Asian Soc Sports \& Phys Educ},
Abstract = {This paper studied 1,000 undergraduate students in North China Institute
