Title = {Mapping impervious surfaces in the Xiangjiang River basin based on
   remote sensing spectral indices: a case study in Chang-Zhu-Tan region},
Booktitle = {EARTH RESOURCES AND ENVIRONMENTAL REMOTE SENSING/GIS APPLICATIONS VIII},
