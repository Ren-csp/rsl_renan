Title = {Using human-in-the-loop and explainable AI to envisage new future work
   practices},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL CONFERENCE ON PERVASIVE
   TECHNOLOGIES RELATED TO ASSISTIVE ENVIRONMENTS, PETRA 2022},
