@article{ WOS:000367496600031,
Author = {Lakonawa, Petrus},
Title = {Promoting Social Justice Through Inclusive Languages of God in Christian
   Theologies},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2015},
Volume = {21},
Number = {7, SI},
Pages = {2308-2311},
Month = {JUL},
Note = {International Conference on Education (ICOED), Bali, INDONESIA, JUN
   02-04, 2015},
Abstract = {What is the right way to speak about God? This question is very
   important because the languages about God are foundations of a community
   of faith. In the languages about God, people put the primary symbol of
   the whole religious system. Hence the ways in which a community of faith
   shapes languages about God implicitly represents what it takes to be the
   highest good. Such speaking, in turn, powerfully molds the identity of
   the community and directs its praxis. This article will discuss a need
   for inclusive languages of God. The author shares the suggestion of
   Elizabeth Schussler Fiorenza that those who are excluded from
   institutions of knowledge and power must be allowed to participate in
   articulating their perceptions and imaginations as to promote a more
   just, egalitarian and inclusive society.},
