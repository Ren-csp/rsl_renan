Series = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts},
Year = {2014},
Pages = {257-262},
Note = {International Multidisciplinary Scientific Conferences on Social
   Sciences and Arts (SGEM 2014), Albena, BULGARIA, SEP 01-10, 2014},
Organization = {Bulgarian Acad Sci; Acad Sci Czech Republ; Latvian Acad Sci; Polish Acad
   Sci; Russian Acad Sci; Serbian Acad Sci \& Arts; Slovak Acad Sci Intro;
   Natl Acad Sci Ukraine; Natl Acad Sci Armenia; Sci Counc Japan; World
   Acad Sci TWAS; European Acad Sci, Arts \& Lett; Acad Fine Arts Zagreb
   Croatia; Croatian Acad Sci \& Arts; Acad Sci Moldova; Montenegrin Acad
   Sci \& Arts; Georgian Acad Sci; Acad Fine Arts \& Design Bratislava;
   Russian Acad Arts; Turkish Acad Sci; SGEM},
Abstract = {At least in the adult population, it is well known that certain
   cognitive styles constitute vulnerability factors for specific emotional
   disorders. A preference asymmetry towards negative stimuli is common to
   both mood and anxiety disorders. For the purpose of understanding how
   this pervasive asymmetry towards negative features of stimuli influences
   emotional development the most promising area to examine is how emotions
   develop typically or become problematic during adolescence according to
   cognitive particularities. The aim of our study is to investigate the
   negativity bias displayed by adolescents in relation to their cognitive
   style and emotional vulnerabilities. In order to investigate the
   negative bias during adolescence we used self-report and performance
   based measures. Adolescents (N=74) played a computer game designed to
   assess their ability to learn positive and negative novel stimuli and to
   generalize learned information to other similar stimuli and completed
   self-report behavioral measures (YSR - ASEBA, Achenbach, 2001).
   Displaying a bias towards negativity was better associated with
   internalizing problems but in the present study the difference between
   the internalizing and externalizing group was not significant. Although
   further research is needed, both theoretical and practical implications
   with regard to emotional vulnerability during development are discussed.},
