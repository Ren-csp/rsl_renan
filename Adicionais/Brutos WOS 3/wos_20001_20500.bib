@inproceedings{ WOS:000404788200019,
Author = {Ouedraogo, Faissal R. and Zhang, Jie and Tejada-Martinez, Andres E.},
Editor = {Dunn, CN and VanWeele, B},
Title = {Improving the Hydraulic Performance of a Waste Stabilization Pond via
   Inlet Retrofit},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2017: WATER,
   WASTEWATER, AND STORMWATER; URBAN WATERSHED MANAGEMENT; AND MUNICIPAL
   WATER INFRASTRUCTURE},
Year = {2017},
Pages = {253-266},
Note = {17th Annual World Environmental and Water Resources Congress,
   Sacramento, CA, MAY 21-25, 2017},
Organization = {Amer Soc Civil Engineers; Amer Soc Civil Engineers, Environm \& Water
   Resources Inst},
Abstract = {Wastewater is transitioning from being viewed as a waste to being
   utilized as a resource in the production of reclaimed water. Reclaimed
   water, obtained through waste stabilization pond treatment technologies,
   has the potential to offset potable water needs for irrigation purposes
   as well as fertilizers for crop growth. In developing countries, where
   waste stabilization ponds are widely used, a major issue is the lack of
   maintenance which can lead to considerable amounts of sludge piled at
   the bottom of the pond. This sludge accumulation reduces the treatment
   capacity of the waste stabilization pond and possibly, the treatment
   efficiency which is vital for reuse purposes. Improving the hydraulic
   performance of waste stabilization ponds is an important management
   strategy that assures protection of public health and the environment.
   It also maximizes the potential reuse of valuable resources found in the
   reclaimed water. In cases for which desludging of the pond is a
   challenge, retrofitting pond inlet can offer an alternative to improve
   pond hydraulic performance. This option is a low-cost substitute which
   offers improved retention times based on the types of retrofit. In this
   study, two inlets retrofit geometries are investigated using
   computational fluid dynamics. The improvements in retention times
   observed make this approach a viable solution in places where desludging
   is not a priority in pond management.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Ouedraogo, FR (Corresponding Author), Univ S Florida, Dept Civil \& Environm Engn, 4202 E Fowler Ave,ENG 311, Tampa, FL 33620 USA.
