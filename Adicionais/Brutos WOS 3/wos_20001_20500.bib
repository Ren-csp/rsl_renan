@inproceedings{ WOS:001286424400027,
Author = {Herman, T. Liam and Ogawa, Michael-Brian C. and Crosby, Martha E.},
Editor = {Schmorrow, DD and Fidopiastis, CM},
Title = {Utilizing Current Technologies to Foster Augmented On-line Learning},
Booktitle = {AUGMENTED COGNITION, AC 2021},
