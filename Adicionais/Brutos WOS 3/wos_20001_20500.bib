Title = {Does a sustainable development concept bring a change in transport
   planning?: The case of the implementation of three major infrastructures
   in Montreal},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING III, VOLS 1 AND 2},
Series = {WIT Transactions on Ecology and the Environment},
