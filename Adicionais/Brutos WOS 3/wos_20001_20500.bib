@inproceedings{ WOS:000083105000261,
Author = {Chung, QB},
Book-Group-Author = {DECIS SCI INST
   DECIS SCI INST},
Title = {Role of model management systems in developing problem-solving
   strategies: An exploratory study},
Booktitle = {DECISION SCIENCES INSTITUTE 1998 PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {615-617},
Note = {29th Annual Meeting of the Decision-Sciences-Institute, LAS VEGAS, NV,
   NOV 21-24, 1998},
Organization = {Decis Sci Inst},
Abstract = {Model management systems (MMS) empower the decision makers by providing
   modeling knowledge and the decision models throughout the
   problem-solving phases. Despite the notable volume of model management
   literature, very little is known about how decision makers actually
   benefit from employing MMS. In this paper, we show that the decision
   makers who receive adequate modeling support from MMS outperform those
   without such support. Also, we provide empirical evidence that the MMS
   help turn the decision makers' perception of the problem solving task
   from number crunching into development of strategies, consequently
   changing their decision making behavior.},
