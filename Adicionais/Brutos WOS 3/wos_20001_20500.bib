Year = {1997},
Pages = {84-97},
Note = {4th Neural Computation and Psychology Workshop (NCPW4), LONDON, ENGLAND,
   APR 09-11, 1997},
Abstract = {A variety of experimental results indicate that the human visual system
   processes faces at least to some extent holistically, rather than by
   analysing individual features such as nose and eyes. Principal
   Components Analysis (PCA) of face images, which is widely used in
   engineering approaches to face identification, produces an inherently
   global representation. We investigate the psychological plausibility of
   this representation, looking at correlations with human perceptions of
   memorability and similarity. We show that transformation of faces to an
   average shape prior to PCA improves correlations with human ratings.},
