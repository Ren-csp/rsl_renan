@article{ WOS:000246315800003,
Author = {Viguri, J. R. and Irabien, M. J. and Yusta, I. and Soto, J. and Gomez,
   J. and Rodriguez, P. and Martiriez-Madrid, M. and Irabien, J. A. and
   Coz, A.},
Title = {Physico-chemical and toxicological characterization of the historic
   estuarine sediments:: A multidisciplinary approach},
Journal = {ENVIRONMENT INTERNATIONAL},
Year = {2007},
