@inproceedings{ WOS:000759163000020,
Author = {Correia, I, A. and Nunes, A. and Silva, G. and Fernandes, P. O. and
   Moreira, J. and Soares, L. A.},
Editor = {DeCarvalho, JV and Rocha, A and Liberato, P and Pena, A},
Title = {Sport Tourism Event and Perceived Economic Impacts: The Case of World
   Bodyboard Championship 2018, Viana do Castelo, Portugal},
Booktitle = {ADVANCES IN TOURISM, TECHNOLOGY AND SYSTEMS, VOL 1},
Series = {Smart Innovation Systems and Technologies},
Year = {2021},
Volume = {208},
