@inproceedings{ WOS:000251479600020,
Author = {Ning Jicai and Gao Zhiqiang and Zhang Zulu and Li Zijun},
Editor = {Gao, W and Ustin, SL},
Title = {Influence of land use/cover change on land surface temperature of
   Laizhou Bay plain},
Booktitle = {REMOTE SENSING AND MODELING OF ECOSYSTEMS FOR SUSTAINABILITY IV},
