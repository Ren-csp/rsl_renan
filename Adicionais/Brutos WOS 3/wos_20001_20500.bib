@inproceedings{ WOS:000225303300027,
Author = {Kornfeld, IE},
Editor = {Calabrese, EJ and Kostecki, PT and Dragun, J},
Title = {PCBS in the Delaware: A thirty-one year technical and legal odyssey},
Booktitle = {CONTAMINATED SOILS, SEDIMENTS AND WATER: SCIENCE IN THE REAL WORLD, VOL
   9},
