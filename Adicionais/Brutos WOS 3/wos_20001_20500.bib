@article{ WOS:000083655500004,
Author = {Newsom-Davis, IC and Abrahams, S and Goldstein, LH and Leigh, PN},
Title = {The emotional lability questionnaire: a new measure of emotional
   lability in amyotrophic lateral sclerosis},
