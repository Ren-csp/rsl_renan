@article{ WOS:000228013900003,
Author = {Halkitis, PN and Green, KA and Mourgues, P},
Title = {Longitudinal investigation of methamphetamine use among gay and bisexual
   men in New York City, findings from project BUMPS},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
