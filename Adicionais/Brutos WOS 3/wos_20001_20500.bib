Title = {Solar Hybrid System for Electricity and Air Heating - Experimental
   Research},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2023},
