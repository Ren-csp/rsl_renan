@inproceedings{ WOS:000346067900394,
Author = {Hadjibiros, Kimon},
Editor = {Lekkas, TD},
Title = {HUMAN ECOLOGY: ARE ITS PREDICTIONS RELIABLE?},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {The criticism against economic development employed by Political
   Ecology, many environmental organizations and Green political parties is
   fed by the scientific conclusions of Human Ecology. They emphasize
   problems of overpopulation, pollution and resource depletion, using
   ecological science's approaches of man's nature as an animal organism in
   an artificial ecosystem. However, Human Ecology has not developed an
   expressed and recognized methodological approach; although it does not
   use either sociological or interdisciplinary methods, it expects to
   produce sound conclusions about the biological, environmental,
   demographic and technological life conditions of social systems. One of
   its basic ideas was that ``populution{''} (population+pollution)
   increases faster than natural resources do, leading humanity to a
   hopeless dead-end. This is obviously a modern version of the classic
   Malthusian idea. Human population growth in the last 200 years is
   explosive, e.g. throughout the 20th century each additional billion has
   been achieved in a shorter period of time; pollution likely affects over
   one billion people around the world, with millions poisoned and killed
   each year; resources are considered to be necessarily subject to the
   saturation-depletion principle; the startling contrast with natural
   systems revealed by considering the situation with respect to resources
   seems to indicate the unstable nature of current human situation.
   Generally, the main statement of political ecology was: industrial
   societies generate contradictions (population, energy, raw materials,
   water, foodstuffs, pollution) that will soon lead them to collapse. The
   ecological discourse, starting from a scientific basis, soon acquired
   ideological extensions; a self-feeding catastrophology had been
   developed. Starting in the seventies, a flow of ominous predictions had
   converged to the estimation that, in the beginning of the 21st century,
   the planet's condition would not be livable, that an environmental doom
   was to be expected. Such predictions have been published in a lot of
   scientific books and supported by many eminent representatives of Human
   Ecology. The pessimistic statements have converged with a more or less
   intense smoldering opposition towards the industrial civilization,
   rationalism and the modern western thinking; that became a significant
   cultural tendency over last decades and has been supported by a large
   part of ecological movements; trust in the power of reason and
   materialistic views of the world were questioned, the return to a
   metaphysical spiritual tradition and to past and moral values had been
   suggested. However, today it is ascertained that those predictions about
   future environmental doom have not been verified. This may be partly
   connected with methodological weaknesses related to the lack of
   systemic, interdisciplinary and/or transdisciplinary approaches as well
   as to the negative feedbacks from the human society's Malthusian
   concerns. On the other hand, current scientific predictions about global
   warming constitute a new challenge; do they present similar
   methodological weaknesses or the proposed mitigation measures are
   justified by a sound scientific analysis?},
