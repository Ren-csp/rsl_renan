Note = {6th Summer Symposium on the Philosophy of Chemical And Biochemical,
   GEORGETOWN UNIV, WASHINGTON, D.C., AUG 04-08, 2002},
Organization = {Int Soc Philosophy Chem \& Biochem},
Abstract = {This article elaborates a key aspect of applied visualization in
   chemistry: dimensionality. On the one hand, the dimensionality of
   visualization is restricted by the medium of information transfer; on
   the other hand, several techniques make it possible to achieve
   visualizations of parameters of multidimensional objects of chemical
   research in ways that, in a sense, transcend the limits of the physical
   space-time continuum. Effectiveness of chemistry research, as well as of
   chemical education, requires proper perception of parameters of objects
   being investigated. The appropriate application of visualization
   techniques can be crucial.},
