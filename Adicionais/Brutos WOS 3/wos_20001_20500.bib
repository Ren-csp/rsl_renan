@inproceedings{ WOS:000171939300012,
Author = {Innes, EA and Buxton, D and Maley, S and Wright, S and Marks, J and
   Esteban, I and Rae, A and Schock, A and Wastling, J},
Editor = {House, JA and Kocan, KM and Gibbs, EPJ},
Title = {Neosporosis - Aspects of epidemiology and host immune response},
Booktitle = {TROPICAL VETERINARY DISEASES: CONTROL AND PREVENTION IN THE CONTEXT OF
   THE NEW WORLD ORDER},
