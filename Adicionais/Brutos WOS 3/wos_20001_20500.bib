@article{ WOS:000235305600011,
Author = {Park, LE and Crocker, J},
Title = {Interpersonal consequences of seeking self-esteem},
Journal = {PERSONALITY AND SOCIAL PSYCHOLOGY BULLETIN},
Year = {2005},
Volume = {31},
Number = {11},
Pages = {1587-1598},
Month = {NOV},
Note = {14th Annual Meeting of the American-Psychological-Society, NEW ORLEANS,
   LA, JUN, 2002},
Organization = {Amer Psychol Soc},
Abstract = {This study examines the interactive effects of self-esteem,
   contingencies of self-worth, and ego threat on supportiveness and
   liking. Targets high or low in self-esteem and academic contingency
   receive failure test feedback or no evaluative feedback. Then, targets
   interact with another participant who discloses a personal problem;
   afterward, both participants complete questionnaires assessing targets'
   supportiveness and liking. High self-esteem, highly contingent targets
   feel less supportive and like partners less after interacting under
   threat than under no threat. Partners, in turn, perceive these targets
   to be less supportive and less likeable. Low self-esteem, highly
   contingent targets show the reverse pattern, although these findings do
   not reach statistical significance. Further analyses reveal that the
   interpersonal effects of ego threat were caused by threats in a specific
   domain of contingency (e.g., academics) rather than being a contingent
   person, in general or having external or internal contingent self-
   worth. Implications for self-esteem and interpersonal processes are
   discussed.},
Publisher = {SAGE PUBLICATIONS INC},
