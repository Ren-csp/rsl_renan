   O'Rourke-Potockis, H. and Tzanev, D. and Sandie, M. and Mandic, D. and
   Goncalves, H. and Duarte, P. and Trindade, P. and Loureiro, D.},
Book-Group-Author = {IOP},
Title = {Enhancing Market Readiness for nZEB Implementation},
Booktitle = {8TH CONFERENCE OF THE SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT
   EENVIRO 2022},
Series = {IOP Conference Series-Earth and Environmental Science},
