@inproceedings{ WOS:000335817900012,
Author = {van Rijn, Hedderik and Kononowicz, Tadeusz and Vidal, Franck and Casini,
   Laurence and Wiener, Martin and Penney, Trevor B. and Ng, Kwun Kei},
Editor = {Vatakis, A},
Title = {The role of the SMA and the Contingent Negative Variation in interval
   timing},
