@inproceedings{ WOS:000335607400037,
Author = {Jenaabadi, Hossein},
Editor = {Bozkurt, T and Demirok, M},
Title = {The study and comparison of stress levels and coping strategies in
   parents of exceptional (mentally retarded, blind and deaf) and normal
   children in Zahedan},
Booktitle = {4TH WORLD CONFERENCE ON PSYCHOLOGY, COUNSELING AND GUIDANCE (WCPCG-2013)},
Series = {Procedia Social and Behavioral Sciences},
