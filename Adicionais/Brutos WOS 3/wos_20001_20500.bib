Title = {Estimating the Impact of the MRT Elevated Railway System on Carbon
   Reduction in Taichung, Taiwan},
Booktitle = {2019 3RD INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE},
