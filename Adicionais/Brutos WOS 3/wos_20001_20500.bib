@article{ WOS:000272077900009,
Author = {Fallon, James B. and Irvine, Dexter R. F. and Shepherd, Robert K.},
Title = {Neural prostheses and brain plasticity},
Journal = {JOURNAL OF NEURAL ENGINEERING},
Year = {2009},
Volume = {6},
