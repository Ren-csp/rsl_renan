@inproceedings{ WOS:000446248300090,
Author = {Ririhena, S. A. J. and Astuti, A. D. and Fachrul, M. F. and Silalahi, M.
   D. S. and Hadisoebroto, R. and Rinanti, A.},
Editor = {Rinanti, A and Hadisoebroto, R and Abdullah, AG and Nandiyanto, ABD},
Title = {Biosorption of heavy metal copper (Cu2+) by Saccharomyces
   cerevisiae},
