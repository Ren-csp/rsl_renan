@inproceedings{ WOS:001510305700008,
Author = {Akcali, Atakan},
Editor = {Crawford, D and Foss, J and Lambert, N and Reed, M and Kriebel, J},
Title = {Gamifying the Museum: Enhancing Immersive Art Experiences with Social
   Connections and Personal Identity Exploration},
Booktitle = {TECHNOLOGY, INNOVATION, ENTREPRENEURSHIP AND EDUCATION, TIE 2023},
Series = {Lecture Notes of the Institute for Computer Sciences Social Informatics
   and Telecommunications Engineering},
Year = {2024},
Volume = {575},
Pages = {107-123},
Note = {4th International Conference on Technology Innovation Entrepreneurship
   and Education-TIE, University of Cambridge Magdalene College, Cambridge,
   ENGLAND, SEP 27-28, 2023},
Abstract = {This paper explores how social and gamified museum experiences can
   enhance the immersive art experience, encouraging engagement and
   interactivity. Museums provide a safe space for visitors to explore
   their individual identities and connect with others, forging personal
   connections and shared experiences. People often visit museums with
   friends or family to spend quality time together. Social and gamified
   immersive art experiences provide interactive environments that
   challenge assumptions and facilitate meaningful interactions, allowing
   individuals to explore their identities and develop a sense of
   belonging. By harnessing the transformative power of games and immersive
   art, individuals navigate the complexities of their identities,
   fostering understanding and connection within themselves and their
   community. Many museums now offer exhibits that encourage active
   participation, immersing visitors in different worlds and creating
   unique, unforgettable experiences. This study reveals that visitors
   primarily seek to appreciate art, gain knowledge, inspiration,
   creativity, and positive emotions like happiness and warmth.
   Participants expressed interest in gamified experiences and forming new
   connections. These findings can guide museums in tailoring their
   programs to meet visitors' needs and desires. By utilising these
   findings, museums can acquire significant knowledge and enhance their
   programs to cater to the requirements and desires of their visitors more
