@article{ WOS:000399358400087,
Author = {Nor, Mohd Nazli Mohd and Smith, Malcolm and Ismail, Zubaidah and Taha,
   Roshaiza},
Title = {The Effect of Time Budget Pressure on Auditors' Behaviour},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {1, SI},
Pages = {356-360},
Month = {JAN},
Note = {Conference on Advanced Research on Business, Management and Humanities
   (ARBUHUM), Bandung, INDONESIA, MAR 15-17, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {This paper investigates the occurrence of time budget pressure among
   auditors in Malaysia. Using the questionnaire, auditors registered with
   the Malaysian Institute of Accountant were approached to gather their
   perceptions about the time budget pressure in the previous year of audit
   work and their respond to the pressure. The results indicate that time
   budget pressure was difficult to attain regardless position, experience,
   firm size and gender; and under tight budget, majority of the auditors
   work harder and charge time properly or requesting extra budget to
   complete the audit engagement.},
Publisher = {AMER SCIENTIFIC PUBLISHERS},
Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
