Organization = {Assoc Comp Machinery},
Abstract = {This work contributes an investigation of on-skin electromagnetic
   actuator for indicating directions through tactile cues. In the study (N
   = 16), the actuator was tested on three locations on participants' arms.
   We compared the perception accuracy on these locations and draw the
   conclusion that the participants could identify the stimulus clearly
   with the actuator begin placed on the underside of the wrist best. Taken
   together, our result demonstrates that our work would be used as an
   additional stimulus combined with other haptic interaction to deliver
   rich information to the users in potential.},
