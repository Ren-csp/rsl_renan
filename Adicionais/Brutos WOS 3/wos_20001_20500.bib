@inproceedings{ WOS:000338049000009,
Author = {Yagil, Dana and Medler-Liraz, Hana},
Editor = {Zerbe, WJ and Ashkanasy, NM and Hartel, CEJ},
Title = {SERVICE EMPLOYEES' TRAIT AUTHENTICITY AND CUSTOMER SATISFACTION},
Booktitle = {INDIVIDUAL SOURCES, DYNAMICS, AND EXPRESSIONS OF EMOTION},
Series = {Research on Emotion in Organizations},
Year = {2013},
Volume = {9},
Pages = {169-185},
Note = {International Conference on Emotion and Organizational Life, Helsinki,
   FINLAND, JUL 02-07, 2012},
Abstract = {This chapter explores the effect of service employees' trait
   authenticity on customer satisfaction as mediated by work engagement,
   surface acting, and perceived authenticity. Data were collected from
   service employee-customer dyads. The results indicate that employees'
   work engagement and surface acting mediate the effect of trait
   authenticity on customers' satisfaction and perception of authenticity.
   Trait authenticity is positively related to work engagement and
