Title = {SEMANTIC TRANSFORMATIONS OF RUSSIAN CULTURAL HERITAGE IN THE
   CONSCIOUSNESS OF SOVIET ERA},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
