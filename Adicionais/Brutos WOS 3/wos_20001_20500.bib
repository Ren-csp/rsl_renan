@inproceedings{ WOS:000279844100030,
Author = {Nakayama, Ken and Maljkovic, Vera and Kristjansson, Arni},
Editor = {Gazzaniga, MS},
Title = {Short-Term Memory for the Rapid Deployment of Visual Attention},
Booktitle = {COGNITIVE NEUROSCIENCES III, THIRD EDITION},
Year = {2004},
Pages = {397-408},
Note = {Conference of the Summer-Institute-in-Cognitive-Neuroscience, Lake
   Tahoe, CA, JUN, 2006},
Organization = {Summer Inst Cognit Neurosci},
Abstract = {We describe a short-term memory system useful for the rapid deployment
   of focal visual attention. The memory system is primitive, temporary,
   cumulative, and efficacious. It automatically links separable features
   of objects to the act of attentional deployment so that visual
   perception and performance are greatly enhanced. The effects of the
   memory cannot be overridden by higher level knowledge. Its properties
   can account for those aspects of searching and foraging behavior
   currently attributed to ``search images.{''} The learning described here
   is likely to be general, not confined to the rapid deployment of focal
   visual attention.},
