@article{ WOS:000445018400157,
Author = {Uyun, Qurotul and Kurniawan, Irwan Nuryana},
Title = {Taubat (Repentance) and Istighfar (Seek Forgiveness from Allah) Therapy
   to Improve Subjective Well-Being of Master Students: A Preliminary Study},
