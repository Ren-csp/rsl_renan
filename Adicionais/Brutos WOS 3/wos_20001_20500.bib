@inproceedings{ WOS:000439411400028,
Author = {Xu, D. P. and Zhao, B. and Li, T. S. and Zhu, J. W. and Yu, M. M.},
Editor = {Li, P},
Title = {SD simulation study on degraded farmland policy on farming-pastoral area
   under the constrains of water resources-Taking Tongliao City of Inner
   Mongolia as example},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT (WRE
   2017)},
