@article{ WOS:000396642500003,
Author = {Ignjatovic, Dusan and Ignjatovic, Natasa Cukovic and Popovic, Milica
   Jovanovic},
Title = {POTENTIAL FOR FOR ENERGY EFFICIENCY AND CO2 EMISSION
   REDUCTION BY REFURBISHMENT OF HOUSING BUILDING STOCK BUILT BEFORE 1919
   IN SERBIA},
Journal = {FRESENIUS ENVIRONMENTAL BULLETIN},
Year = {2017},
