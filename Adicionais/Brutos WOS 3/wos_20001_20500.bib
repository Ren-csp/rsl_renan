@inproceedings{ WOS:000399861400084,
Author = {Wang, Shenghua and Tan, Jian},
Editor = {Chang, T},
Title = {Review of Digital City 3D Building Data Model Researches},
Booktitle = {2012 4TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND
   INFORMATION APPLICATION TECHNOLOGY (ESIAT 2012)},
Series = {Advances in Biomedical Engineering},
Year = {2013},
Volume = {14},
Pages = {488-493},
Note = {4th International Conference on Environmental Science and Information
   Application Technology (ESIAT 2012), Bali, INDONESIA, DEC 01-02, 2012},
Abstract = {3D building data model is the data abstraction of three-dimensional
   characteristics of the buildings in the real world, determines the depth
   and breadth of the ``Digital City{''} applications on supporting the
   construction of urban environment, city management, and its researches
   worth a thoroughly review. So far a lot of building three-dimensional
   data models have been issued. Summarized from spatial division aspect,
   these models can be divided into four categories: (1) data model based
   on voxel (inlaid), due to the data model cannot describe the complex
   irregular entities, topological relationships and do not have the
   ability and the graphic display (depth test frustum clipping), spatial
   analysis, spatial index exists obviously inadequate, Building data model
   based on voxel (inlaid) is difficult to express the external form of the
   building. (2) surface-based (vector)data model, The disadvantage is that
   the data modification operations need to modify the boundary data and
   topology, augmenting maintenance workload; and its boundary defined by
   discrete points is difficult to accurately expressed the smooth surfaces
   of buildings.(3) hybrid data models, though the hybrid model can be
   adjusted to the different data types according to the application needs,
   is just a surface mixture without internal combination, and did not
   realize expression patterns of the building three-dimensional
   characteristics.(4) thematic data models based on the above three types.
   Due to the urgent application requirements on spatial information of the
   Digital City buildings, many researchers proposed thematic data models.
   These special models provide solutions to some application-specific
   problems. However, Due to the greater restrictions within model
   scalability and versatility than ordinary models, thematic data models
   are still in lack of improvement in expression of complex irregular
   architectural form. Eventually all the 3D building models unable to meet
   the application needs of building space, also unable to support
   applications ranges from pollutant dispersion calculation, traffic path
   planning, electricity and water pipe network deployment, to many other
   Habitat further study of the environmental issues in the
   three-dimensional world. In-depth study is still necessary for this
   basic science issue.},
