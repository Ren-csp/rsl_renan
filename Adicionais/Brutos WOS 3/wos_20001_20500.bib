@inproceedings{ WOS:000455738300017,
Author = {Suria Martinez, Raquel},
Editor = {Puevo, AA and Rivera, FF and Perez, MN and Martinez, DS},
Title = {DISABILITY AND SPINAL CORD INJURY TRAFFIC ACCIDENT: STUDY OF THE MOOD OF
   THE VICTIMS},
Booktitle = {AVANCES EN PSICOLOGIA JURIDICA Y FORENSE},
