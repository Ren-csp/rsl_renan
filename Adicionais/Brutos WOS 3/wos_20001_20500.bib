@inproceedings{ WOS:001446861900012,
Author = {Ovalle, Alvaro and Lucas, Simon M.},
Editor = {Verbelen, T and Lanillos, P and Buckley, CL and DeBoom, C},
Title = {Modulation of Viability Signals for Self-regulatory Control},
Booktitle = {ACTIVE INFERENCE, IWAI 2020},
