Editor = {Westwood, JD and Haluck, RS and Hoffman, HM and Mogel, GT and Phillips, R and Robb, RA and Vosburgh, KG},
Title = {Why You Really Eat? Virtual Reality in the Treatment of Obese Emotional
   Eaters},
Booktitle = {MEDICINE MEETS VIRTUAL REALITY 16: PARALLEL, COMBINATORIAL, CONVERGENT:
   NEXTMED BY DESIGN},
