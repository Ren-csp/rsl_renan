@inproceedings{ WOS:000464894900015,
Author = {Peng, Cong and Li, Chunhui and Wang, Xuan and Cai, Yanpeng and Zhao, Fen},
Editor = {Chu, H and Zhang, H},
Title = {Investigation and Analysis of the Spatio-Temporal Dynamics in Surface
   Water Area Variations in Changzhou Based on RS and GIS},
Booktitle = {WATER RESOURCES AND ECOLOGICAL CARRYING CAPACITY},
Year = {2018},
Pages = {88-94},
Note = {International Conference on Environmental and Water Resources
   Engineering (EWRE), SOUTH KOREA, OCT 12-14, 2018},
Organization = {Int Assoc Appl Sci \& Engn; Natl Cheng Kung Univ},
Abstract = {In this paper, with selected 16 Landsat images, we used RS and GIS
   technologies and the modified normalized difference water index (MNDWI)
   method, to extract the surface water area of Changzhou, China, from 1986
   to 2016. The spatio-temporal variation characteristics and trends of the
   surface water area in Changzhou City were analyzed during the past 30
   years. Combined with the climate change and human activities in the same
   period, the main reasons for the temporal and spatial variation of
   surface water area were discussed. The results are as follows: The
   surface water area of Changzhou City had experienced a decline from
   218.6 km(2) in 1986 to 187.4 km(2) in 1998, and had resumed to increase
   to 231.3 km(2) in 2010, and then decreased to 223.3 km(2) in 2016. The
   overall trend was divided into a shrinking-recovery-declining dynamic
   trend. The rapid development of economy and the construction of
   urbanization have led to the encroachment of the surface water area in
   the central urban; climate change and human activities have jointly led
   to the reduction of surface water area in Changzhou, in which human
   activities are the main factors.},
