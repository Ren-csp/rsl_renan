@article{ WOS:000383113900014,
Author = {Mitot, Kendy and Kuan, Victoria and Sanusi, Khatijah},
Title = {Sarawak Culture: A Study on the Cosmic Influence on the Bidayuh
   Traditional Woodcarving ('Rasang')},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {5-6, SI},
Pages = {1156-1159},
Month = {MAY-JUN},
Note = {International Symposium on Social Sciences, Arts and Humanities
   (SYSSARM), Bali, INDONESIA, SEP 29-OCT 01, 2015},
Abstract = {Every culture have a variety of work of arts which its people of that
   culture can respond according to their aesthetic significance. These
   also are means of communication through their arts, which provide the
   selective awareness and the perceptions to communicate with the
   spiritual world and its community. To the outsiders, they may see these
   rituals ceremony as something insignificant but to the Bidayuh
   community, their cosmology, myth, legend, arts, ceremony or ritual
   events and history are all equally important. Their works of arts
   produce a wide variety of forms and functions that influence on their
   worldviews and environment. These works of arts used for their ritual
   ceremony have specific functions and symbolic meanings which connect
   themselves to their spiritual world. The objective will specifically
   look into a more intrinsic interpretation from the point of view as a
   Bidayuh community based on their worldviews towards the cosmos and its
   functions that influence in their woodcarving `Rasang'. The existence of
   constitutive, expressive, cognitive symbols and functions have been
   analyzed and interpreted based on a theoretical framework developed by
   Erwin Panofsky `Iconology' Theory (Pre-iconographical Description,
   Iconographical Analysis and Iconographical Interpretation). The value
   and meaning formed are interpreted to understand the stratum that
   consists of perception on the work's pure form and brings to the
   cultural and iconographic knowledge. This also takes into the account
   personal, technical, and cultural history into the understanding of a
   work. It looks at arts not as an isolated incident, but has an intrinsic
   meanings, contents and functions.},
