@article{ WOS:000243834500002,
Author = {Millstein, Rachel A. and Holmes, Andrew},
Title = {Effects of repeated maternal separation on anxiety- and
   depression-related phenotypes in different mouse strains},
Journal = {NEUROSCIENCE AND BIOBEHAVIORAL REVIEWS},
Year = {2007},
Volume = {31},
