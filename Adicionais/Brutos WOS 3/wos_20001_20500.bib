@article{ WOS:A1992JR26000022,
Author = {GOUGH, B and ROBINSON, S and KREMER, J and MITCHELL, R},
Title = {THE SOCIAL-PSYCHOLOGY OF INTERGROUP CONFLICT - AN APPRAISAL OF
   NORTHERN-IRELAND RESEARCH},
Journal = {CANADIAN PSYCHOLOGY-PSYCHOLOGIE CANADIENNE},
Year = {1992},
Volume = {33},
Number = {3},
Pages = {645-651},
Month = {JUL},
Note = {CONF ON THE HISTORY OF SOCIAL PSYCHOLOGY, INST RECH SOC CONTEMPORAINES,
   PARIS, FRANCE, APR 18-20, 1990},
Abstract = {The paper presents an historical overview of social psychological
   research addressing Protestant and Catholic perceptions and identities
   in Northern Ireland. Relative merits and shortcomings of current
   approaches, and particularly Social Identity Theory, are critically
   analysed and the advantages of a multiple perspective analysis are
   highlighted in the light of this discussion. It is proposed that
   progress in understanding social conflict can only be made if and when
   social psychologists look beyond established and unitary theoretical and
   methodological frameworks in order to interpret the complexities of such
   conflict in the real world.},
