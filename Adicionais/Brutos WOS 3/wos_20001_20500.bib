Year = {2005},
Volume = {34},
Number = {8},
Pages = {947-950},
Note = {Meeting in Honour of Janus Kulikowski, Manchester, ENGLAND, SEP, 2003},
Abstract = {The effect of scene complexity on colour constancy was tested with a
   novel technique in which a virtual image of a real 3-D test object was
   projected into a real 3-D scene. Observers made discriminations between
   illuminant and material changes in simple and complex scenes. The extent
   of colour constancy achieved varied little with either scene structure
   or test-object colour, suggesting a dominant role of local cues in
   determining surface-colour judgments.},
