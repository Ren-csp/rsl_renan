@inproceedings{ WOS:001594525800106,
Author = {Laanearu, J.},
Editor = {Ahmad, S and Murray, R},
Title = {Numerical Modeling Study of Stratified Flow and Related Air Exchange in
   Large-Diameter Water Collection Systems},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2023},
Year = {2023},
Pages = {1161-1174},
Note = {2023 World Environmental and Water Resources Congress, Henderson, NV,
   MAY 21-24, 2023},
Abstract = {The study explains the dynamics of air-water stratified flow in the
   branched pipe with different diameters and restricted ventilation. The
   air-circulation process in a reduced-length hydraulic model with
   realistic diameters is investigated for the comparatively low water
   filling case. For this purpose, the Manning formula is used to determine
   the water-flow-rate-dependent normal depth in the mildly sloped circular
   pipes, which are both closely connected to the large-diameter pipe
   collector. The fluids (air and water) can be coupled in the sewer pipe
   not only by pressure but also due to drag, and thus, the stratified flow
   in the water collection system can reveal different type dynamics. The
   non-mixing flow conditions with the more-or-less stable interface
   between the air and water are used to demonstrate numerically the
   airflow patterns through manholes during the water-filling process.
   Sewer airflow analysis is usually needed to perform an odor study, and
   the present work gives some insight to the complexity of airflow
   dynamics in a poorly vented pipe. This study analyzes the
   air-circulation process qualitatively in the large-diameter pipe to
   explain the air inflow and outflow situations, which may be relevant for
   the outdoor air quality analysis in the urban environment. For this
   purpose, the 3D numerical model, representing the two-phase flow of
   immiscible fluids, is used. The numerical model flow regime is chosen to
   be turbulent, and the air and water phases are considered to be
   incompressible, isothermal, and Newtonian fluids. Interface tracking for
   the air-water flow is resolved by applying the volume of fluid method.
   The air exchange that is associated with the branched pipe
   stratified-flow regimes is presented, that is, unsteady and uniform flow
   conditions. The case study demonstrates the ability of the advanced
   numerical modeling tool to predict airwater interfacial drag and
   associated air exchange of the collector that is ventilated through
   three venting towers.},
Publisher = {AMER SOC CIVIL ENGINEERS},
Address = {UNITED ENGINEERING CENTER, 345 E 47TH ST, NEW YORK, NY 10017-2398 USA},
