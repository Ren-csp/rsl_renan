@inproceedings{ WOS:000239989900054,
Author = {Darnhofer, Ika},
Editor = {Langeveld, H and Roling, N},
Title = {Can family farmers be understood as adaptive managers?},
Booktitle = {CHANGING EUROPEAN FARMING SYSTEMS FOR A BETTER FUTURE: NEW VISIONS FOR
   RURAL AREAS},
Year = {2006},
Pages = {232-236},
Note = {7th European IFSA Symposium on New Visions for Rural Areas, Wageningen,
   NETHERLANDS, MAY 07-11, 2006},
Organization = {IFSA},
Abstract = {Although farmers are often seen as the (passive) recipients of research
   results, this may well be a skewed `modernist' perception
   underestimating the farmer's Learning processes based on own
   experimentation. It also seems to disregard the farmer's awareness of
   the world as characterised by rapid and unforeseen change. Family
   farmers may thus focus on maintaining the adaptability of their farms
   through a shifting mix of on- and off-farm enterprises as well as
   constant experimentation and innovation so as to strengthen the adaptive
   flexibility and thus the resilience of their farms.},
