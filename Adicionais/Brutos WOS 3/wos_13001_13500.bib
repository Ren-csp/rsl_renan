@inproceedings{ WOS:001462655900078,
Author = {Mohamednour, Amina and Alyafei, Ameera and AlKatheri, Sumyah and Saad,
   Rafeea and Shafiqurrahman, Asma and Zou, Zhao and Mubin, Omar and
   Mehiar, Duaa and Alnajjar, Fady},
Editor = {Pons, JL and Tornero, J and Akay, M},
Title = {Linguistic and Gender Factors in User Engagement with Arabic LLM-Based
   Virtual Agents for Rehabilitation},
Booktitle = {CONVERGING CLINICAL AND ENGINEERING RESEARCH ON NEUROREHABILITATION V,
   ICNR 2024, VOL 2},
Series = {Biosystems and Biorobotics},
