@inproceedings{ WOS:000176517200005,
Author = {Newmark, GL},
Book-Group-Author = {TRB},
Title = {Emissions inventory analysis of mobile source air pollution in Tel Aviv,
   Israel},
Booktitle = {ENERGY, AIR QUALITY, AND FUELS 2001: ENERGY AND ENVIRONMENT},
Series = {TRANSPORTATION RESEARCH RECORD},
Year = {2001},
