@article{ WOS:A1996UL32900015,
Author = {Botti, C and Comba, P and Forastiere, F and Settimi, L},
Title = {Causal inference in environmental epidemiology: The role of implicit
   values},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1996},
