Editor = {Ono, T and Matsumoto, G and Llinas, RR and Berthoz, A and Norgren, R and Nishijo, H and Ono, T and Matsumoto, G and Llinas, RR and Berthoz, A and Norgren, R and Nishijo, H and Tamura, R},
Title = {Integrative function of the amygdala in emotional memory storage},
Booktitle = {COGNITION AND EMOTION IN THE BRAIN},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2003},
Volume = {1250},
Pages = {335-346},
Note = {International Symposium in Limbic and Association Cortical Systems,
   Toyama, JAPAN, OCT 07-12, 2002},
Abstract = {This report reviews a series of experiments dealing with the role of the
   amygdaloid complex (AC) in the modulation of emotionally based memory
   processes. We investigated in rats whether the amygdala nuclei could be
   involved in the GABA-benzodiazepine (BZD)-induced memory deficits. The
   results indicate that excitotoxic lesions of the amygdala, and in
   particular the basolateral nucleus, block the retention impairment
   produced by systemic injections of diazepam. Microinjections of diazepam
   into the basolateral nucleus, but not the central nucleus, induced
   anterograde amnesia. Moreover, sodium channels reversible inactivation
   of the basolateral amygdaloid complex produced a significant impairment
   in retention of the aversive intensity of a stimulus. These findings
   provide support for the hypothesis that the basolateral amygdala is a
   critical locus for the consolidation of emotionally arousing memories.
   Human-subject studies were performed with epilepsy patients, who had
   been submitted to unilateral lobectomy (TL)-including the removal of at
   least 80\% of the amygdala. Results showed that the emotional enhancing
   effects on long-term recall of an arousing story were only observed in
   the subjects who underwent right TL. These findings indicate a
   laterality phenomenon, where the left amygdala seems to play an
   important role in the modulation of memory for arousing verbal material.
   Interestingly, women in the left TL group, but not in right TL, did not
   present the emotional enhancing effect indicating a gender-related
   lateralization in emotionally influenced memory. Taken together, these
   studies highlight the complexity of the amygdala's role in orchestrating
   the emotional properties of the stimuli, and modulating storage of
   emotionally arousing events. (C) 2003 Published by Elsevier Science B.V.},
