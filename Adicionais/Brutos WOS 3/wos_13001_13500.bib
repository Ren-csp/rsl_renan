   Munafo, Michele and Arino, Olivier},
Editor = {Bonora, L and Catelani, M and DeVincenzi, M and Matteucci, G},
Title = {THE ESA ULYSSES PROJECT AND THE EXPLOITATION IN THE MEDITERRANEAN AREA
   OF SOIL SEALING PRODUCTS AND INDICATORS},
