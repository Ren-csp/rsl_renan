@inproceedings{ WOS:000078875700021,
Author = {Öhman, K and Eriksson, LO},
Editor = {Nabuurs, GJ and Nuutinen, T and Bartelink, H and Korhonen, M},
Title = {Formation of contiguous areas in long-term forest planning},
Booktitle = {FOREST SCENARIO MODELLING FOR ECOSYSTEM MANAGEMENT AT LANDSCAPE LEVEL},
Series = {EUROPEAN FOREST INSTITUTE PROCEEDINGS},
Year = {1998},
Number = {19},
Pages = {291-301},
Note = {International Seminar and Summer School on Forest Scenario Modelling for
   Ecosystem Management at Landscape Level, WAGENINGEN, NETHERLANDS, JUN
   26-JUL 03, 1997},
Organization = {European Forest Inst; Inst Forestry \& Nat Res, Wageningen; Wageningen
   Agr, Dept Forestry; IUFRO},
Abstract = {An important problem in forestry is the fragmentation of the landscape
   with respect to old forest. When a forest is fragmented into isolated
   patches, it provides marginal conditions for forest interior species.
   One way to approach the problem with fragmentation is to plan the
   fellings with consideration to their spatial position. The object of
   this study is to investigate the usefulness of the core area concept in
   long-term planning. Core area thus acts as a criterion promoting the
   formation of contiguous areas of old growth over time in the landscape.
   Core area is determined by patch size, shape and the nature of
   immediately surrounding habitats. The core area measure is evaluated by
   solving a long range-planning problem, which aims at maximum economic
   efficiency under the constraint of a certain amount of core area in the
   landscape over time. Simulated annealing is used as a solution
   technique. Results from applications to a landscape consisting of 200
   stands indicate that aggregates of old forest evolve. The degree to
   which stands are clustered seems to depend on the amount of core area
   demanded and the extent of the edge width. The cost of attaining the
   spatial patterns appears to be low compared with the cost of retaining
   the old forest as such.},
