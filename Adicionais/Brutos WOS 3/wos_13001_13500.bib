@inproceedings{ WOS:000080976900009,
Author = {Krott, M},
Editor = {Gluck, P and Kupka, I and Tikkanen, I},
Title = {Policies for sustainable forestry in Belarus, Russia and Ukraine},
Booktitle = {FOREST POLICY IN THE COUNTRIES WITH ECONOMIES IN TRANSITION - READY FOR
   THE EUROPEAN UNION?},
Series = {European Forest Institute Proceedings},
Year = {1998},
Number = {21},
Pages = {83-94},
Note = {International Conference on Forest Policy in the Countries with
   Economies in Transition - Ready for the European Union, CZECH UNIV AGR,
   PRAGUE, CZECH REPUBLIC, AUG 21-23, 1997},
Organization = {European Forest Inst; Czech Minist Agr; Czech Univ Agr, Fac Forestry;
   Czech Forestry \& Game Management Res Inst},
Abstract = {Sustainability and market economy are formulated officially as goals for
   the transition of forestry in Belarus, Russia and Ukraine. Based on the
   results of a joint research project in these three countries, strategies
   are discussed which focus on the state forest enterprises which are
   still responsible for the whole forest. Strong forestry institutions
   guarantee sustainability of multiple-user forestry better than other
   state institutions which, supporting narrow economic or ecological
   interests only, have strong influence on forestry in transition. With
   the participation of many different institutions it is nearly impossible
   to optimise forestry in the complex process of financing and decision
   making which is now established in these three countries. As an
   alternative, new models for combining financial flows and management in
   closed productions units are formulated. Further strategies are
   formulated for rebuilding the technical infrastructure and for enlarging
   the environmental significance of forestry. The planning system has not
   changed much in forestry yet, despite the experience that there are also
   important tasks enterprise based and state-wide planning could fulfil in
   market economies. Finally, the labour management and the resource basis
   are discussed. In both fields specific solutions for the transition
   period are suggested, e.g. portfolio economy or barter, to meet the
   needs of the people and institutions as long as market economy is not
   fully developed.},
