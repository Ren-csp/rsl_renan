@inproceedings{ WOS:000248260000012,
Author = {Conner, Deondra and Treadway, Darren and James, Matrecia and Stoner,
   Jason and Hochwarter, Wayne},
Editor = {Svyantek, DJ and McChrystal, E},
Title = {Task interdependence as a moderator of politics work outcomes
   relationships},
Booktitle = {REFINING FAMILIAR CONSTRUCTS: ALTERNATIVE VIEWS IN OB, HR, AND I/O},
Series = {Research in Organizational Sciences},
Year = {2007},
Pages = {167-187},
Note = {26th Annual Industrial Organizational and Organizational Behavior
   Conference (IOOB), Florida Inst Technol, Melbourne, FL, FEB 25-27, 2005},
Abstract = {Past research has sought to identify factors that moderate the
   relationship between politics perceptions and work outcomes. The current
   study focused on a previously uninvestigated moderator, task
   interdependence, which is defined as the level of interaction between
   organizational members. We propose that politics perceptions and task
   interdependence would interaction such that those who reported close
   interactions with organizational members would be adversely affected by
   workplace politics. Data gathered from 221 police officer strongly
   supported our proposed relationships. Specifically, those reporting high
   levels of task interdependence experienced lower levels of job and life
   satisfaction, and higher levels of turnover intent when politics were
   high. Conversely, those reporting low levels of task interdependence did
   not report adverse effects of workplace politics perceptions.
   Implications of these findings, strengths and limitations, and avenues
   for future research are provided.},
