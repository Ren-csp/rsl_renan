Note = {8th World STI/AIDS Congress, Punta del Este, URUGUAY, DEC 02-05, 2003},
Abstract = {There is not much data on the psychological state of HIV/AIDS victims in
   India and this paper attempts to address this. This paper examines the
   experiences and emotions of 42 HIV infected people in Chennai, and also
   explores their opinions as to how they are treated with reference to
   sex, income and stage of disease progression. The study reveals that
   many subjects have personally been victims of stigmatization, perceive
   revealing their scro-status as risky and experience higher than average
   levels of negative emotions.},
