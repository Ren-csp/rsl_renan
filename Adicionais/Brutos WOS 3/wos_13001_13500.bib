@article{ WOS:000074737900050,
Author = {Luh, KE},
Title = {Effect of inversion on perceptual biases for chimeric faces},
Journal = {BRAIN AND COGNITION},
Year = {1998},
Volume = {37},
Number = {1},
Pages = {105-108},
Month = {JUN},
Note = {TENNET VIII - Theoretical and Experimental Neuropsychology Conference,
   MONTREAL, CANADA, JUN 16-18, 1997},
Abstract = {Chimeric faces shown in free vision yield reliable left spatial field
   biases that have been attributed to the activation of the right
   hemisphere and a resulting leftward attentional bias. Inversion disrupts
   face encoding, and, in this study with 96 right-handed subjects,
   markedly reduced perceptual biases for emotionally expressive chimeric
   faces. Inversion did not affect biases for gender chimeras which have
   been shown to produce smaller biases with different sources of variance
   than emotion chimeras. Thus, the attentional bias for emotion chimeras
   seems to reflect a right hemisphere global face processing strategy, but
   the bias on gender chimeras does not.},
Publisher = {ACADEMIC PRESS INC},
