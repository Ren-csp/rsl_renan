@inproceedings{ WOS:000184043600014,
Author = {Gerin, W and Davidson, KW and Schwartz, AR and Christenfeld, N},
Editor = {Sivik, T and Byrne, D and Lipsitt, DR and Christodoulou, GN and Dienstfrey, H},
Title = {The role of emotional regulation in the development of hypertension},
