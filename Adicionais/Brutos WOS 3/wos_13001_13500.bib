@article{ WOS:A1997XU90400006,
Author = {Moussiopoulos, N and Sahm, P and Kunz, R and Vogele, T and Schneider, C
   and Kessler, C},
Title = {High-resolution simulations of the wind flow and the ozone formation
   during the Heilbronn ozone experiment},
