@inproceedings{ WOS:000316645200018,
Author = {Anitei, Mihai and Chraif, Mihaela and Papasteri, Claudiu and Neacsu,
   Andrei},
Editor = {Milcu, ME},
Title = {ANALOGICAL IMAGES VERSUS SYMBOLS IN THE MENTAL PROCESSING OF SUBLIMINAL
   MICROEXPRESSIONS},
Booktitle = {MODERN RESEARCH IN PSYCHOLOGY: QUANTITATIVE VS QUALITATIVE RESEARCH?},
Year = {2010},
Pages = {93-95},
Note = {Conference on Modern Research in Psychology: Quantitative vs Qualitative
   Research, Sibiu, ROMANIA, MAY 21-23, 2010},
Abstract = {The research is intended to determine the way in which we process
   microexpressions. Occurring as fast as 1/25 of a second, these nonverbal
   emotional reactions are real subliminal signs. When microexpressions are
   perceived it's important for us to know if we decode them by comparing
   representations (mental images) or we detect the emotion semantically.
   Mental images are analogue codes, while the verbal representations of
   words are symbolic codes. Analogue codes represent the physical stimuli
   we observe in our environment. These codes are a form of knowledge
   representation that retains the main perceptual features of what is
   being observed. Symbolic codes, on the other hand, are a form of
   knowledge representation chosen to represent something arbitrarily, as
   opposed to perceptually (Paivio, 1969, 1971).
   Hypothesis:
   There are significant differences regarding the identification of the
   correct emotion between the group that answered on the picture grid and
   on the word grid.
   The Method: the participants were 60 students of the Faculty of
   psychology and Educational Sciences, Bucharest university, age between
   18 and 24 years (m=20.4, A.S=0.87).
   Instruments: Two authors created software programs
   1. The first has a set of 36 slides presenting microexpressions created
   using subliminal techniques or very fast display of the pictures. This
   first computer program allows the participants to choose from a set of
   pictures the correct emotion suggested by the presented microexpression
   - analogue codes.
   2. The second computer program is very similar to the first one, but the
   participants choose the correct answer from a set of 6 words (the 6
   emotions described by P. Ekman) symbolic codes.
   Results: There are significant differences between the performances of
   the two experimental groups.},
Publisher = {EDITURA UNIVERSITARA},
Address = {BD NICOLAE BALCESCU NO 27-33, BUCHAREST, 00000, ROMANIA},
