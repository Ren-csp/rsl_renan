@inproceedings{ WOS:000229993700016,
Author = {Ogawa, S and Choleris, E and Pfaff, D},
Editor = {Devine, J and Gilligan, J and Miczek, KA and Shaikh, R and Pfaff, D},
Title = {Genetic influences on aggressive Behaviors and arousability in animals},
Booktitle = {YOUTH VIOLENCE: SCIENTIFIC APPROACHES TO PREVENTION},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2004},
Volume = {1036},
Pages = {257-266},
Note = {Conference on Scientific Approaches to Youth Violence Prevention, New
   York, NY, APR 24-26, 2004},
Organization = {New York Acad Sci; Mushett Family Fdn},
Abstract = {In a variety of species, strain differences in aggressive behaviors
   strongly indicate genetic influences. In people, as suggested, for
   example, by the work of Kagan, Rothbart, Cloninger, and their
   collaborators, long-lasting differences in temperament argue for genetic
   as well as environmental effects. After well-controlled experimentation
   in mice, we have learned five lessons about gene/behavior causal
   relations bearing on sociosexual and aggressive behaviors. The effect of
   a given gene on a given behavior depends upon: (1) exactly when and
   where that gene is expressed in the brain; (2) the gender of the animal
   in which it is expressed; (3) the age of the animal; (4) the nature of
   the opponent; and (5) the form of aggression (e.g.,
   testosterone-facilitated aggression vs. maternal aggression). Moreover,
   in female mice, better social recognition is correlated with lower
   levels of aggression. We have gathered evidence for a four-gene micronet
   involving estrogen receptors alpha and beta, oxytocin, and the oxytocin
   receptor as expressed in the hypothalamus and amygdala. Normal
   performance of this micronet is required for social recognition and thus
   for control over aggression. Underlying certain genetic influences on
   sociosexual behaviors and aggression may be alterations in generalized
   brain arousal.},
Publisher = {NEW YORK ACAD SCIENCES},
Address = {2 EAST 63RD ST, NEW YORK, NY 10021 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Pfaff, D (Corresponding Author), Rockefeller Univ, Neurobiol \& Behav Lab, Box 275,1230 York Ave, New York, NY 10021 USA.
   Rockefeller Univ, Neurobiol \& Behav Lab, New York, NY 10021 USA.},
DOI = {10.1196/annals.1330.016},
ISBN = {1-57331-525-7},
Keywords = {estrogen; aggression; genomics; hypothalamus; amygdala; arousal;
   temperament},
Keywords-Plus = {ESTROGEN-RECEPTOR-ALPHA; PROSTAGLANDIN-D SYNTHASE; FEMALE MICE;
   TEMPERAMENT; DISCRIMINATION; DISRUPTION; OXYTOCIN; DISPLAY; AROUSAL;
   ROLES},
Research-Areas = {Behavioral Sciences; Criminology \& Penology; Psychology; Science \&
