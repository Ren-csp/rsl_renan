@article{ WOS:A1992KF67700039,
Author = {ODA, Y and SHIMADA, T and WATANABE, M and NOHMI, T},
Title = {A SENSITIVE SYSTEM (UMU TEST) FOR THE DETECTION OF MUTAGENIC NITROARENES
   IN SALMONELLA-TYPHIMURIUM STRAIN POSSESSING ELEVATED NITROREDUCTASE},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {1992},
Volume = {25},
Number = {11},
Pages = {279-284},
Note = {INTERNATIONAL SYMP ON HAZARD ASSESSMENT AND CONTROL OF ENVIRONMENTAL
   CONTAMINANTS IN WATER, OTSU CITY, JAPAN, NOV 25-28, 1991},
Organization = {INT ASSOC WATER POLLUT RES \& CONTROL},
Abstract = {A sensitive test system for the detection of mutagenic nitroarenes in a
   new tester strain Salmonella  typhimurium NM1011 with a high
   nitroreductase activity has been developed.   The tester strain was
   constructed by subcloning the corresponding gene into pACYC184 plasmid,
   and introducing the plasmid into TA1535 harboring a fusion gene
   umuC'-'lacZ (pSK1002).   The strain enables us to monitor expression of
   the SOS function umuc, by measuring the beta-galactosidase activity in
   the cells.       The sensitivity of the NM1011 was compared with that of
   parent tester strain (TA1535/pSK1002), or a nitroreductase deficient
   strain in seventeen mutagenic/carcinogenic nitroarenes. The newly
   developed strains with a high nitroreductase activity had about 4 times
   higher nitrofurazone-reductase activity than the parent strain, and was
   found to be highly sensitive to the compounds such as 2-nitrofluorene
   (2-NF), 1-nitronaphthalene (1-NN), nitronaphthalene (2-NN),
   1-nitropyrene (1-NP), m-dinitrobenzene (m-DNB), 4,4'-dinitrobiphenyl
   (4,4'-DNB), 3-nitrofluoranthene, 3,7- and 3,9-dinitrofluoranthene,
   5-nitroacenaphthene (5-NA), 1,6-dinitropyrene, and 2,4-dinitrotoluene
   (2,4-DNT).         On the contrary, the enzyme-deficient strain did not
   show considerable responses to 2-NF, m-DNB, 1-NN, 2-NN, 1-NP, 4,4'-DNB,
