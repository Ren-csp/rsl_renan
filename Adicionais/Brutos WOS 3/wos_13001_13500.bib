Title = {Conservation strategy of Cuing (Cyclea barbata Miers) in
   Mount Ciremai National Park as forest fuctional food based on bioecology
   and utilization rate},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON ENVIRONMENT AND FOREST CONSERVATION
   (ICEFC2019): ECOSYSTEM RESEARCH AND INNOVATION TO ACHIEVE SUSTAINABLE
   DEVELOPMENT GOALS},
