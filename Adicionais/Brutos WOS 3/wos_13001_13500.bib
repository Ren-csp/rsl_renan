Note = {International Conference on Strategic Management (ICSM 2011), Phuket,
   THAILAND, DEC 21-23, 2011},
Abstract = {The essential attribute of rural tourism is the property of
   cross-urban-and-rural culture. The Urbanism represents the
   characteristics of urban culture and is the fundament of motivation and
   behaviors of rural tourists to travel villages; the Rurality represents
   the characteristics of rural culture and is the core attractiveness and
   unique selling point of rural tourism. The cultural contrast between
   Urbanism and Rurality is the driving force promotes tourists to
   participate in rural tourism.},
