@article{ WOS:000496664800026,
Author = {Funari, V. and Gomes, H. I. and Cappelletti, M. and Fedi, S. and
   Dinelli, E. and Rogerson, M. and Mayes, W. M. and Rovere, M.},
Title = {Optimization Routes for the Bioleaching of MSWI Fly and Bottom Ashes
   Using Microorganisms Collected from a Natural System},
Journal = {WASTE AND BIOMASS VALORIZATION},
Year = {2019},
Volume = {10},
Number = {12, SI},
Pages = {3833-3842},
Month = {DEC},
Note = {6th International Conference on Sustainable Solid Waste Management
   (NAXOS), Naxos, GREECE, JUN 13-16, 2018},
Organization = {LIFE},
Abstract = {This paper presents a route for the treatment of MSWI fly (FA) and
   bottom ashes (BA) using microorganisms to critically assess whether
   bioleaching is within reach of effective industrial application. The
   leaching of metals from BA and FA was investigated in a controlled
   laboratory environment using a culture isolated from a natural system
   where the dominant strains are acidophilic bacteria, mainly
   Acidothiobacillus thiooxidans and Acidothiobacillus ferrooxidans. The
   community of microorganisms (mostly acidophilic, S- and Fe-oxidizing
   bacteria) was collected directly from overflows and ponds at the
   sediment-water interface of a natural system near a post-mining site.
   Pre-cultivation was done in 250 mL flasks followed by the adaptation to
   the different substrates (both FA and BA). The effect of different
   material pre-treatment and elemental sulphur concentrations were
   evaluated for both BA and FA, at a starting pH of 4. The bioleaching of
   BA and FA substrates experienced good yields of metal extraction with an
   optimum duration of two weeks. The results showed that more than 90\%
   Zn, Cu, and 10\% Pb are removed from FA; while 100\% Cu, 80\% Zn and
   20\% Pb are removed from BA samples. Batch experiments with regenerating
   ion-exchange resins did not perform well for metal recovery, but could
   serve as a valuable decontamination step. The techniques used here with
   FA and BA can be used for urban mining purposes (e.g. ashes and other
   meal-rich anthropogenic wastes), but also low-grade ores in the mining
   industry, contributing to resource recovery or decontamination agendas.},
