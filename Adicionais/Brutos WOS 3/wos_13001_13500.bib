@inproceedings{ WOS:000980192000019,
Author = {Poirier, Sara-Maude and Giroux, Felix and Leger, Pierre-Majorique and
   Bouvier, Frederique and Brieugne, David and Chen, Shang-Lin and Senecal,
   Sylvain},
Editor = {Davis, FD and Riedl, R and VomBrocke, J and Leger, PM and Randolph, AB and Muller-Putz, GR},
Title = {Collecting Longitudinal Psychophysiological Data in Remote Settings: A
   Feasibility Study},
Booktitle = {INFORMATION SYSTEMS AND NEUROSCIENCE, NEUROIS RETREAT 2022},
Series = {Lecture Notes in Information Systems and Organization},
Year = {2022},
Volume = {58},
Pages = {179-186},
Note = {14th Annual NeuroIS Retreat Conference, Vienna, AUSTRIA, JUN 14-16, 2022},
Organization = {Raiffeisen Software; GRZ; Brain Prod; Noldus Informat Technol},
Abstract = {Research methods to better understand the habituation process of
   individuals' repeated task performance are constantly improving.
   However, data collection methods from a longitudinal perspective have
   been overlooked. Thus, the aim of this study is to explore the
   feasibility of collecting psychophysiological data remotely over several
   days. Through a five-days longitudinal study, behavioral data, facial
   emotions, and electrodermal activity were collected remotely. Behavioral
   results revealed that consumers tend to improve their performance in
   executing the tasks over time, regardless of their difficulty levels.
   Psychophysiological data showed that negative emotions were experienced
   by participants on Day 3 and tend to decrease on Day 5. Thus, it is
   possible that the novelty of the first remote session on Day 1 prevented
   participants from expressing negatives emotions even if they found the
   tasks difficult. This study highlights potential limitations of
   cross-sectional studies investigating the habituation process and
   validates the feasibility of conducting longitudinal psychophysiological
   data collection remotely in a naturalistic setting.},
