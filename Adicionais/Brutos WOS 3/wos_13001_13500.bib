Title = {EDUCATION AND TRAINING IN THE FIELD OF SUSTAINABLE BUILDING DESIGN},
Booktitle = {CESB 10: CENTRAL EUROPE TOWARDS SUSTAINABLE BUILDING - FROM THEORY TO
   PRACTICE},
