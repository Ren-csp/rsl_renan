Title = {Communication-Based Prevention Strategies: A Draft Model Proposal},
Booktitle = {EARTHQUAKE RISK PERCEPTION, COMMUNICATION AND MITIGATION STRATEGIES
   ACROSS EUROPE},
Series = {Geographies of the Anthropocene},
