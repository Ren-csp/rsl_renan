@article{ WOS:000263977000005,
Author = {Karamchandani, Prakash and Lohman, Kristen and Seigneur, Christian},
Title = {Using a sub-grid scale modeling approach to simulate the transport and
   fate of toxic air pollutants},
Journal = {ENVIRONMENTAL FLUID MECHANICS},
