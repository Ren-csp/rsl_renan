@article{ WOS:000250821300007,
Author = {Styns, Frederik and van Noorden, Leon and Moelants, Dirk and Leman, Marc},
Title = {Walking on music},
Journal = {HUMAN MOVEMENT SCIENCE},
Year = {2007},
Volume = {26},
Number = {5},
Pages = {769-785},
Month = {OCT},
Note = {10th International Workshop on Rhythm Perception and Production, Bilzen,
   BELGIUM, JUL 02-06, 2005},
Abstract = {The present study focuses on the intricate relationship between human
   body movement and music, in particular on how music may influence the
   way humans walk. In an experiment, participants were asked to
   synchronize their walking tempo with the tempo of musical and metronome
   stimuli. The walking tempo and walking speed were measured. The tempi of
   the stimuli varied between 50 and 190 beats per minute. The data
   revealed that people walk faster on music than on metronome stimuli and
   that walking on music can be modeled as a resonance phenomenon that is
   related to the perceptual resonance phenomenon as described by Van
   Noorden and Moelants (Van Noorden, L., \& Moelants, D. (1999). Resonance
   in the perception of musical pulse. Journal of New Music Research, 28,
   43-66). (c) 2007 Elsevier B.V. All rights reserved.},
