   Boston Univ, Dept Cognit \& Neural Syst, Boston, MA 02215 USA.},
DOI = {10.3758/BF03212059},
ISSN = {0031-5117},
Keywords-Plus = {SUPERIOR COLLICULAR MAP; SOUND LOCALIZATION; BARN OWLS; INTENSITY
   PERCEPTION; GUINEA-PIG; ABSOLUTE IDENTIFICATION; CORTICAL-NEURONS; EARLY
