@article{ WOS:000087025500005,
Author = {Verbeke, W and Viaene, J},
Title = {Ethical challenges for livestock production: Meeting consumer concerns
   about meat safety and animal welfare},
Journal = {JOURNAL OF AGRICULTURAL \& ENVIRONMENTAL ETHICS},
Year = {2000},
Volume = {12},
Number = {2},
