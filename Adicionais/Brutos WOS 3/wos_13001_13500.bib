@article{ WOS:000256872800003,
Author = {Kocifaj, M. and Horvath, H. and Gangl, M.},
Title = {Retrieval of aerosol aspect ratio from optical measurements in Vienna},
Journal = {ATMOSPHERIC ENVIRONMENT},
Year = {2008},
Volume = {42},
Number = {11},
Pages = {2582-2592},
Month = {APR},
Note = {Conference on Visibility, Aerosols, and Atmospheric Optics, Vienna,
   AUSTRIA, SEP 03-06, 2006},
Abstract = {The phase function and extinction coefficient measured simultaneously
   are interpreted in terms of surface distribution function and mean
   effective aspect ratio of aerosol particles. All optical data were
   collected in the atmosphere of Vienna during field campaign in June
   2005. It is shown that behavior of aspect ratio of Viennese aerosols has
   relation to relative humidity in such a way, that nearly spherical
   particles (with aspect ratio epsilon approximate to 1) might became
   aspherical with epsilon approximate to 1.3-1.6 under low relative
   humidity conditions. Typically, > 80\% of all Viennese aerosols have the
   aspect ratio < 1.4, so the morphology of these particles behaves like
   perturbed spheres. The epsilon, exceptionally, can reach the value about
   2, but these situations occur with probability < 2\%. Most typically,
   the aspect ratio peaks at epsilon approximate to 1.2 in the atmosphere
   of Vienna. (C) 2007 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
