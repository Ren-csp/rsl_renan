@inproceedings{ WOS:000449056500036,
Author = {Girba, Alexandra Emilia},
Editor = {Boldea, I},
Title = {IMPLICATION OF SIMULATION IN CHANGE BLINDNESS},
Booktitle = {DISCOURSE AS A FORM OF MULTICULTURALISM IN LITERATURE AND COMMUNICATION
   - PSYCHOLOGY AND EDUCATIONAL SCIENCES},
Year = {2015},
