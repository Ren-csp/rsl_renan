@inproceedings{ WOS:000258167800045,
Author = {Daugaviete, Mudrite and Miezite, Olga and Lazdina, Dagnija and Liepins,
   Kaspars and Lazdins, Andis},
Book-Group-Author = {LUA},
Title = {Biofuel from naturally reforested arable lands - resources, technologies
   and costs},
Booktitle = {RURAL DEVELOPMENT 2007, VOL 3, BOOK 2, PROCEEDINGS},
Series = {Rural Development},
Year = {2007},
Pages = {271-276},
Note = {3rd International Scientific Conference on Rural Development, Kaunas
   City, LITHUANIA, NOV 08-10, 2007},
Organization = {Lithuanian Univ Agr},
Abstract = {About 300 th ha of arable lands in Latvia has overgrew with trees during
   last 20 years. These forest areas have varying density, field size and
   shape, but most of them represents high growing stock and needs to be
   thinned. The most common specie is such areas is birch, than aspen and
   grey alder.
   Proper management of naturally reforested areas let to obtain
   significant amount of biofuel in early stage as well as in final
   felling, inefficient management usually leads to significant looses.
   This presentation represents results first stage of research about
   inventory management of naturally reforested areas implemented in 2007
   in Latvia, including productivity study of manual thinning of naturally
   grown dense birch stands.
   Effective time consumption per 1 ha with piling of small trees is 70-90
   hours and without piling - 45 hours. Effectiveness of harvesting without
   piling is higher than in other cases (80\%), because of additional time
   consumption during piling.
   Harvesting time consumption per tree is less in case of piling small
   trees, but total time per tree in case of piling is twice bigger than in
   variant without piling, also because of significant time consumption for
   piling. Productivity in different conditions needs to be evaluated in
   future.},
