Pages = {82+},
Note = {International Conference on Urbanization and Land Reservation Research,
   Tianjin, PEOPLES R CHINA, SEP, 2009},
Organization = {Tianjin Univ Commerce; Tianjin Assoc Social Sci Circle},
Abstract = {The development of capital metropolitan economic circle plays very
   important strategic role in national economy. The paper explores the
   characteristics of strategic plan system, construction and development
   of world major capital metropolitan areas from the viewpoint of
   geographic location partition; urban programming, industrial layout and
   ecological environment construction. The common. features are: different
   focusing in different planning stages, integrating the whole developing
   strategy of economic society and insisting on sustainable development in
   industrial layout and city construction. Based on the inspiration of the
   experience of world metropolitan areas, the paper puts forward some
   suggestions on China's capital metropolitan areas planning and
   development.},
