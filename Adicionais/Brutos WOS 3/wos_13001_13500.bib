Title = {The Role of Emotional Intelligence in Online Learning},
Booktitle = {24TH INTERNATIONAL SYMPOSIUM OF RESEARCH AND APPLICATIONS IN PSYCHOLOGY,
   SICAP: COGNITIVE CHARACTERISTICS OF TRANSDISCIPLINARITY. APPLICATIONS IN
   PSYCHOLOGY AND PSYCHOTHERAPIES},
Year = {2017},
Pages = {287-293},
Note = {24th International Symposium on Research and Applications in Psychology
   (SICAP) - Cognitive Characteristics of Transdisciplinarity. Applications
   in Psychology and Psychotherapies, Timisoara, ROMANIA, MAR 24-26, 2017},
Abstract = {Emotional intelligence (EI) refers to an awareness and understanding of
   emotions, to the efficient management of emotions and understanding of
   others. EI has become an important research element in the traditional
   learning environment, yet its implication in new learning environments
   is also needed. Thus, a correlation between different studies is
   realized in order to establish if emotional intelligence has effects in
   the online learning environment, more precisely, in the students'
   academic outcome. The result of this studies analysis refers to a
   reconsidering of the development of emotional intelligence, as its
   characteristics are important in the obtaining of an academic success.},
