   Simita and Islam, Sk. Mijanul and Chatterjee, Debashis},
Editor = {Ng, JC and Noller, BN and Naidu, R and Bundschuh, J and Bhattacharya, P},
Title = {Removal of arsenic from drinking water using non-hazardous natural
   citrate sources},
