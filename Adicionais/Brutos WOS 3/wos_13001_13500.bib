@inproceedings{ WOS:000446447200229,
Author = {Xiao, Jianyong and Bai, Xiaoyong and Zhou, Dequan and Qian, Qinghuan and
   Zeng, Cheng and Chen, Fei},
Book-Group-Author = {IOP},
Title = {Spatial-temporal Evolution of Vegetation Coverage and Analysis of it's
   Future Trends in Wujiang River Basin},
Booktitle = {2017 3RD INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCE AND MATERIAL
   APPLICATION (ESMA2017), VOLS 1-4},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
