@inproceedings{ WOS:001071432900209,
Author = {Kokkinakis, Dimitrios and Bruinsma, Bastiaan and Hammarlin, Mia-Marie},
Editor = {Hagglund, M and Pelayo, S and Moen, A and Blusi, M and Bonacina, S and Nilsson, L and Madsen, IC and Benis, A and Lindskold, L and Gallos, P},
Title = {The Prevalence of mRNA Related Discussions During the Post-COVID-19 Era},
Booktitle = {CARING IS SHARING-EXPLOITING THE VALUE IN DATA FOR HEALTH AND
   INNOVATION-PROCEEDINGS OF MIE 2023},
