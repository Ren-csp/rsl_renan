@article{ WOS:000279270000035,
Author = {Rabaia, Yoke and Giacaman, Rita and Nguyen-Gillham, Viet},
Title = {Violence and Adolescent Mental Health in the Occupied Palestinian
   Territory: A Contextual Approach},
