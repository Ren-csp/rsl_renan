@article{ WOS:000189102200007,
Author = {Platt, RV},
Title = {Global and local analysis of fragmentation in a mountain region of
   Colorado},
Journal = {AGRICULTURE ECOSYSTEMS \& ENVIRONMENT},
Year = {2004},
Volume = {101},
Number = {2-3},
Pages = {207-218},
