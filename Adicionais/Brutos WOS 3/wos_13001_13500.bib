@article{ WOS:000239646600003,
Author = {Clarke, M. L. and Rendell, H. M.},
Title = {Hindcasting extreme events: The occurrence and expression of damaging
   floods and landslides in southern Italy},
Journal = {LAND DEGRADATION \& DEVELOPMENT},
