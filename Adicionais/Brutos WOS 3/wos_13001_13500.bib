@inproceedings{ WOS:000468021200004,
Author = {Adam, Marius and Muntean, Daniel M. and Popov, Miodrag and Grecea,
   Daniel and Ungureanu, Viorel},
Editor = {Balan, MC and Bode, F and Croitoru, C and Dogeanu, A and Georgescu, A and Georgescu, C and Nastase, I and Sandu, M},
Title = {Integrated energy efficient cooling solutions for large prefabricated
   panels collective dwellings from the 1970s},
Booktitle = {SUSTAINABLE SOLUTIONS FOR ENERGY AND ENVIRONMENT (EENVIRO 2018)},
Series = {E3S Web of Conferences},
