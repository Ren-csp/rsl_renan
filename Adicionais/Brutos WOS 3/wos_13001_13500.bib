@inproceedings{ WOS:000400299900027,
Author = {Sloan, Ken},
Editor = {Erickson, GS and Rothberg, HN},
Title = {Valuing a Firm's Human Resources in Organizational Interactions},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON INTELLECTUAL CAPITAL
   KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2016)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2016},
Pages = {225-232},
Note = {13th International Conference on Intellectual Capital Knowledge
   Management and Organisational Learning (ICICKM), Ithaca Coll, Ithaca,
   NY, OCT 14-15, 2016},
Organization = {Marist Coll},
Abstract = {The human resources of an organization, its people or talent, represent
   the only dynamic asset of the organization (Christensen). That talent,
   represented by employees and others in the organization's network,
   represent the most valuable asset of the firm. But while most have solid
   information on the cost of their human resources, few have useful,
   actionable information on what the value of that asset might be. Most do
   not know what the return on investments they make to increase the value
   of that asset is. Cascio and Boudreau note that ``often companies
   address vital decisions about talent and how it is organized with
   limited measures or faulty logic{''} (Cascio and Boudreau, 2011). This
   can be addressed through the development and use of decision frameworks
   that ``provides the logical connections between decisions about a
   resource{''}, in this case a firm's talent, ``and the strategic success
   of the organization{''}. While such decision frameworks applicable to
   human resources have been developed and organizations are beginning to
   put them to use, little attention is being paid to the unique nature of
   a firm's human resources, namely its value in interaction with others.
   In interaction with others, that value can be reduced when it is marked
   by habitual ways of thinking embedded in existing structures, or it can
   be multiplied when the interaction reflects talent engaged in a social
   field which evolves to address the challenges faced (Scharmer, 2009).
   The nature of these interaction dynamics, when considered at all, are
   typically referred to as intangible with little attention paid to
   measuring and managing them. This paper provides an overview of the
   state of decision frameworks used in assessing a firm's human resources
   and offers a conceptual framework to move those beyond a focus on
   individuals towards a view of valuing talent in interactions with
   others.},
Publisher = {ACAD  CONFERENCES LTD},
Address = {CURTIS FARM, KIDMORE END, NR READING, RG4 9AY, ENGLAND},
