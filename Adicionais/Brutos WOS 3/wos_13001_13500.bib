@inproceedings{ WOS:000380411200047,
Author = {Wu, Tyan Yu and Lin, Chi-Tang},
Editor = {Shih, YC and Liang, SFM},
Title = {Synchronizing the arm-speed of toothbrushing with sounds of differing
   tempos},
Booktitle = {BRIDGING RESEARCH AND GOOD PRACTICES TOWARDS PATIENT WELFARE: HEALTHCARE
   SYSTEMS ERGONOMICS AND PATIENT SAFETY 2014},
Year = {2015},
Pages = {393-398},
Note = {PROCEEDINGS OF THE 4TH INTERNATIONAL CONFERENCE ON HEALTHCARE SYSTEMS
   ERGONOMICS AND PATIENT SAFETY, TAIPEI, TAIWAN, JUN 23-26, 2014},
Abstract = {Toothbrushing, which involves a repetitive back-and-forth arm movement,
   can be boring. However, a toothbrush integrated with a sound of an
   appropriate tempo may effectively influence users' emotions and arm
   movements during the act of brushing. Sounds with differing tempos can
   cause users to synchronize their arm movements differently, which can
   further affect their comfort and pleasure. This study attempted to
   determine an optimal tempo for toothbrushing. The results showed that
   tempos ranging between 110 bpm and 220 bpm are optimal for
   toothbrushing. In addition, the participants in the study agreed that an
   appropriate tempo does enhance comfort, coordination, and pleasure
   during the act of toothbrushing.},
