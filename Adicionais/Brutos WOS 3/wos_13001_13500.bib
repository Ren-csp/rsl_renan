@article{ WOS:000071828100006,
Author = {Cloninger, CR},
Title = {Special feature: Etiology of personality disorders: A commentary on Dr.
   Parker's tripartite model},
Journal = {JOURNAL OF PERSONALITY DISORDERS},
Year = {1997},
Volume = {11},
