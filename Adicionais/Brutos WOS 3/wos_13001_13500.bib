@article{ WOS:000227897700011,
Author = {Valli, K and Revonsuo, A and Pälkäs, O and Ismail, KH and Ali, KJ and
   Punamäki, RL},
Title = {The threat simulation theory of the evolutionary function of dreaming::
   Evidence from dreams of traumatized children},
Journal = {CONSCIOUSNESS AND COGNITION},
Year = {2005},
Volume = {14},
