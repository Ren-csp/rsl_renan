@article{ WOS:000238215400019,
Author = {Chapman, Benjamin P. and Hayslip, Jr., Bert},
Title = {Emotional intelligence in young and middle adulthood: Cross-sectional
   analysis of latent structure and means},
Journal = {PSYCHOLOGY AND AGING},
Year = {2006},
Volume = {21},
Number = {2},
Pages = {411-418},
Month = {JUN},
Note = {113th Annual Convention of the American-Psychological-Association,
   Washington, DC, AUG 18-21, 2005},
Organization = {Amer Psychol Assoc},
Abstract = {Differentiation of the construct of emotional intelligence was
   investigated in young and middle-aged adults, on the basis of hypotheses
   generated from differential emotions theory, discrete emotions
   functionalist theory, and empirical literature on age-related changes in
   affective complexity and differentiation of abilities. Both age groups
   were characterized by the same set of comparably related dimensions.
   However, midlife adults reported significantly greater use of optimism
   as a mood-regulation strategy than was reported by young adults. This
   study considers implications of possible structural continuity in
   emotional intelligence in conjunction with mean increases in the use of
   optimism as a strategy for managing affect.},
