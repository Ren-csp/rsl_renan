Title = {Building up the future: participative design of a rural development plan
   for the coastal communities of the arid regions of Baja California,
   Mexico},
Booktitle = {COASTAL ENVIRONMENT V: INCORPORATING OIL SPILL STUDIES},
Series = {ENVIRONMENTAL STUDIES SERIES},
Year = {2004},
