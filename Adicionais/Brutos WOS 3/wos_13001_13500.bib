Title = {Natural Ecotourism Objects in Rokan Hulu Regency, Riau Province,
   Indonesia.},
Booktitle = {UNIVERSITAS RIAU INTERNATIONAL CONFERENCE ON SCIENCE AND ENVIRONMENT
   2020 (URICSE-2020)},
