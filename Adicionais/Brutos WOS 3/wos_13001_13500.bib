@inproceedings{ WOS:A1997BH19Q00019,
Author = {Ippoliti, M and Poli, U and Casolaro, F and Colangiuli, L and Gianicolo,
   A and Meazza, D},
Editor = {Spiteri, A},
Title = {Monitoring of environmental changes and water quality in the coastal WWF
   oasis of Torre Guaceto (Italy) from Landsat TM and GIS data},
Booktitle = {REMOTE SENSING `96: INTEGRATED APPLICATIONS FOR RISK ASSESSMENT AND
   DISASTER PREVENTION FOR THE MEDITERRANEAN},
Year = {1997},
Pages = {141+},
Note = {16th EARSel Symposium on Integrated Applications for Risk Assessment and
   Disaster Prevention for the Mediterranean, MALTA, MAY 20-23, 1996},
Organization = {European Assoc Remote Sensing Labs},
Abstract = {The aim of this work is to present the results of the application of
   Remote Sensing techniques and GIS to the monitoring and surveillance of
   protected coastal humid zone. The area under examination is the WWF
   natural oasis of Torre Guaceto, located in the southern part of Italy,
   where the environment is endangered by an urban center and extended
   industrial installations, including power plants, placed at a distance
   of about 15 Km. The monitoring program includes the vegetation stress
   (typical Mediterranean water and vegetation cover) as well as the water
   duality parameters. Mono and multitemporal Landsat TM image processing
   techniques fitted into a geographic information system were utilized to
   produce thematic maps and statistical set of data. A methodological
   procedure was applied to collect information on vegetation modifications
   (supervised classification using Maximum Likelihood) and on water
   duality conditions (chlorophyll, transparency). Monitoring the
   environmental changes and water duality is an essential task to realize
   an integrated multipurpose program for managing protected humid coastal
   zones.},
