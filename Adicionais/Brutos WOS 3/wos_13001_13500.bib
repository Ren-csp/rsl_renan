@inproceedings{ WOS:000335751400006,
Author = {Guiducci, V and Velotti, P. and Cavanna, D.},
Editor = {Barone, L},
Title = {Affect regulation and attachment models in Eating Disorders},
Booktitle = {6TH INTERNATIONAL ATTACHMENT CONFERENCE},
Year = {2013},
Pages = {35-39},
Note = {6th International Attachment Conference (IAC), Pavia, ITALY, AUG 30-SEP
   01, 2013},
Organization = {Univ Pavia},
Abstract = {Recent developments in Attachment Theory, Infant Research, Neurobiology
   and Psychoanalysis have contributed to the conceptualization of affect
   regulation. This construct refers to the acts that modulate emotions
   experienced and expressed (Gross, 2007) {[}1]. Attachment perspective
   has focused on the dynamics through affective regulation plays a crucial
   role in explaining the transition from dyadic co-regulation to
   self-regulation. Attachment working models have also been interpreted by
   some authors such as affective regulation/dysregulation patterns (Schore
   \& Schore, 2008) {[}2], whose disruption is associated with a broad
   spectrum of psychiatric disorders, including eating disorders (Dozier,
   Stovall - McClough, \& Albus, 2008) {[}3]. Eating disorders are
   characterized by a complex pathogenesis and Taylor et al. (1997) {[}4]
   have proposed a theory that conceptualizes these psychopathologies as
   disorders of affect regulation. The purpose of this research work was to
   investigate attachment models, alexithymia and the difficulties in the
   emotional regulation in a sample of 50 outpatients with anorexia and
   bulimia and in a control group, in a perspective of Developmental
   Psychopathology. The following instruments were administrated: Adult
   Attachment Interview (AAI, George et al., 1985) {[}5], Toronto
   Alexithymia Scale (TAS-20, Bagby et al., 1994) {[}6], and Difficulties
   in emotion Regulation Scale (DERS, Gratz \& Roemer, 2004) {[}7]. The
   results show a over-representation of dismissing and disorganized
   attachment in the clinical sample. ED subjects show a significantly
   higher level of alexithymia and emotional dysregulation than the control
   group. No significant differences between anorexia and bulimia nervosa
   pointed out from the analysis. The comorbidity with personality
   disorders, particularly borderline personality disorder, affects
   attachment patterns in the direction of greater insecurity and
   disorganization. Differences in AAI coding system scales are also
   analyzed and discussed.},
