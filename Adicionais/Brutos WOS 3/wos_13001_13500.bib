Title = {The Correlation between Industrial Organization and Sustainable Growth
   of City Cluster Spatial: A Case Study of Harbin-Changchun City Cluster},
Booktitle = {TECHNOLOGIES AND MATERIALS FOR RENEWABLE ENERGY, ENVIRONMENT AND
   SUSTAINABILITY (TMREES)},
Series = {Energy Procedia},
