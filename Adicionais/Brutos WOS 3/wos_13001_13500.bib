@inproceedings{ WOS:000180592200006,
Author = {Tyndale-Biscoe, H},
Editor = {Saunders, D and Spratt, D and VanWensveen, M},
Title = {Greater Gliders and the forests of southeastern Australia},
Booktitle = {PERSPECTIVES ON WILDLIFE RESEARCH: CELEBRATING 50 YEARS OF CSIRO
   WILDLIFE AND ECOLOGY},
Year = {2002},
Pages = {36-45},
Note = {Seminar on Perspectives on Wildlife Research, AUSTRALIA, 1999},
Organization = {Commonwealth Sci \& Ind Res Org},
Abstract = {The wet sclerophyll forests of southeastern Australia are home to about
   25 species of marsupial, of which eight arboreal species are totally
   forest-dependent. During the past 35 years there has been controversy
   over the competing needs of the timber industry and wildlife
   conservation in these forests. This chapter features the Greater Glider
   Petauroides volans which epitomizes the dependent species in these
   forests, and describes three complementary studies over 35 years. In the
   1960s, staff and students at the Australian National University studied
   the fate of gliders during clear-felling for the development of pine
   plantations at Bondo, near Tumut in New South Wales. In 1977 the CSIRO
   Division of Wildlife Research was commissioned to investigate the effect
   of forest clearance on wildlife in the Eden woodchip concession. This
   work demonstrated that the forests favoured by arboreal marsupials occur
   on the most productive soils, those sought-after initially for
   agriculture and later for forestry Since 1992 the survival of gliders in
   isolated patches of original forest at Bondo has been studied. This work
   is now being extended into a genetic analysis of isolated populations
   and comparisons with the gene frequencies of the original population
   sampled in the 1960s, in an investigation of the way small populations
   are able to survive in the wild.},
