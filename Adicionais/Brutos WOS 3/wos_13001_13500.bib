@inproceedings{ WOS:000448044100012,
Author = {Li, Xiaoning and Fang, Xing and Li, Junqi and Wang, Jianlong and Tu,
   Nannan and Yang, Qingzhu and Li, Pengshu and Gong, Yongwei},
Editor = {Hathaway, J},
Title = {Experimental and Model Study of Road-Bioretention System},
Booktitle = {INTERNATIONAL LOW IMPACT DEVELOPMENT CONFERENCE 2018: GETTING IN TUNE
   WITH GREEN INFRASTRUCTURE},
Year = {2018},
Pages = {101-109},
Note = {International Low Impact Development Conference, Nashville, TN, AUG
   12-15, 2018},
Organization = {Amer Soc Civil Engineers, Environm \& Water Resources Inst},
Abstract = {The urban stormwater management philosophy named sponge city (SPC) was
   put forward in 2014 as a comprehensive stormwater management strategy in
   China. The SPC development involves the source control measurements
   similarly to low impact development or green infrastructure (LID or GI)
   practices; the urban pipe/channel drainage system dealing with the
   normal frequency storm events; and the major drainage system handling
   the potential flood inundation due to extreme rainfall events. The
   road-bioretention system is widely used as a source control measurement
   in urban stormwater management. A large-scale laboratory
   road-bioretention system (road part is 18 mx4 m, bioretention part is 10
   mx1 m) was constructed with rainfall simulator system. The road and
   bioretention are connected via the road curb inlet that allows the
   runoff generated on the road surface flows into the bioretention. The
   experiments were conducted with the road surfaces of various longitude
   and cross slopes and the curb inlet of different lengths under various
   rainfall intensities. The runoff into the underground pipe drainage
   through a grate inlet and the bioretention through curb inlet, and the
   discharge flowing further downstream along the road surface were
   monitored during the rainfall events. A road-bioretention simulation
   model was developed using the 2D overland flow modeling program
   (FullSWOE-SX) and calibrated with the experimental data. The model can
   be used to simulate the complex rainfall-runoff process on pervious and
   impervious surfaces, i.e., dynamic flow and infiltration process of the
   road-bioretention cell. The experimental data and simulation results
   were analyzed and discussed aims to provide/develop guides for the
   design of road-bioretention systems.},
