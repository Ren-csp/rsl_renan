   Vlckova, Veronika and Pechanec, Vilem},
Editor = {Fialova, J},
Title = {RECREATIONAL IMPORTANCE OF VERY LARGE TREES IN URBAN ENVIRONMENT},
Booktitle = {PUBLIC RECREATION AND LANDSCAPE PROTECTION - WITH SENSE HAND IN HAND...},
