Title = {Flows, drivers, services and functions and urban typologies: an
   integrated approach for the analysis of urban eco-systems},
Booktitle = {SUSTAINABLE CITY V: URBAN REGENERATION AND SUSTAINABILITY},
Series = {WIT Transactions on Ecology and the Environment},
