@inproceedings{ WOS:000380508700008,
Author = {Ekawati, Sri Aliah},
Editor = {VanEgmond, E and Thompson, K},
Title = {Children - friendly streets as urban playgrounds},
Booktitle = {GREEN ARCHITECTURE FOR SUSTAINABLE LIVING AND ENVIRONMENT},
Series = {Procedia Social and Behavioral Sciences},
Year = {2015},
Volume = {179},
Pages = {94-108},
Note = {Green Architecture for Sustainable Living and Environment, Bali,
   INDONESIA, NOV 29-29, 2014},
Organization = {Inst Technol Sepuluh Nopember ITS Surabaya, Fac Civil Engn \& Planning,
   Dept Architecture},
Abstract = {The rapid development of cities has changed the land use in the city.
   The more buildings mean the less open spaces used by children as
   playground. One of the open space types degraded is street. Currently,
   streets are being managed for vehicles instead of pedestrian and
   bicycles. Whereas, streets have potential issues as place, not just
   space, for children to learn and play. Street corridors are shaped by
   some elements, physical and non-physical. All of those elements
   stimulate children's creativity, imagination, knowledge, and even their
   behaviour. This study's objective is to examine how street elements
   contribute to children-friendly streets. The study conducted in
   KelurahanTamarunang, KecamatanMariso, Makassar, Indonesia. That place is
   one of dense housing area in Makassar. To collect the data, researcher
   observed the location and did documentation. In addition, researcher did
   interview to children to identify their activities on the street. Data
   analyzing used were descriptive and correlation analyze. In the end of
   study, researcher found that there was correlation between children
   activities on the streets and street physical aspects. The affecting
   aspects of the children activities on the streets, from the highest to
   the lowest score, were: traffic calming, size and lay out, green space,
   play space, accessibility, and quality of equipment and materials. (C)
   2015 The Authors. Published by Elsevier Ltd.},
