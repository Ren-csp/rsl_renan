@inproceedings{ WOS:000221379400005,
Author = {Kostopoulou, S and Kyritsis, I},
Editor = {Beriatoss, E and Brebbia, CA and Coccossis, H and Kungolos, A},
Title = {Local people's perceptions of sustainable tourism development in
   protected mountain areas: the case of Mount Olympus, Greece},
