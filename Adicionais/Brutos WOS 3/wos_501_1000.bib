Author = {Gonzalez, Jorge E. and Ramamurthy, Prathap and Bornstein, Robert D. and
   Chen, Fei and Bou-Zeid, Elie R. and Ghandehari, Masoud and Luvall,
   Jeffrey and Mitra, Chandana and Niyogi, Dev},
Title = {Urban climate and resiliency: A synthesis report of state of the art and
   future research directions},
