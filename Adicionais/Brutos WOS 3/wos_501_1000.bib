@article{ WOS:000346071000016,
Author = {Lench, Heather C. and Bench, Shane W. and Darbor, Kathleen E. and Moore,
   Melody},
Title = {A Functionalist Manifesto: Goal-Related Emotions From an Evolutionary
   Perspective},
Journal = {EMOTION REVIEW},
Year = {2015},
Volume = {7},
Number = {1},
Pages = {90-98},
Month = {JAN},
Note = {Australian Sociological Associations Sociology of Emotions and Affect
   Midyear Symposium, Adelaide, AUSTRALIA, JUL 25-26, 2013},
Abstract = {Functional theories posit that emotions are elicited by particular
   goal-related situations that represented adaptive problems and that
   emotions are evolved features of coordinated responses to those
   situations. Yet little theory or research has addressed the evolutionary
   aspects of these theories. We apply five criteria that can be used to
   judge whether features are adaptations. There is evidence that sadness,
   anger, and anxiety relate to unique changes in physiology, cognition,
   and behavior, those changes are correlated, situations that give rise to
   emotions are consistent, and emotions are complex. To date, there is
   little experimental evidence regarding whether discrete emotions resolve
   adaptive problems and do so relatively efficiently. Evidence supporting
   all criteria is required to claim that discrete emotions are evolved
   features.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Lench, HC (Corresponding Author), Texas A\&M Univ, Dept Psychol, 4235 TAMU, College Stn, TX 77843 USA.
