Title = {Conversion of old salt-works into a urban park in the city of Cagliari},
Booktitle = {12TH INTERNATIONAL SYMPOSIUM ON ENVIRONMENTAL ISSUES AND WASTE
   MANAGEMENT IN ENERGY AND MINERAL PRODUCTION - SWEMP 2010},
Year = {2010},
Pages = {47-56},
Note = {12th International Symposium on Environmental Issues and Waste
   Management in Energy and Mineral Production SWEMP 2010, Czech Univ Life
   Sci, Prague, CZECH REPUBLIC, MAY 24-26, 2010},
Abstract = {The ``Molentargius-Saline{''} area is located in the metropolitan area
   of the city of Cagliari, inhabited by more than 400,000 people. Before
   becoming Regional Natural Park, the site has been recognised as a humid
   area deserving special protection by the Ramsar agreement in 1977, owing
   to the presence of stable wildlife of international interest.
   The Body entrusted with the management of the Park is now dealing with
   the problem of ensuring environmental conditions of the area compatible
   with the ecology, focussing the attention on the salt basins immediately
   facing the Poetto beach, also in view of possibly resuming the salt
   production aimed at the economic support of the park activities.
   This approach is likely to conflict with the biodiversity of the whole
   ecosystem consisting of a variety of aquatic birds, vertebrates and
   wetland plants. Therefore it is believed that a different approach
   should be pursued as underlined in the paper. In particular, salt
   production should be definitely stopped and energy needs met by
   resorting to renewable sources such as the heat recoverable by means of
   ``solar ponds{''}.},
