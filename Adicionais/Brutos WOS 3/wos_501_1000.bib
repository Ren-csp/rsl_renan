@inproceedings{ WOS:000503475800026,
Author = {Fernandez-Aguilar, Luz and Martinez-Rodrigo, Arturo and Moncho-Bogani,
   Jose and Fernandez-Caballero, Antonio and Miguel Latorre, Jose},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Emotion Detection in Aging Adults Through Continuous Monitoring of
   Electro-Dermal Activity and Heart-Rate Variability},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
