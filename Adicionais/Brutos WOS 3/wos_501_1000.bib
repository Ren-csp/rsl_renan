Title = {Factors influencing local people's attitudes towards wild boar in
   Taohongling National Nature Reserve of Jiangxi Province, China},
Booktitle = {INTERNATIONAL CONFERENCE ON ECOLOGICAL INFORMATICS AND ECOSYSTEM
   CONSERVATION (ISEIS 2010)},
