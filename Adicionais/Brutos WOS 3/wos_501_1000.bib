@inproceedings{ WOS:000320828201184,
Author = {Jin, Ruifeng and Zeng, Jian and Tang, Hao},
Editor = {Tang, X and Zhong, W and Zhuang, D and Li, C and Liu, Y},
Title = {Main Characteristics and Prevention Strategy of Disaster in Binhai
   Industrial Park},
Booktitle = {PROGRESS IN ENVIRONMENTAL PROTECTION AND PROCESSING OF RESOURCE, PTS 1-4},
Series = {Applied Mechanics and Materials},
Year = {2013},
Volume = {295-298},
Pages = {2684+},
Note = {International Conference on Sustainable Energy and Environmental
   Engineering (ICSEEE 2012), Guangzhou, PEOPLES R CHINA, DEC 29-30, 2012},
Organization = {Guangdong Univ Business Studies},
Abstract = {Binhai Industrial Park faces high risk of industrial disaster, and owing
   to its location near the Sea, it is subject to the influence of chain
   disaster resulted from natural calamities (leakage chain disaster, blast
   chain disaster). Therefore, it is essential that we tighten our control
   on each level and break the chain of disaster through disaster
   monitoring technology, risk assessment technology and emergency rescue
   technology. And the whole work should be based on the theory of
   chain-cutting disaster mitigation and the technology of 3S digital
   information. We should emphasize on the function of disaster prevention
   when we plan Binhai Industrial Park and design the industrial buildings,
   improve the technique of comprehensive disaster prevention within the
   framework of urban planning. With the adoption of certain
   counter-disaster strategies (the strategies should be related to the
   natural causing factors of the industrial disaster, such as storm tide),
   we will achieve our goal of building a disaster-free industrial park.},
