Volume = {5},
Pages = {237-246},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {In 1997, Coimbra, the third-largest Portuguese city, inaugurated an
   innovative, integrated park-and-ride system named ECOVIA, The system is
   an important component of the city's program to improve mobility and
   transport. ECOVIA is based on a large fleet of quick and comfortable
   mini-buses leaving every five minutes from strategically located
   park-and-ride facilities to the city's central area. This paper
   describes the operation of the system and presents the results of an
   inquiry made to identify the system users' main characteristics, their
   evaluation on the quality of the service, the recognition levels of the
   system, and the reasons why it was not adopted by some potential users.},
