Author = {Caicedo-Acosta, J. and Cardenas-Pena, D. and Collazos-Huertas, D. and
   Padilla-Buritica, I, J. and Castano-Duque, G. and Castellanos-Dominguez,
   G.},
Editor = {Vicente, JMF and AlvarezSanchez, JR and Lopez, FD and Moreo, JT and Adeli, H},
Title = {Multiple-Instance Lasso Regularization via Embedded Instance Selection
   for Emotion Recognition},
Booktitle = {UNDERSTANDING THE BRAIN FUNCTION AND EMOTIONS, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2019},
