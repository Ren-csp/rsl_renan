@article{ WOS:000236930700005,
Author = {Maconachie, RA and Binns, T},
Title = {Sustainability under threat? The dynamics of environmental change and
   food production in peri-urban Kano, northern Nigeria},
Journal = {LAND DEGRADATION \& DEVELOPMENT},
Year = {2006},
