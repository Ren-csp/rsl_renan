   Bruno Noronha and Fragoso Favoreti, Ana Laura and Molina Junior, Vitor
   Eduardo and Canteras, Felippe Benavente},
Editor = {Ferreira, P and Dall'Orsoletta, A and Jorio, M and Santos, AL},
Title = {GREEN INFRASTRUCTURES AS A MITIGATOR OF URBANIZATION PROBLEMS: A CASE
   STUDY IN THE CITY OF SOROCABA, SAO PAULO/BRAZIL},
Booktitle = {PROCEEDINGS OF THE 6TH INTERNATIONAL CONFERENCE ON ENERGY \&
   ENVIRONMENT: BRINGING TOGETHER ENGINEERING AND ECONOMICS},
Series = {ICEE International Conference on Energy \& Environment},
Year = {2024},
Pages = {246-251},
Note = {2024 International Conference on Energy and Environment-ICEE-Bringing
   together Engineering and Economics, Guimaraes, PORTUGAL, JUN 06-07, 2024},
Abstract = {Urbanization, a globalized trend, poses significant challenges to city
   sustainability, including environmental risks like flooding due to
   reduced permeable areas and mismanagement of rainwater. To address these
   issues, exploring solutions is imperative; for example, the Green
   Infrastructures (GI) offer multipurpose solutions, comprising parks,
   green roofs, and rain gardens, enhancing permeability and aiding
   rainwater absorption. This study investigates Sorocaba city's GI in Sao
   Paulo, Brazil, focusing on vulnerable areas to climate disasters such as
   flooding. Employing qualitative-quantitative research and spatial
   modeling, it maps and analyzes GI distribution in flood-prone zones to
   understand their impact on the study areas. The findings provide
   insights for municipal management by identifying successes and
   shortcomings in GI implementation to mitigate flooding, thus enhancing
   urban water security. This research fills an academic gap, providing
   insights applicable globally to urban resilience efforts.},
