
@article{ WOS:000376876400025,
Author = {Pascanu, Ionela and Hutu, Simona and Cota, Ancuta and Capraru, Oana and
   Pop, Raluca},
Title = {URBAN VERSUS RURAL: DOES THE ENVIRONMENT COUNT IN CHILD DEVELOPMENT?},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
