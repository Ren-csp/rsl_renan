@inproceedings{ WOS:001417129900017,
Author = {Zhang, Xiaochen and Tang, Daniel},
Editor = {Tanveer, M and Agarwal, S and Ozawa, S and Ekbal, A and Jatowt, A},
Title = {Emotion Detection in Unfix-Length-Context Conversation},
Booktitle = {NEURAL INFORMATION PROCESSING, ICONIP 2022, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2023},
