Title = {MEASURING QUALITY OF LIFE (QOL) IN URBAN ENVIRONMENT: AN INTEGRATED
   APPROACH},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Quality of life (QoL) is a multidimensional term, including aspects of
   social, economic, environmental, health and psychological wellness.
   Associated with concepts relating to personal wellbeing, quality of life
   and overall well-being of society, has found application of research in
   a wide range of disciplines including sociology, economics,
   industrial/organizational psychology, planning-management, geography and
   public health among others. Many distinctions have been based on the
   concept of QoL in terms of subjective and objective dimension, sectors
   and indicators to be used in each research. Quality of life is a concept
   that has been researched empirically and theoretically in the field of
   economics, health, while other papers examined the correlations between
   quality of life and housing values, or productivity differences, living
   conditions, and quality of place. Many approaches do exist to evaluate
   the quality of life in urban environment and there are also many surveys
   by cities, dominating worldwide quality of living rankings.
   This study examines the evaluation of urban quality of life, focusing on
   subjective dimension, investigating individual and urban factors, trying
   to represent the spatial variability of life satisfaction and overall
   well-being. Moreover, appropriate objective indicators are identified
   and suggested for the assessment of Qol through quantitative approach.
   At individual's level, citizens of Thessaloniki are required to address
   their life satisfaction concerning their residential area neighborhood
   through their level of satisfaction. The parameters addressed through a
   questionnaire survey include important issues such as environment,
   infrastructure, safety, health, transport and other fields.
   The above data are collected in a geodatabase. The relative importance
   of each domain is calculated by the individual perception of residents,
   defined as the contribution of each aspect to the total quality of life.
   The spatial differences of urban quality of life results from the
   perception of the quality of life by residents themselves.},
Publisher = {GLOBAL NEST, SECRETARIAT},
