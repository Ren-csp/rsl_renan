@inproceedings{ WOS:000264338200018,
Author = {Olazabal, M. and Garcia, I. and Garcia, G. and Abajo, B. and Herranz, K.
   and Alonso, A. and Feliu, E. and Izaola, B. and Aspuru, I. and
   Santa-Coloma, Oscar},
