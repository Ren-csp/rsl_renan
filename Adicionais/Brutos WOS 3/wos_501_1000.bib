@inproceedings{ WOS:001709837100018,
Author = {Mejia-Zuluaga, Paola Andrea and Valdiviezo-N, Juan C. and Dozal, Leon},
Editor = {Neale, CM and Maltese, A},
Title = {Texture Descriptors and Machine Learning Algorithms for Mistletoe
   Detection in Urban Forests Using Multispectral Imagery},
Booktitle = {REMOTE SENSING FOR AGRICULTURE, ECOSYSTEMS, AND HYDROLOGY XXV},
