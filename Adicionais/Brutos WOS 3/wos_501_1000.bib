Title = {COULD WE THINK ABOUT FRIENDSHIP RELATIONSHIPS WITHOUT EMOTIONS? THE
   OTHER-ORIENTED EMOTIONS},
Booktitle = {9TH INTERNATIONAL CONFERENCE ON EDUCATION AND EDUCATIONAL PSYCHOLOGY
   (ICEEPSY 2018)},
