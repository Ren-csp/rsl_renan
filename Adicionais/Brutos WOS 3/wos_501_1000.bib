Pages = {320-324},
Note = {4th International Conference of Urbanization and Land Resource
   Utilization, Tianjin Univ Commerce, Tianjin, PEOPLES R CHINA, JUL 04,
   2011},
Organization = {Tianjin Univ Commerce},
Abstract = {The diversity and interaction of urban ecological environment decide
   that urban ecological environment governance is a complicated systematic
   project. Urban ecological environment governance is a kind of public
   goods of strong externality.To promote the effect of urban ecological
   environment governance, urban managers must accurately define the
   connotation and goal of urban ecological environment governance,
   understand fully basic characteristics and stakeholders of urban
   ecological environment governance. How to coordinate the interests of
   shareholders to maximize the effectiveness, has become the final target
   of studying roles and division of responsibilities of stakeholders in
   urban ecological environment governance. To minimize the costs while
   maximizing the interests in the whole process of ecological environment
   governance, ecological environment governance shall be of multicentric
   governance structure under the guidance of the government,which form the
   resultant force to push forward the balance and harmonious development
   between urban economic society and ecological environment.},
