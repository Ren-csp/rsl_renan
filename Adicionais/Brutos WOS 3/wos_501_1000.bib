Pages = {546-550},
Note = {2nd International Conference of Urbanization and Land Resource
   Utilization, Tianjin, PEOPLES R CHINA, OCT 16, 2010},
Organization = {Tianjin Univ Commerce},
Abstract = {The Chinese traditional culture, which closely related to urban
   development, includes the cosmological ideas, Confucian philosophy,
   Daoism conception and Feng-Shui theory, etc. These ancient theories
   described that human life being should be in a highly harmony with
   nature and maintain the ecological and cultural integrity landscapes of
   the city. In china, ancient people tried to locate their housing within
   good environment and make an overall urban plan and establish a perfect
   urban system. They considered that this system can provide a harmonious
   spatial relationship between human settlements and natural environment,
   prevent disaster, and guarantee the owner's bright future. In this
   paper, we discuss the Chinese traditional culture in urban planning. It
   is necessary to succeed the traditional culture and build a new urban
   planning theory for urban sustainable development.},
