Title = {A Sustainable and Economically Recycling Real Estate Development
   Project: A Case Study for Istanbul Park},
Booktitle = {SURVIVAL AND SUSTAINABILITY: ENVIRONMENTAL CONCERNS IN THE 21ST CENTURY},
