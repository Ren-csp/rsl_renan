Author = {Lang, PJ and Bradley, MM and Cuthbert, BN},
Title = {Emotion and attention: Stop, look, and listen},
Journal = {CAHIERS DE PSYCHOLOGIE COGNITIVE-CURRENT PSYCHOLOGY OF COGNITION},
Year = {1998},
