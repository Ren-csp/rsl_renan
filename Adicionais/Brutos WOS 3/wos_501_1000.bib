@inproceedings{ WOS:000466841700008,
Author = {Markowska, Magdalena and Hartel, Charmine E. J. and Brundin, Ethel and
   Roan, Amanda},
Editor = {Hartel, CEJ and Zerbe, WJ and Ashkanasy, NM},
Title = {A DYNAMIC MODEL OF ENTREPRENEURIAL IDENTIFICATION AND
   DIS-IDENTIFICATION: AN EMOTIONS PERSPECTIVE},
Booktitle = {NEW WAYS OF STUDYING EMOTIONS IN ORGANIZATIONS},
Series = {Research on Emotion in Organizations},
Year = {2015},
Volume = {11},
Pages = {215-239},
Note = {9th International Conference on Emotions and Worklife (Emonet),
   Philadelphia, PA, JUL 30-31, 2014},
Abstract = {Despite recognition of the centrality of emotions in entrepreneurship,
   little attention has been given to role of emotions in the development
   of entrepreneurial identity or enactment of entrepreneurial role. The
   contribution of the chapter is in the development of a dynamic model of
   the process leading to identification or dis-identification as an
   entrepreneur. In this chapter, we develop a dynamic model of the process
   leading to identification or dis-identification as an entrepreneur. We
   theorize that the driver behind an individual's decision to become an
   entrepreneur, and their significant emotional experiences in the
   entrepreneurial role, influence the likelihood of following an
   identification or dis-identification cycle. Specifically, our framework
   proposes that positive emotions strengthen approach motivation and
   identification with the role, while negative ones foster avoidance
   motivation and dis-identification. We argue that contextual embeddedness
   can prompt transition between these two cycles. Our theorization
   provides new insights into methods of analyzing the role of emotions in
   the entrepreneurial process, more specifically in the process of
   entrepreneurial identity crafting. These insights also can be translated
   into studying the crafting of any professional identity.},
