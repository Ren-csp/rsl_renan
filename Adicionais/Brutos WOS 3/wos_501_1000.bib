@inproceedings{ WOS:001264250100019,
Author = {Falasca, Federico and Marucci, Alessandro},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti, L},
Title = {Urban Ecosystem Services: Land Cover and Potential of Urban Soils},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 2, INPUT 2023},
