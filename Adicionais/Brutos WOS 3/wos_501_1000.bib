@inproceedings{ WOS:000189414500017,
Author = {Earl, P},
Book-Group-Author = {HRC},
Title = {Front Park and the Peace Bridge expansion project},
Booktitle = {BORDERLANDS: THE SHARED CANADIAN AND U.S. EXPERIENCE OF LANDSCAPE},
Year = {2002},
Pages = {179-187},
Note = {Alliance-for-Historic-Landscape-Preservation Annual Meeting, Niagara on
   the Lake, CANADA, JUN 02-05, 1999},
Organization = {Alliance Histor Landscape Preservat},
Abstract = {Frederick Law Olmsted's design of the Buffalo Park \& Parkway System, in
   1868, was a milestone for Olmsted and for the City of Buffalo. For one
   of the first times in his career he was both a park maker and an urban
   planner The parks and the parkways as laid out by Olmsted provided a
   green framework for the rapidly growing city. Buffalo at the turn of the
   20(th) century was a gracious, livable city with ample green spaces.
   Today, Buffalo is in a position to restore its Olmsted Park System, a
   situation that did not exist three years ago. The Peace Bridge Authority
   is planning an expansion of its bridge system. This presents the
   extraordinary opportunity to move the U.S. plaza and reclaim Front Park,
   one of the three original parks in Olmsted's plan. The 13-minute video,
   Frederick Law Olmsted's Vision for Buffalo, which was shown at the
   Borderlands conference, focuses attention on the original intent of the
   landscape designers and the validity of the park system for Buffalo in
