Note = {International Conference on Social Sciences and Education (ICSSE),
   Bandung, INDONESIA, NOV 21-23, 2017},
Abstract = {Emotion recognition is the first phase of emotion-based services. Our
   experiences imply that a person's emotion state is too complicated and
   conflicted to be classified into a few categories. We use the continuous
   emotion space for describing emotion generation and regulation, and
   develop a fusion model that involves the outcomes of multiple
   recognition channels. We also discuss how to adjust the effect of
   personal differences in emotion expression and the reliability of
   recognition channels. It is interesting that the dimension of the
   emotion space is not critical under our linear-transformation
   assumption. Experimental results by vision, voice, and text channels are
   discussed.},
