@inproceedings{ WOS:000380508700015,
Author = {Asmal, Idawarni},
Editor = {VanEgmond, E and Thompson, K},
Title = {Bale-bale as a space for social interaction},
Booktitle = {GREEN ARCHITECTURE FOR SUSTAINABLE LIVING AND ENVIRONMENT},
Series = {Procedia Social and Behavioral Sciences},
Year = {2015},
Volume = {179},
Pages = {176-182},
Note = {Green Architecture for Sustainable Living and Environment, Bali,
   INDONESIA, NOV 29-29, 2014},
Organization = {Inst Technol Sepuluh Nopember ITS Surabaya, Fac Civil Engn \& Planning,
   Dept Architecture},
Abstract = {Social interaction which has been clear to be intensively decreased in
   urban society creates an impact on mutual assistance degradation and
   increase of individualism. For those who live in cities, social
   interaction is done in public areas which are limited in numbers. While
   for those who live in villages, social interaction can be done anywhere
   around the settlement and it is still well maintained. One of the most
   used areas of social interaction is bale-bale. Bale-Bale is a container
   which primary function as a seat that was placed outside the home, it is
   made of half-cut bamboo and designed like a bench. Rectangular in shape
   and have an even number of legs. Bale-bale has a simple design, easily
   moved, cheap, and easy to find. It can be located anywhere such as
   underneath the house (kolong), backyard, side road, and at open spaces.
   This study aims to explore the roles of bale-bale in anticipating social
   interaction of villagers in order to make their unity preserved. This
   research uses qualitative method in which all data are collected by
   directly focusing on conditions in the field and performing interviews
   to public figures, and village staffs. Results of study show that
   bale-bale is utilized as a place for social interaction from various
   ages and genders. Bale-bale is portable based because of its simple and
   light design so that it is easy to move from one to another place.
   Published by Elsevier Ltd.},
