@article{ WOS:000334262100014,
Author = {Kamoutsis, A. P. and Matsoukis, A. S. and Chronopoulos, K. I.},
Title = {BIOCLIMATIC CONDITIONS UNDER DIFFERENT GROUND COVER TYPES IN THE GREATER
   ATHENS AREA, GREECE},
Journal = {GLOBAL NEST JOURNAL},
Year = {2013},
Volume = {15},
Number = {2, SI},
