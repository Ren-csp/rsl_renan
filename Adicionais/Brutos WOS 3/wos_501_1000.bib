Title = {Horticulture, design, and ecology: how to deal with the urban
   environment?},
Booktitle = {VIII INTERNATIONAL CONFERENCE ON LANDSCAPE AND URBAN HORTICULTURE},
Series = {Acta Horticulturae},
Year = {2022},
Volume = {1345},
Pages = {1-12},
Note = {8th International Conference on Landscape and Urban Horticulture, ELECTR
   NETWORK, DEC 15-17, 2021},
Organization = {Int Soc Hort Sci, Div Landscape \& Urban Hort; Int Soc Hort Sci, Div
   Protected Cultivat \& Soilless Culture; Int Soc Hort Sci, Working Grp
   Urban Hort; Univ Catania, Dept Agr, Food \& Environm; Natl Res Council,
   Res Inst Terrestrial Ecosystems; Int Soc Hort Sci, Working Grp Landscape
   Hort},
Abstract = {At present over half of the world's population resides in urban areas
   and in many cases worldwide, rapid urbanisation has resulted in
   transforming people's way of life, environment, and transport. In
   parallel, the effects of urbanisation have led to the abandonment of
   rural areas/practices with negative effects on the environment. Overall,
   urban settlements are characterised by high building density, limited in
   number and size green spaces, and large impervious paved areas that have
   contributed to creating adverse environmental conditions within the
   urban settings. Today urban areas concentrate many environmental risks
   to health that include air pollution, exposure to heat, and social
   isolation. The importance of horticulture in urban areas generated
   ``urban horticulture{''} adding a further dimension to ``traditional{''}
   horticulture. Design is often overseen in horticulture. The various
   interrelated components of urban settings (e.g., buildings, planting,
   transport, lighting, electricity, social, cultural) require a multiscale
   and multidisciplinary design approach. On the other hand, ecology has
   evolved and identifies the impact of humans on ecosystem dynamics that
   also needs to be considered. Based on the literature, the disciplines of
   ecology and horticulture are discussed in relation to urban design and
   the triptych horticulture, design, and ecology is analysed.},
