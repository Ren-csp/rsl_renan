Title = {SUB-URBAN GROWTH IMPACT IN THE WETLAND ENVIRONMENT. CASE STUDY: RAWA
   DANAU NATURE RESERVE},
Booktitle = {10TH INTERNATIONAL MULTIDISCIPLINARY SCIENTIFIC GEOCONFERENCE: SGEM
   2010, VOL II},
