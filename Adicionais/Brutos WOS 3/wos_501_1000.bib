@inproceedings{ WOS:000298265400079,
Author = {Yu Yang and Cen Kuang and Stefan, Norra and Nina, Schleicher and Liu
   Chunhua and Chai Fahe and Chen Yizhen and Wang Shulan and Doris, Stueben},
Editor = {Han, LS and Sun, Y and Zhang, H},
Title = {Impact of Land Use Changes on Urban Ecological Environment in
   Beijing-Taking the Chemical Composition of Street Sediments and
   Atmospheric Particulate Matter as an Example},
Booktitle = {URBANIZATION AND LAND RESERVATION RESEARCH: PROCEEDINGS OF THE 2ND
   INTERNATIONAL CONFERENCE OF URBANIZATION AND LAND RESOURCE UTILIZATION},
Year = {2010},
Pages = {440+},
Note = {2nd International Conference of Urbanization and Land Resource
   Utilization, Tianjin, PEOPLES R CHINA, OCT 16, 2010},
Organization = {Tianjin Univ Commerce},
Abstract = {Beijing, the capital of China with more than 16.9 million people which
   sits in a soupy haze of pollution from nearby factories, is one of the
   most air polluted cities in the world. This city faces severe
   anthropogenic air pollution caused by a dramatically vehicle increase
   every day (sales of motor vehicles 2186 unit per day in 2008),
   coal-fired power plants, construction sites, bare soils, heavy industry,
   coal combustion occurring in and around Beijing and domestic heating
   stoves. Additionally, dust storms from the west, north-west and north
   direction of Beijing carries particulate matter towards Beijing each
   year, especially in spring. Streets sediments consist of particles of
   different chemical composition from many different sources, such as
   traffic, road side soils and industry, which helps to clarify which
   region is suitable for living in a relative good ecological environment
   and help to identify relevant sources of air pollution. This study
   focuses on the street sediments and atmospheric particulate matter and
   thematic information together with statistical evaluated data were
   analyzed in a GIS environment to study the extent and variation of
   concentrations of pollutants and to establish spatial relationship with
   corresponding land use types in Beijing. The sampling of atmospheric
   particulate matter sampled on quartz fibre filters lasted for 2 years at
   six sites, along one transect from northwest to southeast with mini
   volume samplers. Street sediment samples were collected in 2005 along
   four transects inside the 6th ring road in spring after dust storms and
   in autumn before the heating season in Beijing, that is from northwest
   to southeast (NWSE), northeast to southwest (NESW), north to south (NS)
   and east to west (EW), respectively. Distribution and concentrations of
   various chemical elements in street sediments and atmospheric
   particulate matters were investigated in different land use related
   areas in Beijing, China. The particle size spectrum, the morphological
   and component characteristics of the fine and coarse fractions (<100 mu
   m), chemical composition of PM2.5 were determined by ICP-MS. The
   analysis results and the comparison of some characteristics of street
   dust and aerosols combined with enrichment factor (EF) analysis are used
   to assess the impact of main pollution sources.
   The results of this study not only identified the main anthropogenic
   sources responsible for the contamination of Beijing street sediments
   and aerosols, but also found that the spatial distribution of pollutant
   elements showed maximum concentrations in the city seat areas, which
   indicates that the atmospheric pollution was closely related to this
   specific land use class. The concentration of some elements like Al, Ca,
   and Ti in street sediment is much higher than that in PM2.5, while the
   concentration of Cu, Zn, As, Cd and Pb is much higher than that of
   street sediments. The urban polluted elements are all enriched in street
   sediment and PM2.5, but the levels of enrichment in PM2.5 are evidently
   higher than those in street sediment. This is the case especially for
   Cd, whose EF values are the highest not only in both of street dust and
   PM2.5 but also in various seasons. It indicates that anthropogenic
   pollution is serious and the atmospheric pollution was closely related
   to human activity and the specific land use class. The sources
   responsible for the contamination of Beijing street sediments and
   aerosols varied with seasons. The traffic, natural soils, local bare
   land are the three main sources responsible for the contamination of
   Beijing street sediments and aerosols, and the desert far away from
   Beijing, which were transported by sandstorm in spring is another
   important source for it. Coal combustion has some effect on the
   environment, but the steel factory has much more effect on it. The
   Chinese government has already moved the major steel factory and another
   big coking factory out from the urban area of Beijing, with the hopes of
   curbing fine particles suspended in the atmosphere. Hence, it is a good
   opportunity to find out the improvement of urban ecological environment
   after this emissions control.},
