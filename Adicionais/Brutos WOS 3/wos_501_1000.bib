Year = {2004},
Volume = {334},
Number = {SI},
Pages = {481-487},
Month = {DEC 1},
Note = {7th International Symposium on Highway and Urban Pollution, Inst Quimic
   Sarria, Barcelona, SPAIN, MAY, 2002},
Abstract = {DAPPLE (Dispersion of Air Pollution and Penetration into the Local
   Environment, http://www.dapple.org.uk) is a major research project that
   will provide the understanding necessary to assess the sustainability of
   urban road transport in terms of exposure to traffic-related air
   pollution as an alternative to current indicators based on emissions,
   roadside, or far-from-road air pollution levels. The methodology is
   described, which combines on-street and laboratory measurement with
   modelling of the movement of air, vehicles, and vehicle exhaust
   emissions. The relationship between this kind of assessment and more
   realistic indicators of sustainability is discussed. The value of
   large-scale interdisciplinary research in this area is thus
   demonstrated. (C) 2004 Elsevier B.V. All rights reserved.},
