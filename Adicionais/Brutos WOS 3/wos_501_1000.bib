Title = {Monitoring thermal comfort on urban spaces with varying greenery density
   in Santiago of Chile during the hottest summer in the last 30 years},
Booktitle = {INTERNATIONAL SYMPOSIUM ON GREENER CITIES FOR MORE EFFICIENT ECOSYSTEM
   SERVICES IN A CLIMATE CHANGING WORLD},
