@article{ WOS:000225295900049,
Author = {Colvile, RN and Kaur, S and Britter, R and Robins, A and Bell, MC and
   Shallcross, D and Belcher, SE and DAPPLE Project Co-investigators},
Title = {Sustainable development of urban transport systems and human exposure to
   air pollution},
