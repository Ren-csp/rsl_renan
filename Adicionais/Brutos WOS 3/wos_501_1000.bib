@inproceedings{ WOS:000223250200071,
Author = {Longley, ID and Dorsey, JR and Gallagher, MW and Allen, JD and Alfarra,
   MR and Coe, H},
Editor = {Wadhwa, LC},
Title = {Exposure to ultrafine particles from traffic in city streets and the
   urban atmosphere},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2004},
Volume = {16},
