   Van Mierlo, J.},
Editor = {Brebbia, CA},
Title = {The influence of potential policy measures on the eco-efficiency of
   personal vehicle mobility in Brussels},
Booktitle = {URBAN TRANSPORT XIV: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
