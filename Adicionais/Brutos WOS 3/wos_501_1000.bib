@article{ WOS:000431743400160,
Author = {Trahutami, S. I. and Rosliana, Lina and Ratna, Maharani P.},
Title = {Japan in Indonesian Views: Perception or Reality},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {10},
Pages = {10036-10038},
Month = {OCT},
Note = {2nd International Conference on Advanced Science and Information
   Technology (ASCIT), Cheonan, SOUTH KOREA, MAY 12-13, 2017},
Abstract = {A survey by Sugimoto in 2009 says that Japanese have a good self image
   as a society in the world. Most people consider Japanese as a polite,
   punctual, and hard working society. In Indonesia, such perceptions have
   long been believed in Indonesian society's thought. In a global era,
   Japan has recently received many influences from other countries. This
   research is aimed to describe whether Japanese good self image is
   perception or reality in Indonesian opinion. This research applies
   descriptive qualitative method. This research used Kluckhohn's theory of
   cultural values as a main theory. The result of this research showed
   that there are some perceptions which are different from reality, and
   also some perceptions which are still the same as Indonesian perception.
   The same perceptions and realities of Japanese can be seen from the
   essence with time and space, and also from the essence with human nature
   and environment. There are also some differences perceptions and
   realities. They can be seen from the essence of human life, the essence
   of human work, and the essence of fellow human being.},
