Title = {Spatial temporal analysis of urban heat hazard in Tangerang City},
Booktitle = {2ND INTERNATIONAL CONFERENCE OF INDONESIAN SOCIETY FOR REMOTE SENSING
   (ICOIRS)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2017},
Volume = {47},
Note = {2nd International Conference of Indonesian-Society-for-Remote-Sensing
   (ICOIRS), Univ Gadjah Mada, Fac Geog, PUSPICS, Yogyakarta, INDONESIA,
   OCT 17-19, 2017},
Organization = {Indonesian Soc Remote Sensing; MAPIN ISRS Yogyakarta Chapter; Badan
   Informasi Geospasial; Indonesian Geog Soc; DigitalGlobe; Ametisgeo;
   RIEGL; GPS LANDS Sdn Bhd; SKYMAP GLOBAL; BHUMI PRASAJA; Hexagon
   Geospatial; AIRBUS; CGS; COMPNET},
Abstract = {Urban heat is a natural phenomenon which might caused by human
   activities. The human activities were represented by various types of
   land-use such as urban and non-urban area. The aim of this study is to
   identify the urban heat behavior in Tangerang City as it might threats
   the urban environment. This study used three types of remote sensing
   data namely, Landsat TM, Landsat ETM+ and Landsat OLI-TIRS, to capture
   the urban heat behavior and to analysis the urban heat signature of
   Tangerang City in 2001, 2012, 2013, 2014, 2015 and 2016. The result
   showed that urban heat signature change dynamically each month based on
   the sun radiation. The urban heat island covered only small part of
   Tangerang City in 2001, but it was significantly increased and reached
   50\% of the area in 2012. Based on the result on urban heat signature,
   the threshold for threatening condition is 30 degrees C which recognized
   from land surface temperature (LST). The effective temperature (ET)
   index explains that condition as warm, uncomfortable, increase stress
   due to sweating and blood flow and may causing cardiovascular disorder.},
