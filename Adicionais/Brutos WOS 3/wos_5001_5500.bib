@article{ WOS:000230183100002,
Author = {Durgin, FH and Pelah, A and Fox, LF and Lewis, J and Kane, R and Walley,
   KA},
Title = {Self-motion perception during locomotor recalibration: More than meets
   the eye},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2005},
Volume = {31},
Number = {3},
Pages = {398-419},
