@article{ WOS:000236871200006,
Author = {Moelants, D and Van Noorden, L},
Title = {The influence of pitch interval on the perception of polvrhvthms},
Journal = {MUSIC PERCEPTION},
Year = {2005},
Volume = {22},
Number = {3},
Pages = {425-440},
Month = {SPR},
Note = {9th Biennial Workshop on International Rhythm Perception and Production,
   Ile Tatihou, Normandy, FRANCE, JUN, 2003},
Abstract = {Research by S. Handel and J. S. Oshinsky (1981) has shown that when
   tapping to polyrhythms, people synchronize with different subsequences
   depending on the overall tempo, with a global change from the faster
   component at slow tempi to the slower component at medium tempi and then
   to the overall repeating pattern at fast tempi. In this article, similar
   polyrhythmic patterns are Studied, adding larger pitch intervals between
   the two sequences. The results largely confirm the findings of Handel
   and Oshinsky at small pitch intervals, but at larger pitch intervals,
   the importance of the overall pattern decreases in favor of the slow
   component of the polyrhythm. This effect can be explained by the
   increased possibility for streaming of the two components and the
   decrease in peripheral interaction of the coinciding tones. The results
   of the experiment are modeled following the resonance model for temporal
   selectivity proposed by L. Van Noorden and D. Moelants (1999). The
   preference for certain subsequences can be explained as a resonance
   phenomenon with a natural frequency of 2 Hz.},
Publisher = {UNIV CALIFORNIA PRESS},
Address = {C/O JOURNALS \& DIGITAL PUBLISHING DIVISION, 2000 CENTER ST, STE 303,
   BERKELEY, CA 94704-1223 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Moelants, D (Corresponding Author), Univ Ghent, IPEM, Dept Musicol, Blandijnberg 2, B-9000 Ghent, Belgium.
   Univ Ghent, IPEM, Dept Musicol, B-9000 Ghent, Belgium.},
DOI = {10.1525/mp.2005.22.3.425},
ISSN = {0730-7829},
Keywords-Plus = {POLYRHYTHMS; PULSE},
Research-Areas = {Music; Psychology},
Web-of-Science-Categories  = {Music; Psychology, Experimental},
