Volume = {20},
Number = {3},
Pages = {212-217},
Month = {AUG},
Note = {International Symposium of the Andean-Mountain-Association, QUITO,
   ECUADOR, DEC 09-14, 1998},
Organization = {Andean Mt Assoc},
Abstract = {Andean landscapes are rich with examples of traditional land uses that
   have proven sustainable over centuries, contribute to biodiversity and
   other natural values, and are living examples of cultural heritage.
   These landscapes and the diverse array of values they represent are,
   however, exceedingly vulnerable. As countries in the region strengthen
   existing national systems of protected areas, protection of these
   working landscapes-places where people live and work (Figure 1)-deserves
   greater attention and requires new and innovative approaches to
   conservation. Emerging trends in conservation and protected areas
   management are creating new opportunities to engage local people in the
   stewardship of the natural and cultural heritage of working landscapes.
   This type of community-based approach builds on years of experience yet
   extends conservation strategies in new ways and holds great promise as a
   foundation for sustainable land stewardship.},
