Pages = {485-496},
Note = {International Symposium on Environmental Science and Technology,
   Beijing, PEOPLES R CHINA, NOV 13-16, 2007},
Organization = {Chinese Soc Environm Sci; Beijing Inst Technol},
Abstract = {In response to the European Union Air Quality Framework Directive
   (1996/62/EC), the UK has established its National Air Quality Strategy
   in which it identifies standards and objectives for 10 pollutants. The
   Strategy makes it the responsibility of local government authorities to
   ensure compliance with it Quality Framework Directive legal limits. In
   order to ensure compliance, all local authorities within the UK have
   carried out a series of Review and assessment exercises to identify
   areas where non-compliance may exist and produce action plans to ensure
   compliance within a designated time-scale. This paper reviews the
   legislative drivers behind air quality management within the UK and
   outlines the procedure of Review and Assessment undertaken by local
   government authorities to ensure compliance with legal limits. The paper
   also outlines the functionality of the air quality management system,
   `Airviro', and presents case studies where the system has been
   effectively used by local authorities in order to assist them in drawing
   up policies and action plans to better manage local air quality.},
