@inproceedings{ WOS:000189443700019,
Author = {Kalin, NH and Shelton, SE},
Editor = {King, JA and Ferris, CF and Lederhendler, II},
Title = {Nonhuman primate models to study anxiety, emotion regulation, and
   psychopathology},
Booktitle = {ROOTS OF MENTAL ILLNESS IN CHILDREN},
Series = {Annals of the New York Academy of Sciences-Series},
Year = {2003},
