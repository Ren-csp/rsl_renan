@inproceedings{ WOS:000078260900411,
Author = {Park, HD and Kim, SS and Chon, HT},
Editor = {Moore, D and Hungr, O},
Title = {Durability of ornamental stone exposed to various weathering
   environments in Korea},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOLS 1-5},
Year = {1998},
Pages = {2953-2955},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {The surface of ornamental stone exposed to the air has normally
   experienced the process of weathering both due to the natural factors
   like rainfall, wind action, dairy temperature change and salt
   crystallization and due to the artificial factors like pollution and
   acid rainfall, This paper mainly focused on the investigation into the
   weathering state and durability of the ornamental stone exposed to
   different environments in Korea. In Seoul, pH of rain occasionally
   reaches 3.6, which is a possible cause of the chemical weathering of
   stone. In rural area, salt crystallization is the most powerful agent of
   stone decay. In this paper the influence of salt crystallization on
   stone durability has been clearly observed by the experimental results
   from both slake durability test and SEM images.},
