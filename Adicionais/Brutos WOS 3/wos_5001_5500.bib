@article{ WOS:000174941300003,
Author = {Mueller, MA and Waas, GA},
Title = {College students' perceptions of suicide: The role of empathy on
   attitudes, evaluation, and responsiveness},
Journal = {DEATH STUDIES},
Year = {2002},
Volume = {26},
Number = {4},
Pages = {325-341},
Month = {MAY},
Note = {72nd Annual Meeting of the Midwestern-Psychological-Association,
   CHICAGO, IL, MAY 02-04, 2000},
Organization = {Midwestern Psychol Assoc},
Abstract = {A total of 334 college-age students (18719 years) participated in a
   study investigating the role of empathy in perceptions of and
   responsiveness toward a hypothetical friend exhibiting symptoms
   associated with suicide risk. High-empathy participants viewed both
   affective and behavioral characteristics associated with suicide risk as
   more serious, and they were more likely to provide direct assistance and
   talk with the troubled peer. Gender of participant and type of symptom
   displayed also emerged as important factors in participants'
   evaluations. These findings underscore the importance of considering
   social-cognitive factors that may influence perceptions of at-risk
   behaviors. The implications of these findings for the development of
   primary prevention intervention efforts are discussed.},
