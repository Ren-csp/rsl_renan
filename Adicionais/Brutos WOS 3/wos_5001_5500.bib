@article{ WOS:A1997WU04500006,
Author = {Goddard, HC},
Title = {Optimal restrictions on vehicle use for urban sustainability for Mexico
   City},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
