Title = {Characteristics of cognitive function in patients with sleep apnea
   syndrome: an event-related potential study},
Booktitle = {UNVEILING THE MYSTERY OF THE BRAIN: NEUROPHYSIOLOGICAL INVESTIGATION OF
   THE BRAIN FUNCTION},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2005},
