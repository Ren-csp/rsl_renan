Title = {The Regaining of Traditional Street: Combining Street Network
   Configuration with Temporary Urban Interventions},
Booktitle = {4TH INTERNATIONAL CONFERENCE ON RESEARCH METHODOLOGY FOR BUILT
   ENVIRONMENT AND ENGINEERING 2019},
Series = {IOP Conference Series-Earth and Environmental Science},
