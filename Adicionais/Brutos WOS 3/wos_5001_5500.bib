@inproceedings{ WOS:000253563200005,
Author = {Scheding, Steven and Grover, Richard and Durrant-Whyte, Hugh},
Editor = {Jefferies, ME and Yeap, WK},
Title = {Machine perception in unstructured and unknown environments},
Booktitle = {ROBOTICS AND COGNITIVE APPROACHES TO SPATIAL MAPPING},
