@article{ WOS:000169619100004,
Author = {Kim, YJ and Kim, KW and Oh, SJ},
Title = {Seasonal characteristics of haze observed by continuous visibility
   monitoring in the urban atmosphere of Kwangju, Korea},
Journal = {ENVIRONMENTAL MONITORING AND ASSESSMENT},
Year = {2001},
Volume = {70},
Number = {1-2},
Pages = {35-46},
