@inproceedings{ WOS:000078260900356,
Author = {Pereira, JJ and Komoo, I},
Editor = {Moore, D and Hungr, O},
Title = {Using geological information as planning tools for urban centers - The
   case of Klang Valley, Malaysia},
Booktitle = {EIGHTH INTERNATIONAL CONGRESS INTERNATIONAL ASSOCIATION FOR ENGINEERING
   GEOLOGY AND THE ENVIRONMENT, PROCEEDINGS, VOLS 1-5},
Year = {1998},
Pages = {2573-2578},
Note = {8th International Congress of the
   International-Association-for-Engineering-Geology-and-the-Environment,
   VANCOUVER, CANADA, SEP 21-25, 1998},
Organization = {Int Assoc Engn Geol \& Environm},
Abstract = {Geohazards have caused extensive property damage and loss of lives in
   the Klang Valley, when Kuala Lumpur is located. It has also brought
   forth the realisation that human-induced hazards pose serious threats to
   existing infrastructure and future development activities. In order to
   meet the public's demand for safety in land use planning and balanced
   urban growth, appropriate geological information regarding potential
   geohazard occurrences need to be integrated into the planning process.
   The information should highlight the constraints to various types of
   development based on the geological conditions, taking into account
   factors such as site suitability and stability, degree of risk,
   long-term maintenance, cost effectiveness and human security. Guidelines
   should be drawn up to ensure that the recently instituted legislative
   measures are efficiently implemented and enforced, and the current
   integrated geoscience mapping programme for urban areas should be
   re-examined to improve the geological information provided for the
   consumption of planners, developers and decision-makers.},
