@inproceedings{ WOS:000252215400073,
Author = {Duffey, R. B. and Saull, J. W.},
Editor = {Aven, T and Vinnem, JE},
Title = {Risk perception in society: Quantification and management for modern
   technologies},
Booktitle = {RISK, RELIABILITY AND SOCIETAL SAFETY, VOLS 1-3: VOL 1: SPECIALISATION
   TOPICS; VOL 2: THEMATIC TOPICS; VOL 3: APPLICATIONS TOPICS},
Series = {Proceedings and Monographs in Engineering Water and Earth Sciences},
Year = {2007},
Pages = {579+},
Note = {European Safety and Reliability Conference (ESREL 2007), Univ Stavanger,
   Stavanger, NORWAY, JUN 25-27, 2007},
Organization = {Int Res Inst Stavanger; ESRA Norway; Statoil; Proactima/HSE Acad;
   Safetec; Conocophillips; DNV},
Abstract = {We show a means to quantify risk perception in the presence of learning,
   and how it maybe used in managing risk in modem technology systems. The
   basic concept of Information Entropy is applied and shown to be an
   objective measure of risk based on prior events and outcomes, which
   reflect our experience. The link is made explicitly between an
   individual's risk perception and decision making within the system,
   based on the uncertainties, with the outcomes distribution of the actual
   accidents, events and risk observed at the collective level. Based on
   the use of information entropy, it is possible to unify the apparently
   diverse areas of decision making in the face of uncertainty, the most
   probable or likely distributions of risk outcomes, and the influence of
   safety management systems on risk reduction. New comparisons are given
   against actual decision making data at the individual level based on the
   trends observed for the risks in all modern homo-technological systems
   (in road accidents, railway crashes and derailments, aircraft losses,
   ship sinkings, oil spills, shuttle losses, medical errors and surgeries,
   mining accidents, chemical plant explosions, nuclear incidents, etc.,
   etc.). This therefore unifies the approaches to individual and
   collective risk perception and risk taking, and hence forms a basis for
   risk prediction and management in modem technological systems.},
