Title = {Semi-subsistence farming development in a Carpathian declining mining
   area. A microscale study of landowners' perception: Stulpicani commune,
   Romania},
Booktitle = {ECOSMART - ENVIRONMENT AT CROSSROADS: SMART APPROACHES FOR A SUSTAINABLE
   DEVELOPMENT},
Series = {Procedia Environmental Sciences},
Year = {2016},
Volume = {32},
