@inproceedings{ WOS:001209262900002,
Author = {Wu, C. C. and Chang, C. Y.},
Editor = {Ou, SJ and Chang, CY},
Title = {Analysis of psychophysiological benefits of landscapes in natural
   leisure fields - a study on the therapeutic agricultural landscapes},
Booktitle = {INTERNATIONAL SYMPOSIUM ON HORTICULTURAL THERAPIES: PAST, PRESENT AND
   FUTURE},
