@inproceedings{ WOS:000079356600020,
Author = {Fusco, R and Scafé, E and Buttini, P and Gariazzo, C},
Editor = {Almorza, D and Ramos, HM},
Title = {A simplified model for pollution levels prediction in urban areas},
Booktitle = {APPLIED SCIENCES AND THE ENVIRONMENT},
Series = {ENVIRONMENTAL ENGINEERING (SERIES)},
Year = {1998},
Pages = {205-215},
Note = {1st International Conference on Applied Sciences and the Environment
   (ASE 98), CADIZ, SPAIN, 1998},
Organization = {Univ Cadiz, Spain; Wessex Inst Technol, UK},
Abstract = {A simplified model for the prediction of the spatial distribution of
   pollution level on the urban microscale, has been developed. The model
   requires a reduced set of data and uses the existing similarity among
   different sites in the same city.
   Each city can be characterised by an average vehicle emission factor,
   and a set of meteorological parameters which are nearly constant over
   the city area at a fixed time. Therefore, the difference in pollution
   levels between two sites should depend mainly on traffic volume and
   local topography (street width, building height etc.).
   The air quality monitoring stations of the urban network are located in
   city areas with different traffic density. Then, using the CO level of
   some of these monitoring stations as a reference, it is possible to
   describe the whole pollutant distribution in the other areas, only by
   knowing, for each site, the traffic volume and the topographic features.
   The time resolution will depend upon the frequency of the collected
   data.
   This procedure has been applied to the city of Rome by using the Air
   Quality Control Network data. In particular, we selected two monitoring
   stations as a reference to predict the CO level on the other sites of
   the network. The agreement between the calculated and measured CO values
   is quite good. They differ by root-mean-square values of the order of 2
   ppm for a monthly prediction.
   The model can be used as a screening tool for traffic distribution
   planning in order to reduce the localised peak concentration.},
Publisher = {WIT PRESS/COMPUTATIONAL MECHANICS PUBLICATIONS},
Address = {ASHURST LODGE, ASHURST, SOUTHAMPTON SO40 7AA, ENGLAND},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Fusco, R (Corresponding Author), EniTecnol SPA, Via E Ramarini 32, I-00016 Monterotondo, Roma, Italy.
   EniTecnol SPA, I-00016 Monterotondo, Roma, Italy.},
ISSN = {1460-1427},
ISBN = {1-85312-603-9},
