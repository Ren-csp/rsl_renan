@article{ WOS:000383507100005,
Author = {Borba, M. L. and Warner, J. F. and Porto, M. F. A.},
Title = {Urban stormwater flood management in the Cordeiro watershed, SAo Paulo,
   Brazil: does the interaction between socio-political and technical
   aspects create an opportunity to attain community resilience?},
Journal = {JOURNAL OF FLOOD RISK MANAGEMENT},
Year = {2016},
Volume = {9},
Number = {3, SI},
