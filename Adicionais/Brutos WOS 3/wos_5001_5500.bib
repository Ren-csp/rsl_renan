@article{ WOS:000260262900009,
Author = {Duzgoren-Aydin, N. S. and Weiss, A. L.},
Title = {Use and abuse of Pb-isotope fingerprinting technique and GIS mapping
   data to assess lead in environmental studies},
Journal = {ENVIRONMENTAL GEOCHEMISTRY AND HEALTH},
Year = {2008},
Volume = {30},
Number = {6},
Pages = {577-588},
Month = {DEC},
Note = {Conference of the Society-for-Environmental-Geochemistry-and-Health on
   Urban Geochemistry and Health, New Orleans, LA, JUL 22-25, 2007},
Organization = {Soc Environm Geochem \& Hlth},
Abstract = {The danger to health, especially of young children, from lead-bearing
   particulates in the surface environment is still a valid concern. Given
   the multifaceted uses of lead today as well as historically, the sources
   of lead must be investigated to distinguish the etiology of lead
   contamination on the environment. The lead isotope finger printing
   technique based on isotopic ratio analyses (IRA) is one of the methods
   used commonly for provenancing lead sources in environmental studies
   throughout the world. This technique, however, has some inherited
   shortcomings. Therefore, caution must be used in the interpretation of
   the results, as this technique can lead to overestimations as well as
   underestimations of the true source etiology/apportionment of lead in
   specific environments. This paper illustrates this with some examples.
   Data on geographical information systems (GIS) mapping in urban regions
   are also presented in this paper.},
