Title = {Memory and emotion processing in healthy subjects, focal brain-damaged
   and patients with Alzheimer's disease},
Booktitle = {MEMORY AND EMOTION},
Series = {SERIES ON BIOPHYSICS AND BIOCYBERNETICS},
Year = {2002},
Volume = {12},
Pages = {113-129},
Note = {International School of Biocybernetics, NAPLES, ITALY, OCT 18-23, 1999},
Abstract = {Our study was aimed to investigate the effect of emotions on various
   memory processes by using different tests: identification and
   recognition of incomplete figures and words (priming), recognition of
   emotional and neutral photos and recall of auditory presented stories of
   either emotional or neutral content. In both priming tests controls
   performed significantly better than patients. Within the patient groups
   subjects with lesions confined to the fronto-basal region were less
   proficient than patients with Alzheimer's disease (AD). We also found
   substantial differences when comparing the recognition performance of
   controls and fronto-basal patients in emotional versus neutral photos.
   Significant differences in immediate free recall of emotional and
   neutral stories could only be established for control subjects. This
   fact lead us to hypothesize that in this case early mechanisms of
   hippocampal ``gating{''} processes may take place. The same comparison
   after a 24h delay was not significant in all groups. The complex of our
   results indicate that emotion may participate in the selection of
   sensory information.},
