@article{ WOS:000391903900032,
Author = {Fang, Wei and An, Haizhong and Li, Huajiao and Gao, Xiangyun and Sun,
   Xiaoqi and Zhong, Weiqiong},
Title = {Accessing on the sustainability of urban ecological-economic systems by
   means of a coupled emergy and system dynamics model: A case study of
   Beijing},
