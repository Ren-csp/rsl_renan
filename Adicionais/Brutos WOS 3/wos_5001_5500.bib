@article{ WOS:000249127600009,
Author = {Sutton, Tina M. and Altarriba, Jeanette and Gianico, Jennifer L. and
   Basnight-Brown, Dana M.},
Title = {The automatic access of emotion: Emotional Stroop effects in
   Spanish-English bilingual speakers},
Journal = {COGNITION \& EMOTION},
Year = {2007},
Volume = {21},
Number = {5},
Pages = {1077-1090},
Month = {AUG},
Note = {46th Annual Meeting of the Psychonomic-Society, Toronto, CANADA, NOV
   10-13, 2005},
Organization = {Psychon Soc},
Abstract = {The emotional Stroop task provides an experimental measure of selective
   attention to emotional information. In the current study, the emotional
   Stroop effect was examined in a Spanish-English bilingual speaking
   population. The results revealed that the emotional Stroop effect is a
   robust phenomenon and replicable within a bilingual population.
   Furthermore, highly proficient bilinguals demonstrated equal
   interference effects in both their first language and their second
   language. The current study provides evidence of the automatic
   activation of emotional components in words appearing in more than one
   language. These results are discussed with reference to previous
   findings in the literature on bilingual emotion word representation.},
