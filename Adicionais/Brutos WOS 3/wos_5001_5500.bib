Year = {1997},
Volume = {12},
Number = {2},
Pages = {367-380},
Month = {JUN},
Note = {68th Annual Meeting of the Midwestern-Psychological-Association,
   CHICAGO, IL, MAY 03, 1996},
Organization = {Midwestern Psychol Assoc},
Abstract = {The present study examined perceptions of couple attractiveness.
   Perceptions were assessed of supposedly dating couples comprised of
   members varying in levels of physical attractiveness. We also
   investigated perceptions made about each member of the pair. An
   additional analysis was conducted to examine the relative contribution
   of the male and female targets' physical attractiveness on perceptions
   of couple attractiveness. Results indicated favorable perceptions of
   couples in which both members or the female partner were physically
   attractive. Unfavorable attributions were reported for dyads in which
   both,members were unattractive or in which the man was attractive but
   the woman was not. Participants also made attributions about each
   partner's level of satisfaction in the relationship. Results showed that
   both targets' levels of physical attractiveness significantly influenced
   responses. The participants' dating experiences or exposures to similar
   pairs in the real world, did nor account for differences in perceptions
   of couple attractiveness.},
