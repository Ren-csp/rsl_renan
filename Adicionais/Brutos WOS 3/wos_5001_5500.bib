@article{ WOS:000235103000006,
Author = {Soares, SRA and Parkinson, J and Bernardes, RS},
Title = {Analysis of scenarios for wastewater and urban drainage systems in
   Brazil based on an integrated modeling approach},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
