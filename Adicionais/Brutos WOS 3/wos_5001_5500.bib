Title = {The influence of energy drinks and caffeine on peripheral perception and
   estimation of speed and distance for the young Romanian students},
Booktitle = {BEHAVIORAL, COGNITIVE AND PSYCHOLOGICAL SCIENCES},
Series = {International Proceedings of Economics Development and Research},
Year = {2011},
