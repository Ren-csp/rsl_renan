@inproceedings{ WOS:000232494300043,
Author = {Komatsu, T},
Editor = {Schaal, S and Ijspeert, A and Billard, A and Vijayakumar, S and Hallam, J and Meyer, JA},
Title = {How can a life-like agent evoke its emotions for users? A method for
   inducing users' natural behaviors to establish ``mutual adaptation{''}},
Booktitle = {FROM ANIMALS TO ANIMATS 8},
Year = {2004},
Pages = {415-424},
Note = {8th International Conference on Simulation of Adaptive Behavior (SAB
   2004), Los Angeles, CA, JUL 13-17, 2004},
Abstract = {In terms of creating a smooth communication between a human and an
   interactive agent, some researchers have argued that they must form a
   mutual adaptation process; that is, both should learn to respond and
   adapt appropriately to each other's behaviors. Moreover, to create a
   mutual adaptation process between them, an agent is required to induce
   its partner's adaptations or natural behaviors. Some studies have
   already reported that giving a certain physical body to such an agent is
   reasonable; however, doing so for all kinds of interactive agents is
   unrealistic. To achieve an interactive agent without a physical body, I
   assumed that this agent should express certain information that can
   evoke its specific emotions for a user, because it is expected that we
   humans will empathize with certain entity which seems to have some
   emotions. I then carried out experiments to clarify which kinds of
   information the agent expressed (its synthesized sounds and its
   unilateral actions) could evoke the specific emotions for humans. The
   results of these experiments could be explained by the following
   hypothesis: when the temporal transitions in expressed information
   regardless of any modalities conform to the law of conservation of
   energy, this information evokes an information sender's (an agent)
   positive emotions for an information receiver (a human); On the other
   hand, when the specific temporal transitions deviate from the law of
   conservation of energy, this information evokes a sender's negative
   emotions. In near future, this hypothesis would contribute to a basic
   methodology to create a mutual adaptation for various applications that
   are required to communicate with humans, even for these applications
   without having a physical body.},
Publisher = {MIT PRESS},
