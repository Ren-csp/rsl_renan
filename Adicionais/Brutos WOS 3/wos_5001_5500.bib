@article{ WOS:A1993LF11100011,
Author = {BROWNE, BA and FRANCIS, SK},
Title = {PARTICIPANTS IN SCHOOL-SPONSORED AND INDEPENDENT SPORTS - PERCEPTIONS OF
   SELF AND FAMILY},
Journal = {ADOLESCENCE},
Year = {1993},
Volume = {28},
Number = {110},
Pages = {383-391},
Month = {SUM},
Note = {MEETING OF THE WESTERN PSYCHOLOGICAL ASSOC, LOS ANGELES, CA, APR, 1990},
Organization = {W PSYCHOL ASSOC},
Abstract = {Sports are believed to contribute to physical well-being, social
   adjustment, and self-esteem. In this study, perceptions of social
   competence and family dynamics were examined among adolescent
   participants in school-sponsored and independent sports (baseball and
   skateboarding). Subjects. aged 12 to 19 years, completed a questionnaire
   consisting of FACES III, a social competence scale, and miscellaneous
   items concerning school performance, sports commitment, and perceptions
   of adult attitudes. Perceptions of social competence were differentially
   related to degree of sports involvement and perceived skill but were not
   related to the social acceptability of the sport. Adolescents in both
   groups depicted their families as demonstrating low levels of cohesion
   but high adaptability.},
