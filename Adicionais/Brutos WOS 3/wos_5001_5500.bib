@article{ WOS:000077148300003,
Author = {Burgess, ES and Haaga, DAF},
Title = {Appraisals, coping responses, and attributions as predictors of
   individual differences in negative emotions among pediatric cancer
   patients},
Journal = {COGNITIVE THERAPY AND RESEARCH},
