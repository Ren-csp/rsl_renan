Note = {7th Euro-Asia Conference on Environment and CSR, Huangshan, PEOPLES R
   CHINA, MAY 09-12, 2011},
Organization = {German Acad Exchange Serv Fdn; IMRE Alumni Network},
Abstract = {The dual structure of the minimum living security system for rural and
   urban residents in China not only influences the fairness and justice of
   the minimum living security system, but also hinders the elimination of
   urban-rural differences. This article firstly analyzes the operation
   status of the integration of the urban and rural minimum living security
   system, and then puts forward countermeasures to improve the urban and
   rural minimum living security system integration. The author stresses
   that the minimum living security system integration is an inevitable
   choice for the social development in China.},
