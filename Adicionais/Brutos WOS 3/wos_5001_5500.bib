@article{ WOS:000445101000125,
Author = {Tompodung, Linda Maya and Widaty, Sandra and Widyahening, Indah Suci},
Title = {Perceptions of Academic Achievers and Under-Achievers on Learning
   Environment at Sam Ratulangi University, Indonesia},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {9},
Pages = {6777-6780},
Month = {SEP},
Note = {International Conference on Actual Economy - European Discourse on
   Global Challenges (ACE-EU), Paris, FRANCE, NOV 27-29, 2017},
Abstract = {Introduction: The learning environment is believed to affect the
   students' achievement, satisfaction and success. The students who have a
   supportive learning environment are believed to study harder and achieve
   better performance. It would be useful to have an instrument to identify
   the features of the educational environment that high and under
   achievers students perceive differently in order to design intervention
   strategies. The aim of this research is to compare the perceptions of
   the educational environment of academic achievers and under-achievers
   and to identify whether there is any gender difference in the
   perceptions. Methodology: This cross-sectional study was conducted at
   Sam Ratulangi University (UNSRAT) Faculty of Medicine using DREEM
   questionnaire. A total number of 105 medical students who were about to
   undertake Indonesia Medical Licensing Exam (IMLE) in February 2017
   participated in this study. Data were analyzed using SPSS. Item as well
   as scale scores were compared between academic achievers and
   under-achievers. Results: The students' perception towards educational
   environment was positive for the overall DREEM and all its five
   subscales. The overall median DREEM score of the academic
   under-achievers (136.00) was higher compared to the academic achievers
   (126.00). While comparing the gender-wise perceptions, the mean score
   for female students was found to be more positive. Conclusion: The study
   demonstrated that the perceptions of academic under-achievers were found
   to be significantly different from those of academic achievers. Using
   only learning environment alone as a predictor of performance on
   Indonesia Medical Licensing Exam (IMLE) is not adequate. This study can
   be used to re-evaluate the learning environment aspects which are not
   yet optimal and still need improvements using DREEM as the monitoring
   instrument.},
