Title = {Research on spatial resilience characteristics and response mechanism of
   Chengdu-Chongqing urban agglomeration based on power-law},
Booktitle = {INTERNATIONAL WORKSHOP ON GREEN ENERGY, ENVIRONMENT AND SUSTAINABLE
   DEVELOPMENT},
