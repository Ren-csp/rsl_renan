@inproceedings{ WOS:000247290100037,
Author = {Brody, S. D. and Zahran, S.},
Editor = {Kungolos, A and Brebbia, CA and Beriatos, E},
Title = {Examining the impact of the built environment on flood losses in Texas},
Booktitle = {Sustainable Development and Planning III, Vols 1 and 2},
