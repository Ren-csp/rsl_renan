@article{ WOS:000437991600013,
Author = {Li, Jizhe and Huang, Guohe and Liu, Lirong},
Title = {Ecological network analysis for urban metabolism and carbon emissions
   based on input-output tables: A case study of Guangdong province},
Journal = {ECOLOGICAL MODELLING},
Year = {2018},
Volume = {383},
Pages = {118-126},
