Title = {Satellite Imagery Data: Dynamic Systems Model for sustainable urban
   forest in area of Halim Perdana Kusuma, East Jakarta},
Booktitle = {1ST ITB CENTENNIAL AND 4TH PLANOCOSMO INTERNATIONAL CONFERENCE},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {158},
