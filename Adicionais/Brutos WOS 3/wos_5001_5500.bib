@article{ WOS:000240908900005,
Author = {Rolston, III, Holmes},
Title = {Caring for nature: What science and economics can't teach us but
   religion can},
Journal = {ENVIRONMENTAL VALUES},
Year = {2006},
Volume = {15},
Number = {3},
Pages = {307-313},
Month = {AUG},
Note = {Workshop on American Perspectives on Environmental Values, Princeton,
   NJ, MAY   02, 2005},
Abstract = {Neither ecologists nor economists can teach us what we most need to know
   about nature: how to value it. The Hebrew prophets claimed that there
   can be no intelligent human ecology except as people learn to use land
   justly and charitably. Lands do not flow with milk and honey for all
   unless and until justice rolls down like waters. What kind of planet
   ought we humans wish to have? One we resourcefully manage for our
   benefits? Or one we hold in loving care? Science and economics can't
   teach us that; perhaps religion and ethics can.},
