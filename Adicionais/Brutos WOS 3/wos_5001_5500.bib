@inproceedings{ WOS:000446989000003,
Author = {Tunji-Olayeni, P. F. and Amusan, L. M. and Ojelabi, R. A. and Abina, O.
   G.},
Book-Group-Author = {IOP},
Title = {Water conservation within planetary boundaries: residents' perception of
   recycled water use},
Booktitle = {2018 2ND INTERNATIONAL CONFERENCE ON ENVIRONMENTAL AND ENERGY
   ENGINEERING (IC3E 2018)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2018},
Volume = {146},
Note = {2nd International Conference on Environmental and Energy Engineering
   (IC3E), Xiamen Univ Technol, Xiamen, PEOPLES R CHINA, MAR 01-03, 2018},
Organization = {Int Soc Environm Informat Sci; Asia Pacific Inst Sci \& Engn},
Abstract = {Fresh water use is one of the nine planetary boundaries that must not be
   transgressed if the earth must continue to exist. Climate change has
   necessitated the need for conservation of natural resources, including
   fresh water. Infrastructure provision for recycling water is one thing:
   accepting to use the recycled water is another. This paper assessed
   residents' perception on recycled water use. It adopted a qualitative
   research design. Findings reveal that residents are willing to use
   recycled water, however, motivations of residents to use recycled water
   is different from the motivations suggested by the scientific community
   which focuses on climate change issues such as drought and conservation.
   The study recommends that water authorities should possess the required
   competencies for treating recycled water so that health risks associated
   with the use of recycled water can be minimized.},
