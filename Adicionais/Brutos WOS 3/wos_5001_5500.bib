Title = {The Research of the Construction and Evaluation Index System of Urban
   Ecological Civilization},
Booktitle = {INTERNATIONAL CONFERENCE ON FRONTIERS OF ENVIRONMENT, ENERGY AND
   BIOSCIENCE (ICFEEB 2013)},
Year = {2013},
Pages = {225-230},
Note = {International Conference on Frontiers of Environment, Energy and
   Bioscience (ICFEEB), Beijing, PEOPLES R CHINA, OCT 24-25, 2013},
Abstract = {Recently, the evaluation system of ecological civilization city has been
   a hot research topic both at home and abroad. This paper proposed a
   basic conception that, as a comprehensive evaluation index, the
   evaluation of ecological civilization city should be conducted through
   weighting the growth rate of the proportion of green GDP and the growth
   rate of urban residents' happiness index together to calculate the
   evaluation index of ecological civilization city. By doing so, combined
   with the existing theories, it is expected to construct an objective and
   scientific evaluation index system. It can also be used as an inference
   for assessing the development route of cities, conducting performance
   evaluation of urban management, promoting the implementation of
   governmental macro-strategic decisions and relevant development schemes.},
