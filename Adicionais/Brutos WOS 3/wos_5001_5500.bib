@article{ WOS:000234184700007,
Author = {Sergent, C and Dehaene, S},
Title = {Neural processes underlying conscious perception: Experimental findings
   and a global neuronal workspace framework},
Journal = {JOURNAL OF PHYSIOLOGY-PARIS},
Year = {2004},
Volume = {98},
