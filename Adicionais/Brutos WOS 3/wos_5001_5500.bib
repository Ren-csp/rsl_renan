@inproceedings{ WOS:000179444800068,
Author = {Gonduan, CK},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Housing indigenous Melanesian people in appropriate social \& cultural
   responsive housing in urban societies},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {533-541},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {Current state and private enterprise funded schemes in housing
   urbanizing indigenous Melanesian people are seen to ``overlook{''} the
   fundamental need of ``user{''} and ``interdisciplinary{''}
   participation. This has over the last 30 years resulted in
   ``ill-defined{''} solutions that are often divorced and
   ``non-responsive{''} to meaningful social and cultural
   ``transactional{''} issues that are central to everyday adaptation,
   adjustability, occupation, use and survival of rural-urban transiting
   people. Recent studies by the author identifies that Melanesian people
   though growing up in ``built-culture environments{''} are disoriented
   and/ or are handicapped in ``Westernized urban-housing{''} landscapes.
   The study reveals that given appropriate participatory opportunities the
   users are able to contribute meaningfully with greater proximate,
   choice, experiential and design ``control{''} on their part, aided with
   appropriate advisory input. Comparative analysis of the rural and urban
   analysis suggests that, where there was greater ``control{''} by the
   user on the housing situation in rural village societies, there was
   greater user flexibility, congruence, harmony and satisfaction.
   Comparatively where there was little and/or no control and participation
   by the user on housing situations in the formal urban housing sector,
   there was little and/or no flexibility, congruence, harmony and
   satisfaction thus, the users drew from their rural experiences to
   compensate for the lack and/or absence of desired spaces and facilities.
   The urban outcome demonstrates the inherent importance of the user's
   socio-cultural and survival value and its critical absence in the
   housing equation.},
Publisher = {WIDE DREAMS PROJECTOS MULTIMEDIA LDA},
