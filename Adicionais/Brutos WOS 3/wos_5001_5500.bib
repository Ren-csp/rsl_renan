Editor = {Akhssas, A and Baba, K and Bahi, L and Benradi, F and Cherkaoui, E and Khamar, M and Lahmili, A and Menzhi, M and Nounah, A and Ouadif, L},
Title = {Improvement of the consideration of seismic risks in Algerian planning
   and urban development instruments: application to the Boumerdes region
   (50km east of Algiers / Algeria).},
Booktitle = {SEVENTH INTERNATIONAL CONGRESS WATER, WASTE AND ENVIRONMENT (EDE7-2019)},
