@inproceedings{ WOS:000446989000079,
Author = {Poon, Stephen T. F.},
Book-Group-Author = {IOP},
Title = {Examining the Phenomenology of Human Experience in Design Process and
   Characteristics of Architectural Approaches},
Booktitle = {2018 2ND INTERNATIONAL CONFERENCE ON ENVIRONMENTAL AND ENERGY
   ENGINEERING (IC3E 2018)},
