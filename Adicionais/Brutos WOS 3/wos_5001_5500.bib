@article{ WOS:000257731500041,
Author = {Buck, Steven L. and Thomas, Laura P. and Connor, Cassandra R. and Green,
   Katelyn B. and Quintana, Tzire},
Title = {Time course of rod influences on hue perception},
Journal = {VISUAL NEUROSCIENCE},
Year = {2008},
