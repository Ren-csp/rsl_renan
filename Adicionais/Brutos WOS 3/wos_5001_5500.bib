@inproceedings{ WOS:A1996BJ20B00388,
Author = {Appelbaum, I},
Editor = {Bunnell, HT and Idsardi, W},
Title = {The lack of invariance problem and the goal of speech perception},
Booktitle = {ICSLP 96 - FOURTH INTERNATIONAL CONFERENCE ON SPOKEN LANGUAGE
   PROCESSING, PROCEEDINGS, VOLS 1-4},
Year = {1996},
Pages = {1541-1544},
Note = {4th International Congress on Spoken Language Processing, PHILADELPHIA,
   PA, OCT 03-06, 1996},
Organization = {Univ Delaware; Alfred I DuPont Inst; Acoust Soc Amer; Acoust Soc Japan;
   Amer Speech Language Hearing Assoc; Austr Speech Sci \& Technol Assoc;
   European Speech Commun Assoc; IEEE Signal Proc Soc; Inc Canadian Acoust
   Assoc; Int Phonet Assoc; Linguist Soc Amer},
Abstract = {The overall goal of speech perception research is to explain how Spoken
   language is recognized and understood. In the current research framework
   it is usually assumed that the key to achieving this overall goal is to
   solve the lack of invariance problem. But nearly half a century of
   sustained effort in a variety of theoretical perspectives has failed to
   solve this problem. It is argued that this lack of progress in
   explaining speech perception is not, in the first instance, due to the
   failure of individual theories to solve the lack of invariance problem,
   brit rather to the common background assumption that doing so is in fact
   the key to explaining speech perception.},
