@article{ WOS:A1994NA44400002,
Author = {BHATT, RS and ROVEECOLLIER, C},
Title = {PERCEPTION AND 24-HOUR RETENTION OF FEATURE RELATIONS IN INFANCY},
Journal = {DEVELOPMENTAL PSYCHOLOGY},
Year = {1994},
Volume = {30},
Number = {2},
Pages = {142-150},
Month = {MAR},
Note = {Meeting of the Eastern-Psychological-Association, BOSTON, MA, APR, 1992},
Organization = {E PSYCHOL ASSOC},
Abstract = {The study examined whether the perception and retention of feature
   relations, thought to be critical for object recognition in adults, are
   evident early in infancy, Three-month-olds' 24-hr retention was
   disrupted when correlated features were recombined, indicating that they
   not only encode feature relations but also remember them for substantial
   periods of time. However, relations involving the relative location of
   features within objects were forgotten earlier than those that
   differentiated between objects: Infants exhibited adultlike `'illusory
   conjunctions'' by generalizing to a figure-ground color reversal after a
   delay when they were still discriminating between-objects
   recombinations. This research contradicts claims that young infants are
   insensitive to correlated attributes and suggests that the ability to
   answer the 2 fundamental questions of perception, `'what'' and
   `'where,'' is evident early in infancy.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
