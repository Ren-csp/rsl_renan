@article{ WOS:A1995TV36400013,
Author = {Thompson, RKR and Oden, DL},
Title = {A profound disparity revisited: Perception and judgment of abstract
   identity relations by chimpanzees, human infants, and monkeys},
Journal = {BEHAVIOURAL PROCESSES},
Year = {1995},
Volume = {35},
