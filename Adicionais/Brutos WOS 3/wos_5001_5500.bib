@inproceedings{ WOS:000377577200015,
Author = {Bergillos, Rafael J. and Ortega-Sanchez, Miguel and Masselink, Gerd and
   Losada, Miguel A.},
Editor = {Ozhan, E},
Title = {Urban Planning Analysis of Mediterranean Deltas - Guadalfeo Case Study},
Booktitle = {TWELFTH INTERNATIONAL CONFERENCE ON THE MEDITERRANEAN COASTAL
   ENVIRONMENT (MEDCOAST 15), VOLS 1 AND 2},
Year = {2015},
Pages = {143-154},
Note = {12th International Conference on the Mediterranean Coastal Environment
   (MEDCOAST), Varna, BULGARIA, OCT 06-10, 2015},
Organization = {Mediterranean Coastal Fdn; Inst Oceanol; Inst Fish Resources; Republ
   Turkey, Promot Fund},
Abstract = {Deltaic systems are sensitive to natural and human-induced changes as
   they accommodate numerous activities and have high ecological, economic,
   and social value. Mediterranean deltas are particularly vulnerable to
   anthropogenic activities and to the sea-level rise, which are altering
   the availability of coastal land. This work addresses the urban and
   morphological evolution of the Guadalfeo Delta (southern Spain) by means
   of the analysis of the evolution of the built area and the coastline
   position. The impact of the river damming on the coast was also studied
   through topographic and bathymetric measurements, and through analysis
   of fluvial and maritime data. A diagnosis of the situation was also
   carried out by means of SWOT (Strengths, Weaknesses, Opportunities y
   Threats) analysis and management practices were proposed based on the
   modification of the SWOT analysis. Our results indicate the river
   damming has considerably reduced the sediment input into the coastal
   system and has prevented the advance of a delta that was prograding
   before the construction of the dam, inducing a severe coastline retreat
   and endangering the urban developments near the river mouth. It is
   concluded that moving housing structures away from the coast back to
   favour the existence of coasts capable of absorbing the sea level-rise
   and the action of storms is the best strategy to face erosion problems
   of many Mediterranean deltas.},
