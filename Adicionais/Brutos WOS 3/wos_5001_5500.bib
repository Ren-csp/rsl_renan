Note = {3rd International Conference on Sustainable Development and Planning,
   Algarve, PORTUGAL, APR 25-27, 2007},
Organization = {Wessex Inst Technol; Univ Thessaly; WIT Transact Built Environm; ASCE UK
   Int Grp},
Abstract = {The principles of New Urbanism advocate a form of urban development that
   incorporates higher densities, mixed uses and I pedestrian (rather than
   an automobile) oriented public realm. This paradigm is quite distinct
   from the typical suburban pattern of development that prevails in most
   of North America. Residents in two New Urban communities were surveyed
   on their relative levels of satisfaction with those characteristics of
   their neighbourhoods that set these places apart from the surrounding
   areas. This research suggests that there is considerable support for
   most elements of New Urbanism; satisfaction levels were not, however,
   significantly higher among residents of the development that was more
   consistent with New Urban principles.},
