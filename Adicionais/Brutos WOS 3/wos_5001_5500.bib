Title = {An ecological analysis of the composition and condition of woody plants
   in urban and suburban ecosystems of the Khopyor River Region},
Booktitle = {2ND INTERNATIONAL SCIENTIFIC CONFERENCE AGRIBUSINESS, ENVIRONMENTAL
   ENGINEERING AND BIOTECHNOLOGIES ( AGRITECH-II-2019)},
