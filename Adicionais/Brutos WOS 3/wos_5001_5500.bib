@inproceedings{ WOS:000165332800020,
Author = {Schneider, I and LaPointe, C and Stievater, S},
Editor = {Cole, DN and McCool, SF and Borrie, WT and OLoughlin, J},
Title = {Perceptions of and preferences for fee program dollar utilization among
   wilderness visitors},
Booktitle = {WILDERNESS SCIENCE IN A TIME OF CHANGE CONFERENCE, VOL 4: WILDERNESS
   VISTORS, EXPERIENCES, AND VISITOR MANAGEMENT},
Series = {USDA FOREST SERVICE ROCKY MOUNTAIN RESEARCH STATION PROCEEDINGS},
