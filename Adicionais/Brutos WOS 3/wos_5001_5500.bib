@inproceedings{ WOS:001195949100031,
Author = {Dair, Zachary and Dockray, Samantha and O'Reilly, Ruairi},
Book-Group-Author = {IEEE},
Title = {Complex Adaptive Systems and Psychophysiological Data - An Exploratory
   Approach},
Booktitle = {2023 31ST IRISH CONFERENCE ON ARTIFICIAL INTELLIGENCE AND COGNITIVE
   SCIENCE, AICS},
Year = {2023},
Note = {31st Irish Conference on Artificial Intelligence and Cognitive Science
   (AICS), Letterkenny, IRELAND, DEC 07-08, 2023},
Abstract = {The diverse nature of emotion models presents challenges in
   psychophysiological analysis, notably affecting the comparability and
   reliability of research findings across studies. This exploratory work
   aims to address the diversity of emotion models by abstracting them into
   a higher-order perspective while preserving the specificity of the
   original emotions. This will be accomplished by integrating Complex
   Adaptive Systems utilising their inherent interactivity to foster rich
   interactions between different emotion models, adaptability to adjust to
   the nuances of each model, and self-organisation to autonomously form a
   coherent understanding of diverse emotional data. By analysing
   interactions within the system, this study aims to identify abstract
   emotion representations that capture dynamic patterns in physiological
   data that indicate emotional states. Combining these dynamic patterns
   with an analysis of system interactions offers a novel perspective in
   emotion modelling.},
