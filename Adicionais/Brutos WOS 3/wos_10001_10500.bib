@article{ WOS:000244562800018,
Author = {Pereira, M. C. and Santos, R. C. and Alvim-Ferraz, M. C. M.},
Title = {Air quality improvements using European environment policies:: A case
   study of SO2 in a coastal region in Portugal},
Journal = {JOURNAL OF TOXICOLOGY AND ENVIRONMENTAL HEALTH-PART A-CURRENT ISSUES},
Year = {2007},
Volume = {70},
Number = {3-4},
Pages = {347-351},
