@inproceedings{ WOS:000179444800133,
Author = {Masztalski, R and Trocka-Leszczynska, E},
Editor = {Ural, O and Abrantes, V and Tadeu, A},
Title = {Universalism of public space},
Booktitle = {XXX IAHS WORLD CONGRESS ON HOUSING, HOUSING CONSTRUCTION: AN
   INTERDISCIPLINARY TASK, VOLS 1-3},
Year = {2002},
Pages = {1075-1080},
Note = {30th IAHS World Congress on Housing, UNIV COIMBRA, COIMBRA, PORTUGAL,
   SEP 09-13, 2002},
Organization = {Int Assoc Housing Sci},
Abstract = {The traditional place of locating the public space is the centre of
   town. Terrains of town centres are in present moment subject of gradual
   atrophying of their commercial-and-service tissue and fall of their
   business attractiveness for potential investors. Instead the phenomenon
   of spilling of commercial-and-service centres on edges of town grows.
   New scenery of urbanized terrain, which rises all around existing
   municipal agglomerations, is often homogeneous space, without
   compositional accents, scenic locks or clearly sketched central points.
   In instant pace grows degradation of public spaces based on unification
   of project foundations and pauperisation of space-and-scenery value of
   architectural and town-planning objects realized there. All new public
   spaces are similar in some way one to the other. We can name it the
   effect of progressive process of the world globalisation or also the
   effect of the growth of ``third wave{''} civilization. But is such
   direction of transformations of architecture-and-town-planning's ideas
   of public town space inevitable? Can't we defend the idea of forming the
   public space in individual way for given city, in central points of
   housing's colonization, and not exclusively on the outskirts? The town's
   public space is a wide-accessible cultural space, created for centuries
   by streets, squares, boulevards, parks and different kind of
   trade-and-service objects. It is making the identity of town. Are we
   sentenced exclusively onto model of universal multipurpose
   trade-and-service structures, pretending to be and trying to replace the
   public space of town centre, and moreover being the property of private
   businessmen and not a cultural heritage of municipal powers?.},
