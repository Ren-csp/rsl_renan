@inproceedings{ WOS:000566256100069,
Author = {Rodriguez, Judith},
Editor = {Chester, MV and Norton, M},
Title = {Transformational Change through Leadership: Lessons from the First
   Electric Metro Line in Lima},
Booktitle = {INTERNATIONAL CONFERENCE ON SUSTAINABLE INFRASTRUCTURE 2019: LEADING
   RESILIENT COMMUNITIES THROUGH THE 21ST CENTURY},
Year = {2019},
Pages = {642-651},
Note = {International Conference on Sustainable Infrastructure, Los Angeles, CA,
   NOV 06-09, 2019},
Organization = {Amer Soc Civil Engineers, Comm Sustainabil},
Abstract = {There are leadership lessons to learn from the implementation and
   operation of Lima Metro Line 1, which facilitated a transformational
   change along its transit corridor. Line 1 is the first electric metro in
   Lima, the fifth largest and densest city in Latin America, and it
   reduces traffic volumes, air pollution, carbon footprints, and commuting
   times, which impact positively the environment and the productivity
   level in the city. This study is based on the infrastructure
   sustainability performance of Line 1, as assessed with the Envision
   rating system as part of the Infrastructure 360 degrees Awards, where it
   received the project of the year award for most comprehensive
   sustainability performance. Many of Line 1 successes and high
   sustainability performance are funded by the implementation of social
   investment through the ``Cultura Metro{''} initiative. This initiative
   is leading social inclusion programs in stations, and enhancing public
   spaces along the transit corridor, improving the quality of life for
   millions of people. Findings from this study indicate that the social
   investment has paid off in the community buy-in and ridership. This
   study contributes to the dissemination of lessons learned in sustainable
   leadership from Line 1, which can influence policy and innovations in
   public transportation infrastructure for zero carbon cities. The lessons
   from Line 1 can facilitate more transformational change in Lima, which
   is currently planning more metro lines, and in other cities in
   developing contexts, especially in regards to quality of life
   enhancements with emphasis in improving public space, urban security,
   and the environment.},
