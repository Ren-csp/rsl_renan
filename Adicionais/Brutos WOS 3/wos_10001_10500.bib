Web-of-Science-Categories  = {Psychology, Experimental},
Author-Email = {kevin.holmes@emory.edu
   pwolff@emory.edu},
Affiliations = {Emory University},
ResearcherID-Numbers = {Holmes, Kevin/AEJ-8579-2022},
Funding-Acknowledgement = {William Orr Dingwall Foundation Neurolinguistics Fellowship},
Funding-Text = {The authors wish to thank Larry Barsalou, Stella Lourenco, Laura Namy,
   Marjorie Pak, and Grace Song for helpful discussion, and Tonia Davis,
