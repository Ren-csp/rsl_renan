Title = {THE PERCEPTION OF SUBJECT COORDINATORS' DIFFICULTIES IN THE SUBJECT
   COORDINATOR'S ROLE},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
