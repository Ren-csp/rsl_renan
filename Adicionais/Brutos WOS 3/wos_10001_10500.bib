@inproceedings{ WOS:000454737900131,
Author = {Baa, Sultan},
Book-Group-Author = {IOP},
Title = {Lecturer Perceptions toward the Teaching of Mathematics using English as
   a Medium of Instruction at the International Class Program (ICP) of
   Mathematics Department of the State University of Makassar},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON STATISTICS, MATHEMATICS, TEACHING, AND
   RESEARCH 2017},
Series = {Journal of Physics Conference Series},
Year = {2018},
Volume = {1028},
Note = {2nd International Conference on Statistics, Mathematics, Teaching, and
   Research (ICSMTR), Makassar, INDONESIA, OCT 09-10, 2017},
Organization = {UNM, Math \& Nat Sci Fac},
Abstract = {The objectives of the study were to find out the lecturers perception
   on: (1) the teaching and learning of mathematics using English as medium
   of instruction (EMI) at the International Class Program (ICP) of
   Mathematics Department of the State University of Makassar (UNM); (2)
   their students' English achievement after joining in the ICP program.
   The study applied qualitative research design. Interview was used to
   collect data. The participants were five lecturers from Mathematics
   Department. They were all mathematics lecturers (non-English lecturers)
   and most of them have limited English proficiency. The data were
   analyzed using Miles and Huberman's qualitative data analysis. The study
   found that despite many constraints have been found in the program
