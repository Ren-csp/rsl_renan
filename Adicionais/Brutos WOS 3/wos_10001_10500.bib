@article{ WOS:000175238700016,
Author = {Buxton, A and Tait, S and Stovin, V and Saul, A},
Title = {Developments in a methodology for the design of engineered invert traps
   in combined sewer systems},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2002},
Volume = {45},
Number = {7},
Pages = {133-142},
Note = {4th International Conference on Innovative Technologies in Urban
   Drainage (NOVATECH 2001), LYON, FRANCE, JUN 25-27, 2001},
Abstract = {Sediments within sewers can have a significant effect on the operation
   of the sewer system and on the surrounding natural and urban
   environment. One possible method for the management of sewer sediments
   is the use of slotted invert traps. Although invert traps can be used to
   selectively trap only inorganic bedload material, little is known with
   regard to the design of these structures. This paper presents results
   from a laboratory investigation comparing the trapping performance of
   three slot size configurations of a laboratory-scale invert trap, The
   paper also presents comparative results from a two-dimensional
   computational model utilising stochastic particle tracking, This
   investigation shows that particle tracking consistently over-predicts
   sediment retention efficiencies observed within the laboratory model.},
