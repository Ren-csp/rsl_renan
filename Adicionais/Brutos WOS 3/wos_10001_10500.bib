Pages = {65-74},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {This paper presents the results of investigating the feasibility of
   establishing specialized bus transit for high school students after
   school hours, patients, and retirement home residents in an urban area
   involving two cities in California, USA. Data on travel demands and
   patterns for the three groups in the study area was gathered through
   various methods and limited field observations were made. Various groups
   were contacted for their input; 1219 high school students, 132 junior
   high students, for comparison purposes 327 patients, 134 retirement home
   residents, 15 transportation officials and consultants, 7 malls, 11
   churches, bus drivers and 320 parents of the students. Some of these
   groups represented the destinations where the three target groups might
   want to go. Others represented the facilities where waiting areas might
   be established for the new system. The study area was Fremont/Newark
   (California, USA) where eight high schools, two major medical centers,
   and eleven retirement homes are located.},
