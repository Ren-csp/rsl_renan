Title = {Local Knowledge About The Structure, Function And Conversion Of
   Landscape In The Karangwangi Village, Cianjur, West Java, Indonesia},
Booktitle = {2ND INTERNATIONAL SYMPOSIUM FOR SUSTAINABLE LANDSCAPE DEVELOPMENT},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2017},
