Organization = {Xinjiang Univ; Hebei United Univ},
Abstract = {Resource-based city has many characteristics of urban sustainable
   development, but because of resource's gradual depletion, population
   explosion and the depravation of natural ecological environment, it is
   more special in the road of sustainable development. The sustainable
   development of resource-based city has more urgency, complexity and
   difficulty, so traditional linear model of economic development has been
   unable to realize its sustainable development. Building on circular
   economy characterized by closing material cycle, to achieve the harmony
   of human and nature, the economic development and environment protection
   win-win strategy goal is an inevitable trend.},
