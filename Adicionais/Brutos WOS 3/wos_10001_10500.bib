@inproceedings{ WOS:000073159500010,
Author = {Singh, RB and Micallef, A and Colls, JJ},
Editor = {Sucharov, L and Bidini, G},
Title = {Development, application and implementation of a fuel consumption model
   for the European vehicle fleet},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {105-114},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {This paper discusses the development, application and implementation of
   FUELFAC, a computer model for the prediction of fuel consumption factors
   for the European vehicle fleet. FUELFAC calculates fuel consumption
   factors from input parameters which include vehicle speed, road type
   i.e. urban, rural or motorway (used for determining the length of trip
   associated with different driving cycles) and road geometry (e.g.
   slope), ambient temperature, vehicle fleet classification and signal
   phasing traffic flow details at road junctions (to model the different
   operational driving modes at signalised intersections). The model is
   designed to cater for different forms of available input data relating
   to the vehicle fleet. It can be used to calculate thermal
   vehicle-generated turbulence for use in turbulence sub-models within
   microscale dispersion models. Another application is in estimating the
   vehicle SO2 emission rate, from which the SO2 to particulate SO4
   conversion can then be modelled to take into account secondary sulphate
   particles. Both applications are discussed in detail in this paper, with
   emphasis on their implementation in dispersion models for
   vehicle-generated particles. The results of a brief experimental
   programme carried out in a street in Loughborough, UK are presented.},
Publisher = {COMPUTATIONAL MECHANICS PUBLICATIONS LTD},
