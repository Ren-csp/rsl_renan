@article{ WOS:A1996VZ84100057,
Author = {Weinstein, A and Patterson, KM and Rao, S},
Title = {Hemispheric asymmetries and processing of affective stimuli:
   Contribution of callosal communication},
Journal = {BRAIN AND COGNITION},
Year = {1996},
Volume = {32},
Number = {2},
Pages = {223-226},
Month = {NOV},
Note = {TENNET VII - Theoretical and Experimental Neuropsychology, UNIV QUEBEC
   MONTREAL, MONTREAL, CANADA, AUG 14-16, 1996},
Abstract = {This study examined negative and positive perception and expression of
   emotional facial and vocal stimuli in multiple sclerosis patients in an
   attempt to understand cognitive components underlying emotional
   experience. Twenty-six MS patients and normal controls were compared on
   experimental measures designed to evaluate vocal and facial emotional
   processing. MS patients exhibited deficits on both visual and auditory
   measures of emotion identification with greater impairment for negative
   emotional stimuli. Perceptual discrimination and emotional expression
   were unimpaired. Deficits in emotional identification and negative
   valance highlight the concepts of hemispheric asymmetries in valence
   related nonverbal affective processing and callosal contribution to
   emotional processing.},
