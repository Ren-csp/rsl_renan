@article{ WOS:000234618100006,
Author = {Greening, L and Chandler, CC and Stoppelbein, L and Robison, LJ},
Title = {Risk perception: Using conditional versus general base rates for risk
   communication},
Journal = {JOURNAL OF APPLIED SOCIAL PSYCHOLOGY},
Year = {2005},
Volume = {35},
Number = {10},
Pages = {2094-2122},
Month = {OCT},
Note = {72nd Annual Meeting of the Midwestern-Psychological-Association,
   CHICAGO, IL, MAY 02-04, 2000},
Organization = {Midwestern Psychol Assoc},
Abstract = {in general, people judge their chance of experiencing a health risk as
   being less than the general base rate because of their favorable status
   on risk factors (e.g., history of stroke). Presenting base rates for
   high and low risk groups (conditional base rates) were hypothesized to
   lessen people's tendency to adjust downward from the base rate because
   risk factors are included in conditional base rates (CBRs). Young (M =
   19 years) and older women (M = 46 years) were presented with either a
   general base rate (GBR) or CBRs for high- and low-risk groups for 5
   health risks. The CBR groups were significantly less likely to adjust
   their probability judgments from the base rate for the risk group that
   they believed applied to them (e.g., smoker vs. nonsmoker). The CBR
   effect was replicated in a second experiment in which women (M = 19
   years) were informed of either a GBR, a CBR for a high-risk group, or a
   CBR for a low-risk group. The findings suggest that people might
   estimate subjective probabilities by considering both the base rate for
   a health risk and self-assessments on risk factors. Biases about one's
   status on risk factors, however, may limit people's identification with
   relevant risk groups and warrant further investigation.},
