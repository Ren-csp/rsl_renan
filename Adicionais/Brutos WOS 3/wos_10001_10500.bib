@inproceedings{ WOS:000079630400190,
Author = {Sakai, K and Tanaka, S},
Editor = {Usui, S and Oori, T},
Title = {Perception of global orientation - Psychophysical and computational
   analyses on tilt illusion},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {827-830},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {We investigate cortical mechanisms underlying tilt illusion which is the
   misjudgment of bar orientation at the presence of another intersecting
   bar. We examined psychophysically how the difference in perceptual
   segmentation affects the amount of apparent tilt. The result showed that
   what neuronal populations are functionally grouped together to detect
   global orientations of bars. We propose a model for tilt illusion
   consisting of a V1 network preserving retinotopy and a mechanism for
   grouping the activities of V1 neurons. Grouping V1 neurons based on the
   psychophysical finding, the model reproduces the apparent global
   orientations of the bars in good quantitative agreement with results of
   comparable psychophysical experiments reported previously. The results
   indicate that tilt illusion is originated from the strong activation of
   a population of cells selective to orientations other than the actual
   bar orientaions, which is caused by the convolution of a Gabor-type
   receptive field and a part of bar junction projected on to it.},
