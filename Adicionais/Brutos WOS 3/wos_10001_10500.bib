@article{ WOS:000342453100005,
Author = {Alier, M. and Osto, M. Dall and Lin, Y. -H. and Surratt, J. D. and
   Tauler, R. and Grimalt, J. O. and van Drooge, B. L.},
Title = {On the origin of water-soluble organic tracer compounds in fine aerosols
   in two cities: the case of Los Angeles and Barcelona},
Journal = {ENVIRONMENTAL SCIENCE AND POLLUTION RESEARCH},
Year = {2014},
Volume = {21},
