@article{ WOS:000078240100011,
Author = {Haworth, A and Manzi, T},
Title = {Managing the `underclass': Interpreting the moral discourse of housing
   management},
Journal = {URBAN STUDIES},
Year = {1999},
Volume = {36},
Number = {1},
Pages = {153-165},
Month = {JAN},
Note = {Conference on Discourse and Urban Change, UNIV GLASGOW, GLASGOW,
   SCOTLAND, 1997},
Abstract = {This paper examines contemporary housing management practice by
   attention to a changing discourse within social policy, emphasising
   duties over rights. Current policy initiatives are based upon concerns
   about the collapse of foundational assumptions and a perceived decline
   in moral responsibility. This concern is most commonly articulated in
   debates about the existence of an urban underclass, linked to
   anti-social behaviour on housing estates. The paper argues that a
   communitarian outlook has exerted a significant impact on contemporary
   initiatives incorporating a strongly judgmental bias. As a consequence,
   housing practice discriminates between behaviour in social housing and
   privately owned property. Drawing upon post-liberal perspectives, the
   conclusion suggests that the predominance of a deontological discourse
   has resulted in policies of social control of residents.},
