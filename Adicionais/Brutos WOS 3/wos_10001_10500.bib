@article{ WOS:000078645400007,
Author = {Kosc, M and Jariabková, K},
Title = {Rey-Osterrieth Complex Figure:: Ways of investigating cognitive
   processes},
Journal = {STUDIA PSYCHOLOGICA},
Year = {1998},
Volume = {40},
Number = {4},
Pages = {266-270},
Note = {Conference on Cognitive Processes - Personality - Social Behavior,
   BRATISLAVA, SLOVAKIA, SEP 30-OCT 01, 1998},
Organization = {Slovak Acad Sci, Inst Exptl Psychol; Slovak Acad Sci, Inst Social Sci},
Abstract = {The Rey-Osterrieth Complex Figure (ROCF) by A. Rey (1941) and P.-A
   Osterrieth (1944), belongs to the group of visuo-motor tests. In the
   more than a half a century since its existence, the ROCF has been used
   in clinical research of visuo-perceptual and visual memory processes
   concentrating, for example, on brain damage, disorders of personality
   but it is also used in research of the development of visual perception
   and memory. The analysis results of the scores of 18 elements of the
   ROCF and a comparison of the copy and memory productions in a group of
   subjects aged 8-13 yrs. are presented. Possibilities of studying
   cognitive processes by means of the ROCF are discussed.},
