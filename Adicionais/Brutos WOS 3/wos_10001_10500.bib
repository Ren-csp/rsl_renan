@inproceedings{ WOS:000270107401004,
Author = {Zhang, Yu and Meng, Qinglin},
Editor = {Zhang, Q and Leung, M and Wang, XK and Liu, YJ and Mo, JH},
Title = {AN EXPERIMENTAL STUDY OF CLIMATIC EVAPORATION OF POROUS MATERIAL IN A
   WIND TUNNEL},
Booktitle = {FIFTH INTERNATIONAL WORKSHOP ON ENERGY AND ENVIRONMENT OF RESIDENTIAL
   BUILDINGS AND THIRD INTERNATIONAL CONFERENCE ON BUILT ENVIRONMENT AND
   PUBLIC HEALTH, VOL I AND II, PROCEEDINGS},
Year = {2009},
Pages = {1315-1322},
Note = {5th International Workshop on Energy and Environment of Residential
   Buildings/3rd International Conference on Built Environment and Public
   Health, Guilin, PEOPLES R CHINA, MAY 29-31, 2009},
Organization = {Hunan Univ; Univ Hong Kong; Tsinghua Univ},
Abstract = {After rainfall, in the natural climatic elements: solar radiation, air
   temperature, humidity and wind speed integrated role, the moisture in
   city construction and environmental porous material will be gradually
   moved to the material layer on the surface, which makes the surrounding
   environment a passive evaporative cooling effect, and reduce urban heat
   island intensity In previous studies, field testing is generally the
   method to evaluate the porous materials cooling effect with temperature,
   heat flux and energy difference. But there were still a few questions:
   First, in different countries, different climatic environment, the
   results were not comparable; Secondly, as a computed result that can not
   participate in the dynamic heat and moisture balance computation with
   hourly changed climatic parameters.
   In this paper, to solve the above problems, a hot-humid climatic wind
   tunnel using wind tunnel technology was developed to simulate the true
   outdoor dynamic climatic parameters, including solar radiation, air
   temperature, relative humidity and wind speed, to realize a small-step
   periodic changing climatic environment of a particular area. To obtain
   atmospheric evaporation force of porous material, firstly, water
   evaporation experiment representing the impact of climatic elements with
   atmospheric evaporation force was carried out, then a Penman formula
   based water evaporation experimental model was built. Considered to
   different texture of materials, different beginning times and different
   climatic parameters, porous material evaporation experiments were
   carried out and a experimental model was established.},
Publisher = {HUNAN UNIV, COLLEGE CIVIL ENGINEERING},
Address = {C/O PROF QUAN ZHANG, EERB-BEPH 2009, CHANGSHA, HUNAN, 410082, PEOPLES R
