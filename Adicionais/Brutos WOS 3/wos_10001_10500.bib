@inproceedings{ WOS:001326809000048,
Author = {Pal, Chandana and Singh, Anula Divyash and Rani, Anitha and Nagalla,
   Balakrishna and Swaminathan, Jayanthi and Rengan, Aravind Kumar},
Editor = {Costin, HN and Magjarevic, R and Petroiu, GG},
Title = {The Impact of Effective Medical Record Keeping in Shaping Clinical Site
   Perceptions},
