@inproceedings{ WOS:000618955400091,
Author = {Harlanova, Elena and Sivrikova, Nadezhda and Popova, Inna S. and
   Lapaeva, Ekaterina A.},
Editor = {Abakumova, IV and Vorobyova, EV},
Title = {High school students' perception of bullying as a phenomenon of group
   action},
Booktitle = {TRENDS IN THE DEVELOPMENT OF PSYCHO-PEDAGOGICAL EDUCATION IN THE
   CONDITIONS OF TRANSITIONAL SOCIETY (ICTDPP-2019)},
Series = {SHS Web of Conferences},
Year = {2019},
Volume = {70},
Note = {International Conference on Trends in the Development of
   Psycho-Pedagogical Education in the Conditions of Transitional Society
   (ICTDPP), Don State Tech Univ, Fac Psychol Pedag \& Defectol, Rostov on
   Don, RUSSIA, NOV 22-23, 2019},
Abstract = {Bullying is a dangerous phenomenon that affects many modem students
   around the world. Bullying destructively affects a person regardless of
   the role (aggressor, observer, victim) and, despite measures to
   overcome, is present at school. Bullying (from the point of view of the
   contextual approach) is a social-group phenomenon that accompanies the
   development of a group with an unconstructive deformation of
   relationships in it. We conducted a research that reveals how Russian
   students are prone to bullying, how (taking into account gender and
   experience of it) are aware of its causes, who can stop bullying and
   whom they are ready to turn for help to if they become observers or
   victims of bullying. The results of the study showed that 46.8\% of
   students felt oppressed during the school year (2018-2019). Students
   realize that the school class can stop bullying, but in a bullying
   situation they turn to parents, teachers, less to friends, do not
   mention the school class.},
