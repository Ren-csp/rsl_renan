@article{ WOS:000383113900139,
Author = {Lee, Hyeon-Woo},
Title = {Class Voting in Korean Politics: Matter of Differences in Political
   Parties},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2016},
Volume = {22},
Number = {5-6, SI},
Pages = {1673-1676},
Month = {MAY-JUN},
Note = {International Symposium on Social Sciences, Arts and Humanities
   (SYSSARM), Bali, INDONESIA, SEP 29-OCT 01, 2015},
Abstract = {The theory of class voting has been rejected in Korean elections because
   of lack of evidence. This paper focuses on the conditions for class
   voting. They are the cause of poverty, class homogeneity, the perception
   of party differences, and evaluation of party ability to deal with
   current problems. Empirical results display that distribution of reasons
   for poverty varies according to the respondents' economic status and
   that they have different feeling thermometers to other economic groups.
   Even though more than 67\% of the respondents recognize different party
   position on economic issues, less than 20\% of them agree the argument
   that the political parties represent their interest. Only one of three
   of them thinks that the political parties have different ability to cope
   with important national problems.},
