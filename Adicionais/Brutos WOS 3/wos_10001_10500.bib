Note = {Annual Meeting of the Rocky-Mountain-Psychological-Association, Phoenix,
   AZ, APR, 2005},
Organization = {Rocky Mt Psychol Assoc},
Abstract = {As growing numbers of youth in the United States play video games,
   potential effects of game playing are being considered. We focused on
   gender-related aspects of gaming in a study of 206 college students. Men
   were significantly more likely than women to play video games two or
   more hours a week and to indicate that video game playing interfered
   with sleeping and with class preparation. A greater proportion of women
   than men complained about the amount of time their significant other
   played video games. Participants rated female video game characters as
   significantly more helpless and sexually provocative than male
   characters and as less likely to be strong and aggressive. Gender
   differences in participation and character portrayals potentially impact
   the lives of youth in a variety of ways.},
