@inproceedings{ WOS:000257236400025,
Author = {Mera, J. M. and Gomez-Rey, I. and Campos, A.},
Editor = {Brebbia, CA},
Title = {ERTMS/ETCS test simulation bench},
Booktitle = {URBAN TRANSPORT XIII: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {WIT Transactions on the Built Environment},
