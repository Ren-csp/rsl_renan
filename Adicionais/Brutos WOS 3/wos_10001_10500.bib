@article{ WOS:000619181900003,
Author = {Plews-Ogan, Margaret L. and Bell, Taison D. and Townsend, Gregory and
   Canterbury, Randolph J. and Wilkes, David S.},
Title = {Acting Wisely: Eliminating Negative Bias in Medical Education-Part 1:
   The Fundamentals},
Journal = {ACADEMIC MEDICINE},
