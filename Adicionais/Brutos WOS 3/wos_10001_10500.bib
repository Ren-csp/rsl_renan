Title = {RETRACTED: Perennial Trends of Wastewater Discharge and Pollutant
   Content in Rivers of Shanghai (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
Series = {Energy Procedia},
Year = {2011},
Volume = {11},
Pages = {2428-2432},
Note = {International Conference on Energy and Environmental Science (ICEES),
   Singapore, SINGAPORE, OCT, 2011},
Organization = {Singapore Inst Elect (SIE)},
Abstract = {Water Environment in Shanghai got more and more attentions. The hotspots
   are wastewater discharge and pollutant content in Changjiang and Huangpu
   rivers. From 1981 to 2009, the city wastewater discharge was fluctuated
   between 1800{*}10(6) ton and 2400{*}10(6) ton. Inside, the gross of
   industrial wastewater was trendily decreasing from more than
   1300{*}10(6) ton at 1980s to about 700{*}10(6) ton recently years. The
   percent of industrial wastewater was decreasing continuously from
   76.88\% at 1981 to 28.42\% at 2009. The gross of living wastewater was
   increasing trendily, it related with increasing of city population. In
   the same period, the living wastewater per year for per person was
   increasing from about 37 ton at the beginning of 1980s to 80 ton at
   recent year, about 1.2 times increasing in past 30 years. The month flux
   of chemical pollutant discharged by Changjiang River was between
   259{*}10(3) ton to 2096{*}10(3) ton in recently years. The average
   pollutant gross carried by Changjiang River in year, was about
   5934.5{*}10(3) ton among 2002 to 2009; about 83.68\% was COD. Other
   pollutants were nutrients, oil, heavy metal and arsenic, the variability
   was larger with year. The month flux of pollutant carried by Huangpu
   River was 25.6{*}10(3) ton, more than 63\% was COD averagely. The
   pollutant gross had an increasing trend year by year. Generally, the
   percent of pollutant from Huangpu River was about 3.6 to 4.4\% compared
   with that in Changjiang River. (C) 2011 Published by Elsevier Ltd.
   Selection and/or peer-review under responsibility of the Organizers of
   2011 International Conference on Energy and Environmental Science.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
