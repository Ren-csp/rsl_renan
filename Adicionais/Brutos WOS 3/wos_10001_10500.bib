@inproceedings{ WOS:000073159500024,
Author = {Spit, A and Leidelmeijer, KCM and Jorritsma, P},
Editor = {Sucharov, L and Bidini, G},
Title = {`Traffic sustainable' residential areas in the Netherlands; bottlenecks
   and incentives},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {265-274},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {Traffic-sustainable residential areas are designed to enhance safety and
   environmental conditions. In addition, they are expected to contribute
   to diminishing the growth of the use of private cars. In the past few
   years, several initiatives were taken to design, study and develop such
   residential areas in the Netherlands. However, considering their
   potential environmental advantages and the way they may contribute to
   the quality of residential areas, it should be noted that the number of
   initiatives is quite small and the measures taken not too ambitious.
   In order to examine why the attention for traffic sustainable
   residential areas is limited, we studied several residential areas in
   the process of being designed and/or built. We mainly focused on the
   role of the municipalities and project-developers, being the parties
   deciding on how particular areas are actually given shape.
   The result of our study is an overview of the types of measures actually
   taken to control traffic in residential areas and their potential
   effectiveness to contribute to sustainability-goals. We see three kind
   of bottlenecks in the process of developing these areas: The local
   political agenda, the perception of the market for traffic sustainable
   residential areas and practical issues.
   Incentives are presented that might encourage local actors
   (municipalities as well as building parties) to develop more
   `traffic-sustainable' - yet feasible - residential areas. Most important
   is to avoid stereotypical images and to stress the contribution of
   traffic sustainability to the quality of life in the neighbourhood.},
Publisher = {COMPUTATIONAL MECHANICS PUBLICATIONS LTD},
Address = {ASHURST LODGE, SOUTHAMPTON S04 2AA, HANTS, ENGLAND},
Type = {Proceedings Paper},
