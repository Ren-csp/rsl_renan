EISSN = {1879-1298},
Keywords = {flame retardants; time trend; geographical distribution; marine
   environment},
Keywords-Plus = {BROMINATED FLAME RETARDANTS; BLUE MUSSELS; TEMPORAL TRENDS; GREAT-LAKES;
   MYTILUS-EDULIS; NORTH-AMERICA; HUMAN-MILK; SEDIMENTS; MARINE; POLLUTANTS},
