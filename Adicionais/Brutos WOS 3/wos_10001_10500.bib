Title = {Expectation of sensory stimulation modulates brain activation during
   visual motion stimulation},
Booktitle = {CLINICAL AND BASIC OCULOMOTOR RESEARCH: IN HONOR OF DAVID S. ZEE},
Series = {ANNALS OF THE NEW YORK ACADEMY OF SCIENCES},
Year = {2005},
