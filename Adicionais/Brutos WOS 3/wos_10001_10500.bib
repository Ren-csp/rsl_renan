@inproceedings{ WOS:000527803500010,
Author = {Besedova, Petra},
Editor = {Bekirogullari, Z and Minas, MY and Thambusamy, RX},
Title = {THE ANATOMICAL FOUNDATIONS OF MUSIC PERCEPTION BY NON AND FOREIGN
   LANGUAGE LEARNERS},
