@article{ WOS:000264034100006,
Author = {Rueda, Alicia D. and Schmitter-Edgecombe, Maureen},
Title = {Time Estimation Abilities in Mild Cognitive Impairment and Alzheimer's
   Disease},
Journal = {NEUROPSYCHOLOGY},
