@inproceedings{ WOS:000360700100070,
Author = {Buathong, Thapanee and Boontanon, Suwanna Kitpati and Boontanon, Narin
   and Surinkul, Nawatch and Harada, Hidenori and Fujii, Shigeo},
Editor = {Utama, NA and McLellan, BC and Tarno, H and Hamzah, S and Bramantoro, A and Apip and Trihartono, A and Suryatmojo, H and Widodo, S and Himmi, SK},
Title = {Nitrogen Flow Analysis in Bangkok City, Thailand: Area Zoning and
   Questionnaire Investigation Approach},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON SUSTAINABLE FUTURE FOR HUMAN SECURITY,
   SUSTAIN 2012},
Series = {Procedia Environmental Sciences},
Year = {2013},
