@article{ WOS:000246257600015,
Author = {Edwards, Bryan D. and Arthur, Jr., Winfred},
Title = {An examination of factors contributing to a reduction in subgroup
   differences on a constructed-response paper-and-pencil test of
   scholastic achievement},
Journal = {JOURNAL OF APPLIED PSYCHOLOGY},
Year = {2007},
Volume = {92},
Number = {3},
