Title = {Development and validation of instrument to measure citywide inclusive
   sanitation (CWIS Scale) for Low-and Middle-Income Countries (LMICs)},
Booktitle = {7TH ENVIRONMENTAL TECHNOLOGY AND MANAGEMENT CONFERENCE, ETMC 2023},
Series = {E3S Web of Conferences},
