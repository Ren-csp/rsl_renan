@inproceedings{ WOS:000073159500014,
Author = {Rienstra, SA and Bisschop, F and Nijkamp, P},
Editor = {Sucharov, L and Bidini, G},
Title = {The potential of the electric vehicle; a scenario analysis for Amsterdam},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
