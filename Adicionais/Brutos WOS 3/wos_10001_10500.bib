@article{ WOS:000184208900007,
Author = {Schnall, S and Laird, JD},
Title = {Keep smiling: Enduring effects of facial expressions and postures on
   emotional experience and memory},
Journal = {COGNITION \& EMOTION},
Year = {2003},
Volume = {17},
Number = {5},
Pages = {787-797},
Month = {SEP},
Note = {41st Conference of Experimentally Working Psychologists, LEIPZIG,
   GERMANY, 1999},
Abstract = {Self-perception theory (Bem, 1972; Laird, 1974) holds that acting ``as
   if{''} one feels something will result in that feeling. Whereas other
   studies have examined effects of emotional expression on immediate
   emotional experience, this study investigated the more lasting influence
   of practised expressions. Participants repeatedly produced the facial
   expressions and postures associated with either Happiness , Sadness or
   Anger. Subsequently, participants responsive to their bodily, personal
   cues felt more of the emotions they practised, even though they were no
   longer performing the expressive behaviour. In a separate procedure,
   they recalled more life events with an emotional content associated with
   their training. No mood changes occurred for participants responsive to
   situational cues.},
