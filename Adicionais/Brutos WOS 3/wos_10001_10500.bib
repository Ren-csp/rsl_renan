Author = {Beattie, CI and Elsom, DM and Gibbs, DC and Irwin, JG and Jefferson, CM
   and Longhurst, JWS and Newton, AJ and Pheby, DFH and Pill, MAJ and Rowe,
   J and Simmons, A and Tubb, ALT and Whitwell, I},
Editor = {Brebbia, CA and Ratto, CF and Power, H},
Title = {Implementation of air quality management in urban areas within England -
   some evidence from current practice},
Booktitle = {AIR POLLUTION VI},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {1998},
