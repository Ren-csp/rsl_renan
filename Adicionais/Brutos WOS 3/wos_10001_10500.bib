@inproceedings{ WOS:000400299900022,
Author = {Mabitsela, Tebogo and Pretorius, Agnieta},
Editor = {Erickson, GS and Rothberg, HN},
Title = {Adoption of Knowledge Management Systems: A Case of an Enterprise Data
   Warehouse},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON INTELLECTUAL CAPITAL
   KNOWLEDGE MANAGEMENT \& ORGANISATIONAL LEARNING (ICICKM 2016)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2016},
Pages = {182-191},
Note = {13th International Conference on Intellectual Capital Knowledge
   Management and Organisational Learning (ICICKM), Ithaca Coll, Ithaca,
   NY, OCT 14-15, 2016},
Organization = {Marist Coll},
Abstract = {A vast amount of knowledge is created by businesses, both large and
   small, which may be strategically utilised in gaining key insight about
   the business - ultimately enabling a greater competitive advantage for
   the business. Based on previous studies, big firms have invested a lot
   into learning how to efficiently and effectively capture and reuse
   knowledge to gain growth through competitive advantage. Studies on the
   adoption of Knowledge Management Systems (KMS) using the Unified Theory
   of Acceptance and Use of Technology (UTAUT) together with the DeLone and
   McLean's Information Systems success model (DM) were sparse in the body
   of knowledge, especially those focusing on Knowledge Management (KM)
   adoption, which brought an opportunity for such research to be
   conducted. This study focuses on a Data Warehouse system (DWH) within a
   multinational insurance company with a purpose to understand perceptions
   of users towards the KMS. It further expands the body of knowledge for
   other researchers seeking information regarding the use of the UTAUT
   model in analysing the adoption of KMS, especially since little research
   has been conducted to test this on KMS such as DWH. The UTAUT and the DM
   were used to understand the correlation between the perceptions and
   behavioural intentions of the users to adopting the KMS. The following
   perception variables were measured and analysed: Performance Expectancy;
   Effort Expectancy; Social Influences; System Quality; Information
   Quality; Information Quality and Facilitation Conditions and Behavioural
   Intention, which came from the UTAUT and DM models. Data was collected
   by means of a survey sent to the full population of users. It is
   analysed and interpreted through various tests including analysis of
   variance (ANOVA) and multiple linear regressions, to define the relative
   contribution of each of the dependant variables. The results received
   were generally positive, indicating that users of the KMS had positive
   perceptions of the system. Users were positive that the KMS was relevant
   and useful to their jobs and that it assisted them in being more
   efficient in their delivery. However, there were also perceptions that
   were found not to have a strong relationship, which related more to the
   moderating variable being age, gender and experience, which then
   provided an opportunity for improvement efforts to be undertaken in
   order to change the perceptions. Further research can be conducted using
   the same approach on a wider scale, in other organisations.},
