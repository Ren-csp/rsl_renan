Editor = {Chis, V and Albulescu, I},
Title = {TEACHER SELF-EFFICACY, ATTITUDES TOWARD CHANGE AND NEUROEDUCATION
   PERCEPTION: TOOL PACKAGE DEVELOPMENT},
Booktitle = {ERD 2018 - EDUCATION, REFLECTION, DEVELOPMENT, 6TH EDITION},
