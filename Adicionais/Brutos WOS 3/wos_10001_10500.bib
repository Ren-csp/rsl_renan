   Gaigg, Sebastian B.; Bowler, Dermot M., City Univ London, Dept Psychol, Autism Res Grp, London EC1V 0HB, England.},
DOI = {10.1007/s10803-009-0710-y},
ISSN = {0162-3257},
EISSN = {1573-3432},
Keywords = {Autism Spectrum Disorder; Memory; Orthographic associations; Emotional
   processing; Illusory memories},
