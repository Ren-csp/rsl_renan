@inproceedings{ WOS:000425682900098,
Author = {Yang, B. D. and Lv, J. and Yang, Y. J. and Chen, F. and Liu, G. J.},
Editor = {Seto, K and Robinson, D and Virji, H and Kovacs, Z and Zhai, J and Sami, N and Pettit, C and Sridhar, KS},
Title = {Evolution of industrial land location in Xuzhou city since Chinese
   reform and opening-up},
Booktitle = {URBAN TRANSITIONS CONFERENCE},
Series = {Procedia Engineering},
Year = {2017},
Volume = {198},
Pages = {1137-1148},
Note = {Urban Transitions Conference, Shanghai, PEOPLES R CHINA, SEP, 2016},
Abstract = {The location of industrial land use in inner city is a significant part
   of the urban spatial form. The study on the evolution of the industrial
   land location contributes to the adjustment and plan for spatial
   structures. Using Arcgis 10.2 software, the database of urban land of
   Xuzhou (a traditional industrial city) in 1979, 1994, 2003 and 2013 were
   established based on the multi-temporal Landsat TM/ETM+ imagery and
   cadastral data. Fan-shaped and circle-layer analysis methods have been
   conducted to investigate the evolutionary characteristics of the
   industrial zone location. The results are the following three points.
   (1) In 1979, the industrial land was mainly dispersing in the
   Northeastern of Xuzhou city (Jinshanqiao) and the surrounding of
   railway. In 1994, central tendency of industrial land was emerged in
   Jinshanqiao, the phenomena of decentralization of industrial land in
   inner city began to appear. In 2003, the industrial land continued to
   expand to the surrounding areas; the central tendency in Jinshanqiao and
   Tongshan became even more apparent, and the use of industrial land in
   Jiulishan was gradually increased. In 2013, several large-scale clusters
   of industrial land were formed in Jinshanqiao and Tongshan, and the
   scattered industrial land in urban internal was practically disappeared.
   (2) The expansion of industrial land had been through a transition from
   unimodal peak to multimodal peaks. The principal wave peaks and the
   locations of growing region were constantly pushed outward. The
   replacement of industrial land was unfolded gradually from central areas
   to the outside. The industrial land was centralized farther away from
   the city center. (3) The industrial land evolutionary process in 1979,
   1994, 2003 and 2013 of Xuzhou city had presented a kind of
   centralizing-dispersing-recentralizing-clustering pattern. The scale of
   industrial land had presented a kind of rapid growth-stable growth-rapid
   expanse three stages pattern during 1979-1994, 1994-2003 and 2003-2013.
   (C) 2017 The Authors. Published by Elsevier Ltd.},
