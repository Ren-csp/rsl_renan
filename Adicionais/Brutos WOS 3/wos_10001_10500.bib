@article{ WOS:000399358400023,
Author = {Pongwintton, Ratthanan and Pakvipas, Pakphum},
Title = {Chiang Mai's Identity That Influence Traveling of Thai Tourists in
   Chiang Mai Tourism Promotion},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2017},
Volume = {23},
Number = {1, SI},
Pages = {96-99},
Month = {JAN},
Note = {Conference on Advanced Research on Business, Management and Humanities
   (ARBUHUM), Bandung, INDONESIA, MAR 15-17, 2016},
Organization = {Malaysia Tech Scientist Assoc},
Abstract = {Chiang Mai is one of the popular destinations of Thailand among Thai and
   foreign tourists due to its uniqueness and outstanding identity. As
   tourism is one of the key businesses of Chiang Mai, it is important to
   understand how Chiang Mars identity influences Thai tourists in order to
   know how to promote tourism in Chiang Mai. The present study was
   designed to study on the identity of Chiang Mai that influences
   traveling to Chiang Mai of Thai tourists under Chiang Mai tourism
   promotion. The questionnaire was used to collect data from 400 Thai
   tourists who visited Chiang Mai walking street market by the accidental
   sampling method. The results show that Thai tourists pay attention to
   all aspects of the marketing mix in high level; product, physical
   environment, and promotion. The perception of Chiang Mai's identity of
   Thai tourists in overall is in high level. The guidelines for
   development of Chiang Mai's identity for tourism promotion should focus
   on 3 aspects which are; 1. The development of a balanced and sustainable
   economy and tourism, 2. Creating the society of culture and knowledge
   with public mind and developing the potential of people by focusing on
   promoting cultural tourism, 3. The management of natural resources,
   energy and environment as the foundation of sustainable eco-tourism
   development.},
