Title = {Analysis of Generation of Green Energy in Water Supply System Within
   High-Rise Building-A Sustainable Approach},
Booktitle = {ENGINEERING SOIL, WATER AND ENVIRONMENT FOR SUSTAINABLE INFRASTRUCTURE,
   SIIOC 2024},
Series = {Lecture Notes in Civil Engineering},
Year = {2025},
