@inproceedings{ WOS:000185752400011,
Author = {Preining, O},
Editor = {Shen, S},
Title = {Global warming in perspective},
Booktitle = {WORLD RESOURCE REVIEW, VOL 12, NOS 2-4: GLOBAL WARMING SCIENCE \&
   POLICY, PTS 1-3},
Series = {GLOBAL WARMING INTERNATIONAL CENTER MONOGRAPH SERIES},
Year = {2000},
Pages = {421-427},
Note = {11th International Conference on Global Warming Science and Policy,
   BOSTON, MA, APR 26-28, 2000},
Abstract = {Global warming (GW) is just one of many environmental issues and other
   problems emerging during the past few decades. Some of these issues may
   result in serious socioeconomic and/or environmental threats to
   different societies in various regions of the world during the 21st
   century. The simultaneous recognition, investigation, and finally
   melioration of all of them will be essential; the common heading:
   sustainability.
   However there are many different perceptions of urgencies; the world is
   split. Just look at the results of the Kyoto Conference and what has
   happened since! The Conferences of the Parties, COP's, did not move
   much. Considering the possible threats the precautionary principle
   requires action: the greenhouse gas concentrations increase steadily and
   waiting and seeing, considering the time-constants involved and possible
   consequences, are by no means a reasonable option. All possible
   approaches must be employed to mitigate adverse consequences (Royal
   Society, 1999), even if global warming may not seriously affect the
   world's food security (Perry, 1999). A new Intergovernmental Panel on
   Climate Change, IPCC, update is due in 2000, hundreds of pages of new
   scientific input; but what will it do? Does it help in a fast growing
   world-population of more than 6 billion, still 20\% of them illiterate?
   They must get basic education, and they must increase their standard of
   living. They must be integrated in a global governing structure that has
   to be invented, introduced, and accepted. The global warming issue has
   received public recognition for about 20 years. Observing the
   development since then yields the insight that it is much more difficult
   to get general global public acceptance of proposed actions than to make
   progress in scientific understanding.},
