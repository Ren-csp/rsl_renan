@inproceedings{ WOS:000184043600052,
Author = {Forsberg, C},
Editor = {Sivik, T and Byrne, D and Lipsitt, DR and Christodoulou, GN and Dienstfrey, H},
Title = {A plea for a psychic energy concept},
Booktitle = {PSYCHO-NEURO-ENDOCRINO-IMMUNOLOGY (PNEI): A COMMON LANGUAGE FOR THE
   WHOLE HUMAN BODY},
Series = {INTERNATIONAL CONGRESS SERIES},
Year = {2002},
Volume = {1241},
Pages = {367-370},
Note = {16th World Congress on Psychosomatic Medicine, GOTHENBURG, SWEDEN, AUG
   24-29, 2001},
Abstract = {It may be argued that there is a need to underline the point that the
   concept of psychosomatics proper presupposes a perspective in which
   concepts from psychology and social psychology are considered as active
   agents in a causal context. Although this has always been the case
   traditionally, there is a growing tendency to regard psychological
   explanations as (at best) palliatives to be replaced by supposedly
   ultimate explanations to be revealed in the field of neurology. It is
   argued that this notion is entirely false and-albeit there is a booming
   progress in neurological research-rests on an erroneous philosophical
   standpoint. Karl Popper and John C. Eccles (1977) have, among others,
   pleaded for the so-called interactionistic standpoint. From this view,
   subjective experience, in the form of feelings and perceptions, cannot
   be reduced but has to be taken as fact; thus, they must constitute part
   of in any model of the function of the brain. The other point to be
   stressed is the important observation that if subjective experience is
   to be considered a product of Darwinian evolution, it must be ascribed
   to causal effects upon somatic tissues. Otherwise, it cannot have any
   survival value at all. The present writer (1997) has added that this
   presupposes a concept of psychic energy, as was postulated in the early
   days of psychodynamics, since all transformation of information has been
   shown to require energy. There is a serious danger of strangulating
   psychological research if this point of view remains unnoticed in
   theoretical discussions. (C) 2002 Elsevier Science B.V. All rights
   reserved.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Forsberg, C (Corresponding Author), Cent Hosp Kristianstad, Psychiat Clin, S-29185 Kristianstad, Sweden.
   Cent Hosp Kristianstad, Psychiat Clin, S-29185 Kristianstad, Sweden.},
DOI = {10.1016/S0531-5131(02)00690-8},
ISSN = {0531-5131},
ISBN = {0-444-50989-5},
Keywords = {psychic energy; psychology; psychosomatics},
Research-Areas = {Neurosciences \& Neurology},
Web-of-Science-Categories  = {Neurosciences},
