@article{ WOS:000088738300003,
Author = {Watanabe, Y and Kimura, K and Suzuki, T},
Title = {Membrane application to water purification process in Japan -
   development of hybrid membrane system},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2000},
