@inproceedings{ WOS:000404866900042,
Author = {Tumamao-Guittap, Geomilie S. and Napalang, Ma. Sheilah G.},
Editor = {Amer, MS and Naselli, F and Pollice, F and Ghoneem, MY},
Title = {Unlocking the Human Dimension of Energy Efficiency and Conservation: The
   Case of Tourist Accommodation Providers in Coron, Palawan in the
   Philippines},
Booktitle = {GREEN URBANISM (GU)},
Series = {Procedia Environmental Sciences},
Year = {2017},
Volume = {37},
Pages = {483-494},
Note = {1st International Conference on Green Urbanism (GU), Rome, ITALY, OCT
   12-14, 2016},
Organization = {IEREK; Roma Tre Univ},
Abstract = {In the light of mounting concerns related to climate change, energy
   efficiency and conservation (EEC) presents a cost-effective strategy
   that can propel the Philippines' energy-intensive tourist accommodations
   sector towards sustainability. This warrants the examination of barriers
   that prevent capture of EEC potentials and the identification of factors
   that will drive adoption at a socially optimal rate.
   Coron, Palawan's small and medium enterprise (SME) dominated hospitality
   sector was studied using post-only correlation design. Mann-Whitney U
   test was used to compare perceptions, practices, energy awareness, and
   willingness to participate in EEC between members of the Zero Carbon
   Resorts project; a voluntary program aiding tourism SMEs reduce energy
   consumption (Case Group), and non-members (Control Group). Pearson
   Chi-Squared test was employed to determine factor association with
   membership in the program, while Ordered Logistic Regression was used to
   determine participation drivers in EEC.
   Research revealed vast uncaptured energy-savings potential compounded
   with the absence of EEC laws targeting this sector. The study found
   that: (1) provisions for amenities, facilities and support services for
   guests; (2) high dependence on the grid and the prevalent use of
   generators; (3) low market penetration of renewable energy (RE) and
   energy-efficient technology; and (4) lack of knowledgeable personnel
   within organizations contribute to high energy expense within this
   sector. Despite having very little difference in perceived energy
   savings, energy awareness and self-reported energy-saving practices vary
   widely. Policy and institutional changes are required to address: (1)
   perceived high cost of energy-efficient technology and knowledge gap,
   (2) put in place necessary regulations; and (3) incentivize EEC to
   increase its adoption.(c) 2017 The Authors. Published by Elsevier B.V.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {SARA BURGERHARTSTRAAT 25, PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Tumamao-Guittap, GS (Corresponding Author), Univ Philippines, Sch Urban \& Reg Planning, Quezon City 1101, Philippines.
   Tumamao-Guittap, Geomilie S.; Napalang, Ma. Sheilah G., Univ Philippines, Sch Urban \& Reg Planning, Quezon City 1101, Philippines.},
DOI = {10.1016/j.proenv.2017.03.021},
ISSN = {1878-0296},
