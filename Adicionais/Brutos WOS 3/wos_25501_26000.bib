@inproceedings{ WOS:000377577200007,
Author = {Vaidianu, Natasa and Tatui, Florin},
Editor = {Ozhan, E},
Title = {Future Management of the Romanian Black Sea Coast},
Booktitle = {TWELFTH INTERNATIONAL CONFERENCE ON THE MEDITERRANEAN COASTAL
   ENVIRONMENT (MEDCOAST 15), VOLS 1 AND 2},
Year = {2015},
Pages = {55-66},
Note = {12th International Conference on the Mediterranean Coastal Environment
   (MEDCOAST), Varna, BULGARIA, OCT 06-10, 2015},
Organization = {Mediterranean Coastal Fdn; Inst Oceanol; Inst Fish Resources; Republ
   Turkey, Promot Fund},
Abstract = {Accelerated sea-level rise due to ongoing climate change will lead to
   increased coastal erosion in the future. During the last half century,
   coastal erosion has become a dominant, human-induced and critical
   feature along large areas of the Romanian Black Sea coast. Human
   interventions abruptly changed the natural coastal evolution trends,
   increasing erosional rates on many coastal sectors and transforming the
   natural landscape with major impact on coastal ecosystems. Therefore,
   decision makers are required to define conservation effective coastal
   and marine conservation regulations and programs. Because all levels of
   government must be involved in Integrated Coastal Zone Management (ICZM)
   along with development interests and resource users, the task of
   coordination with the variety of ``stakeholders{''} is complex and
   important. A proper evaluation and understanding of policy framework and
   stakeholder interests helped us to understand the prerequisites for
   participative management and lead to consensus and resource conflict
   decrease. We investigated institutional actors' perceptions in order to
   assess the implementation stages of legal and regulatory mechanisms on
   marine-related issues. Results indicate that the legislation is
   sectorial and complex and the competences are overlapping and
   responsibilities scattered. Little attention is given to the
   connectivity of land-sea environments and spatial planning does not take
   the coastal waters into account. There are shortcomings in cooperation,
   communication and public participation and the availability of data and
   access to information still need improvements. Status, problems, gaps
   and recommendations to conduct to a future optimal management of our
   coast are outlined and discussed. This is the first study in Romania to
   investigate the stage of ICZM implementation and our results shall serve
   as advisory tool for future actions.},
