Language = {English},
Affiliation = {Courtois, R (Corresponding Author), Direct Gen Patrimoine Faun \& Nat, Serv Faune Terr, 11e Etage,675 Blvd Rene Levesque E,Boite 92, Quebec City, PQ G1R 5V7, Canada.
   Direct Gen Patrimoine Faun \& Nat, Serv Faune Terr, Quebec City, PQ G1R 5V7, Canada.},
