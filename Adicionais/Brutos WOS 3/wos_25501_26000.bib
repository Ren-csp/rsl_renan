@inproceedings{ WOS:000472156000032,
Author = {Grigorevna, Borisova Tatyana and Borisovna, Kuznetsova Tatyana},
Editor = {KarimSultanovich, BD},
Title = {ONOMASTIC SPACE OF STORY BY V. SOROKIN ``THE DAY OF THE OPRICHNIK{''}},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
Series = {European Proceedings of Social and Behavioural Sciences},
