@article{ WOS:000444975300025,
Author = {Ismail, Mohammad and Razak, Razli Che and Yaacob, Mohd Rafi and Zakaria,
   Mohd Nazri and Amiruddin, Nadia Hanum and Kamaruddin, Anis Nabila and
   Luqman, Azyanee},
Title = {Determinant Factors of Generation Y to Use Mobile Marketing Services},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {5},
Pages = {3096-3101},
Month = {MAY},
Note = {Annual International Conference on Social and Behavioural Sciences
   (ICSBS), Singapore, SINGAPORE, AUG 14-16, 2017},
Abstract = {The research of mobile marketing services is still at the early stage
   particularly in determining the acceptance of the usage among generation
   Y. To investigate this issue, this study has examined the acceptance of
   mobile marketing services by measuring the consumers' intention and
   actual usage of mobile marketing services. Grounded upon extended Theory
   of Planned Behaviour, this study develops the conceptual framework by
   examining the attitude, subjective norm, perceived behavioural control,
   intention and their actual usage. This study also attempts to identify
   the effects of risk perception on actual usage, which still lack of
   explanation in mobile marketing among Gen Y. Data for all the study
   variables have been collected through self-administered survey
   questionnaires. A total of 650 full-time university students from four
   public universities in the East Coast of Peninsular Malaysia have
   participated in this study. Partial Least Square (PLS) is the main
   statistical technique used in this study. The study has shown that
   attitude, subjective norm, perceived behavioural control, perceived risk
   and behavioural intention tend to influence generation Y to use mobile
   marketing services. This study also may provides the benefit to the
   government particularly Malaysia Communication Media Commission (MCMC)
   and educators, which can enhance Malaysian government's practices and
   policy campaigns relating mobile marketing usage. By providing
   determinant factors of mobile services usage, managers may discover the
   useful information in targeting their mobile services usage so they can
   focus on the barriers that may be inhibiting the consumers' behaviour.
   Based on the findings, the theoretical and practical implications of the
   study as well as limitations and suggestions for future studies are also
   discussed.},
