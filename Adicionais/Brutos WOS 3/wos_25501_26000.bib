@inproceedings{ WOS:000087041300028,
Author = {Jongen, W},
Editor = {Boekestein, A and Diederen, P and Jongen, W and Rabbinge, R and Rutten, H},
Title = {Food supply chains and product quality: How to link sustainability and
   market},
Booktitle = {TOWARDS AN AGENDA FOR AGRICULTURAL RESEARCH IN EUROPE},
Year = {2000},
Pages = {261-272},
Note = {Conference on Towards an Agenda for Agricultural Research in Europe,
   WAGENINGEN, NETHERLANDS, APR 13-15, 1999},
Organization = {Wageningen Univ; Res Ctr; Dutch Minist Agr Nat Management \& Fisheries;
   Dutch Natl Council Agr Res},
Abstract = {Recent estimates indicate that close to half of all human impact on the
   environment, such as loss of biodiversity, is directly and/or indirectly
   related to food production and consumption. If society wants to reduce
   this impact, changes in the production and consumption of meat are most
   challenging of all food product categories. It may be clear that on the
   one hand there is a need for society to make food production systems
   more sustainable. On the other hand Food products are manufactured and
   sold in a market-oriented system. Consequently new,
   environment-friendly, protein-rich products must have the
   characteristics and quality to appeal to the consumer. Many of the
   non-meat alternatives that are currently on the market do not meet these
   criteria. To be able to produce protein-rich products that meet consumer
   demands it is necessary to incorporate the changes that occur in the
   market and in consumer's perceptions and preferences. New products
   should be defined that meet sustainability criteria and at the same time
   are attractive for consumers. A chain-oriented approach should be
   followed in product innovation going from market via processing
   conditions up to raw material composition and properties. Using this
   approach Large reductions in environmental impact of the supply chain
   will be accomplished but a co-ordinated approach is required and
   eventually the design of new supply chains. In this paper we will follow
   the product innovation route and in the end present a case study of how
   the need for sustainability can be Linked to market demands.},
