Title = {ANALYSIS OF THE DEGREE OF ADHERENCE TO THERAPY IN PATIENTS WITH
   DIAGNOSED DEPRESSION},
Booktitle = {CBU INTERNATIONAL CONFERENCE PROCEEDINGS 2018: INNOVATIONS IN SCIENCE
   AND EDUCATION},
