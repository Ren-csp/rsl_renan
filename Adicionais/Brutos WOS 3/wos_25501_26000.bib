Address = {26650 THE OLD RD, STE 208, VALENCIA, CA 91381-0751 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Hermita, N (Corresponding Author), Univ Riau, Program Studi PGSD FKIP, Pekanbaru 28293, Indonesia.
   Hermita, N (Corresponding Author), Univ Pendidikan Indonesia, Program Studi Pendidikan Dasar, Bandung 40154, Indonesia.
