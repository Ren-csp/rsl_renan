@article{ WOS:000444996500143,
Author = {Alqadami, Ahmed Tawfik and Zakaria, R. and Abdullah, Redzuan and
   Alqaifi, G. and Abidin, Nur IzieAdiana},
Title = {Challenges of Stakeholders' Expectations to Develop Residential
   High-Rise Green Buildings in Malaysia},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {6},
Pages = {4496-4501},
Month = {JUN},
Note = {International Conference on Science, Engineering, Management and Social
   Sciences (ICSEMSS), Univ Teknologi Malaysia, Johor Bahru, MALAYSIA, OCT
   06-08, 2016},
Organization = {Univ Teknologi Malaysia, Int Student Soc; Int Students Ctr; Univ
   Teknologi Malaysia, Inst Sultan Iskandar},
Abstract = {In Malaysia, the development of green buildings is considered low
   priority due to many factors that influences stakeholders' expectations.
   Stakeholders' expectations present a major challenge for green building
   development due to uncertainty measures and the differences in
   stakeholders' perceptions and expectations. This paper aims to identify
   the challenges of stakeholders on the green building development and to
   investigate the key factors influencing the decision making among
   multi-level of stakeholders, so that strategies to overcome the
   challenges can be suggested. Residential high-rise green buildings are
   the scope of this study and the stakeholders are the respondents. A
   total of 50 respondents have contributed to the study through two
   approaches. The first approach employed was through semi-structured
   interviews, whereby 18 stakeholders mainly from three different green
   building projects have pointed out their point of views on the key
   challenges to develop green buildings. In this approach, qualitative
   data were captured and analyzed using content analysis. The second
   approach was questionnaire survey, whereby the respondents were selected
   from the professionals of Malaysian construction industry across the
   country to determine their point of views on the importance of the
   challenges and the effectiveness of strategies that have been identified
   through the interviews. Based on questionnaire survey, 32 responses were
   received and statistical analysis was employed with descriptive analysis
   through SPSS. Based on the findings, the challenges have been determined
   and categorized into six main themes that influence the decision making
   among stakeholders namely, awareness, financial obligation, government
   decision, technical issues, lack of knowledge and consumer acceptance.
   It has been found that these identified challenges significantly
   influence the decision making process of green building development in
   Malaysia.},
