@article{ WOS:000445101000047,
Author = {Kasri, Rahmi Yetri and Kusnoputranto, Haryoto and Utomo, Suyud Warno},
Title = {Convincing Rural People on the Need for Safe Water and Improved
   Sanitation},
Journal = {ADVANCED SCIENCE LETTERS},
Year = {2018},
Volume = {24},
Number = {9},
Pages = {6456-6460},
Month = {SEP},
Note = {International Conference on Actual Economy - European Discourse on
   Global Challenges (ACE-EU), Paris, FRANCE, NOV 27-29, 2017},
Abstract = {Introduction: This study aims to understand perception of rural people
   on safe water and improved sanitation and elaborate stage and options to
   promote and convince them on the need for safe water and improved
   sanitation. Methods: A case study is conducted in two hamlets with
   contrast performance in water supply and sanitation service provided by
   Community-Based Organizations in Agam district, West Sumatera,
   Indonesia. Data is collected through in-depth interview, focus group
   discussion and household survey. It is analyzed with environmental
   health and behavior change communication concept. Results: The study
   found that safe water is not yet an option in rural area. People use
   water they can access and consume it when it looks clean and no one fall
   sick of that. Access to improved sanitation relates more with comfort
   and people refuse to have it when it is not seen economically
   profitable. Most people have no knowledge on safe water and improved
   sanitation and their corresponding standard and requirements. Although
   giving more confidence, people do not see laboratory test for water
   quality as necessary. Conclusion: To create need and convince rural
   people for safe water and improved sanitation, it is important to
   equipped awareness raising with reliable and affordable supplies through
   a robust engagement between citizen and government to promote and
   maintain new behavior. Lessons from this study shall provide some
   insights for sector stakeholders to create demand, provide supply and
   develop corresponding policy. The BPSPAMS can be one actor to provide
   services in collaboration with the government.},
