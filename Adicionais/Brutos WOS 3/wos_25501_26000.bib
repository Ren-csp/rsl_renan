@article{ WOS:000090006400053,
Author = {Takabatake, H and Satoh, H and Mino, T and Matsuo, T},
Title = {Recovery of biodegradable plastics from activated sludge process},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2000},
Volume = {42},
