@inproceedings{ WOS:000288275500004,
Author = {Yue, Tian-Xiang and Li, Qi-Quan},
Editor = {Li, BL},
Title = {Relationship between species diversity and ecotope diversity},
Booktitle = {ECOLOGICAL COMPLEXITY AND SUSTAINABILITY},
