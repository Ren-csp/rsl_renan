@inproceedings{ WOS:000664335306157,
Author = {Duan, Puhong and Kang, Jian and Kang, Xudong and Ghamisi, Pedram and Li,
   Shutao},
Book-Group-Author = {IEEE},
Title = {SUN GLINT REMOVAL OF HYPERSPECTRAL IMAGES VIA TEXTURE-AWARE TOTAL
   VARIATION},
