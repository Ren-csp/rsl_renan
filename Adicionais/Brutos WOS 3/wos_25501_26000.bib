@inproceedings{ WOS:A1997BJ51K00015,
Author = {FahyElwood, AK and Petersen, RC and Zeman, GH},
Editor = {Hardy, K and Meltz, M and Glickman, R},
Title = {Wireless telecommunications: Communicating with the public about RF
   safety issues},
Booktitle = {NON-IONIZING RADIATION: AN OVERVIEW OF THE PHYSICS AND BIOLOGY},
Year = {1997},
Pages = {227-234},
Note = {42nd Annual Meeting of the Health-Physics-Society, UNIV INCARNATE WORD,
   SAN ANTONIO, TX, JUN 23-27, 1997},
Organization = {Hlth Phys Soc, S Texas Chapter; Univ Texas Hlth Sci Ctr, Ctr Environm
   Radiat Toxicol},
Abstract = {Heightened public awareness of safety and environmental protection has
   created opportunities for health physicists to communicate with the
   public on radiation protection issues. Non-ionizing radiation protection
   questions which have drawn public attention include the installation of
   cellular and personal communications services (PCS) base stations
   (cell-sites) within the boundaries of a growing number of communities.
   Recent changes in federal telecommunications law address the
   environmental health concerns associated with expanding personal
   wireless services networks, and preempt this issue from local government
   consideration to the extent that sites comply with the law.
   Nevertheless, community opposition to new installations is not uncommon,
   in many cases being based on scientifically unfounded perceptions of
   health risks associated with exposure to the weak radiofrequency (RF)
   fields associated with the operation of these facilities.
   Experience in the siting process has shown that the health physicist can
   provide scientifically-based information that is useful to communities
   concerned about the safety issue. The role of the health physicist is to
   communicate an accurate message about nonionizing radiation protection
   to community boards and to the public, in a manner that is readily
   understandable so that informed decisions can be made. By drawing on
   communications lessons learned from experiences in other industries, the
   health physicist can remove unfounded fears of radiation as an obstacle
   in siting wireless base station facilities. In another chapter in this
   textbook, Petersen et al. reviewed the underlying technology of wireless
   telecommunications systems and provided information about the exposure
   associated with many types of installations that are being opposed.},
Publisher = {MEDICAL PHYSICS PUBLISHING},
