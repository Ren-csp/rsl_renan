Organization = {Brit Psychol Soc},
Abstract = {This study investigates the psychophysiological responsiveness of
   children with autism and comparison groups to distress cues, threatening
   and neutral stimuli. 20 children with autism, 20 children with moderate
   learning difficulty and 20 normal developing children were shown slides
   of these three types of stimuli and their electrodermal responses were
   recorded. The children with autism showed appropriate electrodermal
   responses to the distress cues. However, and surprisingly, the children
   with autism were hyporesponsive to the threatening stimuli. The results
   are interpreted with reference to the violence inhibition mechanism
   model (Blair, 1995) and possible frontal lobe dysfunction in autism. (C)
   1999 Elsevier Science Ltd. All rights reserved.},
