Title = {Education and Spirituality in Kazakhstan: ``Self-cognition{''}
   Metadiscipline Features and Methods of Teaching},
Booktitle = {ICCSBS 2016 - THE ANNUAL INTERNATIONAL CONFERENCE ON COGNITIVE - SOCIAL,
   AND BEHAVIOURAL SCIENCES},
