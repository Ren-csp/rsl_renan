@article{ WOS:000242038900039,
Author = {Hunt, III, W. F. and Apperson, C. S. and Kennedy, S. G. and Harrison, B.
   A. and Lord, W. G.},
Title = {Occurrence and relative abundance of mosquitoes in stormwater retention
   facilities in North Carolina, USA},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2006},
