Editor = {Zhou, X},
Title = {RETRACTED: Study on low carbon-to-nitrogen municipal wastewater using
   Pre-denitrification Biological Filter (Retracted Article)},
Booktitle = {2011 INTERNATIONAL CONFERENCE ON ENERGY AND ENVIRONMENTAL SCIENCE-ICEES
   2011},
Series = {Energy Procedia},
Year = {2011},
Volume = {11},
Pages = {3942-3947},
Note = {International Conference on Energy and Environmental Science (ICEES),
   Singapore, SINGAPORE, OCT, 2011},
Organization = {Singapore Inst Elect (SIE)},
Abstract = {By the reflux to different sites, that is all reflux to denitrification
   stage (DN) or shunting circuit into settling bucket and DN at a certain
   proportions, the performance of pre-denitrification biological aerated
   filter in a pilot-scale was assessed, especially enhancing
   denitrificaion methods for low carbon-to-nitrogen domestic sewage. The
   results showed that in the condition of all reflux to DN, at the reflux
   ratio ranges from 100,130 to 150\%, the average removal efficiency of
   TCOD enhanced with the value 58.5, 62.3 and 65.8\% and that of NH4-N was
   84.5, 87.5 and 94.7\%, whereas the average removal efficiency of TN
   presented 37.1, 40.9 and 39.7\%. In the test, the removal increase of
   total nitrogen had no unanimous increase with the reflux ratio increase.
   The TN average removal achieved 56.4\% and 60.5\% when the quantities of
   reflux were shunted circuit to settling bucket and DN by 1: 1 and 2: 1
   at 130\% of the return flow. Therefore, most of reflux passing by
   settling bucket for oxygen consumption was the better proposal of
   improving TN removal efficiency for low C/N wastewater. (C) 2011
   Published by Elsevier Ltd. Selection and/or peer-review under
   responsibility of the Organizers of 2011 International Conference on
   Energy and Environmental Science.},
