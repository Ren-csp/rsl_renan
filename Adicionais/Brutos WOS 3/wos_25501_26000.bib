@article{ WOS:000220706800019,
Author = {Gao, YX and Yang, M and Zhang, Y and Hu, JY},
Title = {Treatment of oilfield wastewater by Fenton's process},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2004},
Volume = {49},
Number = {4},
Pages = {103-108},
Note = {3rd International Conference on Oxidation Technologies for Water and
   Wastewater Treatment, GOSLAR, GERMANY, MAY 18-22, 2003},
Abstract = {A combination of coagulation and Fenton's process was used for the
   removal of total oxygen carbon (TOC) from oilfield wastewater. Compared
   with aluminium sulfate, ferric coagulant had better TOC removal
   efficiency at the same mass dosage. In Fenton's process, the effect of
   H2O2 and Fe2+ dose on the removal of TOC was studied. The optimum
   conditions required for TOC removal were an Fe3+ concentration of 40-50
   mg/L, an H2O2 dose of 50 mmol/L and an Fe2+, concentration of 1.0
   mmol/L. GC-MS chromatographic analysis indicated that most of the alkyl
   hydrocarbons of carbon numbers <21 were removed in the first minute of
   Fenton's process mainly through adsorption. Alkyl hydrocarbons and
   phenols were oxidized almost completely following 120 min of treatment.
   The pathway of newly formed intermediates in Fenton's process was
   proposed on the basis of the GC/MS chromatogram.},
