Title = {Laying the Foundations to Build Ergonomic Indicators for Feminized Work
   in the Informal Sector},
Booktitle = {PROCEEDINGS OF THE 21ST CONGRESS OF THE INTERNATIONAL ERGONOMICS
   ASSOCIATION, IEA 2021, VOL II},
Series = {Lecture Notes in Networks and Systems},
