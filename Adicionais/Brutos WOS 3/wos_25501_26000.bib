@inproceedings{ WOS:001875059400005,
Author = {Jaiswal, Arun and Basnet, Bijay Kumar and Ghimire, Prashanna and Palle,
   Praveen Reddy and Sukhvinder and Chaeikar, Saman Shojae},
Book-Group-Author = {IEEE},
Title = {Balancing Act: Navigating Privacy and Security in the Cookie-Enabled Web},
Booktitle = {2024 IEEE CONSUMER LIFE TECH, ICLT},
Year = {2025},
Note = {2024 Conference on Consumer Life Tech-ICLT, Sydney, AUSTRALIA, DEC
   11-13, 2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Cookies are deployed by several online service providers and several
   websites to keep track of the browser-server interaction. It is a small
   piece of information or text data that is alternatively called Hypertext
   Transfer Protocol (HTTP) cookies that are deployed for enhancing and
   improving sever. The small file consists of the cookie store name,
   cookie value, expiry date, valid path, the domain name of the cookie,
   etc. Cookies provide supportive information for marketers, advertisers,
   and businesses with user information and activities and also help them
   with optimized browsing experience. However, the challenging aspect of
   cookies is that they fail to get user consent openly before they are
   placed in the user's devices or applications. Users are not aware and
   pay no attention to the cookies placed by the websites and how they
   function and use their data. With the tracking of user information and
   online movement by cookies, it leads to security and privacy concerns.
   The research aims to provide comprehensive information on cookies and
   their behaviors in impacting the privacy and security of users, along
   with the possible solutions to manage them. Cookies and their online
   security issues are caused by the attacker exploiting their
   vulnerabilities and gaining user credentials to perform any fraudulent
   activities. The user awareness and the perception of cookies, the use of
   different cookies by attackers to launch cybersecurity attacks,
   mitigation strategies, and emerging technologies provide insight to
   users on how to handle and manage cookies efficiently and protect
   sensitive information.},
