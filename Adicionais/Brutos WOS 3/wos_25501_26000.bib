@article{ WOS:000266722300162,
Author = {Al-Banaa, K. and Rakha, K.},
Title = {Seasonal Variability of Temperature Measurements in a Shallow Bay},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2009},
Number = {1, 56},
Pages = {782-786},
Note = {10th International Coastal Symposium (ICS 2009), Lisbon, PORTUGAL, APR
   13-18, 2009},
Organization = {Coastal Educ Res Fdn; Ctr Estud Geograf Planeament Reg; Univ Nova
   Lisbon, Fac Cienc Soc Humanas},
Abstract = {Sea water temperature is an important physical parameter for
   sustainability of marine species. Sulaibikhat Bay (SB) is situated in
   the southwest corner of Kuwait Bay (KB). The SB is a shallow bay with an
   average water depth of less than 8.0 m with a wide tidal flat. The SB
   has an ellipsoidal shape with the principal axis less than 7.0 km long.
   In recent years, concerns have been raised on the effect of several
   power and desalination facilities on the SB thermal ecosystem. Thermal
   discharges from the facilities can result in serious danger to the
   ecosystem of the SB. Some studies were conducted in the bay showed that
   seasonal variability of temperature is increasing with a rate higher
   than the global values. Thus seasonal sea temperature measurements
   inside the SB are higher than previously recorded by different
   researchers. The effect of the tidal current magnitude, directions, and
   outfall discharges control the fate and transport of the thermal
   discharges from the facilities inside the SB. This paper provides field
   measurements of the seasonal variation for sea water temperature inside
   SB. These measurements can be used as calibration and verification tools
   for thermal advection dispersion models. Such models can be used to
   Study the spatial and temporal temperature variation inside the SB.},
