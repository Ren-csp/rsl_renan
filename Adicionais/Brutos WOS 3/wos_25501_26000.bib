@article{ WOS:000252257400008,
Author = {Montagnini, Anna and Mamassian, Pascal and Perrinet, Laurent and Castet,
   Eric and Masson, Guillaume S.},
Title = {Bayesian modeling of dynamic motion integration},
Journal = {JOURNAL OF PHYSIOLOGY-PARIS},
