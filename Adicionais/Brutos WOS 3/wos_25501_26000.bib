Title = {MANIFESTATIONS OF ETHNIC IDENTITY CHILDREN OF PRESCHOOL AND PRIMARY
   SCHOOL AGE},
Booktitle = {SOCIAL AND CULTURAL TRANSFORMATIONS IN THE CONTEXT OF MODERN GLOBALISM
   (SCTCGM 2018)},
