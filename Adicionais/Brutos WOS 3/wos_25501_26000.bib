Title = {RELATIONSHIP PROBLEMS IN A FAMILY SYSTEM AND WITH PEOPLE OUTSIDE A
   FAMILY AS AN EXTERNAL MOTIVATOR IN ADDICTED CLIENTS BEFORE ENTERING A
   RESOCIALIZATION CENTRE},
