@article{ WOS:000266722300095,
Author = {Al-Ragum, A. and Neelamani, S.},
Title = {Design and Development of Crater Array Wave Barriers},
Journal = {JOURNAL OF COASTAL RESEARCH},
Year = {2009},
Number = {1, 56},
Pages = {458-462},
Note = {10th International Coastal Symposium (ICS 2009), Lisbon, PORTUGAL, APR
   13-18, 2009},
Organization = {Coastal Educ Res Fdn; Ctr Estud Geograf Planeament Reg; Univ Nova
   Lisbon, Fac Cienc Soc Humanas},
Abstract = {In wave flumes or wave basins with wet back wave generating system, it
   is necessary to dissipate the wave energy at the rear side of the wave
   maker in order to protect the hardware systems from the repetitive
   dynamic loads of waves. Also in wave basins, it is required to reduce
   the reflection from the side walls in order to carry out better quality
   physical model works. The coastal labs around the world wish to use wave
   absorbers, which occupy minimum space in the basin area. This will help
   in increasing the model study area. In general, mild sloped wave
   absorbers effectively dissipate the wave energy. This means that they
   occupy a large basin/flume area. It is a challenge to develop a wave
   absorber, which occupies minimum space and at the same time, offer
   better wave energy dissipating characteristics. One of the solutions
   used in the coastal labs around the world is progressive energy
   dissipation using series of perforated plates. In the present study, the
   wave energy dissipation characteristics of commercially available
   craters were investigated for two different cases; Viz. a) 4 Row type
   and b) 7 Row type. The total width of the wave barrier system is only
   1.4 m. Wide range of regular and random wave inputs were used for the
   investigation. In general, it is recommended that the crater array
   barrier can be used for wave energy dissipation in flumes and basins
   since the reflection coefficient has not exceeded 0.45 even for the
   longest wave used with relative water depth, d/L=0.095. The 7 row crater
   is, on an average, 30\% more efficient in reducing the wave reflection.
   The effect of wave height and wave period is presented using normalized
   input parameters. The quantitative improvement of 7 row barrier compared
   to 4 row barriers in wave energy reflection is discussed in detail.},
Publisher = {COASTAL EDUCATION \& RESEARCH FOUNDATION},
Address = {5130 NW 54TH STREET, COCONUT CREEK, FL 33073 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Al-Ragum, A (Corresponding Author), Kuwait Inst Sci Res, Coastal \& Air Pollut Dept, Environm \& Urban Dev Div, POB 24885, Safat 13109, Kuwait.
