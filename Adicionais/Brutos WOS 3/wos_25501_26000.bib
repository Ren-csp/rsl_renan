Title = {THE CHALLENGES HINDERING THE IMPLEMENTATION OF ENVIRONMENTAL MANAGEMENT
   PRACTICES IN HOSPITALS},
Booktitle = {SUSTAINABLE DEVELOPMENT AND PLANNING IX},
