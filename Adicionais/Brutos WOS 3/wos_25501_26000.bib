Author = {Rau, I, M. and Hidayatulloh, M. H. and Suharnoto, Y. and Arif, C.},
Book-Group-Author = {IOP},
Title = {Evaluation of flood modelling using online visual media: Case study of
   Ciliwung River at Situ Duit Bridge, Bogor City, Indonesia},
Booktitle = {FIRST INTERNATIONAL SEMINAR ON CIVIL AND ENVIRONMENTAL ENGINEERING:
   ROBUST INFRASTRUCTURE RESILIENT TO NATURAL DISASTER},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2021},
Volume = {622},
Note = {1st International Seminar on Civil and Environmental Engineering (ISCEE)
   - Robust Infrastructure Resilient to Natural Disaster, IPB Univ, Dept
   Civil \& Environm Engn, ELECTR NETWORK, NOV 02-04, 2020},
Organization = {IPB Univ, Dept Civil \& Environm Engn, Ctr Disaster Studies; Halu Oleo
   Univ, Dept Civil Engn; Padang State Univ, Dept Civil Engn},
Abstract = {Camera phones, online sites, and social media have been developing
   rapidly within the past decade, resulting in large numbers of flood
   occurrences visual media being freely accessible online. Situ Duit
   Bridge, one of the river crossings of Ciliwung River, located in North
   Bogor District, Bogor City, Indonesia, is well-known to be prone to
   flooding. For the area with limited observation data, as an alternative,
   online visual media, such as photo and video documentation, can be used
   as part of the evaluation of flood modelling. The study provided a
   review of Ciliwung River flood events at Situ Duit Bridge using online
   visual media from various sources, including local online news, social
   media sites, and online-based videos. The flood model was established
   using modified-DSM derived from DJI Phantom 3 Professional Drone, where
   the discharges of Q2, Q50, Q100, and Q200 were calculated with the
   Nakayasu SUH Method. Furthermore, the flood model was set up using
   HEC-RAS 5.0.7, whereas Digimizer 5.4.4 was utilized as the software to
   perform the image analysis. Finally, from the coefficient of
   determination (R-2) result of 0.7 (high relationship), the study showed
   that apart from the limitations, online available visual media is
   applicable as an alternative to connect flood models with
   near-real-world observations for areas with limited monitoring data.},
