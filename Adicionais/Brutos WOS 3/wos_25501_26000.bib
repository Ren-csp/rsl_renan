@article{ WOS:000173127400005,
Author = {Hubbard, TL and Motes, MA},
Title = {Does representational momentum reflect a distortion of the length or the
   endpoint of a trajectory?},
Journal = {COGNITION},
Year = {2002},
Volume = {82},
Number = {3},
Pages = {B89-B99},
Month = {JAN},
Note = {24th European Conference on Visual Perception, KUSADASI, TURKEY, AUG
   26-30, 2001},
Abstract = {Observers viewed a moving target, and after the target vanished,
   indicated either the initial position or the final position of the
   target. In Experiment 1, an auditory tone cued observers to indicate
   either the initial position or the final position; in Experiment 2,
   different groups of observers indicated the initial position or the
   final position. Judgments of the initial position were displaced
   backward in the direction opposite to motion, and judgments of the final
   position were displaced forward in the direction of motion. The data
   suggest that the remembered trajectory is longer than the actual
   trajectory, and the displacement pattern is not consistent with the
   hypothesis that representational momentum results from a distortion of
   memory for the location of a trajectory. (C) 2002 Elsevier Science B.V.
   All rights reserved.},
