@inproceedings{ WOS:000171630600024,
Author = {Johanson, M and Chaplin, JE and Wedlund, JE},
Editor = {Pfafflin, M and Fraser, RT and Thorbecke, R and Specht, U and Wolf, P},
Title = {A holistic neurorehabilitation programme for people with epilepsy -
   Theoretical approach, evaluation and long-term follow up},
Booktitle = {COMPREHENSIVE CARE FOR PEOPLE WITH EPILEPSY},
Series = {CURRENT PROBLEMS IN EPILEPSY},
Year = {2001},
Volume = {16},
Pages = {203-211},
Note = {10th Bethel Cleveland-Clinic Symposium, BIELEFELD, GERMANY, APR, 1999},
Abstract = {The starting point for the programme has been the recognition that a
   large group of individuals with epilepsy receive very little assistance
   to deal with the deep-rooted effect epilepsy has on their self-image.
   These problems are often not treated because a comprehensive approach to
   rehabilitation is missing in this area. A poor self-image is resistant
   to change, and in order for treatment to be successful, a rehabilitation
   programme has to foster positive changes through integration of
   knowledge and insight into the self. Therefore, in line with
   rehabilitation programmes offered to people with brain damage, a
   holistic neuropsychological rehabilitation programme for people with
   therapy-resistant epilepsy was developed at Stora Skondal Hospital in
   Sweden. This chapter describes the programme and an evaluation of
   twenty-one participants.
   The programme starts with a 2-day individual assessment session. The
   participants then come together, in groups of five, to attend the 16-day
   activity over a period of 8 weeks. They receive group therapy integrated
   with memory and relaxation training and an epilepsy education course.
   There are also three additional group therapy meetings after the
   programme as a follow-up Standardized evaluation instruments are given
   to the participants, before and after the programme. A long-term
   follow-up (up to 5 years post-programme) is also carried out.
   The outcomes of the pilot evaluation reveal significant improvements in
   attitudes to seizures; work and social function; health perceptions; and
   total quality of life. Scores of somatization; obsessive-compulsive
   behaviour; interpersonal sensitivity, psychoticism and total
   psychopathology also reduced significantly.},
