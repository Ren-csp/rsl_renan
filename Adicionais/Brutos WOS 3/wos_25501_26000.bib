@inproceedings{ WOS:000223848900013,
Author = {Vergara, N and Moreno-Grau, S and Moreno, J and Elvira, B and
   Martínez-García, MJ and García-Sánchez, A and Moreno-Clavel, JY},
Editor = {Brebbia, CA},
Title = {Tracking industrial influence on air pollution by dustfall
   characterization},
Booktitle = {AIR POLLUTION XII},
Series = {ADVANCES IN AIR POLLUTION SERIES},
Year = {2004},
Volume = {14},
Pages = {121-129},
Note = {12th International Conference on Modelling, Monitoring and Management of
   Air Pollution, Rhodes, GREECE, 2004},
Organization = {Wessex Inst Technol},
Abstract = {Industrial activity in the area of Cartagena has experienced a deep
   change in the last two decades. On the one hand some industries have
   ceased their activities, for example a lead smelter and a fertilizer
   plant, while others have come, for example general electric plastics or
   strontium chemistry. On the other hand, pollution control mechanisms
   have improved their efficiency and those responsible for the environment
   among the industries have assumed their role. The facts mentioned above
   influence the atmospheric environment. A profound study from different
   perspectives will help to extract conclusions and give the feasibility
   for future plans.
   This paper presents the results from 13 years of settleable particulate
   matter sampling from six different sampling points in the city of
   Cartagena, in particular the effect on dustfall composition due to the
   cessation of activities of two industrial activities, the lead smelter
   in March 1992 and the fertilizers plant in December 2001. Both factories
   were located inside the city and had a tremendous impact on the
   population, not only because of the pollutant concentration released by
   their activities but on people's perception. Detailed observation of the
   results has stressed the influence that the presence of these factories
   over time had on air quality.
   The samples were obtained based on the British Standard Norm 1747. In
   this norm the analytical and valuation techniques used for chemical
   pollutants presents in the atmosphere are established. In this paper the
   results of Total Settleable Particulate Matter weight, soluble and
   insoluble fraction and pH from 1991 to 2003 are presented.},
