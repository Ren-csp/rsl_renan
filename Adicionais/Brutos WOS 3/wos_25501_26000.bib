@inproceedings{ WOS:000189433200010,
Author = {Cervero, R and Tsai, YH},
Book-Group-Author = {TRB},
Title = {Job access and reverse commuting initiatives in California - Review and
   assessment},
Booktitle = {SUSTAINABILITY AND ENVIRONMENTAL CONCERNS IN TRANSPORTATION 2003: ENERGY
   AND ENVIRONMENT},
