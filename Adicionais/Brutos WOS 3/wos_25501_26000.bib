@article{ WOS:A1996TR32600008,
Author = {Zuker, CS},
Title = {The biology of vision in Drosophila},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1996},
Volume = {93},
Number = {2},
Pages = {571-576},
Month = {JAN 23},
Note = {Colloquium on Vision - From Photon to Perception, NATL ACAD SCI, IRVINE,
   CA, MAY 20-22, 1995},
Abstract = {Phototransduction systems in vertebrates and invertebrates share a great
   deal of similarity in overall strategy but differ significantly in the
   underlying molecular machinery. Both are rhodopsin-based G
   protein-coupled signaling cascades displaying exquisite sensitivity and
   broad dynamic range, However, light activation of vertebrate
   photoreceptors leads to activation of a cGMP-phosphodiesterase effector
   and the generation of a hyperpolarizing response. In contrast,
   activation of invertebrate photoreceptors, like Drosophila, leads to
   stimulation of phospholipase C and the generation of a depolarizing
   receptor potential. The comparative study of these two systems of
   phototransduction offers the opportunity to understand how similar
   biological problems may be solved by different molecular mechanisms of
   signal transduction. The study of this process in Drosophila, a system
   ideally suited to genetic and molecular manipulation, allows us to
   dissect the function and regulation of such a complex signaling cascade
   in its normal cellular environment. In this manuscript I review some of
   our recent findings and the strategies used to dissect this process.},
