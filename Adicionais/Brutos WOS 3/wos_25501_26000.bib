@inproceedings{ WOS:000444861300017,
Author = {Apronti, Priscilla Toloo and Boakye-Danquah, John and Antwi, Effah
   Kwabena},
Editor = {Saito, O and KranjacBerisavljevic, G and Takeuchi, K and Gyasi, EA},
Title = {The State of Disaster Risk Reduction Mainstreaming in Pre-tertiary
   Education in Ghana: An Exploratory Study},
Booktitle = {STRATEGIES FOR BUILDING RESILIENCE AGAINST CLIMATE AND ECOSYSTEM CHANGES
   IN SUB-SAHARAN AFRICA},
Series = {Science for Sustainable Societies},
Year = {2018},
Pages = {313-330},
Note = {1st International Conference on Enhancing Resilience to Climate and
   Ecosystem Changes in Semi-Arid Africa, Univ Dev Studies, Tamale, GHANA,
   AUG 06-07, 2014},
Organization = {Integrated Res Syst Sustainabil Sci},
Abstract = {In an era of increased climate-induced disasters, education related to
   disaster prevention, preparedness, and management has become crucial. In
   response, the government of Ghana and other stakeholders have initiated
   programs and policies aimed at integrating disaster risk reduction (DRR)
   into educational curricula. This study assessed the current level of DRR
   integration in the pre-tertiary education system in Ghana by assessing
   teachers' perceptions and preparedness to handle DRR lessons and the
   challenges they experience. Using secondary data and in-depth interviews
   with officials from the Ghana Education Service (GES), National Disaster
   Management Organisation (NADMO), and Environmental Protection Agency
   (EPA), information on the current level of DRR integration in the
   pre-tertiary education system in Ghana was reviewed. Semi-structured
   questionnaires were also used to obtain information from teachers
   sampled from selected schools in the La Nkwantanang District of the
   Greater Accra Region. The results revealed that the level of DRR
   integration in pre-tertiary schools remain low, and challenges to
   further integration include inadequate teacher training and learning
   materials and poor support from disaster management organizations. These
   factors adversely affect the ability of teachers to impart DRR knowldge
   and mainstreaming of DRR into pre-tertiary education in Ghana.
   Therefore, the findings suggest that training teachers in the delivery
   of DRR lessons at the pre-tertiary level should be prioritized in Ghana.
   In addition, disaster management organizations should be encouraged to
   partner with schools to support the practical teaching of DRR lessons to
   be able to enhance the knowledge and skills of both students and
   teachers.},
