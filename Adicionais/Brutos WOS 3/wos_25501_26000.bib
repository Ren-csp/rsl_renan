@article{ WOS:000173192700005,
Author = {Redfern, MS and Cham, R and Gielo-Perczak, K and Grönqvist, R and
   Hirvonen, M and Lanshammar, H and Marpet, M and Pai, CYC and Powers, C},
Title = {Biomechanics of slips},
Journal = {ERGONOMICS},
