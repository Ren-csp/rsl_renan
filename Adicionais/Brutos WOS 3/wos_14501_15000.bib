Title = {A Customized JAVA OpenStreetMap Preset to Extract Solar Panel
   Installations for Humanitarian Purposes},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 1, INPUT 2023},
Series = {Lecture Notes in Civil Engineering},
Year = {2024},
Volume = {467},
