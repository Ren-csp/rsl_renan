@inproceedings{ WOS:000333329600019,
Author = {Englitz, Bernhard and Akram, S. and David, S. V. and Chambers, C. and
   Pressnitzer, Daniel and Depireux, D. and Fritz, J. B. and Shamma, Shihab
   A.},
Editor = {Moore, BCJ and Patterson, RD and Winter, IM and Carlyon, RP and Gockel, HE},
Title = {Putting the Tritone Paradox into Context: Insights from Neural
   Population Decoding and Human Psychophysics},
Booktitle = {BASIC ASPECTS OF HEARING: PHYSIOLOGY AND PERCEPTION},
