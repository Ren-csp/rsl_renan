@inproceedings{ WOS:000346067900116,
Author = {Yan, C. Z. and Xue, P. Y.},
Editor = {Lekkas, TD},
Title = {COPPER ACCUMULATION, TOLERANCE AND RELEASE BY A SUBMERGED AQUATIC PLANT
   MYRIOPHYLLUM SPICATUM L.},
Booktitle = {PROCEEDINGS OF THE 13TH INTERNATIONAL CONFERENCE ON ENVIRONMENTAL
   SCIENCE AND TECHNOLOGY},
Series = {Proceedings of the International Conference on Environmental Science and
   Technology},
Year = {2013},
Note = {13th International Conference on Environmental Science and Technology
   (CEST), Athens, GREECE, SEP 05-07, 2013},
Organization = {Univ Aegean; Global Network Environm Sci \& Technol},
Abstract = {Myriophyllum spicatum L. is a common macrophyte in aquatic environments
   and is often considered as preferred aquatic plants in phytoremediation.
   We investigated Cu accumulation, tolerance and release of the submerged
   aquatic plant M. spicatum and its potential for Cu phytoremediation.
   Plant shoots accumulated Cu with a maximum of 18 735 mg Cu kg(-1) dry
   weight after exposed to 62.5 mu M Cu for 4 d, and the 96 h EC50 for M.
   spicatum was about 2.43 mu M of external Cu concentration. In the low
   concentration range, Cu uptake was linear in relation to the external
   concentration, but in the high concentration range it exhibited a
   hyperbolic curve which was best described by the Michaelis-Menten
   equation with good correlation coefficient (R-2 = 0.980). The kinetics
   parameters, Vmax and Km, were found to be 2.49 +/- 0.19 mu mol g(-1) DW
   min(-1) and 146 +/- 31.8 mu M respectively. Subcellular fractionation of
   Cu-containing tissues showed that most of the accumulated Cu was
   isolated to cell walls in leaves and soluble fraction and cell walls in
   stems. Cu uptake by leaves was concentrated predominantly in cell walls
   (67-71\%), followed by soluble (21-27\%) and organelle fractions (6-9\%)
   when shoots were exposed to 2 mu M Cu for different times. However, Cu
   uptake by stems was significantly less than that by leaves. Cu
   concentration in subcellular fraction of stems was sorted as follows:
   cell walls (35-46\%) = soluble (35-53\%) > organelle fractions (8-22\%).
   Moreover, shoots took up Cu from solution rapidly, but also released Cu.
   It is believed that the release of metals from leaf tissues may be a
   mechanism of metal detoxification in plants. During the 24 h period of
   no Cu exposure, the amount of Cu efflux increased from 0.04 to 0.24 mu
   M. However, it was much less than the amount (6\%) of Cu accumulation by
   plant. Since Cu efflux from shoot was much lower than that extracted by
   plants from solutions, the efflux ability may not affect its potential
   to be used as Cu phytoremediator. Therefore, M. spicatum is suggested as
   an efficient plant species for the treatment of moderately
   copper-contaminated waters, and may play a significant role in the Cu
   biogeochemical cycle in aquatic environments.},
