Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {This paper resumes the first part of a study which aims at assessing the
   performance of single-track transit systems and improving it by means of
   appropriate regulation techniques of train running. Firstly, theoretical
   performance is evaluated by assuming normal undisturbed operation; this
   analysis aims at providing a planning-level method to verify whether
   single-tracking is suitable for a particular application. Then, effects
   of train delays on system performance are investigated and train
   regulation criteria are discussed. Both an analytic model of
   single-track transit system operation and computer simulation are
