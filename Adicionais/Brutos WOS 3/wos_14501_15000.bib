@article{ WOS:000235472400004,
Author = {Swallow, SK and McGonagle, MP},
Title = {Public funding of environmental amenities: Contingent choices using new
   taxes or existing revenues for coastal land conservation},
Journal = {LAND ECONOMICS},
Year = {2006},
Volume = {82},
