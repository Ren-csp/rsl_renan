@inproceedings{ WOS:000223250200067,
Author = {Mussa, R and Selekwa, MF},
Editor = {Wadhwa, LC},
Title = {Optimization of signal timing,transition period},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
