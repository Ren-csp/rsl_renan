Title = {Alkalibacillus huanghaiensis sp nov., a new strain of moderately
   halophilic bacterias isolated from sea water of the Yellow Sea in China},
Booktitle = {ADVANCES IN ENVIRONMENTAL SCIENCE AND ENGINEERING, PTS 1-6},
