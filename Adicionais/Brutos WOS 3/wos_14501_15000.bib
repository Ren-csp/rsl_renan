@inproceedings{ WOS:001792804400059,
Author = {Garau, Chiara and Desogus, Giulia and Banchiero, Federica and Mistretta,
   Pasquale},
Editor = {LaRosa, D and Privitera, R},
Title = {A Multicultural Tourism for Evaluating the Cultural Heritage: The Case
   Study of the Region of Sardinia (Italy)},
