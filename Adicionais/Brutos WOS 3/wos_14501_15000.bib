Title = {ANALYSIS OF ENERGY-SAVING POTENTIAL OF VENTILATION IN TRANSITIONAL
   SEASONS},
Booktitle = {FIFTH INTERNATIONAL WORKSHOP ON ENERGY AND ENVIRONMENT OF RESIDENTIAL
   BUILDINGS AND THIRD INTERNATIONAL CONFERENCE ON BUILT ENVIRONMENT AND
   PUBLIC HEALTH, VOL I AND II, PROCEEDINGS},
Year = {2009},
Pages = {803-810},
Note = {5th International Workshop on Energy and Environment of Residential
   Buildings/3rd International Conference on Built Environment and Public
   Health, Guilin, PEOPLES R CHINA, MAY 29-31, 2009},
Organization = {Hunan Univ; Univ Hong Kong; Tsinghua Univ},
Abstract = {The fundamental design idea of the hybrid system has been applied to the
   energy-saving potential analysis in ventilation of transitional seasons.
   It is found that the energy-saving potential is affected by various
   factors such as room load rate, minimum room fresh air demand, the
   permitted range of indoor air temperature in transitional seasons and
   working shift. The influencing laws and the significance degree are to
   be studied in this paper. Based on an example of a project, some special
   parameters are introduced to criticize the energy-saving potential such
   as energy-saving quantity of room load, energy-saving quantity of units,
   energy-saving rate of room load and energy-saving rate of units. The
   affecting mechanisms and basic laws of these factors are researched by
   means of single-factor test method. The energy-saving potential declines
   with the reducing working shift and room load rate. Subsequently, the
   significant degree is compared among different factors through the
   orthogonal test method. Working shift has significant effect on
   energy-saving quantity of room load and units. Other factors' ranking
   from bigger to smaller is room load rate, indoor lower limit design
   temperature, indoor upper limit design temperature and minimum room
   fresh air demand. Towards energy-saving rate of room load and unites, no
   factor's effect is significant. Besides, the best combinations are
   recommended to achieve the maximum energy-saving potential.},
