@inproceedings{ WOS:000073159500002,
Author = {Krstanoski, N},
Editor = {Sucharov, L and Bidini, G},
Title = {Impacts of stochasticity in rapid transit line operation on its
   performance characteristics},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {13-22},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {Capacity is one of the basic characteristic of rapid transit line
   performance that has been usually defined by the maximum number of
   trains/hour determined by the station with the longest dwell time
   assuming deterministic operation. However, the actual dwell times and
   headways between trains are random variables. They not only affect the
   line capacity, but also other performance measures such as the train
   load variability and the level of delays.
   The results of the research presented in this paper are based on a rapid
   transit line simulation model capable to simulate passenger volumes,
   passenger distribution among train doors, and boarding and alighting
   times at each station along the line. The findings indicated that the
   randomness of dwell times at stations has various significant impacts on
   the rapid transit line performance and particularly on the line
   capability to operate certain maximum number of trains per hour, that is
   on the line capacity. As a consequence, the classical deterministic
   definition of the line capacity is a rather insufficient and incomplete
   transit line performance characteristic. Instead, the author of this
   article, suggests a new measure: transit line maximum performance
   defined as the line capability to operate certain maximum number of
   trains per hour at given level-of-service determined by the level of
   delays and load factor variability.},
Publisher = {COMPUTATIONAL MECHANICS PUBLICATIONS LTD},
Address = {ASHURST LODGE, SOUTHAMPTON S04 2AA, HANTS, ENGLAND},
Type = {Proceedings Paper},
Language = {English},
