@inproceedings{ WOS:000252650000010,
Author = {Ganoulis, Jacques},
Editor = {Hlavinek, P and Bonacci, O and Marsalek, J and Mahrikova, I},
Title = {Modelling water quality for Integrated Water Resources Management at the
   basin scale},
Booktitle = {DANGEROUS POLLUTANTS (XENOBIOTICS) IN URBAN WATER CYCLE},
Series = {Nato Science for Peace and Security Series C - Environmental Security},
Year = {2008},
Pages = {89-99},
Note = {NATO Advanced Research Workshop on Dangerous Pollutants, (Xenobiotics)
   in Urban Water Cycle, Lednice, CZECH REPUBLIC, MAY 03-06, 2007},
Organization = {NATO},
Abstract = {The concept of Integrated Water Resources Management (IWRM) is a
   powerful tool for satisfying needs for freshwater, protecting the
   environment and ensuring sustainable socio-economic development. After
   explaining the meaning of IWRM, mathematical modelling of water quality
   is applied at the basin scale as a first step towards achieving
   environmental protection. In view of many uncertainties, a risk-based
   methodology is proposed for IWRM at the basin scale with special
   reference to transboundary river basins.},
