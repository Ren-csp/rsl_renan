@inproceedings{ WOS:000446248300018,
Author = {Marie, I. A. and Sugiarto, D. and Surjasa, D. and Witonohadi, A.},
Editor = {Rinanti, A and Hadisoebroto, R and Abdullah, AG and Nandiyanto, ABD},
Title = {Knowledge management system for risk mitigation in supply chain
   uncertainty: case from automotive battery supply chain},
Booktitle = {4TH INTERNATIONAL SEMINAR ON SUSTAINABLE URBAN DEVELOPMENT},
