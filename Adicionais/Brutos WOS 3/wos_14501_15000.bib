@inproceedings{ WOS:000351506700010,
Author = {Bratianu, Constantin},
Editor = {Rooney, J and Murthy, V},
Title = {Strategies to Enhance Intergenerational Learning in Universities},
Booktitle = {PROCEEDINGS OF THE 11TH INTERNATIONAL CONFERENCE ON INTELLECTUAL
   CAPITAL, KNOWLEDGE MANAGEMENT AND ORGANISATIONAL LEARNING (ICICKM 2014)},
Series = {Proceedings of the International Conference on Intellectual Capital
   Knowledge Management \& Organizational Learning},
Year = {2014},
Pages = {83-90},
Note = {11th International Conference on Intellectual Capital, Knowledge
   Management and Organisational Learning (ICICKM), Univ Sydney Business
   Sch, Sydney, AUSTRALIA, NOV 06-07, 2014},
Abstract = {The purpose of this paper is to present the main results obtained in a
   research project dedicated to intergenerational learning in
   universities. This project is a component of a larger European Project
   called SILVER Successful Intergenerational Learning through Validation,
   Education \& Research, coordinated by Inholland University for Applied
   Sciences, The Netherlands. Intergenerational learning is a complex
   process of knowledge sharing in an age structured organization.
   Intergenerational learning aims at increasing knowledge entropy of the
   whole organization, accelerating the learning process of the younger
   generation, and developing a shared vision. Also, intergenerational
   learning is important in reducing knowledge loss when people retire. Our
   research questions were: a) Are universities adequate organizations for
   intergenerational learning?, and if they are b) How can be developed and
   implemented strategies for enhancing intergenerational learning? We
   selected four pilot universities based on some significance criteria,
   and developed both qualitative and quantitative research programs for
   answering to our research questions. We were mostly interested by the
   intergenerational learning processes within the academic staff, and not
   between professors and students that reflect a different knowledge
   transfer process. In order to answer to the first research question we
   analyzed all necessary data concerning age structure and academic rank
   structure of the academic staff in each university. Results demonstrate
   that within each university there is a clear nested or layered age
   structure, which means almost a perfect Nonakian Ba for stimulating
   intergenerational learning. In order to answer to the second research
   question we organized interviews with some of the leaders of these
   universities, and we applied questionnaires to all decision makers (i.e.
   rectors, vice-rectors, deans, and head of departments) of each
   university. Our questions aimed at evaluating the level of awareness of
   the leading staff about the nature and importance of intergenerational
   learning, as well as identifying the main barriers in developing and
   implementing strategies to enhance intergenerational learning.},
