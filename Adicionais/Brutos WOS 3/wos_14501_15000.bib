@article{ WOS:A1994NN06400035,
Author = {SCHRODER, B and DANNECKER, W},
Title = {VEHICLE EMISSIONS AS THE MAJOR SOURCE OF GASEOUS AROMATIC-HYDROCARBONS
   AT DIFFERENT LOCATIONS IN GERMANY},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {1994},
Volume = {147},
Pages = {275-279},
Month = {MAY 23},
Note = {4th International Symposium on Highway Pollution, MADRID, SPAIN, MAY
   18-22, 1992},
Abstract = {Fourteen gaseous aromatic hydrocarbons have been measured in four
   1-month monitoring campaigns. Sampling locations included a rural site,
   a small town, an urban and an industrial site, all in western Germany.
   Twenty-four-hour samples were collected on activated charcoal, avoiding
   immediate traffic impact. Analyses were carried out by GC/ITD. Average
   concentrations of the total of all quantified compounds ranged from 2
   mug/m3 at the rural site to 17 mug/m3 at the urban site. For source
   determination, the data were normalized by the respective o-xylene
   concentrations. Average values of normalized concentrations showed only
   small standard deviations and at all locations were similar to data
   found for highway tunnel exhaust air, thus indicating vehicle emissions
   as the common source.},
