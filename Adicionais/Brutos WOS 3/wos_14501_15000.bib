@inproceedings{ WOS:000238644700005,
Author = {San Jose, R. and Perez, J. L. and Gonzalez, R. M.},
Editor = {Longhurst, JWS and Brebbia, CA},
Title = {Air quality street level simulations by using an integrated mesoscale
   air quality modelling system (MM5-CMAQ-EMIMO) and a CFD model (MIMO)::
   Madrid case study},
Booktitle = {AIR POLLUTION XIV},
Series = {WIT Transactions on Ecology and the Environment},
