Booktitle = {INTERNATIONAL CONFERENCE ON TIMING AND TIME PERCEPTION},
Series = {Procedia Social and Behavioral Sciences},
Year = {2014},
Volume = {126},
Pages = {29-33},
Note = {International Conference on Timing and Time Perception, GREECE, MAR
   31-APR 03, 2014},
Abstract = {It is often believed that the integration of information over time is
   similar at the unconscious and conscious levels. Here we will present
   four different studies suggesting that the time resolution of
   unconscious information processing is much better than previously
   believed, but also that information is not integrated over such short
   intervals like it is at larger times. Even though information is
   unconsciously processed in an almost continuous fashion, it is its time
   consuming integration that leads to a conscious and meaningful percept.
   We show how neuronal correlates, like e. g., the phase of neuronal
   oscillations, are associated with this transformation. (C) 2014 The
   Authors. Published by Elsevier Ltd.},
