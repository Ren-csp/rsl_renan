   and Kha, Pham Thi and Dung, Pham Tien and Luu, Nguyen Thi Mai and
   Roccaro, Paolo and La Rosa, Daniele and Nhon, Dang Hoai},
Editor = {Marucci, A and Zullo, F and Fiorini, L and Saganeiti. L},
Title = {Distribution of Polycyclic Aromatic Hydrocarbons and Organochlorine
   Pesticides in Two Coastal Sediment Cores in the Mong Cai Area, Vietnam},
Booktitle = {INNOVATION IN URBAN AND REGIONAL PLANNING, VOL 1, INPUT 2023},
