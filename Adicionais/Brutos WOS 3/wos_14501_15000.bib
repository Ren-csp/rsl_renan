Pages = {77-90},
Month = {MAY},
Note = {Annual Meeting of the
   Association-for-Research-in-Vision-and-Ophthalmology, FT LAUDERDALE, FL,
   MAY 11-17, 1997},
Organization = {Assoc Res Vis \& Ophthalmol},
Abstract = {The present study investigated the spatial interaction between the
   generic view and accidental view. First, the generic-view principle was
   applied to the three-dimensional motion of a wire-frame cube. Second,
   the effects of inner rotating dots and generic/accidental views of inner
   bars on an accidental view of a cube were investigated to show the
   spatial interaction between generic and accidental views. This
   investigation revealed that the generic view of a rotating cube
   generated a clearer three-dimensional perception than the accidental
   view, which is consistent with the generic-view principle. Both the
   unambiguous three-dimensional cue of inner dots and the generic view of
   inner bars ``captured{''} the depth perception of the accidental view of
   the rotating cube. This finding suggests that the generic-view principle
   not only works locally, but then propagates globally. Further, it
   indicates how the visual system implements the generic-view principle to
   incorporate more complicated scenes.},
