@inproceedings{ WOS:000562941100138,
Author = {Guo, L. Z. and Liu, F. Q. and Wu, Z. Z.},
Editor = {Weng, CH},
Title = {Study on development mode and regulation of water-land-ecology-economy
   in Sanjiang Plain, China},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON WATER RESOURCE AND ENVIRONMENT (WRE
   2019)},
Series = {IOP Conference Series-Earth and Environmental Science},
Year = {2019},
Volume = {344},
Note = {5th International Conference on Water Resource and Environment (WRE) /
   1st International Conference on Advances in Civil and Ecological
   Engineering Research (ACEER), Macau Univ Sci \& Technol, Macao, PEOPLES
   R CHINA, JUN 16-19, 2019},
Abstract = {Sanjiang Plain is an important grain yield base and ecological
   demonstration zone of China. Its ecological security, food production,
   and GDP development can support the sustainable development of SJP.
   China government focuses on the supply and utilization of resources and
   grain yield, local government pays attention to the gross domestic
   product of all sorts of industry, local residents concern the area of
   paddy and dry lands. This paper takes GDP, grain yield, and ecological
   service value as our targets under Normal water year and dry year. 8
   kinds of land use (dry land, rice (irrigation), rice (rainfed), forest,
   grassland, wetland, water area, residents), 3 types of industrial
   development (primary industry, secondary industry, tertiary industry), 3
   sorts of water sources (surface water, groundwater, transit water) and 7
   ways of water utilization (urban domestic water, rural domestic water,
   primary industry water, secondary industry water demand, tertiary
   industry water demand, urban ecological water demand, wetland Ecological
   water demand) are considered. A comprehensive configuration model of the
   Sanjiang Plain in the near future (2020) and mid-term future (2025) is
   presented, which is solved by an optimize software of lingo. The results
   derived show that the GDP will increase by 50\%, the grain output will
   double, and there is also a slight increase of the ecological service
   value at 2025.},
