Organization = {European Space Agcy},
Abstract = {Climate maps are a common and basic tool for planners in local and
   regional authorities. Especially in cities or urban agglomerations,
   where environmental and climatic problems are manifold, it is important
   to have detailed aid updated maps. The paper shows an example of how
   satellite data of ERS-1 and LANDSAT-TM are used in combination with a
   digital terrain model, digital terrain analysis and a rule-based
   classification scheme to create climate maps in scales of 1 : 25000 to 1
   : 100000. The work was carried out in close cooperation with the
   relevant planning agencies to guarantee full agreement and acceptance of
   the results. The method is now at on operational stage and can be
   approved for other locations.},
