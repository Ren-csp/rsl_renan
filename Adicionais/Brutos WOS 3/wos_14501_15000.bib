Title = {Analysis of the impact of fuel consumption on mortality rates in Sao
   Paulo},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {435-444},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {The paper examines the impact of fuel type on air pollution - and
   thereby on human health. It presents the results of a time series
   analysis relating the consumption of ethanol and fossil fuels and
   measures of air pollution with respiratory and cardiovascular mortality
   in elderly people in Sao Paulo for the period January 1991 to December
   1994. The results of a linear regression analysis show a significant
   association between air pollution and mortality due to respiratory
   diseases; PM10 presented the highest association among the pollutants.
   Although the different temporal basis of the data on fuel consumption
   did not enable a direct association with daily mortality to be
   established, the results suggest that there is an indirect relationship
   between higher levels of ethanol and lower levels of both PM10
   concentrations and mortality from respiratory diseases in elderly
   people.},
