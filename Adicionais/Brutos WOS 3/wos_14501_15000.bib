@article{ WOS:000171577400010,
Author = {Larsen, JT and McGraw, AP and Cacioppo, JT},
Title = {Can people feel happy and sad at the same time?},
Journal = {JOURNAL OF PERSONALITY AND SOCIAL PSYCHOLOGY},
Year = {2001},
Volume = {81},
Number = {4},
Pages = {684-696},
Month = {OCT},
Note = {Annual Meeting of the Society-for-Personality-and-Social-Psychology,
   NASHVILLE, TENNESSEE, FEB, 2000},
Organization = {Soc Personal \& Social Psychol},
Abstract = {The authors investigated whether people can feel happy and sad at the
   same time. J. A. Russell and J, M, Carroll's (1999) circumplex model
   holds that happiness and sadness are polar opposites and, thus, mutually
   exclusive. In contrast, the evaluative space model (J. T. Cacioppo \& G.
   G. Berntson, 1994) proposes that positive and negative affect are
   separable and that mixed feelings of happiness and sadness can co-occur.
   The authors both replicated and extended past research by showing that
   whereas most participants surveyed in typical situations felt either
   happy or sad, many participants surveyed immediately after watching the
   film Life Is Beautiful, moving out of their dormitories, or graduating
   from college felt both happy and sad. Results suggest that although
   affective experience may typically be bipolar, the underlying processes,
   and occasionally the resulting experience of emotion, are better
   characterized as bivariate.},
Publisher = {AMER PSYCHOLOGICAL ASSOC},
