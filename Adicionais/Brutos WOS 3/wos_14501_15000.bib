Title = {Cells with multiple micronuclei in cat scratch disease},
Booktitle = {IRPA9 - 1996 INTERNATIONAL CONGRESS ON RADIATION PROTECTION / NINTH
   INTERNATIONAL CONGRESS OF THE INTERNATIONAL RADIATION PROTECTION
   ASSOCIATION, PROCEEDINGS, VOL 3},
Year = {1996},
