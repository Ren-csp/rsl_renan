@inproceedings{ WOS:000079630400069,
Author = {Ueyama, E and Yuasa, H and Hosoe, S and Ito, M},
Editor = {Usui, S and Oori, T},
Title = {Figure-ground separation from motion-subjective contour and front
   dynamics},
Booktitle = {ICONIP'98: THE FIFTH INTERNATIONAL CONFERENCE ON NEURAL INFORMATION
   PROCESSING JOINTLY WITH JNNS'98: THE 1998 ANNUAL CONFERENCE OF THE
   JAPANESE NEURAL NETWORK SOCIETY - PROCEEDINGS, VOLS 1-3},
Year = {1998},
Pages = {311-314},
Note = {5th International Conference on Neural Information Processing (ICONIP
   98) / 1998 Annual Conference of the Japanese-Neural-Network-Society
   (JNNS 98), KITAKYUSHU, JAPAN, OCT 21-23, 1998},
Organization = {Japanese Neural Network Soc; Asian Pacific Neural Network Assembly},
Abstract = {When we see an animation in which a small region of random texture moves
   on the background of random texture, we perceive that the small region
   is separated from the background as a moving object. We call this
   phenomenon figure-ground separation from motion. Playing it back
   relatively slowly, we perceive that the contour of the region becomes
   rounded. So, this contour can be regarded as a subjective contour. By
   the way, patterns generated by a reaction-diffusion equation also become
   rounded in process of time evolution. We consider that this equation is
   a suitable model for deformation of the subjective contour. Then, we
   generate the separation pattern by using this equation, confirm that the
   front of the pattern coincides with the subjective contour
   qualitatively, and claim that our model is useful.},
