Title = {Climate Change-Present Scenario in Parts of India; Needed Preventive
   Measures and Role of Earth System Scientists},
Booktitle = {ENGINEERING GEOLOGY FOR SOCIETY AND TERRITORY, VOL 1: CLIMATE CHANGE AND
   ENGINEERING GEOLOGY},
