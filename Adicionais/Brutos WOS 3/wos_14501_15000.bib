@inproceedings{ WOS:000223250200080,
Author = {Marusic, D and Stazic, T},
Editor = {Wadhwa, LC},
Title = {Impact of roads on the landscape of a suburban area},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2004},
Volume = {16},
Pages = {821-828},
Note = {10th International Conference on Urban Transport and the Environment in
   the 21st Century, Dresden, GERMANY, MAY 19-21, 2004},
Organization = {Wessex Inst Technol; Advances Transport Book Series},
Abstract = {New planned roads change the landscape of the suburban area through
   which they run. In order to evaluate this change, it is necessary to
   define landscape values of a suburban area that roads passes through and
   define the road corridors that influence the natural, cultural and
   anthropological values of the explored area. Since the route of the road
   is not only defined by, landscape values, but is also defined by minimum
   construction costs, by land topography or by land use, obviously several
   alternative routes will appear. The analyses of route alternatives bring
   out criteria that are the basis for evaluation of the solutions in order
   to determine the one with minimum impact on the landscape. The influence
   of roads on the landscape of a suburban area will be presented for the
