Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {Dealing with long-term issues is an essential element of transportation
   and mobility policies. In this paper some global and regional
   developments with a wide time horizon are outlined, the relationship
   between mobility needs or demand and technological approaches is
   discussed and the special function of technological innovations is
   touched upon. In a way the paper can be understood as part of an agenda
