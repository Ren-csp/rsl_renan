@inproceedings{ WOS:000263364800005,
Author = {Li Nan and Cao Yake},
Editor = {Zhang, Y},
Title = {A Research on Positive Psychological Capital and the Human Resource
   Management of Chinese Tourism Enterprises},
Booktitle = {PROCEEDINGS FOR THE 2008 EURO-ASIA CONFERENCE ON ENVIRONMENT AND
   CORPORATE SOCIAL RESPONSIBILITY: TOURISM, MICE AND MANAGEMENT TECHNIQUE
   SESSION},
Year = {2008},
Pages = {31+},
Note = {Euro-Asia Conference on Environment and Corporate Social Responsibility
   - Tourism, MICE and Management Technique Session, Tianjin, PEOPLES R
   CHINA, JAN 18-19, 2008},
Abstract = {Tourism services, which unify tangible carriers and intangible services,
   are different from other services. This is because tourism services aim
   at satisfying both material and spiritual demand of tourists. Therefore,
   working attitudes and emotion of employees not only influence the
   service quality, but also determines the marketing reputation and
   economic incomes of tourism enterprises to a large extent. This article
   focuses on figuring out the influences of positive psychology capital,
   which is composed of emotional intelligence and affective work, on the
   human resource management of Chinese tourism enterprises. The authors
   put forward that positive psychological capital can be used as an
   important resource to cultivate competitive advantages of Chinese
   tourism enterprises, since it inspires employees to surpass personal
   emotion with building positive working system and cultivating excellent
   enterprise culture. In other words, positive psychological capital can
   inspire all employees to strive for common targets and creates the
   completive advantages for Chinese tourism enterprises.},
