@inproceedings{ WOS:000404786200003,
Author = {Zarezadeh, Vahid and Giacomoni, Marcio},
Editor = {Dunn, CN and VanWeele, B},
Title = {Incorporating Dynamic Land Use Change into Hydrologic Model to Assess
   Urbanization Effects on Hydrologic Flow Regime},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2017: WATERSHED
   MANAGEMENT, IRRIGATION AND DRAINAGE, AND WATER RESOURCES PLANNING AND
   MANAGEMENT},
Year = {2017},
Pages = {22-32},
Note = {17th Annual World Environmental and Water Resources Congress,
   Sacramento, CA, MAY 21-25, 2017},
Organization = {Amer Soc Civil Engineers; Amer Soc Civil Engineers, Environm \& Water
   Resources Inst},
Abstract = {Population growth and urbanization are major threats to the
   sustainability of watersheds. The increase of impervious areas in
   watersheds results in more surface runoff generation during storm
   events, which can increase risk of flooding, and also reduce the
   recharge of aquifers and base flow of rivers. Consequently, accurate
   representation of land cover changes in watersheds is very important to
   adequately identify its impacts on water bodies. Most of event-based and
   continuous simulation hydrologic models consider land cover as a static
   parameter. However, in fact, the land use change is dynamic in urban
   areas and can have profound impacts in the main hydrologic processes.
   This study proposes the use of a cellular automata (CA) model to
   represent land use change and its interactions with the hydrologic
   cycle. The CA land use change model represents urban sprawl by
   calculating the likelihood of changing the state of an undeveloped cell
   to urban based on spatial factors such as number of developed neighbors,
   distance to roads and central areas. The CA model is connected to the
   soil and water assessment tool (SWAT) model, to assess impacts of land
   use change on stream flow and also identify how dynamic land use change
   improve watershed simulations. This method was applied in an urban
   watershed in San Antonio, TX, which is experiencing one of the highest
   rates of population growth in the US and faces tremendous stormwater and
   drought challenges.},
Publisher = {AMER SOC CIVIL ENGINEERS},
