Editor = {Creatsas, G and Mastorakos, G and Chrousos, GP},
Title = {PID: Clinical and laparoscopic aspects},
Booktitle = {YOUNG WOMAN AT THE RISE OF THE 21ST CENTURY: GYNECOLOGICAL AND
   REPRODUCTIVE ISSUES IN HEALTH AND DISEASE},
Series = {Annals of the New York Academy of Sciences-Series},
