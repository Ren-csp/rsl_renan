@inproceedings{ WOS:000303697300039,
Author = {Han Guang and Li Li},
Editor = {Chen, XH and Zhang, HJ and Zhang, H},
Title = {Some Insights into the Stormwater Management in Changsha City},
Booktitle = {LOW-CARBON MODEL WHEN PURSUIT OF URBANIZATION IN CHINA},
Year = {2011},
Pages = {201+},
Note = {2nd International Symposium on Sustainable Development of City Group
   (ISSDCG), Cent S Univ, Changsha City, PEOPLES R CHINA, AUG 20-22, 2011},
Organization = {Hunan Provincial Syst Engn \& Management Soc},
Abstract = {By analyzing the present status of stormwater management in Changsha
   City, the article points out that the feeble management primarily
   results from the combined sewers, imperfect drainage system, and lacking
   advanced ideas and foresighted perspectives. In terms of the specific
   requirements for constructing environmentally-friendly and
   resource-saving society, it puts forwards such principles as preferring
   source control to end treatment, combining resource reduction with
   recycle, incorporating decentralized prevention with concentrated
   treatment, effective performance and usage of existing facilities
   coupled with retrofitting and complementation, active public involvement
   and effective cooperations. For the purpose of scientific management of
   urban stormwater, it is indispensible to develop bold practical
   regulations, establish a robust coordination agency, ensure sufficient
   specific funds, stringently govern urban planning, take medium-scale
   watersheds or communities as spatial units to perform intensively, and
   determine appropriate urban drainage system according to local
   conditions in the light of the above principles.},
