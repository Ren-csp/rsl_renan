@inproceedings{ WOS:000073159500016,
Author = {Soehodho, S},
Editor = {Sucharov, L and Bidini, G},
Title = {Development of genetic-taxonomy evaluator for finding shortest path in
   transportation planning systems},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {177-191},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {This research is aimed at elaborating a new methodology of shortest path
   finding by using the capability of taxonomy systems and genetic
   algorithms. Combination of the two developed in this research is called
   Genetic Taxonomy Evaluator (GTE) which is expected to be an effective
   and efficient tool compared to conventional method that enumerates any
   possible combination of links within the network. While keeping the
   characteristics of transportation networks TR transforms the networks
   into taxonomy structure which is hierarchically shaped based on problem
   to be solved. In the process TR also creates classification of nodes in
   the network. This classification provides facilities to isolate the
   problem to the core. and criteria that call be inserted in the genetic
   algorithm. Furthermore, the methodology is to be analyzed to comprehend
   the performance and benefits compared to conventional method. So a
   package program for GTE is developed in C Language. Results of analysis
   show that several optimal parameters should be determined prior to
   searching the shortest path. and the findings are quite promising as a
   threshold for further researches.},
