Note = {25th Annual Conference of the North American Association for
   Environmental Education, SAN FRANCISCO BAY AREA, CA, NOV 01-05, 1996},
Organization = {N Amer Assoc Environm Educ},
Abstract = {The Tanzania Environmental Education Programme (TEEP) is a World Wide
   Fund for Nature (WWF) funded programme set to enable people to take
   full, active and well informed part of decisions and actions that will
   result in stable and successful environmental management. In developing
   TEEP, WWF involved the Tanzanian institutions within a formalized
   education systems, in order to ensure that the programme was appropriate
   to local needs and circumstances; and was in the long term sustainable.
   TEEP is being implemented by various participating Institutions within
   Tanzania while WWF is playing roles of facilitating and coordinating.
   The programme, which has been running for four years now is composed of
   specific projects within five main areas: Schools, Community, Media,
   Professional and Occupational and Faith groups.},
