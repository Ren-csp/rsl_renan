Title = {Response characteristics of transient electromagnetic of fault
   structures in shallow stratum of underground space and its exploration},
Booktitle = {2019 5TH INTERNATIONAL CONFERENCE ON ADVANCES IN ENERGY RESOURCES AND
   ENVIRONMENT ENGINEERING (ICAESEE 2019)},
Series = {IOP Conference Series-Earth and Environmental Science},
