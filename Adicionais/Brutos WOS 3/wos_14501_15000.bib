@inproceedings{ WOS:000223250200022,
Author = {Joubert, JW},
Editor = {Wadhwa, LC},
Title = {Improving on the initial solution heuristic for the Vehicle Routing
   Problem with multiple constraints},
Booktitle = {URBAN TRANSPORT X: URBAN TRANSPORT AND THE ENVIRONMENT IN THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2004},
Volume = {16},
Pages = {217-226},
Note = {10th International Conference on Urban Transport and the Environment in
   the 21st Century, Dresden, GERMANY, MAY 19-21, 2004},
Organization = {Wessex Inst Technol; Advances Transport Book Series},
Abstract = {The integration of multiple constraints of the Vehicle Routing Problem
   (VRP) variants is computationally expensive. Although vehicle routing
   problems have been well researched, variants are typically treated in
   isolation, whereas industry requires integrated solutions. The concept
   of time window compatibility is introduced to improve the initial
   solution algorithm when combining variants such as a heterogeneous
   fleet, double scheduling, and multiple time windows. The paper reports
   on the algorithm's results when benchmark test data is used. The results
   relate to both the computational burden of the algorithm, as well as the
   quality of the initial solution.},
