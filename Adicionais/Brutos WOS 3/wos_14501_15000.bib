Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {The aim of the present work is to derive a probabilistic model relating
   the accident risk to road geometric features, vehicular flows, and
   weather conditions. The risk index for a certain configuration of
   external factors has been defined as the accident probability (per unit
   of time and space) conditioned by occurrence of the given external
   factors. By comparing the risk indices corresponding to different
   configurations of external factors, it is possible to determine the most
   dangerous conditions, i.e. those associated with higher accident rates.
   It is also possible to assess the existence of synergetic effects
   between two or more external factors when their joint presence increases
   the risk index more than expected under the assumption of independent
   effect.},
