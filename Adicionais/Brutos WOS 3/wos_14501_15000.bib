@article{ WOS:000266311600016,
Author = {Gardner, William L. and Fischer, Dawn and Hunt, James G. (Jerry)},
Title = {Emotional labor and leadership: A threat to authenticity?},
Journal = {LEADERSHIP QUARTERLY},
Year = {2009},
Volume = {20},
Number = {3},
Pages = {466-482},
Month = {JUN},
Note = {Annual Meeting of the Southern-Management-Association, Nashville, TN,
   2007},
Organization = {SE Management Assoc},
Abstract = {Building on the emotional labor and authentic leadership literatures, we
   advance a conceptual model of leader emotional displays. Three
   categories of leader emotional displays are identified: surface acting,
   deep acting and genuine emotions. The consistency of expressed leader
   emotions with affective display rules, together with the type of display
   chosen, combines to impact the leader's felt authenticity, the
   favorability of follower impressions, and the perceived authenticity of
   the leader by the followers. Emotional intelligence, self-monitoring
   ability, and political skill are proposed as individual differences that
   moderate leader emotional display responses to affective events. We also
   look at followers' trust in the leader and leader well-being as key
   outcomes. Finally, we explore the influence on leader emotional labor of
   contextual dimensions of the environment, including the omnibus
   (national and organizational culture, industry and occupation,
   organizational structure, time) and discrete (situational) context.
   Directions for future research are discussed. (C) 2009 Elsevier Inc. All
   rights reserved.},
