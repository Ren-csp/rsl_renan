Editor = {Jaturasitha, S and Muller, J and Visitpanich, T and Fukuda, S and Jintrawet, A and Schreinemachers, P and Ekasingh, B and Weyerhaeuser, H and Yasunaga, E and Lambertz, C and Spreer, W},
Title = {Phenotypic Characterization and Farm Management of Indigenous Chicken
   Reared in Highland Region of Northern Thailand},
Booktitle = {1ST INTERNATIONAL CONFERENCE ON ASIAN HIGHLAND NATURAL RESOURCES
   MANAGEMENT (ASIAHILAND) AND 2ND IDRC-SEARCA UPLAND FELLOWSHIP AND
   CONFERENCE},
Series = {Agriculture and Agricultural Science Procedia},
