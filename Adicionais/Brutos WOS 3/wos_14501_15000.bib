@inproceedings{ WOS:A1997BJ51P00002,
Author = {Southwood, R},
Editor = {Murphy, IL},
Title = {Data and data-sharing: Key to transboundary water quality protection},
Booktitle = {PROTECTING DANUBE RIVER BASIN RESOURCES: ENSURING ACCESS TO WATER
   QUALITY DATA AND INFORMATION},
Series = {NATO ADVANCED SCIENCE INSTITUTES SERIES, SER 2},
Year = {1997},
Volume = {24},
Pages = {17-21},
Note = {NATO Advanced Research Workshop on an International Data-Sharing
   Programme for the Effective Management of Danube River Basin Resources,
   BUDAPEST, HUNGARY, MAY 27-30, 1996},
Organization = {NATO},
Abstract = {A river basin must be viewed as a dynamic system governed by underlying
   flows, both physical and biological. The interrelationships of the
   processes are determined by their position in the longitudinal gradients
   of the catchment from headwaters to estuary. Industrial and urban
   developments impose changes on natural processes in this continuum, not
   necessarily at the point where they occur but throughout the course of
   the river. Information is needed on physical and biological components,
   as well as their properties such as the speed and turbidity of the
   water. A classification schema is suggested to relate materials carried
   by the water to their ecological roles. Pollution control, its process,
   costs and benefits are summarised. Information sharing is a sign of
   trust and leads to understanding, hence the importance of the NATO
   Workshop.},
