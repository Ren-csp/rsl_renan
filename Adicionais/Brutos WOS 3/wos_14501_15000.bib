   Mulawarman},
Editor = {Latipun and Karmiyati, D and Noordin, NM and Ahmad, NS and InAm, A and Ishomuddin and Hashim, S and Yaacob, NRN and Aman, RC},
Title = {Psychological Experience Dynamics of Students with Glossophobia through
   Narrative Counseling as seen from Gender: A Qualitative Study},
Booktitle = {PROCEEDINGS OF THE 3RD ASEAN CONFERENCE ON PSYCHOLOGY, COUNSELLING, AND
   HUMANITIES (ACPCH 2017)},
