@inproceedings{ WOS:000345656800011,
Author = {Sahin, U. Alver and Onat, B. and Polat, G.},
Editor = {Longhurst, JWS and Brebbia, CA},
Title = {Trace element concentrations of size-fractionated particulate matter in
   the atmosphere of Istanbul, Turkey},
Booktitle = {AIR POLLUTION XXI},
Series = {WIT Transactions on Ecology and the Environment},
