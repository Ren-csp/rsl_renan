   and Della Torre, Stefano and Leonforte, Fabrizio and Blavier, Camille
   Luna Stella and De Francesco, Felice},
Editor = {Mohammad, P and Shahfahad and Comino, JR and Matamanda, AR},
Title = {Adaptive Ventilation Strategy for Climate Control in an Unheated
   Cathedral in Northern Italy},
Booktitle = {GEOGRAPHIC APPROACHES TO CLIMATE CHANGE AND MITIGATION: URBAN AND RURAL
   PERSPECTIVES, VOL 1},
Series = {Advances in Science Technology and Innovation},
Year = {2025},
