@inproceedings{ WOS:001594525800110,
Author = {Tkachenko, Tetiana and Voloshkina, Olena and Mileikovskyi, Viktor and
   Sipakov, Rostyslav and Hlushchenko, Roman and Tkachenko, Oleksii},
Editor = {Ahmad, S and Murray, R},
Title = {Using Rain-Garden Bands for Rainwater Drainage from Roads},
Booktitle = {WORLD ENVIRONMENTAL AND WATER RESOURCES CONGRESS 2023},
Year = {2023},
Pages = {1207-1214},
Note = {2023 World Environmental and Water Resources Congress, Henderson, NV,
   MAY 21-24, 2023},
Abstract = {Rainwater drainage is one of the essential components of traffic safety.
   Rainwater drainage structures are costly, and it needs continuous
   maintenance. Existing separate stormwater inlets absorb water
   non-evenly. Climate changes and the wear of drainage infrastructure need
   to be improved in the systems, even in highly developed countries. Such
   problems also will be present in areas with extensive damage to
   infrastructure, for example, from military action, as in Russia's
   military invasion of Ukraine. The most natural city-sponge concept is
   the better and cheaper solution to resolve issues with rainwater
   drainage. The proposed concept uses sponge facilities, for example, rain
   gardens, permeable pavements, green roofs, etc. The authors in this
   paper proposed a new solution for even and quick water absorption from
   roads: rain-garden bands, which also dampen cars' energy during road
   accidents. In this paper, the authors describe their proposed two- or
   three-level roads with elevated bike lanes and sidewalks, damping the
   energy of water falling to the lower level avoiding soil erosion, and
   allowing wider plant assortment in an urban landscape, and describe the
   design for the proposed solution. Materials and methods used in the
   proposed solution are as follows: a mathematical model of falling water
   to calculate the size of the impingement plate. The purpose and goal of
   implementing the proposed solution in urban are to achieve a completely
   secure and dry road in the city-sponge concept using rain-garden bands
   adapted to creating multilevel road designs. A result of the research on
   the matter described in this paper is the possibility of creating safe
   roads with rapid and stable rainwater drainage without creating complex
   and expensive engineering structures.},
