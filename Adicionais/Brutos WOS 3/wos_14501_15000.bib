@inproceedings{ WOS:000085197300048,
Author = {Teramachi, K and Sumi, T},
Editor = {Sucharov, LJ},
Title = {Noise prediction generated from departing cars based on a
   man-machine-system model},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {513-522},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {This paper proposes a noise prediction model from departing cars at a
   signaled intersection. Cars generate noise at the signaled intersection
   where stop and go occur repeatedly. Noise level depends on the driving
   condition of the engine. This model consists of two sub-models, One is a
   man-machine-system model representing the mechanical properties of the
   car and the human factors in driving. It provides the speed/acceleration
   profiles of departing cars. Another is a model that provides to
   calculate sound power level. Using the noise prediction model in this
   paper, one can consider the physical condition of roads and vehicles.},
