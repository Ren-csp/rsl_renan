@inproceedings{ WOS:000073159500029,
Author = {de Groot, M and Leidelmijer, KCM and Damen, M},
Editor = {Sucharov, L and Bidini, G},
Title = {Designing for the future; a discussion on possible operators for Demand
   Oriented Transport Management Systems},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {319-326},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {The central thesis of this paper is that an organisational model for a
   Demand Oriented Transport Management System (DOTraMS) cannot be the
   result of an objective choice. Rather it is the result of a specific
   political, economical and environmental context. In order to explain
   this thesis four possible scenarios are described in which government
   influence, the economical landscape and environmental optimisation vary.
   Against the different backgrounds provided by these scenarios various
   organisational models are discussed. In doing so it will become clear
   that the societal context not only affects the choice for an operator,
   but also for the goal and the scale on which the DOTraMS will operate.},
