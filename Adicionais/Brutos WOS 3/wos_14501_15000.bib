Title = {An energy consumption model for freight transport in Japan},
Booktitle = {URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST CENTURY III},
Year = {1997},
Pages = {115-132},
Note = {3rd International Conference on Urban Transport and the Environment for
   the 21st Century (UT 97), ACQUASPARTA, ITALY, SEP, 1997},
Organization = {Univ Perugia; Wessex Inst Technol},
Abstract = {Energy consumption in the transport sector is increasing. To lighten
   global and local environmental problems, it is necessary to reduce
   freight transport energy consumption, which occupies about 40\% of total
   transport energy consumption in Japan. In this paper, the mechanism of
   increase in the energy consumption of freight transport is clarified.
   According to the mechanism, an energy consumption model for freight
   transport has been developed. Then in sensitivity analysis, energy
   consumption is estimated in the following cases:1)dispersion of
   employment/population, 2)improvement of lorry load factor, 3)modal shift
   from lorry to ship.},
