@article{ WOS:000235273600021,
Author = {Schroeder, K and Pawlowsky-Reusing, E},
Title = {Current state and development of the real-time control of the Berlin
   sewage system},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2005},
