Language = {English},
Affiliation = {Fific, M (Corresponding Author), Indiana Univ, Dept Psychol \& Brain Sci, 1101 E 10th St, Bloomington, IN 47405 USA.
   Fific, Mario, Indiana Univ, Dept Psychol \& Brain Sci, Bloomington, IN 47405 USA.},
DOI = {10.3758/PP.70.4.583},
ISSN = {0031-5117},
Keywords-Plus = {SERIAL PROCESSES; ATTENTIONAL CAPTURE; SELECTIVE INFLUENCE; DIVIDED
   ATTENTION; REDUNDANT-SIGNALS; MENTAL PROCESSES; GUIDED SEARCH;
   REACTION-TIME; HUMAN-MEMORY; PARALLEL},
