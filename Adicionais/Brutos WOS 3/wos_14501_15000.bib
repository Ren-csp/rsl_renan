@inproceedings{ WOS:000437167900084,
Author = {Sowka, Izabela and Bezyk, Yaroslav},
Editor = {Kazmierczak, B and Kutylowska, M and Piekarska, K and TruszZdybek, A},
Title = {Quantifying and reporting greenhouse gas emissions at local level},
Booktitle = {9TH CONFERENCE ON INTERDISCIPLINARY PROBLEMS IN ENVIRONMENTAL PROTECTION
   AND ENGINEERING (EKO-DOK 2017)},
Series = {E3S Web of Conferences},
Year = {2017},
