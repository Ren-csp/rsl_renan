@inproceedings{ WOS:000326472800120,
Author = {Issakhanova, A. A. and Jakupov, S. M.},
Editor = {Maree, K},
Title = {Psychological Structure of Individuals' Attitude to the Sovereign
   Kazakhstan},
Booktitle = {WORLD CONFERENCE ON PSYCHOLOGY AND SOCIOLOGY 2012},
Series = {Procedia Social and Behavioral Sciences},
Year = {2013},
Volume = {82},
Pages = {724-726},
Note = {1st World Conference on Psychology and Sociology (PSYSOC), Antalya,
   TURKEY, NOV 27-DEC 01, 2012},
Organization = {Acad World Educ \& Res Ctr},
Abstract = {Kazakhstan became an independent sovereign state for almost 20 years
   ago. These years of independence brought political, economic, and
   cultural independence of the people of Kazakhstan. The goal of our
   research is devoted to the relationship of Kazakh and Russian ethnic
   groups in the state and psychological potential disclosure of patriotism
   as one of the highest forms of relations. The relevance of this study
   relate to one of the important national interests of the Republic of
   Kazakhstan - Kazakhstan patriotism education and the strengthening of
   the unity of the people of Kazakhstan. The study of Kazakh and Russian
   ethnic groups are seen as active subjects of their lives. Individual as
   the subject of citizenship should make his/her own choices in life and
   in relation to the state as well. The following study investigated the
   structure of individual attitude to the state, taking into account the
   three-component structure of the attitude. Findings allow us to affirm
   that events structure a person's life in one way or another, affect the
   structure of the attitude and the nature of the attitude of man to the
   poly-ethnic state. Events occurring in interethnic communication are the
   original products of refraction of external influences through the
   internal conditions. (C) 2013 The Authors. Published by Elsevier Ltd.},
