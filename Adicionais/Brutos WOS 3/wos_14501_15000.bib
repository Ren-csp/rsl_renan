@article{ WOS:000175457600023,
Author = {Mavroidis, I},
Title = {Parameters for a simple empirical model of building-nfluenced dispersion
   based on field and wind-tunnel experiments},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENT AND POLLUTION},
Year = {2001},
Volume = {16},
