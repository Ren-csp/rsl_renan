@inproceedings{ WOS:000085197300033,
Author = {Biggiero, L},
Editor = {Sucharov, LJ},
Title = {A procedure to consistently update OD matrix and network parameters
   using screen line traffic counts},
Booktitle = {URBAN TRANSPORT V: URBAN TRANSPORT AND THE ENVIRONMENT FOR THE 21ST
   CENTURY},
Series = {ADVANCES IN TRANSPORT},
Year = {2000},
Volume = {5},
Pages = {353-362},
Note = {5th International Conference on Urban Transport and the Environment for
   the 21st Century, RHODES, GREECE, SEP 08-10, 1999},
Organization = {Wessex Inst Technol},
Abstract = {The OD matrix updating is often used as an aggregate calibration of the
   spatial distribution demand model per mode. It consists in the adjusting
   of the demand among the different origin-destination zones to reproduce
   some observed flows through the assignment procedure. Since demand
   models are affected by some errors which combine themselves in the
   application with data base approximations, such a procedure is necessary
   to both operational and strategic planning.
   Although some theoretical frameworks presented in literature consider
   the problem of updating both demand and network parameters, all the
   practical frameworks, at the author's knowledge, consider all the
   network parameter values as fixed, varying only the demand. Therefore,
   if an error occurs on the network parameters, it can strongly affect the
   updating of the od matrix giving a spatial distribution which
   consistently reproduces flows but not the demand.
   In this paper, using the concept of screen lines an updating correction
   procedure is presented taking into account both demand and a subset of
   the network parameters. The od matrix updating procedure is included in
   a wider framework comparing also the aggregate flows passing through
   each screen line to achieve consistency primary of the total demand and
   then, after a network updating, of the link flows. The final updated od
   matrix is thus based on a more reliable network and better reproduces
   the demand spatial distribution.
   An application to a small size town taking into account two screen lines
   validates the procedure suggesting also a simplified operational
   framework.},
Publisher = {WIT PRESS},
Address = {ASHURST LODGE, SOUTHAMPTON SO40 7AA, ASHURST, ENGLAND},
