Pages = {237-250},
Note = {6th International Conference on Harmonization within Atmospherica
   Dispersion Modelling for Regulatory Purposes, ROUEN, FRANCE, OCT 11-14,
   1999},
Abstract = {Flow and dispersion around isolated obstacles, representative of those
   found in urban areas, is examined both in the field and in the wind
   tunnel. The experimental results are used to derive parameters for a
   simple empirical model for the estimation of concentrations in the
   recirculation region of isolated obstacles. Concentrations are estimated
   for a fully entrained plume as well as for partial entrainment of the
   plume in the recirculation region. In the latter case, concentrations
   are also estimated for a pollutant source that is asymmetrically placed
   with respect to the obstacle.},
