@inproceedings{ WOS:000073221600047,
Author = {Banks, D and Nash, H},
Editor = {Chilton, J},
Title = {The rise, fall and potential renaissance of the English spa town},
Booktitle = {GROUNDWATER IN THE URBAN ENVIRONMENT - VOL I: PROBLEMS, PROCESSES AND
   MANAGEMENT},
Year = {1997},
Pages = {291-296},
Note = {XXVII International-Association-of-Hydrogeologists Congress, E MIDLANDS
   CONF CTR, NOTTINGHAM, ENGLAND, SEP 22-26, 1997},
Organization = {Int Assoc Hydrogeologists; British Geol Survey, Hydrogeol Grp; Golder
   Associates; Geol Soc London, Hydrogeol Grp; Overseas Dev Adm; UNESCO,
   Div Water Sci; WHO UNEP Global Environm Monitoring Syst; Severn Trent
   Water; Entec Europe Ltd; NIREX UK Ltd; Environm Agcy},
Abstract = {The occurrence of mineral waters in England is controlled by the
   interplay of three factors (i) structural; (ii) hydrochemical
   evolutionary and stratigraphical factors; and (iii) specific
   mineralogies. The paper examines the interaction between the development
   of mineral water resources for spas and urbanization, focusing on the
   spas of the Derbyshire Peak District and of London. In some cases,
   mineral waters have been the catalyst for urban development (e.g. Burton
   or Bath); in some cases, industrial activity (mining) has largely been
   responsible for the public availability of mineral waters (e.g. Matlock
   or Droitwich); in many cases, however, rapid industrialization and
   urbanization has been dependent on external factors and much of
   England's spa heritage has been lost (e.g. London), the only reminders
   being found in place names and chemical nomenclature (Epsom salts).},
