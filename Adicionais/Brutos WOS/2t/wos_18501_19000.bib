@article{ WOS:001830356900001,
Author = {Chu, Lavinia Hsiao-Hsuan and Szota, Christopher and Arndt, Stefan K. and
   Farrell, Claire},
Title = {Woody species suitable for naturalistic plantings have greater
   resprouting vigour and shoot recovery after coppicing},
Journal = {CURRENT PLANT BIOLOGY},
Year = {2026},
Volume = {48},
Month = {JUL},
Abstract = {Naturalistic plantings using diverse woody species can be managed by
   coppicing (hard pruning), offering a lowmaintenance alternative for
   urban greening. Shoot recovery is an important trait for such plantings,
   as dense canopies suppress weeds and enhance visual appeal. However, not
   all species recover lost biomass after coppicing, and species selection
   is further challenged by limited understanding of shoot recovery
   mechanisms. Using a common garden experiment with 67 Australian shrub
   and small tree species, we compared shoot biomass recovery, resource
   allocation and traits of coppiced plants relative to same-aged
   conspecific non-coppiced plants six months after coppicing. Coppiced
   plants produced twice as many stems but were shorter than non-coppiced
   plants. Shoot recovery increased weakly but significantly with
   resprouting vigour. While only 17 species fully recovered shoot biomass,
   30 species recovered at least 50\% of the biomass of non-coppiced plants
   within six months following coppicing. Species with greater shoot
   recovery showed co-ordinated increases in basal area, height, but
   decreases in root-to-shoot ratio after coppicing, relative to
   non-coppiced plants. Coppiced plants primarily relied on stem starch
   pool for shoot recovery, with recovery associated with replenishment of
   stem reserves, through increases in post-coppicing basal area and
   height. In contrast, increases in stem number, leaf area ratio, and
   specific leaf area after coppicing were unrelated to shoot recovery and
   likely reflected architectural responses to shoot loss. Selecting
   larger-sized juvenile woody species and scheduling coppicing during
   periods with sufficient water availability may enhance shoot recovery
   and support the long-term success of lowmaintenance naturalistic urban
   plantings managed by coppicing.},
