@article{ WOS:001860971600001,
Author = {Anane, George Kwadwo and Sarfo, Richmond Asamoah},
Title = {Participatory environmentalism in practice: a mixed-methods analysis of
   stakeholder perceptions, participation and governance of urban green
   stewardship in a secondary city in Ghana},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {31},
Month = {AUG},
Abstract = {Urban greening is increasingly recognised as a critical strategy for
   promoting environmental sustainability, climate resilience, and urban
   liveability, yet community participation remains poorly understood in
   rapidly urbanising secondary cities. This study examines stakeholders'
   perceptions, awareness, and participation, as well as the determinants
   of willingness to engage in urban greening in the Sunyani Municipality,
   Ghana. We used a convergent mixed-methods design, combining
   semi-structured interviews with planning officials and a KoBoToolbox
   survey of 129 residents. We analysed the data using descriptive
   statistics, Chi-square tests, binary logistic regression, and thematic
   analysis. The findings indicate low participation despite strong
   willingness to engage. Gender, educational attainment, and employment
   status significantly shaped willingness to participate, whereas limited
   awareness, weak institutional coordination, inadequate funding, and
   competing development priorities constrained engagement. The study
   concludes that strengthening participatory governance, environmental
   education, regulatory enforcement, and institutional collaboration is
   essential to advance sustainable urban green stewardship in Ghanaian
   secondary cities.},
