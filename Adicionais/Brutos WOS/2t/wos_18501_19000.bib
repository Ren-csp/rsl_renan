@article{ WOS:000466499800010,
Author = {Garcia Jimenez, Carlos Ignacio and Vargas Rodriguez, Yalma Luisa and
   Yarely Quiroz, Brenda},
Title = {Environmental conflicts and their effects on quality of life in a
   western region of Mexico},
Journal = {ECONOMIA SOCIEDAD Y TERRITORIO},
Year = {2019},
Volume = {19},
Number = {60},
Pages = {273-304},
Month = {MAY-AUG},
Abstract = {Perceptions about environmental conflicts were investigated in the Talpa
   de Allende municipality Jalisco. A natural protected area was recently
   established in this territory and its urban area was declared a magical
   town. Using regression analysis with survey data was found that the most
   outstanding conflicts were the impoverishment of soils, air pollution,
   water quality degradation in rivers and streams, and excessive logging.
   However, it was determined that only intensification of water scarcity
   and low frequency rainfall generated a statistically significant
   decrease in perceived quality of life.},
