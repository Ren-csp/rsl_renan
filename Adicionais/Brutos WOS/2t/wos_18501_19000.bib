@article{ WOS:001826105500001,
Author = {Cabral, Madalena and Loureiro, Susana and Fardilha, Margarida},
Title = {Environmental and lifestyle risk assessment in perinatal healthcare: a
   national survey of portuguese professionals},
Journal = {TOXICOLOGY AND ENVIRONMENTAL HEALTH SCIENCES},
Year = {2026},
Month = {2026 JUL 21},
Abstract = {Objective To evaluate the knowledge, perceptions, and practices of
   Portuguese perinatal healthcare professionals regarding environmental
   and lifestyle exposures during the periconceptional period.Design
   Cross-sectional survey.Setting and Participants. An anonymous online
   questionnaire was distributed between September and December 2024
   through professional associations, targeting gynecologist-obstetricians
   (senior and resident), nurses, and nutritionists.Methods The survey
   assessed demographic and professional characteristics, routine screening
   of nine key exposures (smoking, alcohol use, occupational hazards,
   physical activity, environmental chemicals, diet, fish intake, drinking
   water source, and plastic use), perceived barriers, familiarity with
   ACOG/FIGO recommendations, and preferred educational formats. Logistic
   regression analyses explored associations between demographics and
   responses.Results A total of 126 professionals participated (87.3\%
   female; 50.8\% specialists, 7.9\% residents, 2.4\% nurses, 38.9\%
   nutritionists). Most routinely asked about smoking (91.3\%) and alcohol
   (90.5\%), but fewer screened for occupational exposures (33.3\%),
   environmental chemicals (14.3\%), fish intake (46.0\%), drinking water
   (48.0\%), or plastic use (8.7\%). Main barriers were insufficient
   knowledge (61.5\%) and limited consultation time (49.2\%). Only 9.5\%
   were familiar with ACOG/FIGO guidelines. Female professionals more often
   inquired about alcohol and exercise; experience influenced screening for
   chemical exposures. Familiarity with guidelines correlated with
   increased screening. Most respondents expressed interest in further
   training, favoring webinars or online courses (65.1\%).Conclusions
   Portuguese perinatal healthcare professionals routinely address smoking
   and alcohol but rarely assess environmental exposures. Targeted
   education and dissemination of international guidelines are urgently
   needed to strengthen reproductive and perinatal care.},
