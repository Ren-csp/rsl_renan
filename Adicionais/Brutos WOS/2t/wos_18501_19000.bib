@article{ WOS:001813107000001,
Author = {Kamis, Muhammad Muzammil and Said, Fathin Faizah and Maulud, Khairul
   Nizam Abdul and Mohammed, Nafisah and Jauhari, Azmafazilah},
Title = {Household perceptions and behaviour shape climate insurance adoption
   under climate risk},
Journal = {CLIMATE RISK MANAGEMENT},
Year = {2026},
Volume = {53},
Month = {SEP},
Abstract = {Intensifying climate-related hazards place low-lying coastal communities
   at severe risk. Climate risk insurance has become an essential financial
   mechanism for enhancing household resilience to such risks. However, the
   uptake of these instruments remains uneven, often influenced by
   underlying perceptions, socio-economic status, and adaptive behaviors.
   This research develops a binary logistic regression model to analyze the
   factors influencing climate risk insurance adoption among 400 households
   in Kuala Gula, Malaysia. The BLR analysis indicates that, among the 23
   factors examined, four were identified as significant predictors of
   insurance adoption among coastal households: household income, household
   size, receipt of social assistance, and access to public facilities. The
   likelihood of adoption was significantly increased by higher income,
   larger households, and reliance on social assistance, whereas limited
   access to public facilities substantially decreased it. The model
   exhibited a robust overall fit with significant predictive capability,
   accurately classifying households; however, its performance was
   significantly better for non-adopters compared to adopters. The findings
   indicate that socio-economic capacity, institutional support, and
   infrastructure significantly influence household insurance decisions in
   vulnerable coastal regions. To bridge the gap between risk perception
   and protective measures, policy implementation has to strengthen
   financial inclusion, offer targeted subsidies for lowincome groups,
   scale social assistance according to household needs, and improve access
   to public infrastructure.},
