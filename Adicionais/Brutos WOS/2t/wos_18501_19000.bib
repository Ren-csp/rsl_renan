@article{ WOS:001389347900035,
Author = {Li, Cun and Yu, Yifei and Wan, Zhixin and Chiu, Man Chun and Huang,
   Jingjing and Zhang, Shuxin and Zhu, Xiaoxin and Lan, Qiaoshuai and Deng,
   Yanlin and Zhou, Ying and Xue, Wei and Yue, Ming and Cai, Jian-Piao and
   Yip, Cyril Chik-Yan and Wong, Kenneth Kak-Yuen and Liu, Xiaojuan and Yu,
   Yang and Huang, Lin and Chu, Hin and Chan, Jasper Fuk-Woo and Clevers,
   Hans and Yuen, Kwok Yung and Zhou, Jie},
Title = {Human respiratory organoids sustained reproducible propagation of human
   rhinovirus C and elucidation of virus-host interaction},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {DEC 30},
Abstract = {The lack of a robust system to reproducibly propagate HRV-C, a family of
   viruses refractory to cultivation in standard cell lines, has
   substantially hindered our understanding of this common respiratory
   pathogen. We sought to develop an organoid-based system to reproducibly
   propagate HRV-C, and characterize virus-host interaction using
   respiratory organoids. We demonstrate that airway organoids sustain
   serial virus passage with the aid of CYT387-mediated immunosuppression,
   whereas nasal organoids that more closely simulate the upper airway
   achieve this without any intervention. Nasal organoids are more
   susceptible to HRV-C than airway organoids. Intriguingly, upon HRV-C
   infection, we observe an innate immune response that is stronger in
   airway organoids than in nasal organoids, which is reproduced in a
   Poly(I:C) stimulation assay. Treatment with alpha-CDHR3 and antivirals
   significantly reduces HRV-C viral growth in airway and nasal organoids.
   Additionally, an organoid-based immunofluorescence assay is established
   to titrate HRV-C infectious particles. Collectively, we develop an
   organoid-based system to reproducibly propagate the poorly cultivable
   HRV-C, followed by a comprehensive characterization of HRV-C infection
   and innate immunity in physiologically active respiratory organoids. The
   organoid-based HRV-C infection model can be extended for developing
   antiviral strategies. More importantly, our study has opened an avenue
   for propagating and studying other uncultivable human and animal
   viruses.},
