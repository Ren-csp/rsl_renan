@article{ WOS:001641987000003,
Author = {Loza, Eulalia Dolores Pino and Enriquez, Kevin Alexander Caiza and
   Rodriguez, William Fredy Aguilar},
Title = {The meaningful conversation in the construction of a culture of peace},
Journal = {ETIC NET-REVISTA CIENTIFICA ELECTRONICA DE EDUCACION Y COMUNICACION EN
   LA SOCIEDAD DEL CONOCIMIENTO},
Year = {2025},
Volume = {25},
Number = {2},
Pages = {374-410},
Month = {JUL-DEC},
Abstract = {Meaningful conversation is one that elevates perspective, expands
   consciousness, and focuses energies on good actions. It involves
   listening to learn from others, to comprehend, to understand, to
   challenge assumptions, and to ensure that these conversations transcend
   into meaningful actions. The Culture of Peace is based on the way people
   think, understanding that human nature is inclined both to compete and
   to collaborate. Creativity and excellence are powerful sources of
   intrinsic inspiration, making it necessary to align our vital energies
   with a higher purpose or cause. The objective of this mixed-methods
   research is to describe the content and structure of meaningful
   conversations as the foundation of the Culture of Peace. The findings
   reflect a diversity of opinions on human nature, competition, and
   conflict management- complex and necessary categories to promote a
   Culture of Peace. This culture emerges from the inner space of the human
   being, where meaningful conversation, continuous dialogue, tolerance of
   differences, and the constant search for solutions become solid
   foundations for building everyday relationships that enrich coexistence.},
