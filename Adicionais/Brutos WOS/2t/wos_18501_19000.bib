@article{ WOS:001586073700024,
Author = {Abidin, Noorazeela Zainol and Abdullah, Nuraini and Nizam, Rosmah and
   Shaari, Mai Syaheera Miau},
Title = {Exploring the impacts of socioeconomic, political, and environmental
   determinants on life expectancy in ASEAN+3 nations},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {SEP 30},
Abstract = {Reduced life expectancy is the result of various factors, including
   income inequality, poverty, inadequate access to education and
   healthcare facilities, poor governance, pollution, climate
   change-related risks, natural disasters, and a lack of access to clean
   water and sanitation. The purpose of this study is to examine the
   impacts of socioeconomic, political, and environmental factors on life
   expectancy in the selected ASEAN+3 countries between 1995 and 2021. This
   study utilised the panel static method (pooled ordinary least square,
   fixed effect, and random effect), and the Hausman test will be used to
   select the appropriate estimator. The results indicate that both models
   demonstrate significant negative effects of the corruption perception
   index and CO2 emissions on life expectancy. However, labour income shows
   a positive and significant association with life expectancy in both
   models. Moreover, in developed countries, there is a positive and
   significant impact on life expectancy due to the interaction between the
   dummy country and the corruption perception index. Therefore, it is
   important to implement policies that promote the equitable distribution
   of wealth and ensure access to essential resources and services for all
   individuals. To ensure the efficient allocation of resources, promote
   accountability, and increase public trust in healthcare systems, it is
   necessary to implement effective governance procedures, increase
   transparency, and combat corruption. Enforcing environmental regulations
   to reduce pollution levels and promoting sustainable development
   practices are crucial. Besides, implementing measures to mitigate the
   impacts of climate change, including adaptation strategies and
   transitioning towards cleaner and renewable energy sources, is
   essential.},
