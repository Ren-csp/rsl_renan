@article{ WOS:000442579700105,
Author = {Verlicchi, Paola and Al Aukidy, Mustafa and Zanni, Giacomo},
Title = {Willingness to Pay for Recreational Benefit Evaluation in a Wastewater
   Reuse Project. Analysis of a Case Study},
