@article{ WOS:001083971500004,
Author = {Barlow, Matt},
Title = {Waste and its masquerades: On the production of urban natures in Kochi,
   India},
Journal = {ANTHROPOLOGY TODAY},
Year = {2023},
Volume = {39},
Number = {5},
Pages = {11-14},
Month = {OCT},
Abstract = {Waste management has been a focal point in ethnographic research, yet
   its aesthetic and ideological facets in shaping `urban nature' have been
   largely overlooked. The article delves into a comparative study of two
   parks in Kochi, a South Indian city, examining the intersection of
   environmental aesthetics, infrastructural visibility, and the
   conceptualization of urban nature. Through this juxtaposition, the study
   elucidates how divergent waste management strategies reflect broader
   ideologies concerning urban environments and their role in urban
   development initiatives. The article posits that waste and its
   management are not peripheral elements in the urban experience of
   nature; rather, they are integral components that shape it.},
