@article{ WOS:000566766200001,
Author = {Saetra, Henrik Skaug},
Title = {THE LIMITS OF A LOCKEAN ENVIRONMENTALISM: GOD, HUMAN BEINGS, AND NATURE
   IN LOCKE'S PHILOSOPHY},
Journal = {BARATARIA-REVISTA CASTELLANO-MANCHEGA DE CIENCIAS SOCIALES},
Year = {2020},
Number = {27},
Pages = {1-17},
Abstract = {God gave us the Earth, to use and enjoy. So says the Bible, and so says
   John Locke (1632-1704). The individualism and liberalism in Locke's
   philosophy makes it decidedly modern and appealing to us today. However,
   he often uses God as a source of truth and premises in his arguments.
   This undermines the modern appearance and leaves us with a philosophy
   that is at times contradictory, at times brilliant, and at all times
   fixed to the anthropocentric rail that guides his philosophy. In this
   article, the element of Locke's philosophy that concerns humanity's
   relationship with the natural world is examined. Particular attention is
   paid to the value and nature of both biotic and abiotic nature. I argue
   that the religious aspects of Locke's philosophy cannot be fully purged
   in an effort to create a pure rationalist, and this leads me to focus on
   how the religious aspects relate to Locke's rationalism, and in
   particular what implications his combination of philosophy and theology
   carries for the prospects of a Lockean environmentalism. I conclude that
   such environmentalism has clear limitations, while still providing
   certain foundations for the idea of sustainability and scientific
   conservationism.},
Publisher = {ASOC CASTELLANO-MANCHEGA DE SOCIOLOGIA},
Address = {COBERTIZO SAN PEDRO MARTIN, S-N, TOLEDO, 45071, SPAIN},
Type = {Article},
Language = {English},
Affiliation = {Sætra, HS (Corresponding Author), Ostfold Univ Coll, Polit Sci, Halden, Norway.
   Saetra, Henrik Skaug, Ostfold Univ Coll, Polit Sci, Halden, Norway.},
DOI = {10.20932/barataria.v0i27.521},
ISSN = {1575-0825},
EISSN = {2172-3184},
Keywords = {Locke; Environmental ethics; Anthropocentrism; Environmentalism;
   Christianity},
Research-Areas = {Social Sciences - Other Topics},
Web-of-Science-Categories  = {Social Sciences, Interdisciplinary},
Author-Email = {henrik.satra@hiof.no},
Affiliations = {Ostfold University College},
ORCID-Numbers = {Sætra, Henrik Skaug/0000-0002-7558-6451},
Cited-References = {Attfield R., 2011, ETHICS ENV.
