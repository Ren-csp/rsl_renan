@article{ WOS:001440970800001,
Author = {Fernandez, Tania and Martinez-Meyer, Enrique and Zambrano, Luis},
Title = {A connectivity analysis to find areas for habitat restoration of the
   axolotl (Ambystoma mexicanum) in its natural habitat},
Journal = {URBAN ECOSYSTEMS},
Year = {2025},
Volume = {28},
Number = {2},
Month = {MAR 10},
Abstract = {The axolotl population (Ambystoma mexicanum) in its protected wetland in
   Xochimilco, Mexico City, has declined recently, mainly due to changes in
   land use. This study evaluates the land use changes in the axolotl
   habitat in 2002, 2012, and 2021 to understand the landscape
   fragmentation of the amphibians and to choose the best areas for a
   restoration program. After categorizing the suitability for restoration
   of axolotl<acute accent>s habitat (canals) based on width and
   neighboring features, we found that only 114 km of a total of 228 km of
   canals are suitable for restoration. The area suitable for axolotl
   habitat restoration is reduced to less than 40 km when incorporating
   land use changes such as urban expansion (87 ha) and greenhouse
   development (76 ha), along with the decline of crop areas (62 ha) and
   grassland areas (67 ha). These findings underscore the need for more
   efficient efforts to restore axolotls' natural habitat, preventing
   extinction in the wild. It is important to preserve the original habitat
   of the axolotl since it is one of the few green areas in Mexico City, a
   supplier of numerous ecosystem services.},
