@article{ WOS:001657651600001,
Author = {El-Tahan, Emad Abdel-Khalek Saber and Alhumaid, Mohammed Thani and
   Benlaria, Houcine and Abedelmaksoud, Mohamed Abedallah and Basiouny,
   Abdalhamid Nazmy and Aboul-Dahab, Sameh Abd-elmaksoud},
Title = {The Impact of Sustainable Marketing Strategies on Basic Needs
   Accessibility and Environmental Sustainability: A Study in Saudi Arabia},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {1},
Month = {JAN 3},
Abstract = {This study examines whether sustainable marketing strategies achieve
   synergistic outcomes or face trade-offs between environmental and social
   objectives in Saudi Arabia's Vision 2030 context. Survey data from 384
   consumers were analyzed using PLS-SEM to test relationships between four
   sustainable marketing strategies (green product development, sustainable
   pricing, promotion, and distribution) and dual sustainability outcomes,
   with Consumer Experience Perception as the mediator. Results reveal
   divergent pathways: strategies advancing environmental sustainability
   show negligible or negative impacts on basic needs accessibility, while
   those improving social access demonstrate minimal environmental
   benefits. Green Product Development strongly impacts Environmental
   Sustainability (beta = 0.271) but not Basic Needs (beta = -0.036).
   Conversely, Sustainable Pricing affects Basic Needs (beta = 0.223) with
   negligible environmental impact (beta = 0.003). Consumer Experience
   Perception universally mediates all relationships, with several
   strategies showing complete dependence on experiential translation. The
   model's moderate explanatory power (R2 = 0.299 for ABN, 0.349 for ES)
   indicates sustainable marketing strategies represent necessary but
   insufficient conditions for sustainability transformation. Findings
   challenge prevailing frameworks by documenting systematic trade-offs
   rather than synergies, establishing boundary conditions for
   sustainability integration in emerging markets. Organizations must
   explicitly prioritize either environmental leadership or social impact
   rather than attempting both simultaneously.},
