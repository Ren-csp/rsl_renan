Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Wang, X (Corresponding Author), Beijing Jiaotong Univ, Sch Architecture \& Design, Beijing 100044, Peoples R China.
