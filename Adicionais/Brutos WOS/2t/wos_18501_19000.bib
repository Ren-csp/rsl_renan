@article{ WOS:001760805800001,
Author = {Yuan, Jihui and Xiao, Xiong and Mohajerani, Mostafa and Bavarsad,
   Fatemeh Salehipour and Jiao, Zhichao and Chai, Jiale and Kong, Xiangfei
   and Gao, Yafeng},
Title = {Anthropogenic and urban controls on Japan's surface warming over the
   past 130 years},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Japan has experienced substantial surface warming over the past 130
   years, reflecting the combined influence of anthropogenic forcing,
   urbanization, and oceanic feedbacks. This study quantifies long-term
   relationships between decadal surface temperature anomalies and multiple
   environmental drivers-including greenhouse gases (CO2), solar flux, land
   use (urban fraction, NDVI), aerosols (SO2), urban morphology (building
   height, density, impervious surfaces), soil moisture, and sea surface
   temperature (SST)-from 1890 to 2020. Historical datasets from the Japan
   Meteorological Agency (JMA), CMIP6, MODIS, ERA5, and PLATEAU were
   integrated into a relational R-SQLite framework to ensure temporal
   consistency and reproducibility. Correlation and multivariate regression
   analyses revealed dominant positive associations with CO2(r = 0.991),
   urban fraction (r = 0.81), and SST (r = 0.92), which together explain >
   90\% of the centennial-scale variance in a multiple regression model
   including these three drivers plus a linear time term (adjusted R-2 =
   0.927). Urban morphological indicators (building height, population
   density, imperviousness) were positively associated with local warming,
   consistent with observed urban heat island (UHI) intensification. In
   contrast, soil moisture (r = -0.78) and aerosols (r = -0.172) provided
   transient cooling or masking effects. Vegetation greening (NDVI; r =
   0.963) co-evolved strongly with warming but did not produce a detectable
   net mitigation effect at the national scale analyzed here, although
   localized cooling benefits remain likely-reflecting a ``warming-induced
   greening{''} response. These results demonstrate that Japan's long-term
   thermal evolution arises from synergistic interactions between
   greenhouse forcing and urban expansion, supporting the consideration of
   climate-adaptive urban morphology and land management policies (pending
   further validation through process-based modeling such as WRF-Urban).},
