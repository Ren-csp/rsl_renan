@article{ WOS:001686931500001,
Author = {Elkhwesky, Zakaria and Derhab, Neama and Varmus, Michal and Kubina,
   Milan and El Kolaly, Hoda},
Title = {Food safety and waste behaviors of consumers in households: The role of
   gut microbiota dysbiosis, anxiety, and family upbringing in Egypt},
Journal = {SCIENTIFIC AFRICAN},
Year = {2026},
Volume = {31},
Month = {MAR},
Abstract = {By employing the integrated threat theory alongside the conservation of
   resources theory, this study sought to investigate the relationship
   among gut microbiota dysbiosis-induced illness perception, microbes
   anxiety, climate change anxiety, food safety behavior, and food waste
   prevention behavior. Additionally, it examined the moderating effect of
   family upbringing. A questionnaire was distributed to 190 Egyptian
   consumers diagnosed with diseases induced by gut microbiota dysbiosis.
   The data collected was analyzed through structural equation modeling,
   utilizing the R statistical software. The findings demonstrated that
   illness perception had a significant and positive impact on microbes
   anxiety and climate change anxiety. In addition, the impact of microbes
   anxiety on food safety behavior was insignificant, while climate change
   anxiety had a significant and negative effect on food waste prevention
   behavior. The interaction term (microbes anxiety x family upbringing)
   had a significant and negative effect on food safety behavior. This
   study provides significant theoretical contributions and practical
   implications for parents, alongside health, educational, and
   environmental authorities. For instance, parents could alleviate their
   family members' eco-anxiety by encouraging them to seek social support,
   engage in activism, and adopt sustainable lifestyle modifications.
   Instructional programs designed for parents could improve the well-being
   of offspring, promote safe food handling practices, and mitigate the
   incidence of food waste. Health authorities should counsel patients to
   perceive their illness perception as a constructive motivation for
   maintaining their health, rather than as a catalyst for chronic anxiety
   related to either microbes or climate change.},
