@article{ WOS:000333579700010,
Author = {Arumugam, Senthil and Petrasek, Zdenek and Schwille, Petra},
Title = {MinCDE exploits the dynamic nature of FtsZ filaments for its spatial
   regulation},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2014},
