@article{ WOS:000334132600002,
Author = {Lanfranchi, Joseph and Pekovic, Sanja},
Title = {How green is my firm? Workers' attitudes and behaviors towards job in
   environmentally-related firms},
Journal = {ECOLOGICAL ECONOMICS},
Year = {2014},
Volume = {100},
Pages = {16-29},
Month = {APR},
Abstract = {The implementation of environmental standards can be facilitated by
   motivating workers with pro-social preferences. Therefore, we study if
   employees working for firms achieving registration for
   environmentalrelated standards are more likely to display positive
   attitudes towards their job, to be actively involved in their jobs and
   to donate effort. Using a French matched employer-employee database, we
   find that these ``green employees{''} report a significantly higher
   perception of usefulness and equitable recognition at work. Besides,
   they are more likely to work uncompensated overtime hours. Finally, if
   the adoption of environmental standards is shown to have no direct
   influence on job involvement, we expose how it indirectly impacts job
   involvement through the mediation of employees' reported perception of
   usefulness and equitable recognition at work. (C) 2014 Elsevier B.V. All
   rights reserved.},
