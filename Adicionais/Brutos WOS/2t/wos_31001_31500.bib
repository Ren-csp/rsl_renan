@article{ WOS:000908745500001,
Author = {Wang, Ning and Li, Huiping and Zhang, Jianlin and Deng, Jianxun and She,
   Lin},
Title = {Research on Sustainable Evaluation Model of Sponge City Based on Emergy
   Analysis},
