@article{ WOS:001564455900001,
Author = {Heid, Kelly Baldwin and Sousa-Silva, Rita and Sachs, Ashby Lavelle and
   Funfgeld, Hartmut},
Title = {Social and environmental outcomes of urban street tree bed stewardship},
Journal = {ENVIRONMENTAL RESEARCH: ECOLOGY},
Year = {2024},
Volume = {3},
Number = {3},
Month = {SEP 1},
Abstract = {As projections of exponential urbanization persist, promoting the health
   of urban populations is one of the most urgent and challenging issues of
   the 21st century. By taking a planetary health approach and considering
   the reciprocal relationship between human health and the health of
   ecosystems, the integration of nature-based solutions into cities can
   address multiple urban challenges at once. Citizen stewardship of street
   trees and street tree beds is one such nature-based solution that
   challenges rapid urbanization while offering a healthier and greener
   future. Not only does citizen stewardship of street trees play a
   significant role in tree longevity, but our research suggests that the
   process of stewardship itself also positively impacts the health and
   wellbeing of stewards themselves. In this study, we sought to assess the
   motivations of street tree citizen stewards and the perceived social,
   environmental, and health effects of stewarding street tree beds in
   Freiburg, Germany. Based on a questionnaire-based survey and
   semi-structured interviews with tree stewards, we found that the most
   common motivations of citizen stewards were modeling positive
   environmental behavior as well as a desire to help the environment and
   one's community. The perceived outcomes included a strong sense of
   place, a meaningful connection to nature, and the belief that stewarding
   a street tree bed is good for one's mental health as well as the
   environment. Participants also considered street tree beds to be their
   personal gardens, suggesting that street tree beds may serve as
   restorative spaces that strengthen public health and social capital
   while sustaining urban greening. This case study supports and expands
