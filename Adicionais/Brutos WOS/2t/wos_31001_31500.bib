@article{ WOS:000714972500021,
Author = {Ding, Ke and Huang, Xin and Ding, Aijun and Wang, Minghuai and Su, Hang
   and Kerminen, Veli-Matti and Petaja, Tuukka and Tan, Zhemin and Wang,
   Zilin and Zhou, Derong and Sun, Jianning and Liao, Hong and Wang, Huijun
