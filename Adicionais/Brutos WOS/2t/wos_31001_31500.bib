@article{ WOS:001862145200013,
Author = {Yamane, Hidehiro and Wada, Junya and Stassenko, Elizabeth N. and
   Convertino, Natalie D. and Lee, Mariah E. and Vacchio, Melanie S. and
   Li, Wenmei and Livak, Ferenc and Rathnayake, Udumbara M. and
   Balagopalan, Lakshmi and Chari, Raj and Hagenau, Herbert and Awasthi,
   Parirokh and McGavern, Dorian B. and Bosselut, Remy and Samelson,
   Lawrence E.},
Title = {Weak SLP-76/PLC-γ1 interaction fine-tunes T cell receptor signal
   strength to optimize T cell responsiveness},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUL 29},
Abstract = {Upon T cell receptor (TCR) engagement, phosphorylation of the LAT
   adapter protein enables binding of the enzyme PLC-gamma 1 to a
   Gads/SLP-76 dimer, forming a tetrameric structure. The interaction
   between SLP-76 and PLC-gamma 1 is weak within this heterotetramer, and
   the relevant binding sites of SLP-76 and PLC-gamma 1 are highly
   conserved in vertebrates. We generated a mouse with a T cell-specific
   mutation in the SLP-76 that enhanced its affinity for PLC-gamma 1,
   thereby increasing PLC-gamma 1 activity and TCR signal strength. This
   mutation not only altered the development of alpha beta TCR thymocytes,
   invariant NKT cells, and intraepithelial lymphocyte precursors but also
   impaired the generation of central memory CD8+ T cells upon acute viral
   infection and the humoral immune response mediated by germinal center T
   follicular helper T cells. These findings suggest that the conserved
   weak SLP-76/PLC-gamma 1 interaction is important for the controlled
   activation of PLC-gamma 1, thus fine-tuning TCR signal strength to
   optimize T cell-mediated immunity.},
