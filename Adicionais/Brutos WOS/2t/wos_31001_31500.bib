@article{ WOS:001575250900004,
Author = {Jack, Jackson Tamunosaki},
Title = {(Mal)adaptation to environmental pollution: oil and the `livelihood
   dysfunction trap' in Nigeria's Niger Delta},
Journal = {AFRICA},
Year = {2025},
Volume = {95},
Number = {2},
Pages = {158-182},
Month = {MAY},
Abstract = {The article interrogates the livelihood responses that households in
   marginal farming and fishing communities rely on as ways of adapting to
   environmental degradation due to oil spillages and gas flaring in
   Nigeria's Niger Delta. It demonstrates how local perceptions and
   understandings of environmental pollution help communities frame
   livelihood responses to environmental problems in their domain. Relying
   on an analysis of ethnographic field-based data, the article identifies
   a plurality of adaptation strategies in farming and fishing. It reveals
   that these strategies are palliative and unable to mitigate the
   long-term environmental effects of oil and gas extraction in the region.
   This situation incentivizes a gradual shift from farming and fishing to
   crude oil-based livelihood activities, particularly artisanal crude oil
   refining, known as `kpo-fire'. The study foregrounds kpo-fire as a
   predominant maladaptive response, which, despite being an economic
   alternative for many, exacerbates environmental pollution; this results
   in a vicious circle, which is emblematic of what the article refers to
   as the `livelihood dysfunction trap'.
   Cet article interroge les moyens de subsistance utilis \& eacute;s par
   les m \& eacute;nages des communaut \& eacute;s agricoles et de p \&
   ecirc;che marginales en r \& eacute;ponse \& agrave; la d \&
   eacute;gradation de l'environnement due aux d \& eacute;versements de p
   \& eacute;trole et au torchage du gaz dans le delta du Niger, au Nig \&
   eacute;ria. Il d \& eacute;montre comment les perceptions et les interpr
   \& eacute;tations locales de la pollution environnementale aident les
   communaut \& eacute;s \& agrave; d \& eacute;finir des moyens de
   subsistance en r \& eacute;ponse aux probl \& egrave;mes
   environnementaux dans leur domaine. S'appuyant sur une analyse de donn
   \& eacute;es de terrain, l'article identifie une pluralit \& eacute; de
   strat \& eacute;gies d'adaptation dans l'agriculture et la p \&
   ecirc;che. Il r \& eacute;v \& egrave;le que ces strat \& eacute;gies
   sont palliatives et incapables d'att \& eacute;nuer les effets
   environnementaux \& agrave; long terme de l'extraction p \& eacute;troli
   \& egrave;re et gazi \& egrave;re dans la r \& eacute;gion. Cette
   situation incite \& agrave; une transition progressive de l'agriculture
   et de la p \& ecirc;che vers des activit \& eacute;s de subsistance bas
   \& eacute;es sur le p \& eacute;trole brut, notamment le raffinage
   artisanal du p \& eacute;trole brut, connu sous le nom de << kpo-fire
   >>. L'\& eacute;tude met en avant le kpo-fire comme une r \&
   eacute;ponse maladaptative pr \& eacute;dominante qui, bien qu'\&
   eacute;tant une alternative \& eacute;conomique pour beaucoup, exacerbe
   la pollution environnementale ; il en r \& eacute;sulte un cercle
   vicieux embl \& eacute;matique de ce que l'article appelle le << pi \&
   egrave;ge du dysfonctionnement des moyens de subsistance >>.
   O artigo interroga as respostas aos meios de subsist \& ecirc;ncia em
   que as fam \& iacute;lias das comunidades agr \& iacute;colas e piscat
   \& oacute;rias marginais se baseiam para se adaptarem \& agrave; degrada
   \& ccedil;\& atilde;o ambiental devida aos derrames de petr \&
   oacute;leo e \& agrave; queima de g \& aacute;s no Delta do N \&
   iacute;ger, na Nig \& eacute;ria. Demonstra como as percep \& ccedil;\&
   otilde;es e os entendimentos locais da polui \& ccedil;\& atilde;o
   ambiental ajudam as comunidades a enquadrar as respostas dos meios de
   subsist \& ecirc;ncia aos problemas ambientais no seu dom \& iacute;nio.
   Com base numa an \& aacute;lise de dados no terreno, o artigo identifica
   uma pluralidade de estrat \& eacute;gias de adapta \& ccedil;\& atilde;o
   na agricultura e na pesca. Revela que estas estrat \& eacute;gias s \&
   atilde;o paliativas e incapazes de mitigar os efeitos ambientais a longo
   prazo da extra \& ccedil;\& atilde;o de petr \& oacute;leo e g \&
   aacute;s na regi \& atilde;o. Esta situa \& ccedil;\& atilde;o incentiva
   uma mudan \& ccedil;a gradual da agricultura e da pesca para actividades
   de subsist \& ecirc;ncia baseadas no petr \& oacute;leo bruto,
   particularmente a refina \& ccedil;\& atilde;o artesanal de petr \&
   oacute;leo bruto, conhecida como `kpo-fire'. O estudo destaca o kpo-fire
   como uma resposta desadaptativa predominante, que, apesar de ser uma
   alternativa econ \& oacute;mica para muitos, agrava a polui \& ccedil;\&
   atilde;o ambiental; isto resulta num c \& iacute;rculo vicioso, que \&
   eacute; emblem \& aacute;tico daquilo a que o artigo se refere como a
   `armadilha da disfun \& ccedil;\& atilde;o dos meios de subsist \&
   ecirc;ncia'.},
Publisher = {CAMBRIDGE UNIV PRESS},
