@article{ WOS:001141204400001,
Author = {Arsito, Puguh Novi and Waiwut, Pornthip and Yenjai, Chavi and Arthan,
   Supakorn and Monthakantirat, Orawan and Nualkaew, Natsajee and
   Takomthong, Pitchayakarn and Boonyarat, Chantana},
Title = {Multifunctional effect of flavonoids from Millettia
   brandisiana against Alzheimer's disease pathogenesis},
Journal = {HELIYON},
Year = {2023},
Volume = {9},
Number = {11},
Month = {NOV},
Abstract = {Alzheimer's disease (AD) is a neurodegenerative disorder characterized
   by cognitive impairment and neuronal death. Fifteen flavonoids from
   Millettia brandisiana were evaluated for the multifunctional effect
   against AD pathogenesis, including butyrylcholine esterase (BuChE)
   inhibition, anti-amyloid beta (A beta) aggregation and neuroprotection
   against hydrogen peroxide (H2O2) toxicity in differentiated human
   neuroblastoma SH-SY5Y cell. To understand the mechanism and
   structure-activity relationship, binding interactions between flavonoids
   and the BuChE and A beta were investigated in silico. Furthermore,
   drug-likeness properties and ADMET parameters were evaluated in silico
   using SwissADME and pKCSM tools. All flavonoids exhibit a good
   drug-likeness profile. Six flavonoids have potency in BuChE inhibition,
   and four flavonoids show potency in anti-A beta aggregation. Flavonoids
   with the 6 `',6 `'-dimethylchromeno-{[}2 `',3 `':7,8]-flavone structure
   show a favorable multifunctional effect. In silico analysis showed that
   flavonoids can bind in various positions to the catalytic triad, anionic
   site, and acyl pocket. In A beta 1-42, potential flavonoids can attach
   to the central hydrophobic region and the C terminal hydrophobic and
   interfere with A beta interchain hydrogen binding. When compared
   together, it can inhibit multifunctional action with a favorable ADMET
   parameter and drug-likeness profile. In addition, candidine can prevent
   neuronal damage in differentiated SH-SY5Y neuroblastoma cells induced by
   H2O2 in a dose-dependent manner.},
Publisher = {CELL PRESS},
Address = {50 HAMPSHIRE ST, FLOOR 5, CAMBRIDGE, MA 02139 USA},
