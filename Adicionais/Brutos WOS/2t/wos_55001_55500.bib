@article{ WOS:000594647500003,
Author = {Wang, Shuang and Peng, Yun and Wang, Rongjuan and Jiao, Shasha and Wang,
   Min and Huang, Weijin and Shan, Chao and Jiang, Wen and Li, Zepeng and
   Gu, Chunying and Chen, Ben and Hu, Xue and Yao, Yanfeng and Min, Juan
   and Zhang, Huajun and Chen, Ying and Gao, Ge and Tang, Peipei and Li,
   Gang and Wang, An and Wang, Lan and Zhang, Jinchao and Chen, Shuo and
   Gui, Xun and Yuan, Zhiming and Liu, Datao},
Title = {Characterization of neutralizing antibody with prophylactic and
   therapeutic efficacy against SARS-CoV-2 in rhesus monkeys},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {NOV 13},
Abstract = {Efficacious interventions are urgently needed for the treatment of
   COVID-19. Here, we report a monoclonal antibody (mAb), MW05, with
   SARS-CoV-2 neutralizing activity by disrupting the interaction of
   receptor binding domain (RBD) with angiotensin-converting enzyme 2
   (ACE2) receptor. Crosslinking of Fc with Fc gamma RIIB mediates
   antibody-dependent enhancement (ADE) activity by MW05. This activity is
   eliminated by introducing the LALA mutation to the Fc region
   (MW05/LALA). Potent prophylactic and therapeutic effects against
   SARS-CoV-2 are observed in rhesus monkeys. A single dose of MW05/LALA
   blocks infection of SARS-CoV-2 in prophylactic treatment and clears
   SARS-CoV-2 in three days in a therapeutic treatment setting. These
   results pave the way for the development of MW05/LALA as an antiviral
   strategy for COVID-19. Here the authors characterize a monoclonal
   antibody from a COVID-19 convalescent patient that interferes with
   SARS-CoV-2 spike binding to ACE2 and has prophylactic and therapeutic
   activity in non-human primates. Antibody-dependent enhancement of
   infection is prevented by mutating the Fc region of the antibody.},
