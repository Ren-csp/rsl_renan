@article{ WOS:001668128500001,
Author = {Bianchetti, Ricardo and Khan, Tanveer Alam and Tran, Lam-Son Phan and
   Gururani, Mayank Anand},
Title = {Genetic engineering of phytochrome B and PIFs: Unlocking crop
   productivity and stress resilience},
Journal = {PLANT STRESS},
Year = {2026},
Volume = {19},
Month = {JAN},
Abstract = {Changes in environmental conditions threaten global crop yields by
   intensifying stresses, such as drought, salinity and extreme
   temperatures, which disrupt critical aspects of plant metabolism and
   structure. To adapt to these adverse conditions, plants have evolved
   various mechanisms, including the integration of light and temperature
   signals through phytochrome (PHY) perception. These photoreceptors play
   a central role in orchestrating stress responses by regulating
   transcriptional networks, ultimately impacting plant growth and
   metabolism. Recent advances in genetic engineering have opened
   opportunities to modulate Phytochrome B (PHYB), and their downstream
   component expression and activities Phytochrome interacting factors
   (PIFs), enabling the development of stress-resilient crop varieties.
   Various biotechnological techniques, such as genome editing, targeted
   mutagenesis, RNAi-mediated silencing, and tissue-specific
   overexpression, allow precise manipulation of PHYB-mediated signalling
   pathways. These interventions enhance crop performance under challenging
   conditions, including osmotic stress, extreme temperatures and light
   competition in densely planted systems. Furthermore, the combination of
   genetic engineering approaches offers a promising strategy to increase
   agricultural productivity in the face of global climate challenges. This
   review highlights the synergy between biotechnological advancements and
   the critical role of PHYB in advancing food security and promoting
   sustainable agriculture.},
