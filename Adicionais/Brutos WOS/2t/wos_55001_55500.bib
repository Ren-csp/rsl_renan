@article{ WOS:001273946900001,
Author = {Laforgue-Bullido, Noemi and Abril-Hervas, David and Malik-Lievano,
   Beatriz},
Title = {Hip-hop and education: A literature review of experiences},
Journal = {INTERNATIONAL REVIEW OF EDUCATION},
Year = {2024},
Volume = {70},
Number = {5},
Pages = {747-766},
Month = {OCT},
Abstract = {The purpose of this study was to describe educational initiatives that
   use hip-hop culture as a means of socio-educational action. To this end,
   the authors carried out a systematic review of relevant articles
   published over the last 10 years in high-impact peer-reviewed journals
   and written in English, Spanish, Portuguese or Italian. After applying
   inclusion/exclusion criteria, 68 articles were analysed. This analysis
   revealed how most of the reported experiences refer to formal secondary
   education. Although a third of these experiences are linked to critical
   pedagogies, these were not derived from the critical use of hip-hop -
   which was largely instrumental. But by means of a thematic content
   analysis, the authors identify the main strengths and limitations of
   hip-hop culture as an educational medium. Among the strengths they
   highlight are its potential to build culturally relevant educational
   contexts for students traditionally excluded from the academic
   curriculum, its fostering of students' political and social
   participation, and its facility to promote critical thinking. Among the
   challenges encountered in using hip-hop culture in educational spaces
   are some educators and families' perceptions of hip-hop as
   anti-educational, the imposition by educators of a vision of hip-hop
   that is not shared by young people, and the lack of systematisation of
   experiences that can provide guidance on how to carry out this type of
   initiative.
   Hip-hop et \& eacute;ducation : une analyse documentaire d'exp \&
   eacute;riences - Cette \& eacute;tude a pour objectif de d \&
   eacute;crire des projets \& eacute;ducatifs utilisant la culture hip-hop
   comme moyen d'action socio-\& eacute;ducatif. \& Agrave; cette fin, les
   auteurs ont effectu \& eacute; une analyse syst \& eacute;matique
   d'articles pertinents en anglais, en espagnol, en portugais ou en
   italien, publi \& eacute;s ces 10 derni \& egrave;res ann \& eacute;es
   dans des revues \& agrave; fort impact \& eacute;valu \& eacute;es par
   des pairs. Apr \& egrave;s application de crit \& egrave;res d'inclusion
   et d'exclusion, 68 articles ont \& eacute;t \& eacute; analys \&
   eacute;s. Cette analyse a r \& eacute;v \& eacute;l \& eacute; que la
   plupart des exp \& eacute;riences dont il est fait \& eacute;tat se
   rapportaient \& agrave; l'enseignement secondaire formel. Bien qu'un
   tiers d'entre elles fussent li \& eacute;es \& agrave; des p \&
   eacute;dagogies critiques, elles ne d \& eacute;coulaient pas de l'usage
   critique du hip-hop, qui \& eacute;tait largement d \& eacute;terminant.
   Toutefois, les auteurs ont recouru \& agrave; une analyse th \&
   eacute;matique du contenu pour identifier les principales forces et
   limites de la culture hip-hop en tant que moyen d'\& eacute;ducation,
   dont ils soulignent entre autres points forts les possibilit \& eacute;s
   de cr \& eacute;er des contextes \& eacute;ducatifs culturellement
   pertinents pour des \& eacute;tudiants traditionnellement exclus du
   cursus acad \& eacute;mique, le fait d'encourager les \& eacute;tudiants
   \& agrave; participer \& agrave; la vie politique et sociale, et la
   facilit \& eacute; \& agrave; promouvoir la pens \& eacute;e critique.
   Parmi les difficult \& eacute;s rencontr \& eacute;es dans l'utilisation
   de la culture hip-hop au sein des espaces \& eacute;ducatifs, notons le
   fait que certains \& eacute;ducateurs et certaines familles consid \&
   egrave;rent que le hip-hop est anti-\& eacute;ducatif - une vision impos
   \& eacute;e par les \& eacute;ducateurs que les jeunes ne partagent pas
   - et le manque de syst \& eacute;matisation des exp \& eacute;riences
   susceptibles d'offrir une orientation sur la fa \& ccedil;on de mener ce
   type de projets.
   Hip-hop y educaci \& oacute;n: una revisi \& oacute;n bibliogr \&
   aacute;fica de experiencias - El objetivo de este estudio fue describir
   iniciativas educativas que utilizan la cultura hip-hop como medio de
   acci \& oacute;n socioeducativa. Para ello, las/os autoras/es llevaron a
   cabo una revisi \& oacute;n sistem \& aacute;tica de art \& iacute;culos
   publicados en los \& uacute;ltimos 10 a \& ntilde;os en revistas
   revisadas por pares, de alto impacto y escritos en ingl \& eacute;s,
   espa \& ntilde;ol, portugu \& eacute;s o italiano. Tras aplicar
   criterios de inclusi \& oacute;n/exclusi \& oacute;n, se analizaron 68
   art \& iacute;culos. Este an \& aacute;lisis revel \& oacute; c \&
   oacute;mo la mayor \& iacute;a de las experiencias relatadas se refieren
   a la educaci \& oacute;n secundaria formal. Aunque un tercio de estas
   experiencias est \& aacute;n vinculadas a pedagog \& iacute;as cr \&
   iacute;ticas, \& eacute;stas no se derivaron en uso cr \& iacute;tico
   del hip-hop, que fue en gran medida instrumental. Adem \& aacute;s,
   mediante un an \& aacute;lisis de contenido tem \& aacute;tico, los
   autores identifican los principales puntos fuertes y las limitaciones de
   la cultura hip-hop como medio educativo. Entre los puntos fuertes
   destacan su potencial para construir contextos educativos culturalmente
   relevantes para alumnado tradicionalmente excluido del curr \&
   iacute;culo acad \& eacute;mico, su capacidad para fomentar la
   participaci \& oacute;n pol \& iacute;tica y social de las/os
   estudiantes y su facilidad para promover el pensamiento cr \&
   iacute;tico. Entre los retos encontrados en el uso de la cultura hip-hop
   en espacios educativos se encuentran la percepci \& oacute;n de algunos
   educadores y familias de la cultura hip-hop como antieducativa, la
   imposici \& oacute;n por parte de los educadores de una visi \& oacute;n
   del hip-hop que no es compartida por los j \& oacute;venes y la falta de
   sistematizaci \& oacute;n de experiencias que puedan orientar sobre c \&
   oacute;mo llevar a cabo este tipo de iniciativas.},
