@article{ WOS:000228524600043,
Author = {Wang, YX and Botvinick, EL and Zhao, YH and Berns, MW and Usami, S and
   Tsien, RY and Chien, S},
Title = {Visualizing the mechanical activation of Src},
Journal = {NATURE},
Year = {2005},
