@article{ WOS:001373472600001,
Author = {Hedin, Karl Alex and Mirhakkak, Mohammad H. and Vaaben, Troels Holger
   and Sands, Carmen and Pedersen, Mikael and Baker, Adam and
   Vazquez-Uribe, Ruben and Schaeuble, Sascha and Panagiotou, Gianni and
   Wellejus, Anja and Sommer, Morten Otto Alexander},
Title = {Saccharomyces boulardii enhances anti-inflammatory effectors and AhR
   activation via metabolic interactions in probiotic communities},
Journal = {ISME JOURNAL},
Year = {2024},
Volume = {18},
Number = {1},
Month = {DEC 10},
Abstract = {Metabolic exchanges between strains in gut microbial communities shape
   their composition and interactions with the host. This study
   investigates the metabolic synergy between potential probiotic bacteria
   and Saccharomyces boulardii, aiming to enhance anti-inflammatory effects
   within a multi-species probiotic community. By screening a collection of
   85 potential probiotic bacterial strains, we identified two strains that
   demonstrated a synergistic relationship with S. boulardii in pairwise
   co-cultivation. Furthermore, we computationally predicted cooperative
   communities with symbiotic relationships between S. boulardii and these
   bacteria. Experimental validation of 28 communities highlighted the role
   of S. boulardii as a key player in microbial communities, significantly
   boosting the community's cell number and production of anti-inflammatory
   effectors, thereby affirming its essential role in improving symbiotic
   dynamics. Based on our observation, one defined community significantly
   activated the aryl hydrocarbon receptor-a key regulator of immune
   response-280-fold more effectively than the community without S.
   boulardii. This study underscores the potential of microbial communities
   for the design of more effective probiotic formulations.},
