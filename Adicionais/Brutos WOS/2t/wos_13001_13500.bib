@article{ WOS:000374466000001,
Author = {Cohen, Deborah A. and Hunter, Gerald and Williamson, Stephanie and
   Dubowitz, Tamara},
Title = {Are Food Deserts Also Play Deserts?},
Journal = {JOURNAL OF URBAN HEALTH-BULLETIN OF THE NEW YORK ACADEMY OF MEDICINE},
Year = {2016},
Volume = {93},
Number = {2},
Pages = {235-243},
Month = {APR},
Abstract = {Although food deserts are areas that lack easy access to food outlets
   and considered a barrier to a healthy diet and a healthy weight among
   residents, food deserts typically comprise older urban areas which may
   have many parks and street configurations that could facilitate more
   physical activity. However, other conditions may limit the use of
   available facilities in these areas. This paper assesses the use of
   parks in two Pittsburgh food desert neighborhoods by using systematic
   observation. We found that while the local parks were accessible, they
   were largely underutilized. We surveyed local residents and found that
   only a minority considered the parks unsafe for use during the day, but
   a substantial proportion suffered from health limitations that
   interfered with physical activity. Residents also felt that parks lacked
   programming and other amenities that could potentially draw more park
   users. Parks programming and equipment in food desert areas should be
   addressed to account for local preferences and adjusted to meet the
   needs and limitations of local residents, especially seniors.},
