@article{ WOS:001523772000001,
Author = {McGauley, M. W. and Zaremba, G. and Wadzuk, B. M.},
Title = {A Complete Water Balance of a Constructed Stormwater Wetland},
Journal = {WATER RESOURCES RESEARCH},
