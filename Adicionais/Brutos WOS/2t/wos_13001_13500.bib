@article{ WOS:000912154500001,
Author = {Croes, Robertico and Kubickova, Marketa and Ridderstaat, Jorge},
Title = {Destination Competitiveness and Human Development: The Compelling
   Critical Force of Human Agency},
Journal = {JOURNAL OF HOSPITALITY \& TOURISM RESEARCH},
Year = {2023},
Volume = {47},
Number = {4},
Pages = {NP62-NP75},
Month = {MAY},
Abstract = {The study investigates whether governance and human agency act as
   intervening factors in the context of destination competitiveness and
   human development. This study employs the capability approach-that is,
   operationalizing human agency from an empowerment (feminist)
   perspective-and employed a case study research strategy to highlight the
   criticality of context. The results point to a bidirectional
   relationship between destination competitiveness and human development.
   Findings support three requisites: empowering people through
   occupational opportunities, promoting tourism toward sustaining human
   development, and placing agency over governance regarding public
   resource allocation. Surprisingly, results indicated that governance is
   lacking in the relationship between destination competitiveness and
   human development. Future research should concentrate on investigating
   urban versus rural destinations and gender roles, and in disaggregating
   employement indices to further understand the nature and forces of such
   relationships.},
