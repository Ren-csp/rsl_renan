@article{ WOS:001338022300003,
Author = {Poudel, Jiban Mani},
Title = {Caring for standing crops in the Himalayas: embedded notion of saving to
   save},
Journal = {ECOLOGY AND SOCIETY},
Year = {2024},
Volume = {29},
Number = {4},
Month = {OCT},
Abstract = {In the Himalayas, human beings have developed several behaviors and
   practices in the process of adaptation to the harsh environment. The
   theme of the paper is to explore the notion of care through the local
   practices of caring for standing crops. The paper is based on the more
   than nine-month-long ethnographic study in the Nh \& amacr;son Valley of
   Nepal. The findings reveal that caring for standing crops is not just
   rooted in technical rationality imposed by external agencies; it is
   cultivated in the concept of ethics of saving to save and respect for
   others' property. The beliefs and practices of caring for standing crops
   reveal that the landscape is not only for humans and animals but also
   for divine beings, whose presence must be recognized and acknowledged
   when discussing human nature relationships. The study challenges the
   reductionist approach of these relationships by focusing on how farmers'
   workaday practices like fencing; implementing social regulations; and
   performing rituals bring science and society together. This integration
   creates a resilient and robust ecological framework for environmental
   study.},
