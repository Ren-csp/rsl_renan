@article{ WOS:001432640400001,
Author = {Bobo, Thomas},
Title = {Guerra del agua in Bolivia: environmental discourse, power and
   the politics of `green'},
Journal = {JOURNAL OF ENVIRONMENTAL POLICY \& PLANNING},
Year = {2025},
Volume = {27},
Number = {4},
