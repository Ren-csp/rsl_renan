   Dhakal, Maheshwar, Govt Nepal, Minist Forests \& Environm, Kathmandu, Nepal.},
DOI = {10.3759/tropics.MS19-07},
ISSN = {0917-415X},
EISSN = {1882-5729},
Keywords = {Buffer Zone Community Forest; Chitwan National Park; Conservation
   policy; Ecotourism; Forest resources},
Keywords-Plus = {COMMUNITY FORESTRY; PROTECTED AREAS; PEOPLES PERCEPTIONS; MANAGEMENT
