   Kim, Juyoung; Kochanska, Grazyna, Univ Iowa, Dept Psychol \& Brain Sci, Iowa City, IA 52242 USA.},
DOI = {10.1017/S0954579424001731},
EarlyAccessDate = {NOV 2024},
ISSN = {0954-5794},
EISSN = {1469-2198},
Keywords = {Anger; diathesis-stress; differential susceptibility; disregard for
   rules; fear},
Keywords-Plus = {DEVELOPMENTAL PATHWAYS; EXTERNALIZING BEHAVIOR; ATTACHMENT SECURITY;
   MULTIPLE PATHWAYS; SELF-REGULATION; MOTHER-CHILD; TEMPERAMENT;
   SENSITIVITY; ENVIRONMENT; DISCIPLINE},
