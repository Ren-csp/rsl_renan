@article{ WOS:000372552100004,
Author = {Taylor-Covill, Guy A. H. and Eves, Frank F.},
Title = {Carrying a Biological ``Backpack{''}: Quasi-Experimental Effects of
   Weight Status and Body Fat Change on Perceived Steepness},
Journal = {JOURNAL OF EXPERIMENTAL PSYCHOLOGY-HUMAN PERCEPTION AND PERFORMANCE},
Year = {2016},
Volume = {42},
Number = {3},
Pages = {331-338},
Month = {MAR},
Abstract = {The apparent steepness of hills and stairs is overestimated in explicit
   perception. These overestimations are malleable in that when
   physiological resources are compromised, apparent steepness is further
   overestimated. An alternative explanation of these experimental findings
   attributes them to demand characteristics. This article tests the
   relationship between estimated steepness and naturally occurring
   differences in body composition. A quasi-experimental field study
   revealed more exaggerated reports of staircase steepness in overweight
   than in healthy-weight participants in a situation where experimental
   demand would be an implausible explanation for any differences. A
   longitudinal follow-up study used dual X-ray absorptiometry to
   objectively measure participants' body composition at the beginning and
   end of a weight-loss program (N = 52). At baseline, higher levels of
   body fat were associated with steeper explicit estimates of staircase
   steepness. At follow-up, changes in body fat were associated with
   changes in estimated steepness such that a loss of fat mass co-occurred
   with shallower estimates. Discussion focuses on the malleability of
   perceived steepness at an individual level and the implication of these
   findings for the debate surrounding ``embodied{''} models of perception.},
