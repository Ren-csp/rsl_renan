@article{ WOS:001855156900001,
Author = {Cotts, Leonardo and Schumm, Leonard and Pires, Jeferson Rocha and da
   Luz-Mathias, Maria and Rocha-Barbosa, Oscar},
Title = {First record of xanthochromism in Nasua (Carnivora, Procyonidae)
   with notes on anomalously colored coatis},
Journal = {MAMMALIA},
Year = {2026},
Month = {2026 AUG 24},
Abstract = {Coatis (Nasua) are diurnal, gregarious mesocarnivores widely distributed
   across the Americas. Chromatic disorders are rarely documented in this
   genus. Here, we report the first record of xanthochromism in Nasua,
   based on two individuals of N. nasua observed in Tijuca National Park,
   Brazil, one of the largest urban forests in the world. The xanthochromic
   individuals exhibited a markedly yellow-orange coat, differing from the
   typical coloration of the species. Records were restricted to edge
   areas, suggesting a potential spatial association with environmental
   conditions, including anthropogenic disturbance. This finding provides
   new insights into phenotypic variation in coatis and highlights the
   potential influence of environmental conditions on the emergence of
   anomalous coloration in urban-forest interface areas.},
