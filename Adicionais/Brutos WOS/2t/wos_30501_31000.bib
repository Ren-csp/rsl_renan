   Garrecht, Carola; Harms, Ute, IPN Leibniz Inst Sci \& Math Educ, Dept Biol Educ, Kiel, Germany.
   Christenson, Nina; Gericke, Niklas, Karlstad Univ, Dept Environm \& Life Sci, Karlstad, Sweden.
   Haglund, Jesper, Karlstad Univ, Dept Engn \& Phys, Karlstad, Sweden.
   Appelgren, Jari, Karlstad Univ, Karlstad Business Sch, Karlstad, Sweden.},
DOI = {10.1002/sd.71510},
EarlyAccessDate = {JUL 2026},
ISSN = {0968-0802},
EISSN = {1099-1719},
Keywords = {climate action; climate literacy; risk perception; sequential regression
   analysis},
