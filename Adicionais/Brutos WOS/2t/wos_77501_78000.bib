@article{ WOS:000330448800005,
Author = {Lundqvist, Daniel and Reineholm, Cathrine and Gustavsson, Maria and
   Ekberg, Kerstin},
Title = {Investigating Work Conditions and Burnout at Three Hierarchical Levels},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2013},
Volume = {55},
Number = {10},
Pages = {1157-1163},
Month = {OCT},
Abstract = {Objective: To investigate the differences and the association between
   work conditions and symptoms of burnout at the three hierarchical
   levels: subordinates, first-line managers, and middle managers. Methods:
   Analyses were based on questionnaire data from 4096 employees in nine
   organizations, containing three hierarchical levels: subordinates (n =
   3659), first-line managers (n = 345), and middle managers (n = 92).
   Results: Work conditions were found to differ between the three
   hierarchical levels, mostly between subordinates and managers. Managers
   experienced fewer symptoms of burnout than subordinates. Furthermore,
   the association between work conditions and burnout differed for
   subordinates, first-line managers, and middle managers. Conclusions:
   Occupational health research needs to focus more on differences between
   hierarchical levels regarding work conditions and burnout.},
