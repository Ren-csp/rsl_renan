Title = {PARTNERSHIP BETWEEN THE PUBLIC AND PRIVATE SECTORS AS EDUCATIONAL
   POLICY: REPORT OF SOME RESEARCH},
Journal = {REVISTA IBERO-AMERICANA DE ESTUDOS EM EDUCACAO},
Year = {2022},
