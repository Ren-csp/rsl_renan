@incollection{ WOS:001615509700006,
Author = {Persson, Fabian},
Editor = {Neighbors, DM and Norgaard, LC and Woodacre, E},
Title = {Public Displays of Affection: Creating Spheres of Apparent Royal
   Intimacy in Public},
Booktitle = {NOTIONS OF PRIVACY AT EARLY MODERN EUROPEAN COURTS: Reassessing the
   Public/Private Divide, 1400-1800},
Series = {Early Modern Court Studies},
Year = {2025},
Pages = {143-162},
Abstract = {At the Swedish court in the 1770s, the entrees and regulations aimed at
   creating a detailed hierarchy of visible access to members of the
   aristocracy were not a list of men and women particularly close to the
   royal family. Instead, the entrees fulfilled several functions including
   imitation of Versailles. In particular, they could boost the prestige of
   a number of men and women. However, the men and women who received this
   status were almost all courtiers. Increasing their prestige thus also
   intensified the potential respect due to the court and, therefore, the
   monarch himself. The court connections needed for an entree emphasised
   how the king was the undisputed centre of this new political system
   after the 1772 coup. The handing out of entrees to a few princes
   furthermore aimed to augment the prestige of the court around the king.},
