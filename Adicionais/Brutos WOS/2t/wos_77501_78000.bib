@article{ WOS:000726109300005,
Author = {Marieyhara, Ines Dosil and Gallego, Laura Lopez},
Title = {Narratives of criminalization, stigmatization and counter-stigmatization
   of teenagers in their meetings with the Uruguayan police},
Journal = {PSICOLOGIA CONOCIMIENTO Y SOCIEDAD},
Year = {2021},
Volume = {11},
Number = {3},
Pages = {86-107},
Month = {NOV-APR},
Abstract = {In this article, we present the results of the research we carried out
   with adolescents, within the framework of the emergence of a crime
   prevention program that was implemented in the outskirts of Montevideo.
   Based on narratives constructed with the participants, young people of
   18 and 19 years of age who had been detained in police stations, we
   proposed to make visible the daily practices of police control to which
   they are exposed. In this paper, we ask about the situations of
   harassment and humiliation experienced by young people in their dealings
   with the police, emphasising their strategies of resistance, as well as
   the emotions/affections that circulate in these encounters. The
   discussion about how and what for investigate the forms of police
   control over precarious young people takes on ethical and political
   relevance, articulated with the processes of circulation and
   dissemination of the knowledge produced.},
