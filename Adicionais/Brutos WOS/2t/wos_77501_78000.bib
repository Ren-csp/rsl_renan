@article{ WOS:000352721000001,
Author = {Zehr, Stephen},
Title = {The sociology of global climate change},
Journal = {WILEY INTERDISCIPLINARY REVIEWS-CLIMATE CHANGE},
Year = {2015},
Volume = {6},
Number = {2},
Pages = {129-150},
Month = {MAR-APR},
Abstract = {Sociological research on global climate change (GCC) can be found in
   several subfields, but it has primarily emerged within the theoretical
   and substantive domain of sociology of the environment. This review
   provides an overview of sociological literature on climate change and
   identifies key areas for further research and development. The review
   focuses on four broad areas: social causes, construction of the problem,
   relationship between GCC and social inequality, and social dimensions of
   mitigation and adaptation. (C) 2014 JohnWiley \& Sons, Ltd.},
