@article{ WOS:000691469000001,
Author = {Miao, Tingting and Li, Dezhi and Huang, Ziyuan and Huang, Yuewei and Li,
   Shaoshan and Wang, Yan},
Title = {Gibberellin regulates UV-B-induced hypocotyl growth inhibition in
   Arabidopsis thaliana},
Journal = {PLANT SIGNALING \& BEHAVIOR},
Year = {2021},
Volume = {16},
Number = {11},
Month = {NOV 2},
Abstract = {Plant response to light is a complex and diverse phenomenon. Several
   studies have elucidated the mechanisms via which light and hormones
   regulate hypocotyl growth. However, the hormone-dependent ultraviolet-B
   (UV-B) response in plants remains obscure. Involvement of gibberellins
   (GAs) in UV-B-induced hypocotyl inhibition and its mechanisms in
   Arabidopsis thaliana were investigated in the present research. UV-B
   exposure remarkably decreased the endogenous GA(3) content through the
   UV RESISTANCE LOCUS 8 (UVR8) receptor pathway, and exogenous GA(3)
   partially restored the hypocotyl growth. UV-B irradiation affected the
   expression levels of GA metabolism-related genes (GA20ox1, GA2ox1 and
   GA3ox1) in the hy5-215 mutant, resulting in increased GA
   content.ELONGATED HYPOCOTYL 5 (HY5) promoted the accumulation of DELLA
   proteins under UV-B radiation; HY5 appeared to regulate the abundance of
   DELLAs at the transcriptional level under UV-B. As a result, the GA(3)
   content decreased, which eventually led to the shortening of the
   hypocotyl. To conclude, the present study provides new insight into the
   regulation of plant photomorphogenesis under UV-B.},
