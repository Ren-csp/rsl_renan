@article{ WOS:001534935400006,
Author = {Bejarano-Coca, Diana-Carolina},
Title = {Photoperformance as a Methodological and Communicative Tool in Artistic
   and Social Research},
Journal = {REVISTA MEDITERRANEA COMUNICACION-JOURNAL OF COMMUNICATION},
Year = {2025},
Volume = {16},
Number = {2, SI},
Month = {JUL-DEC},
Abstract = {Purpose. This study analyzes photoperformance as a methodological and
   communicative tool in artistic, humanistic, and social research. It
   explores its potential to overcome the limitations of verbal knowledge
   and validate embodied ways of knowing. Methodology. A transdisciplinary
   approach is adopted, starting from bodily experience and the power of
   practice, to examine photoperformance as a means of recording and
   transmitting subjectivities. It questions modern Western epistemology
   and proposes a performative turn integrating critical theory.Results and
   Conclusions. This study demonstrates that photoperformance facilitates
   the construction and deconstruction of identity, memory, and affections,
   enabling new forms of communication and knowledge. Images capture not
   only the ephemeral nature of the action but also its context and social
   significance. Novelty.This work contributes to the debate on research
   methodologies based on corporeality, advocating for performance and
   photoperformance as valid practices for knowledge generation and
   transmission, challenging the Cartesian paradigm of mind-body separation},
