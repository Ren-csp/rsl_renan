@article{ WOS:000401398900020,
Author = {Savan, Beth and Cohlmeyer, Emma and Ledsham, Trudy},
Title = {Integrated strategies to accelerate the adoption of cycling for
   transportation},
Journal = {TRANSPORTATION RESEARCH PART F-TRAFFIC PSYCHOLOGY AND BEHAVIOUR},
Year = {2017},
Volume = {46},
Number = {A},
Pages = {236-249},
Month = {APR},
Abstract = {This study synthesizes academic social psychological behaviour change
   literature with reports on the practical, community-based application of
   cycling programs. We identify the combination of psychological tools
   demonstrated to lead to changes in behaviour in the target population.
   We compare these tools with reports demonstrating evidence for success
   from monitored programs to encourage cycling adoption. Based on the
   alignment between these two literatures, we developed an adaptable,
   evidenced-based strategy for program developers to most effectively
   accelerate the adoption of cycling for transportation in areas where
   physical barriers are few. A brief case study affirms the effectiveness
   of this approach. (C) 2017 The Author(s). Published by Elsevier Ltd.},
