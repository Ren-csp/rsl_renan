@article{ WOS:000658614500001,
Author = {Rivera, Gabrielle B. and Jama, Sagal and Bailey, Nicole and Gordon, Nora
   and Bliss-Barsness, Christina and Caspi, Caitlin E. and Pratt, Rebekah},
Title = {The Lived Experience of Food Pantry Users in Minnesota: Qualitative
   Findings from a Statewide Survey},
Journal = {JOURNAL OF HUNGER \& ENVIRONMENTAL NUTRITION},
Year = {2023},
Volume = {18},
Number = {2},
Pages = {178-191},
Month = {MAR 4},
Abstract = {In 2017, a community-University of X collaborative conducted a statewide
   survey of food pantry clients. Of the 188 food pantries surveyed, 4321
   individual client surveys were returned, from which 2,251 open-ended
   responses were analyzed. Respondents shared gratitude for the food
   pantry in meeting their needs for food and support. Many described
   accessing healthy food that was needed to address health needs.
   Respondents described life circumstances and hardships that led to food
   pantry use. The supportive environment provided by food pantries
   positions them to address the needs of clients, including those with
   complex health needs.},
