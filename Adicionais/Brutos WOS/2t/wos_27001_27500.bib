@article{ WOS:001438728700001,
Author = {Moore, David S. and Kampourakis, Kostas and Gericke, Niklas},
Title = {The Problems with Genetic Essentialism, Determinism, and Reductionism},
Journal = {HUMAN DEVELOPMENT},
Year = {2025},
Volume = {69},
Number = {3},
Pages = {147-157},
Month = {SEP},
Abstract = {In this article, we address misunderstandings about genetic
   essentialism, genetic determinism, and genetic reductionism. There are
   good reasons to carefully consider the meanings and relationships that
   characterize genetic essentialism, genetic determinism, and genetic
   reductionism; these are different (if related) concepts, despite their
   superficial resemblances. Although a recent Nature Reviews Genetics
   article addressed these issues, problems intrinsic to them remained
   unexplored, problems that we address here by adopting a developmental
   systems perspective. Discussions of these concepts should explicitly
   communicate that genetic essentialism fails because individuals are as
   they are in part due to the contexts in which they develop, that genetic
   determinism fails because all phenotypes depend on co-acting genomic and
   non-genomic factors for their development, and that genetic reductionism
   fails because emergent properties above the level of the genome can feed
   back and influence the subsequent functioning of that genome.
   Elucidating the meaning of these concepts without providing arguments
   for rejecting them is problematic. Developmental science offers the
   required arguments.<br /> (c) 2025 S. Karger AG, Basel},
Publisher = {KARGER},
Address = {ALLSCHWILERSTRASSE 10, CH-4009 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Moore, DS (Corresponding Author), Pitzer Coll, Psychol Field Grp, Claremont, CA 91711 USA.
   Moore, DS (Corresponding Author), Claremont Grad Univ, Claremont, CA 91711 USA.
   Moore, David S., Pitzer Coll, Psychol Field Grp, Claremont, CA 91711 USA.
   Moore, David S., Claremont Grad Univ, Claremont, CA 91711 USA.
   Kampourakis, Kostas, Univ Geneva, Sect Biol, Geneva, Switzerland.
   Kampourakis, Kostas, Univ Geneva, IUFE, Geneva, Switzerland.
   Gericke, Niklas, Karlstad Univ, Dept Environm \& Life Sci, Karlstad, Sweden.},
DOI = {10.1159/000543465},
EarlyAccessDate = {JAN 2025},
ISSN = {0018-716X},
EISSN = {1423-0054},
