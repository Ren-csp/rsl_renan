@article{ WOS:001565764300001,
Author = {Ahn, Chang Hyuk and Park, Yoonkyung},
Title = {Build-up and wash-off behavior of heavy metals in road-deposited
   sediments on asphalt surfaces: A grain-size-resolved modeling approach
   for urban runoff risk},
Journal = {JOURNAL OF HAZARDOUS MATERIALS ADVANCES},
Year = {2025},
Volume = {19},
Month = {AUG},
Abstract = {Effective management of urban stormwater pollution requires a
   mechanistic understanding of road-deposited sediments (RDS) and their
   associated heavy metals on impervious surfaces. This study presents a
   grain-sizeresolved field investigation of RDS and metal (e.g., Zn, Pb,
   Cu, and Cr) behavior across two full-scale asphalt parking lots with
   contrasting void structures and traffic intensities. Fine particles
   smaller than 250 mu m served as robust indicators of long-term sediment
   and metal build-up, while finer fractions under 125 mu m were more
   readily mobilized during initial rainfall, acting as primary
   contributors to first-flush contamination. Empirical build-up and
   wash-off models, calibrated from repeated rainfall events, yielded key
   parameters (e.g., B-max, C-1, C-2, and C-3) that capture size- and
   metal-specific transport dynamics. A correlation between surface void
   volume and equilibrium RDS accumulation highlights the role of
   microscale retention in pollutant storage. These findings provide
   field-calibrated coefficients applicable to urban stormwater simulation
   tools such as the Storm Water Management Model, enabling improved
   prediction of metal-laden particle transport. By incorporating particle
   size effects into model parameters, this study supports the design and
   timing of size-specific best management practices and offers practical
   implications for runoff regulation and infrastructure planning.},
