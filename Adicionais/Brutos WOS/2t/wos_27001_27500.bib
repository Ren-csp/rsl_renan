@article{ WOS:001840394200001,
Author = {Ali, Lubna and Jones, Liz and Au, Amanda and Occhipinti, Stefano},
Title = {``It's your fault!{''}: Exploring stigma towards lung cancer in a
   multicultural society},
Journal = {JOURNAL OF HEALTH PSYCHOLOGY},
Year = {2026},
Month = {2026 AUG 4},
Abstract = {Stigmatising attitudes towards lung cancer exist across cultures based
   on societal norms and beliefs. However, there is a notable gap in
   research on lung cancer stigma within Asian cultures such as Malaysia.
   Our study explored Malaysian public attitudes towards lung cancer
   through qualitative semi-structured interviews with 32 participants (11
   Malays, 11 Chinese, and 10 Indians). Findings highlighted religious
   beliefs shaped participants' perceptions, with some seeing cancer as
   fate or punishment, while gender norms also influenced how lung cancer
   was perceived, with societal expectations differing for men and women.
   Participants primarily attributed lung cancer to internal factors such
   as smoking, leading to moral judgements of personal responsibility,
   while some acknowledged genetic predispositions and environmental risks.
   Our study shows how sociocultural factors, including patriarchal and
   religious values, influence perceptions of lung cancer, underscoring the
   importance of culturally sensitive approaches to improve public health
   outcomes of lung cancer.},
