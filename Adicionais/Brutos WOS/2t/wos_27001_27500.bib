@article{ WOS:000278105200030,
Author = {de Vries, Sanne I. and Hopman-Rock, Marijke and Bakker, Ingrid and
   Hirasing, Remy A. and van Mechelen, Willem},
Title = {Built Environmental Correlates of Walking and Cycling in Dutch Urban
   Children: Results from the SPACE Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2010},
Volume = {7},
Number = {5},
Pages = {2309-2324},
Month = {MAY},
Note = {6th International Symposium on Recent Advances in Environmental Health
   Research, Jackson, MS, SEP 13-16, 2009},
Organization = {Jackson State Univ},
Abstract = {This study examined built environmental correlates of children's walking
   and cycling behavior. Four hundred and forty-eight children from 10
   Dutch neighborhoods completed a seven-day physical activity diary in
   which the number of walking and cycling trips for transportation, to
   school, and for recreation were assessed. The associations between
   observed built environmental characteristics and children's walking and
   cycling behavior were examined with multivariate linear regression
   analyses. The results showed that built environmental correlates of
   children's walking and cycling behavior differ by purpose and by
   commuting mode implying a behavior-specific approach for interventions
   and for future, preferably prospective, studies.},
