@article{ WOS:001439253500001,
Author = {Wilcox, Annika and Koontz, Amanda and Gau, Jacinta M. and Jasinski, Jana
   L. and Reinhart, Debra R. and Walters, Linda J.},
Title = {Advancing Equity in Academia: Science, Technology, Engineering, and
   Mathematics (STEM) Faculty Perceptions of Organizational Justice and
   Organizational Authenticity},
Journal = {JOURNAL OF DIVERSITY IN HIGHER EDUCATION},
Year = {2026},
Volume = {19},
Number = {1},
Pages = {74-88},
Month = {FEB},
Abstract = {Despite recent efforts to advance equity, perceptions remain of chilly
   climates that can harm work experiences in academic science, technology,
   engineering, and mathematics (STEM) fields. The organizational justice
   framework is a well-supported model for understanding and addressing
   such perceived academic (in)equities, yet it focuses on the department
   level and has limitations in contextualizing departmental issues within
   the broader environment of the neoliberal university. We therefore
   integrate the frameworks of organizational justice and organizational
   authenticity to better understand minoritized STEM faculty members'
   perceptions of work environments and improve their lived work
   experiences. Utilizing data collected via an explanatory sequential
   mixed-methods study of STEM faculty at a large, public, R1 research
   university also classified as a Hispanic-serving institution (HSI), we
   examine how faculty's perceptions of organizational authenticity are
   linked to their social identities and perceptions of organizational
   justice. First, we analyze original survey data (N = 132) to reveal that
   (a) Hispanic STEM faculty report significantly lower perceptions of
   university authenticity than non-Hispanic STEM faculty and (b) STEM
   faculty who perceive equitable distributions of resources and rewards in
   their departments report significantly higher perceptions of university
   authenticity. Then, we qualitatively analyze in-depth interview (N = 12)
   and focus group (N participants = 7) data, tracing perceived
   organizational inauthenticity to (a) the university's operation as an
   HSI and (b) the university's approach to supporting and rewarding
   faculty achievement. Results suggest that aligning university practices
   with proclaimed university goals and values might increase perceptions
   of organizational authenticity while also addressing organizational
   justice to improve minoritized STEM faculty's work experiences.},
