@article{ WOS:000248978800012,
Author = {Katavic, Peter L. and Lamb, Kenneth and Navarro, Hernan and Prisinzano,
   Thomas E.},
Title = {Flavonoids as opioid receptor ligands: Identification and preliminary
   structure-activity relationships},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2007},
Volume = {70},
Number = {8},
Pages = {1278-1282},
Month = {AUG},
Abstract = {Flavonoids have been recognized as the active ingredients of many
   medicinal plant extracts due to interactions with proteins via phenolic
   groups and low toxicity. Here, we report the investigation of the
   flavonoid core as a potential new scaffold for the development of opioid
   receptor ligands. Biological results suggest that stereochemistry of the
   C2 and C3 positions is important for antagonist activity and
   selectivity. Our results also suggest that the actions of Hypericum
   perforatum may be mediated in part by opioid receptors.},
