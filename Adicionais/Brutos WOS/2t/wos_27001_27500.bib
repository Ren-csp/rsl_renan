@article{ WOS:001853861600001,
Author = {Weiss, Antonia},
Title = {Sprouting pasts: Migration, cultivation, and landscape making in
   Amsterdam Nieuw-West},
Journal = {JOURNAL OF HISTORICAL GEOGRAPHY},
Year = {2026},
Volume = {93},
Pages = {312-324},
Month = {SEP},
Abstract = {European historiography has traditionally emphasized the influence of
   rural-urban migration in establishing city food cultivation during the
   industrial period. Limited attention though has been paid to the
   contribution of international migrants to the more recent history of
   urban gardening in Europe. This paper focuses on the Amsterdam district
   Nieuw-West, a postwar urban expansion with a majority migrant
   population, many of whom are actively engaged in cultivating food across
   the neighborhood's abundant green. Drawing on oral history interviews,
   archival sources, and ethnographic fieldwork involving participatory
   gardening, the paper analyzes the relationship between the resident's
   biographies and the transformation of this postwar green infrastructure
   into an increasingly edible landscape since the 1980s. I argue that the
   continuities of gardening practice, embodied know-how, and stewardship
   which migrant residents have brought to local green spaces amount to a
   collective act of landscape authorship; even as their making of
   landscape has been contingent on postwar planning ideologies and
   neoliberal urban renewal agendas that have obscured and undermined these
   very continuities of practice, memory, and care. The paper makes the
   case for approaching sites of cultivation as the outcome of entangled
   histories of land and people, and of the futures anticipated within
   them. (c) 2026 The Author(s). Published by Elsevier Ltd. This is an open
   access article under the CC BY license
   (http://creativecommons.org/licenses/by/4.0/).},
