@article{ WOS:000455181700003,
Author = {Rosenberger, Albert and Hung, Rayjean J. and Christiani, David C. and
   Caporaso, Neil E. and Liu, Geoffrey and Bojesen, Stig E. and Le
   Marchand, Loic and Haiman, Ch. A. and Albanes, Demetrios and Aldrich,
