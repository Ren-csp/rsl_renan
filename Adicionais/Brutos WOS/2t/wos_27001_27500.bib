@article{ WOS:000247067600005,
Author = {O'Donnell, Mike},
Title = {We need human rights not nationalism `lite' - Globalization and British
   solidarity},
Journal = {ETHNICITIES},
Year = {2007},
Volume = {7},
Number = {2},
Pages = {248-269},
Month = {JUN},
Abstract = {The article explores the relationship of multiculturalism to social
   solidarity. The multicultural nature of Britain is accepted as a welcome
   reality but certain problems in relation to the development of
   multiculturalism in Britain are acknowledged. Various approaches to
   buttress or replace multiculturalism are reviewed. These are: a
   strengthened and/or reconstituted nationalism (Britishness'); human
   rights; and social equality. The issue of citizenship recurs throughout.
   It is argued that a combined emphasis on human rights and greater social
   equality offer a better basis than nationalism for strengthening
   solidarity in Britain, especially in the longer term. Sociological
   theory offers a fruitful if strangely neglected starting point for
   understanding social solidarity. I draw critically on Durkheim and Marx
   to obtain some objective perspective on this controversial matter.},
