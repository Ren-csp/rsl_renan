@article{ WOS:001694675300001,
Author = {Pacheco, Ellen R. and Patrick, Shelby M.},
Title = {Environmental influences on the construction of human-dog relations:
   Insights from Northern Mexico and the North American Arctic},
Journal = {JOURNAL OF SOCIAL ARCHAEOLOGY},
Year = {2026},
Volume = {26},
Number = {2},
Pages = {113-131},
Month = {JUN},
Abstract = {For centuries, dogs have played an integral role in human lives, serving
   as companions, protectors, food sources, and many other roles. However,
   their ultimate perception was highly predicated on the social,
   ideological, and environmental circumstances of the cultures they lived
   in. Through analyzing canid faunal remains, ethnographies, and
   ethnohistoric depictions of dogs this paper aims to compare dogs' roles
   within Northern Mexico and the North American Arctic, two regions with
   vastly different environments. By utilizing a cross-cultural approach
   and examining the similarities and differences in dogs' treatment within
   the study regions, we argue that environmental factors cannot be
   discounted when analyzing the development of human-dog relations.},
