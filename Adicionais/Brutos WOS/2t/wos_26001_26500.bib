Title = {Sibling interference in mother-offspring interactions reveals jealous
   reactions in wild baboons},
Journal = {PROCEEDINGS OF THE ROYAL SOCIETY B-BIOLOGICAL SCIENCES},
Year = {2026},
Volume = {293},
