@article{ WOS:001861490600001,
Author = {Kehler, Sarah and Birchall, S. Jeff},
Title = {Resilient by design? A systematic literature review on place, planning
   and perception in social-ecological systems},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {114},
Month = {SEP},
Abstract = {Place-based adaptation shows potential to safeguard the well-being of
   communities facing climate change impacts. However, its implementation
   is complicated by conceptual ambiguity surrounding ``place{''} and
   limited understanding of its role in adaptation. Broadly, adaptation
   efforts often result in maladaptation - when adaptation causes
   unintended negative consequences. Maladaptation often arises from
   differences in individual perception, mediated by worldview and
   institutions guiding knowledge and values, which complicates planning
   processes for interdependent social and ecological systems. This
   systematic literature review aims to elucidate the role of place and
   perception in effective adaptation planning by consolidating research
   linking perception with place relationships and social-ecological
   systems (SES). Peer-reviewed literature was retrieved through Web of
   Science, Scopus and ProQuest. Screening of 835 unique publications
   resulted in a set of 163 articles that met predefined eligibility
   criteria. Database analysis revealed growing interest in the topic,
   spanning distinct journals, disciplines and authors. Articles
   predominantly found place relationships within SES were reciprocal and
   fostered resilience, regardless of landscape type. However, place was
   frequently undefined, planning featured only minorly, and data on
   perception could not be generalized. Addressing this ambiguity, thematic
   narrative analysis revealed place and perception are co-produced within
   SES. We argue that place is a biocultural adaptation which grounds
   knowledge and values in spatially-oriented ontologies, and drives
   transformation and resilience in SES. When planning and design
   strategies disrupt place relationships, maladaptation ensues. Our
   conclusions highlight how, to avoid maladaptation, the biocultural role
   of planning in place and SES must be understood. In this way, it may be
   possible to foster place relationships and truly plan for resilience.},
