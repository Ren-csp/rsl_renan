@article{ WOS:001184279300001,
Author = {Chivulescu, Serban and Hapa, Mihai and Pitar, Diana and Lorent, Adrian
   and Marmureanu, Luminita and Leca, Stefan and Radu, Raul and Cazacu,
   Roxana and Dobre, Alexandru Claudiu and Pascu, Ionut Silviu and Marcu,
