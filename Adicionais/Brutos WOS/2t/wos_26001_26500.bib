@article{ WOS:001807756800002,
Author = {Bautista-Cerro Ruiz, Maria Jose},
Title = {RETHINKING THE HUMAN, RECONFIGURING BONDS: ETHICAL AND EPISTEMOLOGICAL
   HORIZONS FOR ENVIRONMENTAL EDUCATION},
Journal = {TEORIA DE LA EDUCACION},
Year = {2026},
Volume = {38},
Number = {2},
Pages = {21-38},
Month = {JUL-DEC},
Abstract = {The current ecological and civilizational crisis calls for a profound
   revision of the ethical and epistemological foundations through which
   humanity has historically related to the environment. This article
   offers a theoretical and critical exploration of the main conceptual
   frameworks that have shaped the modern understanding of human beings and
   their relationship with nature: from classical anthropocentrism, which
   positioned the human (though not all humans) as the measure and end of
   all things, to contemporary approaches that seek to modulate or
   reconfigure that relationship, such as biocentrism, ecocentrism,
   ecofeminism, decolonial thought, and posthumanist perspectives. The
   analysis identifies convergences around a relational and complex
   understanding of life, but also critical tensions, such as the risk that
   posthumanist decentering may dilute moral and political responsibility,
   or that global sustainability discourses may perpetuate anthropocentric
   and technocratic biases. From this standpoint, the paper argues that
   environmental education must integrate the ethical, political, and
   epistemic dimensions of civilizational transformation. It highlights the
   need for an environmental education capable of challenging the
   narratives of domination, separation, and human exceptionalism that have
   underpinned Western thought, while fostering a relational,
   interdependent, and ecosocial understanding of existence. In the context
   of ecosocial collapse and climate emergency, the article advocates for
   repoliticizing environmental education as a space for ethical dialogue,
   ecosocial justice, and collective learning oriented toward rebuilding
   the bond between humanity and nature. Ultimately, it calls for a new
   ecosocial pedagogy that recognizes our ecodependence and assumes the
   shared responsibility of ensuring the sustainability of life on Earth.},
Publisher = {EDICIONES UNIV SALAMANCA},
