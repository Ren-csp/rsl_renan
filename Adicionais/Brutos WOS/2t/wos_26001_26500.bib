@article{ WOS:001736369800001,
Author = {Clayton, Devan A. and Cutrer-Parraga, Elizabeth A. and Caldarella, Paul
   and Richardson, Michael J. and Warren, Jared S.},
Title = {A place to breathe: high school students' perceptions of a school-based
   wellness center},
Journal = {INTERNATIONAL JOURNAL OF ADOLESCENCE AND YOUTH},
Year = {2026},
Volume = {31},
Number = {1},
Month = {DEC 31},
Abstract = {Adolescents face significant academic and emotional stressors,
   underscoring the need for accessible school-based mental health support.
   This qualitative study examined high school students' (N = 17)
   perceptions of a school-based wellness center, including both users and
   non-users. Four focus groups were analyzed using Interpretative
   Phenomenological Analysis to explore experiences, perceived benefits,
   and barriers to use. Students described the center as a calming,
   supportive space that aided emotional regulation, short-term recovery,
   and readiness to return to class. Users emphasized relational
   connection, belonging, and managing stress and anxiety in a safe,
   nonjudgmental environment. Students also viewed the center as fostering
   early help-seeking and reducing mental health stigma. However,
   participants identified barriers such as lingering stigma, discomfort
   speaking with adults, inconsistent teacher pass practices, confusion
   about procedures, and environmental issues like noise and overcrowding.
   Findings highlight the need for clearer protocols, staff training, and
   ongoing communication to ensure equitable access and effective
   implementation.},
