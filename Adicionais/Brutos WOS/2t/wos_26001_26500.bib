@article{ WOS:001806331000001,
Author = {Al Dweik, Samah Mohammed},
Title = {Adoption of indoor environmental quality and energy simulation tools in
   interior design practice: an extended Technology Acceptance Model
   approach},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {JUN 15},
Abstract = {Introduction Indoor Environmental Quality (IEQ) and energy simulation
   tools play a critical role in supporting evidence-based interior design
   and improving building performance. Despite the availability of
   sophisticated simulation technologies, their integration into
   professional interior design practice remains limited, particularly in
   emerging contexts such as Jordan. This study investigates the factors
   influencing the adoption of IEQ and energy simulation tools among
   interior designers using an extended Technology Acceptance Model
   (TAM).Methods A structured questionnaire survey was administered to
   interior designers and interior architects in Jordan. The survey
   incorporated a classification of simulation tools alongside TAM
   constructs, including perceived usefulness, perceived ease of use, and
   behavioral intention, as well as contextual factors such as technical
   capacity, client demand, and regulatory pressure. Data were analyzed
   using Partial Least Squares Structural Equation Modeling (PLS-SEM) to
   examine the relationships between these variables and technology
   adoption.Results The findings reveal a substantial gap between awareness
   and actual use of simulation tools. Daylight simulation tools showed
   higher adoption rates than energy and indoor air quality simulation
   tools. Perceived usefulness emerged as the strongest predictor of
   adoption, while perceived ease of use had a secondary influence.
   Technical capacity and client demand positively affected adoption
   intentions, whereas regulatory pressure exhibited only a limited
   impact.Discussion The results suggest that the adoption of IEQ and
   energy simulation tools in interior design practice is driven primarily
   by practitioners' perceptions of their practical value rather than by
   external regulatory requirements. Enhancing professional training,
   strengthening technical competencies, and increasing client awareness of
   simulation-based design benefits may help bridge the gap between
   awareness and implementation. These findings provide insights for
   educators, professional organizations, and policymakers seeking to
   promote evidence-based and sustainability-oriented interior design
   practices.},
