@article{ WOS:000599654800011,
Author = {Patterson, Diana and Simmonds, Janette G. and Snell, Tristan L.},
Title = {``Savage Beasts,{''} ``Great Companions{''}: The First Dogs to Winter on
   the Antarctic Continent},
Journal = {SOCIETY \& ANIMALS},
