   de Araujo, Geraldino Carneiro},
Title = {WHAT DRIVES ECOTOURISM CONSUMPTION? A QUALITATIVE TPB APPLICATION},
Journal = {CUADERNOS DE TURISMO},
Year = {2025},
Number = {56},
Pages = {39-66},
Month = {JUL-DEC},
Abstract = {Ecotourism demand has increased over the years, but consumer intentions
   are still largely unknown. Based on Theory of Planned Behavior (TPB),
   the objective was to identify tourists' behavioral, normative, control
   and environmental perceptions about ecotourism. Data collection included
   21 interviews, and content analysis was used to study them. The results
   identified as main perception: highlighting the value of keep contact
   with nature, learning about environment and contributing to natural
   resources conservation.},
