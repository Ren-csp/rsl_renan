Title = {READING THE ARCHIVE IN DISCOURSE ANALYSIS: OBSERVATIONS ON BRAZILIAN
   ALIENISM},
Journal = {CADERNOS DE ESTUDOS LINGUISTICOS},
Year = {2022},
Volume = {64},
Abstract = {This article investigates how Brazilian alienism is constituted in close
   relation to theories of race, anti-African memory, and new
   organizational forms of law and urban space in the 19th century.
   Theoretically anchored in the Materialist Discourse Analysis, the text
   aims to give visibility to the historical processes of meaning
   production by assembling an archive that allows listening to the
   discursive conjuncture of 19th century Brazil. This study, therefore,
   allows for a semantic comprehension of social contradictions and meaning
   relations from the construction and reading of an archive that opens
   space for the formulation of a theoretical device distinct from the
   historiographic, placing in the foreground the material functioning of
   language.},
