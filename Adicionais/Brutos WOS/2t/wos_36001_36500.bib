@article{ WOS:001593988600001,
Author = {Yaseen, Muhammad and Saqib, Shahab E. and Zulfiqar, Farhad and Ali,
   Shoukat and Visetnoi, Supawan},
Title = {Farmers' decisions under climate change: A field level empirical
   investigation of climate risk management strategies},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {Climate risk management (CRM) strategies are instrumental in reducing
   climate-induced risks in agriculture. Therefore, this research
   investigates CRM strategies' adoption, intensity, and influencing
   factors among Pakistani farm households employing Double Hurdle
   modeling. Results revealed that farmers extensively adopted crop
   diversification and crop-livestock-integrated farming, followed by
   improved crop varieties and minimum tillage strategies to manage climate
   risks. Moreover, socioeconomic and institutional factors and risk
   perception of heavy rains, floods, and droughts significantly influenced
   the adoption of CRM strategies. The study emphasizes strengthening
   farmers' education, information access, and risk awareness to promote
   CRM adoption and ensure resilient agriculture under climate risks.},
