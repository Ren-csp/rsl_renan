@article{ WOS:000881699000001,
Author = {Moraes, Jeane Do Nascimento and Francisco, Aleff Ferreira and Dill,
   Leandro Moreira and Diniz, Rafaela Souza and De Oliveira, Claudia
   Siqueira and Rodrigues Da Silva, Tainara Maiane and Da Silva Caldeira,
   Cleopatra Alves and Correa, Edailson De Alcantara and Coutinho-Neto,
   Antonio and Zanchi, Fernando Berton and De Mattos Fontes, Marcos Roberto
   and Soares, Andreimar Martins and Calderon, Leonardo De Azevedo},
Title = {New multienzymatic complex formed between human cathepsin D and snake
   venom phospholipase A2},
Journal = {JOURNAL OF VENOMOUS ANIMALS AND TOXINS INCLUDING TROPICAL DISEASES},
Year = {2022},
Volume = {28},
Month = {NOV 4},
Abstract = {Background: Cathepsin D (CatD) is a lysosomal proteolytic enzyme
   expressed in almost all tissues and organs. This protease is a
   multifunctional enzyme responsible for essential biological processes
   such as cell cycle regulation, differentiation, migration, tissue
   remodeling, neuronal growth, ovulation, and apoptosis. The
   overexpression and hypersecretion of CatD have been correlated with
   cancer aggressiveness and tumor progression, stimulating cancer cell
   proliferation, fibroblast growth, and angiogenesis. In addition, some
   studies report its participation in neurodegenerative diseases and
   inflammatory processes. In this regard, the search for new inhibitors
   from natural products could be an alternative against the harmful
   effects of this enzyme.
   Methods: An investigation was carried out to analyze CatD interaction
   with snake venom toxins in an attempt to find inhibitory molecules.
   Interestingly, human CatD shows the ability to bind strongly to snake
   venom phospholipases A(2) (svPLA(2)), forming a stable muti-enzymatic
   complex that maintains the catalytic activity of both CatD and PLA(2).
   In addition, this complex remains active even under exposure to the
   specific inhibitor pepstatin A. Furthermore, the complex formation
   between CatD and svPLA(2) was evidenced by surface plasmon resonance
   (SPR), two-dimensional electrophoresis, enzymatic assays, and extensive
   molecular docking and dynamics techniques.
   Conclusion: The present study suggests the versatility of human CatD and
   svPLA(2), showing that these enzymes can form a fully functional new
   enzymatic complex.},
