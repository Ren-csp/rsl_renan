   Rocha, Elise A.; Fellowes, Mark D. E., Univ Reading, Sch Biol Sci, People \& Wildlife Res Grp, Reading RG6 6AS, Berks, England.},
DOI = {10.1007/s11252-017-0727-5},
ISSN = {1083-8155},
EISSN = {1573-1642},
Keywords = {Aphid; Predation; Mutualism; Parasitoids; Trophic dynamics},
Keywords-Plus = {DENSITY-DEPENDENT MORTALITY; HABITAT FRAGMENTATION; SPECIES RICHNESS;
   TROPHIC CASCADES; COMMUNITY STRUCTURE; URBAN ENVIRONMENTS; PREDATION
   SERVICES; LANDSCAPE DRIVERS; PARASITISM RATES; INTERACTION WEBS},
