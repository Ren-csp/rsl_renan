@article{ WOS:A1985AXL4200014,
Author = {DOUTHWAITE, S and PRINCE, JB and NOLLER, HF},
Title = {EVIDENCE FOR FUNCTIONAL INTERACTION BETWEEN DOMAIN-II AND DOMAIN-V OF
   23S RIBOSOMAL-RNA FROM AN ERYTHROMYCIN-RESISTANT MUTANT},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1985},
Volume = {82},
Number = {24},
Pages = {8330-8334},
Month = {DEC},
Abstract = {A mutation affording low levels of erythromycin resistance has been
   obtained by in vitro hydroxylamine mutagenesis of a cloned ribosomal RNA
   operon from Escherichia coli. The site of the mutational event
   responsible for antibiotic resistance was localized to the gene region
   encoding domain II of 23 S rRNA by replacement of restriction fragments
   in the wild-type plasmid by corresponding fragments from the mutant
   plasmid. DNA sequencing showed that positions 1219-1230 of the 23S rRNA
   gene are  deleted in the mutant. Since all previously characterized rRNA
   mutations conferring resistance to erythromycin show changes exclusively
   in domain V, our present findings provide direct evidence for functional
   interaction between domains II and V of 23S rRNA.},
