@article{ WOS:001737271500001,
Author = {Howell, Helen and Baslington-Davies, Ann and Mills, Daniel S. and Hogue,
   Todd E.},
Title = {Factors influencing the expression of human directed dog aggression. A
   qualitative study of professional opinion},
Journal = {APPLIED ANIMAL BEHAVIOUR SCIENCE},
Year = {2026},
Volume = {300},
Month = {JUL},
Abstract = {The incidence of dog bites to humans is of societal and political
   interest and this has largely been studied using quantitative
   epidemiological methods, whereas the considerable experience and
   opinions of professionals working with dogs has not been captured. This
   study explored factors considered important by professionals in the
   expression of human directed dog aggression relating to the dog, its
   owner and the environment. 187 participants completed an online survey
   consisting of open-ended topic-based questions. Thematic analysis
   identified 18 themes considered important by professionals in respect of
   risk: Dog training methods and purpose, temperament of the dog, where
   the dog came from, socialisation and past experiences, previous history
   of human directed dog aggression, health and medical issues, reactivity
   to the environment, unmet needs, owner's understanding of dog behaviour,
   body language and communication, appropriate dog choice and prior
   experience, aspects of an owners personality and interaction style,
   management of the dog, geographical location and exposure to
   environmental stimuli, available space, social isolation, social
   density, inside or outside living, and predictability, consistency and
   levels of stress in the home. Many of these factors are discussed in,
   and supported by, the scientific literature; however, some areas are
   identified that appear under researched. In particular, the influence of
   an owner's understanding of dog behaviour, the availability of space,
   unmet dog's needs and predictability in the home environment have been
   subject of little published work. By contrast, some factors frequently
   considered in the scientific literature were not widely considered
   important by professionals: the age of a dog, breed, sex and neuter
   status and the age a dog was acquired. Some of these may be proxies for
   more directly relevant risk factors that relate to the individual. This
   study provides important insight to guide further research in an area
   that faces methodological challenges, if we are to develop a more
   comprehensive understanding of dog bite risk with the ultimate goal of
   having more scientifically grounded dog bite prevention strategies.},
