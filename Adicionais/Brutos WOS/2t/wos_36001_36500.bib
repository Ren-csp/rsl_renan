Title = {Synthesis, structure and physical properties of the new layered
   oxyselenides Bi2LnO4Cu2Se2
   (Ln = rare earth)},
Journal = {ROYAL SOCIETY OPEN SCIENCE},
Year = {2020},
Volume = {7},
Number = {10},
Month = {OCT 28},
Abstract = {We have synthesized a new series of layered oxyselenides
   Bi(2)LnO(4)Cu(2)Se(2) (Ln=Nd, Sm, Eu, Dy, Er, Yb). Their crystal
   structures and physical properties were studied through X-ray
   diffraction, electric transport measurements, bulk magnetization and
   first-principle calculation. All these compounds have a tetragonal
   structure with space group I4/mmm. They exhibit hole-type metallic
   behaviours which is also verified by the DFT calculation. The new
   Bi(2)LnO(4)-type block in these compounds may give people some
   enlightenment in synthesizing new iron-based superconductors or other
   layered compounds.},
