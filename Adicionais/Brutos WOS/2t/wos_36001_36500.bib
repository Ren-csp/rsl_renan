@article{ WOS:001760985800001,
Author = {York, Natalie D. L. and Naimado, William and Enns, Charis and Bersaglio,
   Brock and Kaunga, Mali Ole and Larpei, Joseph and Mukiri, Victorlyn and
   Oreheya, Judy and Silole, Vivian and Oldekop, Johan A.},
Title = {Biocultural conservation as an alternative pathway for conservation: A
   case study of the Inclusive Conservation Initiative in northern Kenya},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2353-2367},
Month = {JUL},
Abstract = {The Global Biodiversity Framework (GBF) aims to conserve 30\% of the
   planet by 2030, yet mounting evidence indicates that current methods for
   preventing biodiversity loss are insufficient and often intensify unjust
   conditions for Indigenous Peoples and local communities. Alternative
   models have been proposed to deal with this crisis, including strict,
   community, neoliberal and convivial conservation. Biocultural
   conservation is now re-emerging as a potential pathway to achieve the
   GBF target. Yet there is limited understanding of whether biocultural
   approaches are actually transforming how conservation is done in
   practice. We address this question using a case study of the Inclusive
   Conservation Initiative (ICI) in northern Kenya. Drawing on qualitative
   data collected over 3 months in 2024, including 26 interviews and
   participatory observation, this paper explores if and how biocultural
   conservation moves beyond mainstream conservation models. We argue that
   biocultural conservation offers an alternative model for conservation
   which moves beyond mainstream conservation models in northern Kenya in
   three key ways. Firstly, it recognises communities' biocultural
   practices as the basis for conservation. Secondly, it adopts a
   more-than-human rights approach, and thirdly, it speaks to pastoralist
   communities' diverse ways of knowing and relating to nature. Our
   findings demonstrate that biocultural conservation subverts the goals of
   mainstream conservation to protect nature from people by approaching
   conservation as a way to protect people's relationships with nature. It
   moves beyond mainstream approaches by amplifying communities' own
   biocultural practices, rights and ways of knowing and relating to
   nature. On this basis, we argue that biocultural conservation provides a
   distinct alternative pathway which can support communities to do
   conservation that aligns with their own worldviews, values and goals.
   Policy implications. Our analysis reveals that biocultural conservation
   provides a unique pathway for conservation which can better support
   rights to autonomy and decision-making for communities. While our
   research is centred on northern Kenya, the findings have broader
   relevance for advancing alternative imaginaries for conservation and
   ensuring that conservation supports people and nature to adapt and
   thrive in a changing world.Read the free for this article on the Journal
   blog.},
