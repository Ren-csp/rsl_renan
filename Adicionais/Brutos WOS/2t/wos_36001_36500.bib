Author = {Bonelli, Domenico and Mendicino, Federica and Carlomagno, Francesco and
   Luzzi, Giuseppe and Siclari, Antonino and Fumo, Federica and Di Biase,
   Erica and Mistri, Michele and Munari, Cristina and Pezzi, Marco and
