@article{ WOS:000685955100001,
Author = {Fairbairn, Catharine E. and Creswell, Kasey G. and Hales, Andrew H. and
   Williams, Kipling D. and Wilkins, Kaleigh V.},
Title = {Mixing Misery and Gin: The Effect of Alcohol Administration on Ostracism
   Response},
