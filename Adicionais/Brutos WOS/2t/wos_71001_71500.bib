@article{ WOS:001594346700015,
Author = {Cropp, Carola and Westermann, Stefan and Aguilar-Raab, Corina and
   Toepfer, Nils F. and Winter, Friederike and Henkel, Miriam and
   Zimmermann, Johannes},
Title = {Interpersonal Dynamics},
