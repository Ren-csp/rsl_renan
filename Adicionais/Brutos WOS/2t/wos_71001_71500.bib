@article{ WOS:001649332400001,
Author = {Albanna, Basma and Hesch, Gunnar and Naeher, Dominik and Otto, Daniel
   and Jain, Meha and Mehedy Hassan, Mohammad and Vollmer, Sebastian and
   Ewell, Hanna and Nawrotzki, Raphael},
Title = {Assessing the adoption and outcomes of early-sown wheat varieties in
   Northwest India},
Journal = {INTERNATIONAL JOURNAL OF AGRICULTURAL SUSTAINABILITY},
Year = {2026},
Volume = {24},
Number = {1},
Month = {DEC 31},
Abstract = {This study explores the adoption and outcomes of early-sown wheat (ESW)
   varieties in India's northwestern plains, utilizing survey data from
   1,206 wheat-farming households in Punjab and Haryana. Building on the
   data-powered positive deviance approach, we identified early adopters of
   ESW varieties as positive deviants. The empirical analysis focused on
   uncovering their attributes, perceptions, practices, and challenges in
   switching from traditional cultivation to ESW. Logistic regression
   identified factors associated with ESW adoption, while propensity score
   matching and Heckman two-stage estimation compared yields attained
   during the early sowing window. The findings indicate that two of the
   three evaluated ESW varieties significantly outperform traditional
   varieties in yield. Information constraints were a key barrier to
   adoption. Moreover, factors including education, prior experience with
   similar varieties, familiarity with zero-tillage, risk aversion, and
   early rice harvesting correlated with higher adoption rates. Among
   adopters, seed and information sources, sowing time, and irrigation
   methods were linked to higher yields. Overall, bridging knowledge gaps
   via targeted information campaigns, support services, and the promotion
   of zero-tillage technologies are crucial for fostering widespread
   adoption of ESW varieties. Implementing these policy recommendations may
   strengthen agricultural resilience and enhance food security in India
   amid climate challenges.},
