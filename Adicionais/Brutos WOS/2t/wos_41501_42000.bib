   Streeter, Richard and Peeples, Matthew A. and McGovern, Thomas H. and
   Hegmon, Michelle and Arneborg, Jette and Kintigh, Keith W. and
   Brewington, Seth and Spielmann, Katherine A. and Simpson, Ian A. and
   Strawhacker, Colleen and Comeau, Laura E. L. and Torvinen, Andrea and
   Madsen, Christian K. and Hambrecht, George and Smiarowski, Konrad},
Title = {Climate challenges, vulnerabilities, and food security},
