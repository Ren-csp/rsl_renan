   AMERICA},
Year = {2016},
Volume = {113},
Number = {2},
Pages = {298-303},
Month = {JAN 12},
Abstract = {This paper identifies rare climate challenges in the long-term history
   of seven areas, three in the subpolar North Atlantic Islands and four in
   the arid-to-semiarid deserts of the US Southwest. For each case, the
   vulnerability to food shortage before the climate challenge is
   quantified based on eight variables encompassing both environmental and
   social domains. These data are used to evaluate the relationship between
   the ``weight{''} of vulnerability before a climate challenge and the
   nature of social change and food security following a challenge. The
   outcome of this work is directly applicable to debates about disaster
   management policy.},
