@article{ WOS:A1995QB23800015,
Author = {CAPORALE, LH},
Title = {CHEMICAL ECOLOGY - A VIEW FROM THE PHARMACEUTICAL-INDUSTRY},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
