@article{ WOS:000348736300004,
Author = {Severtson, Dolores J.},
Title = {Testing Map Features Designed to Convey the Uncertainty of Cancer Risk:
   Insights Gained From Assessing Judgments of Information Adequacy and
   Communication Goals},
Journal = {SCIENCE COMMUNICATION},
Year = {2015},
Volume = {37},
Number = {1, SI},
Pages = {59-88},
Month = {FEB},
Abstract = {Barriers to communicating the uncertainty of environmental health risks
   include preferences for certain information and low numeracy. Map
   features designed to communicate the magnitude and uncertainty of
   estimated cancer risk from air pollution were tested among 826
   participants to assess how map features influenced judgments of adequacy
   and the intended communication goals. An uncertain versus certain visual
   feature was judged as less adequate but met both communication goals and
   addressed numeracy barriers. Expressing relative risk using words
   communicated uncertainty and addressed numeracy barriers but was judged
   as highly inadequate. Risk communication and visual cognition concepts
   were applied to explain findings.},
