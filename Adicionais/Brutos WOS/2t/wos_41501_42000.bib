@article{ WOS:001555416300001,
Author = {Zhuang, Liyuan and Long, Jinqiao and Kamete, Amin Y. and Wang, Ya Ping},
Title = {Neighborhood attachment in Chinese cities: a case study of Chengdu},
Journal = {URBAN GEOGRAPHY},
Year = {2026},
Volume = {47},
Number = {6},
Pages = {1442-1469},
Month = {JUL 3},
Abstract = {Research on neighborhood attachment in China has mainly focused on
   coastal megacities, leaving inland cities relatively underexplored. This
   study fills the gap by examining how emotional and functional
   attachments develop across five neighborhood types in Chengdu, including
   two work-unit compounds, a resettlement neighborhood, and both old and
   new commercial estates. Analysis of semi-structured interviews and field
   observations reveals three patterns. First, emotional attachment is
   strongest in long-standing work-unit and resettlement neighborhoods, but
   it also emerges in new commercial estates where child-centered events
   and property management activities stimulate social interaction. In some
   cases, such as the resettlement neighborhood, these emotional bonds also
   motivate residents to invest in neighborhood improvement
   ({''}emotional-to-functional{''} pathway). Second, functional attachment
   develops from a well-maintained environment, adequate facilities and
   accessible services; it is strongest in commercial and resettlement
   neighborhoods and often transitions into emotional bonds
   ({''}functional-to-emotional{''} pathway). However, physical quality
   alone cannot guarantee belonging, as seen in older commercial estates
   with weak interaction. Third, governance matters; market-driven
   management and resident autonomy enhance attachment, whereas excessive
   dependence on state provision lets it fade as facilities deteriorate.
   The study recommends combining physical upgrades with programmed social
   interaction and longer tenures to strengthen neighborhood attachment in
   China's rapidly transforming cities.},
