@article{ WOS:001223296000003,
Author = {Unal, Mehmet},
Title = {Liquid Friendship in Brian Lobel's Purge},
Journal = {LITERA-JOURNAL OF LANGUAGE LITERATURE AND CULTURE STUDIES},
Year = {2023},
Volume = {33},
Number = {2},
Pages = {395-416},
Abstract = {The advent of technological advancements in contemporary society has had
   a profound communication to transportation and changing not only the
   media people utilize in their everyday lives but also their traditions,
   values, and relationships. Thus, these changes have sparked debate
   regarding the overall positive or negative implications of these
   developments as the dynamic nature of all kinds of human relationships
   in modern times varying from everyday relationships of friendships,
   partnerships and sexual encounters to kinship and family has
   increasingly begun to be characterized by transience, fragility,
   ambivalence and rapid change. These characteristics are attributed to
   the impact of modern technological advancements, namely the
   proliferation of social media applications. The purpose of this study is
   to examine how social media applications shape relationships today with
   a specific focus on Brian Brian Lobel's Purge (2011) is a play about
   making the decision to end or maintain friendship through social media
   applications, it provides us with pertinent examples for scrutinizing
   the themes of transience, fragility, vulnerability and ambivalence that
   have become the hallmarks of the modern relationships in the age of
   liquid modernity.},
Publisher = {ISTANBUL UNIV, FAC LETTERS},
Address = {ISTANBUL UNIV EDEBIYAT FAK BATI DILLERI EDEBIYATLARI BOLMU ORDU CAD NO
   6, ISTANBUL, 34134, Turkiye},
Type = {Article},
Language = {English},
Affiliation = {Ünal, M (Corresponding Author), Ataturk Univ, Sch Foreign Languages, Dept English Translat \& Interpretat, Erzurum, Turkiye.
   Unal, Mehmet, Ataturk Univ, Sch Foreign Languages, Dept English Translat \& Interpretat, Erzurum, Turkiye.},
DOI = {10.26650/LITERA2023-1292864},
ISSN = {1304-0057},
EISSN = {2602-2117},
Keywords = {Social Media; Brian Lobel; Liquid Modernity; Zygmunt Bauman; Media
