@article{ WOS:000819400000003,
Author = {Wang, Ruoyu and Feng, Zhiqiang and Pearce, Jamie},
Title = {Neighbourhood greenspace quantity, quality and socioeconomic
   inequalities in mental health},
Journal = {CITIES},
Year = {2022},
Volume = {129},
Month = {OCT},
Abstract = {There is tentative evidence suggesting that socioeconomically
   disadvantaged groups may benefit more from access to neighbourhood
   greenspace and therefore could be a lever for narrowing socioeconomic
   inequalities ('equigenesis') in mental health, although studies are
   equivocal. One potential explanation for this inconsistency is
   differences in study designs, particularly how greenspace is measured.
   Most previous studies are from high income countries, and there has been
   no investigations into equigenic environments in China. Using survey
   data collected from 26 neighbourhoods in Guangzhou, China, this study
   examines whether local greenspaces may narrow socioeconomic inequalities
   in health (i.e. equigenesis) in the Chinese context. The study is the
   first to explore the contribution of greenspace in reducing
   socioeconomic inequalities in mental health in the Chinese context. It
   uses Normalized Difference Vegetation Index (NDVI), Street View
   Greenness (SVG) and self-reported neighbourhood greenness quality as
   estimates of residential greenness exposure Results show that
   SVG-quantity, SVG-quality and self-reported greenspace quality narrow
   the neighbourhood socioeconomic inequalities in mental health. Our
   findings demonstrate the importance of improving equity in local green
   infrastructure for promoting health equity through urban planning and
   design, including improving access to green spaces, and providing more
   street trees in socioeconomically disadvantaged neighbourhoods.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Wang, RY (Corresponding Author), Univ Edinburgh, Inst Geog, Sch Geosci, Edinburgh, Scotland.
   Wang, Ruoyu; Feng, Zhiqiang, Univ Edinburgh, Inst Geog, Sch Geosci, Edinburgh, Scotland.
