@article{ WOS:000508186400214,
Author = {Tempesta, Tiziano and Vecchiato, Daniel and Nassivera, Federico and
   Bugatti, Maria and Torquati, Biancamaria},
Title = {Consumers Demand for Social Farming Products: An Analysis with Discrete
   Choice Experiments},
Journal = {SUSTAINABILITY},
Year = {2019},
Volume = {11},
Number = {23},
Month = {DEC},
Abstract = {This paper analyses the demand for social farming (SF) products. In
   particular, we investigate the preferences of consumers who buy their
   products from large retailers, rather than from solidarity purchasing
   groups or other niche markets using a sample of 225 consumers. In this
   regard, a discrete choice experiment (DCE) was carried out to estimate
   the willingness to pay (WTP) a premium price for the purchase of a
   common product (i.e., eggs) from farms that employ disabled people. The
   attributes considered in our DCE design are the employment of disabled
   people and two additional attributes which may have ethical implications
   for the choices. The results indicate that consumers are interested in
   buying SF products, with about 74\% of the sample willing to buy the
   eggs produced by social farms and the average WTP being equal to
   (sic)1.36 for a pack of six eggs. Moreover, the average WTP for the use
   of labour of disabled people attribute amounted to (sic)0.69 for a pack
   of six eggs.},
