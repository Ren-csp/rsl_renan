@article{ WOS:001163728200010,
Author = {Abrantes Farias, Mayrhon Jose and Barcelos, Marciel and Del Rio Martins,
   Rodrigo Lema},
Title = {Family and school daily life from the perspective of children},
Journal = {LINHAS CRITICAS},
Year = {2023},
Volume = {29},
Month = {JAN-DEC},
Abstract = {This research comprises the meanings attributed by 34 children from a
   school in Brasilia to their family and school routine, with
   theoretical-methodological contributions from the Sociology of Everyday
   Life, Sociology of Childhood and Everyday Life Studies. From participant
   observation, drawings and children's spoken narratives, the following
   categories were produced and analyzed: family daily life, school daily
   life and intersection between family and school daily life. The results
   indicate that children's interpretations are conceived inside and
   outside school and transit between the real and the imaginary world,
   revealing affections, tensions and idiosyncrasies about their daily
   routines.},
