ISSN = {1364-0321},
EISSN = {1879-0690},
Keywords = {Off grid living; Energy transition pathways; Distributed energy
   technologies; Energy behavior and decision-making; Consumer-to-prosumer
   transition; Household-grid co-evolution; Grid-customer interaction;
   Prosumer-driven energy systems; Residential energy transition},
