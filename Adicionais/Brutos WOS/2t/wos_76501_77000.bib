@article{ WOS:000380421000005,
Author = {Meleisea, Malama and Schoeffel, Penelope},
Title = {THE WORK OF THE DEAD IN SAMOA: RANK, STATUS AND PROPERTY},
Journal = {JOURNAL OF THE POLYNESIAN SOCIETY},
Year = {2016},
Volume = {125},
Number = {2},
Pages = {149-170},
Month = {JUN},
Note = {Meeting of the Association-for-Social-Anthropology-in-Oceania (ASAO),
   San Diego, CA, FEB 10-13, 2016},
Organization = {Assoc Social Anthropol Oceania},
Abstract = {In Samoa the selection of burial sites and the type of monuments chosen
   to mark them not only signify affection and memorialisation, but also
   make visible statements about traditional rank, and nowadays about
   family status and claims to property. We examine what is known about
   burial practices and locations in pre-colonial Samoa and trace the
   changes that have occurred as a result of 19th-century power struggles,
   political change, colonial influences and regulations, and new
   settlement patterns and house-building practices.},
