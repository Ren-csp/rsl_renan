@article{ WOS:001619207600001,
Author = {Tucker, Richard and Andrews, Fiona and Giles, David Boarder and
   Vecchiet, Ben and Moslehian, Anahita Sal},
Title = {A place to call home: design characteristics for transitional housing
   supporting pathways out of homelessness in Australia},
Journal = {JOURNAL OF HOUSING AND THE BUILT ENVIRONMENT},
Year = {2026},
Volume = {41},
Number = {2},
Pages = {807-839},
Month = {JUN},
Abstract = {The built environment is a key component in transitional housing (TH)
   programs, serving as a supportive context that facilitates service
   delivery and program goals. However, limited research exists on how the
   socio-spatial design of dwelling impacts residents' transitions to
   permanent housing. This study therefore addresses the question: What
   design characteristics of transitional housing can facilitate a
   transition from homelessness? To answer this, we first conducted a
   systematic literature review examining building design factors within
   Crisis Accommodation, Transitional Housing, and Permanent Supportive
   Housing programs. From this review, we identified 32 dwelling design
   characteristics that influence resident outcomes based on Ontological
   Security, CHIME, and Trauma-Informed Care frameworks. We then conducted
   an ethnographically informed case study, focussing on the lived
   experiences of men in an innovative TH model in Australia, to evaluate
   how these 32 characteristics meet resident needs and align with
   wrap-around service aims. This analysis identified 18 key dwelling and
   service design factors that support residents' transition processes.
   These factors were then synthesised into a supportive design framework
   with 65 specific design strategies that promote a sense of home. The
   findings highlight that understanding the value of design in
   transitional housing requires examining its role within the layered,
   forgiving social contexts that intersect with the day-to-day operations
   of TH programs.},
Publisher = {SPRINGER},
Address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
