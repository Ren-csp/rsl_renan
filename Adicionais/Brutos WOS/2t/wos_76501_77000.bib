@article{ WOS:000564711200001,
Author = {Mondino, Elena and Scolobig, Anna and Borga, Marco and Di Baldassarre,
   Giuliano},
Title = {The Role of Experience and Different Sources of Knowledge in Shaping
   Flood Risk Awareness},
Journal = {WATER},
Year = {2020},
Volume = {12},
Number = {8},
Month = {AUG},
Abstract = {Understanding what makes people vulnerable to flooding is key in
   informing the risk management process. Non-structural measures, such as
   risk communication, can reduce vulnerability by improving flood risk
   awareness, but they require a deep understanding of which factors
   influence risk awareness, and how. We analysed and untangled the role of
   experience with, and knowledge of, floods by conducting a survey in a
   municipality in North-eastern Italy that was hit by a flash flood in
   2018. The results show that previous experience with floods influences
   risk awareness not only directly, but also indirectly through the
   knowledge that was gained from that experience. In addition, specific
   (as opposed to generic) definitions of experience have been found to be
   better suited for exploring their effects on risk awareness. Based on
   the literature and on our results, we propose an experience-knowledge
   typology to help unravel the complex role that these two variables play
   in shaping flood risk awareness.},
