@article{ WOS:000383291700066,
Author = {Sahraoui, Yohan and Clauzel, Celine and Foltete, Jean-Christophe},
Title = {Spatial modelling of landscape aesthetic potential in urban-rural
   fringes},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2016},
Volume = {181},
Pages = {623-636},
Month = {OCT 1},
Abstract = {The aesthetic potential of landscape has to be modelled to provide tools
   for land-use planning. This involves identifying landscape attributes
   and revealing individuals' landscape preferences. Landscape aesthetic
   judgments of individuals (n = 1420) were studied by means of a
   photo-based survey. A set of landscape visibility metrics was created to
   measure landscape composition and configuration in each photograph using
   spatial data. These metrics were used as explanatory variables in
   multiple linear regressions to explain aesthetic judgments. We
   demonstrate that landscape aesthetic judgments may be synthesized in
   three consensus groups. The statistical results obtained show that
   landscape visibility metrics have good explanatory power. Ultimately, we
   propose a spatial modelling of landscape aesthetic potential based on
   these results combined with systematic computation of visibility
   metrics. (C) 2016 Elsevier Ltd. All rights reserved.},
