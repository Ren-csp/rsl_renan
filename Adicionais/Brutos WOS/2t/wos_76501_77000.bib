@article{ WOS:001513437100001,
Author = {Bonfante, Gleiton Matheus},
Title = {THE VERBETIZATION OF AFFECTS IN SPINOZA'S ETHICS},
Journal = {CADERNOS DE ESTUDOS LINGUISTICOS},
Year = {2025},
Volume = {67},
Abstract = {This article invests in the production of knowledge about Spinoza's
   Ethics from the perspective of lexicography. By considering Spinoza's
   glossarial productions, we discuss the enunciative act of the
   philosopher who produces a sociopolitical diagnosis (FOUCAULT, 2023) of
   his time. The role of the systematic verbetization of the affections in
   his work in the production of this diagnosis is investigated. The
   paper's most vibrant argument is that the discursive diagnosis of the
   world, typical of philosophical discourse, can be produced by the act of
   verbetization. In conclusion, we contend the definition as a political
   act in language.},
