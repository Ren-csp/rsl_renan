@article{ WOS:001768368700001,
Author = {Goto, Erica Akemi and Domingue, Simone and Kalafatis, Scott and
   Wong-Parodi, Gabrielle and Basaraba, Alexander B. and Lemos, Maria
   Carmen},
Title = {What leads to equitable adaptation intentions in city practitioners?},
Journal = {CLIMATE RISK MANAGEMENT},
Year = {2026},
Volume = {52},
Month = {JUN},
Abstract = {Climate extremes impact urban communities worldwide, and due to climate
   change, these impacts are likely to worsen. Climate adaptive behaviors
   are essential to reduce harm, and understanding the motivational factors
   driving these behaviors is crucial. Despite increasing awareness of the
   disproportionate and inequitable impacts of these events on underserved
   communities, previous research on adaptation behavior has primarily
   focused on the household level, with less attention given to other
   decision-makers, such as city-level practitioners, who can influence
   household adaptive capacity. This is especially true for research
   examining the relationship between motivational factors and equitable
   adaptation. A necessary step in exploring this relationship is
   understanding city practitioners' equitable adaptation intentions. In
   this article, we propose a conceptual framework-the Equitable Adaptation
   Model (EAM)-to explore the relationship between motivational factors and
   equitable adaptation intentions. Additionally, we investigate whether
   discussions of social vulnerability with and among city practitioners
   increase their intentions to undertake equitable adaptation actions. We
   employed a mixed-methods approach using data from 46 cities that
   participated in an engaged research project in the US Gulf Coast from
   2019 to 2021. We found a positive association between equitable
   adaptation intentions and perceived risk, as well as between perceived
   risk and perceived risk experience and adaptation resources. Further, we
   found that introducing social vulnerability content during engagement
   increases city practitioners' intentions to undertake equitable
   adaptation actions. This study adds to the existing literature by using
   an equity-centered adaptation approach and illustrates that engagement
   supporting equitable adaptation can increase equitable adaptation
   intentions among city practitioners.},
