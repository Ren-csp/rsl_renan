@article{ WOS:001534906600001,
Author = {Sudila Zilinska, Miroslava and Urban, Kamila},
Title = {From perceived proximity of climate change to well-being: how climate
   threat appraisal and emotions interrelate in a Slovak representative
   Sample},
Journal = {ENVIRONMENTAL SOCIOLOGY},
Year = {2026},
Volume = {12},
Number = {3},
Pages = {684-698},
Month = {JUL 3},
Abstract = {Climate change is becoming an increasingly important stressor, not only
   through its direct impacts, but also as an anticipated threat. This
   study aimed to examine the associations between perceived proximity of
   climate change and well-being and a possible mediating role of threat
   appraisal and climate distressing emotions in this relationship. Using
   data from an online survey of a representative sample of Slovak adults
   (N = 1000), structural equation modeling with maximum likelihood (ML)
   estimation was applied to examine these relationships. Results showed
   that perceived proximity of climate change was associated with lower
   well-being only when mediated by increased threat appraisal and climate
   distressing emotions of worry, anxiety, and grief. Perceived proximity
   explained 30\% of the variance in threat appraisal, which in turn
   affected well-being indirectly through climate distressing emotions.
   These findings highlight the importance of considering how perceived
   proximity, threat appraisal, and acute emotional responses to climate
   change are associated with overall well-being. However, given the
   cross-sectional and correlational nature of the data, the directionality
   of these associations should be interpreted with caution. Nevertheless,
   the results underscore the importance of addressing emotional
   experiences in public climate discourse and integrating them into
   related strategies and interventions.},
