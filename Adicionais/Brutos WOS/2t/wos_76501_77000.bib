@article{ WOS:001562974600001,
Author = {Baffour-Ata, Frank and Mensah, Sylvia Cecilia and Kuutiero, Roland
   Pupielu and Okoto, Ivy Nkansah and Boateng, Queenstar Pokuaa and
   Boateng, Isaac Kwadwo and Adane, Papa Boateng and Asare, Emerald Kwabena
   and Zotoo, Precious Midodzi and Appiabea, Hannah and Botchway, Caleb and
   Forson, Peter Kwasi},
Title = {Socioeconomic determinants of drought adaptation strategies in the
   Sekyere Afram Plains District, Ghana},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {This study examines the socioeconomic factors influencing drought
   adaptation strategies in the Sekyere Afram Plains District, Ghana. The
   study employed standardized anomaly calculations for climate data trend
   analysis, descriptive statistics for household survey data, and a
   multinomial logistic regression to identify the socioeconomic factors
   influencing the adoption of drought adaptation practices. Qualitative
   data were analyzed thematically. The analysis of climatic data from 1993
   to 2023 reveals erratic rainfall patterns and a significant increase in
   temperature, contributing to drought conditions. Most respondents
   reported that drought adversely affects their livelihoods, income, and
   agricultural yields. In response, they prioritized adaptation practices
   such as rainwater harvesting, water conservation, and soil conservation,
   while adaptive water allocation policies were least favored. The study
   highlights that socioeconomic factors have a significant influence on
   the adoption of these strategies. Gender negatively impacts water and
   soil conservation practices but positively affects livelihood
   diversification. Age negatively influences the adoption of various
   drought adaptation practices. In contrast, larger household sizes
   positively affect relocation, livelihood diversification, ecosystem
   restoration, and climatesmart agriculture practices but negatively
   impact early drought warning adoption. Policy implications include the
   need for targeted awareness and training programs, gender-sensitive
   policies, support for larger households, promotion of adaptive water
   allocation policies, and the enhancement of climate-smart agriculture
   initiatives. Addressing these factors can enhance the district's
   resilience to drought and ensure sustainable livelihoods.},
