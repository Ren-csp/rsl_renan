@article{ WOS:000365771700009,
Author = {Head, Lesley and Larson, Brendon M. H. and Hobbs, Richard and Atchison,
   Jennifer and Gill, Nick and Kull, Christian and Rangan, Haripriya},
Title = {Living with Invasive Plants in the Anthropocene: The Importance of
   Understanding Practice and Experience},
Journal = {CONSERVATION \& SOCIETY},
