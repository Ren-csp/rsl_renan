@article{ WOS:000216455500001,
Author = {Shrestha, Biswas and Omran, Ahmed and Rong, Pengfei and Wang, Wei},
Title = {Successfully treated unusual case of primary adrenal and spinal
   tuberculosis with three years follow up},
Journal = {PAN AFRICAN MEDICAL JOURNAL},
Year = {2014},
Volume = {17},
Month = {FEB 13},
Abstract = {The global increase in incidence of Tuberculosis (TB) is returning to be
   a major health issue grabbing a universal concern. Although
   extrapulmonary tuberculosis (EPTB) has a broad spectrum of clinical
   manifestations, primary involvement of the adrenal glands along with
