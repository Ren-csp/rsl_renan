@article{ WOS:001244399200016,
Author = {Wende, Tim and Gueresir, Erdem and Wach, Johannes and Vychopen, Martin
   and Hoffmann, Anastasia and Prasse, Gordian and Wilhelmy, Florian and
   Kasper, Johannes},
Title = {Radiomic white matter parameters of functional integrity of the
   corticospinal tract in high-grade glioma},
Journal = {SCIENTIFIC REPORTS},
Year = {2024},
Volume = {14},
Number = {1},
Month = {JUN 5},
Abstract = {Tractography has become a widely available tool for the planning of
   neurosurgical operations as well as for neuroscientific research. The
   absence of patient interaction makes it easily applicable. However, it
   leaves uncertainty about the functional relevance of the identified
   bundles. We retrospectively analyzed the correlation of white matter
   markers with their clinical function in 24 right-handed patients who
   underwent first surgery for high-grade glioma. Morphological affection
   of the corticospinal tract (CST) and grade of paresis were assessed
   before surgery. Tractography was performed manually with MRTrix3 and
   automatically with TractSeg. Median and mean fractional anisotropy (FA)
   from manual tractography showed a significant correlation with CST
   affection (p = 0.008) and paresis (p = 0.015, p = 0.026). CST affection
   correlated further most with energy, and surface-volume ratio (p =
   0.014) from radiomic analysis. Paresis correlated most with maximum 2D
   column diameter (p = 0.005), minor axis length (p = 0.006), and kurtosis
   (p = 0.008) from radiomic analysis. Streamline count yielded no
   significant correlations. In conclusion, mean or median FA can be used
   for the assessment of CST integrity in high-grade glioma. Also, several
   radiomic parameters are suited to describe tract integrity and may be
   used to quantitatively analyze white matter in the future.},
