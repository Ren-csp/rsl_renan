@article{ WOS:000621087000008,
Author = {Hawkins, Misty A. W. and Colaizzi, Janna M. and Cole, Ashley B. and
   Keirns, Natalie G. and Smith, Caitlin E. and Stout, Madison and Chaney,
   John and Sawhney, Manisha and Gahn, David},
Title = {Pilot Trial of Acceptance-Based Behavioral Weight Loss and
   Neurocognition Among American Indians},
Journal = {BEHAVIOR THERAPY},
Year = {2021},
Volume = {52},
Number = {2, SI},
Pages = {350-364},
Month = {MAR},
Abstract = {Acceptance-based behavioral therapies (ABTs) for obesity may be superior
   to standard behavioral therapies but have not been adequately tested
   with American Indians (Als). Neurocognitive function is also unexamined
   in relation to behavioral weight loss among Als despite findings that
   neurocognition predicts outcomes in general samples, may help explain
   some of the benefits of ABTs, and may be relevant to marginalized
   groups. The primary objective of this pilot was to examine the
   feasibility/acceptability of ABT in an Al sample. Exploratory analyses
   examined the relationship between neurocognition and weight loss.
   Forty-eight AI adults with overweight/obesity (ages 43.3 +/- 10.3 years,
   85\% female; baseline body mass index = 36.8 +/- 4.4 kg/m(2)) enrolled
   in a 6-month open ABT weight loss trial. Feasibility indices, induding
   screening/enrollment, session attendance, retention rates for
   posttreatment assessments, and program acceptability were examined.
   Percent weight loss (\%WL) was assessed as well as fluid and crystalized
   neurocognition (National Institutes of Health Toolbox Cognition Battery
   {[}NIHTB-CB]). We enrolled 79\% of the eligible sample and retained 75\%
   (N = 36) at posttreatment assessments. Program completers lost an
   average of 5.2 +/- 4.9\% of initial body weight (d(z) = 1.14), whereas
   intent-to-treat analyses show a mean loss of 4.1 +/- 4.7\%. Participants
   reported high satisfaction, effectiveness, and cultural appropriateness.
   Exploratory analyses of neurocognitive domains suggested that
   crystalized cognition was higher among completers, and higher baseline
   cognitive flexibility predicted greater \%WI. (beta = .34, p = .05). ABT
   resulted in clinically significant weight loss in an Al sample. A
   controlled trial of ABT in a larger, more diverse sample is warranted to
   determine whether (a) the findings are robust, generalizable, and/or
   superior to other treatments and (b) neurocognitive factors moderate
   outcomes.},
