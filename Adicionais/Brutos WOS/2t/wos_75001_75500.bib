@article{ WOS:A1983QR24000002,
Author = {FURMAN, W and BIERMAN, KL},
Title = {DEVELOPMENTAL-CHANGES IN YOUNG CHILDRENS CONCEPTIONS OF FRIENDSHIP},
Journal = {CHILD DEVELOPMENT},
Year = {1983},
Volume = {54},
Number = {3},
Pages = {549-556},
Abstract = {The development of friendship conceptions from 4-7 yr of age were
   examined. Subjects were administered an open-ended interview, a picture
   recognition task and a forced-choice rating task in which they
   identified the most important characteristics of friendship. Common
   activities, affection, support and propinquity were all salient aspects
   of most children''s conceptions. Friendship expectations concerning
   affection and support increased in frequency with age, while references
   to physical characteristics decreased. Parallel findings were found on
   the 3 measures, although the results were not as strong on the
   open-ended interview. Evidently, children first learn the overt
   characteristics of the occupants of the role of friend, but as they grow
   older they place increasing emphasis on affectively based
   characteristics.},
