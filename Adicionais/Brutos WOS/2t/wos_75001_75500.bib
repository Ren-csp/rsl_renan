@article{ WOS:000502264500015,
Author = {Nisbeth, Catharina Simone and Kidmose, Jacob and Weckstrom, Kaarina and
   Reitzel, Kasper and Odgaard, Bent Vad and Bennike, Ole and Thorling,
   Laerke and McGowan, Suzanne and Schomacker, Anders and Kristensen, David
   Lajer Juul and Jessen, Soren},
Title = {Dissolved Inorganic Geogenic Phosphorus Load to a Groundwater-Fed Lake:
   Implications of Terrestrial Phosphorus Cycling by Groundwater},
Journal = {WATER},
Year = {2019},
Volume = {11},
Number = {11},
Month = {NOV},
Abstract = {The general perception has long been that lake eutrophication is driven
   by anthropogenic sources of phosphorus (P) and that P is immobile in the
   subsurface and in aquifers. Combined investigation of the current water
   and P budgets of a 70 ha lake (Norreso, Fyn, Denmark) in a clayey
   till-dominated landscape and of the lake's Holocene trophic history
   demonstrates a potential significance of geogenic (natural)
   groundwater-borne P. Nor reso receives water from nine streams, a
   groundwater-fed spring located on a small island, and precipitation. The
   lake loses water by evaporation and via a single outlet. Monthly
   measurements of stream, spring, and outlet discharge, and of tracers in
   the form of temperature, delta O-18 and delta H-2 of water, and water
   chemistry were conducted. The tracers indicated that the lake receives
   groundwater from an underlying regional confined glaciofluvial sand
   aquifer via the spring and one of the streams. In addition, the lake
   receives a direct groundwater input (estimated as the water balance
   residual) via the lake bed, as supported by the artesian conditions of
   underlying strata observed in piezometers installed along the lake shore
   and in wells tapping the regional confined aquifer. The groundwater in
   the regional confined aquifer was anoxic, ferrous, and contained 4-5 mu
   mol/L dissolved inorganic orthophosphate (DIP). Altogether, the data
   indicated that groundwater contributes from 64\% of the water-borne
   external DIP loading to the lake, and up to 90\% if the DIP
   concentration of the spring, as representative for the average DIP of
   the regional confined aquifer, is assigned to the estimated groundwater
   input. In support, paleolimnological data retrieved from sediment cores
   indicated that Norreso was never P-poor, even before the introduction of
   agriculture at 6000 years before present. Accordingly, groundwater-borne
   geogenic phosphorus can have an important influence on the trophic state
   of recipient surface water ecosystems, and groundwater-borne P can be a
   potentially important component of the terrestrial P cycle.},
