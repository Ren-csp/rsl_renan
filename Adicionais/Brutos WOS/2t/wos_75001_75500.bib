ORCID-Numbers = {Gregory, Andrew/0000-0003-1905-3236
   Sandercock, Brett/0000-0002-9240-0268},
Funding-Acknowledgement = {Kansas State University Open Access Publishing Fund},
Funding-Text = {Many field technicians helped to collect field data on movements of
   prairie-chickens. We thank B. N. Kertson for generous assistance in
   providing details on the RUF methodology. All capture, marking and
   tracking activities were performed under institutional and state
   wildlife research permits. Research funding and equipment were provided
   by a consortium of federal and state wildlife agencies, conservation
   groups and wind energy partners under the National Wind Coordinating
