@article{ WOS:001228997200025,
Author = {Megaw, Roly and Moye, Abigail and Zhang, Zhixian and Newton, Fay and
   Mcphie, Fraser and Murphy, Laura C. and Mckie, Lisa and He, Feng and
   Jungnickel, Melissa K. and von Kriegsheim, Alex and Tennant, Peter A.
   and Brotherton, Chloe and Gurniak, Christine and Gross, Alecia K. and
   Machesky, Laura M. and Wensel, Theodore G. and Mill, Pleasantine},
Title = {Ciliary tip actin dynamics regulate photoreceptor outer segment
   integrity},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAY 21},
Abstract = {As signalling organelles, cilia regulate their G protein-coupled
   receptor content by ectocytosis, a process requiring localised actin
   dynamics to alter membrane shape. Photoreceptor outer segments comprise
   an expanse of folded membranes (discs) at the tip of highly-specialised
   connecting cilia, into which photosensitive GPCRs are concentrated.
   Discs are shed and remade daily. Defects in this process, due to
   mutations, cause retinitis pigmentosa (RP). Whilst fundamental for
   vision, the mechanism of photoreceptor disc generation is poorly
   understood. Here, we show membrane deformation required for disc genesis
   is driven by dynamic actin changes in a process akin to ectocytosis. We
   show RPGR, a leading RP gene, regulates actin-binding protein activity
   central to this process. Actin dynamics, required for disc formation,
   are perturbed in Rpgr mouse models, leading to aborted membrane shedding
   as ectosome-like vesicles, photoreceptor death and visual loss. Actin
   manipulation partially rescues this, suggesting the pathway could be
   targeted therapeutically. These findings help define how actin-mediated
   dynamics control outer segment turnover.
   Photoreceptor outer segment abnormalities cause retinitis pigmentosa, a
   form of blindness. Here, authors show that the disease-associated gene
   RPGR regulates actin-mediated outer segment turnover through its
   interaction with the actin severer, cofilin.},
