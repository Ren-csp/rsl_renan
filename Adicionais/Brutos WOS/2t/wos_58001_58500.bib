@article{ WOS:000603308800090,
Author = {Lansford, Joshua L. and Vlachos, Dionisios G.},
Title = {Spectroscopic Probe Molecule Selection Using Quantum Theory,
   First-Principles Calculations, and Machine Learning},
Journal = {ACS NANO},
Year = {2020},
