@article{ WOS:001861720100001,
Author = {Wang, Jiayi and Cao, Yu},
Title = {Identifying key recipients and priority ecosystem services for precise
   cultivated land ecological compensation},
Journal = {ENVIRONMENTAL IMPACT ASSESSMENT REVIEW},
Year = {2027},
Volume = {122},
Month = {JAN},
Abstract = {Cultivated land ecological compensation (CLEC) is a critical policy tool
   to coordinate food security, ecological conservation and high-quality
   agricultural development. However, earlier studies overemphasised the
   quantification of compensation standards while neglecting two central
   practical issues, namely who to compensate and which ecosystem services
   to compensate for, which has led to imprecise policy implementation and
   low fund efficiency. Accordingly, this study constructs a
   multi-dimensional identification framework integrating objective
   supply-demand assessment and subjective stakeholder perception and
   applies it to the Yangtze River Delta, a typical region with intense
   human-land conflicts. Using the InVEST model, statistical analysis and
   the fuzzy-set qualitative comparative analysis, this study
   systematically assess six categories of cultivated land ecosystem
   services (CLESs) and identify key recipients of CLEC and priority CLES
   types. Results show that CLES supply and demand display significant
   regional heterogeneity: food production and soil retention are generally
   in surplus while biodiversity maintenance and cultural services are
   widely insufficient. The key recipients of compensation are farmers with
   low ecological cognition, weak participation willingness and
   insufficient endowments of land, as well as ``hobby +
   knowledge-driven{''} farmers with ecological transformation potential.
   At the regional scale, food production and water conservation are
   identified as core compensation services owing to their relatively high
   subjective importance and low degree of satisfaction; accordingly,
   sub-regions should adopt differentiated priorities based on local
   supply-demand mismatches. This study innovates the ``precise
   identification-classified compensation{''} paradigm, provides a
   scientific basis for precise CLEC policy design and effective
   implementation, and supports the realisation of cultivated land
   multifunctionality and sustainable land management.},
