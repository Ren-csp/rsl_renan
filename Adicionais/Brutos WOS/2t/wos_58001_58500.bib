@article{ WOS:001751282400001,
Author = {Cao, Tiffany and Young, Ian},
Title = {Determinants of information-seeking behaviour about beach water quality
   in the Great Lakes basin},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {8},
Number = {4},
Month = {APR 1},
Abstract = {Beach recreation is increasing in the Great Lakes basin because of
   longer season lengths due to climate change. With greater frequency and
   popularity of outdoor water recreation, the risk and burden of
   water-borne illnesses is expected to increase. Using data from the
   International Joint Commission's 2024 Great Lakes regional poll, this
   study investigated the association between socio-demographic and
   geographic factors, water quality perceptions and understandings, and
   water quality information-seeking behaviour. Specifically, the
   association between these factors and the frequency of checking beach
   water quality before swimming was examined among residents living in the
   Great Lakes region using ordinal regression models. The results
   indicated that participants 55+ and 18-34 of age had the highest
   predicted probability of checking water quality before swimming.
   Beachgoers with high school or less education or with a post-secondary
   degree were the least likely to check water quality. Those living in
   Wisconsin, Minnesota, and Illinois had the highest predicted probability
   of checking water quality, and generally those living closest to lake
   Michigan or lake superior had lower odds of checking water quality
   compared to those living closest to other Great Lakes. Engaging in
   water-based recreational activities was associated with a higher
   predicted probability of checking water quality, except for those who
   use boats who had a lower predicted probability of checking. Overall,
   the study highlights potential groups of beachgoers that public health
   officials and beach operators could focus their beach water quality
   communication and outreach to help reduce water-borne illness risks in
   the Great Lakes basin.},
