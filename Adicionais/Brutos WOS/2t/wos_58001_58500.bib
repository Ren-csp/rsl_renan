Title = {Connecting sea to market: Using network analysis to understand
   social-ecological dynamics in seafood value chains in Pisco, Southern
   Peru},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {10},
Pages = {2465-2485},
