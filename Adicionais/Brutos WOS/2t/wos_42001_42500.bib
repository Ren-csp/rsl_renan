@article{ WOS:001776847600001,
Author = {Rasolonjatovo, Delphin and Seraphin, Fabrice and Armand, Benjara and
   Yverlin, Z. M. Pruvot},
Title = {Peer-reviewed documentation of leucism in white-faced whistling duck
   Dendrocygna viduata, in Madagascar},
Journal = {SUSTAINABLE ENVIRONMENT},
Year = {2026},
Volume = {12},
Number = {1},
Month = {DEC 31},
Abstract = {We observed an adult individual of White-faced Whistling Duck
   Dendrocygna viduata exhibiting leucism on the waterbody of the
   Tsimbazaza Botanical and Zoological Park, in Antananarivo. This anomaly
   is characterized by a depigmentation of feathers, without affecting
   ocular tissues. The individual, within a group of normally pigmented
   conspecifics, showed clearly visible white patches on the back, wings
   and legs. This note constitutes a peer-reviewed documentation of leucism
   in D. viduata in Madagascar by scientists.
   Un individu adulte de Dendrocygne veuf Dendrocygna viduata, pr \&
   eacute;sentant un leucisme partiel, a \& eacute;t \& eacute; observ \&
   eacute; sur le plan d'eau du Parc Botanique et Zoologique de Tsimbazaza,
   \& agrave; Antananarivo. Cette anomalie se manifeste par une d \&
   eacute;pigmentation des plumes, sans atteinte des tissus oculaires.
   L'individu, int \& eacute;gr \& eacute; dans un groupe d'individus
   normalement pigment \& eacute;s, affichait des zones blanches bien
   visibles sur le dos, les ailes et les pattes. Cette note sert \& agrave;
   documenter scientifiquement le cas de leucisme chez D. viduata.},
