@article{ WOS:000338667900001,
Author = {Lane, Kathryn and Wheeler, Katherine and Charles-Guzman, Kizzy and
   Ahmed, Munerah and Blum, Micheline and Gregory, Katherine and Graber,
   Nathan and Clark, Nancy and Matte, Thomas},
Title = {Extreme Heat Awareness and Protective Behaviors in New York City},
