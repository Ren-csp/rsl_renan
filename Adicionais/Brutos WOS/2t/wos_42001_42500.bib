@article{ WOS:001324397800001,
Author = {Qin, Siyu and Buchadas, Ana and Meyfroidt, Patrick and He, Yifan and
   Ghoddousi, Arash and Poetzschner, Florian and Baumann, Matthias and
   Kuemmerle, Tobias},
Title = {Links between deforestation, conservation areas and conservation funding
   in major deforestation regions of South America},
Journal = {PEOPLE AND NATURE},
Year = {2024},
Volume = {6},
Number = {5},
Pages = {1789-1803},
Month = {OCT},
Abstract = {Land-use change is a major driver of biodiversity loss, affecting
   tropical forests and savannas at an unprecedented rate. To protect these
   ecosystems and their biodiversity, national conservation areas and
   international conservation funding have increased considerably in these
   regions. Understanding of how conservation funding allocation relates to
   dynamics in deforestation and conservation areas is crucial to
   identifying what mobilizes and distributes conservation funding. By
   applying fixed-effect models on 30 years of dynamics in forest cover,
   conservation areas and conservation funding in the main deforestation
   regions of South America, we analysed the conservation funding
   allocation strategies in relation to deforestation (proactive vs.
   reactive), conservation areas (expanding or consolidating) and previous
   investment (agglomerating or not). We also assessed whether allocation
   strategies vary across regions and the stages of deforestation and
   conservation. We found that funding allocation followed conservation
   areas and higher prior funding levels over space and over time, across
   all regions and deforestation stages. This highlights the important role
   of recognized conservation areas (including protected areas and
   Indigenous territories) in mobilizing financial support for
   conservation. The allocation strategies relating to forest dynamics,
   however, varied depending on the scale of analysis, whether we look at
   the temporal or spatial dimension, and in which regions we assessed the
   allocation patterns. Capturing region-level biases and within-region
   dynamics is crucial for more effective and equitable conservation. As
   public and private actors commit to mobilizing more conservation funding
   and conserving more areas of the Earth, our insights on the relations
   between forest change and conservation efforts can help improve the
   allocation of conservation areas and conservation funding.Read the free
   Plain Language Summary for this article on the Journal blog.
   El cambio de uso de la tierra es uno de los principales motores de la p
   \& eacute;rdida de biodiversidad, que afecta a los bosques y sabanas
   tropicales a un ritmo sin precedentes. Para proteger estos ecosistemas y
   su biodiversidad, las \& aacute;reas nacionales de conservaci \&
   oacute;n y la financiaci \& oacute;n internacional para la conservaci \&
   oacute;n han aumentado considerablemente en estas regiones. Una mejor
   comprensi \& oacute;n de c \& oacute;mo la asignaci \& oacute;n de
   fondos para la conservaci \& oacute;n afronta la deforestaci \& oacute;n
   y la din \& aacute;mica de las \& aacute;reas de conservaci \& oacute;n
   es crucial para identificar qu \& eacute; moviliza y distribuye los
   fondos para la conservaci \& oacute;n Aplicando modelos de efectos fijos
   a 30 a \& ntilde;os de din \& aacute;mica de la cobertura forestal, las
   \& aacute;reas de conservaci \& oacute;n y la financiaci \& oacute;n de
   la conservaci \& oacute;n en las principales regiones de deforestaci \&
   oacute;n de Sudam \& eacute;rica, analizamos las estrategias de asignaci
   \& oacute;n de fondos para la conservaci \& oacute;n en relaci \&
   oacute;n con la deforestaci \& oacute;n (proactiva vs. reactiva), las \&
   aacute;reas de conservaci \& oacute;n (en expansi \& oacute;n o
   consolidaci \& oacute;n) y la inversi \& oacute;n previa (en aglomeraci
   \& oacute;n o no), as \& iacute; como la forma en que las estrategias de
   asignaci \& oacute;n var \& iacute;an entre los diferentes biomas y las
   fases de deforestaci \& oacute;n y conservaci \& oacute;n. Encontramos
   que la asignaci \& oacute;n de fondos sigui \& oacute; a las \&
   aacute;reas de conservaci \& oacute;n y a los mayores niveles de
   financiaci \& oacute;n previa en el espacio y en el tiempo, en todos los
   biomas. Esto resalta el importante papel de las \& aacute;reas de
   conservaci \& oacute;n reconocidas (incluidas las \& aacute;reas
   protegidas y los territorios ind \& iacute;genas) en la movilizaci \&
   oacute;n y canalizaci \& oacute;n del apoyo financiero para la
   conservaci \& oacute;n. Las estrategias de asignaci \& oacute;n
   relativas a la din \& aacute;mica forestal, sin embargo, variaron en
   funci \& oacute;n de la escala de an \& aacute;lisis, en funci \&
   oacute;n de si nos enfocamos en la dimensi \& oacute;n temporal o
   espacial, y en qu \& eacute; bioma evaluamos los patrones de asignaci \&
   oacute;n. Captar los sesgos a nivel de bioma y las din \& aacute;micas
   dentro del bioma es crucial para una conservaci \& oacute;n m \&
   aacute;s efectiva y equitativa. A medida que actores p \& uacute;blicos
   y privados se comprometen a movilizar m \& aacute;s fondos para la
   conservaci \& oacute;n y a conservar m \& aacute;s \& aacute;reas de la
   Tierra, nuestros hallazgos sobre las relaciones entre el cambio forestal
   y los esfuerzos de conservaci \& oacute;n pueden ayudar a mejorar la
   asignaci \& oacute;n de \& aacute;reas de conservaci \& oacute;n y de
   fondos para la conservaci \& oacute;n.
