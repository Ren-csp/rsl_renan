@article{ WOS:000575093200011,
Author = {Rosa, Isabel M. D. and Purvis, Andy and Alkemade, Rob and
   Chaplin-Kramer, Rebecca and Ferrier, Simon and Guerra, Carlos A. and
   Hurtt, George and Kim, HyeJin and Leadley, Paul and Martins, Ines S. and
