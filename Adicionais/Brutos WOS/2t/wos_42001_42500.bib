@article{ WOS:001830033300001,
Author = {Ribeiro, Joao Vitor Mariano and Kanai, Cristhy Satie and de Oliveira,
   Fernanda Santos and Pimentel, Alan dos Santos and Negri, Rogerio Galante
   and Massi, Klecia Gili},
Title = {Examining socioeconomic and biophysical factors associated with wildfire
   occurrence in Southeast Atlantic Forest, Brazil},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2026},
Volume = {94},
Month = {DEC},
Abstract = {In recent years, Brazil has faced alarming fire seasons. The
   fire-sensitive Atlantic Forest biome, a biodiversity hotspot, is
   historically impacted by anthropogenic fires. Although the influence of
   biophysical and socioeconomic factors at a fine-scale has received
   attention in wildfire studies, the relationship between macroscale
   socioeconomic indicators and fire occurrence remains poorly known. Thus,
   we sought to examine the possible relationships between biophysical and
   socioeconomic factors and fire occurrences in the southeast Atlantic
   Forest, at both macroscale and fine-scale polygon-level. Using
   Geographic Information System and statistical models, we related fire
   scars to municipal-scale and local-scale predictors. During the 37 years
   analyzed (1986-2022), the mean annual burned area decreased, whereas the
   mean fire-scar size increased. In addition, the peak months for fire
   scars shifted from July-November to August-September. Fire scars were
   positively associated with altitude, slope, and distance to roads,
   negatively with distance to urban areas and total area occupied by rural
   lands in a municipality, more frequently on high solar radiation
   orientation, and less likely in forested areas. Considering fire
   intensity and pollutant dispersion, the shift in months of fire
   occurrence is worrying. Fire occurrence at higher altitudes and slopes
   may be linked to pasture renewal, fires in highland native grasslands,
   and far from roads. Close to urban areas, fire risk was higher due to
   human activities. Although forests are less susceptible to fires,
   recurrent fires, fragmentation, and climate change can enhance its
   flammability. This knowledge is fundamental for an Integrated Fire
   Management approach to reduce fire risk.},
