Language = {English},
Affiliation = {Nasi, E (Corresponding Author), Insurance Inst Finland, Res Unit, Nordenskioldinkatu 12, Helsinki 00250, Finland.
   Nasi, E (Corresponding Author), Tampere Univ, Fac Social Sci, Arvo Ylpon Katu 34, Tampere 33014, Finland.
