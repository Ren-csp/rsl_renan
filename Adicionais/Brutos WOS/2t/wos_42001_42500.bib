@article{ WOS:001409314200001,
Author = {Poudel, Shobha and Wickramasinghe, Deepthi and Mukherjee, Mahua and
   Chowdhooree, Imon and Chimi, Chimi and Mishra, Bhogendra and Abhinay,
   Kumar and Mitra, Sudip and Shaw, Rajib},
Title = {The status and prospect on nature-based solution in South Asia: A
   policy-based analysis},
Journal = {PLOS CLIMATE},
Year = {2024},
Volume = {3},
Number = {3},
Abstract = {South Asian countries face a disproportionate impact from disasters due
   to their unique topography, poverty, low literacy rates, and
   socio-economic status. Human activities, such as unplanned urbanization
   and poorly designed rural road networks, have further contributed to
   disasters in the region. The article explores the potential of
   nature-based solutions (NbS) as a means of addressing these challenges
   through the integration of green, blue, and grey infrastructure. The
   analysis evaluates the significance of NbS and examines policies and
   regional cooperation in Bangladesh, Bhutan, India, Nepal, and Sri Lanka,
   highlighting the importance of incorporating NbS into national policies
   and promoting collaboration among these countries. The study identifies
   the current low implementation of NbS in South Asia, with limited
   research in this area. While there are existing policy tools related to
   coastal zone management, water, forest, and urban development, policies
   related to NbS should be coherent, connected, and integrated with
   natural resources, climate change, disaster risk reduction, and
   socio-economic growth to achieve sustainable development in the region.
   Overall, the article emphasizes the need for effective policy
   implementation and research to enhance resilience to climate change and
   promote sustainable development in South Asia.},
Publisher = {PUBLIC LIBRARY SCIENCE},
Address = {1160 BATTERY STREET, STE 100, SAN FRANCISCO, CA 94111 USA},
Type = {Article},
Language = {English},
Affiliation = {Poudel, S (Corresponding Author), Sci Hub, Res Dept, Kathmandu, Nepal.
   Poudel, Shobha, Sci Hub, Res Dept, Kathmandu, Nepal.
   Wickramasinghe, Deepthi, Univ Colombo, Fac Sci Zool \& Environm Sci, Colombo, Sri Lanka.
   Mukherjee, Mahua, Indian Inst Technol, Dept Architecture \& Planning, Roorkee, India.
