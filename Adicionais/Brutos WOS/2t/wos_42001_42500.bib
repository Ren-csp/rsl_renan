   Choy, Yee Keong, Kyoto Univ, Grad Sch Econ, Kyoto, Japan.},
DOI = {10.14207/ejsd.2017.v6n1p308},
ISSN = {2239-5938},
EISSN = {2239-6101},
Keywords = {Brundtland Report; intergenerational equity; environmental
   sustainability; environmental ethics},
Keywords-Plus = {VALUATION},
Research-Areas = {Environmental Sciences \& Ecology},
