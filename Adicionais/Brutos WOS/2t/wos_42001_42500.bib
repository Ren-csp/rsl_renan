@article{ WOS:001818823200007,
Author = {Leiva, Maximiliano Luis and Morales, Leandro Jesus and Cevasco, Jazmin
   and Sanchez, Federico Jose},
Title = {Consumer psychology: Processes, decisions and new trends},
Journal = {REVISTA CES PSICOLOGIA},
Year = {2026},
Volume = {19},
Number = {2},
Month = {MAY-AUG},
Abstract = {Consumer psychology is an interdisciplinary field that examines the
   psychological, social, and contextual processes that influence
   purchasing behaviour. This narrative review aimed to provide an updated
   overview of the main lines of research in consumer psychology,
   integrating theoretical and empirical contributions from cognitive
   psychology, social psychology, and marketing. A literature search was
   conducted in indexed academic databases (Scopus, Web of Science,
   PsycINFO, SciELO, and Google Scholar), covering publications from 2010
   to 2025 and incorporating foundational classical works when necessary
   for theoretical contextualization. The article was organized around the
   following conceptual axes: motivation, emotions, sensory perception,
   decision-making processes, social influence, neuromarketing, and
   consumer behaviour in digital environments. Emerging trends were also
   identified, including algorithmic personalization, the experiential
   approach to consumption, and the incorporation of neuroscientific
   technologies into marketing. Finally, the limitations of the field are
   outlined, and both conceptual and methodological gaps are discussed.
   Conceptual gaps include the limited integration of cognitive and
   affective processes, the insufficient incorporation of dispositional
   variables, and the weak articulation with clinical and cultural
   frameworks. Methodological gaps include the predominance of Western and
   urban samples, the scarcity of longitudinal studies, and the limited
   empirical evidence from Latin American contexts. This study provides a
   view of the consumer as an emotional, situated, and active agent within
   the context of contemporary digital and cultural transformation and
   offers directions for future research.},
