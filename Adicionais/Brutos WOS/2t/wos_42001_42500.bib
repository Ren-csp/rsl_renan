@article{ WOS:000837856800006,
Author = {Dixon, Megan},
Title = {Seeking Ecology and Equity Along the Boise Greenbelt},
Journal = {CHANGING SOCIETIES \& PERSONALITIES},
Year = {2022},
Volume = {6},
Number = {2},
Pages = {350-363},
Abstract = {As a pedestrian-friendly green landscape that has become popular in the
   US and around the world in the past fifty years, the Boise Greenbelt
   seems to present an ideal example of how to create a waterfront that can
   promote economic growth along with high recreational use. However, there
   are two aspects to interrogate as we ponder an effective model for such
   landscapes going into a future affected by climate change: first, like
   many such landscapes which focus on an esthetic leisure experience for
   the user, the Boise Greenbelt does not fully attend to the ecology of
   the river along which it lies; second, also as a feature of esthetic
   leisure experience, the Boise Greenbelt falls into a category of ``park,
   cafe, riverwalk{''} which potentially reduces equity in use of urban
   space. Analysis of this landscape and its successes can help to shape a
   model that will be responsive to future climate conditions and enhance
   social equity.},
