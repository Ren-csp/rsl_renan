@article{ WOS:A1985APN1700019,
Author = {NASCIMENTO, JP and KRAWCZUK, MM and MARCOPITO, LF and BARUZZI, RG},
Title = {PREVALENCE OF ANTIBODY AGAINST INFLUENZA-A VIRUSES IN THE KREN-AKORORE,
   AN INDIAN TRIBE OF CENTRAL BRAZIL, 1ST CONTACTED IN 1973},
Journal = {JOURNAL OF HYGIENE},
Year = {1985},
Volume = {95},
Number = {1},
Pages = {159-164},
Abstract = {Influenza A antibodies in serum samples obtained in 1980 from 2 Indian
   populations in central Brazil were compared. The Kren-Akorore, who were
   1st contacted in 1973 and 2 yr later transferred to the Xingu Indian
   park (PIX), were compared with Indians from other tribes already living
   in the PIX before 1975. An analysis was made of the prevalence and
   distribution of antibodies against the influenza A viruses which have
   circulated in the civilized world since 1918. Antibodies to the early
   influenza A viruses were absent in both Indian populations, but A/Hong
   Kong/1/68 (H3N2) virus apparently circulated in the PIX. No antibody to
   influenza A/Bangkok/1/79 or to A/Brazil/11/78 (H1N1) was found in any of
   the sera, whereas antibodies to these viruses were commonly found in
   urban populations in Brazil. The evidence from influenza antibodies
   agrees with the information that the Kren-Akorore Indians had been
   living in complete isolation until 1973, when they were 1st contacted.},
