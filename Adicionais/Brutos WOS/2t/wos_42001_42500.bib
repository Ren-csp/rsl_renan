@article{ WOS:000267796100010,
Author = {Bajaj, Avinash and Miranda, Oscar R. and Kim, Ik-Bum and Phillips,
   Ronnie L. and Jerry, D. Joseph and Bunz, Uwe H. F. and Rotello, Vincent
   M.},
Title = {Detection and differentiation of normal, cancerous, and metastatic cells
   using nanoparticle-polymer sensor arrays},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2009},
Volume = {106},
Number = {27},
Pages = {10912-10916},
Month = {JUL 7},
Abstract = {Rapid and effective differentiation between normal and cancer cells is
   an important challenge for the diagnosis and treatment of tumors. Here,
   we describe an array-based system for identification of normal and
   cancer cells based on a ``chemical nose/tongue{''} approach that
   exploits subtle changes in the physicochemical nature of different cell
   surfaces. Their differential interactions with functionalized
   nanoparticles are transduced through displacement of a multivalent
   polymer fluorophore that is quenched when bound to the particle and
   fluorescent after release. Using this sensing strategy we can rapidly
   (minutes/seconds) and effectively distinguish (i) different cell types;
   (ii) normal, cancerous and metastatic human breast cells; and (iii)
   isogenic normal, cancerous and metastatic murine epithelial cell lines.},
