Author = {Milovanovic, Dragomir and Honigmann, Alf and Koike, Seiichi and
   Goettfert, Fabian and Paehler, Gesa and Junius, Meike and Muellar,
   Stefan and Diederichsen, Ulf and Janshoff, Andreas and Grubmueller,
