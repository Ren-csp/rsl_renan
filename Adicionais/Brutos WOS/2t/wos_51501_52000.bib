@article{ WOS:001178091600027,
Author = {Nguyen, Anh T. P. and Weigle, Austin T. and Shukla, Diwakar},
Title = {Functional regulation of aquaporin dynamics by lipid bilayer composition},
Journal = {NATURE COMMUNICATIONS},
