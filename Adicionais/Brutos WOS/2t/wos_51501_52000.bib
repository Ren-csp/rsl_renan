   Mongkolsapaya, Juthathip and Heinz, Franz X. and Screaton, Gavin R. and
   Rey, Felix A.},
Title = {Structural basis of potent Zika-dengue virus antibody
   cross-neutralization},
Journal = {NATURE},
Year = {2016},
Volume = {536},
