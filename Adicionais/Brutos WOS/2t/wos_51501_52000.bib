@article{ WOS:001822655800010,
Author = {Aluri, Srinivas and Bachiashvili, Kimo and Budhathoki, Anjali and Jeong,
   Jong Jin and Gordon-Mitchell, Shanisha and Chakraborty, Samarpana and
   Yang, Jung-In and Sahu, Srabani and Pandey, Sanjay and Sandhu, Micheal
   and Paul, Mahinder and Deng, Wenjun and Sanawar, Rahul and Sahu, Plabani
   and Kravets, Leah and Aminov, Sarah and Aggarwal, Ritesh and Agarwal,
   Beamon and Verma, Divij and Choudhary, Gaurav S. and Bhagat, Tushar D.
   and Carbajal, Milagros and Zhao, Rongbao and Pradhan, Kith and Maqbool,
   Shahina and Kim, Seong-Jin and Steidl, Ulrich G. and Shastri, Aditi and
   Raaijmakers, Marc and Pellagatti, Andrea and Boultwood, Jacqueline and
   Wickrema, Amittha and Verma, Amit},
Title = {Chromatin rewiring of β-globin and MYC enhancers by TGF-β1 drives
   defective erythropoiesis},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 13},
Abstract = {Erythropoiesis is a tightly regulated process involving rapid cell
   proliferation with orderly differentiation to ensure production of
   millions of RBCs. TGF-beta 1 is a key regulator of erythropoiesis,
   however, the mechanisms via which it regulates erythropoiesis are not
   well elucidated. Using myelodysplastic syndromes patient samples, we
   show that elevated TGF-beta 1 and SMAD2 signaling correlates with the
   degree of anemia. Functional studies in primary human HSPCs demonstrate
   that TGF-beta 1 exerts a bifurcated effect - suppressing proliferation
   and inducing premature erythroid differentiation - both of which are
   rescued by clinical-stage TGFBR1 inhibitor. Through integrative RNA-seq,
   ChIP-seq, and Micro-C analyses, we find TGF-beta 1 activates beta-globin
   LCR, driving early differentiation, while concurrently disrupting the
   MYC enhancer-promoter interaction to block proliferation. We validate
   erythropoiesis defects in vivo by performing single-cell RNA-seq in a
   TGF-beta 1 overexpressing mouse model. Overall, we show that TGF-beta
   1/SMAD2 signaling re-wires chromatin to regulate erythropoiesis by
   affecting the beta-LCR and MYC super enhancer regions.},
