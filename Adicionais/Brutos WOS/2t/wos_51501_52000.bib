@article{ WOS:001635637100001,
Author = {Wang, Bingjie and Li, Zhengyang},
Title = {Corporate social responsibility framework in esports: evidence from
   China},
Journal = {SPORT IN SOCIETY},
Year = {2026},
Volume = {29},
Number = {8},
Pages = {1668-1690},
Month = {AUG 3},
Abstract = {Although esports has rapidly developed and gained increasing recognition
   in both academia and industry, research on corporate social
   responsibility (CSR) within this field remains largely unexplored. As
   the industry continues to expand, various social challenges highlight
   the growing need for CSR initiatives. This study provides an in-depth
   exploration of how esports CSR is perceived and implemented in China, as
   well as the contextual factors that influence these perceptions. Primary
   data were gathered through semi-structured interviews with 16
   professionals from the esports industry and academia. Secondary data
   consisted of internal publications and public sources, such as
   government policy reports and corporate initial public offering
   prospectuses. Using a deductive thematic analysis grounded in
   sustainable development (SD) framework, six CSR dimensions were
   identified: economic, youth, athlete, public, (e) community, and (e)
   environmental responsibility. This study provides valuable insights for
   policymakers, esports organizations, investors, and stakeholders seeking
   to foster sustainable growth.},
