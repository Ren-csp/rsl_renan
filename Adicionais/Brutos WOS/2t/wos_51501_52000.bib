Author = {Bekee, Barituka and Segovia, Michelle S. and Valdivia, Corinne},
Title = {Adoption of smart farm networks: a translational process to inform
   digital agricultural technologies},
Journal = {AGRICULTURE AND HUMAN VALUES},
Year = {2024},
