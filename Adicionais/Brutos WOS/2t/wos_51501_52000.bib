@article{ WOS:000340615500047,
Author = {Hokr, Brett H. and Bixler, Joel N. and Cone, Michael T. and Mason, John
   D. and Beier, Hope T. and Noojin, Gary D. and Petrov, Georgi I. and
   Golovan, Leonid A. and Thomas, Robert J. and Rockwell, Benjamin A. and
   Yakovlev, Vladislav V.},
Title = {Bright emission from a random Raman laser},
Journal = {NATURE COMMUNICATIONS},
Year = {2014},
Volume = {5},
Month = {JUL},
Abstract = {Random lasers are a developing class of light sources that utilize a
   highly disordered gain medium as opposed to a conventional optical
   cavity. Although traditional random lasers often have a relatively broad
   emission spectrum, a random laser that utilizes vibration transitions
   via Raman scattering allows for an extremely narrow bandwidth, on the
   order of 10 cm(-1). Here we demonstrate the first experimental evidence
   of lasing via a Raman interaction in a bulk three-dimensional random
   medium, with conversion efficiencies on the order of a few percent.
   Furthermore, Monte Carlo simulations are used to study the complex
   spatial and temporal dynamics of nonlinear processes in turbid media. In
