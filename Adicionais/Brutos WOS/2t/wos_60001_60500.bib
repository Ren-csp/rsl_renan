@article{ WOS:001826825100001,
Author = {Bax, Vincent and Terpstra, Teun},
Title = {Farmers' perspectives on the concept of transitional polders as a
   climate adaptation measure: A case study from Zeeland, the Netherlands},
Journal = {NATURE-BASED SOLUTIONS},
Year = {2026},
Volume = {10},
Month = {DEC},
Abstract = {The concept of transitional polders is emerging as a promising
   nature-based flood protection strategy in deltas. Transitional polders
   are a form of tidal restoration that aim at stimulating sedimentation
   processes and thereby facilitating land-level rise in low-lying polders.
   They require the temporary suspension of existing land-use, often
   agriculture, which may lead to opposition among private landowners such
   as farmers. At the same time, transitional polders provide alternative
   economic opportunities and benefits for agriculture, which may have a
   positive effect on the perspectives of farmers. In this study, we
   examine support among farmers for the concept of transitional polders
   and identify socio-psychological determinants that shape their support.
   We administered questionnaires among farmers in the province of Zeeland,
   the Netherlands (n = 91) and used regression analysis to analyze the
   collected data. Results indicate that although support for immediate
   implementation of transitional polders is limited, farmers do express
   openness to further exploration of the concept. Low outcome expectancies
   stand out as having the strongest effect on farmers' level of support,
   while negative affective responses, risk perception and climate
   skepticism also play a role. To increase support, pilot projects are
   needed to test the concept in practice and generate more knowledge on
   the feasibility and benefits of transitional polders. Involving farmers
   in the development and exchange of this knowledge may further support
   learning and acceptance. Future research should examine support for
   location-specific designs to further our understanding of how
   transitional polders could move from a promising concept toward concrete
   implementation.},
