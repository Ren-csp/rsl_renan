@article{ WOS:000380964900017,
Author = {Chulayo, Amanda Y. and Muchenje, Voster},
Title = {Effects of animal class and genotype on beef muscle nanostructure,
   pHu, colour and tenderness},
Journal = {SOUTH AFRICAN JOURNAL OF SCIENCE},
Year = {2016},
Volume = {112},
Number = {7-8},
Pages = {105-113},
Month = {JUL-AUG},
Abstract = {The objective of the study was to determine the effects of animal class
   and genotype of cattle on Muscularis longissimus thoracis et lumborum
   (LTL) nanostructure, ultimate pH (pH(u)), colour and tenderness of beef.
   We found significant positive relationships between distance travelled
   (DT) and meat temperature (T-m) (p<0.01); lairage duration (LDhr) and
   lightness of colour (L-star) (p<0.01); ambient temperature (T-a) and
   L-star (p<0.05) and LDhr and yellowness (b(star)) (p<0.05) of beef from
   Bonsmara cattle. Positive linear relationships were observed between DT
   and T-m (p<0.05) and DT and L-star (p<0.01) of the non-descript cattle.
   There were no significant relationships between pre-slaughter stress and
   other beef quality parameters (pH(u), Warner-Bratzler shear force
   {[}WBSF], redness {[}a(star)] and b(star)) of Bonsmara, Nguni and
   non-descript cattle. Muscle fibres differed among class and genotype and
   had an effect on meat quality. The Bonsmara, non-descript and Nguni cows
   and heifers had visible skeletal muscle fibres which were thin and long,
   promising improved tenderness of beef. Genotype and class had
   significant effects on meat quality parameters (T-m, pH(u), L-star,
   a(star), b(star) and WBSF). The first important principal components as
   they appeared from the analysis were pH(u), T-m, L-star, a(star),
   b(star) and WBSF. Therefore, animal class did not affect the
   nanostructure of beef; instead, meat tenderness was enhanced by the
   longer and visible muscle fibres. Nguni cattle produced meat of superior
   quality to that of the Bonsmara and the non-descript cattle.},
