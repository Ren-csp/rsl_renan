   Mcintyre, Ceara and Walker, Jaisie and Gilbert, Jen and Flicker, Sarah},
Title = {Canadian Teacher Perspectives on Navigating Relationships: A
   Sexuality Curriculum for Grade 9 Students},
Journal = {AMERICAN JOURNAL OF SEXUALITY EDUCATION},
Year = {2026},
Volume = {21},
Number = {1},
Pages = {75-96},
Month = {JAN 2},
Abstract = {This paper reports on Navigating Relationships, an intervention designed
   to address gaps in sexuality education in Ontario. Following delivery in
   grade 9 classrooms by Planned Parenthood Ottawa facilitators, teachers
   participated in an interview to discuss their perceptions of its
   impacts. Our findings suggest that a case-based relationship-focused
   curriculum may contribute positively toward broader goals of
   comprehensive sexuality education. Key strengths include the engagement
   of advisors to infuse the curriculum with current youth experiences from
   diverse racialized and gendered perspectives, and the value of outside
   facilitators with training and aligned goals for providing sex- and
   relationship-positive education that normalizes ``difference{''}.},
