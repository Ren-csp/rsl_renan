@article{ WOS:001597560200001,
Author = {Peluso, Monica},
Title = {Towards an ecocritical and sustainable foreign language education
   through picturebooks},
Journal = {EUROPEAN JOURNAL OF APPLIED LINGUISTICS},
Year = {2025},
Volume = {13},
Number = {2},
Pages = {449-472},
Month = {NOV 25},
Abstract = {Departing from the developing fields of ecocriticism and posthumanism,
   the present article is aimed at analysing the ecological and posthuman
   potential of picturebooks, and to show their potential in fostering
   ecological wisdom and awareness in the context of language education. In
   particular, the article will first describe and uncover the
   representation of the relationship between humans and natural
   non-humans, namely plants, animals, and the elements considered as
   belonging to nature in Western culture, in three picture books, written
   in Italian, English, and Spanish, through Multimodal Discourse Analysis.
   Then, it will briefly present the implications of this analysis in the
   design of a training course for foreign language teachers interested in
   teaching a language while educating for sustainability through the
   promotion of ecological thinking.
   Partendo dai recenti sviluppi dell'ecocritica e del postumanesimo,
   questo articolo analizza il potenziale ecologico e postumano degli albi
   illustrati, evidenziandone la funzione nella promozione della
   consapevolezza ambientale e della saggezza ecologica attraverso
   l'educazione linguistica. Inizialmente, l'articolo si concentra su tre
   albi in italiano, inglese e spagnolo e, attraverso l'Analisi del
   Discorso Multimodale, esamina la rappresentazione del rapporto tra
   esseri umani e non-umani naturali, come piante, animali ed elementi
   tradizionalmente associati alla natura, in tali albi. Nella parte
   conclusiva, l'articolo discute le implicazioni dell'analisi presentata
   per la formazione di insegnanti di lingue straniere, interessati ad
   integrare l'insegnamento linguistico con l'educazione alla sostenibilit
   \& agrave; tramite la promozione del pensiero ecologico.
   Este art \& iacute;culo, en el marco de los desarrollos recientes de la
   ecocr \& iacute;tica y el posthumanismo, examina el potencial ecol \&
   oacute;gico y posthumano de los \& aacute;lbumes ilustrados, destacando
   su papel en la promoci \& oacute;n de la conciencia medioambiental y de
   la sabidur \& iacute;a ecol \& oacute;gica en la educaci \& oacute;n
   ling \& uuml;\& iacute;stica. El art \& iacute;culo se centra en tres \&
   aacute;lbumes en italiano, ingl \& eacute;s y espa \& ntilde;ol y,
   mediante el An \& aacute;lisis del Discurso Multimodal, explora la
   representaci \& oacute;n de la relaci \& oacute;n entre los seres
   humanos y los no humanos naturales, como plantas, animales y elementos
   tradicionalmente vinculados a la naturaleza. Finalmente, el art \&
   iacute;culo discute las implicaciones del an \& aacute;lisis para la
   formaci \& oacute;n de docentes de lenguas extranjeras, interesados en
   la integraci \& oacute;n de la ense \& ntilde;anza ling \& uuml;\&
   iacute;stica con la educaci \& oacute;n para la sostenibilidad a trav \&
   eacute;s del pensamiento ecol \& oacute;gico.},
