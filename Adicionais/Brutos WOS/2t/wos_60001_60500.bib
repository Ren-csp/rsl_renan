   Carini, Costanza; Paliotto, Andrea; Meocci, Monica; Mazzi, Camilla; La Torre, Francesca; Marradi, Alessandro, Univ Florence, Dept Civil \& Environm Engn, I-50139 Florence, Italy.},
DOI = {10.1016/j.aap.2026.108615},
