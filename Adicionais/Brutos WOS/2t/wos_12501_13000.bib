   Chen, Bin, Univ Hong Kong, Fac Architecture, Div Landscape Architecture, Hong Kong, Peoples R China.
   Wu, Jiayu, Zhejiang Univ, Inst Landscape Architecture, Hangzhou 310058, Zhejiang, Peoples R China.},
DOI = {10.1016/j.landurbplan.2023.104926},
EarlyAccessDate = {OCT 2023},
