@article{ WOS:000330448900007,
Author = {Nakamura, Yukiko and Afendi, Farit Mochamad and Parvin, Aziza Kawsar and
   Ono, Naoaki and Tanaka, Ken and Morita, Aki Hirai and Sato, Tetsuo and
   Sugiura, Tadao and Altaf-Ul-Amin, Md. and Kanaya, Shigehiko},
Title = {KNApSAcK Metabolite Activity Database for Retrieving the Relationships
   Between Metabolites and Biological Activities},
Journal = {PLANT AND CELL PHYSIOLOGY},
Year = {2014},
Volume = {55},
Number = {1},
Month = {JAN},
Abstract = {Databases (DBs) are required by various omics fields because the volume
   of molecular biology data is increasing rapidly. In this study, we
   provide instructions for users and describe the current status of our
   metabolite activity DB. To facilitate a comprehensive understanding of
   the interactions between the metabolites of organisms and the
   chemical-level contribution of metabolites to human health, we
   constructed a metabolite activity DB known as the KNApSAcK Metabolite
   Activity DB. It comprises 9,584 triplet relationships
   (metabolite-biological activity-target species), including 2,356
   metabolites, 140 activity categories, 2,963 specific descriptions of
   biological activities and 778 target species. Approximately 46\% of the
   activities described in the DB are related to chemical ecology, most of
   which are attributed to antimicrobial agents and plant growth
   regulators. The majority of the metabolites with antimicrobial
   activities are flavonoids and phenylpropanoids. The metabolites with
   plant growth regulatory effects include plant hormones. Over half of the
   DB contents are related to human health care and medicine. The five
   largest groups are toxins, anticancer agents, nervous system agents,
   cardiovascular agents and non-therapeutic agents, such as flavors and
   fragrances. The KNApSAcK Metabolite Activity DB is integrated within the
   KNApSAcK Family DBs to facilitate further systematized research in
   various omics fields, especially metabolomics, nutrigenomics and
   foodomics. The KNApSAcK Metabolite Activity DB could also be utilized
   for developing novel drugs and materials, as well as for identifying
   viable drug resources and other useful compounds.},
