@article{ WOS:001847209700001,
Author = {Al-Hosan, Amani Mohammed and Alghamdi, Muna Saad and Aldohan, Amnah and
   Alowfi, Setah Naser and El Kenawy, Ahmed M. and Youssef, Youssef M. and
   Gaber, Islam M.},
Title = {Towards Environmental Sustainability: Saudi Residents' Awareness,
   Attitudes, and Environmental Behaviors Toward Green Projects (A
   Cross-Sectional Study)},
Journal = {SUSTAINABILITY},
Year = {2026},
Volume = {18},
Number = {15},
Month = {AUG 5},
Abstract = {Environmental sustainability projects are essential for preserving
   natural resources and enhancing quality of life for present and future
   generations. This cross-sectional study examined Saudi residents'
   knowledge and awareness of green projects, attitudes and perceptions
   toward them, personal environmental behavior and participation, and
   perceptions of institutional and societal roles. A questionnaire was
   administered to 1044 participants from various regions across Saudi
   Arabia. Descriptive statistics, including means and standard deviations,
   together with the Mann-Whitney U test, Kruskal-Wallis H test, and Dunn's
   post hoc test, were used to answer the research questions and test the
   hypotheses. The findings indicated generally positive responses across
   the four dimensions; at the item level, most items fell within the agree
   range, while neutral ratings appeared mainly in items related to
   following green-project news, reviewing related policies, using
   low-emission transportation, and the perceived sufficiency of
   institutional communication. Significant differences were observed in
   the overall questionnaire and several dimensions according to gender,
   favoring females, and according to nationality, favoring Saudi
   participants. Regional differences were limited to the environmental
   behavior and personal participation dimension, whereas educational
   qualification did not produce significant differences. The absence of
   educational differences suggests that green-project awareness and
   behavior may be shaped not only by formal educational level, but also by
   national campaigns, media exposure, and shared public discourse. The
   study provides a countrywide empirical baseline for green-project
   awareness, attitudes, and environmental behaviors in Saudi Arabia and
   identifies areas for more targeted communication, regional engagement,
   and longitudinal research.},
