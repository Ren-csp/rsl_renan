@article{ WOS:000615615300001,
Author = {Chen, Jieh-Haur and Nguyen, Ha Thi Thu and Chou, Chien-Cheng and Wang,
   Jui-Pin and Wang, Ting-Kwei},
Title = {Transit-Oriented Development: Exploring Citizen Perceptions in a Booming
   City, Can Tho City, Vietnam},
Journal = {SUSTAINABILITY},
Year = {2021},
Volume = {13},
Number = {3},
Month = {FEB},
Abstract = {Transit-oriented development (TOD) is a crucial method for sustainable
   urban development and encouraging the use of public transit, especially
   for large densely populated cities such as Can Tho City, one of the top
   five cities in Vietnam. This study is aimed at identifying the factors
   which have a significant effect on the citizens' engagement of public
   transport in the TOD environment. Based on the literature review and
   expert knowledge, 3 hypotheses related to citizens' perceptions and
   citizen's engagement are developed. A questionnaire was accordingly
   established using structural equation modeling (SEM). As a result, a
   total of 8 factors with 31 stems were obtained. The survey
   questionnaires were distributed to citizens of Can Tho City with 749
