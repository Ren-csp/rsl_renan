   Afshari, Afshin, Fraunhofer Inst Bldg Phys, Fraunhoferstr 10, D-83626 Valley, Germany.
   Krustev, Veselin, Agricultural Acad, Inst Agr Econ, Sofia 1113, Bulgaria.},
DOI = {10.3390/urbansci9090331},
