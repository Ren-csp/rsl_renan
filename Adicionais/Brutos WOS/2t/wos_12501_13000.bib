@article{ WOS:001863517200001,
Author = {Zhang, Xiang and Zhong, Xue and Yan, Jun-Ru and Li, Qi and Liu, Kai-Xin
   and Yao, Ling-Ye and Zhang, Long-Hao and Moser-Reischl, Astrid and
   Rotzer, Thomas and Pauleit, Stephan and Rahman, Mohammad A.},
Title = {A hybrid deep learning framework for estimating urban tree transpiration},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2026},
Volume = {416},
Month = {SEP 1},
Abstract = {Urban trees regulate urban water-energy exchange via transpiration, yet
   accurate estimates in urban settings remain challenging. Traditional
   Jarvis-type models often require frequent recalibration and can produce
   biased estimates when parameters vary or structural assumptions are
   violated. Alternatively, hybrid deep learning (DL) models that integrate
   data-driven approaches with process knowledge represent a promising
   alternative, merging the flexibility of DL with prior information from
   process models. Nonetheless, the effectiveness of these hybrids for
   estimating urban tree transpiration has rarely been evaluated. This
   study investigates three physics-guided DL strategies that incorporate
   the Jarvis model: residual learning (M2), weighted fusion (M3), and
   feature learning (M4), against three baselines: Jarvis, pure DL, and
   Random Forest (RF). We also analyze SHAP-based explainability to assess
   feature contributions and interactions. Utilizing observed hourly sap
   flow and environmental data from Munich and W \& uuml;rzburg
   (2015-2021), we estimate hourly latent heat flux (LE) for two
   physiologically contrasting species, Tilia cordata and Robinia
   pseudoacacia, from shortwave radiation (Rs), air temperature (Ta), vapor
   pressure deficit (VPD), soil moisture content (theta), and day of year
   (DOY). All DL models outperform the Jarvis baseline, with M4 showing the
   best overall performance: test NSE 0.86 (0.90) and RMSE 11.43 (1.93) W/
   m2 for two species, while maintaining strong performance with limited
   training data. SHAP identifies modelderived species-specific response
   patterns consistent with known differences in hydraulic architecture,
   and diagnoses regimes where Jarvis assumptions underperform. This
   framework offers a practical pathway for embedding process knowledge
   into broader urban evapotranspiration and microclimate models.},
Publisher = {ACADEMIC PRESS LTD- ELSEVIER SCIENCE LTD},
Address = {24-28 OVAL RD, LONDON NW1 7DX, ENGLAND},
Type = {Article},
Language = {English},
