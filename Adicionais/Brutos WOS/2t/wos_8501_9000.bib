@article{ WOS:001573159600001,
Author = {Mai, Manling and Zhang, Dailuo and Ai, Bin and Tang, Rui and Wu,
   Lingling and Jian, Zhuokai},
Title = {How can future urban renewal achieve the goals of SDG 11? A scenario
   analysis considering the reconnection of fragmented ecological spaces},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {179},
Month = {OCT},
Abstract = {Rapid urbanization makes ecological spaces tend to be severely
   fragmented, posing challenges to preserve ecological security and green
   equality. While urban renewal offers opportunities to reset the pattern
   of ecological patches, current research has failed to effectively
   identify which patch exactly requires ecological restoration. This study
   innovatively simulated ecological restoration potential and explored how
   ecological networks can be generated through strategically reconnecting
   fragmented ecological space in dense built-up areas. Taking
   Guangdong-Hong Kong-Macao Greater Bay Area as an example area,
   ecological network under the urban renewal scenario was accordingly
   generated following landscape connectivity principles by integrating
   remote sensing imagery and large-scale renovation intention surveys, its
   contribution to the United Nations Sustainable Development Goal (SDG) 11
   was further discussed. Results indicate that the fragmented ecological
   spaces can be reconnected to more than 80 \% of the built-up areas,
   which is 60 \% higher than the connectivity of the ecological network
   simulated under the baseline scenario without spatial intervention.
   Potential ecological connectivity is significantly enhanced with a 29.8
   \% reduction in average path length and 16 additional direct links
   between core ecological areas. Moreover, corridor coverage per block
   increases from 1.889 \% to 10.081 \% (Gini index decreasing from 0.830
   to 0.650), while corridor availability within 2 km rises from 2.346 \%
   to 56.497 \% (Gini index decreasing from 0.986 to 0.719), both
   indicating that the ecological restoration strategy for urban renewal
   proves effective in mitigating spatial inequality. This study offers a
   decision-making framework for balancing ecological and construction
   spaces during urban renewal, advancing SDG 11 to ensure universal access
   to safe, inclusive green spaces. This study also offers a novel
   assessment of ecological gain by reshaping the connectivity between
   ecological patches during urban transformation.},
