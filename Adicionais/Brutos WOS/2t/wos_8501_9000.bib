@article{ WOS:001858072100001,
Author = {Zhang, Wenjing and Green, Mark A. and Mell, Ian and Wang, Ruoyu and
   Butters, Olly},
Title = {Has the situation changed? Spatio-temporal analysis of green spaces
   change and socioeconomic status in Liverpool, UK},
Journal = {PLANNING PRACTICE AND RESEARCH},
Year = {2026},
Month = {2026 AUG 22},
Abstract = {Although the benefits of green space to residents' wellbeing are well
   documented, more evidence is needed to track socio-spatial inequalities.
   This paper applied exploratory spatial data analysis and multiscale
   geographically weighted regression (MGWR) to analyse the relationship
   between green spaces and neighbourhood socioeconomic deprivation (NSD)
   in the Liverpool City Region (LCR) from 2010 to 2019. The analysis
   considers local praxis to illustrate variations in support for
   green-space investment. Results reveal persistent disparities despite
   policy efforts, while regeneration projects in deprived areas disrupted
   earlier patterns. These findings highlight the need for targeted
   interventions in deprived areas.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
