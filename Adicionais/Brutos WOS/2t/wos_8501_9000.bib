@article{ WOS:000383615200007,
Author = {Koubi, Vally and Stoll, Sebastian and Spilker, Gabriele},
Title = {Perceptions of environmental change and migration decisions},
Journal = {CLIMATIC CHANGE},
Year = {2016},
Volume = {138},
Number = {3-4},
Pages = {439-451},
Month = {OCT},
Abstract = {While climate change is projected to increase displacement of people,
   knowledge on this issue remains limited and fragmented. In his paper we
   focus on the micro-level and study the effects of individual perceptions
   of different types of environmental events (i.e., sudden/short-term vs.
   slow-onset/long-term) on migration decisions. Our results based on newly
   collected micro-level survey data from Vietnam shows that while
   slow-onset environmental events, such as droughs, significantly decrease
   the likelihood of migration, short-term events, such as floods, are
   positively related to migration, although not in a statistically
   significant way. When contrasting individual level perceptions with
   actual climatic events we observe that migrants and non-migrants
   perceive both long-term as well as sudden-onset environmental events in
   different ways. While non-migrants are slightly better in judging the
   actual extremeness of events such as floods and hurricanes, it is the
   migrants who are slightly better in judging the actual extremeness in
   the case of droughts.},
