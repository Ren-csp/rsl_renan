@article{ WOS:001845824900001,
Author = {Liu, Mengqi and Terada, Toru and Sioen, Giles B.},
Title = {Cumulative green inequality: an environmental justice typology of
   private green advantage and public park engagement},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {JUL 28},
Abstract = {Introduction Urban green spaces are widely recognized for enhancing
   human well-being and delivering co-benefits for both communities and the
   environment. In Chinese cities, gated communities have become the
   dominant form of residential development and often include collectively
   owned private green space. However, these semi-private green spaces
   (accessible only to residents and their guests) raise important justice
   questions. Therefore, we examine whether access to private community
   green spaces substitutes or complements public park engagement and
   construct an environmental justice typology based on private green
   advantage and perceived public park accessibility. Methods A
   cross-sectional survey of 1668 residents was conducted in Fuzhou and
   Guiyang, two second-tier provincial capital cities selected for their
   contrasting public park accessibility. We developed three composite
   indices to capture residents' objective and perceived green space use:
   Private Green Advantage, Public Park Engagement, and Perceived Public
   Accessibility. An environmental justice typology was constructed by
   cross-classifying respondents on Private Green Advantage and Perceived
   Public Accessibility. Complementarity was tested through correlation
   analysis, and spatial variation was examined at city and district
   levels. Results Findings reveal a consistent complementarity pattern.
   Residents with higher Private Green Advantage show greater public park
   engagement (r = 0.420, p < 0.001). The typology identified four
   population groups: Advantaged (29.5\%), Private-Reliant (17.1\%),
   Public-Reliant (18.3\%), and Disadvantaged (28.2\%). City-level patterns
   were similar despite stark differences in objective spatial
   accessibility between the two cities, while substantial district-level
   variation highlights the importance of local-scale analysis. Discussion
   These results indicate a cumulative pattern of green space inequality,
   consistent with cumulative advantage rather than compensatory
   distribution. The findings extend environmental justice scholarship on
   urban green space beyond distributive access, and imply that city
   planning should direct park investments towards residents experiencing
   dual disadvantages, as private and public green access are associated
   with complementarity rather than compensation across the population.},
