ISSN = {0733-9488},
EISSN = {1943-5444},
Keywords = {Air temperature distribution; Sky view factor (SVF); Correlation
   analysis; Green Singapore estate; Tropical climate},
Keywords-Plus = {URBAN HEAT-ISLAND; CANYON GEOMETRY; SURFACE-TEMPERATURE; DESIGN; STREET;
   MODEL; AREAS; CITY},
