@article{ WOS:A1997YE22400002,
Author = {Shoup, DC},
Title = {The high cost of free parking},
Journal = {JOURNAL OF PLANNING EDUCATION AND RESEARCH},
Year = {1997},
Volume = {17},
Number = {1},
Pages = {3-20},
Month = {FAL},
Abstract = {Urban planners typically set minimum parking requirements to meet the
   peak demand for parking at each land use, without considering either the
   price motorists pay for parking or the cost of providing the required
   parking spaces. By reducing the market price of parking, minimum parking
   requirements provide subsidies that innate parking demand, and this
   inflated demand is then used to set minimum parking requirements. When
   considered as an impact fee, minimum parking requirements can increase
   development costs by more than 10 times the impact fees for all other
   public purposes combined. Eliminating minimum parking requirements would
   reduce the cost of urban development, improve urban design, reduce
   automobile dependency, and restrain urban sprawl.},
