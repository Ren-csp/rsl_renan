@article{ WOS:000365275300001,
Author = {Seresinhe, Chanuki Illushka and Preis, Tobias and Moat, Helen Susannah},
Title = {Quantifying the Impact of Scenic Environments on Health},
Journal = {SCIENTIFIC REPORTS},
Year = {2015},
Volume = {5},
Month = {NOV 25},
Abstract = {Few people would deny an intuitive sense of increased wellbeing when
   spending time in beautiful locations. Here, we ask: can we quantify the
   relationship between environmental aesthetics and human health? We draw
   on data from Scenic-Or-Not, a website that crowdsources ratings of
   ``scenicness{''} for geotagged photographs across Great Britain, in
   combination with data on citizen-reported health from the Census for
   England and Wales. We find that inhabitants of more scenic environments
   report better health, across urban, suburban and rural areas, even when
   taking core socioeconomic indicators of deprivation into account, such
   as income, employment and access to services. Our results provide
   evidence in line with the striking hypothesis that the aesthetics of the
   environment may have quantifiable consequences for our wellbeing.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Seresinhe, CI (Corresponding Author), Univ Warwick, Data Sci Lab, Behav Sci, Warwick Business Sch, Coventry CV4 7AL, W Midlands, England.
   Seresinhe, Chanuki Illushka; Preis, Tobias; Moat, Helen Susannah, Univ Warwick, Data Sci Lab, Behav Sci, Warwick Business Sch, Coventry CV4 7AL, W Midlands, England.},
DOI = {10.1038/srep16899},
Article-Number = {16899},
