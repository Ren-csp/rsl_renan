@article{ WOS:001131585000001,
Author = {Hrehorowicz-Gaber, Hanna and Blazy, Rafal and Kusnierz-Krupa, Dominika
   and Blachut, Jakub and Lysien, Mariusz and Ciepiela, Agnieszka and
   Dudek, Jakub and Mamedov, Alirza and Sandu, Ioan Gabriel},
Title = {THE ISSUE OF ADAPTATION OF SELECTED HISTORIC EDUCATIONAL FACILITIES
   LOCATED IN THE AREA OF THE HISTORICAL URBAN LAYOUT OF KRAKOW},
Journal = {INTERNATIONAL JOURNAL OF CONSERVATION SCIENCE},
Year = {2023},
Volume = {14},
Number = {4},
Pages = {1507-1526},
Month = {OCT-DEC},
Abstract = {The article concerns the possibilities of adapting selected historic
   educational complexes (XX General Secondary School and Mechanical
   Technical Secondary School No. 15), located in the historical urban
   layout of the city of Krakow, for the purposes of implementing a
   scientific project entitled ``School of the future: modular and mobile
   Green Classroom system.{''} The work presents the research objectives,
   research methods, and general assumptions of the ``Green Classrooms{''}
   system as new educational spaces, which are to be a modular structure
   that meets both the educational and social-behavioural needs of children
   and adolescents. Selected school buildings were also analysed, taking
   into account their history, architectural and urban composition,
   conservation conditions, and those resulting from planning documents.
   The summary determines whether the selected facilities and the plots on
   which they are located can be adapted for the needs of the scientific
   project and the ``Green Classes{''} system.},
