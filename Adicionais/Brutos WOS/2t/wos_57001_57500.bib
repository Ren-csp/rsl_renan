@article{ WOS:001125281300016,
Author = {Bunch, Heeyoun and Kim, Deukyeong and Naganuma, Masahiro and Nakagawa,
   Reiko and Cong, Anh and Jeong, Jaehyeon and Ehara, Haruhiko and Vu,
