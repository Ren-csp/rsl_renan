@article{ WOS:001266702400025,
Author = {Kang, Hyunji and Han, Ah-reum and Zhang, Aihua and Jeong, Heejin and
   Koh, Wuhyun and Lee, Jung Moo and Lee, Hayeon and Jo, Hee Young and
   Maria-Solano, Miguel A. and Bhalla, Mridula and Kwon, Jea and Roh, Woo
