@article{ WOS:001740040300001,
Author = {Klassen, Hannah and Kenny, Tiff-Annie and Humphries, Murray and Kerr,
   Jeremy and Batal, Malek and Sadik, Tonio and Chan, Hing Man},
Title = {Linking biodiversity to traditional food access and nutrition among
   First Nations in Canada},
Journal = {FACETS},
Year = {2026},
Volume = {11},
Month = {APR 9},
Abstract = {Traditional foods are vital for maintaining nutritional quality among
   First Nations in Canada. Ecological biodiversity has been linked to
   human dietary quality. The objective of this study is to investigate the
   relationship between ecozone biodiversity and nutritional outcomes,
   specifically dietary diversity. Data from a cross-sectional study of 92
   First Nations communities in 11 ecozones across Canada were used to
   calculate indicators of dietary diversity and quality, and predictive
   variables. Biodiversity databases and scientific articles containing
   range maps were used to calculate ecological species richness as a
   biodiversity indicator. Spearman's correlations between dietary
   diversity and nutrition show that individuals who consume more
   traditional foods have more nutrient-rich diets, and dietary diversity
   is a good indicator of nutrition outcomes. Regression analyses show that
   ecological species richness was a negative factor, whereas variables
   related to culture and accessibility of traditional foods were positive
   factors in determining dietary diversity. Regional ecological gradients,
   urbanization, and agricultural development disrupt access to traditional
   foods, suggesting that the negative relationship between ecological
   species richness and dietary species richness is shaped more by
   ecological and anthropogenic patterns than by biodiversity. These
   results provide key insights for prioritizing interventions for
   promoting the nutritional health of First Nations in Canada.},
