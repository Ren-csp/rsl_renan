
@article{ WOS:001717390400003,
Author = {Xuan, Qi-Fan and Zhao, Pei-Yan and Peng, Hualong and Zhang, Shan and
   Cai, Bo and Niu, Fang-Yu and Koo, Martin C. and Sun, Xiao-Bo and Jiang,
