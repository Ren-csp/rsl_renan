@article{ WOS:000427477100027,
Author = {Bai, Lin and Wang, Tong and Zhao, Gongpu and Kovach, Amanda and Li,
   Huilin},
Title = {The atomic structure of a eukaryotic oligosaccharyltransferase complex},
