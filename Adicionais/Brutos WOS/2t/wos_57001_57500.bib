@article{ WOS:000548305900008,
Author = {Nguyen Trong Dan and Hoang Duc Quang and Vuong Van Truong and Do Huu
   Nghi and Nguyen Manh Cuong and To Dao Cuong and Tran Quoc Toan and Long
   Giang Bach and Nguyen Huu Thuan Anh and Nguyen Thi Mai and Ngo Thi Lan
   and Luu Van Chinh and Pham Minh Quan},
Title = {Design, synthesis, structure, in vitro cytotoxic activity evaluation and
   docking studies on target enzyme GSK-3β of new indirubin-3'-oxime
   derivatives},
Journal = {SCIENTIFIC REPORTS},
Year = {2020},
Volume = {10},
Number = {1},
Month = {JUL 10},
Abstract = {The addition of chalcone and amine components into indirubin-3 ` -oxime
   resulted in 15 new derivatives with high yields. Structures of new
   derivatives were also elucidated through 1D, 2D-NMR and HR-MS(ESI)
   spectra and X-ray crystallography. All designed compounds were screened
   for cytotoxic activity against four human cancer cell lines (HepG2,
   LU-1, SW480 and HL-60) and one human normal kidney cell line (HEK-293).
   Compound 6f exhibited the most marked cytotoxicity meanwhile
   cytotoxicity of compounds 6e, 6h and 6l was more profound toward cancer
   cell lines than toward normal cell. These new derivatives were further
   analyzed via molecular docking studies on GSK-3 beta enzyme. Docking
   analysis shows that most of the derivatives exhibited potential
   inhibition activity against GSK-3 beta with characteristic interacting
   residues in the binding site. The fast pulling of ligand scheme was then
   employed to refine the binding affinity and mechanism between ligands
   and GSK-3 beta enzyme. The computational results are expected to
   contribute to predicting enzyme target of the trial inhibitors and their
   possible interaction, from which the design of new cytotoxic agents
   could be created in the future.},
