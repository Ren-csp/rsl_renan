@article{ WOS:000613058000011,
Author = {Cohain, Ariella T. and Barrington, William T. and Jordan, Daniel M. and
   Beckmann, Noam D. and Argmann, Carmen A. and Houten, Sander M. and
   Charney, Alexander W. and Ermel, Raili and Sukhavasi, Katyayani and
   Franzen, Oscar and Koplev, Simon and Whatling, Carl and Belbin, Gillian
   M. and Yang, Jialiang and Hao, Ke and Kenny, Eimear E. and Tu, Zhidong
   and Zhu, Jun and Gan, Li-Ming and Do, Ron and Giannarelli, Chiara and
   Kovacic, Jason C. and Ruusalepp, Arno and Lusis, Aldons J. and
   Bjorkegren, Johan L. M. and Schadt, Eric E.},
Title = {An integrative multiomic network model links lipid metabolism to glucose
   regulation in coronary artery disease},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {JAN 22},
Abstract = {Elevated plasma cholesterol and type 2 diabetes (T2D) are associated
   with coronary artery disease (CAD). Individuals treated with
   cholesterol-lowering statins have increased T2D risk, while individuals
   with hypercholesterolemia have reduced T2D risk. We explore the
   relationship between lipid and glucose control by constructing network
   models from the STARNET study with sequencing data from seven
   cardiometabolic tissues obtained from CAD patients during coronary
   artery by-pass grafting surgery. By integrating gene expression,
   genotype, metabolomic, and clinical data, we identify a glucose and
   lipid determining (GLD) regulatory network showing inverse relationships
   with lipid and glucose traits. Master regulators of the GLD network also
   impact lipid and glucose levels in inverse directions. Experimental
   inhibition of one of the GLD network master regulators, lanosterol
   synthase (LSS), in mice confirms the inverse relationships to glucose
   and lipid levels as predicted by our model and provides mechanistic
   insights. Some cholesterol-lowering drugs can increase the risk of type
   2 diabetes, but the mechanism behind this is not fully understood. Here
   the authors show that there is a single genetic regulatory module that
   influences both cholesterol levels and glucose levels, providing a link
   between cholesterol levels and diabetes.},
