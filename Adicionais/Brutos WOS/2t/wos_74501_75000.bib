   Hofmann, Alexander; Mueller, Sophia; Berleth, Mareike; Groth, Georg, Heinrich Heine Univ, Inst Biochem Plant Physiol, D-40225 Dusseldorf, Germany.
   Drechsler, Thomas; Caesar, Katharina; Rohr, Leander; Harter, Klaus, Eberhard Karls Univ Tubingen, Ctr Plant Mol Biol ZMBP, D-72076 Tubingen, Germany.},
DOI = {10.3390/plants9030304},
Article-Number = {304},
ISSN = {2223-7747},
Keywords = {histidine kinase; osmosensing; membrane protein purification;
