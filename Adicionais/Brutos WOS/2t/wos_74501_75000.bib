@article{ WOS:001702064700001,
Author = {Sauli, Syaza Soraya and Isa, Farhana Mohammed and Kosnin, Azlina Mohd
   and Romice, Ombretta},
Title = {Nature-Based Learning in Malaysian Early Childhood Education: A
   Systematic Literature Review},
Journal = {INTERNATIONAL JOURNAL OF EARLY CHILDHOOD},
Year = {2026},
Volume = {58},
Number = {1},
Pages = {573-591},
Month = {APR},
Abstract = {Nature-based learning (NBL) has gained global recognition as a
   pedagogical approach that supports children's holistic development and
   fosters environmental stewardship. However, contributions from the
   Global South remain underrepresented, underscoring the need for a
   Malaysian-focused synthesis. This systematic literature review (SLR)
   examines fifteen empirical studies published between 2018 and 2025 on
   the integration of NBL in Malaysian early childhood education. A
   structured search across Scopus, ScienceDirect, ERIC, and Google Scholar
   guided the identification, screening, and eligibility assessment of
   studies. Findings reveal strong enthusiasm among teachers and parents,
   with reported benefits spanning cognitive, physical, social, and
   ecological domains. However, affective outcomes such as nature
   connection and sustainability values remain underexplored. NBL is often
   treated as an add-on rather than embedded within the national preschool
   curriculum, with implementation constrained by limited teacher training,
   insufficient resources, restricted access to natural spaces, and
   inadequate policy support. These findings reflect broader international
   debates on the marginalisation of outdoor learning and the challenges of
   integrating experiential pedagogies into standardised curricular
   systems. The review underscores the need for a structured, yet flexible
   NBL framework that aligns with curriculum objectives, evaluates both
   affective and cognitive outcomes, and is adaptable to diverse learning
   environments, including urban and indoor settings. Beyond Malaysia, this
   synthesis contributes to global early years environmental education
   scholarship by illustrating how NBL can be universal in principle yet
   context-specific in practice, with implications for theory, pedagogy,
   and policy reform.
   L'apprentissage fond \& eacute; sur la nature (Nature-Based Learning,
   NBL) a acquis une reconnaissance mondiale en tant qu'approche p \&
   eacute;dagogique favorisant le d \& eacute;veloppement holistique des
   enfants et la promotion de la responsabilit \& eacute; environnementale.
   Toutefois, les contributions provenant du Sud global demeurent sous-repr
   \& eacute;sent \& eacute;es, soulignant la n \& eacute;cessit \& eacute;
   d'une synth \& egrave;se centr \& eacute;e sur le contexte malaisien.
   Cette revue syst \& eacute;matique de la litt \& eacute;rature examine
   quinze \& eacute;tudes empiriques publi \& eacute;es entre 2018 et 2025
   portant sur l'int \& eacute;gration du NBL dans l'\& eacute;ducation pr
   \& eacute;scolaire en Malaisie. Une recherche structur \& eacute;e men
   \& eacute;e dans les bases de donn \& eacute;es Scopus, ScienceDirect,
   ERIC et Google Scholar a guid \& eacute; l'identification, le tri et
   l'\& eacute;valuation de l'\& eacute;ligibilit \& eacute; des \&
   eacute;tudes.Les r \& eacute;sultats r \& eacute;v \& egrave;lent un
   fort enthousiasme parmi les enseignants et les parents, avec des b \&
   eacute;n \& eacute;fices rapport \& eacute;s dans les domaines cognitif,
   physique, social et \& eacute;cologique. Toutefois, les dimensions
   affectives telles que la connexion \& agrave; la nature et les valeurs
   de durabilit \& eacute; demeurent peu explor \& eacute;es. Le NBL est
   souvent consid \& eacute;r \& eacute; comme un compl \& eacute;ment plut
   \& ocirc;t qu'int \& eacute;gr \& eacute;e au programme national pr \&
   eacute;scolaire, sa mise en oe uvre \& eacute;tant limit \& eacute;e par
   une formation insuffisante des enseignants, un manque de ressources, un
   acc \& egrave;s restreint aux espaces naturels et un soutien politique
   inad \& eacute;quat. Ces constats refl \& egrave;tent des d \&
   eacute;bats internationaux plus larges concernant la marginalisation de
   l'apprentissage en plein air et les d \& eacute;fis li \& eacute;s \&
   agrave; l'int \& eacute;gration de p \& eacute;dagogies exp \&
   eacute;rientielles dans des syst \& egrave;mes curriculaires standardis
   \& eacute;s.Cette revue souligne la n \& eacute;cessit \& eacute; d'un
   cadre structur \& eacute; mais flexible du NBL, align \& eacute; sur les
   objectifs curriculaires, \& eacute;valuant \& agrave; la fois les r \&
   eacute;sultats affectifs et cognitifs, et adaptable \& agrave; divers
   environnements d'apprentissage, y compris urbains et int \&
   eacute;rieurs. Au-del \& agrave; du contexte malaisien, cette synth \&
   egrave;se contribue aux recherches internationales sur l'\&
   eacute;ducation environnementale de la petite enfance en montrant que le
   NBL peut \& ecirc;tre universel dans ses principes tout en restant
   contextuellement sp \& eacute;cifique dans sa mise en oe uvre, avec des
   implications pour la th \& eacute;orie, la p \& eacute;dagogie et les r
   \& eacute;formes politiques.
   El aprendizaje basado en la naturaleza (Nature-Based Learning, NBL) ha
   ganado reconocimiento mundial como un enfoque pedag \& oacute;gico que
   promueve el desarrollo integral de los ni \& ntilde;os y fomenta la
   responsabilidad ambiental. Sin embargo, las contribuciones del Sur
   Global siguen estando subrepresentadas, lo que subraya la necesidad de
   una s \& iacute;ntesis centrada en el contexto malasio. Esta revisi \&
   oacute;n sistem \& aacute;tica de la literatura examina quince estudios
   emp \& iacute;ricos publicados entre 2018 y 2025 sobre la integraci \&
   oacute;n del NBL en la educaci \& oacute;n infantil en Malasia. Una b \&
   uacute;squeda estructurada en las bases de datos Scopus, ScienceDirect,
   ERIC y Google Scholar gui \& oacute; la identificaci \& oacute;n, el
   cribado y la evaluaci \& oacute;n de la elegibilidad de los estudios.Los
   hallazgos revelan un fuerte entusiasmo entre docentes y padres, con
   beneficios reportados en los \& aacute;mbitos cognitivo, f \&
   iacute;sico, social y ecol \& oacute;gico. No obstante, los resultados
   afectivos, como la conexi \& oacute;n con la naturaleza y los valores de
   sostenibilidad, siguen estando poco explorados. El NBL suele
   considerarse un complemento y no una parte integrada del curr \&
   iacute;culo nacional preescolar, y su implementaci \& oacute;n se ve
   limitada por la escasa formaci \& oacute;n docente, la insuficiencia de
   recursos, el acceso restringido a espacios naturales y el apoyo pol \&
   iacute;tico inadecuado. Estos hallazgos reflejan debates internacionales
   m \& aacute;s amplios sobre la marginaci \& oacute;n del aprendizaje al
   aire libre y los desaf \& iacute;os de integrar pedagog \& iacute;as
   experienciales en sistemas curriculares estandarizados.La revisi \&
   oacute;n subraya la necesidad de un marco estructurado pero flexible de
   NBL que se alinee con los objetivos curriculares, eval \& uacute;e tanto
   los resultados afectivos como cognitivos y sea adaptable a diversos
   entornos de aprendizaje, incluidos contextos urbanos e interiores. M \&
   aacute;s all \& aacute; de Malasia, esta s \& iacute;ntesis contribuye
   al campo internacional de la educaci \& oacute;n ambiental en la primera
   infancia al demostrar que el NBL puede ser universal en principio, pero
   espec \& iacute;fico al contexto en la pr \& aacute;ctica, con
   implicaciones para la teor \& iacute;a, la pedagog \& iacute;a y la
   reforma de pol \& iacute;ticas.},
Publisher = {SPRINGER},
