   and Prieto, Adriana and Ramirez-Angulo, Hirma and ter Steege, Hans and
   Vilanova, Emilio and Feldpausch, Ted R.},
Title = {Does soil pyrogenic carbon determine plant functional traits in Amazon
   Basin forests?},
Journal = {PLANT ECOLOGY},
