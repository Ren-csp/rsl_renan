@article{ WOS:000170684700001,
Author = {Wille, M and Hooghiemstra, H and Behling, H and van der Borg, K and
   Negret, AJ},
Title = {Environmental change in the Colombian subandean forest belt from 8
   pollen records: the last 50 kyr},
Journal = {VEGETATION HISTORY AND ARCHAEOBOTANY},
Year = {2001},
Volume = {10},
Number = {2},
Pages = {61-77},
Month = {JUL},
Abstract = {We present a reconstruction of forest history and climatic change based
   on I I pollen records from eight sites, all located in the lower montane
   forest belt of the northern Andes in Colombia. We compared records from
   the Popayan area in southern Colombia, Timbio (1750 m), Genagra (1750
   in) and Pitalito (1300 in) and the new Piagua (1700 in) record with the
   records from Lusitania (1500 in), Libano (1820 in), Pedro Palo (2000 in)
   and Ubaque (2000 in) from central Colombia. The changes of the
   altitudinal position of the lower/upper montane (= subandean/Andean,
   S/At) forest belt transition were used to estimate temperature change
   for the last 50 kyr. We infer a Last Glacial Maximum (LGM) temperature
   drop of 6 degrees -7 degreesC at 1700 in, and a steeper LGM lapse rate
   of 0.76 degreesC/100 in compared to today (ca. 0.6 degreesC/100 in).
   Around 50 uncal. kyr B.P. the temperature at 1700 in was ca. 3 degreesC
   lower than today. Until 20 uncal. kyr B.P. the temperature oscillated
   and gradually decreased. During the LGM, temperature was down to ca. 6
   degrees -7 degreesC lower than today. After the LGM, temperature
   increased and ca. 14 uncal. kyr B.P. it was 2 degrees -3 degreesC lower
   than today (S/At at ca. 1800 in, 500 in below present elevation; Susaca
   interstadial). An unquantified cooling (Ciega stadial) followed. During
   ca. 12.3-11.7 uncal. kyr B.P. the S/At shifted upslope to 2100 in
   indicating a temperature of 1 degrees -2 degreesC cooler than today
   (Guantiva interstadial). From 11.7-10.9 uncal. kyr B.P. the S/At was at
   1800 in indicating that the temperature was ca. 3 degreesC lower than
   today and wet conditions prevailed (partly coinciding with the El Abra
   stadial). The period 10.9-9 uncal. kyr B.P. was also cool, but drier.
   During 9-7.5 uncal. kyr B.P. temperature was ca. 1 degreesC warmer
   relative to today (mid Holocene hypsithermal). During the last 5 kyr the
   presence of cultivated plants demonstates human colonization of the
   lower montane zone in Colombia.},
