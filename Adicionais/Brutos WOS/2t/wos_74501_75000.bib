@article{ WOS:000862764800001,
Author = {Nash, Sarah H. and Dilley, Julia and Siekaniec, Claire and O'Brien,
   David and Avila, Rosa and Quinn, Jessica},
Title = {Needs assessment of cancer survivors in Alaska},
Journal = {CANCER CAUSES \& CONTROL},
