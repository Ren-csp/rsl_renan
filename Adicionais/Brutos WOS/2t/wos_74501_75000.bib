@article{ WOS:000804279300001,
Author = {O'Keefe, Victoria M. and Fish, Jillian and Maudrie, Tara L. and Hunter,
   Amanda M. and Rakena, Hariata G. Tai and Ullrich, Jessica Sanigaq and
   Clifford, Carrie and Crawford, Allison and Brockie, Teresa and Walls,
   Melissa and Haroz, Emily E. and Cwik, Mary and Whitesell, Nancy Rumbaugh
   and Barlow, Allison},
Title = {Centering Indigenous Knowledges and Worldviews: Applying the Indigenist
   Ecological Systems Model to Youth Mental Health and Wellness Research
   and Programs},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {10},
Month = {MAY},
Abstract = {Globally, Indigenous communities, leaders, mental health providers, and
   scholars have called for strengths-based approaches to mental health
   that align with Indigenous and holistic concepts of health and wellness.
   We applied the Indigenist Ecological Systems Model to strengths-based
   case examples of Indigenous youth mental health and wellness work
   occurring in CANZUS (Canada, Australia, New Zealand, and United States).
   The case examples include research, community-led programs, and national
   advocacy. Indigenous youth development and well-being occur through
   strengths-based relationships across interconnected environmental
   levels. This approach promotes Indigenous youth and communities
   considering complete ecologies of Indigenous youth to foster their whole
   health, including mental health. Future research and programming will
   benefit from understanding and identifying common, strengths-based
   solutions beyond narrow intervention targets. This approach not only
   promotes Indigenous youth health and mental health, but ripples out
   across the entire ecosystem to promote community well-being.},
