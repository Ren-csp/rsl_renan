@article{ WOS:000690135700001,
Author = {Bianco, Giovanni and Bonvini, Barbara and Bracco, Stefano and Delfino,
   Federico and Laiolo, Paola and Piazza, Giorgio},
Title = {Key Performance Indicators for an Energy Community Based on Sustainable
   Technologies},
