@article{ WOS:001590947900001,
Author = {Henry, Theodore B. and Bucknall, David G. and Catarino, Ana I. and
   Gillanders, Bronwyn M. and Haave, Marte and Kaminski, Norbert E. and
   Volker, Carolin and Wootton, Nina},
Title = {Examining Misconceptions about Plastic-Particle Exposure from Ingestion
   of Seafood and Risk to Human Health},
