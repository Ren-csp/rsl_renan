@article{ WOS:000406298000004,
Author = {Almeida, Ricardo M. S. F. and Pinto, Manuel and Pinho, Paulo G. and de
   Lemos, Luis T.},
Title = {Natural ventilation and indoor air quality in educational buildings:
   experimental assessment and improvement strategies},
