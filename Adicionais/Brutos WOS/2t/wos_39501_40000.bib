@article{ WOS:000210957500003,
Author = {Klooger, Jeffrey},
Title = {INTERPRETATION AND BEING},
Journal = {THESIS ELEVEN},
Year = {2005},
Volume = {83},
Number = {1},
Pages = {15-24},
Month = {NOV},
Abstract = {Despite Castoriadis's animosity towards the idea that his work has
   anything to do with hermeneutics, it does. In this article I endeavor to
   expose the hermeneutical dimension inherent to Castoriadis's work and to
   explore some of the hermeneutical problems which his work opens up. This
   leads me into discussions of such matters as the relationship between
   the stratification of Being and its exploration, the nature of
   ensemblization and the ensidic dimension of Being, and the nature and
   significance of determination in the human and particularly the
   social-historical realm.},
