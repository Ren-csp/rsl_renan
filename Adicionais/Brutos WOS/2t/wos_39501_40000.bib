@article{ WOS:001671999600004,
Author = {Garcia B., Magdalena and Escobar-Maldonado, Manuel and Diaz, Francisca
   P. and Biskupovic, Consuelo and Gonzalez-Diaz, Soledad and Mcrostie,
   Virginia},
Title = {The Tamarugal of Atacama. Memories and Practices of Connecting with a
   Historically Threatened Forest},
Journal = {ESTUDIOS ATACAMENOS},
Year = {2025},
Number = {71},
Abstract = {This article analyzes the historical and contemporary relationships that
   the inhabitants of the Pampa del Tamarugal (Tarapac \& aacute;, Chile)
   have built with the endemic tamarugo forest (Strombocarpa tamarugo) in
   the Atacama Desert. territory has been subjected to continuous
   commercial exploitation since early colonial times, which now threatens
   continuity and the associated ways of life. Working from an ethnographic
   perspective with different groups of mestizo peasant, Aymara Indigenous,
   and urban migrant backgrounds in La Huayca and the Pampa del Tamarugal
   National Reserve, we characterize their practices, discourses, and
   social imaginaries surrounding the forest, as well as its current
   situation. The results reveal that the sociocultural particularities of
   these groups influence their relationships with trees, leading to
   certain disagreements among them but also shared diagnoses about the
   current threats, such logging and overexploitation of the Tamarugal
   aquifer. We conclude that local ways of life have developed alongside
   the trees rather than apart from them, which given the current water and
   environmental crisisdemands overcoming fictitious nature-culture
   dichotomy reproduced by institutional frameworks and recognizing local
   inhabitants as active agents in management and-making processes.},
