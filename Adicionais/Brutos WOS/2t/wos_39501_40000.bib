@article{ WOS:001125688700001,
Author = {Adeyeri, Oluwafemi E. and Folorunsho, Akinleye H. and Ayegbusi, Kayode
   I. and Bobde, Vishal and Adeliyi, Tolulope E. and Ndehedehe, Christopher
   E. and Akinsanola, Akintomide A.},
Title = {Land surface dynamics and meteorological forcings modulate land surface
   temperature characteristics},
