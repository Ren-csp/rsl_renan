@article{ WOS:000915604400001,
Author = {Zhang, Feiyan and Gao, Yonggang},
Title = {Composite extraction index to enhance impervious surface information in
   remotely sensed imagery},
Journal = {EGYPTIAN JOURNAL OF REMOTE SENSING AND SPACE SCIENCES},
Year = {2023},
Volume = {26},
