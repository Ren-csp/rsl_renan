@article{ WOS:000436656500002,
Author = {Bies, Angela L. and Lee, Deanna G. and Lindsey, Charles and
   Stoutenborough, James W. and Vedlitz, Arnold},
Title = {Citizens, Nonprofits and Climate Change Policy},
