@article{ WOS:001074472200010,
Author = {Li, Jun and Hubisz, Melissa J. and Earlie, Ethan M. and Duran, Mercedes
   A. and Hong, Christy and Varela, Austin A. and Lettera, Emanuele and
   Deyell, Matthew and Tavora, Bernardo and Havel, Jonathan J. and Phyu, Su
   M. and Amin, Amit Dipak and Budre, Karolina and Kamiya, Erina and
   Cavallo, Julie-Ann and Garris, Christopher and Powell, Simon and
   Reis-Filho, Jorge S. and Wen, Hannah and Bettigole, Sarah and Khan, Atif
   J. and Izar, Benjamin and Parkes, Eileen E. and Laughney, Ashley M. and
   Bakhoum, Samuel F.},
Title = {Non-cell-autonomous cancer progression from chromosomal instability},
Journal = {NATURE},
Year = {2023},
Volume = {620},
Number = {7976},
Month = {AUG 31},
Abstract = {Chromosomal instability (CIN) is a driver of cancer metastasis(1-4), yet
   the extent to which this effect depends on the immune system remains
   unknown. Using ContactTracing-a newly developed, validated and
   benchmarked tool to infer the nature and conditional dependence of
   cell-cell interactions from single-cell transcriptomic data-we show that
   CIN-induced chronic activation of the cGAS-STING pathway promotes
   downstream signal re-wiring in cancer cells, leading to a pro-metastatic
   tumour microenvironment. This re-wiring is manifested by type I
   interferon tachyphylaxis selectively downstream of STING and a
   corresponding increase in cancer cell-derived endoplasmic reticulum (ER)
   stress response. Reversal of CIN, depletion of cancer cell STING or
   inhibition of ER stress response signalling abrogates CIN-dependent
   effects on the tumour microenvironment and suppresses metastasis in
   immune competent, but not severely immune compromised, settings.
   Treatment with STING inhibitors reduces CIN-driven metastasis in
   melanoma, breast and colorectal cancers in a manner dependent on tumour
   cell-intrinsic STING. Finally, we show that CIN and pervasive cGAS
   activation in micronuclei are associated with ER stress signalling,
   immune suppression and metastasis in human triple-negative breast
   cancer, highlighting a viable strategy to identify and therapeutically
   intervene in tumours spurred by CIN-induced inflammation.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
