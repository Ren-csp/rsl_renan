@article{ WOS:A1978FU09500002,
Author = {ANDRZEJEWSKI, R and BABINSKAWERKA, J and GLIWICZ, J and GOSZCZYNSKI, J},
Title = {SYNURBIZATION PROCESSES IN POPULATION OF APODEMUS-AGRARIUS .1.
   CHARACTERISTICS OF POPULATIONS IN AN URBANIZATION GRADIENT},
Journal = {ACTA THERIOLOGICA},
Year = {1978},
Volume = {23},
Number = {19-3},
Pages = {341-358},
Abstract = {Rodent communities and a population of A. agrarius (Pallas, 1971),
   subjected to different degrees of urbanization were studied. A park in
   the center of a city, a suburban tree stand and woods outside the
   suburbs were selected sites. Differences in the composition and variety
   of the rodent community and in the structure and population processes of
   the field mouse, were: age structure, sex structure, weight of adult
   individuals, maturation rate of females, length of the reproduction
   season and survival of the population during winter. The different
   pressure of the rodent community (which becomes increasingly
   impoverished along the urbanization gradient) and environmental factors
   specific to urban areas are discussed as reasons for the changes in the
   field mouse population.},
