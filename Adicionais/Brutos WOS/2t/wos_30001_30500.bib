@article{ WOS:000770515300001,
Author = {Giri, Sandip and Daw, Tim M. and Hazra, Sugata and Troell, Max and
   Samanta, Sourav and Basu, Oindrila and Marcinko, Charlotte L. J. and
   Chanda, Abhra},
Title = {Economic incentives drive the conversion of agriculture to aquaculture
   in the Indian Sundarbans: Livelihood and environmental implications of
   different aquaculture types},
Journal = {AMBIO},
Year = {2022},
Volume = {51},
Number = {9},
Pages = {1963-1977},
Month = {SEP},
Abstract = {Expansion of aquaculture in the Sundarbans Biosphere Reserve (SBR) is
   irreversibly replacing agricultural land and the drivers of this change
   are disputed. Based on in-depth interviews with 67 aquaculture farmers,
   this paper characterizes major aquaculture types in the SBR, their
   impacts, and identifies drivers of conversion from agricultural land.
   Aquaculture types included traditional, improved-traditional,
   modified-extensive, and semi-intensive systems. Extensive capture of
   wild shrimp larvae is environmentally harmful but constitutes an
   important livelihood. Semi-intensive aquaculture of exotic shrimp
   (Litopenaeus vannamei) has much higher unit-area profitability than
   other types but involves greater financial risk. Profitability is the
   main driver for the transition from agriculture, but environmental
   factors such as lowered crop yields and cyclone impacts also
   contributed. Many conversions from agriculture to aquaculture are
   illegal according to the stakeholders. Existing legislation, if
   enforced, could halt the loss of agriculture, while the promotion of
   improved-traditional aquaculture could reduce the demand for wild seed.},
Publisher = {SPRINGER},
Address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Giri, S (Corresponding Author), Jadavpur Univ, Sch Oceanog Studies, 188 Raja SC Mullick Rd, Kolkata 700032, W Bengal, India.
   Giri, Sandip; Hazra, Sugata; Samanta, Sourav; Basu, Oindrila; Chanda, Abhra, Jadavpur Univ, Sch Oceanog Studies, 188 Raja SC Mullick Rd, Kolkata 700032, W Bengal, India.
