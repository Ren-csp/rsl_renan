@article{ WOS:001522491700001,
Author = {Katrien, De Wolf and Nele, Verstraelen and Henri, Rommel and Pieter,
   Vantieghem and Bram, Vanthournout and Dries, Bonte},
Title = {Urbanization imposes declines in flying insect biomass through the loss
   of large-bodied species},
Journal = {INSECT CONSERVATION AND DIVERSITY},
Year = {2025},
Volume = {18},
Number = {6},
Pages = {1175-1183},
Month = {NOV},
Abstract = {Arthropods are in strong decline, with increased urbanization suggested
   as one of the major drivers. A decline in particularly large-bodied
   insects has been proposed as a bottom-up driver negatively affecting
   higher trophic levels. We used a space-for-time substitution approach to
   test how urbanization at multiple spatial scales affects species
   composition, functional diversity and biomass of aerial-active
   arthropods. We quantified community and biomass changes along a
   replicated, nested rural-urban gradient in northern Belgium. Arthropods
   were captured with sticky traps installed in 81 gardens during the
   summer. High levels of urbanization at small spatial scales halved
   arthropod abundance and biomass, and reduced functional diversity by
   25\%. However, at the landscape scale, the lowest biomass was recorded
   at an intermediate urbanization level. Arthropod biomass was estimated
   to be twice as high in low compared to highly urbanized local sites.
   Arthropod communities in highly urbanized local sites were characterised
   by a higher proportion of small-bodied Hemiptera (aphids) and a marked
   decline in large-bodied Diptera. Our study provides further evidence of
   the detrimental impact of land-use changes through urbanization on
   insect diversity and biomass, but also pinpoints that these changes are
   biased towards larger species. Such differential losses were most
   pronounced at the smallest spatial scales, suggesting that small-scale
   greening efforts, including the establishment of gardens and parks with
   structurally heterogeneous vegetation and sufficient cover, may help
   mitigate cascading effects within urban food webs.},
