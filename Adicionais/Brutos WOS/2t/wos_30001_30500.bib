@article{ WOS:000301332900026,
Author = {Barott, Katie L. and Rodriguez-Mueller, Beltran and Youle, Merry and
   Marhaver, Kristen L. and Vermeij, Mark J. A. and Smith, Jennifer E. and
   Rohwer, Forest L.},
Title = {Microbial to reef scale interactions between the reef-building coral
   Montastraea annularis and benthic algae},
