@article{ WOS:000530024600007,
Author = {Dorrity, Michael W. and Saunders, Lauren M. and Queitsch, Christine and
   Fields, Stanley and Trapnell, Cole},
Title = {Dimensionality reduction by UMAP to visualize physical and genetic
   interactions},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {MAR 24},
Abstract = {Dimensionality reduction is often used to visualize complex expression
   profiling data. Here, we use the Uniform Manifold Approximation and
   Projection (UMAP) method on published transcript profiles of 1484 single
   gene deletions of Saccharomyces cerevisiae. Proximity in low-dimensional
   UMAP space identifies groups of genes that correspond to protein
   complexes and pathways, and finds novel protein interactions, even
   within well-characterized complexes. This approach is more sensitive
   than previous methods and should be broadly useful as additional
   transcriptome datasets become available for other organisms.},
