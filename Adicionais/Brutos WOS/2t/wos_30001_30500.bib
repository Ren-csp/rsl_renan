@article{ WOS:000656276300002,
Author = {Rasmussen, Jacob A. and Villumsen, Kasper R. and Duchene, David A. and
   Puetz, Lara C. and Delmont, Tom O. and Sveier, Harald and Jorgensen,
   Louise von Gersdorff and Praebel, Kim and Martin, Michael D. and
   Bojesen, Anders M. and Gilbert, M. Thomas P. and Kristiansen, Karsten
   and Limborg, Morten T.},
Title = {Genome-resolved metagenomics suggests a mutualistic relationship between
   Mycoplasma and salmonid hosts},
Journal = {COMMUNICATIONS BIOLOGY},
Year = {2021},
Volume = {4},
Number = {1},
Month = {MAY 14},
Abstract = {Salmonids are important sources of protein for a large proportion of the
   human population. Mycoplasma species are a major constituent of the gut
   microbiota of salmonids, often representing the majority of microbiota.
   Despite the frequent reported dominance of salmonid-related Mycoplasma
   species, little is known about the phylogenomic placement, functions and
   potential evolutionary relationships with their salmonid hosts. In this
   study, we utilise 2.9 billion metagenomic reads generated from 12
   samples from three different salmonid host species to I) characterise
   and curate the first metagenome-assembled genomes (MAGs) of Mycoplasma
   dominating the intestines of three different salmonid species, II)
   establish the phylogeny of these salmonid candidate Mycoplasma species,
   III) perform a comprehensive pangenomic analysis of Mycoplasma, IV)
   decipher the putative functionalities of the salmonid MAGs and reveal
   specific functions expected to benefit the host. Our data provide a
   basis for future studies examining the composition and function of the
   salmonid microbiota. Jacob Rasmussen et al. use metagenomic analyses to
   examine the diversity of Mycoplasma species among three commonly-fished
   species of salmonids. Their results establish a phylogeny of candidate
   salmonid related Mycoplasma species and suggest a mutualistic
   relationship between these microbial species and salmon hosts.},
