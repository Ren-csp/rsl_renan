@article{ WOS:001271452900001,
Author = {Reiter, Rosina Marquez and Manrique, Elizabeth},
Title = {Keeping the pitch on track: spatiotemporal challenges in ambulant
   vending on a Buenos Aires trainline},
Journal = {MULTILINGUA-JOURNAL OF CROSS-CULTURAL AND INTERLANGUAGE COMMUNICATION},
Year = {2024},
Volume = {43},
Number = {5},
Pages = {601-636},
Month = {SEP 25},
Abstract = {This article examines ambulant vendors' labour on a Buenos Aires
   trainline. It explores how vendors employ a range of verbal and embodied
   resources to navigate the challenges of sustaining attention from
   commuters and manage the progressivity of their sales pitch as they
   achieve individual service encounters and deal with physical
   obstructions intrinsic to the local ecology of the train and the
   contingencies of earning a livelihood on the move. An interactional
   pragmatics analysis of vendors' working practices as video-recorded by
   them coupled with ethnographic observations, reveals the complex
   interplay of verbal and embodied cues, spatial arrangements, and
   temporal constraints in relation to the progressivity of their sales
   pitch. The findings challenge long-held negative views of vendors'
   presence in public space by highlighting the methodical approach,
   dexterity, and civility of their working practices, and how their labour
   fills a gap in the market. The article provides new insights into the
   dynamics of urban labour in public spaces and the intrinsicality of
   multimodality to manoeuvre round the unequal conditions these workers
   inhabit.
   Este art \& iacute;culo examina el trabajo de les vendedores ambulantes
   en un tren de Buenos Aires. Explora c \& oacute;mo les vendedores
   emplean una serie de recursos verbales y corporales para navegar el reto
   de llamar y mantener la atenci \& oacute;n de les pasajeres y gestionar
   la progresividad de su discurso de venta a medida que logran establecer
   interacciones de servicio, y lidian con obst \& aacute;culos f \&
   iacute;sicos intr \& iacute;nsecos a la ecolog \& iacute;a local del
   tren y a las contingencias de ganarse la vida en movimiento. Un an \&
   aacute;lisis pragm \& aacute;tico de corte interaccional de las pr \&
   aacute;cticas laborales de les vendedores, grabadas en v \& iacute;deo
   por elles mismes y acompa \& ntilde;adas de observaciones etnogr \&
   aacute;ficas, revela la compleja interacci \& oacute;n de los recursos
   verbales y corporales empleados respecto a las disposiciones espaciales
   y a las limitaciones temporales en relaci \& oacute;n con la
   progresividad del discurso de venta. Los resultados desaf \& iacute;an
   opiniones negativas respecto a la presencia de estes trabajadores en el
   espacio p \& uacute;blico, al poner de relieve la organizaci \&
   oacute;n, destreza y civilidad de sus pr \& aacute;cticas laborales, y c
   \& oacute;mo su trabajo llena un vac \& iacute;o en el mercado. El art
   \& iacute;culo aporta nuevas perspectivas sobre la din \& aacute;mica
   del trabajo urbano en espacio p \& uacute;blico y la intrinsicalidad de
   la multimodalidad para maniobrar las condiciones de desigualdad en que
   viven estes trabajadores.},
