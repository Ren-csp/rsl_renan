@article{ WOS:000509677400014,
Author = {Seward, Michael W. and Goldman, Roberta E. and Linakis, Stephanie K. and
   Werth, Paul and Roberto, Christina A. and Block, Jason P.},
Title = {Showers, Culture, and Conflict Resolution: A Qualitative Study of
   Employees' Perceptions of Workplace Wellness Opportunities},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
