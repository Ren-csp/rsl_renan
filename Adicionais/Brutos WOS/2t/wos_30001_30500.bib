@article{ WOS:001040551400009,
Author = {Rompala, Gregory L. and Nagamatsu, Sheila T. and Martinez-Magana, Jose
   Jaime and Nunez-Rios, Diana L. and Wang, Jiawei and Girgenti, Matthew J.
