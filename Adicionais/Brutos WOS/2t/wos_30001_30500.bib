@article{ WOS:000424382600058,
Author = {Sen, G. and Genc, A.},
Title = {PERCEPTIONS AND EXPECTATIONS ON FOREST MANAGEMENT CERTIFICATION OF
   FORESTERS IN STATE FOREST ENTERPRISES: A CASE STUDY IN TURKEY},
