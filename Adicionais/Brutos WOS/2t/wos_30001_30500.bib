@article{ WOS:001844019000001,
Author = {Li, Jiaan and Luo, Jianbiao and Liu, Qi and Bonebrake, Timothy C. and
   Yan, Chunhua and Xing, Shuang},
Title = {Impacts of land cover and public perception on butterfly records across
   a subtropical megacity},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2026},
Volume = {70},
Month = {OCT},
Abstract = {Urbanization affects biodiversity through the alteration of landscapes
   leading to a restructuring of species composition. Ecologically informed
   planning, combined with community science participation and
   contributions, can help promote and sustain urban biodiversity.
   Community science is an emerging approach that facilitates the
   documentation of species occurrence while also engaging the public in
   the monitoring and conservation of urban biodiversity. Charismatic and
   diverse animal groups, such as butterflies, are popular in community
   science, offering opportunities to explore how landscape features and
   public perceptions interact to influence urban biodiversity patterns
   recorded through community science. In this study, we integrated land
   cover information, species occurrence data, and public perceptions of
   urban butterfly species in the subtropical megacity of Shenzhen. We
   investigated how landscape features affect butterfly composition and
   distribution, and explored whether and how public perception influences
   the recorded distribution of urban butterfly species across various
   urban landscape types. Our findings indicate that 1) different landscape
   types support distinct butterfly assemblages; 2) butterflies with higher
   aesthetic values, such as vibrant colors and patterns, tend to be
   reported by a larger number of observers; 3) common species were more
   frequently recorded in urban landscapes with greater forest cover,
   regardless of public preference. These results underscore the importance
   of integrating both ecological data and social insights to develop
   practical, biodiversity-friendly urban planning strategies. By aligning
   conservation goals with public engagement, we can better support urban
   biodiversity through informed design and community involvement.},
