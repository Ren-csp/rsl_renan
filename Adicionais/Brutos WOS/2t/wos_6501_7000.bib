@article{ WOS:001232005100004,
Author = {Eser, Uta},
Title = {views on drives reflect ideas about humans and nature},
Journal = {GAIA-ECOLOGICAL PERSPECTIVES FOR SCIENCE AND SOCIETY},
Year = {2024},
Volume = {33},
Number = {1},
Pages = {170-174},
Abstract = {What concepts of nature, humans, and their relationships underpin the
   debate about gene drives for conservation? To provide some answers to
   this question, the eradication of invasive rodents on islands is used as
   an example. While current debates mostly weigh the potential benefits
   for conservation against the potential ecological risks, it is
   worthwhile to move beyond such a risk -benefit perspective. Ethical
   issues that are more specific to conservation are: the significance of
   ``natural{''}, the normative goals of conservation, and the ideal of
   living in harmony with nature.},
Publisher = {OEKOM VERLAG GMBH},
Address = {WALTHERSTR 29, MUNICH, 80337, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Eser, U (Corresponding Author), Bur Umweltethik, Tubingen, Germany.
   Eser, Uta, Bur Umweltethik, Tubingen, Germany.},
DOI = {10.14512/gaia.33.1.10},
ISSN = {0940-5550},
EISSN = {2625-5413},
Keywords = {conservation; environmental ethics; gene drives; invasive species;
   philosophy of nature; responsibility},
Keywords-Plus = {GENE DRIVES; CONSERVATION},
Research-Areas = {Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Environmental Sciences; Environmental Studies},
Author-Email = {info@umweltethikbuero.de},
ORCID-Numbers = {Eser, Uta/0000-0003-2162-1108},
Funding-Acknowledgement = {VolkswagenStiftung},
Funding-Text = {Acknowledgements: My sincere thanks go to Tina Heger and Rosine Kelz for
