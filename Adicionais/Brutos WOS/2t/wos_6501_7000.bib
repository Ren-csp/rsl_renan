@article{ WOS:001779756100001,
Author = {Reyes-Riveros, R. and Altamirano, A. and de la Barrera, F. and
   Rozas-Vasquez, D. and Vieli, L. and Fernandez-Urrutia, C. and
   Martinez-Retureta, R. and Meli, P.},
Title = {Indexing the contribution of public urban green spaces to human
   well-being},
Journal = {ECOLOGICAL INDICATORS},
Year = {2026},
Volume = {187},
Month = {JUN},
Abstract = {Urban green spaces (UGS) are essential for human well-being in cities,
   yet their contributions are rarely assessed with spatial precision and
   contextual relevance. We developed the Potential Green Well-being Index
   (PGWI), a spatially explicit and expert-weighted tool applied to 96
   public urban green spaces (PUGS) in Temuco, Chile. The PGWI evaluates
   structural, biodiversity, and naturalness features across four
   well-being dimensions: health, security, good social relations, and
   freedom of choice and action. Results show that structural attributes
   (vegetated area, vegetation stratification, and presence of equipment)
   consistently received the highest weights from experts, while
   biodiversity and naturalness were weighted lower. PGWI scores varied
   widely across the city: 52\% of PUGS scored high and 13\% very high,
   while 35\% were medium and only a few were low. Some small and
   medium-sized PUGS achieved high scores, illustrating that high-quality
   design can compensate for limited size. Conversely, several large PUGS
   scored poorly, underscoring that size alone does not ensure well-being
   potential. These findings position PGWI as a replicable and
   equity-sensitive tool for urban green space planning and monitoring,
   aligned with SDG 11.7.},
