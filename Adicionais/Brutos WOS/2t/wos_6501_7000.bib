@article{ WOS:000594383200008,
Author = {Jarosinska, Elzbieta and Golda, Klaudia},
Title = {Increasing natural retention - Remedy for current climate change in
   urban area},
Journal = {URBAN CLIMATE},
Year = {2020},
Volume = {34},
Month = {DEC},
Abstract = {The article defines the retention potential of a housing development
   based on the example of two estates located in Cracow. Runoff from the
   urban area was calculated using the maximum intensity method (MIM).
   Highly effective rainfall retention based on green infrastructure has
   been proposed. It has been shown that by using extensive green roofs and
   permeable surfaces, it is possible to considerably decrease stormwater
   discharge from the analysed estates, and thus improving natural
   retention within the range of 18.6\% to 22.1\%.},
