@article{ WOS:001202568700001,
Author = {Wiersma, Jake and Bertolini, Luca},
Title = {Making the trade-offs between parking and placemaking visible and
   actionable},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2024},
Volume = {29},
Number = {6},
Pages = {629-645},
Month = {NOV 1},
Abstract = {The space claims necessary for ensuring the liveability of public spaces
   often clash with on-street parking demand for private vehicles.
   Balancing these needs in a fair discussion has proven difficult. Demand
   for parking is expressed in clear-cut numbers, while liveability is a
   more emergent and qualitative concept. This paper seeks to (1) define
   the physical values of liveability; (2) translate them into generic
   space claims; (3) confront these claims with the demand for parking
   places in existing urban neighbourhoods; and (4) explore how this
   information could inform public debate and policy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
