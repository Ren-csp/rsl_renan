@article{ WOS:000275951600027,
Author = {Stewart, Alex G. and Luria, Paolo and Reid, John and Lyons, Mary and
   Jarvis, Richard},
Title = {Real or Illusory? Case Studies on the Public Perception of Environmental
   Health Risks in the North West of England},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2010},
Volume = {7},
Number = {3},
Pages = {1153-1173},
Month = {MAR},
Abstract = {Applied research in a public health setting seeks to provide
   professionals with insights and knowledge into complex environmental
   issues to guide actions that reduce inequalities and improve health. We
   describe ten environmental case studies that explore the public
   perception of health risk. We employed logical analysis of components of
   each case study and comparative information to generate new evidence.
   The findings highlight how concerns about environmental issues
   measurably affect people's wellbeing and led to the development of new
   understanding about the benefits of taking an earlier and more inclusive
   approach to risk communication that can now be tested further.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
