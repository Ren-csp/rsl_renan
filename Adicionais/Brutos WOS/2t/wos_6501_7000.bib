@article{ WOS:001735786900001,
Author = {Matajs, C. and Baptista, P. and Valenta, G. and Felix, R. and Moura, F.},
Title = {How does road space allocation affect the environment and health? An
   evaluation framework for dynamic and static urban interventions},
Journal = {JOURNAL OF TRANSPORT \& HEALTH},
Year = {2026},
Volume = {49},
Month = {JUN},
Abstract = {Introduction: Road space is increasingly limited and its allocation
   influences environmental and health outcomes. However, road space
   management lacks systematic evaluation. It remains unclear whether
   allocating space dynamically over time has similar environmental and
   health effects at a street level as traditional approaches. Methods:
   This study develops a replicable methodological framework for assessing
   environmental and health impacts of urban street space reallocation
   strategies, applied to both static and dynamic configurations. The
   methodology is applied to a major street in Lisbon, Portugal. Results:
   Results show that the type of intervention matters most, independently
   if it is static or dynamic: bike lanes yield the greatest CO2 (up to
   16.4\%) and pollutant reductions, while open street scenarios offer the
   highest health benefits from increased walking. Bus lanes achieve the
   largest NOx cuts (up to 21.9\%) due to improved bus speeds. Conclusions:
   Although static scenarios perform best environmentally, dynamic
   solutions particularly off-peak - achieve comparable results while
   enhancing flexibility.},
