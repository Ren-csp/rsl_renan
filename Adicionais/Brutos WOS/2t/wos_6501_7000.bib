@article{ WOS:001686288500001,
Author = {Machac, Jan and Dubova, Lenka and Hekrle, Marek and Lanikova, Sara},
Title = {Do fences divide perception? A study of community garden benefits among
   users and non-users in Czech cities},
Journal = {CITIES},
Year = {2026},
Volume = {171},
Month = {APR},
Abstract = {Community gardens (CGs) provide a diverse array of ecosystem services
   (ES), contributing to the well-being of individuals and communities.
   However, their longevity depends not only on the active engagement of
   users but also on how CGs and their benefits are perceived by the
   surrounding community. Main aim of this study is to investigate how
   perceptions of the importance of ES and other benefits provided by CGs
   differ between CG users (those actively engaged in CG activities) and
   non-users (residents living near CGs but not participating). Data were
   collected through an on-site questionnaire survey among CG non-users in
   two Czech cities, \& Uacute;sti nad Labem and Prague, and an online
   survey of CG users across Czechia. The findings reveal that while both
   groups valued multiple ES, non-users prioritised environmental benefits
   such as air quality improvement and crop production, alongside
   recreational functions. In contrast, CG users placed the highest
   importance on cultural and social benefits, particularly recreation,
   social interaction, and aesthetic enhancement, while giving lower
   priority to provisioning functions. These differences highlight the need
   to address diverse stakeholder perspectives when promoting CGs. A
   balanced approach that integrates environmental, social, and cultural
   considerations can enhance the appeal of CGs to both users and
   non-users, supporting their sustainable development and integration into
   urban environments.},
