@article{ WOS:001622005100003,
Author = {Lu, Haitian and Li, Xu and Zhao, Liu and Liu, Gefei and Lu, Zhuocheng
   and Zhu, Xinhui and Zhang, Junjie},
Title = {Are industrial areas the main culprit behind urban heat? A study of
   thermal environment in mountainous cities based on downscaled LST data},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {135},
Month = {DEC 15},
Abstract = {Global warming and intensified human activities have led to a continued
   deterioration of the urban thermal environment, posing a major challenge
   to sustainable urban development. Intra-urban heat islands (IUHIs), a
   key manifestation of extreme heat events, are particularly prominent in
   metropolis. However, existing methods often fail to detect subtle
   variations in land surface temperature (LST) in complex environments,
   limiting our understanding of the spatial patterns and driving
   mechanisms of IUHIs. This study focuses on Chongqing, a representative
   mountainous city. Constructing a GeoAI-based LST downscaling approach,
   produced 10 m resolution LST data (R2 = 0.86). Results indicate that the
   summer of 2024 recorded the highest mean LST over the past decade (41.39
   degrees C), characterized by marked spatial differentiation, and
   distinct thermal contrasts. IUHIs exhibited a multi-centered clustered
   distribution closely aligned with industrial areas, which accounted for
   48.21 \% of identified hotspots-highlighting industrial as the main
   culprit behind urban heat. Furthermore, its internal thermal environment
   showed pronounced spatial heterogeneity due to geomorphic variation. The
   driving mechanisms of IUHIs are revealed as a complex system structured
   along an altitudinal gradient, shaped by nonlinear interactions among
   topographic, environmental, and social factors. This study underscores
   the importance of regulating IUHIs to mitigate urban heat, advocating
   targeted cooling strategies for industrial areas. The findings offer
   both valuable data and novel insights, providing a scientific foundation
   for high-temperature mitigation in other high-density cities, with
   significant practical implications for urban renewal and green
   development.},
