@article{ WOS:001806338400001,
Author = {Cao, Xiangdong and Ci, Fuyi},
Title = {Spatial evolution and driving mechanisms of the coupling coordination
   between intelligent and green industries in the Yellow River Basin},
Journal = {FRONTIERS IN ENVIRONMENTAL SCIENCE},
Year = {2026},
Volume = {14},
Month = {JUN 15},
Abstract = {This paper systematically examines the spatial pattern of coupling
   coordination between intelligent and green industries in the Yellow
   River Basin from the perspective of ``spatial scale{''}. First, at
   multiple functional regional scales-including metropolitan areas,
   metropolitan circles, and urban agglomerations-the differentiated
   spatial structures and the dynamic evolution of
   ``polarization-diffusion{''} are analyzed. Second, at the overall basin
   scale, the characteristics of spatial agglomeration and differentiation
   are revealed. Finally, using Geodetector and spatial econometric models,
   key macro-driving factors affecting the level of coupling coordination
   and their spatial spillover effects are identified, uncovering general
   underlying mechanisms. The study finds that the spatial pattern of
   coupling coordination exhibits significant scale dependence, with
   advanced networked collaborative forms concentrated in the downstream
   regions; R\&D investment and globalization serve as core drivers; and
   the ecological environment demonstrates significant positive spatial
   spillover effects. This research provides a scientific reference for
   optimizing industrial spatial layout and promoting cross-regional
   collaborative governance in the Yellow River Basin.},
