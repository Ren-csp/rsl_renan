@article{ WOS:001843206900007,
Author = {Ugwor, Emmanuel Ifeanyichukwu and Eteng, Ofem Effiom and Ogbonna,
   Chukwuka Uzoamaka and Oniyiku, Rebacca Titilayo and Aremu, Roseline
   Folusho and Victor Efe-Khaese, Osano and Ololade, Usman Ayinde and
   Ewedairo, Latifat Temitope and Akinsete, Feyisayo Caleb and Anwojure,
   Eniola Alaba and Johnson, Ohiremen Johnway and Akinola, Juwon John and
   Ayeni, Adeogo Jesunbo and Owoeye, Oyindamola Olakunle and Agboola,
   Kehinde Joy and Silas, Abigail Ugoeze and Sowole, Emmanuel Oluwasegun
   and Dosumu, Oluwabisi Adebisi},
Title = {A cross-sectional assessment of public knowledge, attitudes, and
   perceptions of endocrine-disrupting compounds in Abeokuta, Nigeria},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2026},
Volume = {23},
Number = {1},
Month = {AUG 6},
Abstract = {Background Endocrine-disrupting compounds (EDCs) pose significant public
   health risks, and everyday consumer products and contact materials are
   important pathways for exposure. Yet, public awareness in sub-Saharan
   Africa (SSA) remains virtually uncharacterized despite substantial and
   increasing population exposures. Hence, we assessed product use,
   knowledge, attitudes, and perceptions (KAP) related to EDCs in Abeokuta,
   Nigeria-a microcosm of SSA settings. Methods This cross-sectional survey
   recruited 786 adults from three zones representing rural (n = 312),
   industrial (n = 237), and urban (n = 237) contexts. Participants
   completed structured questionnaires assessing EDC knowledge, usage of
   EDC-containing products, attitudes toward risk mitigation, and risk
   perceptions. Data were analysed using descriptive statistics, Spearman
   correlations, and ordinal logistic regression. Results Product usage was
   widespread: 97.3\% used bottled/sachet water, 82.8\% cleaning products,
   and 75.2\% plastic containers. Knowledge was poor, with 48.5\%
   demonstrating low knowledge and only 6.5\% high knowledge. Correct
   response rates ranged from 18.3\% (identifying non-EDC compounds) to
   75.6\% (recognising health risks). Attitudes were generally
   health-protective (54.6\% positive), though only 56.9\% reported active
   avoidance efforts. Optimism bias was evident: 93.1\% acknowledged EDC
   health consequences, yet 54.2\% perceived personal exposure as low.
   Urban residence (OR = 1.67, p = 0.005) and tertiary education (OR =
   1.88, p = 0.007) predicted better knowledge. Males had 2.64 times higher
   odds of negative attitudes (p < 0.001), while younger adults (18-25
   years) had 4.44 times higher odds versus the elderly (p = 0.004).
   Conclusions Substantial knowledge deficits coexist with pervasive EDC
   exposure in Abeokuta, Nigeria. Targeted interventions addressing both
   knowledge gaps and structural barriers are urgently needed to reduce
   population-level exposure in SSA settings.},
