Author = {Kamani Fard, Asal and Paydar, Mohammad},
Title = {Women's walking behaviour and subjective well-being in the middle-income
   neighbourhoods of Santiago, Chile},
Journal = {BMC PUBLIC HEALTH},
Year = {2026},
Volume = {26},
Number = {1},
Month = {JUN 13},
Abstract = {Background Walking remains the primary mode of everyday mobility for
   women in Chile, particularly in metropolitan areas with low to medium
   income populations. However, a range of barriers including among others
   concerns related to perceived insecurity have recently emerged and made
   walking more difficult. At the same time, subjective well-being has
   become an important topic in urban research over the past decade. This
   study examines the associations between women's walking behavior and
   subjective well-being in medium-income neighborhoods in Santiago, Chile,
   considering socio-demographic, psychological, social, and built
   environment factors. It also explores perceived barriers to
   walking.Methods Data were collected from women in six middle-income
   neighborhoods in Santiago using a structured questionnaire and
   open-ended questions, based on a simple random sampling approach.
   Qualitative data were analyzed using content analysis, while
   quantitative relationships were examined using Exploratory Factor
   Analysis (EFA) and Structural Equation Modeling (SEM). Objective built
   environment indicators were also incorporated using GIS and audit
   tools.Results Qualitative findings indicate that perceived insecurity is
   the primary barrier to walking among women, particularly factors related
   to crime, poor lighting, and unsafe street conditions. Quantitative
   results show a significant association between walking behavior and
   subjective well-being; however, this relationship is interpreted as
   associative rather than causal due to the cross-sectional design. The
   results further indicate that socio-demographic, psychological, social,
   and built environment factors are significantly associated with both
   walking behavior and subjective well-being, including income, employment
   status, walking attitudes, lifestyle patterns, personal values, social
   cohesion, companionship, perceived accessibility, insecurity-related
   perceptions, traffic safety, and pedestrian infrastructure
   quality.Conclusion The findings highlight the importance of addressing
   perceived insecurity and improving pedestrian infrastructure to support
   women's walking behavior and subjective well-being in middle-income
   neighborhoods. Urban policies that integrate safety, accessibility, and
   social cohesion considerations may contribute to more supportive and
   sustainable urban environments in Santiago.},
