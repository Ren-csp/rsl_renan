@article{ WOS:001756666100004,
Author = {Gupta, Anika and Morella, Norma and Sutormin, Dmitry and Li, Naisi and
   Gaisser, Karl and Robertson, Alexander and Ispolatov, Yaroslav and
   Seelig, Georg and Dey, Neelendu and Kuchina, Anna},
Title = {Dynamics of phage-host interactions in Bacteroides fragilis
   resolved by single-cell transcriptomics},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAR 16},
Abstract = {The interactions between lytic phages and their hosts are typically
   studied in bulk culture, which obscures cell-cell differences in
   infection susceptibility or expression of protective factors. Here, we
   use bacterial single-cell RNA sequencing to profile the transcriptomes
   of similar to 50,000 cells from cultures of a human pathobiont,
   Bacteroides fragilis, infected with a lytic bacteriophage. From a single
   sampling, we quantified the asynchronous progression of phage infection
   in individual bacterial cells and reconstructed the infection timeline,
   characterizing both host and phage transcriptomic changes as infection
   unfolded. Further, we discovered phenotypic subpopulations of bacteria
   that remained uninfected. Each cell's vulnerability to phage infection
   was influenced by expression of multiple genetic loci, most prominently
   phase-variable capsular polysaccharide (CPS) biosynthesis pathways and
   an operon predicted to encode fimbrial genes. These findings uncovered
   genome-wide phase variation and stochasticity that enable bacterial
   survival and re-growth without acquiring additional mutations. Overall,
   we establish bacterial single-cell RNA sequencing as a powerful platform
   for investigating the dynamics of host-phage interactions and revealing
   the roles of phase variation and stochasticity in bacterial defenses.},
