@article{ WOS:000830292200003,
Author = {Vidal, Diogo Guedes and Teixeira, Catarina Patoilo and Fernandes,
   Claudia Oliveira and Olszewska-guizzo, Agnieszka and Dias, Ricardo Cunha
   and Vilaca, Helena and Barros, Nelson and Maia, Rui Leandro},
Title = {Patterns of human behaviour in public urban green spaces: On the
   influence of users' profiles, surrounding environment, and space design},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2022},
Volume = {74},
Month = {AUG},
Abstract = {Public urban green spaces (PUGS) play a vital role in the dense urban
   fabric as places of Nature-Society contact and socialization. Despite
   some advances in the field, the relationship between the PUGS
   surroundings and their users' behaviours remains unclear. This study
   examined the patterns of human behaviour in four PUGS of the city of
   Porto, on the north Portuguese coast, where the behavioural mapping
   method was applied. Observational data regarding 979 PUGS users'
   socio-demographics and behaviours were recorded on a base map and a grid
   between August and November 2020. The use patterns during different
   times of the day were disaggregated across be-haviours and users'
   profiles, and their relationship with the surroundings and design
   elements was assessed with ANOVA, Chi-Square test, and Pearson
   correlation. The findings presented may pave the way for future studies
   and inform the urban planning and design of the effectiveness of new
   interventions, namely providing more accurate aligning between the
   greenspace design language with users' needs. Furthermore, this study
   highlights the importance of considering the sociodemographic background
   of PUGS users and the surroundings to guide designers and planners.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Vidal, DG (Corresponding Author), Univ Fernando Pessoa, Praca Nove Abril 349, P-4249004 Porto, Portugal.
   Vidal, Diogo Guedes; Barros, Nelson; Maia, Rui Leandro, Univ Fernando Pessoa UFP, Energy Environm \& Hlth Res Unit FP ENAS, Praca 9 Abril 349, P-4249004 Porto, Portugal.
