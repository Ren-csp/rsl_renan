@article{ WOS:001613279800001,
Author = {Fike, Kayla J. and Wolf, Joshua and Williams, Patrice C.},
Title = {Modeling the Black Spatial Imaginary: Exploring communal dynamics and
   emotional investments as contributors to residents' ownership of change},
Journal = {JOURNAL OF URBAN AFFAIRS},
Year = {2025},
Month = {2025 NOV 14},
Abstract = {Ownership of change is the extent to which residents feel changes in the
   neighborhood are beneficial to their community and that the average
   person has a say in those changes. Residents' sense of ownership may be
   contributed to by an array of sociopolitical, communal, and affective
   factors. Using George Lipsitz's Black Spatial Imaginary concept, we
   consider whether existing psychological constructs measuring communal
   dynamics and emotional investments contribute to Black residents'
   ownership of change. Using data from Black participants in the Healthy
   Neighborhoods Study (n = 1,124), we examine potential contributors to
   Black residents' ownership of change and the ways in which these
   contributors may differ among and between Black men and women using
   multigroup structural equation modeling. Results suggest that communal
   dynamics are related to Black residents' ownership of change and in
   different ways for Black women and men. However, emotional investments,
   namely neighborhood pride and belonging, were not related to ownership
   of change among this sample. The contributions of the current study are
   relevant to urban health equity practitioners and researchers serving
   Black urban residents, including the need to center heterogeneous
   experiences of Black urban residents in planning processes and to
   further explore those experiences through mixed methods research.},
