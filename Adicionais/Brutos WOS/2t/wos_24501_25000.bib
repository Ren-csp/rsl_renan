@article{ WOS:001854589000001,
Author = {Zhu, Ke and Lu, Hongwei and Yao, Tianci and Zhang, Xiaohan and Liang,
   Dongzhe and Tian, Peipei},
Title = {Mapping long-term functional-ecological land dynamics and their thermal
   effects in Shenzhen using multi-source remote sensing, 2000-2020},
Journal = {REMOTE SENSING APPLICATIONS-SOCIETY AND ENVIRONMENT},
Year = {2026},
Volume = {43},
Month = {AUG},
Abstract = {Mapping long-term intra-urban functional dynamics remains difficult
   because historical semantic data (e.g., POI) are largely unavailable
   before the 2010s, preventing consistent functional classification across
   decades. Consequently, the thermal consequences of internal functional
   restructuring within built-up land-particularly the differentiation
   between production and living space-remain insufficiently quantified.
   This study addresses this constraint for Shenzhen (2000-2020) by
   developing a reconstruction framework that fuses multi-source labels
   (POI, EULUC, TCULU, manual samples) with remote-sensing time-series
   features to classify five land use types: production land, living land,
   green space, water bodies, and farmland. The multilayer perceptron (MLP)
   model achieved an overall accuracy of 0.77 in 2020 and outperformed
   random forest in identifying production land; nevertheless, production
   land remained the most difficult class (F1 = 0.57) and farmland recall
   was low (0.35); this class-level uncertainty is explicitly propagated
   through Monte Carlo error analysis in all downstream thermal
   assessments. Analysis of the reconstructed maps reveals that LST
   differences across functional types are stable and widening: the
   production-green space gap reached 4.88 degrees C by 2020, while the
   production-living land gap widened to 0.74 degrees C. Land use
   transitions exhibited stage-dependent thermal effects: conversions from
   ecological/agricultural space to built-up functions were associated with
   stronger warming during 2000-2010 (matched estimate, ATT approximate to
   0.36-0.55 degrees C), whereas after 2010 the matched associations were
   not statistically distinguishable from zero (similar to 0.1 degrees C,
   95\% CI crossing zero). These findings reveal how intra-urban functional
   differentiation shapes the surface thermal environment, providing
   LST-based evidence for climate-adaptive strategies in high-density urban
   renewal.},
