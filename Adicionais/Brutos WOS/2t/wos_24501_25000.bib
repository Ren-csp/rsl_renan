@article{ WOS:001200727600025,
Author = {Bosa, Vita and Marieiev, Dmytro and Balalaieva, Olena and Krokhmal, Alla
   and Solovei, Anna},
Title = {Implementation of virtual reality in foreign language teaching},
Journal = {AMAZONIA INVESTIGA},
