@article{ WOS:001614568200001,
Author = {Wilson, Jessica and Cronin, Timothy J. and Marsland, Sophie and Pepping,
   Christopher A.},
Title = {Effects of the Australian Marriage Equality Postal Vote and Debate on
   Same-Sex Romantic Relationships: A Qualitative Investigation},
Journal = {SEXUALITY RESEARCH AND SOCIAL POLICY},
Year = {2025},
Month = {2025 NOV 15},
Abstract = {BackgroundPublic debates about the rights of minority groups can
   heighten minority stress and undermine mental health for individuals
   within these groups. However, little is known about the impacts of these
   debates on the relational lives of those affected. Here we leverage
   qualitative data gathered during the 2017 Australian marriage equality
   debate-as part of a national postal vote on same-sex marriage-to explore
   how public discourse questioning the legitimacy of sexual minority
   relationships affects the relational lives of same-sex couples.Method285
   individuals in a same-sex relationship (M age = 39.05 years) responded
   to questions about their experience of the Australian marriage equality
   debate. Data were collected in 2017 as part of a broader longitudinal
   study and analysed using reflective thematic analysis.ResultsTwo themes
   were generated. Theme one: impacts on relationship functioning and
   satisfaction included three subthemes describing how the campaign
   contributed to withdrawal from public affection, strained coping and
   relational disconnection, and communication breakdown. Theme two: active
   dyadic coping strategies included two subthemes describing the use of
   mutual support and solidarity to cope with the effects of the debate,
   and pragmatic and open communication to navigate the difficulties
   associated with the campaign.Conclusions and Policy ImplicationsResults
   highlight the significant relational impacts of public debates focused
   on the rights of marginalised groups. It is critical that any potential
   value of a public vote be assessed alongside the clear risk of harm to
   the lives of minority group members.},
