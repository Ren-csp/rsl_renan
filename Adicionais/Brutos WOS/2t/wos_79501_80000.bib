@article{ WOS:001763231800001,
Author = {Alvarado-Serrano, Mariana and Mora-Izaguirre, Maria Ofelia and
   Juarez-Lira, Alberto and Dominguez-Perez, Ruben Abraham and Frade-Perez,
   Maria Daniela and Luna, Guadalupe Saray Escamilla and Perez-Serrano,
   Rosa Martha},
Title = {Characterization of human-animal interactions among pet owners in Mexico
   from a One Health perspective: A cross-sectional study},
Journal = {ONE HEALTH},
Year = {2026},
Volume = {22},
Month = {JUN},
Abstract = {Determining the characteristics of coexistence between humans and their
   pets will enable the identification of risk behaviors associated with
   zoonotic transmission. This cross-sectional study in Mexico aimed to
   evaluate patterns of human-pet coexistence by examining the human-animal
   interaction and domestic hygiene sections of the online survey
   ``National Survey on Coexistence with Pets in Mexico (NSCP){''}. The
   study adhered to STROBE guidelines. Associations were assessed using
   Pearson's chi 2 test with p-values adjusted by Bonferroni and Holm's
   methods, and effect size was estimated with Cramer's V. Adjusted Pearson
   residuals were used as a complementary analytical tool. A multinomial
   logistic regression model was also performed, with mouth-to-snout/
   tongue contact intensity as the dependent variable. A total of 3699
   complete surveys were analyzed. The households reported that pets slept
   in the owner's bed (34.6\%), that owners did not wash their hands after
   direct contact (37\%), the face kissing (mouth-to-snout/tongue) was
   allowed (74.7\%), that feces and urine were noticed inside the house
   (61.2\%), and that pets were taken to potentially contaminated public
   areas (77.7\%). Younger age, a higher number of dogs, frequent visits to
   public places, poor hand hygiene after direct contact, and allowing pets
   to sleep indoors were associated with increased intensity of
   mouth-to-snout/tongue contact. Close human-pet interactions require
   responsible expressions of affection that prioritize both animal welfare
   and public health. From a One Health perspective, understanding
   household behaviors is crucial for identifying risky practices that
   could lead to zoonotic transmission.},
