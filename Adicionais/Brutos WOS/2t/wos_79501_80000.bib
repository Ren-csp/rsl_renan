@article{ WOS:001795553700001,
Author = {Abu Eid, Yousef Sami Nemer and al Shakari, Doaa adnan and Al-Rawabdeh,
   Nadeem and Mahroum, Mohammad and Alazzam, Nahawand and Hatamleh, Islam
   Habis Mohammad},
Title = {Social media use and interpersonal communication motives as predictors
   of problem-solving skills among public relations staff in Jordan},
Journal = {FRONTIERS IN COMMUNICATION},
Year = {2026},
Volume = {11},
Month = {JUN 4},
Abstract = {Public relations practice increasingly requires practitioners to use
   social media strategically while also demonstrating strong
   problem-solving skills in addressing communication-related challenges.
   However, limited research has examined how social media use and
   interpersonal communication motives jointly predict problem-solving
   skills among public relations staff in Jordan. This study addressed this
   gap by investigating the predictive relationships between Social Media
   Use, Interpersonal Communication Motives, and Problem-Solving Skills
   among public relations practitioners in Jordan. Guided by Uses and
   Gratifications Theory and Interpersonal Communication Motives Theory,
   the study employed a quantitative design using a self-administered
   questionnaire distributed to public relations staff, yielding 421 valid
   responses. Data were analyzed using partial least squares structural
   equation modeling (PLS-SEM). Interpersonal Communication Motives were
   modeled as a second-order construct comprising six first-order
   dimensions: affection, control, relaxation, escape, pleasure, and
   inclusion. The findings showed that both Social Media Use and
   Interpersonal Communication Motives significantly predict
   Problem-Solving Skills. Social Media Use had a positive but relatively
   modest effect, whereas Interpersonal Communication Motives had a much
   stronger positive effect, indicating that interpersonal and relational
   communication factors are more influential in shaping problem-solving
   skills than digital platform use alone. The model showed substantial
   explanatory power. The study contributes to the public relations
   literature by providing empirical evidence from Jordan, integrating two
   theoretical perspectives in one framework, and offering practical
   implications for strengthening both digital and interpersonal
   communication capacities among public relations staff.},
