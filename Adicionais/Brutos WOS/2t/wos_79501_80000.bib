@article{ WOS:001818339500002,
Author = {Moran-Neches, Lorena and Rodriguez-Suarez, Julio},
Title = {Care as Female Resistance Practice in Activism in Non-mixed
   Participation Collectives},
Journal = {PAPERS-REVISTA DE SOCIOLOGIA},
Year = {2026},
Volume = {111},
Number = {3},
Abstract = {At first limited and then made invisible, women's social participation
   has not been pre-sent in the narratives and discourses on social
   movements throughout history. In order to contribute to counteracting
   this traditional androcentric vision, this research aims to explore,
   through the eyes of women activists, the gender differences in
   participation in organised social movements, relating the experience in
   mixed and non-mixed social action collectives. Using a qualitative
   methodology, 12 in-depth interviews were conducted with activists from
   different spheres of participation in the Principado of Asturias to find
   out about their trajectory and perspective. The experiences of the
   interviewees reveal the pres-ence of gender biases in the division of
   militant work or the dynamics of participation in spaces of debate or
   representation of mixed groups, even in those considered feminist. In
   the face of this, non-mixed participation spaces are constituted as
   places from which to understand and experience another activism where
   affection goes beyond the barrier of the private sphere and care becomes
   a political and vital strategy. The results obtained in this study
   contrast female participation dichotomously with male participation, and
   forces the question of whether the positioning of care as a
   characteristic of female activism is not in some way reproducing a
   patriarchal division. It also raises the issue of where the work of
   collectives should be directed in order to eliminate these differences
   or their implications.},
