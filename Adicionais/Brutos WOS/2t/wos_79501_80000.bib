@article{ WOS:001450105600001,
Author = {Xu, Xinyue and Cheng, Chongyang and Li, Yang and Xin, Xia and Wang,
   Yingmin and Zhang, Jinmei and Deng, Hui and Deng, Zhijun and Yin,
   Guangkun},
Title = {Optimization and analysis of the seed viability monitoring for seven
   crop species to inhibit fungal infection},
Journal = {SEED BIOLOGY},
Year = {2025},
Volume = {4},
Month = {MAR 19},
Abstract = {The conservation of crop germplasm resources in Genebanks relies on
   accurate seed viability monitoring to maintain high viability levels.
   However, some seeds are susceptible to fungal infections during the
   germination process, which can affect the morphological development of
   the radicle and shoot. This leads to a reduced germination rate or
   vitality index, complicating the accurate assessment of seed viability.
   In this study, we examined seven crop seeds that are highly susceptible
   to fungal infection, which were identified during viability monitoring
   in Genebanks: faba bean, pea, soybean, maize, sunflower, peanut, and
   sorghum. High-throughput sequencing technology was employed to identify
   and classify fungi, revealing that genera such as Alternaria,
   Cladosporium, Fusarium, and others were highly abundant in the seeds.
   These fungi could produce toxins that may inhibit seedling growth.
   Sanger sequencing further confirmed that Fusarium is a widely prevalent
   pathogenic genus across all seven crops. Based on these findings, we
   optimized the following germination protocols for each crop to mitigate
   fungal affection: faba bean, pea, sunflower, and sorghum seeds treated
   with 10\% NaClO for 35 min; peanut and maize seeds treated with 6\%
   NaClO for 25 min; soybean seeds treated with 8\% NaClO for 15 min;
   followed by cultivation on 7 g/L agar media. The optimal germination
   protocol can effectively inhibit the negative effects of fungal
   infections on seed germination. This study provides technical support
   for improving the accuracy of seed viability monitoring in Genebanks.},
