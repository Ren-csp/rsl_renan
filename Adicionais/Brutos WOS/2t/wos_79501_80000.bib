@article{ WOS:000886226300001,
Author = {Hidalgo-Andrade, Paula and Paz, Clara and Bosano, Carlos Hermosa and
   Garcia-Manglano, Javier and Chalezquer, Charo Sadaba and Lopez-Madrigal,
