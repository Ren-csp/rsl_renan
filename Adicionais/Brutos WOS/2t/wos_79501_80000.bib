@article{ WOS:001406376300001,
Author = {Lynch, Shannon Colleen and Reyes-Gonzalez, Edeli and Bossard, Emily L.
   and Alarcon, Karen S. and Love, Natalie L. R. and Hollander, Allan D.
   and Nobua-Behrmann, Beatriz E. and Gilbert, Gregory S.},
Title = {A phylogenetic epidemiology approach to predicting the establishment of
   multi-host plant pests},
Journal = {COMMUNICATIONS BIOLOGY},
Year = {2025},
Volume = {8},
Number = {1},
Month = {JAN 24},
Abstract = {Forecasting emergent pest spread is paramount to mitigating their
   impacts. For host-specialized pests, epidemiological models of spread
   through a single host population are well developed. However, most pests
   attack multiple host species; the challenge is predicting which
   communities are most vulnerable to infestation. Here, we develop a
   phylogenetically-informed approach to predict establishment of emergent
   multi-host pests across heterogeneous landscapes. We model a
   beetle-pathogen symbiotic complex on trees, introduced from Southeast
   Asia to California. The phyloEpi model for likelihood of establishment
   was predicted from the phylogenetic composition of woody species in the
   invaded community and the influence of temperature on beetle
   reproduction. Plant communities dominated by close relatives of known
   epidemiologically critical hosts were four times more likely to become
   infested than communities with more distantly related species. Where
   microclimate favored beetle reproduction, pest establishment was greater
   than expected based only on species composition. We applied this
   phyloEpi model to predict infestation risk in California using weather
   data and complete tree inventories from 9262 1-km2 grids in 170 cities.
   Regions in the state predicted with low likelihood of infestation were
   confirmed by independent monitoring. Analysts can adapt these
   phylogenetic ecology tools to predict spread of any multi-host pest in
   novel habitats.},
