@article{ WOS:001784801800003,
Author = {Souto, Luiza Kerstner and Nornberg, Marta},
Title = {KNOWLEDGE ABOUT TEACHING IN THE ERLY YEARS IN REFLECTIVE RECORDS},
Journal = {ETD EDUCACAO TEMATICA DIGITAL},
Year = {2026},
Volume = {28},
Abstract = {This article presents and discusses the construction of knowledge about
   teaching in the early years by student trainees on the Pedagogy course.
   The theoretical problematization is supported by studies in the field of
   teacher training and pedagogy. It starts from the premise that teaching
   develops when we recognize the existence of an in-between where theories
   and practices feed back into each other, favoring the teacher's specific
   knowledge. The research involved the interpretative analysis of
   reflective records drawn up by the trainees during their teaching
   internship in the early years. Based on the thematic analysis of the
   reflective records, four nuclei of meaning were identified: organization
   and functioning of the school; organization of pedagogical
   work-planning; insertion into teaching; the other of the pedagogical
   relationship. In each section, different aspects of teaching are
   discussed, such as situations of doubt, uncertainty, fear, affection,
   disaffection, failure, mediocrity, rupture and resistance. The
   strategies and knowledge developed by the trainees for action and
   understanding of the pedagogical act, a moment permeated with
   contradictions and tensions, are also problematized. The results of the
   research point to the multiplicity of teacher knowledge, demonstrating
   the importance of understanding pedagogy and teaching in the tension
   between theory and practice so that knowledge can be constructed and
   (re)interpreted by teachers in training.},
