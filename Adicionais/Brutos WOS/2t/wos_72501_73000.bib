@article{ WOS:000306249500015,
Author = {Diffenbaugh, Noah S. and Hertel, Thomas W. and Scherer, Martin and
   Verma, Monika},
Title = {Response of corn markets to climate volatility under alternative energy
   futures},
Journal = {NATURE CLIMATE CHANGE},
Year = {2012},
