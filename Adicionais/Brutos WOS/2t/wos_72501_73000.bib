@article{ WOS:000484419000185,
Author = {Clemente, Filipe Manuel and Nikolaidis, Pantelis Theodoros and Rosemann,
   Thomas and Knechtle, Beat},
Title = {Variations of Internal and External Load Variables between Intermittent
   Small-Sided Soccer Game Training Regimens},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2019},
Volume = {16},
Number = {16},
Month = {AUG 14},
Abstract = {The purpose of this study was twofold: (i) analyze the variations of
   internal and external load between intermittent regimens (6 x 3' and 3 x
   6') during a small-sided game (SSG); and (ii) analyze the variations of
   internal and external load within-intermittent regimens (between sets).
   Ten male amateur soccer players (age: 21.7 +/- 2.1 years) participated
   in this study. Almost certain large decreases in total distance (-8.6\%,
   {[}-12.3; -4.8], Effect Size (ES): -1.51, {[}-2.20; -0.82]) and running
   distance (-34.0\%, {[}47.0; -17.8], ES: -2.23, {[}-3.40; -1.05]) were
   observed when comparing the 3 x 6' and 6 x 3'. Very likely moderate and
   large decreases in total accelerations (-24.0\%, {[}-35.1; -10.9]; ES:
   -1.11, {[}-1.75; -0.47]) and total of decelerations (-26.7\%, {[}-38.8;
   -12.1]; ES:-1.49, {[}-2.36; -0.62]), respectively, were found when
   comparing the 3 x 6' and 6 x 3'. Very likely increases in rated of
   perceived exertion in the set 3 in comparison to the 1st during the 3 x
   6' SSG (34.5\%, {[}12.4; 61.0], ES: 1.35, {[}0.53; 2.16]) and the 6 x 3'
   (29.9\%, {[}11.6; 51.2]; ES: 1.17, {[}0.49; 1.85]). Longer sets increase
   the perception of effort and contribute to a large decrease in total and
   running distances, and total of accelerations and decelerations.
   Meaningful decreases in time-motion demands occur between sets 2 and 3
   while perceived effort increases.},
