@article{ WOS:000359110500001,
Author = {Liaw, Chih-Chuang and Chen, Pei-Chin and Shih, Chao-Jen and Tseng,
   Sung-Pin and Lai, Ying-Mi and Hsu, Chi-Hsin and Dorrestein, Pieter C.
   and Yang, Yu-Liang},
Title = {Vitroprocines, new antibiotics against Acinetobacter baumannii,
   discovered from marine Vibrio sp QWI-06 using
   mass-spectrometry-based metabolomics approach},
Journal = {SCIENTIFIC REPORTS},
Year = {2015},
Volume = {5},
Month = {AUG 4},
Abstract = {A robust and convenient research strategy integrating state-of-the-art
   analytical techniques is needed to efficiently discover novel compounds
   from marine microbial resources. In this study, we identified a series
   of amino-polyketide derivatives, vitroprocines A-J, from the marine
   bacterium Vibrio sp. QWI-06 by an integrated approach using imaging mass
   spectroscopy and molecular networking, as well as conventional
   bioactivity-guided fractionation and isolation. The structure-activity
   relationship of vitroprocines against Acinetobacter baumannii is
   proposed. In addition, feeding experiments with 13C-labeled precursors
   indicated that a pyridoxal 5'-phosphate-dependent mechanism is involved
   in the biosynthesis of vitroprocines. Elucidation of amino-polyketide
   derivatives from a species of marine bacteria for the first time
   demonstrates the potential of this integrated metabolomics approach to
   uncover marine bacterial biodiversity.},
