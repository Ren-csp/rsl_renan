@article{ WOS:001797696900001,
Author = {Yamada, Takashi and Tamura, Yuto},
Title = {Disaster risk reduction for travelers: Linking everyday preparedness to
   preparedness during domestic travel},
Journal = {PROGRESS IN DISASTER SCIENCE},
Year = {2026},
Volume = {31},
Month = {OCT},
Abstract = {Research on tourism and disasters has examined crisis management, the
   effects of disasters on tourism demand, and travelers' risk perception,
   information-seeking behavior, and evacuation decision-making. In
   contrast, travelers' own disaster preparedness has received limited
   attention. This study addresses this gap by focusing on Japanese
   domestic travelers and examining the relationships among the actual
   disaster preparedness measures they took during past trips, their
   awareness of disaster preparedness for future trips, their everyday
   disaster preparedness, and their behavioral awareness in the event of an
   earthquake based on a questionnaire survey. The results showed that
   disaster preparedness during travel was generally low. In particular,
   checking evacuation sites, preparing emergency supplies, installing
   disaster preparedness apps, confirming methods of checking on family
   members and friends, and purchasing insurance were all inadequately
   practiced. Conversely, awareness of disaster preparedness for future
   trips slightly surpassed past efforts. Additionally, everyday
   preparedness activities, especially keeping disaster preparedness apps
   ready and participate in disaster drills, were strongly linked to
   multiple preparedness measures taken during previous trips. Furthermore,
   more than half of the respondents belonged to a group that had
   undertaken little disaster preparedness measures while traveling. These
   findings suggest a gap between intentions and actions in travel-related
   preparedness and indicate that destination preparedness may be supported
   by routine information practices and daily disaster readiness habits.
