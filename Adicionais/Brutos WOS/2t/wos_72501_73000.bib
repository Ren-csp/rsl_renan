@article{ WOS:000701486500001,
Author = {Olfert, Melissa D. and Hagedorn-Hatfield, Rebecca L. and Houghtaling,
   Bailey and Esquivel, Monica K. and Hood, Lanae B. and MacNell, Lillian
   and Soldavini, Jessica and Berner, Maureen and Savoie Roskos, Mateja R.
   and Hingle, Melanie D. and Mann, Georgianna R. and Waity, Julia F. and
   Knol, Linda L. and Walsh, Jennifer and Kern-Lyons, Valerie and Paul,
   Christopher and Pearson, Keith and Goetz, Jeannine R. and Spence, Marsha
   and Anderson-Steeves, Elizabeth and Wall-Bassett, Elizabeth D. and
   Lillis, J. Porter and Kelly, E. Brooke and Hege, Adam and Fontenot, Mary
   Catherine and Coleman, Patricia},
Title = {Struggling with the basics: food and housing insecurity among college
   students across twenty-two colleges and universities},
Journal = {JOURNAL OF AMERICAN COLLEGE HEALTH},
Year = {2023},
Volume = {71},
Number = {8},
Pages = {2518-2529},
Month = {OCT 13},
Abstract = {Objectives To quantify the number and type of students failing to secure
   basic needs. Participants Students attending 22 postsecondary schools in
   the United States in Fall 2019. Methods The Adult Food Security Module
   and part of the \#RealCollege Survey were used to measure food and
   housing insecurity, respectively. Logistic and linear regression models
   were used to assess the relationship between selected factors and basic
   needs insecurities. Results Participants (n = 22,153) were classified as
   44.1\% and 52.3\% food insecure and housing insecure, respectively.
   Homeless students or those who experienced childhood food insecurity
   were at the greatest odds of college food insecurity. Year in school was
   the largest contributor to being housing insecure, with PhD or EdD
   students being 1,157\% more likely to experience housing insecurity
   compared to freshmen. Conclusions High prevalence of basic needs
   insecurities remain. Current campus initiatives may be insufficient,
   calling for a more holistic approach at the campus, state, and national
   levels.},
