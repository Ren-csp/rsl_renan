@article{ WOS:000789924700005,
Author = {Reiff, Sarah B. and Schroeder, Andrew J. and Kirli, Koray and Cosolo,
   Andrea and Bakker, Clara and Lee, Soohyun and Veit, Alexander D. and
   Balashov, Alexander K. and Vitzthum, Carl and Ronchetti, William and
   Pitman, Kent M. and Johnson, Jeremy and Ehmsen, Shannon R. and
   Kerpedjiev, Peter and Abdennur, Nezar and Imakaev, Maxim and Ozturk,
   Serkan Utku and Camoglu, Ugur and Mirny, Leonid A. and Gehlenborg, Nils
   and Alver, Burak H. and Park, Peter J.},
Title = {The 4D Nucleome Data Portal as a resource for searching and visualizing
   curated nucleomics data},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {MAY 2},
Abstract = {The 4D Nucleome (4DN) Network aims to elucidate the complex structure
   and organization of chromosomes in the nucleus and the impact of their
   disruption in disease biology. We present the 4DN Data Portal
   (https://dataAdnucleome.org/), a repository for datasets generated in
   the 4DN network and relevant external datasets. Datasets were generated
   with a wide range of experiments, including chromosome conformation
   capture assays such as HiC and other innovative sequencing and
   microscopy-based assays probing chromosome architecture. All together,
   the 4DN data portal hosts more than 1800 experiment sets and 36000
   files. Results of sequencing-based assays from different laboratories
   are uniformly processed and quality-controlled. The portal interface
   allows easy browsing, filtering, and bulk downloads, and the integrated
   HiGlass genome browser allows interactive visualization and comparison
   of multiple datasets. The 4DN data portal represents a primary resource
   for chromosome contact and other nuclear architecture data for the
   scientific community.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
