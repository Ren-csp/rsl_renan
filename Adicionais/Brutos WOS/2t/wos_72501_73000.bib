@article{ WOS:000400033600026,
Author = {Barnes, Stuart J. and Mattsson, Jan},
Title = {Understanding collaborative consumption: Test of a theoretical model},
Journal = {TECHNOLOGICAL FORECASTING AND SOCIAL CHANGE},
Year = {2017},
Volume = {118},
Pages = {281-292},
Month = {MAY},
Abstract = {Collaborative consumption websites have enabled consumers to focus on
   shared access to products rather than owning them. This study aims at
   developing a comprehensive theoretical model to explain consumer
   outcomes for collaborative consumption. It develops and tests a
   structural equation model using partial least squares path modelling and
   survey data collected from a car-sharing website. The results suggest
   that consumer intentions to rent are driven primarily by perceived
   economic, environmental and social benefits through the mediator of
   perceived usefulness, and enjoyment, in turn driven by sense of
   belonging to the sharing community. Interestingly, social influence did
   not play a role. When making word-of-mouth recommendations, in addition
   to these factors, consumers also take website trust into account,
   underpinned by the structural assurances of the website. The paper
   rounds off further implications of the research for theory and practice.
   (C) 2017 Elsevier Inc. All rights reserved.},
