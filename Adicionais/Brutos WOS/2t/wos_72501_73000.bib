@article{ WOS:000182223700003,
Author = {Wolfe, AK and Bjornstad, DJ},
Title = {Making decisions about hazardous waste remediation when even considering
   a remediation technology is controversial},
Journal = {ENVIRONMENTAL SCIENCE \& TECHNOLOGY},
Year = {2003},
Volume = {37},
Number = {8},
Pages = {1485-1492},
Month = {APR 15},
Abstract = {This paper investigates the circumstances under which proposed hazardous
   waste remediation technologies are socially acceptable, that is,
   considered seriously as options in a public arena. First, it summarizes
   a conceptual framework that guides investigation and interpretation of
   site-specific remediation decision-making. Second, it describes an
   initial application of that framework to the public participation venue
   of U.S. DOE Site-Specific Advisory Boards. Investigating the attributes
   of involved parties and of site context highlights technology
   acceptability as social decision-making that involves technical and
   technological issues rather than as a process driven by the technology
   itself.},
