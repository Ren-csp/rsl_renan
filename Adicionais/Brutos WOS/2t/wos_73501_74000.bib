@article{ WOS:001111914300001,
Author = {Liu, Ningrui and Liu, Wei and Deng, Furong and Liu, Yumeng and Gao,
   Xuehuan and Fang, Lin and Chen, Zhuoru and Tang, Hao and Hong, Shijie
   and Pan, Minyi and Liu, Wei and Huo, Xinyue and Guo, Kangqi and Ruan,
   Fangfang and Zhang, Wenlou and Zhao, Bin and Mo, Jinhan and Huang, Chen
   and Su, Chunxiao and Sun, Chanjuan and Zou, Zhijun and Li, Hao and Sun,
   Yuexia and Qian, Hua and Zheng, Xiaohong and Zeng, Xiangang and Guo,
   Jianguo and Bu, Zhongming and Mandin, Corinne and Haenninen, Otto and
   Ji, John S. and Weschler, Louise B. and Kan, Haidong and Zhao, Zhuohui
   and Zhang, Yinping},
Title = {The burden of disease attributable to indoor air pollutants in China
   from 2000 to 2017},
Journal = {LANCET PLANETARY HEALTH},
Year = {2023},
Volume = {7},
Number = {11},
Pages = {E900-E911},
Month = {NOV},
Abstract = {Background High-level exposure to indoor air pollutants (IAPs) and their
   corresponding adverse health effects have become a public concern in
   China in the past 10 years. However, neither national nor provincial
   level burden of disease attributable to multiple IAPs has been reported
   for China. This is the first study to estimate and rank the annual
   burden of disease and the financial costs attributable to targeted
   residential IAPs at the national and provincial level in China from 2000
   to 2017.Methods We first did a systematic review and meta-analysis of
   117 articles from 37 231 articles identified in major databases, and
   obtained exposure-response relationships for the candidate IAPs. The
   exposure levels to these IAPs were then collected by another systematic
   review of 1864 articles selected from 52 351 articles. After the
   systematic review, ten IAPs with significant and robust
   exposure-response relationships and sufficient exposure data were
   finally targeted: PM2 center dot 5, nitrogen dioxide, sulphur dioxide,
   ozone, carbon monoxide, radon, formaldehyde, benzene, toluene, and
   p-dichlorobenzene. The annual exposure levels in residences were then
   evaluated in all 31 provinces in mainland China continuously from 2000
   to 2017, using the spatiotemporal Gaussian process regression model to
   analyse indoor originating IAPs, and the infiltration factor method to
   analyse outdoor originating IAPs. The disability-adjusted life-years
   (DALYs) attributable to the targeted IAPs were estimated at both
   national and provincial levels in China, using the population
   attributable fraction method. Financial costs were estimated by an
   adapted human capital approach.Findings From 2000 to 2017, annual DALYs
   attributable to the ten IAPs in mainland China decreased from 4620 (95\%
   CI 4070-5040) to 3700 (3210-4090) per 100 000. Nevertheless, in 2017,
   IAPs still ranked third among all risk factors, and their DALYs and
   financial costs accounted for 14 center dot 1\% (95\% CI 12 center dot
   3-15 center dot 6) of total DALYs and 3 center dot 45\% (3 center dot
   01-3 center dot 82) of the gross domestic product. Specifically, the
   rank of ten targeted IAPs in order of their contribution to DALYs in
   2017 was PM2 center dot 5, carbon monoxide, radon, benzene, nitrogen
   dioxide, ozone, sulphur dioxide, formaldehyde, toluene, and
   p-dichlorobenzene. The DALYs attributable to IAPs were 9 center dot 50\%
   higher than those attributable to outdoor air pollution in 2017. For the
   leading IAP, PM2 center dot 5, the DALYs attributable to indoor origins
