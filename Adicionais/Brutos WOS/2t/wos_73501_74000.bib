@article{ WOS:001553607800001,
Author = {Spooner, Sarah L. and Walker, Susan L. and Dowell, Simon and Marques,
   Mara Cristina and Somenzari, Marina and Rocha, Fabiana Lopes and
   Cordero-Schmidt, Eugenia and Hughes, Charlotte and Lee, Christine and
   Smith, Charlotte and Kelly, Jennifer and Salim, Linda and Khoo, Doreen
   and Omar, Junaidi and Franks, Jennifer and Walters, Gretchen and
   Sithole, Samantha S. and Hymas, Olivier and Luna, Jessie K. and Grajal,
   Alejandro and Roeper, Kathrin M. and Bamford, Paul and Waterman, James
   and Howson, Lyndon M. and Costa, Kirsty and Lawrence-Thompson, Frankie
   and Sanderson, Stephanie and Tomisawa, Kanako and Beltramo, Maria
   Catalina and Byers, Onnie and Mileham, Kira and Zordan, Martin and
   Fifield, Karen and Moss, Andrew},
Title = {The Zoo Sphere of Influence Model},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2025},
Volume = {311},
Month = {NOV},
Abstract = {In January 2023 we proposed the Zoo Sphere of Influence, a new model to
   represent the value of zoos/aquariums for species and society. This
   model set out to replace the 50-year-old perception of zoos/aquariums as
   fulfilling only the objectives of conservation, education, research, and
   recreation, and instead demonstrate the broad range of impacts
   zoos/aquariums have for species and society. The Zoo Sphere of Influence
   Model considers zoos/aquariums working at different scales (from local
   to international) and acknowledges a wide range of areas that they work.
   In addition to a visual representation of the value of zoos/aquariums,
   the initial paper proposed a proof-of-concept evaluation matrix that
   they could use to self-assess impact. Over a fifteen-month period, we
   trialled and developed the proposed model and assessment matrix through
   a global consultation and piloting process (this included piloting at 12
   zoos, 5 international workshops/demos and a feedback survey that ran for
   7 months). We have updated the model to include new sections on
   Indigenous Peoples \& Local Communities (IP \& LCs); Sustainability; and
   Diversity, Equity, Access, and Inclusion (DEAI). We have additionally
   updated the assessment criteria to incorporate key zoo/aquarium
   documents and have added a Core Values section reflecting the
   fundamental standards conservation zoos/aquariums should be fulfilling.
   This paper presents the updated version of the Zoo Sphere of Influence.
   We hope that the model will help zoos/ aquariums achieve the highest
   possible standard of practice and provide a means of recognising and
   celebrating these achievements.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
