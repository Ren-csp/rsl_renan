Title = {The dawn of dentistry in the late upper Paleolithic: An early case of
   pathological intervention at Riparo Fredian},
Journal = {AMERICAN JOURNAL OF PHYSICAL ANTHROPOLOGY},
Year = {2017},
Volume = {163},
