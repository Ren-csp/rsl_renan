@article{ WOS:001478027500001,
Author = {Chopra, Anjali and Pandey, Aparna},
Title = {I, me, and the outsider - an exploratory study to identify antecedents
   of sustainable tourism ecosystem in India},
Journal = {COGENT SOCIAL SCIENCES},
Year = {2025},
Volume = {11},
Number = {1},
Month = {DEC 31},
Abstract = {PurposeIndia's travel and tourism sector has grown dramatically,
   especially post-COVID, with many travellers exploring new places.
   Popular tourist destinations include beaches, hill stations, heritage
   sites, and backwaters. However, this rapid expansion has led to
   overcrowding, causing congestion problems, infrastructure strain, and
   environmental deterioration. Against this backdrop, this study
   investigates sustainable tourism practices by drawing insights from
   community-led ecotourism in the northeastern state of Meghalaya,
   India.Design/methodology/approachIn-depth interviews were conducted with
   local communities, administrators, tourists, government officials, and
   academics. Grounded theory and constant comparative analysis were used
   to uncover broad themes and subthemes to create a comprehensive
   theoretical framework for sustainable tourism ecosystems and
   practices.FindingsThe theoretical framework for a sustainable tourism
   ecosystem identifies best practices and provides an action plan to focus
   on tourism while protecting the state's natural splendour and diversity.
   The broad themes and critical dimensions within these themes can provide
   valuable insights to all stakeholders in creating a road map for a
   mutually beneficial future.Practical implicationsThis study is
   significant to government, private, and local stakeholders in planning
   and promoting sustainable tourism practices to sustain local heritage
   and culture.Originality/valueExisting studies have focused on the
   effects of infrastructure development, heritage protection, and human
   factors on tourism in isolation. This study's originality lies in its
   holistic integration of these constructs and their interrelationships in
   the Indian context. The study provides a more nuanced understanding of
   sustainable tourism.},
