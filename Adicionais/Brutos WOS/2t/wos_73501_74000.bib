Author = {Jang, Minwoo Wendy and Oh, Doo-Yi and Yi, Eunyoung and Liu, Xuezhong and
   Ling, Jie and Kim, Nayoung and Sharma, Kushal and Kim, Tai Young and
   Lee, Seungmin and Kim, Ah-Reum and Kim, Min Young and Kim, Min-A and
   Lee, Mingyu and Han, Jin-Hee and Han, Jae Joon and Park, Hye-Rim and
