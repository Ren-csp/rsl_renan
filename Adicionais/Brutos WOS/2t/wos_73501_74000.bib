@article{ WOS:001849943900001,
Author = {Waghid, Zayd and Leitner, Susanne},
Title = {Cultivating critical global citizenship education through
   defamiliarisation and collaborative online international learning},
Journal = {INTERNATIONAL REVIEW OF EDUCATION},
Year = {2026},
Volume = {72},
Number = {4, SI},
Pages = {687-706},
Month = {AUG},
Abstract = {This study employed Norman Fairclough's three-dimensional approach to
   critical discourse analysis to investigate the potential of
   defamiliarisation, supported by collaborative online international
   learning, to help pre-service teachers in South Africa and Germany
   challenge neoliberalism and promote critical global citizenship. A group
   of pre-service teachers in South Africa and Germany (N = 54) were
   prompted to critically analyse capitalism's global influence and
   articulate their ideas using creative illustrations inspired by the
   short online film Marx and I. The resulting artwork of a sub-sample of
   the South African student teachers (n = 7) shows their individual and
   collective reflections on global injustice, capitalism and human rights
   abuses, while that of the German student teachers (n = 7) emphasises the
   refugee crisis in Europe, environmental degradation and social
   exclusion. The research highlights the usefulness of defamiliarisation
   in producing context-specific criticisms and transforming student
   teachers' perceptions of global socio-political environments. The
   authors found that defamiliarisation promotes a transdisciplinary
   approach to teacher education and is valuable for contesting neoliberal
   beliefs and prevailing narratives, thereby encouraging student teachers'
   critical engagement with global challenges.
   Cultiver une \& eacute;ducation \& agrave; la citoyennet \& eacute;
   mondiale critique par la d \& eacute;familiarisation et l'apprentissage
   collaboratif international en ligne - La pr \& eacute;sente \&
   eacute;tude utilise l'approche tridimensionnelle de l'analyse critique
   du discours de Norman Fairclough pour examiner le potentiel de la d \&
   eacute;familiarisation. Elle s'appuie sur l'apprentissage collaboratif
   international en ligne (Collaborative Online International Learning,
   COIL) afin d'amener de futurs enseignants en Afrique du Sud et en
   Allemagne \& agrave; remettre en question le n \& eacute;olib \&
   eacute;ralisme et \& agrave; promouvoir une \& eacute;ducation \&
   agrave; la citoyennet \& eacute; mondiale critique. Un groupe de futurs
   enseignants en Afrique du Sud et en Allemagne (N = 54) a \& eacute;t \&
   eacute; invit \& eacute; \& agrave; analyser de mani \& egrave;re
   critique l'influence mondiale du capitalisme et \& agrave; exprimer ses
   id \& eacute;es au moyen d'illustrations cr \& eacute;atives inspir \&
   eacute;es du court m \& eacute;trage en ligne Marx and I. Les
   productions artistiques d'un sous-\& eacute;chantillon des futurs
   enseignants sud-africains (n = 7) rendent compte de r \& eacute;flexions
   individuelles et collectives sur les injustices mondiales, le
   capitalisme et les atteintes aux droits humains. En revanche, celles des
   futurs enseignants allemands (n = 7) mettent davantage l'accent sur la
   crise des r \& eacute;fugi \& eacute;s en Europe, la d \&
   eacute;gradation de l'environnement et l'exclusion sociale. Les r \&
   eacute;sultats mettent en \& eacute;vidence l'int \& eacute;r \& ecirc;t
   de la d \& eacute;familiarisation pour produire des critiques dans des
   contextes sp \& eacute;cifiques et transformer la mani \& egrave;re dont
   les futurs enseignants per \& ccedil;oivent les environnements
   sociopolitiques mondiaux. Les auteurs montrent que la d \&
   eacute;familiarisation promeut une approche transdisciplinaire de la
   formation des enseignants et qu'elle constitue un pr \& eacute;cieux
   levier pour remettre en question les croyances n \& eacute;olib \&
   eacute;rales et les r \& eacute;cits dominants, encourageant ainsi un
   engagement critique des futurs enseignants face aux enjeux mondiaux.},
