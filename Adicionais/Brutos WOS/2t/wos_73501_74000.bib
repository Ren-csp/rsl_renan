@article{ WOS:001844197300008,
Author = {de Castro, Gardene Leao and Ferreira, Ana Beatriz Lopes},
Title = {Crisis management and repositioning: from Palestra Itália to Sociedade
   Esportiva Palmeiras},
Journal = {REVISTA INTERNACIONAL DE RELACIONES PUBLICAS},
Year = {2026},
Volume = {16},
Number = {31},
Pages = {129-148},
Month = {JAN-JUN},
Abstract = {This research aims to understand the transition from Palestra It \&
   aacute;lia to Sociedade Esportiva Palmeiras, analyzing everything from
   crisis management-marked by political pressures-to the repositioning of
   the new identity within the national sports landscape, with efforts to
   maintain closeness with its supporters. It explores the concepts of
   crisis management (Nunes, 2018), and also contextualizes the history of
   Palestra It \& aacute;lia/Palmeiras. The choice of this topic is
   justified not only by the historical relevance of the episode, but
   mainly by its communicational and institutional value. The case allows
   for reflection on the importance of communication strategies in crisis
   management, as well as highlighting how macro-environmental factors,
   such as the political and social context, directly influence
   organizational decisions. This represents a remarkable moment in the
   history of Brazilian football, demonstrating how a crisis can be
   transformed into an opportunity for repositioning and strengthening an
   institutional brand when managed effectively. The general objective of
   the research is to understand how Sociedade Esportiva Palmeiras dealt
   with the crisis and repositioned itself within the national sports
   scenario after the change in identity. To this end, the study sought to
   investigate the historical and political context that led to the club's
   name change, identify the communication strategies used in crisis
   management, analyze how the media at the time and in subsequent periods
   portrayed this transition, and, finally, understand how this moment is
   remembered by supporters based on their perceptions and memories. To
   achieve these objectives, a combined methodological approach was
   adopted, involving a case study, content analysis, and opinion research.
   The case study made it possible to understand the club's institutional
   positioning in the face of the crisis. Content analysis examined media
   coverage of the episode, while the opinion research aimed to capture the
   emotional memory of supporters. The combination of these methods enabled
   a broader and more in-depth analysis of the topic, articulating the
   historical, media, and emotional dimensions of the case under study. It
   was found that the actions were consistent with the models proposed by
   authors such as Neves (2002) and Forni (2017), who argue that crisis
   management is structured in three phases: before, during, and after the
   crisis. Palestra It \& aacute;lia demonstrated an understanding of the
   importance of these stages by anticipating preventive measures (such as
   restructuring its board and adapting the club's statutes), adopting
   immediate responses (changing its name and reinforcing symbolic elements
   of Brazilian identity), and rebuilding its image in the post-crisis
   period (with the ``Heroic Comeback{''} and the definitive adoption of
   the name Palmeiras). The research conducted with Palmeiras supporters
   confirmed that the crisis management and the team's repositioning were
   successful, as fans express, among other positive feelings, pride in
   this part of their history. Finally, beyond contributing to the
   understanding of this episode in the history of Palmeiras and Brazilian
   sport, the research also reinforces the importance of Public Relations.
   The notions of crisis management (Nunes, 2018) proved to be fundamental
   in analyzing how communication can not only respond to crises but also
   reposition brands and preserve the reputation of institutions.},
