@article{ WOS:000416545200032,
Author = {DiSantis, Katherine Isselmann and Kumanyika, Shiriki and Carter-Edwards,
   Lori and Rohm Young, Deborah and Grier, Sonya A. and Lassiter, Vikki},
Title = {Sensitizing Black Adult and Youth Consumers to Targeted Food Marketing
   Tactics in Their Environments},
