@article{ WOS:000749314100007,
Author = {Barbier-Torres, Lucia and Murray, Ben and Yang, Jin Won and Wang,
   Jiaohong and Matsuda, Michitaka and Robinson, Aaron and Binek,
   Aleksandra and Fan, Wei and Fernandez-Ramos, David and Lopitz-Otsoa,
   Fernando and Luque-Urbano, Maria and Millet, Oscar and Mavila, Nirmala
   and Peng, Hui and Ramani, Komal and Gottlieb, Roberta and Sun, Zhaoli
   and Liangpunsakul, Suthat and Seki, Ekihiro and Van Eyk, Jennifer E. and
   Mato, Jose M. and Lu, Shelly C.},
Title = {Depletion of mitochondrial methionine adenosyltransferase α1 triggers
   mitochondrial dysfunction in alcohol-associated liver disease},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {JAN 28},
Abstract = {MAT alpha 1 catalyzes the synthesis of S-adenosylmethionine, the
   principal biological methyl donor. Lower MAT alpha 1 activity and
   mitochondrial dysfunction occur in alcohol-associated liver disease.
   Besides cytosol and nucleus, MAT alpha 1 also targets the mitochondria
   of hepatocytes to regulate their function. Here, we show that
   mitochondrial MAT alpha 1 is selectively depleted in alcohol-associated
   liver disease through a mechanism that involves the isomerase PIN1 and
   the kinase CK2. Alcohol activates CK2, which phosphorylates MAT alpha 1
   at Ser114 facilitating interaction with PIN1, thereby inhibiting its
   mitochondrial localization. Blocking PIN1-MAT alpha 1 interaction
   increased mitochondrial MAT alpha 1 levels and protected against
   alcohol-induced mitochondrial dysfunction and fat accumulation.
   Normally, MAT alpha 1 interacts with mitochondrial proteins involved in
   TCA cycle, oxidative phosphorylation, and fatty acid beta-oxidation.
   Preserving mitochondrial MAT alpha 1 content correlates with higher
   methylation and expression of mitochondrial proteins. Our study
   demonstrates a role of CK2 and PIN1 in reducing mitochondrial MAT alpha
   1 content leading to mitochondrial dysfunction in alcohol-associated
   liver disease.
   Lower activity of MAT alpha 1, which catalyzes the synthesis of the
   methyl donor S-adenosylmethionine, and mitochondrial dysfunction occur
   in alcohol-associated liver disease (ALD). Here the authors report that
   the peptidyl-prolyl cis/trans isomerase PIN1 mediates a selective
   depletion of MAT alpha 1 in the mitochondria, which contributes to
   mitochondrial dysfunction and fat accumulation, in mouse models of ALD.},
