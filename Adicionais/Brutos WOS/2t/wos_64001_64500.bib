@article{ WOS:001590006900001,
Author = {Chen, Shufen and Lin, Meng and Taniguti, Cristiane H. and Tang, Xuemei
   and de la Torre, Fernando and Sideli, Gina M. and Iorizzo, Massimo and
   Edger, Patrick P. and Neyhart, Jeffrey and Zalapa, Juan and Bassil,
   Nahla and Heller-Uszynska, Kasia and Zhao, Dongyan and Beil, Craig T.
   and Sheehan, Moira J.},
Title = {A public mid-density genotyping platform for cultivated cranberry
   (Vaccinium macrocarpon Aiton)},
Journal = {PLANT GENOME},
Year = {2025},
Volume = {18},
Number = {4},
Month = {OCT 8},
Abstract = {Cranberry (Vaccinium macrocarpon Aiton), a native North American fruit
   crop, has gained global popularity due to its unique flavor and health
   benefits. As the market expands for new cranberry products, the
   requirements to produce varieties that meet new standards have
   increased. DNA-assisted breeding in cranberry has been limited due to
   the lack of cost-effective genotyping tools. To address this gap,
   Breeding Insight developed and validated a 3K DArTag panel. Target loci
   were strategically selected from 507K single-nucleotide polymorphisms
   (SNPs), generated from resequencing 53 diverse cultivated cranberry
   accessions. Selection criteria prioritized even genomic distribution,
   genic regions, maximum genetic diversity among North American breeding
   germplasm, and markers associated with known quantitative trait loci.
   The cranberry 3K DArTag panel was validated using a diverse collection
   of cranberry accessions, interspecific hybrids, and two F1 populations.
   The panel, optimized for cultivated V. macrocarpon, demonstrated a high
   average amplification rate (83.4\%) and robust performance in its close
   relatives, Vaccinium microcarpum and Vaccinium oxycoccos, as well as
   somewhat lower but acceptable performance in interspecific hybrids.
   However, transferability to the more distant blueberry was limited. The
   panel successfully revealed expected ploidy levels and population
   structure among the tested materials. Two individual linkage maps and
   one consensus map were constructed for the mapping populations, with an
   average marker density of 0.68 markers per centimorgan. This
   cost-effective (similar to\$15/sample), rapid genotyping platform offers
   valuable capabilities for public and private breeding programs. Its
   open-access nature enables genetic datasets generated from the marker
   panel to be compared and integrated across projects and geographical
   boundaries. Plain Language Summary<br /> Cranberries are a vital crop
   for human health and nutrition, yet few genomic tools exist to enhance
   breeding and selection for improved cranberry varieties. Here, we
   describe the creation of one such genomic tool: a DArTag genotyping
   marker panel that targets variants at 3000 sites across the cranberry
   genome. We demonstrate that data from this marker panel can elucidate
   genomic relationships, including dis-tinguishing samples with various
   genome-duplication levels (ploidies), identifying mislabeled accessions,
   and creating linkage maps from biparental populations. The DArTag panel
   offers several advantages important to cranberry breeders, including
   fast and affordable genotyping, SNP and microhaplotypes data outputs,
   and a more flexible platform for adding and removing markers as needed.
   The public release of this genomic tool lowers the barrier to entry for
   breeders in obtaining and using genomic data in cranberry breeding and
   crop improvement efforts.},
