@article{ WOS:001043676800020,
Author = {Melnyk, Bernadette Mazurek and Hsieh, Andreanna Pavan and Tan, Alai and
   McAuley, James W. and Matheus, Maritza and Larson, Bayli and Dopp, Anna
   Legreid},
Title = {The State of Health, Burnout, Healthy Behaviors, Workplace Wellness
   Support, and Concerns of Medication Errors in Pharmacists During the
   COVID-19 Pandemic},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2023},
