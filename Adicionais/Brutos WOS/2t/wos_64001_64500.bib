@article{ WOS:001351981700001,
Author = {Ng, Sai-Leung and Sun, Pei-Chuan},
Title = {Importance-Performance Analysis of the Sustainability of South Penghu
   Marine National Park, Taiwan},
Journal = {SUSTAINABILITY},
Year = {2024},
Volume = {16},
Number = {21},
Month = {NOV},
Abstract = {Despite the growing global focus on marine protected areas, there is a
   dearth of research addressing the comprehensive sustainability of such
   areas. This study fills the gap by evaluating the sustainability of
   South Penghu Marine National Park (SPMNP) using importance-performance
   analysis (IPA) across 18 sustainability indicators, encompassing
   environmental, economic, and social dimensions. The results reveal that
   environmental sustainability was rated as the most critical, with top
   indicators including protecting ecological habitats and marine wildlife.
   Performance scores were generally satisfactory, though disparities
   between importance and performance were noted, suggesting areas for
   improvement. Notably, all sustainability indicators are significantly
   below the threshold performance target of 75\%, indicating significant
   gaps in meeting public expectations. The analysis also highlights strong
   public support for both on-site and off-site management measures as key
   strategies to enhance park sustainability. This study provides valuable
   insights for policymakers and park managers aiming to improve the
   sustainability of marine protected areas.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Ng, SL (Corresponding Author), Chinese Culture Univ, Grad Inst Earth Sci, Taipei 111396, Taiwan.
   Ng, Sai-Leung; Sun, Pei-Chuan, Chinese Culture Univ, Grad Inst Earth Sci, Taipei 111396, Taiwan.},
