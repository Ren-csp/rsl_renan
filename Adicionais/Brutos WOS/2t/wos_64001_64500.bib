   Gerhardsson, Lars; Ahlstrand, Christina; Ersson, Per; Jonsson, Per; Gustafsson, Ewa, Univ Gothenburg, Dept Occupat \& Environm Med, Sch Publ Hlth \& Community Med, Inst Med,Sahlgrenska Acad, Medicinaregatan 16A,Box 414, SE-40530 Gothenburg, Sweden.},
DOI = {10.1007/s00420-021-01660-8},
