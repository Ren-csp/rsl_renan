@article{ WOS:000072731600002,
Author = {Hunt, S and Bennett, ATD and Cuthill, IC and Griffiths, R},
Title = {Blue tits are ultraviolet tits},
Journal = {PROCEEDINGS OF THE ROYAL SOCIETY B-BIOLOGICAL SCIENCES},
Year = {1998},
Volume = {265},
Number = {1395},
Pages = {451-455},
Month = {MAR 22},
Abstract = {The blue tit (Parus caeruleus) has been classified as sexually
   monochromatic. This classification is based on human colour perception
   yet, unlike humans, most birds have four spectrally distinct classes of
   cone and are visually sensitive to wavelengths in the near-ultraviolet
   (300-400 nm). Reflectance spectrophotometry reveals that blue tit
   plumage shows considerable reflection of UV light. For example, the blue
   crest shows peak reflectance at wavelengths around 352 nm. Furthermore,
   the blue tit is sexually dichromatic for multiple regions of plumage,
   including the crest. Choice trials performed in the laboratory indicate
   that females prefer males with the brightest crests. This study has
   implications for both intra-and interspecific studies of sexual
   selection, as well as future classification of dichromatism, which
   should not ignore the possibility of variation in reflectance in the UV.},
Publisher = {ROYAL SOC},
Address = {6-9 CARLTON HOUSE TERRACE, LONDON SW1Y 5AG, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Hunt, S (Corresponding Author), Sch Biol Sci, Ctr Behav Biol, Bristol BS8 1UG, Avon, England.
   Sch Biol Sci, Ctr Behav Biol, Bristol BS8 1UG, Avon, England.
   Univ Glasgow, Div Environm \& Evolut Biol, Glasgow G12 8QQ, Lanark, Scotland.},
DOI = {10.1098/rspb.1998.0316},
ISSN = {0962-8452},
EISSN = {1471-2954},
Keywords = {sexual selection; sexual dichromatism; UV vision; spectral reflectance;
   female choice; blue tit},
