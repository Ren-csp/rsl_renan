@article{ WOS:001579322100001,
Author = {Askari, Esmaiel and Savari, Moslem and Rezaei, Marzieh},
Title = {Analysis and modeling of key factors in implementing pre-flood
   protection measures in local communities in Iran},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {27},
Month = {SEP},
Abstract = {Floods pose significant and far-reaching threats to rural communities,
   particularly in regions where livelihoods rely heavily on agriculture
   and natural resources. These impacts include damage to agricultural
   land, loss of livestock, destruction of infrastructure, population
   displacement, and cascading economic, social, and environmental
   challenges. Such disruptions often drive increased migration from rural
   areas, especially in developing countries-raising the risk that large
   portions of these communities could eventually become uninhabitable.
   This study aimed to investigate the factors influencing the adoption of
   protective measures prior to flooding among rural populations in Iran.
   The research focused on households in Shushtar County, located in
   Khuzestan Province in southwestern Iran. Data were collected through a
   structured questionnaire, and the results were analyzed using structural
   equation modeling (SEM). The theoretical framework extended the
   protection motivation theory (PMT) by incorporating two additional
   variables: flood experience (FE) and social capital (SC), alongside the
   core constructs of perceived vulnerability (PV), response efficacy (RE),
   response cost (RC), and self-efficacy (SE). The enhanced model
   demonstrated a 22 \% improvement in predictive power compared to the
   original PMT, ultimately explaining 85.9 \% of the variance in the
   adoption of protective measures prior to flood events. These findings
   not only bridge a critical gap in the existing literature but also offer
   practical guidance for policymakers seeking to strengthen rural flood
   preparedness. The newly developed model provides a robust framework for
   designing targeted interventions to mitigate flood impacts and enhance
   community resilience.},
