@article{ WOS:000869060100001,
Author = {Wen, Yuanzhang},
Title = {RETRACTED: Analysis of Regional Economy Development on Local
   Environmental Protection and Natural Resources Utilization from the
   Perspective of Big Data (Retracted Article)},
