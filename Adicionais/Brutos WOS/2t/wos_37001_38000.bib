@article{ WOS:001843631200002,
Author = {Siddique, Mohammad R. H. and Hossain, Mahmood and Rashid, A. Z. M.
   Manzoor and Saha, Sanjoy},
Title = {From offender to defender? Rehabilitation and governance legitimacy in
   Madhupur Sal Forest co-management},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {3},
Month = {AUG},
Abstract = {In Bangladesh's Madhupur Sal Forest, the Forest Department implemented a
   co-management initiative (2009-2014) that converted convicted forest
   offenders-primarily illegal loggers and land encroachers-into paid
   Community Forest Workers responsible for forest patrolling and
   protection. Framed as a rehabilitative and participatory innovation, the
   program sought to align conservation objectives with social
   reintegration and livelihood support. Although offender inclusion is
   increasingly promoted within global co-management and community forestry
   agendas, its implications for legitimacy and justice remain poorly
   understood, particularly under top-down governance arrangements. Drawing
   on qualitative interviews and focus group discussions with local
   residents, ex-offenders, and Forest Department officials, this study
   examined stakeholder perceptions of the program's fairness,
   effectiveness, and legitimacy. Findings revealed widespread perceptions
   of moral inversion: individuals previously engaged in illegal extraction
   were materially rewarded while long-term law-abiding forest users
   remained unrecognized. Incomplete rehabilitation- characterized by
   unresolved legal cases, limited livelihood support, and elite
   capture-further undermined procedural, distributive, recognitional,
   restorative, and transformative justice. These failures eroded trust in
   both the Forest Department and co-management institutions, weakened
   cooperation, and, in some cases, reinforced continued dependence on
   illegal resource use. We argue that rehabilitation-based co-management
   is not inherently legitimizing. For such models to succeed, they must be
   empirically grounded, context-sensitive, and co-designed with
   communities to balance accountability with social reintegration. By
   conceptualizing moral inversion as a mechanism of legitimacy loss, the
   Madhupur case advances debates on offender-inclusive co-management,
   demonstrating that legitimacy emerges only when justice pillars are
   institutionally aligned and actively cultivated.},
