@article{ WOS:001821433100001,
Author = {Mukwevho, Phathutshedzo and Wesch, Nike Susan and Retief, Francois and
   Burger, Roelof Petrus and Moolna, Adam and Catney, Philip and Moolman,
   Jurie},
Title = {Institutional coherence, capacity and multi-stakeholder alignment shape
   the effectiveness of air-quality management instruments},
Journal = {JOURNAL OF ENVIRONMENTAL PLANNING AND MANAGEMENT},
Year = {2026},
Month = {2026 JUN 21},
Abstract = {Air Quality Management Plans (AQMPs) are strategic policy tools used to
   assess air quality, set objectives, and guide interventions at national,
   regional, and local levels. Despite their widespread adoption globally,
   air quality continues to deteriorate in many regions, raising concerns
   about their effectiveness in achieving intended outcomes. South Africa,
   with both an advanced air quality management framework and persistent
   pollution challenges, provides a useful case for evaluation. This study
   assesses the effectiveness of AQMPs by analysing the perceptions of key
   stakeholders. Semi-structured interviews were conducted with 40
   participants across four stakeholder groups: government, industry, civil
   society, and consultants. The findings suggest that the perceived
   ineffectiveness of AQMPs is driven less by the design of the plans
   themselves and more by broader governance challenges, including
   institutional fragmentation, weak implementation capacity, and unclear
   or poorly defined objectives, which collectively constrain their ability
   to achieve meaningful air quality improvements.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
