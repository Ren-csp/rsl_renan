@article{ WOS:000839044000001,
Author = {Probstl-Haider, Ulrike},
Title = {EIA Effectiveness in Sensitive Alpine Areas: A Comparison of Winter
   Tourism Infrastructure Development in Germany and Austria},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {15},
Month = {AUG},
Abstract = {The paper analyses the effectiveness of the environmental impact
   assessment (EIA) in sensitive alpine environments by studying processes
   and selected case studies in Austria and Germany. The framework used to
   evaluate the respective effectiveness is based on four dimensions of
   effectiveness: procedural, substantive, transactive and normative. The
   study is based on semi-structured interviews, workshops with key
   stakeholders and textual analysis of EIA documents, as well as the
   analysis of legal documents. The findings reveal significant differences
   between the two countries leading to lower transactive and lower
   normative effectiveness in Austria. The framework demonstrates its high
   suitability for analysing EIA effectiveness and for developing
   recommendations. The outcomes also underline the significant influence
   of the project type.},
