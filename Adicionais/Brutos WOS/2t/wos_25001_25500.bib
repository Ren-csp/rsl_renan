@article{ WOS:001755214700001,
Author = {Cardoso, Mardel Vinicius de Faria and Reis, Romulo Meira and Telles,
   Silvio de Cassio Costa},
Title = {MRVArena and local development: public policies, sports, and leisure as
   drivers of change},
Journal = {PODIUM-SPORT LEISURE AND TOURISM REVIEW},
Year = {2026},
Volume = {15},
Pages = {1-32},
Abstract = {Study objective: To analyze the social, sporting, and leisure impacts on
   the local population resulting from the construction of the MRV Arena,
   considering the influence of public policies on the project's design.
   Methodology/approach: Qualitative research based on unstructured guided
   interviews with key informants, supplemented by bibliographic and
   documentary research. The data were treated by content analysis,
   organized into two categories: Public Policies and Social, Sports, and
   Leisure Impacts. Originality/Relevance: Although the management of
   sports arenas is a field with a growing number of publications, the
   social and environmental impacts of the construction of new arenas in
   Brazil remain largely unexplored. This study contributes to filling this
   gap by analyzing a recent and complex case. Main results: The MRV Arena
   project presented significant environmental challenges, requiring
   studies such as EIA and EIV and the adoption of 84 conditions, including
   the expansion of green areas, a linear park, and social facilities such
   as a language center and health center. The creation of the Galo
   Institute stood out as a vector for social and sports actions, with
   projects such as the School of the Future, impacting more than 136,000
   people. Theoretical/methodological contributions: It is evident that
   public policies were essential driving forces (vectors) in establishing
   a balanced course of action between legislation and project objectives,
   aiming to minimize negative impacts and maximize social benefits.
   Social/management contributions: Environmental and social compensation
   measures were decisive in promoting change in the community, providing
   urban infrastructure, green spaces, and sports programs, setting a
   benchmark for future projects in Brazil.},
