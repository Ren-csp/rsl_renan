@article{ WOS:000279867100053,
Author = {Chodavarapu, Ramakrishna K. and Feng, Suhua and Bernatavichute, Yana V.
   and Chen, Pao-Yang and Stroud, Hume and Yu, Yanchun and Hetzel, Jonathan
   A. and Kuo, Frank and Kim, Jin and Cokus, Shawn J. and Casero, David and
   Bernal, Maria and Huijser, Peter and Clark, Amander T. and Kraemer, Ute
   and Merchant, Sabeeha S. and Zhang, Xiaoyu and Jacobsen, Steven E. and
   Pellegrini, Matteo},
Title = {Relationship between nucleosome positioning and DNA methylation},
