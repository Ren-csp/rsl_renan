@article{ WOS:001768105000001,
Author = {Lau, Sam S. S. and Fong, Jason W. L. and Zsido, Andras N. and Browning,
   Matthew H. E. M.},
Title = {Examining the multi-disciplinary origins of biophobia towards
   threatening and non-threatening wildlife in a highly urbanised city in
   China},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2338-2352},
Month = {JUL},
Abstract = {Urbanisation is reshaping how people experience wildlife, reducing our
   shared spaces with local biodiversity. Fewer opportunities for
   human-wildlife interactions weaken our emotional attachments to nature
   and precipitate a loss of species knowledge and familiarity. However, we
   still know little about why modern city residents have become
   increasingly fearful of both threatening and non-threatening animals. To
   address this gap, we surveyed 1430 adults in Hong Kong, a highly
   urbanised city in China, to examine how nature connectedness, disgust
   sensitivity and experiences with wildlife interact to predict biophobia
   across threatening animals (snakes and spiders) and non-threatening
   animals (small harmless animals, such as mice, bats and worms). Using
   structural equation modelling, we found that behavioural nature
   connectedness-how often people physically engage with nature-is the
   strongest protective factor against biophobia. In contrast,
   psychological nature connectedness only buffered threatening animal
   fears, revealing a critical role of engagement with natural environments
   in reducing fears for a multitude of small animals. Distinct disgust
   pathways also shaped biophobia: animal reminder disgust predicted fear
   of threatening animals, whereas blood-injection-injury fear was the
   strongest predictor of the fear of non-threatening animals. Most
   strikingly, fears of threatening animals (especially spiders) spilled
   over to fears of non-threatening animals, even after accounting for
   disgust, nature connectedness and gender, suggesting a previously
   underexplored generalisation process in biophobia. Contrary to the
   `vicious cycle of biophobia' model, sociocultural pathways-parental
   fears and personal experiences with animals-did not meaningfully explain
   this fear generalisation, implying that social transmissions of
   knowledge did not generalise biophobic responses between threatening and
   non-threatening animals. Our findings highlight the significant,
   opposing effects of disgust and physically engaging with nature on
   biophobia. Interventions that strengthen opportunities for direct nature
   experiences may be more effective than traditional, information-based
   approaches in reducing disgust and cultivating behavioural nature
   connectedness. This is important for reducing public fears, fostering
   coexistence and removing barriers for conservation efforts that benefit
   a broader spectrum of local species.Read the free for this article on
   the Journal blog.},
