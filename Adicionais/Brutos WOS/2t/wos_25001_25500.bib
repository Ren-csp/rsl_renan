@article{ WOS:001714836900008,
Author = {Tu, Wangjie and Theisen, Rachel Q. and Jin, Pengfei and Chenoweth, David
   M. and Patel, Amish J. and Good, Matthew C.},
Title = {Delivery of peptide coacervates to form stable interaction hubs in cells},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {FEB 2},
Abstract = {Cells contain membrane-bound and membraneless organelles that operate as
   spatially distinct biochemical niches. However, these reaction centers
   lose fidelity due to aging or diseases. A grand challenge for
   biomedicine is restoring or augmenting cellular functionalities. An
   excited strategy is the delivery of protein-based materials that can
   directly interact with cellular biological networks. In this study, we
   sought to develop long-lasting materials capable of cellular uptake,
   akin to intracellular interaction hubs. We develop a delivery method to
   efficiently transplant stable micron-size peptide-based compartments
   into living cells. By loading coacervates with nanobodies and
   bioPROTACs, we demonstrate successful target sequestration of natively
   expressed GFP to our synthetic hubs, and function as bioreactors to
   selectively degrade GFP inside human cells. These results represent an
   important step toward the development of synthetic organelles that can
   be fabricated in vitro and taken up by cells for applications in cell
   engineering and regenerative medicine.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Good, MC (Corresponding Author), Univ Penn, Bioengn Grad Grp, Philadelphia, PA 19104 USA.
   Good, MC (Corresponding Author), Univ Penn, Dept Cell \& Dev Biol, Philadelphia, PA 19104 USA.
