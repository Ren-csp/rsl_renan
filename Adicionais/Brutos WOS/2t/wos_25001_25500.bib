@article{ WOS:001735868700006,
Author = {Jurado-Gonzalez, David-Antonio},
Title = {Themes, conflicts, and discourses of environmental documentary cinema in
   France and Mexico},
Journal = {LETRAS VERDES},
Year = {2026},
Number = {39},
Pages = {116-137},
Month = {MAR-AUG},
Abstract = {Introduction: Environmental documentary cinema reflects social
   perceptions, political struggles, and cultural narratives that frame and
   reinforce discourses on ecological issues. Objective: This paper aims to
   conduct a thematic and discursive analysis comparing two film
   traditions-one Latin American and one European-to identify their
   contrasts, differences, and similarities concerning these issues.
   Methodology: Identified as capitalist processes of environmental
   degradation, their representation is analyzed through the
   geo-environmental, textual, and cultural frameworks that characterize
   them. Conclusions: In Mexico, the production of environmental
   documentary films has been shaped by a relatively unspecialized film
   industry. The ethnographic approach to environmental problems
   predominates. The depicted conflicts are primarily associated with
   biodiversity loss and hyperurbanization. There is also a notable
   emphasis on documenting collective legal actions. Moreover, the ideology
   of been vivir and a magical-religious worldview play a central role. In
   France, this type of production is more specialized. It adopts a
   predominantly educational approach, focusing on the country's key
   environmental challenges-such as agribusiness and biodiversity
