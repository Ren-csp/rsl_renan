@article{ WOS:A1959ZP92100002,
Author = {WADDINGTON, CH},
Title = {EVOLUTIONARY SYSTEMS - ANIMAL AND HUMAN},
Journal = {NATURE},
Year = {1959},
Volume = {183},
Number = {4676},
Pages = {1634-1638},
Abstract = {Present day biology envisions evolution as the result of interaction
   between a genetic system, characterized by random mutation, and natural
   selection. Both of these are pressures which arise externally, and to
   which the organism submits passively. Two further evolutionary factors
   are proposed. The 1st, termed the ``epigenetic system,{''} is concerned
   with the manner in which the information contained within the fertilized
   egg is expanded into the fully developed individual. Each organism in a
   population responds in some way to environmental stresses during its
   lifetime and there is naturally some genetic variation in the character
   and intensity of these responses. Natural selection will favor those of
   adaptive value. It can be expected that genotypes will be selected which
   will start developmental mechanisms, responding to environmental
   stresses by the production of a modification of adaptive value. Also,
   over a number of generations, selection for a particular environmental
   stress will build up a set of genotypes that will easily respond when
   this stress is applied. Developmental resistance to change may be enough
   to insure that this response will be exhibited to some extent even when
   the stress is removed. This presupposes a system that exactly mimics the
   inheritance of an acquired character, much as that suggested by Lamark,
   though operating by selection on the genetic structure of a population.
   Experimental evidence is offered for the above suppositions. The 2d new
   factor, termed the ``exploitive system,{''} is dependent on the behavior
   of the organism, particularly animals. Because the animal selects the
   particular environment in which it will live, it contributes much to the
   nature and intensity of the selective pressures to which it will be
   subjected. All these factors naturally persist in man, but because of
   the extremely rapid advances made by human society, they are not
   considered an adequate explanation for human evolution. A theory is
   proposed that is primarily one of cultural evolution, and it is
   suggested that there are parallels between this system and that of the
   biological system. These parallels are explained in detail.},
