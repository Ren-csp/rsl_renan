@article{ WOS:000250230600035,
Author = {Blaser, Martin J. and Kirschner, Denise},
Title = {The equilibria that allow bacterial persistence in human hosts},
Journal = {NATURE},
Year = {2007},
Volume = {449},
Number = {7164},
Pages = {843-849},
Month = {OCT 18},
Abstract = {We propose that microbes that have developed persistent relationships
   with human hosts have evolved cross-signalling mechanisms that permit
   homeostasis that conforms to Nash equilibria and, more specifically, to
   evolutionarily stable strategies. This implies that a group of highly
   diverse organisms has evolved within the changing contexts of variation
   in effective human population size and lifespan, shaping the equilibria
   achieved, and creating relationships resembling climax communities. We
   propose that such ecosystems contain nested communities in which
   equilibrium at one level contributes to homeostasis at another. The
   model can aid prediction of equilibrium states in the context of further
   change: widespread immunodeficiency, changing population densities, or
   extinctions.},
