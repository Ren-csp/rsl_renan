EISSN = {2072-845X},
Keywords = {climate change; colonial planning system; complexity theory; greenhouse
   gases; urbanisation},
Keywords-Plus = {URBANIZATION; EXPERIENCE; MANAGEMENT},
Research-Areas = {Social Sciences - Other Topics},
Web-of-Science-Categories  = {Social Sciences, Interdisciplinary},
