EISSN = {1939-1501},
Keywords = {parental smoking; attentional bias; dot probe; implicit bias},
Keywords-Plus = {CIGARETTE-SMOKING; ATTENTIONAL BIAS; AFFECT MISATTRIBUTION; AFFECTIVE
