@article{ WOS:000340880700001,
Author = {Aisbett, Emma and Steinhauser, Ralf},
Title = {Maintaining the Common Pool: Voluntary Water Conservation in Response to
   Varying Scarcity},
Journal = {ENVIRONMENTAL \& RESOURCE ECONOMICS},
Year = {2014},
Volume = {59},
Number = {2},
Pages = {167-185},
Month = {OCT},
Abstract = {Studies of voluntary conservation response to changing information about
   an environmental problem have traditionally been synonymous with studies
   of information campaign effectiveness. As such, they have not been able
   to capture the response to actual changes in the environment. This paper
   takes a novel approach to identifying voluntary conservation by studying
   the impact of changing storage levels on urban water usage in the
   context of a prolonged drought and a highly `water aware' community. Our
   results suggest that voluntary conservation increases substantially when
   water is scarce and the public value of the savings is greatest. We
   discuss the implications of these findings for our understanding of
   environmental information campaigns in general, and urban water demand
   management in particular.},
