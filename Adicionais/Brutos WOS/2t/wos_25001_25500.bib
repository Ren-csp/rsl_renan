@article{ WOS:001689496800001,
Author = {Royster, Rochele},
Title = {A Room of Our Own: Art Therapy Studios as Relational Ecosystems of Care
   in Schools},
Journal = {ART THERAPY},
Year = {2026},
Month = {2026 FEB 13},
Abstract = {Traditional education systems often marginalize neurodivergent students
   through rigid curricula, underfunding, and deficit-oriented practices,
   effects that are amplified for Black youth navigating intersecting forms
   of racism, ableism, and structural neglect. This study examines the
   Peace Room, an open art therapy studio embedded within an urban K-8
   public school, as a relational ecosystem where healing and learning
   converge. Using qualitative case study, reflexive practice, and
   arts-based inquiry, the research explores how collective artmaking,
   flexible spatial design, and culturally responsive facilitation promote
   regulation, belonging, and authorship for Black neurodivergent youth.
   Findings illustrate that the Peace Room, an open art therapy studio, not
   only supported students' emotional regulation and identity formation but
   also shaped interns' development as culturally humble, justice-oriented
   practitioners. By centering students as coauthors rather than recipients
   of intervention, the Peace Room emerges as a liberatory third space that
   reimagines schooling as a site of collective care, relational learning,
   and creative possibility.},
