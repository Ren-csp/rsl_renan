@article{ WOS:001285457700010,
Author = {Dong, Zheng and Ding, Ling and Meng, Zhou and Xu, Ke and Mao, Yongqi and
   Chen, Xiangxiang and Ye, Hailong and Poursaee, Amir},
Title = {Machine learning-based corrosion rate prediction of steel embedded in
   soil},
