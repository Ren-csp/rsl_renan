@article{ WOS:001735907900001,
Author = {Clement, Francis Deng and Zhou, Shutian},
Title = {Age-inclusive shared mobility via agent-based modeling: Lessons from
   China for African cities},
Journal = {SCIENTIFIC AFRICAN},
Year = {2026},
Volume = {32},
Month = {JUN},
Abstract = {This paper explores the impact of Autonomous Driving (AD) adoption and
   shared mobility systems on environmental sustainability, user
   preferences, and urban mobility network characteristics. As global
   demographics shift rapidly, providing optimal and effective
   transportation options for older adults is paramount. Conventional
   transportation systems often fail to meet these diverse needs, whereas
   Autonomous Mobility-on-Demand (AMoD) systems offer a bettermatched
   mobility paradigm for older people. The challenge lies in designing
   effective services based on sound estimates of older adults' mobility
   needs, which vary both over time and across space. To address this, we
   present an innovative agent-based model (ABM) developed to simulate the
   transportation needs of Nantong, China's ageing demographic. Developed
   using publicly available data and the Python programming language, this
   model was calibrated to reflect real-world travel patterns and to
   simulate the adoption of AMoD pickup services by the older population.
   The study investigates Autonomous Driving Systems (ADS), examining their
   efficiency and safety benefits, as well as drawbacks such as limited
   perception, rigid cooperation, and high computational costs. We also
   propose a comprehensive multi-modal travel planning system that
   incorporates public transportation, ride-pooling, and shared
   micro-mobility options. This approach is crucial for mitigating
   emissions and promoting sustainability. This approach is essential for
   mitigating emissions and promoting sustainability. While MARL-based
   strategies are suggested for optimal routing of Autonomous Vehicles
   (AVs), challenges such as heavy day-to-day traffic disruptions and
   extensive training times persist. The rejection rate drops from 53 to
   57\% (100 vehicles) to 25-32\% (500 vehicles), and AMoD is shown to
   significantly reduce private car use among older adults (from 89.4\% to
   31\% with 500 vehicles). Results indicate changes in mobility patterns
   that tend towards more sustainable modes of transport, as a function of
   utility, gender, and generation, with the e-bike seen as an alternative
   to the automobile. In summary, this paper reinforces the need to
   maintain a focus on realistic modeling and metrics in the era of AVs to
   support equitable and sustainable urban mobility. The findings can
   contribute to policy-making for AMoD systems, complementing those on
   public acceptance of AVs for AMoD. This working paper can provide
   policymakers with helpful guidance on designing efficient, personalized
   AMoD systems to meet the mobility needs of elderly residents. It offers
   lessons to non-African cities on how to accommodate rapid urbanization.},
