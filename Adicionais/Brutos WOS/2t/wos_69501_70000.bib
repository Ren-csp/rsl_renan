@article{ WOS:001357982900014,
Author = {Gibbs, Eric and Miao, Qi and Ferrolino, Mylene and Bajpai, Richa and
   Hassan, Aila and Phillips, Aaron H. and Pitre, Aaron and Kummerle,
   Rainer and Miller, Shondra and Nagy, Gergely and Leite, Wellington and
