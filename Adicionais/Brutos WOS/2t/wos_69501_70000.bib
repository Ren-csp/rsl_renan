@article{ WOS:000339067500003,
Author = {Montfort, Devlin and Brown, Shane and Shinew, Dawn},
Title = {The Personal Epistemologies of Civil Engineering Faculty},
Journal = {JOURNAL OF ENGINEERING EDUCATION},
Year = {2014},
