@article{ WOS:001410925600028,
Author = {Kang, Sungsu and Kim, Joodeok and Kim, Sungin and Chun, Hoje and Heo,
   Junyoung and Reboul, Cyril F. and Meana-Paneda, Ruben and Van, Cong T.
   S. and Choi, Hyesung and Lee, Yunseo and Rhee, Jinho and Lee, Minyoung
   and Kang, Dohun and Kim, Byung Hyo and Hyeon, Taeghwan and Han,
   Byungchan and Ercius, Peter and Lee, Won Chul and Elmlund, Hans and
   Park, Jungwon},
Title = {Time-resolved Brownian tomography of single nanocrystals in liquid
   during oxidative etching},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JAN 29},
Abstract = {Colloidal nanocrystals inherently undergo structural changes during
   chemical reactions. The robust structure-property relationships,
   originating from their nanoscale dimensions, underscore the significance
   of comprehending the dynamic structural behavior of nanocrystals in
   reactive chemical media. Moreover, the complexity and heterogeneity
   inherent in their atomic structures require tracking of structural
   transitions in individual nanocrystals at three-dimensional (3D) atomic
   resolution. In this study, we introduce the method of time-resolved
   Brownian tomography to investigate the temporal evolution of the 3D
   atomic structures of individual nanocrystals in solution. The
   methodology is applied to examine the atomic-level structural
   transformations of Pt nanocrystals during oxidative etching. The
   time-resolved 3D atomic maps reveal the structural evolution of
   dissolving Pt nanocrystals, transitioning from a crystalline to a
   disordered structure. Our study demonstrates the emergence of a phase at
   the nanometer length scale that has received less attention in bulk
   thermodynamics.},
