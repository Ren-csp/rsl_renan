@article{ WOS:A1994PY06300011,
Author = {PENLAND, JG},
Title = {DIETARY BORON, BRAIN-FUNCTION, AND COGNITIVE PERFORMANCE},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
