@article{ WOS:001051032800001,
Author = {Hara, Keishiro and Kuroda, Masashi and Nomaguchi, Yutaka},
Title = {How does research and development (R\&D) strategy shift by adopting
   imaginary future generations?-Insights from future design practice in a
   water engineering company},
Journal = {FUTURES},
Year = {2023},
Volume = {152},
Month = {SEP},
Abstract = {Conducting deliberation experiments involving the employees of a water
   engineering company, this study examined the effects that the adoption
   of ``imaginary future generations (IFGs),{''} an innovative approach to
   overcome intergenerational conflict by generating futurability, had on
   the design of a vision for business strategy in 2050 and a policy for a
   research and development (R \& D) strategy. Analysis was conducted using
   text mining of speech data recordings of participants' discussions. Data
   from questionnaire surveys administrated to all participants were also
   analyzed to examine possible changes in their perceptions about criteria
   for designing R \& D strategies. The results of the text mining revealed
   that by adopting IFGs, the speculative state of future society and
   business development as of 2050 and R \& D strategies were changed from
   when envisioning from the perspective of current generations. The
   results of the questionnaire survey showed that items of criteria for
   designing R \& D strategies, such as ``client needs,{''}
   ``differentiation from industry competitors,{''} ``cost,{''} and
   ``business models,{''} which had been emphasized when examined from the
   current generations' perspective as important indicators, decreased in
   importance by adopting IFGs. We conclude that the adoption of IFGs could
   shift R \& D strategy and induce new directions of technological
   innovations from the viewpoint of futurability.},
