@article{ WOS:000461441000001,
Author = {Bolsen, Toby and Palm, Risa and Kingsland, Justin T.},
Title = {Counteracting Climate Science Politicization With Effective Frames and
   Imagery},
Journal = {SCIENCE COMMUNICATION},
Year = {2019},
Volume = {41},
Number = {2},
Pages = {147-171},
Month = {APR},
Abstract = {Politicization of science occurs when the inherent uncertainty of
   science is emphasized to cast doubt on scientific consensus. Climate
   change has become particularly susceptible to this kind of
   politicization. In this article, we report the results of a survey
   experiment in which we manipulated text frames and visual imagery
   associated with two types of environmental hazards linked to climate
   change-sea level rise with associated flooding and increased heat levels
   with associated drought and wildfires. We present evidence that the use
   of visual imagery can counter the effects that science politicization
   has on climate change beliefs and behaviors.},
