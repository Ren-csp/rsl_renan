@article{ WOS:001525835000001,
Author = {Beilby, Hannah and Spinks, Jean and Cruwys, Tegan and Rose, Christiern},
Title = {Addressing loneliness through a scalable neighbourhood connection
   campaign: an evaluation of Neighbour Day using an Australian
   population-based control and causal propensity score-based approaches},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2025},
Volume = {105},
Month = {AUG},
Abstract = {Background: Most loneliness interventions are highly structured and
   incur considerable costs for staff training and one-on-one or
   group-based program delivery. Relatively little is known about the
   effects and costs of community-based interventions. Neighbour Day is a
   year-round community development campaign in Australia with a focus on
   inclusion and connection, making others welcome, and building respectful
   relationships. The annual ``Day of Action{''} on the last Sunday in
   March usually involves events centred around sharing food but captures
   an extremely diverse range of activities. Methods: This study estimates
   the pre-pandemic effect of the 2019 Neighbour Day event on loneliness by
   comparing survey respondents (N = 187) to a nationally representative
   sample (N = 8114) from the Household, Income and Labour Dynamics in
   Australia (HILDA) survey. We use inverse probability weighted regression
   adjustment to account for selection effects using propensity scores. We
   contribute to sparse evidence on loneliness interventions by exploring
   the effect using different estimators, including covariate-balancing
   weighting and fine stratification matching. We simultaneously explore
   multiple pathways related to the social environment guided by the Social
   Identity Model of Neighbourhood Mental Health, including neighbourhood
   identification, perceived neighbourhood cohesiveness and quality.
   Findings: The results bolster confidence in our base estimate of 8.6 \%
   reduction in loneliness prevalence, which could translate into more than
   2 million fewer lonelier Australians. The concordance of treatment
   effects across propensity score methods {[}range: 8.4-15.9 \% reduction]
   indicate our estimated treatment effect is robust. Addition of
   identification and perception factors increase the base estimate by up
   to 85 \%. We believe these effects are crucial to understanding causal
   pathways underlying neighbourhood connection and loneliness.},
