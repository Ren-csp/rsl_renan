@article{ WOS:000679406500117,
Author = {Muljajew, Irina and Huschke, Sophie and Ramoji, Anuradha and Cseresnyes,
   Zoltan and Hoeppener, Stephanie and Nischang, Ivo and Foo, Wanling and
   Popp, Juergen and Figge, Marc Thilo and Weber, Christine and Bauer,
   Michael and Schubert, Ulrich S. and Press, Adrian T.},
Title = {Stealth Effect of Short Polyoxazolines in Graft Copolymers: Minor
   Changes of Backbone End Group Determine Liver Cell-Type Specificity},
Journal = {ACS NANO},
Year = {2021},
