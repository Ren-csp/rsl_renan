@article{ WOS:A1991FN08900003,
Author = {MULLERBOKER, U},
Title = {KNOWLEDGE AND EVALUATION OF THE ENVIRONMENT IN TRADITIONAL SOCIETIES OF
   NEPAL},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
Year = {1991},
Volume = {11},
Number = {2},
Pages = {101-114},
Month = {MAY},
Abstract = {In the interpretation of ecological relations problems of understanding
   frequently occur between scientists or experts educated in the West and
   the local population.  As a basis for ecologically sound environmental
   planning, one that does not bypass the needs of the population, the ways
   the environment is preceived and evaluated must therefore also be
   elucidated.  A line of research that sets itself the task of analyzing
   ethnospecific knowledge of the environment and the resulting behavior of
   traditional societies can be set within the context of geographical
   ``man-environment{''} concepts, as well as within ``studies in
   ethnoscience,{''} in particular ethnoecological and classificatory
   approaches.  Two examples of knowledge and evaluation of the natural
   environment are presented in the following:  1) The soils in Gorkha from
   the perspective of the local population (Middle Hills of Nepal); II)
   Knowledge and evaluation of the environment among the Chitawan Tharus: 
   the example of the forests and grasslands (Rapti Dun, Churia Range).  1},
