@article{ WOS:001493731800005,
Author = {Osman, Eliyasu Y. and Bergtold, Jason S.},
Title = {Variation in intensity of adoption of alternative tillage practices by
   farmers: Influence of crop rotation, site-specific and risk factors},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2025},
Volume = {385},
Month = {JUN},
Abstract = {The paper assesses the intensity of adoption of alternative tillage
   practices at the farm level by crop. We define intensity of adoption as
   the percentage of cropland for a specific crop devoted to a specific
   tillage practice. Tillage practices examined include no-tillage,
   conservation tillage, and historical tillage practices. We examined if
   tillage decisions are dependent on crop rotation choices and how this
   influences the intensity of adoption. We explore the influence of
   geographical and biophysical factors, such as soil type, local weather,
   and geographical location on adoption intensity. Other factors explored
   include risk aversion, crop insurance, farmer perceptions, and farm
   characteristics. We estimate a series of Tobit regression models using
   primary survey data of 364 farmers in the US Midwestern state of Kansas.
   We find intensity of adoption of no-tillage and conservation tillage are
   dependent on crop rotational choices, especially for rotations with
   wheat. Intensity of adoption is influenced by temperature, soil
   characteristics, and farmer perceptions. Insurance plays a sizable role
   in shaping tillage decisions, increasing the intensity of adoption of
   alternative tillage practices. Findings highlight other factors
   influencing the intensity of adoption at the crop-farm level and
   elucidating crop-specific factors shape adoption, as well. Findings can
   help shape extension education about factors influencing and effects
   from switching tillage practices between crops, as well as messaging for
   promotion of conservation tillage practices. Findings can help inform
   policy about the connection between no-till and conservation tillage
   adoption and crop insurance, and the role it plays in promoting
   conservation through federal crop insurance programs.},
