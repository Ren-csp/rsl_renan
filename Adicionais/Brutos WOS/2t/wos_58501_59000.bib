@article{ WOS:000500821000001,
Author = {Tissen, Carolin and Benz, Susanne A. and Menberg, Kathrin and Bayer,
   Peter and Blum, Philipp},
Title = {Groundwater temperature anomalies in central Europe},
Journal = {ENVIRONMENTAL RESEARCH LETTERS},
Year = {2019},
Volume = {14},
