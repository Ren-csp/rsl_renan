@article{ WOS:000408134600006,
Author = {Choi, Won-Gyu and Miller, Gad and Wallace, Ian and Harper, Jeffrey and
   Mittler, Ron and Gilroy, Simon},
Title = {Orchestrating rapid long-distance signaling in plants with
   Ca2+, ROS and electrical signals},
