@article{ WOS:001051523700024,
Author = {Fu, Boyang and Pazokitoroudi, Ali and Sudarshan, Mukund and Liu,
   Zhengtong and Subramanian, Lakshminarayanan and Sankararaman, Sriram},
Title = {Fast kernel-based association testing of non-linear genetic effects for
   biobank-scale data},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {AUG 15},
Abstract = {Our knowledge of non-linear genetic effects on complex traits remains
   limited, in part, due to the modest power to detect such effects. While
   kernel-based tests offer a versatile approach to test for non-linear
   relationships between sets of genetic variants and traits, current
   approaches cannot be applied to Biobank-scale datasets containing
   hundreds of thousands of individuals. We propose, FastKAST, a
   kernel-based approach that can test for non-linear effects of a set of
   variants on a quantitative trait. FastKAST provides calibrated
   hypothesis tests while enabling analysis of Biobank-scale datasets with
   hundreds of thousands of unrelated individuals from a homogeneous
   population. We apply FastKAST to 53 quantitative traits measured across
   \& AP; 300 K unrelated white British individuals in the UK Biobank to
   detect sets of variants with non-linear effects at genome-wide
   significance.
   We have developed FastKAST, a highly-scalable algorithm to identify
   non-linear genetic effects on complex traits in large datasets. Applied
   to 300K UK Biobank individuals, we successfully detected significant
   non-linear effects across 53 traits.},
