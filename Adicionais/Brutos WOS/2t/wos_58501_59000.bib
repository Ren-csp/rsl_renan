@article{ WOS:001597228900001,
Author = {Li, Shichuan and Li, Chenyu},
Title = {Exploring pathways for enhancing green total factor productivity in
   high-carbon emission enterprises: A configurational analysis based on
   the TOE framework and fsQCA},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {In response to escalating global environmental and climate challenges,
   the green transformation of high-carbon emission enterprises has become
   a critical issue. Building on the Technology-Organization-Environment
   (TOE) framework and employing fuzzy-set qualitative comparative analysis
   (fsQCA), this study investigates the key factors influencing Green Total
   Factor Productivity (GTFP) in high-carbon emission enterprises and
   explores multiple configurational pathways for its enhancement. The
   findings indicate that Green Technology Capability, Digital
   Transformation, Executives' Green Perception, Organizational Resilience,
   ESG Performance, and Government Subsidies do not serve as necessary
   conditions for achieving high GTFP individually. However, various
   combinations of these factors enable multiple viable pathways,
   categorized into three types: (1) a Green Technology and
   Government-Driven Pathway, (2) a Digitalization and Government-Led
   Pathway, and (3) a MultiFactor Synergistic Pathway. The substitutive
   relationships among certain factors highlight the feasibility of diverse
   green development strategies. The study provides theoretical and
   managerial implications, suggesting that enterprises should enhance
   green technology innovation, digital transformation, and cross-sector
   collaboration, while governments should strengthen policy support
   through subsidies, tax incentives, and green financing. From a
   configurational perspective, high-carbon emission enterprises can
   achieve sustainable development by optimizing resource conditions and
   selecting tailored green transformation pathways. These findings
   contribute to the literature on industrial green transformation and
   provide strategic guidance for enterprises and policymakers in advancing
   sustainable and high-quality development.},
