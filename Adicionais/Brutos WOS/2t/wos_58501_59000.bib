@article{ WOS:000712007100014,
Author = {Wang, Jiajia and Wang, Jiaying and Hong, Wenxiang and Zhang, Lulu and
   Song, Liqian and Shi, Qi and Shao, Yanfei and Hao, Guifeng and Fang,
   Chunyan and Qiu, Yueping and Yang, Lijun and Yang, Zhaoxu and Wang,
   Jincheng and Cao, Ji and Yang, Bo and He, Qiaojun and Weng, Qinjie},
Title = {Optineurin modulates the maturation of dendritic cells to regulate
   autoimmunity through JAK2-STAT3 signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {OCT 27},
Abstract = {Optineurin (OPTN) has important functions in diverse biological
   processes and diseases, but its effect on dendritic cell (DC)
   differentiation and functionality remains elusive. Here we show that
   OPTN is upregulated in human and mouse DC maturation, and that deletion
   of Optn in mice via CD11c-Cre attenuates DC maturation and impairs the
   priming of CD4(+) T cells, thus ameliorating autoimmune symptoms such as
   experimental autoimmune encephalomyelitis (EAE). Mechanistically, OPTN
   binds to the JH1 domain of JAK2 and inhibits JAK2 dimerization and
   phosphorylation, thereby preventing JAK2-STAT3 interaction and
   inhibiting STAT3 phosphorylation to suppress downstream transcription of
   IL-10. Without such a negative regulation, Optn-deficient DCs eventually
   induce an IL-10/JAK2/STAT3/IL-10 positive feedback loop to suppress DC
   maturation. Finally, the natural product, Saikosaponin D, is identified
   as an OPTN inhibitor, effectively inhibiting the immune-stimulatory
   function of DCs and the disease progression of EAE in mice. Our findings
   thus highlight a pivotal function of OPTN for the regulation of DC
   functions and autoimmune disorders.
   Optineurin (OPTN) has been implicated in various biological processes,
   but its function in dendritic cells (DC) maturation is still unclear.
   Here the authors show, by characterizing Optn-conditional knockout mice,
   that the loss of OPTN induces Jak2/Stat3 activation and IL-10 production
   to suppress DC maturation and function, thereby ameliorating autoimmune
   responses in mice.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Weng, QJ (Corresponding Author), Zhejiang Univ, Coll Pharmaceut Sci, Ctr Drug Safety Evaluat \& Res, Zhejiang Prov Key Lab Anticanc Drug Res, Hangzhou 310058, Peoples R China.
   Wang, Jiajia; Wang, Jiaying; Hong, Wenxiang; Zhang, Lulu; Song, Liqian; Shi, Qi; Fang, Chunyan; Qiu, Yueping; Yang, Lijun; Yang, Zhaoxu; Wang, Jincheng; Cao, Ji; Yang, Bo; He, Qiaojun; Weng, Qinjie, Zhejiang Univ, Coll Pharmaceut Sci, Ctr Drug Safety Evaluat \& Res, Zhejiang Prov Key Lab Anticanc Drug Res, Hangzhou 310058, Peoples R China.
