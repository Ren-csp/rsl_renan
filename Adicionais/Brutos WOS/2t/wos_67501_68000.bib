@article{ WOS:000872766300011,
Author = {Cioce, Anna and Calle, Beatriz and Rizou, Tatiana and Lowery, Sarah C.
   and Bridgeman, Victoria and Mahoney, Keira E. and Marchesi, Andrea and
   Bineva-Todd, Ganka and Flynn, Helen and Li, Zhen and Tastan, Omur Y. and
   Roustan, Chloe and Soro-Barrio, Pablo and Wood, Thomas M. and Keenan,
   Tessa and Both, Peter and Huang, Kun and Parmeggiani, Fabio and
   Snijders, Ambrosius P. and Skehel, Mark and Kjaer, Svend and Fascione,
