@article{ WOS:001698899600001,
Author = {Melese, Mastawal and Anteneh, Mesfin and Bantigegn, Simachew},
Title = {Evaluating institutional effectiveness in urban climate governance: The
   case of Bahir Dar City, Northwestern Ethiopia},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {29},
Month = {JAN},
Abstract = {Rapid urbanization and climate change present a serious dual challenge
   for cities in the Global South. Effective Urban Climate Governance (UCG)
   is vital for building resilience, yet its institutional effectiveness
   remains under-examined. This study provides a mixed-methods assessment
   of UCG in Bahir Dar, Ethiopia. Quantitative data from a survey of 162
   experts were analyzed using the Relative Importance Index (RII) and
   Analysis of Variance (ANOVA), and systematically triangulated with
   qualitative insights from 16 key informant interviews and document
   analysis. The results reveal a critically inadequate governance system
   (Overall Index = 0.489). The most significant finding is a systemic
   ``policy-implementation chasm{''} while formal accountability mechanisms
   showed moderate functionality (RII = 0.639), they were rendered
   ineffective by a near-total failure in the enforcement of climate laws
   (RII = 0.400); the weakest link in the entire governance chain.
   Inferential analysis confirmed this structural disconnect, revealing a
   significant perceptual gap (p < 0.05) between regional and local
   officials regarding awareness-raising efforts. This core failure was
   compounded by profound weaknesses in participation, equity, and
   institutional capacity. The study's primary limitation is its reliance
   on government expert perceptions for quantitative data, a constraint
   mitigated by qualitative triangulation with non-state actors. The study
   concludes that Bahir Dar's UCG framework is a primary barrier to
   achieving climate resilience. Transformative reforms focusing on legal
   enforcement and inclusive participation are urgently needed. This study
   offers a replicable framework for diagnosing UCG effectiveness in
   similar rapidly urbanizing contexts.},
