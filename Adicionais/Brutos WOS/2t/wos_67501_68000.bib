
@article{ WOS:000856283800005,
Author = {Bergez, J-E and Bethinger, A. and Bockstaller, C. and Cederberg, C. and
   Ceschia, E. and Guilpart, N. and Lange, S. and Muller, F. and Reidsma,
   P. and Riviere, C. and Schader, C. and Therond, O. and van der Werf, H.
