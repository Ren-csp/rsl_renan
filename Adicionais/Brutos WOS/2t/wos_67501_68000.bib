@article{ WOS:001475885000001,
Author = {Firestone, Michelle and Khoee, Kimia and Kolla, Gillian and O'Campo,
   Patricia and Nisenbaum, Rosane and Holness, D. Linn and Schlosser, Lisa
   and Beder, Michaela and Steer, Lorie and Pariseau, Terry and Bayoumi,
   Ahmed M.},
Title = {COVID-19 isolation and recovery sites evaluation: Lessons learned for
   systems innovation},
Journal = {CANADIAN JOURNAL OF PUBLIC HEALTH-REVUE CANADIENNE DE SANTE PUBLIQUE},
Year = {2025},
Volume = {116},
Number = {6},
Pages = {906-915},
Month = {DEC},
Abstract = {ObjectiveThe City of Toronto opened COVID-19 Isolation and Recovery
   Sites (CIRS) in 2020 in response to the need for supported isolation
   spaces for people experiencing homelessness. As a team of academic
   researchers and community partners, we assessed how lessons from the
   CIRS can inform post-pandemic policies for people experiencing
   homelessness. We focused on identifying models and systems of care for
   understanding existing services and integration, identifying
   innovations, and imagining how care can be transformed to be more caring
   and just.MethodsWe conducted 43 key informant interviews with
   clinicians, peer and harm reduction workers, executive leaders,
   operational leaders, and people who worked for funding or
   decision-making organizations. Data were coded and analyzed using
   deductive content analysis.ResultsThe CIRS presented a new service model
   that moved away from being overly medicalized towards having a community
   orientation, which involved greater integration of services for people
   experiencing homelessness, transparent decision-making, and open
   communication. Key to this approach were clinical case management, harm
   reduction services, strong support of peer workers, and adequate and
   consistent funding. Future models will need to address power imbalances
   and hierarchies through formal agreements and processes as well as
   establishing collaborative cultures.ConclusionThe CIRS offer an
   important opportunity to rethink services offered within shelter
   settings. Such change will require a strong vision, sufficient funding,
   political will, and accountability among all stakeholders. The COVID-19
   pandemic offers decision makers an opportunity to consider system-level
   transformation by looking at largely successful elements of the crisis
   responses.
   ObjectifLa Ville de Toronto a ouvert en 2020 des installations
   d'isolement et de r \& eacute;tablissement (les CIRS) en r \&
   eacute;ponse au besoin d'espaces d'isolement supervis \& eacute;s pour
   les personnes aux prises avec le sans-abrisme pendant la COVID-19. Notre
   \& eacute;quipe de chercheurs et de chercheuses universitaires et de
   partenaires associatifs a \& eacute;valu \& eacute; les le \& ccedil;ons
   de ces CIRS susceptibles d'\& eacute;clairer les politiques pour les
   personnes aux prises avec le sans-abrisme apr \& egrave;s la pand \&
   eacute;mie. Nous avons cherch \& eacute; \& agrave; r \&
   eacute;pertorier les mod \& egrave;les et les syst \& egrave;mes de
   soins pour comprendre les services existants et leur int \&
   eacute;gration, rep \& eacute;rer les innovations et imaginer des moyens
   de transformer les soins pour les rendre plus bienveillants et plus \&
   eacute;quitables.M \& eacute;thodeNous avons men \& eacute; 43
   entretiens avec des informateurs et des informatrices: des cliniciennes
   et des cliniciens, des pairs aidants, des intervenantes et des
   intervenants en r \& eacute;duction des m \& eacute;faits, des cadres
   dirigeants, des cadres op \& eacute;rationnels et des membres du
   personnel d'organismes d \& eacute;cisionnels ou de financement. Les
   donn \& eacute;es ont \& eacute;t \& eacute; cod \& eacute;es et analys
   \& eacute;es au moyen d'analyses de contenu d \& eacute;ductives.R \&
   eacute;sultatsLe nouveau mod \& egrave;le de services des CIRS s'\&
   eacute;carte de la m \& eacute;dicalisation \& agrave; outrance pour
   adopter une orientation communautaire impliquant l'int \& eacute;gration
   accrue des services aux personnes aux prises avec le sans-abrisme, la
   transparence des processus d \& eacute;cisionnels et l'ouverture dans
   les communications. Sont essentiels \& agrave; cette approche la gestion
   des cas cliniques, les services de r \& eacute;duction des m \&
   eacute;faits, l'appui solide de pairs aidants et des fonds suffisants et
   r \& eacute;guliers. Les mod \& egrave;les futurs devront aborder les d
   \& eacute;s \& eacute;quilibres et les hi \& eacute;rarchies de pouvoir
   au moyen d'ententes et de processus officiels et en \& eacute;tablissant
   une culture de collaboration.ConclusionLes CIRS permettent de repenser
   les services fournis dans les refuges. Ce nouveau mod \& egrave;le de
   services n \& eacute;cessitera une vision claire, des fonds suffisants,
   une volont \& eacute; politique et la responsabilisation des parties
   prenantes. La pand \& eacute;mie de COVID-19 est l'occasion pour les d
   \& eacute;cideurs d'envisager des transformations syst \& eacute;miques
   en se penchant sur les aspects les plus probants des interventions face
   \& agrave; la crise.},
