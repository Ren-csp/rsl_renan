@article{ WOS:000417242000004,
Author = {Green, Rebecca M. and Fish, Jennifer L. and Young, Nathan M. and Smith,
   Francis J. and Roberts, Benjamin and Dolan, Katie and Choi, Irene and
   Leach, Courtney L. and Gordon, Paul and Cheverud, James M. and Roseman,
   Charles C. and Williams, Trevor J. and Marcucio, Ralph S. and
   Hallgrimsson, Benedikt},
Title = {Developmental nonlinearity drives phenotypic robustness},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {DEC 6},
Abstract = {Robustness to perturbation is a fundamental feature of complex
   organisms. Mutations are the raw material for evolution, yet robustness
   to their effects is required for species survival. The mechanisms that
   produce robustness are poorly understood. Nonlinearities are a
   ubiquitous feature of development that may link variation in development
   to phenotypic robustness. Here, we manipulate the gene dosage of a
   signaling molecule, Fgf8, a critical regulator of vertebrate
   development. We demonstrate that variation in Fgf8 expression has a
   nonlinear relationship to phenotypic variation, predicting levels of
   robustness among genotypes. Differences in robustness are not due to
   gene expression variance or dysregulation, but emerge from the
   nonlinearity of the genotype-phenotype curve. In this instance, embedded
   features of development explain robustness differences. How such
   features vary in natural populations and relate to genetic variation are
   key questions for unraveling the origin and evolvability of this feature
   of organismal development.},
