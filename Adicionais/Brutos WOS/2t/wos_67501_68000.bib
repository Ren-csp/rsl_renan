@article{ WOS:000394134900008,
Author = {Mamtani, Ravinder and Cheema, Sohaila and Sheikh, Javaid and Al Mulla,
   Ahmad and Lowenfels, Albert and Maisonneuve, Patrick},
Title = {Cancer risk in waterpipe smokers: a meta-analysis},
