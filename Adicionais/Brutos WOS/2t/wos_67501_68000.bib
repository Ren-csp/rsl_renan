@article{ WOS:000414534500001,
Author = {Zhang, Wei and Westerman, Erica and Nitzany, Eyal and Palmer, Stephanie
   and Kronforst, Marcus R.},
Title = {Tracing the origin and evolution of supergene mimicry in butterflies},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {NOV 7},
Abstract = {Supergene mimicry is a striking phenomenon but we know little about the
   evolution of this trait in any species. Here, by studying genomes of
   butterflies from a recent radiation in which supergene mimicry has been
   isolated to the gene doublesex, we show that sexually dimorphic mimicry
   and female-limited polymorphism are evolutionarily related as a result
   of ancient balancing selection combined with independent origins of
   similar morphs in different lineages and secondary loss of polymorphism
   in other lineages. Evolutionary loss of polymorphism appears to have
   resulted from an interaction between natural selection and genetic
   drift. Furthermore, molecular evolution of the supergene is dominated
   not by adaptive protein evolution or balancing selection, but by
   extensive hitchhiking of linked variants on the mimetic dsx haplotype
   that occurred at the origin of mimicry. Our results suggest that chance
   events have played important and possibly opposing roles throughout the
   history of this classic example of adaptation.},
