@article{ WOS:000334297600001,
Author = {Kaittanis, Charalambos and Shaffer, Travis M. and Ogirala, Anuja and
   Santra, Santimukul and Perez, J. Manuel and Chiosis, Gabriela and Li,
   Yueming and Josephson, Lee and Grimm, Jan},
Title = {Environment-responsive nanophores for therapy and treatment monitoring
   via molecular MRI quenching},
Journal = {NATURE COMMUNICATIONS},
Year = {2014},
Volume = {5},
Month = {MAR},
Abstract = {The effective delivery of therapeutics to disease sites significantly
   contributes to drug efficacy, toxicity and clearance. Here we
   demonstrate that clinically approved iron oxide nanoparticles
   (Ferumoxytol) can be utilized to carry one or multiple drugs. These so
   called `nanophores' retain their cargo within their polymeric coating
   through weak electrostatic interactions and release it in slightly
   acidic conditions (pH 6.8 and below). The loading of drugs increases the
   nanophores' transverse T2 and longitudinal T1 nuclear magnetic resonance
   (NMR) proton relaxation times, which is proportional to amount of
   carried cargo. Chemotherapy with translational nanophores is more
   effective than the free drug in vitro and in vivo, without subjecting
   the drugs or the carrier nanoparticle to any chemical modification.
   Evaluation of cargo incorporation and payload levels in vitro and in
   vivo can be assessed via benchtop magnetic relaxometers, common NMR
   instruments or magnetic resonance imaging scanners.},
