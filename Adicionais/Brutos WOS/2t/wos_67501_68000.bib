@article{ WOS:001291857100034,
Author = {Kim, Changin and Yun, So Ri and Lee, Sang Jin and Kim, Seong Ok and Lee,
   Hyosub and Choi, Jungkweon and Kim, Jong Goo and Kim, Tae Wu and You,
   Seyoung and Kosheleva, Irina and Noh, Taeyoon and Baek, Jonghoon and
   Ihee, Hyotcherl},
Title = {Structural dynamics of protein-protein association involved in the
   light-induced transition of Avena sativa LOV2 protein},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {AUG 14},
Abstract = {The Light-oxygen-voltage-sensing domain (LOV) superfamily, found in
   enzymes and signal transduction proteins, plays a crucial role in
   converting light signals into structural signals, mediating various
   biological mechanisms. While time-resolved spectroscopic studies have
   revealed the dynamics of the LOV-domain chromophore's electronic
   structures, understanding the structural changes in the protein moiety,
   particularly regarding light-induced dimerization, remains challenging.
   Here, we utilize time-resolved X-ray liquidography to capture the
   light-induced dimerization of Avena sativa LOV2. Our analysis unveils
   that dimerization occurs within milliseconds after the unfolding of the
   A'alpha and J alpha helices in the microsecond time range. Notably, our
   findings suggest that protein-protein interactions (PPIs) among the
   beta-scaffolds, mediated by helix unfolding, play a key role in
   dimerization. In this work, we offer structural insights into the
   dimerization of LOV2 proteins following structural changes in the
   A'alpha and J alpha helices, as well as mechanistic insights into the
   protein-protein association process driven by PPIs.},
