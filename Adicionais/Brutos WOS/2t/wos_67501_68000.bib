@article{ WOS:001292158300004,
Author = {Diez-Arcon, Paz and Martin-Monje, Elena},
Title = {Training in Digital and Didactic Competences for Future Foreign Language
   Teachers: Reflecting on the Learning Process},
Journal = {RESEARCH IN EDUCATION AND LEARNING INNOVATION ARCHIVES-REALIA},
