   Yu, Clinton; Huang, Lan, Univ Calif Irvine, Dept Physiol \& Biophys, Irvine, CA 92697 USA.},
DOI = {10.1038/s41467-024-48184-6},
Article-Number = {3894},
EISSN = {2041-1723},
Keywords-Plus = {UBIQUITIN PROTEOLYSIS MACHINERY; TRANSCRIPTIONAL ACTIVATOR; PROTEIN
   TIR1; LIGASE; DEGRADATION; MET4; GENE; INACTIVATION; HOMEOSTASIS;
   MECHANISMS},
