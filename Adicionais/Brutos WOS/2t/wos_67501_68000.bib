Pages = {1007-1013},
Month = {SEP},
Abstract = {This study examined the associations between social networks, social
   support, social cohesion, and perceived neighborhood safety among an
   ethnically diverse sample of 1352 residents living in 12 low-income
   public housing sites in Boston, Massachusetts For males and females,
   social cohesion was associated with perceived safety. For males, a
   smaller social network was associated with greater feelings of safety
   Social support was not a significant predictor of perceived safety The
   findings reported here are useful in exploring a potential pathway
   through which social environmental factors influence health and in
   untangling the complex set of variables that may influence perceived
   safety. (C) 2010 Elsevier Ltd All rights reserved.},
