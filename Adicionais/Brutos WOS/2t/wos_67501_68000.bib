@article{ WOS:001276078400001,
Author = {Al Mahrizi, Ahmed Sulaiman Khalfan and Gray, Tim and Gregory-Smith,
   Diana and Stead, Selina M.},
Title = {The role of Stakeholder Participation in Oman's Tourism Planning System},
Journal = {TOURISM PLANNING \& DEVELOPMENT},
Year = {2024},
Volume = {21},
Number = {6},
Pages = {881-916},
Month = {NOV 1},
Abstract = {Oman is a country highly reliant on oil exports that wishes to expand
   tourism (among other industries) as a diversification policy. This paper
   assesses whether stakeholder participation (SP) in tourism planning
   decision-making would enhance or inhibit the country's strategy of
   sustainable tourism development. Findings from 45 interviews and six
   focus groups with tourism stakeholders show that the current level of SP
   in tourism planning is limited; most stakeholders are keen to increase
   it; and the benefits of doing so include safeguarding Oman's traditional
   environmental and cultural heritage. The paper contributes to the
   literature by demonstrating how the principle of SP is congruent with
   Oman's political and cultural identity, and how, by supporting
   community-based tourism, SP can serve as an important factor in the
   country's sustainable tourism development strategy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
