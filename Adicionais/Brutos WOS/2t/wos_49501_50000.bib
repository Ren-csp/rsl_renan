@article{ WOS:001216366800012,
Author = {Diaz, Nuria and Perez, Carlos and Escribano, Ana Maria and Sanz, Gema
   and Priego, Julian and Lafuente, Celia and Barberis, Mario and Calle,
   Luis and Espinosa, Juan Felix and Priest, Birgit T. and Zhang, Hong Y.
