@article{ WOS:000453738000047,
Author = {Jernigan, Valarie Blue Bird and Salvatore, Alicia L. and Williams, Mary
   and Wetherill, Marianna and Taniguchi, Tori and Jacob, Tvli and Cannady,
   Tamela and Grammar, Mandy and Standridge, Joy and Fox, Jill and Owens,
   JoAnna Tingle and Spiegel, Jennifer and Love, Charlotte and Teague,
   Travis and Noonan, Carolyn},
Title = {A Healthy Retail Intervention in Native American Convenience Stores: The
   THRIVE Community-Based Participatory Research Study},
Journal = {AMERICAN JOURNAL OF PUBLIC HEALTH},
