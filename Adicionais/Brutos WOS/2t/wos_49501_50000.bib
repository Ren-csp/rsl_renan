@article{ WOS:000172394200003,
Author = {Seifert, CM and Patalano, AL},
Title = {Opportunism in memory: Preparing for chance encounters},
Journal = {CURRENT DIRECTIONS IN PSYCHOLOGICAL SCIENCE},
Year = {2001},
Volume = {10},
Number = {6},
Pages = {198-201},
Month = {DEC},
Abstract = {Recognizing opportunities to achieve pending goals is an important
   cognitive ability. But when and how do we recognize that a current
   situation is especially suited to resuming a past goal? The predictive
   encoding model suggests pending goals are encoded into memory in
   association with anticipated environmental features. Optimally, these
   features are (a) necessary for successful goal satisfaction, (b)
   distinctive preconditions for expecting a plan to achieve the goal, and
   (c) described so as to be readily identified in the environment. Later,
   ordinary perception of features in the environment leads to automatic
   recognition of opportunities already prepared in memory. Evidence from
   experimental studies supports this theory, and demonstrates that general
   Preparation can Produce apparently novel Opportunism. These findings
   suggest ways to facilitate the recognition of opportunities to satisfy
   pending goals.},
Publisher = {BLACKWELL PUBLISHERS},
Address = {350 MAIN STREET, STE 6, MALDEN, MA 02148 USA},
Type = {Article},
Language = {English},
Affiliation = {Seifert, CM (Corresponding Author), Univ Michigan, Dept Psychol, 525 E Univ, Ann Arbor, MI 48109 USA.
   Univ Michigan, Dept Psychol, Ann Arbor, MI 48109 USA.
   Univ Illinois, Beckman Inst, Champaign, IL 61820 USA.},
DOI = {10.1111/1467-8721.00148},
ISSN = {0963-7214},
Keywords = {prospective memory; planning; opportunism; encoding; retrieval},
Keywords-Plus = {INTENTIONS},
Research-Areas = {Psychology},
