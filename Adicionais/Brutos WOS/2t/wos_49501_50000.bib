@article{ WOS:000744228000003,
Author = {Horiashchenko, Yuliia and Taranenko, Iryna and Yaremenko, Svitlana and
   Shevchenko, Valentyna and Mishustina, Tetiana and Klimova, Inna},
Title = {Integrated System of Enterprises' Innovative Development Management
   Under the Conditions of Post-Fordism},
Journal = {POSTMODERN OPENINGS},
