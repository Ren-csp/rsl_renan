@article{ WOS:001786220400001,
Author = {Polisetty, Aruna and Sowmya, G. and Chakraborty, Debarun and Bresciani,
   Stefano},
Title = {Sustainable competitiveness through regulatory trust: How indian small
   and medium enterprises transform regulation into innovation},
Journal = {TECHNOLOGICAL FORECASTING AND SOCIAL CHANGE},
Year = {2026},
Volume = {230},
Month = {SEP},
Abstract = {The present study integrates institutional theory, legitimacy theory,
   and the resource-based view to investigate how regulatory dynamics
   influence green innovation in Indian small and medium enterprises. We
   examine how regulatory pressure and regulatory trust affect small and
   medium enterprise innovation behavior using a mixed-method design that
   includes 14 in-depth interviews analysed using an inductive-deductive
   approach and a quantitative survey of 436 middle-level managers of Small
   and medium enterprises assessed using PLS-SEM. The results show that
   regulatory pressure is frequently viewed as a threat rather than an
   enabler of green innovation when organizational capabilities are
   limited. However, the study reveals a compelling finding: perceptions of
   fairness and dependability are fostered by clear, consistent, and
   transparent policies, and regulatory pressure significantly predicts
   trust in regulatory institutions. Perceived regulatory legitimacy shows
   a negative moderating effect on the relationship between green
   innovation and sustainable competitive advantage. When legitimacy is
   high, SMEs rely less on green innovation as legitimacy itself enhances
   competitiveness. Conversely, under low legitimacy, firms depend more on
   green innovation to build credibility, indicating a substitutive
   relationship between institutional legitimacy and innovation
   capabilities. By demonstrating the benefits of methodological
   triangulation and providing both rich contextual insights and broadly
   applicable theoretical categories, the study advances small and medium
   enterprise sustainability research. Policymakers can expedite
   sustainable industrial transitions and enable Small and medium
   enterprises to make concurrent economic and environmental advancements
   by matching regulatory strategies with small and medium enterprise
   needs.},
