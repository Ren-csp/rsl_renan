Type = {Article},
Language = {English},
Affiliation = {Jiang, R (Corresponding Author), Beijing Jiaotong Univ, MOE Key Lab Urban Transportat Complex Syst Theory, Beijing, Peoples R China.
   Jiang, Rui; Gao, Zi-You; Jia, Bin, Beijing Jiaotong Univ, MOE Key Lab Urban Transportat Complex Syst Theory, Beijing, Peoples R China.
