Author = {Meyer, Hannah V. and Dawes, Timothy J. W. and Serrani, Marta and Bai,
   Wenjia and Tokarczuk, Pawel and Cai, Jiashen and de Marvao, Antonio and
   Henry, Albert and Lumbers, R. Thomas and Gierten, Jakob and Thumberger,
