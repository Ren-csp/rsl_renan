@article{ WOS:001773895700001,
Author = {Omer, Altyeb Ali Abaker and Li, Ming and Zhang, Fangxin and El Kolaly,
   Wael and Zhang, Xinyu and Saad, AbdelGawad and Liu, Wen},
Title = {Enhancing cultivation environment and increasing productivity in
   greenhouse rooftop with novel spectrum-splitting technology},
Journal = {HELIYON},
Year = {2025},
Volume = {11},
Number = {13},
Month = {AUG},
Abstract = {Optimizing light conditions is essential for improving crop performance
   in greenhouse agriculture. However, achieving a stable and efficient
   light spectrum that enhances plant photosynthesis remains a key
   challenge. Spectrum-splitting technology (S-ST), which utilizes low-cost
   multilayer films to transmit photosynthetically efficient wavelengths,
   offers a promising solution for controlled environments, particularly
   the rooftops of greenhouses. This study evaluates the effects of S-ST
   integrated into curved glass rooftop greenhouses on the cultivation
   environment, morphological development, yield, and quality of two key
   crops: sweet potato (Ipomoea batatas) and peanut (Arachis hypogaea). A
   comparative field experiment was conducted using three treatments: (1) a
   glass-covered multilayer film greenhouse rooftop (GMR), (2) a
   conventional glass-shade greenhouse rooftop (GR), and (3) open-air
   cultivation (CK). The S-ST film selectively transmitted red (similar to
   650 nm), blue (similar to 450 nm), and far-red (similar to 735 nm) light
   to optimize photosynthetic efficiency. Environmental data, crop
   evapotranspiration, morphological traits, yield, and quality parameters
   were monitored across treatments. Statistical analyses were performed
   using one-way ANOVA with post-hoc Tukey tests. The GMR treatment
   significantly reduced reference evapotranspiration by 25 \% and 47 \%
   compared to GR and CK, respectively. Compared to CK, sweet potato and
   peanut yields under GMR increased by 36.7 \% and 23.6 \%, respectively.
   Crop quality improved, increasing sweet potato soluble sugar, peanut
   protein, and oil content. Morphological parameters, such as stem length
   and tuber number, were enhanced under GMR. All key indicators showed
   statistically significant differences (p < 0.05) across treatments.
   S-ST-based rooftop greenhouses enhance microclimatic conditions,
   water-use efficiency, and crop productivity. This study presents a
   scalable and sustainable approach for light optimization in urban
   agriculture, particularly in water-limited or space-constrained
   environments.},
