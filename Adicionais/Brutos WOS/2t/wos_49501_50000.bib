@article{ WOS:A1986D754900076,
Author = {WEIFFENBACH, JM and FOX, PC and BAUM, BJ},
Title = {TASTE AND SALIVARY FUNCTION},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {1986},
Volume = {83},
Number = {16},
Pages = {6103-6106},
Month = {AUG},
Abstract = {Human taste perception was remarkably unimpaired in eight individuals
   with severe, chronic failure of all major and minor salivary gland
   function. Subjective reports of taste experience and objective measures
   of suprathreshold sensitivity were within normal limits for the
   overwhelming majority of these individuals. Impairments of threshold
   sensitivity for at least one quality was common, but normal thresholds
   for all four qualities were observed in one individual. Theses data
   demonstrated that the functional integrity of the taste system is not
   dependent upon the presence of normal saliva in the mouth. Thus, the
   suggestion that a salivary factor is responsible for the maintenance of
   taste receptor end organs can be rejected and attention directed toward
   other mechanisms, not dependent on saliva, that might account for the
   unusual resistance of these cells to environmental insult.},
Publisher = {NATL ACAD SCIENCES},
