@article{ WOS:000885955300001,
Author = {Blanchard, Aaron T. and Li, Zi and Duran, Elizabeth C. and Scull,
   Catherine E. and Hoff, J. Damon and Wright, Keenan R. and Pan, Victor
   and Walter, Nils G.},
Title = {Ultra-photostable DNA FluoroCubes: Mechanism of Photostability and
   Compatibility with FRET and Dark Quenching},
Journal = {NANO LETTERS},
Year = {2022},
Month = {2022 JUL 26},
Abstract = {DNA-based FluoroCubes were recently developed as a solution to
   photobleaching, a ubiquitous limitation of fluorescence microscopy
   (Niekamp; Stuurman; Vale Nature Methods, 2020). FluoroCubes, that is,
   compact similar to 4 x 4 x 5.4 nm(3) four-helix bundles coupled to <= 6
   fluorescent dyes, remain fluorescent up to similar to 50x longer than
   single dyes and emit up to similar to 40x as many photons. The current
   work answers two important questions about the FluoroCubes. First, what
   is the mechanism by which photostability is enhanced? Second, are
   FluoroCubes compatible with Forster resonance energy transfer (FRET) and
   similar techniques? We use single particle photobleaching studies to
   show that photostability arises through interactions between the
   fluorophores and the four-helix DNA bundle. Supporting this, we discover
   that smaller similar to 4 x 4 x 2.7 nm(3) FluoroCubes also confer
   ultraphotostability. However, we find that certain dye-dye interactions
   negatively impact FluoroCube performance. Accordingly, 4-dye FluoroCubes
   lacking these interactions perform better than 6-dye FluoroCubes. We
   also demonstrate that FluoroCubes are compatible with FRET and dark
   quenching applications.},
