@article{ WOS:000246655500008,
Author = {Verboom, Jana and Alkemade, Rob and Klijn, Jan and Metzger, Marc J. and
   Reijnen, Rien},
Title = {Combining biodiversity modeling with political and economic development
   scenarios for 25 EU countries},
Journal = {ECOLOGICAL ECONOMICS},
