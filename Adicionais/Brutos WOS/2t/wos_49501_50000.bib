   Siegel, Eva, Columbia Univ, Epidemiol Dept, Mailman Sch Publ Hlth, New York, NY 10032 USA.
   Swope, Carolyn B., Delos Living LLC, New York, NY USA.},
DOI = {10.1016/j.healthplace.2019.01.007},
ISSN = {1353-8292},
EISSN = {1873-2054},
Keywords = {Smoke-free housing; Social determinants; Tobacco control; Urban health;
