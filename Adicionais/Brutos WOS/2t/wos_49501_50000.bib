   Duval, Delaney; Stark, Brielle C., Indiana Univ Bloomington, Dept Speech Language \& Hearing Sci, Bloomington, IN 47408 USA.},
DOI = {10.3758/s13428-026-02948-8},
Article-Number = {67},
ISSN = {1554-351X},
EISSN = {1554-3528},
Keywords = {Speech errors; Automated coding; Semantic similarity; Phonological
