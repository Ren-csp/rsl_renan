@article{ WOS:001195597700006,
Author = {Meng, Ran and Xing, Zhongliang and Chang, Jeng-Yih and Yu, Zihao and
   Thongchol, Jirapat and Xiao, Wen and Wang, Yuhang and Chamakura, Karthik
