@article{ WOS:001810578600001,
Author = {Nguyen, Mai and Trinh, Nhung and Malik, Ashish},
Title = {Knowledge sharing and telework in the new workplace: The role of
   organizational support in shaping employee outcomes},
Journal = {GERMAN JOURNAL OF HUMAN RESOURCE MANAGEMENT-ZEITSCHRIFT FUR
   PERSONALFORSCHUNG},
Year = {2026},
Month = {2026 JUL 3},
Abstract = {Drawing on Job Demands-Resources model, this study investigates how
   perceived organizational support, knowledge sharing on AI-enabled
   technology-mediated platforms, and transformational leadership relate to
   key employee outcomes in telework models, namely job satisfaction, job
   security, cheating behavior, and turnover intention. Using data from 298
   employees in the UK, the findings reveal that greater perceived
   organizational support is associated with AI-enabled technology-mediated
   knowledge sharing. Such knowledge sharing is in turn associated with
   higher satisfaction and security, as well as lower unethical behavior
   and turnover intention. Furthermore, the link between organizational
   support and knowledge sharing is stronger under transformational
   leadership, though this relationship varies based on the nature of
   telework arrangements. Notably, several relationships are not
   significant under high telework conditions, suggesting the need for
   physical presence and organizational salience. These findings emphasize
   the importance of organizational and leadership support, as well as
   digital knowledge-sharing cultures, in promoting positive employee
   outcomes while mitigating negative ones in modern work environments.},
