@article{ WOS:001441923700001,
Author = {Karel, Alloh and Inna, Cabelkova and Rehabi, Mohammad and Lubos, Smutka
   and Ghaeth, Fandi},
Title = {Examining the perceived benefits of participation in the sharing economy
   in Europe: A case study on short-term accommodation},
Journal = {CURRENT ISSUES IN TOURISM},
Year = {2026},
Volume = {29},
Number = {17},
Pages = {3516-3536},
Month = {SEP 2},
Abstract = {The discourse surrounding short-term accommodation frequently revolves
   around economic impacts, regulatory challenges, technological
   innovations, and environmental considerations. However, it is crucial to
   underscore that the evolution of this sector is significantly influenced
   by public perceptions and experiences with shared short-term lodging.
   This study delves into the repercussions of engaging in short-term
   rentals on its perceived advantages in Europe, utilising a large and
   representative sample across 27 European Union countries (N = 25,297,
   aged 18-100, M +/- SD 47.62 +/- 16.81; 49.50\% males). Methodologically,
   logistic regression analyses are employed to discern patterns. The
   findings highlight (1) noteworthy variations in perceived benefits
   within countries; (2) the perception of benefits varies based on whether
   respondents have rented such accommodations, offered their existing
   space for rent, or acquired new properties for rent; (3) Individuals who
   have acquired real estate for rental purposes tend to perceive more
   benefits, such as local development, investment opportunities,
   additional income for hosts, and increased spending by visitors in the
   surrounding areas. Experienced renters recognize the benefits of
   affordable travel and staying in non-touristy neighbourhoods. These
   results underscore the importance of considering diverse perspectives
   when formulating policies and regulations for the sort-term rental
   sector.},
