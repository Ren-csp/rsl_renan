@article{ WOS:001352032000017,
Author = {Bach, Vanessa and Marinova, Sylvia and Finkbeiner, Matthias},
Title = {Updated data and characterization factors of the criticality assessment
   for the integrated method to assess resource efficiency (ESSENZ and
   ESSENZ plus )},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2024},
Volume = {5},
Number = {1},
Month = {SEP 27},
Abstract = {ObjectivesThis data note contains updated characterization factors
   including the corresponding datasets for the integrated method to assess
   resource efficiency (abbreviated as ESSENZ) as well as its successor
   (ESSENZ+) utilized in assessing the criticality of 48 abiotic resources.
   The updated characterization factors enable life cycle-based case
   studies of product systems to determine criticality aspects as well as
   aspects related to compliance with social and environmental impacts.
   Underlying data is provided as it is needed for efficiently interpreting
   the results.Data descriptionData was collected from publicly available
   source, including i.e. the United States Geological Survey for abiotic
   resource production and reserves, the Fraser Institute for the Policy
   Perception Index, the World Economic Forum for the Enabling Trade Index,
   the World Bank for the Worldwide Governance Indicators and the German
   Mineral Resources Agency for price fluctuations. The compiled data has
   been reorganized and recalculated in accordance with the principles
   outlined in the published ESSENZ and ESSENZ + method, serving as a
   foundation for the calculation of the characterization factors for
   assessing criticality and compliance with social and environmental
   impacts.},
