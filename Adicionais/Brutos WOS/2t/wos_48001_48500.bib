@article{ WOS:000271550300004,
Author = {Blanco, Fernando and Matute, Helena and Vadillo, Miguel A.},
Title = {DEPRESSIVE REALISM: WISER OR QUIETER?},
Journal = {PSYCHOLOGICAL RECORD},
Year = {2009},
Volume = {59},
Number = {4},
Pages = {551-562},
Month = {FAL},
Abstract = {Depressive realism consists of the lower personal control over
   uncontrollable events perceived by depressed as compared to nondepressed
   individuals. In this article, we propose that the realism of depressed
   individuals is caused not by an increased accuracy in perception, but by
   their more comprehensive exposure to the actual environmental
   contingencies, which in turn is due to their more passive pattern of
   responding. To test this hypothesis, dysphoric and nondysphoric
   participants were exposed to an uncontrollable task and both their
   probability of responding and their judgment of control were assessed.
   As was expected, higher levels of depression correlated negatively with
   probability of responding and with the illusion of control. Implications
   for a therapy of depression are discussed.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Matute, H (Corresponding Author), Univ Deusto, Dept Psicol, Apartado 1, Bilbao 48080, Spain.
   Matute, Helena, Univ Deusto, Dept Psicol, Bilbao 48080, Spain.},
DOI = {10.1007/BF03395681},
ISSN = {0033-2933},
EISSN = {2163-3452},
