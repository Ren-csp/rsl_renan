@article{ WOS:001730865300003,
Author = {Shen, Qianhui and Li, Ruizhen and Li, Yating and Jing, Chunhui and Feng,
   Shu and Ding, Tiecheng and Yu, Dongyu and Zhi, Jinyi and Ma, Henry},
Title = {Interactive media and time assessment: How an openpose-based screen
   affects people's perceived time and experience},
Journal = {CURRENT PSYCHOLOGY},
Year = {2026},
Volume = {45},
Number = {7},
Month = {MAR 31},
Abstract = {Interactive media has demonstrated potential in reducing perceived
   waiting times and enhancing user experiences across various public
   contexts. However, its specific effects within traffic environments
   remain unexplored. This study investigated how different forms of visual
   media influence individuals' perceived screen effectiveness and
   perceived waiting time during red-light waiting periods. A
   within-subjects experiment (N = 44, aged 18-35, gender-balanced)
   compared the same screen under three different conditions: static
   condition, linear condition, and interactive condition. Participants
   estimated their perceived waiting time and reported their perceived
   screen effectiveness after experienced each condition. The results
   revealed that the screen under OpenPose-based interactive condition
   significantly shortened participants' perceived waiting time compared
   with both the static and linear conditions. Moreover, participants using
   the screen with interactive condition showed better perceived screen
   effectiveness, for example, higher levels of engagement and pleasure
   while reducing boredom and anxiety. Furthermore, higher ratings of
   negative perceived screen effectiveness were associated with longer
   perceived waiting times. These findings suggest that embodied
   interactivity, enabled by OpenPose-based technology, can meaningfully
   alter subjective time perception and emotional experiences in everyday
   waiting scenarios. This study extends the application of interactive
   media to traffic contexts and provides empirical evidence for the
   potential of embodied interaction design in improving public experience
   and environmental perception.},
