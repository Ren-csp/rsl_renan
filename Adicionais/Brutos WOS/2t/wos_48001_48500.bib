@article{ WOS:001807858800001,
Author = {Webster, Russell J. and Gainer, Lea},
Title = {How belief in pure good and belief in pure evil relate to reactive and
   proactive interpersonal aggression},
Journal = {COGENT PSYCHOLOGY},
Year = {2026},
Volume = {13},
Number = {1},
Month = {DEC 31},
Abstract = {The current study examined how beliefs about human nature-specifically,
   belief in pure good (BPG) and belief in pure evil (BPE)-uniquely related
   to self-reported reactive (i.e. in response to provocation) and
   proactive (i.e. without provocation) forms of self-reported
   interpersonal aggression. Using a nationwide US sample (final N = 380),
   participants completed BPG and BPE scales, a modified version of the
   Peer Conflict Scale, and the Aggression Provocation Questionnaire.
   Control variables included the Dark Tetrad (narcissism,
   Machiavellianism, psychopathy, and sadism), trait anger, trait
   irritability, and demographic variables (e.g. gender, education). BPG is
   uniquely related to lower self-reported reactive and proactive
   aggression on both the Peer Conflict Scale and Aggression Provocation
   Questionnaire. BPE weakly correlated with higher scores on the Peer
   Conflict Scale, but control variables rendered the relationship
   non-significant. In sum, BPG (vs. BPE) showed more consistent
   associations with interpersonal aggression, whether it is a response to
   provocation or self-initiated. Our Discussion highlights BPG's potential
   role in contemporary models of aggression. (166 words)},
