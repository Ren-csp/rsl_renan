@article{ WOS:001861459000001,
Author = {Cabrera-Codony, Alba and Fowkes, Neville and Hocking, Graeme and Mubai,
   Erick and Shabalala, Lombuso Precious and Myers, Timothy G.},
Title = {The Mathematics in Industry Study Group as a learning environment: A
   multi-stakeholder evaluation of the 2025-2026 editions},
Journal = {EDUCATION FOR CHEMICAL ENGINEERS},
Year = {2026},
Volume = {57},
Month = {OCT},
Abstract = {Mathematics in Industry Study Groups have operated worldwide for more
   than five decades, yet their educational impact has rarely been
   evaluated systematically. This study evaluates the stakeholders'
   perceptions of Mathematics in Industry Study Group - South Africa
   (MISG-SA) as a research-based learning intervention through parallel
   surveys of postgraduate students and early-career researchers (n = 40),
   academic mentors (n = 11), and industry representatives (n = 6) across
   two editions (2025-2026). Industrial problems addressed at MISG-SA span
   areas directly relevant to engineering, including process optimisation,
   fluid mechanics, environmental management, and energy systems. All
   groups rated the experience positively, but the most consistent learning
   outcomes concerned how students approach problems, including formulating
   assumptions, tolerating ambiguity, and communicating across disciplines,
   rather than acquiring specific technical skills. Guidance quality and
   psychological safety showed the strongest student-level association (r =
   0.80), highlighting the role of facilitative mentoring. Industry
   respondents identified a model-first tendency in student teams, while
   mentors identified senior availability as the main area for improvement.
   The multi-stakeholder design yields five evidenceinformed
   recommendations for strengthening intensive, industry-linked learning
   formats.},
