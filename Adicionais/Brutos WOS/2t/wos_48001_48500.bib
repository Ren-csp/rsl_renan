   Ampudia, Jeanette and Zamoyska, Rose and Zhu, Cheng and Gascoigne,
   Nicholas R. J.},
Title = {Ligand-engaged TCR is triggered by Lck not associated with CD8
   coreceptor},
Journal = {NATURE COMMUNICATIONS},
Year = {2014},
Volume = {5},
Month = {NOV},
Abstract = {The earliest molecular events in T-cell recognition have not yet been
   fully described, and the initial T-cell receptor (TCR)-triggering
   mechanism remains a subject of controversy. Here, using total internal
   reflection/Forster resonance energy transfer microscopy, we observe a
   two-stage interaction between TCR, CD8 and major histocompatibility
   complex (MHC)peptide. There is an early (within seconds) interaction
   between CD3 zeta and the coreceptor CD8 that is independent of the
   binding of CD8 to MHC, but that requires CD8 association with Lck. Later
   (several minutes) CD3 zeta-CD8 interactions require CD8-MHC binding. Lck
   can be found free or bound to the coreceptor. This work indicates that
   the initial TCR-triggering event is induced by free Lck.},
