@article{ WOS:001831260300001,
Author = {Kassa, Adane and Molla, Jenbrie and Abebe, Zewdu and Endaye, Minbale and
   Firew, Getaneh and Abebe, Adane and Alemayehu, Mulunesh},
Title = {Agrochemical-driven metal accumulation in food crops and associated
   socio-ecological impacts: an integrated ICP-OES-based assessment in
   Ethiopian smallholder farming systems},
Journal = {ENVIRONMENTAL SCIENCE-ADVANCES},
Year = {2026},
Volume = {5},
Number = {9},
Pages = {2293-2305},
Month = {SEP 1},
Abstract = {The increasing use of agrochemicals has improved agricultural
   productivity in Ethiopia but raised concerns regarding environmental
   contamination, food safety, and human health. This study evaluated
   agrochemical practices, stakeholder perceptions, crop metal
   accumulation, and associated health risks in intensive farming areas of
   East and West Gojjam Zones. A mixed-methods approach involving household
   surveys (n = 480), key informant interviews, field observations, and
   ICP-OES analysis of teff, wheat, maize, barley, and potato samples from
   intensive farming districts (Awabel, Gozamen, and Bure) and a low-input
   control area (Dega Damot) was employed. The analytical method showed
   excellent accuracy and precision, with recovery values ranging from
   97.0\% to 102.5\% and \% RSD below 4.7\%. Results showed widespread
   agrochemical dependency, with 96.0\% of farmers using fertilizers and
   80.0\% applying pesticides. Although farmers reported increased
   productivity (89.6\%) and income (82.3\%), major concerns included soil
   degradation (92.1\%), declining water quality (88.8\%), and health
   risks. Crops from high-input districts exhibited higher metal
   concentrations than the low-input control area, with Fe ranging from
   180.3 to 432.7 mg kg(-1) and Pb from 0.04 to 0.80 mg kg(-1), while Cd
   was not detected. Statistical analysis confirmed significant
   associations between agrochemical intensity and metal accumulation (p <
   0.05). Health risk assessment indicated that essential metals were
   generally within safe limits; however, elevated Pb levels in intensive
   farming areas resulted in hazard quotient and hazard index values
   exceeding recommended thresholds, suggesting potential long-term health
   risks. The findings demonstrate the dual role of agrochemicals in
   enhancing productivity while contributing to environmental and food
   safety challenges, highlighting the need for integrated nutrient
   management, improved pesticide practices, regulatory enforcement, and
   continuous monitoring for sustainable agriculture in Ethiopia.},
