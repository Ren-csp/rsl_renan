@article{ WOS:000415323000002,
Author = {Fu, Chengzhang and Sikandar, Asfandyar and Donner, Jannik and
   Zaburannyi, Nestor and Herrmann, Jennifer and Reck, Michael and
   Wagner-Doebler, Irene and Koehnke, Jesko and Mueller, Rolf},
Title = {The natural product carolacton inhibits folate-dependent C1 metabolism
   by targeting FolD/MTHFD},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {NOV 16},
Abstract = {The natural product carolacton is a macrolide keto-carboxylic acid
   produced by the myxobacterium Sorangium cellulosum, and was originally
   described as an antibacterial compound. Here we show that carolacton
   targets FolD, a key enzyme from the folate-dependent C1 metabolism. We
   characterize the interaction between bacterial FolD and carolacton
   biophysically, structurally and biochemically. Carolacton binds FolD
   with nanomolar affinity, and the crystal structure of the
   FolD-carolacton complex reveals the mode of binding. We show that the
   human FolD orthologs, MTHFD1 and MTHFD2, are also inhibited in the low
   nM range, and that micromolar concentrations of carolacton inhibit the
   growth of cancer cell lines. As mitochondrial MTHFD2 is known to be
   upregulated in cancer cells, it may be possible to use carolacton as an
   inhibitor tool compound to assess MTHFD2 as an anticancer target.},
