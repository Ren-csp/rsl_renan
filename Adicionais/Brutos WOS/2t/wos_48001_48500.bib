@article{ WOS:001411647400005,
Author = {Shu, Peixian and Zhou, Weijian and Putnam, Aaron E. and Li, Baosheng and
   Kang, Shugang and Sha, Yingying and Shi, Zhengguo and Ming, Guodong and
   Wang, Hong and Sun, Youbin and Wright, David K. and Liu, Weiguo and Liu,
   Xiaodong and Cheng, Peng and Song, Yougui and Niu, Dongfeng and Dodson,
