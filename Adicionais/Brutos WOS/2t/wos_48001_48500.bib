@article{ WOS:001787484800005,
Author = {Rouhette, Theo},
Title = {Power, knowledge, and discourse in social-ecological systems: insights
   from the Senegalese ecovillage network},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {2},
Month = {APR},
Abstract = {. Social-ecological system (SES) frameworks have become essential tools
   for analyzing human-nature relationships, yet they often overlook the
   role of power dynamics, particularly in their discursive forms. This
   study addresses this gap by proposing a conceptual framework that
   integrates the interplay of power and knowledge into SES analysis.
   Drawing from evolutionary governance theory and sustainability
   transition studies, the conceptual framework aims to capture how
   discursive power shapes knowledge systems, institutional configurations,
   and governance outcomes. Through an empirical case study of the
   Senegalese ecovillage network, the research examines how discourses
   influence social-ecological transition processes and resilience
   practices in rural communities. Results highlight divergent uses of the
   ecovillage concept and implementation approaches, leading to contrasting
   impacts upon people's livelihoods. By highlighting the embeddedness of
   knowledge in power relations, the study underscores the importance of
   understanding discursive forms of power to avoid depoliticized and
   normative governance prescriptions. This work contributes to bridging
   resilience thinking with critical social theory, calling for greater
   interdisciplinary engagement to reveal hidden power structures and
   foster more reflective and pluralistic SES research.},
