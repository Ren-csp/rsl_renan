@article{ WOS:001791565700001,
Author = {Argente-Garcia, Jesus E. and Garcia, Alejandra Abellan and Munoz, Amelia
   Canovas and Caruso, Simona and Atucha, Arnaldo Marin and Gomez, Antonio
   Skarmeta},
Title = {Combining new technologies with traditional knowledge to improve fishing
   efficiency and preserve the last Spanish Mediterranean Almadraba},
Journal = {MARINE POLICY},
Year = {2026},
Volume = {192},
Month = {OCT},
Abstract = {Mediterranean artisanal fisheries in the Region of Murcia, and more
   broadly, face severe economic, environmental, and socio-labour
   challenges that threaten their long-term sustainability and,
   consequently, the principles of a Blue Economy aimed at fostering growth
   while ensuring environmental and social wellbeing. Nevertheless, the
   adoption of digital technologies remains limited due to time
   constraints, high costs, and low technical skills. In response to these
   challenges, we co-developed WiSea, an early-warning and decision-support
   system, in collaboration with artisanal fishers from the Tonnara
   (Almadraba) of La Azohia and the Fishermen's Guild of Aguilas. WiSea is
   a prototype that integrates an underwater camera buoy with real-time
   data processing and transmission, thereby enabling fishers to optimise
   catch, monitor nets, and prevent dolphin-related damages. Importantly,
   beyond the technical proof of concept, the project implemented a
   participatory process with local artisanal fishers, actively
   incorporating their traditional knowledge and practices. Moreover, two
   multi-actor workshops involving 135 stakeholders from fisheries,
   science, universities, and administrations were organised to co-create
   solutions and explore digitalisation pathways. To complement these
   efforts, a questionnaire was distributed to capture perceptions on
   digitalisation and its role in promoting a fair and inclusive Blue
   Economy adapted to the Murcia region, while looking for local fishing
   communities. Overall, field tests during Almadraba operations and
   participatory evaluations confirmed WiSea's usability and potential to
   enhance operational efficiency and sustainability. However, barriers
   such as training gaps, high costs and insufficient supportive policies
   persist. Therefore, unlocking the full potential of digitalisation will
   require coordinated technical, economic, and institutional support to
   ensure that innovation complements, rather than replaces, local
   knowledge and artisanal practices. Finally, future research should
   extend this approach to other Mediterranean regions to assess broader
   applicability and equity implications for a just Blue Economy.},
