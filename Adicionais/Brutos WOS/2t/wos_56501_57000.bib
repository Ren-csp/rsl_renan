@article{ WOS:000596594500001,
Author = {Blanco, Graziela Dias and Hanazaki, Natalia and Beeck Cunha, Suelen
   Maria and Cremer, Marta Jussara and Campos, Mari Lucia},
Title = {Exploring the Interfaces between Ethnobiology and Ecotoxicology: A Novel
   Approach},
Journal = {ETHNOBIOLOGY LETTERS},
Year = {2020},
Volume = {11},
Number = {1},
Pages = {29-37},
Abstract = {In recent years, increases in urbanization and industrialization have
   led to an increase in contaminated areas, which directly affect
   traditional, indigenous, and local communities who use natural resources
   for food and medicine. We present a discussion about the use of food
   resources from areas contaminated with heavy metals and focus on two
   case studies in southern Brazil. In the first case study, we interviewed
   194 residents about the use of plants as food resources or medicine in
   areas adjacent to abandoned mines, and thus potentially contaminated
   with heavy metals. In the second case study, we interviewed 39 fishers
   about the consumption of fish resources from areas potentially
   contaminated by industrial activities. We also asked about their
   perceptions regarding contamination, changes in the landscape, and
   health problems that could be related to contamination. Although people
   are aware of contamination, consuming local plants and sea food has not
   stopped because some of these practices are directly linked to their
   cultural identity; additionally, there might be a lack of public
   recognition toward contamination. The combination of ethnoecological and
   ecotoxicological studies is necessary to assess environmental problems
   caused by heavy metals, as well as concerns about food security and the
   health of local communities.},
Publisher = {SOC ETHNOBIOLOGY},
