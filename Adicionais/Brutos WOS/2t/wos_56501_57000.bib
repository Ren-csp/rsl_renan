@article{ WOS:000934072600067,
Author = {Harris, D. J. and Arthur, T. and Vine, S. J. and Liu, J. and Abd Rahman,
   H. R. and Han, F. and Wilson, M. R.},
Title = {Task-evoked pupillary responses track precision-weighted prediction
   errors and learning rate during interceptive visuomotor actions},
Journal = {SCIENTIFIC REPORTS},
Year = {2022},
Volume = {12},
Number = {1},
Month = {DEC 21},
Abstract = {In this study, we examined the relationship between physiological
   encoding of surprise and the learning of anticipatory eye movements.
   Active inference portrays perception and action as interconnected
   inference processes, driven by the imperative to minimise the surprise
   of sensory observations. To examine this characterisation of oculomotor
   learning during a hand-eye coordination task, we tested whether
   anticipatory eye movements were updated in accordance with Bayesian
   principles and whether trial-by-trial learning rates tracked pupil
   dilation as a marker of `surprise'. Forty-four participants completed an
   interception task in immersive virtual reality that required them to hit
   bouncing balls that had either expected or unexpected bounce profiles.
   We recorded anticipatory eye movements known to index participants'
   beliefs about likely ball bounce trajectories. By fitting a hierarchical
   Bayesian inference model to the trial-wise trajectories of these
   predictive eye movements, we were able to estimate each individual's
   expectations about bounce trajectories, rates of belief updating, and
   precision-weighted prediction errors. We found that the task-evoked
   pupil response tracked prediction errors and learning rates but not
   beliefs about ball bounciness or environmental volatility. These
   findings are partially consistent with active inference accounts and
   shed light on how encoding of surprise may shape the control of action.},
