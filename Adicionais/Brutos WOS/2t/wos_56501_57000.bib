Author = {Kanchi, Krishna L. and Johnson, Kimberly J. and Lu, Charles and
   McLellan, Michael D. and Leiserson, Mark D. M. and Wendl, Michael C. and
   Zhang, Qunyuan and Koboldt, Daniel C. and Xie, Mingchao and Kandoth,
   Cyriac and McMichael, Joshua F. and Wyczalkowski, Matthew A. and Larson,
   David E. and Schmidt, Heather K. and Miller, Christopher A. and Fulton,
