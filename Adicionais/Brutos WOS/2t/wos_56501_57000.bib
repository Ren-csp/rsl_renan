@article{ WOS:001232199800002,
Author = {Zhang, Jingjing and Li, Yanmei and Zeng, Fengyuan and Mu, Changyong and
   Liu, Change and Wang, Lichun and Peng, Xiaowu and He, Liping and Su,
   Yanrui and Li, Hongbing and Wang, An and Feng, Lin and Gao, Dongxiu and
   Zhang, Zhixiao and Xu, Gang and Wang, Yixuan and Yue, Rong and Si, Junbo
   and Zheng, Lichun and Zhang, Xiong and He, Fuyun and Yi, Hongkun and
