@article{ WOS:000187174000043,
Author = {Adams, WM and Brockington, D and Dyson, J and Vira, B},
Title = {Managing tragedies: Understanding conflict over common pool resources},
Journal = {SCIENCE},
Year = {2003},
Volume = {302},
Number = {5652},
Pages = {1915-1916},
Month = {DEC 12},
Abstract = {Conflicts over the management of common pool resources are not simply
   material. They also depend on the perceptions of the protagonists.
   Policy to improve management often assumes that problems are
   self-evident, but in fact careful and transparent consideration of the
