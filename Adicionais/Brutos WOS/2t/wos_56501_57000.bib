Author = {Koga, Nobuyasu and Koga, Rie and Liu, Gaohua and Castellanos, Javier and
   Montelione, Gaetano T. and Baker, David},
Title = {Role of backbone strain in de novo design of complex α/β protein
   structures},
Journal = {NATURE COMMUNICATIONS},
