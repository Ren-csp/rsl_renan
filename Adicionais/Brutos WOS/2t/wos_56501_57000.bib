@article{ WOS:001216226800001,
Author = {Argaw-Denboba, Ayele and Schmidt, Thomas S. B. and Di Giacomo, Monica
   and Ranjan, Bobby and Devendran, Saravanan and Mastrorilli, Eleonora and
   Lloyd, Catrin T. and Pugliese, Danilo and Paribeni, Violetta and Dabin,
   Juliette and Pisaniello, Alessandra and Espinola, Sergio and Crevenna,
   Alvaro and Ghosh, Subhanita and Humphreys, Neil and Boruc, Olga and
   Sarkies, Peter and Zimmermann, Michael and Bork, Peer and Hackett, Jamie
   A.},
Title = {Paternal microbiome perturbations impact offspring fitness},
Journal = {NATURE},
Year = {2024},
Volume = {629},
Number = {8012},
Pages = {652-659},
Month = {MAY 16},
Abstract = {The gut microbiota operates at the interface of host-environment
   interactions to influence human homoeostasis and metabolic networks 1-4
   . Environmental factors that unbalance gut microbial ecosystems can
   therefore shape physiological and disease-associated responses across
   somatic tissues 5-9 . However, the systemic impact of the gut microbiome
   on the germline-and consequently on the F1 offspring it gives rise to-is
   unexplored 10 . Here we show that the gut microbiota act as a key
   interface between paternal preconception environment and
   intergenerational health in mice. Perturbations to the gut microbiota of
   prospective fathers increase the probability of their offspring
   presenting with low birth weight, severe growth restriction and
   premature mortality. Transmission of disease risk occurs via the
   germline and is provoked by pervasive gut microbiome perturbations,
   including non-absorbable antibiotics or osmotic laxatives, but is
   rescued by restoring the paternal microbiota before conception. This
   effect is linked with a dynamic response to induced dysbiosis in the
   male reproductive system, including impaired leptin signalling, altered
   testicular metabolite profiles and remapped small RNA payloads in sperm.
   As a result, dysbiotic fathers trigger an elevated risk of in utero
   placental insufficiency, revealing a placental origin of mammalian
   intergenerational effects. Our study defines a regulatory `gut-germline
   axis' in males, which is sensitive to environmental exposures and
   programmes offspring fitness through impacting placenta function.
   Disturbances in the gut microbiota of male mice manifest as fitness
   defects in their offspring by affecting plancenta function, revealing a
   paternal gut-germline axis.},
