@article{ WOS:000408532600026,
Author = {Debebe, Tewodros and Biagi, Elena and Soverini, Matteo and Holtze,
   Susanne and Hildebrandt, Thomas Bernd and Birkemeyer, Claudia and
   Wyohannis, Dereje and Lemma, Alemayehu and Brigidi, Patrizia and
   Savkovic, Vulk and Konig, Brigitte and Candela, Marco and Birkenmeier,
   Gerd},
Title = {Unraveling the gut microbiome of the long-lived naked mole-rat},
Journal = {SCIENTIFIC REPORTS},
Year = {2017},
Volume = {7},
Month = {AUG 29},
Abstract = {The naked mole-rat (Heterocephalus glaber) is a subterranean mouse-sized
   African mammal that shows astonishingly few age-related degenerative
   changes and seems to not be affected by cancer. These features make this
   wild rodent an excellent model to study the biology of healthy aging and
   longevity. Here we characterize for the first time the intestinal
   microbial ecosystem of the naked mole-rat in comparison to humans and
   other mammals, highlighting peculiarities related to the specific living
   environment, such as the enrichment in bacteria able to utilize soil
   sulfate as a terminal electron acceptor to sustain an anaerobic
   oxidative metabolism. Interestingly, some compositional gut microbiota
   peculiarities were also shared with human gut microbial ecosystems of
   centenarians and Hadza hunter-gatherers, considered as models of a
   healthy gut microbiome and of a homeostatic and highly adaptive gut
   microbiota-host relationship, respectively. In addition, we found an
   enrichment of short-chain fatty acids and carbohydrate degradation
   products in naked mole-rat compared to human samples. These data confirm
   the importance of the gut microbial ecosystem as an adaptive partner for
   the mammalian biology and health, independently of the host phylogeny.},
