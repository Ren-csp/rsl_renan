@article{ WOS:001508591700001,
Author = {Chen, Qiuying and Xue, Rui and Guo, Ying and Li, Xiuzhong and Ni,
   Zhaokui and Zhang, Hao and Wang, Shengrui},
Title = {Rising basin pressure drove the evolution of lake water ecosystems in
   cold and arid region: A diatom based analysis of three lakes in Inner
   Mongolia, China},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {176},
Month = {JUL},
Abstract = {The water ecological environment of lakes in cold and arid regions is
   sensitive and fragile, with unclear historical driving factors of water
   ecosystem degradation. This study focused on Hulun Lake, Daihai Lake and
   Wuliangsuhai Lake in Inner Mongolia, China. Diatoms in sediment cores
   were utilized to understand their community changes over the past
   century. The relationship between basin pressures and diatom community
   structure was analyzed using redundancy analysis. The results indicated
   that the lakes experienced a transition from healthy aquatic vegetation
   growth to ecological degradation. Basin pressure from construction,
   livestock production, and population, along with climate factors like
   air temperature and evaporation, influenced the evolution of the diatom
   community structure. Urbanization and climate change exacerbated the
   degradation of lake water ecosystems. In recent years, urban-related
   human activities introduced new stressors, further altering diatom
   communities and aquatic ecosystems. Rising basin pressure has driven the
   evolution of aquatic ecosystems of the three lakes. These findings
   emphasize the crucial role of basin pressure in shaping lake ecosystems.
   Thus, in lake water environment management in cold and arid region,
   controlling watershed pressures like rational industrial planning and
   population growth regulation should be prioritized to foster ecosystem
   sustainability. This also has implications for integrated strategies to
   address climate change and human impacts, ensuring long-term sustainable
   development.},
