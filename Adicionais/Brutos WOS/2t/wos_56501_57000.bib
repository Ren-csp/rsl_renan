@article{ WOS:000417339700031,
Author = {Bergelson, Elika and Aslin, Richard N.},
Title = {Nature and origins of the lexicon in 6-mo-olds},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2017},
