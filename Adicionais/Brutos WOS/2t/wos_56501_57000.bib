@article{ WOS:001297182800001,
Author = {Yu, Chuanjiang and Shen, Qiong and Holmes, Antony B. and Mo, Tongwei and
   Tosato, Anna and Soni, Rajesh Kumar and Corinaldesi, Clarissa and Koul,
   Sanjay and Pasqualucci, Laura and Hussein, Shafinaz and Forouhar, Farhad
