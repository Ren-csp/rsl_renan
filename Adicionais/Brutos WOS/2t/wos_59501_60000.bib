@article{ WOS:000089566100083,
Author = {Gibbs, S and Collard, M and Wood, B},
Title = {Soft-tissue characters in higher primate phylogenetics},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2000},
Volume = {97},
Number = {20},
Pages = {11130-11132},
Month = {SEP 26},
Abstract = {Recent research has cast doubt on the reliability of bones and teeth for
   reconstructing phylogenetic relationships among higher primate species
   and genera. Herein. we investigate whether this problem is confined to
   hard tissues by examining the utility of higher primate soft-tissue
   characters for reconstructing phylogenetic relationships at low
   taxonomic levels. We use cladistic methods to analyze 197 soft-tissue
   characters for the extant hominoids and then compare the resulting
   phylogenetic hypotheses with the group's consensus molecular phylogeny,
   which is widely considered to be accurate. We show that the soft-tissue
   characters yield robust phylogenetic hypotheses that are compatible with
   the molecular phylogeny. Given the strength of the evidence for
   molecular phylogeny, these results indicate that, unlike craniodental
   hard-tissue characters, soft tissues are reliable for reconstructing
   phylogenetic relationships among higher primate species and genera.
   Thus, in higher primates at least, some types of morphological data are
   more useful than others for phylogeny reconstruction.},
