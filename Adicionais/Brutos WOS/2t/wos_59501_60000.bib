@article{ WOS:000479020300018,
Author = {Pachota, Magdalena and Klysik-Trzcianska, Katarzyna and Synowiec,
   Aleksandra and Yuldoka, Shotaro and Yusa, Shin-Ichi and Zajac, Mateusz
   and Zawilinska, Barbara and Dzieciatkowski, Tomasz and Szczubialka,
   Krzysztof and Pyrc, Krzysztof and Nowakowska, Maria},
Title = {Highly Effective and Safe Polymeric Inhibitors of Herpes Simplex Virus
   in Vitro and in Vivo},
Journal = {ACS APPLIED MATERIALS \& INTERFACES},
Year = {2019},
Volume = {11},
Number = {30},
Pages = {26745-26752},
Month = {JUL 31},
Abstract = {A series of poly(ethylene glycol)-block-poly(3(-methacryloylamino)propyl
   trimethylammonium chloride) (PEG-b-PMAPTAC) water-soluble block
   copolymers consisting of PEG and PMPTAC were obtained by reversible
   addition-fragmentation chain transfer (RAFT) polymerization and
   demonstrated to function as highly effective herpes simplex virus type 1
   (HSV-1) inhibitors as shown by in vitro tests (Vero E6 cells) and in
   vivo experiments (mouse model). Half maximal inhibitory concentration
   (IC50) values were determined by quantitative polymerase chain reaction
   to be 0.36 +/- 0.08 mu g/mL for the most effective polymer
   PEG(45)-b-PMAPTAC(52) and 0.84 +/- 1.24 mu g/mL for the less effective
   one, PEG(45)-b-PMAPTAC(74). The study performed on the mouse model
   showed that the polymers protect mice from lethal infection. The
   polymers are not toxic to the primary human skin fibroblast cells up to
   the concentration of 100 mu g/mL and to the Vero E6 cells up to 500 mu
   g/mL. No systemic or topical toxicity was observed in vivo, even with
   mice treated with concentrated formulation (100 mg/mL). The mechanistic
   studies indicated that polymers interacted with the cell and blocked the
   formation of the entry/fusion complex. Physicochemical and biological
   properties of PEG(x)-b-PMAPTAC(y) make them promising drug candidates.},
