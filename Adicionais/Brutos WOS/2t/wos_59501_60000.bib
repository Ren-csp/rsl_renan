@article{ WOS:000397018000042,
Author = {Krishnan, Vaishnav and Stoppel, David C. and Nong, Yi and Johnson, Mark
   A. . and Nadler, Monica J. S. and Ozkaynak, Ekim and Teng, Brian L. and
   Nagakura, Ikue and Mohammad, Fahim and Silva, Michael A. and Peterson,
   Sally and Cruz, Tristan J. and Kasper, Ekkehard M. and Arnaout, Ramy and
   Anderson, Matthew P.},
Title = {Autism gene Ube3a and seizures impair sociability by repressing
   VTA Cbln1},
Journal = {NATURE},
Year = {2017},
Volume = {543},
Number = {7646},
Pages = {507+},
Month = {MAR 23},
Abstract = {Maternally inherited 15q11-13 chromosomal triplications cause a frequent
   and highly penetrant type of autism linked to increased gene dosages of
   UBE3A, which encodes a ubiquitin ligase with transcriptional
   co-regulatory functions. Here, using in vivo mouse genetics, we show
   that increasing UBE3A in the nucleus downregulates the glutamatergic
   synapse organizer Cbln1, which is needed for sociability in mice.
   Epileptic seizures also repress Cbln1 and are found to expose
   sociability impairments in mice with asymptomatic increases in UBE3A.
   This Ube3a-seizure synergy maps to glutamate neurons of the midbrain
   ventral tegmental area (VTA), where Cbln1 deletions impair sociability
   and weaken glutamatergic transmission. We provide preclinical evidence
   that viral-vector-based chemogenetic activation of, or restoration of
   Cbln1 in, VTA glutamatergic neurons reverses the sociability deficits
   induced by Ube3a and/ or seizures. Our results suggest that gene and
   seizure interactions in VTA glutamatergic neurons impair sociability by
   downregulating Cbln1, a key node in the expanding protein interaction
   network of autism genes.},
