@article{ WOS:001464294200013,
Author = {Li, Bo I. and Alvarez, Mariano J. and Zhao, Hui and Chirathivat, Napon
   and Califano, Andrea and Shen, Michael M.},
Title = {The regulatory architecture of the primed pluripotent cell state},
