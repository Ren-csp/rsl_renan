@article{ WOS:001736903600004,
Author = {Lucas, Lathan and Tsoi, Phoebe S. and Quan, My Diem and Choi, Kyoung-Jae
   and Ferreon, Josephine C. and Ferreon, Allan Chris M.},
Title = {Tubulin transforms Tau and α-synuclein condensates from pathological to
   physiological},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAR 3},
Abstract = {Proteins undergo phase separation to form membraneless condensates that
   spatially organize biomolecular interactions. These condensates can
   support cellular physiology or instigate pathological protein
   aggregation. Tau and alpha-synuclein (alpha Syn) are neuronal proteins
   that form heterotypic Tau:alpha Syn condensates associated with
   physiological and pathological processes. Tau and alpha Syn regulate
   microtubules, but also misfold and co-deposit in aggregates linked to
   neurodegenerative disease, highlighting the ambivalent impact of
   Tau:alpha Syn condensation in health and disease. Here, we show that
   Tubulin modulates Tau:alpha Syn condensates by promoting microtubule
   interactions and inhibiting homotypic and heterotypic pathological
   oligomers. In the absence of Tubulin, Tau-driven condensation
   accelerates formation of pathogenic Tau:alpha Syn heterodimers and
   amyloid fibrils. Tubulin partitioning into condensates promotes
   microtubule polymerization and prevents Tau and alpha Syn
   oligomerization. We identify distinct Tau and alpha Syn structural
   states in pathological Tubulin-absent versus physiological Tubulin-rich
   condensates. In neuronal models, microtubule loss drives pathological
   oligomer formation and neurite loss, whereas inducible Tau condensation
   stabilizes microtubules.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Ferreon, JC; Ferreon, ACM (Corresponding Author), Baylor Coll Med, Dept Biochem \& Mol Pharmacol, Houston, TX 77030 USA.
   Lucas, Lathan; Tsoi, Phoebe S.; Quan, My Diem; Choi, Kyoung-Jae; Ferreon, Josephine C.; Ferreon, Allan Chris M., Baylor Coll Med, Dept Biochem \& Mol Pharmacol, Houston, TX 77030 USA.},
DOI = {10.1038/s41467-026-69618-3},
EarlyAccessDate = {MAR 2026},
