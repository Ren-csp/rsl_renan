@article{ WOS:001672417400001,
Author = {Inyama, Joseph and Warner, Jeroen and Lagendijk, Arnoud},
Title = {Climatic disasters and trans-national migration practices: indigenous
   people's ontological perceptions in Nigeria},
Journal = {ENVIRONMENTAL HAZARDS-HUMAN AND POLICY DIMENSIONS},
Year = {2026},
Month = {2026 JAN 23},
Abstract = {In this article, we examined climate-related disasters through the lens
   of trans-local and national mobility practices. We do this by focusing
   on the lived realities of two Indigenous communities in Nigeria.
   Although there is growing recognition of the complex relationship
   between climate change and migration, there remains a significant gap in
   understanding Indigenous perspectives on climate change-enhanced natural
   hazards and disasters {[}CCENHD]. This study addresses this by examining
   Indigenous peoples' perspectives on vulnerabilities across generations,
   including the complexities of place awareness and community
   positionality, as well as the impact of shifting onsetting events on the
   migration practices of Indigenous local populations. We employed
   innovative qualitative methods, such as photovoice, videography, and
   life history interviews, to explore their responses to the physical
   threat posed by climate change shocks and to examine how these
   vulnerable Indigenous communities' recognition of their positionality
   impacts their livelihood aspirations and mobility intentions. Findings
   highlight changing generational perceptions of climate vulnerability
   across temporal shifts, contributing to understanding the pluralisation
   of Indigenous perspectives on the climatic disaster-migration nexus. The
   study recommends a targeted and inclusive policy on climate adaptation
   investment in Indigenous local communities.},
