@article{ WOS:001839691700001,
Author = {Zheng, Ziqi and Fu, Hui and Fu, Guang and Sheng, Xiushen},
Title = {Beyond the boundaries: Assessing the ecological spillover effects of
   Hainan's national park collaborative zone through a multi-scale spatial
   lens},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {This study investigates the Collaborative Zone of Hainan Tropical
   Rainforest National Park (CZ-HNTRNP), evaluating its ecosystem service
   value (ESV) using the Equivalent Factor Method (EFM) based on land use
   changes. Five socioeconomic and natural factors-population density
   (POP), GDP density (GDP), NDVI, distance to the nearest road (RO), and
   distance to the nearest railway (RA)-were selected as explanatory
   variables. The spatial spillover effects and key drivers were assessed
   at both township scale and grid scale (4km \& times; 4 km). The results
   show that from 1995 to 2020, CZ-HNTRNP exhibited a generally slowing
   trend in land use changes, with landscape patterns stabilizing. Forest
   land dominated the area, while cultivated land fluctuated downward.
   Construction land increased significantly, and unused land continued to
   decrease. The ESV of CZ-HNTRNP showed an upward trend followed by a
   decline, rising from 144.61 billion yuan to 145.89 billion yuan during
   this period. Forest land contributed the most, accounting for over 70\%
   of the total ESV, and its spatial distribution was highly concentrated.
   The CZ-HNTRNP demonstrated significant spatial spillover effects, where
   increased local ESV promoted higher ESV in surrounding areas. While the
   findings across both scales aligned with the overall trend, notable
   differences emerged at the detailed level.},
