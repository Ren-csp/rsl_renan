@article{ WOS:001598667800001,
Author = {Balog-Way, Dominic and McComas, Katherine and Lambert, Catherine and
   Cousse, Julia and Trutnevyte, Evelina},
Title = {Public perceptions of enhanced geothermal systems: A cross-national
   study on affective imagery, familiarity, and support},
Journal = {ENERGY POLICY},
Year = {2026},
Volume = {208},
Month = {JAN},
Abstract = {Enhanced geothermal systems (EGS) are a next-generation renewable energy
   technology with the potential to advance net-zero climate goals,
   accelerate energy transitions, and create green jobs. For policymakers,
   understanding public perceptions is essential to anticipating support
   and opposition and designing responsive risk communication approaches.
   This cross-national study examines how people's initial positive and
   negative cognitive associations with EGS relate to geothermal energy
   familiarity and support. Data were collected via an online survey in the
   United States (n = 1003) and Switzerland (n = 1028), two countries with
   active EGS expansion plans. Despite widespread unfamiliarity, most
   respondents (65.3 \%) associated EGS with positive imagery, including
   clean, sustainable, and innovative benefits. However, a sizeable
   minority associated EGS with negative images such as earthquakes or
   generic risks (e.g., ``dangerous,{''} ``unsafe{''}) (17.4 \%), or more
   neutral images (e.g., natural hydrothermal features) (17.3 \%). Support
   for EGS was high in both nations and strongly correlated with affective
   imagery and perceptions of EGS as clean and a good way to address
   climate change. Greater familiarity also correlated with more positive
   associations and higher support. Policymakers and developers can use
   these insights to anticipate concerns, address salient risks, and
   communicate proactively through early public engagement. Understanding
   how affective associations shape public support provides a foundation
   for socially responsive EGS policy as projects move from demonstration
   to deployment.},
