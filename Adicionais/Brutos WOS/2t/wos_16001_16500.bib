@article{ WOS:001843568000001,
Author = {Woods, Carl T. and Richard, Veronique and Martin, David and Cairney,
   John},
Title = {Loosening tightened logics: A comment on the role of affordances},
Journal = {NEW IDEAS IN PSYCHOLOGY},
Year = {2026},
Volume = {83},
Month = {DEC},
Abstract = {In their essay, Tying Down Loose Space, Franck and Stevens (2007)
   explore the logics of tight and loose in urban settings. The former are
   spaces that predetermine activity through clearly demarcated
   socio-material features; the latter, those that support activity in ways
   yet-to-be determined. It is the (exploratory) activity that unfolds
   within these respective spaces that distinguishes these logics. While
   interdependent, the increasing sanitization of urban space threatens the
   logics of looseness, (un)wittingly tightening opportunities for people
   to meaningfully encounter the respective environs. What could be done to
   loosen such logics, encouraging meaningful exploratory activity in
   tightened urban settings? Here, we respond to this question by first
   thinking with Gibson's concept of affordance. Through its relational
   grounding, it frames `meaning', not as a mentally constructed affection
   attached to an environment `out there' but as an interwoven part of the
   person-environment system. This holds that `meaning' is discovered amid
   exploratory activity. To support this meaningful exploration in
   tightened urban settings, we then turn to the affordance-based design
   principle of spontaneity. Through a case example, we show how this
   principle could open room for looseness, supporting person-environment
   relations that unfold in unintended, yet meaningful ways.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
