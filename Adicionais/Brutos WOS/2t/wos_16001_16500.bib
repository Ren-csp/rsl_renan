@article{ WOS:001741155200001,
Author = {Woo, Eunju and Kim, Hyelin Lina and Kim, Yeong Gug},
Title = {Tourists' Carbon-Neutral Intentions and Willingness to Pay Tourism
   Carbon Tax: Integrating the Climate Change Risk Perception Model and
   Attitude Framework},
Journal = {INTERNATIONAL JOURNAL OF TOURISM RESEARCH},
Year = {2026},
Volume = {28},
Number = {2},
Month = {APR 15},
Abstract = {This study developed an integrated framework that combines the climate
   change risk perception model and the risk perception attitude framework
   to explain tourists' carbon-neutral behavior. Data were collected from
   300 Korean tourists via an online survey conducted in June 2025, and
   structural equation modeling was conducted. The results show that
   experiential processes strongly influence perceived risk, whereas
   cognitive and sociocultural factors enhance efficacy beliefs. Perceived
   risk and efficacy beliefs increase the intention to engage in
   carbon-neutral tourism, and efficacy beliefs directly affect the
   willingness to pay a tourism carbon tax. Moreover, the intention to
   engage in carbon-neutral tourism is a key predictor of financial
   commitment. These findings highlight the psychological pathways driving
   pro-environmental behavior and provide theoretical and managerial
   implications for promoting carbon-neutral tourism.},
