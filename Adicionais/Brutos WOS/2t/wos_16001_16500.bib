@article{ WOS:001587485400001,
Author = {Moqsud, M. Azizul and Akamatsu, Futa},
Title = {Integrating plant microbial fuel cells into green infrastructure:
   Tackling heat islands and powering sensors},
Journal = {BIORESOURCE TECHNOLOGY REPORTS},
Year = {2025},
Volume = {32},
Month = {DEC},
Abstract = {Green Infrastructure (GI) contributes to urban heat island mitigation
   and aesthetics, yet water supply monitoring remains labor-intensive.
   This study investigates bioelectricity generation using plant microbial
   fuel cells (PMFCs) integrated into a GI system constructed with recycled
   materials. Two GI models (120 x 50 x 60 cm) comprising three 20 cm
   layers of organic soil, recycled foamed glass (FWG), and decomposed
   granite were developed. Three PMFCs connecting in series with bamboo
   charcoal electrodes were embedded in the FWG layer beneath planted
   vegetation. Voltage was recorded every minute over 20 days and
   correlated with weather data. Results showed increased bioelectricity
   during summer driven by solar radiation, while precipitation and
   temperature had limited influence. In winter, voltage declined after one
   week. Peak voltage and power densities reached 1800 mV and 23 mW/m2
   (winter), and 1400 mV and 11 mW/m2 (summer). Thermographic imaging
   revealed temperature differences exceeding 20 degrees C between the GI
   surface and adjacent concrete, highlighting GI's thermal regulation
   potential.},
