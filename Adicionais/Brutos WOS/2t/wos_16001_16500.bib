@article{ WOS:001478278500003,
Author = {Gomes, Maria Vitoria Ribeiro and Amback, Beatriz Cruz and Neto, Hudson
   de Mello and Guimaraes, Luciana Fernandes and de Mattos, Rodrigo Rinaldi
   and Verol, Aline Pires and de Sousa, Matheus Martins and Magalhaes,
   Paulo Canedo de and Rezende, Osvaldo Moura and Miguez, Marcelo Gomes},
Title = {Territorial Ordering through Hydrological Interest Areas and Functional
   Spatial Arches},
