@article{ WOS:001730778700001,
Author = {Cichon, Dariusz},
Title = {Land Use Transformation and Climate Resilience in Smart Cities: Role of
   ICT in Modern Urban Planning},
Journal = {LAND DEGRADATION \& DEVELOPMENT},
Year = {2026},
Volume = {37},
Number = {13},
Pages = {9144-9154},
Month = {AUG 15},
Abstract = {Modern urban planning is experiencing a transition from traditional
   planning to the integration of information technology, which defines the
   concept of a ``smart city{''}. The study analyses the evolution of urban
   planning practices with an emphasis on the role of engineering and
   architecture in the process of urbanization, the transition to the
   involvement of architects in the development of urban spaces, and the
   impact of the latest ICT specialists on the formation of urban
   agglomerations in the 21st century. Based on comparative analysis using
   the IESE Cities in Motion Index and structured literature synthesis, the
   study identifies that the technological basis of the `smart city ``
   includes land usage to cover the utilization of artificial intelligence,
   climate change, and other modern information systems that contribute to
   improving the quality of urban life. The global trend toward the
   development of ``smart cities{''} emphasizes its necessity due to the
   growth of the urban population and climate change, as well as the
   constraints of nature. It is substantiated that the integration of
   innovative technologies is a key factor in solving urban problems, such
   as transport, ecology, waste management, and energy, which opens new
   opportunities for economic development and improving the quality of
   life. An integrated approach to the development and implementation of
   infrastructure solutions for ``smart cities{''} is proposed, leveraging
   modern information technologies to optimize the urban environment and
   improve the quality of life of residents. The detailed analysis
   concludes that technologies significantly increase the efficiency of
   urban resource management and climate change, contributing to
   sustainable development and economic growth.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
