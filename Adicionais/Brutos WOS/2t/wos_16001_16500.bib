@article{ WOS:000573224300002,
Author = {Wangsness, Paal Brevik and Proost, Stef and Rodseth, Kenneth Lovold},
Title = {Vehicle choices and urban transport externalities. Are Norwegian policy
   makers getting it right?},
Journal = {TRANSPORTATION RESEARCH PART D-TRANSPORT AND ENVIRONMENT},
Year = {2020},
Volume = {86},
Month = {SEP},
Abstract = {Norway has the world's highest share of battery electric vehicles (BEVs)
   in its passenger car fleet, thanks to a set of policies that has
   included high purchase taxes for fossil fueled cars, and no tolls, no
   VAT, and free parking for BEVs. This paper uses a very stylized
   transport model for the greater Oslo area to give insights into the
   effects of different transport policies. With this model we go beyond
   the market penetration studies for EVs, as it brings together both car
   choice and transport patterns with mode choice for a set of
   heterogeneous representative model agents. We illustrate the possible
   effects of current policies on congestion, CO2 emissions and other urban
   transport externalities, public transport use and crowding, tax revenues
   and welfare. On this basis, we explore other road toll, public transport
   fare and tax policies that can lead to better outcomes for the Oslo
   transport market while still respecting the CO2-cap that reflects the
   goals of Norwegian policy makers.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
