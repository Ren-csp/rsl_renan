@article{ WOS:001375228800001,
Author = {Gordillo-Chavez, Elias J. and Villanueva-Garcia, Claudia and
   Melo-Guerrero, Enrique and Hidalgo-Mihart, Mircea G. and Lizana-Avia,
   Miguel and Rodriguez-Lopez, Fernando and Colino-Rabanal, Victor J.},
Title = {Rancher viewpoint diversity in human-wildlife coexistence management:
   The case of jaguar-livestock interaction in the region of Calakmul,
   Mexico},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {1},
Pages = {67-80},
Month = {JAN},
Abstract = {Protected areas in Latin America are typically surrounded by ranching
   landscapes, where large carnivores such as the jaguar (Panthera onca),
   co-habit with ranchers, which potentially causes negative interactions.
   It is crucial, however, recognize that effective coexistence hinges on
   developing conservation policies that not only address these negative
   interactions but also embrace the diversity of the landowners'
   perspectives, aligning with the preferences of communities to prevent
   conservation conflicts. In this study, we conducted discrete choice
   experiments (DCE) with 196 ranchers in five localities in the Calakmul
   region to assess their preferences about four key attributes related to
   jaguar conservation: percentage of forests, livestock management
   practices, the number of desired jaguars and the willingness to invest
   in measures that promote coexistence between livestock and jaguars. Our
   research reveals that ranchers' preferences are diverse. Some favour
   increased forest cover and silvopastoral ranching, while others prefer
   reduced forest areas and the absence of jaguars. To address these
   diverse viewpoints and promote positive preferences, we must develop a
   comprehensive strategy considering the full spectrum of needs and
   preferences. Therefore, conservation incentives must be designed to
   address local communities' fundamental needs, such as education,
   healthcare, women's empowerment and cultural preservation. Participatory
   diagnostics involving local communities are imperative to accurately
   identify these needs. The observed heterogeneity of preferences in our
   study emphasizes the importance of integrating these diverse
   perspectives into conservation policies for a more balanced and
   equitable distribution of resources. Our findings demonstrate the value
   of DCEs in providing valuable information for developing more effective
   and socially acceptable jaguar conservation policies that consider
   diverse perspectives and the people's characteristics in our sample
   population.Read the free Plain Language Summary for this article on the
   Journal blog.
   Las \& aacute;reas protegidas en Am \& eacute;rica Latina suelen estar
   rodeadas de paisajes agropecuarios, donde los grandes carn \&
   iacute;voros como el jaguar (Panthera onca) cohabitan con los ganaderos,
   lo que potencialmente provoca interacciones negativas. Sin embargo, es
   crucial reconocer que una coexistencia efectiva depende del desarrollo
   de pol \& iacute;ticas de conservaci \& oacute;n que no solo aborden
   estas interacciones negativas, sino que tambi \& eacute;n incluyan la
   diversidad de perspectivas de los due \& ntilde;os de tierras, aline \&
   aacute;ndose con las preferencias de las comunidades para prevenir
   conflictos de conservaci \& oacute;n. En este estudio, realizamos
   experimentos de elecci \& oacute;n discreta (DCE) con 196 ganaderos en
   cinco localidades de la regi \& oacute;n de Calakmul para evaluar sus
   preferencias sobre cuatro atributos claves relacionados con la
   conservaci \& oacute;n del jaguar: porcentaje de bosques, pr \&
   aacute;cticas de manejo del ganado, el n \& uacute;mero deseado de
   jaguares y la disposici \& oacute;n a invertir en medidas que promuevan
   la coexistencia entre el ganado y los jaguares. Nuestra investigaci \&
   oacute;n revela que las preferencias de los ganaderos son diversas.
   Algunos prefieren un aumento de la cobertura arb \& oacute;rea y la
   ganader \& iacute;a silvopastoril, mientras que otros prefieren que
   disminuya el \& aacute;rea forestales y la ausencia de jaguares. Para
   abordar esta diversidad de perspectivas y promover preferencias
   positivas, debemos desarrollar una estrategia integral que considere
   todo el espectro de necesidades y preferencias. Por lo tanto, los
   incentivos de conservaci \& oacute;n deben dise \& ntilde;arse para
   abordar las necesidades fundamentales de las comunidades locales, como
   la educaci \& oacute;n, la atenci \& oacute;n m \& eacute;dica, el
   empoderamiento de las mujeres y la preservaci \& oacute;n cultural,
   entre otras. Los diagn \& oacute;sticos participativos que involucren a
   las comunidades locales son imprescindibles para identificar con precisi
   \& oacute;n estas necesidades. La heterogeneidad de las preferencias
   observada en nuestro estudio enfatiza la importancia de integrar estas
   diversidad de perspectivas en las pol \& iacute;ticas de conservaci \&
   oacute;n para una distribuci \& oacute;n m \& aacute;s equilibrada y
   equitativa de los recursos. Nuestros resultados demuestran el valor de
   los DCE para proporcionar informaci \& oacute;n valiosa para desarrollar
   pol \& iacute;ticas de conservaci \& oacute;n del jaguar m \& aacute;s
   efectivas y socialmente aceptables, que consideren la diversidad de
   pensamientos y las caracter \& iacute;sticas de las personas en nuestra
   muestra poblacional.},
