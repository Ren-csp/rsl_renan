@article{ WOS:001043222800002,
Author = {Corral, Silvia and Hamon, Leyla Angelica Sandoval},
Title = {The performance of the University concerning the sustainability of its
   campuses from the perception of its stakeholders},
Journal = {FORO EDUCACIONAL},
