@article{ WOS:001860405500001,
Author = {Qu, Rui and Lee, Sang-Hyun and Rhee, Zaewoong and Bae, Seung-Jong},
Title = {A Multidimensional Diagnostic Model of Rural Population Imbalance Within
   the Urban-Rural Context: Structure, Flow, and Spatial Distribution},
Journal = {LAND},
Year = {2026},
Volume = {15},
Number = {8},
Month = {JUL 23},
Abstract = {Structural population imbalance has become a critical issue in rural
   areas under ongoing urban-rural transformation. Rural demographic change
   is closely linked to urban development and spatial planning, yet
   existing studies have largely focused on single-dimensional issues such
   as aging or population decline, limiting understanding of regional
   demographic diversity and rural-urban interactions. To address this
   limitation, this study proposes the Point-Flow-Area (PFA) model, a
   multidimensional framework integrating population age structure,
   migration patterns, and spatial distribution. The model is applied
   through empirical case studies to examine rural population imbalance
   across regions. The results reveal substantial regional differences in
   demographic structure, migration dynamics, and spatial clustering. Even
   regions with similar age structures exhibit different migration pathways
   and spatial patterns, reflecting varying relationships with nearby urban
   areas. These findings indicate that rural population change should be
   understood within broader urban-rural systems rather than as isolated
   local phenomena. The PFA model offers both a conceptual framework and an
   analytical tool for examining multidimensional population dynamics and
   supporting more place-sensitive approaches to regional and urban
   planning.},
