@article{ WOS:001780915900001,
Author = {Chen, W. F. and Li, J. and Liang, J. Y. and Zhang, F. and Li, Y. and
   Zhao, W. Q.},
Title = {CARBON REGULATION INTENSITY AND AGRICULTURAL INDUSTRY INTEGRATION UNDER
   CHINA'S DUAL-CARBON GOALS: PATHWAYS AND THE ROLE OF GREEN INNOVATION},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {6309-6335},
Abstract = {The integrated development of agricultural industries serves as a
   crucial driver for advancing high-quality agricultural development.
   Against the backdrop of the ``dual carbon{''} goals penetrating deeper
   into the agricultural sector, this study examines the relationship
   between carbon regulation intensity and agricultural industrial
   integration using data from 282 prefecture-level cities in China. The
   findings reveal that carbon regulation intensity significantly promotes
   agricultural industrial integration, with this effect exhibiting
   regional and agricultural endowment heterogeneity. The positive impact
   is more pronounced in central regions and areas with favorable
   agricultural endowments. Mechanism analysis demonstrates that carbon
   regulation intensity facilitates agricultural industrial integration
   through three pathways: the ``green technology spillover effect,{''}
   ``production cost substitution effect,{''} and ``market demand upgrading
   effect,{''} which operate by enhancing industrial eco-efficiency quality
   and industrial co-agglomeration. Furthermore, the introduction of green
   innovation level as a variable indicates that improvements in green
   innovation contribute to industrial eco-efficiency quality. Through
   technological iteration and upgrading, green innovation reinforces the
   positive impact of carbon regulation intensity on agricultural
   industrial integration. These findings hold significant theoretical and
   practical value for empowering high-quality agricultural development
   through carbon regulation and supporting agricultural and rural
   modernization.},
Publisher = {ALOKI Applied Ecological Research and Forensic Inst Ltd},
