@article{ WOS:001417215600004,
Author = {Serrano, Manuel Montanes and Minguez, Almudena Moreno},
Title = {Affection and paternal/maternal filial control according to the
   offspring's discourse},
Journal = {OBETS-REVISTA DE CIENCIAS SOCIALES},
Year = {2025},
Volume = {20},
Number = {1},
Pages = {97-118},
Abstract = {Several papers conclude that children perceive the father's parenting
   style differently from the mother's. The aim of this article is to find
   out whether gender and work status are variables that condition
   affective relationships and paternal/maternal filial control. According
   to a qualitative methodology/structure, three discussion groups were
   conducted, with four boys and four girls between 12 and 14 years of age
   participating in each of them. Analysing the discursive raw material, it
   is concluded that there are no differences between parents who are in
   public employment, regardless of their qualification/training. Among
   them, there is a panoply of situations. However, all fathers are
   affectionate. Thus, the traditional paradigm that assigns to the mother
   the affectionate dimension and to the father the control and
   responsibility for establishing rules and punishments is called into
   question.},
Publisher = {UNIV ALICANTE, INST UNIV DESARROLLO SOCIAL \& PAZ-IUDESP},
