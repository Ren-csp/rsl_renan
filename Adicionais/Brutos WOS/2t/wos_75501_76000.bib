Title = {Race/Ethnicity, Socioeconomic Status, Residential Segregation, and
   Spatial Variation in Noise Exposure in the Contiguous United States},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {2017},
Volume = {125},
