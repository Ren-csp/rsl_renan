@article{ WOS:001248769100001,
Author = {Bhaktikul, Kampanad and Phonphoton, Nuchcha},
Title = {Development of an integrated sustainability indicator for the local
   people surrounding a reservoir project},
Journal = {SUSTAINABLE FUTURES},
Year = {2024},
Volume = {7},
Month = {JUN},
Abstract = {Sustainable benefits from water resource development involve many
   factors that need to be holistically considered for implementing
   management policies. The study aimed to develop a set of key
   sustainability indicators following the social context surrounding a
   reservoir. The results show the quality -of -life is the highest
   significance, followed by natural resource conservation, risk
   management, participation, and equality, respectively. The indicator of
   the highest significance in the quality of life was confidence in
   livelihoods against flood and drought. The findings can apply to the
   assessment of sustainable development from reservoir projects and
   support a broader analysis of key sustainability criteria in various
   areas.},
