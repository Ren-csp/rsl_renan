@article{ WOS:001517466200001,
Author = {Huang, Beilei and Zhang, Jinhua and Li, Xiyuan},
Title = {Relationships Between Guanxi of Mega Individuals, Social Support, and
   Dual Innovation Performance: The Moderating Effect of Interpersonal
   Capitalization Competence},
Journal = {SAGE OPEN},
Year = {2025},
Volume = {15},
Number = {2},
Month = {APR},
Abstract = {The purpose of this research is to explore the mechanism by which strong
   or weak guanxi constructed by mega individuals with interpersonal skills
   affect incremental or breakthrough innovation performance. Based on the
   questionnaire of 525 mega individuals, this study has verified that
   strong guanxi cannot directly affect the incremental innovation
   performance, but the intermediary variables need Indirect effects of
   emotional, instrumental, and information support). In addition, the
