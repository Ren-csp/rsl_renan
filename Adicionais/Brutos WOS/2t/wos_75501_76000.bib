@article{ WOS:000412525400022,
Author = {Smith, Emily R. and Shankar, Anuraj H. and Wu, Lee S-F and Aboud, Said
   and Adu-Afarwuah, Seth and Ali, Hasmot and Agustina, Rina and Arifeen,
   Shams and Ashorn, Per and Bhutta, Zulfiqar A. and Christian, Parul and
