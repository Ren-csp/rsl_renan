@article{ WOS:001862217300001,
Author = {Ahmad, Shah Nawaz and Anders, Sven and Wolodko, John},
Title = {Barriers and opportunities of carbon utilizing mineralization
   technologies in Canada},
Journal = {CLEAN TECHNOLOGIES AND ENVIRONMENTAL POLICY},
Year = {2026},
Volume = {28},
Number = {9},
Month = {AUG 28},
Abstract = {Limiting greenhouse gases (GHG) causing global warming may present an
   area of opportunity for building and construction industries. Carbon
   capture and utilization (CCU) technologies convert carbon dioxide (CO2)
   into value-added products such as through mineralization resulting in
   enhanced concrete products that have attracted attention from academics,
   industry practitioners and government regulators alike. The objective of
   this paper is to study the benefits, risks and challenges of CCU
   mineralization and develop policy recommendations toward increased
   targeted support, technology development and industry collaboration.
   This analysis uses semi-structured interviews involving members from six
   stakeholder groups along the mineralization supply chain: CCU technology
   developers, cement and concrete companies, industry associations,
   service providers, building and construction contractors, and government
   agencies. The results of thematic analysis using open coding revealed
   five categories and themes of critical factors that influence CCU
   technology adoption and innovation decision process: carbon emissions,
   technology development, competition and collaboration, policy and
   lobbying, and risk and uncertainty. The top three themes during the
   interviews were carbon emissions reduction, market penetration,
   retrofitting and scalability, and social license. Our findings suggest
   that GHG mitigation and social responsibility are important criteria in
   stakeholder CCU technology adoption decisions next to market and
   regulatory factors. Addressing industry concerns with CCU adoption will
   allow the technology to overcome current challenges in order to reach
   widespread implementation.},
