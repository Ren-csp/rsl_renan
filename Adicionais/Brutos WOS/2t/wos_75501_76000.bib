@article{ WOS:000287596900009,
Author = {Larsen, Sanne Vammen},
Title = {Risk as a challenge in practice: investigating climate change in water
   management},
Journal = {REGIONAL ENVIRONMENTAL CHANGE},
Year = {2011},
Volume = {11},
Number = {1},
Pages = {111-122},
Month = {MAR},
Abstract = {Climate change is one of the risks that society faces today. Among other
   things, it has the potential to interfere with the water environment,
   and thus it can be a relevant factor in current work with river basin
   management plans (RBMPs) in Denmark. At the same time, climate change in
   theory has characteristics that can pose challenges, if included in such
   a planning process. In this article, it is investigated what the
   attitudes towards climate change are among actors in the planning
   process, and what the main drivers, barriers and challenges related to
   including climate change in the RBMPs are, compared to the theoretical
   challenges. The investigation consists of a document study of hearing
   responses, interviews, and a survey among Danish municipalities. The
   overall results are that there are many attitudes towards the inclusion
   of climate change as a factor in RBMPs and that this diversity
   theoretically can be a challenge in the planning process. The main
   theoretical and practical barriers and challenges in connection with
   inclusion of climate change in RBMPs relate to lacking knowledge and
   uncertainty.},
