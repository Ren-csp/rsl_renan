@article{ WOS:001352714500001,
Author = {Wuehr, Peter and Heuer, Herbert},
Title = {Where does the processing of size meet the processing of space?},
Journal = {ATTENTION PERCEPTION \& PSYCHOPHYSICS},
Year = {2025},
