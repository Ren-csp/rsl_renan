@article{ WOS:000460693000006,
Author = {Ahmed, Bayes and Kelman, Ilan and Kamruzzaman, Md. and Mohiuddin,
   Hossain and Rahman, Md. Mostafizur and Das, Anutosh and Fordham, Maureen
   and Shamsudduha, Mohammad},
Title = {Indigenous people's responses to drought in northwest Bangladesh},
Journal = {ENVIRONMENTAL DEVELOPMENT},
Year = {2019},
Volume = {29},
Pages = {55-66},
Month = {MAR},
Abstract = {Bangladesh is highly disaster-prone, with drought being a major hazard
   which significantly impacts water, food, health, livelihoods, and
   migration. In seeking to reduce drought vulnerabilities and impacts
   while improving responses, existing literature pays limited attention to
   community-level views and actions. This paper aims to contribute to
   filling in this gap by examining how an indigenous group, the Santal in
   Bangladesh's northwest, responds to drought through local strategies
   related to water, food, and migration which in turn impact health and
   livelihoods. A combination of quantitative data through a household
   survey and qualitative data through participatory rural appraisal is
   used. The results suggest that the Santal people have developed and
   applied varied mechanisms for themselves to respond to drought. The
   categories of responses found are water collection and storage, crop and
   livestock selection, and migration. These responses might not be enough
   to deal with continuing droughts, yielding lessons for Bangladesh and
   beyond.},
