Title = {Family characteristics associated with child-to-parent aggressions in
   adolescents},
Journal = {ANALES DE PSICOLOGIA},
Year = {2014},
Volume = {30},
Number = {3},
Pages = {1176-1182},
Month = {OCT},
Abstract = {The Child-to-Parent Aggression (CPA) is an area of growing interest.
   Previous studies suggest that a variety of family factors can act as
   explanatory elements of the CPA, such as exposure to violence, emotional
   neglect and permissive parenting style. This study examined the
   association of these factors with the occurrence of severe physical and
   psychological CPA. A total of 1698 adolescents (870 boys and 828 girls),
   aged between 12 and 17 years, answered CPA measures, exposure to
   violence, affection and communication, parental abandonment and
   permissive parenting style. Results of logistic regression analysis
   showed that low levels of affection and communication were associated
   with all forms of severe CPA. Witnessing family violence was associated
   with the physical VFP against fathers whereas direct victimization in
   family was associated with physical CPA against mothers, and
   psychological CPA against both parents. The permissive style was
   associated with the severe psychological CPA but not with the physical
   CPA.},
