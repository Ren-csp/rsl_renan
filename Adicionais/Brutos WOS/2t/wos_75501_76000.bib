Author = {Suffren, Sabrina and La Buissonniere-Ariza, Valerie and Tucholka, Alan
   and Nassim, Marouane and Seguin, Jean R. and Boivin, Michel and Singh,
   Manpreet Kaur and Foland-Ross, Lara C. and Lepore, Franco and Gotlib,
