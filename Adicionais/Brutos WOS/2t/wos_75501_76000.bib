@article{ WOS:001808733300001,
Author = {Yan, Aqian and Luo, Bowen and Luo, Xiaofeng},
Title = {Mitigating the inhibitory effect of information incompleteness on
   biopesticide adoption: The moderating role of social trust among
   smallholder rice farmers in China},
Journal = {FRONTIERS IN ENVIRONMENTAL ECONOMICS},
Year = {2026},
Volume = {5},
Month = {JUN 17},
Abstract = {Biopesticides are effective alternatives to chemical pesticides,
   critical for advancing green and sustainable agriculture. However,
   farmers' inadequate access to and poor understanding of
   biopesticide-related information severely constrain the adoption of this
   technology, hindering the optimization of precision agricultural
   systems. To address this information gap, we use survey data from 992
   rice farmers in Hubei Province, China, to operationalize ``information
   incompleteness{''} across three dimensions: experiential information,
   operational information, and control information. We then empirically
   examine how information incompleteness impacts biopesticide adoption and
   the moderating role of social trust. Results show that: (1) Information
   incompleteness significantly inhibits biopesticide adoption: a 1\%
   increase in information incompleteness reduces farmers' adoption
   probability by 26.20\%. (2) Social trust plays a significant positive
   moderating effect farmers' biopesticide adoption under information
   incompleteness, with both institutional trust and interpersonal trust
   contributing notably. (3) Heterogeneity analysis reveals the interaction
   of information incompleteness with institutional trust is stronger for
   higher-education, younger, and large-scale farmers. In contrast, its
   interaction with interpersonal trust is more pronounced for
   lower-education, elderly, and small-scale farmers. The synergistic
   effect of information incompleteness and social trust is also more
   impactful for farmers who received government biopesticide propaganda.
   (4) Institutional trust scores above 3 effectively reduce information
   incompleteness's inhibitory effect. We conclude policymakers should
   leverage collaborative promotion by agricultural technicians, village
   cadres, and large-scale farmers. A ``government promotion + social
   trust{''} framework will improve farmers' access to biopesticide
   information, thus facilitating biopesticide adoption and supporting
   sustainable precision agriculture.},
