@article{ WOS:001727815800001,
Author = {Tvedt, Maren Stabel and Vestad, Lene},
Title = {Task analysis in the forethought phase: associations with academic
   achievement and perceived teacher support in upper secondary school},
Journal = {SCANDINAVIAN JOURNAL OF EDUCATIONAL RESEARCH},
Year = {2026},
Month = {2026 MAR 27},
Abstract = {While task analysis is considered a core aspect of self-regulated
   learning, its specific relationship with academic achievement among
   upper secondary school students and how it may be promoted in school
   remains poorly understood. With a sample of 634 first-year students
   pursuing a general academic track in Norwegian upper secondary schools,
   the present study aimed to investigate the relationship between
   student-reported task analysis and academic achievement and determine
   how task analysis relates to three aspects of perceived support from
   teachers. A structural equation model indicated a positive association
   between task analysis and academic achievement (beta = .18, p < .001).
   Emotional and academic support from teachers was linked to task analysis
   through support for ownership of learning. Notably, only half of the
   students reported that their teachers facilitated their ownership in the
   learning process, highlighting an area for development. The practical
   implications of these findings are discussed in light of conducive
   preparation for higher education.},
