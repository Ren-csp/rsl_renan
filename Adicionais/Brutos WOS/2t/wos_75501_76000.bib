@article{ WOS:001839903700001,
Author = {Chi, Kate Hua-Ke},
Title = {State narratives of shale gas development: evidence from a text-as-data
   study of the United States and China},
Journal = {ENVIRONMENTAL POLITICS},
Year = {2026},
Month = {2026 AUG 6},
Abstract = {This study examines the time-varying patterns and interactions of shale
   gas narratives that legitimize continued development in the United
   States and China from 2010 to 2024. A corpus of 225 documents is
   constructed by extracting texts from government statements in the
   hypertext markup language (HTML) format. Employing text-as-data methods,
   analyses reveal a shared emphasis on the energy security and economic
   value of shale gas, and the framing of shale gas as clean fuel co-occurs
   with the economic frame, constructing the claim of an environmentally
   compatible development. Temporally, China's clean shale narratives
   calibrate in response to domestic air quality concerns, while notably in
   the US discourse, hydraulic fracturing technology serves a dual purpose:
   both a means of shale resource extraction and a diplomatic aim,
   leveraging technical know-how to extend international influence. Amid
   growing climate scrutiny, narratives shape the discursive boundaries of
   what states can credibly pursue and defend in resource development.},
