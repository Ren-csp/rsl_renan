   Montalvo, T. and Hatchwell, B. J.},
Title = {The reproductive capacity of Monk Parakeets Myiopsitta monachus
   is higher in their invasive range},
Journal = {BIRD STUDY},
Year = {2019},
Volume = {66},
Number = {1},
Pages = {136-140},
Month = {JAN 2},
Abstract = {Breeding parameters for Monk Parakeets Myiopsitta monachus nesting in
   Barcelona, Spain, were collected for 651 nests over five breeding
   seasons. This invasive population has a high reproductive capacity
   compared with the species in the native range: fledging success was
   double, the percentage of pairs attempting second broods three times
   higher and 55\% of first-year birds bred compared with almost zero in
   South America.},
