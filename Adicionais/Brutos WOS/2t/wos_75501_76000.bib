@article{ WOS:000636270400009,
Author = {Nonaka, Tetsushi and Ito, Kiyohide and Stoffregen, Thomas A.},
Title = {Structure of variability in scanning movement predicts braille reading
   performance in children},
Journal = {SCIENTIFIC REPORTS},
Year = {2021},
Volume = {11},
Number = {1},
Month = {MAR 30},
Abstract = {Among children learning to read braille, we asked whether the
   quantitative kinematics of scanning movements of the reading finger
   would be related to the proficiency of braille reading. Over a period of
   12 months, we recorded the position and orientation of the reading
   fingers of eight congenitally or early blind children. We found that the
   strength of long-range power-law temporal correlations in the velocity
   fluctuations increased with performance in braille reading. In addition,
   we found that the variability of the angular orientation of the reading
   finger that affects the contact region on the fingerpad was negatively
   related to braille reading performance. These results confirm that the
   quantitative kinematics of finger scanning movements were related to
   functional performance in braille reading. The results add to the
   growing body of evidence that long-range temporal correlations in
   exploratory behavior can predict perceptual performance, and that
   scanning movements that center important tactile information on the
   small, high resolution area contribute to the pickup of information.},
