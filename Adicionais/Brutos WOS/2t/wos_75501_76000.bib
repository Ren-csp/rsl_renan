@article{ WOS:000472480500014,
Author = {Cingolani, Gino and McCauley, Michael and Lobley, Anna and Bryer,
   Alexander J. and Wesolowski, Jordan and Greco, Deanna L. and Lokareddy,
   Ravi K. and Ronzone, Erik and Perilla, Juan R. and Paumet, Fabienne},
Title = {Structural basis for the homotypic fusion of chlamydial inclusions by
   the SNARE-like protein IncA},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JUN 21},
Abstract = {Many intracellular bacteria, including Chlamydia, establish a parasitic
   membrane-bound organelle inside the host cell that is essential for the
   bacteria's survival. Chlamydia trachomatis forms inclusions that are
   decorated with poorly characterized membrane proteins known as Incs. The
   prototypical Inc, called IncA, enhances Chlamydia pathogenicity by
   promoting the homotypic fusion of inclusions and shares structural and
   functional similarity to eukaryotic SNAREs. Here, we present the atomic
   structure of the cytoplasmic domain of IncA, which reveals a
   non-canonical four-helix bundle. Structure-based mutagenesis, molecular
   dynamics simulation, and functional cellular assays identify an
   intramolecular clamp that is essential for IncA-mediated homotypic
   membrane fusion during infection.},
