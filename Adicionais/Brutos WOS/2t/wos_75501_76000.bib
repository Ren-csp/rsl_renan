@article{ WOS:001587793700009,
Author = {Da Silva Jr, Jader Lucio and Farbiarz, Alexandre},
Title = {Education, mediatization, and affection The teacher and the production
   of meaning on Instagram},
Journal = {INMEDIACIONES DE LA COMUNICACION},
Year = {2024},
Volume = {19},
Number = {1},
Month = {JAN-JUN},
Abstract = {In this article, we propose to examine the influence of media
   communication on sociability and meaning production, reflecting on the
   affective dimension in knowledge construction. Considering the aesthetic
   experience, we outline both the transformations brought about by media
   technologies in education and the social and cultural implications
   resulting from teachers' appropriation of spaces mediated by platforms.
   Assuming that communication plays a central role in human relationships,
   we explore the concepts of mediatization and everyday life in the
   aesthetic language of social platforms, especially Instagram. Following
   a theoretical confluence, we conduct a qualitative descriptive analysis
   of an in-depth interview with digital influencer educators
   @carolmendonca and @professornoslen. As a result, we point out
   reflections on the phenomenon of digital influence by teachers, starting
   from the affective sphere and interaction as producers of meanings and
   knowledge in Communication.},
