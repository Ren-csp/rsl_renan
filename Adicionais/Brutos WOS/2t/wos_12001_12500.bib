@article{ WOS:001090103900002,
Author = {Chakraborty, Pinaki and Yadav, Savita},
Title = {Human-Computer Interaction: An Everyman's Introduction},
Journal = {EVERYMANS SCIENCE},
Year = {2021},
Volume = {56},
Number = {5-6},
Month = {DEC-MAR},
Abstract = {Conscious effort has been made since the 1980s to make computers usable
   for more people. Human-computer interaction is described as a branch of
   computer science that studies how people interact with computers and how
   user interface of software systems should be designed. Contemporary user
   interfaces are developed following user-centered design approach and are
   graphical and intuitive in nature. People like objects of their interest
   to be continuously visible on the screen and prefer working on them
   through incremental and reversible actions which are acknowledged by
   immediate feedback. Suitably designed user interfaces had played a
   crucial role in popularizing smartphones, smartwatches and social media
   in the recent years.},
