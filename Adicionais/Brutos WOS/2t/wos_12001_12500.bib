@article{ WOS:001825956200001,
Author = {de la Puente, Alfonso and Caballero-Fernandez, Jose M. and Balmori,
   Alfonso},
Title = {The progressive urban presence of American mink in a city of Spain},
Journal = {MAMMALIA},
Year = {2026},
Month = {2026 JUL 22},
Abstract = {In this note, we report observations of American mink (Neogale vison) in
   an urban ecosystem, specifically along the ring road separating the
   riparian zone of the Tormes River from the city centre of Salamanca. Up
   to six individuals were observed outside the riparian area, close to
   urban green spaces. Based on previous studies conducted in the same
   location, it appears that there is a trend towards the use of urban
   habitats by American mink, moving away from the riverbank. Intensive
   monitoring and targeted eradication efforts are recommended to assess
   the true impact of this mink population in urban-natural interfaces,
   particularly on local vertebrate communities.},
