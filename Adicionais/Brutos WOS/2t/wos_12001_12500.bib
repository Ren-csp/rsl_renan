@article{ WOS:000930578400006,
Author = {Setiowati, Retno and Mizuno, Kosuke and Hasibuan, Hayati Sari and
   Koestoer, Raldi Hendro},
Title = {Urban green spaces for support healthiness in Jakarta during the
   COVID-19 pandemic: A quantitative study},
Journal = {ENVIRONMENTAL ENGINEERING RESEARCH},
Year = {2023},
Volume = {28},
Number = {2},
Month = {APR},
Abstract = {This research analyzes the criticality of Urban Green Spaces (UGS)
   environmental and health benefits during the COVID-19 pandemic. However,
   restrictions on mobility, safety concerns, and restricted access during
   the implementation of social distancing policies tend to use UGS to
   provide alternative spaces for social interaction and health. This is a
   severe concern to Jakarta, as the epicenter of the pandemic outbreak
   with limited UGS. An online survey was conducted from March to April
   2021 to understand better and investigate the impact of COVID-19 on the
   use of UGS and behavior-changing of visitation. The results show that
   respondents continued to use UGS during the pandemic and considered it
   more beneficial for health. However, the result showed that residents'
   considerations of staying active for health reasons, reduced stress, and
   boredom. This research provides empirical evidence illustrating the
   value of UGS as a resilient city infrastructure, therefore, the
   management policy in this city can be considered with potential
   application to other cities.},
