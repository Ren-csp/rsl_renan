@article{ WOS:001731078700001,
Author = {Rafi, Fahim Rahman and Shejuti, Samia Sultana and Rahman, Md. Mujibor},
Title = {Assessing the influence of the urban ecosystem services on urban quality
   of Life: A comprehensive study of Khulna City, Bangladesh},
Journal = {CITY AND ENVIRONMENT INTERACTIONS},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Rapid urbanization in developing cities like Khulna, Bangladesh, is
   putting immense pressure on the environment, making it harder to improve
   the quality of life (UQoL) for residents. Despite the city's valuable
   natural resources, many residents experience low well-being, which
   highlights the need to better understand the link between ecosystem
   services (ES) and UQoL. This study categorized Khulna into 6 urban areas
   and collected data through a combination of household surveys and focus
   group discussions (FGDs). The Analytic Hierarchy Process (AHP) was used
   to rank the indicators of ES supply and UQoL demand, while Kendall's
   coefficient of concordance measured agreement, and gap analysis
   quantified discrepancies between available and expected UQoL. The
   findings show that unplanned residential areas (URA) benefit most from
   provisioning and regulating services, while cultural services such as,
   social relationships were valued (Cw - 45-73\%) across all areas.
   However, residents in slum areas still face significant challenges,
   particularly in economic well-being, despite access to other benefits.
   In the study UQoL rankings revealed low agreement (Kendall's W = 0.011,
   chi 2 = 0.2), signifying that residents are more attuned to deficiencies
   than to the benefits they receive. ES such as provisioning, regulating,
   and cultural services significantly influence various dimensions of
   UQoL. This study exposes the disconnect between ES supply and perceived
   UQoL demand, demonstrating how a lack of awareness and contextspecific
   planning undermines the potential of urban ecosystems to improve
   well-being. The study recommends implementing targeted green-blue
   infrastructure and community awareness programs to bridge this gap and
   enhance the quality of life in Khulna City and other rapidly urbanizing
   cities.},
