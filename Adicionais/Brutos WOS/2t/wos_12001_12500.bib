@article{ WOS:001610004900001,
Author = {Liukkonen, Paivikki and Vartiainen, Henriikka and Kokko, Sirpa},
Title = {Exploring human-nature-technology relations: learning ecologies of
   bio-oriented creative practices},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2026},
Volume = {32},
Number = {6},
Pages = {1419-1439},
Month = {JUN 3},
Abstract = {Responding to calls for transformative pedagogies for learning in,
   about, and with nature, the study explores trialogical interactions
   among learners, technologies, and more-than-human organisms within
   technologically mediated bioart-making in a Finnish upper secondary
   school. Guided by sociomaterial sensibilities, it employs a case study
   approach informed by multispecies microethnography. Data were generated
   through participant observation, interviews, photography, and video
   recordings, with analysis focusing on microscopy and sonification. The
   study identifies three tensions shaping technologically mediated
   bioart-making: sensory expansion versus abstraction, the authoritative
   aura of scientific tools, and cultural assumptions about authenticity
   and human involvement. Technologies expanded learners' sensory access to
   more-than-human life but also abstracted organisms into outputs,
   shifting focus from relational engagement to aesthetic evaluation.
   Scientific tools, particularly the microscope, carried cultural
   authority that shaped expectations, reinforcing assumptions of
   objectivity. Sonification, by contrast, made human involvement explicit,
   prompting skepticism and discomfort with co-producing outcomes. These
   tensions highlight the need for pedagogical scaffolding that makes
   technological mediation visible and discussable. Without such
   reflection, scientific tools, even in creative contexts, may reinforce
   dualistic epistemologies and obscure the co-constructed nature of
   learner-technology-organism relations. The study argues for
   technological literacy that complements environmental literacy, enabling
   critical engagement with sociotechnical mediations of nature.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
