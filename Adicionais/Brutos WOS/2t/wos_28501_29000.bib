@article{ WOS:000601089900015,
Author = {Marin-Cots, Pedro and Palomares-Pastor, Macarena},
Title = {In a 15 minute setting. Towards the City of Proximity, and its
   relationship with the Covid-19 and the Climate Crisis: the case of
   Malaga},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2020},
Volume = {52},
Number = {205},
Pages = {685-700},
Month = {FAL},
Abstract = {It is not a new idea, in fact the proximity city recovers the
   configuration of the dense classic Mediterranean cities, of mixed uses
   and with a proximity to the pedestrian scale of the main services that
   are usually done. Its attributes had already been included in the old
   Agenda 21 of 2005 and in the current Urban Agenda of 2015, but with the
   situations derived from the Covid-19 pandemic, new opportunities open up
   to promote the city of proximity, reconvert public spaces previously
   destined to the private vehicle and at the same time to intensify the
   actions against the climate crisis that are complementary in the
   objective of achieving a healthier and friendlier city.},
