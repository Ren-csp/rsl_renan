@article{ WOS:000474418000007,
Author = {Epperson, Anna E. and Henriksen, Lisa and Lambin, Eric F. and Prochaska,
   Judith J. and Flora, June A.},
Title = {Health Beliefs of American Indian Imagery on Natural American Spirit
   Packs},
