@article{ WOS:000312290800096,
Author = {Higueruelo, Alicia P. and Schreyer, Adrian and Bickerton, G. Richard J.
   and Blundell, Tom L. and Pitt, Will R.},
Title = {What Can We Learn from the Evolution of Protein-Ligand Interactions to
   Aid the Design of New Therapeutics?},
Journal = {PLOS ONE},
Year = {2012},
Volume = {7},
Number = {12},
Month = {DEC 11},
Abstract = {Efforts to increase affinity in the design of new therapeutic molecules
   have tended to lead to greater lipophilicity, a factor that is generally
   agreed to be contributing to the low success rate of new drug
   candidates. Our aim is to provide a structural perspective to the study
   of lipophilic efficiency and to compare molecular interactions created
   over evolutionary time with those designed by humans. We show that
   natural complexes typically engage in more polar contacts than synthetic
   molecules bound to proteins. The synthetic molecules also have a higher
   proportion of unmatched heteroatoms at the interface than the natural
   sets. These observations suggest that there are lessons to be learnt
   from Nature, which could help us to improve the characteristics of
   man-made molecules. In particular, it is possible to increase the
   density of polar contacts without increasing lipophilicity and this is
   best achieved early in discovery while molecules remain relatively
   small.},
