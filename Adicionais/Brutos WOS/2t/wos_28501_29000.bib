@article{ WOS:000518424500004,
Author = {Roldan, Diego and Arelovich, Lisandro},
Title = {Contested territories. The fishermen, the riverside, the urbanism and
   the Parana River's Aquarium (Rosario, Argentina)},
Journal = {UNIVERSITAS-REVISTA DE CIENCIAS SOCIALES Y HUMANAS},
Year = {2020},
