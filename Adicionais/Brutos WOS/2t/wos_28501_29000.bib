Funding-Acknowledgement = {Minerva Center for Population Fragmentation; United States - Israel
   Binational Science Foundation; Israel Science Foundation {[}1826/20]},
Funding-Text = {We first and foremost thank the Haifa Salamander survey volunteers who,
