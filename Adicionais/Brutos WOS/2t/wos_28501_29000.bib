@article{ WOS:A1979JD67200009,
Author = {BABINSKAWERKA, J and GLIWICZ, J and GOSZCZYNSKI, J},
Title = {SYNURBIZATION PROCESSES IN A POPULATION OF APODEMUS AGRARIUS .2.
   HABITATS OF THE STRIPED FIELD-MOUSE IN TOWN},
Journal = {ACTA THERIOLOGICA},
Year = {1979},
Volume = {24},
Number = {22-3},
Pages = {405-415},
Abstract = {Trapping of A. agrarius (Pallas, 1771) was conducted in 78 urban green
   areas of Warsaw {[}Poland] from 1976-1978. The species occurred in 55\%
   of the study areas. By means of a 0-10 point scale, proposed here, all
   the areas were classified in respect of 5 criteria: size of area, size
   of complex in which the area is included, distance from town boundaries,
   shelters and quietness. The most important factor for A. agrarius in
   urban green areas is a sufficient amount of shelters; and the distance
   is the least important one, since the rodents also occur in the city
   district. The habitat requirements of A. agrarius in town are discussed.},
