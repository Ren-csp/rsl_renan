@article{ WOS:001273083300001,
Author = {Brumann, Christoph},
Title = {From private to public and back? Kyoto's cityscape councils and the
   urban commons},
Journal = {JOURNAL OF THE ROYAL ANTHROPOLOGICAL INSTITUTE},
Year = {2025},
Volume = {31},
Number = {1},
Pages = {240-263},
Month = {MAR},
Abstract = {Scholarly and public debate on the urban commons is burgeoning, but
   building exteriors and the cityscape these constitute are surprisingly
   absent from it, despite their considerable significance for and impact
   on residents and visitors. After reflecting on the cityscape as a
   commons, the article turns to Kyoto, the former capital of Japan and
   acclaimed stronghold of history and tradition. Decades of conflict about
   the built environment led to a new building code in 2007 that continues
   to enjoy broad support. Details of building design, however, are now
   left to `local cityscape councils', volunteer bodies that discuss
   construction plans with developers. Officially, local amateurs meet
   non-local professionals here, but ethnographic fieldwork in 2019/20
   revealed that both technical expertise and Kyoto ties are present on
   both sides. State representatives are also less absent than officially
   proclaimed. This case demonstrates that mixed management of the urban
   commons by the state and civil society can lead to amicable solutions
   that rise above vested interests, so that state involvement and
   `commoning' should not be posited as mutually exclusive.
   Du priv \& eacute; au public et retour ? Les conseils du paysage urbain
   de Kyoto et les communs urbainsR \& eacute;sum \& eacute;Dans le d \&
   eacute;bat acad \& eacute;mique et public \& eacute;mergent sur les
   communs urbains, l'ext \& eacute;rieur des b \& acirc;timents et le
   paysage urbain brillent \& eacute;tonnamment par leur absence en d \&
   eacute;pit de l'importance consid \& eacute;rable qu'ils rev \&
   ecirc;tent pour les habitants comme pour les visiteurs. Apr \& egrave;s
   une r \& eacute;flexion sur le caract \& egrave;re de commun du paysage
   urbain, l'article se concentre sur Kyoto, ancienne capitale du Japon et
   bastion reconnu de l'histoire et de la tradition. Des dizaines d'ann \&
   eacute;es de conflit \& agrave; propos de l'environnement b \& acirc;ti
   ont donn \& eacute; naissance, en 2007, \& agrave; un nouveau code de
   l'urbanisme qui reste aujourd'hui encore largement accept \& eacute;.
   Les d \& eacute;tails de la conception des b \& acirc;timents sont
   cependant laiss \& eacute;s \& agrave; des << conseils locaux du paysage
   urbain >>, compos \& eacute;s de b \& eacute;n \& eacute;voles qui
   discutent des projets de construction avec les promoteurs.
   Officiellement, des amateurs locaux y rencontrent des professionnels de
   l'ext \& eacute;rieur. En r \& eacute;alit \& eacute;, un travail de
   terrain ethnographique men \& eacute; en 2019-2020 a r \& eacute;v \&
   eacute;l \& eacute; autant d'expertise technique que de liens avec Kyoto
   d'un c \& ocirc;t \& eacute; comme de l'autre. En outre, les repr \&
   eacute;sentants des pouvoirs publics sont moins absents que ne le
   proclame le r \& eacute;cit officiel. Ce cas d \& eacute;montre que la
   gestion mixte des communs urbains par l'\& Eacute;tat et la soci \&
   eacute;t \& eacute; civile peut d \& eacute;boucher sur des solutions \&
   agrave; l'amiable d \& eacute;passant les int \& eacute;r \& ecirc;ts en
   pr \& eacute;sence, et que l'action des pouvoirs publics et celle des
   communs ne doivent donc pas \& ecirc;tre consid \& eacute;r \& eacute;es
   a priori comme mutuellement exclusifs.},
