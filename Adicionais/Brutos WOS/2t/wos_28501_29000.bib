@article{ WOS:000555426600022,
Author = {Shore, Erin and Schwatka, Natalie and Dally, Miranda and Brown, Carol E.
   and Tenney, Liliana and Newman, Lee S.},
Title = {Small Business Employees' Perceptions of Leadership Are Associated With
   Safety and Health Climates and Their Own Behaviors},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2020},
Volume = {62},
Number = {2},
Pages = {156-162},
Month = {FEB},
Abstract = {Objective: Leadership is an important factor in creating a safe and
   healthy work environment. Little is known about its influence in small
   organizations. This study assessed the relationship between leadership,
   climate, and employee behavior in organizations with less than 500
   employees. Methods: We examined organizational factors and worker
   perceptions of leadership and safety/health behaviors in an analysis of
   1271 employees in 53 Colorado small organizations. Cross-sectional
   relationships were assessed using multivariable linear regression
   models. Results: Perceived leadership commitment to safety was
   associated with safety climate (beta = 0.67) and safety behaviors among
   employees (beta = 0.45). Perceived leadership commitment to worksite
   wellness was associated with health climate (beta = 0.66) and health
   behaviors (beta = 0.42). Conclusions: Leadership plays an important role
   in creating a positive work environment around safety and health.},
