@article{ WOS:000434927000005,
Author = {Zhao, Wei-Dong and Liu, Dong-Xin and Wei, Jia-Yi and Miao, Zi-Wei and
   Zhang, Ke and Su, Zheng-Kang and Zhang, Xue-Wei and Li, Qiang and Fang,
   Wen-Gang and Qin, Xiao-Xue and Shang, De-Shu and Li, Bo and Li,
   Qing-Chang and Cao, Liu and Kim, Kwang Sik and Chen, Yu-Hua},
Title = {Caspr1 is a host receptor for meningitis-causing Escherichia coli},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {JUN 12},
Abstract = {Escherichia coli is the leading cause of neonatal Gram-negative
   bacterial meningitis, but the pathogenesis of E. coli meningitis remains
   elusive. E. coli penetration of the blood-brain barrier (BBB) is the
   critical step for development of meningitis. Here, we identify Caspr1, a
   single-pass transmembrane protein, as a host receptor for E. coli
   virulence factor IbeA to facilitate BBB penetration. Genetic ablation of
   endothelial Caspr1 and blocking IbeA-Caspr1 interaction effectively
   prevent E. coli penetration into the brain during meningitis in rodents.
   IbeA interacts with extracellular domain of Caspr1 to activate focal
   adhesion kinase signaling causing E. coli internalization into the brain
   endothelial cells of BBB. E. coli can invade hippocampal neurons causing
   apoptosis dependent on IbeA-Caspr1 interaction. Our results indicate
   that E. coli exploits Caspr1 as a host receptor for penetration of BBB
   resulting in meningitis, and that Caspr1 might be a useful target for
   prevention or therapy of E. coli meningitis.},
