Title = {BRCA mutational status shapes the stromal microenvironment of
   pancreatic cancer linking clusterin expression in cancer associated
   fibroblasts with HSF1 signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
