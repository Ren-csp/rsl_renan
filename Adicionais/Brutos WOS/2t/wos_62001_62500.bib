@article{ WOS:000905283100020,
Author = {Mauerman, Max and Black, Emily and Boult, Victoria L. and Diro, Rahel
   and Osgood, Dan and Greatrex, Helen and Chillongo, Thabbie},
Title = {An Information-Theoretic Approach to Reconciling Historical Climate
   Observations and Impacts on Agriculture},
Journal = {WEATHER CLIMATE AND SOCIETY},
