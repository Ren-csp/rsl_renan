@article{ WOS:001008541400003,
Author = {Ruan, Biao and He, Yanan and Chen, Yingwei and Choi, Eun Jung and Chen,
   Yihong and Motabar, Dana and Solomon, Tsega and Simmerman, Richard and
   Kauffman, Thomas and Gallagher, D. Travis and Orban, John and Bryan,
   Philip N.},
Title = {Design and characterization of a protein fold switching network},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {JAN 26},
Abstract = {To better understand how amino acid sequence encodes protein structure,
   we engineered mutational pathways that connect three common folds (3
   alpha, beta-grasp, and alpha/beta-plait). The structures of proteins at
   high sequence-identity intersections in the pathways (nodes) were
   determined using NMR spectroscopy and analyzed for stability and
   function. To generate nodes, the amino acid sequence encoding a smaller
   fold is embedded in the structure of an similar to 50\% larger fold and
   a new sequence compatible with two sets of native interactions is
   designed. This generates protein pairs with a 3 alpha or beta-grasp fold
   in the smaller form but an alpha/beta-plait fold in the larger form.
   Further, embedding smaller antagonistic folds creates critical states in
   the larger folds such that single amino acid substitutions can switch
   both their fold and function. The results help explain the underlying
   ambiguity in the protein folding code and show that new protein
   structures can evolve via abrupt fold switching.},
