@article{ WOS:000475852900003,
Author = {Hillary, Robert F. and McCartney, Daniel L. and Harris, Sarah E. and
   Stevenson, Anna J. and Seeboth, Anne and Zhang, Qian and Liewald, David
   C. and Evans, Kathryn L. and Ritchie, Craig W. and Tucker-Drob, Elliot
   M. and Wray, Naomi R. and McRae, Allan F. and Visscher, Peter M. and
   Deary, Ian J. and Marioni, Riccardo E.},
Title = {Genome and epigenome wide studies of neurological protein biomarkers in
   the Lothian Birth Cohort 1936},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JUL 18},
Abstract = {Although plasma proteins may serve as markers of neurological disease
   risk, the molecular mechanisms responsible for inter-individual
   variation in plasma protein levels are poorly understood. Therefore, we
   conduct genome- and epigenome-wide association studies on the levels of
   92 neurological proteins to identify genetic and epigenetic loci
   associated with their plasma concentrations (n = 750 healthy older
   adults). We identify 41 independent genome-wide significant (P < 5.4 x
   10(-10)) loci for 33 proteins and 26 epigenome-wide significant (P < 3.9
   x 10(-10)) sites associated with the levels of 9 proteins. Using this
   information, we identify biological pathways in which putative
   neurological biomarkers are implicated (neurological, immunological and
   extracellular matrix metabolic pathways). We also observe causal
   relationships (by Mendelian randomisation analysis) between changes in
   gene expression (DRAXIN, MDGA1 and KYNU), or DNA methylation profiles
   (MATN3, MDGA1 and NEP), and altered plasma protein levels. Together,
   this may help inform causal relationships between biomarkers and
   neurological diseases.},
