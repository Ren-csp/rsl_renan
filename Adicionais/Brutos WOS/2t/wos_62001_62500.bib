@article{ WOS:000333908500011,
Author = {Tomlinson, Sean and Mathialagan, Priya D. and Maloney, Shane K.},
Title = {Special K: testing the potassium link between radioactive rubidium
   (86Rb) turnover and metabolic rate},
Journal = {JOURNAL OF EXPERIMENTAL BIOLOGY},
Year = {2014},
Volume = {217},
Number = {7},
Pages = {1040-1045},
Month = {APR},
Abstract = {The measurement of Rb-86 turnover recently has been suggested as a
   useful method for measuring field metabolic rate in small animals. We
   investigated a proposed mechanism of Rb-86 turnover, its analogy to K+,
   by comparing the turnover of Rb-86 in a model insect, the rhinoceros
   beetle Xylotrupes gideon, fed a diet of plum jam or plum jam enriched
   with K+ or Rb+. The turnover of Rb-86 in the beetles on the K+ and the
   Rb+ diets was higher than that for beetles on the jam diet
   (F-2,F-311=32.4; P=1.58x10(-13)). We also exposed the beetles to
   different ambient temperatures to induce differences in metabolic rate
   (V-CO2) while feeding them the jam and K+ diets. V-CO2 was higher at
   higher ambient temperature (T-a) for both jam (F-1,F-11=14.56; P=0.003)
   and K+ (F-1,F-8=15.39; P=0.004) dietary groups, and the turnover of
   Rb-86 was higher at higher T-a for both jam (F-1,F-11=10.80; P=0.007)
   and K+ (F-1,F-8=12.34; P=0.008) dietary groups. There was a significant
   relationship between Rb-86 turnover and V-CO2 for both the jam
   (F-1,F-11=35.00; P=1.0x10(-3)) and the K+ (F-1,F-8=64.33; P=4.3x10(-5))
   diets, but the relationship differed between the diets (F1,19=14.07;
   P=0.001), with a higher Rb-86 turnover in beetles on the K+-enriched
   than on the jam diet at all T-a. We conclude that Rb-86 turnover is
   related to K+ metabolism, and that this is the mechanism of the
   relationship between Rb-86 turnover and V-CO2. Studies relating Rb-86
   turnover to V-CO2 should maintain dietary {[}K+] as close as possible to
   that of natural diets for the most accurate calibrations for
   free-ranging animals.},
