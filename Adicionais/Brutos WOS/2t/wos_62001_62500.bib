Author = {Wang, Rong and Long, Tao and Hassan, Abdirahman and Wang, Jin and Sun,
   Yingyuan and Xie, Xiao-Song and Li, Xiaochun},
Title = {Cryo-EM structures of intact V-ATPase from bovine brain},
Journal = {NATURE COMMUNICATIONS},
