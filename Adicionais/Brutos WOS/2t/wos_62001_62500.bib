@article{ WOS:001492295900011,
Author = {Ito, Jumpei and Strange, Adam and Liu, Wei and Joas, Gustav and Lytras,
   Spyros and Sato, Kei and Genotype Phenotype Japan G2P Japan Consortium},
Title = {A protein language model for exploring viral fitness landscapes},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {MAY 13},
Abstract = {Successively emerging SARS-CoV-2 variants lead to repeated epidemic
   surges through escalated fitness (i.e., relative effective reproduction
   number between variants). Modeling the genotype-fitness relationship
   enables us to pinpoint the mutations boosting viral fitness and flag
   high-risk variants immediately after their detection. Here, we present
   CoVFit, a protein language model adapted from ESM-2, designed to predict
   variant fitness based solely on spike protein sequences. CoVFit was
   trained on genotype-fitness data derived from viral genome surveillance
   and functional mutation assays related to immune evasion. CoVFit
   successively ranked the fitness of unknown future variants harboring
   nearly 15 mutations with informative accuracy. CoVFit identified 959
   fitness elevation events throughout SARS-CoV-2 evolution until late
   2023. Furthermore, we show that CoVFit is applicable for predicting
   viral evolution through single amino acid mutations. Our study gives
   insight into the SARS-CoV-2 fitness landscape and provides a tool for
   efficiently identifying SARS-CoV-2 variants with higher epidemic risk.},
