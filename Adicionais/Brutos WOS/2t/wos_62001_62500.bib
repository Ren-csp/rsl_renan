@article{ WOS:000368908700011,
Author = {Wu, Minchao and Knorr, Wolfgang and Thonicke, Kirsten and Schurgers, Guy
   and Camia, Andrea and Arneth, Almut},
Title = {Sensitivity of burned area in Europe to climate change, atmospheric
   CO2 levels, and demography: A comparison of two
   fire-vegetation models},
