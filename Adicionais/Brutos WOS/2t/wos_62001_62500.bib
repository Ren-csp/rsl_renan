Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Rosa, ME (Corresponding Author), Univ Vet Med Budapest, Dept Ecol, Budapest, Hungary.
