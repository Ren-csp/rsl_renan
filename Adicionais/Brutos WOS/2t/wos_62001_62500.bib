@article{ WOS:001190084300015,
Author = {Matsubayashi, Hideaki T. and Mountain, Jack and Takahashi, Nozomi and
   Deb Roy, Abhijit and Yao, Tony and Peterson, Amy F. and Gonzalez,
   Cristian Saez and Kawamata, Ibuki and Inoue, Takanari},
Title = {Non-catalytic role of phosphoinositide 3-kinase in mesenchymal cell
