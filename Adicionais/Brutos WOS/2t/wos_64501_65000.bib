Title = {Trachymyrmex septentrionalis ants promote fungus garden hygiene using
   Trichoderma-derived metabolite cues},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2023},
Volume = {120},
