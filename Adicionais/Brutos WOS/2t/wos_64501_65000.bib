@article{ WOS:000355528200001,
Author = {Hwang, SuJin and Palin, Amy C. and Li, LiQi and Song, Ki-Duk and Lee,
   Jan and Herz, Jasmin and Tubo, Noah and Chu, Hamlet and Pepper, Marion
   and Lesourne, Renaud and Zvezdova, Ekaterina and Pinkhasov, Julia and
   Jenkins, Marc K. and McGavern, Dorian and Love, Paul E.},
Title = {TCR ITAM multiplicity is required for the generation of follicular
   helper T-cells},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {MAY},
Abstract = {The T-cell antigen receptor (TCR) complex contains 10 copies of a
   di-tyrosine Immunoreceptor-Tyrosine-based-Activation-Motif (ITAM) that
   initiates TCR signalling by recruiting protein tyrosine kinases. ITAM
   multiplicity amplifies TCR signals, but the importance of this
   capability for T-cell responses remains undefined. Most TCR ITAMs (6 of
   10) are contributed by the CD3z subunits. We generated `knock-in' mice
   that express non-signalling CD3z chains in lieu of wild-type CD3z. Here
   we demonstrate that ITAM multiplicity is important for the development
   of innate-like T-cells and follicular helper T-cells, events that are
   known to require strong/sustained TCR-ligand interactions, but is not
   essential for `general' T-cell responses including proliferation and
   cytokine production or for the generation of a diverse antigen-reactive
   TCR repertoire.},
