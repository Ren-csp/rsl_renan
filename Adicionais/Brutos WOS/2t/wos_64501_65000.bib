@article{ WOS:000902649000001,
Author = {Liu, Peng and Lang, Panpan and Lu, Ailing and Li, Yanling and Li, Xueqin
   and Sun, Tanglei and Yang, Yantao and Li, Hui and Lei, Tingzhou},
Title = {Effect of Evolution of Carbon Structure during Torrefaction in Woody
   Biomass on Thermal Degradation},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {24},
Month = {DEC},
Abstract = {Torrefaction is an effective method for upgrading biomass. Cedar
   torrefaction is carried out in a fixed bed reactor at the temperature of
   200-300 degrees C. The structural parameters are obtained from elemental
   analysis and C-13 nuclear magnetic resonance (NMR). Thermal degradation
   behavior of raw and torrefied cedar is monitored by thermogravimetry
   analysis. The results show that carbon structure varied during
   torrefaction has a significant effect on thermal degradation of cedar.
   Some unstable oxygen functional groups, such as C1 of hemicellulose,
   beta-O-4 linked bonds, and amorphous C6 of cellulose, are decomposed at
   mild torrefaction of torrefied temperature <= 200 degrees C. The
   temperature of maximum weight loss rate increases from 348 degrees C of
   raw cedar to 373 degrees C of C-200. The amorphous cellulose is partly
   re-crystallized at moderate torrefaction of torrefied temperature
   200-250 degrees C. The aromaticity of torrefied cedar increases from
   0.45 of C-200 to 0.73 of C-250. The covalent bond in the side chain of
   aromatic rings in cedar was further broken during torrefaction at severe
   torrefaction of torrefied temperature 250-300 degrees C. The area
   percentage of DTG mainly signed at 387 degrees C of C-300. The proton
   aromatic carbon increases from 12.35\% of C-250 to 21.69\% of C-300.
   These results will further facilitate the utilization of biomass for
   replacing fossil fuel to drive carbon neutrality.},
