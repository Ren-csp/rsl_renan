@article{ WOS:001863309100001,
Author = {Nunez, Felipe and Elias, Carlos},
Title = {Climate Change Literature Within the Field of Communication in the
   Disinformation Era: A Comprehensive Analysis of Thirty Years of Progress},
Journal = {REVIEW OF COMMUNICATION RESEARCH},
Year = {2026},
Volume = {14},
Pages = {180-197},
Abstract = {Interest in climate communication has increased significantly in recent
   decades. Despite the existence of various reviews on this topic, there
   is still no work that focuses exclusively on the field of communication
   studies. Therefore, this article aims to explore how communication
   research has addressed climate change. Through a systematic review of
   the literature in communication journals indexed in Scopus and Web of
   Science (N = 1621), this study offers an understanding of the evolution
   of publications and scientific activity in this area. On the one hand,
   the main journals, authors and literature are analysed through a
   bibliometric analysis, and a critical synthesis of the most relevant
   findings is presented. On the other hand, the conceptual structure of
   the field is investigated using a temporal analysis of keywords and a
   thematic analysis through the Bibliometrix package. The results indicate
   that the field is fundamentally quantitative, with a focus on Western
   countries and a predominance of framing theory as a central theme.
   However, the thematic analysis also reveals an uneven development, as
   while framing dominates as a motor theme, phenomena such as
   misinformation are still emerging and topics such as selective exposure
   and public perception remain isolated from the field's central debates.
   These gaps suggest directions for future research.},
