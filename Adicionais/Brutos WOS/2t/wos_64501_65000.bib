@article{ WOS:000320283400039,
Author = {Whorton, Matthew R. and MacKinnon, Roderick},
Title = {X-ray structure of the mammalian GIRK2-βγ G-protein complex},
Journal = {NATURE},
Year = {2013},
Volume = {498},
Number = {7453},
