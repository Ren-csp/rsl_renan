@article{ WOS:001741120900001,
Author = {Beasley, Julie A. and Fernandez, Sergio},
Title = {Exploring the contrasting influence of diversity in social and
   work-related attributes: a panel study of U.S. Federal agencies},
Journal = {ASIA PACIFIC JOURNAL OF PUBLIC ADMINISTRATION},
Year = {2026},
Month = {2026 APR 14},
Abstract = {Researchers have explored contextual factors shaping the relationship
   between diversity and organisational outcomes to better understand how
   diversity affects public organisations. One factor that has not been
   adequately explored is the type of attribute in regard to which public
   organisations are diverse. Employees react to and process information
   about diversity in surface-level social attributes like gender and race
   differently than they do to signs of diversity in deeper-level
   work-related attributes like education and occupation, as the former
   type of diversity is associated with social categorisation and the
   latter with information elaboration. Analysis of an eight-year panel of
   the U.S. federal agencies reveals that diversity in occupation, a
   work-related attribute, is more likely to foster positive interactions
   between employees and improve job satisfaction and perceptions of
   performance than diversity in social attributes like race, gender, and
   age. The findings, which are consistent with the social categorisation
   and information/decision-making perspectives on diversity, suggest the
   effects of diversity are conditional on the type of attribute that sets
   employees apart.},
