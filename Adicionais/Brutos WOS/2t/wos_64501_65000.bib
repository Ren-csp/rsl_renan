@article{ WOS:001487759900001,
Author = {Gallego-Cartagena, Euler and Morgado-Gamero, Wendy and de
   Moya-Hernandez, Iuleder and Diaz-Uribe, Carlos and Parody, Alexander and
   Morillas, Hector and Bayona-Pacheco, Brayan and Pellegrin, Gabrielle and
