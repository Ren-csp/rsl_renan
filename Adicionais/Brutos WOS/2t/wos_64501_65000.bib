@article{ WOS:000281203600043,
Author = {Mariappan, Malaiyalam and Li, Xingzhe and Stefanovic, Sandra and Sharma,
   Ajay and Mateja, Agnieszka and Keenan, Robert J. and Hegde, Ramanujan S.},
Title = {A ribosome-associating factor chaperones tail-anchored membrane proteins},
