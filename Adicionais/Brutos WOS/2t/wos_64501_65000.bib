@article{ WOS:000223514900049,
Author = {Dormitzer, PR and Nason, EB and Prasad, BVV and Harrison, SC},
Title = {Structural rearrangements in the membrane penetration protein of a
   non-enveloped virus},
Journal = {NATURE},
