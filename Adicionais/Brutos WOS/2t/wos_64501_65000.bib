@article{ WOS:001501594900019,
Author = {Romero, July Carolina and Tonapi, Sonal S. and Parihar, Manish and
   Loranc, Eva and Miller, Henry E. and Lawrence, Liesl A. and Bassani,
   Nicklas and Robledo, Daniel G. and Cao, Lin and Nie, Jia and Kanda,
   Kairi and Stoja, Aiola and Garcia, Natalia and Gorthi, Aparna and
   Stoveken, Brian J. and Fan, Teresa W-M and Cassel, Teresa A. and Zha,
   Shan and Lechleiter, James D. and Musi, Nicolas and Dong, Lily Q. and
   Lane, Andrew N. and Bishop, Alexander J. R.},
Title = {Loss of CD98HC phosphorylation by ATM impairs antiporter trafficking and
   drives glutamate toxicity in Ataxia telangiectasia},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUN 2},
Abstract = {Ataxia-telangiectasia is a rare genetic disorder characterized by
   neurological defects, immunodeficiency, cancer predisposition,
   radiosensitivity, decreased blood vessel integrity, and diabetes. ATM,
   the protein mutated in Ataxia-telangiectasia, responds to DNA damage and
   oxidative stress, but its functional relationship to the progressive
   clinical manifestation of this disorder is not understood. CD98HC
   chaperones cystine/glutamate and cationic/neutral amino acid antiporters
   to the cell membrane, and CD98HC phosphorylation by ATM accelerates
   membrane localization to acutely increase amino acid transport. Loss of
   ATM impacts tissues reliant on heterodimeric amino acid transporters
   relevant to Ataxia-telangiectasia phenotypes, such as endothelial cells
   (telangiectasia) and pancreatic alpha-cells (fatty liver and diabetes),
   with toxic glutamate accumulation. Bypassing the antiporters restores
   intracellular metabolic balance in ATM-deficient cells and mouse models.
   These findings provide insight into the long-known benefits of N-acetyl
   cysteine in Ataxia-telangiectasia cells beyond oxidative stress through
   removing glutamate excess by producing glutathione.},
