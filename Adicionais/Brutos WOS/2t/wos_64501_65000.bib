Title = {Echoes of ancient introgression punctuate stable genomic lineages in the
   evolution of figs},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2023},
