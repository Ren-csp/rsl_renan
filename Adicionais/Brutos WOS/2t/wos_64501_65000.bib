@article{ WOS:001759666800001,
Author = {Monchanin, Coline and Gomez-Moracho, Tamara and Pasquaretta, Cristian
   and Buatois, Alexis and Bestea, Louise and Marchal, Paul and Losel,
   Philipp D. and Lebrun, Renaud and Lihoreau, Fabrice and Barron, Andrew
   B. and Devaud, Jean-Marc and Lihoreau, Mathieu},
Title = {When a bigger brain is better: The case of bee olfactory learning},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2026},
Volume = {123},
Number = {17},
Month = {APR 28},
Abstract = {Whether bigger brains provide enhanced cognitive capacities is a
   long-lasting and controversial question. While big brains may not be
   required for producing sophisticated behavior, they could facilitate
   information processing and memory storage. Here, we report a positive
   relationship between head size and learning performance in two model bee
   species, using data from 2,141 individuals. Among honey bees, head size
   varied by about 30\%, and those with larger heads showed higher
   olfactory learning performance for associative tasks that varied in
   difficulty. Microcomputed tomography measures indicated that this
   relationship was linked to brain size variation: The best odor learners
   had the largest antennal lobes. We made similar observations in
   bumblebees, suggesting that natural brain size variation is associated
   with individual cognitive variation in these social bees.},
