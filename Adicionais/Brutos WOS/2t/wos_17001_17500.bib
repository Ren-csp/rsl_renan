@article{ WOS:001246948100014,
Author = {Duan, Mengxiao and Wu, Yue and Jiang, Haitao and Fan, Wenbin},
Title = {ECOLOGICAL SECURITY PERCEPTIONS AND TOURISM DEVELOPMENT ATTITUDES: A
   CASE STUDY OF XILAMUREN GRASSLAND RESIDENTS},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
Year = {2024},
Volume = {23},
Number = {4},
Month = {APR},
Abstract = {As crucial stakeholders in eco-tourism, community residents' perceptions
   of ecological tourism security directly impact attitudes towards its
   development. Sustainable tourism entails safeguarding the natural,
   social, and economic ecosystems destinations. This study analyzed how
   residents' perceptions of ecological security at the Xilamuren Grassland
   site influence outlook on grassland eco-tourism. Based on survey data
   capturing perceptual dimensions and satisfaction levels, multiple
   regression modeling was conducted. Key findings were: (1) Overall
   ecological security perception among locals is currently subpar,
   uncertainties persisting around aspects like guarantee systems,
   infrastructure, public culture, and economics; (2) Despite low tourism
   satisfaction, residents maintain a supportive stance regarding
   prospective development; (3) Significant correlations between security
   perceptions and tourism attitudes. While perception levels positively
   predict optimism, public safety views not. By identifying specific areas
   of concern amongst residents that dampen their participation, targeted
   interventions by authorities could mitigate adverse impacts and promote
   broader engagement in sustainable grassland eco-tourism.},
