   Li, Huibao; Zou, Guangtian, Minist Ind \& Informat Technol, Harbin Inst Technol, Sch Architecture \& Design, Key Lab Cold Reg Urban \& Rural Human Settlement En, Harbin, Peoples R China.},
DOI = {10.3389/fpsyg.2025.1567378},
