@article{ WOS:000086741000010,
Author = {Byers, AC},
Title = {Contemporary landscape change in the Huascaran National Park and buffer
   zone, Cordillera Blanca, Peru},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
