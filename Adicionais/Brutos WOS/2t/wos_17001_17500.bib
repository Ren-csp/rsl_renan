@article{ WOS:001672897600001,
Author = {Namba, Shinichi and Sonehara, Kyuto and Koyanagi, Yuriko N. and Kikuchi,
   Takezo and Ojima, Takafumi and Edahiro, Ryuya and Sato, Go and Yamaji,
