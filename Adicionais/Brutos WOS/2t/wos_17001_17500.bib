@article{ WOS:000577427200001,
Author = {Smith, Will},
Title = {Beyond Loving Nature: Affective Conservation and Human-pig Violence in
   the Philippines},
Journal = {ETHNOS},
Year = {2022},
Volume = {87},
Number = {5},
Pages = {874-892},
Month = {OCT 20},
Abstract = {Contemporary social theory has forcefully argued for a `loving'
   postenvironmentalism based on intimate care and making kin with the
   non-human world. These arguments are a central part of an influential
   and cross-disciplinary scholarly discourse, increasingly adopted by
   environmental anthropologists, that envisions a universal moral ecology
   of `care, love and kinship' as the solution to the near-apocalyptic
   social and environmental conditions of the Anthropocene. Drawing on
   ethnographic work in the Philippines, I explore how this narrowed
   affective repertoire maps awkwardly onto indigenous Pala'wan
   explanations of their relationship with the non-human world where
   reciprocity and respect are held in tension with fear, violence and
   death. I focus, in particular, on the Palawan bearded pig (Sus
   ahoenobarbus), an endemic species that has become an emblematic
   conservation species while also being extensively hunted by indigenous
   peoples across the Island.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
