@article{ WOS:001837561000001,
Author = {Broome, James David and Cook, David and Davidsdottir, Brynhildur and
   Hennig, Benjamin David},
Title = {Shining light on the aurora's contributions to people: A qualitative
   study of the aurora borealis in Greenland},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Month = {2026 JUL 31},
Abstract = {The aurora borealis (northern lights) is an abiotic natural phenomenon
   that contributes to human well-being. There is currently a significant
   research gap in primary qualitative valuation of the aurora's links to
   people. This exploratory qualitative study applies the Intergovernmental
   Platform on Biodiversity and Ecosystem Services (IPBES) framework in a
   novel context to study interactions between people and the aurora in
   Greenland. The main aims of the study are to: (1) identify nature's
   contribution to people (NCP) in Greenland from the aurora and (2)
   explore how local stakeholders can enhance management of NCP from the
   aurora. Drawing on 28 semi-structured interviews conducted primarily in
   Ilulissat, Kulusuk and Tasiilaq, the aurora is found to provide benefits
   to people in a variety of ways. Benefits from the aurora span five NCP
   categories, including: energy, learning and inspiration, physical and
   psychological experiences, supporting identities and maintenance of
   options. The majority of benefits were non-material in nature, although
   material benefits in the forms of tourism revenue and energy were also
   mentioned. Practical considerations are explored for the localities of
   Ilulissat in western Greenland and the Ammassalik region (Tasiilaq \&
   Kulusuk) in eastern Greenland. These study sites vary in their social,
   economic and institutional profiles and demonstrate moderate
   heterogeneity in perceptions about co-production and potential avenues
   for the management of NCP from the aurora. Ilulissat demonstrates a
   broad spectrum of potential for institutional co-production, where there
   are considerable anthropogenic assets for underpinning NCP from the
   aurora. In contrast, Tasiilaq and Kulusuk demonstrate more purely
   relational values, where tourism-related benefits are currently less
   developed. The information about aurora benefits and the role of
   co-production elicited in this study can serve to support and inform
   decision-making related to cultural heritage facilities, educational
   initiatives and tourism infrastructure pertaining to the aurora.
   Reflections about the usefulness of the IPBES framework in an abiotic
   context are discussed, and opportunities for future research are
   outlined.},
