ISSN = {1708-3087},
Keywords = {adaptation; bounded rationality; collective action; complex adaptive
   systems; feedback; fisheries management; information costs; inheritance;
   learning; overfishing; parametric rules; place-based behavior;
   rule-based behavior; self-organization; sustainability; uncertainty},
Keywords-Plus = {COD GADUS-MORHUA; ECOLOGICAL-SYSTEMS; COLLECTIVE ACTION; SPATIAL
   DYNAMICS; FISHERIES; FISH; GULF; POPULATIONS; PERSPECTIVE; CHALLENGES},
