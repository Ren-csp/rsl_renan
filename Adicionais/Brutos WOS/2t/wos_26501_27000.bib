@article{ WOS:001616863200002,
Author = {Huang, Yuyue and Yang, Junyan and Zhang, Xun and Chen, Daijun and Zhang,
   Zhihan and Chen, Xuyang},
Title = {Intelligent optimization of building complex layouts under
   multi-constraint conditions: A multi-agent modeling approach},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {131},
Month = {SEP 1},
Abstract = {The increasing incongruity between land resources and high-quality
   sustainable development has resulted in elevated expectations for the
   configuration of building complexes, particularly within high-density
   urban. These demands are further challenged by economic ecological, and
   social constraints. Optimizing building layouts has proven to enhance
   spatial, environmental, and functional performance, making it a viable
   strategy to address urban sustainability challenges. However, current
   methods often fall short in managing dynamic, multi-objective trade-offs
   under complex constraints. The present study proposes a methodology for
   optimizing the layout of building complexes. This methodology is based
   on a multi-agent model that balances economic, ecological and social
   constraints. The approach involves intelligent clustering of potential
   optimized building agents, a comprehensive multi-constraint framework,
   and the integration of Reinforcement Learning (RL) with the
   Non-Dominated Sorting Genetic Algorithm III (NSGA-III). This enables
   dynamic, adaptive optimization and supports decision-making in complex
   urban environments. A case study validates the model's effectiveness.
   The optimization of selected buildings led to a 31.58\% increase in
   Space Utilization (SU), a 125.21\% rise in Floor Area Ratio (FAR), and a
   35.54\% improvement in the Commercial Frontage Index (CFI).
   Concurrently, the Height Variation Index (HVI) exhibited a substantial
   increase of 131.63\%, while the Build-to-Line Ratio (BLR) experienced an
   augmentation of 10.39\%. These developments ensure that the Green Space
   Ratio (GSR) remains above 0.64, thereby attaining a balanced promotion
   of economic, ecological, and social benefits. This research has the
   potential to facilitate the optimization of the layout of building
   complexes in high-density cities. The optimization process is dynamic
   and quantitative, and is capable of accommodating multiple constraints.
   Furthermore, the research has the capacity to promote urban renewal with
   growth, and to provide a new and feasible path for optimizing the layout
   of building complexes.},
