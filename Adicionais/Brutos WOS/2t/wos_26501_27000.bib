@article{ WOS:000321766900024,
Author = {Ware, Desirae and Lewis, Johnnye and Hopkins, Scarlett and Boyer, Bert
   and Noonan, Curtis and Ward, Tony},
Title = {Sources and Perceptions of Indoor and Ambient Air Pollution in Rural
   Alaska},
Journal = {JOURNAL OF COMMUNITY HEALTH},
