@article{ WOS:000257010300005,
Author = {West, C. T. and Roncoli, C. and Ouattara, F.},
Title = {Local perceptions and regional climate trends on the central plateau of
   Burkina Faso},
Journal = {LAND DEGRADATION \& DEVELOPMENT},
Year = {2008},
Volume = {19},
