Volume = {16},
Number = {2},
Pages = {199-204},
Abstract = {The International Workshop for African Archaeobotany (IWAA) is addressed
   to scholars working in the field of relationships between plants and
   humans in Africa. The 10th IWAA was organised in Paris from 27th to 30th
   June 2023 and hosted at the National Museum for Natural History (Museum
   National d'Histoire Naturelle). The 10th IWAA gathered 74 participants
   from 18 countries. It included contributions relating to human-plant
   interactions that dealt with seed and charcoal macroremains, wood,
   phytoliths, pollen, non-pollen palynomorphs analyses, as well as genomic
   and ethnobotanical studies.},
