@article{ WOS:000617480400007,
Author = {Vasenev, Viacheslav I. and Slukovskaya, Marina V. and Cheng, Zhongqi and
   Paltseva, Anna A. and Nehls, Thomas and Korneykova, Maria V. and
   Vasenev, Ivan I. and Romzaykina, Olga N. and Ivashchenko, Kristina V.
   and Sarzhanov, Dmitry A. and Sotnikova, Yulia L. and Ryzhkov, Oleg V.
   and Alaeva, Lilia A. and Belik, Anton V. and Devyatova, Tatiana A. and
   Gorbov, Sergey N. and Bezuglova, Olga S. and Dolgikh, Andrey. V. and
   Konstantinov, Pavel I. and Konstantinova, Anastasia V. and Yaroslavtsev,
   Alexey M. and Chernyshova, Marina S. and Morin, Tatiana and Ryazanov,
   Alexey V. and Gosse, Dmitry D. and Dovletyarova, Elvira A.},
Title = {Anthropogenic soils and landscapes of European Russia: Summer school
   from sea to sea-A didactic prototype},
Journal = {JOURNAL OF ENVIRONMENTAL QUALITY},
Year = {2021},
Volume = {50},
Number = {1},
Pages = {63-77},
Month = {JAN},
Note = {10th Conference of the Working Group (WG) on Soils of Urban, Industrial,
   Traffic, Mining and Military Areas (SUITMA), Seoul, SOUTH KOREA, JUN
   16-21, 2019},
Abstract = {Field excursions and trainings are considered a key component of
   education programs in soil and environmental sciences. They allow
   mastering students' practical skills in sampling and onsite assessments
   and improve understanding of ecosystem integrity and complexity.
   Urbanization has a substantial impact on soil properties and functions;
   however, field courses focused on urban soils are rare. We present a
   didactic prototype and the outcomes of the ``Monitoring, Modeling, and
   Management of Urban Green Infrastructure and Soils (3MUGIS){''} summer
   school-the first educational tour observing anthropogenic soils and
   landscapes along the bioclimatic gradient in European Russia, from
   tundra to dry steppes. Didactic learning was based on a
   studying-by-doing approach; students were involved in environmental
   assessment in multiple regions varying in climatic and socioeconomic
   features. Considering the high spatial heterogeneity of urban
   ecosystems, we used express techniques (portable X-ray fluorescence,
   infrared gas analyzers) for onsite soil analysis at multiple replicas.
   The data collected were discussed with local and international experts
   from Russia, Germany, the United States, and France in the context of
   regional environmental problems (e.g., pollution, soil degradation, and
   urban expansion). Students discovered zonal changes in vegetation (e.g.,
   increasing tree height and diversity from north taiga to forest steppes)
   and soil properties (e.g., a gradual increase in pH and changes in soil
   organic C), as well as urban-specific processes and features (e.g.,
   urban heat island effect or soil artifacts). The overall student
   feedback was very positive (50.8\% excellent, 36\% good); some specific
   organizational issues will be addressed for future 3MUGIS summer
   schools.},
