@article{ WOS:001343464900013,
Author = {Lopez-Alfaro, Nelly and Gutierrez-Hernandez, Anayudel and Drevins-Sandi,
   Amina},
Title = {Environmental governance, water, sanitation, and solid waste: what do
   Costa Ricans think about these?},
