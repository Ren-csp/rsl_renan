@article{ WOS:000554831500024,
Author = {Grubert, Fabian and Srivas, Rohith and Spacek, V, Damek and Kasowski,
   Maya and Ruiz-Velasco, Mariana and Sinnott-Armstrong, Nasa and
   Greenside, Peyton and Narasimha, Anil and Liu, Qing and Geller, Benjamin
   and Sanghi, Akshay and Kulik, Michael and Sa, Silin and Rabinovitch,
   Marlene and Kundaje, Anshul and Dalton, Stephen and Zaugg, Judith B. and
   Snyder, Michael},
Title = {Landscape of cohesin-mediated chromatin loops in the human genome},
Journal = {NATURE},
Year = {2020},
Volume = {583},
Number = {7818},
Pages = {737+},
Month = {JUL 30},
Abstract = {Physical interactions between distal regulatory elements have a key role
   in regulating gene expression, but the extent to which these
   interactions vary between cell types and contribute to
   cell-type-specific gene expression remains unclear. Here, to address
   these questions as part of phase III of the Encyclopedia of DNA Elements
   (ENCODE), we mapped cohesin-mediated chromatin loops, using chromatin
   interaction analysis by paired-end tag sequencing (ChIA-PET), and
   analysed gene expression in 24 diverse human cell types, including core
   ENCODE cell lines. Twenty-eight per cent of all chromatin loops vary
   across cell types; these variations modestly correlate with changes in
   gene expression and are effective at grouping cell types according to
   their tissue of origin. The connectivity of genes corresponds to
   different functional classes, with housekeeping genes having few
   contacts, and dosage-sensitive genes being more connected to enhancer
   elements. This atlas of chromatin loops complements the diverse maps of
   regulatory architecture that comprise the ENCODE Encyclopedia, and will
   help to support emerging analyses of genome structure and function.
   A map of cohesin-mediated chromatin loops in 24 types of human cells
   identifies loops that show cell-type-specific variation, indicating that
   chromatin loops may help to specify cell-specific gene expression
   programs and functions.},
