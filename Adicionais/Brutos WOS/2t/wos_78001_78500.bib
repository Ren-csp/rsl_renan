@article{ WOS:001831970500001,
Author = {Stratton, Andrew David Harold and Baralla, Silvia and Giurca, Alexandru
   and Frasson, Dalila and Matthiesen, Lasse Limbo and Ostoic, Silvija
   Krajter and Rasi, Rastislav and Schmidt, Jan and Vuletic, Dijana and
   Weiss, Gerhard and Zivojinovic, Ivana and Strange, Niels and Jacobsen,
   Jette Bredahl},
Title = {Exploring preferences of forest ecosystem services across the EU:
   Personal and societal perspectives},
Journal = {ECOSYSTEM SERVICES},
Year = {2026},
Volume = {81},
Month = {OCT},
Abstract = {This study presents findings from a survey conducted in the EU-27 to
   elicit public preferences for 19 forest ecosystem services (FES). We
   draw upon social choice theory to frame the importance of FES in the
   context of personal well-being and subjective social welfare. We
   hypothesize that distinguishing between these two preference orderings
   might lead to significant differences in importance scores and, as such,
   a potential under- or overvaluation of a given FES. We also test whether
   there are significant differences between temporal framings for societal
   importance. To this end, respondents were asked to evaluate the
   importance of each FES to themselves personally, to society currently,
   and to society in the future. Our results indicate significant
   differences between the personal and societal importance of FES within
   many countries. Provisioning services are rated as more important for
   society than for individuals personally across most countries, with the
   exception of food from wild plants and mushrooms. For regulating and
   cultural FES, there is no clear pattern in whether personal or societal
   importance is rated significantly higher. For differences between
   temporal framings, many countries find FES significantly more important
   to society in the future. We conclude by urging researchers and
   decision-makers to consider both personal and societal importance to
   more accurately capture these nuances.},
