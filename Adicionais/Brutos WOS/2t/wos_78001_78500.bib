@article{ WOS:000882946900035,
Author = {Zoboli, Fabio and Dos Santos, Matheus Souza and Correia, Elder Silva},
Title = {ART AS A PEDAGOGICAL POWER THROUGH MUSIC: FLAMENCO CAN ALSO BE SUNG},
Journal = {REVISTA IBERO-AMERICANA DE ESTUDOS EM EDUCACAO},
Year = {2022},
Volume = {17},
Number = {3},
Pages = {2043-2061},
Month = {JUL-SEP},
Abstract = {This text proposes an approximation between sport (Soccer/Flamengo) and
   art (Music). This approach is made with the intention of moving soccer
   from the status of technical gestures and rules to the field of art
   through music. The purpose of the writing is to present music as a
   cultural artifact of art as an educational power. To this end, we
   catalogued and organized the songs that deal with Flamengo based on
   thematic axes in order to educate them to address topics related to the
   ``outfield of soccer{''} in the context of school Physical Education
   classes. This was a qualitative research addressed under the bias of an
   exploratory study. It is concluded that the pedagogical power of music
   in its relationship with soccer lies in the way in which, based on its
   affections and perceptions, it allows an exploration of the conditions
   of soccer practice, opening new possibilities to experience it and new
   ways of thinking about it beyond its uses and social destinations.},
