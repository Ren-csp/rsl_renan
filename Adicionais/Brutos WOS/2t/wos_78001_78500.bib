@article{ WOS:000397122900013,
Author = {Beglarzadeh, Babak},
Title = {An experimental and numerical study of forming parameters affection on
   multi-point deep drawing process},
Journal = {INTERNATIONAL JOURNAL OF ADVANCED AND APPLIED SCIENCES},
Year = {2017},
Volume = {4},
Number = {1},
Pages = {90-95},
Month = {JAN},
Abstract = {Multi-point forming is a modern flexible manufacturing technology, which
   has been used in many industries successfully. In order to provide a
   flexible method for forming a metal, multi-point forming is used to form
   aluminum alloy 2024 with an initial size of 300 x 300 mm sheet. Finite
   elements were simulated through ABAQUS/EXPLICIT 6.14.1. Through,
   increasing of elastic layer hardness, the minimum required a thickness
