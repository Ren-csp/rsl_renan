@article{ WOS:000496920900003,
Author = {Toth, Gergely and Neumann, Thomas and Berthet, Amandine and Masliah,
   Eliezer and Spencer, Brian and Tao, Jiahui and Jobling, Michael F. and
   Gardai, Shyra J. and Bertoncini, Carlos W. and Cremades, Nunilo and
   Bova, Michael and Ballaron, Stephen and Chen, Xiao-Hua and Mao, Wenxian
   and Phuong Nguyen and Tabios, Mariano C. and Tambe, Mitali A. and
   Rochet, Jean-Christophe and Junker, Hans-Dieter and Schwizer, Daniel and
   Sekul, Renate and Ott, Inge and Anderson, John P. and Szoke, Balazs and
   Hoffman, Wherly and Christodoulou, John and Yednock, Ted and Agard,
   David A. and Schenk, Dale and McConlogue, Lisa},
Title = {Novel Small Molecules Targeting the Intrinsically Disordered Structural
   Ensemble of α-Synuclein Protect Against Diverse α-Synuclein Mediated
   Dysfunctions},
Journal = {SCIENTIFIC REPORTS},
Year = {2019},
Volume = {9},
Month = {NOV 18},
Abstract = {The over-expression and aggregation of alpha-synuclein (alpha Syn) are
   linked to the onset and pathology of Parkinson's disease. Native
   monomeric alpha Syn exists in an intrinsically disordered ensemble of
   interconverting conformations, which has made its therapeutic targeting
   by small molecules highly challenging. Nonetheless, here we successfully
   target the monomeric structural ensemble of alpha Syn and thereby
   identify novel drug-like small molecules that impact multiple pathogenic
   processes. Using a surface plasmon resonance high-throughput screen, in
   which monomeric alpha Syn is incubated with microchips arrayed with
   tethered compounds, we identified novel alpha Syn interacting drug-like
   compounds. Because these small molecules could impact a variety of alpha
   Syn forms present in the ensemble, we tested representative hits for
   impact on multiple alpha Syn malfunctions in vitro and in cells
   including aggregation and perturbation of vesicular dynamics. We thereby
   identified a compound that inhibits alpha Syn misfolding and is
   neuroprotective, multiple compounds that restore phagocytosis},
