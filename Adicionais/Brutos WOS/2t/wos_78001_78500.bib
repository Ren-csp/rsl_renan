   Pavicic, M.; Mouhu, K.; Himanen, K., Univ Helsinki, Fac Biol \& Environm Sci, Natl Plant Phenotyping Infrastruct, Helsinki, Finland.},
DOI = {10.1007/s11240-019-01700-9},
ISSN = {0167-6857},
EISSN = {1573-5044},
Keywords = {Seed germination; ABA; Plant phenotyping; Chlorophyll fluorescence;
   Arabidopsis; In vitro; RING-type ubiquitin E3 ligases},
