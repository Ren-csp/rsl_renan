@article{ WOS:000442562800005,
Author = {Agyapong, Frances and Ojo, Thomas Kolawole},
Title = {Managing traffic congestion in the Accra Central Market, Ghana},
Journal = {JOURNAL OF URBAN MANAGEMENT},
