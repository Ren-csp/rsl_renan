@article{ WOS:000498842000248,
Author = {Prescott, Susan L. and Hancock, Trevor and Bland, Jeffrey and van den
   Bosch, Matilda and Jansson, Janet K. and Johnson, Christine C. and
   Kondo, Michelle and Katz, David and Kort, Remco and Kozyrskyj, Anita and
   Logan, Alan C. and Lowry, Christopher A. and Nanan, Ralph and Poland,
   Blake and Robinson, Jake and Schroeck, Nicholas and Sinkkonen, Aki and
