@article{ WOS:001587771600008,
Author = {Azmi, Nur Farah Atiqah and Azmi, Mohamad Nurul and Babai, Mahdi and
   Bakar, Mohamad Hafizi Abu and Abu Bakar, Muntaz and Omar, Mohammad
   Tasyriq Che},
Title = {Synthesis and Evaluation of Para-Substituted
   Bis(Arylidene)Cycloalkanones as Potential α-Amylase Inhibitor with
   Molecular Docking and ADMET Profiling},
Journal = {SAINS MALAYSIANA},
Year = {2025},
Volume = {54},
Number = {9},
Pages = {2201-2210},
Month = {SEP},
Abstract = {Tenpara-substituted bis(arylidene)cycloalkanone derivatives were
   synthesised, characterised and their inhibitory activities against human
   pancreatic alpha-amylase were evaluated. Among them, halogen-substituted
   derivatives 5d (IC50 = 7.6 f 1.4 mu M) and 5c (IC50 = 6.9 f 1.8 mu M)
   exhibited superior potency compared to the standard drug acarbose (IC50
   = 23.5 f 2.7 mu M). Molecular docking studies indicated that these
   halogenated derivatives (i.e., compound 5d and 5c) showed a good
   interaction with human pancreatic alpha-amylase protein (2QV4) with
   binding energy of-7.4 f 0.1 kcal/mol and-7.8 f 0.1 kcal/mol,
   respectively, compared with acarbose (-3.9 f 0.1 kcal/mol). Both of
   them, form crucial it-it stacking and hydrophobic interactions within
   the enzyme's active site residues TYR62 and LEU165. In silico ADMET
   profiling further supported the favourable drug-likeness, synthetic
   accessibility, and oral bioavailability of these compounds, making them
   promising candidates for antidiabetic drug development.},
