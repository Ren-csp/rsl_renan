EISSN = {2071-1050},
Keywords = {reservation scheduling; space-time network; ADMM algorithm},
Keywords-Plus = {CELL TRANSMISSION MODEL; CARSHARING SYSTEMS; AUTOMATED VEHICLES; MORNING
