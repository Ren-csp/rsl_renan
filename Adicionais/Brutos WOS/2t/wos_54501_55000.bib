   Kuperman, Victor, McMaster Univ, Dept Linguist \& Languages, Hamilton, ON L8S 4M2, Canada.
   Estes, Zachary, Bocconi Univ, Dept Mkt, I-20136 Milan, Italy.
   Brysbaert, Marc, Univ Ghent, Dept Expt Psychol, B-9000 Ghent, Belgium.
   Warriner, Amy Beth, McMaster Univ, Dept Psychol Neurosci \& Behav, Hamilton, ON L8S 4M2, Canada.},
DOI = {10.1037/a0035669},
ISSN = {0096-3445},
EISSN = {1939-2222},
Keywords = {arousal and valence; automatic vigilance; emotion; lexical decision and
   naming; word recognition},
Keywords-Plus = {ATTENTION-GRABBING POWER; AGE-OF-ACQUISITION; LEXICAL-DECISION;
