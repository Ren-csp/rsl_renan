@article{ WOS:001376827000002,
Author = {Chen, Xi and Wang, Hongming and Tan, Xi and Duan, Mingjun and Luo, Cheng},
Title = {Flight training and the anterior cingulate cortex},
Journal = {SCIENTIFIC REPORTS},
Year = {2024},
Volume = {14},
Number = {1},
Month = {DEC 2},
Abstract = {Pilots are considered the final line of defense for aviation safety.
   Before becoming a pilot, an ab initio pilot must undergo systematic
   flight training. This study included 25 male flying cadets. Kendall's
   coefficient of concordance was used to measure the regional homogeneity
   of the time series of a given voxel with its 26 nearest neighboring
   voxels. This operation was performed for all voxels to generate a
   regional homogeneity map for each participant based on Kendall's
   coefficient of concordance. A partial correlation analysis was performed
   to examine the relationship between regional homogeneity maps and flight
   training hours. We found that the anterior cingulate cortex in the ab
   initio group was significantly positively correlated with flight hours.
   These results suggest a potential relationship between flight training
   experience and the functional properties of the anterior cingulate
   cortex.},
