@article{ WOS:000781044300009,
Author = {Fornara, Ferdinando and Mosca, Oriana and Bosco, Andrea and Caffo,
   Alessandro O. and Lopez, Antonella and Iachini, Tina and Ruggiero,
   Gennaro and Ruotolo, Francesco and Sbordone, Filomena Leonela and
   Ferrara, Antonella and Cattaneo, Zaira and Arioli, Maria and
   Frassinetti, Francesca and Candini, Michela and Miola, Laura and
   Pazzaglia, Francesca},
Title = {Space at home and psychological distress during the Covid-19 lockdown in
   Italy},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2022},
Volume = {79},
Month = {FEB},
Abstract = {Prolonged periods of restrictions on people's freedom of movement during
   the first massive wave of the COVID19 pandemic meant that most people
   engaged in all their daily activities at home. This suggested the need
   for the spatial features of the home and its occupants' perception of
   them to be investigated in terms of people's wellbeing. The present
   study was conducted on a large sample (N = 1354) drawn from different
   Italian regions. It examined the relationship between the ``objective ``
   and ``subjective `` dimensions of the home, measured in terms of
   objective home crowding and satisfaction with the space at home, in
   relation to perceived stress and the perceived risk of COVID-19
   infection during the lockdown. The results showed that perceived stress
   is influenced by objective home crowding through the mediation of
   satisfaction with the space at home. These associations were more
   pronounced in younger generations. The negative association between
   satisfaction with the space at home and perceived stress was higher, the
   lower the perceived COVID-19 risk.},
