Title = {Stakeholder perspectives on fostering the water-energy-food nexus in
   Jordan: lessons beyond agricultural water management},
Journal = {ENVIRONMENTAL RESEARCH: FOOD SYSTEMS},
Year = {2025},
Volume = {2},
Number = {1},
