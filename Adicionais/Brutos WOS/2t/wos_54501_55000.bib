@article{ WOS:000709722100015,
Author = {Upham, Nathan S. and Poelen, Jorrit H. and Paul, Deborah and Groom,
   Quentin J. and Simmons, Nancy B. and Vanhove, Maarten P. M. and
   Bertolino, Sandro and Reeder, DeeAnn M. and Bastos-Silveira, Cristiane
   and Sen, Atriya and Sterner, Beckett and Franz, Nico M. and Guidoti,
   Marcus and Penev, Lyubomir and Agosti, Donat},
Title = {Liberating host-virus knowledge from biological dark data},
Journal = {LANCET PLANETARY HEALTH},
Year = {2021},
Volume = {5},
Number = {10},
Pages = {E746-E750},
Month = {OCT},
Abstract = {Connecting basic data about bats and other potential hosts of SARS-CoV-2
   with their ecological context is crucial to the understanding of the
   emergence and spread of the virus. However, when lockdowns in many
   countries started in March, 2020, the world's bat experts were locked
   out of their research laboratories, which in turn impeded access to
   large volumes of offline ecological and taxonomic data. Pandemic
   lockdowns have brought to attention the longstanding problem of
   so-called biological dark data: data that are published, but
   disconnected from digital knowledge resources and thus unavailable for
   high-throughput analysis. Knowledge of host-to-virus ecological
   interactions will be biased until this challenge is addressed. In this
   Viewpoint, we outline two viable solutions: first, in the short term, to
   interconnect published data about host organisms, viruses, and other
   pathogens; and second, to shift the publishing framework beyond
   unstructured text (the so-called PDF prison) to labelled networks of
   digital knowledge. As the indexing system for biodiversity data,
   biological taxonomy is foundational to both solutions. Building
   digitally connected knowledge graphs of host-pathogen interactions will
   establish the agility needed to quickly identify reservoir hosts of
   novel zoonoses, allow for more robust predictions of emergence, and
   thereby strengthen human and planetary health systems.},
