@article{ WOS:000410451800001,
Author = {West, Alexander C. and Smith, Laura and Ray, David W. and Loudon, Andrew
   S. I. and Brown, Timothy M. and Bechtold, David A.},
Title = {Misalignment with the external light environment drives metabolic and
   cardiac dysfunction},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {SEP 12},
Abstract = {Most organisms use internal biological clocks to match behavioural and
   physiological processes to specific phases of the day-night cycle.
   Central to this is the synchronisation of internal processes across
   multiple organ systems. Environmental desynchrony (e.g. shift work)
   profoundly impacts human health, increasing cardiovascular disease and
   diabetes risk, yet the underlying mechanisms remain unclear. Here, we
   characterise the impact of desynchrony between the internal clock and
   the external light-dark (LD) cycle on mammalian physiology. We reveal
   that even under stable LD environments, phase misalignment has a
   profound effect, with decreased metabolic efficiency and disrupted
   cardiac function including prolonged QT interval duration. Importantly,
   physiological dysfunction is not driven by disrupted core clock
   function, nor by an internal desynchrony between organs, but rather the
   altered phase relationship between the internal clockwork and the
   external environment. We suggest phase misalignment as a major driver of
   pathologies associated with shift work, chronotype and social jetlag.},
