@article{ WOS:001387128500001,
Author = {Chiurciu, Irina-Adriana and Vlad, Ionela Miuko and Stoicea, Paula and
   Zaharia, Iuliana and David, Livia and Soare, Elena and Fintineru, Gina
   and Micu, Marius Mihai and Dinu, Toma Adrian and Tudor, Valentina
   Constanta and Smedescu, Dragos Ion},
Title = {Romanian Meat Consumers' Choices Favour Sustainability?},
Journal = {SUSTAINABILITY},
Year = {2024},
Volume = {16},
Number = {24},
Month = {DEC},
Abstract = {The paper highlights the evolution of meat consumption in Romania
   between 2007 and 2022 based on statistical data retrieved from the
   National Institute of Statistics and also presents a recent 2024
   diagnosis on Romanian meat consumption from field data acquired through
   a questionnaire survey to which 1002 people gave valid answers. For the
   average annual meat consumption in Romania it was found that it varies
   depending on the category: for beef it was a decreasing trend, for pork
   the trend was slightly increasing, and the consumption of mutton and
   goat meat had an insignificant variation. The central place in terms of
   meat consumption was occupied by poultry (34.78\%), which had the most
   obvious increase. The questionnaire reflected that meat consumption is
   influenced by multiple factors including: age, income level, level of
   education, origin of meat etc. In the context of climate and
   geopolitical change, there is an increasing emphasis on finding
   alternatives for meat. The largest share of respondents to the
   questionnaire said that they will continue to consume meat, the rest
   preferring substitutes obtained from vegetables. Our results and the
   analysis, correlations and approaches done within this paper could serve
   as a basis for meat consumption patterns in Romania and may ground
   future marketing policies and sustainable development strategies in the
   food industry.},
