@article{ WOS:001767816200001,
Author = {Abbott, G. Meghan and Crandall, Chelsey and Klizentyte, Kotryna and
   Veach, Jonathan and Villac, M. Celia},
Title = {Clearing Murky Waters: Red tide video as a mitigation tool},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {Using video as a public communication tool to increase scientific and
   health literacy has grown in popularity. This study created and
   evaluated a YouTube video about red tide in Florida (caused by the
   microalga Karenia brevis) as part of an environmental and health impact
   mitigation strategy. A stepwise framework was developed and is presented
   for creation of videos that increase viewer scientific and health
   literacy. The animated video Red Tide in Florida covered critical
   information topics such as effects on health and accessing resources
   targeted to a broad audience of residents and visitors. The video was
   distributed with a brief online survey November 2022 to February 2023 to
   both a convenience sample of Florida residents (n = 213) and an
   experimental panel of approximately half Florida residents and half U.S.
   residents of other states (n = 419). Results supported the video as an
   effective tool to both engage viewers (84\% convenience and 87\%
   experimental rated the video as ``Good{''} or ``Very Good{''}) and to
   increase their understanding of red tide (77\% convenience and 88\%
   experimental). This study informs management strategies aimed at
   improving community resilience against environmental challenges by
   demonstrating a targeted public education science video can successfully
   increase viewer knowledge to promote self-efficacy in health and
   environmental action.},
