@article{ WOS:001791685000001,
Author = {Constantino, Rio Renato P. and Espiritu, Czarina C. and Tabeta, Maria
   Sabrina G. and Taray, Kirk J. and Garcia, Jezryl Jaeger L. and Bejar,
   Simeon Gabriel F. and Manzano, Dorothy J. O. and Borthwick, Sophie A.
   and Low, Dolyce H. W. and Mendenhall, Ian H. and Laing, Eric D. and
   Demetria, Catalino and Malbas, Fedelino and Dacuma, Mary Grace B. and
   Alviola, Phillip A. and Duya, Mariano Roy M.},
Title = {Movement patterns of three species of flying foxes across human-modified
   landscapes in the Philippines},
Journal = {MAMMALIA},
Year = {2026},
Month = {2026 JUN 8},
Abstract = {Effective management of flying foxes (Family Pteropodidae) is hampered
   by a lack of detailed understanding of their movements, particularly in
   the context of limiting zoonoses risk. To address this, we used
   solar-powered GPS tags to track eight flying foxes, mostly males,
   belonging to three sympatric species (2 Acerodon jubatus, 5 Pteropus
   hypomelanus, 1 P. vampyrus) in the Philippines to describe their
   movement patterns and habitat use. The tags transmitted data for a mean
   of 13 nights (range: 1-45 nights). Across all three species, the mean
   nightly linear distance flown by a flying fox away from the roost was
   10.89 km (A. jubatus = 18.85 km, P. hypomelanus = 7.6 km, P. vampyrus =
   11.5 km). Flying foxes were frequently observed using built-up and
   agricultural areas. Our study supports the mobile nature of flying
   foxes, is the first to document the movement patterns of P. hypomelanus
   using GPS tags, and demonstrates that all three species can use habitats
   heavily modified by humans. To limit zoonoses risk, we recommend
   protecting flying foxes and their habitats, minimizing bat-human
   interactions in identified foraging areas, promoting biodiversity
   conservation, and encouraging collaboration among different stakeholders
   for the successful management of flying fox populations.},
