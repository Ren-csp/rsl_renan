@article{ WOS:A1992JC86800019,
Author = {CHEVRAY, PM and NATHANS, D},
Title = {PROTEIN-INTERACTION CLONING IN YEAST - IDENTIFICATION OF MAMMALIAN
   PROTEINS THAT REACT WITH THE LEUCINE ZIPPER OF JUN},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
