@article{ WOS:001849230100001,
Author = {Panchalingam, Kajavathani and Rasheed, Eziaku Onyeizu and Rotimi, James
   Olabode Bamidele},
Title = {Investigating stakeholders' perspectives on cost-related drivers and
   barriers to Passivhaus adoption in New Zealand},
Journal = {SMART AND SUSTAINABLE BUILT ENVIRONMENT},
Year = {2026},
Month = {2026 AUG 18},
Abstract = {Purpose-The Passivhaus Standard is internationally recognised for
   delivering high levels of energy efficiency, occupant comfort and indoor
   environmental quality. Despite these recognised benefits, its adoption
   in New Zealand remains limited, with concerns regarding construction
   costs, technical complexity, market readiness and policy support
   continuing to influence uptake. This study investigates
   multi-stakeholder perceptions of the cost-related drivers and barriers
   influencing Passivhaus adoption and identifies the key enablers for
   wider implementation. Design/methodology/approach-An exploratory
   quantitative research design was adopted using a questionnaire survey. A
   purposive sampling approach was employed to target stakeholders with
   experience in Passivhaus design, construction, certification, ownership
   and research. A total of 59 valid responses were collected and analysed
   using descriptive statistical techniques to examine perceptions of the
   economic benefits, barriers and adoption enablers. Findings-Operational
   energy cost savings are perceived as the most significant economic
   benefit associated with Passivhaus buildings. In contrast, perceptions
   of maintenance savings, property value enhancement and market premiums
   are comparatively less certain. High upfront construction costs emerged
   as the dominant barrier to adoption, followed by knowledge gaps,
   technical complexity, market limitations and insufficient policy
   support. In contrast, occupant-related concerns, including behavioural
   resistance and thermal comfort issues, were generally perceived as minor
   constraints. Stakeholders identified financial incentives, professional
   training, demonstration projects, public education initiatives and local
   supply-chain development as key enablers of wider adoption. Overall, the
   findings suggest that Passivhaus adoption in New Zealand is influenced
   not only by economic considerations but also by industry capability,
   market readiness, stakeholder awareness and policy support, indicating
   that wider adoption will require a combination of financial, technical,
   educational and policy-based measures. Originality/value-This study
   provides context-specific empirical evidence on the factors influencing
   Passivhaus adoption in New Zealand from a multi-stakeholder perspective.
   The findings contribute to understanding the economic, industry, market
   and policy factors shaping the uptake of high-performance housing and
   inform the development of a stakeholder-informed strategic framework to
   support wider Passivhaus adoption.},
