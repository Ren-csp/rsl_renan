@article{ WOS:000293284600065,
Author = {Yu, Hai-Chuan and Zhao, Hua-Lu and Wu, Zhi-Kui and Zhang, Jun-Wu},
Title = {Eos Negatively Regulates Human γ-globin Gene Transcription during
   Erythroid Differentiation},
Journal = {PLOS ONE},
Year = {2011},
Volume = {6},
Number = {7},
Month = {JUL 28},
Abstract = {Background: Human globin gene expression is precisely regulated by a
   complicated network of transcription factors and chromatin modifying
   activities during development and erythropoiesis. Eos (Ikaros family
   zinc finger 4, IKZF4), a member of the zinc finger transcription factor
   Ikaros family, plays a pivotal role as a repressor of gene expression.
   The aim of this study was to examine the role of Eos in globin gene
   regulation.
   Methodology/Principal Findings: Western blot and quantitative real-time
   PCR detected a gradual decrease in Eos expression during erythroid
   differentiation of hemin-induced K562 cells and Epo-induced CD34+
   hematopoietic stem/progenitor cells (HPCs). DNA transfection and
   lentivirus-mediated gene transfer demonstrated that the enforced
   expression of Eos significantly represses the expression of
   gamma-globin, but not other globin genes, in K562 cells and CD34+ HPCs.
   Consistent with a direct role of Eos in globin gene regulation,
   chromatin immunoprecipitaion and dual-luciferase reporter assays
   identified three discrete sites located in the DNase I hypersensitivity
   site 3 (HS3) of the beta-globin locus control region (LCR), the promoter
   regions of the G gamma- and A gamma-globin genes, as functional binding
   sites of Eos protein. A chromosome conformation capture (3C) assay
   indicated that Eos may repress the interaction between the LCR and the
   gamma-globin gene promoter. In addition, erythroid differentiation was
   inhibited by enforced expression of Eos in K562 cells and CD34+ HPCs.
   Conclusions/Significance: Our results demonstrate that Eos plays an
   important role in the transcriptional regulation of the gamma-globin
   gene during erythroid differentiation.},
Publisher = {PUBLIC LIBRARY SCIENCE},
Address = {185 BERRY ST, STE 1300, SAN FRANCISCO, CA 94107 USA},
