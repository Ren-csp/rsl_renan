@article{ WOS:001738335500003,
Author = {Macea-Mercado, Luis Fernando and Sevillano-Rodriguez, Maria Eugenia and
   Gabriel, Luis},
Title = {Socioeconomic and Territorial Determinants of Sustainable Housing Choice
   in Colombia},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2026},
Volume = {58},
Number = {227},
Pages = {342-359},
Month = {SPR},
Abstract = {This study analyzes the socioeconomic and territorial determinants of
   sustainable housing choice in Colombia using a stated preference survey
   conducted in four cities and a Mixed Logit model with a panel structure.
   The results show that total monthly cost is the main barrier, while
   energy and water savings positively influence the probability of
   choosing sustainable housing. The spatial analysis reveals significant
   differences across urban areas, and the simulation of tiered subsidies
   increases adoption probabilities among lower-income households. These
   findings provide valuable insights for designing sustainable housing
   policies with territorial and redistributive approaches.},
