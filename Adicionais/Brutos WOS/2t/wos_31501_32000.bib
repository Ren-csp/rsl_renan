@article{ WOS:000852509900001,
Author = {Bautista-Valarezo, Estefania and Vega Crespo, Bernardo and
   Maldonado-Rengel, Ruth and Elena Espinosa, Maria and Alejandra Neira,
   Vivian and Verhoeven, Veronique},
Title = {Knowledge and Perceptions about Cervical Cancer and HPV Screening in
   Women in Rural Areas of Ecuador: A Qualitative Research Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {17},
Month = {SEP},
Abstract = {Background: Cervical cancer continues to be a major health problem in
   developing countries. Educational programs, as well as Pap and HPV
   screening and vaccination, are important tools to reduce the morbidity
   and mortality rates associated with this disease. The objective of this
   study is to explore the diverse knowledge and perceptions about cervical
   cancer and the different diagnostic tests for HPV of populations living
   in the rural parish ``El Valle{''}. Method: A qualitative study was
   conducted through eight focus groups, which included 46 participants
   from mixed ethnic groups. A phenomenological analysis was performed.
   Results: Four topics and seven sub-topics were identified. By analyzing
   all the narratives, it was possible to identify that the perception of
   cervical cancer was focused on its severity, secondary to its infectious
   process and screening periodicity. However, despite the diverse
   knowledge, indigenous people do not relate it to the human papilloma
   virus; in addition, there is also certain resistance to undergo the Pap
   smear test, for reasons such as inaccessibility and its sampling
   process. Conclusions: It is necessary to develop educational programs
   for the prevention of cervical cancer and to implement diagnostic
   alternatives to reach populations with precarious accessibility, as well
   as women who refuse to undergo the Pap smear test.},
