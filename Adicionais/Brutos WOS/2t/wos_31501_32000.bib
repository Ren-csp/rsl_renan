@article{ WOS:001488672500001,
Author = {Scerri, Karyn and Martinez, Lluis and Arenas, Juliana Betancur and
   Keseru, Imre and Attard, Maria},
Title = {Understanding the barriers and facilitators of planning and implementing
   active mobility interventions in Brussels and Malta},
Journal = {CITIES \& HEALTH},
Year = {2026},
Volume = {10},
Number = {3, SI},
Pages = {1036-1053},
Month = {MAY 4},
Abstract = {This paper examines stakeholder's perceptions about the barriers to
   planning and implementing active mobility interventions, and strategies
   to facilitate them. Despite the growing emphasis on sustainable urban
   mobility, significant obstacles to successful implementation persist,
   particularly in car-centric environments. An evident gap remains between
   policy design and implementation due to evolving barriers and
   facilitators that emerge throughout the intervention. To address this,
   we conducted research in two European case studies: Malta and Brussels,
   using a media content analysis and semi-structured stakeholder
   interviews (n = 15). Our findings reveal that both contexts face common
   barriers, including deeply ingrained car cultures, financial
   constraints, and political and knowledge barriers. However, the nature
   and intensity of these barriers differ due to the progress made by each
   city in implementing sustainable mobility interventions. In Malta,
   resistance from financial limitations and political reluctance, whereas
   in Brussels, political pushback and socio-cultural divisions play a
   greater role. This research provides novel insights into the
   complexities of urban transformation, particularly in car-dependent
   contexts. The findings highlight the importance of targeted policy
   adjustments, strategic funding mechanisms, and clearer communication to
   navigate these barriers. Addressing these challenges can enhance the
   success of active mobility interventions, fostering more liveable urban
   environments.},
