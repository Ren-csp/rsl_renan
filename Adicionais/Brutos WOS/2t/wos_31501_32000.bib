@article{ WOS:000363020800006,
Author = {Sun, Zhihong and Harris, Hugh M. B. and McCann, Angela and Guo, Chenyi
   and Argimon, Silvia and Zhang, Wenyi and Yang, Xianwei and Jeffery, Ian
   B. and Cooney, Jakki C. and Kagawa, Todd F. and Liu, Wenjun and Song,
   Yuqin and Salvetti, Elisa and Wrobel, Agnieszka and Rasinkangas, Pia and
   Parkhill, Julian and Rea, Mary C. and O'Sullivan, Orla and Ritari, Jarmo
   and Douillard, Francois P. and Ross, R. Paul and Yang, Ruifu and Briner,
