@article{ WOS:000296736000025,
Author = {Gomez-Ullate, E. and Novo, A. V. and Bayon, J. R. and Hernandez, Jorge
   R. and Castro-Fresno, Daniel},
Title = {Design and construction of an experimental pervious paved parking area
   to harvest reusable rainwater},
Journal = {WATER SCIENCE AND TECHNOLOGY},
Year = {2011},
Volume = {64},
Number = {9},
Pages = {1942-1950},
Abstract = {Pervious pavements are sustainable urban drainage systems already known
   as rainwater infiltration techniques which reduce runoff formation and
   diffuse pollution in cities. The present research is focused on the
   design and construction of an experimental parking area, composed of 45
   pervious pavement parking bays. Every pervious pavement was
   experimentally designed to store rainwater and measure the levels of the
   stored water and its quality over time. Six different pervious surfaces
   are combined with four different geotextiles in order to test which
   materials respond better to the good quality of rainwater storage over
   time and under the specific weather conditions of the north of Spain.
   The aim of this research was to obtain a good performance of pervious
   pavements that offered simultaneously a positive urban service and
   helped to harvest rainwater with a good quality to be used for non
   potable demands.},
