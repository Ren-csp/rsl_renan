@article{ WOS:000379159200012,
Author = {Habtemariam, Lemlem Teklegiorgis and Gandorfer, Markus and Kassa,
   Getachew Abate and Heissenhuber, Alois},
Title = {Factors Influencing Smallholder Farmers' Climate Change Perceptions: A
   Study from Farmers in Ethiopia},
