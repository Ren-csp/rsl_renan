@article{ WOS:001695073200002,
Author = {Jurado, Carlos Adrian Cruz and Aguayo, Jose Marcos Bustos and Herrera,
   Luz Marla Flores and Palos, Patricia Andrade and Carranza, Elizabeth
   Lopez and Guerrero, Jose Martlnez},
Title = {Cooperation in motorized urban mobility in the Metropolitan Area of
   Mexico's Valley},
Journal = {REVISTA COSTARRICENSE DE PSICOLOGIA},
Year = {2026},
Volume = {45},
Number = {1},
Month = {JAN-JUN},
Abstract = {Private car use is associated with diverse negative externalities such
   as air pollution and traffic congestion; however automobiles meet
   private mobilite needs in megacities, as well is driven by symbolic and
   affective motives; unlike as more environmental friendly alternatives as
   public transport use; which is generally negatively evaluated in latin
   american countries. The objective of this study is to identify
   psychological and situational predictors that favor cooperation in face
   of the social dilemma of urban mobility. Five stated preference
   vignettes were presented to a sample of 248 participants residents in
   the Metropolitan Area of Mexico's Valley. Their responses were analyzed
   through nominal response model of Item's Response Theory. Results reveal
   that different response options consisting of private care and public
   transportation conformed ordinal categories in the expected direction.
   Using a stepwise linear regression model, significant predictors of
   cooperation were integrated and introjected personal norms, along with
   restricted parking at the destination. These results are discussed in
   terms of the implications for car use reduction directed interventions
   and measuring personal urban mobility motorized behaviors.},
