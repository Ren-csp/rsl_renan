@article{ WOS:001272555000003,
Author = {Desvars-Larrive, Amelie and Vogl, Anna Elisabeth and Puspitarani,
   Gavrila Amadea and Yang, Liuhuaying and Joachim, Anja and Kaesbohrer,
   Annemarie},
Title = {A One Health framework for exploring zoonotic interactions demonstrated
   through a case study},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JUL 15},
Abstract = {The eco-epidemiology of zoonoses is often oversimplified to
   host-pathogen interactions while findings derived from global datasets
   are rarely directly transferable to smaller-scale contexts. Through a
   systematic literature search, we compiled a dataset of naturally
   occurring zoonotic interactions in Austria, spanning 1975-2022. We
   introduce the concept of zoonotic web to describe the complex
   relationships between zoonotic agents, their hosts, vectors, food, and
   environmental sources. The zoonotic web was explored through network
   analysis. After controlling for research effort, we demonstrate that,
   within the projected unipartite source-source network of zoonotic agent
   sharing, the most influential zoonotic sources are human, cattle,
   chicken, and some meat products. Analysis of the One Health 3-cliques
   (triangular sets of nodes representing human, animal, and environment)
   confirms the increased probability of zoonotic spillover at human-cattle
   and human-food interfaces. We characterise six communities of zoonotic
   agent sharing, which assembly patterns are likely driven by highly
   connected infectious agents in the zoonotic web, proximity to human, and
   anthropogenic activities. Additionally, we report a frequency of
   emerging zoonotic diseases in Austria of one every six years. Here, we
   present a flexible network-based approach that offers insights into
   zoonotic transmission chains, facilitating the development of
   locally-relevant One Health strategies against zoonoses.
   Zoonotic disease systems comprise complex dynamics between multiple
   animal hosts, vectors, environmental and food sources, and humans. In
   this study, the authors characterise this `zoonotic web' for the case
   study of Austria by performing network analyses of published zoonotic
   disease reports.},
