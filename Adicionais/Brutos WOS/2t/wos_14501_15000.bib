@article{ WOS:001709361900008,
Author = {Monterde-Miralles, Nuria and Cebrian, Gisela and Junyent, Merce},
Title = {School Climate Assemblies: A Study of Secondary Students' Perceptions},
Journal = {ENSENANZA DE LAS CIENCIAS},
Year = {2026},
Volume = {44},
Number = {1},
Pages = {145-164},
Abstract = {This study analyzes secondary students' perceptions of the strengths and
   areas for improvement of the school climate assemblies that were
   organized during the 2023-24 academic year, the changes in everyday
   actions they have undertaken as a result of their participation in the
   assemblies, and students' self-perceived improvement in sustainability
   competencies. To this end, an ad hoc questionnaire was designed and
   administered to 206 students. The results show that the assemblies
   resulted in improvements in the students' self-perceived competencies,
   particularly in relation to collective action and systems thinking. Key
   strengths were identified, such as teamwork and the acquisition of new
   knowledge, while suggested areas for improvement include increasing the
   level of engagement and allocating more sessions to the assemblies.
   Students also report changes in their everyday environmental actions
   that are attributable to their participation. This study concludes that
   climate assemblies can be an effective educational strategy for
   promoting sustainability competencies.},
