@article{ WOS:000562147100007,
Author = {Goncalves Ferreira, Maria da Conceicao and Siqueira, Gilmar Wanzeller},
Title = {Ecological trot in campus headquarters of Federal University of Para,
   Belem-PA, Brazil: memory and perception of a legacy},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
Year = {2020},
Volume = {37},
Number = {3},
Pages = {116-137},
Month = {MAY-AUG},
Abstract = {The Federal University of Para was installed in a lowland area in the
   Amazon region, bordered and cut by rivers, causing severe loss of native
   vegetation cover in most of the area designated to it and transforming
   the ecosystem of that territory. This study investigates the impacts of
   the Ecological Trot project implemented on the campus from 1990 to 1997,
   which had as premise to develop a preservationist conscience in the new
   students of the institution, engaging them in the reforestation process
   of the campus. The research was based on the documented or perceived
   memory of the implementers and servers who experienced these hoaxes. The
   results show the project's success in terms of afforestation of the
   campus and in changing the behavior of the university community in
   relation to environmental preservation actions in the institution and
   beyond the institutional walls.},
