@article{ WOS:000336093400001,
Author = {Braden, John B. and Jolejole-Foreman, Maria Christina and Schneider,
   Daniel W.},
Title = {Humans and the Water Environment: The Need for Coordinated Data
   Collection},
Journal = {WATER},
Year = {2014},
Volume = {6},
Number = {1},
Pages = {1-16},
Month = {JAN},
Abstract = {Efforts to observe humans in relation to nature over time and at large
   scale are few and disjointed in ways that impede progress in building
   scientific foundations for sustainability. Two water-oriented
   national-scale case studies highlight the challenges of integrating
   existing natural system and social system data: one concerns the
   influence of environmental attitudes and water quality on water
   conservation efforts; the other explores relationships between
   environmental attitudes, water quality and recreation behavior. The case
   studies show that coupled research conducted at large scale can yield
   new insights, but uncoordinated data limit meaningful inference. We
   propose salient features of a coordinated observation program for water.},
