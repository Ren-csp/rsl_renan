Title = {ESSAY ABOUT BEHAVIOR: BETWEEN SCIENCE, PHILOSOPHY AND EDUCATION},
Journal = {ETD EDUCACAO TEMATICA DIGITAL},
Year = {2019},
Volume = {21},
