@article{ WOS:000459113600157,
Author = {Heiman, Tali and Olenik-Shemesh, Dorit},
Title = {Perceived Body Appearance and Eating Habits: The Voice of Young and
   Adult Students Attending Higher Education},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
