@article{ WOS:000314000400017,
Author = {Cerin, Ester and Lee, Ka-yiu and Barnett, Anthony and Sit, Cindy H. P.
   and Cheung, Man-chin and Chan, Wai-man},
Title = {Objectively-measured neighborhood environments and leisure-time physical
   activity in Chinese urban elders},
Journal = {PREVENTIVE MEDICINE},
