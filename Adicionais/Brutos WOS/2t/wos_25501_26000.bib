@article{ WOS:001596650200001,
Author = {Ruedas, Luis A. and Gardner, Scott L.},
Title = {Biodiversity conservation depends on the expansion of taxonomy and
   systematics research},
Journal = {JOURNAL OF MAMMALOGY},
Year = {2025},
Volume = {106},
Number = {6},
Pages = {1495-1512},
Month = {DEC},
Abstract = {Despite mammals constituting fewer than 0.3\% of all described species,
   their conservation is compelling for a number of reasons. They
   contribute to biodiversity and are important in maintaining and
   regulating ecological communities. Many mammals have significant
   cultural and economic value, serving as sources of food, medicine, and
   tourism revenue. Furthermore, the conservation of mammals often leads to
   the protection of entire habitats, benefiting numerous other species and
   preserving ecosystem services that are critical for human well-being.
   Humans share a unique evolutionary history with other mammal species,
   making their preservation important for scientific research, education,
   and understanding of our own biology and evolution. In spite of this,
   mammalian biodiversity is at severe risk, with 26\% of all mammal
   species threatened with extinction. Here, we propose to use a 4-step
   framework with which to approach conservation strategy for mammalian
   biodiversity. The framework is structured and based on a protocol
   initially established from the standpoint of parasites by Daniel R.
   Brooks and collaborators in 2014. The 4 key phases are documentation
   (species discovery and specimen collection); assessment (species
   relationships, genetic diversity, and climate change vulnerability);
   monitoring (tracking populations and habitats over time); and action
   (addressing the taxonomic impediment-the lack of human and financial
   resources to undertake taxonomy, as well as the discrepancy between real
   number of existing species and human knowledge of biodiversity-and
   expanding protected areas). The successful integration of politics,
   politicians, and stakeholders into the process of conservation is
   critical to the success of the protocol because of the requirement to
   enact policy. And the urgency is now, because nothing is more vital to
   the human condition than preservation of biodiversity.
   Aunque los mam \& iacute;feros constituyen menos del 0,3\% de todas las
   especies descritas, su conservaci \& oacute;n deber \& iacute;a ser
   apremiante por m \& uacute;ltiples razones. Contribuyen a la diversidad
   biol \& oacute;gica y son importantes en la preservaci \& oacute;n y
   regulaci \& oacute;n de las comunidades ecol \& oacute;gicas. Muchos mam
   \& iacute;feros tienen un importante valor cultural y econ \&
   oacute;mico, ya que sirven como fuentes de alimentos y medicinas y son
   un atractivo tur \& iacute;stico. Adem \& aacute;s, la conservaci \&
   oacute;n de los mam \& iacute;feros a menudo lleva a la protecci \&
   oacute;n de h \& aacute;bitats enteros, lo cual beneficia a muchas otras
   especies y preserva servicios ecosist \& eacute;micos que son
   fundamentales para el bienestar humano. Los humanos comparten una
   historia evolutiva \& uacute;nica con otras especies de mam \&
   iacute;feros, lo que hace que la conservaci \& oacute;n de estos \&
   uacute;ltimos sea importante para la investigaci \& oacute;n cient \&
   iacute;fica, educaci \& oacute;n y comprensi \& oacute;n de nuestra
   propia biolog \& iacute;a y evoluci \& oacute;n. Y sin embargo, a pesar
   de estos atributos, la biodiversidad mam \& iacute;fera est \& aacute;
   en grave riesgo, ya que el 26\% de todas las especies mam \&
   iacute;feras est \& aacute;n amenazadas de extinci \& oacute;n. Aqu \&
   iacute; proponemos usar una agenda cuatripartita con la que abordar una
   estrategia de conservaci \& oacute;n de la biodiversidad mam \&
   iacute;fera. El marco est \& aacute; estructurado y basado en el
   protocolo de Documentaci \& oacute;n, Evaluaci \& oacute;n, Monitoreo y
   Acci \& oacute;n (DAMA) elaborado por Daniel R. Brooks y colaboradores
   en 2014, e inicialmente establecido desde el punto de vista de los par
   \& aacute;sitos. Las cuatro fases clave son: documentaci \& oacute;n
   (colecci \& oacute;n de espec \& iacute;menes y descubrimiento de
   especies); evaluaci \& oacute;n (descubrimiento de relaciones entre
   especies, evaluaci \& oacute;n de diversidad gen \& eacute;tica y
   vulnerabilidad al cambio clim \& aacute;tico); monitoreo (rastreo de
   poblaciones y h \& aacute;bitats a lo largo del tiempo); y acci \&
   oacute;n (expansi \& oacute;n de \& aacute;reas protegidas y abordar el
   impedimento taxon \& oacute;mico-la falta de recursos humanos y
   financieros para llevar a cabo la taxonom \& iacute;a, as \& iacute;
   como la amplia discrepancia entre la biodiversidad espec \& iacute;fica
   real y nuestro conocimiento de la misma). La integraci \& oacute;n
   productiva de la pol \& iacute;tica y los pol \& iacute;ticos en el
   proceso de conservaci \& oacute;n es fundamental para el \& eacute;xito
   del protocolo debido a la necesidad de promulgar pol \& iacute;ticas y
   leyes dirigidas a la conservaci \& oacute;n. Y la urgencia es ahora,
   porque nada es m \& aacute;s vital para la condici \& oacute;n humana
   que la preservaci \& oacute;n de la biodiversidad.},
