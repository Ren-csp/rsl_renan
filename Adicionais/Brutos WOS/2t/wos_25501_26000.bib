@article{ WOS:000417169600011,
Author = {Karenina, Karina and Giljov, Andrey and Ingram, Janeane and Rowntree,
   Victoria J. and Malashichev, Yegor},
Title = {Lateralization of mother-infant interactions in a diverse range of
   mammal species},
Journal = {NATURE ECOLOGY \& EVOLUTION},
Year = {2017},
Volume = {1},
Number = {2},
Month = {FEB},
Abstract = {Left-cradling bias is a distinctive feature of maternal behaviour in
   humans and great apes, but its evolutionary origin remains unknown. In
   11 species of marine and terrestrial mammal, we demonstrate consistent
   patterns of lateralization in mother-infant interactions, indicating
   right hemisphere dominance for social processing. In providing clear
   evidence that lateralized positioning is beneficial in mother-infant
   interactions, our results illustrate a significant impact of
   lateralization on individual fitness.},
