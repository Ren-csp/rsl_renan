Title = {Natural Host Relationships of Hantaviruses Native to Western Venezuela},
Journal = {VECTOR-BORNE AND ZOONOTIC DISEASES},
Year = {2010},
Volume = {10},
Number = {6},
Pages = {605-611},
Month = {AUG},
Abstract = {Strains of Cano Delgadito virus (CADV) and Maporal virus (MAPV) were
   isolated from 25 (8.9\%) of the 280 rodents captured on farms in 1997 in
   western Venezuela. The results of analyses of laboratory and zoographic
   data indicated that Alston's cotton rat (Sigmodon alstoni) is the
   principal host of CADV, horizontal virus transmission is the dominant
   mode of CADV transmission in Alston's cotton rat in nature, a pygmy rice
   rat (Oligoryzomys sp.) is the principal host of MAPV, and the natural
   host relationships of CADV and MAPV are highly specific.},
