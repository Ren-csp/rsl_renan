@article{ WOS:000331084400009,
Author = {Li, Guifeng and Magana, Donny and Dyer, R. Brian},
Title = {Anisotropic energy flow and allosteric ligand binding in albumin},
Journal = {NATURE COMMUNICATIONS},
Year = {2014},
Volume = {5},
Month = {JAN},
Abstract = {Allosteric interactions in proteins generally involve propagation of
   local structural changes through the protein to a remote site.
   Anisotropic energy transport is thought to couple the remote sites, but
   the nature of this process is poorly understood. Here, we report the
   relationship between energy flow through the structure of bovine serum
   albumin and allosteric interactions between remote ligand binding sites
   of the protein. Ultrafast infrared spectroscopy is used to probe the
   flow of energy through the protein backbone following excitation of a
   heater dye, a metalloporphyrin or malachite green, bound to different
   binding sites in the protein. We observe ballistic and anisotropic
   energy flow through the protein structure following input of thermal
   energy into the flexible ligand binding sites, without local heating of
   the rigid helix bundles that connect these sites. This efficient energy
   transport mechanism enables the allosteric propagation of binding energy
   through the connecting helix structures.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Dyer, RB (Corresponding Author), Emory Univ, Dept Chem, 1515 Dickey Dr, Atlanta, GA 30322 USA.
