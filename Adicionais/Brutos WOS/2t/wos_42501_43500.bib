@article{ WOS:001402050600010,
Author = {Liu, Yanhua and Wang, Jinlong and Liu, Tao and Wei, Zhiting and Luo, Bin
   and Chi, Mingchao and Zhang, Song and Cai, Chenchen and Gao, Cong and
   Zhao, Tong and Wang, Shuangfei and Nie, Shuangxi},
Title = {Triboelectric tactile sensor for pressure and temperature sensing in
   high-temperature applications},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JAN 3},
Abstract = {Skin-like sensors capable of detecting multiple stimuli simultaneously
   have great potential in cutting-edge human-machine interaction. However,
   realizing multimodal tactile recognition beyond human tactile perception
   still faces significant challenges. Here, an extreme
   environments-adaptive multimodal triboelectric sensor was developed,
   capable of detecting pressure/temperatures beyond the range of human
   perception. Based on triboelectric nanogenerator technology, an
   asymmetric structure capable of independently outputting dual signals
   was designed to improve perception sensitivity. By converting the
   signals and the stimuli into feature matrices, parallel perception of
   complex objects (with a recognition rate of 94\%) and temperature at
   high temperatures was achieved. The proposed multimodal triboelectric
   tactile sensor represents progress in maximum detection range and rapid
   response, realizing the upper limit of human skin's high-temperature
   sensing (60 degrees C) with a working temperature of 200 degrees C. The
   proposed self-powered multimodal sensing system offers a wider range of
   possibilities for human/robot/environment interaction applications.},
