@article{ WOS:001018100800013,
Author = {Xue, Guangai and Yu, Hyun Jae and Buffone, Cindy and Huang, Szu-Wei and
   Lee, KyeongEun and Goh, Shih Lin and Gres, Anna T. T. and Guney, Mehmet
   Hakan and Sarafianos, Stefan G. G. and Luban, Jeremy and Diaz-Griffero,
   Felipe and KewalRamani, Vineet N. N.},
Title = {The HIV-1 capsid core is an opportunistic nuclear import receptor},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {JUN 24},
Abstract = {The movement of viruses and other large macromolecular cargo through
   nuclear pore complexes (NPCs) is poorly understood. The human
   immunodeficiency virus type 1 (HIV-1) provides an attractive model to
   interrogate this process. HIV-1 capsid (CA), the chief structural
   component of the viral core, is a critical determinant in nuclear
   transport of the virus. HIV-1 interactions with NPCs are dependent on
   CA, which makes direct contact with nucleoporins (Nups). Here we
   identify Nup35, Nup153, and POM121 to coordinately support HIV-1 nuclear
   entry. For Nup35 and POM121, this dependence was dependent cyclophilin A
   (CypA) interaction with CA. Mutation of CA or removal of soluble host
   factors changed the interaction with the NPC. Nup35 and POM121 make
   direct interactions with HIV-1 CA via regions containing phenylalanine
   glycine motifs (FG-motifs). Collectively, these findings provide
   additional evidence that the HIV-1 CA core functions as a macromolecular
   nuclear transport receptor (NTR) that exploits soluble host factors to
   modulate NPC requirements during nuclear invasion.
   Nuclear import of the HIV-1 capsid (CA) is mediated through direct
   interactions with components of the nuclear pore complexes. Here, the
   authors identify Nup35 and POM121 as HIV-1 CA interacting factors
   regulating nuclear entry and further demonstrate regulation of the
   process by soluble factors Cyclophilin A and CPSF6.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {KewalRamani, VN (Corresponding Author), NCI, Model Dev Sect, Canc Innovat Lab, Frederick, MD 21702 USA.
