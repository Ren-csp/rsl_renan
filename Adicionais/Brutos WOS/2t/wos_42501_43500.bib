@article{ WOS:000450996700007,
Author = {Guagnano, Giacinto Davide and Mininni, Giuseppe},
Title = {Translation as sign exploration: A semiotic approach based on Peirce},
Journal = {SEMIOTICA},
Year = {2018},
Number = {225},
Pages = {129-140},
Month = {NOV},
Abstract = {What can be translated from one language to another ? What relationship
   exists between the translator and the text being translated ? This
   article shows how Peirce's semiotics, with its array of concepts that
   function as tools for the textual analysis, can shed a clarifying light
   on the explorative nature of a translation. In fact, what is described
   is the dynamic focusing on a transfer of meaning from one text to
   another, characteristic of human language, the presence of which can be
   observed in those circumstances where an ``abductive{''} performance is
   specifically required, such as in the translation.},
