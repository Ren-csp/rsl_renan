@article{ WOS:001735782300001,
Author = {Winch, Christopher},
Title = {Between the categorial and the normative: challenges within contemporary
   analytic philosophy of education},
Journal = {JOURNAL OF PHILOSOPHY OF EDUCATION},
Year = {2026},
Month = {2026 APR 7},
Abstract = {This article raises the question as to whether philosophy of education
   has both categorial and normative commitments, and argues that it has
   both. First, it discusses categorial philosophy of education (CPED) in
   terms of two possible forms: one which involves uncontroversial
   anthropological considerations, and one which makes substantial claims
   about human nature. Each is framed with examples. Normative philosophy
   of education (NPED) is then introduced and contrasted with the
   categorial version. An illustrative example from Rousseau demonstrates
   the close relationship between normative political philosophy and NPED.
   The article then presents an extended example of NPED, relating this to
   contemporary discussions of conceptual engineering. The work of R. S.
   Peters is considered as a sustained and partly successful attempt to
   disentangle categorial and normative elements in his own evolving
   philosophy of education. Finally, the relationship between CPED and NPED
   is outlined.},
