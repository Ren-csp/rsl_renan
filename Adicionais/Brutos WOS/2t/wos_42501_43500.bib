@article{ WOS:001334758300001,
Author = {Przybylinski, Stephen},
Title = {The pendulum swings: mobilizing policies to develop mass homeless
   encampments in the ``progressive{''} city},
Journal = {URBAN GEOGRAPHY},
Year = {2025},
Volume = {46},
Number = {4},
Pages = {838-860},
Month = {APR 21},
Abstract = {Portland, Oregon sits at the forefront of experimenting with policies
   for sheltering unhoused people outside of congregate shelter. In 2021,
   the City Government legalized sanctioned encampments by adopting them
   into city land use codes and for periods throughout its housing state of
   emergency, it also decriminalized sleeping in public. But with the
   continued increase of homelessness in Portland, the city has abruptly
   returned to more punitive policies concerning unhoused peoples' use of
   space. In July 2023, the city opened its first mass encampment hosting
   nearly 200 people, and in July 2024, it began enforcing its ban on
   camping in public space. To understand this shift, the paper engages
   with policy mobilities and carceral geographies scholarship to examine
   how the City of Portland came to this about-face at this particular
   moment. I argue the city's normalization of smaller tiny house
   encampments justified its development of mass encampments, a decision
   that was informed by approaches to homelessness practiced elsewhere, and
   one in which a significant portion of unhoused people experience more
   punitive conditions that partly emanate from the socio-spatial
   relationships in the encampment.},
