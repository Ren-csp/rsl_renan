@article{ WOS:000346692000008,
Author = {Topmiller, Michael and Jacquez, Farrah and Vissman, Aaron T. and
   Raleigh, Kevin and Miller-Francis, Jenni},
Title = {Partnering With Youth to Map Their Neighborhood Environments A
   Multilayered GIS Approach},
Journal = {FAMILY \& COMMUNITY HEALTH},
Year = {2015},
Volume = {38},
Number = {1},
Pages = {66-76},
Month = {JAN-MAR},
Abstract = {Mapping approaches offer great potential for community-based
   participatory researchers interested in displaying youth perceptions and
   advocating for change. We describe a multilayered approach for gaining
   local knowledge of neighborhood environments that engages youths as
   co-researchers and active knowledge producers. By integrating geographic
   information systems with environmental audits, an interactive focus
   group, and sketch mapping, the approach provides a place-based
   understanding of physical activity resources from the situated
   experience of youths. Youths report safety and a lack of recreational
   resources as inhibiting physical activity. Maps reflecting youth
   perceptions aid policy makers in making place-based improvements for
   youth neighborhood environments.},
