@article{ WOS:000664863000009,
Author = {Colchero, Fernando and Aburto, Jose Manuel and Archie, Elizabeth A. and
   Boesch, Christophe and Breuer, Thomas and Campos, Fernando A. and
   Collins, Anthony and Conde, Dalia A. and Cords, Marina and Crockford,
   Catherine and Thompson, Melissa Emery and Fedigan, Linda M. and Fichtel,
   Claudia and Groenenberg, Milou and Hobaiter, Catherine and Kappeler,
   Peter M. and Lawler, Richard R. and Lewis, Rebecca J. and Machanda,
   Zarin P. and Manguette, Marie L. and Muller, Martin N. and Packer, Craig
   and Parnell, Richard J. and Perry, Susan and Pusey, Anne E. and Robbins,
   Martha M. and Seyfarth, Robert M. and Silk, Joan B. and Staerk, Johanna
   and Stoinski, Tara S. and Stokes, Emma J. and Strier, Karen B. and
