@article{ WOS:000174061500003,
Author = {Ramanjulu, S and Bartels, D},
Title = {Drought- and desiccation-induced modulation of gene expression in plants},
Journal = {PLANT CELL AND ENVIRONMENT},
Year = {2002},
Volume = {25},
Number = {2},
Pages = {141-151},
Month = {FEB},
Abstract = {Desiccation is the extreme form of dehydration. Tolerance of desiccation
   is acquired by seeds and in resurrection plants, a small group of
   angiosperms. Desiccation tolerance is the result of a complex cascade of
   molecular events, which can be divided into signal perception, signal
   transduction, gene activation and biochemical alterations leading to
   acquisition of tolerance. Many of these molecular processes are also
   observed during the dehydration of non-tolerant plants. Here we try to
   give an overview of the gene expression programmes that are triggered by
   dehydration, with particular reference to protective molecules and the
   regulation of their expression. Potential transgenic approaches to
   manipulating stress tolerance are discussed.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Bartels, D (Corresponding Author), Univ Bonn, Inst Bot, Kirschallee 1, D-53115 Bonn, Germany.
   Univ Bonn, Inst Bot, D-53115 Bonn, Germany.},
DOI = {10.1046/j.0016-8025.2001.00764.x},
ISSN = {0140-7791},
EISSN = {1365-3040},
Keywords = {environmental stress; regulatory genes; resurrection plants; stress
   tolerance; transgenic plants},
Keywords-Plus = {SUCROSE-PHOSPHATE SYNTHASE; ABSCISIC-ACID; WATER-DEFICIT;
   CRATEROSTIGMA-PLANTAGINEUM; PROTEIN-KINASE; ARABIDOPSIS-THALIANA;
   SALT-STRESS; SIGNAL-TRANSDUCTION; DEHYDRATION TOLERANCE; TRANSCRIPTION
   FACTORS},
