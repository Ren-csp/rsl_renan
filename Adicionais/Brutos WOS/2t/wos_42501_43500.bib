@article{ WOS:000458229100011,
Author = {Dur, Robert and Vollaard, Ben},
Title = {Salience of law enforcement: A field experiment},
Journal = {JOURNAL OF ENVIRONMENTAL ECONOMICS AND MANAGEMENT},
Year = {2019},
