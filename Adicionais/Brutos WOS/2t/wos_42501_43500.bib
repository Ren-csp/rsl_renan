@article{ WOS:000625205000003,
Author = {Guzhavina, Tatiana A.},
Title = {Digitalization for Sustainable Development of Small Towns in Russia},
Journal = {EUROPEAN JOURNAL OF SUSTAINABLE DEVELOPMENT},
Year = {2021},
