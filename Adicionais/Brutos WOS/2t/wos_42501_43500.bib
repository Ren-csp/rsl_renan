   Tawni and Pique-Regi, Roger and Wilson, Mark E. and Barreiro, Luis B.
   and Tung, Jenny},
Title = {Social status alters chromatin accessibility and the gene regulatory
   response to glucocorticoid stimulation in rhesus macaques},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2019},
