   Campbell, Danny, Univ Stirling, Stirling Management Sch, Econ Div, Stirling FK9 4LA, Scotland.},
DOI = {10.1016/j.jeem.2020.102383},
Article-Number = {102383},
ISSN = {0095-0696},
EISSN = {1096-0449},
