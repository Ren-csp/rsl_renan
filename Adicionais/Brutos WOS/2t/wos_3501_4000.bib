@article{ WOS:001730654900001,
Author = {Cheng, Shi and Zhao, Manxing and Zhang, Dunsong and Chen, Shuolei},
Title = {Healthy aging planning: A multi-scale review of urban green space
   impacts on post-COVID health behaviors},
Journal = {CITIES},
Year = {2026},
Volume = {173},
Month = {JUN},
Abstract = {Since the COVID-19 pandemic has altered the health effects of urban
   green space (UGS) under worldwide aging urbanization, an increasing
   number of studies have explored the impacts of UGS on elderly
   individuals' varying and complex health behaviors. A systematic study is
   necessary to synthesize post-COVID patterns and transformative impacts
   on elders' health behaviors. Following the PRISMA guidelines, this study
   identified multiscale research spreads and unsteady UGS impacts by
   literature review. Although site-scale UGS attributes accounted for most
   associative relationships, district- and city-scale planning had more
   than 60\% of the coefficients, indicating that these are more effective
   measures but are in an initial exploration at larger scales. While
   singlescale attributes have limited effects to promote post-COVID-19
   health behaviors for older citizens, this study proposes a cooperative
   multiscale strategy to enhance public health and well-beings and
   identify UGS accessibility as a dominant contribution at more than one
   scales. The onsite attributes should be incorporated into context
   environments such as proper UGS distributions during policy-making and
   practice. Future studies should address the limitations in research
   rigor and alternative measurements for public well-being and
   environmental sustainability with healthy aging planning.},
