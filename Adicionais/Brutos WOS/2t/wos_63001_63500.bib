@article{ WOS:000309863900001,
Author = {Mahanty, Sango and Milne, Sarah and Dressler, Wolfram and Filer, Colin},
Title = {The Social Life of Forest Carbon: Property and Politics in the
   Production of a New Commodity},
Journal = {HUMAN ECOLOGY},
Year = {2012},
Volume = {40},
Number = {5},
Pages = {661-664},
Month = {OCT},
Abstract = {Interventions to conserve carbon stored in forests are central to the
   emerging global climate change regime. Widely referred to as REDD+,
   these interventions engage local resource holders in contracts to
   restrict their use of land and forests in exchange for conditional
   benefits, effectively creating a market for forest carbon-a new and
   intangible commodity. Delving into the social and material implications
   of this, three case studies (Papua New Guinea, Philippines, Cambodia)
   examine property relations in the early stages of forest carbon
   production in different tenure contexts. The case studies reveal that:
   (a) the risk of local exclusion from forest and lands under REDD+ is
   real, but is mediated by dynamic negotiations over knowledge and
   property; (b) the relationship between forest carbon and underlying
   property relations around land and forests is recursive and mutually
   constitutive; and (c) due to ongoing and entrenched property contests in
   REDD+ locations, there remains an unstable foundation for forest carbon
   markets.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Mahanty, S (Corresponding Author), Australian Natl Univ, Resource Management Asia Pacific Program, Coll Asia \& Pacific, Canberra, ACT, Australia.
   Mahanty, Sango; Milne, Sarah; Filer, Colin, Australian Natl Univ, Resource Management Asia Pacific Program, Coll Asia \& Pacific, Canberra, ACT, Australia.
   Dressler, Wolfram, Wageningen Univ, Forests \& Nat Conservat Policy Grp, Wageningen, Netherlands.},
DOI = {10.1007/s10745-012-9524-1},
ISSN = {0300-7839},
EISSN = {1572-9915},
