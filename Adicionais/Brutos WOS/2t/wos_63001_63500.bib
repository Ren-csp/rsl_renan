@article{ WOS:001523184500002,
Author = {Alanis-Hernandez, Luis Alberto and Velasco, Itzel Gaytan and
   Herrera-Munoz, Gonzalo and Sanchez-Rojas, Gerardo},
Title = {Consequences of tourism on the integrity and feeding of some wild
   mammals in America},
Journal = {PERIPLO SUSTENTABLE},
Year = {2025},
Number = {48},
Pages = {283-294},
Month = {JAN-JUN},
Abstract = {Tourism in natural areas encourages interaction and contact with the
   landscape and biodiversity through recreational activities such as
   hiking, which promotes the observation of the fauna and flora present
   and allows people to learn and raise awareness about the relevance of
   biodiversity. Tourism, in addition to its social and cultural
   importance, is one of the most important economic activities in the
   world; however, in many cases, the negative impact it has on the
   integrity of biodiversity is ignored. Wild mammals are one of the main
   components affected by tourist activities and poor administrative
   management, which mainly promotes a reduction in their abundance and
   species diversity, as well as changes in their activity periods,
   foraging times, and an alteration in their diet. It is common for
   species to consume the garbage and organic waste that tourists throw
   away during their stay in the natural areas they visit. This human
   behavior is a serious problem because the intake of food outside their
   diet can generate irreversible consequences for their health and
   survival. This work presents information on garbage consumption and its
   consequences recorded for different species of mammals through a
   literature search and with evidence from the authors. Finally, different
   actions and measures are suggested to mitigate this conflict between
   tourists and biodiversity and promote its conservation.},
