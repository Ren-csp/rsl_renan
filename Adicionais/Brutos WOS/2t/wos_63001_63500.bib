Title = {Aquaculture and marine protected areas: Potential opportunities and
   synergies},
Journal = {AQUATIC CONSERVATION-MARINE AND FRESHWATER ECOSYSTEMS},
Year = {2017},
Volume = {27},
Number = {1},
