@article{ WOS:001037125100001,
Author = {Eliasson, Kristina and Lewis, Charlotte and Hellman, Therese and
   Dahlgren, Gunilla and Svartengren, Magnus and Nyman, Teresia},
Title = {Does occupational health surveillance lead to risk reduction for workers
   exposed to hand-intensive work?},
Journal = {APPLIED ERGONOMICS},
Year = {2023},
Volume = {112},
Month = {OCT},
Abstract = {This mixed method study aimed to describe what risk-reducing actions
   were proposed by ergonomists after the execution of a guided process for
   occupational health surveillance for workers exposed to hand-intensive
   work in ten companies. Another aim was to describe the exposed workers'
   proposals for risk-reducing actions, including their perceptions of
   potential changes in the self-assessed exposure levels and work-related
   pain. Several actions, targeting organizational, technical, and/or
   individual measures were proposed. Proposals from the ergonomists more
   often targeted the personal measures, whereas the workers' proposals
   targeted technology or organiza-tional changes. Six companies
   implemented at least one of the action proposals. These action proposals
   were not related to evaluation metrics, nor were they evaluated. This
   study indicates that both ergonomists and companies need guidance on how
   to improve to work in a participatory process for the implementation and
   evaluation of risk-reducing actions, e.g., by how to better include
   workers' experiences.},
