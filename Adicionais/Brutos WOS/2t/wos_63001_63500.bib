Affiliation = {Brown, JM (Corresponding Author), Stanford Univ, Sch Med, Dept Radiat Oncol, Div Radiat \& Canc Biol, CCSR South,Room 1255,269 Campus Dr, Stanford, CA 94305 USA.
   Stanford Univ, Sch Med, Dept Radiat Oncol, Div Radiat \& Canc Biol, Stanford, CA 94305 USA.
   Stanford Univ, Sch Med, Dept Biochem, Stanford, CA 94305 USA.},
DOI = {10.1073/pnas.132275199},
ISSN = {0027-8424},
EISSN = {1091-6490},
