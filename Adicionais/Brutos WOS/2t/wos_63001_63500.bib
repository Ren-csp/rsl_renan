@article{ WOS:001208848000001,
Author = {Dikmen, Fatih and Dabak, Tunc and Ozgisi, Burcu Daser and Ozenirler,
   Cigdem and Kuralay, Selim Can and Cay, Selahattin Baris and Cinar, Yusuf
