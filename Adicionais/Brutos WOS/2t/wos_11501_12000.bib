Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Potter, C (Corresponding Author), NASA, Biospher Sci Branch, Div Earth Sci, Ames Res Ctr, Moffett Field, CA 94035 USA.
