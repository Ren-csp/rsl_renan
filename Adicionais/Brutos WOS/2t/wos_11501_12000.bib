@article{ WOS:000774404300001,
Author = {Koeser, Andrew K. and Hauer, Richard J. and Hilbert, Deborah R. and
   Northrop, Robert J. and Thorn, Hunter and McLean, Drew C. and Salisbury,
   Allyson B.},
Title = {The Tripping Point-Minimum Planting Widths for Small-Stature Trees in
   Dense Urban Developments},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {6},
Month = {MAR},
Abstract = {As urban development increases in density, the space to grow urban trees
   becomes more constrained. In heavily developed areas, small stature
   trees can be planted to reduce both above- and below-ground conflicts
   with infrastructure elements. However, even these species can interfere
   with pavement when placed in extremely confining conditions. In this
   study, we build on past work to determine the minimum planting space
   widths of small stature urban trees. Species, stem diameter, and the
   height at which stem diameter measurements occurred were all strong
   predictors of trunk flare (i.e., the interface region between large
   structural roots and the trunk) diameter (adjusted R-2 of 0.843).
   Additionally, we modelled the relationship between planting space and
   the presence or absence of pavement conflicts using the predictions
   derived from this effort to project the potential cost savings in two
   United States cities. Study results provide a guideline to create
   sufficient space for urban trees and minimize infrastructure damage and
   associated cost savings.},
