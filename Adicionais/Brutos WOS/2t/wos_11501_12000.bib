@article{ WOS:001131342200001,
Author = {Geng, Jianwei and Yu, Kunyong and Sun, Menglian and Xie, Zhen and Huang,
   Ruxian and Wang, Yihan and Zhao, Qiuyue and Liu, Jian},
Title = {Construction and Optimisation of Ecological Networks in High-Density
   Central Urban Areas: The Case of Fuzhou City, China},
Journal = {REMOTE SENSING},
Year = {2023},
Volume = {15},
Number = {24},
Month = {DEC},
Abstract = {Constructing and optimising ecological networks in high-density cities
   plays an important role in mitigating urban ecological problems. Our
   study uses comprehensive evaluation methods such as Morphological
   Spatial Pattern Analysis (MSPA), the Remote Sensing Ecological Index
   (RSEI), and Connectivity to identify ecological source areas in Fuzhou
   City, and constructs and optimises the network using the Minimum
