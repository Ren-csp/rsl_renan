@article{ WOS:001444827300001,
Author = {Garcia, Victor Manuel Benavides and Canul, Maria de Jesus Moo and Pavon,
   Romano Gino Segrado and Carrillo, Carlos Alonso Estrella},
Title = {Certifications and community perception, towards responsible tourism in
   Cozumel through constitutive communication},
Journal = {PERIPLO SUSTENTABLE},
Year = {2025},
Number = {48},
Pages = {161-178},
Month = {JAN-JUN},
Abstract = {The aim of this article is about the community perception in Cozumel
   regarding tourism certifications in local hotels, assessing their
   contribution to sustainable development. It highlights the global growth
   of tourism and its environmental and social impacts, advocating for
   sustainable practices as a response. Accordingly, the objective is to
   explore whether these certifications truly benefit responsibletourism in
   Cozumel by evaluating community perception. La methodology employed
   quantitative questionnaires applied to 387 residents and processing
   through ANOVAs and Structural Equation Systems with PLS, revealing that
   the community perceives sustainable certifications positively, albeit
   with reservations about their long-term impact on quality of life.
   Findings indicate that certified hotels contribute to perceived trust
   and safety, yet also suggest that they need to improve constitutive
   communication regarding their sustainable practices to strengthen the
   relationship with the community. The conclusion emphasizes the necessity
   for future research to delve deeper into local opinion and to make more
   efficient the integration of environmental and social standards in
   tourism certifications. This study contributes to understanding how
   certification practices can influence community perspective, although
   greater integration of environmental and social standards is required to
   maximize their impact towards responsible tourism in Cozumel.},
