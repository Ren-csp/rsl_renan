@article{ WOS:000509004300005,
Author = {O'Callaghan-Gordo, Cristina and Espinosa, Ana and Valentin, Antonia and
   Tonne, Cathryn and Perez-Gomez, Beatriz and Castano-Vinyals, Gemma and
   Dierssen-Sotos, Trinidad and Moreno-Iribas, Conchi and de Sanjose,
