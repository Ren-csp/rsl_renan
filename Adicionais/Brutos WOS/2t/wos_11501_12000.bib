@article{ WOS:001829139100003,
Author = {Chacon, Luis Sebastian Bravo and Hincapie, Julieth Natalia Castano and
   Gonzalez, Andres Camilo Patino and Agudelo, Maria Fernanda Cardenas},
Title = {Thermal Comfort and Walk ability: How does Urban Vegetation promote
   Active Mobility in Tropical Cities? A case study of Medellin (Colombia)},
Journal = {TERRITORIOS},
Year = {2026},
Number = {54, SI},
Abstract = {In the context of climate change, cities must adapt their mobility to
   become more resilient by promoting sustainable transport options such as
   walkability. In tropical cities, with warm climate, high incidence of
   solar radiation, traffic, and phenomena like heat islands, among other
   variables, affect pedestrian comfort. This study evaluates the influence
   of urban trees on temperature along three routes connected to the
   Integrated Transport System of the Aburr \& aacute; Valley: Hospital,
   Robledo, and Poblado; measuring air and ground temperatures at three
   different times of the day (9 a. m., 12 m. y 3 p. m.). It was observed
   that tree density and distribution influence temperature reduction,
   especially in areas with more shade. Air temperature decreases between
   0,45 degrees C and 1,54 degrees C, while ground temperature decreases
   between 3,1 degrees C and 7,6 degrees C. Pedestrians prefer routes with
   greater shade coverage, highlighting the importance of green spaces to
   promote sustainable modes of mobility.},
