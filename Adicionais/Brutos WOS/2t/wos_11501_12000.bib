@article{ WOS:001793829300001,
Author = {Afamefuna, Kimberly and Schweiker, Marcel and Harmsen, Jan-Frieder},
Title = {Impact of the Built Environment on Occupants' Well-Being-Related
   Perceptions and Health Behaviors: A Scoping Review},
Journal = {EUROPEAN REVIEW OF APPLIED PSYCHOLOGY-REVUE EUROPEENNE DE PSYCHOLOGIE
   APPLIQUEE},
Year = {2026},
Volume = {76},
Number = {3},
Month = {JUN},
Abstract = {Introduction: The built environment plays a significant role in shaping
   human experiences, particularly in schools, workplaces, and homes, where
   individuals spend a considerable portion of their time. Objective: This
   holistic scoping review aims to examine how the built environment in
   schools, workplaces, and homes influences psychological needs
   satisfaction, motivation, health behaviors, stress and relaxation, and
   subjective well-being. Method: A systematic search of the two databases
   Scopus and PubMed was conducted in accordance with PRISMA-ScR
   guidelines, screening articles from 2014 to 2024. Results: The findings
   indicate that optimal indoor environmental conditions like adequate
   lighting, comfortable temperatures, good air quality, and access to
   nature enhance perceived productivity, attention, and relaxation.
   Flexible spaces that support autonomy and social interaction also
   improve well-being. Conversely, environmental stressors like noise, poor
   air quality, and thermal discomfort can increase stress and reduce
   motivation. To foster well-being in diverse environments, it is
   suggested to integrate biophilic design features, offer personal control
   over building systems, and ensure optimal acoustic conditions.
   Conclusion: The review highlights the importance of designing built
   environments that cater to occupants' physical, cognitive, and
   psychological needs. While many studies demonstrate correlations between
   environmental factors and perceptive and behavioral outcomes, the
   quality of research varies, with a need for more rigorous longitudinal
   and experimental designs to establish causal relationships and long-term
   effects.},
