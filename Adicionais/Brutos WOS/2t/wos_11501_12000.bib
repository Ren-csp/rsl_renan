@article{ WOS:000284093500009,
Author = {Rechia, Simone and Betran, Javier Olivera},
Title = {Barcelona's urban parks: the relationship between different forms of
   appropriation and safety from major and co-related uses},
Journal = {MOVIMENTO},
Year = {2010},
Volume = {16},
Number = {3},
Pages = {179-200},
Abstract = {The intention this paper was to analyze the model of Barcelona's parks,
   plazas and streets, emphasising the relationship among different forms
   of appropriation and safety of these spaces, based on the concepts of
   major and co-related uses from JACOBS (2000). The methodological
   procedures were: application of the protocol developed by GEPLEC/UFPR,
   photographic images, films and semi-structured interviews. In
   conclusion, we can infer that some Barcelona's public spaces include
   such forms of co-related use, which depend on a number of factors, among
   them, urban planning, which should connect spaces in order to ensure
   diversity of experiences, safety, and therefore the ``public life{''} in
   big cities.},
