@article{ WOS:001142897900004,
Author = {Zhu, Qiang and Combs, Matthew E. and Liu, Juan and Bai, Xue and Wang,
   Wenbo B. and Herring, Laura E. and Liu, Jiandong and Locasale, Jason W.
   and Bowles, Dawn E. and Gross, Ryan T. and Pla, Michelle Mendiola and
