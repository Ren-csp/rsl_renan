@article{ WOS:000464338100001,
Author = {Stassi, Stefano and Marini, Monica and Allione, Marco and Lopatin,
   Sergei and Marson, Domenico and Laurini, Erik and Pricl, Sabrina and
   Pirri, Candido Fabrizio and Ricciardi, Carlo and Di Fabrizio, Enzo},
Title = {Nanomechanical DNA resonators for sensing and structural analysis of
   DNA-ligand complexes},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {APR 12},
Abstract = {The effect of direct or indirect binding of intercalant molecules on DNA
   structure is of fundamental importance in understanding the biological
   functioning of DNA. Here we report on self-suspended DNA nanobundles as
   ultrasensitive nanomechanical resonators for structural studies of
   DNA-ligand complexes. Such vibrating nanostructures represent the
   smallest mechanical resonator entirely composed of DNA. A correlative
   analysis between the mechanical and structural properties is exploited
   to study the intrinsic changes of double strand DNA, when interacting
   with different intercalant molecules (YOYO-1 and GelRed) and a
   chemotherapeutic drug (Cisplatin), at different concentrations. Possible
   implications of our findings are related to the study of interaction
   mechanism of a wide category of molecules with DNA, and to further
   applications in medicine, such as optimal titration of chemotherapeutic
   drugs and environmental studies for the detection of heavy metals in
   human serum.},
