@article{ WOS:000577271500016,
Author = {Hanaba, Svitlana and Voitiuk, Olena and Goliardyk, Nataliia},
Title = {Methodological Potential of the Complexity Concept in Education
   Modernization},
Journal = {POSTMODERN OPENINGS},
Year = {2020},
