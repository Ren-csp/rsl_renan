@article{ WOS:000646858700003,
Author = {Whaley, Luke},
Title = {Geographies of the Self: Space, Place, and Scale Revisited},
Journal = {HUMAN ARENAS},
Year = {2018},
Volume = {1},
Number = {1},
Pages = {21-36},
Month = {MAR},
Abstract = {Where do tendencies to exclude, discriminate, and dominate originate
   from? Why for many do harmful traits like these appear so characteristic
   of modern life? How might we move beyond this predicament to foster more
   sustainable and enriching relationships with one another and with
   Nature? In this paper, I explore the classic geographic concepts of
   space, place, and scale and apply them to a consideration of the body
   and of selfhood. In doing so, I trace out two markedly different
   `geographies of the self'. The first `self' emerges from the basic tenet
   that space and matter are mutually exclusive, a premise that underpins
   the dominant episteme of objective rationality. This is the self as
   selfish, insular, and oppositional. The second `self' emerges from the
   basic tenet that matter dynamically includes and is included in space,
   giving rise to the philosophy of `natural inclusionality'. The natural
   inclusional self is hence dynamically distinct but not definitively
   discrete, a vital inclusion of its natural neighbourhood. I consider
   some of the implications of these two versions of the self for society,
   contending that the first promotes a culture of exclusion and the second
   a culture of belonging. In finishing, I consider questions of method and
   praxis as they relate to the project of evolving inclusional selves.},
