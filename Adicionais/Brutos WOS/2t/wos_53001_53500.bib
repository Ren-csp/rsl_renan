@article{ WOS:001510537100001,
Author = {Lovikka, Ville A. and Chen, Lin and Figueiredo, Patricia I. and
   Mikkonen, Kirsi S.},
Title = {Atomic Force Microscopy of Emulsions and Their Interfacial Nanoparticles},
Journal = {NATURAL SCIENCES},
Year = {2025},
