@article{ WOS:000695601600001,
Author = {Al-Garawi, Najah and Anil, Ismail},
Title = {Geographical Distribution and Modeling of the Impact of Women Driving
   Cars on the Sustainable Development of Saudi Arabia},
Journal = {SUSTAINABILITY},
