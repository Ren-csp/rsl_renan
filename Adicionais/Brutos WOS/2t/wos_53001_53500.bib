@article{ WOS:001335667700001,
Author = {Sun, Ranhao and He, Hongbin and Jing, Yongcai and Leng, Song and Yang,
   Guocheng and Lu, Yihe and Borrelli, Pasquale and Chen, Liding and Fu,
   Bojie},
Title = {Global Wind Erosion Reduction Driven by Changing Climate and Land Use},
Journal = {EARTHS FUTURE},
