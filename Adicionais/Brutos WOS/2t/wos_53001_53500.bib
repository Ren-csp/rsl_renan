Author = {Lee, Hee-Eun and Park, Sang-Je and Huh, Jae-Won and Imai, Hiroo and Kim,
   Heui-Soo},
Title = {The enhancer activity of long interspersed nuclear element derived
   microRNA 625 induced by NF-κB},
Journal = {SCIENTIFIC REPORTS},
