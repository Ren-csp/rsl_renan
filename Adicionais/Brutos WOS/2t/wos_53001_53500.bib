@article{ WOS:001534465000029,
Author = {Fanelli, Angela and Cescatti, Alessandro and Ciscar, Juan-Carlos and
   Dubois, Gregoire and Ibarreta, Dolores and Lowe, Rachel and Riccetti,
   Nicola and Robuchon, Marine and Capua, Ilaria and Szewczyk, Wojtek and
   Massaro, Emanuele},
Title = {Assessing the risk of diseases with epidemic and pandemic potential in a
   changing world},
Journal = {SCIENCE ADVANCES},
Year = {2025},
Volume = {11},
Number = {30},
Month = {JUL 23},
Abstract = {How do human activities contribute to the emergence of zoonotic diseases
   that can lead to epidemics and pandemics? Our analysis of common drivers
   of the World Health Organization's priority diseases suggests that
   climate conditions, including higher temperatures, higher annual
   precipitation levels, and water deficits, elevate the risk of disease
   outbreaks. In addition, land-use changes, human encroachment on forested
   areas, increased population and livestock density, and biodiversity loss
   contribute to this risk, with biodiversity loss showing a complex and
   nonlinear relationship. This study also presents a global risk map and
   an epidemic risk index that combines countries' specific risk with their
   capacities for preparing and responding to zoonotic threats.},
