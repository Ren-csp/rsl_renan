@article{ WOS:000744896100001,
Author = {Bradshaw, Jessica and Schwichtenberg, Amy J. and Iverson, Jana M.},
Title = {Capturing the complexity of autism: Applying a developmental cascades
   framework},
Journal = {CHILD DEVELOPMENT PERSPECTIVES},
Year = {2022},
Volume = {16},
Number = {1},
Pages = {18-26},
Month = {MAR},
Abstract = {Developmental change emerges from dynamic interactions among networks of
   neural activity, behavior systems, and experience-dependent processes. A
   developmental cascades framework captures the sequential, multilevel,
   cross-domain nature of human development and is ideal for demonstrating
   how interconnected systems have far-reaching effects in typical and
   atypical development. Neurodevelopmental disorders represent an
   intriguing application of this framework. Autism spectrum disorder (ASD)
   is complex and heterogeneous, with biological and behavioral features
   that cut across multiple developmental domains, including those that are
   motor, cognitive, sensory, and bioregulatory. Mapping developmental
   cascades in ASD can be transformational in elucidating how seemingly
   unrelated behaviors (e.g., those emerging at different points in
   development and occurring in multiple domains) are part of an
   interconnected neurodevelopmental pathway. In this article, we review
   evidence for specific developmental cascades implicated in ASD and
   suggest that theoretical and empirical advances in etiology and change
   mechanisms can be accelerated using a developmental cascades framework.},
