Author = {Dallo, Irina and Marti, Michele and Kuratle, Lorena Daphna and Ly, Cong
   and Zeller, Stefanie and Zaugg, Simone},
Title = {Social perspectives of carbon capture, transportation, utilization, and
   storage in Switzerland},
