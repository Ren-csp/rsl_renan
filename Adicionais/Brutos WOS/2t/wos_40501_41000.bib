   MEM UNIV NEWFOUNDLAND,ST JOHNS A1B 3V6,NEWFOUNDLAND,CANADA.
   TECH UNIV LODZ,INST PHYS,PL-93005 LODZ,POLAND.},
DOI = {10.1073/pnas.88.22.10064},
