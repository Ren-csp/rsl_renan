@article{ WOS:001338022400001,
Author = {de Santana, Maria Vittoria Alves and de Oliveira, Danilo Vicente Batista
   and Albuquerque, Ulysses Paulino},
Title = {Investigating cultural ecosystem services of the Caatinga on Flickr},
Journal = {ETHNOBIOLOGY AND CONSERVATION},
Year = {2025},
Volume = {14},
Pages = {1-9},
Abstract = {Public interest in nature can be promoted through social media by
   assessing the importance of a species to people and identifying new
   emblems appealing to conservationists. We aimed to assess the public
   interest in cultural ecosystem services in the Caatinga (seasonal dry
   forest). Ecosystem services were categorized on approximately 1500
   photographs posted on Flickr. These photographs were analyzed using
   manual and deep-learning (DL) approaches. The most observed categories
   for both approaches were ``Enjoyment of the Landscape{''} (36.8\%),
   ``Appreciation of Nature - Animals{''} (25.6\%), and ``Social
   Activities{''} (19.3\%). However, we found significant differences
   between the manual and DL classifications, owing to the difficulties in
   classifying categories using the DL model. These findings suggest low
   cultural ecosystem service representation on the photo-sharing platform
   Flickr in the Caatinga region, even after removing 67\% of the collected
   data. This may be attributed to the limited interest in Flickr among the
   Caatinga residents. Deep learning techniques have the potential to study
   cultural ecosystem services, but their efficacy depends on the capacity
   of the algorithm to discern human-nature interactions and various
   natural elements. Our observations indicate that increasing the scale of
   the training and test datasets and incorporating additional categories
   to account for Caatinga diversity may enhance the results.},
