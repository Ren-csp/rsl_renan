Title = {Ultradian rhythmicity of plasma cortisol is necessary for normal
   emotional and cognitive responses in man},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2018},
