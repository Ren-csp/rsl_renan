@article{ WOS:000483305700005,
Author = {Huang, Yu-Kuan and Wang, Minyu and Sun, Yu and Di Costanzo, Natasha and
   Mitchell, Catherine and Achuthan, Adrian and Hamilton, John A. and
   Busuttil, Rita A. and Boussioutas, Alex},
Title = {Macrophage spatial heterogeneity in gastric cancer defined by multiplex
   immunohistochemistry},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {SEP 2},
Abstract = {Tumor-associated macrophages (TAMs), one of the most abundant immune
   components in gastric cancer (GC), are difficult to characterize due to
   their heterogeneity. Multiple approaches have been used to elucidate the
   issue, however, due to the tissue-destructive nature of most of these
   methods, the spatial distribution of TAMs in situ remains unclear. Here
   we probe the relationship between tumor context and TAM heterogeneity by
   multiplex immunohistochemistry of 56 human GC cases. Using distinct
   expression marker profiles on TAMs, we report seven predominant
   populations distributed between tumor and non-tumor tissue. TAM
   population-associated gene signatures reflect their heterogeneity and
   polarization in situ. Increased density of CD163+ (CD206-) TAMs with
   concurrent high CD68 expression is associated with upregulated
   immune-signaling and improved patient survival by univariate, but not
   multivariate analysis. CD68-only and CD206+ TAMs are correlated with
   high PDL1 expression.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
