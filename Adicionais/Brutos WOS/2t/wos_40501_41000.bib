@incollection{ WOS:000326240400018,
Author = {Beyers, Johanna M.},
Editor = {Wals, AEJ and Corcoran, PB},
Title = {Sustainability as meaningful relatedness: lessons from Grandmother Bear},
Booktitle = {LEARNING FOR SUSTAINABILITY IN TIMES OF ACCELERATING CHANGE},
Year = {2012},
Pages = {255-267},
Abstract = {Three decades ago, Joseph Grange issued a call for `foundational
   ecology', a discipline in which objective nature and subjective human
   psyche are understood to be profoundly linked. Departing from Grange,
   this chapter introduces `foundational sustainability' and examines it
   through the lens of meaningful relatedness. Three defining concepts are
   explored: support from below, indicating secure relationship and the
   creative linking of inner and outer realities; knowing with, an attuned,
   kinship state of mind that speaks to the quality of consciousness
   implied in support from below; and poetic learning, which denotes
   foundational sustainability's process-based path to transformational
   change. Its goal is to enter into relationship with the world. This
   integrative approach to learning, here called poetic inquiry, is
   narrative, imagistic and allied with the right-hemispheric brain. The
   story is told of `Grandmother Bear'; for the author, this luminous dream
   figure speaks of the need to situate a transformative sustainabililty in
   relationship to the greater canvas of existence the Bear evokes. Lastly,
   the tension of a discipline that links the worlds of nature and psyche
   and sits between praxis and poiesis is discussed and strategies for a
   curriculum of foundational sustainability are presented.},
