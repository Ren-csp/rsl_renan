@article{ WOS:001465712500001,
Author = {Lin, Jung-Yi (Capacity) and Chen, Chien-Cheng},
Title = {Factors Influencing Consumer Buying Behavior for Smart Home Technologies},
Journal = {SUSTAINABILITY},
