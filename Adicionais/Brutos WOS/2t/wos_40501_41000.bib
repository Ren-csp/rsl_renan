@article{ WOS:000388916600050,
Author = {Franco, Antonietta and Kitsis, Richard N. and Fleischer, Julie A. and
   Gavathiotis, Evripidis and Kornfeld, Opher S. and Gong, Guohua and
   Biris, Nikolaos and Benz, Ann and Qvit, Nir and Donnelly, Sara K. and
   Chen, Yun and Mennerick, Steven and Hodgson, Louis and Mochly-Rosen,
