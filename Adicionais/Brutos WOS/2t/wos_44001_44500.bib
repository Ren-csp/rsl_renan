@article{ WOS:001131328700001,
Author = {Hrdina, Marek and Surovy, Peter},
Title = {Internal Tree Trunk Decay Detection Using Close-Range Remote Sensing
   Data and the PointNet Deep Learning Method},
Journal = {REMOTE SENSING},
Year = {2023},
Volume = {15},
Number = {24},
Month = {DEC},
Abstract = {The health and stability of trees are essential information for the
   safety of people and property in urban greenery, parks or along roads.
   The stability of the trees is linked to root stability but essentially
   also to trunk decay. Currently used internal tree stem decay assessment
   methods, such as tomography and penetrometry, are reliable but usually
   time-consuming and unsuitable for large-scale surveys. Therefore, a new
   method based on close-range remotely sensed data, specifically
   close-range photogrammetry and iPhone LiDAR, was tested to detect
   decayed standing tree trunks automatically. The proposed study used the
   PointNet deep learning algorithm for 3D data classification. It was
   verified in three different datasets consisting of pure coniferous
   trees, pure deciduous trees, and mixed data to eliminate the influence
   of the detectable symptoms for each group and species itself. The mean
   achieved validation accuracies of the models were 65.5\% for Coniferous
   trees, 58.4\% for Deciduous trees and 57.7\% for Mixed data
   classification. The accuracies indicate promising data, which can be
   either used by practitioners for preliminary surveys or for other
   researchers to acquire more input data and create more robust
   classification models.},
