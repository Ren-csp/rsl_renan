@article{ WOS:000316356700070,
Author = {Ribeiro-Viana, Renato and Sanchez-Navarro, Macarena and Luczkowiak,
   Joanna and Koeppe, Julia R. and Delgado, Rafael and Rojo, Javier and
   Davis, Benjamin G.},
Title = {Virus-like glycodendrinanoparticles displaying quasi-equivalent nested
   polyvalency upon glycoprotein platforms potently block viral infection},
Journal = {NATURE COMMUNICATIONS},
Year = {2012},
Volume = {3},
Month = {DEC},
Abstract = {Ligand polyvalency is a powerful modulator of protein-receptor
   interactions. Host-pathogen infection interactions are often mediated by
   glycan ligand-protein interactions, yet its interrogation with very high
   copy number ligands has been limited to heterogenous systems. Here we
   report that through the use of nested layers of multivalency we are able
   to assemble the most highly valent glycodendrimeric constructs yet seen
   (bearing up to 1,620 glycans). These constructs are pure and
   well-defined single entities that at diameters of up to 32nm are capable
   of mimicking pathogens both in size and in their highly glycosylated
   surfaces. Through this mimicry these glyco-dendri-protein-nano-particles
   are capable of blocking (at picomolar concentrations) a model of the
   infection of T-lymphocytes and human dendritic cells by Ebola virus. The
   high associated polyvalency effects (beta>10(6), beta/N similar to
   10(2)-10(3)) displayed on an unprecedented surface area by precise
   clusters suggest a general strategy for modulation of such interactions.},
