@article{ WOS:001548323200001,
Author = {Ebile, Pride and Schuler, Johannes and Tega, Yasmina and Ouattara, Baba
   and Ouedraogo, Souleymane and Compaore, Eveline and Sawadogo, Hamado and
   Ndah, Hycenth Tim},
Title = {Analysis of agroecological transition and adoption potential in two
   contrasting regions of Burkina Faso using comparative participatory
   assessment tools},
Journal = {AGROECOLOGY AND SUSTAINABLE FOOD SYSTEMS},
Year = {2026},
Volume = {50},
Number = {6},
Pages = {1211-1244},
Month = {JUL 3},
Abstract = {This study explores farmers' perceptions of agroecology in two regions
   of Burkina Faso, assesses transition levels and adoption potential, and
   identifies barriers to upscaling. We applied the FAO TAPE in combination
   with the QAToFAIR tools in mixed-stakeholder participatory workshops.
   Findings reveal that farmers' views of agroecology are regionally
   influenced by differing environmental conditions (e.g. soil quality,
   rainfall, and erosion). Although agroecology is valued for its climate
   resilience and socioeconomic benefits, adoption remains low, hindered by
   limited resources and infrastructural challenges. Enhancing adoption
   requires supportive markets and providing tailored innovation support
   services (e.g. trainings, local knowledge exchange, and access to
   organic inputs).},
