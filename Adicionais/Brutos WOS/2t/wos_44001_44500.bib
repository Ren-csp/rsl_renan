@article{ WOS:000990158600001,
Author = {Guan, Huiyuan and Bai, Yongping and Tang, Yuanyuan and Zhang, Chunyue
   and Zou, Jiacheng},
Title = {Spatial identification and optimization of ecological network in
   desert-oasis area of Yellow River Basin, China},
Journal = {ECOLOGICAL INDICATORS},
Year = {2023},
Volume = {147},
Month = {MAR},
Abstract = {Scientific layout of ecological network is a basic guarantee for
   regional environmental protection and ecological restoration given the
   influence of global ecosystem changes, which is one of the important
   national strategies for coordinating ecosystem protection and economic
   development in China. We adopt a method involving ecosystem services and
   landscape connectivity to identify ecological source area. Furthermore,
   the method also can identify key ecological elements such as ecological
   corridors and ecological nodes based on the minimum cumulative
   resistance (MCR) model and gravity model to optimize the spatial
   pattern, formulate ecological security control area planning, and
   propose a development model for ecological spatial functional areas. The
