@article{ WOS:001763149800001,
Author = {Sanchez-Becerril, Omar and Villanueva-Poot, Raul R. and Palomo, Leopoldo
   E. and Charles, Anthony and Cisneros-Montemayor, Andres M. and
   Cuevas-Jimenez, Alfonso},
Title = {Social equity and economic distribution in community-based conservation
   strategies: the case of Fishing Refuge Zone in Mexico},
Journal = {FRONTIERS IN MARINE SCIENCE},
Year = {2026},
Volume = {13},
Month = {APR 29},
Abstract = {This study examines social equity in small-scale fisheries, in relation
   to the distribution of benefits from fishing. The analysis is based on
   data from fisheries in Celestun, Mexico, within the context of
   implementing a Fishing Refuge Zone (FRZ) -a community-based conservation
   strategy. Social equity perceptions in the local fishing sector were
   assessed by analyzing recognitional, procedural, and distributional
   equity dimensions. Additionally, inequality metrics (Gini G, Atkinson
   A(\& varepsilon;), Hoover H and Theil U) were determined to quantify
   economic inequality within the community of small-scale fishers. The
   comparison between members/participants of the Fishing Refuge Zone
   Management Committee and non-participating fishers revealed
   statistically significant differences in equity perceptions, with
   predominantly negative perceptions among the NC group, mainly regarding
   procedural equity (fairness of decision processes). Meanwhile,
   inequality metrics indicated high levels of revenue concentration (G=
   0.58, A(\& varepsilon;) = 0.52, H= 0.45, U= 0.73). The study provides an
   integrated assessment that connects social equity perceptions with
   distributional outcomes, offering insights for fostering more equitable
   governance in the management of the Celestun FRZ and other area-based
   fisheries and conservation tools.},
Publisher = {FRONTIERS MEDIA SA},
Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Sánchez-Becerril, O (Corresponding Author), Univ Marista Merida, Sch Nat Resources, Merida, Mexico.
   Sanchez-Becerril, Omar; Villanueva-Poot, Raul R.; Palomo, Leopoldo E.; Cuevas-Jimenez, Alfonso, Univ Marista Merida, Sch Nat Resources, Merida, Mexico.
