@article{ WOS:001158235700001,
Author = {Destanque, T. and Le Luyer, J. and Quillien, V. and Koua, M. Sham and
   Auffrey, P. and Ky, C. -L},
Title = {Substantial gene expression shifts during larval transitions in the
   pearl oyster Pinctada margaritifera},
Journal = {JOURNAL OF EXPERIMENTAL ZOOLOGY PART B-MOLECULAR AND DEVELOPMENTAL
   EVOLUTION},
Year = {2024},
