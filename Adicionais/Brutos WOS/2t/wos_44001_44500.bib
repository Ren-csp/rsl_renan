@article{ WOS:001818776200001,
Author = {Peri, Sravanti and de Bont, Cees},
Title = {Comparative activity-based mapping of Rythu Bazaars: participation
   patterns and active ageing in everyday public markets},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2026},
Month = {2026 JUL 15},
Abstract = {This paper examines how spatial configuration shapes participation
   patterns in three Rythu Bazaars, a state-supported farmer market system,
   in Visakhapatnam, Andhra Pradesh, India. Using comparative
   activity-based mapping derived from non-participant observation, the
   study documents variations in corridor geometry, entry hierarchy,
   parking interface, and environmental exposure. Although the markets
   operate under a shared governance model, differences in spatial
   organization correspond with circulation patterns, pause conditions, and
   temporal rhythms of engagement. The findings demonstrate that everyday
   market participation is mediated through spatial design and show how
   layered mapping can inform modest, evidence-based refinements that
   support age-inclusive public market environments and active ageing.},
