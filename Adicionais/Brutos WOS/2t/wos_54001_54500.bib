@article{ WOS:001787936700001,
Author = {Juvrud, Joshua and Salembier, Katherine and Delany, Margot and Frost,
   Shiloh and Liu, Xingcen (Lucy) and Loboda, Adrian and Sotiriou,
   Evangelia},
Title = {A dual-component framework of interactive attention: Gaze markers of
   expertise and engagement in split-attention gameplay},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2026},
Volume = {184},
Month = {NOV},
Abstract = {Video games require complex coordination of motor skills and active
   perception, yet the cognitive mechanisms underlying the transition from
   novice to expert remain under-examined. This study utilizes a
   custom-built 2D puzzle-platformer, Vacillate, to investigate how Game
   Literacy moderates the distribution of visual attention in a
   split-attention environment. Drawing on eye-tracking data from 52
   participants, we identify a distinct state of foveal dependency in
   novice players, characterized by reactive avatar monitoring. Conversely,
   increased expertise predicts visual economy, where players reallocate
   gaze toward predictive goal information. Results reveal that Game
   Literacy is a robust negative predictor of avatar-dwell time (R2 =
   0.33), while self-reported Enjoyment relates to slower, more deliberate
   saccadic processing. We propose the Dual-Component Framework of
   Interactive Expertise, which dissociates mechanical proficiency (Game
   Literacy) from affective engagement (Enjoyment). This framework posits
   that digital expertise is defined not by raw performance speed, but by
   the strategic economy of visual resources, a fundamental shift from
   reactive foveal dependency to proactive environmental scanning.},
