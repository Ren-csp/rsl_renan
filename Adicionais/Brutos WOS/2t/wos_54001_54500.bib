@article{ WOS:000288224800017,
Author = {Saline, Maria and Rodstrom, Karin E. J. and Fischer, Gerhard and
   Orekhov, Vladislav Yu. and Karlsson, B. Goran and Lindkvist-Petersson,
   Karin},
Title = {The structure of superantigen complexed with TCR and MHC reveals novel
   insights into superantigenic T cell activation},
Journal = {NATURE COMMUNICATIONS},
Year = {2010},
Volume = {1},
Month = {NOV},
Abstract = {Superantigens (SAgs) are bacterial toxins that interact with
   immunoreceptors, T cell receptor (TCR) and major histocompatibility
   complex (MHC) class II, conventionally through the variable beta-domain
   of TCR (TCRV beta). They induce a massive release of cytokines, which
   can lead to diseases such as food poisoning and toxic shock syndrome. In
   this study, we report the X-ray structure of the ternary complex between
   staphylococcal enterotoxin H (SEH) and its human receptors, MHC class II
   and TCR. The structure demonstrates that SEH predominantly interacts
   with the variable alpha-domain of TCR (TCRV alpha), which is supported
   by nuclear magnetic resonance (NMR) analyses. Furthermore, there is no
   contact between MHC and TCR upon complex formation. Structural analyses
   suggest that the major contact points to TCRV alpha are conserved among
   other bacterial SAgs. Consequently, a new dimension of SAg biology
   emerges, suggesting that in addition to the conventional interactions
   with the TCRV beta domain, SAgs can also activate T cells through the
   TCRV alpha domain.},
