@article{ WOS:001627610000042,
Author = {Khatri, Amit and Chaudhary, Ritika and Kumari, R. Mankamna and
   Choudhary, Vineet},
Title = {The luminal domain region of Seipin/Fld1 is dispensable for establishing
   functional ER sites for lipid droplet biogenesis},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {NOV 27},
Abstract = {Lipid droplet (LD) biogenesis occurs in the endoplasmic reticulum (ER),
   the mechanisms of which is not completely known. Seipin (Fld1 in yeast)
   is a crucial ER membrane protein that defines LD biogenesis sites. Here,
   we show that truncated seipin, Fld1-triangle LR in yeast, and the human
   equivalent hSeipin-triangle LR, mutants lacking the conserved luminal
   domain region (LR), functionally complement the LD biogenesis defect of
   fld1 triangle mutants. Fld1-triangle LR foci colocalize with factors:
   Nem1, Ldb16, Pex30 and Yft2, which are important for LD biogenesis and
   these sites become enriched in diacylglycerol upon stimulation of LD
   formation. Fld1-triangle LR forms a homo-oligomeric complex facilitated
   by protein-protein interactions. We show that mutating the 31st proline
   abrogates the functioning of Fld1-triangle LR. We demonstrate the
   critical regulatory role of LR of seipin in partitioning triacylglycerol
   into LDs. We conclude that LR of seipin is dispensable for establishing
   functional ER sites to recruit proteins for LD biogenesis.},
