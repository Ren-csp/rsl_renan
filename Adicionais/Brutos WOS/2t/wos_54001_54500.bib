@article{ WOS:001831121300003,
Author = {Hao, Mengjie and Wu, You and Zhang, Juyao and Liu, Xiaolu and Liang,
   Juncheng and Lei, Ming and Zhang, Xinyue and Chen, Zhongshan and Yang,
   Hui and Waterhouse, Geoffrey I. N. and Al-Enizi, Abdullah M. and Nafady,
   Ayman and Ma, Shengqian and Wang, Xiangke},
Title = {Local polarity modulation in triangular pores of covalent organic
   frameworks for iodine capture from water},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {MAY 20},
Abstract = {Radioactive iodine from nuclear fission processes can enter water
   systems in various ways, adversely affecting human health and the
   environment. Herein, we construct a series of covalent organic
   frameworks (COFs) with triangular pores and different local polarities
   for efficient iodine (I-2 + I- -><- I-3 -) capture from aqueous
   solution. Triangular pores containing weakly polar units show a strong
   affinity for nonpolar iodine via hydrophobic interactions, whilst the
   periodically ordered frameworks and intrinsic interlayers based on
   aromatic moieties and nitrogen-containing groups capture I-2 and I-3 -
   through van der Waals forces and charge transfer. COF-1 with weak local
   polarity delivers a high iodine (I-131) adsorption capacity, fast
   adsorption kinetics, and excellent selectivity in tap water,
   groundwater, and seawater. Moreover, COF-1 exhibits an exceptional trace
   iodine removal efficiency (from similar to 200 ppb to below similar to
   65.9 ppb in tap water and similar to 58.3 ppb in groundwater), making it
   a promising adsorbent for efficiently treating aqueous iodine waste
   streams.},
