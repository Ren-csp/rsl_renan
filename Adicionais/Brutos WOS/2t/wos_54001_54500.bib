@article{ WOS:001046577700001,
Author = {Ikediashi, Dubem and Moobela, Cletus and Leitch, Kenneth and Dan-Jumbo,
   Nimi and Dania, Afolabi and Akoh, Sani Reuben Reuben and Esangbedo, Paul},
Title = {Lecturer's pedagogical attributes and teaching quality for construction
   and engineering education in UK universities: mediating effect of
   research informed teaching},
