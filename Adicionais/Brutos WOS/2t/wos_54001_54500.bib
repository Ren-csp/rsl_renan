   Joshua, Jude B.; Jin, Yanghua, Zhejiang Gongshang Univ, Sch Business Adm, Hangzhou, Peoples R China.
   Ikhide, Juliet E., Eastern Mediterranean Univ, Business Adm Dept, Via Mersin 10, Famagusta, North Cyprus, Turkey.
   Ogunmokun, Oluwatobi A., Int Univ Rabat, Rabat Business Sch, Rabat, Morocco.},
DOI = {10.1080/09669582.2022.2043877},
EarlyAccessDate = {FEB 2022},
ISSN = {0966-9582},
EISSN = {1747-7646},
