@article{ WOS:000361703900024,
Author = {Halvorson, Kimberly M. and Hazeltine, Eliot},
Title = {Do small dual-task costs reflect ideomotor compatibility or the absence
   of crosstalk?},
Journal = {PSYCHONOMIC BULLETIN \& REVIEW},
Year = {2015},
Volume = {22},
Number = {5},
Pages = {1403-1409},
Month = {OCT},
Abstract = {Dual-task costs can be greatly reduced or even eliminated when both
   tasks use highly-compatible S-R associations. According to Greenwald
   (Journal of Experimental Psychology: Human Perception and Performance,
   30, 632-636, 2003), this occurs because the appropriate response can be
   accessed without engaging performance-limiting response selection
   processes, a proposal consistent with the embodied cognition framework
   in that it suggests that stimuli can automatically activate motor codes
   (e.g., Pezzulo et al., New Ideas in Psychology, 31(3), 270-290, 2013).
   To test this account, we reversed the stimulus-response mappings for one
   or both tasks so that some participants had to ``do the opposite{''} of
   what they perceived. In these reversed conditions, stimuli resembled the
   environmental outcome of the alternative (incorrect) response.
   Nonetheless, reversed tasks were performed without costs even when
   paired with an unreversed task. This finding suggests that the
   separation of the central codes across tasks (e.g., Wickens, 1984) is
   more critical than the specific S-R relationships; dual-task costs can
   be avoided when the tasks engage distinct modality-based systems.},
Publisher = {SPRINGER},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Halvorson, KM (Corresponding Author), Metropolitan State Univ, Dept Psychol, 1450 Energy Pk Dr, St Paul, MN 55108 USA.
   Halvorson, Kimberly M., Metropolitan State Univ, Dept Psychol, St Paul, MN 55108 USA.
   Hazeltine, Eliot, Univ Iowa, Dept Psychol, Iowa City, IA 52242 USA.},
DOI = {10.3758/s13423-015-0813-8},
ISSN = {1069-9384},
EISSN = {1531-5320},
Keywords = {Dual-task performance; Ideomotor compatibility; Embodied cognition;
   Modality effects},
Keywords-Plus = {OUTPUT MODALITY COMPATIBILITY; NO EVIDENCE; 2 THINGS; INPUT;
   INTERFERENCE; PERFORMANCE; SYSTEMS},
Research-Areas = {Psychology},
Web-of-Science-Categories  = {Psychology, Mathematical; Psychology, Experimental},
