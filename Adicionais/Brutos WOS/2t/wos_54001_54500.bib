@article{ WOS:000456164800001,
Author = {Must, Indrek and Sinibaldi, Edoardo and Mazzolai, Barbara},
Title = {A variable-stiffness tendril-like soft robot based on reversible osmotic
   actuation},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JAN 21},
Abstract = {Soft robots hold promise for well-matched interactions with delicate
   objects, humans and unstructured environments owing to their intrinsic
   material compliance. Movement and stiffness modulation, which is
   challenging yet needed for an effective demonstration, can be devised by
   drawing inspiration from plants. Plants use a coordinated and reversible
   modulation of intracellular turgor (pressure) to tune their stiffness
   and achieve macroscopic movements. Plant-inspired osmotic actuation was
   recently proposed, yet reversibility is still an open issue hampering
   its implementation, also in soft robotics. Here we show a reversible
   osmotic actuation strategy based on the electrosorption of ions on
   flexible porous carbon electrodes driven at low input voltages (1.3 V).
   We demonstrate reversible stiffening (similar to 5-fold increase) and
   actuation (similar to 500 deg rotation) of a tendril-like soft robot
   (diameter similar to 1 mm). Our approach highlights the potential of
   plant-inspired technologies for developing soft robots based on
   biocompatible materials and safe voltages making them appealing for
   prospective applications.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
