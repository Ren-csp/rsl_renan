@article{ WOS:001569216400006,
Author = {Baffour-Ata, Frank and Mensah, Sylvia Cecilia and Kuutiero, Roland
   Pupielu and Opoku, Derrick Asumedu and Agboto-Seguin, Charles Sergio and
   Sonful, Ernestina Abena and Darkoh, Claudia Akosua Pokuaa and Oteng,
   Nana Darkoah and Darkwah, Evans},
Title = {Assessing climate-smart agricultural practices and socioeconomic
   determinants in Atwima Kwanwoma District, Ghana},
Journal = {SCIENTIFIC AFRICAN},
Year = {2025},
Volume = {29},
Month = {SEP},
Abstract = {This study assesses the awareness, adoption, and impact of Climate-Smart
   Agricultural (CSA) practices in the Atwima Kwanwoma District of Ghana.
   The findings reveal a high level of awareness among farmers, with 95.17
   \% of men and 93.33 \% of women familiar with the concept of CSA.
   Approximately 95.00 \% and 93.00 \% of both male and female respondents
   acknowledged its benefits, such as improved crop yields and climate
   change mitigation. The study identifies 15 prioritized CSA practices,
   with crop diversification ranked highest (RII=0.935), followed by
   appropriate fertilizer use (RII=0.828), and mulching (RII=0.779). The
   use of climate-resilient seed varieties was least prioritized
   (RII=0.413). The adoption of these practices is significantly influenced
   by socioeconomic characteristics, including age, household size,
   educational level, etc. Specifically, age negatively influenced the
   adoption of crop diversification, decreasing the probability by 8.1 \%
   points for each one-year increase in age, and also negatively impacted
   the adoption of windbreaks and shelterbelts (86.5 \% point decrease) and
   climate-resilient seed varieties (15.6 \% point decrease). Household
   size positively influenced the adoption of appropriate fertilizer use
   (10.5 \% points increase), mulching (9.41 \% points increase), and
   integrated crop-livestock practices (10.5 \% points increase),
   highlighting the role of family labor. Educational level negatively
   influenced the adoption of integrated pest management practices (9.3 \%
   points decrease) and drought-resistant crop varieties (12.0 \% points
   decrease). The study concludes with several actionable policy
   implications. For instance, targeted educational programs should be
   implemented to increase awareness and understanding of CSA practices,
   especially focusing on less adopted practices like the use of
   climate-resilient seed varieties.},
