@article{ WOS:000933370800024,
Author = {Wu, Xiaochun and Zhang, Yan and Hou, Fang and Wang, Huichao and Zhou,
   Jianjie and Yu, Wei},
Title = {The energy and time saving coordinated control methods of
   CO2, VOCs, and PM2.5 in office buildings},
Journal = {PLOS ONE},
Year = {2022},
Volume = {17},
Number = {9},
Month = {SEP 27},
Abstract = {Indoor air pollution is complex and serious. In fact, an on-site
   investigation of an office building revealed that the concentration of
   three typical pollutants (CO2, VOCs, PM2.5) exceeded the Chinese
   standard. To identify a better control method to achieve good indoor air
   quality, an orthogonal experiment was carried out in an environmental
   chamber to compare the control time and energy consumption of four
   control methods (purifier+ and window+, purifier+ and window-, purified
   fresh air 240 m(3)/h and purified fresh air 400 m(3)/h) to meet the
   standard established for pollutants. The purifier+ and window+ method
   was found to be more effective in most conditions, with a control time
   reduced by 8.06\% and energy consumption reduced by 11.91\% compared
   with the traditional control method of purified fresh air 240 m(3)/h.
   This research highlights the optimal control strategy for the air
   quality in office buildings under different pollution conditions.},
