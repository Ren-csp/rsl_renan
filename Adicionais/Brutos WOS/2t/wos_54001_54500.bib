@article{ WOS:000463313200021,
Author = {Wang, S. and Han, Z. and Libri, D. and Porrua, O. and Strick, T. R.},
Title = {Single-molecule characterization of extrinsic transcription termination
   by Sen1 helicase},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {APR 4},
Abstract = {Extrinsic transcription termination typically involves remodeling of RNA
   polymerase by an accessory helicase. In yeast this is accomplished by
   the Sent helicase homologous to human senataxin (SETX). To gain insight
   into these processes we develop a DNA scaffold construct compatible with
   magnetic-trapping assays and from which S. cerevisiae RNA polymerase II
   (Pol II), as well as E. coli RNA polymerase (ecRNAP), can efficiently
   initiate transcription without transcription factors, elongate, and
   undergo extrinsic termination. By stalling Pol II TECs on the construct
   we can monitor Sent-induced termination in real-time, revealing the
   formation of an intermediate in which the Pol II transcription bubble
   appears half-rewound. This intermediate requires similar to 40 sec to
   form and lasts similar to 20 sec prior to final dissociation of the
   stalled Pol II. The experiments enabled by the scaffold construct permit
   detailed statistical and kinetic analysis of Pol II interactions with a
   range of cofactors in a multi-round, high-throughput fashion.},
