@article{ WOS:000245661400003,
Author = {Levine, Lindsay R. and Morsella, Ezequiel and Bargh, John A.},
Title = {The perversity of inanimate objects: Stimulus control by incidental
   musical notation},
Journal = {SOCIAL COGNITION},
Year = {2007},
Volume = {25},
Number = {2},
Pages = {267-283},
Month = {APR},
Abstract = {Social cognition research suggests that incidental, environmental
   stimuli (e.g., business suits) can nonconsciously influence the degree
   to which behavioral dispositions (e.g., competitiveness) are expressed.
   Similarly, cognitive research suggests that incidental action-related
   objects (e.g., hammers) can prime action plans that then affect the
   speed with which a concurrent, intended action (e.g., power grip) is
   executed. However, whether incidental stimuli can instigate actions that
   run counter to one's current goals has yet to be determined. Moving
   beyond indirect effects, we show that such stimuli can directly cause
   the expression of undesired actions: Incidental stimuli resembling
   musical notation caused the systematic expression of unintended key
   presses in musicians, but not in nonmusicians. Moreover, the effect was
   found even when targets and distracters bore no apparent perceptual or
   semantic relation. We discuss the implications of these findings for
   models of action production and for social-cognitive concepts (e.g.,
   applicability) regarding the limits of nonconscious processing.},
Publisher = {GUILFORD PUBLICATIONS INC},
Address = {370 SEVENTH AVE, SUITE 1200, NEW YORK, NY 10001-1020 USA},
