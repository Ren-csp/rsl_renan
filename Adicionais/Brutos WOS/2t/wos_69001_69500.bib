@article{ WOS:000903179500001,
Author = {Gianni, Giovanna Bagnasco and Garzulino, Andrea and Marzullo, Matilde
   and Pernigotti, Antonio Paolo},
Title = {A Biography of an Ancient Cultural Landscape: The Sky over Tarquinia},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {24},
Month = {DEC},
Abstract = {This paper discusses two kinds of research implemented to federate
   different disciplines and knowledge in support of archaeological
   research and the protection of the tangible and intangible heritage of
   ancient Tarquinia. The first part of the work examines the results
   obtained from the archaeological analysis, the concrete implications on
   the sustainability of ancient cultural landscapes and their possible
   transmission over time as an expression of the culture of a community.
   The second part of the work presents the reading and analysis of the
   ancient landscape and sites through chrono-stratigraphy, especially
   regarding two case studies in Tarquinia: the `monumental complex' and
   the Ara della Regina sanctuary. The work focuses on the intangible
   aspects of the landscape as a result of archaeological research in the
   archaeoastronomical field. The orientation of the sacred structures and
   landscapes is presented herein regarding Etruria and the two case
   studies. The results shed light on the city's perception by the
   population, identifying it as an entity that held and sheltered every
   aspect of the community's life. The preliminary results of this study
   have made it possible to recognise aspects of significant historical and
   cultural value, which are the heterogeneous expression of a solid
   identity to be safeguarded and developed in a sustainable way.},
