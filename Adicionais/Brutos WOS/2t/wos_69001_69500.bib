@article{ WOS:001504787000001,
Author = {Hoppe, Janna and Trondle, Tim and Patt, Anthony},
Title = {``I didn't like them from the beginning, and I hate them now.{''}
   Changes in attitudes towards electric vehicles and phase-out policies
   for conventional cars},
Journal = {ENERGY POLICY},
Year = {2025},
Volume = {205},
Month = {OCT},
Abstract = {Achieving climate neutrality requires the widespread replacement of
   carbon-intensive technologies with lowcarbon alternatives. For
   transport, this primarily means phasing out internal combustion engine
   vehicles (ICEVs) and scaling up climate-friendly modes of transport,
   such as electric vehicles (EVs). Public support is a key determinant of
   the likelihood of technology adoption and the feasibility of any climate
   policy. Although it is often studied at a single point in time, it is
   responsive to changes in the socio-political or techno-economic
   environment. In this study, we investigated citizens' attitudes towards
   EVs, ICEVs, and ICEV phase-out policies between 2021 and 2024 in
   Australia, Germany, and the United Kingdom (N = 14,090) using a repeated
   cross-sectional survey design. Given significant advancements in EV
   technology and infrastructure, as well as rising concerns about climate
   change, we hypothesised that EVs would be viewed increasingly positively
   and ICEVs increasingly negatively - and that these two trends would
   positively influence the acceptability of ICEV phase-out policies.
   Contrary to our expectations, support for ICEV phase-out policies
   declined notably in all countries. Perceptions of EVs became more
   negative, as highlighted by the statement of one respondent in the
   title, while ICEVs gained support. Nevertheless, technology-specific
   beliefs, such as a technology's contribution to climate change or its
   role in providing jobs and economic stability, were strongly associated
   with policy support. Finally, we found no evidence for the existence of
   a positive social influence or familiarity effect. These findings
   caution against blindly relying on positive feedback effects to
   accelerate the energy transition, and call for policies that recognize
   the complexities of public opinion as a potential transition barrier.},
Publisher = {ELSEVIER SCI LTD},
