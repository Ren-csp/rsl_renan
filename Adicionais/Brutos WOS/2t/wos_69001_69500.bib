@article{ WOS:000798347800023,
Author = {Balderas, Enrique and Eberhardt, David R. and Lee, Sandra and Pleinis,
   John M. and Sommakia, Salah and Balynas, Anthony M. and Yin, Xue and
   Parker, Mitchell C. and Maguire, Colin T. and Cho, Scott and Szulik,
   Marta W. and Bakhtina, Anna and Bia, Ryan D. and Friederich, Marisa W.
   and Locke, Timothy M. and Van Hove, Johan L. K. and Drakos, Stavros G.
   and Sancak, Yasemin and Tristani-Firouzi, Martin and Franklin, Sarah and
   Rodan, Aylin R. and Chaudhuri, Dipayan},
Title = {Mitochondrial calcium uniporter stabilization preserves energetic
   homeostasis during Complex I impairment},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {MAY 19},
Abstract = {Mitochondrial complex I deficiency is frequent in congenital, neurologic
   and cardiovascular disease. Here the authors demonstrate that Complex I
   stimulates the turnover of a mitochondrial calcium channel, which
   becomes stabilized during Complex I deficiency, preserving energetic
   homeostasis.
   Calcium entering mitochondria potently stimulates ATP synthesis.
   Increases in calcium preserve energy synthesis in cardiomyopathies
   caused by mitochondrial dysfunction, and occur due to enhanced activity
   of the mitochondrial calcium uniporter channel. The signaling mechanism
   that mediates this compensatory increase remains unknown. Here, we find
   that increases in the uniporter are due to impairment in Complex I of
   the electron transport chain. In normal physiology, Complex I promotes
   uniporter degradation via an interaction with the uniporter pore-forming
   subunit, a process we term Complex I-induced protein turnover. When
   Complex I dysfunction ensues, contact with the uniporter is inhibited,
   preventing degradation, and leading to a build-up in functional
   channels. Preventing uniporter activity leads to early demise in Complex
   I-deficient animals. Conversely, enhancing uniporter stability rescues
   survival and function in Complex I deficiency. Taken together, our data
   identify a fundamental pathway producing compensatory increases in
   calcium influx during Complex I impairment.},
