@article{ WOS:000561246500001,
Author = {Kujawska, Monika and Zamudio, Fernando and Alban-Castillo, Joaquina and
   Sosnowska, Joanna},
Title = {The Relationship between a Western Amazonian Society and Domesticated
   Sedges (Cyperusspp.)},
