@article{ WOS:001527119400006,
Author = {Schopp, Kerstin},
Title = {Insights from agroecological smallholder farmers on the slopes of Mount
   Meru and Mount Kilimanjaro, Tanzania},
Journal = {GAIA-ECOLOGICAL PERSPECTIVES FOR SCIENCE AND SOCIETY},
Year = {2025},
Volume = {34},
Number = {2},
Abstract = {The relational valuation of nature, as practiced in the Global South, is
   explored to identify how Global North actors can build on this form of
   knowledge to strengthen sustainable development in the agricultural
   sector. The modern, mainstream Global North focus is based on
   instrumental, ratherthan relational, values. Relational values of nature
   are introduced with the IPBES life frames of ``living from/in/with/as
   nature{''} and integrate Global South visions. The study considers the
   case of agroecological smallholder farmers in Tanzania on the slopes of
   Mount Meru and Mount Kilimanjaro. Based on qualitative research, two
   ways of valuing nature are identified: ``nature as basis for
   survival{''} and ``nature as subject and basis for being a farmer{''}.
   Global North actors can build on Global South perspectives, regarding
   ideas of interactions with their environment and both can mutually
   inform their perspectives when it comes to recognizing the
   interdependencies of (non-)human life and animal rights, and linking
   academic and local knowledge. Research is needed to determine whether
   the globalized economic perspective ofthe Global North could be
   broadened with these perspectives.},
Publisher = {OEKOM VERLAG GMBH},
Address = {GOETHESTRASSE 28, MUNICH, 80336, GERMANY},
Type = {Article},
Language = {English},
