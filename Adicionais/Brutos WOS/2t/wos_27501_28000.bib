@article{ WOS:001567627100001,
Author = {Rosso, Andrea and Karen, Fortuin and Melis, Giulia and Pensa, Stefano},
Title = {Women-friendly bike infrastructures in Turin: assessing requirements for
   a gender-inclusive bike system and its potential environmental impact},
Journal = {PLANNING PRACTICE AND RESEARCH},
Year = {2025},
Volume = {40},
Number = {6},
Pages = {1287-1311},
Month = {NOV 2},
Abstract = {Cities have seen rising interest in cycling, yet planning often neglects
   accessibility for women. To address this knowledge gap, this paper
   provides a holistic perspective of women's cycling mobility in Turin,
   examining its social and environmental implications through the lens of
   spatial justice. Using questionnaires, field-observations and vehicle
   emission factors, it reveals women's perceptions of cycling, identifies
   barriers, and proposes design strategies for inclusive bike systems. It
   highlights environmental benefits of reduced air pollution and advocates
   gender-sensitive planning. The findings contribute to developing a
   socially inclusive and sustainable transport system for everyone,
   aligned with Goal 11 of Sustainable Development Goals.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
