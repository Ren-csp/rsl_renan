@article{ WOS:001813114000001,
Author = {Kambiet, Perez L. Kemeni and Ongoma, Victor and Molua, Ernest L. and
   Achli, Soumia and Martinez-Cruz, Adan L. and Chfadi, Tarik and El
   Ayoubi, Hachim and Chehbouni, Abdelghani},
Title = {From climate experience to public policy support: Insights from 15
   African countries},
Journal = {CURRENT RESEARCH IN ENVIRONMENTAL SUSTAINABILITY},
Year = {2026},
Volume = {12},
Abstract = {Achieving public support is crucial for the successful and sustained
   implementation of climate policies. Yet, the factors driving public
   support remain underexplored in developing countries. This study
   investigates the role of climate perception, its drivers, and their
   association with public support for climate policies in Africa. Using
   regression estimation approaches on a large multi-dimensional dataset
   from 15 diverse countries, we find that perception operates through
   segmented, heterogeneous pathways to drive public climate policy
   support. Results show that prior climate extremes experiences and
   perceived community action are the most consistent drivers of both
   perception and public support. The findings also uncover an experiential
   gap and highlight how the dual mechanism that links concern and
   perception drivers to policy support breaks down for populations with no
   direct climate extremes experience. Furthermore, results show a
   non-linear relationship between vulnerability knowledge, climate
   perception, and public support, suggesting its effect can either
   accelerate or deter perception depending on the level of climate extreme
   experiences. By highlighting the specific mechanisms through which
   perception influences action, our findings offer valuable insights for
   the design and communication of more effective, targeted, and
   community-led climate policies in African countries.},
