@article{ WOS:001498152600001,
Author = {Scrutton, Roger},
Title = {Students' perceptions of their personal effectiveness in life: context
   for the delivery of residential outdoor education courses},
Journal = {JOURNAL OF ADVENTURE EDUCATION AND OUTDOOR LEARNING},
Year = {2026},
Volume = {26},
Number = {3},
Pages = {622-638},
Month = {JUL 3},
Abstract = {Residential outdoor education is credited with developmental benefits
   for young people, going beyond benefits from everyday experiences. In
   evaluating benefits, quantitative studies are typically
   quasi-experimental, measuring effect size between self-report scores in
   pre- and post-tests using an appropriate questionnaire. However, very
   rarely published is the rank order of mean scores on the questionnaire's
   factors in tests. Here, factor rank orders from studies using the Review
   of Personal Effectiveness are interpreted. Studies involve students from
   10 to 20 years in age, males and females, several intervention types and
   different countries, yet rank orders are remarkably similar, with
   Quality Seeking and Active Initiative at the top and Stress Management
   and Self-efficacy at the bottom. This is interpreted as students
   perceiving greater effectiveness in aspects of achievement - academic or
   otherwise - than in their personal and social abilities. It is suggested
   that this pattern lies behind the delivery of residential outdoor
   education.},
