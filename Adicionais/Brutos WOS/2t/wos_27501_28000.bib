Author = {Plowens, Gabrielle},
Title = {Aotearoa's Western governance structure: a challenge to Te Kōpuka's
   allyships},
Journal = {ALTERNATIVE-AN INTERNATIONAL JOURNAL OF INDIGENOUS PEOPLES},
Year = {2024},
