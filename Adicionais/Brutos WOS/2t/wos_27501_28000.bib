@article{ WOS:001842735800001,
Author = {Tulloch, Michelle K. and Wurzer-Mulders, Maartje D. G. H. and Gronhoj,
   Alice and Aschemann-Witzel, Jessica},
Title = {What you see is what you get? The transition to more plant-based eating
   in Denmark according to one's own perception of fictional others},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {114},
Month = {SEP},
Abstract = {Today's grand challenges require rapid and transformative change in
   society. Individual behavior change might be driven or hindered by the
   change or stability of social norms and stereotypes. Here, we took the
   case of dietary behaviors and explored the perceptions of another's
   likelihood to eat more plant-rich in the near future. Quantitative and
   qualitative data was gathered at three time points between 2021 and 2024
   with a representative sample of 3688 Danish participants. Against our
   expectations, there were no changes over time. Barriers to change
   included tradition and health, whereas environmental motives were a
   strong driver. One's current or planned behavior had no relationship to
   the assessment of another person's behavior, unless they were similar to
   this other person. Findings underline the stability of stereotypes,
   while also stressing how important interpersonal experiences are within
   this green transition.},
