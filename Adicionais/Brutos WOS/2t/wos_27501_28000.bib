@article{ WOS:001270691200003,
Author = {Toplak, Cirila},
Title = {ELEMENTAL POLITICS BETWEEN MINORITARIANISM AND LIVE DEMOCRACY - A Case
   Study of the Soča River Basin},
Journal = {TEORIJA IN PRAKSA},
Year = {2024},
Volume = {61},
Number = {2},
Abstract = {Human interaction combined with natural elements makes water, air,
   earth/soil and fire inherently political. Access to the elements and the
   way they are treated cause fundamental injustices and inequalities
   between living beings, yet at the same time the elements are recognised
   for their importance for the well-being and prosperity of human
   societies and ecosystems. After reviewing relevant analogical
   literature, the author theorises elemental politics, elemental
   democracy, elemental justice, and elemental citizenship. Based on a case
   study of past and recent elemental politics pertaining to the Soda River
   basin and the natureculture of the Nature Worshippers of Primorska, the
   author argues there is a need for a thorough reconsideration of natural
   elements, especially of their holism, in view of the elemental legal and
   political subjectivity. The latter might be achieved with the use of a
   modified elemental vocabulary and collective imaginary inspired by both
   naturecultures' ontologies and recent theories on glocalism.},
