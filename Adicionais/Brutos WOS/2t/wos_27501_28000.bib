@article{ WOS:000783129000001,
Author = {Machado, Luca Del Fabbro and Venudo, Adriano and Altobelli, Alfredo and
   Bertuzzi, Jennifer and Zampieri, Francesca and Gatti, Angela},
Title = {Ecopolitana: A Plan of Cities, Territory, Landscape, and Ecology},
