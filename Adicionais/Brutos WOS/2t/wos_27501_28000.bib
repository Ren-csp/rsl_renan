@article{ WOS:001401985100001,
Author = {Zhou, Jia and Noviello, Colleen M. and Teng, Jinfeng and Moore, Haley
   and Lega, Bradley and Hibbs, Ryan E.},
Title = {Resolving native GABAA receptor structures from the human
   brain},
