
@article{ WOS:000183310200004,
Author = {de Man, AF and Wong, IN and Leung, PWL},
Title = {Perceived parental favoritism and suicidal ideation in Hong Kong
   adolescents},
Journal = {SOCIAL BEHAVIOR AND PERSONALITY},
Year = {2003},
Volume = {31},
Number = {3},
Pages = {245-251},
Abstract = {Chinese adolescents from Hong Kong (N = 317) participated in a study of
   the relationship between perceived parental favoritism in terms of
   affection and control, and suicidal ideation. Correlation analyses
   showed that adolescents who believed that children in their families
   were treated differently in terms of affection and control by their
   mothers and fathers reported greater suicidal ideation; whether they
   personally were the favored or nonfavored children made no difference.
   Stepwise multiple regression analysis identified perceived differential
   maternal affection as the best predictor of suicidal ideation.},
