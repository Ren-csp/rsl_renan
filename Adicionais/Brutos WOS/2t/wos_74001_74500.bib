@article{ WOS:000328380000004,
Author = {Herberstein, Marie E. and Baldwin, Heather J. and Gaskett, Anne C.},
Title = {Deception down under: is Australia a hot spot for deception?},
Journal = {BEHAVIORAL ECOLOGY},
