Title = {Pine Forest Management and Disturbance in Northern Poland: Combining
   High-Resolution 100-Year-Old Paleoecological and Remote Sensing Data},
Journal = {FRONTIERS IN ECOLOGY AND EVOLUTION},
Year = {2021},
Volume = {09},
