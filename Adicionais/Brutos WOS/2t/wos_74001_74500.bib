@article{ WOS:000315974500008,
Author = {Balica, S. F. and Popescu, I. and Beevers, L. and Wright, N. G.},
Title = {Parametric and physically based modelling techniques for flood risk and
   vulnerability assessment: A comparison},
Journal = {ENVIRONMENTAL MODELLING \& SOFTWARE},
Year = {2013},
Volume = {41},
Pages = {84-92},
Month = {MAR},
Abstract = {Floods are one of the most common and widely distributed natural risks
   to life and property. There is a need to identify the risk in
   flood-prone areas to support decisions for risk management, from
   high-level planning proposals to detailed design. There are many methods
   available to undertake such studies. The most accepted, and therefore
   commonly used, of which is computer-based inundation mapping. By
   contrast the parametric approach of vulnerability assessment is
   increasingly accepted. Each of these approaches has advantages and
   disadvantages for decision makers and this paper focuses on how the two
   approaches compare in use. It is concluded that the parametric approach,
   here the FVI, is the only one which evaluates vulnerability to floods;
   whilst although the deterministic approach has limited evaluation of
   vulnerability, it has a better science base. (c) 2012 Elsevier Ltd. All
   rights reserved.},
