   Hayes, Spencer J.; Dutoy, Chris A.; Elliott, Digby; Bennett, Simon J., Liverpool John Moores Univ, Fac Sci, Res Inst Sport \& Exercise Sci, Brain \& Behav Lab, Byrom St, Liverpool L3 3AF, Merseyside, England.
   Gowen, Emma, Univ Manchester, Fac Life Sci, Manchester, Lancs, England.},
DOI = {10.1016/j.actpsy.2015.10.005},
ISSN = {0001-6918},
EISSN = {1873-6297},
