@article{ WOS:001724069300001,
Author = {Felippi, Daniel Angelo and Manzano, Maria Carolina Rodella and Franco,
   Paolla Nicole and Pereira, Vinicius Jose Alves and Teixeira, Joao Vitor
   Medeiros and Machado, Joao Pedro Fernandes and Rezende, Gabriela Cabral},
Title = {Arboreal Camera Trap-based Insights into the Activity, Resource Use, and
   Demography of Black Lion Tamarins (Leontopithecus chrysopygus)
   and Sympatric Mammals in Atlantic Forest Fragments},
Journal = {INTERNATIONAL JOURNAL OF PRIMATOLOGY},
Year = {2026},
Volume = {47},
Number = {2},
Pages = {499-524},
Month = {APR},
Abstract = {Wildlife monitoring is essential for guiding biodiversity conservation
   strategies, particularly in fragmented ecosystems under intense
   anthropogenic pressure. While noninvasive methods, such as camera traps,
   are widely used for terrestrial species, their application in other
   forest strata is underexplored despite its potential for studying
   elusive and nocturnal arboreal mammals. We aim to evaluate whether
   arboreal camera trapping is a relevant tool for monitoring the
   endangered black lion tamarin (Leontopithecus chrysopygus) and other
   sympatric arboreal and scansorial mammals in two Atlantic Forest
   remnants in Pontal do Paranapanema, S \& atilde;o Paulo, Brazil. With 27
   cameras in the lower and mid-canopy (0.5-8.0 m) and 9,872 camera-days,
   we recorded 1,316 independent video events representing seven species of
   mammal. Arboreal camera traps provided robust estimates of diel activity
   patterns, resource partitioning, and demographic dynamics, including the
   development of one tamarin infant and one juvenile over time. They also
   revealed interspecific sharing of sleeping sites and nest boxes,
   emphasizing the role of these structures in supporting both diurnal and
   nocturnal species. By documenting community-wide temporal niche
   partitioning, our study demonstrates how arboreal and scansorial mammals
   segregate activity in time when sharing the same arboreal structures.
   Overall, our results show that arboreal camera traps are relevant,
   noninvasive tool that simultaneously capture species-specific behavior,
   community-level interactions, and demographic information, highlighting
   their value for primatology, biodiversity monitoring, and integrative
   conservation planning in human-modified tropical forests.
   O monitoramento da vida selvagem \& eacute; essencial para orientar
   estrat \& eacute;gias de conserva \& ccedil;\& atilde;o da
   biodiversidade, particularmente em ecossistemas fragmentados sob intensa
   press \& atilde;o antr \& oacute;pica. Embora m \& eacute;todos n \&
   atilde;o invasivos, como armadilhas fotogr \& aacute;ficas, sejam
   amplamente utilizados para esp \& eacute;cies terrestres, sua aplica \&
   ccedil;\& atilde;o nas camadas superiores da floresta permanece pouco
   explorada, apesar de seu potencial para estudar mam \& iacute;feros
   arbor \& iacute;colas elusivos e noturnos. Aqui, pretendemos avaliar se
   o uso de armadilhas fotogr \& aacute;ficas arb \& oacute;reas \& eacute;
   relevante para o monitoramento do mico-le \& atilde;o-preto
   (Leontopithecus chrysopygus), esp \& eacute;cie amea \& ccedil;ada de
   extin \& ccedil;\& atilde;o, e de outros mam \& iacute;feros arbor \&
   iacute;colas e escansoriais simp \& aacute;tricos em dois remanescentes
   de Mata Atl \& acirc;ntica em Pontal do Paranapanema, S \& atilde;o
   Paulo, Brasil. A partir de 27 c \& acirc;meras instaladas no dossel
   inferior e m \& eacute;dio (0,5-8,0 m) e 9.872 dias de coleta,
   registramos 1.316 eventos de v \& iacute;deo independentes representando
   7 esp \& eacute;cies de mam \& iacute;feros. As armadilhas fotogr \&
   aacute;ficas instaladas em \& aacute;rvores forneceram estimativas
   robustas de padr \& otilde;es de atividade, parti \& ccedil;\& atilde;o
   de recursos e din \& acirc;mica demogr \& aacute;fica, incluindo o
   desenvolvimento de um filhote e um juvenil de mico-le \& atilde;o-preto
   ao longo do tempo. Elas tamb \& eacute;m revelaram o compartilhamento
   interespec \& iacute;fico de locais de descanso e caixas-ninho,
   enfatizando o papel dessas estruturas no suporte de esp \& eacute;cies
   diurnas quanto noturnas. Ao documentar a parti \& ccedil;\& atilde;o
   temporal de nicho em toda a comunidade, nosso estudo demonstra como mam
   \& iacute;feros arbor \& iacute;colas e escansoriais segregam suas
   atividades no tempo quando compartilham as mesmas estruturas arb \&
   oacute;reas. No geral, nossos resultados mostram que as armadilhas
   fotogr \& aacute;ficas arb \& oacute;reas s \& atilde;o uma ferramenta
   relevante e n \& atilde;o invasiva que captura simultaneamente
   comportamentos espec \& iacute;ficos das esp \& eacute;cies, intera \&
   ccedil;\& otilde;es em n \& iacute;vel de comunidade e informa \&
   ccedil;\& otilde;es demogr \& aacute;ficas, destacando seu valor para a
   primatologia, o monitoramento da biodiversidade e o planejamento
   integrado de conserva \& ccedil;\& atilde;o em florestas tropicais
   modificadas pela a \& ccedil;\& atilde;o humana. A editora n \& atilde;o
   revisou a tradu \& ccedil;\& atilde;o do resumo.},
