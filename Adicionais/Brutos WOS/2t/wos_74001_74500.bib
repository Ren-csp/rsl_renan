   Ghanimeh, S., Qatar Univ, Environm Sci Ctr, Doha, Qatar.
   Hamdi, H., Qatar Univ, Coll Arts \& Sci, Ctr Sustainable Dev, Doha, Qatar.
   Fares, N.; Mansour, N.; Naccache, H., Qatar Univ, Coll Educ, Doha, Qatar.
   Pano, N., Lebanese Univ, Doctoral Sch Sci \& Technol, Dept Fundamental \& Appl Earth \& Environm Sci, Beirut, Lebanon.},
DOI = {10.1088/2515-7620/ae2241},
Article-Number = {125013},
ISSN = {2515-7620},
