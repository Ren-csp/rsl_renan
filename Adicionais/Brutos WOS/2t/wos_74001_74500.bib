@article{ WOS:000375378400006,
Author = {Field, H. E. and Smith, C. S. and de Jong, C. E. and Melville, D. and
   Broos, A. and Kung, N. and Thompson, J. and Dechmann, D. K. N.},
Title = {Landscape Utilisation, Animal Behaviour and Hendra Virus Risk},
