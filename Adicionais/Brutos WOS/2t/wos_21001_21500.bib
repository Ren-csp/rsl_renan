@article{ WOS:001824223000008,
Author = {Usak, Metin Ceylan},
Title = {The turks' relationship with the persian language and literature
   throughout their historical development up to the end of the 13th
   century},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {115},
Month = {JUL},
Abstract = {The Turks, who originated in Central Asia, are one of the peoples who
   have spread across vast regions by migrating to different parts of the
   world throughout history. During this process, driven by historical,
   human, and climatic necessities, the Turks established contact with
   various societies and civilizations and adopted many different
   alphabets, languages, and religions. Their adoption of Islam was
   accelerated by their employment as soldiers in the Islamic world and the
   more peaceful policies of the Abbasids. In this study, the nature and
   consequences of the Turks' interaction with the Persian language and
   literature were investigated using a literature review method. The study
   is limited to an examination of the Samanid, Qarakhanid, Ghaznavid,
   Seljuk, and Khwarazmian periods. The research has led to the following
   conclusion: In the state administrations they established, the Turks
   adopted Arabic and Persian as languages of science, art, and literature.
   While this helped them develop their own language and literature, it
   also brought about positive contributions, particularly to the Persian
   language and literature. The Transoxiana (M \& acirc;ver \& acirc;\&
   uuml;nnehir) region is one of the areas where Turks demonstrated
   development in the fields of science and art. From this region onwards,
   until the Turks settled in Anatolia, Turkic rulers and administrators
   ensured the preservation and development of the Persian language and
   literature by using it in official state correspondence. The inclusion
   of brief historical information regarding the establishment and
   development of Turkic states in this study aims to facilitate a better
   understanding of the historical relationship between the Turks and the
   Persian language and literature.},
