@article{ WOS:001850911100001,
Author = {van der Werff, Ellen and Jans, Lise and Maltagliati, Irene},
Title = {The signalling value of subsidies to promote pro-environmental behaviour},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2026},
Volume = {114},
Month = {SEP},
Abstract = {To reduce environmental problems, top-down policies such as subsidies
   aim to encourage pro-environmental behaviour. In addition to its direct
   effects on the targeted behaviour, subsidies may also have indirect
   effects on behaviour through changes in perceived social norms. In the
   current paper, we systematically test if governmental or organizational
   subsidies to encourage pro-environmental behaviour, change social norm
   perceptions. We hypothesised that a pro-environmental subsidy 1)
   increases the perceived approval of the targeted behaviour (injunctive
   norm) by the implementer of the policy, but not the general public; 2)
   increases the perceived descriptive norm that most people currently do
   not engage in the targeted pro-environmental behaviour; and 3) increases
   the perception that more and more people adopt the targeted behaviour
   (dynamic norm). We further hypothesised that these norms together
   explain the relationship between the subsidy and pro-environmental
   behaviour. Three studies supported subsidies' potential to signal norms.
   Specifically, in Studies 1A-B, dynamic norms mediate the relation
   between subsidy awareness and behaviour, whereas we do not find strong
   support for subsidies signalling injunctive or descriptive norms. Study
   2, a quasi-experiment, showed that at universities with (versus without)
   a sustainable travel subsidy, perceived injunctive university norms (but
   none of the other norms) mediate the relation between subsidy presence
   and behaviour. Furthermore, those aware (versus unaware) of the subsidy
   rated dynamic norms (but none of the other norms) as higher, mediating
   the relation between policy awareness and behaviour. Together, these
   results point to the potential of subsidies to signal norms, having
   important theoretical and practical implications for top-down policies'
   ability to further societal change.},
