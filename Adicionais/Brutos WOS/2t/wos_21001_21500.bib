@article{ WOS:000379663700002,
Author = {Robert, Kylie A. and Lesku, John A. and Partecke, Jesko and Chambers,
   Brian},
Title = {Artificial light at night desynchronizes strictly seasonal reproduction
   in a wild mammal},
Journal = {PROCEEDINGS OF THE ROYAL SOCIETY B-BIOLOGICAL SCIENCES},
Year = {2015},
Volume = {282},
Number = {1816},
Month = {OCT 7},
Abstract = {Change in day length is an important cue for reproductive activation in
   season ally breeding animals to ensure that the timing of greatest
   maternal investmen (e.g. lactation in mammals) coincides with favourable
   environmental conch lions (e.g. peak productivity). However, artificial
   light at night has the potential to interfere with the perception of
   such natural cues. Following a 5-year study on two populations of wild
   marsupial mammals expo to different night-time levels of an genic light,
   we show that light pollution in urban environments masks seasonal in
   ambient light cues, suppressing melatonin levels and delaying births in
   the taimnar wallaby. These result highlight a previously unappreciated
   relationship linking artificial light a night with induced changes in
   mammalian reproductive physiology, and the potential for larger-scale
   impacts at the population level.},
