Month = {JAN-APR},
Abstract = {The paper analyzes the way in which raramuri women, when resorting to
   the cultural dimension of ethnicity, are opening new spaces for
   participation in the collective life of the settlements located in the
   Chihuahua City, favoring their positioning in various political and
   ritual positions that have been the prerogative of men. Assuming these
   responsibilities not only guarantees membership and affiliation to the
   group, but also certain spaces of gender equality, thus demonstrating
   the ability they have to make decisions about a repertoire of their own
   cultural elements.},
