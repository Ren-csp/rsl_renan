@article{ WOS:000373800600093,
Author = {Radulescu, Corina M. and Stefan, Ovidiu and Radulescu, Gheorghe M. T.
   and Radulescu, Adrian T. G. M. and Radulescu, Mihai V. G. M.},
Title = {Management of Stakeholders in Urban Regeneration Projects. Case Study:
   Baia-Mare, Transylvania},
