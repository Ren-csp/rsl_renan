@article{ WOS:001743548500001,
Author = {Sanchez-Sepulveda, V, Monica and Navarro, Joan and Fonseca, David and
   Amo-Filva, Daniel},
Title = {Sustainable Urban Mobility through Open Data Repositories and Data
   Analytics: Improving Walkability and Cyclability in Barcelona},
Journal = {ACE-ARCHITECTURE CITY AND ENVIRONMENT},
Year = {2025},
Volume = {20},
Number = {59},
Month = {OCT},
Abstract = {Urbanization and climate change challenge urban mobility in large
   cities. Barcelona, as a case study in the Acciona y Conecta project,
   funded by the City Council, addressed these challenges through an
   analysis of its infrastructure to promote sustainable, safe and
   equitable mobility. The study used open data and data science and mining
   techniques to assess key factors such as the quality of sidewalks,
   traffic, pollution and road safety, critical elements for walkability
   and cyclability. This analysis fed artificial intelligence algorithms
   that classified urban stretches according to accessibility and safety
   for pedestrians and cyclists. The results produced a detailed
   categorization of the infrastructure, identifying areas of risk and
   opportunity. A publicly accessible interactive dashboard allows these
   metrics to be visualized, helping urban planners and authorities to
   design strategies that promote active mobility and reduce the impact of
   motorized transport. This approach not only improves quality of life and
   green infrastructure, but also mitigates the effects of climate change.
   The developed tool has been replicated in Helsinki and Madrid,
   demonstrating its adaptability and promoting global sustainable urban
   policies. In addition, the study revealed the correlation between
   pedestrian infrastructure, economic activity and accidents, proposing
   specific interventions to reduce risks. This innovative model redefines
   urban planning, providing practical solutions to create more resilient
   and sustainable cities.},
