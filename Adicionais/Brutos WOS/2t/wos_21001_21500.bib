@article{ WOS:000726828900001,
Author = {Gao, Hui and Yang, Lutong and Zhang, Anyue and Sheng, Mingxin},
Title = {Analysis of Urban Electric Vehicle Trip Rule Statistics and Ownership
   Prediction},
