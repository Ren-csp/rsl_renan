@article{ WOS:000393200200002,
Author = {Miranda Chacon, Zaray de los Angeles},
Title = {Construction of Knowledge in Higher Education Students: Reflection
   through Biological and Social Nature of the Students},
Journal = {REVISTA EDUCACION},
