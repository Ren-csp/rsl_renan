@article{ WOS:001715354900001,
Author = {Mardesic, Ivana and Salpeteur, Matthieu and Cesaro, Jean-Daniel},
Title = {Perception of Rangeland Degradation in Mongolia: The Role of Herder
   Groups and Local Ecological Knowledge},
Journal = {RANGELAND ECOLOGY \& MANAGEMENT},
Year = {2026},
Volume = {106},
Pages = {37-52},
Month = {MAY},
Abstract = {Local ecological knowledge is increasingly recognized for its potential
   contribution to the understanding of environmental changes, in
   complement to instrumental data. However, some studies point out that
   people can be exposed to external sources of knowledge, which may affect
   their perceptions. Here, we contribute to the debate by analyzing how
   local communities, namely Mongolian pastoralists, perceive changes in
   environmental conditions, how it relates to changes assessed through
   other means, and by identifying drivers that shape this perception.
   Through comprehensive surveys in two districts of Mongolia, one with
   pasture user groups (PUGs), and another without, we analyze the role
   played by those institutions on local perceptions. We find that herders'
   observations of rangeland degradation from the PUG district do not
   differ from the other one, but that herders who are active in PUGs are
   more prone to perceiving rangeland degradation. In other words, we find
   that PUGs are associated with higher awareness of environmental change
   but that they do not alter the nature of local indicators of change. In
   addition, a comparison of herders' reports with other existing
   instrumental data shows that normalized difference vegetation index
   alone does not seem to be a relevant tool to assess early-stage
   rangeland degradation in this area. (c) 2026 The Authors. Published by
   Elsevier Inc. on behalf of The Society for Range Management. This is an
   open access article under the CC BY-NC-ND license (
   http://creativecommons.org/licenses/by-nc-nd/4.0/ )},
