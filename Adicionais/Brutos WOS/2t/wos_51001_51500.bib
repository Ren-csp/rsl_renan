@article{ WOS:001352094900001,
Author = {Colmenares-Cruz, Ramiro Andres and Plazas-Leguizamon, Nubia Zoraida and
   Arias-Rodriguez, Luis Alejandro and Garcia-Parra, Miguel Angel and
   Moreno-Lopez, Nidia Milena and Barrera-Siabato, Andrea Isabel},
Title = {Analysis of the Development of Rural Aqueduct Organizations in the
   Central Zone of Colombia: A View from Sustainable Livelihoods},
Journal = {WATER},
Year = {2024},
Volume = {16},
Number = {21},
Month = {NOV},
Abstract = {Within the framework of sustainability analysis regarding the processes
   developed by man, water resources in rural scenarios have been a
   priority due to the impact generated by population growth and climate
   changes in tropical regions. In Colombia, the shortage of drinking water
   from aqueducts has become a problem especially in rural areas, even
   though its administration has been set and led by local community
   organizations. In this sense, in this research, the aim was to
   understand the dynamics of sustainable livelihoods in rural areas and
   their relationship with water resources in Boyac \& aacute;, Colombia.
   For this purpose, surveys were carried out in two rural aqueducts in the
   municipalities of Boyac \& aacute; and Oicat \& aacute; paying special
   attention to the variables that affect human, social, technical,
   physical, natural, and financial capital. According to the results, the
   water supplied by community organizations directly affects the daily
   activities of family units, as well as the agricultural production
   systems. In addition, significant relationships were identified between
   human and financial capital, as well as social and technical capital;
   however, population increment and the accentuation of dry seasons have
   become a threat in these regions in Colombia. In conclusion, the
   analysis of the work developed by the organizations of rural aqueducts
   allows us to understand that water plays a fundamental role in the
   construction of society.},
