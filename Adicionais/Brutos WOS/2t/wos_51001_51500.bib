   Flanagan, Sara V.; Zheng, Yan, CUNY, Sch Publ Hlth, New York, NY 10016 USA.
   Marvinney, Robert G., Maine Geol Survey, Augusta, ME 04333 USA.
   Zheng, Yan, CUNY Queens Coll, Sch Earth \& Environm Sci, Flushing, NY 11367 USA.},
DOI = {10.1016/j.scitotenv.2014.05.017},
