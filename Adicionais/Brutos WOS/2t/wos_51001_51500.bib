ISSN = {2045-2322},
Keywords = {Visual guidance; Vector force decomposition; Blind sensing technology;
   Attitude determination},
Keywords-Plus = {NEURAL-NETWORK; ALGORITHM; COMPONENTS; FORCE; MODEL; YOLO},
Research-Areas = {Science \& Technology - Other Topics},
Web-of-Science-Categories  = {Multidisciplinary Sciences},
