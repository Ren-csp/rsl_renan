@article{ WOS:001845764500001,
Author = {Surman, Vivien and Bocskei, Elvira},
Title = {The path to sustainability transition for micro-enterprises:
   Cluster-based analysis of stakeholder pressure},
Journal = {SUSTAINABLE FUTURES},
Year = {2026},
Volume = {12},
Month = {DEC},
Abstract = {The global economy is increasingly prioritizing responsible business
   conduct, emphasizing sustainability, environmental protection, and
   ethical norms. As a result, companies face growing pressure from
   stakeholders to adopt sustainability principles. This study examines how
   Hungarian micro-enterprises integrate stakeholder interests into their
   strategies, identifying which stakeholders exert sustainability
   pressure. Based on responses from 587 firms, K-means cluster analysis
   classifies them into six groups, ranging from those influenced by all
   stakeholders to those perceiving no pressure. Cluster membership
   correlates with key organizational traits, including CEO gender,
   sustainability values, and success criteria (profit-driven vs.
   sustainability-oriented). Notably, firms differ in their definitions of
   sustainability, highlighting varied perceptions and responses. Our
   findings enhance the understanding of sustainability dynamics in
   micro-enterprises, offering insights for developing competitive business
   models, shaping national regulations, and guiding policies that
   encourage sustainability in the smallest business entities.},
