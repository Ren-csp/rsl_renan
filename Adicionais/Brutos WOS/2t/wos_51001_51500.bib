@article{ WOS:001852877600001,
Author = {Gomes, Priscila S. and Rocha, Sabine B. and Grou, Carlos Eduardo V. and
   Oda, Fabricio H. and Rodrigues, Marcos Vinicius},
Title = {Wild chelonians as pets in Brazil: biological profiles and social
   drivers},
Journal = {ANAIS DA ACADEMIA BRASILEIRA DE CIENCIAS},
Year = {2026},
Volume = {98},
Number = {1},
Abstract = {Brazil harbors the world's richest biodiversity, making its native fauna
   a target for wildlife trafficking. This study aims to characterize the
   profile of chelonian species admitted to two Wildlife Screening
   Centers-CETAS in southeastern Brazil, focusing on taxonomy, demographic
   patterns, and final destination. We also adopted an ethnoherpetological
   approach to investigate public perceptions of chelonians as pets, based
   on face-to-face and online surveys conducted across Brazil. A total of
   68 chelonians from six species without legal documentation were admitted
   to the Center's facilities. Chelonoidis carbonarius was the most
   frequently admitted species (81\%) and also the most commonly reported
   pet (40\%) in the Vale do Rio Doce mesoregion, while Trachemys dorbigni
   was the most popular pet nationwide (12\%). Approximately half of the
   respondents acquired chelonians through donations and would surrender
   them to environmental agencies or zoos if no longer interested.
   Chelonian admissions at the Centers increased by 175\% over three years.
   Our findings highlight the role of social and cultural factors in
   driving the illegal trade of chelonians in Brazil, reinforcing the need
   for strengthened enforcement, clearer regulatory frameworks, including
   in digital environments, and targeted environmental education to reduce
   demand and encourage societal participation in combating wildlife
   trafficking.},
