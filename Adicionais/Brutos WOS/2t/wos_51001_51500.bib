@article{ WOS:001551828500020,
Author = {Schuster, Emma and Dashzeveg, Nurmaa K. and Tong, Fangjia and Jia, Yuzhi
   and El-Shennawy, Lamiaa and Zhang, Tong and Hoffman, Andrew D. and
   Kitata, Reta Birhanu and Kibria, Golam and Zhang, Youbin and Squires,
   Joshua R. and Zheng, Chunlei and Ramos, Erika and Taftaf, Rokana and
   Scholten, David and Almubarak, Hannah F. and Adorno-Cruz, Valery and
   Sullivan, David P. and Reduzzi, Carolina and Minor, Allegra C. and
   Purev-Ochir, William and Spahija, Sabina and Xu, Rong and Siziopikou,
   Kalliopi P. and Platanias, Leonidas C. and Shah, Ami and Muller, William
   A. and Gradishar, William J. and Cristofanilli, Massimo and Tsai,
   Chia-Feng and Shi, Tujin and Liu, Huiping},
Title = {Computational ranking identifies Plexin-B2 in circulating tumor cell
   clustering with monocytes in breast cancer metastasis},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {AUG 16},
Abstract = {Multicellular circulating tumor cell (CTC) clusters can be up to 50
   times more efficient than single CTCs in mediating viable metastasis.
   Here, combining computational ranking and functional determination, we
   identify the transmembrane protein Plexin-B2 (PLXNB2) as one of the top
   molecular targets associated with unfavorable distant metastasis-free
   survival, showing enriched expression in CTC clusters versus single CTCs
   from patients with advanced breast cancer (mostly female). Loss of
   PLXNB2 (Plxnb2) reduces the formation of homotypic tumor cell clusters
   and heterotypic tumor-myeloid cell clusters, reducing spontaneous
   metastases in female mice bearing human (mouse) breast cancer.
   Interactions of PLXNB2 with its ligands SEMA4C on tumor cells and SEMA4A
   on myeloid cells (monocytes) promote homotypic and heterotypic CTC
   cluster formation, respectively, thereby driving lung metastasis. Global
   proteomic analysis reveals downstream effectors of the PLXNB2 pathway
   associated with tumor cell clustering. Thus, PLXNB2 is a therapeutic
