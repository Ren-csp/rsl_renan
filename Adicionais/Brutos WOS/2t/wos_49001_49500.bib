@article{ WOS:001630170700016,
Author = {Yan, Yue and Yang, Sijia and Mach, Kathleen E. and Chen, Guoli and
   Degraff, David J. and Liao, Joseph C. and Wong, Pak Kin},
Title = {Microbial Product Cocktails for Personalized Cancer Immunotherapy},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {DEC},
Abstract = {The human immune system has evolved to interact with various commensal
   and pathogenic bacteria in intricate and nuanced ways. While the
   diversity of bacteria presents fundamental challenges in understanding
   immune-microbe interactions, it also offers ample opportunities for
   developing effective immunomodulatory therapies. Here we show microbial
   product cocktails as an alternative class of immunotherapy for cancer.
   Using freshly resected tumors from bladder cancer patients, an
   immuno-comparative analysis of recruitment and enhancement assay, and an
   artificial intelligence-guided optimization workflow, we establish a
   personalized platform for identifying potent microbial product cocktails
   that promote recruitment, infiltration, and activation of immune cells
   for cancer treatment. In an orthotopic mouse bladder cancer model,
   microbial product cocktails demonstrate immunoenhancement and improve
   survival rates compared with standard bacillus Calmette-Gu \& eacute;rin
   immunotherapy.},
