EarlyAccessDate = {JUN 2022},
ISSN = {2168-0485},
Keywords = {eco-efficiency; eco-efficiency portfolio; BASF; ratio indicator;
   weighted sum; sustainable industry},
Keywords-Plus = {SUSTAINABILITY},
