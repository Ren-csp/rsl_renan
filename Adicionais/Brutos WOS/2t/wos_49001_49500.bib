@article{ WOS:000831072100001,
Author = {Li, Qiuhan and Levi, Samuel M. and Wagen, Corin C. and Wendlandt, Alison
   E. and Jacobsen, Eric N.},
Title = {Site-selective, stereocontrolled glycosylation of minimally protected
   sugars},
