Language = {English},
Affiliation = {Lyytimäki, J (Corresponding Author), Finnish Environm Inst, Latokartanonkaari 11, Helsinki 00790, Finland.
   Lyytimaki, Jari, Finnish Environm Inst, Latokartanonkaari 11, Helsinki 00790, Finland.
   Pitkanen, Kati, Finnish Environm Inst, Yliopistonkatu 7, Joensuu 80101, Finland.},
DOI = {10.1007/s10745-020-00155-3},
EarlyAccessDate = {MAY 2020},
ISSN = {0300-7839},
EISSN = {1572-9915},
