@article{ WOS:001202408400041,
Author = {Wang, Chengyu and Bian, Yangshuang and Liu, Kai and Qin, Mingcong and
   Zhang, Fan and Zhu, Mingliang and Shi, Wenkang and Shao, Mingchao and
   Shang, Shengcong and Hong, Jiaxin and Zhu, Zhiheng and Zhao, Zhiyuan and
   Liu, Yunqi and Guo, Yunlong},
Title = {Strain-insensitive viscoelastic perovskite film for intrinsically
   stretchable neuromorphic vision-adaptive transistors},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {APR 10},
Abstract = {Stretchable neuromorphic optoelectronics present tantalizing
   opportunities for intelligent vision applications that necessitate high
   spatial resolution and multimodal interaction. Existing neuromorphic
   devices are either stretchable but not reconcilable with
   multifunctionality, or discrete but with low-end neurological function
   and limited flexibility. Herein, we propose a defect-tunable
   viscoelastic perovskite film that is assembled into strain-insensitive
   quasi-continuous microsphere morphologies for intrinsically stretchable
   neuromorphic vision-adaptive transistors. The resulting device achieves
   trichromatic photoadaptation and a rapid adaptive speed (<150 s) beyond
   human eyes (3 similar to 30 min) even under 100\% mechanical strain.
   When acted as an artificial synapse, the device can operate at an
   ultra-low energy consumption (15 aJ) (far below the human brain of 1
   similar to 10 fJ) with a high paired-pulse facilitation index of 270\%
   (one of the best figures of merit in stretchable synaptic
   phototransistors). Furthermore, adaptive optical imaging is achieved by
   the strain-insensitive perovskite films, accelerating the implementation
   of next-generation neuromorphic vision systems.},
