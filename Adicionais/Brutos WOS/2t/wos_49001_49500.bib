Author-Email = {carolien.delauwere@wur.nl},
Funding-Acknowledgement = {Dutch Ministry of Agriculture, Nature and Food Quality},
Funding-Text = {This research is part of the Knowledge Based programme `Towards a
   circular and climate neutral society' funded by the Dutch Ministry of
   Agriculture, Nature and Food Quality and carried out by Wageningen
