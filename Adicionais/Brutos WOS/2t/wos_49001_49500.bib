@article{ WOS:001784994900001,
Author = {Sugandi, Dede and Anggraini, Tania Septi and Zahrotunisa, Siti},
Title = {Spatial modeling of priority land rehabilitation zones for sustainable
   agriculture adaptation in the Cimanuk Watershed},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {The Cimanuk Watershed has its upstream source in the Mount Ceremai
   National Park, serving as a water catchment area. Land conversion within
   the watershed has reduced infiltration capacity and hydrological
   function of catchment, resulting in drought. The study aims to spatially
   model the priority zones for agricultural land rehabilitation and assess
   impacts of future land degradation. This study integrates GIS
   (Geographic Information System), remote sensing, and field survey data
   to provide multi-temporal coverage. Several steps conducted in this
   study: modeling land use land cover change (LULCC) in the future using
   Machine Learning and Deep Learning approach, drought analysis using the
   Standardized Precipitation Index (SPI), infiltration modelling based on
   field survey, modelling the ecosystem service index (ESI), and determine
   the prioritize area for drought rehabilitation in Cimanuk Watershed. The
   results show LULCC with an increase in built-up areas and a decrease in
   plantation, dryland agriculture, and rice fields. Areas with slow
   infiltration increase by 946.05 ha, while moderately fast infiltration
   decreases by 95.5 ha. Drought analysis revealed severe drought in 2015
   due to El Nino, followed by wet conditions in 2020, and a mild drought
   in 2025. High ESI values were found near the Jatigede Reservoir, while
   northern areas showed low ESI due to urban expansion. Rehabilitation
   priority zones increased 275.48 from 2025 to 2035, indicating an
   escalation in land degradation. Massive land degradation will reduce
   capacity of the Jatigede Reservoir, affecting the sustainability of
   agricultural land. These findings support sustainable agricultural
   development and adaptive land resource management under environmental
   change.},
