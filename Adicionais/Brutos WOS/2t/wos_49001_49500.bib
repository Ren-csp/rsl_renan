@article{ WOS:000477037900074,
Author = {Fongar, Claudia and Aamodt, Geir and Randrup, Thomas B. and Solfjeld,
   Ingjerd},
Title = {Does Perceived Green Space Quality Matter? Linking Norwegian Adult
   Perspectives on Perceived Quality to Motivation and Frequency of Visits},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2019},
Volume = {16},
Number = {13},
Month = {JUL 1},
Abstract = {Individual perceptions of green space quality are essential when a user
   considers engaging in activities. This national-scale study provides
   insights into Norwegians' quality perceptions of municipal green space,
   visit frequency and motivations for engaging in different activities. We
   applied regression analysis to investigate how various factors affect
   the outcome variables, quality perceptions and visit frequency from a
   sample of the Norwegian adult population. Results reveal that Norwegians
   perceive their green spaces as having good quality, and higher quality
   perceptions have a positive influence on green space visits. Half of the
   respondents visited green spaces out of intrinsic motives in
   high-quality environments providing fresh air, experiences of nature and
   quietness. It is essential, however, to take into account that less
   reported activity mirrors groups of respondents who least often visit
   green spaces.},
