@article{ WOS:000522470900025,
Author = {Dieckmann, Elena and Sheldrick, Leila and Tennant, Mike and Myers,
   Rupert and Cheeseman, Christopher},
Title = {Analysis of Barriers to Transitioning from a Linear to a Circular
   Economy for End of Life Materials: A Case Study for Waste Feathers},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {5},
Month = {MAR 1},
Abstract = {This research aimed to develop a simple but robust method to identify
   the key barriers to the transition from a linear to a circular economy
   (CE) for end of life products or material. Nine top-tier barrier
   categories have been identified that influence this transition. These
   relate to the basic material properties and product characteristics, the
   availability of suitable processing technology, the environmental
   impacts associated with current linear management, the organizational
   context, industry and supply chain issues, external drivers, public
   perception, the regulatory framework and the overall economic viability
   of the transition. The method provides a novel and rapid way to identify
   and quantitatively assess the barriers to the development of CE
   products. This allows mitigation steps to be developed in parallel with
   new product design. The method has been used to assess the potential
   barriers to developing a circular economy for waste feathers generated
   by the UK poultry industry. This showed that transitioning UK waste
   feathers to circularity faces significant barriers across numerous
   categories and is not currently economically viable. The assessment
   method developed provides a novel approach to identifying barriers to
   circularity and has potential to be applied to a wide range of end of
   life materials and products.},
