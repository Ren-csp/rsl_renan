@article{ WOS:001811553000012,
Author = {Pradhan, Brajabandhu and Kumar, Senthil T. and Wagner, Jessica and
   Gallardo, Rodrigo and Orlando, Gabriele and De Vleeschouwer, Matthias
   and Zorzini, Valentina and Madine, Jillian and Louros, Nikolaos and
   Neher, Jonas J. and Rousseau, Frederic and Schymkowitz, Joost},
Title = {Atomic structures of medin and Aβ fibrils reveal polymorphic remodeling
   in mixed amyloid systems},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {APR 28},
Abstract = {Amyloid assembly in vivo occurs in complex environments where multiple
   aggregation-prone species coexist. A beta and medin are prevalent
   amyloids in ageing humans that co-localize in cerebral amyloid
   angiopathy (CAA), yet their structural interactions remain poorly
   understood. Here, using cryo-electron microscopy, we determine
   high-resolution fibril structures from in vitro mixtures of A beta 40
   and medin. From the same reaction, we resolve three distinct fibril
   populations: (i) a previously characterized A beta 40 polymorph that
   also forms in isolation, (ii) a A beta 40 polymorph with A beta 42-like
   features, including ordered N- and C-terminal regions, and (iii) the
   atomic structure of full-length medin fibrils. Biochemical and
   immunogold analyses demonstrate A beta-medin association within mixed
   assemblies, though medin is not resolved within the ordered A beta core.
   These findings support two non-exclusive mechanisms: transient
   heterotypic interactions redirecting A beta folding, or partial medin
   incorporation into fibril architecture. Our data reveal how coexisting
   amyloids remodel each other's polymorphic landscapes.},
