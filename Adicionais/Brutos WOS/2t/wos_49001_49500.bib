@article{ WOS:001233405900019,
Author = {Odorcic, Ivica and Hamed, Mohamed Belal and Lismont, Sam and
   Chavez-Gutierrez, Lucia and Efremov, Rouslan G.},
Title = {Apo and Aβ46-bound γ-secretase structures provide insights into
   amyloid-β processing by the APH-1B isoform},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAY 27},
Abstract = {Deposition of amyloid-beta (A beta) peptides in the brain is a hallmark
   of Alzheimer's disease. A beta s are generated through sequential
   proteolysis of the amyloid precursor protein by the gamma-secretase
   complexes (GSECs). A beta peptide length, modulated by the Presenilin
   (PSEN) and APH-1 subunits of GSEC, is critical for Alzheimer's
   pathogenesis. Despite high relevance, mechanistic understanding of the
   proteolysis of A beta, and its modulation by APH-1, remain incomplete.
   Here, we report cryo-EM structures of human GSEC (PSEN1/APH-1B)
   reconstituted into lipid nanodiscs in apo form and in complex with the
   intermediate A beta 46 substrate without cross-linking. We find that
   three non-conserved and structurally divergent APH-1 regions establish
   contacts with PSEN1, and that substrate-binding induces concerted
   rearrangements in one of the identified PSEN1/APH-1 interfaces,
   providing structural basis for APH-1 allosteric-like effects. In
   addition, the GSEC-A beta 46 structure reveals an interaction between A
   beta 46 and loop 1PSEN1, and identifies three other H-bonding
   interactions that, according to functional validation, are required for
   substrate recognition and efficient sequential catalysis.
   Incomplete proteolysis of amyloid-beta (A beta) peptides by
   gamma-secretases is linked to Alzheimer's disease. Using cryo-EM and
   functional analyses, this study uncovers the gamma-secretase - A beta 46
   structure and unveils key interactions for efficient A beta cleavage.},
