@article{ WOS:000522470900141,
Author = {Du, Ao and Xu, Weihua and Xiao, Yi and Cui, Tong and Song, Tianyu and
   Ouyang, Zhiyun},
Title = {Evaluation of Prioritized Natural Landscape Conservation Areas for
   National Park Planning in China},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {5},
Month = {MAR 1},
Abstract = {Protecting representative natural ecosystems, rich biodiversity, and
   unique natural landscapes are the main considerations in China's
   national park planning. Here, we mapped the distribution of China's
   natural landscapes and evaluated their protection values for national
   park planning and construction. Grading evaluation methods combining
   standard comparison, inventory method, and expert consultation were
   used, and four levels of natural landscapes were identified.
   Furthermore, priority areas for national parks establishment were also
   proposed. Of all the landscapes evaluated, 76 were extremely important,
   481 were important, 2070 were moderately important, and 1213 were
   slightly important. A total number of 67 priority areas for natural
   landscapes were identified with a total area of 1,218,000 km(2). They
   comprised land and sea areas of 1,148,000 and 69,000 km(2),
   respectively. We suggest strengthening natural landscape protection by
   establishing natural parks in priority areas. Our study will contribute
   to the effective protection of natural landscapes in China.},
