   Maciel, Ana Carolina and Alves, Duana Suelem and Cademartori, Cristina
   Vargas},
Title = {Record of occurrence of Nasua nasua (Linnaeus, 1766)
   (Carnivora, Procyonidae) in a densely urbanized area of the city of
   Canoas, southern Brazil},
Journal = {NEOTROPICAL BIOLOGY AND CONSERVATION},
Year = {2022},
Volume = {17},
Number = {2},
Pages = {111-116},
Abstract = {The South American coati is a carnivore with a wide distribution in
   South America. Despite this, it is considered a threatened species in
   Rio Grande do Sul, as Vulnerable, primarily because of the loss of
   forest habitats. We recorded a Nasua nasua individual at the Canoas
   airbase, one of the last remaining green spaces in a densely urbanized
   area in southern Brazil. This confirms the capability of this species to
   use environments that have been changed by anthropic activity. It also
   highlights the relevance of green spaces in urban areas for wildlife
   conservation.},
