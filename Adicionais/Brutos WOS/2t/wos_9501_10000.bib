@article{ WOS:001288943300004,
Author = {Uzumcuoglu, Doga and Polay, Mukaddes},
Title = {User Perceptions on the Urban Waterfront Development in the Kyrenia
   Ancient Harbour, including the Creative Individuals},
Journal = {EUROPEAN JOURNAL OF TOURISM HOSPITALITY AND RECREATION},
Year = {2024},
Volume = {14},
Number = {1},
Pages = {35-54},
Month = {AUG 1},
Abstract = {Various entities offer to evaluate the adequacy of applications for
   urban waterfront development. This study focused on the underlying
   assumptions that gave a comprehensive review of urban waterfront
   development projects and applications and analysed user impressions in
   Kyrenia Ancient Harbour. Visitors to Kyrenia, including employees,
   employers, students, and creative people, were asked to complete a
   questionnaire. This study discovered that the twelve underlying factors
   of creative waterfronts included awareness of people, promotion of
   entrepreneurs, creative spaces and activities, innovation, tolerance,
   physical comfort, political support, social cohesion, diversity of
   function, economic contribution, and cultural preservation. An
   evaluation of the creative environment at Kyrenia Waterfront found
   various degrees of user participation based on several statistical
   tests. Most community members saw the example area favourably due to its
   distinctive urban characteristics and socialisation possibilities.
   Locals, however, believe that creative folks require new technologies
   and ideas to be more productive.},
