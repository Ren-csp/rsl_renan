   Esenarro, Doris, Univ Nacl Federico Villarreal, Fac Ecotourism Engn, Lima 15039, Peru.
   Cho, Alejandro; Vargas, Nalia; Calderon, Oscar; Raymundo, Vanessa, Univ Ricardo Palma, Fac Architecture \& Urbanism, Lima 15039, Peru.},
DOI = {10.3390/su16073068},
Article-Number = {3068},
EISSN = {2071-1050},
Keywords = {green corridor; social integration; tourism hub; sense of belonging;
