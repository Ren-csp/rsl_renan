@article{ WOS:001311738800001,
Author = {Venturella, Giuseppe and Di Gristina, Emilio and Pardi, Raimondo and
   Cirlincione, Fortunato and Gargano, Maria Letizia},
Title = {Checklist of Ornamental Trees, Shrubs, and Succulents of Apulia
   (Southern Italy)},
