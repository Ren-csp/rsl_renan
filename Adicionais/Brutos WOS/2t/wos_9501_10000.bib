@article{ WOS:001524562600001,
Author = {Katsavounidou, Garyfallia},
Title = {What do young adolescents' views of their neighbourhoods reveal about
   gender-inclusiveness and sustainability of urban space?},
Journal = {EURO-MEDITERRANEAN JOURNAL FOR ENVIRONMENTAL INTEGRATION},
Year = {2025},
Volume = {10},
Number = {5, SI},
Pages = {4369-4388},
Month = {OCT},
Abstract = {The nexus between Sustainable Development Goal (SDG) 5, Gender Equality,
   and SDG 11, Sustainable Cities and Communities, can be tested on the
   neighborhood level. Gender-disaggregated data on how youth use
   neighborhood open spaces reveal distinct gender differences, in terms of
   favorite spaces and activities. In this study, young architecture
   students (n = 70) were asked to describe the neighborhood they lived in
   when they were 12 years old. Their submissions, in the form of texts
   and/or visuals, presented their favorite journeys, places, and memorable
   experiences. Thematic analysis was used to find out what kind of gender
   differences can be traced and what these differences can tell us about
   sustainability and gender equity aspects of neighborhood design. The
   results show that girls' self-reported favorite pastimes and preferred
   spaces differed from those of boys. Social activities, such as hanging
   out with friends, were reported as most popular by girls, while boys
   preferred sports. Both girls and boys enjoyed street games and interface
   with nature. To achieve both gender equality and sustainability, girls'
   needs and preferences should be integrated in the design of urban
   spaces, especially due to their importance for a young person's
   well-being, socialization, and feeling of belonging.},
