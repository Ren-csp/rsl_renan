@article{ WOS:001843994000001,
Author = {Dong, Qianxi},
Title = {Greening newcomers: how firm green practices and environmental
   leadership shape pro-environmental behaviors},
Journal = {FRONTIERS IN ORGANIZATIONAL PSYCHOLOGY},
Year = {2026},
Volume = {4},
Month = {JUL 27},
Abstract = {This study examines how and when leaders' perceived firm green practice
   adoption orientation relates to newcomers' pro-environmental behaviors
   during organizational socialization. Drawing on social information
   processing theory, we propose that leaders' perceived firm green
   practice adoption orientation promotes newcomers' task-related and
   proactive pro-environmental behaviors by strengthening leaders'
   environmental leadership. We further propose that these indirect effects
   depend on two actor-specific characteristics, leaders' green
   psychological climate perceptions and newcomers' personal environmental
   beliefs. A time-lagged study of 278 supervisor-newcomer dyads across
   different regions and industries in China supports the hypothesized
   moderated mediation model. Specifically, leaders' perceived firm green
   practice adoption orientation was positively related to leaders'
   environmental leadership, which in turn was positively related to
   newcomers' task-related and proactive pro-environmental behaviors.
   Leaders' environmental leadership mediated the relationships between
   leaders' perceived firm green practice adoption orientation and
   newcomers' task-related and proactive pro-environmental behaviors.
   Moreover, leaders' green psychological climate perceptions strengthened
   the positive effect of leaders' perceived firm green practice adoption
   orientation on leaders' environmental leadership and the corresponding
   indirect effects. Newcomers' personal environmental beliefs further
   strengthened the positive effects of leaders' environmental leadership
   on newcomers' task-related and proactive pro-environmental behaviors, as
   well as the corresponding indirect effects. This study contributes to
   green management and newcomer socialization research by showing how firm
   green practices shape newcomers' pro-environmental behaviors.},
