@article{ WOS:001526701100028,
Author = {Wang, Chenguang and Lu, Wei and Yin, Xukang and Wang, Weixin and Miao,
   Miao},
Title = {The Path to Green Cities: Digital Infrastructure Construction and Urban
   Ecological Efficiency},
Journal = {POLISH JOURNAL OF ENVIRONMENTAL STUDIES},
Year = {2025},
Volume = {34},
Number = {5},
Pages = {5303-5317},
Abstract = {With the emergence of carbon neutrality and peak carbon emissions goals,
   coupled with the rapid expansion of the digital economy, digital
   technologies have a significant impact on environmental governance. This
   study, based on panel data from 247 Chinese cities spanning 2007 to
   2021, employs multi-period DID and SDM to examine the impact of digital
   infrastructure on urban ecological efficiency. Findings indicate a
   positive relationship between digital infrastructure and urban
   ecological efficiency, consistent across various robustness tests.
   Resource-based cities in both the eastern and western regions, as well
   as those implementing pilot policies, benefit more from digital
   infrastructure. The study identifies three main channels through which
   digital infrastructure affects ecological efficiency: promoting green
   innovation, supporting information platforms, and upgrading industrial
   structures. Additionally, it notes a negative spatial spillover effect
   on neighboring cities' ecological efficiency. By integrating digital
   infrastructure and urban ecological efficiency, this study offers
   insights into their spatial dynamics, informing future research and
   policy implementation in this area.},
