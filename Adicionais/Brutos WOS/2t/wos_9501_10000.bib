@article{ WOS:000372879600002,
Author = {Martini, Angeline and Biondi, Daniela and Wassem, Gustavo Ferreira},
Title = {Environmental education in forestry: the perception of students and
   professionals},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
Year = {2015},
Volume = {32},
Number = {1},
Pages = {5-19},
Abstract = {The forest engineering is a science that works directly with the natural
   environment and should form able to develop environmental education
   activities professionals. The objective of this research was to analyze
   the perception of students and professionals forest engineering
   regarding the importance of environmental education for their profession
   and thus analyze the degree of awareness of these. The perception was
   analyzed by means of an electronic poll. It was found that students and
   professionals know the importance of learning about environmental
   education for its formation, demonstrating a high degree of awareness
   about this. Thus, the course of forest engineering meets the needs of
   students and the demands of the labor market and evolved over time.},
