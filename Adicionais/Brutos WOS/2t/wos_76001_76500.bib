@article{ WOS:000443110600001,
Author = {Butt, Haroon and Jamil, Muhammad and Wang, Jian You and Al-Babili, Salim
   and Mahfouz, Magdy},
Title = {Engineering plant architecture via CRISPR/Cas9-mediated alteration of
   strigolactone biosynthesis},
Journal = {BMC PLANT BIOLOGY},
Year = {2018},
Volume = {18},
Month = {AUG 29},
Abstract = {Background: Precision plant genome engineering holds much promise for
   targeted improvement of crop traits via unprecedented single-base level
   control over the genetic material. Strigolactones (SLs) are a key
   determinant of plant architecture, known for their role in inhibiting
   shoot branching (tillering).
   Results: We used CRISPR/Cas9 in rice (Oryza sativa) for targeted
   disruption of CAROTENOID CLEAVAGE DIOXYGENASE 7 (CCD7), which controls a
   key step in SL biosynthesis. The ccd7 mutants exhibited a striking
   increase in tillering, combined with a reduced height, which could be
   rescued by application of the synthetic SL analog GR24. Striga
   germination assays and liquid chromatography-mass spectrometry analysis
   showed that root exudates of ccd7 mutants were also SL deficient.
   Conclusions: Taken together, our results show the potential and
   feasibility of the use of the CRISPR/Cas9 system for targeted
   engineering of plant architecture and for elucidating the molecular
   underpinnings of architecture-related traits.},
