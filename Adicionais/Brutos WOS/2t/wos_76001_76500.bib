@article{ WOS:A1988P616700008,
Author = {RUSSELL, GW and HORN, VE and HUDDLE, MJ},
Title = {MALE-RESPONSES TO FEMALE AGGRESSION},
Journal = {SOCIAL BEHAVIOR AND PERSONALITY},
Year = {1988},
Volume = {16},
Number = {1},
Pages = {51-57},
Abstract = {The effects on males (N = 60) of observing fictional aggression were
   assessed in a between-subjects design. Subjects were randomly assigned
   to view either a film clip of professional lady wrestlers, a mud
   wrestling segment or, to a no-film control condition. Both films
   produced negative changes in mood states, principally an increase in
   aggression and a decrease in social affection. Exposure to the films
   failed to produce changes in men''s acceptance of interpersonal violence
   against women, rape myth beliefs or sexual callousness.},
