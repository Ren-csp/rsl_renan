@article{ WOS:000993072000008,
Author = {Triana, Gerson Jaquin Cristancho and Hernandez, Fabian Arley Ninco},
Title = {Responsible consumption and its influence on household recycling
   activities: An exploratory study},
Journal = {REVISTA VIRTUAL UNIVERSIDAD CATOLICA DEL NORTE},
Year = {2023},
Volume = {69},
Pages = {190-220},
Month = {MAY-AUG},
Abstract = {Recycling in the home is one of the factors that directly affect the
   appropriation of responsible consumption practices in households, and
   directly affects solid waste management policies; Therefore, this
   research aims to know if aspects associated with responsible consumption
   behavior, such as attitude, habits and aspects during the purchase of
   products, affect recycling actions in homes. For this, an exploratory
   study was developed with a quantitative approach to 460 households. The
   methodology used was based on confirmatory factor analysis and
   Bootstraping for hypothesis testing. The results suggest that the
   attitude towards responsible consumption does not positively influence
   responsible consumption activities at home and negative motivation does
   not affect recycling activities.},
Publisher = {FUNDACION UNIV CATOLICA NORTE},
