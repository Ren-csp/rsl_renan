   Queiroz, SM (Corresponding Author), Univ Fed Pernambuco UFPE, Ctr Acad Agreste CAA, Ave Marielle Franco, BR-55014900 Recife, PE, Brazil.
   Monteiro, Mary de Melo Teixeira; Queiroz, Simone Moura, Univ Fed Pernambuco UFPE, Ctr Acad Agreste CAA, Caruaru, PE, Brazil.},
DOI = {10.15448/2179-8435.2024.1.43666},
