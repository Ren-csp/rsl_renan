Pages = {758-769},
Month = {JUL},
Abstract = {There are several papers studying climate change concern, but the
   majority of them are West-centric, and there are few studies for
   developing countries. Using a database from Pew Global and controlling
   for socio-demographic variables, we analyze how values, social roles,
   religiosity, and political orientation affect climate change concern in
   Turkey. We find that social roles, religiosity, and values are important
   determinants. In particular, having children and being a homemaker
   increase climate change concern, as well as holding more egalitarian and
   postmaterialistic views. Although giving more importance to religion
   increases concern, our findings regarding political orientation are more
   ambiguous.},
