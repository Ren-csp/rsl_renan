
@article{ WOS:000358860900006,
Author = {Ma, Guolin and Wei, Ming and He, Lian and Liu, Chongxu and Wu, Bo and
   Zhang, Shenyuan L. and Jing, Ji and Liang, Xiaowen and Senes, Alessandro
   and Tan, Peng and Li, Siwei and Sun, Aomin and Bi, Yunchen and Zhong,
   Ling and Si, Hongjiang and Shen, Yuequan and Li, Minyong and Lee, Mi-Sun
