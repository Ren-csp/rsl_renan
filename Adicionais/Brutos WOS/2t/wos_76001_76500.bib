@article{ WOS:001482541900001,
Author = {Bergquist, Magnus and Skipor, Sofiia and Harring, Niklas},
Title = {Anticipating the Storm: Expectations (not experience) of extreme weather
   predict public support for climate policies},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2025},
Volume = {104},
Month = {JUN},
Abstract = {The psychological effects of experiencing climate change-related extreme
   weather events have spurred researchers' interest. While existing
   literature suggests a direct link between first-hand experiences of
   extreme weather and policy support, we propose an interplay between
   experience and expectations of future extreme weather events. Through a
   cross-sectional survey of 1295 participants across four countries, we
   investigated the mediating effect of extreme weather expectations on the
   relationship between experience and policy support. Results revealed
   that expecting more severe future weather conditions was related to
   supporting climate change mitigation policies, fully mediating the
   relationship with past experiences. Importantly, climate change concerns
   emerged as a proximal determinant of support, mediating the relationship
   of expectations. These results seek to provide a nuance to the
   relationship between past experiences and policy support by suggesting
   that it is mediated by people's expectations of future extreme weather
   events.},
Publisher = {ACADEMIC PRESS LTD- ELSEVIER SCIENCE LTD},
