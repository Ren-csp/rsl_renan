@article{ WOS:001126007800030,
Author = {Garcia, Marta Rizo},
Title = {Communication, body, and emotions. Incorporating emotional dimension to
   communication research},
Journal = {COMUNICACION Y SOCIEDAD-GUADALAJARA},
Year = {2022},
Volume = {19},
Abstract = {This essay presents the need to incorporate the affective and bodily
   dimension in communication research. The theoretical perspective is
   framed in the ``Affective Turn{''} and in the studies on corporeality,
   from which is presented a proposal of conceptual articulation between
   body, communication, and emotions. The methodological strategy is based
   on documentary research and interpretation. The essay provides elements
   to think about human communication from a point of view that transcends
   the media and integrates the corporal and the affective as basic axes.},
