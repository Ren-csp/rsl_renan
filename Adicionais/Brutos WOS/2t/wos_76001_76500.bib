@article{ WOS:000549582900001,
Author = {Campus, Guglielmo and Rusca, Philippe and Amrhein, Christine and Meier,
   Andreas and Zeyer, Oliver and Wolf, Thomas Gerhard},
Title = {Career Prospects of Young Dentists in Switzerland},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
