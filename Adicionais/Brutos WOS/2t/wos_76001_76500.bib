@article{ WOS:000543394000056,
Author = {Silva, Ewerton and Torres, Ricardo S. and Alberton, Bruna and Morellato,
   Leonor Patricia C. and Silva, Thiago S. F.},
Title = {A Change-Driven Image Foveation Approach for Tracking Plant Phenology},
Journal = {REMOTE SENSING},
Year = {2020},
Volume = {12},
Number = {9},
Month = {MAY},
Abstract = {One of the challenges in remote phenology studies lies in how to
   efficiently manage large volumes of data obtained as long-term sequences
   of high-resolution images. A promising approach is known as image
   foveation, which is able to reduce the computational resources used
   (i.e., memory storage) in several applications. In this paper, we
   propose an image foveation approach towards plant phenology tracking
   where relevant changes within an image time series guide the creation of
   foveal models used to resample unseen images. By doing so, images are
   taken to a space-variant domain where regions vary in resolution
   according to their contextual relevance for the application. We
   performed our validation on a dataset of vegetation image sequences
   previously used in plant phenology studies.},
