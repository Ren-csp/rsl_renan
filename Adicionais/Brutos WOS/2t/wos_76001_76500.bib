@article{ WOS:000296023900002,
Author = {Clay, Andrea W. and Perdue, Bonnie M. and Gaalema, Diann E. and Dolins,
   Francine L. and Bloomsmith, Mollie A.},
Title = {The Use of Technology to Enhance Zoological Parks},
Journal = {ZOO BIOLOGY},
Year = {2011},
Volume = {30},
Number = {5},
Pages = {487-497},
Month = {SEP-OCT},
Abstract = {Technology can be used in a zoological setting to improve visitor
   experience, increase research opportunities, and enhance animal welfare.
   Evaluating the quality of these technological innovations and their use
   by nonhuman and human counterparts is a critical part of extending the
   uses of technology to enhance animal welfare and visitor experience at
   zoological parks. Survey data from a small sample of institutions
   housing primates suggest that computers, television, radio, and
   sprinklers are the most prevalent types of technological enrichment
   currently used. Survey respondents were positive about the technology
   implemented, stating a desire to increase its use. Zoo Biol 30:487-497,
   2011. (C) 2010 Wiley Periodicals, Inc.},
