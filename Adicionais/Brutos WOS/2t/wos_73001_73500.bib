@article{ WOS:001613753200001,
Author = {Aatsinki, Anna-Katariina and Lamichhane, Santosh and Isokaanta, Heidi
   and Sen, Partho and Krakstrom, Matilda and Alves, Marina amaral and
   Keskitalo, Anniina and Munukka, Eveliina and Karlsson, Hasse and
   Perasto, Laura and Lukkarinen, Minna and Oresic, Matej and Kailanto,
   Henna-Maria and Karlsson, Linnea and Lahti, Leo and Dickens, Alex M.},
Title = {Dynamics of gut metabolome and microbiota maturation during early life},
Journal = {ISCIENCE},
Year = {2025},
Volume = {28},
Number = {11},
Month = {NOV 21},
Abstract = {Early-life gut microbiome-metabolome crosstalk plays a crucial role in
   maintaining host physiology. The microbially produced metabolites often
   convey effects on host health and physiology. This study investigates
   the gut metabolites, including short-chain fatty acids (SCFAs), bile
   acids (BAs), and polar metabolites, and their relationship to gut
   microbiota composition in a birth cohort of 670 children. Samples were
   collected at 2.5 (n = 272), 6 (n = 232), 14 (n = 289), and 30 months (n
   = 157) of age. We identified the trajectories of the fecal metabolome
   that relate to the maturation of the early-life gut micro-biota. We
   found that prevalent gut microbial abundances were associated with
   microbial metabolite levels, particularly in 2.5-month-old infants.
   Here, the abundances of early colonizers, e.g., Bacteroides,
   Escherichia, and Bifidobacterium, were associated with microbial
   metabolites, especially secondary BAs, particularly in breastfed
   infants. Our results suggest that early-life gut microbiota associates
   with changes in metabolome composition, particularly BAs, which may have
   physiological implications.},
