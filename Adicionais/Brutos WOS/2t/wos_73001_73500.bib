@article{ WOS:001012158900029,
Author = {Wagh, Kaustubh and Stavreva, Diana A. and Jensen, Rikke A. M. and
   Paakinaho, Ville and Fettweis, Gregory and Schiltz, R. Louis and
   Wustner, Daniel and Mandrup, Susanne and Presman, Diego M. and
   Upadhyaya, Arpita and Hager, Gordon L.},
Title = {Dynamic switching of transcriptional regulators between two distinct
   low-mobility chromatin states},
Journal = {SCIENCE ADVANCES},
Year = {2023},
Volume = {9},
Number = {24},
Month = {JUN 16},
Abstract = {How chromatin dynamics relate to transcriptional activity remains poorly
   understood. Using single-molecule tracking, coupled with machine
   learning, we show that histone H2B and multiple chromatin-bound
   transcriptional regulators display two distinct low-mobility states.
   Ligand activation results in a marked increase in the propensity of
   steroid receptors to bind in the lowest-mobility state. Mutational
   analysis revealed that interactions with chromatin in the
   lowest-mobility state require an intact DNA binding domain and
   oligomerization domains. These states are not spatially separated as
   previously believed, but individual H2B and bound-TF molecules can
   dynamically switch between them on time scales of seconds. Single
   bound-TF molecules with different mobilities exhibit different dwell
   time distributions, suggesting that the mobility of TFs is intimately
   coupled with their binding dynamics. Together, our results identify two
   unique and distinct low-mobility states that appear to represent common
   pathways for transcription activation in mammalian cells.},
