@article{ WOS:001591151300008,
Author = {Biletska, Halyna and Ivantsiv, Oksana and Nazarko, Iryna and Stepanyuk,
   Alla and Kazanishena, Nataliia and Liutko, Nataliia and Hrytsai,
   Nataliia and Sopivnyk, Ruslan},
Title = {Formation of Bioethical Knowledge in Adolescents during Their Biology
   Education},
