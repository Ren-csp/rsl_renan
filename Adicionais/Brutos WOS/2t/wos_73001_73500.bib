@article{ WOS:001839289300001,
Author = {Fang, Xue-Lan and Li, Bo-Yan and Yang, Yin and Guo, Long-Jie and Sun,
   Qing-Lei and Sun, Jing and Geng, Ying and Zhou, Ying and Wang, Chun-Ping
   and Li, Yan-Peng and Zhu, Xue-Ying and Grueter, Cyril C. and Cui,
   Liang-Wei and Xiao, Wen},
Title = {Maternal and infant behavioral responses to male replacement in a
   primate multilevel society},
Journal = {CURRENT ZOOLOGY},
Year = {2026},
Month = {2026 AUG 4},
Abstract = {Male replacement in one-male units (OMUs) can generate strong social
   pressures on females and offspring, influencing transfer behavior,
   spatial relationships, and offspring dispersal in primates. However,
   despite frequent male replacements in the black-and-white snub-nosed
   monkey (Rhinopithecus bieti), infanticide appears rare. We investigated
   female and offspring behavioral responses to male replacement events in
   a semiprovisioned population in Yunnan, China, using all-occurrence and
   focal sampling over 10 years. Across 18 male replacement events
   involving 9 extraneous males and 9 males from all-male units, mothers
   with female infants were more likely to join new resident males and form
   new OMUs, whereas those with male infants tended to remain with ousted
   males in remaining OMUs (R-OMUs). Some male infants later returned to
   R-OMUs. Mothers with male infants and the infants themselves maintained
   greater distances from new resident males (>= 4 m vs. <= 3 m) than other
   group members. Male offspring experiencing male replacements entered
   all-male units about 2 years earlier than those in stable OMUs. These
   patterns suggest that male replacement generates sex-specific social
   pressures on mothers and offspring, potentially associated with
   avoidance of aggression, future male competition, or infanticide risk,
   and highlight its role in shaping spatial behavior and social dynamics
   in multilevel primate societies.},
