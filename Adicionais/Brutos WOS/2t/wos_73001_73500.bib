@article{ WOS:000383680600006,
Author = {Lkhagvasuren, Gavaachimed and Shin, Heejin and Lee, Si Eun and Tumen,
   Dashtseveg and Kim, Jae-Hyun and Kim, Kyung-Yong and Kim, Kijeong and
   Park, Ae Ja and Lee, Ho Woon and Kim, Mi Jin and Choi, Jaesung and Choi,
