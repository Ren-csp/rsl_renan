@article{ WOS:000305336300021,
Author = {Adedeji, Adeyemi O. and Marchand, Bruno and te Velthuis, Aartjan J. W.
   and Snijder, Eric J. and Weiss, Susan and Eoff, Robert L. and Singh,
   Kamalendra and Sarafianos, Stefan G.},
Title = {Mechanism of Nucleic Acid Unwinding by SARS-CoV Helicase},
Journal = {PLOS ONE},
Year = {2012},
Volume = {7},
Number = {5},
Month = {MAY 15},
Abstract = {The non-structural protein 13 (nsp13) of Severe Acute Respiratory
   Syndrome Coronavirus (SARS-CoV) is a helicase that separates
   double-stranded RNA (dsRNA) or DNA (dsDNA) with a 5'-> 3' polarity,
   using the energy of nucleotide hydrolysis. We determined the minimal
   mechanism of helicase function by nsp13. We showed a clear unwinding lag
   with increasing length of the double-stranded region of the nucleic
   acid, suggesting the presence of intermediates in the unwinding process.
   To elucidate the nature of the intermediates we carried out transient
   kinetic analysis of the nsp13 helicase activity. We demonstrated that
   the enzyme unwinds nucleic acid in discrete steps of 9.3 base-pairs (bp)
   each, with a catalytic rate of 30 steps per second. Therefore the net
   unwinding rate is similar to 280 base-pairs per second. We also showed
   that nsp12, the SARS-CoV RNA-dependent RNA polymerase (RdRp), enhances
   (2-fold) the catalytic efficiency of nsp13 by increasing the step size
   of nucleic acid (RNA/RNA or DNA/DNA) unwinding. This effect is specific
   for SARS-CoV nsp12, as no change in nsp13 activity was observed when
   foot-and-mouth-disease virus RdRp was used in place of nsp12. Our data
   provide experimental evidence that nsp13 and nsp12 can function in a
   concerted manner to improve the efficiency of viral replication and
   enhance our understanding of nsp13 function during SARS-CoV RNA
   synthesis.},
Publisher = {PUBLIC LIBRARY SCIENCE},
Address = {1160 BATTERY STREET, STE 100, SAN FRANCISCO, CA 94111 USA},
Type = {Article},
Language = {English},
Affiliation = {Adedeji, AO (Corresponding Author), Univ Missouri, Sch Med, Dept Mol Microbiol \& Immunol, Christopher Bond Life Sci Ctr, Columbia, MO 65212 USA.
   Adedeji, Adeyemi O.; Marchand, Bruno; Singh, Kamalendra; Sarafianos, Stefan G., Univ Missouri, Sch Med, Dept Mol Microbiol \& Immunol, Christopher Bond Life Sci Ctr, Columbia, MO 65212 USA.
   te Velthuis, Aartjan J. W.; Snijder, Eric J., Leiden Univ, Ctr Infect Dis, Med Ctr, Mol Virol Lab,Dept Med Microbiol, Leiden, Netherlands.
