@article{ WOS:000444257200073,
Author = {Wang, Shuo and Herzog, Erik D. and Kiss, Istvan Z. and Schwartz, William
   J. and Bloch, Guy and Sebek, Michael and Granados-Fuentes, Daniel and
   Wang, Liang and Li, Jr -Shin},
Title = {Inferring dynamic topology for decoding spatiotemporal structures in
   complex heterogeneous networks},
