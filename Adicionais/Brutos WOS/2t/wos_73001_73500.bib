@article{ WOS:001676095300001,
Author = {Kang, Jingliang and Nagelkerken, Ivan and Coppersmith, Shannon and
   Connell, Sean D. and Ravasi, Timothy and Schunter, Celia},
Title = {Core Transcriptional Plasticity Pave the Way for Fish to Succeed in a
   High-CO2 World},
Journal = {MOLECULAR ECOLOGY},
Year = {2026},
Volume = {35},
Number = {2},
Month = {JAN},
Abstract = {Ocean acidification (OA) can alter the physiological and behavioural
   traits of marine fishes, raising concerns about how wild species will
   adapt to rising pCO(2). Using natural volcanic CO2 vents at White
   Island, New Zealand, as analogues for future OA conditions, we
   quantified behaviours in situ and sequenced the brain transcriptomes of
   four highly site-attached fish species from two vents and a nearby
   control site with ambient pCO(2), of which two species exhibit increased
   population densities at the vent. We found that two species showed
   changes in habitat preferences, and all four species with significant
   changes in gene expression related to circadian rhythm, visual
   perception, and energy metabolism at the vents. Strikingly, three
   differentially expressed genes, a heat shock protein (HS90A) and two
   immediate early genes (IEGs: JUN and FOS), were central regulators for
   transcriptional changes across all species at the vents. Within the
   circadian entrainment pathway, expression changes in opsins may act as a
   trigger, while core clock genes and IEGs function as downstream
   effectors, suggesting that elevated pCO(2) may reset the circadian clock
   in these fishes. Notably, the two species with increased populations at
   the vents exhibited distinct transcriptional responses in genes involved
   in calcium signalling, reproduction, intracellular pH regulation and
   energy metabolism. Together with convergent evolution in a calcium
   signalling gene and an HS90 facilitator, these molecular features may
   confer their reproduction advantages and ability to cope with elevated
   pCO(2). Our study provides novel insights into the molecular mechanisms
   underlying fish responses to OA and highlights key pathways that may
   support survival and ecological success under a naturally high-CO2
   world.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Schunter, C (Corresponding Author), Univ Hong Kong, Swire Inst Marine Sci, Sch Biol Sci, Hong Kong, Peoples R China.
   Schunter, C (Corresponding Author), City Univ Hong Kong, State Key Lab Marine Environm Hlth, Hong Kong, Peoples R China.
   Kang, Jingliang; Schunter, Celia, Univ Hong Kong, Swire Inst Marine Sci, Sch Biol Sci, Hong Kong, Peoples R China.
   Kang, Jingliang, Hainan Univ, Sch Marine Sci, State Key Lab Marine Resources Utilizat South Chin, Haikou, Hainan, Peoples R China.
   Nagelkerken, Ivan; Coppersmith, Shannon; Connell, Sean D., Adelaide Univ, Sch Biol Sci, Southern Seas Ecol Labs, Adelaide, SA, Australia.
   Ravasi, Timothy, Okinawa Inst Sci \& Technol OIST, Marine Climate Change Unit, Onna, Okinawa, Japan.
   Ravasi, Timothy, James Cook Univ, Coll Sci \& Engn, Townsville, Qld, Australia.
