@article{ WOS:000824242300001,
Author = {Faelli, Emanuela and Panasci, Marco and Ferrando, Vittoria and Codella,
   Roberto and Bisio, Ambra and Ruggeri, Piero},
Title = {High-Intensity Interval Training for Rowing: Acute Responses in
   National-Level Adolescent Males},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {13},
Month = {JUL},
Abstract = {Background: This study investigated the acute effects of two
   high-intensity interval training (HIIT) programs on physiological
   responses and internal workload. Methods: Ten national-level adolescent
   male rowers (age: 15.7 +/- 0.2 years; maximal oxygen uptake (VO(2)max):
   60.11 +/- 1.91 mL.kg(-1).min(-1)) performed two HIIT testing sessions:
   short (S-HIIT) and long (L-HIIT). In S-HIIT, the rowers performed 25
   reps of 30 s at 100\% power at VO(2)max (Pmax) interspersed with 30 s at
   P@20\% Pmax; whereas in L-HIIT, the rowers executed 4 x 4 min at P@90\%
   Pmax interspersed with 3 min of active recovery (P@30\% Pmax). Results:
   The acute physiological responses and internal workload were evaluated.
   The significance level was set at p < 0.05. Oxygen uptake (VO2) (p <
   0.05), time spent per session at similar to 90\% VO(2)max (p < 0.01),
   total VO2 consumed (p < 0.01), total distance (p < 0.001), the rating of
   perceived exertion, blood lactate concentration and heart rate (always p
   < 0.0001) were significantly higher in L-HIIT than in S-HIIT. However,
   peak power output was significantly lower in L-HIIT compared to S-HIIT
   (p < 0.0001). Conclusion: In adolescent rowers, both HIIT tests
   stimulated aerobic and anaerobic systems. The L-HIIT test was associated
   with acute cardiorespiratory and metabolic responses, as well as higher
   perceptions of effort than the S-HIIT test. In adolescent rowers, HIIT
   emerges as an asset and could be introduced into a traditional
   in-season, moderate-intensity and endurance-based rowing program once a
   week.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Ferrando, V (Corresponding Author), Univ Genoa, Dept Expt Med, Sect Human Physiol, I-16132 Genoa, Italy.
   Ferrando, V (Corresponding Author), Univ Genoa, Ctr Polifunz Sci Motorie, I-16132 Genoa, Italy.
   Faelli, Emanuela; Panasci, Marco; Ferrando, Vittoria; Bisio, Ambra; Ruggeri, Piero, Univ Genoa, Dept Expt Med, Sect Human Physiol, I-16132 Genoa, Italy.
