@article{ WOS:000489104700242,
Author = {Sun, Xiaodong and Yip, Tsz Leung and Lau, Yui-yip},
Title = {Location Characteristics of Cruise Terminals in China: A Lesson from
   Hong Kong and Shanghai},
Journal = {SUSTAINABILITY},
Year = {2019},
