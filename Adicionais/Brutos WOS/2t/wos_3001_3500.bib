@article{ WOS:001504902000001,
Author = {Verma, Deepank},
Title = {Is Generative AI a successor to human-in-the-loop perception and
   cognition experiments in urban design and planning?},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2025},
Month = {2025 JUN 8},
Abstract = {This paper focuses on Generative AI models, deemed capable of human-like
   contextual understanding and reasoning capabilities and their potential
   use as participants for urban perception and cognition exercises. In
   recent years, widely available urban datasets, larger respondent pools,
   and advanced AI solutions facilitated scaling such studies to larger
   extents. Emerging computational approaches, such as Generative AI,
   further hold significant promise in aiding researchers to explore urban
   environments and synthesize perceptual experiences. This communication
   provides a perspective on utilizing such methods in urban assessment
   studies, where human-in-the-loop assessment is required to gather
   assimilated thoughts in the form of ratings and descriptions.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
