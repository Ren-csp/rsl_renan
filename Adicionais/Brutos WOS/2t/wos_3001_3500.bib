@article{ WOS:001807756800001,
Author = {Sauve, Lucie and Boelen, Virginie},
Title = {BUILDING AN ECOLOGICAL IDENTITY WITH NATURE AS A TERRITORY OF BELONGING
   AND A LIVING CITY IN WHICH TO ENGAGE},
Journal = {TEORIA DE LA EDUCACION},
Year = {2026},
Volume = {38},
Number = {2},
Pages = {1-19},
Month = {JUL-DEC},
Abstract = {We address the issue of constructing human identity from our grounding
   in the field of environmental education and, more specifically, of
   eco-formation. We first briefly clarify these foundational bases and
   their points of convergence around the formation of our identity through
   our relationship with nature. We then outline a range of common
   representations of nature, each reflecting a particular type of
   relationship with it and calling for pedagogical practices that are both
   distinct and complementary. We focus on two of these representations
   that we consider particularly fruitful for identity construction and the
   impulse to act: nature as ``territory{''} and nature as ``city{''}.
   Nature-as-Territory invites the development of a sense of belonging and
   solidarity with the living world; it shapes our identity through the
   network of interactions with its various dimensions and components.
   Nature-as-City calls for rethinking the ``we{''} within this shared web
   of life; it invites us to examine the political dimension of our
   relationship with nature, grounded in the development of an eco-citizen
   identity. Through this exploration of complementary modes of
   relationship, we seek to contribute elements of response to the
   following question: what foundations and educational approaches should
   be adopted to foster the construction or reconstruction of our
   ontological bond with nature, as the matrix of our action in/with this
   shared living world?},
