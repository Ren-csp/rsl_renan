@article{ WOS:000639907500001,
Author = {Freeman, Claire and Buttery, Yvette and van Heezik, Yolanda},
Title = {Nature exposure and use of open spaces in three generation families:
   implications for planning},
Journal = {JOURNAL OF ENVIRONMENTAL PLANNING AND MANAGEMENT},
Year = {2022},
Volume = {65},
Number = {4},
Pages = {562-582},
Month = {JAN 17},
Abstract = {Who uses open spaces, when, and why, are critical questions for planning
   and managing green and blue spaces in urban areas. We argue that use
   needs to be studied across a range of ages and spaces. We studied the
   open space use and preferences of 15 three-generation families,
   interviewing children, parents and grandparents. Members of each family
   lived close to each other so had access to the same open spaces,
   enabling identification of generational and family differences. Nature
   exposure levels varied between and within families, but all families
   valued and used natural spaces. Family members selected common spaces
   suggesting a family based preference and evidence of transmission of
   family values and attachment to places. Preferred open spaces were
   located some distance from participants' homes and unevenly distributed
   across the city. Planners will need to consider how to better provide
   multi-purpose natural open spaces spread more evenly across the city.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Freeman, C (Corresponding Author), Univ Otago, Geog Dept, Dunedin, New Zealand.
