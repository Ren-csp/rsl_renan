@article{ WOS:001547690600005,
Author = {Rigolon, Alessandro and Stuhlmacher, Michelle and Christensen, Jon and
   Collins, Timothy W. and Kim, Junsik},
Title = {Different pathways to greening in gentrifying communities: Power,
   transformative projects, and the green gentrification cycle},
Journal = {CITIES},
Year = {2025},
Volume = {166},
Month = {NOV},
Abstract = {A few studies have suggested that gentrification might also precede
   greening in gentrifying neighborhoods, but the pathways through which
   gentrifying communities attract green space investments are
   understudied. For this paper, we conduct comparative case studies of
   large green space projects built in gentrifying communities: the
   Bloomingdale Trail in Chicago and Los Angeles River revitalization in
   Los Angeles. We ask, what attracts large green space investments to
   gentrifying areas? Based on stakeholder interviews and document
   analysis, we find marked differences in attractors of green space
   investments in the two study sites. Chicago's Bloomingdale Trail started
   as an equity-oriented project, gained momentum as gentrifiers advocated
   for it, enhancing the project's perceived feasibility, and got built
   when a green growth machine coalition took the reins of the project. In
   Los Angeles, green space initiatives to revitalize the river were
   initially driven by Latinx advocacy and politicians, and early
   gentrifiers put the western side of the river ``on the map.{''} Later
   on, projects increased in scale, with governance becoming more top-down
   and catering to a citywide audience. Our findings show that the pathways
   attracting green space to gentrifying communities are affected by the
   scale of projects, community advocacy, power dynamics, and governance
   systems.},
