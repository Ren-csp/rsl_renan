@article{ WOS:000411527500014,
Author = {Wang, Qun and Sandberg, Mats and Lin, Yuanyuan and Yin, Shi and Hang,
   Jian},
Title = {Impacts of Urban Layouts and Open Space on Urban Ventilation Evaluated
   by Concentration Decay Method},
Journal = {ATMOSPHERE},
Year = {2017},
Volume = {8},
Number = {9},
Month = {SEP},
Abstract = {Previous researchers calculated air change rate per hour (ACH) in the
   urban canopy layers (UCL) by integrating the normal component of air
   mean velocity (convection) and fluctuation velocity (turbulent
   diffusions) across UCL boundaries. However they are usually greater than
   the actual ACH induced by flow rates flushing UCL and never returning
   again. As a novelty, this paper aims to verify the exponential
   concentration decay history occurring in UCL models and applies the
   concentration decay method to assess the actual UCL ACH and predict the
   urban age of air at various points. Computational fluid dynamic (CFD)
   simulations with the standard k-epsilon models are successfully
   validated by wind tunnel data. The typical street-scale UCL models are
   studied under neutral atmospheric conditions. Larger urban size attains
   smaller ACH. For square overall urban form (Lx = Ly = 390 m), the
   parallel wind (theta = 0 degrees) attains greater ACH than non-parallel
   wind (q = 15 degrees, 30 degrees, 45 degrees), but it experiences
   smaller ACH than the rectangular urban form (Lx = 570 m, Ly = 270 m)
   under most wind directions (q = 30 degrees to 90 degrees). Open space
   increases ACH more effectively under oblique wind (q = 15 degrees, 30
   degrees, 45 degrees) than parallel wind. Although further investigations
   are still required, this paper provides an effective approach to
   quantify the actual ACH in urban-like geometries.},
