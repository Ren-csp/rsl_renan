@article{ WOS:001467608800001,
Author = {Jurcisinova, Veronika and Zelinsky, Tomas and Hudec, Oto},
Title = {The Urban Paradox and Rural Appeal: Subjective Well-Being Across Diverse
   European Living Environments},
Journal = {APPLIED RESEARCH IN QUALITY OF LIFE},
Year = {2026},
Volume = {21},
Number = {1},
Pages = {71-99},
Month = {FEB},
Abstract = {This study examines the complex relationships between characteristics of
   living environments and subjective well-being (SWB) across urban and
   rural areas in Europe. Utilizing comprehensive data from the EU-SILC
   survey, it applies regression models and structural equation modelling
   to examine both direct and indirect effects of living environment
   characteristics, while controlling for regional and socio-demographic
   factors. The results reveal clear regional patterns: respondents in
   Northern and Western Europe generally report higher SWB in rural areas,
   while the reverse is true in post-communist European countries. Southern
   Europe shows mixed results. Despite offering better access to amenities,
   urban living is linked to higher levels of pollution, noise, and crime,
   which negatively impact SWB. These contrasting effects highlight the
   ``urban paradox{''} in which urban advantages are offset by
   disadvantages, resulting in highly variable overall outcomes. The study
   concludes that binary urban-rural classifications oversimplify quality
   of life assessments, and advocates for a nuanced framework that
   recognizes regional specificities. Enhancing green spaces and further
   strengthening access to services are identified as key strategies for
   boosting SWB in urban environments.},
