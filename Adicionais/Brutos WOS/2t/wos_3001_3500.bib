Language = {English},
Affiliation = {Thomas, F (Corresponding Author), Univ Exeter, Sch Med, European Ctr Environm \& Human Hlth, Knowledge Spa,Royal Cornwall Hosp, Truro TR1 3HD, England.
   Thomas, Felicity, Univ Exeter, Sch Med, European Ctr Environm \& Human Hlth, Knowledge Spa,Royal Cornwall Hosp, Truro TR1 3HD, England.},
DOI = {10.1016/j.healthplace.2014.11.005},
ISSN = {1353-8292},
EISSN = {1873-2054},
Keywords = {Urban health; Wellbeing; Women; Green space; Blue space},
Keywords-Plus = {PHYSICAL-ACTIVITY; THERAPEUTIC LANDSCAPES; GREEN SPACE; URBAN GREEN;
   PEOPLE; GENDER; RESTORATION; OUTDOORS; MEANINGS; POLICY},
