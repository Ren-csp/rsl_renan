@article{ WOS:001839576500001,
Author = {Garcia-Torres, Leonardo Daniel and Lopez-Mares, Lourdes Marcela and
   Cardenas-Tristan, Abraham and Cisneros-Vidales, Alicia Anahi and
   Ramos-Palacios, Carlos Renato},
Title = {Public green infrastructure, the luxury effect, and the 3-30-300 rule in
   a Mexican semiarid city},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {JUL 22},
Abstract = {Green infrastructure, such as urban tree canopy cover and green spaces,
   plays a fundamental role in improving environmental comfort and quality
   of life in semi-arid cities. However, its distribution is often uneven
   across the urban systems and associated with socioeconomic status, a
   phenomenon known as the luxury effect. Despite the growing adoption of
   the 3-30-300 rule as a comprehensive indicator, its application in
   Mexican cities is virtually nonexistent and remains limited in semi-arid
   contexts. This study evaluates this rule in the Metropolitan Area of San
   Luis Potos \& iacute; by integrating public green spaces with
   socioeconomic data at the Basic Geostatistical Area level. Green spaces
   were classified into urban parks, linear parks, neighborhood parks, and
   local gardens according to their recreational and social functions. The
   results indicate an availability of 5.6 m2 of green space per capita,
   below the World Health Organization's recommended minimum of 9 m2.
   Public green spaces account for only 0.4\% of the urban area and are
   primarily concentrated in large-sized parks. Furthermore, the indicators
   of the 3-30-300 rule are predominantly complied with in areas with lower
   levels of social deprivation, which exhibit greater vegetation cover,
   better accessibility, and stronger integration with residential areas,
   confirming the presence of the luxury effect. It was observed that in
   most cases, semi-arid cities have low per capita levels of green space.
   These findings highlight the need to generate evidence on the provision
   of green infrastructure in semi-arid cities, as well as to reconsider
   conventional indicators and incorporate socio-spatial dynamics into
   their evaluation.},
