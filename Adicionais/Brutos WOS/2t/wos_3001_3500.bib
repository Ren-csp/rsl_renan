@article{ WOS:000632217800001,
Author = {Rocha, Ricardo and Lopez-Baucells, Adria and Fernandez-Llamazares,
   Alvaro},
Title = {Ethnobiology of Bats: Exploring Human-Bat Inter-Relationships in a
   Rapidly Changing World},
Journal = {JOURNAL OF ETHNOBIOLOGY},
