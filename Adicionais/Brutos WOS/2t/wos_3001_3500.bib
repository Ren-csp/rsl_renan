@article{ WOS:001818169500001,
Author = {Napadensky, Aaron and Contreras-Espinoza, Sergio and Hidalgo, Constanza
   and Reveco, Arnaldo},
Title = {Neighbourhood and Mental Well-Being in the Uniqueness of Heritage.
   Evidence from Chile},
Journal = {REVISTA DE URBANISMO},
Year = {2026},
Volume = {54},
Pages = {27},
Month = {JUN},
Abstract = {While the influence of neighbourhood on mental well-being no longer
   appears to be in dispute, more specific evidence reveals a relative
   consensus on the significance of factors such as the presence of green
   spaces, walkability, perceived urban integration, a sense of belonging
   to the neighbourhood, and its perceived social cohesion. However, most
   of these findings come from representative cases, which is why it seemed
   relevant to test these correlations in a unique case: a recognized
   heritage neighbourhood. Our hypothesis posits that, despite its unique
   nature, the aforementioned correlations would not only be confirmed but
   would even be strengthened by the awareness of living in a heritage
   neighbourhood, which is particularly evident in perceptions of belonging
   to the place and neighbourhood cohesion. To explore this, 110 surveys
   were conducted, assessing personal attributes, aspects of the built
   environment, urban habits, and self-reported perceptions of the
   neighbourhood and mental well-being. After statistical analysis-using a
   polychoric matrix and a multiple correspondence matrix-our results
   partially confirm the hypothesis: while the correlation and
   correspondence between mental well-being and perceptions of
   neighbourhood attachment, community cohesion, safety, urban integration,
   and the practice of walking area evident, the reported awareness of
   living in a heritage neighbourhood was only correlated with feeling
   integrated into the city.},
Publisher = {UNIV CHILE, FAC ARQUITECTURA \& URBANISMO},
