@article{ WOS:000451710700016,
Author = {Shimpo, Misa and Akamatsu, Rie},
Title = {The effects of bowl size and portion size on food intake and fullness
   ratings in a sample of Japanese men},
Journal = {PUBLIC HEALTH NUTRITION},
