@article{ WOS:001811947500001,
Author = {Ragosa, Giulia and Gavu, Emmanuel Kofi and Watson, Jim and Quansah,
   David Ato and Abdul-Mugis, Mustapha},
Title = {Beyond cost: Unpacking the techno-economic, institutional, and social
   dynamics of solar PV adoption in Ghana's commercial sector},
Journal = {ENERGY FOR SUSTAINABLE DEVELOPMENT},
Year = {2026},
Volume = {94},
Month = {OCT},
Abstract = {In countries such as Ghana, commercial energy consumers face high
   electricity prices and unreliable grid supply, often resorting to
   polluting diesel generators. This makes solar photovoltaic (PV) systems
   an appealing alternative, yet adoption remains limited.
   Interdisciplinary research on the factors influencing commercial-sector
   solar PV adoption in low- and middle-income countries remains limited,
   especially where firm-level investment decisions are examined through
   qualitative case evidence. This study addresses this gap by identifying
   key techno-economic, policy and institutional, social and organisational
   barriers and enablers of solar PV uptake in Ghana's hotel and real
   estate sectors. To do so, it draws on a comparative case analysis of 23
   commercial entities, based on face-to-face semi-structured interviews,
   site visits and complementary interviews with two sectoral business
   associations. In Ghana's commercial sector, solar adoption has grown
   largely from business pragmatism rather than government support, with
   firms attracted by long-term cost savings, energy reliability,
   environmental benefits and reputational gains. Firms with engaged
   leadership or environmentally minded decision-makers were more likely to
   invest, while risk-averse leadership often slowed progress even when
   technical staff championed solar. High upfront costs remain the most
   significant barrier to investment, compounded by weak implementation of
   renewable energy policies and resistance from distribution utilities.
   Adoption has also been shaped by concerns over product quality and
   maintenance, as well as limited access to clear, trustworthy
   information. Where solar is used, it has proven to be a viable and
   cost-effective solution, though negative perceptions, financing
   challenges, and policy gaps continue to restrict broader uptake.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
