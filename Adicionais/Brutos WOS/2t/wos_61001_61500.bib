@article{ WOS:000431481000023,
Author = {Pratt, Edwin C. and Shaffer, Travis M. and Zhang, Qize and Drain,
   Charles Michael and Grimm, Jan},
Title = {Nanoparticles as multimodal photon transducers of ionizing radiation},
