@article{ WOS:001768150800001,
Author = {Yu, Haoyi and Yang, Xiaofan and Li, Ruoqi and Tang, Jiayin and Hubacek,
   Klaus and Shan, Yuli},
Title = {Global monthly 0.1° land XCO2 data (2017-2024) estimated via
   multi-source fusion and spatiotemporal pattern integration},
Journal = {ENVIRONMENTAL RESEARCH-CLIMATE},
Year = {2026},
Volume = {5},
Number = {2},
Month = {JUN 1},
Abstract = {Monitoring atmospheric CO2 concentrations is critical for understanding
   climate change and informing mitigation policies. Satellite-derived XCO2
   observations provide rapid results with broader spatial coverage;
   however, the data is constrained by the satellite's orbit track and
   commonly affected by cloud or aerosol interference. Conventional
   gap-filling methods based on convolution neural network (CNN) fail to
   capture large-scale spatial dependencies and adapt to heterogeneous land
   surfaces due to the fixed and typically small receptive field of
   standard CNN layers, which constrains the model's awareness of distant
   but spatially correlated features. To address this, this study proposes
   a spatiotemporal fusion network that integrates CNN and Transformer
   architectures within an ensemble learning framework. The CNN leverages
   its local receptive field to extract fine-scale spatial features from
   multi-source geospatial predictors, including ERA5-Land reanalysis,
   MODIS normalized difference vegetation index, NPP-VIIRS nighttime
   lights, population density, and elevation to estimate XCO2, with
   orbiting carbon observatory 2 retrievals used as training data. The
   Transformer models long-range spatial dependencies via self-attention,
   overcoming CNN's perception limitation. The composite loss function (MSE
   + spatialloss) ensures prediction accuracy and physical plausibility. A
   global monthly 0.1 degrees land XCO2 dataset (2017-2024) was generated.
   Validation against total carbon column observing network data shows high
   accuracy (R2 = 0.949, RMSE = 1.278 ppm), outperforming Copernicus
   atmosphere monitoring service-EGG4 (R2 = 0.897, RMSE = 1.725 ppm). Based
   on Monte Carlo dropout, uncertainty quantification shows low
   uncertainty, with an estimated range of 0.08\% - 0.46\%. Spatiotemporal
   analysis reveals a global XCO2 growth rate of 2.58 ppm yr-1 from 2017 to
   2024, along with distinct interhemispheric and seasonal patterns.
   Feature importance highlights anthropogenic activity and vegetation
   dynamics as key drivers.},
Publisher = {IOP Publishing Ltd},
Address = {No.2 The Distillery, Glassfields, Avon Street, Bristol, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Yang, XF; Shan, YL (Corresponding Author), Univ Birmingham, Sch Geog Earth \& Environm Sci, Birmingham B15 2TT, England.
   Yu, Haoyi; Tang, Jiayin, Southwest Jiaotong Univ, Sch Math, Dept Stat, Chengdu 611756, Sichuan, Peoples R China.
   Yang, Xiaofan; Li, Ruoqi; Shan, Yuli, Univ Birmingham, Sch Geog Earth \& Environm Sci, Birmingham B15 2TT, England.
   Li, Ruoqi; Hubacek, Klaus, Univ Groningen, Energy \& Sustainabil Res Inst Groningen, Integrated Res Energy Environm \& Soc IREES, NL-9747 AG Groningen, Netherlands.},
DOI = {10.1088/2752-5295/ae6887},
