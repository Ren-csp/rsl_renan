@article{ WOS:001855953900003,
Author = {Lee, Claudia Y. and Smith, Jeffrey S. and Kohlmann, Taylor and Meara,
   Emily M. and Pham, Uyen and Kwarcinski, Frank and Dates, Andrew N. and
   Orofino, Jessica K. and Choi, Issac and Hilibrand, Ari S. and Jassal,
   Chanpreet and Gilmer, Abigail and Blacklow, Stephen C. and Tall, Gregory
   G. and Kruse, Andrew C. and Rajagopal, Sudarshan},
Title = {β-arrestin recruitment facilitates a direct association with G proteins},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {JUL 17},
Abstract = {G protein-coupled receptors (GPCRs) are targets for almost a third of
   all FDA-approved drugs. GPCRs are known to signal through both
   heterotrimeric G proteins and beta-arrestins. Traditionally these
   pathways were viewed as largely separable, with G proteins primarily
   initiating downstream signaling while beta-arrestins modulate receptor
   trafficking and desensitization in addition to regulating their own
   signaling events. Recent studies suggest an integrated role of G
   proteins and beta-arrestins in GPCR signaling, however the cellular and
   biochemical requirements for G protein:beta-arrestin interactions remain
   unclear. Here, we show that G proteins and beta-arrestins can directly
   interact. Through utilization of beta-arrestin-biased receptors and
   artificially enforced beta-arrestin relocalization, we demonstrate that
   recruitment of beta-arrestin to the plasma membrane is sufficient to
   interact with the G protein G alpha i. Using purified proteins, we show
   that G alpha i directly interacts with beta-arrestin. In addition, we
   find that G alpha i family members differ in their degree of association
   with beta-arrestin, and that a large degree of this selectivity resides
   within the alpha helical domain of G alpha i. These findings delineate
   the cellular and biochemical conditions that drive direct interactions
   between G proteins and beta-arrestins and illuminate the molecular basis
   for how they interact.},
