ISSN = {2571-6255},
Keywords = {wildfire; rugged terrain; upper air interaction; AFDRS},
Keywords-Plus = {TASMANIAN BUTTONGRASS MOORLANDS; BEHAVIOR; VERIFICATION; PREDICTION;
   SPREAD},
