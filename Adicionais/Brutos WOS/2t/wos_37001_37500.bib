@article{ WOS:000991166500001,
Author = {Everett, Glyn and Matsler, A. Marissa and Chan, Faith Ka Shun and
   Naclerio, Marissa A. and Morzillo, Anita T. and Lamond, Jessica E.},
Title = {Lifestyle and language barriers influence community engagement with
   green infrastructure},
Journal = {AMBIO},
Year = {2023},
Month = {2023 MAY 20},
Abstract = {Few studies have focused on value structures, experiences, and cultural
   diversity as it relates to bioswale planning and implementation. We used
   `Point of Opportunity Interactions' to understand previously
   undocumented views of the Cantonese-speaking immigrant community
   regarding bioswale design and use for stormwater management in Portland,
   Oregon, USA. Approximately half of participants were not aware of
   bioswale function. Maintenance costs and aesthetics were noted concerns,
   but parking and safety were not. Lack of outreach materials in the
   Chinese language(s), evening and weekend work schedules, and lack of
   clarity about maintenance responsibility were among barriers to public
   participation. Overall, lack of trust for the city and city officials
   was apparent, and hindered outreach and engagement. Emphasis on
   informality and place-based data collection near bioswales as neutral
   outdoors spaces, and proximate to participant residences, facilitated
   communication with this `hard-to-reach' population and revealed
   information that would have gone unknown using traditional outreach
   strategies.},
