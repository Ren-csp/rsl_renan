@article{ WOS:001628898800005,
Author = {Hewitt, Matthew and Ackermann, Fran and Harvey, Euan and McDonald,
   Justin},
Title = {Ports' motivations for implementing Introduced Marine Species
   surveillance},
Journal = {MANAGEMENT OF BIOLOGICAL INVASIONS},
Year = {2025},
Volume = {16},
Number = {4},
Pages = {961-989},
Month = {NOV},
Abstract = {Collaborative biosecurity surveillance programs for Introduced Marine
   Species (IMS) between ports and regulatory agencies can provide a united
   approach to help protect, detect and respond against potential IMS
   threats. However, collaborations encompass complex socio-ecological
   relationships between many different operators, users and regulators,
   each with their own agendas. These agendas are informed by different
   values (cultural, economic, and environmental) and are in constant flux,
   which can hinder collaborative efforts and IMS management. Therefore,
   understanding stakeholders' perceptions and motivations to implement IMS
   surveillance programs is paramount for the engagement and development of
   effective IMS surveillance programs. This research project examines
   Western Australian Port Authorities' motivations for implementing IMS
   surveillance programs using a novel application of the research
   technique, cognitive mapping, in combination with the self-determination
   motivational theory perspective. Its aim is to understand why ports
   initiate and continue to engage in IMS surveillance in Western Australia
   (WA) at an individual level. Interviews and a workshop were run with
   environmental staff and general managers from the five Port Authorities
   within WA. Results highlighted that effective science-industry
   communication is crucial in building support. However, the groundwork of
   collaboration in IMS surveillance relies on the facilitation of
   intra-and inter-organisational trust and its ability to protect social
   licence. This development of trust motivates and appears to unlock
   individuals in WA Ports' proactive desire and intrinsic motivations to
   address IMS risk. This study shows the importance of nurturing trust on
   an individual and organisational level to be able to deliver complex
   collaborative biosecurity programs such as IMS surveillance.},
