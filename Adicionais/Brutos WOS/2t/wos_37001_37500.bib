@article{ WOS:001809854500007,
Author = {Walter, Hildrun and Treiber, Fritz M. and Brohmer, Hilmar and
   Brudermann, Thomas and Foelsche, Ulrich and Beranek-Knauer, Heide and
   Eder, Lucas and Maier, Christina and Jungwirth, Helmut},
Title = {The communication format, Science \& Cinema: reflecting on
   representations of science in movies for joint meaning-making},
Journal = {JCOM-JOURNAL OF SCIENCE COMMUNICATION},
Year = {2026},
Volume = {25},
Number = {3},
Abstract = {We present Science \& Cinema, a science communication format combining a
   cinematic atmosphere with scientific expertise. Through examining
   sequences from various movies, the format encourages audiences to
   critically reflect on representations of scientific topics in popular
   culture. The findings from pre-and post-event questionnaires and a
   recorded focus group session reveal that the format appeals to a range
   of audience demographics, entertains, creates interest, and fosters
   understanding and reflection. The format makes the power of images in
   shaping perceptions explicit and potentially contributes to a better
   understanding of how meaning-making occurs when scientific topics are
   strongly present in societal discourses.},
Publisher = {SCUOLA INT SUPERIORE STUDI AVANZATI-S I S S A-INT SCH ADVANCED STUDIES},
