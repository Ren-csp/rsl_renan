
@article{ WOS:000326596800023,
Author = {Christiansen, Karina M. H. and Qureshi, Farah and Schaible, Alex and
   Park, Sohyun and Gittelsohn, Joel},
Title = {Environmental Factors That Impact the Eating Behaviors of Low-income
   African American Adolescents in Baltimore City},
