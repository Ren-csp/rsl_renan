@article{ WOS:000637758000003,
Author = {Bedla, Dawid and Halecki, Wiktor and Krol, Karol},
Title = {HYDROMORPHOLOGICAL METHOD AND GIS TOOLS WITH A WEB APPLICATION TO ASSESS
