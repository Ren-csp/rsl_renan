@article{ WOS:000467396900002,
Author = {Li, Xuecao and Zhou, Yuyu and Eom, Jiyong and Yu, Sha and Asrar, Ghassem
   R.},
Title = {Projecting Global Urban Area Growth Through 2100 Based on Historical
   Time Series Data and Future Shared Socioeconomic Pathways},
Journal = {EARTHS FUTURE},
