@article{ WOS:001708523100001,
Author = {Abdelfattah, Dalia and Nasreldin, Rania},
Title = {Towards inclusive public open space in CBD case study of King Abdallah
   financial district},
Journal = {JOURNAL OF URBAN MANAGEMENT},
