@article{ WOS:001757671200001,
Author = {Derose, Kathryn P. and Seelam, Rachana and Perez, Lilian G. and
   Arredondo, Elva and Han, Bing and Castro, Gabriela and Cohen, Deborah A.},
Title = {Associations of park visits, physical activity and health outcomes among
   churchgoing Latino adults in low-income urban communities},
Journal = {JOURNAL OF BEHAVIORAL MEDICINE},
Year = {2026},
Volume = {49},
Number = {4},
Pages = {619-630},
Month = {AUG},
Abstract = {This study examines factors associated with park visits, physical
   activity (PA), and chronic health conditions using baseline data from a
   cluster randomized controlled trial to promote PA and park visits among
   churchgoing Latino adults in low-income urban communities. Participants
   (n = 726) were recruited from 12 Catholic churches in predominantly
   Latino neighborhoods in and near East Los Angeles. Data collection
   included accelerometer-measured PA, self-reported weekly park visits,
   socio-demographics, history of hypertension and Type 2 diabetes, family
   and friend social support for PA, depression (PHQ8), stress, and
   measured height and weight. Multivariable linear and logistic regression
   models assessed associations between predictors and health outcomes. The
   average age was 52.3 years; 76\% were women; 71\% had completed high
   school or less; and the average BMI was 31.1 (obese). Age, female
   gender, and higher depressive symptoms were negatively associated with
   moderate-to-vigorous PA (MVPA). Being employed, greater depressive
   symptoms, and more safety concerns were negatively associated with park
   visits, while higher family support for PA was positively associated.
   Both accelerometer-based MVPA and self-reported park visits were
   associated with lower depressive symptoms. Park visits were also
   associated with lower odds of Type 2 diabetes, and higher family support
   for PA was linked with reduced odds of hypertension. These results
   address gaps in understanding the relationships between PA and park
   visits and physical and mental health among churchgoing Latino adults.
   Churches may serve as important venues to support family-oriented park
   events and promote greater use of parks for health promotion in Latino
   communities. Association of park visits, physical activity and health
   outcomes among Latino church members in low-income urban
   communities.Clinical trial registration number NCT03858868; 2019-02-27},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Derose, KP (Corresponding Author), RAND, Santa Monica, CA 90401 USA.
   Derose, KP (Corresponding Author), Univ Massachusetts Amherst, Amherst, MA 01003 USA.
   Derose, Kathryn P.; Seelam, Rachana; Perez, Lilian G.; Castro, Gabriela, RAND, Santa Monica, CA 90401 USA.
   Derose, Kathryn P., Univ Massachusetts Amherst, Amherst, MA 01003 USA.
   Arredondo, Elva, San Diego State Univ, Sch Publ Hlth, San Diego, CA USA.
   Han, Bing; Cohen, Deborah A., Kaiser Permanente Res \& Evaluat, Pasadena, CA USA.},
DOI = {10.1007/s10865-026-00672-4},
EarlyAccessDate = {MAY 2026},
ISSN = {0160-7715},
EISSN = {1573-3521},
