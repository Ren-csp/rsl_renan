@article{ WOS:001533984200001,
Author = {Rastandeh, Amin and Borgstrom, Sara and Andersson, Erik and Friberg,
   Kristin Malmcrona and Rieser, Anja Moum},
Title = {Understanding the recreation-conservation nexus in peri-urban
   landscapes: challenges, opportunities, and knowledge gaps},
Journal = {NATURE-BASED SOLUTIONS},
Year = {2025},
Volume = {7},
Month = {JUN},
Abstract = {Peri-urban landscapes are the meeting point of a wide range of human
   activities, power dynamics, and socialecological processes in the
   Anthropocene. Multiple interests, as well as differences in governance
   regimes and decision-making processes increase the complexity of
   peri-urban landscapes. With this complexity as a background, we place
   our focus on the interactions between two highly desirable human
   activities in peri-urban landscapes: outdoor recreation and biodiversity
   conservation. The multifunctional role peri-urban landscapes can fulfill
   to respond to biodiversity conservation and outdoor recreation goals has
   the capacity to minimize the potential clash between these two
   functions. Despite this, little attention has been paid to the
   realization of multifunctionality in peri-urban landscapes when
   addressing the recreation-conservation nexus. In this Perspective, we
   provide a foundation for further inter-disciplinary explorations in this
   area by identifying knowledge gaps and priorities for future research on
   the recreation-conservation nexus in peri-urban landscapes with
   particular emphasis on the ``spatial{''} dimension.},
