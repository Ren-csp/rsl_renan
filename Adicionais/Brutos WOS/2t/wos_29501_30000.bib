@article{ WOS:001854737300001,
Author = {Gyan, Charles and Malik, Karim and Agyei-Okyere, Elvis},
Title = {Unequal waters: Socio-economic and spatial dimensions of flood
   vulnerability and resilience in Accra, Ghana},
Journal = {NEXT SUSTAINABILITY},
Year = {2026},
Volume = {8},
Month = {DEC},
Abstract = {Flooding, exacerbated by rapid urbanization and climate change, poses
   severe challenges globally. In Ghana, unregulated urban expansion into
   floodplains and riparian areas has heightened the vulnerability of urban
   communities, contributing to recurrent flood events with devastating
   socio-economic consequences. This study investigates the differential
   impacts of flooding in two distinct urban communities-Odawna and
   Weija-in Accra, Ghana. Data from 400 households were collected through a
   structured questionnaire incorporating demographic characteristics,
   flood experiences, risk perceptions, and coping strategies. The Ripley's
   K-function identified clustering of flood incidents at shorter distances
   (200 m). Non-spatial methods, including variable tree (v-tree),
   Silhouette analysis, dendrograms, and hierarchical clustering, detected
   clusters in Odawna and Weija, highlighting significant socio-economic
   disparities that influence residents' perceptions and responses to
   floods. Kolmogorov-Smirnov and Wilcoxon rank sum tests confirmed
   statistically significant differences (p-values < 0.05) in the impacts
   of flood on the two communities. Using linear regression and generalized
   additive models, statistically significant differences were found
   between flood severity and income in Odawna, but not in Weija.
   Contrarily, educational levels showed no statistically significant
   differences in flood severity between the two communities. The findings
   underscore that effective flood risk management requires
   context-specific interventions tailored to the unique socio-economic and
   spatial dynamics of urban communities. By integrating spatial and
   demographic dimensions, this study contributes to urban flood
   vulnerability literature and offers policymakers actionable insights for
   enhancing flood resilience in similar developing urban environments.},
