@article{ WOS:000285217100008,
Author = {Haab, Timothy C. and Whitehead, John C. and Parsons, George R. and
   Price, Jammie},
Title = {Effects of information about invasive species on risk perception and
   seafood demand by gender and race},
Journal = {RESOURCE AND ENERGY ECONOMICS},
Year = {2010},
Volume = {32},
Number = {4, SI},
Pages = {586-599},
Month = {NOV},
Abstract = {In this paper we consider the effects of negative and positive risk
   information on perceived seafood risks and seafood consumption by gender
   and race. The data is from a Mid-Atlantic survey of coastal seafood
   consumers. We elicit risk perceptions in three risk scenarios with a
   dichotomous choice with a follow-up question format. We elicit
   continuous revealed and stated preference seafood consumption in nine
   risk and price scenarios. Analysis in four gender and race categories
   indicates that demographic groups respond to the positive and negative
   information in different ways. Communication of risk information as risk
   mitigation policy is a challenge. (C) 2010 Elsevier B.V. All rights
   reserved.},
