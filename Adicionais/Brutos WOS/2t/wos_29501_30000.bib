@article{ WOS:000901140900001,
Author = {Hu, Xuewei and Xu, Wenwen and Li, Fayong},
Title = {Spatiotemporal Evolution and Optimization of Landscape Patterns Based on
   the Ecological Restoration of Territorial Space},
Journal = {LAND},
