@article{ WOS:000313400100001,
Author = {Hsu, Hsiu-Ju and Burns, Leslie Davis},
Title = {THE EFFECTS OF CULTURE, LONG-TERM ORIENTATION, AND GENDER ON CONSUMERS'
   PERCEPTIONS OF CLOTHING VALUES},
Journal = {SOCIAL BEHAVIOR AND PERSONALITY},
Year = {2012},
Volume = {40},
Number = {10},
Pages = {1585-1595},
Abstract = {We examined the effects of culture, high and low long-term orientation,
   and gender on consumers' perceptions of clothing values when making
   clothing purchase decisions. Participants were 487 university students
   from USA and 903 from Taiwan who completed a self-administered
   questionnaire. It was found that consumers from the culture with high
   long-term orientation (Taiwan) scored significantly higher on economic
   and religious clothing values than did consumers from the culture with
   low long-term orientation (USA). Moreover, consumers' clothing values
   varied according to the type of clothing, and female participants scored
   significantly higher on aesthetic and social clothing values when
   compared to male participants.},
