@article{ WOS:001863078800001,
Author = {Ahmad, Sadique and Eiman and Khan, Altaf and Alluhaidan, Ala Saleh and
   Elaffendi, Mohammed A.},
Title = {FRACTIONAL-ORDER MATHEMATICAL MODELING OF HUMAN PAPILLOMA VIRUS (HPV)
   USING ARTIFICIAL DEEP NEURAL NETWORKS},
Journal = {FRACTALS-COMPLEX GEOMETRY PATTERNS AND SCALING IN NATURE AND SOCIETY},
Year = {2026},
Month = {2026 AUG 29},
Abstract = {The study proposes a mathematical framework to evaluate the human
   papilloma virus (HPV) infection transmission dynamics, taking into
   account advanced approaches related to fractional calculus. The HPV
   infection and cervical cancer are always major public health threats
   across the world, particularly in those areas which have insufficient
   availability to health care services and control interventions. In first
   step, the positivity and boundedness of solutions are precisely examined
   to show that the model remains biologically valuable in the long run. In
   this study the disease-free equilibrium and endemic equilibrium is
   provided to describe the long-term behavior of the disease in a
   population. The basic reproductive number and sensitivity analysis are
   also studied as these are vital to analyze behavior of the dynamics. The
   theoretical results are established for the model under consideration
   using the fixed point theory. Next, the condition for Hyers-Ulam's
   (H-U)-type stability is clearly demonstrated. Then, modified Euler's
   method (MEM) is applied for the computation of numerical solution of the
   proposed model. At the end, we give graphical representation of the
   involved results. We use some real values for the parameters involved in
   our considered model. MATLAB is used for graphical demonstration.
   Through a comprehensive numerical analysis, the model explores how
   various fractional order values influence the dynamics of HPV
   transmission. Hence, suggestions are provided for how fractional order
   may better convey the intricate relationships within the communities.
   These developments also draw awareness to the method's significance in
   advancing disease modeling and deepening our knowledge of HPV
   transmission. With the help of artificial deep neural networks (DNNs),
   we investigate the considered model. We deduce some statistical
   thresholds including mean squared error (MSE) and root mean squared
   error (RMSE) together with progressional analysis. Further, graphical
   illustrations are given for infected classes using different fractional
   orders. Absolute errors between the simulated and those predicted by
   DNNs are compared for various fractional orders.},
