@article{ WOS:001591537100001,
Author = {Yan, Yuling and Mokri, Siti Salasiah},
Title = {Performance analysis of robotic arm visual servo system based on
   BFS-canny image edge detection algorithm},
Journal = {SCIENTIFIC REPORTS},
