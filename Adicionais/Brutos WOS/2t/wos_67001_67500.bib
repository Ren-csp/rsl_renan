   Tian, E.; Ten Hagen, Kelly G., Natl Inst Dent \& Craniofacial Res, Dev Glycobiol Unit, Lab Cell \& Dev Biol, NIH, Bethesda, MD 20892 USA.
   Hoffman, Matthew P., Natl Inst Dent \& Craniofacial Res, Matrix \& Morphogenesis Sect, Lab Cell \& Dev Biol, NIH, Bethesda, MD 20892 USA.},
DOI = {10.1038/ncomms1874},
Article-Number = {869},
