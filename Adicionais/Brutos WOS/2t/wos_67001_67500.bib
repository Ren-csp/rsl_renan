@article{ WOS:001410051500001,
Author = {Valero, Daniel and Pummer, Elena and Heller, Valentin and Kramer,
   Matthias and Bung, Daniel B. and Mulligan, Sean and Erpicum, Sebastien},
Title = {The unspoken value of water infrastructure},
Journal = {RENEWABLE \& SUSTAINABLE ENERGY REVIEWS},
Year = {2025},
Volume = {212},
Month = {APR},
Abstract = {Water infrastructure forms the backbone of development, being pivotal
   for water, food and energy security. Both existing and new
   infrastructure must cope with global climatic challenges and increased
   human activity. Continuous investment in water infrastructure is
   crucial, yet in many cases, investments are deferred as they are not
   perceived as a priority, leading to deterioration, and public attention
   typically only arises after accidents or malfunctions occur. A
   prevailing lack of social awareness, combined with the mismatch between
   infrastructure lifespan and political cycles, further limits political
   will-especially regarding investment in ageing systems. This article was
   prepared to accentuate the extraordinary value provided by water
   infrastructure. Examples of recent global events are used to exhibit the
   profound benefits that rarely make their way into traditional
   cost-benefit analyses to inform decision making. These examples also
   showcase how essential sustainable development activities (SDG 6, 7, 9)
   would be severely compromised in their absence. This perspective also
   contributes to the ongoing debate about water infrastructure not being
   ``fit for finance{''}, arguing that current financing and investment
   frameworks -as well as public perception- fail to capture the true
   societal and macroeconomic value of such systems, thus reinforcing their
   importance amidst changing climatic and human pressures.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Valero, D (Corresponding Author), Imperial Coll London, Dept Civil \& Environm Engn, London, England.
