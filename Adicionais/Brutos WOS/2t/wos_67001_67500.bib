@article{ WOS:000340780300039,
Author = {Morcos, Faruck and Schafer, Nicholas P. and Cheng, Ryan R. and Onuchic,
   Jose N. and Wolynes, Peter G.},
Title = {Coevolutionary information, protein folding landscapes, and the
   thermodynamics of natural selection},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2014},
Volume = {111},
Number = {34},
Pages = {12408-12413},
Month = {AUG 26},
Abstract = {The energy landscape used by nature over evolutionary timescales to
   select protein sequences is essentially the same as the one that folds
   these sequences into functioning proteins, sometimes in microseconds.
   Weshow that genomic data, physical coarse-grained free energy functions,
   and family-specific information theoretic models can be combined to give
   consistent estimates of energy landscape characteristics of natural
   proteins. One such characteristic is the effective temperature T-sel at
   which these foldable sequences have been selected in sequence space by
   evolution. T-sel quantifies the importance of folded-state energetics
   and structural specificity for molecular evolution. Across all protein
   families studied, our estimates for T-sel are well below the
   experimental folding temperatures, indicating that the energy landscapes
   of natural foldable proteins are strongly funneled toward the native
   state.},
Publisher = {NATL ACAD SCIENCES},
Address = {2101 CONSTITUTION AVE NW, WASHINGTON, DC 20418 USA},
Type = {Article},
Language = {English},
Affiliation = {Wolynes, PG (Corresponding Author), Rice Univ, Ctr Theoret Biol Phys, Houston, TX 77005 USA.
