Author = {Staedele, Veronika and Arandjelovic, Mimi and Nixon, Stuart and Bergl,
   Richard A. and Bradley, Brenda J. and Breuer, Thomas and Cameron,
   Kenneth N. and Guschanski, Katerina and Head, Josephine and Kyungu, Jean
   C. and Masi, Shelly and Morgan, David B. and Reed, Patricia and Robbins,
   Martha M. and Sanz, Crickette and Smith, Vincent and Stokes, Emma J. and
   Thalmann, Olaf and Todd, Angelique and Vigilant, Linda},
Title = {The complex Y-chromosomal history of gorillas},
Journal = {AMERICAN JOURNAL OF PRIMATOLOGY},
Year = {2022},
Volume = {84},
Number = {3},
Month = {MAR},
Abstract = {Studies of the evolutionary relationships among gorilla populations
   using autosomal and mitochondrial sequences suggest that male-mediated
   gene flow may have been important in the past, but data on the
   Y-chromosomal relationships among the gorilla subspecies are limited.
   Here, we genotyped blood and noninvasively collected fecal samples from
   12 captives and 257 wild male gorillas of known origin representing all
   four subspecies (Gorilla gorilla gorilla, G. g. diehli, G. beringei
   beringei, and G. b. graueri) at 10 Y-linked microsatellite loci
   resulting in 102 unique Y-haplotypes for 224 individuals. We found that
   western lowland gorilla (G. g. gorilla) haplotypes were consistently
   more diverse than any other subspecies for all measures of diversity and
   comprised several genetically distinct groups. However, these did not
   correspond to geographical proximity and some closely related haplotypes
   were found several hundred kilometers apart. Similarly, our broad
   sampling of eastern gorillas revealed that mountain (G. b. beringei) and
   Grauer's (G. b. graueri) gorilla Y-chromosomal haplotypes did not form
   distinct clusters. These observations suggest structure in the ancestral
   population with subsequent mixing of differentiated haplotypes by male
   dispersal for western lowland gorillas, and postisolation migration or
   incomplete lineage sorting due to short divergence times for eastern
   gorillas.},
