   Sant'anna, Celia L. and Ramirez, John J.},
Title = {DOLICHOSPERMUM LEMMERMANNII (CYANOBACTERIA): A TEMPERATE SPECIES
   IN A NEOTROPICAL, EUTROPHIC RESERVOIR},
Journal = {BOLETIN DE LA SOCIEDAD ARGENTINA DE BOTANICA},
