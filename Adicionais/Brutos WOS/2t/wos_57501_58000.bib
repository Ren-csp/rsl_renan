@article{ WOS:001505345000001,
Author = {Valenzisi, Brittney and Harasti, David and Huggett, Megan and Gaston,
   Troy and Parsons, Miles},
Title = {Underwater Soundscapes of Management Zones and Potential Impacts on
   Marine Communities},
