@article{ WOS:000542982400006,
Author = {Roderer, Daniel and Broecker, Felix and Sitsel, Oleg and Kaplonek,
   Paulina and Leidreiter, Franziska and Seeberger, Peter H. and Raunser,
   Stefan},
Title = {Glycan-dependent cell adhesion mechanism of Tc toxins},
Journal = {NATURE COMMUNICATIONS},
