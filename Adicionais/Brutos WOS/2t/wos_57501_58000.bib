@article{ WOS:000318380500021,
Author = {Aneli Rueda-Jasso, Rebeca and Campos-Mendoza, Antonio and
   Arreguin-Sanchez, Francisco and Diaz-Pardo, Edmund and Antonio
   Martinez-Palacios, Carlos},
Title = {The biological and reproductive parameters of the invasive armored
   catfish Pterygoplichthys disjunctivus from Adolfo Lopez Mateos El
   Infiernillo Reservoir, Michoacan-Guerrero, Mexico},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
