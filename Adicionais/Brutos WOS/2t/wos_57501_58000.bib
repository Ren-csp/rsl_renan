@article{ WOS:000850348400024,
Author = {Rovai, Alice and Chung, BoMee and Hu, Qingluan and Hook, Sebastian and
   Yuan, Qinggong and Kempf, Tibor and Schmidt, Florian and Grimm, Dirk and
   Talbot, Steven R. and Steinbrueck, Lars and Goetting, Jasper and Bohne,
   Jens and Krooss, Simon A. and Ott, Michael},
Title = {In vivo adenine base editing reverts C282Y and improves iron metabolism
   in hemochromatosis mice},
Journal = {NATURE COMMUNICATIONS},
Year = {2022},
Volume = {13},
Number = {1},
Month = {SEP 5},
Abstract = {Hemochromatosis is a metabolic disorder caused by mutations in the HFE
   gene. Here, the authors show that a single administration of AAV8
   vectors expressing an Adenine Base Editor facilitates efficient in vivo
   gene correction in hepatocytes and leads to improvement of iron-specific
   parameters in the liver and the blood in mouse models of the disease.
   Hemochromatosis is one of the most common inherited metabolic diseases
   among white populations and predominantly originates from a homozygous
   C282Y mutation in the HFE gene. The G > A transition at position c.845
   of the gene causes misfolding of the HFE protein, ultimately resulting
   in its absence at the cell membrane. Consequently, the lack of
   interaction with the transferrin receptors 1 and 2 leads to systemic
   iron overload. We screened potential gRNAs in a highly precise cell
   culture assay and applied an AAV8 split-vector expressing the adenine
   base editor ABE7.10 and our candidate gRNA in 129-Hfe(tm.1.1Nca) mice.
   Here we show that a single injection of our therapeutic vector leads to
   a gene correction rate of >10\% and improved iron metabolism in the
   liver. Our study presents a proof-of-concept for a targeted gene
   correction therapy for one of the most frequent hereditary diseases
   affecting humans.},
