@article{ WOS:001543882300001,
Author = {Phoswa, Feziwe and Gumede, S. Thobeka and Downs, Colleen T.},
Title = {Occurrence and persistence of Blacksmith Lapwings Vanellus
   armatus and Crowned Lapwings V. coronatus and their
   reproductive success in an urban mosaic landscape},
Journal = {OSTRICH},
Year = {2025},
Volume = {96},
Number = {2},
Pages = {103-112},
Month = {APR 3},
Abstract = {Urbanised landscapes continue to expand globally, leading to increased
   habitat fragmentation, which creates a mosaic of natural and managed
   landscapes. These environmental changes have an impact on bird
   populations, and are reflected in the declining populations of
   open-habitat species. Despite this, various bird species persist in
   certain cities, often through behavioural plasticity. In South Africa,
   this includes the Blacksmith Lapwing Vanellus armatus and Crowned
   Lapwing V. coronatus (family Charadriidae). This study focused on
   assessing factors affecting the persistence of these species in the
   mosaic urban landscape of Pietermaritzburg, KwaZulu-Natal Province.
   Specifically, we examined these species' occurrence and habitat use, and
   aimed to determine the influence of human activiy and different land
   uses on their nesting ecology. We surveyed different sites and collected
   data on monthly abundance, habitat use and nesting ecology, from April
   2022 to September 2023. We found that Blacksmith Lapwings and Crowned
   Lapwings coexist in and occur in human-modified landscapes, but will
   vacate the urban built environment if the habitats become unfavourable.
   Their abundance was seasonal, with abundance greater outside the
   breeding season. These species nest on short, open grasslands, creating
   a shallow scrape on the ground for the nest. Hatching success was
   greater than fledgling success, as environmental factors and/or
   predation affect the eggs and hatchlings differently. Despite this, both
   species persist in this urban mosaic landscape's open, short grasslands
   in natural and managed green spaces.
   \& Agrave; l'\& eacute;chelle mondiale, les paysages urbanis \& eacute;s
   continuent de s'\& eacute;tendre, entra \& icirc;nant une fragmentation
   accrue des habitats, ce qui cr \& eacute;e une mosa \& iuml;que de
   paysages naturels et modifi \& eacute;s. Ces changements
   environnementaux ont un impact sur les populations d'oiseaux et se refl
   \& egrave;tent dans le d \& eacute;clin des populations d'esp \&
   egrave;ces vivant dans des habitats ouverts. Malgr \& eacute; cela,
   plusieurs esp \& egrave;ces d'oiseaux persistent dans certaines villes,
   souvent gr \& acirc;ce \& agrave; leur plasticit \& eacute;
   comportementale. En Afrique du Sud, le Vanneau arm \& eacute; Vanellus
   armatus et le Vanneau couronn \& eacute; V. coronatus (famille
   Charadriidae) en sont deux exemples. Notre \& eacute;tude s'est concentr
   \& eacute;e sur l'\& eacute;valuation des facteurs affectant la
   persistance de ces esp \& egrave;ces dans le paysage urbain de
   Pietermaritzburg, KwaZulu-Natal, Afrique du Sud, d'avril 2022 \& agrave;
   septembre 2023. Nos objectifs \& eacute;taient d'\& eacute;tudier leur
   pr \& eacute;sence et leur utilisation de l'habitat, ainsi que de d \&
   eacute;terminer l'influence des activit \& eacute;s humaines et des diff
   \& eacute;rentes utilisations du sol sur leur \& eacute;cologie de
   nidification. Nous avons \& eacute;tudi \& eacute; diff \& eacute;rents
   sites et recueilli des donn \& eacute;es sur l'abondance mensuelle,
   l'utilisation de l'habitat et l'\& eacute;cologie de la nidification.
   Nous avons constat \& eacute; que les Vanneaux arm \& eacute;s et les
   Vanneaux couronn \& eacute;s coexistent dans des paysages modifi \&
   eacute;s et y sont pr \& eacute;sents, et qu'ils quittent les lieux si
   les habitats ne sont pas favorables. Leur abondance \& eacute;tait
   saisonni \& egrave;re, \& eacute;tant plus importante en dehors de la
   saison de reproduction. Ces esp \& egrave;ces nichent dans des prairies
   ouvertes \& agrave; herbes courtes, avec des nids qui consistent en une
   petite d \& eacute;pression au sol. Le succ \& egrave;s d'\&
   eacute;closion a \& eacute;t \& eacute; plus important que le succ \&
   egrave;s d'envol, car les facteurs environnementaux et/ou la pr \&
   eacute;dation ont affect \& eacute; differemment les oe ufs et les \&
   eacute;closions. Malgr \& eacute; cela, les deux esp \& egrave;ces
   persistent dans les prairies ouvertes de ce paysage urbain en mosa \&
   iuml;que dans les espaces verts naturels et am \& eacute;nag \&
   eacute;s.},
