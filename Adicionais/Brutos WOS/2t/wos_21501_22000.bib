@article{ WOS:001715125900006,
Author = {Abdulkareem, Tajudeen Anu and Oladeji, Yinmi Gabriel and Jojolola,
   Barnabas Femi and Sanusi, Mumeen and Ajayi, Tosin and Suleiman, Hafsah
   Adeyinka and Oyewole, Rukayat Modupeoluwa and Awoniyi, Samuel Oluseyi
   and Odegbemi, Odekunle Bola},
Title = {Awareness and perceptions of one health among undergraduate students at
   Obafemi Awolowo University, Nigeria: an exploratory cross-sectional
   study},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2026},
Volume = {23},
Number = {1},
Month = {MAR 15},
Abstract = {Background The One Health concept highlights the interconnection between
   human, animal, and environmental health. Despite its global importance,
   little is known about OH awareness among Nigerian undergraduates. This
   study assessed the knowledge, awareness and perceptions of OH among
   students at Obafemi Awolowo University (OAU), Nigeria. Methods A
   cross-sectional survey was conducted among undergraduate students at OAU
   using a semi-structured, online questionnaire (Google Forms), which
   included two sections. Descriptive statistics summarised responses, and
   chi-square tests assessed associations between knowledge levels and
   socio-demographic variables at p < 0.05. Results A total of 180 students
   participated (52.2\% female, 47.2\% male; mean age 22.6 +/- 2.9 years).
   Awareness of OH was limited: only 72 students (40.0\%) had heard of it,
   and 41 (22.8\%) could provide a correct definition. Social media (n =
   64, 35.6\%) and peer discussions (n = 49, 27.2\%) were the primary
   sources of information. Knowledge levels were significantly associated
   with academic level (chi \& sup2; = 5.60, p = 0.018) and field of study
   (chi \& sup2; = 6.89, p = 0.009) but not with gender (p = 0.743) or age
   (p = 0.183). Conclusion This institutional study reveals low awareness
   and understanding of OH among OAU undergraduates, with knowledge varying
   by level and field of study. While limited to a university and a
   relatively small convenience sample, the findings provide a baseline for
   future multi-institutional and stratified surveys. Integrating OH into
   curricula, strengthening student-led initiatives, and leveraging digital
   media may improve OH literacy among Nigerian university students.},
