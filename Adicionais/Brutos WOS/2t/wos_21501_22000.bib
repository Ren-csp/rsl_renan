@article{ WOS:000370371900010,
Author = {Henderson, Kirsten A. and Reis, Mateus and Blanco, Carolina C. and
   Pillar, Valerio D. and Printes, Rodrigo C. and Bauch, Chris T. and
   Anand, Madhur},
Title = {Landowner perceptions of the value of natural forest and natural
   grassland in a mosaic ecosystem in southern Brazil},
Journal = {SUSTAINABILITY SCIENCE},
Year = {2016},
Volume = {11},
Number = {2},
Pages = {321-330},
Month = {MAR},
Abstract = {The forest-grassland mosaics of southern Brazil have been subject to
   many land use and policy changes over the decades. Like many grasslands
   around the world, the Campos grasslands are declining with few
   conservation efforts underway. In contrast, forests receive much
   attention and many incentives. It is hypothesized that perception of
   land cover has the potential to shape ecosystems. Here we conduct a
   questionnaire to further our understanding of decision-making practices
   that alter landscapes (Campos grassland, Araucaria forest, agriculture
   and plantation) and direct land policies in the region. Our analysis
   reveals that plantations are significantly less desirable than the other
   landscape types. However, plantation land use has increased by 87 \%
   over the past few decades, as a result of industry and government
   incentives. The proportions of other landscape types have remained
   consistent over the past two decades. Restoration of native vegetation
   is not a priority of landowners and restoration would require a
   financial incentive.},
