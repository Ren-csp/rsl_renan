@article{ WOS:001469461500004,
Author = {Holladay, Patrick J. and Krishnamoorthy, Anand and Chadwick, Lane Boyte
   and Dixon, A. W. and Nguyen, Minh C. and Dixon, Harriet E. T. and
   Nguyen, Bao L.},
Title = {Stakeholder Perceptions of Riverine and Montane Ecotourism Development
   in Da Nang, Vietnam},
Journal = {TOURISM},
Year = {2025},
Volume = {73},
Number = {2},
Pages = {240-250},
Abstract = {The study explores Sustainable Development Goals (SDGs) and ecotourism
   in Da Nang, Vietnam, particularly in riverine and montane areas. The
   city's commitment aligns with SDGs, providing a blueprint for post-2015
   development. With a focus on ecotourism, Da Nang aims to create jobs,
   preserve local culture, and monitor impacts according to SDGs. The
   research unveils stakeholders' views on ecotourism, emphasizing its
   potential for employment and cultural preservation. Concerns persist
   over environmental impacts like water pollution and deforestation.
   Informal discussions highlight challenges like local displacement,
   rising prices, and the need for a sustainable plan. The paper suggests
   promoting environmental stewardship, community engagement, and service
   provisions. Acknowledging its theoretical nature, the study paves the
   way for future quantitative analysis, urging continuous research for Da
   Nang's sustainable ecotourism development.},
