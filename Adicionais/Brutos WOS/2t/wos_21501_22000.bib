@article{ WOS:000523138800001,
Author = {Miller, Shaleen},
Title = {Greenspace After a Disaster: The Need to Close the Gap With Recovery for
   Greater Resilience},
Journal = {JOURNAL OF THE AMERICAN PLANNING ASSOCIATION},
Year = {2020},
Volume = {86},
Number = {3},
Pages = {339-348},
Month = {JUL 2},
Abstract = {Parks and greenspace planning have often been limited to environmental
   planning; however, these spaces' ecological benefits may also protect
   communities from hazards and their negative outcomes, thereby increasing
   resiliency. Although hazard planning has begun to consider nature-based
   mitigation solutions, the postdisaster recovery planning of these
   greenspaces is rare. This can result in a loss of function, a delay in
   the return to normality, and lost opportunity for increasing park,
   greenspace, and community resilience. Here I discuss the nature of green
   infrastructure after a disaster, using examples from both literature and
   recent North American hurricanes, to suggest the need to add parks and
   greenspaces to recovery and resilience planning.},
