Author-Email = {derejetesema2011@gmail.com},
Affiliations = {Jimma University},
Cited-References = {Abrham Belay Abrham Belay, 2017, Agriculture and Food Security, V6, DOI {[}10.1186/s40066-017-0100-1, 10.1186/s40066-017-0100-1].
   Ajuang CO, 2016, SPRINGERPLUS, V5, DOI 10.1186/s40064-016-2699-y.
