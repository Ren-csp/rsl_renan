@article{ WOS:000834250500014,
Author = {Soto, Katihusca Rodriguez and Paz, Francisco and Leon, Arturo and
   Bastardo, Ruth H.},
Title = {First record of the family Ptiliidae (Insecta: Coleoptera:
   Staphylinoidea) for the extant fauna of Hispaniola},
Journal = {NOVITATES CARIBAEA},
Year = {2022},
Volume = {20},
Pages = {171-174},
Month = {JUL},
Abstract = {The family Ptiliidae (Coleoptera: Staphylinoidea) is recorded for the
   first time for the extant fauna of Hispaniola from specimens collected
   in litter from Mirador Norte Park and the National Botanical Garden
   ``Dr. Rafael Ma. Moscoso{''} in the Santo Domingo province and the El
   Canon del Rio Gurabo wildlife refuge, located in the municipality of
   Mao, Valverde province, in the northwest of the Dominican Republic. This
   finding brings the number of families of Coleoptera known for Hispaniola
   to 78.},
