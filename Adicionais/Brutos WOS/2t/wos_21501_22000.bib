@article{ WOS:000411286200006,
Author = {Barberena, Ramiro and Duran, Victor A. and Novellino, Paula and Winocur,
   Diego and Benitez, Anahi and Tessone, Augusto and Quiroga, Maria N. and
   Marsh, Erik J. and Gasco, Alejandra and Cortegoso, Valeria and Lucero,
   Gustavo and Llano, Carina and Knudson, Kelly J.},
Title = {Scale of human mobility in the southern Andes (Argentina and Chile): A
   new framework based on strontium isotopes},
Journal = {AMERICAN JOURNAL OF PHYSICAL ANTHROPOLOGY},
Year = {2017},
Volume = {164},
Number = {2},
Pages = {305-320},
Month = {OCT},
Abstract = {ObjectivesThe goal of this article is to assess the scale of human
   paleomobility and ecological complementarity between the lowlands and
   highlands in the southern Andes during the last 2,300 years. By
   providing isotope results for human bone and teeth samples, we assess a
   hypothesis of high residential mobility suggested on the basis of oxygen
   isotopes from human remains.
   MethodsWe develop an isotopic assessment of human mobility in a mountain
   landscape combining strontium and oxygen isotopes. We analyze bone and
   teeth samples as an approach to life-history changes in spatial
   residence. Human samples from the main geological units and periods
   within the last two millennia are selected.
   ResultsWe present a framework for the analysis of bioavailable strontium
   based on the combination of the geological data with isotope results for
   rodent samples. The Sr-87/Sr-86 values from human samples indicate
   residential stability within geological regions along life history. When
   comparing strontium and oxygen values for the same human samples, we
   record a divergent pattern: while O-18 values for samples from distant
   regions overlap widely, there are important differences in Sr-87/Sr-86
   values.
   ConclusionsDespite the large socio-economic changes recorded,
   Sr-87/Sr-86 values indicate a persisting scenario of low systematic
   mobility between the different geological regions. Our results suggest
   that strontium isotope values provide the most germane means to track
   patterns of human occupation of distinct regions in complex geological
   landscapes, offering a much higher spatial resolution than oxygen
   isotopes in the southern Andes.},
