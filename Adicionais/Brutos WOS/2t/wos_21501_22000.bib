@article{ WOS:000404486600008,
Author = {Lullfitz, Alison and Dortch, Joe and Hopper, Stephen D. and Pettersen,
   Carol and Reynolds, Ron (Doc) and Guilfoyle, David},
Title = {Human Niche Construction: Noongar Evidence in Pre-colonial Southwestern
   Australia},
Journal = {CONSERVATION \& SOCIETY},
Year = {2017},
Volume = {15},
Number = {2},
Pages = {201-216},
Month = {APR-JUN},
Abstract = {Through a lens of Human Niche Construction theory, we examine Noongar
   (an indigenous people of south western Australia) relationships with
   southwestern Australian flora and suggest influences of these
   relationships on contemporary botanical patterns in this global
   biodiversity hotspot. By conducting a review of historical and
   contemporary literature and drawing upon the contemporary knowledge of
   Noongar Elders, we examine the merits of five key hypotheses of human
   niche construction theory in relation to this large cultural group. We
   find compelling evidence that supports Noongar niche construction, but
   caution that further research is required to test its likely ecological
   and evolutionary outcomes. We suggest that further collaborative,
   multi-disciplinary research that applies Noongar and Western science
   will lead to a greater understanding of the biological assets of
   southwestern Australia.},
