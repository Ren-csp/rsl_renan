@article{ WOS:001783398000001,
Author = {Kinnunen, Antti and Raudsepp, Johanna and Heinonen, Jukka},
Title = {More urban greenness associated with flying less among Nordic urbanites},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {8},
Number = {6},
Month = {JUN 1},
Abstract = {Urban areas cause a considerable portion of global emissions, driven by
   high levels of individual mobility and excessive consumption.
   Mobility-related carbon footprints make up around 30\% of household
   consumption-based carbon footprints in affluent locations like the
   Nordics. Although people take few long-distance trips per year, they
   make up the majority share of personal travel emissions. Urban greenness
   has shown positive impacts on reducing local travel emissions and
   increasing well-being. This study examines the relationships between
   urban greenness and flying within a sample of 3502 Nordic urban
   residents across a range of buffer zones of 1, 5, 10, and 15 km from
   their home location. Quantity, accessibility, and connectivity of green
   spaces are combined for a composite index of urban greenness, which
   association to both probability and frequency of flying are analysed
   utilising a two-phase hurdle-model in a fully Bayesian framework. The
   results indicate a considerable probability that higher levels of urban
   greenness at varying distances from home are associated with flying
   less, even after accounting for other known confounders. The impact for
   the probability of flying exhibited a quadratic trend, being strongest
   at the 1 km and 15 km buffer zones away from home. For the frequency of
   flying the impact gradually intensified, being noticeably highest at the
   10 and 15 km buffer zones. The results highlight the multifaceted role
   of urban green spaces in climate change adaptation and mitigation,
   including their potential in reducing emissions from long-distance
   leisure travel and increasing the well-being of urban residents.},
