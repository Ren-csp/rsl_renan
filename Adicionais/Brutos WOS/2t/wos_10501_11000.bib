@article{ WOS:001135193000006,
Author = {Garcia-Lluelles, Eva and Valiente, Gemma Canoves and Casalprim-Ramonet,
   Montserrat},
Title = {The impact of tourism in Andorra: the perception of residents},
Journal = {CUADERNOS DE TURISMO},
Year = {2023},
Number = {52},
Month = {JUL-DEC},
Abstract = {This paper analyzes the perception of the residents from a consolidated
   tourist destination on the economic, sociocultural and environmental
   impacts of the tourism model, as well as their satisfaction with it. The
   perception of 372 residents of Andorra is measured, based on the
   quantitative information obtained in a satisfaction survey. The results
   show that residents constitute a conscious and critical population aware
   of the tourism model, main economic sector of the Andorran economy. This
   information has implications for the management of tourism in the
   country.},
