@article{ WOS:001487086700002,
Author = {Buchanich, Jeanine M. and Covert, Hannah H. and Macias, Rachel E. and
   Tedesco, Nicholas R. and Ng, Carla and Byrwa-Hill, Brandy and Lichtveld,
   Maureen and Fabisiak, James P.},
Title = {Community Perceptions of Health Risks Associated With a Petrochemical
   Plant in Beaver County, Pennsylvania},
Journal = {JOURNAL OF ENVIRONMENTAL HEALTH},
Year = {2025},
Volume = {87},
Number = {9},
Month = {MAY},
Abstract = {We surveyed residents in Beaver County, Pennsylvania, to explore their
   perceptions on health in the months leading up to the November 2022
   opening of a petrochemical plant (specifically, an ethylene cracker
   plant) in the county. An online survey collecting demographics,
   self-reported health habits, perceived community and personal health
   status, and attitudes toward environmental health was distributed from
   July 2022 through August 2023. Descriptive statistics were generated and
   chi-square tests of independence were calculated. A total of 436 adult
   residents of Beaver County completed the survey. Respondents indicated
   concerns about their current exposure to air pollution (76\%) and unsafe
   drinking water (65\%). Approximately 36\% and 25\% of survey respondents
   indicated that they felt their health had been harmed by air pollution
   or unsafe drinking water, respectively. Perceived health and specific
   health habits were associated with agreeing or disagreeing with the
   statements ``My health has been harmed by unsafe drinking water{''} and
   ``My health has been harmed by air pollution.{''} These data illustrate
   that there is high concern about current and future exposure to
   pollution in Beaver County. These findings can assist community leaders
   in addressing and advocating for participant concerns about exposure to
   air and water pollution. A follow-up survey will be conducted to
   determine if there have been changes in perceptions since},
