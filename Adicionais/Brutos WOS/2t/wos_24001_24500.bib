@article{ WOS:000761780300001,
Author = {Chang, Robin A.},
Title = {Rhythmic processes of temporary use: understanding spatially detached
   stabilization through fuzzy-set qualitative comparative analysis},
Journal = {URBAN RESEARCH \& PRACTICE},
Year = {2023},
Volume = {16},
Number = {3},
Pages = {394-417},
Month = {MAY 27},
Abstract = {Considering the climbing interest to relate temporary uses with
   long-term change, this contribution explores how temporary uses
   demonstrate spatially detached stabilization (SDS) as well as the
   factors supporting this process. A rhythmanalytical approach helps
   reframe SDS temporally, while insights from existing research in the
   context of urban regeneration inform a fuzzy-set Qualitative Comparative
   Analysis (fsQCA) accounting for seven different factors. The
   contribution analyses data collected from 40 cases in the cities of
   Bremen (DE) and Rotterdam (NL) to reveal that combinations of factors
   support the trajectories of SDS. These foreground spatial and functional
   concerns and invite further inquiry.},
