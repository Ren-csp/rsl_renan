@article{ WOS:000581952900012,
Author = {Naghdibak, Farhoodeh and Afrougheh, Shahram and Azizmohammadi, Fatemeh},
Title = {An Ecocritical Criticism of McCarthy's the Crossing and Cities of the
   Plain},
Journal = {APPLIED LINGUISTICS RESEARCH JOURNAL},
Year = {2020},
Volume = {4},
Number = {6},
Pages = {84-91},
Abstract = {The aim of the present study is to investigate McCarthys novels, The
   Crossing and Cities of The Plain, from ecocritical perspective. The
   researcher attempts to show the importance of nature and
   anthropocentricism in order to depict that McCarthy is concerned with
   the concept of nature. The main framework in the present essay is based
   on ecocriticism and ecofeminist theories. To do this essay, the
   researcher employs theories of different ecologists and ecofeminists. In
   the present study, the researcher mostly uses Ecocritic and Ecofeminist
   approaches to show how women, culture, and nature share common features.
   The main theorists that the researcher wants to use are Lawrence Buell
   (1939), Cheryll Glotfelty (1958), Hubert Zapf (1948), and Karen Warren
   (1947). In this essay, several questions are raised that must be
   answered. The questions include: How does the author depict the
   relationship between culture and nature in the selected novels? How are
   peoples anthropocentric attitudes depicted towards the nature? And How
   does the author show the role of female otherness and nature within the
   selected novels? The novels are filled with various references to the
   concept of nature regarding both physical environment and also other
   creatures as natural organisms which require constant attention of man.
   It can be concluded that the researcher depicts emphasis on the
   inter-relationships, and the mutual interdependence of all the elements
   comprising on human life. Nature and culture do not oppose each other
   and every single change in the culture, changes the viewpoint toward the
   nature with a noticeable effect.},
