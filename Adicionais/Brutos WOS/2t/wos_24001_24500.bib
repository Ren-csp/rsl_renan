@article{ WOS:000737175500001,
Author = {Lupp, Gerd and Huang, Joshua J. and Zingraff-Hamed, Aude and Oen, Amy
   and Del Sepia, Nicola and Martinelli, Alberto and Lucchesi, Massimo and
   Wulff Knutsen, Turid and Olsen, Mari and Fjosne, Trine Frisli and
