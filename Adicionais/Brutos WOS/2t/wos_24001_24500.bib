@article{ WOS:000271419200031,
Author = {Fullwood, Melissa J. and Liu, Mei Hui and Pan, You Fu and Liu, Jun and
   Xu, Han and Bin Mohamed, Yusoff and Orlov, Yuriy L. and Velkov, Stoyan
   and Ho, Andrea and Mei, Poh Huay and Chew, Elaine G. Y. and Huang,
