@article{ WOS:001801814100001,
Author = {Palazzo, Giampiero and Valenza, Giuseppe and Zuccaro, Massimo and Pizzi,
   Simone},
Title = {Voices From the Coast: Stakeholder Participation and Perception on
   Creating a Marine Protected Area},
Journal = {BUSINESS STRATEGY AND THE ENVIRONMENT},
Year = {2026},
Month = {2026 JUN 25},
Abstract = {This study explores participatory processes in the context of marine
   conservation, with a specific focus on recent initiatives undertaken by
   the Apulia region in Italy to establish a new Marine Protected Area
   (MPA). Employing a qualitative cross-sectional methodology, the study
   investigates how local communities perceive and engage with the MPA
   creation process, identifying the key constraints and opportunities that
   shape their participation. The research aims to address a significant
   gap in the literature concerning stakeholder engagement in marine
