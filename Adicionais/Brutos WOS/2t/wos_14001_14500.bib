@article{ WOS:001582024700003,
Author = {Al-Awadhi, Talal and Al-Awadhi, Khalid and Al-Awadhi, Haya and Al
   Nasiri, Noura and Abulibdeh, Ammar and El Kenawy, Ahmed},
Title = {An exploratory assessment of cyclone risk perceptions in Oman: A
   snowball sampling study of community awareness},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {Cyclones represent one of the most prevalent natural hazards affecting
   Oman, posing significant risks to communities, infrastructure, and
   economic stability. Despite government efforts in disaster preparedness
   and mitigation, a critical gap remains in public risk perception,
   particularly regarding demographic disparities in how cyclone risks are
   perceived. In this study, cyclone perceptions are defined as the
   awareness of a hazard, understanding its potential impacts, and being
   mentally and behaviorally prepared to respond effectively. Our study
   investigates how demographic factors, such as gender, age, education
   level, and prior cyclone exposure, influence cyclone risk perceptions
   among Omani residents. Data were collected from 238 participants across
   Oman using an online survey, which included Likert-scale questions on
   personal experiences, perceived risks, and government preparedness. The
   findings reveal that education and age significantly influence risk
   perceptions, while gender has a minimal impact. Specifically,
   individuals with higher levels of education and older age groups
   demonstrate greater awareness and preparedness. Additionally, repeated
   exposure to cyclones moderately enhances risk perceptions, highlighting
   the importance of direct experience. Given the escalating threats
   associated with climate change, enhancing public risk perception through
   targeted educational initiatives is crucial for strengthening community
   resilience and improving disaster response in Oman. This study offers
   valuable insights for policymakers to develop more effective risk
   communication and climate adaptation strategies.},
