@article{ WOS:001858410500001,
Author = {Navas-Orozco, Antonio and Moron-Fernandez, Maria-Jose and Diaz-del-Rio,
   Fernando and Cardenas-Montes, Miguel and Ragel-Diaz-Jara, David and
   Morera-Figueroa, Jose and Guisado-Lizar, Jose-Luis},
Title = {A hybrid simulation framework for modelling and analysing urban traffic
   pollution under key influencing factors},
Journal = {URBAN CLIMATE},
Year = {2026},
Volume = {69},
Month = {SEP},
Abstract = {Traffic pollution in urban areas is a complex phenomenon influenced by
   vehicle emissions, wind patterns, and urban layouts. To address this
   complexity, this study introduces a comprehensive hybrid simulation
   framework that couples microscopic traffic dynamics with a pollution
   dispersion model. Our framework estimates emissions from individual
   vehicles (electric, petrol and diesel) and computes pollution levels at
   every position within the urban grid, enabling a detailed analysis of
   pollution evolution and supporting the development of effective
   mitigation strategies. Our main contributions include the joint
   modelling of exhaust and non-exhaust emissions (such as particulate
   matter from tyre, brake, road wear and dust resuspension), and a
   qualitative analysis of the non-linear role of wind and urban geometry
   in pollutant dispersion. Our key findings demonstrate that wind speed
   profoundly impacts total pollution levels. Furthermore, our analysis of
   urban planning strategies reveals that the spatial configuration of
   buildings plays a critical role in air quality: aligning buildings
   parallel with prevailing wind directions significantly enhances
   pollution dispersion , improving pollution levels by up to 26\%, whereas
   orthogonal alignments create stagnation zones that trap contaminants.
   Similar findings are obtained using the real urban layout of the
   Sevillian district Nervi \& oacute;n. These insights underscore the
   importance of synergizing traffic management with topology-aware urban
   design. Based on 16,800 large-scale simulations, our simulation
   framework's statistical robustness is validated, and empirical
   relationships between traffic density, vehicle composition, wind
   effects, and pollution patterns are established, offering a scalable
   simulation framework tool for synthetic environments, easily extensible
   to real urban scenarios.},
