@article{ WOS:001843977700001,
Author = {Howarth, Candice and Bedenk-Smith, Anna},
Title = {Public perceptions of extreme heat: A review},
Journal = {ENVIRONMENTAL SCIENCE \& POLICY},
Year = {2026},
Volume = {183},
Month = {SEP},
Abstract = {This review explores the international literature on public perceptions
   of extreme heat, highlighting significant geographical and
   methodological gaps. Using Scopus, search terms such as ``heat wave{''}
   and ``heat stress{''} were iteratively refined leading to 66 articles
   directly addressing public perceptions to heat risk, excluding broader
   topics such as adaptation or health risks. Our assessment of the
   literature highlights four important findings: firstly, that published
   research is predominantly focused on high-income, Global North
   countries, with underrepresentation of vulnerable regions in the Global
   South, such as sub-Saharan Africa, South Asia, and South America.
   Secondly, that most studies rely on quantitative surveys, which, while
   broad, often overlook the sociocultural dimensions of heat perception.
   Thirdly, we find that qualitative and mixed-methods approaches are
   underutilized but essential for understanding the nuanced experiences of
   vulnerable populations, including outdoor workers, older adults, and
   marginalized groups such as the homeless and those with disabilities.
   Fourthly, vulnerability to heat, a dominant theme in the literature, is
   framed largely in terms of physical health and socioeconomic factors,
   yet research considering compound risks is lacking. Finally, we find
   that communication strategies, particularly heat warnings, often fail to
   motivate protective actions due to issues of trust and cultural
   relevance. We conclude by outlining how future research should adopt a
   more inclusive, interdisciplinary approach to inform effective
   adaptation strategies and public policies.},
