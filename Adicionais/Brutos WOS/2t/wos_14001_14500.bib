   Yubero-Martinez, Miguel, Colegio Britan Int Hastings Sch, Madrid, Spain.
   Fesharaki, Omid, Univ Complutense Madrid, Dept Didact Ciencias Expt Sociales \& Matemat, Madrid, Spain.},
DOI = {10.25267/Rev\_Eureka\_ensen\_divulg\_cienc.2026.v23.i2.2202},
Article-Number = {2202},
ISSN = {1697-011X},
