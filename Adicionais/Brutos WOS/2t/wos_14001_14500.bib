@article{ WOS:001851107600001,
Author = {Paulusova, Ivana and Sharmeen, Fariya},
Title = {Perceived bikeability: A synthesis of evidence and a needs-based
   assessment framework},
Journal = {JOURNAL OF URBAN MOBILITY},
Year = {2026},
Volume = {10},
Month = {DEC},
Abstract = {Accessibility is increasingly receiving its long overdue emphasis in
   urban planning and mobility research. Traditionally, accessibility has
   been evaluated using objective indicators such as infrastructure
   quality, travel time or geographical reach. Recently, a growing body of
   research highlights the role of perceptions, which capture how
   individuals experience and evaluate their ability to reach destinations
   in light of personal and social circumstances. The research has also
   frequently identified considerable discrepancies between objective and
   perceived measures, underscoring the need for further investigation.
   Within this literature, cycling has received comparatively limited
   attention, and perceived bikeability remains underexplored relative to
   accessibility by other transport modes, despite cycling's
   well-documented environmental, economic, and health benefits. This paper
   addresses this gap by advancing the conceptualisation and assessment of
   perceived bikeability. First, through a systematic literature review of
   39 identified publications, the paper examines existing definitions,
   approaches, and operationalisations related to perceived bikeability. It
   synthesises evidence on its key determinants and outcomes, highlighting
   the main methodological limitations. Second, the paper proposes a
   comprehensive conceptual framework integrating perceived and objective
   bikeability with individual and social characteristics influencing
   cycling behaviour, emphasising the mediating role of perceptions. In
   response to the existing methodological challenges, the paper proposes a
   multidimensional hierarchical framework for assessing perceived
   bikeability, grounded in a needs-based perspective inspired by Maslow's
   theory of human motivation. By clarifying the factors that shape
   perceptions of bikeability and how these perceptions influence cycling
   behaviour, this study contributes to the development of more robust and
   equitable measures to support cycling planning and promotion.},
