@article{ WOS:001744848900001,
Author = {Gonzalez, Vicente Estrada and Li, Shirley and Cardillo, Eileen R. and
   Chatterjee, Anjan},
Title = {Murals and neighborhoods: The impact of public art in Philadelphia},
Journal = {CITIES},
Year = {2026},
Volume = {174},
Month = {JUL},
Abstract = {The present study explores the impact of public art, specifically
   murals, on two different urban neighborhoods of Philadelphia-West
   Philadelphia and Center City. We tested the hypotheses that aesthetic
   experiences are modulated by socioeconomic and cultural contexts in
   which they are apprehended and that art changes perceptions of
   neighborhoods. Participants assessed their aesthetic experience in city
   blocks with and without murals in both neighborhoods. Perceptions of
   safety, cleanliness, noise, interestingness and residents' friendliness
   were evaluated before and after looking at the murals. We found that
   murals enhanced perceptions of beauty, liking, and positive emotional
   impacts in both neighborhoods. Murals in West Philadelphia were liked
   better. Moreover, people were more immersed and felt transformed by
   those murals than by those in Center City. Importantly, the murals
   influenced neighborhood perceptions, improving perceived safety and
   interest in West Philadelphia and reducing perceived noise and
   uncleanliness in Center City. These findings highlight the potential of
   public art to enrich the experience of urban spaces both within and
   across neighborhoods, particularly in areas facing socioeconomic
   challenges. Public art can be a powerful tool to enhance the visual and
   emotional landscape of cities, fostering positive social and cultural
   narratives in urban environments.},
