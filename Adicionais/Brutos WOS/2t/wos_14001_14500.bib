@article{ WOS:001855308400001,
Author = {El Haddaji, Basma and Vasilikou, Carolina},
Title = {Marrakech at the intersection: Hybrid identity and the politics of urban
   inclusion},
Journal = {CITIES},
Year = {2026},
Volume = {179},
Month = {DEC},
Abstract = {In Marrakech, urban space is increasingly governed through the
   instrumentalization of local identity as a tool of economic development.
   This paper examines how the medina, historically a lived, adaptive, and
   socially-dense urban fabric, has become a primary site through which
   hybrid local identity is fixed and mobilized in service of tourism-led,
   neoliberal urbanism. Building on the distinction between plural
   identities, as multiple and competing identity claims, and hybrid
   identity, where one synthesis is stabilized as the legitimate
   representation of place, the paper argues that exclusion emerges not
   only through heritage commodification but through the
   institutionalization of a single, governable narrative. Drawing on
   diachronic morphological analysis, cartographic mapping, and an audit of
   planning instruments, the study traces how this process extends colonial
   logics of aesthetic fixing and epistemic control. Framed through spatial
   justice and the ``right-to-the-city{''}, this study shows how selective
   preservation and visibility regimes recast the medina as an open-air
   museum, producing a dual-spatial order: a selectively-regulated historic
   core preserved for global consumption, and a retrospectivelyregulated
   periphery absorbing displaced populations. These dynamics reshape access
   to housing, public space, and mobility, displacing vulnerable
   populations toward peripheral areas while consolidating symbolic and
   economic value in the historic core. By situating Marrakech within
   broader debates on neoliberal urbanism and postcolonial governance, this
   paper contributes an empirically-grounded account of how identity-based
