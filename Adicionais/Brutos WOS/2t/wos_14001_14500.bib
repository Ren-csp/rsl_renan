@article{ WOS:001217486400001,
Author = {Balzekiene, Aiste and Echavarren, Jose M. and Telesiene, Audrone},
Title = {The effect of proximity on risk perception: A systematic literature
   review},
Journal = {CURRENT SOCIOLOGY},
Year = {2025},
Volume = {73},
Number = {6},
Pages = {975-994},
Month = {OCT},
Abstract = {The use of geospatial analytical tools has recently advanced risk
   perception research, with growing interest in spatial dimension.
   Available reviews of risk perception studies usually focus on specific
   types of risk or look at various socio-psychological, cognitive and
   cultural factors, and there are no systematic reviews of empirical
   research analysing the effect of proximity on risk perception. This
   article synthesizes the evidence from 81 empirical studies that
   investigate the significance of proximity on subjective risk perception.
   The systematic review focused on summaries of research methods, samples,
   geographic coverage, measurements and direction of influence of
   proximity variables on risk perception and types and sources of risk.
   The majority of the studies analysed implemented quantitative research.
   The most popular data collection methods were face-to-face interviews
   and postal surveys, but only half had representative samples. Studies
   looking into the effect of proximity on risk perception most often
   analysed environmental and technological risks. Two-thirds of the
   empirical studies found a significant impact of proximity on risk
   perception; the majority of these showed a positive correlation, with
   respondents living closer to hazards having higher risk perceptions.
   Negative correlations of risk perception with proximity are more
   characteristic of nuclear risks. Co-occurrence analysis of
   sources-of-risk and objects-at-risk has identified three most frequent
   clusters: impact of floods on economic properties; impact of other
   natural hazards on economic properties and impact of industrial
   facilities on health and lives.
   L'utilization d'outils d'analyse d'ordre g \& eacute;ospatial a r \&
   eacute;cemment fait progresser la recherche sur la perception du risque,
   avec un int \& eacute;r \& ecirc;t croissant pour la dimension spatiale.
   Les analyses disponibles des \& eacute;tudes sur la perception du risque
   se concentrent g \& eacute;n \& eacute;ralement sur des types de risques
   sp \& eacute;cifiques ou s'int \& eacute;ressent \& agrave; divers
   facteurs socio-psychologiques, cognitifs et culturels, et il n'existe
   pas de revue syst \& eacute;matique des recherches empiriques portant
   sur l'effet de la proximit \& eacute; sur la perception du risque. Cet
   article offre une synth \& egrave;se des r \& eacute;sultats de 81 \&
   eacute;tudes empiriques portant sur l'influence de la proximit \&
   eacute; sur la perception subjective du risque. La revue syst \&
   eacute;matique s'est concentr \& eacute;e sur les r \& eacute;sum \&
   eacute;s des m \& eacute;thodes de recherche, les \& eacute;chantillons,
   la couverture g \& eacute;ographique, les mesures et la direction de
   l'influence des variables de proximit \& eacute; sur la perception du
   risque, ainsi que les types et les sources de risque. La majorit \&
   eacute; des \& eacute;tudes analys \& eacute;es ont mis en oe uvre des
   recherches quantitatives. Les m \& eacute;thodes de collecte de donn \&
   eacute;es les plus utilis \& eacute;es \& eacute;taient les entretiens
   individuels et les enqu \& ecirc;tes postales, mais seulement la moiti
   \& eacute; disposaient d'\& eacute;chantillons repr \& eacute;sentatifs.
   Les \& eacute;tudes portant sur l'effet de la proximit \& eacute; sur la
   perception du risque concernaient le plus souvent les risques
   environnementaux et technologiques. Deux tiers des \& eacute;tudes
   empiriques ont r \& eacute;v \& eacute;l \& eacute; un impact
   significatif de la proximit \& eacute; sur la perception du risque; la
   majorit \& eacute; d'entre elles ont montr \& eacute; une corr \&
   eacute;lation positive, c'est-\& agrave;-dire que les personnes interrog
   \& eacute;es qui vivaient plus pr \& egrave;s des dangers avaient une
   perception des risques plus \& eacute;lev \& eacute;e. Les corr \&
   eacute;lations n \& eacute;gatives entre la perception du risque et la
   proximit \& eacute; se retrouvent davantage dans le cas des risques nucl
   \& eacute;aires. L'analyse de la co-occurrence des sources de risque et
   des objets \& agrave; risque a permis d'identifier les trois
   associations les plus fr \& eacute;quentes: l'impact des inondations sur
   les biens \& eacute;conomiques, l'impact d'autres catastrophes
   naturelles sur les biens \& eacute;conomiques, et l'impact des
   installations industrielles sur la sant \& eacute; et la vie des
   personnes.
   El uso de herramientas geoespaciales de an \& aacute;lisis ha hecho
   avanzar la investigaci \& oacute;n sobre la percepci \& oacute;n del
   riesgo en los \& uacute;ltimos tiempos, con un inter \& eacute;s
   creciente en la dimensi \& oacute;n espacial. Los an \& aacute;lisis
   disponibles sobre estudios de la percepci \& oacute;n del riesgo se
   centran generalmente en tipos espec \& iacute;ficos de riesgo o analizan
   diversos factores sociopsicol \& oacute;gicos, cognitivos y culturales,
   y no hay una revisi \& oacute;n sistem \& aacute;tica de investigaciones
   emp \& iacute;ricas que analicen el efecto de la proximidad en la
   percepci \& oacute;n del riesgo. Este art \& iacute;culo sintetiza la
   evidencia de 81 estudios emp \& iacute;ricos que investigan la
   importancia de la proximidad en la percepci \& oacute;n subjetiva del
   riesgo. La revisi \& oacute;n sistem \& aacute;tica se centr \& oacute;
   en una an \& aacute;lisis de los m \& eacute;todos de investigaci \&
   oacute;n, las muestras, la cobertura geogr \& aacute;fica, las
   mediciones y la direcci \& oacute;n de la influencia de las variables de
   proximidad en la percepci \& oacute;n del riesgo, as \& iacute; como los
   tipos y fuentes de riesgo. La mayor \& iacute;a de los estudios
   analizados implementaron investigaci \& oacute;n cuantitativa. Los m \&
   eacute;todos de recopilaci \& oacute;n de datos m \& aacute;s habituales
   fueron las entrevistas cara a cara y las encuestas postales, pero s \&
   oacute;lo la mitad ten \& iacute;a muestras representativas. Los
   estudios que analizan el efecto de la proximidad en la percepci \&
   oacute;n del riesgo analizan en mayor medida los riesgos ambientales y
   tecnol \& oacute;gicos. Dos tercios de los estudios emp \& iacute;ricos
   encontraron un impacto significativo de la proximidad en la percepci \&
   oacute;n del riesgo. La mayor \& iacute;a de ellos mostraron una
   correlaci \& oacute;n positiva. Es decir, los encuestados que viv \&
   iacute;an m \& aacute;s cerca de los peligros ten \& iacute;an
   percepciones de riesgo m \& aacute;s altas. Las correlaciones negativas
   entre la percepci \& oacute;n del riesgo y la proximidad son m \&
   aacute;s t \& iacute;picas de los riesgos nucleares. El an \&
   aacute;lisis de coocurrencia de fuentes de riesgo y objetos en riesgo ha
   identificado los tres clusters m \& aacute;s frecuentes: el impacto de
   las inundaciones en bienes econ \& oacute;micos, el impacto de otros
   peligros naturales en bienes econ \& oacute;micos y el impacto de las
   instalaciones industriales en la salud y las vidas.},
