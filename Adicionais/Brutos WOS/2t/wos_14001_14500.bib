@article{ WOS:000805427200001,
Author = {Li, Jiaqi and Lee, Timothy J. and Chen, Nan and Park, Keun-Soo},
Title = {Pro-environmental behaviour of the residents in sensitive tourism
   destinations},
Journal = {JOURNAL OF VACATION MARKETING},
Year = {2023},
Volume = {29},
