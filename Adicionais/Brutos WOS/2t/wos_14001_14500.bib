@article{ WOS:A1978EW97900001,
Author = {TOMIALOJC, L},
Title = {INFLUENCE OF PREDATORS ON BREEDING WOODPIGEONS IN LONDON PARKS},
Journal = {BIRD STUDY},
Year = {1978},
Volume = {25},
Number = {1},
Pages = {2-10},
Abstract = {The density of woodpigeons {[}Columba palumbus] in St. James''s Park
   {[}London, England] was 4 times higher than in the larger Kensington
   Gardens, which are less influenced by urban factors (35-40 and 9-10
   pairs/10 ha, respectively). The total breeding losses were similar in
   both (66-67\%), although they showed an opposite pattern in relation to
   nest height. {[}Predators were Coruus corone, Strix aluco, Pica pica,
   Falco tinnunculus and Garrulus glandarius]. Urban and rural English
   populations of the woodpigeon represent a secondary state of marked
   overpopulation due to long-term reduction in numbers of their natural
   enemies. Other patterns in ecology of the woodpigeon detected in several
   habitats studied in Europe are results of changes in space and time of
   the intensity of predation pressure.},
