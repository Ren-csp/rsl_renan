@article{ WOS:000445329000017,
Author = {Whelan, Donna R. and Lee, Wei Ting C. and Yin, Yandong and Ofri, Dylan
   M. and Bermudez-Hernandez, Keria and Keegan, Sarah and Fenyo, David and
   Rothenberg, Eli},
Title = {Spatiotemporal dynamics of homologous recombination repair at single
   collapsed replication forks},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {SEP 24},
Abstract = {Homologous recombination (HR) is a crucial pathway for the repair of DNA
   double-strand breaks. BRCA1/2 breast cancer proteins are key players in
   HR via their mediation of RAD51 nucleofilament formation and function;
   however, their individual roles and crosstalk in vivo are unknown. Here
   we use super-resolution (SR) imaging to map the spatiotemporal kinetics
   of HR proteins, revealing the interdependent relationships that govern
   the dynamic interplay and progression of repair events. We show that
   initial single-stranded DNA/RAD51 nucleofilament formation is mediated
   by RAD52 or, in the absence of RAD52, by BRCA2. In contrast, only BRCA2
   can orchestrate later RAD51 recombinase activity during homology search
   and resolution. Furthermore, we establish that upstream BRCA1 activity
   is critical for BRCA2 function. Our analyses reveal the underlying
   epistatic landscape of RAD51 functional dependence on RAD52, BRCA1, and
   BRCA2 during HR and explain the phenotypic similarity of diseases
   associated with mutations in these proteins.},
