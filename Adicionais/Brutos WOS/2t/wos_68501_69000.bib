@article{ WOS:001560932300019,
Author = {Jeong, Chaehwa and Lee, Juhyeok and Jo, Hyesung and Lee, Kwangho and
   Lee, Sangjae and Ophus, Colin and Ercius, Peter and Cho, Eunae and Yang,
   Yongsoo},
Title = {Atomic-scale 3D structural dynamics and functional degradation of Pt
   alloy nanocatalysts during the oxygen reduction reaction},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {AUG 28},
Abstract = {Pt-based electrocatalysts are the primary choice for fuel cells due to
   their superior oxygen reduction reaction (ORR) activity. To enhance ORR
   performance and durability, extensive studies have investigated
   transition metal alloying, doping, and shape control to optimize the
   three key governing factors for ORR: geometry, local chemistry, and
   strain of their surface and subsurface. However, systematic optimization
   remains incomplete, as it requires an atomic-scale understanding of
   these factors and their dynamics over potential cycling, as well as
   their relationship to ORR activity. Here, we implement neural
   network-assisted atomic electron tomography to measure the 3D atomic
   structural dynamics and their effects on the functional degradation of
   PtNi alloy catalysts. Our results reveal that PtNi catalysts undergo
   shape changes, surface alloying, and strain relaxation during cycling,
   which can be effectively mitigated by Ga doping. By combining geometry,
   local chemistry, and strain analysis, we calculated the changes in ORR
   activity over thousands of cycles and observed that Ga doping leads to
   higher initial activity and greater stability. These findings offer a
   pathway to understanding 3D atomic structural dynamics and their
   relation to ORR activity during cycling, paving the way for the
   systematic design of durable, high-efficiency nanocatalysts.},
