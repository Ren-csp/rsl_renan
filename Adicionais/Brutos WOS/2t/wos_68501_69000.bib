@article{ WOS:001023549000020,
Author = {Ye, Xuan and Yang, Wen and Yi, Soon and Zhao, Yanan and Varani, Gabriele
   and Jankowsky, Eckhard and Yang, Fan},
Title = {Two distinct binding modes provide the RNA-binding protein RbFox with
   extraordinary sequence specificity},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {FEB 9},
Abstract = {Specificity of RNA-binding proteins for target sequences varies
   considerably. Yet, it is not understood how certain few proteins achieve
   markedly higher sequence specificity than most others. Here we show that
   the RNA Recognition Motif of RbFox accomplishes extraordinary sequence
   specificity by employing functionally and structurally distinct binding
   modes. Affinity measurements of RbFox for all binding site variants
   reveal the existence of two distinct binding modes. The first
   exclusively accommodates cognate and closely related RNAs with high
   affinity. The second mode accommodates all other RNAs with reduced
   affinity by imposing large thermodynamic penalties on non-cognate
   sequences. NMR studies indicate marked structural differences between
   the two binding modes, including large conformational rearrangements
   distant from the RNA-binding site. Distinct binding modes by a single
   RNA-binding module explain extraordinary sequence selectivity and reveal
   an unknown layer of functional diversity, cross talk and regulation in
   RNA-protein interactions.
   Here the authors show that the RRM of RbFox accomplishes extraordinary
   sequence specificity by employing functionally and structurally distinct
   binding modes - one for its cognate RNA and one for all non-cognate
   RNAs.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Jankowsky, E (Corresponding Author), Case Western Reserve Univ, Ctr RNA Sci \& Therapeut, Sch Med, Cleveland, OH 44106 USA.
