@article{ WOS:000571782500001,
Author = {Zheng, Yunting and Zhang, Xin and Sun, Xinying and Shi, Yuhui and Chang,
   Chun},
Title = {Evaluation of the college-based HIV/AIDS education policy in Beijing,
   China: a mixed method approach},
