@article{ WOS:000494465700041,
Author = {Edelman, Nathaniel B. and Frandsen, Paul B. and Miyagi, Michael and
   Clavijo, Bernardo and Davey, John and Dikow, Rebecca B. and
   Garcia-Accinelli, Gonzalo and Van Belleghem, Steven M. and Patterson,
   Nick and Neafsey, Daniel E. and Challis, Richard and Kumar, Sujai and
   Moreira, Gilson R. P. and Salazar, Camilo and Chouteau, Mathieu and
   Counterman, Brian A. and Papa, Riccardo and Blaxter, Mark and Reed,
   Robert D. and Dasmahapatra, Kanchon K. and Kronforst, Marcus and Joron,
   Mathieu and Jiggins, Chris D. and McMillan, W. Owen and Di Palma,
   Federica and Blumberg, Andrew J. and Wakeley, John and Jaffe, David and
   Mallet, James},
Title = {Genomic architecture and introgression shape a butterfly radiation},
Journal = {SCIENCE},
Year = {2019},
Volume = {366},
Number = {6465},
Pages = {594+},
Month = {NOV 1},
Abstract = {We used 20 de novo genome assemblies to probe the speciation history and
   architecture of gene flow in rapidly radiating Heliconius butterflies.
   Our tests to distinguish incomplete lineage sorting from introgression
   indicate that gene flow has obscured several ancient phylogenetic
   relationships in this group over large swathes of the genome.
   Introgressed loci are underrepresented in low-recombination and
   gene-rich regions, consistent with the purging of foreign alleles more
   tightly linked to incompatibility loci. Here, we identify a hitherto
   unknown inversion that traps a color pattern switch locus. We infer that
   this inversion was transferred between lineages by introgression and is
   convergent with a similar rearrangement in another part of the genus.
   These multiple de novo genome sequences enable improved understanding of
   the importance of introgression and selective processes in adaptive
   radiation.},
