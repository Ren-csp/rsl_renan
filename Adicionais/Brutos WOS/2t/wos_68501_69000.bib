@article{ WOS:001074470100001,
Author = {Giacomini, Fiona L. and Prempeh, John A. and Jalonen, Riina and Vinceti,
   Barbara and Ekue, Marius and Bosshard, Ennia and Burslem, David F. R. P.
   and Kettle, Chris J.},
Title = {Seeding African Forest and Landscape Restoration: Evaluating Native Tree
   Seed Systems in Four African Countries},
Journal = {DIVERSITY-BASEL},
Year = {2023},
Volume = {15},
Number = {9},
Month = {SEP},
Abstract = {Commitments to Forest and Landscape Restoration are rapidly growing and
   being implemented globally to tackle the climate and biodiversity
   crises. Restoration initiatives largely based on tree planting
   necessitate an increased supply of high-quality and suitably adapted
   tree planting material. We evaluated the native tree seed supply systems
   in Burkina Faso, Cameroon, Ghana, and Kenya, four countries with large
   commitments to increase tree cover. We applied an established indicator
   framework to assess the adequacy of any current tree seed system to meet
   national needs. The study aimed to analyse (i) how well-established the
   native tree seed supply systems are, (ii) how public and non-public
   actors differ regarding the perception of existing seed systems, and
   (iii) the main barriers to strengthening current seed systems. Our
   findings identified significant gaps in the native tree seed supply
   systems of the four countries, arising particularly from shortfalls in
   the enabling environment. We found a lack of involvement of local
   community members in the seed systems, with a crucial need for
   strengthening policy, capacity building and investment in seed systems.
   We propose a multi-stakeholder approach and the application of online
   tools to improve seed systems to meet the demand for high-quality native
   tree seeds.},
Publisher = {MDPI},
Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
