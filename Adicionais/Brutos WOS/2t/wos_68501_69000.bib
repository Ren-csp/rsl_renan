@article{ WOS:001275549300018,
Author = {Fu, Cheng and Yang, Nan and Chuang, Jen-Zen and Nakajima, Nobuyuki and
   Iraha, Satoshi and Roy, Neeta and Wu, Zhenquan and Jiang, Zhichun and
   Otsu, Wataru and Radu, Roxana A. and Yang, Howard Hua and Lee, Maxwell
   Ping and Worgall, Tilla S. and Xiong, Wen-Cheng and Sung, Ching-Hwa},
Title = {Mutant mice with rod-specific VPS35 deletion exhibit retinal α-synuclein
   pathology-associated degeneration},
Journal = {NATURE COMMUNICATIONS},
