@article{ WOS:000564285200004,
Author = {Mitra, Akash and Andrews, Miles C. and Roh, Whijae and De Macedo,
   Marianna Petaccia and Hudgens, Courtney W. and Carapeto, Fernando and
   Singh, Shailbala and Reuben, Alexandre and Wang, Feng and Mao, Xizeng
   and Song, Xingzhi and Wani, Khalida and Tippen, Samantha and Ng,
   Kwok-Shing and Schalck, Aislyn and Sakellariou-Thompson, Donald A. and
   Chen, Eveline and Reddy, Sangeetha M. and Spencer, Christine N. and
   Wiesnoski, Diana and Little, Latasha D. and Gumbs, Curtis and Cooper,
   Zachary A. and Burton, Elizabeth M. and Hwu, Patrick and Davies, Michael
   A. and Zhang, Jianhua and Bernatchez, Chantale and Navin, Nicholas and
   Sharma, Padmanee and Allison, James P. and Wargo, Jennifer A. and Yee,
   Cassian and Tetzlaff, Michael T. and Hwu, Wen-Jen and Lazar, Alexander
   J. and Futreal, P. Andrew},
Title = {Spatially resolved analyses link genomic and immune diversity and reveal
   unfavorable neutrophil activation in melanoma},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {APR 15},
Abstract = {Complex tumor microenvironmental (TME) features influence the outcome of
   cancer immunotherapy (IO). Here we perform immunogenomic analyses on 67
   intratumor subregions of a PD-1 inhibitor-resistant melanoma tumor and 2
   additional metastases arising over 8 years, to characterize TME
   interactions. We identify spatially distinct evolution of copy number
   alterations influencing local immune composition. Sub-regions with
   chromosome 7 gain display a relative lack of leukocyte infiltrate but
   evidence of neutrophil activation, recapitulated in The Cancer Genome
   Atlas (TCGA) samples, and associated with lack of response to IO across
   three clinical cohorts. Whether neutrophil activation represents cause
   or consequence of local tumor necrosis requires further study. Analyses
   of T-cell clonotypes reveal the presence of recurrent priming events
   manifesting in a dominant T-cell clonotype over many years. Our findings
   highlight the links between marked levels of genomic and immune
   heterogeneity within the physical space of a tumor, with implications
   for biomarker evaluation and immunotherapy response.},
