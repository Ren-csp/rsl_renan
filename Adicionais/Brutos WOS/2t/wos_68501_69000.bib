Author = {Lee, Jimmy Tsz Hang and Barnett, Sam N. and Roberts, Kenny and Ashwin,
   Helen and Milross, Luke and Cho, Jae-Won and Huseynov, Alik and
   Woodhams, Benjamin and Aivazidis, Alexander and Li, Tong and Majo,
   Joaquim and Chaves, Patricia and Lee, Michael and Miranda, Antonio M. A.
   and Jablonska, Zuzanna and Arena, Vincenzo and Hanley, Brian and Osborn,
   Michael and Uhlmann, Virginie and Xu, Xiao-Ning and Mclean, Gary R. and
