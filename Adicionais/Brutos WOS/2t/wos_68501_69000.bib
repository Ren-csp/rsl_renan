@article{ WOS:001720209600001,
Author = {Kinabo, Neema R. and Martin, Dominic A. and Koggani, Koggani D. and
   Martin-Lopez, Berta and Gross, Milena and Schleyer, Christian and
   Hackmann, Verena and Thiel, Andreas and Bohning-Gaese, Katrin and
   Manning, Peter},
Title = {Combining social, ecological and economic approaches in knowledge
   co-production enables the identification of sustainable farming options},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {5},
Pages = {1261-1279},
Month = {MAY},
Abstract = {Farming systems face an increasing sustainability challenge requiring
   integrated solutions to minimize the trade-offs between the social,
   ecological and economic dimensions of sustainability. Yet, most research
   remains siloed, limiting interdisciplinary understanding of farming
   systems as coupled social-ecological systems (SESs) and precluding
   holistic solutions. Addressing this gap, we employed an
   interdisciplinary knowledge co-production approach in Kilimanjaro,
   integrating social, ecological and economic data to understand the
   multidimensionality of the farming systems. We first surveyed 306
   farmers and used multivariate analysis to categorize the farming
   systems. Based on data from semi-structured interviews with 15 farmers
   and field observations of agricultural plots they own or manage, we
   conducted a cost-benefit analysis of each farming system. Through
   thematic analysis, we revealed the perceived impacts of farming
   practices on biodiversity, soil and yields. We triangulated these
   findings with those from ecological studies conducted on the same
   agricultural plots. We finally identified challenges to and solutions
   for sustainable farming, complemented by five key informant interviews.
   We found a heterogeneous agricultural landscape characterized by
   maize-bean, homegarden and coffee farming systems. All systems were
   estimated to be profitable but sensitive to environmental and
   market-related shocks. Farmers and key informants identified four major
   challenges, largely similar across farming systems: biophysical
   constraints, production costs and market constraints, infrastructure
   limitations and gaps in agricultural extension support. Proposed
   solutions included farm-level interventions such as manuring, biological
   pest control and planting drought-resistant crops, which were low-cost
   practices and perceived to offer multiple benefits. Notably, using
   high-cost agrochemicals, particularly in the maize-bean system, was
   perceived to have long-term negative environmental impacts. These
   perceptions were consistent with the findings from the ecological
   studies. Institutional-level solutions involved leveraging cooperatives
   and improving agricultural information, while policy and
   government-level solutions focused on subsidies, incentives for organic
   produce, market regulation and tax reductions. By integrating social,
   ecological and economic dimensions in an interdisciplinary knowledge
   co-production approach, we identified context-specific challenges and
   actionable solutions that account for local practices and structural
   support needs. This approach, which values farmers' experiential
   knowledge alongside ecological and economic insights, has the potential
   for wider utility in guiding sustainability in farming systems beyond
   Kilimanjaro.Read the free for this article on the Journal blog.
   Mifumo ya kilimo inakabiliwa na changamoto kubwa ya uendelevu
   inayohitaji suluhu jumuishi zitakazopunguza migongano kati ya vipengele
   vya uendelevu vya kijamii, kiikolojia na kiuchumi. Hatahivyo, tafiti
   nyingi bado zinafanywa kwa mtazamo mmoja wa kitaaluma, hali inayozuia
   uelewa wa jumla wa mifumo ya kilimo kama mifumo ya kijamii na
   kiikolojia, na hivyo kuzuia upatikanaji wa suluhu jumuishi. Ili
   kukabiliana na pengo hili, tulitumia mbinu shirikishi ya uzalishaji wa
   maarifa (interdisciplinary knowledge co-production approach) hapa
   Kilimanjaro kujumuisha taarifa za kijamii, kiikolojia na kiuchumi
   kuelewa vipengele mbalimbali vya mifumo ya kilimo. Kwanza tulihoji
   wakulima (n=306) na kubainisha mifumo ya kilimo kwa kutumia multivariate
   analysis. Tulitumia data za mahojiano ya kina na wakulima (n=15)
   wanaomiliki au kusimamia mashamba kufanya uchanganuzi wa gharama na
   faida kwa kila mfumo wa kilimo. Kupitia uchambuzi wa kimaudhui (thematic
   analysis) tulibainisha mitizamo ya athari za mbinu za kilimo kwenye
   bioanuai, udongo, na mavuno. Tulilinganisha matokeo haya na matokeo ya
   tafiti za kiikolojia zilizofanywa kwenye mashamba hayo hayo. Hatimaye,
   tulibainisha changamoto, na suluhu za kuchochea kilimo endelevu, ambazo
   tuliongezea na mahojiano na wadau wa muhimu (n=5). Matokeo yalionyesha
   mandhari ya kilimo mchanganyiko, yenye mifumo ya kilimo
   mahindi-maharagwe, bustani za nyumbani, na mashamba ya kahawa. Mifumo
   yote ya kilimo ilikadiriwa kuwa na faida lakini yenye kuweza kuathiriwa
   na majanga ya kimazingira na masoko. Wakulima na wadau walibainisha
   changamoto zinazofanana kwa kiasi kikubwa katika mifumo yote zikiwemo:
   vikwazo vya kimazingira, gharama za uzalishaji, changamoto za masoko,
   miundombinu duni, na mapungufu katika elimu ya ugani wa kilimo. Suluhu
   zilizopendekezwa zilijumuisha katika ngazi ya shamba matumizi ya mbolea
   ya samadi, kudhibiti wadudu waharibifu kwa njia za kibaolojia na kupanda
   mazao yanayostahimili ukame, mbinu ambazo zilikuwa za gharama nafuu, na
   zilizoonekana kuwa na manufaa mengi. Matumizi ya viuatilifu vya gharama
   kubwa, hasa katika mfumo wa mahindi-maharagwe, yalionekana kuwa na
   athari hasi za muda mrefu kwenye mazingira. Mitizamo hii ya wakulima
   iliakisi matokeo ya tafiti za kiikolojia. Suluhu za kimfumo zilijumuisha
   kutumia vyama ya ushirika na kuboresha upatikanaji wa taarifa za kilimo,
   ilihali hatua za kisera na za kiserikali zilijikita katika ruzuku,
   motisha kwa mazao ya kilimo hai, udhibiti wa masoko na punguzo la kodi.
   Kwa kujumuisha taarifa za kijamii, kiikolojia na kiuchumi kupitia mbinu
   shirikishi ya uzalishaji wa maarifa, tulibainisha changamoto na suluhu
   zinazotekelezeka zinazozingatia utendaji wa kawaida na mifumo
   inayohitajika. Mbinu hii, inayojali maarifa ya uzoefu wakulima na
   mitizamo ya kiikolojia na kiuchumi, ina uwezo wa kuelekeza uendelevu wa
   mifumo ya kilimo maeneo mengine zaidi ya Kilimanjaro.},
