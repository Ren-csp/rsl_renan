@article{ WOS:001147728500013,
Author = {Lee, Jeong Han and Perez-Flores, Maria C. and Park, Seojin and Kim, Hyo
   Jeong and Chen, Yingying and Kang, Mincheol and Kersigo, Jennifer and
   Choi, Jinsil and Thai, Phung N. and Woltz, Ryan L. and Perez-Flores,
   Dolores Columba and Perkins, Guy and Sihn, Choong-Ryoul and Trinh,
   Pauline and Zhang, Xiao-Dong and Sirish, Padmini and Dong, Yao and Feng,
   Wayne Wei and Pessah, Isaac N. and Dixon, Rose E. and Sokolowski, Bernd
   and Fritzsch, Bernd and Chiamvimonvat, Nipavan and Yamoah, Ebenezer N.},
Title = {The Piezo channel is a mechano-sensitive complex component in the
   mammalian inner ear hair cell},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {JAN 16},
Abstract = {The inner ear is the hub where hair cells (HCs) transduce sound,
   gravity, and head acceleration stimuli to the brain. Hearing and balance
   rely on mechanosensation, the fastest sensory signals transmitted to the
   brain. The mechanoelectrical transducer (MET) channel is the entryway
   for the sound-balance-brain interface, but the channel-complex
   composition is not entirely known. Here, we report that the mouse
   utilizes Piezo1 (Pz1) and Piezo2 (Pz2) isoforms as MET-complex
   components. The Pz channels, expressed in HC stereocilia, and cell lines
   are co-localized and co-assembled with MET complex partners. Mice
   expressing non-functional Pz1 and Pz2 at the ROSA26 locus have impaired
   auditory and vestibular traits that can only be explained if the Pzs are
   integral to the MET complex. We suggest that Pz subunits constitute part
   of the MET complex and that interactions with other MET complex
   components yield functional MET units to generate HC MET currents.
   The identity of hair cells' mechanoelectrical transduction (MET)
   channel-complex components is unknown. Here, the authors used multiple
   biochemical, genetic, and functional approaches to show that mouse hair
   cells utilize Piezo1 and Piezo2 isoforms as part of the MET-complex
   component.},
