@article{ WOS:000372193300001,
Author = {Sprowl, Jason A. and Ong, Su Sien and Gibson, Alice A. and Hu, Shuiying
   and Du, Guoqing and Lin, Wenwei and Li, Lie and Bharill, Shashank and
   Ness, Rachel A. and Stecula, Adrian and Offer, Steven M. and Diasio,
   Robert B. and Nies, Anne T. and Schwab, Matthias and Cavaletti, Guido
   and Schlatter, Eberhard and Ciarimboli, Giuliano and Schellens, Jan H.
   M. and Isacoff, Ehud Y. and Sali, Andrej and Chen, Taosheng and Baker,
   Sharyn D. and Sparreboom, Alex and Pabla, Navjotsingh},
Title = {A phosphotyrosine switch regulates organic cation transporters},
Journal = {NATURE COMMUNICATIONS},
Year = {2016},
Volume = {7},
Month = {MAR},
Abstract = {Membrane transporters are key determinants of therapeutic outcomes. They
   regulate systemic and cellular drug levels influencing efficacy as well
   as toxicities. Here we report a unique phosphorylation-dependent
   interaction between drug transporters and tyrosine kinase inhibitors
   (TKIs), which has uncovered widespread phosphotyrosine-mediated
   regulation of drug transporters. We initially found that organic cation
   transporters (OCTs), uptake carriers of metformin and oxaliplatin, were
   inhibited by several clinically used TKIs. Mechanistic studies showed
   that these TKIs inhibit the Src family kinase Yes1, which was found to
   be essential for OCT2 tyrosine phosphorylation and function. Yes1
   inhibition in vivo diminished OCT2 activity, significantly mitigating
   oxaliplatin-induced acute sensory neuropathy. Along with OCT2, other
   SLC-family drug transporters are potentially part of an extensive
   `transporter-phosphoproteome' with unique susceptibility to TKIs. On the
