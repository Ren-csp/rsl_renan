   Iversen, Sara V.; Dalgaard, Tommy; Graversgaard, Morten, Aarhus Univ, Dept Agroecol, Blichers Alle, DK-8830 Tjele, Denmark.},
DOI = {10.1016/j.jenvman.2023.119877},
EarlyAccessDate = {JAN 2024},
