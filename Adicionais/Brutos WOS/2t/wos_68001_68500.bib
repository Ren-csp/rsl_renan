@article{ WOS:000783915800054,
Author = {Teitelbaum, Eric and Alsaad, Hayder and Aviv, Dorit and Kim, Alexander
   and Voelker, Conrad and Meggers, Forrest and Pantelic, Jovan},
Title = {Addressing a systematic error correcting for free and mixed convection
   when measuring mean radiant temperature with globe thermometers},
