@article{ WOS:000823973200001,
Author = {Surzykiewicz, Janusz and Skalski, Sebastian Binyamin and Solbut,
   Agnieszka and Rutkowski, Sebastian and Konaszewski, Karol},
Title = {Resilience and Regulation of Emotions in Adolescents: Serial Mediation
