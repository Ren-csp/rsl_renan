@article{ WOS:000444554800016,
Author = {Mi, Wenyi and Zhang, Yi and Lyu, Jie and Wang, Xiaolu and Tong, Qiong
   and Peng, Danni and Xue, Yongming and Tencer, Adam H. and Wen, Hong and
   Li, Wei and Kutateladze, Tatiana G. and Shi, Xiaobing},
Title = {The ZZ-type zinc finger of ZZZ3 modulates the ATAC complex-mediated
   histone acetylation and gene activation},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {SEP 14},
Abstract = {Recognition of histones by epigenetic readers is a fundamental mechanism
   for the regulation of chromatin and transcription. Most reader modules
   target specific post-translational modifications on histones. Here, we
   report the identification of a reader of histone H3, the ZZ-type zinc
   finger (ZZ) domain of ZZZ3, a subunit of the Ada-two-A-containing (ATAC)
   histone acetyltransferase complex. The solution NMR structure of the ZZ
   in complex with the H3 peptide reveals a unique binding mechanism
   involving caging of the N-terminal Alanine 1 of histone H3 in an acidic
   cavity of the ZZ domain, indicating a specific recognition of H3 versus
   other histones. Depletion of ZZZ3 or disruption of the ZZ-H3 interaction
   dampens ATAC-dependent promoter histone H3K9 acetylation and target gene
   expression. Overall, our study identifies the ZZ domain of ZZZ3 as a
   histone H3 reader that is required for the ATAC complex-mediated
   maintenance of histone acetylation and gene activation.},
