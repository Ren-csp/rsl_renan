@article{ WOS:001852123900001,
Author = {Skorupski, Jakub},
Title = {Popularity does Matter: Misalignment between public priorities and
   conservation need in mammal conservation},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2026},
Volume = {94},
Month = {DEC},
Abstract = {Public backing is widely assumed to legitimise biodiversity policy, yet
   public preferences may be systematically misaligned with ecological
   urgency. Poland's first nationwide, census-benchmarked survey of
   perceptions of endangered mammals was conducted (N = 1,011 adults, CAWI,
   post-stratified weights). Respondents evaluated ten species spanning
   global icons and native taxa, including the critically endangered but
   culturally obscure European mink. The questionnaire measured general
   conservation attitudes, self-assessed species knowledge, recognition of
   endangered status, budget allocation across species, perceived
   endangerment rankings, flagship suitability and charisma-related
   attributes, forced prioritisation, and trait attributions. Support for
   conservation was high in principle, but sharply uneven across species.
   Familiarity and recognition were consistently associated with support:
   higher reported knowledge correlated with greater willingness to
   allocate conservation funds, and recognising a species as endangered
   predicted larger allocations. However, charisma and symbolic appeal
   structured preferences more strongly than perceived threat. Large,
   culturally salient mammals attracted the highest priority nominations,
   flagship ratings and budget shares, while the European mink showed a
   pronounced recognition-support gap (low recognition as endangered,
   minimal prioritisation and weak flagship potential) even among
   respondents reporting good knowledge. Trait attributions further
   suggested stable negative or ambiguous representations for low-salience
   taxa. These findings demonstrate a measurable misalignment between
   public priorities and biological urgency, implying that participatory
   conservation governance must combine evidence-based communication to
   build familiarity for overlooked species with policy safeguards that
   secure resources for critically threatened taxa regardless of popular
   appeal.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Skorupski, J (Corresponding Author), Univ Szczecin, Inst Marine \& Environm Sci, Mickiewicza 16 St, PL-70383 Szczecin, Poland.
   Skorupski, Jakub, Univ Szczecin, Inst Marine \& Environm Sci, Mickiewicza 16 St, PL-70383 Szczecin, Poland.},
