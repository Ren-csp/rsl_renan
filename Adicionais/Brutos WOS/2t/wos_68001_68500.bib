Title = {Being with Donkeys: Insights into the Valuing and Wellbeing of Donkeys
   in Central Ethiopia},
Journal = {SOCIETY \& ANIMALS},
Year = {2024},
Volume = {32},
Number = {5-6},
Pages = {602-630},
Month = {NOV},
Abstract = {This paper explores the interwoven lives of donkeys and the people who
   depend on them for their livelihoods in central Ethiopia. Drawing on
   data from 12 participatory workshops, insights were elicited into the
   ways human co-workers value and treat their donkey co-workers.
   Methodologically, Participatory Rural Appraisal (PRA) and Appreciative
   Inquiry (Al) techniques were merged to explore the complex and
   multi-dimensional contributions donkeys make to participants' lives.
   Findings reveal working with donkeys can make the difference between
   destitution and modest survival, but societal perception of donkeys as
   low-status animals has an impact on their owners' lives and donkey
   wellbeing. This research contributes empirical insights on the valuing
   of donkeys and enables a deepened understanding of human-donkey
   relations. The combination of PRA and Al in the methodology demonstrates
   how to formulate a compassionate and empathetic approach for exploring
   donkey value and wellbeing with marginalized groups.},
