@article{ WOS:001734956300001,
Author = {Medvedev, Alexei},
Title = {Between superdiversity and doing diversity: School-based parent cafés as
   places of parent education},
Journal = {INTERNATIONAL REVIEW OF EDUCATION},
Year = {2026},
Volume = {72},
Number = {3},
Pages = {427-449},
Month = {JUN},
Abstract = {Critics often point out that parental education programmes primarily
   reach (formally) educated middle-class parents. Even in superdiverse
   urban neighbourhoods in Germany, schools struggle to cater to parents on
   the lower end of the socioeconomic spectrum. This qualitative study
   showcases school-based parent caf \& eacute;s in Hamburg, aiming to find
   out how their agenda and implementation correspond regarding the
   anticipated superdiversity of the target groups and the perceived
   diversity of the participants. The author draws on a concept triad of
   ``superdiversity{''}, ``diversity{''} and ``doing diversity{''} to
   illustrate how socio-spatial developments and the resulting
   superdiversity among parents (macro level) are taken up in schools (meso
   level) and realised at the micro level in the sense of doing diversity.
   The study's main finding is that while the composition of caf \& eacute;
   participants is diverse, it is not yet representative enough to reflect
   the superdiversity of parents in schools' catchment areas. Implementing
   diversity programmes often goes hand in hand with biased and inaccurate
   assumptions about the target groups' living circumstances. At the micro
   level, dynamic grouping processes take place, including reciprocal
   ``othering{''} as a side-effect. If the threat of exclusion is kept in
   mind, school-based parent caf \& eacute;s can potentially become a tool
   for establishing more superdiversity-responsive spaces in and for
   school-parent cooperation.
   Entre superdiversit \& eacute; et pratique de la diversit \& eacute; :
   les caf \& eacute;s des parents dans les \& eacute;coles, des lieux d'\&
   eacute;ducation parentale - Les critiques rel \& egrave;vent souvent que
   les programmes d'\& eacute;ducation parentale touchent principalement
   des parents (formellement) \& eacute;duqu \& eacute;s, issus des classes
   moyennes. M \& ecirc;me dans les quartiers urbains allemands marqu \&
   eacute;s par une forte superdiversit \& eacute;, les \& eacute;coles
   peinent \& agrave; atteindre les parents situ \& eacute;s au bas de l'\&
   eacute;chelle socio-\& eacute;conomique. La pr \& eacute;sente \&
   eacute;tude qualitative s'int \& eacute;resse aux caf \& eacute;s des
   parents dans des \& eacute;coles \& agrave; Hambourg et cherche \&
   agrave; analyser dans quelle mesure leurs objectifs et leur mise en oe
   uvre co \& iuml;ncident avec la superdiversit \& eacute; attendue des
   publics cibles et la diversit \& eacute; r \& eacute;ellement per \&
   ccedil;ue parmi les participants. L'auteur s'appuie sur un triptyque
   conceptuel : \& laquo; superdiversit \& eacute; \& raquo;, \& laquo;
   diversit \& eacute; \& raquo; et \& laquo; faire diversit \& eacute; \&
   raquo; (doing diversity) pour illustrer comment les \& eacute;volutions
   sociospatiales et la superdiversit \& eacute; qui en d \& eacute;coule
   chez les parents (macroniveau) sont prises en compte dans les \&
   eacute;coles (m \& eacute;soniveau) et mise en oe uvre au microniveau o
   \& ugrave; se d \& eacute;roule le \& laquo; faire-diversit \& eacute;
   \& raquo;. L'\& eacute;tude a principalement d \& eacute;termin \&
   eacute; que, malgr \& eacute; la diversit \& eacute; des personnes
   participant aux caf \& eacute;s, celle-ci n'est pas encore suffisamment
   repr \& eacute;sentative de la superdiversit \& eacute; des parents dans
   les secteurs de scolarisation. La mise en oe uvre de programmes ax \&
   eacute;s sur la diversit \& eacute; s'accompagne souvent de pr \&
   eacute;suppos \& eacute;s biais \& eacute;s et inexacts concernant les
   conditions de vie des groupes cibles. Au microniveau, des dynamiques de
   regroupement se font jour, produisant, comme effet secondaire, une alt
   \& eacute;risation r \& eacute;ciproque. Tout en gardant \& agrave;
   l'esprit le risque d'exclusion, les caf \& eacute;s des parents dans les
   \& eacute;coles peuvent n \& eacute;anmoins devenir des outils pour cr
   \& eacute;er des espaces plus adapt \& eacute;s \& agrave; la
   superdiversit \& eacute;, tant dans le cadre de la coop \& eacute;ration
   entre les \& eacute;tablissements scolaires et les familles qu'au
   service du renforcement de ces liens.},
