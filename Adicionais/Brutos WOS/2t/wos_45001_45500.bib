@article{ WOS:001602467600001,
Author = {Alex, Luisa and Mai, Robert and Rauschnabel, Philipp A.},
Title = {Similar but different: The differential implications of augmented and
   virtual reality experiences for raising engagement towards climate
   change actions},
Journal = {COMPUTERS IN HUMAN BEHAVIOR},
Year = {2026},
Volume = {174},
Month = {JAN},
Abstract = {Combating climate change requires addressing psychological barriers that
   inhibit people's engagement. Two significant challenges hinder effective
   climate change actions: the invisibility of the effects of climate
   change and people's distance from environmental degradation, leading to
   a psychological disconnect and underestimation of environmental
   problems. This research posits that technologies extending reality by
   embedding the physical and digital worlds can help reduce this distance
   and enhance climate change awareness. The present paper proposes that
   Augmented Reality (AR) and Virtual Reality (VR) both have the potential
   to bridge the gap between environmental issues and engagement, but for
   different reasons. A three-level experiment (AR, VR, baseline) examines
   the distinct perceptual implications of AR and VR and their impact on
   improving climate change awareness and eliciting intentions to act. The
   findings demonstrate that both technologies evoke different perceptions
   of presence (telepresence vs. local presence) and, therefore, affect
   climate change beliefs and actions in unique ways. The implications for
   theory and policy makers are discussed.},
