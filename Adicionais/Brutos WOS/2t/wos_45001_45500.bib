@article{ WOS:001850380300002,
Author = {Nche, George C. and Michael, Benson Ogar},
Title = {Preserving Sacred Forests and Rivers in Abanyom, Cross River State,
   Nigeria: Is the Environmental Worldview Eco-Centric, Anthropocentric or
   Relational?},
Journal = {HUMAN ECOLOGY},
Year = {2026},
Volume = {55},
Number = {1},
Month = {AUG 15},
Abstract = {The debate surrounding the ethical nature of the African environmental
   worldview remains inconclusive, with some scholars arguing that it is
   primarily eco-centric, while others claim that it is largely
   anthropocentric. Using the case study of Abanyom's preservation of
   sacred forests and rivers, we revisited this debate by exploring the
   taboos and rituals associated with these sacred sites as well as the
   motivations for their preservation. The study conducted in-depth
   interviews with 15 community members (comprising traditional leaders,
   clan heads and chief priests) and analysed the data thematically. The
   findings reveal that the Abanyom community's environmental worldview
   cannot be strictly classified as either eco-centric or anthropocentric.
   Instead, the worldview is best categorised under the relational value
   framework, an ``in-between{''} category that incorporates elements from
   both perspectives. The study recommends utilising the relational value
   framework in future research on African relationships with nature and in
   formulating environmental sustainability policies on the continent.},
