@article{ WOS:001836828000001,
Author = {Reid, Rebecca A. and Kleeman, Alexandra and Rachele, Jerome N. and
   Mavoa, Suzanne and Beenackers, Marielle A. and Foster, Sarah},
Title = {Sound advice: associations between building design attributes and
   residents' noise annoyance},
Journal = {CITIES \& HEALTH},
Year = {2026},
Month = {2026 JUL 30},
Abstract = {Higher residential densities are promoted to sustainably meet housing
   targets; however, the location, built form and spatial arrangements of
   these developments may increase residents' exposure to noise. Noise
   annoyance is linked to a range of health issues and contributes
   substantially to the health burden from environmental noise. Therefore,
   managing noise in apartments is increasingly important. Australian
   state-level apartment design policies provide guidance for the
   development and siting of buildings, acknowledging that some settings
   may expose residents to higher levels of noise. This study examined
   associations between objectively measured apartment and building design
   features and residents' noise annoyance from internal and external
   sources among 1112 apartment dwellers across 110 complexes in three
   Australian capital cities using mixed-effects linear regression models.
   Design features included floor level, apartment layout and orientation,
   proximity to communal open spaces and circulation spaces, fa \&
   ccedil;ade exposure, separation from neighbouring buildings and the
   presence of mixed-use functions. Noise annoyance was shaped by the
   spatial relationship between dwellings and noise sources. Vertical
   position in the building, proximity to internal circulation spaces, and
   the degree of fa \& ccedil;ade exposure to the surrounding environment
   were associated with differences in noise annoyance. These findings
   highlight the importance of acoustic considerations in apartment design
   policy.},
