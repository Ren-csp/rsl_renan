@article{ WOS:000652583300002,
Author = {Jeliazkova, Nina and Apostolova, Margarita D. and Andreoli, Cristina and
   Barone, Flavia and Barrick, Andrew and Battistelli, Chiara and Bossa,
   Cecilia and Botea-Petcu, Alina and Chatel, Amelie and De Angelis,
   Isabella and Dusinska, Maria and El Yamani, Naouale and Gheorghe,
   Daniela and Giusti, Anna and Gomez-Fernandez, Paloma and Grafstrom,
   Roland and Gromelski, Maciej and Jacobsen, Nicklas Raun and Jeliazkov,
   Vedrin and Jensen, Keld Alstrup and Kochev, Nikolay and Kohonen, Pekka
   and Manier, Nicolas and Mariussen, Espen and Mech, Agnieszka and Navas,
   Jose Maria and Paskaleva, Vesselina and Precupas, Aurica and Puzyn,
