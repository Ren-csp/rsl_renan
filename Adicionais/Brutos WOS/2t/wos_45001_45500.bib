@article{ WOS:000564651700016,
Author = {Lokhandwala, Snehal and Gautam, Pratibha},
Title = {Indirect impact of COVID-19 on environment: A brief study in Indian
   context},
Journal = {ENVIRONMENTAL RESEARCH},
