@article{ WOS:000350288500001,
Author = {Xue, Jianfei and Chen, Yaohui and Wu, Yamei and Wang, Zhongyong and
   Zhou, Aidong and Zhang, Sicong and Lin, Kangyu and Aldape, Kenneth and
   Majumder, Sadhan and Lu, Zhimin and Huang, Suyun},
Title = {Tumour suppressor TRIM33 targets nuclear β-catenin degradation},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {FEB},
Abstract = {Aberrant activation of beta-catenin in the nucleus has been implicated
   in a variety of human cancers, but the fate of nuclear beta-catenin is
   unknown. Here we demonstrate that the tripartite motif-containing
   protein 33 (TRIM33), acting as an E3 ubiquitin ligase, reduces the
   abundance of nuclear beta-catenin protein. TRIM33-mediated beta-catenin
   is destabilized and is GSK-3 beta or beta-TrCP independent. TRIM33
   interacts with and ubiquitylates nuclear beta-catenin. Moreover, protein
   kinase C delta, which directly phosphorylates beta-catenin at Ser715, is
   required for the TRIM33-beta-catenin interaction. The function of TRIM33
   in suppressing tumour cell proliferation and brain tumour development
   depends on TRIM33-promoted beta-catenin degradation. In human
   glioblastoma specimens, endogenous TRIM33 levels are inversely
   correlated with beta-catenin. In summary, our findings identify TRIM33
   as a tumour suppressor that can abolish tumour cell proliferation and
   tumorigenesis by degrading nuclear beta-catenin. This work suggests a
   new therapeutic strategy against human cancers caused by aberrant
   activation of beta-catenin.},
