ISSN = {0959-3780},
EISSN = {1872-9495},
Keywords = {Sustainability; Transformations; Knowledge; Science; Politics; Values},
Keywords-Plus = {KNOWLEDGE COPRODUCTION; CLIMATE-CHANGE; ADAPTATION; POLICY; FUTURE;
   VALUES; SCIENTISTS; CHALLENGES; SYSTEMS; EARTH},
