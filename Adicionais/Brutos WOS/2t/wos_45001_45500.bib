@article{ WOS:001552899200001,
Author = {Barton, Nick and Bouzouggar, Abdeljalil and Carolin, Stacy and Humphrey,
   Louise},
Title = {A reappraisal of the Middle to Later Stone Age prehistory of
   MoroccoRéévaluer la préhistoire du Maroc, du Middle Stone Age au
   Later Stone Age},
Journal = {JOURNAL OF THE ROYAL ANTHROPOLOGICAL INSTITUTE},
Year = {2025},
Month = {2025 AUG 19},
Abstract = {Over the last 25 years, perceptions of the early prehistory of Northwest
   Africa have undergone radical changes due to new fieldwork projects and
   a corresponding growth in scientific interest in the region. Much of
   this work has been focused in Morocco, known for its extremely rich
   fossil and archaeological records in caves and rock shelters. Here we
   outline some of the critical findings concerning the Middle (MSA) to
   Later (LSA) Stone Age periods. We describe shifts in the understanding
   of the nature and chronology of human occupation in this region as well
   as changes in ideas concerning the evolution of human behaviour. Major
   behavioural changes in the MSA (similar to 300-29,000 years ago)
   attributed to Homo sapiens seem to have occurred mainly during humid
   phases, though not exclusively. The article also considers the
   relationship between the MSA and the LSA. Previously it was believed
   that there was a considerable hiatus separating these two cultural units
   (similar to 29,000 to similar to 23,000 years ago) but evidence from
   Taforalt cave shows a narrowing of the gap in occupation. Finally, the
   article examines changes in land-use behaviours in the LSA at similar to
   15,000 cal BP resulting in increased sedentism and an intensification in
   the exploitation of plant foods.
   La perception de la pr \& eacute;histoire lointaine de l'Afrique du
   Nord-Ouest a radicalement chang \& eacute; ces 25 derni \& egrave;res
   ann \& eacute;es, gr \& acirc;ce \& agrave; de nouveaux projets de
   terrain et \& agrave; l'int \& eacute;r \& ecirc;t scientifique accru
   port \& eacute; \& agrave; la r \& eacute;gion. Une grande partie de ces
   travaux ont \& eacute;t \& eacute; men \& eacute;s au Maroc, pays d \&
   eacute;j \& agrave; connu pour l'extr \& ecirc;me richesse des archives
   fossiles et arch \& eacute;ologiques pr \& eacute;sentes dans ses
   grottes et ses abris sous roche. Les auteurs r \& eacute;sument ici
   quelques-unes des d \& eacute;couvertes cruciales concernant les p \&
   eacute;riodes du Middle Stone Age (MSA) et du Later Stone Age (LSA). Ils
   d \& eacute;crivent la fa \& ccedil;on dont la compr \& eacute;hension
   de la nature et de la chronologie de l'occupation humaine de cette r \&
   eacute;gion s'est transform \& eacute;e, de m \& ecirc;me que les id \&
   eacute;es concernant l'\& eacute;volution des comportements humains. Les
   grands changements comportementaux attribu \& eacute;s \& agrave; Homo
   sapiens au MSA (entre 300 000 et 29 000 ans avant notre \& egrave;re)
   semblent s'\& ecirc;tre produits surtout pendant des p \& eacute;riodes
   humides, mais pas exclusivement. L'article examine \& eacute;galement
   l'articulation entre MSA et LSA. On pensait jusqu'alors que ces deux
   unit \& eacute;s culturelles \& eacute;taient s \& eacute;par \&
   eacute;es par un large hiatus (de 29 000 \& agrave; 23 000 ans avant
   notre \& egrave;re), mais les traces retrouv \& eacute;es dans la Grotte
   des Pigeons (Taforalt) montrent que la charni \& egrave;re sans
   occupation est plus \& eacute;troite. Enfin, l'article examine les
   changements de comportements d'utilisation des terres au cours du LSA,
   il y a 15 000 ans environ, qui ont conduit \& agrave; une s \&
   eacute;dentarisation accrue et \& agrave; une intensification des
   cultures vivri \& egrave;res.},
