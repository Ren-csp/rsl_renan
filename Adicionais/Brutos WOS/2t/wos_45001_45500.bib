@article{ WOS:001160750400028,
Author = {Saiyed, Sana T. and Fuentes, Agustin and Shaw, Eric and Schurr, Mark R.
   and Gettler, Lee T.},
Title = {Barbary macaques show sex-related differences in body weight based on
   anthropogenic food exposure despite comparable female-male stable
   isotope ratios},
Journal = {SCIENTIFIC REPORTS},
Year = {2024},
Volume = {14},
Number = {1},
Month = {FEB 9},
Abstract = {As the human-primate interface expands, many nonhuman primate (NHP)
   populations exploit anthropogenic foods to survive, while some
   populations opportunistically target them. Though anthropogenic food
   consumption is sometimes associated with greater reproductive output and
   survival in these populations, there is a dearth of research on possible
   health effects. We explore how differential exposure to anthropogenic
   foods is linked to variation in isotopic compositions (delta 13C and
   delta 15N) and body weights in Barbary macaques (Macaca sylvanus) in the
   Upper Rock Nature Reserve, Gibraltar. We placed monkeys into three
   categories based on anthropogenic food exposure. We then analyzed
   individuals for isotopic signatures (N = 147) and body weight
   measurements (N = 80). Using the lowest exposure category as the
   comparison, we found body weights and delta 15N values, but not delta
   13C values, significantly differed across key categories. Within
   categories, we found no significant associations between sex and delta
   13C or delta 15N values, suggesting that individuals within categories
   consumed similar foods regardless of sex. We found a significant
   interaction effect between category and sex for predicting body weights.
   These results suggest that sex plays a role in how anthropogenic foods
   are accessed and consumed regardless of exposure, which may result in
   differential health profiles for female and male macaques.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
