@article{ WOS:001504802600001,
Author = {Wang, Ning and Zhang, Yue and Bai, Boyu and Wang, Zhijing and Xie,
   Yuchan and Wang, Yuqi and Zhang, Liyuan},
Title = {Air quality characteristics and health risk assessment of underground
   spaces in medical buildings in Xi'an},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2025},
Volume = {7},
Number = {6},
Month = {JUN 1},
Abstract = {As urban expansion increasingly extends into underground spaces,
   concerns about the environmental quality of underground spaces in
   medical building have intensified. This study systematically
   investigated major airborne pollutants (PM1, PM2.5, PM10, HCHO,and
   TVOC), within the underground spaces of medical buildings in Xi'an,
   China, examining their concentration levels, spatialtemporal
   distribution characteristics, contributing factors, and health risks.
   Pollutant concentration levels were measured through comprehensive
   on-site monitoring, and a multiple linear regression model was applied
   to identify key contributing factors. Additionally, the environmental
   health risks for different population groups were assessed. The results
   indicated that pollutant concentrations in the underground spaces of
   medical buildings exceeded regulatory thresholds, demonstrating
   pronounced temporal and spatial variability. Significant differences in
   pollutant concentrations were observed across different functional
   areas, with the highest PM concentrations recorded in the dining halls
   and the highest TVOC concentrations measured in the parking garages. The
   major determinants of pollutant concentration included spatial function,
   prior-hour pollutant levels, and pedestrian flow. Health risk
   assessments indicated that both carcinogenic and non-carcinogenic risks
   for staff significantly surpassed those for non-staff, with
   non-carcinogenic risks in certain functional areas exceeding acceptable
   limits. This study elucidates the characteristics of air pollution in
   underground spaces of medical building and its implication for public
   health, providing scientific evidence to inform spatial optimization
   strategies and enhance pollution mitigation efforts.},
