@article{ WOS:001478629400001,
Author = {Bachman, Hadley F. and Beard, Karen Stansberry},
Title = {Family engagement efficacy beliefs of educators: confirming a new
   measure},
Journal = {TEACHERS AND TEACHING},
Year = {2026},
Volume = {32},
Number = {6},
Pages = {1090-1107},
Month = {AUG 18},
Abstract = {In 2022, the National Association for Family, School, and Community
   Engagement published the Family Engagement Core Competencies, providing
   clarity about the knowledge and skills of teachers collaborating with
   parents and caregivers. This study explored the nature of teacher family
   engagement efficacy beliefs and confirmed the factor structure of a
   measurement instrument, the Family Engagement Efficacy Beliefs of
   Educators (FEEB-E). The relationships between family engagement efficacy
   beliefs and two other constructs, teacher efficacy beliefs and teacher
   trust in families, were also examined. Data from 308 teachers in two
   midwestern urban districts yielded positive correlations between both
   constructs and the FEEB-E.},
