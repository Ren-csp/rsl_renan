@article{ WOS:001503075400011,
Author = {Mulholland, Eoghan J. and Belnoue-Davis, Hayley L. and Valbuena, Gabriel
   N. and Gunduz, Nuray and Ligeza, Amelia and Lin, Muyang and Biswas,
   Sujata and Gil Vasquez, Ester and Omwenga, Sulochana and Nasreddin,
   Nadia and Hodder, Michael C. and Wang, Lai Mun and Ng, Aik Seng and
   Jennings, Elizabeth and Midwood, Kim S. and Dedi, Neesha and Irshad,
   Shazia and Ridgway, Rachel A. and Phesse, Toby J. and East, James and
   Tomlinson, Ian P. M. and Davies, Gareth C. G. and Sansom, Owen J. and
   Leedham, Simon J.},
Title = {Epithelial GREMLIN1 disrupts intestinal epithelial-mesenchymal crosstalk
   to induce a wnt-dependent ectopic stem cell niche through stromal
   remodelling},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {JUN 4},
Abstract = {In homeostasis, counterbalanced morphogen signalling gradients along the
   vertical axis of the intestinal mucosa regulate the fate and function of
   epithelial and stromal cell compartments. Here, we use a
   disease-positioned mouse and human tissue to explore the consequences of
   pathological BMP signalling dysregulation on epithelial-mesenchymal
   interaction. Aberrant pan-epithelial expression of the secreted BMP
   antagonist Grem1 results in ectopic crypt formation, with lineage
   tracing demonstrating the presence of Lgr5(-) stem/progenitor cells.
   Isolated epithelial cell Grem1 expression has no effect on individual
   cell fate, indicating an intercompartmental impact of mucosal-wide BMP
   antagonism. Treatment with an anti-Grem1 antibody abrogates the
   polyposis phenotype, and triangulation of specific pathway inhibitors
   defines a pathological sequence of events, with Wnt-ligand-dependent
   ectopic stem cell niches forming through stromal remodelling following
   BMP disruption. These data support an emerging co-evolutionary model of
   intestinal cell compartmentalisation based on bidirectional regulation
   of epithelial-mesenchymal cell fate and function.},
