@article{ WOS:000562859900001,
Author = {Karton, Clara and Hoshizaki, T. Blaine and Gilchrist, Michael D.},
Title = {A novel repetitive head impact exposure measurement tool differentiates
   player position in National Football League},
Journal = {SCIENTIFIC REPORTS},
Year = {2020},
Volume = {10},
Number = {1},
Month = {JAN 28},
Abstract = {American-style football participation poses a high risk of repetitive
   head impact (RHI) exposure leading to acute and chronic brain injury.
   The complex nature of symptom expression, human predisposition, and
   neurological consequences of RHI limits our understanding of what
   constitutes as an injurious impact affecting the integrity of brain
   tissue. Video footage of professional football games was reviewed and
   documentation made of all head contact. Frequency of impact, tissue
   strain magnitude, and time interval between impacts was used to quantify
   RHI exposure, specific to player field position. Differences in exposure
   characteristics were found between eight different positions; where
   three unique profiles can be observed. Exposure profiles provide
   interpretation of the relationship between the traumatic event(s) and
   how tissue injury is manifested and expressed. This study illustrates
   and captures an objective measurement of RHI on the field, a critical
   component in guiding public policy and guidelines for managing exposure.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Karton, C (Corresponding Author), Univ Ottawa, Hlth Sci, Ottawa, ON K1N 6N5, Canada.
