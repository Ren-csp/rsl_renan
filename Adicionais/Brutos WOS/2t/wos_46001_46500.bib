@article{ WOS:000763852300001,
Author = {Geleto, Mati Amano and Kapp, Gerald and Sanjak, Elamin},
Title = {Coping with local peoples' livelihood dependence on the transboundary
   Dinder-Alatish National Parks in Sudan and Ethiopia from the Sudanese
   Perspective},
