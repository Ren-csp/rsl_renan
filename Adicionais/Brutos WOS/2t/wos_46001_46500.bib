@article{ WOS:001410746100001,
Author = {Roth, J. and Schnitzer, M. and Winner, H.},
Title = {Outsourcing the Games - measuring resident support for hosting an
   outsourced Olympic event},
Journal = {CURRENT ISSUES IN TOURISM},
Year = {2026},
Volume = {29},
Number = {2},
Pages = {221-225},
Month = {JAN 17},
Abstract = {This study examines resident support for outsourcing competitions within
   the Olympic Winter Games (OWG), focusing on the sliding events of the
   2026 Milan-Cortina OWG. Utilising survey data (n = 585) from
   Innsbruck-Igls, Austria, the analysis investigates the impact of
   co-hosting on local perceptions. Our results reveal substantial support
   for outsourcing, influenced by perceived benefits of European
   cooperation, resource pooling and trust in decision-makers. Venue
   engagement and tourism-related ties further increases support. These
   findings highlight outsourcing's potential to mitigate financial and
   environmental challenges, promoting sustainable mega-event hosting
   models.},
