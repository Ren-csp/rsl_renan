@article{ WOS:001780907200001,
Author = {Hu, B. T. and Wang, H. Y. and Chuen, C.},
Title = {RESERVOIRS BASED ON INTEGRATED SPACE-AIR-GROUND REMOTE SENSING SYSTEMS:
   A DATA SYNERGY STUDY COMBINING UAVS AND USVS},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {5193-5216},
Abstract = {Tailings and reservoirs require effective monitoring to mitigate
   significant risks. Conventional methods use single observation
   platforms, such as satellite, aerial, or ground, which leads to limited
   spatial coverage. This research presents 3D SAG integrated Remote
   Sensing (RS) framework utilizing satellites, Unmanned Aerial Vehicles
   (UAVs), and Unmanned Surface Vehicles (USVs) for reservoir monitoring
   and emergencies. The 700-image metadata system fosters multimodal
   perception and acquiring wide-range satellite remote sensing data
   alongside UAV hyperspectral imagery and USV in-situ measurements related
   to water quality, sediment, algae and soil. The alignment of spatial and
   spectral images facilitates effective multimodal fusion, improved by the
   VGG-16 model for feature extraction. The Artificial Hummingbird-driven
   Convolutional with Residual Long Short-Term Memory (AHB-Con-ResLSTM)
   classification model evaluates environmental threats and water quality
   changes. Convolutional Neural Network (CNNs) extract spatial features;
   ResLSTM captures temporal trends for reservoir monitoring and risk
   assessment. Metrics output evaluation results in Python, yielded an RMSE
   of 2.9874 for environmental risk zones. The data synergism is beneficial
   for efficient reservoir monitoring, leads to higher monitoring accuracy
   and makes it possible to distinguish navigable regions from hazardous
   zones. Furthermore, it enables prompt hazard detection, thus
   demonstrating the merits of combining satellite-derived datasets with
   UAV+USV observations for efficient reservoir management.},
