@article{ WOS:000873981800004,
Author = {Shi, Jiaxin and Wang, Xijing and Chen, Zhansheng},
Title = {Polluted humanity: Air pollution leads to the dehumanization of oneself
   and others},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2022},
Volume = {83},
Month = {OCT},
Abstract = {Air pollution is a major global environmental issue, yet its
   psychological consequences have only started to receive attention from
   scholars. We examined whether and how air pollution would lead to
   self-and other -dehumanization. Across one field study and five
   pre-registered experimental studies, we showed that air pollution
   increased people's dehumanization of themselves (Studies 1-2b) and
   others (Study 3a-4). Air pollution also increases people's perceived
   vulnerability to disease (PVD), including perceived infectability (PI)
   and germ aversion (GA). Further, across our studies, PI consistently
   accounted for the effect of air pollution on dehu-manization (Studies
   2a-4). In addition, our findings also supported the roles of negative
   affect (Study 2b) and disgust (Study 4) in shaping dehumanization in the
   face of air pollution. Therefore, air pollution not only impairs our
   physical health but also influences our perception of humanness. We
   discussed the implications of these findings for the literature on air
   pollution and dehumanization.},
