@article{ WOS:000428382400030,
Author = {Haldon, John and Mordechai, Lee and Newfield, Timothy P. and Chase,
   Arlen F. and Izdebski, Adam and Guzowski, Piotr and Labuhn, Inga and
   Roberts, Neil},
Title = {Historymeets palaeoscience: Consilience and collaboration in studying
   past societal responses to environmental change},
