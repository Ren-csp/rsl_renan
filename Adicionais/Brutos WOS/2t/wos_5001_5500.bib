@article{ WOS:001743097300016,
Author = {Chen, Yashan and Zheng, Junming and Huang, Linsheng},
Title = {Association of park features with total and prolonged sedentary behavior
   among older adults: An observational study in Macau},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {MAR 9},
Abstract = {Changing the park features can contribute to increasing park-based
   physical activity, but many older adults still engage in sedentary
   behavior (SB). The relationship between park-based SB and park features
   remains unclear. This cross-sectional study aimed to examine total and
   prolonged SB in older adults in urban parks and to explore the
   associations between such behavior and specific park features. Using
   systematic observation and covert video recording, this study collected
   behavioral data from older adults across 51 sub-areas within three Macau
   parks. The primary type of prolonged SB was identified using analysis of
   variance. To test these associations, negative binomial generalized
   linear mixed models and Firth's penalized logistic regression were
   employed. The results indicated that card/board game playing was
   associated with the most prolonged sedentary bouts. Shade (IRR = 4.98, p
   < 0.05) was the only feature significantly predictive of total SB and
   served as a necessary condition for prolonged SB. The presence of
   outdoor table and chairs showed a significant and robust association
   with prolonged SB (aOR = 10.16, p < 0.001). Current parks are often
   designed for passive sitting rather than promoting intermittent
   activity. Therefore, this study proposes design strategies to encourage
   active use, offering a novel approach to park design.},
