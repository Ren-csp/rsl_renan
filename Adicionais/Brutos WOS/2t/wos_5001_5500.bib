Title = {Study on Spatial-Temporal Change of Urban Green Space in Yangtze River
   Economic Belt and Its Driving Mechanism},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
