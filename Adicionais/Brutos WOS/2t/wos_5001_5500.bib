   Leon, Federico R., Univ San Ignacio Loyola, Lima, Peru.
   Barrantes, Fanny, Univ Peruana Ciencias, Programa Especializado Adopc \& Aplicac Normas Int, Lima, Peru.},
DOI = {10.16888/interd.2021.38.2.2},
ISSN = {1668-7027},
Keywords = {mining; socio-environmental conflict; managers; intergroup perceptions},
Keywords-Plus = {COMPLEX COGNITIVE-ABILITY; UV-RADIATION; TOLERANCE; PROJECTS; THREAT;
   WEALTH; INCOME; STATE},
