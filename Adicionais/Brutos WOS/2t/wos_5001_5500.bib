@article{ WOS:001616368800001,
Author = {Komarolya, Davood Vafadari},
Title = {Analysis of stakeholder power and convergence for climate-resilient
   urban parks: A MACTOR study in Tabriz},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {Urban parks play a critical role in strengthening socio-environmental
   resilience, especially in semi-arid and rapidly urbanizing regions. This
   study investigates how stakeholder dynamics and governance structures
   shape the resilience of urban parks in Tabriz, Iran. A mixed-method
   design was applied, combining 31 expert interviews with MACTOR analysis.
   Ten key stakeholder groups were identified and assessed across 34
   resilience objectives in terms of influence, interdependence, and
   strategic alignment. Results reveal a 53-point power gap between
   dominant political actors (City Councils: 215; Municipalities: 207) and
   marginalized technical experts (Horticultural Scientists: 162). The
   analysis identifies a critical implementation paradox where high
   consensus on ecological goals contrasts with low agreement on technical
   solutions like permeable materials (consensus score: 31), reflecting
   institutional and operational barriers. The findings emphasize that
   effective urban park resilience requires bridging participatory planning
   and technical expertise through decentralized, polycentric governance.
   By linking stakeholder analysis with resilience planning, this study
   provides a replicable framework for fostering more adaptive, inclusive,
   and climate-responsive urban park systems in similar socio-ecological
   contexts.},
