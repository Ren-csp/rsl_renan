@article{ WOS:001575259400010,
Author = {Almazan-Nunez, R. Carlos and Alvarez-Alvarez, Edson A. and
   Poblete-Lopez, Diana K. and Rodriguez-Godinez, Rosalba and
   Sierra-Morales, Pablo},
Title = {LOCAL AND LANDSCAPE DRIVERS OF BIRD COMMUNITY SHIFTS IN URBAN PARKS IN A
   NEOTROPICAL CITY},
Journal = {ACTA BIOLOGICA COLOMBIANA},
Year = {2025},
Volume = {30},
Number = {1},
Pages = {105-120},
Month = {JAN-APR},
Abstract = {Urban growth affects bird community composition and diversity. However,
   these effects may vary based on urbanization level and season. We
   explored how local and landscape variables influenced urban avoiders,
   exploiters, and adapters birds during two seasons in urban and
   peri-urban parks in a neotropical city in southern Mexico. Between 2017
   and 2018, we performed bird sampling during non-breeding
   (August-September) and breeding (February-March) seasons. We compared
   urban bird diversity between parks using Hill numbers. 67 bird species
   were recorded-38 adapters, 24 avoiders, and five urban exploiters.
   Overall, peri-urban parks had the highest bird diversity in both seasons
   compared to urban parks. Urban exploiters were associated with
   urbanization at the local and landscape levels in both seasons, while
   urban avoiders preferred parks with structurally complex vegetation in
   the non-breeding season. Adapters used urban and peri-urban parks
   interchangeably. Our findings suggest that densely urbanized parks
   increase the dominance of exploiter bird species while drastically
   decreasing the presence of native birds. The findings also highlight the
   role of peri-urban parks in the conservation and planning of neotropical
   urban centers, reducing the effects of urbanization.},
