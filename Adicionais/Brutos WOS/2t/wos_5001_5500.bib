@article{ WOS:001557067900001,
Author = {Oostvogels, Vincent J. and Ripoll-Bosch, Raimon and Allart, Lucie and
   Etienne, Rebecca and Nijland, Hanneke J. and de Boer, Imke J. M. and
   Dumont, Bertrand},
Title = {Dairy farming and biodiversity: A narrative analysis in contrasting
   socio-ecological contexts},
Journal = {PEOPLE AND NATURE},
Year = {2025},
Volume = {7},
Number = {10},
Pages = {2556-2574},
Month = {OCT},
Abstract = {It is crucial that biodiversity conservation initiatives in agriculture
   take into account how farmers understand and value their relationships
   with nature. However, while highly relevant for pan-European
   conservation work, insight into differences and commonalities in
   farmers' views across socio-ecologically different European regions is
   still lacking. Therefore, we studied how farmers describe the
   relationship between how they farm and biodiversity in two contrasting
   regions: the Netherlands and the French Massif Central. In both regions,
   we included two specific study areas. We focused on dairy farming, as it
   is a key sector in terms of socio-economic importance and biodiversity
   impact in both regions. In each area, we conducted 15 in-depth
   interviews focusing on the impacts of the farm on biodiversity and vice
   versa, as well as on the relational importance of biodiversity to the
   farmer. We allowed farmers to use the term `biodiversity' in their own
   words. We analysed our data using the Integrated Nature Futures
   Framework (I-NFF), a recently proposed framework for analysing what
   people value positively and negatively about nature-related matters. Six
   main narratives emerged, which we named `farming WITH biodiversity',
   `farming FROM biodiversity-valorising what is there', `farming FROM
   biodiversity-innovating for sustainability', `farming FOR biodiversity',
   `farming SEPARATE from biodiversity-out of necessity' and `farming
   SEPARATE from biodiversity-out of conviction'. These narratives vary in
   how farmers conceptualise biodiversity, perceive and value interactions
   between farming and biodiversity, and define problems and solutions.
   Although we encountered partly the same narratives in the Dutch and
   Massif Central areas, we also noted considerable differences. In the
   Dutch areas, we frequently encountered `FOR', which strongly depicts
   biodiversity as an additional service that requires payment, and
   `SEPARATE-out of conviction', which argues for production-intensive
   systems. In the Massif Central areas, we virtually never encountered
   these narratives and instead more often encountered `WITH', which
   depicts farming as naturally integrated with biodiversity. Moreover, the
   narratives had strong region-specific details. We close by discussing
   how better insight into such differences and commonalities can help
   foster more understanding engagement with farmers on the topic of
   biodiversity.Read the free for this article on the Journal blog.},
