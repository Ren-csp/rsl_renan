@article{ WOS:000216443500010,
Author = {de Barros, Marcelo Paes and De Musis, Carlo Ralph},
Title = {A SYSTEMIC APPROACH ON IMPLICATIONS BETWEEN FRAGMENTATION OF GREEN AREAS
   AND THE THERMAL ENVIRONMENT OF URBAN SPACE},
Journal = {REVISTA ELETRONICA EM GESTAO EDUCACAO E TECNOLOGIA AMBIENTAL},
Year = {2013},
Volume = {9},
Number = {9},
Pages = {1999-2017},
Abstract = {This paper presents the results of a study that investigate the
   magnitude and extent of the influence of fragments of vegetated area on
   thermal environments of urbanized areas of the city of Cuiaba, MT. The
   main tools were remote sensing, on examination of a CBERS acquired on
   June 20, 2009, mobile measurements and geographical information systems
   to obtain a macro view of urban complex. The results confirmed the
   influence of fragments of woody vegetation on the air temperature
   environments analyzed, ranging between 200 m and 500 m, depending on the
   time and station, dry or rainy. It was found that the fragmentation of
   green areas, described by the fractal dimension, acts more decisively in
   thermal environments with low percentages of vegetated area, and in such
   cases a less fragmented vegetation resulted in lower air temperatures.},
