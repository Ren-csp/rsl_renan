@article{ WOS:000264995100004,
Author = {Porta, Sergio and Crucitti, Paolo and Latora, Vito},
Title = {Multiple centrality assessment in Parma: a network analysis of paths and
   open spaces},
Journal = {URBAN DESIGN INTERNATIONAL},
