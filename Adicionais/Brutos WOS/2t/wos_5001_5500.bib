@article{ WOS:001549765500001,
Author = {Yerkeson, Alyssa and Lu, Mingming},
Title = {Evaluating Emissions from Select Urban Parking Garages in Cincinnati,
   OH, Using Portable Sensors and Their Potentials for Sustainability
   Improvement},
Journal = {SUSTAINABILITY},
