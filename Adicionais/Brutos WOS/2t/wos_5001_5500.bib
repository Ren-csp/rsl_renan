@article{ WOS:001526777900001,
Author = {Wang, Yongpei and Xu, Zhenyu and Liang, Jia},
Title = {Productivity premium in greening settings: Evidence from China's
   national garden cities},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2025},
Volume = {27},
Month = {SEP},
Abstract = {The large-scale land greening action lays the foundation for promoting
   high-quality development and Chinese path to modernization, and is the
   basic way to build a beautiful China. This paper takes the construction
   of National Garden City (NGC) as the starting point to empirically
   estimate the productivity premium brought by national land greening to
   enterprises represented by listed companies. The findings indicate that
   compared to non-NGC, being listed as NGC can bring additional
   productivity premiums to the listed companies to which these cities
   belong, and this premium is confirmed by robust estimates. Heterogeneity
   analysis shows that both southern and northern cities bounded by the
   Qinling-Huaihe Line (QHL) can benefit from enterprise productivity
   premiums from land greening. The enterprise productivity premium in the
   Three-North Shelterbelt Program area is very prominent, while it is not
   significant in the middle and lower reaches of the Yangtze River region.
   The enterprise productivity premium of land greening is mainly realized
   through scale and innovation effects, as listed companies located in NGC
   cities have increased total assets per capita, capital intensity, R\&D
   personnel, and R\&D expenditures. By introducing interaction terms
   between NGC and land greening indicators such as urban green land rate,
   green coverage rate, and park green area per capita, this paper finds
   that urban greening after being selected as the NGC city exerts an
   inhibitory effect on enterprises' productivity, which provides insights
   for subsequent improvement of urban greening management.},
