@article{ WOS:000358836800065,
Author = {Saw, Le E. and Lim, Felix K. S. and Carrasco, Luis R.},
Title = {The Relationship between Natural Park Usage and Happiness Does Not Hold
   in a Tropical City-State},
Journal = {PLOS ONE},
Year = {2015},
Volume = {10},
Number = {7},
Month = {JUL 29},
Abstract = {Previous studies have shown that contact with urban green spaces can
   produce positive effects on people's stress, health and well-being
   levels. However, much of this research has been conducted in the
   temperate regions of Europe or North America. Additionally, most studies
   have only compared the effects of urban and natural areas on health and
   wellbeing, but not made a finer distinction between different types of
   urban green spaces. We tested the relationship between well-being and
   the access or use of different types of green spaces among young adults
   in Singapore, a tropical city-state. The results showed that
   extraversion and emotional stability increased subjective well-being,
   positive affect and life satisfaction and decreased stress and negative
   affect. In addition, we found that level of physical activity increased
   positive affect and health problems increased negative affect. Neither
   access to green spaces nor the use of green spaces in Singapore
   significantly affected the well-being metrics considered, contradicting
   findings in the temperate regions of the world. We hypothesize that the
   differences in temperature and humidity and the higher greenery and
   biodiversity levels outside parks in Singapore could explain this
   phenomenon. Our results thus question the universality of the
   relationship between well-being and park usage and highlight the need
   for more research into the multifaceted effects of green spaces on
