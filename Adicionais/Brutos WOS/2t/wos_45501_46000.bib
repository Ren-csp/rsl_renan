@article{ WOS:001556173300001,
Author = {Singh, Harman and Ortiz, Mark},
Title = {Thinking with student perspectives on sustainability to cultivate
   care-full sustainability education},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2026},
Volume = {32},
Number = {7},
Pages = {2025-2043},
Month = {JUL 3},
Abstract = {This piece describes the findings of a research project on students'
   perceptions of sustainability at a university in northeastern United
   States. Through semi-structured interviews (n = 29) and a survey (n =
   517), our research questions investigate (a) how students understand and
   define sustainability; (b) what motivates students to take action; and
   (c) how memories shape student perspectives on sustainability. The
   results are explored through thematic qualitative analysis, where
   `active care,' `repair,' `maintenance of ethical relations,'
   `continuation of life-shaping futures,' and `relational scales of care'
   are emergent themes. We situate our findings within scholarship on
   environmental and climate education, youth geographies, and care ethics.
   This study explores how the intersection between these fields can help
   us leverage student perspectives to map pedagogical opportunities for
   `care-full' sustainability education. We conclude that engaging with
   student definitions, memories, and motivations for sustainable action
   may generate opportunities for `care-full' sustainability education that
   connects with and deepens existing student literacies.},
