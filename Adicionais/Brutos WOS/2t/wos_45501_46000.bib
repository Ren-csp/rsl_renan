@article{ WOS:001645831600001,
Author = {Reyes-Garcia, Victoria and Attoh, Emmanuel M. N. A. N. and
   Barrington-Leigh, Christopher and Benyei, Petra and Calvet-Mir, Laura
   and Chakauya, Rumbidzayi and Al Faisal, Abdullah and Galbraith, Eric D.
   and Glauser, Marcos and Izquierdo, Andrea E. and Junqueira, Andre B. and
   Li, Xiaoyue and Lopez-Maldonado, Yolanda and Minarro, Sara and Porcher,
   Vincent and Porcuna-Ferrer, Anna and Schlingmann, Anna and Singh,
   Priyatma and Torrents-Tico, Miquel and LICCI Consortium},
Title = {Experienced climate change impacts help explain subjective
   well-being-Evidence from 14 nature-dependent communities},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {2},
Pages = {461-475},
Month = {FEB},
Abstract = {Climate change profoundly affects well-being in complex and
   interconnected ways. However, the relationship between climate change
   and well-being has been explored in only a handful of settings, most of
   which are industrialized. Here, we investigate the association between
   perceived climate change impacts, their severity and subjective
   well-being (measured as life satisfaction) using cross-culturally
   comparable first-hand reports from 2488 participants across 14
   nature-dependent communities. We find a negative association between
   site-aggregated life satisfaction and different metrics of climate
   change: perceptions of local impacts, reported severity and instrumental
   measurements. Within sites, individual-level associations between
   perceived severity of climate change impacts and life satisfaction are
   weak or absent. Further analysis suggests that site-level
   characteristics play a crucial role in shaping these patterns. This
   could indicate that it is the overall vulnerability and exposure of a
   community to climate change impacts, rather than individual experiences
   that matters most. Our findings offer a nuanced understanding of how
   climate change impacts relate to well-being, emphasizing the
   multidimensional character of climate change impacts and underscoring
   the importance of local context in shaping these relationships.Read the
   free for this article on the Journal blog.
   El cambio clim \& aacute;tico afecta profundamente el bienestar de las
   personas de formas complejas e interconectadas. Sin embargo, la relaci
   \& oacute;n entre el cambio clim \& aacute;tico y el bienestar ha sido
   poco explorada, y principalmente en pa \& iacute;ses industrializados.
   En este estudio, investigamos la asociaci \& oacute;n entre la percepci
   \& oacute;n de los impactos del cambio clim \& aacute;tico y su gravedad
   y el bienestar subjetivo (medido como satisfacci \& oacute;n con la
   vida) utilizando informaci \& oacute;n recogida entre 2488 personas de
   14 sociedades diferentes, todas ellas con alta dependencia de la
   naturaleza para su subsistencia. Encontramos una asociaci \& oacute;n
   negativa entre el promedio de la satisfacci \& oacute;n con la vida de
   cada sociedad y diferentes m \& eacute;tricas del cambio clim \&
   aacute;tico: percepci \& oacute;n de los impactos locales, gravedad
   reportada, y medidas instrumentales. Dentro de cada sociedad, las
   asociaciones entre la percepci \& oacute;n individual de la gravedad de
   los impactos del cambio clim \& aacute;tico y la satisfacci \& oacute;n
   con la vida son d \& eacute;biles o inexistentes. Un an \& aacute;lisis
   adicional sugiere que las caracter \& iacute;sticas de las sociedades
   desempe \& ntilde;an un papel crucial en la configuraci \& oacute;n de
   estos patrones. Esto podr \& iacute;a indicar que, m \& aacute;s que las
   experiencias individuales, la relaci \& oacute;n entre los impactos del
   cambio clim \& aacute;tico y la satisfacci \& oacute;n con la vida se
   explica por la vulnerabilidad y exposici \& oacute;n general de las
   sociedades a los impactos del cambio clim \& aacute;tico. Nuestros
   hallazgos matizan lo que sabemos de las relaciones de los impactos del
   cambio clim \& aacute;tico y el bienestar, enfatizando el car \&
   aacute;cter multidimensional de dichos impactos y subrayando la
   importancia del contexto local en la configuraci \& oacute;n de estas
   relaciones.},
