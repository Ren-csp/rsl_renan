@article{ WOS:001098180200016,
Author = {Bagdonaite, Ieva and Marinova, Irina N. and Rudjord-Levann, Asha M. and
   Pallesen, Emil M. H. and King-Smith, Sarah L. and Karlsson, Richard and
   Romer, Troels B. and Chen, Yen-Hsi and Miller, Rebecca L. and Olofsson,
   Sigvard and Norden, Rickard and Bergstrom, Tomas and Dabelsteen, Sally
