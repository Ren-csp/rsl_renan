@article{ WOS:001586169900044,
Author = {Sahoo, Bikash R. and Deng, Xiexiong and Wong, Ee Lin and Clark, Nathan
   and Yang, Harry J. and Kovalenko, Alexey and Subramanian, Vivekanandan
