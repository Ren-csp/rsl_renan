@article{ WOS:001161577800001,
Author = {Enu, Kirk B. and Zingraff-Hamed, Aude and Boafo, Yaw Agyeman and Rahman,
   Mohammad A. and Pauleit, Stephan},
Title = {Citizens' acceptability and preferred nature-based solutions for
   mitigating hydro-meteorological risks in Ghana},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2024},
Volume = {352},
Month = {FEB 14},
Abstract = {Nature-based solutions (NbS) are high on risk mitigation agendas
   globally, and co-creation pathways that deliberately engage citizens are
   recommended for their design and implementation. However, citizen
   acceptance of NbS has been little investigated. We surveyed 622
   residents in the Greater Kumasi Metropolitan Area (GKMA), Ghana, to
   understand natural risk perceptions and the acceptability of NbS for
   mitigating them. Data was analysed performing descriptive statistics,
   Chi-Square test of independence and the multinomial logit model. The
   results show that most residents in GKMA have experienced flood hazards
   in the last 2 years, with varying degrees of intensity. Extreme heat
   hazards are also perceived to be relatively recent and generally not
   intensive. Several respondents were unsure of the degree of their future
   risk exposure. Residents' past experiences strongly influenced these
   risk perceptions. Second, the results show citizens are trustful in
   present risk mitigation efforts dominated by conventional engineering
   solutions as only 18\% of respondents would prefer NbS, likely due to
   low awareness of NbS and lack of evidence of their effectiveness and
   benefits. Interestingly, NbS preference correlates to a sense of
   insecurity (e.g., exposure to flood hazards perceived as imminent or
   uncertain). While in Europe, preference for green space is positively
   linked to the level of education, in GKMA, citizens with lower levels of
   formal education prefer NbS. This underlines a conflict with the state
   of the knowledge about the potential of NbS. We conclude that improved
   and tailored communication on NbS and co-creation procedures are
   important levers for increasing citizen acceptance of nature-based
   interventions and designing case specific solutions that align with
   local needs and priorities, including expected co-benefits.},
