@article{ WOS:001661858200001,
Author = {Hu, Xueyue and Zhou, Zhongfa and Tang, Fang and Jing, Yating and Ding,
   Ding and Zhang, Tengxian and Yang, Yongliu and Sun, Yaopeng},
Title = {How do relocatees adapt? a longitudinal investigation into the
   spatiotemporal evolution and internal mechanisms of social adaptation in
   post-relocation life},
Journal = {GEOCARTO INTERNATIONAL},
Year = {2026},
Volume = {41},
Number = {1},
Month = {DEC 31},
Abstract = {This study employs longitudinal survey data (2020-2024) from 638
   poverty-alleviation resettlement households in China. Using Wilcoxon
   test, Kruskal-Wallis test, and structural equation model, it
   systematically analyses the spatiotemporal evolution patterns and
   mechanisms of action of social adaptation at the levels of life
   adaptation, economic adaptation, and psychological adaptation. The
   findings reveal that: (1) Social adaptation improved sequentially, with
   economic adaptation showing the greatest gains, followed by
   psychological and life adaptation; (2) A clear center-periphery spatial
   pattern emerged, featuring high adaptation in core urban areas such as
   Guiyang and Zunyi, medium levels in regions like Bijie, and relatively
   lagging adaptation in Qianxinan and Qiannan; (3) The mechanism follows a
   hierarchical mediated pathway: life adaptation -> economic adaptation ->
   psychological adaptation. These findings can serve as empirical evidence
   for the formulation of targeted follow-up support policies to improve
   the adaptive capacity of relocatees and contribute to rural
   revitalization.},
