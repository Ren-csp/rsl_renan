@article{ WOS:000448044300004,
Author = {Chung, Chia-Yu and Berson, Amit and Kennerdell, Jason R. and Sartoris,
   Ashley and Unger, Travis and Porta, Silvia and Kim, Hyung-Jun and Smith,
   Edwin R. and Shilatifard, Ali and Van Deerlin, Vivianna and Lee,
   Virginia M-Y and Chen-Plotkin, Alice and Bonini, Nancy M.},
Title = {Aberrant activation of non-coding RNA targets of transcriptional
   elongation complexes contributes to TDP-43 toxicity},
Journal = {NATURE COMMUNICATIONS},
Year = {2018},
Volume = {9},
Month = {OCT 23},
Abstract = {TDP-43 is the major disease protein associated with amyotrophic lateral
   sclerosis (ALS) and frontotemporal lobar degeneration with ubiquitinated
   inclusions (FTLD-TDP). Here we identify the transcriptional elongation
   factor Ell-a shared component of little elongation complex (LEC) and
   super elongation complex (SEC)-as a strong modifier of TDP-43-mediated
   neurodegeneration. Our data indicate select targets of LEC and SEC
   become upregulated in the fly ALS/FTLD-TDP model. Among them, U12 snRNA
   and a stress-induced long non-coding RNA Hsr omega, functionally
   contribute to TDP-43-mediated degeneration. We extend the findings of
   Hsr omega, which we identify as a chromosomal target of TDP-43, to show
   that the human orthologue Sat III is elevated in a human cellular
   disease model and FTLD-TDP patient tissue. We further demonstrate an
   interaction between TDP-43 and human ELL2 by co-immunoprecipitation from
   human cells. These findings reveal important roles of Ell-complexes LEC
   and SEC in TDP-43-associated toxicity, providing potential therapeutic
   insight for TDP-43-associated neurodegeneration.},
