@article{ WOS:000301488300010,
Author = {Beier, Jonathan S. and Spelke, Elizabeth S.},
Title = {Infants' Developing Understanding of Social Gaze},
Journal = {CHILD DEVELOPMENT},
Year = {2012},
Volume = {83},
Number = {2},
Pages = {486-496},
Month = {MAR-APR},
Abstract = {Young infants are sensitive to self-directed social actions, but do they
   appreciate the intentional, target-directed nature of such behaviors?
   The authors addressed this question by investigating infants
   understanding of social gaze in third-party interactions (N = 104).
   Ten-month-old infants discriminated between 2 people in mutual versus
   averted gaze, and expected a person to look at her social partner during
   conversation. In contrast, 9-month-old infants showed neither ability,
   even when provided with information that highlighted the gazers social
   goals. These results indicate considerable improvement in infants
   abilities to analyze the social gaze of others toward the end of their
   1st year, which may relate to their appreciation of gaze as both a
   social and goal-directed action.},
