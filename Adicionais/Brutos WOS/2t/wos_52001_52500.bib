@article{ WOS:001653316700001,
Author = {Waqar, Ahsan and Mohandes, Saeed Reza and Awuzie, Bankole Osita and
   Stewart, Ian C. and Raja, Babar Nasim Khan},
Title = {Cloud-based construction management platform adoption through the lens
   of TAM and TOE frameworks},
Journal = {SMART AND SUSTAINABLE BUILT ENVIRONMENT},
Year = {2026},
Month = {2026 JAN 6},
Abstract = {PurposeDespite growing interest in digital transformation, the
   construction industry continues to face challenges in the consistent
   adoption of cloud-based construction management platforms (CCMPs).
   Existing literature often overlooks the combined influence of individual
   behavioural perceptions and organizational-environmental readiness. This
   study addresses this gap by integrating the technology acceptance model
   (TAM) and the technology-organization-environment (TOE) framework to
   develop a holistic model of CCMP
   adoption.Design/methodology/approachPartial least squares structural
   equation modelling (PLS-SEM) was applied to data collected from 256
   construction professionals to examine the factors shaping CCMP adoption
   readiness.FindingsThe findings indicate that staff digital competence,
   cybersecurity confidence and platform interoperability significantly
   influence implementation readiness, mediated by perceived
   decision-making support and user learning curve. Organizational size was
   not found to moderate these effects. This study is original in
   developing and empirically validating an integrated TAM-TOE framework
   specifically tailored for CCMP, an area that has received limited
   theoretical and empirical attention. By bridging behavioural and
   contextual perspectives, the research provides a novel multi-level
   understanding of digital readiness in construction, offering actionable
   guidance for firms, platform developers, and policymakers to accelerate
   digital transformation.Originality/valueThis study contributes an
   integrated TAM-TOE framework that captures both individual and
   organizational-environmental perspectives, offering actionable insights
   to guide strategic CCMP implementation in digitally evolving
   construction environments.},
