@article{ WOS:000535792800004,
Author = {Nguyen Xuan Thai and Nguyen Van Duy and Chu Manh Hung and Hugo Nguyen
   and Tran Manh Hung and Nguyen Van Hieu and Nguyen Duc Hoa},
Title = {Realization of a portable H2S sensing instrument based on
   SnO2 nanowires},
Journal = {JOURNAL OF SCIENCE-ADVANCED MATERIALS AND DEVICES},
