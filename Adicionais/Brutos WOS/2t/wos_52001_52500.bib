@article{ WOS:001662902900001,
Author = {Hassanein, Sahar Mohamed Ahmed and Amin, Ghada Essam Eldin and
   El-Gharbawy, Nermin Hassan and Mohamed, Duaa Mohamed Mostafa and
   Abdelaziz, Asmaa Wafeeq},
Title = {Caregivers' Perspectives on the Health Status of Children With Cerebral
   Palsy},
Journal = {JOURNAL OF APPLIED RESEARCH IN INTELLECTUAL DISABILITIES},
Year = {2026},
Volume = {39},
Number = {1},
Month = {JAN 12},
Abstract = {Background Identifying the needs of children with cerebral palsy and
   their caregivers is still a current clinical practice gap. This study
   aimed to assess parents' perceptions of their children with cerebral
   palsy using the Arabic version of the Caregiver Priorities and Child
   Health Index of Life with Disabilities (CPCHILD) scale and identify
   factors influencing these perceptions. Methods Seventy children with
   cerebral palsy and their caregivers were recruited in this
   hospital-based cross-sectional study. The Arabic version of the CPCHILD
   scale was used to assess parents' perceptions of their cerebral palsy
   children's priorities. Participants' clinical and demographic traits
   were assessed to identify potential risk factors. Results Poor CPCHILD
   scores were predicted by older mothers, children with co-occurring
   intellectual disability, children with severe disabilities and children
   who did not receive frequent physiotherapy. Conclusion Identifying the
   risk factors can help optimise medical care and support services for
   children with cerebral palsy and their families.},
