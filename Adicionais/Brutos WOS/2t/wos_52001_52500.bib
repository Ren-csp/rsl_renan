@article{ WOS:001068217000020,
Author = {Huang, Yuying and Zhu, Lin and Cheng, Shipeng and Dai, Ranran and Huang,
   Chunrong and Song, Yanyan and Peng, Bo and Li, Xuezhen and Wen, Jing and
   Gong, Yi and Hu, Yunqian and Qian, Ling and Zhu, Linyun and Zhang,
   Fengying and Yu, Li and Yi, Chunyan and Gu, Wangpeng and Ling, Zhiyang
   and Ma, Liyan and Tang, Wei and Peng, Li and Shi, Guochao and Zhang,
   Yaguang and Sun, Bing},
Title = {Solar ultraviolet B radiation promotes a-MSH secretion to attenuate the
   function of ILC2s via the pituitary-lung axis},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {SEP 12},
Abstract = {The immunomodulatory effects of ultraviolet B (UVB) radiation in human
   diseases have been described. Whether type 2 lung inflammation is
   directly affected by solar ultraviolet (UV) radiation is not fully
   understood. Here, we show a possible negative correlation between solar
   UVB radiation and asthmatic inflammation in humans and mice. UVB
   exposure to the eyes induces hypothalamus-pituitary activation and \&
   alpha;-melanocyte-stimulating hormone (\& alpha;-MSH) accumulation in
   the serum to suppress allergic airway inflammation by targeting group 2
   innate lymphoid cells (ILC2) through the MC5R receptor in mice. The \&
   alpha;-MSH/MC5R interaction limits ILC2 function through attenuation of
   JAK/STAT and NF-\& kappa;B signaling. Consistently, we observe that the
   plasma \& alpha;-MSH concentration is negatively correlated with the
   number and function of ILC2s in the peripheral blood mononuclear cells
   (PBMC) of patients with asthma. We provide insights into how solar UVB
   radiation-driven neuroendocrine \& alpha;-MSH restricts ILC2-mediated
   lung inflammation and offer a possible strategy for controlling allergic
   diseases.
   Allergic asthma is episodic and associated with seasonal changes which
   may have links with UV exposure levels. Here the authors propose a link
   between UVB exposure and ILC2 function through \& alpha;-MSH released
   from the pituitary gland which accumulates in the serum and alters ILC2
   function through the MC5R receptor.},
