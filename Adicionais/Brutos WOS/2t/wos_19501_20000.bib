@article{ WOS:000305169400017,
Author = {Gao, Yafeng and Yao, Runming and Li, Baizhan and Turkbeyler, Erdal and
   Luo, Qing and Short, Alan},
Title = {Field studies on the effect of built forms on urban wind environments},
Journal = {RENEWABLE ENERGY},
Year = {2012},
Volume = {46},
Pages = {148-154},
Month = {OCT},
Abstract = {Airflow through urban environments is one of the most important factors
   affecting human health, outdoor and indoor thermal comfort, air quality
   and the energy performance of buildings. This paper presents a study on
   the effects of wind induced airflows through urban built form using
   statistical analysis. The data employed in the analysis are from the
   year-long simultaneous field measurements conducted at the University of
   Reading campus in the United Kingdom. In this study, the association
   between typical architectural forms and the wind environment are
   investigated; such forms include: a street canyon, a semi-closure, a
   courtyard form and a relatively open space in a low-rise building
   complex. Measured data captures wind speed and wind direction at six
   representative locations and statistical analysis identifies key factors
   describing the effects of built form on the resulting airflows. Factor
   analysis of the measured data identified meteorological and
   architectural layout factors as key factors. The derivation of these
   factors and their variation with the studied built forms are presented
   in detail. (C) 2012 Elsevier Ltd. All rights reserved.},
