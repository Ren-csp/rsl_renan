@article{ WOS:000364605400013,
Author = {Garcia-Mainar, Inmaculada and Montuenga, Victor M. and Navarro-Paniagua,
   Maria},
Title = {Workplace environmental conditions and life satisfaction in Spain},
Journal = {ECOLOGICAL ECONOMICS},
Year = {2015},
Volume = {119},
Pages = {136-146},
Month = {NOV},
Abstract = {This paper expands the research on subjective well-being and outdoor
   environmental conditions by considering environmental conditions
   indoors. Specifically, we examine the impact on life satisfaction of
   self-perceived levels of air and noise pollution in the workplace. We
   provide a monetary valuation of these environmental conditions, using
   the life-satisfaction approach. Our results demonstrate that poor air
   quality and high noise levels in the workplace markedly diminish life
   satisfaction. This holds even after we control for potential endogeneity
   arising from simultaneity of self-perceived workplace environmental
   variables and life satisfaction, by employing an instrumental variable
   strategy. (C) 2015 Elsevier B.V. All rights reserved.},
