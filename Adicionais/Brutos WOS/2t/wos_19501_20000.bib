@article{ WOS:001647795000001,
Author = {Webb, Isabella},
Title = {Tactical Spatial Interventions: Design for Gendered Spatial Justice in
   Peri-Urban Victoria, Australia},
Journal = {OPEN CULTURAL STUDIES},
Year = {2025},
Volume = {9},
Number = {1},
Month = {JAN 8},
Abstract = {This paper explores how tactical and temporary feminist urban design can
   address gendered spatial inequities in peri-urban areas of Victoria,
   Australia. Drawing on intersectional feminist theory and design justice
   frameworks, this examination explores how small-scale, community-led
   interventions, utilising participatory mapping and co-designed
   processes, might provide more immediate and inclusive responses to the
   spatial challenges faced by women individuals in these contexts. While
   based in an Australian context, the research responds to conditions
   typical of rapidly growing outer suburbs in global north cities, where
   car dependency, inadequate infrastructure, and planning delays limit
   equitable access and safety. Through examining international case
   studies including, Making Space in Dalston, London (2007-2010), The
   Garden Library, Tel Aviv (2009), Homebaked, Liverpool (2010-ongoing),
   and Mutfak Workshop, Istanbul (2007-2010), this paper identifies shared
   feminist interventionists practices including co-design, care ethics,
   spatial agency, and adaptability and argues that these approaches offer
   transferable approaches to improve public space. The paper aims to
   identify common feminist principles from these case studies that can
   inform design practice in peri-urban Victoria. It concludes that the
   tactical applications of feminist spatial principles offer a promising
   approach to testing context-sensitive, participatory design strategies
   that may support more equitable urban design outcomes in peri-urban
   settings.},
