@article{ WOS:000324044400022,
Author = {Roopnarine, Peter},
Title = {Ecology and the Tragedy of the Commons},
Journal = {SUSTAINABILITY},
Year = {2013},
Volume = {5},
Number = {2},
Pages = {749-773},
Month = {FEB},
Abstract = {This paper develops mathematical models of the tragedy of the commons
   analogous to ecological models of resource consumption. Tragedies differ
   fundamentally from predator-prey relationships in nature because human
   consumers of a resource are rarely controlled solely by that resource.
   Tragedies do occur, however, at the level of the ecosystem, where
   multiple species interactions are involved. Human resource systems are
   converging rapidly toward ecosystem-type systems as the number of
   exploited resources increase, raising the probability of system-wide
   tragedies in the human world. Nevertheless, common interests exclusive
   of exploited commons provide feasible options for avoiding tragedy in a
   converged world.},
