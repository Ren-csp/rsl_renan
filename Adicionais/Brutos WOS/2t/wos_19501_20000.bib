@article{ WOS:001738022200006,
Author = {Cran, Amy and Wilson, Patrick C. and Brave Rock, Mark},
Title = {Walking With SAGE Clan Patrol: Practicing Empathy in the Indigenous
   Urban Landscape},
Journal = {CITY \& SOCIETY},
Year = {2026},
