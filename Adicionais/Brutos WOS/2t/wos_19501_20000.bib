@article{ WOS:001820167800001,
Author = {Lamb, Zachary and Sullivan, Esther and Rumbach, Andrew},
Title = {Manufacturing the urban: Situating manufactured housing and manufactured
   home communities in urban studies and charting a course for research},
Journal = {URBAN STUDIES},
Year = {2026},
Volume = {63},
Number = {10, SI},
Pages = {2123-2135},
Month = {AUG},
Abstract = {Manufactured housing (MH) provides a key source of affordable housing in
   the United States and elsewhere, including in Canada and Australia. In
   this editors' introduction, we argue that MH and manufactured home
   communities (MHCs) deserve more attention from researchers, planners,
   and policy makers because they are home to millions of people and
   because they provide a lens through which to understand critical
   contemporary issues in the study of housing and urban settlements more
   broadly. We provide an overview, define key terms, and describe the
   scale, and some advantages and disadvantages of manufactured housing.
   The introduction also defines manufactured home communities (also
   commonly called by other names, including ``mobile home parks{''} and
   ``trailer parks{''}) and describes their broad diversity. We introduce
   the articles in the special issue, summarizing key areas of concern that
   shape housing affordability, security, and equity for residents of MH
   and MHCs. These include: (1) regulation and location of manufactured
   housing; (2) housing tenure, ownership, and finance; (3) resident
   experience, social relations, and politics in manufactured home
   communities; and (4) hazards and climate change. This introduction and
   the other articles in this issue make the case that manufactured housing
   should be repositioned from the margins to the center of scholarship on
   housing and urbanism because the challenges facing manufactured housing
   residents, from financialization and tenure insecurity to heightened
   climate change vulnerability, are relevant and revelatory for research
   in other marginalized communities and housing types around the world.
