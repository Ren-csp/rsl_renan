@article{ WOS:001462477900005,
Author = {Chabbi, Karima and Zennir, Rabah and Khallef, Boubaker},
Title = {Monitoring and Protection of Tourist Forests using Landsat Data: Case of
   El Kala National Park (Algeria)},
Journal = {POLISH JOURNAL OF ENVIRONMENTAL STUDIES},
Year = {2025},
Volume = {34},
Number = {4},
Pages = {3547-3552},
Abstract = {This study focuses on the monitoring and protection of tourist forests
   within El Kala National Park, using data from the Landsat program. Over
   the period 2013 to 2023, analysis of satellite images, combined with the
   use of the normalized difference vegetation index (NDVI) and a
   dimidiated pixel model, revealed significant changes in vegetation
   coverage. The results indicate a significant decrease in forest cover,
   particularly in the northwest, northeast, and south regions of the park,
   attributable to various threats such as fires, increasing urbanization,
   agricultural expansion, illegal logging, land clearing, and overgrazing.
   The study highlights the imperative for urgent conservation measures,
   including increased monitoring, strict enforcement of laws against
   illegal logging, public awareness, and increased efforts to fight fires.
   An integrated approach involving local authorities, communities,
   environmental experts, and conservation organizations is crucial to
   ensuring the preservation of this valuable forest resource and
   maintaining regional ecological balance.},
