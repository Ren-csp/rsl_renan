@article{ WOS:001009851700013,
Author = {Werba, Gregor and Weissinger, Daniel and Kawaler, Emily A. and Zhao,
   Ende and Kalfakakou, Despoina and Dhara, Surajit and Wang, Lidong and
   Lim, Heather B. and Oh, Grace and Jing, Xiaohong and Beri, Nina and
   Khanna, Lauren and Gonda, Tamas and Oberstein, Paul and Hajdu, Cristina
   and Loomis, Cynthia and Heguy, Adriana and Sherman, Mara H. and Lund,
   Amanda W. and Welling, Theodore H. and Dolgalev, Igor and Tsirigos,
   Aristotelis and Simeone, Diane M.},
Title = {Single-cell RNA sequencing reveals the effects of chemotherapy on human
   pancreatic adenocarcinoma and its tumor microenvironment},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {FEB 13},
Abstract = {The tumor microenvironment (TME) in pancreatic ductal adenocarcinoma
   (PDAC) is a complex ecosystem that drives tumor progression; however,
   in-depth single cell characterization of the PDAC TME and its role in
   response to therapy is lacking. Here, we perform single-cell RNA
   sequencing on freshly collected human PDAC samples either before or
   after chemotherapy. Overall, we find a heterogeneous mixture of basal
   and classical cancer cell subtypes, along with distinct
   cancer-associated fibroblast and macrophage subpopulations. Strikingly,
   classical and basal-like cancer cells exhibit similar transcriptional
   responses to chemotherapy and do not demonstrate a shift towards a
   basal-like transcriptional program among treated samples. We observe
   decreased ligand-receptor interactions in treated samples, particularly
   between TIGIT on CD8 + T cells and its receptor on cancer cells, and
   identify TIGIT as the major inhibitory checkpoint molecule of CD8 + T
   cells. Our results suggest that chemotherapy profoundly impacts the PDAC
   TME and may promote resistance to immunotherapy.
   The role of therapy in shaping the tumor microenvironment in pancreatic
   ductal adenocarcinoma (PDAC) remains to be explored. Here, the authors
   perform single-cell RNA sequencing in PDAC samples before and after
   chemotherapy and suggest that chemotherapy may promote resistance to
   immunotherapy.},
