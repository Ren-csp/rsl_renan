@article{ WOS:000626610200022,
Author = {Zaghlool, Shaza B. and Sharma, Sapna and Molnar, Megan and
   Matias-Garcia, Pamela R. and Elhadad, Mohamed A. and Waldenberger,
   Melanie and Peters, Annette and Rathmann, Wolfgang and Graumann,
