@article{ WOS:001782885800001,
Author = {Sugiera, Malgorzata},
Title = {How to story the ecological uncanny: unthinking human mastery in and
   through critical zones},
Journal = {JOURNAL FOR CULTURAL RESEARCH},
Year = {2026},
Month = {2026 JUN 4},
Abstract = {This article explores how contemporary fiction and theory grapple with
   the `ecological uncanny' - the unsettling recognition of human
   entanglement with nonhuman forces in the Anthropocene. Drawing on Amitav
   Ghosh's call for new narrative forms, the article examines the
   imaginative limits of Western culture's human-centred epistemology. It
   connects Ghosh's notion of the uncanny with Timothy Morton's
   `hyperobjects' and Anna Tsing's `Anthropocene hotspots,' arguing that
   these concepts reveal ruptures in systems where human mastery collapses.
   Building on recent developments in environmental narratology
   (Caracciolo, James, Kortekallio), it proposes that fiction operates as
   an affective technology capable of reconfiguring perception and ethics
   by immersing readers in multispecies entanglements. Through close
   readings of Adrian Tchaikovsky's Saturation Point (2024) and Jeff
   VanderMeer's Southern Reach series, especially the new instalment
   Absolution (2024), the article demonstrates how near-future narratives
   enact `readerly choreographies' that invite audiences to experience the
   limits of knowledge and control. Both texts construct `critical zones' -
   feral, hybrid spaces where human and nonhuman agencies blur. These
   zones, marked by epistemic uncertainty, compel readers to `unthink'
   human sovereignty and confront the affective and cognitive
   disorientation of living amid environmental collapse.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
