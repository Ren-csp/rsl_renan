@article{ WOS:A1997XJ14300042,
Author = {Kaufmann, RK and Stern, DI},
Title = {Evidence for human influence on climate from hemispheric temperature
   relations},
Journal = {NATURE},
Year = {1997},
Volume = {388},
Number = {6637},
Pages = {39-44},
Month = {JUL 3},
Abstract = {Analysis of observational temperature records for the Northern and
   Southern hemispheres indicates a statistical relationship in which
   Northern Hemisphere temperature depends on temperature in the Southern
   Hemisphere. This pattern, which has strengthened over time, can be
   explained by the climatic effects of anthropogenic trace gases and
   tropospheric sulphate aerosols. A similar statistical pattern is
   produced by model simulations of the historical atmosphere.},
