@article{ WOS:000449459000009,
Author = {Chen, Xingjuan and Liu, Degang and Zhou, Donghui and Si, Yubing and Xu,
   David and Stamatkin, Christopher W. and Ghozayel, Mona K. and Ripsch,
   Matthew S. and Obukhov, Alexander G. and White, Fletcher A. and Meroueh,
   Samy O.},
Title = {Small-molecule CaVα1•CaVβ antagonist suppresses
   neuronal voltage-gated calcium-channel trafficking},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2018},
Volume = {115},
Number = {45},
Pages = {E10566-E10575},
Month = {NOV 6},
Abstract = {Extracellular calcium flow through neuronal voltage-gated Ca(V)2.2
   calcium channels converts action potential-encoded information to the
   release of pronociceptive neurotransmitters in the dorsal horn of the
   spinal cord, culminating in excitation of the postsynaptic central
   nociceptive neurons. The Ca(V)2.2 channel is composed of a pore-forming
   alpha(1) subunit (Ca-V alpha(1)) that is engaged in protein-protein
   interactions with auxiliary alpha(2)/delta and beta subunits. The
   high-affinity Ca(V)2.2 alpha(1)center dot Ca-V beta(3) protein-protein
   interaction is essential for proper trafficking of CaV2.2 channels to
   the plasma membrane. Here, structure-based computational screening led
   to small molecules that disrupt the Ca(V)2.2 alpha(1)center dot Ca-V
   beta(3) protein-protein interaction. The binding mode of these compounds
   reveals that three substituents closely mimic the side chains of
   hot-spot residues located on the a-helix of Ca(V)2.2 alpha(1).
   Site-directed mutagenesis confirmed the critical nature of a salt-bridge
   interaction between the compounds and CaV beta 3 Arg-307. In cells,
   compounds decreased trafficking of Ca(V)2.2 channels to the plasma
   membrane and modulated the functions of the channel. In a rodent
   neuropathic pain model, the compounds suppressed pain responses.
   Small-molecule alpha-helical mimetics targeting ion channel
   protein-protein interactions may represent a strategy for developing
   nonopioid analgesia and for treatment of other neurological disorders
   associated with calcium-channel trafficking.},
