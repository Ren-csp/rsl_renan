   Brogi, R., Univ Sassari, Dept Vet Med, Via Vienna 2, I-07100 Sassari, Italy.},
DOI = {10.1111/acv.12858},
EarlyAccessDate = {FEB 2023},
ISSN = {1367-9430},
EISSN = {1469-1795},
Keywords = {Canis lupus; large carnivores; human-wildlife conflict; wildlife
   management; urban wildlife syndrome; recolonization; human-dominated
   landscapes},
Keywords-Plus = {BOAR SUS-SCROFA; CANIS-LUPUS; HABITAT SELECTION; LARGE CARNIVORES;
   MULTIMODEL INFERENCE; BEHAVIORAL ECOLOGY; BIALOWIEZA FOREST; RENDEZVOUS
