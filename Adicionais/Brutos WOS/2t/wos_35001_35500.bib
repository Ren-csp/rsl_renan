@article{ WOS:001812559300001,
Author = {Shepherd, Sam and McWilliams, Laura and Cunningham, Oliver S. and
   Lubarsky, Helen and Tribello, Gareth A. and Phillips, Debra H. and
   Wilkins, David M.},
Title = {Thermodynamic andStructural Insights into EndocrineDisruptor Adsorption},
Journal = {JOURNAL OF PHYSICAL CHEMISTRY C},
Year = {2026},
