@article{ WOS:000894366400001,
Author = {Charalampopoulos, Ioannis and Matzarakis, Andreas},
Title = {Thoughts about the Thermal Environment and the Development of Human
   Civilisation},
Journal = {ATMOSPHERE},
Year = {2022},
Volume = {13},
Number = {11},
Month = {NOV},
Abstract = {Thermal conditions are the most challenging factors in studying human
   biometeorology, indoor and outdoor design, and adaptation to climate
   change. The thermal environment is always present and shapes everyday
   life, behaviours, and the natural and artificial environment. In this
   paper, we analyse some thoughts that link thermal perception to the
   roots of human civilisation. Following the narrative thread of mythology
   and the history of religions, there are direct and indirect references
   to the thermal environment everywhere. The thermal environment may be a
   part of the core of human culture.},
