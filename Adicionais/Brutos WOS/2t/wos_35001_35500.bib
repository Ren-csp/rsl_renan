@article{ WOS:000331649100005,
Author = {Ondriska, F. and Macuhova, K. and Melicherova, J. and Reiterova, K. and
   Valentova, D. and Beladicova, V. and Halgos, J.},
Title = {Toxocariasis in urban environment of western Slovakia},
Journal = {HELMINTHOLOGIA},
