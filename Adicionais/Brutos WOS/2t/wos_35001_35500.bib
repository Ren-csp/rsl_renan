@article{ WOS:A1985ADA4100002,
Author = {GRANGE, JM and YATES, MD and COLLINS, CH},
Title = {SUBDIVISION OF MYCOBACTERIUM-TUBERCULOSIS FOR EPIDEMIOLOGICAL PURPOSES -
   A 7 YEAR STUDY OF THE CLASSICAL AND ASIAN TYPES OF THE HUMAN TUBERCLE
   BACILLUS IN SOUTHEAST ENGLAND},
Journal = {JOURNAL OF HYGIENE},
Year = {1985},
Volume = {94},
Number = {1},
Pages = {9-21},
Abstract = {Human strains of M. tuberculosis were divided into the Classical and
   Asian types according to their sensitivity to thiophene-2-carboxylic
   acid hydrazide. The isolation of these 2 types in southeast England was
   studied during a 7-yr period (1977-1983). The Asian type was more
   prevalent among ethnic Asian patients than among ethnic Europeans. Among
   Europeans there was a decline in the isolation rate of Classical strains
   and a small but significant increase in Asian strains during the study
   period, so that the proportion of the latter type in this group is
   increasing. The type of bacillus was unrelated to the site of isolation
   except that the incidence of lymphadenitis due to the Asian type among
   European females was significantly higher than expected. European
   patients tended to be older than Asian patients, and the differences in
   age distribution according to site of isolation and type of bacillus in
   each ethnic group were small. A notable exception occurred with European
   females infected with the Asian type, whose age distribution was similar
   to the Asians. In view of the differences in behavior of the 2 types of
   human tubercle bacilli in this country there is a need to continue a
   bacteriological surveillance and also to determine whether the nature of
   the host-pathogen interaction varies according to the type of bacillus.},
