@article{ WOS:001293931000001,
Author = {Bauer, Michelle E. E. and Kovacs, Ildiko G. and Pike, Ian},
Title = {Monkey bars and medical masks: a photo-voice study of children's
   playground safety in British Columbia, Canada},
Journal = {JOURNAL OF ADVENTURE EDUCATION AND OUTDOOR LEARNING},
Year = {2025},
Volume = {25},
Number = {4},
Pages = {919-937},
Month = {OCT 2},
Abstract = {Children's perspectives on their outdoor play safety can provide unique
   insight into what activities and environments are injurious for them. In
   this study, we conducted photo-elicitation interviews with 13 children
   (7 girls, 6 boys) from low- to mid-income communities who were between
   the ages of 9- to 13-years-old. The goal of the study was to examine
   their perspectives of outdoor play safety around urban playgrounds over
   a two-week period while they participated in day camp activities. Our
   thematic content analysis resulted in three themes: (1) fear of falling;
   (2) illness prevention; and (3) need for excitement. Our findings
   suggest children's perception of safe play may be shaped by exposure to
   sanitary practices throughout the COVID-19 pandemic. Further, findings
   demonstrate children can experience tensions in participating in
   desirable play that is exciting, novel, and challenging, while fearing
   they could fall from higher structures that afford them with these
   opportunities.},
