Title = {Repurposing benzimidazole and benzothiazole derivatives as potential
   inhibitors of SARS-CoV-2: DFT, QSAR, molecular docking, molecular
   dynamics simulation, and in-silico pharmacokinetic and
   toxicity studies},
Journal = {JOURNAL OF KING SAUD UNIVERSITY SCIENCE},
