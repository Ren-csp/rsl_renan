   Spence, Alexa; Ogunbode, Charles, Univ Nottingham, Sch Psychol, Nottingham, England.
   Demski, Christina, Univ Bath, Dept Psychol, Bath, England.
   Capstick, Stuart, Cardiff Univ, Sch Psychol, Cardiff, Wales.},
DOI = {10.1016/j.cresp.2025.100221},
