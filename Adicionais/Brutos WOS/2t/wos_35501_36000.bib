@article{ WOS:001681289400001,
Author = {Kalyanasundaram, Madhanraj and Yadav, Manju and Krishnan, Kavya and
   Singh, Surya and Soni, Rachna and Sahoo, Krushna Chandra and Pathak,
   Ashish and Atkins, Salla and Stalsby Lundborg, Cecilia and Rousta,
   Kamran and Diwan, Vishal},
Title = {Understanding community insights on waste segregation and environmental
   health using a photovoice based crowdsourcing approach in India},
Journal = {DISCOVER SOCIAL SCIENCE AND HEALTH},
Year = {2026},
Volume = {6},
Number = {1},
Month = {JAN 9},
Abstract = {Increasing amount of municipal solid waste is a growing global concern
   harming the health of the humans and animals and affecting the
   sustainability of the environment. While citizens are expected to take
   responsibility for waste sorting and segregation, limited engagement,
   lack of awareness, and dependency on others often hinder effective waste
   management at the source. This study aims to understand participants'
   perceptions of waste segregation and management using a photovoice-based
   crowdsourcing approach. Through qualitative analysis of photographs and
   accompanying narratives submitted in a national contest, we explored how
   individuals interpret waste-related challenges, their motivations or
   barriers to action, and developed a conceptual framework. While many
   participants demonstrated awareness of the consequences of poor waste
   management and advocated for the principles of reduce, reuse, and
   recycle, a key theme that emerged was the lack of community
   participation and engagement. The conceptual framework was mapped
   against the Theory of Planned Behaviour and the
   Motivation-Opportunity-Ability-Behaviour model to contextualize and
   highlight the interaction of attitudes, perceived norms, and abilities.
   This study highlights the utility of participatory, photovoice-driven
   methods in shaping effective and inclusive waste management strategies.},
