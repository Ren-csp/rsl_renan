   Canales Martinez, Gregorio, Univ Alicante, Dept Geog Humana, Apartado 99, E-03080 Alicante, Spain.},
DOI = {10.6018/turismo.39.290501},
ISSN = {1139-7861},
Keywords = {Catral; Huerta; landscape transformation; landscape integration;
   landscape fragmentation; urban-industrial sprawl},
Research-Areas = {Social Sciences - Other Topics},
Web-of-Science-Categories  = {Hospitality, Leisure, Sport \& Tourism},
