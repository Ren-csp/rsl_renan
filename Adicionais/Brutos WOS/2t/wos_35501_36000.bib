@article{ WOS:000397473200001,
Author = {D'Esposito, Daniela and Ferriello, Francesca and Dal Molin, Alessandra
   and Diretto, Gianfranco and Sacco, Adriana and Minio, Andrea and Barone,
   Amalia and Di Monaco, Rossella and Cavella, Silvana and Tardella, Luca
