@article{ WOS:001649971300001,
Author = {Aron, Elaine N. and Lionetti, Francesca},
Title = {Six reasons for confusion about the trait of high sensitivity},
Journal = {CURRENT PSYCHOLOGY},
Year = {2025},
Volume = {45},
Number = {1},
Month = {DEC 27},
Abstract = {This paper addresses the challenges in identifying and describing the
   Sensory Processing Sensitivity (SPS) trait, often referred to as high
   Environmental Sensitivity. SPS is a survival strategy rooted in careful
   observation before action, making it difficult to recognize externally.
   The widely used measure for SPS is outdated and does not fully capture
   the depth of processing, emotional responsiveness, and empathy intrinsic
   to this trait. SPS leads to differential susceptibility, resulting in
   varied behaviors depending on early experiences. Those with supportive
   childhoods often blend in, while those with difficult upbringings may be
   more visible due to their heightened stress responses, creating a skewed
   perception of the trait. Contrary to popular belief, SPS is not strongly
   associated with introversion or avoidance of novelty. Moreover, cultural
   stereotypes contribute to the underrepresentation of highly sensitive
   men, further complicating SPS understanding. This confusion can lead to
   misidentifications, especially in well-adjusted individuals who
   successfully manage their sensitivity. The paper advocates for continued
   research, particularly studies that consider differential
   susceptibility, to provide a more accurate understanding of SPS.
   Accurate information is crucial to prevent harmful stereotypes and to
   support those who are most vulnerable, and to enhance public and
   professional awareness of the trait's complexity and potential.},
