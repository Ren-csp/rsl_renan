@article{ WOS:000542629600097,
Author = {Cheng, Zeyang and Lu, Jian and Zhao, Yi},
Title = {Pedestrian Evacuation Risk Assessment of Subway Station under
   Large-Scale Sport Activity},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
