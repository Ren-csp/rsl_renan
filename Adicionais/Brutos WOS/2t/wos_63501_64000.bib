@article{ WOS:001621550300001,
Author = {Sun, Qifa and Sun, Zhuoan and Wang, Jianheng and Hu, Chen and Wang, Xu
   and Yang, Dexian and Zhao, Jian},
Title = {Soil Heavy Metal Pollution and Ecological Risk Health Risk Assessment in
   Gengzhen Town, China},
