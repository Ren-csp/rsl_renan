@article{ WOS:000939542000001,
Author = {Saadi, Sima and Antoni, Jean-Philippe},
Title = {Assessing the role of settlement in the environmental challenges of
   sensitive ecosystems. A case study in Zrebar wetland (Iran)},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2023},
Volume = {75},
Month = {JUL},
Abstract = {The majority of the planet's natural systems, especially sensitive
   ecosystems, are undergoing rapid change as a result of environmental
   problems. This issue has been made worse by settlements and their
   activities. Which has led to environmental issues in the sensitive
   ecosystem. As a result, the goal of this article is to assess how
   settlers play a part in the environmental problems sensitive ecosystems
   face. Zrebar Lake, one of Iran's most significant wetlands, will
   function as the case study for this analysis. The Required data were
   collected through a survey conducted from 2020 to 2021, among 360
   responses in 15 villages and Marivan city in Iran. The statistical
   analysis was performed using the SPSS and Structural Equation Modeling
   (SEM) designed with AMOS software. In addition, the probability level
   (P: 0.0001) is optimum, and Then the spatial analysis was performed in
   ArcGIS by spatial interpolation with Inverse distance weighted (IDW).
   The results indicate that in all dimensions examined, settlements have
   significantly contributed to the occurrence of environmental challenges
   in the Zrebar wetland ecosystem. And Settlements in close proximity to
   sensitive ecosystems have a significant impact on these challenges.
   Finally, the findings of this study demonstrate the problems that a
   sensitive ecosystem faces, using statistical and spatial analysis to aid
   in the practical implementation of sustainable management in the
   settle-ments surrounding the wetland ecosystem, as well as new
   approaches to launching related policies. Provide long-term ecosystem
   management in urban and rural areas.},
