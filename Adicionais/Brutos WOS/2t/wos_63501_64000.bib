@article{ WOS:000466130300001,
Author = {De Pourcq, Kobe and Thomas, Evert and Elias, Marlene and Van Damme,
   Patrick},
Title = {Exploring Park-People Conflicts in Colombia through a Social Lens},
Journal = {ENVIRONMENTAL CONSERVATION},
Year = {2019},
Volume = {46},
