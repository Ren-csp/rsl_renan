@article{ WOS:A1993MJ97300015,
Author = {KAPLAN, R},
Title = {THE ROLE OF NATURE IN THE CONTEXT OF THE WORKPLACE},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {1993},
Volume = {26},
Number = {1-4},
Pages = {193-201},
Month = {OCT},
Note = {34th Annual Conference of the Association-of-Collegiate-Schools,
   COLUMBUS, OH, OCT 20-NOV 01, 1992},
Organization = {ASSOC COLLEGIATE SCH},
Abstract = {The well-being of the workforce is clearly a matter of concern to the
   employer. Such concern translates to considerable costs in the form of
   fringe benefit packages, health promotion programs, ergonomics, and
   other ways to reduce absence and enhance health and satisfaction.
   Despite such efforts, however, one way lo address well-being that
   entails relatively low costs has been largely ignored in the work
   context. Proximity and availability of the natural environment can
   foster many desired outcomes, even if the employee does not spend a
   great amount of time in the natural setting. A theoretical framework is
   presented that helps explain why even the view from the window can have
   a positive impact with respect to well-being. Results from two studies
   offer some substantiation. Further research on the role of nature in the
   workplace is essential; however, decisions to provide health promoting
   programs and to enhance fringe benefit packages have not been offered as
   a direct consequence of empirical verification. While providing windows
   at work may not be a simple matter, other ways to increase contact with
   vegetation may provide a low-cost, high-gain approach to employee
   well-being and effectiveness.},
