@article{ WOS:000839111400001,
Author = {Marin-Lopez, Blas A. and Jimenez-Gomez, David and Abellan-Perpinan,
   Jose-Maria},
Title = {Behavioral Economics in the Epidemiology of the COVID-19 Pandemic:
   Theory and Simulations},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {15},
Month = {AUG},
Abstract = {We provide a game-theoretical epidemiological model for the COVID-19
   pandemic that takes into account that: (1) asymptomatic individuals can
   be contagious, (2) contagion is behavior-dependent, (3) behavior is
   determined by a game that depends on beliefs and social interactions,
   (4) there can be systematic biases in the perceptions and beliefs about
   the pandemic. We incorporate lockdown decisions by the government into
   the model. The citizens' and government's beliefs can exhibit several
   biases that we discuss from the point of view of behavioral economics.
   We provide simulations to understand the effect of lockdown decisions
   and the possibility of ``nudging{''} citizens in the right direction by
   improving the accuracy of their beliefs.},
