@article{ WOS:000294802600015,
Author = {Tena, Juan J. and Alonso, M. Eva and de la Calle-Mustienes, Elisa and
   Splinter, Erik and de Laat, Wouter and Manzanares, Miguel and Luis
   Gomez-Skarmeta, Jose},
Title = {An evolutionarily conserved three-dimensional structure in the
   vertebrate Irx clusters facilitates enhancer sharing and
   coregulation},
Journal = {NATURE COMMUNICATIONS},
Year = {2011},
Volume = {2},
Month = {MAY},
Abstract = {Developmental gene clusters are paradigms for the study of gene
   regulation; however, the mechanisms that mediate phenomena such as
   coregulation and enhancer sharing remain largely elusive. Here we
   address this issue by analysing the vertebrate Irx clusters. We first
   present a deep enhancer screen of a 2-Mbp span covering the IrxA
   cluster. Using chromosome conformation capture, we show that enhancer
   sharing is widespread within the cluster, explaining its evolutionarily
   conserved organization. We also identify a three-dimensional
   architecture, probably formed through interactions with CCCTC-binding
   factor, which is present within both Irx clusters of mouse, Xenopus and
   zebrafish. This architecture brings the promoters of the first two genes
   together in the same chromatin landscape. We propose that this unique
   and evolutionarily conserved genomic architecture of the vertebrate Irx
   clusters is essential for the coregulation of the first two genes and
   simultaneously maintains the third gene in a partially independent
   regulatory landscape.},
