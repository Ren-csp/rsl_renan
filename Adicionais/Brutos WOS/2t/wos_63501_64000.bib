@article{ WOS:000434954900075,
Author = {Wang, Lili and Wang, Zhonggen and Yu, Jingjie and Zhang, Yichi and Dang,
   Suzhen},
Title = {Hydrological Process Simulation of Inland River Watershed: A Case Study
   of the Heihe River Basin with Multiple Hydrological Models},
