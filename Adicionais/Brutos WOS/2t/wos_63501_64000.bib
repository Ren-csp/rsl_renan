   Sharpe, Scott, UNSW Canberra, Sch Phys Environm \& Math Sci, Campbell, Australia.
   Hynes, Maria, Australian Natl Univ, Sch Sociol, Acton, Australia.},
DOI = {10.1080/01419870.2016.1096405},
ISSN = {0141-9870},
EISSN = {1466-4356},
Keywords = {Humour; anti-racism; everyday racism; bystander action; de-commitment;
   speaking out},
Keywords-Plus = {RACIST JOKES; CONTEMPORARY; RESISTANCE; POLITICS; CITIES; COMEDY; RACE},
Research-Areas = {Ethnic Studies; Sociology},
