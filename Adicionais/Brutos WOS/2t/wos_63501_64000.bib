@article{ WOS:001401312900018,
Author = {Stable-Rodriguez, Yudayly and Diaz-Chieng, Lee Yang and Gamboa, Alfredo
   Javier Perez and Rodriguez-Torres, Esteban},
Title = {Bibliometric evaluation of research on Enabling Technologies for Digital
   Transformation in Cuba},
Journal = {TELOS-REVISTA DE ESTUDIOS INTERDISCIPLINARIOS EN CIENCIAS SOCIALES},
Year = {2025},
Volume = {27},
