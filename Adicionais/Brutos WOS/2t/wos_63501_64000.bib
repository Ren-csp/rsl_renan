@article{ WOS:001412683700016,
Author = {Naufal, Muhammad and Hidayat, Ika Wiani and Hermawati, Elvira and Syah,
   Yana maolana and Al-anshori, Jamaludin},
Title = {Perencatan Berasaskan Terbitan Benzalhidantoin bagi Lapan Reseptor
   Tirosina Kinase: Kajian Sintesis, in-vitro dan in-silico},
Journal = {SAINS MALAYSIANA},
