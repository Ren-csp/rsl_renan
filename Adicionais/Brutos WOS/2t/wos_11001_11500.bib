@article{ WOS:000378579600007,
Author = {Reizer, Magdalena and Juda-Rezler, Katarzyna},
Title = {Explaining the high PM10 concentrations observed in Polish
   urban areas},
Journal = {AIR QUALITY ATMOSPHERE AND HEALTH},
