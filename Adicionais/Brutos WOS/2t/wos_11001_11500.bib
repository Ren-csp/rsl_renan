@article{ WOS:001540959800002,
Author = {Yang, Senqi and Dane, Gamze and Arentze, Theo A.},
Title = {An agent-based model to simulate pedestrians' affective experiences and
   activities for evaluating urban public space design},
Journal = {CITIES},
Year = {2025},
Volume = {166},
Month = {NOV},
Abstract = {As urban development increasingly emphasizes creating healthy and
   inclusive environments to foster positive human-environment interactions
   and wellbeing, pedestrians' affective experiences and activity choices
   are gaining attention as important indicators for design evaluation.
   While many computational models of pedestrians focus on travel behavior
   and spatial efficiency, they often overlook the experiential quality of
   environments, which is critical for urban public spaces. This study
   proposes an agent-based model (ABM) to simulate pedestrians' affective
   experiences, perceptions, and activities in public spaces, offering
   insights for experiencecentered design decisions. Grounded on a
   theoretical framework of human-environment interaction, the model is
   calibrated using estimates from previous experiments. The ABM integrates
   affective computing, including emotion generation and its effects, while
   accounting for individual heterogeneity in initial conditions and
   activity choices. Applied in two cases, the ABM demonstrates its ability
   to simulate diverse pedestrian responses to design interventions. The
   results reveal design features that enhance affective experiences,
   promote diverse activities and optimize space use, highlighting
   differences between cognitively and emotionally driven individuals.
   Initially developed for train station areas, this ABM can be expanded to
   broader urban contexts, serving as a tool for evaluating the
   experiential quality of public spaces, contributing to urban digital
   twins for citizens.},
