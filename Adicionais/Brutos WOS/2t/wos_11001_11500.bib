@article{ WOS:001349008400001,
Author = {Hanssen, Lucien and Leemans, Luuk H. and Engel, M. Sabine and van der
   Geest, Matthijs and Lamers, Leon P. M. and Smolders, Alfons J. P. and
   Tussenbroek, Brigitta I. van and Rouwette, Etienne and Christianen,
   Marjolijn J. A. and Katwijk, Marieke M. van},
Title = {Early stakeholder involvement using Group Model Building to identify
   ecological research questions and nature management options},
Journal = {MARINE POLLUTION BULLETIN},
Year = {2024},
Volume = {209},
Number = {A},
Month = {DEC},
Abstract = {Many tropical coastal ecosystems face human pressures related to
   tourism, land or sea use. We developed a practical procedure to involve
   stakeholders in an early stage of an ecological research project to map
   the SocialEcological System (SES) in our case study Lac Bay, Bonaire
   island, as well as to identify and prioritize ecological research
   questions and nature management options in relation to a recent new
   threat: massive sargassum landings. In our procedure we used the Group
   Model Building methodology for identifying drivers, key variables and
   feedback loops in this SES. The underlying mechanisms of driving
   feedbacks were revealed and shared during these sessions. We identified
   and prioritized urgent ecological research questions for the
   conservation of seagrass beds and mangrove forests, and practical
   measures for nature management in Lac Bay. Both were used in follow-up
   scientific research and nature management plans, illustrating the
   applicability of our procedure for early science-stakeholder
   interaction.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Katwijk, MMV (Corresponding Author), Radboud Univ Nijmegen, Radboud Inst Biol \& Environm Sci, Dept Environm Sci, Heyendaalseweg 135, NL-6525 AJ Nijmegen, Netherlands.
