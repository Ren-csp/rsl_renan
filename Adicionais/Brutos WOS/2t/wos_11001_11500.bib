@article{ WOS:001796778600001,
Author = {Pukowiec-Kurda, Katarzyna},
Title = {New methodology of a two-scale IUES-ternary framework for assessing
   urban greenspace abundance and ecosystem-service potential},
Journal = {ECOLOGICAL INDICATORS},
Year = {2026},
Volume = {188},
Month = {JUL},
Abstract = {Urban green spaces serve as places for recreation and relaxation and
   provide ecosystem services to urban residents. They are particularly
   needed in metropolitan areas with high population density.
   Proportionately to their population size, these areas should have
   extensive green spaces to meet society's demand for ecosystem services.
   Research in this area is scientifically important to determine the
   quantity and quality of ecosystem services. The proposed IUES (Index of
   Urban Ecosystem Services) index is based on the area of green spaces and
   the strength of ecosystem services. It assesses the potential of green
   spaces to provide ecosystem services. Using a model based on Ossan
   Triangle, it enables the classification of cities according to this
   potential. The proposed model represents a new approach to assessing
   ecosystem services in cities and allows for the development of IUES
   maps, city typologies, and micro-scale location scores. The aim of this
   article is to evaluate a new methodology for assessing the potential
   supply proxy to provide ecosystem services. The methodology is based on
   the IUES index and Ossana's Triangle at two spatial scales-macro and
   micro-with the goal of testing its versatility.},
