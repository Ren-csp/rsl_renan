@article{ WOS:000863241600002,
Author = {Pessoa, Jose Felipe Salomao and da Fonseca, Cassiano Ribeiro and
   Santana, Lucas Deziderio and Pifano, Daniel Salgado and Carvalho,
   Fabricio Alvim},
Title = {Tree community of the urban forest remnant of the Lajinha Municipal
   Natural Park (Juiz de Fora, MG, Brazil)},
Journal = {CIENCIA FLORESTAL},
