@article{ WOS:001780821700002,
Author = {Kalozi, Olivera and Pavlovic, Lazar and Kesic, Lazar and Vuksanovic,
   Vanja and Zoric, Martina and Orlovic, Sasa},
Title = {Allergenicity of tree avenues in an urban district of Novi Sad, Serbia},
