@article{ WOS:000336790800015,
Author = {Haberle, Simon G. and Bowman, David M. J. S. and Newnham, Rewi M. and
   Johnston, Fay H. and Beggs, Paul J. and Buters, Jeroen and Campbell,
   Bradley and Erbas, Bircan and Godwin, Ian and Green, Brett J. and Huete,
   Alfredo and Jaggard, Alison K. and Medek, Danielle and Murray, Frank and
   Newbigin, Ed and Thibaudon, Michel and Vicendese, Don and Williamson,
   Grant J. and Davies, Janet M.},
Title = {The Macroecology of Airborne Pollen in Australian and New Zealand Urban
   Areas},
Journal = {PLOS ONE},
Year = {2014},
Volume = {9},
Number = {5},
Month = {MAY 29},
Abstract = {The composition and relative abundance of airborne pollen in urban areas
   of Australia and New Zealand are strongly influenced by geographical
   location, climate and land use. There is mounting evidence that the
   diversity and quality of airborne pollen is substantially modified by
   climate change and land-use yet there are insufficient data to project
   the future nature of these changes. Our study highlights the need for
   long-term aerobiological monitoring in Australian and New Zealand urban
   areas in a systematic, standardised, and sustained way, and provides a
   framework for targeting the most clinically significant taxa in terms of
   abundance, allergenic effects and public health burden.},
