Title = {ENVIRONMENTAL PERCEPTION OF FLAG USERS IN RELATION TO THE PRODUCT LIFE
   CYCLE},
Journal = {REVISTA DE GESTAO AMBIENTAL E SUSTENTABILIDADE-GEAS},
Year = {2018},
Volume = {7},
Number = {1},
Pages = {23-42},
Month = {JAN-APR},
Abstract = {This study addresses the sustainability and importance of its adoption
   by the company, object of this study, to be competitive in the market.
   The objective was to identify and analyze the perception of flag users
   regarding to the life cycle of the product, in a reference industry
   located in the city of Cascavel, western region of the State of Parana.
   The methodology used was an exploratory, bibliographic research and
   application of the VAPERCOM model to 40 active clients of the company in
   June 2016. The results indicated that, on average, consumers have an
   environmental perception and can become ecological consumers, as well as
   showing concern about the stages of the product life cycle from the
   production process to disposal.},
