@article{ WOS:001271445000016,
Author = {Jung, Youngsook Lucy and Zhao, Wenping and Li, Ian and Jain, Dhawal and
   Epstein, Charles B. and Bernstein, Bradley E. and Parangi, Sareh and
   Sherwood, Richard and Robinson-Cohen, Cassianne and Hsu, Yi-Hsiang and
   Park, Peter J. and Mannstadt, Michael},
Title = {Epigenetic profiling reveals key genes and cis-regulatory networks
   specific to human parathyroids},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAR 7},
Abstract = {In all terrestrial vertebrates, the parathyroid glands are critical
   regulators of calcium homeostasis and the sole source of parathyroid
   hormone (PTH). Hyperparathyroidism and hypoparathyroidism are clinically
   important disorders affecting multiple organs. However, our knowledge
   regarding regulatory mechanisms governing the parathyroids has remained
   limited. Here, we present the comprehensive maps of the chromatin
   landscape of the human parathyroid glands, identifying active regulatory
   elements and chromatin interactions. These data allow us to define
   regulatory circuits and previously unidentified genes that play crucial
   roles in parathyroid biology. We experimentally validate candidate
   parathyroid-specific enhancers and demonstrate their integration with
   GWAS SNPs for parathyroid-related diseases and traits. For instance, we
   observe reduced activity of a parathyroid-specific enhancer of the
   Calcium Sensing Receptor gene, which contains a risk allele associated
   with higher PTH levels compared to the wildtype allele. Our datasets
   provide a valuable resource for unraveling the mechanisms governing
   parathyroid gland regulation in health and disease.},
