@article{ WOS:000725694900003,
Author = {Solle, Natasha Schaefer and Santiago, Katerina M. and Feliciano, Paola
   Louzado and Calkins, Miriam M. and Fent, Kenny and Jahnke, Sara and
   Parks, Natasha and Buren, Heather and Grant, Casey and Burgess, Jefferey
   L. and Caban-Martinez, Alberto J.},
Title = {Perceptions of Work-Related Health and Cancer Risks Among Women
   Firefighters A Qualitative Study},
Journal = {JOURNAL OF OCCUPATIONAL AND ENVIRONMENTAL MEDICINE},
Year = {2021},
Volume = {63},
Number = {12},
Pages = {E846-E852},
Month = {DEC},
Abstract = {Objectives: We use a qualitative method to gain further insight into
   women firefighters' experiences, perceptions of cancer, health, and
   safety risks in the fire service. Methods: We conducted six focus groups
   with U.S. women firefighters. Participants engaged in a 60 to 75-minute,
   semi-structured discussion and completed a sociodemographic
   questionnaire. A qualitative descriptive approach was used to
   inductively create themes. Data collection concluded when saturation was
   met. Results: Forty-nine women firefighters participated. Qualitative
   results indicated the main health concerns include: occupational cancer
   risks including, risks related to hazardous exposures, sleep disruption
   and stress; and women's health concerns including, cancer, pregnancy and
   breastfeeding, and lack of resources. Conclusions: Women firefighters
   are concerned about their risk for cancer due to their occupation and
   identify a lack of resources specific to health and safety needs of
   women firefighters.},
