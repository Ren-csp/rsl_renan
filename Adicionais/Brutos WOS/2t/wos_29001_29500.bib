@article{ WOS:001750175900001,
Author = {Anthonj, Carmen and Ihnacik, Lukas and Foellmer, Julia and Janeka, Paula
   and Papajova, Ingrid},
Title = {A community-based participatory mixed-method approach on lived water,
   waste and health insecurity experiences in marginalised Roma communities
   in Eastern Slovakia},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {10},
Month = {JUN},
Abstract = {With our study in Eastern Slovakia, we aimed to capture lived water,
   environment and health experiences, implement participatory visual
   methods in the context of environmental health, apply validated
   international water insecurity and sanitation related quality of life
   scales and syndromic surveillance, and uniquely combine participatory
   visual methods with quantitative (HWISE, SanQoL-5) and qualitative data
   and syndromic surveillance in marginalised Roma communities, amplifying
   community challenges and priorities. Data were collected between October
   2024 to May 2025 in three different villages and their included or
   adjacent Roma settlements from and with people of Roma nationality, and
   the majority population through photovoice and group discussions,
   in-depth interviews and survey questionnaires. Water, waste and
   environmental hygiene insecurities were the health challenges that Roma
   people addressed most. Water-related perceptions and experiences, and
   perceptions related to (in)equality differed in Roma and non-Roma
   respondents, across setllements, and by gender. Roma residents perceived
   health risks more strongly overall, and reportedly experienced more
   self-reported symptoms than non-Roma residents. Photovoice and related
   discussions revealed that Roma residents had major concerns with solid
   waste and the absence of related management, living conditions overall,
   stray dogs and contaminated surface waters, and resulting health risks.
   Our direct participatory work with the target population provides a
   direct, unprecedented and intimate perspective on life within the
   communities, offering a nuanced, realistic understanding and amplifying
   everyday challenges faced. Our methodological approach offers
   opportunities and entry points for application in similarly challenged
   and complex contexts in marginalised communities at the margins of
   societies, beyond Roma communities, and beyond Slovakia.},
