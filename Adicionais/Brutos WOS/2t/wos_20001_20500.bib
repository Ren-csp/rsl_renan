@article{ WOS:000369337900001,
Author = {Haynes, Erin N. and Elam, Sarah and Burns, Roxanne and Spencer, Alonzo
   and Yancey, Elissa and Kuhnell, Pierce and Alden, Jody and Walton, Mike
   and Reynolds, Virgil and Newman, Nicholas and Wright, Robert O. and
   Parsons, Patrick J. and Praamsma, Meredith L. and Palmer, Christopher D.
   and Dietrich, Kim N.},
Title = {Community Engagement and Data Disclosure in Environmental Health
   Research},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {2016},
Volume = {124},
