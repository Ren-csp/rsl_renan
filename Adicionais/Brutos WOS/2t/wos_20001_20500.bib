@article{ WOS:000647006300001,
Author = {Wu, Jianfei and Zhang, Weinan and Peng, Chuanhu and Li, Juan and Zhang,
   Saiyu and Cai, Wenjing and Chen, Dan},
Title = {The Trickle-Down Effect of Leaders' VWGB on Employees' Pro-Environmental
   Behaviors: A Moderated Mediation Model},
Journal = {FRONTIERS IN PSYCHOLOGY},
Year = {2021},
Volume = {12},
Month = {APR 21},
Abstract = {Although previous research has highlighted the positive effect of
   leaders' voluntary workplace green behavior (VWGB), limited research
   attention has been given to empirically testing how and when such
   behavior produces trickle-down effects. Taking a role model perspective
   and drawing on social identity theory, this research aims to fill this
   gap by proposing and testing the mechanism and boundary conditions of
   the influencing processes whereby leaders' VWGB can trickle down to
   employees' pro-environmental behaviors. By theorizing a moderated
   mediation model, the current research empirically examines the
   hypotheses by conducting a hierarchical regression analysis. We employed
   a survey questionnaire research design to collect two waves of
   multisource data. The data used in the analysis are from survey
   responses of 313 subordinate-supervisor dyads at two different time
   points. The results show that leaders' VWGB can have a trickle-down
   influence on employees' task-related pro-environmental behavior and
   proactive pro-environmental behaviors through their green self-identity
   and that this trickle-down effect is greater among employees with higher
   green climate perceptions. Our results reveal the intervening mechanism
   and boundary condition of leaders' VWGB by conducting a systematic
   examination of how this effect trickles down.},
