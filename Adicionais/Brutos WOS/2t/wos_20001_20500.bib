@article{ WOS:000671245700001,
Author = {Zhang, Lan and Huang, Guowen and Li, Yongtao and Bao, Shitai},
Title = {A Psychological Perception Mechanism and Factor Analysis in Landsenses
   Ecology: A Case Study of Low-Carbon Harmonious Discourse},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {13},
Month = {JUL},
Abstract = {Landsenses ecology has been widely applied in research into sustainable
   consciousness and behavior and the notion of landsense creation realizes
   the unity of the macro physical senses and micro psychological
   perceptions. However, a great deal of current research about landsenses
   ecology has concentrated on the dimension of the physical senses, while
   there have been relatively few studies on the dimension of its
   psychological perception. This paper begins by clarifying the concept of
   self and explaining out that the psychological perception mechanism of
   landsense creation represents a process of guiding people to know
   themselves and realize their ecological self. It then utilizes the
   example of low-carbon discourse to explore the factors contributing to
   the resonance of ecological self-vision. Our results show that the
   perceived self-efficacy, environmental concern and environmental
   knowledge triggered by ecological discourse are the main factors
