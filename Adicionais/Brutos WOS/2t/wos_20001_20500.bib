@article{ WOS:000440951400003,
Author = {Hawkins, Melissa and James, Chris},
Title = {Developing a perspective on schools as complex, evolving, loosely
   linking systems},
Journal = {EDUCATIONAL MANAGEMENT ADMINISTRATION \& LEADERSHIP},
Year = {2018},
Volume = {46},
Number = {5},
Pages = {729-748},
Month = {SEP},
Abstract = {The rationale for this article is to give complexity the central place
   it warrants in school leadership, management and organisational practice
   and research. We analyse the relevant literature, particularly that
   relating to complex human systems and their loose coupling nature. The
   analysis reveals the dimensions of complex human systems and
   consequences that emanate from those dimensions, which include system
   evolution. We use the dimensions, together with notions of interactional
   capability, opportunities for interaction, the legitimacy of
   interactions and the extent to which the institutional primary task
   conditions interactions, to create an organisational/institutional
   perspective on schools as complex, evolving, loosely linking systems
   (CELLS). Five main systems of a school as a whole-school system are
   identified: the teaching staff system; the ancillary staff system; the
   student system; the parent system; and significant other systems in the
   wider system. In the article, we illustrate the nature of the teaching
   staff system from a CELLS perspective. We discuss issues arising from
   our analyses: interaction, influence and leadership; ontological issues;
   the nature of the school'; the significance of the parent system; the
   special nature of interactions between the members of the teaching staff
   system and the student system; and institutional performance.},
