@article{ WOS:001619249700001,
Author = {Jay, Marion and Cortes-capano, Gonzalo and Martin, Romina and Suntken,
   Julian and Plieninger, Tobias},
Title = {Exploring narratives of human-nature connections in protected areas},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {1},
Pages = {37-50},
Month = {JAN},
Abstract = {Protected areas have become the most widespread strategy for nature
   conservation, and are currently expanding worldwide. Many of them are
   inhabited or close to inhabited areas, shaping and being shaped by
   connections between people and nature. These connections are not always
   positive. Social fragmentation, in the form of conflicts and
   disconnections from nature, represents a major challenge for
   biodiversity conservation in protected areas. Assessing the multiple
   forms of people's connections with nature has shown pivotal to the
   development of conservation strategies that integrate ecological and
   social benefits. However, understanding how people articulate the role
   of protected areas in shaping their connections with nature remains
   overlooked in the literature. We use a narrative approach to investigate
   connections of people to protected areas based on seven dimensions:
   material, experiential, cognitive, emotional, philosophical, cultural
   and institutional. Using five protected areas in a multifunctional
   landscape in Central Germany as case studies, we explored narratives of
   connection based on in-depth analysis of 38 semi-structured interviews.
   Our main findings highlight that: (i) Narratives allow us to describe
   complex human-nature connections in protected areas; (ii) the novel
   framework of seven human-nature connections uncovered learning, regional
   heritage, care, multifunctional production and collaborations as key
   themes to better understand people's connection to nature in protected
   areas; (iii) different ways of connecting to nature, such as emotional,
   experiential and material connections, are closely linked; and (iv) the
   five narratives present overlaps that point at implications for
   protected area policy and practice. We discuss how protected areas can
   contribute to a reconnection to nature by reinforcing links between all
   dimensions of connections; considering the complexity associated with
   material connections; recognizing the importance of non-material values
   of protected areas; improving the articulation of multiple knowledge;
   and supporting collaboration and trustful relationships. We argue that,
   to further contribute to cultural landscapes' sustainability, protected
   areas should focus on creating the conditions to foster diverse
   human-nature connections. Narratives can thereby help to identify new
   alliances and put nature protection and protected areas at the core of
   society and landscapes, rather than isolating them in conservation
   niches or silos.Read the free for this article on the Journal blog.
   Schutzgebiete sind eine der wichtigsten Strategien f \& uuml;r den
   Naturschutz geworden und breiten sich derzeit weltweit aus. Viele von
   ihnen sind bewohnt oder liegen in der N \& auml;he von bewohnten
   Gebieten. Dadurch pr \& auml;gen sie die Mensch-Natur-Beziehungen ma ss
   geblich, und werden wiederum von diesen beeinflusst. Diese Beziehungen
   sind nicht immer harmonisch, und soziale Fragmentierungen-zum Beispiel
   in Form von Konflikten und Entfremdung von der Natur-stellen eine gro ss
   e Herausforderung f \& uuml;r Schutzgebiete dar. Die Ber \&
   uuml;cksichtigung der vielf \& auml;ltigen Verbindungen der Menschen zur
   Natur ist entscheidend f \& uuml;r die Entwicklung von Schutzstrategien,
   die \& ouml;kologische und soziale Vorteile integrieren. In der
   Fachliteratur wird die Frage, wie Menschen in und um Naturschutzgebiete
   ihre Beziehung zur Natur artikulieren, jedoch noch weitgehend \&
   uuml;bersehen. Mithilfe eines narrativen Forschungsansatzes untersuchen
   wir sieben Dimensionen von Mensch-Natur-Verbindungen in Schutzgebieten:
   materielle, erfahrungsbezogene, kognitive, emotionale, philosophische,
   kulturelle und institutionelle Verbindungen. Anhand von f \& uuml;nf
   Fallstudien in einer multifunktionalen Landschaft in Deutschland haben
   wir Narrative auf der Grundlage einer qualitativen Analyse von 38
   semi-strukturierten Interviews untersucht. Unsere wichtigsten Ergebnisse
   zeigen, dass: (i) Narrative es erm \& ouml;glichen, komplexe
   Verbindungen zwischen Mensch und Natur in Schutzgebieten zu beschreiben;
   (ii) f \& uuml;nf Themen in Schutzgebieten zentral erscheinen: Lernen,
   regionales Erbe, F \& uuml;rsorge, multifunktionale Produktion und
   Zusammenarbeit; (iii) verschiedene Dimensionen der Verbindung zur Natur,
   wie emotional, erfahrungsbezogen und materiell, eng miteinander verkn \&
   uuml;pft sind; (iv) und dass die f \& uuml;nf Narrative \&
   Uuml;berschneidungen aufweisen, die auf Implikationen f \& uuml;r
   Naturschutzpolitik und -praxis hinweisen. Wir diskutieren, wie
   Schutzgebiete zu einer Wiederverbindung mit der Natur beitragen k \&
   ouml;nnen, indem sie multidimensionale Mensch-Natur-Verbindungen st \&
   auml;rken, die Komplexit \& auml;t materieller Beziehungen ber \&
   uuml;cksichtigen, die Bedeutung immaterieller Werte von Schutzgebieten
   anerkennen, die Artikulation unterschiedlicher Wissensarten, einschlie
   ss lich lokalen Wissens, verbessern sowie sektor \& uuml;bergreifende
   Zusammenarbeit und vertrauensvolle Beziehungen f \& ouml;rdern. Wir
   argumentieren, dass Schutzgebiete Rahmenbedingungen schaffen sollten,
   die vielf \& auml;ltige Verbindungen zwischen Mensch und Natur f \&
   ouml;rdern, um weiterhin zur Nachhaltigkeit von Kulturlandschaften
   beizutragen. Narrative k \& ouml;nnen dabei helfen, neue Allianzen zu
   identifizieren und den Naturschutz sowie Schutzgebiete st \& auml;rker
   in den Mittelpunkt von Gesellschaft und Landschaften zu r \& uuml;cken,
   anstatt sie in Naturschutznischen zu isolieren.},
