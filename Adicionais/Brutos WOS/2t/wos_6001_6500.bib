@article{ WOS:001786534400001,
Author = {Hammermeister, Sina and Dietze, Victoria and Spyra, Marcin},
Title = {Climate change strategies in selected large European cities: Specific
   activities and the role of urban open spaces☆},
Journal = {PROGRESS IN DISASTER SCIENCE},
Year = {2026},
Volume = {30},
Month = {APR},
Abstract = {Cities face escalating risks from climate change, including heat stress
   and flooding, yet remain pivotal actors in climate mitigation and
   adaptation due to their concentration of population, infrastructure, and
   governance capacity. This study analyses climate strategies in 29
   selected European cities with three objectives: (1) to compare how
   mitigation and adaptation are framed, (2) to analyse the concrete
   measures proposed, and (3) to examine the role attributed to urban open
   spaces within these measures. Using qualitative content analysis, we
   examine 33 strategies comprising nearly 2,500 individual measures. While
   all cities demonstrate active engagement with climate action,
   substantial variation exists in the scope and comprehensiveness of their
   strategies. Mitigation measures dominate overall, although adaptation
   and integrated measures addressing climate risks are increasingly
   prominent. Governance arrangements commonly involve collaboration
   between public authorities, citizens, and private stakeholders through
   regulatory, informational, and participatory instruments. Urban open
   spaces remain underrepresented overall, but are particularly significant
   within adaptation and integrated measures, where green and green-grey
   spaces support heat mitigation, water management, and risk reduction.
   The findings highlight the need for cross-city learning, stronger
   integration of urban open spaces into climate and disaster risk
   strategies, and more systematic evaluation of implementation outcomes.},
