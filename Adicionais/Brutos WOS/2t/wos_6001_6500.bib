@article{ WOS:001514363100001,
Author = {Lara-Hernandez, Jose Antonio},
Title = {From segregation to inclusion: children's engagement in urban public
   spaces},
Journal = {CITIES \& HEALTH},
Year = {2025},
Volume = {9},
Number = {6, SI},
Pages = {1035-1051},
Month = {NOV 2},
Abstract = {This paper explores how urban segregation impacts children's ability to
   engage with and temporarily appropriate public spaces, a critical aspect
   of their spatial, social, and cultural development. Using a
   post-qualitative inquiry, we integrate Temporary Appropriation and the
   Speculative Pluriversal Imaginary Research Assemblage Loop (SPIRAL) to
   examine children's interactions in Auckland and Venice. While pristine
   playgrounds in cities like Auckland ensure safety, they isolate children
   (3-12 years old) from dynamic urban environments. In contrast, Venice's
   integrated spaces foster spontaneous play. We propose design
   interventions that balance safety and exploration, contributing to
   regenerative urbanism and equitable public spaces. The study concludes
   with open-ended questions to inspire future research.},
