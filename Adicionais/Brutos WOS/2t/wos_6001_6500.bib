@article{ WOS:000366333900026,
Author = {Axinte, Elena and Vasies, Georgeta and Teleman, Elena-Carmen and Rosca,
   Victoria-Elena and Axinte, Andrei-Octav},
Title = {INCLUDING SOLAR PANELS ON PARKING AREAS IN THE SUSTAINABLE DEVELOPMENT
   CONCEPT. WIND EFFECTS},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
