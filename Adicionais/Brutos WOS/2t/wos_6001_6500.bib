@article{ WOS:001743794600002,
Author = {Palombelli, Marco},
Title = {Hegel on Human Ways of Considering Nature},
Journal = {ETHICS IN PROGRESS},
Year = {2024},
Volume = {15},
Number = {2},
Pages = {14-35},
Abstract = {In this article, I aim to show the limits of certain ``ways of
   considering{''} nature, as well as the intrinsic contradictions in their
   modus operandi, following Hegel's analysis in the Introductions to the
   Encyclopaedic Naturphilosophie and the Berlin Lectures on the Philosophy
   of Nature. After framing the problem within the broader theme - already
   explored in Jena - of the relationship between nature and spirit, I will
   show that both the practical and the theoretical, insofar as they are
   founded in an original separation between human being and nature, result
   in a subjection of the latter to the former. In order for this to be
   redeemed from one-sided conduct towards it, it is necessary to access
   through living intuition a philosophical consideration, which Hegel
   understands as the discovery of the inner rationality of nature and its
   very ``liberation{''}.},
