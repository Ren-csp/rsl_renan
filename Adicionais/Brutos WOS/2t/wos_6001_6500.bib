@article{ WOS:000175066600024,
Author = {Williams, BL and Florez, Y},
Title = {Do Mexican Americans perceive environmental issues differently than
   Caucasians: A study of cross-ethnic variation in perceptions related to
   water in Tucson},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {2002},
Volume = {110},
Number = {2},
Pages = {303-310},
Month = {APR},
Abstract = {Little is known about the environmental perceptions of our nation's
   Mexican and Mexican American population, especially in the area of water
   quality. We examined these perceptions to determine the extent to which
   Caucasians and Mexican Americans living in the Tucson, Arizona,
   metropolitan area differ in their perceptions of water quality-related
   risk, inequity, trust, and participation in civic activities. Ethnic
   variations in perceptions toward inequity, trust, and public
   participation were observed even when socioeconomic variation between
   Caucasians and Mexican Americans was controlled. However, significant
   ethnic variations in perceptions of water quality-related risks were
   observed only when socioeconomic variation was not controlled.
   Implications of these findings to environmental justice efforts in
   Mexican American communities are discussed.},
Publisher = {US DEPT HEALTH HUMAN SCIENCES PUBLIC HEALTH SCIENCE},
