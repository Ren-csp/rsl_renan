@article{ WOS:001622643500013,
Author = {Yang, Yiqun and Zhang, Jiaqi and Gao, Dong and Guo, Qin and Hao, Siwen},
Title = {Identifying urban green space health priorities using asymmetric impact
   performance analysis in Kangbashi district Ordos China},
Journal = {SCIENTIFIC REPORTS},
Year = {2025},
Volume = {15},
Number = {1},
Month = {NOV 24},
Abstract = {Urban green spaces (UGS) are essential to improving public health,
   promoting well-being, and fostering sustainable urban living. While
   numerous studies have explored the health benefits of green spaces, few
   have addressed how to scientifically determine construction priorities
   for urban green healthy spaces (UGHS). This study investigates
   residents' satisfaction with UGHS in Kangbashi District, Ordos City--a
   representative urban area in northern China characterized by
   high-standard green infrastructure and rapid development as a planned
   ``new town{''} model--to identify key environmental attributes and
   establish improvement priorities. Using a structured questionnaire
   survey, we collected data on attributes related to residents' health,
   well-being, and social interaction. A combination of the Delphi method
   and Asymmetric Impact-Performance Analysis (AIPA) was applied to
   evaluate both the performance and impact asymmetry of each UGHS
   attribute. The results revealed that residents' satisfaction with UGHS
   is asymmetric, and different attributes have varying effects on
   satisfaction and dissatisfaction. Among the evaluated attributes,
   biodiversity, accessibility, number and area of activity places and
   facilities, and privacy were identified as low-performing but
   high-impact factors. These attributes should be prioritized in future
   UGHS development. This study demonstrates the utility of the AIPA method
   in green space evaluation and provides practical insights for guiding
   health-oriented and sustainable urban green space planning, particularly
   in emerging cities across northern China.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
