@article{ WOS:001785996700001,
Author = {Li, Zixuan and Gu, Sihao and Xu, Ziqi and Wang, Ziyi and Behnisch,
   Martin},
Title = {Toward a systematic understanding and assessment of urban green space: A
   Social-Ecological-Technological Systems (SETS) framework},
Journal = {CLIMATE RISK MANAGEMENT},
Year = {2026},
Volume = {53},
Month = {SEP},
Abstract = {Urban green spaces (UGS) are increasingly expected to support climate
   adaptation, biodiversity, and human well-being as urban infrastructure
   and nature-based solutions. Yet their benefits remain uneven and
   uncertain across space and time, often within the same city. This
   unevenness reflects coupled dynamics among ecological processes, social
   priorities and institutions, and technological-infrastructural
   mediation. Existing UGS and SETS scholarship provides strong evidence
   and conceptual foundations, but systematic assessment remains difficult
   when spatial units, coupling pathways, and analytical questions are not
   clearly separated. We develop a UGS-SETS framework for systematic
   understanding and comparative, governance-relevant assessment of coupled
   UGS performance. Building on a review of UGS and SETS scholarship, the
   framework defines four assessment objects: UGS-SETS units, unit
   conditions, coupling structure, and system-level descriptors. These
   objects are assembled in a multilayer representation that links social,
   ecological, and technological unit conditions with directed coupling
   edges and decision-scale interpretation. Mechanism and process logic
   explain how represented pathways can generate structural emergence and
   evaluated outcomes, while a three-phase workflow guides scoping,
   assessment specification, and question-led analysis. A focused synthetic
   district demonstration illustrates how the framework supports
   diagnostic, explanatory, and intervention-oriented read-outs for UGS
   planning and governance.},
