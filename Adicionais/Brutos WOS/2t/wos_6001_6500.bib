@article{ WOS:001511913500001,
Author = {Kou, Ruibing and Hunter, Ruth F. and Cleland, Claire and Ferguson, Sara
   and Schipperijn, Jasper and Peng, Qiao and Ellis, Geraint},
Title = {Built environment influences on park visits for older adults: insights
   from a machine learning approach},
Journal = {CITIES},
Year = {2025},
Volume = {165},
Month = {OCT},
Abstract = {Evidence has shown the importance of built environment features in
   shaping park use and physical activity behaviour. However, it is unclear
   what impacts built environment features within and around parks have on
   older adults' park visits. To address this gap, this study employs an
   interpretable machine learning model to investigate a variety of built
   environment features within and around parks and their association with
   devicemeasured park visits of older adults. We found that macroscale
   built environment features around parks (i.e. intersection density) had
   an important role in shaping older adults' park visits and were
   generally more important than microscale built environment features
   within (i.e. amenities) and around parks (i.e. park access).
   Additionally, the macroscale built environment features of
   neighbourhoods were more predictive of older adults' park visits than
   those of park buffers. Among the microscale built environment features
   studied, park sports facilities appear to be the most influential,
   followed by aesthetic features. Research findings suggest that key built
   environment features influence older adults' park visits in combination,
   highlighting the importance of a more holistic perspective when
   considering built environment influences on behaviour, including
   understanding the wider neighbourhood context of parks, and integrating
   such perspectives in future research and policymaking.},
