@article{ WOS:001476547100001,
Author = {Veckalne, Regina and Saidkhodjaev, Asomkhodja and Tambovceva, Tatjana},
Title = {Public Perceptions of Urban Green Spaces: Effects on Physical and Mental
   Health},
Journal = {URBAN SCIENCE},
Year = {2025},
Volume = {9},
Number = {4},
Month = {APR 17},
Abstract = {Urban green spaces are essential for promoting public health by
   encouraging physical activity, reducing stress, and enhancing overall
   well-being. However, the perception and utilization of these spaces vary
   based on socio-demographic factors and urban planning characteristics.
   This study investigates public perception of urban green spaces and
   their perceived health benefits, emphasizing their psychological,
   physical, and social impacts. The study involved 240 respondents who
   assessed the availability and quality of green spaces as well as the
   social and psychological aspects of their use. The survey was analyzed
   using Partial Least Squares Structural Equation Modeling (PLS-SEM). The
   results showed that environmental awareness (beta = 0.404, p < 0.001)
   and social interaction (beta = 0.391, p < 0.001) are significant
   predictors of the frequency of visiting green spaces, while their
   availability and quality do not have a significant impact. These
   findings highlight the critical role of environmental education and
   community awareness initiatives in maximizing the health benefits
   derived from urban green spaces. Frequency of use is positively
   associated with both mental (beta = 0.272, p = 0.002) and physical
   health (beta = 0.409, p < 0.001). Surprisingly, social interaction
   demonstrates a negative impact on mental health (beta = -0.166, p =
   0.002), which requires further study. The obtained results highlight the
   need for an integrated approach to studying the relationship between the
   urban environment and population health.},
