@article{ WOS:001745658200001,
Author = {Budka, Anna and Lisiak-Zielinska, Marta and Borowiak, Klaudia and
   Swierk, Dariusz and Antoszewski, Patryk and Tian, Guohang and Dong,
   Nalin},
Title = {Beautiful and rich-Visual attractiveness vs. Ecological approach of
   urban green areas},
Journal = {LANDSCAPE AND URBAN PLANNING},
Year = {2026},
Volume = {272},
Month = {AUG},
Abstract = {Contemporary management of urban green areas requires a comprehensive
   approach in many aspects. One of the key challenges is to design an
   aesthetic and attractive urban space while preserving maximum
   biodiversity. Hence, the objectives of this study were to (1) examine
   the relationships between visual attractiveness and species diversity,
   as well as (2) determine how plants' biodiversity can be improved to be
   more attractive to the public. A landscape and species inventory were
   conducted for an urban park in Poznan, Poland. Based on this, the
   landscape was valorized, and biodiversity indices were calculated.
   Statistical methods were also applied to analyze relations, including
   PERMANOVA, the Kruskal-Wallis test, and PCA. The study confirmed that
   vegetation composition and vertical structure significantly influence
   biodiversity. Various levels of structure such as trees, shrubs, and low
   vegetation were important for both aspects studied. Landscape
   transformation affected both biodiversity levels and visual appeal, with
   pronounced effects in areas of low and high transformation. However, the
   high degree of management intensity in some areas promoted biodiversity
   and visual attractiveness. In the most visually attractive areas,
   numerous species with distinctive flower colors and leaf shapes forms
   were identified, potentially enhancing the subjective perception of the
   landscape. These findings are especially valuable for guiding the
   planning and design of urban green spaces, as they demonstrate how
   social expectations-such as aesthetic quality and recreational use, can
   be effectively integrated with environmental goals, particularly the
   conservation and enhancement of biodiversity.},
