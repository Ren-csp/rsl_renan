@article{ WOS:001759937700001,
Author = {Wozniak, Marcin and Filomena, Gabriele},
Title = {Beyond urban form: Introducing dynamic factors in agent-based
   simulations of pedestrian movement},
Journal = {COMPUTERS ENVIRONMENT AND URBAN SYSTEMS},
Year = {2026},
Volume = {128},
Month = {SEP},
Abstract = {While research on route choice behaviour in cities has focused
   extensively on the role of urban form, including street configuration
   and meaningful urban elements, in shaping pedestrians' decisions, less
   attention has been given to the role of dynamic factors. These are
   phenomena arising from social (e.g. crowding and noise) and natural
   environments (e.g. weather conditions) that vary across space and time.
   Agent-Based Models (ABMs) of pedestrian movement, simulation tools that
   allow researchers to observe the emergence of macro-level patterns (e.g.
   pedestrian flows) from micro-level mechanisms, have been widely
   influenced by research on static urban elements. However, dynamic
   factors remain underrepresented in such modelling frameworks. The aim of
   this paper is to incorporate the effects of crowding and noise on route
   choice behaviour into an empirically grounded and evaluated ABM of
   pedestrian movement. In the ABM, route choice behaviour is
   conceptualised as emerging from the interplay between individual
   preferences and environmental attractors and repellers previously
   identified in empirical work. Pozna \& nacute; (Poland) was selected as
   the study area. First, we conducted a Sensitivity Analysis (SA) to
   assess the impact of specific model inputs on both micro-level
   (characteristics of individual routes) and macro-level (agent volumes
   across the street network) outputs. Then, based on individual
   behavioural differences identified in the empirical study and the
   results of the SA, we parametrised the ABM and derived five agent types,
   each characterised by a distinct set of preferences. Lastly, we assessed
   the incorporation of crowding and noise into the agent behavioural
   mechanisms to evaluate the extent to which these dynamic factors shaped
   the ABM results. The analysis revealed that both urban form and dynamic
   factors influence pedestrian route choice in complex, non-linear ways,
   with several interaction effects. Although urban form played an
   important role in shaping pedestrian routes, dynamic factors also
   affected route choice: they reduced route length and spatial dispersion,
   leading agents to concentrate across a narrower set of street segments.
   Furthermore, we found significant differences in the movement patterns
   generated by the different agent types. Finally, we observed that agents
   often traversed green spaces, squares, and other relatively open routes
   to alleviate the sense of overcrowding in busier parts of the network.},
Publisher = {ELSEVIER SCI LTD},
