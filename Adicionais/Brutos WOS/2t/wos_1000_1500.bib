@article{ WOS:001827104700001,
Author = {Long, Yan and Zhen, Cairui and Cheng, Lianghao and Kang, Fan and Lin,
   Yudi and Li, Jin and Chen, Zixuan and Chen, Wei and Liu, Xi and Song,
   Yang},
Title = {How urban green spaces influence adolescent mental health in urban
   fringe areas: A cultural ecosystem services perspective},
Journal = {ISCIENCE},
Year = {2026},
Volume = {29},
Number = {7},
Month = {JUL 17},
Abstract = {While urban green spaces are known to support psychological restoration,
   their benefits for adolescents in urban fringe areas and the pathways of
   cultural ecosystem services (CESs) remain unclear. Using multisource
   data and structural equation modeling, the findings reveal that: (1)
   CESs improve mental health directly and via social interaction; (2)
   green view index and sky view factor positively affect mental health,
   while normalized difference vegetation index shows a negative effect;
   (3) point of interest density in 500-m park buffers exhibits functional
   differentiation: catering, corporate, and transportation facilities
   enhance mental health, lifestyle services reduce it, and
   commercial-residential facilities show no effect; (4) social interaction
   and neighborhood satisfaction are key mediators; healthcare facilities
   have the strongest total effect but a direct pathway, with effects
   varying by type and usage pattern. This study emphasizes that urban
   fringe planning should prioritize cultural services and social
   integration over mere green space metrics.},
