@article{ WOS:001815508400001,
Author = {Chen, Junying and Fukahori, Kiyotaka},
Title = {Balancing biodiversity conservation and recreational use in
   nature-oriented parks in Saitama Prefecture, Japan},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {124},
Month = {OCT},
Abstract = {Urban parks play critical roles in balancing biodiversity conservation
   and public recreation, yet the multifunctional demands they face
   frequently create tensions between ecological objectives and
   recreational uses. In practice, prioritising one goal can constrain the
   other, and managers must mitigate the resulting disadvantages while
   conserving urban biodiversity. This study investigates the strategies
   that park managers use to manage biodiversity conservation-recreation
   trade-offs across five nature-oriented parks in Saitama Prefecture,
   Japan (Kamogawa Mizubenosato Park, Sayama Hill Flora \& Fauna
   Interaction Centre, Saitama Green Forest Museum, Kitamoto Nature
   Observation Park, and Ageo Maruyama Park). These strategies are grouped
   into three analytically derived orientations: Environmental Focus,
   Balanced Focus, and User Focus. A mixed-methods approach integrating
   text mining, co-occurrence network analysis, and thematic content
   analysis of semi-structured interviews was employed. A novel 30-level
   Conservation and Utilisation Management Framework was developed that
   classifies management orientations, defined here as managers' dominant
   strategic direction for handling conservation-recreation trade-offs.
   Orientations are associated with external environmental conditions
   (e.g., land-use context), internal site characteristics (e.g., scale and
   naturalness), and management perspectives (e.g., policy mandates and
   partnerships). Across all sites, user communication methods, including
   regulation, collaboration, and experiential programming-played a central
   role in reconciling conservation with recreational use. This analytical
   framework provides a practical and adaptable tool for diagnosing park
   governance orientations, guiding policy development, and integrating
   biodiversity conservation and recreational objectives in urban and
   peri-urban park management.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
Type = {Article},
