@article{ WOS:001843444400001,
Author = {Bolleter, Julian and Edwards, Nicole and Gonzalez, Nicolas Mojica and
   Edwards, Maisie and Barghchi, Maassoumeh},
Title = {Taking refuge: Prioritising park climate adaptation strategies based on
   urban design and planning professionals' insights},
Journal = {CITIES},
Year = {2026},
Volume = {179},
Month = {DEC},
Abstract = {This novel paper assesses the perceived effectiveness of strategies to
   improve thermal comfort in local parks under hot daytime conditions
   across the Hot semi-arid (BSh), Hot desert (BWh), and Mediterranean
   (Csa) Ko \& uml;ppen climate regions in Western Australia. This
   assessment is conducted through a survey of urban design and planning
   professionals (n = 87) from Local Government, State Government, and
   private practice, and, as such, delivers a case study of locally
   initiated and adapted planning for climate change. The survey results
   indicate a consistent preference for nature-based solutions to improve
   thermal comfort on hot days. This preference raises questions about
   water availability for irrigation, given reduced rainfall and diminished
   evapotranspirationrelated cooling as humidity increases. Despite such
   challenges, the survey findings provide an evidence base for urban
   design and planning professionals and urban policymakers to reimagine
   existing local parks, in part, as climate refuges with improved thermal
   comfort in summer conditions.},
