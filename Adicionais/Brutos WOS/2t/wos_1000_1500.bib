@article{ WOS:001576018600002,
Author = {Higgins, Emma and Russo, Alessio},
Title = {Beyond beauty: exploring how knowledge of larval food plants and
   ecological benefits affects public perception of native and non-native
   plants in urban greening schemes},
Journal = {URBAN ECOSYSTEMS},
Year = {2025},
Volume = {28},
Number = {5},
Month = {SEP 19},
Abstract = {In the climate and biodiversity crisis, several ecological movements,
   such as rewilding, the `No Mow' initiative, and a growing emphasis on
   plant nativeness, have emerged to promote more sustainable approaches to
   landscape management and the design of urban green spaces. Within this
   context, the integration of native plant species into designed
   landscapes is increasingly recognised as a strategy to improve urban
   biodiversity and ecosystem services. However, native plants remain
   underutilised in urban environments, often due to public perceptions
   that associate them with weeds or untidy spaces. Whilst previous studies
   have explored plant typologies and the value of native versus non-native
   species, little is known about how awareness of a plant's ecological
   role, as food for larval invertebrates, affects aesthetic preferences.
   This study addresses this gap by examining public and stakeholder
   perceptions through focus groups and a Likert-scale survey conducted
   before and after presenting information to assess shifts in perception
   following an educational intervention detailing native plants'
   contributions to supporting urban invertebrate biodiversity. The
   findings reveal that perceived public sentiment towards native plants
   presents a barrier to their use by stakeholders. Additionally, initial
   findings demonstrate a prevailing preference for non-native ornamental
   plants linked to familiarity and perceived aesthetics. However,
   post-information exposure, the desirability of native plants increased,
   while the desirability of non-native plants decreased. This study
   suggests that informing the public about the ecological value of native
   plants can promote biophilic stewardship in designed spaces and
   encourage the use of native plantings for ecologically diverse schemes.},
