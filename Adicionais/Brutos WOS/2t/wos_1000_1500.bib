@article{ WOS:001850639500001,
Author = {Timalsina, Krishna Prasad and Subedi, Bhim Prasad},
Title = {Walking accessibility to public open spaces in metropolitan Kathmandu,
   Nepal: Integrating physical proximity and public perception},
Journal = {JOURNAL OF URBAN MANAGEMENT},
Year = {2026},
Volume = {15},
Number = {4},
Pages = {1797-1814},
Month = {DEC},
Abstract = {Ensuring equitable accessibility to Public Open Spaces (POS) is
   essential for fostering an inclusive and livable urban environment.
   Metropolitan cities in developing nations are facing challenges in this
   direction. This paper analyzes POS accessibility in Kathmandu,
   incorporating both physical proximity and people's perceptions. Using a
   mixed-methods approach, the study combines GISbased proximity and space
   syntax analysis with data from 354 surveys and 54 interviews to provide
   a robust picture of POS accessibility. Results of physical proximity
   analysis reveal that POS in core areas are more accessible compared to
   outer areas. However, the users' survey and interview data reveal that
   perceived accessibility is often better in outer areas. The city core is
   inhabited by longtime residents whose social, cultural, institutional,
   and behavioral spatial practices are closely linked to nearby open
   spaces, often making these areas feel less accessible to outsiders. The
   study concludes that integrating objective analysis with subjective user
   perceptions provides a more comprehensive understanding of POS
   accessibility, offering valuable insights and setting the agenda for
   future research aimed at promoting livable urban development and
   sustainability initiatives in rapidly developing cities of the Global
   South.},
