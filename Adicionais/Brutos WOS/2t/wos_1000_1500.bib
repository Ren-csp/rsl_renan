@article{ WOS:001856356900001,
Author = {Valera, Sergi and Castrechini-Trotta, Angela and von Schiller, Daniel},
Title = {When blue meets green: Behavioural patterns and social lingering around
   naturalised ponds in Barcelona},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {125},
Month = {NOV},
Abstract = {Against the dual challenges of climate vulnerability and biodiversity
   loss, naturalising urban spaces has emerged as a key nature-based
   solution for dense Mediterranean cities. This study examined behavioural
   patterns in urban blue and green spaces, focusing on the presence and
   influence of naturalised pond environments in public parks. Using a
   multidimensional systematic observational approach, data were collected
   from four parks in Barcelona, Spain, each comprising a blue-space area
   containing a naturalised pond and a nearby green-space area without a
   pond. Network analysis revealed that green spaces were primarily
   associated with walking through passage zones, involving both
   individuals and groups. Blue spaces also supported common activities
   such as walking and conversing but were additionally associated with
   distinctive water-related behaviours, including contemplation,
   interaction with the water, and photography. These activities were
   predominantly group-based, suggesting that ponds functioned as focal
   points for social and recreational use. Behaviours associated with
   lingering accounted for 51.7\% of activities in blue spaces, compared
   with 32.2\% in green spaces. These findings indicate that urban blue
   spaces broaden the range of activities supported by urban parks and are
   associated with a greater prevalence of social, recreational, and
   lingering-related behaviours. Incorporating naturalised water features
   into urban parks may therefore contribute to more engaging and socially
   supportive public spaces, with potential benefits for community
   interaction and human well-being.},
