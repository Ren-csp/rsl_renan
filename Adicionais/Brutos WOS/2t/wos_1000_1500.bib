@article{ WOS:001086514700001,
Author = {Granobles Velandia, Fabian Andres and Trilleras Motha, Jenny Maritza and
   Romero-Duque, Luz Piedad and Quijas, Sandra},
Title = {Understanding the sociocultural valuation of ecosystem services in urban
   parks: a Colombian study case},
Journal = {URBAN ECOSYSTEMS},
Year = {2024},
Volume = {27},
Number = {1},
Pages = {289-303},
Month = {FEB},
Abstract = {The significance of urban ecosystem services on the perception of parks
   among the public is profound. Parks are valued for their functional
   benefits, the experiences they provide, and their relationship with
   green spaces. To better understand the sociocultural values associated
   with five urban parks in Tunja (Boyaca, Colombia), in this case study,
   we interviewed three types of stakeholders: decision-makers, social
   leaders, and park users. We employed semi-structured interviews to
   identify the perception and orientation values of different
   stakeholders. According to the results, stakeholders recognize 18
   ecosystem services as the most important, with cultural ecosystem
   services having the highest perception value. We found that
   socio-cultural values are influenced more by the characteristics of the
   parks than their size, and socio-demographic aspects of stakeholders
   such as age, level of education, and gender had no significant effect.
   We conclude that people value urban parks for the benefits associated
   with trees and the emotional connections they develop with them over
   time, assigning intangible value to city parks. However, we also
   identified discrepancies in values between governmental and
   non-governmental stakeholders that may adversely affect decision-making
   and policy formulation. This information can be valuable to urban
   planners who seek to assess and integrate measures that promote green
   spaces in cities to achieve sustainability.},
