@article{ WOS:001602840400001,
Author = {Benita, Francisco and Yaacob, Hamzah and Martinez, Rafael},
Title = {Fragmented Realities: Middle-Class Perception Gaps and Environmental
   Indifference in Jakarta and Phnom Penh},
Journal = {URBAN SCIENCE},
Year = {2025},
Volume = {9},
Number = {10},
Month = {OCT 16},
Abstract = {Rapid urbanization in Southeast Asia has created a paradox between
   severe environmental degradation and the often-muted concern of urban
   residents. The objective of this study is to explain this disconnect by
   comparatively analyzing the structural factors that shape environmental
   perceptions among the urban middle class in Jakarta and Phnom Penh.
   Drawing on survey data from over 2000 households, the study reveals two
   distinct narratives. In Jakarta, the middle class reports a surprisingly
   low frequency of environmental problems, suggesting a ``perception
   gap{''} driven by physical and social insulation from the city's
   harshest realities. Conversely, in Phnom Penh, residents report higher
   concern, but their widespread silence when asked for solutions points
   not to apathy but to a sense of powerlessness within a top-down
   governance system. We argue that apparent environmental indifference is
   not a uniform phenomenon but a product of distinct structural forces.
   The paper's contribution is to illustrate how urban fragmentation,
   class-based insulation, and perceived political agency shape the
   relationship between environmental reality and citizen concern.},
