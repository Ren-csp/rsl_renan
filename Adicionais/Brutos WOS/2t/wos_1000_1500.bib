@article{ WOS:001813394900001,
Author = {Poyraz, Anil Yildirim and Szalmane Csete, Maria},
Title = {Two tales of a city: analysis of public view on climate change
   challenges in Budapest},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2026},
Volume = {8},
Number = {7},
Month = {JUL 1},
Abstract = {Climate change brings challenges that are experienced to different
   extents across urban areas. Built environment characteristics and the
   accessibility of certain infrastructures, such as green areas, influence
   the intensity and perception of these challenges. This paper explores
   the differences and similarities between the residents of Buda and Pest
   through a survey investigating perceptions of climate change impacts,
   expectations from adaptation measures, and the attributed importance and
   usage of various urban infrastructure elements. The comparison builds on
   the distinct urban fabric and green infrastructure patterns of the two
   sides. Buda is characterised by large green areas such as wooded hills,
   historical quartiers with low-density development, and residential areas
   surrounded by planned green spaces-whether detached houses or
   multi-storey blocks. In contrast, Pest consists of a compact
   19th-century city centre and surrounding dense neighbourhoods that
   expanded during the 20th century, including socialist-era housing blocks
   with slightly more open and green spaces. Although the ramifications of
   the distinct urban characteristics of the two sides could be reflected
   in the technical assessment of climate change impacts, this research
   focuses on the comparative analysis of residents' experiences. The
   findings reveal divergences in the use of natural areas and the Danube's
   quays, with Buda residents making use of these spaces more frequently.
   While no statistically significant differences were found between the
   two sides in perceived impacts or adaptation preferences, respondents
   from Pest side who reported experiencing climate change impacts assigned
   higher importance to several infrastructural elements such as street
   trees and water reuse applications at all scales in responding to
   certain challenges. Understanding how perceptions and expectations vary
   across urban contexts can inform more effective, place-based adaptation
   and communication strategies. The findings highlight the need to
   consider local urban morphology, accessibility of green infrastructure,
   and residents' experiences when designing inclusive climate adaptation
   policies in metropolitan settings.},
