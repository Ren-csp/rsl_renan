@article{ WOS:000436594300052,
Author = {Koehl, Antoine and Hu, Hongli and Maeda, Shoji and Zhang, Yan and Qu,
   Qianhui and Paggi, Joseph M. and Latorraca, Naomi R. and Hilger, Daniel
   and Dawson, Roger and Matile, Hugues and Schertler, Gebhard F. X. and
   Granier, Sebastien and Weis, William I. and Dror, Ron O. and Manglik,
   Aashish and Skiniotis, Georgios and Kobilka, Brian K.},
Title = {Structure of the μ-opioid receptor-Gi protein complex},
Journal = {NATURE},
Year = {2018},
