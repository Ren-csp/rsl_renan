@article{ WOS:001723866800002,
Author = {Suklabaidya, Sujit and Mohanty, Suchitra and Reider, Irene E. and White,
   Jesse and Colter, Dominic and McCormick, Sarah M. and Shembade, Noula
   and Choi, Young Bong and Norbury, Christopher C. and Harhaj, Edward W.},
Title = {Negative feedback regulation of STING signaling by TAX1BP1-directed
   Golgiphagy},
Journal = {NATURE COMMUNICATIONS},
Year = {2026},
Volume = {17},
Number = {1},
Month = {FEB 11},
Abstract = {The cGAS-STING pathway is a critical regulator of type I Interferon
   (IFN) and inflammation upon cytosolic DNA-sensing. cGAS-STING signaling
   termination is regulated by lysosomal-mediated degradation of STING;
   however, the mechanisms controlling the inhibitory targeting of STING
   are incompletely understood. Here, we identify the selective autophagy
   receptor TAX1BP1 as a negative regulator of the cGAS-STING pathway.
   TAX1BP1-deficient macrophages activated by cGAS or STING agonists
   accumulate higher-order STING aggregates, exhibit heightened STING
   signaling, and increased production of type I IFN and proinflammatory
   cytokines. Mechanistically, TAX1BP1 promotes STING degradation through
   microautophagy by facilitating the interaction of STING with the ESCRT-0
   protein HGS. Furthermore, STING activation is associated with the
   swelling and fragmentation of the Golgi apparatus, and TAX1BP1 and
   p62/SQSTM1 are essential for the autophagic degradation of fragmented
   Golgi (Golgiphagy). Our findings suggest that STING activation at the
   Golgi is coupled to its downregulation by Golgiphagy to restrict innate
   immune responses.},
