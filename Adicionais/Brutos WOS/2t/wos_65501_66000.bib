Title = {Lateral Hydrological Connectivity Driven by Tidal Flooding Regulates
   Range- Expansion of Invasive Spartina alterniflora in
   Tidal Channel-Salt Marsh Systems},
Journal = {JOURNAL OF ENVIRONMENTAL INFORMATICS},
Year = {2023},
Volume = {41},
