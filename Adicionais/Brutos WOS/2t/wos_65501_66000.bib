Author = {Cvetkovic, Vladimir M. and Nikolic, Neda and Nenadic, Una Radovanovic
   and Ocal, Adem and Noji, Eric K. and Zecevic, Miodrag},
Title = {Preparedness and Preventive Behaviors for a Pandemic Disaster Caused by
