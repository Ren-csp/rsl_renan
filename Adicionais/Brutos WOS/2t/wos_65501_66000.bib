@article{ WOS:000969250300004,
Author = {Austin, Rebecca J. and Straube, Jasmin and Halder, Rohit and
   Janardhanan, Yashaswini and Bruedigam, Claudia and Witkowski, Matthew
   and Cooper, Leanne and Porter, Amy and Braun, Matthias and
   Souza-Fonseca-Guimaraes, Fernando and Minnie, Simone A. and Cooper,
   Emily and Jacquelin, Sebastien and Song, Axia and Bald, Tobias and
   Nakamura, Kyohei and Hill, Geoffrey R. and Aifantis, Iannis and Lane,
   Steven W. and Bywater, Megan J.},
Title = {Oncogenic drivers dictate immune control of acute myeloid leukemia},
Journal = {NATURE COMMUNICATIONS},
Year = {2023},
Volume = {14},
Number = {1},
Month = {APR 14},
Abstract = {Acute myeloid leukemia (AML) is a genetically heterogeneous, aggressive
   hematological malignancy induced by distinct oncogenic driver mutations.
   The effect of specific AML oncogenes on immune activation or suppression
   is unclear. Here, we examine immune responses in genetically distinct
   models of AML and demonstrate that specific AML oncogenes dictate
   immunogenicity, the quality of immune response and immune escape through
   immunoediting. Specifically, expression of Nras(G12D) alone is
   sufficient to drive a potent anti-leukemia response through increased
   MHC Class II expression that can be overcome with increased expression
   of Myc. These data have important implications for the design and
   implementation of personalized immunotherapies for patients with AML.
   There is increasing evidence of a functional interaction between acute
   myeloid leukemia (AML) and immune cells, influencing disease outcome.
   Here the authors study how distinct oncogenes differentially affect the
   host immune response to leukemic cells in preclinical models of AML.},
