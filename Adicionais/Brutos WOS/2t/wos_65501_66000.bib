@article{ WOS:001183186200011,
Author = {Xu, Meng and Ito-Kureha, Taku and Kang, Hyun-Seo and Chernev, Aleksandar
   and Raj, Timsse and Hoefig, Kai P. and Hohn, Christine and Giesert,
   Florian and Wang, Yinhu and Pan, Wenliang and Zietara, Natalia and
   Straub, Tobias and Feederle, Regina and Daniel, Carolin and Adler,
   Barbara and Koenig, Julian and Feske, Stefan and Tsokos, George C. and
   Wurst, Wolfgang and Urlaub, Henning and Sattler, Michael and Kisielow,
   Jan and Wulczyn, F. Gregory and Lyszkiewicz, Marcin and Heissmeyer, Vigo},
Title = {The thymocyte-specific RNA-binding protein Arpp21 provides TCR
   repertoire diversity by binding to the 3'-UTR and promoting
   Rag1 mRNA expression},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {MAR 11},
Abstract = {The regulation of thymocyte development by RNA-binding proteins (RBPs)
   is largely unexplored. We identify 642 RBPs in the thymus and focus on
   Arpp21, which shows selective and dynamic expression in early
   thymocytes. Arpp21 is downregulated in response to T cell receptor (TCR)
   and Ca2+ signals. Downregulation requires Stim1/Stim2 and CaMK4
   expression and involves Arpp21 protein phosphorylation,
   polyubiquitination and proteasomal degradation. Arpp21 directly binds
   RNA through its R3H domain, with a preference for uridine-rich motifs,
   promoting the expression of target mRNAs. Analysis of the Arpp21-bound
   transcriptome reveals strong interactions with the Rag1 3 `-UTR.
   Arpp21-deficient thymocytes show reduced Rag1 expression, delayed TCR
   rearrangement and a less diverse TCR repertoire. This phenotype is
   recapitulated in Rag1 3 `-UTR mutant mice harboring a deletion of the
   Arpp21 response region. These findings show how thymocyte-specific
   Arpp21 promotes Rag1 expression to enable TCR repertoire diversity until
   signals from the TCR terminate Arpp21 and Rag1 activities.},
