@article{ WOS:000176441200043,
Author = {Dragon, F and Gallagher, JEG and Compagnone-Post, PA and Mitchell, BM
   and Porwancher, KA and Wehner, KA and Wormsley, S and Settlage, RE and
   Shabanowitz, J and Osheim, Y and Beyer, AL and Hunt, DF and Baserga, SJ},
Title = {A large nucleolar U3 ribonucleoprotein required for 18S ribosomal RNA
   biogenesis},
Journal = {NATURE},
Year = {2002},
Volume = {417},
Number = {6892},
Pages = {967-970},
Month = {JUN 27},
Abstract = {Although the U3 small nucleolar RNA (snoRNA), a member of the box C/D
   class of snoRNAs, was identified with the spliceosomal small nuclear
   RNAs (snRNAs) over 30 years ago(1,2), its function and its associated
   protein components have remained more elusive. The U3 snoRNA is
   ubiquitous in eukaryotes and is required for nucleolar processing of
   pre-18S ribosomal RNA in all organisms where it has been tested(3,4).
   Biochemical and genetic analyses suggest that U3-pre-rRNAbase-pairing
   interactions mediate endonucleolytic pre-rRNA cleavages(3). Here we have
   purified a large ribonucleoprotein (RNP) complex from Saccharomyces
   cerevisiae that contains the U3 snoRNA and 28 proteins. Seventeen new
   proteins (Utp1-17) and Rrp5 were present, as were ten known components.
   The Utp proteins are nucleolar and specifically associated with the U3
   snoRNA. Depletion of the Utp proteins impedes production of the 18S
   rRNA, indicating that they are part of the active pre-rRNA processing
   complex. On the basis of its large size (80S; calculated relative
