@article{ WOS:000709488600001,
Author = {Hu, Mingyu and Jia, Hepeng and Xie, Yu},
Title = {Passport to a Mighty Nation: Exploring Sociocultural Foundation of
   Chinese Public's Attitude to COVID-19 Vaccine Certificates},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {19},
Month = {OCT},
Abstract = {Vaccination against COVID-19 is essential against the pandemic. There
   are broad discussions on adopting certificates for vaccination and the
   immunity obtained after infection. Based on a national sample of over
   2000 participants administered in April 2021, the current study examines
   the Chinese public's attitudes to the so-called COVID-19 vaccination
   passport and factors contributing to their viewpoints. Generally, the
   Chinese people had favorable opinions on the passport. Among possible
   contributing factors, income, personal benefit perception, the
   subjective norm of COVID-19 vaccination, and nationalism were
   significantly associated with the public's positive attitude. At the
   same time, general vaccine knowledge and scientific literacy had an
   inconstant effect. Echoing recent studies, these findings reveal a
   collectivism-oriented attitude of the Chinese public towards the
   proposal to certify vaccination publicly. Theoretical and practical
   implications of the results were discussed.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Jia, HP (Corresponding Author), Soochow Univ, Sch Commun, Suzhou 215123, Peoples R China.
   Hu, Mingyu; Jia, Hepeng; Xie, Yu, Soochow Univ, Sch Commun, Suzhou 215123, Peoples R China.},
DOI = {10.3390/ijerph181910439},
Article-Number = {10439},
EISSN = {1660-4601},
Keywords = {COVID-19; vaccination passport; immunity certificates; nationalism;
   collectivism; CoV-SARS-2},
Keywords-Plus = {CONSPIRACY THEORIES; INTENTION},
