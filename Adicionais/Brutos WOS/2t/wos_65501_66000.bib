@article{ WOS:001002447800017,
Author = {Cheng, Yi-Ting and Luna-Figueroa, Estefania and Woo, Junsung and Chen,
   Hsiao-Chi and Lee, Zhung-Fu and Harmanci, Akdes Serin and Deneen,
   Benjamin},
Title = {Inhibitory input directs astrocyte morphogenesis through glial
   GABABR},
