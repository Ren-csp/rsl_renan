@article{ WOS:000470715500002,
Author = {Barbano, Anna C. and van der Mei, Willem F. and deRoon-Cassini, Terri A.
   and Grauer, Ettie and Lowe, Sarah Ryan and Matsuoka, Yutaka J. and
   O'Donnell, Meaghan and Olff, Miranda and Qi, Wei and Ratanatharathorn,
   Andrew and Schnyder, Ulrich and Seedat, Soraya and Kessler, Ronald C.
   and Koenen, Karestan C. and Shalev, Arieh Y. and Bryant, Richard and
   Delahanty, Douglas and Goslings, Carel and Luitse, Jan and Moergeli,
   Hanspeter and Mouthaan, Joanne and Nishi, Daisuke and Sijbrandij, Marit
   and Suliman, Sharain and van Zuiden, Mirjam and Int Consortium Prevent
   PTSD},
Title = {Differentiating PTSD from anxiety and depression: Lessons from the
   ICD-11 PTSD diagnostic criteria},
Journal = {DEPRESSION AND ANXIETY},
Year = {2019},
Volume = {36},
Number = {6},
Pages = {490-498},
Month = {JUN},
Abstract = {Objective Posttraumatic stress disorder (PTSD) is frequently associated
   with depression and anxiety, but the nature of the relationship is
   unclear. By removing mood and anxiety diagnostic criteria, the 11th
   edition of the International Classification of Diseases (ICD-11) aims to
   delineate a distinct PTSD phenotype. We examined the effect of
   implementing ICD-11 criteria on rates of codiagnosed depression and
   anxiety in survivors with recent PTSD. Method Participants were 1,061
   survivors of traumatic injury admitted to acute care centers in Israel.
   ICD-10 and ICD-11 diagnostic rules were applied to the
   Clinician-Administered PTSD Scale for DSM-IV. Co-occurring disorders
   were identified using the Structured Clinical Interview for DSM-IV
   (SCID). Depression severity was measured by the Beck Depression
   Inventory-II (BDI-II). Assessments were performed 0-60 ({''}wave 1{''})
   and 90-240 ({''}wave 2{''}) days after trauma exposure. Results
   Participants identified by ICD-11 PTSD criteria were equally or more
   likely than those identified by the ICD-10 alone to meet depression or
   anxiety disorder diagnostic criteria (for wave 1: depressive disorders,
   OR {[}odds ratio] = 1.98, 95\% CI {[}confidence interval] = {[}1.36,
   2.87]; anxiety disorders, OR = 1.04, 95\% CI = {[}0.67, 1.64]; for wave
   2: depressive disorders, OR = 1.70, 95\% CI = {[}1.00, 2.91]; anxiety
   disorders, OR = 1.04, 95\% CI = {[}0.54, 2.01]). ICD-11 PTSD was
   associated with higher BDI scores (M = 23.15 vs. 17.93, P M = 23.93 vs.
   17.94, P < 0.001 for wave 2). PTSD symptom severity accounted for the
   higher levels of depression in ICD-11 PTSD. Conclusions Despite
   excluding depression and anxiety symptom criteria, the ICD-11 identified
   equal or higher proportion of depression and anxiety disorders,
   suggesting that those are inherently associated with PTSD.},
