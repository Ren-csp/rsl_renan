@article{ WOS:001561337400002,
Author = {Gatdet, Chayot and Adino, Kibrom and Petros, Tigist},
Title = {Dynamics of seasonal migration among pastoralists in Itang special
   district, Gambella region, South-West Ethiopia},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {SEP 1},
Abstract = {Climate change, conflicts, a shortage of rangeland resources for
   livestock, and agricultural expansion affect the livelihoods of
   pastoralists. Consequently, the pastoralists utilize seasonal migration
   as an adaptation strategy in the Gambella region. The primary objective
   of this study was to assess the dynamics of the pastoralists' seasonal
   migration. Multistage sampling techniques, including simple random,
   stratified, and purposive sampling, were employed. Focus group
   discussions and a questionnaire survey were used to collect data from
   100 respondents. The data were analyzed using means, standard
   deviations, percentages, frequencies, chi-square, t-tests, and a binary
   logistic regression model. The results of the binary logistic regression
   model revealed that occupational status, perception of migration, credit
   access, distance to market, distance to livestock water, and livestock
   holding size were significant factors influencing the pastoralists'
   seasonal migration in the area. Additionally, recurrent conflicts
   (52\%), the absence of a road network (28\%), scarcity of non-farm
   activities (46\%), insufficient water resources (36\%), and the
   prevalence of livestock predators (40\%) were serious barriers faced
   during seasonal migration. Moreover, stimulating livestock products
   (66\%), strengthening resilience (50\%), enhancing social cohesion
   (43\%), and ensuring sustainable rangelands (38\%) represented promising
   prospects for seasonal migration. Therefore, seasonal migration is
   influenced by socio-economic drivers, hindered by environmental and
   conflict-related challenges, but still presents promising opportunities
   through improved access to markets, resilience initiatives, and
   sustainable rangeland use. Thus, seasonal migration sustainability can
   be enhanced by improving the rural road network, expanding non-farm
   livelihoods, and strengthening conflict resolution and rangeland
   management.},
Publisher = {SPRINGERNATURE},
Address = {CAMPUS, 4 CRINAN ST, LONDON, N1 9XW, ENGLAND},
