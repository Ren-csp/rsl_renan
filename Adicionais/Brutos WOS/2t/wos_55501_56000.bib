@article{ WOS:001326732700001,
Author = {Dekydtspotter, Laurent and Miller, A. Kate and Swanson, Kyle and Cha,
   Jih-Ho and Xiong, Yanyu and Ahn, Jae-Hyun and Gilbert, Jane A. and Pope,
   Decker and Iverson, Mike and Meinert, Kent},
Title = {Hierarchical neural processing in γ oscillations for syntactic and
   semantic operations accounts for first- and second-language epistemology},
Journal = {FRONTIERS IN HUMAN NEUROSCIENCE},
Year = {2024},
Volume = {18},
Month = {SEP 23},
Abstract = {Introduction We discuss event-related power differences (ERPDs) in low-
   and broadband-gamma oscillations as the embedded-clause edge is
   processed in wh-dependencies such as Which decision regarding/about
   him/her did Paul say that Lydie rejected without hesitation? in first
   (L1) and second language (L2) French speakers.Methods The experimental
   conditions manipulated whether pronouns appeared in modifiers (Mods;
   regarding him/her) or in noun complements (Comps; about him/her) and
   whether they matched or mismatched a matrix-clause subject in
   gender.Results Across L1 and L2 speakers, we found that anaphora-linked
   ERPDs for Mods vs. Comps in evoked power first arose in low gamma and
   then in broadband gamma. Referential elements first seem to be retrieved
   from working memory by narrowband processes in low gamma and then
   referential identification seems to be computed in broadband-gamma
   output. Interactions between discourse- and syntax-based referential
   processes for the Mods vs. Comps in these ERPDs furthermore suggest that
   multidomain gamma-band processing enables a range of elementary
   operations for discourse and semantic interpretation.Discussion We argue
   that a multidomain mechanism enabling operations conditioned by the
   syntactic and semantic nature of the elements processed interacts with
   local brain microcircuits representing features and feature sets that
   have been established in L1 or L2 acquisition, accounting for a single
   language epistemology across learning contexts.},
