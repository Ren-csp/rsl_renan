@article{ WOS:000671552500009,
Author = {Anguzu, Ronald and Nagavally, Sneha and Dawson, Aprill Z. and Walker,
   Rebekah J. and Egede, Leonard E.},
Title = {Age and Gender Differences in Trends and Impact of Depression on Quality
   of Life in the United States, 2008 to 2016},
Journal = {WOMENS HEALTH ISSUES},
Year = {2021},
Volume = {31},
Number = {4},
Pages = {353-365},
Month = {JUL-AUG},
Abstract = {Background: We aimed to examine age and gender differences in the
   relationship between depression and quality of life among United States
   adults.
   Methods: Medical Expenditure Panel Survey data for 2008 to 2016 on
   227,663 adults were analyzed. The dependent variable, quality of life,
   included physical component summary scores and mental component summary
   scores from the Short Form Health Survey. The key independent variable,
   depression, was measured using the two-item Patient Health
   Questionnaire. General linear regression models examined the
   relationship between quality of life and depression. Models were
   adjusted for individual and environmental characteristics, symptom
   status, functional and biological status, and health perceptions and
   were stratified by gender and age.
   Results: In adjusted models, mental component summary scores were
   significantly lower among those with depression compared with those
   without depression (beta = -0.39; 95\% confidence interval {[}CI], 0.38
   to -1.16) and lower among women compared with men (beta = -0.10; 95\%
   CI, 0.10 to -1.31). Models stratified by gender and age found women with
   depression ages 40 to 64 (beta = -0.07; 95\% CI, 0.07 to -0.20) and 65
   or older (beta = -0.08; 95\% CI, 0.08 to -0.24) had significantly lower
   physical component summary scores compared with those without
   depression. Among men with depression, those ages 18 to 39 (beta =
   -0.03; 95\% CI, 0.03 to -0.10) and 40 to 64 (beta = -0.09, 95\% CI, 0.08
   to -0.26) had lower physical component summary scores compared with
   those without depression. Women and men of all ages with depression had
   significantly lower mental component summary scores compared with those
   without depression.
   Conclusions: Public health interventions and clinical approaches to
   address depression in women and men should target functional status in
   men and perceptions of health in women. (C) 2021 Jacobs Institute of
   Women's Health. Published by Elsevier Inc.},
