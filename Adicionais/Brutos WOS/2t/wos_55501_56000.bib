@article{ WOS:001377850400001,
Author = {Irshad, Omer and Ahmad, Sohail and Mahmood, Shahid},
Title = {Fostering Purchase Intentions Through CSR and Service Quality: The Role
   of Customer Satisfaction, Brand Loyalty, and Admiration},
Journal = {SUSTAINABILITY},
Year = {2024},
Volume = {16},
Number = {23},
Month = {DEC},
Abstract = {A management idea known as corporate social responsibility encourages
   businesses to incorporate social and environmental considerations into
   their daily operations and relationships with stakeholders. The purpose
   of this research is to identify the aspects that influence customers'
   perceptions of a brand's commitment to social responsibility and their
   subsequent intentions to purchase. The theoretical model proposed draws
   on numerous theories of consumer behavior, including the perceived value
   theory, the corporate identity theory, and the theory of planned
   behavior. A survey was then given to 280 users in Pakistan afterwards.
   Later, structural equation modeling was used to evaluate the suggested
   model. It was discovered that customer satisfaction, brand loyalty, and
   brand admiration mediated the relationship between CSR and CSR-related
   purchase intent. In conjunction with service quality, CSR practices
   increase customer satisfaction. The effect of customer satisfaction on
   CSR purchasing intent is also mediated by brand loyalty and brand
   admiration. This study backs consumer behavior theories by elucidating
   the lagged and immediate indicators of CSR purchasing intent. CSR may
   result in customer satisfaction if implemented intelligently to meet its
   objectives. Customer satisfaction is a requirement for customers to be
   ready to pay for CSR.},
