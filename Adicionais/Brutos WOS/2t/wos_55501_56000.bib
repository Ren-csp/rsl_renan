@article{ WOS:001340086500009,
Author = {Teasdale, Emma and Mercille, Genevieve and Roncarolo, Federico and Riva,
   Mylene and Sylvestre, Marie-Pierre and Blanchet, Rosanne and Potvin,
   Louise},
Title = {Association between food security status and dietary patterns in a
   cohort of first-time food-aid users},
Journal = {CANADIAN JOURNAL OF PUBLIC HEALTH-REVUE CANADIENNE DE SANTE PUBLIQUE},
Year = {2025},
Volume = {116},
Number = {1, SI},
Pages = {59-69},
Month = {FEB},
Abstract = {ObjectiveTo examine the associations between food security status and
   dietary patterns among first-time food-aid users.MethodsFrom September
   2018 to January 2020, a sample of 1001 newly registered food-aid users
   from 106 community-based food donation organizations were recruited
   across urban, rural, and peri-urban areas in four administrative regions
   of the province of Quebec, Canada. The Household Food Security Survey
   Module (HFSSM) and the Short Diet Questionnaire (SDQ) were used to
   assess food security status and food intake, respectively. A posteriori
   dietary patterns were identified through principal component analysis.
   Regression analyses were performed on 987 participants with complete
   data to quantify the association between food security status and
   dietary patterns.ResultsThree main dietary patterns were identified:
   prudent (intake of fruits and fruit juice, plant-based beverages and
   legumes, green salad, carrots, other vegetables, whole grains, and
   fish), western (intake of poultry, red meat, potatoes and fried
   potatoes, rice, and pasta and refined grains), and snack foods (intake
   of salty snacks, cheese, butter and margarine, sweets, condiments, sweet
   beverages, and processed meat). Food insecurity was negatively
   associated with the prudent dietary pattern and positively associated
   with the snack food dietary pattern.ConclusionThis study highlights the
   complexity of dietary patterns in a vulnerable population of first-time
   food-aid users, especially among those who are severely food insecure.
   ObjectifExaminer les associations entre le statut de s \& eacute;curit
   \& eacute; alimentaire et les habitudes alimentaires chez des nouveaux
   utilisateurs de l'aide alimentaire.M \& eacute;thodesDe septembre 2018
   \& agrave; janvier 2020, un \& eacute;chantillon de 1001 nouveaux b \&
   eacute;n \& eacute;ficiaires de l'aide alimentaire issus de 106
   organisations communautaires de dons alimentaires a \& eacute;t \&
   eacute; recrut \& eacute; dans les zones urbaines, rurales et p \&
   eacute;riurbaines de quatre r \& eacute;gions administratives de la
   province de Qu \& eacute;bec, Canada. Le Module d'enqu \& ecirc;te sur
   la s \& eacute;curit \& eacute; alimentaire des m \& eacute;nages
   (HFSSM) et le Questionnaire abr \& eacute;g \& eacute; sur
   l'alimentation (SDQ) ont \& eacute;t \& eacute; utilis \& eacute;s pour
   \& eacute;valuer le statut de s \& eacute;curit \& eacute; alimentaire
   et l'apport alimentaire, respectivement. Des patrons alimentaires a
   posteriori ont \& eacute;t \& eacute; identifi \& eacute;s par une
   analyse en composantes principales. Des analyses de r \& eacute;gression
   ont \& eacute;t \& eacute; r \& eacute;alis \& eacute;es sur 987
   participants pour quantifier l'association entre le statut de s \&
   eacute;curit \& eacute; alimentaire et les patrons alimentaires.R \&
   eacute;sultatsTrois principaux patrons alimentaires ont \& eacute;t \&
   eacute; identifi \& eacute;s : prudent (consommation de fruits et jus de
   fruits, boissons \& agrave; base de plantes et l \& eacute;gumineuses,
   salade verte, carottes, autres l \& eacute;gumes, c \& eacute;r \&
   eacute;ales et poisson), western (consommation de volaille, viande
   rouge, pommes de terre et pommes de terre frites, riz, p \& acirc;tes et
   c \& eacute;r \& eacute;ales raffin \& eacute;es) et snack foods
   (consommation de collations sal \& eacute;es, fromage, beurre et
   margarine, sucreries, condiments, boissons sucr \& eacute;es et viandes
   transform \& eacute;es). L'ins \& eacute;curit \& eacute; alimentaire \&
   eacute;tait n \& eacute;gativement associ \& eacute;e au patron
   alimentaire prudent et positivement associ \& eacute;e au patron
   alimentaire snack foods.Conclusion Cette \& eacute;tude met en lumi \&
   egrave;re la complexit \& eacute; des patrons alimentaires au sein d'une
   population vuln \& eacute;rable de nouveaux utilisateurs de l'aide
   alimentaire, en particulier parmi ceux en ins \& eacute;curit \& eacute;
   alimentaire grave.},
