@article{ WOS:001817098500001,
Author = {Yu, Minyan and Luo, Laigen and Cheng, Xuejun},
Title = {Optimizing the logistics and warehousing model of anti-cancer drugs for
   cancer patients},
Journal = {PSYCHO-ONCOLOGIE},
Year = {2026},
Volume = {20},
Number = {6},
Abstract = {Against the backdrop of ``dual carbon{''} targets and the upgrading of
   the health industry, the transformation of anti-cancer drug warehousing
   models profoundly impacts the psychosocial experience, treatment
   behavior, and ethical concerns of cancer patients. This study transcends
   traditional environmental and efficiency perspectives, delving into the
   complex effects of different warehousing models (centralized,
   distributed, and hospitaloperated) on patient medication adherence,
   treatment confidence, anxiety levels, disease perception, and the burden
   of family care. We recognize that the layout of warehousing facilities,
   delivery timeliness, and drug temperature stability are not merely
   logistical issues, but core psychosocial factors concerning patients'
   sense of security regarding treatment continuity, hope for survival, and
   dignified care. This paper proposes and validates a fusionoptimized
   ``dynamic adaptive{''} framework, whose core value lies in:
   significantly shortened delivery time directly alleviating waiting
   anxiety for patients and their families; enhanced temperature control
   stability improving treatment trust and adherence; and optimized network
   layout potentially reducing the economic and energy burden on families
   in obtaining medication. The research shows that while achieving carbon
   emission reduction targets, this model's more important contribution
   lies in indirectly but powerfully supporting patients' mental health,
   treatment adherence, and quality of life by improving drug accessibility
   and reliability, particularly significant in palliative care and
   supportive care scenarios. This study provides a practical path for the
   transformation of healthcare logistics. Its core lies in the deep
   integration of environmental sustainability with essential psychosocial
   support, behavioral facilitation, and ethical considerations (such as
   equitable access and burden reduction) in cancer care. It emphasizes the
   crucial role of patient- and family-centered, multidisciplinary
   collaboration (including oncology, psychology, nursing, and social work)
   in building resilient healthcare systems.},
