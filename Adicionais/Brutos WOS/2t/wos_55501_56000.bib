ResearcherID-Numbers = {Mason, James/D-9904-2011},
ORCID-Numbers = {Mason, James/0000-0001-9210-4082},
Funding-Acknowledgement = {National Institute for Health Research, UK; National Institute for
   Health Research (NIHR)},
Funding-Text = {The research reported here forms part of a larger project funded by the
   National Institute for Health Research, UK, entitled ADVANCE: Evaluating
   the implementation of a new psychiatric inpatient facility, a mixed
