@article{ WOS:001838065000001,
Author = {Perez-Ortiz, Diana Laura and Garcia, Juan A. and Amerigo, Maria and
   Martinez-Soto, Joel},
Title = {Evaluation of Residential Satisfaction in Mexico: Creation and
   Validation of a Measure Instrument (Withdrawn Publication. See AUG,
   2026)},
Journal = {PSYCHOLOGY OF MUSIC},
Year = {2026},
Month = {2026 AUG 1},
Abstract = {Accurately measuring residential satisfaction is important when it comes
   to guiding architectural design strategies that improve people's quality
   of life in line with their needs. The aim of this study was to create
   and validate a specific instrument to measure residential satisfaction
   in a Mexican context. The study began with a qualitative assessment of
   residential satisfaction across three categories - home, neighbourhood
   and neighbours - using the natural semantic networks technique on a
   sample of 90 people from the general population. Based on these
   assessments, a 19-item Likert-type scale was designed. The construct
   validity of this scale was analysed using exploratory and confirmatory
   factor analysis with samples from the general population (N = 201 and N
   = 412, respectively). The results revealed two factors explaining
   63.55\% of the total variance: `satisfaction with the home' (McDonald's
   omega coefficient = .88) and `satisfaction with the neighbourhood unit'
   (McDonald's omega coefficient = .92). The scale demonstrated good
   psychometric properties for measuring residential satisfaction in the
   context studied.},
