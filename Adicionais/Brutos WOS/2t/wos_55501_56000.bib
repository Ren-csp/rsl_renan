@article{ WOS:001018201100001,
Author = {Yang, Xi and Zhu, Haiyang and Zhao, Hua and Yang, Dong},
Title = {Coastal Ship Tracking with Memory-Guided Perceptual Network},
Journal = {REMOTE SENSING},
Year = {2023},
Volume = {15},
Number = {12},
Month = {JUN},
Abstract = {Coastal ship tracking is used in many applications, such as autonomous
   navigation, maritime rescue, and environmental monitoring. Many general
   object-tracking methods based on deep learning have been explored for
   ship tracking, but they often fail to accurately track ships in
   challenging scenarios, such as occlusion, scale variation, and motion
   blur. We propose a memory-guided perception network (MGPN) to address
   these issues. MGPN has two main innovative improvements. The dynamic
   memory mechanism (DMM) in the proposed method stores past features of
   the tracked target to enhance the model's feature fusion capability in
   the temporal dimension. Meanwhile, the hierarchical context-aware module
   (HCAM) enables the interaction of different scales, global and local
   information, to address the scale discrepancy of targets and improve the
   feature fusion capability in the spatial dimension. These innovations
   enhance the robustness of tracking and reduce inaccuracies in the
   bounding boxes. We conducted an in-depth ablation study to demonstrate
   the effectiveness of DMM and HCAM. Finally, influenced by the above two
   points, MGPN has achieved state-of-the-art performance on a large
   offshore ship tracking dataset, which contains challenging scenarios
   such as complex backgrounds, ship occlusion, and varying scales.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Yang, D (Corresponding Author), Xian Inst Space Radio Technol, Xian 710100, Peoples R China.
   Yang, Xi; Zhu, Haiyang, Xidian Univ, Sch Telecommun Engn, State Key Lab Integrated Serv Networks, Xian 710071, Peoples R China.
   Zhao, Hua, Beijing Inst Tracking \& Telecommun Technol, Beijing 100094, Peoples R China.
   Yang, Dong, Xian Inst Space Radio Technol, Xian 710100, Peoples R China.},
DOI = {10.3390/rs15123150},
Article-Number = {3150},
EISSN = {2072-4292},
