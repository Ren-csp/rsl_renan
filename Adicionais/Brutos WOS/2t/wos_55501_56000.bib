@article{ WOS:000322858100018,
Author = {Wood, Victoria J. and Curtis, Sarah E. and Gesler, Wil and Spencer, Ian
   H. and Close, Helen J. and Mason, James and Reilly, Joe G.},
Title = {Creating `therapeutic landscapes' for mental health carers in inpatient
   settings: A dynamic perspective on permeability and inclusivity},
Journal = {SOCIAL SCIENCE \& MEDICINE},
Year = {2013},
Volume = {91},
Number = {SI},
Pages = {122-129},
Month = {AUG},
Abstract = {Although there has been a shift toward treatment in the home and the
   community, in the UK, inpatient facilities are still important in modern
   mental health care. `Informal carers', including family members, often
   play an essential role, not only in providing care in the community but
   also in care of patients during periods of hospitalisation. UK National
   Health Service policies increasingly consider the position of these
   carers as `partners' in the care process, but relatively little
   attention has been paid to their position within the hospital settings
   where treatment is provided for inpatients. This paper contributes to
   geographical work on carers experiences, by reporting how this issue
   emerged through a study focused on perceptions of a newly built
   hospital, compared with the inpatient facilities it replaced. We draw on
   qualitative research findings from discussion groups and interviews with
   informal carers. The material considered here focused especially on
   carers' views of aspects of the hospital environment that were important
   for wellbeing of carers and the people they look after. The carers'
   views were supplemented by relevant material drawn from other interviews
   from our wider study, which included service users and members of
   hospital staff. These accounts revealed how informal carers experienced
   the hospital environment; we interpret our findings through a conceptual
   framework that emphasises carers' experiences of a journey' along a
   `caring pathway' to and through the hospital space. This perspective
   allows us to make a connection between three bodies of literature. The
   first relates to phenomenological interpretations of one's environmental
   perception, formed as one moves through the world. The second derives
   from the literature concerning `permeability' of hospital institutions.
   Bringing these ideas together provides an innovative, dynamic
   perspective on a third strand of literature from health geography that
   examines hospitals as `therapeutic landscapes'. The analysis helps to
   explore the extent to which carers in this study were positioned as
   `outsiders' in the hospital space. (C) 2012 Elsevier Ltd. All rights
   reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Wood, VJ (Corresponding Author), Univ Durham, Wolfson Res Inst, Queens Campus, Stockton On Tees DH17 6BH, England.
   Wood, Victoria J.; Curtis, Sarah E.; Spencer, Ian H.; Close, Helen J.; Mason, James; Reilly, Joe G., Univ Durham, Wolfson Res Inst, Stockton On Tees DH17 6BH, England.
   Gesler, Wil, Univ N Carolina, Chapel Hill, NC 27515 USA.
   Wood, Victoria J.; Curtis, Sarah E., Univ Durham, Dept Geog, Stockton On Tees DH17 6BH, England.},
DOI = {10.1016/j.socscimed.2012.09.045},
ISSN = {0277-9536},
Keywords = {North East England; UK; Mental health care; Managed permeability;
   Psychiatric hospital design; Informal carers; Therapeutic landscapes;
   Phenomenology},
Keywords-Plus = {POST-ASYLUM GEOGRAPHIES; HOSPITAL DESIGN; PLACE},
