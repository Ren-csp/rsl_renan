@article{ WOS:001816462600001,
Author = {Jackson, Steven J. and Dawson, Marcelle C.},
Title = {Reconceptualising sportswashing beyond image politics: exploring the
   elective affinity between the IOC, the United Nations, and nation-states},
Journal = {INTERNATIONAL JOURNAL OF SPORT POLICY AND POLITICS},
Year = {2026},
Month = {2026 JUL 12},
Abstract = {This analysis explores the concept of sportswashing, including its
   complexity and limitations. Addressing some recent critiques, we
   advocate for a reconceptualisation of sportswashing, on the basis of
   which we articulate two basic tenets. First, we argue that it is
   essential to understand the nature and necessity of complicity - herein
   referred to as the `elective affinity' - between the actors involved.
   Second, we suggest that sportswashing may be better understood by
   acknowledging the links between various types of `washing' or
   `laundering' associated with sport. After highlighting the unique
   features of sport that make it an appealing instrument within the realm
   of politics, the paper focuses on the complex and mutually reinforcing
   relationship between the International Olympic Committee and the United
   Nations, bringing to light their complicity not only in how they attempt
   to launder their own reputation through what we refer to as
   `peace-washing', but also in how they enable forms of washing by one
   particular nation-state, namely China. Overall, we explore how
   sportswashing: (a) is practised by multiple and complicit actors
   pursuing mutually beneficial goals that help them to maintain power and
   influence; and (b) can comingle with other forms of washing or
   laundering.},
