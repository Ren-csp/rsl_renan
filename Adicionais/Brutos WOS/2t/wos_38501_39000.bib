@article{ WOS:001706337400001,
Author = {Feng, Zixiang},
Title = {Privacy in motion: Attitudes and strategies for navigating the smart
   home privacy paradox},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER STUDIES},
Year = {2026},
Volume = {210},
Month = {MAR},
Abstract = {While privacy concerns in smart homes have gained attention in
   human-computer interaction research, existing research underappreciates
   users' convenience-privacy trade-offs in real-world practice. Drawing on
   privacy paradox theory and a distributed cognition perspective, this
   study employs a contextmapping methodology, integrating a 14-day diary
   study and recalled semi-structured interviews to explore users'
   attitudes toward the privacy paradox and their navigation strategies.
   Our findings emphasize the context-dependent, situated nature of privacy
   navigation strategy, providing new insights into privacy tensions in
   smart home.},
Publisher = {ACADEMIC PRESS LTD- ELSEVIER SCIENCE LTD},
Address = {24-28 OVAL RD, LONDON NW1 7DX, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Feng, ZX (Corresponding Author), Royal Coll Art, Sch Design, London, England.
   Feng, Zixiang, Royal Coll Art, Sch Design, London, England.},
DOI = {10.1016/j.ijhcs.2026.103774},
Article-Number = {103774},
ISSN = {1071-5819},
EISSN = {1095-9300},
Keywords = {Smart home; Privacy concerns; Distributed cognition; Privacy paradox;
