@article{ WOS:001531058400001,
Author = {Lambeth, Richard},
Title = {E. F. Schumacher and the natural capital paradigm: rethinking approaches
   to conservation through non-violence},
Journal = {GLOBALIZATIONS},
Year = {2026},
Volume = {23},
Number = {3},
Pages = {346-365},
Month = {APR 3},
Abstract = {Environmental politics has become increasingly characterized by a
   tendency of policymakers and scholars to interpret and treat nature as
   if it were financial capital. I critique this approach to environmental
   politics by using the work of E. F. Schumacher. I show how the natural
   capital approach serves to uphold the economic growth paradigm and the
   prevalence of neoclassical economic theory despite many of its
   proponents holding critical positions towards these two phenomena. In
   particular, conceptualizing nature as capital produces violent
   relationships between the human and non-human worlds. I use Schumacher's
   insights to develop an alternative approach to environmental politics
   that takes greater account of the uncertainty of human knowledge and the
   importance of scale when making environmental decisions.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
