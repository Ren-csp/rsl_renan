@article{ WOS:000599951400014,
Author = {Pellitteri, Filippo and Campagna, Nicola and Castiglia, Vincenzo and
   Damiano, Alfonso and Miceli, Rosario},
Title = {Design, implementation and experimental results of an inductive power
   transfer system for electric bicycle wireless charging},
Journal = {IET RENEWABLE POWER GENERATION},
Year = {2020},
Volume = {14},
Number = {15},
Pages = {2908-2915},
Month = {NOV 16},
Note = {7th International Conference on Clean Electrical Power (ICCEP), Otranto,
   ITALY, JUL 02-04, 2019},
Organization = {IEEE; IES; IEEE Power \& Energy Soc; Univ Birmingham; Politecnico Milano
   1863, Dipartimento Elettronica Informazione \& Bioingegneria},
Abstract = {The use of renewable energy and the transformation of transport mode are
   crucial items for achieving an efficient and clean electrical mobility
   that allow being competitive on the market. In this context the
   interface between the power system and the Electric Vehicles (EVs)
   assumes a strategic role. Specifically, wireless energy transmission,
   based on Inductive Power Transfer (IPT), is an attractive solution for
   EVs charging. Moreover, the use of electric bicycles or kick scooters as
   mode of urban transport is continuously growing because they are
   lightweight, sustainable, easily parking, flexible and efficient
   transport devices. Owing to its benefits, the wireless power transfer
   can be considered suitable for those devices. In fact, IPT can also be
   exploited for Vehicle-To-Grid (V2G), where the wireless power flow can
   occur from battery to power grid as well. For E-bike applications,
   bicycle-to-grid or bicycle-to-bicycle energy transfer are viable
   solutions by means of a Bi-Directional Inductive Power Transfer (BDIPT).
   In this paper, a 300 W IPT wireless charger prototype for E-bikes is
   proposed. Modelling, design, simulation and experimental results of this
   prototype are provided. Open-loop and closed-loop tests have been
   performed, focusing on system behaviour for different cases of load,
   distance and misalignment between the coils.},
Publisher = {INST ENGINEERING TECHNOLOGY-IET},
Address = {MICHAEL FARADAY HOUSE SIX HILLS WAY STEVENAGE, HERTFORD SG1 2AY, ENGLAND},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Pellitteri, F (Corresponding Author), Univ Palermo, Dept Engn, Palermo, Italy.
