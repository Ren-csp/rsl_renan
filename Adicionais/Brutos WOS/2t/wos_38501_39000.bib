@article{ WOS:001745811300001,
Author = {Chan, T. Y. and Kamska, V and Schindler, M. and Xie, S. and Kong, T. F.
   and Hu, R. and Dean, M. N.},
Title = {A Material Approach to Endangered Species Conservation: Characterization
   and 3D Imaging of Ballistic Damage in the Casques of Helmeted Hornbill
   (Rhinoplax vigil)},
Journal = {INTEGRATIVE ORGANISMAL BIOLOGY},
Year = {2026},
Volume = {8},
Number = {1},
Abstract = {The helmeted hornbill (Rhinoplax vigil), a critically endangered bird
   prized for the distinctive helmet-like ``casque{''} capping its beak,
   faces threats from poaching and habitat loss. This study applies
   biomaterials/imaging techniques to wildlife forensics, using
   micro-computed tomography to forensically analyse bullet-induced damage
   in a unique collection of helmeted hornbill skull specimens, confiscated
   by the Agriculture, Fisheries and Conservation Department (AFCD) of Hong
   Kong. The findings reveal diverse healing responses, bullet
   characteristics and indications of the poaching strategies used. For
   example, specimen scans-showing various bullets embedded in skull
   tissue-suggest that poachers may use the conspicuous casque as a target
   when shooting upward from the ground. Additionally, our observations of
   casque anatomy exhibit two different types of tissue repair, arguing
   that several of the individuals lived long after being shot. The study
   highlights the value of confiscated specimens for understanding life
   history factors and poaching impacts in rare species, vital for
   developing tailored conservation strategies and advancing knowledge of
   the biology of elusive wildlife.
   Der vom Aussterben bedrohte Schildhornvogel (Rhinoplax vigil) zeichnet
   sich durch sein charakteristisches \& bdquo;Schnabelhorn{''}, welches
   den Schnabel ummantelt aus und ist dadurch besonders durch Wilderei,
   aber auch durch Verlust seines Habitats bedroht. In dieser Studie nutzen
   wir Biomaterialien- und Visualisierungmethoden im Bereich der
   Wildtierforensik und verwenden Mikro-Computertomographie f \& uuml;r die
   forensische Bewertung von durch Geschosse verursachte Sch \& auml;den an
   den Sch \& auml;deln von Schildhornv \& ouml;geln. Zur \&
   uuml;ckgegriffen wird dabei auf eine besondere Sammlung von gewilderten
   Sch \& auml;deln, die vom Amt f \& uuml;r Landwirtschaft, Fischerei und
   Naturschutz (AFCD) in Hongkong beschlagnahmt wurden. Unsere Ergebnisse
   zeigen unterschiedliche Heilungsreaktionen, Merkmale der genutzten
   Projektile und weitere Hinweise auf Wilderei-Strategien. Beispielsweise
   deuten die Scans der Exemplare, die verschiedene im Sch \&
   auml;delgewebe eingebettete Geschossfragmente vorweisen, darauf hin,
   dass Wilderer das auff \& auml;llige Schnabelhorn als Ziel anvisieren,
   wenn sie vom Boden aus nach oben auf die Tiere schie ss en. Zudem zeigen
   unsere anatomischen Auswertungen der Wundheilung des Schnabelhorns zwei
   unterschiedliche Arten der Gewebereparatur, was darauf hindeutet, dass
   einige der Tiere nach dem erfolgten Beschuss noch l \& auml;nger gelebt
   haben. Die Studie betont die Bedeutung von beschlagnahmten Tierprodukten
   f \& uuml;r die Naturkunde und die Auswirkung von Wilderei auf seltene
   Arten, wodurch entscheidende \& ouml;kologische Kenntnisse gewonnen und
   entsprechende Schutzstrategien konzipiert werden k \& ouml;nnen.
