   Damiano, Alfonso, Univ Cagliari, Dept Elect \& Elect Engn, Cagliari, Italy.},
DOI = {10.1049/iet-rpg.2020.0056},
ISSN = {1752-1416},
EISSN = {1752-1424},
Keywords = {battery powered vehicles; battery chargers; power grids; bicycles;
   inductive power transmission; electric vehicle charging;
   vehicle-to-grid; EV battery charging; urban transport; efficient
   transport devices; wireless power transfer; wireless power flow; power
   grid; bi-directional inductive power transfer system; urban multiparking
