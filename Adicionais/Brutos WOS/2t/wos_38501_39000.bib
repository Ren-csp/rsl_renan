@article{ WOS:000534531000013,
Author = {Salnikova, Nataliya and Khltobina, Oleksandra and Gavrysh, Iryna and
   Aleksandrova, Oksana and Grygor'yeva, Viktoriya},
Title = {The Post-Modern Era Spirituality Crisis: Values of Ideals a
   Post-Pandemic Day},
