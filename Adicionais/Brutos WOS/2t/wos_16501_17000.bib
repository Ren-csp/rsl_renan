@article{ WOS:001863438500001,
Author = {Wu, Haibin and Long, Yiwen and Zhao, Huan and Di, Zichen and Liu,
   Guolong},
Title = {Near real-time household carbon emission estimation based on lightweight
   super-resolution perception and dynamic emission factors},
Journal = {SUSTAINABLE ENERGY TECHNOLOGIES AND ASSESSMENTS},
Year = {2026},
Volume = {93},
Month = {SEP},
Abstract = {Accurate carbon emission estimation is essential for achieving carbon
   peaking and carbon neutrality. Traditional approaches to estimate
   household carbon emissions primarily depend on electricity meter data
   and static emission factors, which often result in low accuracy,
   significant time delays, and high data storage costs. To overcome these
   limitations, this paper proposes a near-real-time carbon emission
   estimation framework for households by integrating super-resolution
   perception techniques and dynamic emission factors. Specifically, the
   framework first applies a lightweight super-resolution perception method
   that downscales meter data from hourly to 5-min intervals, thereby
   improving the accuracy and reliability of carbon emission estimation.
   Second, the unit generation data and unit-level dynamic emission factors
   from the power system are incorporated to consider the temporal dynamic
   characteristics of grid carbon emissions. Also, model-agnostic
   meta-learning is applied during model training to reduce data
   requirements and enhance generalization capability across different
   households and scenarios. Experimental results on the REFIT dataset
   demonstrate that, compared with the use of 1-hour-level load data with
   corresponding dynamic emission factors, the proposed framework improves
   the estimation accuracy by an average of 14.12\%. Moreover, it lessens
   the reliance on extensive historical data required for super-resolution
   perception methods and improves the generalization ability of the
   framework.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
