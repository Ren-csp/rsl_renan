   Robinson, Hugh S., Univ Montana, Montana Cooperat Wildlife Res Unit, Missoula, MT 59812 USA.
   Alaback, Paul, Univ Montana, Dept Forest Management, Missoula, MT 59812 USA.},
DOI = {10.1644/12-MAMM-A-002.1},
ISSN = {0022-2372},
EISSN = {1545-1542},
Keywords = {black bear; conflicts; food; foraging behavior; human-bear interactions;
