@article{ WOS:000405819200015,
Author = {Kubickova, Marketa and Croes, Robertico and Rivera, Manuel},
Title = {Human agency shaping tourism competitiveness and quality of life in
   developing economies},
Journal = {TOURISM MANAGEMENT PERSPECTIVES},
Year = {2017},
Volume = {22},
Pages = {120-131},
Month = {APR},
Abstract = {The study investigates the nature of the relationship between tourism
   competitiveness and quality of life with human agency as an intervening
   variable. The study argues that integrating human agency as a
   foundational construct within the tourism competitiveness framework will
   enhance the theoretical knowledge of tourism competitiveness. A panel
   data analysis was applied to the case of Central America to examine the
   relationship between tourism competitiveness (TC) and quality of life
   (QoL). The results reveal a bi- directional causal relationship between
   the two constructs, as well as human agency acting as a moderator
   between TC and QoL, indicating a negative impact on such relationship.
   Such findings provide a number of theoretical and managerial
   implications, thus reinforcing the central role of human agency in
   defining the nature of the relationship between TC and QoL. (C) 2017
   Elsevier Ltd. All rights reserved.},
