@article{ WOS:001860663500001,
Author = {Tardin-Coelho, Raquel and Clifton, Julian and Ashworth, Peta},
Title = {Early grower perceptions and likely acceptance of RNAi-based
   biopesticides in Australia},
Journal = {PEST MANAGEMENT SCIENCE},
Year = {2026},
Month = {2026 AUG 26},
Abstract = {BACKGROUND Managing pest resistance while reducing reliance on
   conventional chemical pesticides remains a major challenge for
   sustainable agriculture. RNA interference (RNAi)-based biopesticides
   represent an emerging class of highly specific and biodegradable pest
   control technologies with potential applications in integrated pest
   management (IPM) systems. Adoption of these novel products depends not
   only on proof of efficacy but also on growers' perceptions of the
   technology, which remains under-explored in the literature. Using the
   Technology Acceptance Framework (TAF), this qualitative study explored
   how and why Australian food and fiber growers, representatives of
   industry peak bodies, and agricultural advisors form perceptions of
   RNAi-based biopesticides and how these perceptions influence growers'
   potential acceptance.RESULTS Semi-structured interviews revealed that
   awareness of RNAi-based biopesticides was limited. However, participants
   identified key conditions necessary for adoption, which included the
   availability of robust scientific evidence on efficacy, environmental
   safety, and regulatory approval. Three interrelated factors were found
   to shape acceptance: (i) perceived credibility of information sources;
   (ii) transparency of field trials and regulatory processes; and (iii)
   compatibility of RNAi-based biopesticides with existing pest management
   practices.CONCLUSION The findings highlight the importance of
   evidence-based communication and stakeholder engagement to successfully
   facilitate the integration of RNAi-based biopesticides in Australian
   agriculture. Strong messages focusing on the differences between RNAi
   technology and genetic modification, along with the safety of RNAi
   technology to both humans and the natural environment will help to build
   trust to allow informed decision-making around the adoption of
   RNAi-based biopesticides within the Australian agricultural community.},
