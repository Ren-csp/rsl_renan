@article{ WOS:001237340200001,
Author = {Tooley, Jack},
Title = {Spatial influences on first impressions: a case study on how stranger
   behavior is judged in urban transitional spaces},
Journal = {COGENT SOCIAL SCIENCES},
Year = {2024},
Volume = {10},
Number = {1},
Month = {DEC 31},
Abstract = {This research examines the overlooked phenomenon of first impressions
   between strangers in urban and psychological research. These rapid
   social judgments have a significant impact on potential future relations
   and contribute to a sense of welcomeness and belonging in communities.
   They occur abundantly in urban transitory spaces such as streets, malls,
   public squares, park(let)s and other in-between arenas where we
   frequently encounter strangers. This study formed and tested a
   theoretical hypothesis about how the composition of such spaces affects
   first impressions through survey-experiment and causal-comparative
   analysis. The discussion highlights and introduces the relevance of
   first impressions to urban discourse while offering a pathway to
   spatially investigate them. The findings have implications for convivial
   design and psychological research.},
