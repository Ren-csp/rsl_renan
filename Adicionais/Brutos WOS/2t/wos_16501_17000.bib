@article{ WOS:001861129100001,
Author = {Mensah, Ronald Osei and Appiah-Marfo, Samuel Yaw and Frimpong, Agyemang},
Title = {Demographic vulnerabilities, social disorganisation, and violent crime
   in urban Ghana: a mixed-methods study of crime-exposed communities in
   Greater Accra},
Journal = {COGENT SOCIAL SCIENCES},
Year = {2026},
Volume = {12},
Number = {1},
Month = {DEC 31},
Abstract = {Violent crime remains a major social challenge in rapidly urbanising
   African cities, yet limited empirical research has examined how
   demographic characteristics interact with social environments to shape
   violence. Guided by Social Disorganisation Theory, this study examines
   demographic and social factors associated with violent crime in the
   Greater Accra Region of Ghana. Using a convergent mixed-methods design,
   survey data from 364 respondents were integrated with qualitative
   interviews involving community residents, community and religious
   leaders, and law enforcement personnel. Findings show that violent crime
   was disproportionately concentrated among young and middle-aged males,
   individuals with lower educational attainment, and those embedded in
   delinquent peer networks. Crime exposure, prolonged unemployment, weak
   family support, limited access to social services, and neighbourhood
   disorganisation further heightened vulnerability. Qualitative findings
   revealed how peer influence, economic marginalisation, fear of
   victimisation, and weakened community controls shaped participation in
   and perceptions of violence. Spatial concentrations were identified in
   urban hotspots, including Ashaiman, Accra Circle, and Madina. The
   findings demonstrate that violent crime reflects the interaction between
   demographic vulnerabilities and adverse social conditions, highlighting
   the need for integrated interventions focused on youth employment,
   education, community engagement, and targeted crime prevention in
   high-risk urban communities.},
