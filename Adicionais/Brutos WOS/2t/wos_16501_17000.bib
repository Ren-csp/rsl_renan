@article{ WOS:001594119400001,
Author = {Rana, Irfan Ahmad and Waseem, Hassam Bin and Kamil, Iqra and Feroz,
   Aimen},
Title = {Quantifying urban-rural disparities in COVID-19 risk perception: a case
   of Rawalpindi district, Pakistan},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2025},
Volume = {22},
Number = {1},
Month = {OCT 14},
Abstract = {The COVID-19 pandemic has revealed public health vulnerabilities. Risk
   perception is a key factor in adopting protective, preventive, and
   precautionary measures against the pandemic. This study aims to identify
   the differences in perceptions of COVID-19 risk between urban and rural
   areas. Using Yamane's formula for sample size, 500 samples were
   collected, divided equally between urban and rural settlements, from
   Rawalpindi, Pakistan. Data were collected via questionnaires from a
   random sample of households. The 27 risk perception indicators were
   grouped into four dimensions, i.e., fear and likelihood, awareness,
   preventive measures, and trust. Data analysis was carried out using a
   self-constructed risk perception index. Statistical analyses were
   conducted to evaluate differences in the four dimensions of risk
   perception between urban and rural communities. Urban risk perception
   was observed to be higher in urban communities than in rural
   communities, with a p-value of < 0.001. The study concludes that fear,
   likelihood, and preventive measures were significantly higher. However,
   awareness and trust dimensions were higher for rural communities. The
   findings suggest that pandemic risk reduction and communication efforts
   must be tailored. The study can assist decision-makers, public health
   authorities, and emergency managers in developing effective strategies
   for mitigating future pandemic risks.},
