@article{ WOS:001863546900001,
Author = {Molamehdizadeh, Neda and Halvani, Gholam H. and Ebrahimi, Hossein and
   Farshad, Ali A. and Moghadam, Seyedeh M. K. and Hanifi, Saber M.},
Title = {Explaining safety challenges and their relationships using a
   qualitative-fuzzy DEMATEL approach: A surface mine case study},
Journal = {JOURNAL OF SUSTAINABLE MINING},
Year = {2026},
Volume = {25},
Number = {3},
Pages = {374-388},
Abstract = {Safety in surface mining operations is a major organizational management
   challenge due to the inherently hazardous nature of mining activities.
   This study aimed to explain safety challenges and identify their
   interrelationships through a combined qualitative-fuzzy DEMATEL approach
   in a surface mine in Yazd Province, Iran. The research was carried out
   in two sequential phases: first, key safety challenges were identified
   through qualitative interviews with employees, supervisors, and safety
   experts; then, the relationships among these challenges were analyzed
   and prioritized using the fuzzy DEMATEL technique. The main challenges
   identified included insufficient specialized training, inadequate safety
   equipment, weak organizational safety culture, and reliance on outdated
   machinery. The results revealed clear differences in the perception of
   safety challenges among the three groups, and showed that strengthening
   training programs and improving safety culture could mitigate other
   issues, such as human error and unsuitable machinery. By integrating
   qualitative exploration with fuzzy DEMATEL analysis, this study provides
   a novel framework for capturing diverse perspectives and quantifying
   their interactions, thereby offering more precise strategies for
   enhancing workplace safety in mining operations.},
