@article{ WOS:001733211300001,
Author = {Lu, J. and He, L. and Shen, H. F.},
Title = {PARK LANDSCAPE WATER BODY EVALUATION AND AQUATIC PLANT CONFIGURATION
   USING A HYBRID HETEROGENEOUS ANALYSIS MODEL},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {3805-3826},
Abstract = {This study aims to construct a high-precision model for evaluating the
   condition of park landscape water bodies and to explore the impact
   mechanism of aquatic plant configuration on water body ecological
   quality. To this end, an evaluation index system incorporating
   ecological, landscape, and plant configuration factors was established.
   A hybrid heterogeneous analysis model combining Random Forest (RF),
   Convolutional Neural Network (CNN), and Whale Migration Algorithm (WMA)
   was proposed. The model was trained and validated using aquatic plant
   configuration datasets and compared to traditional algorithms. Results
   showed that WMA-RF-CNN achieved an MSE of 0.0700, RMSE of 0.2646, and R2
   of 0.6798-all outperforming RF and CNN models. Its prediction curve more
   closely approximated actual values with a more concentrated error
   distribution. This study demonstrates that the proposed method achieves
   high fitting accuracy and stability in evaluating water bodies with
   multi-factor coupling, providing effective technical support for park
   landscape water management and aquatic plant configuration optimization.},
