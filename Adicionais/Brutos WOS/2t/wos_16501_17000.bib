@article{ WOS:000331721700009,
Author = {Foster, Sarah and Villanueva, Karen and Wood, Lisa and Christian, Hayley
   and Giles-Corti, Billie},
Title = {The impact of parents' fear of strangers and perceptions of informal
   social control on children's independent mobility},
Journal = {HEALTH \& PLACE},
Year = {2014},
Volume = {26},
Pages = {60-68},
Month = {MAR},
Abstract = {Declines in children's independent mobility are commonly attributed to
   parents' tear of strangers, yet few empirical studies have investigated
   this relationship. We examined: (1) the impact of parents' fear of
   strangers on children's independent mobility; and (2) whether informal
   social control (i.e., parents' confidence that other residents would
   look out for local children) mitigated any association. Gender
   stratified logistic regression models tested these associations for
   10-12 year-olds and their parents (n=1231) in Perth, Australia. For
   girls, parental fear of strangers was associated with lower odds of
   independent mobility (OR=0.71, p=0.002), and informal social control and
   other social and built environment variables had little attenuating
   influence. This pattern was consistent for boys; however odds ratios
   were lower and statistical significance weaker initiatives that target
   parental fears combined with interventions that normalise children's
   walking may help increase independent mobility. (C) 2013 Elsevier Ltd.
   All rights reserved.},
