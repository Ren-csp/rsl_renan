@article{ WOS:001807756800003,
Author = {Rodriguez, Jose Manuel Munoz and Gonzalez, Sara Serrate and Planella,
   Jordi},
Title = {NATURAL ENVIRONMENT VERSUS DIGITAL ENVIRONMENT. EDUCATIONAL IMPLICATIONS
   FROM THE PERSPECTIVE OF THE BODY},
Journal = {TEORIA DE LA EDUCACION},
Year = {2026},
Volume = {38},
Number = {2},
Pages = {39-59},
Month = {JUL-DEC},
Abstract = {This article analyses the dialectic relationship between natural
   environment and digital environment from the perspective of the body as
   an essential mediator of education processes. Based on the
   body-space-education triad, it examines how different spaces condition
   the possibilities of a person's sensory, cognitive and emotional
   development. Faced with the current predominance of data-driven pedagogy
   and technological hyperconnectivity that has generated a deficit of
   nature, it proposes recovering sensitive pedagogy that recognises the
   body not only as a mere vessel for the brain, but as a territory of
   embodied knowledge. Literature available indicates that, while natural
   space favours the development of interdependent bonds, free mobilisation
   of the senses and autonomy, the digital environment leans toward
   dependence, sensory reduction and fragmentation of the bodily
   experience. The methodology used is a theoretical analyses based on the
   phenomenology of the body, embodied cognition and the concepts of
   anthropological place versus non-place, complemented with a sample from
   a qualitative study applying the discussion group technique with 33
   groups of 9-11 year old boys and girls. An analysis was then performed
   using NVivo software. Results show that renaturalising education is
   essential for comprehensive human development. It concludes that
   contemporary education must seek a dialectic complementarity between
   nature and technology, acknowledging that the human body needs
   five-sensory languages and spaces for holistic development in order to
   build an identity based on belonging to the natural world,
   responsibility and creativity.},
Publisher = {EDICIONES UNIV SALAMANCA},
