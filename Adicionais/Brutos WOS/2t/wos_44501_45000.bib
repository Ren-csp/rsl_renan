@article{ WOS:001625176300001,
Author = {Alexander, Kelly},
Title = {Tasting Red, Hearing Silk: Synesthesia, Sensory Labor, and the Social
   Aesthetics of Chefs},
Journal = {AMERICAN ANTHROPOLOGIST},
Year = {2026},
Volume = {128},
Number = {1},
Pages = {52-62},
Month = {MAR},
Abstract = {This article examines synesthesia as a mode of perception by exploring
   its implications for culinary labor, specifically how chefs navigate
   multisensory experience in the high-pressure environment of professional
   kitchens. Drawing on 30 years of fieldwork and observations of, and
   interviews with, more than 500 chefs, it brings sensory anthropology,
   food studies, and the everyday practices of professional cooking into
   conversation to explore how heightened sensory attunements both shape
   and are shaped by creativity and environmental culture. While
   neurological studies often frame synesthesia as a rare or idiosyncratic
   condition, this article foregrounds its broader social and cultural
   dimensions, positioning it within the social aesthetics of kitchen
   labor. Building on the work of Classen, Howes, Sutton, and others, it
   examines how chefs' perceptions-whether clinically diagnosed as
   synesthetic or not-fuse taste, texture, sound, and memory. The article
   argues that culinary labor reveals the entanglements of sensory
   experience, cultural value, and embodied knowledge, showing how food
   functions as both material and metaphor, and how the senses themselves
   are informed by work. This ethnographic account invites readers to
   consider the kitchen as a site where the senses operate in concert,
   linking inner perception to outer worlds.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Alexander, K (Corresponding Author), Univ North Carolina Chapel Hill, Dept Amer Studies, Chapel Hill, NC 27599 USA.
   Alexander, Kelly, Univ North Carolina Chapel Hill, Dept Amer Studies, Chapel Hill, NC 27599 USA.},
DOI = {10.1111/aman.70040},
EarlyAccessDate = {NOV 2025},
ISSN = {0002-7294},
EISSN = {1548-1433},
Keywords-Plus = {ANTHROPOLOGY; SYNAESTHESIA; FOOD},
Research-Areas = {Anthropology},
Web-of-Science-Categories  = {Anthropology},
Author-Email = {kelly.alexander@unc.edu},
Affiliations = {University of North Carolina; University of North Carolina Chapel Hill;
   University of North Carolina School of Medicine},
ORCID-Numbers = {Alexander, Kelly/0000-0002-4674-7092},
Funding-Acknowledgement = {Ministry of Culture of Sweden; Duke Sanford School of Public Policy;
   Society for the Anthropology of Europe},
Funding-Text = {This article represents findings from a nearly 30-year ``side quest{''}
   into the study of the sensory worlds of chefs with whom I was working
   for entirely different purposes, sometimes as a reporter, sometimes as a
   fellow cook on the line, and sometimes as a student of anthropology.
   First and foremost, I humbly thank them all. Because this article has
   been so long in the making, my observations were supported over the
   years by a range of charitable sponsors, including Food \& Wine
   magazine, Saveur magazine, Amy's Bread, the Ministry of Culture of
   Sweden, the Duke University Graduate School, the Duke Sanford School of
   Public Policy, the John Hope Franklin Institute, and the Society for the
   Anthropology of Europe. I wish to thank the mentors whose insights and
   kindnesses shaped how I think and write about food, culture, and
   everything else, especially Colman Andrews, Sharon Holland, Seth Kotch,
   Orin Starn, and Charles Whitaker. Special thanks go to three remarkable
   colleagues who have encouraged me to keep thinking about synesthesia
   from the dream of this article through its many drafts: my writing
   partner, novelist Mary Claffey; my trusted ``ethno-topics{''}
   interlocutor, Lou Brown; and my American studies coconspirator, the
   sociologist and gender studies expert Antonia Randolph. I would also
   like to thank four anonymous reviewers for their generosity and
   expertise: I've simply never received such rich and rewarding feedback.
   I offer thanks to American Anthropologist editor Elizabeth Chin for the
   spark of her scholarship (especially My Life with Things), itself
   reflected in this article, and her genuine enthusiasm for talking
   through synesthesia with me. Her challenge to fully explore the promises
   and limits of ethnography has been a total treat. Finally, heartfelt
   thanks to Andrew Davidson.},
