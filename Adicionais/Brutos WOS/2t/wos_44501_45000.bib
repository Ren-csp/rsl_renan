@article{ WOS:000362673900011,
Author = {de Andrade, Maristela Oliveira and Machado, Adjane de Araujo and da
   Costa, Ivys Medeiros and Espinola, Rafaella Soares},
Title = {Territory and Ethnic/Local Communities: Pressure for Large Enterprises
   and Access to Public Policies},
Journal = {DESENVOLVIMENTO E MEIO AMBIENTE},
Year = {2015},
