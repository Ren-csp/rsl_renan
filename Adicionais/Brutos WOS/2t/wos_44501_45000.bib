@article{ WOS:000683506000004,
Author = {Vichas, Athea and Riley, Amanda K. and Nkinsi, Naomi T. and Kamlapurkar,
   Shriya and Parrish, Phoebe C. R. and Lo, April and Duke, Fujiko and
   Chen, Jennifer and Fung, Iris and Watson, Jacqueline and Rees, Matthew
   and Gabel, Austin M. and Thomas, James D. and Bradley, Robert K. and
   Lee, John K. and Hatch, Emily M. and Baine, Marina K. and Rekhtman,
   Natasha and Ladanyi, Marc and Piccioni, Federica and Berger, Alice H.},
Title = {Integrative oncogene-dependency mapping identifies RIT1 vulnerabilities
   and synergies in lung cancer},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {AUG 9},
Abstract = {CRISPR-based cancer dependency maps are accelerating advances in cancer
   precision medicine, but adequate functional maps are limited to the most
   common oncogenes. To identify opportunities for therapeutic intervention
   in other rarer subsets of cancer, we investigate the oncogene-specific
   dependencies conferred by the lung cancer oncogene, RIT1. Here,
   genome-wide CRISPR screening in KRAS, EGFR, and RIT1-mutant isogenic
   lung cancer cells identifies shared and unique vulnerabilities of each
   oncogene. Combining this genetic data with small-molecule sensitivity
   profiling, we identify a unique vulnerability of RIT1-mutant cells to
   loss of spindle assembly checkpoint regulators. Oncogenic RIT1(M90I)
   weakens the spindle assembly checkpoint and perturbs mitotic timing,
   resulting in sensitivity to Aurora A inhibition. In addition, we observe
   synergy between mutant RIT1 and activation of YAP1 in multiple models
   and frequent nuclear overexpression of YAP1 in human primary RIT1-mutant
   lung tumors. These results provide a genome-wide atlas of oncogenic RIT1
   functional interactions and identify components of the RAS pathway,
   spindle assembly checkpoint, and Hippo/YAP1 network as candidate
   therapeutic targets in RIT1-mutant lung cancer.
   RIT1 mutations are mutually exclusive with other lung cancer drivers and
   lack targeted therapies. Here the authors examine genetic dependencies
   of mutant RIT1 with genome-wide CRISPR screens, revealing synergy
   between RIT1 and YAP1, and increased sensitivity to Aurora kinase
   inhibitors.},
