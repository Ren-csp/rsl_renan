@article{ WOS:001845913900001,
Author = {Van Engelen, Wisse and Alexiou, Paula and Bollmann, Manuel and Brekl,
   Julia and Kohler, Emilie and Lacan, Lea and Vehrs, Hauke-Peter and
   Bollig, Michael},
Title = {Bovines, buffers and barriers: A social scientific perspective on
   rewilding in the Kavango-Zambezi Transfrontier Conservation Area},
Journal = {CONSERVATION SCIENCE AND PRACTICE},
Year = {2026},
Month = {2026 AUG 11},
Abstract = {Rewilding is an increasingly popular nature conservation strategy
   globally. Originally, the strategy was formulated around the three C's
   of Carnivores, Cores and Corridors, which captured the ecological aim of
   rewilding to restore trophic interactions across large connected
   landscapes. While the three C's have proven to stick in the minds of the
   rewilding community, there is a need to go beyond them and attend also
   to the social aspects of rewilding. In this essay, we therefore offer a
   complementary heuristic framework, with particular applicability to
   Southern Africa's conservation landscapes. Based on our research in the
   Kavango-Zambezi Transfrontier Conservation Area, we propose a framework
   for rewilding that seeks to integrate social aspects by drawing
   attention to cultural keystone species, communal areas adjacent to
   protected areas, and protection by separation. In place of the three
   C's, these features can be summarized as the three B's: Bovines, Buffers
   and Barriers. With these three B's, we aim to shift the focus to what
   happens around the wild ``cores,{''} where cattle roam, and where people
   may desire barriers such as fences to protect themselves and their
   livelihoods from wildlife.},
