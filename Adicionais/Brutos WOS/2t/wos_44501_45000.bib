@article{ WOS:000769164400001,
Author = {Chen, Yiting and Li, Zhanbin and Li, Peng and Zhang, Yixin and Liu,
   Hailiang and Pan, Jinjin},
Title = {Impacts and Projections of Land Use and Demographic Changes on Ecosystem
   Services: A Case Study in the Guanzhong Region, China},
Journal = {SUSTAINABILITY},
Year = {2022},
Volume = {14},
Number = {5},
Month = {MAR},
Abstract = {Land use change and demographic factors directly or indirectly affect
   ecosystem services value, and the analysis of ecosystem services
   contributes to optimization of land planning, which is essential for
   regional sustainable development. In this study, ArcGIS 10.2, IDRISI
   17.0 Selva and MATLAB software, value coefficient method, CA-Markov
   prediction model and population growth model were applied to analyze the
   spatial and temporal changes of land use trends and ecosystem service
   values in Guanzhong region, and further predict the impacts of land type
   changes and population changes on ecosystem services in the context of
   urbanization. Results showed that the expansion of construction land was
   the most intense, and the transfer process mainly crowded out arable
   land; the total ecosystem services value grew spatially in a ``low
   center-high periphery{''} ring with large differences at the bottom, and
   forest land was the most important value provider. The total ecosystem
   services value was estimated to decline in the future, with low-value
   areas spreading northward and differences in the per capita ecosystem
   services value increasing. This study provides a reference for optimal
   simulation of urban expansion and ecological conservation.},
