@article{ WOS:001485519900001,
Author = {Wright, Caradee Y. and Kapwata, Thandi and Kunene, Siyathemba and
   Kwatala, Ngwako and Mahlangeni, Nomfundo and Laban, Tracey and Webster,
   Candice},
Title = {Heat in the transport sector: measured heat exposure and interventions
   to address heat-related health impacts in the minibus taxi industry in
   South Africa},
Journal = {INTERNATIONAL JOURNAL OF BIOMETEOROLOGY},
Year = {2025},
Volume = {69},
Number = {10, SI},
Pages = {2475-2487},
Month = {OCT},
Abstract = {High temperatures, heat and heatwaves are being experienced more
   frequently and with greater intensity in many parts of the world,
   including South Africa, and record-breaking maximum temperatures are
   becoming more common. Exposure to heat has adverse impacts on human
   health and wellbeing. The transport sector and its users are vulnerable
   to heat both inside vehicles as well as in places where people wait for
   public transport. We sought to assess the temperatures experienced in
   minibus taxis, a common mode of transport in South Africa and in minibus
   taxi ranks as well as the heat-related perceptions of minibus taxi
   drivers working in the Chesterville Taxi Association in Durban. We also
   observed heat-related elements in minibus taxi ranks. Data from
   temperature loggers showed that temperatures inside minibus taxis
   reached up to 39 degrees C and were between 3-4 degrees C warmer than
   outdoors. For around 11 h every day, temperatures inside minibus taxis
   were warmer than 27 degrees C - the temperature that is linked to
   heat-health symptoms. Taxi drivers (N = 16) all agreed they feel hot in
   the minibus taxi and more than 90\% said they drink water to try to cool
   down. Taxi ranks were lacking in supply of drinking water and shade for
   minibus taxis and seating. With the projected increase in temperatures
   caused by climate change, it is imperative to co-develop mitigation and
   adaptation strategies to minimise heat-related human health impacts in
   minibus taxis and taxi ranks especially in low- and middle-income
   countries.},
