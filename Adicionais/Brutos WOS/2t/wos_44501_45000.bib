@article{ WOS:000492594700012,
Author = {Meier, H. E. Markus and Dieterich, Christian and Eilola, Kari and
   Groger, Matthias and Hoglund, Anders and Radtke, Hagen and Saraiva,
   Sofia and Wahlstrom, Irene},
Title = {Future projections of record-breaking sea surface temperature and
   cyanobacteria bloom events in the Baltic Sea},
Journal = {AMBIO},
Year = {2019},
