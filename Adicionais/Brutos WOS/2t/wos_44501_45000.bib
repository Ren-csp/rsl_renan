@article{ WOS:000432242000059,
Author = {Muhlemann, Barbara and Jones, Terry C. and Damgaard, Peter de Barros and
   Allentoft, Morten E. and Shevnina, Irina and Logvin, Andrey and
   Usmanova, Emma and Panyushkina, Irina P. and Boldgiv, Bazartseren and
   Bazartseren, Tsevel and Tashbaeva, Kadicha and Merz, Victor and Lau,
   Nina and Smrcka, Vaclav and Voyakin, Dmitry and Kitov, Egor and
