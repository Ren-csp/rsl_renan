@article{ WOS:001843345200004,
Author = {Ali, Mohamed Muhudin and Fodey, Ali Ahmed and Abdulle, Abdikani Yusuf},
Title = {Youth awareness and perceptions of climate change in Southern Somalia},
Journal = {DISCOVER ENVIRONMENT},
Year = {2026},
Volume = {4},
Number = {1},
Month = {AUG 6},
Abstract = {This study investigated youth perceptions of climate change in Southern
   Somalia, focusing on critical role youth play in addressing the region's
   environmental vulnerabilities, including recurrent droughts, flooding,
   and resource scarcity. While global research highlights the importance
   of youth involvement in climate advocacy, their perspectives in Southern
   Somalia remain underexplored. This study investigates youth perceptions
   of climate change in Southern Somalia, a region facing severe climate
   challenges such as recurrent droughts, floods, and resource scarcity.
   The role of youth in addressing these environmental vulnerabilities
   remains underexplored, despite their critical involvement in climate
   advocacy globally. This study aims to fill this gap by assessing youth
   awareness of climate change, their perceptions of human contributions to
   the phenomenon, and the observed impacts on their communities. A
   quantitative survey was conducted with 536 youth aged 15-24, with a
   focus on urban areas, using stratified random sampling to ensure
   demographic diversity. Data analysis revealed moderate to high awareness
   of climate change, with older youth (19-24 years) demonstrating the
   highest levels of understanding. However, 63.0\% of respondents in the
   youth subsample (ages 15-24) expressed skepticism about human
   contributions to climate change, compared with 95.8\% among respondents
   older than 24, highlighting a gap in understanding. Economic
   disparities, despite high educational levels, were identified as
   significant barriers to active youth participation in climate action.
   The findings underscore the need for targeted climate education and
   policies that promote economic opportunities, such as green jobs, to
   empower youth in climate resilience. These results offer valuable
   insights into how socioeconomic conditions influence youth climate
   engagement in fragile, climate-vulnerable regions like Southern Somalia,
   with implications for broader climate adaptation strategies.},
