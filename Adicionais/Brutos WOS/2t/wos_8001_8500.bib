@article{ WOS:001312932900001,
Author = {Zhao, Zhao and Li, Jie and Fu, Zongchi},
Title = {Study on Summer Microclimate Analysis and Optimization Strategies for
   Urban Parks in Xinjiang-A Case Study of Mingzhu Park},
