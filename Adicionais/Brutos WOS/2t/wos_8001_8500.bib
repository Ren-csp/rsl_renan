@article{ WOS:000461800200031,
Author = {Ramyar, Reza and Hayati, Zahra and Saeedi, Saeed and Taj, Mohammad Mahdi},
Title = {Evidence of Poor Environments in Shared Outdoor Spaces of Residential
   Complexes in Iran},
Journal = {POLISH JOURNAL OF ENVIRONMENTAL STUDIES},
Year = {2019},
