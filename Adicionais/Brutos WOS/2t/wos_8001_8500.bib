@article{ WOS:000454961200012,
Author = {Armando Narvaez-Muelas, Diego},
Title = {PRIVATIZATION OF GREEN PUBLIC SPACE IN THE NEOLIBERAL ERA. The
   Tequendama Club in Cali, Colombia},
Journal = {BITACORA URBANO TERRITORIAL},
Year = {2019},
Volume = {29},
Number = {1},
Pages = {121-130},
Month = {JAN-APR},
Abstract = {Since the end of the eighties, the market dynamics that the neoliberal
   model has incorporated in the management, organization and planning of
   cities have put at risk the permanence of green public space. This area
   of great importance for the quality of citizen life has been susceptible
   to transformations that violate the character of public use of these
   places, which has resulted in processes of privatization, loss and
   commodification. In this order, this article seeks to explain through a
   case study, how in the 199os a public green area in Cali is privatized
   by a renowned club. Based on this, it is investigated which actors and
   instruments promoted the privatization of this place. For the analysis,
   this process has as its starting point the current debate on critical
   urban studies, in relation to the way in which neoliberalism has shaped
   cities in favor of mercantile logics, affecting the collective spaces
   that structure the city, putting Evidence of urban tensions concerning
   the control and usufruct of urban land for the account - in this case -
   of groups with sociopolitical power.},
