@article{ WOS:000645325800001,
Author = {Kozlowski, Maciej and Czerepicki, Andrzej and Jaskowski, Piotr and
   Aniszewski, Kamil},
Title = {Analysis of the System of Controlling Paid Parking Zones},
Journal = {SUSTAINABILITY},
