@article{ WOS:001819728700008,
Author = {Kapstein-Lopez, Paula and Wong-Lent, Cristina},
Title = {Healthy cities and ecological corridors. Strategic design of green
   infrastructure system in Piura, Peru},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2026},
Volume = {58},
Number = {228},
Pages = {646-661},
Month = {SUM},
Abstract = {It is developed a proposal of strategic analysis focused on the southern
   area of the peruvian city of Piura (681 605 inhabitants). This area has
   grown rapidly in recent years, although it still retains some
   characteristics of a rural sector, including its agricultural activity.
   This area also has problems of urban and social vulnerability. This work
   raises the scope of the relationship between urban design and health,
   defining a strategic design methodology for green infrastructure
   corridors in Piura, which considers both the characteristics of its
   territory and its strengths, as well as local challenges. The proposal
   gives priority to those sectors of the city that are most socially
   vulnerable, where there is also a shortage of green areas. The network
   of corridors includes natural areas such as the Santa Julia wetlands and
   the Piura river.},
