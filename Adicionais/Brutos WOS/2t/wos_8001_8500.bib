   Yao, Tianning; Sun, Liang; Liao, Pan, China Univ Min \& Technol, Sch Architecture \& Design, Xuzhou 221116, Peoples R China.
   Xu, Yao, Southwest Jiaotong Univ, Sch Architecture, Chengdu 611756, Peoples R China.
   Wang, Jin, Yancheng Inst Technol, Sch Civil Engn, Yancheng 224051, Peoples R China.},
DOI = {10.3390/land13091354},
