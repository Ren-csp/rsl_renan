@article{ WOS:000808461000003,
Author = {Elze, Sebastian and Banzhaf, Ellen},
Title = {High-precision monitoring of urban structures to understand changes in
   multiple ecosystem services},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2022},
Volume = {73},
Month = {JUL},
Abstract = {To safeguard the well-being of urban dwellers, it is vital to restore,
   protect and enhance urban green infrastructures (uGI), their related
   ecosystem services (ES) and the associated benefits for a large number
   of inhabitants. This study maps and monitors land cover between 2012 and
   2018 in the fast-growing German city of Leipzig to produce precise
   information using OBIA and very high-resolution digital orthophotos.
   Based on this, this research pinpoints spatially differentiated multiple
   ES. Research has revealed that essential ES, which comprise regulating,
   socio-cultural and cultural-aesthetic services, have a multifunctional
   impact on the human urban habitat. The study provides insight into each
   ES type by evaluating specific classes of objects within the urban
   environment in a spatially explicit way and at a very high scale of
   resolution. In doing so, it illustrates variations in the provision of
   ES and renders visible disparities in the accessibility to uGI in
   Leipzig. By analysing the number and stands of trees and their
   respective height development, the study confirms that intensive
   management is successfully rejuvenating the urban forest, but also that
   foliage in this forest is suffering from drought. The mapping procedure
   reveals a high spatial and temporal variation in the rates of carbon
   storage. This is also the case for the provision of recreation areas
   which has an impact on the equitable distribution of ES to Leipzig's
   inhabitants. Residential areas with a relatively high uGI on the
   outskirts of the city actually register lower market rents and rent
   growth rates than in those districts which lie closer to the city centre
   and have a comparably lower uGI. Thus, market rents and uGI have become
   decoupled in the fast growing city. In order to ensure and maintain the
   well-being of all residents in a fair way, fast growing cities like
   Leipzig must make even greater efforts in urban planning.},
Publisher = {ELSEVIER GMBH},
Address = {HACKERBRUCKE 6, 80335 MUNICH, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Banzhaf, E (Corresponding Author), UFZ Helmholtz Ctr Environm Res, Dept Urban \& Environm Sociol, Permoserstr 15, D-04318 Leipzig, Germany.
   Elze, Sebastian; Banzhaf, Ellen, UFZ Helmholtz Ctr Environm Res, Dept Urban \& Environm Sociol, Permoserstr 15, D-04318 Leipzig, Germany.},
DOI = {10.1016/j.ufug.2022.127616},
EarlyAccessDate = {MAY 2022},
Article-Number = {127616},
ISSN = {1618-8667},
EISSN = {1610-8167},
Keywords = {OBIA; 3-D mapping; Tree-crown height; Carbon storage; Market rents;
   Recreation areas},
