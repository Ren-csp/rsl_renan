@article{ WOS:000455842600008,
Author = {Evelyn Birche, Mariana and Cecilia Jensen, Karina},
Title = {THE SURVEY AND CATALOGUING OF PUBLIC-USE GREEN SPACES IN THE CITY OF LA
   PLATA, ARGENTINA},
