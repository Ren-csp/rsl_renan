@article{ WOS:001231461900001,
Author = {Lee, Woohyoung and Choi, Dong Hee and Kang, Dong Hwa},
Title = {Discrepancies of Functional Requirements of Façade Opening System
   between Real-Life Public and Built Environment Experts Focusing on
   Thermal Comfort and Ventilation},
Journal = {SUSTAINABILITY},
Year = {2024},
Volume = {16},
Number = {10},
Month = {MAY},
Abstract = {A survey was conducted to analyze the discrepancies of the functional
   requirements of the fa \& ccedil;ade system in residential units among
   605 of the real-life public and 73 experts. Personal and housing
   information, resident life patterns, public fa \& ccedil;ade usage
   behavior, and functional requirements were collected from the
   respondents. Both the public and experts recognized insulation as the
   main function of fa \& ccedil;ade opening systems. More than 85\% of the
   public and experts opened windows for ventilation, but ventilation was
   ranked 3rd amongst the public and 4th amongst experts in the main
   functions list of fa \& ccedil;ade systems. The public cited the inflow
   of fine dust as the main reason for dissatisfaction with opening
   windows. In contrast, the experts cited a decrease in thermal comfort
   due to the inflow of external moisture as the reason for dissatisfaction
   with opening windows. The results showed that discrepancies exist
   between the public and experts' perceptions of the main function of
   housing fa \& ccedil;ade systems. Analyzing the common points and
   differences between the public and experts' perception can help in
   developing fa \& ccedil;ade system design and control technology.},
