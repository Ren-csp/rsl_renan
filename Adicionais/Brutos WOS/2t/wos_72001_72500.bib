@article{ WOS:001826195100001,
Author = {Fosso-Kankeu, Elvis and Masindi, Vhahangwele and Muedi, Khathutshelo L.
   and Nguegang, Beauclair and Maree, Johannes P. and Mamba, Bhekie B. and
   Foteinis, Spyros},
Title = {Pragmatic synthesis of struvite from municipal wastewater and its use
   for the recovery of lanthanum from acid mine drainage},
Journal = {JOURNAL OF HAZARDOUS MATERIALS ADVANCES},
Year = {2026},
Volume = {23},
Month = {AUG},
Abstract = {Wastewater often carries a strong negative perception due to the
   different contaminants it harbours, such as (heavy) metals, pathogens,
   and nutrients. Yet, when viewed under the circular economy lens, it is
   an important resource that can underpin circularity and sustainability.
   Here, the integrated treatment of municipal wastewater (MWW) and acid
   mine drainage (AMD) is examined through cascading resource recovery.
   This was achieved through the green synthesis of struvite (MgNH4PO4 \&
   sdot;6H2O) from MWW and its subsequent use for the recovery of lanthanum
   (La), a proxy for rare earth elements (REEs), from coal AMD. The effect
   of struvite dosage and pH manipulation was examined, with 9.1 g/L of
   struvite at pH 5 practically (similar to 100\%) removing La from AMD,
   highlighting the high affinity of phosphate (PO4) towards La and REEs in
   general. This interaction leads to insoluble lanthanum phosphate (LaPO4)
   formation, along with secondary reactions with other struvite
   components, such as magnesium (Mg), towards Mg-La-phosphates synthesis
   and precipitation through pH increase. However, the co-precipitation of
   other metals and nonmetals, such as iron (Fe), manganese (Mn), and
   aluminium (Al) and sulphate (SO4), can affect La purity. To ascertain
   the fate of La, the REEs-rich product sludge was characterised using
   FE-SEM, SEM-EDX, FTIR, XRD, EDX, and XRF, and results suggest that La,
   and therefore REEs, removal from AMD is feasible when using eco-friendly
   struvite. By and large, this will go a long way in reducing ecological
   footprints associated with both MWW and AMD, while presenting gross
   avenues for the removal and beneficiation of the wastewater stream and
   closed-loop systems.},
