@article{ WOS:000787274100001,
Author = {Favela, Alonso and Bohn, Martin and Kent, Angela},
Title = {N-Cycling Microbiome Recruitment Differences Between Modern and Wild
   Zea mays},
Journal = {PHYTOBIOMES JOURNAL},
