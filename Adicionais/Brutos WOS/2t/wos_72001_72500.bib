@article{ WOS:001380511300001,
Author = {Miyaji, Tomoko and Yamagami, Ayumi and Nakamura, Yusuke and Nishida,
   Kaisei and Tachibana, Ryo and Surina, Surina and Fujioka, Shozo and
   Garcia-Hourquet, Mariano and Mora-Garcia, Santiago and Nosaki, Shohei
