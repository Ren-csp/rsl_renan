@article{ WOS:000808482200001,
Author = {Temple, Henry and Phyo, Pyae and Yang, Weibing and Lyczakowski, Jan J.
   and Echevarria-Poza, Alberto and Yakunin, Igor and Parra-Rojas, Juan
   Pablo and Terrett, Oliver M. and Saez-Aguayo, Susana and Dupree, Ray and
