@article{ WOS:000464932900029,
Author = {Day, Casey C. and McCann, Nicholas P. and Zollner, Patrick A. and
   Gilbert, Jonathan H. and MacFarland, David M.},
Title = {Temporal plasticity in habitat selection criteria explains patterns of
   animal dispersal},
Journal = {BEHAVIORAL ECOLOGY},
