@article{ WOS:000477614100001,
Author = {Kalafatis, Scott E. and Neosh, Jasmine and Libarkin, Julie C. and Whyte,
   Kyle Powys and Caldwell, Chris},
Title = {Experiential Learning Processes Informing Climate Change Decision
   Support},
Journal = {WEATHER CLIMATE AND SOCIETY},
