@article{ WOS:000337251900045,
Author = {Kramer, Randall A. and Mboera, Leonard E. G. and Senkoro, Kesheni and
   Lesser, Adriane and Shayo, Elizabeth H. and Paul, Christopher J. and
   Miranda, Marie Lynn},
Title = {A Randomized Longitudinal Factorial Design to Assess Malaria Vector
   Control and Disease Management Interventions in Rural Tanzania},
