Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Baptista, JS (Corresponding Author), Univ Porto, Fac Engn, Associated Lab Energy Transports \& Aerosp LAETA PR, P-4200465 Porto, Portugal.
