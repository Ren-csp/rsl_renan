@article{ WOS:000812483600006,
Author = {Chen, Chao and Feng, Tao and Gu, Xiaoning},
Title = {Role of latent factors and public policies in travel decisions under
   COVID-19 pandemic: Findings of a hybrid choice model},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2022},
Volume = {78},
Month = {MAR},
Abstract = {Policy measures to control the spread of COVID-19 imposed by different
   countries have a devastating impact on people's travel behaviors.
   Differing from the normal situation where general concerns on travel
   time and cost determine the travel choices, the uncertainty underlying
   behavior change in the case of a pandemic might be largely attributed to
   the latent aspects, i.e., social responsibility, risk perception,
   attitudes, which could diminish the effects of main attributes on travel
   decisions. Therefore, this paper examines the effects of COVID-19
   related policies on individuals' travel choices influenced by the latent
   aspects. A stated choice experiment was designed to collect people's
   responses under policy measures to various transportation modes. Results
   of a hybrid choice model show that COVID-19 related policies
   significantly affect individuals' transportation mode choice decisions
   during pandemic situations. The attributes, like travel time and travel
   cost, which significantly impact travel behavior in normal situations,
   become less relevant. Moreover, the travel preferences during the
   pandemic are significantly associated with latent factors of social
   responsibility, fear of infection, perceived risk, and travel anxiety.
   In general, public transportation is identified as an insecure
   alternative compared with other private modes, and people who are more
   socially responsible tend to travel less during the pandemic. Outcomes
   of this study could be of value to policymakers and public health
   emergencies, e.g., government authorities to utilize such knowledge in
   providing social support for these COVID-19 countermeasures and
   designing customized policies for specific population groups.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Feng, T (Corresponding Author), Hiroshima Univ, Urban \& Data Sci, Grad Sch Adv Sci \& Engn, Higashihiroshima 7398511, Japan.
   Chen, Chao; Gu, Xiaoning, Dalian Univ Technol, State Key Lab Struct Anal Ind Equipment, Sch Automot Engn, Dalian 116024, Peoples R China.
   Feng, Tao, Hiroshima Univ, Urban \& Data Sci, Grad Sch Adv Sci \& Engn, Higashihiroshima 7398511, Japan.
   Feng, Tao; Gu, Xiaoning, Eindhoven Univ Technol, Urban Planning \& Transportat, Dept Built Environm, NL-5600 MB Eindhoven, Netherlands.},
DOI = {10.1016/j.scs.2021.103601},
Article-Number = {103601},
ISSN = {2210-6707},
