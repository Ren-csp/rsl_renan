@article{ WOS:000688783000001,
Author = {Alves, Sonia Guimaraes and Gaglianone, Maria Cristina},
Title = {Bee Guilds' Responses to Urbanization in Neotropics: A Case Study},
Journal = {DIVERSITY-BASEL},
