@article{ WOS:000644302200010,
Author = {Ribeiro, Jefferson and Vieira, Rafaela and Correia, Luciana Schramm},
Title = {Analysis about socialization of experiences in Junior Civil Defense
   Agent project at Blumenau / SC through environmental education},
Journal = {REMEA-REVISTA ELETRONICA DO MESTRADO EM EDUCACAO AMBIENTAL},
Year = {2021},
Volume = {38},
