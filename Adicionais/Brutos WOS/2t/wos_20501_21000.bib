@article{ WOS:001668161400002,
Author = {Young, Julie K. and Kays, Roland and Green, Austin M. and Moll,
   Remington J. and Schultz, Jeffrey T. and Benson, John F. and
   Benson-Amram, Sarah and Brown, Justin and Cahal, Grayson and Carr,
   Benjamin S. and Cepek, Jonathon D. and Davis, Emily and Dougherty, Kyle
   D. and Gallo, Travis and Gehrt, Stan D. and Goode, Kaitlin O. and Grace,
   Trayl and Henling, Molly and Himes, Lucian and Keller, Stephanie and
   Kohl, Michel T. and Lapoint, Scott and Monzon, Javier and Nagy,
   Christopher and Palmer, Emma and Prugh, Laura R. and Raber, Sam and
   Ritzel, Kate and Riley, Seth P. D. and Schell, Christopher J. and
   Sekercioglu, Cagan H. and Stanton, Lauren and Breck, Stewart W.},
Title = {Large-scale experimental assessment of coyote behavior across urban and
   rural landscapes},
Journal = {SCIENTIFIC REPORTS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {DEC 17},
Abstract = {Carnivores must navigate the complexities of human modifications to
   their environment. Natural resources and biodiversity decline in urban
   areas, while people in rural areas often pose greater direct risk
   through actions such as hunting. To evaluate if carnivore populations
   adapt their behavior to local risks in rural and urban environments, we
   compared behavioral responses to novel objects in coyotes (Canis
   latrans). We placed an attractant at arrays of 30 camera-trap stations
   at 16 pairs of urban and rural field sites across the USA, with a novel
   object placed at half of the stations. Coyotes exhibited more cautious
   behavior and remained farther from the attractant at all sites with the
   novel object; however, urban coyotes got closer to the attractant than
   rural coyotes. There were few behavioral differences between urban and
   rural coyotes and none between eastern and western coyotes. Coyotes
   across the USA exhibit neophobic behavior but urban coyotes, especially
   western coyotes, are willing to take more risk (i.e., be closer to the
   attractant). The consistency in most metrics of coyote behavior suggest
   that solutions developed in one area could be universally useful. This
   study also demonstrates the effectiveness of a large, collaborative
   approach to studying broad-scale patterns in behavioral traits.},
