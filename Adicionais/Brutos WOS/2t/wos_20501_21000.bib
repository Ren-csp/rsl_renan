@article{ WOS:000769273500001,
Author = {Ciprari, Eleonora and Ancillotto, Leonardo and Mori, Emiliano and
   Studer, Valentina and Chessa, Chiara},
Title = {Rescue data as an alternative for assessing trends and phenological
   changes in two invasive parakeet species},
Journal = {URBAN ECOSYSTEMS},
