@article{ WOS:001854156400001,
Author = {Anagnostou, Michelle and Hubschle, Annette and Doberstein, Brent and
   Hinsley, Amy and Arroyo-Quiroz, Ines and Spencer, Craig and Stoett,
   Peter and Wong, Rebecca W. Y.},
Title = {Expert perceptions on women's involvement in illegal wildlife trade
   networks},
Journal = {AMBIO},
Year = {2026},
Month = {2026 AUG 20},
Abstract = {Illegal wildlife trade is often male dominated at harvest, yet women's
   roles across supply chains are under-examined. This study adds
   substantially to this growing body of knowledge drawing on 112
   semi-structured interviews with law enforcement and illegal wildlife
   trade experts in South Africa, Hong Kong, and Canada. We show women
   participate in finance and money laundering, brokerage, logistics,
   retail, online marketing, and couriering, with occasional leadership.
   Women are also strategically used to shield men. Drawing on conservation
   and feminist criminology-specifically women's liberation and
   strain/marginalization perspectives-alongside an intersectional
   framework, we interpret role differentiation across contexts. While
   perceptions-based data and male-dominated enforcement may bias
   visibility, patterns are consistent. We recommend gender-competent,
   intersectional counter-illegal wildlife trade strategies and better
   gender-disaggregated data.},
