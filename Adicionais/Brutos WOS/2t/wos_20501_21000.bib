@article{ WOS:001362639500001,
Author = {Lee, Hunter and Perry, Elizabeth E. and Sene-Harper, Aby},
Title = {Moving beyond `fragment of stories' and `segregated narratives':
   descendants' perspectives at Arlington House, a former plantation},
Journal = {JOURNAL OF HERITAGE TOURISM},
Year = {2025},
Volume = {20},
Number = {3},
Pages = {364-379},
Month = {MAY 4},
Abstract = {Arlington House, the Robert E. Lee Memorial (Confederate general in the
   American Civil War), is a former plantation site located in Washington,
   DC, USA. The National Park Service (NPS) has managed this site since
   1933. Arlington House is a cultural and historical heritage site that
   has a layered and complex history. Onsite interpretation at Arlington
   House (e.g. information placards, ranger interactions) has shifted
   recently from interpreting solely the story of Lee to also relating the
   lives of the formerly enslaved peoples. We conducted focus groups to
   understand how descendants of the enslaved Africans have received this
   shift. Though fuller interpretation has been added, many descendants
   felt it lacks detail in comparison with Lee's exhibits. Specifically, we
   synthesized insights from the descendants about the lack of a cohesive,
   comprehensive narrative; the need to challenge the enslaver's narrative;
   and specific areas for the NPS to reconsider their efforts. This relates
   to larger conversations about cultural heritage plantation sites and the
   evolution of interpretation at such sites. By incorporating insights
   from those with direct ties to heritage plantations, managers could
   ensure a more representative and complete place narrative that
   incorporates the values of descendants to increase visitor relevance.},
