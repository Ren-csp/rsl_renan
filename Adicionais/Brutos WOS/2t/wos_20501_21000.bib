@article{ WOS:001163760300001,
Author = {Marvaniya, Karan and Dobariya, Priyanka and Maurya, Ashish and Patel,
   Ketan and Kushwaha, Shilpi},
Title = {Epitaxially Grown Mechanically Robust 2D Thin Film of Secondary
   Interactions Led Molecularly Woven Material},
