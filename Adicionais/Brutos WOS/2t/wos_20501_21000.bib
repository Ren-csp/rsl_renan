@article{ WOS:000947973100001,
Author = {Arifin, Taslim and Amri, Syahrial Nur and Rahmania, Rinny and Yuliusa
   and Ramdhan, Muhammad and Chandra, Handy and Adrianto, Luky and Bengen,
   Dietriech Geoffrey and Kurniawan, Fery and Kurnia, Rahmat},
Title = {Forecasting land-use changes due to coastal city development on the
   peri-urban area in Makassar City, Indonesia},
Journal = {EGYPTIAN JOURNAL OF REMOTE SENSING AND SPACE SCIENCES},
Year = {2023},
Volume = {26},
