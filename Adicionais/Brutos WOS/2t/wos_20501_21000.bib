@article{ WOS:001842263500002,
Author = {Gosling, Marlusa de Sevilha},
Title = {Transformative Service Research and Well-being in Urban Collective
   Spaces: Testing a New Model},
Journal = {TOURISM \& MANAGEMENT STUDIES},
Year = {2026},
Volume = {22},
Number = {3},
Pages = {49-63},
Abstract = {Urban public squares are everyday service settings with the potential to
   transform citizens' wellb-eing, yet they remain largely absent from
   Transformative Service Research (TSR). This study aims to develop and
   validate a model of the antecedents of personal transformation and
   intention to return in urban collective spaces, using the public squares
   of Belo Horizonte, Brazil, as the empirical setting. Drawing on TSR and
   on the urban green space literature, the model integrates perceived
   quality, experience, mindfulness, learning and well-being as drivers of
   transformation and revisit intention. Survey data from 2,062 square
   users were analysed with partial least squares structural equation
   modelling (PLS-SEM). All fifteen hypothesised relationships were
   supported: perceived quality and mindfulness enhance experience and
   learning, which foster well-being and, ultimately, personal
   transformation and the intention to return. Theoretically, the study
   extends TSR to mundane, non-commercial public services and offers
   context-specific measures for squares. Managerially, it shows that
   investments in infrastructure, safety and experiences that stimulate
   affective memory and learning can improve citizens' health, engagement
   and healthier lifestyles.},
