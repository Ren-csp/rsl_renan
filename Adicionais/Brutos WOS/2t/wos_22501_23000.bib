@article{ WOS:000186456700010,
Author = {Wolf, J and van Wijk, MS and Cheng, X and Hu, Y and van Diepen, CA and
   Jongbloed, AW and van Keulen, H and Lu, CH and Roetter, R},
Title = {Urban and peri-urban agricultural production in Beijing municipality and
   its impact on water quality},
Journal = {ENVIRONMENT AND URBANIZATION},
Year = {2003},
Volume = {15},
Number = {2},
Pages = {141-156},
Month = {OCT},
Abstract = {This paper reviews water use and water resource issues in Beijing
   Municipality, the main trends in the agricultural production systems in
   and around the city with respect to land use, input use, production and
   economic role, and the impacts of agricultural activities on water
   quality. Rapid urbanization and strong intensification of agricultural
   production have meant that the quantity and quality of available water
   resources have become matters of concern. The agricultural sector still
   has a major role in supplying the municipality's population with food
   products, but it is also a major water user and has contributed to large
   gaps between water supply and demand and to high levels of water
   pollution. Among the main changes in agriculture in the last decade are
   the loss of arable land to urbanization, the rapid reduction in the area
   under grain, and the rapid increase in livestock numbers and in areas
   under vegetables and orchards. Intensive crop and vegetable production
   and intensive livestock rearing are major water polluters. The paper
