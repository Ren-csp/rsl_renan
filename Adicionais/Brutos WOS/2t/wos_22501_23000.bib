@article{ WOS:001253109800002,
Author = {Sundararaj, S. Santhana Iyyappa and Chandramathy, I. and Jeykumar, R. K.
   C. and Chandramohan, K.},
Title = {Urbanizational impact on climatic variables and geographical analysis of
   physical land use land cover variation of a city using remote sensing},
Journal = {GLOBAL NEST JOURNAL},
