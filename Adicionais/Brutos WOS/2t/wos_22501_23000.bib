@article{ WOS:001818810700009,
Author = {Eguchi, Yuya and Tsumori, Kaito and Tsujino, Takumi and Yajima, Hiroki
   and Funakoshi, Yumi and Shimamoto, Tatsuki and Nitta, Kozue and
   Katahira, Hirotaka},
Title = {Organisms associated with nests of the invasive squirrel Callosciurus
   erythraeus (Pallas, 1779): an overlooked arboreal habitat for urban
   pests},
Journal = {BIOINVASIONS RECORDS},
Year = {2026},
Volume = {15},
Number = {2},
Pages = {325-338},
Month = {JUN},
Abstract = {The nests of wild animals serve as habitats for a diverse range of
   organisms. Depending on the constructors, these nests can occur in urban
   environments and provide potential shelters for pest organisms harmful
   to human health and activities. In this context, we collected arboreal
   nests of Pallas's squirrel Callosciurus erythraeus, a non-native species
   that has invaded urban areas in the Kanto region of Japan, and examined
   their materials and associated biota. Nine nests collected from an urban
   green space in Kanagawa Prefecture in January 2022 were found to have
   one-to three-layered structures constructed using plant species from 10
   orders. The inner layers were primarily composed of fibers of
   Cryptomeria japonica and Trachycarpus fortunei, whereas the outer layers
   consisted of twigs and leaves of Padus sp. and Castanopsis sieboldii,
   with leaves of Prunus buergeriana and Quercus glauca used for
   intermediate layers. From these nests, we recovered 1,467 invertebrates
   in 14 orders, with an average of 8.2 (5-11) orders and 163.0 (36-314)
   individuals per nest. Dipterans (n = 355) were the most abundant,
   followed by collembolans (n = 261), acarids (n = 235), and psocids (n =
   226). Several dipterans were recognized as urban pests, including phorid
   flies, muscid houseflies, and drosophilid fruit flies associated with
   discomfort, food contamination, and pathogen transmission. In addition,
   we genetically identified larvae of a non-native noctuid moth,
   suggesting that the nests may provide suitable microhabitats for
   additional alien species. These findings support our assumption that the
   nests of invasive squirrels show distinctive plant use and serve as
   microhabitats for diverse and harmful fauna. Given that Pallas's
   squirrel populations are insufficiently controlled in many invaded
   areas, the number of such nests is likely to increase. We therefore
   recommend that eradication programs address not only the squirrels but
   also their nests as potential sources of urban pests.},
