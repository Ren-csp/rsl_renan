@article{ WOS:000464612800007,
Author = {Regina, Fasola},
Title = {THE SCIENTIFIC ARGUMENT CONCERNING THE ESTABLISHMENT OF MIXED NATURAL
   MONUMENT IN THE REPUBLIC OF MOLDOVA},
