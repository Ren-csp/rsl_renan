@article{ WOS:000697154100008,
Author = {Carnemolla, Phillippa and Debono, Deborah and Hourihan, Fleur and Hor,
   Suyin and Robertson, Hamish and Travaglia, Jo},
Title = {The influence of the built environment in enacting a household model of
   residential aged care for people living with a mental health condition:
   A qualitative post-occupancy evaluation},
Journal = {HEALTH \& PLACE},
Year = {2021},
Volume = {71},
Month = {SEP},
Abstract = {This study undertakes a spatial analysis of an Australian aged care
   setting where residents receive person-centred support in a
   specially-designed home-like environment. Focus groups were conducted
   with staff to explore the impact of the built environment in a new
   residential aged care setting that has implemented a Household Model of
   care for people living with mental health conditions. Drawing on
   Actor-Network Theory and proxemics, we mapped how the built environment
   supports improved behaviours and care practices in four areas: food
   preparation and dining, sleep and self-care, site layout, and
   relationships.},
