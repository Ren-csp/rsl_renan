@article{ WOS:001668893000003,
Author = {Naghadeh, Faraz Badali and Cagiltay, Kursat},
Title = {Development and Usability of a Location-based Game},
Journal = {INTERACTION DESIGN AND ARCHITECTURES},
Year = {2025},
Number = {65},
Pages = {62-89},
Month = {SUM},
Abstract = {Location-based games (LBG) incorporate players' location as their main
   game element. Therefore, they are played in the physical world by
   turning every place into a playground. Due to the pervasive nature of
   LBGs, usability evaluation can differ from the other game genres. This
   study aims to develop an LBG based on a university campus by
   implementing a criteria-based method to populate the map and distribute
   points of interest. Ten participants tested the developed game, and a
   qualitative analysis was conducted via holding interviews with each
   participant to evaluate the game's usability and identify usability
   issues specific to the developed LBG and LBGs in general. The findings
   show that participants showed a positive attitude towards the game;
   however, multiple issues were identified regarding the LBGs. These
   usability issues are the inaccuracy of the map in representing the
   points, the radius of interaction, and location update delay.},
