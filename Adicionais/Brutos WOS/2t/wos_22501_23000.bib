@article{ WOS:000222385500003,
Author = {Marshall, BK},
Title = {Gender, race, and perceived environmental risk: The ``white male{''}
   effect in cancer alley, La},
Journal = {SOCIOLOGICAL SPECTRUM},
Year = {2004},
Volume = {24},
Number = {4},
Pages = {453-478},
Month = {JUL-AUG},
Abstract = {Research on risk perceptions are replete with race- and gender-specific
   hypotheses attempting to account for attitudinal variation. However,
   race and gender differences may mask more notable patterns across
   subgroups, patterns that lie at the intersection of race and gender.
   Recent national studies suggest that being a White male leads to lower
   risk perceptions and greater willingness to accept risks. This article
   extends this research by examining the ``White male{''} effect in a
   chronically polluted context, an area where industrial pollution is
   palpable and well-documented. Data are drawn from a survey of a
   population living in ``Cancer Alley,{''} a stretch of the Mississippi
   River from Baton Rouge to New Orleans. We find that women more than men
   and Blacks more than Whites perceive environmental risks as serious.
   Further, evidence suggests that these differences are mostly due to the
   relatively extreme perceptions of risk accepting White males and risk
   adverse Black females. After controlling for select variables in
   hierarchical multiple regression analyses, being a White male or Black
   female still has a statistically significant impact on risk perceptions.},
