Author = {Pozo-Menendez, Elisa and Santos-Hernandez, Maria Soledad and
   Bacho-Del-Saz, Nuria and Bentue-Gomez, Lucia},
Title = {Methodology for creating meeting places and well-being for older people.
   Urban design criteria for a new perspective on old age},
Journal = {CIUDAD Y TERRITORIO-ESTUDIOS TERRITORIALES-CYTET},
Year = {2026},
Volume = {58},
Number = {228},
Pages = {662-685},
Month = {SUM},
Abstract = {This article summarises the work carried out to produce the guide
   `Environments for Older People', an urban design manual based on five
   pilot projects in different districts of Madrid City Council's Municipal
   Centres for Older People and Day Centres. The methodology includes a
   series of public space indicators such as accessibility, connectivity,
   signage and orientation, perceived safety, comfort and proximity to
   green areas or other facilities, among others. The participation of
   older people was key to validating the technical analyses and completing
   the proposals for the renovation of public spaces. As a result, one of
   the pilot projects is presented with the proposals put forward, as well
   as the key points of the urban design manual that has been developed
   with the criteria and elements necessary for the creation of meeting and
   socialisation places for the promotion of health.},
