@article{ WOS:001565910800002,
Author = {Liao, Zhouyang and Shen, Xuemei and Zhang, Jinlu and Zhu, Mi and Deng,
   Zhongjian and Liu, Fang and Huang, Zachary Y. and Zhang, Yuan},
Title = {Vegetation coverage and land imperviousness in urban area jointly affect
   hymenopteran pollinator diversity and spatial pattern},
Journal = {ECOLOGICAL INDICATORS},
Year = {2025},
Volume = {178},
Month = {SEP},
Abstract = {With the rapid advancement of global urbanization, insect pollinators
   are confronted with significant challenges. Urbanization typically
   alters both land imperviousness and vegetation coverage concurrently.
   While previous studies have examined the individual impacts of these
   factors on pollinators, the combined effects resulting from their
   interaction remain poorly understood. Our study delineated an
   urbanization gradient in Kunming and established sampling plots at each
   level of this gradient. Over a continuous 24-month field survey period,
   we systematically collected data on hymenopteran pollinators across
   different urbanization levels in Kunming, China. Land imperviousness and
   vegetation coverage for each sampling plot were quantified through field
   investigations and ArcGIS analysis. The impacts of these factors on the
   diversity and distribution patterns of hymenopteran pollinators were
   comprehensively analyzed using generalized linear models and redundancy
   analysis. We found that vegetation coverage was the primary determinant
   of hymenopteran pollinator richness. The abundance of hymenopteran
   pollinators was influenced by the interaction between land
   imperviousness and vegetation coverage, with different families
   exhibiting distinct responses to this interaction. Furthermore, an
   increase in impervious surface led to homogenization of hymenopteran
   pollinator communities, while increased vegetation coverage promoted
   greater community heterogeneity. These findings indicate that for urban
   pollinator diversity conservation, it is crucial to comprehensively
   evaluate the effects of land imperviousness and vegetation coverage on
   pollinators, as well as their distinct impacts on various taxa.
   Implementing science-based urban green design and management strategies
   can significantly enhance urban pollinator diversity and stability.},
