@article{ WOS:000262796100016,
Author = {Scammell, Madeleine Kangsen and Senier, Laura and Darrah-Okike, Jennifer
   and Brown, Phil and Santos, Susan},
Title = {Tangible evidence, trust and power: Public perceptions of community
   environmental health studies},
Journal = {SOCIAL SCIENCE \& MEDICINE},
