@article{ WOS:001766742200001,
Author = {Jeong, Jinyong},
Title = {Digital parking assignment: matching mechanism design approach},
Journal = {DIGITAL ECONOMY AND SUSTAINABLE DEVELOPMENT},
Year = {2025},
Volume = {3},
Number = {1},
Month = {JAN 6},
Abstract = {In this paper, we conceptualize parking in urban areas as a matching
   problem. We begin by formulating street parking behavior as a strategic
   game and develop a matching framework for this scenario. We demonstrate
   that the set of Nash equilibria in the parking game directly corresponds
   to the set of stable outcomes in the associated matching problem.
   Subsequently, we propose a centralized mechanism designed to allocate
   available parking spaces to drivers in a stable manner, facilitated
   through a digital platform, such as a mobile application. This mechanism
   can accommodate various practical needs by establishing a priority
   structure that may include distance priority, price priority, or
   resident priority.},
