@article{ WOS:001560894800001,
Author = {Wolff, Erich and Natakun, Boonanan and Marome, Wijitbusaba and Chew,
   Gavin and Tang, Kean Seng and Hamel, Perrine},
Title = {Nature for the people, by the people: Negotiating values, attitudes and
   behaviours for implementing urban nature-based solutions in social
   housing},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2025},
Volume = {112},
Month = {OCT},
Abstract = {Nature-positive initiatives have emerged as a promising strategy to make
   urban areas more biodiverse and liveable in the 21st century. There are,
   however, many gaps in our understanding of the motivations and
   mechanisms through which grassroots urban greening practices emerge in
   cities, in particular in understudied social housing programmes. We
   examine 38 interviews conducted with residents of social housing
   developments in Bangkok, Thailand, to create a typology of attitudes and
   values that reflect how people conceptualise, implement and maintain
   urban nature. Our analysis further identifies five main types of
   behaviours that characterise how urban nature is negotiated within
   communities. Using the Urban Nature Futures Framework, we provide
   insights into how local priorities and decision-making processes can be
   integrated into the planning of urban nature. Building upon growing
   debates on climate justice, we examine how these behaviours can
   influence the implementation of nature-based solutions and climate
   adaptation projects in understudied contexts in the Global South.},
