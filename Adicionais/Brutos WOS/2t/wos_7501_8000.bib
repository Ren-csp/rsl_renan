@article{ WOS:001607076200001,
Author = {Shi, Yuanyuan and Yin, Chun and Long, Yingying and Wen, Jing and Fan,
   Lingyun},
Title = {Residential preferences and purpose-specific walking behaviors:
   Mediation effects of built environments},
Journal = {TRANSPORTATION RESEARCH PART D-TRANSPORT AND ENVIRONMENT},
Year = {2025},
Volume = {149},
Month = {DEC},
Abstract = {Residential preferences play a crucial role in shaping walking
   behaviors; however, limited literature has examined how residential
   preferences for specific built environment characteristics relate to
   walking for different purposes and the potential mediation effects of
   built environments in these associations. This study employs a path
   analysis model with data from 1,050 adult participants in Shanghai,
   China, to investigate the interrelationships among residential
   preferences, objective and perceived built environment characteristics,
   and walking behaviors across different purposes. After controlling
   socio-demographics, walking preferences, and the built environment, the
   findings suggest that preferences for transit accessibility and building
   density are positively linked to commuting and errand walking,
   respectively, whereas a preference for street connectivity is negatively
   related to leisure walking. Moreover, residential preferences influence
   commuting walking through objective and perceived characteristics of
   built environments, while their impacts on errand and leisure walking
   are mediated exclusively by perceived built environment features.},
