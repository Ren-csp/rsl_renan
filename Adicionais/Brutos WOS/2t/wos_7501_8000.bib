   Raeuchle, Charlotte, Free Univ Berlin, Inst Geog Sci, Dept Earth Sci, D-12249 Berlin, Germany.},
DOI = {10.17645/up.v6i1.3475},
ISSN = {2183-7635},
Keywords = {encounter; neighbourhoods; real-world experiment; real-world lab; social
   cohesion; urban planning},
Keywords-Plus = {LABORATORIES; ROLES; CITY},
Research-Areas = {Urban Studies},
