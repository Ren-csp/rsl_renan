@article{ WOS:001768624400001,
Author = {Cordeiro, Antonio M. Rochette and Lameiras, Jose Miguel},
Title = {Building urban climate resilience through high-resolution UAV
   thermography: Lessons from Coimbra (Portugal)},
Journal = {URBAN CLIMATE},
Year = {2026},
Volume = {67},
Month = {JUN},
Abstract = {Fine-scale thermal dynamics in medium-sized cities remain underexplored
   despite growing evidence of urban overheating. This study examines
   neighbourhood-scale surface thermal patterns and their coupling with
   near-surface air temperature in Coimbra, Portugal, using high-resolution
   unmanned aerial vehicle (UAV) thermal infrared remote sensing combined
   with synchronised in situ microclimatic measurements. Thermal imagery
   was acquired on a clear summer afternoon at sub-metre resolution
   (similar to 0.10-0.20 m), mapping land surface temperature (Ts) across
   three contrasting sectors: a dense historic corridor, a mixed
   recreational area, and a continuous green-blue riverfront corridor.
   UAV-derived Ts data were synchronised with air temperature (Ta)
   measurements at pedestrian height. Results reveal pronounced spatial
   heterogeneity, with Ts differences exceeding 20 degrees C over short
   distances and maximum values above 50 degrees C on exposed impervious
   and synthetic surfaces. Vegetated and river-adjacent areas were 10-15
   degrees C cooler than dense built-up zones. A strong overall Ts-Ta
   relationship was observed (R-2 = 0.67), but coupling was substantially
   attenuated in the vegetated riverfront sector (R-2 = 0.54; slope = 0.26)
   due to shading, evapotranspiration, and modified energy partitioning.
   These findings show that medium-sized cities can display thermal
   contrasts comparable to larger metropolitan areas and highlight the role
   of continuous green-blue infrastructure in moderating urban thermal
   conditions. The study demonstrates the value of UAV thermography for
   resolving microclimatic variability at pedestrian scales. Urban planners
   and municipal authorities should prioritise the preservation, expansion,
   and connectivity of green-blue corridors as a cost-effective approach to
   reducing surface heat exposure and improving thermal resilience.},
