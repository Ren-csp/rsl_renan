@article{ WOS:000410811900001,
Author = {Wu, Jinjin and Capelli, Paolo and Bouvier, Julien and Goulding, Martyn
   and Arber, Silvia and Fortin, Gilles},
Title = {A VO core neuronal circuit for inspiration},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {SEP 15},
Abstract = {Breathing in mammals relies on permanent rhythmic and bilaterally
   synchronized contractions of inspiratory pump muscles. These motor
   drives emerge from interactions between critical sets of brainstem
   neurons whose origins and synaptic ordered organization remain obscure.
   Here, we show, using a virus-based transsynaptic tracing strategy from
   the diaphragm muscle in the mouse, that the principal inspiratory
   premotor neurons share VO identity with, and are connected by, neurons
   of the preBotzinger complex that paces inspiration. Deleting the
   commissural projections of VOs results in left-right desynchronized
   inspiratory motor commands in reduced brain preparations and breathing
   at birth. This work reveals the existence of a core inspiratory circuit
   in which VO to VO synapses enabling function of the rhythm generator
   also direct its output to secure bilaterally coordinated contractions of
   inspiratory effector muscles required for efficient breathing.},
