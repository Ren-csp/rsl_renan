@article{ WOS:001755628700007,
Author = {Tharmalingam, Nagendran and Kovacs, Robert Wilson and Scarpa de Mello,
   Suelen and Baldwin, Philip Rupert and Jayanthan, Harikrishna Sekar and
   Arulsamy, Kulandaisamy and Rajmuthiah, Rajmohan and Rossatto, Fernanda
