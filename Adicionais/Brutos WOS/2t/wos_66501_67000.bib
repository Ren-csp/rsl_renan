@article{ WOS:000723143700001,
Author = {Chow, Julie Y. L. and Colagiuri, Ben and Rottman, Benjamin M. and
   Goldwater, Micah and Livesey, Evan J.},
Title = {Pseudoscientific Health Beliefs and the Perceived Frequency of Causal
   Relationships},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2021},
Volume = {18},
Number = {21},
Month = {NOV},
Abstract = {Beliefs about cause and effect, including health beliefs, are thought to
   be related to the frequency of the target outcome (e.g., health
   recovery) occurring when the putative cause is present and when it is
   absent (treatment administered vs. no treatment); this is known as
   contingency learning. However, it is unclear whether unvalidated health
   beliefs, where there is no evidence of cause-effect contingency, are
   also influenced by the subjective perception of a meaningful contingency
   between events. In a survey, respondents were asked to judge a range of
   health beliefs and estimate the probability of the target outcome
   occurring with and without the putative cause present. Overall, we found
   evidence that causal beliefs are related to perceived cause-effect
   contingency. Interestingly, beliefs that were not predicted by perceived
   contingency were meaningfully related to scores on the paranormal belief
   scale. These findings suggest heterogeneity in pseudoscientific health
   beliefs and the need to tailor intervention strategies according to
   underlying causes.},
