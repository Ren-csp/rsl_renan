@article{ WOS:000410237600007,
Author = {Xu, Longfa and Zheng, Qingbing and Li, Shaowei and He, Maozhou and Wu,
   Yangtao and Li, Yongchao and Zhu, Rui and Yu, Hai and Hong, Qiyang and
   Jiang, Jie and Li, Zizhen and Li, Shuxuan and Zhao, Huan and Yang,
   Lisheng and Hou, Wangheng and Wang, Wei and Ye, Xiangzhong and Zhang,
   Jun and Baker, Timothy S. and Cheng, Tong and Zhou, Z. Hong and Yan,
   Xiaodong and Xia, Ningshao},
Title = {Atomic structures of Coxsackievirus A6 and its complex with a
   neutralizing antibody},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {SEP 11},
Abstract = {Coxsackievirus A6 (CVA6) has recently emerged as a major cause of hand,
   foot and mouth disease in children worldwide but no vaccine is available
   against CVA6 infections. Here, we demonstrate the isolation of two forms
   of stable CVA6 particles-procapsid and A-particle-with excellent
   biochemical stability and natural antigenicity to serve as vaccine
   candidates. Despite the presence (in A-particle) or absence (in
   procapsid) of capsid-RNA interactions, the two CVA6 particles have
   essentially identical atomic capsid structures resembling the uncoating
   intermediates of other enteroviruses. Our near-atomic resolution
   structure of CVA6 A-particle complexed with a neutralizing antibody maps
   an immune-dominant neutralizing epitope to the surface loops of VP1. The
   structure-guided cell-based inhibition studies further demonstrate that
   these loops could serve as excellent targets for designing anti-CVA6
   vaccines.},
