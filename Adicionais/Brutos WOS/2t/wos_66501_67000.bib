@article{ WOS:000328620200017,
Author = {Byrd-Bredbenner, Carol and Berning, Jacqueline and Martin-Biggers,
   Jennifer and Quick, Virginia},
Title = {Food Safety in Home Kitchens: A Synthesis of the Literature},
