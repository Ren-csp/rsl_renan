@article{ WOS:000372018300001,
Author = {Huber, Eva M. and Heinemeyer, Wolfgang and Li, Xia and Arendt, Cassandra
   S. and Hochstrasser, Mark and Groll, Michael},
Title = {A unified mechanism for proteolysis and autocatalytic activation in the
   20S proteasome},
Journal = {NATURE COMMUNICATIONS},
Year = {2016},
Volume = {7},
Month = {MAR},
Abstract = {Biogenesis of the 20S proteasome is tightly regulated. The N-terminal
   propeptides protecting the active-site threonines are autocatalytically
   released only on completion of assembly. However, the trigger for the
   self-activation and the reason for the strict conservation of threonine
   as the active site nucleophile remain enigmatic. Here we use
   mutagenesis, X-ray crystallography and biochemical assays to suggest
   that Lys33 initiates nucleophilic attack of the propeptide by
   deprotonating the Thr1 hydroxyl group and that both residues together
   with Asp17 are part of a catalytic triad. Substitution of Thr1 by Cys
   disrupts the interaction with Lys33 and inactivates the proteasome.
   Although a Thr1Ser mutant is active, it is less efficient compared with
   wild type because of the unfavourable orientation of Ser1 towards
   incoming substrates. This work provides insights into the basic
   mechanism of proteolysis and propeptide autolysis, as well as the
   evolutionary pressures that drove the proteasome to become a threonine
   protease.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
