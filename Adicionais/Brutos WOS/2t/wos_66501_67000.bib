@article{ WOS:001678809400001,
Author = {Griffiths, Steve and Uratani, Joao M. and Evensen, Darrick and Sovacool,
   Benjamin K.},
Title = {Electric momentum? Catalyzing electric vehicle adoption in the United
   Arab Emirates},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {543},
Month = {FEB 8},
Abstract = {Carbon intensive regimes in the Middle East are now facing the arduous
   task of attempting to decarbonize their transport sectors. This paper
   provides an analysis of the UAE's readiness to accommodate the rapid
   global shift towards battery electric vehicles (EVs), focusing on the
   identification of existing barriers and proposing strategic enablers.
   Using a sociotechnical systems framework, the paper draws insights from
   a comprehensive survey of over 5000 respondents residing in the UAE on
   their views and experiences with EV purchases and use in the country.
   The UAE's readiness for EV adoption is evaluated against a set of 52
   barriers to adoption and eleven EV adoption enablers, and the impact of
   end user perception on EV uptake is explored. Based on the analysis
   undertaken, a UAE policy roadmap with immediate attention suggested for
   charging infrastructure and consumer information is proposed as a
   paradigm for catalyzing adoption of EVs.},
