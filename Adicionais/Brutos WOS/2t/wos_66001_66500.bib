Author = {Kollareddy, Madhusudhan and Dimitrova, Elizabeth and Vallabhaneni,
   Krishna C. and Chan, Adriano and Le, Thuc and Chauhan, Krishna M. and
   Carrero, Zunamys I. and Ramakrishnan, Gopalakrishnan and Watabe,
   Kounosuke and Haupt, Ygal and Haupt, Sue and Pochampally, Radhika and
   Boss, Gerard R. and Romero, Damian G. and Radu, Caius G. and Martinez,
   Luis A.},
Title = {Regulation of nucleotide metabolism by mutant p53 contributes to its
   gain-of-function activities},
Journal = {NATURE COMMUNICATIONS},
Year = {2015},
Volume = {6},
Month = {JUN},
Abstract = {Mutant p53 (mtp53) is an oncogene that drives cancer cell proliferation.
   Here we report that mtp53 associates with the promoters of numerous
   nucleotide metabolism genes (NMG). Mtp53 knockdown reduces NMG
   expression and substantially depletes nucleotide pools, which attenuates
   GTP-dependent protein activity and cell invasion. Addition of exogenous
   guanosine or GTP restores the invasiveness of mtp53 knockdown cells,
   suggesting that mtp53 promotes invasion by increasing GTP. In addition,
   mtp53 creates a dependency on the nucleoside salvage pathway enzyme
   deoxycytidine kinase for the maintenance of a proper balance in dNTP
   pools required for proliferation. These data indicate that
   mtp53-harbouring cells have acquired a synthetic sick or lethal
   phenotype relationship with the nucleoside salvage pathway. Finally,
   elevated expression of NMG correlates with mutant p53 status and poor
   prognosis in breast cancer patients. Thus, mtp53's control of nucleotide
   biosynthesis has both a driving and sustaining role in cancer
   development.},
