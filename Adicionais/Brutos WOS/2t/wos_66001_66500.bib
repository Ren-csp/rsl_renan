@article{ WOS:001696578800001,
Author = {Istrate, Aura-Luciana and Lao, Xiaolin and Sonet, Ungku Norani},
Title = {Contrasts of liveability and vulnerability analysed spatially and
   non-spatially in a historical Chinese context},
Journal = {CITIES},
Year = {2026},
Volume = {172},
Month = {MAY},
Abstract = {Contrasts of liveability and vulnerability remain underexplored in
   literature; this research aims to understand them through relational
   spatial and social patterns in a historical Chinese context. Spatial
   analyses of the built environment, transport, and green spaces were
   conducted using ArcGIS. Perceptions and mental maps from city centre
   residents and peripheral youth respondents were collected through survey
   questionnaires (n = 184 and n = 312, respectively), analysed
   statistically and thematically. Spatial maps revealed vulnerabilities
   related to high building density, fragmentation, and limited green
   space, confirmed by survey questionnaires to exacerbate sanitation and
   heat stress issues, besides some concerns on income security and
   displacement risks. Good access to services and facilities enhances
   liveability. Both respondent groups shared a strong sense of pride in
   heritage and cultural features. Strong social capital and friendliness
   derived from residents' activities, interactions, and the community
   support networks uplifted the most vulnerable. Residents who relied most
   on each other were from the lowest income groups, while familiarity with
   neighbours increased with age. These social qualities are invaluable yet
   at risk. Liveability and vulnerability are not mutually exclusive but
   coexist, influenced by a complex intertwining of factors. This study
   offers future directions for capturing the vulnerability-liveability
   interplay at the community level.},
