@article{ WOS:001435265100001,
Author = {Yang, Wei and Hicks, Derrick R. and Ghosh, Agnidipta and Schwartze,
   Tristin A. and Conventry, Brian and Goreshnik, Inna and Allen, Aza and
   Halabiya, Samer F. and Kim, Chan Johng and Hinck, Cynthia S. and Lee,
   David S. and Bera, Asim K. and Li, Zhe and Wang, Yujia and
   Schlichthaerle, Thomas and Cao, Longxing and Huang, Buwei and Garrett,
   Sarah and Gerben, Stacey R. and Rettie, Stephen and Heine, Piper and
   Murray, Analisa and Edman, Natasha and Carter, Lauren and Stewart, Lance
   and Almo, Steven C. and Hinck, Andrew P. and Baker, David},
Title = {Design of high-affinity binders to immune modulating receptors for
   cancer immunotherapy},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {FEB 26},
Abstract = {Immune receptors have emerged as critical therapeutic targets for cancer
   immunotherapy. Designed protein binders can have high affinity,
   modularity, and stability and hence could be attractive components of
   protein therapeutics directed against these receptors, but traditional
   Rosetta based protein binder methods using small globular scaffolds have
   difficulty achieving high affinity on convex targets. Here we describe
   the development of helical concave scaffolds tailored to the convex
   target sites typically involved in immune receptor interactions. We
   employed these scaffolds to design proteins that bind to TGF beta RII,
   CTLA-4, and PD-L1, achieving low nanomolar to picomolar affinities and
   potent biological activity following experimental optimization.
   Co-crystal structures of the TGF beta RII and CTLA-4 binders in complex
   with their respective receptors closely match the design models. These
   designs should have considerable utility for downstream therapeutic
   applications.},
