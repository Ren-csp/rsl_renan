@article{ WOS:001546834200036,
Author = {Zhang, Zhongyu and Zhao, Zhengde and Huang, Xiuyi and Zhou, Lifang and
   Jiang, Xin and Wu, Haoliang and Liu, Chenshu and Huang, Kan and Wen,
   Jielu and Liu, Yunchong and Miller, Michelle C. and Zhao, Zihan and He,
   Zhen and Wang, Yuxin and Liu, Siyu and Huang, Lijin and Yuan, Lining and
   Zeng, Renli and Cen, Zhipeng and Chen, Anning and Chen, Yanbo and Zeng,
   Gang and Liu, Wenzhou and Hong, Xiaosi and Ren, Meng and Yan, Li and
   Zhang, Yang and Guan, Dongxian and Tian, Xiaoyu and Cai, Weikang and
   Tai, Guihua and Mayo, Kevin H. and Zhou, Yifa and Li, Zilun and Chen,
   Sifan},
Title = {Galectin-3-integrin α5β1 phase separation disrupted by advanced
   glycation end-products impairs diabetic wound healing in rodents},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {AUG 7},
Abstract = {Diabetic foot ulcers are severe diabetic complications, and promoting
   impaired angiogenesis is essential for wound healing. Pro-angiogenic
   galectin-3 is elevated in diabetic serum and promotes systemic insulin
   resistance that may impair wound healing. However, the exact role of
   galectin-3 in the regulation of diabetic wound healing remains unclear.
   Here, we demonstrate that galectin-3 promotes skin wound healing and
   angiogenesis via binding to its receptor integrin alpha 5 beta 1, and
   enhances downstream focal adhesion kinase phosphorylation by forming a
   liquid-liquid phase separation with integrin alpha 5 beta 1. Under
   diabetic conditions, aberrant accumulated advanced glycation
   end-products bind to galectin-3, blocking its interaction with integrin
   alpha 5 beta 1 and impairing angiogenesis. Topical treatment of
   recombinant galectin-3 in hydrogels promotes diabetic wound healing in
   rodents without causing systemic insulin resistance and synergizes with
   insulin. This study clarifies the binding of galectin-3 to integrin
   alpha 5 beta 1, instead of advanced glycation end-products, forming
   phase separation to promote angiogenesis and diabetic wound healing,
   laying the foundation for local galectin-3 therapy to treat diabetic
   foot ulcers.},
