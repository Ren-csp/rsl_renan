Title = {Layered Signaling Regulatory Networks Analysis of Gene Expression
   Involved in Malignant Tumorigenesis of Non-Resolving Ulcerative Colitis
   via Integration of Cross-Study Microarray Profiles},
Journal = {PLOS ONE},
Year = {2013},
Volume = {8},
