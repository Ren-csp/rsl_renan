@article{ WOS:000596476900037,
Author = {Nordeen, Sarah A. and Turman, Daniel L. and Schwartz, Thomas U.},
Title = {Yeast Nup84-Nup133 complex structure details flexibility and reveals
   conservation of the membrane anchoring ALPS motif},
Journal = {NATURE COMMUNICATIONS},
Year = {2020},
Volume = {11},
Number = {1},
Month = {DEC 27},
Abstract = {The hallmark of the eukaryotic cell is the complex endomembrane system
   that compartmentalizes cellular functions. Transport into and out of the
   nucleus occurs through the nuclear pore complex (NPC). The heptameric
   Nup84 or Y complex is an essential scaffolding component of the NPC.
   Here we report two nanobody-bound structures: the full-length
   Nup84-Nup133 C-terminal domain complex and the Nup133 N-terminal domain,
   both from S. cerevisiae. Together with previously published structures,
   this work enables the structural description of the entire 575kDa Y
   complex from one species. The structure of Nup84-Nup133(CTD) details the
   high flexibility of this dimeric unit of the Y complex. Further, the
   Nup133(NTD) contains a structurally conserved amphipathic lipid packing
   sensor motif, confirmed by liposome interaction studies. The presented
   structures reveal important details about the function of the Y complex
   that affect our understanding of NPC structure and assembly.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
