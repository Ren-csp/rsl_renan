@article{ WOS:001786779300043,
Author = {Lima, Fernanda Viana and Kublikowski, Ida},
Title = {Families in situations of (re)marriage in Cape Verde: a socio-legal
   perspective},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {112},
Month = {MAY},
Abstract = {This article analyzes the phenomenon of (re)marriage in Cape Verde,
   establishing a comparative counterpoint with the Brazilian scenario.
   From an interdisciplinary perspective that integrates Sociology,
   History, and Law, the research investigates the plurality of
   contemporary family arrangements. The methodology, of a qualitative
   nature, used the ``snowball{''} technique to select ten participants in
   the city of Praia, whose accounts were obtained through semi-structured
   interviews and examined through content analysis. The results reveal
   that, although family restructuring is socially stigmatized as a
   destabilizing factor-confronting the traditional Christian model-
   (re)marriage emerges as a path to family reconstruction, happiness, and
   human dignity. In the legal field, the study points to a tension between
   the civil codes of European heritage, centered on marriage, and the
   reality of factual and plural relationships. It concludes that the
   family, in reinventing itself in the face of liquid modernity, remains
   an essential nucleus of protection and subjectivation.},
