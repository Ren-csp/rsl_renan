@article{ WOS:001589180500046,
Author = {Huttmanova, Emilia and Mikca, Radoslav},
Title = {Rebuilding Education under Global Challenges: Integrating Sustainability
   into Economics and Management Curricula},
Journal = {EUROPEAN JOURNAL OF SUSTAINABLE DEVELOPMENT},
