@article{ WOS:000350681700007,
Author = {Salehjee, Saima and Watts, Mike},
Title = {Science Lives: School choices and `natural tendencies'},
Journal = {INTERNATIONAL JOURNAL OF SCIENCE EDUCATION},
Year = {2015},
Volume = {37},
Number = {4},
Pages = {727-743},
Month = {MAR 4},
Abstract = {An analysis of 12 semi-structured interviews with university-based
   scientists and non-scientists illustrates their life journeys towards,
   or away from, science and the strengths and impact of life occurrences
   leading them to choose science or non-science professions. We have
   adopted narrative approaches and used Mezirow's transformative learning
   theory framework. The areas of discussion from the result have stressed
   on three main categories that include `smooth transition', `incremental
   wavering transition' and `transformative transition'. The article
   concludes by discussing the key influences that shaped initial attitudes
   and direction in these people through natural inclination, environmental
   inspirations and perceptions of science.},
