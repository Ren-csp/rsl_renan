@article{ WOS:000914083500001,
Author = {Mahr, Johannes B. B. and van Bergen, Penny and Sutton, John and
   Schacter, Daniel L. L. and Heyes, Cecilia},
Title = {Mnemicity: A Cognitive Gadget?},
