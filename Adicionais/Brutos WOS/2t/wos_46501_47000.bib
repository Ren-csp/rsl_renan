@article{ WOS:000333054400001,
Author = {Sorqvist, Patrik and Hurtig, Anders and Ljung, Robert and Ronnberg,
   Jerker},
Title = {High second-language proficiency protects against the effects of
   reverberation on listening comprehension},
Journal = {SCANDINAVIAN JOURNAL OF PSYCHOLOGY},
Year = {2014},
Volume = {55},
Number = {2},
Pages = {91-96},
Month = {APR},
Abstract = {The purpose of this experiment was to investigate whether classroom
   reverberation influences second-language (L2) listening comprehension.
   Moreover, we investigated whether individual differences in baseline L2
   proficiency and in working memory capacity (WMC) modulate the effect of
   reverberation time on L2 listening comprehension. The results showed
   that L2 listening comprehension decreased as reverberation time
   increased. Participants with higher baseline L2 proficiency were less
   susceptible to this effect. WMC was also related to the effect of
   reverberation (although just barely significant), but the effect of WMC
   was eliminated when baseline L2 proficiency was statistically
   controlled. Taken together, the results suggest that top-down cognitive
   capabilities support listening in adverse conditions. Potential
   implications for the Swedish national tests in English are discussed.},
