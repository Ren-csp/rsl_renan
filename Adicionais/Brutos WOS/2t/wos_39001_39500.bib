@article{ WOS:001000242800001,
Author = {Wignall, Veronica R. and Balfour, Nicholas J. and Gandy, Sam and
   Ratnieks, Francis L. W.},
Title = {Food for flower-visiting insects: Appreciating common native wild
   flowering plants},
Journal = {PEOPLE AND NATURE},
Year = {2023},
Volume = {5},
Number = {4},
Pages = {1072-1081},
Month = {AUG},
Abstract = {1. Native wild flowering plants provide important season-round nectar
   and pollen resources for flower-visiting insects, but many are
   unappreciated or even disliked by members of the public; for example ivy
   (Hedera spp.), dandelion (Taraxacum officinale agg.) and bramble (Rubus
   fruticosus agg.).
   2. This antipathy has received little research attention despite a
   pressing need for a societal shift towards greater awareness of such
   plants and recognition of their ecological value.
   3. Engendering greater awareness and appreciation of common wild-growing
   plants could greatly improve floral resource availability for
   flower-visiting insects, enhance biodiversity and simultaneously benefit
   human physical and mental well-being.
   4. However, there are multiple challenges to changing public attitudes.
   Knowledge of common wild flowering plants among members of the public is
   limited and this phenomenon is symptomatic of a diminishing human
   connection to nature. While many species of wild flowering plants may be
   overlooked due to a lack of awareness or knowledge, it is evident that
   some `weeds' are actively unpopular.
   5. Reframing societal perceptions towards ecological value could be
   achieved in several ways including through formal education, messaging
   by the media, businesses and environmental organisations, and by
   encouraging public participation in urban land management.},
