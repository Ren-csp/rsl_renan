@article{ WOS:000705097000001,
Author = {Sweeny, Amy R. and Albery, Gregory F. and Becker, Daniel J. and Eskew,
   Evan A. and Carlson, Colin J.},
Title = {Synzootics},
Journal = {JOURNAL OF ANIMAL ECOLOGY},
Year = {2021},
Volume = {90},
Number = {12},
Pages = {2744-2754},
Month = {DEC},
Abstract = {Ecologists increasingly recognise coinfection as an important component
   of emergent epidemiological patterns, connecting aspects of
   ecoimmunology, behaviour, ecosystem function and even extinction risk.
   Building on syndemic theory in medical anthropology, we propose the term
   `synzootics' to describe co-occurring enzootic or epizootic processes
   that produce worse health outcomes in wild animals. Using framing from
   syndemic theory, we describe how the synzootic concept offers new
   insights into the ecology and evolution of infectious diseases. We then
   recommend a set of empirical criteria and lines of evidence that can be
   used to identify synzootics in nature. We conclude by exploring how
   synzootics could indirectly drive the emergence of novel pathogens in
   human populations.},
