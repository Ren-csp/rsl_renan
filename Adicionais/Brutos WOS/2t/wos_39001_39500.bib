@article{ WOS:001420134800001,
Author = {Ouvrier, Alice and Culos, Manon and Guillerme, Sylvie and Dore, Antoine
   and Figari, Helene and Linnell, John and Quenette, Pierre-Yves and
   Vimal, Ruppert},
Title = {What does coexistence mean? Insight from place-based trajectories of
   pastoralists and bears encounters in the Pyrenees},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2091-2103},
Month = {JUL},
Abstract = {The recovery of large carnivores in Europe raises issues related to
   sharing landscape with humans. Beyond technical solutions, it is widely
   recognized that social factors also contribute to shaping coexistence.
   In this context, scholars increasingly stress the need to adopt
   place-based approaches by analysing how humans and wildlife interact and
   co-adapt in specific landscapes. In the burgeoning field of
   `more-than-human' geography, both humans and non-humans are considered
   as co-constitutive of places. According to this tradition, animals
   should not simply be seen as objects under human control but approached
   as powerful actors in multi-species landscapes. By tracking how brown
   bear recovery in the French Pyrenees has shaped different places of
   encounters with pastoralists (i.e. farmers and shepherds in extensive
   sheep farming in mountain pastures during summer), this paper discusses
   what coexistence means when viewed through the lens of more-than-human
   geography. We use an in-depth, retrospective and multi-sources approach
   to describe the inter-relationships of bears and pastoralists on three
   mountain pastures since the return of bears at the end of the 1990s.
   Semi structured interviews, participant observation, administrative and
   institutional data about bear depredation and genetics, as well as
   pastoral practices form the basis of an integrated narrative analysis.
   Our study reveals how the return of a large carnivore has produced three
   different, singular, context-specific coexistence `patches'. Each of
   these three pastures represent a distinct landscape dynamically shaped
   over time by bears, pastoralists and the rest of biotic and abiotic
   environment. Specifically, we demonstrate how various factors-the
   individual behaviour of bears, their movement and reproduction capacity,
   the number of depredations, the pastoralists' histories, their
   collective organization, the choices they made, the pastures' features,
   the available resources and surrounding vegetation-cumulatively
   intertwine in complex, place-specific entanglements. Policy
   implications. Our results suggest that coexistence should not be
   conceptualized as global, top down and standardized. Instead it is
   shaped by patches in which humans and non-humans interact in specific
   ways. Therefore, fostering coexistence means acknowledging the full
   diversity of situations in which people and wildlife write their own
   place-based, more-than-human histories.Read the free Plain Language
   Summary for this article on the Journal blog.
   Le retour des grands carnivores en Europe soul \& egrave;ve des
   questions li \& eacute;es au partage des paysages avec les humains.
   Au-del \& agrave; des solutions techniques, il est. largement reconnu
   que les facteurs sociaux contribuent \& eacute;galement \& agrave; fa \&
   ccedil;onner la coexistence. Dans ce contexte, les chercheurs insistent
   de plus en plus sur la n \& eacute;cessit \& eacute; d'adopter des
   approches locales en analysant comment les humains et la faune
   interagissent et s'adaptent mutuellement dans des paysages sp \&
   eacute;cifiques. Dans le domaine \& eacute;mergent de la g \&
   eacute;ographie << plus-qu'humaine >>, les humains et les non-humains
   sont consid \& eacute;r \& eacute;s comme co-constitutifs des espaces.
   Selon cette approche, les animaux ne devraient pas \& ecirc;tre
   simplement vus comme des objets sous contr \& ocirc;le des humains, mais
   plut \& ocirc;t consid \& eacute;r \& eacute;s comme des acteurs moteurs
   dans des paysages multi-sp \& eacute;cifiques. En suivant comment le
   retour de l'Ours brun dans les Pyr \& eacute;n \& eacute;es fran \&
   ccedil;aises a fa \& ccedil;onn \& eacute; diff \& eacute;rents lieux de
   rencontre avec les transhumants (c'est-\& agrave;-dire les \&
   eacute;leveurs et bergers pratiquant l'\& eacute;levage extensif de
   brebis en p \& acirc;turages de montagne en \& eacute;t \& eacute;), cet
   article examine ce que signifie la coexistence \& agrave; travers le
   prisme de la g \& eacute;ographie plus-qu'humaine. Nous utilisons une
   approche approfondie, r \& eacute;trospective et multi-sources pour d \&
   eacute;crire les interrelations entre les ours et les transhumants sur
   trois p \& acirc;turages de montagne, appel \& eacute;s estives, depuis
   le retour des ours \& agrave; la fin des ann \& eacute;es 1990. Des
   entretiens semi-directifs, des temps d'observation participante, des
   donn \& eacute;es administratives et institutionnelles sur les pr \&
   eacute;dations et identifications g \& eacute;n \& eacute;tiques des
   ours, ainsi que les pratiques pastorales, constituent la base d'une
   analyse narrative int \& eacute;gr \& eacute;e. Notre \& eacute;tude r
   \& eacute;v \& egrave;le comment le retour d'un grand carnivore a
   produit trois << patches >> de coexistence diff \& eacute;rents,
   singuliers et sp \& eacute;cifiques aux contextes consid \& eacute;r \&
   eacute;s. Chacune de ces trois estives repr \& eacute;sente un paysage
   distinct, fa \& ccedil;onn \& eacute; dynamiquement au fil du temps par
   les ours, les transhumants et le reste de l'environnement biotique et
   abiotique. Plus pr \& eacute;cis \& eacute;ment, nous d \&
   eacute;montrons comment divers facteurs - le comportement individuel des
   ours, leurs mouvements et leur capacit \& eacute; de reproduction, le
   nombre de pr \& eacute;dations, l'histoire des transhumants, leur
   organization collective, les choix qu'ils ont faits, les caract \&
   eacute;ristiques des estives, les ressources disponibles et la v \&
   eacute;g \& eacute;tation environnante - s'entrelacent cumulativement
   dans des enchev \& ecirc;trements complexes et sp \& eacute;cifiques \&
   agrave; chaque espace. Implications politiques. Nos r \& eacute;sultats
   sugg \& egrave;rent que la coexistence ne doit pas \& ecirc;tre
   conceptualis \& eacute;e de mani \& egrave;re globale, descendante et
   standardis \& eacute;e. Elle est. plut \& ocirc;t fa \& ccedil;onn \&
   eacute;e par des patches dans lesquels humains et non-humains
   interagissent de mani \& egrave;re sp \& eacute;cifique. Par cons \&
   eacute;quent, favo},
