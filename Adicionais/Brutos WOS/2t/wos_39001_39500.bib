@article{ WOS:001827715100001,
Author = {Macias-Velasco, Juan F. and Zhuo, Xiaoyu and Tomlinson, Chad and Belter,
   Eddie A. and Kremitzki, Milinn and Albracht, Derek and Lindsay, Tina and
   Xing, Xiaoyun and Tekkey, Nina and Zhang, Wenjin and Garza, John E. and
   Xu, Zheng and Xin, Zilan and Fu, Qichen and Lawson, Heather A. and
   Stitziel, Nathan O. and Fulton, Robert S. and Li, Daofeng and Wang, Ting
   and Human Pangenome Reference Consortium},
Title = {Benchmarking genome choice in functional genomics analyses},
