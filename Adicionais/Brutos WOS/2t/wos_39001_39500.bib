@article{ WOS:000075404000046,
Author = {Baverstock, KF},
Title = {Perspectives in radiation and health: Reflections on the international
   conference in Beer Sheva},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {1997},
Volume = {105},
Number = {6},
