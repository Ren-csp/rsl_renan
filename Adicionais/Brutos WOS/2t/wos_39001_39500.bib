@article{ WOS:001826837900003,
Author = {Larraechea, Matilde and Guerrero-Gatica, Matias and Bidegain, Inigo and
   Cerda, Claudia},
Title = {Weaving relational values around a threatened river landscape: bundles,
   interrelations, and social drivers from northern Chile},
Journal = {ECOLOGY AND SOCIETY},
Year = {2026},
Volume = {31},
Number = {3},
Month = {JUL},
Abstract = {. Relational values (RVs) emphasize the collective, cultural, and
   affective dimensions of human-nature relationships, yet their assessment
   remains limited. Advancing the empirical and methodological
   understanding of RVs is crucial to foster more plural and adaptive
   governance of social-ecological systems. This study examines how RVs are
   structured, expressed, and socially differentiated within a threatened
   landscape in Latin America. Using 201 surveys with local residents, we
   identified 21 categories of RVs, including 14 consistent with
   established frameworks and seven emerging from the local context, and
   analyzed their structure, co-occurrence, and social determinants through
   multiple correspondence analysis and generalized linear model. Three
   main bundles of values emerged: (1) Identity-Therapeutic-Aesthetic,
   highlighting the river as a source of belonging, emotional well-being,
   and inspiration; (2) Cultural- Patrimonial-Political, emphasizing
   collective memory, traditions, and resistance; and (3)
   Symbolic/Religious-Care/Memory, reflecting sacred meanings alongside
   ecological stewardship and remembrance. These bundles reveal how
   emotional well-being, heritage, and spirituality intertwine with
   political struggle and stewardship practices. Generational, educational,
   and relational variables shaped the distribution of values, underscoring
   the role of social networks and conflicts in shaping perceptions. By
   integrating exploratory, associative, and inferential approaches, this
   study contributes to the methodological framework to empirically assess
   the plurality and contextuality of relational values. Our findings
   demonstrate that recognizing and weaving diverse relational perspectives
   into ecosystem governance enhance cultural legitimacy and social
   inclusion, key components for sustainability in complex
   social-ecological systems.},
