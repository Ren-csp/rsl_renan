@article{ WOS:001391680900001,
Author = {Sobhani, Parvaneh and Esmaeilzadeh, Hassan and Dinan, Naghmeh Mobarghaei},
Title = {Prioritization and valuation of ecosystem services in protected areas},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2025},
Volume = {84},
Month = {MAR},
Abstract = {Protected areas (PAs) are a tool to protect biodiversity and maintain
   the provisioning of Ecosystem Services (ES) in nature. However, there is
   still no comprehensive analysis on the relationship between PAs,
   biodiversity conservation, and Ecosystem Services Value (ESV) in these
   areas. On the other hand, due to population growth and urbanization
   development, these vital resources have been threatened by human
   activities. Thus, the present study has prioritized and compared ES in
   two different types of PAs, including Lar national park and Kavdeh
   wildlife refuge in Iran (Tehran province). ES in the study areas was
   identified and prioritized using the Delphi method based on experts'
   viewpoints, theoretical studies and characteristics of studied areas. In
   this regard, remote sensing techniques were also used to prepare the
   LULC map as the most important ES in the study areas. Then these
   services were quantified using the benefit transfer approach. As the
   results illustrate, in Lar national park, according to the IUCN
   classification and the main objectives in national parks, the highest ES
   priority is related to cultural services. Whereas, the lowest ES is
   allocated to regulating services, due to ecological restrictions and
   legal prohibitions in exploitation of this area. In Kavdeh wildlife
   refuge, the highest ES priority is related to regulating services, and
   the lowest ES is visible in cultural services, due to the lack of legal
   prohibitions in human activities development and the lowest degree of
   protection among different types of PAs. Moreover, the results indicate
   that in the studied areas, the highest estimated ESV is related to
   provision of services, due to the high importance of genetic resources
   in these areas. As the main goal of these areas is protection and
   suitable management of resources, obtained results can help prioritize
   these areas with different degrees of protection, preserve biodiversity
   values, and provide appropriate strategies to increase economic
   sustainability and human well-being.},
