@article{ WOS:001549746700001,
Author = {Corraliza, Jose Antonio and Moll, Adrian and Collado, Silvia and
   Sevillano, Veronica and Mugica, Marta},
Title = {Concern about climate change in two protected natural areas of Spain:
   psychological barriers / La preocupación por el cambio climático en
   dos espacios naturales protegidos de España: barreras psicológicas},
Journal = {PSYECOLOGY-BILINGUAL JOURNAL OF ENVIRONMENTAL PSYCHOLOGY-REVISTA
   BILINGUE DE PSICOLOGIA AMBIENTAL},
Year = {2024},
Volume = {15},
Number = {3, SI},
Pages = {253-276},
Month = {OCT},
Abstract = {Climate change (CC) has been listed as the greatest risk to humanity,
   and the most appropriate strategies to address the situation depend
   largely on how the problem is perceived. The purpose of this study is to
   analyse social perceptions of CC in two natural areas of Spain
   (Garajonay and Sierra Espu \& ntilde;a). Participants (N = 334) showed
   high levels of concern and low levels of scepticism about CC. A
   factorial model was developed to explain the relationships between
   variables that affect concern about CC: scepticism, technological
   optimism, negative self-efficacy, political ideology and perceived signs
   of CC. The SEM model (R 2 = .65; chi 2(df) = 223.65 (131); CFI = .968;
   RMSEA = .057) shows the strategic importance of considering the
   variables included (such as CC scepticism and technological optimism) so
   as to better understand the complex phenomenon of concern about CC.
   El cambio clim \& aacute;tico (CC) ha sido catalogado como el mayor
   riesgo para la humanidad y las estrategias m \& aacute;s adecuadas para
   afrontar la situaci \& oacute;n dependen en gran medida de la percepci
   \& oacute;n del problema. El objetivo de este estudio es analizar la
   percepci \& oacute;n social del CC en dos \& aacute;reas naturales de
   Espa \& ntilde;a (Garajonay y Sierra Espu \& ntilde;a). Los
   participantes (N = 334) mostraron altos niveles de preocupaci \&
   oacute;n por el CC y bajos niveles de escepticismo sobre la existencia
   de \& eacute;ste. Se elabor \& oacute; un modelo factorial para explicar
   las relaciones entre variables que afectan a la preocupaci \& oacute;n
   por el CC: escepticismo, optimismo tecnol \& oacute;gico, autoeficacia
   negativa, ideolog \& iacute;a pol \& iacute;tica e indicios percibidos
   del CC. El modelo SEM (R 2 = .65; chi 2(gl) = 223.65 (131); CFI = .968;
   RMSEA = .057) muestra la importancia estrat \& eacute;gica de considerar
   las variables incluidas (como el escepticismo frente al CC y el
   optimismo tecnol \& oacute;gico) para comprender mejor el complejo fen
   \& oacute;meno de la preocupaci \& oacute;n por el CC.},
