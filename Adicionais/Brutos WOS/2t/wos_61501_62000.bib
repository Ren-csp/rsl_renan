@article{ WOS:000451113900010,
Author = {Gonzalez, Victor H. and Amith, Jonathan D. and Stein, Timothy J.},
Title = {Nesting ecology and the cultural importance of stingless bees to
   speakers of Yoloxchitl Mixtec, an endangered language in Guerrero,
   Mexico},
Journal = {APIDOLOGIE},
Year = {2018},
Volume = {49},
Number = {5},
Pages = {625-636},
Month = {OCT},
Abstract = {Stingless bees (Apidae: Meliponini) are major pollinators of many wild
   and cultivated plants, and both indigenous and non-indigenous
   populations use their products for diverse purposes including food,
   crafts, and medicine. However, many aspects of both stingless bee
   nesting ecology and traditional knowledge of these culturally
   significant bees by diverse human populations remain unknown or poorly
   documented. We report on the nest architecture, nesting substrate, host
   plants, and local abundance of stingless bees occurring in Yoloxchitl,
   one of several indigenous villages that speak Yoloxchitl Mixtec, an
   endangered language on the Pacific Coast of the state of Guerrero. We
   also document local Indigenous nomenclature, classification, and use of
   these bees as well as traditional management practices and knowledge of
   their behavior. Lastly, we offer a preliminary quantitative analysis of
   the relative cultural importance of each bee species and explore the
   relationship of traditional ecological knowledge to these species.},
Publisher = {SPRINGER FRANCE},
Address = {22 RUE DE PALESTRO, PARIS, 75002, FRANCE},
Type = {Article},
