   Armendariz, Marina, Univ Texas San Antonio, Dept Publ Hlth, San Antonio, TX USA.
   Jenkins, August I. C., Univ Illinois, Dept Entomol, 2007 Christopher Hall, Urbana, IL 61801 USA.},
DOI = {10.1016/j.socscimed.2024.116763},
