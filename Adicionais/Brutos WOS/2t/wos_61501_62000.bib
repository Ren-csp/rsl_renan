@article{ WOS:000873287800001,
Author = {Wallner, Christoph and Kruber, Svenja and Adebayo, Sulaiman Olanrewaju
   and Ayandele, Olusola and Namatame, Hikari and Olonisakin, Tosin Tunrayo
   and Olapegba, Peter O. and Sawamiya, Yoko and Suzuki, Tomohiro and
   Yamamiya, Yuko and Wagner, Maximilian Johannes and Drysch, Marius and
   Lehnhardt, Marcus and Behr, Bjorn},
Title = {Interethnic Influencing Factors Regarding Buttocks Body Image in Women
   from Nigeria, Germany, USA and Japan},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {20},
Month = {OCT},
Abstract = {Background: Body image research deals a lot with awareness of the body
   as an entity. Studies that consider individual anatomical aspects and
   place them in an intercultural context are rarely present. Methods: For
   this purpose, general data, body perception and judgment of body images
   from 2163 (48\% female and 52\% male) participants from Germany,
   Nigeria, the USA and Japan were evaluated as part of a survey. Results:
   There were clear differences in the personal body image of the
   participants' own buttocks, the buttocks as a beauty ideal and the way
   in which dissatisfaction was dealt with in different countries. In
   addition to sexual well-being (importance score: 0.405 a.u.), the
   country of origin (0.353), media consumption (0.042) and one's own
   weight (0.069) were also identified as influencing factors for
   satisfaction with one's own buttocks. A clear evolution could be derived
   regarding a WHR (waist-to-hip ratio) of well below 0.7, which was
   consistently favored by the participants but also propagated by
   influencers through images (p < 0.001). In this context, participants
   who indicated celebrities as role models for the buttocks showed a
   correspondingly high level of dissatisfaction with their own buttocks (R
   = -0.207, p < 0.001, rho = -0.218). Conclusion: Overall, a highly
   significant correlation was shown between the consumption frequency of
   Instagram, TikTok and pornography with the negative perception of
   women's own buttocks.},
