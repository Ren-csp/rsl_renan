   Simpson, Morgan David; Marino, Armando; Hunter, Peter; Spyrakos, Evangelos; Telfer, Trevor; Tyler, Andrew, Univ Stirling, Fac Nat Sci, Stirling FK9 4LA, Scotland.
   de Maagt, Peter; Gandini, Erio, European Space Res \& Technol Ctr ESA ESTEC, NL-2201 AZ Noordwijk, Netherlands.
   de Fockert, Anton, Deltares, NL-2629 HV Delft, Netherlands.},
DOI = {10.3390/rs15061654},
