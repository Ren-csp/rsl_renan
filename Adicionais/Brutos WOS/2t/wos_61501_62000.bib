@article{ WOS:001000251900009,
Author = {Momont, Corey and Dang, Ha V. V. and Zatta, Fabrizia and Hauser, Kevin
   and Wang, Caihong and di Iulio, Julia and Minola, Andrea and
   Czudnochowski, Nadine and De Marco, Anna and Branch, Kaitlin and
   Donermeyer, David and Vyas, Siddhant and Chen, Alex and Ferri, Elena and
   Guarino, Barbara and Powell, Abigail E. and Spreafico, Roberto and Yim,
   Samantha S. and Balce, Dale R. and Bartha, Istvan and Meury, Marcel and
   Croll, Tristan I. and Belnap, David M. and Schmid, Michael A. and
   Schaiff, William Timothy and Miller, Jessica L. and Cameroni, Elisabetta
   and Telenti, Amalio and Virgin, Herbert W. and Rosen, Laura E. and
   Purcell, Lisa A. and Lanzavecchia, Antonio and Snell, Gyorgy and Corti,
   Davide and Pizzuto, Matteo Samuele},
Title = {A pan-influenza antibody inhibiting neuraminidase via receptor mimicry},
Journal = {NATURE},
Year = {2023},
Volume = {618},
Number = {7965},
Month = {JUN 15},
Abstract = {Rapidly evolving influenza A viruses (IAVs) and influenza B viruses
   (IBVs) are major causes of recurrent lower respiratory tract infections.
   Current influenza vaccines elicit antibodies predominantly to the highly
   variable head region of haemagglutinin and their effectiveness is
   limited by viral drift(1) and suboptimal immune responses(2). Here we
   describe a neuraminidase-targeting monoclonal antibody, FNI9, that
   potently inhibits the enzymatic activity of all group 1 and group 2
   IAVs, as well as Victoria/2/87-like, Yamagata/16/88-like and ancestral
   IBVs. FNI9 broadly neutralizes seasonal IAVs and IBVs, including the
   immune-evading H3N2 strains bearing an N-glycan at position 245, and
   shows synergistic activity when combined with anti-haemagglutinin
   stem-directed antibodies. Structural analysis reveals that D107 in the
   FNI9 heavy chain complementarity-determinant region 3 mimics the
   interaction of the sialic acid carboxyl group with the three highly
   conserved arginine residues (R118, R292 and R371) of the neuraminidase
   catalytic site. FNI9 demonstrates potent prophylactic activity against
   lethal IAV and IBV infections in mice. The unprecedented breadth and
   potency of the FNI9 monoclonal antibody supports its development for the
   prevention of influenza illness by seasonal and pandemic viruses.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
