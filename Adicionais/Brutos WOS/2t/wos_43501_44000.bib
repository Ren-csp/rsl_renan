@article{ WOS:001612001300004,
Author = {Wisutwattanasak, Panuwat and Champahom, Thanapong and Theerathitichaipa,
   Kestsirin and Seefong, Manlika and Ratanavaraha, Vatanavongs and
   Jomnonkwao, Sajjakaj},
Title = {Urban-Rural Differences in Pedestrians' Unsafe Behaviors: A Multigroup
   SEM Based on the Health Belief Model},
Journal = {SUSTAINABLE FUTURES},
Year = {2025},
Volume = {10},
Month = {DEC},
Abstract = {Pedestrian safety remains a critical public health concern, particularly
   in low- and middle-income countries like Thailand, where rapid
   urbanization and infrastructure disparities contribute to elevated
   pedestrian crash risks. This study investigates unsafe pedestrian
   behavior across urban and rural contexts using a multi-group Structural
   Equation Modeling (SEM) approach grounded in the Health Belief Model
   (HBM). Data were collected from 1600 respondents across 16 Thai
   provinces, with equal representation from urban and rural populations.
   The analysis identified six key dimensions of pedestrian behavior:
   violations, errors, lapses, social media use, aggressive behavior, and
   positive behavior. Exploratory and confirmatory factor analyses
   confirmed a consistent six-factor structure across both contexts, while
   multi-group SEM revealed significant differences in psychological
   determinants. In urban areas, perceived barriers and susceptibility were
   the strongest predictors, with social media distraction being the most
   influential behavioral component. In contrast, rural pedestrian behavior
   was more strongly influenced by perceived benefits and health
   motivation, with aggressive behavior and violations posing greater
   risks. These findings underscore the need for context-sensitive
   interventions. Urban strategies should address perceived barriers and
   risk perception, whereas rural interventions should emphasize the
   benefits of safe behavior and promote health-conscious attitudes. This
   study extends the application of HBM in transportation research,
   highlights the psychological underpinnings of pedestrian risk, and
   offers evidence-based guidance for geographically tailored pedestrian
   safety policies and educational campaigns.},
