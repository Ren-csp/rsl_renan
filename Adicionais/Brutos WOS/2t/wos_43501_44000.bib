@article{ WOS:001544959600001,
Author = {Ansil, B. R. and Lei, Guang-Sheng and Santos, Aaron J. and Letko,
   Michael and Seifert, Stephanie N. and Fenton, M. Brock and Simmons,
   Nancy B. and Relich, Ryan F. and Becker, Daniel J.},
Title = {229E- and NL63-like coronaviruses in phyllostomid bats, Belize},
Journal = {ONE HEALTH},
Year = {2025},
Volume = {21},
Month = {DEC},
Abstract = {Coronaviruses (CoVs) are a diverse group of RNA viruses that infect a
   broad range of hosts, including many bat species. The emergence of
   several CoVs, specifically alpha-CoVs and (3-coVs causing significant
   human and domestic animal diseases, has been linked to bats.
   Characterizing the evolutionary relationships and host associations of
   bat-borne CoVs is crucial for understanding and mitigating zoonotic
   risks. While most bat CoV research has focused on the Eastern
   Hemisphere, the diversity of CoVs in Neotropical bats remains relatively
   understudied. Here, we report novel and previously identified alpha-CoV
   diversity in three phyllostomid bats (Desmodus rotundus, Carollia
   sowelli, and Sturnira parvidens) in Belize. Our analysis targeting the
   partial RNA-dependent RNA polymerase gene revealed varying prevalence
   (22.22 - 36.36 \%) across these species. Our phylogenetic analysis
   suggests strong similarity between two Neotropical bat alpha-CoV
   lineages and human CoVs (229E and NL63), illustrating new evolutionary
   relationships compared to prior bat alpha-CoVs.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Ansil, BR (Corresponding Author), Univ Oklahoma, Sch Biol Sci, Norman, OK 73019 USA.
   Ansil, B. R.; Santos, Aaron J.; Becker, Daniel J., Univ Oklahoma, Sch Biol Sci, Norman, OK 73019 USA.
   Lei, Guang-Sheng; Relich, Ryan F., Indiana Univ, Dept Pathol \& Lab Med, Sch Med, Indianapolis, IN USA.
