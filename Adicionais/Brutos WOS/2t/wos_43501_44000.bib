@article{ WOS:001344879400001,
Author = {Brumm, Adam and Forth, Gregory},
Title = {Aboriginal flood narratives and the thunder complex in Southeast Asia},
Journal = {ARCHAEOLOGY IN OCEANIA},
Year = {2025},
Volume = {60},
Number = {1},
Pages = {1-16},
Month = {APR},
Abstract = {The ancestors of the dingo were brought to mainland Australia around
   4000 years ago by people who arrived by boat. The identity of these
   voyagers from the north, however, and the nature of their interactions
   with the Aboriginal population of Australia, are unknown. Here, we
   propose that Indigenous flood narratives from the Kimberley contain
   evidence for contact between Aboriginal people and early Asian seafarers
   in the form of the ``thunder complex{''}. The latter is a very specific
   repertoire of taboos, rituals and stories that occurs widely among
   ethnographically known societies of Indonesia, the Philippines and
   peninsular Malaysia, but has not previously been identified in
   Australia. Among Southeast Asian groups, this cultural complex revolves
   around the idea that certain prohibited acts perpetrated against animals
   - especially ``mocking{''} them by treating them as though they were
   human - precipitate a punitive storm and/or flooding. We show that in
   some oral traditions of the Kimberley region animal mockery is similarly
   held to be the causative agent behind disastrous flooding events that
   took place in the past creationary epoch. We contend that this localised
   Aboriginal variant of the thunder complex reflects an episode of close
   interaction with early Austronesian-speaking voyagers who introduced
   ancestral dingoes to mainland Australia, apparently via the Kimberley
   coast.
   Les anc \& ecirc;tres du dingo ont \& eacute;t \& eacute; amen \&
   eacute;s en Australie continentale il y a environ 4000 ans par des
   personnes arriv \& eacute;es par bateau. L'identit \& eacute; de ces
   voyageurs venus du nord, ainsi que la nature de leurs interactions avec
   la population Aborig \& egrave;ne d'Australie, sont cependant inconnues.
   Nous proposons ici que les r \& eacute;cits autochtones sur les
   inondations du Kimberley contiennent des preuves de contacts entre les
   peuples autochtones et les premiers marins asiatiques sous la forme du
   << complexe du orage >>. Ce dernier est un r \& eacute;pertoire tr \&
   egrave;s sp \& eacute;cifique de tabous, de rituels et d'histoires
   largement r \& eacute;pandu dans les soci \& eacute;t \& eacute;s
   ethnographiquement connues d'Indon \& eacute;sie, des Philippines et de
   la p \& eacute;ninsule malaisienne, mais qui n'a pas encore \& eacute;t
   \& eacute; identifi \& eacute; en Australie. Parmi les groupes d'Asie du
   Sud-Est, ce complexe culturel s'articule autour de l'id \& eacute;e que
   certains actes interdits perp \& eacute;tr \& eacute;s contre les
   animaux - notamment << se moquer >> d'eux en les traitant comme s'ils \&
   eacute;taient des humains - pr \& eacute;cipitent une temp \& ecirc;te
   punitive et/ou des inondations. Nous montrons que dans certaines
   traditions orales de la r \& eacute;gion de Kimberley, la moquerie
   animale est \& eacute;galement consid \& eacute;r \& eacute;e comme
   l'agent causal des inondations d \& eacute;sastreuses qui ont eu lieu au
