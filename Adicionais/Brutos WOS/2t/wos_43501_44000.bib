@article{ WOS:000509570100035,
Author = {Rizal, Yan and Westaway, Kira E. and Zaim, Yahdi and van den Bergh,
   Gerrit D. and Bettis, III, E. Arthur and Morwood, Michael J. and
   Huffman, O. Frank and Grun, Rainer and Joannes-Boyau, Renaud and Bailey,
   Richard M. and Sidarto and Westaway, Michael C. and Kurniawan, Iwan and
