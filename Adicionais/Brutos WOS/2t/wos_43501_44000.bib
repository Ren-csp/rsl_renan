   Barnes, Carol A., Univ Arizona, Dept Psychol, Tucson, AZ 85724 USA.
   Barnes, Carol A., Univ Arizona, Dept Neurol, Tucson, AZ 85724 USA.},
DOI = {10.1037/a0020893},
ISSN = {0735-7044},
