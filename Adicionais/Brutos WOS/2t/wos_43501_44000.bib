@article{ WOS:001402583300001,
Author = {Tao, Yuan and Xiong, Ying and Evans, Steve and Feng, Qi and Zhang, Lei},
Title = {Policy instruments' effectiveness for facilitating industrial symbiosis:
   A UK-China comparative study from firms' perspectives},
Journal = {JOURNAL OF INDUSTRIAL ECOLOGY},
Year = {2025},
Volume = {29},
Number = {6},
Pages = {2457-2477},
Month = {DEC 10},
Abstract = {Industrial symbiosis (IS) can be a powerful business concept to achieve
   sustainability and generate significant co-benefits by utilizing waste
   from one factory as input to another factory in industrial complexes.
   However, the adoption of IS is not as expected, partly due to inadequate
   tailoring to the diverse institutional contexts across different
   regions. Existing research on facilitating IS has primarily focused on
   individual countries or industries, lacking insight into the mechanisms
   and pathways adopted in countries with different economic development
   levels and policy approaches in facilitating IS. This study conducts a
   comparative analysis of two facilitated IS initiatives between the
   United Kingdom and China, where the ``parks{''} are expended to
   ``countries.{''} The objective is to clarify what policy instruments
   work well under what conditions in fostering facilitated IS from firms'
   perspectives. Qualitative methods including semi-structured interviews,
   on-site observations, and archival analysis are employed to collect
   data, which is analyzed by using thematic coding based on a conceptual
   framework for comparing the speed-dating/exogenous IS model. The
   research finding is that effective facilitation of IS requires tailoring
   policy instruments to its institutional context, leveraging economic
   incentives in more decentralized economic systems which are driven
   predominantly by the needs and initiatives of businesses or local
   community, and administrative mandates in relatively centralized
   governance environments. The study emphasizes the importance of
   developing facilitation approaches adapted to diverse institutional
   contexts for promoting IS and the cross-learnings between these models
   potentially advancing implementation.},
