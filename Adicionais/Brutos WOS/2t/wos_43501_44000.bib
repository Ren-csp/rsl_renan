@article{ WOS:000261618100016,
Author = {Markovits, Yannis and Ullrich, Johannes and van Dick, Rolf and Davis,
   Ann J.},
Title = {Regulatory foci and organizational commitment},
Journal = {JOURNAL OF VOCATIONAL BEHAVIOR},
Year = {2008},
Volume = {73},
Number = {3},
Pages = {485-489},
Month = {DEC},
Note = {26th International Congress of Applied Psychology, Athens, GREECE, JUL
   16-21, 2006},
Abstract = {We use regulatory focus theory to derive specific predictions regarding
   the differential relationships between regulatory focus and commitment.
   We estimated a structural equation model using a sample of 520 private
   and public sector employees and found in line with our hypotheses that
   (a) promotion focus related more strongly to affective commitment than
   prevention focus, (b) prevention focus related more strongly to
   continuance commitment than promotion focus, (c) promotion and
   prevention focus had equally strong effects on normative commitment.
   Implications of these findings for the three-component model of
   commitment, especially the `dual nature' of normative commitment, as
   well as implications for human resources management and leadership are
   discussed. (c) 2008 Elsevier Inc. All rights reserved.},
