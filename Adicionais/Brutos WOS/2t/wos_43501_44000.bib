@article{ WOS:000482101600016,
Author = {Martin, Leanne and Pahl, Sabine and White, Mathew P. and May, Jon},
Title = {Natural environments and craving: The mediating role of negative affect},
Journal = {HEALTH \& PLACE},
Year = {2019},
Volume = {58},
Month = {JUL},
Abstract = {This paper presents a novel investigation of a conceptual model,
   proposing that increased nature exposure may be associated with lower
   cravings, through reductions in negative affect. A cross-sectional
   online survey (N=149) provided an initial exploration of the
   relationships between various aspects of nature exposure, craving and
   negative affect. Access to gardens/allotments and residential views
   incorporating more than 25\% greenspace were both associated with
   reductions in the strength and frequency of cravings. These associations
   were mediated, to varying degrees, by reductions in negative affect.
   This novel link could have implications for public health and
   environmental protection programmes.},
