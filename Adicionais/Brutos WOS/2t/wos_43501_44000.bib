@article{ WOS:001008403200001,
Author = {Kadyamadare, Grace and Samson, Melanie},
Title = {Thinking Households-How Resident Conceptualisations of Waste, Reclaimers
   and Separation at Source Shape Recycling Practices},
Journal = {URBAN FORUM},
Year = {2024},
