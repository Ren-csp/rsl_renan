@article{ WOS:001047965600001,
Author = {Gutierrez, Fernando},
Title = {`I will stay here': public space and social inequality during the
   COVID-19 pandemic},
Journal = {JOURNAL OF URBAN DESIGN},
Year = {2024},
Volume = {29},
Number = {3},
Pages = {263-279},
Month = {MAY 3},
Abstract = {The implementation of city lockdowns in response to the COVID-19
   pandemic exposed some social inequalities in Mexico. The paper evaluates
   the effects of the closure of the Alameda Central, a public park in the
   Historic Centre of Mexico City. It examines how its closure affected
   some vulnerable populations, including homeless people, beggars, street
   vendors, buskers, and male sex workers, to the extent that they resisted
   leaving or found ways to return to public space. The research shows how
   Mexican COVID-19 policies tended to overlook the diversity of
   populations making use of public space, and their various necessities.},
