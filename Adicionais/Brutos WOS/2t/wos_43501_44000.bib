@article{ WOS:000704608000006,
Author = {Chicas, Roxana and Xiuhtecutli, Nezahualcoyotl and Dickman, Nathan Eric
   and Flocks, Joan and Scammell, Madeleine K. and Steenland, Kyle and
   Hertzberg, Vicki and McCauley, Linda},
Title = {Cooling Interventions Among Agricultural Workers: Qualitative
   Field-Based Study},
Journal = {HISPANIC HEALTH CARE INTERNATIONAL},
Year = {2021},
Volume = {19},
Number = {3},
Pages = {174-181},
Month = {SEP},
Abstract = {Introduction: Agricultural workers perform intense labor outside in
   direct sunlight and in humid environmental conditions exposing them to a
   high risk of heat-related illness (HRI). To implement effective cooling
   interventions in occupational settings, it is important to consider
   workers' perceptions. To date, an analysis of agricultural workers'
   experience and perception of cooling devices used in the field while
   working has not been published. Methods: Qualitatively data from 61
   agricultural workers provided details of their perceptions and
   experiences with cooling interventions. Results: The participants in the
   bandana group reported the bandana was practical to use at work and did
   not interfere with their work routine. Cooling vest group participants
   agreed that the vest was effective at cooling them, but the practicality
   of using the vest at work was met with mixed reviews. Conclusion: The
   findings of this qualitative study support and extend existing research
   regarding personal cooling and heat prevention research interventions
   with vulnerable occupational groups. Personal cooling gear was well
   received and utilized by the agricultural workers. Sustainable heat
   prevention studies and governmental protection strategies for
   occupational heat stress are urgently needed to reduce the risk of
   heat-related morbidity, mortality, and projected climate change health
   impacts on outdoor workers.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
