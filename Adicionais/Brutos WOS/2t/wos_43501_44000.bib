@article{ WOS:001549746700002,
Author = {Dionisio, Tiago and Bernardo, Fatima and Loupa-Ramos, Isabel and van den
   Driessche, Jef and Van Eetvelde, Veerle},
Title = {Understanding intergroup relationships in public space through
   systematic observation / Comprensión de las relaciones intergrupales
   en el espacio público mediante la observación sistemática},
Journal = {PSYECOLOGY-BILINGUAL JOURNAL OF ENVIRONMENTAL PSYCHOLOGY-REVISTA
   BILINGUE DE PSICOLOGIA AMBIENTAL},
Year = {2024},
Volume = {15},
Number = {3, SI},
Pages = {296-325},
Month = {OCT},
Abstract = {This research focuses on exploring the intergroup relationship between
   migrants and natives through their use of public spaces. To comprehend
   these intergroup dynamics in a place, two case studies were analysed: an
   urban context in Belgium and Portugal. Through a systematic observation
   method, behavioural maps were collected to comprehend the distribution
   of natives and migrants in those areas, at different times of the day
   and their types of behaviours. Results showed that in the Belgian urban
   area, there is a sharing of the public space but with different
   behaviours, while in Portugal, we found a distribution of apparently
   migrant groups in space. In sum, the systematic observation of people in
   the public space provides a first assessment of the intergroup relations
   between migrants and natives in the urban context. It presents evidence
   to plan and design public space, promote social cohesion and comprehend
   what elements are relevant to maintain and adjust these groups' place
   identity.
   Esta investigaci \& oacute;n se centra en explorar la relaci \& oacute;n
   intergrupal entre inmigrantes y nativos a trav \& eacute;s de su uso de
   los espacios p \& uacute;blicos. Para comprender estas din \&
   aacute;micas intergrupales en un lugar, se analizaron dos estudios de
   caso: un contexto urbano en B \& eacute;lgica y Portugal. Mediante un m
   \& eacute;todo de observaci \& oacute;n sistem \& aacute;tica, se
   recogieron mapas de comportamiento para comprender la distribuci \&
   oacute;n de nativos e inmigrantes en esas zonas, en diferentes momentos
   del d \& iacute;a, y los tipos de comportamiento de unos y otros. Los
   resultados mostraron que en el \& aacute;rea urbana belga se comparte el
   espacio p \& uacute;blico pero con comportamientos diferentes, mientras
   que en Portugal encontramos una distribuci \& oacute;n de grupos
   aparentemente inmigrantes en el espacio. En resumen, la observaci \&
   oacute;n sistem \& aacute;tica de personas en el espacio p \&
