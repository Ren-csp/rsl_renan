@article{ WOS:000438336400002,
Author = {Osorio Garcia, Maribel and Villalon Arias, Aimee Victoria and Serrano
   Barquin, Rocio del Carmen and Mendoza Ontiveros, Martha Marivel and
   Saldana Ortega, Oliver Adair},
Title = {The Perception of Impacts of Tourism in the Ixtapa-Zihuatanejo
   Community, Mexico, from the Causal Maps Model},
Journal = {ROSA DOS VENTOS-TURISMO E HOSPITALIDADE},
Year = {2018},
Volume = {10},
Number = {3},
Pages = {441-463},
Month = {JUL-SEP},
Abstract = {The objective of this paper is to analyze the perception of the
   inhabitants of the Integrally Planned Center of Ixtapa-Zihuatanejo,
   Guerrero, Mexico, about the impacts generated by tourism, its
   repercussions on the well-being of the population and their causal
   relationships. The theoretical-methodological model chosen for the
   research was that of the causal maps, based on the Analysis of Social
   Networks. The survey and the interview with a focus group were used as
   techniques. It was identified that the main perceived impacts are the
   improvement of wellbeing thanks to tourist jobs, the accelerated and
   chaotic urban growth and high environmental pollution, the latter two
   serving as causal nodes of other impacts, such as the shortage of public
   services, insecurity and obtaining certifications.},
