@article{ WOS:000382956500004,
Author = {Evenson, Kelly R. and Shay, Elizabeth and Williamson, Stephanie and
   Cohen, Deborah A.},
Title = {Use of Dog Parks and the Contribution to Physical Activity for Their
   Owners},
