@article{ WOS:001601094900001,
Author = {Hardmeier, M. and Berthold, A. and Siegrist, M.},
Title = {The impact of information on fossil fuel beliefs and risk-benefit
   perception: results from an intervention study},
Journal = {JOURNAL OF RISK RESEARCH},
Year = {2025},
Volume = {28},
Number = {11},
Pages = {1258-1278},
Month = {NOV 2},
Abstract = {Despite the widespread awareness of the negative impacts of fossil fuels
   on the environment and health, the transition away from fossil fuels
   remains a significant challenge. This research examines whether
   emphasizing their historical contributions to societal development
   evokes gratitude, potentially offering insights into the psychological
   processes fostering resistance to energy transitions. We conducted an
   online intervention study (n = 897) in which the participants of our
   intervention group were asked to reflect on the historical contributions
   of fossil fuels to human life. We then assessed their beliefs about
   fossil fuels and compared their scores with those of a control group. We
   found that raising awareness of the historical contributions of fossil
   fuel increased gratitude towards fossil fuels but had no effect on other
   fossil fuel-related beliefs (environmental, health, and socioeconomic).
   Our path model illustrates how these different beliefs influence
   acceptance of fossil fuel utilization via risk and benefit perceptions.
   While the intervention led to an increase in gratitude, benefit
   perception, and risk perception, the overall acceptance of fossil fuels
   remained low. This indicates that attitudes toward fossil fuels are
   relatively stable, despite increasing the salience of positive aspects.
   We discuss that policymakers should provide thorough and balanced
   information to foster informed discussions on fossil fuels, without
   fearing that mentioning positive aspects will drastically shift public
   attitudes.},
