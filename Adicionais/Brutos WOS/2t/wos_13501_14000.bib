@article{ WOS:001745597300001,
Author = {Edensor, Tim and Warnaby, Gary},
Title = {Continuity and change in urban space: Materiality, commemoration, rhythm
   and commerce in St Ann's Square, Manchester},
Journal = {JOURNAL OF HISTORICAL GEOGRAPHY},
Year = {2026},
Volume = {92},
Pages = {36-49},
Month = {JUN},
Abstract = {Though they have taken a variety of forms and served numerous functions,
   urban squares have been integral elements in the urban fabric since
   antiquity. This paper explores how squares are key spaces in which a
   host of historic continuities persist but also registers how they are
   also sites of dynamic change. Our account draws out these contrasting
   attributes by focusing on the more than 300-year-old St Ann's Square in
   central Manchester, UK. We examine four areas that demonstrate these
   continuities and transformations over the centuries. First, we
   investigate the durable and changing material composition of the square.
   Second, we look at how St Ann's has long served as a site for
   commemoration, containing successively installed, diverse memorials that
   change in meaning. Third, we analyse the fluctuating and reiterative
   movements and events that take place in the square. Fourth, we track how
   the retail mix within the square has shifted and endured over the
   centuries. We conclude by considering how our discussion can inform
   wider approaches to historical research. (c) 2026 The Author(s).
   Published by Elsevier Ltd. This is an open access article under the CC
   BY license (http://creativecommons.org/licenses/by/4.0/).},
