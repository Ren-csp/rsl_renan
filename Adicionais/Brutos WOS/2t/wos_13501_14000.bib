@article{ WOS:001814465600001,
Author = {Klaniczay, Janos and Kadar, Balint},
Title = {Emotion tracking to compare guided and non-guided architectural
   experiences in the post-socialist urban context},
Journal = {WELLBEING SPACE AND SOCIETY},
Year = {2026},
Volume = {11},
Month = {DEC},
Abstract = {Understanding how emotional relationships with the built environment can
   be measured and transformed is an important challenge for research on
   wellbeing, heritage, and urban experience. This study investigates
   whether guided urban walks can influence participants' sense of place in
   a post-socialist urban context and proposes a novel mixed-methods
   approach for tracking emotional responses in an urban context. The
   research was conducted in Pesterzsebet, a suburban district of Budapest,
   Hungary, characterized by contested postwar architectural heritage.
   Thirty architecture students participated in both an individual,
   non-guided walk and a guided urban walk following the same itinerary.
   Data collection combined geotagged photography, geotagged self-reporting
   through selfies, GPS tracking, post-visit questionnaires, and biosensing
   data derived from heart rate variability (HRV) recorded through wearable
   devices. Spatial Points of Emotion helped to compare guided and
   non-guided experiences. Results demonstrate that guided interpretation
   and storytelling significantly influenced participants' perceptions of
   the urban environment. Compared with individual exploration, guided
   walks generated more positive emotional responses, higher emotional
   engagement, and increased appreciation of architectural and spatial
   qualities that were initially overlooked or negatively perceived. The
   integration of biosensing, spatial tracking, and visual self-reporting
   provided a richer understanding of how emotional responses vary across
   urban environments and how heritage narratives shape these responses.
   The findings suggest that guided urban walks function as
   experience-based learning activities capable of fostering sense of place
   and revalorizing contested heritage. Methodologically, the study
   advances emotion-tracking research by demonstrating the value of
   combining physiological, spatial, and visual data to investigate
   human-environment relationships in urban settings.},
