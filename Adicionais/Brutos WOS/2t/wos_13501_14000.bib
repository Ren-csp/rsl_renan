@article{ WOS:000768766700003,
Author = {Franco Alvarez, Evelia and Urosa Domingo, Jesus M. and Gil Ares, Javier
   and Barakat Carballo, Ruben O. and Refoyo Roman, Ignacio},
Title = {Healthy environments and quality of life. Study ``Healthy Cities{''}},
Journal = {CULTURA CIENCIA Y DEPORTE},
