Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {González, E (Corresponding Author), Czech Univ Life Sci Prague, Fac Environm Sci, Dept Ecol, Kamycka 129, Prague 16500, Czech Republic.
