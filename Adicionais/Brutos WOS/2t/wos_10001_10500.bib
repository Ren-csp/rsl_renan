@article{ WOS:001277012800001,
Author = {Qi, Li and Hu, Yuanman and Bu, Rencang and Li, Binglun and Gao, Yue and
   Li, Chunlin},
Title = {Evaluation of the Thermal Environment Based on the Urban Neighborhood
   Heat/Cool Island Effect},
Journal = {LAND},
