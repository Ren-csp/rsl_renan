@article{ WOS:001299085400001,
Author = {Mohammed, Ibrahim and Guillet, Basak Denizci},
Title = {Heuristics and biases in human-algorithm interaction and hotel revenue
   management override decision-making},
Journal = {INTERNATIONAL JOURNAL OF CONTEMPORARY HOSPITALITY MANAGEMENT},
