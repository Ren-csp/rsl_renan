@article{ WOS:001821578200013,
Author = {Nyongolo, Musoka and Lubinda, Florence and Nyimbili, Penjani Hopkins and
   Nguvulu, Alick and Kilundo, Anastasia and Mwanaumo, Erastus M.},
Title = {Cloud-Resilient Forest Monitoring for Sustainable Urban Land Management:
   L-Band SAR Assessment of Charcoal-Driven Peri-Urban Woodland in Lusaka,
   Zambia},
Journal = {JOURNAL OF CONTEMPORARY URBAN AFFAIRS},
Year = {2026},
Volume = {10},
Number = {1},
Pages = {272-285},
Abstract = {Rapid urban growth in sub-Saharan Africa is intensifying pressure on
   forest areas surrounding major cities. In Lusaka, with a metropolitan
   population of approximately 3.32 million growing at 4.5\% annually,
   peri-urban miombo woodlands supply charcoal and farmland, yet these
   areas are hardest to monitor during the five-month rainy season when
   cloud cover exceeds 80\% and optical satellite imagery fails. This study
   examines whether L-band Synthetic Aperture Radar can provide year-round
   woodland monitoring and whether such a workflow is financially practical
   for a resource-limited African city. A 17-year ALOS/PALSAR time series
   (2007-2024) for Lusaka National Park was analysed using QGIS and Python,
   combining multi-temporal statistics, a GEDIcalibrated Random Forest
   biomass model (R2 = 0.76), and a disturbance indicator. The approach
   achieved 85.4\% classification accuracy and a 31\% cost reduction over
   conventional ground monitoring, demonstrating an operationally feasible,
   open-source SAR monitoring framework for African urban governance
   contexts.},
