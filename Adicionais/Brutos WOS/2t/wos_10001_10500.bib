@article{ WOS:000603243700001,
Author = {Garcia, Andres M. and Sante, Ines and Loureiro, Xurxo and Miranda, David},
Title = {Spatial Planning of Green Infrastructure for Mitigation and Adaptation
   to Climate Change at a Regional Scale},
Journal = {SUSTAINABILITY},
Year = {2020},
Volume = {12},
Number = {24},
Month = {DEC},
Abstract = {Green infrastructure has acquired greater importance in recent years in
   relation to climate change adaptation. Green infrastructure planning has
   been identified as a new and innovative means of land planning that can
   contribute to preventing the impacts of climate change. However, this
   has been explored more thoroughly in urban areas than at the regional
   scale. The present study proposes a methodology including multi-criteria
   evaluation techniques for assessing the ESS involved in the fight
   against climate change and for the spatial planning of multifunctional
   green infrastructure areas based on the results of this assessment.
   Application of the methodology for green infrastructure planning aimed
   at confronting climate change at landscape level in the region of
   Galicia (NW Spain) successfully delimited multifunctional green
   infrastructure zones. Results show that delimited zones have a higher
   provision potential for more ESS than protected natural areas and areas
   that are not part of the green infrastructure.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
