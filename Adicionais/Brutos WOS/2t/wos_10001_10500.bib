@article{ WOS:001814922200001,
Author = {Karlsson, Anna Marlene},
Title = {Beyond the nature-culture divide? Recent shifts in Norwegian heritage
   policy},
Journal = {INTERNATIONAL JOURNAL OF CULTURAL POLICY},
Year = {2026},
Month = {2026 JUL 8},
Abstract = {In the light of recent climate changes challenges and an increased
   awareness of the nature-culture engtanglements of heritage, this article
   examines how recent Norwegian heritage policy addresses the relation
   between nature and culture in the context of climate change adaptation,
   sustainability, and legislative reform. Drawing on an analysis of the
   latest whitepaper and the proposal for a new Cultural Environment Act,
   the article traces the shift toward more integrated and relational
   understandings of heritage. While policy language increasingly frames
   cultural environments as shaped by long-term interactions between humans
   and the environment, the analysis finds that value hierarchies and legal
   frameworks remain primarily anthropocentric. The article concludes that,
   despite a more holistic vocabulary, Norwegian heritage governance
   continues to reproduce the institutional and conceptual separation of
   natural and cultural heritage. It argues that to bridge this divide will
   require not only coordinated governance and expertise across sectors,
   but also a more fundamental recognition of more-than-human interests and
   agency in heritage governance.},
