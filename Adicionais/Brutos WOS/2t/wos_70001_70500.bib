
@article{ WOS:001579221100005,
Author = {Kerebo, Kelifa Ahmed and Bizuneh, Yechale Kebede and Mekonnen, Abren
   Gelaw and Mohammed, Yimer},
Title = {Assessment of farmers' local adaptation strategies to climate
   variability impacts in Hulbarag district Ethiopia},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {6},
Number = {1},
Month = {SEP 25},
Abstract = {The study aims to assess the local adaptation measures used by farmers
   to cope with the impacts of climate variability in the Hulbarag
   district, Silte zone, central Ethiopia. Purposive, stratified, and
   systematic random sampling techniques were employed to collect primary
   data from a household survey of 207 household heads through
   well-administered questionnaires, focus group discussions, and key
   informant interviews. The weighted average index method and multinomial
   logistic regression were used for analyzing farmers' adaptation index
   and determinants of adaptation efficacy status. The findings show that
   83.5\% of the participants have responded to the impacts of climate
   variability by utilizing at least one adaptation technique. However,
   16.5\% of the participants didn't employ any type of adaption technique.
   Fertilization and manure application, migration, and rainwater
   harvesting were the three most common adaptation strategies. Yet, 46\%
   of respondents indicated that their adaptation measures are not
   effective at reducing the negative consequences of climate variability.
   The effectiveness of adaptation is significantly influenced by
   agroecological zones, farmers' perceptions of the effects of climate
   variability, and their trust in climate information. Lack of input
   resources, lack of information, and lack of water have been identified
   as major obstacles to adaptation efforts. Programs aimed at improving
   the climate resilience of maize and wheat-growing communities should pay
   close attention to the value of reliable climate information, improving
   input resources access and adaptation skills. It is also advised to
   improve adaptation capacity in the research area's agroecological zones
   under site-specific alternative priorities. The use of indigenous
   drought-tolerant crops such as sorghum should be encouraged to help
   farmers who grow maize and wheat meet their food needs and maintain
   their livelihoods during the dry spell.},
