@article{ WOS:000517783300412,
Author = {Soriano-Ayala, Encarnacion and Cala, Veronica C. and Dalouh, Rachida},
Title = {Adolescent Profiles According to Their Beliefs and Affinity to Sexting.
   A Cluster Study},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {3},
Month = {FEB 1},
Abstract = {Sexting consists of sending, receiving, and distributing images of
   sexually suggestive content through electronic devices. This practice is
   one of the new ways of linking sex affectively through virtual
   environments, especially in adolescence. However, not all young people
   have the same relationship with the practice of sexting. This study of a
   sample of 603 Spanish and Moroccan adolescents residing in Andalusia
   analyzes beliefs towards sexting as part of a virtual sexuality and the
   perception of those who carry it out, defining profiles of affinity to
   sexting. The cluster analysis reveals the existence of three predominant
   profiles: adolescents who show a sexting-philia, perceiving it as a fun,
   flirty, and daring practice; sexting-phobes, who consider sexting to be
   characteristic of people, or attitudes, who are desperate, impolite, and
   conflicting; and a third ambivalent profile of people who appreciate the
   practice as something fun but conflicting. The majority discourse is one
   that presents a positive view of this phenomenon. Young people also
   recognize that sexting has some characteristics of virtual sexuality,
   such as a loss of privacy and a distance between virtual and real
   behavior. These findings allow us to deepen our understanding of the new
   practices of relationships and offer measures for the prevention of the
   associated risks.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Soriano-Ayala, E (Corresponding Author), Univ Almeria, Dept Res Methods Educ, Almeria 04120, Spain.
   Soriano-Ayala, Encarnacion; Cala, Veronica C.; Dalouh, Rachida, Univ Almeria, Dept Res Methods Educ, Almeria 04120, Spain.},
DOI = {10.3390/ijerph17031087},
Article-Number = {1087},
EISSN = {1660-4601},
Keywords = {sexting; adolescence; clusters analysis; Spanish; Moroccan},
Keywords-Plus = {IMMIGRANT ADOLESCENTS; TEEN; PREVALENCE; SPANISH; CONTEXTS; WOMENS;
   GIRLS},
