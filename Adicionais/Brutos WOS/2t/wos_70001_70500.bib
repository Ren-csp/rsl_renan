@article{ WOS:001287278100001,
Author = {Suzuki, Daichi G.},
Title = {Toward a solid philosophical foundation of animal consciousness
   research: bridging some conceptual gaps},
Journal = {ADAPTIVE BEHAVIOR},
Year = {2025},
