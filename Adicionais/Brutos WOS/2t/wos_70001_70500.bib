@article{ WOS:001223835400004,
Author = {Wu, Z. F. and Zhao, X. Q.},
Title = {Reducing construction noise: sound masking effect on soundscape
   dominated by construction noise},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL SCIENCE AND TECHNOLOGY},
Year = {2025},
Volume = {22},
