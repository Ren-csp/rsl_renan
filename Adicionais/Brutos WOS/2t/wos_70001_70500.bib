@article{ WOS:001640972100001,
Author = {Martin, Alexander J. F. and Conway, Tenley M. and Klein, Ryan W. and
   Koeser, Andrew K. and Hauer, Richard J.},
Title = {Variability and bias in likelihood of urban tree failure ratings},
Journal = {URBAN FORESTRY \& URBAN GREENING},
Year = {2026},
Volume = {116},
Month = {FEB},
Abstract = {Tree risk assessors consider the likelihood of failure (LoF), the
   likelihood of impact, and the consequence of failure. Despite the need
   for replicable assessments, variability in LoF ratings among assessors
   remains underexamined. To address this gap, we designed an online survey
   that included photos and descriptions of nine trees, including different
   scenarios to test whether LoF ratings changed with factors like the
   presence of targets or based on the client's level of concern. A total
   of 702 Canadian and US tree risk assessors participated. We found that
   qualitative ratings (0 - 100) can be associated with quantitative
   ratings as Improbable: <= 24; Possible: 25 54; Probable: 55 - 79; and
   Imminent: >= 80. LoF ratings decreased with increasing latitude and
   among ISA Tree Risk Assessment Qualified (TRAQ) credential holders but
   increased with the perceived riskiness of walking alone at night, one of
   the three health risk perceptions tested in the study. LoF rating
   deviation decreased among TRAQ credential holders but increased
   alongside years of experience and perceived riskiness of not wearing a
   seatbelt while driving. LoF ratings did not differ between most tree
   scenarios. However, despite viewing the exact same photos of Tree 9,
   respondents told to retrospectively assess LoF after the limb had failed
   rated the LoF higher than the control group (non-retrospective ratings).
   When examining the qualitative ratings, Tree 9 scenarios remained
   significant and Tree 7 became significant with qualitative ratings
   increasing when the client was concerned about the risk and liability of
   the tree. The findings support training to improve assessment
   replicability and reliability.},
