@article{ WOS:000458981700027,
Author = {Burke, Farkhunda and Hamza, Salma and Naseem, Shahid and Nawaz-ul-Huda,
   Syed and Azam, Muhammad and Khan, Imran},
Title = {Impact of Cadmium Polluted Groundwater on Human Health: Winder,
   Balochistan},
