@article{ WOS:001525908000003,
Author = {Odunola, Olaitan Olutayo and Akinyemi, Ruth Bosede and Idowu, Kayode
   Ayomide and Morenikeji, Timothy Oluseye and Ishatah, Grace Charles},
Title = {Uncovering the health effects of sick building syndrome: a study of
   housing conditions in Ibadan North-East, Nigeria},
Journal = {DISCOVER SOCIAL SCIENCE AND HEALTH},
Year = {2025},
Volume = {5},
Number = {1},
Month = {JUL 9},
Abstract = {A house is more than just a physical structure; its conditions have a
   significant impact on our physical and mental health as well as our
   general quality of life. Housing issues and sick building syndrome have
   complex dynamics. This study dissects the intricate connections between
   housing conditions and sick building syndrome in the Ibadan North-East
   Local Government Area. A questionnaire was administered to two hundred
   respondents through systematic random sampling technique. Data collected
   was coded, computed, and analyzed through the Statistic Package for
   Social Sciences (SPSS), which was further presented using descriptive
   statistics. Also, four (4) indices were developed using the Likert
   scale: condition index (CI), indicator index (II), factor index (FI),
   and preventive index (PI).Building components like `Foundation' (CI =
   3.62), `windows and doors' (CI = 3.06), `wall' (CI = 3.01),
   `toilet/sewerage' (CI = 3.00), `floor' (CI = 2.98), and `roof' (CI =
   2.97) were in good condition; however, 43.0\% of the respondents
   revealed that the overall condition of their buildings was in poor
   condition. Headaches, respiratory discomfort, reduced cognitive
   function, lower overall life satisfaction, and anxiety were the major
   indicators of sick building syndrome in the study area, with II values
   of 4.83, 4.74, 4.62, 4.54, and 4.46, respectively. While physical
   (89.0\%) and psychological (9.5\%) were the major effects of SBS on the
   residents. Airborne allergens (FI = 4.94), poor ventilation (FI = 4.86),
   inadequate cleaning practices (FI = 4.71), poor maintenance (FI = 4.63),
   temperature and humidity (FI = 4.60), and occupant density (FI = 4.59)
   are factors responsible for SBS in the study area. Ventilation
   improvement (PI = 4.48), regular cleaning (PI = 4.45), natural light
   exposure (PI = 4.43), and encouraging healthy practices (PI = 4.27) are
   preventive measures adopted by the residents to mitigate SBS. This study
   recommends a multifaceted approach to urban sustainability, including
   targeted building revitalization efforts, structured community
   engagement programs, widespread public awareness campaigns, policy
   advocacy for green building adoption, and strengthened interdisciplinary
   collaboration between urban planners, architects, environmental
   scientists, and other relevant professionals. This study highlighted the
   pressing need for a proactive urban planning approach to the healthy
   living of the residents of the study area. The emphasis was laid on the
   significant impact of substandard housing on residents' health,
   resulting in the prevalence of SBS-related symptoms.},
