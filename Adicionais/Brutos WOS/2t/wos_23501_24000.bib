@article{ WOS:001822998300001,
Author = {Quang, Nguyen Thanh and Ngoc, An Minh and Nguyen-Ngoc, Doanh and Truong,
   Nguyen Huu and Minh, Chu Cong and Hieu, Nguyen Minh},
Title = {Inclusion and equity from accessibility lens: A study of public transit
   planning practice in mid-sized urban contexts in developing countries},
Journal = {JOURNAL OF URBAN MOBILITY},
Year = {2026},
Volume = {10},
Month = {DEC},
Abstract = {While inclusion is widely acknowledged as a core principle in mobility
   planning, it is often inadequately addressed in public transit systems
   in mid-sized urban contexts. This paper presents the results of an
   empirical study examining accessibility and equity issues in public
   transit practice, using the bus network in Khanh Hoa as a case study.
   The findings show that only 41.2\% of the population is located within
   transit-supportive areas under the current public transit network,
   reflecting very limited accessibility to essential services such as
   education and medical facilities. Using the Level-of-Service (LOS)
   metrics, where LOS A represents the highest and LOS F the lowest service
   quality, to evaluate accessibility, the analysis draws a picture of
   inequity in public transport accessibility, where lower-income groups
   are more excluded. In general, only 14.8\% of the population resides in
   areas classified as LOS A and B, whereas nearly 60\% live in zones with
   LOS F, highlighting a substantial deficit in essential mobility
   provision. High-income groups represent more than half of the total
   population benefiting from LOS A, while only 15\% of them fall within
   LOS F, compared with the overall average. In contrast, lower-income
   groups are disproportionately concentrated in poorly served transit
   areas, indicating that public transport provision tends to be less favor
   poorer neighbourhoods. The calculated Palma ratio further confirms this
   imbalance. The ratio of three reflects a severe concentration of
   accessibility benefits among higher-income residents. This evidence
   suggests that current transport planning outcomes reinforce
   socio-economic inequity rather than mitigate it. These findings call for
   attention toward improving social equity in public transport planning
   projects in mid-sized urban contexts in developing countries.},
