@article{ WOS:000463313200001,
Author = {Furlan, Cristina and Dirks, Rene A. M. and Thomas, Peter C. and Jones,
   Robert C. and Wang, Jing and Lynch, Mark and Marks, Hendrik and
   Vermeulen, Michiel},
Title = {Miniaturised interaction proteomics on a microfluidic platform with
   ultra-low input requirements},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {APR 4},
Abstract = {Essentially all cellular processes are orchestrated by protein-protein
   interactions (PPIs). In recent years, affinity purification coupled to
   mass spectrometry (AP-MS) has been the preferred method to identify
   cellular PPIs. Here we present a microfluidic-based AP-MS workflow,
   called on-chip AP-MS, to identify PPIs using minute amounts of input
   material. By using this automated platform we purify the human Cohesin,
   CCC and Mediator complexes from as little as 4 micrograms of input
   lysate, representing a 50-100-fold downscaling compared to regular
   microcentrifuge tube-based protocols. We show that our platform can be
   used to affinity purify tagged baits as well as native cellular proteins
   and their interaction partners. As such, our method holds great promise
   for future biological and clinical AP-MS applications in which sample
   amounts are limited.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
