@article{ WOS:001838384900001,
Author = {Neumann, Nikolas and Janssen, Ulrike and Krzywinski, Jens},
Title = {Consumer acceptance of packaging made from post-consumer recycled
   polyolefin plastics (PCR-PO) in the food and cosmetics sector:
   influencing factors and convincing environmental arguments},
Journal = {SUSTAINABLE FUTURES},
Year = {2026},
Volume = {12},
Month = {DEC},
Abstract = {Despite the potential of packaging made from polyolefin-based
   post-consumer recycled plastic (PCR-PO) for a circular economy, it is
   often not used in the food and cosmetics sector. with regard to the role
   consumers play in this, three questions arise: What are the decisive
   factors for the acceptance of PCR-PO packaging? How are they justified?
   Can corresponding acceptance barriers be broken down using environmental
   arguments? A guideline interview and a card ranking with physical
   stimulus material made of PCR-PO plastic were carried out in this study.
   The results of the study suggest that the use of PCR-PO plastic is
   rather accepted in the cosmetics sector than in the food context. In the
   food sector, PCR-PO packaging that is too dark and too rough could lead
   to acceptance problems. With regard to the persuasive power of
   environmental arguments on PCR-PO packaging, emphasizing ecological
   benefits in terms of resources and circularity-detailed and
   quantified-seems to be advantageous over other ecological arguments.},
