Title = {IN TRAIN AIR QUALITY ANALYSIS OF THE PUBLIC RAILWAY TRANSIT AND PUBLIC
   PERCEPTION ON IN-TRAIN AIR QUALITY IN MALAYSIA},
Journal = {JOURNAL OF FUNDAMENTAL AND APPLIED SCIENCES},
Year = {2017},
Volume = {9},
Number = {4, SI},
Pages = {812-827},
Abstract = {This study analyze the trend of in-train air quality in KTM Commuter in
   upstream and downstream lines, identify public's perception and
   knowledge on in-train air quality. Real time monitoring was conducted by
   measuring five indoor air parameters (CO2, CO, PM10, temperature and
   humidity) along Klang Valley Line from SgBuloh until PelabuhanKlang
   station for five consecutive days, together with a survey on IAQ facts
   and symptoms related to indoor air pollutants among 129 KTM commuter
   passengers. Descriptive and correlation tests were performed using SPSS
   version 23. CO2 and PM 1 0 concentration in most of the time have
   exceeded permissible limit (max = 1449ppm and >0.15mg/m(3)). CO
   concentration was below permissible limit (<10ppm), whilsttemperature
   and humidity were mostly in an acceptable range (23-26 degrees C;
   40-70\%rh).},
