Author = {Reyes, Hector Mendez and Kanev, Stoyan and Doekemeijer, Bart and Van
   Wingerden, Jan-Willem},
Title = {Validation of a lookup-table approach to modeling turbine fatigue loads
   in wind farms under active wake control},
Journal = {WIND ENERGY SCIENCE},
