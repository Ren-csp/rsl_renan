@article{ WOS:000187317300008,
Author = {Ye, YQ and Chen, GJ and Hong, F},
Title = {Impacts of the ``Grain for Green{''} project on rural communities in the
   Upper Min River Basin, Sichuan, China},
Journal = {MOUNTAIN RESEARCH AND DEVELOPMENT},
