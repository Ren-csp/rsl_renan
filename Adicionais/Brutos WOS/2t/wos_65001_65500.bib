@article{ WOS:000353334500034,
Author = {Marlin, Bianca J. and Mitre, Mariela and D'amour, James A. and Chao,
   Moses V. and Froemke, Robert C.},
Title = {Oxytocin enables maternal behaviour by balancing cortical inhibition},
Journal = {NATURE},
Year = {2015},
Volume = {520},
Number = {7548},
Pages = {499+},
Month = {APR 23},
Abstract = {Oxytocin is important for social interactions and maternal behaviour.
   However, little is known about when, where and how oxytocin modulates
   neural circuits to improve social cognition. Here we show how oxytocin
   enables pup retrieval behaviour in female mice by enhancing auditory
   cortical pup call responses. Retrieval behaviour required the left but
   not right auditory cortex, was accelerated by oxytocin in the left
   auditory cortex, and oxytocin receptors were preferentially expressed in
   the left auditory cortex. Neural responses to pup calls were
   lateralized, with co-tuned and temporally precise excitatory and
   inhibitory responses in the left cortex of maternal but not pup-naive
   adults. Finally, pairing calls with oxytocin enhanced responses by
   balancing the magnitude and timing of inhibition with excitation. Our
   results describe fundamental synaptic mechanisms by which oxytocin
   increases the salience of acoustic social stimuli. Furthermore,
   oxytocin-induced plasticity provides a biological basis for
   lateralization of auditory cortical processing.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
Type = {Article},
