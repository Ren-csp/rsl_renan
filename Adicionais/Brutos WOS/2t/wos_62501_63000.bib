@article{ WOS:001851692700005,
Author = {Liordos, Vasilios and Aggelioudakis, Georgios and Kontsiotis, Vasileios
   J.},
Title = {Attitudes toward a flagship caprid, the endangered Cretan agrimi},
Journal = {EURO-MEDITERRANEAN JOURNAL FOR ENVIRONMENTAL INTEGRATION},
Year = {2026},
Volume = {11},
Number = {7},
Month = {AUG 17},
Abstract = {The agrimi (Capra aegagrus cretica), endemic to Crete, Greece, is
   threatened by illegal hunting and hybridization with domestic goats.
   Wildlife conservation cannot succeed without incorporating human
   dimensions into management plans. Therefore, we surveyed the attitudes
   and emotions of 301 Cretans toward the agrimi using face-to-face
   interviews. Most participants (64.1-98.3\%) viewed the agrimi as
   important and worthy of protection (high conservation attitude) and
   accepted management strategies, including controlling illegal hunting
   (93.0\%) and reintroduction (74.1\%) (high management attitude). In
   contrast, most participants (59.5-75.4\%) did not want agrimi kept in
   zoos, farmed, or hunted (low utilization attitude). Most participants
   found the agrimi attractive (82.1\%) and were not afraid of it (72.8\%).
   Structural equation modeling showed significant relationships (p <
   0.05). Management was positively associated with conservation (beta =
   0.431), while utilization was negatively associated with management
   (beta = -0.078). Farmers had higher utilization (beta = 0.129) but lower
   management attitudes (beta = -0.127) than nonfarmers. Rural residents
   had higher utilization (beta = 0.153) and lower conservation attitudes
   (beta = -0.185) than urban residents. Consumptive recreationists
   supported conservation (beta = 0.129) and utilization (beta = 0.116),
   whereas nonconsumptive recreationists supported conservation (beta =
   0.156) and management (beta = 0.195) but not utilization (beta =
   -0.121). Females showed higher conservation attitudes (beta = 0.119) and
   lower utilization attitudes (beta = -0.150) than males. Older
   participants focused more on utilization (beta = 0.139) and less on
   management (beta = -0.118) and conservation (beta = -0.089) than younger
   participants. Participants who considered the agrimi attractive held
   positive conservation (beta = 0.536) and management (beta = 0.378)
   attitudes and negative utilization attitudes (beta = -0.231). Findings
   could be integrated into environmental policies and strategies to
   promote the well-being of the agrimi and the interdependent social and
   natural systems.},
