@article{ WOS:001549994400001,
Author = {Kanyangarara, Mufaro and Vora, Sachi and Seck, Fatima and Dhankhode,
   Neal and Mundagowa, Paddington T.},
Title = {COVID-19 Vaccination Coverage and Associated Factors Among Underserved
   Communities in South Carolina: Results from a Cross-Sectional Study},
Journal = {JOURNAL OF RACIAL AND ETHNIC HEALTH DISPARITIES},
Year = {2025},
Month = {2025 AUG 14},
Abstract = {BackgroundThe effectiveness of COVID-19 vaccines in reducing adverse
   health outcomes is well-documented. However, vaccine uptake remains
   suboptimal, particularly among minority populations in the USA. We
   estimated COVID-19 vaccination coverage and investigated factors
   associated with vaccination status among adults in underserved
   communities in South Carolina.MethodsA cross-sectional survey was
   conducted among barbershop and salon clients (n = 330) in six counties
   from August to November 2023. Data were collected on demographics,
   health status, vaccination history for COVID-19 and the flu, concerns
   regarding COVID-19, and sources of health information. The likelihood of
   partial and full vaccination compared to no vaccination was estimated
   using multinomial logistic regression models.ResultsAbout 19.4\% were
   fully vaccinated, and 54.5\% were partially vaccinated. Not receiving a
   flu vaccine in the past year and worrying about vaccine safety were
   associated with reduced likelihood of partial or full vaccination.
   Increased age and worry about the spread of COVID-19 were associated
   with an increased likelihood of vaccination. Receiving COVID-19-related
   information from family/friends or healthcare providers was associated
   with an increased likelihood of full vaccination but not partial
   vaccination. Religious affiliation, having no chronic health conditions,
   and prior COVID-19 infection were associated with a lower likelihood of
   partial vaccination but not full vaccination.ConclusionThe findings
   highlight public health concerns surrounding vaccination, the influence
   of religion, perceptions of invulnerability, and the role of trusted
   sources in vaccine decision-making. Public health messaging promoting
   vaccination should address these concerns and target populations often
   underserved by conventional healthcare systems.},
