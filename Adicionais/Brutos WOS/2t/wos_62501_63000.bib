@article{ WOS:001067541500001,
Author = {Kujawska, Monika and Zamudio, Fernando and Castillo, Joaquina Alban and
   Sosnowska, Joanna},
Title = {The Relation Between Ashaninka Amazonian Society and Cultivated
   Acanthaceae Plants},
