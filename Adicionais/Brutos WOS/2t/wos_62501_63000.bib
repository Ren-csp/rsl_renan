@article{ WOS:001653979600002,
Author = {Liyanagedara, Pamod H. and Kowalewski, Michal and Tyler, Carrie L.},
Title = {Live-dead fidelity of ecological health indices (AMBI and M-AMBI) in
   benthic marine associations: a case study from coastal North Carolina,
   USA},
Journal = {MARINE ECOLOGY PROGRESS SERIES},
Year = {2025},
Volume = {774},
Pages = {57-72},
Month = {NOV 27},
Abstract = {Recent studies have developed biotic indices, such as AMBI and M-AMBI,
   which commonly employ benthic macroinvertebrates to quantify ecosystem
   health with single numerical values. These indices can be potentially
   applied to the recent fossil record to assess human impacts. We
   evaluated the fidelity of AMBI and M-AMBI using live (LA) and dead (DA)
   benthic assemblages from 52 sites in Onslow Bay, North Carolina, USA,
   where various aspects of the live-dead compositional and functional
   agreement have been previously assessed. AMBI scores were calculated for
   the live and dead assemblages, while M-AMBI scores were computed both
   separately, and by pooling the live and dead assemblages together. A
   Wilcoxon paired-sample signed-rank test revealed significant differences
   in AMBI scores between the DAs and LAs, but no significant differences
   were found for M-AMBI. For AMBI scores, the correlation between the
   whole-community LA and DA was weak and non-significant, whereas M-AMBI
   live and dead scores were positively correlated. Habitat-level grouping
   based on AMBI scores showed weak and insignificant correlations for both
   whole benthic and mollusk-only communities. In contrast, M-AMBI scores
   demonstrated strong and significant correspondence between the LA and DA
   for whole communities. However, this agreement was not significant for
   mollusk-only communities. M-AMBI was more effective than AMBI in
   reconstructing key relationships from DAs. When applied to the fossil
   record, the absolute numerical values of M-AMBI may be less
   interpretable due to time averaging and are most applicable as a
   relative tool in conservation paleobiology studies.},
