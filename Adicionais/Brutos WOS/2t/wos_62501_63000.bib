@article{ WOS:A1993KX81600101,
Author = {RAY, J and PETERSON, DA and SCHINSTINE, M and GAGE, FH},
Title = {PROLIFERATION, DIFFERENTIATION, AND LONG-TERM CULTURE OF PRIMARY
   HIPPOCAMPAL-NEURONS},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
