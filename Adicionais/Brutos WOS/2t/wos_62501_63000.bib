@article{ WOS:000861425700001,
Author = {Amadei, Gianluca and Handford, Charlotte E. and Qiu, Chengxiang and De
   Jonghe, Joachim and Greenfeld, Hannah and Tran, Martin and Martin, Beth
   K. and Chen, Dong-Yuan and Aguilera-Castrejon, Alejandro and Hanna,
   Jacob H. and Elowitz, Michael B. and Hollfelder, Florian and Shendure,
