@article{ WOS:001412814800001,
Author = {Falbova, Darina and Svabova, Petra and Benus, Radoslav and Hozakova,
   Alexandra and Sulis, Simona and Vorobel'ova, Lenka},
Title = {Association Between Self-Reported Lactose Intolerance, Additional
   Environmental Factors, and Bone Mineral Density in Young Adults},
Journal = {AMERICAN JOURNAL OF HUMAN BIOLOGY},
Year = {2025},
Volume = {37},
Number = {1},
Month = {JAN 15},
Abstract = {ObjectivesThis study examines the relationship between self-reported
   lactose intolerance (LI), environmental factors, and their effects on
   bone mineral density (BMD) in young adults from Slovakia. MethodsWe
   assessed 985 adults aged 18-30 years, with an average age of 21.61 +/-
   2.32 years, who were enrolled in this pilot cross-sectional study during
   the period 2019-2023. Individual environmental factors (smoking status,
   alcohol consumption, physical activity, milk and milk product intake,
   and calcium intake) and self-reported LI were assessed using a detailed
   questionnaire. BMD was analyzed using the QUS device (Sunlight
   MiniOmni), and total weight was measured with the InBody 770
   bioimpedance analyzer. ResultsLinear regression analysis showed the
   independent influence of age, total weight, and the presence of LI on
   the speed of sound in meters per second (SOS; m/s) and Z-score
   parameters in women (p < 0.05), whereas in men, age and smoking status
   were significant predictors of SOS (p < 0.05), and age and LI status
   significantly influenced the Z-score (p < 0.05). ConclusionsIn the
   present study of young Slovak adults, the presence of self-reported LI
   and smoking had a negative effect on BMD, resulting in lower BMD in the
   radius.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
