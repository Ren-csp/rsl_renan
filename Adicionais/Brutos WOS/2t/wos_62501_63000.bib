@article{ WOS:001227448800056,
Author = {Li, Anqi and Zhang, Zhenkai and Hong, Zenglin and Liu, Lingyi and Liu,
   Yuanmin},
Title = {Evaluation method for ecology-agriculture-urban spaces based on deep
