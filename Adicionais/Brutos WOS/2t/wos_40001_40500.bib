@article{ WOS:001572887900002,
Author = {Batista, Ozaias Antonio and Souza, Karlla Christine Araujo and da Silva,
   Sylvana Kelly Marques},
Title = {Rural education and poetic imagination: the land as a material element
   of resistance and struggle for life},
Journal = {DIALOGO},
Year = {2025},
Number = {58},
Month = {AUG},
Abstract = {This research offers an interpretation of poetic images found in songs
   embraced by the mystique of rural social movements and the popular poet
   Ant \& ocirc;nio Francisco. The theoretical and methodological
   foundation is based on Gaston Bachelard's symbolism of material
   imagination. The intimate relationship with the land allows both the
   rural worker and the poet to identify with the call emanating from
   movements advocating for rural education, incorporating this experience
   into an educational perspective connected with nature. Through the
   poetics presented, the symbolism of the land becomes a critique of the
   hegemonic social reality, deconstructs the human/nature dichotomy,
   denaturalizes it, and fosters the emancipation of the will.},
