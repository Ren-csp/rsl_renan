@article{ WOS:000371246800005,
Author = {Freisthler, Bridget and Thomas, Crystal A. and Curry, Susanna R. and
   Wolf, Jennifer Price},
Title = {An Alternative to Residential Neighborhoods: An Exploratory Study of How
   Activity Spaces and Perception of Neighborhood Social Processes Relate
   to Maladaptive Parenting},
Journal = {CHILD \& YOUTH CARE FORUM},
Year = {2016},
Volume = {45},
Number = {2},
Pages = {259-277},
Month = {APR},
Abstract = {The environments where parents spend time, such as at work, at their
   child's school, or with friends and family, may exert a greater
   influence on their parenting behaviors than the residential
   neighborhoods where they live. These environments, termed activity
   spaces, provide individualized information about the where parents go,
   offering a more detailed understanding of the environmental risks and
   resources to which parents are exposed.
   This study conducts a preliminary examination of how neighborhood
   context, social processes, and individual activity spaces are related to
   a variety of parenting practices.
   Data were collected from 42 parents via door-to-door surveys in one
   neighborhood area. Survey participants provided information about
   punitive and non-punitive parenting practices, the locations where they
   conducted daily living activities, social supports, and neighborhood
   social processes. OLS regression procedures were used to examine
   covariates related to the size of parent activity spaces. Negative
   binomial models assessed how activity spaces were related to four
   punitive and five non-punitive parenting practices.
   With regards to size of parents' activity spaces, male caregivers and
   those with a local (within neighborhood) primary support member had
   larger activity spaces. Size of a parent's activity space is negatively
   related to use of punitive parenting, but generally not related to
   non-punitive parenting behaviors.
   These findings suggest social workers should assess where parents spend
   their time and get socially isolated parents involved in activities that
   could result in less use of punitive parenting.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Freisthler, B (Corresponding Author), Univ Calif Los Angeles, Luskin Sch Publ Affairs, Dept Social Welf, 3250 Publ Affairs Bldg,Box 951656, Los Angeles, CA 90095 USA.
   Freisthler, Bridget; Thomas, Crystal A.; Curry, Susanna R., Univ Calif Los Angeles, Luskin Sch Publ Affairs, Dept Social Welf, 3250 Publ Affairs Bldg,Box 951656, Los Angeles, CA 90095 USA.
   Wolf, Jennifer Price, Pacific Inst Res \& Evaluat, Prevent Res Ctr, 180 Grand Ave,Suite 1200, Oakland, CA 94612 USA.},
DOI = {10.1007/s10566-015-9329-7},
ISSN = {1053-1890},
EISSN = {1573-3319},
Keywords = {Activity spaces; Neighborhood social processes; Punitive parenting;
   Maladaptive parenting; Non-punitive parenting; Harsh parenting},
