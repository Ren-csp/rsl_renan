@article{ WOS:000532385100006,
Author = {Cheung, Fook Yee and Clatch, Lauren and Wolf, Susan M. and Clayton,
   Ellen Wright and Lawrenz, Frances},
Title = {Key Expert Stakeholder Perceptions of the Law of Genomics: Identified
   Problems and Potential Solutions},
Journal = {JOURNAL OF LAW MEDICINE \& ETHICS},
Year = {2020},
Volume = {48},
Number = {1, SI},
Pages = {87-104},
Month = {MAR},
Abstract = {The law applicable to genomics in the United States is currently in
   transition and under debate. The rapid evolution of the science,
   burgeoning clinical research, and growing clinical application pose
   serious challenges for federal and state law. Although there has been
   some empirical work in this area, this is the first paper to survey and
   interview key scientific and legal stakeholders in the field of genomics
   to help ground identification of the most important legal problems that
   must be solved to successfully integrate genomics into clinical care.
   The respondents in this study identified a wide range of interconnected
   issues, focusing specifically on the need for clear guidelines about how
   to use these data, fear of liability for those who use these data, and
   the need to protect patients from use of this information particularly
   by insurers, while endorsing data sharing. Developing legal strategies
   to support appropriate use of genomics now and in the future clearly
   will require making trade-offs, taking into account the full complexity
   of this legal ecosystem.},
