Pages = {127-137},
Month = {MAY 18},
Abstract = {The tree shrew (Tupaia belangen) is a promising laboratory animal that
   possesses a closer genetic relationship to primates than to rodents. In
   addition, advantages such as small size, easy breeding, and rapid
   reproduction make the tree shrew an ideal subject for the study of human
   disease. Numerous tree shrew disease models have been generated in
   biological and medical studies in recent years. Here we summarize
   current tree shrew disease models, including models of infectious
   diseases, cancers, depressive disorders, drug addiction, myopia,
   metabolic diseases, and immune-related diseases. With the success of
   tree shrew transgenic technology, this species will be increasingly used
   in biological and medical studies in the future.},
