@article{ WOS:000467076900013,
Author = {Gomez Bruna, Diana and Martin Duque, Clara},
Title = {Tourism impacts in Spain: differences between hinterlands and coastal
   areas},
Journal = {CUADERNOS DE TURISMO},
Year = {2019},
Number = {43},
Pages = {325-347},
Month = {JAN-JUN},
Abstract = {This article aims to evaluate the perception of the Spanish residents
   about the economic, sociocultural and environmental impacts that tourism
   generate in Spain. In particular, the article analyse the resident
   percepcion of the impacts in 151 spanish destinations making
   distinctions between coastal destinations and hinterland destinations.
   To this end we have made a one way ANOVA based on 1027 surveys. This
   analysis of the data shows that those resident who live in coastal areas
   perceive more strongly the negatives effects of tourism than those who
   live in hinterlands.},
