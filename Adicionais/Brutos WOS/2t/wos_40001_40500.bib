@article{ WOS:001434990500002,
Author = {Condon, Daphne and Scott, Tyler A. and Smith, Adam B. and Morelli, Toni
   Lyn and Ashraf, Uzma and Mojica, Alex and Chittanuru, Hrithika and Luu,
   Rachel and Bear, Rae and Hernandez, Rebecca R.},
Title = {Practitioners' perceived risks to biodiversity from renewable energy
   expansion through 2050},
Journal = {HUMANITIES \& SOCIAL SCIENCES COMMUNICATIONS},
Year = {2025},
Volume = {12},
Number = {1},
Month = {FEB 27},
Abstract = {Large-scale (e.g., > 1 megawatt capacity) wind and solar energy
   (hereafter, LSWS) developments are increasing to aid decarbonization.
   However, LSWS can also negatively affect biodiversity. Planners and
   other interested parties' perceptions about the impact of LSWS on
   biodiversity will thus affect how trade-offs are managed during planning
   and buildout. We present a survey of professionals (n = 116) working at
   the intersection of LSWS and biodiversity protection across the United
   States concerning: (1) perceived environmental impacts from LSWS
   expansion; and (2) how these impacts compare to other land-use and
   land-cover change drivers. We find that practitioners perceive LSWS to
   impact biodiversity negatively but less so than other land-cover change
   drivers, including fossil fuels and agriculture. This highlights the
   need for increased attention to the role of practitioners in advancing
   renewable energy and biodiversity conservation.},
Publisher = {SPRINGERNATURE},
Address = {CAMPUS, 4 CRINAN ST, LONDON, N1 9XW, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Condon, D (Corresponding Author), Univ Calif Davis, Land Air \& Water Resources Dept, Global Ecol \& Sustainabil Lab, Davis, CA 95616 USA.
   Condon, D (Corresponding Author), Univ Calif Davis, Wild Energy Ctr, Davis, CA 95616 USA.
