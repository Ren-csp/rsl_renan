@article{ WOS:001828713000001,
Author = {Maru, Abadi Wereta and Asfaw, Tsyon and Yirga, Gidey and Kidane, Dawit
   and Bauer, Hans},
Title = {Socioeconomic determinants of livestock depredation by carnivores in the
   Omo Valley, Southern Ethiopia},
Journal = {BMC ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {26},
Number = {1},
Month = {JUL 17},
Abstract = {Background Human-carnivore conflict (HWC) is an increasing conservation
   and livelihood challenge worldwide, particularly in rural areas where
   communities depend heavily on livestock and natural resources. Livestock
   depredation by large carnivores causes significant economic losses and
   often leads to negative attitudes toward wildlife conservation. In
   Africa, population growth, agricultural expansion, and habitat
   fragmentation have intensified interactions between humans and
   carnivores, increasing the risk of livestock predation. Factors such as
   seasonal movements, livestock management practices, and proximity to
   protected areas are known to influence the occurrence of conflict.
   However, evidence on how livelihood strategies and seasonal dynamics
   affect human-carnivore conflict in the Omo Valley of Southern Ethiopia
   remains limited, underscoring the need for context-specific studies to
   support effective coexistence strategies. Methods A community-based
   cross-sectional study was conducted in the Omo Valley, Southern
   Ethiopia, from October to December 2023. A total of 147 households were
   selected from villages adjacent to Omo National Park and the Tama
   Community Conservation Area using purposive and convenience sampling
   techniques. Data were collected through face-to-face interviews using a
   pretested structured interviewer-administered questionnaire. Descriptive
   statistics and binary logistic regression were used to identify factors
   associated with livestock depredation, and variables with p < 0.05 in
   the multivariable model were considered statistically significant.
   Result Overall, 36.1\% of households reported livestock loss due to
   carnivores. Spotted hyena was the most frequently reported predator,
   followed by leopard and lion, while African wild dog was least reported.
   Multivariable logistic regression analysis showed that occupation,
   household wealth status, and proximity to the protected area were
   significant predictors of livestock depredation. Pastoralist households
   were significantly more likely to experience livestock loss due to
   carnivores compared with agro-pastoralist households (AOR = 13.4, 95\%
   CI: 2.41-15.64), Household wealth status was also significantly
   associated with livestock depredation, with Poor households had 2.1
   times higher odds of experiencing livestock loss due to carnivores
   compared with rich households (AOR = 2.1, 95\% CI: 1.94-5.08).
   Conclusion and recommendation Livestock depredation by carnivores is
   common in the study area and is strongly influenced by occupation,
   asset-based classification and distance to the national park. Targeted
   conflict mitigation strategies focusing on high-risk households and
   locations are essential for promoting human-carnivore coexistence.
   Clinical trial number Not applicable.},
