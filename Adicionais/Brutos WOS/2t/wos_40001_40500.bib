@article{ WOS:A1997XB82700011,
Author = {Lehrer, PM},
Title = {Psychophysiological hypotheses regarding multiple chemical sensitivity
   syndrome},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {1997},
Volume = {105},
Number = {2},
