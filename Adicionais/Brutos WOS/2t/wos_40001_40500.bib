@article{ WOS:000347549800002,
Author = {Akiyama, Hiroyuki and Suleiman, Monica},
Title = {A new species, Bryobrothera tambuyukonensis (Daltoniaceae,
   Bryopsida), from Sabah, Borneo Island},
Journal = {PHYTOTAXA},
Year = {2015},
Volume = {192},
Number = {1},
Pages = {13-23},
Month = {JAN 7},
Abstract = {We report a new species Bryobrothera tambuyukonensis, based on the
   specimens collected in Sabah, Borneo Island. Phylogenetic analyses with
   plastid (rps4 and trnL-F) and mitochondrial (nad5) genes along with a
   number of morphological features (for example, undulate lamina,
   oblong-lanceolate leaves with a single strong costa reddish brown in
   color, and thick-walled and porose laminal cells) confirmed its
   distinctiveness from B. crenulata and also close relationship to the
   elimbate group comprised of Adelothecium bogotense and Benitotania
   elimbata.},
