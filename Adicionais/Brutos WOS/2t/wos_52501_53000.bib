@article{ WOS:001673046000006,
Author = {Alhamad, Issah M. and Taleb, Hanan and Hashaykeh, Hanan},
Title = {Electric vehicle adoption in Jordan: analyzing consumer motivations and
   barriers},
Journal = {DISCOVER SUSTAINABILITY},
Year = {2025},
Volume = {7},
Number = {1},
Month = {DEC 24},
Abstract = {Global EV adoption continues to rise, but empirical understanding of the
   behavioral and contextual determinants in emerging, energy-dependent
   economies remains limited. This study addresses this gap by examining
   the key drivers and barriers of EV adoption in Jordan through a
   mixed-methods approach that combines a quantitative consumer survey with
   qualitative expert interviews. Statistical analyses, including
   correlation, principal component analysis (PCA), and ANOVA, were applied
   to identify relationships among economic, technological, environmental,
   and social variables. The results reveal that technological reliability,
   charging accessibility, and social perception are the most decisive
   drivers of adoption, while misinformation, uneven infrastructure, market
   price volatility, and uncertainty over new tax policies remain
   significant barriers. The integration of expert perspectives further
   highlights the need for consistent fiscal incentives, credible
   information dissemination, and improved charging coverage to strengthen
   consumer trust. The study provides timely insights for policymakers and
   industry leaders designing balanced strategies to sustain EV adoption
   and advance sustainable mobility in Jordan and comparable emerging
   markets.},
