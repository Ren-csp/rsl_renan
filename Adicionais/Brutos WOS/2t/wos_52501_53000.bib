@article{ WOS:001791282300002,
Author = {Sandoval, Joseph and Temudo, Marina Padrao},
Title = {Dikes in friction: scientific knowledge as a bridge in transdisciplinary
   learning with mangrove swamp rice farmers},
Journal = {AGRICULTURE AND HUMAN VALUES},
Year = {2026},
Volume = {43},
Number = {2},
Month = {JUN 11},
Abstract = {This paper examines how transdisciplinary learning can occur among
   farmers and the roles that scientific knowledge and researchers play in
   this process. It presents a case of constructing earthen dikes to
   reclaim smallholder rice polders from mangrove swamps in Guinea-Bissau.
   As participatory action researchers, we sought to bridge different local
   knowledges on dike construction through collaborative dike-building
   activities. Our findings highlight the diversity and highly contextual
   nature of these knowledges, shaped by socio-environmental factors such
   as labour organisation and soil and vegetation characteristics.
   Frictions between farmers' local knowledges reveal that situated power
   asymmetries can also emerge among farmer groups. We show that
   transdisciplinary learning unfolds across scales, over time, and through
   subtle, friction-laden interactions, as divergences between knowledge
   systems are worked through via situated acts of translation, or making
   sense within each other's frames. Scientific knowledge, in this process,
   functions not as a dominant framework but as a bridging tool that
   supports mutual intelligibility across contexts. We argue that
   transdisciplinary learning does not necessarily occur through the
   integration of knowledge systems, but through partial and iterative
   processes of translation that reconfigure, rather than resolve,
   friction. This calls for a critical rethinking of how learning and
   progress are understood and evaluated in transdisciplinary research and
   practice.},
