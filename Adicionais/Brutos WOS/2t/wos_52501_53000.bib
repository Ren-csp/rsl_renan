@article{ WOS:000296879200005,
Author = {Lau, Jennifer Y. F. and Molyneaux, Emma and Telman, Machteld D. and
   Belli, Stefano},
Title = {The Plasticity of Adolescent Cognitions: Data from a Novel Cognitive
   Bias Modification Training Task},
Journal = {CHILD PSYCHIATRY \& HUMAN DEVELOPMENT},
Year = {2011},
Volume = {42},
Number = {6},
Pages = {679-693},
Month = {DEC},
Abstract = {Many adult anxiety problems emerge in adolescence. Investigating how
   adolescent anxiety arises and abates is critical for understanding and
   preventing adult psychiatric problems. Drawing threat interpretations
   from ambiguous material is linked to adolescent anxiety but little
   research has clarified the causal nature of this relationship. Work in
   adults using Cognitive Bias Modification of Interpretations (CBM-I)
   training show that manipulating negative interpretational style alters
   negative affect. Conversely, `boosting' positive interpretations
   improves affect. Here, we extend CBM-I investigations to adolescents.
   Thirty-nine adolescents (13-18 years), varying in trait anxiety and
   self-efficacy, were randomly allocated to receive positive or negative
   training. Training-congruent differences emerged for subsequent
   interpretation style. Induced negative biases predicted a decline in
   positive affect in low self-efficacious adolescents only. Tentatively,
   our data suggest that cognitive biases predict adolescent affective
   symptoms in vulnerable individuals. The acquisition of positive
   cognitions through training has implications for prevention.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Lau, JYF (Corresponding Author), Univ Oxford, Dept Expt Psychol, Oxford OX1 4AU, England.
   Lau, Jennifer Y. F.; Molyneaux, Emma; Belli, Stefano, Univ Oxford, Dept Expt Psychol, Oxford OX1 4AU, England.
   Telman, Machteld D., Kings Coll London, Inst Psychiat, London WC2R 2LS, England.},
DOI = {10.1007/s10578-011-0244-3},
ISSN = {0009-398X},
EISSN = {1573-3327},
Keywords = {Adolescence; Anxiety; Interpretation style; Cognitive bias modification
   training},
Keywords-Plus = {INTERPRETIVE BIAS; SELF-EFFICACY; EXPERIMENTAL MANIPULATION; MODIFYING
   INTERPRETATION; DEPRESSIVE SYMPTOMS; MENTAL-IMAGERY; ANXIETY; CHILDREN;
