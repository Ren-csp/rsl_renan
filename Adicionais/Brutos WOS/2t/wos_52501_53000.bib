@article{ WOS:000340200700037,
Author = {Shukla, Arun K. and Westfield, Gerwin H. and Xiao, Kunhong and Reis,
   Rosana I. and Huang, Li-Yin and Tripathi-Shukla, Prachi and Qian, Jiang
   and Li, Sheng and Blanc, Adi and Oleskie, Austin N. and Dosey, Anne M.
