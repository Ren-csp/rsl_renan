Author = {Satrianegara, M. Fais and Juhannis, Hamdan and Lagu, Abd Madjid H. R.
   and Habibi and Sukfitrianty and Alam, Syamsul},
Title = {Cultural traditional and special rituals related to the health in Bugis
   Ethnics Indonesia},
