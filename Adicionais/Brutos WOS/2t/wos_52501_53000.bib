@article{ WOS:001822467300001,
Author = {Groothuis, Mees and Salimi, Negin},
Title = {From Waste to Worth: The Case for Modular and Upgradable Electronics in
   a Sustainable Future},
Journal = {BUSINESS STRATEGY AND THE ENVIRONMENT},
Year = {2026},
Month = {2026 JUL 17},
Abstract = {The rapid obsolescence of electronic products poses a major challenge to
   sustainable development due to rising e-waste. Modular and upgradable
   product (MUP) architectures offer a promising approach to extend product
   lifetimes and reduce environmental impact. This study investigates how
   consumer perceptions and behaviours affect the adoption of MUPs,
   focusing on mobile phones and headphones. A mixed-method approach,
   including a survey of 231 participants and interviews with two
   electronics producers, identifies key behavioural drivers and barriers
   to consumer acceptance. The survey was developed using a
   literature-to-design process linking value preferences, obsolescence
   types and product decision factors. While consumers express interest in
   longer lasting products, barriers such as cost, complexity and
   aesthetics persist. The findings also reveal misalignment between
   consumer motivations and producer assumptions, highlighting the need for
   improved design and communication strategies. The study offers insights
   into enhancing circular product strategies through user-centred design
   and contributes to sustainable design, policy and research.},
