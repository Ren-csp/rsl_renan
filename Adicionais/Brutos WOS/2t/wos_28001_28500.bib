@article{ WOS:000410831600002,
Author = {Padilla Salas, Carla and Molina-Murillo, Sergio A.},
Title = {Socio-economic Impact of the Payment for Environmental Services Program,
   Reforestation Mode, in Northwest Costa Rica},
Journal = {AMBIENTE Y DESARROLLO},
Year = {2017},
Volume = {21},
Number = {40},
Pages = {73-91},
Abstract = {The purpose of this study was to evaluate the socioeconomic impact of
   the Payment for Environmental Services Program (PPSA) on beneficiaries
   who managed reforestation-mode contracts between 1998 and 2013 through
   two forest-based organizations (OBF) in northwest Costa Rica. First, we
   identified the socioeconomic characteristics of the beneficiaries and
   established, validated, and applied a set of principles, criteria, and
   indicators to assess the impact of the PPSA on the social and economic
   dimensions. Overall, results indicate that the program has strengthened
   local capabilities for forest development in the area, mainly through
   the active involvement of the OBFs and beneficiaries, although the
   perception of these benefits appears to decrease over time.},
