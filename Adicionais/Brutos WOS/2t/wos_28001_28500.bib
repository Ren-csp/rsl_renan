@article{ WOS:001392797700001,
Author = {Wang, Li and Wang, Cheng and Moriano, Juan A. and Chen, Songcang and
   Zuo, Guolong and Cebrian-Silla, Arantxa and Zhang, Shaobo and Mukhtar,
   Tanzila and Wang, Shaohui and Song, Mengyi and de Oliveira, Lilian Gomes
   and Bi, Qiuli and Augustin, Jonathan J. and Ge, Xinxin and Paredes,
