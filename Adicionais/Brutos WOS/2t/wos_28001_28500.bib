@article{ WOS:001599930900003,
Author = {Strnad, Martin and Tyc, Jiri and Kitzberger, Frantisek and Kopecka, Jana
   and Rego, Ryan O. M. and Vancova, Marie},
Title = {Targeted volume imaging reveals early vascular interactions of Lyme
   disease pathogen in skin},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {OCT 22},
Abstract = {Although the contours of the dissemination pathways of human pathogenic
   spirochetes in the vertebrate hosts are known, detailed high-resolution
   information on these processes remain lacking. In this study, we
   establish an efficient serial block-face scanning electron microscopy
   workflow incorporating semi-automatic AI-driven segmentation to
   investigate the architecture of early events following the deposition of
   Borrelia burgdorferi at the tick bite site in mice. We capture evidence
   of Borrelia penetrating the lymphatic endothelium via both transcellular
   and paracellular routes and observe its early presence within the lumen
   of the lymphatic vessel. The multistep process of transcellular
   migration is documented in detail, showing sequential invagination and
   encasement of shorter Borrelia segments by the lymphatic endothelial
   cells during intravasation. Our findings reveal that the first contact
   of B. burgdorferi and blood vessels is not random but involves close
   interactions with pericytes. We also capture the infiltration of immune
   cells in the skin and their interactions with invading bacteria.
   Altogether, these observations suggest that Borrelia strategically
   targets vascular regions with lower mechanical resistance to breach the
   endothelial barrier, thereby enhancing its dissemination.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Vancová, M (Corresponding Author), Czech Acad Sci, Biol Ctr, Inst Parasitol, Ceske Budejovice, Czech Republic.
