   Mohd-Azlan and Abdullah, Mohd Tajuddin},
Title = {Gastrointestinal parasites of zoonotic importance observed in the wild,
   urban, and captive populations of non-human primates in Malaysia},
Journal = {JOURNAL OF MEDICAL PRIMATOLOGY},
