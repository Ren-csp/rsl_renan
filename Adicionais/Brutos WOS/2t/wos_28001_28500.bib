@article{ WOS:001835439100001,
Author = {Taylor, Stacey and Rayner, Laura and Davey, Chris and Stojanovic, Dejan},
Title = {Living in Australia's capital: nest site selection by a cavity-dependent
   endangered parrot},
Journal = {JOURNAL OF URBAN ECOLOGY},
Year = {2026},
Volume = {12},
Number = {1},
Abstract = {Urban habitat management, including the removal of mature trees, may
   alter the availability of nesting habitat for cavity-nesters in urban
   landscapes. Effective retention of suitable nesting habitat requires
   species-specific data on nest-site requirements, which remain poorly
   quantified. Using climbing surveys, we compared the characteristics of
   trees and cavities used by the Endangered Gang-gang Cockatoo
   (Callocephalon fimbriatum) for nesting, with those of non-nesting trees
   and cavities in urban Canberra, Australia. We also evaluated the
   proportion of available cavities that meet the requirements for
   Gang-gang Cockatoo nesting and evaluated the reliability of ground-based
   cavity counts as a habitat assessment method. We found that Gang-gang
   Cockatoos used deeper cavities with larger entrance sizes and floor
   diameters than most available cavities in the study area, and nesting
   cavities were more likely to be found in trees with more cavities than
   non-nesting trees. Approximately 20\% of unused cavities met the
   suitability criteria for Gang-gang Cockatoo nesting; similar to 80\% of
   those were located in trees already used for nesting. Ground-based
   cavity counts were not a reliable method for determining the true number
   of cavities in trees as they consistently under- or overestimated cavity
   abundance relative to climbing surveys. These findings reinforce that
   animals can be highly selective in the cavities they choose to nest in
   and protecting known nesting trees is essential for maintaining breeding
   habitat for the Gang-gang Cockatoo. Our results also support the need
   for evidence-based urban habitat management that moves beyond
   ground-based assessments of habitat quality toward climbing surveys that
   accurately characterise both cavity availability and suitability.},
