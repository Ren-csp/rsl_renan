@article{ WOS:000336956800005,
Author = {Kervyn, Nicolas and Chan, Emily and Malone, Chris and Korpusik, Adam and
   Ybarra, Oscar},
Title = {NOT ALL DISASTERS ARE EQUAL IN THE PUBLIC'S EYE: THE NEGATIVITY EFFECT
   ON WARMTH IN BRAND PERCEPTION},
Journal = {SOCIAL COGNITION},
Year = {2014},
Volume = {32},
Number = {3},
Pages = {256-275},
Month = {JUN},
Abstract = {Warmth and competence are fundamental dimensions used to characterize
   people, animals, and even corporations. Based on observations from a
   preliminary survey (Study 1) on the impact of scandals on several
   brands, we predicted that an organization that caused a disaster would
   be judged more harshly if its warmth rather than competence reputation
   was called into question. Study 1 surveyed a nationally representative
   sample of American adults and results showed that not all scandals had
   the same consequences on the perception of warmth, competence, and on
