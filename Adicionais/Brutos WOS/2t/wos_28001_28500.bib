@article{ WOS:001309194200001,
Author = {Wang, Xiaoyu and Liu, Qiqi and Yang, Lu and Yang, Qing and Li, Yujiao
   and Yang, Yu and Zhou, Chao and Wang, Xu and Wang, Yang and Gao, Guofu
   and Liu, Wenxiang and Cheng, Ping},
Title = {Perceptions of biomass energy sustainability in policy scenarios of
   China},
Journal = {HELIYON},
Year = {2024},
Volume = {10},
Number = {17},
Month = {SEP 15},
Abstract = {This study examines biomass energy policies in the EU, US, and Japan,
   noting high implementation rates in Poland (86.5 \%) and Finland (90.6
   \%). Germany's biogas utilization is particularly noteworthy, accounting
   for 29.6 \%. The paper summarizes China's national and provincial waste
   biomass management and energization policies, encompassing agriculture,
   biomass energy, and environmental governance aspects. Analyzing China's
   biomass energy industry reveals challenges requiring a comprehensive
   development plan based on waste biomass resources and environmental
   zoning. Proposed solutions include establishing ecological energy
   agriculture demonstration zones, optimizing policies for environmental
   benefits, encouraging technological innovation, establishing a trade
   association, improving standards, setting up a waste biomass fund,
   introducing green certificates and quotas, and integrating waste biomass
   into the national carbon trading system.},
