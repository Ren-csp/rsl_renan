@article{ WOS:001178091600023,
Author = {Wang, Bofei and Reville, Patrick K. and Yassouf, Mhd Yousuf and Jelloul,
   Fatima Z. and Ly, Christopher and Desai, Poonam N. and Wang, Zhe and
   Borges, Pamella and Veletic, Ivo and Dasdemir, Enes and Burks, Jared K.
   and Tang, Guilin and Guo, Shengnan and Garza, Araceli Isabella and
   Nasnas, Cedric and Vaughn, Nicole R. and Baran, Natalia and Deng, Qing
   and Matthews, Jairo and Gunaratne, Preethi H. and Antunes, Dinler A. and
   Ekmekcioglu, Suhendan and Sasaki, Koji and Garcia, Miriam B. and
   Cuglievan, Branko and Hao, Dapeng and Daver, Naval and Green, Michael R.
   and Konopleva, Marina and Futreal, Andrew and Post, Sean M. and Abbas,
   Hussein A.},
Title = {Comprehensive characterization of IFNγ signaling in acute myeloid
   leukemia reveals prognostic and therapeutic strategies},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {FEB 28},
Abstract = {Interferon gamma (IFN gamma) is a critical cytokine known for its
   diverse roles in immune regulation, inflammation, and tumor
   surveillance. However, while IFN gamma levels were elevated in sera of
   most newly diagnosed acute myeloid leukemia (AML) patients, its complex
   interplay in AML remains insufficiently understood. We aim to
   characterize these complex interactions through comprehensive bulk and
   single-cell approaches in bone marrow of newly diagnosed AML patients.
   We identify monocytic AML as having a unique microenvironment
   characterized by IFN gamma producing T and NK cells, high IFN gamma
   signaling, and immunosuppressive features. IFN gamma signaling score
   strongly correlates with venetoclax resistance in primary AML patient
   cells. Additionally, IFN gamma treatment of primary AML patient cells
   increased venetoclax resistance. Lastly, a parsimonious 47-gene IFN
   gamma score demonstrates robust prognostic value. In summary, our
   findings suggest that inhibiting IFN gamma is a potential treatment
   strategy to overcoming venetoclax resistance and immune evasion in AML
   patients.
   IFN gamma signaling is important in the pathogenesis and immune
   response, emphasizing the need for investigation of its role. Here, the
   authors show that IFN gamma plays a key role in shaping immune
   microenvironment in AML and developing resistance, providing insights
   for potential therapeutic strategies.},
