@article{ WOS:001062457500001,
Author = {Jaffe, Anna E. and Blayney, Jessica A. and Jones, Harper R. and
   Stappenbeck, Cynthia A. and George, William H. and Davis, Kelly Cue},
Title = {Sexual Decision Making When Intoxicated: Women's Reasons for and Against
   Having Sex in a Laboratory-Based Scenario},
