Author = {Thomas, Jodi T. and Thorp, Jackson G. and Huider, Floris and Grimes,
   Poppy Z. and Wang, Rujia and Youssef, Pierre and Coleman, Jonathan R. I.
   and Byrne, Enda M. and Adams, Mark and Penninx, Brenda W. J. H. and
   Medland, Sarah E. and Hickie, Ian B. and Olsen, Catherine M. and
   Whiteman, David C. and Whalley, Heather C. and Penninx, Brenda W. J. H.
   and van Loo, Hanna M. and Derks, Eske M. and Eley, Thalia C. and Breen,
   Gerome and Boomsma, Dorret I. and Wray, Naomi R. and Martin, Nicholas G.
   and Mitchell, Brittany L. and BIONIC Consortium},
Title = {Sex-stratified genome-wide association meta-analysis of major depressive
   disorder},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {AUG 26},
Abstract = {There are striking sex differences in the prevalence and symptomology of
   Major Depressive Disorder. Here, we conduct the largest sex-stratified
   genome wide association and genotype-by-sex interaction meta-analyses of
   Major Depressive Disorder to date (Females: 130,471 cases, 159,521
   controls. Males: 64,805 cases, 132,185 controls). We identify 16 and
   eight independent genome-wide significant variants in females and males,
   respectively, including one novel variant on the X chromosome. Major
   Depressive Disorder in females and males shows substantial genetic
   overlap with a large proportion of variants displaying similar effect
   sizes across sexes. However, we also provide evidence for a higher
   burden of genetic risk in females which could be due to female-specific
   variants. Additionally, sex-specific pleiotropic effects may contribute
   to the higher prevalence of metabolic symptoms in females with Major
   Depressive Disorder. These findings underscore the importance of
   considering sex-specific genetic architectures in the study of health
   conditions, including Major Depressive Disorder, paving the way for more
   targeted treatment strategies.},
