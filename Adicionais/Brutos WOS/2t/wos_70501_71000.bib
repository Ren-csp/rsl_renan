@article{ WOS:001853205100001,
Author = {Azhar, Wan Anis Afeeqa Wan Mohammad and Leng, See Too Kay and Muhamad,
   Nurfashareena},
Title = {Social vulnerability and community resilience in Hulu Langat flood-prone
   area, Selangor},
Journal = {JOURNAL OF SAFETY SCIENCE AND RESILIENCE},
Year = {2026},
Volume = {7},
Number = {3},
Month = {SEP},
Abstract = {The Hulu Langat District, known for its dense network of rivers, is
   highly susceptible to flooding, which has had significant impacts on its
   communities. This study explores the relationship between social
   vulnerability factors such as age, health conditions, employment status,
   household income, and access to disaster education and community
   resilience components (connectedness, risk awareness, action planning,
   and resources) in floodprone in Mukim Hulu Langat, Selangor. The
   research involved 100 participants from Kampung Batu 18, Kampung Batu
   20, and Kampung Batu 21 in Mukim Hulu Langat, all of whom were affected
   by the 2021 floods. Data were collected through a combination of online
   and physical survey forms distributed via the heads of households. The
   study identifies key areas of vulnerability and evaluates the
   community's capacity to respond to and recover from flood disasters.
   Results show that age (18-60) enhances social connectedness and resource
   access, while good health supports resilience capacity. Disaster
   education demonstrated the strongest correlations, significantly
   improving connectedness, risk perception, planning, and resource
   mobilization. Employment status moderately influenced connectedness and
   risk awareness, whereas income showed only weak associations. Findings
   highlight that resilience is shaped by the interaction of
   vulnerabilities with institutional and community support. Targeted
   interventions, including disaster education, financial aid and early
   warning systems, are vital. This aligns with Malaysia's disaster risk
   reduction agenda and multiple Sustainable Development Goals (SDGs).
   These findings can support local authorities and related agencies in
   identifying high-risk areas, improving the strategic allocation of aid,
   and refining land-use policies to better mitigate the flood impacts.},
