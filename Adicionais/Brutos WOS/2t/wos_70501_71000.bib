@article{ WOS:001798602800001,
Author = {Delaney, Sara and Schattman, Rachel E. and Anderzen, Janica and Birkel,
   Sean D.},
Title = {Navigating adaptation: a longitudinal study of the layered and iterative
   adoption processes of farmers and advisors in the Northeastern US},
Journal = {ENVIRONMENTAL RESEARCH: FOOD SYSTEMS},
Year = {2026},
Volume = {3},
Number = {3},
Month = {SEP 1},
Abstract = {As climate variability increases, farmers and agricultural advisors must
   continually adapt to maintain viable food systems. To build efficacy for
   climate adaptation, we must understand and support the realities of
   individuals' adaptation processes. We argue here that we should in turn
   make visible the continuous and iterative adaptation processes of both
   farmers and advisors, and depart from previous short-term or
   practice-based approaches. This study investigates the adaptation
   processes of 18 fruit and vegetable growers and 18 professional advisors
   who participated in a Climate Adaptation Fellowship program in the
   Northeast US. Using longitudinal data from surveys and semi-structured
   interviews collected over three years, the study applies an integrated
   theoretical framework combining behavioral adaptation and a multi-stage
   adoption model to examine how adaptation unfolds during and after the
   program. Using a robust, mixed methods approach, we break down
   adaptation into action steps, and in doing so show the prevalence and
   diversity of actions occurring within a modification stage, where
   participants improve or tweak practices and systems over time. Case
   studies of participants illustrate how adaptation processes consisted of
   multiple, layered adoption processes. These processes were slow and
   iterative, as individuals explored, trialed, and evaluated results over
   multiple seasons. Influential factors included disruptive environmental
   stressors, personal values and experiences, as well as institutional and
   social support. Social interactions were salient in both early and later
   stages of adoption as participants drew on their connections to persist
   through challenging processes. These findings suggest that farmer and
   advisor adaptation processes are interdependent, reinforcing the value
   of joint learning and experimentation. This study highlights the need to
   move away from studying and recommending single prescriptive practices
   in the context-specific arena of climate adaptation, and instead focus
   on supporting advisors and farmers to work together on the sustained
   modification needed for effective adaptation in agricultural systems.},
