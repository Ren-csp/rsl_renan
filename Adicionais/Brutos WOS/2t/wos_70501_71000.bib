@article{ WOS:001816058900001,
Author = {Ndacyayisenga, P. and Mukiza, G. and Mbonyubwabo, J. p. and Mugisha, D.
   and Muhimba, I. and Hategekimana, J. b. and Ukwishatse, D. and Rubuga,
   F. k. and Gashaija, A.},
Title = {Hand hygiene compliance among healthcare providers: a cross-sectional
   study of the University Teaching Hospital of Kigali},
Journal = {INFECTION PREVENTION IN PRACTICE},
Year = {2026},
Volume = {8},
Number = {3},
Month = {SEP},
Abstract = {Background: Hand hygiene (HH) is a critical, cost-effective measure to
   prevent healthcare-associated infections. Despite its importance, global
   compliance among healthcare providers remains low at 38.7\%. Few studies
   in Rwanda have examined healthcare providers' knowledge, perception, and
   adherence, and factors influencing compliance remain underexplored. This
   study assessed healthcare providers' HH compliance at the University
   Teaching Hospital of Kigali (CHUK) and identified key influencing
   factors. Methods: A cross-sectional study at the CHUK involved 254
   healthcare providers selected via stratified sampling. Data were
   collected through direct observation using the World Health Organization
   HH observation form and a self-administered questionnaire. Correlation
   and linear regression analyses were conducted using SPSS version 25 to
   identify factors influencing compliance. Results: Overall compliance was
   53.84\%. Compliance was significantly higher among doctors (59.89\%)
   than among nurses (55.71\%) and allied health professionals (38.42\%) (P
   < 0.001). Factors influencing compliance included availability of
   handwashing facilities (r = 0.391, P < 0.01), availability of hand rubs
   (r = 0.124, P = 0.048), presence of facilities at the point of care
   (beta = 17.855, P = 0.040), profession (nurses/midwives: beta = 15.571,
   P < 0.001; doctors: beta = 17.855, P = 0.003), awareness of World Health
   Organization (WHO)-recommended HH moments (beta = 8.332, P = 0.033), and
   receipt of training (beta = 10.600, P = 0.034). Conclusion: The 53.84\%
   compliance highlights the need for improved HH at the CHUK. Facility
   availability and accessibility, awareness of WHO guidelines, and
   training significantly impact compliance. Enhancing these factors is
   crucial for boosting compliance and ensuring patient safety.},
