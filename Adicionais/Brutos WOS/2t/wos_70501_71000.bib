   Botto, Javier F., Univ Buenos Aires, Fac Agron, IFEVA, Buenos Aires, Argentina.
   Consejo Nacl Invest Cient \& Tecn, Buenos Aires, Argentina.},
DOI = {10.1093/aob/mcn138},
ISSN = {0305-7364},
EISSN = {1095-8290},
Keywords = {Arabidopsis thaliana; dormancy; germination; phytochromes;
   very-low-fluence response (VLFR); low-fluence response (LFR); natural
