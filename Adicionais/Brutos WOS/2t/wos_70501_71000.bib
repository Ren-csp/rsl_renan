@article{ WOS:001772556900001,
Author = {Ninnemann, Katja and Keser Aschenberger, Filiz and Cetinkaya-Yildiz,
   Evrim and Apaydin, Seval and Schneidt, Jennifer and Ipser, Christina and
   Radinger, Gregor and Geister, Susanne},
Title = {Unlocking student satisfaction with campus. The role of availability and
   accessibility of informal learning spaces},
Journal = {HIGHER EDUCATION RESEARCH \& DEVELOPMENT},
Year = {2026},
Month = {2026 MAY 22},
Abstract = {The possibility of learning anytime and anywhere has accelerated the
   importance of informal learning spaces (ILS) at universities. A study at
   four European universities examined (1) the usage of ILS on and off
   campus for different learning activities, (2) differences between
   sociodemographic groups with regard to the perceived satisfaction of ILS
   for focused and collaborative learning activities, (3) the influence of
   sociodemographic factors as well as availability and accessibility of
   ILS on student satisfaction with campus, and (4) perceived barriers in
   context of available and accessible ILS. Methodologically, a
   mixed-methods approach was integrated combining a quantitative student
   survey with qualitative focus groups. Quantitative data from 932
   participants reveal that sociodemographic aspects, like gender, age,
   study degree or facing personal challenges, do not influence perceptions
   of satisfaction with ILS for focused and collaborative learning
   activities. As a key finding from the student survey, it can be
   summarized that availability and accessibility of ILS contribute
   positively and significantly to student satisfaction with campus. Beyond
   construction and design improvements of ILS, insights from qualitative
   focus groups with students and lecturers state especially the importance
   of organizational aspects, like providing better information and
   communication to enhance the availability and accessibility of ILS on
   campus.},
