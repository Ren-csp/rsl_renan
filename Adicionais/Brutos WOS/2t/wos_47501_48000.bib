   Dirks, Gary, Arizona State Univ, Coll Global Futures, Tempe, AZ USA.},
DOI = {10.1525/gp.2025.143744},
Article-Number = {143744},
EISSN = {2575-7350},
Keywords = {collaboration; information processing; institution building},
Keywords-Plus = {COLOR CATEGORIES; INTERACTIVE ALIGNMENT; LANGUAGE},
Research-Areas = {Social Sciences - Other Topics},
Web-of-Science-Categories  = {Social Sciences, Interdisciplinary},
