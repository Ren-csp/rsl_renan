@article{ WOS:000327947300001,
Author = {Siu, Karen K. and Sultana, Azmiri and Azimi, Farshad C. and Lee, Jeffrey
   E.},
Title = {Structural determinants of HIV-1 Vif susceptibility and DNA binding in
   APOBEC3F},
Journal = {NATURE COMMUNICATIONS},
Year = {2013},
Volume = {4},
Month = {NOV},
Abstract = {The human APOBEC3 family of DNA cytosine deaminases serves as a
   front-line intrinsic immune response to inhibit the replication of
   diverse retroviruses. APOBEC3F and APOBEC3G are the most potent factors
   against HIV-1. As a countermeasure, HIV-1 viral infectivity factor (Vif)
   targets APOBEC3s for proteasomal degradation. Here we report the crystal
   structure of the Vif-binding domain in APOBEC3F and a novel assay to
   assess Vif-APOBEC3 binding. Our results point to an amphipathic surface
   that is conserved in APOBEC3s as critical for Vif susceptibility in
   APOBEC3F. Electrostatic interactions likely mediate Vif binding.
   Moreover, structure-guided mutagenesis reveals a straight ssDNA-binding
   groove distinct from the Vif-binding site, and an `aromatic switch' is
   proposed to explain DNA substrate specificities across the APOBEC3
   family. This study opens new lines of inquiry that will further our
   understanding of APOBEC3-mediated retroviral restriction and provides an
   accurate template for structure-guided development of inhibitors
   targeting the APOBEC3-Vif axis.},
