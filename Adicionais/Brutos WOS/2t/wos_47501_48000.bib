@article{ WOS:001402207900001,
Author = {Chen, Chen and Hao, Lilan and Wei, Weixia and Li, Fei and Song, Liju and
   Zhang, Xiaowei and Dai, Juanjuan and Jie, Zhuye and Li, Jiandong and
   Song, Xiaolei and Wang, Zirong and Zhang, Zhe and Zeng, Liping and Du,
   Hui and Tang, Huiru and Zhang, Tao and Yang, Huanming and Wang, Jian and
