@article{ WOS:001713862000001,
Author = {Caccia, Giacomo and Cavaglia, Matteo and Speroni, Alberto and Palmero
   Iglesias, Luis and Poli, Tiziana and Mainini, Andrea Giovanni},
Title = {A Performance-Based Methodology for Retrofitting Buildings Guided by
   Visual Comfort},
