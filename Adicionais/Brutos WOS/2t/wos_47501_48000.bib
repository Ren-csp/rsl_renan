@article{ WOS:000720682300031,
Author = {Dao Nguyen Vinh and Nguyen Thi Duy Nhat and de Bruin, Erwin and Nguyen
   Ha Thao Vy and Tran Thi Nhu Thao and Huynh Thi Phuong and Pham Hong Anh
   and Todd, Stacy and Tran Minh Quan and Nguyen Thi Le Thanh and Nguyen
   Thi Nam Lien and Nguyen Thi Hong Ha and Tran Thi Kim Hong and Pham Quang
   Thai and Choisy, Marc and Tran Dang Nguyen and Simmons, Cameron P. and
   Thwaites, Guy E. and Clapham, Hannah E. and Nguyen Van Vinh Chau and
   Koopmans, Marion and Boni, Maciej F.},
Title = {Age-seroprevalence curves for the multi-strain structure of influenza A
   virus},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {NOV 18},
Abstract = {The relationship between age and seroprevalence can be used to estimate
   the annual attack rate of an infectious disease. For pathogens with
   multiple serologically distinct strains, there is a need to describe
   composite exposure to an antigenically variable group of pathogens. In
   this study, we assay 24,402 general-population serum samples, collected
   in Vietnam between 2009 to 2015, for antibodies to eleven human
   influenza A strains. We report that a principal components decomposition
   of antibody titer data gives the first principal component as an
   appropriate surrogate for seroprevalence; this results in annual attack
   rate estimates of 25.6\% (95\% CI: 24.1\% - 27.1\%) for subtype H3 and
   16.0\% (95\% CI: 14.7\% - 17.3\%) for subtype H1. The remaining
   principal components separate the strains by serological similarity and
   associate birth cohorts with their particular influenza histories. Our
   work shows that dimensionality reduction can be used on human antibody
   profiles to construct an age-seroprevalence relationship for
   antigenically variable pathogens.
   Multi-strain pathogens, such as influenza, present challenges for
   interpretation of seroprevalence data as estimates may vary by strain.
   Here, the authors develop a method for estimating age-specific
   seroprevalence based on principal components analysis and apply it to
   influenza data from Vietnam.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
