@article{ WOS:001137404100011,
Author = {Roman, Alvaro and Gac, Daniella and Larrain., Javiera},
Title = {Ruralidad y fronteras de recursos en regiones de la zona central y
   patagónica de Chile: paisaje y nuevas relaciones de poder},
Journal = {EURE-REVISTA LATINOAMERICANA DE ESTUDIOS URBANO REGIONALES},
Year = {2024},
Volume = {50},
Number = {149},
Pages = {24},
Month = {JAN},
Abstract = {The analysis of socio-territorial transformations in rural areas
   associated with agro-industry and salmon farming in Chile tends to offer
   balanced assessments of environmental and socio-economic impacts, with
   strong emphasis in the labor dimension. Through landscape, as a category
   elaborated from the evocation that represents the way in which we
   situate ourselves in a certain context, we propose to debate, applying
   the resource frontier approach, the dimensions of disciplining and
   social exclusion in the self-definition of rurality. We conducted
   semi-structured interviews, focus groups and participatory mapping in
   way, we gain access to perceptions of the reconfiguration of power
   relations that validate or challenge industrial hegemony..},
Publisher = {PONTIFICIA UNIV CATOLICA CHILE, INST ESTUDIOS URBANOS TERRITORIALES},
