@article{ WOS:000395122900001,
Author = {Fox, Anthony D. and Madsen, Jesper},
Title = {Threatened species to super-abundance: The unexpected international
   implications of successful goose conservation},
Journal = {AMBIO},
Year = {2017},
Volume = {46},
Number = {2, SI},
Pages = {179-187},
Month = {MAR},
Abstract = {Wild geese wintering in western Europe were declining by the 1930s
   probably due to loss of natural habitat and over exploitation through
   hunting, although the causes will never be known. Refuge provision and
   hunting restrictions from the 1950s enabled numbers to recover. Improved
   monitoring systems enabled the description of progressive increases and
   extensions of wintering range since that time, especially amongst those
   goose populations that increasingly exploited agricultural landscapes.
   This introductory article sets the scene for the special issue on the
   increasing interactions and conflicts created by recent increases in the
   range and abundance of wild geese throughout the northern hemisphere,
   especially with regard to agricultural damage, but including issues
   associated with air flight safety, human and animal health, ecosystem
   effects and conflicts with other biodiversity objectives. It also
   provides the context for finding common solutions to problems,
   presenting experiences from regional-, national- and flyway-coordinated
   management to find solutions to conflict.},
