@article{ WOS:000781259700001,
Author = {Bordeira-Carrico, Renata and Teixeira, Joana and Duque, Marta and
   Galhardo, Mafalda and Ribeiro, Diogo and Acemel, Rafael D. and Firbas,
   Panos N. and Tena, Juan J. and Eufrasio, Ana and Marques, Joana and
   Ferreira, Fabio J. and Freitas, Telmo and Carneiro, Fatima and
