@article{ WOS:001454467000033,
Author = {Yong, Xin and Jia, Guowen and Yang, Qin and Zhou, Chunzhuang and Zhang,
   Sitao and Deng, Huaqing and Billadeau, Daniel D. and Su, Zhaoming and
   Jia, Da},
Title = {Cryo-EM structure of the BLOC-3 complex provides insights into the
   pathogenesis of Hermansky-Pudlak syndrome},
Journal = {NATURE COMMUNICATIONS},
Year = {2025},
Volume = {16},
Number = {1},
Month = {MAR 26},
Abstract = {Biogenesis of lysosome-related organelle complex-3 (BLOC-3) is pivotal
   in vesicle trafficking and has been linked to Hermansky-Pudlak syndrome
   (HPS). Despite its importance, the structure and molecular function of
   BLOC-3 remains elusive. Here, we report the Cryo-EM structure of human
   BLOC-3 at 3.2 \& Aring; resolution. The BLOC-3 complex consists of one
   copy of HPS1 and HPS4, which tightly associate with each other via their
   longin domains (LD1 and LD3). The unique four-helical bundle (4HB)
   domain of HPS1 is involved in stabilizing its LD1 and LD2 domains.
   Moreover, we identify interactions between BLOC-3 and the small GTPases
   RAB32/38 and RAB9A, which are essential for lysosome-related organelle
   biogenesis. Functional assays using zebrafish models confirm the
   significance of BLOC-3 assembly and its interaction with RAB9A during
   melanosome biogenesis. Most importantly, our structural information
   provides an accurate prediction for clinical variants associated with
   HPS. In summary, our study provides a comprehensive understanding of the
   molecular architecture and functional roles of BLOC-3, shedding light on
   HPS pathogenesis.},
