@article{ WOS:000413793300008,
Author = {Graham, Jay P. and Eisenberg, Joseph N. S. and Trueba, Gabriel and
   Zhang, Lixin and Johnson, Timothy J.},
Title = {Small-Scale Food Animal Production and Antimicrobial Resistance:
   Mountain, Molehill, or Somethingin-between?},
Journal = {ENVIRONMENTAL HEALTH PERSPECTIVES},
Year = {2017},
Volume = {125},
Number = {10},
Month = {OCT},
Abstract = {Small-scale food animal production is widely practiced around the globe,
   yet it is often overlooked in terms of the environmental health risks.
   Evidence suggests that small-scale food animal producers often employ
   the use of antimicrobials to improve the survival and growth of their
   animals, and that this practice leads to the development of
   antimicrobial resistance (AMR) that can potentially spread to humans.
   The nature of humananimal interactions in small-scale food animal
   production systems, generally practiced in and around the home, likely
   augments spillover events of AMR into the community on a scale that is
   currently unrecognized and deserves greater attention.},
Publisher = {US DEPT HEALTH HUMAN SCIENCES PUBLIC HEALTH SCIENCE},
