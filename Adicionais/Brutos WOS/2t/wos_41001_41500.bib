@article{ WOS:001111898300001,
Author = {Ries, Melissa and Schwan, Stephan},
Title = {Experiencing places of historical significance: A psychological
   framework and empirical overview},
Journal = {JOURNAL OF ENVIRONMENTAL PSYCHOLOGY},
Year = {2023},
Volume = {92},
Month = {DEC},
Abstract = {The awareness of being at a place where historic events took place is of
   great importance, as reflected in the National Register of Historic
   Places or the UNESCO world heritage list. Therefore, from a
   psychological perspective, the impact of a given location on
   psychological processes not only depends on its current attributes, but
   also on the visitor's awareness of its historical dimension. However, a
   psychological framework about the impact of historic places is still
   lacking. To address this research gap, the article summarizes relevant
   findings throughout different disciplines, including environmental,
   educational, and social psychology, tourism, and heritage studies. A
   conceptual framework is derived, postulating three main components: the
   historic place, the person visiting the place, and the psychological and
   social processes resulting from the visit. The framework allows for
   locating the existing research and further for identifying research gaps
   within the field. The framework's strength and limitations are
   discussed.},
