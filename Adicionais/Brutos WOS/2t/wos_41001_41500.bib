   Hailey and Conway, Kevin W.},
Title = {First record of the Gangetic Swamp Eel, Ophichthys cuchia
   (Hamilton, 1822) (Teleostei: Synbranchidae), from Texas (USA) based on
   museum vouchered material, and confirmation of a second established
   non-native population in the USA},
Journal = {CHECK LIST},
Year = {2022},
Volume = {18},
Number = {3},
Pages = {475-482},
Abstract = {The native range of Ophichthys cuchia includes part of Bangladesh,
   Bhutan, India, Myanmar, and Nepal. Ophichthys cuchia has also been
   collected within six states in the USA (Louisiana, Maryland, Michigan,
   New Jersey, New York, and Pennsylvania) and an established invasive
   population exists in New Orleans (Louisiana). We provide the first
   record of O. cuchia from Texas and the second report of an established
   non-native population in the USA based on 26 museum vouchered specimens
   collected from a series of urban ponds within the Houston metro area
   (Fort Bend Co.).},
