@article{ WOS:001820602800001,
Author = {Habibova, Konul and Aliyeva, Narmin and Allahverdiyeva, Aytan and
   Mahmudova, Rana and Jafarov, Agil},
Title = {Integrating the concept of eco-consciousness through language: a
   linguistic approach based on the SEGT model},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {113},
Month = {JUN},
Abstract = {One of the key priorities of contemporary education is the development
   of eco-consciousness as an integral component of sustainable
   development. Environmental education policies aim to promote a
   harmonious relationship between humans and nature by fostering
   ecological knowledge, values, and responsible behavior. In this context,
   language plays a crucial role as a medium through which ecological
   awareness can be constructed, communicated, and internalized. This study
   explores the integration of the concept of eco-consciousness through
   language from a linguistic perspective based on the SEGT model.
   Particular attention is given to the role of language in shaping
   environmental thinking and to the ways ecological concepts can be
   incorporated into linguistic and educational discourse. The
   implementation of the SEGT model requires an interdisciplinary approach
   that combines linguistic, educational, and environmental dimensions. The
   study examines how language and literature instruction can contribute to
   the development of eco-consciousness by promoting human-nature
   relationships through meaningful communication and discourse practices.
   For the Azerbaijani educational context, the integration of ecological
   thinking into language education represents a relevant and timely issue.
   The research employs systematic and structural analysis of scientific
   and theoretical sources, comparative analysis of approaches to
   environmental education and ecolinguistics, as well as the
   systematization and generalization of research findings. The results
   highlight the potential of language-based approaches to fostering
   ecological awareness and supporting the transition toward a more
   sustainable society.},
