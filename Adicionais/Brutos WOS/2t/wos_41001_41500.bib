@article{ WOS:000723385700001,
Author = {Fu, Shihang and Liu, Yaolin and Fang, Ying},
Title = {Measuring the Differences of Public Health Service Facilities and Their
   Influencing Factors},
Journal = {LAND},
Year = {2021},
