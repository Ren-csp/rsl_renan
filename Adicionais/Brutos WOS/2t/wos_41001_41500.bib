@article{ WOS:001517191200001,
Author = {Koptekin, Dilek and Aydogan, Ayca and Karamurat, Cansu and Altinisik, N.
   Ezgi and Vural, Kivilcim Basak and Kazanci, D. Deniz and Dogu, Ayca
   Kucukakdag and Kaptan, Damla and Gemici, Hasan Can and Yuncu, Eren and
   Moots, Hannah M. and Umurtak, Gulsun and Duru, Refik and Fidan, Erkan
   and Cevik, Ozlem and Erdogu, Burcin and Korkut, Taner and Knusel,
   Christopher J. and Haddow, Scott and Larsen, Clark Spencer and Ozbal,
   Rana and Gerritsen, Fokke and Ozdogan, Eylem and Akbaba, Ali and
   Usanmaz, Uygar Ozan and Derici, Yasin Cemre and Ucmazoglu, Mine and Jay,
   Flora and Ozdogan, Mehmet and Gotherstrom, Anders and Erdal, Yilmaz
   Selim and Malaspinas, Anna-Sapfo and Atakuman, Cigdem and Ozer, Fusun
   and Somel, Mehmet},
Title = {Out-of-Anatolia: Cultural and genetic interactions during the Neolithic
   expansion in the Aegean},
Journal = {SCIENCE},
Year = {2025},
Volume = {388},
Number = {6754},
Month = {JUN 26},
Abstract = {West Anatolia has been a crucial yet elusive element in the Neolithic
   expansion from the Fertile Crescent to Europe. In this work, we describe
   the changing genetic and cultural landscapes of early Holocene West
   Anatolia using 30 new paleogenomes. We show that Neolithization in West
   Anatolia was a multifaceted process, characterized by the assimilation
   of Neolithic practices by local foragers, the influx of eastern
   populations, and their admixture, with their descendants subsequently
   establishing Neolithic Southeast Europe. We then coanalyzed genetic and
   cultural similarities across early Holocene Anatolian and Aegean
   Neolithic villages using 58 material culture elements. Cultural
   distances among villages correlate with their spatial distances but not
   with their genetic distances after controlling for geography. This
   suggests that cultural change was often decoupled from genetically
   visible mobility.},
