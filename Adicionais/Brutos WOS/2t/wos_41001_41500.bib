Title = {NEW EXCAVATIONS AT CUEVA DEL MEDIO: PROCESS OF FORMATION OF THE CAVES
   AND ADVANCES IN STUDIES OF INTERACTION BETWEEN HUNTER-GATHERERS AND
   EXTINCT FAUNA (FINAL PLEISTOCENE, SOUTHERN PATAGONIA)},
Journal = {MAGALLANIA},
Year = {2015},
Volume = {43},
Number = {1},
Pages = {165-189},
Abstract = {New studies at cueva del Medio, Ultima Esperanza, Chile, are presented.
   Some of the main cave formation and sediment accumulation processes were
   identified. New excavations indicated that extinct fauna was using the
   cave at least since 14,000 radiocarbon years BP. Human occupations at
   the end of the Pleistocene were confirmed with new findings and
   radiocarbon dates. The importance of extinct fauna in the human
   subsistence was less important than previously sustained.},
