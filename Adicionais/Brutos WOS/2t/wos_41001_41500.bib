@article{ WOS:001468067500003,
Author = {Khanday, Aijaz Ahmad and Kumar, Mushtaq Ahmad and Rather, G. M. and
   Ahmed, Rayees},
Title = {Understanding health trends in Ladakh region insights into disease
   patterns and social dynamics},
Journal = {DISCOVER PUBLIC HEALTH},
Year = {2025},
Volume = {22},
Number = {1},
Month = {APR 15},
Abstract = {The impact of infectious diseases on public health and global economies
   is profound, influenced by various economic, social, and cultural
   factors inherent in human environments. The social environment plays a
   crucial role in determining health and disease patterns within
   communities. This study aimed to elucidate changing disease patterns and
   associated social trends in the Ladakh region using a comprehensive
   approach, combining quantitative data on disease prevalence with
   qualitative community insights. Analysis of disease prevalence in Kargil
   and Leh districts from 2001 to 2022-2023 reveals a significant decrease
   in vaccine-preventable diseases but emerging challenges from conditions
   like diabetes, cancer, and cardiovascular diseases. Economic
   development, particularly through tourism, presents both challenges and
   opportunities. Environmental factors such as climate change and tourism
   exert notable influence on Ladakh's health landscape. Transitioning from
   traditional practices to modernization, along with urbanization and
   migration, carries complex implications for health and disease.
   Lifestyle factors including diet changes, physical activity, and
   substance consumption like smoking and alcohol are recognized as
   significant contributors to health outcomes.},
