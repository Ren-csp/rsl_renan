   Stacey and Isenberg, Daniel and Stern, Alexa},
Title = {WHEN THE SHOE IS ON THE OTHER FOOT: A QUALITATIVE STUDY OF INTERN-LEVEL
   TRAINEES' PERCEIVED LEARNING FROM CLIENTS},
Journal = {PSYCHOTHERAPY},
Year = {2009},
Volume = {46},
Number = {3},
