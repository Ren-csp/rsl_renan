@article{ WOS:001486203400001,
Author = {Uchiyama, Yuta and Kyan, Akira and Sato, Masayuki and Ushimaru, Atushi
   and Minamoto, Toshifumi and Harada, Kazuhiro and Takakura, Minoru and
   Kohsaka, Ryo and Kiyono, Mieko and Tsurumi, Tetsuya and Uchida, Atsuhiko
