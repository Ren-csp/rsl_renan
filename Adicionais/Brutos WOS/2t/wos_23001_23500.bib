@article{ WOS:001778314800001,
Author = {Kim, Myung Ja and Han, Sinhee and Jo, Yunkyoung and Cho, Hyo Dan and
   Chung, Namho and Hall, C. Michael},
Title = {Resident perceptions of spaceport destination development},
Journal = {JOURNAL OF SUSTAINABLE TOURISM},
Year = {2026},
Month = {2026 MAY 23},
Abstract = {Spaceports are a new and often controversial feature of the tourism
   landscape. This study examines how sustainable development and
   Environmental, Social, and Governance (ESG) factors impact residents'
   quality-of-life (QoL) and support for new spaceport development in South
   Korea through an integrated theoretical framework combining bottom-up
   spillover effect theory and process theory. Using a mixed-methods
   approach combining structural equation modelling, fuzzy-set Qualitative
   Comparative Analysis, and multi-group analysis, with a survey of 444
   residents of Sacheon and Jinju cities, South Gyeongsang Province, the
   location of the Korean National Aerospace Industrial Complex including
   the Korea AeroSpace Administration's (KASA) headquarters, a satellite
   innovation center, a space environment testing facility, and many space
   related companies. The research finds that efficient allocation, social
   engagement, and governance practices significantly impact support for
   spaceport development, which in turn influences QoL. High-support
   residents prioritized governance aspects, while low-support residents
   emphasized the social aspects of spaceport development. The findings
   provide strategic insights for destinations seeking to develop
   spaceports, emphasizing the importance of tailored approaches that
   address different community priorities and stakeholder concerns.},
