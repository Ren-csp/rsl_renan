@article{ WOS:000429362000007,
Author = {Nicholls, Larissa and Phelan, Kath and Maller, Cecily},
Title = {`A Fantasy to Get Employment Around the Area': Long Commutes and
   Resident Health in an Outer Urban Master-Planned Estate},
Journal = {URBAN POLICY AND RESEARCH},
Year = {2018},
Volume = {36},
Number = {1},
Pages = {48-62},
Abstract = {The Selandra Rise master-planned estate (MPE) in Melbourne's south-east
   growth corridor was designed to create a ``healthy and engaged
   community{''} through the provision of parks, physical activity
   opportunities and community facilities. A 5 year longitudinal study
   researched the impact on residents. Over one third of residents spent 2
   to 3 h per day commuting and high levels of dissatisfaction with
   commutes were found. Longer commute times were associated with poor
   physical activity and weight outcomes. The paper concludes that
   provisions for health and wellbeing within an MPE are insufficient when
   opportunities for local employment are limited and broader locational,
   connectivity and transport disadvantages are not addressed.},
