@article{ WOS:000647955400001,
Author = {Zapata Campos, Maria Jose and Kain, Jaan-Henrik and Oloko, Michael and
   Stenberg, Jenny and Zapata, Patrik},
Title = {Urban qualities and residents' strategies in compact global south
   cities: the case of Havana},
Journal = {JOURNAL OF HOUSING AND THE BUILT ENVIRONMENT},
Year = {2022},
Volume = {37},
Number = {1},
Pages = {529-551},
Month = {MAR},
Abstract = {Research and policy argue for more compact cities to respond to
   sustainable development challenges. However, what actually needs to be
   made more compact and how, is under examined, particularly in global
   South cities where north notions of urban qualities are adopted without
   being questioned. Informed by a qualitative study in informal and
   compact neighborhoods in Havana, this paper explores which qualities are
   important to deliver more just cities, and what strategies are developed
   by residents to strengthen beneficial qualities and address detrimental
   qualities in contexts of informal urbanization and compactness. It shows
   how the street, human capital, neighborhood, housing affordability,
   citizenship and vibrancy are significant compact city qualities
   neglected in the literature. Finally, the paper shows how diverse
   strategies are developed by residents to draw upon these qualities, such
   as self-help urbanism, learning and innovation, economic
   entrepreneurship, networks of solidarity, economies of reciprocity,
   local imaginaries and active citizenship.},
