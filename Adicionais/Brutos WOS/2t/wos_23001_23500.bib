@article{ WOS:001819804200001,
Author = {Fan, Yiqi and Wang, Ying and Yin, Ruimin and Zhang, Rou and Wang,
   Zhaojun},
Title = {Multi-Scale Pathways to Integrated Protection and Restoration of
   Mountains, Rivers, Forests, Farmlands, Lakes, and Grasslands in the
   Three Gorges Reservoir Area: A Social-Ecological Systems Perspective},
Journal = {LAND DEGRADATION \& DEVELOPMENT},
Year = {2026},
Volume = {37},
Number = {14},
Pages = {10546-10565},
Month = {AUG 30},
Abstract = {Human activities have intensified eco-environmental problems,
   challenging harmonious human-nature interactions. However, existing
   integrated protection and restoration (IPR) zoning approaches for
   mountains, rivers, forests, farmlands, lakes, and grasslands (MRFFLG)
   focus on a single scale and fail to incorporate the ecological network
   (EN) and social-ecological coupling dynamics, limiting multi-scale
   governance effectiveness. Taking the Three Gorges Reservoir Area (TGRA)
   as the research area, this study constructs a multi-scale zoning
   framework from the social-ecological systems (SES) perspective. By
   integrating MRFFLG systems and the social system (MRFFLG-S systems) into
   an evaluation system, the coupling coordination relationship of MRFFLG-S
   systems is assessed to delineate IPR zones, which are subsequently
   refined based on EN importance to enhance ecosystem connectivity and
   stability. Multi-scale IPR pathways of MRFFLG are further explored. The
   results show that: (1) From 2010 to 2022, coupling coordination types of
   subsystems transition from imbalance to coordination across three
   scales, with pronounced changes at finer spatial scales. (2) The EN
   exhibits a spatial distribution pattern of ``dense in the east and
   sparse in the west{''}. (3) A hierarchical governance system
   characterized by ``macro-scale guidance, meso-scale regulation, and
   micro-scale implementation{''} is established. Specifically, 11 zones
   are delineated at the county scale to identify overarching directions
   for IPR of MRFFLG, 16 differentiated strategies are formulated at the 10
   km grid scale, and IPR project implementation is supported at the 1 km
   grid scale. This study promotes systemic protection and governance of
   MRFFLG and provides spatial guidance for precise zoning management to
   facilitate the harmonious development of human-environment systems.},
