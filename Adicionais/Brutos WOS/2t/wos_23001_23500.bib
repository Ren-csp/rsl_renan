@article{ WOS:000504840300013,
Author = {Tribot, Anne-Sophie and Deter, Julie and Claverie, Thomas and
   Guillhaumon, Francois and Villeger, Sebastien and Mouquet, Nicolas},
Title = {Species diversity and composition drive the aesthetic value of coral
   reef fish assemblages},
Journal = {BIOLOGY LETTERS},
Year = {2019},
Volume = {15},
Number = {11},
Month = {NOV},
Abstract = {Cultural and recreational values of biodiversity are considered as
   important dimensions of nature's contribution to people. Among these
   values, the aesthetics can be of major importance as the appreciation of
   beauty is one of the simplest forms of human emotional response. Using
   an online survey, we disentangled the effects of different facets of
   biodiversity on aesthetic preferences of coral reef fish assemblages
   that are among the most emblematic assemblages on Earth. While we found
   a positive saturating effect of species' richness on human preference,
   we found a net negative effect of species abundance, no effect of
   species functional diversity and contrasting effects of species
   composition depending on species' attractiveness. Our results suggest
   that the biodiversity-human interest relationship is more complex than
   has been previously stated. By integrating several scales of
   organization, our study is a step forward in better evaluating the
   aesthetic value of biodiversity.},
Publisher = {ROYAL SOC},
Address = {6-9 CARLTON HOUSE TERRACE, LONDON SW1Y 5AG, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Mouquet, N (Corresponding Author), Univ Montpellier, CNRS, IFREMER, MARBEC,IRD, F-34095 Montpellier, France.
   Tribot, Anne-Sophie; Claverie, Thomas; Guillhaumon, Francois; Villeger, Sebastien; Mouquet, Nicolas, Univ Montpellier, CNRS, IFREMER, MARBEC,IRD, F-34095 Montpellier, France.
