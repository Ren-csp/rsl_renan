@article{ WOS:001745822400001,
Author = {Chen, Changhong and Li, Baixue and Guan, Huilian and Xue, Dehong and
   Zhou, Changwei and Kong, Xianglong},
Title = {Modeling Psychological Toll in the Context of Urban Air Pollution Risk:
   Geography and Validation, 2020 versus 2021},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2026},
Volume = {12},
Month = {APR 22},
Abstract = {Air pollution degrades urban air quality and affects public health and
   social well-being. While emotional responses to pollutants have been
   documented, few studies have examined the cross-year spatiotemporal
   distributions of these effects. This study analyzed data from over
   14,000 urban park visitors in 48 Chinese cities in 2020 and 2021. Facial
   expression scores for happiness, sadness, and neutrality were regressed
   against same-day concentrations of particulate matter (PM2.5, PM10),
   nitrogen dioxide (NO2), and ozone (O3) using hybrid machine learning
   models. The concentrations of PM2.5, PM10, and NO2 peaked during winter
   in northern and central China, whereas those of O3 increased during
   spring and summer. High positive emotion indices were most frequent
   during autumn in southern cities, whereas sadness was more prevalent in
   northern winters. The machine learning results indicated that
   particulate matter had a stronger influence on emotional shifts than
   socioeconomic factors. Air pollutants consistently drive negative
   emotional perceptions, particularly in northern Chinese cities during
   winter.},
