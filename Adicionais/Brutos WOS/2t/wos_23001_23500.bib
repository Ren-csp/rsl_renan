@article{ WOS:000246097800012,
Author = {Ciuffreda, Kenneth J. and Wang, Bin and Vasudevan, Balamurali},
Title = {Conceptual model of human blur perception},
Journal = {VISION RESEARCH},
Year = {2007},
Volume = {47},
Number = {9},
Pages = {1245-1252},
Month = {APR},
Abstract = {An empirically based, conceptual model of human blur perception is
   presented. It incorporates the concepts of blur detection and blur
   discrimination in depth, and across the central and peripheral retina,
   in two- and three-dimensional visual space. Key aspects of the model are
   its dynamic nature, predictability regarding the blur-based
   depth-ordering of objects, patterns of retinal defocus with far and near
   viewing, and interactions related to retinal defocus between the central
   and peripheral retina. Furthermore, a two-dimensional schematic
   representation of the blur-free region during near viewing is depicted
   in dioptric space. This model has implications with respect to
   accommodative control, depth perception, and refractive error
   development and progression. (c) 2006 Elsevier Ltd. All rights reserved.},
