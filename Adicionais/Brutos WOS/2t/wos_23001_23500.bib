@article{ WOS:001294442100068,
Author = {Angelo, Hillary and MacFarlane, Key and Sirigotis, James and
   Millard-Ball, Adam},
Title = {Missing the Housing for the Trees: Equity in Urban Climate Planning},
Journal = {JOURNAL OF PLANNING EDUCATION AND RESEARCH},
Year = {2024},
Volume = {44},
Number = {3},
Pages = {1415-1430},
Month = {SEP},
Abstract = {This paper examines equity's incorporation into Climate Action Plans
   (CAPs), an increasingly important part of the urban sustainability
   planning landscape. We conduct a content analysis of 170 California CAPs
   and compare the plans' treatment of equity to city characteristics such
   as size and income inequality. We find that equity language correlates
   with an increased presence of more systemic policy interventions, such
   as dense and/or affordable housing, in CAPs. However, the majority of
   CAPs ``miss the housing for the trees,{''} with green policy agendas,
   such as trees and open space, remaining more dominant. We also find
   little association between local inequalities and how CAPs incorporate
   equity goals.
   Este art \& iacute;culo examina la incorporaci \& oacute;n de la equidad
   en los planes de acci \& oacute;n clim \& aacute;tica (CAP), una parte
   cada vez m \& aacute;s importante del panorama de la planificaci \&
   oacute;n de la sostenibilidad urbana. Realizamos un an \& aacute;lisis
   de contenido de 170 CAP de California y comparamos el tratamiento de la
   equidad de los planes con las caracter \& iacute;sticas de la ciudad,
   como el tama \& ntilde;o y la desigualdad de ingresos. Encontramos que
   el lenguaje de la equidad se correlaciona con una mayor presencia de
   intervenciones de pol \& iacute;ticas m \& aacute;s sist \&
   eacute;micas, como viviendas densas y / o asequibles, en los CAP. Sin
   embargo, la mayor \& iacute;a de los CAP ``pierden viviendas para los \&
   aacute;rboles,{''} y las agendas de pol \& iacute;ticas ecol \&
   oacute;gicas, como los \& aacute;rboles y los espacios abiertos, siguen
   siendo m \& aacute;s dominantes. Tambi \& eacute;n encontramos poca
   asociaci \& oacute;n entre las desigualdades locales y c \& oacute;mo
   los CAP incorporan objetivos de equidad.
