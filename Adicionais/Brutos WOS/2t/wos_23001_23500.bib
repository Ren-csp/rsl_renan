@article{ WOS:001519679000001,
Author = {Schiappa, Ellie A. and Perry, Elizabeth E. and Silver, Emily J. and
   Lopez, Maria Claudia},
Title = {``There's More Negatives than Positives{''}: Community Perceptions About
   Climate Changes to Water Ecosystem Services in Southeast Michigan},
Journal = {SOCIETY \& NATURAL RESOURCES},
Year = {2025},
Volume = {38},
Number = {12},
Pages = {1463-1481},
Month = {DEC 2},
Abstract = {Local governments across the Great Lakes region are responding to
   climate change by formulating climate action plans (CAPs). Southeast
   Michigan, a region defined by water, has many such CAPs. Yet, few
   address water beyond existing as a public utility. The Huron-Clinton
   Metropolitan Authority stewards 14 Metroparks, acting as a significant
   regional conservation and recreation network. Through a series of focus
   groups, our research highlighted the need for water-specific,
   community-informed climate inquiry. This work speaks to that need, using
   a water ecosystem services (ESw) framework to analyze residents'
   perceptions about climate change regionally and in the Metroparks. Focus
   group data illuminated concerns about a robust set of ESw. We discuss
   the localized and transcending impacts of ESw and their disruptions.
   This novel application of the ESw emphasizes community perspectives
   about climate change, contextualizes individual parks' CAPs within a
   regional scope, and identifies points of motivation for climate action.},
