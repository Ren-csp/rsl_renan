@article{ WOS:000458308600008,
Author = {Barlow, Fiona Kate},
Title = {Nature vs. nurture is nonsense: On the necessity of an integrated
   genetic, social, developmental, and personality psychology},
Journal = {AUSTRALIAN JOURNAL OF PSYCHOLOGY},
Year = {2019},
Volume = {71},
Number = {1, SI},
Pages = {68-79},
Month = {MAR},
Abstract = {The field of behavioural genetics unambiguously demonstrates that
   heritable individual differences exist and are important in explaining
   human behaviour. Despite this, some psychological perspectives ignore
   this research. If we wish to comprehensively understand the impact of
   parenting, the environment, or any social factor, however, we must
   engage with genetics. In this article, I review research that reveals
   that genes affect not only our personalities, but the way that we
   understand and react to the social world. Studies further reveal that
   notable life events are in part explained by genetic variance. I detail
   how this could be the case through active, evocative, and passive
   genetic correlations, and go on to argue that all complex psychological
   traits are likely the result of multifaceted gene by environment
   interactions. A mistaken belief that genetic influence implies genetic
   essentialism, and is therefore tantamount to prejudice, is raised as
   possible reason why heritability is often ignored in the social
   sciences. The article concludes with practical suggestions for how we
   can embrace behavioural genetics as our methods struggle to match the
   divine complexity of human existence.},
