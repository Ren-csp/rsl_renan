@article{ WOS:001784518600001,
Author = {Zhao, Changxu and Zhao, Dongxiao and Li, Gaojin},
Title = {Limited-perception swimmer navigation in flow through memory-enhanced
   reinforcement learning},
Journal = {MACHINE LEARNING-SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {7},
Number = {3},
Month = {JUN 1},
Abstract = {Navigation under conditions of limited detection resolution and
   insufficient information poses a major challenge in many applications.
   To address these limitations, we propose a reinforcement learning
   framework integrated with recurrent neural network (RNN) and investigate
   a model swimmer navigating toward a chemical source in an unsteady flow
   field. The algorithm utilizes fixed-length temporal windows for memory
   retention and is trained through iterative agent-environment
   interactions in dynamically generated hydrodynamic datasets. By
   extracting temporal features, this architecture enhances environmental
   comprehension without requiring additional spatial detection.
   Comparative analysis shows that incorporating RNN units with an optimal
   memory length yields significant improvements in both success rate and
   navigation efficiency compared with heuristic and learning-based
   baselines, including its direct sequential-update counterpart.
   Furthermore, our investigation of different observation inputs reveals
   that velocity-based swimmers outperform those relying on velocity
   gradient information. The performance of the trained neural network,
   validated across noisy environments and diverse flow conditions,
   confirms the robustness and generalization capability of the proposed
   framework.},
