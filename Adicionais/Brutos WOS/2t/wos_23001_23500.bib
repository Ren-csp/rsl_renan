@article{ WOS:001783892600001,
Author = {Shrimpton, Elisabeth A. and Balta-Ozkan, Nazmiye and Albuflasa, Hanan},
Title = {Governance of novel ``green{''} desalination processes in the Kingdom of
   Bahrain},
Journal = {FRONTIERS IN SUSTAINABLE CITIES},
Year = {2026},
Volume = {8},
Month = {MAY 21},
Abstract = {This paper examines the forms of governance that will impact the
   implementation of new ``green{''} desalination process to identify areas
   which may support or challenge urban infrastructure adaptation. The
   chosen context is the Kingdom of Bahrain. Bahrain is chosen as it has
   been successful in achieving high standards of living for its populace,
   but the upheaval of water and energy system change is urgent and
   essential due to its extreme climate, resource availability, and wider
   economic context. Bahrain faces challenges common to many jurisdictions
   in having high standards of living, but where social practices need to
   drastically change if those standards are to be maintained into the
   future. The forms of governance are considered as a system and defined
   and applied to the Bahraini context through a documentary analysis,
   qualitative interviews and focus groups with experts and communities
   within Bahrain. The results find prima facie, policy, and regulatory
   support for system change, although progress is slow. A deeper analysis
   identifies opportunities for policy re-direction but beyond policy, it
   identifies norms, values, and Constitutional expectations that require
   respect and care in how they are managed if change is to be accepted at
   pace. The results offer opportunities for governance comparisons across
   jurisdictions and have implications for innovators in how new systems
   are designed and framed and for policymakers in identifying and
   dismantling barriers to change.},
