@article{ WOS:001835448400001,
Author = {Shaikh, Shaikh Fairul Edros Ahmad and Lipu, Bergita Gusti and Irawati,
   Miya and Lechner, Alex M. and Hamel, Perrine},
Title = {Divergent benefits of urban nature: A comparison of new towns and
   unplanned settlements in South Tangerang, Indonesia},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Month = {2026 JUL 29},
Abstract = {1. Urban nature provides essential ecosystem services, but their use and
   perception vary based on socio-demographic factors, including settlement
   type, which reflects differences in socio-economic and environmental
   conditions. 2. This study compares how residents of new town
   developments (master-planned areas) and unplanned settlements
   (organically developed) use and perceive ecosystem services in South
   Tangerang city, Indonesia. A social survey of 403 residents was
   conducted to examine differences in provisioning, regulating, and
   cultural ecosystem services. 3.We determined that new town residents had
   twice the odds of having views of nature from their homes compared with
   residents of unplanned settlements. 4. In contrast, residents of
   unplanned settlements had higher odds of relying on water provisioning
   services, indicating greater dependence on natural water sources. 5. No
   significant differences were found in the perception of regulating
   services such as flood and heat mitigation between the two groups. 6.
   These findings highlight how different settlement types as an outcome of
   (new-build) gentrification can shape the ways residents use and perceive
   ecosystem services, suggesting the need for urban planning strategies
   that consider variations in ecosystem service benefits across these
   communities in cities with both new town developments and unplanned
   settlements.Read the free for this article on the Journal
   blog.Indonesian translation: Read the free for this article on the
   Journal blog.},
