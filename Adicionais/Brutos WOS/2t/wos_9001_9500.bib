@article{ WOS:001516082700001,
Author = {Zhang, Xi and Du, Jiangtao and Sharples, Steve},
Title = {Effects of Urban Layout, Façade Orientation, and Façade Height on
   Photosynthetically Active Radiation (PAR) Availability in a Dense
   Residential Area: A Dynamic Analysis in Shanghai},
Journal = {URBAN SCIENCE},
Year = {2025},
Volume = {9},
Number = {6},
Month = {JUN 13},
Abstract = {Photosynthetically Active Radiation (PAR) is critical for sustaining
   plant growth in the ground and on building surfaces, but how to
   accurately predict PAR availability in a complex urban environment can
   be a challenge. Using an advanced ray-tracing software (Radiance 4.0)
   and local weather data, this study presents a dynamic analysis of the
   effects of layout, fa \& ccedil;ade orientation and height on PAR
   availability in four high density residential areas in Shanghai city,
   China. A metric system was also adopted using three light level
   requirements of outdoor plants (low, medium, high light levels). Key
   findings included: (1) the urban layout with the highest ratio of
   building height to north-south facing adjacent building separation
   achieved the higher levels of PAR availability for low/medium light
   level plants and the lower levels of PAR availability for high-light
   plants for middle and low fa \& ccedil;ades and the ground, while high
   fa \& ccedil;ades in all layouts could see similar PAR availability for
   all plants. (2) The PAR availability for low/medium-light plants
   decreased with the increasing fa \& ccedil;ade height, while the PAR
   availability for high-light plants showed the opposite trend. (3) The
   north fa \& ccedil;ade and its ground had higher levels of PAR
   availability for low/medium-light plants and lower levels of PAR
   availability for high-light plants than other fa \& ccedil;ades. (4) All
   layouts offered more opportunities to apply high-light and medium-light
   plants at fa \& ccedil;ades and the ground.},
