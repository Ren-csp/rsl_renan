@article{ WOS:001167618900007,
Author = {Su, Kai and Cao, Rong and Wang, Qin and Peng, Zhongshan and He, Yulong},
Title = {NOISE REDUCTION PREDICTION OF URBAN ROAD GREEN BELT BASED ON ROAD
   SERVICE LEVEL},
Journal = {ENVIRONMENTAL ENGINEERING AND MANAGEMENT JOURNAL},
