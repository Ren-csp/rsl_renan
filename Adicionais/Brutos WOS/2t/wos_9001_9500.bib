@article{ WOS:001856265700001,
Author = {Ranjan, Shishu},
Title = {Perception of pre-service science teachers on environmental issues and
   curriculum relevance in Indian initial teacher education curriculum},
Journal = {ENVIRONMENTAL EDUCATION RESEARCH},
Year = {2026},
Month = {2026 AUG 18},
Abstract = {Environmental education is recognised in Indian schooling. Yet, how well
   initial teacher education (ITE) prepares future science teachers to
   address environmental issues meaningfully remains unclear. This
   qualitative case study examines pre-service science teachers'
   perceptions of environmental issues and curriculum relevance within a
   private ITE context in India. It focuses on whether teacher preparation
   links the idea of `environment' to lived socio-ecological challenges,
   such as living in mining areas, facing mass-displacement, encountering
   public health issues, witnessing deforestation, grappling with habitat
   destruction, among others, especially in Jharkhand, India.
   Semi-structured interviews were conducted with five pre-service science
   teachers and analysed thematically. Findings suggest that participants
   commonly associated environmental issues with broad, textbook-aligned
   themes, such as pollution, conservation, global warming, ozone
   depletion, etc. They reported limited curricular engagement with
   context-specific concerns, including localised socio-ecological
   conflicts. Participants expressed interest in integrating environmental
   issues into science teaching but described constraints in pedagogical
   preparedness, often defaulting to content transmission rather than
   inquiry-and dialogue-oriented approaches. The study also indicates
   inconsistent engagement with socio-scientific reasoning, with
   uncertainty about how to address trade-offs, stakeholders, and
   contestation in classroom settings. Together, these findings highlight a
   persistent gap between the salience of environmental issues and
   curricular/pedagogical support in ITE. The study contributes to
   environmental education research by foregrounding curriculum relevance
   and teacher preparation in an under-examined context and outlining ways
   to improve place-responsive, justice-attentive environmental education
   within science teacher education.},
