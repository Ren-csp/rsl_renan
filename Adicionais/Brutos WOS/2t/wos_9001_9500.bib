@article{ WOS:001747026000004,
Author = {Kapuci, Umut and Cengiz, Canan and Smardon, Richard C. and Cengiz,
   Bulent},
Title = {Stakeholder-based assessment of historical urban landscapes as cultural
   heritage within the context of sustainable development: a case study of
   İznik (Nikaia)},
Journal = {SCIENTIFIC REPORTS},
Year = {2026},
Volume = {16},
Number = {1},
Month = {MAR 11},
Abstract = {This article presents an innovative and integrated approach for
   integrating stakeholder-based assessment results applied to the city of
   Iznik. This city is located on the shores of Lake Iznik in the Marmara
   Region of T \& uuml;rkiye and holds a significant place in the
   archaeology of the Bithynia Region. The main objectives of the article
   are: (i) to identify the components of the historical urban landscape
   (ii) to analyze stakeholders' evaluations of Iznik's historical urban
   landscape components based on sustainability indicators, and (iii) to
   develop proposed urban design strategies consistent with sustainable
   development goals for the holistic preservation and development of the
   historical urban landscape of Iznik based on stakeholder assessment. In
   this regard, survey was conducted to assess and understand the
   perceptions of stakeholders (n = 120). The results emphasize the
   critical role that cultural landscapes play in achieving Sustainable
   Development Goals, and that this role is further strengthened through
   stakeholder participation and collaborative decision-making processes.
   This article contains conclusions that may help decision-makers better
   understand the factors that support sustainable development in similar
   urban archaeological heritage areas and guide them for using holistic
   approaches in making cultural heritage management decisions in the
   future.},
