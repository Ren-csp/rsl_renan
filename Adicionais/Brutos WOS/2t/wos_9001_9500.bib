@article{ WOS:001778796200001,
Author = {Solvie, Alyssa L. and Garcia-Antunez, Oriol and Cook, Elizabeth M. and
   Gulsrud, Natalie M. and Olafsson, Anton Stahl and Maurer, Megan},
Title = {What turns us off about green and blue spaces in cities? Understanding
   perceived problems and unpleasant experiences for more just urban
   planning, design and management},
Journal = {PEOPLE AND NATURE},
Year = {2026},
Volume = {8},
Number = {7},
Pages = {2393-2409},
Month = {JUL},
Abstract = {1. The planning, design and management of urban green and blue spaces
   necessitate trade-offs between these spaces' many benefits and their
   drawbacks, but knowledge of perceived problems and unpleasant
   experiences in urban green and blue spaces remains limited. 2. In this
   study, we analyse the descriptions of disliked urban green and blue
   spaces identified in a participatory mapping survey (PPGIS) administered
   to a representative sample (n = 2900) of residents in the \&
   Oslash;sterbro district of Copenhagen, Denmark. 3. We analyse our data
   using a social-ecological-technological systems framework, enabling us
   to identify the ways negative perceptions and experiences of urban green
   and blue spaces are co-produced through interactions among diverse
   components of the urban system. 4. Our results show that perceived
   problems and unpleasant experiences in \& Oslash;sterbro are largely the
   result of interactions between the built environment and various
   social-cultural factors, with the most frequently mentioned dislikes
   being the ambient or aesthetic experience of a place. 5. The type of
   problems and experiences identified by participants demonstrated very
   little variation across socio-demographic factors of age, gender and
   immigration status, showing a significant (p < 0.05) relationship
   between age (60+) and dislikes associated with social factors. 6. Our
   findings support consideration of the social and technological factors
   contributing to the co-production of perceived problems and unpleasant
   experiences and suggest that addressing these provides a promising
   pathway for pursuing fair and equitable trade-offs in urban green and
   blue space planning, design and management for diverse urban residents.},
