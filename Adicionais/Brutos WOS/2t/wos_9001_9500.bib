@article{ WOS:000348381200007,
Author = {Chan, Karen M. K. and Li, Chi Mei and Ma, Estella P. M. and Yiu, Edwin
   M. L. and McPherson, Bradley},
Title = {Noise levels in an urban Asian school environment},
Journal = {NOISE \& HEALTH},
Year = {2015},
Volume = {17},
Number = {74},
Pages = {48-55},
Month = {JAN-FEB},
Abstract = {Background noise is known to adversely affect speech perception and
   speech recognition. High levels of background noise in school classrooms
   may affect student learning, especially for those pupils who are
   learning in a second language. The current study aimed to determine the
   noise level and teacher speech-to-noise ratio (SNR) in Hong Kong
   classrooms. Noise level was measured in 146 occupied classrooms in 37
   schools, including kindergartens, primary schools, secondary schools and
   special schools, in Hong Kong. The mean noise levels in occupied
   kindergarten, primary school, secondary school and special school
   classrooms all exceeded recommended maximum noise levels, and noise
   reduction measures were seldom used in classrooms. The measured SNRs
   were not optimal and could have adverse implications for student
   learning and teachers vocal health. Schools in urban Asian environments
   are advised to consider noise reduction measures in classrooms to better
   comply with recommended maximum noise levels for classrooms.},
