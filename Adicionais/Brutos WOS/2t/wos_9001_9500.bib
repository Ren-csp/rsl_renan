   Lin, Zhao, CCCC Second Highway Engn Co Ltd, Huaxi Construct Co Ltd, Chengdu 610000, Peoples R China.
   Zhang, Yazhuo, Tianjin Univ, Sch Civil Engn, Tianjin 300073, Peoples R China.},
DOI = {10.3390/atmos15050549},
