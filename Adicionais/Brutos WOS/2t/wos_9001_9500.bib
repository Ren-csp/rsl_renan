Author = {Pawlak, Camille C. and Love, Natalie L. R. and Yost, Jennifer M. and
   Fricker, G. Andrew and Doremus, Jacqueline M. and Ritter, Matt K.},
Title = {California's native trees and their use in the urban forest},
