   Horniche, Larissa Helena; Bianchi, Pamela Cristina, Univ Fed Sao Paulo UNIFESP, Santos, SP, Brazil.},
DOI = {10.1590/2526-8910.ctoAO403539391},
Article-Number = {e3939},
ISSN = {2526-8910},
Keywords = {Environment; Sociocultural Territory; Social Occupational Therapy;
   Social Vulnerability; Environmental Justice},
Research-Areas = {Public, Environmental \& Occupational Health; Rehabilitation},
Web-of-Science-Categories  = {Public, Environmental \& Occupational Health; Rehabilitation},
Author-Email = {pamela.bianchi@unifesp.br},
