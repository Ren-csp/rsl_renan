@article{ WOS:000429751700020,
Author = {Al-Sejari, Maha},
Title = {Impact of Attending the Diwaniyyah on Kuwaiti Men's Health},
Journal = {AMERICAN JOURNAL OF MENS HEALTH},
Year = {2018},
Volume = {12},
