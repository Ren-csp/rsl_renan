   Frewen, Paul A.; Dozois, David J. A.; Lanius, Ruth A., Univ Western Ontario, Dept Psychiat, London, ON N6A 5N1, Canada.
   Frewen, Paul A.; Dozois, David J. A., Univ Western Ontario, Dept Psychol, London, ON N6A 5N1, Canada.
   Frewen, Paul A.; Lanius, Ruth A., Univ Western Ontario, Grad Program Neurosci, London, ON N6A 5N1, Canada.},
DOI = {10.3402/ejpt.v3i0.8587},
