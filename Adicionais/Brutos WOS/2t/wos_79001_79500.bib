@article{ WOS:001825458500002,
Author = {Pereira, Carlos Eduardo da Cunha and da Silva, Adan Rene Pereira},
Title = {Autoethnographing to move forward: reflections on research in a pedagogy
   course},
Journal = {APOSTA-REVISTA DE CIENCIAS SOCIALES},
Year = {2026},
Volume = {115},
Month = {JUL},
Abstract = {Based on the theoretical framework of decolonial, cultural and black
   feminist studies, this article aims to reflect on the ongoing research
   process with LGBTQIAPN+ people from the Pedagogy Course at the Federal
   University of Amazonas. Given that the authors are openly members of the
   LGBTQIAPN+ community, when we analyzed the first moment of the research,
   that is, a focus group, we felt intense discomfort, given the shared
   identity between us and our interlocutors. That said, we used the
   autoethnographic methodology so that, as the title suggests, we could
   move forward. As human subjects who investigate in a space that is for
   research, teaching and extension, how can we deal with the
   destabilization caused by such powerful statements that generate in us
   the (false?) perception that nothing or little has changed? After the
   discussion, it was felt that focusing on the final product of the
   research is a source of relief, since sharing with peers, students and
   teachers can, in some way, trigger concrete changes. The main conclusion
   is the need to value methodologies such as autoethnography, considering
   that researchers are not beings without affection, and therefore need to
   share their anxieties, and this should be seen as legitimate, as well as
   other methodological paradigms in the various fields of knowledge.},
Publisher = {APOSTA},
Address = {APOSTA, MADRID, 00000, SPAIN},
