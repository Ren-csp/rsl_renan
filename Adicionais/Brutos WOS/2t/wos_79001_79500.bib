@incollection{ WOS:001712138700007,
Author = {Chen, Shih-Wen Sue and Huang, Phyllis Yu-ting},
Editor = {Zemanek, A},
Title = {`Taiwan's King of Comics' Liu Xing-qin and Sinophone Culture},
Booktitle = {SINOPHONE COMICS: Histories, Identities, Medialities},
Series = {Comics Studies},
Year = {2026},
Volume = {2},
Pages = {143-164},
Abstract = {Liu Xing-qin has been heralded as Taiwan's `national treasure' for his
   contribution to comic art. Since the 2000s, the term bentu ((sic)) or
   `local' Taiwanese culture has been associated with Liu in various
   newspaper reports and research articles, and they often cite Brother
   Asan and Great Auntie, two of his most popular characters created in the
   1960s, as representative examples of his bentuwork. This chapter
   analyses Liu's Brother Asan and Great Auntie travel series to
   interrogate how the concept of bentuhas been applied retrospectively to
   his comics. We argue that rather than promoting the Taiwan nationalist
   bentu concept, Liu's comics represent Taiwanese culture as a more
   complex Sinophone culture, in which Taiwanese local cultures are tightly
   interwoven with China-centric values. While these works reveal the
   author's affection for Taiwanese culture, they also reflect implicit
   bias against people from rural Taiwan, which largely conforms with the
   Kuomintang's Chinese nationalist ideology. We suggest that the
   resurgence of Liu's comics can be explained by the rise in bentu
   consciousness in the 2000s, when the Taiwanese government and society
   devoted themselves to building a new national identity couched in
   nostalgic memories of local Taiwanese culture in the 1950s and 1960s.},
