@article{ WOS:000569574100001,
Author = {Soto, Diego and Antonio Garcia-Herrero, Juan and Carcedo, Rodrigo J.},
Title = {Well-Being and Throwing Speed of Women Handball Players Affected by
   Feedback},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2020},
Volume = {17},
Number = {17},
Month = {SEP},
Abstract = {This research aims at studying the effect of feedback on well-being
   (vitality, and positive and negative affect), competence valuation,
   perceived competence, motivation, and performance (throwing speed and
   accuracy) in a throwing task. Thirty nine expert women handball players,
   with experience in international handball competitions, participated in
   this study. They were indiscriminately ascribed to one of three
   different experimental conditions measuring feedback: (positive,
   negative, and none). Significant differences in well-being (positive
   affect) and throwing speed were found among the three feedback groups.
   More concretely, higher levels of positive affect and throwing speed
   were found in the negative feedback group in comparison with the other
   two groups (positive and no-feedback). These results have important
   implications for athletes' well-being and performance, and for coaches'
   training programs.},
Publisher = {MDPI},
Address = {MDPI AG, Grosspeteranlage 5, CH-4052 BASEL, SWITZERLAND},
