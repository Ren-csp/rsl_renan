@article{ WOS:000180657600004,
Author = {dos Santos, SR and Schor, N},
Title = {Experiencing motherhood in early adolescence},
Journal = {REVISTA DE SAUDE PUBLICA},
Year = {2003},
Volume = {37},
Number = {1},
Pages = {15-23},
Month = {FEB},
Abstract = {Objective
   Although still scarcely studied in Brazil, motherhood in early
   adolescence among girls aged 10 to 14 years is mostly unwanted and it is
   an important public health issue. Most investigations are based on
   biomedical paradigms and few take into consideration the adolescent
   point of view. This study aimed to explore the different patterns of
   experiencing early motherhood from the adolescent own point of view.
   Methods
   William Stephenson Q methodology was applied. The study population was
   selected from 2 public mother and child health units in Rio de Janeiro,
   Brazil, and comprised 20 adolescents who became pregnant at the age of
   10 to 14 years and were followed up for a period of 6 to 24 months after
   giving birth. Q-sorts underwent factor analysis and then the factors
   were interpreted.
   Results
   Four qualitatively and statistically (p<0.01) perception patterns were
   found. Two factors were well defined: Factor I - Satisfied with
   motherhood/Dependent on the child affection: motherhood is a positive
   and rich experience; and Factor II Depressed/Stressed out: motherhood is
   a negative and stressful experience. Other two potential factors need
   confirmation in further studies with a larger sample size.
   Conclusions
   It was observed that motherhood experience is distinct and
   heterogeneous. For some adolescents, motherhood could be a rewarding
   experience.},
