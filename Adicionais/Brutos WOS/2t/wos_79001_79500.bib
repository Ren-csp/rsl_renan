@article{ WOS:000959195600001,
Author = {Song, Guanghui and Zhan, Yan and Hu, Yajie and Rao, Jun and Li, Nan and
   Wu, Zhongxuan and Su, Zhenhua and Lu, Baozhong and Liu, Ruiping and
   Jiang, Bo and Chen, Gegu and Peng, Feng},
Title = {Paper-Mill Waste Reinforced Nanofluidic Membrane as High-Performance
   Osmotic Energy Generators},
