@article{ WOS:A1947XX27700009,
Author = {COWEN, EDH},
Title = {AN ACCOUNT OF THE HEALTH OF NURSES AT WESTMINSTER HOSPITAL FROM JULY
   1943 TO JULY 1946},
Journal = {JOURNAL OF HYGIENE},
Year = {1947},
Volume = {45},
Number = {4},
Pages = {443-467},
Abstract = {The medical condition of student nurses on admission was analyzed.
   Failure to complete training was usually due to selection of an
   uncongenial vocation. Analysis of illnesses occurring in the 3-yr.
   period showed that 60\% were due to respiratory or skin infections, a
   higher incidence than previously reported. Eleven days were lost
   annually per nurse. Long illness of more than 50 days duration accounted
   for 5\% of illnesses and 30\% of time lost. Staff nurses had lower
   morbidity rates than student nurses. For 20 yrs. the attack rate has
   decreased, and the duration of common illnesses has decreased, except
   for catarrhal affections. Suggestions are made for promotion of health
   of nurses.},
