@article{ WOS:000935362100002,
Author = {Figueroa, Gustavo},
Title = {Neuroethics: the reign of neuroscience begins in the foundation of the
   ethics},
Journal = {ACTA BIOETHICA},
Year = {2022},
Volume = {28},
Number = {2},
Pages = {183-195},
Month = {OCT},
Abstract = {1] The Neuroscience of Ethics constitutes a progress when applying
   empirical science in the investigation of the moral phenomenon. 2]
   Emphasizing the importance of affects and feelings represents a
   compensation for the excessive importance given to reason in the
   formation of moral judgments. 3] There are serious methodological
   difficulties by not specifying the concepts of intuition, affections,
   duty and especially what is understood by ethics. 4] But scientific
   research apprehends man as an ``entity `` in himself (present) and not
   as an ``existence `` (future), that is, being-in-the-world. 5] Instead
   of ``having `` a moral, the human being ``is `` moral and as such is a
   project thrown towards its most authentic possibility that consists of
   appropriating its being-for-death.},
