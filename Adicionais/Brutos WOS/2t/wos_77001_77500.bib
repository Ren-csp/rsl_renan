@article{ WOS:001650771600011,
Author = {Brooks, Jas and Kucirkova, Natalia and Spence, Charles},
Title = {How Scratch-and-Sniff Books Encode Smell Across Development},
Journal = {MULTISENSORY RESEARCH},
Year = {2025},
