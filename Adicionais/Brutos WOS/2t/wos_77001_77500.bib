@article{ WOS:000893648600047,
Author = {da Silva Junior, Alcidesio Oliveira},
Title = {The curriculum-imagem of the music video: educating eyes on gender and
   sexuality differences},
Journal = {LINHAS CRITICAS},
Year = {2022},
Volume = {28},
Month = {JAN-DEC},
Abstract = {What can an image do? Inspired by Deleuze and Guattari and post-critical
   theories of curriculum, I aim, through a cartography, to understand how
   the music video Vigrar vel til loftarasa by the band Sigur Ros provides
   an aesthetic experience in the education of the look at gender and
   sexuality differences. I conclude by arguing that the curriculum-image
   not only recognizes our ability to cognitively understand the world
   around us, with its logics and measures, but also understands that
   affections are fundamental for us to penetrate the surface of otherness,
   recognizing differences, nurturing us to participate more creatively in
   relationships with others.},
