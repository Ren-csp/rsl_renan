@article{ WOS:000887279500001,
Author = {Valladares-Garrido, Mario J. and Zapata-Castro, Luis E. and
   Valdiviezo-Morales, Christopher G. and Garcia-Vicente, Abigail and
   Leon-Figueroa, Darwin A. and Calle-Preciado, Raul and Failoc-Rojas,
   Virgilio E. and Pereira-Victorio, Cesar Johan and Diaz-Velez, Cristian},
Title = {Factors Associated with Knowledge of Evacuation Routes and Having an
   Emergency Backpack in Individuals Affected by a Major Earthquake in
   Piura, Peru},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {22},
Month = {NOV},
Abstract = {Information on the prevention of earthquakes in Peru, a high-risk
   country, is still emerging. We determined the frequency and factors
   associated with knowledge of evacuation routes and the use of emergency
   backpacks in people affected by a major earthquake. A cross-sectional
   study using secondary data was conducted from August-December 2021 on
   people that experienced the 6.1 magnitude earthquake that occurred in
   Piura, Peru on 30 July 2021. The outcome was self-reported knowledge of
   evacuation routes and the use of emergency backpacks. The association
   with self-reported earthquake preparation training, use of sources of
   information on earthquakes, and sociodemographic variables was
   investigated. A total of 69.5\% of participants knew evacuation routes,
   and 46.3\% had an emergency backpack. A higher frequency of knowledge of
   evacuation routes was associated with previous training (PR: 1.47; 95\%
   CI: 1.15-1.87), use of the media (PR: 1.35; 95\% CI: 1.06-1.72), having
   received information from the COEN (PR: 1.19; 95\% CI: 1.02-1.40), and
   with a greater number of household members (PR: 1.03; 95\% CI:
