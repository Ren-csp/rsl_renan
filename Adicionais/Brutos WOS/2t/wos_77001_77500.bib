@article{ WOS:001539730400003,
Author = {Akbari, Paria and Yazdanfar, Seyed-Abbas and Norouzian-Maleki, Saeid and
   Hosseini, Seyed-Bagher},
Title = {Balconies' visual preferences: The case of residential apartments in
   Tehran, Iran},
