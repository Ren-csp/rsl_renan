   Diway, Bibian; Kaliang, Het; Chong, Lucy, Sarawak Forestry Corp, Appl Forest Sci \& Ind Dev, Kuching, Sarawak, Malaysia.
   Itioka, Takao, Kyoto Univ, Grad Sch Human \& Environm Studies, Kyoto, Japan.
   Sakai, Shoko, Res Inst Humanity \& Nat, Kyoto, Japan.},
DOI = {10.1371/journal.pone.0074426},
