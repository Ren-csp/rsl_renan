@article{ WOS:001395487400001,
Author = {Mcewan, Cheryl and Daya, Shari and Hughes, Alex},
Title = {Food, memory, and changing framings of sustainable consumption in
   Johannesburg},
Journal = {CRITICAL AFRICAN STUDIES},
Year = {2025},
Volume = {17},
Number = {2, SI},
Pages = {119-137},
Month = {MAY 4},
Abstract = {This paper addresses how food, tradition, and memories intersect with
   how sustainable food consumption is conceived, practiced, and mobilised.
   Using ethnographic research, the paper examines articulations and
   practices of `good food' among food system actors and middle-class
   consumers in Johannesburg, South Africa. It argues that a nuanced and
   contextualised understanding of foodways and food consumption is
   required to capture the relationships between food cultures and
   consumption practices in African contexts, as well as to speculate on
   emerging pathways to sustainability during contemporary crises through
   conceptualising eating as an ethical act. After contextualising the
   research within South Africa's contemporary food system and the
   historical legacies that continue to shape it, the paper argues that
   memory and tradition are central in consumer perceptions of good food.
   They also enable consumers to viscerally sense both pasts and futures in
   which they can gain control of their diets, health, and extract some
   independence from an industrial urban food system that they do not
   entirely trust. The paper explores the possibilities of combining
   consumer interest in traditional foods with increasing concern for the
   biodiversity of underutilised species, and the role of food activists
   and influencers to promote sustainable food consumption. The paper
   concludes that a growing interest in traditional foods is emerging at
   the confluence of fashionable, `ethical' food trends which, if harnessed
   sensitively, has potential to promote more sustainable foodways.
   Cet article traite de la mani \& egrave;re dont l'alimentation, la
   tradition et les souvenirs s'entrecroisent avec la conception, la
   pratique et la mobilisation d'une consommation alimentaire durable. \&
   Agrave; l'aide d'une recherche ethnographique, il examine les
   articulations et les pratiques de la << bonne alimentation >> parmi les
   acteurs du syst \& egrave;me alimentaire et les consommateurs de la
   classe moyenne \& agrave; Johannesburg, en Afrique du Sud. Il soutient
   qu'une compr \& eacute;hension nuanc \& eacute;e et contextualis \&
   eacute;e des habitudes alimentaires et de la consommation de nourriture
   est n \& eacute;cessaire pour saisir les relations entre les cultures
   alimentaires et les pratiques de consommation dans les contextes
   africains, ainsi que pour sp \& eacute;culer sur les voies \&
   eacute;mergentes vers la durabilit \& eacute; pendant les crises
   contemporaines en conceptualisant l'alimentation comme un acte \&
   eacute;thique. Apr \& egrave;s avoir replac \& eacute; la recherche dans
   le contexte du syst \& egrave;me alimentaire sud-africain contemporain
   et des h \& eacute;ritages historiques qui continuent \& agrave; le fa
   \& ccedil;onner, l'article affirme que la m \& eacute;moire et la
   tradition jouent un r \& ocirc;le central dans la perception qu'ont les
   consommateurs de la bonne nourriture. Elles permettent \&
   eacute;galement aux consommateurs de ressentir visc \& eacute;ralement
   le pass \& eacute; et l'avenir dans lesquels ils peuvent prendre le
   contr \& ocirc;le de leur alimentation et de leur sant \& eacute;, et
   s'affranchir d'un syst \& egrave;me alimentaire urbain industriel auquel
   ils ne font pas enti \& egrave;rement confiance. L'article explore les
   possibilit \& eacute;s de combiner l'int \& eacute;r \& ecirc;t des
