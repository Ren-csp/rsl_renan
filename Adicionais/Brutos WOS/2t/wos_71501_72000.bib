   Scott-Harp, Deann; Peek-Asa, Corinne; Rohlman, Diane S.; Janssen, Brandi, Univ Iowa, Dept Occupat \& Environm Hlth, Iowa City, IA 52242 USA.},
DOI = {10.1002/ajim.23043},
