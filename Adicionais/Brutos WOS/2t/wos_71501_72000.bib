@article{ WOS:000357318200032,
Author = {Sussman, Adrienne F. and Ha, Renee Robinette and Henry, Hilary E.},
Title = {Attitudes, knowledge and practices affecting the Critically Endangered
   Mariana crow Corvus kubaryi and its conservation on Rota, Mariana
   Islands},
Journal = {ORYX},
