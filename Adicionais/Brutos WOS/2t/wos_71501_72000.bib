@article{ WOS:000694666900043,
Author = {Shen, Chen and Nayak, Anmada and Neitzel, Leif R. and Adams, Amber A.
   and Silver-Isenstadt, Maya and Sawyer, Leah M. and Benchabane, Hassina
   and Wang, Huilan and Bunnag, Nawat and Li, Bin and Wynn, Daniel T. and
   Yang, Fan and Garcia-Contreras, Marta and Williams, Charles H. and
   Dakshanamurthy, Sivanesan and Hong, Charles C. and Ayad, Nagi G. and
   Capobianco, Anthony J. and Ahmed, Yashi and Lee, Ethan and Robbins,
   David J.},
Title = {The E3 ubiquitin ligase component, Cereblon, is an evolutionarily
   conserved regulator of Wnt signaling},
Journal = {NATURE COMMUNICATIONS},
Year = {2021},
Volume = {12},
Number = {1},
Month = {SEP 6},
Abstract = {Immunomodulatory drugs (IMiDs) are important for the treatment of
   multiple myeloma and myelodysplastic syndrome. Binding of IMiDs to
   Cereblon (CRBN), the substrate receptor of the CRL4(CRBN) E3 ubiquitin
   ligase, induces cancer cell death by targeting key neo-substrates for
   degradation. Despite this clinical significance, the physiological
   regulation of CRBN remains largely unknown. Herein we demonstrate that
   Wnt, the extracellular ligand of an essential signal transduction
   pathway, promotes the CRBN-dependent degradation of a subset of
   proteins. These substrates include Casein kinase 1 alpha (CK1 alpha), a
   negative regulator of Wnt signaling that functions as a key component of
   the beta-Catenin destruction complex. Wnt stimulation induces the
   interaction of CRBN with CK1 alpha and its resultant ubiquitination, and
   in contrast with previous reports does so in the absence of an IMiD.
   Mechanistically, the destruction complex is critical in maintaining CK1
   alpha stability in the absence of Wnt, and in recruiting CRBN to target
   CK1 alpha for degradation in response to Wnt. CRBN is required for
   physiological Wnt signaling, as modulation of CRBN in zebrafish and
   Drosophila yields Wnt-driven phenotypes. These studies demonstrate an
   IMiD-independent, Wnt-driven mechanism of CRBN regulation and provide a
   means of controlling Wnt pathway activity by CRBN, with relevance for
   development and disease.
   Cereblon (CRBN) is an E3 ubiquitin ligase substrate receptor that is
   involved in cancer cell death, although its regulation is poorly
   understood. Here, the authors show that Wnt ligand increases
   CRBN-dependent protein degradation and demonstrate CRBN's importance in
   physiological Wnt signaling.},
