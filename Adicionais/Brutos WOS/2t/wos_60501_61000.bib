@article{ WOS:001865212200001,
Author = {Marcos-Rivero, Bingen and Ortuondo, Jon and Yanci, Javier},
Title = {Is theoretical training enough? Effects of a university course on
   disability and health in physical activity and sport science students},
Journal = {FRONTIERS IN EDUCATION},
Year = {2026},
Volume = {11},
Month = {AUG 19},
Abstract = {Introduction: The preparation of future physical activity and sport
   professionals to promote inclusive and health-oriented practices for
   people with disabilities remains a persistent challenge in higher
   education. This study examined the effects of the course Physical
   Activity for the Health of People with Disabilities on students of a
   Bachelor's Degree in Physical Activity and Sport Sciences. Methods:
   Fifty-eight fourth-year students participated in a pre-post
   mixed-methods design combining questionnaires with open-ended questions.
   Results: Quantitative analyses revealed improvements in perceptions of
   theoretical training (p < 0.001; r(b) = -0.71, large), methodology (p =
   0.041; d = -0.27, small), and community participation (p = 0.044; r(b) =
   -0.35, moderate). Conversely, decreases emerged in academic self-concept
   (p = 0.002; r(b) = 0.47, moderate) and self-efficacy (p < 0.001; r(b) =
   0.62, large). Qualitative findings provided a nuanced interpretation of
   these results. Students reported acquiring a more structured conceptual
   framework and greater awareness of social, environmental, and
   attitudinal barriers affecting participation in physical activity.
   However, this increased cognitive understanding was accompanied by
   heightened recognition of the complexity of inclusive practice. The
   absence of authentic practical experiences and direct interaction with
   people with disabilities emerged as a recurrent theme, limiting
   perceived preparedness and confidence for real professional contexts.
   Discussion: Overall, the integration of findings suggests that
   predominantly theoretical training enhances knowledge and critical
   awareness but may simultaneously expose perceived competence gaps.
   Incorporating structured experiential learning opportunities appears
   essential to strengthen professional self-efficacy and facilitate
   effective transfer to inclusive practice settings.},
