Author = {Portale, Federica and Carriero, Roberta and Iovino, Marta and
   Kunderfranco, Paolo and Pandini, Marta and Marelli, Giulia and Morina,
   Nicolo and Lazzeri, Massimo and Casale, Paolo and Colombo, Piergiuseppe
