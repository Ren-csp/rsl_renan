@article{ WOS:000456010800009,
Author = {Vogg, Matthias C. and Beccari, Leonardo and Olle, Laura Iglesias and
   Rampon, Christine and Vriz, Sophie and Perruchoud, Chrystelle and
   Wenger, Yvan and Galliot, Brigitte},
Title = {An evolutionarily-conserved Wnt3/β-catenin/Sp5 feedback loop restricts
   head organizer activity in Hydra},
Journal = {NATURE COMMUNICATIONS},
Year = {2019},
Volume = {10},
Month = {JAN 18},
Abstract = {Polyps of the cnidarian Hydra maintain their adult anatomy through two
   developmental organizers, the head organizer located apically and the
   foot organizer basally. The head organizer is made of two antagonistic
   cross-reacting components, an activator, driving apical differentiation
   and an inhibitor, preventing ectopic head formation. Here we
   characterize the head inhibitor by comparing planarian genes
   down-regulated when beta-catenin is silenced to Hydra genes displaying a
   graded apical-to-basal expression and an up-regulation during head
   regeneration. We identify Sp5 as a transcription factor that fulfills
   the head inhibitor properties: leading to a robust multiheaded phenotype
   when knocked-down in Hydra, acting as a transcriptional repressor of
   Wnt3 and positively regulated by Wnt/beta-catenin signaling. Hydra and
   zebrafish Sp5 repress Wnt3 promoter activity while Hydra Sp5 also
   activates its own expression, likely via beta-catenin/TCF interaction.
   This work identifies Sp5 as a potent feedback loop inhibitor of
   Wnt/beta-catenin signaling, a function conserved across eumetazoan
   evolution.},
