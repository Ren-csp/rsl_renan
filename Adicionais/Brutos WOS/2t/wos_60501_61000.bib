Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Ludvig, A (Corresponding Author), Univ Nat Resources \& Life Sci, Inst Forest Environm, Vienna BOKU, Vienna, Austria.
   Ludvig, A (Corresponding Author), Nat Resource Policy \& European Forest Inst, EFI Forest Policy Res Network, Vienna, Austria.
