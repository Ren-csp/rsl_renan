@article{ WOS:000246853700035,
Author = {Stegmeier, Frank and Sowa, Mathew E. and Nalepa, Grzegorz and Gygi,
   Steven P. and Harper, J. Wade and Elledge, Stephen J.},
Title = {The tumor suppressor CYLD regulates entry into mitosis},
