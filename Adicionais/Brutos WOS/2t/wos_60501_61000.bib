@article{ WOS:000720682600012,
Author = {Shi, Liuhua and Steenland, Kyle and Li, Haomin and Liu, Pengfei and
   Zhang, Yuhan and Lyles, Robert H. and Requia, Weeberb J. and Ilango,
   Sindana D. and Chang, Howard H. and Wingo, Thomas and Weber, Rodney J.
