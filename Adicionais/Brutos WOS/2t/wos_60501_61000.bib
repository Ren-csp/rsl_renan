@article{ WOS:001466656200001,
Author = {Castro, Johanne Rei R. and Delina, Laurence L.},
Title = {Extreme heat in focus: comparing media narratives from the Philippines
   and Hong Kong},
Journal = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
Year = {2025},
Volume = {7},
Number = {4},
Month = {APR 1},
Abstract = {As extreme heat events escalate and emerge as significant global
   phenomena with severe local repercussions, the role of news media in
   reporting these incidents becomes pivotal. Online news reporting
   enhances public awareness regarding the effects of extreme heat and
   informs strategies for coping and adaptation. Consequently, evaluating
   online media narratives that shape public perceptions and behaviours
   toward extreme heat is imperative. This study presents a comparative
   qualitative analysis of online news articles about extreme heat
   published between 2010 and June 2024 by news organisations in Hong Kong
   and Manila. This timeframe corresponds with the increasing intensity and
   frequency of global heatwaves. We examine the way online news media
   frames extreme heat as a hazard by analysing how they communicate
   impacts, vulnerabilities, coping strategies, and the roles of various
   actors in facilitating adequate adaptation. Both cities exhibit a trend
   of more frequent reporting on heatwaves as they occur and the
   responsibilities of involved actors. In Hong Kong, information primarily
   circulates regarding the characteristics of extreme heat occurrences,
   such as temperature, alongside relevant enhancements of early warnings.
   In contrast, Manila focuses on informing the public about the current
   measures to respond to and mitigate the effects of heat. The findings
   reveal a significant evolution within online news media, transitioning
   from a primary focus on informing the public about the impacts of
   extreme heat to actively engaging in risk preparedness and response.
   This shift is characterised by an enhanced communication of adaptation
   strategies and an increased urgency to mitigate the adverse effects of
   extreme heat. Further research is warranted to explore the roles of
   other digital platforms, such as social media, across the various phases
   of extreme heat risk management.},
