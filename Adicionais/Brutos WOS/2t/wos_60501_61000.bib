Title = {Prevalence, awareness, treatment, and control of diabetes in India: a
   nationally representative survey of adults aged 45 years and older},
Journal = {LANCET GLOBAL HEALTH},
Year = {2025},
Volume = {13},
Number = {9},
Pages = {e1543-e1552},
