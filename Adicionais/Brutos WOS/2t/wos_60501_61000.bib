@article{ WOS:001593220700003,
Author = {Ye, Youyin and Sun, Xiuwu and Lin, Heshan and Wang, Yu and Chen,
   Yanghang and Zhou, Qianqian and Chen, Baohong and He, Xuebao and Xiang,
   Peng and Lin, Hui},
Title = {Screening of high-risk phytoplankton species and mechanisms of bloom
   outbreaks in temperate waters adjacent to a nuclear power plant},
Journal = {MARINE POLLUTION BULLETIN},
Year = {2026},
Volume = {222},
Number = {2},
Month = {JAN},
Abstract = {Harmful algal blooms pose acritical biosecurity challenge for nuclear
   power plant (NPP) cooling systems worldwide. The seasonality of
   environmental factors, combined with the complexities of human activity
   in the waters adjacent to nuclear facilities, makes identifying
   clogging-risk phytoplankton species and understanding their bloom
   mechanisms especially challenging. We conducted 4 seasonal surveys in
   temperate waters near a certain NPP to screen for phytoplankton species
   that could potentially clog the cooling system and analyze the key
   environmental factors influencing the spatiotemporal distribution of
   these risk species. A total of 195 phytoplankton species were recorded,
   within 68 genera, 6 phyla. An analysis of environmental factors revealed
   that those influencing phytoplankton growth and distribution varied by
   season: in winter, phytoplankton abundance was positively correlated
   with thermal discharge; in summer, it was negatively correlated; in
   spring, no clear relationship was observed; and in autumn, phytoplankton
   abundance was primarily governed by turbidity and nutrient levels. Based
   on historical records of red tide organisms, dominant species, and red
   tide events over the past two decades in the surveyed sea area,
   supplemented by previous literature, 15 phytoplankton species posing
   clogging risks were identified. Among them, Noctiluca scintillans has
   been identified as a potential medium-to high-risk species, warranting
   particular attention during winter and spring. Suitable temperature,
   ample food availability, high water transparency, and tidal movement are
   the primary factors influencing its growth and distribution. The
   findings of this study contribute to a better understanding of the
   environmental regulatory mechanisms underlying the outbreaks of
   phytoplankton clogging-risk species in temperate nuclear power plant
   regions.},
