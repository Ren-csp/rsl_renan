   Rai, Dipa, GoldenGate Int Coll, Dept Environm Sci, Kathmandu, Nepal.
   Bhandari, Simrik, Kathmandu Univ, Dept Environm Sci \& Engn, Dhulikhel, Nepal.
   Ghimirey, Yadav, Friends Nat, Kathmandu, Nepal.},
DOI = {10.1002/ece3.8512},
Article-Number = {e8512},
ISSN = {2045-7758},
Keywords = {Churia hills; detectability; habitat use; Nepal; occupancy; sloth bear},
