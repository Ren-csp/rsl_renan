@article{ WOS:000779716100003,
Author = {Lu, Defen and Shang, Guijun and Li, Jie and Lu, Yong and Bai, Xiao-chen
   and Zhang, Xuewu},
Title = {Activation of STING by targeting a pocket in the transmembrane domain},
Journal = {NATURE},
Year = {2022},
Volume = {604},
