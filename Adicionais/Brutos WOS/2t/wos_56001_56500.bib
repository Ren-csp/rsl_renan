   Diaz-Meco-Nino, Ana Maria and Martinez-Linares, Jose Manuel},
Title = {Quality Assurance in Nursing Education: A Qualitative Study Involving
   Students and Newly Graduated Nurses},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
