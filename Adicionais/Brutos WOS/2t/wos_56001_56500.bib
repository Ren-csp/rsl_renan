@article{ WOS:001801498300001,
Author = {Elaissaoui, Fouzia and Bakloul, Nacer and Aanniz, Tarik and Alsayer,
   Ibrahim Ali and Boukhris, Mostafa and Sennoune, Mohamed and Elharchli,
   El Hassan},
Title = {Molecular docking and dynamic simulations of Rosmarinus
   officinalis L anti-breast cancer activity against MCF-7 cell
   line},
Journal = {SCIENTIFIC AFRICAN},
Year = {2026},
Volume = {33},
Month = {SEP},
Abstract = {Breast cancer (BC) is one of the most frequent types of cancer that
   affect women and various hormone therapy strategies have been designed
   to attenuate the proliferation of cancer cells. In this study, the
   anticancer potential of Rosmarinus officinalis essential oils (ROEO)
   from Taza region (Morocco) was investigated against the MCF-7 cell line.
   Molecular docking, ADME assessment, toxicity evaluation and molecular
   dynamics simulation were used to evaluate the anticancer activity of 32
   molecules present in ROEO. In silico ADMET evaluation indicated that the
   main compounds exhibited high intestinal absorption, no predicted AMES
   toxicity, suggesting good pharmacokinetic and safety profiles. All
   compounds also obeyed Lipinski's rule of five, highlighting their
   drug-likeness and potential as orally active therapeutic agents.
   Molecular docking revealed that alpha-pinene exhibit a strong binding
   affinity toward the Human estrogen receptor alpha protein (PDB ID: 2IOG)
   and having an energy score of -10.2 kcal/mol. Molecular dynamics
   simulations during 100 ns at 300 K revealed a significant stability of
   the complex with two ligands (alpha -pinene and borneol) exhibiting the
   highest affinity during molecular docking (-10. 2 and -9.0 kcal/mol
   respectively) by forming binding interactions with the two ligands. This
   interaction helps prevent the binding of E2 with ER-alpha, consequently
   inhibiting the proliferation of cancer cells within the MCF-7 cell line.
   The in-silico approach followed showed that the molecules contained in
   ROEO could exhibit anticancer activity.},
