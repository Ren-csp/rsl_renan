Address = {1160 BATTERY STREET, STE 100, SAN FRANCISCO, CA 94111 USA},
Type = {Article},
Language = {English},
Affiliation = {Ernstgård, L (Corresponding Author), Karolinska Inst, Inst Environm Med, Work Environm Toxicol, Stockholm, Sweden.
   Ernstgard, Lena; Dwivedi, Aishwarya M.; Johanson, Gunnar, Karolinska Inst, Inst Environm Med, Work Environm Toxicol, Stockholm, Sweden.
   Lundstrom, Johan N., Karolinska Inst, Div Psychol, Dept Clin Neurosci, Stockholm, Sweden.},
DOI = {10.1371/journal.pone.0185479},
