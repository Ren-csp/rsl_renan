@article{ WOS:001376827800025,
Author = {Jackson, Katrina M. and Kono, Thomas J. Y. and Betancourt, Jovany J. and
   Wang, Yina and Kabbale, Kisakye D. and Ding, Minna and Kezh, Perry and
   Ha, Grace and Yoder, J. Marina and Fulton, Sophie R. and Mukaremera,
   Liliane and Tiffin, Peter and Gusa, Asiya and Meya, David B. and
   Billmyre, R. Blake and Xue, Chaoyang and Nielsen, Kirsten},
Title = {Single nucleotide polymorphisms are associated with strain-specific
   virulence differences among clinical isolates of Cryptococcus
   neoformans},
Journal = {NATURE COMMUNICATIONS},
Year = {2024},
Volume = {15},
Number = {1},
Month = {DEC 2},
Abstract = {Studies across various pathogens highlight the importance of pathogen
   genetic differences in disease manifestation. In the human fungal
   pathogen Cryptococcus neoformans, sequence type (ST) associates with
   patient outcome. We performed a meta-analysis of four genomic studies
   and identified overlapping gene regions associated with virulence,
   suggesting the importance of these gene regions in cryptococcal disease
   in diverse clinical isolates. We explored the relationship between
   virulence and strain genetic differences using the cryptococcosis mouse
   model and a closely related library of ST93 clinical isolates. We
   identified four in vivo virulence phenotypes: hypervirulence, typical
   virulence with CNS disease, typical virulence with non-CNS disease, and
   latent disease. Hypervirulent isolates were clade specific and
   associated with an interferon gamma (IFN gamma) dominated immune
   response. Using a genome wide association study (GWAS), we identified
   nine genes with polymorphisms associated with IFN gamma production,
   including the inositol sensor ITR4. The itr4 Delta mutant recapitulated
   the hypervirulence phenotype and ITR4 affects expression of two IFN
   gamma associated genes. Finally, we showed that IFN gamma production is
   associated with SNPs that downregulate ITR4 and with SNP accumulation in
   other IFN gamma associated genes. These data highlight the complex role
   of pathogen genetics in virulence and identify genes associated with
   hypervirulence and IFN gamma in Cryptococcus neoformans.},
