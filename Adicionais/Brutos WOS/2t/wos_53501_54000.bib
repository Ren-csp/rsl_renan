@article{ WOS:000416226200007,
Author = {Ait-Bouziad, Nadine and Lv, Guohua and Mahul-Mellier, Anne-Laure and
   Xiao, Shifeng and Zorludemir, Gizem and Eliezer, David and Walz, Thomas
   and Lashuel, Hilal A.},
Title = {Discovery and characterization of stable and toxic Tau/phospholipid
   oligomeric complexes},
Journal = {NATURE COMMUNICATIONS},
Year = {2017},
Volume = {8},
Month = {NOV 22},
Abstract = {The microtubule-associated protein Tau plays a central role in the
   pathogenesis of Alzheimer's disease. Although Tau interaction with
   membranes is thought to affect some of its physiological functions and
   its aggregation properties, the sequence determinants and the structural
   and functional consequences of such interactions remain poorly
   understood. Here, we report that the interaction of Tau with vesicles
   results in the formation of highly stable protein/phospholipid
   complexes. These complexes are toxic to primary hippocampal cultures and
   are detected by MC-1, an antibody recognizing pathological Tau
   conformations. The core of these complexes is comprised of the PHF6{*}
   and PHF6 hexapeptide motifs, the latter in a beta-strand conformation.
   Studies using Tau-derived peptides enabled the design of mutants that
   disrupt Tau interactions with phospholipids without interfering with its
   ability to form fibrils, thus providing powerful tools for uncoupling
   these processes and investigating the role of membrane interactions in
   regulating Tau function, aggregation and toxicity.},
Publisher = {NATURE PUBLISHING GROUP},
Address = {MACMILLAN BUILDING, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
