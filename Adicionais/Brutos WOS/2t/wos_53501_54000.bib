   Cai, Wenjing, Univ Sci \& Technol China, Sch Publ Affairs, Hefei, Peoples R China.
   Jiang, Yang, Hefei Univ, Sch Tourism \& Events, Hefei, Peoples R China.},
DOI = {10.1016/j.ijhm.2023.103436},
