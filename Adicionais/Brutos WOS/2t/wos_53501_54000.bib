@article{ WOS:001732354900001,
Author = {Mazhar, Noor},
Title = {Planning after the fact},
Journal = {PLANNING PERSPECTIVES},
Year = {2026},
Volume = {41},
Number = {4, SI},
Pages = {1019-1044},
Month = {JUL 4},
Abstract = {Planning `after' the fact is a mode of planning in which state
   intervention follows popular urbanism to direct existing development
   patterns towards state objectives. It offers a conceptual vocabulary to
   understand this mode of planning as: (i) Transversal, (ii) Relational,
   (iii) Pragmatic, and (iv) Speculative. As transversal, it captures how
   the state intervenes in unsettled conditions, creating pathways to
   regularization without eradication or full formalization. As relational,
   it highlights how bureaucratic activists rely on interpersonal
   relationships, shared professional histories, and the ability to
   translate across institutional languages when intervening in contexts
   marked by mistrust and inequalities. It is pragmatic, as actors
   temporarily zone out of broader ideological contestations to secure
   collective objectives such as expanded affordable rental housing,
   opportunities for emerging Black-owned enterprises, and a wider rates
   and services base. Last, it is speculative, as urban actors, including
   the state, anticipate future returns: while financial institutions and
   developers speculate on the pending by-law's impact on their investment,
   the municipality speculates increased revenues from an expanded rates
   and services base. Together, these dynamics show how the state remains
   present and responsive even when urban development precedes formal
   regulation.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
