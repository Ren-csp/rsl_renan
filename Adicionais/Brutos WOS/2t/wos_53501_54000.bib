@article{ WOS:000769721400001,
Author = {Zhu, Yuhan and Chen, Guangwu and Xu, Lixiao and Zhang, Ying and Wang,
   Yafei and Liang, Sai},
Title = {Inequality of household consumption and PM2.5 footprint
   across socioeconomic groups in China},
