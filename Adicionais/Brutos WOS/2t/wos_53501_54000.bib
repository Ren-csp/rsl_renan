@article{ WOS:001844500100001,
Author = {Zhang, Yushu and Liu, Han and Yang, Feiyun and Zhang, Yingliang},
Title = {The impact of labor migration and collective action on farmland
   abandonment in China: from perspective of rice theory},
Journal = {ENVIRONMENTAL AND SUSTAINABILITY INDICATORS},
Year = {2026},
Volume = {31},
Month = {SEP},
Abstract = {The rice theory, based on ``south-rice, north-wheat{''} planting pattern
   in China, reveals the mechanisms underlying the formation of
   collectivist culture in southern China and individualist culture in
   northern China. Rice cultivation cannot do without irrigation
   facilities. In China, the maintenance of such facilities represents a
   typical form of rural collective action. Against the backdrop of rapid
   urbanization, a large number of rural laborers migrate between urban and
   rural areas, triggering profound changes in farmland ownership and the
   restructuring of internal village governance. Based on China Labor-force
   Dynamics Survey (CLDS), this paper uses the mediation effect model to
   investigate impact of labor migration on farmland abandonment and the
   underlying mechanisms at play. Labor migration exerts a significant
   positive impact on farmland abandonment, and the results remain robust
   following a series of robustness tests. Furthermore, mechanism analysis
   reveals that participation in collective action is a mediator in the
   relationship between labor migration and farmland abandonment. Our
   heterogeneity analysis also demonstrates that the trend of farmland
   abandonment is significantly more pronounced in southern China than in
   northern China. This is because rice cultivation is more dependent on
   collective action. We propose that the government should implement
   ploughing and reclamation initiatives in light of regional geographical
   differences, thereby reshaping the capacity for collective coordination
   and mitigating the adverse impacts arising from population mobility.},
