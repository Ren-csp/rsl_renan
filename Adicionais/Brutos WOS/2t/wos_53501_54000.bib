@article{ WOS:001733213300001,
Author = {Huang, G. and Lu, X. S. and Ma, Q. and Wang, J. and Wang, P. F. and Wu,
   Y. C.},
Title = {FUNCTIONALITY OPTIMIZATION STUDY ON LATERITIC SOIL ECOLOGICAL SUBSTRATES},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {3509-3525},
Abstract = {Ecological restoration is of profound significance for protecting the
   ecological integrity and engineering safety of lateritic soil areas.
   However, the formulations of lateritic soil ecological substrates have
   rarely been explored. The objective of this study was therefore to
   evaluate the effects of the lateritic soil:soil ratio (1000:0 g, 750:250
   g, 500:500 g, 250:750 g), fly ash content (0, 30 g \& centerdot;kg(-1),
   60 g \& centerdot;kg(-1), 90 g \& centerdot;kg(-1)), maize straw content
   (0, 40 g \& centerdot;kg(-1), 80 g \& centerdot;kg(-1), 120 g \&
   centerdot;kg(-1)), and expanded polystyrene (EPS) content (0, 5 g \&
   centerdot;kg(-1),10 g \& centerdot;kg(-1),15 g \& centerdot;kg(-1)) in
   an orthogonal design to optimize an ecological substrate according to
   various physicochemical, nutrient contents, mechanical, and vegetation
   parameters. The results indicated that the lateritic soil:soil ratio had
   significant effects on the nutrient content and vegetation growth
   parameters; fly ash significantly improved the mechanical parameters
   (shear strength, cohesion, and internal friction angle); maize straw
   significantly affected the physical parameters and improved the
   substrate nutrient content; and EPS was more beneficial to the
   vegetation germination ratio. A lateritic soil: soil ratio of 1:1
   (500:500 g), fly ash content of 60 g \& centerdot;kg(-1), maize straw
   content of 100 g \& centerdot;kg(-1), and EPS content of 10 g \&
   centerdot;kg(-1) was determined to produce the optimal mix for the
   ecological restoration of lateritic soil. The conclusions of this
   research provide theoretical and practical guidance for the ecological
   restoration and stabilization of lateritic soil slopes.},
