@ARTICLE{Hung2022,
	author = {Hung, Shih-Han and Chang, Chun-Yen},
	title = {How do humans value urban nature? Developing the perceived biophilic design scale (PBDs) for preference and emotion},
	year = {2022},
	journal = {Urban Forestry and Urban Greening},
	volume = {76},
