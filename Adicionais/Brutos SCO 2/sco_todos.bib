	affiliations = {Graduate Program in Ecology of Inland Water Ecosystems (PEA), State University of Maringá, Maringá, Brazil; Research Nucleus in Limnology, Ichthyology and Aquaculture (NUPELIA), State University of Maringá, Maringá, Brazil; Biodivercity Institute (IBio), Maringá, Brazil; Australian Rivers Institute (ARI), Griffith University, Brisbane, Australia; Department of Biology, State University of Maringá, Maringá, Brazil; Royal Belgian Institute of Natural Sciences, Brussels, Belgium; Department of Psychology, State University of Maringá, Maringá, Brazil},
	abstract = {This quantitative pre- and post-test study investigates whether primary school students’ perception of the environment differs depending on whether their school is located in a rural, central, or peripheral area in southern Brazil, in the Global South. Rural students may view the world differently when compared to their urban counterparts. However, the parameters, such as landscape, which could change this perception are not well studied. Therefore, we have tested whether there is a difference in students’ environmental perception depending on the municipality, whether rural students have a higher score of environmental perception than urban and suburban ones, and whether the environmental perception increases after an interdisciplinary EE activity. The sampling occurred in 27 rural and urban schools from 12 municipalities, totalling 740 participants. Students’ environmental perceptions did differ depending on the city and the landscape. Although rural and central schools differed from peripheral ones, rural and central schools did not themselves differ. We speculate that peripheral students face different socioeconomic conditions that affect their perceptions. Environmental perception increased after an interdisciplinary EE activity. Sadly, there is a perception that people are not part of the environment. Thus, human–nature connectedness may have been negatively affected by landscape simplification. © 2025 Royal Society of Biology.},
	author_keywords = {belongingness; developing countries; environmental awareness; Local communities; primary education},
