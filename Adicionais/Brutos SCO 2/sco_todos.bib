@ARTICLE{Corominas2024895,
	author = {Corominas, Daniel Martínez and Labrador-Roca, Víctor and Lozano, Carlos Peñarrubia},
	title = {Socio-demographic profile and perception of personal competence among sea kayakers; [Perfil sociodemográfico y percepción de competencia personal en practicantes de kayak de mar]},
