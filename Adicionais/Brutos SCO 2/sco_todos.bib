@ARTICLE{Dushkova2022,
	author = {Dushkova, Diana and Ignatieva, Maria and Konstantinova, Anastasia and Vasenev, Viacheslav and Dovletyarova, Elvira and Dvornikov, Yury},
	title = {Human-Nature Interactions during and after the COVID-19 Pandemic in Moscow, Russia: Exploring the Role of Contact with Nature and Main Lessons from the City Responses},
	year = {2022},
	journal = {Land},
	volume = {11},
	number = {6},
	pages = {},
