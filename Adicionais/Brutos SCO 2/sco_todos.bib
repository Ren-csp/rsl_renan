	affiliations = {Department of Forestry and Management of the Environment and Natural Resources, Democritus University of Thrace, 193 Pantazidou Street, Orestiada, 68200, Greece; Research Centre for Tourism, Sustainability and Well-being, University of Algarve, Gambelas Campus, Faro, 8005, Portugal; Department of Forestry and Natural Resources, Aristotle University of Thessaloniki, Greece},
