	year = {2026},
	journal = {Urban Forestry and Urban Greening},
	volume = {125},
	pages = {},
	doi = {10.1016/j.ufug.2026.129646},
	url = {https://www.scopus.com/pages/publications/105049098046?origin=resultslist},
	affiliations = {University of Helsinki, Faculty of Biological and Environmental Sciences, Department of Environmental Sciences, Niemenkatu 73, Lahti, FI-15140, Finland; University of Helsinki, Helsinki Institute of Sustainability Science (HELSUS), University of Helsinki, Main building, 2nd floor, room 2053, Fabianinkatu 33, 00014, Finland; Häme University of Applied Sciences, HAMK. Bio Research Unit, P.O. Box 230, Hämeenlinna, 13101, Finland; University of Copenhagen, Department of Geosciences and Natural Resource Management, Landscape Architecture, Planning and Society, Rolighedsvej 23, Frederiksberg C, 1958, Denmark; University of Helsinki, Faculty of Agriculture and Forestry, Department of Agricultural Sciences, University of Helsinki, Latokartanonkaari 7, PL 27, 00014, Finland},
	abstract = {Urban grasslands are an important part of green infrastructure that enable combining biodiversity conservation with various nature contributions to people. Numerous stakeholders could act to further benefit grassland biodiversity. However, we need a more holistic understanding of the socioecological actions to take and of the factors preventing or enabling them. We ran an online questionnaire to gather practical information from people working with green infrastructure in Finland. We targeted the entire implementation chain, i.e., planning, construction and maintenance of urban grasslands. We asked open-ended questions on 1) how biodiversity can be fostered in urban grasslands, 2) what challenges these actions face, and 3) how these challenges can be solved. Additionally, we asked for the perceived benefits of urban grasslands. The respondents richly described ecological and social biodiversity actions, challenges and solutions. Ecological themes in the responses covered the area, quality and connectivity of urban grasslands. Social themes included information, changes in mindsets, activating stakeholders, resources and regulatory factors. Moreover, the respondents identified broader benefits related to urban grasslands, including regulating and provisioning services, and promoting health, learning and recreation. In summary, respondents noted that fostering the area, quality and connectivity of urban grasslands requires targeting key barriers related to grassland-related knowledge and mindsets, and incorporating biodiversity actions across all relevant stakeholders. © 2026 The Authors.},
	author_keywords = {Fostering biodiversity; Nature benefits; Proenvironmental behaviour; Stakeholder perceptions; Urban grasslands},
