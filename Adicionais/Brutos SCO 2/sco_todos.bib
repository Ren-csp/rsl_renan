@ARTICLE{Kotus2026,
	author = {Kotus, Jacek and Qiu, Qihang},
	title = {Multi-species placemaking or urban attraction? The human perception of Austin's bat colony},
	year = {2026},
	journal = {Cities},
	volume = {171},
	pages = {},
	doi = {10.1016/j.cities.2026.106813},
	url = {https://www.scopus.com/pages/publications/105029220194?origin=resultslist},
	affiliations = {Critical Geography Lab, Faculty of Human Geography and Planning, Adam Mickiewicz University in Poznań, Krygowskiego 10, Poznań, 61-680, Poland; Department of Geography and Anthropology, Kennesaw State University, US, Kennesaw, Georgia},
	abstract = {In contemporary urban studies, the concept of multispecies placemaking challenges traditional human-centered urban planning by recognizing the agency of non-human beings in shaping urban spaces. This study explores the bat colony under the Congress Avenue Bridge in Austin, TX, as a case of interspecies encounters in an urban environment. Using a mixed-methods approach—including six months of participant observation, big data analysis of social media reviews, and a questionnaire survey (N = 302)—this study examines public perceptions of the bat colony's role in urban placemaking. While many visitors appreciate the spectacle of the bats' emergence, authors' findings indicate that most view the event as an attraction rather than recognizing the bats as co-creators of the place. Sentiment analysis highlights predominantly positive emotions, but little acknowledgment of the bats' agency. Survey responses confirm that the colony is seen as an essential feature of the bridge, yet primarily as an entertainment element rather than autonomous urban inhabitants. These insights contribute to the broader discourse on urban multispecies coexistence, emphasizing the need for greater awareness of non-human agency in urban spaces, and in urban planning. The findings suggest that while interspecies interactions shape urban environments, societal perceptions remain largely anthropocentric, underscoring the challenges in integrating non-human perspectives into urban planning and governance. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Austin, TX; Bats; Commodification of nature; Multispecies encounters; Urban placemaking},
	keywords = {Austin [Texas]; Texas; United States; bat; perception; urban area; urban planning},
