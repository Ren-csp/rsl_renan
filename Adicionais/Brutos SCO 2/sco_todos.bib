@ARTICLE{Sousa-Silva2024,
	author = {Sousa-Silva, Rita and Zanocco, Chad},
	title = {Assessing public attitudes towards urban green spaces as a heat adaptation strategy: Insights from Germany},
	year = {2024},
	journal = {Landscape and Urban Planning},
	volume = {245},
	pages = {},
	doi = {10.1016/j.landurbplan.2024.105013},
	url = {https://www.scopus.com/pages/publications/85185157602?origin=resultslist},
	affiliations = {Institute of Environmental Sciences, Department of Environmental Biology, University of Leiden, Einsteinweg 2, CC Leiden, 2333, Netherlands; Young Academy for Sustainability Research, Freiburg Institute for Advanced Studies, University of Freiburg, Albertstraße 19, Freiburg im Breisgau, 79104, Germany; Civil and Environmental Engineering, Stanford University, 473 Via Ortega Room 311, Stanford, 94305, CA, United States},
	abstract = {Urban green spaces are recognized as essential elements of cities. They offer multiple benefits, including mitigating the urban heat island effect and its negative impact on public health. They also present opportunities for people to interact, recreate, and connect with nature. To explore attitudes towards urban green spaces, we surveyed 2253 German adults after the hot summer of 2022 to identify their preferences, frequency of use, and perceived benefits of green spaces. We were particularly interested in their perceptions and views of urban green spaces as an adaptation measure against heat stress. Our findings reveal that most respondents have a green space within a 15-minute walk from their home, with over 80% indicating there is plenty of nearby green space that is easy to access and well-maintained. Health and well-being emerged as primary motivators for visits, with many prioritizing relaxation over physical activity or social interaction. Despite their positive attitudes toward green spaces, fewer than 20% of respondents frequented them on very warm days, suggesting that many residents may not recognize the cooling potential of green spaces during heat events. However, over 70% of respondents supported prioritizing efforts towards establishing more parks and shaded green spaces, and over 80% supported planting more trees along streets as a heat mitigation and adaptation strategy. As climate change intensifies, it is vital for planners, policymakers, and emergency managers to understand and incorporate perceptions about green spaces in the decision-making process, ensuring that they are effectively promoted and utilized as urban heat mitigation measures. © 2024 The Author(s)},
	author_keywords = {Climate change adaptation; Green space use; Heat waves; Heat-related health impacts; Urban greening; Urban heat},
	keywords = {Germany; adaptive management; climate change; greenspace; health impact; heat island; heat wave; perception; prioritization; public attitude; space use; urban ecosystem},
	correspondence_address = {R. Sousa-Silva; Institute of Environmental Sciences, Department of Environmental Biology, University of Leiden, CC Leiden, Einsteinweg 2, 2333, Netherlands; email: a.r.de.sousa.e.silva@cml.leidenuniv.nl},
	publisher = {Elsevier B.V.},
