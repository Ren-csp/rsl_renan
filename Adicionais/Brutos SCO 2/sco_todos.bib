	author = {Balgobind-Singh, Shanta and Khan, Sultan},
	title = {Gender Perception of Crime and its Reduction amongst White South Africans in the Province of KwaZulu-Natal},
	year = {2013},
	journal = {Oriental Anthropologist},
	volume = {13},
