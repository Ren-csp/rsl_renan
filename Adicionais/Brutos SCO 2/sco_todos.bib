	issn = {18877052},
	language = {English},
	abbrev_source_title = {Archit. City Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access}
}

