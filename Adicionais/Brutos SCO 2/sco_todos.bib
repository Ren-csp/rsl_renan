@ARTICLE{Ramírez2025,
	author = {Ramírez, Danna Betsabe Rivera and Pérez-Hernández, Cisteil X. and Arellanes-Cancino, Yaayé and Mendoza-Cuenca, Luis},
	title = {Oral history as a citizen science tool to understand biodiversity loss and environmental changes: on firefly extirpation in Morelia, Michoacán, Mexico},
	year = {2025},
	journal = {PeerJ},
	volume = {13},
	number = {5},
