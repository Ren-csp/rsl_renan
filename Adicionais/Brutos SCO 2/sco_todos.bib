@ARTICLE{Marandola20127,
	author = {Marandola, Eduardo and Modesto, Francine},
	title = {Perception of urban environmental threats and place effects on the Population-Environment relationship; [Percepção dos perigos ambientais urbanos e os efeitos de lugar na relação população-ambiente]},
