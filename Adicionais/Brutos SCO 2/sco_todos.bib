	publisher = {Emerald Group Holdings Ltd.},
	issn = {01437720},
	language = {English},
	abbrev_source_title = {Int. J. Manpow.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 20}
}

