@ARTICLE{XU20259102,
	author = {XU, Weizhen and SHI, Ruixiang and CHEN, Ziyi and CHEN, Jing},
	title = {Study on the impact of perceived biodiversity on urban park visitors′ emotional states in Shanghai: The mediating effect of restorative benefits; [上海城 市 公 园 访 客 感 知 生 物 多 样 性 对 其 情 绪 状 态 的影响———基于恢复性效益的中介效应]},
	year = {2025},
	journal = {Shengtai Xuebao},
	volume = {45},
