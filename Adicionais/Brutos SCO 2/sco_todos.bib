}

@ARTICLE{Kronenberg2025,
	author = {Kronenberg, Jakub},
	title = {From neoliberal urban green space production and consumption to urban greening as part of a degrowth agenda},
	year = {2025},
	journal = {Cities},
	volume = {159},
