@ARTICLE{Lee2026,
	author = {Lee, Bing-Tao Xavier and Steemers, Koen},
	title = {Indoor Plant and Mental Wellbeing: Understanding Preferences, Perceptions, and Spatial Arrangements Among University Students},
	year = {2026},
	journal = {Buildings},
	volume = {16},
	number = {8},
	pages = {},
