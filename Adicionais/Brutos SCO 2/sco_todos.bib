	author = {Becker, Fabian and Knitter, Daniel and Walser, Andreas Victor and Ludwig, Bernhard and Tozan, Murat and Schütt, Brigitta and Pirson, Felix},
	title = {Understanding geomorphodynamics in the Pergamon micro-region from a socio-ecological perspective},
	year = {2024},
	journal = {Holocene},
	volume = {34},
