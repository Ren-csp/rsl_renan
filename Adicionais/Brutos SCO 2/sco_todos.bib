@ARTICLE{Qi2026,
	author = {Qi, Ying and Xie, Haifan and Hou, Jiahui and Hu, Xiwen and Meng, Jiayu and Gao, Tian and Qiu, Ling},
	title = {Quantifying human-scale biodiversity exposure in urban parks with LiDAR and panoramic imagery},
	year = {2026},
	journal = {Environmental Impact Assessment Review},
	volume = {120},
	pages = {},
	doi = {10.1016/j.eiar.2026.108463},
	url = {https://www.scopus.com/pages/publications/105035558448?origin=resultslist},
	affiliations = {College of Landscape Architecture and Arts, Northwest A&F University, Shaanxi, Xianyang, 712100, China},
	abstract = {Cities increasingly rely on urban parks to conserve biodiversity while providing meaningful eye-level nature experiences. However, commonly used landscape design indices rarely capture how plant diversity is visually expressed in situ. This study aims to operationalise Visual Plant Diversity (VPD) as a reproducible eye-level metric based on shape, colour, and texture, to evaluate how VPD varies among biotope types and relates to its ecological sources—plant diversity (PD) and visible biotope diversity (VBD)—and to demonstrate its application for identifying priority biotopes for biodiversity experience. Using biotopes as the analytical unit (seven parks in Xi'an, China; n = 182; autumn 2024), VPD was quantified, PD and VBD were survived and scores of VPD and PD were assessed. Semi-closed, multi-layered biotopes exhibited consistently higher VPD than open greens. VPD was positively associated with PD, particularly woody PD through texture (Spearman's ρ = 0.52) and shape (ρ = 0.41), while colour showed weaker associations (ρ = 0.27). Relationship between colour diversity and VBD (ρ = −0.25) was negative, suggesting dilution of chromatic cues in more open, interface-rich views. A VPD × PD overlay identified “high–high” biotopes as experiential priorities and highlighted visually rich but species-poor grey–green spaces as opportunities for ecological enrichment. By translating species-level biodiversity into perceptually legible eye-level cues, the VPD framework enables fine-scale microhabitat prioritisation and supports actionable design and management of multifunctional urban parks. © 2026 Elsevier Inc.},
