@ARTICLE{Wen2026,
	author = {Wen, Fangfang and Abulaiti, Xierzhati and Li, Siyan and Ke, Wenlin and Wang, Xiaotong and Zuo, Bin},
	title = {Beyond warmth: Competence outweighs warmth in the nature–urban stereotype system},
	year = {2026},
	journal = {Journal of Environmental Psychology},
	volume = {113},
	pages = {},
	doi = {10.1016/j.jenvp.2026.103086},
	url = {https://www.scopus.com/pages/publications/105041564303?origin=resultslist},
	affiliations = {School of Psychology, Center for Studies of Social Psychology, Central China Normal University, Key Laboratory of Adolescent Cyberpsychology and Behavior, Ministry of Education, Wuhan, 430079, China; School of Psychology, Sun Yat-sen University, GuangZhou, 510006, China},
	abstract = {Do people stereotype natural and urban environments along warmth and competence dimensions, and if so, how do these stereotypes relate to environmental attitudes? Applying the Stereotype Content Model (SCM) to environmental perception, we tested a systematic nature–urban asymmetry across three complementary studies. Study 1 used a word-embedding association test (WEAT) on a large-scale Chinese corpus and found that nature-related words were semantically closer to warmth-related words than urban-related words were, with no significant competence bias at the linguistic level. Study 2 combined explicit semantic differentials with the Implicit Association Test (IAT). Participants explicitly rated nature as warmer than urban settings, but implicitly associated urban environments with higher competence, a dissociation that emerged only at the automatic level. Study 3 then examined whether these stereotype dimensions predict global environmental attitudes. Perceived competence of nature positively predicted attitudes toward both natural and urban environments, whereas warmth perceptions had no predictive power. This spillover effect was specific to environmental domains and did not generalize to unrelated objects (e.g., household appliances). Guided by the Dual Perspective Model, these findings suggest that when humans evaluate entities on which they depend, an actor perspective, competence appraisals (perceived functional efficacy) outweigh warmth in shaping pro-environmental attitudes. The results extend the SCM to non-human targets and offer a reoriented perspective for sustainability communication: highlighting nature's functional efficacy may be more effective than appealing solely to its benevolence. © 2026},
	author_keywords = {Dual perspective model; Environmental stereotypes; Nature perception; Stereotype content model; Urban perception},
	correspondence_address = {F. Wen; School of Psychology, Central China Normal University, Wuhan, No.152, Luoyu Road, Hongshan District, Hubei Province, China; email: wenff@ccnu.edu.cn; B. Zuo; School of Psychology, Sun Yat-sen University, GuangZhou, 510006, China; email: zuobin@mail.sysu.edu.cn},
