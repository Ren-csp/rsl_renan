	title = {Management strategies in urban green spaces: Models based on an introduced exotic pet turtle},
	year = {2009},
	journal = {Biological Conservation},
	volume = {142},
	number = {10},
	pages = {2258 - 2269},
	doi = {10.1016/j.biocon.2009.05.004},
	url = {https://www.scopus.com/pages/publications/68549122598?origin=resultslist},
	affiliations = {Univ Paris-Sud, Laboratoire Ecologie, Systématique et Evolution, CNRS, Orsay, F-91405 Cedex, UMR8079, France; UMR 7204, MNHN, CNRS, Paris F-75005, 55 rue Buffon, France; Institut des Sciences de la Communication, CNRS (ISCC), Paris, F-75013, 27 rue Damesme, France; Université de Cergy-Pontoise, F-91405 Cergy-Pontoise, France; Institut des Sciences humaines et sociales, Laboratoire d'Anthropologie sociale et culturelle, Université de Liège, Belgium; Fondation Nicolas Hulot pour la Nature et l'Homme, Boulogne Billancourt, F-92100, 6 rue de l'Est, France},
	abstract = {A number of recent authors have emphasised the increasing disconnection from conservation issues among urban dwellers. In a global increase of urbanisation, this disconnect can have an impact on conservation practices. Here, we discuss how managers of public green spaces can contribute to global biodiversity preservation, through combined efforts to preserve local biodiversity and educate the public about conservation issues. We compared several management strategies, including those that mixed direct action on local biodiversity with public education and those that did not. Two kinds of one-way communication were considered as well as a two-way communication process, which take into account different perceptions and practices of nature. We based our model on the introduction of the red-eared slider turtle, Trachemys scripta elegans, into urban French freshwater ecosystems. We found that direct actions only had a limited, short term effect on the abundance of feral turtles in green spaces and had no effect on the level of public concern about environmental questions. We also showed that a mix of different communication strategies improved people's awareness and altered behaviour with respect to introduced species issues. Finally, we showed the importance of a two-way communication that takes into account the diversity of personal perceptions and practices as regards nature in urban areas in order to achieve sustainable conservation measures and objectives. © 2009 Elsevier Ltd. All rights reserved.},
	author_keywords = {Communication; Conservation; Education; Exotic pets; Management; Nature perception; Urban},
	keywords = {Eurasia; Europe; France; Western Europe; Testudines; Trachemys scripta; Trachemys scripta elegans; abundance; biodiversity; conservation management; ecological modeling; environmental education; freshwater ecosystem; greenspace; invasive species; perception; strategic approach; turtle; urbanization},
	correspondence_address = {P. Teillac-Deschamps; Univ Paris-Sud, Laboratoire Ecologie, Systématique et Evolution, CNRS, Orsay, F-91405 Cedex, UMR8079, France; email: pauline.teillac@u-psud.fr},
	issn = {00063207},
	coden = {BICOB},
	language = {English},
	abbrev_source_title = {Biol. Conserv.},
