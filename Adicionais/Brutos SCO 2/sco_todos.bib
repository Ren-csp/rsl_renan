@ARTICLE{Whitten20261294,
	author = {Whitten, Meredith},
	title = {Invisible and overlooked: young people’s perceptions of managing green spaces for mental wellbeing},
	year = {2026},
	journal = {Cities and Health},
	volume = {10},
