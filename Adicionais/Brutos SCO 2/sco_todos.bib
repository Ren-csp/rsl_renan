@ARTICLE{Lapointe202157,
	author = {Lapointe, Marie and Gurney, Georgina G. and Cumming, Graeme S.},
	title = {Urbanization affects how people perceive and benefit from ecosystem service bundles in coastal communities of the Global South},
	year = {2021},
	journal = {Ecosystems and People},
	volume = {17},
