@ARTICLE{Ivashkina2025,
	author = {Ivashkina, Elizaveta and Mikhaylova, Oxana},
	title = {Application of the theory of para-social relationships for the analysis of people’s perceptions of indoor plants},
	year = {2025},
	journal = {Frontiers in Psychology},
	volume = {16},
	pages = {},
	doi = {10.3389/fpsyg.2025.1533128},
