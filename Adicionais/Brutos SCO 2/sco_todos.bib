	title = {Rethinking the nature vs. urban environment dichotomy: Aligning research classifications with human visual perception},
	year = {2025},
	journal = {Journal of Environmental Psychology},
	volume = {101},
	pages = {},
	doi = {10.1016/j.jenvp.2024.102507},
	url = {https://www.scopus.com/pages/publications/85211740395?origin=resultslist},
	affiliations = {School of Psychological Science, University of Bristol, 12a Priory Rd, Bristol, BS81TU, United Kingdom},
	abstract = {Recent research in the field of environmental psychology starts to question whether the commonly assumed positive impact of exposure to nature environments on behaviour, health and wellbeing is specific to nature per se, or rather reflects implicit biases in the selection of environments under investigation and experimental assumptions. Here, we implemented spatial multi-arrangement methodology to obtain similarity ratings for three key factors proposed to differ between nature and urban scenes, namely fascination, liking and visual discomfort. This methodology allowed us to directly compare a wide range of nature and urban scenes from across the world. Using representational similarity analysis, the three factors were found to be strongly correlated and varied substantially within as well as across categorical boundaries. An empirical model where environments were differentiated by degrees of similarity was a better predictor of fascination, liking and visual discomfort than models reflecting theoretical and empirical (naturalness) distinctions between nature and urban environments. From this, we conclude that a dichotomous “nature versus urban” framework seems less important when people make psychological judgements about environments and might ultimately hinder our understanding of what exactly it is in an environment that impacts health and wellbeing. © 2024 The Authors},
	author_keywords = {Aesthetics; Fascination; Liking; Nature; Urban; Visual discomfort},
	correspondence_address = {J.L. Davies; School of Psychological Science, University of Bristol, Bristol, 12a Priory Rd, BS81TU, United Kingdom; email: jd16129@bristol.ac.uk},
