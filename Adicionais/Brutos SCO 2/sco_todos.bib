}

@ARTICLE{Chen2024,
	author = {Chen, Zhu and Zhu, Tian-Yuan and Guo, Xuan and Liu, Jiang},
	title = {Landscape Characteristics Influencing the Spatiotemporal Dynamics of Soundscapes in Urban Forests},
	year = {2024},
	journal = {Forests},
	volume = {15},
