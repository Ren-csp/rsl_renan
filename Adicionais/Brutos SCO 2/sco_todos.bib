}

@ARTICLE{Murugan2024163,
	author = {Murugan, Giri P. and Dkhar, Valerie},
	title = {Evaluation of People’s Perceptions Towards the Bonnet Macaques (Macaca radiata) of the Sankagiri Hillock of South India: An Ethnoprimatological Study},
	year = {2024},
	journal = {Primate Conservation},
	number = {38},
	pages = {163 - 173},
	url = {https://www.scopus.com/pages/publications/105006678973?origin=resultslist},
	affiliations = {Department of Anthropology, Pondicherry University, India; Department of Anthropology, Pondicherry University, India},
	abstract = {People’s attitudes towards co-living, wild, non-human primates play a crucial part in the management and conservation of the latter in today’s world, where expanding anthropogenic occupations and the resulting habitat loss bring humans and many non-human species into conflict. Two factors, 1) positive cultural conceptions about non-human species held by an individual and 2) the personal experience of negative implications of human-non-human interactions, influence perception and attitude formation among people about non-human species. The relationship between these two factors to people’s attitudes was tested by studying human–bonnet macaque (Macaca radiata) interactions in a semi-anthropogenic environment in South India using the methodological lens of Ethnoprimatology. We explored variations in the nature of human-macaque interactions observed at different sites in the field, the cultural background, and analyzed the personal experiences of the residents of the various sites; the overall attitudes prevailing at these sites were inferred. The degree of variation in the nature of perception of non-human primates among various sites in the same study area indicated the significance of including the cultural and experiential elements of the co-inhabiting humans in managing primates in peri-urban environments. © 2024 Global Wildlife Conservation. All rights reserved.},
