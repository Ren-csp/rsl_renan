@ARTICLE{Singh2026,
	author = {Singh, Chandni and Patil, Sheetal and Sharma, Swarnika},
	title = {Do rooftop home gardens regulate temperature? Insights on indoor heat regulation and thermal comfort in Bangalore},
	year = {2026},
	journal = {Environmental Research: Climate},
	volume = {5},
	number = {2},
	pages = {},
	doi = {10.1088/2752-5295/ae4a40},
	url = {https://www.scopus.com/pages/publications/105035654901?origin=resultslist},
	affiliations = {School of Environment and Sustainability, Indian Institute for Human Settlements, Bangalore, India},
	abstract = {Cities are warming rapidly and urban heat is already affecting liveability, labour productivity and human health. Nature-based solutions (NbS) such as green roofs, increased urban tree cover and demarcating space for urban parks have been identified as promising strategies to adapt to increasing urban heat. However, the NbS literature pays relatively low attention to examining how smaller urban green spaces, such as fragmented urban greens and rooftop home gardens, contribute to hyperlocal temperature regulation. We examine whether rooftop home gardens in Bangalore, India, regulate indoor temperatures and provide thermal comfort. We draw on perception-based data through household surveys, in-depth interviews and modelled scenario data to examine the heat regulation potential of different types of rooftop home gardens. Overall, people perceive rooftop farms/gardens providing thermal comfort in the rooms directly below, with reported air-conditioner use declining after starting rooftop gardening. The modelling analysis (using seven scenarios from no green cover to complete green cover with a 100% soil bed on the roof) shows that heat reduction benefits from rooftop gardens range from 1.5°C to 14°C, depending on the foliage type and density and the extent of the green cover. Given that most rooftops are used for multiple purposes, a more realistic temperature reduction is 1.5°C to 3°C (scenario with 50% of the roof covered in dense foliage). The findings from Bangalore provide early insights into the role of urban home gardens in regulating urban heat and have relevance for national policies on retrofitting and planning for climate-resilient and liveable homes and cities. © 2026 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {heat; heat regulation; rooftop home gardens; thermal comfort; urban heat islands},
	correspondence_address = {C. Singh; School of Environment and Sustainability, Indian Institute for Human Settlements, Bangalore, India; email: chandni.singh@iihs.ac.in},
	publisher = {Institute of Physics},
	issn = {27525295},
	language = {English},
	abbrev_source_title = {Environ. Res. Clim.},
	type = {Article},
