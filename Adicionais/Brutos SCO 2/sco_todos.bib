}

@ARTICLE{Lo201774,
	author = {Lo, Alex Y. and Byrne, Jason A. and Jim, C.Y.},
	title = {How climate change perception is reshaping attitudes towards the functional benefits of urban trees and green space: Lessons from Hong Kong},
	year = {2017},
	journal = {Urban Forestry and Urban Greening},
