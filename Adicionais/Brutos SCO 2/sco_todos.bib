@ARTICLE{Melgarejo-Torralba2026,
	author = {Melgarejo-Torralba, Mar and Parras-Burgos, Dolores and Fernández-Pacheco, Daniel G. and López-Salmerón, Emilio and Cañavate, Francisco J. F.},
