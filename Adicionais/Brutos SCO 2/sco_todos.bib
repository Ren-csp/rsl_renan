@ARTICLE{Lai2026,
	author = {Lai, Pengcheng and Ou, Dayi},
	title = {Multisensory interaction: exploring the effects of soundscape, landscape, and smellscape on individual comforts and behavioral intentions in urban park},
	year = {2026},
	journal = {Energy and Buildings},
	volume = {353},
	pages = {},
	doi = {10.1016/j.enbuild.2025.116885},
	url = {https://www.scopus.com/pages/publications/105029778573?origin=resultslist},
	affiliations = {School of Architecture, Huaqiao University, Xiamen, 361021, China; Xiamen Key Laboratory of Ecological Building Construction, Fujian, Xiamen, China},
	abstract = {Urban parks are vital places where people can connect with nature. A favorable sensory environment could enhance people’s comfort and inspire behavioral intentions. This study aimed to explore the effects of soundscape, landscape, and smellscape (S-L-S) on individual comfort and to assess further how auditory, visual, and olfactory (A-V-O) comforts influence overall environmental comfort (OEC) and behavioral intentions (recommend and revisit). We conducted this field experiment (N = 42) in the Horticulture Expo Garden in Xiamen, China. Data on participants’ S-L-S perceptions, comfort, and behavioral intentions were collected from seven representative types of spaces within the urban park. Results indicated that (1) most indicators of S-L-S perceptions related to respondents’ auditory comfort (AC), visual comfort (VC), olfactory comfort (OC), and OEC. (2) A-V-O comforts affected OEC significantly, and VC had the most substantial main effect (η<sup>2</sup>p = 0.102) from a single sensory factor. From a multisensory perspective, AC × OC had the most potent interaction effect (η<sup>2</sup>p = 0.064). (3) A-V-O affected behavioral intentions significantly, and AC had the most substantial main effect (η<sup>2</sup>p = 0.073) from a single sensory factor. From a multisensory perspective, VC × OC (η<sup>2</sup>p = 0.076) and AC × VC (η<sup>2</sup>p = 0.096) had the most potent interaction effects on recommend and revisit intentions, respectively. (4) OEC mediated between A-V-O comforts and behavioral intentions. The findings of this study can contribute empirical evidence to environmental perception theory and inform the multisensory interaction design of urban parks. © 2025 Elsevier B.V.},
	author_keywords = {Behavioral intention; Comfort; Landscape; Smellscape; Soundscape; Urban parks},
	keywords = {Association reactions; Behavioral research; Natural environment; Auditory-visual; Behavioral intention; Comfort; Environmental comfort; Landscape; Multisensory interaction; Smellscape; Soundscapes; Urban parks; Visual comfort; Odors},
