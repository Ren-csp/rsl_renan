	language = {English},
	abbrev_source_title = {Land Use Policy},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 144; All Open Access; Green Open Access}
}

@ARTICLE{Pineda-Guerrero20211,
	author = {Pineda-Guerrero, Alexandra and Escobedo, Francisco J. and Carriazo, Fernando},
	title = {Governance, nature’s contributions to people, and investing in conservation influence the valuation of urban green areas},
	year = {2021},
	journal = {Land},
	volume = {10},
	number = {1},
	pages = {1 - 20},
	doi = {10.3390/land10010014},
	url = {https://www.scopus.com/pages/publications/85098861842?origin=resultslist},
	affiliations = {Nelson Institute for Environmental Studies, University of Wisconsin Madison, 550 North Park Street, Madison, 53706, WI, United States; US Forest Service, Pacific Southwest Research Station, 4955 Canyon Crest Dr., Riverside, 92507, CA, United States; Urban Management and Development Program, School of Political Science, Government and International Relations, Universidad del Rosario, Cra 6 No. 12C-13, Bogotá, 111711, Colombia},
	abstract = {There is little information concerning how people in the Global South perceive the benefits and costs associated with urban green areas. There is even less information on how governance influences the way people value these highly complex socio-ecological systems. We used semi-structured surveys, statistical analyses, and econometrics to explore the perceptions of users regarding governance and the benefits and costs, or Ecosystem Services (ES) and Ecosystem Disservices (ED), provided by Neotropical green areas and their willingness to invest, or not, for their conservation. The study area was the El Salitre sub-watershed in Bogota, Colombia, and 10 different sites representative of its wetlands, parks, green areas, and socioeconomic contexts. Using a context-specific approach and methods, we identified the most important benefits and costs of green areas and the influence of governance on how people valued these. Our modelling shows that air quality and biodiversity were highly important benefits, while water regulation was the least important; despite the sub-watershed’s acute problems with stormwater runoff. In terms of costs, the feeling of insecurity due to crime was related to poor levels of maintenance and infrastructure in the studied green areas. Perceived transparency, corruption, and performance of government institutions influenced people’s Unwillingness to Invest (UTI) in green space conservation. Results show that socioeconomic backgrounds, government performance, and environmental education will play a role in the value or importance people place on the benefits, costs, and UTI in conservation efforts in urban green areas. Similarly, care is warranted when directly applying frameworks and typologies developed in high income countries (i.e., ES) to the unique realities of cities in the Global South. Accordingly, alternative frameworks such as Nature’s Contributions to People is promising. © 2020 by the authors. Li-censee MDPI, Basel, Switzerland.},
	author_keywords = {Bogota Colombia; Corruption; Unwillingness to Invest; Urban biodiversity; Urban watersheds},
	correspondence_address = {F.J. Escobedo; US Forest Service, Pacific Southwest Research Station, Riverside, 4955 Canyon Crest Dr., 92507, United States; email: Francisco.Escobedo@usda.gov},
	publisher = {MDPI AG},
	issn = {2073445X},
	language = {English},
	abbrev_source_title = {Land},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Vasiljević2023,
	author = {Vasiljević, Đorđije A. and Vujičić, Miroslav D. and Stankov, Uglješa and Dragović, Nataša},
	title = {Visitor motivation and perceived value of periurban parks - Case study of Kamenica park, Serbia},
	year = {2023},
	journal = {Journal of Outdoor Recreation and Tourism},
	volume = {42},
	pages = {},
	doi = {10.1016/j.jort.2023.100625},
	url = {https://www.scopus.com/pages/publications/85150153737?origin=resultslist},
	affiliations = {Department of Geography, Tourism and Hotel Management, Faculty of Sciences, University of Novi Sad, Serbia},
	abstract = {Spending time in urban green spaces may bring a range of benefits to their visitors, such as relaxation, recreation, healthy environment, socialising, etc. Understanding visitors’ preferences and motivation contributes to better park management which improves both nature conservation and visitors’ experience. Thus, the study set out to identify the perceived values and motivation of visitors to a periurban park, a vast green area at the outskirts of a city where people come for multiple purposes. For the case study authors have chosen a periurban Kamenica Park near the city of Novi Sad, Serbia. The sample of 210 respondents was collected within the park in 2021. We used exploratory factor analysis and confirmatory factor analysis to determine and test potential dimensions of the periurban parks perceived value (PPPVS) and visitor motivation (PPVMS) scales. Factor loading scores indicated four different motivational factors (Relaxation and Well-Being, Enjoyment and Fulfilment, Recreation and Wellness, Socialisation and Interaction) and two for visitors’ perception factors (Park Condition and Park Fit-Out). The results have shown many variations according to socio-demographic characteristics of the respondents, such as Relaxation and Well-Being less important to teenagers, Enjoyment and Fulfilment very important to aged 46+, etc. This study further gives managerial implications for further development of Park management, visitor experience and nature conservation. Management implications: ● The key motivators are relaxation, enjoyment of a tranquil atmosphere, natural surroundings, and fresh air - the park should be preserved as a natural semi-forest oasis. ● The most valuable park features are green area condition, beauty and quantity, safety, and resting places - visitors need to recover from everyday stress, mental fatigue, and urban life in general - urban planners must integrate nature and green areas sustainably as a part of city development, especially since this phenomenon is consistent with many similar studies from different locations and time periods. ● People from urban areas enjoy the natural environment more since they have less touch with it. ● Recreationalists in the park are not keen to participate in survey. © 2023 Elsevier Ltd},
	correspondence_address = {Đ.A. Vasiljević; Department of Geography, Tourism and Hotel Management, Faculty of Sciences, University of Novi Sad, Novi Sad, Trg Dositeja Obradovića 3, 21000, Serbia; email: dj.vasiljevic@dgt.uns.ac.rs},
	publisher = {Elsevier Ltd},
	issn = {22130780},
	language = {English},
	abbrev_source_title = {J. Outdoor Recreat. Tour.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 34}
}

@ARTICLE{Wang2023,
	author = {Wang, Siqiang and Yung, Esther Hiu Kwan and Jayantha, Wadu Mesthrige and Chan, Edwin Hon Wan},
	title = {Elderly's intention and use behavior of urban parks: Planned behavior perspective},
	year = {2023},
	journal = {Habitat International},
	volume = {134},
	pages = {},
	doi = {10.1016/j.habitatint.2023.102780},
	url = {https://www.scopus.com/pages/publications/85150420559?origin=resultslist},
	affiliations = {Department of Building and Real Estate, The Hong Kong Polytechnic University, Hong Kong; School of Property, Construction and Project Management, RMIT University, Australia},
	abstract = {An urban park is a vital environment that promotes the elderly's physical, social and psychological health. Numerous studies have been conducted to determine the influencing factors that could encourage the elderly's usage of urban parks. However, little attention has been paid to elderly's intention of using urban parks. This study applies the theory of planned behavior (TPB) to understand the relationship between elderly's intentions of using urban park and use behavior. According to the nature of the different activity types elderly people intended to do in urban parks, three sub-models are built based on the original TPB model, which are social, enjoyment and physical activity-based models. These models explore the influencing factors that may affect elderly's use of urban park under the three different intentions. This study employed focus group meetings and questionnaire surveys (N = 537) to collect data and applied structural equation modelling to test the proposed social, enjoyment and physical activity-based models. In addition, this study found that elderly's use behavior of public parks was significantly affected by their intention of using public parks. The use behavior was also directly associated with intrapersonal constraints (degree of liking) and structural constraint variables (available leisure time and physical accessibility). Meanwhile, use behavior is indirectly associated with intrapersonal constraint variables (elderly's perception to urban park) and interpersonal constraints (conflict of use with other groups) through the influence of their intentions of using public parks. Furthermore, physical accessibility may affect elderly's use behavior, but it has no effect on elderly's intention of using urban parks. The findings and proposed models provide theoretical and practical contributions to better understand elderly's use behavior of urban park to encourage healthy ageing in an urban dense city. © 2023},
	author_keywords = {Elderly; Intention; Theory of planned behavior; Urban park; Use behavior},
	keywords = {elderly population; psychology; public space; recreational facility; social behavior; space use; urban area; urban geography},
	correspondence_address = {E.H.K. Yung; The Hong Kong Polytechnic University, KLN, ZN725, North Tower, 7/F, Block Z, Hung Hom, Hong Kong; email: esther.yung@polyu.edu.hk},
	publisher = {Elsevier Ltd},
	issn = {01973975},
	language = {English},
	abbrev_source_title = {Habitat Int.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 36; All Open Access; Green Open Access}
}

@ARTICLE{Quezada202256,
