@ARTICLE{Farina2005167,
	author = {Farina, Almo and Santolini, Riccardo and Pagliaro, Giacomo and Scozzafava, Silvia and Schipani, Ileana},
	title = {Eco-semiotics: A new field of competence for ecology to overcome the frontier between environmental complexity and human culture in the mediterranean},
	year = {2005},
	journal = {Israel Journal of Plant Sciences},
	volume = {53},
	number = {3-4},
	pages = {167 - 175},
	doi = {10.1560/5UTK-YW53-KDQT-YU48},
