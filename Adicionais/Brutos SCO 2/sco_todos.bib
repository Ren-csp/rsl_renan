	author = {Gonçalves, Eduardo Henrique and Capilé, Karynn and Forte Maiolino Molento, Carla},
	title = {Perceptions of Multispecies Coexistence in Urban Environments in Brazil: A Convenience Sampling Method},
	year = {2025},
