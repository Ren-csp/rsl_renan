@ARTICLE{Zhong202556,
	author = {Zhong, Xuexuan and Wang, Peiliang and Zhao, Lingjun and Huang, Huawei and Huang, Huakun},
	title = {AIGC-Empowered WiFi Sensing for Intelligent Perception and User Privacy Preserving},
	year = {2025},
	journal = {IEEE Communications Magazine},
	volume = {63},
	number = {7},
	pages = {56 - 62},
	doi = {10.1109/MCOM.001.2400494},
	url = {https://www.scopus.com/pages/publications/105009507661?origin=resultslist},
	affiliations = {Guangzhou University, China; Guangdong Polytechnic Normal University, China; Sun Yat-Sen University, China},
	abstract = {With the emergence of 6G technology and the integration of air, space, ground, and maritime networks, ensuring secure and accurate communication in indoor environments remains a significant challenge. Traditional human pose estimation techniques, such as camera-based and wearable device-based methods, raise concerns regarding privacy and cost, limiting their widespread adoption. While WiFi-based techniques have been under the spotlight for their non-invasive nature, current approaches lack the precision required for practical use. In this article, we propose the HPNet system and model, a deep learning-based human pose estimation network utilizing WiFi channel state information for high-precision indoor human pose estimation, addressing both accuracy and privacy concerns. Through extensive experiments, the HPNet method achieves a finely tuned accuracy with a PCK@0.05 score of 80.54 on our open environment dataset, significantly outperforming existing solutions. Furthermore, to enhance user experience and improve the visualization of pose estimation results, we integrate the diffusion model that converts stickman-like outputs into realistic virtual characters, ensuring user-friendly interaction while preserving privacy. This work contributes to advancing non-invasive human monitoring systems within the context of the evolving 6G framework by offering a balance between precision, privacy protection, and usability in indoor environments. © 1979-2012 IEEE.},
	keywords = {Communication channels (information theory); Deep learning; Privacy-preserving techniques; User experience; User interfaces; Wearable technology; Wi-Fi; Air networks; Air space; Ground networks; Human pose estimations; Indoor environment; Intelligent perception; Maritime networks; Privacy preserving; Space network; User privacy; Wireless local area networks (WLAN)},
