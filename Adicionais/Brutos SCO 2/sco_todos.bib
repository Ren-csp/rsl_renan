@ARTICLE{Hočevar2012123,
	author = {Hočevar, Marjan},
	title = {Dispersed settlement in detached houses: Attitudes over the residential space consumption in Slovenia; [Disperzovano naselje u individualnim kućama: Stavovi o potrošnji rezidencijalnog prostora u Sloveniji]},
	year = {2012},
