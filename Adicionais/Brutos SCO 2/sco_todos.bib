@ARTICLE{Zhang202615,
	author = {Zhang, Xinchang and Qi, Ji and Chen, Yiping and Liu, Feng and Yi, Yaqin and Zhang, Yuanmei and Ruan, Yongjian and Yuan, Yuanlin and Zhao, Yuan},
	title = {Key Technologies and Applications of Intelligent Planning for Urban-Rural Integration Development; [面向城乡融合的智能规划关键技术与应用]},
