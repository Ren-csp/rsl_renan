@ARTICLE{Aldoh20252821,
	author = {Aldoh, Alaa and Ungureanu, Raul and Popescu, Sofia and Eldridge, Alice and Sandom, Christopher J. and Rae, Charlotte L.},
	title = {How multisensory nature exposure affects well-being: Visual and auditory influences on affect},
